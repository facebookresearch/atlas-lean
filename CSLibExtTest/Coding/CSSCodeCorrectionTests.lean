module

public import CSLibExt.Coding.CSSCodeCorrection
public import CSLibExt.Coding.Hamming74
public import Mathlib.Analysis.CStarAlgebra.Matrix

@[expose] public section

/-!
# Tests for error correction by CSS codes

* The projector hypotheses of `isCorrectable_css` can be met for every pair of codes: every
  subspace of `ℂ^ι` is the range of a self-adjoint idempotent matrix, the orthogonal projection
  onto it.
* Steane's seven-qubit code: `C₁` is the Hamming (7,4) code and `C₂ = C₁^⊥`. Then `C₂ ⊆ C₁`, and
  `C₂^⊥ = C₁` has minimum weight `3`, so `isCorrectable_css` with `d = 3` applies: every Pauli
  error on one qubit is correctable on the code, and such a code projector exists.
* With `d = 3` the error family contains the bit flip `X`, the phase flip `Z` and their product on
  each single qubit, but not `X` on qubit `0` together with `Z` on qubit `1`.
-/

namespace Cslib.CodingTheory.CSSWanted.Tests

open scoped Matrix
open Cslib.CodingTheory Cslib.CodingTheory.LinearCode Cslib.CodingTheory.CSS
  MathlibExt.QuantumInformation.Finite.KnillLaflamme

/-- Every subspace `V` of `ℂ^ι` is the range of a self-adjoint idempotent matrix: the orthogonal
projection onto `V`, transported from Euclidean space. -/
theorem exists_proj {ι : Type*} [Fintype ι] [DecidableEq ι] (V : Submodule ℂ (ι → ℂ)) :
    ∃ P : Matrix ι ι ℂ, Pᴴ = P ∧ P * P = P ∧ LinearMap.range (Matrix.toLin' P) = V := by
  let V' : Submodule ℂ (EuclideanSpace ℂ ι) :=
    V.comap (WithLp.linearEquiv 2 ℂ (ι → ℂ)).toLinearMap
  have hmem : ∀ y : EuclideanSpace ℂ ι, y ∈ V' ↔ y.ofLp ∈ V := fun _ => Iff.rfl
  let e := Matrix.toEuclideanCLM (n := ι) (𝕜 := ℂ)
  let P : Matrix ι ι ℂ := e.symm V'.starProjection
  have hstar : IsStarProjection P := isStarProjection_starProjection.map e.symm
  have hQ : e P = V'.starProjection := e.apply_symm_apply _
  have happly : ∀ x : ι → ℂ, Matrix.toLin' P x = (V'.starProjection (WithLp.toLp 2 x)).ofLp := by
    intro x
    rw [Matrix.toLin'_apply, ← hQ, Matrix.toEuclideanCLM_toLp]
  refine ⟨P, hstar.isSelfAdjoint, hstar.isIdempotentElem, ?_⟩
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    rw [happly, ← hmem]
    exact V'.starProjection_apply_mem _
  · intro hx
    refine ⟨x, ?_⟩
    rw [happly, Submodule.starProjection_eq_self_iff.2 ((hmem _).2 hx)]

/-- Membership in the Hamming (7,4) code is decided by its syndrome. -/
instance instDecidablePredMemHammingCode : DecidablePred (· ∈ Hamming74.code) := fun c =>
  decidable_of_iff (syndrome Hamming74.H c = 0) mem_ofParityCheck.symm

/-- The dual of the Hamming (7,4) code, the code generated by its parity-check matrix, lies in the
code: the rows of `H` are orthogonal to each other. -/
theorem dual_hammingCode_le : dual Hamming74.code ≤ Hamming74.code := by
  rw [Hamming74.code, dual_ofParityCheck, ofGenerator_le_ofParityCheck_iff]
  decide +kernel

theorem three_le_hammingNorm {c : Fin 7 → ZMod 2} (hc : c ∈ Hamming74.code) (hne : c ≠ 0) :
    3 ≤ hammingNorm c := by
  exact_mod_cast le_minWeight_iff.1 Hamming74.three_le_minWeight_code c hc hne

/-- **Steane's code corrects one error.** For `C₁` the Hamming (7,4) code and `C₂ = C₁^⊥`, every
Pauli error on at most one of the seven qubits is correctable on the code. -/
theorem steane_isCorrectable (P : Matrix (Fin 7 → ZMod 2) (Fin 7 → ZMod 2) ℂ) (hP : Pᴴ = P)
    (hPP : P * P = P)
    (hrange : LinearMap.range (Matrix.toLin' P) = Submodule.span ℂ
      (codeword Hamming74.code '' (dual (dual Hamming74.code) : Set (Fin 7 → ZMod 2)))) :
    IsCorrectable P (fun e : {e : (Fin 7 → ZMod 2) × (Fin 7 → ZMod 2) //
        2 * (Finset.univ.filter fun i => e.1 i ≠ 0 ∨ e.2 i ≠ 0).card + 1 ≤ 3} =>
      pauli e.1.1 e.1.2) :=
  isCorrectable_css Hamming74.code (dual Hamming74.code) dual_hammingCode_le
    (fun _ hc hne => three_le_hammingNorm hc hne)
    (fun _ hc hne => three_le_hammingNorm (by rwa [dual_dual] at hc) hne) P hP hPP hrange

-- The hypotheses are jointly satisfiable: Steane's code has a projector, and on it every
-- single-qubit Pauli error is correctable.
example : ∃ P : Matrix (Fin 7 → ZMod 2) (Fin 7 → ZMod 2) ℂ, Pᴴ = P ∧ P * P = P ∧
    LinearMap.range (Matrix.toLin' P) = Submodule.span ℂ
      (codeword Hamming74.code '' (dual (dual Hamming74.code) : Set (Fin 7 → ZMod 2))) ∧
    IsCorrectable P (fun e : {e : (Fin 7 → ZMod 2) × (Fin 7 → ZMod 2) //
        2 * (Finset.univ.filter fun i => e.1 i ≠ 0 ∨ e.2 i ≠ 0).card + 1 ≤ 3} =>
      pauli e.1.1 e.1.2) := by
  obtain ⟨P, hP, hPP, hrange⟩ := exists_proj (Submodule.span ℂ
    (codeword Hamming74.code '' (dual (dual Hamming74.code) : Set (Fin 7 → ZMod 2))))
  exact ⟨P, hP, hPP, hrange, steane_isCorrectable P hP hPP hrange⟩

-- With `d = 3`, the family contains `X`, `Z` and `XZ` on each qubit `i`.
example : ∀ i : Fin 7, ∀ a b : ZMod 2,
    2 * (Finset.univ.filter fun j =>
      (Pi.single i a : Fin 7 → ZMod 2) j ≠ 0 ∨ (Pi.single i b : Fin 7 → ZMod 2) j ≠ 0).card + 1 ≤
      3 := by
  decide

-- It does not contain errors on two qubits, such as `X` on qubit `0` with `Z` on qubit `1`.
example : ¬ 2 * (Finset.univ.filter fun j =>
    (Pi.single 0 1 : Fin 7 → ZMod 2) j ≠ 0 ∨ (Pi.single 1 1 : Fin 7 → ZMod 2) j ≠ 0).card + 1 ≤
      3 := by
  decide

end Cslib.CodingTheory.CSSWanted.Tests
