module

public import CSLibExt.Crypto.PublicKey.KEM

/-!
# Tests for Diffie–Hellman security and KEM/DEM hybrid encryption

* Diffie–Hellman in `(ZMod 23)ˣ` with `g = 5`, `a = 4`, `b = 3`: transcript `(4, 10)`, and Alice
  and Bob both output `18`.
* `G5 = Multiplicative (ZMod 5)`, generated by `ofAdd 1`. An eavesdropper that takes discrete
  logarithms recognizes the real key always and a uniform key with probability `1/5`, so its DDH
  advantage is `4/5` and, by `keAdvantage_eq`, its `KE^eav` advantage is `2/5`.
* Key derivation: squaring on `G5` and reduction `ZMod 6 → ZMod 3` are uniform KDFs; a constant
  function is not.
* The Diffie–Hellman KEM on `G5` is correct; a KEM adversary taking discrete logarithms has DDH
  advantage `4/5` and KEM advantage `2/5`.
* The one-time-pad DEM is CSLib's `groupOTP G5` embedded by `SymmEncScheme.ofEncScheme`; it
  encrypts and decrypts a concrete message, and a wrong key fails.
* Hybrid encryption (Diffie–Hellman KEM + one-time-pad DEM) decrypts a concrete ciphertext and is
  correct; an adversary taking discrete logarithms has CPA advantage `1/2`, so the hybrid bound
  forces the two DDH advantages to average at least `1/2`.
-/

@[expose] public section

namespace Cslib.Crypto.DHKEMTests

open Cslib.Crypto.PublicKey Cslib.Crypto.PublicKey.DHSecurity Cslib.Crypto.PublicKey.KEM
  Cslib.Crypto.PublicKey.ElGamal Cslib.Crypto.Framework Cslib.Crypto.Protocols.PerfectSecrecy Finset
open Cslib.Probability.PMF (uniformOfFintype)

/-! ### Concrete Diffie–Hellman in `(ZMod 23)ˣ` -/

/-- The generator `5` of `(ZMod 23)ˣ`. -/
def five : (ZMod 23)ˣ := ⟨5, 14, by decide, by decide⟩

/-- The transcript for `a = 4`, `b = 3`. -/
abbrev tr : (ZMod 23)ˣ × (ZMod 23)ˣ := transcript five (4 : ZMod 22) (3 : ZMod 22)

example : (tr.1.val, tr.2.val) = (4, 10) := by decide

example : (aliceKey (4 : ZMod 22) tr.2).val = 18 ∧ (bobKey (3 : ZMod 22) tr.1).val = 18 := by
  decide

example : aliceKey (4 : ZMod 22) tr.2 = bobKey (3 : ZMod 22) tr.1 :=
  aliceKey_eq_bobKey five 4 3

/-! ### Eavesdropping security on `G5` -/

/-- The group `ZMod 5`, written multiplicatively. -/
abbrev G5 := Multiplicative (ZMod 5)

/-- The generator of `G5`. -/
abbrev g5 : G5 := Multiplicative.ofAdd 1

theorem generates : ∀ x : G5, x ∈ Subgroup.zpowers g5 := by
  intro x
  refine Subgroup.mem_zpowers_iff.mpr ⟨(Multiplicative.toAdd x).val, ?_⟩
  rw [zpow_natCast, ← ofAdd_nsmul, nsmul_one, ZMod.natCast_zmod_val]
  rfl

theorem card_G5 : Fintype.card G5 = 5 := by simp [G5]

/-- An eavesdropper that computes the discrete logarithm of Alice's message and checks the
candidate key. -/
def dlogEve : G5 → G5 → G5 → Unit → Bool :=
  fun X Y Z _ => decide (Z = gpow Y (Multiplicative.toAdd X))

theorem winProb_ddhReal_dlogEve : winProb (ddhReal 5 g5 dlogEve) = 1 := by
  have h : ddhReal 5 g5 dlogEve = PMF.pure true := by
    rw [ddhReal, ← PMF.map_const (uniformOfFintype (ZMod 5 × ZMod 5 × Unit)) true]
    congr 1
    funext ω
    revert ω
    decide
  rw [h, winProb_pure]; rfl

theorem winProb_ddhRand_dlogEve : winProb (ddhRand 5 g5 dlogEve) = 1 / 5 := by
  rw [ddhRand, winProb_map_uniform]
  have h : (univ.filter fun ω : ZMod 5 × ZMod 5 × ZMod 5 × Unit =>
      dlogEve (gpow g5 ω.1) (gpow g5 ω.2.1) (gpow g5 ω.2.2.1) ω.2.2.2 = true).card = 25 := by
    decide
  rw [h]
  simp [Fintype.card_prod]
  norm_num

theorem ddhAdvantage_dlogEve : ddhAdvantage 5 g5 dlogEve = 4 / 5 := by
  have h1 := winProb_ddhReal_dlogEve
  have h2 := winProb_ddhRand_dlogEve
  rw [winProb] at h1 h2
  rw [ddhAdvantage, h1, h2]
  norm_num

/-- The distinguishing advantage between the real and the random key is the DDH advantage. -/
example : advantage (keReal 5 g5 dlogEve) (keRand 5 g5 dlogEve) = 4 / 5 := by
  rw [advantage_keReal_keRand g5 generates card_G5, ddhAdvantage_dlogEve]

/-- **`KE^eav` advantage `2/5`**, by the exact theorem. -/
example : keAdvantage 5 g5 dlogEve = 2 / 5 := by
  rw [keAdvantage_eq g5 generates card_G5, ddhAdvantage_dlogEve]
  norm_num

example {ε : ℝ} (h : ddhAdvantage 5 g5 dlogEve ≤ ε) : keAdvantage 5 g5 dlogEve ≤ ε / 2 :=
  keAdvantage_le g5 generates card_G5 dlogEve h

/-! ### Key derivation -/

/-- Squaring is a bijection of `G5`, hence a uniform KDF. -/
theorem isUniformKDF_sq : IsUniformKDF (fun x : G5 => x ^ 2) :=
  isUniformKDF_of_bijective (by decide)

/-- Reduction mod `3` from `ZMod 6` has fibers of size `2`, hence is a uniform KDF. -/
example : IsUniformKDF (fun x : ZMod 6 => (x.val : ZMod 3)) :=
  isUniformKDF_of_card_fiber (by decide)

/-- A constant function is not a uniform KDF. -/
example : ¬ IsUniformKDF (fun _ : ZMod 3 => (0 : ZMod 3)) := by
  intro h
  have h1 := PMF.ext_iff.1 h 1
  rw [PMF.map_apply] at h1
  simp only [one_ne_zero, ite_false, tsum_zero, Cslib.Probability.PMF.uniformOfFintype_apply] at h1
  exact (ENNReal.inv_ne_zero.2 (by simp)) h1.symm

/-- An eavesdropper on the squared key. -/
def sqEve : G5 → G5 → G5 → Unit → Bool :=
  fun X Y k _ => decide (k = gpow Y (Multiplicative.toAdd X) ^ 2)

example : kdfAdvantage 5 g5 (fun x : G5 => x ^ 2) sqEve =
    ddhAdvantage 5 g5 (kdfDist (fun x : G5 => x ^ 2) sqEve) / 2 :=
  kdfAdvantage_eq g5 generates card_G5 isUniformKDF_sq sqEve

/-! ### The Diffie–Hellman KEM -/

example : (dhKEM 5 g5 (id : G5 → G5)).Correct := dhKEM_correct g5 id

/-- Decapsulating `g ^ 2` with secret key `3` gives `g ^ 6 = g`. -/
example : (dhKEM 5 g5 (id : G5 → G5)).decaps 3 (gpow g5 (2 : ZMod 5)) = some g5 := by decide

/-- A KEM adversary that takes discrete logarithms; it outputs `true` ("random") when the key is
not the real one. -/
noncomputable def kemBreaker : KEMAdversary G5 G5 G5 Unit where
  coins := uniformOfFintype Unit
  guess pk e k _ := !decide (k = gpow e (Multiplicative.toAdd pk))

theorem ddhAdvantage_kemBreaker :
    ddhAdvantage 5 g5 (kdfDist (id : G5 → G5) kemBreaker.guess) = 4 / 5 := by
  have h1 : ddhReal 5 g5 (kdfDist (id : G5 → G5) kemBreaker.guess) = PMF.pure false := by
    rw [ddhReal, ← PMF.map_const (uniformOfFintype (ZMod 5 × ZMod 5 × Unit)) false]
    congr 1
    funext ω
    revert ω
    decide
  have h2 : winProb (ddhRand 5 g5 (kdfDist (id : G5 → G5) kemBreaker.guess)) = 4 / 5 := by
    rw [ddhRand, winProb_map_uniform]
    have h : (univ.filter fun ω : ZMod 5 × ZMod 5 × ZMod 5 × Unit =>
        kdfDist (id : G5 → G5) kemBreaker.guess (gpow g5 ω.1) (gpow g5 ω.2.1) (gpow g5 ω.2.2.1)
          ω.2.2.2 = true).card = 100 := by
      decide
    rw [h]
    simp [Fintype.card_prod]
    norm_num
  rw [winProb] at h2
  rw [ddhAdvantage, h1, h2, PMF.pure_apply]
  simp only [Bool.true_eq_false, ite_false, ENNReal.toReal_zero]
  norm_num

/-- **KEM advantage `2/5`**, by `kemAdvantage_dhKEM`. -/
example : kemAdvantage (dhKEM 5 g5 (id : G5 → G5)) kemBreaker = 2 / 5 := by
  rw [kemAdvantage_dhKEM g5 generates card_G5 (isUniformKDF_of_bijective Function.bijective_id)
    kemBreaker rfl, ddhAdvantage_kemBreaker]
  norm_num

/-! ### Hybrid encryption -/

/-- The one-time-pad DEM is CSLib's group one-time pad, embedded by `ofEncScheme`. -/
example : otpDEM G5 = SymmEncScheme.ofEncScheme (groupOTP G5) := rfl

/-- Key `ofAdd 2`: the message `ofAdd 4` encrypts to `ofAdd 1`, which decrypts back to
`ofAdd 4`. -/
example : (otpDEM G5).enc (Multiplicative.ofAdd 2) (Multiplicative.ofAdd 4) =
    PMF.pure (Multiplicative.ofAdd 1) := rfl

example : (otpDEM G5).dec (Multiplicative.ofAdd 2) (Multiplicative.ofAdd 1) =
    some (Multiplicative.ofAdd 4) := by decide

/-- A wrong key `ofAdd 3` does not recover the message. -/
example : (otpDEM G5).dec (Multiplicative.ofAdd 3) (Multiplicative.ofAdd 1) ≠
    some (Multiplicative.ofAdd 4) := by decide

/-- The ElGamal-style hybrid scheme on `G5`. -/
noncomputable abbrev hyb5 := hybrid (dhKEM 5 g5 (id : G5 → G5)) (otpDEM G5)

/-- Secret key `3`, encapsulation randomness `2`, message `ofAdd 4`: the ciphertext
`(g ^ 2, g ^ 6 · ofAdd 4) = (ofAdd 2, ofAdd 0)` decrypts to `ofAdd 4`. -/
example : hyb5.dec 3 (Multiplicative.ofAdd 2, Multiplicative.ofAdd 0) =
    some (Multiplicative.ofAdd 4) := by decide

private theorem mem_support_uniform {α : Type*} [Fintype α] [Nonempty α] (a : α) :
    a ∈ (uniformOfFintype α).support :=
  (PMF.mem_support_iff _ _).2 (by simp)

theorem hyb5_correct : hyb5.Correct :=
  hybrid_correct (dhKEM_correct g5 id) (otpDEM_correct G5) fun _ _ _ _ => mem_support_uniform _

/-- A CPA adversary against `hyb5` that recovers the secret key by a discrete logarithm and
decrypts the challenge. -/
noncomputable def hybBreaker : PubCPAAdversary G5 G5 (G5 × G5) Unit where
  coins := uniformOfFintype Unit
  choose _ _ := (1, g5)
  guess pk c _ := decide ((gpow c.1 (Multiplicative.toAdd pk))⁻¹ * c.2 = g5)

theorem hybBreaker_pubCpaExp (b : Bool) : pubCpaExp hyb5 hybBreaker b = PMF.pure b := by
  have h : ∀ x y : ZMod 5, decide ((gpow (gpow g5 y) (Multiplicative.toAdd (gpow g5 x)))⁻¹ *
      (gpow (gpow g5 x) y * Framework.pick (1, g5) b) = g5) = b := by
    cases b <;> decide
  simp only [pubCpaExp, hybrid, dhKEM, otpDEM, SymmEncScheme.ofEncScheme, groupOTP,
    EncScheme.ofPure, hybBreaker, PMF.bind_map, PMF.map_bind,
    PMF.pure_map, Function.comp_def, id, h, PMF.bind_const]

/-- **CPA advantage `1/2`** against the hybrid scheme. -/
theorem hybBreaker_pubCpaAdvantage : pubCpaAdvantage hyb5 hybBreaker = 1 / 2 := by
  rw [pubCpaAdvantage_eq, hybBreaker_pubCpaExp, hybBreaker_pubCpaExp, advantage]
  simp

/-- The hybrid bound, instantiated: the two DDH reductions average advantage at least `1/2`. -/
example : 1 / 2 ≤
    (ddhAdvantage 5 g5 (kdfDist id (kemReduction (fun k m (_ : Unit) => k * m)
        (uniformOfFintype Unit) hybBreaker true).guess) +
      ddhAdvantage 5 g5 (kdfDist id (kemReduction (fun k m (_ : Unit) => k * m)
        (uniformOfFintype Unit) hybBreaker false).guess)) / 2 :=
  hybBreaker_pubCpaAdvantage ▸ pubCpaAdvantage_dhHybrid_le g5 generates card_G5 hybBreaker rfl

/-- The DEM term of the generic bound is `0` for the one-time pad. -/
example : cpaAdvantage (otpDEM G5) (demReduction (dhKEM 5 g5 (id : G5 → G5)) hybBreaker) = 0 :=
  cpaAdvantage_otpDEM_demReduction _ _

end Cslib.Crypto.DHKEMTests
