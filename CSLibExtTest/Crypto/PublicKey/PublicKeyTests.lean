module

public import CSLibExt.Crypto.PublicKey.RSA
public import CSLibExt.Crypto.PublicKey.ElGamal
public import CSLibExt.Crypto.Protocols.PerfectSecrecy.GroupOneTimePad
public import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for RSA, Diffie–Hellman and ElGamal

* RSA with `p = 61`, `q = 53`, `e = 17`, `d = 2753`: `65` encrypts to `2790`, and the
  correctness theorem decrypts it back. A message that shares the factor `61` with the modulus
  also decrypts correctly. The standard RSA-CRT exponents are `d_p = 53` and `d_q = 49`.
* Diffie–Hellman in `(ZMod 23)ˣ` with `g = 5`, `a = 4`, `b = 3`: the public values are `4` and
  `10`, and both parties derive the key `18`.
* The group one-time pad on `Multiplicative (ZMod 5)` is perfectly secret. ElGamal on the same
  group, generated by `ofAdd 1`, decrypts correctly and satisfies the hypotheses of the DDH
  reduction. An adversary that computes discrete logarithms wins with probability `1`, so its
  eavesdropping advantage and the DDH advantage of its reduction are both `1/2`.
-/

@[expose] public section

namespace Cslib.Crypto.PublicKeyTests

open Cslib.Crypto.PublicKey

/-- The textbook example key `n = 61 * 53 = 3233`, `e = 17`, `d = 2753`. -/
def key : RSA.Key where
  p := 61
  q := 53
  hp := by norm_num
  hq := by norm_num
  hpq := by decide
  e := 17
  d := 2753
  hed_p := by decide
  hed_q := by decide

example : key.n = 3233 := rfl

/-- `65` encrypts to `2790`. -/
example : 65 ^ key.e % key.n = 2790 := by decide

/-- ... and decrypts back to `65`, by the correctness theorem. -/
example : (65 ^ key.e % key.n) ^ key.d % key.n = 65 :=
  key.decrypt_encrypt_nat (by decide)

/-- A message divisible by `p = 61` (not coprime to `n`) also decrypts correctly. -/
example : (61 ^ key.e % key.n) ^ key.d % key.n = 61 :=
  key.decrypt_encrypt_nat (by decide)

/-- RSA-CRT with `d_p = 2753 mod 60 = 53` and `d_q = 2753 mod 52 = 49`. -/
example (c : ZMod key.n) : key.crtDecrypt 53 49 c = key.decrypt c :=
  key.crtDecrypt_mod_eq (by decide) (by decide) c

/-- Encryption is a permutation of `ZMod 3233`. -/
example : Function.Bijective key.encrypt := key.encrypt_bijective

/-- The generator `5` of `(ZMod 23)ˣ`. -/
def five : (ZMod 23)ˣ := ⟨5, 14, by decide, by decide⟩

/-- Diffie–Hellman public values: `5 ^ 4 = 4` and `5 ^ 3 = 10` in `ZMod 23`. -/
example : (gpow five (4 : ZMod 22)).val = 4 ∧ (gpow five (3 : ZMod 22)).val = 10 := by
  decide

/-- Both parties derive the key `18`. -/
example : (gpow (gpow five (3 : ZMod 22)) (4 : ZMod 22)).val = 18 ∧
    (gpow (gpow five (4 : ZMod 22)) (3 : ZMod 22)).val = 18 := by
  decide

example (a b : ZMod 22) : gpow (gpow five b) a = gpow (gpow five a) b := dh_agree five a b

/-- The group `ZMod 5`, written multiplicatively. -/
abbrev G5 := Multiplicative (ZMod 5)

example : (Cslib.Crypto.Protocols.PerfectSecrecy.groupOTP G5).PerfectlySecret :=
  Cslib.Crypto.Protocols.PerfectSecrecy.groupOTP_perfectlySecret G5

theorem generates : ∀ x : G5, x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod 5)) := by
  intro x
  refine Subgroup.mem_zpowers_iff.mpr ⟨(Multiplicative.toAdd x).val, ?_⟩
  rw [zpow_natCast, ← ofAdd_nsmul, nsmul_one, ZMod.natCast_zmod_val]
  rfl

theorem card_G5 : Fintype.card G5 = 5 := by simp [G5]

example (x y : ZMod 5) (m : G5) :
    ElGamal.decrypt x (ElGamal.encrypt (Multiplicative.ofAdd 1)
      (ElGamal.publicKey (Multiplicative.ofAdd 1) x) m y) = m :=
  ElGamal.decrypt_encrypt _ x y m

example (A : ElGamal.Adversary G5 Bool) :
    ElGamal.eavAdvantage 5 (Multiplicative.ofAdd 1) A =
      ElGamal.ddhAdvantage 5 (Multiplicative.ofAdd 1) (ElGamal.reduction A) :=
  ElGamal.eavAdvantage_eq_ddhAdvantage _ generates card_G5 A

/-- An adversary that reads the secret key off `h` (discrete logarithms are easy in `ZMod 5`)
and decrypts, so it always wins. -/
def breaker : ElGamal.Adversary G5 Unit where
  choose _ _ := (1, Multiplicative.ofAdd 1)
  guess h c _ :=
    decide (ElGamal.decrypt (q := 5) (Multiplicative.toAdd h) c = Multiplicative.ofAdd 1)

theorem breaker_eavAdvantage : ElGamal.eavAdvantage 5 (Multiplicative.ofAdd 1) breaker = 1 / 2 := by
  have h : ElGamal.eavGame 5 (Multiplicative.ofAdd 1) breaker = PMF.pure true := by
    rw [ElGamal.eavGame,
      ← PMF.map_const (Cslib.Probability.PMF.uniformOfFintype
        (ZMod 5 × ZMod 5 × Unit × Bool)) true]
    congr 1
    funext ω
    revert ω
    decide
  rw [ElGamal.eavAdvantage, h, PMF.pure_apply_self]
  norm_num

/-- Hence the DDH reduction also has advantage `1/2`: neither advantage is trivially zero. -/
example : ElGamal.ddhAdvantage 5 (Multiplicative.ofAdd 1) (ElGamal.reduction breaker) = 1 / 2 :=
  (ElGamal.eavAdvantage_eq_ddhAdvantage _ generates card_G5 breaker).symm.trans
    breaker_eavAdvantage

end Cslib.Crypto.PublicKeyTests
