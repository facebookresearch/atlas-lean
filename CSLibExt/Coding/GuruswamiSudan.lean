/-!
# Guruswami–Sudan list decoding of Reed–Solomon codes: the root-finding lemma

Bivariate polynomials are elements `Q` of `F[X][X]`: the outer variable plays the role of `Y`
and the coefficients `Q.coeff j ∈ F[X]` are polynomials in `X`. Substituting a polynomial
`P(X)` for `Y` is `Q.eval P`.

* `WeightedDegLE w D Q`: every monomial `X^i Y^j` of `Q` has `(1, w)`-weighted degree
  `i + w j ≤ D`. Then `deg Q(X, P(X)) ≤ D` whenever `deg P ≤ w` (`natDegree_eval_le`).
* `HasRootMult Q a b r`: `Q` vanishes to order at least `r` at the point `(a, b)`, that is `Q`
  lies in the `r`-th power of the ideal `(X - a, Y - b)`. Then `(X - a) ^ r` divides
  `Q(X, P(X))` whenever `P(a) = b` (`pow_dvd_eval_of_hasRootMult`).
* `eval_eq_zero_of_agree` (**Guruswami–Sudan root-finding lemma**): if `Q` has `(1, w)`-degree at
  most `D` and multiplicity `r` at every point `(αᵢ, yᵢ)` (distinct `αᵢ`), then every `P` of
  degree at most `w` agreeing with `y` at more than `D / r` of the points has `Q(X, P(X)) = 0`,
  i.e. `Y - P(X)` divides `Q` (`X_sub_C_dvd_of_agree`).
* `card_le_of_agree_ge` (**Reed–Solomon codes are list decodable up to the Johnson radius**): if
  `t² > n (k - 1)`, at most `n (n - k + 1)` polynomials of degree less than `k` agree with a
  received word in at least `t` positions; the Johnson bound for the MDS Reed–Solomon codes.
* `hasRootMult_of_coeff`: if the translate `Q(X + a, Y + b)` has no monomial of total degree
  less than `r` (Definition 12.2.9 of Guruswami, Rudra and Sudan), then `HasRootMult Q a b r`.
* `exists_interpolant` (**Guruswami–Sudan interpolation step**): if there are more monomials
  `X^i Y^j` with `i + w j ≤ D` than the `n · r (r + 1) / 2` linear constraints
  (`card_lowMonomials`), a nonzero interpolating polynomial exists.
* `exists_interpolant_dvd` (**Guruswami–Sudan list decoding**): one nonzero `Q`, depending only
  on the received word, is divisible by `Y - P(X)` for every `P` of degree at most `w` agreeing
  with the received word in more than `D / r` positions; there are at most `D / w` such `P`
  (`card_le_div_of_dvd`). The choice of `D` and `r` reaching the `1 - √R` radius (Theorem
  12.2.12 of Guruswami, Rudra and Sudan) is not formalized.

## References

* V. Guruswami, M. Sudan, "Improved decoding of Reed–Solomon and algebraic-geometry codes",
  *IEEE Transactions on Information Theory* 45(6) (1999), 1757–1767.
* V. Guruswami, A. Rudra, M. Sudan, *Essential Coding Theory*, draft of August 26, 2025,
  Section 12.2: Definition 12.2.5, Lemma 12.2.6, Definitions 12.2.8–12.2.9, Algorithm 12.2.3,
  Lemma 12.2.10, Theorem 12.2.12, Lemma 12.2.13 and Claim 12.2.14.
-/

@[expose] public section

namespace Cslib.CodingTheory.GuruswamiSudan

open Polynomial Finset

variable {F : Type*} [Field F]

/-- **Weighted degree bound.** A bivariate polynomial `Q ∈ F[X][Y]` (an element of `F[X][X]`
whose outer variable is `Y`) has `(1, w)`-weighted degree at most `D` if every monomial
`X^i Y^j` with nonzero coefficient has `i + w j ≤ D` (Guruswami, Rudra and Sudan, *Essential
Coding Theory*, draft of August 26, 2025, Definition 12.2.5). -/
def WeightedDegLE (w D : ℕ) (Q : F[X][X]) : Prop :=
  ∀ j i, (Q.coeff j).coeff i ≠ 0 → i + w * j ≤ D

/-- **Ideal of a point of the plane.** The ideal `(X - a, Y - b)` of `F[X][Y]`, generated by
`X - a` (a constant in `Y`) and `Y - b`. -/
noncomputable def pointIdeal (a b : F) : Ideal F[X][X] :=
  Ideal.span {C (X - C a), X - C (C b)}

/-- **Root of multiplicity `r`.** A bivariate polynomial `Q` has a root of multiplicity at least
`r` at `(a, b)` if `Q` lies in the `r`-th power of the ideal `(X - a, Y - b)`. Equivalently, the
translate `Q(X + a, Y + b)` has no monomial of total degree less than `r`, which is how
Guruswami, Rudra and Sudan, *Essential Coding Theory* (draft of August 26, 2025), Definitions
12.2.8 and 12.2.9, phrase it. -/
def HasRootMult (Q : F[X][X]) (a b : F) (r : ℕ) : Prop :=
  Q ∈ pointIdeal a b ^ r

/-- **Substitution respects the weighted degree.** If `Q` has `(1, w)`-weighted degree at most
`D` and `deg P ≤ w`, then `Q(X, P(X))` has degree at most `D` (Guruswami, Rudra and Sudan,
*Essential Coding Theory*, draft of August 26, 2025, Lemma 12.2.6). -/
theorem natDegree_eval_le {w D : ℕ} {Q : F[X][X]} (hQ : WeightedDegLE w D Q) {P : F[X]}
    (hP : P.natDegree ≤ w) : (Q.eval P).natDegree ≤ D := by
  rw [eval_eq_sum_range]
  refine natDegree_sum_le_of_forall_le _ _ fun j _ => ?_
  by_cases hj : Q.coeff j = 0
  · simp [hj]
  have hlead : (Q.coeff j).coeff (Q.coeff j).natDegree ≠ 0 := by
    rw [coeff_natDegree]; exact leadingCoeff_ne_zero.mpr hj
  have h1 := hQ j _ hlead
  calc (Q.coeff j * P ^ j).natDegree ≤ (Q.coeff j).natDegree + (P ^ j).natDegree :=
        natDegree_mul_le
    _ ≤ (Q.coeff j).natDegree + j * P.natDegree := Nat.add_le_add_left natDegree_pow_le _
    _ ≤ (Q.coeff j).natDegree + j * w := Nat.add_le_add_left (Nat.mul_le_mul_left _ hP) _
    _ ≤ D := by rw [mul_comm j w]; exact h1

/-- **A root of multiplicity `r` survives substitution.** If `Q` has a root of multiplicity at
least `r` at `(a, b)` and `P(a) = b`, then `(X - a) ^ r` divides `Q(X, P(X))` (Guruswami, Rudra
and Sudan, *Essential Coding Theory*, draft of August 26, 2025, Lemma 12.2.11 and Claim
12.2.14). The substitution `Y ↦ P(X)` maps `X - a` to itself and `Y - b` to `P - P(a)`, which is
divisible by `X - a`. -/
theorem pow_dvd_eval_of_hasRootMult {Q : F[X][X]} {a b : F} {r : ℕ} (hQ : HasRootMult Q a b r)
    {P : F[X]} (hP : P.eval a = b) : (X - C a) ^ r ∣ Q.eval P := by
  have hmap : Ideal.map (evalRingHom P) (pointIdeal a b) ≤ Ideal.span {X - C a} := by
    rw [pointIdeal, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨g, hg, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rw [SetLike.mem_coe, Ideal.mem_span_singleton]
    rcases hg with rfl | rfl
    · simp
    · simpa [hP] using (X_sub_C_dvd_sub_C_eval (a := a) (p := P))
  have hmem : Q.eval P ∈ Ideal.map (evalRingHom P) (pointIdeal a b ^ r) :=
    Ideal.mem_map_of_mem _ hQ
  rw [Ideal.map_pow] at hmem
  have := Ideal.pow_right_mono hmap r hmem
  rwa [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at this

/-- **Guruswami–Sudan root-finding lemma.** Let `α₁, …, αₙ ∈ F` be distinct and `y ∈ Fⁿ`. Let
`Q ∈ F[X][Y]` have `(1, w)`-weighted degree at most `D` and a root of multiplicity at least `r` at
every point `(αᵢ, yᵢ)`. If `P ∈ F[X]` has degree at most `w` and `P(αᵢ) = yᵢ` for `t` indices `i`
with `t r > D`, then `Q(X, P(X)) = 0`.

This is Lemma 12.2.13 of Guruswami, Rudra and Sudan, *Essential Coding Theory* (draft of August
26, 2025), with `w = k - 1`, stated there for the polynomial computed by the interpolation step
of Algorithm 12.2.3; only the weighted degree and multiplicity properties of that polynomial are
used. `Q(X, P(X))` has degree at most `D` but at least `t r` roots counted with multiplicity.
Source: V. Guruswami, M. Sudan, "Improved decoding of Reed–Solomon and algebraic-geometry codes",
*IEEE Transactions on Information Theory* 45(6) (1999), 1757–1767. -/
theorem eval_eq_zero_of_agree [DecidableEq F] {n w D r : ℕ} {α : Fin n → F}
    (hα : Function.Injective α) {y : Fin n → F} {Q : F[X][X]} (hQ : WeightedDegLE w D Q)
    (hmult : ∀ i, HasRootMult Q (α i) (y i) r) {P : F[X]} (hP : P.natDegree ≤ w)
    (hagree : D < #{i | P.eval (α i) = y i} * r) : Q.eval P = 0 := by
  set A : Finset (Fin n) := {i | P.eval (α i) = y i} with hA
  by_contra hR
  have hdvd : ∏ i ∈ A, (X - C (α i)) ^ r ∣ Q.eval P := by
    refine Finset.prod_dvd_of_coprime ?_ fun i hi => ?_
    · intro i _ j _ hij
      exact ((pairwise_coprime_X_sub_C hα) hij).pow
    · simp only [hA, mem_filter, mem_univ, true_and] at hi
      exact pow_dvd_eval_of_hasRootMult (hmult i) hi
  have hdeg : (∏ i ∈ A, (X - C (α i)) ^ r).natDegree = #A * r := by
    rw [natDegree_prod_of_monic _ _ fun i _ => (monic_X_sub_C (α i)).pow r]
    simp [natDegree_pow, mul_comm]
  have h1 := natDegree_le_of_dvd hdvd hR
  have h2 := natDegree_eval_le hQ hP
  omega

/-- **`Y - P(X)` divides the interpolating polynomial.** Under the hypotheses of
`eval_eq_zero_of_agree`, `Y - P(X)` divides `Q(X, Y)` in `F[X][Y]`: the root-finding step of the
Guruswami–Sudan algorithm finds every such `P` among the factors of `Q` (Guruswami, Rudra and
Sudan, *Essential Coding Theory*, draft of August 26, 2025, Lemma 12.2.13). -/
theorem X_sub_C_dvd_of_agree [DecidableEq F] {n w D r : ℕ} {α : Fin n → F}
    (hα : Function.Injective α) {y : Fin n → F} {Q : F[X][X]} (hQ : WeightedDegLE w D Q)
    (hmult : ∀ i, HasRootMult Q (α i) (y i) r) {P : F[X]} (hP : P.natDegree ≤ w)
    (hagree : D < #{i | P.eval (α i) = y i} * r) : X - C P ∣ Q :=
  dvd_iff_isRoot.mpr (eval_eq_zero_of_agree hα hQ hmult hP hagree)


/-! ### The interpolation step -/

/-- **Translation of the plane.** The `F`-algebra map `Q(X, Y) ↦ Q(X + a, Y + b)` of `F[X][Y]`. -/
noncomputable def shift (a b : F) : F[X][X] →ₐ[F] F[X][X] :=
  (mapAlgHom (taylorAlgHom a)).comp ((taylorAlgHom (C b)).restrictScalars F)

private theorem shift_C (a b : F) (p : F[X]) : shift a b (C p) = C (taylor a p) := by
  simp [shift]

private theorem shift_X (a b : F) : shift a b (X : F[X][X]) = X + C (C b) := by
  simp [shift]

private theorem shift_neg_shift (a b : F) (Q : F[X][X]) :
    shift (-a) (-b) (shift a b Q) = Q := by
  have : ((shift (-a) (-b)).toRingHom.comp (shift a b).toRingHom) = RingHom.id _ := by
    refine ringHom_ext (fun p => ?_) ?_
    · simp [shift_C, taylor_taylor]
    · simp [shift_X, shift_C]
  exact congrArg (fun f : F[X][X] →+* F[X][X] => f Q) this

private theorem map_span_le_pointIdeal (a b : F) :
    Ideal.map (shift (-a) (-b)) (Ideal.span {C X, X}) ≤ pointIdeal a b := by
  rw [Ideal.map_span, Ideal.span_le]
  rintro _ ⟨g, hg, rfl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl
  · refine Ideal.subset_span ?_
    simp [shift_C, sub_eq_add_neg]
  · refine Ideal.subset_span ?_
    simp [shift_X, sub_eq_add_neg]

private theorem mem_span_pow {Q : F[X][X]} {r : ℕ}
    (hQ : ∀ i j, i + j < r → (Q.coeff j).coeff i = 0) :
    Q ∈ Ideal.span {(C X : F[X][X]), X} ^ r := by
  rw [as_sum_support_C_mul_X_pow Q]
  refine sum_mem fun j _ => ?_
  rw [as_sum_support_C_mul_X_pow (Q.coeff j), map_sum, sum_mul]
  refine sum_mem fun i _ => ?_
  by_cases hij : i + j < r
  · rw [hQ i j hij]; simp
  · push Not at hij
    have h1 : (C (X ^ i) : F[X][X]) ∈ Ideal.span {(C X : F[X][X]), X} ^ i := by
      rw [map_pow]; exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) i
    have h2 : (X ^ j : F[X][X]) ∈ Ideal.span {(C X : F[X][X]), X} ^ j :=
      Ideal.pow_mem_pow (Ideal.subset_span (by simp)) j
    have h3 : C (X ^ i) * X ^ j ∈ Ideal.span {(C X : F[X][X]), X} ^ (i + j) := by
      rw [Ideal.IsTwoSided.pow_add]
      exact Ideal.mul_mem_mul h1 h2
    have h4 := Ideal.pow_le_pow_right hij h3
    rw [map_mul, mul_assoc]
    exact Ideal.mul_mem_left _ _ h4

/-- **Multiplicity from the translated coefficients.** If the translate `Q(X + a, Y + b)` has no
monomial of total degree less than `r`, then `Q` has a root of multiplicity at least `r` at
`(a, b)`. This is the direction of the equivalence with Definitions 12.2.8–12.2.9 of Guruswami,
Rudra and Sudan, *Essential Coding Theory* (draft of August 26, 2025), that the interpolation step
needs: the multiplicity conditions are linear conditions on the coefficients of `Q`. -/
theorem hasRootMult_of_coeff {Q : F[X][X]} {a b : F} {r : ℕ}
    (hQ : ∀ i j, i + j < r → ((shift a b Q).coeff j).coeff i = 0) : HasRootMult Q a b r := by
  have h := Ideal.mem_map_of_mem (shift (-a) (-b)) (mem_span_pow hQ)
  rw [shift_neg_shift, Ideal.map_pow] at h
  exact Ideal.pow_right_mono (map_span_le_pointIdeal a b) r h

/-- The coefficient of `X^u Y^v` in `Q(X + a, Y + b)`, as a linear form in `Q`. -/
private noncomputable def coeffShift (a b : F) (u v : ℕ) : F[X][X] →ₗ[F] F :=
  (lcoeff F u) ∘ₗ ((lcoeff F[X] v).restrictScalars F) ∘ₗ (shift a b).toLinearMap

private theorem coeffShift_apply (a b : F) (u v : ℕ) (Q : F[X][X]) :
    coeffShift a b u v Q = ((shift a b Q).coeff v).coeff u := rfl

/-- **Monomials of low total degree.** The pairs `(u, v)` with `u + v < r`, grouped by the total
degree `s = u + v`: the coefficients that a root of multiplicity `r` forces to vanish. -/
noncomputable abbrev lowMonomials (r : ℕ) : Finset (Σ _ : ℕ, ℕ × ℕ) :=
  (range r).sigma fun s => antidiagonal s

/-- **Number of multiplicity constraints.** There are `r (r + 1) / 2 = C(r + 1, 2)` monomials of
total degree less than `r` (Guruswami, Rudra and Sudan, *Essential Coding Theory*, draft of August
26, 2025, Lemma 12.2.10). -/
theorem card_lowMonomials (r : ℕ) : (lowMonomials r).card = r * (r + 1) / 2 := by
  rw [card_sigma]
  simp only [Nat.card_antidiagonal]
  have h := Finset.sum_range_id_mul_two (r + 1)
  rw [sum_range_succ'] at h
  simp only [add_zero, Nat.add_sub_cancel] at h
  symm
  refine Nat.div_eq_of_eq_mul_left (by norm_num) ?_
  rw [h, mul_comm]

/-- **Guruswami–Sudan interpolation step.** Let `F` be a field, `(α₁, y₁), …, (αₙ, yₙ) ∈ F²`, and
`w, D, r` natural numbers. If the number of monomials `X^i Y^j` with `i, j ≤ D` and `i + w j ≤ D`
exceeds `n · r (r + 1) / 2`, there is a nonzero `Q ∈ F[X][Y]` of `(1, w)`-weighted degree at most
`D` with a root of multiplicity at least `r` at every point `(αᵢ, yᵢ)`.

This is the correctness of Step 1 of Algorithm 12.2.3 in Guruswami, Rudra and Sudan, *Essential
Coding Theory* (draft of August 26, 2025): each multiplicity condition is `C(r + 1, 2)`
homogeneous linear constraints on the coefficients of `Q` (Lemma 12.2.10), and a homogeneous
linear system with more unknowns than equations has a nonzero solution. Source: V. Guruswami,
M. Sudan, "Improved decoding of Reed–Solomon and algebraic-geometry codes", *IEEE Transactions on
Information Theory* 45(6) (1999), 1757–1767. -/
theorem exists_interpolant {n : ℕ} (α y : Fin n → F) (w D r : ℕ)
    (hcount : n * (r * (r + 1) / 2) <
      ((range (D + 1) ×ˢ range (D + 1)).filter fun ij : ℕ × ℕ => ij.1 + w * ij.2 ≤ D).card) :
    ∃ Q : F[X][X], Q ≠ 0 ∧ WeightedDegLE w D Q ∧ ∀ i, HasRootMult Q (α i) (y i) r := by
  classical
  set M := (range (D + 1) ×ˢ range (D + 1)).filter fun ij : ℕ × ℕ => ij.1 + w * ij.2 ≤ D
    with hM
  -- The encoder of coefficient vectors indexed by the monomials of `M`.
  let v : M → F[X][X] := fun m => C (X ^ m.1.1) * X ^ m.1.2
  let e : (M → F) →ₗ[F] F[X][X] := ∑ m, (LinearMap.proj m).smulRight (v m)
  have he : ∀ c, e c = ∑ m, c m • v m := by intro c; simp [e]
  have hcoeff : ∀ c (i j : ℕ),
      ((e c).coeff j).coeff i = if h : (i, j) ∈ M then c ⟨(i, j), h⟩ else 0 := by
    intro c i j
    rw [he, finsetSum_coeff, finsetSum_coeff]
    have hterm : ∀ m : M,
        ((c m • v m).coeff j).coeff i = if m.1 = (i, j) then c m else 0 := by
      intro m
      simp only [v, AddMonoidAlgebra.coeff_smul_apply, coeff_C_mul_X_pow]
      by_cases h : m.1 = (i, j)
      · rw [ite_eq_left h]; obtain ⟨⟨u, w'⟩, hm⟩ := m; simp only [Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h; simp
      · rw [ite_eq_right h]
        obtain ⟨⟨u, w'⟩, hm⟩ := m
        simp only [Prod.mk.injEq, not_and_or] at h
        rcases h with h | h
        · by_cases hj : j = w' <;> simp [hj, coeff_X_pow, Ne.symm h]
        · simp [Ne.symm h]
    rw [Fintype.sum_congr _ _ hterm]
    split_ifs with h
    · rw [Fintype.sum_eq_single ⟨(i, j), h⟩]
      · simp
      · intro m hm; rw [ite_eq_right]; intro h'; exact hm (Subtype.ext h')
    · refine Fintype.sum_eq_zero _ fun m => ?_
      rw [ite_eq_right]; intro h'; exact h (h' ▸ m.2)
  -- The linear constraints: the low-degree coefficients of each translate.
  let L : F[X][X] →ₗ[F] (Fin n × lowMonomials r → F) :=
    LinearMap.pi fun p => coeffShift (α p.1) (y p.1) p.2.1.2.1 p.2.1.2.2
  have hfin : Module.finrank F (Fin n × lowMonomials r → F) < Module.finrank F (M → F) := by
    simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_prod, Fintype.card_fin,
      Fintype.card_coe, card_lowMonomials]
    exact hcount
  obtain ⟨c, hc, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (LinearMap.ker_ne_bot_of_finrank_lt (f := L ∘ₗ e) hfin)
  refine ⟨e c, ?_, ?_, ?_⟩
  · intro h0
    apply hc0
    funext m
    have := hcoeff c m.1.1 m.1.2
    rw [h0, coeff_zero, coeff_zero, dite_eq_left m.2] at this
    exact this.symm
  · intro j i hne
    rw [hcoeff] at hne
    split_ifs at hne with h
    · exact (mem_filter.mp h).2
    · exact absurd rfl hne
  · intro p
    apply hasRootMult_of_coeff
    intro u v' huv
    have hmem : (⟨u + v', (u, v')⟩ : Σ _ : ℕ, ℕ × ℕ) ∈ lowMonomials r := by
      simp [mem_sigma, mem_antidiagonal, huv]
    have := congrFun (LinearMap.mem_ker.mp hc) (p, ⟨_, hmem⟩)
    simpa [L, coeffShift_apply] using this

/-- **Guruswami–Sudan list decoding.** Let `α₁, …, αₙ ∈ F` be distinct, `y ∈ Fⁿ`, and `w, D, r`
natural numbers such that more than `n · r (r + 1) / 2` monomials `X^i Y^j` (with `i, j ≤ D`) have
`i + w j ≤ D`. Then there is one nonzero `Q ∈ F[X][Y]` of `(1, w)`-weighted degree at most `D`,
depending only on `α` and `y`, such that `Y - P(X)` divides `Q` for every `P ∈ F[X]` of degree at
most `w` with `P(αᵢ) = yᵢ` for more than `D / r` indices `i`.

With `w = k - 1` this is the correctness of Algorithm 12.2.3 of Guruswami, Rudra and Sudan,
*Essential Coding Theory* (draft of August 26, 2025): the interpolation step
(`exists_interpolant`) followed by the root-finding lemma (`X_sub_C_dvd_of_agree`, Lemma 12.2.13),
for any parameters `D, r` satisfying the monomial-count hypothesis. Their Theorem 12.2.12 chooses
`D` and `r` so that agreement `√(k n)` suffices, which decodes Reed–Solomon codes up to a
`1 - √R` fraction of errors; that parameter choice and the running time are not formalized.
Source: V. Guruswami, M. Sudan, "Improved
decoding of Reed–Solomon and algebraic-geometry codes", *IEEE Transactions on Information Theory*
45(6) (1999), 1757–1767. -/
theorem exists_interpolant_dvd [DecidableEq F] {n : ℕ} {α : Fin n → F}
    (hα : Function.Injective α) (y : Fin n → F) (w D r : ℕ)
    (hcount : n * (r * (r + 1) / 2) <
      ((range (D + 1) ×ˢ range (D + 1)).filter fun ij : ℕ × ℕ => ij.1 + w * ij.2 ≤ D).card) :
    ∃ Q : F[X][X], Q ≠ 0 ∧ WeightedDegLE w D Q ∧ ∀ P : F[X], P.natDegree ≤ w →
      D < #{i | P.eval (α i) = y i} * r → X - C P ∣ Q := by
  obtain ⟨Q, hQ0, hQ, hmult⟩ := exists_interpolant α y w D r hcount
  exact ⟨Q, hQ0, hQ, fun P hP hagree => X_sub_C_dvd_of_agree hα hQ hmult hP hagree⟩

/-- **The list has at most `D / w` polynomials.** If `Q ∈ F[X][Y]` is nonzero with
`(1, w)`-weighted degree at most `D`, `w ≥ 1`, then at most `D / w` polynomials `P` have
`Y - P(X)` dividing `Q`: they are roots of `Q` in `F[X]`, and `Q` has `Y`-degree at most `D / w`
(Guruswami, Rudra and Sudan, *Essential Coding Theory*, draft of August 26, 2025, Section 12.2,
the list output by Step 3 of Algorithm 12.2.3). -/
theorem card_le_div_of_dvd {w D : ℕ} (hw : 1 ≤ w) {Q : F[X][X]} (hQ0 : Q ≠ 0)
    (hQ : WeightedDegLE w D Q) (Ps : Finset F[X]) (hPs : ∀ P ∈ Ps, X - C P ∣ Q) :
    Ps.card ≤ D / w := by
  classical
  have hroots : Ps ⊆ Q.roots.toFinset := by
    intro P hP
    rw [Multiset.mem_toFinset, mem_roots hQ0]
    exact dvd_iff_isRoot.mp (hPs P hP)
  have hdeg : Q.natDegree ≤ D / w := by
    have hlc : Q.coeff Q.natDegree ≠ 0 := by
      rw [coeff_natDegree]; exact leadingCoeff_ne_zero.mpr hQ0
    have h1 := hQ Q.natDegree _ (by rw [coeff_natDegree]; exact leadingCoeff_ne_zero.mpr hlc)
    rw [Nat.le_div_iff_mul_le (by omega)]
    nlinarith
  calc Ps.card ≤ Q.roots.toFinset.card := card_le_card hroots
    _ ≤ Multiset.card Q.roots := Multiset.toFinset_card_le _
    _ ≤ Q.natDegree := card_roots' Q
    _ ≤ D / w := hdeg

open MathlibExt.Combinatorics.Coding.ListDecoding in
/-- **Reed–Solomon codes are list decodable up to the Johnson radius.** Let `α₁, …, αₙ ∈ F` be
distinct, `1 ≤ k ≤ n`, `y ∈ Fⁿ`, and `t ≤ n` with `t² > n (k - 1)`. Every finite set of
polynomials of degree less than `k`, each agreeing with `y` in at least `t` positions, has at most
`n (n - k + 1)` elements.

This is the Johnson bound (Theorem 7.3.3 of Guruswami, Rudra and Sudan, *Essential Coding
Theory*, draft of August 26, 2025, strict case) applied to the Reed–Solomon codes, which are MDS
with minimum distance `n - k + 1` (their Theorem 5.2.4): Reed–Solomon codes of rate `R = k / n`
are list decodable with polynomial list size from any fraction of errors below `1 - √R`
(agreement `t > √(n (k - 1))`). It is the list-size guarantee behind their Theorem 12.2.12, whose
algorithmic statement is not formalized. -/
theorem card_le_of_agree_ge [DecidableEq F] {n k t : ℕ} {α : Fin n → F}
    (hα : Function.Injective α) (hk : 1 ≤ k) (hkn : k ≤ n) (htn : t ≤ n) (y : Fin n → F)
    (hJ : n * (k - 1) < t ^ 2) (Ps : Finset F[X])
    (hPs : ∀ p ∈ Ps, p.degree < k ∧ t ≤ #{i | p.eval (α i) = y i}) :
    Ps.card ≤ n * (n - k + 1) := by
  classical
  have hinj : Set.InjOn (ReedSolomon.encode α) (Ps : Set F[X]) := by
    intro p hp q hq h
    exact ReedSolomon.injOn_encode hα hkn (mem_degreeLT.mpr (hPs p hp).1)
      (mem_degreeLT.mpr (hPs q hq).1) h
  rw [← card_image_of_injOn hinj]
  refine card_le_mul_of_johnson (Ps.image (ReedSolomon.encode α)) y (e := n - t)
    (Nat.sub_le n t) (by omega) ?_ ?_ ?_
  · simp only [mem_image]
    rintro _ ⟨p, hp, rfl⟩ _ ⟨q, hq, rfl⟩ hne
    have hpq : p - q ≠ 0 := by
      intro h; rw [sub_eq_zero] at h; exact hne (by rw [h])
    have hdeg : (p - q).degree < k :=
      (degree_sub_le p q).trans_lt (max_lt (hPs p hp).1 (hPs q hq).1)
    rw [hammingDist_eq_hammingNorm_sub, ← ReedSolomon.encode_sub]
    exact ReedSolomon.le_hammingNorm_encode hα hkn hpq hdeg
  · simp only [mem_image]
    rintro _ ⟨p, hp, rfl⟩
    have h1 := card_filter_eq (ReedSolomon.encode α p) y
    have h2 := (hPs p hp).2
    have h3 : #{i | ReedSolomon.encode α p i = y i} = #{i | p.eval (α i) = y i} := rfl
    rw [hammingDist_comm]
    have := hammingDist_le_card_fintype (x := ReedSolomon.encode α p) (y := y)
    rw [Fintype.card_fin] at this
    omega
  · have : n - (n - k + 1) = k - 1 := by omega
    rw [this, Nat.sub_sub_self htn]
    exact hJ

end Cslib.CodingTheory.GuruswamiSudan
