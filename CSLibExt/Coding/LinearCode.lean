@[expose] public section

/-!
# Linear codes, generator and parity-check matrices, and syndrome decoding

A **linear code** of length `ι` over a field `F` is a subspace `C ≤ ι → F`. It is presented by a
**generator matrix** `G : Matrix κ ι F`, whose encoder sends a message `m : κ → F` to the codeword
`m ᵥ* G`, or by a **parity-check matrix** `H : Matrix ρ ι F`, whose codewords are the words of
zero **syndrome** `H *ᵥ c`.

* `ofGenerator_eq_ofParityCheck_iff`: `G` and `H` present the same code iff `G Hᵀ = 0` and
  `rank G + rank H = |ι|`. `systematic_eq` instantiates it with the systematic pair
  `G = [I | A]`, `H = [-Aᵀ | I]`, whose encoder copies the message into the first coordinates.
* `dual`: the dual code `C⊥ = {x | x ⬝ᵥ c = 0 for all c ∈ C}`, with `dim C + dim C⊥ = |ι|`,
  `C⊥⊥ = C`, and `(code of G)⊥ = (code with parity check G)`.
* `minDist` (as in upstream CSLib's draft coding-theory API, an infimum in `ℕ∞` over distinct
  pairs) equals the minimum weight `minWeight` (`minDist_eq_minWeight`). It is the same infimum
  as that draft's `Code.minDist` of the underlying set, which it will become once that API lands.
* `syndromeDecode H table y = y - table (H *ᵥ y)`: table-lookup syndrome decoding. If the table
  returns an error pattern of weight at most `t` with the right syndrome for every error of
  weight at most `t` (`IsSyndromeTable`), and `2t < d(C)`, then the decoder corrects every error of
  weight at most `t` (`syndromeDecode_add_of_hammingNorm_le`); for `t = ⌊(d - 1)/2⌋` this is
  `syndromeDecode_add_of_minDist_eq`. Such tables exist (`exists_isSyndromeTable`), and
  `searchTable` builds one by exhaustive search when the alphabet is enumerable.
* The Singleton bound `d ≤ n - dim C + 1` for nonzero codes and the Hamming bound for linear
  codes, obtained from MathlibExt's bounds for arbitrary codes (`finrank_add_le_of_le_minDist`,
  `minDist_le_of_ne_bot`, `pow_finrank_mul_sum_le_of_lt_minDist`).

## References

* F. J. MacWilliams, N. J. A. Sloane, *The Theory of Error-Correcting Codes*, North-Holland,
  1977, Ch. 1 (linear codes, generator and parity-check matrices, dual codes, syndrome decoding).
* R. M. Roth, *Introduction to Coding Theory*, Cambridge University Press, 2006, Ch. 2 (linear
  codes) and Ch. 4 (the Singleton and sphere-packing bounds).
-/

namespace Cslib.CodingTheory

open Matrix Module

/-- **Linear code.** Let $F$ be a field and $\iota$ an index set, not necessarily finite.
A linear code over $F$ with coordinates indexed by $\iota$ is an $F$-linear subspace of the
space of words, the functions $\iota \to F$. -/
abbrev LinearCode (F : Type*) [Field F] (ι : Type*) := Submodule F (ι → F)

variable {F : Type*} [Field F] {ι κ ρ : Type*}

namespace LinearCode

/-! ### Generator and parity-check matrices -/

section Presentations

variable [Fintype κ]

/-- **Encoder of a generator matrix.** Let $G$ be a $\kappa \times \iota$ matrix over a field $F$,
with $\kappa$ finite. The encoder of $G$ sends a message $m \in F^\kappa$ to the word
$mG \in F^\iota$ given by $(mG)_j = \sum_{k \in \kappa} m_k G_{kj}$, the combination of the rows
of $G$ with coefficients $m$. -/
def encode (G : Matrix κ ι F) (m : κ → F) : ι → F := m ᵥ* G

/-- **Code generated by a matrix.** Let $F$ be a field, $\kappa$ a finite index set, $\iota$ any
index set and $G$ a $\kappa \times \iota$ matrix over $F$. The code generated by $G$ is the linear
code of all words $m G$ with $m : \kappa \to F$, the image of the encoder $m \mapsto m G$;
equivalently, the span of the rows of $G$. -/
def ofGenerator (G : Matrix κ ι F) : LinearCode F ι := LinearMap.range G.vecMulLinear

theorem mem_ofGenerator {G : Matrix κ ι F} {c : ι → F} :
    c ∈ ofGenerator G ↔ ∃ m, encode G m = c := Iff.rfl

theorem encode_mem_ofGenerator (G : Matrix κ ι F) (m : κ → F) : encode G m ∈ ofGenerator G :=
  ⟨m, rfl⟩

end Presentations

section Syndrome

variable [Fintype ι]

/-- **Syndrome.** Let $F$ be a field, $\iota$ a finite set and $\rho$ a set. For a matrix
$H \in F^{\rho \times \iota}$ (a parity-check matrix) and a word $y \in F^\iota$, the syndrome of
$y$ is the vector $Hy \in F^\rho$. -/
def syndrome (H : Matrix ρ ι F) (y : ι → F) : ρ → F := H *ᵥ y

/-- **Code with a given parity-check matrix.** Let $F$ be a field, $\iota$ a finite index set,
$\rho$ any index set and $H$ a $\rho \times \iota$ matrix over $F$. The code with parity-check
matrix $H$ is the linear code of all words $c : \iota \to F$ whose syndrome $H c$ is zero, that
is, the kernel of $c \mapsto H c$. -/
def ofParityCheck (H : Matrix ρ ι F) : LinearCode F ι := LinearMap.ker H.mulVecLin

theorem mem_ofParityCheck {H : Matrix ρ ι F} {c : ι → F} :
    c ∈ ofParityCheck H ↔ syndrome H c = 0 := Iff.rfl

theorem syndrome_add (H : Matrix ρ ι F) (x y : ι → F) :
    syndrome H (x + y) = syndrome H x + syndrome H y := mulVec_add H x y

theorem syndrome_sub (H : Matrix ρ ι F) (x y : ι → F) :
    syndrome H (x - y) = syndrome H x - syndrome H y := mulVec_sub H x y

/-- **The syndrome depends only on the error.** Let $F$ be a field, $\iota$ a finite set and
$H$ a parity-check matrix over $F$ with columns indexed by $\iota$. If $c \in F^\iota$ is a
codeword of the code with parity-check matrix $H$ and $e \in F^\iota$ is any word, then the
received word $c + e$ has the same syndrome as $e$, that is, $H(c + e) = He$. -/
theorem syndrome_add_of_mem {H : Matrix ρ ι F} {c : ι → F} (hc : c ∈ ofParityCheck H)
    (e : ι → F) : syndrome H (c + e) = syndrome H e := by
  rw [syndrome_add, mem_ofParityCheck.mp hc, zero_add]

end Syndrome

section Duality

variable [Fintype ι] [Fintype κ] [DecidableEq κ]

omit [DecidableEq κ] in
theorem ofGenerator_le_ofParityCheck_iff {G : Matrix κ ι F} {H : Matrix ρ ι F} :
    ofGenerator G ≤ ofParityCheck H ↔ G * Hᵀ = 0 := by
  classical
  constructor
  · intro h
    ext i j
    have := mem_ofParityCheck.mp (h (encode_mem_ofGenerator G (Pi.single i 1)))
    have hj := congrFun this j
    simp only [syndrome, encode, single_one_vecMul, Pi.zero_apply] at hj
    simpa [mul_apply, mulVec, dotProduct, mul_comm] using hj
  · intro h c hc
    obtain ⟨m, rfl⟩ := mem_ofGenerator.mp hc
    rw [mem_ofParityCheck, syndrome, encode, ← vecMul_transpose, vecMul_vecMul, h, vecMul_zero]

omit [DecidableEq κ] in
theorem finrank_ofGenerator (G : Matrix κ ι F) : finrank F (ofGenerator G) = G.rank := by
  have h : G.vecMulLinear = Gᵀ.mulVecLin := LinearMap.ext fun x ↦ (mulVec_transpose G x).symm
  rw [← rank_transpose, ofGenerator, h, Matrix.rank]

omit [Fintype κ] [DecidableEq κ] in
theorem finrank_ofParityCheck (H : Matrix ρ ι F) :
    finrank F (ofParityCheck H) = Fintype.card ι - H.rank := by
  have := LinearMap.finrank_range_add_finrank_ker H.mulVecLin
  rw [Module.finrank_fintype_fun_eq_card] at this
  unfold ofParityCheck
  unfold Matrix.rank
  omega

omit [DecidableEq κ] in
/-- **Generator/parity-check duality.** Let $F$ be a field, $\kappa$ and $\iota$ finite index
sets and $\rho$ any index set, and let $G$ be a $\kappa \times \iota$ matrix and $H$ a
$\rho \times \iota$ matrix over $F$. The code generated by $G$ equals the code with parity-check
matrix $H$ if and only if $G H^{\mathsf{T}} = 0$ and $\operatorname{rank} G + \operatorname{rank} H$
equals $|\iota|$, the length of the code. -/
theorem ofGenerator_eq_ofParityCheck_iff {G : Matrix κ ι F}
    {H : Matrix ρ ι F} :
    ofGenerator G = ofParityCheck H ↔ G * Hᵀ = 0 ∧ G.rank + H.rank = Fintype.card ι := by
  have hle := H.rank_le_card_width
  constructor
  · intro h
    refine ⟨ofGenerator_le_ofParityCheck_iff.mp h.le, ?_⟩
    have := congrArg (fun C : LinearCode F ι ↦ finrank F C) h
    simp only [finrank_ofGenerator, finrank_ofParityCheck] at this
    omega
  · rintro ⟨h0, hr⟩
    refine Submodule.eq_of_le_of_finrank_eq (ofGenerator_le_ofParityCheck_iff.mpr h0) ?_
    rw [finrank_ofGenerator, finrank_ofParityCheck]
    omega

/-! ### Systematic form -/

omit [Fintype ι] in
/-- **The systematic encoder copies the message.** Let $F$ be a field, $\kappa$ a finite set and
$A$ a $\kappa \times \rho$ matrix over $F$. For the systematic generator matrix $G = [I \mid A]$,
whose columns are indexed by the disjoint union $\kappa \sqcup \rho$, the encoding $mG$ of every
message $m \in F^\kappa$ agrees with $m$ on the coordinates in $\kappa$: $(mG)_i = m_i$ for every
$i \in \kappa$. -/
theorem encode_fromCols_one_inl (A : Matrix κ ρ F) (m : κ → F) (i : κ) :
    encode (fromCols 1 A) m (Sum.inl i) = m i := by
  simp [encode, vecMul, dotProduct, fromCols, one_apply]

omit [Fintype ι] in
theorem _root_.Cslib.CodingTheory.rank_fromCols_one [Fintype ρ] (A : Matrix κ ρ F) :
    (fromCols (1 : Matrix κ κ F) A).rank =
    Fintype.card κ := by
  rw [← finrank_ofGenerator]
  have hinj : Function.Injective (fromCols (1 : Matrix κ κ F) A).vecMulLinear := by
    intro m m' h
    funext i
    have := congrFun h (Sum.inl i)
    exact (encode_fromCols_one_inl A m i).symm.trans (this.trans (encode_fromCols_one_inl A m' i))
  rw [ofGenerator, LinearMap.finrank_range_of_inj hinj, Module.finrank_fintype_fun_eq_card]

omit [Fintype ι] [DecidableEq κ] in
theorem _root_.Cslib.CodingTheory.rank_fromCols_neg_transpose_one [Fintype ρ] [DecidableEq ρ]
    (A : Matrix κ ρ F) :
    (fromCols (-Aᵀ) (1 : Matrix ρ ρ F)).rank = Fintype.card ρ := by
  have h := rank_fromCols_one (κ := ρ) (ρ := κ) (-Aᵀ)
  have he : (fromCols (-Aᵀ) (1 : Matrix ρ ρ F)) =
      (fromCols (1 : Matrix ρ ρ F) (-Aᵀ)).submatrix (Equiv.refl ρ) (Equiv.sumComm κ ρ) := by
    ext i (j | j) <;> rfl
  rw [he, rank_submatrix _ (Equiv.refl ρ) (Equiv.sumComm κ ρ), h]

omit [Fintype ι] in
/-- **Systematic generator and parity-check matrices.** Let $F$ be a field, $\kappa$ and $\rho$
finite sets, and $A$ a $\kappa \times \rho$ matrix over $F$. Then the code generated by
$G = [I_\kappa \mid A]$ equals the code with parity-check matrix
$H = [-A^{\mathsf{T}} \mid I_\rho]$, both being codes whose coordinates are indexed by the
disjoint union of $\kappa$ and $\rho$. -/
theorem systematic_eq [Fintype ρ] [DecidableEq ρ] (A : Matrix κ ρ F) :
    ofGenerator (fromCols (1 : Matrix κ κ F) A) =
      ofParityCheck (fromCols (-Aᵀ) (1 : Matrix ρ ρ F)) := by
  rw [ofGenerator_eq_ofParityCheck_iff, rank_fromCols_one, rank_fromCols_neg_transpose_one,
    Fintype.card_sum]
  refine ⟨?_, rfl⟩
  rw [transpose_fromCols, fromCols_mul_fromRows]
  simp

end Duality

/-! ### The dual code -/

section Dual

variable [Fintype ι]

/-- **Dot product bilinear form.** Let $F$ be a field and $\iota$ a finite set. The dot product
form is the bilinear form on $F^\iota$ that sends a pair of words $(x, y)$ to
$x \cdot y = \sum_{i \in \iota} x_i y_i$. -/
abbrev _root_.Cslib.CodingTheory.dotForm : LinearMap.BilinForm F (ι → F) := dotProductBilin F F

theorem _root_.Cslib.CodingTheory.dotForm_apply (x y : ι → F) : dotForm x y = x ⬝ᵥ y := rfl

theorem _root_.Cslib.CodingTheory.dotForm_nondegenerate :
    (dotForm : LinearMap.BilinForm F (ι → F)).Nondegenerate := by
  classical
  have h : Matrix.toBilin' (1 : Matrix ι ι F) = dotForm :=
    LinearMap.ext₂ fun x y ↦ by simp [Matrix.toBilin'_apply']
  rw [← h]
  exact LinearMap.BilinForm.nondegenerate_toBilin'_iff_det_ne_zero.mpr (by simp)

theorem _root_.Cslib.CodingTheory.dotForm_isRefl :
    (dotForm : LinearMap.BilinForm F (ι → F)).IsRefl := fun x y h ↦ by
  rw [dotForm_apply] at h ⊢
  rwa [dotProduct_comm]

/-- **Dual code.** Let $F$ be a field and $\iota$ a finite set. The dual $C^\perp$ of a linear code
$C \subseteq F^\iota$ is the linear code of all words $x \in F^\iota$ with
$x \cdot c = \sum_{i \in \iota} x_i c_i = 0$ for every codeword $c \in C$. -/
noncomputable def dual (C : LinearCode F ι) : LinearCode F ι := dotForm.orthogonal C

theorem mem_dual {C : LinearCode F ι} {x : ι → F} : x ∈ dual C ↔ ∀ c ∈ C, x ⬝ᵥ c = 0 := by
  simp only [dual, LinearMap.BilinForm.mem_orthogonal_iff, dotForm_apply, dotProduct_comm x]

/-- **Dimension of the dual code.** Let $F$ be a field and $\iota$ a finite set. For every linear
code $C \subseteq F^\iota$, $\dim C + \dim C^\perp = |\iota|$, where $C^\perp$ is the dual code. -/
theorem finrank_add_finrank_dual (C : LinearCode F ι) :
    finrank F C + finrank F (dual C) = Fintype.card ι := by
  have h := LinearMap.BilinForm.finrank_orthogonal dotForm_nondegenerate C
  have hle := Submodule.finrank_le C
  rw [Module.finrank_fintype_fun_eq_card] at h hle
  rw [dual, h]
  omega

theorem dual_dual (C : LinearCode F ι) : dual (dual C) = C :=
  LinearMap.BilinForm.orthogonal_orthogonal dotForm_nondegenerate dotForm_isRefl C

/-- **Dual of the code generated by a matrix.** Let $G$ be a matrix over a field $F$ with finitely
many rows and finitely many columns. Then the dual of the code generated by $G$ (the span of its
rows) is the code with parity-check matrix $G$ (the words $x$ with $Gx = 0$). -/
theorem dual_ofGenerator [Fintype κ] (G : Matrix κ ι F) :
    dual (ofGenerator G) = ofParityCheck G := by
  classical
  ext x
  rw [mem_dual, mem_ofParityCheck]
  constructor
  · intro h
    funext i
    have := h _ (encode_mem_ofGenerator G (Pi.single i 1))
    rwa [encode, dotProduct_comm, ← dotProduct_mulVec, single_one_dotProduct] at this
  · intro h c hc
    obtain ⟨m, rfl⟩ := mem_ofGenerator.mp hc
    rw [encode, dotProduct_comm, ← dotProduct_mulVec]
    change m ⬝ᵥ syndrome G x = 0
    rw [h, dotProduct_zero]

/-- **Dual of the code with a given parity-check matrix.** Let $H$ be a matrix over a field $F$ with
finitely many rows and finitely many columns. Then the dual of the code with parity-check matrix
$H$ (the words $x$ with $Hx = 0$) is the code generated by $H$ (the span of its rows). -/
theorem dual_ofParityCheck [Fintype ρ] (H : Matrix ρ ι F) :
    dual (ofParityCheck H) = ofGenerator H := by
  rw [← dual_ofGenerator, dual_dual]

end Dual

/-! ### Minimum distance and minimum weight -/

section Distance

variable [Fintype ι] [DecidableEq F]

/-- **Minimum distance.** The minimum distance of a linear code $C$ of finite length is the least
Hamming distance (number of coordinates where they differ) between two distinct codewords of
$C$, taken in $\mathbb{N} \cup \{\infty\}$; it is $\infty$ if $C$ has at most one codeword. -/
noncomputable def minDist (C : LinearCode F ι) : ℕ∞ :=
  ⨅ (c₁ ∈ C) (c₂ ∈ C) (_ : c₁ ≠ c₂), (hammingDist c₁ c₂ : ℕ∞)

/-- **Minimum weight.** The minimum weight of a linear code $C$ of finite length is the least
weight of a nonzero codeword of $C$, where the weight of a word is its number of nonzero
coordinates; it is taken in $\mathbb{N} \cup \{\infty\}$ and is $\infty$ if $C$ has no nonzero
codeword. -/
noncomputable def minWeight (C : LinearCode F ι) : ℕ∞ :=
  ⨅ (c ∈ C) (_ : c ≠ 0), (hammingNorm c : ℕ∞)

/-- **Hamming distance is the weight of the difference.** Let $F$ be a field and $\iota$ a finite
set. For all words $x, y \in F^\iota$, the Hamming distance between $x$ and $y$ (the number of
coordinates where they differ) equals the Hamming weight of $x - y$ (its number of nonzero
coordinates). -/
theorem _root_.Cslib.CodingTheory.hammingDist_eq_hammingNorm_sub (x y : ι → F) :
    hammingDist x y = hammingNorm (x - y) := by
  simp_rw [hammingNorm, hammingDist, Pi.sub_apply, ne_eq, sub_eq_zero]

theorem le_minDist_iff {C : LinearCode F ι} {d : ℕ∞} :
    d ≤ C.minDist ↔ ∀ c₁ ∈ C, ∀ c₂ ∈ C, c₁ ≠ c₂ → d ≤ hammingDist c₁ c₂ := by
  simp only [minDist, le_iInf_iff]

theorem minDist_le {C : LinearCode F ι} {c₁ c₂ : ι → F} (h₁ : c₁ ∈ C) (h₂ : c₂ ∈ C)
    (hne : c₁ ≠ c₂) : C.minDist ≤ hammingDist c₁ c₂ :=
  (iInf₂_le c₁ h₁).trans ((iInf₂_le c₂ h₂).trans (iInf_le _ hne))

theorem le_minWeight_iff {C : LinearCode F ι} {d : ℕ∞} :
    d ≤ C.minWeight ↔ ∀ c ∈ C, c ≠ 0 → d ≤ hammingNorm c := by
  simp only [minWeight, le_iInf_iff]

theorem minWeight_le {C : LinearCode F ι} {c : ι → F} (hc : c ∈ C) (hne : c ≠ 0) :
    C.minWeight ≤ hammingNorm c :=
  (iInf₂_le c hc).trans (iInf_le _ hne)

/-- **Minimum distance equals minimum weight.** For a linear code of finite length over a
field, the minimum distance equals the minimum weight. -/
theorem minDist_eq_minWeight (C : LinearCode F ι) : C.minDist = C.minWeight := by
  apply le_antisymm
  · rw [le_minWeight_iff]
    intro c hc hne
    simpa only [hammingDist_zero_right] using minDist_le hc C.zero_mem hne
  · rw [le_minDist_iff]
    intro c₁ h₁ c₂ h₂ hne
    rw [hammingDist_eq_hammingNorm_sub]
    exact minWeight_le (C.sub_mem h₁ h₂) (sub_ne_zero.mpr hne)

theorem one_le_minDist (C : LinearCode F ι) : 1 ≤ C.minDist := by
  rw [le_minDist_iff]
  intro c₁ _ c₂ _ hne
  exact_mod_cast hammingDist_pos.mpr hne

theorem _root_.Cslib.CodingTheory.hammingNorm_sub_le (x y : ι → F) :
    hammingNorm (x - y) ≤ hammingNorm x + hammingNorm y := by
  rw [← hammingDist_eq_hammingNorm_sub, ← hammingDist_zero_right, ← hammingDist_zero_left]
  exact hammingDist_triangle x 0 y

end Distance

/-! ### Syndrome decoding -/

section Decoding

variable [Fintype ι] [DecidableEq F]

/-- **Syndrome decoding** with a lookup `table` from syndromes to error patterns: subtract the
error pattern the table assigns to the syndrome of the received word. -/
def syndromeDecode (H : Matrix ρ ι F) (table : (ρ → F) → ι → F) (y : ι → F) : ι → F :=
  y - table (syndrome H y)

/-- **Syndrome table correct up to a radius.** Let $H$ be a $\rho \times \iota$ matrix over a field
$F$, with $\iota$ finite, and let $t$ be a natural number. A syndrome table for $H$, that is, a map
$T$ from syndromes $s \in F^\rho$ to error patterns $T(s) \in F^\iota$, is correct up to radius
$t$ when, for every word $e \in F^\iota$ of Hamming weight at most $t$, the word $T(He)$ has the
same syndrome as $e$, that is $H \, T(He) = He$, and has Hamming weight at most $t$.

This is weaker than asking for minimum-weight coset leaders, and equivalent to it inside the
radius when $2t < d$, where $d$ is the minimum distance of the code with parity-check matrix $H$
(each coset then holds at most one word of weight at most $t$). Outside the radius the table is
unconstrained, so for heavier errors the decoder's output need not even be a codeword. -/
def IsSyndromeTable (H : Matrix ρ ι F) (t : ℕ) (table : (ρ → F) → ι → F) : Prop :=
  ∀ e : ι → F, hammingNorm e ≤ t →
    syndrome H (table (syndrome H e)) = syndrome H e ∧ hammingNorm (table (syndrome H e)) ≤ t

/-- **Syndrome decoding corrects every error of weight at most $t$.** Let $H$ be a parity-check
matrix over a field $F$, let $C$ be the code with parity-check matrix $H$, let
$d \in \mathbb{N} \cup \{\infty\}$ be its minimum distance, and let $t \in \mathbb{N}$ with
$2t < d$. If a syndrome table is correct up to radius $t$ for $H$, then for every codeword
$c \in C$ and every word $e$ of Hamming weight at most $t$, syndrome decoding with this table
sends the received word $c + e$ to $c$.

The error pattern the table returns differs from the true error by a codeword of weight at most
$2t$, which must be zero. -/
theorem syndromeDecode_add_of_hammingNorm_le {H : Matrix ρ ι F} {t : ℕ} {table : (ρ → F) → ι → F}
    (hT : IsSyndromeTable H t table) (ht : (2 * t : ℕ∞) < (ofParityCheck H).minDist)
    {c e : ι → F} (hc : c ∈ ofParityCheck H) (he : hammingNorm e ≤ t) :
    syndromeDecode H table (c + e) = c := by
  obtain ⟨hs, hw⟩ := hT e he
  have hmem : e - table (syndrome H e) ∈ ofParityCheck H := by
    rw [mem_ofParityCheck, syndrome_sub, hs, sub_self]
  have hzero : e - table (syndrome H e) = 0 := by
    by_contra hne
    have h1 := minWeight_le hmem hne
    rw [← minDist_eq_minWeight] at h1
    have h2 : hammingNorm (e - table (syndrome H e)) ≤ 2 * t :=
      (hammingNorm_sub_le _ _).trans (by omega)
    have h3 : (hammingNorm (e - table (syndrome H e)) : ℕ∞) ≤ 2 * t := by exact_mod_cast h2
    exact lt_irrefl _ (ht.trans_le (h1.trans h3))
  rw [syndromeDecode, syndrome_add_of_mem hc, add_sub_assoc, hzero, add_zero]

/-- **Syndrome decoding up to half the minimum distance.** Let $H$ be a parity-check matrix over
a field $F$ such that the code $C$ with parity-check matrix $H$ has finite minimum distance $d$,
and let $t = \lfloor (d - 1)/2 \rfloor$. If a syndrome table is correct up to radius $t$ for
$H$, then for every codeword $c \in C$ and every word $e$ of Hamming weight at most $t$,
syndrome decoding with this table sends the received word $c + e$ to $c$. -/
theorem syndromeDecode_add_of_minDist_eq {H : Matrix ρ ι F} {d : ℕ}
    (hd : (ofParityCheck H).minDist = d) {table : (ρ → F) → ι → F}
    (hT : IsSyndromeTable H ((d - 1) / 2) table) {c e : ι → F} (hc : c ∈ ofParityCheck H)
    (he : hammingNorm e ≤ (d - 1) / 2) : syndromeDecode H table (c + e) = c := by
  have h1 : 1 ≤ d := by exact_mod_cast hd ▸ one_le_minDist (ofParityCheck H)
  refine syndromeDecode_add_of_hammingNorm_le hT ?_ hc he
  rw [hd]
  exact_mod_cast (by omega : 2 * ((d - 1) / 2) < d)

/-- **Existence of correct syndrome tables.** Let $H$ be a matrix over a field $F$ whose columns
are indexed by a finite set. For every natural number $t$ there is a syndrome table for $H$ that
is correct up to radius $t$. -/
theorem exists_isSyndromeTable (H : Matrix ρ ι F) (t : ℕ) : ∃ table, IsSyndromeTable H t table := by
  classical
  refine ⟨fun s ↦ if h : ∃ e, hammingNorm e ≤ t ∧ syndrome H e = s then h.choose else 0, ?_⟩
  intro e he
  have h : ∃ e', hammingNorm e' ≤ t ∧ syndrome H e' = syndrome H e := ⟨e, he, rfl⟩
  simp only [h, ↓reduceDIte]
  exact ⟨h.choose_spec.2, h.choose_spec.1⟩

/-- **Syndrome table by exhaustive search.** Let $F$ be a field, $\iota$ and $\rho$ finite sets,
$H$ a $\rho \times \iota$ parity-check matrix over $F$, and $t \in \mathbb{N}$, where the words
$F^\iota$ come with a fixed enumeration. The search table sends a syndrome $s \in F^\rho$ to the
first word $e \in F^\iota$ in the enumeration with Hamming weight at most $t$ and syndrome
$He = s$, and to $0$ if there is no such word. -/
def searchTable [FinEnum (ι → F)] [Fintype ρ] (H : Matrix ρ ι F) (t : ℕ) (s : ρ → F) : ι → F :=
  ((FinEnum.toList (ι → F)).find? fun e ↦ decide (hammingNorm e ≤ t ∧ syndrome H e = s)).getD 0

theorem isSyndromeTable_searchTable [FinEnum (ι → F)] [Fintype ρ] (H : Matrix ρ ι F) (t : ℕ) :
    IsSyndromeTable H t (searchTable H t) := by
  intro e he
  have hsome : ((FinEnum.toList (ι → F)).find? fun e' ↦
      decide (hammingNorm e' ≤ t ∧ syndrome H e' = syndrome H e)).isSome :=
    List.find?_isSome.mpr ⟨e, FinEnum.mem_toList e, by simp [he]⟩
  obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hsome
  have hpx := List.find?_some hx
  simp only [decide_eq_true_eq] at hpx
  have hval : searchTable H t (syndrome H e) = x := by
    simp only [searchTable, hx, Option.getD_some]
  rw [hval]
  exact ⟨hpx.2, hpx.1⟩

end Decoding

/-! ### The Singleton and Hamming bounds for linear codes -/

section Bounds

variable {n : ℕ} [Fintype F] [DecidableEq F]

omit [DecidableEq F] in
/-- **Number of codewords of a linear code.** If $C$ is a linear code of length $n$ over a finite
field $F$, then exactly $|F|^{\dim C}$ of the $|F|^n$ words of length $n$ lie in $C$, where
$\dim C$ is the dimension of $C$ over $F$. -/
theorem card_filter_mem (C : LinearCode F (Fin n)) [DecidablePred (· ∈ C)] :
    (Finset.univ.filter (· ∈ C)).card = Fintype.card F ^ finrank F C := by
  rw [← Module.card_eq_pow_finrank (K := F) (V := C), Fintype.card_subtype]

omit [Fintype F] in
/-- **Singleton bound for linear codes, dimension form.** Let $C$ be a linear code of length $n$
over a finite field $F$, and let $d \le n$ be a natural number that is at most the minimum
distance of $C$. Then $\dim C + d \le n + 1$.

The hypothesis $d \le n$ matters only for the zero code, whose minimum distance is $\infty$. -/
theorem finrank_add_le_of_le_minDist [Finite F] {C : LinearCode F (Fin n)} {d : ℕ}
    (hdn : d ≤ n) (hd : (d : ℕ∞) ≤ C.minDist) : finrank F C + d ≤ n + 1 := by
  classical
  have := Fintype.ofFinite F
  rcases Nat.eq_zero_or_pos d with rfl | hd1
  · have := Submodule.finrank_le C
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at this
    omega
  have hS := MathlibExt.Combinatorics.Coding.SingletonBound.singleton_bound
    (Finset.univ.filter (· ∈ C)) hd1 hdn (fun c₁ h₁ c₂ h₂ hne ↦ by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at h₁ h₂
      exact_mod_cast (le_minDist_iff.mp hd) c₁ h₁ c₂ h₂ hne)
  rw [card_filter_mem] at hS
  have := (Nat.pow_le_pow_iff_right Fintype.one_lt_card).mp hS
  omega

omit [Fintype F] in
/-- **Minimum distance is at most the length.** If $C$ is a linear code of length $n$ over a
field and $C$ is not the zero subspace, then the minimum distance of $C$ is finite and at most
$n$. -/
theorem minDist_le_length {C : LinearCode F (Fin n)} (hC : C ≠ ⊥) : C.minDist ≤ n := by
  obtain ⟨c, hc, hne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hC
  calc C.minDist ≤ hammingDist c 0 := minDist_le hc C.zero_mem hne
    _ ≤ n := by exact_mod_cast (hammingDist_le_card_fintype.trans (Fintype.card_fin n).le)

omit [Fintype F] in
/-- **Singleton bound for linear codes.** Let $F$ be a finite field and $C$ a linear code of
length $n$ and dimension $k$ over $F$ that is not the zero subspace. Then the minimum distance
of $C$ is at most $n - k + 1$. -/
theorem minDist_le_of_ne_bot [Finite F] {C : LinearCode F (Fin n)} (hC : C ≠ ⊥) :
    C.minDist ≤ (n - finrank F C + 1 : ℕ) := by
  have hle := minDist_le_length hC
  obtain ⟨d, hd⟩ : ∃ d : ℕ, C.minDist = d :=
    ⟨C.minDist.toNat, (ENat.natCast_toNat (ne_top_of_le_ne_top (ENat.natCast_ne_top n) hle)).symm⟩
  rw [hd] at hle ⊢
  have hdn : d ≤ n := by exact_mod_cast hle
  have := finrank_add_le_of_le_minDist hdn hd.ge
  exact_mod_cast (by omega : d ≤ n - finrank F C + 1)

/-- **Hamming bound for linear codes.** Let $F$ be a finite field with $q$ elements and $C$ a
linear code of length $n$ and dimension $k$ over $F$. If $t$ is a natural number such that $2t$ is
less than the minimum distance of $C$, then
$$q^k \sum_{i=0}^{t} \binom{n}{i} (q-1)^i \le q^n.$$ -/
theorem pow_finrank_mul_sum_le_of_lt_minDist {C : LinearCode F (Fin n)} {t : ℕ}
    (ht : (2 * t : ℕ∞) < C.minDist) :
    Fintype.card F ^ finrank F C *
        ∑ i ∈ Finset.range (t + 1), n.choose i * (Fintype.card F - 1) ^ i ≤
      Fintype.card F ^ n := by
  classical
  have hH := MathlibExt.Combinatorics.Coding.HammingSpherePacking.hamming_sphere_packing_bound
    (Finset.univ.filter (· ∈ C)) Fintype.one_lt_card (t := t) (fun c₁ h₁ c₂ h₂ hne ↦ by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at h₁ h₂
      have := ht.trans_le (minDist_le h₁ h₂ hne)
      have : 2 * t < hammingDist c₁ c₂ := by exact_mod_cast this
      omega)
  rwa [card_filter_mem] at hH

end Bounds

end LinearCode

end Cslib.CodingTheory
