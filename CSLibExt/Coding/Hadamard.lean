@[expose] public section

/-!
# The binary Hadamard code

The **Hadamard code** of order `m` sends a message `a ∈ 𝔽₂^m` to the truth table of the linear
functional `r ↦ a ⬝ᵥ r`, with one position for each of the `2^m` vectors `r ∈ 𝔽₂^m`. It is the
code generated by `generator m`, the `m × 2^m` matrix whose columns run over all of `𝔽₂^m`: the
encoder is `LinearCode.encode (generator m)` and the code is `LinearCode.ofGenerator (generator m)`.

For `m ≥ 1` this is the `[2^m, m, 2^(m-1)]` code of Guruswami, Rudra and Sudan. For `m = 0` it is
the zero code of length `1`: it has dimension `0` and, by the convention of `LinearCode.minDist`
for codes with fewer than two codewords, minimum distance `⊤` rather than `2 ^ (0 - 1) = 1`
(`minDist_code_zero`). The same name is also used for the *augmented* code of the affine functionals
`r ↦ a ⬝ᵥ r + b`, for `m ≥ 1` a `[2^m, m + 1, 2^(m-1)]` code (the first-order Reed-Muller code),
which also contains the all-ones word. The constant term `b` is omitted on purpose: without it
every nonzero codeword has the same weight `2^(m-1)`.

* `card_positions`: the length is `2^m`.
* `encode_apply`: the codeword of `a` at position `r` is `a ⬝ᵥ r`.
* `encode_injective`, `finrank_code`: the encoder is injective, so the code has dimension `m`.
* `hammingNorm_encode` (**constant weight**): every nonzero codeword has weight exactly `2^(m-1)`
  (`hammingNorm_of_mem_code` states it for the members of `code m`), so distinct codewords are at
  distance exactly `2^(m-1)` (`hammingDist_encode`).
* `minDist_code`, `minWeight_code`: for `m ≥ 1` the minimum distance and the minimum weight are
  `2^(m-1)`; `minDist_code_zero` is the case `m = 0`.

The names of the first version of this development (`dot`, `hadCode`, `hadWeight`,
`hammingNorm_hadCode`, `hadDist`, `hadCode_injective`) remain at the end of the file as deprecated
corollaries with their original statements.

## References

* V. Guruswami, A. Rudra, M. Sudan, *Essential Coding Theory* (draft), Section 2.6:
  Definition 2.6.2 (the Hadamard code for positive `r`, generated by the matrix whose columns are
  all of `𝔽₂^r`) and Proposition 2.6.3 (every nonzero codeword has weight `2^(r-1)`, by pairing
  the positions `u` and `u + eᵢ`; `hammingNorm_encode` follows this proof).
* F. J. MacWilliams, N. J. A. Sloane, *The Theory of Error-Correcting Codes*, North-Holland,
  1977, Ch. 14 (first-order Reed-Muller codes, the augmented code).
-/

namespace Cslib.CodingTheory.Hadamard

/-- The generator matrix of the Hadamard code of order `m`: its column at position `r ∈ 𝔽₂^m` is
`r` itself, so its columns are all the vectors of `𝔽₂^m`. -/
def generator (m : ℕ) : Matrix (Fin m) (Fin m → ZMod 2) (ZMod 2) := fun i r ↦ r i

variable {m : ℕ}

/-- The **Hadamard encoder**: the message `a` is sent to the truth table of the linear functional
`r ↦ a ⬝ᵥ r` (`encode_apply`). -/
def encode (a : Fin m → ZMod 2) : (Fin m → ZMod 2) → ZMod 2 :=
  LinearCode.encode (generator m) a

/-- The **Hadamard code** of order `m`: the code generated by `generator m`. -/
def code (m : ℕ) : LinearCode (ZMod 2) (Fin m → ZMod 2) := LinearCode.ofGenerator (generator m)

/-- The Hadamard code of order `m` has length `2^m`: one position for each vector of `𝔽₂^m`. -/
theorem card_positions (m : ℕ) : Fintype.card (Fin m → ZMod 2) = 2 ^ m := by
  rw [Fintype.card_fun, ZMod.card, Fintype.card_fin]

/-- The codeword of `a` at position `r` is `a ⬝ᵥ r`. -/
@[simp]
theorem encode_apply (a r : Fin m → ZMod 2) : encode a r = a ⬝ᵥ r := rfl

theorem encode_mem_code (a : Fin m → ZMod 2) : encode a ∈ code m :=
  LinearCode.encode_mem_ofGenerator (generator m) a

theorem mem_code {c : (Fin m → ZMod 2) → ZMod 2} : c ∈ code m ↔ ∃ a, encode a = c :=
  LinearCode.mem_ofGenerator

@[simp]
theorem encode_zero : encode (0 : Fin m → ZMod 2) = 0 :=
  Matrix.zero_vecMul (generator m)

theorem encode_sub (a b : Fin m → ZMod 2) : encode (a - b) = encode a - encode b :=
  Matrix.sub_vecMul (generator m) a b

/-- At the standard basis vector `eᵢ`, the codeword of `a` reads the message bit `a i`. -/
theorem encode_single_one (a : Fin m → ZMod 2) (i : Fin m) : encode a (Pi.single i 1) = a i :=
  dotProduct_single_one a i

/-- The encoder is injective: the codeword of `a` reads `a i` at `eᵢ`. -/
theorem encode_injective : Function.Injective (encode (m := m)) := by
  intro a b h
  funext i
  rw [← encode_single_one a i, ← encode_single_one b i, h]

/-- The Hadamard code of order `m` has dimension `m`. -/
theorem finrank_code (m : ℕ) : Module.finrank (ZMod 2) (code m) = m := by
  rw [code, LinearCode.ofGenerator, LinearMap.finrank_range_of_inj encode_injective,
    Module.finrank_fintype_fun_eq_card, Fintype.card_fin]

/-- The generator matrix has full rank `m`. -/
theorem rank_generator (m : ℕ) : (generator m).rank = m := by
  rw [← LinearCode.finrank_ofGenerator]
  exact finrank_code m

/-- **Every nonzero codeword has weight exactly `2^(m-1)`.** Pick a coordinate `i` with `a i = 1`;
translating the position by `eᵢ` flips the codeword's value, so it pairs the positions where the
codeword is nonzero with those where it is zero. -/
theorem hammingNorm_encode {a : Fin m → ZMod 2} (ha : a ≠ 0) :
    hammingNorm (encode a) = 2 ^ (m - 1) := by
  obtain ⟨i, hi⟩ := Function.ne_iff.mp ha
  have hai : a i = 1 := (by decide : ∀ x : ZMod 2, x ≠ 0 → x = 1) _ hi
  have hflip (r : Fin m → ZMod 2) : encode a (r + Pi.single i 1) = encode a r + 1 := by
    rw [encode_apply, encode_apply, dotProduct_add, dotProduct_single_one, hai]
  have hpair : (Finset.univ.filter fun r ↦ encode a r ≠ 0).card =
      (Finset.univ.filter fun r ↦ ¬encode a r ≠ 0).card := by
    refine Finset.card_equiv (Equiv.addRight (Pi.single i 1)) fun r ↦ ?_
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Equiv.coe_addRight, hflip]
    generalize encode a r = x
    revert x
    decide
  have hsum : (Finset.univ.filter fun r ↦ encode a r ≠ 0).card +
      (Finset.univ.filter fun r ↦ ¬encode a r ≠ 0).card = 2 ^ m := by
    rw [Finset.card_filter_add_card_filter_not, Finset.card_univ, card_positions]
  rw [← hpair] at hsum
  have hm : m ≠ 0 := by
    rintro rfl
    exact ha (funext fun i ↦ i.elim0)
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm
  rw [pow_succ] at hsum
  rw [Nat.add_sub_cancel, hammingNorm]
  omega

/-- Every nonzero codeword of the Hadamard code has weight exactly `2^(m-1)`. -/
theorem hammingNorm_of_mem_code {c : (Fin m → ZMod 2) → ZMod 2} (hc : c ∈ code m) (hne : c ≠ 0) :
    hammingNorm c = 2 ^ (m - 1) := by
  obtain ⟨a, rfl⟩ := mem_code.mp hc
  exact hammingNorm_encode fun ha ↦ hne (by rw [ha, encode_zero])

/-- **Distinct codewords are at distance exactly `2^(m-1)`.** -/
theorem hammingDist_encode {a b : Fin m → ZMod 2} (hab : a ≠ b) :
    hammingDist (encode a) (encode b) = 2 ^ (m - 1) := by
  rw [hammingDist_eq_hammingNorm_sub, ← encode_sub, hammingNorm_encode (sub_ne_zero.mpr hab)]

/-- For `m ≥ 1`, the minimum weight of the Hadamard code is `2^(m-1)`. -/
theorem minWeight_code (hm : 1 ≤ m) : (code m).minWeight = (2 ^ (m - 1) : ℕ) := by
  refine le_antisymm ?_ (LinearCode.le_minWeight_iff.mpr fun c hc hne ↦ ?_)
  · have he : (Pi.single (⟨0, hm⟩ : Fin m) 1 : Fin m → ZMod 2) ≠ 0 := fun h ↦ by
      simpa using congrFun h ⟨0, hm⟩
    have hne : encode (Pi.single (⟨0, hm⟩ : Fin m) 1 : Fin m → ZMod 2) ≠ 0 := by
      rw [← encode_zero]
      exact encode_injective.ne he
    have h := LinearCode.minWeight_le (encode_mem_code _) hne
    rwa [hammingNorm_encode he] at h
  · rw [hammingNorm_of_mem_code hc hne]

/-- **The Hadamard code has minimum distance `2^(m-1)`** for `m ≥ 1`. -/
theorem minDist_code (hm : 1 ≤ m) : (code m).minDist = (2 ^ (m - 1) : ℕ) := by
  rw [LinearCode.minDist_eq_minWeight, minWeight_code hm]

/-- For `m = 0` the code has a single codeword, so its minimum distance is `⊤`. -/
theorem minDist_code_zero : (code 0).minDist = ⊤ := by
  refine top_le_iff.mp (LinearCode.le_minDist_iff.mpr fun c₁ h₁ c₂ h₂ hne ↦ ?_)
  obtain ⟨a₁, rfl⟩ := mem_code.mp h₁
  obtain ⟨a₂, rfl⟩ := mem_code.mp h₂
  exact absurd (congrArg encode (funext fun i ↦ i.elim0 : a₁ = a₂)) hne

end Cslib.CodingTheory.Hadamard

/-! ### Deprecated names

The first version of this development, whose statements the QCI-39 roadmap pins, stated the
results in the namespace below with a local `dot` in place of `dotProduct`. These declarations
keep those statements unchanged, as corollaries of the API above. -/

namespace MathlibExt.Combinatorics.Coding.Hadamard

/-- The dot product of two binary vectors: Mathlib's `dotProduct`. -/
@[deprecated dotProduct +typeChanged (since := "2026-11-13")]
def dot {m : ℕ} (a r : Fin m → ZMod 2) : ZMod 2 :=
  a ⬝ᵥ r

/-- The Hadamard codeword of `a`: `Cslib.CodingTheory.Hadamard.encode a`, whose entry at `r` is
`a ⬝ᵥ r`. -/
@[deprecated Cslib.CodingTheory.Hadamard.encode (since := "2026-11-13")]
def hadCode {m : ℕ} (a : Fin m → ZMod 2) :
    (Fin m → ZMod 2) → ZMod 2 :=
  Cslib.CodingTheory.Hadamard.encode a

set_option linter.deprecated false in
/-- Every nonzero Hadamard codeword has weight exactly half
the block length: `dot a r = 1` for exactly `2 ^ (m - 1)` of
the `2 ^ m` vectors `r`. -/
@[deprecated Cslib.CodingTheory.Hadamard.hammingNorm_encode +typeChanged (since := "2026-11-13")]
theorem hadWeight {m : ℕ} (a : Fin m → ZMod 2) (ha : a ≠ 0) :
    (Finset.univ.filter (fun r => dot a r = 1)).card =
      2 ^ (m - 1) := by
  rw [← Cslib.CodingTheory.Hadamard.hammingNorm_encode ha, hammingNorm]
  congr 1
  apply Finset.filter_congr
  intro r _
  exact (by decide : ∀ x : ZMod 2, x = 1 ↔ x ≠ 0) _

set_option linter.deprecated false in
/-- `hadWeight` in Mathlib's Hamming vocabulary: a nonzero
Hadamard codeword has Hamming norm `2 ^ (m - 1)`. -/
@[deprecated Cslib.CodingTheory.Hadamard.hammingNorm_encode +typeChanged (since := "2026-11-13")]
theorem hammingNorm_hadCode {m : ℕ} (a : Fin m → ZMod 2) (ha : a ≠ 0) :
    hammingNorm (hadCode a) = 2 ^ (m - 1) :=
  Cslib.CodingTheory.Hadamard.hammingNorm_encode ha

set_option linter.deprecated false in
/-- Distinct Hadamard codewords are at Hamming distance
exactly `2 ^ (m - 1)`. For `m = 0` there is only one
codeword, so the hypothesis `a ≠ b` cannot hold and the
statement is vacuous. -/
@[deprecated Cslib.CodingTheory.Hadamard.hammingDist_encode +typeChanged (since := "2026-11-13")]
theorem hadDist {m : ℕ} (a b : Fin m → ZMod 2) (hab : a ≠ b) :
    hammingDist (hadCode a) (hadCode b) = 2 ^ (m - 1) :=
  Cslib.CodingTheory.Hadamard.hammingDist_encode hab

set_option linter.deprecated false in
/-- The Hadamard encoding is injective, so the code has
dimension `m` (`Cslib.CodingTheory.Hadamard.finrank_code`). -/
@[deprecated Cslib.CodingTheory.Hadamard.encode_injective +typeChanged (since := "2026-11-13")]
theorem hadCode_injective {m : ℕ} :
    Function.Injective (hadCode (m := m)) :=
  Cslib.CodingTheory.Hadamard.encode_injective

end MathlibExt.Combinatorics.Coding.Hadamard
