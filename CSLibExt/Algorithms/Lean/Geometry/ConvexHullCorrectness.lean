module

public import CSLibExt.Algorithms.Lean.Geometry.ConvexHullPolygon
public import Mathlib.Analysis.Convex.Extreme
public import Mathlib.Basic.Real.Basic
import Mathlib.Analysis.Convex.Topology
import Mathlib.Analysis.LocallyConvex.Separation

/-!
# Correctness of Andrew's monotone-chain convex hull

For strictly lexicographically sorted, noncollinear real plane points, the computed polygon has
exactly the extreme points of the Mathlib convex hull as vertices. Its closed region is the
intersection of the left closed half-planes of its consecutive cyclic edges.

The enclosure converse uses separation: at a vertex maximizing a separating linear functional,
the two incident half-planes constrain every point in the region to the cone generated by the two
neighbor directions. The functional cannot increase in that cone. The two supporting lines
intersect only at the vertex, which makes it extreme.

See de Berg, Cheong, van Kreveld and Overmars, *Computational Geometry: Algorithms and
Applications*, third edition, Section 1.1.
-/

set_option autoImplicit false

namespace Cslib.Algorithms.Lean.Geometry

open Set Cslib.Algorithms.Lean TimeM

private abbrev Point := ℝ × ℝ

private abbrev pointSet (ps : List Point) : Set Point := {x | x ∈ ps}

private noncomputable abbrev orient (a b x : Point) : ℝ := cross (b - a) (x - a)

private theorem fst_smul_real (u : ℝ) (x : Point) : (u • x).1 = u * x.1 := rfl

private theorem snd_smul_real (u : ℝ) (x : Point) : (u • x).2 = u * x.2 := rfl

/-- Append the first vertex once, so the last-to-first edge is included. -/
private abbrev region (vs : List Point) : Set Point :=
  {x | (vs ++ vs.take 1).IsChain fun a b => 0 ≤ orient a b x}

private theorem orient_combo (a b x y : Point) {u v : ℝ} (h : u + v = 1) :
    orient a b (u • x + v • y) = u * orient a b x + v * orient a b y := by
  simp only [orient, cross, Prod.fst_sub, Prod.snd_sub, Prod.fst_add, Prod.snd_add,
    fst_smul_real, snd_smul_real]
  linear_combination ((b.1 - a.1) * a.2 - a.1 * (b.2 - a.2)) * h

private theorem convex_region (vs : List Point) : Convex ℝ (region vs) := by
  intro x hx y hy u v hu hv huv
  change (vs ++ vs.take 1).IsChain _ at hx hy ⊢
  rw [List.isChain_iff_getElem] at hx hy ⊢
  intro i hi
  rw [orient_combo _ _ _ _ huv]
  exact add_nonneg (mul_nonneg hu (hx i hi)) (mul_nonneg hv (hy i hi))

/-- Coordinates in the basis of the two directions from a strict left corner into the polygon. -/
private theorem corner_coordinates {a b c : Point} (h : 0 < orient a b c) (x : Point) :
    x - b = (orient b c x / orient a b c) • (a - b) +
      (orient a b x / orient a b c) • (c - b) := by
  apply Prod.ext <;>
    simp only [Prod.fst_sub, Prod.snd_sub, Prod.fst_add, Prod.snd_add,
      fst_smul_real, snd_smul_real] <;>
    field_simp [h.ne'] <;>
    simp only [orient, cross, Prod.fst_sub, Prod.snd_sub] <;> ring

private theorem input_length {ps : List Point}
    (hn : ∃ a ∈ ps, ∃ b ∈ ps, ∃ c ∈ ps, orient a b c ≠ 0) : 2 ≤ ps.length := by
  obtain ⟨a, ha, b, hb, c, _, h⟩ := hn
  rcases ps with _ | ⟨p, _ | ⟨q, ps⟩⟩
  · simp at ha
  · simp only [List.mem_singleton] at ha hb
    subst a b
    simp [orient, cross] at h
  · simp

private theorem output_length {ps : List Point}
    (hs : ps.Pairwise fun a b => toLex a < toLex b) (hp : 2 ≤ ps.length)
    (ht : TurnsLeft ((convexHull ps).ret ++ (convexHull ps).ret.take 2)) :
    3 ≤ (convexHull ps).ret.length := by
  have hends : ps.head? ≠ ps.getLast? := by
    rcases ps with _ | ⟨a, _ | ⟨b, rest⟩⟩
    · simp at hp
    · simp at hp
    · intro he
      have hmem : (b :: rest).getLast (List.cons_ne_nil _ _) ∈ b :: rest := List.getLast_mem _
      have hlt := List.rel_of_pairwise_cons hs hmem
      rw [List.getLast?_cons_cons, List.getLast?_eq_some_getLast (List.cons_ne_nil _ _),
        List.head?_cons, Option.some.injEq] at he
      exact (ne_of_lt hlt) (congrArg toLex he)
  have hLower : 2 ≤ (lowerHull ps).ret.length := by
    have h : (lowerHull ps).ret.head? ≠ (lowerHull ps).ret.getLast? :=
      fun he => hends ((lowerHull_head? ps hs).symm.trans (he.trans (lowerHull_getLast? ps hs)))
    generalize (lowerHull ps).ret = lower at h ⊢
    rcases lower with _ | ⟨a, _ | ⟨b, rest⟩⟩
    · exact False.elim (h rfl)
    · exact False.elim (h rfl)
    · simp
  have hHull : 2 ≤ (convexHull ps).ret.length := by
    change 2 ≤ ((lowerHull ps).ret ++ (upperHull ps).ret.tail.dropLast).length
    simp only [List.length_append]
    omega
  generalize (convexHull ps).ret = vs at hHull ht ⊢
  rcases vs with _ | ⟨a, _ | ⟨b, _ | ⟨c, rest⟩⟩⟩
  · simp at hHull
  · simp at hHull
  · change TurnsLeft [a, b, a, b] at ht
    have h : 0 < orient a b a := ht.1
    simp [orient, cross] at h
  · simp

/-- The additional edge in the twice-closed list is a repeat of the first edge. -/
private theorem chain_close_twice {α : Type*} {R : α → α → Prop} {vs : List α}
    (hlen : 2 ≤ vs.length) (h : (vs ++ vs.take 1).IsChain R) :
    (vs ++ vs.take 2).IsChain R := by
  rcases vs with _ | ⟨a, _ | ⟨b, rest⟩⟩
  · simp at hlen
  · simp at hlen
  · change ((a :: b :: rest) ++ [a]).IsChain R at h
    change ((a :: b :: rest) ++ [a, b]).IsChain R
    rw [show [a, b] = [a] ++ [b] by rfl, ← List.append_assoc, List.isChain_append]
    refine ⟨h, List.isChain_singleton _, ?_⟩
    intro p hp q hq
    rw [List.getLast?_concat] at hp
    simp only [Option.mem_def, Option.some.injEq, List.head?_cons] at hp hq
    subst p q
    exact (List.isChain_cons_cons.mp h.left_of_append).1

/-- Every vertex has a strict corner using actual incident cyclic edges, including at the head. -/
private theorem vertex_corner {vs : List Point} (hlen : 3 ≤ vs.length)
    (ht : TurnsLeft (vs ++ vs.take 2)) {b : Point} (hb : b ∈ vs) :
    ∃ a ∈ vs, ∃ c ∈ vs, 0 < orient a b c ∧
      ∀ x ∈ region vs, 0 ≤ orient a b x ∧ 0 ≤ orient b c x := by
  let loop := vs ++ vs.take 2
  have hloop : loop.length = vs.length + 2 := by
    simp [loop, Nat.min_eq_left (show 2 ≤ vs.length by omega)]
  obtain ⟨j, hj, hv⟩ := List.mem_iff_getElem.mp hb
  obtain ⟨i, hi, hmid⟩ : ∃ i : ℕ, ∃ hi : i + 2 < loop.length, loop[i + 1]'(by omega) = b := by
    cases j with
    | zero =>
      refine ⟨vs.length - 1, by omega, ?_⟩
      have he : vs.length - 1 + 1 = vs.length := by omega
      change (vs ++ vs.take 2)[vs.length - 1 + 1] = b
      rw [List.getElem_append_right (by omega)]
      simpa [he, List.getElem_take] using hv
    | succ j =>
      refine ⟨j, by omega, ?_⟩
      change (vs ++ vs.take 2)[j + 1] = b
      rwa [List.getElem_append_left hj]
  have hmem {k : ℕ} (hk : k < loop.length) : loop[k] ∈ vs := by
    have hm : loop[k] ∈ loop := List.getElem_mem _
    exact (List.mem_append.mp hm).elim id List.mem_of_mem_take
  refine ⟨loop[i], hmem (by omega), loop[i + 2], hmem hi, ?_, ?_⟩
  · simpa only [← hmid] using (turnsLeft_iff_getElem.mp ht i hi)
  · intro x hx
    have hchain : loop.IsChain (fun a b => 0 ≤ orient a b x) :=
      chain_close_twice (by omega) hx
    have he := List.isChain_iff_getElem.mp hchain
    exact ⟨by simpa only [hmid] using he i (by omega),
      by simpa only [hmid] using he (i + 1) hi⟩

/-- The vertex maximizing a separating functional rules out any point outside the vertex hull. -/
private theorem region_subset_vertex_hull {vs : List Point} (hlen : 3 ≤ vs.length)
    (ht : TurnsLeft (vs ++ vs.take 2)) : region vs ⊆ _root_.convexHull ℝ (pointSet vs) := by
  classical
  intro x hx
  by_contra hout
  have hfin : (pointSet vs).Finite := by
    simpa only [pointSet, List.coe_toFinset] using vs.toFinset.finite_toSet
  obtain ⟨f, u, hlt, hxu⟩ := geometric_hahn_banach_closed_point (convex_convexHull ℝ _)
    (hfin.isClosed_convexHull ℝ) hout
  have hne : vs.toFinset.Nonempty := by
    rcases vs with _ | ⟨v, vs⟩
    · simp at hlen
    · exact ⟨v, by simp⟩
  obtain ⟨b, hb, hbmax⟩ := Finset.exists_max_image vs.toFinset f hne
  obtain ⟨a, ha, c, hc, h, hside⟩ := vertex_corner hlen ht (List.mem_toFinset.mp hb)
  have hab := hbmax a (List.mem_toFinset.mpr ha)
  have hcb := hbmax c (List.mem_toFinset.mpr hc)
  obtain ⟨hax, hcx⟩ := hside x hx
  have hfx : f x - f b = (orient b c x / orient a b c) * (f a - f b) +
      (orient a b x / orient a b c) * (f c - f b) := by
    simpa only [map_sub, map_add, map_smul, smul_eq_mul] using
      congrArg f (corner_coordinates h x)
  have hle : f x - f b ≤ 0 := hfx ▸ add_nonpos
    (mul_nonpos_of_nonneg_of_nonpos (div_nonneg hcx h.le) (sub_nonpos.mpr hab))
    (mul_nonpos_of_nonneg_of_nonpos (div_nonneg hax h.le) (sub_nonpos.mpr hcb))
  exact (not_lt_of_ge (sub_nonpos.mp hle))
    ((hlt b (subset_convexHull ℝ _ (List.mem_toFinset.mp hb))).trans hxu)

/-- A strict corner in the region is extreme: neither incident orientation can be positive at
an endpoint of an open segment through the corner. -/
private theorem vertex_extreme {vs : List Point} (hlen : 3 ≤ vs.length)
    (ht : TurnsLeft (vs ++ vs.take 2)) {b : Point} (hb : b ∈ vs) (hbR : b ∈ region vs) :
    b ∈ (region vs).extremePoints ℝ := by
  obtain ⟨a, _, c, _, h, hside⟩ := vertex_corner hlen ht hb
  refine mem_extremePoints_iff_left.mpr ⟨hbR, ?_⟩
  intro x hx y hy hseg
  obtain ⟨u, v, hu, hv, huv, he⟩ := hseg
  obtain ⟨hax, hcx⟩ := hside x hx
  obtain ⟨hay, hcy⟩ := hside y hy
  have hz {p q : Point} (h₀ : orient p q b = 0)
      (hx₀ : 0 ≤ orient p q x) (hy₀ : 0 ≤ orient p q y) : orient p q x = 0 := by
    have heq := orient_combo p q x y huv
    rw [he, h₀] at heq
    exact hx₀.antisymm' <| nonpos_of_mul_nonpos_left
      (by linarith [mul_nonneg hv.le hy₀]) hu
  have hax₀ := hz (p := a) (q := b) (by simp [orient, cross]) hax hay
  have hcx₀ := hz (p := b) (q := c) (by simp [orient, cross]) hcx hcy
  have heq := corner_coordinates h x
  rw [hax₀, hcx₀] at heq
  exact sub_eq_zero.mp (by simpa using heq)

/-- **The computed convex hull equals the convex hull.** For a list of real plane points strictly
increasing in lexicographic order and containing a noncollinear triple, Andrew's monotone-chain
algorithm returns at least three vertices. Their set is exactly the set of extreme points of the
Mathlib convex hull of the input. The closed region, the intersection of the left closed
half-planes of successive directed edges including the last-to-first edge, is exactly that hull.
The edge inequalities are non-strict, so the region includes its boundary. -/
public theorem convexHull_correct (ps : List (ℝ × ℝ))
    (hs : ps.Pairwise fun a b => toLex a < toLex b)
    (hncol : ∃ a ∈ ps, ∃ b ∈ ps, ∃ c ∈ ps, cross (b - a) (c - a) ≠ 0) :
    let vs := (convexHull ps).ret
    3 ≤ vs.length ∧
      {x | x ∈ vs} = (_root_.convexHull ℝ {x | x ∈ ps}).extremePoints ℝ ∧
      {x | (vs ++ vs.take 1).IsChain fun a b => 0 ≤ cross (b - a) (x - a)} =
        _root_.convexHull ℝ {x | x ∈ ps} := by
  let vs := (convexHull ps).ret
  change 3 ≤ vs.length ∧
    pointSet vs = (_root_.convexHull ℝ (pointSet ps)).extremePoints ℝ ∧
    region vs = _root_.convexHull ℝ (pointSet ps)
  have hp := input_length hncol
  have ht : TurnsLeft (vs ++ vs.take 2) := convexHull_turnsLeft ps hs hncol
  have hlen : 3 ≤ vs.length := output_length hs hp ht
  have hverts : pointSet vs ⊆ pointSet ps := fun _ hx => convexHull_subset ps hs _ hx
  have hinput : pointSet ps ⊆ region vs := fun _ hx => convexHull_left_of_edges ps hs hp hx
  have hIR := convexHull_min hinput (convex_region vs)
  have hRV := region_subset_vertex_hull hlen ht
  have hVI := convexHull_mono (𝕜 := ℝ) hverts
  have heq := hRV.antisymm (hVI.trans hIR)
  have hreg := (hRV.trans hVI).antisymm hIR
  refine ⟨hlen, ?_, hreg⟩
  rw [← hreg]
  apply Subset.antisymm
  · exact fun _ hv => vertex_extreme hlen ht hv (hinput (hverts hv))
  · rw [heq]
    exact extremePoints_convexHull_subset

end Cslib.Algorithms.Lean.Geometry
