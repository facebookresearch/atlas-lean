module

public import CSLibExt.Algorithms.Lean.MDP.FiniteHorizon

/-!
# Expectimax and the finite-horizon MDP value

A finite chance tree has real-valued leaves, max nodes (our choice), min nodes
(an opponent's choice), chance nodes (a finite list of weighted branches), and
affine edges `c + γ • value` for a reward and discount collected along one
transition. `expectimax` evaluates the tree by maximum at max nodes, minimum
at min nodes, and expectation at chance nodes. Empty max and min nodes are
totalized to `0`, the zero terminal value; `ChanceTree.WellFormed` excludes
them and requires chance weights to be a probability law.

The bridge to Markov decision processes is the stationary unfolding
`FiniteHorizon.unfoldTree M γ k s`: at horizon `0` it is the zero leaf, and at
horizon `k + 1` it chooses an action at a max node, collects that action's
reward on an affine edge, and branches over all next states at a chance node.
`expectimax_unfoldTree` identifies its expectimax value with the existing
`finiteHorizonValue M γ k s`. Min nodes are not generated by this unfolding:
they belong to a stochastic game, not to an ordinary MDP.

## References

Russell and Norvig, *Artificial Intelligence: A Modern Approach*, fourth
edition, expectimax for games of chance; Puterman, *Markov Decision
Processes*, finite-horizon backward induction. The MDP side reuses
`CSLibExt/Algorithms/Lean/MDP/FiniteHorizon.lean`; no second MDP is defined.
Atlas roadmap `smai:A-W03` (`cs:AI-004`).
-/

@[expose] public section

set_option autoImplicit false

namespace Cslib.Algorithms.Lean.GameTree

/-- A finite chance tree with real utilities. An `affine c γ t` edge stands for
the value `c + γ * (value of t)`, as when one MDP transition collects reward
`c` and discounts the continuation by `γ`. -/
inductive ChanceTree where
  | leaf : ℝ → ChanceTree
  | maxNode : List ChanceTree → ChanceTree
  | minNode : List ChanceTree → ChanceTree
  | chanceNode : List (ℝ × ChanceTree) → ChanceTree
  | affine : ℝ → ℝ → ChanceTree → ChanceTree

/-- Source-faithful chance trees: max and min nodes have a move, and chance
weights are nonnegative and sum to `1`. -/
inductive ChanceTree.WellFormed : ChanceTree → Prop where
  | leaf (u : ℝ) : WellFormed (.leaf u)
  | maxNode {ts : List ChanceTree} (hne : ts ≠ [])
      (h : ∀ t ∈ ts, WellFormed t) : WellFormed (.maxNode ts)
  | minNode {ts : List ChanceTree} (hne : ts ≠ [])
      (h : ∀ t ∈ ts, WellFormed t) : WellFormed (.minNode ts)
  | chanceNode {ps : List (ℝ × ChanceTree)}
      (hprob : ∀ pt ∈ ps, 0 ≤ pt.1)
      (hsum : (ps.map Prod.fst).sum = 1)
      (h : ∀ pt ∈ ps, WellFormed pt.2) : WellFormed (.chanceNode ps)
  | affine {c γ : ℝ} {t : ChanceTree} (h : WellFormed t) :
      WellFormed (.affine c γ t)

/-- Trees with no opponent node: leaves, max and chance nodes, and affine
edges. Every MDP unfolding has this property, but not every such tree is an unfolding. -/
inductive ChanceTree.IsMaxChance : ChanceTree → Prop where
  | leaf (u : ℝ) : IsMaxChance (.leaf u)
  | maxNode {ts : List ChanceTree}
      (h : ∀ t ∈ ts, IsMaxChance t) : IsMaxChance (.maxNode ts)
  | chanceNode {ps : List (ℝ × ChanceTree)}
      (h : ∀ pt ∈ ps, IsMaxChance pt.2) : IsMaxChance (.chanceNode ps)
  | affine {c γ : ℝ} {t : ChanceTree} (h : IsMaxChance t) :
      IsMaxChance (.affine c γ t)

mutual
/-- The expectimax value of a chance tree: maximum at max nodes, minimum at
min nodes, expectation at chance nodes, and `c + γ * value` at affine edges.
Empty max and min nodes are totalized to the zero terminal value `0`. -/
def expectimax : ChanceTree → ℝ
  | .leaf u => u
  | .maxNode ts => expectimaxMax ts
  | .minNode ts => expectimaxMin ts
  | .chanceNode ps => expectimaxChance ps
  | .affine c γ t => c + γ * expectimax t

/-- The maximum expectimax value among a list of trees, totalized to `0` on
the empty list. -/
def expectimaxMax : List ChanceTree → ℝ
  | [] => 0
  | [t] => expectimax t
  | t :: u :: ts => max (expectimax t) (expectimaxMax (u :: ts))

/-- The minimum expectimax value among a list of trees, totalized to `0` on
the empty list. -/
def expectimaxMin : List ChanceTree → ℝ
  | [] => 0
  | [t] => expectimax t
  | t :: u :: ts => min (expectimax t) (expectimaxMin (u :: ts))

/-- The expected expectimax value over weighted chance branches. -/
def expectimaxChance : List (ℝ × ChanceTree) → ℝ
  | [] => 0
  | (p, t) :: ps => p * expectimax t + expectimaxChance ps
end

@[simp] theorem expectimax_leaf (u : ℝ) : expectimax (.leaf u) = u := rfl

@[simp] theorem expectimax_maxNode (ts : List ChanceTree) :
    expectimax (.maxNode ts) = expectimaxMax ts := rfl

@[simp] theorem expectimax_minNode (ts : List ChanceTree) :
    expectimax (.minNode ts) = expectimaxMin ts := rfl

@[simp] theorem expectimax_chanceNode (ps : List (ℝ × ChanceTree)) :
    expectimax (.chanceNode ps) = expectimaxChance ps := rfl

@[simp] theorem expectimax_affine (c γ : ℝ) (t : ChanceTree) :
    expectimax (.affine c γ t) = c + γ * expectimax t := rfl

/-- Expectation over a mapped list of chance branches is the sum of the
weighted child values. -/
theorem expectimaxChance_map {ι : Type*} (l : List ι) (w : ι → ℝ)
    (f : ι → ChanceTree) :
    expectimaxChance (l.map fun s => (w s, f s)) =
      (l.map fun s => w s * expectimax (f s)).sum := by
  induction l with
  | nil => simp [expectimaxChance]
  | cons s l ih => simp [expectimaxChance, ih]

/-- Every member's expectimax value is at most the maximum over the list. -/
theorem le_expectimaxMax_of_mem {t : ChanceTree} {ts : List ChanceTree}
    (h : t ∈ ts) : expectimax t ≤ expectimaxMax ts := by
  induction ts with
  | nil => simp at h
  | cons u ts ih =>
      rcases List.mem_cons.1 h with rfl | h
      · cases ts with
        | nil => simp [expectimaxMax]
        | cons v ts => simp [expectimaxMax]
      · have hle := ih h
        cases ts with
        | nil => simp at h
        | cons v ts => exact hle.trans (by simp [expectimaxMax])

/-- If every member's expectimax value is at most `b` and the list is
nonempty, then the maximum over the list is at most `b`. -/
theorem expectimaxMax_le_of_forall {b : ℝ} {ts : List ChanceTree}
    (hne : ts ≠ []) (h : ∀ t ∈ ts, expectimax t ≤ b) :
    expectimaxMax ts ≤ b := by
  induction ts with
  | nil => exact absurd rfl hne
  | cons u ts ih =>
      cases ts with
      | nil => simpa [expectimaxMax] using h u (by simp)
      | cons v ts =>
          have hv : expectimaxMax (v :: ts) ≤ b :=
            ih (by simp) (fun t ht => h t (List.mem_cons_of_mem u ht))
          simp only [expectimaxMax]
          exact max_le (h u (by simp)) hv

end Cslib.Algorithms.Lean.GameTree

namespace Cslib.Algorithms.Lean.MarkovDecision.FiniteHorizon

open Cslib.Algorithms.Lean.GameTree

/-- The depth-`k` stationary unfolding of a finite MDP as a chance tree:
the zero leaf at horizon `0`; at horizon `k + 1`, a max node over all actions,
each followed by its reward edge and a chance node over all next states. -/
noncomputable def unfoldTree {S A : Type*} [Fintype S] [Fintype A] [Nonempty A]
    (M : MDP S A ℝ) (γ : ℝ) : ℕ → S → ChanceTree
  | 0, _ => .leaf 0
  | k + 1, s =>
      .maxNode (Finset.univ.toList.map fun a =>
        .affine (M.reward s a) γ
          (.chanceNode (Finset.univ.toList.map fun s' =>
            (M.prob s a s', unfoldTree M γ k s'))))

private theorem expectimax_chanceNode_unfoldTree {S A : Type*} [Fintype S]
    [Fintype A] [Nonempty A] (M : MDP S A ℝ) (γ : ℝ) (k : ℕ)
    (ih : ∀ s : S, expectimax (unfoldTree M γ k s) =
      finiteHorizonValue M γ k s) (s : S) (a : A) :
    expectimax (.chanceNode (Finset.univ.toList.map fun s' =>
        (M.prob s a s', unfoldTree M γ k s'))) =
      ∑ s', M.prob s a s' * finiteHorizonValue M γ k s' := by
  classical
  rw [expectimax_chanceNode, expectimaxChance_map]
  simp [ih]

/-- **Expectimax of the MDP unfolding is the finite-horizon value.** For a
finite MDP, the depth-`k` max/chance unfolding at state `s` has expectimax
value `finiteHorizonValue M γ k s`. The equality is algebraic in the rewards
and transition weights, so it needs no stochastic or discount hypothesis. -/
theorem expectimax_unfoldTree {S A : Type*} [Fintype S] [Fintype A] [Nonempty A]
    (M : MDP S A ℝ) (γ : ℝ) :
    ∀ (k : ℕ) (s : S), expectimax (unfoldTree M γ k s) =
      finiteHorizonValue M γ k s := by
  intro k
  induction k with
  | zero => intro s; simp [unfoldTree, finiteHorizonValue_zero]
  | succ k ih =>
      intro s
      rw [finiteHorizonValue_succ]
      rw [unfoldTree, expectimax_maxNode]
      obtain ⟨a0⟩ := (inferInstance : Nonempty A)
      have hne : (Finset.univ.toList.map fun a =>
          ChanceTree.affine (M.reward s a) γ
            (.chanceNode (Finset.univ.toList.map fun s' =>
              (M.prob s a s', unfoldTree M γ k s')))) ≠ [] :=
        List.ne_nil_of_mem (List.mem_map.2
          ⟨a0, Finset.mem_toList.2 (Finset.mem_univ a0), rfl⟩)
      have hbranch : ∀ t ∈ Finset.univ.toList.map (fun a =>
          ChanceTree.affine (M.reward s a) γ
            (.chanceNode (Finset.univ.toList.map fun s' =>
              (M.prob s a s', unfoldTree M γ k s')))),
          expectimax t ≤ bellman M γ (finiteHorizonValue M γ k) s := by
        intro t ht
        rcases List.mem_map.1 ht with ⟨a, -, rfl⟩
        rw [expectimax_affine,
          expectimax_chanceNode_unfoldTree M γ k ih s a]
        exact Finset.le_sup' (qValue M γ (finiteHorizonValue M γ k) s)
          (Finset.mem_univ a)
      apply le_antisymm
      · exact expectimaxMax_le_of_forall hne hbranch
      · refine Finset.sup'_le Finset.univ_nonempty
          (qValue M γ (finiteHorizonValue M γ k) s) fun a _ => ?_
        have hmem : ChanceTree.affine (M.reward s a) γ
            (.chanceNode (Finset.univ.toList.map fun s' =>
              (M.prob s a s', unfoldTree M γ k s'))) ∈
            Finset.univ.toList.map (fun a =>
              ChanceTree.affine (M.reward s a) γ
                (.chanceNode (Finset.univ.toList.map fun s' =>
                  (M.prob s a s', unfoldTree M γ k s')))) :=
          List.mem_map.2 ⟨a, Finset.mem_toList.2 (Finset.mem_univ a), rfl⟩
        have hle := le_expectimaxMax_of_mem hmem
        rwa [expectimax_affine,
          expectimax_chanceNode_unfoldTree M γ k ih s a] at hle

/-- A stochastic MDP unfolds to a well-formed chance tree. -/
theorem unfoldTree_wellFormed {S A : Type*} [Fintype S] [Fintype A] [Nonempty A]
    (M : MDP S A ℝ) (γ : ℝ) (hM : M.Stochastic) :
    ∀ (k : ℕ) (s : S), (unfoldTree M γ k s).WellFormed := by
  intro k
  induction k with
  | zero => intro s; exact ChanceTree.WellFormed.leaf 0
  | succ k ih =>
      intro s
      rw [unfoldTree]
      obtain ⟨a0⟩ := (inferInstance : Nonempty A)
      refine ChanceTree.WellFormed.maxNode
        (List.ne_nil_of_mem (List.mem_map.2
          ⟨a0, Finset.mem_toList.2 (Finset.mem_univ a0), rfl⟩))
        fun t ht => ?_
      rcases List.mem_map.1 ht with ⟨a, -, rfl⟩
      refine ChanceTree.WellFormed.affine ?_
      refine ChanceTree.WellFormed.chanceNode (fun pt hpt => ?_)
        ?_ (fun pt hpt => ?_)
      · rcases List.mem_map.1 hpt with ⟨s', -, rfl⟩
        exact hM.1 s a s'
      · classical
        have hsum := List.sum_toFinset (M.prob s a)
          (Finset.nodup_toList (Finset.univ : Finset S))
        have hto : (Finset.univ.toList).toFinset = (Finset.univ : Finset S) := by
          simp
        rw [hto] at hsum
        simpa [List.map_map] using hsum.symm.trans (hM.2 s a)
      · rcases List.mem_map.1 hpt with ⟨s', -, rfl⟩
        exact ih s'

/-- An MDP unfolding has no opponent node. Min nodes belong to a stochastic
game, not to the ordinary MDP bridge. -/
theorem unfoldTree_isMaxChance {S A : Type*} [Fintype S] [Fintype A] [Nonempty A]
    (M : MDP S A ℝ) (γ : ℝ) :
    ∀ (k : ℕ) (s : S), (unfoldTree M γ k s).IsMaxChance := by
  intro k
  induction k with
  | zero => intro s; exact ChanceTree.IsMaxChance.leaf 0
  | succ k ih =>
      intro s
      rw [unfoldTree]
      refine ChanceTree.IsMaxChance.maxNode fun t ht => ?_
      rcases List.mem_map.1 ht with ⟨a, -, rfl⟩
      refine ChanceTree.IsMaxChance.affine ?_
      refine ChanceTree.IsMaxChance.chanceNode fun pt hpt => ?_
      rcases List.mem_map.1 hpt with ⟨s', -, rfl⟩
      exact ih s'

end Cslib.Algorithms.Lean.MarkovDecision.FiniteHorizon
