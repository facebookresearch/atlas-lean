/-
# Recursive CCS process definitions
-/
module

public import CSLibExt.Languages.CCS.StaticOperators
public import Mathlib.Data.List.Dedup

/-!
# Recursive CCS process definitions

This module adds process constants to finite CCS.  A recursive specification
assigns a process body to every constant, and the operational rule for a
constant unfolds its defining body by one transition.  The definition is
relational, so mutually recursive and even unguarded systems are meaningful;
the separate guardedness predicate records Milner's standard discipline for
well-behaved recursive equations.

The presentation follows Robin Milner, *Communication and Concurrency*,
Prentice Hall, 1989, Chapter 4 (ISBN 978-0-13-115007-2).
-/

@[expose] public section

namespace Cslib.CCS.Recursive

open Cslib.CCS

variable {Name Constant : Type*}

/-- **Recursive CCS processes.** Given a set of names and a set of process constants, the
recursive CCS processes are generated by the following constructors: the inactive process
$\mathbf{0}$; a process constant $A$; a prefix $\alpha.P$ for a CCS label $\alpha$ and a
process $P$; a choice $P + Q$; a parallel composition $P \mid Q$; a restriction
$P \setminus L$ for a finite list $L$ of names; and a relabelling $P[f]$ for a CCS
relabelling $f$. -/
inductive Process (Name Constant : Type*) where
  | nil
  | constant (name : Constant)
  | prefix (action : Label Name) (continuation : Process Name Constant)
  | choice (left right : Process Name Constant)
  | parallel (left right : Process Name Constant)
  | restriction (blocked : List Name) (process : Process Name Constant)
  | relabelling (rename : Relabelling Name) (process : Process Name Constant)
  deriving DecidableEq

/-- **Recursive CCS specification.** Given a type of channel names and a type of process constants,
a recursive specification assigns to each process constant $A$ a defining body: a CCS process
expression over those names, which may itself mention process constants (including $A$). -/
abbrev Specification (Name Constant : Type*) := Constant → Process Name Constant

namespace Process

variable [DecidableEq Name]

/-- **Transitions of recursive CCS.** Let the channel names have decidable equality and let
$\Delta$ be a recursive specification, assigning to each process constant $A$ its defining body
$\Delta(A)$. The labelled transition relation $P \xrightarrow{\alpha} P'$ relative to $\Delta$ on
recursive CCS processes, with actions $\alpha$ the CCS labels (silent $\tau$, inputs and outputs),
is the least relation closed under the following rules, where $\alpha.P$ is the prefix, $P + Q$
the choice, $P \mid Q$ the parallel composition, $P \setminus L$ the restriction of $P$ by a
finite list $L$ of channel names, and $P[f]$ the relabelling of $P$ by a finite relabelling $f$.
If $\Delta(A) \xrightarrow{\alpha} P'$, then $A \xrightarrow{\alpha} P'$. The prefix has the
transition $\alpha.P \xrightarrow{\alpha} P$. If $P \xrightarrow{\alpha} P'$, then
$P + Q \xrightarrow{\alpha} P'$, $Q + P \xrightarrow{\alpha} P'$,
$P \mid Q \xrightarrow{\alpha} P' \mid Q$ and $Q \mid P \xrightarrow{\alpha} Q \mid P'$. If
$P \xrightarrow{\alpha} P'$ and $Q \xrightarrow{\beta} Q'$ where $\alpha$ and $\beta$ are
complementary (an input and an output on the same channel), then
$P \mid Q \xrightarrow{\tau} P' \mid Q'$. If $P \xrightarrow{\alpha} P'$ and $\alpha$ is $\tau$ or
its channel is not in $L$, then $P \setminus L \xrightarrow{\alpha} P' \setminus L$. If
$P \xrightarrow{\alpha} P'$, then $P[f] \xrightarrow{f(\alpha)} P'[f]$, where $f(\tau) = \tau$, an
input on a channel $a$ is sent to the visible label $f(a)$ that $f$ assigns to $a$, and an output
on $a$ is sent to the complement of $f(a)$. -/
inductive Step (specification : Specification Name Constant) :
    Process Name Constant → Label Name → Process Name Constant → Prop
  | unfold {constant action next}
      (step : Step specification (specification constant) action next) :
      Step specification (.constant constant) action next
  | prefix (action) (continuation) :
      Step specification (.prefix action continuation) action continuation
  | choiceLeft {left right action next}
      (step : Step specification left action next) :
      Step specification (.choice left right) action next
  | choiceRight {left right action next}
      (step : Step specification right action next) :
      Step specification (.choice left right) action next
  | parallelLeft {left right action next}
      (step : Step specification left action next) :
      Step specification (.parallel left right) action (.parallel next right)
  | parallelRight {left right action next}
      (step : Step specification right action next) :
      Step specification (.parallel left right) action (.parallel left next)
  | communicate {left right left' right' leftAction rightAction}
      (leftStep : Step specification left leftAction left')
      (rightStep : Step specification right rightAction right')
      (complementary : leftAction.Complementary rightAction) :
      Step specification (.parallel left right) .tau (.parallel left' right')
  | restrict {blocked process action next}
      (step : Step specification process action next)
      (allowed : StaticProcess.Allowed blocked action) :
      Step specification (.restriction blocked process) action
        (.restriction blocked next)
  | relabel {rename process action next}
      (step : Step specification process action next) :
      Step specification (.relabelling rename process)
        (StaticProcess.relabelAction rename action) (.relabelling rename next)

/-- **Labelled transition system of a recursive specification.** Assuming equality of names
is decidable, for a recursive specification $\Delta$ the labelled transition system generated
by $\Delta$ has the recursive CCS processes as states and the CCS labels as labels, and its
transitions $P \xrightarrow{\alpha} P'$ are exactly the steps of the structural operational
semantics relative to $\Delta$. -/
def lts (specification : Specification Name Constant) :
    Cslib.LTS (Process Name Constant) (Label Name) :=
  ⟨Step specification⟩

open Cslib.LTS

variable {specification : Specification Name Constant}

theorem nil_no_step {action : Label Name} {next : Process Name Constant} :
    ¬Step specification .nil action next := by
  intro step
  cases step

theorem constant_step_iff {constant : Constant} {action : Label Name}
    {next : Process Name Constant} :
    Step specification (.constant constant) action next ↔
      Step specification (specification constant) action next := by
  constructor
  · intro step
    cases step with
    | unfold bodyStep => exact bodyStep
  · exact Step.unfold

theorem prefix_step_iff {head action : Label Name}
    {continuation next : Process Name Constant} :
    Step specification (.prefix head continuation) action next ↔
      action = head ∧ next = continuation := by
  constructor
  · intro step
    cases step
    exact ⟨rfl, rfl⟩
  · rintro ⟨rfl, rfl⟩
    exact .prefix _ _

theorem choice_step_iff {left right next : Process Name Constant}
    {action : Label Name} :
    Step specification (.choice left right) action next ↔
      Step specification left action next ∨ Step specification right action next := by
  constructor
  · intro step
    cases step with
    | choiceLeft leftStep => exact Or.inl leftStep
    | choiceRight rightStep => exact Or.inr rightStep
  · rintro (step | step)
    · exact .choiceLeft step
    · exact .choiceRight step

theorem parallel_step_iff {left right next : Process Name Constant}
    {action : Label Name} :
    Step specification (.parallel left right) action next ↔
      (∃ left', Step specification left action left' ∧ next = .parallel left' right) ∨
      (∃ right', Step specification right action right' ∧ next = .parallel left right') ∨
      (action = .tau ∧ ∃ leftAction rightAction left' right',
        Step specification left leftAction left' ∧
        Step specification right rightAction right' ∧
        leftAction.Complementary rightAction ∧ next = .parallel left' right') := by
  constructor
  · intro step
    cases step with
    | parallelLeft leftStep => exact Or.inl ⟨_, leftStep, rfl⟩
    | parallelRight rightStep => exact Or.inr (Or.inl ⟨_, rightStep, rfl⟩)
    | communicate leftStep rightStep complementary =>
        exact Or.inr (Or.inr ⟨rfl, _, _, _, _, leftStep, rightStep,
          complementary, rfl⟩)
  · rintro (⟨left', leftStep, rfl⟩ | ⟨right', rightStep, rfl⟩ |
      ⟨rfl, leftAction, rightAction, left', right', leftStep, rightStep,
        complementary, rfl⟩)
    · exact .parallelLeft leftStep
    · exact .parallelRight rightStep
    · exact .communicate leftStep rightStep complementary

theorem restriction_step_iff {blocked : List Name}
    {process next : Process Name Constant} {action : Label Name} :
    Step specification (.restriction blocked process) action next ↔
      ∃ process', Step specification process action process' ∧
        StaticProcess.Allowed blocked action ∧
        next = .restriction blocked process' := by
  constructor
  · intro step
    cases step with
    | restrict bodyStep allowed => exact ⟨_, bodyStep, allowed, rfl⟩
  · rintro ⟨process', bodyStep, allowed, rfl⟩
    exact .restrict bodyStep allowed

theorem relabelling_step_iff {rename : Relabelling Name}
    {process next : Process Name Constant} {action : Label Name} :
    Step specification (.relabelling rename process) action next ↔
      ∃ sourceAction process', Step specification process sourceAction process' ∧
        action = StaticProcess.relabelAction rename sourceAction ∧
        next = .relabelling rename process' := by
  constructor
  · intro step
    cases step with
    | relabel bodyStep => exact ⟨_, _, bodyStep, rfl, rfl⟩
  · rintro ⟨sourceAction, process', bodyStep, rfl, rfl⟩
    exact .relabel bodyStep

/-- **Guardedness under a prefix flag.** For a Boolean flag $b$, recording whether an action
prefix has already been crossed, guardedness of a recursive CCS process under $b$ is defined
recursively: the inactive process $\mathbf{0}$ is guarded under $b$; a constant $A$ is guarded
under $b$ exactly when $b$ is true; a prefix $\alpha.Q$ is guarded under $b$ when $Q$ is guarded
under true; a choice $Q + R$ or a parallel composition $Q \mid R$ is guarded under $b$ when
both $Q$ and $R$ are; and a restriction $Q \setminus L$ or a relabelling $Q[f]$ is guarded
under $b$ when $Q$ is.

Thus under the flag false a process is guarded exactly when every constant occurrence lies
beneath an action prefix. Static operators and parallel/choice contexts do not themselves
guard recursion. -/
def GuardedUnder (beneathPrefix : Bool) : Process Name Constant → Prop
  | .nil => True
  | .constant _ => beneathPrefix = true
  | .prefix _ continuation => GuardedUnder true continuation
  | .choice left right | .parallel left right =>
      GuardedUnder beneathPrefix left ∧ GuardedUnder beneathPrefix right
  | .restriction _ process | .relabelling _ process =>
      GuardedUnder beneathPrefix process

/-- **Guarded process.** A recursive CCS process is guarded when all of its constant
occurrences lie beneath an action prefix. -/
def Guarded (process : Process Name Constant) : Prop := GuardedUnder false process

@[simp] theorem guardedUnder_nil (beneathPrefix : Bool) :
    GuardedUnder beneathPrefix (.nil : Process Name Constant) := trivial

@[simp] theorem guardedUnder_constant {beneathPrefix : Bool} {constant : Constant} :
    GuardedUnder beneathPrefix (.constant constant : Process Name Constant) ↔
      beneathPrefix = true := Iff.rfl

@[simp] theorem guardedUnder_prefix (beneathPrefix : Bool) (action : Label Name)
    (continuation : Process Name Constant) :
    GuardedUnder beneathPrefix (.prefix action continuation) ↔
      GuardedUnder true continuation := Iff.rfl

@[simp] theorem guardedUnder_choice (beneathPrefix : Bool)
    (left right : Process Name Constant) :
    GuardedUnder beneathPrefix (.choice left right) ↔
      GuardedUnder beneathPrefix left ∧ GuardedUnder beneathPrefix right := Iff.rfl

@[simp] theorem guardedUnder_parallel (beneathPrefix : Bool)
    (left right : Process Name Constant) :
    GuardedUnder beneathPrefix (.parallel left right) ↔
      GuardedUnder beneathPrefix left ∧ GuardedUnder beneathPrefix right := Iff.rfl

@[simp] theorem guardedUnder_restriction (beneathPrefix : Bool) (blocked : List Name)
    (process : Process Name Constant) :
    GuardedUnder beneathPrefix (.restriction blocked process) ↔
      GuardedUnder beneathPrefix process := Iff.rfl

@[simp] theorem guardedUnder_relabelling (beneathPrefix : Bool) (rename : Relabelling Name)
    (process : Process Name Constant) :
    GuardedUnder beneathPrefix (.relabelling rename process) ↔
      GuardedUnder beneathPrefix process := Iff.rfl

theorem guarded_prefix (action : Label Name) (continuation : Process Name Constant) :
    Guarded (.prefix action continuation) := by
  simp only [Guarded, guardedUnder_prefix]
  induction continuation with
  | nil => trivial
  | constant => rfl
  | «prefix» action continuation ih => exact ih
  | choice left right ihLeft ihRight => exact ⟨ihLeft, ihRight⟩
  | parallel left right ihLeft ihRight => exact ⟨ihLeft, ihRight⟩
  | restriction blocked process ih => exact ih
  | relabelling rename process ih => exact ih

/-- **Every process is guarded beneath a prefix.** Every recursive CCS process $P$ is guarded
under the flag $\mathrm{true}$: once an action prefix has been crossed, every constant
occurrence counts as guarded. -/
theorem guardedUnder_true (process : Process Name Constant) : GuardedUnder true process := by
  induction process with
  | nil => trivial
  | constant => rfl
  | «prefix» action continuation ih => exact ih
  | choice left right ihLeft ihRight => exact ⟨ihLeft, ihRight⟩
  | parallel left right ihLeft ihRight => exact ⟨ihLeft, ihRight⟩
  | restriction blocked process ih => exact ih
  | relabelling rename process ih => exact ih

theorem not_guarded_constant (constant : Constant) :
    ¬Guarded (.constant constant : Process Name Constant) := by
  simp [Guarded]

/-- **Constant occurrences of a process.** The constant occurrences of a recursive CCS
process $P$ are the list of the process constants occurring in $P$, from left to right and
with repetitions: the inactive process $\mathbf{0}$ has none; a constant $A$ has the single
occurrence $A$; a prefix $\alpha.Q$, a restriction $Q \setminus L$ and a relabelling $Q[f]$
have the occurrences of $Q$; and a choice $Q + R$ or a parallel composition $Q \mid R$ has
the occurrences of $Q$ followed by those of $R$. -/
def constantOccurrences : Process Name Constant → List Constant
  | .nil => []
  | .constant name => [name]
  | .prefix _ continuation => constantOccurrences continuation
  | .choice left right | .parallel left right =>
      constantOccurrences left ++ constantOccurrences right
  | .restriction _ process | .relabelling _ process => constantOccurrences process

/-- **Constants of a process.** Assuming equality of process constants is decidable, the
constants of a recursive CCS process $P$ are the list obtained from the constant occurrences
of $P$ by removing duplicates, so that every process constant occurring in $P$ appears in it
exactly once. -/
def constants [DecidableEq Constant] (process : Process Name Constant) : List Constant :=
  (constantOccurrences process).dedup

@[simp] theorem mem_constants_nil [DecidableEq Constant] {query : Constant} :
    query ∈ constants (.nil : Process Name Constant) ↔ False := by
  simp [constants, constantOccurrences]

@[simp] theorem mem_constants_constant [DecidableEq Constant]
    {query constant : Constant} :
    query ∈ constants (.constant constant : Process Name Constant) ↔
      query = constant := by
  simp [constants, constantOccurrences]

@[simp] theorem mem_constants_prefix [DecidableEq Constant] {query : Constant}
    {action : Label Name} {continuation : Process Name Constant} :
    query ∈ constants (.prefix action continuation) ↔ query ∈ constants continuation := by
  simp [constants, constantOccurrences]

@[simp] theorem mem_constants_choice [DecidableEq Constant] {query : Constant}
    {left right : Process Name Constant} :
    query ∈ constants (.choice left right) ↔
      query ∈ constants left ∨ query ∈ constants right := by
  simp [constants, constantOccurrences]

@[simp] theorem mem_constants_parallel [DecidableEq Constant] {query : Constant}
    {left right : Process Name Constant} :
    query ∈ constants (.parallel left right) ↔
      query ∈ constants left ∨ query ∈ constants right := by
  simp [constants, constantOccurrences]

@[simp] theorem mem_constants_restriction [DecidableEq Constant] {query : Constant}
    {blocked : List Name} {process : Process Name Constant} :
    query ∈ constants (.restriction blocked process) ↔ query ∈ constants process := by
  simp [constants, constantOccurrences]

@[simp] theorem mem_constants_relabelling [DecidableEq Constant] {query : Constant}
    {rename : Relabelling Name} {process : Process Name Constant} :
    query ∈ constants (.relabelling rename process) ↔ query ∈ constants process := by
  simp [constants, constantOccurrences]

theorem constants_nodup [DecidableEq Constant] (process : Process Name Constant) :
    (constants process).Nodup := by
  exact List.nodup_dedup (constantOccurrences process)

/-- **Renaming process constants.** Given a map $\rho$ from one set of process constants to
another, renaming the constants of a recursive CCS process $P$ by $\rho$ replaces each
occurrence of a constant $A$ by $\rho(A)$ and leaves $P$ otherwise unchanged: the inactive
process, prefixes, choices, parallel compositions, restrictions and relabellings are kept as
they are. -/
def mapConstants {Other : Type*} (rename : Constant → Other) :
    Process Name Constant → Process Name Other
  | .nil => .nil
  | .constant name => .constant (rename name)
  | .prefix action continuation => .prefix action (mapConstants rename continuation)
  | .choice left right => .choice (mapConstants rename left) (mapConstants rename right)
  | .parallel left right => .parallel (mapConstants rename left) (mapConstants rename right)
  | .restriction blocked process => .restriction blocked (mapConstants rename process)
  | .relabelling relabel process => .relabelling relabel (mapConstants rename process)

@[simp] theorem mapConstants_nil {Other : Type*} (rename : Constant → Other) :
    mapConstants rename (.nil : Process Name Constant) = .nil := rfl

@[simp] theorem mapConstants_constant {Other : Type*} (rename : Constant → Other)
    (constant : Constant) :
    mapConstants rename (.constant constant : Process Name Constant) =
      .constant (rename constant) := rfl

@[simp] theorem mapConstants_prefix {Other : Type*} (rename : Constant → Other)
    (action : Label Name) (continuation : Process Name Constant) :
    mapConstants rename (.prefix action continuation) =
      .prefix action (mapConstants rename continuation) := rfl

@[simp] theorem mapConstants_choice {Other : Type*} (rename : Constant → Other)
    (left right : Process Name Constant) :
    mapConstants rename (.choice left right) =
      .choice (mapConstants rename left) (mapConstants rename right) := rfl

@[simp] theorem mapConstants_parallel {Other : Type*} (rename : Constant → Other)
    (left right : Process Name Constant) :
    mapConstants rename (.parallel left right) =
      .parallel (mapConstants rename left) (mapConstants rename right) := rfl

@[simp] theorem mapConstants_restriction {Other : Type*} (rename : Constant → Other)
    (blocked : List Name) (process : Process Name Constant) :
    mapConstants rename (.restriction blocked process) =
      .restriction blocked (mapConstants rename process) := rfl

@[simp] theorem mapConstants_relabelling {Other : Type*} (rename : Constant → Other)
    (relabel : Relabelling Name) (process : Process Name Constant) :
    mapConstants rename (.relabelling relabel process) =
      .relabelling relabel (mapConstants rename process) := rfl

@[simp] theorem mapConstants_id (process : Process Name Constant) :
    mapConstants id process = process := by
  induction process <;> simp_all [mapConstants]

theorem mapConstants_comp {Middle Other : Type*} (first : Constant → Middle)
    (second : Middle → Other) (process : Process Name Constant) :
    mapConstants second (mapConstants first process) =
      mapConstants (second ∘ first) process := by
  induction process <;> simp_all [mapConstants, Function.comp_apply]

/-- **Renaming constants preserves guardedness.** Let $P$ be a recursive CCS process, let
$\rho$ be a map from its process constants to another set of constants, and let $P\rho$ be
the process obtained from $P$ by renaming its constants by $\rho$. Then for each Boolean flag
$b$, $P\rho$ is guarded under $b$ if and only if $P$ is guarded under $b$. -/
theorem guardedUnder_mapConstants {Other : Type*} (rename : Constant → Other)
    (beneathPrefix : Bool) (process : Process Name Constant) :
    GuardedUnder beneathPrefix (mapConstants rename process) ↔
      GuardedUnder beneathPrefix process := by
  cases beneathPrefix
  · induction process <;>
      simp_all [mapConstants, GuardedUnder, guardedUnder_true]
  · exact ⟨fun _ => guardedUnder_true _, fun _ => guardedUnder_true _⟩

theorem guarded_mapConstants {Other : Type*} (rename : Constant → Other)
    (process : Process Name Constant) :
    Guarded (mapConstants rename process) ↔ Guarded process := by
  exact guardedUnder_mapConstants rename false process

end Process

namespace Specification

/-- **Guarded recursive specification.** A recursive specification $\Delta$, which assigns
to each process constant $A$ a body $\Delta(A)$, is guarded when for every constant $A$ the
body $\Delta(A)$ is a guarded process. -/
def Guarded (specification : Specification Name Constant) : Prop :=
  ∀ constant, Process.Guarded (specification constant)

end Specification

end Cslib.CCS.Recursive
