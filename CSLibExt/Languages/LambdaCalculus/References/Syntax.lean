/-
# The simply typed lambda calculus with references: syntax
-/
module

public import Mathlib.Data.List.Basic

/-!
# The simply typed lambda calculus with references: syntax

This file defines the syntax of the simply typed lambda calculus with mutable
references of Pierce, *Types and Programming Languages* (MIT Press, 2002),
Chapter 13, Figure 13-1: function types, `Unit`, and reference types `Ref T`,
with allocation `ref t`, dereferencing `!t`, assignment `t₁ := t₂`, and store
locations `l`. Base types are a parameter, as in the de Bruijn STLC in
`../DeBruijn/Stlc/`.

Terms are extrinsically typed and use de Bruijn indices for variables. Store
locations are natural numbers indexing the store; they are not variables, so
renaming and substitution leave them unchanged. Renaming and substitution are
parallel (simultaneous) operations given by functions on indices.
-/

@[expose] public section

namespace Cslib.Languages.LambdaCalculus.References

universe u

/-- **Types of the simply typed lambda calculus with references.** Fix a type $B$ of base types.
The types over $B$ are generated by the grammar
$T ::= b \mid \mathsf{Unit} \mid T_1 \to T_2 \mid \mathsf{Ref}\,T$ with $b \in B$: base types,
the unit type, function types, and types $\mathsf{Ref}\,T$ of reference cells holding values of
type $T$. -/
inductive Ty (Base : Type u) where
  /-- An uninterpreted base type. -/
  | base : Base → Ty Base
  /-- The unit type. -/
  | unit : Ty Base
  /-- Function types. -/
  | arr : Ty Base → Ty Base → Ty Base
  /-- Reference cells holding values of the given type. -/
  | ref : Ty Base → Ty Base
  deriving DecidableEq, Repr

/-- **Terms of the simply typed lambda calculus with references.** Fix a type $B$ of base types.
The terms are generated by: variables, given as de Bruijn indices $x \in \mathbb{N}$;
abstractions $\lambda{:}T.\,t$, where $T$ is a type over $B$ and $t$ is a term in which index $0$
refers to the abstraction's parameter; applications $t_1\,t_2$; the unit value $\mathsf{unit}$;
store locations $l \in \mathbb{N}$; allocations $\mathsf{ref}\,t$; dereferences $!t$; and
assignments $t_1 := t_2$.

Store locations arise during evaluation, not in source programs. -/
inductive Term (Base : Type u) where
  /-- A de Bruijn variable. -/
  | var : Nat → Term Base
  /-- A lambda abstraction annotated with its parameter type. -/
  | lam : Ty Base → Term Base → Term Base
  /-- Application. -/
  | app : Term Base → Term Base → Term Base
  /-- The unit value. -/
  | unit : Term Base
  /-- A store location. Locations arise during evaluation, not in source
  programs. -/
  | loc : Nat → Term Base
  /-- Allocation of a fresh reference cell, `ref t`. -/
  | ref : Term Base → Term Base
  /-- Dereferencing, `!t`. -/
  | deref : Term Base → Term Base
  /-- Assignment, `t₁ := t₂`. -/
  | assign : Term Base → Term Base → Term Base
  deriving DecidableEq, Repr

variable {Base : Type u}

namespace Term

/-- **Values of the simply typed lambda calculus with references.** A term is a value if and only
if it is an abstraction $\lambda{:}T.\,t$, the unit value $\mathsf{unit}$, or a store location
$l$. -/
inductive Value : Term Base → Prop
  | lam (T : Ty Base) (body : Term Base) : Value (.lam T body)
  | unit : Value .unit
  | loc (l : Nat) : Value (.loc l)

/-- **Lifting a renaming under a binder in the lambda calculus with references.** Given a
renaming $\rho : \mathbb{N} \to \mathbb{N}$ of de Bruijn indices, its lift is the renaming that
sends $0$ to $0$ and each $x + 1$ to $\rho(x) + 1$. -/
def liftRen (ρ : Nat → Nat) : Nat → Nat
  | 0 => 0
  | x + 1 => ρ x + 1

/-- **Renaming the variables of a term.** Given a renaming $\rho : \mathbb{N} \to \mathbb{N}$ of
de Bruijn indices, renaming a term by $\rho$ replaces each variable $x$ by $\rho(x)$; renames
the body of an abstraction $\lambda{:}T.\,t$ by the lift of $\rho$ (which sends $0$ to $0$ and
each $x + 1$ to $\rho(x) + 1$), keeping the type annotation $T$; leaves the unit value and store
locations unchanged; and acts componentwise on applications, allocations, dereferences and
assignments. -/
def rename : (Nat → Nat) → Term Base → Term Base
  | ρ, .var x => .var (ρ x)
  | ρ, .lam T body => .lam T (rename (liftRen ρ) body)
  | ρ, .app f a => .app (rename ρ f) (rename ρ a)
  | _, .unit => .unit
  | _, .loc l => .loc l
  | ρ, .ref t => .ref (rename ρ t)
  | ρ, .deref t => .deref (rename ρ t)
  | ρ, .assign t₁ t₂ => .assign (rename ρ t₁) (rename ρ t₂)

/-- **Lifting a substitution under a binder.** Given a substitution $\sigma$ assigning a term to
each de Bruijn index, its lift is the substitution that sends $0$ to the variable $0$ and each
$x + 1$ to the term $\sigma(x)$ renamed by $n \mapsto n + 1$, that is, with every free variable
raised by one. -/
def liftSub (σ : Nat → Term Base) : Nat → Term Base
  | 0 => .var 0
  | x + 1 => rename Nat.succ (σ x)

/-- **Parallel substitution in a term.** Given a substitution $\sigma$ assigning a term to each
de Bruijn index, substituting $\sigma$ into a term replaces each variable $x$ by $\sigma(x)$;
substitutes into the body of an abstraction $\lambda{:}T.\,t$ the lift of $\sigma$ (which sends
$0$ to the variable $0$ and each $x + 1$ to $\sigma(x)$ with every free variable raised by one),
keeping the type annotation $T$; leaves the unit value and store locations unchanged; and acts
componentwise on applications, allocations, dereferences and assignments. -/
def subst : (Nat → Term Base) → Term Base → Term Base
  | σ, .var x => σ x
  | σ, .lam T body => .lam T (subst (liftSub σ) body)
  | σ, .app f a => .app (subst σ f) (subst σ a)
  | _, .unit => .unit
  | _, .loc l => .loc l
  | σ, .ref t => .ref (subst σ t)
  | σ, .deref t => .deref (subst σ t)
  | σ, .assign t₁ t₂ => .assign (subst σ t₁) (subst σ t₂)

/-- **Single-variable substitution at index zero.** For a term $s$, the single-variable
substitution for $s$ sends the de Bruijn index $0$ to $s$ and each index $x + 1$ to the
variable $x$. -/
def singleSub (s : Term Base) : Nat → Term Base
  | 0 => s
  | x + 1 => .var x

/-- **Substitution of a term for variable zero.** For terms $t$ and $s$, the instantiation of $t$
by $s$ applies to $t$ the parallel substitution that sends the de Bruijn index $0$ to $s$ and
each index $x + 1$ to the variable $x$. Thus the free occurrences of variable $0$ in $t$ are
replaced by $s$, with the free variables of $s$ raised by the number of binders crossed, and
every other free variable of $t$ is lowered by one.

This is the substitution of β-reduction, written $\uparrow^{-1}([0 \mapsto \uparrow^1 s]\,t)$ in
TAPL Section 6.3; TAPL's $[0 \mapsto s]\,t$ alone does not lower the other free variables. -/
def instantiate (t s : Term Base) : Term Base :=
  subst (singleSub s) t

@[simp] theorem liftRen_zero (ρ : Nat → Nat) : liftRen ρ 0 = 0 := rfl

@[simp] theorem liftRen_succ (ρ : Nat → Nat) (x : Nat) :
    liftRen ρ (x + 1) = ρ x + 1 := rfl

@[simp] theorem liftSub_zero (σ : Nat → Term Base) : liftSub σ 0 = .var 0 := rfl

@[simp] theorem liftSub_succ (σ : Nat → Term Base) (x : Nat) :
    liftSub σ (x + 1) = rename Nat.succ (σ x) := rfl

@[simp] theorem singleSub_zero (s : Term Base) : singleSub s 0 = s := rfl

@[simp] theorem singleSub_succ (s : Term Base) (x : Nat) :
    singleSub s (x + 1) = .var x := rfl

end Term

end Cslib.Languages.LambdaCalculus.References
