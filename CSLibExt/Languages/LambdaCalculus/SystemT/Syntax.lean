module

public import CSLibExt.Languages.LambdaCalculus.DeBruijn.Stlc.Syntax

/-!
# System T: syntax and substitution

Gödel's System T in the presentation of Girard, Lafont and Taylor (*Proofs and Types*, CUP 1989,
Chapter 7, §7.1.1-§7.1.2), restricted to the type of natural numbers and function types: the
simply typed λ-calculus with the term formers `zero`, `succ t` and the recursor `natRec u v t`
(Girard's $\mathsf{R}\,u\,v\,t$) at every type. The Booleans with their eliminator and the product
types of Girard's presentation are omitted. The recursor is a term former, as in Girard and in
Sørensen and Urzyczyn (*Lectures on the Curry-Howard Isomorphism*, 1998, Definition 11.6.1), not
a family of constants.

Types, variables and renamings are those of the intrinsically typed de Bruijn STLC in
`../DeBruijn/Stlc/`, with the single base type `nat := .base ()`, as for PCF; the term type
`Tm Γ A` adds the System T term formers, so typing is the index of `Tm` and ill-typed terms
cannot be written. Renaming and parallel substitution follow the STLC and PCF developments,
together with the substitution algebra the reduction theory uses.

## References

* J.-Y. Girard, Y. Lafont, P. Taylor, *Proofs and Types*, Cambridge University Press, 1989,
  Chapter 7: §7.1.1 (types), §7.1.2 (terms), §7.3.2 (numerals).
* M. H. Sørensen, P. Urzyczyn, *Lectures on the Curry-Howard Isomorphism*, 1998,
  Definition 11.6.1.
-/

@[expose] public section

namespace Cslib.Languages.LambdaCalculus.SystemT

open scoped CslibStlc

-- The simple types `A ::= nat | A ⇒ A` over the single base type `nat`; see `Stlc.Ty`.
abbrev Ty := Stlc.Ty Unit

-- The base type `nat` of natural numbers, `Stlc.Ty.base ()`; see `Stlc.Ty`.
abbrev Ty.nat : Ty := .base ()

-- The typed de Bruijn variables of the simply typed λ-calculus at these types; see `Stlc.Var`.
abbrev Var := @Stlc.Var Unit

/-- **System T terms.** Write $\mathsf{nat}$ for the type of natural numbers and $A \Rightarrow B$
for the type of functions from $A$ to $B$. The intrinsically typed terms of type $A$ in a
context $\Gamma$ (a list of types) are generated by the following rules: every variable of type
$A$ in $\Gamma$ is a term of type $A$; if $t$ has type $B$ in the context $\Gamma$ extended by a
newest variable of type $A$, then $\lambda t$ has type $A \Rightarrow B$; if $f$ has type
$A \Rightarrow B$ and $a$ has type $A$, then $f\,a$ has type $B$; $\mathsf{zero}$ has type
$\mathsf{nat}$; if $t$ has type $\mathsf{nat}$, so does $\mathsf{succ}\,t$; and if $u$ has type
$A$, $v$ has type $A \Rightarrow \mathsf{nat} \Rightarrow A$ and $t$ has type $\mathsf{nat}$,
then the recursor $\mathsf{R}\,u\,v\,t$, written `natRec u v t`, has type $A$
(Girard-Lafont-Taylor §7.1.2, Sørensen-Urzyczyn Definition 11.6.1). -/
inductive Tm : List Ty → Ty → Type where
  | var {Γ : List Ty} {A : Ty} : Var Γ A → Tm Γ A
  | lam {Γ : List Ty} {A B : Ty} : Tm (A :: Γ) B → Tm Γ (A ⇒ B)
  | app {Γ : List Ty} {A B : Ty} : Tm Γ (A ⇒ B) → Tm Γ A → Tm Γ B
  | zero {Γ : List Ty} : Tm Γ .nat
  | succ {Γ : List Ty} : Tm Γ .nat → Tm Γ .nat
  /-- `natRec u v t` is primitive recursion on `t` at type `A`: `u` is the value at zero and `v`
  takes the value at `n` and then `n` to the value at the successor of `n`. -/
  | natRec {Γ : List Ty} {A : Ty} : Tm Γ A → Tm Γ (A ⇒ Ty.nat ⇒ A) → Tm Γ .nat → Tm Γ A

-- The renamings of the simply typed λ-calculus at these types; see `Stlc.Ren`.
abbrev Ren (Γ Δ : List Ty) := Stlc.Ren Γ Δ

/-- **Parallel substitutions for System T.** A substitution from a context $\Gamma$ to a context
$\Delta$ assigns to every variable of $\Gamma$, of any type $A$, a term of type $A$ in context
$\Delta$. -/
abbrev Sub (Γ Δ : List Ty) := ∀ {A}, Var Γ A → Tm Δ A

namespace Tm

/-- **System T numerals.** For every context $\Gamma$ and natural number $n$, the numeral of $n$
is the term $\mathsf{succ}^n(\mathsf{zero})$ of type $\mathsf{nat}$ in $\Gamma$
(Girard-Lafont-Taylor §7.3.2). -/
def numeral {Γ : List Ty} : Nat → Tm Γ .nat
  | 0 => .zero
  | n + 1 => .succ (numeral n)

/-- **Numeral of zero.** The numeral of $0$ is $\mathsf{zero}$. -/
@[simp] theorem numeral_zero {Γ : List Ty} : (numeral 0 : Tm Γ .nat) = .zero :=
  rfl

/-- **Numeral of a successor.** The numeral of $n + 1$ is the successor of the numeral of $n$. -/
@[simp] theorem numeral_succ {Γ : List Ty} (n : Nat) :
    (numeral (n + 1) : Tm Γ .nat) = .succ (numeral n) :=
  rfl

/-- **Injectivity of numerals.** In every context, distinct natural numbers have distinct
numerals. -/
theorem numeral_injective {Γ : List Ty} : Function.Injective (numeral : Nat → Tm Γ .nat) :=
  by
    intro m n h
    induction m generalizing n with
    | zero => cases n <;> simp_all [numeral]
    | succ m ih =>
        cases n with
        | zero => simp [numeral] at h
        | succ n =>
            simp only [numeral_succ, Tm.succ.injEq] at h
            rw [ih h]

/-- **Renaming of System T terms.** Given a renaming $\rho$ from a context $\Gamma$ to a context
$\Delta$, the renaming along $\rho$ of a term of type $A$ in context $\Gamma$ is the term of type
$A$ in context $\Delta$ obtained by replacing each variable $x$ by $\rho(x)$. Under a
$\lambda$-binder, $\rho$ is replaced by its lift. Renaming leaves zero unchanged and commutes with
application, successor and the recursor. -/
def rename : {Γ Δ : List Ty} → Ren Γ Δ → {A : Ty} → Tm Γ A → Tm Δ A
  | _, _, ρ, _, .var x => .var (ρ x)
  | _, _, ρ, _, .lam body => .lam (rename (Stlc.Var.lift ρ) body)
  | _, _, ρ, _, .app f a => .app (rename ρ f) (rename ρ a)
  | _, _, _, _, .zero => .zero
  | _, _, ρ, _, .succ t => .succ (rename ρ t)
  | _, _, ρ, _, .natRec u v t => .natRec (rename ρ u) (rename ρ v) (rename ρ t)

/-- **Weakening of System T terms.** Weakening sends a term of type $A$ in context $\Gamma$ to the
term of type $A$ in the context obtained by prepending a variable of type $B$ to $\Gamma$. Each
variable occurrence that refers to $\Gamma$ has its de Bruijn index shifted up by one; an
occurrence bound inside the term keeps its index, since renaming lifts the shift under each
$\lambda$-binder and the lift fixes the newest variable. -/
def weaken {Γ : List Ty} {A B : Ty} (t : Tm Γ A) : Tm (B :: Γ) A := rename .succ t

/-- **Renaming a variable.** Renaming a variable $x$ along $\rho$ gives the variable $\rho(x)$. -/
@[simp] theorem rename_var {Γ Δ : List Ty} {A : Ty} (ρ : Ren Γ Δ) (x : Var Γ A) :
    rename ρ (.var x) = .var (ρ x) :=
  rfl

/-- **Renaming an abstraction.** Renaming an abstraction renames its body along the lift. -/
@[simp] theorem rename_lam {Γ Δ : List Ty} {A B : Ty} (ρ : Ren Γ Δ) (body : Tm (A :: Γ) B) :
    rename ρ (.lam body) = .lam (rename (Stlc.Var.lift ρ) body) :=
  rfl

/-- **Renaming an application.** Renaming commutes with application. -/
@[simp] theorem rename_app {Γ Δ : List Ty} {A B : Ty} (ρ : Ren Γ Δ) (f : Tm Γ (A ⇒ B))
    (a : Tm Γ A) : rename ρ (.app f a) = .app (rename ρ f) (rename ρ a) :=
  rfl

/-- **Renaming zero.** Renaming leaves $\mathsf{zero}$ unchanged. -/
@[simp] theorem rename_zero {Γ Δ : List Ty} (ρ : Ren Γ Δ) :
    rename ρ (.zero : Tm Γ .nat) = .zero :=
  rfl

/-- **Renaming a successor.** Renaming commutes with the successor. -/
@[simp] theorem rename_succ {Γ Δ : List Ty} (ρ : Ren Γ Δ) (t : Tm Γ .nat) :
    rename ρ (.succ t) = .succ (rename ρ t) :=
  rfl

/-- **Renaming a recursor.** Renaming commutes with the recursor. -/
@[simp] theorem rename_natRec {Γ Δ : List Ty} {A : Ty} (ρ : Ren Γ Δ) (u : Tm Γ A)
    (v : Tm Γ (A ⇒ Ty.nat ⇒ A)) (t : Tm Γ .nat) :
    rename ρ (.natRec u v t) = .natRec (rename ρ u) (rename ρ v) (rename ρ t) :=
  rfl

/-- **Renaming respects pointwise equality.** Renamings that agree on every variable rename every
term identically. -/
theorem rename_congr {Γ Δ : List Ty} {A : Ty} {ρ ρ' : Ren Γ Δ}
    (h : ∀ {B} (x : Var Γ B), ρ x = ρ' x) (t : Tm Γ A) : rename ρ t = rename ρ' t :=
  by
    induction t generalizing Δ with
    | var x => simp [h]
    | lam body ih =>
        simp only [rename]
        congr 1
        apply ih
        intro C x
        cases x with
        | zero => rfl
        | succ x => simp [h]
    | app f a ihf iha => simp [ihf h, iha h]
    | zero => rfl
    | succ t ih => simp [ih h]
    | natRec u v t ihu ihv iht => simp [ihu h, ihv h, iht h]

/-- **Renaming by the identity.** Renaming a term along the identity renaming gives the term. -/
@[simp] theorem rename_id {Γ : List Ty} {A : Ty} (t : Tm Γ A) :
    rename (Stlc.Var.id : Ren Γ Γ) t = t :=
  by
    induction t with
    | var => rfl
    | lam body ih =>
        simp only [rename_lam]
        congr 1
        rw [rename_congr (ρ' := Stlc.Var.id) (fun x => Stlc.Var.lift_id_apply x)]
        exact ih
    | app f a ihf iha => simp [ihf, iha]
    | zero => rfl
    | succ t ih => simp [ih]
    | natRec u v t ihu ihv iht => simp [ihu, ihv, iht]

/-- **Composition of renamings.** Renaming along $\rho$ and then along $\rho'$ is renaming along
the composite $x \mapsto \rho'(\rho(x))$. -/
theorem rename_rename {Γ Δ Ξ : List Ty} {A : Ty} (ρ : Ren Γ Δ) (ρ' : Ren Δ Ξ) (t : Tm Γ A) :
    rename ρ' (rename ρ t) = rename (fun x => ρ' (ρ x)) t :=
  by
    induction t generalizing Δ Ξ with
    | var => rfl
    | lam body ih =>
        simp only [rename]
        congr 1
        rw [ih]
        apply rename_congr
        intro C x
        cases x <;> rfl
    | app f a ihf iha => simp [ihf, iha]
    | zero => rfl
    | succ t ih => simp [ih]
    | natRec u v t ihu ihv iht => simp [ihu, ihv, iht]

/-- **Renaming a numeral.** Renaming leaves every numeral unchanged. -/
@[simp] theorem rename_numeral {Γ Δ : List Ty} (ρ : Ren Γ Δ) (n : Nat) :
    rename ρ (numeral n : Tm Γ .nat) = numeral n :=
  by
    induction n with
    | zero => rfl
    | succ n ih => simp [ih]

end Tm

namespace Sub

/-- **Identity substitution.** The identity substitution sends each variable $x$ to the term
consisting of $x$ alone. -/
def id {Γ : List Ty} : Sub Γ Γ := fun x => .var x

/-- **Lifting a substitution under a binder.** Given a substitution $\sigma$ from $\Gamma$ to
$\Delta$ and a type $A$, the lift of $\sigma$ goes from $\Gamma$ extended by a newest variable of
type $A$ to $\Delta$ extended by a newest variable of type $A$: it sends the newest variable to
the newest variable and every older variable $x$ to the weakening of $\sigma(x)$. -/
def lift {Γ Δ : List Ty} {A : Ty} (σ : Sub Γ Δ) : Sub (A :: Γ) (A :: Δ)
  | _, .zero => .var .zero
  | _, .succ x => Tm.weaken (σ x)

/-- **Single-variable substitution.** For a term $a$ of type $A$ in $\Gamma$, this substitution
from $\Gamma$ extended by a newest variable of type $A$ to $\Gamma$ sends the newest variable to
$a$ and each older variable to itself. -/
def single {Γ : List Ty} {A : Ty} (a : Tm Γ A) : Sub (A :: Γ) Γ
  | _, .zero => a
  | _, .succ x => .var x

/-- **Extending a substitution by a term.** Given a substitution $\sigma$ from $\Gamma$ to
$\Delta$ and a term $a$ of type $A$ in $\Delta$, the extension goes from $\Gamma$ extended by a
newest variable of type $A$ to $\Delta$: it sends the newest variable to $a$ and every older
variable $x$ to $\sigma(x)$. -/
def cons {Γ Δ : List Ty} {A : Ty} (a : Tm Δ A) (σ : Sub Γ Δ) : Sub (A :: Γ) Δ
  | _, .zero => a
  | _, .succ x => σ x

/-- **Lift at the newest variable.** A lifted substitution sends the newest variable to itself. -/
@[simp] theorem lift_zero {Γ Δ : List Ty} {A : Ty} (σ : Sub Γ Δ) :
    lift (A := A) σ .zero = .var .zero :=
  rfl

/-- **Lift at an older variable.** A lifted substitution sends the successor of $x$ to the
weakening of $\sigma(x)$. -/
@[simp] theorem lift_succ {Γ Δ : List Ty} {A B : Ty} (σ : Sub Γ Δ) (x : Var Γ B) :
    lift (A := A) σ (.succ x) = Tm.weaken (σ x) :=
  rfl

/-- **Single substitution at the newest variable.** It sends the newest variable to $a$. -/
@[simp] theorem single_zero {Γ : List Ty} {A : Ty} (a : Tm Γ A) : single a .zero = a :=
  rfl

/-- **Single substitution at an older variable.** It sends the successor of $x$ to $x$. -/
@[simp] theorem single_succ {Γ : List Ty} {A B : Ty} (a : Tm Γ A) (x : Var Γ B) :
    single a (.succ x) = .var x :=
  rfl

/-- **Extension at the newest variable.** It sends the newest variable to $a$. -/
@[simp] theorem cons_zero {Γ Δ : List Ty} {A : Ty} (a : Tm Δ A) (σ : Sub Γ Δ) :
    cons a σ .zero = a :=
  rfl

/-- **Extension at an older variable.** It sends the successor of $x$ to $\sigma(x)$. -/
@[simp] theorem cons_succ {Γ Δ : List Ty} {A B : Ty} (a : Tm Δ A) (σ : Sub Γ Δ) (x : Var Γ B) :
    cons a σ (.succ x) = σ x :=
  rfl

end Sub

namespace Tm

/-- **Substitution in System T terms.** Given a substitution $\sigma$ from $\Gamma$ to $\Delta$,
applying $\sigma$ to a term of type $A$ in context $\Gamma$ gives the term of type $A$ in context
$\Delta$ obtained by replacing each variable $x$ by $\sigma(x)$, with $\sigma$ lifted under a
$\lambda$-binder. Substitution leaves zero unchanged and commutes with application, successor and
the recursor. All variables are replaced simultaneously, and since variables are de Bruijn
indices the substitution is capture-avoiding. -/
def subst : {Γ Δ : List Ty} → Sub Γ Δ → {A : Ty} → Tm Γ A → Tm Δ A
  | _, _, σ, _, .var x => σ x
  | _, _, σ, _, .lam body => .lam (subst (Sub.lift σ) body)
  | _, _, σ, _, .app f a => .app (subst σ f) (subst σ a)
  | _, _, _, _, .zero => .zero
  | _, _, σ, _, .succ t => .succ (subst σ t)
  | _, _, σ, _, .natRec u v t => .natRec (subst σ u) (subst σ v) (subst σ t)

/-- **Instantiating the newest variable.** Given a term $b$ of type $B$ in $\Gamma$ extended by a
newest variable of type $A$, and a term $a$ of type $A$ in $\Gamma$, the instantiation of $b$ with
$a$ applies to $b$ the single-variable substitution of $a$. -/
def instantiate {Γ : List Ty} {A B : Ty} (body : Tm (A :: Γ) B) (a : Tm Γ A) : Tm Γ B :=
  subst (Sub.single a) body

/-- **Substituting into a variable.** Substituting $\sigma$ into a variable $x$ gives
$\sigma(x)$. -/
@[simp] theorem subst_var {Γ Δ : List Ty} {A : Ty} (σ : Sub Γ Δ) (x : Var Γ A) :
    subst σ (.var x) = σ x :=
  rfl

/-- **Substituting into an abstraction.** Substitution into an abstraction substitutes the lift
into its body. -/
@[simp] theorem subst_lam {Γ Δ : List Ty} {A B : Ty} (σ : Sub Γ Δ) (body : Tm (A :: Γ) B) :
    subst σ (.lam body) = .lam (subst (Sub.lift σ) body) :=
  rfl

/-- **Substituting into an application.** Substitution commutes with application. -/
@[simp] theorem subst_app {Γ Δ : List Ty} {A B : Ty} (σ : Sub Γ Δ) (f : Tm Γ (A ⇒ B))
    (a : Tm Γ A) : subst σ (.app f a) = .app (subst σ f) (subst σ a) :=
  rfl

/-- **Substituting into zero.** Substitution leaves $\mathsf{zero}$ unchanged. -/
@[simp] theorem subst_zero {Γ Δ : List Ty} (σ : Sub Γ Δ) :
    subst σ (.zero : Tm Γ .nat) = .zero :=
  rfl

/-- **Substituting into a successor.** Substitution commutes with the successor. -/
@[simp] theorem subst_succ {Γ Δ : List Ty} (σ : Sub Γ Δ) (t : Tm Γ .nat) :
    subst σ (.succ t) = .succ (subst σ t) :=
  rfl

/-- **Substituting into a recursor.** Substitution commutes with the recursor. -/
@[simp] theorem subst_natRec {Γ Δ : List Ty} {A : Ty} (σ : Sub Γ Δ) (u : Tm Γ A)
    (v : Tm Γ (A ⇒ Ty.nat ⇒ A)) (t : Tm Γ .nat) :
    subst σ (.natRec u v t) = .natRec (subst σ u) (subst σ v) (subst σ t) :=
  rfl

/-- **Substituting into a numeral.** Substitution leaves every numeral unchanged. -/
@[simp] theorem subst_numeral {Γ Δ : List Ty} (σ : Sub Γ Δ) (n : Nat) :
    subst σ (numeral n : Tm Γ .nat) = numeral n :=
  by
    induction n with
    | zero => rfl
    | succ n ih => simp [ih]

/-- **Substitution respects pointwise equality.** Substitutions that agree on every variable act
identically on every term. -/
theorem subst_congr {Γ Δ : List Ty} {A : Ty} {σ τ : Sub Γ Δ}
    (h : ∀ {B} (x : Var Γ B), σ x = τ x) (t : Tm Γ A) : subst σ t = subst τ t :=
  by
    induction t generalizing Δ with
    | var x => exact h x
    | lam body ih =>
        simp only [subst]
        congr 1
        apply ih
        intro C x
        cases x with
        | zero => rfl
        | succ x => simp [h]
    | app f a ihf iha => simp [ihf h, iha h]
    | zero => rfl
    | succ t ih => simp [ih h]
    | natRec u v t ihu ihv iht => simp [ihu h, ihv h, iht h]

/-- **Substitution by the identity.** Applying the identity substitution to a term gives the
term. -/
@[simp] theorem subst_id {Γ : List Ty} {A : Ty} (t : Tm Γ A) : subst Sub.id t = t :=
  by
    induction t with
    | var => rfl
    | lam body ih =>
        simp only [subst]
        congr 1
        rw [subst_congr (τ := Sub.id) (fun x => by cases x <;> rfl)]
        exact ih
    | app f a ihf iha => simp [ihf, iha]
    | zero => rfl
    | succ t ih => simp [ih]
    | natRec u v t ihu ihv iht => simp [ihu, ihv, iht]

/-- **Substitution after renaming.** Applying $\sigma$ to the renaming of $t$ along $\rho$ is
applying to $t$ the substitution $x \mapsto \sigma(\rho(x))$. -/
theorem subst_rename {Γ Δ Ξ : List Ty} {A : Ty} (ρ : Ren Γ Δ) (σ : Sub Δ Ξ) (t : Tm Γ A) :
    subst σ (rename ρ t) = subst (fun x => σ (ρ x)) t :=
  by
    induction t generalizing Δ Ξ with
    | var => rfl
    | lam body ih =>
        simp only [rename, subst]
        congr 1
        rw [ih]
        apply subst_congr
        intro C x
        cases x <;> rfl
    | app f a ihf iha => simp [ihf, iha]
    | zero => rfl
    | succ t ih => simp [ih]
    | natRec u v t ihu ihv iht => simp [ihu, ihv, iht]

/-- **Renaming after substitution.** Renaming along $\rho$ the result of applying $\sigma$ to $t$
is applying to $t$ the substitution sending $x$ to the renaming of $\sigma(x)$ along $\rho$. -/
theorem rename_subst {Γ Δ Ξ : List Ty} {A : Ty} (σ : Sub Γ Δ) (ρ : Ren Δ Ξ) (t : Tm Γ A) :
    rename ρ (subst σ t) = subst (fun x => rename ρ (σ x)) t :=
  by
    induction t generalizing Δ Ξ with
    | var => rfl
    | lam body ih =>
        simp only [rename, subst]
        congr 1
        rw [ih]
        apply subst_congr
        intro C x
        cases x with
        | zero => rfl
        | succ x =>
            simp only [Sub.lift_succ, weaken, rename_rename]
            rfl
    | app f a ihf iha => simp [ihf, iha]
    | zero => rfl
    | succ t ih => simp [ih]
    | natRec u v t ihu ihv iht => simp [ihu, ihv, iht]

/-- **Composition of substitutions.** Applying $\sigma$ and then $\tau$ to a term is applying the
substitution $x \mapsto \tau(\sigma(x))$, the result of applying $\tau$ to $\sigma(x)$. -/
theorem subst_subst {Γ Δ Ξ : List Ty} {A : Ty} (σ : Sub Γ Δ) (τ : Sub Δ Ξ) (t : Tm Γ A) :
    subst τ (subst σ t) = subst (fun x => subst τ (σ x)) t :=
  by
    induction t generalizing Δ Ξ with
    | var => rfl
    | lam body ih =>
        simp only [subst]
        congr 1
        rw [ih]
        apply subst_congr
        intro C x
        cases x with
        | zero => rfl
        | succ x =>
            simp only [Sub.lift_succ, weaken, subst_rename, rename_subst]
    | app f a ihf iha => simp [ihf, iha]
    | zero => rfl
    | succ t ih => simp [ih]
    | natRec u v t ihu ihv iht => simp [ihu, ihv, iht]

/-- **Instantiation after substitution under a binder.** Applying the lift of $\sigma$ to a body
and then instantiating its newest variable with $a$ is applying to the body the extension of
$\sigma$ by $a$. -/
theorem instantiate_subst_lift {Γ Δ : List Ty} {A B : Ty} (σ : Sub Γ Δ) (body : Tm (A :: Γ) B)
    (a : Tm Δ A) : (subst (Sub.lift σ) body).instantiate a = subst (Sub.cons a σ) body :=
  by
    rw [instantiate, subst_subst]
    apply subst_congr
    intro C x
    cases x with
    | zero => rfl
    | succ x =>
        simp only [Sub.lift_succ, weaken, subst_rename, Sub.cons_succ]
        exact subst_id (σ x)

/-- **Renaming an instantiation.** Renaming along $\rho$ the instantiation of a body with $a$ is
the instantiation of the body renamed along the lift of $\rho$ with $a$ renamed along $\rho$. -/
theorem rename_instantiate {Γ Δ : List Ty} {A B : Ty} (ρ : Ren Γ Δ) (body : Tm (A :: Γ) B)
    (a : Tm Γ A) :
    rename ρ (body.instantiate a) = (rename (Stlc.Var.lift ρ) body).instantiate (rename ρ a) :=
  by
    simp only [instantiate]
    rw [rename_subst, subst_rename]
    apply subst_congr
    intro C x
    cases x <;> rfl

end Tm

end Cslib.Languages.LambdaCalculus.SystemT
