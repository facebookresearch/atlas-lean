/-
# Intrinsically typed simply typed lambda calculus
-/
module

public import Mathlib.Data.List.GetD

/-!
# Intrinsically typed simply typed lambda calculus

This file defines a de Bruijn presentation of the simply typed lambda calculus.
Variables and terms are indexed by their contexts and types, so ill-typed terms
cannot be represented.
-/

@[expose] public section

namespace Cslib.Languages.LambdaCalculus.Stlc

universe u

/-- **Simple types.** Given a type $B$ of base types, the simple types over $B$ are generated by
two rules: every base type $b \in B$ is a simple type, and for simple types $A$ and $C$ the
function type $A \Rightarrow C$ is a simple type. -/
inductive Ty (Base : Type u) where
  | base : Base → Ty Base
  | arr : Ty Base → Ty Base → Ty Base
  deriving DecidableEq, Repr

end Cslib.Languages.LambdaCalculus.Stlc

namespace CslibStlc

scoped notation:60 A:61 " ⇒ " B:60 => Cslib.Languages.LambdaCalculus.Stlc.Ty.arr A B

end CslibStlc

namespace Cslib.Languages.LambdaCalculus.Stlc

universe u

open scoped CslibStlc

/-- **Typed de Bruijn variables of the simply typed lambda calculus.** For a context $\Gamma$ (a
list of simple types) and a simple type $A$, the variables of type $A$ in $\Gamma$ are generated
by two rules: the variable $0$ is a variable of type $A$ in the context $A :: \Gamma$ obtained
by prepending $A$ to $\Gamma$, and if $x$ is a variable of type $A$ in $\Gamma$, then for every
simple type $B$ the successor of $x$ is a variable of type $A$ in $B :: \Gamma$. -/
inductive Var {Base : Type u} : List (Ty Base) → Ty Base → Type u where
  | zero {A : Ty Base} {Γ : List (Ty Base)} : Var (A :: Γ) A
  | succ {A B : Ty Base} {Γ : List (Ty Base)} : Var Γ A → Var (B :: Γ) A

/-- **Intrinsically typed terms of the simply typed lambda calculus.** Let $A$ and $B$ range over
simple types and $\Gamma$ over contexts (lists of simple types); write $A \Rightarrow B$ for the
function type from $A$ to $B$ and $A :: \Gamma$ for the context obtained by prepending $A$ to
$\Gamma$. The terms of type $A$ in context $\Gamma$ are generated by three rules: every variable
of type $A$ in $\Gamma$ is a term of type $A$ in context $\Gamma$; if $f$ is a term of type
$A \Rightarrow B$ and $a$ is a term of type $A$, both in context $\Gamma$, then the application
$f\,a$ is a term of type $B$ in context $\Gamma$; and if $t$ is a term of type $B$ in the context
$A :: \Gamma$, then the abstraction $\lambda t$ is a term of type $A \Rightarrow B$ in context
$\Gamma$. -/
inductive Tm {Base : Type u} : List (Ty Base) → Ty Base → Type u where
  | var {A : Ty Base} {Γ : List (Ty Base)} : Var Γ A → Tm Γ A
  | app {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ (A ⇒ B) → Tm Γ A → Tm Γ B
  | lam {A B : Ty Base} {Γ : List (Ty Base)} : Tm (A :: Γ) B → Tm Γ (A ⇒ B)

variable {Base : Type u}
variable {A B C : Ty Base}
variable {Γ Δ Ξ Ω : List (Ty Base)}

/-- **Renamings of simply typed contexts.** For contexts $\Gamma$ and $\Delta$ (lists of simple
types), a renaming from $\Gamma$ to $\Delta$ assigns to every simple type $A$ and every variable
of type $A$ in $\Gamma$ a variable of type $A$ in $\Delta$. -/
abbrev Ren {Base : Type u} (Γ Δ : List (Ty Base)) := ∀ {A}, Var Γ A → Var Δ A

/-- **Simultaneous substitutions of simply typed contexts.** For contexts $\Gamma$ and $\Delta$
(lists of simple types), a substitution from $\Gamma$ to $\Delta$ assigns to every simple type
$A$ and every variable of type $A$ in $\Gamma$ a term of type $A$ in context $\Delta$. -/
abbrev Sub {Base : Type u} (Γ Δ : List (Ty Base)) := ∀ {A}, Var Γ A → Tm Δ A

namespace Var

/-- **Identity renaming of a simply typed context.** For every context $\Gamma$, the identity
renaming from $\Gamma$ to $\Gamma$ sends each variable to itself. -/
def id : Ren Γ Γ := fun x ↦ x

/-- **Composition of renamings of simply typed contexts.** For contexts $\Gamma$, $\Delta$ and
$\Xi$, a renaming $\rho$ from $\Gamma$ to $\Delta$ and a renaming $\sigma$ from $\Delta$ to $\Xi$,
the composite of $\rho$ followed by $\sigma$ is the renaming from $\Gamma$ to $\Xi$ that sends
each variable $x$ to $\sigma(\rho(x))$. -/
def comp (ρ : Ren Γ Δ) (σ : Ren Δ Ξ) : Ren Γ Ξ := fun x ↦ σ (ρ x)

/-- **Lifting a renaming under a binder.** Let $\rho$ be a renaming from a context $\Gamma$ to a
context $\Delta$ and let $A$ be a simple type, and write $A :: \Gamma$ for the context obtained
by prepending $A$ to $\Gamma$. The lift of $\rho$ is the renaming from $A :: \Gamma$ to
$A :: \Delta$ that sends the variable $0$ to $0$ and sends the successor of a variable $x$ of
$\Gamma$ to the successor of $\rho(x)$. -/
def lift (ρ : Ren Γ Δ) : Ren (A :: Γ) (A :: Δ)
  | _, .zero => .zero
  | _, .succ x => .succ (ρ x)

@[simp] theorem lift_zero (ρ : Ren Γ Δ) : lift (A := A) ρ .zero = .zero := rfl

@[simp] theorem lift_succ (ρ : Ren Γ Δ) (x : Var Γ B) :
    lift (A := A) ρ (.succ x) = .succ (ρ x) := rfl

@[simp] theorem lift_id_apply (x : Var (A :: Γ) B) :
    lift (id : Ren Γ Γ) x = x := by cases x <;> rfl

theorem lift_comp_apply (ρ : Ren Γ Δ) (σ : Ren Δ Ξ) (x : Var (A :: Γ) B) :
    lift (comp ρ σ) x = comp (lift ρ) (lift σ) x := by cases x <;> rfl

end Var

namespace Tm

/-- **Renaming a simply typed term.** For a renaming $\rho$ from a context $\Gamma$ to a context
$\Delta$, the renaming $t[\rho]$ of a term $t$ of type $A$ in context $\Gamma$ is the term of
type $A$ in context $\Delta$ defined by recursion on $t$: $x[\rho] = \rho(x)$ for a variable
$x$, $(f\,a)[\rho] = f[\rho]\,a[\rho]$ for an application, and
$(\lambda s)[\rho] = \lambda (s[\rho^{\uparrow}])$ for an abstraction, where $\rho^{\uparrow}$
is the lift of $\rho$ under one binder. -/
def rename : {Γ Δ : List (Ty Base)} → Ren Γ Δ → {A : Ty Base} → Tm Γ A → Tm Δ A
  | _, _, ρ, _, .var x => .var (ρ x)
  | _, _, ρ, _, .app f a => .app (rename ρ f) (rename ρ a)
  | _, _, ρ, _, .lam body => .lam (rename (Var.lift ρ) body)

@[simp] theorem rename_var (ρ : Ren Γ Δ) (x : Var Γ A) :
    rename ρ (.var x) = .var (ρ x) := rfl

@[simp] theorem rename_app (ρ : Ren Γ Δ) (f : Tm Γ (A ⇒ B)) (a : Tm Γ A) :
    rename ρ (.app f a) = .app (rename ρ f) (rename ρ a) := rfl

@[simp] theorem rename_lam (ρ : Ren Γ Δ) (body : Tm (A :: Γ) B) :
    rename ρ (.lam body) = .lam (rename (Var.lift ρ) body) := rfl

theorem rename_congr {ρ σ : Ren Γ Δ} (h : ∀ {A} (x : Var Γ A), ρ x = σ x)
    (t : Tm Γ B) : rename ρ t = rename σ t := by
  induction t generalizing Δ with
  | var x => simp [h]
  | app f a ihf iha => simp [ihf h, iha h]
  | @lam A B Γ body ih =>
      simp only [rename_lam]
      congr 1
      apply ih
      intro C x
      cases x with
      | zero => rfl
      | succ x => simp [h]

@[simp] theorem rename_id (t : Tm Γ A) : rename Var.id t = t := by
  induction t with
  | var => rfl
  | app f a ihf iha => simp [ihf, iha]
  | @lam A B Γ body ih =>
      simp only [rename_lam]
      congr 1
      rw [rename_congr (fun x ↦ Var.lift_id_apply x)]
      exact ih

theorem rename_comp (ρ : Ren Γ Δ) (σ : Ren Δ Ξ) (t : Tm Γ A) :
    rename σ (rename ρ t) = rename (Var.comp ρ σ) t := by
  induction t generalizing Δ Ξ with
  | var => rfl
  | app f a ihf iha => simp [ihf, iha]
  | @lam A B Γ body ih =>
      simp only [rename_lam]
      congr 1
      rw [ih (ρ := Var.lift ρ) (σ := Var.lift σ)]
      apply rename_congr
      exact fun x ↦ (Var.lift_comp_apply ρ σ x).symm

/-- **Weakening a simply typed term.** For a term $t$ of type $A$ in a context $\Gamma$ and a
simple type $B$, write $B :: \Gamma$ for the context obtained by prepending $B$ to $\Gamma$. The
weakening of $t$ is the term of type $A$ in the context $B :: \Gamma$ obtained by renaming $t$
along the renaming that sends each variable of $\Gamma$ to its successor in $B :: \Gamma$. -/
def weaken (t : Tm Γ A) : Tm (B :: Γ) A := rename .succ t

end Tm

end Cslib.Languages.LambdaCalculus.Stlc
