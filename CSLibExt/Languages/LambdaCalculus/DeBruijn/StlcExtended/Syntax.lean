module

public import Mathlib.Data.List.GetD

/-!
# Intrinsically typed lambda calculus with unit, products, sums, booleans and let

This file defines a de Bruijn presentation of the simply typed lambda calculus extended with the
unit type, binary products, binary sums with a binding case analysis, a primitive type of
booleans with a conditional, and `let`. Variables and terms are indexed by their contexts and
types, so ill-typed terms cannot be represented. The calculus is separate from the intrinsically
typed simply typed lambda calculus `Cslib.Languages.LambdaCalculus.Stlc` rather than an extension
of its inductive types: the base types and the variable, abstraction and application formers are
repeated here.

Renamings act on terms by `Tm.rename`, which lifts the renaming under every binder: the body of a
lambda abstraction, both branches of a case analysis, and the body of a `let`.

## References

* R. Harper, *Practical Foundations for Programming Languages*, 2nd ed., Cambridge University
  Press, 2016: rule (4.1h) (`let`), rules (8.4a,b) (functions), rules (10.1a–d) (products),
  rules (11.1b–d) (sums) and rules (11.5a–c) (booleans).
* B. C. Pierce et al., *Software Foundations*, volume 2, *Programming Language Foundations*,
  chapter `MoreStlc`.
* B. C. Pierce, *Types and Programming Languages*, MIT Press, 2002, chapter 11.
-/

@[expose] public section

namespace Cslib.Languages.LambdaCalculus.StlcExtended

universe u

/-- **Types of the extended simply typed lambda calculus.** Given a type $B$ of base types, the
types over $B$ are generated by six rules: every base type $b \in B$ is a type; for types $A$ and
$C$, the function type $A \Rightarrow C$ is a type; the unit type $\mathsf{unit}$ is a type; for
types $A$ and $C$, the product type $A \times C$ and the sum type $A + C$ are types; and the type
$\mathsf{bool}$ of booleans is a type. -/
inductive Ty (Base : Type u) where
  | base : Base → Ty Base
  | arr : Ty Base → Ty Base → Ty Base
  | unit : Ty Base
  | prod : Ty Base → Ty Base → Ty Base
  | sum : Ty Base → Ty Base → Ty Base
  | bool : Ty Base
  deriving DecidableEq, Repr

end Cslib.Languages.LambdaCalculus.StlcExtended

namespace CslibStlcExtended

scoped notation:60 A:61 " ⇒ " B:60 => Cslib.Languages.LambdaCalculus.StlcExtended.Ty.arr A B

end CslibStlcExtended

namespace Cslib.Languages.LambdaCalculus.StlcExtended

universe u

open scoped CslibStlcExtended

/-- **Typed de Bruijn variables of the extended simply typed lambda calculus.** For a context
$\Gamma$ (a list of types) and a type $A$, the variables of type $A$ in $\Gamma$ are generated by
two rules: the variable $0$ is a variable of type $A$ in the context $A :: \Gamma$ obtained by
prepending $A$ to $\Gamma$, and if $x$ is a variable of type $A$ in $\Gamma$, then for every type
$B$ the successor of $x$ is a variable of type $A$ in $B :: \Gamma$. -/
inductive Var {Base : Type u} : List (Ty Base) → Ty Base → Type u where
  | zero {A : Ty Base} {Γ : List (Ty Base)} : Var (A :: Γ) A
  | succ {A B : Ty Base} {Γ : List (Ty Base)} : Var Γ A → Var (B :: Γ) A

/-- **Intrinsically typed terms of the extended simply typed lambda calculus.** Let $A$, $B$ and
$C$ range over types and $\Gamma$ over contexts, and write $A :: \Gamma$ for the context obtained
by prepending $A$ to $\Gamma$. The terms of type $A$ in context $\Gamma$ are generated by
fourteen rules:

* every variable of type $A$ in $\Gamma$ is a term of type $A$;
* if $t$ is a term of type $B$ in $A :: \Gamma$, the abstraction $\lambda t$ is a term of type
  $A \Rightarrow B$; if $f$ has type $A \Rightarrow B$ and $a$ has type $A$, the application
  $f\,a$ has type $B$;
* $\langle\rangle$ is a term of type $\mathsf{unit}$;
* if $a$ has type $A$ and $b$ has type $B$, the pair $\langle a, b\rangle$ has type
  $A \times B$; if $p$ has type $A \times B$, the projections $\mathsf{fst}\,p$ and
  $\mathsf{snd}\,p$ have types $A$ and $B$;
* if $a$ has type $A$, the injection $\mathsf{inl}\,a$ has type $A + B$; if $b$ has type $B$,
  the injection $\mathsf{inr}\,b$ has type $A + B$; if $s$ has type $A + B$, $l$ has type $C$ in
  $A :: \Gamma$ and $r$ has type $C$ in $B :: \Gamma$, the case analysis
  $\mathsf{case}\,s\,l\,r$ has type $C$, binding the payload of the injection in each branch;
* $\mathsf{tt}$ and $\mathsf{ff}$ are terms of type $\mathsf{bool}$, and if $c$ has type
  $\mathsf{bool}$ and $t$ and $e$ have type $A$, the conditional $\mathsf{ite}\,c\,t\,e$ has
  type $A$;
* if $a$ has type $A$ and $b$ has type $B$ in $A :: \Gamma$, the definition
  $\mathsf{let}\,a\,b$ has type $B$, binding $a$ in $b$.

All terms are in context $\Gamma$ unless another context is named. -/
inductive Tm {Base : Type u} : List (Ty Base) → Ty Base → Type u where
  | var {A : Ty Base} {Γ : List (Ty Base)} : Var Γ A → Tm Γ A
  | lam {A B : Ty Base} {Γ : List (Ty Base)} : Tm (A :: Γ) B → Tm Γ (A ⇒ B)
  | app {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ (A ⇒ B) → Tm Γ A → Tm Γ B
  | unit {Γ : List (Ty Base)} : Tm Γ .unit
  | pair {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ A → Tm Γ B → Tm Γ (.prod A B)
  | fst {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ (.prod A B) → Tm Γ A
  | snd {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ (.prod A B) → Tm Γ B
  | inl {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ A → Tm Γ (.sum A B)
  | inr {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ B → Tm Γ (.sum A B)
  | case {A B C : Ty Base} {Γ : List (Ty Base)} :
      Tm Γ (.sum A B) → Tm (A :: Γ) C → Tm (B :: Γ) C → Tm Γ C
  | tt {Γ : List (Ty Base)} : Tm Γ .bool
  | ff {Γ : List (Ty Base)} : Tm Γ .bool
  | ite {A : Ty Base} {Γ : List (Ty Base)} : Tm Γ .bool → Tm Γ A → Tm Γ A → Tm Γ A
  | letIn {A B : Ty Base} {Γ : List (Ty Base)} : Tm Γ A → Tm (A :: Γ) B → Tm Γ B

/-- **Renamings of contexts of the extended calculus.** For contexts $\Gamma$ and $\Delta$, a
renaming from $\Gamma$ to $\Delta$ assigns to every type $A$ and every variable of type $A$ in
$\Gamma$ a variable of type $A$ in $\Delta$. -/
abbrev Ren {Base : Type u} (Γ Δ : List (Ty Base)) := ∀ {A}, Var Γ A → Var Δ A

/-- **Simultaneous substitutions of contexts of the extended calculus.** For contexts $\Gamma$
and $\Delta$, a substitution from $\Gamma$ to $\Delta$ assigns to every type $A$ and every
variable of type $A$ in $\Gamma$ a term of type $A$ in context $\Delta$. -/
abbrev Sub {Base : Type u} (Γ Δ : List (Ty Base)) := ∀ {A}, Var Γ A → Tm Δ A

namespace Var

/-- **Identity renaming.** For every context $\Gamma$, the identity renaming from $\Gamma$ to
$\Gamma$ sends each variable to itself. -/
def id {Base : Type u} {Γ : List (Ty Base)} : Ren Γ Γ := fun x ↦ x

/-- **Composition of renamings.** For a renaming $\rho$ from $\Gamma$ to $\Delta$ and a renaming
$\sigma$ from $\Delta$ to $\Xi$, the composite of $\rho$ followed by $\sigma$ is the renaming from
$\Gamma$ to $\Xi$ that sends each variable $x$ to $\sigma(\rho(x))$. -/
def comp {Base : Type u} {Γ Δ Ξ : List (Ty Base)} (ρ : Ren Γ Δ) (σ : Ren Δ Ξ) : Ren Γ Ξ :=
  fun x ↦ σ (ρ x)

/-- **Lifting a renaming under a binder.** Let $\rho$ be a renaming from $\Gamma$ to $\Delta$ and
let $A$ be a type. The lift of $\rho$ is the renaming from $A :: \Gamma$ to $A :: \Delta$ that
sends the variable $0$ to $0$ and the successor of a variable $x$ of $\Gamma$ to the successor of
$\rho(x)$. -/
def lift {Base : Type u} {A : Ty Base} {Γ Δ : List (Ty Base)} (ρ : Ren Γ Δ) :
    Ren (A :: Γ) (A :: Δ)
  | _, .zero => .zero
  | _, .succ x => .succ (ρ x)

@[simp] theorem lift_zero {Base : Type u} {A : Ty Base} {Γ Δ : List (Ty Base)} (ρ : Ren Γ Δ) :
    lift (A := A) ρ .zero = .zero := rfl

@[simp] theorem lift_succ {Base : Type u} {A B : Ty Base} {Γ Δ : List (Ty Base)} (ρ : Ren Γ Δ)
    (x : Var Γ B) : lift (A := A) ρ (.succ x) = .succ (ρ x) := rfl

/-- **The lift of the identity renaming is the identity.** For every variable $x$ of the context
$A :: \Gamma$, the lift of the identity renaming of $\Gamma$ sends $x$ to $x$. -/
@[simp] theorem lift_id_apply {Base : Type u} {A B : Ty Base} {Γ : List (Ty Base)}
    (x : Var (A :: Γ) B) : lift (id : Ren Γ Γ) x = x := by cases x <;> rfl

/-- **Lifting commutes with composition of renamings.** For renamings $\rho$ from $\Gamma$ to
$\Delta$ and $\sigma$ from $\Delta$ to $\Xi$, the lift of the composite of $\rho$ and $\sigma$
agrees on every variable of $A :: \Gamma$ with the composite of the lifts. -/
theorem lift_comp_apply {Base : Type u} {A B : Ty Base} {Γ Δ Ξ : List (Ty Base)} (ρ : Ren Γ Δ)
    (σ : Ren Δ Ξ) (x : Var (A :: Γ) B) : lift (comp ρ σ) x = comp (lift ρ) (lift σ) x := by
  cases x <;> rfl

end Var

namespace Tm

/-- **Renaming a term of the extended calculus.** For a renaming $\rho$ from $\Gamma$ to
$\Delta$, the renaming $t[\rho]$ of a term $t$ of type $A$ in $\Gamma$ is the term of type $A$ in
$\Delta$ defined by recursion on $t$: a variable $x$ becomes $\rho(x)$; under each binder, that
is in the body of an abstraction, in both branches of a case analysis and in the body of a `let`,
the renaming is replaced by its lift; every other former is renamed componentwise. -/
@[simp] def rename {Base : Type u} :
    {Γ Δ : List (Ty Base)} → Ren Γ Δ → {A : Ty Base} → Tm Γ A → Tm Δ A
  | _, _, ρ, _, .var x => .var (ρ x)
  | _, _, ρ, _, .lam body => .lam (rename (Var.lift ρ) body)
  | _, _, ρ, _, .app f a => .app (rename ρ f) (rename ρ a)
  | _, _, _, _, .unit => .unit
  | _, _, ρ, _, .pair a b => .pair (rename ρ a) (rename ρ b)
  | _, _, ρ, _, .fst p => .fst (rename ρ p)
  | _, _, ρ, _, .snd p => .snd (rename ρ p)
  | _, _, ρ, _, .inl a => .inl (rename ρ a)
  | _, _, ρ, _, .inr b => .inr (rename ρ b)
  | _, _, ρ, _, .case s l r =>
      .case (rename ρ s) (rename (Var.lift ρ) l) (rename (Var.lift ρ) r)
  | _, _, _, _, .tt => .tt
  | _, _, _, _, .ff => .ff
  | _, _, ρ, _, .ite c t e => .ite (rename ρ c) (rename ρ t) (rename ρ e)
  | _, _, ρ, _, .letIn a b => .letIn (rename ρ a) (rename (Var.lift ρ) b)

/-- **Renaming respects pointwise equality.** If two renamings $\rho$ and $\sigma$ from $\Gamma$
to $\Delta$ agree on every variable, then they rename every term of $\Gamma$ to the same term. -/
theorem rename_congr {Base : Type u} {B : Ty Base} {Γ Δ : List (Ty Base)} {ρ σ : Ren Γ Δ}
    (h : ∀ {A} (x : Var Γ A), ρ x = σ x) (t : Tm Γ B) : rename ρ t = rename σ t := by
  induction t generalizing Δ with
  | var x => simp only [rename, h]
  | lam body ih =>
      simp only [rename]
      rw [ih (ρ := Var.lift ρ) (σ := Var.lift σ) fun x => by cases x <;> simp [h]]
  | app f a ihf iha => simp only [rename, ihf h, iha h]
  | unit => rfl
  | pair a b iha ihb => simp only [rename, iha h, ihb h]
  | fst p ih => simp only [rename, ih h]
  | snd p ih => simp only [rename, ih h]
  | inl a ih => simp only [rename, ih h]
  | inr b ih => simp only [rename, ih h]
  | case s l r ihs ihl ihr =>
      simp only [rename]
      rw [ihs h, ihl (ρ := Var.lift ρ) (σ := Var.lift σ) fun x => by cases x <;> simp [h],
        ihr (ρ := Var.lift ρ) (σ := Var.lift σ) fun x => by cases x <;> simp [h]]
  | tt => rfl
  | ff => rfl
  | ite c t e ihc iht ihe => simp only [rename, ihc h, iht h, ihe h]
  | letIn a b iha ihb =>
      simp only [rename]
      rw [iha h, ihb (ρ := Var.lift ρ) (σ := Var.lift σ) fun x => by cases x <;> simp [h]]

/-- **Renaming along the identity.** Renaming a term along the identity renaming returns the
term unchanged. -/
@[simp] theorem rename_id {Base : Type u} {A : Ty Base} {Γ : List (Ty Base)} (t : Tm Γ A) :
    rename Var.id t = t := by
  induction t with
  | var x => rfl
  | lam body ih =>
      simp only [rename]
      rw [rename_congr (σ := Var.id) (fun x => Var.lift_id_apply x) body, ih]
  | app f a ihf iha => simp only [rename, ihf, iha]
  | unit => rfl
  | pair a b iha ihb => simp only [rename, iha, ihb]
  | fst p ih => simp only [rename, ih]
  | snd p ih => simp only [rename, ih]
  | inl a ih => simp only [rename, ih]
  | inr b ih => simp only [rename, ih]
  | case s l r ihs ihl ihr =>
      simp only [rename]
      rw [ihs, rename_congr (σ := Var.id) (fun x => Var.lift_id_apply x) l, ihl,
        rename_congr (σ := Var.id) (fun x => Var.lift_id_apply x) r, ihr]
  | tt => rfl
  | ff => rfl
  | ite c t e ihc iht ihe => simp only [rename, ihc, iht, ihe]
  | letIn a b iha ihb =>
      simp only [rename]
      rw [iha, rename_congr (σ := Var.id) (fun x => Var.lift_id_apply x) b, ihb]

/-- **Renaming along a composite.** Renaming a term along $\rho$ and then along $\sigma$ is
renaming it along the composite of $\rho$ followed by $\sigma$. -/
theorem rename_comp {Base : Type u} {A : Ty Base} {Γ Δ Ξ : List (Ty Base)} (ρ : Ren Γ Δ)
    (σ : Ren Δ Ξ) (t : Tm Γ A) : rename σ (rename ρ t) = rename (Var.comp ρ σ) t := by
  induction t generalizing Δ Ξ with
  | var x => rfl
  | lam body ih =>
      simp only [rename]
      rw [ih (ρ := Var.lift ρ) (σ := Var.lift σ),
        rename_congr (fun x => (Var.lift_comp_apply ρ σ x).symm)]
  | app f a ihf iha => simp only [rename, ihf, iha]
  | unit => rfl
  | pair a b iha ihb => simp only [rename, iha, ihb]
  | fst p ih => simp only [rename, ih]
  | snd p ih => simp only [rename, ih]
  | inl a ih => simp only [rename, ih]
  | inr b ih => simp only [rename, ih]
  | case s l r ihs ihl ihr =>
      simp only [rename]
      rw [ihs, ihl (ρ := Var.lift ρ) (σ := Var.lift σ), ihr (ρ := Var.lift ρ) (σ := Var.lift σ),
        rename_congr (fun x => (Var.lift_comp_apply ρ σ x).symm) l,
        rename_congr (fun x => (Var.lift_comp_apply ρ σ x).symm) r]
  | tt => rfl
  | ff => rfl
  | ite c t e ihc iht ihe => simp only [rename, ihc, iht, ihe]
  | letIn a b iha ihb =>
      simp only [rename]
      rw [iha, ihb (ρ := Var.lift ρ) (σ := Var.lift σ),
        rename_congr (fun x => (Var.lift_comp_apply ρ σ x).symm) b]

/-- **Weakening a term.** For a term $t$ of type $A$ in $\Gamma$ and a type $B$, the weakening
of $t$ is the term of type $A$ in $B :: \Gamma$ obtained by renaming $t$ along the renaming that
sends each variable of $\Gamma$ to its successor in $B :: \Gamma$. -/
def weaken {Base : Type u} {A B : Ty Base} {Γ : List (Ty Base)} (t : Tm Γ A) : Tm (B :: Γ) A :=
  rename .succ t

end Tm

end Cslib.Languages.LambdaCalculus.StlcExtended
