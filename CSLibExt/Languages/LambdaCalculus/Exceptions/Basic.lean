module

public import Mathlib.Data.List.Basic

/-!
# Exceptions with a fixed exception type: syntax, typing and semantics

The simply typed λ-calculus with natural numbers, extended by exceptions at a fixed exception
type: `raise e` raises the value of `e`, and `try e₁ with x. e₂` evaluates `e₁` and, if it raises
a value `v`, continues with `e₂` with `x` bound to `v`. The exception type `exn` is a parameter
of the typing judgment ("some fixed, but as yet unspecified, type of exception values" in
Harper's *Practical Foundations for Programming Languages*): `raise e` has every type when `e`
has type `exn`, and the handler of `try` binds a variable of type `exn`. There is a single
anonymous exception: no exception names, declarations or re-raise rule.

The dynamics is a left-to-right call-by-value small-step relation in the evaluation-context
style of Wright and Felleisen, with evaluation contexts presented by frames: one rule propagates
a raised value out of one non-handler frame, `try` catches a raised value or returns a value,
and steps are closed under frames. A term is final when it is a value or an uncaught exception
`raise v` with `v` a value; the uncaught exception is a final answer, as in Harper's final
states and Wright and Felleisen's unhandled-exception answers.

The base fragment is the left-to-right call-by-value simply typed λ-calculus with `nat`, a type
`bot` without values, multiplication and a zero test, presented extrinsically with de Bruijn
indices as in `CSLibExt.Languages.LambdaCalculus.References`. Its safety extends the
call-by-value safety of `Cslib.Languages.LambdaCalculus.Stlc.Step` (with
`Cslib.Languages.LambdaCalculus.Stlc.Step.progress`), not the locally nameless full
β-reduction theorems of CSLib. Terms are Curry-style: abstractions carry no type annotation.

## Main definitions

* `Ty`, `Term`, `Term.Value`: types, terms and values.
* `Term.rename`, `Term.subst`, `Term.instantiate`: parallel renaming and substitution, and the
  instantiation of variable `0`.
* `HasType exn Γ e A`: the typing judgment at exception type `exn`.
* `Frame`, `Frame.plug`, `Frame.Ok`: evaluation frames, plugging, and the call-by-value
  condition on frames.
* `Step`: the small-step semantics.
* `Final`: values and uncaught exceptions.

## References

* R. Harper, *Practical Foundations for Programming Languages*, 2nd ed., chapter "Exceptions":
  statics (rules 29.4a and 29.4b), final states (29.6) and Theorem 29.2 (safety), numbered as
  in the abbreviated second-edition draft.
* A. K. Wright and M. Felleisen, *A Syntactic Approach to Type Soundness*, Information and
  Computation 115(1), 1994, §5.2 "Exception ML": rules raise, handle and unhandle, the contexts
  for raising and handling, and unhandled-exception answers, specialized to one anonymous
  exception.
-/

@[expose] public section

set_option autoImplicit false

namespace Cslib.Languages.LambdaCalculus.Exceptions

/-- **Types of the calculus with exceptions.** The types are generated by the grammar
$A, B ::= \mathsf{nat} \mid \bot \mid A \to B$: natural numbers, a type with no values, and
function types. -/
inductive Ty where
  /-- Natural numbers. -/
  | nat : Ty
  /-- The empty type. -/
  | bot : Ty
  /-- Function types. -/
  | arr (A B : Ty) : Ty

/-- **Terms of the calculus with exceptions.** The terms are variables (de Bruijn indices),
abstractions `λ. b` whose body binds index `0`, applications, numerals, multiplication, the zero
test `ifz c t e` (which is `t` when `c` is `0` and `e` otherwise), `raise e`, and
`try e₁ with x. e₂`, written `tryWith e₁ e₂`, whose handler `e₂` binds index `0` to the raised
value. -/
inductive Term where
  /-- A de Bruijn variable. -/
  | var (i : ℕ) : Term
  /-- An abstraction; the body binds index `0`. -/
  | lam (b : Term) : Term
  /-- Application. -/
  | app (f a : Term) : Term
  /-- A numeral. -/
  | num (n : ℕ) : Term
  /-- Multiplication. -/
  | mul (a b : Term) : Term
  /-- The zero test: `t` if `c` is `0`, `e` otherwise. -/
  | ifz (c t e : Term) : Term
  /-- Raising the value of a term as an exception. -/
  | raise (e : Term) : Term
  /-- `try body with x. handler`; the handler binds index `0` to the raised value. -/
  | tryWith (body handler : Term) : Term

namespace Term

/-- **Values of the calculus with exceptions.** A term is a value exactly when it is an
abstraction or a numeral. -/
inductive Value : Term → Prop
  /-- Abstractions are values. -/
  | lam (b : Term) : Value (.lam b)
  /-- Numerals are values. -/
  | num (n : ℕ) : Value (.num n)

/-- **Renaming the variables of a term.** Given a renaming `ρ` of de Bruijn indices, renaming a
term by `ρ` replaces each free variable `i` by `ρ i`; under the binder of an abstraction body or
of a handler the renaming is lifted, sending `0` to `0` and `i + 1` to `ρ i + 1`. -/
def rename : (ℕ → ℕ) → Term → Term
  | ρ, .var i => .var (ρ i)
  | ρ, .lam b => .lam (rename (fun | 0 => 0 | i + 1 => ρ i + 1) b)
  | ρ, .app f a => .app (rename ρ f) (rename ρ a)
  | _, .num n => .num n
  | ρ, .mul a b => .mul (rename ρ a) (rename ρ b)
  | ρ, .ifz c t e => .ifz (rename ρ c) (rename ρ t) (rename ρ e)
  | ρ, .raise e => .raise (rename ρ e)
  | ρ, .tryWith e h => .tryWith (rename ρ e) (rename (fun | 0 => 0 | i + 1 => ρ i + 1) h)

/-- **Parallel substitution in a term.** Given a substitution `σ` assigning a term to each de
Bruijn index, substituting `σ` into a term replaces each free variable `i` by `σ i`; under the
binder of an abstraction body or of a handler the substitution is lifted, sending `0` to the
variable `0` and `i + 1` to `σ i` with every free variable raised by one. -/
def subst : (ℕ → Term) → Term → Term
  | σ, .var i => σ i
  | σ, .lam b => .lam (subst (fun | 0 => .var 0 | i + 1 => (σ i).rename (· + 1)) b)
  | σ, .app f a => .app (subst σ f) (subst σ a)
  | _, .num n => .num n
  | σ, .mul a b => .mul (subst σ a) (subst σ b)
  | σ, .ifz c t e => .ifz (subst σ c) (subst σ t) (subst σ e)
  | σ, .raise e => .raise (subst σ e)
  | σ, .tryWith e h =>
      .tryWith (subst σ e) (subst (fun | 0 => .var 0 | i + 1 => (σ i).rename (· + 1)) h)

/-- **Substitution of a term for variable zero.** For terms `t` and `s`, `t.instantiate s`
substitutes `s` for the free variable `0` of `t` and lowers every other free variable by one. -/
def instantiate (t s : Term) : Term :=
  t.subst fun | 0 => s | i + 1 => .var i

end Term

/-- **Typing judgment of the calculus with exceptions.** For a fixed exception type `exn`, the
judgment `HasType exn Γ e A`, where the context `Γ` lists the types of the free de Bruijn
variables (index `0` first), is the least relation closed under the rules of the simply typed
λ-calculus with natural numbers (multiplication of two numbers is a number; the zero test takes
a number and two branches of a common type) and the two exception rules: if `e` has type `exn`
then `raise e` has every type (Harper, rule 29.4a); if `e₁` has type `A` and `e₂` has type `A`
in `Γ` extended by a variable of type `exn`, then `try e₁ with x. e₂` has type `A` (Harper, rule
29.4b). -/
inductive HasType (exn : Ty) : List Ty → Term → Ty → Prop
  /-- A variable has the type the context assigns to it. -/
  | var {Γ : List Ty} {i : ℕ} {A : Ty} (h : Γ[i]? = some A) : HasType exn Γ (.var i) A
  /-- Abstraction. -/
  | lam {Γ : List Ty} {A B : Ty} {b : Term} (h : HasType exn (A :: Γ) b B) :
      HasType exn Γ (.lam b) (.arr A B)
  /-- Application. -/
  | app {Γ : List Ty} {A B : Ty} {f a : Term} (hf : HasType exn Γ f (.arr A B))
      (ha : HasType exn Γ a A) : HasType exn Γ (.app f a) B
  /-- Numerals are numbers. -/
  | num {Γ : List Ty} {n : ℕ} : HasType exn Γ (.num n) .nat
  /-- Multiplication of numbers. -/
  | mul {Γ : List Ty} {a b : Term} (ha : HasType exn Γ a .nat) (hb : HasType exn Γ b .nat) :
      HasType exn Γ (.mul a b) .nat
  /-- The zero test. -/
  | ifz {Γ : List Ty} {A : Ty} {c t e : Term} (hc : HasType exn Γ c .nat)
      (ht : HasType exn Γ t A) (he : HasType exn Γ e A) : HasType exn Γ (.ifz c t e) A
  /-- Raising a value of the exception type gives every type. -/
  | raise {Γ : List Ty} {A : Ty} {e : Term} (h : HasType exn Γ e exn) :
      HasType exn Γ (.raise e) A
  /-- Handling: the handler binds a variable of the exception type. -/
  | tryWith {Γ : List Ty} {A : Ty} {e₁ e₂ : Term} (h₁ : HasType exn Γ e₁ A)
      (h₂ : HasType exn (exn :: Γ) e₂ A) : HasType exn Γ (.tryWith e₁ e₂) A

/-- **Evaluation frames.** One layer of an evaluation context: the function or argument
position of an application, the left or right operand of a multiplication, the test of `ifz`,
the argument of `raise`, and the body of `try` (the handler frame). -/
inductive Frame where
  /-- `□ a`. -/
  | appL (a : Term) : Frame
  /-- `f □`. -/
  | appR (f : Term) : Frame
  /-- `□ * b`. -/
  | mulL (b : Term) : Frame
  /-- `a * □`. -/
  | mulR (a : Term) : Frame
  /-- `ifz □ t e`. -/
  | ifz (t e : Term) : Frame
  /-- `raise □`. -/
  | raise : Frame
  /-- `try □ with x. h`, the handler frame. -/
  | tryWith (h : Term) : Frame

namespace Frame

/-- **Plugging a frame.** `F.plug t` fills the hole of the frame `F` with the term `t`. -/
def plug : Frame → Term → Term
  | .appL a, t => .app t a
  | .appR f, t => .app f t
  | .mulL b, t => .mul t b
  | .mulR a, t => .mul a t
  | .ifz t₁ t₂, t => .ifz t t₁ t₂
  | .raise, t => .raise t
  | .tryWith h, t => .tryWith t h

/-- **Call-by-value frames.** A frame is admissible for left-to-right call-by-value evaluation
when its hole is the leftmost unevaluated position: in `f □` the function `f` and in `a * □` the
operand `a` are values; every other frame is admissible. -/
def Ok : Frame → Prop
  | .appR f => f.Value
  | .mulR a => a.Value
  | _ => True

end Frame

/-- **Small-step semantics of the calculus with exceptions.** The rules are β-reduction of an
abstraction applied to a value, multiplication of numerals, the two zero-test rules, and:
* propagation (Wright and Felleisen's rule raise): an uncaught `raise v`, with `v` a value,
  leaves any admissible frame that is not a handler frame;
* `tryValue` (unhandle): `try v with x. e₂` steps to `v` for a value `v`;
* `tryRaise` (handle): `try (raise v) with x. e₂` steps to `e₂` with `x` instantiated by the
  value `v`;
* `frame`: steps are closed under admissible frames. -/
inductive Step : Term → Term → Prop
  /-- β-reduction. -/
  | beta {b v : Term} (hv : v.Value) : Step (.app (.lam b) v) (b.instantiate v)
  /-- Multiplication of numerals. -/
  | mul {m n : ℕ} : Step (.mul (.num m) (.num n)) (.num (m * n))
  /-- The zero test at zero. -/
  | ifzZero {t e : Term} : Step (.ifz (.num 0) t e) t
  /-- The zero test at a successor. -/
  | ifzSucc {n : ℕ} {t e : Term} : Step (.ifz (.num (n + 1)) t e) e
  /-- A raised value leaves a non-handler frame. -/
  | propagate {F : Frame} {v : Term} (hv : v.Value) (hF : F.Ok)
      (hh : ∀ h, F ≠ .tryWith h) : Step (F.plug (.raise v)) (.raise v)
  /-- A handled computation that returns a value. -/
  | tryValue {v h : Term} (hv : v.Value) : Step (.tryWith v h) v
  /-- A handled computation that raises a value. -/
  | tryRaise {v h : Term} (hv : v.Value) : Step (.tryWith (.raise v) h) (h.instantiate v)
  /-- Steps under an admissible frame. -/
  | frame {F : Frame} {e e' : Term} (hF : F.Ok) (h : Step e e') :
      Step (F.plug e) (F.plug e')

/-- **Final terms.** A term is final when it is a value or an uncaught exception `raise v` with
`v` a value. The predicate does not depend on types. -/
def Final (e : Term) : Prop :=
  e.Value ∨ ∃ v, v.Value ∧ e = .raise v

end Cslib.Languages.LambdaCalculus.Exceptions
