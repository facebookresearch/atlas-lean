module

public import Mathlib.Data.List.Basic

/-!
# First-class continuations with callcc and abort: syntax, typing and semantics

The simply typed λ-calculus with natural numbers, extended by `callcc` and `abort` as in Wright
and Felleisen's Control ML. Evaluation is left-to-right call-by-value, given by program
reductions on explicit evaluation contexts: `E[callcc v]` steps to `E[v (λx. abort E[x])]`,
which passes the current continuation, rebuilt as an abstraction, to `v`; and `E[abort e]`
steps to `e`, discarding the context. Continuations are abortive. Evaluation contexts are lists
of frames, innermost frame first.

With Wright and Felleisen's unrestricted rule for `abort` (`abort e` has every type when `e` has
some type) only typability is preserved. Here, as in their augmented judgment with a single
answer type, the typing judgment is indexed by the answer type `T` of the whole program, and
`abort e` has every type when `e` has type `T`. Then a closed program of type `T` steps only to
programs of type `T`. At `T = bot` the rule for `abort` is ex falso, and `callcc` has the type of
Peirce's law, which is Griffin's classical reading of control operators. Without
let-polymorphism the naive typing of `callcc` is sound; no imperative-type restriction is
needed.

The base fragment is the left-to-right call-by-value simply typed λ-calculus with `nat`, a type
`bot` without values, multiplication and a zero test, presented extrinsically with de Bruijn
indices as in `CSLibExt.Languages.LambdaCalculus.References`. Its safety extends the
call-by-value safety of `Cslib.Languages.LambdaCalculus.Stlc.Step` (with
`Cslib.Languages.LambdaCalculus.Stlc.Step.progress`), not the locally nameless full
β-reduction theorems of CSLib. Terms are Curry-style: abstractions carry no type annotation,
which lets the continuation built by `callcc` be an ordinary abstraction.

## Main definitions

* `Ty`, `Term`, `Term.Value`: types, terms and values.
* `Term.rename`, `Term.subst`, `Term.instantiate`: parallel renaming and substitution, and the
  instantiation of variable `0`.
* `Frame`, `ECtx`, `ECtx.plug`, `ECtx.rename`, `ECtx.Ok`, `ECtx.reify`: frames, evaluation
  contexts, plugging, renaming, the call-by-value condition, and the continuation of a context.
* `HasType T Γ e A`: the typing judgment at answer type `T`.
* `Red`, `Step`: local reductions and program steps.
* `HasCtxType T Γ E A B`: typing of evaluation contexts.
* `Term.AbortFree`: terms without `abort`.

## References

* A. K. Wright and M. Felleisen, *A Syntactic Approach to Type Soundness*, Information and
  Computation 115(1), 1994, §6 "Control ML": §6.1 (program reductions for callcc and abort,
  evaluation contexts), Figure 6 (the early-exit product of a list), §6.2 (the typing of callcc
  and abort), §6.3 (typability preservation), §6.4 and Figure 7 (typing with answer types,
  here a single answer type), Main Lemma 6.5 and Theorem 6.6.
* T. G. Griffin, *A Formulae-as-Types Notion of Control*, POPL 1990: §3 (abort read as
  ⊥-elimination, that is ex falso) and §5 (callcc has the type of Peirce's law).
-/

@[expose] public section

set_option autoImplicit false

namespace Cslib.Languages.LambdaCalculus.Callcc

/-- **Types of the calculus with callcc.** The types are generated by the grammar
$A, B ::= \mathsf{nat} \mid \bot \mid A \to B$: natural numbers, a type with no values, and
function types. -/
inductive Ty where
  /-- Natural numbers. -/
  | nat : Ty
  /-- The empty type. -/
  | bot : Ty
  /-- Function types. -/
  | arr (A B : Ty) : Ty

/-- **Terms of the calculus with callcc.** The terms are variables (de Bruijn indices),
abstractions `λ. b` whose body binds index `0`, applications, numerals, multiplication, the zero
test `ifz c t e` (which is `t` when `c` is `0` and `e` otherwise), `callcc e`, which calls the
value of `e` with the current continuation, and `abort e`, which replaces the whole program by
`e`. -/
inductive Term where
  /-- A de Bruijn variable. -/
  | var (i : ℕ) : Term
  /-- An abstraction; the body binds index `0`. -/
  | lam (b : Term) : Term
  /-- Application. -/
  | app (f a : Term) : Term
  /-- A numeral. -/
  | num (n : ℕ) : Term
  /-- Multiplication. -/
  | mul (a b : Term) : Term
  /-- The zero test: `t` if `c` is `0`, `e` otherwise. -/
  | ifz (c t e : Term) : Term
  /-- Calling the value of a term with the current continuation. -/
  | callcc (e : Term) : Term
  /-- Replacing the whole program by a term. -/
  | abort (e : Term) : Term

namespace Term

/-- **Values of the calculus with callcc.** A term is a value exactly when it is an abstraction
or a numeral. -/
inductive Value : Term → Prop
  /-- Abstractions are values. -/
  | lam (b : Term) : Value (.lam b)
  /-- Numerals are values. -/
  | num (n : ℕ) : Value (.num n)

/-- **Renaming the variables of a term.** Given a renaming `ρ` of de Bruijn indices, renaming a
term by `ρ` replaces each free variable `i` by `ρ i`; under the binder of an abstraction body
the renaming is lifted, sending `0` to `0` and `i + 1` to `ρ i + 1`. -/
def rename : (ℕ → ℕ) → Term → Term
  | ρ, .var i => .var (ρ i)
  | ρ, .lam b => .lam (rename (fun | 0 => 0 | i + 1 => ρ i + 1) b)
  | ρ, .app f a => .app (rename ρ f) (rename ρ a)
  | _, .num n => .num n
  | ρ, .mul a b => .mul (rename ρ a) (rename ρ b)
  | ρ, .ifz c t e => .ifz (rename ρ c) (rename ρ t) (rename ρ e)
  | ρ, .callcc e => .callcc (rename ρ e)
  | ρ, .abort e => .abort (rename ρ e)

/-- **Parallel substitution in a term.** Given a substitution `σ` assigning a term to each de
Bruijn index, substituting `σ` into a term replaces each free variable `i` by `σ i`; under the
binder of an abstraction body the substitution is lifted, sending `0` to the variable `0` and
`i + 1` to `σ i` with every free variable raised by one. -/
def subst : (ℕ → Term) → Term → Term
  | σ, .var i => σ i
  | σ, .lam b => .lam (subst (fun | 0 => .var 0 | i + 1 => (σ i).rename (· + 1)) b)
  | σ, .app f a => .app (subst σ f) (subst σ a)
  | _, .num n => .num n
  | σ, .mul a b => .mul (subst σ a) (subst σ b)
  | σ, .ifz c t e => .ifz (subst σ c) (subst σ t) (subst σ e)
  | σ, .callcc e => .callcc (subst σ e)
  | σ, .abort e => .abort (subst σ e)

/-- **Substitution of a term for variable zero.** For terms `t` and `s`, `t.instantiate s`
substitutes `s` for the free variable `0` of `t` and lowers every other free variable by one. -/
def instantiate (t s : Term) : Term :=
  t.subst fun | 0 => s | i + 1 => .var i

/-- **Terms without abort.** A term is abort-free when no subterm is of the form `abort e`. -/
def AbortFree : Term → Prop
  | .var _ => True
  | .lam b => b.AbortFree
  | .app f a => f.AbortFree ∧ a.AbortFree
  | .num _ => True
  | .mul a b => a.AbortFree ∧ b.AbortFree
  | .ifz c t e => c.AbortFree ∧ t.AbortFree ∧ e.AbortFree
  | .callcc e => e.AbortFree
  | .abort _ => False

end Term

/-- **Evaluation frames.** One layer of an evaluation context: the function or argument
position of an application, the left or right operand of a multiplication, the test of `ifz`,
and the argument of `callcc`. There is no frame for `abort`, whose argument is not evaluated. -/
inductive Frame where
  /-- `□ a`. -/
  | appL (a : Term) : Frame
  /-- `f □`. -/
  | appR (f : Term) : Frame
  /-- `□ * b`. -/
  | mulL (b : Term) : Frame
  /-- `a * □`. -/
  | mulR (a : Term) : Frame
  /-- `ifz □ t e`. -/
  | ifz (t e : Term) : Frame
  /-- `callcc □`. -/
  | callcc : Frame

/-- **Evaluation contexts.** An evaluation context is a list of frames, innermost frame first;
the empty list is the hole. -/
abbrev ECtx := List Frame

namespace ECtx

/-- **Plugging an evaluation context.** `E.plug t` fills the hole of `E` with the term `t`: the
empty context gives `t`, and a context whose innermost frame is `F` plugs the rest of the
context with `F` filled by `t`. -/
def plug : ECtx → Term → Term
  | [], t => t
  | .appL a :: E, t => plug E (.app t a)
  | .appR f :: E, t => plug E (.app f t)
  | .mulL b :: E, t => plug E (.mul t b)
  | .mulR a :: E, t => plug E (.mul a t)
  | .ifz t₁ t₂ :: E, t => plug E (.ifz t t₁ t₂)
  | .callcc :: E, t => plug E (.callcc t)

/-- **Renaming an evaluation context.** Renames the terms of every frame by `ρ`. The hole is not
under a binder, so the renaming is not lifted. -/
def rename (ρ : ℕ → ℕ) : ECtx → ECtx
  | [] => []
  | .appL a :: E => .appL (a.rename ρ) :: rename ρ E
  | .appR f :: E => .appR (f.rename ρ) :: rename ρ E
  | .mulL b :: E => .mulL (b.rename ρ) :: rename ρ E
  | .mulR a :: E => .mulR (a.rename ρ) :: rename ρ E
  | .ifz t e :: E => .ifz (t.rename ρ) (e.rename ρ) :: rename ρ E
  | .callcc :: E => .callcc :: rename ρ E

/-- **Call-by-value evaluation contexts.** A context is admissible for left-to-right
call-by-value evaluation when in every frame `f □` the function `f`, and in every frame
`a * □` the operand `a`, is a value. -/
def Ok : ECtx → Prop
  | [] => True
  | .appR f :: E => f.Value ∧ Ok E
  | .mulR a :: E => a.Value ∧ Ok E
  | _ :: E => Ok E

/-- **The continuation of an evaluation context.** The abstraction `λx. abort E[x]`, with the
context `E` shifted past the new binder. -/
def reify (E : ECtx) : Term :=
  .lam (.abort ((E.rename (· + 1)).plug (.var 0)))

end ECtx

/-- **Typing judgment of the calculus with callcc.** For an answer type `T`, the judgment
`HasType T Γ e A`, where the context `Γ` lists the types of the free de Bruijn variables (index
`0` first), is the least relation closed under the rules of the simply typed λ-calculus with
natural numbers (multiplication of two numbers is a number; the zero test takes a number and two
branches of a common type) and two rules for control: if `e` has type `(A → B) → A`, then
`callcc e` has type `A` (Wright and Felleisen, §6.2); if `e` has the answer type `T`, then
`abort e` has every type (Wright and Felleisen, Figure 7, with the single answer type `T`). -/
inductive HasType (T : Ty) : List Ty → Term → Ty → Prop
  /-- A variable has the type the context assigns to it. -/
  | var {Γ : List Ty} {i : ℕ} {A : Ty} (h : Γ[i]? = some A) : HasType T Γ (.var i) A
  /-- Abstraction. -/
  | lam {Γ : List Ty} {A B : Ty} {b : Term} (h : HasType T (A :: Γ) b B) :
      HasType T Γ (.lam b) (.arr A B)
  /-- Application. -/
  | app {Γ : List Ty} {A B : Ty} {f a : Term} (hf : HasType T Γ f (.arr A B))
      (ha : HasType T Γ a A) : HasType T Γ (.app f a) B
  /-- Numerals are numbers. -/
  | num {Γ : List Ty} {n : ℕ} : HasType T Γ (.num n) .nat
  /-- Multiplication of numbers. -/
  | mul {Γ : List Ty} {a b : Term} (ha : HasType T Γ a .nat) (hb : HasType T Γ b .nat) :
      HasType T Γ (.mul a b) .nat
  /-- The zero test. -/
  | ifz {Γ : List Ty} {A : Ty} {c t e : Term} (hc : HasType T Γ c .nat)
      (ht : HasType T Γ t A) (he : HasType T Γ e A) : HasType T Γ (.ifz c t e) A
  /-- `callcc` has the type of Peirce's law. -/
  | callcc {Γ : List Ty} {A B : Ty} {e : Term} (h : HasType T Γ e (.arr (.arr A B) A)) :
      HasType T Γ (.callcc e) A
  /-- `abort` of a term of the answer type has every type. -/
  | abort {Γ : List Ty} {B : Ty} {e : Term} (h : HasType T Γ e T) : HasType T Γ (.abort e) B

/-- **Local reductions.** β-reduction of an abstraction applied to a value, multiplication of
numerals, and the two zero-test rules. -/
inductive Red : Term → Term → Prop
  /-- β-reduction. -/
  | beta {b v : Term} (hv : v.Value) : Red (.app (.lam b) v) (b.instantiate v)
  /-- Multiplication of numerals. -/
  | mul {m n : ℕ} : Red (.mul (.num m) (.num n)) (.num (m * n))
  /-- The zero test at zero. -/
  | ifzZero {t e : Term} : Red (.ifz (.num 0) t e) t
  /-- The zero test at a successor. -/
  | ifzSucc {n : ℕ} {t e : Term} : Red (.ifz (.num (n + 1)) t e) e

/-- **Program steps of the calculus with callcc.** For an admissible evaluation context `E`: a
local reduction in the hole of `E`; `E[callcc v]` steps to `E[v (λx. abort E[x])]` for a value
`v` (Wright and Felleisen's rule callcc); and `E[abort e]` steps to `e` (rule abort). -/
inductive Step : Term → Term → Prop
  /-- A local reduction in an admissible context. -/
  | red {E : ECtx} {r r' : Term} (hE : E.Ok) (h : Red r r') : Step (E.plug r) (E.plug r')
  /-- `callcc` passes the current continuation. -/
  | callcc {E : ECtx} {v : Term} (hE : E.Ok) (hv : v.Value) :
      Step (E.plug (.callcc v)) (E.plug (.app v E.reify))
  /-- `abort` discards the current context. -/
  | abort {E : ECtx} {e : Term} (hE : E.Ok) : Step (E.plug (.abort e)) e

/-- **Typing of evaluation contexts.** For an answer type `T` and a context `Γ`,
`HasCtxType T Γ E A B` holds when plugging a term of type `A` into `E` gives a term of type `B`:
the empty context has type `A` to `A`, and each frame types its other subterms and passes the
type of the filled frame to the rest of the context. -/
inductive HasCtxType (T : Ty) : List Ty → ECtx → Ty → Ty → Prop
  /-- The hole. -/
  | nil {Γ : List Ty} {A : Ty} : HasCtxType T Γ [] A A
  /-- `□ a`. -/
  | appL {Γ : List Ty} {A B C : Ty} {a : Term} {E : ECtx} (ha : HasType T Γ a A)
      (hE : HasCtxType T Γ E B C) : HasCtxType T Γ (.appL a :: E) (.arr A B) C
  /-- `f □`. -/
  | appR {Γ : List Ty} {A B C : Ty} {f : Term} {E : ECtx} (hf : HasType T Γ f (.arr A B))
      (hE : HasCtxType T Γ E B C) : HasCtxType T Γ (.appR f :: E) A C
  /-- `□ * b`. -/
  | mulL {Γ : List Ty} {C : Ty} {b : Term} {E : ECtx} (hb : HasType T Γ b .nat)
      (hE : HasCtxType T Γ E .nat C) : HasCtxType T Γ (.mulL b :: E) .nat C
  /-- `a * □`. -/
  | mulR {Γ : List Ty} {C : Ty} {a : Term} {E : ECtx} (ha : HasType T Γ a .nat)
      (hE : HasCtxType T Γ E .nat C) : HasCtxType T Γ (.mulR a :: E) .nat C
  /-- `ifz □ t e`. -/
  | ifz {Γ : List Ty} {A C : Ty} {t e : Term} {E : ECtx} (ht : HasType T Γ t A)
      (he : HasType T Γ e A) (hE : HasCtxType T Γ E A C) :
      HasCtxType T Γ (.ifz t e :: E) .nat C
  /-- `callcc □`. -/
  | callcc {Γ : List Ty} {A B C : Ty} {E : ECtx} (hE : HasCtxType T Γ E A C) :
      HasCtxType T Γ (.callcc :: E) (.arr (.arr A B) A) C

end Cslib.Languages.LambdaCalculus.Callcc
