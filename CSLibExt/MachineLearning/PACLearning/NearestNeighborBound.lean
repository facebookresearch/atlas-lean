/-!
# Finite-sample risk of the 1-nearest-neighbor rule

We use the least-index tie convention of `oneNearestNeighbor`, so selecting an index depends
only on the observed features. In the binary case the label law conditional on a feature `x`
is Bernoulli with parameter `η x`. A Lipschitz posterior on the Euclidean unit cube gives the
finite-sample risk bound of Shalev-Shwartz and Ben-David, *Understanding Machine Learning:
From Theory to Algorithms* (2014), §§19.1–19.2, Theorem 19.3.
-/

set_option autoImplicit false

namespace Cslib.MachineLearning.PACLearning

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal NNReal

section ConditionalProduct

variable {I X Y : Type*} [Fintype I] [MeasurableSpace X] [MeasurableSpace Y]

private theorem measurable_conditionalPi (κ : Kernel X Y) [IsMarkovKernel κ] :
    Measurable (fun x : I → X => Measure.pi (fun i => κ (x i))) := by
  refine Measure.measurable_of_measurable_coe _ fun s hs => ?_
  refine MeasurableSpace.induction_on_inter
    (C := fun t _ => Measurable fun x : I → X => (Measure.pi fun i => κ (x i)) t)
    generateFrom_pi.symm isPiSystem_pi ?_ ?_ ?_ ?_ s hs
  · simp only [measure_empty, measurable_const]
  · rintro t ⟨u, hu, rfl⟩
    simp only [Set.mem_univ_pi, Set.mem_ofPred_eq] at hu
    simp only [Measure.pi_pi]
    exact Finset.measurable_prod _ fun i _ => (κ.measurable_coe (hu i)).comp (measurable_pi_apply i)
  · intro t ht ih
    have h (x : I → X) : (Measure.pi fun i => κ (x i)) tᶜ =
        1 - (Measure.pi fun i => κ (x i)) t := by
      rw [measure_compl ht (measure_ne_top _ _), measure_univ]
    simp_rw [h]
    exact measurable_const.sub ih
  · intro f hf hfm ih
    simp_rw [measure_iUnion hf hfm]
    exact Measurable.tsum ih

private noncomputable def conditionalPiKernel (I : Type*) [Fintype I]
    (κ : Kernel X Y) [IsMarkovKernel κ] : Kernel (I → X) (I → Y) :=
  ⟨fun x => Measure.pi (fun i => κ (x i)), measurable_conditionalPi κ⟩

@[simp] private theorem conditionalPiKernel_apply (κ : Kernel X Y) [IsMarkovKernel κ] (x : I → X) :
    conditionalPiKernel I κ x = Measure.pi (fun i => κ (x i)) := rfl

private instance (κ : Kernel X Y) [IsMarkovKernel κ] :
    IsMarkovKernel (conditionalPiKernel I κ) where
  isProbabilityMeasure x := by
    rw [conditionalPiKernel_apply]
    infer_instance

-- Independent joint draws can be generated by drawing the features first, then drawing each
-- label independently conditional on its feature.
private theorem pi_compProd_eq_map_conditionalPiKernel (I : Type*) [Fintype I]
    (μ : Measure X) [IsProbabilityMeasure μ] (κ : Kernel X Y) [IsMarkovKernel κ] :
    Measure.pi (fun _ : I => μ ⊗ₘ κ) =
      Measure.map (fun p : (I → X) × (I → Y) => fun i => (p.1 i, p.2 i))
        (Measure.pi (fun _ : I => μ) ⊗ₘ conditionalPiKernel I κ) := by
  let zip : (I → X) × (I → Y) → I → X × Y := fun p i => (p.1 i, p.2 i)
  have hzip : Measurable zip := measurable_pi_iff.mpr fun i =>
    ((measurable_pi_apply i).comp measurable_fst).prodMk
      ((measurable_pi_apply i).comp measurable_snd)
  change Measure.pi (fun _ : I => μ ⊗ₘ κ) =
    Measure.map zip (Measure.pi (fun _ : I => μ) ⊗ₘ conditionalPiKernel I κ)
  refine Measure.pi_eq fun s hs => ?_
  have hs' : MeasurableSet (Set.univ.pi s) := MeasurableSet.univ_pi hs
  have hsection (x : I → X) : Prod.mk x ⁻¹' (zip ⁻¹' Set.univ.pi s) =
      Set.univ.pi (fun i => Prod.mk (x i) ⁻¹' s i) := by
    ext y
    simp [zip]
  rw [Measure.map_apply hzip hs', Measure.compProd_apply (hs'.preimage hzip)]
  simp_rw [hsection, conditionalPiKernel_apply, Measure.pi_pi]
  rw [lintegral_fintype_prod_eq_prod (fun i => Kernel.measurable_kernel_prodMk_left (hs i))]
  exact Finset.prod_congr rfl fun i _ => (Measure.compProd_apply (hs i)).symm

end ConditionalProduct

section Binary

variable {X : Type*} [MeasurableSpace X]

/-- The conditional label kernel associated with a measurable binary posterior `η`. Given a
feature `x`, the probability of `true` is `η x` and that of `false` is `1 - η x`. The joint law
with feature marginal `μ` is the composition product of `μ` and this kernel. -/
@[expose] public noncomputable def binaryLabelKernel (η : X → unitInterval)
    (hη : Measurable η) : Kernel X Bool where
  toFun x := bernoulliMeasure true false (η x)
  measurable' := by
    apply Measure.measurable_of_measurable_coe
    intro s hs
    classical
    rw [show (fun x => bernoulliMeasure true false (η x) s) =
        fun x => (if true ∈ s then ENNReal.ofReal (η x : ℝ) else 0) +
          (if false ∈ s then ENNReal.ofReal (1 - (η x : ℝ)) else 0) by
      funext x
      rw [bernoulliMeasure_apply (η x) hs]
      have hp : ENNReal.ofReal (η x : ℝ) = ↑(unitInterval.toNNReal (η x)) :=
        ENNReal.ofReal_eq_coe_nnreal (η x).2.1
      have hq : ENNReal.ofReal (1 - (η x : ℝ)) =
          ↑(unitInterval.toNNReal (unitInterval.symm (η x))) :=
        ENNReal.ofReal_eq_coe_nnreal (sub_nonneg.mpr (η x).2.2)
      by_cases ht : true ∈ s <;> by_cases hf : false ∈ s
      · simp only [ht, hf, ite_true]
        rw [← ENNReal.ofReal_add (η x).2.1 (sub_nonneg.mpr (η x).2.2)]
        simp
      · simp only [ht, hf, ite_true, ite_false, add_zero, hp]
      · simp only [ht, hf, ite_true, ite_false, zero_add, hq]
      · simp only [ht, hf, ite_false, add_zero]]
    have hm := measurable_subtype_coe.comp hη
    apply Measurable.add
    · split_ifs <;> first | exact hm.ennreal_ofReal | exact measurable_const
    · split_ifs <;> first | exact (measurable_const.sub hm).ennreal_ofReal | exact measurable_const

public instance (η : X → unitInterval) (hη : Measurable η) :
    IsMarkovKernel (binaryLabelKernel η hη) where
  isProbabilityMeasure x := by
    change IsProbabilityMeasure (bernoulliMeasure true false (η x))
    infer_instance

-- A rectangle identity for one label determines the whole binary joint law: the feature
-- marginal is the sum of the two label slices.
private theorem eq_compProd_binaryLabelKernel (D : Measure (X × Bool)) [IsProbabilityMeasure D]
    (η : X → unitInterval) (hmeas : Measurable η)
    (hη : ∀ A : Set X, MeasurableSet A →
      D (A ×ˢ {true}) = ∫⁻ x in A, ENNReal.ofReal (η x : ℝ) ∂D.fst) :
    D = D.fst ⊗ₘ binaryLabelKernel η hmeas := by
  classical
  let E := D.fst ⊗ₘ binaryLabelKernel η hmeas
  have hTrue (A : Set X) (hA : MeasurableSet A) : D (A ×ˢ {true}) = E (A ×ˢ {true}) := by
    rw [hη A hA]
    change _ = (D.fst ⊗ₘ binaryLabelKernel η hmeas) (A ×ˢ {true})
    rw [Measure.compProd_apply_prod hA (measurableSet_singleton true)]
    apply lintegral_congr
    intro x
    change ENNReal.ofReal (η x : ℝ) = bernoulliMeasure true false (η x) {true}
    rw [bernoulliMeasure_apply_of_mem_of_notMem (η x) (measurableSet_singleton true)
      (by simp) (by simp)]
    exact ENNReal.ofReal_eq_coe_nnreal (η x).2.1
  have hAll (A : Set X) (hA : MeasurableSet A) : D (A ×ˢ univ) = E (A ×ˢ univ) := by
    rw [Set.prod_univ, ← Measure.fst_apply hA, ← Measure.fst_apply hA]
    exact congrArg (fun M : Measure X => M A) (Measure.fst_compProd _ _).symm
  have hFalse (A : Set X) (hA : MeasurableSet A) : D (A ×ˢ {false}) = E (A ×ˢ {false}) := by
    have hUnion : ({true} : Set Bool) ∪ {false} = univ := by
      ext b
      cases b <;> simp
    have hDisjoint : Disjoint (A ×ˢ ({true} : Set Bool)) (A ×ˢ {false}) := by
      refine Set.disjoint_left.mpr fun z ht hf => ?_
      have h1 : z.2 = true := ht.2
      have h2 : z.2 = false := hf.2
      simp [h1] at h2
    have h := hAll A hA
    rw [← hUnion, Set.prod_union,
      measure_union hDisjoint (hA.prod (measurableSet_singleton false)),
      measure_union hDisjoint (hA.prod (measurableSet_singleton false)), hTrue A hA] at h
    exact (ENNReal.add_right_inj (measure_ne_top E _)).mp h
  refine Measure.ext_prod fun {A B} hA _ => ?_
  by_cases ht : true ∈ B <;> by_cases hf : false ∈ B
  · have hB : B = univ := by
      ext b
      cases b <;> simp [ht, hf]
    simpa only [hB] using hAll A hA
  · have hB : B = {true} := by
      ext b
      cases b <;> simp [ht, hf]
    simpa only [hB] using hTrue A hA
  · have hB : B = {false} := by
      ext b
      cases b <;> simp [ht, hf]
    simpa only [hB] using hFalse A hA
  · have hB : B = ∅ := by
      ext b
      cases b <;> simp [ht, hf]
    rw [hB, Set.prod_empty, measure_empty, measure_empty]

private def mismatch (a b : Bool) : ℝ := if a ≠ b then 1 else 0

private theorem measurable_mismatch : Measurable (Function.uncurry mismatch) := by
  unfold Function.uncurry mismatch
  exact Measurable.ite (measurableSet_eq_fun measurable_fst measurable_snd).compl
    measurable_const measurable_const

private theorem mismatch_nonneg (a b : Bool) : 0 ≤ mismatch a b := by
  cases a <;> cases b <;> norm_num [mismatch]

private theorem mismatch_le_one (a b : Bool) : mismatch a b ≤ 1 := by
  cases a <;> cases b <;> norm_num [mismatch]

private theorem error_toReal_eq_integral_mismatch (D : Measure (X × Bool))
    [IsProbabilityMeasure D] {f : X → Bool} (hf : Measurable f) :
    (error D f).toReal = ∫ z, mismatch (f z.1) z.2 ∂D := by
  have hs : MeasurableSet {z : X × Bool | f z.1 ≠ z.2} :=
    (measurableSet_eq_fun (hf.comp measurable_fst) measurable_snd).compl
  rw [← risk_zeroOneLoss_eq_toReal_error D f hs]
  unfold CSLibExt.MachineLearning.GeneralizationBounds.risk
  congr 1
  funext z
  by_cases h : f z.1 = z.2 <;> simp [zeroOneLoss, mismatch, h]

private theorem integral_mismatch_bernoulli (p q : unitInterval) :
    (∫ a, ∫ b, mismatch a b ∂bernoulliMeasure true false q ∂bernoulliMeasure true false p) =
      (p : ℝ) * (1 - (q : ℝ)) + (1 - (p : ℝ)) * (q : ℝ) := by
  simp only [integral_bernoulliMeasure, smul_eq_mul]
  norm_num [mismatch]

private theorem bernoulli_mismatch_le (p q : unitInterval) :
    (p : ℝ) * (1 - (q : ℝ)) + (1 - (p : ℝ)) * (q : ℝ) ≤
      2 * min (p : ℝ) (1 - (p : ℝ)) + |(p : ℝ) - (q : ℝ)| := by
  have hp := p.property
  have hq := q.property
  obtain ⟨hp0, hp1⟩ := hp
  obtain ⟨hq0, hq1⟩ := hq
  by_cases h : (p : ℝ) ≤ 1 - (p : ℝ)
  · rw [min_eq_left h]
    have hdelta := neg_le_abs ((p : ℝ) - (q : ℝ))
    nlinarith only [hdelta, mul_nonneg hp0 hq0]
  · push Not at h
    rw [min_eq_right h.le]
    have hdelta := le_abs_self ((p : ℝ) - (q : ℝ))
    nlinarith only [hdelta, mul_nonneg (sub_nonneg.mpr hp1) (sub_nonneg.mpr hq1)]

private theorem bayesRisk_eq_integral_min (μ : Measure X) [IsProbabilityMeasure μ]
    (η : X → unitInterval) (hη : Measurable η) :
    (error (μ ⊗ₘ binaryLabelKernel η hη) (binaryBayesClassifier η)).toReal =
      ∫ x, min (η x : ℝ) (1 - (η x : ℝ)) ∂μ := by
  rw [error_toReal_eq_integral_mismatch _ (measurable_binaryBayesClassifier hη)]
  have hmeas : Measurable (fun z : X × Bool => mismatch (binaryBayesClassifier η z.1) z.2) :=
    measurable_mismatch.comp
      (((measurable_binaryBayesClassifier hη).comp measurable_fst).prodMk measurable_snd)
  have hInt : Integrable (fun z : X × Bool => mismatch (binaryBayesClassifier η z.1) z.2)
      (μ ⊗ₘ binaryLabelKernel η hη) := by
    refine Integrable.of_bound hmeas.aestronglyMeasurable 1 (.of_forall fun z => ?_)
    rw [Real.norm_of_nonneg (mismatch_nonneg _ _)]
    exact mismatch_le_one _ _
  rw [Measure.integral_compProd hInt]
  apply integral_congr_ae
  filter_upwards with x
  change (∫ y, mismatch (binaryBayesClassifier η x) y ∂bernoulliMeasure true false (η x)) = _
  rw [integral_bernoulliMeasure]
  unfold binaryBayesClassifier
  split_ifs with h
  · rw [min_eq_right (by linarith)]
    norm_num [mismatch, smul_eq_mul]
  · rw [min_eq_left (by linarith [le_of_not_gt h])]
    norm_num [mismatch, smul_eq_mul]

private theorem integral_optionPi {Y : Type*} [MeasurableSpace Y] {I : Type*} [Fintype I]
    (ν : Option I → Measure Y) [∀ i, IsProbabilityMeasure (ν i)] (f : ((I → Y) × Y) → ℝ) :
    (∫ y, f ((fun i => y (some i)), y none) ∂Measure.pi ν) =
      ∫ y, f y ∂(Measure.pi fun i => ν (some i)).prod (ν none) := by
  let e := MeasurableEquiv.piOptionEquivProd (fun _ : Option I => Y)
  change (∫ y, f (e y) ∂Measure.pi ν) = _
  rw [← Measure.pi_map_piOptionEquivProd ν, integral_map_equiv]
  change (∫ y, f (e (e.symm y)) ∂(Measure.pi fun i => ν (some i)).prod (ν none)) = _
  simp only [MeasurableEquiv.apply_symm_apply]

-- The querying label is a fresh draw, distinct from every training coordinate. On fixing the
-- features the index becomes deterministic, so only its coordinate marginal enters the loss.
private theorem integral_mismatch_optionPi {I : Type*} [Fintype I]
    (p : Option I → unitInterval) (i : I) :
    (∫ y, mismatch (y (some i)) (y none)
        ∂Measure.pi (fun j => bernoulliMeasure true false (p j))) =
      (p none : ℝ) * (1 - (p (some i) : ℝ)) +
        (1 - (p none : ℝ)) * (p (some i) : ℝ) := by
  let ν (j : Option I) := bernoulliMeasure true false (p j)
  change (∫ y, mismatch (y (some i)) (y none) ∂Measure.pi ν) = _
  rw [integral_optionPi ν (fun z => mismatch (z.1 i) z.2)]
  let train := Measure.pi (fun j : I => ν (some j))
  have hmeas : Measurable (fun z : (I → Bool) × Bool => mismatch (z.1 i) z.2) := by
    change Measurable ((Function.uncurry mismatch) ∘ fun z : (I → Bool) × Bool => (z.1 i, z.2))
    exact measurable_mismatch.comp
      (((measurable_pi_apply i).comp measurable_fst).prodMk measurable_snd)
  have hint : Integrable (fun z : (I → Bool) × Bool => mismatch (z.1 i) z.2)
      (train.prod (ν none)) := by
    refine Integrable.of_bound hmeas.aestronglyMeasurable 1 (.of_forall fun z => ?_)
    rw [Real.norm_of_nonneg (mismatch_nonneg _ _)]
    exact mismatch_le_one _ _
  rw [integral_prod _ hint]
  let g := fun a : Bool => ∫ b, mismatch a b ∂ν none
  have hg : Measurable g := measurable_of_countable g
  change (∫ y, g (Function.eval i y) ∂train) = _
  rw [← integral_map (measurable_pi_apply i).aemeasurable hg.aestronglyMeasurable,
    (measurePreserving_eval (fun j : I => ν (some j)) i).map_eq]
  change (∫ a, ∫ b, mismatch a b ∂bernoulliMeasure true false (p none)
    ∂bernoulliMeasure true false (p (some i))) = _
  rw [integral_mismatch_bernoulli]
  ring

end Binary

section Risk

variable {X : Type*} [PseudoMetricSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
  [SecondCountableTopology X] {m : ℕ} [NeZero m]

private noncomputable def optionNearestIndex (x : Option (Fin m) → X) : Fin m :=
  nearestNeighborIndex (fun i => x (some i)) (x none)

private theorem expectedRisk_eq_integral_conditional (μ : Measure X) [IsProbabilityMeasure μ]
    (η : X → unitInterval) (hη : Measurable η) :
    let D := μ ⊗ₘ binaryLabelKernel η hη
    (∫ S : LabeledSample X Bool m, (error D (oneNearestNeighbor S)).toReal
        ∂Measure.pi (fun _ : Fin m => D)) =
      ∫ x : Option (Fin m) → X,
        (η (x none) : ℝ) * (1 - (η (x (some (optionNearestIndex x))) : ℝ)) +
          (1 - (η (x none) : ℝ)) * (η (x (some (optionNearestIndex x))) : ℝ)
        ∂Measure.pi (fun _ : Option (Fin m) => μ) := by
  let D := μ ⊗ₘ binaryLabelKernel η hη
  let I := Option (Fin m)
  let sampleLaw := Measure.pi (fun _ : Fin m => D)
  let featuresLaw := Measure.pi (fun _ : I => μ)
  let labels := conditionalPiKernel I (binaryLabelKernel η hη)
  let jointLoss (p : LabeledSample X Bool m × (X × Bool)) : ℝ :=
    mismatch (oneNearestNeighbor p.1 p.2.1) p.2.2
  let F (z : I → X × Bool) : ℝ := jointLoss ((fun i => z (some i)), z none)
  let zip (p : (I → X) × (I → Bool)) (i : I) : X × Bool := (p.1 i, p.2 i)
  have hLearn : Measurable (fun p : LabeledSample X Bool m × (X × Bool) =>
      oneNearestNeighbor p.1 p.2.1) :=
    measurable_oneNearestNeighbor.comp (measurable_fst.prodMk measurable_snd.fst)
  have hJoint : Measurable jointLoss :=
    measurable_mismatch.comp (hLearn.prodMk measurable_snd.snd)
  have hInt : Integrable jointLoss (sampleLaw.prod D) := by
    refine Integrable.of_bound hJoint.aestronglyMeasurable 1 (.of_forall fun z => ?_)
    exact (Real.norm_of_nonneg (mismatch_nonneg _ _)).trans_le (mismatch_le_one _ _)
  have hF : Measurable F := hJoint.comp
    ((MeasurableEquiv.piOptionEquivProd (fun _ : I => X × Bool)).measurable)
  have hzip : Measurable zip := measurable_pi_iff.mpr fun i =>
    ((measurable_pi_apply i).comp measurable_fst).prodMk
      ((measurable_pi_apply i).comp measurable_snd)
  have hIntF : Integrable (F ∘ zip) (featuresLaw ⊗ₘ labels) := by
    refine Integrable.of_bound (hF.comp hzip).aestronglyMeasurable 1 (.of_forall fun z => ?_)
    exact (Real.norm_of_nonneg (mismatch_nonneg _ _)).trans_le (mismatch_le_one _ _)
  have hCond (x : I → X) :
      (∫ y, F (zip (x, y)) ∂labels x) =
        (η (x none) : ℝ) * (1 - (η (x (some (optionNearestIndex x))) : ℝ)) +
          (1 - (η (x none) : ℝ)) * (η (x (some (optionNearestIndex x))) : ℝ) := by
    dsimp only [labels, conditionalPiKernel_apply]
    change (∫ y, mismatch (y (some (optionNearestIndex x))) (y none)
      ∂Measure.pi (fun j => bernoulliMeasure true false (η (x j)))) = _
    exact integral_mismatch_optionPi (η ∘ x) (optionNearestIndex x)
  dsimp only
  change (∫ S, (error D (oneNearestNeighbor S)).toReal ∂sampleLaw) = _
  calc
    _ = ∫ z, jointLoss z ∂sampleLaw.prod D := by
      rw [integral_prod _ hInt]
      apply integral_congr_ae
      filter_upwards with S
      exact error_toReal_eq_integral_mismatch D
        (measurable_oneNearestNeighbor.comp (measurable_const.prodMk measurable_id))
    _ = ∫ z, F z ∂Measure.pi (fun _ : I => D) :=
      (integral_optionPi (fun _ : I => D) jointLoss).symm
    _ = ∫ z, F (zip z) ∂(featuresLaw ⊗ₘ labels) := by
      rw [show Measure.pi (fun _ : I => D) = (featuresLaw ⊗ₘ labels).map zip from
        pi_compProd_eq_map_conditionalPiKernel I μ (binaryLabelKernel η hη),
        integral_map hzip.aemeasurable hF.aestronglyMeasurable]
    _ = _ := by
      change (∫ z, (F ∘ zip) z ∂(featuresLaw ⊗ₘ labels)) = _
      rw [Measure.integral_compProd hIntF]
      exact integral_congr_ae (.of_forall hCond)

/-- For a constant binary posterior with probability `p` of label `true`, the expected risk
of the 1-nearest-neighbor rule is `2 * p * (1 - p)` for every nonempty independent training
sample. The training label selected using the features and the fresh query label are independent,
even when their features coincide. -/
public theorem expected_error_oneNearestNeighbor_const (μ : Measure X) [IsProbabilityMeasure μ]
    (p : unitInterval) :
    let D := μ ⊗ₘ binaryLabelKernel (fun _ : X => p) measurable_const
    (∫ S : LabeledSample X Bool m, (error D (oneNearestNeighbor S)).toReal
        ∂Measure.pi (fun _ : Fin m => D)) = 2 * (p : ℝ) * (1 - (p : ℝ)) := by
  dsimp only
  rw [expectedRisk_eq_integral_conditional μ (fun _ : X => p) measurable_const]
  simp only [integral_const, probReal_univ, one_smul]
  ring

end Risk

/-- **Finite-sample bound for 1-nearest-neighbor classification.** Let `μ` be any probability
law on the Euclidean unit cube, and let `η` be a `c`-Lipschitz version of the conditional
probability of label `true`. The joint law `D` is `μ` composed with the Bernoulli label kernel
at `η`. For a nonempty i.i.d. sample from `D`, the expected zero-one risk of the least-index
1-nearest-neighbor rule is at most twice the risk of the binary Bayes threshold plus
`4 c √d m^(-1/(d+1))`. The metric is Euclidean, and the query is independent of the sample.
No density assumption on `μ` is needed. -/
public theorem integral_error_oneNearestNeighbor_le {d m : ℕ} [NeZero m]
    (μ : Measure (NearestNeighborCube d)) [IsProbabilityMeasure μ]
    {η : NearestNeighborCube d → unitInterval} {c : ℝ≥0} (hη : LipschitzWith c η) :
    let D := μ ⊗ₘ binaryLabelKernel η hη.continuous.measurable
    (∫ S : LabeledSample (NearestNeighborCube d) Bool m,
        (error D (oneNearestNeighbor S)).toReal ∂Measure.pi (fun _ : Fin m => D)) ≤
      2 * (error D (binaryBayesClassifier η)).toReal +
        4 * (c : ℝ) * Real.sqrt d * (m : ℝ) ^ (-(1 / ((d : ℝ) + 1))) := by
  let X := NearestNeighborCube d
  let Ω := (Fin m → X) × X
  let ν := Measure.pi (fun _ : Fin m => μ)
  let posterior := binaryLabelKernel η hη.continuous.measurable
  let D := μ ⊗ₘ posterior
  let B (x : X) : ℝ := min (η x : ℝ) (1 - (η x : ℝ))
  let distNN (z : Ω) : ℝ := dist z.2 (z.1 (nearestNeighborIndex z.1 z.2))
  let G (z : Ω) : ℝ :=
    let p := (η z.2 : ℝ)
    let q := (η (z.1 (nearestNeighborIndex z.1 z.2)) : ℝ)
    p * (1 - q) + (1 - p) * q
  have hB_meas : Measurable B := by
    have hm : Measurable (fun x : X => (η x : ℝ)) :=
      measurable_subtype_coe.comp hη.continuous.measurable
    exact hm.min (measurable_const.sub hm)
  have hB : Integrable B μ := by
    refine Integrable.of_bound hB_meas.aestronglyMeasurable 1 (.of_forall fun x => ?_)
    have hx : 0 ≤ B x := le_min (η x).2.1 (sub_nonneg.mpr (η x).2.2)
    rw [Real.norm_of_nonneg hx]
    exact (min_le_left _ _).trans (η x).2.2
  have hDist : Integrable distNN (ν.prod μ) := integrable_nearestNeighborCube_dist μ
  have hBayesTerm : Integrable (fun z : Ω => 2 * B z.2) (ν.prod μ) :=
    (hB.const_mul 2).comp_snd ν
  have hDistanceTerm : Integrable (fun z : Ω => (c : ℝ) * distNN z) (ν.prod μ) :=
    hDist.const_mul _
  have hNonneg (z : Ω) : 0 ≤ G z := by
    dsimp only [G]
    exact add_nonneg (mul_nonneg (η z.2).2.1 (sub_nonneg.mpr (η _).2.2))
      (mul_nonneg (sub_nonneg.mpr (η z.2).2.2) (η _).2.1)
  have hPoint (z : Ω) : G z ≤ 2 * B z.2 + (c : ℝ) * distNN z := by
    let q := z.1 (nearestNeighborIndex z.1 z.2)
    calc
      _ ≤ 2 * B z.2 + |(η z.2 : ℝ) - (η q : ℝ)| := bernoulli_mismatch_le (η z.2) (η q)
      _ ≤ _ := by
        apply add_le_add_right
        have hl := hη.dist_le_mul z.2 q
        change dist ((η z.2 : ℝ)) ((η q : ℝ)) ≤ (c : ℝ) * distNN z at hl
        simpa only [Real.dist_eq] using hl
  dsimp only
  change (∫ S, (error D (oneNearestNeighbor S)).toReal ∂Measure.pi (fun _ : Fin m => D)) ≤ _
  calc
    _ = ∫ z, G z ∂ν.prod μ := by
      rw [expectedRisk_eq_integral_conditional μ η hη.continuous.measurable]
      exact integral_optionPi (fun _ : Option (Fin m) => μ) G
    _ ≤ ∫ z, 2 * B z.2 + (c : ℝ) * distNN z ∂ν.prod μ :=
      integral_mono_of_nonneg (.of_forall hNonneg) (hBayesTerm.add hDistanceTerm)
        (.of_forall hPoint)
    _ = 2 * (error D (binaryBayesClassifier η)).toReal + (c : ℝ) * ∫ z, distNN z ∂ν.prod μ := by
      have hSnd : (∫ z : Ω, 2 * B z.2 ∂ν.prod μ) = ∫ x, 2 * B x ∂μ := by
        simpa only [probReal_univ, one_smul] using
          (integral_fun_snd (μ := ν) (ν := μ) (fun x => 2 * B x))
      have hBayes : (error D (binaryBayesClassifier η)).toReal = ∫ x, B x ∂μ :=
        bayesRisk_eq_integral_min μ η hη.continuous.measurable
      rw [integral_add hBayesTerm hDistanceTerm, hSnd, integral_const_mul,
        integral_const_mul, hBayes]
    _ ≤ _ := by
      apply add_le_add_right
      calc
        _ ≤ (c : ℝ) * (4 * Real.sqrt d * (m : ℝ) ^ (-(1 / ((d : ℝ) + 1)))) :=
          mul_le_mul_of_nonneg_left (integral_nearestNeighborCube_dist_le μ) c.2
        _ = _ := by ring

/-- **Finite-sample bound for the 1-nearest-neighbor rule** (Shalev-Shwartz and Ben-David,
Theorem 19.3). For a probability law `D` on the Euclidean Borel unit cube and binary labels,
let `η` be a `c`-Lipschitz version of the conditional probability of label `true`, specified
by its integral over every measurable feature set. The expected 0-1 risk of the least-index
1-nearest-neighbor rule on `m` independent draws from `D` is at most twice the risk of the
binary Bayes threshold plus `4 c √d m^(-1/(d+1))`. The positive dimension and positive
Lipschitz constant are the hypotheses of the textbook statement; the proof also allows
zero in either case. -/
public theorem expected_error_oneNearestNeighbor_le {d m : ℕ} (_hd : 0 < d) [NeZero m]
    (D : Measure (NearestNeighborCube d × Bool)) [IsProbabilityMeasure D]
    (η : NearestNeighborCube d → unitInterval) {c : ℝ≥0} (_hc : 0 < c) (hLip : LipschitzWith c η)
    (hη : ∀ A : Set (NearestNeighborCube d), MeasurableSet A →
      D (A ×ˢ {true}) = ∫⁻ x in A, ENNReal.ofReal (η x : ℝ) ∂D.fst) :
    (∫ S, (error D (oneNearestNeighbor S)).toReal ∂(Measure.pi fun _ : Fin m => D)) ≤
      2 * (error D (binaryBayesClassifier η)).toReal +
        4 * (c : ℝ) * Real.sqrt d * (m : ℝ) ^ (-1 / ((d : ℝ) + 1)) := by
  rw [eq_compProd_binaryLabelKernel D η hLip.continuous.measurable hη]
  simpa only [neg_div] using integral_error_oneNearestNeighbor_le (m := m) D.fst hLip

