/-- The second term of eq. (4), attained with two linear pieces. -/
theorem lowerAttained_1 : LowerAttained 1 := by
  intro w hw hs h
  obtain ⟨hnn, hnf, hnt, hiv1, hiv2, hiv3, hiv4⟩ := obsForm_facts hw hs
  have h0 := h 0
  have h2 := h 2
  have h6 := h 6
  have h7 := h 7
  simp [lowerTerms] at h0 h2 h6 h7
  rcases le_total (obsForm w false false false + obsForm w false true false -
      obsForm w false false true) (obsForm w true false true) with hcell | hcell
  · refine ⟨bp_aux_wit1A (obsForm w), ?_, ?_, ?_⟩
    · intro t
      obtain ⟨i, j⟩ := t
      fin_cases i <;> fin_cases j <;> simp [bp_aux_wit1A] <;>
        linarith [hnn false false false, hnn false true false, hnn true false false,
          hnn true true false, hnn false false true, hnn false true true, hnn true false true,
          hnn true true true, hnf, hnt, hiv1, hiv2, hiv3, hiv4, h0, h2, h6, h7, hcell]
    · funext y d z
      cases y <;> cases d <;> cases z <;>
        simp [bp_aux_wit1A, obsForm_fff, obsForm_ftf, obsForm_tff, obsForm_ttf, obsForm_fft,
          obsForm_ftt, obsForm_tft, obsForm_ttt] <;>
        ring
    · simp [aceForm_eq, bp_aux_wit1A, lowerTerms]
      linarith [hnt]
  · refine ⟨bp_aux_wit1B (obsForm w), ?_, ?_, ?_⟩
    · intro t
      obtain ⟨i, j⟩ := t
      fin_cases i <;> fin_cases j <;> simp [bp_aux_wit1B] <;>
        linarith [hnn false false false, hnn false true false, hnn true false false,
          hnn true true false, hnn false false true, hnn false true true, hnn true false true,
