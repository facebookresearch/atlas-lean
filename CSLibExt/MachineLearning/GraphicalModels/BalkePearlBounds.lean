  intro w hw hs h
  obtain ⟨hnn, n0, n1, -, -, -, -⟩ := obsForm_facts hw hs
  set p : ObsLaw := obsForm w with hp_def
  have qfff := hnn false false false
  have qftf := hnn false true false
  have qtff := hnn true false false
  have qttf := hnn true true false
  have qfft := hnn false false true
  have qftt := hnn false true true
  have qtft := hnn true false true
  have qttt := hnn true true true
  have h1 : p false false true + p true true true - 1 ≤
      p true true false + p false false true - 1 := h 1
  have h3 : p false false false + p true true false - 1 ≤
      p true true false + p false false true - 1 := h 3
  have h5 : p false false false + 2 * p true true false + p false false true +
      p false true true - 2 ≤ p true true false + p false false true - 1 := h 5
