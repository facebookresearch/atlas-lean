      p true true true - 2 ≤ p true true false + p false false true - 1 := h 6
  rcases le_total (p false true true) (p true false false) with hs1 | hs1
  · rcases le_total (p true true false + p false false false)
        (p false false true + p true true true) with hs2 | hs2
    · refine ⟨fun t => ((![![p false false false, 0,
          p true false false - p false true true, 0],
