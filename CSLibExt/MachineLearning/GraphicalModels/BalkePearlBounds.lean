      · have hx := obsForm_ftf (bp_aux_u2a (obsForm w)); rw [hx]; simp [bp_aux_u2a]
      · have hx := obsForm_ftt (bp_aux_u2a (obsForm w)); rw [hx]; simp [bp_aux_u2a]
      · have hx := obsForm_tff (bp_aux_u2a (obsForm w)); rw [hx]; simp [bp_aux_u2a]
      · have hx := obsForm_tft (bp_aux_u2a (obsForm w)); rw [hx]; simp [bp_aux_u2a]
      · have hx := obsForm_ttf (bp_aux_u2a (obsForm w)); rw [hx]; simp [bp_aux_u2a]
      · have hx := obsForm_ttt (bp_aux_u2a (obsForm w)); rw [hx]; simp [bp_aux_u2a]; linarith [hn0, hn1]
    · have ha := aceForm_eq (bp_aux_u2a (obsForm w))
      rw [ha]
      simp [bp_aux_u2a, upperTerms]
      linarith [hn0, hn1]
  · refine ⟨bp_aux_u2b (obsForm w), ?_, ?_, ?_⟩
    · intro t
      obtain ⟨i, j⟩ := t
      fin_cases i <;> fin_cases j <;> simp [bp_aux_u2b] <;> linarith [n_fff, n_ftf, n_tff, n_ttf, n_fft, n_ftt, n_tft, n_ttt, hn0, hn1, h0, h1, h4, h5, hcell]
    · funext y d z
      cases y <;> cases d <;> cases z
      · have hx := obsForm_fff (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_fft (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_ftf (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_ftt (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_tff (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_tft (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_ttf (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]
      · have hx := obsForm_ttt (bp_aux_u2b (obsForm w)); rw [hx]; simp [bp_aux_u2b]; linarith [hn0, hn1]
    · have ha := aceForm_eq (bp_aux_u2b (obsForm w))
      rw [ha]
      simp [bp_aux_u2b, upperTerms]
      linarith [hn0, hn1]

private noncomputable def bp_aux_u3a (p : ObsLaw) : RespType → ℝ := fun t =>
  (![![0, 0, 0, p true false false],
    ![p false true true - p false true false, p false false false - p false true true + p false true false, 0, 0],
    ![0, p false false true, 0, p true false true - p true false false],
    ![p false true false, p true true true - p false false false + p false true true - p false true false, 0, 0]] : Fin 4 → Fin 4 → ℝ) t.1 t.2

private noncomputable def bp_aux_u3b (p : ObsLaw) : RespType → ℝ := fun t =>
  (![![0, p false false false - p true true true - p false true true + p false true false, 0, p true false false],
    ![p false true true - p false true false, p true true true, 0, 0],
    ![0, p false false true - p false false false + p true true true + p false true true - p false true false, 0, p true false true - p true false false],
    ![p false true false, 0, 0, 0]] : Fin 4 → Fin 4 → ℝ) t.1 t.2

/-- The fourth term of eq. (5), attained with two linear pieces. -/
theorem upperAttained_3 : UpperAttained 3 := by
  intro w hw hs h
  have hp := obsForm_facts hw hs
  obtain ⟨hnn, hn0, hn1, hiv0, hiv1, hiv2, hiv3⟩ := hp
  have n_fff := hnn false false false
  have n_ftf := hnn false true false
  have n_tff := hnn true false false
  have n_ttf := hnn true true false
  have n_fft := hnn false false true
  have n_ftt := hnn false true true
  have n_tft := hnn true false true
  have n_ttt := hnn true true true
  have h0 := h 0
  have h1 := h 1
  have h6 := h 6
  have h7 := h 7
  simp [upperTerms] at h0 h1 h6 h7
  rcases le_total (obsForm w false false false - obsForm w true true true - obsForm w false true true + obsForm w false true false) 0 with hcell | hcell
  · refine ⟨bp_aux_u3a (obsForm w), ?_, ?_, ?_⟩
    · intro t
      obtain ⟨i, j⟩ := t
      fin_cases i <;> fin_cases j <;> simp [bp_aux_u3a] <;> linarith [n_fff, n_ftf, n_tff, n_ttf, n_fft, n_ftt, n_tft, n_ttt, hn0, hn1, h0, h1, h6, h7, hcell]
    · funext y d z
      cases y <;> cases d <;> cases z
      · have hx := obsForm_fff (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
      · have hx := obsForm_fft (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
      · have hx := obsForm_ftf (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
      · have hx := obsForm_ftt (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
      · have hx := obsForm_tff (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
      · have hx := obsForm_tft (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
      · have hx := obsForm_ttf (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]; linarith [hn0, hn1]
      · have hx := obsForm_ttt (bp_aux_u3a (obsForm w)); rw [hx]; simp [bp_aux_u3a]
    · have ha := aceForm_eq (bp_aux_u3a (obsForm w))
      rw [ha]
      simp [bp_aux_u3a, upperTerms]
      linarith [hn0, hn1]
  · refine ⟨bp_aux_u3b (obsForm w), ?_, ?_, ?_⟩
    · intro t
      obtain ⟨i, j⟩ := t
      fin_cases i <;> fin_cases j <;> simp [bp_aux_u3b] <;> linarith [n_fff, n_ftf, n_tff, n_ttf, n_fft, n_ftt, n_tft, n_ttt, hn0, hn1, h0, h1, h6, h7, hcell]
    · funext y d z
      cases y <;> cases d <;> cases z
      · have hx := obsForm_fff (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
      · have hx := obsForm_fft (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
      · have hx := obsForm_ftf (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
      · have hx := obsForm_ftt (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
      · have hx := obsForm_tff (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
      · have hx := obsForm_tft (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
      · have hx := obsForm_ttf (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]; linarith [hn0, hn1]
      · have hx := obsForm_ttt (bp_aux_u3b (obsForm w)); rw [hx]; simp [bp_aux_u3b]
    · have ha := aceForm_eq (bp_aux_u3b (obsForm w))
      rw [ha]
      simp [bp_aux_u3b, upperTerms]
      linarith [hn0, hn1]

theorem lowerAttained (i : Fin 8) : LowerAttained i := by
  fin_cases i
  · exact lowerAttained_0
  · exact lowerAttained_1
  · exact lowerAttained_2
  · exact lowerAttained_3
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessL5_spec hw hs h
    exact ⟨witnessL5 (obsForm w), h0, hobs, hace⟩
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessL6_spec hw hs h
    exact ⟨witnessL6 (obsForm w), h0, hobs, hace⟩
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessL7_spec hw hs h
    exact ⟨witnessL7 (obsForm w), h0, hobs, hace⟩
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessL8_spec hw hs h
    exact ⟨witnessL8 (obsForm w), h0, hobs, hace⟩

theorem upperAttained (i : Fin 8) : UpperAttained i := by
  fin_cases i
  · exact upperAttained_0
  · exact upperAttained_1
  · exact upperAttained_2
  · exact upperAttained_3
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessU5_spec hw hs h
    exact ⟨witnessU5 (obsForm w), h0, hobs, hace⟩
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessU6_spec hw hs h
    exact ⟨witnessU6 (obsForm w), h0, hobs, hace⟩
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessU7_spec hw hs h
    exact ⟨witnessU7 (obsForm w), h0, hobs, hace⟩
  · intro w hw hs h
    obtain ⟨h0, hobs, hace⟩ := witnessU8_spec hw hs h
    exact ⟨witnessU8 (obsForm w), h0, hobs, hace⟩

/-- **Sharpness**: eq. (4) is the optimal value of `min {ACE(q) | q ∈ Δ₁₅, obs q = p}`. -/
theorem isLeast_ace_fiber {p : ObsLaw} (hp : Compatible p) :
    IsLeast (TypeLaw.ace '' fiber p) (lowerBound p) := by
  obtain ⟨q, hq⟩ := hp
  have hqp : obsForm ⇑q.weights = p := hq
  obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_sup' Finset.univ_nonempty (lowerTerms p)
  have hi' : lowerTerms p i = lowerBound p := hi.symm
  have hw0 : ∀ t, 0 ≤ ⇑q.weights t := fun t => q.nonneg t
  have hs : ∑ t, ⇑q.weights t = 1 := q.total_of_fintype
  have hmax : ∀ j, lowerTerms (obsForm ⇑q.weights) j ≤ lowerTerms (obsForm ⇑q.weights) i := by
    intro j
    rw [hqp, hi']
    exact Finset.le_sup' _ (Finset.mem_univ j)
  obtain ⟨v, hv0, hobs, hace⟩ := lowerAttained i hw0 hs hmax
  have hsum : ∑ t, v t = 1 := (sum_eq_of_obsForm_eq hobs).trans hs
  refine ⟨?_, ?_⟩
  · refine ⟨StdSimplex.ofWeights v hv0 hsum, ?_, ?_⟩
    · show TypeLaw.obs (StdSimplex.ofWeights v hv0 hsum) = p
      have e : ⇑(StdSimplex.ofWeights v hv0 hsum).weights = v :=
        funext (StdSimplex.ofWeights_weights v hv0 hsum)
      show obsForm ⇑(StdSimplex.ofWeights v hv0 hsum).weights = p
      rw [e, hobs, hqp]
    · show TypeLaw.ace (StdSimplex.ofWeights v hv0 hsum) = lowerBound p
      have e : ⇑(StdSimplex.ofWeights v hv0 hsum).weights = v :=
        funext (StdSimplex.ofWeights_weights v hv0 hsum)
      show aceForm ⇑(StdSimplex.ofWeights v hv0 hsum).weights = lowerBound p
      rw [e, hace, hqp]
      exact hi'
  · intro x hx
    obtain ⟨r, hr, heq⟩ := hx
    rw [← heq]
    have hle := lowerBound_le_ace r
    have hrob : r.obs = p := hr
    rw [hrob] at hle
    exact hle

/-- **Sharpness**: eq. (5) is the optimal value of `max {ACE(q) | q ∈ Δ₁₅, obs q = p}`. -/
theorem isGreatest_ace_fiber {p : ObsLaw} (hp : Compatible p) :
    IsGreatest (TypeLaw.ace '' fiber p) (upperBound p) := by
  obtain ⟨q, hq⟩ := hp
  have hqp : obsForm ⇑q.weights = p := hq
  obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_inf' Finset.univ_nonempty (upperTerms p)
  have hi' : upperTerms p i = upperBound p := hi.symm
  have hw0 : ∀ t, 0 ≤ ⇑q.weights t := fun t => q.nonneg t
  have hs : ∑ t, ⇑q.weights t = 1 := q.total_of_fintype
  have hmin : ∀ j, upperTerms (obsForm ⇑q.weights) i ≤ upperTerms (obsForm ⇑q.weights) j := by
    intro j
    rw [hqp, hi']
    exact Finset.inf'_le _ (Finset.mem_univ j)
  obtain ⟨v, hv0, hobs, hace⟩ := upperAttained i hw0 hs hmin
  have hsum : ∑ t, v t = 1 := (sum_eq_of_obsForm_eq hobs).trans hs
  refine ⟨?_, ?_⟩
  · refine ⟨StdSimplex.ofWeights v hv0 hsum, ?_, ?_⟩
    · show TypeLaw.obs (StdSimplex.ofWeights v hv0 hsum) = p
      have e : ⇑(StdSimplex.ofWeights v hv0 hsum).weights = v :=
        funext (StdSimplex.ofWeights_weights v hv0 hsum)
      show obsForm ⇑(StdSimplex.ofWeights v hv0 hsum).weights = p
      rw [e, hobs, hqp]
    · show TypeLaw.ace (StdSimplex.ofWeights v hv0 hsum) = upperBound p
      have e : ⇑(StdSimplex.ofWeights v hv0 hsum).weights = v :=
        funext (StdSimplex.ofWeights_weights v hv0 hsum)
      show aceForm ⇑(StdSimplex.ofWeights v hv0 hsum).weights = upperBound p
      rw [e, hace, hqp]
      exact hi'
  · intro x hx
    obtain ⟨r, hr, heq⟩ := hx
    rw [← heq]
    have hle := ace_le_upperBound r
    have hrob : r.obs = p := hr
    rw [hrob] at hle
    exact hle

/-- Balke and Pearl (1997), Section 4.1, Table 2 (vitamin A supplementation), `p y d z`. The journal
scan prints `p01.1` as `0` in Table 2, which would make the `z₁` column total `.9990`; Table 1 gives
`12/12094` and the paper's bound values use `.0010`, the value used here. -/
noncomputable def vitaminA : ObsLaw
  | false, false, false => 0.0064
  | true, false, false => 0.9936
  | false, true, false => 0
  | true, true, false => 0
  | false, false, true => 0.0028
  | true, false, true => 0.1972
  | false, true, true => 0.0010
  | true, true, true => 0.7990

private noncomputable def bp_aux_vitA : RespType → ℝ := fun t =>
  (![![7/2500, 0, 493/2500, 0], ![1/1000, 13/5000, 0, 1991/2500], ![0, 0, 0, 0],
    ![0, 0, 0, 0]] : Fin 4 → Fin 4 → ℝ) t.1 t.2

theorem vitaminA_compatible : Compatible vitaminA := by
  have h0 : ∀ t, 0 ≤ bp_aux_vitA t := by
    intro t
    obtain ⟨i, j⟩ := t
    fin_cases i <;> fin_cases j <;> norm_num [bp_aux_vitA]
  have h1 : ∑ t, bp_aux_vitA t = 1 := by
    rw [sum_weights_eq]
    norm_num [bp_aux_vitA]
  have hw : ∀ t : RespType,
      (StdSimplex.ofWeights bp_aux_vitA h0 h1).weights t = bp_aux_vitA t :=
    fun t => StdSimplex.ofWeights_weights _ _ _ t
  have hmem : TypeLaw.obs (StdSimplex.ofWeights bp_aux_vitA h0 h1) = vitaminA := by
    simp only [TypeLaw.obs]
    funext y d z
    cases y <;> cases d <;> cases z <;>
      simp [obsForm_fff, obsForm_ftf, obsForm_tff, obsForm_ttf, obsForm_fft, obsForm_ftt,
        obsForm_tft, obsForm_ttt, hw, bp_aux_vitA, vitaminA] <;>
      norm_num
  exact ⟨_, hmem⟩

/-- Balke and Pearl (1997), Section 4.1: `-0.1946 ≤ ACE ≤ 0.0054`, both attained. -/
theorem vitaminA_bounds :
    lowerBound vitaminA = -0.1946 ∧ upperBound vitaminA = 0.0054 := by
  constructor
  · rw [lowerBound]
    apply le_antisymm
    · apply Finset.sup'_le
      intro b _
      fin_cases b <;> simp [lowerTerms, vitaminA] <;> norm_num
    · have hval : lowerTerms vitaminA 0 = -0.1946 := by
        simp [lowerTerms, vitaminA]
        norm_num
      have h0 := Finset.le_sup' (lowerTerms vitaminA) (Finset.mem_univ (0 : Fin 8))
      rw [hval] at h0
      exact h0
  · rw [upperBound]
    apply le_antisymm
    · have hval : upperTerms vitaminA 0 = 0.0054 := by
        simp [upperTerms, vitaminA]
        norm_num
      have h0 := Finset.inf'_le (upperTerms vitaminA) (Finset.mem_univ (0 : Fin 8))
      rw [hval] at h0
      exact h0
    · apply Finset.le_inf'
      intro b _
      fin_cases b <;> simp [upperTerms, vitaminA] <;> norm_num

/-- A binary IV structural model with finite latent noise (Balke and Pearl 1997, Section 2,
Figure 1): the noise law does not depend on `z` (`Z ⊥ U`), `D = f_D(z, u)`, `Y = f_Y(d, u)`
(exclusion). -/
structure BinaryIVModel (U : Type*) where
  noise : StdSimplex ℝ U
  fD : Bool → U → Bool
  fY : Bool → U → Bool

namespace BinaryIVModel

variable {U : Type*} [Fintype U]

/-- Balke and Pearl (1997), eq. (1). -/
noncomputable def obs (M : BinaryIVModel U) : ObsLaw := fun y d z =>
  ∑ u, if M.fD z u = d ∧ M.fY d u = y then M.noise.weights u else 0

/-- Balke and Pearl (1997), eq. (3). -/
noncomputable def ace (M : BinaryIVModel U) : ℝ :=
  (∑ u, if M.fY true u = true then M.noise.weights u else 0) -
    ∑ u, if M.fY false u = true then M.noise.weights u else 0

/-- The response type `r ∈ {0,1,2,3}` of a Boolean response function. -/
def classify (f : Bool → Bool) : Fin 4 :=
  match f false, f true with
  | false, false => 0
  | false, true => 1
  | true, false => 2
  | true, true => 3

/-- The sixteen-class reduction: the push-forward of the noise law to response types. -/
noncomputable def typeLaw (M : BinaryIVModel U) : TypeLaw :=
  M.noise.map fun u => (classify (M.fD · u), classify (M.fY · u))

private theorem bp_aux_classify_treat (f : Bool → Bool) (z : Bool) :
    treatResponse (classify f) z = f z := by
  cases h0 : f false <;> cases h1 : f true <;> cases z <;> simp_all [classify, treatResponse]

private theorem bp_aux_classify_outcome (f : Bool → Bool) (d : Bool) :
    outcomeResponse (classify f) d = f d := by
  cases h0 : f false <;> cases h1 : f true <;> cases d <;> simp_all [classify, outcomeResponse]

private theorem bp_aux_map_fiber {U : Type*} [Fintype U] (v : U →₀ ℝ) (g : U → RespType)
    (P : RespType → Prop) [DecidablePred P] (Q : U → Prop) [DecidablePred Q]
    (hPQ : ∀ u, P (g u) ↔ Q u) :
    (∑ t : RespType, if P t then v.mapDomain g t else 0)
      = ∑ u : U, if Q u then v u else 0 := by
  have hmap : ∀ t : RespType, v.mapDomain g t = ∑ u : U, if g u = t then v u else 0 := by
    intro t
    rw [Finsupp.mapDomain_apply,
      Finsupp.sum_fintype v (fun a m => (Finsupp.single (g a) m) t) (fun u => by simp)]
    apply Finset.sum_congr rfl
    intro u _
    simp only [Finsupp.single_apply]
  have hpush : ∀ t : RespType,
      (if P t then (∑ u : U, if g u = t then v u else 0) else 0)
        = ∑ u : U, (if P t then (if g u = t then v u else 0) else 0) := by
    intro t
    by_cases hP : P t <;> simp [hP]
  have hF : ∀ u : U, ∀ t : RespType,
      (if P t then (if g u = t then v u else 0) else 0)
        = if g u = t then (if P (g u) then v u else 0) else 0 := by
    intro u t
    by_cases h : g u = t <;> by_cases hP : P t <;> simp [h, hP]
  simp_rw [hmap, hpush]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro u _
  simp_rw [hF u]
  rw [Finset.sum_ite_eq]
  simp [hPQ u]

theorem typeLaw_obs (M : BinaryIVModel U) : M.typeLaw.obs = M.obs := by
  funext y d z
  simp only [TypeLaw.obs, BinaryIVModel.obs, BinaryIVModel.typeLaw, obsForm,
    StdSimplex.weights_map]
  have hPQ : ∀ u : U,
      (treatResponse (classify (M.fD · u)) z = d ∧
        outcomeResponse (classify (M.fY · u)) d = y) ↔
        (M.fD z u = d ∧ M.fY d u = y) := by
    intro u
    simp only [bp_aux_classify_treat, bp_aux_classify_outcome]
  exact bp_aux_map_fiber M.noise.weights (fun u => (classify (M.fD · u), classify (M.fY · u)))
    (fun t => treatResponse t.1 z = d ∧ outcomeResponse t.2 d = y)
    (fun u => M.fD z u = d ∧ M.fY d u = y) hPQ

theorem typeLaw_ace (M : BinaryIVModel U) : M.typeLaw.ace = M.ace := by
  simp only [TypeLaw.ace, BinaryIVModel.ace, BinaryIVModel.typeLaw, aceForm, doForm,
    StdSimplex.weights_map]
  congr 1
  · exact bp_aux_map_fiber M.noise.weights (fun u => (classify (M.fD · u), classify (M.fY · u)))
      (fun t => outcomeResponse t.2 true = true) (fun u => M.fY true u = true) (fun u => by
        simp only [bp_aux_classify_outcome])
  · exact bp_aux_map_fiber M.noise.weights (fun u => (classify (M.fD · u), classify (M.fY · u)))
      (fun t => outcomeResponse t.2 false = true) (fun u => M.fY false u = true) (fun u => by
        simp only [bp_aux_classify_outcome])

end BinaryIVModel

end Cslib.MachineLearning.GraphicalModels.BalkePearl
