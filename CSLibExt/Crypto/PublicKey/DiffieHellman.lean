module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Diffie–Hellman key agreement and exponentiation by `ZMod q`

In a finite group of order `q` generated by `g`, exponents live in `ZMod q`: `gpow g a = g ^ a.val`.

* `gpow_add`, `gpow_mul`: when `g ^ q = 1`, `gpow g` is additive and
  `gpow (gpow g a) b = gpow g (a b)`.
* `dh_agree` (**correctness of Diffie–Hellman key agreement**, Katz and Lindell, Construction
  10.2): Alice, holding `a` and receiving `B = g ^ b`, and Bob, holding `b` and receiving
  `A = g ^ a`, compute the same key; `dh_key_eq`: that key is `g ^ (a b)`.
* `gpowEquiv`: if `g` generates `G` and `|G| = q`, then `gpow g : ZMod q ≃ G` (discrete logarithm
  as its inverse), so a uniform exponent gives a uniform group element. It is Mathlib's
  `zmodMulEquivOfGenerator`, written with `ZMod q` exponents.

The decisional Diffie–Hellman experiments are in `ElGamal.lean`. This file proves the arithmetic
of the key agreement; a model of the protocol as a stateful process is not attempted here.

## References

* J. Katz and Y. Lindell, *Introduction to Modern Cryptography*, 2nd ed., CRC Press, 2014,
  Sections 8.3 and 10.3.
-/

@[expose] public section

namespace Cslib.Crypto.PublicKey

variable {G : Type*} [Group G] {q : ℕ}

/-- Exponentiation by an exponent in `ZMod q`: `gpow g a = g ^ a.val`. -/
def gpow (g : G) (a : ZMod q) : G := g ^ a.val

@[simp]
theorem gpow_zero (g : G) : gpow g (0 : ZMod q) = 1 := by simp [gpow]

theorem gpow_add [NeZero q] {g : G} (hg : g ^ q = 1) (a b : ZMod q) :
    gpow g (a + b) = gpow g a * gpow g b := by
  rw [gpow, ZMod.val_add, ← pow_eq_pow_mod _ hg, pow_add]
  rfl

theorem gpow_mul {g : G} (hg : g ^ q = 1) (a b : ZMod q) :
    gpow g (a * b) = gpow (gpow g a) b := by
  rw [gpow, gpow, gpow, ZMod.val_mul, ← pow_eq_pow_mod _ hg, pow_mul]

theorem gpow_pow_eq_one {g : G} (hg : g ^ q = 1) (a : ZMod q) : gpow g a ^ q = 1 := by
  rw [gpow, ← pow_mul, mul_comm, pow_mul, hg, one_pow]

/-- **Correctness of Diffie–Hellman key agreement**: `(g ^ b) ^ a = (g ^ a) ^ b`. -/
theorem dh_agree (g : G) (a b : ZMod q) : gpow (gpow g b) a = gpow (gpow g a) b := by
  simp only [gpow, ← pow_mul, mul_comm]

/-- The shared Diffie–Hellman key is `g ^ (a b)`. -/
theorem dh_key_eq {g : G} (hg : g ^ q = 1) (a b : ZMod q) :
    gpow (gpow g b) a = gpow g (a * b) := by
  rw [dh_agree, gpow_mul hg]

section Generator

variable [Fintype G] [NeZero q] {g : G}

/-- If `g` generates `G` and `|G| = q`, then `gpow g` is a bijection `ZMod q ≃ G`; its inverse
is the discrete logarithm to base `g`. This is Mathlib's `zmodMulEquivOfGenerator`. -/
noncomputable def gpowEquiv (hgen : ∀ x : G, x ∈ Subgroup.zpowers g)
    (hcard : Fintype.card G = q) : ZMod q ≃ G :=
  Multiplicative.ofAdd.trans
    (zmodMulEquivOfGenerator hgen (Nat.card_eq_fintype_card.trans hcard)).toEquiv

@[simp]
theorem gpowEquiv_apply (hgen : ∀ x : G, x ∈ Subgroup.zpowers g) (hcard : Fintype.card G = q)
    (a : ZMod q) : gpowEquiv hgen hcard a = gpow g a := by
  have h := zmodMulEquivOfGenerator_apply_ofAdd_intCast hgen
    (Nat.card_eq_fintype_card.trans hcard) (a.val : ℤ)
  rw [Int.cast_natCast, ZMod.natCast_zmod_val, zpow_natCast] at h
  exact h

end Generator

end Cslib.Crypto.PublicKey
