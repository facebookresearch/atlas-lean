module

public import CSLibExt.Computability.Languages.ContextFree.Reduced

/-!
# Chomsky normal form

A grammar is in Chomsky normal form when every production has output
either two nonterminals, a single terminal, or the empty word with
the initial nonterminal on the left. Every context-free grammar has
an equivalent grammar in Chomsky normal form: first delete empty and
unit outputs (reduced form), then wrap terminals in long outputs by
fresh nonterminals and binarize long outputs with chain
nonterminals, and finally restore the empty word if needed with a
fresh initial nonterminal.

Since the nonterminal type of a grammar lives in `Type`, terminal
wrappers are coded by natural-number indices into the finite list
of terminals occurring in the grammar.

## Main definitions

* `Cslib.Language.IsChomskyNormalForm`: the normal-form predicate.
* `Cslib.Language.cnfGrammar`: binarization of a reduced grammar.

## Main results

* `Cslib.Language.exists_chomskyNormalForm`: every grammar has an
  equivalent Chomsky-normal-form grammar.
* `Cslib.Language.IsContextFree.exists_chomskyNormalForm`: every
  context-free language is generated by a Chomsky-normal-form
  grammar.
-/

@[expose] public section

attribute [local instance] Classical.propDecidable

namespace Cslib.Language

variable {T : Type*} {g : ContextFreeGrammar T}

/-- A grammar is in Chomsky normal form when every production has
output either two nonterminals, a single terminal, or the empty
word with the initial nonterminal on the left; and either the
initial nonterminal occurs in no output (so an empty production
cannot leak the empty word to other nonterminals) or there are no
empty outputs at all. -/
def IsChomskyNormalForm (g : ContextFreeGrammar T) : Prop :=
  (∀ r ∈ g.rules,
    (∃ B C, r.output = [Symbol.nonterminal B, Symbol.nonterminal C]) ∨
    (∃ a, r.output = [Symbol.terminal a]) ∨
    (r.output = [] ∧ r.input = g.initial)) ∧
  ((∀ r ∈ g.rules, Symbol.nonterminal g.initial ∉ r.output) ∨
    ∀ r ∈ g.rules, r.output ≠ [])

/-- The terminals occurring in some production output of `g`. -/
noncomputable def grammarTerminals (g : ContextFreeGrammar T) : List T :=
  g.rules.toList.flatMap fun r => r.output.filterMap fun s =>
    match s with
    | .terminal a => some a
    | .nonterminal _ => none

theorem mem_grammarTerminals {r : ContextFreeRule T g.NT}
    (hr : r ∈ g.rules) {a : T} (ha : Symbol.terminal a ∈ r.output) :
    a ∈ grammarTerminals g := by
  apply List.mem_flatMap.mpr
  exact ⟨r, Finset.mem_toList.mpr hr,
    List.mem_filterMap.mpr ⟨Symbol.terminal a, ha, rfl⟩⟩

/-- Read a symbol of `g` as a basic nonterminal of the binarized
grammar: a terminal becomes its index in `grammarTerminals g`. -/
noncomputable def toCnfNT : Symbol T g.NT → g.NT ⊕ ℕ
  | .terminal a => .inr ((grammarTerminals g).idxOf a)
  | .nonterminal A => .inl A

/-- Read a basic nonterminal of the binarized grammar back as a
symbol of `g`; out-of-range indices (never produced by `toCnfNT` on
grammar symbols) decode to the initial nonterminal. -/
noncomputable def fromCnfNT : g.NT ⊕ ℕ → Symbol T g.NT
  | .inl A => .nonterminal A
  | .inr i => match (grammarTerminals g)[i]? with
    | some a => .terminal a
    | none => .nonterminal g.initial

theorem fromCnfNT_inr_of_getElem? {i : ℕ} {a : T}
    (h : (grammarTerminals g)[i]? = some a) :
    fromCnfNT (g := g) (.inr i) = Symbol.terminal a := by
  simp only [fromCnfNT, h]

theorem fromCnfNT_toCnfNT_of_mem {s : Symbol T g.NT}
    (hs : ∀ a, s = Symbol.terminal a → a ∈ grammarTerminals g) :
    fromCnfNT (toCnfNT s) = s := by
  cases s with
  | terminal a =>
    exact fromCnfNT_inr_of_getElem?
      (List.getElem?_idxOf (hs a rfl))
  | nonterminal A => rfl

theorem map_fromCnfNT_toCnfNT_of_forall_mem
    {α : List (Symbol T g.NT)}
    (hα : ∀ a, Symbol.terminal a ∈ α → a ∈ grammarTerminals g) :
    (α.map toCnfNT).map fromCnfNT = α := by
  rw [List.map_map]
  refine (List.map_congr_left fun s hs => ?_).trans (List.map_id α)
  exact fromCnfNT_toCnfNT_of_mem
    (fun a ha => hα a (ha.symm ▸ hs))

/-- The head of a binarized output: two basic nonterminals, a basic
nonterminal followed by a chain nonterminal for the remaining
suffix, or a single terminal for a lone wrapper. Unit and empty
inputs (excluded for reduced grammars) get the empty output. -/
noncomputable def cnfHead : List (g.NT ⊕ ℕ) →
    List (Symbol T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ)))
  | [] => []
  | [B] => match B with
    | .inr i => match (grammarTerminals g)[i]? with
      | some a => [Symbol.terminal a]
      | none => []
    | .inl _ => []
  | [B, C] => [Symbol.nonterminal (.inl B), Symbol.nonterminal (.inl C)]
  | B :: C :: D :: σ =>
    [Symbol.nonterminal (.inl B),
      Symbol.nonterminal (.inr (C :: D :: σ))]

theorem cnfHead_single_inr_of_getElem? {i : ℕ} {a : T}
    (h : (grammarTerminals g)[i]? = some a) :
    cnfHead (g := g) [.inr i] = [Symbol.terminal a] := by
  simp only [cnfHead, h]

theorem cnfHead_pair (B C : g.NT ⊕ ℕ) :
    cnfHead (g := g) [B, C] =
      [Symbol.nonterminal (.inl B), Symbol.nonterminal (.inl C)] :=
  rfl

theorem cnfHead_triple (B C D : g.NT ⊕ ℕ) (σ : List (g.NT ⊕ ℕ)) :
    cnfHead (g := g) (B :: C :: D :: σ) =
      [Symbol.nonterminal (.inl B),
        Symbol.nonterminal (.inr (C :: D :: σ))] :=
  rfl

/-- The binarization of a grammar: nonterminals are the old
nonterminals and terminal wrappers (`Sum.inl`), together with chain
nonterminals indexed by output suffixes (`Sum.inr`).

This construction is only correct on **reduced** grammars (no empty
or unit outputs; see `IsReduced`): on other inputs, empty and unit
outputs are sent to the dummy empty head, and neither the language
nor Chomsky normal form is preserved. The theorems
`cnfGrammar_language_of_reduced` and
`cnfGrammar_isChomskyNormalForm` state the contract. -/
@[reducible] noncomputable def cnfGrammar (g : ContextFreeGrammar T) :
    ContextFreeGrammar T where
  NT := (g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ)
  initial := .inl (.inl g.initial)
  rules := g.rules.biUnion fun r =>
    {⟨.inl (.inl r.input), cnfHead (r.output.map toCnfNT)⟩} ∪
    (((r.output.map toCnfNT).tails.filter fun σ => 2 ≤ σ.length).toFinset.image
      fun σ => ⟨.inr σ, cnfHead σ⟩) ∪
    (((r.output.filterMap fun s => match s with
        | .terminal a => some a
        | .nonterminal _ => none).toFinset.image
      fun a => ⟨.inl (.inr ((grammarTerminals g).idxOf a)),
        [Symbol.terminal a]⟩))

private theorem mem_cnfGrammar_rules_main {r : ContextFreeRule T g.NT}
    (hr : r ∈ g.rules) :
    (⟨.inl (.inl r.input), cnfHead (r.output.map toCnfNT)⟩ :
      ContextFreeRule T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ))) ∈
        (cnfGrammar g).rules :=
  Finset.mem_biUnion.mpr ⟨r, hr,
    Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_singleton_self _))⟩

private theorem mem_cnfGrammar_rules_chain {r : ContextFreeRule T g.NT}
    (hr : r ∈ g.rules) {σ : List (g.NT ⊕ ℕ)}
    (hσ : σ ∈ (r.output.map toCnfNT).tails) (hlen : 2 ≤ σ.length) :
    (⟨.inr σ, cnfHead σ⟩ :
      ContextFreeRule T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ))) ∈
        (cnfGrammar g).rules :=
  Finset.mem_biUnion.mpr ⟨r, hr,
    Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨σ, List.mem_toFinset.mpr
        (List.mem_filter.mpr ⟨hσ, by simpa using hlen⟩), rfl⟩))⟩

private theorem mem_cnfGrammar_rules_wrap {r : ContextFreeRule T g.NT}
    (hr : r ∈ g.rules) {a : T} (ha : Symbol.terminal a ∈ r.output) :
    (⟨.inl (.inr ((grammarTerminals g).idxOf a)), [Symbol.terminal a]⟩ :
      ContextFreeRule T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ))) ∈
        (cnfGrammar g).rules :=
  Finset.mem_biUnion.mpr ⟨r, hr,
    Finset.mem_union_right _ (Finset.mem_image.mpr ⟨a,
      List.mem_toFinset.mpr (List.mem_filterMap.mpr
        ⟨Symbol.terminal a, ha, rfl⟩), rfl⟩)⟩

private theorem cases_of_mem_cnfGrammar_rules
    {ρ : ContextFreeRule T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ))}
    (hρ : ρ ∈ (cnfGrammar g).rules) :
    (∃ r ∈ g.rules, ρ =
      ⟨.inl (.inl r.input), cnfHead (r.output.map toCnfNT)⟩) ∨
    (∃ r ∈ g.rules, ∃ σ ∈ (r.output.map toCnfNT).tails,
      2 ≤ σ.length ∧ ρ = ⟨.inr σ, cnfHead σ⟩) ∨
    (∃ r ∈ g.rules, ∃ a, Symbol.terminal a ∈ r.output ∧
      ρ = ⟨.inl (.inr ((grammarTerminals g).idxOf a)),
        [Symbol.terminal a]⟩) := by
  obtain ⟨r, hr, hρ⟩ := Finset.mem_biUnion.mp hρ
  rcases Finset.mem_union.mp hρ with hρ | hρ
  · rcases Finset.mem_union.mp hρ with hρ | hρ
    · exact Or.inl ⟨r, hr, Finset.mem_singleton.mp hρ⟩
    · obtain ⟨σ, hσ, rfl⟩ := Finset.mem_image.mp hρ
      have hσ := List.mem_filter.mp (List.mem_toFinset.mp hσ)
      have hlen : 2 ≤ σ.length := by simpa using hσ.2
      exact Or.inr (Or.inl ⟨r, hr, σ, hσ.1, hlen, rfl⟩)
  · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hρ
    have ha := List.mem_filterMap.mp (List.mem_toFinset.mp ha)
    obtain ⟨s, hs, hsa⟩ := ha
    cases s with
    | terminal a' =>
      have : a' = a := Option.some.inj hsa
      exact Or.inr (Or.inr ⟨r, hr, a, this.symm ▸ hs, rfl⟩)
    | nonterminal A =>
      simp at hsa

/-- Membership in `languageFrom` as a yield. -/
private theorem mem_languageFrom_iff_yields (G : ContextFreeGrammar T)
    {A : G.NT} {w : List T} :
    w ∈ languageFrom G A ↔ Yields G [Symbol.nonterminal A] w := by
  rw [mem_languageFrom]
  exact yields_iff_derives.symm

/-- The valuation of the binarized grammar by yields of `g`:
a basic nonterminal yields what its decoded symbol yields, and a
chain nonterminal yields what its decoded form yields. -/
noncomputable def cnfValuation :
    (g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ) → Language T
  | .inl B => {w | Yields g [fromCnfNT B] w}
  | .inr σ => {w | Yields g (σ.map fromCnfNT) w}

private theorem mem_evalForm_cnfValuation_map
    {σ : List (g.NT ⊕ ℕ)} {w : List T} :
    w ∈ evalForm (cnfValuation (g := g))
        (σ.map fun B => Symbol.nonterminal (.inl B)) ↔
      Yields g (σ.map fromCnfNT) w := by
  induction σ generalizing w with
  | nil =>
    simp only [List.map_nil, evalForm_nil, Language.mem_one]
    constructor
    · intro h
      subst h
      exact Yields.nil
    · intro h
      cases h
      rfl
  | cons B σ ih =>
    simp only [List.map_cons, evalForm_cons, evalSymbol_nonterminal]
    constructor
    · intro hw
      obtain ⟨x, hx, y, hy, rfl⟩ := Language.mem_mul.mp hw
      exact Yields.append hx (ih.mp hy)
    · intro hw
      obtain ⟨x, y, rfl, hx, hy⟩ := Yields.append_inv
        (u := [fromCnfNT B]) (v := σ.map fromCnfNT) hw
      exact Language.mem_mul.mpr ⟨x, hx, y, ih.mpr hy, rfl⟩

private theorem mem_evalForm_cnfHead {σ : List (g.NT ⊕ ℕ)}
    (hσ : 2 ≤ σ.length) {w : List T} :
    w ∈ evalForm (cnfValuation (g := g)) (cnfHead σ) ↔
      Yields g (σ.map fromCnfNT) w := by
  cases σ with
  | nil => simp at hσ
  | cons B σ =>
    cases σ with
    | nil => simp at hσ
    | cons C σ =>
      cases σ with
      | nil =>
        rw [cnfHead_pair]
        exact mem_evalForm_cnfValuation_map (σ := [B, C])
      | cons D σ =>
        rw [cnfHead_triple]
        simp only [evalForm_cons, evalForm_nil, evalSymbol_nonterminal,
          List.map_cons]
        constructor
        · intro hw
          obtain ⟨x, hx, y, hy, rfl⟩ := Language.mem_mul.mp hw
          obtain ⟨y₁, hy₁, y₂, hy₂, rfl⟩ := Language.mem_mul.mp hy
          rw [Language.mem_one] at hy₂
          subst hy₂
          simp only [List.append_nil]
          exact Yields.append hx hy₁
        · intro hw
          obtain ⟨x, y, rfl, hx, hy⟩ := Yields.append_inv
            (u := [fromCnfNT B])
            (v := (C :: D :: σ).map fromCnfNT) hw
          exact Language.mem_mul.mpr ⟨x, hx, y ++ [],
            Language.mem_mul.mpr ⟨y, hy, [],
              (Language.mem_one []).mpr rfl, rfl⟩,
            by simp⟩

/-- A reduced output is either one terminal or has length at
least two. -/
private theorem two_le_length_of_reduced (hred : IsReduced g)
    {r : ContextFreeRule T g.NT} (hr : r ∈ g.rules)
    (hterm : ¬ ∃ a, r.output = [Symbol.terminal a]) :
    2 ≤ (r.output.map toCnfNT).length := by
  rw [List.length_map]
  by_contra hlt
  have h01 : r.output.length = 0 ∨ r.output.length = 1 := by omega
  rcases h01 with h0 | h1
  · exact hred.1 r hr (List.eq_nil_iff_length_eq_zero.mpr h0)
  · obtain ⟨s, hs⟩ := List.length_eq_one_iff.mp h1
    cases s with
    | terminal a => exact hterm ⟨a, hs⟩
    | nonterminal A => exact hred.2 r hr ⟨A, hs⟩

private theorem cnfHead_eq_terminal_of_output_terminal
    {r : ContextFreeRule T g.NT} (hr : r ∈ g.rules) {a : T}
    (ha : r.output = [Symbol.terminal a]) :
    cnfHead (r.output.map toCnfNT) = [Symbol.terminal a] := by
  have hmem : a ∈ grammarTerminals g :=
    mem_grammarTerminals hr (ha.symm ▸ List.mem_cons_self)
  rw [ha]
  change cnfHead [.inr ((grammarTerminals g).idxOf a)] = _
  exact cnfHead_single_inr_of_getElem? (List.getElem?_idxOf hmem)

/-- The yields valuation is a valuation of the binarized grammar
when `g` is reduced. -/
private theorem isValuation_cnfValuation (hred : IsReduced g) :
    IsValuation (cnfGrammar g) (cnfValuation (g := g)) := by
  intro ρ hρ
  rcases cases_of_mem_cnfGrammar_rules hρ with
    ⟨r, hr, rfl⟩ | ⟨r, hr, σ, hσ, hlen, rfl⟩ | ⟨r, hr, a, ha, rfl⟩
  · change evalForm (cnfValuation (g := g))
        (cnfHead (r.output.map toCnfNT)) ≤
      cnfValuation (.inl (.inl r.input))
    intro w hw
    by_cases hterm : ∃ a, r.output = [Symbol.terminal a]
    · obtain ⟨a, ha⟩ := hterm
      rw [cnfHead_eq_terminal_of_output_terminal hr ha] at hw
      simp only [evalForm_cons, evalForm_nil, evalSymbol_terminal]
        at hw
      obtain ⟨x, rfl, y, hy, rfl⟩ := Language.mem_mul.mp hw
      rw [Language.mem_one] at hy
      subst hy
      simp only [List.append_nil]
      have hyield : Yields g r.output [a] := by
        rw [ha]
        exact Yields.terminal a Yields.nil
      exact yields_of_rule hr hyield
    · have hlen := two_le_length_of_reduced hred hr hterm
      have hy := (mem_evalForm_cnfHead hlen).mp hw
      rw [map_fromCnfNT_toCnfNT_of_forall_mem
        (fun a ha => mem_grammarTerminals hr ha)] at hy
      exact yields_of_rule hr hy
  · change evalForm (cnfValuation (g := g)) (cnfHead σ) ≤
      cnfValuation (.inr σ)
    intro w hw
    exact (mem_evalForm_cnfHead hlen).mp hw
  · change evalForm (cnfValuation (g := g)) [Symbol.terminal a] ≤
      cnfValuation (.inl (.inr ((grammarTerminals g).idxOf a)))
    intro w hw
    simp only [evalForm_cons, evalForm_nil, evalSymbol_terminal] at hw
    obtain ⟨x, rfl, y, hy, rfl⟩ := Language.mem_mul.mp hw
    rw [Language.mem_one] at hy
    subst hy
    simp only [List.append_nil]
    change Yields g [fromCnfNT (.inr ((grammarTerminals g).idxOf a))] [a]
    rw [fromCnfNT_inr_of_getElem?
      (List.getElem?_idxOf (mem_grammarTerminals hr ha))]
    exact Yields.terminal a Yields.nil

/-- Binarization does not generate new words over a reduced
grammar. -/
theorem cnfGrammar_language_le_of_reduced (hred : IsReduced g) :
    (cnfGrammar g).language ≤ g.language := by
  have h := language_le_of_valuation (isValuation_cnfValuation hred)
  intro w hw
  exact mem_language_iff_yields.mpr (h hw)

/-- Heads of outputs of length at least two are pairs of
nonterminals. -/
private theorem exists_pair_of_cnfHead_of_length_ge
    {σ : List (g.NT ⊕ ℕ)} (hσ : 2 ≤ σ.length) :
    ∃ B C, cnfHead σ =
      [Symbol.nonterminal B, Symbol.nonterminal C] := by
  cases σ with
  | nil => simp at hσ
  | cons B σ =>
    cases σ with
    | nil => simp at hσ
    | cons C σ =>
      cases σ with
      | nil => exact ⟨.inl B, .inl C, cnfHead_pair B C⟩
      | cons D σ =>
        exact ⟨.inl B, .inr (C :: D :: σ), cnfHead_triple B C D σ⟩

/-- The binarization of a reduced grammar has no empty outputs. -/
theorem cnfGrammar_output_ne_nil (hred : IsReduced g) :
    ∀ ρ ∈ (cnfGrammar g).rules, ρ.output ≠ [] := by
  intro ρ hρ hnil
  rcases cases_of_mem_cnfGrammar_rules hρ with
    ⟨r, hr, rfl⟩ | ⟨r, hr, σ, hσ, hlen, rfl⟩ | ⟨r, hr, a, ha, rfl⟩
  · by_cases hterm : ∃ a, r.output = [Symbol.terminal a]
    · obtain ⟨a, ha⟩ := hterm
      rw [cnfHead_eq_terminal_of_output_terminal hr ha] at hnil
      cases hnil
    · obtain ⟨B, C, hBC⟩ := exists_pair_of_cnfHead_of_length_ge
        (two_le_length_of_reduced hred hr hterm)
      rw [hBC] at hnil
      cases hnil
  · obtain ⟨B, C, hBC⟩ := exists_pair_of_cnfHead_of_length_ge hlen
    rw [hBC] at hnil
    cases hnil
  · cases hnil

/-- The binarization of a reduced grammar is in Chomsky normal
form. -/
theorem cnfGrammar_isChomskyNormalForm (hred : IsReduced g) :
    IsChomskyNormalForm (cnfGrammar g) := by
  refine ⟨fun ρ hρ => ?_, Or.inr (cnfGrammar_output_ne_nil hred)⟩
  rcases cases_of_mem_cnfGrammar_rules hρ with
    ⟨r, hr, rfl⟩ | ⟨r, hr, σ, hσ, hlen, rfl⟩ | ⟨r, hr, a, ha, rfl⟩
  · by_cases hterm : ∃ a, r.output = [Symbol.terminal a]
    · obtain ⟨a, ha⟩ := hterm
      exact Or.inr (Or.inl
        ⟨a, cnfHead_eq_terminal_of_output_terminal hr ha⟩)
    · exact Or.inl (exists_pair_of_cnfHead_of_length_ge
        (two_le_length_of_reduced hred hr hterm))
  · exact Or.inl (exists_pair_of_cnfHead_of_length_ge hlen)
  · exact Or.inr (Or.inl ⟨a, rfl⟩)

/-- The embedding of old nonterminals into the binarized
nonterminals. -/
private def embedNT : g.NT → (cnfGrammar g).NT :=
  fun A => Sum.inl (Sum.inl A)

/-- Membership in an `evalForm` under `languageFrom` as a yield. -/
private theorem mem_evalForm_languageFrom_iff_yields
    (G : ContextFreeGrammar T) {β : List (Symbol T G.NT)} {w : List T} :
    w ∈ evalForm (languageFrom G) β ↔ Yields G β w := by
  rw [yields_iff_derives]
  constructor
  · exact derives_of_mem_evalForm_languageFrom
  · intro h
    apply evalForm_le_of_derives isValuation_languageFrom h
    rw [evalForm_map_terminal]
    exact rfl

private theorem yields_cnf_of_mem_evalForm
    {α : List (Symbol T g.NT)} {w : List T} :
    w ∈ evalForm (languageFrom (cnfGrammar g) ∘ embedNT) α ↔
      Yields (cnfGrammar g) (α.map (mapSymbol embedNT)) w := by
  rw [← evalForm_map]
  exact mem_evalForm_languageFrom_iff_yields (cnfGrammar g)

/-- Replace terminal symbols in a yield over the binarized grammar
by their wrapper nonterminals. -/
private theorem yields_cnf_wrap {α : List (Symbol T g.NT)}
    (hwrap : ∀ a, Symbol.terminal a ∈ α →
      (⟨.inl (.inr ((grammarTerminals g).idxOf a)),
          [Symbol.terminal a]⟩ :
        ContextFreeRule T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ))) ∈
          (cnfGrammar g).rules)
    {w : List T}
    (h : Yields (cnfGrammar g) (α.map (mapSymbol embedNT)) w) :
    Yields (cnfGrammar g)
      ((α.map toCnfNT).map fun B => Symbol.nonterminal (.inl B)) w := by
  induction α generalizing w with
  | nil => exact h
  | cons s α ih =>
    simp only [List.map_cons] at h
    obtain ⟨x, y, rfl, hx, hy⟩ := Yields.append_inv
      (u := [mapSymbol embedNT s]) h
    have hy' := ih (fun a ha => hwrap a (List.mem_cons_of_mem s ha)) hy
    cases s with
    | terminal a =>
      have hx2 : x = [a] := by
        cases hx with
        | terminal a hrest =>
          cases hrest with
          | nil => rfl
      subst hx2
      exact Yields.append
        (yields_of_rule (hwrap a List.mem_cons_self)
          (Yields.terminal a Yields.nil)) hy'
    | nonterminal A =>
      exact Yields.append hx hy'

/-- Binarize a yield over basic nonterminals into a yield of the
head form, given the chain rules for all suffixes in play. -/
private theorem yields_cnfHead_of_yields {Λ σ : List (g.NT ⊕ ℕ)}
    (hsuf : σ <:+ Λ) (hσ : 2 ≤ σ.length)
    (hchain : ∀ τ, τ <:+ Λ → 2 ≤ τ.length →
      (⟨.inr τ, cnfHead τ⟩ :
        ContextFreeRule T ((g.NT ⊕ ℕ) ⊕ List (g.NT ⊕ ℕ))) ∈
          (cnfGrammar g).rules)
    {w : List T}
    (h : Yields (cnfGrammar g)
      (σ.map fun B => Symbol.nonterminal (.inl B)) w) :
    Yields (cnfGrammar g) (cnfHead σ) w := by
  induction σ generalizing w with
  | nil => simp at hσ
  | cons B σ ih =>
    cases σ with
    | nil => simp at hσ
    | cons C σ =>
      cases σ with
      | nil =>
        rw [cnfHead_pair]
        exact h
      | cons D σ =>
        rw [cnfHead_triple]
        simp only [List.map_cons] at h
        obtain ⟨x, y, rfl, hx, hy⟩ := Yields.append_inv
          (g := cnfGrammar g)
          (u := [Symbol.nonterminal (Sum.inl B)])
          (v := (C :: D :: σ).map fun B =>
            Symbol.nonterminal (Sum.inl B)) h
        obtain ⟨t, ht⟩ := hsuf
        have hsuf' : (C :: D :: σ) <:+ Λ :=
          ⟨t ++ [B], by rw [List.append_assoc]; exact ht⟩
        have hy2 := ih hsuf' (by simp) hy
        exact Yields.append hx
          (yields_of_rule (hchain (C :: D :: σ) hsuf' (by simp)) hy2)

/-- The languages generated from old nonterminals in the binarized
grammar form a valuation of a reduced grammar. -/
private theorem isValuation_languageFrom_cnf (hred : IsReduced g) :
    IsValuation g (languageFrom (cnfGrammar g) ∘ embedNT) := by
  intro r hr w hw
  change w ∈ languageFrom (cnfGrammar g) (embedNT r.input)
  rw [mem_languageFrom_iff_yields (cnfGrammar g)]
  have hy1 : Yields (cnfGrammar g)
      (r.output.map (mapSymbol embedNT)) w :=
    yields_cnf_of_mem_evalForm.mp hw
  by_cases hterm : ∃ a, r.output = [Symbol.terminal a]
  · obtain ⟨a, ha⟩ := hterm
    have hmain : Yields (cnfGrammar g)
        (cnfHead (r.output.map toCnfNT)) w := by
      rw [cnfHead_eq_terminal_of_output_terminal hr ha]
      rw [ha] at hy1
      exact hy1
    exact yields_of_rule (mem_cnfGrammar_rules_main hr) hmain
  · have hy2 := yields_cnf_wrap
      (fun a ha => mem_cnfGrammar_rules_wrap hr ha) hy1
    have hy3 := yields_cnfHead_of_yields (Λ := r.output.map toCnfNT)
      ⟨[], rfl⟩ (two_le_length_of_reduced hred hr hterm)
      (fun τ hτ hlen => mem_cnfGrammar_rules_chain hr
        ((List.mem_tails τ _).mpr hτ) hlen) hy2
    exact yields_of_rule (mem_cnfGrammar_rules_main hr) hy3

/-- Binarization preserves the language of a reduced grammar. -/
theorem cnfGrammar_language_of_reduced (hred : IsReduced g) :
    (cnfGrammar g).language = g.language := by
  apply le_antisymm (cnfGrammar_language_le_of_reduced hred)
  have h := language_le_of_valuation (isValuation_languageFrom_cnf hred)
  intro w hw
  have hw2 := h hw
  change w ∈ languageFrom (cnfGrammar g) (cnfGrammar g).initial at hw2
  rwa [languageFrom_initial] at hw2

/-- Inversion of a yield from a single nonterminal: it begins with
one production of that nonterminal. -/
private theorem yields_singleton_cases (G : ContextFreeGrammar T)
    {A : G.NT} {w : List T} (h : Yields G [Symbol.nonterminal A] w) :
    ∃ r ∈ G.rules, r.input = A ∧ Yields G r.output w := by
  cases h with
  | nonterminal hr hout hrest =>
    cases hrest with
    | nil => exact ⟨_, hr, rfl, by simpa using hout⟩

/-- Add a fresh initial nonterminal with an empty production and
copies of the old initial productions. The new grammar generates
the old language plus the empty word, and stays in Chomsky normal
form when the old grammar is and has no empty outputs. -/
@[reducible] noncomputable def epsStartGrammar (g : ContextFreeGrammar T) :
    ContextFreeGrammar T where
  NT := Option g.NT
  initial := none
  rules := (g.rules.map
      ⟨mapRule Option.some, mapRule_injective (Option.some_injective _)⟩) ∪
    {⟨none, []⟩} ∪
    ((g.rules.filter fun r => r.input = g.initial).image fun r =>
      ⟨none, r.output.map (mapSymbol Option.some)⟩)

private theorem mem_epsStartGrammar_rules_embedded
    {r : ContextFreeRule T g.NT} (hr : r ∈ g.rules) :
    mapRule Option.some r ∈ (epsStartGrammar g).rules :=
  Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_map.mpr ⟨r, hr, rfl⟩))

private theorem mem_epsStartGrammar_rules_epsilon :
    (⟨none, []⟩ : ContextFreeRule T (Option g.NT)) ∈
      (epsStartGrammar g).rules :=
  Finset.mem_union_left _ (Finset.mem_union_right _
    (Finset.mem_singleton_self _))

private theorem mem_epsStartGrammar_rules_copy
    {r : ContextFreeRule T g.NT} (hr : r ∈ g.rules)
    (hinput : r.input = g.initial) :
    (⟨none, r.output.map (mapSymbol Option.some)⟩ :
      ContextFreeRule T (Option g.NT)) ∈ (epsStartGrammar g).rules :=
  Finset.mem_union_right _ (Finset.mem_image.mpr ⟨r,
    Finset.mem_filter.mpr ⟨hr, hinput⟩, rfl⟩)

private theorem cases_of_mem_epsStartGrammar_rules
    {ρ : ContextFreeRule T (Option g.NT)}
    (hρ : ρ ∈ (epsStartGrammar g).rules) :
    (∃ r ∈ g.rules, ρ = mapRule Option.some r) ∨
    ρ = ⟨none, []⟩ ∨
    (∃ r ∈ g.rules, r.input = g.initial ∧
      ρ = ⟨none, r.output.map (mapSymbol Option.some)⟩) := by
  rcases Finset.mem_union.mp hρ with hρ | hρ
  · rcases Finset.mem_union.mp hρ with hρ | hρ
    · obtain ⟨r, hr, rfl⟩ := Finset.mem_map.mp hρ
      exact Or.inl ⟨r, hr, rfl⟩
    · exact Or.inr (Or.inl (Finset.mem_singleton.mp hρ))
  · obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hρ
    have hr := Finset.mem_filter.mp hr
    exact Or.inr (Or.inr ⟨r, hr.1, hr.2, rfl⟩)

/-- The valuation of the fresh-start grammar: old nonterminals keep
their languages, and the fresh initial nonterminal gets the old
language plus the empty word. -/
private def epsStartValuation : (epsStartGrammar g).NT → Language T
  | none => insert [] g.language
  | some A => languageFrom g A

private theorem isValuation_epsStartValuation :
    IsValuation (epsStartGrammar g) (epsStartValuation (g := g)) := by
  intro ρ hρ
  have hmap : ∀ {r : ContextFreeRule T g.NT},
      evalForm (epsStartValuation (g := g))
          (r.output.map (mapSymbol Option.some)) =
        evalForm (languageFrom g) r.output := by
    intro r
    rw [evalForm_map]
    congr 1
  rcases cases_of_mem_epsStartGrammar_rules hρ with
    ⟨r, hr, rfl⟩ | rfl | ⟨r, hr, hinput, rfl⟩
  · rw [mapRule_output, mapRule_input, hmap]
    exact isValuation_languageFrom r hr
  · intro w hw
    change w ∈ evalForm (epsStartValuation (g := g))
      ([] : List (Symbol T (epsStartGrammar g).NT)) at hw
    simp only [evalForm_nil, Language.mem_one] at hw
    subst hw
    exact Set.mem_insert [] _
  · intro w hw
    change w ∈ evalForm (epsStartValuation (g := g))
      (r.output.map (mapSymbol Option.some)) at hw
    rw [hmap] at hw
    have hw2 := isValuation_languageFrom r hr hw
    rw [hinput, languageFrom_initial] at hw2
    exact Set.mem_insert_of_mem _ hw2

/-- The fresh-start grammar generates the old language plus the
empty word. -/
theorem epsStartGrammar_language (g : ContextFreeGrammar T) :
    (epsStartGrammar g).language = insert [] g.language := by
  apply le_antisymm
  · have h := language_le_of_valuation
      (isValuation_epsStartValuation (g := g))
    exact h
  · intro w hw
    change w = [] ∨ w ∈ g.language at hw
    rcases hw with rfl | hw
    · exact mem_language_iff_yields.mpr
        (yields_of_rule mem_epsStartGrammar_rules_epsilon Yields.nil)
    · have hval : IsValuation g
          (languageFrom (epsStartGrammar g) ∘ Option.some) := by
        intro r hr w hw
        change w ∈ languageFrom (epsStartGrammar g) (Option.some r.input)
        rw [mem_languageFrom_iff_yields (epsStartGrammar g)]
        rw [← evalForm_map] at hw
        exact yields_of_rule (mem_epsStartGrammar_rules_embedded hr)
          ((mem_evalForm_languageFrom_iff_yields
            (epsStartGrammar g)).mp hw)
      have hw2 := language_le_of_valuation hval hw
      change w ∈ languageFrom (epsStartGrammar g)
        (Option.some g.initial) at hw2
      rw [mem_languageFrom_iff_yields (epsStartGrammar g)] at hw2
      obtain ⟨ρ, hρ, hinput, hout⟩ :=
        yields_singleton_cases _ hw2
      rcases cases_of_mem_epsStartGrammar_rules hρ with
        ⟨r, hr, rfl⟩ | rfl | ⟨r, hr, -, rfl⟩
      · rw [mapRule_input] at hinput
        have hrinput : r.input = g.initial :=
          Option.some_injective _ hinput
        rw [mapRule_output] at hout
        exact mem_language_iff_yields.mpr
          (yields_of_rule
            (mem_epsStartGrammar_rules_copy hr hrinput) hout)
      · simp at hinput
      · simp at hinput

/-- The fresh initial nonterminal occurs in no production output
of the fresh-start grammar. -/
theorem epsStartGrammar_initial_not_mem_output :
    ∀ ρ ∈ (epsStartGrammar g).rules,
      Symbol.nonterminal (epsStartGrammar g).initial ∉ ρ.output := by
  intro ρ hρ hmem
  have hnone : ∀ (u : List (Symbol T g.NT)),
      Symbol.nonterminal (none : Option g.NT) ∉
        u.map (mapSymbol Option.some) := by
    intro u hmem
    obtain ⟨s, -, hsm⟩ := List.mem_map.mp hmem
    cases s with
    | terminal a => simp only [mapSymbol] at hsm; cases hsm
    | nonterminal A => simp only [mapSymbol] at hsm; cases hsm
  rcases cases_of_mem_epsStartGrammar_rules hρ with
    ⟨r, hr, rfl⟩ | rfl | ⟨r, hr, -, rfl⟩
  · rw [mapRule_output] at hmem
    exact hnone _ hmem
  · cases hmem
  · exact hnone _ hmem

/-- When the empty word is already generated, the fresh-start
construction does not change the language. -/
theorem epsStartGrammar_language_of_mem_nil
    (hε : ([] : List T) ∈ g.language) :
    (epsStartGrammar g).language = g.language := by
  rw [epsStartGrammar_language]
  exact Set.insert_eq_of_mem hε

/-- The fresh-start construction preserves Chomsky normal form for
grammars with no empty outputs. The no-empty-outputs hypothesis is
essential: an existing empty production would be embedded with the
old initial nonterminal, not the fresh one, on the left. -/
theorem epsStartGrammar_isChomskyNormalForm
    (hCNF : IsChomskyNormalForm g)
    (hne : ∀ r ∈ g.rules, r.output ≠ []) :
    IsChomskyNormalForm (epsStartGrammar g) := by
  refine ⟨fun ρ hρ => ?_,
    Or.inl epsStartGrammar_initial_not_mem_output⟩
  have hshape : ∀ {r : ContextFreeRule T g.NT}, r ∈ g.rules →
      ∀ u : List (Symbol T (Option g.NT)),
        u = r.output.map (mapSymbol Option.some) →
        (∃ B C, u = [Symbol.nonterminal B, Symbol.nonterminal C]) ∨
          (∃ a, u = [Symbol.terminal a]) := by
    intro r hr u hu
    rcases hCNF.1 r hr with ⟨B, C, hBC⟩ | ⟨a, ha⟩ | ⟨h0, -⟩
    · exact Or.inl ⟨Option.some B, Option.some C, by rw [hu, hBC]; rfl⟩
    · exact Or.inr ⟨a, by rw [hu, ha]; rfl⟩
    · exact absurd h0 (hne r hr)
  rcases cases_of_mem_epsStartGrammar_rules hρ with
    ⟨r, hr, rfl⟩ | rfl | ⟨r, hr, -, rfl⟩
  · rw [mapRule_output]
    rcases hshape hr _ rfl with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr ⟨rfl, rfl⟩)
  · rcases hshape hr _ rfl with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)

/-- Every grammar has an equivalent grammar in Chomsky normal
form. -/
theorem exists_chomskyNormalForm (g₀ : ContextFreeGrammar T) :
    ∃ g' : ContextFreeGrammar T, g'.language = g₀.language ∧
      IsChomskyNormalForm g' := by
  obtain ⟨g', hlang, hne, hunit⟩ := exists_reduced_grammar g₀
  have hred : IsReduced g' := ⟨hne, hunit⟩
  by_cases hε : ([] : List T) ∈ g₀.language
  · refine ⟨epsStartGrammar (cnfGrammar g'), ?_,
      epsStartGrammar_isChomskyNormalForm
        (cnfGrammar_isChomskyNormalForm hred)
        (cnfGrammar_output_ne_nil hred)⟩
    rw [epsStartGrammar_language, cnfGrammar_language_of_reduced hred]
    ext w
    change (w = [] ∨ w ∈ g'.language) ↔ w ∈ g₀.language
    constructor
    · rintro (rfl | hw)
      · exact hε
      · exact (hlang w).mp hw |>.1
    · intro hw
      by_cases hw0 : w = []
      · exact Or.inl hw0
      · exact Or.inr ((hlang w).mpr ⟨hw, hw0⟩)
  · refine ⟨cnfGrammar g', ?_,
      cnfGrammar_isChomskyNormalForm hred⟩
    rw [cnfGrammar_language_of_reduced hred]
    ext w
    rw [hlang]
    constructor
    · exact fun hw => hw.1
    · intro hw
      exact ⟨hw, fun hw0 => hε (hw0.symm ▸ hw)⟩

/-- Every context-free language is generated by a grammar in
Chomsky normal form. -/
theorem IsContextFree.exists_chomskyNormalForm {L : Language T}
    (hL : L.IsContextFree) :
    ∃ g : ContextFreeGrammar T, g.language = L ∧
      IsChomskyNormalForm g := by
  obtain ⟨g₀, rfl⟩ := hL
  exact _root_.Cslib.Language.exists_chomskyNormalForm g₀

end Cslib.Language
