module

public import CSLibExt.Computability.Decidability.StringRewriting
public import Mathlib.Computability.Language
public import Mathlib.Data.List.Count
public import Mathlib.Data.Nat.Basic
public import Mathlib.Logic.Relation

/-!
# Context-sensitive grammars

A context-sensitive grammar is an unrestricted grammar whose productions
never shrink: every rule `α → β` satisfies `|α| ≤ |β|`. This is the
`LBA` level of the Chomsky hierarchy (between context-free and
recursively enumerable). The textbook example is `aⁿbⁿcⁿ`, which is not
context-free: here it is generated by the standard grammar with
nonterminals `S, B, C`, a "shuttle" rule `CB → BC` that moves `C`'s right
past `B`'s, and rules that convert `B`'s and `C`'s to terminals once
they are in position.

Main results:

* `abcGrammar_contextSensitive`: every production is
  length-nondecreasing.
* `abc_mem`, `aabbcc_mem`: `abc` and `aabbcc` are generated, by
  explicit derivations.
* `language_subset_balanced`: every generated terminal word has equally
  many `a`'s, `b`'s and `c`'s (the counting invariant: the `B`'s and
  `C`'s are "unborn" `b`'s and `c`'s).
* `aabbc_not_mem`: `aabbc` is not generated, since `2 = 2 ≠ 1`.
-/

@[expose] public section

/-- Whether a grammar symbol (`Mathlib.Computability.Language.Symbol`,
shared with the context-free development) is a nonterminal. -/
def Symbol.isNonterminal {T N : Type*} : Symbol T N → Bool
  | .nonterminal _ => true
  | .terminal _ => false

namespace Cslib
namespace Language

/-- An unrestricted grammar: a finite list of productions and an
initial nonterminal. -/
structure CSGrammar (T N : Type*) where
  /-- The finite list of productions, each a pair of symbol lists. -/
  rules : List (List (Symbol T N) × List (Symbol T N))
  /-- The initial nonterminal. -/
  initial : N

/-- One rewriting step: apply a production in a sentential form
context. This is the generic `Cslib.Decidability.Rewriting.Step` at the
grammar's rules, so grammar derivations reuse the string-rewriting API
instead of a second, incompatible copy of it. -/
def Rewrites {T N : Type*} (g : CSGrammar T N) (u v : List (Symbol T N)) : Prop :=
  Cslib.Decidability.Rewriting.Step g.rules u v

/-- Derivation: the reflexive-transitive closure of rewriting. -/
def Derives {T N : Type*} (g : CSGrammar T N) (u v : List (Symbol T N)) : Prop :=
  Cslib.Decidability.Rewriting.Derives g.rules u v

/-- The language of a grammar: terminal words derived from the initial
nonterminal. -/
def language {T N : Type*} (g : CSGrammar T N) : Set (List T) :=
  {w | Derives g [Symbol.nonterminal g.initial] (w.map Symbol.terminal)}

/-- A grammar is context-sensitive when every production has a
nonterminal on its left side (so the left side is nonempty and not
terminal-only) and no production shrinks. The standard `S → ε`
exception is not used here: the `aⁿbⁿcⁿ` grammar has `n ≥ 1`. -/
def IsContextSensitive {T N : Type*} (g : CSGrammar T N) : Prop :=
  ∀ r ∈ g.rules, r.1.any (·.isNonterminal) = true ∧ r.1.length ≤ r.2.length

/-- Terminals of the `aⁿbⁿcⁿ` grammar. -/
inductive ABC where
  | a : ABC
  | b : ABC
  | c : ABC
  deriving DecidableEq, Repr

/-- Nonterminals of the `aⁿbⁿcⁿ` grammar. -/
inductive ABCNT where
  | S : ABCNT
  | B : ABCNT
  | C : ABCNT
  deriving DecidableEq, Repr

/-- The standard context-sensitive grammar for `{aⁿbⁿcⁿ | n ≥ 1}`. -/
def abcGrammar : CSGrammar ABC ABCNT where
  rules :=
    [ ([.nonterminal .S], [.terminal .a, .nonterminal .S, .nonterminal .B, .nonterminal .C])
    , ([.nonterminal .S], [.terminal .a, .nonterminal .B, .nonterminal .C])
    , ([.nonterminal .C, .nonterminal .B], [.nonterminal .B, .nonterminal .C])
    , ([.terminal .a, .nonterminal .B], [.terminal .a, .terminal .b])
    , ([.terminal .b, .nonterminal .B], [.terminal .b, .terminal .b])
    , ([.terminal .b, .nonterminal .C], [.terminal .b, .terminal .c])
    , ([.terminal .c, .nonterminal .C], [.terminal .c, .terminal .c]) ]
  initial := .S

/-- One grammar step: rewrite `lhs` to `rhs` in context `p, q`. -/
theorem step (lhs rhs p q : List (Symbol ABC ABCNT))
    (h : (lhs, rhs) ∈ abcGrammar.rules) :
    Derives abcGrammar (p ++ lhs ++ q) (p ++ rhs ++ q) :=
  Cslib.Decidability.Rewriting.Derives.single
    (Cslib.Decidability.Rewriting.Step.mk p q h)

/-- Every production of the `aⁿbⁿcⁿ` grammar is length-nondecreasing,
so the grammar is context-sensitive. -/
theorem abcGrammar_contextSensitive : IsContextSensitive abcGrammar := by
  show ∀ r ∈ abcGrammar.rules,
    r.1.any (·.isNonterminal) = true ∧ r.1.length ≤ r.2.length
  decide

/-- `abc` is generated. -/
theorem abc_mem : [ABC.a, ABC.b, ABC.c] ∈ language abcGrammar := by
  have s1 : Derives abcGrammar [.nonterminal .S]
      [.terminal .a, .nonterminal .B, .nonterminal .C] :=
    step [.nonterminal .S] [.terminal .a, .nonterminal .B, .nonterminal .C] [] [] (by decide)
  have s2 : Derives abcGrammar [.terminal .a, .nonterminal .B, .nonterminal .C]
      [.terminal .a, .terminal .b, .nonterminal .C] :=
    step [.terminal .a, .nonterminal .B] [.terminal .a, .terminal .b] []
      [.nonterminal .C] (by decide)
  have s3 : Derives abcGrammar [.terminal .a, .terminal .b, .nonterminal .C]
      [.terminal .a, .terminal .b, .terminal .c] :=
    step [.terminal .b, .nonterminal .C] [.terminal .b, .terminal .c] [.terminal .a] [] (by decide)
  exact s1.trans (s2.trans s3)

/-- `aabbcc` is generated: grow two `a`'s, shuttle the `C`'s right past
the `B`'s, then convert `B`'s and `C`'s to terminals in order. -/
theorem aabbcc_mem :
    [ABC.a, ABC.a, ABC.b, ABC.b, ABC.c, ABC.c] ∈ language abcGrammar := by
  have s1 : Derives abcGrammar [.nonterminal .S]
      [.terminal .a, .nonterminal .S, .nonterminal .B, .nonterminal .C] :=
    step [.nonterminal .S]
      [.terminal .a, .nonterminal .S, .nonterminal .B, .nonterminal .C] [] [] (by decide)
  have s2 : Derives abcGrammar
      [.terminal .a, .nonterminal .S, .nonterminal .B, .nonterminal .C]
      [.terminal .a, .terminal .a, .nonterminal .B, .nonterminal .C,
        .nonterminal .B, .nonterminal .C] :=
    step [.nonterminal .S] [.terminal .a, .nonterminal .B, .nonterminal .C]
      [.terminal .a] [.nonterminal .B, .nonterminal .C] (by decide)
  have s3 : Derives abcGrammar
      [.terminal .a, .terminal .a, .nonterminal .B, .nonterminal .C,
        .nonterminal .B, .nonterminal .C]
      [.terminal .a, .terminal .a, .nonterminal .B, .nonterminal .B,
        .nonterminal .C, .nonterminal .C] :=
    step [.nonterminal .C, .nonterminal .B] [.nonterminal .B, .nonterminal .C]
      [.terminal .a, .terminal .a, .nonterminal .B] [.nonterminal .C] (by decide)
  have s4 : Derives abcGrammar
      [.terminal .a, .terminal .a, .nonterminal .B, .nonterminal .B,
        .nonterminal .C, .nonterminal .C]
      [.terminal .a, .terminal .a, .terminal .b, .nonterminal .B,
        .nonterminal .C, .nonterminal .C] :=
    step [.terminal .a, .nonterminal .B] [.terminal .a, .terminal .b]
      [.terminal .a] [.nonterminal .B, .nonterminal .C, .nonterminal .C] (by decide)
  have s5 : Derives abcGrammar
      [.terminal .a, .terminal .a, .terminal .b, .nonterminal .B,
        .nonterminal .C, .nonterminal .C]
      [.terminal .a, .terminal .a, .terminal .b, .terminal .b,
        .nonterminal .C, .nonterminal .C] :=
    step [.terminal .b, .nonterminal .B] [.terminal .b, .terminal .b]
      [.terminal .a, .terminal .a] [.nonterminal .C, .nonterminal .C] (by decide)
  have s6 : Derives abcGrammar
      [.terminal .a, .terminal .a, .terminal .b, .terminal .b,
        .nonterminal .C, .nonterminal .C]
      [.terminal .a, .terminal .a, .terminal .b, .terminal .b,
        .terminal .c, .nonterminal .C] :=
    step [.terminal .b, .nonterminal .C] [.terminal .b, .terminal .c]
      [.terminal .a, .terminal .a, .terminal .b] [.nonterminal .C] (by decide)
  have s7 : Derives abcGrammar
      [.terminal .a, .terminal .a, .terminal .b, .terminal .b,
        .terminal .c, .nonterminal .C]
      [.terminal .a, .terminal .a, .terminal .b, .terminal .b,
        .terminal .c, .terminal .c] :=
    step [.terminal .c, .nonterminal .C] [.terminal .c, .terminal .c]
      [.terminal .a, .terminal .a, .terminal .b, .terminal .b] [] (by decide)
  exact s1.trans (s2.trans (s3.trans (s4.trans (s5.trans (s6.trans s7)))))

/-- Count of the symbol `s` in a sentential form (terminals `a`, `b`,
`c`, and the "unborn" `b`/`c` nonterminals `B`, `C`). -/
def cnt (s : Symbol ABC ABCNT) (u : List (Symbol ABC ABCNT)) : ℕ :=
  u.countP (fun t => decide (t = s))

/-- The `a`-count of a sentential form. -/
def cntA (u : List (Symbol ABC ABCNT)) : ℕ :=
  cnt (.terminal .a) u

/-- The `b`-count: terminal `b`'s plus unborn `B`'s. -/
def cntB (u : List (Symbol ABC ABCNT)) : ℕ :=
  cnt (.terminal .b) u + cnt (.nonterminal .B) u

/-- The `c`-count: terminal `c`'s plus unborn `C`'s. -/
def cntC (u : List (Symbol ABC ABCNT)) : ℕ :=
  cnt (.terminal .c) u + cnt (.nonterminal .C) u

/-- A sentential form is balanced when its `a`-, `b`- and `c`-counts
agree. -/
def Balanced (u : List (Symbol ABC ABCNT)) : Prop :=
  cntA u = cntB u ∧ cntB u = cntC u

/-- Counting over a concatenation of three forms splits additively. -/
theorem cnt_concat3 (p l q : List (Symbol ABC ABCNT)) (s : Symbol ABC ABCNT) :
    cnt s (p ++ l ++ q) = cnt s p + cnt s l + cnt s q := by
  unfold cnt
  rw [List.countP_append, List.countP_append, Nat.add_assoc]

/-- One rewriting step preserves balancedness: every production has
the same imbalance on both sides, and the context contributes equally
to all three counts. -/
theorem rewrites_balanced {u v : List (Symbol ABC ABCNT)}
    (h : Rewrites abcGrammar u v) (hu : Balanced u) : Balanced v := by
  cases h with
  | mk p q hrule =>
    rename_i lhs rhs
    have eA1 : cntA (p ++ lhs ++ q) = cntA p + cntA lhs + cntA q :=
      cnt_concat3 p lhs q (.terminal .a)
    have eB1 : cntB (p ++ lhs ++ q) = cntB p + cntB lhs + cntB q := by
      show cnt (.terminal .b) (p ++ lhs ++ q) + cnt (.nonterminal .B) (p ++ lhs ++ q)
          = (cnt (.terminal .b) p + cnt (.nonterminal .B) p) +
            (cnt (.terminal .b) lhs + cnt (.nonterminal .B) lhs) +
            (cnt (.terminal .b) q + cnt (.nonterminal .B) q)
      rw [cnt_concat3, cnt_concat3]
      omega
    have eC1 : cntC (p ++ lhs ++ q) = cntC p + cntC lhs + cntC q := by
      show cnt (.terminal .c) (p ++ lhs ++ q) + cnt (.nonterminal .C) (p ++ lhs ++ q)
          = (cnt (.terminal .c) p + cnt (.nonterminal .C) p) +
            (cnt (.terminal .c) lhs + cnt (.nonterminal .C) lhs) +
            (cnt (.terminal .c) q + cnt (.nonterminal .C) q)
      rw [cnt_concat3, cnt_concat3]
      omega
    have eA2 : cntA (p ++ rhs ++ q) = cntA p + cntA rhs + cntA q :=
      cnt_concat3 p rhs q (.terminal .a)
    have eB2 : cntB (p ++ rhs ++ q) = cntB p + cntB rhs + cntB q := by
      show cnt (.terminal .b) (p ++ rhs ++ q) + cnt (.nonterminal .B) (p ++ rhs ++ q)
          = (cnt (.terminal .b) p + cnt (.nonterminal .B) p) +
            (cnt (.terminal .b) rhs + cnt (.nonterminal .B) rhs) +
            (cnt (.terminal .b) q + cnt (.nonterminal .B) q)
      rw [cnt_concat3, cnt_concat3]
      omega
    have eC2 : cntC (p ++ rhs ++ q) = cntC p + cntC rhs + cntC q := by
      show cnt (.terminal .c) (p ++ rhs ++ q) + cnt (.nonterminal .C) (p ++ rhs ++ q)
          = (cnt (.terminal .c) p + cnt (.nonterminal .C) p) +
            (cnt (.terminal .c) rhs + cnt (.nonterminal .C) rhs) +
            (cnt (.terminal .c) q + cnt (.nonterminal .C) q)
      rw [cnt_concat3, cnt_concat3]
      omega
    obtain ⟨huAB, huBC⟩ := hu
    rw [eA1, eB1] at huAB
    rw [eB1, eC1] at huBC
    show cntA (p ++ rhs ++ q) = cntB (p ++ rhs ++ q) ∧
      cntB (p ++ rhs ++ q) = cntC (p ++ rhs ++ q)
    rw [eA2, eB2, eC2]
    have crule : ∀ {l r : List (Symbol ABC ABCNT)}, (l, r) ∈ abcGrammar.rules →
        cntA l + cntB r = cntA r + cntB l ∧
          cntB l + cntC r = cntB r + cntC l := by
      intro l r hr
      simp [abcGrammar] at hr
      rcases hr with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
        ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
        constructor <;> decide
    obtain ⟨c1, c2⟩ := crule hrule
    simp [abcGrammar] at hrule
    rcases hrule with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
      ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
      constructor <;> omega

/-- Derivations preserve balancedness. -/
theorem derives_balanced {u v : List (Symbol ABC ABCNT)}
    (h : Derives abcGrammar u v) (hu : Balanced u) : Balanced v := by
  induction h with
  | refl => exact hu
  | tail _ hstep ih => exact rewrites_balanced hstep ih

/-- The initial form `[S]` is balanced, with all counts zero. -/
theorem balanced_initial : Balanced [Symbol.nonterminal ABCNT.S] :=
  ⟨by decide, by decide⟩

/-- Every generated terminal word has equally many `a`'s, `b`'s and
`c`'s. -/
theorem language_subset_balanced {w : List ABC} (hw : w ∈ language abcGrammar) :
    Balanced (w.map Symbol.terminal) :=
  derives_balanced hw balanced_initial

/-- `aabbc` is not generated: its counts are `2 = 2 ≠ 1`. -/
theorem aabbc_not_mem : [ABC.a, ABC.a, ABC.b, ABC.b, ABC.c] ∉
    language abcGrammar := by
  intro h
  have hb := (language_subset_balanced h).2
  exact absurd hb (by decide)

end Language
