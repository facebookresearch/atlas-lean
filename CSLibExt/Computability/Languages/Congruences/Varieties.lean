/-
# Eilenberg varieties, pseudovarieties, and Schützenberger's theorem

Source: Pin, "Mathematical Foundations of Automata Theory" (Chapters IV, VII, X).
Source: Eilenberg, "Automata, Languages, and Machines" Vol. B (Chapters IV-V).
Source: Schützenberger, "On finite monoids having only trivial subgroups",
  Information and Control 8 (1965), 190-194.
-/
module

public import CSLibExt.Computability.Languages.Congruences.Boolean
public import CSLibExt.Computability.Languages.Congruences.Quotients
public import CSLibExt.Computability.Languages.Congruences.Recognition
public import CSLibExt.Computability.Languages.Congruences.WordMorphisms
public import Cslib.Computability.Languages.RegularLanguage
public import Mathlib.Algebra.Group.End
public import Mathlib.Data.Finset.Max
public import Mathlib.Data.Fintype.BigOperators
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Eilenberg varieties, pseudovarieties, and Schützenberger's theorem

A *variety of regular languages* is a family of classes of languages, one per finite
alphabet, whose members are all regular, whose every component contains the empty
language, and which is closed under Boolean operations, left and right quotients, and
inverse images under word morphisms (Eilenberg's theorem states that such families
correspond exactly to pseudovarieties of finite monoids). A *pseudovariety of finite
monoids* is a class of finite monoids containing the trivial monoid and closed under
submonoids, quotients, and finite products.

The aperiodic finite monoids, those with no nontrivial subgroup, form a pseudovariety.
Schützenberger's theorem identifies them algebraically with the star-free languages over finite
alphabets: for a finite alphabet, a regular language is star-free (built from singletons by
Boolean operations and concatenation, with no Kleene star) exactly when its syntactic monoid is
aperiodic. The finite-alphabet hypothesis is essential: over an infinite alphabet, the language
`{ε}` is not generated by this grammar (see `StarFreeHeight.not_isStarFree_one`). This file proves
the forward direction: `IsStarFree.aperiodic_syntacticMonoid`. The converse direction is not
proved here.

## Main results

* `IsAperiodic` is closed under submonoids, quotients, and products, and holds of the
  trivial monoid (`IsAperiodic.of_punit`).
* `IsPseudovariety`: the definition of a pseudovariety of finite monoids.
* `aperiodic_isPseudovariety`: aperiodic finite monoids form a pseudovariety.
* `IsVariety`: the definition of a variety of regular languages.
* `IsStarFree`: the inductive definition of star-free languages.
* `IsStarFree.aperiodic_syntacticMonoid`: the Schützenberger direction proved here.
-/

@[expose] public section

open scoped Computability

namespace Cslib.Language

universe u

variable {Symbol : Type u}

/-- A monoid is aperiodic when every element's powers eventually stabilize: for every `x`
there is an `n` with `x ^ (n + 1) = x ^ n`. This is the group-free condition: a finite group
is aperiodic only when it is trivial, since `x ^ (n + 1) = x ^ n` forces `x = 1` when `x` is
a unit. Source: Pin, "Mathematical Foundations of Automata Theory", Definition IV.3.1. -/
def IsAperiodic (M : Type*) [Monoid M] : Prop :=
  ∀ x : M, ∃ n, x ^ (n + 1) = x ^ n

/-- Powers of an aperiodic element stabilize at every later index: once
`x ^ (n + 1) = x ^ n`, all later consecutive powers agree.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.2. -/
theorem IsAperiodic.pow_stabilize {M : Type*} [Monoid M] {x : M} {n : ℕ}
    (h : x ^ (n + 1) = x ^ n) {k : ℕ} (hk : n ≤ k) : x ^ (k + 1) = x ^ k := by
  have hj : ∀ j : ℕ, x ^ (n + j) = x ^ n := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [← Nat.add_assoc, pow_succ, ih, ← pow_succ]
      exact h
  have e1 : x ^ (k + 1) = x ^ n := by
    have h1 := hj (k + 1 - n)
    rwa [Nat.add_sub_cancel' (by omega : n ≤ k + 1)] at h1
  have e2 : x ^ k = x ^ n := by
    have h2 := hj (k - n)
    rwa [Nat.add_sub_cancel' hk] at h2
  rw [e1, e2]

/-- Over a finite monoid, aperiodicity is uniform: one exponent works for every element.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.2. -/
theorem IsAperiodic.exists_uniform {M : Type*} [Monoid M] [Finite M]
    (h : IsAperiodic M) : ∃ k, ∀ x : M, x ^ (k + 1) = x ^ k := by
  classical
  let _ : Fintype M := Fintype.ofFinite M
  refine ⟨Finset.sup Finset.univ (fun x ↦ Classical.choose (h x)), fun x ↦ ?_⟩
  apply IsAperiodic.pow_stabilize (Classical.choose_spec (h x))
  exact Finset.le_sup (f := fun x ↦ Classical.choose (h x)) (Finset.mem_univ x)

/-- A surjective image of an aperiodic monoid is aperiodic: quotients of aperiodic monoids
are aperiodic. Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.of_surjective {M N : Type*} [Monoid M] [Monoid N]
    (hM : IsAperiodic M) (f : M →* N) (hf : Function.Surjective f) : IsAperiodic N := by
  intro y
  obtain ⟨x, rfl⟩ := hf y
  obtain ⟨n, hn⟩ := hM x
  exact ⟨n, by simp only [← map_pow, hn]⟩

/-- A submonoid of an aperiodic monoid is aperiodic.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.submonoid {M : Type*} [Monoid M] (hM : IsAperiodic M)
    (S : Submonoid M) : IsAperiodic S := by
  intro x
  obtain ⟨n, hn⟩ := hM (x : M)
  refine ⟨n, ?_⟩
  apply Subtype.ext
  simp only [SubmonoidClass.coe_pow]
  exact hn

/-- A product of aperiodic monoids is aperiodic.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.prod {M N : Type*} [Monoid M] [Monoid N]
    (hM : IsAperiodic M) (hN : IsAperiodic N) : IsAperiodic (M × N) := by
  rintro ⟨x, y⟩
  obtain ⟨nx, hnx⟩ := hM x
  obtain ⟨ny, hny⟩ := hN y
  refine ⟨max nx ny, ?_⟩
  have hx : x ^ (max nx ny + 1) = x ^ max nx ny :=
    IsAperiodic.pow_stabilize hnx (Nat.le_max_left nx ny)
  have hy : y ^ (max nx ny + 1) = y ^ max nx ny :=
    IsAperiodic.pow_stabilize hny (Nat.le_max_right nx ny)
  apply Prod.ext
  · simpa using hx
  · simpa using hy

/-- Aperiodicity is preserved under monoid isomorphism.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.of_mulEquiv {M N : Type*} [Monoid M] [Monoid N]
    (hM : IsAperiodic M) (e : M ≃* N) : IsAperiodic N :=
  IsAperiodic.of_surjective hM e.toMonoidHom e.surjective

/-- A pseudovariety of finite monoids is a class of finite monoids containing the trivial
monoid (the empty finite product, as `PUnit`) and closed under submonoids, quotients,
and finite direct products. The trivial-monoid clause is the nonemptiness condition:
without it, the constantly-false class would vacuously satisfy every closure property.
Source: Eilenberg, "Automata, Languages, and Machines" Vol. B, Chapter IV, Definition 1.1. -/
def IsPseudovariety (P : ∀ (M : Type), [Monoid M] → [Finite M] → Prop) : Prop :=
  (P PUnit) ∧
  (∀ (M : Type) [Monoid M] [Finite M], P M →
    ∀ (S : Submonoid M), P S) ∧
  (∀ (M N : Type) [Monoid M] [Finite M] [Monoid N] [Finite N] (f : M →* N),
    Function.Surjective f → P M → P N) ∧
  (∀ (M N : Type) [Monoid M] [Finite M] [Monoid N] [Finite N],
    P M → P N → P (M × N))

/-- The trivial monoid is aperiodic: it has only one element, so every power is `1`.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.of_punit : IsAperiodic PUnit := by
  intro x
  exact ⟨0, by simp⟩

/-- The aperiodic finite monoids form a pseudovariety.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem aperiodic_isPseudovariety :
    IsPseudovariety (fun (M : Type) [Monoid M] [Finite M] ↦ IsAperiodic M) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact IsAperiodic.of_punit
  · intro M _ _ hM S
    exact IsAperiodic.submonoid hM S
  · intro M N _ _ _ _ f hf hM
    exact IsAperiodic.of_surjective hM f hf
  · intro M N _ _ _ _ hM hN
    exact IsAperiodic.prod hM hN

/-- A variety of regular languages is a family of classes of languages, one per finite
alphabet, such that every member is regular, every component contains the empty language
(hence, by complement closure, the universal language: each component is a Boolean
algebra), and the family is closed under Boolean operations, left and right quotients,
and inverse images under word morphisms (free-monoid morphisms) between finite
alphabets. The finite-alphabet indexing, the regularity requirement, and the empty-language
clause are part of Eilenberg's definition: without regularity, the constant family
`V L := True` would satisfy every closure property while containing nonregular
languages, and without the empty-language clause, the constantly-false family would
vacuously satisfy every closure property. Source: Eilenberg, "Automata, Languages, and
Machines" Vol. B, Chapter IV, Definition 2.1. -/
def IsVariety (V : ∀ {α : Type} [Finite α], Language α → Prop) : Prop :=
  (∀ {α : Type} [Finite α], V (0 : Language α)) ∧
  (∀ {α : Type} [Finite α] {L : Language α}, V L → L.IsRegular) ∧
  (∀ {α : Type} [Finite α] {L : Language α}, V L → V Lᶜ) ∧
  (∀ {α : Type} [Finite α] {L K : Language α}, V L → V K → V (L + K)) ∧
  (∀ {α : Type} [Finite α] {L : Language α} {w : List α}, V L → V (L.leftQuotient w)) ∧
  (∀ {α : Type} [Finite α] {L : Language α} {w : List α}, V L → V (rightQuotient L w)) ∧
  (∀ {α β : Type} [Finite α] [Finite β] {L : Language α}
    {φ : FreeMonoid β →* FreeMonoid α}, V L → V (wordMorphismPreimage φ L))

/-- Star-free languages: those built from the empty language and singletons by Boolean
operations and concatenation, with no Kleene star. Source: Schützenberger, "On finite
monoids having only trivial subgroups", Information and Control 8 (1965), 190-194. -/
inductive IsStarFree : Language Symbol → Prop
  | empty : IsStarFree 0
  | singleton (a : Symbol) : IsStarFree {[a]}
  | compl {L : Language Symbol} : IsStarFree L → IsStarFree Lᶜ
  | union {L K : Language Symbol} : IsStarFree L → IsStarFree K → IsStarFree (L + K)
  | concat {L K : Language Symbol} : IsStarFree L → IsStarFree K → IsStarFree (L * K)

/-- Every star-free language is regular: Boolean operations and concatenation preserve
regularity. Source: Sipser, "Introduction to the Theory of Computation", 3rd ed.,
Theorem 1.19. -/
theorem IsStarFree.isRegular {L : Language Symbol} (h : IsStarFree L) : L.IsRegular := by
  induction h with
  | empty => exact IsRegular.zero
  | singleton a => exact IsRegular.char a
  | compl h ih => exact IsRegular.compl ih
  | union h₁ h₂ ih₁ ih₂ => exact IsRegular.add ih₁ ih₂
  | concat h₁ h₂ ih₁ ih₂ => exact IsRegular.mul ih₁ ih₂

/-- The syntactic monoid of the empty language is trivial: every class is `1`.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter IV. -/
theorem IsAperiodic.of_syntacticMonoid_empty :
    IsAperiodic (SyntacticMonoid (0 : Language Symbol)) := by
  intro q
  obtain ⟨x, rfl⟩ := syntacticMorphism_surjective (0 : Language Symbol) q
  refine ⟨0, ?_⟩
  have hx : syntacticMorphism (0 : Language Symbol) x = 1 := by
    rw [← map_one (syntacticMorphism (0 : Language Symbol))]
    apply (syntacticMorphism_eq_iff (0 : Language Symbol) x 1).mpr
    intro u v
    simp
  simp only [zero_add, pow_one, pow_zero]
  exact hx

/-- The powers of a word in the free monoid list out as repetitions of its letter list.
Source: Mathlib, `FreeMonoid.toList_prod`. -/
theorem toList_pow (w : FreeMonoid Symbol) (k : ℕ) :
    FreeMonoid.toList (w ^ k) = (List.replicate k (FreeMonoid.toList w)).flatten := by
  rw [← List.prod_replicate k w, FreeMonoid.toList_prod]
  simp [List.map_replicate]

/-- A syntactic power identity for a prescribed repeated block: if the `k`-th and `(k+1)`-th
powers of `w` agree in the syntactic monoid of `L`, then a block of `k` copies of `w`
and a block of `k + 1` copies agree in every two-sided context.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.2. -/
theorem syntacticRel_pow_of_pow_eq {L : Language Symbol} {w : FreeMonoid Symbol} {k : ℕ}
    (h : (syntacticMorphism L w) ^ (k + 1) = (syntacticMorphism L w) ^ k)
    (u v : FreeMonoid Symbol) :
    FreeMonoid.toList (u * w ^ (k + 1) * v) ∈ L ↔
      FreeMonoid.toList (u * w ^ k * v) ∈ L := by
  have hrel : syntacticRel L (w ^ (k + 1)) (w ^ k) := by
    apply (syntacticMorphism_eq_iff L (w ^ (k + 1)) (w ^ k)).mp
    simp only [map_pow]
    exact h
  exact hrel u v

/-- The length of the list of a power is the exponent times the length of the word.
Source: Mathlib, `FreeMonoid.toList_mul`. -/
theorem length_toList_pow (w : FreeMonoid Symbol) (k : ℕ) :
    (FreeMonoid.toList (w ^ k)).length = k * (FreeMonoid.toList w).length := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, FreeMonoid.toList_mul, List.length_append, ih]
    ring

/-- A syntactic power identity converts to a power identity in the syntactic monoid.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter IV. -/
theorem pow_eq_of_syntacticRel {L : Language Symbol} {x : FreeMonoid Symbol} {n : ℕ}
    (h : syntacticRel L (x ^ (n + 1)) (x ^ n)) :
    (syntacticMorphism L x) ^ (n + 1) = (syntacticMorphism L x) ^ n := by
  have heq := (syntacticMorphism_eq_iff L (x ^ (n + 1)) (x ^ n)).mpr h
  simpa only [map_pow] using heq

/-- Two words that never occur in a singleton language in any context are syntactically
equivalent for that singleton language: both sides of the defining biconditional are false.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter IV. -/
theorem syntacticRel_singleton_of_dead {a : Symbol} {x y : FreeMonoid Symbol}
    (hx : ∀ u v : FreeMonoid Symbol, FreeMonoid.toList (u * x * v) ≠ [a])
    (hy : ∀ u v : FreeMonoid Symbol, FreeMonoid.toList (u * y * v) ≠ [a]) :
    syntacticRel ({[a]} : Language Symbol) x y := by
  intro u v
  exact ⟨fun h ↦ absurd h (hx u v), fun h ↦ absurd h (hy u v)⟩

/-- A word of length at least two never occurs in a one-letter language in any context: every
contextual extension has length at least two, while `[a]` has length one.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter IV. -/
theorem dead_singleton_of_length_ge {a : Symbol} {x : FreeMonoid Symbol}
    (hx : 2 ≤ (FreeMonoid.toList x).length) :
    ∀ u v : FreeMonoid Symbol, FreeMonoid.toList (u * x * v) ≠ [a] := by
  intro u v h
  have hlen := congrArg List.length h
  simp only [FreeMonoid.toList_mul, List.length_append, List.length_singleton] at hlen
  omega

/-- A word of length one, different from `[a]`, never occurs in the singleton language in any
context: a contextual extension of length one forces both contexts empty, hence the word
itself would have to be `[a]`.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter IV. -/
theorem dead_singleton_of_length_one_ne {a : Symbol} {x : FreeMonoid Symbol}
    (hx : (FreeMonoid.toList x).length = 1) (hne : FreeMonoid.toList x ≠ [a]) :
    ∀ u v : FreeMonoid Symbol, FreeMonoid.toList (u * x * v) ≠ [a] := by
  intro u v h
  have hlen := congrArg List.length h
  simp only [FreeMonoid.toList_mul, List.length_append, List.length_singleton, hx] at hlen
  have hu : FreeMonoid.toList u = [] := List.length_eq_zero_iff.mp (by omega)
  have hv : FreeMonoid.toList v = [] := List.length_eq_zero_iff.mp (by omega)
  simp only [FreeMonoid.toList_mul, hu, hv, List.nil_append, List.append_nil] at h
  exact hne h

/-- The syntactic monoid of a singleton language is aperiodic. The case analysis is on the
length of a representative word `x`: length zero gives `x = 1`; length one either equals
`[a]` (then `x ^ 3` and `x ^ 2` are both dead) or differs from `[a]` (then `x` and `x ^ 2`
are both dead); length at least two makes `x` and `x ^ 2` both dead.
Source: Schützenberger, "On finite monoids having only trivial subgroups",
Information and Control 8 (1965), 190-194. -/
theorem IsAperiodic.of_syntacticMonoid_singleton (a : Symbol) :
    IsAperiodic (SyntacticMonoid ({[a]} : Language Symbol)) := by
  intro q
  obtain ⟨x, rfl⟩ := syntacticMorphism_surjective _ q
  by_cases h0 : FreeMonoid.toList x = []
  · refine ⟨0, ?_⟩
    have hx : x = 1 := by
      have h1 := (FreeMonoid.ofList_toList x).symm
      rw [h0] at h1
      exact h1
    simp [hx]
  · by_cases h1 : FreeMonoid.toList x = [a]
    · refine ⟨2, ?_⟩
      apply pow_eq_of_syntacticRel
      apply syntacticRel_singleton_of_dead
      · intro u v
        exact dead_singleton_of_length_ge (x := x ^ (2 + 1)) (by
          rw [length_toList_pow, h1]
          simp) u v
      · intro u v
        exact dead_singleton_of_length_ge (x := x ^ 2) (by
          rw [length_toList_pow, h1]
          simp) u v
    · refine ⟨1, ?_⟩
      apply pow_eq_of_syntacticRel
      apply syntacticRel_singleton_of_dead
      · intro u v
        exact dead_singleton_of_length_ge (x := x ^ (1 + 1)) (by
          rw [length_toList_pow]
          have hpos : 0 < (FreeMonoid.toList x).length := by
            rw [Nat.pos_iff_ne_zero]
            intro hlen
            exact h0 (List.length_eq_zero_iff.mp hlen)
          omega) u v
      · intro u v
        by_cases hlen1 : (FreeMonoid.toList x).length = 1
        · have hlen1' : (FreeMonoid.toList (x ^ 1)).length = 1 := by
            rw [length_toList_pow, hlen1]
          have hne1' : FreeMonoid.toList (x ^ 1) ≠ [a] := by
            rw [pow_one]
            exact h1
          exact dead_singleton_of_length_one_ne hlen1' hne1' u v
        · exact dead_singleton_of_length_ge (x := x ^ 1) (by
            rw [length_toList_pow]
            have hpos : 0 < (FreeMonoid.toList x).length := by
              rw [Nat.pos_iff_ne_zero]
              intro hlen
              exact h0 (List.length_eq_zero_iff.mp hlen)
            omega) u v

/-- Aperiodicity of syntactic monoids is preserved under language complement, via the
canonical multiplicative equivalence between the two syntactic monoids.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.of_syntacticMonoid_compl {L : Language Symbol}
    (hL : IsAperiodic (SyntacticMonoid L)) :
    IsAperiodic (SyntacticMonoid Lᶜ) :=
  IsAperiodic.of_mulEquiv hL (syntacticMonoidComplEquiv L).symm

/-- Aperiodicity of syntactic monoids is preserved under language union: take the maximum
of the stabilization exponents for the two operands, and combine the two syntactic power
identities with the union case of syntactic equivalence.
Source: Pin, "Mathematical Foundations of Automata Theory", Proposition IV.3.4. -/
theorem IsAperiodic.of_syntacticMonoid_union {L K : Language Symbol}
    (hL : IsAperiodic (SyntacticMonoid L)) (hK : IsAperiodic (SyntacticMonoid K)) :
    IsAperiodic (SyntacticMonoid (L + K)) := by
  intro q
  obtain ⟨x, rfl⟩ := syntacticMorphism_surjective _ q
  obtain ⟨nL, hnL⟩ := hL (syntacticMorphism L x)
  obtain ⟨nK, hnK⟩ := hK (syntacticMorphism K x)
  refine ⟨max nL nK, ?_⟩
  have hrelL : syntacticRel L (x ^ (max nL nK + 1)) (x ^ max nL nK) := by
    apply (syntacticMorphism_eq_iff L _ _).mp
    simp only [map_pow]
    exact IsAperiodic.pow_stabilize hnL (Nat.le_max_left nL nK)
  have hrelK : syntacticRel K (x ^ (max nL nK + 1)) (x ^ max nL nK) := by
    apply (syntacticMorphism_eq_iff K _ _).mp
    simp only [map_pow]
    exact IsAperiodic.pow_stabilize hnK (Nat.le_max_right nL nK)
  have hrel : syntacticRel (L + K) (x ^ (max nL nK + 1)) (x ^ max nL nK) := by
    intro u v
    rw [Language.mem_add, Language.mem_add]
    exact or_congr (hrelL u v) (hrelK u v)
  exact pow_eq_of_syntacticRel hrel

/-- Classification of a split of a triple concatenation: a split of `U ++ X ++ V` into a
part in `L` and a part in `K` cuts inside `U`, inside `X`, or inside `V`.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter VII. -/
theorem mem_mul_triple_iff {L K : Language Symbol} {U X V : List Symbol} :
    (U ++ X ++ V ∈ L * K) ↔
      (∃ U1 U2 : List Symbol, U = U1 ++ U2 ∧ U1 ∈ L ∧ U2 ++ X ++ V ∈ K) ∨
      (∃ X1 X2 : List Symbol, X = X1 ++ X2 ∧ U ++ X1 ∈ L ∧ X2 ++ V ∈ K) ∨
      (∃ V1 V2 : List Symbol, V = V1 ++ V2 ∧ U ++ X ++ V1 ∈ L ∧ V2 ∈ K) := by
  constructor
  · intro h
    rw [Language.mem_mul] at h
    obtain ⟨A, hA, B, hBmem, hAB⟩ := h
    rcases (List.append_eq_append_iff.mp hAB) with ⟨r, hUX, hB⟩ | ⟨bs, hAeq, hVeq⟩
    · rcases (List.append_eq_append_iff.mp hUX) with ⟨c, hAeq2, hXeq⟩ | ⟨d, hUeq, hReq⟩
      · right
        left
        exact ⟨c, r, hXeq, by rw [← hAeq2]; exact hA, by rw [← hB]; exact hBmem⟩
      · left
        exact ⟨A, d, hUeq, hA, by rw [← hReq, ← hB]; exact hBmem⟩
    · right
      right
      exact ⟨bs, B, hVeq, by rw [← hAeq]; exact hA, hBmem⟩
  · rintro (⟨U1, U2, hU, hU1, hK⟩ | ⟨X1, X2, hX, hL, hK⟩ | ⟨V1, V2, hV, hL, hK⟩)
    · rw [Language.mem_mul]
      exact ⟨U1, hU1, U2 ++ X ++ V, hK, by rw [hU]; simp [List.append_assoc]⟩
    · rw [Language.mem_mul]
      exact ⟨U ++ X1, hL, X2 ++ V, hK, by rw [hX]; simp [List.append_assoc]⟩
    · rw [Language.mem_mul]
      exact ⟨U ++ X ++ V1, hL, V2, hK, by rw [hV]; simp [List.append_assoc]⟩

/-- A split of a repeated block `w ^ (N + 1)` cuts inside one copy: there are `i` full
copies before the cut, a prefix `p` of `w`, the complementary suffix `s` of `w`, and `j`
full copies after, with `i + j + 1 = N + 1`.
Source: Pin, "Mathematical Foundations of Automata Theory", Chapter VII. -/
theorem exists_split_pow {w : FreeMonoid Symbol} (N : ℕ) (X1 X2 : List Symbol)
    (h : X1 ++ X2 = FreeMonoid.toList (w ^ (N + 1))) :
    ∃ i p s j : _,
      FreeMonoid.toList w = p ++ s ∧ X1 = FreeMonoid.toList (w ^ i) ++ p ∧
        X2 = s ++ FreeMonoid.toList (w ^ j) ∧ i + j + 1 = N + 1 := by
  induction N generalizing X1 X2 with
  | zero =>
    refine ⟨0, X1, X2, 0, ?_, ?_, ?_, rfl⟩
    · simpa using h.symm
    · simp
    · simp
  | succ N ih =>
    have h2 : X1 ++ X2 = FreeMonoid.toList (w ^ (N + 1)) ++ FreeMonoid.toList w := by
      rw [pow_succ, FreeMonoid.toList_mul] at h
      exact h
    rcases (List.append_eq_append_iff.mp h2) with ⟨c, hUX, hX2⟩ | ⟨d, hX1, hW⟩
    · obtain ⟨i, p, s, j, hW, hX1', hc, hij⟩ := ih X1 c hUX.symm
      refine ⟨i, p, s, j + 1, hW, hX1', ?_, by omega⟩
      rw [hX2, hc, List.append_assoc, ← FreeMonoid.toList_mul (w ^ j) w, ← pow_succ]
    · refine ⟨N + 1, d, X2, 0, hW, hX1, ?_, by omega⟩
      simp

/-- Aperiodicity of syntactic monoids is preserved under language concatenation. For a word
`x`, let `kL`, `kK` be the stabilization exponents of its classes in the two syntactic
monoids, and put `N = kL + kK + 1`. A split of `u * x ^ (N + 1) * v` in `L * K` either
cuts in `u` or `v`, where one side stabilizes by `N ≥ kL, kK`, or cuts inside the repeated
block, where the cut can be shifted by one copy: if the left part already contains more
than `kL` full copies, delete a copy on the left; otherwise the right part contains more
than `kK` full copies, so delete a copy on the right. The reverse direction inserts a
copy by the same case split. This is the syntactic form of the Schützenberger product
argument.
Source: Schützenberger, "On finite monoids having only trivial subgroups",
Information and Control 8 (1965), 190-194. -/
theorem IsAperiodic.of_syntacticMonoid_concat {L K : Language Symbol}
    (hL : IsAperiodic (SyntacticMonoid L)) (hK : IsAperiodic (SyntacticMonoid K)) :
    IsAperiodic (SyntacticMonoid (L * K)) := by
  intro q
  obtain ⟨x, rfl⟩ := syntacticMorphism_surjective _ q
  obtain ⟨kL, hkL⟩ := hL (syntacticMorphism L x)
  obtain ⟨kK, hkK⟩ := hK (syntacticMorphism K x)
  set N := kL + kK + 1 with hN
  refine ⟨N, ?_⟩
  have stabL : ∀ {i : ℕ}, kL ≤ i → syntacticRel L (x ^ (i + 1)) (x ^ i) := by
    intro i hi
    apply (syntacticMorphism_eq_iff L _ _).mp
    simp only [map_pow]
    exact IsAperiodic.pow_stabilize hkL hi
  have stabK : ∀ {i : ℕ}, kK ≤ i → syntacticRel K (x ^ (i + 1)) (x ^ i) := by
    intro i hi
    apply (syntacticMorphism_eq_iff K _ _).mp
    simp only [map_pow]
    exact IsAperiodic.pow_stabilize hkK hi
  have hrel : syntacticRel (L * K) (x ^ (N + 1)) (x ^ N) := by
    intro u v
    have hListL : FreeMonoid.toList (u * x ^ (N + 1) * v) =
        FreeMonoid.toList u ++ FreeMonoid.toList (x ^ (N + 1)) ++ FreeMonoid.toList v := by
      simp [FreeMonoid.toList_mul]
    have hListR : FreeMonoid.toList (u * x ^ N * v) =
        FreeMonoid.toList u ++ FreeMonoid.toList (x ^ N) ++ FreeMonoid.toList v := by
      simp [FreeMonoid.toList_mul]
    rw [hListL, hListR]
    have list_eqL : ∀ (j : ℕ) (p : List Symbol),
        FreeMonoid.toList (u * x ^ j * FreeMonoid.ofList p) =
          FreeMonoid.toList u ++ FreeMonoid.toList (x ^ j) ++ p := by
      intro j p
      simp [FreeMonoid.toList_mul]
    have list_eqK : ∀ (s : List Symbol) (j : ℕ),
        FreeMonoid.toList (FreeMonoid.ofList s * x ^ j * v) =
          s ++ FreeMonoid.toList (x ^ j) ++ FreeMonoid.toList v := by
      intro s j
      simp [FreeMonoid.toList_mul]
    constructor
    · intro hmem
      rw [mem_mul_triple_iff] at hmem ⊢
      rcases hmem with ⟨U1, U2, hU, hU1, hKmem⟩ | ⟨X1, X2, hX, hLmem, hKmem⟩ |
          ⟨V1, V2, hV, hLmem, hV2⟩
      · left
        refine ⟨U1, U2, hU, hU1, ?_⟩
        have hiff := (stabK (by omega : kK ≤ N)) (FreeMonoid.ofList U2) v
        rw [list_eqK, list_eqK] at hiff
        exact hiff.mp hKmem
      · obtain ⟨i, p, s, j, hW, hX1, hX2, hij⟩ := exists_split_pow N X1 X2 hX.symm
        right
        left
        by_cases hi : kL < i
        · have hi1 : i - 1 + 1 = i := by omega
          have hSplit : FreeMonoid.toList (x ^ N) =
              (FreeMonoid.toList (x ^ (i - 1)) ++ p) ++ (s ++ FreeMonoid.toList (x ^ j)) := by
            have hexp : N = (i - 1) + 1 + j := by omega
            rw [hexp, pow_add, pow_succ, FreeMonoid.toList_mul, FreeMonoid.toList_mul, hW]
            simp only [List.append_assoc]
          have hrelL : syntacticRel L (x ^ i) (x ^ (i - 1)) := by
            have h := stabL (by omega : kL ≤ i - 1)
            rwa [hi1] at h
          have hiff := hrelL u (FreeMonoid.ofList p)
          rw [list_eqL, list_eqL] at hiff
          rw [hX1, ← List.append_assoc] at hLmem
          have hLmem' : FreeMonoid.toList u ++ (FreeMonoid.toList (x ^ (i - 1)) ++ p) ∈ L := by
            have htmp := hiff.mp hLmem
            rwa [List.append_assoc] at htmp
          refine ⟨FreeMonoid.toList (x ^ (i - 1)) ++ p, s ++ FreeMonoid.toList (x ^ j),
            hSplit, hLmem', ?_⟩
          rw [← hX2]
          exact hKmem
        · have hjk : kK < j := by omega
          have hj1 : j - 1 + 1 = j := by omega
          have hSplit : FreeMonoid.toList (x ^ N) =
              (FreeMonoid.toList (x ^ i) ++ p) ++ (s ++ FreeMonoid.toList (x ^ (j - 1))) := by
            have hexp : N = i + 1 + (j - 1) := by omega
            rw [hexp, pow_add, pow_succ, FreeMonoid.toList_mul, FreeMonoid.toList_mul, hW]
            simp only [List.append_assoc]
          have hrelK : syntacticRel K (x ^ j) (x ^ (j - 1)) := by
            have h := stabK (by omega : kK ≤ j - 1)
            rwa [hj1] at h
          have hiff := hrelK (FreeMonoid.ofList s) v
          rw [list_eqK, list_eqK] at hiff
          rw [hX2] at hKmem
          rw [hX1] at hLmem
          exact ⟨FreeMonoid.toList (x ^ i) ++ p, s ++ FreeMonoid.toList (x ^ (j - 1)),
            hSplit, hLmem, hiff.mp hKmem⟩
      · right
        right
        refine ⟨V1, V2, hV, ?_, hV2⟩
        have hiff := (stabL (by omega : kL ≤ N)) u (FreeMonoid.ofList V1)
        rw [list_eqL, list_eqL] at hiff
        exact hiff.mp hLmem
    · intro hmem
      rw [mem_mul_triple_iff] at hmem ⊢
      rcases hmem with ⟨U1, U2, hU, hU1, hKmem⟩ | ⟨X1, X2, hX, hLmem, hKmem⟩ |
          ⟨V1, V2, hV, hLmem, hV2⟩
      · left
        refine ⟨U1, U2, hU, hU1, ?_⟩
        have hiff := (stabK (by omega : kK ≤ N)) (FreeMonoid.ofList U2) v
        rw [list_eqK, list_eqK] at hiff
        exact hiff.mpr hKmem
      · have hX' : X1 ++ X2 = FreeMonoid.toList (x ^ ((N - 1) + 1)) := by
          have hN1 : (N - 1) + 1 = N := by omega
          rw [hN1]
          exact hX.symm
        obtain ⟨i, p, s, j, hW, hX1, hX2, hij⟩ := exists_split_pow (N - 1) X1 X2 hX'
        right
        left
        by_cases hi : kL ≤ i
        · have hSplit : FreeMonoid.toList (x ^ (N + 1)) =
              (FreeMonoid.toList (x ^ (i + 1)) ++ p) ++ (s ++ FreeMonoid.toList (x ^ j)) := by
            have hexp : N + 1 = (i + 1) + 1 + j := by omega
            rw [hexp, pow_add, pow_succ, FreeMonoid.toList_mul, FreeMonoid.toList_mul, hW]
            simp only [List.append_assoc]
          have hiff := (stabL hi) u (FreeMonoid.ofList p)
          rw [list_eqL, list_eqL] at hiff
          rw [hX1, ← List.append_assoc] at hLmem
          have hLmem' : FreeMonoid.toList u ++ (FreeMonoid.toList (x ^ (i + 1)) ++ p) ∈ L := by
            have htmp := hiff.mpr hLmem
            rwa [List.append_assoc] at htmp
          refine ⟨FreeMonoid.toList (x ^ (i + 1)) ++ p, s ++ FreeMonoid.toList (x ^ j),
            hSplit, hLmem', ?_⟩
          rw [← hX2]
          exact hKmem
        · have hjk : kK ≤ j := by omega
          have hSplit : FreeMonoid.toList (x ^ (N + 1)) =
              (FreeMonoid.toList (x ^ i) ++ p) ++ (s ++ FreeMonoid.toList (x ^ (j + 1))) := by
            have hexp : N + 1 = (i + 1) + (j + 1) := by omega
            rw [hexp, pow_add, pow_succ, FreeMonoid.toList_mul, FreeMonoid.toList_mul, hW]
            simp only [List.append_assoc]
          have hiff := (stabK hjk) (FreeMonoid.ofList s) v
          rw [list_eqK, list_eqK] at hiff
          rw [hX2] at hKmem
          rw [hX1] at hLmem
          exact ⟨FreeMonoid.toList (x ^ i) ++ p, s ++ FreeMonoid.toList (x ^ (j + 1)),
            hSplit, hLmem, hiff.mpr hKmem⟩
      · right
        right
        refine ⟨V1, V2, hV, ?_, hV2⟩
        have hiff := (stabL (by omega : kL ≤ N)) u (FreeMonoid.ofList V1)
        rw [list_eqL, list_eqL] at hiff
        exact hiff.mpr hLmem
  exact pow_eq_of_syntacticRel hrel

/-- Schützenberger's theorem, forward direction: every star-free language has an aperiodic
syntactic monoid. The induction follows the star-free construction: empty by triviality,
singletons by the dead-word case analysis, complement and union by the corresponding
preservation lemmas, concatenation by the one-copy shift argument.
Source: Schützenberger, "On finite monoids having only trivial subgroups",
Information and Control 8 (1965), 190-194. -/
theorem IsStarFree.aperiodic_syntacticMonoid {L : Language Symbol} (h : IsStarFree L) :
    IsAperiodic (SyntacticMonoid L) := by
  induction h with
  | empty => exact IsAperiodic.of_syntacticMonoid_empty
  | singleton a => exact IsAperiodic.of_syntacticMonoid_singleton a
  | compl _ ih => exact IsAperiodic.of_syntacticMonoid_compl ih
  | union _ _ ih₁ ih₂ => exact IsAperiodic.of_syntacticMonoid_union ih₁ ih₂
  | concat _ _ ih₁ ih₂ => exact IsAperiodic.of_syntacticMonoid_concat ih₁ ih₂

end Cslib.Language
