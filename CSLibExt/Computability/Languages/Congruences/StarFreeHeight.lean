module

public import CSLibExt.Computability.Languages.Congruences.Varieties
public import CSLibExt.Computability.Languages.GeneralizedRegularExpression
import Mathlib.Data.Set.Finite.Basic

/-!
# Local star-free languages and generalized star height

This theory module relates the star-free grammar in `Congruences.Varieties` to the
basic generalized regular-expression syntax. The dependency runs from this bridge
to both theories; basic generalized-expression clients do not import congruence theory.

`IsStarFree.hasGenHeightLe_zero` proves the inclusion over every alphabet.
`not_isStarFree_one` shows that its converse fails over an infinite alphabet: the
empty-word language has generalized height zero but is not generated by the local
grammar. The finite-exception argument is private. No finite-alphabet converse is asserted.
-/

@[expose] public section

open scoped Computability

namespace Cslib.Language

universe u

variable {α : Type u}

/-- Star-free languages built from the empty language and one-letter languages have
generalized star height zero, over any alphabet. The generalized expression syntax also
admits the empty word as a base case. Over infinite alphabets the converse fails:
`not_isStarFree_one` excludes that language from the local star-free grammar. -/
theorem IsStarFree.hasGenHeightLe_zero {L : Language α} (h : IsStarFree L) :
    HasGenHeightLe L 0 := by
  induction h with
  | empty => exact hasGenHeightLe_zero_zero
  | singleton a => exact ⟨.ofReg (.char a), RegularExpression.matches'_char a, le_rfl⟩
  | compl _ ih => exact ih.compl
  | union _ _ ih₁ ih₂ => exact ih₁.add ih₂
  | concat _ _ ih₁ ih₂ => exact ih₁.mul ih₂

/-- A locally star-free language cannot distinguish the empty word from a one-letter word
whose letter is outside a finite set of exceptions. -/
private theorem starFree_nil_singleton_exceptions {L : Language α} (h : IsStarFree L) :
    ∃ s : Finset α, ∀ a ∉ s, ([] ∈ L ↔ [a] ∈ L) := by
  classical
  induction h with
  | empty =>
      refine ⟨∅, ?_⟩
      intro a _
      simp
  | singleton b =>
      refine ⟨{b}, ?_⟩
      intro a ha
      have hab : a ≠ b := by simpa only [Finset.mem_singleton] using ha
      simp [hab]
  | compl _ ih =>
      obtain ⟨s, hs⟩ := ih
      exact ⟨s, fun a ha => not_congr (hs a ha)⟩
  | union _ _ ih₁ ih₂ =>
      obtain ⟨s, hs⟩ := ih₁
      obtain ⟨t, ht⟩ := ih₂
      refine ⟨s ∪ t, ?_⟩
      intro a ha
      have hsa : a ∉ s := fun h => ha (Finset.mem_union.mpr (Or.inl h))
      have hta : a ∉ t := fun h => ha (Finset.mem_union.mpr (Or.inr h))
      exact or_congr (hs a hsa) (ht a hta)
  | concat _ _ ih₁ ih₂ =>
      obtain ⟨s, hs⟩ := ih₁
      obtain ⟨t, ht⟩ := ih₂
      refine ⟨s ∪ t, ?_⟩
      intro a ha
      have hsa : a ∉ s := fun h => ha (Finset.mem_union.mpr (Or.inl h))
      have hta : a ∉ t := fun h => ha (Finset.mem_union.mpr (Or.inr h))
      constructor
      · intro hnil
        obtain ⟨x, hx, y, hy, hxy⟩ := Language.mem_mul.mp hnil
        obtain ⟨rfl, rfl⟩ := List.append_eq_nil_iff.mp hxy
        exact Language.mem_mul.mpr ⟨[], hx, [a], (ht a hta).mp hy, rfl⟩
      · intro hsingle
        obtain ⟨x, hx, y, hy, hxy⟩ := Language.mem_mul.mp hsingle
        rcases List.append_eq_singleton_iff.mp hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · exact Language.mem_mul.mpr ⟨[], hx, [], (ht a hta).mpr hy, rfl⟩
        · exact Language.mem_mul.mpr ⟨[], (hs a hsa).mpr hx, [], hy, rfl⟩

/-- Over an infinite alphabet, the language containing only the empty word is not
star-free under the local grammar generated by the empty language and one-letter languages.
It nevertheless has generalized star height zero by `hasGenHeightLe_zero_one`. -/
theorem not_isStarFree_one [Infinite α] : ¬ IsStarFree (1 : Language α) := by
  intro h
  obtain ⟨s, hs⟩ := starFree_nil_singleton_exceptions h
  obtain ⟨a, ha⟩ := s.exists_notMem
  have hsingle : [a] ∈ (1 : Language α) := (hs a ha).mp Language.nil_mem_one
  exact List.cons_ne_nil a [] ((Language.mem_one [a]).mp hsingle)

end Cslib.Language
