/-
# Büchi automata for a fragment of LTL
-/
module

public import CSLibExt.Logics.LTL.OmegaWord
public import CSLibExt.Computability.Languages.ExampleInfinitelyOften
public import Cslib.Computability.Automata.NA.BuchiInter
public import Cslib.Computability.Automata.NA.Sum

/-!
# Büchi automata for a fragment of LTL

Over the alphabet `Set Atom` (letters are the sets of true atoms), every formula
of the safety fragment, and the recurrence/persistence formulas `G F φ` and
`F G φ` for propositional `φ`, is accepted by a nondeterministic Büchi
automaton with the same language.

The safety fragment (`Cslib.LTL.Safety`) is generated by propositional formulas,
conjunction, disjunction, next, and `always` applied to a propositional formula.
`always` is *not* available for arbitrary safety formulas: `G (p ∨ X q)`,
`G (ψ ∨ ρ)`, and `G (X ψ)` for non-propositional `ψ`, `ρ` are not in this
fragment (BACKLOG B19 stays partial for that omitted scope; closing it needs
a construction for `G` of a disjunction, which does not distribute over `∨`).
The automaton construction is by induction on the fragment:

* a propositional formula is checked by a three-state automaton that records
  the verdict on the first letter (`propNa`);
* `always` of a propositional formula is checked by a one-state automaton that
  requires every letter to satisfy it (`alwaysNa`);
* conjunction and disjunction use the upstream Büchi intersection and union
  constructions (`Buchi.inter_language_eq`, `Buchi.iSum_language_eq`);
* next uses the shift automaton (`shiftBuchi`), which accepts `xs` iff the
  automaton for the body accepts `xs.tail`.

The `G F φ` and `F G φ` cases for propositional `φ` reuse the two-state
automata `infinitelyOftenNa` and `eventuallyAlwaysNa` from
`CSLibExt.Computability.Languages.ExampleInfinitelyOften`.

Main results:

* `Cslib.LTL.exists_buchi_of_safety`: every safety formula has a finite-state
  Büchi automaton with the same ω-language (`B19`, partial: `G` only of
  propositional formulas; `G` of a non-propositional safety formula, e.g.
  `G (p ∨ X q)`, is not in this fragment).
* `Cslib.LTL.language_always_eventually`, `Cslib.LTL.language_eventually_always`:
  the `G F φ` and `F G φ` automata for propositional `φ` (`B19`).

The full Vardi-Wolper construction for arbitrary LTL formulas is not done here;
it is `WantedExt` (see `WantedExt/TheoryOfComputation/VardiWolperWanted.lean`).

## References

* M. Y. Vardi, P. Wolper, "An automata-theoretic approach to automatic program
  verification", *Proceedings of LICS 1986*, 332-344 (the tableau construction;
  the fragment here is its safety and `GF`/`FG` core).
* W. Thomas, "Automata on infinite objects", in *Handbook of Theoretical Computer
  Science*, Vol. B, Elsevier, 1990, Section 3 (Büchi automata for `G F` / `F G`).
-/

@[expose] public section

namespace Cslib
namespace LTL

open Filter ωSequence Cslib.Automata.ωAcceptor
open Cslib.Automata.NA
open Cslib.ωLanguage.Example

variable {Atom : Type*}
variable {State : Type*}

/-- Propositional formulas: atoms, truth, negation, conjunction. -/
inductive PropFormula (Atom : Type*) where
  /-- An atom, true at a letter containing it. -/
  | atom (a : Atom) : PropFormula Atom
  /-- Truth. -/
  | top : PropFormula Atom
  /-- Negation. -/
  | not (φ : PropFormula Atom) : PropFormula Atom
  /-- Conjunction. -/
  | and (φ ψ : PropFormula Atom) : PropFormula Atom

namespace PropFormula

/-- Evaluation of a propositional formula on a letter (a set of true atoms). -/
def eval : PropFormula Atom → Set Atom → Prop
  | .atom a, s => a ∈ s
  | .top, _ => True
  | .not φ, s => ¬ eval φ s
  | .and φ ψ, s => eval φ s ∧ eval ψ s

/-- A propositional formula as an LTL formula. -/
def toLTL : PropFormula Atom → Formula Atom
  | .atom a => .atom a
  | .top => .top
  | .not φ => .not (toLTL φ)
  | .and φ ψ => .and (toLTL φ) (toLTL ψ)

end PropFormula

/-- A propositional formula holds on a word iff it evaluates to true on the first
letter. -/
theorem satisfies_toLTL (φ : PropFormula Atom) (w : ωSequence (Set Atom)) :
    Word.Satisfies (fun s a => a ∈ s) w φ.toLTL ↔ φ.eval (w 0) := by
  induction φ with
  | atom a => exact Iff.rfl
  | top => exact Iff.rfl
  | not φ ih => exact not_congr ih
  | and φ ψ ihφ ihψ => exact and_congr ihφ ihψ

/-- A propositional formula holds at position `k` iff it evaluates to true on the
`k`-th letter. -/
theorem satisfiesAt_toLTL (φ : PropFormula Atom) (w : ωSequence (Set Atom)) (k : ℕ) :
    Word.SatisfiesAt (fun s a => a ∈ s) w k φ.toLTL ↔ φ.eval (w k) := by
  rw [Word.SatisfiesAt, satisfies_toLTL]
  simp [ωSequence.get_drop]

/-! ## The `always` automaton -/

/-- The one-state Büchi automaton for `G φ` with `φ` propositional: it stays
forever, requiring every letter to satisfy `φ`. -/
def alwaysNa (φ : PropFormula Atom) : Buchi Unit (Set Atom) where
  Tr _ s _ := φ.eval s
  start := {()}
  accept := {()}

/-- The `always` automaton accepts exactly the language of `G φ`. -/
theorem language_alwaysNa (φ : PropFormula Atom) :
    language (alwaysNa φ) =
      Word.language (fun s a => a ∈ s) (Formula.always φ.toLTL) := by
  apply ωLanguage.mem_ext
  intro xs
  rw [mem_language, Word.mem_language, Word.Satisfies.always_iff]
  constructor
  · rintro ⟨ss, hrun, -⟩
    intro k
    rw [satisfiesAt_toLTL]
    exact hrun.trans k
  · intro h
    refine ⟨(⟨fun _ => ()⟩ : ωSequence Unit), ⟨rfl, fun k => ?_⟩, ?_⟩
    · have h' := h k
      rwa [satisfiesAt_toLTL] at h'
    · exact Frequently.of_forall (fun _ => rfl)

/-! ## The `G F` / `F G` automata -/

/-- The `G F φ` automaton for propositional `φ`: a word is accepted iff `φ`
holds at infinitely many positions. -/
theorem language_always_eventually (φ : PropFormula Atom) :
    language (infinitelyOftenNa {s | φ.eval s}) =
      Word.language (fun s a => a ∈ s) (Formula.always (Formula.eventually φ.toLTL)) := by
  rw [language_infinitelyOftenNa]
  apply ωLanguage.mem_ext
  intro xs
  rw [mem_infinitelyOften, Word.mem_language, Word.Satisfies.always_eventually_iff]
  constructor
  · intro h
    exact Frequently.mono h (fun k hk => (satisfiesAt_toLTL φ xs k).mpr hk)
  · intro h
    exact Frequently.mono h (fun k hk => (satisfiesAt_toLTL φ xs k).mp hk)

/-- The `F G φ` automaton for propositional `φ`: a word is accepted iff `φ`
holds at all but finitely many positions. -/
theorem language_eventually_always (φ : PropFormula Atom) :
    language (eventuallyAlwaysNa {s | φ.eval s}) =
      Word.language (fun s a => a ∈ s)
        (Formula.eventually (Formula.always φ.toLTL)) := by
  rw [language_eventuallyAlwaysNa]
  apply ωLanguage.mem_ext
  intro xs
  rw [mem_eventuallyAlways, Word.mem_language, Word.Satisfies.eventually_always_iff]
  constructor
  · intro h
    exact (Filter.Eventually.mono h (fun k hk => (satisfiesAt_toLTL φ xs k).mpr hk))
  · intro h
    exact (Filter.Eventually.mono h (fun k hk => (satisfiesAt_toLTL φ xs k).mp hk))

/-! ## The propositional automaton -/

/-- The automaton for a propositional formula: it records the verdict on the
first letter in its state (`some true` / `some false`) and then stays put,
accepting in `some true`. -/
def propNa (φ : PropFormula Atom) : Buchi (Option Bool) (Set Atom) where
  Tr p x q :=
    (∃ b, p = none ∧ q = some b ∧ ((b = true ∧ φ.eval x) ∨ (b = false ∧ ¬ φ.eval x))) ∨
      (∃ b, p = some b ∧ q = some b)
  start := {none}
  accept := {some true}

/-- The propositional automaton accepts exactly the language of `φ`. -/
theorem language_propNa (φ : PropFormula Atom) :
    language (propNa φ) =
      Word.language (fun s a => a ∈ s) φ.toLTL := by
  apply ωLanguage.mem_ext
  intro xs
  rw [mem_language, Word.mem_language]
  constructor
  · rintro ⟨ss, hrun, hacc⟩
    -- The first transition records the verdict on the first letter.
    have h0 : ss 0 = none := hrun.start
    have h1 : ∃ b, ss 1 = some b ∧
        ((b = true ∧ φ.eval (xs 0)) ∨ (b = false ∧ ¬ φ.eval (xs 0))) := by
      rcases hrun.trans 0 with ⟨b, hp, hq, hb⟩ | ⟨b, hp, hq⟩
      · exact ⟨b, hq, hb⟩
      · rw [h0] at hp
        exact absurd hp (by simp)
    -- Afterwards the state stays put.
    have hstay : ∀ k, 1 ≤ k → ss k = ss 1 := by
      intro k hk
      induction k, hk using Nat.le_induction with
      | base => rfl
      | succ k hk ih =>
        rcases hrun.trans k with ⟨b, hp, hq, hb⟩ | ⟨b', hp, hq⟩
        · rw [ih] at hp
          obtain ⟨b0, hb0, -⟩ := h1
          rw [hb0] at hp
          exact absurd hp (by simp)
        · rw [ih] at hp
          obtain ⟨b0, hb0, -⟩ := h1
          rw [hb0] at hp
          have hbb : b0 = b' := Option.some.inj hp
          rw [hq, hb0, hbb]
    rw [satisfies_toLTL]
    -- The accepting state is visited at some `k ≥ 1`, hence the verdict is `true`.
    obtain ⟨k, hkge, hkacc⟩ := frequently_atTop.mp hacc 1
    rw [hstay k hkge] at hkacc
    obtain ⟨b0, hb0, hbv⟩ := h1
    rw [hb0] at hkacc
    rcases hbv with ⟨hb, hev⟩ | ⟨hb, hev⟩
    · rw [hb] at hkacc
      exact hev
    · rw [hb] at hkacc
      exact absurd hkacc (by simp [propNa])
  · intro h
    rw [satisfies_toLTL] at h
    refine ⟨(⟨fun k => match k with | 0 => none | _ + 1 => some true⟩ :
      ωSequence (Option Bool)), ⟨rfl, fun k => ?_⟩, ?_⟩
    · cases k with
      | zero => exact Or.inl ⟨true, rfl, rfl, Or.inl ⟨rfl, h⟩⟩
      | succ k => exact Or.inr ⟨true, rfl, rfl⟩
    · rw [frequently_atTop]
      intro N
      exact ⟨N + 1, by omega, rfl⟩

/-! ## The shift automaton -/

/-- The shift automaton of `a`: it accepts `xs` iff `a` accepts `xs.tail`. The
first transition moves from `none` to a start state of `a`; afterwards it mimics
`a`. -/
def shiftBuchi (a : Buchi State (Set Atom)) : Buchi (Option State) (Set Atom) where
  Tr p x q :=
    (∃ s, p = none ∧ q = some s ∧ s ∈ a.start) ∨
      (∃ s s', p = some s ∧ q = some s' ∧ a.Tr s x s')
  start := {none}
  accept := some '' a.accept

/-- The shift automaton accepts `xs` iff the original automaton accepts `xs.tail`. -/
theorem language_shiftBuchi (a : Buchi State (Set Atom)) :
    language (shiftBuchi a) = {xs : ωSequence (Set Atom) | xs.tail ∈ language a} := by
  apply ωLanguage.mem_ext
  intro xs
  rw [mem_language]
  show Accepts (shiftBuchi a) xs ↔ xs.tail ∈ language a
  rw [mem_language]
  constructor
  · rintro ⟨ss, hrun, hacc⟩
    -- Every `ss (k + 1)` is `some _`.
    have hsome : ∀ k, ∃ s, ss (k + 1) = some s := by
      intro k
      induction k with
      | zero =>
        rcases hrun.trans 0 with ⟨s, hp, hq, hs⟩ | ⟨s, s', hp, hq, htr⟩
        · exact ⟨s, hq⟩
        · have h0 : ss 0 = none := hrun.start
          rw [h0] at hp
          exact absurd hp (by simp)
      | succ k ih =>
        obtain ⟨s, hs⟩ := ih
        rcases hrun.trans (k + 1) with ⟨s', hp, hq, hstart⟩ | ⟨s', s'', hp, hq, htr⟩
        · rw [hs] at hp
          exact absurd hp (by simp)
        · exact ⟨s'', hq⟩
    classical
    choose tt htt using hsome
    refine ⟨tt, ⟨?_, ?_⟩, ?_⟩
    · -- The start state of the tail run comes from the first transition.
      rcases hrun.trans 0 with ⟨s, hp, hq, hs⟩ | ⟨s, s', hp, hq, htr⟩
      · have h1 : ss 1 = some (tt 0) := htt 0
        rw [hq] at h1
        have : s = tt 0 := Option.some.inj h1
        show tt 0 ∈ a.start
        rw [← this]
        exact hs
      · have h0 : ss 0 = none := hrun.start
        rw [h0] at hp
        exact absurd hp (by simp)
    · intro k
      rcases hrun.trans (k + 1) with ⟨s', hp, hq, hstart⟩ | ⟨s', s'', hp, hq, htr⟩
      · have h1 : ss (k + 1) = some (tt k) := htt k
        rw [h1] at hp
        exact absurd hp (by simp)
      · have h1 : ss (k + 1) = some (tt k) := htt k
        have h2 : ss (k + 2) = some (tt (k + 1)) := htt (k + 1)
        rw [h1] at hp
        rw [h2] at hq
        have e1 : s' = tt k := Option.some.inj hp.symm
        have e2 : s'' = tt (k + 1) := Option.some.inj hq.symm
        show a.Tr (tt k) (xs (k + 1)) (tt (k + 1))
        rw [← e1, ← e2]
        exact htr
    · -- Infinitely often `some _` accepting means infinitely often accepting in `a`.
      rw [frequently_atTop]
      intro N
      obtain ⟨b, hbge, hbacc⟩ := frequently_atTop.mp hacc (N + 1)
      have hb1 : 1 ≤ b := by omega
      obtain ⟨b', hb'⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
      subst hb'
      obtain ⟨s, hsacc, hseq⟩ := hbacc
      have hss : ss (b' + 1) = some (tt b') := htt b'
      rw [hss] at hseq
      have e : s = tt b' := Option.some.inj hseq
      refine ⟨b', by omega, ?_⟩
      show tt b' ∈ a.accept
      rw [← e]
      exact hsacc
  · rintro ⟨tt, hrun, hacc⟩
    refine ⟨(⟨fun k => match k with | 0 => none | n + 1 => some (tt n)⟩ :
      ωSequence (Option State)), ⟨rfl, fun k => ?_⟩, ?_⟩
    · cases k with
      | zero =>
        exact Or.inl ⟨tt 0, rfl, rfl, hrun.start⟩
      | succ k =>
        exact Or.inr ⟨tt k, tt (k + 1), rfl, rfl, hrun.trans k⟩
    · rw [frequently_atTop]
      intro N
      obtain ⟨b, hbge, hbacc⟩ := frequently_atTop.mp hacc N
      exact ⟨b + 1, by omega, ⟨tt b, hbacc, rfl⟩⟩

/-! ## The safety fragment -/

/-- The restricted safety fragment of LTL: propositional formulas, conjunction,
disjunction, next, and `always` applied to a propositional formula. `always`
is not available for arbitrary safety formulas: `G (p ∨ X q)` is not in this
fragment, since `G` does not distribute over `∨`. -/
inductive Safety (Atom : Type*) where
  /-- A propositional formula, checked on the first letter. -/
  | prop (φ : PropFormula Atom) : Safety Atom
  /-- Conjunction. -/
  | and (ψ ρ : Safety Atom) : Safety Atom
  /-- Disjunction. -/
  | or (ψ ρ : Safety Atom) : Safety Atom
  /-- Next. -/
  | next (ψ : Safety Atom) : Safety Atom
  /-- `always` of a propositional formula. -/
  | alwaysProp (φ : PropFormula Atom) : Safety Atom

namespace Safety

/-- A safety formula as an LTL formula. -/
def toLTL : Safety Atom → Formula Atom
  | .prop φ => φ.toLTL
  | .and ψ ρ => .and ψ.toLTL ρ.toLTL
  | .or ψ ρ => Formula.or ψ.toLTL ρ.toLTL
  | .next ψ => .next ψ.toLTL
  | .alwaysProp φ => Formula.always φ.toLTL

end Safety

/-- **Büchi automata for the restricted safety fragment.** Every safety formula
has a
nondeterministic Büchi automaton with finitely many states and with the same
ω-language; the finite-state witness is what makes the automaton an
ω-regularity certificate (a Büchi automaton with an unrestricted state type
proves nothing, since every ω-language has one). `G` is covered only for
propositional bodies: `G (p ∨ X q)` is not in this fragment (B19 partial). -/
theorem exists_buchi_of_safety (ψ : Safety Atom) :
    ∃ (S : Type) (_ : Finite S) (a : Buchi S (Set Atom)),
      language a = Word.language (fun s a => a ∈ s) ψ.toLTL := by
  induction ψ with
  | prop φ =>
    exact ⟨Option Bool, inferInstance, propNa φ, language_propNa φ⟩
  | and ψ ρ ihψ ihρ =>
    obtain ⟨S1, hfin1, a1, ha1⟩ := ihψ
    obtain ⟨S2, hfin2, a2, ha2⟩ := ihρ
    classical
    -- Package the two automata as a `Bool`-indexed family for the intersection.
    let State : Bool → Type := fun b => match b with | false => S1 | true => S2
    let na : (i : Bool) → Cslib.Automata.NA (State i) (Set Atom) := fun b =>
      match b with | false => a1.toNA | true => a2.toNA
    let acc : (i : Bool) → Set (State i) := fun b =>
      match b with | false => a1.accept | true => a2.accept
    haveI : ∀ i, Finite (State i) := fun b => match b with
      | false => hfin1
      | true => hfin2
    refine ⟨(Π i, State i) × Bool, inferInstance,
      Buchi.mk (Buchi.interNA na acc) (Buchi.interAccept acc), ?_⟩
    have hInf : (⨅ i, language (Buchi.mk (na i) (acc i))) =
        language a1 ⊓ language a2 := by
      apply le_antisymm
      · apply le_inf
        · exact iInf_le _ false
        · exact iInf_le _ true
      · apply le_iInf
        intro b
        cases b with
        | false => exact inf_le_left
        | true => exact inf_le_right
    rw [Buchi.inter_language_eq, hInf]
    show language a1 ⊓ language a2 =
      Word.language (fun s a => a ∈ s) (Safety.toLTL (.and ψ ρ))
    rw [ha1, ha2]
    show Word.language (fun s a => a ∈ s) ψ.toLTL ⊓ Word.language (fun s a => a ∈ s) ρ.toLTL =
      Word.language (fun s a => a ∈ s) (.and ψ.toLTL ρ.toLTL)
    rw [Word.language_and]
  | or ψ ρ ihψ ihρ =>
    obtain ⟨S1, hfin1, a1, ha1⟩ := ihψ
    obtain ⟨S2, hfin2, a2, ha2⟩ := ihρ
    classical
    let State : Bool → Type := fun b => match b with | false => S1 | true => S2
    let na : (i : Bool) → Cslib.Automata.NA (State i) (Set Atom) := fun b =>
      match b with | false => a1.toNA | true => a2.toNA
    let acc : (i : Bool) → Set (State i) := fun b =>
      match b with | false => a1.accept | true => a2.accept
    haveI : ∀ i, Finite (State i) := fun b => match b with
      | false => hfin1
      | true => hfin2
    refine ⟨Σ i, State i, inferInstance,
      Buchi.mk (iSum na) (⋃ i, Sigma.mk i '' (acc i)), ?_⟩
    have hSup : (⨆ i, language (Buchi.mk (na i) (acc i))) =
        language a1 ⊔ language a2 := by
      apply le_antisymm
      · apply iSup_le
        intro b
        cases b with
        | false => exact le_sup_left
        | true => exact le_sup_right
      · apply sup_le
        · exact le_iSup (fun i => language (Buchi.mk (na i) (acc i))) false
        · exact le_iSup (fun i => language (Buchi.mk (na i) (acc i))) true
    rw [Buchi.iSum_language_eq, hSup]
    show language a1 ⊔ language a2 =
      Word.language (fun s a => a ∈ s) (Safety.toLTL (.or ψ ρ))
    rw [ha1, ha2]
    show Word.language (fun s a => a ∈ s) ψ.toLTL ⊔ Word.language (fun s a => a ∈ s) ρ.toLTL =
      Word.language (fun s a => a ∈ s) (Formula.or ψ.toLTL ρ.toLTL)
    rw [Word.language_or]
  | next ψ ih =>
    obtain ⟨S, hfin, a, ha⟩ := ih
    refine ⟨Option S, inferInstance, shiftBuchi a, ?_⟩
    rw [language_shiftBuchi, ha]
    apply ωLanguage.mem_ext
    intro xs
    change xs.tail ∈ Word.language (fun s a => a ∈ s) ψ.toLTL ↔
      Word.Satisfies (fun s a => a ∈ s) xs (.next ψ.toLTL)
    rw [Word.mem_language, Word.Satisfies.next_iff, ← Word.satisfies_tail]
  | alwaysProp φ =>
    exact ⟨Unit, inferInstance, alwaysNa φ, language_alwaysNa φ⟩

end LTL
end Cslib
