/-
# COLLAPSE OF A 3-COMPLEX TO A 1-COMPLEX: definitions

Source:
R. Malgouyres and A. R. Francés, "Determining whether a simplicial 3-complex collapses to a
1-complex is NP-complete", Discrete Geometry for Computer Imagery (DGCI 2008), Lecture Notes in
Computer Science 4992, Springer (2008), 177-188, doi:10.1007/978-3-540-79126-3_17;
M. Tancer, "Recognition of collapsible complexes is NP-complete", Discrete & Computational
Geometry 55 (2016), 21-38, doi:10.1007/s00454-015-9747-1 (definitions, Section 2).
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity
public import Mathlib.Logic.Relation
public import MathlibExt.Combinatorics.RationalSimplicialHomologyShared

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.CollapseToOneComplex

open MathlibExt.Combinatorics.RationalSimplicialHomologyShared

/-- An instance: generating faces of `K`, each a list of vertices. -/
abbrev CollapseToOneComplexInstance := List (List ℕ)

/-- The complex `K` generated by the listed faces: all subsets of the listed faces. -/
def complex (i : CollapseToOneComplexInstance) : Finset (Finset ℕ) :=
  (i.map List.toFinset).toFinset.biUnion Finset.powerset

/-- `σ` is a free face of `K`: a nonempty face of `K` that is not maximal and is contained in
exactly one maximal face `τ` of `K`. -/
def IsFreeFace (K : Finset (Finset ℕ)) (σ : Finset ℕ) : Prop :=
  σ.Nonempty ∧ σ ∈ K ∧ ¬ IsFacet K σ ∧
    ∃ τ ∈ K, IsFacet K τ ∧ σ ⊆ τ ∧ ∀ τ' ∈ K, IsFacet K τ' → σ ⊆ τ' → τ' = τ

/-- `L` arises from `K` by an elementary collapse: remove a free face `σ` of `K` and every face
of `K` containing `σ`. -/
def ElementaryCollapse (K L : Finset (Finset ℕ)) : Prop :=
  ∃ σ, IsFreeFace K σ ∧ L = K.filter fun ϑ => ¬ σ ⊆ ϑ

/-- `K` collapses to `L`: a finite (possibly empty) sequence of elementary collapses leads from
`K` to `L`. -/
def Collapses (K L : Finset (Finset ℕ)) : Prop :=
  Relation.ReflTransGen ElementaryCollapse K L

/-- Well-formedness of an instance: every listed face consists of at most 4 distinct vertices,
and some listed face has exactly 4 (so `K` has dimension 3). -/
def WellFormed (i : CollapseToOneComplexInstance) : Prop :=
  (∀ σ ∈ i, σ.Nodup ∧ σ.length ≤ 4) ∧ ∃ σ ∈ i, σ.length = 4

/-- `K` collapses to a complex of dimension at most 1. -/
def CollapseToOneComplexFeasible (i : CollapseToOneComplexInstance) : Prop :=
  ∃ L, Collapses (complex i) L ∧ topCard L ≤ 2

open Classical in
/-- COLLAPSE OF A 3-COMPLEX TO A 1-COMPLEX as a decision problem over bitstrings. -/
noncomputable def collapseToOneComplexDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := CollapseToOneComplexInstance) x with
  | some i => decide (WellFormed i ∧ CollapseToOneComplexFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.CollapseToOneComplex
