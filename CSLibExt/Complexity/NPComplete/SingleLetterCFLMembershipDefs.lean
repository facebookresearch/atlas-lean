/-
# SINGLE-LETTER CONTEXT-FREE LANGUAGE MEMBERSHIP: definitions

Source:
D. S. Johnson, "The NP-completeness column: an ongoing guide", J. Algorithms 4 (1983), 87-100,
doi:10.1016/0196-6774(83)90038-X, problem [2] SINGLE-LETTER CONTEXT-FREE LANGUAGE MEMBERSHIP
(reference: Huynh at FOCS-82; transformation from SUBSET SUM);
D. T. Huynh, "Deciding the inequivalence of context-free grammars with 1-letter terminal
alphabet is Σ₂ᵖ-complete", Proc. 23rd Annual Symposium on Foundations of Computer Science
(1982), 21-31, doi:10.1109/SFCS.1982.65, and Theoretical Computer Science 33 (1984), 305-326,
doi:10.1016/0304-3975(84)90092-6.
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity
public import CSLibExt.Complexity.NPComplete.QuasiRealTimeLanguageMembershipDefs

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.SingleLetterCFLMembership

open MetaMathlibExt.Complexity.NPComplete.QuasiRealTimeLanguageMembership
  (GrammarData toEncodedCFG GrammarWellFormed)

/-- An instance: the grammar `G` over the one-letter alphabet `{0}` and the exponent `K`. -/
abbrev SingleLetterCFLMembershipInstance := GrammarData × ℕ

/-- Well-formedness of an instance: the grammar is well-formed over the one-letter terminal
alphabet `{0}`, and `K` is positive. -/
def WellFormed (i : SingleLetterCFLMembershipInstance) : Prop :=
  GrammarWellFormed 1 i.1 ∧ 0 < i.2

/-- The string `wᴷ` (`K` copies of the terminal `0`) is generated by `G`. -/
def SingleLetterCFLMembershipFeasible (i : SingleLetterCFLMembershipInstance) : Prop :=
  List.replicate i.2 0 ∈ (toEncodedCFG i.1).language

open Classical in
/-- SINGLE-LETTER CONTEXT-FREE LANGUAGE MEMBERSHIP as a decision problem over bitstrings. -/
noncomputable def singleLetterCFLMembershipDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := SingleLetterCFLMembershipInstance) x with
  | some i => decide (WellFormed i ∧ SingleLetterCFLMembershipFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.SingleLetterCFLMembership
