/-
# MULTIPROCESSOR TASKS `P2|intree;p_i=1;size_i|ΣC_i`: definitions

Source:
Y. Zinder and V. H. Do, "Scheduling unit execution time tasks on two parallel machines with the
criteria of makespan and total completion time", in G. Kendall, E. Burke, S. Petrovic and
M. Gendreau (eds.), *Multidisciplinary Scheduling: Theory and Applications*, Springer (2005),
83-112, doi:10.1007/0-387-27744-7_5 (only the abstract was available);
P. Brucker and S. Knust, *Complexity results for scheduling problems*,
http://www2.informatik.uni-osnabrueck.de/knust/class/, class `pmpt_nop` (multiprocessor tasks on
parallel processors, without preemption), entry `P2|intree;p_i=1;size_i|ΣC_i` (minimal NP-hard
in the strong sense, citing Zinder and Do 2005).
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import CSLibExt.Complexity.NPComplete.UnitFlowShopPrecedenceMakespanDefs

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.TwoProcessorUnitTaskSizeInTreeCompletion

open UnitFlowShopPrecedenceMakespan (Prec PrecWellFormed)

/-- An instance `(sizes, A, K)`: the sizes `size_i` of the tasks `0, …, n - 1` (one per entry),
the precedence arcs `A` (`(i, j)`: task `i` precedes task `j`), and the bound `K`. -/
abbrev TwoProcessorUnitTaskSizeInstance := List ℕ × List (ℕ × ℕ) × ℕ

/-- The tasks have sizes `1` or `2`, and the arcs name tasks and generate an acyclic relation. -/
def SizesPrecWellFormed (i : TwoProcessorUnitTaskSizeInstance) : Prop :=
  (∀ s ∈ i.1, 1 ≤ s ∧ s ≤ 2) ∧ PrecWellFormed i.1.length i.2.1

/-- Well-formedness: `SizesPrecWellFormed`, and every task has at most one immediate successor
(a task `a` with `j < a` and no task strictly between) in the order generated by the arcs. -/
def WellFormed (i : TwoProcessorUnitTaskSizeInstance) : Prop :=
  SizesPrecWellFormed i ∧
    let lt := Relation.TransGen (Prec (n := i.1.length) i.2.1)
    ∀ j a b, (lt j a ∧ ∀ c, ¬ (lt j c ∧ lt c a)) → (lt j b ∧ ∀ c, ¬ (lt j c ∧ lt c b)) →
      a = b

/-- `σ j` is the start time of the unit task `j`: the tasks starting at any time `t` have total
size at most `2`, and if `i` precedes `j`, then `j` starts after `i` is completed. -/
def IsSchedule (sizes : List ℕ) (A : List (ℕ × ℕ)) (σ : Fin sizes.length → ℕ) : Prop :=
  (∀ t : ℕ, ∑ j ∈ Finset.univ.filter (fun j => σ j = t), sizes.get j ≤ 2) ∧
    ∀ i j, Prec A i j → σ i + 1 ≤ σ j

/-- Some schedule has total completion time `Σ (σ j + 1)` at most `K`. -/
def TwoProcessorUnitTaskSizeCompletionFeasible (i : TwoProcessorUnitTaskSizeInstance) : Prop :=
  ∃ σ : Fin i.1.length → ℕ, IsSchedule i.1 i.2.1 σ ∧ ∑ j, (σ j + 1) ≤ i.2.2

open Classical in
/-- `P2|intree;p_i=1;size_i|ΣC_i` as a decision problem over bitstrings. -/
noncomputable def twoProcessorUnitTaskSizeInTreeCompletionDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := TwoProcessorUnitTaskSizeInstance) x with
  | some i => decide (WellFormed i ∧ TwoProcessorUnitTaskSizeCompletionFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.TwoProcessorUnitTaskSizeInTreeCompletion
