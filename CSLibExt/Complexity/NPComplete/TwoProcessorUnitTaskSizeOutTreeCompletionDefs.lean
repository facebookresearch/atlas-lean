/-
# MULTIPROCESSOR TASKS `P2|outtree;p_i=1;size_i|ΣC_i`: definitions

Source:
Y. Zinder, V. H. Do and C. Oğuz, "Computational complexity of some scheduling problems with
multiprocessor tasks", Discrete Optimization 2 (2005), 391-408, doi:10.1016/j.disopt.2005.08.001,
Section 3;
P. Brucker and S. Knust, *Complexity results for scheduling problems*,
http://www2.informatik.uni-osnabrueck.de/knust/class/, class `pmpt_nop` (multiprocessor tasks on
parallel processors, without preemption), entry `P2|outtree;p_i=1;size_i|ΣC_i` (minimal NP-hard
in the strong sense, citing Zinder, Do and Oğuz 2005).
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity
public import CSLibExt.Complexity.NPComplete.TwoProcessorUnitTaskSizeInTreeCompletionDefs

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.TwoProcessorUnitTaskSizeOutTreeCompletion

open UnitFlowShopPrecedenceMakespan (Prec)
open TwoProcessorUnitTaskSizeInTreeCompletion
  (TwoProcessorUnitTaskSizeInstance SizesPrecWellFormed TwoProcessorUnitTaskSizeCompletionFeasible)

/-- Well-formedness: `SizesPrecWellFormed`, and every task has at most one immediate predecessor
(a task `a` with `a < j` and no task strictly between) in the order generated by the arcs. -/
def WellFormed (i : TwoProcessorUnitTaskSizeInstance) : Prop :=
  SizesPrecWellFormed i ∧
    let lt := Relation.TransGen (Prec (n := i.1.length) i.2.1)
    ∀ j a b, (lt a j ∧ ∀ c, ¬ (lt a c ∧ lt c j)) → (lt b j ∧ ∀ c, ¬ (lt b c ∧ lt c j)) →
      a = b

open Classical in
/-- `P2|outtree;p_i=1;size_i|ΣC_i` as a decision problem over bitstrings. -/
noncomputable def twoProcessorUnitTaskSizeOutTreeCompletionDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := TwoProcessorUnitTaskSizeInstance) x with
  | some i => decide (WellFormed i ∧ TwoProcessorUnitTaskSizeCompletionFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.TwoProcessorUnitTaskSizeOutTreeCompletion
