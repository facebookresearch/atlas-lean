/-
# MINIMUM LENGTH GENERATOR SEQUENCE: definitions

Source:
D. S. Johnson, "The NP-completeness column: an ongoing guide", J. Algorithms 3 (1982), 288-300,
doi:10.1016/0196-6774(82)90026-8, problem [5] MINIMUM LENGTH GENERATOR SEQUENCE;
S. Even and O. Goldreich, "The minimum-length generator sequence problem is NP-hard",
J. Algorithms 2 (1981), 311-313, doi:10.1016/0196-6774(81)90029-8.
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.MinimumLengthGeneratorSequence

/-- An instance: the degree `n`, the generators `g₀, …, g_{k-1}` (each the list of its values),
the target `P`, and `K` in unary (a list of `K` copies of `true`). -/
abbrev MinimumLengthGeneratorSequenceInstance := ℕ × List (List ℕ) × List ℕ × List Bool

/-- The value at `x` of the permutation given by the list `p` of its values. -/
def apply (p : List ℕ) (x : ℕ) : ℕ := p.getD x x

/-- The product of the generators with indices `w = [i₁, …, i_j]`, applied to `x`:
`g_{i₁} (g_{i₂} (⋯ (g_{i_j} x)))`. -/
def product (i : MinimumLengthGeneratorSequenceInstance) (w : List ℕ) (x : ℕ) : ℕ :=
  w.foldr (fun j y => apply (i.2.1.getD j []) y) x

/-- The sequence `w` of generator indices has product `P`. -/
def Generates (i : MinimumLengthGeneratorSequenceInstance) (w : List ℕ) : Prop :=
  (∀ j ∈ w, j < i.2.1.length) ∧ ∀ x < i.1, product i w x = apply i.2.2.1 x

/-- Well-formedness: every generator and the target are permutations of `0, …, n - 1`, the
target lies in the group generated by the generators, and `K` is a positive integer written in
unary. -/
def WellFormed (i : MinimumLengthGeneratorSequenceInstance) : Prop :=
  (∀ g ∈ i.2.1, g.Perm (List.range i.1)) ∧ i.2.2.1.Perm (List.range i.1) ∧
    (∃ w, Generates i w) ∧ i.2.2.2 ≠ [] ∧ ∀ b ∈ i.2.2.2, b = true

/-- Some sequence of at most `K` generators has product `P`. -/
def MinimumLengthGeneratorSequenceFeasible (i : MinimumLengthGeneratorSequenceInstance) :
    Prop :=
  ∃ w, w.length ≤ i.2.2.2.length ∧ Generates i w

open Classical in
/-- MINIMUM LENGTH GENERATOR SEQUENCE as a decision problem over bitstrings. -/
noncomputable def minimumLengthGeneratorSequenceDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := MinimumLengthGeneratorSequenceInstance) x with
  | some i => decide (WellFormed i ∧ MinimumLengthGeneratorSequenceFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.MinimumLengthGeneratorSequence
