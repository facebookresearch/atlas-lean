/-
# PERMUTATION GROUP BASE: definitions

Source:
K. D. Blaha, "Minimum bases for permutation groups: the greedy approximation", Journal of
Algorithms 13 (1992), 297-306, doi:10.1016/0196-6774(92)90020-D;
P. Crescenzi and V. Kann (eds.), *A compendium of NP optimization problems*, problem MINIMUM
PERMUTATION GROUP BASE (section Miscellaneous).
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity
public import Mathlib.GroupTheory.GroupAction.FixingSubgroup
public import Mathlib.GroupTheory.Perm.Basic

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.PermutationGroupBase

/-- An instance: the number `n` of letters, the generators (each the list of its `n` images),
and the bound `K`. -/
abbrev PermutationGroupBaseInstance := ℕ × List (List ℕ) × ℕ

/-- The permutations of `Fin n` that the generator lists denote. -/
def generators (i : PermutationGroupBaseInstance) : Set (Equiv.Perm (Fin i.1)) :=
  {σ | ∃ g ∈ i.2.1, ∀ x : Fin i.1, (σ x : ℕ) = g.getD x 0}

/-- The permutation group `G` generated by the generators. -/
def group (i : PermutationGroupBaseInstance) : Subgroup (Equiv.Perm (Fin i.1)) :=
  Subgroup.closure (generators i)

/-- Well-formedness of an instance: every generator lists a permutation of `0, ..., n - 1`, and
`0 < K ≤ n`. -/
def WellFormed (i : PermutationGroupBaseInstance) : Prop :=
  (∀ g ∈ i.2.1, g.Perm (List.range i.1)) ∧ 0 < i.2.2 ∧ i.2.2 ≤ i.1

/-- `G` has a base of at most `K` points: a set `B` of at most `K` letters such that the only
element of `G` fixing every point of `B` is the identity. -/
def PermutationGroupBaseFeasible (i : PermutationGroupBaseInstance) : Prop :=
  ∃ B : Finset (Fin i.1), B.card ≤ i.2.2 ∧
    group i ⊓ fixingSubgroup (Equiv.Perm (Fin i.1)) (B : Set (Fin i.1)) = ⊥

open Classical in
/-- PERMUTATION GROUP BASE as a decision problem over bitstrings. -/
noncomputable def permutationGroupBaseDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := PermutationGroupBaseInstance) x with
  | some i => decide (WellFormed i ∧ PermutationGroupBaseFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.PermutationGroupBase
