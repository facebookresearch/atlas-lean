/-
# EDOL GRAMMAR INFINITENESS: definitions

Source:
M. R. Garey and D. S. Johnson, *Computers and Intractability: A Guide to the
Theory of NP-Completeness*, W. H. Freeman (1979), problem [AL16] ETOL GRAMMAR
NON-EMPTINESS, p. 270, comment ("NP-complete if G contains just one table and exactly one
production for each symbol (G is an "EDOL grammar"). The same results hold for the question
of whether G generates an infinite language.");
N. D. Jones and S. Skyum, "Complexity of some problems concerning L systems", Proc. 4th
International Colloquium on Automata, Languages and Programming (ICALP 1977), Lecture Notes
in Computer Science 52, Springer (1977), 301-308, doi:10.1007/3-540-08342-1_23;
journal version: Mathematical Systems Theory 13 (1979), 29-43, doi:10.1007/BF01744286.
-/
module

public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity
public import Mathlib.Basic.Finite.Defs
public import CSLibExt.Complexity.NPComplete.EDOLGrammarNonEmptinessDefs

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.EDOLGrammarInfiniteness



open EDOLGrammarNonEmptiness (EDOLGrammarNonEmptinessInstance LSymbol Step WellFormed)

/-- The language generated by the grammar: the strings of terminals derivable from `S` in zero
or more steps. -/
def generatedLanguage : EDOLGrammarNonEmptinessInstance → Set (List LSymbol)
  | (_, _, ts, S) =>
    {v | (∀ y ∈ v, y.1 = true) ∧ Relation.ReflTransGen (Step ts) [(false, S)] v}

/-- The language generated by the grammar is infinite. -/
def EDOLGrammarInfinitenessFeasible (i : EDOLGrammarNonEmptinessInstance) : Prop :=
  (generatedLanguage i).Infinite

open Classical in
/-- EDOL GRAMMAR INFINITENESS as a decision problem over bitstrings. -/
noncomputable def edolGrammarInfinitenessDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := EDOLGrammarNonEmptinessInstance) x with
  | some i => decide (WellFormed i ∧ EDOLGrammarInfinitenessFeasible i)
  | none => false

end MetaMathlibExt.Complexity.NPComplete.EDOLGrammarInfiniteness
