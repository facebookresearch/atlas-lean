module

public import Mathlib
public import PhyslibExt.StatisticalMechanics.RandomCluster.BurtonKeane.MeasurableDependence

/-!
# Tests for `PhyslibExt.StatisticalMechanics.RandomCluster.BurtonKeane.MeasurableDependence`

* On `ConfigSpace ℕ`, the event "coordinate `0` is open" depends on `{0}`, so
  `bfc2_dependsOn_measurableSet_iSup` shows it is measurable for the σ-algebra of `{0}`
  (instance).
* `bfc2_indep_finite_cofinite`: under the Bernoulli product measure the events "coordinate `0` is
  open" and "coordinate `1` is open" are independent (instance).
-/

@[expose] public section

namespace PhyslibExtTest.StatisticalMechanics.RandomCluster.BurtonKeane.MeasurableDependence

open _root_.StatMech _root_.StatMech.Walls MeasureTheory

/-- The event "coordinate `i` is open". -/
def openAt (i : ℕ) : Set (ConfigSpace ℕ) := {ω | ω i = true}

/-- "Coordinate `i` is open" is measurable. -/
theorem openAt_measurable (i : ℕ) : MeasurableSet (openAt i) :=
  show MeasurableSet ((fun ω : ConfigSpace ℕ => ω i) ⁻¹' {true}) from
    measurable_pi_apply i (measurableSet_singleton true)

/-- "Coordinate `i` is open" depends only on any set containing `i`. -/
theorem openAt_dependsOn {i : ℕ} {S : Set ℕ} (hi : i ∈ S) : StatMech.DependsOn (openAt i) S :=
  fun ω ω' h => by simp only [openAt, Set.mem_ofPred_eq, h i hi]

-- The event is measurable for the σ-algebra generated by coordinate `0`.
example : MeasurableSet[⨆ e ∈ ({0} : Set ℕ),
    MeasurableSpace.comap (fun ω : ConfigSpace ℕ => ω e) inferInstance] (openAt 0) :=
  bfc2_dependsOn_measurableSet_iSup (openAt_measurable 0) (openAt_dependsOn rfl)

-- Coordinates `0` and `1` are independent under the Bernoulli product measure.
example : bernoulliProductMeasure (E := ℕ) (1 / 2) (by norm_num) (openAt 0 ∩ openAt 1) =
    bernoulliProductMeasure (E := ℕ) (1 / 2) (by norm_num) (openAt 0) *
      bernoulliProductMeasure (E := ℕ) (1 / 2) (by norm_num) (openAt 1) :=
  bfc2_indep_finite_cofinite _ _ {0} (openAt_measurable 0) (openAt_measurable 1)
    (openAt_dependsOn (by simp)) (openAt_dependsOn (by simp))

end PhyslibExtTest.StatisticalMechanics.RandomCluster.BurtonKeane.MeasurableDependence
