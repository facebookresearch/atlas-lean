%% 13. MATHEMATICS SUBJECT CLASSIFICATION (v2.1)
%% ===============================================================
%% \subjclass[2020]{17D92, 17A60} sets a footnote on the title page reading
%%   2020 Mathematics Subject Classification. 17D92, 17A60.
%% It carries NO mark: the note is emitted through \@footnotetext with \@thefnmark
%% made empty, which is how amsart sets its own administrative notes.  It is placed
%% before the marked author notes, so it sits at the top of the block.
\newif\iffa@showsubjclass \fa@showsubjclasstrue
\define@key{flexart}{showsubjclass}[true]{\csname fa@showsubjclass#1\endcsname}
\newcommand{\fa@subjclass}{}
\newcommand{\fa@subjclassyear}{2020}
\newcommand{\fa@subjclassname}{\textit{Mathematics Subject Classification}}
\newcommand{\fa@subjclassfont}{\normalfont\footnotesize}
\newcommand{\fa@subjclasssep}{.\space}
\fa@defcmd{subjclassname}{\fa@subjclassname}
\fa@defcmd{subjclassfont}{\fa@subjclassfont}
\fa@defcmd{subjclasssep}{\fa@subjclasssep}
\fa@defcmd{subjclassyear}{\fa@subjclassyear}
\newcommand{\subjclass}[2][2020]{%
  \renewcommand{\fa@subjclassyear}{#1}\renewcommand{\fa@subjclass}{#2}}
\newcommand{\fa@flushsubjclass}{%
  \iffa@showsubjclass
    \ifdefempty{\fa@subjclass}{}{%
      \begingroup
        %% hyperref builds a link target named after the footnote mark.  This note is
        %% deliberately unmarked, so that name is empty and hyperref reports "Ignoring
        %% empty anchor" (twice: once for the mark, once for the text).  Its footnote
        %% hooks are switched off for this one note only, leaving footnote links
        %% working everywhere else; the assignment is local to this group.
        \@ifundefined{Hy@hyperfootnotesfalse}{}{\Hy@hyperfootnotesfalse}%
        \@ifundefined{Hy@raisedlink}{}{\let\Hy@raisedlink\@gobble}%
        \let\@makefnmark\relax
        \let\@thefnmark\@empty
        \@footnotetext{\fa@subjclassfont
          \fa@subjclassyear\space\fa@subjclassname\fa@subjclasssep
          \fa@subjclass\fa@subjclassdot}%
      \endgroup}%
  \fi}
%% Final punctuation, appended after the code list.  Set subjclassdot={} if your
%% list already ends in a full stop.
\newcommand{\fa@subjclassdot}{.}
\fa@defcmd{subjclassdot}{\fa@subjclassdot}


