\newlength{\fa@rulewidth}        \setlength{\fa@rulewidth}{0.5pt}
\newlength{\fa@rulelength}       \setlength{\fa@rulelength}{\fa@f@rulelength\textwidth}

%% --- leading (absolute).  0pt = leave the font default alone. ---
\newlength{\fa@titleleading}    \setlength{\fa@titleleading}{1.4em}
\newlength{\fa@subtitleleading} \setlength{\fa@subtitleleading}{12pt}
\newlength{\fa@authorleading}   \setlength{\fa@authorleading}{15pt}
\newlength{\fa@abstractleading} \setlength{\fa@abstractleading}{1.1em}

