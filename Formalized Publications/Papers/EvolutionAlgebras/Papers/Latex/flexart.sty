%% hyperref needs an anchor to link to.  \part is assembled here rather than by
%% \@startsection, so nothing creates one: without this the contents line for a part
%% points nowhere.  \phantomsection is hyperref's own hook and is a no-op without it.
\providecommand{\phantomsection}{}
\newcommand{\fa@part@out}[3]{% #1 numbered-eligible  #2 toc text  #3 title
  \iffa@partpagebreak\clearpage\fi
  \par
  \phantomsection
  \addvspace{\csuse{fa@part@above}}%
  \begingroup
    \fa@mpclear
    \setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
    \csuse{fa@part@align}\csuse{fa@part@font}%
    \ifnum#1=1 \iffa@partnumbered
      \refstepcounter{part}%
      %% the label is uppercased with the title, not left as typed
      \ifnum\csuse{fa@part@upper}=1
        {\csuse{fa@part@numberfont}\MakeUppercase{\fa@partname\fa@partnamesep\thepart}}%
      \else
        {\csuse{fa@part@numberfont}\fa@partname\fa@partnamesep\thepart}%
      \fi
      \csuse{fa@part@numbersep}%
    \fi\fi
    \ifnum\csuse{fa@part@upper}=1 \MakeUppercase{#3}\else #3\fi
    \par
    \ifdefempty{\fa@partsubtitle}{}{\iffa@partsubtitlebeforerule\fa@part@subtitleout\fi}%
    \iffa@partrule
      \nointerlineskip\vskip\fa@partrulesep
      {\csuse{fa@part@align}%
       \rule{\fa@partrulelength}{\fa@partrulewidth}\par}%
    \fi
    \ifdefempty{\fa@partsubtitle}{}{\iffa@partsubtitlebeforerule\else\fa@part@subtitleout\fi}%
  \endgroup
  \nobreak
  \vskip\csuse{fa@part@below}%
  \@afterheading
  \iffa@parttoc
    \ifnum#1=1
      \addcontentsline{toc}{part}{%
        \iffa@partnumbered\protect\fa@parttoclabel{\thepart}\fi #2%
        \iffa@partsubtitletoc\fa@partsubtitletocout\fi}%
    \else
      \addcontentsline{toc}{part}{#2}%
    \fi
  \fi
  \iffa@partmark\markboth{}{}\fi
  %% a subtitle belongs to the part it was declared for
  \gdef\fa@partsubtitle{}}

%% --- table of contents -----------------------------------------
%% Title.
\newcommand{\fa@toctitle}{\contentsname}
\newcommand{\fa@toctitlefont}{\normalfont\large\scshape}
\newcommand{\fa@toctitlealign}{\centering}
\newlength{\fa@abovetoctitle} \setlength{\fa@abovetoctitle}{0pt}
\newlength{\fa@belowtoctitle} \setlength{\fa@belowtoctitle}{1em}
\fa@defcmd{toctitle}{\fa@toctitle}
\fa@defcmd{toctitlefont}{\fa@toctitlefont}
\fa@defcmd{toctitlealign}{\fa@toctitlealign}
\fa@deflen{abovetoctitle}{\fa@abovetoctitle}
\fa@deflen{belowtoctitle}{\fa@belowtoctitle}
\newif\iffa@toctitleuppercase \fa@toctitleuppercasefalse
\define@key{flexart}{toctitleuppercase}[true]{\csname fa@toctitleuppercase#1\endcsname}
\newcommand{\fa@pnumfont}{\normalfont}
\fa@defcmd{tocpagenumberfont}{\fa@pnumfont}

%% Part line in the contents.
\newlength{\fa@tocpartindent}   \setlength{\fa@tocpartindent}{6.1em}%  one tab to the RIGHT of section titles:
                                       %  1.5em (tocsectionindent) + 2.3em (numwidth)
                                       %  puts a label level with section titles; a
                                       %  further 2.3em steps it one tab further in
\newlength{\fa@tocpartabove}    \setlength{\fa@tocpartabove}{0.2em}
\newlength{\fa@tocpartrulewidth}\setlength{\fa@tocpartrulewidth}{0.4pt}
\newlength{\fa@tocpartrulelength} \setlength{\fa@tocpartrulelength}{\linewidth}
\fa@deflen{tocpartrulelength}{\fa@tocpartrulelength}
%% Where the rule begins.  The default lines it up with where a section TITLE starts
%% (tocsectionindent 1.5em + tocsectionnumwidth 2.3em), not with the section number and
%% not with the margin, so the rule reads as underlining the block of entries below it.
\newlength{\fa@tocpartruleindent} \setlength{\fa@tocpartruleindent}{3.8em}
\fa@deflen{tocpartruleindent}{\fa@tocpartruleindent}
\newlength{\fa@tocpartrulesep}  \setlength{\fa@tocpartrulesep}{0.4em}
\newlength{\fa@tocpartnumwidth}\setlength{\fa@tocpartnumwidth}{2.5em}
\newcommand{\fa@tocpartfont}{\normalfont\scshape}
\fa@deflen{tocpartindent}{\fa@tocpartindent}
\fa@deflen{tocpartabove}{\fa@tocpartabove}
\fa@deflen{tocpartrulewidth}{\fa@tocpartrulewidth}
\fa@deflen{tocpartrulesep}{\fa@tocpartrulesep}
\fa@deflen{tocpartnumwidth}{\fa@tocpartnumwidth}
\fa@defcmd{tocpartfont}{\fa@tocpartfont}
\newif\iffa@tocpartrule       \fa@tocpartruletrue
\newif\iffa@tocpartpagenumber \fa@tocpartpagenumberfalse
\define@key{flexart}{tocpartrule}[true]{\csname fa@tocpartrule#1\endcsname}
\define@key{flexart}{tocpartpagenumber}[true]{\csname fa@tocpartpagenumber#1\endcsname}

%% Entry lines: four keys for each of section, subsection, subsubsection.
\newcommand{\fa@newtoclevel}[4]{% #1 level  #2 default indent  #3 numwidth  #4 font
  \expandafter\newlength\csname fa@toc#1@indent\endcsname
  \expandafter\newlength\csname fa@toc#1@numwidth\endcsname
  \expandafter\setlength\csname fa@toc#1@indent\endcsname{#2}%
  \expandafter\setlength\csname fa@toc#1@numwidth\endcsname{#3}%
  \csdef{fa@toc#1@font}{#4}%
  \csdef{fa@toc#1@dots}{1}%
  \define@key{flexart}{toc#1indent}{\expandafter\setlength\csname fa@toc#1@indent\endcsname{##1}%
    \csgdef{fa@userset@toc#1indent}{1}}%
  \define@key{flexart}{toc#1numwidth}{\expandafter\setlength\csname fa@toc#1@numwidth\endcsname{##1}%
    \csgdef{fa@userset@toc#1numwidth}{1}}%
  \define@key{flexart}{toc#1font}{\csdef{fa@toc#1@font}{##1}\csgdef{fa@userset@toc#1font}{1}}%
  \define@key{flexart}{toc#1leaders}[true]{%
    \ifstrequal{##1}{true}{\csdef{fa@toc#1@dots}{1}}{\csdef{fa@toc#1@dots}{0}}%
    \csgdef{fa@userset@toc#1leaders}{1}}%
  %% space around a line of this type, and an optional rule under it.  Defaults are
  %% TIGHT: no extra lead at all, so entries sit on consecutive baselines.
  \expandafter\newlength\csname fa@toc#1@above\endcsname
  \expandafter\newlength\csname fa@toc#1@itemsep\endcsname
  \expandafter\newlength\csname fa@toc#1@rulewidth\endcsname
  \expandafter\newlength\csname fa@toc#1@rulelength\endcsname
  \expandafter\newlength\csname fa@toc#1@rulesep\endcsname
  \expandafter\setlength\csname fa@toc#1@above\endcsname{0pt}%
  \expandafter\setlength\csname fa@toc#1@itemsep\endcsname{0pt}%
  \expandafter\setlength\csname fa@toc#1@rulewidth\endcsname{0.4pt}%
  \expandafter\setlength\csname fa@toc#1@rulelength\endcsname{\linewidth}%
  \expandafter\setlength\csname fa@toc#1@rulesep\endcsname{0.45ex}%
  \csdef{fa@toc#1@rule}{0}%
  \define@key{flexart}{toc#1above}{\expandafter\setlength\csname fa@toc#1@above\endcsname{##1}%
    \csgdef{fa@userset@toc#1above}{1}}%
  \define@key{flexart}{toc#1itemsep}{\expandafter\setlength\csname fa@toc#1@itemsep\endcsname{##1}%
    \csgdef{fa@userset@toc#1itemsep}{1}}%
  \define@key{flexart}{toc#1rulewidth}{\expandafter\setlength\csname fa@toc#1@rulewidth\endcsname{##1}%
    \csgdef{fa@userset@toc#1rulewidth}{1}}%
  \define@key{flexart}{toc#1rulelength}{\expandafter\setlength\csname fa@toc#1@rulelength\endcsname{##1}%
    \csgdef{fa@userset@toc#1rulelength}{1}}%
  \define@key{flexart}{toc#1rulesep}{\expandafter\setlength\csname fa@toc#1@rulesep\endcsname{##1}%
    \csgdef{fa@userset@toc#1rulesep}{1}}%
  \define@key{flexart}{toc#1rule}[true]{%
    \ifstrequal{##1}{true}{\csdef{fa@toc#1@rule}{1}}{\csdef{fa@toc#1@rule}{0}}%
    \csgdef{fa@userset@toc#1rule}{1}}}
\fa@newtoclevel{section}{1.5em}{2.3em}{\normalfont}
\fa@newtoclevel{subsection}{3.8em}{3.2em}{\normalfont}
\fa@newtoclevel{subsubsection}{7.0em}{4.1em}{\normalfont}
%% appendix entries default to the section entry style
\fa@newtoclevel{appendix}{1.5em}{2.3em}{\normalfont}
%% one key that opens up or tightens every type at once
\newlength{\fa@tocitemsep} \setlength{\fa@tocitemsep}{0pt}
\fa@deflen{tocitemsep}{\fa@tocitemsep}
%% \parskip would otherwise pad every contents line; the contents is set tight and
%% the per-type keys are the only source of extra space.
\newif\iffa@toctight \fa@toctighttrue
\define@key{flexart}{toctight}[true]{\csname fa@toctight#1\endcsname}

%% One contents line, honouring font, indent, number width and leaders.
\newcommand{\fa@tocentry}[8]{% type lvl indent numwidth font dots text page
  \ifnum #2>\c@tocdepth \else
    \vskip \z@ \@plus.2\p@
    \addvspace{\dimexpr\csuse{fa@toc#1@above}+\fa@tocitemsep\relax}%
    {\leftskip #3\relax \rightskip \@tocrmarg \parfillskip -\rightskip
     \parindent #3\relax\@afterindenttrue
     \interlinepenalty\@M \leavevmode
     \@tempdima #4\relax
     \advance\leftskip \@tempdima \null\nobreak\hskip -\leftskip
     #5{#7}\nobreak
     \ifnum #6=1
       \leaders\hbox{$\m@th\mkern \@dotsep mu\hbox{.}\mkern \@dotsep mu$}\hfill
     \else \hfil \fi
     \nobreak\hb@xt@\@pnumwidth{\hfil\fa@pnumfont\normalcolor #8}\par}%
    \ifnum\csuse{fa@toc#1@rule}=1
      \vskip\csuse{fa@toc#1@rulesep}%
      {\parindent\z@\leftskip\z@\rightskip\z@\parfillskip\z@\@plus1fil
       \noindent\hspace*{\csuse{fa@toc#1@indent}}%
       \rule{\dimexpr\csuse{fa@toc#1@rulelength}-\csuse{fa@toc#1@indent}\relax}%
             {\csuse{fa@toc#1@rulewidth}}\par}%
    \fi
    \vskip\csuse{fa@toc#1@itemsep}%
  \fi}

%% The part line, and the contents title.
\newcommand{\fa@lpart}[2]{%
  \ifnum \c@tocdepth >-2\relax
    \addpenalty{-\@highpenalty}%
    \addvspace{\dimexpr\fa@tocpartabove+\fa@tocitemsep\relax}%
    \begingroup
      \setlength{\parindent}{0pt}%
      \iffa@tocpartpagenumber
        \setlength{\rightskip}{\@pnumwidth}\setlength{\parfillskip}{-\@pnumwidth}%
      \else
        \setlength{\rightskip}{0pt}\setlength{\parfillskip}{0pt plus 1fil}%
      \fi
      %% \numberline lays its box out in \@tempdima; unset, a numbered part line
      %% overfills by a couple of hundred points
      \setlength{\@tempdima}{\fa@tocpartnumwidth}%
      \leavevmode
      %% no \hskip -\leftskip here: that idiom exists to hang a \numberline box to the
      %% left of the text, and it would cancel the indent we just set
      \advance\leftskip\fa@tocpartindent
      {\fa@tocpartfont #1}\nobreak\hfil
      \iffa@tocpartpagenumber
        \nobreak\hb@xt@\@pnumwidth{\hss\fa@pnumfont #2}%
      \fi
      \par
      \iffa@tocpartrule
        \nointerlineskip\vskip\fa@tocpartrulesep
        %% the entry line advanced \leftskip; the rule must start from zero or the
        %% indent is counted twice and the line overfills by exactly that indent
        \setlength{\leftskip}{0pt}\setlength{\rightskip}{0pt}%
        \setlength{\parfillskip}{0pt plus 1fil}%
        %% the rule starts where section titles start and runs to the right margin
        \noindent\hspace*{\fa@tocpartruleindent}%
        \rule{\dimexpr\fa@tocpartrulelength-\fa@tocpartruleindent\relax}%
              {\fa@tocpartrulewidth}\par
      \fi
      \penalty\@highpenalty
    \endgroup
  \fi}

\newcommand{\flextoc}{%
  \renewcommand{\l@part}{\fa@lpart}%
  \renewcommand{\l@section}{\fa@tocentry{section}{1}{\fa@tocsection@indent}%
    {\fa@tocsection@numwidth}{\csuse{fa@tocsection@font}}{\csuse{fa@tocsection@dots}}}%
  \renewcommand{\l@subsection}{\fa@tocentry{subsection}{2}{\fa@tocsubsection@indent}%
    {\fa@tocsubsection@numwidth}{\csuse{fa@tocsubsection@font}}{\csuse{fa@tocsubsection@dots}}}%
  \renewcommand{\l@subsubsection}{\fa@tocentry{subsubsection}{3}{\fa@tocsubsubsection@indent}%
    {\fa@tocsubsubsection@numwidth}{\csuse{fa@tocsubsubsection@font}}{\csuse{fa@tocsubsubsection@dots}}}%
  \csdef{l@appendixgroup}{\fa@lappendixgroup}%
  \csdef{l@appendix}{\fa@tocentry{appendix}{1}{\fa@tocappendix@indent}%
    {\fa@tocappendix@numwidth}{\csuse{fa@tocappendix@font}}{\csuse{fa@tocappendix@dots}}}%
  %% contents title, from the same keys as everything else
  \renewcommand{\tableofcontents}{%
    \par
    \begingroup
    %% \parskip is zeroed for the CONTENTS ONLY.  Ungrouped, this assignment leaked
    %% into the rest of the document: every paragraph after the contents lost its
    %% separation, and the display-skip absorption silently became a no-op because
    %% it takes a fraction of a \parskip that was now zero.
    \iffa@toctight\parskip\z@\fi
    \addvspace{\fa@abovetoctitle}%
    {\fa@toctitlealign\fa@toctitlefont
     \iffa@toctitleuppercase\expandafter\MakeUppercase\expandafter{\fa@toctitle}%
     \else\fa@toctitle\fi\par}%
    \vskip\fa@belowtoctitle
    \@starttoc{toc}%
    \endgroup
    \fa@mpclear}}

%% --- hyperref: teach it about the levels flexart invents -----------------------
%% `appendix` and `appendixgroup` are flexart's own \@startsection level and contents
%% type, so hyperref knows neither their bookmark depth nor how to name their targets.
%% Without \toclevel@<type> it warns "bookmark level for unknown <type> defaults to 0"
%% (and then "Difference (2) between bookmark levels is greater than one"); without
%% \theH<counter> it warns "Counter 'appendix' or the representation '\theHappendix'
%% don't exist. No target created."  appendix sits at section depth; the appendix group
%% line sits where \part does in article.
\AtBeginDocument{%
  \providecommand{\toclevel@appendix}{1}%
  \providecommand{\toclevel@appendixgroup}{0}%
  \providecommand{\theHappendix}{appendix.\arabic{section}}%
  \providecommand{\theHappendixgroup}{appendixgroup.\arabic{section}}%
}
\AtBeginDocument{\flexpart\flextoc}


%% --- a display that OPENS a paragraph -------------------------------------------
%% A blank line before \[ or \begin{align} ends the paragraph, so TeX inserts
%% \parskip, starts a fresh paragraph, and sets the \parindent box as a line of its
%% own before the display.  Measured at 11pt with the house \parskip: that costs
%% about 19pt on top of the display's own skip (36.0pt of gap against 17.0pt when
%% the display sits inside the paragraph).  With displayabsorbparbreak the package
%% removes exactly that overhead: the \parskip glue (only when \lastskip really is
%% \parskip, so an \addvspace from a heading or a list is never eaten), the empty
%% line's interline glue, and the indent box.
\newif\iffa@dispparbreak \fa@dispparbreaktrue
\define@key{flexart}{displayabsorbparbreak}[true]{\csname fa@dispparbreak#1\endcsname}
%% What is left in place of the removed overhead.  A display that opens its own
%% paragraph is meant to read as a little more separated than one sitting inside a
%% paragraph, so the key does not flatten the two cases: it replaces the ~19pt of
%% paragraph-break overhead with this deliberate amount.
\newlength{\fa@dispparbreakextra} \setlength{\fa@dispparbreakextra}{3.9pt}
\fa@deflen{displayparbreakextra}{\fa@dispparbreakextra}
\newcommand{\fa@displaypre}{%
  \iffa@dispparbreak
    \ifvmode
      \ifdim\lastskip=\parskip \removelastskip \fi
      \vskip\fa@dispparbreakextra
      \nointerlineskip
      \noindent
    \fi
  \fi}
\AtBeginDocument{%
  \pretocmd{\[}{\fa@displaypre}{}{\PackageWarning{flexart}{could not patch \string\[}}%
  \@for\fa@e:=equation,equation*,align,align*,gather,gather*,multline,multline*,%
                flalign,flalign*,alignat,alignat*,displaymath\do{%
    \ifcsname\fa@e\endcsname
      \expandafter\pretocmd\csname\fa@e\endcsname{\fa@displaypre}{}{}%
    \fi}}
\endinput
