%% ---------------------------------------------------------------
%% flexart.sty -- fully customizable article front matter
%% ---------------------------------------------------------------
%% Every vertical space, measure, leading, font and label in the
%% front matter is exposed as a key.  Set keys as package options
%% or, preferably, with \flexset{key=value,...}.
%% ---------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{flexart}[2026/09/16 v2.3 Appendix levels, part subtitles, parskip-relative display maths, contents control]

\RequirePackage{xkeyval}
\RequirePackage{etoolbox}
%% enumitem is a hard dependency as of this release: the enum*/itemize* keys are
%% driven through \setlist, so the package is loaded here rather than left to the
%% document.  Loaded WITHOUT options, so a later \usepackage[<opts>]{enumitem}
%% raises an option clash -- pass enumitem options before flexart, or not at all.
\RequirePackage{enumitem}

%% Alignment macros.  ragged2e is NOT required (older versions of it pull in
%% everysel.sty, which is absent from some distributions).  If you load
%% ragged2e yourself before flexart, its richer versions win, because these
%% are only \providecommand'd.
\providecommand{\justifying}{%
  \leftskip\z@ \rightskip\z@ \parfillskip\z@ \@plus1fil\relax}
\providecommand{\RaggedRight}{%
  \leftskip\z@ \rightskip\z@ \@plus2em \parfillskip\z@ \@plus1fil\relax}
\providecommand{\RaggedLeft}{%
  \leftskip\z@ \@plus2em \rightskip\z@ \parfillskip\z@\relax}
\providecommand{\Centering}{%
  \leftskip\z@ \@plus1fil \rightskip\leftskip \parfillskip\z@\relax}

