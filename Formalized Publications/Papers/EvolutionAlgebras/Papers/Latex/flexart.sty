%% ===============================================================
%% 4. FRONT-MATTER DATA
%% ===============================================================
%% \title[Short Title]{Long Title} -- the optional short form is stored in
%% \theshorttitle for use in running heads (article's \title takes no option).
\newcommand{\fa@shorttitle}{}
\renewcommand{\title}[2][]{%
  \gdef\@title{#2}%
  \ifblank{#1}{\gdef\fa@shorttitle{#2}}{\gdef\fa@shorttitle{#1}}}
\newcommand{\theshorttitle}{\fa@shorttitle}

\newcommand{\fa@subtitle}{}
\providecommand{\subtitle}{}
\renewcommand{\subtitle}[1]{\renewcommand{\fa@subtitle}{#1}}

\newcommand{\fa@primaryauthors}{}
\newcommand{\primaryauthors}[1]{\renewcommand{\fa@primaryauthors}{#1}}
\newcommand{\fa@secondaryauthors}{}
\newcommand{\secondaryauthors}[1]{\renewcommand{\fa@secondaryauthors}{#1}}

\newcommand{\fa@affiliation}{}
\providecommand{\affiliation}{}
\renewcommand{\affiliation}[1]{\renewcommand{\fa@affiliation}{#1}}

\newcommand{\fa@keywords}{}
\providecommand{\keywords}{}
\renewcommand{\keywords}[1]{\renewcommand{\fa@keywords}{#1}}

\newcommand{\fa@abstracttext}{}
\newcommand{\flexabstract}[1]{\renewcommand{\fa@abstracttext}{#1}}

%% --- title-block footnotes (\thanks does not work inside a minipage) ---
%% ---------------------------------------------------------------
%% Author notes.  A note is declared ONCE and can be marked any number
%% of times, so several authors can share one symbol and one footnote:
%%   \newfanote{<label>}{<text>}   declare only, no mark
%%   \fanote[<label>]{<text>}      declare and mark
%%   \fanote{<label>}              mark an already-declared note
%%   \fathanks{<text>}             anonymous declare-and-mark (older API)
%% All four share one counter, so marks never collide.  Notes belong to
%% the title block they were declared for: \maketitle prints each once,
%% then clears them, so a second \maketitle starts from the first symbol.
%% ---------------------------------------------------------------
\newcounter{fa@note}
\newcounter{fa@notei}
\newcommand{\fa@notelabels}{}
\newif\iffa@thanksfn \fa@thanksfntrue
\define@key{flexart}{thanksasfootnotes}[true]{\csname fa@thanksfn#1\endcsname}
\define@key{flexart}{notesasfootnotes}[true]{\csname fa@thanksfn#1\endcsname}

%% mark style: symbols (default) | arabic | alph | roman
\newcommand{\fa@notemark}[1]{\@fnsymbol{#1}}
\define@key{flexart}{notemarks}[symbols]{%
  \ifstrequal{#1}{symbols}{\renewcommand{\fa@notemark}[1]{\@fnsymbol{##1}}}{}%
  \ifstrequal{#1}{arabic} {\renewcommand{\fa@notemark}[1]{\number##1}}{}%
  \ifstrequal{#1}{alph}   {\renewcommand{\fa@notemark}[1]{\@alph{##1}}}{}%
  \ifstrequal{#1}{roman}  {\renewcommand{\fa@notemark}[1]{\@roman{##1}}}{}%
}

\newcommand{\fa@declarenote}[2]{%
  \stepcounter{fa@note}%
  \csgdef{fa@notetext@\the\value{fa@note}}{#2}%
  \ifblank{#1}{}{%
    %% \csxdef, not \csgdef: the index must be frozen at DECLARATION time.
    %% With \csgdef the body stays unexpanded and \the\value{fa@note} is read
    %% when the note is MARKED, giving every label the counter's later value.
    \csxdef{fa@noteidx@#1}{\the\value{fa@note}}%
    \listgadd{\fa@notelabels}{#1}}%
}
\newcommand{\fa@marknote}[1]{%
  \iffa@thanksfn
    \begingroup\renewcommand{\thefootnote}{\fa@notemark{\value{footnote}}}%
      \footnotemark[#1]%
    \endgroup
  \else
    \textsuperscript{\fa@notemark{#1}}%
  \fi}

\newcommand{\fathanks}[1]{\fa@declarenote{}{#1}\fa@marknote{\value{fa@note}}}
\newcommand{\newfanote}[2]{\fa@declarenote{#1}{#2}}
\newcommand{\fanote}{\@ifnextchar[\fa@notedecl\fa@noteref}
\def\fa@notedecl[#1]#2{\fa@declarenote{#1}{#2}\fa@marknote{\value{fa@note}}}
\newcommand{\fa@noteref}[1]{%
  \ifcsdef{fa@noteidx@#1}%
    {\fa@marknote{\csuse{fa@noteidx@#1}}}%
    {\PackageError{flexart}{Author note `#1' is not declared}%
      {Declare it with \protect\newfanote{#1}{text} or \protect\fanote[#1]{text}
       before marking other authors with \protect\fanote{#1}.}}}

\newcommand{\fa@clearnotes}{%
  \setcounter{fa@notei}{0}%
  \loop\ifnum\value{fa@notei}<\value{fa@note}
    \stepcounter{fa@notei}%
    \csundef{fa@notetext@\the\value{fa@notei}}%
  \repeat
  \def\do##1{\csundef{fa@noteidx@##1}}%
  \dolistloop{\fa@notelabels}%
  \gdef\fa@notelabels{}%
  \setcounter{fa@note}{0}}

\newcommand{\fa@flushthanks}{%
  \ifnum\value{fa@note}>0
    \iffa@thanksfn
      \begingroup\renewcommand{\thefootnote}{\fa@notemark{\value{footnote}}}%
        \setcounter{fa@notei}{0}%
        \loop\ifnum\value{fa@notei}<\value{fa@note}
          \stepcounter{fa@notei}%
          \footnotetext[\value{fa@notei}]{\csuse{fa@notetext@\the\value{fa@notei}}}%
        \repeat
      \endgroup
    \else
      \vspace{\fa@abovethanks}%
      {\fa@thanksfont\setlength{\parindent}{0pt}%
       \setcounter{fa@notei}{0}%
       \loop\ifnum\value{fa@notei}<\value{fa@note}
         \stepcounter{fa@notei}%
         \textsuperscript{\fa@notemark{\value{fa@notei}}}\,%
         \csuse{fa@notetext@\the\value{fa@notei}}\par
       \repeat}%
      \vspace{\fa@belowthanks}%
    \fi
    \fa@clearnotes
  \fi}

%% ===============================================================
%% 5. AUTHOR-LIST BUILDER  (names separated by \and)
%% ===============================================================
\newcounter{fa@nauthors}
\newcounter{fa@authidx}
\newcommand{\fa@authlist}{}
\def\fa@endmarkmacro{\fa@endmark}

\def\fa@scan#1\and{%
  \def\fa@tmp{#1}%
  \ifx\fa@tmp\fa@endmarkmacro
    \let\fa@scannext\relax
  \else
    \listeadd{\fa@authlist}{\expandonce\fa@tmp}%
    \let\fa@scannext\fa@scan
  \fi
  \fa@scannext}

\newcommand{\fa@parseauthors}[1]{%
  \renewcommand{\fa@authlist}{}%
  \fa@scan#1\and\fa@endmark\and}

\newcommand{\fa@countone}[1]{\stepcounter{fa@nauthors}}
%% NOTE: every line below MUST end in % -- a bare line end inside this macro
%% emits a space token and shows up as a gap around the separator.
\newcommand{\fa@sepnormal}{\fa@authorsepmark\hspace{\fa@authorsep}}%
\newcommand{\fa@seplast}{%
  \ifdefempty{\fa@lastauthorsep}%
    {\fa@sepnormal}%
    {\ifnum\value{fa@nauthors}>2\relax\fa@authorsepmark\fi\fa@lastauthorsep}%
}%
\newcommand{\fa@typeone}[1]{%
  \stepcounter{fa@authidx}%
  \ifnum\value{fa@authidx}>1\relax
    \unskip
    \ifnum\value{fa@authidx}=\value{fa@nauthors}\relax
      \expandafter\fa@seplast
    \else
      \expandafter\fa@sepnormal
    \fi
  \fi
  \ignorespaces#1\unskip}

\newcommand{\authorlist}[1]{%
  \begingroup
  \setcounter{fa@nauthors}{0}\setcounter{fa@authidx}{0}%
  \fa@parseauthors{#1}%
  \forlistloop{\fa@countone}{\fa@authlist}%
  \forlistloop{\fa@typeone}{\fa@authlist}%
  \endgroup}

%% \authorlist takes literal tokens; \fa@dolist takes a MACRO holding them and
%% expands it one level first, so the \and separators become visible to the
%% delimited scan above.  (Without this the stored macro is treated as a single
%% name and LaTeX's own tabular-based \and fires -> "Misplaced \crcr".)
\newcommand{\fa@dolist}[1]{\expandafter\authorlist\expandafter{#1}}

%% --- optional decorative rule ---
\newcommand{\flexrule}{%
  \iffa@rule
    \vspace{\fa@aboverule}%
    {\fa@rulealign\rule{\fa@rulelength}{\fa@rulewidth}\par}%
    \vspace{\fa@belowrule}%
  \fi}

%% ===============================================================
%% 6. \maketitle
%% ===============================================================
%% #1 alignment  #2 width  #3 font+leading  #4 body
\newcommand{\fa@block}[4]{%
  {#1\begin{minipage}{#2}#1#3#4\par\end{minipage}\par}}

\renewcommand{\maketitle}{%
  \par                      % close any open paragraph (safe for a 2nd \maketitle)
  \iffa@header\iffa@firstheader\else\thispagestyle{plain}\fi\fi % title page: folio only
  \begingroup
  \fa@mpinheritfalse        % the front-matter minipages keep their own tight shape
  \setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
  %% ---- title ----
  \vspace*{\fa@abovetitle}%
  \fa@block{\fa@titlealign}{\fa@titlewidth}
    {\fa@titlefont\ifdim\fa@titleleading>0pt\setlength{\baselineskip}{\fa@titleleading}\fi}
    {\iffa@titlecase\expandafter\MakeUppercase\expandafter{\@title}\else\@title\fi}%
  \vspace{\fa@belowtitle}%
  %% ---- subtitle ----
  \ifdefempty{\fa@subtitle}{}{%
    \vspace{\fa@abovesubtitle}%
    \fa@block{\fa@subtitlealign}{\fa@titlewidth}
      {\fa@subtitlefont\ifdim\fa@subtitleleading>0pt\setlength{\baselineskip}{\fa@subtitleleading}\fi}
      {\fa@subtitle}%
    \vspace{\fa@belowsubtitle}}%
  %% ---- primary authors (first line) ----
  \ifdefempty{\fa@primaryauthors}{}{%
    \vspace{\fa@aboveprimary}%
    \fa@block{\fa@authoralign}{\fa@authorwidth}
      {\fa@primaryfont\ifdim\fa@authorleading>0pt\setlength{\baselineskip}{\fa@authorleading}\fi}
      {\fa@dolist\fa@primaryauthors}%
    \vspace{\fa@belowprimary}}%
  %% ---- secondary authors (line below) ----
  \ifdefempty{\fa@secondaryauthors}{}{%
    \iffa@showseclabel\ifdefempty{\fa@secondarylabel}{}{%
      \vspace{\fa@abovesecondarylabel}%
      \fa@block{\fa@authoralign}{\fa@authorwidth}{\fa@secondarylabelfont}{\fa@secondarylabel}%
      \vspace{\fa@belowsecondarylabel}}\fi
    \vspace{\fa@abovesecondary}%
    \fa@block{\fa@authoralign}{\fa@authorwidth}
      {\fa@secondaryfont\ifdim\fa@authorleading>0pt\setlength{\baselineskip}{\fa@authorleading}\fi}
      {\fa@dolist\fa@secondaryauthors}%
    \vspace{\fa@belowsecondary}}%
  %% ---- affiliation ----
  \ifdefempty{\fa@affiliation}{}{%
    \vspace{\fa@aboveaffil}%
    \fa@block{\fa@authoralign}{\fa@authorwidth}{\fa@affilfont}{\fa@affiliation}%
    \vspace{\fa@belowaffil}}%
  %% ---- date ----  (skipped by showdate=false as well as by \date{})
  \iffa@showdate\ifdefempty{\@date}{}{%
    \vspace{\fa@abovedate}%
    {\fa@authoralign\fa@datefont\@date\par}%
    \vspace{\fa@belowdate}}\fi
  \flexrule
  %% ---- abstract (+ keywords) ----
  \ifdefempty{\fa@abstracttext}{}{%
    \vspace{\fa@aboveabstract}%
    \noindent\hspace*{\fa@abstractindent}%
    \begin{minipage}{\fa@abstractwidth}%
      \setlength{\parindent}{\fa@abstractparindent}%
      \noindent{\fa@abstractnamefont\fa@abstractname}\fa@abstractnamesep\noindent
      {\fa@abstractfont
       \ifdim\fa@abstractleading>0pt\setlength{\baselineskip}{\fa@abstractleading}\fi
       \fa@abstractalign\fa@abstracttext\par}%
      \ifdefempty{\fa@keywords}{}{%
        \vspace{\fa@abovekeywords}%
        \noindent{\fa@keywordsnamefont\fa@keywordsname}\fa@keywordssep
        {\fa@keywordsfont\fa@keywords\par}%
        \vspace{\fa@belowkeywords}}%
    \end{minipage}\par
    \vspace{\fa@belowabstract}}%
  \fa@flushsubjclass   % unmarked MSC note first, then the marked author notes
  \fa@flushthanks
  \endgroup
  \vspace{\fa@belowmaketitle}%
  \iffa@indentfirst\else\@afterindentfalse\@afterheading\fi}

%% ===============================================================
%% 7. SECTIONING  (section / subsection / subsubsection / paragraph)
%% ===============================================================
%% Per level L, these keys exist:
%%   Labove Lbelow Lindent Lfont Lalign Lnumberfont Lnumbersep
%%   Lrunin[=true] Lindentafter[=true] Luppercase[=true]
%% Plus the global keys numberdepth / tocdepth.
%% Labove and Lbelow are always given as POSITIVE amounts; the sign
%% conventions of \@startsection are derived from Lrunin/Lindentafter,
%% so rubber components keep the right sign (a hand-written negative
%% beforeskip silently flips its own plus/minus parts).
%%
%% #1 name  #2 default above  #3 default below  #4 default font
%% #5 runin default (0/1)  #6 indent-after default (0/1)
\newcommand{\fa@newlevel}[6]{%
  \expandafter\newlength\csname fa@#1@above\endcsname
  \expandafter\newlength\csname fa@#1@below\endcsname
  \expandafter\newlength\csname fa@#1@indent\endcsname
  \expandafter\newlength\csname fa@#1@eabove\endcsname
  \expandafter\newlength\csname fa@#1@ebelow\endcsname
  \expandafter\setlength\csname fa@#1@above\endcsname{#2}%
  \expandafter\setlength\csname fa@#1@below\endcsname{#3}%
  \csdef{fa@#1@font}{#4}%
  \csdef{fa@#1@align}{}%
  \csdef{fa@#1@numberfont}{}%
  \csdef{fa@#1@numbersep}{\quad}%
  \csdef{fa@#1@runin}{#5}%
  \csdef{fa@#1@indentafter}{#6}%
  \csdef{fa@#1@upper}{0}%
  \csdef{fa@#1@runinpunct}{}%
  \define@key{flexart}{#1runinpunct}{\csdef{fa@#1@runinpunct}{##1}}%
  \define@key{flexart}{#1above}{\expandafter\setlength\csname fa@#1@above\endcsname{##1}}%
  \define@key{flexart}{#1below}{\expandafter\setlength\csname fa@#1@below\endcsname{##1}}%
  \define@key{flexart}{#1indent}{\expandafter\setlength\csname fa@#1@indent\endcsname{##1}}%
  \define@key{flexart}{#1font}{\csdef{fa@#1@font}{##1}}%
  \define@key{flexart}{#1align}{\csdef{fa@#1@align}{##1}}%
  \define@key{flexart}{#1numberfont}{\csdef{fa@#1@numberfont}{##1}}%
  \define@key{flexart}{#1numbersep}{\csdef{fa@#1@numbersep}{##1}}%
  \define@key{flexart}{#1runin}[true]%
    {\ifstrequal{##1}{true}{\csdef{fa@#1@runin}{1}}{\csdef{fa@#1@runin}{0}}}%
  \define@key{flexart}{#1indentafter}[true]%
    {\ifstrequal{##1}{true}{\csdef{fa@#1@indentafter}{1}}{\csdef{fa@#1@indentafter}{0}}}%
  \define@key{flexart}{#1uppercase}[true]%
    {\ifstrequal{##1}{true}{\csdef{fa@#1@upper}{1}}{\csdef{fa@#1@upper}{0}}}%
}
%% Defaults: level 1 centred small caps with uppercased text, "1." + \enspace;
%% level 2 bold run-in with a terminating period; level 3 italic run-in; level 4
%% run-in.  (Standard article's own values are in the option reference.)
\fa@newlevel{section}{0.7\baselineskip \@plus \baselineskip}{0.5\baselineskip}%
  {\normalfont\large\scshape}{0}{1}
\fa@newlevel{subsection}{0.5\baselineskip \@plus 0.7\baselineskip}{0.5em}%
  {\normalfont\bfseries}{1}{1}
\fa@newlevel{subsubsection}{0.5\baselineskip \@plus 0.7\baselineskip}{0.5em}%
  {\normalfont\itshape}{1}{1}
\fa@newlevel{paragraph}{0pt}{0.33em}%
  {\normalfont\bfseries}{1}{1}
\csdef{fa@section@align}{\centering}
\csdef{fa@section@numberfont}{\mdseries}
\csdef{fa@section@upper}{0}
\csdef{fa@section@numbersep}{.\enspace}
\csdef{fa@subsection@numbersep}{.\enspace}
\csdef{fa@subsection@runinpunct}{.}
\csdef{fa@subsubsection@numbersep}{.\enspace}
\csdef{fa@subsubsection@runinpunct}{.}
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{3}

\define@key{flexart}{numberdepth}{\setcounter{secnumdepth}{#1}}
\define@key{flexart}{tocdepth}{\setcounter{tocdepth}{#1}}

%% derive the signed skips actually handed to \@startsection
%% EXPERIMENTAL (v1.8-exp2): a run-in heading must not change the paragraph rhythm.
%% \@startsection issues \addvspace<above> at the end of the previous paragraph, where
%% \lastskip is zero, so the full <above> is inserted AND the next paragraph then adds
%% its own \parskip: the two ADD.  Measured with the house defaults in an 11pt document,
%% a paragraph carrying a run-in heading sat 29.1pt below its predecessor against a
%% 22.4pt rhythm elsewhere.  For run-in levels the house \parskip is therefore taken out
%% of <above> (clamped at zero), which makes the total max(\parskip, <above>): the
%% rhythm is untouched for the default skips, and a deliberately large <above> still
%% shows.  Set runinabsorbparskip=false for the old additive behaviour.
\newif\iffa@runinabsorb \fa@runinabsorbtrue
\define@key{flexart}{runinabsorbparskip}[true]{\csname fa@runinabsorb#1\endcsname}
\newcommand{\fa@fixlevel}[1]{%
  \csname fa@#1@eabove\endcsname=\csname fa@#1@above\endcsname\relax
  \csname fa@#1@ebelow\endcsname=\csname fa@#1@below\endcsname\relax
  \ifnum\csuse{fa@#1@runin}=1\relax
    \iffa@runinabsorb
      \ifdim\csname fa@#1@eabove\endcsname>\fa@parskip
        \advance\csname fa@#1@eabove\endcsname-\fa@parskip
      \else
        \csname fa@#1@eabove\endcsname=\z@
      \fi
    \fi
  \fi
  \ifnum\csuse{fa@#1@indentafter}=0\relax
    \csname fa@#1@eabove\endcsname=-\csname fa@#1@eabove\endcsname\relax
  \fi
  \ifnum\csuse{fa@#1@runin}=1\relax
    \csname fa@#1@ebelow\endcsname=-\csname fa@#1@ebelow\endcsname\relax
  \fi}

%% Heading-text transformer: applies <lvl>uppercase and <lvl>runinpunct.
%% Survives all four call shapes: \sec{t} \sec[s]{t} \sec*{t} \sec*[s]{t}.
%% \texorpdfstring keeps PDF bookmarks clean (provided for the no-hyperref case).
\providecommand{\texorpdfstring}[2]{#1}
\DeclareRobustCommand{\fa@headtext}[2]{%
  \texorpdfstring
    {\ifnum\csuse{fa@#1@upper}=1\relax\MakeUppercase{#2}\else#2\fi
     \csuse{fa@#1@runinpunct}}%
    {#2}}
\newcommand{\fa@headwrap}[2]{%
  \@ifstar{\fa@headwrapS{\csname #1\endcsname}{#2}}%
          {\fa@headwrapA{\csname #1\endcsname}{#2}}}
%% Starred form: \@ssect takes NO optional argument, so pass the title only.
\newcommand{\fa@headwrapS}[3]{#1*{\fa@headtext{#2}{#3}}}
\newcommand{\fa@headwrapA}[2]{%
  \@ifnextchar[{\fa@headwrapB{#1}{#2}}{\fa@headwrapC{#1}{#2}}}
%% Explicit [short]: the user's short form goes to the ToC untouched.
\def\fa@headwrapB#1#2[#3]#4{#1[#3]{\fa@headtext{#2}{#4}}}
%% No [short]: hand the ORIGINAL title to \@sect as the ToC / running-head entry
%% and the transformed one as the typeset heading, so <lvl>uppercase and
%% <lvl>runinpunct never leak into the ToC or the marks.
\newcommand{\fa@headwrapC}[3]{#1[#3]{\fa@headtext{#2}{#3}}}

%% EXPERIMENTAL (v1.8-exp3): clear a stale \if@minipage.
%% \@setminipage marks the top of a minipage with \if@minipage true and installs
%% \everypar{\@minipagefalse\everypar{}} to clear it at the first paragraph.  A heading
%% overwrites \everypar -- \@xsect does for a run-in heading, \@afterheading for a display
%% one -- so when a heading is the FIRST thing in a minipage the flag is never cleared.
%% \addvspace does nothing while it is true, so the spacing of whatever follows (a theorem,
%% a list) comes out wrong: measured 22.3pt above the first theorem against 16.9pt for the
%% identical structure in the body.
%% The flag is cleared from the heading's own style hook through \aftergroup, so it lands
%% just outside the group \@startsection wraps that hook in -- still inside the minipage,
%% and after \@startsection has already used the flag to suppress the space above the
%% heading itself, which is what it is there for.
\newcommand{\fa@mpclear}{\if@minipage\aftergroup\@minipagefalse\fi}

%% \@sect issues \csname <level>mark\endcsname{<title>} for every level.  LaTeX only
%% provides \sectionmark, \subsectionmark, \subsubsectionmark and \paragraphmark, so for a
%% level of our own the \csname yielded \relax and the title argument fell through into the
%% body, printing the heading text again as a paragraph.  Give every level a mark macro.
%% flexart's running head is driven by \theshorttitle rather than by marks, so a no-op is
%% the right default; a document may redefine it.
\newcommand{\fa@defmark}[1]{%
  \@ifundefined{#1mark}%
    {\expandafter\newcommand\csname #1mark\endcsname[1]{}}{}}
\newcommand{\fa@deflevel}[2]{%
  \fa@defmark{#1}%
  \fa@fixlevel{#1}%
  \csdef{fa@raw@#1}{\@startsection{#1}{#2}%
    {\csuse{fa@#1@indent}}%
    {\csuse{fa@#1@eabove}}%
    {\csuse{fa@#1@ebelow}}%
    {\fa@mpclear\csuse{fa@#1@align}\csuse{fa@#1@font}}}%
  %% only wrap when a transformation is actually requested
  \ifboolexpr{ test {\ifnumequal{\csuse{fa@#1@upper}}{1}}
               or not test {\ifcsempty{fa@#1@runinpunct}} }%
    {\csdef{#1}{\fa@headwrap{fa@raw@#1}{#1}}}%
    {\csletcs{#1}{fa@raw@#1}}}

%% --- appendices ----------------------------------------------------------
%% `appendix` is a real flexart level with its own eleven keys, so \appendix simply
%% points \section at it.  Its defaults COPY the section family, so appendices look
%% exactly like sections until a key says otherwise.  The counter is aliased to
%% section's, which keeps \ref working and lets article's own numbering reset apply.
\fa@newlevel{appendix}{0.7\baselineskip \@plus \baselineskip}{0.5\baselineskip}%
  {\normalfont\large\scshape}{0}{1}
\csdef{fa@appendix@align}{\centering}
\csdef{fa@appendix@numberfont}{\mdseries}
\csdef{fa@appendix@upper}{0}
\csdef{fa@appendix@numbersep}{.\enspace}
\let\c@appendix\c@section
\let\p@appendix\@empty
\def\theappendix{\@Alph\c@section}
\newcommand{\fa@appendixname}{Appendix}
\newcommand{\fa@appendixnamesep}{\space}
\fa@defcmd{appendixname}{\fa@appendixname}
\fa@defcmd{appendixnamesep}{\fa@appendixnamesep}
\newif\iffa@appendixprefix    \fa@appendixprefixtrue
\newif\iffa@appendixpagebreak \fa@appendixpagebreakfalse
\define@key{flexart}{appendixprefix}[true]{\csname fa@appendixprefix#1\endcsname}
\define@key{flexart}{appendixpagebreak}[true]{\csname fa@appendixpagebreak#1\endcsname}
%% emitted by \@seccntformat just before the number, so "Appendix A." falls out of
%% the ordinary number machinery instead of needing a bespoke heading macro
\csdef{fa@appendix@numberprefix}{\iffa@appendixprefix\fa@appendixname\fa@appendixnamesep\fi}
%% --- the "Appendices" line that opens the appendix block in the contents -------
\newcommand{\fa@appendixgroupname}{Appendices}
\fa@defcmd{appendixgroupname}{\fa@appendixgroupname}
\newif\iffa@appendixgrouptoc \fa@appendixgrouptoctrue
\define@key{flexart}{appendixgrouptoc}[true]{\csname fa@appendixgrouptoc#1\endcsname}
\newcommand{\fa@tocappendixgroupfont}{\normalfont\scshape}
\fa@defcmd{tocappendixgroupfont}{\fa@tocappendixgroupfont}
\newlength{\fa@tocappendixgroupindent} \setlength{\fa@tocappendixgroupindent}{6.1em}%  level with the part labels
\newlength{\fa@tocappendixgroupabove}  \setlength{\fa@tocappendixgroupabove}{0.2em}
\newlength{\fa@tocappendixgrouprulewidth}  \setlength{\fa@tocappendixgrouprulewidth}{0.4pt}
\newlength{\fa@tocappendixgrouprulelength} \setlength{\fa@tocappendixgrouprulelength}{\linewidth}
\newlength{\fa@tocappendixgrouprulesep}    \setlength{\fa@tocappendixgrouprulesep}{0.4em}
\newlength{\fa@tocappendixgroupruleindent} \setlength{\fa@tocappendixgroupruleindent}{3.8em}
\fa@deflen{tocappendixgroupruleindent}{\fa@tocappendixgroupruleindent}
\fa@deflen{tocappendixgroupindent}{\fa@tocappendixgroupindent}
\fa@deflen{tocappendixgroupabove}{\fa@tocappendixgroupabove}
\fa@deflen{tocappendixgrouprulewidth}{\fa@tocappendixgrouprulewidth}
\fa@deflen{tocappendixgrouprulelength}{\fa@tocappendixgrouprulelength}
\fa@deflen{tocappendixgrouprulesep}{\fa@tocappendixgrouprulesep}
\newif\iffa@tocappendixgrouprule \fa@tocappendixgroupruletrue
\newif\iffa@tocappendixgrouppagenumber \fa@tocappendixgrouppagenumberfalse
%% the page number may instead be set BEFORE the label
\newif\iffa@tocappendixgrouppnumfront \fa@tocappendixgrouppnumfrontfalse
\define@key{flexart}{tocappendixgrouppagenumberfront}[true]%
  {\csname fa@tocappendixgrouppnumfront#1\endcsname}
\newlength{\fa@tocappendixgrouppnumsep} \setlength{\fa@tocappendixgrouppnumsep}{0.5em}
\fa@deflen{tocappendixgrouppnumsep}{\fa@tocappendixgrouppnumsep}
\define@key{flexart}{tocappendixgrouprule}[true]{\csname fa@tocappendixgrouprule#1\endcsname}
\define@key{flexart}{tocappendixgrouppagenumber}[true]{\csname fa@tocappendixgrouppagenumber#1\endcsname}
%% styled like a part line, but its own keys
\newcommand{\fa@lappendixgroup}[2]{%
  \ifnum \c@tocdepth >-2\relax
    \addpenalty{-\@highpenalty}%
    \addvspace{\dimexpr\fa@tocappendixgroupabove+\fa@tocitemsep\relax}%
    \begingroup
      \setlength{\parindent}{0pt}%
      %% \parfillskip=-\@pnumwidth only balances when a page number box follows; with
      %% the number suppressed the line cannot fill and TeX reports an underfull box
      \ifboolexpr{ bool {fa@tocappendixgrouppagenumber}
                   and not bool {fa@tocappendixgrouppnumfront} }%
        {\setlength{\rightskip}{\@pnumwidth}\setlength{\parfillskip}{-\@pnumwidth}}%
        {\setlength{\rightskip}{0pt}\setlength{\parfillskip}{0pt plus 1fil}}%
      \iffalse
        \setlength{\rightskip}{\@pnumwidth}\setlength{\parfillskip}{-\@pnumwidth}%
      \else
        \setlength{\rightskip}{0pt}\setlength{\parfillskip}{0pt plus 1fil}%
      \fi
      \leavevmode
      \advance\leftskip\fa@tocappendixgroupindent
      \iffa@tocappendixgrouppnumfront
        {\fa@pnumfont #2}\hskip\fa@tocappendixgrouppnumsep
      \fi
      {\fa@tocappendixgroupfont #1}\nobreak\hfil
      %% a leading number REPLACES the one at the right margin rather than doubling it
      \iffa@tocappendixgrouppnumfront\else
        \iffa@tocappendixgrouppagenumber
          \nobreak\hb@xt@\@pnumwidth{\hss\fa@pnumfont #2}%
        \fi
      \fi
      \par
      \iffa@tocappendixgrouprule
        \nointerlineskip\vskip\fa@tocappendixgrouprulesep
        \setlength{\leftskip}{0pt}\setlength{\rightskip}{0pt}%
        \setlength{\parfillskip}{0pt plus 1fil}%
        %% starts where section titles start, like the part rule, and runs to the margin
        \noindent\hspace*{\fa@tocappendixgroupruleindent}%
        \rule{\dimexpr\fa@tocappendixgrouprulelength-\fa@tocappendixgroupruleindent\relax}%
              {\fa@tocappendixgrouprulewidth}\par
      \fi
    \endgroup
  \fi}

\newcommand{\flexappendix}{%
  \par
  \iffa@appendixpagebreak\clearpage\fi
  \iffa@appendixgrouptoc
    \phantomsection
    \addcontentsline{toc}{appendixgroup}{\fa@appendixgroupname}%
  \fi
  \setcounter{section}{0}\setcounter{subsection}{0}\setcounter{subsubsection}{0}%
  %% dependent counters read \thesection, so it must become the letter too or an
  %% appendix subsection numbers as "1.1" instead of "A.1"
  \gdef\thesection{\@Alph\c@section}%
  %% hyperref builds anchor names from \theH<counter>.  The appendix counter is shared
  %% with section, so an appendix subsection would claim the same identifier as a
  %% subsection in the body ("destination with the same identifier ... duplicate
  %% ignored", and the earlier link wins).  Prefix the appendix branch.
  \@ifundefined{theHsection}{}{\gdef\theHsection{app.\@Alph\c@section}}%
  \let\section\fa@appendixhead}

%% Applied automatically at \begin{document}.  Call it again by hand after a
%% mid-document \flexset that changes any of the *above/below/runin* keys.
\newcommand{\flexsections}{%
  \fa@deflevel{section}{1}%
  \fa@deflevel{subsection}{2}%
  \fa@deflevel{subsubsection}{3}%
  \fa@deflevel{paragraph}{4}%
  %% the appendix level would take over the name \appendix, which must stay the
  %% switch, so capture the heading command and put the switch back
  \fa@deflevel{appendix}{1}%
  \csletcs{fa@appendixhead}{appendix}%
  \let\appendix\flexappendix
  \def\@seccntformat##1{%
    \ifcsdef{fa@##1@numbersep}%
      {\csuse{fa@##1@numberprefix}\csuse{fa@##1@numberfont}%
       \csname the##1\endcsname\csuse{fa@##1@numbersep}}%
      {\csname the##1\endcsname\quad}}%
}
\AtBeginDocument{\flexsections}

%% ===============================================================
%% 8. PAGE LAYOUT, PARAGRAPH SHAPE, DISPLAY MATH
%% ===============================================================
%% --- margins ---------------------------------------------------
%% Nothing is applied unless at least one margin key is set, so loading flexart
%% never moves the text block on its own.  If geometry is loaded (before or after
%% flexart) the values are handed to \geometry; otherwise the same layout is
%% computed directly from \paperwidth/\paperheight.
\newlength{\fa@marginleft}   \setlength{\fa@marginleft}{1in}
\newlength{\fa@marginright}  \setlength{\fa@marginright}{1in}
\newlength{\fa@margintop}    \setlength{\fa@margintop}{1in}
\newlength{\fa@marginbottom} \setlength{\fa@marginbottom}{1in}
\newif\iffa@marginset \fa@marginsettrue

\newcommand{\fa@applymargins}{%
  \iffa@marginset
    \@ifpackageloaded{geometry}%
      {\geometry{left=\the\fa@marginleft,right=\the\fa@marginright,
                 top=\the\fa@margintop,bottom=\the\fa@marginbottom}}%
      {\setlength{\textwidth}{\dimexpr\paperwidth-\fa@marginleft-\fa@marginright\relax}%
       \setlength{\oddsidemargin}{\dimexpr\fa@marginleft-1in\relax}%
       \setlength{\evensidemargin}{\oddsidemargin}%
       \setlength{\textheight}{\dimexpr\paperheight-\fa@margintop-\fa@marginbottom\relax}%
       \setlength{\topmargin}{\dimexpr\fa@margintop-1in-\headheight-\headsep\relax}%
       \setlength{\linewidth}{\textwidth}}%
  \fi}
\define@key{flexart}{margin}{%
  \setlength{\fa@marginleft}{#1}\setlength{\fa@marginright}{#1}%
  \setlength{\fa@margintop}{#1}\setlength{\fa@marginbottom}{#1}%
  \fa@marginsettrue\fa@applymargins}
\define@key{flexart}{marginleft}{\setlength{\fa@marginleft}{#1}\fa@marginsettrue\fa@applymargins}
\define@key{flexart}{marginright}{\setlength{\fa@marginright}{#1}\fa@marginsettrue\fa@applymargins}
\define@key{flexart}{margintop}{\setlength{\fa@margintop}{#1}\fa@marginsettrue\fa@applymargins}
\define@key{flexart}{marginbottom}{\setlength{\fa@marginbottom}{#1}\fa@marginsettrue\fa@applymargins}
%% The 1in default is applied at load, but ONLY if geometry is not already in
%% charge: a user who loaded geometry before flexart keeps their own layout, and a
%% geometry loaded afterwards wins because it runs later.
\@ifpackageloaded{geometry}{}{\fa@applymargins}

%% --- paragraph shape -------------------------------------------
%% The house paragraph shape is kept in its own registers as well as applied live,
%% so it can be restored where LaTeX wipes it (see \@minipagerestore below).
\newlength{\fa@parindent}
\newlength{\fa@parskip}
\define@key{flexart}{parindent}{\setlength{\fa@parindent}{#1}\setlength{\parindent}{#1}}
\define@key{flexart}{parskip}{\setlength{\fa@parskip}{#1}\setlength{\parskip}{#1}}
%% house-style defaults, applied at load like a \flexset in the preamble would
\setlength{\fa@parindent}{1.5em}
\setlength{\fa@parskip}{0.8em \@plus 0.1em}
\setlength{\parindent}{\fa@parindent}
\setlength{\parskip}{\fa@parskip}

%% ---------------------------------------------------------------
%% EXPERIMENTAL (v1.8-exp1): paragraph shape inside a minipage.
%% A minipage runs \@parboxrestore, which sets \parindent and \parskip to ZERO.
%% Measured in an 11pt document with the house defaults: outside a minipage the
%% paragraph rhythm is 22.4pt with a 16.4pt indent, inside it is 13.7pt with no
%% indent -- so a run-in heading's own skip is the only vertical space in there and
%% a new subsection/subsubsection/paragraph appears to change the spacing.
%% The fix restores the house values through \@minipagerestore, the hook LaTeX
%% provides for exactly this and which only minipage uses -- footnotes, \parbox and
%% tabular cells are left alone.  Set minipageinherit=false to opt out.
%% flexart's own front-matter blocks switch it off, so \maketitle is unaffected.
\newif\iffa@mpinherit \fa@mpinherittrue
\define@key{flexart}{minipageinherit}[true]{\csname fa@mpinherit#1\endcsname}
\@ifundefined{@minipagerestore}{\let\@minipagerestore\relax}{}
\let\fa@orig@minipagerestore\@minipagerestore
\def\@minipagerestore{%
  \fa@orig@minipagerestore
  \iffa@mpinherit
    \setlength{\parindent}{\fa@parindent}%
    \setlength{\parskip}{\fa@parskip}%
  \fi}

%% --- display math skips ----------------------------------------
%% LaTeX resets these at every size change, so they are re-applied from
%% \normalsize rather than assigned once.
%%   abovedisplay       space above a display when the preceding line is long
%%                      (the ordinary case, including a display that starts a
%%                      paragraph): TeX's \abovedisplayskip
%%   abovedisplayshort  space above when the preceding line is SHORT, i.e. ends
%%                      before the display begins: \abovedisplayshortskip
%%   belowdisplay       space between the display and the continuation of its
%%                      paragraph: \belowdisplayskip
%%   belowdisplayshort  the same when the display's last line is short:
%%                      \belowdisplayshortskip
%%   betweenequations   space between the rows of one multi-line display
%%                      (align, gather, split, ...): \jot.  Two SEPARATE displays
%%                      in one paragraph are separated by belowdisplay +
%%                      abovedisplay instead.
\newlength{\fa@abovedisplay}      \setlength{\fa@abovedisplay}{8pt}
\newlength{\fa@belowdisplay}      \setlength{\fa@belowdisplay}{8pt}
\newlength{\fa@abovedisplayshort} \setlength{\fa@abovedisplayshort}{2pt}
\newlength{\fa@belowdisplayshort} \setlength{\fa@belowdisplayshort}{4pt}
\newlength{\fa@jot}               \setlength{\fa@jot}{6pt}
\fa@deflen{abovedisplay}{\fa@abovedisplay}
\fa@deflen{belowdisplay}{\fa@belowdisplay}
\fa@deflen{abovedisplayshort}{\fa@abovedisplayshort}
\fa@deflen{belowdisplayshort}{\fa@belowdisplayshort}
\fa@deflen{betweenequations}{\fa@jot}
%% --- display skips relative to \parskip, absorption, experimental centring ----
%% The DEFAULTS are multiples of \parskip so display spacing tracks the paragraph
%% rhythm; an explicit length still wins.  The multiples cannot be resolved at load
%% time (\parskip is itself set by a flexart key and may change later in the
%% preamble), so they are resolved at \begin{document} and again on demand.
\newcommand{\fa@f@abovedisplay}{1}
\newcommand{\fa@f@belowdisplay}{1}
\newcommand{\fa@f@abovedisplayshort}{0.75}
\newcommand{\fa@f@belowdisplayshort}{0.75}
\newcommand{\fa@f@jot}{0.75}
\newcommand{\fa@reldisplay}[2]{%
  \ifcsdef{fa@userset@#1}{}{\setlength{\csname fa@#2\endcsname}{\csuse{fa@f@#2}\parskip}}}
\newcommand{\fa@displaydefaults}{%
  \fa@reldisplay{abovedisplay}{abovedisplay}%
  \fa@reldisplay{belowdisplay}{belowdisplay}%
  \fa@reldisplay{abovedisplayshort}{abovedisplayshort}%
  \fa@reldisplay{belowdisplayshort}{belowdisplayshort}%
  \fa@reldisplay{betweenequations}{jot}}
%% Absorption: where a display meets a paragraph break, take a FRACTION of \parskip
%% off that skip.  Multiplying the glue scales natural, stretch and shrink together,
%% so a short \parskip is absorbed less and a long one more -- which is the point.
\newif\iffa@absabove \fa@absabovetrue
\newif\iffa@absbelow \fa@absbelowtrue
\newcommand{\fa@absabovefrac}{0.5}
\newcommand{\fa@absbelowfrac}{0.5}
\define@key{flexart}{absorbabovedisplay}[true]{\csname fa@absabove#1\endcsname}
\define@key{flexart}{absorbbelowdisplay}[true]{\csname fa@absbelow#1\endcsname}
\define@key{flexart}{absorbabovedisplayfrac}{\renewcommand{\fa@absabovefrac}{#1}}
\define@key{flexart}{absorbbelowdisplayfrac}{\renewcommand{\fa@absbelowfrac}{#1}}
%% Experimental centring: OFF by default, and when on it OVERRIDES the relative
%% defaults and the absorption rather than composing with them.
\newif\iffa@dispcentre \fa@dispcentrefalse
\newcommand{\fa@f@displaygap}{0.9}
\define@key{flexart}{displaycentre}[true]{\csname fa@dispcentre#1\endcsname}
\define@key{flexart}{displaygap}{\renewcommand{\fa@f@displaygap}{#1}}
\newskip\fa@tmpskip
\newcommand{\fa@absorb}[2]{% #1 target skip register  #2 fraction
  \fa@tmpskip=#2\parskip
  \advance#1 -\fa@tmpskip
  \ifdim#1<\z@ #1=\z@ \fi}
\newcommand{\fa@applymathskips}{%
  \iffa@dispcentre
    %% one symmetric gap, a multiple of \parskip, in all four slots: TeX picks the
    %% short variants when the neighbouring line is short, and that asymmetry is
    %% exactly what stops a display from sitting centred
    \fa@tmpskip=\fa@f@displaygap\parskip
    \abovedisplayskip\fa@tmpskip \belowdisplayskip\fa@tmpskip
    \abovedisplayshortskip\fa@tmpskip \belowdisplayshortskip\fa@tmpskip
    %% No optical variant: compensating for the preceding line's depth needs
    %% \prevdepth, which is only readable in vertical mode, while these skips are set
    %% from \everydisplay in MATH mode ("Improper \prevdepth").  Equal skips centre the
    %% display geometrically; about 3.5pt of ink asymmetry remains from font metrics.
  \else
    \setlength{\abovedisplayskip}{\fa@abovedisplay}%
    \setlength{\belowdisplayskip}{\fa@belowdisplay}%
    \setlength{\abovedisplayshortskip}{\fa@abovedisplayshort}%
    \setlength{\belowdisplayshortskip}{\fa@belowdisplayshort}%
    \iffa@absabove
      \fa@absorb{\abovedisplayskip}{\fa@absabovefrac}%
      \fa@absorb{\abovedisplayshortskip}{\fa@absabovefrac}%
    \fi
    \iffa@absbelow
      \fa@absorb{\belowdisplayskip}{\fa@absbelowfrac}%
      \fa@absorb{\belowdisplayshortskip}{\fa@absbelowfrac}%
    \fi
  \fi
  \setlength{\jot}{\fa@jot}}
\appto\normalsize{\fa@applymathskips}
\AtBeginDocument{\fa@displaydefaults\fa@applymathskips}
\everydisplay\expandafter{\the\everydisplay\fa@applymathskips}

%% --- \textwidth-relative defaults, re-derived after any margin change --------
%% The fractions live HERE ONLY, and both the load-time \setlength above and the
%% re-derivation below read them, so the two can never drift apart.  (They did once:
%% the re-derivation kept 0.86/0.07 after the defaults moved to 0.8/0.1, and only a
%% page-image comparison against an explicit \flexset caught it.)
\newcommand{\fa@relative}[2]{%
  \ifcsdef{fa@userset@#1}{}%
    {\setlength{#2}{\csuse{fa@f@#1}\textwidth}}}
\newcommand{\fa@relativedefaults}{%
  \fa@relative{titlewidth}{\fa@titlewidth}%
  \fa@relative{authorwidth}{\fa@authorwidth}%
  %% abstractindent is absolute in v2.2 (a 3.6em inset), but abstractwidth still
  %% depends on \textwidth, so it must be re-derived here: at package-load time the
  %% margins have not been applied yet and \textwidth is still the class default.
  \ifcsdef{fa@userset@abstractwidth}{}%
    {\setlength{\fa@abstractwidth}{\dimexpr\textwidth-7.2em\relax}}%
  \fa@relative{rulelength}{\fa@rulelength}%
  %% Rule lengths written as \linewidth (or a fraction of it) CANNOT be resolved at
  %% package-load time: \linewidth only takes the text measure at \begin{document}.
  %% Left at load-time values the contents rules came out 110pt short.  Each is
  %% re-derived here unless the document set it explicitly.
  \@for\fa@r:=tocpart,tocsection,tocsubsection,tocsubsubsection,tocappendix,%
              tocappendixgroup\do{%
    \ifcsname fa@\fa@r rulelength\endcsname
      \ifcsdef{fa@userset@\fa@r rulelength}{}%
        {\expandafter\setlength\csname fa@\fa@r rulelength\endcsname{\linewidth}}%
    \fi}%
  \ifcsdef{fa@userset@partrulelength}{}%
    {\renewcommand{\fa@partrulelength}{0.32\linewidth}}}
\AtBeginDocument{\fa@relativedefaults}

%% ===============================================================
%% 9. amsthm THEOREM STYLES
%% ===============================================================
%% Redefines amsthm's own `plain', `definition' and `remark' styles, so an
%% ordinary \theoremstyle{plain}\newtheorem{thm}{Theorem} picks these up with no
%% change to the document.  amsthm resolves \th@<style> when the theorem is USED,
%% so installing the styles at \begin{document} is early enough whatever order
%% the preamble is in.  Nothing happens unless amsthm is loaded; flexart does not
%% load it for you.  Call \flexthmstyles by hand to re-install mid-preamble.
%%   #1 style  #2 above  #3 below  #4 bodyfont  #5 indent
%%   #6 headfont  #7 headpunct  #8 headspace
\newcommand{\fa@newthmstyle}[8]{%
  \expandafter\newlength\csname fa@#1@above\endcsname
  \expandafter\newlength\csname fa@#1@below\endcsname
  \expandafter\setlength\csname fa@#1@above\endcsname{#2}%
  \expandafter\setlength\csname fa@#1@below\endcsname{#3}%
  \csdef{fa@#1@bodyfont}{#4}%
  \csdef{fa@#1@indent}{#5}%
  \csdef{fa@#1@headfont}{#6}%
  \csdef{fa@#1@headpunct}{#7}%
  \csdef{fa@#1@headspace}{#8}%
  \define@key{flexart}{#1above}{\expandafter\setlength\csname fa@#1@above\endcsname{##1}}%
  \define@key{flexart}{#1below}{\expandafter\setlength\csname fa@#1@below\endcsname{##1}}%
  \define@key{flexart}{#1bodyfont}{\csdef{fa@#1@bodyfont}{##1}}%
  \define@key{flexart}{#1indent}{\csdef{fa@#1@indent}{##1}}%
  \define@key{flexart}{#1headfont}{\csdef{fa@#1@headfont}{##1}}%
  \define@key{flexart}{#1headpunct}{\csdef{fa@#1@headpunct}{##1}}%
  \define@key{flexart}{#1headspace}{\csdef{fa@#1@headspace}{##1}}%
  %% v2.0: paragraph shape INSIDE the theorem body.  amsthm's \newtheoremstyle has no
  %% key for it, so these are appended to the body-font argument, which is executed
  %% inside the environment once the list has started.  Both \parsep and \parskip are
  %% set: the list copies \parsep into \parskip when it opens, so assigning only one of
  %% them can be too late to matter.
  \expandafter\newlength\csname fa@#1@parsep\endcsname
  \expandafter\newlength\csname fa@#1@parindent\endcsname
  \expandafter\setlength\csname fa@#1@parsep\endcsname{0.25em}%
  \expandafter\setlength\csname fa@#1@parindent\endcsname{\fa@parindent}%
  \define@key{flexart}{#1parsep}{\expandafter\setlength\csname fa@#1@parsep\endcsname{##1}}%
  \define@key{flexart}{#1parindent}{\expandafter\setlength\csname fa@#1@parindent\endcsname{##1}}%
}
%% defaults reproduce amsthm's built-in styles
\fa@newthmstyle{thmplain}{0.3em}{0.5em}{\itshape}{}{\bfseries}{.}{5pt}
\fa@newthmstyle{thmdefinition}{0.3em}{0.5em}{\normalfont}{}{\bfseries\scshape}{.}%
  {5pt \@plus 1pt \@minus 1pt}
\fa@newthmstyle{thmremark}{0.3em}{0.5em}{\normalfont}{10pt}{\itshape}{:}%
  {5pt \@plus 1pt \@minus 1pt}

%% The arguments must reach \newtheoremstyle as LITERAL values, not as
%% \csuse{...}: amsthm tests argument 5 with \@ifempty (so an empty indent has to
%% arrive as {}, otherwise it reads a missing number) and compares argument 8
%% against \space and \newline. So build the call with \edef, expanding the stored
%% values one level while leaving font declarations untouched.
\newcommand{\fa@installthmstyle}[2]{% #1 flexart prefix  #2 amsthm style name
  \edef\fa@thm@do{%
    \noexpand\newtheoremstyle{#2}%
      {\the\csname fa@#1@above\endcsname}%
      {\the\csname fa@#1@below\endcsname}%
      {\csexpandonce{fa@#1@bodyfont}%
       \noexpand\setlength\noexpand\parsep{\the\csname fa@#1@parsep\endcsname}%
       \noexpand\setlength\noexpand\parskip{\the\csname fa@#1@parsep\endcsname}%
       \noexpand\setlength\noexpand\parindent{\the\csname fa@#1@parindent\endcsname}}%
      {\csexpandonce{fa@#1@indent}}%
      {\csexpandonce{fa@#1@headfont}}%
      {\csexpandonce{fa@#1@headpunct}}%
      {\csexpandonce{fa@#1@headspace}}%
      {}}%
  \fa@thm@do}
\newcommand{\flexthmstyles}{%
  \@ifpackageloaded{amsthm}%
    {\fa@installthmstyle{thmplain}{plain}%
     \fa@installthmstyle{thmdefinition}{definition}%
     \fa@installthmstyle{thmremark}{remark}}%
    {\PackageWarning{flexart}{Theorem-style keys ignored: amsthm is not loaded}}}
\AtBeginDocument{\@ifpackageloaded{amsthm}{\flexthmstyles}{}}

%% ===============================================================
%% 10. PROOF ENVIRONMENT (amsthm) AND ENUMERATE (enumitem)
%% ===============================================================
%% Both subsystems stay out of the way unless one of their keys was actually set,
%% so loading flexart neither redefines proof nor touches list spacing on its own.
\newcommand{\fa@ifanyset}[2]{%
  \def\fa@found{0}%
  \@for\fa@k:=#1\do{\ifcsdef{fa@userset@\fa@k}{\def\fa@found{1}}{}}%
  \ifnum\fa@found=1 #2\fi}
%% --- proof -----------------------------------------------------
%% amsthm's proof sets \topsep itself (6pt plus 6pt) inside the environment, so
%% prepending an assignment to \proof would be overwritten.  The environment is
%% therefore redefined here, identically except that the space above comes from
%% proofabove and the space BELOW from proofbelow.  A trivlist takes its closing
%% space from \@topsepadd, fixed when the list opens, so the below value is
%% assigned just before \endtrivlist rather than by changing \topsep again.
\newlength{\fa@proofabove} \setlength{\fa@proofabove}{-0.5em}
\newlength{\fa@proofbelow} \setlength{\fa@proofbelow}{0em}
\newcommand{\fa@proofheadfont}{\itshape}
%% v2.0: paragraph shape inside the proof body, same idea as the theorem styles.
\newlength{\fa@proofparsep}    \setlength{\fa@proofparsep}{0.25em}
\newlength{\fa@proofparindent} \setlength{\fa@proofparindent}{\fa@parindent}
\fa@deflen{proofparsep}{\fa@proofparsep}
\fa@deflen{proofparindent}{\fa@proofparindent}
\fa@deflen{proofabove}{\fa@proofabove}
\fa@deflen{proofbelow}{\fa@proofbelow}
\fa@defcmd{proofheadfont}{\fa@proofheadfont}
\newcommand{\flexproof}{%
  \@ifpackageloaded{amsthm}%
    {\renewenvironment{proof}[1][\proofname]{\par
       \pushQED{\qed}%
       \normalfont \setlength{\topsep}{\fa@proofabove}%
       \setlength{\parsep}{\fa@proofparsep}\setlength{\parskip}{\fa@proofparsep}%
       \trivlist
       \item[\hskip\labelsep\fa@proofheadfont ##1\@addpunct{.}]%
       \setlength{\parindent}{\fa@proofparindent}\ignorespaces
     }{%
       \setlength{\@topsepadd}{\fa@proofbelow}%
       \popQED\endtrivlist\@endpefalse
     }}%
    {\PackageWarning{flexart}{proof keys ignored: amsthm is not loaded}}}
\AtBeginDocument{%
  \@ifpackageloaded{amsthm}{\flexproof}%
    {\fa@ifanyset{proofabove,proofbelow,proofheadfont}%
      {\PackageWarning{flexart}{proof keys ignored: amsthm is not loaded}}}}

%% --- lists: enumerate and itemize -------------------------------
%% The spacing keys are handed to enumitem's \setlist[<env>], except the space
%% BELOW the list: enumitem has no key for it (a list's closing space is \topsep,
%% fixed when the list opens), so \end<env> is patched to set \@topsepadd, the same
%% mechanism used for proof above.  That patch is independent of enumitem.
%% One generator serves both list types, so the two can never drift apart.
%%   #1 key prefix   #2 environment name
%%   #3..#9 defaults: above below partopsep itemsep parsep leftmargin labelsep
\newcommand{\fa@newlisttype}[9]{%
  \expandafter\newlength\csname fa@#1@above\endcsname
  \expandafter\newlength\csname fa@#1@below\endcsname
  \expandafter\newlength\csname fa@#1@partopsep\endcsname
  \expandafter\newlength\csname fa@#1@itemsep\endcsname
  \expandafter\newlength\csname fa@#1@parsep\endcsname
  \expandafter\newlength\csname fa@#1@leftmargin\endcsname
  \expandafter\newlength\csname fa@#1@labelsep\endcsname
  \expandafter\setlength\csname fa@#1@above\endcsname{#3}%
  \expandafter\setlength\csname fa@#1@below\endcsname{#4}%
  \expandafter\setlength\csname fa@#1@partopsep\endcsname{#5}%
  \expandafter\setlength\csname fa@#1@itemsep\endcsname{#6}%
  \expandafter\setlength\csname fa@#1@parsep\endcsname{#7}%
  \expandafter\setlength\csname fa@#1@leftmargin\endcsname{#8}%
  \expandafter\setlength\csname fa@#1@labelsep\endcsname{#9}%
  \csdef{fa@#1@env}{#2}%
  \define@key{flexart}{#1above}{\expandafter\setlength\csname fa@#1@above\endcsname{##1}%
    \csgdef{fa@userset@#1above}{1}}%
  \define@key{flexart}{#1below}{\expandafter\setlength\csname fa@#1@below\endcsname{##1}%
    \csgdef{fa@userset@#1below}{1}}%
  \define@key{flexart}{#1partopsep}{\expandafter\setlength\csname fa@#1@partopsep\endcsname{##1}%
    \csgdef{fa@userset@#1partopsep}{1}}%
  \define@key{flexart}{#1itemsep}{\expandafter\setlength\csname fa@#1@itemsep\endcsname{##1}%
    \csgdef{fa@userset@#1itemsep}{1}}%
  \define@key{flexart}{#1parsep}{\expandafter\setlength\csname fa@#1@parsep\endcsname{##1}%
    \csgdef{fa@userset@#1parsep}{1}}%
  \define@key{flexart}{#1leftmargin}{\expandafter\setlength\csname fa@#1@leftmargin\endcsname{##1}%
    \csgdef{fa@userset@#1leftmargin}{1}}%
  \define@key{flexart}{#1labelsep}{\expandafter\setlength\csname fa@#1@labelsep\endcsname{##1}%
    \csgdef{fa@userset@#1labelsep}{1}}%
}
\fa@newlisttype{enum}{enumerate}{0em}{0.3em}{0pt}{0.2em}{0.1em}{2em}{0.4em}
\fa@newlisttype{itemize}{itemize}{0em}{0.3em}{0pt}{0.2em}{0.1em}{2em}{0.4em}

\newcommand{\fa@applylist}[1]{% #1 = key prefix
  \@ifpackageloaded{enumitem}%
    {\edef\fa@list@do{%
       \noexpand\setlist[\csuse{fa@#1@env}]{%
         topsep=\the\csname fa@#1@above\endcsname,%
         partopsep=\the\csname fa@#1@partopsep\endcsname,%
         itemsep=\the\csname fa@#1@itemsep\endcsname,%
         parsep=\the\csname fa@#1@parsep\endcsname,%
         leftmargin=\the\csname fa@#1@leftmargin\endcsname,%
         labelsep=\the\csname fa@#1@labelsep\endcsname}}%
     \fa@list@do}%
    {\fa@ifanyset{#1above,#1below,#1partopsep,#1itemsep,#1parsep,#1leftmargin,#1labelsep}%
      {\PackageWarning{flexart}{\csuse{fa@#1@env} spacing keys ignored: enumitem is not loaded}}}%
  %% independent space below the list, with or without enumitem
  \expandafter\pretocmd\csname end\csuse{fa@#1@env}\endcsname
    {\setlength{\@topsepadd}{\csuse{fa@#1@below}}}{}%
    {\PackageWarning{flexart}{could not patch \string\end\csuse{fa@#1@env};
       \csuse{fa@#1@env} below-space ignored}}}
\newcommand{\flexenumerate}{\fa@applylist{enum}}
\newcommand{\flexitemize}{\fa@applylist{itemize}}
\newcommand{\flexlists}{\flexenumerate\flexitemize}
\AtBeginDocument{\flexlists}
