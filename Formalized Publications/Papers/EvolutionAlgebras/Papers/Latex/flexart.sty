\fa@deflen{belowprimary}{\fa@belowprimary}
\fa@deflen{abovesecondary}{\fa@abovesecondary}
\fa@deflen{belowsecondary}{\fa@belowsecondary}
\fa@deflen{aboveaffiliation}{\fa@aboveaffil}
\fa@deflen{belowaffiliation}{\fa@belowaffil}
\fa@deflen{abovedate}{\fa@abovedate}
\fa@deflen{belowdate}{\fa@belowdate}
\fa@deflen{aboveabstract}{\fa@aboveabstract}
\fa@deflen{belowabstract}{\fa@belowabstract}
\fa@deflen{abovekeywords}{\fa@abovekeywords}
\fa@deflen{belowkeywords}{\fa@belowkeywords}
