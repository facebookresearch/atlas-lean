/-!
# C2: quotient of CM by a regular element is CM
This file proves the C2 block — the quotient of a Cohen–Macaulay local ring by a
regular element of the maximal
ideal is Cohen–Macaulay, plus the load-bearing companion lemmas (local-quotient
instance identification of the maximal ideal) and a from-scratch system-of-
parameters existence lemma for general Noetherian local rings.

## note (assembly): `IsCM` unification

The `IsCM` definition below is the §2 predicate, verbatim. Sibling lanes (C1/C3)
carry their own copies; the assembly unifies them by definitional
unfolding (all copies are defeq: the same `GradeDepthFragment.grade`/`ringKrullDim`
equation), so no transport lemmas are needed.

## Proof route (deviations, recorded exactly)

* Status: exactly the design note's F4-promoted route — the proved full equation
  `GradeDepthFragment.grade_quotSMulTop_add_one_eq_grade` (:673) transported across a
  `QuotSMulTop x R ≃ₗ[R] (R ⧸ span {x})` bridge, plus the G1 R/R̄
  scalar-regularity correspondence (via
  `RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff` + a properness-span
  identification, no list induction needed).
* Dimension: the design note's F2/F3/F6/C2a route (s.o.p.-from-scratch lower bound,
  per-prime PIT + C2a height-plus-dim upper bound, ~400–600 lines) is
  subsumed by mathlib's exact drop lemma
  `ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim`
  (`KrullDimension/Regular.lean`, Stacks 0B52): for `x` regular in `𝔪`,
  `dim (R ⧸ span {x}) + 1 = dim R` in one citation. The F3/F6/C2a proof
  obligations are thereby discharged by citation, not re-proven.
* `sop_exists` is nevertheless proved from scratch (prime avoidance +
  dimension induction over the exact-drop lemma) as mandated, since the
  assembly/C3 lanes may consume it.
-/

namespace EvolutionAlgebras.Appendix_FixedPoint.BezoutChain.QuotientByRegularIsCM

open RingTheory.Sequence IsLocalRing Ideal
open scoped Pointwise

/-- Cohen–Macaulay (local): grade w.r.t. 𝔪 equals Krull dimension.
Coercion dance matches proved `DepthEqDimAt` (GradeDepthFragment:957). -/
def IsCM (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] : Prop :=
  ((GradeDepthFragment.grade R R (IsLocalRing.maximalIdeal R) : ℕ∞) : WithBot ℕ∞)
    = ringKrullDim R

/-- Companion: the quotient of a local ring by an ideal inside the maximal
ideal is local (no such instance in mathlib). -/
theorem isLocalRing_quotient_of_le_maximal {R : Type*} [CommRing R]
    [IsLocalRing R] (J' : Ideal R) (hle : J' ≤ IsLocalRing.maximalIdeal R) :
    IsLocalRing (R ⧸ J') := by
  have hJ : J' ≠ ⊤ := by
    intro h
    have htop : IsLocalRing.maximalIdeal R = ⊤ := top_le_iff.mp (h ▸ hle)
    have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R := htop ▸ Submodule.mem_top
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1
    exact h1 isUnit_one
  exact @IsLocalRing.of_surjective' R (R ⧸ J') inferInstance inferInstance
    inferInstance (Ideal.Quotient.nontrivial_iff.mpr hJ)
    (Ideal.Quotient.mk J') Ideal.Quotient.mk_surjective

/-- F5 second half: maximal-ideal identification for local quotients.
No mathlib API (verified absent); proof mirrors the inline `have` precedent at
mathlib `RingTheory/LocalRing/Quotient.lean`. -/
theorem maximalIdeal_quotient_eq_map {R : Type*} [CommRing R] [IsLocalRing R]
    (J' : Ideal R) (hle : J' ≤ IsLocalRing.maximalIdeal R)
    [IsLocalRing (R ⧸ J')] :
    IsLocalRing.maximalIdeal (R ⧸ J')
      = Ideal.map (Ideal.Quotient.mk J') (IsLocalRing.maximalIdeal R) := by
  have := IsLocalHom.of_surjective (Ideal.Quotient.mk J') Ideal.Quotient.mk_surjective
  ext x
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  simp [sup_eq_left.mpr hle]

/-- A commutative ring is finite as a module over itself (generated by `{1}`).
Needed for the grade equation at `M' = R`. -/
theorem finite_self (R : Type*) [CommRing R] : Module.Finite R R := by
  have hspan : Submodule.span R ({1} : Set R) = ⊤ := by
    apply eq_top_iff.mpr
    intro x _
    have h1mem : (1 : R) ∈ Submodule.span R ({1} : Set R) :=
      Submodule.mem_span_of_mem (by simp)
    have hsmul := Submodule.smul_mem _ x h1mem
    rwa [smul_eq_mul, mul_one] at hsmul
  refine Module.Finite.of_fg_top ⟨{1}, ?_⟩
  simp [hspan]

/-- Own-ring fact: an ideal acting on `⊤` is itself. -/
theorem smul_top_eq_self {S : Type*} [CommRing S] (K : Ideal S) :
    K • (⊤ : Submodule S S) = (K : Submodule S S) := by
  rw [Ideal.smul_top_eq_map]
  simp

/-- Bridge A: `QuotSMulTop x R` is `R ⧸ span {x}` as an `R`-module. -/
noncomputable def quotSMulTopEquivQuotientSpan {R : Type*} [CommRing R] (x : R) :
    QuotSMulTop x R ≃ₗ[R] (R ⧸ Ideal.span {x}) := by
  have heq : (x • (⊤ : Submodule R R)) = (Ideal.span {x} : Submodule R R) := by
    rw [← Submodule.ideal_span_singleton_smul, smul_top_eq_self]
  exact Submodule.quotEquivOfEq _ _ heq

/-- Restriction of scalars reflects `⊤` (same carrier). -/
theorem restrictScalars_ne_top_iff {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (K : Submodule S S) :
    (⊤ : Submodule R S) ≠ K.restrictScalars R ↔ (⊤ : Submodule S S) ≠ K := by
  rw [ne_eq, ne_eq]
  apply not_congr
  constructor
  · intro h
    have h2 : K.restrictScalars R = (⊤ : Submodule R S) := h.symm
    rw [Submodule.restrictScalars_eq_top_iff R S S] at h2
    exact h2.symm
  · intro h
    rw [← h]
    ext y
    refine iff_of_true Submodule.mem_top ?_
    exact Submodule.mem_top

/-- G1 properness correspondence: `I • ⊤ ≠ ⊤` over `R` iff
`map mk I • ⊤ ≠ ⊤` over `R̄`. -/
theorem proper_quotient_mk_iff {R : Type*} [CommRing R] (J' : Ideal R)
    (rs : List R) :
    (⊤ : Submodule R (R ⧸ J')) ≠ Ideal.ofList rs • ⊤ ↔
      (⊤ : Submodule (R ⧸ J') (R ⧸ J'))
        ≠ Ideal.ofList (rs.map (Ideal.Quotient.mk J')) • ⊤ := by
  rw [← Ideal.map_ofList (Ideal.Quotient.mk J') rs]
  conv_lhs => rw [Ideal.smul_top_eq_map, Ideal.Quotient.algebraMap_eq]
  conv_rhs => rw [smul_top_eq_self]
  exact restrictScalars_ne_top_iff _

/-- G1 per-list correspondence (no list induction: the weakly-regular part is
`isWeaklyRegular_map_algebraMap_iff`, the properness part is above). -/
theorem isRegular_quotient_mk_iff {R : Type*} [CommRing R] (J' : Ideal R)
    (rs : List R) :
    IsRegular (R ⧸ J') rs ↔
      IsRegular (R ⧸ J') (rs.map (Ideal.Quotient.mk J')) := by
  rw [isRegular_iff, isRegular_iff]
  have hweak : IsWeaklyRegular (R ⧸ J') (rs.map (Ideal.Quotient.mk J')) ↔
      IsWeaklyRegular (R ⧸ J') rs := by
    have h := isWeaklyRegular_map_algebraMap_iff (R ⧸ J') (R ⧸ J') rs
    rwa [Ideal.Quotient.algebraMap_eq] at h
  exact and_congr hweak.symm (proper_quotient_mk_iff J' rs)

/-- Membership in the maximal ideal reflects along `mk` when `ker mk ≤ 𝔪`. -/
theorem mem_of_mk_mem_map {R : Type*} [CommRing R] [IsLocalRing R]
    (J' : Ideal R) (hle : J' ≤ IsLocalRing.maximalIdeal R) (r : R)
    (h : Ideal.Quotient.mk J' r ∈
      Ideal.map (Ideal.Quotient.mk J') (IsLocalRing.maximalIdeal R)) :
    r ∈ IsLocalRing.maximalIdeal R := by
  have hcomap : r ∈ Ideal.comap (Ideal.Quotient.mk J')
      (Ideal.map (Ideal.Quotient.mk J') (IsLocalRing.maximalIdeal R)) := h
  rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective _] at hcomap
  have hker : Ideal.comap (Ideal.Quotient.mk J') ⊥ = J' := Ideal.mk_ker
  rw [hker, sup_eq_left.mpr hle] at hcomap
  exact hcomap

/-- `GradeSet` transports across an `R`-linear equiv (entries unchanged). -/
theorem gradeSet_congr_of_equiv {R M M₂ : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup M₂] [Module R M₂]
    (e : M ≃ₗ[R] M₂) (I : Ideal R) :
    GradeDepthFragment.GradeSet R M I = GradeDepthFragment.GradeSet R M₂ I := by
  ext n
  constructor
  · rintro ⟨rs, hlen, hmem, hreg⟩
    exact ⟨rs, hlen, hmem, (e.isRegular_congr rs).mp hreg⟩
  · rintro ⟨rs, hlen, hmem, hreg⟩
    exact ⟨rs, hlen, hmem, (e.isRegular_congr rs).mpr hreg⟩

/-- Grade transports across an `R`-linear equiv. -/
theorem grade_congr_of_equiv {R M M₂ : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup M₂] [Module R M₂]
    (e : M ≃ₗ[R] M₂) (I : Ideal R) :
    GradeDepthFragment.grade R M I = GradeDepthFragment.grade R M₂ I := by
  unfold GradeDepthFragment.grade
  rw [gradeSet_congr_of_equiv e I]

/-- G1 at the grade-set level: `R`-lengths in `𝔪` on `R̄` are `R̄`-lengths
in `𝔪̄`. Forward maps `mk`; backward lifts via surjectivity. -/
theorem gradeSet_quotient_mk {R : Type*} [CommRing R] [IsLocalRing R]
    (J' : Ideal R) (hle : J' ≤ IsLocalRing.maximalIdeal R)
    [IsLocalRing (R ⧸ J')] :
    GradeDepthFragment.GradeSet R (R ⧸ J') (IsLocalRing.maximalIdeal R) =
      GradeDepthFragment.GradeSet (R ⧸ J') (R ⧸ J')
        (IsLocalRing.maximalIdeal (R ⧸ J')) := by
  ext n
  constructor
  · rintro ⟨rs, hlen, hmem, hreg⟩
    refine ⟨rs.map (Ideal.Quotient.mk J'), by rw [List.length_map, hlen], ?_, ?_⟩
    · intro q hq
      obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hq
      rw [maximalIdeal_quotient_eq_map J' hle]
      exact Ideal.mem_map_of_mem _ (hmem r hr)
    · exact (isRegular_quotient_mk_iff J' rs).mp hreg
  · rintro ⟨qs, hlen, hmem, hreg⟩
    have hsurj : ∀ q : R ⧸ J', ∃ r : R, Ideal.Quotient.mk J' r = q :=
      Ideal.Quotient.mk_surjective
    choose f hf using hsurj
    refine ⟨qs.map f, by rw [List.length_map, hlen], ?_, ?_⟩
    · intro r hr
      obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hr
      have hqmem : Ideal.Quotient.mk J' (f q) ∈
          Ideal.map (Ideal.Quotient.mk J') (IsLocalRing.maximalIdeal R) := by
        rw [hf q, ← maximalIdeal_quotient_eq_map J' hle]
        exact hmem q hq
      exact mem_of_mk_mem_map J' hle (f q) hqmem
    · have hfun : Ideal.Quotient.mk J' ∘ f = id := funext fun q => hf q
      have hmap : (qs.map f).map (Ideal.Quotient.mk J') = qs := by
        rw [List.map_map, hfun, List.map_id]
      have h2 : IsRegular (R ⧸ J') ((qs.map f).map (Ideal.Quotient.mk J')) := by
        rw [hmap]
        exact hreg
      exact (isRegular_quotient_mk_iff J' (qs.map f)).mpr h2

/-- `+ 1` is injective on `WithBot ℕ∞` (case analysis; no absorbent overlap). -/
theorem withBot_eNat_add_one_cancel (a b : WithBot ℕ∞)
    (h : a + 1 = b + 1) : a = b := by
  have hbot : (⊥ : WithBot ℕ∞) + 1 = ⊥ := by simp
  have htop : (⊤ : ℕ∞) + 1 = ⊤ := by simp
  cases a with
  | bot =>
    cases b with
    | bot => rfl
    | coe m =>
      exfalso
      rw [hbot] at h
      have hm : (↑m : WithBot ℕ∞) + 1 = ((m + 1 : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add]
      rw [hm] at h
      exact WithBot.bot_ne_coe h
  | coe n =>
    cases b with
    | bot =>
      exfalso
      rw [hbot] at h
      have hn : (↑n : WithBot ℕ∞) + 1 = ((n + 1 : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add]
      rw [hn] at h
      exact WithBot.bot_ne_coe h.symm
    | coe m =>
      have hn : (↑n : WithBot ℕ∞) + 1 = ((n + 1 : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add]
      have hm : (↑m : WithBot ℕ∞) + 1 = ((m + 1 : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add]
      rw [hn, hm, WithBot.coe_eq_coe] at h
      cases n with
      | top =>
        cases m with
        | top => rfl
        | coe j =>
          exfalso
          rw [htop] at h
          have hj : (↑j : ℕ∞) + 1 = ((j + 1 : ℕ) : ℕ∞) := by
            norm_cast
          rw [hj] at h
          exact WithTop.top_ne_coe h
      | coe i =>
        cases m with
        | top =>
          exfalso
          rw [htop] at h
          have hi : (↑i : ℕ∞) + 1 = ((i + 1 : ℕ) : ℕ∞) := by
            norm_cast
          rw [hi] at h
          exact WithTop.top_ne_coe h.symm
        | coe j =>
          have hi : (↑i : ℕ∞) + 1 = ((i + 1 : ℕ) : ℕ∞) := by
            norm_cast
          have hj : (↑j : ℕ∞) + 1 = ((j + 1 : ℕ) : ℕ∞) := by
            norm_cast
          rw [hi, hj] at h
          have hplus : i + 1 = j + 1 := by exact_mod_cast h
          have hij : i = j := Nat.add_right_cancel hplus
          subst hij
          rfl

/-- C2 main theorem (step: quotient of CM by a regular element is CM).
Grade drops by one + bridges; dimension drops by one via mathlib's
exact drop lemma (Stacks 0B52), subsuming the design note's F2/F3/F6/C2a route. -/
theorem isCM_quotient_of_isSMulRegular {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (hCM : IsCM R) {x : R}
    (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hreg : IsSMulRegular R x)
    [IsLocalRing (R ⧸ Ideal.span {x})] :
    IsCM (R ⧸ Ideal.span {x}) := by
  have hle : Ideal.span {x} ≤ IsLocalRing.maximalIdeal R :=
    (Ideal.span_singleton_le_iff_mem _).mpr hx
  have hfin : Module.Finite R R := finite_self R
  have hdim : ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R :=
    ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim hreg hx
  have hIlt : IsLocalRing.maximalIdeal R • (⊤ : Submodule R R) < ⊤ := by
    rw [lt_top_iff_ne_top, smul_top_eq_self]
    intro hcon
    have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
      have h1' : (1 : R) ∈ (IsLocalRing.maximalIdeal R : Submodule R R) := by
        rw [hcon]
        exact Submodule.mem_top
      exact h1'
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1
    exact h1 isUnit_one
  have hgradeR : GradeDepthFragment.grade R (QuotSMulTop x R)
        (IsLocalRing.maximalIdeal R) + 1 =
        GradeDepthFragment.grade R R (IsLocalRing.maximalIdeal R) :=
    @GradeDepthFragment.grade_quotSMulTop_add_one_eq_grade R R inferInstance inferInstance
      inferInstance inferInstance hfin _ x hreg hx hIlt
  have hgradeA : GradeDepthFragment.grade R (QuotSMulTop x R)
        (IsLocalRing.maximalIdeal R) =
        GradeDepthFragment.grade R (R ⧸ Ideal.span {x}) (IsLocalRing.maximalIdeal R) :=
    grade_congr_of_equiv (quotSMulTopEquivQuotientSpan x) _
  have hgradeB : GradeDepthFragment.grade R (R ⧸ Ideal.span {x})
        (IsLocalRing.maximalIdeal R) =
        GradeDepthFragment.grade (R ⧸ Ideal.span {x}) (R ⧸ Ideal.span {x})
          (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})) := by
    unfold GradeDepthFragment.grade
    rw [gradeSet_quotient_mk _ hle]
  have hgrade : GradeDepthFragment.grade (R ⧸ Ideal.span {x}) (R ⧸ Ideal.span {x})
          (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})) + 1 =
        GradeDepthFragment.grade R R (IsLocalRing.maximalIdeal R) := by
    rw [← hgradeB, ← hgradeA]
    exact hgradeR
  have hgrade' : ((GradeDepthFragment.grade (R ⧸ Ideal.span {x}) (R ⧸ Ideal.span {x})
          (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})) : ℕ∞) : WithBot ℕ∞) + 1 =
        ((GradeDepthFragment.grade R R (IsLocalRing.maximalIdeal R) : ℕ∞) : WithBot ℕ∞) := by
    have h := congrArg (fun g : ℕ∞ => (g : WithBot ℕ∞)) hgrade
    simpa using h
  unfold IsCM
  apply withBot_eNat_add_one_cancel
  rw [hgrade', hCM]
  exact hdim.symm

section PrimeAvoidance

/-- Sum of ideal elements is in the ideal (standalone induction). -/
theorem ideal_sum_mem {R : Type*} [CommRing R] (I : Ideal R)
    (s : Finset (Ideal R)) (g : Ideal R → R)
    (h : ∀ p ∈ s, g p ∈ I) : ∑ p ∈ s, g p ∈ I := by
  classical
  revert h
  induction s using Finset.induction with
  | empty =>
    intro _
    rw [Finset.sum_empty]
    exact I.zero_mem
  | insert a s ha ih =>
    intro h
    rw [Finset.sum_insert ha]
    exact I.add_mem (h _ (Finset.mem_insert_self _ _))
      (ih (fun p hp => h p (Finset.mem_insert_of_mem hp)))

/-- Product over a nonempty finset of ideal elements is in the ideal. -/
theorem ideal_prod_mem_of_nonempty {R : Type*} [CommRing R] (I : Ideal R)
    (s : Finset (Ideal R)) (f : Ideal R → R) (hne : s.Nonempty)
    (h : ∀ q ∈ s, f q ∈ I) : ∏ q ∈ s, f q ∈ I := by
  classical
  obtain ⟨a, ha⟩ := hne
  rw [← Finset.mul_prod_erase _ _ ha]
  exact Ideal.mul_mem_right _ I (h a ha)

/-- A factor in the ideal puts the whole product in the ideal. -/
theorem ideal_prod_mem_of_mem {R : Type*} [CommRing R] (I : Ideal R)
    (s : Finset (Ideal R)) (f : Ideal R → R) (a : Ideal R) (ha : a ∈ s)
    (hfa : f a ∈ I) : ∏ q ∈ s, f q ∈ I := by
  classical
  rw [← Finset.mul_prod_erase _ _ ha]
  exact Ideal.mul_mem_right _ I hfa

/-- A product avoids a prime if every factor does. -/
theorem prod_notMem_of_prime {R : Type*} [CommRing R]
    (s : Finset (Ideal R)) (f : Ideal R → R) (p : Ideal R) (hp : p.IsPrime)
    (h : ∀ q ∈ s, f q ∉ p) : ∏ q ∈ s, f q ∉ p := by
  classical
  revert h
  induction s using Finset.induction with
  | empty =>
    intro _
    rw [Finset.prod_empty]
    intro h1
    exact hp.ne_top ((Ideal.eq_top_iff_one p).mpr h1)
  | insert a s ha ih =>
    intro h
    rw [Finset.prod_insert ha]
    intro hcon
    rcases hp.mem_or_mem hcon with hmem | hmem
    · exact h _ (Finset.mem_insert_self _ _) hmem
    · exact ih (fun q hq => h q (Finset.mem_insert_of_mem hq)) hmem

/-- Prime avoidance for finitely many prime ideals (from scratch, by
induction on the cardinality bound; the combination step is the classical
sum-of-products construction). -/
theorem exists_mem_notMem_of_forall_not_le {R : Type*} [CommRing R]
    (I : Ideal R) (ps : Finset (Ideal R)) (hprime : ∀ p ∈ ps, p.IsPrime)
    (hle : ∀ p ∈ ps, ¬ I ≤ p) :
    ∃ x ∈ I, ∀ p ∈ ps, x ∉ p := by
  classical
  suffices h : ∀ (n : ℕ) (qs : Finset (Ideal R)), (∀ p ∈ qs, p.IsPrime) →
      (∀ p ∈ qs, ¬ I ≤ p) → qs.card ≤ n → ∃ x ∈ I, ∀ p ∈ qs, x ∉ p by
    exact h ps.card ps hprime hle le_rfl
  intro n
  induction n with
  | zero =>
    intro qs _ _ hcard
    have h0 : qs.card = 0 := by omega
    have hempty : qs = ∅ := Finset.card_eq_zero.mp h0
    subst hempty
    refine ⟨0, I.zero_mem, ?_⟩
    intro p hp
    exact absurd hp (Finset.notMem_empty p)
  | succ n ih =>
    intro qs hp hle hcard
    by_cases h1 : qs.card ≤ 1
    · by_cases hempty : qs = ∅
      · subst hempty
        refine ⟨0, I.zero_mem, ?_⟩
        intro p hp
        exact absurd hp (Finset.notMem_empty p)
      · have hne : qs.Nonempty := Finset.nonempty_iff_ne_empty.mpr hempty
        have hpos : 0 < qs.card := Finset.card_pos.mpr hne
        have hcard1 : qs.card = 1 := by omega
        obtain ⟨p, rfl⟩ := Finset.card_eq_one.mp hcard1
        have hex : ∃ y ∈ I, y ∉ p := by
          by_contra hcon
          apply hle p (Finset.mem_singleton_self p)
          intro y hy
          by_contra hyp
          exact hcon ⟨y, hy, hyp⟩
        obtain ⟨y, hyI, hyp⟩ := hex
        refine ⟨y, hyI, ?_⟩
        intro q hq
        have hqp : q = p := Finset.mem_singleton.mp hq
        subst hqp
        exact hyp
    · have hchoice : ∀ p ∈ qs, ∃ y ∈ I, ∀ q ∈ qs.erase p, y ∉ q := by
        intro p hpq
        have hcard' : (qs.erase p).card ≤ n := by
          rw [Finset.card_erase_of_mem hpq]
          omega
        exact ih (qs.erase p) (fun q hq => hp q (Finset.mem_of_mem_erase hq))
          (fun q hq => hle q (Finset.mem_of_mem_erase hq)) hcard'
      have hy_exists : ∀ p : Ideal R, ∃ y : R,
          (p ∈ qs → y ∈ I) ∧ ∀ q ∈ qs.erase p, (p ∈ qs → y ∉ q) := by
        intro p
        by_cases hpq : p ∈ qs
        · obtain ⟨y, hyI, hyq⟩ := hchoice p hpq
          exact ⟨y, fun _ => hyI, fun q hq _ => hyq q hq⟩
        · exact ⟨0, fun h => absurd h hpq, fun q _ h => absurd h hpq⟩
      choose y hy using hy_exists
      have hyI : ∀ q ∈ qs, y q ∈ I := fun q hq => (hy q).1 hq
      by_cases hex : ∃ p ∈ qs, y p ∉ p
      · obtain ⟨p, hpq, hnp⟩ := hex
        refine ⟨y p, hyI p hpq, ?_⟩
        intro q hq
        by_cases heq : q = p
        · subst heq
          exact hnp
        · exact (hy p).2 q (Finset.mem_erase.mpr ⟨heq, hq⟩) hpq
      · have hall : ∀ p ∈ qs, y p ∈ p := by
          intro p hpq
          by_contra hnp
          exact hex ⟨p, hpq, hnp⟩
        set z : Ideal R → R := fun p => ∏ q ∈ qs.erase p, y q with hz
        have herase_ne : ∀ p ∈ qs, (qs.erase p).Nonempty := by
          intro p hpq
          rw [← Finset.card_pos, Finset.card_erase_of_mem hpq]
          omega
        have hzI : ∀ p ∈ qs, z p ∈ I := by
          intro p hpq
          change (∏ q ∈ qs.erase p, y q) ∈ I
          exact ideal_prod_mem_of_nonempty I (qs.erase p) y
            (herase_ne p hpq)
            (fun q hq => hyI q (Finset.mem_of_mem_erase hq))
        have hznot : ∀ p ∈ qs, z p ∉ p := by
          intro p hpq
          change (∏ q ∈ qs.erase p, y q) ∉ p
          apply prod_notMem_of_prime (qs.erase p) y p (hp p hpq)
          intro q hq
          have hqp : q ∈ qs := Finset.mem_of_mem_erase hq
          have hne : q ≠ p := (Finset.mem_erase.mp hq).1
          have hp_in : p ∈ qs.erase q :=
            Finset.mem_erase.mpr ⟨Ne.symm hne, hpq⟩
          exact (hy q).2 p hp_in hqp
        refine ⟨∑ p ∈ qs, z p, ideal_sum_mem I qs z hzI, ?_⟩
        intro p₀ hp₀ hxmem
        have hsum : ∑ p ∈ qs.erase p₀, z p ∈ p₀ :=
          ideal_sum_mem p₀ (qs.erase p₀) z (fun p hp => by
            have hpqs : p ∈ qs := Finset.mem_of_mem_erase hp
            have hne : p ≠ p₀ := (Finset.mem_erase.mp hp).1
            have hp₀in : p₀ ∈ qs.erase p :=
              Finset.mem_erase.mpr ⟨Ne.symm hne, hp₀⟩
            change (∏ q ∈ qs.erase p, y q) ∈ p₀
            exact ideal_prod_mem_of_mem p₀ (qs.erase p) y p₀ hp₀in
              (hall p₀ hp₀))
        have hdecomp : z p₀ + ∑ p ∈ qs.erase p₀, z p = ∑ p ∈ qs, z p :=
          Finset.add_sum_erase _ _ hp₀
        have hzmem : z p₀ ∈ p₀ := by
          have hdecomp' : z p₀ =
              (∑ p ∈ qs, z p) - ∑ p ∈ qs.erase p₀, z p := by
            rw [← hdecomp]
            ring
          rw [hdecomp']
          exact p₀.sub_mem hxmem hsum
        exact (hznot p₀ hp₀) hzmem

end PrimeAvoidance

section SopExists

/-- The annihilator of a ring in itself is `⊥`. -/
theorem annihilator_self_eq_bot (R : Type*) [CommRing R] :
    Module.annihilator R R = ⊥ := by
  ext r
  rw [Module.mem_annihilator, Submodule.mem_bot]
  constructor
  · intro h
    have h1 := h 1
    rwa [smul_eq_mul, mul_one] at h1
  · intro h
    subst h
    intro m
    simp

/-- A system of parameters: `d` elements of `𝔪` spanning an ideal whose
quotient has dimension `≤ 0` (i.e., `𝔪`-primary). -/
def IsSystemOfParameters {R : Type*} [CommRing R] [IsLocalRing R] (d : ℕ)
    (xs : Fin d → R) : Prop :=
  (∀ i, xs i ∈ IsLocalRing.maximalIdeal R) ∧
    ringKrullDim (R ⧸ Ideal.span (Set.range xs)) ≤ 0

/-- From-scratch existence of systems of parameters in any Noetherian local
ring of finite dimension: prime avoidance over `minimalPrimes` + dimension
induction over the exact-drop lemma. -/
theorem sop_exists_aux : ∀ (d : ℕ) (R : Type*) [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R], ringKrullDim R = (d : WithBot ℕ∞) →
    ∃ xs : Fin d → R, IsSystemOfParameters d xs := by
  intro d
  induction d with
  | zero =>
    intro R _ _ _ hd
    have hspan : ∀ xs : Fin 0 → R, Ideal.span (Set.range xs) = ⊥ := by
      intro xs
      have hrange : Set.range xs = ∅ := by
        rw [Set.eq_empty_iff_forall_notMem]
        intro x hx
        obtain ⟨i, _⟩ := hx
        exact i.elim0
      rw [hrange, Ideal.span_empty]
    refine ⟨fun i => i.elim0, fun i => i.elim0, ?_⟩
    rw [hspan]
    have hdim : ringKrullDim (R ⧸ (⊥ : Ideal R)) = ringKrullDim R :=
      RingEquiv.ringKrullDim (RingEquiv.quotientBot R)
    rw [hdim, hd]
    simp
  | succ d ih =>
    intro R _ _ _ hd
    have hfin : ((⊥ : Ideal R).minimalPrimes).Finite :=
      Ideal.finite_minimalPrimes_of_isNoetherianRing R ⊥
    have hnotle : ∀ p ∈ hfin.toFinset, ¬ maximalIdeal R ≤ p := by
      intro p hp hle
      have hpmem : p ∈ (⊥ : Ideal R).minimalPrimes :=
        (Set.Finite.mem_toFinset hfin).mp hp
      have hpprime : p.IsPrime := Ideal.IsMinimalPrime.isPrime hpmem
      have hple : p ≤ maximalIdeal R :=
        IsLocalRing.le_maximalIdeal hpprime.ne_top
      have hmeq : maximalIdeal R = p := le_antisymm hle hple
      have hmmin : maximalIdeal R ∈ (⊥ : Ideal R).minimalPrimes := by
        rw [hmeq]
        exact hpmem
      have hall : ∀ q : Ideal R, q.IsPrime → q.IsMaximal := by
        intro q hq
        obtain ⟨r, hrmin, hrq⟩ :=
          @Ideal.exists_minimalPrimes_le R inferInstance ⊥ q hq bot_le
        have hrprime : r.IsPrime := Ideal.IsMinimalPrime.isPrime hrmin
        have hrle : r ≤ maximalIdeal R :=
          IsLocalRing.le_maximalIdeal hrprime.ne_top
        have hmmin' : Minimal (fun q : Ideal R => q.IsPrime ∧ (⊥ : Ideal R) ≤ q)
            (maximalIdeal R) := hmmin
        obtain ⟨-, hmin⟩ := hmmin'
        have hle2 : maximalIdeal R ≤ r := hmin ⟨hrprime, bot_le⟩ hrle
        have hreq : r = maximalIdeal R := le_antisymm hrle hle2
        have hqle : q ≤ maximalIdeal R :=
          IsLocalRing.le_maximalIdeal hq.ne_top
        have hqeq : q = maximalIdeal R := by
          apply le_antisymm hqle
          rw [← hreq]
          exact hrq
        rw [hqeq]
        exact IsLocalRing.maximalIdeal.isMaximal R
      have h0 : Ring.KrullDimLE 0 R := Ring.KrullDimLE.mk₀ hall
      rw [Ring.krullDimLE_iff] at h0
      rw [hd] at h0
      have hle' : ((d + 1 : ℕ) : ℕ∞) ≤ ((0 : ℕ) : ℕ∞) :=
        WithBot.coe_le_coe.mp h0
      have hle'' : d + 1 ≤ 0 := Nat.cast_le.mp hle'
      omega
    obtain ⟨x, hxI, hxavoid⟩ := exists_mem_notMem_of_forall_not_le
      (maximalIdeal R) hfin.toFinset
      (fun p hp => Ideal.IsMinimalPrime.isPrime
        ((Set.Finite.mem_toFinset hfin).mp hp)) hnotle
    have hfinR : Module.Finite R R := finite_self R
    have hann : Module.annihilator R R = ⊥ := annihilator_self_eq_bot R
    have hsupp : Module.supportDim R (QuotSMulTop x R) + 1 =
        Module.supportDim R R :=
      @Module.supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal
        R inferInstance inferInstance R inferInstance inferInstance hfinR
        inferInstance x
        (fun p hp => by
          have hp' : p ∈ (⊥ : Ideal R).minimalPrimes := by
            rw [← hann]
            exact hp
          exact hxavoid p ((Set.Finite.mem_toFinset hfin).mpr hp')) hxI
    have hsuppQ : Module.supportDim R (QuotSMulTop x R) =
        ringKrullDim (R ⧸ Ideal.span {x}) := by
      rw [Module.supportDim_eq_of_equiv (quotSMulTopEquivQuotientSpan x),
        Module.supportDim_quotient_eq_ringKrullDim]
    have hsuppR : Module.supportDim R R = ringKrullDim R :=
      Module.supportDim_self_eq_ringKrullDim R
    have hdim : ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R := by
      rw [← hsuppQ, ← hsuppR]
      exact hsupp
    have esucc : ((d + 1 : ℕ) : WithBot ℕ∞) =
        ((d : ℕ) : WithBot ℕ∞) + 1 := by simp
    have hd' : ringKrullDim (R ⧸ Ideal.span {x}) =
        ((d : ℕ) : WithBot ℕ∞) := by
      apply withBot_eNat_add_one_cancel
      rw [hdim, hd, esucc]
    have hle : Ideal.span {x} ≤ maximalIdeal R :=
      (Ideal.span_singleton_le_iff_mem _).mpr hxI
    have hloc : IsLocalRing (R ⧸ Ideal.span {x}) :=
      isLocalRing_quotient_of_le_maximal _ hle
    obtain ⟨ys, hys1, hys2⟩ :=
      @ih (R ⧸ Ideal.span {x}) inferInstance inferInstance hloc hd'
    have hex : ∀ i : Fin d, ∃ r : R,
        Ideal.Quotient.mk (Ideal.span {x}) r = ys i :=
      fun i => Ideal.Quotient.mk_surjective (ys i)
    choose xs' hxs' using hex
    have hxs'I : ∀ i, xs' i ∈ maximalIdeal R := by
      intro i
      apply mem_of_mk_mem_map _ hle
      rw [hxs' i, ← maximalIdeal_quotient_eq_map _ hle]
      exact hys1 i
    refine ⟨Fin.cons (α := fun _ => R) x xs', ?_, ?_⟩
    · intro i
      refine Fin.cases ?_ ?_ i
      · rw [Fin.cons_zero]
        exact hxI
      · intro j
        rw [Fin.cons_succ]
        exact hxs'I j
    · have hrange : Set.range (Fin.cons (α := fun _ => R) x xs') =
          insert x (Set.range xs') := by
        ext y
        constructor
        · rintro ⟨i, rfl⟩
          refine Fin.cases ?_ ?_ i
          · rw [Fin.cons_zero]
            exact Set.mem_insert x _
          · intro j
            rw [Fin.cons_succ, Set.mem_insert_iff]
            exact Or.inr ⟨j, rfl⟩
        · intro hy
          rcases Set.mem_insert_iff.mp hy with rfl | ⟨j, rfl⟩
          · exact ⟨0, by rw [Fin.cons_zero]⟩
          · exact ⟨j.succ, by rw [Fin.cons_succ]⟩
      have hspan : Ideal.span (Set.range (Fin.cons (α := fun _ => R) x xs')) =
          Ideal.span {x} ⊔ Ideal.span (Set.range xs') := by
        rw [hrange, Ideal.span_insert]
      rw [hspan]
      have hrange_ys : Set.range ys =
          Ideal.Quotient.mk (Ideal.span {x}) '' Set.range xs' := by
        ext z
        constructor
        · rintro ⟨i, rfl⟩
          exact ⟨xs' i, ⟨i, rfl⟩, hxs' i⟩
        · rintro ⟨r, ⟨i, rfl⟩, rfl⟩
          exact ⟨i, (hxs' i).symm⟩
      have hdim_eq : ringKrullDim
            (R ⧸ (Ideal.span {x} ⊔ Ideal.span (Set.range xs'))) =
          ringKrullDim ((R ⧸ Ideal.span {x}) ⧸ Ideal.span (Set.range ys)) := by
        have e := DoubleQuot.quotQuotEquivQuotSup (Ideal.span {x})
          (Ideal.span (Set.range xs'))
        have e2 : ringKrullDim
              (R ⧸ (Ideal.span {x} ⊔ Ideal.span (Set.range xs'))) =
            ringKrullDim ((R ⧸ Ideal.span {x}) ⧸
              Ideal.map (Ideal.Quotient.mk (Ideal.span {x}))
                (Ideal.span (Set.range xs'))) :=
          (RingEquiv.ringKrullDim e).symm
        have hmap : Ideal.map (Ideal.Quotient.mk (Ideal.span {x}))
            (Ideal.span (Set.range xs')) = Ideal.span (Set.range ys) := by
          rw [Ideal.map_span, ← hrange_ys]
        rw [e2, hmap]
      rw [hdim_eq]
      exact hys2

/-- System-of-parameters existence (user-facing wrapper with `d` explicit). -/
theorem sop_exists {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (d : ℕ) (hd : ringKrullDim R = (d : WithBot ℕ∞)) :
    ∃ xs : Fin d → R, IsSystemOfParameters d xs :=
  sop_exists_aux d R hd

end SopExists

