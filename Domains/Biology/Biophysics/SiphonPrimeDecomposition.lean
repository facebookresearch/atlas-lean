module

public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic
public import MathlibExt.Dynamics.PolynomialNetworks.Deficiency
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Minimal siphons and the monomial ideal of complexes

In a strongly connected reaction network on finitely many species, each occurring in some
complex, the minimal siphons are the inclusion-minimal variable sets of the minimal primes over
the complex monomial ideal plus the ideal generated by the product of all variables. That sum
is the preimage of the monomial ideal in the quotient by the product. No finiteness of the reaction
index type is required: backward propagation uses only finite paths. The empty species case is
included: there is no nonempty siphon and the product generator is `1`.

## References

* Anne Shiu and Bernd Sturmfels, *Siphons in Chemical Reaction Networks*, Bulletin of
  Mathematical Biology 72 (2010), 1448–1463, Theorem 3.1 (third clause).
-/

@[expose] public section

namespace WantedExt.Biology.Biophysics.SiphonPrimeDecompositionWanted

open MathlibExt.Biology.Dynamics.ComplexBalanced MvPolynomial

variable {S ρ : Type*}

/-- `Z` is a **siphon** of `N`: `Z` is nonempty, and for every `z ∈ Z` and every reaction `r` whose
product complex contains `z`, some `a ∈ Z` lies in the reactant complex of `r`. -/
def IsSiphon (N : ReactionNetwork S ρ) (Z : Finset S) : Prop :=
  Z.Nonempty ∧ ∀ z ∈ Z, ∀ r, 0 < N.prod r z → ∃ a ∈ Z, 0 < N.src r a

/-- `Z` is a **minimal siphon**: a siphon with no siphon as a proper subset. -/
def IsMinimalSiphon (N : ReactionNetwork S ρ) (Z : Finset S) : Prop :=
  IsSiphon N Z ∧ ∀ Z', IsSiphon N Z' → Z' ⊆ Z → Z' = Z

section

variable [Fintype S]

/-- The monomial `c^y = ∏_s c_s ^ y_s`. -/
noncomputable def mono (y : S → ℕ) : MvPolynomial S ℚ :=
  ∏ s, X s ^ y s

/-- `M_G = ⟨c^y : y a complex⟩`. -/
noncomputable def idealM (N : ReactionNetwork S ρ) : Ideal (MvPolynomial S ℚ) :=
  Ideal.span (mono '' N.complexes)

/-- The ideal `⟨c_1 ⋯ c_s⟩` defining the quotient `R`. -/
noncomputable def prodIdeal : Ideal (MvPolynomial S ℚ) :=
  Ideal.span {∏ s, X s}

open Classical in
/-- The variables in `P`: `{i : c_i ∈ P}`. -/
noncomputable def varSet (P : Ideal (MvPolynomial S ℚ)) : Finset S :=
  Finset.univ.filter fun i => X i ∈ P

/-- `Z` is **inclusion-minimal** among the sets `{i : c_i ∈ P}` for `P` a minimal prime of
`I + ⟨c_1 ⋯ c_s⟩`. -/
def IsMinimalVarSet (I : Ideal (MvPolynomial S ℚ)) (Z : Finset S) : Prop :=
  (∃ P ∈ (I ⊔ prodIdeal).minimalPrimes, varSet P = Z) ∧
    ∀ P ∈ (I ⊔ prodIdeal).minimalPrimes, varSet P ⊆ Z → varSet P = Z

end

/-- Every species **occurs** in the network: it has a positive coefficient in the reactant or
product complex of some reaction (implicit in the source). -/
def AllSpeciesOccur (N : ReactionNetwork S ρ) : Prop :=
  ∀ s, ∃ r, 0 < N.src r s ∨ 0 < N.prod r s

/-- The network is **strongly connected**: every complex reaches every complex by a directed
path of reactions. -/
def IsStronglyConnected (N : ReactionNetwork S ρ) : Prop :=
  ∀ y ∈ N.complexes, ∀ y' ∈ N.complexes, Relation.ReflTransGen N.Reacts y y'

private theorem isSiphon_iff_reaction_closed {N : ReactionNetwork S ρ} {Z : Finset S} :
    IsSiphon N Z ↔ Z.Nonempty ∧ ∀ r,
      (∃ i ∈ Z, 0 < N.prod r i) → ∃ i ∈ Z, 0 < N.src r i := by
  constructor
  · rintro ⟨hne, hs⟩
    exact ⟨hne, fun r ⟨i, hi, hip⟩ => hs i hi r hip⟩
  · rintro ⟨hne, hs⟩
    exact ⟨hne, fun i hi r hip => hs r ⟨i, hi, hip⟩⟩

/-- **Minimal siphons by reaction closure.** A minimal siphon is an inclusion-minimal nonempty
set that meets the reactant of every reaction whose product it meets. -/
theorem isMinimalSiphon_iff_minimal_reaction_closed {N : ReactionNetwork S ρ} {Z : Finset S} :
    IsMinimalSiphon N Z ↔ Minimal (fun U : Finset S => U.Nonempty ∧ ∀ r,
      (∃ i ∈ U, 0 < N.prod r i) → ∃ i ∈ U, 0 < N.src r i) Z := by
  simp only [IsMinimalSiphon, minimal_iff, isSiphon_iff_reaction_closed, eq_comm (a := Z)]

private theorem isSiphon_iff_meets_complexes {N : ReactionNetwork S ρ}
    (hocc : AllSpeciesOccur N) (hsc : IsStronglyConnected N) {Z : Finset S} :
    IsSiphon N Z ↔ Z.Nonempty ∧ ∀ y ∈ N.complexes, ∃ i ∈ Z, 0 < y i := by
  rw [isSiphon_iff_reaction_closed]
  refine and_congr_right fun hne => ⟨?_, ?_⟩
  · intro hs y hy
    obtain ⟨i, hi⟩ := hne
    obtain ⟨r, hr⟩ := hocc i
    obtain ⟨y', hy', hhit⟩ : ∃ y' ∈ N.complexes, ∃ j ∈ Z, 0 < y' j := by
      rcases hr with hsrc | hprod
      · exact ⟨N.src r, N.mem_complexes_iff.mpr ⟨r, Or.inl rfl⟩, i, hi, hsrc⟩
      · exact ⟨N.prod r, N.mem_complexes_iff.mpr ⟨r, Or.inr rfl⟩, i, hi, hprod⟩
    -- Meeting the last complex propagates backwards along the path.
    exact N.prop_of_reaches (p := fun c => ∃ j ∈ Z, 0 < c j) (hsc y hy y' hy') hs hhit
  · intro hall r _
    exact hall (N.src r) (N.mem_complexes_iff.mpr ⟨r, Or.inl rfl⟩)

variable [Fintype S]

private theorem mem_varSet {P : Ideal (MvPolynomial S ℚ)} {i : S} :
    i ∈ varSet P ↔ X i ∈ P := by
  simp [varSet]

/-- **Variable sets of coordinate primes.** The ideal generated by the variables indexed by `Z`
contains exactly those variables. -/
theorem varSet_span_X_image (Z : Finset S) :
    varSet (Ideal.span (X '' (Z : Set S) : Set (MvPolynomial S ℚ))) = Z := by
  classical
  ext i
  rw [mem_varSet, mem_ideal_span_X_image, support_X]
  simp [Finsupp.single_apply]

private theorem mono_mem_iff {P : Ideal (MvPolynomial S ℚ)} [hP : P.IsPrime] {y : S → ℕ} :
    mono y ∈ P ↔ ∃ i ∈ varSet P, 0 < y i := by
  rw [mono, Ideal.IsPrime.prod_mem_iff]
  simp only [Finset.mem_univ, true_and, mem_varSet]
  constructor
  · rintro ⟨i, hi⟩
    have hpos : 0 < y i := Nat.pos_of_ne_zero fun he => hP.one_notMem (by simpa [he] using hi)
    exact ⟨i, (hP.pow_mem_iff_mem (y i) hpos).mp hi, hpos⟩
  · rintro ⟨i, hi, hpos⟩
    exact ⟨i, (hP.pow_mem_iff_mem (y i) hpos).mpr hi⟩

/-- **Prime containment for the complex ideal.** A prime contains `idealM N ⊔ prodIdeal` exactly
when its variable set is nonempty and meets every complex. -/
theorem idealM_sup_prodIdeal_le_iff (N : ReactionNetwork S ρ)
    (P : Ideal (MvPolynomial S ℚ)) [P.IsPrime] :
    idealM N ⊔ prodIdeal ≤ P ↔ (varSet P).Nonempty ∧
      ∀ y ∈ N.complexes, ∃ i ∈ varSet P, 0 < y i := by
  rw [sup_le_iff, and_comm, prodIdeal, Ideal.span_singleton_le_iff_mem, Ideal.IsPrime.prod_mem_iff,
    idealM, Ideal.span_le, Set.image_subset_iff]
  simp only [Finset.mem_univ, true_and, Finset.nonempty_def, mem_varSet, Set.subset_def,
    Set.mem_preimage, SetLike.mem_coe]
  exact and_congr_right fun _ => forall₂_congr fun y _ => by
    simpa only [mem_varSet] using (mono_mem_iff (P := P) (y := y))

/-- **Minimal siphons from the monomial ideal `M_G`** (Shiu and Sturmfels 2010, Theorem 3.1, third
clause): for a strongly connected network on finitely many species, each of which occurs in some
complex, a finite set `Z` of species is a minimal siphon iff it is inclusion-minimal among the sets
`{i : c_i ∈ P}` for `P` a minimal prime of `M_G + ⟨c_1 ⋯ c_s⟩`.

Source: Shiu and Sturmfels (2010), Theorem 3.1. -/
theorem isMinimalSiphon_iff_idealM (N : ReactionNetwork S ρ)
    (hocc : AllSpeciesOccur N) (hsc : IsStronglyConnected N) (Z : Finset S) :
    IsMinimalSiphon N Z ↔ IsMinimalVarSet (idealM N) Z := by
  let I := idealM N ⊔ prodIdeal
  have of_prime (P : Ideal (MvPolynomial S ℚ)) [P.IsPrime] (hle : I ≤ P) :
      IsSiphon N (varSet P) :=
    (isSiphon_iff_meets_complexes hocc hsc).mpr ((idealM_sup_prodIdeal_le_iff N P).mp hle)
  rw [show IsMinimalSiphon N Z ↔ Minimal (IsSiphon N) Z by
    simp only [IsMinimalSiphon, minimal_iff, eq_comm (a := Z)]]
  rw [show IsMinimalVarSet (idealM N) Z ↔
    Minimal (fun U => ∃ P ∈ I.minimalPrimes, varSet P = U) Z by
    constructor
    · rintro ⟨hZ, hmin⟩
      refine ⟨hZ, ?_⟩
      rintro _ ⟨P, hP, rfl⟩ hle
      exact (hmin P hP hle).ge
    · intro hZ
      exact ⟨hZ.prop, fun P hP hle => hZ.eq_of_le ⟨P, hP, rfl⟩ hle⟩]
  apply minimal_iff_minimal_of_imp_of_forall
  · rintro _ ⟨P, hP, rfl⟩
    have := hP.isPrime
    exact of_prime P hP.le
  · intro U hU
    let P : Ideal (MvPolynomial S ℚ) := Ideal.span (X '' (U : Set S))
    have : P.IsPrime := span_X_image_isPrime (U : Set S)
    have hset : varSet P = U := varSet_span_X_image U
    have hIP : I ≤ P := (idealM_sup_prodIdeal_le_iff N P).mpr <|
      hset ▸ (isSiphon_iff_meets_complexes hocc hsc).mp hU
    obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_minimalPrimes_le hIP
    refine ⟨varSet Q, ?_, Q, hQ, rfl⟩
    rw [← hset]
    exact fun i hi => mem_varSet.mpr (hQP (mem_varSet.mp hi))

end WantedExt.Biology.Biophysics.SiphonPrimeDecompositionWanted
