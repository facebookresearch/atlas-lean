module

public import MathlibExt.LinearAlgebra.FlowsheetObservability
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.LinearAlgebra.Span.Basic

import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

/-! # Observability in a two-unit recycle flowsheet -/

@[expose] public section

namespace Chemistry.ProcessBalances

/-- **Two-unit recycle example.** Order the streams as `(f, u, r, p)`. The balances
are `f + r - u = 0` and `u - r - p = 0`, and the initial meters read `f` and `p`.
The kernel of the combined balance and meter map is the line generated by `(0, 1, 1, 0)`.
The recycle coordinate can vary without altering the data. For a strictly positive flow,
perturb by `t` along this direction with `|t| < min u r`: every stream stays positive
and the recycle coordinate changes whenever `t ≠ 0`. Adding a recycle meter makes
the combined map injective. -/
theorem two_unit_recycle_observability :
    let f : (Fin 4 → ℝ) →ₗ[ℝ] ℝ := LinearMap.proj 0
    let u : (Fin 4 → ℝ) →ₗ[ℝ] ℝ := LinearMap.proj 1
    let r : (Fin 4 → ℝ) →ₗ[ℝ] ℝ := LinearMap.proj 2
    let p : (Fin 4 → ℝ) →ₗ[ℝ] ℝ := LinearMap.proj 3
    let A := (f + r - u).prod (u - r - p)
    let H := f.prod p
    let M := A.prod H
    let k : Fin 4 → ℝ := ![0, 1, 1, 0]
    LinearMap.ker M = Submodule.span ℝ ({k} : Set (Fin 4 → ℝ)) ∧
      (∀ x, ∃ y, M y = M x ∧ r y ≠ r x) ∧
      (∀ (x : Fin 4 → ℝ) (t : ℝ), (∀ i, 0 < x i) → |t| < min (x 1) (x 2) →
        (∀ i, 0 < (x + t • k) i) ∧ M (x + t • k) = M x ∧
          (t ≠ 0 → r (x + t • k) ≠ r x)) ∧
      Function.Injective (M.prod r) := by
  intro f u r p A H M k
  have hzero (x : Fin 4 → ℝ) : M x = 0 ↔ x 0 = 0 ∧ x 3 = 0 ∧ x 1 = x 2 := by
    change ((x 0 + x 2 - x 1, x 1 - x 2 - x 3), (x 0, x 3)) =
      (((0, 0), (0, 0)) : (ℝ × ℝ) × (ℝ × ℝ)) ↔ _
    simp only [Prod.mk.injEq]
    constructor
    · rintro ⟨⟨h₁, _⟩, hf, hp⟩
      exact ⟨hf, hp, by linarith only [h₁, hf]⟩
    · rintro ⟨hf, hp, hu⟩
      exact ⟨⟨by linarith only [hf, hu], by linarith only [hp, hu]⟩, hf, hp⟩
  have hMk : M k = 0 := (hzero k).mpr (by norm_num [k])
  have hperturb (x : Fin 4 → ℝ) (t : ℝ) : M (x + t • k) = M x := by
    rw [map_add, map_smul, hMk, smul_zero, add_zero]
  have hchange (x : Fin 4 → ℝ) (t : ℝ) (ht : t ≠ 0) : r (x + t • k) ≠ r x := by
    change (x + t • k) 2 ≠ x 2
    simpa [k, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using ht
  refine ⟨?_, ?_, ?_, ?_⟩
  · ext x
    rw [LinearMap.mem_ker, hzero, Submodule.mem_span_singleton]
    constructor
    · rintro ⟨hf, hp, hu⟩
      refine ⟨x 2, ?_⟩
      funext i
      fin_cases i <;> simp [k, Pi.smul_apply, smul_eq_mul, hf, hp, hu]
    · rintro ⟨a, rfl⟩
      simp [k, Pi.smul_apply, smul_eq_mul]
  · intro x
    exact ⟨x + 1 • k, hperturb x 1, hchange x 1 one_ne_zero⟩
  · intro x t hx ht
    have h₁ : -x 1 < t :=
      lt_of_le_of_lt (neg_le_neg (min_le_left (x 1) (x 2))) (abs_lt.mp ht).1
    have h₂ : -x 2 < t :=
      lt_of_le_of_lt (neg_le_neg (min_le_right (x 1) (x 2))) (abs_lt.mp ht).1
    refine ⟨?_, hperturb x t, hchange x t⟩
    intro i
    fin_cases i
    · simpa [k, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using hx 0
    · have hpos : 0 < x 1 + t := by linarith only [h₁]
      simpa [k, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using hpos
    · have hpos : 0 < x 2 + t := by linarith only [h₂]
      simpa [k, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using hpos
    · simpa [k, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using hx 3
  · intro x y hxy
    have hMxy : M x = M y := congrArg Prod.fst hxy
    have hrxy : x 2 = y 2 := congrArg Prod.snd hxy
    have hsub : M (x - y) = 0 := by rw [map_sub, hMxy, sub_self]
    obtain ⟨hf, hp, hu⟩ := (hzero (x - y)).mp hsub
    simp only [Pi.sub_apply] at hf hp hu
    funext i
    fin_cases i
    · exact sub_eq_zero.mp hf
    · exact sub_eq_zero.mp (hu.trans (sub_eq_zero.mpr hrxy))
    · exact hrxy
    · exact sub_eq_zero.mp hp

end Chemistry.ProcessBalances
