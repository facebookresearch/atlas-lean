module

public import MathlibExt.Combinatorics.Graph.ArcNetworkLaplacian
public import PhyslibExt.Circuits.LinearMNAStamping

/-!
# Grounded nodal conductance of a resistor network

## i. Overview

In modified nodal analysis the resistor branches of a lumped
circuit stamp the nodal conductance matrix
`G = Br * diagonal (1 / R) * Brᵀ`, where `Br` holds the resistor
columns of the tail-positive incidence matrix. This module shows
that `G` is the weighted arc-network Laplacian of the resistor
branches with weights `1 / R`; the two sign flips of the
tail-positive incidence cancel. Consequently, when every
resistance is positive and the resistor branches connect all
nodes, deleting the row and column of any ground node leaves a
positive definite, hence invertible, conductance matrix: the
grounded nodal equations of a connected resistive network have a
unique solution. Non-resistor branches play no role here, and a
network whose resistor graph is disconnected is outside the
claim (its grounded conductance matrix can be singular).

## ii. Key results

- `nodalConductance_physicalIncidence_eq`: the nodal conductance
  matrix is the weighted Laplacian of the resistor arcs with
  weight `1 / R`.
- `nodalConductance_grounded_posDef`: positive resistances and a
  connected resistor graph make the ground-deleted nodal
  conductance matrix positive definite.
- `nodalConductance_grounded_isUnit`: the ground-deleted nodal
  conductance matrix is invertible.

## iii. Table of contents

- A. Conductance as a weighted Laplacian
- B. Grounded positive definiteness

## iv. References

- C. W. Ho, A. E. Ruehli, and P. A. Brennan, The modified nodal
  approach to network analysis, *IEEE Transactions on Circuits
  and Systems* 22(6), 1975, pp. 504-509: the nodal conductance
  stamp.
- B. Bollobás, *Modern Graph Theory*, Graduate Texts in
  Mathematics 184, Springer, 1998, Chapter II: electrical
  networks, grounded potentials and uniqueness of currents.
-/

@[expose] public section

namespace PhyslibExt.Circuits.GroundedNodalConductance

open Matrix MathlibExt.Combinatorics.Graph.ArcNetwork
  MathlibExt.Combinatorics.Graph.ArcNetworkLaplacian
  PhyslibExt.Circuits.LinearMNAStamping

/-! ### A. Conductance as a weighted Laplacian -/

/-- The nodal conductance stamped on the tail-positive incidence is
the weighted Laplacian of the resistor arcs with weight `1 / R`. -/
lemma nodalConductance_physicalIncidence_eq {nN nB : ℕ} (tail head : Fin nB → Fin nN)
    (Rset : Finset (Fin nB)) (Rval : Fin nB → ℝ) :
    nodalConductance (physicalIncidence tail head) Rset Rval =
      incidenceMatrix (fun e : Rset => tail e) (fun e : Rset => head e) *
        diagonal (fun e : Rset => (Rval e)⁻¹) *
        (incidenceMatrix (fun e : Rset => tail e) (fun e : Rset => head e))ᵀ := by
  have hB : resistorIncidence (physicalIncidence tail head) Rset =
      -incidenceMatrix (fun e : Rset => tail e) (fun e : Rset => head e) := by
    ext v e
    simp [resistorIncidence, physicalIncidence, incidenceMatrix]
  simp only [nodalConductance, hB, Matrix.neg_mul, Matrix.mul_neg, transpose_neg, neg_neg]

/-! ### B. Grounded positive definiteness -/

/-- The undirected graph on the nodes generated by the resistor
branches: two distinct nodes are adjacent when a resistor branch
joins them in either direction. -/
def resistorGraph {nN nB : ℕ} (tail head : Fin nB → Fin nN) (Rset : Finset (Fin nB)) :
    SimpleGraph (Fin nN) :=
  SimpleGraph.fromRel fun u v => ∃ e ∈ Rset, tail e = u ∧ head e = v

/-- **Grounded nodal conductance is positive definite.** Positive
resistances on the resistor branches and a connected resistor
graph make the nodal conductance matrix with the ground row and
column deleted positive definite. -/
theorem nodalConductance_grounded_posDef {nN nB : ℕ} (tail head : Fin nB → Fin nN)
    (Rset : Finset (Fin nB)) (Rval : Fin nB → ℝ) (hR : ∀ e ∈ Rset, 0 < Rval e)
    (ground : Fin nN) (hconn : (resistorGraph tail head Rset).Connected) :
    ((nodalConductance (physicalIncidence tail head) Rset Rval).submatrix
      (Subtype.val : {v // v ≠ ground} → Fin nN) Subtype.val).PosDef := by
  have hle : resistorGraph tail head Rset ≤
      positiveArcGraph (fun e : Rset => tail e) (fun e : Rset => head e)
        (fun e : Rset => (Rval e)⁻¹) := by
    intro a b hab
    simp only [resistorGraph, positiveArcGraph, SimpleGraph.fromRel_adj] at hab ⊢
    obtain ⟨hne, ⟨e, he, hta, hhb⟩ | ⟨e, he, htb, hha⟩⟩ := hab
    · exact ⟨hne, Or.inl ⟨⟨e, he⟩, inv_pos.mpr (hR e he), hta, hhb⟩⟩
    · exact ⟨hne, Or.inr ⟨⟨e, he⟩, inv_pos.mpr (hR e he), htb, hha⟩⟩
  rw [nodalConductance_physicalIncidence_eq]
  exact grounded_weightedLaplacian_posDef (fun e : Rset => tail e) (fun e : Rset => head e)
    (fun e : Rset => (Rval e)⁻¹) (fun e => (inv_pos.mpr (hR e.1 e.2)).le) ground
    fun v => (hconn.preconnected ground v).mono hle

/-- The grounded nodal conductance matrix is invertible under the
hypotheses of `nodalConductance_grounded_posDef`. -/
lemma nodalConductance_grounded_isUnit {nN nB : ℕ} (tail head : Fin nB → Fin nN)
    (Rset : Finset (Fin nB)) (Rval : Fin nB → ℝ) (hR : ∀ e ∈ Rset, 0 < Rval e)
    (ground : Fin nN) (hconn : (resistorGraph tail head Rset).Connected) :
    IsUnit ((nodalConductance (physicalIncidence tail head) Rset Rval).submatrix
      (Subtype.val : {v // v ≠ ground} → Fin nN) (Subtype.val : {v // v ≠ ground} → Fin nN)) :=
  (nodalConductance_grounded_posDef tail head Rset Rval hR ground hconn).isUnit

end PhyslibExt.Circuits.GroundedNodalConductance
