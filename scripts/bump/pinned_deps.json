{
  "toolchain_repo": "leanprover/lean4",
  "deps": [
    {
      "name": "mathlib",
      "repo": "leanprover-community/mathlib4"
    },
    {
      "name": "cslib",
      "repo": "leanprover/cslib"
    }
  ],
  "migration_ledgers": [
    "blueprint/migrations/AlgebraNotes.json",
    "blueprint/migrations/AlgebraNotesChecks.json"
  ],
  "doc_replacements": [
    {
      "path": "README.md",
      "pattern": "Lean-v[0-9]+\\.[0-9]+\\.[0-9]+",
      "replacement": "Lean-{target}"
    },
    {
      "path": "README.md",
      "pattern": "alt=\"Lean v[0-9]+\\.[0-9]+\\.[0-9]+\"",
      "replacement": "alt=\"Lean {target}\""
    },
    {
      "path": "README.md",
      "pattern": "lean4/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+",
      "replacement": "lean4/releases/tag/{target}"
    }
  ],
  "pin_policy": {
    "path": "scripts/check_lake_surface.py",
    "replacements": [
      {
        "pattern": "\"v[0-9]+\\.[0-9]+\\.[0-9]+\"",
        "replacement": "\"{target}\""
      },
      {
        "pattern": "(mathlib\\.get\\(\"rev\"\\) != \\(\\s*\")[0-9a-f]{40}(\")",
        "replacement": "{g1}{sha:mathlib}{g2}"
      },
      {
        "pattern": "(cslib\\.get\\(\"rev\"\\) != \\(\\s*\")[0-9a-f]{40}(\")",
        "replacement": "{g1}{sha:cslib}{g2}"
      }
    ]
  }
}
