def RlcTwoChannelFullPhysicalTwoArcBadTerminalPlacementAt {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {u x y : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support) : Prop :=
  ∃ ur vr ul vl : Site 2,
    ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
        gamma gamma' ur vr ∧
      s(ur, vr) ∈ (rlc_orderedContourArc c hx hy).edges ∧
      ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
        gamma gamma' ul vl ∧
      s(ul, vl) ∈ (rlc_complementaryContourArc c hx hy).edges ∧
      s(ur, vr) ≠ s(ul, vl)



theorem rlc_twoChannelFullPhysical_twoArcBadTerminalPlacement_of_firstBad
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {u x y : Site 2}
    {c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u}
    {hx : x ∈ c.support} {hy : y ∈ c.support}
    (hbad : RlcTwoChannelFullPhysicalTwoArcFirstBadAt
      gamma gamma' omega c hx hy) :
    RlcTwoChannelFullPhysicalTwoArcBadTerminalPlacementAt
      gamma gamma' omega c hx hy := by
  obtain ⟨ur, vr, ul, vl, qr, rr, ql, rl, hurv, hulv,
      hbadR, hdecR, hbadL, hdecL, hne⟩ := hbad
  refine ⟨ur, vr, ul, vl, hbadR, ?_, hbadL, ?_, hne⟩
  · rw [hdecR, SimpleGraph.Walk.edges_append]
    simp
  · have hrev : s(ul, vl) ∈
        (rlc_complementaryContourArc c hx hy).reverse.edges := by
      rw [hdecL, SimpleGraph.Walk.edges_append]
      simp
    simpa [SimpleGraph.Walk.edges_reverse] using hrev




def RlcTwoChannelFullPhysicalTwoArcClassifiedFirstBadAt {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {u x y : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support) : Prop :=
  ∃ (ur vr ul vl : Site 2)
    (qr : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk x ur)
    (rr : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk vr y)
    (ql : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk y ul)
    (rl : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk vl x)
    (hurv : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj ur vr)
    (hulv : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj ul vl),
    rlc_orderedContourArc c hx hy =
        (qr.mapLe (rlc_twoChannelFullPhysicalGoodBoundaryGraph_le
          gamma gamma' omega)).append (.cons hurv rr) ∧
      (rlc_complementaryContourArc c hx hy).reverse =
        (ql.mapLe (rlc_twoChannelFullPhysicalGoodBoundaryGraph_le
          gamma gamma' omega)).append (.cons hulv rl) ∧
      s(ur, vr) ≠ s(ul, vl) ∧
      ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
        gamma gamma' ur vr ∧
      ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
        gamma gamma' ul vl ∧
      (((¬RlcTwoChannelFullPhysicalTargetCarrierGeometry
            gamma gamma' ur vr) ∧
          (rlc_dualReflect ur ∈ rlc_connectorBarrier gamma gamma' ∨
            (rlc_dualReflect ur) 0 = -2 * n ∨
            (rlc_dualReflect ur) 0 = 2 * n ∨
            (rlc_dualReflect ur) 1 = -n ∨
            (rlc_dualReflect ur) 1 = n)) ∨
        ∃ p q : Site 2,
          sharedPrimalEdge ur vr = s(p, q) ∧
            (hypercubicLattice 2).Adj p q ∧
            p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
            q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
            (p ∈ rlc_connectorBarrier gamma gamma' ∨
              p 0 = -2 * n ∨ p 0 = 2 * n ∨
              p 1 = -n ∨ p 1 = n)) ∧
      (((¬RlcTwoChannelFullPhysicalTargetCarrierGeometry
            gamma gamma' ul vl) ∧
          (rlc_dualReflect ul ∈ rlc_connectorBarrier gamma gamma' ∨
            (rlc_dualReflect ul) 0 = -2 * n ∨
            (rlc_dualReflect ul) 0 = 2 * n ∨
            (rlc_dualReflect ul) 1 = -n ∨
            (rlc_dualReflect ul) 1 = n)) ∨
        ∃ p q : Site 2,
          sharedPrimalEdge ul vl = s(p, q) ∧
            (hypercubicLattice 2).Adj p q ∧
            p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
            q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
            (p ∈ rlc_connectorBarrier gamma gamma' ∨
              p 0 = -2 * n ∨ p 0 = 2 * n ∨
              p 1 = -n ∨ p 1 = n))



theorem rlc_twoChannelFullPhysical_faithful_twoArcClassifiedFirstBad
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {u x y : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hc : c.IsTrail) (hx : x ∈ c.support) (hy : y ∈ c.support)
    (hxPath : rlc_dualReflect x ∈ rlc_pathVertices gamma.1)
    (hyPath : rlc_dualReflect y ∈ rlc_pathVertices gamma'.1)
    (hbadSide : ¬RlcTwoChannelFullPhysicalContourArcSide
      gamma gamma' omega c hx hy) :
    RlcTwoChannelFullPhysicalTwoArcClassifiedFirstBadAt
        gamma gamma' omega c hx hy ∧
      ((x 0 = -1 ∧ x 1 < -1) ∨ x 0 < -1) ∧
      ((y 0 = -1 ∧ 0 ≤ y 1) ∨ 0 ≤ y 0) := by
  obtain ⟨ur, vr, ul, vl, qr, rr, ql, rl, hurv, hulv,
      hbadR, hdecR, hbadL, hdecL, hne⟩ :=
    rlc_twoChannelFullPhysical_twoArcFirstBad_of_not_contourArcSide
      gamma gamma' omega c hc hx hy hbadSide
  have hxBarrier : rlc_dualReflect x ∈
      rlc_connectorBarrier gamma gamma' := by
    simp [rlc_connectorBarrier, hxPath]
  have hyBarrier : rlc_dualReflect y ∈
      rlc_connectorBarrier gamma gamma' := by
    simp [rlc_connectorBarrier, hyPath]
  have hxBox : rlc_dualReflect x ∈ rlc_connectorBox n := by
    simpa [rlc_connectorBox] using
      (rlc_rightPathVertex_mem_connectorBox gamma hxPath)
  have hyBox : rlc_dualReflect y ∈ rlc_connectorBox n := by
    simpa [rlc_connectorBox] using
      (rlc_leftPathVertex_mem_connectorBox gamma' hyPath)
  have hclassR :
      ((¬RlcTwoChannelFullPhysicalTargetCarrierGeometry
          gamma gamma' ur vr) ∧
        (rlc_dualReflect ur ∈ rlc_connectorBarrier gamma gamma' ∨
          (rlc_dualReflect ur) 0 = -2 * n ∨
          (rlc_dualReflect ur) 0 = 2 * n ∨
          (rlc_dualReflect ur) 1 = -n ∨
          (rlc_dualReflect ur) 1 = n)) ∨
      ∃ p q : Site 2,
        sharedPrimalEdge ur vr = s(p, q) ∧
          (hypercubicLattice 2).Adj p q ∧
          p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
          q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
          (p ∈ rlc_connectorBarrier gamma gamma' ∨
            p 0 = -2 * n ∨ p 0 = 2 * n ∨
            p 1 = -n ∨ p 1 = n) := by
    rcases rlc_twoChannelFullPhysical_boundaryBad_target_or_sourceNotPlanar
        gamma gamma' omega hurv hbadR with htarget | hsource
    · exact Or.inl ⟨htarget,
        rlc_twoChannelFullPhysical_targetBad_near_barrier_or_boxBoundary
          hxBarrier hxBox qr hurv htarget⟩
    · exact Or.inr
        (rlc_twoChannelFullPhysical_sourceBad_inside_barrier_or_boxBoundary
          gamma gamma' omega hurv hsource)
  have hclassL :
      ((¬RlcTwoChannelFullPhysicalTargetCarrierGeometry
          gamma gamma' ul vl) ∧
        (rlc_dualReflect ul ∈ rlc_connectorBarrier gamma gamma' ∨
          (rlc_dualReflect ul) 0 = -2 * n ∨
          (rlc_dualReflect ul) 0 = 2 * n ∨
          (rlc_dualReflect ul) 1 = -n ∨
          (rlc_dualReflect ul) 1 = n)) ∨
      ∃ p q : Site 2,
        sharedPrimalEdge ul vl = s(p, q) ∧
          (hypercubicLattice 2).Adj p q ∧
          p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
          q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
          (p ∈ rlc_connectorBarrier gamma gamma' ∨
            p 0 = -2 * n ∨ p 0 = 2 * n ∨
            p 1 = -n ∨ p 1 = n) := by
    rcases rlc_twoChannelFullPhysical_boundaryBad_target_or_sourceNotPlanar
        gamma gamma' omega hulv hbadL with htarget | hsource
    · exact Or.inl ⟨htarget,
        rlc_twoChannelFullPhysical_targetBad_near_barrier_or_boxBoundary
          hyBarrier hyBox ql hulv htarget⟩
    · exact Or.inr
        (rlc_twoChannelFullPhysical_sourceBad_inside_barrier_or_boxBoundary
          gamma gamma' omega hulv hsource)
  refine ⟨?_, hfaith.dualFace_rightContact_position hxPath,
    hfaith.dualFace_leftContact_position hyPath⟩
  exact ⟨ur, vr, ul, vl, qr, rr, ql, rl, hurv, hulv,
    hdecR, hdecL, hne, hbadR, hbadL, hclassR, hclassL⟩





def RlcTwoChannelFullPhysicalTwoArcWallFamilyTruthTable {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {z x y ur ul : Site 2}
    (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2))
    (qr : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk x ur)
    (ql : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk y ul) : Prop :=
  ((∀ e ∈ qr.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma'.1) ∧
    rlc_dualReflect x = z ∧
    (∀ e ∈ ql.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma'.1) ∧
    rlc_dualReflect y = (gamma'.1.2.1 : Site 2)) ∨
  ((∀ e ∈ qr.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma'.1) ∧
    rlc_dualReflect x = z ∧
    (∀ e ∈ ql.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma.1) ∧
    ∃ r ∈ rlc_pathVertices gamma.1,
      rlc_dualReflect y = rlc_flipX r ∧ r ∈ flipLeft.support) ∨
  ((∀ e ∈ qr.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma.1) ∧
    rlc_dualReflect x = (gamma.1.1 : Site 2) ∧
    (∀ e ∈ ql.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma'.1) ∧
    rlc_dualReflect y = (gamma'.1.2.1 : Site 2)) ∨
  ((∀ e ∈ qr.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma.1) ∧
    rlc_dualReflect x = (gamma.1.1 : Site 2) ∧
    (∀ e ∈ ql.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma.1) ∧
    ∃ r ∈ rlc_pathVertices gamma.1,
      rlc_dualReflect y = rlc_flipX r ∧ r ∈ flipLeft.support)



theorem rlc_twoChannelFullPhysical_twoArcWallFamilyTruthTable
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {z x y ur ul : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2))
    (qr : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk x ur)
    (ql : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk y ul)
    (hxPath : rlc_dualReflect x ∈ rlc_pathVertices gamma.1)
    (hyPath : rlc_dualReflect y ∈ rlc_pathVertices gamma'.1)
    (hxOrder : rlc_flipX (rlc_dualReflect x) ∈
      (right.map rlc_flipXLatticeHom).support)
    (hyOrder : rlc_flipX (rlc_dualReflect y) ∈ flipLeft.support)
    (hfirst : ∀ w ∈ right.support,
      rlc_flipX w ∈ rlc_pathVertices gamma'.1 → w = z)
    (hallR : ∀ e ∈ qr.edges,
      Sym2.map rlc_dualReflect e ∈
        rlc_connectorFourTraceEdges gamma gamma')
    (hallL : ∀ e ∈ ql.edges,
      Sym2.map rlc_dualReflect e ∈
        rlc_connectorFourTraceEdges gamma gamma')
    (hurLoc :
      RlcTwoChannelFullPhysicalExclusiveReflectedLeftLocation
          gamma gamma' (rlc_dualReflect ur) ∨
        RlcTwoChannelFullPhysicalExclusiveReflectedRightLocation
          gamma gamma' (rlc_dualReflect ur))
    (hulLoc :
      RlcTwoChannelFullPhysicalExclusiveReflectedLeftLocation
          gamma gamma' (rlc_dualReflect ul) ∨
        RlcTwoChannelFullPhysicalExclusiveReflectedRightLocation
          gamma gamma' (rlc_dualReflect ul)) :
    RlcTwoChannelFullPhysicalTwoArcWallFamilyTruthTable
      gamma gamma' omega flipLeft qr ql := by
  have qrNotNil : ¬qr.Nil := by
    intro hnil
    have hxu : x = ur := hnil.eq
    rcases hurLoc with hurLeft | hurRight
    · exact hurLeft.2.2.1 (by simpa [← hxu] using hxPath)
    · exact hurRight.2.2.1 (by simpa [← hxu] using hxPath)
  have qlNotNil : ¬ql.Nil := by
    intro hnil
    have hyu : y = ul := hnil.eq
    rcases hulLoc with hulLeft | hulRight
    · exact hulLeft.2.2.2 (by simpa [← hyu] using hyPath)
    · exact hulRight.2.2.2 (by simpa [← hyu] using hyPath)
  rcases hurLoc with hurLeft | hurRight
  · have hqrLeft :=
      rlc_twoChannelFullPhysical_goodWallWalk_reflectedLeft_of_terminal
        hfaith qr qrNotNil hallR hurLeft.2.1
    have hxz :=
      rlc_twoChannelFullPhysical_orderedRightContact_reflectedLeft_start_eq
        right qr hxOrder hfirst hqrLeft hurLeft.2.1
    rcases hulLoc with hulLeft | hulRight
    · have hqlLeft :=
        rlc_twoChannelFullPhysical_goodWallWalk_reflectedLeft_of_terminal
          hfaith ql qlNotNil hallL hulLeft.2.1
      have hyAxis :=
        rlc_twoChannelFullPhysical_leftContact_reflectedLeft_start_eq_axis
          hfaith ql hyPath hqlLeft hulLeft.2.1
      exact Or.inl ⟨hqrLeft, hxz, hqlLeft, hyAxis⟩
    · have hqlRight :=
        rlc_twoChannelFullPhysical_goodWallWalk_reflectedRight_of_terminal
          hfaith ql qlNotNil hallL hulRight.2.1
      have hyReflected :=
        rlc_twoChannelFullPhysical_reflectedRightWalk_start
          ql hqlRight hulRight.2.1
      obtain ⟨r, hr, hyr⟩ := hyReflected
      have hrSuffix : r ∈ flipLeft.support := by
        rw [hyr] at hyOrder
        simpa using hyOrder
      exact Or.inr (Or.inl
        ⟨hqrLeft, hxz, hqlRight, r, hr, hyr, hrSuffix⟩)
  · have hqrRight :=
      rlc_twoChannelFullPhysical_goodWallWalk_reflectedRight_of_terminal
        hfaith qr qrNotNil hallR hurRight.2.1
    have hxAxis :=
      rlc_twoChannelFullPhysical_rightContact_reflectedRight_start_eq_axis
        hfaith qr hxPath hqrRight hurRight.2.1
    rcases hulLoc with hulLeft | hulRight
    · have hqlLeft :=
        rlc_twoChannelFullPhysical_goodWallWalk_reflectedLeft_of_terminal
          hfaith ql qlNotNil hallL hulLeft.2.1
      have hyAxis :=
        rlc_twoChannelFullPhysical_leftContact_reflectedLeft_start_eq_axis
          hfaith ql hyPath hqlLeft hulLeft.2.1
      exact Or.inr (Or.inr (Or.inl
        ⟨hqrRight, hxAxis, hqlLeft, hyAxis⟩))
    · have hqlRight :=
        rlc_twoChannelFullPhysical_goodWallWalk_reflectedRight_of_terminal
          hfaith ql qlNotNil hallL hulRight.2.1
      have hyReflected :=
        rlc_twoChannelFullPhysical_reflectedRightWalk_start
          ql hqlRight hulRight.2.1
      obtain ⟨r, hr, hyr⟩ := hyReflected
      have hrSuffix : r ∈ flipLeft.support := by
        rw [hyr] at hyOrder
        simpa using hyOrder
      exact Or.inr (Or.inr (Or.inr
        ⟨hqrRight, hxAxis, hqlRight, r, hr, hyr, hrSuffix⟩))




theorem rlc_twoChannelFullPhysical_twoArc_oppositeAxisWall_end_mem_suffixes_at
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    (hnoGood : ¬RlcTwoChannelFullPhysicalGoodComponentContacts
      gamma gamma' omega)
    {z x y ur ul : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (qr : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk x ur)
    (ql : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk y ul)
    (hxAxis : rlc_dualReflect x = (gamma.1.1 : Site 2))
    (hyAxis : rlc_dualReflect y = (gamma'.1.2.1 : Site 2))
    (hqrRight : ∀ e ∈ qr.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma.1)
    (hqlLeft : ∀ e ∈ ql.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma'.1) :
    ∃ (hzR : rlc_flipX z ∈
        (((rlc_ambientCrossingWalk gamma.1).map
          rlc_flipXLatticeHom).reverse).support)
      (hzL : z ∈ ((rlc_ambientCrossingWalk gamma'.1).map
        rlc_flipXLatticeHom).support),
      rlc_dualReflect ur ∈
          ((((rlc_ambientCrossingWalk gamma.1).map
            rlc_flipXLatticeHom).reverse).dropUntil
              (rlc_flipX z) hzR).support ∧
        rlc_dualReflect ul ∈
          (((rlc_ambientCrossingWalk gamma'.1).map
            rlc_flipXLatticeHom).dropUntil z hzL).support := by
  obtain ⟨hzR, hur⟩ :=
    rlc_twoChannelFullPhysical_reflectedRightAxisWalk_end_mem_suffix_at
      hnoGood z hzRight hzLeft qr hxAxis hqrRight
  obtain ⟨hzL, hul⟩ :=
