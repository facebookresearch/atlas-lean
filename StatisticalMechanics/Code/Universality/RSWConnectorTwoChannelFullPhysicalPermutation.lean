theorem rlc_twoChannelFullPhysical_visibleSource_closed_of_crosses_reachSet
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma')
    {u v : RlcConnectorVertex n}
    (hsource : source.1.1 = s(u, v))
    (hcross :
      (u ∈ rlc_twoChannelFullPhysicalVisibleRightReachSet
          gamma gamma' omega ∧
        v ∉ rlc_twoChannelFullPhysicalVisibleRightReachSet
          gamma gamma' omega) ∨
      (v ∈ rlc_twoChannelFullPhysicalVisibleRightReachSet
          gamma gamma' omega ∧
        u ∉ rlc_twoChannelFullPhysicalVisibleRightReachSet
          gamma gamma' omega)) :
    omega source.1 = false := by
  have hbase : (rlc_connectorTwoChannelGraph gamma gamma').Adj u v := by
    rw [← SimpleGraph.mem_edgeSet, ← hsource]
    exact source.1.2
  obtain ⟨target, htarget⟩ := source.2
  have hvisible :
      (rlc_twoChannelFullPhysicalVisibleSourceGraph
        gamma gamma').Adj u v := by
    refine ⟨hbase, target, ?_⟩
    exact (congrArg Subtype.val htarget).trans hsource
  have hextend : rlc_twoChannelEdgeConfigExtend gamma gamma' omega
      source.1.1 = omega source.1 := by
    simp [rlc_twoChannelEdgeConfigExtend, rlc_twoChannelConfigSplitEquiv,
      source.1.2]
  cases hs : omega source.1 with
  | false => rfl
  | true =>
      exfalso
      have hopen :
          (FK.openSub
            (rlc_twoChannelFullPhysicalVisibleSourceGraph gamma gamma')
            (rlc_twoChannelEdgeConfigExtend gamma gamma' omega)).Adj u v := by
        rw [FK.openSub_adj]
        refine ⟨hvisible, ?_⟩
        rw [← hsource, hextend, hs]
      rcases hcross with ⟨hu, hv⟩ | ⟨hv, hu⟩
      · obtain ⟨x, hx, hxu⟩ := hu
        exact hv ⟨x, hx, hxu.trans hopen.reachable⟩
      · obtain ⟨x, hx, hxv⟩ := hv
        exact hu ⟨x, hx, hxv.trans hopen.symm.reachable⟩



noncomputable def rlc_twoChannelFullPhysicalCutTargetGraphAt {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n)) :
    SimpleGraph (RlcConnectorVertex n) where
  Adj x y := ∃ target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma',
    target.1.1 = s(x, y) ∧
      ∃ u v : RlcConnectorVertex n,
        (rlc_twoChannelFullPhysicalSourceEdge target).1 = s(u, v) ∧
          ((u ∈ A ∧ v ∉ A) ∨ (v ∈ A ∧ u ∉ A))
  symm := by
    rintro x y ⟨target, htarget, u, v, hsource, hcross⟩
    refine ⟨target, ?_, u, v, hsource, hcross⟩
    simpa [Sym2.eq_swap] using htarget
  loopless := ⟨fun x hxx => by
    obtain ⟨target, htarget, _u, _v, _hsource, _hcross⟩ := hxx
    have hbase : (rlc_connectorTwoChannelGraph gamma gamma').Adj x x := by
      rw [← SimpleGraph.mem_edgeSet, ← htarget]
      exact target.1.2
    exact hbase.ne rfl⟩



noncomputable def rlc_twoChannelFullPhysicalLiftVertexCut {n : Int}
    (A : Set (RlcConnectorVertex n)) : Set (Site 2) :=
  {z | ∃ hz : z ∈ rect (-2 * n) (2 * n) (-n) n,
    (⟨z, hz⟩ : RlcConnectorVertex n) ∈ A}

@[simp] theorem rlc_twoChannelFullPhysicalLiftVertexCut_mem {n : Int}
    (A : Set (RlcConnectorVertex n)) (x : RlcConnectorVertex n) :
    x.1 ∈ rlc_twoChannelFullPhysicalLiftVertexCut A ↔ x ∈ A := by
  constructor
  · rintro ⟨hx, hmem⟩
    have heq : (⟨x.1, hx⟩ : RlcConnectorVertex n) = x := Subtype.ext rfl
    simpa [heq] using hmem
  · intro hx
    exact ⟨x.2, by simpa using hx⟩



theorem rlc_twoChannel_traceWiring_not_crosses_staticCut {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n))
    (hAright : ∀ x, rlc_connectorOnRight gamma x → x ∈ A)
    (hAleft : ∀ y, rlc_connectorOnLeft gamma' y → y ∉ A)
    {u v : RlcConnectorVertex n}
    (htrace : (rlc_connectorTraceWiring gamma gamma').Adj u v) :
    ¬((u ∈ A ∧ v ∉ A) ∨ (v ∈ A ∧ u ∉ A)) := by
  rcases Finset.mem_union.mp htrace.2 with hright | hleft
  · have hends := rlc_pathEdge_endpoints_mem_vertices gamma.1 hright
    have hu : rlc_connectorOnRight gamma u := hends.1
    have hv : rlc_connectorOnRight gamma v := hends.2
    have := hAright u hu
    have := hAright v hv
    tauto
  · have hends := rlc_pathEdge_endpoints_mem_vertices gamma'.1 hleft
    have hu : rlc_connectorOnLeft gamma' u := hends.1
    have hv : rlc_connectorOnLeft gamma' v := hends.2
    have := hAleft u hu
    have := hAleft v hv
    tauto



theorem rlc_twoChannel_augmented_crossing_mem_twoChannel {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n))
    (hAright : ∀ x, rlc_connectorOnRight gamma x → x ∈ A)
    (hAleft : ∀ y, rlc_connectorOnLeft gamma' y → y ∉ A)
    {u v : RlcConnectorVertex n}
    (haug : (rlc_connectorTwoChannelAugmentedPlanarDomain
      gamma gamma').G.Adj u v)
    (hcross : (u ∈ A ∧ v ∉ A) ∨ (v ∈ A ∧ u ∉ A)) :
    (rlc_connectorTwoChannelGraph gamma gamma').Adj u v := by
  rcases haug with htwo | htrace
  · exact htwo
  · exact (rlc_twoChannel_traceWiring_not_crosses_staticCut
      gamma gamma' A hAright hAleft htrace hcross).elim



theorem rlc_twoChannelFullPhysicalCutTargetGraphAt_adj_iff_faceBoundary
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n)) (x y : RlcConnectorVertex n) :
    (rlc_twoChannelFullPhysicalCutTargetGraphAt gamma gamma' A).Adj x y ↔
      ∃ target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma',
        target.1.1 = s(x, y) ∧
          (faceBoundaryGraph
            (rlc_twoChannelFullPhysicalLiftVertexCut A)).Adj
              (rlc_dualReflect.symm x.1)
              (rlc_dualReflect.symm y.1) := by
  constructor
  · rintro ⟨target, htarget, u, v, hsource, hcross⟩
    refine ⟨target, htarget, ?_⟩
    rw [faceBoundaryGraph_adj]
    have hxy : (hypercubicLattice 2).Adj x.1 y.1 := by
      have hG : (rlc_connectorTwoChannelGraph gamma gamma').Adj x y := by
        rw [← SimpleGraph.mem_edgeSet, ← htarget]
        exact target.1.2
      exact hG.1.elim (fun h => h.1) (fun h => h.1)
    have hfg : (hypercubicLattice 2).Adj
        (rlc_dualReflect.symm x.1) (rlc_dualReflect.symm y.1) := by
      simpa using (rlc_adj_dualReflect
        (rlc_dualReflect.symm x.1) (rlc_dualReflect.symm y.1)).mpr
          (by simpa using hxy)
    refine ⟨hfg, ?_⟩
    have hpims : rlc_pimsEdgeEquiv (s(x.1, y.1)) =
        sharedPrimalEdge (rlc_dualReflect.symm x.1)
          (rlc_dualReflect.symm y.1) := by
      simpa using rlc_pimsEdgeEquiv_reflected_mk_of_adj hfg
    have hsourceSite :
        s(u.1, v.1) = sharedPrimalEdge (rlc_dualReflect.symm x.1)
          (rlc_dualReflect.symm y.1) := by
      calc
        s(u.1, v.1) =
            (rlc_twoChannelFullPhysicalSourceEdge target).1.map Subtype.val := by
          rw [hsource, Sym2.map_mk]
        _ = rlc_pimsEdgeEquiv (target.1.1.map Subtype.val) :=
          rlc_twoChannelFullPhysicalSourceEdge_map target
        _ = rlc_pimsEdgeEquiv (s(x.1, y.1)) := by
          rw [htarget, Sym2.map_mk]
        _ = _ := hpims
    rw [← hsourceSite, bdEdge_mk,
      rlc_twoChannelFullPhysicalLiftVertexCut_mem,
      rlc_twoChannelFullPhysicalLiftVertexCut_mem]
    rcases hcross with h | h <;> tauto
  · rintro ⟨target, htarget, hface⟩
    let source := rlc_twoChannelFullPhysicalSourceEdge target
    induction hsourceEdge : source.1 using Sym2.inductionOn with
    | _ u v =>
        refine ⟨target, htarget, u, v, hsourceEdge, ?_⟩
        rw [faceBoundaryGraph_adj] at hface
        have hpims : rlc_pimsEdgeEquiv (s(x.1, y.1)) =
            sharedPrimalEdge (rlc_dualReflect.symm x.1)
              (rlc_dualReflect.symm y.1) := by
          simpa using rlc_pimsEdgeEquiv_reflected_mk_of_adj hface.1
        have hsourceSite : s(u.1, v.1) =
            sharedPrimalEdge (rlc_dualReflect.symm x.1)
              (rlc_dualReflect.symm y.1) := by
          calc
            s(u.1, v.1) = source.1.map Subtype.val := by
              rw [hsourceEdge, Sym2.map_mk]
            _ = rlc_pimsEdgeEquiv (target.1.1.map Subtype.val) :=
              rlc_twoChannelFullPhysicalSourceEdge_map target
            _ = rlc_pimsEdgeEquiv (s(x.1, y.1)) := by
              rw [htarget, Sym2.map_mk]
            _ = _ := hpims
        have hbd := hface.2
        rw [← hsourceSite, bdEdge_mk,
          rlc_twoChannelFullPhysicalLiftVertexCut_mem,
          rlc_twoChannelFullPhysicalLiftVertexCut_mem] at hbd
        tauto




noncomputable def rlc_twoChannelFullPhysicalVisibleCutTargetGraph {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    SimpleGraph (RlcConnectorVertex n) :=
  rlc_twoChannelFullPhysicalCutTargetGraphAt gamma gamma'
    (rlc_twoChannelFullPhysicalVisibleRightReachSet gamma gamma' omega)

noncomputable instance
    rlc_twoChannelFullPhysicalVisibleCutTargetGraphDecidableAdj
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    DecidableRel
      (rlc_twoChannelFullPhysicalVisibleCutTargetGraph
        gamma gamma' omega).Adj :=
  Classical.decRel _

theorem rlc_twoChannelFullPhysicalVisibleCutTargetGraph_le_variable
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    rlc_twoChannelFullPhysicalVisibleCutTargetGraph gamma gamma' omega ≤
      rlc_twoChannelFullVariableGraph gamma gamma' := by
  intro x y hxy
  obtain ⟨target, htarget, _u, _v, _hsource, _hcross⟩ := hxy
  constructor
  · rw [← SimpleGraph.mem_edgeSet, ← htarget]
    exact target.1.2
  · simpa [← htarget] using target.2



theorem rlc_twoChannelFullPhysicalVisibleCutTargetGraph_le_open
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    rlc_twoChannelFullPhysicalVisibleCutTargetGraph gamma gamma' omega ≤
      FK.openSub (rlc_connectorTwoChannelGraph gamma gamma')
        (rlc_twoChannelEdgeConfigExtend gamma gamma'
          (rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega)) := by
  intro x y hxy
  obtain ⟨target, htarget, u, v, hsource, hcross⟩ := hxy
  let source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma' :=
    ⟨rlc_twoChannelFullPhysicalSourceEdge target, ⟨target, rfl⟩⟩
  have hclosed : omega source.1 = false :=
    rlc_twoChannelFullPhysical_visibleSource_closed_of_crosses_reachSet
      omega source hsource hcross
  have hopenTarget :
      rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega target.1 =
        true := by
    rw [rlc_twoChannelFullPhysicalPermConfig,
      rlc_twoChannelFullPhysicalEdgePerm_physical]
    rw [show rlc_twoChannelFullPhysicalSourceEdge target = source.1 by rfl]
    rw [hclosed]
    rfl
  rw [FK.openSub_adj]
  constructor
  · rw [← SimpleGraph.mem_edgeSet, ← htarget]
    exact target.1.2
  · have hmem : s(x, y) ∈
        (rlc_connectorTwoChannelGraph gamma gamma').edgeSet := by
      rw [← htarget]
      exact target.1.2
    change (if h : s(x, y) ∈
        (rlc_connectorTwoChannelGraph gamma gamma').edgeSet then
      rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega
        ⟨s(x, y), h⟩ else false) = true
    rw [dif_pos hmem]
    have heq : (⟨s(x, y), hmem⟩ :
        (rlc_connectorTwoChannelGraph gamma gamma').edgeSet) =
        target.1 := Subtype.ext htarget.symm
    rw [heq]
    exact hopenTarget



theorem rlc_twoChannelFullPhysicalVisibleCutTargetGraph_le_openFullDual
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    rlc_twoChannelFullPhysicalVisibleCutTargetGraph gamma gamma' omega ≤
      FK.openSub (rlc_twoChannelFullVariableGraph gamma gamma')
        (rlc_twoChannelFullDualConfig gamma gamma' omega) := by
  intro x y hxy
  have hvariable :=
    rlc_twoChannelFullPhysicalVisibleCutTargetGraph_le_variable
      gamma gamma' omega hxy
  obtain ⟨target, htarget, u, v, hsource, hcross⟩ := hxy
  let source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma' :=
    ⟨rlc_twoChannelFullPhysicalSourceEdge target, ⟨target, rfl⟩⟩
  have hclosed : omega source.1 = false :=
    rlc_twoChannelFullPhysical_visibleSource_closed_of_crosses_reachSet
      omega source hsource hcross
  rw [FK.openSub_adj]
  constructor
  · exact hvariable
  · have hopen : rlc_twoChannelFullDualConfig gamma gamma' omega
        target.1 = true := by
      rw [rlc_twoChannelFullDualConfig_of_source gamma gamma' omega
        target.1 (rlc_twoChannelFullPhysicalSourceEdge target)
        (rlc_twoChannelFullPhysicalSourceEdge_map target)]
      rw [show rlc_twoChannelFullPhysicalSourceEdge target = source.1 by rfl]
      rw [hclosed]
      rfl
    simpa [← htarget] using hopen


def RlcTwoChannelFullPhysicalVisibleCutTargetConnectorSuccess {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') : Prop :=
  ∃ x y : RlcConnectorVertex n,
    rlc_connectorOnRight gamma x ∧ rlc_connectorOnLeft gamma' y ∧
      (rlc_twoChannelFullPhysicalVisibleCutTargetGraph
        gamma gamma' omega).Reachable x y

theorem rlc_twoChannelFullPhysicalPermConfig_success_of_visibleCutTarget
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hcut : RlcTwoChannelFullPhysicalVisibleCutTargetConnectorSuccess
      gamma gamma' omega) :
    rlc_twoChannelEdgeConfigExtend gamma gamma'
        (rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega) ∈
      rlc_finiteTwoChannelConnectorEvent gamma gamma' := by
  obtain ⟨x, y, hx, hy, hxy⟩ := hcut
  exact ⟨x, y, hx, hy, hxy.mono
    (rlc_twoChannelFullPhysicalVisibleCutTargetGraph_le_open
      gamma gamma' omega)⟩

theorem rlc_twoChannelFullVariableConnectorSuccess_of_visibleCutTarget
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hcut : RlcTwoChannelFullPhysicalVisibleCutTargetConnectorSuccess
      gamma gamma' omega) :
    RlcTwoChannelFullVariableConnectorSuccess gamma gamma' omega := by
  obtain ⟨x, y, hx, hy, hxy⟩ := hcut
  exact ⟨x, y, hx, hy, hxy.mono
    (rlc_twoChannelFullPhysicalVisibleCutTargetGraph_le_openFullDual
      gamma gamma' omega)⟩





theorem rlc_reachable_between_of_odd_degree_blocks
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (R L : V → Prop) [DecidablePred R]
    (hoddSupport : ∀ v, Odd (G.degree v) → R v ∨ L v)
    (hRodd : Odd (Fintype.card {v : V // R v ∧ Odd (G.degree v)})) :
    ∃ r l, R r ∧ L l ∧ G.Reachable r l := by
  classical
  by_contra hno
  let S : Set V := {v | ∃ r, R r ∧ G.Reachable r v}
  have hSL : ∀ {v}, v ∈ S → ¬L v := by
    rintro v ⟨r, hr, hrv⟩ hvL
    exact hno ⟨r, v, hr, hvL, hrv⟩
  have hdegree : ∀ v : S, (G.induce S).degree v = G.degree v := by
    intro v
    apply degree_induce_of_neighborSet_subset
    intro w hw
    rw [SimpleGraph.mem_neighborSet] at hw
    obtain ⟨r, hr, hrv⟩ := v.2
    exact ⟨r, hr, hrv.trans hw.reachable⟩
  let oddEquiv :
      {v : S // Odd ((G.induce S).degree v)} ≃
        {v : V // R v ∧ Odd (G.degree v)} :=
    { toFun := fun v => ⟨v.1.1, by
        have hvOdd : Odd (G.degree v.1.1) := by
          rw [← hdegree v.1]
          exact v.2
        refine ⟨?_, hvOdd⟩
        rcases hoddSupport v.1.1 hvOdd with hvR | hvL
        · exact hvR
        · exact (hSL v.1.2 hvL).elim⟩
      invFun := fun v => ⟨⟨v.1, ⟨v.1, v.2.1, Reachable.refl _⟩⟩, by
        rw [hdegree]
        exact v.2.2⟩
      left_inv := fun v => by
        apply Subtype.ext
        apply Subtype.ext
        rfl
      right_inv := fun v => by
        apply Subtype.ext
        rfl }
  have hEven := SimpleGraph.even_card_odd_degree_vertices (G.induce S)
  rw [← Fintype.card_subtype (fun v : S =>
    Odd ((G.induce S).degree v))] at hEven
  have hcard : Fintype.card {v : S // Odd ((G.induce S).degree v)} =
      Fintype.card {v : V // R v ∧ Odd (G.degree v)} :=
    Fintype.card_congr oddEquiv
  rw [hcard] at hEven
  exact (Nat.not_even_iff_odd.mpr hRodd) hEven



noncomputable def rlc_twoChannelFullPhysicalCutInteriorConfig {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n)) :
    RlcTwoChannelEdgeConfig gamma gamma' := by
  classical
  exact fun e => decide (∀ u v : RlcConnectorVertex n,
    e.1 = s(u, v) → u ∈ A ∧ v ∈ A)

@[simp] theorem rlc_twoChannelFullPhysicalCutInteriorConfig_true_iff
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n))
    (e : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet) :
    rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A e = true ↔
      ∀ u v : RlcConnectorVertex n,
        e.1 = s(u, v) → u ∈ A ∧ v ∈ A := by
  classical
  simp [rlc_twoChannelFullPhysicalCutInteriorConfig]



theorem rlc_twoChannelFullPhysicalCutInteriorConfig_failure
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (A : Set (RlcConnectorVertex n))
    (hAright : ∀ x, rlc_connectorOnRight gamma x → x ∈ A)
    (hAleft : ∀ y, rlc_connectorOnLeft gamma' y → y ∉ A) :
    rlc_twoChannelEdgeConfigExtend gamma gamma'
        (rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A) ∉
      rlc_finiteTwoChannelConnectorEvent gamma gamma' := by
  rintro ⟨x, y, hx, hy, hxy⟩
  obtain ⟨w⟩ := hxy
  obtain ⟨u, v, huv, hu, hv⟩ :=
    rlc_walk_pred_first_exit w (fun z ↦ z ∈ A)
      (hAright x hx) (hAleft y hy)
  have hopen := w.adj_of_mem_edges huv
  rw [FK.openSub_adj] at hopen
  have hextend : rlc_twoChannelEdgeConfigExtend gamma gamma'
      (rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A)
      s(u, v) = rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A
        ⟨s(u, v), hopen.1⟩ := by
    simp [rlc_twoChannelEdgeConfigExtend, rlc_twoChannelConfigSplitEquiv,
      hopen.1]
  have htrue : rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A
      ⟨s(u, v), hopen.1⟩ = true := by
    rw [← hextend]
    exact hopen.2
  have hends :=
    (rlc_twoChannelFullPhysicalCutInteriorConfig_true_iff gamma gamma' A
      ⟨s(u, v), hopen.1⟩).mp htrue u v rfl
  exact hv hends.2



def RlcTwoChannelFullPhysicalStaticCutConnectivity {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (_hfaith : RlcBookFaithfulTracePair gamma gamma') : Prop :=
  ∀ A : Set (RlcConnectorVertex n),
    (∀ x : RlcConnectorVertex n,
      rlc_connectorOnRight gamma x → x ∈ A) →
    (∀ y : RlcConnectorVertex n,
      rlc_connectorOnLeft gamma' y → y ∉ A) →
    ∃ x y : RlcConnectorVertex n,
      rlc_connectorOnRight gamma x ∧ rlc_connectorOnLeft gamma' y ∧
        (rlc_twoChannelFullPhysicalCutTargetGraphAt
          gamma gamma' A).Reachable x y



def RlcTwoChannelFullPhysicalStaticCutIntersection {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (_hfaith : RlcBookFaithfulTracePair gamma gamma') : Prop :=
  ∀ A B : Set (RlcConnectorVertex n),
    (∀ x : RlcConnectorVertex n,
      rlc_connectorOnRight gamma x → x ∈ A) →
    (∀ y : RlcConnectorVertex n,
      rlc_connectorOnLeft gamma' y → y ∉ A) →
    (∀ x : RlcConnectorVertex n,
      rlc_connectorOnRight gamma x → x ∈ B) →
    (∀ y : RlcConnectorVertex n,
      rlc_connectorOnLeft gamma' y → y ∉ B) →
    ∃ (target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma')
      (x y u v : RlcConnectorVertex n),
      target.1.1 = s(x, y) ∧
        (rlc_twoChannelFullPhysicalSourceEdge target).1 = s(u, v) ∧
        ((u ∈ A ∧ v ∉ A) ∨ (v ∈ A ∧ u ∉ A)) ∧
        ((x ∈ B ∧ y ∉ B) ∨ (y ∈ B ∧ x ∉ B))


def rlc_twoChannelFullPhysicalEdgeCrossesCut {V : Type*}
    (A : Set V) (e : Sym2 V) : Prop :=
  ∃ u v : V, e = s(u, v) ∧
    ((u ∈ A ∧ v ∉ A) ∨ (v ∈ A ∧ u ∉ A))



def PairedEdgeCutIntersection {V I : Type*}
    (source target : I → Sym2 V) (R L : Set V) : Prop :=
  ∀ A B : Set V,
    R ⊆ A → L ∩ A = ∅ → R ⊆ B → L ∩ B = ∅ →
      ∃ i : I, rlc_twoChannelFullPhysicalEdgeCrossesCut A (source i) ∧
        rlc_twoChannelFullPhysicalEdgeCrossesCut B (target i)



def PairedEdgeMonochromatic {V : Type*} (A : Set V) (e : Sym2 V) : Prop :=
  ∀ u v : V, e = s(u, v) → (u ∈ A ↔ v ∈ A)

theorem rlc_twoChannelFullPhysical_not_crossesCut_iff_monochromatic
    {V : Type*} (A : Set V) (e : Sym2 V) :
    ¬rlc_twoChannelFullPhysicalEdgeCrossesCut A e ↔
      PairedEdgeMonochromatic A e := by
  induction e using Sym2.inductionOn with
  | _ u v =>
      simp only [rlc_twoChannelFullPhysicalEdgeCrossesCut,
        PairedEdgeMonochromatic, Sym2.eq_iff]
      constructor
      · intro h a b hab
        have huv : u ∈ A ↔ v ∈ A := by
          have hsep : ¬((u ∈ A ∧ v ∉ A) ∨ (v ∈ A ∧ u ∉ A)) := by
            intro hcross
            exact h ⟨u, v, Or.inl ⟨rfl, rfl⟩, hcross⟩
          tauto
        rcases hab with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · exact huv
        · exact huv.symm
      · intro h hcross
        obtain ⟨a, b, hab, hsep⟩ := hcross
        have hm := h a b hab
        rcases hsep with ⟨ha, hb⟩ | ⟨hb, ha⟩
        · exact hb (hm.mp ha)
        · exact ha (hm.mpr hb)




def PairedEdgeTwoColorHexAlternative {V I : Type*}
    (source target : I → Sym2 V) (R L : Set V) : Prop :=
  ∀ A B : Set V,
    R ⊆ A → L ∩ A = ∅ → R ⊆ B → L ∩ B = ∅ →
      ¬∀ i : I, PairedEdgeMonochromatic A (source i) ∨
        PairedEdgeMonochromatic B (target i)

theorem pairedEdgeCutIntersection_iff_twoColorHexAlternative
    {V I : Type*} (source target : I → Sym2 V) (R L : Set V) :
    PairedEdgeCutIntersection source target R L ↔
      PairedEdgeTwoColorHexAlternative source target R L := by
  classical
  constructor
  · intro hintersect A B hRA hLA hRB hLB hmono
    obtain ⟨i, hsource, htarget⟩ :=
      hintersect A B hRA hLA hRB hLB
    rcases hmono i with hsourceMono | htargetMono
    · exact
        (rlc_twoChannelFullPhysical_not_crossesCut_iff_monochromatic
          A (source i)).mpr hsourceMono hsource
    · exact
        (rlc_twoChannelFullPhysical_not_crossesCut_iff_monochromatic
          B (target i)).mpr htargetMono htarget
  · intro hhex A B hRA hLA hRB hLB
    by_contra hintersect
    apply hhex A B hRA hLA hRB hLB
    intro i
    have hi : ¬(rlc_twoChannelFullPhysicalEdgeCrossesCut A (source i) ∧
        rlc_twoChannelFullPhysicalEdgeCrossesCut B (target i)) := by
      intro hboth
      exact hintersect ⟨i, hboth⟩
    rcases not_and_or.mp hi with hsource | htarget
    · exact Or.inl
        ((rlc_twoChannelFullPhysical_not_crossesCut_iff_monochromatic
          A (source i)).mp hsource)
    · exact Or.inr
        ((rlc_twoChannelFullPhysical_not_crossesCut_iff_monochromatic
          B (target i)).mp htarget)




structure PairedEdgeHexCutCarrier {V I : Type*}
    (source target : I → Sym2 V) (A B : Set V) where
  alpha : Int
  beta : Int
  bottomRow : Int
  topRow : Int
  bottomX : Int
  topX : Int
  alpha_lt_beta : alpha < beta
  bottomRow_le_topRow : bottomRow ≤ topRow
  bottomX_lower : alpha ≤ bottomX
  bottomX_upper : bottomX ≤ beta
  topX_lower : alpha ≤ topX
  topX_upper : topX ≤ beta
  vertical : (hypercubicLattice 2).Walk
    ![bottomX, bottomRow] ![topX, topRow]
  vertical_mem : ∀ z ∈ vertical.support,
    z ∈ rect alpha beta bottomRow topRow
  horizontalStart : Site 2
  horizontalEnd : Site 2
  horizontalStart_mem : horizontalStart ∈ rect alpha beta bottomRow topRow
  horizontalEnd_mem : horizontalEnd ∈ rect alpha beta bottomRow topRow
  horizontalStart_left : horizontalStart 0 = alpha
  horizontalEnd_right : horizontalEnd 0 = beta
  horizontal : (hypercubicLattice 2).Walk horizontalStart horizontalEnd
  horizontal_mem : ∀ z ∈ horizontal.support,
    z ∈ rect alpha beta bottomRow topRow
  intersection_pair : ∀ z, z ∈ horizontal.support → z ∈ vertical.support →
    ∃ i : I, rlc_twoChannelFullPhysicalEdgeCrossesCut A (source i) ∧
      rlc_twoChannelFullPhysicalEdgeCrossesCut B (target i)



theorem pairedEdgeCutIntersection_of_hexCutCarrier
    {V I : Type*} (source target : I → Sym2 V) (R L : Set V)
    (hcarrier : ∀ A B : Set V,
      R ⊆ A → L ∩ A = ∅ → R ⊆ B → L ∩ B = ∅ →
        Nonempty (PairedEdgeHexCutCarrier source target A B)) :
    PairedEdgeCutIntersection source target R L := by
  intro A B hRA hLA hRB hLB
  obtain ⟨C⟩ := hcarrier A B hRA hLA hRB hLB
  have hsep : Lattice.ArcSeparatingSet
      {z : Site 2 | z ∈ C.vertical.support}
      C.alpha C.beta C.bottomRow C.topRow :=
    Lattice.jec_arcSeparatingSet
      C.alpha C.beta C.bottomRow C.topRow C.bottomX C.topX
      C.alpha_lt_beta C.bottomRow_le_topRow C.bottomX_lower C.bottomX_upper
      C.topX_lower C.topX_upper C.vertical C.vertical_mem
      {z : Site 2 | z ∈ C.vertical.support} (by
        intro z hz
        exact hz)
  obtain ⟨z, hzHorizontal, hzVertical⟩ :=
    Lattice.tpc_two_paths_cross_of_sep hsep
      C.horizontalStart_mem C.horizontalEnd_mem
      C.horizontalStart_left C.horizontalEnd_right
      C.horizontal C.horizontal_mem
  exact C.intersection_pair z hzHorizontal hzVertical



theorem rlc_twoChannelFullPhysicalStaticCutIntersection_iff_pairedEdge
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma') :
    RlcTwoChannelFullPhysicalStaticCutIntersection gamma gamma' hfaith ↔
      PairedEdgeCutIntersection
        (fun target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ↦
          (rlc_twoChannelFullPhysicalSourceEdge target).1)
        (fun target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ↦
          target.1.1)
        {x | rlc_connectorOnRight gamma x}
        {x | rlc_connectorOnLeft gamma' x} := by
  constructor
  · intro hcut A B hAright hAleft hBright hBleft
    obtain ⟨target, x, y, u, v, htarget, hsource, hcrossA, hcrossB⟩ :=
      hcut A B hAright (by
        intro y hy hyA
        have : y ∈ ({x | rlc_connectorOnLeft gamma' x} :
          Set (RlcConnectorVertex n)) ∩ A := ⟨hy, hyA⟩
        have hempty : y ∈ (∅ : Set (RlcConnectorVertex n)) := hAleft ▸ this
        exact hempty) hBright (by
          intro y hy hyB
          have : y ∈ ({x | rlc_connectorOnLeft gamma' x} :
            Set (RlcConnectorVertex n)) ∩ B := ⟨hy, hyB⟩
          have hempty : y ∈ (∅ : Set (RlcConnectorVertex n)) := hBleft ▸ this
          exact hempty)
    exact ⟨target, ⟨u, v, hsource, hcrossA⟩,
      x, y, htarget, hcrossB⟩
  · intro hpaired A B hAright hAleft hBright hBleft
    obtain ⟨target, ⟨u, v, hsource, hcrossA⟩,
        x, y, htarget, hcrossB⟩ :=
      hpaired A B hAright (by
        ext z
        simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_empty_iff_false,
          iff_false]
        exact fun h ↦ hAleft z h.1 h.2) hBright (by
          ext z
          simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_empty_iff_false,
            iff_false]
          exact fun h ↦ hBleft z h.1 h.2)
    exact ⟨target, x, y, u, v, htarget, hsource, hcrossA, hcrossB⟩




theorem rlc_twoChannelFullPhysicalStaticCutIntersection_iff_twoColorHex
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma') :
    RlcTwoChannelFullPhysicalStaticCutIntersection gamma gamma' hfaith ↔
      PairedEdgeTwoColorHexAlternative
        (fun target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ↦
          (rlc_twoChannelFullPhysicalSourceEdge target).1)
        (fun target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ↦
          target.1.1)
        {x | rlc_connectorOnRight gamma x}
        {x | rlc_connectorOnLeft gamma' x} := by
  rw [rlc_twoChannelFullPhysicalStaticCutIntersection_iff_pairedEdge hfaith,
    pairedEdgeCutIntersection_iff_twoColorHexAlternative]


theorem rlc_twoChannelFullPhysicalStaticCutIntersection_of_hexCutCarrier
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    (hcarrier : ∀ A B : Set (RlcConnectorVertex n),
      {x | rlc_connectorOnRight gamma x} ⊆ A →
      {x | rlc_connectorOnLeft gamma' x} ∩ A = ∅ →
      {x | rlc_connectorOnRight gamma x} ⊆ B →
      {x | rlc_connectorOnLeft gamma' x} ∩ B = ∅ →
      Nonempty (PairedEdgeHexCutCarrier
        (fun target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ↦
          (rlc_twoChannelFullPhysicalSourceEdge target).1)
        (fun target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ↦
          target.1.1) A B)) :
    RlcTwoChannelFullPhysicalStaticCutIntersection gamma gamma' hfaith := by
  rw [rlc_twoChannelFullPhysicalStaticCutIntersection_iff_pairedEdge hfaith]
  exact pairedEdgeCutIntersection_of_hexCutCarrier _ _ _ _ hcarrier



noncomputable def rlc_twoChannelFullPhysicalCutIntersectionTargets {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (A B : Set (RlcConnectorVertex n)) :
    Finset (RlcTwoChannelFullPhysicalTargetEdge gamma gamma') := by
  classical
  exact Finset.univ.filter fun target =>
    rlc_twoChannelFullPhysicalEdgeCrossesCut A
      (rlc_twoChannelFullPhysicalSourceEdge target).1 ∧
    rlc_twoChannelFullPhysicalEdgeCrossesCut B target.1.1




theorem rlc_twoChannelFullPhysicalStaticCutIntersection_of_odd_intersection
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    (hodd : ∀ A B : Set (RlcConnectorVertex n),
      (∀ x, rlc_connectorOnRight gamma x → x ∈ A) →
      (∀ y, rlc_connectorOnLeft gamma' y → y ∉ A) →
      (∀ x, rlc_connectorOnRight gamma x → x ∈ B) →
      (∀ y, rlc_connectorOnLeft gamma' y → y ∉ B) →
      Odd (rlc_twoChannelFullPhysicalCutIntersectionTargets
        gamma gamma' A B).card) :
    RlcTwoChannelFullPhysicalStaticCutIntersection
      gamma gamma' hfaith := by
  classical
  intro A B hAright hAleft hBright hBleft
  have hcard : 0 <
      (rlc_twoChannelFullPhysicalCutIntersectionTargets
        gamma gamma' A B).card := by
    obtain ⟨k, hk⟩ := hodd A B hAright hAleft hBright hBleft
    omega
  obtain ⟨target, htarget⟩ := Finset.card_pos.mp hcard
  have hboth := (Finset.mem_filter.mp htarget).2
  obtain ⟨u, v, hsource, hcrossA⟩ := hboth.1
  obtain ⟨x, y, htargetEdge, hcrossB⟩ := hboth.2
  exact ⟨target, x, y, u, v, htargetEdge, hsource,
    hcrossA, hcrossB⟩




theorem rlc_twoChannelFullPhysicalStaticCutConnectivity_of_cutIntersection
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    (hintersect : RlcTwoChannelFullPhysicalStaticCutIntersection
      gamma gamma' hfaith) :
    RlcTwoChannelFullPhysicalStaticCutConnectivity
      gamma gamma' hfaith := by
  classical
  intro A hAright hAleft
  let G := rlc_twoChannelFullPhysicalCutTargetGraphAt gamma gamma' A
  by_cases hconn : ∃ x y : RlcConnectorVertex n,
      rlc_connectorOnRight gamma x ∧ rlc_connectorOnLeft gamma' y ∧
        G.Reachable x y
  · exact hconn
  · exfalso
    let B : Set (RlcConnectorVertex n) :=
      {z | ∃ x : RlcConnectorVertex n,
        rlc_connectorOnRight gamma x ∧ G.Reachable x z}
    have hBright : ∀ x : RlcConnectorVertex n,
        rlc_connectorOnRight gamma x → x ∈ B := by
      intro x hx
      exact ⟨x, hx, Reachable.refl _⟩
    have hBleft : ∀ y : RlcConnectorVertex n,
        rlc_connectorOnLeft gamma' y → y ∉ B := by
      intro y hy
      rintro ⟨x, hx, hxy⟩
      exact hconn ⟨x, y, hx, hy, hxy⟩
    obtain ⟨target, x, y, u, v, htarget, hsource,
        hcrossA, hcrossB⟩ :=
      hintersect A B hAright hAleft hBright hBleft
    have hxy : G.Adj x y :=
      ⟨target, htarget, u, v, hsource, hcrossA⟩
    rcases hcrossB with ⟨hxB, hyB⟩ | ⟨hyB, hxB⟩
    · obtain ⟨z, hz, hzx⟩ := hxB
      exact hyB ⟨z, hz, hzx.trans hxy.reachable⟩
    · obtain ⟨z, hz, hzy⟩ := hyB
      exact hxB ⟨z, hz, hzy.trans hxy.symm.reachable⟩

theorem rlc_twoChannelFullPhysicalStaticCutIntersection_of_cutConnectivity
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    (hconnect : RlcTwoChannelFullPhysicalStaticCutConnectivity
      gamma gamma' hfaith) :
    RlcTwoChannelFullPhysicalStaticCutIntersection
      gamma gamma' hfaith := by
  intro A B hAright hAleft hBright hBleft
  obtain ⟨x, y, hx, hy, hxy⟩ := hconnect A hAright hAleft
  obtain ⟨w⟩ := hxy
  obtain ⟨p, q, hpq, hpB, hqB⟩ :=
    rlc_walk_pred_first_exit w (fun z => z ∈ B)
      (hBright x hx) (hBleft y hy)
  have hpqAdj := w.adj_of_mem_edges hpq
  obtain ⟨target, htarget, u, v, hsource, hcrossA⟩ := hpqAdj
  exact ⟨target, p, q, u, v, htarget, hsource, hcrossA,
    Or.inl ⟨hpB, hqB⟩⟩

theorem rlc_twoChannelFullPhysicalStaticCutConnectivity_iff_cutIntersection
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma') :
    RlcTwoChannelFullPhysicalStaticCutConnectivity gamma gamma' hfaith ↔
      RlcTwoChannelFullPhysicalStaticCutIntersection
        gamma gamma' hfaith := by
  constructor
  · exact
      rlc_twoChannelFullPhysicalStaticCutIntersection_of_cutConnectivity
        hfaith
  · exact
      rlc_twoChannelFullPhysicalStaticCutConnectivity_of_cutIntersection
        hfaith



