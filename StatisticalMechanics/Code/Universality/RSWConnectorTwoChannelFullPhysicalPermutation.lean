    (hsInside : s ∈ jec_leftRegion (c.mapLe (faceBoundaryGraph_le
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega))))
    (htOutside : t ∉ jec_leftRegion (c.mapLe (faceBoundaryGraph_le
