          gamma gamma' ul vl := by
      intro hcarrier
      exact hnotReach
        ((rlc_twoChannelFullPhysicalGoodBoundaryGraph_adj_iff_carrierGeometry
          gamma gamma' omega).2 ⟨hulv, hcarrier⟩).reachable
    refine ⟨ul, vl, qRepair, qGood, rl, hulv, ?_, ?_, hnotReach, hbad, ?_⟩
