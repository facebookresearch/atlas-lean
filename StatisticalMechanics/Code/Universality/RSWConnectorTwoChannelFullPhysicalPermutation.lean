            r.length + rl.length < rr.length + rl.length ∧
            RlcTwoChannelFullPhysicalLeftArcClassifiedBad gamma gamma'
              (rlc_twoChannelFullPhysicalCutInteriorConfig
                gamma gamma' A) u' v' ∧
            RlcTwoChannelFullPhysicalWallTerminalProductClassification
              gamma gamma'
                (rlc_twoChannelFullPhysicalCutInteriorConfig
