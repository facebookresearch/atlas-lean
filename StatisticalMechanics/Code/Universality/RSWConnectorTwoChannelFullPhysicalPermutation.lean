        ((rlc_mem_ambientCrossingWalk_support_iff_pathVertices
          gamma.1 r).2 hr)).start_mem_support, rfl⟩
  have heq :=
    rlc_bookPhysicalTraceNetworkBracket_meets_rightPrefix_only_start
