theorem rlc_twoChannelFullPhysical_sourceBad_inside_barrier_or_boxBoundary
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {f g : Site 2}
    (hfg : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj f g)
    (hbad : sharedPrimalEdge f g ∉
      rlc_connectorCentralFacePlanarEdges gamma gamma') :
    ∃ p q : Site 2,
      sharedPrimalEdge f g = s(p, q) ∧
        (hypercubicLattice 2).Adj p q ∧
        p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
        q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
        (p ∈ rlc_connectorBarrier gamma gamma' ∨
          p 0 = -2 * n ∨ p 0 = 2 * n ∨
          p 1 = -n ∨ p 1 = n) := by
  obtain ⟨a, b, hab, habAdj⟩ := sharedPrimalEdge_isLatticeEdge hfg.1
  have hbd := hfg.2
  rw [hab, bdEdge_mk] at hbd
  have localize {p q : Site 2}
      (hpq : sharedPrimalEdge f g = s(p, q))
      (hpqAdj : (hypercubicLattice 2).Adj p q)
      (hpFilled : p ∈ rlc_twoChannelFullFilledReachSet gamma gamma' omega)
      (hqFilled : q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega) :
      p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
        (p ∈ rlc_connectorBarrier gamma gamma' ∨
          p 0 = -2 * n ∨ p 0 = 2 * n ∨
          p 1 = -n ∨ p 1 = n) := by
    have hpReach := rlc_twoChannelFullFilledBoundary_inside_mem_reachSet
      gamma gamma' omega hpFilled hqFilled hpqAdj
    refine ⟨hpReach, ?_⟩
    obtain ⟨hpBox, hpConnected⟩ := hpReach
    by_cases hpInterior : -2 * n < p 0 ∧ p 0 < 2 * n ∧
        -n < p 1 ∧ p 1 < n
    · left
      by_contra hpBarrier
      obtain ⟨w⟩ := hpConnected
      cases w.reverse with
      | nil =>
          exact hpBarrier (by
            simp [rlc_connectorRightAnchor, rlc_connectorBarrier,
              rlc_path_start_mem_vertices gamma.1])
      | @cons _ z _ hpz tail =>
          have hpzOpen : rlc_twoChannelFullAmbientConfig gamma gamma' omega
              s(p, (z : Site 2)) = true := by
            rw [openSubgraphInduce_adj, openSubgraph_adj] at hpz
            exact hpz.2
          have hpzPlanar :=
            rlc_twoChannelFullAmbientConfig_open_mem_planarEdges
              gamma gamma' omega hpzOpen
          have hpzAdj : (hypercubicLattice 2).Adj p (z : Site 2) := by
            rw [openSubgraphInduce_adj, openSubgraph_adj] at hpz
            exact hpz.1
          rw [rlc_mem_connectorCentralFacePlanarEdges_iff
            gamma gamma' hpzAdj] at hpzPlanar
          rcases hpzPlanar with hpzWall |
              ⟨hpConnectorBox, _hzConnectorBox, h, hhRegion, hhFlank⟩
          · exact hpBarrier
              (rlc_mem_connectorBarrier_of_mem_fourTraceEdge
                gamma gamma' hpzWall (Sym2.mem_mk_left _ _))
          · have hqConnectorBox : q ∈ rlc_connectorBox n := by
              simp only [rlc_connectorBox, Set.Finite.mem_toFinset]
              rw [mem_rect]
              rw [hypercubicLattice_adj, Fin.sum_univ_two] at hpqAdj
              omega
            generalize hkEq : flankFaces p q = e
            induction e using Sym2.inductionOn with
            | _ k l =>
                have hkFlank : k ∈ flankFaces p q := by
                  rw [hkEq]
                  exact Sym2.mem_mk_left _ _
                have hkRegion := rlc_centralFaceRegion_flank_transfer_interior
                  gamma gamma' hpzAdj hpqAdj hpInterior hpBarrier
                    hhRegion hhFlank hkFlank
                apply hbad
                rw [hpq]
                exact rlc_mem_connectorCentralFacePlanarEdges_of_box_region_flank
                  gamma gamma' hpqAdj hpConnectorBox hqConnectorBox
                    hkRegion hkFlank
    · right
      rw [mem_rect] at hpBox
      push Not at hpInterior
      omega
  by_cases haFilled :
      a ∈ rlc_twoChannelFullFilledReachSet gamma gamma' omega
  · have hbFilled :
        b ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega :=
      hbd.mp haFilled
    obtain ⟨haReach, haPlace⟩ :=
      localize hab habAdj haFilled hbFilled
    exact ⟨a, b, hab, habAdj, haReach, hbFilled, haPlace⟩
  · have hbFilled :
        b ∈ rlc_twoChannelFullFilledReachSet gamma gamma' omega := by
      tauto
    have hba : sharedPrimalEdge f g = s(b, a) := by
      simpa [Sym2.eq_swap] using hab
    obtain ⟨hbReach, hbPlace⟩ :=
      localize hba habAdj.symm hbFilled haFilled
    exact ⟨b, a, hba, habAdj.symm, hbReach, haFilled, hbPlace⟩



def RlcTwoChannelFullPhysicalExclusiveReflectedLeftSourceTraceResidue
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (p q : Site 2) : Prop :=
  ∃ z : Site 2,
    (hypercubicLattice 2).Adj p z ∧
      rlc_twoChannelFullAmbientConfig gamma gamma' omega s(p, z) = true ∧
      ((∃ source : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet,
          source.1.map Subtype.val = s(p, z)) ∨
        (s(p, z) ∉ rlc_connectorFourTraceEdges gamma gamma' ∧
          z 0 + q 0 = 2 * p 0 ∧ z 1 + q 1 = 2 * p 1 ∧
          ∀ y : Site 2,
            (hypercubicLattice 2).Adj p y → y ≠ z → y ≠ q →
              ∃ source :
                (rlc_connectorTwoChannelGraph gamma gamma').edgeSet,
                source.1.map Subtype.val = s(p, y)))





theorem
    rlc_twoChannelFullPhysical_sourceBad_exclusiveReflectedLeft_traceResidue_or_otherLocation
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hno : rlc_twoChannelEdgeConfigExtend gamma gamma' omega ∉
      rlc_finiteTwoChannelConnectorEvent gamma gamma')
    {f g : Site 2}
    (hfg : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj f g)
    (hsourceBad : ¬RlcTwoChannelFullPhysicalSourceCarrierGeometry
      gamma gamma' f g) :
    ∃ p q : Site 2,
      sharedPrimalEdge f g = s(p, q) ∧
        (hypercubicLattice 2).Adj p q ∧
        p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
        q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
        (p ∈ rlc_pathVertices gamma.1 ∨
          (RlcTwoChannelFullPhysicalExclusiveReflectedLeftLocation
              gamma gamma' p ∧
            RlcTwoChannelFullPhysicalExclusiveReflectedLeftSourceTraceResidue
              gamma gamma' omega p q) ∨
          (p 0 < 0 ∧ ∃ w ∈ rlc_pathVertices gamma.1,
            p = rlc_flipX w) ∨
          p 0 = -2 * n ∨ p 0 = 2 * n ∨
          p 1 = -n ∨ p 1 = n) := by
  have hnotPlanar : sharedPrimalEdge f g ∉
      rlc_connectorCentralFacePlanarEdges gamma gamma' := by
    intro hplanar
    exact hsourceBad
      (rlc_twoChannelFullPhysical_sourceCarrier_of_planar
        gamma gamma' omega hfg hplanar)
  obtain ⟨p, q, hpq, hpqAdj, hpReach, hqOut, hpPlace⟩ :=
    rlc_twoChannelFullPhysical_sourceBad_inside_barrier_or_boxBoundary
      gamma gamma' omega hfg hnotPlanar
  refine ⟨p, q, hpq, hpqAdj, hpReach, hqOut, ?_⟩
  rcases hpPlace with hpBarrier | hpBoundary
  · rcases rlc_connectorBarrier_original_or_strict_reflected
        gamma gamma' hpBarrier with
      hpRight | hpLeft | hpFlipLeft | hpFlipRight
    · exact Or.inl hpRight
    · exact False.elim
        ((rlc_leftPathVertex_not_mem_twoChannelFullReachSet_of_failure
          gamma gamma' omega hno hpLeft) hpReach)
    · by_cases hpRight : p ∈ rlc_pathVertices gamma.1
      · exact Or.inl hpRight
      · have hpNotLeft : p ∉ rlc_pathVertices gamma'.1 := by
          intro hpLeft
          have hpLeftBox := rlc_pathVertex_mem_rect gamma'.1 hpLeft
          rw [mem_rect] at hpLeftBox
          omega
        have hpExclusive :
            RlcTwoChannelFullPhysicalExclusiveReflectedLeftLocation
              gamma gamma' p :=
          ⟨hpFlipLeft.1, hpFlipLeft.2, hpRight, hpNotLeft⟩
        by_cases hpBoundary : p 0 = -2 * n ∨ p 0 = 2 * n ∨
            p 1 = -n ∨ p 1 = n
        · exact Or.inr (Or.inr (Or.inr hpBoundary))
        · have hpBox := rlc_twoChannelFullReachSet_subset_box
            gamma gamma' omega hpReach
          have hpInterior : -2 * n < p 0 ∧ p 0 < 2 * n ∧
              -n < p 1 ∧ p 1 < n := by
            rw [mem_rect] at hpBox
            push Not at hpBoundary
            omega
          have hqBox : q ∈ rlc_connectorBox n := by
            simp only [rlc_connectorBox, Set.Finite.mem_toFinset]
            rw [mem_rect]
            have hpqCoord := hpqAdj
            rw [hypercubicLattice_adj, Fin.sum_univ_two] at hpqCoord
            omega
          have hpAnchor :
              p ≠ (rlc_connectorRightAnchor gamma : Site 2) := by
            intro hpEq
            have haxis : ((rlc_connectorRightAnchor gamma :
                RlcConnectorVertex n) : Site 2) 0 = 0 := gamma.1.1.2.2
            rw [hpEq] at hpFlipLeft
            omega
          have hpqClosed : rlc_twoChannelFullAmbientConfig gamma gamma' omega
              s(p, q) = false := by
            have hopen := rlc_twoChannelFullFilledBoundary_le_openFaceDual
              gamma gamma' omega hfg
            rw [openSubgraph_adj] at hopen
            have h := hopen.2
            rw [fci_faceDualConfig,
              fci_faceEdgeEquiv_mk_of_adj hfg.1, hpq] at h
            simpa using h
          rcases
              rlc_twoChannelFullPhysical_reachable_interior_exclusiveReflectedLeft_edge_planar_or_sourceTraceCross
                gamma gamma' omega hpReach hpInterior hpExclusive hqBox
                  hpqAdj hpAnchor hpqClosed with
            hplanar | htrace
          · exact False.elim (hsourceBad
              (rlc_twoChannelFullPhysical_sourceCarrier_of_planar
                gamma gamma' omega hfg (by simpa [hpq] using hplanar)))
          · exact Or.inr (Or.inl ⟨hpExclusive, htrace⟩)
    · exact Or.inr (Or.inr (Or.inl hpFlipRight))
  · exact Or.inr (Or.inr (Or.inr hpBoundary))


def RlcTwoChannelFullPhysicalReflectedLeftTerminalSourceResidue
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (f g : Site 2) : Prop :=
  (¬RlcTwoChannelFullPhysicalSourceCarrierGeometry gamma gamma' f g) ∧
    ∃ p q : Site 2,
      sharedPrimalEdge f g = s(p, q) ∧
        (hypercubicLattice 2).Adj p q ∧
        p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
        q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
        (p ∈ rlc_pathVertices gamma.1 ∨
          (RlcTwoChannelFullPhysicalExclusiveReflectedLeftLocation
              gamma gamma' p ∧
            RlcTwoChannelFullPhysicalExclusiveReflectedLeftSourceTraceResidue
              gamma gamma' omega p q) ∨
          (p 0 < 0 ∧ ∃ w ∈ rlc_pathVertices gamma.1,
            p = rlc_flipX w) ∨
          p 0 = -2 * n ∨ p 0 = 2 * n ∨
          p 1 = -n ∨ p 1 = n)





theorem
    rlc_twoChannelFullPhysical_reflectedLeftTerminalFailure_target_or_sourceTraceResidue
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (A B : Set (RlcConnectorVertex n))
    (hAright : ∀ x, rlc_connectorOnRight gamma x → x ∈ A)
    (hAleft : ∀ y, rlc_connectorOnLeft gamma' y → y ∉ A)
    {f g : Site 2}
    (hfg : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma'
        (rlc_twoChannelFullPhysicalCutInteriorConfig
          gamma gamma' A))).Adj f g)
    (hfailure :
      RlcTwoChannelFullPhysicalExclusiveReflectedLeftTerminalFailure
        gamma gamma' B f g) :
    ((¬RlcTwoChannelFullPhysicalTargetCarrierGeometry gamma gamma' f g) ∧
      s(rlc_dualReflect f, rlc_dualReflect g) ∉
        rlc_reflectedPathEdges gamma'.1) ∨
      ∃ target : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet,
        target.1.map Subtype.val =
            s(rlc_dualReflect f, rlc_dualReflect g) ∧
          rlc_twoChannelFullPhysicalEdgeCrossesCut B target.1 ∧
          RlcTwoChannelFullPhysicalReflectedLeftTerminalSourceResidue
            gamma gamma'
              (rlc_twoChannelFullPhysicalCutInteriorConfig
                gamma gamma' A) f g := by
  rcases hfailure with htarget | ⟨target, htarget, hcross, hsourceBad⟩
  · exact Or.inl htarget
  · refine Or.inr ⟨target, htarget, hcross, hsourceBad, ?_⟩
    exact
      (rlc_twoChannelFullPhysical_sourceBad_exclusiveReflectedLeft_traceResidue_or_otherLocation
        gamma gamma'
          (rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A)
          (rlc_twoChannelFullPhysicalCutInteriorConfig_failure
            gamma gamma' A hAright hAleft)
          hfg hsourceBad)



def RlcTwoChannelFullPhysicalExclusiveReflectedRightSourceTraceResidue
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (p q : Site 2) : Prop :=
  ∃ z : Site 2,
    (hypercubicLattice 2).Adj p z ∧
      rlc_twoChannelFullAmbientConfig gamma gamma' omega s(p, z) = true ∧
      ((∃ source : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet,
          source.1.map Subtype.val = s(p, z)) ∨
        (s(p, z) ∉ rlc_connectorFourTraceEdges gamma gamma' ∧
          z 0 + q 0 = 2 * p 0 ∧ z 1 + q 1 = 2 * p 1 ∧
          ∀ y : Site 2,
            (hypercubicLattice 2).Adj p y → y ≠ z → y ≠ q →
              ∃ source :
                (rlc_connectorTwoChannelGraph gamma gamma').edgeSet,
                source.1.map Subtype.val = s(p, y)))






theorem
    rlc_twoChannelFullPhysical_reflectedLeftTerminalSourceResidue_rightTrace_or_boxWall
    {n : Int} (hn : 0 < n)
    (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hno : rlc_twoChannelEdgeConfigExtend gamma gamma' omega ∉
      rlc_finiteTwoChannelConnectorEvent gamma gamma')
    {f g : Site 2}
    (hfg : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj f g)
    (hfExclusive : RlcTwoChannelFullPhysicalExclusiveReflectedLeftLocation
      gamma gamma' (rlc_dualReflect f))
    (hsource : RlcTwoChannelFullPhysicalReflectedLeftTerminalSourceResidue
      gamma gamma' omega f g) :
    (¬RlcTwoChannelFullPhysicalSourceCarrierGeometry gamma gamma' f g) ∧
      ∃ p q : Site 2,
        sharedPrimalEdge f g = s(p, q) ∧
          (hypercubicLattice 2).Adj p q ∧
          p ∈ rlc_twoChannelFullReachSet gamma gamma' omega ∧
          q ∉ rlc_twoChannelFullFilledReachSet gamma gamma' omega ∧
          ((RlcTwoChannelFullPhysicalExclusiveReflectedRightLocation
              gamma gamma' p ∧
            RlcTwoChannelFullPhysicalExclusiveReflectedRightSourceTraceResidue
              gamma gamma' omega p q) ∨
            p 0 = -2 * n ∨ p 1 = -n ∨ p 1 = n) := by
  rcases hsource with
    ⟨hsourceBad, p, q, hpq, hpqAdj, hpReach, hqOut, hpPlace⟩
  refine ⟨hsourceBad, p, q, hpq, hpqAdj, hpReach, hqOut, ?_⟩
  have hpBounds : f 0 ≤ p 0 ∧ p 0 ≤ f 0 + 1 := by
    rcases face_adj_dir hfg.1 with hg | hg | hg | hg
    · subst g
      rw [show sharedPrimalEdge f ![f 0 + 1, f 1] =
          s(![f 0 + 1, f 1], ![f 0 + 1, f 1 + 1]) by
            simpa using sharedPrimalEdge_right (f 0) (f 1),
        Sym2.eq_iff] at hpq
      rcases hpq with h | h <;> rcases h with ⟨rfl, rfl⟩ <;> simp
    · subst g
      rw [show sharedPrimalEdge f ![f 0 - 1, f 1] =
          s(faceCorner00 (f 0) (f 1), faceCorner01 (f 0) (f 1)) by
            simpa using sharedPrimalEdge_left (f 0) (f 1),
        Sym2.eq_iff] at hpq
      rcases hpq with h | h <;> rcases h with ⟨rfl, rfl⟩ <;>
        simp [faceCorner00, faceCorner01]
    · subst g
      rw [show sharedPrimalEdge f ![f 0, f 1 + 1] =
          s(![f 0, f 1 + 1], ![f 0 + 1, f 1 + 1]) by
            simpa using sharedPrimalEdge_top (f 0) (f 1),
        Sym2.eq_iff] at hpq
      rcases hpq with h | h <;> rcases h with ⟨rfl, rfl⟩ <;> simp
    · subst g
      rw [show sharedPrimalEdge f ![f 0, f 1 - 1] =
          s(faceCorner00 (f 0) (f 1), faceCorner10 (f 0) (f 1)) by
            simpa using sharedPrimalEdge_bottom (f 0) (f 1),
        Sym2.eq_iff] at hpq
      rcases hpq with h | h <;> rcases h with ⟨rfl, rfl⟩ <;>
        simp [faceCorner00, faceCorner10]
  have hfPos := hfExclusive.1
  have hpNeg : p 0 < 0 := by
    simp [rlc_dualReflect, rlc_dualReflectFun] at hfPos
    omega
  rcases hpPlace with hpRight | hpLeft | hpFlipRight | hpBoundary
  · have hpRect := rlc_pathVertex_mem_rect gamma.1 hpRight
    rw [mem_rect] at hpRect
    omega
  · exact False.elim (by
      have hpPos := hpLeft.1.1
      omega)
  · have hpNotRight : p ∉ rlc_pathVertices gamma.1 := by
      intro hpRight
      have hpRect := rlc_pathVertex_mem_rect gamma.1 hpRight
      rw [mem_rect] at hpRect
      omega
    have hpNotLeft : p ∉ rlc_pathVertices gamma'.1 := by
      intro hpLeft
      exact (rlc_leftPathVertex_not_mem_twoChannelFullReachSet_of_failure
        gamma gamma' omega hno hpLeft) hpReach
    have hpExclusive :
        RlcTwoChannelFullPhysicalExclusiveReflectedRightLocation
          gamma gamma' p :=
      ⟨hpFlipRight.1, hpFlipRight.2, hpNotRight, hpNotLeft⟩
    by_cases hpBoundary : p 0 = -2 * n ∨ p 1 = -n ∨ p 1 = n
    · exact Or.inr hpBoundary
    · have hpBox := rlc_twoChannelFullReachSet_subset_box
          gamma gamma' omega hpReach
      have hpInterior : -2 * n < p 0 ∧ p 0 < 2 * n ∧
          -n < p 1 ∧ p 1 < n := by
        rw [mem_rect] at hpBox
        push Not at hpBoundary
        omega
      have hqBox : q ∈ rlc_connectorBox n := by
        simp only [rlc_connectorBox, Set.Finite.mem_toFinset]
        rw [mem_rect]
        have hpqCoord := hpqAdj
        rw [hypercubicLattice_adj, Fin.sum_univ_two] at hpqCoord
        omega
      have hpAnchor :
          p ≠ (rlc_connectorRightAnchor gamma : Site 2) := by
        intro hpEq
        have haxis : ((rlc_connectorRightAnchor gamma :
            RlcConnectorVertex n) : Site 2) 0 = 0 := gamma.1.1.2.2
        rw [hpEq] at hpNeg
        omega
      have hpqClosed : rlc_twoChannelFullAmbientConfig gamma gamma' omega
          s(p, q) = false := by
        have hopen := rlc_twoChannelFullFilledBoundary_le_openFaceDual
          gamma gamma' omega hfg
        rw [openSubgraph_adj] at hopen
        have h := hopen.2
        rw [fci_faceDualConfig,
          fci_faceEdgeEquiv_mk_of_adj hfg.1, hpq] at h
        simpa using h
      rcases
          rlc_twoChannelFullPhysical_reachable_interior_exclusiveReflectedRight_edge_planar_or_sourceTraceCross
            gamma gamma' omega hpReach hpInterior hpExclusive hqBox hpqAdj
              hpAnchor hpqClosed with
        hplanar | htrace
      · exact False.elim (hsourceBad
          (rlc_twoChannelFullPhysical_sourceCarrier_of_planar
            gamma gamma' omega hfg (by simpa [hpq] using hplanar)))
      · exact Or.inl ⟨hpExclusive, htrace⟩
  · rcases hpBoundary with hpLeft | hpRight | hpBottom | hpTop
    · exact Or.inr (Or.inl hpLeft)
    · exact False.elim (by omega)
    · exact Or.inr (Or.inr (Or.inl hpBottom))
    · exact Or.inr (Or.inr (Or.inr hpTop))



def RlcTwoChannelFullPhysicalReflectedLeftTerminalReducedSourceResidue
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
