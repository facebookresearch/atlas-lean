abbrev RlcTwoChannelFullPhysicalTargetEdge {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :=
  {target : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet //
    Nonempty (RlcTwoChannelAmbientSourceEdge gamma gamma'
      (rlc_pimsEdgeEquiv (target.1.map Subtype.val)))}

noncomputable instance rlc_twoChannelFullPhysicalTargetEdgeDecidable
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) :
    DecidablePred (fun target :
      (rlc_connectorTwoChannelGraph gamma gamma').edgeSet =>
        Nonempty (RlcTwoChannelAmbientSourceEdge gamma gamma'
          (rlc_pimsEdgeEquiv (target.1.map Subtype.val)))) :=
  Classical.decPred _


noncomputable def rlc_twoChannelFullPhysicalSourceEdge {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma') :
    (rlc_connectorTwoChannelGraph gamma gamma').edgeSet :=
  target.2.some.1

@[simp] theorem rlc_twoChannelFullPhysicalSourceEdge_map {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma') :
    (rlc_twoChannelFullPhysicalSourceEdge target).1.map Subtype.val =
      rlc_pimsEdgeEquiv (target.1.1.map Subtype.val) :=
  target.2.some.2

theorem rlc_twoChannelFullPhysicalSourceEdge_injective {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n} :
    Function.Injective
      (rlc_twoChannelFullPhysicalSourceEdge
        (gamma := gamma) (gamma' := gamma')) := by
  intro target target' hsource
  apply Subtype.ext
  apply Subtype.ext
  apply Sym2.map.injective Subtype.val_injective
  apply rlc_pimsEdgeEquiv.injective
  rw [← rlc_twoChannelFullPhysicalSourceEdge_map target,
    ← rlc_twoChannelFullPhysicalSourceEdge_map target', hsource]

abbrev RlcTwoChannelFullPhysicalVisibleSourceEdge {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :=
  {source : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet //
    source ∈ Set.range
      (rlc_twoChannelFullPhysicalSourceEdge
        (gamma := gamma) (gamma' := gamma'))}

noncomputable instance rlc_twoChannelFullPhysicalVisibleSourceEdgeDecidable
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) :
    DecidablePred (fun source :
      (rlc_connectorTwoChannelGraph gamma gamma').edgeSet =>
        source ∈ Set.range
          (rlc_twoChannelFullPhysicalSourceEdge
            (gamma := gamma) (gamma' := gamma'))) :=
  Classical.decPred _



noncomputable def rlc_twoChannelFullPhysicalVisibleEquiv {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :
    RlcTwoChannelFullPhysicalTargetEdge gamma gamma' ≃
      RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma' :=
  Equiv.ofInjective rlc_twoChannelFullPhysicalSourceEdge
    rlc_twoChannelFullPhysicalSourceEdge_injective


noncomputable def rlc_twoChannelFullPhysicalTargetOfVisibleSource {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma') :
    RlcTwoChannelFullPhysicalTargetEdge gamma gamma' :=
  (rlc_twoChannelFullPhysicalVisibleEquiv gamma gamma').symm source

@[simp] theorem rlc_twoChannelFullPhysicalSourceEdge_targetOfVisibleSource
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma') :
    rlc_twoChannelFullPhysicalSourceEdge
        (rlc_twoChannelFullPhysicalTargetOfVisibleSource source) = source.1 := by
  exact congrArg Subtype.val
    ((rlc_twoChannelFullPhysicalVisibleEquiv gamma gamma').apply_symm_apply
      source)



noncomputable def rlc_twoChannelFullPhysicalEdgePerm {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :
    Equiv.Perm (rlc_connectorTwoChannelGraph gamma gamma').edgeSet :=
  (rlc_twoChannelFullPhysicalVisibleEquiv gamma gamma').extendSubtype

theorem rlc_twoChannelFullPhysicalEdgePerm_physical {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma') :
    rlc_twoChannelFullPhysicalEdgePerm gamma gamma' target.1 =
      rlc_twoChannelFullPhysicalSourceEdge target := by
  rw [rlc_twoChannelFullPhysicalEdgePerm,
    Equiv.extendSubtype_apply_of_mem]
  rfl


noncomputable def rlc_twoChannelFullPhysicalPermConfig {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    RlcTwoChannelEdgeConfig gamma gamma' :=
  fun target =>
    !(omega (rlc_twoChannelFullPhysicalEdgePerm gamma gamma' target))

theorem rlc_twoChannelFullPhysicalPermConfig_injective {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n} :
    Function.Injective
      (rlc_twoChannelFullPhysicalPermConfig gamma gamma') := by
  intro rho sigma hconfig
  funext source
  have h := congrFun hconfig
    ((rlc_twoChannelFullPhysicalEdgePerm gamma gamma').symm source)
  simp only [rlc_twoChannelFullPhysicalPermConfig,
    Equiv.apply_symm_apply] at h
  exact Bool.not_injective h



theorem rlc_twoChannelFullPhysicalPermConfig_eq_fullDual {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma') :
    rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega target.1 =
      rlc_twoChannelFullDualConfig gamma gamma' omega target.1.1 := by
  rw [rlc_twoChannelFullPhysicalPermConfig,
    rlc_twoChannelFullPhysicalEdgePerm_physical,
    rlc_twoChannelFullDualConfig_of_source gamma gamma' omega target.1.1
      (rlc_twoChannelFullPhysicalSourceEdge target)
      (rlc_twoChannelFullPhysicalSourceEdge_map target)]



theorem rlc_twoChannelFullPhysicalPermConfig_targetOfVisibleSource
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma') :
    rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega
        (rlc_twoChannelFullPhysicalTargetOfVisibleSource source).1 =
      !(omega source.1) := by
  rw [rlc_twoChannelFullPhysicalPermConfig,
    rlc_twoChannelFullPhysicalEdgePerm_physical,
    rlc_twoChannelFullPhysicalSourceEdge_targetOfVisibleSource]



def rlc_twoChannelPIMSVariableToFullPhysical {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (target : RlcTwoChannelPIMSVariableTargetEdge gamma gamma') :
    RlcTwoChannelFullPhysicalTargetEdge gamma gamma' :=
  ⟨target.1, ⟨⟨rlc_twoChannelPIMSSourceEdge target,
    rlc_twoChannelPIMSSourceEdge_map target⟩⟩⟩




def RlcTwoChannelFullPhysicalPermutationSuccess {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (_hfaith : RlcBookFaithfulTracePair gamma gamma') : Prop :=
  forall rho : RlcTwoChannelEdgeFailure gamma gamma',
    rlc_twoChannelEdgeConfigExtend gamma gamma'
        (rlc_twoChannelFullPhysicalPermConfig gamma gamma' rho.1) ∈
      rlc_finiteTwoChannelConnectorEvent gamma gamma'



def RlcTwoChannelFullVariableConnectorSuccess {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') : Prop :=
  ∃ x y : RlcConnectorVertex n,
    rlc_connectorOnRight gamma x ∧ rlc_connectorOnLeft gamma' y ∧
      (FK.openSub (rlc_twoChannelFullVariableGraph gamma gamma')
        (rlc_twoChannelFullDualConfig gamma gamma' omega)).Reachable x y



theorem rlc_twoChannelFullPhysicalPermConfig_success_of_variableConnector
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hvariable : RlcTwoChannelFullVariableConnectorSuccess
      gamma gamma' omega) :
    rlc_twoChannelEdgeConfigExtend gamma gamma'
        (rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega) ∈
      rlc_finiteTwoChannelConnectorEvent gamma gamma' := by
  obtain ⟨x, y, hx, hy, hxy⟩ := hvariable
  refine ⟨x, y, hx, hy, hxy.mono ?_⟩
  intro u v huv
  rw [FK.openSub_adj] at huv ⊢
  let target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' :=
    ⟨⟨s(u, v), huv.1.1⟩, huv.1.2⟩
  refine ⟨huv.1.1, ?_⟩
  have hmem : s(u, v) ∈
      (rlc_connectorTwoChannelGraph gamma gamma').edgeSet :=
    (SimpleGraph.mem_edgeSet _).mpr huv.1.1
  change (if h : s(u, v) ∈
      (rlc_connectorTwoChannelGraph gamma gamma').edgeSet then
    rlc_twoChannelFullPhysicalPermConfig gamma gamma' omega
      ⟨s(u, v), h⟩ else false) = true
  rw [dif_pos hmem]
  rw [show (⟨s(u, v), hmem⟩ :
      (rlc_connectorTwoChannelGraph gamma gamma').edgeSet) = target.1 by rfl]
  rw [rlc_twoChannelFullPhysicalPermConfig_eq_fullDual]
  exact huv.2



def RlcTwoChannelFullVariableFailureDuality {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (_hfaith : RlcBookFaithfulTracePair gamma gamma') : Prop :=
  ∀ omega : RlcTwoChannelEdgeConfig gamma gamma',
    rlc_twoChannelEdgeConfigExtend gamma gamma' omega ∉
        rlc_finiteTwoChannelConnectorEvent gamma gamma' →
      RlcTwoChannelFullVariableConnectorSuccess gamma gamma' omega



noncomputable def rlc_twoChannelFullPhysicalVisibleSourceGraph {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :
    SimpleGraph (RlcConnectorVertex n) where
  Adj x y := (rlc_connectorTwoChannelGraph gamma gamma').Adj x y ∧
    ∃ target : RlcTwoChannelFullPhysicalTargetEdge gamma gamma',
      (rlc_twoChannelFullPhysicalSourceEdge target).1 = s(x, y)
  symm := by
    rintro x y ⟨hxy, target, htarget⟩
    refine ⟨hxy.symm, target, ?_⟩
    simpa [Sym2.eq_swap] using htarget
  loopless := ⟨fun x hxx => hxx.1.ne rfl⟩

noncomputable instance
    rlc_twoChannelFullPhysicalVisibleSourceGraphDecidableAdj
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) :
    DecidableRel
      (rlc_twoChannelFullPhysicalVisibleSourceGraph gamma gamma').Adj :=
  Classical.decRel _



def RlcTwoChannelFullPhysicalVisibleSourceConnectorSuccess {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') : Prop :=
  ∃ x y : RlcConnectorVertex n,
    rlc_connectorOnRight gamma x ∧ rlc_connectorOnLeft gamma' y ∧
      (FK.openSub
        (rlc_twoChannelFullPhysicalVisibleSourceGraph gamma gamma')
        (rlc_twoChannelEdgeConfigExtend gamma gamma' omega)).Reachable x y



theorem rlc_twoChannelFullPhysical_not_visibleSourceConnector_of_failure
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hno : rlc_twoChannelEdgeConfigExtend gamma gamma' omega ∉
      rlc_finiteTwoChannelConnectorEvent gamma gamma') :
    ¬RlcTwoChannelFullPhysicalVisibleSourceConnectorSuccess
      gamma gamma' omega := by
  rintro ⟨x, y, hx, hy, hxy⟩
  apply hno
  refine ⟨x, y, hx, hy, hxy.mono ?_⟩
  intro u v huv
  rw [FK.openSub_adj] at huv ⊢
  exact ⟨huv.1.1, huv.2⟩





