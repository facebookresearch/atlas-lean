            rw [← hrAxis, hrv]
            exact hHB hvH))
    · exact Or.inr (Or.inr
        ⟨r, hrw, hrv, hrContact, Or.inl hrExclusive⟩)
  · obtain ⟨q, hqLeft, hrq⟩ := hrLeft
    rcases
        rlc_twoChannelFullPhysical_reachable_reflectedLeft_intersection_or_exclusive
          hfaith hno (hwReach r hrw) hqLeft hrq with
