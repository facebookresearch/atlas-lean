      gamma gamma' f g
  · right
    obtain ⟨target, htargetMap⟩ := htarget
    have htargetCrossAmbient : rlc_twoChannelFullPhysicalEdgeCrossesCut
        (rlc_twoChannelFullPhysicalLiftVertexCut B)
          (target.1.map Subtype.val) := by
