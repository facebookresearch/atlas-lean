    simpa [C, SimpleGraph.Walk.support_mapLe_eq_support] using hzC
  dsimp only [L] at hzL
  rw [sw_lshape_mem_support] at hzL
  rcases hzL with hzHoriz | hzVert
  · rw [sw_horizSeg_mem_support] at hzHoriz
    obtain ⟨t, ht, rfl⟩ := hzHoriz
