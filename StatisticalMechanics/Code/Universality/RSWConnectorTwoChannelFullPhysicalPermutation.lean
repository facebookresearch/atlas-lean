      q.adj_of_mem_edges (by
        simpa [SimpleGraph.Walk.edges_mapLe_eq_edges] using hfgQ)
    exact False.elim (hfgBad
      ((rlc_twoChannelFullPhysicalGoodBoundaryGraph_adj_iff_carrierGeometry
