  · intro h
    have h0 := congrArg (fun z : Site 2 => z 0) h
    have h1 := congrArg (fun z : Site 2 => z 1) h
    ext i
    fin_cases i <;>
      simp [phb_doubleDualShift, rlc_dualReflect,
        rlc_dualReflectInvFun, rlc_flipX, rlc_flipXFun] at h0 h1 ⊢ <;>
      omega
  · rintro rfl
