    rw [hyr] at hyLeft
    simpa using hyLeft
  have hrSet : r ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma' := by
    simp [rlc_bookFlippedTraceIntersectionSet, hrRight, hrLeft]
  refine ⟨r, hrRight, hyr, hrSuffix, ?_⟩
  by_cases hrz : r = z
  · exact Or.inl hrz
