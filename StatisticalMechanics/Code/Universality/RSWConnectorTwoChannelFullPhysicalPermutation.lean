  (phb_doubleDualShift p ∈
        jec_leftRegion (c.mapLe (faceBoundaryGraph_le
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega))) ∧
      phb_doubleDualShift q ∉
        jec_leftRegion (c.mapLe (faceBoundaryGraph_le
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)))) ∨
    ∃ z ∈ c.support,
      z = p ∨ z = ![p 0 - 1, p 1] ∨
        z = phb_doubleDualShift p ∨ z = q ∨
        z = ![q 0 - 1, q 1] ∨ z = phb_doubleDualShift q






