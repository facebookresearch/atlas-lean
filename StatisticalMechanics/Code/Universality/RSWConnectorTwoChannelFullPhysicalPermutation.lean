    intro x y hxy
    apply phb_doubleDualShift_latAdj.mp
    simpa [phb_doubleDualEquiv, phb_doubleDualShift] using hxy




theorem rlc_collaredVerticalArc_meets_leftRightWalk
    {alpha beta bottom top : Int}
    (hab : alpha < beta) (hbt : bottom ≤ top)
    {x y a b : Site 2}
    (hxBox : x ∈ rect alpha beta bottom top)
    (hyBox : y ∈ rect alpha beta bottom top)
    (V : (hypercubicLattice 2).Walk x y)
    (hVBox : ∀ z ∈ V.support, z ∈ rect alpha beta bottom top)
    (H : (hypercubicLattice 2).Walk a b)
    (haBox : a ∈ rect alpha beta bottom top)
    (hbBox : b ∈ rect alpha beta bottom top)
    (haLeft : a 0 = alpha) (hbRight : b 0 = beta)
    (hHBox : ∀ z ∈ H.support, z ∈ rect alpha beta bottom top)
    (hpre : ∀ z ∈ H.support,
      z ∈ (sw_vertSeg (x 0) bottom (x 1)).support → z ∈ V.support)
    (hpost : ∀ z ∈ H.support,
      z ∈ (sw_vertSeg (y 0) (y 1) top).support → z ∈ V.support) :
    ∃ z ∈ H.support, z ∈ V.support := by
  have hxCoord : (![x 0, x 1] : Site 2) = x := by
    ext i
    fin_cases i <;> simp
  have hyCoord : (![y 0, y 1] : Site 2) = y := by
    ext i
    fin_cases i <;> simp
  let pre : (hypercubicLattice 2).Walk ![x 0, bottom] x :=
    (sw_vertSeg (x 0) bottom (x 1)).copy rfl hxCoord
  let post : (hypercubicLattice 2).Walk y ![y 0, top] :=
    (sw_vertSeg (y 0) (y 1) top).copy hyCoord rfl
  let Vc : (hypercubicLattice 2).Walk
      ![x 0, bottom] ![y 0, top] := (pre.append V).append post
  have hVcBox : ∀ z ∈ Vc.support,
      z ∈ rect alpha beta bottom top := by
    intro z hz
    dsimp only [Vc] at hz
    rw [SimpleGraph.Walk.mem_support_append_iff,
      SimpleGraph.Walk.mem_support_append_iff] at hz
    rcases hz with (hzPre | hzV) | hzPost
    · dsimp only [pre] at hzPre
      rw [SimpleGraph.Walk.support_copy, sw_vertSeg_mem_support] at hzPre
      obtain ⟨t, ht, rfl⟩ := hzPre
      rw [Set.mem_uIcc] at ht
      rw [mem_rect] at hxBox ⊢
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      omega
    · exact hVBox z hzV
    · dsimp only [post] at hzPost
      rw [SimpleGraph.Walk.support_copy, sw_vertSeg_mem_support] at hzPost
      obtain ⟨t, ht, rfl⟩ := hzPost
      rw [Set.mem_uIcc] at ht
      rw [mem_rect] at hyBox ⊢
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      omega
  have hsep : ArcSeparatingSet {z | z ∈ Vc.support}
      alpha beta bottom top := by
    have hxBounds := (mem_rect.mp hxBox)
    have hyBounds := (mem_rect.mp hyBox)
    exact jec_arcSeparatingSet alpha beta bottom top (x 0) (y 0)
      hab hbt hxBounds.1 hxBounds.2.1 hyBounds.1 hyBounds.2.1
        Vc hVcBox {z | z ∈ Vc.support} (fun _ hz => hz)
  obtain ⟨z, hzH, hzVc⟩ := tpc_two_paths_cross_of_sep hsep
    haBox hbBox haLeft hbRight H hHBox
  change z ∈ Vc.support at hzVc
  dsimp only [Vc] at hzVc
  rw [SimpleGraph.Walk.mem_support_append_iff,
    SimpleGraph.Walk.mem_support_append_iff] at hzVc
  rcases hzVc with (hzPre | hzV) | hzPost
  · refine ⟨z, hzH, hpre z hzH ?_⟩
    simpa [pre, SimpleGraph.Walk.support_copy] using hzPre
  · exact ⟨z, hzH, hzV⟩
  · refine ⟨z, hzH, hpost z hzH ?_⟩
    simpa [post, SimpleGraph.Walk.support_copy] using hzPost





structure RlcTwoChannelFullPhysicalCyclicOrderCrossingData
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') where
  x : Site 2
  y : Site 2
  right_contact : rlc_dualReflect x ∈ rlc_pathVertices gamma.1
  left_contact : rlc_dualReflect y ∈ rlc_pathVertices gamma'.1
  right_contact_position : (x 0 = -1 ∧ x 1 < -1) ∨ x 0 < -1
  left_contact_position : (y 0 = -1 ∧ 0 ≤ y 1) ∨ 0 ≤ y 0
  arc : (faceBoundaryGraph
    (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk x y
  alpha : Int
  beta : Int
  bottom : Int
  top : Int
  alpha_lt_beta : alpha < beta
  bottom_le_top : bottom ≤ top
  x_mem_box : x ∈ rect alpha beta bottom top
  y_mem_box : y ∈ rect alpha beta bottom top
  arc_mem_box : ∀ z ∈ arc.support, z ∈ rect alpha beta bottom top
  traceStart : Site 2
  traceEnd : Site 2
  trace : (hypercubicLattice 2).Walk traceStart traceEnd
  traceStart_mem_box : traceStart ∈ rect alpha beta bottom top
  traceEnd_mem_box : traceEnd ∈ rect alpha beta bottom top
  traceStart_left : traceStart 0 = alpha
  traceEnd_right : traceEnd 0 = beta
  trace_mem_box : ∀ z ∈ trace.support,
    z ∈ rect alpha beta bottom top



structure RlcTwoChannelFullPhysicalCyclicOrderCrossingCertificate
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    extends RlcTwoChannelFullPhysicalCyclicOrderCrossingData
      gamma gamma' omega where
  lower_collar_contact : ∀ z ∈ trace.support,
    z ∈ (sw_vertSeg (x 0) bottom (x 1)).support → z ∈ arc.support
  upper_collar_contact : ∀ z ∈ trace.support,
    z ∈ (sw_vertSeg (y 0) (y 1) top).support → z ∈ arc.support
  trace_disjoint_arc : ∀ z ∈ trace.support, z ∉ arc.support




def rlc_twoChannelFullPhysical_cyclicOrderCrossingData_of_contactCycle
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {u x y : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support)
    (hxPath : rlc_dualReflect x ∈ rlc_pathVertices gamma.1)
    (hyPath : rlc_dualReflect y ∈ rlc_pathVertices gamma'.1)
    (alpha beta bottom top : Int)
    (hab : alpha < beta) (hbt : bottom ≤ top)
    (hxBox : x ∈ rect alpha beta bottom top)
    (hyBox : y ∈ rect alpha beta bottom top)
    (hcBox : ∀ z ∈ c.support, z ∈ rect alpha beta bottom top)
    (traceStart traceEnd : Site 2)
    (trace : (hypercubicLattice 2).Walk traceStart traceEnd)
    (hstartBox : traceStart ∈ rect alpha beta bottom top)
    (hendBox : traceEnd ∈ rect alpha beta bottom top)
    (hstart : traceStart 0 = alpha) (hend : traceEnd 0 = beta)
    (htraceBox : ∀ z ∈ trace.support,
      z ∈ rect alpha beta bottom top) :
    RlcTwoChannelFullPhysicalCyclicOrderCrossingData
      gamma gamma' omega := by
  let arc := rlc_orderedContourArc c hx hy
  have harcBox : ∀ z ∈ arc.support,
      z ∈ rect alpha beta bottom top := by
    intro z hz
    apply hcBox z
    have hzRotate : z ∈ (c.rotate x hx).support :=
      (c.rotate x hx).support_takeUntil_subset_support
        ((SimpleGraph.Walk.mem_support_rotate_iff c x hx).2 hy) hz
    exact (SimpleGraph.Walk.mem_support_rotate_iff c x hx).1 hzRotate
  exact {
    x := x
    y := y
    right_contact := hxPath
    left_contact := hyPath
    right_contact_position := hfaith.dualFace_rightContact_position hxPath
    left_contact_position := hfaith.dualFace_leftContact_position hyPath
    arc := arc
    alpha := alpha
    beta := beta
    bottom := bottom
    top := top
    alpha_lt_beta := hab
    bottom_le_top := hbt
    x_mem_box := hxBox
    y_mem_box := hyBox
    arc_mem_box := harcBox
    traceStart := traceStart
    traceEnd := traceEnd
    trace := trace
    traceStart_mem_box := hstartBox
    traceEnd_mem_box := hendBox
    traceStart_left := hstart
    traceEnd_right := hend
    trace_mem_box := htraceBox }



def RlcTwoChannelFullPhysicalCyclicOrderCrossingData.toCertificate
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    (D : RlcTwoChannelFullPhysicalCyclicOrderCrossingData
      gamma gamma' omega)
    (hpre : ∀ z ∈ D.trace.support,
      z ∈ (sw_vertSeg (D.x 0) D.bottom (D.x 1)).support →
        z ∈ D.arc.support)
    (hpost : ∀ z ∈ D.trace.support,
      z ∈ (sw_vertSeg (D.y 0) (D.y 1) D.top).support →
        z ∈ D.arc.support)
    (hdisjoint : ∀ z ∈ D.trace.support, z ∉ D.arc.support) :
    RlcTwoChannelFullPhysicalCyclicOrderCrossingCertificate
      gamma gamma' omega where
  toRlcTwoChannelFullPhysicalCyclicOrderCrossingData := D
  lower_collar_contact := hpre
  upper_collar_contact := hpost
  trace_disjoint_arc := hdisjoint




theorem rlc_twoChannelFullPhysical_not_cyclicOrderCrossingCertificate
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    (C : RlcTwoChannelFullPhysicalCyclicOrderCrossingCertificate
      gamma gamma' omega) : False := by
  let V := C.arc.mapLe
    (faceBoundaryGraph_le
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega))
  have hVBox : ∀ z ∈ V.support,
      z ∈ rect C.alpha C.beta C.bottom C.top := by
    intro z hz
    apply C.arc_mem_box z
    simpa [V, SimpleGraph.Walk.support_mapLe_eq_support] using hz
  have hpre : ∀ z ∈ C.trace.support,
      z ∈ (sw_vertSeg (C.x 0) C.bottom (C.x 1)).support →
        z ∈ V.support := by
    intro z hzTrace hzCollar
    simpa [V, SimpleGraph.Walk.support_mapLe_eq_support] using
      C.lower_collar_contact z hzTrace hzCollar
  have hpost : ∀ z ∈ C.trace.support,
      z ∈ (sw_vertSeg (C.y 0) (C.y 1) C.top).support →
        z ∈ V.support := by
    intro z hzTrace hzCollar
    simpa [V, SimpleGraph.Walk.support_mapLe_eq_support] using
      C.upper_collar_contact z hzTrace hzCollar
  obtain ⟨z, hzTrace, hzV⟩ :=
    rlc_collaredVerticalArc_meets_leftRightWalk
      C.alpha_lt_beta C.bottom_le_top C.x_mem_box C.y_mem_box
        V hVBox C.trace C.traceStart_mem_box C.traceEnd_mem_box
          C.traceStart_left C.traceEnd_right C.trace_mem_box hpre hpost
  apply C.trace_disjoint_arc z hzTrace
  simpa [V, SimpleGraph.Walk.support_mapLe_eq_support] using hzV



theorem rlc_bookRightIntersectionRank_strict_of_ne {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    {z r : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hrRight : r ∈ rlc_pathVertices gamma.1)
    (hrLeft : rlc_flipX r ∈ rlc_pathVertices gamma'.1)
    (hrank : RlcBookRightIntersectionRankRealizedAt gamma right)
    (hmin : RlcBookRightIntersectionRankMinimalAt gamma gamma' right)
    (hrz : r ≠ z) :
    right.length < (rlc_ambientCrossingWalk gamma.1).support.idxOf r := by
  let W := rlc_ambientCrossingWalk gamma.1
  have hzW : z ∈ W.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2
      hzRight
  have hrW : r ∈ W.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 r).2
      hrRight
  have hle : right.length ≤ W.support.idxOf r := by
    simpa [W] using hmin r hrRight hrLeft
  have hne : right.length ≠ W.support.idxOf r := by
    intro heq
    apply hrz
    have hrank' : right.length = W.support.idxOf z := by
      simpa [RlcBookRightIntersectionRankRealizedAt, W] using hrank
    have hidx : W.support.idxOf z = W.support.idxOf r :=
      hrank'.symm.trans heq
    exact ((List.idxOf_inj hzW).1 hidx).symm
  change right.length < W.support.idxOf r
  omega




theorem rlc_twoChannelFullPhysical_leftContact_reflectedRight_rank_progress
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {z y u : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2))
    (q : (rlc_twoChannelFullPhysicalGoodBoundaryGraph
      gamma gamma' omega).Walk y u)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hyLeft : rlc_dualReflect y ∈ rlc_pathVertices gamma'.1)
    (hyOrder : rlc_flipX (rlc_dualReflect y) ∈ flipLeft.support)
    (hrank : RlcBookRightIntersectionRankRealizedAt gamma right)
    (hmin : RlcBookRightIntersectionRankMinimalAt gamma gamma' right)
    (hedges : ∀ e ∈ q.edges,
      Sym2.map rlc_dualReflect e ∈ rlc_reflectedPathEdges gamma.1)
    (huRight : ∃ r ∈ rlc_pathVertices gamma.1,
      rlc_dualReflect u = rlc_flipX r) :
    ∃ r ∈ rlc_pathVertices gamma.1,
      rlc_dualReflect y = rlc_flipX r ∧
        r ∈ flipLeft.support ∧
        (r = z ∨
          right.length <
            (rlc_ambientCrossingWalk gamma.1).support.idxOf r) := by
  obtain ⟨r, hrRight, hyr⟩ :=
    rlc_twoChannelFullPhysical_reflectedRightWalk_start q hedges huRight
  have hrSuffix : r ∈ flipLeft.support := by
    rw [hyr] at hyOrder
    simpa using hyOrder
  have hrLeft : rlc_flipX r ∈ rlc_pathVertices gamma'.1 := by
    rw [hyr] at hyLeft
    simpa using hyLeft
  refine ⟨r, hrRight, hyr, hrSuffix, ?_⟩
  by_cases hrz : r = z
  · exact Or.inl hrz
  · exact Or.inr
      (rlc_bookRightIntersectionRank_strict_of_ne
        right hzRight hrRight hrLeft hrank hmin hrz)



theorem RlcBookFaithfulTracePair.intersection_ne_flip {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {z : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    z ≠ rlc_flipX z := by
  intro hzFlip
  have hz0 : z 0 = 0 := by
    have h0 := congrArg (fun w : Site 2 => w 0) hzFlip
    change z 0 = -z 0 at h0
    omega
  have hzRightAxis := hfaith.right_axis_unique hzRight hz0
  have hzLeft' : z ∈ rlc_pathVertices gamma'.1 := by
    simpa [← hzFlip] using hzLeft
  have hzLeftAxis := hfaith.left_axis_unique hzLeft' hz0
  have hcontacts : (gamma.1.1 : Site 2) =
      (gamma'.1.2.1 : Site 2) := hzRightAxis.symm.trans hzLeftAxis
  have hheight := congrArg (fun w : Site 2 => w 1) hcontacts
  exact (ne_of_lt hfaith.axis_contacts_strict) hheight



theorem RlcBookFaithfulTracePair.intersection_positive {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {z : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    0 < z 0 := by
  apply hfaith.right_vertex_strict hzRight
  intro hzStart
  apply hfaith.intersection_ne_flip hzRight hzLeft
  rw [hzStart]
  exact (rlc_flipX_eq_self_of_zero gamma.1.1.2.2).symm




noncomputable def rlc_bookShiftedOuterCoreTrace {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm (gamma.1.2.1 : Site 2))
      (rlc_dualReflect.symm (gamma'.1.1 : Site 2)) := by
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hzWR : z ∈ WR.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2 hzRight
  have hzWL : rlc_flipX z ∈ WL.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
      gamma'.1 (rlc_flipX z)).2 hzLeft
  let rightOuter := WR.dropUntil z hzWR
  let leftOuter := WL.takeUntil (rlc_flipX z) hzWL
  have hmiddleStart : (![(-z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm z := by
    ext i
    fin_cases i <;> simp
  have hmiddleEnd : (![(z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm (rlc_flipX z) := by
    ext i
    fin_cases i <;> simp [rlc_flipX, rlc_flipXFun]
  let middle : (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm z)
      (rlc_dualReflect.symm (rlc_flipX z)) :=
    (sw_horizSeg (z 1 - 1) (-z 0 - 1) (z 0 - 1)).copy
      hmiddleStart hmiddleEnd
  exact (((rightOuter.map rlc_dualReflectSymmLatticeHom).reverse.append
    middle).append (leftOuter.map rlc_dualReflectSymmLatticeHom).reverse)



noncomputable def rlc_bookShiftedOuterTrace {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm (gamma.1.2.1 : Site 2))
      ![2 * n, (rlc_dualReflect.symm (gamma'.1.1 : Site 2)) 1] := by
  let core := rlc_bookShiftedOuterCoreTrace gamma gamma' hzRight hzLeft
  let q : Site 2 := rlc_dualReflect.symm (gamma'.1.1 : Site 2)
  have hqCoord : (![q 0, q 1] : Site 2) = q := by
    ext i
    fin_cases i <;> simp
  let extension : (hypercubicLattice 2).Walk q ![2 * n, q 1] :=
    (sw_horizSeg (q 1) (q 0) (2 * n)).copy hqCoord rfl
  exact core.append extension



theorem rlc_bookShiftedOuterTrace_bridge_endpoints_mem {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    rlc_dualReflect.symm z ∈
        (rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft).support ∧
      rlc_dualReflect.symm (rlc_flipX z) ∈
        (rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft).support := by
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hzWR : z ∈ WR.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2 hzRight
  have hzWL : rlc_flipX z ∈ WL.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
      gamma'.1 (rlc_flipX z)).2 hzLeft
  let rightOuter := WR.dropUntil z hzWR
  let leftOuter := WL.takeUntil (rlc_flipX z) hzWL
  have hmiddleStart : (![(-z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm z := by
    ext i
    fin_cases i <;> simp
  have hmiddleEnd : (![(z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm (rlc_flipX z) := by
    ext i
    fin_cases i <;> simp [rlc_flipX, rlc_flipXFun]
  let middle : (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm z)
      (rlc_dualReflect.symm (rlc_flipX z)) :=
    (sw_horizSeg (z 1 - 1) (-z 0 - 1) (z 0 - 1)).copy
      hmiddleStart hmiddleEnd
  let core := (((rightOuter.map
    rlc_dualReflectSymmLatticeHom).reverse.append middle).append
      (leftOuter.map rlc_dualReflectSymmLatticeHom).reverse)
  let q : Site 2 := rlc_dualReflect.symm (gamma'.1.1 : Site 2)
  have hqCoord : (![q 0, q 1] : Site 2) = q := by
    ext i
    fin_cases i <;> simp
  let extension : (hypercubicLattice 2).Walk q ![2 * n, q 1] :=
    (sw_horizSeg (q 1) (q 0) (2 * n)).copy hqCoord rfl
  change rlc_dualReflect.symm z ∈ (core.append extension).support ∧
    rlc_dualReflect.symm (rlc_flipX z) ∈ (core.append extension).support
  constructor
  · rw [SimpleGraph.Walk.mem_support_append_iff]
    left
    change rlc_dualReflect.symm z ∈
      (((rightOuter.map rlc_dualReflectSymmLatticeHom).reverse.append
        middle).append
          (leftOuter.map rlc_dualReflectSymmLatticeHom).reverse).support
    rw [SimpleGraph.Walk.mem_support_append_iff,
      SimpleGraph.Walk.mem_support_append_iff]
    exact Or.inl (Or.inr middle.start_mem_support)
  · rw [SimpleGraph.Walk.mem_support_append_iff]
    left
    change rlc_dualReflect.symm (rlc_flipX z) ∈
      (((rightOuter.map rlc_dualReflectSymmLatticeHom).reverse.append
        middle).append
          (leftOuter.map rlc_dualReflectSymmLatticeHom).reverse).support
    rw [SimpleGraph.Walk.mem_support_append_iff,
      SimpleGraph.Walk.mem_support_append_iff]
    exact Or.inl (Or.inr middle.end_mem_support)



theorem rlc_bookShiftedOuterTrace_forced_contacts_mem_orderedArc {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {u x y z : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hxEq : rlc_dualReflect x = z)
    (hyEq : rlc_dualReflect y = rlc_flipX z) :
    (x ∈ (rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft).support ∧
        x ∈ (rlc_orderedContourArc c hx hy).support) ∧
      (y ∈ (rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft).support ∧
        y ∈ (rlc_orderedContourArc c hx hy).support) := by
  have hbridge := rlc_bookShiftedOuterTrace_bridge_endpoints_mem
    gamma gamma' hzRight hzLeft
  have hxBridge : rlc_dualReflect.symm z = x := by
    rw [← hxEq]
    exact rlc_dualReflect.symm_apply_apply x
  have hyBridge : rlc_dualReflect.symm (rlc_flipX z) = y := by
    rw [← hyEq]
    exact rlc_dualReflect.symm_apply_apply y
  exact ⟨⟨by simpa [hxBridge] using hbridge.1,
      (rlc_orderedContourArc c hx hy).start_mem_support⟩,
    ⟨by simpa [hyBridge] using hbridge.2,
      (rlc_orderedContourArc c hx hy).end_mem_support⟩⟩




theorem rlc_bookShiftedOuterTrace_forced_contacts_distinct {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {u x y z : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hxEq : rlc_dualReflect x = z)
    (hyEq : rlc_dualReflect y = rlc_flipX z) :
    ((x ∈ (rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft).support ∧
          x ∈ (rlc_orderedContourArc c hx hy).support) ∧
        (y ∈ (rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft).support ∧
          y ∈ (rlc_orderedContourArc c hx hy).support)) ∧
      x ≠ y := by
  refine ⟨rlc_bookShiftedOuterTrace_forced_contacts_mem_orderedArc
      c hx hy hzRight hzLeft hxEq hyEq, ?_⟩
  intro hxy
  apply hfaith.intersection_ne_flip hzRight hzLeft
  exact hxEq.symm.trans ((congrArg rlc_dualReflect hxy).trans hyEq)




noncomputable def rlc_bookShiftedInnerTrace {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2)) :
    (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm (gamma.1.1 : Site 2))
      (phb_doubleDualShift (gamma'.1.2.1 : Site 2)) := by
  have hmiddleStart : (![(-z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm z := by
    ext i
    fin_cases i <;> simp
  have hmiddleEnd : (![(z 0 - 1), z 1 - 1] : Site 2) =
      phb_doubleDualShift z := by
    ext i
    fin_cases i <;> simp [phb_doubleDualShift]
  let middle : (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm z) (phb_doubleDualShift z) :=
    (sw_horizSeg (z 1 - 1) (-z 0 - 1) (z 0 - 1)).copy
      hmiddleStart hmiddleEnd
  exact ((right.map rlc_dualReflectSymmLatticeHom).append middle).append
    (flipLeft.map rlc_doubleDualShiftLatticeHom)



theorem rlc_bookShiftedInnerTrace_contacts {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    {z x y : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2))
    (hxOrder : rlc_flipX (rlc_dualReflect x) ∈
      (right.map rlc_flipXLatticeHom).support)
    (hyOrder : rlc_flipX (rlc_dualReflect y) ∈ flipLeft.support) :
    x ∈ (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).support ∧
      y ∈ (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).support := by
  let inner := rlc_bookShiftedInnerTrace gamma gamma' right flipLeft
  have hxRight : rlc_dualReflect x ∈ right.support := by
    rw [SimpleGraph.Walk.support_map, List.mem_map] at hxOrder
    obtain ⟨w, hw, hwx⟩ := hxOrder
    have hwEq : w = rlc_dualReflect x := by
      apply rlc_flipX.injective
      exact hwx
    simpa [hwEq] using hw
  have hxMapped : x ∈
      (right.map rlc_dualReflectSymmLatticeHom).support := by
    rw [SimpleGraph.Walk.support_map, List.mem_map]
    refine ⟨rlc_dualReflect x, hxRight, ?_⟩
    change rlc_dualReflect.symm (rlc_dualReflect x) = x
    exact rlc_dualReflect.symm_apply_apply x
  have hyMapped : y ∈
      (flipLeft.map rlc_doubleDualShiftLatticeHom).support := by
    rw [SimpleGraph.Walk.support_map, List.mem_map]
    refine ⟨rlc_flipX (rlc_dualReflect y), hyOrder, ?_⟩
    change phb_doubleDualShift (rlc_flipX (rlc_dualReflect y)) = y
    rw [rlc_doubleDualShift_flipX_eq_dualReflect_symm]
    exact rlc_dualReflect.symm_apply_apply y
  constructor
  · change x ∈ (((right.map rlc_dualReflectSymmLatticeHom).append _).append
      (flipLeft.map rlc_doubleDualShiftLatticeHom)).support
    rw [SimpleGraph.Walk.mem_support_append_iff,
      SimpleGraph.Walk.mem_support_append_iff]
    exact Or.inl (Or.inl hxMapped)
  · change y ∈ (((right.map rlc_dualReflectSymmLatticeHom).append _).append
      (flipLeft.map rlc_doubleDualShiftLatticeHom)).support
    rw [SimpleGraph.Walk.mem_support_append_iff]
    exact Or.inr hyMapped



theorem rlc_bookShiftedInnerTrace_contact_indices {n : Int}
    {gamma : RlcRightDiagonalPath n} {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {z x y : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2))
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hxOrder : rlc_flipX (rlc_dualReflect x) ∈
      (right.map rlc_flipXLatticeHom).support)
    (hyOrder : rlc_flipX (rlc_dualReflect y) ∈ flipLeft.support) :
    ∃ i j : Nat,
      i ≤ j ∧
        j ≤ (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).length ∧
        (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).getVert i = x ∧
        (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).getVert j = y := by
  let P := right.map rlc_dualReflectSymmLatticeHom
  let Q := flipLeft.map rlc_doubleDualShiftLatticeHom
  have hxRight : rlc_dualReflect x ∈ right.support := by
    rw [SimpleGraph.Walk.support_map, List.mem_map] at hxOrder
    obtain ⟨w, hw, hwx⟩ := hxOrder
    have hwEq : w = rlc_dualReflect x := by
      apply rlc_flipX.injective
      exact hwx
    simpa [hwEq] using hw
  have hxP : x ∈ P.support := by
    rw [SimpleGraph.Walk.support_map, List.mem_map]
    refine ⟨rlc_dualReflect x, hxRight, ?_⟩
    exact rlc_dualReflect.symm_apply_apply x
  have hyQ : y ∈ Q.support := by
    rw [SimpleGraph.Walk.support_map, List.mem_map]
    refine ⟨rlc_flipX (rlc_dualReflect y), hyOrder, ?_⟩
    change phb_doubleDualShift (rlc_flipX (rlc_dualReflect y)) = y
    rw [rlc_doubleDualShift_flipX_eq_dualReflect_symm]
    exact rlc_dualReflect.symm_apply_apply y
  obtain ⟨i, hi, hiLen⟩ :=
    SimpleGraph.Walk.mem_support_iff_exists_getVert.mp hxP
  obtain ⟨j, hj, hjLen⟩ :=
    SimpleGraph.Walk.mem_support_iff_exists_getVert.mp hyQ
  have hmiddleStart : (![(-z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm z := by
    ext k
    fin_cases k <;> simp
  have hmiddleEnd : (![(z 0 - 1), z 1 - 1] : Site 2) =
      phb_doubleDualShift z := by
    ext k
    fin_cases k <;> simp [phb_doubleDualShift]
  let M : (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm z) (phb_doubleDualShift z) :=
    (sw_horizSeg (z 1 - 1) (-z 0 - 1) (z 0 - 1)).copy
      hmiddleStart hmiddleEnd
  have hMEnds : rlc_dualReflect.symm z ≠ phb_doubleDualShift z := by
    intro heq
    have h0 := congrArg (fun w : Site 2 => w 0) heq
    simp only [rlc_dualReflect_symm_zero, phb_doubleDualShift,
      Matrix.cons_val_zero] at h0
    have hzPos := hfaith.intersection_positive hzRight hzLeft
    omega
  have hMPos : 0 < M.length := by
    rw [← SimpleGraph.Walk.not_nil_iff_lt_length]
    exact M.not_nil_of_ne hMEnds
  let j0 := (P.append M).length + j
  have hiPrefix : i < (P.append M).length := by
    calc
      i ≤ P.length := hiLen
      _ < P.length + M.length := Nat.lt_add_of_pos_right hMPos
      _ = (P.append M).length := (SimpleGraph.Walk.length_append P M).symm
  have hInnerI :
      (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).getVert i = x := by
    change ((P.append M).append Q).getVert i = x
    rw [SimpleGraph.Walk.getVert_append, if_pos hiPrefix,
      SimpleGraph.Walk.getVert_append]
    by_cases hiLt : i < P.length
    · rw [if_pos hiLt]
      exact hi
    · rw [if_neg hiLt]
      have hiEq : i = P.length := by omega
      subst i
      simpa using hi
  have hInnerJ :
      (rlc_bookShiftedInnerTrace gamma gamma' right flipLeft).getVert j0 = y := by
    change ((P.append M).append Q).getVert j0 = y
    rw [SimpleGraph.Walk.getVert_append, if_neg (by simp [j0]),
      show j0 - (P.append M).length = j by simp [j0]]
    exact hj
  refine ⟨i, j0, ?_, ?_, hInnerI, hInnerJ⟩
  · dsimp only [j0]
    have hiP : i ≤ P.length := hiLen
    omega
  · change j0 ≤ ((P.append M).append Q).length
    simp only [j0, SimpleGraph.Walk.length_append]
    exact Nat.add_le_add_left hjLen _



theorem rlc_bookShiftedOuterCoreTrace_mem_faceBox {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z v : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hv : v ∈ (rlc_bookShiftedOuterCoreTrace
      gamma gamma' hzRight hzLeft).support) :
    v ∈ rect (-2 * n - 1) (2 * n) (-n - 1) n := by
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hzWR : z ∈ WR.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2 hzRight
  have hzWL : rlc_flipX z ∈ WL.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
      gamma'.1 (rlc_flipX z)).2 hzLeft
  let rightOuter := WR.dropUntil z hzWR
  let leftOuter := WL.takeUntil (rlc_flipX z) hzWL
  have hmiddleStart : (![(-z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm z := by
    ext i
    fin_cases i <;> simp
  have hmiddleEnd : (![(z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm (rlc_flipX z) := by
    ext i
    fin_cases i <;> simp [rlc_flipX, rlc_flipXFun]
  let middle : (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm z)
      (rlc_dualReflect.symm (rlc_flipX z)) :=
    (sw_horizSeg (z 1 - 1) (-z 0 - 1) (z 0 - 1)).copy
      hmiddleStart hmiddleEnd
  change v ∈ ((((rightOuter.map rlc_dualReflectSymmLatticeHom).reverse.append
    middle).append
      (leftOuter.map rlc_dualReflectSymmLatticeHom).reverse).support) at hv
  rw [SimpleGraph.Walk.mem_support_append_iff,
    SimpleGraph.Walk.mem_support_append_iff] at hv
  rcases hv with (hvRight | hvMiddle) | hvLeft
  · rw [SimpleGraph.Walk.support_reverse, List.mem_reverse,
      SimpleGraph.Walk.support_map, List.mem_map] at hvRight
    obtain ⟨w, hw, rfl⟩ := hvRight
    change rlc_dualReflect.symm w ∈
      rect (-2 * n - 1) (2 * n) (-n - 1) n
    have hwWR : w ∈ WR.support := WR.support_dropUntil_subset hzWR hw
    have hwPath :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 w).1 hwWR
    have hwBox := rlc_pathVertex_mem_rect gamma.1 hwPath
    rw [mem_rect] at hwBox ⊢
    simp only [rlc_dualReflect_symm_zero, rlc_dualReflect_symm_one]
    omega
  · change v ∈ ((sw_horizSeg (z 1 - 1) (-z 0 - 1)
      (z 0 - 1)).copy hmiddleStart hmiddleEnd).support at hvMiddle
    rw [SimpleGraph.Walk.support_copy, sw_horizSeg_mem_support] at hvMiddle
    obtain ⟨t, ht, rfl⟩ := hvMiddle
    have hzBox := rlc_pathVertex_mem_rect gamma.1 hzRight
    rw [Set.mem_uIcc] at ht
    rw [mem_rect] at hzBox ⊢
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    rcases ht with ht | ht <;> omega
  · have hvLeft' : v ∈
        (leftOuter.map rlc_dualReflectSymmLatticeHom).support := by
      have hrev : v ∈
          (leftOuter.map rlc_dualReflectSymmLatticeHom).support.reverse :=
        (congrArg (fun l => v ∈ l)
          (SimpleGraph.Walk.support_reverse
            (leftOuter.map rlc_dualReflectSymmLatticeHom))).mp hvLeft
      exact List.mem_reverse.mp hrev
    rw [SimpleGraph.Walk.support_map, List.mem_map] at hvLeft'
    obtain ⟨w, hw, rfl⟩ := hvLeft'
    change rlc_dualReflect.symm w ∈
      rect (-2 * n - 1) (2 * n) (-n - 1) n
    have hwWL : w ∈ WL.support := WL.support_takeUntil_subset_support hzWL hw
    have hwPath :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma'.1 w).1 hwWL
    have hwBox := rlc_pathVertex_mem_rect gamma'.1 hwPath
    rw [mem_rect] at hwBox ⊢
    simp only [rlc_dualReflect_symm_zero, rlc_dualReflect_symm_one]
    omega


theorem rlc_bookShiftedOuterTrace_mem_faceBox {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z v : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hv : v ∈ (rlc_bookShiftedOuterTrace
      gamma gamma' hzRight hzLeft).support) :
    v ∈ rect (-2 * n - 1) (2 * n) (-n - 1) n := by
  let core := rlc_bookShiftedOuterCoreTrace gamma gamma' hzRight hzLeft
  let q : Site 2 := rlc_dualReflect.symm (gamma'.1.1 : Site 2)
  have hqCoord : (![q 0, q 1] : Site 2) = q := by
    ext i
    fin_cases i <;> simp
  let extension : (hypercubicLattice 2).Walk q ![2 * n, q 1] :=
    (sw_horizSeg (q 1) (q 0) (2 * n)).copy hqCoord rfl
  change v ∈ (core.append extension).support at hv
  rw [SimpleGraph.Walk.mem_support_append_iff] at hv
  rcases hv with hvCore | hvExtension
  · exact rlc_bookShiftedOuterCoreTrace_mem_faceBox
      gamma gamma' hzRight hzLeft hvCore
  · change v ∈ ((sw_horizSeg (q 1) (q 0) (2 * n)).copy
      hqCoord rfl).support at hvExtension
    rw [SimpleGraph.Walk.support_copy, sw_horizSeg_mem_support] at hvExtension
    obtain ⟨t, ht, rfl⟩ := hvExtension
    have hqBox := rlc_pathVertex_mem_rect gamma'.1
      (rlc_path_start_mem_vertices gamma'.1)
    have hq0 : q 0 = 2 * n - 1 := by
      simp [q, gamma'.1.1.2.2]
    rw [Set.mem_uIcc] at ht
    rw [mem_rect] at hqBox ⊢
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    simp only [q, rlc_dualReflect_symm_one] at hqBox ⊢
    rcases ht with ht | ht <;> omega


theorem rlc_bookShiftedOuterTrace_support_cases {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {z v : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hv : v ∈ (rlc_bookShiftedOuterTrace
      gamma gamma' hzRight hzLeft).support) :
    (∃ w ∈ rlc_pathVertices gamma.1,
        v = rlc_dualReflect.symm w) ∨
      (∃ t : Int, t ∈ Set.uIcc (-z 0 - 1) (z 0 - 1) ∧
        v = ![t, z 1 - 1]) ∨
      (∃ w ∈ rlc_pathVertices gamma'.1,
        v = rlc_dualReflect.symm w) ∨
      ∃ t : Int,
        t ∈ Set.uIcc
          ((rlc_dualReflect.symm (gamma'.1.1 : Site 2)) 0) (2 * n) ∧
        v = ![t, (rlc_dualReflect.symm (gamma'.1.1 : Site 2)) 1] := by
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hzWR : z ∈ WR.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2 hzRight
  have hzWL : rlc_flipX z ∈ WL.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
      gamma'.1 (rlc_flipX z)).2 hzLeft
  let rightOuter := WR.dropUntil z hzWR
  let leftOuter := WL.takeUntil (rlc_flipX z) hzWL
  have hmiddleStart : (![(-z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm z := by
    ext i
    fin_cases i <;> simp
  have hmiddleEnd : (![(z 0 - 1), z 1 - 1] : Site 2) =
      rlc_dualReflect.symm (rlc_flipX z) := by
    ext i
    fin_cases i <;> simp [rlc_flipX, rlc_flipXFun]
  let middle : (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm z)
      (rlc_dualReflect.symm (rlc_flipX z)) :=
    (sw_horizSeg (z 1 - 1) (-z 0 - 1) (z 0 - 1)).copy
      hmiddleStart hmiddleEnd
  let q : Site 2 := rlc_dualReflect.symm (gamma'.1.1 : Site 2)
  have hqCoord : (![q 0, q 1] : Site 2) = q := by
    ext i
    fin_cases i <;> simp
  let extension : (hypercubicLattice 2).Walk q ![2 * n, q 1] :=
    (sw_horizSeg (q 1) (q 0) (2 * n)).copy hqCoord rfl
  change v ∈ (((((rightOuter.map
      rlc_dualReflectSymmLatticeHom).reverse.append middle).append
        (leftOuter.map rlc_dualReflectSymmLatticeHom).reverse).append
          extension).support) at hv
  rw [SimpleGraph.Walk.mem_support_append_iff,
    SimpleGraph.Walk.mem_support_append_iff,
    SimpleGraph.Walk.mem_support_append_iff] at hv
  rcases hv with ((hvRight | hvMiddle) | hvLeft) | hvExtension
  · rw [SimpleGraph.Walk.support_reverse, List.mem_reverse,
      SimpleGraph.Walk.support_map, List.mem_map] at hvRight
    obtain ⟨w, hw, rfl⟩ := hvRight
    have hwWR : w ∈ WR.support := WR.support_dropUntil_subset hzWR hw
    exact Or.inl ⟨w,
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 w).1
        hwWR, rfl⟩
  · change v ∈ ((sw_horizSeg (z 1 - 1) (-z 0 - 1)
      (z 0 - 1)).copy hmiddleStart hmiddleEnd).support at hvMiddle
    rw [SimpleGraph.Walk.support_copy, sw_horizSeg_mem_support] at hvMiddle
    exact Or.inr (Or.inl hvMiddle)
  · have hvLeft' : v ∈
        (leftOuter.map rlc_dualReflectSymmLatticeHom).support := by
      have hrev : v ∈
          (leftOuter.map rlc_dualReflectSymmLatticeHom).support.reverse :=
        (congrArg (fun l => v ∈ l)
          (SimpleGraph.Walk.support_reverse
            (leftOuter.map rlc_dualReflectSymmLatticeHom))).mp hvLeft
      exact List.mem_reverse.mp hrev
    rw [SimpleGraph.Walk.support_map, List.mem_map] at hvLeft'
    obtain ⟨w, hw, rfl⟩ := hvLeft'
    have hwWL : w ∈ WL.support := WL.support_takeUntil_subset_support hzWL hw
    exact Or.inr (Or.inr (Or.inl ⟨w,
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma'.1 w).1
        hwWL, rfl⟩))
  · change v ∈ ((sw_horizSeg (q 1) (q 0) (2 * n)).copy
      hqCoord rfl).support at hvExtension
    rw [SimpleGraph.Walk.support_copy, sw_horizSeg_mem_support] at hvExtension
    simpa [q] using Or.inr (Or.inr (Or.inr hvExtension))


theorem rlc_bookShiftedOuterTrace_start_left {n : Int}
    (gamma : RlcRightDiagonalPath n) :
    (rlc_dualReflect.symm (gamma.1.2.1 : Site 2)) 0 = -2 * n - 1 := by
  rw [rlc_dualReflect_symm_zero]
  have hright : ((gamma.1.2.1 : Site 2) 0) = 2 * n := gamma.1.2.1.2.2
  omega



theorem rlc_twoChannelFullPhysical_filledBoundaryCycle_mem_faceBox
    {n : Int} (hn : 0 < n)
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {u v : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hcycle : c.IsCycle) (hv : v ∈ c.support) :
    v ∈ rect (-2 * n - 1) (2 * n) (-n - 1) n := by
  have hcNotNil : ¬c.Nil := by
    intro hnil
    exact hcycle.ne_nil hnil.eq_nil
  have huSupport : u ∈ (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).support :=
    (c.adj_snd hcNotNil).mem_support_left
  have hvRef := rlc_twoChannelFullFilledBoundaryWalk_reflect_mem_outerBox
    hn gamma gamma' omega c huSupport hv
  rw [rlc_twoChannelFullOuterBox, mem_rect] at hvRef
  rw [mem_rect]
  simp only [rlc_dualReflect_zero, rlc_dualReflect_one] at hvRef
  omega




def rlc_twoChannelFullPhysical_cyclicOrderCrossingData_of_shiftedOuterTrace
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    {u x y z : Site 2}
    (c : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk u u)
    (hcycle : c.IsCycle)
    (hx : x ∈ c.support) (hy : y ∈ c.support)
    (hxPath : rlc_dualReflect x ∈ rlc_pathVertices gamma.1)
    (hyPath : rlc_dualReflect y ∈ rlc_pathVertices gamma'.1)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    RlcTwoChannelFullPhysicalCyclicOrderCrossingData
      gamma gamma' omega := by
  have hn : 0 < n := by
    have hbox := gamma.1.1.2.1
    rw [mem_rect] at hbox
    have hstrict := hfaith.right_axis_strict
    omega
  let trace := rlc_bookShiftedOuterTrace gamma gamma' hzRight hzLeft
  apply rlc_twoChannelFullPhysical_cyclicOrderCrossingData_of_contactCycle
    hfaith c hx hy hxPath hyPath
      (-2 * n - 1) (2 * n) (-n - 1) n
      (traceStart := rlc_dualReflect.symm (gamma.1.2.1 : Site 2))
      (traceEnd := ![2 * n,
        (rlc_dualReflect.symm (gamma'.1.1 : Site 2)) 1])
      (trace := trace)
  · omega
  · omega
  · exact rlc_twoChannelFullPhysical_filledBoundaryCycle_mem_faceBox
      hn gamma gamma' omega c hcycle hx
  · exact rlc_twoChannelFullPhysical_filledBoundaryCycle_mem_faceBox
      hn gamma gamma' omega c hcycle hy
  · intro v hv
    exact rlc_twoChannelFullPhysical_filledBoundaryCycle_mem_faceBox
      hn gamma gamma' omega c hcycle hv
  · exact rlc_bookShiftedOuterTrace_mem_faceBox
      gamma gamma' hzRight hzLeft trace.start_mem_support
  · exact rlc_bookShiftedOuterTrace_mem_faceBox
      gamma gamma' hzRight hzLeft trace.end_mem_support
  · exact rlc_bookShiftedOuterTrace_start_left gamma
  · simp
  · intro v hv
    exact rlc_bookShiftedOuterTrace_mem_faceBox
      gamma gamma' hzRight hzLeft hv



theorem rlc_twoChannelFullPhysical_intersectionImage_contacts_ne
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    {z x y : Site 2}
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hx : rlc_dualReflect x = z)
    (hy : rlc_dualReflect y = rlc_flipX z) :
    x ≠ y := by
  intro hxy
  apply hfaith.intersection_ne_flip hzRight hzLeft
  exact hx.symm.trans ((congrArg rlc_dualReflect hxy).trans hy)




noncomputable def rlc_bookOrderedIntersectionCandidateSet {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :
    Finset (Site 2) :=
  (rlc_bookFlippedTraceIntersectionSet gamma gamma').filter fun z =>
    ∀ q ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma',
      (rlc_ambientCrossingWalk gamma.1).support.idxOf q ≤
          (rlc_ambientCrossingWalk gamma.1).support.idxOf z →
        (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX z) ≤
            (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX q) →
          q = z




def rlc_bookOrderedCandidateReverseRank {n : Int}
    (gamma : RlcRightDiagonalPath n) (z : Site 2) : Nat :=
  (rlc_ambientCrossingWalk gamma.1).length -
    (rlc_ambientCrossingWalk gamma.1).support.idxOf z



theorem rlc_bookOrderedCandidateReverseRank_lt_of_rightRank_lt
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n} {z q : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hqCandidate : q ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hzq : (rlc_ambientCrossingWalk gamma.1).support.idxOf z <
      (rlc_ambientCrossingWalk gamma.1).support.idxOf q) :
    rlc_bookOrderedCandidateReverseRank gamma q <
      rlc_bookOrderedCandidateReverseRank gamma z := by
  let W := rlc_ambientCrossingWalk gamma.1
  have hzPath :=
    (Finset.mem_filter.mp (Finset.mem_filter.mp hzCandidate).1).1
  have hqPath :=
    (Finset.mem_filter.mp (Finset.mem_filter.mp hqCandidate).1).1
  have hzW : z ∈ W.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2
      hzPath
  have hqW : q ∈ W.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 q).2
      hqPath
  have hzLt := List.idxOf_lt_length_of_mem hzW
  have hqLt := List.idxOf_lt_length_of_mem hqW
  rw [SimpleGraph.Walk.length_support] at hzLt hqLt
  have hzqW : W.support.idxOf z < W.support.idxOf q := by
    simpa [W] using hzq
  simp only [rlc_bookOrderedCandidateReverseRank]
  change W.length - W.support.idxOf q < W.length - W.support.idxOf z
  omega


theorem rlc_bookFirstIntersection_mem_orderedCandidateSet
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z : Site 2}
    (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1)
    (hrank : RlcBookRightIntersectionRankRealizedAt gamma right)
    (hmin : RlcBookRightIntersectionRankMinimalAt gamma gamma' right) :
    z ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma' := by
  classical
  rw [rlc_bookOrderedIntersectionCandidateSet, Finset.mem_filter]
  constructor
  · simp [rlc_bookFlippedTraceIntersectionSet, hzRight, hzLeft]
  · intro q hq hqBefore _hzBeforeQ
    have hqMem := Finset.mem_filter.mp hq
    have hqAfter := hmin q hqMem.1 hqMem.2
    have hrank' : right.length =
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z := hrank
    have hidx : (rlc_ambientCrossingWalk gamma.1).support.idxOf q =
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z := by
      omega
    have hzW : z ∈ (rlc_ambientCrossingWalk gamma.1).support :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2
        hzRight
    exact ((List.idxOf_inj hzW).1 hidx.symm).symm



theorem rlc_bookOrderedIntersectionCandidate_rightRank_strict
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z r : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hrSet : r ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma')
    (hzrLeft :
      (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX z) ≤
        (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX r))
    (hrz : r ≠ z) :
    (rlc_ambientCrossingWalk gamma.1).support.idxOf z <
      (rlc_ambientCrossingWalk gamma.1).support.idxOf r := by
  classical
  have hrecord := (Finset.mem_filter.mp hzCandidate).2
  by_contra hnot
  have hrBefore :
      (rlc_ambientCrossingWalk gamma.1).support.idxOf r ≤
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z := by omega
  exact hrz (hrecord r hrSet hrBefore hzrLeft)



theorem rlc_bookOrderedIntersectionCandidates_order_agree
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z q : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hqCandidate : q ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma') :
    ((rlc_ambientCrossingWalk gamma.1).support.idxOf q <
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z) ↔
      ((rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX q) <
        (rlc_ambientCrossingWalk gamma'.1).support.idxOf
          (rlc_flipX z)) := by
  classical
  have hzSet := (Finset.mem_filter.mp hzCandidate).1
  have hqSet := (Finset.mem_filter.mp hqCandidate).1
  have hzRecord := (Finset.mem_filter.mp hzCandidate).2
  have hqRecord := (Finset.mem_filter.mp hqCandidate).2
  constructor
  · intro hqz
    by_contra hnot
    have hzqLeft :
        (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX z) ≤
          (rlc_ambientCrossingWalk gamma'.1).support.idxOf
            (rlc_flipX q) := by omega
    have hqzEq := hzRecord q hqSet (by omega) hzqLeft
    subst q
    simp at hqz
  · intro hqz
    by_contra hnot
    have hzqRight : (rlc_ambientCrossingWalk gamma.1).support.idxOf z ≤
        (rlc_ambientCrossingWalk gamma.1).support.idxOf q := by omega
    have hqzEq := hqRecord z hzSet hzqRight (by omega)
    subst q
    simp at hqz




theorem rlc_bookOrderedIntersectionCandidate_exists_later
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z r : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hrSet : r ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma')
    (hzrLeft :
      (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX z) ≤
        (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX r))
    (hrz : r ≠ z) :
    ∃ q ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma',
      (rlc_ambientCrossingWalk gamma.1).support.idxOf z <
          (rlc_ambientCrossingWalk gamma.1).support.idxOf q ∧
        (rlc_ambientCrossingWalk gamma.1).support.idxOf q ≤
          (rlc_ambientCrossingWalk gamma.1).support.idxOf r := by
  classical
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  let S := (rlc_bookFlippedTraceIntersectionSet gamma gamma').filter fun q =>
    WR.support.idxOf z < WR.support.idxOf q ∧
      WL.support.idxOf (rlc_flipX z) ≤
        WL.support.idxOf (rlc_flipX q)
  have hrLater := rlc_bookOrderedIntersectionCandidate_rightRank_strict
    hzCandidate hrSet hzrLeft hrz
  have hrS : r ∈ S := by
    exact Finset.mem_filter.mpr ⟨hrSet, hrLater, hzrLeft⟩
  obtain ⟨q, hqS, hqMin⟩ := Finset.exists_min_image S
    (fun w => WR.support.idxOf w) ⟨r, hrS⟩
  have hqInfo := Finset.mem_filter.mp hqS
  have hzRecord := (Finset.mem_filter.mp hzCandidate).2
  have hqCandidate : q ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma' := by
    rw [rlc_bookOrderedIntersectionCandidateSet, Finset.mem_filter]
    refine ⟨hqInfo.1, ?_⟩
    intro s hs hsBefore hqLeftS
    by_cases hsBeforeZ : WR.support.idxOf s ≤ WR.support.idxOf z
    · have hsz := hzRecord s hs hsBeforeZ
        (le_trans hqInfo.2.2 hqLeftS)
      subst s
      have hleftEq : WL.support.idxOf (rlc_flipX z) =
          WL.support.idxOf (rlc_flipX q) :=
        le_antisymm hqInfo.2.2 hqLeftS
      have hzSet := (Finset.mem_filter.mp
        (Finset.mem_filter.mp hzCandidate).1)
      have hzWL : rlc_flipX z ∈ WL.support :=
        (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
          gamma'.1 (rlc_flipX z)).2 hzSet.2
      have hflipEq : rlc_flipX z = rlc_flipX q :=
        (List.idxOf_inj hzWL).1 hleftEq
      exact rlc_flipX.injective hflipEq
    · have hsAfterZ : WR.support.idxOf z < WR.support.idxOf s := by
        omega
      have hsS : s ∈ S := Finset.mem_filter.mpr
        ⟨hs, hsAfterZ, le_trans hqInfo.2.2 hqLeftS⟩
      have hqBeforeS := hqMin s hsS
      have hrightEq : WR.support.idxOf q = WR.support.idxOf s :=
        le_antisymm hqBeforeS hsBefore
      have hqSet := Finset.mem_filter.mp hqInfo.1
      have hqWR : q ∈ WR.support :=
        (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 q).2
          hqSet.1
      exact ((List.idxOf_inj hqWR).1 hrightEq).symm
  exact ⟨q, hqCandidate, hqInfo.2.1, hqMin r hrS⟩



theorem rlc_bookOrderedIntersectionCandidate_exists_earlier
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z r : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hrSet : r ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma')
    (hrzRight :
      (rlc_ambientCrossingWalk gamma.1).support.idxOf r ≤
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z)
    (hrz : r ≠ z) :
    ∃ q ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma',
      (rlc_ambientCrossingWalk gamma.1).support.idxOf q ≤
          (rlc_ambientCrossingWalk gamma.1).support.idxOf r ∧
        (rlc_ambientCrossingWalk gamma.1).support.idxOf q <
          (rlc_ambientCrossingWalk gamma.1).support.idxOf z := by
  classical
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hzInfo := Finset.mem_filter.mp
    (Finset.mem_filter.mp hzCandidate).1
  have hrInfo := Finset.mem_filter.mp hrSet
  have hrzRight' : WR.support.idxOf r ≤ WR.support.idxOf z := by
    simpa [WR] using hrzRight
  have hrzStrict : WR.support.idxOf r < WR.support.idxOf z := by
    by_contra hnot
    have heq : WR.support.idxOf r = WR.support.idxOf z := by
      omega
    have hrW : r ∈ WR.support :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 r).2
        hrInfo.1
    exact hrz ((List.idxOf_inj hrW).1 heq)
  have hrzLeft : WL.support.idxOf (rlc_flipX r) <
      WL.support.idxOf (rlc_flipX z) := by
    by_contra hnot
    have hzBeforeR : WL.support.idxOf (rlc_flipX z) ≤
        WL.support.idxOf (rlc_flipX r) := by omega
    exact hrz ((Finset.mem_filter.mp hzCandidate).2 r hrSet hrzRight
      (by simpa [WL] using hzBeforeR))
  let S := (rlc_bookFlippedTraceIntersectionSet gamma gamma').filter fun q =>
    WR.support.idxOf q < WR.support.idxOf z ∧
      WL.support.idxOf (rlc_flipX q) < WL.support.idxOf (rlc_flipX z)
  have hrS : r ∈ S := by
    exact Finset.mem_filter.mpr ⟨hrSet, hrzStrict, hrzLeft⟩
  obtain ⟨q, hqS, hqMin⟩ := Finset.exists_min_image S
    (fun w => WR.support.idxOf w) ⟨r, hrS⟩
  have hqInfo := Finset.mem_filter.mp hqS
  have hzRecord := (Finset.mem_filter.mp hzCandidate).2
  have hqCandidate : q ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma' := by
    rw [rlc_bookOrderedIntersectionCandidateSet, Finset.mem_filter]
    refine ⟨hqInfo.1, ?_⟩
    intro s hs hsBefore hqLeftS
    have hsBeforeZ : WR.support.idxOf s < WR.support.idxOf z :=
      lt_of_le_of_lt hsBefore hqInfo.2.1
    have hsLeftZ : WL.support.idxOf (rlc_flipX s) <
        WL.support.idxOf (rlc_flipX z) := by
      by_contra hnot
      have hzLeftS : WL.support.idxOf (rlc_flipX z) ≤
          WL.support.idxOf (rlc_flipX s) := by omega
      have hsBeforeZ' :
          (rlc_ambientCrossingWalk gamma.1).support.idxOf s <
            (rlc_ambientCrossingWalk gamma.1).support.idxOf z := by
        simpa [WR] using hsBeforeZ
      have hsz := hzRecord s hs (Nat.le_of_lt hsBeforeZ')
        (by simpa [WL] using hzLeftS)
      subst s
      simp at hsBeforeZ
    have hsS : s ∈ S := Finset.mem_filter.mpr
      ⟨hs, hsBeforeZ, hsLeftZ⟩
    have hqBeforeS := hqMin s hsS
    have hrightEq : WR.support.idxOf q = WR.support.idxOf s :=
      le_antisymm hqBeforeS hsBefore
    have hqSet := Finset.mem_filter.mp hqInfo.1
    have hqWR : q ∈ WR.support :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 q).2
        hqSet.1
    exact ((List.idxOf_inj hqWR).1 hrightEq).symm
  exact ⟨q, hqCandidate, by simpa [WR] using hqMin r hrS,
    by simpa [WR] using hqInfo.2.1⟩



theorem rlc_exists_max_bookOrderedIntersectionCandidate
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (hfaith : RlcBookFaithfulTracePair gamma gamma') :
    ∃ z ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma',
      ∀ q ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma',
        (rlc_ambientCrossingWalk gamma.1).support.idxOf q ≤
          (rlc_ambientCrossingWalk gamma.1).support.idxOf z := by
  classical
  obtain ⟨z, hzW, hzRight, hzLeft, _hfirst, hglobalMin⟩ :=
    rlc_bookFirstFlippedTraceIntersection_of_faithful
      gamma gamma' hfaith
  let right := (rlc_ambientCrossingWalk gamma.1).takeUntil z hzW
  have hrank : RlcBookRightIntersectionRankRealizedAt gamma right := by
    simp [RlcBookRightIntersectionRankRealizedAt, right,
      SimpleGraph.Walk.length_takeUntil]
  have hmin : RlcBookRightIntersectionRankMinimalAt
      gamma gamma' right := by
    intro q hqRight hqLeft
    have hqW :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 q).2
        hqRight
    simpa [RlcBookRightIntersectionRankMinimalAt, right,
      SimpleGraph.Walk.length_takeUntil] using hglobalMin q hqW hqLeft
  have hzCandidate := rlc_bookFirstIntersection_mem_orderedCandidateSet
    right hzRight hzLeft hrank hmin
  obtain ⟨m, hm, hmax⟩ := Finset.exists_max_image
    (rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (fun w => (rlc_ambientCrossingWalk gamma.1).support.idxOf w)
    ⟨z, hzCandidate⟩
  exact ⟨m, hm, fun q hq => hmax q hq⟩



theorem rlc_exists_min_bookOrderedIntersectionCandidate
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (hfaith : RlcBookFaithfulTracePair gamma gamma') :
    ∃ z ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma',
      ∀ q ∈ rlc_bookOrderedIntersectionCandidateSet gamma gamma',
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z ≤
          (rlc_ambientCrossingWalk gamma.1).support.idxOf q := by
  classical
  obtain ⟨z, hzW, hzRight, hzLeft, _hfirst, hglobalMin⟩ :=
    rlc_bookFirstFlippedTraceIntersection_of_faithful gamma gamma' hfaith
  let right := (rlc_ambientCrossingWalk gamma.1).takeUntil z hzW
  have hrank : RlcBookRightIntersectionRankRealizedAt gamma right := by
    simp [RlcBookRightIntersectionRankRealizedAt, right,
      SimpleGraph.Walk.length_takeUntil]
  have hmin : RlcBookRightIntersectionRankMinimalAt
      gamma gamma' right := by
    intro q hqRight hqLeft
    have hqW :=
      (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 q).2
        hqRight
    simpa [RlcBookRightIntersectionRankMinimalAt, right,
      SimpleGraph.Walk.length_takeUntil] using hglobalMin q hqW hqLeft
  have hzCandidate := rlc_bookFirstIntersection_mem_orderedCandidateSet
    right hzRight hzLeft hrank hmin
  obtain ⟨m, hm, hleast⟩ := Finset.exists_min_image
    (rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (fun w => (rlc_ambientCrossingWalk gamma.1).support.idxOf w)
    ⟨z, hzCandidate⟩
  exact ⟨m, hm, fun q hq => hleast q hq⟩



theorem rlc_bookMaxOrderedIntersectionCandidate_eq_of_leftLater
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z r : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hzMax : ∀ q ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma',
      (rlc_ambientCrossingWalk gamma.1).support.idxOf q ≤
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z)
    (hrSet : r ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma')
    (hzrLeft :
      (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX z) ≤
        (rlc_ambientCrossingWalk gamma'.1).support.idxOf (rlc_flipX r)) :
    r = z := by
  by_contra hrz
  obtain ⟨q, hqCandidate, hzq, _hqr⟩ :=
    rlc_bookOrderedIntersectionCandidate_exists_later
      hzCandidate hrSet hzrLeft hrz
  exact (not_lt_of_ge (hzMax q hqCandidate)) hzq



theorem rlc_bookMinOrderedIntersectionCandidate_eq_of_rightEarlier
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {z r : Site 2}
    (hzCandidate : z ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma')
    (hzMin : ∀ q ∈
      rlc_bookOrderedIntersectionCandidateSet gamma gamma',
      (rlc_ambientCrossingWalk gamma.1).support.idxOf z ≤
        (rlc_ambientCrossingWalk gamma.1).support.idxOf q)
    (hrSet : r ∈ rlc_bookFlippedTraceIntersectionSet gamma gamma')
    (hrzRight :
      (rlc_ambientCrossingWalk gamma.1).support.idxOf r ≤
        (rlc_ambientCrossingWalk gamma.1).support.idxOf z) :
    r = z := by
  by_contra hrz
  obtain ⟨q, hqCandidate, _hqr, hqz⟩ :=
    rlc_bookOrderedIntersectionCandidate_exists_earlier
      hzCandidate hrSet hrzRight hrz
  exact (not_lt_of_ge (hzMin q hqCandidate)) hqz




theorem rlc_twoChannelFullPhysical_orderedContacts_at_intersection_of_failure
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (hfaith : RlcBookFaithfulTracePair gamma gamma')
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    (hno : rlc_twoChannelEdgeConfigExtend gamma gamma' omega ∉
      rlc_finiteTwoChannelConnectorEvent gamma gamma')
    (z : Site 2)
    (hzRight : z ∈ rlc_pathVertices gamma.1)
    (hzLeft : rlc_flipX z ∈ rlc_pathVertices gamma'.1) :
    ∃ (x y : Site 2)
      (right : (hypercubicLattice 2).Walk (gamma.1.1 : Site 2) z)
      (flipLeft : (hypercubicLattice 2).Walk z (gamma'.1.2.1 : Site 2)),
      x ∈ (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).support ∧
        y ∈ (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).support ∧
        rlc_dualReflect x ∈ rlc_pathVertices gamma.1 ∧
        rlc_dualReflect y ∈ rlc_pathVertices gamma'.1 ∧
        rlc_flipX (rlc_dualReflect x) ∈
          (right.map rlc_flipXLatticeHom).support ∧
        rlc_flipX (rlc_dualReflect y) ∈ flipLeft.support ∧
        RlcBookReflectedLeftSuffixRankAt gamma' flipLeft ∧
        RlcBookRightIntersectionRankRealizedAt gamma right ∧
        RlcBookRightPrefixRankAt gamma right := by
  let H := rlc_twoChannelFullFilledReachSet gamma gamma' omega
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hzWR : z ∈ WR.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 z).2
      hzRight
  have hzWL : rlc_flipX z ∈ WL.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
      gamma'.1 (rlc_flipX z)).2 hzLeft
  let right : (hypercubicLattice 2).Walk
      (gamma.1.1 : Site 2) z := WR.takeUntil z hzWR
  let left : (hypercubicLattice 2).Walk
      (rlc_flipX z) (gamma'.1.2.1 : Site 2) :=
    WL.dropUntil (rlc_flipX z) hzWL
  have hflipUpper : rlc_flipX (gamma'.1.2.1 : Site 2) =
      (gamma'.1.2.1 : Site 2) :=
    rlc_flipX_eq_self_of_zero gamma'.1.2.1.2.2
  let flipLeft : (hypercubicLattice 2).Walk
      z (gamma'.1.2.1 : Site 2) :=
    (left.map rlc_flipXLatticeHom).copy
      (rlc_flipX_involutive z) hflipUpper
  have hrightEdges : ∀ e ∈ right.edges,
      e ∈ rlc_pathEdges gamma.1 := by
    intro e he
    exact rlc_ambientCrossingWalk_edge_mem_pathEdges gamma.1
      (WR.edges_takeUntil_subset hzWR he)
  have hleftEdges : ∀ e ∈ left.edges,
      e ∈ rlc_pathEdges gamma'.1 := by
    intro e he
    exact rlc_ambientCrossingWalk_edge_mem_pathEdges gamma'.1
      (WL.edges_dropUntil_subset hzWL he)
  have hflipLeftSupport (v : Site 2) :
      v ∈ flipLeft.support ↔ rlc_flipX v ∈ left.support := by
    dsimp only [flipLeft]
    rw [SimpleGraph.Walk.support_copy, SimpleGraph.Walk.support_map,
      List.mem_map]
    constructor
    · rintro ⟨w, hw, rfl⟩
      change rlc_flipX (rlc_flipX w) ∈ left.support
      simpa using hw
    · intro hv
      exact ⟨rlc_flipX v, hv, rlc_flipX_involutive v⟩
  have hflipLeftRank : RlcBookReflectedLeftSuffixRankAt
      gamma' flipLeft := by
    intro v hv
    apply rlc_isPath_idxOf_le_of_mem_dropUntil WL
      (rlc_ambientCrossingWalk_isPath gamma'.1) hzWL
    exact (hflipLeftSupport v).1 hv
  have hrightRank : RlcBookRightIntersectionRankRealizedAt
      gamma right := by
    simp [RlcBookRightIntersectionRankRealizedAt, right, WR,
      SimpleGraph.Walk.length_takeUntil]
  have hrightPrefix : RlcBookRightPrefixRankAt gamma right := by
    intro v hv
    apply rlc_idxOf_le_of_mem_takeUntil WR hzWR
    exact hv
  let flipRight : (hypercubicLattice 2).Walk
      (rlc_flipX (gamma.1.1 : Site 2)) (rlc_flipX z) :=
    right.map rlc_flipXLatticeHom
  have hrightStartFlip : rlc_flipX (gamma.1.1 : Site 2) =
      (gamma.1.1 : Site 2) :=
    rlc_flipX_eq_self_of_zero gamma.1.1.2.2
