    (hpReach : p ∈ rlc_twoChannelFullReachSet gamma gamma' omega)
    (hqOutside : q ∉
      rlc_twoChannelFullFilledReachSet gamma gamma' omega) :
    (phb_doubleDualShift p ∈ H.support ∨
        phb_doubleDualShift q ∈ H.support) ∨
      ∃ z ∈ c.support,
        z = p ∨ z = ![p 0 - 1, p 1] ∨
