        rcases hvEnds with rfl | rfl
        · exact Or.inr (Or.inr (Or.inr (Or.inr
            (Or.inr (Or.inl rfl)))))
        · exact Or.inr (Or.inr (Or.inr (Or.inr
            (Or.inr (Or.inr (Or.inl rfl))))))
