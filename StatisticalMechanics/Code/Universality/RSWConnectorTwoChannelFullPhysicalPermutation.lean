          ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
              gamma gamma' u' v' ∧
            rl.reverse =
              (q.mapLe (rlc_twoChannelFullPhysicalGoodBoundaryGraph_le
                gamma gamma' (rlc_twoChannelFullPhysicalCutInteriorConfig
                  gamma gamma' A))).append (.cons huv r) ∧
            (s(f, g) = s(u', v') ∨ s(f, g) ∈ r.edges) ∧
            r.length < rl.length ∧
            rr.length + r.length < rr.length + rl.length ∧
            RlcTwoChannelFullPhysicalRightArcClassifiedBad gamma gamma'
              (rlc_twoChannelFullPhysicalCutInteriorConfig
                gamma gamma' A) u' v' ∧
            RlcTwoChannelFullPhysicalWallTerminalProductClassification
              gamma gamma'
                (rlc_twoChannelFullPhysicalCutInteriorConfig
                  gamma gamma' A) (vr := v') (vl := vl) q ql ∧
            RlcTwoChannelFullPhysicalLocalizedWallTerminalFamilyAlternative
              gamma gamma'
                (rlc_twoChannelFullPhysicalCutInteriorConfig
                  gamma gamma' A) (vr := v') (vl := vl) q ql) := by
  let omega :=
    rlc_twoChannelFullPhysicalCutInteriorConfig gamma gamma' A
  have hno : rlc_twoChannelEdgeConfigExtend gamma gamma' omega ∉
      rlc_finiteTwoChannelConnectorEvent gamma gamma' :=
    rlc_twoChannelFullPhysicalCutInteriorConfig_failure
      gamma gamma' A hAright hAleft
  have hnoGood : ¬RlcTwoChannelFullPhysicalGoodComponentContacts
      gamma gamma' omega :=
    rlc_twoChannelFullPhysical_noGoodComponent_of_noPair
      gamma gamma' A B hAright hAleft hBright hBleft hnoPair
  obtain ⟨f, g, hfgCycle, hfgCross, hfgBad⟩ :=
    rlc_twoChannelFullPhysical_contactCycle_BChanging_exactNoncarrier_of_noPair
      gamma gamma' A B hAright hAleft hBright hBleft hnoPair
        c hx hy hxPath hyPath
  refine ⟨f, g, hfgCross, ?_⟩
  exact rlc_twoChannelFullPhysical_twoFirstBad_noncarrierEdge_product_or_shorter
    hfaith hno hnoGood c hx hy hxPath hyPath qr rr ql rl hurv hulv
      hdecR hdecL hclassR hclassL hfgCycle hfgBad




theorem rlc_twoChannelFullPhysical_suffixPair_strongInduction
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    (P : ∀ {a b c d : Site 2},
      (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a b →
      (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c d →
      Prop)
    (hstep : ∀ {a b c d : Site 2}
      (rr : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a b)
      (rl : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c d),
      (∀ {a' b' c' d' : Site 2}
        (rr' : (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a' b')
        (rl' : (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c' d'),
        rr'.length + rl'.length < rr.length + rl.length → P rr' rl') →
      P rr rl) :
    ∀ {a b c d : Site 2}
      (rr : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a b)
      (rl : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c d),
      P rr rl := by
  intro a b c d rr rl
  generalize hm : rr.length + rl.length = m
  induction m using Nat.strong_induction_on generalizing a b c d rr rl with
  | h m ih =>
      apply hstep rr rl
      intro a' b' c' d' rr' rl' hlt
      exact ih (rr'.length + rl'.length) (by omega) rr' rl' rfl






theorem rlc_twoChannelFullPhysical_candidateSuffix_lexStrongInduction
    {n : Int} {gamma : RlcRightDiagonalPath n}
    {gamma' : RlcLeftDiagonalPath n}
    {omega : RlcTwoChannelEdgeConfig gamma gamma'}
    (P : Nat → ∀ {a b c d : Site 2},
      (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a b →
      (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c d →
      Prop)
    (hstep : ∀ (k : Nat) {a b c d : Site 2}
      (rr : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a b)
      (rl : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c d),
      (∀ (k' : Nat), k' < k → ∀ {a' b' c' d' : Site 2}
        (rr' : (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a' b')
        (rl' : (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c' d'),
        P k' rr' rl') →
      (∀ {a' b' c' d' : Site 2}
        (rr' : (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a' b')
        (rl' : (faceBoundaryGraph
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c' d'),
        rr'.length + rl'.length < rr.length + rl.length →
          P k rr' rl') →
      P k rr rl) :
    ∀ (k : Nat) {a b c d : Site 2}
      (rr : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk a b)
      (rl : (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Walk c d),
      P k rr rl := by
  intro k
  induction k using Nat.strong_induction_on with
  | h k ihK =>
      intro a b c d rr rl
      generalize hm : rr.length + rl.length = m
      induction m using Nat.strong_induction_on generalizing a b c d rr rl with
      | h m ihM =>
          apply hstep k rr rl
          · intro k' hk a' b' c' d' rr' rl'
            exact ihK k' hk rr' rl'
          · intro a' b' c' d' rr' rl' hlt
            exact ihM (rr'.length + rl'.length) (by omega) rr' rl' rfl


noncomputable def rlc_walkIndexInterval
    {V : Type*} {G : SimpleGraph V} {a b : V}
    (W : G.Walk a b) (i j : Nat)
    (hi : i ≤ W.length) (hij : i ≤ j) (hj : j ≤ W.length) :
    G.Walk (W.getVert i) (W.getVert j) :=
  ((W.drop i).take (j - i)).copy
    (by simp)
    (by
      rw [SimpleGraph.Walk.drop_getVert]
      congr 1
      omega)



theorem rlc_walkIndexInterval_support
    {V : Type*} {G : SimpleGraph V} {a b : V}
    (W : G.Walk a b) (i j : Nat)
    (hi : i ≤ W.length) (hij : i ≤ j) (hj : j ≤ W.length)
    {v : V} (hv : v ∈ (rlc_walkIndexInterval W i j hi hij hj).support) :
    ∃ k : Nat, i ≤ k ∧ k ≤ j ∧ W.getVert k = v := by
  change v ∈ (((W.drop i).take (j - i)).copy _ _).support at hv
  rw [SimpleGraph.Walk.support_copy,
    SimpleGraph.Walk.mem_support_iff_exists_getVert] at hv
  obtain ⟨m, hvm, hm⟩ := hv
  have hmBounds : m ≤ j - i ∧ m ≤ W.length - i := by
    simpa using hm
  refine ⟨i + m, by omega, by omega, ?_⟩
  rw [← hvm, SimpleGraph.Walk.take_getVert,
    SimpleGraph.Walk.drop_getVert]
  congr 1
  omega



theorem rlc_walkIndexInterval_getVert_mem
    {V : Type*} {G : SimpleGraph V} {a b : V}
    (W : G.Walk a b) (i j : Nat)
    (hi : i ≤ W.length) (hij : i ≤ j) (hj : j ≤ W.length)
    {k : Nat} (hik : i ≤ k) (hkj : k ≤ j) :
    W.getVert k ∈ (rlc_walkIndexInterval W i j hi hij hj).support := by
  let H := rlc_walkIndexInterval W i j hi hij hj
  have hget : H.getVert (k - i) = W.getVert k := by
    dsimp only [H, rlc_walkIndexInterval]
    rw [SimpleGraph.Walk.getVert_copy,
      SimpleGraph.Walk.take_getVert,
      SimpleGraph.Walk.drop_getVert]
    congr 1
    omega
  rw [← hget]
  exact H.getVert_mem_support (k - i)



theorem rlc_walkIndexInterval_support_interior
    {V : Type*} {G : SimpleGraph V} {a b : V}
    (W : G.Walk a b) (i j : Nat)
    (hi : i ≤ W.length) (hij : i ≤ j) (hj : j ≤ W.length)
    {v : V} (hv : v ∈ (rlc_walkIndexInterval W i j hi hij hj).support)
    (hvi : v ≠ W.getVert i) (hvj : v ≠ W.getVert j) :
    ∃ k : Nat, i < k ∧ k < j ∧ W.getVert k = v := by
  obtain ⟨k, hik, hkj, hkv⟩ :=
    rlc_walkIndexInterval_support W i j hi hij hj hv
  refine ⟨k, ?_, ?_, hkv⟩
  · exact lt_of_le_of_ne hik (by
      intro hki
      apply hvi
      rw [← hkv, hki])
  · exact lt_of_le_of_ne hkj (by
      intro hkj'
      apply hvj
      rw [← hkv, hkj'])




theorem rlc_walk_ordered_to_complementary_crosscut
    {G K : SimpleGraph (Site 2)}
    {u x y a b : Site 2} (c : G.Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support)
    (W : K.Walk a b)
    (ha : a ∈ (rlc_orderedContourArc c hx hy).support)
    (hb : b ∈ (rlc_complementaryContourArc c hx hy).support) :
    (∃ z ∈ W.support,
        z ∈ (rlc_orderedContourArc c hx hy).support ∧
          z ∈ (rlc_complementaryContourArc c hx hy).support) ∨
      ∃ (i j : Nat) (hi : i ≤ W.length) (hij : i ≤ j)
          (hj : j ≤ W.length),
        i < j ∧
          W.getVert i ∈ (rlc_orderedContourArc c hx hy).support ∧
          W.getVert j ∈ (rlc_complementaryContourArc c hx hy).support ∧
          ∀ z ∈ (rlc_walkIndexInterval W i j hi hij hj).support,
            z = W.getVert i ∨ z = W.getVert j ∨ z ∉ c.support := by
  rcases rlc_walk_ordered_to_complementary_contact_interval
      c hx hy W ha hb with hcommon | ⟨i, j, hij, hj, hiArc, hjArc, hbetween⟩
  · exact Or.inl hcommon
  · right
    have hi : i ≤ W.length := by omega
    have hij' : i ≤ j := hij.le
    refine ⟨i, j, hi, hij', hj, hij, hiArc, hjArc, ?_⟩
    intro z hz
    by_cases hzi : z = W.getVert i
    · exact Or.inl hzi
    by_cases hzj : z = W.getVert j
    · exact Or.inr (Or.inl hzj)
    · right; right
      obtain ⟨k, hik, hkj, hkz⟩ :=
        rlc_walkIndexInterval_support_interior
          W i j hi hij' hj hz hzi hzj
      rw [← hkz]
      exact hbetween k hik hkj



theorem rlc_walk_exists_first_contact_after
    {V : Type*} [DecidableEq V] {G : SimpleGraph V}
    {a b u : V} (W : G.Walk a b) (C : G.Walk u u)
    {j : Nat} (hjLength : j < W.length) (hend : b ∈ C.support) :
    ∃ j' : Nat,
      j < j' ∧ j' ≤ W.length ∧ W.getVert j' ∈ C.support ∧
        ∀ l : Nat, j < l → l < j' → W.getVert l ∉ C.support := by
  classical
  let R : Finset Nat := (Finset.Icc (j + 1) W.length).filter fun k =>
    W.getVert k ∈ C.support
  have hlengthR : W.length ∈ R := by
    simp [R, hjLength, W.getVert_length, hend]
  obtain ⟨j', hj'R, hj'Min⟩ :=
    Finset.exists_min_image R id ⟨W.length, hlengthR⟩
  have hj'Info := Finset.mem_filter.mp hj'R
  have hj'Bounds := Finset.mem_Icc.mp hj'Info.1
  refine ⟨j', by omega, hj'Bounds.2, hj'Info.2, ?_⟩
  intro l hjl hlj' hlContact
  have hlR : l ∈ R := Finset.mem_filter.mpr
    ⟨Finset.mem_Icc.mpr ⟨by omega, by omega⟩, hlContact⟩
  have hj'l : j' ≤ l := by simpa using hj'Min l hlR
  omega




theorem rlc_walk_contactInterval_same_leftRegion_side
    {a b u : Site 2}
    (W : (hypercubicLattice 2).Walk a b)
    (C : (hypercubicLattice 2).Walk u u)
    {i k j : Nat}
    (hik : i < k) (hkj : k < j) (hjLength : j ≤ W.length)
    (hbetween : ∀ l : Nat, i < l → l < j →
      W.getVert l ∉ C.support)
    (hkOutside : W.getVert k ∉ jec_leftRegion C) :
    ∀ l : Nat, i < l → l < j →
      W.getVert l ∉ jec_leftRegion C := by
  intro l hil hlj
  have hkLength : k ≤ W.length := by omega
  have hlLength : l ≤ W.length := by omega
  rcases le_total l k with hlk | hkl
  · let p := (W.drop l).take (k - l)
    have hpLength : p.length = k - l := by
      simp [p, Nat.min_eq_left]
      omega
    have hpOff : ∀ z ∈ p.support, z ∉ C.support := by
      intro z hz
      rw [SimpleGraph.Walk.mem_support_iff_exists_getVert] at hz
      obtain ⟨m, hzm, hm⟩ := hz
      have hm' : m ≤ k - l := by simpa [hpLength] using hm
      have hget : p.getVert m = W.getVert (l + m) := by
        simp [p, Nat.min_eq_right hm']
      rw [← hzm, hget]
      apply hbetween (l + m)
      · omega
      · omega
    have hsame := jlri_sameRegion_along_offSupport_walk C p hpOff
    have hend : (W.drop l).getVert (k - l) = W.getVert k := by
      simp
      congr 1
      omega
    rw [hend] at hsame
    exact fun hlInside => hkOutside (hsame.mp hlInside)
  · let p := (W.drop k).take (l - k)
    have hpLength : p.length = l - k := by
      simp [p, Nat.min_eq_left]
      omega
    have hpOff : ∀ z ∈ p.support, z ∉ C.support := by
      intro z hz
      rw [SimpleGraph.Walk.mem_support_iff_exists_getVert] at hz
      obtain ⟨m, hzm, hm⟩ := hz
      have hm' : m ≤ l - k := by simpa [hpLength] using hm
      have hget : p.getVert m = W.getVert (k + m) := by
        simp [p, Nat.min_eq_right hm']
      rw [← hzm, hget]
      apply hbetween (k + m)
      · omega
      · omega
    have hsame := jlri_sameRegion_along_offSupport_walk C p hpOff
    have hend : (W.drop k).getVert (l - k) = W.getVert l := by
      simp
      congr 1
      omega
    rw [hend] at hsame
    exact fun hlInside => hkOutside (hsame.mpr hlInside)







theorem rlc_walk_ordered_to_complementary_contactInterval_exteriorSide
    {G : SimpleGraph (Site 2)}
    (hG : G ≤ hypercubicLattice 2)
    {u x y a b : Site 2} (c : G.Walk u u)
    (hx : x ∈ c.support) (hy : y ∈ c.support)
    (W : (hypercubicLattice 2).Walk a b)
    (ha : a ∈ (rlc_orderedContourArc c hx hy).support)
    (hb : b ∈ (rlc_complementaryContourArc c hx hy).support) :
    (∃ z ∈ W.support,
        z ∈ (rlc_orderedContourArc c hx hy).support ∧
          z ∈ (rlc_complementaryContourArc c hx hy).support) ∨
      ∃ i j : Nat,
        i < j ∧ j ≤ W.length ∧
          W.getVert i ∈ (rlc_orderedContourArc c hx hy).support ∧
          W.getVert j ∈ (rlc_complementaryContourArc c hx hy).support ∧
          (∀ l : Nat, i < l → l < j → W.getVert l ∉ c.support) ∧
          (j = i + 1 ∨
            (i + 1 < j ∧
              ∀ (_hfirstOutside : W.getVert (i + 1) ∉
                  jec_leftRegion (c.mapLe hG)) (l : Nat),
                i < l → l < j →
                  W.getVert l ∉ jec_leftRegion (c.mapLe hG))) := by
  rcases rlc_walk_ordered_to_complementary_contact_interval
      c hx hy W ha hb with
    hcommon | ⟨i, j, hij, hjLength, hiArc, hjArc, hbetween⟩
  · exact Or.inl hcommon
  · right
    refine ⟨i, j, hij, hjLength, hiArc, hjArc, hbetween, ?_⟩
    by_cases hadjacent : j = i + 1
    · exact Or.inl hadjacent
    · right
      have hfirst : i < i + 1 := by omega
      have hfirstj : i + 1 < j := by omega
      refine ⟨hfirstj, ?_⟩
      intro hfirstOutside
      apply rlc_walk_contactInterval_same_leftRegion_side
        W (c.mapLe hG) hfirst hfirstj hjLength
      · intro l hil hlj
        simpa [SimpleGraph.Walk.support_mapLe_eq_support] using
          hbetween l hil hlj
      · exact hfirstOutside




theorem rlc_contactInterval_firstVertex_exterior_no_go :
    ∃ (c : (hypercubicLattice 2).Walk ![0, 0] ![0, 0])
      (T : (hypercubicLattice 2).Walk ![2, 1] ![0, 1]),
      c.IsCycle ∧
      T.getVert 0 ∈ c.support ∧ T.getVert 2 ∈ c.support ∧
      (∀ l : Nat, 0 < l → l < 2 → T.getVert l ∉ c.support) ∧
      T.getVert 1 ∈ jec_leftRegion c := by
  let s1 : (hypercubicLattice 2).Walk ![0, 0] ![2, 0] :=
    (jec_hsegRight 0 0 2).copy (by ext i; fin_cases i <;> simp)
      (by ext i; fin_cases i <;> simp)
  let s2 : (hypercubicLattice 2).Walk ![2, 0] ![2, 2] :=
    (jec_vsegUp 2 0 2).copy rfl (by ext i; fin_cases i <;> simp)
  let s3 : (hypercubicLattice 2).Walk ![2, 2] ![0, 2] :=
    ((jec_hsegRight 2 0 2).copy (by ext i; fin_cases i <;> simp)
      (by ext i; fin_cases i <;> simp)).reverse
  let s4 : (hypercubicLattice 2).Walk ![0, 2] ![0, 0] :=
    ((jec_vsegUp 0 0 2).copy rfl
      (by ext i; fin_cases i <;> simp)).reverse
  let c := s1.append (s2.append (s3.append s4))
  let T : (hypercubicLattice 2).Walk ![2, 1] ![0, 1] :=
    ((jec_hsegRight 1 0 2).copy (by ext i; fin_cases i <;> simp)
      (by ext i; fin_cases i <;> simp)).reverse
  refine ⟨c, T, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [c, s1, s2, s3, s4]
    rw [SimpleGraph.Walk.isCycle_def]
    simp [SimpleGraph.Walk.isTrail_def, SimpleGraph.Walk.edges_cons,
      jec_hsegRight, jec_vsegUp]
  · dsimp [T, c, s1, s2, s3, s4]
    simp [jec_hsegRight, jec_vsegUp]
  · dsimp [T, c, s1, s2, s3, s4]
    simp [jec_hsegRight, jec_vsegUp]
  · intro l hl0 hl2
    have hl : l = 1 := by omega
    subst l
    dsimp [T, c, s1, s2, s3, s4]
    simp [jec_hsegRight, jec_vsegUp]
  · have hTmid : T.getVert 1 = (![1, 1] : Site 2) := by
      dsimp [T]
      simp [jec_hsegRight]
    rw [hTmid, jec_mem_leftRegion]
    dsimp [T, c, s1, s2, s3, s4]
    classical
    simp [jec_rayCount, jec_rayEdge, jec_hsegRight, jec_vsegUp]




noncomputable def rlc_bookExteriorEndpointDetour {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :
    (hypercubicLattice 2).Walk
      (gamma.1.2.1 : Site 2) (gamma'.1.1 : Site 2) := by
  let r : Site 2 := gamma.1.2.1
  let l : Site 2 := gamma'.1.1
  have hr : (![r 0, r 1] : Site 2) = r := by
    ext i
    fin_cases i <;> simp
  have hl : (![l 0, l 1] : Site 2) = l := by
    ext i
    fin_cases i <;> simp
  let rightLeg : (hypercubicLattice 2).Walk r
      ![2 * n + 2, n + 2] :=
    (sw_lshape (r 0) (r 1) (2 * n + 2) (n + 2)).copy hr rfl
  let topLeg : (hypercubicLattice 2).Walk
      ![2 * n + 2, n + 2] ![-2 * n - 2, n + 2] :=
    sw_horizSeg (n + 2) (2 * n + 2) (-2 * n - 2)
  let leftLeg : (hypercubicLattice 2).Walk
      ![-2 * n - 2, n + 2] l :=
    ((sw_lshape (l 0) (l 1) (-2 * n - 2) (n + 2)).reverse).copy
      rfl hl
  exact (rightLeg.append topLeg).append leftLeg





noncomputable def rlc_bookOuterTraceNetworkArc {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {s : Site 2}
    (hsRight : s ∈ rlc_pathVertices gamma.1)
    (hsLeft : rlc_flipX s ∈ rlc_pathVertices gamma'.1) :
    (hypercubicLattice 2).Walk s (rlc_flipX s) := by
  let WR := rlc_ambientCrossingWalk gamma.1
  let WL := rlc_ambientCrossingWalk gamma'.1
  have hsWR : s ∈ WR.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 s).2
      hsRight
  have hsWL : rlc_flipX s ∈ WL.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices
      gamma'.1 (rlc_flipX s)).2 hsLeft
  exact ((WR.dropUntil s hsWR).append
    (rlc_bookExteriorEndpointDetour gamma gamma')).append
      (WL.takeUntil (rlc_flipX s) hsWL)


noncomputable def rlc_bookPhysicalOuterTraceNetworkArc {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {s : Site 2}
    (hsRight : s ∈ rlc_pathVertices gamma.1)
    (hsLeft : rlc_flipX s ∈ rlc_pathVertices gamma'.1) :
    (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm s)
      (rlc_dualReflect.symm (rlc_flipX s)) :=
  (rlc_bookOuterTraceNetworkArc gamma gamma' hsRight hsLeft).map
    rlc_dualReflectSymmLatticeHom


noncomputable def rlc_rightAmbientTraceCanonicalSegment {n : Int}
    (gamma : RlcRightDiagonalPath n) {r s : Site 2}
    (hr : r ∈ rlc_pathVertices gamma.1)
    (hs : s ∈ rlc_pathVertices gamma.1)
    (hrs : (rlc_ambientCrossingWalk gamma.1).support.idxOf r ≤
      (rlc_ambientCrossingWalk gamma.1).support.idxOf s) :
    (hypercubicLattice 2).Walk r s := by
  let W := rlc_ambientCrossingWalk gamma.1
  have hrW : r ∈ W.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 r).2 hr
  have hsW : s ∈ W.support :=
    (rlc_mem_ambientCrossingWalk_support_iff_pathVertices gamma.1 s).2 hs
  have hsSuffix : s ∈ (W.dropUntil r hrW).support :=
    (rlc_isPath_mem_dropUntil_iff_idxOf_le W
      (rlc_ambientCrossingWalk_isPath gamma.1) hrW hsW).2 hrs
  exact (W.dropUntil r hrW).takeUntil s hsSuffix


noncomputable def rlc_bookTraceNetworkBracket {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {r s : Site 2}
    (hr : r ∈ rlc_pathVertices gamma.1)
    (hs : s ∈ rlc_pathVertices gamma.1)
    (hsLeft : rlc_flipX s ∈ rlc_pathVertices gamma'.1)
    (hrs : (rlc_ambientCrossingWalk gamma.1).support.idxOf r ≤
      (rlc_ambientCrossingWalk gamma.1).support.idxOf s) :
    (hypercubicLattice 2).Walk r (rlc_flipX s) :=
  (rlc_rightAmbientTraceCanonicalSegment gamma hr hs hrs).append
    (rlc_bookOuterTraceNetworkArc gamma gamma' hs hsLeft)


noncomputable def rlc_bookPhysicalTraceNetworkBracket {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {r s : Site 2}
    (hr : r ∈ rlc_pathVertices gamma.1)
    (hs : s ∈ rlc_pathVertices gamma.1)
    (hsLeft : rlc_flipX s ∈ rlc_pathVertices gamma'.1)
    (hrs : (rlc_ambientCrossingWalk gamma.1).support.idxOf r ≤
      (rlc_ambientCrossingWalk gamma.1).support.idxOf s) :
    (hypercubicLattice 2).Walk
      (rlc_dualReflect.symm r)
      (rlc_dualReflect.symm (rlc_flipX s)) :=
  (rlc_bookTraceNetworkBracket gamma gamma' hr hs hsLeft hrs).map
    rlc_dualReflectSymmLatticeHom



theorem rlc_walk_takeUntil_append_of_notMem_left
    {V : Type*} [DecidableEq V] {G : SimpleGraph V}
    {u v w x : V} (p : G.Walk u v) (q : G.Walk v w)
    (hxP : x ∉ p.support) (hxQ : x ∈ q.support) :
    (p.append q).takeUntil x
      (SimpleGraph.Walk.subset_support_append_right p q hxQ) =
      p.append (q.takeUntil x hxQ) := by
  induction p with
  | nil => simp
  | cons h p ih =>
      simp only [SimpleGraph.Walk.support_cons, List.mem_cons, not_or] at hxP
      have hmem : x ∈ (p.append q).support :=
        SimpleGraph.Walk.subset_support_append_right p q hxQ
      have hne : _ ≠ x := fun hEq => hxP.1 hEq.symm
      change (SimpleGraph.Walk.cons h (p.append q)).takeUntil x _ =
        SimpleGraph.Walk.cons h (p.append (q.takeUntil x hxQ))
      rw [SimpleGraph.Walk.takeUntil_cons hmem hne h]
      exact congrArg (SimpleGraph.Walk.cons h) (ih q hxP.2 hxQ)


theorem rlc_list_idxOf_map_of_injective
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (f : A → B) (hf : Function.Injective f) (l : List A) (x : A) :
    (l.map f).idxOf (f x) = l.idxOf x := by
  induction l with
  | nil => simp
  | cons a l ih =>
      by_cases hax : a = x
      · subst a
        simp
      · have hfax : f a ≠ f x := fun h => hax (hf h)
        simp [hax, hfax, ih]



theorem rlc_list_idxOf_drop_idxOf_of_le
    {A : Type*} [DecidableEq A] (l : List A) {a b : A}
    (hnodup : l.Nodup) (ha : a ∈ l) (hb : b ∈ l)
    (hab : l.idxOf a ≤ l.idxOf b) :
    (l.drop (l.idxOf a)).idxOf b = l.idxOf b - l.idxOf a := by
  induction l with
  | nil => simp at ha
  | cons x l ih =>
      rw [List.nodup_cons] at hnodup
      simp only [List.mem_cons] at ha hb
      by_cases hxa : x = a
      · subst x
        simp
      · have ha' : a ∈ l := ha.resolve_left (fun h => hxa h.symm)
        by_cases hxb : x = b
        · subst x
          rw [List.idxOf_cons_self] at hab
          rw [List.idxOf_cons_ne l hxa] at hab
          omega
        · have hb' : b ∈ l := hb.resolve_left (fun h => hxb h.symm)
          have hab' : l.idxOf a ≤ l.idxOf b := by
            rw [List.idxOf_cons_ne l hxa,
              List.idxOf_cons_ne l hxb] at hab
            omega
          rw [List.idxOf_cons_ne l hxa,
            List.idxOf_cons_ne l hxb]
          simp only [List.drop_succ_cons, Nat.succ_sub_succ_eq_sub]
          exact ih hnodup.2 ha' hb' hab'



theorem rlc_isPath_dropUntil_dropUntil_eq
    {V : Type*} [DecidableEq V] {G : SimpleGraph V}
    {u v a b : V} (W : G.Walk u v) (hW : W.IsPath)
    (ha : a ∈ W.support) (hb : b ∈ W.support)
    (hab : W.support.idxOf a ≤ W.support.idxOf b)
    (hbSuffix : b ∈ (W.dropUntil a ha).support) :
    (W.dropUntil a ha).dropUntil b hbSuffix = W.dropUntil b hb := by
  let P := W.dropUntil a ha
  change b ∈ P.support at hbSuffix
  have haIdx : W.support.idxOf a ≤ W.length := by
    have h := List.idxOf_lt_length_of_mem ha
    rw [SimpleGraph.Walk.length_support] at h
    omega
  have hPsupport : P.support = W.support.drop (W.support.idxOf a) := by
    simp only [P, SimpleGraph.Walk.dropUntil_eq_drop,
      SimpleGraph.Walk.support_copy,
      SimpleGraph.Walk.drop_support_eq_support_drop_min]
    rw [Nat.min_eq_left haIdx]
  have hidx : P.support.idxOf b =
      W.support.idxOf b - W.support.idxOf a := by
    rw [hPsupport]
    exact rlc_list_idxOf_drop_idxOf_of_le W.support
      hW.support_nodup ha hb hab
  have dropUntil_support {x y z : V} (Q : G.Walk x y)
      (hz : z ∈ Q.support) :
      (Q.dropUntil z hz).support = Q.support.drop (Q.support.idxOf z) := by
    have hzIdx : Q.support.idxOf z ≤ Q.length := by
      have h := List.idxOf_lt_length_of_mem hz
      rw [SimpleGraph.Walk.length_support] at h
      omega
    rw [SimpleGraph.Walk.dropUntil_eq_drop,
      SimpleGraph.Walk.support_copy,
      SimpleGraph.Walk.drop_support_eq_support_drop_min,
      Nat.min_eq_left hzIdx]
  apply SimpleGraph.Walk.ext_support
  rw [dropUntil_support P hbSuffix, dropUntil_support W hb,
    hidx, hPsupport, List.drop_drop]
  congr 1
  omega




theorem rlc_isPath_takeUntil_dropUntil_contact
    {G : SimpleGraph (Site 2)} {u w a b v : Site 2}
    (W : G.Walk u w) (hW : W.IsPath)
    (ha : a ∈ W.support) (hb : b ∈ W.support)
    (hab : W.support.idxOf a ≤ W.support.idxOf b)
    (hvPrefix : v ∈ (W.takeUntil a ha).support)
    (hvSuffix : v ∈ (W.dropUntil b hb).support) :
    v = a ∧ a = b := by
  have hvW : v ∈ W.support := W.support_dropUntil_subset hb hvSuffix
  have hva : W.support.idxOf v ≤ W.support.idxOf a :=
    rlc_idxOf_le_of_mem_takeUntil W ha hvPrefix
  have hbv : W.support.idxOf b ≤ W.support.idxOf v :=
    (rlc_isPath_mem_dropUntil_iff_idxOf_le W hW hb hvW).1 hvSuffix
  have hvaEq : W.support.idxOf v = W.support.idxOf a := by omega
  have habEq : W.support.idxOf a = W.support.idxOf b := by omega
  exact ⟨(List.idxOf_inj hvW).1 hvaEq,
    (List.idxOf_inj ha).1 habEq⟩


theorem rlc_isPath_idxOf_end
    {V : Type*} [DecidableEq V] {G : SimpleGraph V}
    {u w : V} (W : G.Walk u w) (hW : W.IsPath) :
    W.support.idxOf w = W.length := by
  have hn := hW.support_nodup
  rw [← W.dropLast_support_concat] at hn
  have hnot : w ∉ W.support.dropLast := by
    intro hw
    exact (List.nodup_append.mp hn).2.2 w hw w (by simp) rfl
  calc
    W.support.idxOf w =
        W.support.idxOf (W.support.getLast (by simp)) := by
          rw [W.getLast_support]
    _ = W.support.length - 1 := List.idxOf_getLast (by simp) (by
      simpa [W.getLast_support] using hnot)
    _ = W.length := by rw [SimpleGraph.Walk.length_support]; omega



theorem rlc_isPath_idxOf_getVert
    {V : Type*} [DecidableEq V] {G : SimpleGraph V}
    {u v : V} (W : G.Walk u v) (hW : W.IsPath)
    (i : Nat) (hi : i ≤ W.length) :
    W.support.idxOf (W.getVert i) = i := by
  have hmem : W.getVert i ∈ W.support := W.getVert_mem_support i
  have hidxLt := List.idxOf_lt_length_of_mem hmem
  have hidxLe : W.support.idxOf (W.getVert i) ≤ W.length := by
    rw [SimpleGraph.Walk.length_support] at hidxLt
    omega
  apply hW.getVert_injOn hidxLe hi
  exact W.getVert_support_idxOf hmem


theorem rlc_walk_idxOf_start
    {V : Type*} [DecidableEq V] {G : SimpleGraph V}
    {u w : V} (W : G.Walk u w) : W.support.idxOf u = 0 := by
  cases W <;> simp


theorem rlc_bookExteriorEndpointDetour_mem_rect {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    {v : Site 2}
    (hv : v ∈ (rlc_bookExteriorEndpointDetour gamma gamma').support) :
    v ∈ rect (-2 * n - 2) (2 * n + 2) (-n) (n + 2) := by
  let r : Site 2 := gamma.1.2.1
  let l : Site 2 := gamma'.1.1
  have hrBox : r ∈ rect 0 (2 * n) (-n) n := by
    simpa [r] using gamma.1.2.1.2.1
  have hlBox : l ∈ rect (-2 * n) 0 (-n) n := by
    simpa [l] using gamma'.1.1.2.1
  have hr : (![r 0, r 1] : Site 2) = r := by
    ext i
    fin_cases i <;> simp
  have hl : (![l 0, l 1] : Site 2) = l := by
    ext i
    fin_cases i <;> simp
  change v ∈ (((
    (sw_lshape (r 0) (r 1) (2 * n + 2) (n + 2)).copy hr rfl).append
      (sw_horizSeg (n + 2) (2 * n + 2) (-2 * n - 2))).append
        (((sw_lshape (l 0) (l 1) (-2 * n - 2) (n + 2)).reverse).copy
          rfl hl)).support at hv
  rw [SimpleGraph.Walk.mem_support_append_iff,
    SimpleGraph.Walk.mem_support_append_iff,
    SimpleGraph.Walk.support_copy,
    SimpleGraph.Walk.support_copy,
    SimpleGraph.Walk.support_reverse, List.mem_reverse,
    sw_lshape_mem_support, sw_lshape_mem_support] at hv
  rw [mem_rect] at hrBox hlBox ⊢
  rcases hv with (hvRight | hvTop) | hvLeft
  · rcases hvRight with hvHoriz | hvVert
    · rw [sw_horizSeg_mem_support] at hvHoriz
      obtain ⟨t, ht, rfl⟩ := hvHoriz
      rw [Set.mem_uIcc] at ht
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rcases ht with ht | ht <;> omega
    · rw [sw_vertSeg_mem_support] at hvVert
      obtain ⟨t, ht, rfl⟩ := hvVert
      rw [Set.mem_uIcc] at ht
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rcases ht with ht | ht <;> omega
  · rw [sw_horizSeg_mem_support] at hvTop
    obtain ⟨t, ht, rfl⟩ := hvTop
    rw [Set.mem_uIcc] at ht
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    rcases ht with ht | ht <;> omega
  · rcases hvLeft with hvHoriz | hvVert
    · rw [sw_horizSeg_mem_support] at hvHoriz
      obtain ⟨t, ht, rfl⟩ := hvHoriz
      rw [Set.mem_uIcc] at ht
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rcases ht with ht | ht <;> omega
    · rw [sw_vertSeg_mem_support] at hvVert
      obtain ⟨t, ht, rfl⟩ := hvVert
      rw [Set.mem_uIcc] at ht
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      rcases ht with ht | ht <;> omega



theorem rlc_bookExteriorEndpointDetour_topRight_mem {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n) :
    (![(2 * n + 2), n + 2] : Site 2) ∈
      (rlc_bookExteriorEndpointDetour gamma gamma').support := by
  let r : Site 2 := gamma.1.2.1
