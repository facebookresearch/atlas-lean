  · intro v hv
    change v ∈ ((pre.append M).append post).support at hv
    rw [SimpleGraph.Walk.mem_support_append_iff,
      SimpleGraph.Walk.mem_support_append_iff] at hv
    rcases hv with (hvPre | hvM) | hvPost
