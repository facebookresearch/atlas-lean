    (hvRight : rlc_dualReflect v ∉ rlc_pathVertices gamma.1)
    (hvLeft : rlc_dualReflect v ∉ rlc_pathVertices gamma'.1)
    (hvFlipLeft : ¬ ∃ r ∈ rlc_pathVertices gamma'.1,
