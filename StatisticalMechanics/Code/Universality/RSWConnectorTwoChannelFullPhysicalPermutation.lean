    gamma gamma' hr hs hsLeft hrs).map
      rlc_dualReflectSymmLatticeHom).support at hvBracket
  rw [SimpleGraph.Walk.support_map, List.mem_map] at hvBracket
  obtain ⟨w, hwBracket, hwv⟩ := hvBracket
