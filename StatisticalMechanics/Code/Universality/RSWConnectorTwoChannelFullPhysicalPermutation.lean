def RlcTwoChannelFullPhysicalTargetCarrierLocal {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (f g : Site 2) : Prop :=
  ∃ (hf : rlc_dualReflect f ∈ rect (-2 * n) (2 * n) (-n) n)
    (hg : rlc_dualReflect g ∈ rect (-2 * n) (2 * n) (-n) n),
    (rlc_connectorTwoChannelGraph gamma gamma').Adj
      ⟨rlc_dualReflect f, hf⟩ ⟨rlc_dualReflect g, hg⟩

theorem rlc_twoChannelFullPhysicalTargetCarrierGeometry_iff_local
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) (f g : Site 2) :
    RlcTwoChannelFullPhysicalTargetCarrierGeometry gamma gamma' f g ↔
      RlcTwoChannelFullPhysicalTargetCarrierLocal gamma gamma' f g := by
  constructor
  · rintro ⟨target, htarget⟩
    induction hedge : target.1 using Sym2.inductionOn with
    | _ x y =>
        rw [hedge, Sym2.map_mk, Sym2.eq_iff] at htarget
        have hxy : (rlc_connectorTwoChannelGraph gamma gamma').Adj x y :=
          (SimpleGraph.mem_edgeSet _).mp (hedge ▸ target.2)
        rcases htarget with ⟨hxf, hyg⟩ | ⟨hxg, hyf⟩
        · have hf : rlc_dualReflect f ∈
              rect (-2 * n) (2 * n) (-n) n := hxf ▸ x.2
          have hg : rlc_dualReflect g ∈
              rect (-2 * n) (2 * n) (-n) n := hyg ▸ y.2
          refine ⟨hf, hg, ?_⟩
          have hx : x = ⟨rlc_dualReflect f, hf⟩ := Subtype.ext hxf
          have hy : y = ⟨rlc_dualReflect g, hg⟩ := Subtype.ext hyg
          simpa [hx, hy] using hxy
        · have hg : rlc_dualReflect g ∈
              rect (-2 * n) (2 * n) (-n) n := hxg ▸ x.2
          have hf : rlc_dualReflect f ∈
              rect (-2 * n) (2 * n) (-n) n := hyf ▸ y.2
          refine ⟨hf, hg, ?_⟩
          have hx : x = ⟨rlc_dualReflect g, hg⟩ := Subtype.ext hxg
          have hy : y = ⟨rlc_dualReflect f, hf⟩ := Subtype.ext hyf
          simpa [hx, hy] using hxy.symm
  · rintro ⟨hf, hg, hfg⟩
    let target : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet :=
      ⟨s(⟨rlc_dualReflect f, hf⟩, ⟨rlc_dualReflect g, hg⟩),
        (SimpleGraph.mem_edgeSet _).mpr hfg⟩
    exact ⟨target, by simp [target, Sym2.map_mk]⟩


def RlcTwoChannelFullPhysicalSourceCarrierLocal {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (f g : Site 2) : Prop :=
  ∃ (p q : Site 2) (hp : p ∈ rect (-2 * n) (2 * n) (-n) n)
    (hq : q ∈ rect (-2 * n) (2 * n) (-n) n),
    sharedPrimalEdge f g = s(p, q) ∧
      (rlc_connectorTwoChannelGraph gamma gamma').Adj
        ⟨p, hp⟩ ⟨q, hq⟩

theorem rlc_twoChannelFullPhysicalSourceCarrierGeometry_iff_local
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) (f g : Site 2) :
    RlcTwoChannelFullPhysicalSourceCarrierGeometry gamma gamma' f g ↔
      RlcTwoChannelFullPhysicalSourceCarrierLocal gamma gamma' f g := by
  constructor
  · rintro ⟨source, hsource⟩
    induction hedge : source.1 using Sym2.inductionOn with
    | _ x y =>
        have hxy : (rlc_connectorTwoChannelGraph gamma gamma').Adj x y :=
          (SimpleGraph.mem_edgeSet _).mp (hedge ▸ source.2)
        exact ⟨x, y, x.2, y.2, by simpa [hedge, Sym2.map_mk] using hsource.symm,
          hxy⟩
  · rintro ⟨p, q, hp, hq, hshared, hpq⟩
    let source : (rlc_connectorTwoChannelGraph gamma gamma').edgeSet :=
      ⟨s(⟨p, hp⟩, ⟨q, hq⟩), (SimpleGraph.mem_edgeSet _).mpr hpq⟩
    exact ⟨source, by simpa [source, Sym2.map_mk] using hshared.symm⟩

theorem rlc_twoChannelFullPhysicalBoundaryCarrierGeometry_iff_target_and_source
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) (f g : Site 2) :
    RlcTwoChannelFullPhysicalBoundaryCarrierGeometry gamma gamma' f g ↔
      RlcTwoChannelFullPhysicalTargetCarrierGeometry gamma gamma' f g ∧
        RlcTwoChannelFullPhysicalSourceCarrierGeometry gamma gamma' f g := by
  constructor
  · rintro ⟨target, source, htarget, hsource⟩
    exact ⟨⟨target, htarget⟩, source, hsource⟩
  · rintro ⟨⟨target, htarget⟩, source, hsource⟩
    exact ⟨target, source, htarget, hsource⟩



theorem rlc_twoChannelFullPhysical_boundaryCarrierGeometry_comm
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) {f g : Site 2}
    (hfg : (hypercubicLattice 2).Adj f g) :
    RlcTwoChannelFullPhysicalBoundaryCarrierGeometry gamma gamma' f g ↔
      RlcTwoChannelFullPhysicalBoundaryCarrierGeometry gamma gamma' g f := by
  constructor
  · rintro ⟨target, source, htarget, hsource⟩
    refine ⟨target, source, ?_, ?_⟩
    · simpa [Sym2.eq_swap] using htarget
    · rw [← sharedPrimalEdge_comm_of_adj hfg]
      exact hsource
  · rintro ⟨target, source, htarget, hsource⟩
    refine ⟨target, source, ?_, ?_⟩
    · simpa [Sym2.eq_swap] using htarget
    · rw [sharedPrimalEdge_comm_of_adj hfg]
      exact hsource





theorem rlc_twoChannelFullPhysical_firstBad_eq_of_sharedSourceEdge
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    {ur vr f g : Site 2}
    (hurv : (hypercubicLattice 2).Adj ur vr)
    (hfg : (hypercubicLattice 2).Adj f g)
    (hshared : sharedPrimalEdge f g = sharedPrimalEdge ur vr)
    (hbad : ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
      gamma gamma' ur vr) :
    s(f, g) = s(ur, vr) ∧
      ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry
        gamma gamma' f g := by
  have hedge : s(f, g) = s(ur, vr) :=
    (jce_sharedPrimalEdge_inj hfg hurv).2 hshared
  refine ⟨hedge, ?_⟩
  intro hcarrier
  rw [Sym2.eq_iff] at hedge
  rcases hedge with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact hbad hcarrier
  · exact hbad
      ((rlc_twoChannelFullPhysical_boundaryCarrierGeometry_comm
        gamma gamma' hurv).2 hcarrier)



theorem rlc_twoChannelFullPhysical_not_carrierGeometry_iff
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) (f g : Site 2) :
    ¬RlcTwoChannelFullPhysicalBoundaryCarrierGeometry gamma gamma' f g ↔
      (¬RlcTwoChannelFullPhysicalTargetCarrierGeometry gamma gamma' f g ∨
        ¬RlcTwoChannelFullPhysicalSourceCarrierGeometry gamma gamma' f g) := by
  rw [rlc_twoChannelFullPhysicalBoundaryCarrierGeometry_iff_target_and_source]
  tauto



theorem rlc_twoChannelFullPhysicalGoodBoundaryGraph_adj_iff_carrierGeometry
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {f g : Site 2} :
    (rlc_twoChannelFullPhysicalGoodBoundaryGraph
        gamma gamma' omega).Adj f g ↔
      (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj f g ∧
        RlcTwoChannelFullPhysicalBoundaryCarrierGeometry gamma gamma' f g := by
  constructor
  · rintro ⟨hfg, target, htarget⟩
    let source := rlc_twoChannelFullPhysicalSourceEdge target
    refine ⟨hfg, target.1, source, htarget, ?_⟩
    calc
      source.1.map Subtype.val =
          rlc_pimsEdgeEquiv (target.1.1.map Subtype.val) :=
        rlc_twoChannelFullPhysicalSourceEdge_map target
      _ = rlc_pimsEdgeEquiv
          s(rlc_dualReflect f, rlc_dualReflect g) := by rw [htarget]
      _ = sharedPrimalEdge f g :=
        rlc_pimsEdgeEquiv_reflected_faceBoundaryEdge
          (rlc_twoChannelFullFilledReachSet gamma gamma' omega) hfg
  · rintro ⟨hfg, target, source, htarget, hsource⟩
    have hpims : rlc_pimsEdgeEquiv
        s(rlc_dualReflect f, rlc_dualReflect g) = sharedPrimalEdge f g :=
      rlc_pimsEdgeEquiv_reflected_faceBoundaryEdge
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega) hfg
    have hsourceMap : source.1.map Subtype.val =
        rlc_pimsEdgeEquiv (target.1.map Subtype.val) := by
      calc
        source.1.map Subtype.val = sharedPrimalEdge f g := hsource
        _ = rlc_pimsEdgeEquiv
            s(rlc_dualReflect f, rlc_dualReflect g) := hpims.symm
        _ = rlc_pimsEdgeEquiv (target.1.map Subtype.val) := by rw [htarget]
    let physical : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' :=
      ⟨target, ⟨⟨source, hsourceMap⟩⟩⟩
    exact ⟨hfg, physical, htarget⟩



def RlcTwoChannelFullPhysicalCrossedVisibleSourceGeometry {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (f g : Site 2) : Prop :=
  ∃ source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma',
    source.1.1.map Subtype.val = sharedPrimalEdge f g



theorem rlc_twoChannelFullPhysicalBoundaryCarrierGeometry_iff_crossedVisible
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n) {S : Set (Site 2)}
    {f g : Site 2} (hfg : (faceBoundaryGraph S).Adj f g) :
    RlcTwoChannelFullPhysicalBoundaryCarrierGeometry gamma gamma' f g ↔
      RlcTwoChannelFullPhysicalCrossedVisibleSourceGeometry
        gamma gamma' f g := by
  have hpims : rlc_pimsEdgeEquiv
      s(rlc_dualReflect f, rlc_dualReflect g) = sharedPrimalEdge f g :=
    rlc_pimsEdgeEquiv_reflected_faceBoundaryEdge S hfg
  constructor
  · rintro ⟨target, source, htarget, hsource⟩
    let physical : RlcTwoChannelFullPhysicalTargetEdge gamma gamma' :=
      ⟨target, ⟨⟨source, by
        calc
          source.1.map Subtype.val = sharedPrimalEdge f g := hsource
          _ = rlc_pimsEdgeEquiv
              s(rlc_dualReflect f, rlc_dualReflect g) := hpims.symm
          _ = rlc_pimsEdgeEquiv (target.1.map Subtype.val) := by rw [htarget]
        ⟩⟩⟩
    have hsourceEq : rlc_twoChannelFullPhysicalSourceEdge physical = source := by
      apply Subtype.ext
      apply Sym2.map.injective Subtype.val_injective
      calc
        (rlc_twoChannelFullPhysicalSourceEdge physical).1.map Subtype.val =
            rlc_pimsEdgeEquiv (physical.1.1.map Subtype.val) :=
          rlc_twoChannelFullPhysicalSourceEdge_map physical
        _ = rlc_pimsEdgeEquiv
            s(rlc_dualReflect f, rlc_dualReflect g) := by rw [htarget]
        _ = sharedPrimalEdge f g := hpims
        _ = source.1.map Subtype.val := hsource.symm
    let visible : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma' :=
      ⟨source, ⟨physical, hsourceEq⟩⟩
    exact ⟨visible, hsource⟩
  · rintro ⟨visible, hsource⟩
    obtain ⟨target, htargetSource⟩ := visible.2
    have htarget : target.1.1.map Subtype.val =
        s(rlc_dualReflect f, rlc_dualReflect g) := by
      apply rlc_pimsEdgeEquiv.injective
      calc
        rlc_pimsEdgeEquiv (target.1.1.map Subtype.val) =
            (rlc_twoChannelFullPhysicalSourceEdge target).1.map Subtype.val :=
          (rlc_twoChannelFullPhysicalSourceEdge_map target).symm
        _ = visible.1.1.map Subtype.val := by rw [htargetSource]
        _ = sharedPrimalEdge f g := hsource
        _ = rlc_pimsEdgeEquiv
            s(rlc_dualReflect f, rlc_dualReflect g) := hpims.symm
    exact ⟨target.1, visible.1, htarget, hsource⟩

theorem rlc_twoChannelFullPhysicalGoodBoundaryGraph_adj_iff_crossedVisible
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {f g : Site 2} :
    (rlc_twoChannelFullPhysicalGoodBoundaryGraph
        gamma gamma' omega).Adj f g ↔
      (faceBoundaryGraph
        (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj f g ∧
      RlcTwoChannelFullPhysicalCrossedVisibleSourceGeometry
        gamma gamma' f g := by
  rw [rlc_twoChannelFullPhysicalGoodBoundaryGraph_adj_iff_carrierGeometry]
  constructor
  · rintro ⟨hfg, hcarrier⟩
    exact ⟨hfg,
      (rlc_twoChannelFullPhysicalBoundaryCarrierGeometry_iff_crossedVisible
        gamma gamma' hfg).1 hcarrier⟩
  · rintro ⟨hfg, hvisible⟩
    exact ⟨hfg,
      (rlc_twoChannelFullPhysicalBoundaryCarrierGeometry_iff_crossedVisible
        gamma gamma' hfg).2 hvisible⟩



theorem rlc_twoChannelFullPhysical_boundary_visibleSource_closed
    {n : Int} (gamma : RlcRightDiagonalPath n)
    (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma')
    {f g : Site 2}
    (hfg : (faceBoundaryGraph
      (rlc_twoChannelFullFilledReachSet gamma gamma' omega)).Adj f g)
    (source : RlcTwoChannelFullPhysicalVisibleSourceEdge gamma gamma')
    (hsource : source.1.1.map Subtype.val = sharedPrimalEdge f g) :
    omega source.1 = false := by
  have hopen := rlc_twoChannelFullFilledBoundary_le_openFaceDual
    gamma gamma' omega hfg
  rw [openSubgraph_adj] at hopen
  have hclosed := hopen.2
  rw [fci_faceDualConfig, fci_faceEdgeEquiv_mk_of_adj hfg.1,
    ← hsource, rlc_twoChannelFullAmbientConfig_source] at hclosed
  simpa using hclosed


