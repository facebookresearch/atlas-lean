    Sharpness.expectationJ G β J (({o} : Finset V) ∆ {z})
      ≤ ∑ x ∈ S, w x z := by
  refine simonLieb_singletonTarget_bound hSL hz ?_
  simpa using le_of_eq (expectationJ_symmDiff_self_eq_one G β J z)


