      m v d ⟨⟨Kp, ip⟩, hpdom⟩).mp hp
  have hqdata :
      finiteBoundaryGhostBoundaryCrossingPairDecrementData
        (p := ⟨Kq, ip⟩) m v hqdom = d :=
    (finiteBoundaryGhostBoundaryCrossingPairDecrementFiber_mem
      m v d ⟨⟨Kq, ip⟩, hqdom⟩).mp hq
