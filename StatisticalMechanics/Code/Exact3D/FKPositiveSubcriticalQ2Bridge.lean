    · constructor
      · simpa [Sswap, boxSymComp, FK.rot_permBoxSym, FK.rot_permEquiv_apply,
          Equiv.symm_swap, Equiv.swap_apply_def] using hSabs2_nonneg
      · simpa [Sswap, boxSymComp, FK.rot_permBoxSym, FK.rot_permEquiv_apply,
          Equiv.symm_swap, Equiv.swap_apply_def] using hrev




