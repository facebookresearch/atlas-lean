theorem edgeCopy_filter_card_le_multiplicity_sum
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (m : ↥G.edgeFinset → ℕ)
    (K : Finset (Sharpness.FluxEdgeCopy.Copy G m))
    (P : ↥G.edgeFinset → Prop) [DecidablePred P] :
    (K.filter (fun i => P i.1)).card ≤
      ∑ e : ↥G.edgeFinset, if P e then m e else 0 := by
  classical
  have hsub :
      K.filter (fun i => P i.1) ⊆
        ((Finset.univ : Finset (Sharpness.FluxEdgeCopy.Copy G m)).filter
          (fun i => P i.1)) := by
    intro i hi
    exact
      Finset.mem_filter.mpr
        ⟨Finset.mem_univ i, (Finset.mem_filter.mp hi).2⟩
  refine (Finset.card_le_card hsub).trans_eq ?_
  have hcard :
      ((Finset.univ : Finset (Sharpness.FluxEdgeCopy.Copy G m)).filter
        (fun i => P i.1)).card =
        ∑ i : Sharpness.FluxEdgeCopy.Copy G m,
          if P i.1 then 1 else 0 := by
    rw [Finset.card_filter]
  rw [hcard, Fintype.sum_sigma]
  refine Finset.sum_congr rfl ?_
  intro e _he
  by_cases hP : P e
  · rw [if_pos hP]
    simp [hP, Fintype.card_fin]
  · rw [if_neg hP]
    simp [hP]





noncomputable def copyDeleteEmbeddingDecrement
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (m : ↥G.edgeFinset → ℕ)
    (i : Sharpness.FluxEdgeCopy.Copy G m) :
    Sharpness.FluxEdgeCopy.Copy G (Function.update m i.1 (m i.1 - 1)) →
      {j : Sharpness.FluxEdgeCopy.Copy G m // j ≠ i} := by
  classical
  intro a
  rcases i with ⟨e0, r⟩
  rcases a with ⟨e, k⟩
  by_cases he : e = e0
  · subst e
    have hmpos : 0 < m e0 := Nat.lt_of_le_of_lt (Nat.zero_le _) r.2
    have hsize : m e0 - 1 + 1 = m e0 :=
      Nat.sub_one_add_one_eq_of_pos hmpos
    have hupdate :
        Function.update m e0 (m e0 - 1) e0 = m e0 - 1 := by
      simp [Function.update_self]
    let k' : Fin (m e0 - 1) := Fin.cast hupdate k
    let p : Fin ((m e0 - 1) + 1) := Fin.cast hsize.symm r
    let xSubtype : {x : Fin ((m e0 - 1) + 1) // x ≠ p} :=
      finSuccAboveEquiv p k'
    refine ⟨⟨e0, Fin.cast hsize xSubtype.1⟩, ?_⟩
    intro hji
    have hidx_heq : HEq (Fin.cast hsize xSubtype.1) r :=
      (Sigma.mk.inj_iff.mp hji).2
    have hidx : Fin.cast hsize xSubtype.1 = r := eq_of_heq hidx_heq
    apply xSubtype.2
    apply Fin.ext
    have hv := congrArg Fin.val hidx
    simpa [p] using hv
  · have hupdate :
        Function.update m e0 (m e0 - 1) e = m e := by
      simp [Function.update_of_ne he]
    let k' : Fin (m e) := Fin.cast hupdate k
    refine ⟨⟨e, k'⟩, ?_⟩
    intro hji
    apply he
    exact congrArg Sigma.fst hji


theorem copyDeleteEmbeddingDecrement_fst
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (m : ↥G.edgeFinset → ℕ)
    (i : Sharpness.FluxEdgeCopy.Copy G m)
    (a : Sharpness.FluxEdgeCopy.Copy G (Function.update m i.1 (m i.1 - 1))) :
    ((copyDeleteEmbeddingDecrement G m i a).1).1 = a.1 := by
  classical
  rcases i with ⟨e0, r⟩
  rcases a with ⟨e, k⟩
  by_cases he : e = e0
  · subst e
    simp [copyDeleteEmbeddingDecrement]
  · simp [copyDeleteEmbeddingDecrement, he]




