theorem finiteBoundaryGhostBoundaryCrossingPairDecrementFiber_eq_of_selectedCopy_eq
    {n : ℕ}
    (m : ↥(Sharpness.withGhost (FK.boxGraph 3 n)).edgeFinset → ℕ)
