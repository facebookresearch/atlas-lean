    · intro p hp q hq hcopy
      exact
        finiteBoundaryGhostBoundaryCrossingPairDecrementFiber_eq_of_selectedCopy_eq
          m v d hp hq hcopy
  have hghost_le : ghostCopies.card ≤ m eGhost := by
