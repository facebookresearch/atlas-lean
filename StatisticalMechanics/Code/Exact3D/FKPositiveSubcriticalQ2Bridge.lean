theorem finiteBoundaryGhostSimonWeight_sum_le_currentBoundaryTwoPointSum_of_localization
    {β H : ℝ} {n : ℕ} (hβ : 0 ≤ β) (hH : 0 ≤ H)
    (hloc :
      ∀ v, v ∈ Finset.univ.filter (FK.boxBoundary 3 n) →
