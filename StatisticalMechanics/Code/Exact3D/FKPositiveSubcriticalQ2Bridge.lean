theorem finset_sum_attach_image_fiber_weight_nsmul
    {α β M : Type*} [DecidableEq β] [AddCommMonoid M]
    (S : Finset α) (f : {x // x ∈ S} → β) (W : β → M) :
    (∑ x ∈ S.attach, W (f x)) =
      ∑ y ∈ S.attach.image f,
        (S.attach.filter (fun x => f x = y)).card • W y := by
  rw [← Finset.sum_fiberwise_of_maps_to
    (s := S.attach) (t := S.attach.image f) (g := f)
    (fun x hx => Finset.mem_image.mpr ⟨x, hx, rfl⟩)
    (fun x => W (f x))]
  refine Finset.sum_congr rfl ?_
  intro y _hy
  have hinner :
      (∑ x ∈ S.attach.filter (fun x => f x = y), W (f x)) =
        ∑ _x ∈ S.attach.filter (fun x => f x = y), W y := by
    refine Finset.sum_congr rfl ?_
    intro x hx
    exact congrArg W (Finset.mem_filter.mp hx).2
  rw [hinner, Finset.sum_const]


theorem finset_sum_image_fiber_card_mul
    {α β : Type*} [DecidableEq β]
    (S : Finset α) (f : α → β) (W : β → ℝ) :
    Finset.sum S (fun x => W (f x)) =
      Finset.sum (S.image f)
        (fun y => ((S.filter (fun x => f x = y)).card : ℝ) * W y) := by
  classical
  calc
    Finset.sum S (fun x => W (f x)) =
        Finset.sum S
          (fun x => Finset.sum (S.image f)
            (fun y => if f x = y then W y else 0)) := by
      refine Finset.sum_congr rfl ?_
      intro x hx
      have hfx : f x ∈ S.image f := Finset.mem_image.mpr ⟨x, hx, rfl⟩
      rw [Finset.sum_eq_single (f x)]
      · simp
      · intro y _hy hne
        simp [hne.symm]
      · intro hnot
        exact (hnot hfx).elim
    _ =
        Finset.sum (S.image f)
          (fun y => Finset.sum S (fun x => if f x = y then W y else 0)) := by
      rw [Finset.sum_comm]
    _ =
        Finset.sum (S.image f)
          (fun y => ((S.filter (fun x => f x = y)).card : ℝ) * W y) := by
      refine Finset.sum_congr rfl ?_
      intro y _hy
      rw [← Finset.sum_filter]
      rw [Finset.sum_const]
      rw [nsmul_eq_mul]


theorem finset_sum_mul_le_const_mul_sum_of_le_nonneg
    {α : Type*} (S : Finset α) (C W : α → ℝ) {M : ℝ}
    (hC : ∀ x, x ∈ S → C x ≤ M)
    (hW : ∀ x, x ∈ S → 0 ≤ W x) :
    (∑ x ∈ S, C x * W x) ≤ M * ∑ x ∈ S, W x := by
  calc
    (∑ x ∈ S, C x * W x) ≤ ∑ x ∈ S, M * W x := by
      refine Finset.sum_le_sum ?_
      intro x hx
      exact mul_le_mul_of_nonneg_right (hC x hx) (hW x hx)
    _ = M * ∑ x ∈ S, W x := by
      rw [← Finset.mul_sum]




theorem finset_sum_le_subtype_sum_of_inactive_nonpos
    {α : Type*}
    (S : Finset α) (p : α → Prop) [DecidablePred p]
    (F : α → ℝ) (G : {a // p a} → ℝ)
    (hnot : ∀ a, a ∈ S → ¬ p a → F a ≤ 0)
    (hle : ∀ a, a ∈ S → (ha : p a) → F a ≤ G ⟨a, ha⟩) :
    Finset.sum S F ≤ Finset.sum (Finset.subtype p S) G := by
  classical
  let A : α → ℝ := fun a => if h : p a then G ⟨a, h⟩ else 0
  have hpoint : ∀ a ∈ S, F a ≤ A a := by
    intro a ha
    by_cases hpa : p a
    · simpa [A, hpa] using hle a ha hpa
    · simpa [A, hpa] using hnot a ha hpa
  have hfilter :
      Finset.sum S A = Finset.sum (S.filter p) A := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl ?_
    intro a _ha
    by_cases hpa : p a <;> simp [A, hpa]
  have hfilter_subtype :
      Finset.sum (S.filter p) A = Finset.sum (Finset.subtype p S) G := by
    symm
    refine Finset.sum_bij
      (fun a _ha => a.1)
      ?_ ?_ ?_ ?_
    · intro a ha
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_subtype.mp ha, a.2⟩
    · intro a _ha b _hb hab
      exact Subtype.ext hab
    · intro b hb
      exact
        ⟨⟨b, (Finset.mem_filter.mp hb).2⟩,
          Finset.mem_subtype.mpr (Finset.mem_filter.mp hb).1, rfl⟩
    · intro a _ha
      have hpa : p a.1 := a.2
      simp [hpa]
  calc
    Finset.sum S F ≤ Finset.sum S A :=
      Finset.sum_le_sum hpoint
    _ = Finset.sum (Finset.subtype p S) G := by
      rw [hfilter, hfilter_subtype]




structure FinsetFiberIndex (β : Type*) where
  α : Type*
  domain : Finset α
  map : α → β

namespace FinsetFiberIndex


noncomputable def image {β : Type*} (I : FinsetFiberIndex β) : Finset β :=
  letI : DecidableEq β := Classical.decEq _
  I.domain.image I.map


noncomputable def fiber {β : Type*}
    (I : FinsetFiberIndex β) (b : β) : Finset I.α :=
  letI : DecidableEq β := Classical.decEq _
  I.domain.filter (fun a => I.map a = b)



theorem mem_fiber {β : Type*}
    (I : FinsetFiberIndex β) (b : β) (a : I.α) :
    a ∈ I.fiber b ↔ a ∈ I.domain ∧ I.map a = b := by
  classical
  simp [fiber]



theorem mem_image {β : Type*}
    (I : FinsetFiberIndex β) (b : β) :
    b ∈ I.image ↔ ∃ a, a ∈ I.domain ∧ I.map a = b := by
  classical
  simp [image]



theorem image_card_le_domain_card {β : Type*}
    (I : FinsetFiberIndex β) :
    (I.image.card : ℝ) ≤ (I.domain.card : ℝ) := by
  classical
  have h : (I.domain.image I.map).card ≤ I.domain.card :=
    Finset.card_image_le
  exact_mod_cast (by
    simpa [image] using h)


theorem sum_fiber_weight {β : Type*}
    (I : FinsetFiberIndex β) (W : β → ℝ) :
    Finset.sum I.domain (fun a => W (I.map a)) =
      Finset.sum I.image
        (fun b => ((I.fiber b).card : ℝ) * W b) := by
  classical
  letI : DecidableEq β := Classical.decEq _
  simpa [image, fiber] using
    (finset_sum_image_fiber_card_mul I.domain I.map W)





theorem sum_le_const_mul_image_sum_of_fiber_card_le {β : Type*}
    (I : FinsetFiberIndex β) (W : β → ℝ) {B : ℝ}
    (hcard : ∀ b, b ∈ I.image → ((I.fiber b).card : ℝ) ≤ B)
    (hW : ∀ b, b ∈ I.image → 0 ≤ W b) :
    Finset.sum I.domain (fun a => W (I.map a)) ≤
      B * Finset.sum I.image W := by
  classical
  calc
    Finset.sum I.domain (fun a => W (I.map a)) =
        Finset.sum I.image
          (fun b => ((I.fiber b).card : ℝ) * W b) :=
      sum_fiber_weight I W
    _ ≤ Finset.sum I.image (fun b => B * W b) := by
      refine Finset.sum_le_sum ?_
      intro b hb
      exact mul_le_mul_of_nonneg_right (hcard b hb) (hW b hb)
    _ = B * Finset.sum I.image W := by
      rw [← Finset.mul_sum]




theorem image_sum_le_image_sum_mul_of_fiber_card_le {β : Type*}
    (I : FinsetFiberIndex β) (W C : β → ℝ)
    (hcard : ∀ b, b ∈ I.image → ((I.fiber b).card : ℝ) ≤ C b)
    (hW : ∀ b, b ∈ I.image → 0 ≤ W b) :
    Finset.sum I.image (fun b => ((I.fiber b).card : ℝ) * W b) ≤
      Finset.sum I.image (fun b => C b * W b) := by
  classical
  refine Finset.sum_le_sum ?_
  intro b hb
  exact mul_le_mul_of_nonneg_right (hcard b hb) (hW b hb)




theorem sum_le_image_sum_mul_of_fiber_card_le {β : Type*}
    (I : FinsetFiberIndex β) (W C : β → ℝ)
    (hcard : ∀ b, b ∈ I.image → ((I.fiber b).card : ℝ) ≤ C b)
    (hW : ∀ b, b ∈ I.image → 0 ≤ W b) :
    Finset.sum I.domain (fun a => W (I.map a)) ≤
      Finset.sum I.image (fun b => C b * W b) := by
  calc
    Finset.sum I.domain (fun a => W (I.map a)) =
        Finset.sum I.image
          (fun b => ((I.fiber b).card : ℝ) * W b) :=
      sum_fiber_weight I W
    _ ≤ Finset.sum I.image (fun b => C b * W b) :=
      image_sum_le_image_sum_mul_of_fiber_card_le I W C hcard hW

