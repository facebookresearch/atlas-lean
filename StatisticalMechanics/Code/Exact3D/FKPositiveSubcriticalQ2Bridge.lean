    {V : Type*} [DecidableEq V] (bdry : V → Prop) [DecidablePred bdry]
    {H : ℝ} (J : Sym2 V → ℝ) {x : V} (hx : bdry x) :
    boundaryGhostCoupling bdry H J s(none, some x) = H := by
  simp [hx]

