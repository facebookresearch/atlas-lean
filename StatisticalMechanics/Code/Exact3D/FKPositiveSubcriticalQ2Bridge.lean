    rw [hdedge]
    exact (Nat.sub_one_add_one_eq_of_pos hmpos).symm
  funext e
  by_cases he : e = eGhost
  · subst e
    rw [Function.update_self]
    exact hmsucc
  · have hmx : m e = d.1 e := by
      have h := congrFun hdec e
      simpa [Function.update_of_ne he] using h
