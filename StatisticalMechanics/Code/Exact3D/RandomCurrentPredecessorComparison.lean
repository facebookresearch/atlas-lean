      edgeCopyEquivOfEdgeEquiv_ends
        (Equiv.refl V) σ hm (by intro e; simpa using hends e) i
  have hmap :=
    randomCurrent_sources_image_of_vertexEquiv
      (Sharpness.FluxEdgeCopy.endsM G m)
      (Sharpness.FluxEdgeCopy.endsM G m')
      (Equiv.refl V) copyEquiv hcopy hends_copy
