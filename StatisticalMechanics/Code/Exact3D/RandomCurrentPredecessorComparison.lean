    intro K hsrc
    have hmap :=
      randomCurrent_sources_image_of_vertexEquiv
        (Sharpness.FluxEdgeCopy.endsM G m)
        (Sharpness.FluxEdgeCopy.endsM G m')
        φ copyEquiv copyEquiv.injective hends K
    simpa [hsrc, hAB] using hmap






