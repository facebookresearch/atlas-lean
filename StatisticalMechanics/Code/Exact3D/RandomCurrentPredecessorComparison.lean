                  (fun _ => 1) (routeRows ⟨m, hm⟩ i)) /
                384 := by
    intro m hm
    by_cases hm0 : m = m0
    · subst m
      simpa [splitRows, routeRows] using hpoint0
    · have hm_pair : m ∈ ({m0, m1} : Finset Profile) := by
        simpa [rows] using hm
      have hm_or : m = m0 ∨ m = m1 := by
        simpa [Finset.mem_insert, Finset.mem_singleton] using hm_pair
