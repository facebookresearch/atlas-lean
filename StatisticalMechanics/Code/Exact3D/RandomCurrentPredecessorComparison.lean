    (G : SimpleGraph V) [DecidableRel G.Adj]
    (β : ℝ) (J : Sym2 V → ℝ) (A B : Finset V)
    (m : ↥G.edgeFinset → ℕ) :
    edgeCopySourcePairSummand G β J A B m =
