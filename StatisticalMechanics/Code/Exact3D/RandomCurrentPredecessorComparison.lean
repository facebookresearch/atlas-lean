    (edgeCopyIncrementMap G m e0 i).1 = i.1 := by
  classical
  rcases i with ⟨e, k⟩
  by_cases he : e = e0
  · subst e
    simp [edgeCopyIncrementMap]
  · simp [edgeCopyIncrementMap, he]


