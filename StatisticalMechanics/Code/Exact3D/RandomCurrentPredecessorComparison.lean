        Sharpness.weight G β J (Sharpness.ofEdgeFun G m) := by
  have hpos : 0 < (Function.update m e (m e + 1)) e := by
    rw [Function.update_self]
    omega
  have hdec :=
    weight_ofEdgeFun_decrement G β J
