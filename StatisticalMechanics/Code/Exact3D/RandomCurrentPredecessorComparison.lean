    have hmap :=
      randomCurrent_sources_image_of_vertexEquiv
        (Sharpness.FluxEdgeCopy.endsM G m)
        (Sharpness.FluxEdgeCopy.endsM G m')
        φ copyEquiv copyEquiv.injective hends
        (Finset.univ : Finset (Sharpness.FluxEdgeCopy.Copy G m))
    rw [huniv] at hmap
    simpa [hsrc, hAB] using hmap
