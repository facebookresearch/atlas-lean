def sixVertexFourTwoStepCountExecutable
    (start finish : Fin 16) (grade : Fin 9) : Nat :=
  ∑ middle : Fin 16,
    if sixVertexRowDistance (sixVertexFourRowOfIndex start)
          (sixVertexFourRowOfIndex middle) +
        sixVertexRowDistance (sixVertexFourRowOfIndex middle)
          (sixVertexFourRowOfIndex finish) = grade.val then
      sixVertexFourHorizontalTransitionCount start middle *
        sixVertexFourHorizontalTransitionCount middle finish
    else 0

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem sixVertexFourTwoStepCountTable_certificate :
    ∀ start finish : Fin 16, ∀ grade : Fin 9,
      sixVertexFourTwoStepCountExecutable start finish grade =
        sixVertexFourTwoStepCountTable start finish grade := by
  decide +revert


def sixVertexFourTwoStepCountNat
    (start finish : Fin 16) (grade : Nat) : Nat :=
  if hgrade : grade < 9 then
    sixVertexFourTwoStepCountTable start finish ⟨grade, hgrade⟩
  else 0

def sixVertexFourDynamicPairGradeCount
    (seam opposite : Fin 16) (totalC : Nat) : Nat :=
  ∑ grade : Fin (totalC + 1),
    sixVertexFourTwoStepCountNat seam opposite grade.val *
      sixVertexFourTwoStepCountNat opposite seam (totalC - grade.val)

def sixVertexFourDynamicSeamGradeCount
    (sector : Fin 5) (totalC : Nat) (seam : Fin 16) : Nat :=
  if sixVertexUpCount (sixVertexFourRowOfIndex seam) = sector.val then
    ∑ opposite : Fin 16,
      sixVertexFourDynamicPairGradeCount seam opposite totalC
  else 0

def sixVertexFourDynamicGradeCount (sector : Fin 5) (totalC : Nat) : Nat :=
  ∑ seam : Fin 16,
    sixVertexFourDynamicSeamGradeCount sector totalC seam

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem sixVertexFourDynamicGradeCount_zero_test :
    sixVertexFourDynamicGradeCount sixVertexFourByFourSectorZero 0 = 16 := by
  decide +revert

end StatMech.FrontierD
