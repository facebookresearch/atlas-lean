module

public import Mathlib.Probability.CondVar
public import Mathlib.Probability.Moments.Covariance

import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real

/-!
# Intrinsic and extrinsic noise in gene expression

Swain, Elowitz and Siggia (2002) split the cell-to-cell variation of a protein level `P` into
an *intrinsic* part, the variance left when the extrinsic cellular state is held fixed, and an
*extrinsic* part, the variation of the conditional mean across extrinsic states. Writing `m`
for the σ-algebra generated by the extrinsic variables, their Eq. 8 is the law of total
variance divided by `⟨P⟩²`:

  `η_tot² = η_int² + η_ext²`,  `η_int² = ⟨Var(P | m)⟩ / ⟨P⟩²`,  `η_ext² = Var(⟨P | m⟩) / ⟨P⟩²`.

They (and Elowitz et al. 2002) measure both parts with two identical reporters `X`, `Y` in the
same cell (two-reporter estimators, Swain et al. Eq. 9):

  `η_int² = ⟨(X - Y)²⟩ / (2 ⟨X⟩⟨Y⟩)`,  `η_ext² = (⟨X Y⟩ - ⟨X⟩⟨Y⟩) / (⟨X⟩⟨Y⟩)`,
  `η_tot² = (⟨X² + Y²⟩ / 2 - ⟨X⟩⟨Y⟩) / (⟨X⟩⟨Y⟩)`.

## Main results

* `totalNoiseSq_eq_add`: the two-reporter quantities satisfy `η_tot² = η_int² + η_ext²` for any
  square-integrable `X`, `Y` (an algebraic identity of expectations).
* `IsIdenticalReporterPair`: given the extrinsic σ-algebra `m`, the reporters have equal
  conditional means and conditional second moments and are conditionally uncorrelated. This
  holds when `X` and `Y` are conditionally independent and identically distributed given `m`,
  the situation of two identical promoters in one cell.
* `covariance_eq_variance_condExp`: for such a pair, `Cov(X, Y) = Var(E[X | m])`.
* `integral_sub_sq_div_two_eq`: for such a pair, `⟨(X - Y)²⟩ / 2 = ⟨Var(X | m)⟩`.
* `intrinsicNoiseSq_eq`, `extrinsicNoiseSq_eq`, `totalNoiseSq_eq`: hence the two-reporter
  estimators equal `⟨Var(X | m)⟩ / ⟨X⟩²`, `Var(⟨X | m⟩) / ⟨X⟩²` and `Var(X) / ⟨X⟩²`, so the
  two-reporter decomposition is the law of total variance
  (`ProbabilityTheory.integral_condVar_add_variance_condExp`).

The noise strengths are meaningful when `⟨X⟩⟨Y⟩ > 0`; when it vanishes Lean's `x / 0 = 0`
makes every `η²` equal to `0` and the identities hold trivially.

## References

* P. S. Swain, M. B. Elowitz and E. D. Siggia, *Intrinsic and extrinsic contributions to
  stochasticity in gene expression*, Proc. Natl. Acad. Sci. USA 99 (2002) 12795–12800.
* M. B. Elowitz, A. J. Levine, E. D. Siggia and P. S. Swain, *Stochastic gene expression in a
  single cell*, Science 297 (2002) 1183–1186.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace MathlibExt.Biology.Dynamics.ExpressionNoise

variable {Ω : Type*} {m m₀ : MeasurableSpace Ω} {μ : Measure[m₀] Ω} {X Y : Ω → ℝ}

/-- Two-reporter intrinsic noise strength `η_int² = ⟨(X - Y)²⟩ / (2 ⟨X⟩⟨Y⟩)`. -/
noncomputable def intrinsicNoiseSq (μ : Measure[m₀] Ω) (X Y : Ω → ℝ) : ℝ :=
  μ[(X - Y) ^ 2] / (2 * (μ[X] * μ[Y]))

/-- Two-reporter extrinsic noise strength `η_ext² = (⟨X Y⟩ - ⟨X⟩⟨Y⟩) / (⟨X⟩⟨Y⟩)`. -/
noncomputable def extrinsicNoiseSq (μ : Measure[m₀] Ω) (X Y : Ω → ℝ) : ℝ :=
  (μ[X * Y] - μ[X] * μ[Y]) / (μ[X] * μ[Y])

/-- Two-reporter total noise strength `η_tot² = (⟨X² + Y²⟩ / 2 - ⟨X⟩⟨Y⟩) / (⟨X⟩⟨Y⟩)`. -/
noncomputable def totalNoiseSq (μ : Measure[m₀] Ω) (X Y : Ω → ℝ) : ℝ :=
  (μ[X ^ 2 + Y ^ 2] / 2 - μ[X] * μ[Y]) / (μ[X] * μ[Y])

/-- **Two-reporter decomposition** (Swain et al. 2002; Elowitz et al. 2002): for any
square-integrable reporters, `η_tot² = η_int² + η_ext²`. -/
theorem totalNoiseSq_eq_add (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    totalNoiseSq μ X Y = intrinsicNoiseSq μ X Y + extrinsicNoiseSq μ X Y := by
  have hX2 : Integrable (X ^ 2) μ := hX.integrable_sq
  have hY2 : Integrable (Y ^ 2) μ := hY.integrable_sq
  have hXY : Integrable (X * Y) μ := hX.integrable_mul hY
  have h1 : μ[X ^ 2 + Y ^ 2] = μ[X ^ 2] + μ[Y ^ 2] := integral_add' hX2 hY2
  have h2 : μ[(X - Y) ^ 2] = μ[X ^ 2] + μ[Y ^ 2] - 2 * μ[X * Y] := by
    have e : μ[(X - Y) ^ 2] = ∫ ω, (X ^ 2) ω + (Y ^ 2) ω - 2 * (X * Y) ω ∂μ := by
      congr 1; ext ω; simp only [Pi.pow_apply, Pi.sub_apply, Pi.mul_apply]; ring
    rw [e, integral_sub (f := fun ω ↦ (X ^ 2) ω + (Y ^ 2) ω) (g := fun ω ↦ 2 * (X * Y) ω)
      (hX2.add hY2) (hXY.const_mul 2), integral_add hX2 hY2, integral_const_mul]
  unfold totalNoiseSq intrinsicNoiseSq extrinsicNoiseSq
  rw [h1, h2]
  by_cases h : μ[X] * μ[Y] = 0
  · simp [h]
  · field_simp; ring

/-- Two reporters of the same gene given the extrinsic σ-algebra `m`: equal conditional means,
equal conditional second moments, and conditionally uncorrelated. Conditional independence with
identical conditional laws given `m` implies these three conditions. -/
structure IsIdenticalReporterPair (m : MeasurableSpace Ω) (μ : Measure[m₀] Ω)
    (X Y : Ω → ℝ) : Prop where
  condExp_eq : μ[X | m] =ᵐ[μ] μ[Y | m]
  condExp_sq_eq : μ[X ^ 2 | m] =ᵐ[μ] μ[Y ^ 2 | m]
  condExp_mul : μ[X * Y | m] =ᵐ[μ] μ[X | m] * μ[Y | m]

variable [IsProbabilityMeasure μ]

/-- Identical reporters have the same mean. -/
theorem IsIdenticalReporterPair.integral_eq (hm : m ≤ m₀) (h : IsIdenticalReporterPair m μ X Y) :
    μ[X] = μ[Y] := by
  rw [← integral_condExp hm, ← integral_condExp hm (f := Y)]
  exact integral_congr_ae h.condExp_eq

/-- For identical reporters the covariance is the extrinsic variance:
`Cov(X, Y) = Var(E[X | m])`. -/
theorem IsIdenticalReporterPair.covariance_eq_variance_condExp (hm : m ≤ m₀)
    (h : IsIdenticalReporterPair m μ X Y) (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    cov[X, Y; μ] = Var[μ[X | m]; μ] := by
  have hXY : μ[X * Y] = μ[μ[X | m] ^ 2] := by
    rw [← integral_condExp hm (f := X * Y)]
    apply integral_congr_ae
    filter_upwards [h.condExp_mul, h.condExp_eq] with ω hmul heq
    simp only [Pi.mul_apply, Pi.pow_apply] at hmul ⊢
    rw [hmul, ← heq, pow_two]
  rw [covariance_eq_sub hX hY, variance_eq_sub (hX.condExp one_le_two), hXY,
    integral_condExp hm, ← h.integral_eq hm]
  ring

/-- For identical reporters half the mean squared difference is the intrinsic variance:
`⟨(X - Y)²⟩ / 2 = ⟨Var(X | m)⟩`. -/
theorem IsIdenticalReporterPair.integral_sub_sq_div_two_eq (hm : m ≤ m₀)
    (h : IsIdenticalReporterPair m μ X Y) (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    μ[(X - Y) ^ 2] / 2 = μ[Var[X; μ | m]] := by
  have hX2 : Integrable (X ^ 2) μ := hX.integrable_sq
  have hY2 : Integrable (Y ^ 2) μ := hY.integrable_sq
  have hXY : Integrable (X * Y) μ := hX.integrable_mul hY
  have hsq : μ[X ^ 2] = μ[Y ^ 2] := by
    rw [← integral_condExp hm, ← integral_condExp hm (f := Y ^ 2)]
    exact integral_congr_ae h.condExp_sq_eq
  have hsub : μ[(X - Y) ^ 2] = μ[X ^ 2] + μ[Y ^ 2] - 2 * μ[X * Y] := by
    have e : μ[(X - Y) ^ 2] = ∫ ω, (X ^ 2) ω + (Y ^ 2) ω - 2 * (X * Y) ω ∂μ := by
      congr 1; ext ω; simp only [Pi.pow_apply, Pi.sub_apply, Pi.mul_apply]; ring
    rw [e, integral_sub (f := fun ω ↦ (X ^ 2) ω + (Y ^ 2) ω) (g := fun ω ↦ 2 * (X * Y) ω)
      (hX2.add hY2) (hXY.const_mul 2), integral_add hX2 hY2, integral_const_mul]
  have hcov := h.covariance_eq_variance_condExp hm hX hY
  have htotal := integral_condVar_add_variance_condExp hm hX
  rw [covariance_eq_sub hX hY, ← h.integral_eq hm] at hcov
  rw [variance_eq_sub hX] at htotal
  rw [hsub, ← hsq]
  nlinarith

/-- The two-reporter extrinsic noise is `Var(E[X | m]) / ⟨X⟩²` (Swain et al. Eq. 8). -/
theorem IsIdenticalReporterPair.extrinsicNoiseSq_eq (hm : m ≤ m₀)
    (h : IsIdenticalReporterPair m μ X Y) (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    extrinsicNoiseSq μ X Y = Var[μ[X | m]; μ] / μ[X] ^ 2 := by
  rw [extrinsicNoiseSq, ← covariance_eq_sub hX hY, h.covariance_eq_variance_condExp hm hX hY,
    ← h.integral_eq hm, sq]

/-- The two-reporter intrinsic noise is `⟨Var(X | m)⟩ / ⟨X⟩²` (Swain et al. Eq. 8). -/
theorem IsIdenticalReporterPair.intrinsicNoiseSq_eq (hm : m ≤ m₀)
    (h : IsIdenticalReporterPair m μ X Y) (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    intrinsicNoiseSq μ X Y = μ[Var[X; μ | m]] / μ[X] ^ 2 := by
  rw [intrinsicNoiseSq, ← h.integral_sub_sq_div_two_eq hm hX hY, ← h.integral_eq hm, div_div]
  ring

/-- The two-reporter total noise is `Var(X) / ⟨X⟩²`, and it splits into the intrinsic and
extrinsic parts by the law of total variance. -/
theorem IsIdenticalReporterPair.totalNoiseSq_eq (hm : m ≤ m₀)
    (h : IsIdenticalReporterPair m μ X Y) (hX : MemLp X 2 μ) (hY : MemLp Y 2 μ) :
    totalNoiseSq μ X Y = Var[X; μ] / μ[X] ^ 2 := by
  rw [totalNoiseSq_eq_add hX hY, h.intrinsicNoiseSq_eq hm hX hY,
    h.extrinsicNoiseSq_eq hm hX hY, ← add_div, integral_condVar_add_variance_condExp hm hX]

end MathlibExt.Biology.Dynamics.ExpressionNoise
