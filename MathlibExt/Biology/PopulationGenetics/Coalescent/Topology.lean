module

public import Mathlib.Data.Fintype.Pi
public import Mathlib.Data.Fintype.Powerset
public import Mathlib.MeasureTheory.Constructions.Pi
public import Mathlib.Probability.UniformOn
import Mathlib.Data.Nat.Choose.Cast

/-!
# Coalescent topology: ranked labeled histories under random joining

In Kingman's coalescent the tree topology is independent of the holding times and is
generated by **random joining**: while there are `k` lineages, the pair that coalesces next is
uniform among the `k.choose 2` pairs, independently of the past (Edwards 1970; Kingman 1982).
A *ranked labeled history* of a sample of `n` labeled genes is the sequence of coalescence
events, from `n` lineages down to one.

We do not derive random joining from a continuous-time model of the coalescent; it is the
definition of the law here. We encode a history by the merged pairs. At step `i` (for
`i < n - 1`) there are `n - i` lineages, labeled `0, …, n - i - 1`, and the step records the
unordered pair (a two-element `Finset`) of lineages that merges. After a merger the new
lineage takes the smaller label of the pair and the remaining lineages keep their relative
order (`mergeBlocks`, `blocksAfter`, `blocksOf`).
`partitionsOf` decodes a history into its sequence of ancestral partitions of the sample (the
ranked labeled history proper); the tests check by kernel evaluation that this decoding is
injective for `n ≤ 5`, but injectivity for general `n` is not proved here. Then

* there are `∏_{k=2}^n C(k, 2) = n! (n - 1)! / 2^{n-1}` ranked labeled histories;
* under random joining every ranked labeled history has probability
  `2^{n-1} / (n! (n - 1)!)`.

## Main results

* `RankedHistory`: ranked labeled histories of `n` leaves.
* `blocksAfter`, `blocksOf`, `partitionsOf`: the sequence of ancestral partitions of a history.
* `card_rankedHistory`, `card_rankedHistory_mul_two_pow`: the count
  `∏_{k=2}^n C(k, 2)` and `#histories * 2^{n-1} = n! (n - 1)!`.
* `randomJoining`: the random-joining law (independent uniform pairs at each step).
* `randomJoining_singleton`: each history has probability `2^{n-1} / (n! (n - 1)!)`.

## References

* A. W. F. Edwards, *Estimation of the branch points of a branching diffusion process*,
  J. R. Stat. Soc. B 32 (1970), 155–174.
* F. Tajima, *Evolutionary relationship of DNA sequences in finite populations*, Genetics 105
  (1983), 437–460.
* J. Wakeley, *Coalescent Theory: An Introduction* (2009), §3.2.
-/

@[expose] public section

open Finset MeasureTheory

namespace MathlibExt.Biology.PopulationGenetics.Coalescent

/-- The unordered pairs of lineages when there are `k` lineages labeled `0, …, k - 1`. -/
abbrev LineagePair (k : ℕ) : Type := {s : Finset (Fin k) // s.card = 2}

/-- A **ranked labeled history** of `n` labeled genes, encoded by its coalescence events: at
step `i < n - 1` there are `n - i` lineages and the step records the pair that merges (the
merged lineage takes the smaller label; the others keep their relative order). -/
abbrev RankedHistory (n : ℕ) : Type := (i : Fin (n - 1)) → LineagePair (n - i)

/-- The number of pairs of `k` lineages is `k.choose 2`. -/
theorem card_lineagePair (k : ℕ) : Fintype.card (LineagePair k) = k.choose 2 := by
  rw [Fintype.card_finset_len, Fintype.card_fin]

/-! ### Ancestral partitions of a history -/

/-- Merge the lineages (blocks of sampled genes) at positions `a < b` of a list of blocks: the
merged block replaces position `a`, and position `b` is removed. -/
def mergeBlocks {n : ℕ} (bs : List (Finset (Fin n))) (a b : ℕ) : List (Finset (Fin n)) :=
  (bs.set a (bs.getD a ∅ ∪ bs.getD b ∅)).eraseIdx b

/-- The lineages (as blocks of sampled genes, indexed by lineage label) after the first `t`
coalescence events of a history, starting from the singletons `{0}, …, {n - 1}`. -/
def blocksAfter {n : ℕ} (h : RankedHistory n) (t : ℕ) : List (Finset (Fin n)) :=
  ((List.finRange (n - 1)).take t).foldl
    (fun bs i =>
      let s : Finset ℕ := (h i).1.map Fin.valEmbedding
      mergeBlocks bs (s.min.getD 0) (s.max.getD 0))
    ((List.finRange n).map fun j => {j})

/-- The ancestral partitions of the sample along a history, as lists of blocks indexed by
lineage label; entry `t` (for `t < n`) is the partition after `t` coalescence events. -/
def blocksOf {n : ℕ} (h : RankedHistory n) : List (List (Finset (Fin n))) :=
  (List.range n).map (blocksAfter h)

/-- The ancestral partitions of the sample along a history, as sets of blocks (forgetting the
lineage labels): the ranked labeled history in the sense of Edwards (1970). -/
def partitionsOf {n : ℕ} (h : RankedHistory n) : List (Finset (Finset (Fin n))) :=
  (blocksOf h).map List.toFinset

/-! ### Counting -/

/-- `∏_{k=2}^n C(k, 2) * 2^{n-1} = n! (n - 1)!`. -/
theorem prod_choose_two_mul_two_pow (n : ℕ) :
    (∏ k ∈ Icc 2 n, k.choose 2) * 2 ^ (n - 1) = n.factorial * (n - 1).factorial := by
  induction n with
  | zero => simp
  | succ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    rw [prod_Icc_succ_top (by omega), show n + 1 - 1 = (n - 1) + 1 by omega, pow_succ,
      Nat.factorial_succ, show n - 1 + 1 = n by omega]
    have h2 : (n + 1).choose 2 * 2 = (n + 1) * n := by
      rw [Nat.choose_two_right, Nat.add_sub_cancel]
      exact Nat.div_mul_cancel (by rw [mul_comm]; exact (Nat.even_mul_succ_self n).two_dvd)
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    simp only [Nat.add_sub_cancel] at ih ⊢
    rw [Nat.factorial_succ m]
    calc (∏ k ∈ Icc 2 (m + 1), k.choose 2) * (m + 1 + 1).choose 2 * (2 ^ m * 2)
        = ((∏ k ∈ Icc 2 (m + 1), k.choose 2) * 2 ^ m) * ((m + 1 + 1).choose 2 * 2) := by ring
      _ = (m + 1 + 1) * ((m + 1) * m.factorial) * ((m + 1) * m.factorial) := by
        rw [ih, h2, Nat.factorial_succ]
        ring

/-- Reindexing: `∏_{i < n - 1} C(n - i, 2) = ∏_{k=2}^n C(k, 2)`. -/
theorem prod_fin_choose_two (n : ℕ) :
    ∏ i : Fin (n - 1), (n - (i : ℕ)).choose 2 = ∏ k ∈ Icc 2 n, k.choose 2 := by
  rw [Fin.prod_univ_eq_prod_range (fun i => (n - i).choose 2)]
  refine prod_nbij' (fun i => n - i) (fun k => n - k) ?_ ?_ ?_ ?_ ?_ <;>
    intro a ha <;> simp only [mem_range, mem_Icc] at ha ⊢ <;> omega

/-- **Number of ranked labeled histories**: `∏_{k=2}^n C(k, 2)` (Edwards 1970). -/
theorem card_rankedHistory (n : ℕ) :
    Fintype.card (RankedHistory n) = ∏ k ∈ Icc 2 n, k.choose 2 := by
  rw [Fintype.card_pi]
  simp only [card_lineagePair]
  exact prod_fin_choose_two n

/-- **Number of ranked labeled histories**: `#histories * 2^{n-1} = n! (n - 1)!`, i.e. there are
`n! (n - 1)! / 2^{n-1}` ranked labeled histories of `n` labeled genes (Edwards 1970). -/
theorem card_rankedHistory_mul_two_pow (n : ℕ) :
    Fintype.card (RankedHistory n) * 2 ^ (n - 1) = n.factorial * (n - 1).factorial := by
  rw [card_rankedHistory, prod_choose_two_mul_two_pow]

/-! ### Random joining -/

/-- At step `i < n - 1` of a history there are `n - i ≥ 2` lineages, hence some pair. -/
instance (n : ℕ) (i : Fin (n - 1)) : Nonempty (LineagePair (n - i)) := by
  have hi : 2 ≤ n - (i : ℕ) := by omega
  refine ⟨⟨{⟨0, by omega⟩, ⟨1, by omega⟩}, ?_⟩⟩
  rw [card_pair]
  simp [Fin.ext_iff]

/-- **Random joining** (Edwards 1970; Kingman 1982): the pair merging at each step is uniform
among the current `(n - i).choose 2` pairs and independent of the earlier steps. Kingman (1982)
shows that this is the law of the tree topology of the coalescent; that derivation from the
coalescent process is not formalized here. -/
noncomputable def randomJoining (n : ℕ) : Measure (RankedHistory n) :=
  Measure.pi fun i => ProbabilityTheory.uniformOn (Set.univ : Set (LineagePair (n - i)))

/-- The random-joining law is a probability measure. -/
instance (n : ℕ) : IsProbabilityMeasure (randomJoining n) := by
  unfold randomJoining
  infer_instance

/-- Under random joining each history has probability `∏_{k=2}^n C(k, 2)⁻¹`. -/
theorem randomJoining_singleton_eq_inv (n : ℕ) (h : RankedHistory n) :
    randomJoining n {h} = ((∏ k ∈ Icc 2 n, k.choose 2 : ℕ) : ENNReal)⁻¹ := by
  rw [randomJoining, ← Set.univ_pi_singleton, Measure.pi_pi]
  simp only [ProbabilityTheory.uniformOn_univ, Measure.count_singleton, card_lineagePair,
    one_div]
  rw [← ENNReal.prod_inv_distrib (fun _ _ _ _ _ => Or.inr (ENNReal.natCast_ne_top _)),
    ← prod_fin_choose_two n]
  push_cast
  rfl

/-- **Each ranked labeled history has probability `2^{n-1} / (n! (n - 1)!)`** under random
joining (Edwards 1970; Tajima 1983). -/
theorem randomJoining_singleton (n : ℕ) (h : RankedHistory n) :
    randomJoining n {h} = 2 ^ (n - 1) / (n.factorial * (n - 1).factorial : ℕ) := by
  rw [randomJoining_singleton_eq_inv, ← prod_choose_two_mul_two_pow, Nat.cast_mul,
    ENNReal.div_eq_inv_mul, ENNReal.mul_inv (by simp) (by simp), mul_comm, ← mul_assoc]
  push_cast
  rw [mul_right_comm, ENNReal.mul_inv_cancel (by simp) (by simp), one_mul]

end MathlibExt.Biology.PopulationGenetics.Coalescent
