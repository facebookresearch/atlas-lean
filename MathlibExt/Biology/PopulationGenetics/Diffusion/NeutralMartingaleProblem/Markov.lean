/-!
# Markov property of the neutral Wright–Fisher realization

`NeutralMartingaleProblem.Realization` attaches the natural filtration `naturalFiltration x` to
the selected continuous realization `modifiedProcess x` under the path measure `rawMeasure x`,
and `NeutralMartingaleProblem.Generator` shows that a continuous `[0, 1]`-valued process which is
Markov with transition semigroup `wfSemigroup`, in the conditional-expectation form
`μ[g (X t) | ℱ s] = (wfSemigroup (t - s) g) (X s)`, solves the neutral martingale problem.
This file proves that the realization satisfies that Markov hypothesis, in exactly the form
used by `isWrightFisherSolution_zero_of_markov`, and hence solves the neutral Wright–Fisher
martingale problem.

## Main results

* `map_modifiedState_comp_eq_finiteChainLaw`: at any increasing finite list of times the
  realization has the iterated-kernel law.
* `condExp_modifiedProcess_eq_wfSemigroup`: the Markov property
  `E_x[g (X_t) | ℱ_s] = (wfSemigroup (t - s) g) (X_s)` a.s. for the natural filtration.
* `isWrightFisherSolution_zero_modifiedProcess`: the realization solves the neutral
  Wright–Fisher martingale problem `IsWrightFisherSolution 0`.

## Method

Appending a time `b` to a chain of times multiplies its law by one kernel step
`K (b - τ_last)` from the last state (`MarkovSemigroupProjective.map_init_last_finiteChainLaw_snoc`,
proved for arbitrary transition kernels in `MathlibExt.Probability.MarkovSemigroupProjective`). The
natural filtration at time `s` is generated by the cylinder events
`{(X_r)_{r ∈ J} ∈ S}` with `J ⊆ [0, s]` finite, a π-system. On a cylinder event, listing
`J ∪ {s}` in increasing order and appending `t`, the finite-dimensional law and the appended
kernel step turn `∫_A g (X_t)` into `∫_A (P_{t-s} g) (X_s)`. The π-λ theorem extends the identity
to the whole natural σ-algebra.

## References

* S. N. Ethier and T. G. Kurtz, *Markov Processes: Characterization and Convergence*, Wiley
  (1986), ch. 4, §1 (Markov processes from transition functions) and ch. 10.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal ProbabilityTheory unitInterval

namespace MathlibExt.Biology.PopulationGenetics.Diffusion.NeutralMartingaleProblem

open MathlibExt.Probability.MarkovSemigroupProjective
open MathlibExt.Biology.PopulationGenetics.Diffusion.NeutralWrightFisherRaw
open MathlibExt.Biology.PopulationGenetics.Diffusion.WrightFisherSemigroup

/-- **Finite-dimensional laws of the realization.** At any strictly increasing list of times
`τ`, the states `(X_{τ i})ᵢ` of the realization started at `x` have the iterated-kernel law
`finiteChainLaw neutralKernel x 0 τ`.

Source: Kolmogorov extension (`map_ordered_pathMeasure`) restricted along the increasing
reindexing of the image of `τ`, and the fixed-time modification property of the
realization. -/
theorem map_modifiedState_comp_eq_finiteChainLaw (x : I) {m : ℕ} {τ : Fin m → ℝ≥0}
    (hτ : StrictMono τ) :
    (rawMeasure x).map (fun ω i => modifiedState x (τ i) ω) =
      finiteChainLaw neutralKernel x 0 τ := by
  have hae : (fun ω i => modifiedState x (τ i) ω) =ᵐ[rawMeasure x] fun ω i => ω (τ i) := by
    filter_upwards [ae_all_iff.2 fun i => modifiedState_ae_eq_eval x (τ i)] with ω hω
    exact funext hω
  rw [Measure.map_congr hae]
  let T : Finset ℝ≥0 := Finset.univ.image τ
  have hmem : ∀ i, τ i ∈ T := fun i => Finset.mem_image_of_mem τ (Finset.mem_univ i)
  let e : Fin m → Fin T.card := fun i => (T.orderIsoOfFin rfl).symm ⟨τ i, hmem i⟩
  have hte : ∀ i, T.orderEmbOfFin rfl (e i) = τ i := fun i =>
    congrArg Subtype.val ((T.orderIsoOfFin rfl).apply_symm_apply ⟨τ i, hmem i⟩)
  have he : StrictMono e := fun a b hab =>
    (T.orderIsoOfFin rfl).symm.strictMono (show (⟨τ a, hmem a⟩ : T) < ⟨τ b, hmem b⟩ from hτ hab)
  calc (rawMeasure x).map (fun ω i => ω (τ i))
      = ((rawMeasure x).map (fun ω k => ω (T.orderEmbOfFin rfl k))).map
          (fun z i => z (e i)) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        congr 1
        funext ω i
        simp [hte]
    _ = (finiteChainLaw neutralKernel x 0 (T.orderEmbOfFin rfl)).map (fun z i => z (e i)) := by
        rw [rawMeasure, map_ordered_pathMeasure]
    _ = finiteChainLaw neutralKernel x 0 (fun i => T.orderEmbOfFin rfl (e i)) :=
        finiteChainLaw_map_strictMono neutralKernel neutralKernel_add x _ (fun _ => bot_le)
          (T.orderEmbOfFin rfl).strictMono e he
    _ = finiteChainLaw neutralKernel x 0 τ := by simp_rw [hte]

/-- A continuous function of a measurable `[0, 1]`-valued state is integrable. -/
private theorem integrable_comp_state {Ω : Type*} [MeasurableSpace Ω] {ν : Measure Ω}
    [IsFiniteMeasure ν] {Y : Ω → I} (hY : Measurable Y) (g : C(I, ℝ)) :
    Integrable (fun ω => g (Y ω)) ν :=
  Integrable.of_bound (g.continuous.measurable.comp hY).aestronglyMeasurable ‖g‖
    (ae_of_all _ fun _ => g.norm_coe_le_norm _)

private theorem strictMono_snoc {n : ℕ} {τ : Fin (n + 1) → ℝ≥0} (hτ : StrictMono τ) {t : ℝ≥0}
    (ht : τ (Fin.last n) < t) : StrictMono (Fin.snoc τ t : Fin (n + 2) → ℝ≥0) := by
  rw [Fin.strictMono_iff_lt_succ]
  intro i
  induction i using Fin.lastCases with
  | last =>
    rw [Fin.succ_last, Fin.snoc_last]
    simpa using ht
  | cast j =>
    rw [Fin.succ_castSucc, Fin.snoc_castSucc, Fin.snoc_castSucc]
    exact hτ Fin.castSucc_lt_succ

/-- The Markov identity on the event `{(X_{τ i})ᵢ ∈ A}` when the last time of `τ` is `s`. -/
private theorem setIntegral_cylinder (x : I) {s t : ℝ≥0} (hst : s < t) (g : C(I, ℝ)) {n : ℕ}
    {τ : Fin (n + 1) → ℝ≥0} (hτ : StrictMono τ) (hτs : τ (Fin.last n) = s)
    {A : Set (Fin (n + 1) → I)} (hA : MeasurableSet A) :
    ∫ ω in (fun ω i => modifiedState x (τ i) ω) ⁻¹' A,
        wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω) ∂rawMeasure x =
      ∫ ω in (fun ω i => modifiedState x (τ i) ω) ⁻¹' A, g (modifiedState x t ω) ∂rawMeasure x := by
  have hτ' := strictMono_snoc hτ (hτs ▸ hst)
  let Φ : SamplePath → Fin (n + 1) → I := fun ω i => modifiedState x (τ i) ω
  let Ψ : SamplePath → Fin (n + 2) → I := fun ω i =>
    modifiedState x ((Fin.snoc τ t : Fin (n + 2) → ℝ≥0) i) ω
  have hmΦ : Measurable Φ := Measurable.of_eval fun i => measurable_modifiedState x _
  have hmΨ : Measurable Ψ := Measurable.of_eval fun i => measurable_modifiedState x _
  have hlast : Measurable fun z : Fin (n + 2) → I => (Fin.init z, z (Fin.last (n + 1))) :=
    (Measurable.of_eval fun _ => measurable_pi_apply _).prodMk (measurable_pi_apply _)
  let η := (neutralKernel (t - τ (Fin.last n))).comap (fun w : Fin (n + 1) → I => w (Fin.last n))
    (measurable_pi_apply _)
  have hstep : ∀ w : Fin (n + 1) → I,
      ∫ y, g y ∂η w = wfSemigroup ((t : ℝ) - s) g (w (Fin.last n)) := by
    intro w
    rw [Kernel.comap_apply, neutralKernel, integral_wfTransitionKernel, hτs,
      NNReal.coe_sub hst.le]
  have hpre : ((fun z : Fin (n + 2) → I => (Fin.init z, z (Fin.last (n + 1)))) ∘ Ψ) ⁻¹'
      (A ×ˢ univ) = Φ ⁻¹' A := by
    have hinit : ∀ ω, Fin.init (Ψ ω) = Φ ω := fun ω => funext fun i => by simp [Ψ, Φ, Fin.init]
    ext ω
    simp only [mem_preimage, Function.comp_apply, mem_prod, mem_univ, and_true, hinit]
  have hfun : ∀ ω, (((fun z : Fin (n + 2) → I => (Fin.init z, z (Fin.last (n + 1)))) ∘ Ψ) ω).2 =
      modifiedState x t ω := fun ω => by simp [Ψ]
  symm
  calc ∫ ω in Φ ⁻¹' A, g (modifiedState x t ω) ∂rawMeasure x
      = ∫ p in A ×ˢ univ, g p.2 ∂(finiteChainLaw neutralKernel x 0 τ ⊗ₘ η) := by
        rw [← map_init_last_finiteChainLaw_snoc, ← map_modifiedState_comp_eq_finiteChainLaw x hτ',
          Measure.map_map hlast hmΨ, setIntegral_map (f := fun p : (Fin (n + 1) → I) × I => g p.2)
            (hA.prod MeasurableSet.univ)
            (g.continuous.measurable.comp measurable_snd).aestronglyMeasurable
            (hlast.comp hmΨ).aemeasurable, hpre]
        simp only [hfun]
    _ = ∫ w in A, wfSemigroup ((t : ℝ) - s) g (w (Fin.last n))
          ∂finiteChainLaw neutralKernel x 0 τ := by
        rw [Measure.setIntegral_compProd hA MeasurableSet.univ
          (integrable_comp_state measurable_snd g).integrableOn]
        simp only [Measure.restrict_univ, hstep]
    _ = ∫ ω in Φ ⁻¹' A, wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω) ∂rawMeasure x := by
        rw [← map_modifiedState_comp_eq_finiteChainLaw x hτ, setIntegral_map
          (f := fun w : Fin (n + 1) → I => wfSemigroup ((t : ℝ) - s) g (w (Fin.last n))) hA
          ((wfSemigroup _ g).continuous.measurable.comp
            (measurable_pi_apply (Fin.last n))).aestronglyMeasurable hmΦ.aemeasurable]
        simp [Φ, hτs]

/-- The Markov identity on a cylinder event `{(X_r)_{r ∈ J} ∈ S}` of the natural filtration at
time `s`. -/
private theorem setIntegral_natural_cylinder (x : I) {s t : ℝ≥0} (hst : s < t) (g : C(I, ℝ))
    (J : Finset (Iic s)) {S : Set (J → ℝ)} (hS : MeasurableSet S) :
    ∫ ω in (fun ω (j : Iic s) => modifiedProcess x j ω) ⁻¹' MeasureTheory.cylinder J S,
        wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω) ∂rawMeasure x =
      ∫ ω in (fun ω (j : Iic s) => modifiedProcess x j ω) ⁻¹' MeasureTheory.cylinder J S,
        g (modifiedState x t ω) ∂rawMeasure x := by
  classical
  let T : Finset ℝ≥0 := insert s (J.map (Function.Embedding.subtype _))
  have hTs : ∀ r ∈ T, r ≤ s := by
    intro r hr
    rcases Finset.mem_insert.1 hr with rfl | hr
    · exact le_rfl
    · obtain ⟨j, -, rfl⟩ := Finset.mem_map.1 hr
      exact j.2
  have hsT : s ∈ T := Finset.mem_insert_self _ _
  obtain ⟨n, hn⟩ : ∃ n, T.card = n + 1 :=
    ⟨T.card - 1, by have := Finset.card_pos.2 ⟨s, hsT⟩; omega⟩
  have hmemJ : ∀ j : J, (j : Iic s).1 ∈ T := fun j =>
    Finset.mem_insert_of_mem (Finset.mem_map_of_mem _ j.2)
  let idx : J → Fin (n + 1) := fun j => (T.orderIsoOfFin hn).symm ⟨(j : Iic s).1, hmemJ j⟩
  have hidx : ∀ j, T.orderEmbOfFin hn (idx j) = (j : Iic s).1 := fun j =>
    congrArg Subtype.val ((T.orderIsoOfFin hn).apply_symm_apply ⟨(j : Iic s).1, hmemJ j⟩)
  have hτs : T.orderEmbOfFin hn (Fin.last n) = s := by
    refine le_antisymm (hTs _ (T.orderEmbOfFin_mem hn _)) ?_
    have h : T.orderEmbOfFin hn ((T.orderIsoOfFin hn).symm ⟨s, hsT⟩) = s :=
      congrArg Subtype.val ((T.orderIsoOfFin hn).apply_symm_apply ⟨s, hsT⟩)
    calc s = T.orderEmbOfFin hn ((T.orderIsoOfFin hn).symm ⟨s, hsT⟩) := h.symm
      _ ≤ T.orderEmbOfFin hn (Fin.last n) := (T.orderEmbOfFin hn).monotone (Fin.le_last _)
  let ρ : (Fin (n + 1) → I) → J → ℝ := fun w j => (w (idx j) : ℝ)
  have hρ : Measurable ρ := Measurable.of_eval fun j => measurable_subtype_coe.comp
    (measurable_pi_apply _)
  have hset : (fun ω (j : Iic s) => modifiedProcess x j ω) ⁻¹' MeasureTheory.cylinder J S =
      (fun ω i => modifiedState x (T.orderEmbOfFin hn i) ω) ⁻¹' (ρ ⁻¹' S) := by
    ext ω
    simp only [mem_preimage, MeasureTheory.mem_cylinder]
    have h : J.restrict (fun j : Iic s => modifiedProcess x j ω) =
        ρ fun i => modifiedState x (T.orderEmbOfFin hn i) ω := by
      funext j
      simp [ρ, hidx]
    rw [h]
  rw [hset]
  exact setIntegral_cylinder x hst g (T.orderEmbOfFin hn).strictMono hτs (hρ hS)

/-- **Markov property of the neutral Wright–Fisher realization.** For the selected continuous
realization `modifiedProcess x` under `rawMeasure x`, its natural filtration, times `s ≤ t` and a
continuous test function `g` on `[0, 1]`,
`E_x[g (X_t) | ℱ_s] = (wfSemigroup (t - s) g) (X_s)` almost surely. States are read in `[0, 1]`
through `Set.projIcc`, exactly as in the hypothesis of `isWrightFisherSolution_zero_of_markov`.

Source: Ethier & Kurtz (1986), ch. 4, §1, (1.1) and Thm. 1.1: a process whose
finite-dimensional laws are built from a transition function is Markov with respect to its
natural filtration. The proof checks the identity on cylinder events using
`map_modifiedState_comp_eq_finiteChainLaw` and `map_init_last_finiteChainLaw_snoc`, and
extends it by the π-λ theorem. -/
theorem condExp_modifiedProcess_eq_wfSemigroup (x : I) {s t : ℝ≥0} (hst : s ≤ t)
    (g : C(I, ℝ)) :
    (rawMeasure x)[fun ω => g (projIcc (0 : ℝ) 1 zero_le_one (modifiedProcess x t ω)) |
        naturalFiltration x s] =ᵐ[rawMeasure x]
      fun ω =>
        wfSemigroup ((t : ℝ) - s) g (projIcc (0 : ℝ) 1 zero_le_one (modifiedProcess x s ω)) := by
  have hproj : ∀ r ω,
      projIcc (0 : ℝ) 1 zero_le_one (modifiedProcess x r ω) = modifiedState x r ω :=
    fun r ω => projIcc_of_mem _ (modifiedProcess_mem_Icc x r ω)
  simp_rw [hproj]
  set μ := rawMeasure x
  set ℱ := naturalFiltration x
  have hYm : ∀ r, Measurable[ℱ r] (modifiedState x r) := fun r =>
    (measurable_modifiedProcess_naturalFiltration x le_rfl).subtype_mk
  have hGi : Integrable (fun ω => g (modifiedState x t ω)) μ :=
    integrable_comp_state (measurable_modifiedState x t) g
  have hHi : Integrable (fun ω => wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω)) μ :=
    integrable_comp_state (measurable_modifiedState x s) _
  rcases hst.eq_or_lt with rfl | hlt
  · simp only [sub_self, wfSemigroup_zero, one_apply_eq_self]
    rw [condExp_of_stronglyMeasurable (ℱ.le s) (f := fun ω => g (modifiedState x s ω))
      (g.continuous.measurable.comp (hYm s)).stronglyMeasurable hGi]
  have hHm : StronglyMeasurable[ℱ s] fun ω => wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω) :=
    ((wfSemigroup _ g).continuous.measurable.comp (hYm s)).stronglyMeasurable
  refine (ae_eq_condExp_of_forall_setIntegral_eq (ℱ.le s) hGi
    (fun _ _ _ => hHi.integrableOn) (fun A hA _ => ?_) hHm.aestronglyMeasurable).symm
  have hgen : ℱ s = MeasurableSpace.generateFrom {B | ∃ C ∈ measurableCylinders fun _ : Iic s => ℝ,
      (fun ω (j : Iic s) => modifiedProcess x j ω) ⁻¹' C = B} := by
    rw [show ℱ s = _ from Filtration.natural_eq_comap _ _ s, ← generateFrom_measurableCylinders,
      MeasurableSpace.comap_generateFrom]
    rfl
  have hpi := (isPiSystem_measurableCylinders (α := fun _ : Iic s => ℝ)).comap
    fun ω (j : Iic s) => modifiedProcess x j ω
  have huniv : ∫ ω, wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω) ∂μ =
      ∫ ω, g (modifiedState x t ω) ∂μ := by
    have h := setIntegral_cylinder x hlt g (n := 0) (τ := fun _ => s) (fun a b hab => by
      have := a.isLt; have := b.isLt; rw [Fin.lt_def] at hab; omega) rfl MeasurableSet.univ
    simpa using h
  refine MeasurableSpace.induction_on_inter (m := ℱ s)
    (C := fun A _ => ∫ ω in A, wfSemigroup ((t : ℝ) - s) g (modifiedState x s ω) ∂μ =
      ∫ ω in A, g (modifiedState x t ω) ∂μ) hgen hpi (by simp) ?_ ?_ ?_ A hA
  · rintro _ ⟨C, hC, rfl⟩
    obtain ⟨J, S, hS, rfl⟩ := (mem_measurableCylinders C).1 hC
    exact setIntegral_natural_cylinder x hlt g J hS
  · intro B hB hBeq
    rw [setIntegral_compl (ℱ.le s _ hB) hHi, setIntegral_compl (ℱ.le s _ hB) hGi, hBeq, huniv]
  · intro f hdisj hfm hf
    rw [integral_iUnion (fun i => ℱ.le s _ (hfm i)) hdisj hHi.integrableOn,
      integral_iUnion (fun i => ℱ.le s _ (hfm i)) hdisj hGi.integrableOn]
    exact tsum_congr hf

/-- **The neutral Wright–Fisher realization solves the martingale problem.** The selected
continuous realization `modifiedProcess x`, with its natural filtration and the path measure
`rawMeasure x`, solves the neutral Wright–Fisher martingale problem
`IsWrightFisherSolution 0`: for every `C²` test function `f`,
`f (X_t) - f (X_0) - ∫₀ᵗ (x (1 - x) / 2 · f'') (X_s) ds` is a martingale.

Source: Ethier & Kurtz (1986), ch. 4, Prop. 1.7, via `isWrightFisherSolution_zero_of_markov`
and the Markov property `condExp_modifiedProcess_eq_wfSemigroup`. -/
theorem isWrightFisherSolution_zero_modifiedProcess (x : I) :
    KimuraFixationProcess.IsWrightFisherSolution 0 (naturalFiltration x) (rawMeasure x)
      (modifiedProcess x) :=
  isWrightFisherSolution_zero_of_markov (modifiedProcess_mem_Icc x) (continuous_modifiedProcess x)
    (stronglyAdapted_naturalFiltration x) fun _ _ hst g =>
      condExp_modifiedProcess_eq_wfSemigroup x hst g

end MathlibExt.Biology.PopulationGenetics.Diffusion.NeutralMartingaleProblem
