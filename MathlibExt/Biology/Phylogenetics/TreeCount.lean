/-!
# Counting rooted binary phylogenetic trees

A rooted binary phylogenetic tree on a finite set of taxa `X` is a rooted tree in which every
internal vertex has exactly two children, the two children are *unordered*, and the leaves are
labeled bijectively by `X`. Two such trees are the same when there is a root- and
label-preserving isomorphism between them.

We encode such a tree by any of its planar drawings: a `PlaneTree α` is a binary tree with
leaves labeled by `α` whose children are ordered (left, right). A planar drawing of a tree on
`X` is a `PlaneTree α` whose multiset of leaf labels is exactly `X` (`PlaneTree.On X`, so every
taxon labels exactly one leaf). Two drawings depict the same phylogenetic tree if and only if
one is obtained from the other by exchanging the two children at some internal vertices, so the
type of rooted binary phylogenetic trees is the quotient `RootedBinaryTree X` of the drawings by
the equivalence relation generated by such swaps (`PlaneTree.Swap`).

## Main results

* `nat_card_rootedBinaryTree`: there are `(2 n - 3)‼` rooted binary phylogenetic trees on
  `n ≥ 1` labeled taxa.
* `isEmpty_rootedBinaryTree_empty`: there is no tree without taxa.

The unrooted count `(2 n - 5)‼` is stated in
`WantedExt/Biology/Phylogenetics/UnrootedTreeCountWanted.lean`.

## Proof sketch

Edge insertion (Semple & Steel, Proposition 2.1.4): for a taxon `a ∉ X`, grafting `a` onto
one of the `2 |X| - 1` edges of a tree on `X` (the edges above its vertices, including a root
edge) gives a bijection onto the trees on `insert a X`; deleting the leaf `a` inverts it. The
edges of a tree are indexed by its clusters (the leaf sets of its subtrees), which are swap
invariant.

## References

* C. Semple and M. Steel, *Phylogenetics*, Oxford University Press, 2003, Proposition 2.1.4.
* J. Felsenstein, *Inferring Phylogenies*, Sinauer, 2004, chapter 3.
* E. Schröder, *Vier combinatorische Probleme*, Z. Math. Phys. 15 (1870), 361–376.
-/

@[expose] public section

namespace MathlibExt.Biology.Phylogenetics.TreeCount

open scoped Nat

universe u

variable {α : Type u}

/-- A planar rooted binary tree with leaves labeled by `α`: a leaf `leaf a`, or an internal
vertex `node l r` with left subtree `l` and right subtree `r` (the children are ordered). -/
inductive PlaneTree (α : Type u) where
  /-- A leaf labeled `a`. -/
  | leaf : α → PlaneTree α
  /-- An internal vertex with left subtree `l` and right subtree `r`. -/
  | node : PlaneTree α → PlaneTree α → PlaneTree α
  deriving DecidableEq

namespace PlaneTree

/-- The multiset of leaf labels. -/
def leaves : PlaneTree α → Multiset α
  | leaf a => {a}
  | node l r => leaves l + leaves r

/-- Every planar tree has at least one leaf. -/
theorem leaves_ne_zero : ∀ t : PlaneTree α, t.leaves ≠ 0
  | leaf _ => Multiset.singleton_ne_zero _
  | node l r => fun h => by
      have := congrArg Multiset.card h
      simp only [leaves, Multiset.card_add, Multiset.card_zero, Nat.add_eq_zero_iff,
        Multiset.card_eq_zero] at this
      exact leaves_ne_zero l this.1

/-- One swap: exchange the two children of one internal vertex (anywhere in the tree). -/
inductive Swap : PlaneTree α → PlaneTree α → Prop
  /-- Exchange the children of the root. -/
  | root (l r : PlaneTree α) : Swap (node l r) (node r l)
  /-- Swap inside the left subtree. -/
  | left {l l' : PlaneTree α} (r : PlaneTree α) : Swap l l' → Swap (node l r) (node l' r)
  /-- Swap inside the right subtree. -/
  | right (l : PlaneTree α) {r r' : PlaneTree α} : Swap r r' → Swap (node l r) (node l r')

/-- The planar drawings of rooted binary trees on the taxa `X`: planar trees whose leaves are
labeled by `X`, each taxon labeling exactly one leaf. -/
def On (X : Finset α) : Type u :=
  {t : PlaneTree α // t.leaves = X.val}

/-- Two drawings are equivalent when they are related by a sequence of swaps of children. -/
instance swapSetoid (X : Finset α) : Setoid (On X) where
  r s t := Relation.EqvGen Swap s.1 t.1
  iseqv := by
    refine ⟨fun s => .refl _, fun h => .symm _ _ h, fun h h' => .trans _ _ _ h h'⟩

end PlaneTree

/-- The **rooted binary phylogenetic trees** on the taxa `X`: planar drawings with leaf set `X`
modulo exchanging the two children of internal vertices, i.e. rooted binary trees with
unordered children and leaves labeled bijectively by `X`, up to label-preserving isomorphism. -/
def RootedBinaryTree (X : Finset α) : Type u :=
  Quotient (PlaneTree.swapSetoid X)

private theorem leaves_pos {α : Type u} (t : PlaneTree α) : 0 < t.leaves.card := by
  induction t with
  | leaf a => simp [PlaneTree.leaves]
  | node l r hl hr => simp only [PlaneTree.leaves, Multiset.card_add]; omega

private theorem swap_leaves {α : Type u} {s t : PlaneTree α}
    (h : PlaneTree.Swap s t) : s.leaves = t.leaves := by
  induction h with
  | root l r => exact add_comm _ _
  | left r h ih => exact congrArg (· + r.leaves) ih
  | right l h ih => exact congrArg (l.leaves + ·) ih

private theorem equiv_leaves {α : Type u} {s t : PlaneTree α}
    (h : Relation.EqvGen PlaneTree.Swap s t) : s.leaves = t.leaves := by
  induction h with
  | rel s t h => exact swap_leaves h
  | refl => rfl
  | symm s t h ih => exact ih.symm
  | trans s t v h h' ih ih' => exact ih.trans ih'

private theorem equiv_node {α : Type u} {l l' r r' : PlaneTree α}
    (hl : Relation.EqvGen PlaneTree.Swap l l')
    (hr : Relation.EqvGen PlaneTree.Swap r r') :
    Relation.EqvGen PlaneTree.Swap (.node l r) (.node l' r') := by
  have left : Relation.EqvGen PlaneTree.Swap (.node l r) (.node l' r) := by
    induction hl with
    | rel s t h => exact .rel _ _ (.left r h)
    | refl => exact .refl _
    | symm s t h ih => exact .symm _ _ ih
    | trans s t v h h' ih ih' => exact .trans _ _ _ ih ih'
  have right : Relation.EqvGen PlaneTree.Swap (.node l' r) (.node l' r') := by
    clear left
    induction hr with
    | rel s t h => exact .rel _ _ (.right l' h)
    | refl => exact .refl _
    | symm s t h ih => exact .symm _ _ ih
    | trans s t v h h' ih ih' => exact .trans _ _ _ ih ih'
  exact .trans _ _ _ left right

private def vertices {α : Type u} : PlaneTree α → ℕ
  | .leaf _ => 1
  | .node l r => 1 + vertices l + vertices r

private theorem vertices_eq {α : Type u} (t : PlaneTree α) :
    vertices t = 2 * t.leaves.card - 1 := by
  induction t with
  | leaf a => simp [vertices, PlaneTree.leaves]
  | node l r hl hr =>
    have := leaves_pos l
    have := leaves_pos r
    simp only [vertices, PlaneTree.leaves, Multiset.card_add]
    omega

private def clusters {α : Type u} : PlaneTree α → Multiset (Multiset α)
  | .leaf a => {{a}}
  | .node l r => (l.leaves + r.leaves) ::ₘ (clusters l + clusters r)

private theorem leaves_mem_clusters {α : Type u} (t : PlaneTree α) :
    t.leaves ∈ clusters t := by
  cases t <;> simp [clusters, PlaneTree.leaves]

private theorem cluster_le {α : Type u} (t : PlaneTree α) (C : Multiset α)
    (h : C ∈ clusters t) : C ≤ t.leaves := by
  induction t with
  | leaf a =>
    have hc : C = {a} := by simpa [clusters] using h
    subst C
    exact le_rfl
  | node l r hl hr =>
    simp only [clusters, Multiset.mem_cons, Multiset.mem_add] at h
    rcases h with h | h | h
    · exact h.le
    · exact (hl h).trans (Multiset.le_add_right _ _)
    · exact (hr h).trans (Multiset.le_add_left _ _)

private theorem cluster_pos {α : Type u} (t : PlaneTree α) (C : Multiset α)
    (h : C ∈ clusters t) : 0 < C.card := by
  induction t with
  | leaf a =>
    have hc : C = {a} := by simpa [clusters] using h
    simp [hc]
  | node l r hl hr =>
    simp only [clusters, Multiset.mem_cons, Multiset.mem_add] at h
    rcases h with h | h | h
    · subst C
      simpa [PlaneTree.leaves] using leaves_pos (.node l r)
    · exact hl h
    · exact hr h

private theorem clusters_card {α : Type u} (t : PlaneTree α) :
    (clusters t).card = vertices t := by
  induction t with
  | leaf a => simp [clusters, vertices]
  | node l r hl hr => simp [clusters, vertices, hl, hr]; omega

private theorem clusters_nodup {α : Type u} (t : PlaneTree α) (h : t.leaves.Nodup) :
    (clusters t).Nodup := by
  induction t with
  | leaf a => simp [clusters]
  | node l r hl hr =>
    obtain ⟨hleft, hright, hd⟩ := Multiset.nodup_add.mp h
    have hroot : l.leaves + r.leaves ∉ clusters l + clusters r := by
      intro hm
      rcases Multiset.mem_add.mp hm with hm | hm
      · have := Multiset.card_le_card (cluster_le l _ hm)
        have := leaves_pos r
        simp only [Multiset.card_add] at *
        omega
      · have := Multiset.card_le_card (cluster_le r _ hm)
        have := leaves_pos l
        simp only [Multiset.card_add] at *
        omega
    have hc : Disjoint (clusters l) (clusters r) := by
      rw [Multiset.disjoint_left]
      intro C hcl hcr
      obtain ⟨a, ha⟩ := Multiset.card_pos.mp (cluster_pos l C hcl) |> Multiset.exists_mem_of_ne_zero
      exact Multiset.disjoint_left.mp hd
        (Multiset.mem_of_le (cluster_le l C hcl) ha)
        (Multiset.mem_of_le (cluster_le r C hcr) ha)
    exact Multiset.nodup_cons.mpr ⟨hroot, Multiset.nodup_add.mpr ⟨hl hleft, hr hright, hc⟩⟩

private theorem swap_clusters {α : Type u} {s t : PlaneTree α}
    (h : PlaneTree.Swap s t) : clusters s = clusters t := by
  induction h with
  | root l r => simp [clusters, add_comm]
  | left r h ih => simp [clusters, swap_leaves h, ih]
  | right l h ih => simp [clusters, swap_leaves h, ih]

private theorem equiv_clusters {α : Type u} {s t : PlaneTree α}
    (h : Relation.EqvGen PlaneTree.Swap s t) : clusters s = clusters t := by
  induction h with
  | rel s t h => exact swap_clusters h
  | refl => rfl
  | symm s t h ih => exact ih.symm
  | trans s t v h h' ih ih' => exact ih.trans ih'

private theorem leaves_singleton {α : Type u} (t : PlaneTree α) (a : α)
    (h : t.leaves = {a}) : t = .leaf a := by
  cases t with
  | leaf b => simpa [PlaneTree.leaves] using h
  | node l r =>
    have hp := leaves_pos l
    have hq := leaves_pos r
    have hc := congrArg Multiset.card h
    simp only [PlaneTree.leaves, Multiset.card_add, Multiset.card_singleton] at hc
    omega

private noncomputable def graft {α : Type u} (a : α) (C : Multiset α) :
    PlaneTree α → PlaneTree α := fun t => by
  classical
  exact if t.leaves = C then .node t (.leaf a) else
    match t with
    | .leaf b => .leaf b
    | .node l r => .node (graft a C l) (graft a C r)

private theorem graft_root {α : Type u} (a : α) (t : PlaneTree α) :
    graft a t.leaves t = .node t (.leaf a) := by
  classical
  cases t <;> simp [graft]

private theorem graft_absent {α : Type u} (a : α) (C : Multiset α) (t : PlaneTree α)
    (h : C ∉ clusters t) : graft a C t = t := by
  classical
  induction t with
  | leaf b =>
    have hn : (PlaneTree.leaf b).leaves ≠ C := by
      intro he; exact h (he ▸ leaves_mem_clusters (.leaf b))
    simp [graft, hn]
  | node l r hl hr =>
    simp only [clusters, Multiset.mem_cons, Multiset.mem_add, not_or] at h
    simp [graft, PlaneTree.leaves, Ne.symm h.1, hl h.2.1, hr h.2.2]

private theorem clusters_disjoint {α : Type u} (l r : PlaneTree α)
    (h : Disjoint l.leaves r.leaves) : Disjoint (clusters l) (clusters r) := by
  rw [Multiset.disjoint_left]
  intro C hl hr
  obtain ⟨a, ha⟩ := Multiset.exists_mem_of_ne_zero (Multiset.card_pos.mp (cluster_pos l C hl))
  exact Multiset.disjoint_left.mp h
    (Multiset.mem_of_le (cluster_le l C hl) ha)
    (Multiset.mem_of_le (cluster_le r C hr) ha)

private theorem graft_leaves {α : Type u} (a : α) (C : Multiset α) (t : PlaneTree α)
    (hn : t.leaves.Nodup) (hc : C ∈ clusters t) :
    (graft a C t).leaves = t.leaves + {a} := by
  classical
  induction t with
  | leaf b =>
    have he : C = {b} := by simpa [clusters] using hc
    simp [graft, PlaneTree.leaves, he]
  | node l r hl hr =>
    obtain ⟨hnl, hnr, hd⟩ := Multiset.nodup_add.mp hn
    by_cases he : l.leaves + r.leaves = C
    · simp [graft, PlaneTree.leaves, he]
    · simp only [clusters, Multiset.mem_cons, Multiset.mem_add] at hc
      rcases hc with hc | hc | hc
      · exact (he hc.symm).elim
      · have hcr := Multiset.disjoint_left.mp (clusters_disjoint l r hd) hc
        simp [graft, PlaneTree.leaves, he, hl hnl hc, graft_absent a C r hcr, add_comm]
      · have hcl := Multiset.disjoint_right.mp (clusters_disjoint l r hd) hc
        simp [graft, PlaneTree.leaves, he, hr hnr hc, graft_absent a C l hcl,
          add_assoc]

private theorem swap_graft {α : Type u} (a : α) (C : Multiset α)
    {s t : PlaneTree α} (h : PlaneTree.Swap s t) :
    Relation.EqvGen PlaneTree.Swap (graft a C s) (graft a C t) := by
  classical
  induction h with
  | root l r =>
    by_cases he : l.leaves + r.leaves = C
    · simp only [graft, PlaneTree.leaves, he, add_comm r.leaves l.leaves, ite_true]
      exact equiv_node (.rel _ _ (.root l r)) (.refl _)
    · simp only [graft, PlaneTree.leaves, he, add_comm r.leaves l.leaves, ite_false]
      exact .rel _ _ (.root _ _)
  | @left l l' r h ih =>
    by_cases he : l.leaves + r.leaves = C
    · simp only [graft, PlaneTree.leaves, ← swap_leaves h, he, ite_true]
      exact equiv_node (.rel _ _ (.left r h)) (.refl _)
    · simp only [graft, PlaneTree.leaves, ← swap_leaves h, he, ite_false]
      exact equiv_node ih (.refl _)
  | @right l r r' h ih =>
    by_cases he : l.leaves + r.leaves = C
    · simp only [graft, PlaneTree.leaves, ← swap_leaves h, he, ite_true]
      exact equiv_node (.rel _ _ (.right l h)) (.refl _)
    · simp only [graft, PlaneTree.leaves, ← swap_leaves h, he, ite_false]
      exact equiv_node (.refl _) ih

private theorem equiv_graft {α : Type u} (a : α) (C : Multiset α)
    {s t : PlaneTree α} (h : Relation.EqvGen PlaneTree.Swap s t) :
    Relation.EqvGen PlaneTree.Swap (graft a C s) (graft a C t) := by
  induction h with
  | rel s t h => exact swap_graft a C h
  | refl => exact .refl _
  | symm s t h ih => exact .symm _ _ ih
  | trans s t v h h' ih ih' => exact .trans _ _ _ ih ih'

private noncomputable def prune {α : Type u} (a : α) : PlaneTree α → PlaneTree α
  | .leaf b => .leaf b
  | .node l r => by
    classical
    exact if l.leaves = {a} then r else if r.leaves = {a} then l else
      .node (prune a l) (prune a r)

private noncomputable def site {α : Type u} (a : α) : PlaneTree α → Multiset α
  | .leaf _ => 0
  | .node l r => by
    classical
    exact if l.leaves = {a} then r.leaves else if r.leaves = {a} then l.leaves else
      if a ∈ l.leaves then site a l else site a r

private theorem prune_absent {α : Type u} (a : α) (t : PlaneTree α)
    (h : a ∉ t.leaves) : prune a t = t := by
  classical
  induction t with
  | leaf b => rfl
  | node l r hl hr =>
    have hnl : a ∉ l.leaves := fun hm => h (Multiset.mem_add.mpr (.inl hm))
    have hnr : a ∉ r.leaves := fun hm => h (Multiset.mem_add.mpr (.inr hm))
    have hel : l.leaves ≠ {a} := by intro he; simp [he] at hnl
    have her : r.leaves ≠ {a} := by intro he; simp [he] at hnr
    simp [prune, hel, her, hl hnl, hr hnr]

private theorem site_absent {α : Type u} (a : α) (t : PlaneTree α)
    (h : a ∉ t.leaves) : site a t = 0 := by
  classical
  induction t with
  | leaf b => rfl
  | node l r hl hr =>
    have hnl : a ∉ l.leaves := fun hm => h (Multiset.mem_add.mpr (.inl hm))
    have hnr : a ∉ r.leaves := fun hm => h (Multiset.mem_add.mpr (.inr hm))
    have hel : l.leaves ≠ {a} := by intro he; simp [he] at hnl
    have her : r.leaves ≠ {a} := by intro he; simp [he] at hnr
    simp [site, hel, her, hnl, hr hnr]

private theorem swap_prune {α : Type u} (a : α) {s t : PlaneTree α}
    (h : PlaneTree.Swap s t) (hn : s.leaves.Nodup) :
    Relation.EqvGen PlaneTree.Swap (prune a s) (prune a t) := by
  classical
  induction h with
  | root l r =>
    obtain ⟨_, _, hd⟩ := Multiset.nodup_add.mp hn
    by_cases hl : l.leaves = {a}
    · have hr : r.leaves ≠ {a} := by
        intro hr
        simp [hl, hr] at hd
      simp only [prune, hl, hr, ite_true, ite_false]
      exact .refl _
    · by_cases hr : r.leaves = {a}
      · simp only [prune, hl, hr, ite_true, ite_false]
        exact .refl _
      · simp only [prune, hl, hr, ite_false]
        exact .rel _ _ (.root _ _)
  | @left l l' r h ih =>
    have hnl := (Multiset.nodup_add.mp hn).1
    by_cases hl : l.leaves = {a}
    · simp only [prune, ← swap_leaves h, hl, ite_true]
      exact .refl _
    · by_cases hr : r.leaves = {a}
      · simp only [prune, ← swap_leaves h, hl, hr, ite_true, ite_false]
        exact .rel _ _ h
      · simp only [prune, ← swap_leaves h, hl, hr, ite_false]
        exact equiv_node (ih hnl) (.refl _)
  | @right l r r' h ih =>
    have hnr := (Multiset.nodup_add.mp hn).2.1
    by_cases hl : l.leaves = {a}
    · simp only [prune, ← swap_leaves h, hl, ite_true]
      exact .rel _ _ h
    · by_cases hr : r.leaves = {a}
      · simp only [prune, ← swap_leaves h, hl, hr, ite_true, ite_false]
        exact .refl _
      · simp only [prune, ← swap_leaves h, hl, hr, ite_false]
        exact equiv_node (.refl _) (ih hnr)

private theorem swap_site {α : Type u} (a : α) {s t : PlaneTree α}
    (h : PlaneTree.Swap s t) (hn : s.leaves.Nodup) : site a s = site a t := by
  classical
  induction h with
  | root l r =>
    obtain ⟨_, _, hd⟩ := Multiset.nodup_add.mp hn
    by_cases hl : l.leaves = {a}
    · have hr : r.leaves ≠ {a} := by intro hr; simp [hl, hr] at hd
      simp [site, hl, hr]
    · by_cases hr : r.leaves = {a}
      · simp [site, hl, hr]
      · by_cases hml : a ∈ l.leaves
        · have hmr := Multiset.disjoint_left.mp hd hml
          simp [site, hl, hr, hml, hmr]
        · by_cases hmr : a ∈ r.leaves
          · simp [site, hl, hr, hml, hmr]
          · simp [site, hl, hr, hml, hmr, site_absent a l hml, site_absent a r hmr]
  | @left l l' r h ih =>
    have hnl := (Multiset.nodup_add.mp hn).1
    simp only [site, ← swap_leaves h]
    split_ifs <;> first | rfl | exact ih hnl
  | @right l r r' h ih =>
    have hnr := (Multiset.nodup_add.mp hn).2.1
    simp only [site, ← swap_leaves h]
    split_ifs <;> first | rfl | exact ih hnr

private theorem equiv_prune {α : Type u} (a : α) {s t : PlaneTree α}
    (h : Relation.EqvGen PlaneTree.Swap s t) (hn : s.leaves.Nodup) :
    Relation.EqvGen PlaneTree.Swap (prune a s) (prune a t) := by
  induction h with
  | rel s t h => exact swap_prune a h hn
  | refl => exact .refl _
  | symm s t h ih => exact .symm _ _ (ih ((equiv_leaves h).symm ▸ hn))
  | trans s t v h h' ih ih' =>
    exact .trans _ _ _ (ih hn) (ih' (equiv_leaves h ▸ hn))

private theorem equiv_site {α : Type u} (a : α) {s t : PlaneTree α}
    (h : Relation.EqvGen PlaneTree.Swap s t) (hn : s.leaves.Nodup) :
    site a s = site a t := by
  induction h with
  | rel s t h => exact swap_site a h hn
  | refl => rfl
  | symm s t h ih => exact (ih ((equiv_leaves h).symm ▸ hn)).symm
  | trans s t v h h' ih ih' => exact (ih hn).trans (ih' (equiv_leaves h ▸ hn))

private theorem graft_node_left {α : Type u} (a : α) (C : Multiset α)
    (l r : PlaneTree α) (hc : C ∈ clusters l) (hd : Disjoint l.leaves r.leaves) :
    graft a C (.node l r) = .node (graft a C l) r := by
  classical
  have he : l.leaves + r.leaves ≠ C := by
    intro he
    have := Multiset.card_le_card (cluster_le l C hc)
    have := leaves_pos r
    simp only [← he, Multiset.card_add] at *
    omega
  have hr := Multiset.disjoint_left.mp (clusters_disjoint l r hd) hc
  simp [graft, PlaneTree.leaves, he, graft_absent a C r hr]

private theorem graft_node_right {α : Type u} (a : α) (C : Multiset α)
    (l r : PlaneTree α) (hc : C ∈ clusters r) (hd : Disjoint l.leaves r.leaves) :
    graft a C (.node l r) = .node l (graft a C r) := by
  classical
  have he : l.leaves + r.leaves ≠ C := by
    intro he
    have := Multiset.card_le_card (cluster_le r C hc)
    have := leaves_pos l
    simp only [← he, Multiset.card_add] at *
    omega
  have hl := Multiset.disjoint_right.mp (clusters_disjoint l r hd) hc
  simp [graft, PlaneTree.leaves, he, graft_absent a C l hl]

private theorem prune_info {α : Type u} (a : α) (t : PlaneTree α)
    (hn : t.leaves.Nodup) (ha : a ∈ t.leaves) (he : t.leaves ≠ {a}) :
    (prune a t).leaves + {a} = t.leaves ∧
      site a t ∈ clusters (prune a t) ∧
      Relation.EqvGen PlaneTree.Swap (graft a (site a t) (prune a t)) t := by
  classical
  induction t with
  | leaf b =>
    have hab : a = b := by simpa [PlaneTree.leaves] using ha
    subst b
    exact (he rfl).elim
  | node l r ihl ihr =>
    obtain ⟨hnl, hnr, hd⟩ := Multiset.nodup_add.mp hn
    by_cases hl : l.leaves = {a}
    · have ht := leaves_singleton l a hl
      subst l
      simp only [prune, site, PlaneTree.leaves, ite_true]
      refine ⟨add_comm _ _, leaves_mem_clusters r, ?_⟩
      rw [graft_root]
      exact .rel _ _ (.root r (.leaf a))
    · by_cases hr : r.leaves = {a}
      · have ht := leaves_singleton r a hr
        subst r
        simp only [prune, site, PlaneTree.leaves, hl, ite_false, ite_true]
        refine ⟨by trivial, leaves_mem_clusters l, ?_⟩
        rw [graft_root]
        exact .refl _
      · by_cases hml : a ∈ l.leaves
        · have hmr := Multiset.disjoint_left.mp hd hml
          obtain ⟨hle, hsc, hrec⟩ := ihl hnl hml hl
          have hsub : (prune a l).leaves ≤ l.leaves := by
            rw [← hle]; exact Multiset.le_add_right _ _
          have hdp : Disjoint (prune a l).leaves r.leaves := by
            rw [Multiset.disjoint_left]
            exact fun hm => Multiset.disjoint_left.mp hd (Multiset.mem_of_le hsub hm)
          simp only [prune, site, hl, hr, hml, ite_false, ite_true, prune_absent a r hmr]
          refine ⟨?_, ?_, ?_⟩
          · simp only [PlaneTree.leaves]
            rw [add_right_comm, hle]
          · exact Multiset.mem_cons.mpr (.inr (Multiset.mem_add.mpr (.inl hsc)))
          · rw [graft_node_left a _ _ _ hsc hdp]
            exact equiv_node hrec (.refl _)
        · have hmr : a ∈ r.leaves := (Multiset.mem_add.mp ha).resolve_left hml
          obtain ⟨hre, hsc, hrec⟩ := ihr hnr hmr hr
          have hsub : (prune a r).leaves ≤ r.leaves := by
            rw [← hre]; exact Multiset.le_add_right _ _
          have hdp : Disjoint l.leaves (prune a r).leaves := by
            rw [Multiset.disjoint_right]
            exact fun hm => Multiset.disjoint_right.mp hd (Multiset.mem_of_le hsub hm)
          simp only [prune, site, hl, hr, hml, ite_false, prune_absent a l hml]
          refine ⟨?_, ?_, ?_⟩
          · simp only [PlaneTree.leaves]
            rw [add_assoc, hre]
          · exact Multiset.mem_cons.mpr (.inr (Multiset.mem_add.mpr (.inr hsc)))
          · rw [graft_node_right a _ _ _ hsc hdp]
            exact equiv_node (.refl _) hrec

private theorem graft_info {α : Type u} (a : α) (C : Multiset α) (t : PlaneTree α)
    (hn : t.leaves.Nodup) (ha : a ∉ t.leaves) (hc : C ∈ clusters t) :
    prune a (graft a C t) = t ∧ site a (graft a C t) = C := by
  classical
  have hne : t.leaves ≠ {a} := by intro he; simp [he] at ha
  induction t with
  | leaf b =>
    have he : C = {b} := by simpa [clusters] using hc
    have hba : b ≠ a := by simpa [PlaneTree.leaves, eq_comm] using ha
    simp [graft, PlaneTree.leaves, he, prune, site, hba]
  | node l r ihl ihr =>
    obtain ⟨hnl, hnr, hd⟩ := Multiset.nodup_add.mp hn
    have hal : a ∉ l.leaves := fun hm => ha (Multiset.mem_add.mpr (.inl hm))
    have har : a ∉ r.leaves := fun hm => ha (Multiset.mem_add.mpr (.inr hm))
    have hel : l.leaves ≠ {a} := by intro he; simp [he] at hal
    have her : r.leaves ≠ {a} := by intro he; simp [he] at har
    by_cases he : l.leaves + r.leaves = C
    · have hC : C ≠ {a} := by simpa [PlaneTree.leaves, he] using hne
      simp [graft, PlaneTree.leaves, he, prune, site, hC]
    · simp only [clusters, Multiset.mem_cons, Multiset.mem_add] at hc
      rcases hc with hc | hc | hc
      · exact (he hc.symm).elim
      · have hgl := graft_leaves a C l hnl hc
        have hegl : (graft a C l).leaves ≠ {a} := by
          intro hs
          have hp := leaves_pos l
          have hcard := congrArg Multiset.card hgl
          simp only [hs, Multiset.card_add, Multiset.card_singleton] at hcard
          omega
        have hagl : a ∈ (graft a C l).leaves := by simp [hgl]
        obtain ⟨hp, hs⟩ := ihl hnl hal hc hel
        rw [graft_node_left a C l r hc hd]
        simp [prune, site, hegl, her, hagl, hp, hs, prune_absent a r har]
      · have hgr := graft_leaves a C r hnr hc
        have hegr : (graft a C r).leaves ≠ {a} := by
          intro hs
          have hp := leaves_pos r
          have hcard := congrArg Multiset.card hgr
          simp only [hs, Multiset.card_add, Multiset.card_singleton] at hcard
          omega
        obtain ⟨hp, hs⟩ := ihr hnr har hc her
        rw [graft_node_right a C l r hc hd]
        simp [prune, site, hel, hegr, hal, hp, hs, prune_absent a l hal]

private noncomputable def quotientClusters {α : Type u} (X : Finset α) :
    RootedBinaryTree X → Multiset (Multiset α) :=
  Quotient.lift (fun t => clusters t.1) (fun _ _ h => equiv_clusters h)

private theorem quotientClusters_nodup {α : Type u} (X : Finset α)
    (t : RootedBinaryTree X) : (quotientClusters X t).Nodup := by
  induction t using Quotient.ind with
  | _ t => exact clusters_nodup t.1 (t.2.symm ▸ X.nodup)

private theorem quotientClusters_card {α : Type u} (X : Finset α)
    (t : RootedBinaryTree X) : (quotientClusters X t).card = 2 * X.card - 1 := by
  induction t using Quotient.ind with
  | _ t => simp [quotientClusters, clusters_card, vertices_eq, t.2]

private def Marked {α : Type u} (X : Finset α) : Type u :=
  Σ t : RootedBinaryTree X, {C : Multiset α // C ∈ quotientClusters X t}

private theorem marked_fiber_finite {α : Type u} (X : Finset α)
    (t : RootedBinaryTree X) : Finite {C : Multiset α // C ∈ quotientClusters X t} :=
  (quotientClusters X t).finite_toSet.to_subtype

private theorem marked_fiber_card {α : Type u} (X : Finset α)
    (t : RootedBinaryTree X) :
    Nat.card {C : Multiset α // C ∈ quotientClusters X t} = 2 * X.card - 1 := by
  classical
  let C := (quotientClusters X t).toFinset
  have he : {c : Multiset α // c ∈ quotientClusters X t} ≃ C :=
    Equiv.subtypeEquivRight (fun _ => Multiset.mem_toFinset.symm)
  rw [Nat.card_congr he, Nat.card_eq_fintype_card, Fintype.card_coe]
  exact (Multiset.toFinset_card_of_nodup (quotientClusters_nodup X t)).trans
    (quotientClusters_card X t)

private theorem marked_ext {α : Type u} {X : Finset α} (s t : Marked X)
    (h : s.1 = t.1) (hc : s.2.1 = t.2.1) : s = t := by
  rcases s with ⟨s, C, hs⟩
  rcases t with ⟨t, D, ht⟩
  dsimp at h hc
  subst t
  subst D
  rfl

private theorem clusters_out {α : Type u} (X : Finset α) (t : RootedBinaryTree X) :
    clusters t.out.1 = quotientClusters X t := by
  exact congrArg (quotientClusters X) (Quotient.out_eq t)

private noncomputable def insertDrawing {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (t : PlaneTree.On X) (C : Multiset α)
    (hc : C ∈ clusters t.1) : PlaneTree.On (insert a X) :=
  ⟨graft a C t.1, by
    rw [graft_leaves a C t.1 (t.2.symm ▸ X.nodup) hc, t.2,
      Finset.insert_val_of_notMem ha]
    exact (add_comm X.val {a}).trans (Multiset.singleton_add a X.val)⟩

private theorem insertDrawing_equiv {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (s t : PlaneTree.On X) (C : Multiset α)
    (hs : C ∈ clusters s.1) (ht : C ∈ clusters t.1)
    (h : Relation.EqvGen PlaneTree.Swap s.1 t.1) :
    (⟦insertDrawing X a ha s C hs⟧ : RootedBinaryTree (insert a X)) =
      ⟦insertDrawing X a ha t C ht⟧ :=
  Quotient.sound (equiv_graft a C h)

private noncomputable def attach {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (m : Marked X) :
    RootedBinaryTree (insert a X) :=
  ⟦insertDrawing X a ha m.1.out m.2.1 ((clusters_out X m.1).symm ▸ m.2.2)⟧

private theorem attach_drawing {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (t : PlaneTree.On X) (C : Multiset α)
    (hc : C ∈ clusters t.1) :
    attach X a ha ⟨⟦t⟧, ⟨C, hc⟩⟩ = ⟦insertDrawing X a ha t C hc⟧ :=
  insertDrawing_equiv X a ha _ _ C _ _ (Quotient.mk_out t)

private theorem insert_nonsingleton {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (t : PlaneTree.On (insert a X)) : t.1.leaves ≠ {a} := by
  intro he
  have hc := congrArg Multiset.card he
  have hp := Finset.card_pos.mpr hX
  rw [t.2] at hc
  simp only [← Finset.card_def, Finset.card_insert_of_notMem ha,
    Multiset.card_singleton] at hc
  omega

private theorem insert_prune_info {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (t : PlaneTree.On (insert a X)) :
    (prune a t.1).leaves + {a} = t.1.leaves ∧
      site a t.1 ∈ clusters (prune a t.1) ∧
      Relation.EqvGen PlaneTree.Swap (graft a (site a t.1) (prune a t.1)) t.1 :=
  prune_info a t.1 (t.2.symm ▸ (insert a X).nodup)
    (by simp [t.2]) (insert_nonsingleton X a ha hX t)

private noncomputable def pruneDrawing {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (t : PlaneTree.On (insert a X)) : PlaneTree.On X :=
  ⟨prune a t.1, by
    exact add_right_cancel ((insert_prune_info X a ha hX t).1.trans
      (t.2.trans ((Finset.insert_val_of_notMem ha).trans
        ((Multiset.singleton_add a X.val).symm.trans (add_comm _ _)))))⟩

private noncomputable def detachDrawing {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (t : PlaneTree.On (insert a X)) : Marked X :=
  ⟨⟦pruneDrawing X a ha hX t⟧, ⟨site a t.1, (insert_prune_info X a ha hX t).2.1⟩⟩

private theorem detachDrawing_equiv {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (s t : PlaneTree.On (insert a X)) (h : Relation.EqvGen PlaneTree.Swap s.1 t.1) :
    detachDrawing X a ha hX s = detachDrawing X a ha hX t := by
  apply marked_ext
  · exact Quotient.sound (equiv_prune a h (s.2.symm ▸ (insert a X).nodup))
  · exact equiv_site a h (s.2.symm ▸ (insert a X).nodup)

private noncomputable def detach {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty) :
    RootedBinaryTree (insert a X) → Marked X :=
  Quotient.lift (detachDrawing X a ha hX) (detachDrawing_equiv X a ha hX)

private theorem attach_detach {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (t : RootedBinaryTree (insert a X)) : attach X a ha (detach X a ha hX t) = t := by
  induction t using Quotient.ind with
  | _ t =>
    change attach X a ha (detachDrawing X a ha hX t) = ⟦t⟧
    exact (attach_drawing X a ha (pruneDrawing X a ha hX t) (site a t.1)
      (insert_prune_info X a ha hX t).2.1).trans
        (Quotient.sound (insert_prune_info X a ha hX t).2.2)

private theorem detach_attach {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty)
    (m : Marked X) : detach X a ha hX (attach X a ha m) = m := by
  rcases m with ⟨t, C, hc⟩
  have ht : a ∉ t.out.1.leaves := by simpa [t.out.2] using ha
  have hC : C ∈ clusters t.out.1 := (clusters_out X t).symm ▸ hc
  obtain ⟨hp, hs⟩ := graft_info a C t.out.1 (t.out.2.symm ▸ X.nodup) ht hC
  apply marked_ext
  · change (⟦pruneDrawing X a ha hX (insertDrawing X a ha t.out C hC)⟧ :
      RootedBinaryTree X) = t
    have he : pruneDrawing X a ha hX (insertDrawing X a ha t.out C hC) = t.out :=
      Subtype.ext hp
    exact (congrArg (Quotient.mk _) he).trans (Quotient.out_eq t)
  · exact hs

private noncomputable def insertionEquiv {α : Type u} [DecidableEq α]
    (X : Finset α) (a : α) (ha : a ∉ X) (hX : X.Nonempty) :
    RootedBinaryTree (insert a X) ≃ Marked X where
  toFun := detach X a ha hX
  invFun := attach X a ha
  left_inv := attach_detach X a ha hX
  right_inv := detach_attach X a ha hX

private theorem marked_finite {α : Type u} (X : Finset α)
    [Finite (RootedBinaryTree X)] : Finite (Marked X) := by
  let : ∀ t : RootedBinaryTree X,
      Finite {C : Multiset α // C ∈ quotientClusters X t} := marked_fiber_finite X
  unfold Marked
  infer_instance

private theorem marked_card {α : Type u} (X : Finset α) [Finite (RootedBinaryTree X)] :
    Nat.card (Marked X) = Nat.card (RootedBinaryTree X) * (2 * X.card - 1) := by
  classical
  let := Fintype.ofFinite (RootedBinaryTree X)
  let : ∀ t : RootedBinaryTree X,
      Finite {C : Multiset α // C ∈ quotientClusters X t} := marked_fiber_finite X
  unfold Marked
  rw [Nat.card_sigma]
  simp only [marked_fiber_card, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  rw [Nat.card_eq_fintype_card]
  simp

@[instance_reducible] private noncomputable def singletonUnique {α : Type u} (a : α) :
    Unique (RootedBinaryTree ({a} : Finset α)) where
  default := ⟦⟨.leaf a, rfl⟩⟧
  uniq t := by
    induction t using Quotient.ind with
    | _ t =>
      have he : t = (⟨.leaf a, rfl⟩ : PlaneTree.On ({a} : Finset α)) :=
        Subtype.ext (leaves_singleton t.1 a t.2)
      exact congrArg (Quotient.mk _) he

private theorem factorial_step (k : ℕ) (hk : 0 < k) :
    (2 * (k + 1) - 3)‼ = (2 * k - 1) * (2 * k - 3)‼ := by
  have he : 2 * (k + 1) - 3 = (2 * k - 2) + 1 := by omega
  rw [he, Nat.doubleFactorial_add_one]
  congr 1; omega

private theorem count_finite {α : Type u} (X : Finset α) (hX : X.Nonempty) :
    Finite (RootedBinaryTree X) ∧
      Nat.card (RootedBinaryTree X) = (2 * X.card - 3)‼ := by
  classical
  induction X using Finset.induction_on with
  | empty => simp at hX
  | @insert a X ha ih =>
    by_cases hne : X.Nonempty
    · obtain ⟨hfin, hc⟩ := ih hne
      let := hfin
      let := marked_finite X
      have hf := Finite.of_equiv (Marked X) (insertionEquiv X a ha hne).symm
      refine ⟨hf, ?_⟩
      calc
        Nat.card (RootedBinaryTree (insert a X)) = Nat.card (Marked X) :=
          Nat.card_congr (insertionEquiv X a ha hne)
        _ = Nat.card (RootedBinaryTree X) * (2 * X.card - 1) := marked_card X
        _ = (2 * X.card - 1) * (2 * X.card - 3)‼ := by rw [hc, Nat.mul_comm]
        _ = (2 * (insert a X).card - 3)‼ := by
          rw [Finset.card_insert_of_notMem ha, factorial_step X.card (Finset.card_pos.mpr hne)]
    · have he : X = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
      subst X
      simp only [Finset.insert_empty]
      let := singletonUnique a
      exact ⟨inferInstance, by simp⟩

/-- There is no rooted binary tree without taxa. -/
instance isEmpty_rootedBinaryTree_empty : IsEmpty (RootedBinaryTree (∅ : Finset α)) :=
  ⟨fun T => Quotient.inductionOn T fun t => PlaneTree.leaves_ne_zero t.1 t.2⟩

/-- **Schröder's count of rooted binary phylogenetic trees.** On `n ≥ 1` labeled taxa there are
`(2 n - 3)‼ = 1 · 3 · 5 ⋯ (2 n - 3)` rooted binary phylogenetic trees (`1` tree for `n = 1`
and `n = 2`, `3` for `n = 3`, `15` for `n = 4`). For `n = 1` the natural-number subtraction
gives `2 - 3 = 0` and `0‼ = 1`, the conventional value `(-1)‼ = 1` of the formula; the empty
set of taxa (excluded here) has no tree (`isEmpty_rootedBinaryTree_empty`).

Source: Semple & Steel (2003), Proposition 2.1.4. -/
theorem nat_card_rootedBinaryTree (X : Finset α) (hX : X.Nonempty) :
    Nat.card (RootedBinaryTree X) = (2 * X.card - 3)‼ := by
  exact (count_finite X hX).2

end MathlibExt.Biology.Phylogenetics.TreeCount
