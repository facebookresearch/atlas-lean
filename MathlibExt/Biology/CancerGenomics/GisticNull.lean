/-!
# The GISTIC per-marker permutation null is a convolution

GISTIC 2.0 (Mermel et al. 2011) scores marker `m` by summing a per-sample amplitude over the
`S` samples, and obtains p-values "by comparing the score at each locus to a background score
distribution generated by random permutation of the marker locations in each sample". With
`x j : Fin M → ℝ` the values of sample `j` on its `M` markers and independent uniformly random
permutations `σ j`, the null score at marker `m` is `∑ j, x j (σ j m)`.

We prove that this null law is exactly the convolution, over samples, of the per-sample
empirical laws (the uniform law of `x j` over markers). Laws are finitely supported, so we
state them by their probability mass functions, as real-valued functions of the score:

* `permutationNull_eq_count`: the null probability of the score `g` is the fraction of the
  `M ^ S` marker choices `u` (one marker per sample) with `∑ j, x j (u j) = g`; in particular
  it does not depend on the marker `m`;
* `permutationNull_succ`: adding a sample convolves the null with that sample's empirical law,
  `P_{S+1}(g) = ∑_v (1 / M) P_S(g - x_S(v))`, and `permutationNull_zero` is the point mass at
  `0`, so the null is the `S`-fold convolution of the empirical laws.

GeneGISTIC scores a gene covering `n + 1` markers by the per-sample minimum over its markers
and permutes the per-sample minima of all running windows of that size; its size-specific null
is the same convolution of the empirical laws of the window minima (`geneNull_eq_count`).

This is a statement about the exact law of the permutation null, not about the validity of
the resulting p-values.

## Main results

* `permutationNull`: the probability mass function of `∑ j, x j (σ j m)` under independent
  uniform permutations.
* `permutationNull_eq_count`, `permutationNull_zero`, `permutationNull_succ`: the convolution
  form.
* `geneNull_eq_count`: the GeneGISTIC window-minimum null.

## References

* C. H. Mermel et al., *GISTIC2.0 facilitates sensitive and confident localization of the
  targets of focal somatic copy-number alteration in human cancers*, Genome Biol. 12 (2011),
  R41.
* R. Beroukhim et al., *Assessing the significance of chromosomal aberrations in cancer:
  methodology and application to glioma*, Proc. Natl. Acad. Sci. USA 104 (2007),
  20007–20012 (GISTIC 1.0, the per-sample marker permutation).
-/

@[expose] public section

namespace MathlibExt.Biology.CancerGenomics.GisticNull

/-- The permuted score at marker `m`: `∑ j, x j (σ j m)`. -/
def permutedScore {S M : ℕ} (x : Fin S → Fin M → ℝ) (m : Fin M)
    (σ : Fin S → Equiv.Perm (Fin M)) : ℝ :=
  ∑ j, x j (σ j m)

/-- The GISTIC permutation null at marker `m`: the probability that `∑ j, x j (σ j m) = g`
when the permutations `σ j` of the markers are independent and uniform. -/
noncomputable def permutationNull {S M : ℕ} (x : Fin S → Fin M → ℝ) (m : Fin M) (g : ℝ) : ℝ :=
  ((Finset.univ.filter fun σ : Fin S → Equiv.Perm (Fin M) => permutedScore x m σ = g).card :
    ℝ) / Fintype.card (Fin S → Equiv.Perm (Fin M))

/-- The number of marker choices `u : Fin S → Fin M` (one marker per sample) with
`∑ j, x j (u j) = g`. -/
noncomputable def scoreCount {S M : ℕ} (x : Fin S → Fin M → ℝ) (g : ℝ) : ℕ :=
  (Finset.univ.filter fun u : Fin S → Fin M => ∑ j, x j (u j) = g).card

private theorem eval_fiber_card_eq {M : ℕ} (m v w : Fin M) :
    (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = v).card =
      (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = w).card := by
  classical
  refine Finset.card_bij (fun π _ => Equiv.swap v w * π) ?_ ?_ ?_
  · intro π hπ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hπ ⊢
    simp [Equiv.Perm.mul_apply, hπ]
  · intro π hπ τ hτ h
    exact mul_left_cancel h
  · intro τ hτ
    have hτ' : τ m = w := (Finset.mem_filter.mp hτ).2
    refine ⟨Equiv.swap v w * τ, ?_, ?_⟩
    · simp [Equiv.Perm.mul_apply, hτ']
    · ext a
      simp

private theorem choice_fiber_card {S M : ℕ} (m : Fin M) (u : Fin S → Fin M) :
    (Finset.univ.filter fun σ : Fin S → Equiv.Perm (Fin M) =>
      (fun j => σ j m) = u).card =
        (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = m).card ^ S := by
  classical
  have hset : (Finset.univ.filter fun σ : Fin S → Equiv.Perm (Fin M) =>
      (fun j => σ j m) = u) =
        Fintype.piFinset (fun j => Finset.univ.filter fun π => π m = u j) := by
    ext σ
    simp [funext_iff]
  rw [hset, Fintype.card_piFinset]
  simp_rw [eval_fiber_card_eq m _ m]
  simp

private theorem successful_card {S M : ℕ} (x : Fin S → Fin M → ℝ) (m : Fin M) (g : ℝ) :
    (Finset.univ.filter fun σ : Fin S → Equiv.Perm (Fin M) =>
      permutedScore x m σ = g).card =
        (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = m).card ^ S *
          scoreCount x g := by
  classical
  let t := Finset.univ.filter fun u : Fin S → Fin M => ∑ j, x j (u j) = g
  rw [Finset.card_eq_sum_card_fiberwise (f := fun σ j => σ j m) (t := t)
    (by intro σ hσ; simpa [t, permutedScore] using (Finset.mem_filter.mp hσ).2)]
  have hf (u : Fin S → Fin M) (hu : u ∈ t) :
      ((Finset.univ.filter fun σ => permutedScore x m σ = g).filter fun σ =>
        (fun j => σ j m) = u) =
          (Finset.univ.filter fun σ : Fin S → Equiv.Perm (Fin M) =>
            (fun j => σ j m) = u) := by
    ext σ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    refine and_iff_right_of_imp ?_
    intro h
    have hscore : (∑ j, x j (u j)) = g := (Finset.mem_filter.mp hu).2
    simpa [permutedScore, ← h] using hscore
  calc
    _ = ∑ u ∈ t, (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = m).card ^ S := by
      apply Finset.sum_congr rfl
      intro u hu
      rw [hf u hu, choice_fiber_card]
    _ = _ := by simp [t, scoreCount, Nat.mul_comm]

private theorem perm_card_eq {M : ℕ} (m : Fin M) :
    Fintype.card (Equiv.Perm (Fin M)) =
      M * (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = m).card := by
  classical
  have h := Finset.card_eq_sum_card_fiberwise
    (s := (Finset.univ : Finset (Equiv.Perm (Fin M))))
    (t := (Finset.univ : Finset (Fin M))) (f := fun π => π m)
    (by intro π _; simp)
  simp_rw [eval_fiber_card_eq m _ m] at h
  simpa using h

/-- **The GISTIC permutation null is the law of a sum of independent per-sample draws**
(Mermel et al. 2011): the probability of the score `g` is the fraction of the `M ^ S` marker
choices with that score, whatever the marker `m`. -/
theorem permutationNull_eq_count {S M : ℕ} (x : Fin S → Fin M → ℝ) (m : Fin M) (g : ℝ) :
    permutationNull x m g = scoreCount x g / (M : ℝ) ^ S := by
  classical
  have hc : (Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = m).card ≠ 0 := by
    apply Nat.ne_of_gt
    exact Finset.card_pos.mpr ⟨1, by simp⟩
  rw [permutationNull, successful_card, Fintype.card_fun, perm_card_eq m]
  push_cast
  rw [mul_pow]
  have hcR : ((Finset.univ.filter fun π : Equiv.Perm (Fin M) => π m = m).card : ℝ) ≠
      0 := Nat.cast_ne_zero.mpr hc
  simpa [mul_comm] using
    (mul_div_mul_right (scoreCount x g : ℝ) ((M : ℝ) ^ S) (pow_ne_zero S hcR))

/-- With no samples the null is the point mass at `0`. -/
theorem permutationNull_zero {M : ℕ} (x : Fin 0 → Fin M → ℝ) (m : Fin M) (g : ℝ) :
    permutationNull x m g = if g = 0 then 1 else 0 := by
  classical
  rw [permutationNull_eq_count]
  by_cases h : g = 0
  · simp [scoreCount, h]
  · simp [scoreCount, eq_comm, h]

private theorem scoreCount_succ {S M : ℕ} (x : Fin (S + 1) → Fin M → ℝ) (g : ℝ) :
    scoreCount x g =
      ∑ v : Fin M, scoreCount (fun j => x j.castSucc) (g - x (Fin.last S) v) := by
  classical
  unfold scoreCount
  simp_rw [Finset.card_filter]
  rw [← (Fin.snocEquiv (fun _ : Fin (S + 1) => Fin M)).sum_comp]
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro v _
  apply Finset.sum_congr rfl
  intro u _
  simp [Fin.snocEquiv, Fin.sum_univ_castSucc, ← eq_sub_iff_add_eq]

/-- **Convolution step**: adding sample `S` convolves the null of the first `S` samples with
the empirical law of the new sample, `P_{S+1}(g) = ∑_v (1 / M) P_S(g - x_S(v))`. -/
theorem permutationNull_succ {S M : ℕ} (x : Fin (S + 1) → Fin M → ℝ) (m : Fin M) (g : ℝ) :
    permutationNull x m g =
      ∑ v : Fin M, (1 / (M : ℝ)) *
        permutationNull (fun j => x j.castSucc) m (g - x (Fin.last S) v) := by
  classical
  simp_rw [permutationNull_eq_count]
  rw [scoreCount_succ, Nat.cast_sum, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro v _
  simp [pow_succ, div_eq_mul_inv, mul_comm, mul_assoc]

/-- The minimum of `y` over the window of `n + 1` consecutive markers starting at `i`
(GeneGISTIC's per-sample gene-level value for a gene covering those markers). -/
noncomputable def windowMin {W n : ℕ} (y : Fin (W + n) → ℝ) (i : Fin W) : ℝ :=
  Finset.univ.inf' Finset.univ_nonempty fun k : Fin (n + 1) =>
    y ⟨i + k, by omega⟩

/-- **GeneGISTIC null** (Mermel et al. 2011): permuting the per-sample minima of all running
windows of `n + 1` markers gives, at every window `i`, the law of a sum of independent draws
of one window minimum per sample. -/
theorem geneNull_eq_count {S W n : ℕ} (x : Fin S → Fin (W + n) → ℝ) (i : Fin W) (g : ℝ) :
    permutationNull (fun j => windowMin (x j)) i g =
      scoreCount (fun j => windowMin (x j)) g / (W : ℝ) ^ S :=
  permutationNull_eq_count _ i g

end MathlibExt.Biology.CancerGenomics.GisticNull
