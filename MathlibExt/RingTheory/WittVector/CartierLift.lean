/-!
# Lifts of structure constants

The lift ring of two elements `u v` of a ring `B` over a coefficient ring
`R` is the polynomial ring in variables indexed by `B`, modulo the relation
`X u * X v = p`. Structure constants valued in `B` lift to this ring. Given a
factorization `u * v = p` in `B` and a ring map `j : R →+* B`, the evaluation
that is `j` on coefficients and sends every variable `X b` to `b` descends to
the lift ring (`liftHom`). The relation constrains only the product of the two
images; `liftHom` chooses the images `u` and `v` as part of the assignment
`X b ↦ b`. A homomorphism out of the lift ring is determined by its values on
the coefficients and on every variable (`ringHom_ext`, `eq_liftHom`).

## References

* J.-F. Boutot and H. Carayol, *Uniformisation p-adique des courbes de Shimura :
  les théorèmes de Čerednik et de Drinfeld*, Astérisque 196–197 (1991), 45–158.
  Chapter II, part (c) of the proof of Proposition 3.8, p. 82: the polynomial
  ring with a variable `X_b` for every `b ∈ B`, modulo `X_u X_v - π` for the
  structure constants `u` and `v` of order zero (here `π = p`), and the
  evaluation `X_b ↦ b`.
-/

@[expose] public section

universe u v

namespace MvPolynomial

variable {σ : Type*} {R : Type*} [CommRing R]

private theorem mem_span_of_C_mul_mem_span_X_mul_X_sub_C {π : R}
    (hπ : ∀ r : R, π * r = 0 → r = 0) (u v : σ) {g : MvPolynomial σ R}
    (h : C π * g ∈ Ideal.span {(X u * X v - C π : MvPolynomial σ R)}) :
    g ∈ Ideal.span {(X u * X v - C π : MvPolynomial σ R)} := by
  classical
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp h
  have hXq : q * X u * X v = C π * (g + q) := by
    have h1 : q * (X u * X v - C π) = C π * g := hq
    linear_combination h1
  have hdvd : ∀ e, π ∣ q.coeff e := by
    intro e
    have hc := congrArg
      (fun r : MvPolynomial σ R => r.coeff (e + Finsupp.single u 1 + Finsupp.single v 1)) hXq
    rw [coeff_mul_X, coeff_mul_X, coeff_C_mul] at hc
    exact ⟨_, hc⟩
  obtain ⟨q₁, rfl⟩ := (C_dvd_iff_dvd_coeff _ _).2 hdvd
  have hcancel : g + C π * q₁ = q₁ * X u * X v := by
    have h0 : C π * (g + C π * q₁ - q₁ * X u * X v) = 0 := by
      have h2 := hXq
      linear_combination (-1 : MvPolynomial σ R) * h2
    have hC : IsLeftRegular (C π : MvPolynomial σ R) :=
      ((isLeftRegular_iff_isRegular.mp (isLeftRegular_of_non_zero_divisor π hπ)).monomial
        (m := 0)).left
    have h3 := hC.mul_left_eq_zero_iff.mp h0
    linear_combination h3
  refine Ideal.mem_span_singleton'.mpr ⟨q₁, ?_⟩
  linear_combination (-1 : MvPolynomial σ R) * hcancel

end MvPolynomial

namespace CerednikDrinfeld

namespace CartierLift

open MvPolynomial

variable (p : ℕ) (R : Type v) [CommRing R] {B : Type u}

/-- **Lift relation.** The polynomial `X u * X v - p` over `R` in the
variables `X b`, `b : B`. -/
noncomputable def liftRel (u v : B) : MvPolynomial B R :=
  X u * X v - C (p : R)

/-- **Lift ring.** Polynomials over `R` in variables `X b` indexed by `b : B`,
modulo the ideal generated by `X u * X v - p`. -/
abbrev LiftRing (u v : B) : Type (max u v) :=
  MvPolynomial B R ⧸ Ideal.span {liftRel p R u v}

variable {p R}

/-- **Lift variable.** The class of the variable `X b` in the lift ring. -/
noncomputable def liftVar (u v : B) (b : B) : LiftRing p R u v :=
  Ideal.Quotient.mk _ (X b)

theorem liftVar_mul_liftVar (u v : B) :
    liftVar (p := p) (R := R) u v u * liftVar (p := p) (R := R) u v v = p := by
  rw [liftVar, liftVar, ← map_mul,
    ← map_natCast (Ideal.Quotient.mk (Ideal.span {liftRel p R u v})),
    ← MvPolynomial.C_eq_natCast]
  refine (Ideal.Quotient.eq).mpr (Ideal.subset_span ?_)
  simp [liftRel]

/-- **Evaluation of the lift ring.** For `j : R →+* B` and `u * v = p` in `B`,
the ring map from the lift ring to `B` that is `j` on coefficients and sends
every variable `X b` to `b`; the factorization makes this evaluation vanish on
the relation. -/
noncomputable def liftHom [CommRing B] (j : R →+* B) (u v : B) (huv : u * v = p) :
    LiftRing p R u v →+* B :=
  Ideal.Quotient.lift _ (eval₂Hom j id) (fun a ha => by
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, liftRel, map_sub, map_mul, eval₂Hom_X', eval₂Hom_X',
      eval₂Hom_C, map_natCast, id, id, huv, sub_self, mul_zero])

@[simp] theorem liftHom_liftVar [CommRing B] (j : R →+* B) (u v : B)
    (huv : u * v = p) (b : B) :
    liftHom j u v huv (liftVar u v b) = b := by
  rw [liftHom, liftVar, Ideal.Quotient.lift_mk, eval₂Hom_X']
  rfl

theorem liftHom_mk_C [CommRing B] (j : R →+* B) (u v : B) (huv : u * v = p)
    (r : R) :
    liftHom j u v huv (Ideal.Quotient.mk _ (C r)) = j r := by
  rw [liftHom, Ideal.Quotient.lift_mk, eval₂Hom_C]

theorem liftHom_comp_algebraMap [CommRing B] (j : R →+* B) (u v : B)
    (huv : u * v = p) :
    (liftHom j u v huv).comp (algebraMap R (LiftRing p R u v)) = j :=
  RingHom.ext fun r => liftHom_mk_C j u v huv r

theorem liftHom_surjective [CommRing B] (j : R →+* B) (u v : B)
    (huv : u * v = p) :
    Function.Surjective (liftHom j u v huv) :=
  fun b => ⟨liftVar u v b, liftHom_liftVar j u v huv b⟩

theorem ringHom_ext {S : Type*} [CommRing S] {u v : B}
    {f g : LiftRing p R u v →+* S}
    (hC : f.comp (algebraMap R (LiftRing p R u v)) =
      g.comp (algebraMap R (LiftRing p R u v)))
    (hX : ∀ b : B, f (liftVar u v b) = g (liftVar u v b)) : f = g :=
  Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (RingHom.congr_fun hC) hX)

theorem eq_liftHom [CommRing B] (j : R →+* B) (u v : B) (huv : u * v = p)
    (f : LiftRing p R u v →+* B)
    (hC : f.comp (algebraMap R (LiftRing p R u v)) = j)
    (hX : ∀ b : B, f (liftVar u v b) = b) : f = liftHom j u v huv :=
  ringHom_ext (hC.trans (liftHom_comp_algebraMap j u v huv).symm)
    fun b => (hX b).trans (liftHom_liftVar j u v huv b).symm

/-- **Multiplication by `p` is injective on the lift ring.** If `p * r = 0`
implies `r = 0` in `R`, then `p * x = 0` implies `x = 0` in the lift ring. -/
theorem natCast_mul_eq_zero (hR : ∀ r : R, (p : R) * r = 0 → r = 0)
    (u v : B) (x : LiftRing p R u v) (hx : (p : LiftRing p R u v) * x = 0) :
    x = 0 := by
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.Quotient.eq_zero_iff_mem]
  refine MvPolynomial.mem_span_of_C_mul_mem_span_X_mul_X_sub_C hR u v ?_
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, MvPolynomial.C_eq_natCast,
    map_natCast]
  exact hx

/-- **Lifted structure constants.** The class of the variable `X (a m i)` in
the lift ring of `a 0 0` and `a 0 1`. -/
noncomputable def liftConstants (a : ℕ → Fin 2 → B) (m : ℕ) (i : Fin 2) :
    LiftRing p R (a 0 0) (a 0 1) :=
  liftVar (a 0 0) (a 0 1) (a m i)

@[simp] theorem liftHom_liftConstants [CommRing B] (j : R →+* B)
    (a : ℕ → Fin 2 → B) (h : a 0 0 * a 0 1 = p) (m : ℕ) (i : Fin 2) :
    liftHom j (a 0 0) (a 0 1) h (liftConstants (p := p) a m i) = a m i :=
  liftHom_liftVar j _ _ h _

theorem liftConstants_zero_zero_mul (a : ℕ → Fin 2 → B) :
    liftConstants (p := p) (R := R) a 0 0 *
      liftConstants (p := p) (R := R) a 0 1 = p :=
  liftVar_mul_liftVar _ _

/-- **Multiplication by `p` is injective on the lift ring over `Zp2 p`.** In
the lift ring with coefficients in `Zp2 p`, `p * x = 0` implies `x = 0`. -/
theorem natCast_mul_eq_zero_zp2 [Fact p.Prime] (u v : B)
    (x : LiftRing p (Zp2 p) u v) (hx : (p : LiftRing p (Zp2 p) u v) * x = 0) :
    x = 0 :=
  natCast_mul_eq_zero (fun r h => WittVector.eq_zero_of_p_mul_eq_zero r (by rwa [mul_comm]))
    u v x hx

end CartierLift

end CerednikDrinfeld
