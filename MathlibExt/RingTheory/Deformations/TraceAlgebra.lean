public import MathlibExt.RingTheory.Deformations.RepnFunctor

/-!
# The trace subalgebra of a representation

For a continuous representation `ρ : G →ₜ* GL n A` with `A` a local proartinian `𝓞`-algebra, the
*trace subalgebra* is the closure of the `𝓞`-subalgebra of `A` generated by the traces of `ρ`. It
is closed, contains every trace of `ρ`, and is contained in every closed subalgebra containing
the traces. Traces are invariant under conjugation and compatible with change of coefficients.

## Main definitions

* `Deformation.conjKer R`: the matrices in `GL n R` reducing to the identity, acting by
  conjugation.
* `Deformation.mapRepn n G 𝓞 f ρ`: the representation `ρ` with coefficients pushed along `f`.
* `Deformation.traceSubalgebra 𝓞 ρ`: the closed trace subalgebra.
* `Deformation.TraceAlgebra.Descends ρ`: some strictly equivalent representation has all matrix
  entries in the trace subalgebra.
-/

@[expose] public section

universe u v w

open CategoryTheory IsLocalRing

namespace Deformation

variable {n : Type v} [Fintype n] [DecidableEq n]
variable {G : Type w} [Group G] [TopologicalSpace G]
variable {𝓞 : Type u} [CommRing 𝓞] [IsLocalRing 𝓞]

/-- **Matrices reducing to the identity.** The subgroup of `ConjAct (GL n R)` of matrices
reducing to the identity modulo the maximal ideal: conjugation by these is strict equivalence. -/
noncomputable abbrev conjKer (R : ProartinianCat 𝓞) : Subgroup (ConjAct (GL n R)) :=
  ((Matrix.GeneralLinearGroup.map (n := n)
    (ProartinianCat.toResidueField R).hom.toRingHom).ker.comap (ConjAct.ofConjAct.toMonoidHom))

variable (n) in
theorem mem_conjKer_iff {R : ProartinianCat 𝓞} (γ : ConjAct (GL n R)) :
    γ ∈ conjKer (n := n) R ↔
      Matrix.GeneralLinearGroup.map (ProartinianCat.toResidueField R).hom.toRingHom
        (ConjAct.ofConjAct γ) = 1 :=
  Iff.rfl

variable (n G 𝓞) in
/-- **Change of coefficients.** Push a representation along a morphism of coefficient
algebras. -/
abbrev mapRepn {A B : ProartinianCat 𝓞} (f : A ⟶ B) (ρ : G →ₜ* GL n A) : G →ₜ* GL n B :=
  (repnFunctor n G 𝓞).map f ρ

omit [IsLocalRing 𝓞] in
@[simp]
theorem mapRepn_apply {A B : ProartinianCat 𝓞} (f : A ⟶ B) (ρ : G →ₜ* GL n A) (g : G) :
    mapRepn n G 𝓞 f ρ g = Matrix.GeneralLinearGroup.map f.hom.toRingHom (ρ g) :=
  rfl

omit [IsLocalRing 𝓞] in
theorem conjAct_smul_apply {R : ProartinianCat 𝓞} (γ : ConjAct (GL n R))
    (ρ : G →ₜ* GL n R) (g : G) :
    (γ • ρ) g = ConjAct.ofConjAct γ * ρ g * (ConjAct.ofConjAct γ)⁻¹ :=
  rfl

section TraceAlgebra

open ProartinianCat

variable (𝓞) in
/-- **Traces of a representation.** The set of traces `tr ρ(g)` of a representation. -/
def traceSet {A : ProartinianCat 𝓞} (ρ : G →ₜ* GL n A) : Set A.carrier :=
  Set.range fun g => Matrix.trace ((ρ g : GL n A.carrier) : Matrix n n A.carrier)

variable (𝓞) in
/-- **Trace subalgebra.** The closure of the `𝓞`-subalgebra generated by the traces of a
representation. -/
def traceSubalgebra {A : ProartinianCat 𝓞} (ρ : G →ₜ* GL n A) : Subalgebra 𝓞 A.carrier :=
  (Algebra.adjoin 𝓞 (traceSet 𝓞 ρ)).topologicalClosure

omit [IsLocalRing 𝓞] in
theorem isClosed_traceSubalgebra {A : ProartinianCat 𝓞} (ρ : G →ₜ* GL n A) :
    IsClosed ((traceSubalgebra 𝓞 ρ : Subalgebra 𝓞 A.carrier) : Set A.carrier) :=
  Subalgebra.isClosed_topologicalClosure _

omit [IsLocalRing 𝓞] in
theorem trace_mem_traceSubalgebra {A : ProartinianCat 𝓞} (ρ : G →ₜ* GL n A) (g : G) :
    Matrix.trace ((ρ g : GL n A.carrier) : Matrix n n A.carrier) ∈ traceSubalgebra 𝓞 ρ :=
  (Algebra.adjoin 𝓞 (traceSet 𝓞 ρ)).le_topologicalClosure
    (Algebra.subset_adjoin ⟨g, rfl⟩)

omit [IsLocalRing 𝓞] in
theorem traceSubalgebra_le {A : ProartinianCat 𝓞} (ρ : G →ₜ* GL n A) {T : Subalgebra 𝓞 A.carrier}
    (hT : IsClosed (T : Set A.carrier))
    (h : ∀ g, Matrix.trace ((ρ g : GL n A.carrier) : Matrix n n A.carrier) ∈ T) :
    traceSubalgebra 𝓞 ρ ≤ T :=
  Subalgebra.topologicalClosure_minimal
    (Algebra.adjoin_le (by rintro _ ⟨g, rfl⟩; exact h g)) hT

end TraceAlgebra

section TraceConj

omit [IsLocalRing 𝓞] in
theorem trace_smul_eq {A : ProartinianCat 𝓞} (γ : ConjAct (GL n A.carrier))
    (ρ : G →ₜ* GL n A) (g : G) :
    Matrix.trace (((γ • ρ) g : GL n A.carrier) : Matrix n n A.carrier) =
      Matrix.trace ((ρ g : GL n A.carrier) : Matrix n n A.carrier) := by
  have h1 : ((γ • ρ) g : GL n A.carrier) =
      ConjAct.ofConjAct γ * ρ g * (ConjAct.ofConjAct γ)⁻¹ := conjAct_smul_apply γ ρ g
  rw [h1]
  have h2 : ((ConjAct.ofConjAct γ * ρ g * (ConjAct.ofConjAct γ)⁻¹ : GL n A.carrier) :
      Matrix n n A.carrier) =
      ((ConjAct.ofConjAct γ : GL n A.carrier) : Matrix n n A.carrier) *
        ((ρ g : GL n A.carrier) : Matrix n n A.carrier) *
        ((↑(ConjAct.ofConjAct γ)⁻¹ : GL n A.carrier) : Matrix n n A.carrier) := by
    rw [Units.val_mul, Units.val_mul]
  rw [h2]
  exact Matrix.trace_units_conj (ConjAct.ofConjAct γ) _

omit [IsLocalRing 𝓞] in
theorem trace_mapRepn {A B : ProartinianCat 𝓞} (f : A ⟶ B) (ρ : G →ₜ* GL n A) (g : G) :
    Matrix.trace ((mapRepn n G 𝓞 f ρ g : GL n B.carrier) : Matrix n n B.carrier) =
      f.hom (Matrix.trace ((ρ g : GL n A.carrier) : Matrix n n A.carrier)) := by
  have h1 : ((mapRepn n G 𝓞 f ρ g : GL n B.carrier) : Matrix n n B.carrier) =
      ((ρ g : GL n A.carrier) : Matrix n n A.carrier).map f.hom.toRingHom := by
    rw [mapRepn_apply]
    rfl
  rw [h1]
  exact (AddMonoidHom.map_trace f.hom.toRingHom _).symm

end TraceConj

section Universal

open ProartinianCat

/-- **Descent to the trace subalgebra.** A representation *descends to its trace subalgebra* if
some strictly equivalent representation has all its matrix entries in the trace subalgebra. -/
def TraceAlgebra.Descends {A : ProartinianCat 𝓞} (ρ : G →ₜ* GL n A) : Prop :=
  ∃ γ ∈ conjKer (n := n) A, ∀ (g : G) (i j : n),
    (((γ • ρ) g : GL n A.carrier) : Matrix n n A.carrier) i j ∈ traceSubalgebra 𝓞 ρ

end Universal

end Deformation
