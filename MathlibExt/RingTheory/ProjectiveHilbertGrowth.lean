module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.Data.Nat.Choose.Basic

/-!
# Projective Hilbert-function growth data

The Hilbert function is the dimension of the actual homogeneous quotient
piece. Macaulay expansions use explicit, strictly increasing binomial
upper indices; inactive lower indices contribute zero.

References: Macaulay, *Some properties of enumeration in the theory of
modular systems* (1927); Gotzmann, *Eine Bedingung für die Flachheit und
das Hilbertpolynom eines graduierten Ringes* (1978).
-/

@[expose] public noncomputable section

namespace MathlibExt.RingTheory.ProjectiveHilbertGrowth

variable {k : Type*} [Field k] {n : ℕ}

def quotientPiece (I : Ideal (MvPolynomial (Fin n) k)) (d : ℕ) :
    Submodule k (MvPolynomial (Fin n) k ⧸ I) :=
  (MvPolynomial.weightedHomogeneousSubmodule k (fun _ ↦ (1 : ℕ)) d).map
    (Ideal.Quotient.mkₐ k I).toLinearMap

def hilbertFunction (I : Ideal (MvPolynomial (Fin n) k)) (d : ℕ) : ℕ :=
  Module.finrank k (quotientPiece I d)

def IsHomogeneous (I : Ideal (MvPolynomial (Fin n) k)) : Prop :=
  ∀ f ∈ I, ∀ d,
    MvPolynomial.weightedHomogeneousComponent (fun _ ↦ (1 : ℕ)) d f ∈ I

/-- The ideal is generated by its homogeneous elements of degree at most `d`. -/
def GeneratedThrough (I : Ideal (MvPolynomial (Fin n) k)) (d : ℕ) : Prop :=
  I = Ideal.span {f | f ∈ I ∧ ∃ j ≤ d,
    MvPolynomial.IsWeightedHomogeneous (fun _ ↦ (1 : ℕ)) f j}

/-- The binomial expansion used for Macaulay's degree-`d` growth transform. -/
structure MacaulayExpansion (d h : ℕ) where
  upper : Fin d → ℕ
  lowerBound : ∀ i, i.val ≤ upper i
  strictMono : StrictMono upper
  value_eq : ∑ i : Fin d, Nat.choose (upper i) (i.val + 1) = h

/-- The degree-raising Macaulay transform, computed from explicit indices. -/
def MacaulayExpansion.successor {d h : ℕ} (E : MacaulayExpansion d h) : ℕ :=
  ∑ i : Fin d, Nat.choose (E.upper i + 1) (i.val + 2)

end MathlibExt.RingTheory.ProjectiveHilbertGrowth
