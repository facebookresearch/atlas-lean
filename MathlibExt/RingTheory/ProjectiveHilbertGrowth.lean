module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.Data.Nat.Choose.Basic
import MathlibExt.Combinatorics.Enumerative.MacaulayMonomialShadow

/-!
# Projective Hilbert-function growth data

Give `k[x₀, …, xₙ₋₁]` its standard grading (Mathlib's `MvPolynomial.homogeneousSubmodule`) and let
`I` be a homogeneous ideal (Mathlib's `HomogeneousIdeal` for this grading). The Hilbert function
of `k[x] ⧸ I` in degree `d` is the dimension of the degree-`d` piece, the image of the homogeneous
polynomials of degree `d`; this piece is finite-dimensional (`finite_quotientPiece`).

The `d`-th Macaulay expansion of `h` writes `h = ∑_{i < d} (aᵢ choose (i + 1))` with strictly
increasing upper indices `a₀ < a₁ < ⋯ < a_{d-1}`; a digit with `aᵢ = i` contributes zero. Every
natural number has one when `d > 0` (`MacaulayExpansion.nonempty`), and Macaulay's growth
transform `h^⟨d⟩ = ∑_{i < d} (aᵢ + 1 choose (i + 2))` is computed from it.

The existence of the expansion is the greedy binomial-cascade lemma
`MetaMathlibExt.exists_strictMono_eq_sum_choose` of
`MathlibExt/Combinatorics/Enumerative/MacaulayMonomialShadow.lean`.

References: Macaulay, *Some properties of enumeration in the theory of
modular systems* (1927); Gotzmann, *Eine Bedingung für die Flachheit und
das Hilbertpolynom eines graduierten Ringes* (1978).
-/

@[expose] public noncomputable section

namespace MathlibExt.RingTheory.ProjectiveHilbertGrowth

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type*} [Field k] {n : ℕ}

/-- The degree-`d` piece of the quotient `k[x] ⧸ I` of the standard graded polynomial ring by a
homogeneous ideal: the image of the homogeneous polynomials of degree `d`. -/
def quotientPiece (I : HomogeneousIdeal (homogeneousSubmodule (Fin n) k)) (d : ℕ) :
    Submodule k (MvPolynomial (Fin n) k ⧸ I.toIdeal) :=
  (homogeneousSubmodule (Fin n) k d).map (Ideal.Quotient.mkₐ k I.toIdeal).toLinearMap

/-- Every degree piece of `k[x] ⧸ I` is finite-dimensional. -/
instance finite_quotientPiece (I : HomogeneousIdeal (homogeneousSubmodule (Fin n) k)) (d : ℕ) :
    Module.Finite k (quotientPiece I d) :=
  have := Module.Finite.iff_fg.mpr (homogeneousSubmodule_fg (σ := Fin n) (R := k) d)
  Module.Finite.map _ _

/-- The Hilbert function of `k[x] ⧸ I`: the dimension of its degree-`d` piece, which is
finite-dimensional by `finite_quotientPiece`. -/
def hilbertFunction (I : HomogeneousIdeal (homogeneousSubmodule (Fin n) k)) (d : ℕ) : ℕ :=
  Module.finrank k (quotientPiece I d)

/-- The ideal is generated by its homogeneous elements of degree at most `d`. -/
def GeneratedThrough (I : HomogeneousIdeal (homogeneousSubmodule (Fin n) k)) (d : ℕ) : Prop :=
  I.toIdeal = Ideal.span {f | f ∈ I.toIdeal ∧ ∃ j ≤ d, f.IsHomogeneous j}

/-- The binomial expansion used for Macaulay's degree-`d` growth transform: `h` is the sum of
`upper i choose (i + 1)` over `i < d`, with strictly increasing upper indices. -/
structure MacaulayExpansion (d h : ℕ) where
  /-- The upper binomial indices `a₀ < a₁ < ⋯ < a_{d-1}`. -/
  upper : Fin d → ℕ
  /-- Each upper index is at least its position, so a digit `aᵢ = i` contributes zero. -/
  lowerBound : ∀ i, i.val ≤ upper i
  /-- The upper indices increase strictly. -/
  strictMono : StrictMono upper
  /-- The expansion sums to `h`. -/
  value_eq : ∑ i : Fin d, Nat.choose (upper i) (i.val + 1) = h

/-- The degree-raising Macaulay transform, computed from explicit indices. -/
def MacaulayExpansion.successor {d h : ℕ} (E : MacaulayExpansion d h) : ℕ :=
  ∑ i : Fin d, Nat.choose (E.upper i + 1) (i.val + 2)

/-- A strictly increasing tuple of naturals dominates its positions. -/
theorem val_le_of_strictMono {d : ℕ} {f : Fin d → ℕ} (hf : StrictMono f) (i : Fin d) :
    i.val ≤ f i := by
  obtain ⟨i, hi⟩ := i
  induction i with
  | zero => exact Nat.zero_le _
  | succ i ih =>
    have hlt : f ⟨i, by omega⟩ < f ⟨i + 1, hi⟩ := hf (Fin.mk_lt_mk.mpr (Nat.lt_succ_self i))
    have hi' : i ≤ f ⟨i, by omega⟩ := ih (by omega)
    change i + 1 ≤ f ⟨i + 1, hi⟩
    omega

/-- Every natural number has a `d`-th Macaulay expansion when `d > 0`. -/
theorem MacaulayExpansion.nonempty {d : ℕ} (hd : 0 < d) (h : ℕ) :
    Nonempty (MacaulayExpansion d h) := by
  obtain ⟨digits, hstrict, hsum⟩ := MetaMathlibExt.exists_strictMono_eq_sum_choose d h hd
  exact ⟨⟨digits, val_le_of_strictMono hstrict, hstrict, hsum.symm⟩⟩

end MathlibExt.RingTheory.ProjectiveHilbertGrowth
