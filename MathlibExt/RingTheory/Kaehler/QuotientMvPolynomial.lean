module

public import Mathlib.RingTheory.Kaehler.Polynomial
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.TensorProduct.Basis

/-!
# Kähler differentials of a hypersurface

For a commutative ring `R`, a polynomial `g ∈ R[x_i : i ∈ σ]` in finitely many variables and the
quotient `B = R[x_i] / (g)`, the `B`-linear map `B^σ → Ω[B⁄R]`, `b ↦ ∑ b_i dx̄_i`, is surjective,
and its kernel is the submodule generated by the vector of the classes of the partial derivatives
`∂g/∂x_i`. For two variables this is the presentation of the Kähler differentials of the
coordinate ring of a plane curve, used for the invariant differential of a Weierstrass curve.

## Main results

* `MvPolynomial.quotientSpanSingleton_kaehler_surjective`,
  `MvPolynomial.quotientSpanSingleton_kaehler_ker`: the presentation, in any finite number of
  variables.
* `MvPolynomial.kaehlerDifferential_planeCurve`: the case of two variables.
-/

@[expose] public section

open KaehlerDifferential TensorProduct

namespace MvPolynomial

variable (R : Type*) [CommRing R] {σ : Type*} [Fintype σ]
  (g : MvPolynomial σ R)

/-- The `B`-linear map `B^σ → Ω[B⁄R]`, `b ↦ ∑ b_i dx̄_i`, for `B = R[x_i : i ∈ σ] / (g)`. -/
noncomputable def kaehlerCoordinates :
    (σ → MvPolynomial σ R ⧸ Ideal.span {g}) →ₗ[MvPolynomial σ R ⧸ Ideal.span {g}]
      Ω[MvPolynomial σ R ⧸ Ideal.span {g}⁄R] :=
  Fintype.linearCombination (MvPolynomial σ R ⧸ Ideal.span {g})
    (fun i ↦ D R _ (Ideal.Quotient.mk (Ideal.span {g}) (X i)))

theorem kaehlerCoordinates_apply (b : σ → MvPolynomial σ R ⧸ Ideal.span {g}) :
    kaehlerCoordinates R g b = ∑ i, b i • D R _ (Ideal.Quotient.mk (Ideal.span {g}) (X i)) := by
  simp [kaehlerCoordinates, Fintype.linearCombination_apply]

/-- `kaehlerCoordinates` factors as the coordinate isomorphism `B^σ ≅ B ⊗ Ω[R[x]⁄R]`, given by
the basis `dx_i`, followed by the base change map `B ⊗ Ω[R[x]⁄R] → Ω[B⁄R]`. -/
theorem kaehlerCoordinates_eq_comp :
    kaehlerCoordinates R g = (mapBaseChange R (MvPolynomial σ R) _).comp
      (((mvPolynomialBasis R σ).baseChange
        (MvPolynomial σ R ⧸ Ideal.span {g})).equivFun.symm.toLinearMap) := by
  classical
  refine LinearMap.pi_ext' fun i ↦ LinearMap.ext_ring ?_
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_single,
    LinearEquiv.coe_coe, Module.Basis.equivFun_symm_apply, kaehlerCoordinates_apply, map_sum,
    map_smul, Module.Basis.baseChange_apply, mvPolynomialBasis_apply, mapBaseChange_tmul,
    map_D]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  congr 1
  exact (one_smul (MvPolynomial σ R ⧸ Ideal.span {g}) (D R (MvPolynomial σ R ⧸ Ideal.span {g})
    (algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ Ideal.span {g}) (X x)))).symm

/-- **The differentials of a hypersurface are generated by the $d\bar x_i$.** For a commutative
ring $R$, a polynomial $g \in R[x_i : i \in \sigma]$ in finitely many variables and
$B = R[x_i] / (g)$, the $B$-linear map $B^\sigma \to \Omega^1_{B/R}$,
$(b_i) \mapsto \sum_i b_i \, d\bar x_i$, is surjective.

Source: B. Conrad, "Minimal models for elliptic curves", notes, version of 21 November 2015,
§2, Theorem 2.6 and Definition 2.7, p. 3, where the invariant differential is a global
generator of the relative differentials of a Weierstrass model; the presentation is proved
here. -/
theorem quotientSpanSingleton_kaehler_surjective :
    Function.Surjective (kaehlerCoordinates R g) := by
  classical
  rw [kaehlerCoordinates_eq_comp, LinearMap.coe_comp]
  exact (mapBaseChange_surjective R _ _ Ideal.Quotient.mk_surjective).comp
    (LinearEquiv.surjective _)

omit [Fintype σ] in
/-- The image of `1 ⊗ dh` for `h ∈ (g)` lies in the span of `1 ⊗ dg`. -/
private theorem tmul_D_mem_span {h : MvPolynomial σ R} (hh : h ∈ Ideal.span {g}) :
    (1 : MvPolynomial σ R ⧸ Ideal.span {g}) ⊗ₜ[MvPolynomial σ R] D R (MvPolynomial σ R) h ∈
      Submodule.span (MvPolynomial σ R ⧸ Ideal.span {g})
        {(1 : MvPolynomial σ R ⧸ Ideal.span {g}) ⊗ₜ[MvPolynomial σ R]
          D R (MvPolynomial σ R) g} := by
  obtain ⟨k, rfl⟩ := Ideal.mem_span_singleton'.mp hh
  have hg : algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ Ideal.span {g}) g = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g)
  rw [Derivation.leibniz, tmul_add, tmul_smul, tmul_smul]
  have h2 : g • ((1 : MvPolynomial σ R ⧸ Ideal.span {g}) ⊗ₜ[MvPolynomial σ R]
      D R (MvPolynomial σ R) k) = 0 := by
    rw [← algebraMap_smul (MvPolynomial σ R ⧸ Ideal.span {g}) g, hg, smul_tmul']
    simp
  rw [h2, add_zero, ← algebraMap_smul (MvPolynomial σ R ⧸ Ideal.span {g}) k]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- **The relation among the $d\bar x_i$ on a hypersurface.** For a commutative ring $R$, a
polynomial $g \in R[x_i : i \in \sigma]$ in finitely many variables and $B = R[x_i] / (g)$, the
kernel of the $B$-linear map $B^\sigma \to \Omega^1_{B/R}$, $(b_i) \mapsto \sum_i b_i \, d\bar x_i$,
is the submodule generated by $\bigl(\overline{\partial g / \partial x_i}\bigr)_{i \in \sigma}$.

Source: B. Conrad, "Minimal models for elliptic curves", notes, version of 21 November 2015,
§2, Theorem 2.6 and Definition 2.7, p. 3; the presentation is proved here. -/
theorem quotientSpanSingleton_kaehler_ker :
    LinearMap.ker (kaehlerCoordinates R g) =
      Submodule.span (MvPolynomial σ R ⧸ Ideal.span {g})
        {fun i ↦ Ideal.Quotient.mk (Ideal.span {g}) (pderiv i g)} := by
  classical
  have hsurj : Function.Surjective
      (algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ Ideal.span {g})) :=
    Ideal.Quotient.mk_surjective
  have hg : algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ Ideal.span {g}) g = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g)
  -- The kernel of the base change map is spanned by `1 ⊗ dg`.
  have hK : LinearMap.ker (mapBaseChange R (MvPolynomial σ R) (MvPolynomial σ R ⧸ Ideal.span {g})) =
      Submodule.span (MvPolynomial σ R ⧸ Ideal.span {g})
        {(1 : MvPolynomial σ R ⧸ Ideal.span {g}) ⊗ₜ[MvPolynomial σ R]
          D R (MvPolynomial σ R) g} := by
    apply le_antisymm
    · intro v hv
      obtain ⟨c, rfl⟩ := (exact_kerCotangentToTensor_mapBaseChange R _ _ hsurj v).mp hv
      obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ c
      rw [kerCotangentToTensor_toCotangent]
      exact tmul_D_mem_span R g (Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp x.2))
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      change mapBaseChange R _ _ _ = 0
      simp [mapBaseChange_tmul, map_D]
  rw [kaehlerCoordinates_eq_comp, LinearMap.ker_comp, hK, Submodule.comap_equiv_eq_map_symm,
    LinearEquiv.symm_symm, Submodule.map_span, Set.image_singleton]
  congr 2
  funext i
  simp [Module.Basis.equivFun_apply, Algebra.smul_def]

/-- **Kähler differentials of the coordinate ring of a plane curve.** Let $R$ be a commutative
ring, $g \in R[x, y]$ and $B = R[x, y] / (g)$, with $\bar x, \bar y$ the classes of $x, y$. The
$B$-linear map $B^2 \to \Omega^1_{B/R}$, $(b_1, b_2) \mapsto b_1 \, d\bar x + b_2 \, d\bar y$, is
surjective, and its kernel is the submodule generated by
$\bigl(\overline{\partial g/\partial x}, \overline{\partial g/\partial y}\bigr)$. Here $x$ and $y$
are the variables `X 0` and `X 1` of `MvPolynomial (Fin 2) R`. No hypothesis that $R$ is a field
is needed.

Source: B. Conrad, "Minimal models for elliptic curves", notes, version of 21 November 2015,
§2, Theorem 2.6 and Definition 2.7, p. 3; the presentation is proved here. -/
theorem kaehlerDifferential_planeCurve (g : MvPolynomial (Fin 2) R) :
    Function.Surjective (kaehlerCoordinates R g) ∧
      LinearMap.ker (kaehlerCoordinates R g) =
        Submodule.span (MvPolynomial (Fin 2) R ⧸ Ideal.span {g})
          {![Ideal.Quotient.mk (Ideal.span {g}) (pderiv 0 g),
            Ideal.Quotient.mk (Ideal.span {g}) (pderiv 1 g)]} := by
  refine ⟨quotientSpanSingleton_kaehler_surjective R g, ?_⟩
  rw [quotientSpanSingleton_kaehler_ker]
  congr 2
  funext i
  fin_cases i <;> rfl

end MvPolynomial
