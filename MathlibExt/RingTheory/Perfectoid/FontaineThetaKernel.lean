/-!
# The kernel of Fontaine's map `θ` is principal

Let `O` be a `p`-adically complete ring on which `p` is a non-zero-divisor, and let `ϖ` be an
element of its tilt `O♭` with `ϖ♯ = p`. If every `c ∈ O♭` whose zeroth component vanishes is a
multiple of `ϖ`, then the kernel of Fontaine's map `θ : W(O♭) → O` is generated by `p - [ϖ]`
(`WittVector.ker_fontaineTheta_eq_span`), and the kernel of `θ` with `p` inverted is generated by
the image of the same element (`ker_fontaineThetaInvertP_eq_span`). Both rest on a criterion for
the kernel of a ring map out of a `p`-adically complete ring
(`RingHom.ker_eq_span_singleton_of_isAdicComplete`).

For `O = 𝓞_ℂ_[p]` we choose a compatible system of `p`-power roots of `p` in `ℂ_[p]`
(`PadicComplexInt.rootsOfP`), the resulting element `p♭` of the tilt with `(p♭)♯ = p`
(`PadicComplexInt.pFlat`), and `ξ = p - [p♭]` (`PadicComplexInt.xi`). Then
`ker θ = (ξ)` (`PadicComplexInt.ker_fontaineTheta_eq_span_xi`), and the same holds with `p`
inverted (`PadicComplexInt.ker_fontaineThetaInvertP_eq_span_xi`); the ideal
`ker θ[1/p]` is the ideal along which Mathlib's `BDeRhamPlus 𝓞_ℂ_[p] p` is completed. We also
show that `p` is a non-zero-divisor modulo every `ξ ^ n`, and that `W(𝓞_ℂ_[p]♭) / ξ ^ n` is
`p`-adically separated.

## References

* [J.-M. Fontaine, *Le corps des périodes p-adiques*][fontaine1994corps], Astérisque 223 (1994),
  Exposé II, §2.3.3 p. 78 and §4.1.2 p. 83.
-/

@[expose] public noncomputable section

open Ideal

/-! ### A criterion for the kernel of a ring map out of a `p`-adically complete ring -/

section Criterion

variable {A B : Type*} [CommRing A] [CommRing B] (p : ℕ)

private theorem mem_span_pow_iff' (n : ℕ) (x : A) :
    x ∈ (span {(p : A)} ^ n • ⊤ : Submodule A A) ↔ ∃ c, x = (p : A) ^ n * c := by
  rw [smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨c, rfl⟩; exact ⟨c, mul_comm _ _⟩
  · rintro ⟨c, rfl⟩; exact ⟨c, mul_comm _ _⟩

/-- Let `A` be `p`-adically complete, let `θ : A →+* B` be a ring map such that `p` is a
non-zero-divisor on `B`, and let `ξ ∈ ker θ`. If every element of `ker θ` lies in `ξ A + p A`,
then `ker θ = ξ A`. -/
theorem RingHom.ker_eq_span_singleton_of_isAdicComplete [IsAdicComplete (span {(p : A)}) A]
    (θ : A →+* B) (hB : ∀ b : B, (p : B) * b = 0 → b = 0) (ξ : A) (hξ : θ ξ = 0)
    (h : ∀ x, θ x = 0 → ∃ y z, x = ξ * y + p * z) :
    RingHom.ker θ = span {ξ} := by
  apply le_antisymm
  · intro x hx
    have h' : ∀ x : RingHom.ker θ, ∃ y : A, ∃ z : RingHom.ker θ, x.1 = ξ * y + p * z.1 := by
      intro x
      obtain ⟨y, z, hyz⟩ := h x.1 x.2
      refine ⟨y, ⟨z, ?_⟩, hyz⟩
      have : θ x.1 = 0 := x.2
      rw [hyz, map_add, map_mul, map_mul, hξ, zero_mul, zero_add, map_natCast] at this
      exact hB _ this
    choose Y Z hYZ using h'
    let s : ℕ → RingHom.ker θ := fun n => Nat.rec ⟨x, hx⟩ (fun _ w => Z w) n
    let S : ℕ → A := fun n => ∑ k ∈ Finset.range n, (p : A) ^ k * Y (s k)
    have hS : ∀ n, x = ξ * S n + (p : A) ^ n * (s n).1 := by
      intro n
      induction n with
      | zero => simp [S, s]
      | succ n ih =>
        have e : (s (n + 1)) = Z (s n) := rfl
        rw [ih, hYZ (s n), ← e]
        simp only [S, Finset.sum_range_succ]
        ring
    have hdiff : ∀ m d, ∃ c, S (m + d) - S m = (p : A) ^ m * c := by
      intro m d
      induction d with
      | zero => exact ⟨0, by simp⟩
      | succ d ih =>
        obtain ⟨c, hc⟩ := ih
        refine ⟨c + (p : A) ^ d * Y (s (m + d)), ?_⟩
        have : S (m + (d + 1)) = S (m + d) + (p : A) ^ (m + d) * Y (s (m + d)) := by
          simp only [S, ← add_assoc, Finset.sum_range_succ]
        rw [this, pow_add]
        linear_combination hc
    have hcauchy : ∀ {m n}, m ≤ n →
        S m ≡ S n [SMOD (span {(p : A)} ^ m • ⊤ : Submodule A A)] := by
      intro m n hmn
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
      rw [SModEq.sub_mem, mem_span_pow_iff']
      obtain ⟨c, hc⟩ := hdiff m d
      exact ⟨-c, by linear_combination -hc⟩
    obtain ⟨L, hL⟩ := IsPrecomplete.prec inferInstance hcauchy
    have hx : x = ξ * L := by
      rw [← sub_eq_zero]
      apply IsHausdorff.haus' (I := span {(p : A)})
      intro n
      rw [SModEq.sub_mem, sub_zero, mem_span_pow_iff']
      have := hL n
      rw [SModEq.sub_mem, mem_span_pow_iff'] at this
      obtain ⟨c, hc⟩ := this
      refine ⟨ξ * c + (s n).1, ?_⟩
      linear_combination hS n + ξ * hc
    rw [hx]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self ξ)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hξ

private theorem pow_mul_eq_zero {B : Type*} [CommRing B] {p : ℕ}
    (hB : ∀ b : B, (p : B) * b = 0 → b = 0) (k : ℕ) (b : B) (h : (p : B) ^ k * b = 0) :
    b = 0 := by
  induction k generalizing b with
  | zero => simpa using h
  | succ k ih => exact ih b (hB _ (by rw [← h]; ring))

/-- Inverting `p`: let `θ : A →+* B` be a ring map with `ker θ = ξ A` such that `p` is a
non-zero-divisor on `B`. Then the kernel of the induced map `A[1/p] →+* B[1/p]` is generated by
the image of `ξ`. -/
theorem Localization.ker_awayLift_eq_span_singleton (θ : A →+* B)
    (hB : ∀ b : B, (p : B) * b = 0 → b = 0) (ξ : A) (hker : RingHom.ker θ = span {ξ})
    (hu : IsUnit (((algebraMap B (Localization.Away (p : B))).comp θ) (p : A))) :
    RingHom.ker (Localization.awayLift ((algebraMap B (Localization.Away (p : B))).comp θ)
      (p : A) hu) = span {algebraMap A (Localization.Away (p : A)) ξ} := by
  set L := Localization.awayLift ((algebraMap B (Localization.Away (p : B))).comp θ) (p : A) hu
  have hLa : ∀ a : A, L (algebraMap A _ a) = algebraMap B _ (θ a) := fun a =>
    IsLocalization.Away.lift_eq (p : A) hu a
  apply le_antisymm
  · intro z hz
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (p : A)) z
    have hspec := IsLocalization.mk'_spec (Localization.Away (p : A)) a s
    have h1 : algebraMap B (Localization.Away (p : B)) (θ a) = 0 := by
      rw [← hLa, ← hspec, map_mul, RingHom.mem_ker.mp hz, zero_mul]
    obtain ⟨⟨m, k, rfl⟩, hm⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (p : B)) _ _).mp h1
    have h2 : θ a = 0 := pow_mul_eq_zero hB k _ hm
    have h3 : a ∈ span {ξ} := hker ▸ RingHom.mem_ker.mpr h2
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp h3
    refine Ideal.mem_span_singleton'.mpr ⟨IsLocalization.mk' (Localization.Away (p : A)) c s, ?_⟩
    change _ = IsLocalization.mk' (Localization.Away (p : A)) (c * ξ) s
    rw [IsLocalization.mk'_eq_mul_mk'_one c, IsLocalization.mk'_eq_mul_mk'_one (c * ξ), map_mul]
    ring
  · have hξ : θ ξ = 0 := by
      rw [← RingHom.mem_ker, hker]; exact Ideal.mem_span_singleton_self ξ
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, hLa, hξ,
      map_zero]

end Criterion

/-! ### The kernel of Fontaine's map `θ` -/

section FontaineTheta

open WittVector

variable {O : Type*} [CommRing O] {p : ℕ} [Fact p.Prime] [Fact ¬IsUnit (p : O)]
  [IsAdicComplete (span {(p : O)}) O]

/-- Let `O` be a `p`-adically complete ring on which `p` is a non-zero-divisor, and let
`ϖ ∈ O♭` satisfy `ϖ♯ = p`. If `ϖ` divides every `c ∈ O♭` whose zeroth component vanishes, then
the kernel of Fontaine's map `θ : W(O♭) →+* O` is generated by `p - [ϖ]`. -/
theorem WittVector.ker_fontaineTheta_eq_span (hO : ∀ b : O, (p : O) * b = 0 → b = 0)
    (ϖ : PreTilt O p) (hϖ : ϖ.untilt = p)
    (hdiv : ∀ c : PreTilt O p, PreTilt.coeff 0 c = 0 → ϖ ∣ c) :
    RingHom.ker (fontaineTheta O p) =
      span {(p : WittVector p (PreTilt O p)) - teichmuller p ϖ} := by
  apply RingHom.ker_eq_span_singleton_of_isAdicComplete p _ hO
  · simp [hϖ]
  · intro x hx
    have h0 : PreTilt.coeff 0 (x.coeff 0) = 0 := by
      rw [← mk_fontaineTheta, hx, map_zero]
    obtain ⟨d, hd⟩ := hdiv _ h0
    have hmem : x - teichmuller p (x.coeff 0) ∈ span {(p : WittVector p (PreTilt O p))} := by
      rw [← ker_constantCoeff, RingHom.mem_ker, map_sub]
      simp
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hmem
    refine ⟨-teichmuller p d, teichmuller p d + w, ?_⟩
    rw [hd, map_mul] at hw
    linear_combination -hw

/-- If the kernel of Fontaine's map `θ : W(O♭) →+* O` is generated by `ξ` and `p` is a
non-zero-divisor on `O`, then the kernel of `θ` with `p` inverted
(`fontaineThetaInvertP O p`) is generated by the image of `ξ` in `W(O♭)[1/p]`. -/
theorem ker_fontaineThetaInvertP_eq_span (hO : ∀ b : O, (p : O) * b = 0 → b = 0)
    (ξ : WittVector p (PreTilt O p)) (hker : RingHom.ker (fontaineTheta O p) = span {ξ}) :
    RingHom.ker (fontaineThetaInvertP O p) =
      span {algebraMap _ (Localization.Away (p : WittVector p (PreTilt O p))) ξ} :=
  Localization.ker_awayLift_eq_span_singleton p (fontaineTheta O p) hO ξ hker
    (by simpa using IsLocalization.Away.algebraMap_isUnit (p : O))

end FontaineTheta

/-! ### Roots of an element of the tilt -/

namespace PreTilt

variable {R : Type*} [CommRing R] {q : ℕ} [Fact q.Prime] [Fact ¬IsUnit (q : R)]
  [IsAdicComplete (span {(q : R)}) R]

/-- The `n`-th `q`-power root `(F^{-n} x)♯` of `x♯`, for `x` in the tilt of `R`. -/
def untiltRoot (x : PreTilt R q) (n : ℕ) : R :=
  PreTilt.untilt (((frobeniusEquiv (PreTilt R q) q).symm^[n]) x)

/-- `x.untiltRoot n` is a `q ^ n`-th root of `x♯`. -/
theorem untiltRoot_pow (x : PreTilt R q) (n : ℕ) : x.untiltRoot n ^ q ^ n = x.untilt :=
  PreTilt.untilt_iterate_frobeniusEquiv_symm_pow x n

/-- `x.untiltRoot (n + 1)` is a `q`-th root of `x.untiltRoot n`. -/
theorem untiltRoot_succ_pow (x : PreTilt R q) (n : ℕ) :
    x.untiltRoot (n + 1) ^ q = x.untiltRoot n := by
  rw [untiltRoot, untiltRoot, Function.iterate_succ_apply', ← map_pow, frobeniusEquiv_symm_pow_p]

/-- The class of `x.untiltRoot n` modulo `q` is the `n`-th component of `x`. -/
theorem mk_untiltRoot (x : PreTilt R q) (n : ℕ) :
    Ideal.Quotient.mk (span {(q : R)}) (x.untiltRoot n) = PreTilt.coeff n x := by
  rw [untiltRoot, PreTilt.mk_untilt_eq_coeff_zero, PreTilt.coeff_iterate_frobeniusEquiv_symm,
    zero_add]

end PreTilt

/-! ### The kernel of `θ` for `𝓞_ℂ_[p]` -/

namespace PadicComplexInt

open WittVector PadicComplex

variable (p : ℕ) [hp : Fact p.Prime]

private theorem p_regular (b : 𝓞_ℂ_[p]) (h : (p : 𝓞_ℂ_[p]) * b = 0) : b = 0 :=
  (mul_eq_zero.mp h).resolve_left (Nat.cast_ne_zero.mpr hp.out.ne_zero)

/-- Let `ϖ` be an element of the tilt of `𝓞_ℂ_[p]` with `ϖ♯ = p`. Then `ϖ` divides every element
`c` of the tilt whose zeroth component vanishes. -/
theorem dvd_of_coeff_zero_eq_zero (ϖ : PreTilt 𝓞_ℂ_[p] p) (hϖ : ϖ.untilt = p)
    (c : PreTilt 𝓞_ℂ_[p] p) (hc : PreTilt.coeff 0 c = 0) : ϖ ∣ c := by
  -- `‖c♯‖ ≤ ‖p‖`
  have hc0 : ‖((c.untilt : 𝓞_ℂ_[p]) : ℂ_[p])‖ ≤ ‖(p : ℂ_[p])‖ := by
    have : c.untilt ∈ span {(p : 𝓞_ℂ_[p])} ^ 1 := by
      rw [pow_one, ← Ideal.Quotient.eq_zero_iff_mem, PreTilt.mk_untilt_eq_coeff_zero, hc]
    simpa using (mem_span_pow_iff p _ 1).mp this
  have hϖn : ∀ n, ‖((ϖ.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p])‖ ^ p ^ n = ‖(p : ℂ_[p])‖ := fun n => by
    have h := congrArg (fun z : 𝓞_ℂ_[p] => ‖(z : ℂ_[p])‖) (PreTilt.untiltRoot_pow ϖ n)
    rw [hϖ] at h
    simpa [norm_pow] using h
  have hcn : ∀ n, ‖((c.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p])‖ ^ p ^ n =
      ‖((c.untilt : 𝓞_ℂ_[p]) : ℂ_[p])‖ := fun n => by
    have h := congrArg (fun z : 𝓞_ℂ_[p] => ‖(z : ℂ_[p])‖) (PreTilt.untiltRoot_pow c n)
    simpa [norm_pow] using h
  have hne : ∀ n, ((ϖ.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p]) ≠ 0 := fun n h0 => by
    have := hϖn n
    rw [h0, norm_zero, zero_pow (pow_ne_zero _ hp.out.ne_zero)] at this
    exact (ne_of_lt (norm_p_pos p)) this
  have hle : ∀ n, ‖((c.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p])‖ ≤
      ‖((ϖ.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p])‖ :=
    fun n => by
      have hpn : p ^ n ≠ 0 := pow_ne_zero _ hp.out.ne_zero
      refine (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) hpn).mp ?_
      rw [hcn, hϖn]
      exact hc0
  let e : ℕ → 𝓞_ℂ_[p] := fun n => ⟨((c.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p]) /
      ((ϖ.untiltRoot n : 𝓞_ℂ_[p]) : ℂ_[p]),
    (mem_iff_norm_le_one p _).mpr (by
      rw [norm_div]; exact div_le_one_of_le₀ (hle n) (norm_nonneg _))⟩
  have he : ∀ n, e (n + 1) ^ p = e n := fun n => by
    apply Subtype.ext
    simp only [e, SubmonoidClass.coe_pow, div_pow]
    rw [← SubmonoidClass.coe_pow, ← SubmonoidClass.coe_pow, PreTilt.untiltRoot_succ_pow,
      PreTilt.untiltRoot_succ_pow]
  have hce : ∀ n, c.untiltRoot n = ϖ.untiltRoot n * e n := fun n => by
    apply Subtype.ext
    simp only [e, MulMemClass.coe_mul]
    field_simp [hne n]
  let d : PreTilt 𝓞_ℂ_[p] p := ⟨fun n => Ideal.Quotient.mk _ (e n), fun n => by
    rw [← map_pow, he]⟩
  refine ⟨d, ?_⟩
  apply Perfection.ext
  intro n
  change PreTilt.coeff n c = PreTilt.coeff n (ϖ * d)
  rw [map_mul]
  change PreTilt.coeff n c = PreTilt.coeff n ϖ * Ideal.Quotient.mk _ (e n)
  rw [← PreTilt.mk_untiltRoot, ← PreTilt.mk_untiltRoot, ← map_mul, hce]

/-- A compatible system of `p`-power roots of `p` in `ℂ_[p]`: `rootsOfP p 0 = p` and
`rootsOfP p (n + 1)` is a chosen `p`-th root of `rootsOfP p n`. -/
def rootsOfP : ℕ → ℂ_[p]
  | 0 => p
  | n + 1 => Classical.choose (IsAlgClosed.exists_pow_nat_eq (rootsOfP n) hp.out.pos)

/-- `rootsOfP p (n + 1)` is a `p`-th root of `rootsOfP p n`. -/
theorem rootsOfP_succ_pow (n : ℕ) : rootsOfP p (n + 1) ^ p = rootsOfP p n :=
  Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq (rootsOfP p n) hp.out.pos)

/-- `rootsOfP p n` is a `p ^ n`-th root of `p`. -/
theorem rootsOfP_pow (n : ℕ) : rootsOfP p n ^ p ^ n = p := by
  induction n with
  | zero => simp [rootsOfP]
  | succ n ih => rw [pow_succ', pow_mul, rootsOfP_succ_pow, ih]

/-- The roots `rootsOfP p n` have norm at most `1`, that is, they lie in `𝓞_ℂ_[p]`. -/
theorem norm_rootsOfP_le (n : ℕ) : ‖rootsOfP p n‖ ≤ 1 := by
  induction n with
  | zero => exact norm_le_one p (p : 𝓞_ℂ_[p])
  | succ n ih =>
    rw [← rootsOfP_succ_pow] at ih
    rw [norm_pow] at ih
    exact (pow_le_one_iff_of_nonneg (norm_nonneg _) hp.out.ne_zero).mp ih

/-- The element `p♭ = (p, p^{1/p}, p^{1/p²}, …)` of the tilt of `𝓞_ℂ_[p]`: its `n`-th component
is the class modulo `p` of `rootsOfP p n`. -/
def pFlat : PreTilt 𝓞_ℂ_[p] p :=
  ⟨fun n => Ideal.Quotient.mk _
      ⟨rootsOfP p n, (mem_iff_norm_le_one p _).mpr (norm_rootsOfP_le p n)⟩,
    fun n => by
      rw [← map_pow]
      congr 1
      exact Subtype.ext (by simpa using rootsOfP_succ_pow p n)⟩

/-- The untilt of `p♭` is `p`. -/
theorem untilt_pFlat : (pFlat p).untilt = p := by
  rw [IsHausdorff.eq_iff_smodEq (I := span {(p : 𝓞_ℂ_[p])})]
  intro n
  rw [SModEq.sub_mem, mem_span_pow_iff']
  have h1 : (pFlat p).untiltRoot n -
      ⟨rootsOfP p n, (mem_iff_norm_le_one p _).mpr (norm_rootsOfP_le p n)⟩ ∈
      span {(p : 𝓞_ℂ_[p])} := by
    rw [← Ideal.Quotient.eq, PreTilt.mk_untiltRoot]; rfl
  have h2 := dvd_sub_pow_of_dvd_sub (Ideal.mem_span_singleton.mp h1) n
  rw [PreTilt.untiltRoot_pow] at h2
  have h3 : (⟨rootsOfP p n, (mem_iff_norm_le_one p _).mpr (norm_rootsOfP_le p n)⟩ :
      𝓞_ℂ_[p]) ^ p ^ n = p :=
    Subtype.ext (by simpa using rootsOfP_pow p n)
  rw [h3] at h2
  obtain ⟨c, hc⟩ := h2
  exact ⟨p * c, by rw [hc]; ring⟩

/-- Fontaine's element `ξ = p - [p♭]` of `W(𝓞_ℂ_[p]♭)`. -/
def xi : WittVector p (PreTilt 𝓞_ℂ_[p] p) :=
  (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) - teichmuller p (pFlat p)

/-- The kernel of Fontaine's map `θ : W(𝓞_ℂ_[p]♭) →+* 𝓞_ℂ_[p]` is generated by
`ξ = p - [p♭]`. -/
theorem ker_fontaineTheta_eq_span_xi : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {xi p} :=
  ker_fontaineTheta_eq_span (p_regular p) (pFlat p) (untilt_pFlat p)
    (dvd_of_coeff_zero_eq_zero p (pFlat p) (untilt_pFlat p))

/-- The kernel of Fontaine's map with `p` inverted, `θ : W(𝓞_ℂ_[p]♭)[1/p] →+* 𝓞_ℂ_[p][1/p]`,
along which `BDeRhamPlus 𝓞_ℂ_[p] p` is the completion, is generated by the image of
`ξ = p - [p♭]`. -/
theorem ker_fontaineThetaInvertP_eq_span_xi :
    RingHom.ker (fontaineThetaInvertP 𝓞_ℂ_[p] p) =
      span {algebraMap _ (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) (xi p)} :=
  ker_fontaineThetaInvertP_eq_span (p_regular p) _ (ker_fontaineTheta_eq_span_xi p)

/-- `θ(ξ) = 0`. -/
theorem fontaineTheta_xi : fontaineTheta 𝓞_ℂ_[p] p (xi p) = 0 := by
  change xi p ∈ RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p)
  rw [ker_fontaineTheta_eq_span_xi]
  exact Ideal.mem_span_singleton_self _

/-- For every `m`, the `m`-th power of the kernel of `θ` with `p` inverted is generated by the
image of `ξ ^ m`. -/
theorem ker_fontaineThetaInvertP_pow_eq_span_xi_pow (m : ℕ) :
    RingHom.ker (fontaineThetaInvertP 𝓞_ℂ_[p] p) ^ m =
      span {algebraMap _ (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) (xi p) ^
        m} := by
  rw [ker_fontaineThetaInvertP_eq_span_xi, Ideal.span_singleton_pow]

/-- The tilt of `𝓞_ℂ_[p]` is an integral domain. -/
instance isDomain_preTilt : IsDomain (PreTilt 𝓞_ℂ_[p] p) :=
  PreTilt.isDomain ℂ_[p] (PadicComplex.valued p).v 𝓞_ℂ_[p] (PadicComplexInt.integers p) p

/-- `W(𝓞_ℂ_[p]♭)[1/p]` is an integral domain. -/
instance isDomain_localizationAway :
    IsDomain (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) :=
  IsLocalization.isDomain_localization
    (powers_le_nonZeroDivisors_of_noZeroDivisors (WittVector.p_ne_zero p _))

/-- `ξ ≠ 0`. -/
theorem xi_ne_zero : xi p ≠ 0 := by
  intro h
  have h1 : WittVector.constantCoeff (xi p) = 0 := by rw [h, map_zero]
  rw [xi, map_sub, map_natCast, CharP.cast_eq_zero, zero_sub, neg_eq_zero] at h1
  have h2 : pFlat p = 0 := by simpa using h1
  have h3 := untilt_pFlat p
  rw [← fontaineTheta_teichmuller, h2, WittVector.teichmuller_zero, map_zero] at h3
  exact (Nat.cast_ne_zero.mpr hp.out.ne_zero) h3.symm

/-- `p` is a non-zero-divisor modulo `ξ ^ n` in `W(𝓞_ℂ_[p]♭)`. -/
theorem mem_span_xi_pow_of_p_mul_mem (n : ℕ) : ∀ a : WittVector p (PreTilt 𝓞_ℂ_[p] p),
    (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) * a ∈ span {xi p ^ n} → a ∈ span {xi p ^ n} := by
  induction n with
  | zero => intro a _; rw [pow_zero, Ideal.span_singleton_one]; trivial
  | succ n ih =>
    intro a ha
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ha
    have hθ : fontaineTheta 𝓞_ℂ_[p] p a = 0 := by
      apply p_regular p
      have := congrArg (fontaineTheta 𝓞_ℂ_[p] p) hc
      rw [map_mul, map_mul, map_pow, map_natCast] at this
      rw [← this, fontaineTheta_xi, zero_pow (Nat.succ_ne_zero n), mul_zero]
    have ha' : a ∈ span {xi p} := by
      rw [← ker_fontaineTheta_eq_span_xi]
      exact hθ
    obtain ⟨a', rfl⟩ := Ideal.mem_span_singleton'.mp ha'
    have h2 : (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) * a' = c * xi p ^ n := by
      apply mul_left_cancel₀ (xi_ne_zero p)
      linear_combination hc.symm
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp
      (ih a' (Ideal.mem_span_singleton'.mpr ⟨c, h2.symm⟩))
    exact Ideal.mem_span_singleton'.mpr ⟨d, by rw [← hd, pow_succ]; ring⟩

/-- `p ^ e` is a non-zero-divisor modulo `ξ ^ n` in `W(𝓞_ℂ_[p]♭)`. -/
theorem mem_span_xi_pow_of_p_pow_mul_mem (n e : ℕ) (a : WittVector p (PreTilt 𝓞_ℂ_[p] p))
    (h : (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) ^ e * a ∈ span {xi p ^ n}) :
    a ∈ span {xi p ^ n} := by
  induction e generalizing a with
  | zero => simpa using h
  | succ e ih =>
    apply ih
    apply mem_span_xi_pow_of_p_mul_mem
    rw [pow_succ] at h
    simpa [mul_assoc, mul_comm, mul_left_comm] using h

/-- If the image of `a ∈ W(𝓞_ℂ_[p]♭)` in `W(𝓞_ℂ_[p]♭)[1/p]` is a multiple of the image of
`ξ ^ k`, then `a` is a multiple of `ξ ^ k` in `W(𝓞_ℂ_[p]♭)`. -/
theorem mem_span_xi_pow_of_algebraMap_mem (k : ℕ) (a : WittVector p (PreTilt 𝓞_ℂ_[p] p))
    (h : algebraMap _ (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) a ∈
      span {algebraMap _ (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) (xi p) ^ k}) :
    a ∈ span {xi p ^ k} := by
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp h
  obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective
    (Submonoid.powers (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) y
  obtain ⟨e, he⟩ := s.2
  apply mem_span_xi_pow_of_p_pow_mul_mem p k e
  have hinj := IsLocalization.injective
    (M := Submonoid.powers (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)))
    (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)))
    (powers_le_nonZeroDivisors_of_noZeroDivisors (WittVector.p_ne_zero p (PreTilt 𝓞_ℂ_[p] p)))
  have : (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) ^ e * a = b * xi p ^ k := by
    apply hinj
    have hs := IsLocalization.mk'_spec
      (Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))) b s
    simp only at he
    dsimp only at hy
    rw [map_mul, map_mul, map_pow, ← hy, ← hs, ← he]
    simp only [map_pow]
    ring
  exact Ideal.mem_span_singleton'.mpr ⟨b, this.symm⟩

/-- `⋂ₖ (pᵏ W(𝓞_ℂ_[p]♭) + ξ W(𝓞_ℂ_[p]♭)) = ξ W(𝓞_ℂ_[p]♭)`: an element that lies in
`pᵏ W(𝓞_ℂ_[p]♭) + ξ W(𝓞_ℂ_[p]♭)` for every `k` is a multiple of `ξ`. -/
theorem mem_span_xi_of_forall (w : WittVector p (PreTilt 𝓞_ℂ_[p] p))
    (h : ∀ k : ℕ, ∃ a b : WittVector p (PreTilt 𝓞_ℂ_[p] p),
      w = (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) ^ k * a + xi p * b) :
    w ∈ span {xi p} := by
  rw [← ker_fontaineTheta_eq_span_xi]
  change fontaineTheta 𝓞_ℂ_[p] p w = 0
  apply IsHausdorff.haus' (I := span {(p : 𝓞_ℂ_[p])})
  intro k
  obtain ⟨a, b, rfl⟩ := h k
  rw [SModEq.sub_mem, sub_zero, smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton, map_add, map_mul, map_mul, map_pow, map_natCast, fontaineTheta_xi,
    zero_mul, add_zero]
  exact dvd_mul_right _ _

/-- `⋂ₖ (pᵏ W(𝓞_ℂ_[p]♭) + ξᵐ W(𝓞_ℂ_[p]♭)) = ξᵐ W(𝓞_ℂ_[p]♭)`: the quotient `W(𝓞_ℂ_[p]♭) / ξᵐ`
is `p`-adically separated. -/
theorem mem_span_xi_pow_of_forall (m : ℕ) : ∀ w : WittVector p (PreTilt 𝓞_ℂ_[p] p),
    (∀ k : ℕ, ∃ a b : WittVector p (PreTilt 𝓞_ℂ_[p] p),
      w = (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) ^ k * a + xi p ^ m * b) →
    w ∈ span {xi p ^ m} := by
  induction m with
  | zero => intro w _; rw [pow_zero, Ideal.span_singleton_one]; trivial
  | succ m ih =>
    intro w h
    have h1 : w ∈ span {xi p ^ m} := ih w fun k => by
      obtain ⟨a, b, hab⟩ := h k
      exact ⟨a, xi p * b, by rw [hab, pow_succ]; ring⟩
    obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.mp h1
    have h2 : z ∈ span {xi p} := mem_span_xi_of_forall p z fun k => by
      obtain ⟨a, b, hab⟩ := h k
      rw [pow_succ] at hab
      have ha : (p : WittVector p (PreTilt 𝓞_ℂ_[p] p)) ^ k * a ∈ span {xi p ^ m} :=
        Ideal.mem_span_singleton'.mpr ⟨z - xi p * b, by linear_combination hab⟩
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (mem_span_xi_pow_of_p_pow_mul_mem p m k a ha)
      refine ⟨c, b, ?_⟩
      apply mul_left_cancel₀ (pow_ne_zero m (xi_ne_zero p))
      rw [← hc] at hab
      linear_combination hab
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp h2
    exact Ideal.mem_span_singleton'.mpr ⟨d, by rw [pow_succ]; ring⟩

end PadicComplexInt
