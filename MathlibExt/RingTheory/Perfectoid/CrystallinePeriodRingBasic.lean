/-!
# Fontaine's crystalline period ring: divided powers of a generator of `ker θ`

Write `A_inf = W(𝓞_ℂ_[p]♭)` and let `θ : A_inf → 𝓞_ℂ_[p]` be Fontaine's map. Following
Fontaine, `A_cris` is the `p`-adic completion of the subring `W(R)[w^n/n! : n ≥ 1]` of
`A_inf[1/p]` generated by `A_inf` and the divided powers `w^n/n!` of a generator `w` of `ker θ`
(Fontaine, *Le corps des périodes p-adiques*, Astérisque 223 (1994), Exposé II, §2.3.3 p. 78).
This file sets up the objects:

* `PadicComplexInt.restrictedPowerSeries`: power series over `A_inf` whose coefficients tend to
  `0` `p`-adically;
* `PadicComplexInt.dividedPower`: the divided power `w^n/n!` in `A_inf[1/p]`;
* `PadicComplexInt.dividedPowerSeries`: the series `Σ aₙ Xⁿ/n!` over `A_inf[1/p]` attached to
  `Σ aₙ Xⁿ` over `A_inf`;
* `PadicComplexInt.evalBDeRhamPlus`: evaluation of power series over `A_inf[1/p]` at an element
  of `ker θ[1/p]`, with values in `BDeRhamPlus 𝓞_ℂ_[p] p`;
* `PadicComplexInt.finiteDividedPowers`: the subring `A_inf[w^n/n! : n ≥ 1]` of `A_inf[1/p]`;
* `PadicComplexInt.CrystallineCompletion`: its `p`-adic completion.

We show that a generator of `ker θ` is a unit multiple of `ξ`, that it is a non-zero-divisor
modulo every `p ^ k`, and that every element of `A_inf[w^n/n!]` is a finite sum
`Σ_{n<N} aₙ w^n/n!` with `aₙ ∈ A_inf` (`PadicComplexInt.exists_dividedPowerSum_of_mem`), the
finite analogue of the description of `A_cris` in Fontaine, *op. cit.*, §4.1.2 p. 83.
-/

@[expose] public noncomputable section

open Ideal PowerSeries
open WittVector (fontaineTheta)

namespace PadicComplexInt

variable (p : ℕ) [hp : Fact p.Prime]

local notation "𝔸" => WittVector p (PreTilt 𝓞_ℂ_[p] p)
local notation "𝔸ₚ" => Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))
local notation "𝕀" => RingHom.ker (fontaineThetaInvertP 𝓞_ℂ_[p] p)

/-! ### The objects -/

section Objects

/-- The ring map `ℤ_[p] ≃ W(𝔽_p) → W(𝓞_ℂ_[p]♭)` induced by `𝔽_p → 𝓞_ℂ_[p]♭`. -/
def padicIntToAinf : ℤ_[p] →+* 𝔸 :=
  (WittVector.map (ZMod.castHom (dvd_refl p) (PreTilt 𝓞_ℂ_[p] p))).comp
    (WittVector.equiv p).symm.toRingHom

/-- Every nonzero natural number is a unit in `W(𝓞_ℂ_[p]♭)[1/p]`. -/
theorem isUnit_natCast {k : ℕ} (hk : k ≠ 0) : IsUnit ((k : ℕ) : 𝔸ₚ) := by
  obtain ⟨v, m, hpm, rfl⟩ := Nat.exists_eq_pow_mul_and_not_dvd hk p hp.out.ne_one
  have hm : IsUnit (m : ℤ_[p]) := PadicInt.isUnit_iff.mpr
    (PadicInt.norm_natCast_eq_one_iff.mpr ((Nat.Prime.coprime_iff_not_dvd hp.out).mpr hpm))
  have hm' : IsUnit ((m : ℕ) : 𝔸ₚ) := by
    have := (hm.map (padicIntToAinf p)).map (algebraMap 𝔸 𝔸ₚ)
    rwa [map_natCast, map_natCast] at this
  have hpu : IsUnit ((p : ℕ) : 𝔸ₚ) := by
    have := IsLocalization.Away.algebraMap_isUnit (S := 𝔸ₚ) (p : 𝔸)
    rwa [map_natCast] at this
  rw [Nat.cast_mul, Nat.cast_pow]
  exact (hpu.pow v).mul hm'

/-- Power series over `W(𝓞_ℂ_[p]♭)` whose coefficients tend to `0` `p`-adically: for every `k`,
all but finitely many coefficients are divisible by `p ^ k`. -/
def restrictedPowerSeries : Subring 𝔸⟦X⟧ where
  carrier := {f | ∀ k : ℕ, ∃ N : ℕ, ∀ n ≥ N, (p : 𝔸) ^ k ∣ PowerSeries.coeff n f}
  one_mem' k := by
    refine ⟨1, fun n hn => ?_⟩
    rw [PowerSeries.coeff_one, ite_eq_right (by omega)]
    exact dvd_zero _
  zero_mem' k := by
    refine ⟨0, fun n _ => ?_⟩
    rw [map_zero]
    exact dvd_zero _
  add_mem' {f g} hf hg k := by
    obtain ⟨N, hN⟩ := hf k
    obtain ⟨M, hM⟩ := hg k
    refine ⟨max N M, fun n hn => ?_⟩
    rw [map_add]
    exact dvd_add (hN n (le_of_max_le_left hn)) (hM n (le_of_max_le_right hn))
  neg_mem' {f} hf k := by
    obtain ⟨N, hN⟩ := hf k
    refine ⟨N, fun n hn => ?_⟩
    rw [map_neg]
    exact (dvd_neg).mpr (hN n hn)
  mul_mem' {f g} hf hg k := by
    obtain ⟨N, hN⟩ := hf k
    obtain ⟨M, hM⟩ := hg k
    refine ⟨N + M, fun n hn => ?_⟩
    rw [PowerSeries.coeff_mul]
    refine Finset.dvd_sum fun ij hij => ?_
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
    by_cases hi : N ≤ ij.1
    · exact Dvd.dvd.mul_right (hN _ hi) _
    · exact Dvd.dvd.mul_left (hM _ (by omega)) _

/-- The divided-power series `Σ aₙ Xⁿ/n!` over `W(𝓞_ℂ_[p]♭)[1/p]` of a power series `Σ aₙ Xⁿ`
over `W(𝓞_ℂ_[p]♭)`. -/
def dividedPowerSeries (f : 𝔸⟦X⟧) : 𝔸ₚ⟦X⟧ :=
  PowerSeries.mk fun n =>
    algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff n f) * Ring.inverse ((n.factorial : ℕ) : 𝔸ₚ)

/-- Evaluation of power series over `W(𝓞_ℂ_[p]♭)[1/p]` at an element `x` of the kernel of `θ`
with `p` inverted, with values in `BDeRhamPlus 𝓞_ℂ_[p] p`, the completion along that kernel
(`AdicCompletion.evalPowerSeries`). -/
def evalBDeRhamPlus {x : 𝔸ₚ} (hx : x ∈ 𝕀) : 𝔸ₚ⟦X⟧ →+* BDeRhamPlus 𝓞_ℂ_[p] p :=
  AdicCompletion.evalPowerSeries 𝕀 hx

/-- If `θ(w) = 0`, the image of `w` in `W(𝓞_ℂ_[p]♭)[1/p]` lies in the kernel of `θ` with `p`
inverted. -/
theorem algebraMap_mem_ker_fontaineThetaInvertP {w : 𝔸} (hw : fontaineTheta 𝓞_ℂ_[p] p w = 0) :
    algebraMap 𝔸 𝔸ₚ w ∈ 𝕀 := by
  have hk : w ∈ RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) := hw
  rw [ker_fontaineTheta_eq_span_xi, Ideal.mem_span_singleton'] at hk
  obtain ⟨c, rfl⟩ := hk
  rw [map_mul, ker_fontaineThetaInvertP_eq_span_xi]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

variable {p} in
/-- The divided power `w^n/n!` of `w ∈ W(𝓞_ℂ_[p]♭)`, an element of `W(𝓞_ℂ_[p]♭)[1/p]`. -/
def dividedPower (w : 𝔸) (n : ℕ) : 𝔸ₚ :=
  algebraMap 𝔸 𝔸ₚ w ^ n * Ring.inverse ((n.factorial : ℕ) : 𝔸ₚ)

/-- The subring `W(𝓞_ℂ_[p]♭)[w^n/n! : n ≥ 1]` of `W(𝓞_ℂ_[p]♭)[1/p]` generated by
`W(𝓞_ℂ_[p]♭)` and the divided powers of `w`. -/
def finiteDividedPowers (w : 𝔸) : Subring 𝔸ₚ :=
  Subring.closure
    (Set.range (algebraMap 𝔸 𝔸ₚ) ∪ Set.range (fun n : ℕ => dividedPower w (n + 1)))

/-- The `p`-adic completion of `W(𝓞_ℂ_[p]♭)[w^n/n! : n ≥ 1]`. For a generator `w` of the kernel
of `θ`, this is Fontaine's ring `A_cris`. -/
abbrev CrystallineCompletion (w : 𝔸) :=
  AdicCompletion (Ideal.span ({(p : finiteDividedPowers p w)} : Set (finiteDividedPowers p w)))
    (finiteDividedPowers p w)

end Objects

variable {p}

/-! ### A generator of `ker θ` -/

section Generator

variable {w : WittVector p (PreTilt 𝓞_ℂ_[p] p)}

/-- A generator of the kernel of `θ` is a unit multiple of `ξ`. -/
theorem exists_eq_xi_mul_unit (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) :
    ∃ c : 𝔸ˣ, w = xi p * (c : 𝔸) := by
  have hw : w ∈ span {xi p} := by
    rw [← ker_fontaineTheta_eq_span_xi p, hgen]
    exact mem_span_singleton_self w
  have hx : xi p ∈ span {w} := by
    rw [← hgen, ker_fontaineTheta_eq_span_xi p]
    exact mem_span_singleton_self _
  obtain ⟨c, hc⟩ := mem_span_singleton'.mp hw
  obtain ⟨d, hd⟩ := mem_span_singleton'.mp hx
  have hcd : c * d = 1 := by
    apply mul_right_cancel₀ (xi_ne_zero p)
    rw [one_mul, mul_comm c d, mul_assoc, hc, hd]
  exact ⟨⟨c, d, hcd, by rw [mul_comm]; exact hcd⟩, hc.symm.trans (mul_comm _ _)⟩

/-- For a generator `w` of the kernel of `θ`, `(w ^ m) = (ξ ^ m)`. -/
theorem span_pow_eq_span_xi_pow (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w})
    (m : ℕ) : span {w ^ m} = span {xi p ^ m} := by
  obtain ⟨c, rfl⟩ := exists_eq_xi_mul_unit hgen
  rw [mul_pow]
  exact span_singleton_mul_right_unit (c.isUnit.pow m) _

/-- For a generator `w` of the kernel of `θ`, the `m`-th power of the kernel of `θ` with `p`
inverted is generated by the image of `w ^ m`. -/
theorem ker_fontaineThetaInvertP_pow_eq_span_pow
    (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) (m : ℕ) :
    𝕀 ^ m = span {algebraMap 𝔸 𝔸ₚ w ^ m} := by
  obtain ⟨c, rfl⟩ := exists_eq_xi_mul_unit hgen
  rw [ker_fontaineThetaInvertP_pow_eq_span_xi_pow, map_mul, mul_pow]
  exact (span_singleton_mul_right_unit ((c.isUnit.map _).pow m) _).symm

/-- For a generator `w` of the kernel of `θ`: if the image of `a ∈ W(𝓞_ℂ_[p]♭)` lies in the
`m`-th power of the kernel of `θ` with `p` inverted, then `a` is a multiple of `w ^ m`. -/
theorem mem_span_pow_of_algebraMap_mem
    (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) (m : ℕ) {a : 𝔸}
    (h : algebraMap 𝔸 𝔸ₚ a ∈ 𝕀 ^ m) : a ∈ span {w ^ m} := by
  rw [span_pow_eq_span_xi_pow hgen]
  rw [ker_fontaineThetaInvertP_pow_eq_span_xi_pow] at h
  exact mem_span_xi_pow_of_algebraMap_mem p m a h

/-- For a generator `w` of the kernel of `θ`, `⋂ₖ (pᵏ W(𝓞_ℂ_[p]♭) + wᵐ W(𝓞_ℂ_[p]♭))` is
contained in `wᵐ W(𝓞_ℂ_[p]♭)`. -/
theorem mem_span_pow_of_forall
    (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) (m : ℕ) {x : 𝔸}
    (h : ∀ k : ℕ, ∃ a b : 𝔸, x = (p : 𝔸) ^ k * a + w ^ m * b) :
    x ∈ span {w ^ m} := by
  rw [span_pow_eq_span_xi_pow hgen]
  obtain ⟨c, rfl⟩ := exists_eq_xi_mul_unit hgen
  refine mem_span_xi_pow_of_forall p m x fun k => ?_
  obtain ⟨a, b, hab⟩ := h k
  exact ⟨a, (c : 𝔸) ^ m * b, by rw [hab]; ring⟩

/-- If `p` divides `ξ u` in `W(𝓞_ℂ_[p]♭)`, then `p` divides `u`. -/
theorem p_dvd_of_dvd_xi_mul {u : 𝔸} (h : (p : 𝔸) ∣ xi p * u) : (p : 𝔸) ∣ u := by
  rw [← mem_span_singleton, WittVector.mem_span_p_iff_coeff_zero_eq_zero] at h ⊢
  rw [WittVector.mul_coeff_zero] at h
  refine (mul_eq_zero.mp h).resolve_left fun h0 => ?_
  have h1 : WittVector.constantCoeff (xi p) = 0 := h0
  rw [xi, map_sub, map_natCast, CharP.cast_eq_zero, zero_sub, neg_eq_zero] at h1
  have h2 : pFlat p = 0 := by simpa using h1
  have h3 := untilt_pFlat p
  rw [← WittVector.fontaineTheta_teichmuller, h2, WittVector.teichmuller_zero, map_zero] at h3
  exact (Nat.cast_ne_zero.mpr hp.out.ne_zero) h3.symm

/-- A generator `w` of the kernel of `θ` is a non-zero-divisor modulo every `p ^ k`: if
`p ^ k ∣ w u`, then `p ^ k ∣ u`. -/
theorem p_pow_dvd_of_dvd_mul (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w})
    (k : ℕ) {u : 𝔸} (h : (p : 𝔸) ^ k ∣ w * u) : (p : 𝔸) ^ k ∣ u := by
  obtain ⟨c, rfl⟩ := exists_eq_xi_mul_unit hgen
  induction k generalizing u with
  | zero => simp
  | succ k ih =>
    have h1 : (p : 𝔸) ∣ u := by
      have h2 : (p : 𝔸) ∣ xi p * (c * u) := by
        rw [← mul_assoc]
        exact (dvd_pow_self _ (Nat.succ_ne_zero k)).trans h
      have h3 := p_dvd_of_dvd_xi_mul h2
      have h4 : u = ↑c⁻¹ * (c * u) := by rw [← mul_assoc, Units.inv_mul, one_mul]
      rw [h4]
      exact dvd_mul_of_dvd_right h3 _
    obtain ⟨v, rfl⟩ := h1
    have h5 : (p : 𝔸) * (p : 𝔸) ^ k ∣ (p : 𝔸) * (xi p * c * v) := by
      rw [← pow_succ']
      convert h using 1
      ring
    have h6 := (mul_dvd_mul_iff_left (WittVector.p_ne_zero p (PreTilt 𝓞_ℂ_[p] p))).mp h5
    rw [pow_succ']
    exact mul_dvd_mul_left _ (ih h6)

/-- For a generator `w` of the kernel of `θ`, every `a` with `θ(a) = 0` is a multiple of `w`. -/
theorem dvd_of_fontaineTheta_eq_zero
    (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) {a : 𝔸}
    (ha : fontaineTheta 𝓞_ℂ_[p] p a = 0) : w ∣ a := by
  have h : a ∈ RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) := ha
  rw [hgen, mem_span_singleton'] at h
  obtain ⟨b, hb⟩ := h
  exact ⟨b, by rw [← hb, mul_comm]⟩

/-- The map `W(𝓞_ℂ_[p]♭) → W(𝓞_ℂ_[p]♭)[1/p]` is injective. -/
theorem injective_algebraMap_localizationAway : Function.Injective (algebraMap 𝔸 𝔸ₚ) :=
  IsLocalization.injective (M := Submonoid.powers (p : 𝔸)) 𝔸ₚ
    (powers_le_nonZeroDivisors_of_noZeroDivisors (WittVector.p_ne_zero p (PreTilt 𝓞_ℂ_[p] p)))

end Generator

/-! ### Divided powers and their partial sums -/

section DividedPowers

variable (w : WittVector p (PreTilt 𝓞_ℂ_[p] p))

/-- `w^0/0! = 1`. -/
theorem dividedPower_zero : dividedPower w 0 = 1 := by
  simp [dividedPower]

/-- `n!` is a unit in `W(𝓞_ℂ_[p]♭)[1/p]`. -/
theorem isUnit_natCast_factorial (n : ℕ) : IsUnit ((n.factorial : ℕ) : 𝔸ₚ) :=
  isUnit_natCast p (Nat.factorial_ne_zero n)

/-- `n! · (w^n/n!) = w^n`. -/
theorem factorial_mul_dividedPower (n : ℕ) :
    ((n.factorial : ℕ) : 𝔸ₚ) * dividedPower w n = algebraMap 𝔸 𝔸ₚ w ^ n := by
  rw [dividedPower, mul_left_comm, Ring.mul_inverse_cancel _ (isUnit_natCast_factorial n),
    mul_one]

/-- `(n + 1) · (w^{n+1}/(n+1)!) = w · (w^n/n!)`. -/
theorem succ_mul_dividedPower_succ (n : ℕ) :
    ((n + 1 : ℕ) : 𝔸ₚ) * dividedPower w (n + 1) = algebraMap 𝔸 𝔸ₚ w * dividedPower w n := by
  apply (isUnit_natCast_factorial (p := p) n).mul_left_cancel
  calc ((n.factorial : ℕ) : 𝔸ₚ) * (((n + 1 : ℕ) : 𝔸ₚ) * dividedPower w (n + 1))
      = (((n + 1).factorial : ℕ) : 𝔸ₚ) * dividedPower w (n + 1) := by
        rw [Nat.factorial_succ]
        push_cast
        ring
    _ = algebraMap 𝔸 𝔸ₚ w ^ (n + 1) := factorial_mul_dividedPower w (n + 1)
    _ = ((n.factorial : ℕ) : 𝔸ₚ) * (algebraMap 𝔸 𝔸ₚ w * dividedPower w n) := by
        rw [mul_left_comm, factorial_mul_dividedPower, pow_succ']

/-- `(w^a/a!) · (w^b/b!) = C(a + b, a) · (w^{a+b}/(a+b)!)`. -/
theorem dividedPower_mul (a b : ℕ) :
    dividedPower w a * dividedPower w b =
      (((a + b).choose a : ℕ) : 𝔸ₚ) * dividedPower w (a + b) := by
  apply ((isUnit_natCast_factorial (p := p) a).mul
    (isUnit_natCast_factorial (p := p) b)).mul_left_cancel
  have hc := Nat.choose_mul_factorial_mul_factorial (Nat.le_add_right a b)
  rw [Nat.add_sub_cancel_left] at hc
  calc ((a.factorial : ℕ) : 𝔸ₚ) * ((b.factorial : ℕ) : 𝔸ₚ) * (dividedPower w a * dividedPower w b)
      = (((a.factorial : ℕ) : 𝔸ₚ) * dividedPower w a) *
          (((b.factorial : ℕ) : 𝔸ₚ) * dividedPower w b) := by
        ring
    _ = algebraMap 𝔸 𝔸ₚ w ^ (a + b) := by
        rw [factorial_mul_dividedPower, factorial_mul_dividedPower, pow_add]
    _ = (((a + b).factorial : ℕ) : 𝔸ₚ) * dividedPower w (a + b) :=
        (factorial_mul_dividedPower w (a + b)).symm
    _ = ((a.factorial : ℕ) : 𝔸ₚ) * ((b.factorial : ℕ) : 𝔸ₚ) *
          ((((a + b).choose a : ℕ) : 𝔸ₚ) * dividedPower w (a + b)) := by
        rw [← hc]
        push_cast
        ring

/-- The partial sum `Σ_{n<N} aₙ w^n/n!` of the divided-power series of `f = Σ aₙ Xⁿ` at `w`. -/
def dividedPowerSum (f : 𝔸⟦X⟧) (N : ℕ) : 𝔸ₚ :=
  ∑ n ∈ Finset.range N, algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff n f) * dividedPower w n

/-- The value at `w` of the truncation below degree `N` of the divided-power series of `f` is the
partial sum `Σ_{n<N} aₙ w^n/n!`. -/
theorem eval_trunc_dividedPowerSeries (f : 𝔸⟦X⟧) (N : ℕ) :
    (trunc N (dividedPowerSeries p f)).eval (algebraMap 𝔸 𝔸ₚ w) = dividedPowerSum w f N := by
  rw [Polynomial.eval, eval₂_trunc_eq_sum_range]
  refine Finset.sum_congr rfl fun n _ => ?_
  simp only [dividedPowerSeries, PowerSeries.coeff_mk, RingHom.id_apply, dividedPower]
  ring

/-- If `θ(w) = 0`, then modulo the `m`-th power of the kernel of `θ` with `p` inverted, the
value in `BDeRhamPlus 𝓞_ℂ_[p] p` of the divided-power series `Σ aₙ w^n/n!` is its partial sum
below `m`. -/
theorem evalₐ_evalBDeRhamPlus_dividedPowerSeries (hw : fontaineTheta 𝓞_ℂ_[p] p w = 0)
    (f : 𝔸⟦X⟧) (m : ℕ) :
    AdicCompletion.evalₐ 𝕀 m
        (evalBDeRhamPlus p (algebraMap_mem_ker_fontaineThetaInvertP p hw)
          (dividedPowerSeries p f)) =
      Ideal.Quotient.mk _ (dividedPowerSum w f m) := by
  rw [← eval_trunc_dividedPowerSeries]
  exact AdicCompletion.evalₐ_evalPowerSeries _ _ _ m

/-- The empty partial sum vanishes. -/
theorem dividedPowerSum_zero_right (f : 𝔸⟦X⟧) : dividedPowerSum w f 0 = 0 := by
  simp [dividedPowerSum]

/-- `Σ_{n<N+1} aₙ w^n/n! = Σ_{n<N} aₙ w^n/n! + a_N w^N/N!`. -/
theorem dividedPowerSum_succ (f : 𝔸⟦X⟧) (N : ℕ) :
    dividedPowerSum w f (N + 1) =
      dividedPowerSum w f N + algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff N f) * dividedPower w N :=
  Finset.sum_range_succ _ _

/-- The partial sums are additive in the series. -/
theorem dividedPowerSum_add (f g : 𝔸⟦X⟧) (N : ℕ) :
    dividedPowerSum w (f + g) N = dividedPowerSum w f N + dividedPowerSum w g N := by
  simp only [dividedPowerSum, map_add, add_mul, Finset.sum_add_distrib]

/-- The partial sums commute with negation of the series. -/
theorem dividedPowerSum_neg (f : 𝔸⟦X⟧) (N : ℕ) :
    dividedPowerSum w (-f) N = -dividedPowerSum w f N := by
  simp only [dividedPowerSum, map_neg, neg_mul, Finset.sum_neg_distrib]

/-- The partial sums commute with subtraction of series. -/
theorem dividedPowerSum_sub (f g : 𝔸⟦X⟧) (N : ℕ) :
    dividedPowerSum w (f - g) N = dividedPowerSum w f N - dividedPowerSum w g N := by
  rw [sub_eq_add_neg, dividedPowerSum_add, dividedPowerSum_neg, ← sub_eq_add_neg]

/-- The partial sums of the zero series vanish. -/
theorem dividedPowerSum_zero_left (N : ℕ) : dividedPowerSum w 0 N = 0 := by
  simp [dividedPowerSum]

/-- For `N ≤ M`, the difference of the partial sums at `M` and `N` is
`Σ_{N ≤ n < M} aₙ w^n/n!`. -/
theorem dividedPowerSum_sub_dividedPowerSum (f : 𝔸⟦X⟧) {N M : ℕ} (h : N ≤ M) :
    dividedPowerSum w f M - dividedPowerSum w f N =
      ∑ n ∈ Finset.Ico N M, algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff n f) * dividedPower w n := by
  rw [dividedPowerSum, dividedPowerSum, ← Finset.sum_range_add_sum_Ico _ h, add_sub_cancel_left]

/-- If the coefficients `aₙ` vanish for `n ≥ N`, the partial sums are constant from `N` on. -/
theorem dividedPowerSum_eq_of_le {f : 𝔸⟦X⟧} {N M : ℕ} (hNM : N ≤ M)
    (hf : ∀ n, N ≤ n → PowerSeries.coeff n f = 0) :
    dividedPowerSum w f M = dividedPowerSum w f N := by
  rw [← sub_eq_zero, dividedPowerSum_sub_dividedPowerSum w f hNM]
  refine Finset.sum_eq_zero fun n hn => ?_
  rw [hf n (Finset.mem_Ico.mp hn).1, map_zero, zero_mul]

/-- The partial sum below `n + 1` of the monomial `a Xⁿ` is `a w^n/n!`. -/
theorem dividedPowerSum_monomial (n : ℕ) (a : 𝔸) :
    dividedPowerSum w (monomial n a) (n + 1) = algebraMap 𝔸 𝔸ₚ a * dividedPower w n := by
  rw [dividedPowerSum_succ]
  have h0 : dividedPowerSum w (monomial n a) n = 0 := by
    refine Finset.sum_eq_zero fun i hi => ?_
    rw [PowerSeries.coeff_monomial,
      ite_eq_right (by have := Finset.mem_range.mp hi; omega), map_zero, zero_mul]
  rw [h0, zero_add, PowerSeries.coeff_monomial, ite_eq_left rfl]

/-- If `p ^ k` divides the coefficients `aₙ` for `n ∈ s`, then `Σ_{n ∈ s} aₙ w^n/n!` is `p ^ k`
times a sum of the same form. -/
theorem exists_sum_eq_pow_mul_sum {f : 𝔸⟦X⟧} {k : ℕ} (s : Finset ℕ)
    (h : ∀ n ∈ s, (p : 𝔸) ^ k ∣ PowerSeries.coeff n f) :
    ∃ g : 𝔸⟦X⟧,
      ∑ n ∈ s, algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff n f) * dividedPower w n =
        (p : 𝔸ₚ) ^ k * ∑ n ∈ s, algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff n g) * dividedPower w n := by
  classical
  choose! c hc using h
  refine ⟨mk c, ?_⟩
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun n hn => ?_
  rw [hc n hn, PowerSeries.coeff_mk, map_mul, map_pow, map_natCast]
  ring

end DividedPowers

/-! ### `W(𝓞_ℂ_[p]♭)[w^n/n!]` is the set of finite sums `Σ aₙ w^n/n!` -/

section Membership

variable (w : WittVector p (PreTilt 𝓞_ℂ_[p] p))

/-- The divided powers of `w` lie in `W(𝓞_ℂ_[p]♭)[w^n/n!]`. -/
theorem dividedPower_mem (n : ℕ) : dividedPower w n ∈ finiteDividedPowers p w := by
  cases n with
  | zero => rw [dividedPower_zero]; exact Subring.one_mem _
  | succ n => exact Subring.subset_closure (Or.inr ⟨n, rfl⟩)

/-- `W(𝓞_ℂ_[p]♭)` lies in `W(𝓞_ℂ_[p]♭)[w^n/n!]`. -/
theorem algebraMap_mem_finiteDividedPowers (a : 𝔸) :
    algebraMap 𝔸 𝔸ₚ a ∈ finiteDividedPowers p w :=
  Subring.subset_closure (Or.inl ⟨a, rfl⟩)

/-- The partial sums `Σ_{n<N} aₙ w^n/n!` lie in `W(𝓞_ℂ_[p]♭)[w^n/n!]`. -/
theorem dividedPowerSum_mem (f : 𝔸⟦X⟧) (N : ℕ) : dividedPowerSum w f N ∈ finiteDividedPowers p w :=
  Subring.sum_mem _ fun n _ =>
    Subring.mul_mem _ (algebraMap_mem_finiteDividedPowers w _) (dividedPower_mem w n)

/-- Every finite sum `Σ_{n ∈ s} cₙ w^n/n!` with `cₙ ∈ W(𝓞_ℂ_[p]♭)` lies in
`W(𝓞_ℂ_[p]♭)[w^n/n!]`. -/
theorem sum_mul_dividedPower_mem (s : Finset ℕ) (c : ℕ → 𝔸) :
    ∑ n ∈ s, algebraMap 𝔸 𝔸ₚ (c n) * dividedPower w n ∈ finiteDividedPowers p w :=
  Subring.sum_mem _ fun n _ =>
    Subring.mul_mem _ (algebraMap_mem_finiteDividedPowers w _) (dividedPower_mem w n)

/-- `x` is a finite sum `Σ_{n<N} aₙ w^n/n!`, with `aₙ = 0` for `n ≥ N`. -/
private def IsPsum (x : 𝔸ₚ) : Prop :=
  ∃ (f : 𝔸⟦X⟧) (N : ℕ), (∀ n, N ≤ n → PowerSeries.coeff n f = 0) ∧ x = dividedPowerSum w f N

private theorem isPsum_add {x y : 𝔸ₚ} (hx : IsPsum w x) (hy : IsPsum w y) :
    IsPsum w (x + y) := by
  obtain ⟨f, N, hf, rfl⟩ := hx
  obtain ⟨g, M, hg, rfl⟩ := hy
  refine ⟨f + g, max N M, fun n hn => ?_, ?_⟩
  · rw [map_add, hf n (le_of_max_le_left hn), hg n (le_of_max_le_right hn), add_zero]
  · rw [dividedPowerSum_add, dividedPowerSum_eq_of_le w (le_max_left N M) hf,
      dividedPowerSum_eq_of_le w (le_max_right N M) hg]

private theorem isPsum_zero : IsPsum w 0 :=
  ⟨0, 0, fun _ _ => map_zero _, (dividedPowerSum_zero_left w 0).symm⟩

private theorem isPsum_sum (s : Finset ℕ) (g : ℕ → 𝔸ₚ) (h : ∀ i ∈ s, IsPsum w (g i)) :
    IsPsum w (∑ i ∈ s, g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty]; exact isPsum_zero w
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact isPsum_add w (h a (Finset.mem_insert_self a s))
      (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

private theorem isPsum_term (a : 𝔸) (n : ℕ) :
    IsPsum w (algebraMap 𝔸 𝔸ₚ a * dividedPower w n) :=
  ⟨monomial n a, n + 1, fun m hm => by rw [PowerSeries.coeff_monomial, ite_eq_right (by omega)],
    (dividedPowerSum_monomial w n a).symm⟩

private theorem isPsum_neg {x : 𝔸ₚ} (hx : IsPsum w x) : IsPsum w (-x) := by
  obtain ⟨f, N, hf, rfl⟩ := hx
  exact ⟨-f, N, fun n hn => by rw [map_neg, hf n hn, neg_zero], (dividedPowerSum_neg w f N).symm⟩

private theorem isPsum_mul {x y : 𝔸ₚ} (hx : IsPsum w x) (hy : IsPsum w y) :
    IsPsum w (x * y) := by
  obtain ⟨f, N, -, rfl⟩ := hx
  obtain ⟨g, M, -, rfl⟩ := hy
  rw [dividedPowerSum, dividedPowerSum, Finset.sum_mul_sum]
  refine isPsum_sum w _ _ fun i _ => isPsum_sum w _ _ fun j _ => ?_
  have h : algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff i f) * dividedPower w i *
      (algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff j g) * dividedPower w j) =
      algebraMap 𝔸 𝔸ₚ (PowerSeries.coeff i f * PowerSeries.coeff j g * ((i + j).choose i : ℕ)) *
        dividedPower w (i + j) := by
    rw [map_mul, map_mul, map_natCast, mul_mul_mul_comm, dividedPower_mul]
    ring
  rw [h]
  exact isPsum_term w _ _

/-- Every element of `W(𝓞_ℂ_[p]♭)[w^n/n!]` is a finite sum `Σ_{n<N} aₙ w^n/n!` with
`aₙ ∈ W(𝓞_ℂ_[p]♭)` and `aₙ = 0` for `n ≥ N`. -/
theorem exists_dividedPowerSum_of_mem {x : 𝔸ₚ} (hx : x ∈ finiteDividedPowers p w) :
    ∃ (f : 𝔸⟦X⟧) (N : ℕ), (∀ n, N ≤ n → PowerSeries.coeff n f = 0) ∧
      x = dividedPowerSum w f N := by
  change IsPsum w x
  induction hx using Subring.closure_induction with
  | mem x hx =>
    rcases hx with ⟨a, rfl⟩ | ⟨n, rfl⟩
    · have h := isPsum_term w a 0
      rwa [dividedPower_zero, mul_one] at h
    · have h := isPsum_term w 1 (n + 1)
      rwa [map_one, one_mul] at h
  | zero => exact isPsum_zero w
  | one =>
    have h := isPsum_term w 1 0
    rwa [dividedPower_zero, mul_one, map_one] at h
  | add x y _ _ hx hy => exact isPsum_add w hx hy
  | neg x _ hx => exact isPsum_neg w hx
  | mul x y _ _ hx hy => exact isPsum_mul w hx hy

/-- If `θ(w) = 0`, then `w^n/n!` lies in the `m`-th power of the kernel of `θ` with `p` inverted
for `n ≥ m`. -/
theorem dividedPower_mem_ker_pow (hw : fontaineTheta 𝓞_ℂ_[p] p w = 0) {m n : ℕ} (h : m ≤ n) :
    dividedPower w n ∈ 𝕀 ^ m := by
  rw [dividedPower]
  refine Ideal.mul_mem_right _ _ ?_
  rw [← Nat.sub_add_cancel h, pow_add]
  exact Ideal.mul_mem_left _ _
    (Ideal.pow_mem_pow (algebraMap_mem_ker_fontaineThetaInvertP p hw) m)

/-- If `θ(w) = 0` and `m ≤ N`, the difference of the partial sums at `N` and `m` lies in the
`m`-th power of the kernel of `θ` with `p` inverted. -/
theorem dividedPowerSum_sub_mem_ker_pow (hw : fontaineTheta 𝓞_ℂ_[p] p w = 0) (f : 𝔸⟦X⟧)
    {m N : ℕ} (h : m ≤ N) : dividedPowerSum w f N - dividedPowerSum w f m ∈ 𝕀 ^ m := by
  rw [dividedPowerSum_sub_dividedPowerSum w f h]
  exact Ideal.sum_mem _ fun n hn =>
    Ideal.mul_mem_left _ _ (dividedPower_mem_ker_pow w hw (Finset.mem_Ico.mp hn).1)

end Membership

end PadicComplexInt
