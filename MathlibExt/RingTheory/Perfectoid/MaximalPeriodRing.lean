public import MathlibExt.RingTheory.Perfectoid.DeRhamPeriodRingGalois
public import MathlibExt.RingTheory.Perfectoid.PeriodRingLog

/-!
# The period rings `A_max`, `B_max^+` and `B_max`

Let `p` be a prime, and write `ξ = p - [p♭]` and `β = ξ/p`. Following Colmez and Berger, `A_max`
is the subring of `B_dR^+ = BDeRhamPlus 𝓞_ℂ_[p] p` of the values `Σ aₙ βⁿ` of the series with
coefficients `aₙ ∈ W(𝓞_ℂ_[p]♭)` tending to `0` `p`-adically (`PadicComplexInt.aMax`).
`B_max^+ = A_max[1/p]` (`PadicComplexInt.bMaxPlus`) is the `ℚ_[p]`-subalgebra of
`B_dR = BDeRham 𝓞_ℂ_[p] p` generated by `A_max`, and `B_max` (`PadicComplexInt.bMax`) is the one
generated by `A_max` and the inverses of the nonzero periods `log [ε]`, `ε♯ = 1` (those with
`ε ≠ 1`). This `B_max` is `B_max^+[1/t]` (Berger, §1.2), since every such `log [ε]` is a nonzero
`ℤ_p`-multiple of `t` (Fontaine, Exposé II, §1.5.4, cf. §4.3.3); that equality is not proved in
this file. We show:

* `log [ε] ∈ A_max` for `ε♯ = 1` (`PadicComplexInt.logTeichmuller_mem_aMax`): if
  `[ε] - 1 = ξ c`, then `log [ε] = Σ_{n ≥ 1} (-1)^(n+1) (pⁿ/n) cⁿ βⁿ` with `pⁿ/n → 0` in `ℤ_p`;
* `A_max`, `B_max^+` and `B_max` are stable under `Gal(ℚ̄_p/ℚ_p)`
  (`PadicComplexInt.galoisBDeRhamPlus_mem_aMax`, `PadicComplexInt.bMaxPlus_le_comap`,
  `PadicComplexInt.bMax_le_comap`), by the naturality of the evaluation of power series along
  the maps of adic completions induced by ring maps (`AdicCompletion.mapRingHom_evalPowerSeries`);
* `σ(log [p̃]) = log [p̃] + log [u_σ]` with `σ(p̃) = p̃ u_σ` and `u_σ♯ = 1`
  (`PadicComplexInt.galoisBDeRhamPlus_logPTilde`), by the additivity of the logarithm.

References: L. Berger, *Représentations p-adiques et équations différentielles*, Invent. Math.
148 (2002), §1.2 (the rings `B_max^+ = {Σ aₙ ωⁿ/pⁿ}` and `B_max = B_max^+[1/t]` of Colmez, where
`ω` may be replaced by any generator of `ker θ`, such as `ξ`); J.-M. Fontaine, *Le corps des
périodes p-adiques*, Astérisque 223 (1994), Exposé II, §4.3.2 p. 88 (the ring
`S = W(R)⟦β⟧ ⊇ A_max`) and §4.3.3 pp. 88–89 (the action on `log [p̃]`).
-/

@[expose] public noncomputable section

open Ideal WittVector PowerSeries MathlibExt.AlgebraicGeometry.HodgeTateComparison

namespace AdicCompletion

/-- **Naturality of the evaluation**: for commutative rings `A` and `B`, ideals `I` of `A` and `J`
of `B`, and a ring map `g : A →+* B` with `I.map g ≤ J`, the map of completions
`mapRingHom I J g h` sends the value of a series `f` over `A` at `x ∈ I` to the value of the series
`f.map g` at `g x ∈ J`. -/
theorem mapRingHom_evalPowerSeries {A B : Type*} [CommRing A] [CommRing B] (I : Ideal A)
    (J : Ideal B) (g : A →+* B) (h : I.map g ≤ J) {x : A} (hx : x ∈ I) (f : A⟦X⟧) :
    mapRingHom I J g h (evalPowerSeries I hx f) =
      evalPowerSeries J (h (Ideal.mem_map_of_mem g hx)) (PowerSeries.map g f) :=
  ext_evalₐ fun n => by
    rw [evalₐ_mapRingHom, evalₐ_evalPowerSeries, evalₐ_evalPowerSeries,
      MathlibExt.RingTheory.AdicCompletionMaps.quotientMap_mk, trunc_map, Polynomial.eval_map,
      Polynomial.eval₂_at_apply]

end AdicCompletion

namespace PadicComplexInt

variable (p : ℕ) [hp : Fact p.Prime]

local notation "𝔸" => WittVector p (PreTilt 𝓞_ℂ_[p] p)
local notation "𝔸ₚ" => Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))
local notation "𝔹⁺" => BDeRhamPlus 𝓞_ℂ_[p] p
local notation "𝔹" => BDeRham 𝓞_ℂ_[p] p
local notation "𝕀" => RingHom.ker (fontaineThetaInvertP 𝓞_ℂ_[p] p)

/-! ### The rings -/

/-- **`A_max`**: the subring of `B_dR^+` of the values `Σ aₙ (ξ/p)ⁿ` of the series `Σ aₙ Xⁿ` with
coefficients `aₙ ∈ W(𝓞_ℂ_[p]♭)` tending to `0` `p`-adically. -/
def aMax : Subring 𝔹⁺ :=
  (restrictedPowerSeries p).map
    ((evalBDeRhamPlus p (xiDivP_mem_ker p)).comp (PowerSeries.map (algebraMap 𝔸 𝔸ₚ)))

/-- **`B_max^+ = A_max[1/p]`**: the `ℚ_[p]`-subalgebra of `B_dR` generated by `A_max`. -/
def bMaxPlus : Subalgebra ℚ_[p] 𝔹 :=
  Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aMax p)

/-- **`B_max`**, for a prime `p`: the `ℚ_[p]`-subalgebra of `B_dR` generated by the image of
`A_max` and the inverses of the periods `log [ε]` for `ε ∈ 𝓞_ℂ_[p]♭` with `ε♯ = 1` and `ε ≠ 1`,
which are the nonzero `log [ε]` (`PadicComplexInt.logTeichmuller_ne_zero`). This is
`B_max^+[1/t]` (Berger, §1.2), since every such `log [ε]` is a nonzero `ℤ_p`-multiple of `t`
(Fontaine, Exposé II, §1.5.4, cf. §4.3.3); that equality is not proved in this file. -/
def bMax : Subalgebra ℚ_[p] 𝔹 :=
  Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aMax p ∪
    {z | ∃ (ε : PreTilt 𝓞_ℂ_[p] p) (h : ε.untilt = 1), ε ≠ 1 ∧
      z = (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h))⁻¹})

/-- `B_max^+ ⊆ B_max`. -/
theorem bMaxPlus_le_bMax : bMaxPlus p ≤ bMax p :=
  Algebra.adjoin_mono Set.subset_union_left

/-- Membership in `restrictedPowerSeries p`, unfolded. -/
theorem mem_restrictedPowerSeries {f : 𝔸⟦X⟧} :
    f ∈ restrictedPowerSeries p ↔ ∀ k : ℕ, ∃ N : ℕ, ∀ n ≥ N, (p : 𝔸) ^ k ∣ coeff n f :=
  Iff.rfl

/-- The image of `W(𝓞_ℂ_[p]♭)` in `B_dR^+` lies in `A_max`. -/
theorem algebraMap_mem_aMax (w : 𝔸) : algebraMap 𝔸 𝔹⁺ w ∈ aMax p := by
  refine Subring.mem_map.2 ⟨C w, (mem_restrictedPowerSeries p).2 fun k => ⟨1, fun n hn => ?_⟩, ?_⟩
  · rw [PowerSeries.coeff_C, ite_eq_right (by omega)]
    exact dvd_zero _
  · rw [RingHom.comp_apply, PowerSeries.map_C]
    exact AdicCompletion.evalPowerSeries_C _ _ _

/-- The image of `A_max` in `B_dR` lies in `B_max`. -/
theorem algebraMap_mem_bMax {y : 𝔹⁺} (hy : y ∈ aMax p) : algebraMap 𝔹⁺ 𝔹 y ∈ bMax p :=
  Algebra.subset_adjoin (Or.inl ⟨y, hy, rfl⟩)

/-- For `n ≠ 0`, `pⁿ = e n` with `e ∈ ℤ_[p]` divisible by `p ^ (n - v)`, where `p ^ v ≤ n`. -/
private theorem exists_logCoeff (n : ℕ) (hn : n ≠ 0) :
    ∃ (e : ℤ_[p]) (v : ℕ), (e : ℚ_[p]) * n = (p : ℚ_[p]) ^ n ∧ p ^ v ≤ n ∧
      (p : ℤ_[p]) ^ (n - v) ∣ e := by
  obtain ⟨v, m, hpm, rfl⟩ := Nat.exists_eq_pow_mul_and_not_dvd hn p hp.out.ne_one
  have hm0 : m ≠ 0 := by rintro rfl; exact hpm (dvd_zero p)
  have hu : IsUnit (m : ℤ_[p]) := PadicInt.isUnit_iff.mpr
    (PadicInt.norm_natCast_eq_one_iff.mpr ((Nat.Prime.coprime_iff_not_dvd hp.out).mpr hpm))
  have hvle : p ^ v ≤ p ^ v * m := Nat.le_mul_of_pos_right _ (Nat.pos_of_ne_zero hm0)
  have hv : v ≤ p ^ v * m := le_trans (Nat.lt_pow_self hp.out.one_lt).le hvle
  refine ⟨(p : ℤ_[p]) ^ (p ^ v * m - v) * ((hu.unit⁻¹ : ℤ_[p]ˣ) : ℤ_[p]), v, ?_, hvle,
    Dvd.intro _ rfl⟩
  have hum : (((hu.unit⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) * (m : ℚ_[p]) = 1 := by
    have := congrArg (fun z : ℤ_[p] => (z : ℚ_[p])) hu.val_inv_mul
    rwa [PadicInt.coe_mul, PadicInt.coe_natCast, PadicInt.coe_one] at this
  push_cast
  calc ((p : ℚ_[p]) ^ (p ^ v * m - v) * (((hu.unit⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p])) *
        ((p : ℚ_[p]) ^ v * (m : ℚ_[p]))
      = (p : ℚ_[p]) ^ (p ^ v * m - v) * (p : ℚ_[p]) ^ v *
          ((((hu.unit⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) * (m : ℚ_[p])) := by ring
    _ = (p : ℚ_[p]) ^ (p ^ v * m) := by rw [hum, mul_one, ← pow_add, Nat.sub_add_cancel hv]

/-- If `2 k ≤ n` and `p ^ v ≤ n`, then `k + v ≤ n`. -/
private theorem add_le_of_two_mul_le (k n v : ℕ) (hn : 2 * k ≤ n) (hv : p ^ v ≤ n) :
    k + v ≤ n := by
  by_contra h
  have h2 : 2 ^ v ≤ p ^ v := Nat.pow_le_pow_left hp.out.two_le v
  have hm : n - k + 1 ≤ v := by omega
  have h3 : 2 ^ (n - k + 1) ≤ 2 ^ v := Nat.pow_le_pow_right (by norm_num) hm
  have h4 : n - k < 2 ^ (n - k) := Nat.lt_two_pow_self
  rw [pow_succ] at h3
  omega

/-- The coefficient `pⁿ/n ∈ ℤ_[p]` of the logarithm, `0` for `n = 0`. -/
private def logCoeff (n : ℕ) : ℤ_[p] :=
  if hn : n = 0 then 0 else Classical.choose (exists_logCoeff p n hn)

/-- `logCoeff p n · n = pⁿ`, and `p ^ k` divides `logCoeff p n` for `2 k ≤ n`. -/
private theorem logCoeff_spec {n : ℕ} (hn : n ≠ 0) :
    (logCoeff p n : ℚ_[p]) * n = (p : ℚ_[p]) ^ n ∧
      ∀ k, 2 * k ≤ n → (p : ℤ_[p]) ^ k ∣ logCoeff p n := by
  obtain ⟨v, h1, h2, h3⟩ := Classical.choose_spec (exists_logCoeff p n hn)
  rw [logCoeff, dite_eq_right hn]
  refine ⟨h1, fun k hk => dvd_trans (pow_dvd_pow _ ?_) h3⟩
  have := add_le_of_two_mul_le p k n v hk h2
  omega

/-- **`log [ε] ∈ A_max`** for `ε ∈ 𝓞_ℂ_[p]♭` with `ε♯ = 1`. -/
theorem logTeichmuller_mem_aMax {ε : PreTilt 𝓞_ℂ_[p] p} (h : ε.untilt = 1) :
    logTeichmuller p h ∈ aMax p := by
  have hk : teichmuller p ε - 1 ∈ RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) := by
    rw [RingHom.mem_ker, map_sub, map_one, fontaineTheta_teichmuller, h, sub_self]
  rw [ker_fontaineTheta_eq_span_xi, Ideal.mem_span_singleton'] at hk
  obtain ⟨c, hc⟩ := hk
  refine Subring.mem_map.2 ⟨PowerSeries.mk fun n =>
    if n = 0 then 0 else (-1) ^ (n + 1) * padicIntToAinf p (logCoeff p n) * c ^ n,
    (mem_restrictedPowerSeries p).2 fun k => ⟨2 * k + 1, fun n hn => ?_⟩, ?_⟩
  · rw [PowerSeries.coeff_mk, ite_eq_right (by omega)]
    obtain ⟨d, hd⟩ := (logCoeff_spec p (show n ≠ 0 by omega)).2 k (by omega)
    refine Dvd.dvd.mul_right (Dvd.dvd.mul_left ⟨padicIntToAinf p d, ?_⟩ _) _
    rw [hd, map_mul, map_pow, map_natCast]
  rw [RingHom.comp_apply, logTeichmuller, logOneAdd, evalBDeRhamPlus, evalBDeRhamPlus]
  refine AdicCompletion.evalPowerSeries_eq_of_coeff_mul_pow_eq _ _ _ _ _ fun n => ?_
  rw [PowerSeries.coeff_map, PowerSeries.coeff_mk, coeff_logSeries]
  by_cases hn : n = 0
  · simp [hn]
  rw [ite_eq_right hn, ite_eq_right hn, ← hc]
  have key : ((n : ℚ_[p]))⁻¹ = (logCoeff p n : ℚ_[p]) * ((p : ℚ_[p])⁻¹) ^ n := by
    have h1 := (logCoeff_spec p hn).1
    have hp' : (p : ℚ_[p]) ≠ 0 := Nat.cast_ne_zero.mpr hp.out.ne_zero
    have he : (logCoeff p n : ℚ_[p]) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at h1
      exact pow_ne_zero _ hp' h1.symm
    rw [inv_pow, ← h1, mul_inv, ← mul_assoc, mul_inv_cancel₀ he, one_mul]
  have hq : algebraMap ℚ_[p] 𝔸ₚ (logCoeff p n : ℚ_[p]) =
      algebraMap 𝔸 𝔸ₚ (padicIntToAinf p (logCoeff p n)) :=
    padicToLocalizationAway_coe p _
  rw [key]
  simp only [map_mul, map_pow, map_neg, map_one]
  rw [← hq, xiDivP]
  ring

/-! ### Galois stability -/

/-- The action of `σ ∈ Gal(ℚ̄_p/ℚ_p)` on `W(𝓞_ℂ_[p]♭)[1/p]`, induced by `integralGalois p σ`. -/
abbrev galoisLocalization (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) : 𝔸ₚ →+* 𝔸ₚ :=
  Localization.awayMapNatCast (WittVector.map (PreTilt.map p (integralGalois p σ).toRingHom)) p

/-- The action on `W(𝓞_ℂ_[p]♭)[1/p]` preserves the kernel of `θ`. -/
theorem galoisLocalization_mem_ker (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) {y : 𝔸ₚ}
    (hy : y ∈ 𝕀) : galoisLocalization p σ y ∈ 𝕀 :=
  ker_fontaineThetaInvertP_le_comap p (integralGalois p σ).toRingHom hy

/-- A map of `W(𝓞_ℂ_[p]♭)[1/p]` induced by a ring map of the tilt fixes the logarithm series. -/
private theorem map_logSeries (f : PreTilt 𝓞_ℂ_[p] p →+* PreTilt 𝓞_ℂ_[p] p) :
    PowerSeries.map (Localization.awayMapNatCast (WittVector.map f) p) (logSeries p) =
      logSeries p := by
  have h : (Localization.awayMapNatCast (WittVector.map f) p).comp (algebraMap ℚ_[p] 𝔸ₚ) =
      algebraMap ℚ_[p] 𝔸ₚ :=
    RingHom.ext (awayMapNatCast_algebraMap_padic p f)
  rw [logSeries, ← RingHom.comp_apply, ← PowerSeries.map_comp, h]

/-- `σ(Σ aₖ xᵏ) = Σ σ(aₖ) σ(x)ᵏ` in `B_dR^+`. -/
theorem galoisBDeRhamPlus_evalBDeRhamPlus (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p)
    {x : 𝔸ₚ} (hx : x ∈ 𝕀) (f : 𝔸ₚ⟦X⟧) :
    galoisBDeRhamPlus p σ (evalBDeRhamPlus p hx f) =
      evalBDeRhamPlus p (galoisLocalization_mem_ker p σ hx)
        (PowerSeries.map (galoisLocalization p σ) f) := by
  change (galoisBDeRhamPlus p σ : 𝔹⁺ →+* 𝔹⁺) (evalBDeRhamPlus p hx f) = _
  rw [galoisBDeRhamPlus_toRingHom]
  exact AdicCompletion.mapRingHom_evalPowerSeries _ _ _ _ hx f

/-- `σ(log(1 + y)) = log(1 + σ(y))`. -/
private theorem galoisBDeRhamPlus_logOneAdd (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) {y : 𝔸ₚ}
    (hy : y ∈ 𝕀) :
    galoisBDeRhamPlus p σ (logOneAdd p hy) = logOneAdd p (galoisLocalization_mem_ker p σ hy) := by
  rw [logOneAdd, galoisBDeRhamPlus_evalBDeRhamPlus, map_logSeries]
  rfl

/-- `σ(ξ) = ξ c` for some `c ∈ W(𝓞_ℂ_[p]♭)`, since `σ(ξ) ∈ ker θ = (ξ)`. -/
private theorem exists_map_xi_eq_mul (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) :
    ∃ c : 𝔸, WittVector.map (PreTilt.map p (integralGalois p σ).toRingHom) (xi p) = xi p * c := by
  have hk : WittVector.map (PreTilt.map p (integralGalois p σ).toRingHom) (xi p) ∈
      RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) := by
    rw [RingHom.mem_ker, WittVector.fontaineTheta_map, fontaineTheta_xi, map_zero]
  rw [ker_fontaineTheta_eq_span_xi, Ideal.mem_span_singleton] at hk
  exact hk

/-- The coefficientwise image of a restricted power series under a ring endomorphism of
`W(𝓞_ℂ_[p]♭)` is restricted. -/
theorem map_mem_restrictedPowerSeries (g : 𝔸 →+* 𝔸) {f : 𝔸⟦X⟧}
    (hf : f ∈ restrictedPowerSeries p) : PowerSeries.map g f ∈ restrictedPowerSeries p := by
  refine (mem_restrictedPowerSeries p).2 fun k => ?_
  obtain ⟨N, hN⟩ := (mem_restrictedPowerSeries p).1 hf k
  refine ⟨N, fun n hn => ?_⟩
  rw [PowerSeries.coeff_map]
  have := map_dvd g (hN n hn)
  rwa [map_pow, map_natCast] at this

/-- For `c ∈ W(𝓞_ℂ_[p]♭)`, `Σ cⁿ aₙ Xⁿ` is restricted if `Σ aₙ Xⁿ` is. -/
theorem rescale_mem_restrictedPowerSeries (c : 𝔸) {f : 𝔸⟦X⟧}
    (hf : f ∈ restrictedPowerSeries p) : rescale c f ∈ restrictedPowerSeries p := by
  refine (mem_restrictedPowerSeries p).2 fun k => ?_
  obtain ⟨N, hN⟩ := (mem_restrictedPowerSeries p).1 hf k
  refine ⟨N, fun n hn => ?_⟩
  rw [PowerSeries.coeff_rescale]
  exact Dvd.dvd.mul_left (hN n hn) _

/-- `σ(log [ε]) = log [σ ε]` for `ε♯ = 1`. -/
theorem galoisBDeRhamPlus_logTeichmuller (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p)
    {ε : PreTilt 𝓞_ℂ_[p] p} (h : ε.untilt = 1)
    (h' : (PreTilt.map p (integralGalois p σ).toRingHom ε).untilt = 1) :
    galoisBDeRhamPlus p σ (logTeichmuller p h) = logTeichmuller p h' := by
  rw [logTeichmuller, galoisBDeRhamPlus_logOneAdd]
  refine logOneAdd_congr p _ _ ?_
  simp only [Localization.awayMapNatCast_algebraMap, map_sub, map_one, WittVector.map_teichmuller]

/-- **`A_max` is stable under `Gal(ℚ̄_p/ℚ_p)`.** -/
theorem galoisBDeRhamPlus_mem_aMax (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) {y : 𝔹⁺}
    (hy : y ∈ aMax p) : galoisBDeRhamPlus p σ y ∈ aMax p := by
  obtain ⟨f, hf, rfl⟩ := Subring.mem_map.1 hy
  obtain ⟨c, hc⟩ := exists_map_xi_eq_mul p σ
  refine Subring.mem_map.2 ⟨rescale c (PowerSeries.map (WittVector.map
      (PreTilt.map p (integralGalois p σ).toRingHom)) f),
    rescale_mem_restrictedPowerSeries p c (map_mem_restrictedPowerSeries p _ hf), ?_⟩
  rw [RingHom.comp_apply, RingHom.comp_apply, galoisBDeRhamPlus_evalBDeRhamPlus]
  refine AdicCompletion.evalPowerSeries_eq_of_coeff_mul_pow_eq _ _ _ _ _ fun k => ?_
  simp only [PowerSeries.coeff_map, PowerSeries.coeff_rescale,
    Localization.awayMapNatCast_algebraMap, xiDivP, map_mul, map_pow,
    awayMapNatCast_algebraMap_padic, hc]
  ring

/-- **`B_max^+` is stable under `Gal(ℚ̄_p/ℚ_p)`.** -/
theorem bMaxPlus_le_comap (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) :
    bMaxPlus p ≤ (bMaxPlus p).comap (galoisBDeRham p σ) := by
  rw [bMaxPlus, Algebra.adjoin_le_iff]
  rintro _ ⟨y, hy, rfl⟩
  rw [SetLike.mem_coe, Subalgebra.mem_comap, galoisBDeRham_algebraMap]
  exact Algebra.subset_adjoin ⟨_, galoisBDeRhamPlus_mem_aMax p σ hy, rfl⟩

/-- **`B_max` is stable under `Gal(ℚ̄_p/ℚ_p)`.** -/
theorem bMax_le_comap (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) :
    bMax p ≤ (bMax p).comap (galoisBDeRham p σ) := by
  rw [bMax, Algebra.adjoin_le_iff]
  rintro _ (⟨y, hy, rfl⟩ | ⟨ε, h, hne, rfl⟩)
  · rw [SetLike.mem_coe, Subalgebra.mem_comap, galoisBDeRham_algebraMap]
    exact Algebra.subset_adjoin (Or.inl ⟨_, galoisBDeRhamPlus_mem_aMax p σ hy, rfl⟩)
  · have h' : (PreTilt.map p (integralGalois p σ).toRingHom ε).untilt = 1 := by
      rw [PreTilt.untilt_map, h, map_one]
    rw [SetLike.mem_coe, Subalgebra.mem_comap, map_inv₀, galoisBDeRham_algebraMap,
      galoisBDeRhamPlus_logTeichmuller p σ h h']
    refine Algebra.subset_adjoin (Or.inr ⟨_, h', fun h1 => hne ?_, rfl⟩)
    exact preTiltMap_integralGalois_injective p σ (by rw [h1, map_one])

/-! ### The action on `log [p̃]` -/

/-- `σ(p̃) = p̃ · u` with `u♯ = 1`, for `σ ∈ Gal(ℚ̄_p/ℚ_p)` acting on the tilt. -/
theorem exists_preTiltMap_pFlat_eq_mul (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) :
    ∃ u : PreTilt 𝓞_ℂ_[p] p,
      PreTilt.map p (integralGalois p σ).toRingHom (pFlat p) = pFlat p * u ∧ u.untilt = 1 := by
  have hσp : (PreTilt.map p (integralGalois p σ).toRingHom (pFlat p)).untilt = p := by
    rw [PreTilt.untilt_map, untilt_pFlat, map_natCast]
  obtain ⟨u, hu⟩ := dvd_of_coeff_zero_eq_zero p (pFlat p) (untilt_pFlat p)
    (PreTilt.map p (integralGalois p σ).toRingHom (pFlat p)) (by
      rw [← PreTilt.mk_untilt_eq_coeff_zero, hσp]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _))
  refine ⟨u, hu, ?_⟩
  have h1 : (p : 𝓞_ℂ_[p]) * (u.untilt - 1) = 0 := by
    have := congrArg (fun x => PreTilt.untilt x) hu
    simp only [hσp, map_mul, untilt_pFlat] at this
    linear_combination -this
  exact sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hp.out.ne_zero))

/-- **`σ(log [p̃]) = log [p̃] + log [u]`** in `B_dR^+`, where `σ(p̃) = p̃ · u` and `u♯ = 1`. -/
theorem galoisBDeRhamPlus_logPTilde (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p)
    {u : PreTilt 𝓞_ℂ_[p] p}
    (hu : PreTilt.map p (integralGalois p σ).toRingHom (pFlat p) = pFlat p * u)
    (hu1 : u.untilt = 1) :
    galoisBDeRhamPlus p σ (logPTilde p) = logTeichmuller p hu1 + logPTilde p := by
  have hy := algebraMap_teichmuller_sub_one_mem_ker p hu1
  have hz := neg_mem (xiDivP_mem_ker p)
  have hq : (p : 𝔸ₚ) * algebraMap ℚ_[p] 𝔸ₚ (p : ℚ_[p])⁻¹ = 1 := by
    rw [← map_natCast (algebraMap ℚ_[p] 𝔸ₚ) p, ← map_mul,
      mul_inv_cancel₀ (Nat.cast_ne_zero.mpr hp.out.ne_zero), map_one]
  rw [logPTilde, galoisBDeRhamPlus_logOneAdd]
  refine (logOneAdd_congr p _ (add_mem (add_mem hy hz) (Ideal.mul_mem_left _ _ hz)) ?_).trans
    (logOneAdd_add p hy hz _)
  simp only [xiDivP, xi, map_neg, map_mul, map_sub, map_natCast,
    Localization.awayMapNatCast_algebraMap, awayMapNatCast_algebraMap_padic,
    WittVector.map_teichmuller, hu, map_one]
  linear_combination (algebraMap 𝔸 𝔸ₚ (teichmuller p u) - 1) * hq

end PadicComplexInt
