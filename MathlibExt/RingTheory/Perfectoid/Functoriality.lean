module

public import Mathlib.RingTheory.Perfectoid.BDeRham
public import MathlibExt.RingTheory.AdicCompletionMaps

/-!
# Functoriality of tilts, `A_inf`, Fontaine's `θ`, `B_dR^+` and `B_dR`

Let `p` be a prime and `f : R →+* S` a ring map. This file constructs the maps that `f` induces
on the rings of Mathlib's `Mathlib.RingTheory.Perfectoid` files, and shows that Fontaine's `θ`
commutes with them.

* `ModP.map p f : R ⧸ p → S ⧸ p` is `Ideal.quotientMap`, and the map of tilts
  `PreTilt.map p f : R♭ → S♭` is `Perfection.map p (ModP.map p f)`. For `p`-adically complete
  `R` and `S` it commutes with the untilt maps (`PreTilt.untilt_map`).
* On `A_inf = W(R♭)` the map is `WittVector.map (PreTilt.map p f)`, and Fontaine's `θ` is
  natural: `θ_S ∘ W(f♭) = f ∘ θ_R` (`WittVector.fontaineTheta_comp_map`). Both sides are ring maps
  to the `p`-adically separated ring `S`, and they agree modulo every `p ^ n`: modulo `p ^ n`,
  where `p` is nilpotent, ring maps out of `W(R♭)` are determined by their values on
  Teichmüller representatives, and there both sides give `f (x♯)`.
* `Localization.awayMapNatCast f n : A[1/n] → B[1/n]` is `IsLocalization.map` along `f`. With
  `p` inverted, the naturality of `θ` becomes that of `fontaineThetaInvertP`
  (`fontaineThetaInvertP_comp_awayMapNatCast`), so the map on `W(R♭)[1/p]` maps `ker θ` into
  `ker θ` (`ker_fontaineThetaInvertP_le_comap`).
* `AdicCompletion.mapRingHom I J f h : Â_I → B̂_J`, for `I.map f ≤ J`, is the lift
  (`AdicCompletion.liftRingHom`) of the maps `Â_I → A ⧸ I ^ n → B ⧸ J ^ n`, whose second factor
  is `MathlibExt.RingTheory.AdicCompletionMaps.quotientMap`. Applied to the `(ker θ)`-adic
  completions, it gives `BDeRhamPlus.map p f : B_dR^+(R) → B_dR^+(S)`, which extends the map on
  `W(R♭)[1/p]` (`BDeRhamPlus.map_algebraMap`) for the `W(R♭)[1/p]`-algebra structure of the
  completion (`BDeRhamPlus.instAlgebra`).
* Mathlib's `BDeRham R p` is the localization of `B_dR^+(R)` at the submonoid generated by the
  images of the generators of `ker θ` (`BDeRham.submonoid`); here it gets the ring structure of
  that localization. A ring isomorphism `e : R ≃+* S` maps `ker θ` onto `ker θ`
  (`map_ker_fontaineThetaInvertP`), hence generators to generators, and so induces
  `BDeRham.mapOfRingEquiv p e : B_dR(R) → B_dR(S)`.
-/

@[expose] public noncomputable section

open MathlibExt.RingTheory

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]

/-! ### The maps on `R ⧸ p` and on tilts -/

namespace ModP

variable (p : ℕ)

/-- The ring map `R ⧸ p → S ⧸ p` induced by a ring map `f : R →+* S`. -/
def map (f : R →+* S) : ModP R p →+* ModP S p :=
  Ideal.quotientMap _ f <| by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, map_natCast]
    exact Ideal.mem_span_singleton_self _

/-- `ModP.map p f` maps the class of `x` to the class of `f x`. -/
@[simp]
theorem map_mk (f : R →+* S) (x : R) :
    map p f (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (f x) :=
  rfl

/-- `ModP.map p` maps the identity of `R` to the identity of `R ⧸ p`. -/
@[simp]
theorem map_id : map p (RingHom.id R) = RingHom.id (ModP R p) := by
  ext x
  rfl

/-- `ModP.map p` maps a composite of ring maps to the composite of their maps. -/
theorem map_comp (g : S →+* T) (f : R →+* S) :
    map p (g.comp f) = (map p g).comp (map p f) := by
  ext x
  rfl

end ModP

namespace PreTilt

variable (p : ℕ) [Fact p.Prime] [Fact ¬IsUnit (p : R)] [Fact ¬IsUnit (p : S)]
  [Fact ¬IsUnit (p : T)]

/-- The ring map of tilts `R♭ → S♭` induced by a ring map `f : R →+* S`: the map of perfections
of the ring map `R ⧸ p → S ⧸ p` induced by `f`. -/
def map (f : R →+* S) : PreTilt R p →+* PreTilt S p :=
  Perfection.map p (ModP.map p f)

/-- The `n`-th coefficient of `PreTilt.map p f x` is the image under `ModP.map p f` of the
`n`-th coefficient of `x`. -/
@[simp]
theorem coeff_map (f : R →+* S) (x : PreTilt R p) (n : ℕ) :
    coeff n (map p f x) = ModP.map p f (coeff n x) :=
  rfl

/-- `PreTilt.map p` maps the identity of `R` to the identity of `R♭`. -/
@[simp]
theorem map_id : map p (RingHom.id R) = RingHom.id (PreTilt R p) :=
  RingHom.ext fun x => Perfection.ext fun n => by
    change ModP.map p (RingHom.id R) (Perfection.coeff _ p n x) = _
    rw [ModP.map_id]
    rfl

/-- `PreTilt.map p` maps a composite of ring maps to the composite of their maps. -/
theorem map_comp (g : S →+* T) (f : R →+* S) :
    map p (g.comp f) = (map p g).comp (map p f) :=
  RingHom.ext fun x => Perfection.ext fun n => by
    change ModP.map p (g.comp f) (Perfection.coeff _ p n x) = _
    rw [ModP.map_comp]
    rfl

variable [IsAdicComplete (Ideal.span {(p : R)}) R] [IsAdicComplete (Ideal.span {(p : S)}) S]

/-- The untilt maps commute with the maps of rings and of tilts: `(f♭ x)♯ = f (x♯)` for a ring
map `f : R →+* S` of `p`-adically complete rings and `x ∈ R♭`. -/
@[simp]
theorem untilt_map (f : R →+* S) (x : PreTilt R p) : (map p f x).untilt = f x.untilt := by
  refine Perfection.teichmuller_spec fun n => ?_
  obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (Perfection.coeff _ p n x)
  refine ⟨f w, congrArg (ModP.map p f) hw, ?_⟩
  have h := Perfection.teichmuller_sModEq (p := p) (I := Ideal.span {(p : R)}) (x := x) (y := w) hw
  rw [SModEq.sub_mem] at h ⊢
  have h' := Ideal.mem_map_of_mem f h
  rw [Ideal.map_pow, Ideal.map_span, Set.image_singleton, map_natCast, map_sub, map_pow] at h'
  have h'' := neg_mem h'
  rw [neg_sub] at h''
  exact h''

end PreTilt

/-! ### Naturality of Fontaine's `θ` -/

namespace WittVector

/-- `WittVector.map` maps a composite of ring maps to the composite of their maps. -/
theorem map_comp {p : ℕ} [Fact p.Prime] (g : S →+* T) (f : R →+* S) :
    WittVector.map (p := p) (g.comp f) = (WittVector.map g).comp (WittVector.map f) :=
  RingHom.ext fun x => WittVector.ext fun n => by
    simp only [WittVector.map_coeff, RingHom.comp_apply]

variable (p : ℕ) [Fact p.Prime] [Fact ¬IsUnit (p : R)] [Fact ¬IsUnit (p : S)]
  [IsAdicComplete (Ideal.span {(p : R)}) R] [IsAdicComplete (Ideal.span {(p : S)}) S]

/-- **Naturality of Fontaine's `θ`**: for a ring map `f : R →+* S` of `p`-adically complete
rings, `θ_S ∘ W(f♭) = f ∘ θ_R` as ring maps `W(R♭) → S`. -/
theorem fontaineTheta_comp_map (f : R →+* S) :
    (fontaineTheta S p).comp (map (PreTilt.map p f)) = f.comp (fontaineTheta R p) := by
  refine RingHom.ext fun x => (IsHausdorff.eq_iff_smodEq (I := Ideal.span {(p : S)})).2 fun n => ?_
  rw [smul_eq_mul, Ideal.mul_top, SModEq.idealQuotientMk]
  have key : (Ideal.Quotient.mk (Ideal.span {(p : S)} ^ n)).comp
      ((fontaineTheta S p).comp (map (PreTilt.map p f))) =
      (Ideal.Quotient.mk (Ideal.span {(p : S)} ^ n)).comp (f.comp (fontaineTheta R p)) := by
    refine eq_of_apply_teichmuller_eq _ _ ⟨n, ?_⟩ fun y => ?_
    · rw [← map_natCast (Ideal.Quotient.mk (Ideal.span {(p : S)} ^ n)), ← map_pow,
        Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow]
      exact Ideal.mem_span_singleton_self _
    · simp only [RingHom.comp_apply, map_teichmuller, fontaineTheta_teichmuller,
        PreTilt.untilt_map]
  exact RingHom.congr_fun key x

/-- **Naturality of Fontaine's `θ`**, pointwise: `θ_S (W(f♭) x) = f (θ_R x)` for a ring map
`f : R →+* S` of `p`-adically complete rings and `x ∈ W(R♭)`. -/
@[simp]
theorem fontaineTheta_map (f : R →+* S) (x : WittVector p (PreTilt R p)) :
    fontaineTheta S p (map (PreTilt.map p f) x) = f (fontaineTheta R p x) :=
  RingHom.congr_fun (fontaineTheta_comp_map p f) x

end WittVector

/-! ### Localizations away from a natural number -/

namespace Localization

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]

/-- The ring map `A[1/n] → B[1/n]` induced by a ring map `f : A →+* B`, for a natural number
`n`: `IsLocalization.map` along `f`, which maps the powers of `n` to powers of `n`. -/
def awayMapNatCast (f : A →+* B) (n : ℕ) :
    Localization.Away (n : A) →+* Localization.Away (n : B) :=
  IsLocalization.map (M := Submonoid.powers (n : A)) (T := Submonoid.powers (n : B)) _ f <|
    Submonoid.powers_le.2 <| by
      rw [Submonoid.mem_comap, map_natCast]
      exact Submonoid.mem_powers _

/-- `awayMapNatCast f n` maps the image of `x ∈ A` to the image of `f x ∈ B`. -/
@[simp]
theorem awayMapNatCast_algebraMap (f : A →+* B) (n : ℕ) (x : A) :
    awayMapNatCast f n (algebraMap A _ x) = algebraMap B _ (f x) :=
  IsLocalization.map_eq _ _

/-- `awayMapNatCast f n` extends `f`: its composite with `A → A[1/n]` is the composite of `f`
with `B → B[1/n]`. -/
theorem awayMapNatCast_comp_algebraMap (f : A →+* B) (n : ℕ) :
    (awayMapNatCast f n).comp (algebraMap A _) = (algebraMap B _).comp f :=
  IsLocalization.map_comp _

/-- `awayMapNatCast · n` maps the identity of `A` to the identity of `A[1/n]`. -/
@[simp]
theorem awayMapNatCast_id (n : ℕ) :
    awayMapNatCast (RingHom.id A) n = RingHom.id (Localization.Away (n : A)) :=
  RingHom.ext fun z => IsLocalization.map_id z _

/-- `awayMapNatCast · n` maps a composite of ring maps to the composite of their maps. -/
theorem awayMapNatCast_comp (g : B →+* C) (f : A →+* B) (n : ℕ) :
    awayMapNatCast (g.comp f) n = (awayMapNatCast g n).comp (awayMapNatCast f n) := by
  refine IsLocalization.ringHom_ext (Submonoid.powers (n : A)) (RingHom.ext fun x => ?_)
  simp

end Localization

/-! ### Naturality of `θ` with `p` inverted -/

section InvertP

variable (p : ℕ) [Fact p.Prime] [Fact ¬IsUnit (p : R)] [Fact ¬IsUnit (p : S)]
  [IsAdicComplete (Ideal.span {(p : R)}) R] [IsAdicComplete (Ideal.span {(p : S)}) S]

/-- Fontaine's `θ` with `p` inverted extends `θ`: it maps the image of `x ∈ W(R♭)` in
`W(R♭)[1/p]` to the image of `θ x` in `R[1/p]`. -/
@[simp]
theorem fontaineThetaInvertP_algebraMap (x : WittVector p (PreTilt R p)) :
    fontaineThetaInvertP R p (algebraMap _ (Localization.Away (p : WittVector p (PreTilt R p))) x) =
      algebraMap R (Localization.Away (p : R)) (WittVector.fontaineTheta R p x) :=
  IsLocalization.lift_eq _ x

/-- **Naturality of Fontaine's `θ` with `p` inverted**: for a ring map `f : R →+* S` of
`p`-adically complete rings, `θ_S[1/p] ∘ W(f♭)[1/p] = f[1/p] ∘ θ_R[1/p]` as ring maps
`W(R♭)[1/p] → S[1/p]`. -/
theorem fontaineThetaInvertP_comp_awayMapNatCast (f : R →+* S) :
    (fontaineThetaInvertP S p).comp
        (Localization.awayMapNatCast (WittVector.map (PreTilt.map p f)) p) =
      (Localization.awayMapNatCast f p).comp (fontaineThetaInvertP R p) := by
  refine IsLocalization.ringHom_ext (Submonoid.powers (p : WittVector p (PreTilt R p)))
    (RingHom.ext fun x => ?_)
  simp

/-- For a ring map `f : R →+* S` of `p`-adically complete rings, the induced map
`W(R♭)[1/p] → W(S♭)[1/p]` maps the kernel of `θ_R[1/p]` into the kernel of `θ_S[1/p]`. -/
theorem ker_fontaineThetaInvertP_le_comap (f : R →+* S) :
    RingHom.ker (fontaineThetaInvertP R p) ≤
      (RingHom.ker (fontaineThetaInvertP S p)).comap
        (Localization.awayMapNatCast (WittVector.map (PreTilt.map p f)) p) := by
  intro x hx
  rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply,
    fontaineThetaInvertP_comp_awayMapNatCast, RingHom.comp_apply, RingHom.mem_ker.1 hx, map_zero]

omit [IsAdicComplete (Ideal.span {(p : R)}) R] [IsAdicComplete (Ideal.span {(p : S)}) S] in
/-- For a ring isomorphism `e : R ≃+* S`, the map on `W(·♭)[1/p]` induced by `e` is a right
inverse of the map induced by `e.symm`. -/
private theorem awayMapNatCast_symm_apply (e : R ≃+* S)
    (x : Localization.Away (p : WittVector p (PreTilt S p))) :
    Localization.awayMapNatCast (WittVector.map (PreTilt.map p e.toRingHom)) p
        (Localization.awayMapNatCast (WittVector.map (PreTilt.map p e.symm.toRingHom)) p x) =
      x := by
  rw [← RingHom.comp_apply, ← Localization.awayMapNatCast_comp, ← WittVector.map_comp,
    ← PreTilt.map_comp, RingEquiv.toRingHom_comp_symm_toRingHom, PreTilt.map_id,
    WittVector.map_id, Localization.awayMapNatCast_id, RingHom.id_apply]

/-- A ring isomorphism `e : R ≃+* S` of `p`-adically complete rings maps the kernel of
`θ_R[1/p]` onto the kernel of `θ_S[1/p]`, through the induced map
`W(R♭)[1/p] → W(S♭)[1/p]`. -/
theorem map_ker_fontaineThetaInvertP (e : R ≃+* S) :
    (RingHom.ker (fontaineThetaInvertP R p)).map
        (Localization.awayMapNatCast (WittVector.map (PreTilt.map p e.toRingHom)) p) =
      RingHom.ker (fontaineThetaInvertP S p) := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.2 (ker_fontaineThetaInvertP_le_comap p _))
    fun x hx => ?_
  rw [← awayMapNatCast_symm_apply p e x]
  exact Ideal.mem_map_of_mem _ (ker_fontaineThetaInvertP_le_comap p e.symm.toRingHom hx)

/-- For a ring isomorphism `e : R ≃+* S` of `p`-adically complete rings, if `a` generates the
kernel of `θ_R[1/p]`, then its image in `W(S♭)[1/p]` generates the kernel of `θ_S[1/p]`. -/
theorem ker_fontaineThetaInvertP_eq_span_awayMapNatCast (e : R ≃+* S)
    (a : Localization.Away (p : WittVector p (PreTilt R p)))
    (ha : RingHom.ker (fontaineThetaInvertP R p) = Ideal.span {a}) :
    RingHom.ker (fontaineThetaInvertP S p) =
      Ideal.span
        {Localization.awayMapNatCast (WittVector.map (PreTilt.map p e.toRingHom)) p a} := by
  rw [← map_ker_fontaineThetaInvertP p e, ha, Ideal.map_span, Set.image_singleton]

end InvertP

/-! ### Adic completions -/

namespace AdicCompletion

variable {A B : Type*} [CommRing A] [CommRing B] (I : Ideal A) (J : Ideal B)

private theorem factorPow_evalₐ {m n : ℕ} (hle : m ≤ n) (x : AdicCompletion I A) :
    Ideal.Quotient.factorPow I hle (evalₐ I n x) = evalₐ I m x := by
  obtain ⟨a, rfl⟩ := mk_surjective I A x
  rw [evalₐ_mk, evalₐ_mk, Ideal.Quotient.factor_mk]
  exact Ideal.mk_eq_mk I hle a

/-- The ring map `Â_I → B̂_J` of adic completions induced by a ring map `f : A →+* B` with
`I.map f ≤ J`: the lift of the compatible ring maps `Â_I → A ⧸ I ^ n → B ⧸ J ^ n`. -/
def mapRingHom (f : A →+* B) (h : I.map f ≤ J) : AdicCompletion I A →+* AdicCompletion J B :=
  liftRingHom J (fun n => (AdicCompletionMaps.quotientMap I J f h n).comp (evalₐ I n).toRingHom)
    fun {m n} hle => by
      rw [← RingHom.comp_assoc, AdicCompletionMaps.quotientMap_factor, RingHom.comp_assoc]
      exact congrArg _ (RingHom.ext (factorPow_evalₐ I hle))

/-- The `n`-th projection of `mapRingHom I J f h x` is the image under the map
`A ⧸ I ^ n → B ⧸ J ^ n` induced by `f` of the `n`-th projection of `x`. -/
@[simp]
theorem evalₐ_mapRingHom (f : A →+* B) (h : I.map f ≤ J) (n : ℕ) (x : AdicCompletion I A) :
    evalₐ J n (mapRingHom I J f h x) = AdicCompletionMaps.quotientMap I J f h n (evalₐ I n x) :=
  evalₐ_liftRingHom J _ _ n x

/-- `mapRingHom I J f h` extends `f`: it maps `of I A x` to `of J B (f x)`. -/
@[simp]
theorem mapRingHom_of (f : A →+* B) (h : I.map f ≤ J) (x : A) :
    mapRingHom I J f h (of I A x) = of J B (f x) :=
  ext_evalₐ fun n => by
    rw [evalₐ_mapRingHom, evalₐ_of, evalₐ_of, AdicCompletionMaps.quotientMap_mk]

end AdicCompletion

/-! ### `B_dR^+` and `B_dR` -/

namespace BDeRhamPlus

variable (p : ℕ) [Fact p.Prime] [Fact ¬IsUnit (p : R)] [Fact ¬IsUnit (p : S)]
  [IsAdicComplete (Ideal.span {(p : R)}) R] [IsAdicComplete (Ideal.span {(p : S)}) S]

/-- The `W(R♭)[1/p]`-algebra structure of `B_dR^+(R)`, that of the `(ker θ)`-adic completion of
`W(R♭)[1/p]`: its algebra map is `AdicCompletion.of`. -/
instance instAlgebra :
    Algebra (Localization.Away (p : WittVector p (PreTilt R p))) (BDeRhamPlus R p) :=
  inferInstanceAs (Algebra _ (AdicCompletion (RingHom.ker (fontaineThetaInvertP R p)) _))

/-- **Functoriality of `B_dR^+`**: the ring map `B_dR^+(R) → B_dR^+(S)` induced by a ring map
`f : R →+* S` of `p`-adically complete rings, the map of `(ker θ)`-adic completions of the map
`W(R♭)[1/p] → W(S♭)[1/p]` induced by `f`. -/
def map (f : R →+* S) : BDeRhamPlus R p →+* BDeRhamPlus S p :=
  AdicCompletion.mapRingHom _ _ (Localization.awayMapNatCast (WittVector.map (PreTilt.map p f)) p)
    (Ideal.map_le_iff_le_comap.2 (ker_fontaineThetaInvertP_le_comap p f))

/-- `BDeRhamPlus.map p f` extends the map `W(R♭)[1/p] → W(S♭)[1/p]` induced by `f`. -/
@[simp]
theorem map_algebraMap (f : R →+* S) (x : Localization.Away (p : WittVector p (PreTilt R p))) :
    map p f (algebraMap _ (BDeRhamPlus R p) x) =
      algebraMap _ (BDeRhamPlus S p)
        (Localization.awayMapNatCast (WittVector.map (PreTilt.map p f)) p x) :=
  AdicCompletion.mapRingHom_of _ _ _ _ x

end BDeRhamPlus

namespace BDeRham

variable (R) (p : ℕ) [Fact p.Prime] [Fact ¬IsUnit (p : R)] [Fact ¬IsUnit (p : S)]
  [IsAdicComplete (Ideal.span {(p : R)}) R] [IsAdicComplete (Ideal.span {(p : S)}) S]

/-- The submonoid of `B_dR^+(R)` that `BDeRham R p` inverts: the submonoid generated by the
images of the elements `a` of `W(R♭)[1/p]` with `ker θ = (a)`. -/
def submonoid : Submonoid (BDeRhamPlus R p) :=
  Submonoid.closure <| AdicCompletion.of (RingHom.ker (fontaineThetaInvertP R p)) _ ''
    {a | RingHom.ker (fontaineThetaInvertP R p) = Ideal.span {a}}

/-- The ring structure of `BDeRham R p`, that of the localization of `B_dR^+(R)` at
`BDeRham.submonoid R p`, which `BDeRham R p` is by definition. -/
instance instCommRing : CommRing (BDeRham R p) :=
  inferInstanceAs (CommRing (Localization (submonoid R p)))

/-- The `B_dR^+(R)`-algebra structure of `BDeRham R p`, that of the localization of
`B_dR^+(R)` at `BDeRham.submonoid R p`. -/
instance instAlgebra : Algebra (BDeRhamPlus R p) (BDeRham R p) :=
  inferInstanceAs (Algebra (BDeRhamPlus R p) (Localization (submonoid R p)))

/-- `BDeRham R p` is the localization of `B_dR^+(R)` at `BDeRham.submonoid R p`. -/
instance instIsLocalization : IsLocalization (submonoid R p) (BDeRham R p) :=
  inferInstanceAs (IsLocalization (submonoid R p) (Localization (submonoid R p)))

variable {R}

/-- The image in `B_dR^+(R)` of a generator `a` of the kernel of `θ_R[1/p]` lies in
`BDeRham.submonoid R p`. -/
theorem algebraMap_mem_submonoid {a : Localization.Away (p : WittVector p (PreTilt R p))}
    (ha : RingHom.ker (fontaineThetaInvertP R p) = Ideal.span {a}) :
    algebraMap _ (BDeRhamPlus R p) a ∈ submonoid R p :=
  Submonoid.subset_closure ⟨a, ha, rfl⟩

/-- For a ring isomorphism `e : R ≃+* S` of `p`-adically complete rings, the map
`B_dR^+(R) → B_dR^+(S)` induced by `e` maps `BDeRham.submonoid R p` into
`BDeRham.submonoid S p`. -/
theorem submonoid_le_comap (e : R ≃+* S) :
    submonoid R p ≤ (submonoid S p).comap (BDeRhamPlus.map p e.toRingHom) := by
  rw [submonoid, Submonoid.closure_le]
  rintro _ ⟨a, ha, rfl⟩
  change BDeRhamPlus.map p e.toRingHom (algebraMap _ (BDeRhamPlus R p) a) ∈ submonoid S p
  rw [BDeRhamPlus.map_algebraMap]
  exact algebraMap_mem_submonoid p (ker_fontaineThetaInvertP_eq_span_awayMapNatCast p e a ha)

/-- **The map on `B_dR`** induced by a ring isomorphism `e : R ≃+* S` of `p`-adically complete
rings: the map of localizations of `BDeRhamPlus.map p e`, which maps the images of the
generators of `ker θ_R` to images of generators of `ker θ_S`. -/
def mapOfRingEquiv (e : R ≃+* S) : BDeRham R p →+* BDeRham S p :=
  IsLocalization.map (BDeRham S p) (BDeRhamPlus.map p e.toRingHom) (submonoid_le_comap p e)

/-- `BDeRham.mapOfRingEquiv p e` extends `BDeRhamPlus.map p e`. -/
@[simp]
theorem mapOfRingEquiv_algebraMap (e : R ≃+* S) (x : BDeRhamPlus R p) :
    mapOfRingEquiv p e (algebraMap _ _ x) = algebraMap _ _ (BDeRhamPlus.map p e.toRingHom x) :=
  IsLocalization.map_eq _ _

end BDeRham
