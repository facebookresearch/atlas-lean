module

public import MathlibExt.RingTheory.Perfectoid.CrystallinePeriodRingGalois
public import MathlibExt.RingTheory.Perfectoid.LogTeichmullerMultiple
public import MathlibExt.RingTheory.Perfectoid.LogTranscendence

/-!
# Fontaine's rings `B_cris` and `B_st` inside `B_dR`

Let `A_cris ⊆ B_dR^+` be the image of Fontaine's ring `A_cris` (`PadicComplexInt.aCris`), let
`t = log [ε]` for `ε = (1, ζ_p, ζ_{p²}, …)` (`PadicComplexInt.epsilon`), and let
`u = log [p̃] = log([p̃]/p)` (`PadicComplexInt.logPTilde`), for the normalization `log p = 0`
(Exposé II, §4.2.2 p. 85 and §4.2.5 c) p. 86), where `p̃ = (p, p^{1/p}, …)`. Following
J.-M. Fontaine, *Le corps des périodes p-adiques*, Astérisque 223 (1994), Exposé II, §2.3.4
pp. 78–79 and §4.1 pp. 83–84, which identifies `B_cris` with its image in `B_dR`, we define the
`ℚ_[p]`-subalgebras of the field `B_dR = BDeRham 𝓞_ℂ_[p] p`

* `B_cris^+ = A_cris[1/p]` (`PadicComplexInt.bCrisPlus`),
* `B_cris = B_cris^+[1/t]` (`PadicComplexInt.bCris`),
* `B_st = B_cris[u]` (`PadicComplexInt.bSt`),

and show:

* they are stable under `Gal(ℚ̄_p/ℚ_p)` (`PadicComplexInt.galoisBDeRham_mem_bCris`,
  `PadicComplexInt.galoisBDeRham_mem_bSt`), with `σ(u) = u + log [u_σ]` where `σ(p̃) = p̃ u_σ`
  (`PadicComplexInt.galoisBDeRham_algebraMap_logPTilde`);
* they do not depend on the choice of the generator `ξ` of `ker θ` nor of the generator `ε` of
  `ℤ_p(1)` (`PadicComplexInt.bCris_eq_adjoin_of_generators`,
  `PadicComplexInt.bSt_eq_adjoin_of_generators`);
* `B_cris ⊆ B_max` (`PadicComplexInt.bCris_le_bMax`), so Fontaine's Lemme 4.3.1 (Exposé II, p. 87):
  `u` is not in the fraction field of `B_cris`
  (`PadicComplexInt.mul_algebraMap_logPTilde_ne_of_mem_bCris`), and `u` is transcendental over
  `B_cris` (`PadicComplexInt.transcendental_logPTilde_bCris`), both from the statements for
  `B_max`;
* hence **`B_st = B_cris[u]` is a polynomial ring over `B_cris`**: the evaluation
  `B_cris[X] → B_st`, `X ↦ u`, is an isomorphism of `ℚ_[p]`-algebras
  (`PadicComplexInt.bCrisPolynomialEquiv`; Fontaine, *op. cit.*, Exposé II, Théorème 4.2.4 p. 86
  for `K = ℚ_p`, proved in §4.3 pp. 87–89).
-/

@[expose] public noncomputable section

open Ideal WittVector PowerSeries Polynomial

namespace PadicComplexInt

variable (p : ℕ) [hp : Fact p.Prime]

local notation "𝔸" => WittVector p (PreTilt 𝓞_ℂ_[p] p)
local notation "𝔸ₚ" => Localization.Away (p : WittVector p (PreTilt 𝓞_ℂ_[p] p))
local notation "𝕀" => RingHom.ker (fontaineThetaInvertP 𝓞_ℂ_[p] p)
local notation "𝔹⁺" => BDeRhamPlus 𝓞_ℂ_[p] p
local notation "𝔹" => BDeRham 𝓞_ℂ_[p] p

/-! ### The rings -/

/-- **Fontaine's ring `B_cris^+ = A_cris[1/p]` inside `B_dR`**: the `ℚ_[p]`-subalgebra generated
by the image of `A_cris`. -/
def bCrisPlus : Subalgebra ℚ_[p] 𝔹 :=
  Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aCris p)

/-- **Fontaine's ring `B_cris = B_cris^+[1/t]` inside `B_dR`**: the `ℚ_[p]`-subalgebra generated
by the image of `A_cris` and `1/t`, where `t = log [ε]` for `ε = (1, ζ_p, ζ_{p²}, …)`. -/
def bCris : Subalgebra ℚ_[p] 𝔹 :=
  Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aCris p ∪
    {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹})

/-- **Fontaine's ring `B_st = B_cris[log [p̃]]` inside `B_dR`**, for a prime `p`: the
`ℚ_[p]`-subalgebra generated by the image of `A_cris`, `1/t` and `log [p̃] = log([p̃]/p)` (for the
normalization `log p = 0`, Fontaine, Exposé II, §4.2.2 p. 85 and §4.2.5 c) p. 86). -/
def bSt : Subalgebra ℚ_[p] 𝔹 :=
  Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aCris p ∪
    {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹} ∪
    {algebraMap 𝔹⁺ 𝔹 (logPTilde p)})

/-- `B_cris^+ ⊆ B_cris`. -/
theorem bCrisPlus_le_bCris : bCrisPlus p ≤ bCris p :=
  Algebra.adjoin_mono Set.subset_union_left

/-- `B_cris ⊆ B_st`. -/
theorem bCris_le_bSt : bCris p ≤ bSt p :=
  Algebra.adjoin_mono Set.subset_union_left

/-- The image of `A_cris` in `B_dR` lies in `B_cris^+`. -/
theorem algebraMap_mem_bCrisPlus {y : 𝔹⁺} (hy : y ∈ aCris p) : algebraMap 𝔹⁺ 𝔹 y ∈ bCrisPlus p :=
  Algebra.subset_adjoin ⟨y, hy, rfl⟩

/-- `1/t ∈ B_cris`. -/
theorem inv_logTeichmuller_epsilon_mem_bCris :
    (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹ ∈ bCris p :=
  Algebra.subset_adjoin (Or.inr rfl)

/-- `log [p̃] ∈ B_st`. -/
theorem algebraMap_logPTilde_mem_bSt : algebraMap 𝔹⁺ 𝔹 (logPTilde p) ∈ bSt p :=
  Algebra.subset_adjoin (Or.inr rfl)

/-- **`B_st` is the `B_cris`-algebra generated by `log [p̃]`.** -/
theorem bSt_eq_adjoin :
    bSt p = (Algebra.adjoin (bCris p) {algebraMap 𝔹⁺ 𝔹 (logPTilde p)}).restrictScalars ℚ_[p] := by
  rw [bSt, Algebra.adjoin_union_eq_adjoin_adjoin]
  rfl

/-! ### Independence of the choices -/

/-- If `ε₀` generates `ℤ_p(1)`, then `1/log [ε]` lies in every `ℚ_[p]`-subalgebra of `B_dR`
containing `1/log [ε₀]`, for `ε♯ = 1` and `ε ≠ 1`: `log [ε] = a log [ε₀]` with `a ∈ ℤ_p`
nonzero. -/
private theorem inv_logTeichmuller_mem {ε₀ : PreTilt 𝓞_ℂ_[p] p} (h₀ : ε₀.untilt = 1)
    (hε₀ : IsPrimitiveRoot ((frobeniusEquiv (PreTilt 𝓞_ℂ_[p] p) p).symm ε₀).untilt p)
    {ε : PreTilt 𝓞_ℂ_[p] p} (h : ε.untilt = 1) (hne : ε ≠ 1) {B : Subalgebra ℚ_[p] 𝔹}
    (hB : (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h₀))⁻¹ ∈ B) :
    (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h))⁻¹ ∈ B := by
  obtain ⟨a, -, ha⟩ := exists_logTeichmuller_eq_mul_of_ne_one p h₀ hε₀ h hne
  rw [ha, map_mul, ← IsScalarTower.algebraMap_apply, mul_inv, ← map_inv₀]
  exact B.mul_mem (B.algebraMap_mem _) hB

/-- A generator of `ℤ_p(1)` is not `1`. -/
private theorem ne_one_of_isPrimitiveRoot {ε₀ : PreTilt 𝓞_ℂ_[p] p}
    (hε₀ : IsPrimitiveRoot ((frobeniusEquiv (PreTilt 𝓞_ℂ_[p] p) p).symm ε₀).untilt p) :
    ε₀ ≠ 1 := by
  rintro rfl
  rw [map_one, map_one] at hε₀
  exact hε₀.ne_one hp.out.one_lt rfl

/-- The `ℚ_[p]`-subalgebras generated by `A_cris` and `1/log [ε₀]`, together with a set `T`, do not
depend on the generator `ε₀` of `ℤ_p(1)`. -/
private theorem adjoin_inv_logTeichmuller_eq {ε₀ : PreTilt 𝓞_ℂ_[p] p} (h₀ : ε₀.untilt = 1)
    (hε₀ : IsPrimitiveRoot ((frobeniusEquiv (PreTilt 𝓞_ℂ_[p] p) p).symm ε₀).untilt p)
    (T : Set 𝔹) :
    Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aCris p ∪
        {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹} ∪ T) =
      Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aCris p ∪
        {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h₀))⁻¹} ∪ T) := by
  apply le_antisymm <;> rw [Algebra.adjoin_le_iff] <;> rintro x ((hx | rfl) | hx)
  · exact Algebra.subset_adjoin (Or.inl (Or.inl hx))
  · exact inv_logTeichmuller_mem p h₀ hε₀ (untilt_epsilon p) (epsilon_ne_one p)
      (Algebra.subset_adjoin (Or.inl (Or.inr rfl)))
  · exact Algebra.subset_adjoin (Or.inr hx)
  · exact Algebra.subset_adjoin (Or.inl (Or.inl hx))
  · exact inv_logTeichmuller_mem p (untilt_epsilon p)
      (isPrimitiveRoot_untilt_frobeniusEquiv_symm_epsilon p) h₀ (ne_one_of_isPrimitiveRoot p hε₀)
      (Algebra.subset_adjoin (Or.inl (Or.inr rfl)))
  · exact Algebra.subset_adjoin (Or.inr hx)

/-- **`B_cris` does not depend on the choices**: for every generator `w` of the kernel of `θ` and
every `ε₀ ∈ 𝓞_ℂ_[p]♭` generating `ℤ_p(1)` (`(ε₀^{1/p})♯` a primitive `p`-th root of unity),
`B_cris` is generated by the image of `CrystallineCompletion p w` and `1/log [ε₀]`. -/
theorem bCris_eq_adjoin_of_generators {w : 𝔸}
    (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) {ε₀ : PreTilt 𝓞_ℂ_[p] p}
    (h₀ : ε₀.untilt = 1)
    (hε₀ : IsPrimitiveRoot ((frobeniusEquiv (PreTilt 𝓞_ℂ_[p] p) p).symm ε₀).untilt p) :
    bCris p = Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' (toBDeRhamPlus hgen).range ∪
      {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h₀))⁻¹}) := by
  have h := adjoin_inv_logTeichmuller_eq p h₀ hε₀ ∅
  rw [Set.union_empty, Set.union_empty] at h
  rw [range_toBDeRhamPlus_eq_aCris p hgen, bCris, h]

/-- **`B_st` does not depend on the choices**: for every generator `w` of the kernel of `θ` and
every `ε₀ ∈ 𝓞_ℂ_[p]♭` generating `ℤ_p(1)`, `B_st` is generated by the image of
`CrystallineCompletion p w`, `1/log [ε₀]` and `log [p̃]`. -/
theorem bSt_eq_adjoin_of_generators {w : 𝔸}
    (hgen : RingHom.ker (fontaineTheta 𝓞_ℂ_[p] p) = span {w}) {ε₀ : PreTilt 𝓞_ℂ_[p] p}
    (h₀ : ε₀.untilt = 1)
    (hε₀ : IsPrimitiveRoot ((frobeniusEquiv (PreTilt 𝓞_ℂ_[p] p) p).symm ε₀).untilt p) :
    bSt p = Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' (toBDeRhamPlus hgen).range ∪
      {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h₀))⁻¹} ∪ {algebraMap 𝔹⁺ 𝔹 (logPTilde p)}) := by
  rw [range_toBDeRhamPlus_eq_aCris p hgen, bSt, adjoin_inv_logTeichmuller_eq p h₀ hε₀]

/-! ### The Galois action -/

/-- The Kummer unit `u_σ = σ(p̃)/p̃` of `σ ∈ Gal(ℚ̄_p/ℚ_p)`: the element of `𝓞_ℂ_[p]♭` with
`σ(p̃) = p̃ u_σ` (`PadicComplexInt.preTiltMap_pFlat_eq_mul_kummerUnit`) and `u_σ♯ = 1`
(`PadicComplexInt.untilt_kummerUnit`); it is unique since `𝓞_ℂ_[p]♭` is a domain. -/
def kummerUnit (σ : Gal(PadicAlgCl p/ℚ_[p])) : PreTilt 𝓞_ℂ_[p] p :=
  Classical.choose (exists_preTiltMap_pFlat_eq_mul p σ)

/-- `σ(p̃) = p̃ u_σ`. -/
theorem preTiltMap_pFlat_eq_mul_kummerUnit (σ : Gal(PadicAlgCl p/ℚ_[p])) :
    PreTilt.map p (integralGalois p σ).toRingHom (pFlat p) = pFlat p * kummerUnit p σ :=
  (Classical.choose_spec (exists_preTiltMap_pFlat_eq_mul p σ)).1

/-- `u_σ♯ = 1`. -/
theorem untilt_kummerUnit (σ : Gal(PadicAlgCl p/ℚ_[p])) : (kummerUnit p σ).untilt = 1 :=
  (Classical.choose_spec (exists_preTiltMap_pFlat_eq_mul p σ)).2

/-- **`σ(log [p̃]) = log [p̃] + log [u_σ]`** in `B_dR`, where `σ(p̃) = p̃ u_σ`. -/
theorem galoisBDeRham_algebraMap_logPTilde (σ : Gal(PadicAlgCl p/ℚ_[p])) :
    galoisBDeRham p σ (algebraMap 𝔹⁺ 𝔹 (logPTilde p)) =
      algebraMap 𝔹⁺ 𝔹 (logPTilde p) +
        algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_kummerUnit p σ)) := by
  rw [galoisBDeRham_algebraMap, galoisBDeRhamPlus_logPTilde p σ
    (preTiltMap_pFlat_eq_mul_kummerUnit p σ) (untilt_kummerUnit p σ), map_add, add_comm]

/-- The image under `σ` of an element of the image of `A_cris` in `B_dR` lies in that image. -/
private theorem galoisBDeRham_algebraMap_mem_image (σ : Gal(PadicAlgCl p/ℚ_[p])) {y : 𝔹⁺}
    (hy : y ∈ aCris p) :
    galoisBDeRham p σ (algebraMap 𝔹⁺ 𝔹 y) ∈ algebraMap 𝔹⁺ 𝔹 '' aCris p := by
  rw [galoisBDeRham_algebraMap]
  exact ⟨_, galoisBDeRhamPlus_mem_aCris p σ hy, rfl⟩

/-- `σ(1/t)` lies in every `ℚ_[p]`-subalgebra of `B_dR` containing `1/t`: `σ(t) = log [σ ε]`. -/
private theorem galoisBDeRham_inv_logTeichmuller_epsilon_mem (σ : Gal(PadicAlgCl p/ℚ_[p]))
    {B : Subalgebra ℚ_[p] 𝔹} (hB : (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹ ∈ B) :
    galoisBDeRham p σ (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹ ∈ B := by
  have h' : (PreTilt.map p (integralGalois p σ).toRingHom (epsilon p)).untilt = 1 := by
    rw [PreTilt.untilt_map, untilt_epsilon, map_one]
  have hne : PreTilt.map p (integralGalois p σ).toRingHom (epsilon p) ≠ 1 := fun h1 =>
    epsilon_ne_one p (preTiltMap_integralGalois_injective p σ (by rw [h1, map_one]))
  rw [map_inv₀, galoisBDeRham_algebraMap, galoisBDeRhamPlus_logTeichmuller p σ _ h']
  exact inv_logTeichmuller_mem p (untilt_epsilon p)
    (isPrimitiveRoot_untilt_frobeniusEquiv_symm_epsilon p) h' hne hB

/-- **`B_cris^+` is stable under `Gal(ℚ̄_p/ℚ_p)`.** -/
theorem galoisBDeRham_mem_bCrisPlus (σ : Gal(PadicAlgCl p/ℚ_[p])) {x : 𝔹} (hx : x ∈ bCrisPlus p) :
    galoisBDeRham p σ x ∈ bCrisPlus p := by
  have hle : bCrisPlus p ≤ (bCrisPlus p).comap (galoisBDeRham p σ) := by
    rw [bCrisPlus, Algebra.adjoin_le_iff]
    rintro _ ⟨y, hy, rfl⟩
    exact Algebra.subset_adjoin (galoisBDeRham_algebraMap_mem_image p σ hy)
  exact hle hx

/-- **`B_cris` is stable under `Gal(ℚ̄_p/ℚ_p)`**: `σ(t) = log [σ ε] = a t` with `a ∈ ℤ_p`
nonzero, so `σ(1/t) = a⁻¹/t`. -/
theorem galoisBDeRham_mem_bCris (σ : Gal(PadicAlgCl p/ℚ_[p])) {x : 𝔹} (hx : x ∈ bCris p) :
    galoisBDeRham p σ x ∈ bCris p := by
  have hle : bCris p ≤ (bCris p).comap (galoisBDeRham p σ) := by
    rw [bCris, Algebra.adjoin_le_iff]
    rintro _ (⟨y, hy, rfl⟩ | rfl)
    · exact Algebra.subset_adjoin (Or.inl (galoisBDeRham_algebraMap_mem_image p σ hy))
    · exact galoisBDeRham_inv_logTeichmuller_epsilon_mem p σ
        (inv_logTeichmuller_epsilon_mem_bCris p)
  exact hle hx

/-- **`B_st` is stable under `Gal(ℚ̄_p/ℚ_p)`.** -/
theorem galoisBDeRham_mem_bSt (σ : Gal(PadicAlgCl p/ℚ_[p])) {x : 𝔹} (hx : x ∈ bSt p) :
    galoisBDeRham p σ x ∈ bSt p := by
  have hle : bSt p ≤ (bSt p).comap (galoisBDeRham p σ) := by
    rw [bSt, Algebra.adjoin_le_iff]
    rintro _ ((⟨y, hy, rfl⟩ | rfl) | rfl)
    · exact Algebra.subset_adjoin (Or.inl (Or.inl (galoisBDeRham_algebraMap_mem_image p σ hy)))
    · exact galoisBDeRham_inv_logTeichmuller_epsilon_mem p σ
        (bCris_le_bSt p (inv_logTeichmuller_epsilon_mem_bCris p))
    · rw [SetLike.mem_coe, Subalgebra.mem_comap, galoisBDeRham_algebraMap_logPTilde]
      exact (bSt p).add_mem (algebraMap_logPTilde_mem_bSt p) (bCris_le_bSt p
        (bCrisPlus_le_bCris p (algebraMap_mem_bCrisPlus p (logTeichmuller_mem_aCris p _))))
  exact hle hx

/-! ### `B_cris ⊆ B_max` and the transcendence of `log [p̃]` over `B_cris` -/

/-- **`B_cris ⊆ B_max`**, from `A_cris ⊆ A_max`. -/
theorem bCris_le_bMax : bCris p ≤ bMax p := by
  rw [bCris, Algebra.adjoin_le_iff]
  rintro _ (⟨y, hy, rfl⟩ | rfl)
  · exact algebraMap_mem_bMax p (aCris_le_aMax p hy)
  · exact Algebra.subset_adjoin (Or.inr ⟨epsilon p, untilt_epsilon p, epsilon_ne_one p, rfl⟩)

/-- **Fontaine's Lemme 4.3.1** (Exposé II, p. 87): `log [p̃]` is not in the fraction field of
`B_cris` inside `B_dR`: if `a, b ∈ B_cris` and `a ≠ 0`, then `a · log [p̃] ≠ b`. -/
theorem mul_algebraMap_logPTilde_ne_of_mem_bCris {a b : 𝔹} (ha : a ∈ bCris p) (hb : b ∈ bCris p)
    (ha0 : a ≠ 0) : a * algebraMap 𝔹⁺ 𝔹 (logPTilde p) ≠ b :=
  mul_algebraMap_logPTilde_ne p (bCris_le_bMax p ha) (bCris_le_bMax p hb) ha0

/-- **`log [p̃]` is transcendental over `B_cris`.** -/
theorem transcendental_logPTilde_bCris :
    Transcendental (bCris p) (algebraMap 𝔹⁺ 𝔹 (logPTilde p)) := by
  rw [transcendental_iff_injective]
  intro P Q hPQ
  have key : ∀ R : (bCris p)[X], aeval (R := bMax p) (algebraMap 𝔹⁺ 𝔹 (logPTilde p))
      (R.map (Subalgebra.inclusion (bCris_le_bMax p)).toRingHom) =
        aeval (algebraMap 𝔹⁺ 𝔹 (logPTilde p)) R := fun R => by
    rw [aeval_def, aeval_def, eval₂_map]
    rfl
  refine Polynomial.map_injective _ (Subalgebra.inclusion_injective (bCris_le_bMax p))
    (aeval_logPTilde_injective p ?_)
  rw [key, key]
  exact hPQ

/-- **The evaluation `B_cris[X] → B_dR` at `log [p̃]` is injective.** -/
theorem aeval_logPTilde_bCris_injective :
    Function.Injective (aeval (R := bCris p) (algebraMap 𝔹⁺ 𝔹 (logPTilde p))) :=
  transcendental_iff_injective.mp (transcendental_logPTilde_bCris p)

/-- **`B_st` is a polynomial ring over `B_cris`** (Fontaine, Exposé II, Théorème 4.2.4 p. 86, for
`K = ℚ_p`): the evaluation `B_cris[X] → B_st`, `X ↦ log [p̃]`, as an isomorphism of
`ℚ_[p]`-algebras. -/
def bCrisPolynomialEquiv : (bCris p)[X] ≃ₐ[ℚ_[p]] bSt p :=
  (((AlgEquiv.ofInjective (aeval (R := bCris p) (algebraMap 𝔹⁺ 𝔹 (logPTilde p)))
      (aeval_logPTilde_bCris_injective p)).trans
    (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval _ _).symm)).restrictScalars
      ℚ_[p]).trans
    (Subalgebra.equivOfEq
      ((Algebra.adjoin (bCris p) {algebraMap 𝔹⁺ 𝔹 (logPTilde p)}).restrictScalars ℚ_[p]) (bSt p)
      (bSt_eq_adjoin p).symm)

/-- The isomorphism `B_cris[X] ≃ B_st` is evaluation at `log [p̃]`. -/
theorem coe_bCrisPolynomialEquiv (P : (bCris p)[X]) :
    (bCrisPolynomialEquiv p P : 𝔹) = aeval (algebraMap 𝔹⁺ 𝔹 (logPTilde p)) P :=
  rfl

/-- The isomorphism `B_cris[X] ≃ B_st` sends `X` to `log [p̃]`. -/
theorem coe_bCrisPolynomialEquiv_X :
    (bCrisPolynomialEquiv p X : 𝔹) = algebraMap 𝔹⁺ 𝔹 (logPTilde p) := by
  rw [coe_bCrisPolynomialEquiv, aeval_X]

/-- The isomorphism `B_cris[X] ≃ B_st` is the inclusion on `B_cris`. -/
theorem coe_bCrisPolynomialEquiv_C (a : bCris p) :
    (bCrisPolynomialEquiv p (C a) : 𝔹) = a := by
  rw [coe_bCrisPolynomialEquiv, aeval_C]
  rfl

end PadicComplexInt
