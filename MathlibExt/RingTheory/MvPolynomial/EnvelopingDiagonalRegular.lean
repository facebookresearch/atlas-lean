module

public import MathlibExt.RingTheory.MvPolynomial.EnvelopingDiagonal
public import MathlibExt.RingTheory.MvPolynomial.Augmentation
public import MathlibExt.RingTheory.MvPolynomial.RegularSequence
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Actual finite regularity and ideal transport of the polynomial diagonal

Every finite distinct family of original left-minus-right coordinates is
weakly regular. The proof transports the existing actual polynomial-variable
theorem through the earned coordinate ring equivalence. This includes the
zero coefficient ring and imposes no finite ambient variable hypothesis.
-/

@[expose] public section
noncomputable section

universe u v

namespace MvPolynomial

variable (k : Type u) [CommRing k] (σ : Type v)

/-- The actual ideal generated by the original diagonal differences. -/
def diagonalDifferenceIdeal : Ideal (PolynomialEnveloping k σ) :=
  Ideal.span (Set.range (diagonalDifference k σ))

/-- The earned coordinate change sends the actual diagonal ideal to the original variable ideal. -/
theorem diagonalDifferenceIdeal_map :
    (diagonalDifferenceIdeal k σ).map (envelopingDiagonalCoordinates k σ).toRingHom =
      idealOfVars σ (MvPolynomial σ k) := by
  rw [diagonalDifferenceIdeal, Ideal.map_span]
  change Ideal.span ((envelopingDiagonalCoordinates k σ) '' Set.range (diagonalDifference k σ)) =
    Ideal.span (Set.range (MvPolynomial.X : σ → DiagonalPolynomial k σ))
  rw [← Set.range_comp]
  have hfun : (envelopingDiagonalCoordinates k σ) ∘ diagonalDifference k σ =
      (MvPolynomial.X : σ → DiagonalPolynomial k σ) := by
    funext i
    exact envelopingDiagonalCoordinates_difference k σ i
  exact congrArg (fun f => Ideal.span (Set.range f)) hfun

/-- Membership in the original diagonal ideal is detected by the actual variable ideal. -/
theorem diagonalDifferenceIdeal_mem_iff (z : PolynomialEnveloping k σ) :
    z ∈ diagonalDifferenceIdeal k σ ↔
      envelopingDiagonalCoordinates k σ z ∈ idealOfVars σ (MvPolynomial σ k) := by
  rw [← diagonalDifferenceIdeal_map]
  constructor
  · intro hz
    exact Ideal.mem_map_of_mem (envelopingDiagonalCoordinates k σ).toRingHom hz
  · intro hz
    obtain ⟨x, hx, he⟩ :=
      (Ideal.mem_map_iff_of_surjective (envelopingDiagonalCoordinates k σ).toRingHom
        (envelopingDiagonalCoordinates k σ).surjective).mp hz
    exact (envelopingDiagonalCoordinates k σ).injective he ▸ hx

/-- Every finite distinct original diagonal family is actually weakly regular.
The regularity is a conclusion, not supplied by the user of the diagonal resolution. -/
theorem diagonalDifference_isWeaklyRegular {n : ℕ} (f : Fin n → σ)
    (hf : Function.Injective f) :
    RingTheory.Sequence.IsWeaklyRegular (PolynomialEnveloping k σ)
      (List.ofFn (fun i => diagonalDifference k σ (f i))) := by
  let E := PolynomialEnveloping k σ
  let P := DiagonalPolynomial k σ
  let e : E ≃ₐ[k] P := envelopingDiagonalCoordinates k σ
  let rs : List E := List.ofFn (fun i => diagonalDifference k σ (f i))
  have hmap : List.Forall₂ (fun (r : E) (s : P) => ∀ x : E,
      e (r • x) = s • e x) rs (rs.map e) :=
    List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr (fun r _ x => by
      change e (r * x) = e r * e x
      exact e.map_mul r x))
  have hregular : RingTheory.Sequence.IsWeaklyRegular E rs ↔
      RingTheory.Sequence.IsWeaklyRegular P (rs.map e) :=
    AddEquiv.isWeaklyRegular_congr (R := E) (S := P) (M := E) (M₂ := P) (e := e.toAddEquiv) hmap
  apply hregular.mpr
  have hx : rs.map e = List.ofFn (fun i : Fin n => (MvPolynomial.X (f i) : P)) := by
    change (List.ofFn (fun i : Fin n => diagonalDifference k σ (f i))).map e = _
    rw [List.map_ofFn]
    apply congrArg List.ofFn
    funext i
    exact envelopingDiagonalCoordinates_difference k σ (f i)
  rw [hx]
  exact isWeaklyRegular_X_of_injective (MvPolynomial σ k) f hf

/-- The actual diagonal ideal is the kernel of the original multiplication augmentation. -/
theorem diagonalDifferenceIdeal_eq_ker_multiplication :
    diagonalDifferenceIdeal k σ = RingHom.ker (diagonalMultiplication k σ).toRingHom := by
  apply Ideal.ext
  intro z
  rw [diagonalDifferenceIdeal_mem_iff,
    idealOfVars_eq_ker_constantCoeff (MvPolynomial σ k) σ]
  change constantCoeff (envelopingDiagonalCoordinates k σ z) = 0 ↔
    diagonalMultiplication k σ z = 0
  have h := DFunLike.congr_fun (diagonalEvalZero_comp_coordinates k σ) z
  change diagonalEvalZero k σ (envelopingDiagonalCoordinates k σ z) =
    diagonalMultiplication k σ z at h
  have hzero : diagonalEvalZero k σ (envelopingDiagonalCoordinates k σ z) =
      constantCoeff (envelopingDiagonalCoordinates k σ z) := by
    simp only [diagonalEvalZero, aeval_zero', Algebra.algebraMap_self_apply]
  rw [← hzero, h]

end MvPolynomial
