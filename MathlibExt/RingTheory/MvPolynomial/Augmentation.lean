module

public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The actual augmentation ideal of an arbitrary polynomial algebra

The ideal generated by the original variables is exactly the kernel of the
original constant-coefficient homomorphism. The coefficient semiring and
variable type are arbitrary. This is the lower ring fact used by polynomial
and diagonal Koszul augmentations.
-/

@[expose] public section
noncomputable section

universe u v

namespace MvPolynomial

/-- The original variable ideal is the actual constant-coefficient kernel. -/
theorem idealOfVars_eq_ker_constantCoeff (R : Type u) [CommSemiring R] (σ : Type v) :
    idealOfVars σ R = RingHom.ker (constantCoeff : MvPolynomial σ R →+* R) := by
  apply Ideal.ext
  intro p
  change p ∈ idealOfVars σ R ↔ constantCoeff p = 0
  rw [← pow_one (idealOfVars σ R), mem_pow_idealOfVars_iff']
  simp only [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff, forall_eq, constantCoeff_eq]

end MvPolynomial
