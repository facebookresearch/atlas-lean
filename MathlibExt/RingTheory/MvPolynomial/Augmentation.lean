module

public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The polynomial augmentation ideal

For a commutative semiring `R` and a variable type `σ`, the constant-coefficient homomorphism
`MvPolynomial σ R →+* R` fixes constants and sends every variable `X_i` to zero. Its kernel is
the ideal generated by the variables, `idealOfVars σ R`.

Reference for polynomial rings: Atiyah and Macdonald, *Introduction to Commutative Algebra*,
Chapter 1.
-/

@[expose] public section
noncomputable section

universe u v

namespace MvPolynomial

/-- For a commutative semiring `R` and any variable type `σ`, the ideal `idealOfVars σ R`,
generated by all `X_i`, is `RingHom.ker (constantCoeff : MvPolynomial σ R →+* R)`. Thus a
polynomial lies in the variable ideal exactly when its constant coefficient is zero. -/
theorem idealOfVars_eq_ker_constantCoeff (R : Type u) [CommSemiring R] (σ : Type v) :
    idealOfVars σ R = RingHom.ker (constantCoeff : MvPolynomial σ R →+* R) := by
  apply Ideal.ext
  intro p
  change p ∈ idealOfVars σ R ↔ constantCoeff p = 0
  rw [← pow_one (idealOfVars σ R), mem_pow_idealOfVars_iff']
  simp only [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff, forall_eq, constantCoeff_eq]

end MvPolynomial
