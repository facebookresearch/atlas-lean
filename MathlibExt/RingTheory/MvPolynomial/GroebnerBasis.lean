module

public import Mathlib.RingTheory.MvPolynomial.Groebner
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Gröbner bases: definition, ideal membership and generation

Mathlib provides monomial orders and the multivariate division algorithm
(`MonomialOrder.div_set`), but no notion of Gröbner basis. This file adds one, over a field,
together with its two basic consequences:

* `IsGroebnerBasis.mem_iff_remainder_eq_zero`: once `G` is a Gröbner basis of `I`, a polynomial
  lies in `I` if and only if its remainder on division by `G` is zero, whatever the division;
* `IsGroebnerBasis.span_eq`: a Gröbner basis of `I` generates `I`;

and the easy direction of Buchberger's criterion for Mathlib's S-polynomial `m.sPolynomial f g`.

References: D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, Chapter 2,
§§5–7 (section only, except §6 Theorem 6); the statements were checked against
B. Hassett, *Math 465 Lecture Notes*, Brown University, 2002, Lecture 3 (Definition 3.5,
Proposition 3.8, Corollary 3.9) and Lecture 5 (Theorem 5.2),
https://www.math.brown.edu/bhassett/teaching/465spring02/.
-/

@[expose] public section

noncomputable section

namespace MathlibExt.RingTheory.MvPolynomial.GroebnerBasis

open _root_.MvPolynomial MonomialOrder

variable {σ K : Type*} [Field K] (m : MonomialOrder σ)

/-- **Gröbner basis.** For a monomial order `m`, a set `G` of polynomials is a Gröbner basis of
the ideal `I` when `G ⊆ I` and the leading monomial of every nonzero `f ∈ I` is divisible by the
leading monomial of some nonzero `g ∈ G` (`m.degree g ≤ m.degree f` componentwise). Equivalently,
the leading terms of `G` generate the initial ideal `in_m(I)`: B. Hassett, *Math 465 Lecture
Notes*, Brown University, 2002, Lecture 3, Definition 3.5 (see also Cox–Little–O'Shea, *Ideals,
Varieties, and Algorithms*, Ch. 2 §5, section only). Finite `G` is not required. -/
def IsGroebnerBasis (G : Set (MvPolynomial σ K)) (I : Ideal (MvPolynomial σ K)) : Prop :=
  G ⊆ I ∧ ∀ f ∈ I, f ≠ 0 → ∃ g ∈ G, g ≠ 0 ∧ m.degree g ≤ m.degree f

/-- **Ideal membership by remainder zero.** Let `G` be a Gröbner basis of `I` and write
`f = ∑_{b ∈ G} q_b b + r` where no monomial of `r` is divisible by the leading monomial of any
`b ∈ G` (the output of the division algorithm, `MonomialOrder.div_set`). Then `f ∈ I` if and
only if `r = 0` (B. Hassett, *Math 465 Lecture Notes*, Brown University, 2002, Lecture 3,
Proposition 3.8; see also Cox–Little–O'Shea, Ch. 2 §6, section only). In particular the remainder
does not depend on the division performed when `f ∈ I`. -/
theorem IsGroebnerBasis.mem_iff_remainder_eq_zero {G : Set (MvPolynomial σ K)}
    {I : Ideal (MvPolynomial σ K)} (hG : IsGroebnerBasis m G I) (f : MvPolynomial σ K)
    (q : G →₀ MvPolynomial σ K) (r : MvPolynomial σ K)
    (hf : f = Finsupp.linearCombination _ (fun b : G ↦ (b : MvPolynomial σ K)) q + r)
    (hr : ∀ c ∈ r.support, ∀ b ∈ G, ¬ m.degree b ≤ c) :
    f ∈ I ↔ r = 0 := by
  have hlin : Finsupp.linearCombination _ (fun b : G ↦ (b : MvPolynomial σ K)) q ∈ I := by
    rw [Finsupp.linearCombination_apply]
    exact Ideal.sum_mem _ fun b _ ↦ Ideal.mul_mem_left _ _ (hG.1 b.2)
  constructor
  · intro hfI
    by_contra hr0
    have hrI : r ∈ I := by
      have : r = f - Finsupp.linearCombination _ (fun b : G ↦ (b : MvPolynomial σ K)) q := by
        rw [hf]; ring
      rw [this]
      exact sub_mem hfI hlin
    obtain ⟨g, hgG, -, hgr⟩ := hG.2 r hrI hr0
    exact hr _ ((m.degree_mem_support_iff r).2 hr0) g hgG hgr
  · intro hr0
    rw [hf, hr0, add_zero]
    exact hlin

/-- **A Gröbner basis generates its ideal.** If `G` is a Gröbner basis of `I`, then `I` is the
ideal generated by `G` (B. Hassett, *Math 465 Lecture Notes*, Brown University, 2002, Lecture 3,
Corollary 3.9; see also Cox–Little–O'Shea, Ch. 2 §5, section only). The proof divides by the nonzero
elements of `G`, whose leading coefficients are units, and applies the remainder criterion. -/
theorem IsGroebnerBasis.span_eq {G : Set (MvPolynomial σ K)} {I : Ideal (MvPolynomial σ K)}
    (hG : IsGroebnerBasis m G I) : Ideal.span G = I := by
  apply le_antisymm (Ideal.span_le.2 hG.1)
  intro f hf
  set G' : Set (MvPolynomial σ K) := G \ {0}
  have hunit : ∀ b ∈ G', IsUnit (m.leadingCoeff b) := fun b hb ↦
    (m.leadingCoeff_ne_zero_iff.2 hb.2).isUnit
  have hG' : IsGroebnerBasis m G' I := by
    refine ⟨fun b hb ↦ hG.1 hb.1, fun f hf hf0 ↦ ?_⟩
    obtain ⟨g, hgG, hg0, hgf⟩ := hG.2 f hf hf0
    exact ⟨g, ⟨hgG, hg0⟩, hg0, hgf⟩
  obtain ⟨q, r, hfqr, -, hr⟩ := m.div_set hunit f
  have hr0 : r = 0 := (hG'.mem_iff_remainder_eq_zero m f q r hfqr hr).1 hf
  rw [hfqr, hr0, add_zero, Finsupp.linearCombination_apply]
  refine Ideal.sum_mem _ fun b _ ↦ Ideal.mul_mem_left _ _ ?_
  exact Ideal.subset_span b.2.1

/-- **S-polynomials of a Gröbner basis reduce to zero.** If `G` is a Gröbner basis of `I` and
`g, h ∈ G`, then every remainder of `S(g, h)` on division by `G` is zero: the easy direction of
Buchberger's criterion (Cox–Little–O'Shea, Ch. 2 §6, Theorem 6; B. Hassett, *Math 465 Lecture
Notes*, Brown University, 2002, Lecture 5, Theorem 5.2, direction ⇒), since `S(g, h) ∈ I`. -/
theorem IsGroebnerBasis.sPolynomial_remainder_eq_zero {G : Set (MvPolynomial σ K)}
    {I : Ideal (MvPolynomial σ K)} (hG : IsGroebnerBasis m G I) {g h : MvPolynomial σ K}
    (hg : g ∈ G) (hh : h ∈ G) (q : G →₀ MvPolynomial σ K) (r : MvPolynomial σ K)
    (hS : m.sPolynomial g h =
      Finsupp.linearCombination _ (fun b : G ↦ (b : MvPolynomial σ K)) q + r)
    (hr : ∀ c ∈ r.support, ∀ b ∈ G, ¬ m.degree b ≤ c) : r = 0 := by
  exact (hG.mem_iff_remainder_eq_zero m _ q r hS hr).1
    (m.sPolynomial_mem_ideal (hG.1 hg) (hG.1 hh))

end MathlibExt.RingTheory.MvPolynomial.GroebnerBasis
