-- Author: @toskua
module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Weak and full regularity of polynomial variables

Let `R` be a commutative ring, `σ` a type, and `f : Fin n → σ` injective. The sequence
`List.ofFn (fun i ↦ X_(f i))` in `MvPolynomial σ R` is weakly regular: each successive
variable acts injectively on the quotient by the preceding variables.

When `R` is nontrivial, the ideal generated by this family is proper, so the sequence is
regular. Evaluation of all variables at zero gives the properness condition.

Reference: Matsumura, *Commutative Ring Theory*, Section 16.
-/

-- Implementation credit for the weak regularity proof and its helper: @toskua, Avocado.

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace MvPolynomial

universe u v

open RingTheory.Sequence

private theorem ofList_take_X
    (R : Type u) [CommRing R] {σ : Type v} {n : ℕ}
    (f : Fin n → σ) (i : ℕ) :
    Ideal.ofList
        ((List.ofFn fun j => X (f j) : List (MvPolynomial σ R)).take i) =
      Ideal.span (X '' (f '' {j : Fin n | (j : ℕ) < i})) := by
  apply congrArg Ideal.span
  ext z
  constructor
  · intro hz
    change z ∈
      (List.ofFn fun j => X (f j) : List (MvPolynomial σ R)).take i at hz
    rw [List.mem_take_iff_getElem] at hz
    obtain ⟨j, hj, hz⟩ := hz
    have hjn : j < n := (lt_min_iff.mp (by simpa using hj)).2
    let jf : Fin n := ⟨j, hjn⟩
    have hz' : z = X (f jf) := by
      simpa [jf] using hz.symm
    refine ⟨f jf, ⟨jf, ?_, rfl⟩, hz'.symm⟩
    exact (lt_min_iff.mp (by simpa using hj)).1
  · rintro ⟨a, ⟨j, hj, rfl⟩, rfl⟩
    change X (f j) ∈
      (List.ofFn fun j => X (f j) : List (MvPolynomial σ R)).take i
    rw [List.mem_take_iff_getElem]
    refine ⟨j, ?_, ?_⟩
    · simpa using lt_min hj j.isLt
    · simp

/-- Let `R` be a commutative ring, `σ` a type, `n : ℕ`, and `f : Fin n → σ` injective. Then
`List.ofFn (fun i ↦ X_(f i))` is a weakly regular sequence in `MvPolynomial σ R`: each
selected variable acts injectively modulo the ideal generated by the previously selected
variables. -/
theorem isWeaklyRegular_X_of_injective
    (R : Type u) [CommRing R] {σ : Type v} {n : ℕ}
    (f : Fin n → σ) (hf : Function.Injective f) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial σ R)
      (List.ofFn fun i => (X (f i) : MvPolynomial σ R)) := by
  rw [isWeaklyRegular_iff]
  intro i hi
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  have htop :
      Ideal.ofList
          ((List.ofFn fun j => X (f j) : List (MvPolynomial σ R)).take i) •
          (⊤ : Submodule (MvPolynomial σ R) (MvPolynomial σ R)) =
        Ideal.ofList
          ((List.ofFn fun j => X (f j) : List (MvPolynomial σ R)).take i) := by
    rw [← Ideal.one_eq_top, smul_eq_mul, mul_one]
  rw [htop] at hp ⊢
  let j : Fin n := ⟨i, by simpa using hi⟩
  have hget :
      (List.ofFn fun j => X (f j) : List (MvPolynomial σ R))[i] = X (f j) := by
    simp [j]
  have hp' :
      X (f j) * p ∈
        Ideal.ofList
          ((List.ofFn fun j => X (f j) : List (MvPolynomial σ R)).take i) := by
    simpa only [smul_eq_mul, hget] using hp
  rw [ofList_take_X R f] at hp' ⊢
  rw [mem_ideal_span_X_image] at hp' ⊢
  intro m hm
  have hmprod : Finsupp.single (f j) 1 + m ∈ (X (f j) * p).support := by
    rw [support_X_mul]
    exact Finset.mem_map.mpr ⟨m, hm, rfl⟩
  obtain ⟨a, ha, hne⟩ := hp' _ hmprod
  refine ⟨a, ha, ?_⟩
  have hanej : a ≠ f j := by
    rintro rfl
    obtain ⟨j', hj', heq⟩ := ha
    have hj'eq : j' = j := hf heq
    subst j'
    exact (Nat.lt_irrefl i) hj'
  simpa [Finsupp.single_apply, hanej, hanej.symm] using hne

/-- Let `R` be a nontrivial commutative ring, `σ` a type, `n : ℕ`, and `f : Fin n → σ` injective.
The sequence `List.ofFn (fun i ↦ X_(f i))` is regular in `MvPolynomial σ R`. It is weakly
regular, and its generated ideal is proper because evaluation at zero maps its elements to
zero and maps `1` to the nonzero unit of `R`. -/
theorem isRegular_X_of_injective
    (R : Type u) [CommRing R] [Nontrivial R] {σ : Type v} {n : ℕ}
    (f : Fin n → σ) (hf : Function.Injective f) :
    RingTheory.Sequence.IsRegular (MvPolynomial σ R)
      (List.ofFn fun i => (X (f i) : MvPolynomial σ R)) := by
  refine ⟨isWeaklyRegular_X_of_injective R f hf, ?_⟩
  intro htop
  let I : Ideal (MvPolynomial σ R) :=
    Ideal.ofList (List.ofFn fun i => (X (f i) : MvPolynomial σ R))
  have h1 : (1 : MvPolynomial σ R) ∈ I := by
    have h : (1 : MvPolynomial σ R) ∈
        Ideal.ofList (List.ofFn fun i => (X (f i) : MvPolynomial σ R)) •
          (⊤ : Submodule (MvPolynomial σ R) (MvPolynomial σ R)) :=
      htop ▸ Submodule.mem_top
    rwa [← Ideal.one_eq_top, smul_eq_mul, mul_one] at h
  have hker : I ≤ RingHom.ker (eval (fun _ : σ => (0 : R))) := by
    dsimp [I]
    rw [Ideal.ofList, Ideal.span_le]
    intro x hx
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
    simp
  have hzero : (1 : R) = 0 := by
    simpa using hker h1
  exact one_ne_zero hzero

end MvPolynomial
