module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Toric ideals are spanned by binomials

Let `X` be a set of cells and `T : X → ℕ^d` a sufficient statistic (an integer matrix whose
columns are indexed by `X`). The *toric ideal* of `T` is the kernel of the monomial map
`φ_T : k[X] → k[t_1, …, t_d]`, `x ↦ t^{T(x)}`. This file proves that the toric ideal is
generated by the binomials `x^a - x^b` with `∑ a(x) T(x) = ∑ b(x) T(x)`: the first stage of
the proof of Diaconis–Sturmfels, *Algebraic algorithms for sampling from conditional
distributions*, Ann. Statist. 26 (1998), Theorem 3.1 (the identity `I* = I_T`).

The proof shows more: every polynomial `p` differs from a `k`-linear combination of such
binomials by `ψ (φ_T p)`, where `ψ` sends `t^v` back to `x^{R v}` for a chosen point `R v`
of the fibre over `v`. So the kernel is even spanned by binomials as a `k`-vector space.
-/

@[expose] public section

noncomputable section

namespace MathlibExt.RingTheory.ToricIdeal

open MvPolynomial

variable (k : Type*) [Field k] {X d : Type*}

/-- **Sufficient-statistic map of a toric model.** For `T : X → ℕ^d`, the additive map sending a
table of counts `a : X →₀ ℕ` to `∑_x a(x) T(x) ∈ ℕ^d`: the sufficient statistic `t` of
Diaconis–Sturmfels (1998), equation (1.3), whose fibres are the sets `F_t` of data sets with the
same sufficient statistic. -/
abbrev statistic (T : X → d →₀ ℕ) : (X →₀ ℕ) →ₗ[ℕ] (d →₀ ℕ) :=
  Finsupp.linearCombination ℕ T

/-- **Monomial map of a toric model.** The `k`-algebra map `φ_T : k[X] → k[t_1, …, t_d]` sending
each variable `x` to the monomial `t^{T(x)}` (Diaconis–Sturmfels 1998, Section 3.1). -/
def toricMap (T : X → d →₀ ℕ) : MvPolynomial X k →ₐ[k] MvPolynomial d k :=
  aeval fun x => monomial (T x) 1

/-- **Toric ideal.** The kernel `I_T` of the monomial map `x ↦ t^{T(x)}`
(Diaconis–Sturmfels 1998, Section 3.1). -/
def toricIdeal (T : X → d →₀ ℕ) : Ideal (MvPolynomial X k) :=
  RingHom.ker (toricMap k T)

/-- **Binomials of a toric model.** The set of binomials `x^a - x^b` whose exponent vectors have
the same sufficient statistic, `∑ a(x) T(x) = ∑ b(x) T(x)`. Up to a monomial factor these are the
monomial differences `x^{f⁺} - x^{f⁻}` with `∑ f(x) T(x) = 0` of Diaconis–Sturmfels (1998),
equation (3.1), since `x^a - x^b = x^{a ⊓ b} (x^{a - a ⊓ b} - x^{b - a ⊓ b})`. -/
def binomials (T : X → d →₀ ℕ) : Set (MvPolynomial X k) :=
  {p | ∃ a b : X →₀ ℕ, statistic T a = statistic T b ∧ p = monomial a 1 - monomial b 1}

/-- **The monomial map on a monomial.** `φ_T (c x^a) = c t^{∑ a(x) T(x)}`. -/
theorem toricMap_monomial (T : X → d →₀ ℕ) (a : X →₀ ℕ) (c : k) :
    toricMap k T (monomial a c) = monomial (statistic T a) c := by
  classical
  rw [toricMap, aeval_monomial]
  simp only [monomial_pow, one_pow]
  rw [Finsupp.prod, algebraMap_eq, ← monomial_sum_index]
  congr 1

/-- A chosen point of each fibre of the sufficient statistic (and `0` off its image). -/
private def section' (T : X → d →₀ ℕ) (v : d →₀ ℕ) : X →₀ ℕ := by
  classical
  exact if h : ∃ a, statistic T a = v then h.choose else 0

private theorem statistic_section' (T : X → d →₀ ℕ) (a : X →₀ ℕ) :
    statistic T (section' T (statistic T a)) = statistic T a := by
  classical
  have h : ∃ b, statistic T b = statistic T a := ⟨a, rfl⟩
  simp only [section', h, ↓reduceDIte]
  exact h.choose_spec

/-- The map `t^v ↦ x^{R v}` sending a monomial back to a chosen point of its fibre. -/
private def back (T : X → d →₀ ℕ) (q : MvPolynomial d k) : MvPolynomial X k :=
  AddMonoidAlgebra.mapDomain (section' T) q

private theorem back_monomial (T : X → d →₀ ℕ) (v : d →₀ ℕ) (c : k) :
    back k T (monomial v c) = monomial (section' T v) c := by
  simp only [back, ← single_eq_monomial, AddMonoidAlgebra.mapDomain_single]

private theorem back_add (T : X → d →₀ ℕ) (p q : MvPolynomial d k) :
    back k T (p + q) = back k T p + back k T q :=
  AddMonoidAlgebra.mapDomain_add _ _ _

private theorem back_zero (T : X → d →₀ ℕ) : back k T 0 = 0 :=
  AddMonoidAlgebra.mapDomain_zero _

private theorem sub_back_mem (T : X → d →₀ ℕ) (p : MvPolynomial X k) :
    p - back k T (toricMap k T p) ∈ Ideal.span (binomials k T) := by
  induction p using MvPolynomial.induction_on' with
  | add p q hp hq =>
    have : p + q - back k T (toricMap k T (p + q)) =
        (p - back k T (toricMap k T p)) + (q - back k T (toricMap k T q)) := by
      rw [map_add, back_add]; abel
    rw [this]
    exact add_mem hp hq
  | monomial a c =>
    rw [toricMap_monomial, back_monomial]
    have hmem : monomial a (1 : k) - monomial (section' T (statistic T a)) 1 ∈
        Ideal.span (binomials k T) :=
      Ideal.subset_span ⟨a, _, (statistic_section' T a).symm, rfl⟩
    have := Ideal.mul_mem_left _ (C c) hmem
    simpa [mul_sub, C_mul_monomial] using this

/-- **Toric ideals are generated by binomials** (Diaconis–Sturmfels, Ann. Statist. 26 (1998),
proof of Theorem 3.1, first stage: `I* = I_T`). Over any field `k`, the kernel of the monomial
map `k[X] → k[t_1, …, t_d]`, `x ↦ t^{T(x)}`, is the ideal generated by the binomials
`x^a - x^b` with `∑ a(x) T(x) = ∑ b(x) T(x)`. -/
theorem toricIdeal_eq_span_binomials (T : X → d →₀ ℕ) :
    toricIdeal k T = Ideal.span (binomials k T) := by
  apply le_antisymm
  · intro p hp
    have hp0 : toricMap k T p = 0 := hp
    have := sub_back_mem k T p
    rwa [hp0, back_zero, sub_zero] at this
  · rw [Ideal.span_le]
    rintro _ ⟨a, b, hab, rfl⟩
    change toricMap k T _ = 0
    rw [map_sub, toricMap_monomial, toricMap_monomial, hab, sub_self]

/-- **A binomial lies in the toric ideal iff its exponents have the same statistic.**
`x^a - x^b ∈ I_T` if and only if `∑ a(x) T(x) = ∑ b(x) T(x)` (Diaconis–Sturmfels 1998,
Section 3.1, the observation before Theorem 3.1). -/
theorem monomial_sub_monomial_mem_toricIdeal_iff (T : X → d →₀ ℕ) {a b : X →₀ ℕ} :
    monomial a (1 : k) - monomial b 1 ∈ toricIdeal k T ↔ statistic T a = statistic T b := by
  constructor
  · intro h
    have h0 : toricMap k T (monomial a 1 - monomial b 1) = 0 := h
    rw [map_sub, toricMap_monomial, toricMap_monomial, sub_eq_zero] at h0
    exact monomial_left_injective one_ne_zero h0
  · intro h
    rw [toricIdeal_eq_span_binomials]
    exact Ideal.subset_span ⟨a, b, h, rfl⟩

end MathlibExt.RingTheory.ToricIdeal
