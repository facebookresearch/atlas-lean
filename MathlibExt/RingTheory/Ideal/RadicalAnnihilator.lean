module

public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Nilpotent.Basic

@[expose] public section

namespace Ideal

private theorem eq_zero_of_pow_eq_mul_of_pow_mul_eq_zero {S : Type*} [CommRing S]
    [IsReduced S] {a x t : S} {n m : ℕ}
    (hn : x ^ n = a * t) (hm : x ^ m * a = 0) : x = 0 := by
  apply IsNilpotent.eq_zero
  refine ⟨m + n, ?_⟩
  rw [pow_add, hn, ← mul_assoc, hm, zero_mul]

private theorem mul_eq_zero_of_pow_mul_mul_eq_zero {S : Type*} [CommRing S]
    [IsReduced S] {a s : S} {m : ℕ}
    (hm : (a * s) ^ m * a = 0) : a * s = 0 := by
  apply IsNilpotent.eq_zero
  refine ⟨m + 1, ?_⟩
  rw [pow_succ, ← mul_assoc, hm, zero_mul]

private theorem mem_annihilator_span_singleton_iff {S : Type*} [CommRing S]
    (a r : S) :
    r ∈ (Ideal.span {a} : Submodule S S).annihilator ↔ r * a = 0 := by
  rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]

/-- In a reduced commutative ring, the radical of the principal ideal
generated by `a` meets the radical of its annihilator only in `0`, and
a multiple `a * s` lying in the radical of the annihilator forces `s`
itself to lie in that radical. -/
public theorem radical_span_inf_radical_annihilator_eq_bot_of_isReduced
    {S : Type*} [CommRing S] [IsReduced S] (a : S) :
    (Ideal.span {a}).radical ⊓ ((Ideal.span {a}).annihilator).radical = ⊥ ∧
      ∀ s : S, a * s ∈ ((Ideal.span {a}).annihilator).radical →
        s ∈ ((Ideal.span {a}).annihilator).radical := by
  constructor
  · rw [eq_bot_iff]
    rintro x ⟨hx1, hx2⟩
    rw [Ideal.mem_bot]
    obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hx1
    obtain ⟨m, hm⟩ := (Ideal.mem_radical_iff).mp hx2
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hn
    rw [mem_annihilator_span_singleton_iff] at hm
    exact eq_zero_of_pow_eq_mul_of_pow_mul_eq_zero (n := n) (m := m)
      (by rw [← ht, mul_comm]) hm
  · intro s hs
    obtain ⟨m, hm⟩ := (Ideal.mem_radical_iff).mp hs
    rw [mem_annihilator_span_singleton_iff] at hm
    have h0 : a * s = 0 := mul_eq_zero_of_pow_mul_mul_eq_zero hm
    exact Ideal.le_radical (by
      rw [mem_annihilator_span_singleton_iff, mul_comm]; exact h0)

end Ideal
