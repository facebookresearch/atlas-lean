module

public import MathlibExt.Algebra.Homology.KoszulComplexRegularSequence
public import MathlibExt.Algebra.Homology.KoszulComplexResidueReduction

/-!
# Conormal bases from finite weakly regular sequences

For the ideal generated by a finite ordered weakly regular family, its
generator classes form a basis of `I/I²` over `R/I`. Linear combinations of
`Ideal.toCotangent` values give the coordinate map. The generated-ideal
property proves surjectivity, and degree-one Koszul exactness proves
injectivity by identifying relations modulo `I²` with Koszul boundaries.

The ring need not be Noetherian or local, and the quotient may be zero.
Only the displayed generator family is required to be finite.
-/

@[expose] public section
noncomputable section

open scoped BigOperators Pointwise

universe u

namespace Ideal

variable (R : Type u) [CommRing R] {r : ℕ} (c : Fin r → R)

local notation "V" => Fin r → R
local notation "f" => KoszulComplex.familyFunctional R c
local notation "I" => KoszulComplex.ideal R V f
local notation "Q" => R ⧸ I

/-- The actual coordinate functional with its value retained in its generated ideal. -/
def weakRegularFamilyIdealMap : V →ₗ[R] I :=
  (f).codRestrict I (fun v => LinearMap.mem_range_self f v)

/-- The `i`-th family member as an element of its generated ideal. -/
def weakRegularFamilyGenerator (i : Fin r) : I :=
  ⟨c i, ⟨Pi.single i 1, KoszulComplex.familyFunctional_single R c i⟩⟩

/-- The actual quotient-coordinate map to the native conormal module. -/
def weakRegularFamilyCotangentMap : (Fin r → Q) →ₗ[Q] (I).Cotangent :=
  Fintype.linearCombination Q (fun i => (I).toCotangent (weakRegularFamilyGenerator R c i))

/-- Each standard quotient coordinate maps to its original conormal generator. -/
theorem weakRegularFamilyCotangentMap_single (i : Fin r) :
    weakRegularFamilyCotangentMap R c (Pi.single i 1) =
      (I).toCotangent (weakRegularFamilyGenerator R c i) := by
  classical
  simp [weakRegularFamilyCotangentMap, Fintype.linearCombination_apply, Pi.single_apply]

private theorem weakRegularFamilyIdealMap_sum (v : V) :
    weakRegularFamilyIdealMap R c v =
      ∑ i : Fin r, v i • weakRegularFamilyGenerator R c i := by
  apply Subtype.ext
  change f v = (I).subtype (∑ i : Fin r, v i • weakRegularFamilyGenerator R c i)
  rw [map_sum]
  change f v = ∑ i : Fin r, v i • c i
  exact Fintype.linearCombination_apply R c v

/-- Reduction of every original coefficient vector gives its literal ideal class. -/
theorem weakRegularFamilyCotangentMap_quotientCoordinates (v : V) :
    weakRegularFamilyCotangentMap R c (fun i => Ideal.Quotient.mk I (v i)) =
      (I).toCotangent (weakRegularFamilyIdealMap R c v) := by
  rw [weakRegularFamilyCotangentMap, Fintype.linearCombination_apply,
    weakRegularFamilyIdealMap_sum, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  exact (IsScalarTower.algebraMap_smul Q (v i)
    ((I).toCotangent (weakRegularFamilyGenerator R c i))).trans
      ((I).toCotangent.map_smul (v i) (weakRegularFamilyGenerator R c i)).symm

/-- The actual conormal coordinate map is always surjective, independently of regularity. -/
theorem weakRegularFamilyCotangentMap_surjective :
    Function.Surjective (weakRegularFamilyCotangentMap R c) := by
  intro x
  obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective I x
  obtain ⟨v, hv⟩ := y.property
  refine ⟨fun i => Ideal.Quotient.mk I (v i), ?_⟩
  rw [weakRegularFamilyCotangentMap_quotientCoordinates]
  apply congrArg (I).toCotangent
  apply Subtype.ext
  exact hv

private theorem familyFunctional_map_ideal_top :
    Submodule.map f (I • (⊤ : Submodule R V)) = (I ^ 2 : Ideal R) := by
  rw [Submodule.map_smul'', Submodule.map_top]
  change I • I = I ^ 2
  rw [smul_eq_mul, pow_two]

private theorem ideal_top_iff_coordinates (v : V) :
    v ∈ I • (⊤ : Submodule R V) ↔ ∀ i : Fin r, v i ∈ I := by
  constructor
  · intro hv
    refine Submodule.smul_induction_on hv ?_ ?_
    · intro a ha w _ i
      change a * w i ∈ I
      exact (I).mul_mem_right (w i) ha
    · intro x y hx hy i
      exact (I).add_mem (hx i) (hy i)
  · intro hv
    rw [← Finset.univ_sum_single v]
    apply Submodule.sum_mem
    intro i _
    have hs : Pi.single i (v i) = (v i) • Pi.single i (1 : R) := by
      funext j
      by_cases hji : j = i <;> simp [hji, smul_eq_mul]
    rw [hs]
    exact Submodule.smul_mem_smul (hv i) Submodule.mem_top

/-- Degree-one Koszul exactness proves the actual conormal kernel formula.
This statement uses the original functional and the original ideal multiple. -/
theorem weakRegularFamilyIdealMap_cotangent_eq_zero_iff
    (hc : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn c)) (v : V) :
    (I).toCotangent (weakRegularFamilyIdealMap R c v) = 0 ↔
      v ∈ I • (⊤ : Submodule R V) := by
  constructor
  · intro hv
    have hfv : f v ∈ (I ^ 2 : Ideal R) :=
      (Ideal.toCotangent_eq_zero I (weakRegularFamilyIdealMap R c v)).mp hv
    have hmem : f v ∈ Submodule.map f (I • (⊤ : Submodule R V)) := by
      rw [familyFunctional_map_ideal_top]
      exact hfv
    obtain ⟨w, hw, hfw⟩ := hmem
    have hrel : f (v - w) = 0 := by rw [map_sub, hfw, sub_self]
    let e := exteriorPower.oneEquiv R V
    let z := e.symm (v - w)
    have hz : KoszulComplex.differential R V f 0 z = 0 := by
      apply (exteriorPower.zeroEquiv R V).injective
      rw [map_zero]
      have h := LinearMap.congr_fun (KoszulComplex.differential_zero_equiv R V f) z
      simp only [LinearMap.comp_apply] at h
      exact h.trans ((congrArg f (e.apply_symm_apply (v - w))).trans hrel)
    obtain ⟨a, ha⟩ := KoszulComplex.finiteFamily_exact_cycles R c hc 0 z hz
    have hdelta : KoszulComplex.differential R V f 1 a ∈
        I • (⊤ : Submodule R (⋀[R]^1 V)) :=
      KoszulComplex.differential_range_le_ideal_smul R V I f le_rfl 1
        (LinearMap.mem_range_self (KoszulComplex.differential R V f 1) a)
    have hmap : Submodule.map e.toLinearMap (I • (⊤ : Submodule R (⋀[R]^1 V))) =
        I • (⊤ : Submodule R V) := by
      rw [Submodule.map_smul'', Submodule.map_top,
        LinearMap.range_eq_top.mpr e.surjective]
    have hboundary : e (KoszulComplex.differential R V f 1 a) ∈
        Submodule.map e.toLinearMap (I • (⊤ : Submodule R (⋀[R]^1 V))) :=
      Submodule.mem_map_of_mem hdelta
    rw [hmap, ha] at hboundary
    change e (e.symm (v - w)) ∈ I • (⊤ : Submodule R V) at hboundary
    rw [LinearEquiv.apply_symm_apply] at hboundary
    have hsum := (I • (⊤ : Submodule R V)).add_mem hboundary hw
    simpa only [sub_add_cancel] using hsum
  · intro hv
    have hfv : f v ∈ Submodule.map f (I • (⊤ : Submodule R V)) :=
      Submodule.mem_map_of_mem hv
    rw [familyFunctional_map_ideal_top] at hfv
    exact (Ideal.toCotangent_eq_zero I (weakRegularFamilyIdealMap R c v)).mpr hfv

/-- Weak regularity makes the literal quotient-coordinate conormal map injective. -/
theorem weakRegularFamilyCotangentMap_injective
    (hc : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn c)) :
    Function.Injective (weakRegularFamilyCotangentMap R c) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  choose v hv using fun i : Fin r => Ideal.Quotient.mk_surjective (x i)
  have hcoords : (fun i => Ideal.Quotient.mk I (v i)) = x := funext hv
  have hz : (I).toCotangent (weakRegularFamilyIdealMap R c v) = 0 :=
    (weakRegularFamilyCotangentMap_quotientCoordinates R c v).symm.trans
      ((congrArg (weakRegularFamilyCotangentMap R c) hcoords).trans hx)
  have hmem := (weakRegularFamilyIdealMap_cotangent_eq_zero_iff R c hc v).mp hz
  have hcoordinate := (ideal_top_iff_coordinates R c v).mp hmem
  funext i
  exact (hv i).symm.trans (Ideal.Quotient.eq_zero_iff_mem.mpr (hcoordinate i))

/-- The actual conormal coordinate map is an equivalence, earned from the Koszul boundaries. -/
def weakRegularFamilyCotangentEquiv
    (hc : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn c)) :
    (Fin r → Q) ≃ₗ[Q] (I).Cotangent :=
  LinearEquiv.ofBijective (weakRegularFamilyCotangentMap R c)
    ⟨weakRegularFamilyCotangentMap_injective R c hc,
      weakRegularFamilyCotangentMap_surjective R c⟩

/-- The equivalence retains the actual linear-combination map of the original generators. -/
theorem weakRegularFamilyCotangentEquiv_toLinearMap
    (hc : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn c)) :
    (weakRegularFamilyCotangentEquiv R c hc).toLinearMap =
      weakRegularFamilyCotangentMap R c := rfl

/-- The literal classes of the displayed weak-regular family form the original conormal basis. -/
def weakRegularFamilyCotangentBasis
    (hc : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn c)) :
    Module.Basis (Fin r) Q (I).Cotangent :=
  Module.Basis.ofEquivFun (weakRegularFamilyCotangentEquiv R c hc).symm

/-- Each basis vector is the actual native cotangent class of its original coefficient. -/
theorem weakRegularFamilyCotangentBasis_apply
    (hc : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn c)) (i : Fin r) :
    weakRegularFamilyCotangentBasis R c hc i =
      (I).toCotangent (weakRegularFamilyGenerator R c i) := by
  classical
  rw [weakRegularFamilyCotangentBasis, Module.Basis.coe_ofEquivFun]
  exact weakRegularFamilyCotangentMap_single R c i

end Ideal
