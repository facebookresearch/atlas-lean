-- Author: @toskua
module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Ideal.Maps

/-!
# The kernel of composite principal quotient maps

Let `f : A → B` and `g : B → C` be homomorphisms of commutative rings, with `f` surjective. If
`ker f = (a)` and `ker g = (f b)` for `a,b : A`, then `ker(g ∘ f)` is the ideal `(a,b)`
generated by the two equations in `A`.

Reference: Dummit and Foote, *Abstract Algebra*, third edition, Section 7.3.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

namespace RingHom

universe u

/-- Let `A,B,C` be commutative rings, `f : A →+* B` a surjective homomorphism, and `g : B →+* C` a
homomorphism. For `a,b : A`, suppose `RingHom.ker f = Ideal.span {a}` and `RingHom.ker g =
Ideal.span {f b}`. Then `RingHom.ker (g.comp f) = Ideal.span {a,b}`. -/
theorem ker_comp_eq_span_pair {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    (f : A →+* B) (g : B →+* C) (hf : Function.Surjective f)
    (a b : A) (ha : RingHom.ker f = Ideal.span {a}) (hb : RingHom.ker g = Ideal.span {f b}) :
    RingHom.ker (g.comp f) = Ideal.span {a, b} := by
  rw [← RingHom.comap_ker, hb]
  have hmap : Ideal.span {f b} = (Ideal.span {b}).map f := by
    rw [Ideal.map_span, Set.image_singleton]
  rw [hmap, Ideal.comap_map_of_surjective f hf, ← RingHom.ker_eq_comap_bot, ha]
  rw [← Ideal.span_union]
  congr 1
  exact Set.pair_comm b a

end RingHom
