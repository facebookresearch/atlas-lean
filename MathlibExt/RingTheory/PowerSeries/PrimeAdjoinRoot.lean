@[expose] public section

open Polynomial IsLocalRing

namespace PolynomialPrimeAdjoinRootAux

variable {W₀ : Type*} [CommRing W₀] [IsDomain W₀] [IsDiscreteValuationRing W₀]

private lemma mem_maximalIdeal_powerSeries_iff (f : PowerSeries W₀) :
    f ∈ maximalIdeal (PowerSeries W₀) ↔
      PowerSeries.constantCoeff f ∈ maximalIdeal W₀ := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]

private lemma map_constantCoeff_maximalIdeal_le :
    (maximalIdeal (PowerSeries W₀)).map (PowerSeries.constantCoeff (R := W₀)) ≤
      maximalIdeal W₀ := by
  rw [Ideal.map_le_iff_le_comap]
  intro f hf
  exact (mem_maximalIdeal_powerSeries_iff f).1 hf

variable {q : ℕ} (hW₀ : maximalIdeal W₀ = Ideal.span {(q : W₀)})

include hW₀ in
private lemma natCast_mem_maximalIdeal : (q : W₀) ∈ maximalIdeal W₀ := by
  rw [hW₀]; exact Ideal.subset_span rfl

include hW₀ in
private lemma natCast_ne_zero : (q : W₀) ≠ 0 := by
  intro h
  have hbot : maximalIdeal W₀ = ⊥ := by
    rw [hW₀, h, Ideal.span_singleton_eq_bot]
  exact IsDiscreteValuationRing.not_isField W₀
    (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot)

include hW₀ in
private lemma natCast_mul_not_mem_sq (u : PowerSeries W₀) (hu : IsUnit u) :
    (q : PowerSeries W₀) * u ∉ maximalIdeal (PowerSeries W₀) ^ 2 := by
  intro hmem
  have h1 : PowerSeries.constantCoeff ((q : PowerSeries W₀) * u) ∈
      (maximalIdeal W₀) ^ 2 := by
    have hmem' := Ideal.mem_map_of_mem (PowerSeries.constantCoeff (R := W₀)) hmem
    rw [Ideal.map_pow] at hmem'
    exact Ideal.pow_right_mono map_constantCoeff_maximalIdeal_le 2 hmem'
  rw [map_mul, map_natCast, hW₀, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton] at h1
  obtain ⟨c, hc⟩ := h1
  have hu0 : IsUnit (PowerSeries.constantCoeff u) :=
    PowerSeries.isUnit_constantCoeff u hu
  have hq0 := PolynomialPrimeAdjoinRootAux.natCast_ne_zero hW₀
  have hcu : PowerSeries.constantCoeff u = (q : W₀) * c := by
    have heq : (q : W₀) * PowerSeries.constantCoeff u =
        (q : W₀) * ((q : W₀) * c) := by
      rw [hc]; ring
    exact mul_left_cancel₀ hq0 heq
  have hmem' : PowerSeries.constantCoeff u ∈ maximalIdeal W₀ := by
    rw [hcu]
    exact Ideal.mul_mem_right _ _ (natCast_mem_maximalIdeal hW₀)
  exact (IsLocalRing.mem_maximalIdeal _ |>.1 hmem') hu0

end PolynomialPrimeAdjoinRootAux

/-- A monic polynomial of degree `q - 1` over `W₀⟦T⟧`, where `W₀` is a
discrete valuation ring whose maximal ideal is generated by `q`, whose
non-leading coefficients lie in the maximal ideal and whose constant
coefficient is `q` times a unit, is prime, and its root adjunction is a
domain. -/
public theorem Polynomial.prime_and_isDomain_adjoinRoot_of_monic_of_coeff_mem_maximalIdeal_powerSeries_of_coeff_zero_eq_natCast_mul
    (q : ℕ) [Fact q.Prime] (hq : 2 ≤ q)
    (W₀ : Type*) [CommRing W₀] [IsDomain W₀] [IsDiscreteValuationRing W₀]
    (hW₀ : maximalIdeal W₀ = Ideal.span {(q : W₀)})
    (g : Polynomial (PowerSeries W₀)) (hgm : g.Monic) (hgdeg : g.natDegree = q - 1)
    (hgcoeff : ∀ i < q - 1, g.coeff i ∈ maximalIdeal (PowerSeries W₀))
    (hg0 : ∃ u : PowerSeries W₀, IsUnit u ∧
      g.coeff 0 = (q : PowerSeries W₀) * u) :
    Prime g ∧ IsDomain (AdjoinRoot g) := by
  classical
  haveI : IsRegularLocalRing (PowerSeries W₀) :=
    PowerSeries.isRegularLocalRing_powerSeries W₀
  have hq1 : 1 ≤ q - 1 := by omega
  obtain ⟨u, hu, hgu⟩ := hg0
  have hg0' : g.coeff 0 ∉ maximalIdeal (PowerSeries W₀) ^ 2 := by
    rw [hgu]
    exact PolynomialPrimeAdjoinRootAux.natCast_mul_not_mem_sq hW₀ u hu
  obtain ⟨hRreg, -⟩ :=
    IsRegularLocalRing.adjoinRoot_of_monic_of_coeff_mem_maximalIdeal_of_coeff_zero_not_mem_sq
      (PowerSeries W₀) g hgm (by rw [hgdeg]; exact hq1)
      (by rw [hgdeg]; exact hgcoeff) hg0'
  haveI := hRreg
  haveI hRdom : IsDomain (AdjoinRoot g) := IsRegularLocalRing.isDomain _
  refine ⟨⟨hgm.ne_zero, ?_, ?_⟩, hRdom⟩
  · intro hunit
    have h1 : g = 1 := hgm.isUnit_iff.mp hunit
    have hdeg : g.natDegree = 0 := by rw [h1, natDegree_one]
    omega
  · intro a b hab
    have h0 : AdjoinRoot.mk g (a * b) = 0 := AdjoinRoot.mk_eq_zero.mpr hab
    rw [map_mul, mul_eq_zero] at h0
    rcases h0 with h | h
    · exact Or.inl (AdjoinRoot.mk_eq_zero.mp h)
    · exact Or.inr (AdjoinRoot.mk_eq_zero.mp h)
