module

public import MathlibExt.RingTheory.PowerSeries.RegularLocalRing
public import MathlibExt.RingTheory.RegularLocalRing.AdjoinRoot
public import MathlibExt.RingTheory.RegularLocalRing.IsDomain
public import Mathlib.RingTheory.PowerSeries.Basic
