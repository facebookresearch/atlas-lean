/-!
# Power series over a regular local ring

The Krull dimension of `R⟦X⟧` is one more than that of `R`, the maximal
ideal of `R⟦X⟧` is generated by the constants from the maximal ideal of `R`
together with `X`, and power series over a regular local ring are regular
local.
-/

@[expose] public section

open IsLocalRing PowerSeries

namespace PowerSeriesRegularAux

variable {R : Type*} [CommRing R]

/-- `X` is a regular element of the power series ring. -/
theorem isSMulRegular_X : IsSMulRegular R⟦X⟧ (X : R⟦X⟧) := by
  intro f g h
  simp only [smul_eq_mul] at h
  ext n
  simpa only [coeff_succ_X_mul] using congrArg (coeff (n + 1)) h

/-- The kernel of the constant coefficient map is the span of `X`. -/
theorem ker_constantCoeff : RingHom.ker (constantCoeff (R := R)) = Ideal.span {(X : R⟦X⟧)} := by
  ext f
  rw [RingHom.mem_ker, Ideal.mem_span_singleton, X_dvd_iff]

/-- Quotienting `R⟦X⟧` by the span of `X` recovers `R`. -/
noncomputable def quotSpanXEquiv : (R⟦X⟧ ⧸ Ideal.span {(X : R⟦X⟧)}) ≃+* R :=
  (Ideal.quotEquivOfEq ker_constantCoeff.symm).trans
    (RingHom.quotientKerEquivOfSurjective constantCoeff_surj)

@[simp]
theorem quotSpanXEquiv_mk (f : R⟦X⟧) :
    quotSpanXEquiv (Ideal.Quotient.mk _ f) = constantCoeff f := by
  simp only [quotSpanXEquiv, RingEquiv.trans_apply, Ideal.quotEquivOfEq]
  rfl

variable [IsLocalRing R]

theorem mem_maximalIdeal_iff {f : R⟦X⟧} :
    f ∈ maximalIdeal R⟦X⟧ ↔ constantCoeff f ∈ maximalIdeal R := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    mem_nonunits_iff, isUnit_iff_constantCoeff]

theorem X_mem_maximalIdeal : (X : R⟦X⟧) ∈ maximalIdeal R⟦X⟧ := by
  rw [mem_maximalIdeal_iff, constantCoeff_X]
  exact zero_mem _

theorem C_mem_maximalIdeal {r : R} (hr : r ∈ maximalIdeal R) :
    (C r : R⟦X⟧) ∈ maximalIdeal R⟦X⟧ := by
  rwa [mem_maximalIdeal_iff, constantCoeff_C]

end PowerSeriesRegularAux

section KrullDim

variable (R : Type*) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]

/-- The Krull dimension of `R⟦X⟧` is one more than that of `R`. -/
theorem PowerSeries.ringKrullDim_powerSeries :
    ringKrullDim R⟦X⟧ = ringKrullDim R + 1 := by
  have hX : (X : R⟦X⟧) ∈ Ring.jacobson R⟦X⟧ := by
    rw [← Ideal.jacobson_bot, IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    exact PowerSeriesRegularAux.X_mem_maximalIdeal
  have h := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_jacobson
    (R := R⟦X⟧) (x := X) PowerSeriesRegularAux.isSMulRegular_X hX
  rw [ringKrullDim_eq_of_ringEquiv (PowerSeriesRegularAux.quotSpanXEquiv (R := R))] at h
  exact h.symm

end KrullDim

section MaximalIdealSpan

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- The maximal ideal of `R⟦X⟧` is generated by the image of a generating set
of the maximal ideal of `R` together with `X`. -/
theorem PowerSeries.maximalIdeal_eq_span_image_union_X {S : Set R}
    (hS : maximalIdeal R = Ideal.span S) :
    maximalIdeal R⟦X⟧ = Ideal.span ((C : R →+* R⟦X⟧) '' S ∪ {(X : R⟦X⟧)}) := by
  apply le_antisymm
  · intro f hf
    have hc : constantCoeff f ∈ maximalIdeal R := PowerSeriesRegularAux.mem_maximalIdeal_iff.mp hf
    have h2 : C (constantCoeff f) ∈
        Ideal.span ((C : R →+* R⟦X⟧) '' S ∪ {(X : R⟦X⟧)}) := by
      refine Ideal.span_mono Set.subset_union_left ?_
      rw [← Ideal.map_span]
      exact Ideal.mem_map_of_mem _ (hS ▸ hc)
    have h1 : f - C (constantCoeff f) ∈
        Ideal.span ((C : R →+* R⟦X⟧) '' S ∪ {(X : R⟦X⟧)}) := by
      refine Ideal.span_mono Set.subset_union_right ?_
      rw [← PowerSeriesRegularAux.ker_constantCoeff, RingHom.mem_ker, map_sub,
        constantCoeff_C, sub_self]
    have heq : f = C (constantCoeff f) + (f - C (constantCoeff f)) := by ring
    rw [heq]
    exact add_mem h2 h1
  · rw [Ideal.span_le]
    rintro g (⟨r, hr, rfl⟩ | rfl)
    · exact PowerSeriesRegularAux.C_mem_maximalIdeal (by rw [hS]; exact Ideal.subset_span hr)
    · exact PowerSeriesRegularAux.X_mem_maximalIdeal

/-- The embedding dimension of `R⟦X⟧` is at most one more than that of `R`. -/
theorem PowerSeries.spanFinrank_maximalIdeal_le_succ [IsNoetherianRing R] :
    (maximalIdeal R⟦X⟧).spanFinrank ≤ (maximalIdeal R).spanFinrank + 1 := by
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (IsNoetherian.noetherian (maximalIdeal R))
  have hS : maximalIdeal R = Ideal.span (s : Set R) := by
    rw [← Ideal.submodule_span_eq, hspan]
  rw [PowerSeries.maximalIdeal_eq_span_image_union_X hS, ← Ideal.submodule_span_eq]
  refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite
    ((s.finite_toSet.image _).union (Set.finite_singleton _))) ?_
  refine le_trans (Set.ncard_union_le _ _) ?_
  rw [Set.ncard_singleton]
  have h1 : ((C : R →+* R⟦X⟧) '' (s : Set R)).ncard ≤ (s : Set R).ncard :=
    Set.ncard_image_le s.finite_toSet
  rw [Set.ncard_coe_finset] at h1
  omega

end MaximalIdealSpan

/-- Power series over a regular local ring are regular local. -/
theorem PowerSeries.isRegularLocalRing_powerSeries (R : Type*) [CommRing R]
    [IsRegularLocalRing R] : IsRegularLocalRing R⟦X⟧ := by
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [PowerSeries.ringKrullDim_powerSeries R,
    ← IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)]
  exact_mod_cast PowerSeries.spanFinrank_maximalIdeal_le_succ (R := R)
