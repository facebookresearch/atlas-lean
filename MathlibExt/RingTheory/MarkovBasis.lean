module

public import MathlibExt.RingTheory.ToricIdeal
public import Mathlib.Logic.Relation
public import Mathlib.Algebra.MonoidAlgebra.MapDomain

/-!
# The fundamental theorem of Markov bases (Diaconis–Sturmfels)

Let `X` be a set of cells and `T : X → ℕ^d` a sufficient statistic. A *Markov basis* is a
family of integer moves `f_i : X → ℤ` with `∑_x f_i(x) T(x) = 0` that connects every fibre
`F_t = {g : X → ℕ : ∑_x g(x) T(x) = t}` by steps `g ↦ g ± f_i` that never leave the
nonnegative orthant. Diaconis and Sturmfels proved that the moves form a Markov basis exactly
when the binomials `x^{f_i⁺} - x^{f_i⁻}` generate the toric ideal `I_T`; this turns the
construction of Metropolis chains for exact conditional tests into a Gröbner basis computation.

Source: P. Diaconis, B. Sturmfels, *Algebraic algorithms for sampling from conditional
distributions*, Ann. Statist. 26 (1998) 363–397, Definition (1.5) and Theorem 3.1.

## Proof

*Markov basis ⇒ generation.* By `toricIdeal_eq_span_binomials`, `I_T` is generated by the
binomials `x^a - x^b` with equal statistics. A path of moves from `a` to `b` writes
`x^a - x^b` as a telescoping sum of terms `± x^c (x^{f_i⁺} - x^{f_i⁻})`.

*Generation ⇒ Markov basis.* Let `~` be the connectivity relation of the moves, an equivalence
relation stable under translation. The `k`-linear map `L : x^a ↦ [a]` to the monoid algebra of
the quotient `ℕ^X / ~` kills `q · (x^{f_i⁺} - x^{f_i⁻})` for every `q`, hence the whole ideal the
binomials generate, so `x^g - x^{g'} ∈ I_T` forces `[g] = [g']`. This replaces the
integer-coefficient induction of the paper by a linear-algebra argument; the paper's standing
assumptions (`X` finite, `T(x) ≠ 0`, finitely many moves) are not needed.
-/

@[expose] public section

noncomputable section

namespace MathlibExt.RingTheory.MarkovBasis

open MvPolynomial MathlibExt.RingTheory.ToricIdeal

variable {X d : Type*}

/-- **Positive part of an integer move.** `f⁺(x) = max(f(x), 0)`
(Diaconis–Sturmfels 1998, Section 3.1). -/
def posPartNat (f : X →₀ ℤ) : X →₀ ℕ :=
  f.mapRange Int.toNat (by simp)

/-- **Negative part of an integer move.** `f⁻(x) = max(-f(x), 0)`, so that `f = f⁺ - f⁻` with
disjoint supports (Diaconis–Sturmfels 1998, Section 3.1). -/
def negPartNat (f : X →₀ ℤ) : X →₀ ℕ :=
  (-f).mapRange Int.toNat (by simp)

/-- **A table of counts as an integer vector.** The coordinatewise cast `ℕ^X → ℤ^X`. -/
def toInt (g : X →₀ ℕ) : X →₀ ℤ :=
  g.mapRange (fun n : ℕ ↦ (n : ℤ)) (by simp)

/-- **Integer form of a sufficient statistic.** `T` viewed with values in `ℤ^d`. -/
def statInt (T : X → d →₀ ℕ) (x : X) : d →₀ ℤ :=
  toInt (T x)

/-- **One step of the moves chain.** `h` is obtained from the table `g` by adding or subtracting
one of the moves `f i` and is again a table of nonnegative counts (Diaconis–Sturmfels 1998,
condition (1.5b) with a single move). -/
def MoveStep {ι : Type*} (f : ι → X →₀ ℤ) (g h : X →₀ ℕ) : Prop :=
  ∃ i, ∃ ε : ℤ, (ε = 1 ∨ ε = -1) ∧ toInt h = toInt g + ε • f i

/-- **Markov basis.** Moves `f_i : X → ℤ` form a Markov basis for the statistic `T` when (a) each
`f_i` lies in the lattice of moves, `∑_x f_i(x) T(x) = 0`, and (b) any two tables `g, g'` with
the same sufficient statistic are joined by a sequence of steps `± f_i` through tables of
nonnegative counts (Diaconis–Sturmfels 1998, Definition (1.5)). -/
def IsMarkovBasis (T : X → d →₀ ℕ) {ι : Type*} (f : ι → X →₀ ℤ) : Prop :=
  (∀ i, Finsupp.linearCombination ℤ (statInt T) (f i) = 0) ∧
    ∀ g g' : X →₀ ℕ, statistic T g = statistic T g' → Relation.ReflTransGen (MoveStep f) g g'

/-- **Binomial of a move.** `x^{f⁺} - x^{f⁻}` (Diaconis–Sturmfels 1998, Theorem 3.1). -/
def moveBinomial (k : Type*) [Field k] (f : X →₀ ℤ) : MvPolynomial X k :=
  monomial (posPartNat f) 1 - monomial (negPartNat f) 1

private theorem toInt_add (a b : X →₀ ℕ) : toInt (a + b) = toInt a + toInt b := by
  ext x; simp [toInt]

private theorem toInt_injective : Function.Injective (toInt : (X →₀ ℕ) → X →₀ ℤ) := by
  intro a b h
  ext x
  have := congrArg (fun f ↦ f x) h
  simpa [toInt] using this

private theorem toInt_posPart_sub_toInt_negPart (f : X →₀ ℤ) :
    toInt (posPartNat f) - toInt (negPartNat f) = f := by
  ext x
  simp [toInt, posPartNat, negPartNat]
  omega

private theorem linearCombination_statInt_toInt (T : X → d →₀ ℕ) (a : X →₀ ℕ) :
    Finsupp.linearCombination ℤ (statInt T) (toInt a) = toInt (statistic T a) := by
  induction a using Finsupp.induction_linear with
  | zero => simp [toInt]
  | add a b ha hb => rw [toInt_add, map_add, ha, hb, map_add, toInt_add]
  | single x n =>
    have h1 : toInt (Finsupp.single x n) = Finsupp.single x (n : ℤ) := by
      ext y; simp [toInt]
    rw [h1, Finsupp.linearCombination_single, Finsupp.linearCombination_single]
    ext y
    simp [statInt, toInt]

/-- **Lattice condition in terms of positive and negative parts.** `∑_x f(x) T(x) = 0` holds if
and only if `f⁺` and `f⁻` have the same sufficient statistic. -/
theorem linearCombination_eq_zero_iff (T : X → d →₀ ℕ) (f : X →₀ ℤ) :
    Finsupp.linearCombination ℤ (statInt T) f = 0 ↔
      statistic T (posPartNat f) = statistic T (negPartNat f) := by
  conv_lhs => rw [← toInt_posPart_sub_toInt_negPart f]
  rw [map_sub, linearCombination_statInt_toInt, linearCombination_statInt_toInt, sub_eq_zero]
  exact toInt_injective.eq_iff

/-- **A move binomial lies in the toric ideal iff the move lies in the lattice of moves.** -/
theorem moveBinomial_mem_toricIdeal_iff (k : Type*) [Field k] (T : X → d →₀ ℕ)
    (f : X →₀ ℤ) :
    moveBinomial k f ∈ toricIdeal k T ↔ Finsupp.linearCombination ℤ (statInt T) f = 0 := by
  rw [moveBinomial, monomial_sub_monomial_mem_toricIdeal_iff, linearCombination_eq_zero_iff]

/-- **Moves can be undone.** A step `g ↦ g + ε f_i` is reversed by the step `-ε f_i`. -/
theorem moveStep_symm {ι : Type*} {f : ι → X →₀ ℤ} {g h : X →₀ ℕ} (hs : MoveStep f g h) :
    MoveStep f h g := by
  obtain ⟨i, ε, hε, he⟩ := hs
  refine ⟨i, -ε, ?_, ?_⟩
  · rcases hε with rfl | rfl <;> simp
  · rw [he, neg_smul]; abel

/-- **Moves are translation invariant.** If `g ↦ h` is a step, so is `g + c ↦ h + c`. -/
theorem moveStep_add {ι : Type*} {f : ι → X →₀ ℤ} {g h : X →₀ ℕ} (c : X →₀ ℕ)
    (hs : MoveStep f g h) : MoveStep f (g + c) (h + c) := by
  obtain ⟨i, ε, hε, he⟩ := hs
  refine ⟨i, ε, hε, ?_⟩
  rw [toInt_add, toInt_add, he]; abel

/-- **Each move joins its negative part to its positive part.** `f⁻ ↦ f⁻ + f = f⁺` is a
step of the chain. -/
theorem moveStep_negPart_posPart {ι : Type*} (f : ι → X →₀ ℤ) (i : ι) :
    MoveStep f (negPartNat (f i)) (posPartNat (f i)) := by
  refine ⟨i, 1, Or.inl rfl, ?_⟩
  rw [one_smul, ← sub_eq_iff_eq_add']
  exact toInt_posPart_sub_toInt_negPart _

/-- **A single move changes `x^g` by a monomial multiple of a move binomial.** If
`h = g ± f_i` with `g, h ≥ 0`, then `x^g - x^h = ∓ x^c (x^{f_i⁺} - x^{f_i⁻})` for some
monomial `x^c`, so it lies in the ideal generated by the move binomials
(Diaconis–Sturmfels 1998, proof of Theorem 3.1). -/
theorem monomial_sub_monomial_mem_span_of_moveStep (k : Type*) [Field k] {ι : Type*}
    {f : ι → X →₀ ℤ} {g h : X →₀ ℕ} (hs : MoveStep f g h) :
    monomial g (1 : k) - monomial h 1 ∈
      Ideal.span (Set.range fun i ↦ moveBinomial k (f i)) := by
  obtain ⟨i, ε, hε, he⟩ := hs
  have hmem : moveBinomial k (f i) ∈ Ideal.span (Set.range fun i ↦ moveBinomial k (f i)) :=
    Ideal.subset_span ⟨i, rfl⟩
  have hpt : ∀ x, (h x : ℤ) = g x + ε * f i x := by
    intro x
    have := congrArg (fun F ↦ F x) he
    simpa [toInt] using this
  rcases hε with rfl | rfl
  · -- `h = g + f`: write `g = e + f⁻` and `h = e + f⁺`.
    set e : X →₀ ℕ := g - negPartNat (f i)
    have hg : g = e + negPartNat (f i) := by
      ext x
      have := hpt x
      simp only [e, Finsupp.add_apply, Finsupp.tsub_apply, negPartNat, Finsupp.mapRange_apply,
        Finsupp.neg_apply]
      omega
    have hh : h = e + posPartNat (f i) := by
      ext x
      have := hpt x
      simp only [e, Finsupp.add_apply, Finsupp.tsub_apply, negPartNat, posPartNat,
        Finsupp.mapRange_apply, Finsupp.neg_apply]
      omega
    have : monomial g (1 : k) - monomial h 1 = -(monomial e 1 * moveBinomial k (f i)) := by
      rw [hg, hh, moveBinomial, mul_sub, monomial_mul_monomial, monomial_mul_monomial, mul_one]
      ring
    rw [this]
    exact neg_mem (Ideal.mul_mem_left _ _ hmem)
  · -- `h = g - f`: write `g = e + f⁺` and `h = e + f⁻`.
    set e : X →₀ ℕ := g - posPartNat (f i)
    have hg : g = e + posPartNat (f i) := by
      ext x
      have := hpt x
      simp only [e, Finsupp.add_apply, Finsupp.tsub_apply, posPartNat, Finsupp.mapRange_apply]
      omega
    have hh : h = e + negPartNat (f i) := by
      ext x
      have := hpt x
      simp only [e, Finsupp.add_apply, Finsupp.tsub_apply, negPartNat, posPartNat,
        Finsupp.mapRange_apply, Finsupp.neg_apply]
      omega
    have : monomial g (1 : k) - monomial h 1 = monomial e 1 * moveBinomial k (f i) := by
      rw [hg, hh, moveBinomial, mul_sub, monomial_mul_monomial, monomial_mul_monomial, mul_one]
    rw [this]
    exact Ideal.mul_mem_left _ _ hmem

/-- The connectivity relation of the moves, an equivalence relation. -/
private def moveSetoid {ι : Type*} (f : ι → X →₀ ℤ) : Setoid (X →₀ ℕ) where
  r := Relation.ReflTransGen (MoveStep f)
  iseqv := by
    refine ⟨fun _ ↦ Relation.ReflTransGen.refl, fun h ↦ ?_, Relation.ReflTransGen.trans⟩
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | tail _ hs ih => exact Relation.ReflTransGen.head (moveStep_symm hs) ih

private theorem moveSetoid_add {ι : Type*} {f : ι → X →₀ ℤ} {g h : X →₀ ℕ} (c : X →₀ ℕ)
    (hgh : Relation.ReflTransGen (MoveStep f) g h) :
    Relation.ReflTransGen (MoveStep f) (g + c) (h + c) := by
  induction hgh with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hs ih => exact Relation.ReflTransGen.tail ih (moveStep_add c hs)

/-- The linear map `x^a ↦ [a]` to the monoid algebra of the connectivity classes. -/
private def classMap (k : Type*) [Field k] {ι : Type*} (f : ι → X →₀ ℤ)
    (p : MvPolynomial X k) : AddMonoidAlgebra k (Quotient (moveSetoid f)) :=
  AddMonoidAlgebra.mapDomain (Quotient.mk (moveSetoid f)) p

private theorem classMap_monomial (k : Type*) [Field k] {ι : Type*} (f : ι → X →₀ ℤ)
    (a : X →₀ ℕ) (c : k) :
    classMap k f (monomial a c) = AddMonoidAlgebra.single (Quotient.mk (moveSetoid f) a) c := by
  simp only [classMap, ← single_eq_monomial, AddMonoidAlgebra.mapDomain_single]

private theorem classMap_add (k : Type*) [Field k] {ι : Type*} (f : ι → X →₀ ℤ)
    (p q : MvPolynomial X k) : classMap k f (p + q) = classMap k f p + classMap k f q :=
  AddMonoidAlgebra.mapDomain_add _ _ _

private theorem classMap_sub (k : Type*) [Field k] {ι : Type*} (f : ι → X →₀ ℤ)
    (p q : MvPolynomial X k) : classMap k f (p - q) = classMap k f p - classMap k f q := by
  rw [eq_sub_iff_add_eq, ← classMap_add, sub_add_cancel]

private theorem classMap_zero (k : Type*) [Field k] {ι : Type*} (f : ι → X →₀ ℤ) :
    classMap k f 0 = 0 :=
  AddMonoidAlgebra.mapDomain_zero _

/-- The ideal of polynomials all of whose multiples are killed by `classMap`. -/
private def classKernel (k : Type*) [Field k] {ι : Type*} (f : ι → X →₀ ℤ) :
    Ideal (MvPolynomial X k) where
  carrier := {p | ∀ q, classMap k f (q * p) = 0}
  add_mem' {p₁ p₂} h₁ h₂ q := by rw [mul_add, classMap_add, h₁ q, h₂ q, add_zero]
  zero_mem' q := by rw [mul_zero, classMap_zero]
  smul_mem' r p hp q := by rw [smul_eq_mul, ← mul_assoc]; exact hp (q * r)

private theorem moveBinomial_mem_classKernel (k : Type*) [Field k] {ι : Type*}
    (f : ι → X →₀ ℤ) (i : ι) : moveBinomial k (f i) ∈ classKernel k f := by
  intro q
  induction q using MvPolynomial.induction_on' with
  | add p q hp hq => rw [add_mul, classMap_add, hp, hq, add_zero]
  | monomial c a =>
    rw [moveBinomial, mul_sub, monomial_mul_monomial, monomial_mul_monomial, mul_one, classMap_sub,
      classMap_monomial, classMap_monomial, sub_eq_zero]
    congr 1
    refine Quotient.sound ?_
    change Relation.ReflTransGen (MoveStep f) _ _
    refine (moveSetoid f).symm ?_
    rw [add_comm c, add_comm c]
    exact moveSetoid_add c (Relation.ReflTransGen.single (moveStep_negPart_posPart f i))

/-- **Fundamental theorem of Markov bases** (Diaconis–Sturmfels, Ann. Statist. 26 (1998),
Theorem 3.1). Over any field `k`, moves `f_i : X → ℤ` form a Markov basis for the sufficient
statistic `T : X → ℕ^d` if and only if the binomials `x^{f_i⁺} - x^{f_i⁻}` generate the toric
ideal `I_T = ker(x ↦ t^{T(x)})`. The paper assumes `X` finite, `T(x) ≠ 0` and finitely many
moves; the statement holds without these assumptions. -/
theorem isMarkovBasis_iff_span_eq_toricIdeal (k : Type*) [Field k] (T : X → d →₀ ℕ)
    {ι : Type*} (f : ι → X →₀ ℤ) :
    IsMarkovBasis T f ↔ Ideal.span (Set.range fun i ↦ moveBinomial k (f i)) = toricIdeal k T := by
  constructor
  · rintro ⟨hlat, hconn⟩
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact (moveBinomial_mem_toricIdeal_iff k T (f i)).2 (hlat i)
    · rw [toricIdeal_eq_span_binomials, Ideal.span_le]
      rintro _ ⟨a, b, hab, rfl⟩
      have hab' := hconn a b hab
      clear hab
      induction hab' with
      | refl => simp
      | @tail b c _ hs ih =>
        have := add_mem ih (monomial_sub_monomial_mem_span_of_moveStep k hs)
        rwa [sub_add_sub_cancel] at this
  · intro hspan
    refine ⟨fun i ↦ ?_, fun g g' hgg' ↦ ?_⟩
    · rw [← moveBinomial_mem_toricIdeal_iff k T, ← hspan]
      exact Ideal.subset_span ⟨i, rfl⟩
    · have hmem : monomial g (1 : k) - monomial g' 1 ∈ classKernel k f := by
        have h1 : monomial g (1 : k) - monomial g' 1 ∈ toricIdeal k T :=
          (monomial_sub_monomial_mem_toricIdeal_iff k T).2 hgg'
        rw [← hspan] at h1
        refine (Ideal.span_le.2 ?_) h1
        rintro _ ⟨i, rfl⟩
        exact moveBinomial_mem_classKernel k f i
      have h0 := hmem 1
      rw [one_mul, classMap_sub, classMap_monomial, classMap_monomial, sub_eq_zero,
        AddMonoidAlgebra.single_left_inj one_ne_zero] at h0
      exact Quotient.exact h0

end MathlibExt.RingTheory.MarkovBasis
