module

public import Mathlib.Algebra.Category.Ring.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import Mathlib.RingTheory.Localization.Ideal
public import MathlibExt.RingTheory.DeltaRing
public import MathlibExt.RingTheory.DerivedAdicCompleteness

/-!
# General bounded prisms and their actual delta maps

The ideal is locally generated by a non-zero-divisor on principal
neighborhoods of every prime. A global generator is not chosen.
Completeness uses actual localization-derived-Hom vanishing for `(p,I)`.
Boundedness is bounded `p`-power torsion in the actual quotient `A/I`.

References: Bhatt--Scholze, *Prisms and prismatic cohomology*,
arXiv:1905.08229v4, Definition 3.2 and Lemma 3.5, pp28--29.
The delta-ring primitive is the completed attributed TauCeti port.
-/

@[expose] public noncomputable section

namespace MathlibExt.RingTheory.BoundedPrisms

open CategoryTheory
open MathlibExt.RingTheory

universe u

variable (p : ℕ) [Fact p.Prime]

/-- An effective Cartier ideal on the actual affine scheme. -/
def IsCartierIdeal {A : Type u} [CommRing A] (I : Ideal A) : Prop :=
  ∀ x : PrimeSpectrum A, ∃ f : A, f ∉ x.asIdeal ∧
    ∃ a : Localization.Away f, IsRegular a ∧
      I.map (algebraMap A (Localization.Away f)) = Ideal.span {a}

/-- The actual completion ideal of a prism. -/
def completionIdeal {A : Type u} [CommRing A] (I : Ideal A) :
    Ideal A :=
  Ideal.span {(p : A)} ⊔ I

/-- Bounded torsion in the actual residue ring, with one uniform bound. -/
def HasBoundedTorsion {A : Type u} [CommRing A] (I : Ideal A) : Prop :=
  ∃ N : ℕ, ∀ (x : A ⧸ I) (n : ℕ),
    (p : A ⧸ I) ^ n * x = 0 → (p : A ⧸ I) ^ N * x = 0

/-- A bounded prism, with its ring, actual ideal and defining conditions. -/
structure Prism where
  ring : CommRingCat.{u}
  [delta : DeltaRing p ring]
  ideal : Ideal ring
  cartier : IsCartierIdeal ideal
  complete : DerivedAdicCompleteness.IsCompleteRing ring
    (completionIdeal p ideal)
  p_mem : (p : ring) ∈ ideal ⊔
    ideal.map (DeltaRing.frobenius p ring)
  bounded : HasBoundedTorsion p ideal

attribute [instance] Prism.delta

/-- The actual residue ring of the prism. -/
abbrev Prism.Residue (P : Prism.{u} p) := P.ring ⧸ P.ideal

/-- A prism map is an actual delta-ring map preserving the actual ideal. -/
structure Hom (P Q : Prism.{u} p) where
  hom : P.ring →+* Q.ring
  delta : ∀ a : P.ring, hom (DeltaRing.delta p a) =
    DeltaRing.delta p (hom a)
  ideal : P.ideal.map hom ≤ Q.ideal

/-- Prism maps preserve the actual Frobenius lift. -/
theorem Hom.frobenius {P Q : Prism.{u} p} (f : Hom p P Q)
    (a : P.ring) :
    f.hom (DeltaRing.frobenius p P.ring a) =
      DeltaRing.frobenius p Q.ring (f.hom a) := by
  simp only [DeltaRing.frobenius_apply, map_add, map_pow, map_mul,
    map_natCast, f.delta]

/-- The identity actual delta-ring map. -/
def Hom.id (P : Prism.{u} p) : Hom p P P where
  hom := RingHom.id _
  delta _ := rfl
  ideal := by simp

/-- Composition is composition of the actual ring maps. -/
def Hom.comp {P Q R : Prism.{u} p}
    (f : Hom p P Q) (g : Hom p Q R) : Hom p P R where
  hom := g.hom.comp f.hom
  delta a := by
    change g.hom (f.hom (DeltaRing.delta p a)) = _
    rw [f.delta, g.delta]
    rfl
  ideal := by
    rw [← Ideal.map_map]
    exact (Ideal.map_mono f.ideal).trans g.ideal

@[ext] theorem Hom.ext {P Q : Prism.{u} p} (f g : Hom p P Q)
    (h : f.hom = g.hom) : f = g := by
  cases f
  cases g
  cases h
  rfl

instance : Category (Prism.{u} p) where
  Hom := Hom p
  id := Hom.id p
  comp := Hom.comp p
  id_comp _ := by apply Hom.ext; ext a; rfl
  comp_id _ := by apply Hom.ext; ext a; rfl
  assoc _ _ _ := by apply Hom.ext; ext a; rfl

/-- The canonical map on actual quotient rings. -/
def Hom.residue {P Q : Prism.{u} p} (f : P ⟶ Q) :
    P.Residue →+* Q.Residue :=
  Ideal.Quotient.lift P.ideal
    ((Ideal.Quotient.mk Q.ideal).comp f.hom) (by
      intro a ha
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (f.ideal (Ideal.mem_map_of_mem f.hom ha)))

/-- The quotient map is fixed on every ring element. -/
@[simp] theorem Hom.residue_mk {P Q : Prism.{u} p} (f : P ⟶ Q)
    (a : P.ring) :
    Hom.residue p f (Ideal.Quotient.mk P.ideal a) =
      Ideal.Quotient.mk Q.ideal (f.hom a) := rfl

end MathlibExt.RingTheory.BoundedPrisms
