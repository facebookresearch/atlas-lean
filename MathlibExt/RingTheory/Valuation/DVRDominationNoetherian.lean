/-!
# Discrete valuation rings dominating a Noetherian local domain

Let `R` be a Noetherian local domain which is not a field, with fraction field `K`. The
statements assume `IsFractionRing R K` for the field `K` and no separate `IsDomain R`: the
embedding of `R` into `K` makes `R` a domain.

* `IsLocalRing.exists_subalgebra_dominating_krullDimLE_one`: there is a local Noetherian ring
  `R'` of dimension one with `R ⊆ R' ⊆ K` dominating `R`, with `R → R'` essentially of finite
  type (Stacks project, Lemma 10.119.1, Tag 00P8).
* `IsLocalRing.exists_isDiscreteValuationRing_dominating_of_finite`: for a finite extension `L`
  of `K`, some discrete valuation ring with fraction field `L` dominates `R`.
* `IsLocalRing.exists_isDiscreteValuationRing_dominating_of_essFiniteType`: the same for a
  finitely generated field extension `L` of `K`, stated as `Algebra.EssFiniteType K L`, which is
  equivalent by `IntermediateField.fg_top_iff` (Stacks project, Lemma 10.119.13, Tag 00PH).

The proofs follow the Stacks project: for Tag 00P8, a valuation ring of `K` dominating `R`
selects a generator `x` of the maximal ideal `𝔪` of least additive valuation (that is, of largest
`V.valuation` in Mathlib's multiplicative convention), `𝔪` generates the proper
principal ideal `x S` of `S = R[g / x]`, and `S` localized at a minimal prime over `x S` has
dimension one by Krull's principal ideal theorem and is essentially of finite type over `R`, as a
localization of the finite type `R`-algebra `S`; Tag 00PH reduces to a finite extension
through a finite transcendence basis `x₁, …, x_r` and the localization of `R[x₁, …, x_r]` at
the prime generated by `𝔪` and the `xᵢ`, then to dimension one by Tag 00P8, where
`IsLocalRing.exists_isDiscreteValuationRing_dominating` applies.

References: The Stacks project, https://stacks.math.columbia.edu, Commutative Algebra,
Section 10.119, Lemma 10.119.1 (Tag 00P8) and Lemma 10.119.13 (Tag 00PH).
-/

set_option autoImplicit false

@[expose] public section

open IsLocalRing

namespace IsLocalRing

variable {R K : Type*} [CommRing R] [Field K] [Algebra R K] [IsFractionRing R K]

open IntermediateField.algebraAdjoinAdjoin in
/-- Step 1 of the transcendental reduction: a finitely generated field extension has a finite
transcendence basis over which it is finite. -/
private lemma exists_finite_transcendenceBasis {L : Type*} [Field L] [Algebra K L]
    [Algebra.EssFiniteType K L] :
    ∃ t : Set L, Finite t ∧ IsTranscendenceBasis K ((↑) : t → L) ∧
      Module.Finite (IntermediateField.adjoin K (Set.range ((↑) : t → L))) L := by
  classical
  obtain ⟨s, hs⟩ := IntermediateField.fg_top K L
  have halg : Algebra.IsAlgebraic (Algebra.adjoin K (s : Set L)) L := by
    refine ⟨fun y ↦ ?_⟩
    have hy : y ∈ IntermediateField.adjoin K (s : Set L) := hs ▸ IntermediateField.mem_top
    exact (Algebra.IsAlgebraic.isAlgebraic
      (⟨y, hy⟩ : IntermediateField.adjoin K (s : Set L))).algebraMap
  obtain ⟨t, hts, ht⟩ := exists_isTranscendenceBasis_subset (R := K) (s : Set L)
  have hfin : Finite t := (s.finite_toSet.subset hts).to_subtype
  refine ⟨t, hfin, ht, ?_⟩
  set F := IntermediateField.adjoin K (Set.range ((↑) : t → L))
  have : Algebra.IsAlgebraic F L := ht.isAlgebraic_field
  have : Algebra.EssFiniteType F L := .of_comp K F L
  exact Algebra.finite_of_essFiniteType_of_isAlgebraic

/-- Step 2 of the transcendental reduction: for `x : ι → L` algebraically independent over the
fraction field `K` of `R`, the field `K(x)` is a fraction field of `R[X_i : i ∈ ι]`, through
`X_i ↦ x i`. -/
private lemma isFractionRing_mvPolynomial [IsDomain R] {ι L : Type*} [Field L] [Algebra R L]
    [Algebra K L] [IsScalarTower R K L] {x : ι → L} (hx : AlgebraicIndependent K x)
    [Algebra (MvPolynomial ι R) (IntermediateField.adjoin K (Set.range x))]
    (h : ∀ p, ((algebraMap (MvPolynomial ι R) (IntermediateField.adjoin K (Set.range x)) p : L)
      = MvPolynomial.aeval x p)) :
    IsFractionRing (MvPolynomial ι R) (IntermediateField.adjoin K (Set.range x)) := by
  classical
  let _ : Algebra (MvPolynomial ι R) (MvPolynomial ι K) := MvPolynomial.algebraMvPolynomial
  have hxR : AlgebraicIndependent R x := hx.restrictScalars (IsFractionRing.injective R K)
  have hinj : Function.Injective
      (algebraMap (MvPolynomial ι R) (IntermediateField.adjoin K (Set.range x))) := by
    intro p q hpq
    apply hxR
    rw [← h, ← h, hpq]
  let e := hx.aevalEquivField
  have he : ∀ a : MvPolynomial ι K,
      ((e (algebraMap _ (FractionRing (MvPolynomial ι K)) a) : _) : L) = MvPolynomial.aeval x a :=
    hx.aevalEquivField_algebraMap_apply_coe
  have hmap : ∀ p : MvPolynomial ι R,
      MvPolynomial.aeval x (algebraMap (MvPolynomial ι R) (MvPolynomial ι K) p) =
        MvPolynomial.aeval x p := by
    intro p
    exact MvPolynomial.aeval_map_algebraMap K x p
  have : IsLocalization ((nonZeroDivisors R).map (MvPolynomial.C (σ := ι))) (MvPolynomial ι K) :=
    MvPolynomial.isLocalization (nonZeroDivisors R) K
  have hC : ∀ c ∈ (nonZeroDivisors R).map (MvPolynomial.C (σ := ι)),
      MvPolynomial.aeval x c ≠ 0 := by
    rintro _ ⟨c, hc, rfl⟩
    rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply R K L]
    exact (map_ne_zero _).2 (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hc)
  refine
    { map_units := fun y ↦ IsUnit.mk0 _ ((map_ne_zero_iff _ hinj).2 (nonZeroDivisors.ne_zero y.2))
      surj := fun z ↦ ?_
      exists_of_eq := fun {p q} hpq ↦ ⟨1, by simpa using hinj hpq⟩ }
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (MvPolynomial ι K)) (e.symm z)
  obtain ⟨⟨a', c⟩, ha⟩ :=
    IsLocalization.surj ((nonZeroDivisors R).map (MvPolynomial.C (σ := ι))) a
  obtain ⟨⟨b', d⟩, hb⟩ :=
    IsLocalization.surj ((nonZeroDivisors R).map (MvPolynomial.C (σ := ι))) b.1
  simp only at hab ha hb
  have hab' : (z : L) * MvPolynomial.aeval x b.1 = MvPolynomial.aeval x a := by
    have := congrArg (fun w ↦ ((e w : _) : L)) hab
    simpa [map_mul, he] using this
  have ha' : MvPolynomial.aeval x a * MvPolynomial.aeval x c.1 = MvPolynomial.aeval x a' := by
    have := congrArg (MvPolynomial.aeval x) ha
    rwa [map_mul, hmap, hmap] at this
  have hb' : MvPolynomial.aeval x b.1 * MvPolynomial.aeval x d.1 = MvPolynomial.aeval x b' := by
    have := congrArg (MvPolynomial.aeval x) hb
    rwa [map_mul, hmap, hmap] at this
  have hb0 : MvPolynomial.aeval x b.1 ≠ 0 := by
    intro h0
    exact nonZeroDivisors.ne_zero b.2 (hx (by rw [h0, map_zero]))
  have hbc : b' * c.1 ∈ nonZeroDivisors (MvPolynomial ι R) := by
    refine mem_nonZeroDivisors_of_ne_zero fun h0 ↦ ?_
    have := congrArg (MvPolynomial.aeval x) h0
    rw [map_mul, ← hb', map_zero] at this
    exact mul_ne_zero (mul_ne_zero hb0 (hC _ d.2)) (hC _ c.2) this
  refine ⟨⟨a' * d.1, ⟨b' * c.1, hbc⟩⟩, Subtype.ext ?_⟩
  simp only [IntermediateField.coe_mul, h, map_mul]
  rw [← ha', ← hb', ← hab']
  ring

variable [IsNoetherianRing R] [IsLocalRing R]

/-- **A one-dimensional local ring dominating a Noetherian local domain.** Let `R` be a Noetherian
local ring with fraction field `K` (so `R` is a domain, as `IsFractionRing R K` embeds it in `K`),
and assume that `R` is not a field. Then there is an `R`-subalgebra `R'` of `K` which is a local
Noetherian ring of Krull dimension at most one and not a field (so of dimension exactly one), into
whose maximal ideal the maximal ideal of `R` maps (`R'` dominates `R`), and which is essentially
of finite type over `R`.

This is the Stacks project, Lemma 10.119.1 (Tag 00P8): "Let `R` be a local Noetherian domain
with fraction field `K`. Assume `R` is not a field. Then there exist `R ⊂ R' ⊂ K` with `R'` local
Noetherian of dimension `1`, `R → R'` a local ring map, i.e., `R'` dominates `R`, and `R → R'`
essentially of finite type." -/
theorem exists_subalgebra_dominating_krullDimLE_one (hR : ¬ IsField R) :
    ∃ (S : Subalgebra R K) (_ : IsLocalRing S), IsNoetherianRing S ∧ Ring.KrullDimLE 1 S ∧
      ¬ IsField S ∧ (∀ r ∈ maximalIdeal R, algebraMap R S r ∈ maximalIdeal S) ∧
      Algebra.EssFiniteType R S := by
  classical
  have hinj : Function.Injective (algebraMap R K) := IsFractionRing.injective R K
  -- a valuation subring `V` of `K` dominating `R`
  obtain ⟨V, hmem, hloc⟩ := IsLocalRing.exists_factor_valuationRing (algebraMap R K)
  have hnon : ∀ r ∈ maximalIdeal R, algebraMap R K r ∈ V.nonunits := fun r hr ↦
    V.mem_nonunits_iff_exists_mem_maximalIdeal.2
      ⟨hmem r, fun hu ↦ hr (hu.of_map ((algebraMap R K).codRestrict V.toSubring hmem) r)⟩
  -- generators of the maximal ideal, and one of least additive valuation, i.e. of largest
  -- `V.valuation`
  obtain ⟨t, ht⟩ := (IsNoetherian.noetherian (maximalIdeal R) : (maximalIdeal R).FG)
  have hm : maximalIdeal R ≠ ⊥ := fun h ↦ hR ((isField_iff_maximalIdeal_eq).2 h)
  have htne : t.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    rintro rfl
    exact hm (by simpa using ht.symm)
  obtain ⟨x, hxt, hxmax⟩ := t.exists_max_image (fun g ↦ V.valuation (algebraMap R K g)) htne
  have hxm : x ∈ maximalIdeal R := ht ▸ Ideal.subset_span hxt
  have hx0 : x ≠ 0 := by
    intro hx
    apply hm
    rw [← ht, eq_bot_iff, Ideal.span_le]
    intro g hg
    have h1 := hxmax g hg
    rw [hx, map_zero, map_zero] at h1
    have : algebraMap R K g = 0 := by simpa using h1
    exact (hinj (this.trans (map_zero _).symm) : g = 0) ▸ zero_mem _
  set xK := algebraMap R K x with hxK
  have hxK0 : xK ≠ 0 := fun h ↦ hx0 (hinj (h.trans (map_zero _).symm))
  -- the ring `S₀ = R[g / x : g ∈ t]`
  let gens : Finset K := t.image fun g ↦ algebraMap R K g / xK
  let S₀ : Subalgebra R K := Algebra.adjoin R (gens : Set K)
  let Vs : Subalgebra R K :=
    { V.toSubring with algebraMap_mem' := hmem }
  have hS₀V : S₀ ≤ Vs := by
    refine Algebra.adjoin_le ?_
    intro y hy
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hy)
    change algebraMap R K g / xK ∈ V
    rw [← V.valuation_le_one_iff, map_div₀]
    have h1 := hxmax g hg
    exact div_le_one_of_le₀ h1 (by simp)
  have hgen : ∀ g ∈ t, algebraMap R K g / xK ∈ S₀ := fun g hg ↦
    Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_image_of_mem _ hg))
  let xS : S₀ := algebraMap R S₀ x
  have hdom : (maximalIdeal R).map (algebraMap R S₀) ≤ Ideal.span {xS} := by
    rw [← ht, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_span_singleton']
    refine ⟨⟨_, hgen g hg⟩, Subtype.ext ?_⟩
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, xS]
    rw [div_mul_cancel₀ _ hxK0]
  have hprop : Ideal.span {xS} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    rintro ⟨u, hu⟩
    have hv : ((u⁻¹ : S₀ˣ) : S₀).1 ∈ V := hS₀V (u⁻¹ : S₀ˣ).1.2
    have h1 : xK * ((u⁻¹ : S₀ˣ) : S₀).1 = 1 := by
      have := congrArg Subtype.val (u.mul_inv)
      rw [hu] at this
      simpa [xS] using this
    have hxV := (V.mem_nonunits_iff).1 (hnon x hxm)
    have h2 : V.valuation xK * V.valuation ((u⁻¹ : S₀ˣ) : S₀).1 = 1 := by
      rw [← map_mul, h1, map_one]
    have h3 := (V.valuation_le_one_iff _).2 hv
    have : (1 : _) ≤ V.valuation xK := by
      calc (1 : _) = V.valuation xK * V.valuation ((u⁻¹ : S₀ˣ) : S₀).1 := h2.symm
        _ ≤ V.valuation xK * 1 := by gcongr
        _ = V.valuation xK := mul_one _
    exact absurd this (not_le.2 hxV)
  -- a minimal prime `q` over `x S₀`, and `S = (S₀)_q` inside `K`
  obtain ⟨M, hM, hxM⟩ := Ideal.exists_le_maximal _ hprop
  obtain ⟨q, hq, -⟩ := Ideal.exists_minimalPrimes_le hxM
  have hqp : q.IsPrime := hq.1.1
  have hxq : xS ∈ q := hq.1.2 (Ideal.subset_span rfl)
  have : Algebra.FiniteType R S₀ :=
    (Subalgebra.fg_iff_finiteType _).1 (Subalgebra.fg_adjoin_finset gens)
  have : IsNoetherianRing S₀ := Algebra.FiniteType.isNoetherianRing R S₀
  have hle : q.primeCompl ≤ nonZeroDivisors S₀ := q.primeCompl_le_nonZeroDivisors
  let T : Subalgebra S₀ K := Localization.subalgebra.ofField K q.primeCompl hle
  have : IsLocalization.AtPrime T q := by
    unfold IsLocalization.AtPrime
    exact Localization.subalgebra.isLocalization_ofField K q.primeCompl hle
  have hTloc : IsLocalRing T := IsLocalization.AtPrime.isLocalRing T q
  have hxT : algebraMap S₀ T xS ∈ maximalIdeal T :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff T q xS).2 hxq
  have hxT0 : algebraMap S₀ T xS ≠ 0 := by
    intro h
    have := congrArg Subtype.val h
    exact hx0 (by simpa [xS] using this)
  let S : Subalgebra R K := T.restrictScalars R
  -- clause (3): `S₀` is of finite type over `R` and `S = (S₀)_q`
  have : Algebra.EssFiniteType S₀ T := .of_isLocalization T q.primeCompl
  have hess : Algebra.EssFiniteType R T := .comp R S₀ T
  refine ⟨S, hTloc, IsLocalization.isNoetherianRing q.primeCompl T inferInstance, ?_, ?_, ?_,
    hess⟩
  · refine ⟨?_⟩
    change ringKrullDim T ≤ 1
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height q T]
    exact_mod_cast Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ q hq
  · intro hS
    have hT : IsField T := hS
    apply hxT0
    have h := (isField_iff_maximalIdeal_eq).1 hT
    rw [h] at hxT
    exact hxT
  · intro r hr
    have h1 : algebraMap R S₀ r ∈ q := hq.1.2 (hdom (Ideal.mem_map_of_mem _ hr))
    have h2 := (IsLocalization.AtPrime.to_map_mem_maximal_iff T q _).2 h1
    exact h2

/-- **Discrete valuation rings dominating a Noetherian local domain, finite extensions.** Let `R`
be a Noetherian local ring which is not a field, `K` its fraction field (so `R` is a domain, as
`IsFractionRing R K` embeds it in `K`) and `L` a finite extension of `K`. Then there is a valuation
subring `V` of `L` (whose fraction field is `L`) which is a discrete valuation ring and dominates
`R`: it contains the image of `R`, and the image of the maximal ideal of `R` consists of nonunits
of `V`.

This is the Stacks project, Lemma 10.119.13 (Tag 00PH), for a finite extension `L/K`; the
dimension of `R` is reduced to one by Lemma 10.119.1 (Tag 00P8). -/
theorem exists_isDiscreteValuationRing_dominating_of_finite (hR : ¬ IsField R)
    {L : Type*} [Field L] [Algebra R L] [Algebra K L] [IsScalarTower R K L] [Module.Finite K L] :
    ∃ V : ValuationSubring L, IsDiscreteValuationRing V ∧ (∀ r : R, algebraMap R L r ∈ V) ∧
      ∀ r ∈ maximalIdeal R, algebraMap R L r ∈ V.nonunits := by
  obtain ⟨S, hloc, hnoeth, hdim, hfield, hdom, -⟩ :=
    exists_subalgebra_dominating_krullDimLE_one (K := K) hR
  obtain ⟨V, hV, hmem, hnon⟩ :=
    exists_isDiscreteValuationRing_dominating (R := S) (K := K) (L := L) hfield
  have key : ∀ r : R, algebraMap R L r = algebraMap S L (algebraMap R S r) := by
    intro r
    rw [IsScalarTower.algebraMap_apply R K L]
    rfl
  refine ⟨V, hV, fun r ↦ key r ▸ hmem _, fun r hr ↦ key r ▸ hnon _ (hdom r hr)⟩

/-- **Discrete valuation rings dominating a Noetherian local domain.** Let `R` be a Noetherian local
ring which is not a field, `K` its fraction field (so `R` is a domain, as `IsFractionRing R K`
embeds it in `K`) and `L` a finitely generated field extension of `K`, stated as
`Algebra.EssFiniteType K L` (equivalent to `⊤ : IntermediateField K L` being
finitely generated, by `IntermediateField.fg_top_iff`). Then there is a valuation subring `V` of
`L` (whose fraction field is `L`) which is a discrete valuation ring and dominates `R`: it
contains the image of `R`, and the image of the maximal ideal of `R` consists of nonunits of `V`.

This is the Stacks project, Lemma 10.119.13 (Tag 00PH): "Let `R` be a Noetherian local domain
with fraction field `K`. Assume that `R` is not a field. Let `L/K` be a finitely generated field
extension. Then there exists discrete valuation ring `A` with fraction field `L` which dominates
`R`." -/
theorem exists_isDiscreteValuationRing_dominating_of_essFiniteType (hR : ¬ IsField R)
    {L : Type*} [Field L] [Algebra R L] [Algebra K L] [IsScalarTower R K L]
    [Algebra.EssFiniteType K L] :
    ∃ V : ValuationSubring L, IsDiscreteValuationRing V ∧ (∀ r : R, algebraMap R L r ∈ V) ∧
      ∀ r ∈ maximalIdeal R, algebraMap R L r ∈ V.nonunits := by
  classical
  have : IsDomain R := Function.Injective.isDomain (algebraMap R K) (IsFractionRing.injective R K)
  obtain ⟨t, hfin, ht, hLfin⟩ := exists_finite_transcendenceBasis (K := K) (L := L)
  set x : t → L := (↑)
  set F := IntermediateField.adjoin K (Set.range x)
  let x' : t → F := fun i ↦ ⟨x i, IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩⟩
  let P := MvPolynomial t R
  let _ : Algebra P F := (MvPolynomial.aeval x').toRingHom.toAlgebra
  have hPF : ∀ p : P, ((algebraMap P F p : F) : L) = MvPolynomial.aeval x p := by
    intro p
    exact MvPolynomial.comp_aeval_apply x' ((IntermediateField.val F).restrictScalars R) p
  have : IsFractionRing P F := isFractionRing_mvPolynomial ht.1 hPF
  -- the prime `𝔭 = (𝔪, X_i)` of `P` and the local ring `R' = P_𝔭`
  let φ : P →+* ResidueField R := MvPolynomial.eval₂Hom (residue R) fun _ ↦ 0
  let 𝔭 := RingHom.ker φ
  have : 𝔭.IsPrime := RingHom.ker_isPrime φ
  let R' := Localization.AtPrime 𝔭
  have hunit : ∀ y : 𝔭.primeCompl, IsUnit (algebraMap P F y) := fun y ↦
    IsLocalization.map_units F (⟨y.1, 𝔭.primeCompl_le_nonZeroDivisors y.2⟩ : nonZeroDivisors P)
  let _ : Algebra R' F := (IsLocalization.lift (M := 𝔭.primeCompl) (S := R') hunit).toAlgebra
  have : IsScalarTower P R' F := IsScalarTower.of_algebraMap_eq fun p ↦
    (IsLocalization.lift_eq (M := 𝔭.primeCompl) (S := R') hunit p).symm
  have : IsFractionRing R' F :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization 𝔭.primeCompl R' F
  let _ : Algebra R' L := ((algebraMap F L).comp (algebraMap R' F)).toAlgebra
  have : IsScalarTower R' F L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsNoetherianRing R' := IsLocalization.isNoetherianRing 𝔭.primeCompl R' inferInstance
  have hC : ∀ r : R, algebraMap R L r = algebraMap R' L (algebraMap P R' (MvPolynomial.C r)) := by
    intro r
    change _ = algebraMap F L (algebraMap R' F (algebraMap P R' (MvPolynomial.C r)))
    rw [← IsScalarTower.algebraMap_apply P R' F]
    change _ = ((algebraMap P F (MvPolynomial.C r) : F) : L)
    rw [hPF, MvPolynomial.aeval_C]
  have hCm : ∀ r ∈ maximalIdeal R, algebraMap P R' (MvPolynomial.C r) ∈ maximalIdeal R' := by
    intro r hr
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff R' 𝔭 _).2 ?_
    change φ (MvPolynomial.C r) = 0
    exact (MvPolynomial.eval₂_C _ _ r).trans ((residue_eq_zero_iff r).2 hr)
  have hR' : ¬ IsField R' := by
    intro hF
    have hm : maximalIdeal R ≠ ⊥ := fun h ↦ hR ((isField_iff_maximalIdeal_eq).2 h)
    obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm
    have h1 := hCm r hr
    rw [(isField_iff_maximalIdeal_eq).1 hF, Ideal.mem_bot] at h1
    apply hr0
    have h2 := hC r
    rw [h1, map_zero] at h2
    exact (IsFractionRing.injective R K) ((algebraMap K L).injective
      (by rw [← IsScalarTower.algebraMap_apply, h2, map_zero, map_zero]))
  obtain ⟨V, hV, hmem, hnon⟩ :=
    exists_isDiscreteValuationRing_dominating_of_finite (R := R') (K := F) (L := L) hR'
  exact ⟨V, hV, fun r ↦ hC r ▸ hmem _, fun r hr ↦ hC r ▸ hnon _ (hCm r hr)⟩

end IsLocalRing
