module

public import Mathlib.RingTheory.Finiteness.Subalgebra
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Localization.Integer

@[expose] public section

universe u v

namespace AffineDilatation

variable {A : Type v} [CommRing A]

/-- The generating set of an affine dilatation: the images `g / a` of the
elements `g` of the ideal `I` in the localization away from `a`. -/
public noncomputable def gen (I : Ideal A) (a : A) : Set (Localization.Away a) :=
  (fun g : A => IsLocalization.mk' (Localization.Away a) g
    (⟨a, Submonoid.mem_powers a⟩ : Submonoid.powers a)) '' (I : Set A)

/-- The subalgebra of the localization away from `a` generated by `g / a`
for `g ∈ I`. -/
public noncomputable def subalgebra (I : Ideal A) (a : A) : Subalgebra A (Localization.Away a) :=
  Algebra.adjoin A (gen I a)

/-- The ring of the affine dilatation of `Spec A` along `I` at `a`, as the
carrier of the subalgebra generated by `g / a` for `g ∈ I`. -/
public abbrev Ring (I : Ideal A) (a : A) : Type v :=
  ↥(subalgebra I a)

/-- The element `g / a` of the dilatation ring, for `g ∈ I`. -/
public noncomputable def divElem (I : Ideal A) (a : A) (g : A) (hg : g ∈ I) : Ring I a :=
  ⟨IsLocalization.mk' (Localization.Away a) g (⟨a, Submonoid.mem_powers a⟩ : Submonoid.powers a),
    Algebra.subset_adjoin ⟨g, hg, rfl⟩⟩

@[simp]
public theorem coe_divElem (I : Ideal A) (a : A) (g : A) (hg : g ∈ I) :
    ((divElem I a g hg : Ring I a) : Localization.Away a) =
      IsLocalization.mk' (Localization.Away a) g
        (⟨a, Submonoid.mem_powers a⟩ : Submonoid.powers a) :=
  rfl

public theorem coe_algebraMap (I : Ideal A) (a : A) (g : A) :
    ((algebraMap A (Ring I a) g : Ring I a) : Localization.Away a) =
      algebraMap A (Localization.Away a) g :=
  rfl

public theorem algebraMap_mul_divElem (I : Ideal A) (a : A) (g : A) (hg : g ∈ I) :
    algebraMap A (Ring I a) a * divElem I a g hg = algebraMap A (Ring I a) g := by
  apply Subtype.ext
  change algebraMap A (Localization.Away a) a *
      IsLocalization.mk' (Localization.Away a) g
        (⟨a, Submonoid.mem_powers a⟩ : Submonoid.powers a) =
    algebraMap A (Localization.Away a) g
  rw [mul_comm]
  exact IsLocalization.mk'_spec (Localization.Away a) g
    (⟨a, Submonoid.mem_powers a⟩ : Submonoid.powers a)

public theorem mem_gen_iff (I : Ideal A) (a : A) (x : Localization.Away a) :
    x ∈ gen I a ↔ ∃ g ∈ I, IsLocalization.mk' (Localization.Away a) g
      (⟨a, Submonoid.mem_powers a⟩ : Submonoid.powers a) = x :=
  Iff.rfl

public theorem subalgebra_eq_adjoin (I : Ideal A) (a : A) :
    subalgebra I a = Algebra.adjoin A (gen I a) :=
  rfl

public theorem gen_subset (I : Ideal A) (a : A) :
    gen I a ⊆ (subalgebra I a : Set (Localization.Away a)) :=
  Algebra.subset_adjoin

public theorem divElem_mem (I : Ideal A) (a : A) (g : A) (hg : g ∈ I) :
    ((divElem I a g hg : Ring I a) : Localization.Away a) ∈ gen I a :=
  ⟨g, hg, rfl⟩

private theorem fg_of_fg (I : Ideal A) (a : A) (hI : I.FG) : (subalgebra I a).FG := by
  classical
  obtain ⟨T, hT⟩ := hI
  let aa : Submonoid.powers a := ⟨a, Submonoid.mem_powers a⟩
  let f : A → Localization.Away a := fun g => IsLocalization.mk' (Localization.Away a) g aa
  refine ⟨T.image f, le_antisymm ?_ ?_⟩
  · apply Algebra.adjoin_le
    intro x hx
    rw [Finset.coe_image] at hx
    obtain ⟨g, hg, rfl⟩ := hx
    exact gen_subset I a ⟨g, hT ▸ Ideal.subset_span hg, rfl⟩
  · apply Algebra.adjoin_le
    rintro x ⟨g, hg, rfl⟩
    have hg' : g ∈ Ideal.span (T : Set A) := hT ▸ hg
    clear hg
    change f g ∈ Algebra.adjoin A (↑(T.image f) : Set (Localization.Away a))
    have hu : ∀ g : A, f g = algebraMap A (Localization.Away a) g * f 1 := fun g =>
      IsLocalization.mk'_eq_mul_mk'_one g aa
    rw [hu]
    induction hg' using Submodule.span_induction with
    | mem t ht =>
        rw [← hu]
        exact Algebra.subset_adjoin (by rw [Finset.coe_image]; exact ⟨t, ht, rfl⟩)
    | zero => rw [map_zero, zero_mul]; exact Subalgebra.zero_mem _
    | add x y _ _ hx hy => rw [map_add, add_mul]; exact Subalgebra.add_mem _ hx hy
    | smul c x _ hx =>
        rw [smul_eq_mul, map_mul, mul_assoc]
        exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ c) hx

private theorem finiteType (I : Ideal A) (a : A) (hI : I.FG) :
    Algebra.FiniteType A (Ring I a) :=
  (Subalgebra.fg_iff_finiteType _).mp (fg_of_fg I a hI)

/-- An affine dilatation whose center ideal is finitely generated is of finite
type over any base over which the ambient ring is of finite type. -/
public theorem finiteType_of_fg {R : Type u} [CommRing R] [Algebra R A]
    [Algebra.FiniteType R A] (I : Ideal A) (a : A) (hI : I.FG) :
    Algebra.FiniteType R (AffineDilatation.Ring I a) :=
  Algebra.FiniteType.trans (S := A) inferInstance (finiteType I a hI)

end AffineDilatation
