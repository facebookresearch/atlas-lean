module

public import Mathlib.RingTheory.DedekindDomain.AdicValuation

@[expose] public section

/-!
# Bhargava p-ordering of an infinite subset of a Dedekind domain

This module formalizes the p-ordering definition from the Introduction,
lines 52-60, of Wataru Takeda, On the Bhargava factorial of polynomial
maps, arXiv:2304.02946v1. The source index slip is read as stage `n`.
-/

namespace IsDedekindDomain.HeightOneSpectrum

/-- **Prefix-product valuation.** Let $R$ be a commutative ring, $\mathfrak p$ a nonzero prime
ideal of $R$ and $(a_k)_{k \ge 0}$ a sequence in $R$. For $n \in \mathbb N$ and $x \in R$, the
stage-$n$ prefix-product valuation of $x$ is the multiplicity of $\mathfrak p$ in the principal
ideal generated by $\prod_{k < n} (x - a_k)$: the largest $m \in \mathbb N$ such that
$\mathfrak p^m$ divides this ideal, or $\infty$ if every power of $\mathfrak p$ divides it.

Source: Takeda, Introduction, lines 52-60. -/
noncomputable def pOrderingValuation
    {R : Type*} [CommRing R]
    (p : IsDedekindDomain.HeightOneSpectrum R) (a : ℕ → R) (n : ℕ)
    (x : R) : ℕ∞ :=
  emultiplicity p.asIdeal
    (Ideal.span {(Finset.range n).prod fun k => x - a k})

/-- **Bhargava p-ordering.** Let $R$ be a Dedekind domain, $\mathfrak p$ a nonzero prime ideal
of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a sequence in $R$. Write $v_n(x)$ for the stage-$n$
prefix-product valuation of $x \in R$ with respect to $\mathfrak p$ and $(a_n)$, the multiplicity
of $\mathfrak p$ in the ideal generated by $\prod_{k < n} (x - a_k)$. Then $(a_n)$ is a
$\mathfrak p$-ordering of $S$ when $S$ is infinite, $a_n \in S$ for every $n$, and
$v_n(a_n) \le v_n(x)$ for every $n$ and every $x \in S$.

Source: Takeda, Introduction, lines 52-60. -/
def IsPOrdering
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    (p : IsDedekindDomain.HeightOneSpectrum R) (S : Set R)
    (a : ℕ → R) : Prop :=
  S.Infinite ∧ (∀ n, a n ∈ S) ∧
    ∀ n, ∀ x ∈ S,
      pOrderingValuation p a n (a n) ≤ pOrderingValuation p a n x

/-- **Unfolding the definition of a p-ordering.** Let $R$ be a Dedekind domain, $\mathfrak p$
a nonzero prime ideal of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a sequence in $R$, and
write $v_n$ for the stage-$n$ prefix-product valuation with respect to $\mathfrak p$ and
$(a_n)$. Then $(a_n)$ is a $\mathfrak p$-ordering of $S$ if and only if $S$ is infinite,
$a_n \in S$ for every $n$, and $v_n(a_n) \le v_n(x)$ for every $n$ and every $x \in S$. -/
theorem isPOrdering_unfold
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} :
    IsPOrdering p S a ↔
      S.Infinite ∧ (∀ n, a n ∈ S) ∧
        ∀ n, ∀ x ∈ S,
          pOrderingValuation p a n (a n) ≤
            pOrderingValuation p a n x :=
  Iff.rfl

/-- **A set with a p-ordering is infinite.** Let $R$ be a Dedekind domain, $\mathfrak p$ a
nonzero prime ideal of $R$ and $S \subseteq R$. If some sequence in $R$ is a
$\mathfrak p$-ordering of $S$, then $S$ is infinite. -/
theorem IsPOrdering.infinite
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} (h : IsPOrdering p S a) : S.Infinite :=
  h.1

/-- **Terms of a p-ordering lie in the set.** Let $R$ be a Dedekind domain, $\mathfrak p$ a
nonzero prime ideal of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a $\mathfrak p$-ordering of
$S$. Then $a_n \in S$ for every $n$. -/
theorem IsPOrdering.mem
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} (h : IsPOrdering p S a) (n : ℕ) : a n ∈ S :=
  h.2.1 n

/-- **Minimality of a p-ordering.** Let $R$ be a Dedekind domain, $\mathfrak p$ a nonzero prime
ideal of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a $\mathfrak p$-ordering of $S$, and write
$v_n$ for the stage-$n$ prefix-product valuation with respect to $\mathfrak p$ and $(a_n)$.
Then $v_n(a_n) \le v_n(x)$ for every $n$ and every $x \in S$. -/
theorem IsPOrdering.min_le
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} (h : IsPOrdering p S a) (n : ℕ) (x : R)
    (hx : x ∈ S) :
    pOrderingValuation p a n (a n) ≤ pOrderingValuation p a n x :=
  h.2.2 n x hx

/-- **Each term of a p-ordering attains the least valuation.** Let $R$ be a Dedekind domain,
$\mathfrak p$ a nonzero prime ideal of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a
$\mathfrak p$-ordering of $S$, and write $v_n$ for the stage-$n$ prefix-product valuation with
respect to $\mathfrak p$ and $(a_n)$. Then for every $n$, $v_n(a_n)$ is the least element of
$\{v_n(x) : x \in S\}$. -/
theorem IsPOrdering.isLeast
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} {n : ℕ} (h : IsPOrdering p S a) :
    IsLeast (pOrderingValuation p a n '' S)
      (pOrderingValuation p a n (a n)) := by
  constructor
  · exact ⟨a n, h.mem n, rfl⟩
  · intro y hy
    obtain ⟨x, hxS, rfl⟩ := hy
    exact h.min_le n x hxS

/-- **Building a p-ordering.** Let $R$ be a Dedekind domain, $\mathfrak p$ a nonzero prime
ideal of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a sequence in $R$, and write $v_n$ for the
stage-$n$ prefix-product valuation with respect to $\mathfrak p$ and $(a_n)$. If $S$ is
infinite, $a_n \in S$ for every $n$, and $v_n(a_n) \le v_n(x)$ for every $n$ and every
$x \in S$, then $(a_n)$ is a $\mathfrak p$-ordering of $S$. -/
theorem IsPOrdering.intro
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} (hinf : S.Infinite) (hmem : ∀ n, a n ∈ S)
    (hmin : ∀ n, ∀ x ∈ S,
      pOrderingValuation p a n (a n) ≤ pOrderingValuation p a n x) :
    IsPOrdering p S a :=
  ⟨hinf, hmem, hmin⟩

/-- **The stage-zero valuation vanishes.** Let $R$ be a commutative ring, $\mathfrak p$ a
nonzero prime ideal of $R$ and $(a_n)_{n \ge 0}$ a sequence in $R$. For every $x \in R$, the
stage-$0$ prefix-product valuation of $x$ with respect to $\mathfrak p$ and $(a_n)$ is $0$: the
product is empty, so the ideal is all of $R$. -/
theorem pOrderingValuation_zero
    {R : Type*} [CommRing R]
    (p : IsDedekindDomain.HeightOneSpectrum R) (a : ℕ → R)
    (x : R) : pOrderingValuation p a 0 x = 0 := by
  unfold pOrderingValuation
  rw [Finset.range_zero, Finset.prod_empty,
    Ideal.span_singleton_one]
  have hunit : ¬ IsUnit p.asIdeal := by
    rw [Ideal.isUnit_iff]
    exact p.isPrime.ne_top
  have htop : (⊤ : Ideal R) = 1 := Ideal.one_eq_top.symm
  rw [htop]
  exact emultiplicity_of_one_right hunit

/-- **The stage-zero condition of a p-ordering is automatic.** Let $R$ be a Dedekind domain,
$\mathfrak p$ a nonzero prime ideal of $R$, $S \subseteq R$ and $(a_n)_{n \ge 0}$ a sequence in
$R$, and write $v_n$ for the stage-$n$ prefix-product valuation with respect to $\mathfrak p$
and $(a_n)$. Then $(a_n)$ is a $\mathfrak p$-ordering of $S$ if and only if $S$ is infinite,
$a_n \in S$ for every $n$, and $v_n(a_n) \le v_n(x)$ for every $n \ge 1$ and every $x \in S$.

Since every stage-zero valuation is $0$, the term $a_0$ may be any element of $S$. -/
theorem isPOrdering_iff_pos
    {R : Type*} [CommRing R] [IsDedekindDomain R]
    {p : IsDedekindDomain.HeightOneSpectrum R} {S : Set R}
    {a : ℕ → R} :
    IsPOrdering p S a ↔
      S.Infinite ∧ (∀ n, a n ∈ S) ∧
        ∀ n, 1 ≤ n → ∀ x ∈ S,
          pOrderingValuation p a n (a n) ≤
            pOrderingValuation p a n x := by
  constructor
  · intro h
    exact ⟨h.infinite, h.mem, fun n _ x hx => h.min_le n x hx⟩
  · intro h
    refine ⟨h.1, h.2.1, ?_⟩
    intro n x hx
    by_cases hn : 1 ≤ n
    · exact h.2.2 n hn x hx
    · have hn0 : n = 0 := by omega
      subst hn0
      rw [pOrderingValuation_zero, pOrderingValuation_zero]

end IsDedekindDomain.HeightOneSpectrum
