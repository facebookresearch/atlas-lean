/-!
# Converse characterizations of Dedekind domains

These independently derived converse characterizations extend the forward
statements of ATLAS `NumberTheoryI`, Corollary 3.18 and Theorem 3.22. The
primary Theorem 3.23 lists six conditions. The additional quotient-PIR and
prescribed-two-generator characterizations belong to the archived v1
formalization.

The forward directions are already available: every quotient of a Dedekind
domain by a nonzero ideal is a principal ideal ring
(`IsDedekindDomain.isPrincipalIdealRing_quotient`, Corollary 3.18), and every
ideal of a Dedekind domain is generated by two elements, one of which may be
prescribed (`IsDedekindDomain.exists_eq_span_pair`, Theorem 3.22). This file
proves the converses: if every quotient of a domain `A` by a nonzero ideal is a
principal ideal ring, then `A` is a Dedekind domain, and the same conclusion
holds under the two-generator hypothesis. They give converse extensions
of Corollary 3.18 and Theorem 3.22.

The proof follows `v1/Atlas/NumberTheoryI/code/Chapter3/DedekindProperties.lean`
(`quotientPIR_noetherian`, `quotientPIR_dvr`, `quotientPIR_to_integrallyClosed`,
`twoGenerator_to_quotientPIR`), with the final step replaced by Mathlib's
`isDedekindDomain_iff_isDiscreteValuationRing_atPrime`.
-/

@[expose] public section

open Ideal

/-- If every quotient of `A` by a nonzero ideal is a principal ideal ring,
then `A` is Noetherian: for an ideal `I`, pick `a ∈ I` nonzero; the quotient
by `(a)` is a PIR, so the image of `I` there is principal, and lifting the
generator shows `I = (a, b)`, hence `I` is finitely generated. -/
theorem isNoetherianRing_of_forall_isPrincipalIdealRing_quotient {A : Type*}
    [CommRing A] [IsDomain A]
    (h : ∀ I : Ideal A, I ≠ ⊥ → IsPrincipalIdealRing (A ⧸ I)) :
    IsNoetherianRing A := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro I
  by_cases hI : I = ⊥
  · subst hI
    exact Submodule.fg_bot
  obtain ⟨a, haI, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  have : IsPrincipalIdealRing (A ⧸ Ideal.span {a}) :=
    h (Ideal.span {a}) (by rwa [Ne, Ideal.span_singleton_eq_bot])
  set f := Ideal.Quotient.mk (Ideal.span ({a} : Set A)) with hf_def
  obtain ⟨⟨b_bar, hb_bar⟩⟩ := IsPrincipalIdealRing.principal (I.map f)
  obtain ⟨b, hb_eq⟩ := Ideal.Quotient.mk_surjective b_bar
  rw [← hb_eq] at hb_bar
  have hle : I ≤ Ideal.span {a, b} := by
    intro x hx
    have hfx : f x ∈ I.map f := Ideal.mem_map_of_mem _ hx
    rw [hb_bar, Submodule.mem_span_singleton] at hfx
    obtain ⟨r_bar, hr⟩ := hfx
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r_bar
    have hker : x - r * b ∈ Ideal.span ({a} : Set A) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have h1 : f (x - r * b) = f x - f (r * b) := map_sub f x (r * b)
      have h2 : f (r * b) = f r * f b := map_mul f r b
      have h3 : f r * f b = f r • f b := (smul_eq_mul (f r) (f b)).symm
      rw [h1, h2, h3, hr, sub_self]
    obtain ⟨s, hs⟩ := Ideal.mem_span_singleton.mp hker
    rw [Ideal.mem_span_pair]
    exact ⟨s, r, by rw [show x = (x - r * b) + r * b from by ring, hs, mul_comm a s]⟩
  have hbI : b ∈ I := by
    have hfb : f b ∈ I.map f := by
      rw [hb_bar]
      exact Submodule.subset_span (Set.mem_singleton _)
    obtain ⟨y, hyI, hy⟩ := (Ideal.mem_map_iff_of_surjective _
      Ideal.Quotient.mk_surjective).mp hfb
    have hsub : y - b ∈ Ideal.span ({a} : Set A) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hy, sub_self]
    have hba : b = y - (y - b) := by ring
    rw [hba]
    exact I.sub_mem hyI (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr haI) hsub)
  have hge : Ideal.span {a, b} ≤ I := by
    apply Ideal.span_le.mpr
    intro x hx
    cases Set.mem_insert_iff.mp hx with
    | inl h => exact h ▸ haI
    | inr h => exact (Set.mem_singleton_iff.mp h) ▸ hbI
  have hI_eq : I = Ideal.span {a, b} := le_antisymm hle hge
  rw [hI_eq]
  exact Submodule.fg_span (Set.toFinite {a, b})

/-- If every quotient of `A` by a nonzero ideal is a principal ideal ring,
then the localization of `A` at any nonzero prime is a discrete valuation
ring: the image of the prime in `A ⧸ P ^ 2` is principal, generated by the
image of some `π ∈ P`; lifting gives `P ≤ (π) + P ^ 2`, hence the maximal
ideal of the localization is contained in `(π) + 𝔪 ^ 2`, and Nakayama's lemma
gives `𝔪 = (π)`. -/
theorem isDiscreteValuationRing_localization_atPrime_of_forall_isPrincipalIdealRing_quotient
    {A : Type*} [CommRing A] [IsDomain A]
    (h : ∀ I : Ideal A, I ≠ ⊥ → IsPrincipalIdealRing (A ⧸ I))
    (P : Ideal A) (hPne : P ≠ ⊥) (hPpr : P.IsPrime) :
    IsDiscreteValuationRing (Localization.AtPrime P) := by
  have : IsNoetherianRing A :=
    isNoetherianRing_of_forall_isPrincipalIdealRing_quotient h
  have := hPpr
  set L := Localization.AtPrime P
  set ι := algebraMap A L
  set m := IsLocalRing.maximalIdeal L
  have hP2 : P ^ 2 ≠ ⊥ := by
    intro hEq
    apply hPne
    rw [eq_bot_iff]
    intro x hx
    have hx2 : x ^ 2 ∈ P ^ 2 := Ideal.pow_mem_pow hx 2
    rw [hEq] at hx2
    simp only [Ideal.mem_bot, sq_eq_zero_iff] at hx2
    simp [hx2]
  have : IsPrincipalIdealRing (A ⧸ P ^ 2) := h _ hP2
  obtain ⟨⟨g, hg⟩⟩ :=
    IsPrincipalIdealRing.principal (Ideal.map (Ideal.Quotient.mk (P ^ 2)) P)
  obtain ⟨π, rfl⟩ := Ideal.Quotient.mk_surjective g
  have hπP : π ∈ P := by
    have hmem : Ideal.Quotient.mk (P ^ 2) π ∈
        Ideal.map (Ideal.Quotient.mk (P ^ 2)) P := by
      rw [hg]
      exact Submodule.subset_span (Set.mem_singleton _)
    obtain ⟨p, hp, heq⟩ := (Ideal.mem_map_iff_of_surjective _
      Ideal.Quotient.mk_surjective).mp hmem
    rw [show π = p + (π - p) by ring]
    exact P.add_mem hp
      (Ideal.pow_le_self (n := 2) (by omega) (Ideal.Quotient.eq.mp heq.symm))
  have hPle : P ≤ Ideal.span {π} ⊔ P ^ 2 := by
    intro p hp
    have hmem : Ideal.Quotient.mk (P ^ 2) p ∈
        Ideal.map (Ideal.Quotient.mk (P ^ 2)) P :=
      Ideal.mem_map_of_mem _ hp
    rw [hg, Submodule.mem_span_singleton] at hmem
    obtain ⟨r, hr⟩ := hmem
    obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [smul_eq_mul, ← map_mul, Ideal.Quotient.mk_eq_mk_iff_sub_mem] at hr
    have hr' : p - r' * π ∈ P ^ 2 := by
      have hneg := (P ^ 2).neg_mem hr
      rwa [neg_sub] at hneg
    rw [Submodule.mem_sup]
    exact ⟨r' * π, Ideal.mem_span_singleton.mpr ⟨r', mul_comm r' π⟩,
      p - r' * π, hr', by ring⟩
  have hm_eq : m = Ideal.map ι P := (Localization.AtPrime.map_eq_maximalIdeal).symm
  have hm_le_sup : m ≤ Ideal.span {ι π} ⊔ m ^ 2 := by
    rw [hm_eq]
    calc Ideal.map ι P
        ≤ Ideal.map ι (Ideal.span {π} ⊔ P ^ 2) := Ideal.map_mono hPle
      _ = Ideal.map ι (Ideal.span {π}) ⊔ Ideal.map ι (P ^ 2) := Ideal.map_sup ι _ _
      _ = Ideal.span {ι π} ⊔ Ideal.map ι (P ^ 2) := by
            rw [Ideal.map_span, Set.image_singleton]
      _ = Ideal.span {ι π} ⊔ (Ideal.map ι P) ^ 2 := by rw [Ideal.map_pow]
  have hnotfield : ¬ IsField L := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← Localization.AtPrime.map_eq_maximalIdeal]
    intro hEq
    exact hPne (Ideal.map_eq_bot_iff_of_injective
      (IsLocalization.injective _ P.primeCompl_le_nonZeroDivisors) |>.mp hEq)
  have hm_le : m ≤ Ideal.span {ι π} :=
    Submodule.le_of_le_smul_of_le_jacobson_bot
      (N := Ideal.span {ι π}) (N' := m) (I := m)
      (IsNoetherian.noetherian m)
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal L) bot_ne_top])
      (by rwa [Ideal.smul_eq_mul, ← sq])
  have hm_ge : Ideal.span {ι π} ≤ m :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hm_eq ▸ Ideal.mem_map_of_mem _ hπP))
  have hm_princ : Submodule.IsPrincipal m := by
    rw [le_antisymm hm_le hm_ge]
    exact ⟨⟨ι π, rfl⟩⟩
  exact ((IsDiscreteValuationRing.TFAE L hnotfield).out 5 1).mp hm_princ

/-- Derived converse of Corollary 3.18: if every
quotient of a domain by a nonzero ideal is a principal ideal ring, then the
domain is a Dedekind domain. -/
theorem isDedekindDomain_of_forall_isPrincipalIdealRing_quotient {A : Type*}
    [CommRing A] [IsDomain A]
    (h : ∀ I : Ideal A, I ≠ ⊥ → IsPrincipalIdealRing (A ⧸ I)) :
    IsDedekindDomain A := by
  refine (isDedekindDomain_iff_isDiscreteValuationRing_atPrime (A := A)).mpr ⟨?_, ?_⟩
  · exact isNoetherianRing_of_forall_isPrincipalIdealRing_quotient h
  · intro P hPne hPpr
    exact isDiscreteValuationRing_localization_atPrime_of_forall_isPrincipalIdealRing_quotient
      h P hPne hPpr

/-- The two-generator hypothesis implies the quotient-PIR hypothesis: for a
nonzero `I`, an ideal `J` of `A ⧸ I` has comap `J'` containing `I`; pick a
nonzero `a ∈ I ⊆ J'`, write `J' = (a, b)`, and the image of `b` generates `J`
since the image of `a` is zero. -/
theorem isPrincipalIdealRing_quotient_of_forall_exists_span_pair {A : Type*}
    [CommRing A] [IsDomain A]
    (h : ∀ (I : Ideal A) (a : A), I ≠ ⊥ → a ≠ 0 → a ∈ I →
      ∃ b : A, I = Ideal.span {a, b}) :
    ∀ I : Ideal A, I ≠ ⊥ → IsPrincipalIdealRing (A ⧸ I) := by
  intro I hI
  constructor
  intro J
  rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective J]
  set J' := Ideal.comap (Ideal.Quotient.mk I) J
  have hIJ' : I ≤ J' := by
    intro x hx
    show (Ideal.Quotient.mk I) x ∈ J
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact J.zero_mem
  obtain ⟨a, haI, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  have hJ'ne : J' ≠ ⊥ := by
    intro hJ'
    have hmem := hIJ' haI
    rw [hJ'] at hmem
    simp [Submodule.mem_bot] at hmem
    exact ha0 hmem
  obtain ⟨b, hb⟩ := h J' a hJ'ne ha0 (hIJ' haI)
  rw [hb, Ideal.map_span, Set.image_pair,
    Ideal.Quotient.eq_zero_iff_mem.mpr haI, Ideal.span_insert_zero]
  exact ⟨⟨(Ideal.Quotient.mk I) b, rfl⟩⟩

/-- Derived converse of Theorem 3.22: if for every nonzero
ideal `I` and every nonzero `a ∈ I` there is `b` with `I = (a, b)`, then the
domain is a Dedekind domain. -/
theorem isDedekindDomain_of_forall_exists_span_pair {A : Type*}
    [CommRing A] [IsDomain A]
    (h : ∀ (I : Ideal A) (a : A), I ≠ ⊥ → a ≠ 0 → a ∈ I →
      ∃ b : A, I = Ideal.span {a, b}) :
    IsDedekindDomain A :=
  isDedekindDomain_of_forall_isPrincipalIdealRing_quotient
    (isPrincipalIdealRing_quotient_of_forall_exists_span_pair h)
