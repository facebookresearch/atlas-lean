module

public import Mathlib.RingTheory.DividedPowers.Basic

/-!
# Nilpotent divided-power structures

Let `γ` be a divided-power structure on an ideal `I` of a commutative ring `A`. Its `n`-th
divided-power ideal `I^[n]` is the ideal generated by the products `γ_{i₁}(x₁) ⋯ γ_{iₖ}(xₖ)` with
`xⱼ ∈ I` and `i₁ + ⋯ + iₖ ≥ n`. The structure is *nilpotent* when `I^[n] = 0` for some `n`; this is
the condition defining the nilpotent crystalline site in Scholze–Weinstein, *Moduli of p-divisible
groups*, arXiv:1211.6357v2, Section 3.2.

Since `I^n ⊆ I^[n]`, the ideal of a nilpotent divided-power structure is nilpotent
(`DividedPowers.IsPDNilpotent.isNilpotent`). The converse fails: the canonical divided powers on the
square-zero ideal `(2)` of `ℤ/4` satisfy `γ_{2^r}(2) = 2` for every `r`, so no `I^[n]` vanishes.

## Main definitions

* `DividedPowers.dpowIdeal`: the divided-power ideal `I^[n]`.
* `DividedPowers.IsPDNilpotent`: some `I^[n]` vanishes.

## Main results

* `DividedPowers.pow_le_dpowIdeal`: `I^n ≤ I^[n]`.
* `DividedPowers.dpow_mem_dpowIdeal`: `γ_n(x) ∈ I^[n]` for `x ∈ I`.
* `DividedPowers.IsPDNilpotent.isNilpotent`: the ideal of a nilpotent structure is nilpotent.
-/

@[expose] public section

namespace DividedPowers

variable {A : Type*} [CommRing A] {I : Ideal A} (hI : DividedPowers I)

/-- The `n`-th divided-power ideal `I^[n]`, generated by the products `γ_{i₁}(x₁) ⋯ γ_{iₖ}(xₖ)`
with `xⱼ ∈ I` and `i₁ + ⋯ + iₖ ≥ n`. -/
def dpowIdeal (n : ℕ) : Ideal A :=
  Ideal.span {a | ∃ (k : ℕ) (x : Fin k → A) (m : Fin k → ℕ), (∀ j, x j ∈ I) ∧
    n ≤ ∑ j, m j ∧ a = ∏ j, hI.dpow (m j) (x j)}

/-- A divided-power structure is nilpotent when some divided-power ideal `I^[n]` vanishes
(Scholze–Weinstein, arXiv:1211.6357v2, Section 3.2). -/
def IsPDNilpotent : Prop :=
  ∃ n, hI.dpowIdeal n = ⊥

theorem prod_dpow_mem_dpowIdeal {n k : ℕ} {x : Fin k → A} {m : Fin k → ℕ} (hx : ∀ j, x j ∈ I)
    (hm : n ≤ ∑ j, m j) : ∏ j, hI.dpow (m j) (x j) ∈ hI.dpowIdeal n :=
  Ideal.subset_span ⟨k, x, m, hx, hm, rfl⟩

/-- `γ_n(x) ∈ I^[n]` for every `x ∈ I`. -/
theorem dpow_mem_dpowIdeal (n : ℕ) {x : A} (hx : x ∈ I) : hI.dpow n x ∈ hI.dpowIdeal n := by
  simpa using hI.prod_dpow_mem_dpowIdeal (n := n) (x := fun _ : Fin 1 ↦ x)
    (m := fun _ ↦ n) (fun _ ↦ hx) (by simp)

/-- The divided-power ideals decrease. -/
theorem dpowIdeal_antitone : Antitone hI.dpowIdeal := by
  intro n n' hnn'
  refine Ideal.span_mono ?_
  rintro a ⟨k, x, m, hx, hm, rfl⟩
  exact ⟨k, x, m, hx, hnn'.trans hm, rfl⟩

/-- Multiplying by an element of `I` raises the divided-power degree by one. -/
theorem mul_mem_dpowIdeal_succ {n : ℕ} {a b : A} (ha : a ∈ hI.dpowIdeal n) (hb : b ∈ I) :
    a * b ∈ hI.dpowIdeal (n + 1) := by
  induction ha using Submodule.span_induction with
  | mem a h =>
    obtain ⟨k, x, m, hx, hm, rfl⟩ := h
    have hmem := hI.prod_dpow_mem_dpowIdeal (n := n + 1) (x := Fin.snoc x b)
      (m := Fin.snoc m 1) (fun j ↦ by
        rcases j.eq_castSucc_or_eq_last with ⟨j, rfl⟩ | rfl
        · simpa using hx j
        · simpa using hb) (by simpa [Fin.sum_univ_castSucc] using hm)
    simpa [Fin.prod_univ_castSucc, hI.dpow_one hb] using hmem
  | zero => simp
  | add a c _ _ ha hc => simpa [add_mul] using Ideal.add_mem _ ha hc
  | smul c a _ ha => simpa [smul_eq_mul, mul_assoc] using Ideal.mul_mem_left _ c ha

/-- `I^n ≤ I^[n]`. -/
theorem pow_le_dpowIdeal (n : ℕ) : I ^ n ≤ hI.dpowIdeal n := by
  induction n with
  | zero =>
    rw [pow_zero, Ideal.one_eq_top, top_le_iff, Ideal.eq_top_iff_one]
    simpa using hI.prod_dpow_mem_dpowIdeal (n := 0) (x := Fin.elim0) (m := Fin.elim0)
      (fun j ↦ j.elim0) le_rfl
  | succ n ih =>
    rw [pow_succ]
    exact Ideal.mul_le.mpr fun a ha b hb ↦ hI.mul_mem_dpowIdeal_succ (ih ha) hb

/-- The ideal of a nilpotent divided-power structure is nilpotent. -/
theorem IsPDNilpotent.isNilpotent {hI : DividedPowers I} (h : hI.IsPDNilpotent) :
    IsNilpotent I := by
  obtain ⟨n, hn⟩ := h
  exact ⟨n, le_bot_iff.mp (hn ▸ hI.pow_le_dpowIdeal n)⟩

/-- The divided powers of a nilpotent structure eventually vanish on `I`. -/
theorem IsPDNilpotent.exists_dpow_eq_zero {hI : DividedPowers I} (h : hI.IsPDNilpotent) :
    ∃ N, ∀ n, N ≤ n → ∀ x ∈ I, hI.dpow n x = 0 := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, fun n hn x hx ↦ ?_⟩
  have := hI.dpowIdeal_antitone hn (hI.dpow_mem_dpowIdeal n hx)
  rwa [hN, Ideal.mem_bot] at this

end DividedPowers
