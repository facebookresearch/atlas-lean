/-
The ring-of-definition construction follows the completed Huber rational
localization source in TauCetiProject/TauCeti, revision
62bbc0596dc3539d488232e4e924a338548ea0a9, Apache2.0.
Source paths: TauCeti/RingTheory/Huber/LocalizationTopology/Basic.lean,
Adic.lean and Completion.lean. Basic.lean credits Chris Birkbeck's
AINTLIB localization-topology source, commit d9f2fbbb, under Apache 2.0.
Modification: specialize to an adic ring that is its own ring of
definition, use the actual subalgebra of R[1/s] generated by T/s, then
complete that subalgebra before inverting the denominator. This is the
integral Witt-ring case used in the relative Fargues--Fontaine model.
-/
module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Adjoin.Basic

/-!
# Actual integral annular rational-ring models

For an ideal I, numerator set T and denominator s, the ring of definition
is the actual R-subalgebra R[T/s] of R[1/s]. First complete it along the
image of I, then invert s. Completing all of R[1/s] along I instead would
erase annular rings when the ideal becomes the unit ideal. The displayed
coefficient and fraction maps are actual native ring homomorphisms.
For an annular presentation, T spans an open ideal and s is topologically
nilpotent; then its rational ring is the completed Tate localization.
The generic formulas below do not assert completeness without those
presentation hypotheses.

This assembles existing localization/adjoin/adic-completion constructors.
Rational restriction, topology and sheaf comparisons are normalized
ordinary source integration inputs, not a new gluing theorem request.
Reference: Wedhorn, arXiv:1910.05934v1, Proposition and Definition5.51,
Section5.6.
-/

@[expose] public noncomputable section

namespace MathlibExt.RingTheory.AdicRationalRingModels

variable (R : Type) [CommRing R] (I : Ideal R) (T : Finset R) (s : R)

/-- The actual open-numerator and topologically nilpotent annular conditions. -/
def IsAnnular : Prop :=
  (∃ n, I ^ n ≤ Ideal.span (T : Set R)) ∧ ∃ m : ℕ, 0 < m ∧ s ^ m ∈ I

/-- The actual localized numerator fraction. -/
def fraction (t : R) : Localization.Away s :=
  algebraMap R (Localization.Away s) t * IsLocalization.Away.invSelf s

/-- The actual integral rational ring of definition R[T/s]. -/
def definitionAlgebra : Subalgebra R (Localization.Away s) :=
  Algebra.adjoin R (fraction R s '' (T : Set R))

/-- The denominator divided by itself adds no integral coefficients. -/
theorem definitionAlgebra_singleton_denominator :
    definitionAlgebra R {s} s = ⊥ := by
  classical
  apply le_antisymm ?_ bot_le
  apply Algebra.adjoin_le
  rintro x ⟨t, ht, rfl⟩
  have ht : t = s := Finset.mem_singleton.mp ht
  subst t
  rw [fraction, IsLocalization.Away.mul_invSelf]
  exact Subalgebra.one_mem _

/-- The completion ideal remains in the integral subalgebra. -/
def completionIdeal : Ideal (definitionAlgebra R T s) :=
  I.map (algebraMap R (definitionAlgebra R T s))

/-- Complete the actual integral rational ring of definition. -/
abbrev CompletedDefinition :=
  AdicCompletion (completionIdeal R I T s) (definitionAlgebra R T s)

/-- The actual denominator after completion, without inverting it first. -/
def completedDenominator : CompletedDefinition R I T s :=
  algebraMap (definitionAlgebra R T s) (CompletedDefinition R I T s)
    (algebraMap R (definitionAlgebra R T s) s)

/-- The actual complete rational ring after the final denominator inversion. -/
abbrev RationalRing := Localization.Away (completedDenominator R I T s)

/-- The prescribed coefficient ring map into the rational ring. -/
def coefficient : R →+* RationalRing R I T s :=
  (algebraMap (CompletedDefinition R I T s) (RationalRing R I T s)).comp
    ((algebraMap (definitionAlgebra R T s) (CompletedDefinition R I T s)).comp
      (algebraMap R (definitionAlgebra R T s)))

/-- The displayed denominator is actually invertible in the final ring. -/
theorem coefficient_denominator : IsUnit (coefficient R I T s s) := by
  change IsUnit (algebraMap (CompletedDefinition R I T s) (RationalRing R I T s)
    (completedDenominator R I T s))
  exact IsLocalization.Away.algebraMap_isUnit _

/-- A named numerator fraction in the actual integral subalgebra. -/
def integralFraction (t : R) (ht : t ∈ T) : definitionAlgebra R T s :=
  ⟨fraction R s t, Algebra.subset_adjoin ⟨t, ht, rfl⟩⟩

/-- Its actual completed and localized image. -/
def rationalFraction (t : R) (ht : t ∈ T) : RationalRing R I T s :=
  algebraMap (CompletedDefinition R I T s) (RationalRing R I T s)
    (algebraMap (definitionAlgebra R T s) (CompletedDefinition R I T s)
      (integralFraction R T s t ht))

/-- Numerator/denominator relations survive both genuine ring constructions. -/
theorem fraction_relation (t : R) (ht : t ∈ T) :
    coefficient R I T s t = coefficient R I T s s * rationalFraction R I T s t ht := by
  have h : algebraMap R (definitionAlgebra R T s) t =
      algebraMap R (definitionAlgebra R T s) s * integralFraction R T s t ht := by
    apply Subtype.ext
    change algebraMap R (Localization.Away s) t =
      algebraMap R (Localization.Away s) s *
        (algebraMap R (Localization.Away s) t * IsLocalization.Away.invSelf s)
    rw [mul_left_comm, IsLocalization.Away.mul_invSelf, mul_one]
  simpa only [coefficient, rationalFraction, RingHom.comp_apply, map_mul] using congrArg
    ((algebraMap (CompletedDefinition R I T s) (RationalRing R I T s)).comp
      (algebraMap (definitionAlgebra R T s) (CompletedDefinition R I T s))) h

end MathlibExt.RingTheory.AdicRationalRingModels
