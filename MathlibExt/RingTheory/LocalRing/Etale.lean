module

public import Mathlib.RingTheory.LocalRing.Etale

import Mathlib.RingTheory.Kaehler.Polynomial

import Mathlib.RingTheory.Smooth.Fiber

@[expose] public section
open Polynomial

namespace Algebra.FormallyUnramified

/-- **Algebras generated by a root with invertible derivative are formally unramified.**
Let $R$ and $S$ be commutative rings, let $S$ be an $R$-algebra, and let $x \in S$ generate $S$
as an $R$-algebra, that is $R[x] = S$. If some polynomial $P \in R[X]$ satisfies $P(x) = 0$ and
$P'(x)$ is a unit of $S$, then $S$ is formally unramified over $R$. -/
theorem of_isUnit_aeval_derivative_of_adjoin_eq_top
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (x : S) (P : R[X]) (hP : aeval x P = 0)
    (hP' : IsUnit (aeval x P.derivative))
    (hx : Algebra.adjoin R {x} = ⊤) :
    Algebra.FormallyUnramified R S := by
  let D := KaehlerDifferential.D R S
  have hDx : D x = 0 := by
    apply hP'.smul_eq_zero.mp
    rw [← D.map_aeval P x, hP, D.map_zero]
  have hD : D = 0 := by
    apply Derivation.ext_of_adjoin_eq_top ({x} : Set S) hx
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
    simpa using hDx
  refine ⟨(subsingleton_iff_forall_eq 0).mpr ?_⟩
  intro y
  have hle : (⊤ : Submodule S Ω[S⁄R]) ≤ ⊥ := by
    rw [← KaehlerDifferential.span_range_derivation]
    apply Submodule.span_le.mpr
    rintro _ ⟨s, rfl⟩
    change D s ∈ (⊥ : Submodule S Ω[S⁄R])
    rw [hD]
    simp
  have hy : y = 0 := (Submodule.mem_bot S).mp (hle Submodule.mem_top)
  exact hy

end Algebra.FormallyUnramified

namespace Algebra

/-- **Étale finite local algebras are generated by one element with separable reduction.**
Let $R$ and $S$ be local rings and let $S$ be an $R$-algebra whose structure map $R \to S$ is
injective, which is finitely generated and flat as an $R$-module and finitely presented as an
$R$-algebra. Let $k$ be the residue field of $R$. Then $S$ is étale over $R$ if and only if
there is an element $x \in S$ with $R[x] = S$ such that the image in $k[X]$ of the minimal
polynomial of $x$ over $R$ (a monic polynomial in $R[X]$ of least degree with root $x$) is
separable. -/
theorem etale_iff_exists_adjoin_eq_top_and_separable_map_minpoly
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [IsLocalRing R] [IsLocalRing S] [Module.Finite R S] [FaithfulSMul R S]
    [Module.Flat R S] [Algebra.FinitePresentation R S] :
    Algebra.Etale R S ↔
      ∃ x : S, Algebra.adjoin R ({x} : Set S) = ⊤ ∧
        ((minpoly R x).map (IsLocalRing.residue R)).Separable := by
  constructor
  · intro hE
    let _ : Algebra.Etale R S := hE
    obtain ⟨x, hx⟩ := IsLocalRing.exists_adjoin_eq_top (R := R) (S := S)
    refine ⟨x, hx, ?_⟩
    rw [IsLocalRing.minpoly_map_residue hx]
    exact Algebra.IsSeparable.isSeparable _ (IsLocalRing.residue S x)
  · rintro ⟨x, hx, hsep⟩
    have hroot : aeval (IsLocalRing.residue S x)
        ((minpoly R x).map (IsLocalRing.residue R)) = 0 := by
      rw [← map_aeval_eq_aeval_map (ψ := IsLocalRing.residue S)
        (φ := IsLocalRing.residue R) rfl]
      simp [minpoly.aeval R x]
    have hunit : IsUnit (aeval x (minpoly R x).derivative) := by
      apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [map_aeval_eq_aeval_map (ψ := IsLocalRing.residue S)
        (φ := IsLocalRing.residue R) rfl, ← derivative_map]
      exact hsep.aeval_derivative_ne_zero hroot
    let _ : Algebra.FormallyUnramified R S :=
      FormallyUnramified.of_isUnit_aeval_derivative_of_adjoin_eq_top x
        (minpoly R x) (minpoly.aeval R x) hunit hx
    exact Algebra.Etale.of_formallyUnramified_of_flat

end Algebra

end
