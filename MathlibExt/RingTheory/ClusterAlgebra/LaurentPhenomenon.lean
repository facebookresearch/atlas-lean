/-!
# The Laurent phenomenon in rank two

The ambient field of a coefficient-free seed with cluster variables indexed by `n` is
`ℚ(x_i : i ∈ n)`, realised as `FractionRing (MvPolynomial n ℤ)` with the initial cluster
`x_i = X_i` (`initialCluster`). The ring of Laurent polynomials `ℤ[x_i^{±1}]` is the
`ℤ`-subalgebra generated by the `x_i` and their inverses (`laurentSubalgebra`).

Main results:

* `rankTwoSeq_mem`: over any field, every term of the rank-two exchange recurrence
  `rankTwoSeq b c x y` with `b, c > 0` lies in every subring that contains `x`, `y`, `x⁻¹` and
  `y⁻¹`.
* `rankTwoSeq_mem_laurentSubalgebra`: the Laurent phenomenon in rank two (Fomin, Williams and
  Zelevinsky, *Introduction to cluster algebras, Chapters 1–3*, arXiv:1608.05735v5, Section 3.2
  with Theorem 3.3.1; Fomin and Zelevinsky, *Cluster algebras I*, J. Amer. Math. Soc. 15 (2002),
  Theorem 3.1): started at `(X_0, X_1)`, every term lies in `ℤ[X_0^{±1}, X_1^{±1}]`.

The general Laurent phenomenon, `laurent_phenomenon`, is a wanted statement in
`WantedExt.RingTheory.ClusterAlgebra.LaurentPhenomenonWanted`.

## Proof

Write `z = rankTwoSeq b c x y` and `e k` for the exponent in the exchange relation
`z k * z (k + 2) = z (k + 1) ^ e k + 1`, so `e k` is `c` for even `k` and `b` for odd `k`, and
`e (k + 2) = e k`. When `z n`, `z (n + 1)` and `z (n + 2)` are nonzero, the exchange relations
at `n`, `n + 1` and `n + 2`, with `(u + 1) ^ e - 1 = u * ∑ j < e, (u + 1) ^ j`, give

`z (n + 4) = z n * z (n + 3) ^ e n - z (n + 2) ^ (e (n + 1) - 1) * P`,
`P = ∑ j < e n, (z (n + 2) ^ e (n + 1) + 1) ^ j`,

since after multiplication by `z (n + 2)` both sides equal `z (n + 3) ^ e n + 1`; this uses
`e (n + 1) ≥ 1`, that is `b, c > 0`. So `z (n + 4)` is a polynomial with integer coefficients in
earlier terms, and induction from `z 2 = (y ^ c + 1) * x⁻¹` and `z 3 = (z 2 ^ b + 1) * y⁻¹`
proves membership, with no coprimality argument. If a term vanishes, Lean's convention
`a / 0 = 0` applies: when `z (n + 2) = 0` also `z (n + 4) = 0`, and when `z (n + 1) = 0` the next
terms are `(z n)⁻¹, 0, z n`. So no nonvanishing hypothesis is needed.
-/

@[expose] public section

namespace MathlibExt.RingTheory.ClusterAlgebra.LaurentPhenomenonWanted

open MathlibExt.RingTheory.ClusterAlgebra

/-- **Initial cluster of the ambient field.** The cluster `(X_i)_{i ∈ n}` of free generators of
`ℚ(X_i : i ∈ n) = FractionRing (MvPolynomial n ℤ)`, the ambient field of a labeled seed
(Fomin, Williams and Zelevinsky, *Introduction to cluster algebras, Chapters 1–3*,
arXiv:1608.05735v5, Definition 3.1.1, with no frozen variables). -/
noncomputable abbrev initialCluster (n : Type*) [DecidableEq n] :
    n → FractionRing (MvPolynomial n ℤ) :=
  fun i => algebraMap (MvPolynomial n ℤ) _ (MvPolynomial.X i)

/-- **Laurent polynomials in the initial cluster.** The ring `ℤ[X_i^{±1}]` of Laurent
polynomials with integer coefficients in the initial cluster, as the `ℤ`-subalgebra of
`FractionRing (MvPolynomial n ℤ)` generated by the `X_i` and their inverses (Fomin, Williams and
Zelevinsky, *Introduction to cluster algebras, Chapters 1–3*, arXiv:1608.05735v5,
Theorem 3.3.1, where the conclusion is membership in this ring). -/
noncomputable abbrev laurentSubalgebra (n : Type*) [DecidableEq n] :
    Subalgebra ℤ (FractionRing (MvPolynomial n ℤ)) :=
  Algebra.adjoin ℤ (Set.range (initialCluster n) ∪ Set.range fun i => (initialCluster n i)⁻¹)

variable {K : Type*} [Field K]

/-- The four-term recurrence behind the rank-two Laurent phenomenon: if `z₀ z₂ = z₁ ^ e + 1`,
`z₁ z₃ = z₂ ^ e' + 1` and `z₂ z₄ = z₃ ^ e + 1` with `z₂ ≠ 0` and `e' > 0`, then `z₄` is a
polynomial with integer coefficients in `z₀`, `z₂` and `z₃`. -/
private lemma eq_sub_of_exchange {z₀ z₁ z₂ z₃ z₄ : K} {e e' : ℕ} (he' : 0 < e')
    (h₀ : z₀ * z₂ = z₁ ^ e + 1) (h₁ : z₁ * z₃ = z₂ ^ e' + 1) (h₂ : z₂ * z₄ = z₃ ^ e + 1)
    (hz₂ : z₂ ≠ 0) :
    z₄ = z₀ * z₃ ^ e - z₂ ^ (e' - 1) * ∑ j ∈ Finset.range e, (z₂ ^ e' + 1) ^ j := by
  apply mul_left_cancel₀ hz₂
  obtain ⟨m, rfl⟩ : ∃ m, e' = m + 1 := ⟨e' - 1, by omega⟩
  have hg := geom_sum_mul (z₂ ^ (m + 1) + 1) e
  have hp : (z₁ * z₃) ^ e = (z₂ ^ (m + 1) + 1) ^ e := by rw [h₁]
  rw [Nat.add_sub_cancel]
  linear_combination h₂ - z₃ ^ e * h₀ + hg - hp

/-- **Rank-two Laurent phenomenon in any field.** For positive integers `b, c` and elements
`x, y` of a field, every term of the rank-two exchange recurrence `rankTwoSeq b c x y` lies in
every subring containing `x`, `y`, `x⁻¹` and `y⁻¹`. Equivalently, every term lies in the subring
generated by these four elements, even when a term vanishes, with the convention `a / 0 = 0`.
When `x ≠ 0` and `y ≠ 0`, this subring is the image of the Laurent polynomial ring
`ℤ[X^{±1}, Y^{±1}]` under evaluation at `(x, y)`.
For the initial cluster of `ℚ(x, y)` this is the Laurent phenomenon in rank two (Fomin, Williams
and Zelevinsky, *Introduction to cluster algebras, Chapters 1–3*, arXiv:1608.05735v5, Section 3.2
with Theorem 3.3.1; Fomin and Zelevinsky, *Cluster algebras I*, J. Amer. Math. Soc. 15 (2002),
Theorem 3.1). -/
theorem rankTwoSeq_mem {S : Type*} [SetLike S K] [SubringClass S K] {s : S} {b c : ℕ}
    (hb : 0 < b) (hc : 0 < c) {x y : K} (hx : x ∈ s) (hy : y ∈ s) (hx' : x⁻¹ ∈ s)
    (hy' : y⁻¹ ∈ s) (k : ℕ) : rankTwoSeq b c x y k ∈ s := by
  have hE : ∀ k, 0 < (if k % 2 = 0 then c else b) := fun k => by split_ifs <;> assumption
  suffices H : ∀ n, rankTwoSeq b c x y n ∈ s ∧ rankTwoSeq b c x y (n + 1) ∈ s ∧
      rankTwoSeq b c x y (n + 2) ∈ s ∧ rankTwoSeq b c x y (n + 3) ∈ s from (H k).1
  intro n
  induction n with
  | zero =>
    have h2 : rankTwoSeq b c x y 2 ∈ s := by
      rw [rankTwoSeq_add_two, div_eq_mul_inv]
      exact mul_mem (add_mem (pow_mem hy _) (one_mem _)) hx'
    refine ⟨hx, hy, h2, ?_⟩
    rw [rankTwoSeq_add_two, div_eq_mul_inv]
    exact mul_mem (add_mem (pow_mem h2 _) (one_mem _)) hy'
  | succ n ih =>
    obtain ⟨h0, h1, h2, h3⟩ := ih
    refine ⟨h1, h2, h3, ?_⟩
    rw [show n + 1 + 3 = n + 2 + 2 by omega]
    by_cases hz2 : rankTwoSeq b c x y (n + 2) = 0
    · rw [rankTwoSeq_add_two, hz2, div_zero]
      exact zero_mem _
    by_cases hz1 : rankTwoSeq b c x y (n + 1) = 0
    · -- With `z = rankTwoSeq b c x y`, the terms from `z (n + 1)` on are `0, (z n)⁻¹, 0, z n`.
      have e3 : rankTwoSeq b c x y (n + 2 + 1) = 0 := by
        rw [show n + 2 + 1 = n + 1 + 2 by omega, rankTwoSeq_add_two, hz1, div_zero]
      have e2 : rankTwoSeq b c x y (n + 2) = (rankTwoSeq b c x y n)⁻¹ := by
        rw [rankTwoSeq_add_two, hz1, zero_pow (hE n).ne', zero_add, one_div]
      rw [rankTwoSeq_add_two, e3, zero_pow (hE _).ne', zero_add, e2, one_div, inv_inv]
      exact h0
    have hz0 : rankTwoSeq b c x y n ≠ 0 := fun h => hz2 (by rw [rankTwoSeq_add_two, h, div_zero])
    have h24 := rankTwoSeq_mul_add_two hz2
    rw [Nat.add_mod_right] at h24
    rw [eq_sub_of_exchange (hE (n + 1)) (rankTwoSeq_mul_add_two hz0) (rankTwoSeq_mul_add_two hz1)
      h24 hz2]
    exact sub_mem (mul_mem h0 (pow_mem h3 _)) (mul_mem (pow_mem h2 _)
      (sum_mem fun j _ => pow_mem (add_mem (pow_mem h2 _) (one_mem _)) _))

/-- **Laurent phenomenon in rank two.** For positive integers `b, c`, every term of the
rank-two exchange recurrence started at the initial cluster `(X_0, X_1)` of
`ℚ(X_0, X_1)` is a Laurent polynomial in `X_0, X_1` with integer coefficients (Fomin, Williams
and Zelevinsky, *Introduction to cluster algebras, Chapters 1–3*, arXiv:1608.05735v5,
Section 3.2 with Theorem 3.3.1 for the exchange matrices `±[[0, b], [-c, 0]]`; Fomin and
Zelevinsky, *Cluster algebras I*, J. Amer. Math. Soc. 15 (2002), Theorem 3.1 and Section 6).
It is the case `n = 2`, `B = rankTwoMatrix b c` of `laurent_phenomenon`, by the bridge
`mutateSeq_rankTwoMatrix` and `isSkewSymmetrizable_rankTwoMatrix`. For the finite types
`bc ≤ 3` the terms are computed as explicit Laurent polynomials in
`MathlibExt.RingTheory.ClusterAlgebra.RankTwo`. -/
theorem rankTwoSeq_mem_laurentSubalgebra {b c : ℕ} (hb : 0 < b) (hc : 0 < c) (k : ℕ) :
    rankTwoSeq b c (initialCluster (Fin 2) 0) (initialCluster (Fin 2) 1) k ∈
      laurentSubalgebra (Fin 2) := by
  have h : ∀ i, initialCluster (Fin 2) i ∈ laurentSubalgebra (Fin 2) ∧
      (initialCluster (Fin 2) i)⁻¹ ∈ laurentSubalgebra (Fin 2) := fun i =>
    ⟨Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩), Algebra.subset_adjoin (Or.inr ⟨i, rfl⟩)⟩
  exact rankTwoSeq_mem hb hc (h 0).1 (h 1).1 (h 0).2 (h 1).2 k

end MathlibExt.RingTheory.ClusterAlgebra.LaurentPhenomenonWanted
