/-
The finite-order predicate is the relative endomorphism specialization of
AxiomMath/Stacks, revision c496df0d9beea9deaeabcea8492605f9a0a2313b,
StacksFrontier/RingTheory/DifferentialOperator/Defs.lean (Apache 2.0;
that file has no individual author notice). Modification: retain the
literal commutator recursion and construct the generated operator ring
inside the actual linear endomorphisms, without a freely named D ring.
-/
module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Actual relative differential operators and their order pieces

Order zero means A-linear. Order n+1 is tested by commutators with every
coefficient of A. The ring is the subalgebra of actual k-linear operators
generated by finite-order operators. The source proves that finite-order
operators are closed under these operations; no new primitive theorem is
requested here. Its action on A is the literal endomorphism evaluation.
-/

@[expose] public noncomputable section

namespace MathlibExt.RingTheory.GeometricDifferentialOperators

variable (k : Type) [CommRing k] (A : Type) [CommRing A] [Algebra k A]

abbrev LinearOperator := Module.End k A

def commutator (D : LinearOperator k A) (a : A) : LinearOperator k A :=
  D.comp (Algebra.lsmul k k A a) - (Algebra.lsmul k k A a).comp D

def OrderLE : ℕ → LinearOperator k A → Prop
  | 0, D => ∀ a x : A, D (a * x) = a * D x
  | n + 1, D => ∀ a : A, OrderLE n (commutator k A D a)

def FiniteOrder (D : LinearOperator k A) : Prop := ∃ n : ℕ, OrderLE k A n D

def operatorAlgebra : Subalgebra k (LinearOperator k A) :=
  Algebra.adjoin k {D | FiniteOrder k A D}

abbrev OperatorRing := operatorAlgebra k A

def action : OperatorRing k A →ₐ[k] LinearOperator k A := (operatorAlgebra k A).val

def orderPiece (n : ℕ) : Submodule k (OperatorRing k A) :=
  Submodule.span k {D | OrderLE k A n D.val}

instance operatorRingAddCommGroup : AddCommGroup (OperatorRing k A) :=
  (operatorAlgebra k A).toSubring.toAddSubgroup.toAddCommGroup

instance orderPieceAddCommGroup (n : ℕ) : AddCommGroup (orderPiece k A n) :=
  Submodule.addCommGroup _

def previousInPiece (n : ℕ) : Submodule k (orderPiece k A n) :=
  if n = 0 then ⊥ else
    (orderPiece k A (n - 1)).comap (orderPiece k A n).subtype

abbrev symbolDegree (n : ℕ) := Quotient
  (@Submodule.quotientRel k (orderPiece k A n) _ _ _ (previousInPiece k A n))

/-- Multiplication by an actual coefficient is an order-zero operator. -/
theorem multiplication_orderZero (a : A) :
    OrderLE k A 0 (Algebra.lsmul k k A a) := by
  intro b x
  change a * (b * x) = b * (a * x)
  exact mul_left_comm a b x

/-- The source's k-linear commutator convention agrees with the usual
coefficient-action formula, including its sign. -/
theorem commutator_apply (D : LinearOperator k A) (a x : A) :
    commutator k A D a x = D (a * x) - a * D x := rfl

end MathlibExt.RingTheory.GeometricDifferentialOperators
