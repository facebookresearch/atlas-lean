module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Length

/-!
# Length symmetry of successive ideal quotients

For ideals I,J in a commutative ring R, quotienting R/I by the image of J and quotienting R/J
by the image of I give canonically isomorphic R-algebras. Their lengths as R-modules therefore
agree in ℕ∞, including infinite length.

For elements g,h ∈ R, this identifies the two orders of taking the principal quotients by g
and h and their successive images. No finiteness or regularity condition on the ideals or
elements is needed.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u

namespace Ideal

variable (R : Type u) [CommRing R]

/-- Scalar length equality for two orders of principal quotienting.

For arbitrary g,h in a commutative ring R, the quotient of R/(g) by the ideal generated by the
image of h has the same R-module length as the quotient of R/(h) by the image of g. The
equality is in ℕ∞. -/
theorem length_quotient_span_quotient_span_comm (g h : R) :
    Module.length R
        ((R ⧸ Ideal.span {g}) ⧸
          Ideal.span {Ideal.Quotient.mk (Ideal.span {g}) h}) =
      Module.length R
        ((R ⧸ Ideal.span {h}) ⧸
          Ideal.span {Ideal.Quotient.mk (Ideal.span {h}) g}) := by
  have hgh : (Ideal.span {h}).map
      (Ideal.Quotient.mk (Ideal.span {g})) =
      Ideal.span {Ideal.Quotient.mk (Ideal.span {g}) h} := by
    rw [Ideal.map_span]
    simp
  have hhg : (Ideal.span {g}).map
      (Ideal.Quotient.mk (Ideal.span {h})) =
      Ideal.span {Ideal.Quotient.mk (Ideal.span {h}) g} := by
    rw [Ideal.map_span]
    simp
  rw [← hgh, ← hhg]
  exact (DoubleQuot.quotQuotEquivCommₐ R (Ideal.span {g})
    (Ideal.span {h})).toLinearEquiv.length_eq

end Ideal
