/-!
# Szpilrajn's Problem 191

The sum of a countable and an uncountable fair-coin product gives an atomless probability
measure without an independent base.
-/

@[expose] public section

namespace MathlibExt.MeasureTheory.ScottishBook191Wanted

/-- **Convex measure.** A measure $\mu$ on a measurable space $X$ is convex (in Fréchet's sense,
"sans singularités") if $\mu(X) = 1$ and every measurable set $A$ with $\mu(A) > 0$ contains a
measurable subset $B$ with $0 < \mu(B) < \mu(A)$. -/
def IsConvexMeasure {X : Type} [MeasurableSpace X] (μ : MeasureTheory.Measure X) :
    Prop :=
  μ Set.univ = 1 ∧ ∀ A : Set X, MeasurableSet A → 0 < μ A →
    ∃ B : Set X, B ⊆ A ∧ MeasurableSet B ∧ μ A > μ B ∧ 0 < μ B

/-- **Stochastically independent class of sets.** Let $\mu$ be a measure on a measurable space
$X$. A class $B$ of subsets of $X$ is stochastically independent with respect to $\mu$ if for
every finite collection of distinct sets $A_1, \dots, A_n$ in $B$, including the empty one,
$\mu(A_1 \cap \dots \cap A_n) = \mu(A_1) \cdots \mu(A_n)$. The empty intersection is $X$ and the
empty product is $1$, so this forces $\mu(X) = 1$. The sets in $B$ need not be measurable; on
such sets $\mu$ is the outer measure. -/
def IsIndependentClass {X : Type} [MeasurableSpace X] (B : Set (Set X))
    (μ : MeasureTheory.Measure X) : Prop :=
  ∀ s : Finset (Set X), (↑s : Set (Set X)) ⊆ B →
    μ (⋂₀ (↑s : Set (Set X))) = ∏ A ∈ s, μ A

/-- **Base of a measure.** Let $\mu$ be a measure on a measurable space $X$. A class $B$ of
subsets of $X$ is a base of $\mu$ if every set in $B$ is measurable, $B$ is stochastically
independent with respect to $\mu$, and every measurable set $A \subseteq X$ agrees up to a null
set with a set $C$ in the $\sigma$-algebra generated by $B$, that is, $\mu(A \triangle C) = 0$. -/
def IsBase {X : Type} [MeasurableSpace X] (B : Set (Set X))
    (μ : MeasureTheory.Measure X) : Prop :=
  (∀ A ∈ B, MeasurableSet A) ∧ IsIndependentClass B μ ∧
    ∀ A : Set X, MeasurableSet A → ∃ C : Set X,
      @MeasurableSet X (MeasurableSpace.generateFrom B) C ∧
        μ (A \ C ∪ C \ A) = 0

/-- **The claim of Szpilrajn's Problem 191.** The proposition, Szpilrajn's Problem 191 from the
Scottish Book in its original form, that for every measurable space $X$, every convex measure
$\mu$ on $X$ has a base, that is, some class $B$ of subsets of $X$ is a base of $\mu$. -/
def ScottishBookProblem191Claim : Prop :=
  ∀ (X : Type) [MeasurableSpace X] (μ : MeasureTheory.Measure X),
    IsConvexMeasure μ → ∃ B : Set (Set X), IsBase B μ

namespace szpilrajn191_refuted

open _root_.MeasureTheory MeasurableSpace ProbabilityTheory Set
open scoped ENNReal symmDiff

-- Every set in a generated σ-algebra uses only countably many generators.
private theorem countable_support {X : Type*} {B : Set (Set X)} {A : Set X}
    (hA : MeasurableSet[generateFrom B] A) :
    ∃ D ⊆ B, D.Countable ∧ MeasurableSet[generateFrom D] A := by
  induction A, hA using generateFrom_induction with
  | hC t ht _ => exact ⟨{t}, singleton_subset_iff.mpr ht, countable_singleton _,
      measurableSet_generateFrom (mem_singleton _)⟩
  | empty => exact ⟨∅, empty_subset _, countable_empty, @MeasurableSet.empty _ (generateFrom ∅)⟩
  | compl t _ ih =>
    obtain ⟨D, hD, hc, ht⟩ := ih
    exact ⟨D, hD, hc, ht.compl⟩
  | iUnion f _ ih =>
    choose D hD hc hf using ih
    exact ⟨⋃ n, D n, iUnion_subset hD, countable_iUnion hc,
      MeasurableSet.iUnion fun n ↦ generateFrom_mono (subset_iUnion D n) _ (hf n)⟩

private theorem common_countable_support {X ι : Type*} [Countable ι] {B : Set (Set X)}
    {f : ι → Set X} (hf : ∀ i, MeasurableSet[generateFrom B] (f i)) :
    ∃ D ⊆ B, D.Countable ∧ ∀ i, MeasurableSet[generateFrom D] (f i) := by
  choose D hD hc h using fun i ↦ countable_support (hf i)
  exact ⟨⋃ i, D i, iUnion_subset hD, countable_iUnion hc,
    fun i ↦ generateFrom_mono (subset_iUnion D i) _ (h i)⟩

private abbrev aeGeneratedSpace {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (D : Set (Set X)) : MeasurableSpace X :=
  eventuallyMeasurableSpace (generateFrom D) (ae μ)

private theorem measure_inter_of_ae_eq {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {A T C : Set X} (hTC : T =ᵐ[μ] C) (h : μ (A ∩ C) = μ A * μ C) :
    μ (A ∩ T) = μ A * μ T := by
  rw [measure_congr (ae_eq_set_inter .rfl hTC), h, measure_congr hTC]

-- An independent event is independent of every event generated by the other indices.
private theorem measure_inter_generate {X ι : Type*} [MeasurableSpace X] {μ : Measure X}
    {f : ι → Set X} (hm : ∀ i, MeasurableSet (f i)) (hf : iIndepSet f μ)
    {J : Set ι} {i : ι} (hi : i ∉ J) {T : Set X}
    (hT : MeasurableSet[generateFrom (f '' J)] T) :
    μ (f i ∩ T) = μ (f i) * μ T := by
  have h := hf.indep_generateFrom_of_disjoint hm {i} J (disjoint_singleton_left.mpr hi)
  exact (h.indepSet_of_measurableSet
    (measurableSet_generateFrom ⟨i, rfl, rfl⟩) hT).measure_inter_eq_mul

private theorem indepSet_of_class {X : Type} [MeasurableSpace X] {μ : Measure X}
    {B : Set (Set X)} (hm : ∀ A ∈ B, MeasurableSet A) (hB : IsIndependentClass B μ) :
    iIndepSet (fun A : B ↦ (A : Set X)) μ := by
  classical
  rw [iIndepSet_iff_meas_biInter (fun A : B ↦ hm A A.property)]
  intro s
  let e : B ↪ Set X := ⟨Subtype.val, Subtype.val_injective⟩
  have hs : (↑(s.map e) : Set (Set X)) ⊆ B := by
    intro A hA
    obtain ⟨a, _, rfl⟩ := Finset.mem_map.mp hA
    exact a.property
  simpa [sInter_eq_biInter, e] using hB (s.map e) hs

private theorem measure_inter_of_base {X : Type} [MeasurableSpace X] {μ : Measure X}
    {B D : Set (Set X)} (hB : IsBase B μ) (hDB : D ⊆ B)
    {A T : Set X} (hA : A ∈ B) (hAD : A ∉ D) (hT : MeasurableSet[aeGeneratedSpace μ D] T) :
    μ (A ∩ T) = μ A * μ T := by
  obtain ⟨C, hC, he⟩ := hT
  have hD : Subtype.val '' (Subtype.val ⁻¹' D : Set B) = D := by
    rw [image_preimage_eq_inter_range, Subtype.range_val, inter_eq_left.mpr hDB]
  rw [← hD] at hC
  exact measure_inter_of_ae_eq he (measure_inter_generate (fun a : B ↦ hB.1 a a.property)
    (indepSet_of_class hB.1 hB.2.1) (i := ⟨A, hA⟩) hAD hC)

private noncomputable def fairCoin : Measure Bool :=
  Ber(true, false, ⟨1 / 2, by norm_num, by norm_num⟩)

private instance fairCoinProbability : IsProbabilityMeasure fairCoin :=
  inferInstanceAs (IsProbabilityMeasure (bernoulliMeasure _ _ _))

private theorem fairCoin_singleton (b : Bool) : fairCoin {b} = 1 / 2 := by
  classical
  let p : unitInterval := ⟨1 / 2, by norm_num, by norm_num⟩
  have hs : unitInterval.symm p = p := by
    apply Subtype.ext
    change 1 - (1 / 2 : ℝ) = 1 / 2
    norm_num
  have hp : (unitInterval.toNNReal p : ℝ≥0∞) = 1 / 2 := by
    rw [ENNReal.coe_nnreal_eq]
    change ENNReal.ofReal ((1 : ℝ) / 2) = 1 / 2
    rw [ENNReal.ofReal_div_of_pos (by norm_num), ENNReal.ofReal_one, ENNReal.ofReal_ofNat]
  change (bernoulliMeasure true false p) {b} = 1 / 2
  rw [bernoulliMeasure_apply p (measurableSet_singleton b), hs, hp]
  cases b <;> simp

private noncomputable def coinProduct (ι : Type*) : Measure (ι → Bool) :=
  Measure.infinitePi fun _ : ι ↦ fairCoin

private instance coinProductProbability (ι : Type*) : IsProbabilityMeasure (coinProduct ι) :=
  inferInstanceAs (IsProbabilityMeasure (Measure.infinitePi _))

private def coinEvent {ι : Type*} (i : ι) : Set (ι → Bool) :=
  (fun x ↦ x i) ⁻¹' {true}

private theorem measurableSet_coinEvent {ι : Type*} (i : ι) :
    MeasurableSet (coinEvent i) :=
  measurable_pi_apply i (measurableSet_singleton true)

private theorem measure_coinEvent {ι : Type*} (i : ι) :
    coinProduct ι (coinEvent i) = 1 / 2 := by
  have hm := measurePreserving_eval_infinitePi (fun _ : ι ↦ fairCoin) i
  rw [coinEvent, coinProduct, hm.measure_preimage (measurableSet_singleton true).nullMeasurableSet,
    fairCoin_singleton]

private theorem indep_coinEvent (ι : Type*) : iIndepSet (@coinEvent ι) (coinProduct ι) := by
  rw [iIndepSet_iff_meas_biInter measurableSet_coinEvent]
  intro s
  exact (iIndepFun_infinitePi (P := fun _ : ι ↦ fairCoin) (X := fun _ ↦ id)
    (fun _ ↦ measurable_id)).measure_inter_preimage_eq_mul s
      (sets := fun _ ↦ {true}) (fun _ _ ↦ measurableSet_singleton true)

private theorem generateFrom_coinEvent (ι : Type*) :
    generateFrom (range (@coinEvent ι)) = (inferInstance : MeasurableSpace (ι → Bool)) := by
  refine le_antisymm (generateFrom_le ?_) ?_
  · rintro _ ⟨i, rfl⟩
    exact measurableSet_coinEvent i
  · rw [MeasurableSpace.pi_eq_generateFrom_projections]
    refine generateFrom_le ?_
    rintro _ ⟨i, U, _, rfl⟩
    classical
    have he : MeasurableSet[generateFrom (range (@coinEvent ι))] (coinEvent i) :=
      measurableSet_generateFrom (mem_range_self i)
    by_cases ht : true ∈ U <;> by_cases hf : false ∈ U
    · convert MeasurableSet.univ using 1
      ext x
      cases h : x i <;> simp [h, ht, hf]
    · convert he using 1
      ext x
      cases h : x i <;> simp [coinEvent, h, ht, hf]
    · convert he.compl using 1
      ext x
      cases h : x i <;> simp [coinEvent, h, ht, hf]
    · convert MeasurableSet.empty using 1
      ext x
      cases h : x i <;> simp [h, ht, hf]

private theorem coinProduct_nat_singleton (b : ℕ → Bool) : coinProduct ℕ {b} = 0 := by
  rw [coinProduct, Measure.infinitePi_singleton]
  simp only [fairCoin_singleton]
  rw [ENNReal.tprod_eq_iInf_prod (fun _ ↦ by norm_num)]
  apply le_antisymm _ zero_le
  have hhalf : (1 / 2 : ℝ≥0∞) < 1 := by norm_num
  refine ge_of_tendsto' (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one hhalf) fun n ↦ ?_
  simpa using iInf_le (fun s : Finset ℕ ↦ ∏ _ ∈ s, (1 / 2 : ℝ≥0∞)) (Finset.range n)

-- An atom would fix the values of infinitely many distinct coordinates.
private theorem coinProduct_noAtoms (ι : Type*) [Infinite ι] : NoAtoms (coinProduct ι) := by
  classical
  refine ⟨fun A hA ↦ ?_⟩
  let μ := coinProduct ι
  let e := Infinite.natEmbedding ι
  have hfixed (n : ℕ) : ∃ b : Bool, ∀ᵐ x ∂μ.restrict A, x (e n) = b := by
    let E := coinEvent (e n)
    have hE : MeasurableSet E := measurableSet_coinEvent _
    rcases hA.measure_eq_zero_or_eq (t := E ∩ A) inter_subset_right with hzero | hfull
    · refine ⟨false, ae_iff.mpr ?_⟩
      have heq : {x : ι → Bool | ¬ x (e n) = false} = E := by
        ext x
        cases hx : x (e n) <;> simp [E, coinEvent, hx]
      rw [heq, Measure.restrict_apply hE]
      exact hzero
    · refine ⟨true, ?_⟩
      apply Filter.eventuallyEqSet_univ.mp
        ((ae_eq_univ_iff_measure_eq hE.nullMeasurableSet).mpr ?_ : E =ᵐ[μ.restrict A] univ)
      rw [Measure.restrict_apply hE, Measure.restrict_apply MeasurableSet.univ, univ_inter]
      exact hfull
  choose b hb using hfixed
  let f : (ι → Bool) → (ℕ → Bool) := fun x n ↦ x (e n)
  have hf : Measurable f := measurable_pi_iff.mpr fun n ↦ measurable_pi_apply (e n)
  have hpre : MeasurableSet (f ⁻¹' {b}) := hf (measurableSet_singleton b)
  have hnull : μ (f ⁻¹' {b}) = 0 := by
    rw [← Measure.map_apply hf (measurableSet_singleton b)]
    change (Measure.map (fun x n ↦ x (e n)) (Measure.infinitePi fun _ : ι ↦ fairCoin)) {b} = 0
    rw [Measure.map_infinitePi_infinitePi_of_inj e.injective]
    exact coinProduct_nat_singleton b
  have hfull : f ⁻¹' {b} =ᵐ[μ.restrict A] univ :=
    Filter.eventuallyEqSet_univ.mpr ((ae_all_iff.mpr hb).mono fun x hx ↦
      mem_singleton_iff.mpr (funext hx))
  have hz := (ae_eq_univ_iff_measure_eq hpre.nullMeasurableSet).mp hfull
  rw [Measure.restrict_apply hpre, Measure.restrict_apply MeasurableSet.univ, univ_inter] at hz
  exact hA.pos.not_ge (hz ▸ measure_mono_null inter_subset_left hnull).le

private instance setsOfNatUncountable : Uncountable (Set ℕ) :=
  uncountable_iff_forall_not_surjective.mpr Function.cantor_surjective

private abbrev CoinSum := (ℕ → Bool) ⊕ (Set ℕ → Bool)

private noncomputable def mixture : Measure CoinSum :=
  (1 / 2 : ℝ≥0∞) • ((coinProduct ℕ).map Sum.inl + (coinProduct (Set ℕ)).map Sum.inr)

private theorem mixture_apply {A : Set CoinSum} (hA : MeasurableSet A) :
    mixture A = (1 / 2) *
      (coinProduct ℕ (Sum.inl ⁻¹' A) + coinProduct (Set ℕ) (Sum.inr ⁻¹' A)) := by
  rw [mixture, smul_apply, add_apply, Measure.map_apply measurable_inl hA,
    Measure.map_apply measurable_inr hA, smul_eq_mul]

private instance mixtureProbability : IsProbabilityMeasure mixture where
  measure_univ := by
    rw [mixture_apply MeasurableSet.univ]
    simp only [preimage_univ, measure_univ]
    rw [one_add_one_eq_two, ENNReal.div_mul_cancel (by norm_num) (by simp)]

private theorem mixture_inl {S : Set (ℕ → Bool)} (hS : MeasurableSet S) :
    mixture (Sum.inl '' S) = (1 / 2) * coinProduct ℕ S := by
  rw [mixture_apply hS.inl_image]
  simp [Sum.inl_injective.preimage_image]

private theorem mixture_inr {S : Set (Set ℕ → Bool)} (hS : MeasurableSet S) :
    mixture (Sum.inr '' S) = (1 / 2) * coinProduct (Set ℕ) S := by
  rw [mixture_apply hS.inr_image]
  simp [Sum.inr_injective.preimage_image]

private theorem mixture_convex : IsConvexMeasure mixture := by
  refine ⟨measure_univ, fun A hA hpos ↦ ?_⟩
  have hhalf : (1 / 2 : ℝ≥0∞) ≠ 0 := by norm_num
  have hfinite : (1 / 2 : ℝ≥0∞) ≠ ∞ := by simp
  rcases (measurableSet_sum_iff.mp hA) with ⟨hl, hr⟩
  by_cases hp : 0 < coinProduct ℕ (Sum.inl ⁻¹' A)
  · let := coinProduct_noAtoms ℕ
    obtain ⟨S, hS, hm, hpos', hlt⟩ := NoAtoms.exists_measurable_subset_lt hl hp
    refine ⟨Sum.inl '' S, image_subset_iff.mpr hS, hm.inl_image, ?_, ?_⟩
    · rw [mixture_inl hm, mixture_apply hA]
      exact ENNReal.mul_lt_mul_right hhalf hfinite (hlt.trans_le le_self_add)
    · rw [mixture_inl hm]
      exact pos_iff_ne_zero.mpr (mul_ne_zero hhalf hpos'.ne')
  · have hp' : 0 < coinProduct (Set ℕ) (Sum.inr ⁻¹' A) := by
      rw [mixture_apply hA, nonpos_iff_eq_zero.mp (not_lt.mp hp), zero_add] at hpos
      exact pos_iff_ne_zero.mpr fun hz ↦ hpos.ne' (by simp [hz])
    let := coinProduct_noAtoms (Set ℕ)
    obtain ⟨S, hS, hm, hpos', hlt⟩ := NoAtoms.exists_measurable_subset_lt hr hp'
    refine ⟨Sum.inr '' S, image_subset_iff.mpr hS, hm.inr_image, ?_, ?_⟩
    · rw [mixture_inr hm, mixture_apply hA]
      exact ENNReal.mul_lt_mul_right hhalf hfinite (hlt.trans_le le_add_self)
    · rw [mixture_inr hm]
      exact pos_iff_ne_zero.mpr (mul_ne_zero hhalf hpos'.ne')

private theorem exists_ae_generate {μ : Measure CoinSum} {B : Set (Set CoinSum)}
    (hB : IsBase B μ) {A : Set CoinSum} (hA : MeasurableSet A) :
    MeasurableSet[aeGeneratedSpace μ B] A := by
  obtain ⟨C, hC, he⟩ := hB.2.2 A hA
  exact ⟨C, hC, measure_symmDiff_eq_zero_iff.mp he⟩

private abbrev leftComponent : Set CoinSum := range Sum.inl

-- A common countable subfamily of a base suffices on the entire left component.
private theorem countable_support_left {B : Set (Set CoinSum)} (hB : IsBase B mixture) :
    ∃ D ⊆ B, D.Countable ∧ ∀ S : Set (ℕ → Bool), MeasurableSet S →
      MeasurableSet[aeGeneratedSpace mixture D] (Sum.inl '' S) := by
  let F : Set (Set CoinSum) := insert leftComponent (range fun n ↦ Sum.inl '' coinEvent n)
  have hF : F.Countable := (countable_range _).insert _
  have hFm (A : F) : MeasurableSet (A : Set CoinSum) := by
    rcases mem_insert_iff.mp A.property with h | ⟨n, h⟩
    · exact h ▸ measurableSet_range_inl
    · exact h ▸ (measurableSet_coinEvent n).inl_image
  choose C hC he using fun A : F ↦ exists_ae_generate hB (hFm A)
  let : Countable F := hF
  obtain ⟨D, hDB, hDc, hgen⟩ := common_countable_support hC
  have hD (A : F) : MeasurableSet[aeGeneratedSpace mixture D] (A : Set CoinSum) :=
    ⟨C A, hgen A, he A⟩
  have hL : MeasurableSet[aeGeneratedSpace mixture D] leftComponent :=
    hD ⟨_, mem_insert _ _⟩
  refine ⟨D, hDB, hDc, fun S hS ↦ ?_⟩
  have hS' : MeasurableSet[generateFrom (range (@coinEvent ℕ))] S := by
    rw [generateFrom_coinEvent]
    exact hS
  clear hS
  induction S, hS' using generateFrom_induction with
  | hC T hT _ =>
    obtain ⟨n, rfl⟩ := hT
    exact hD ⟨_, mem_insert_of_mem _ (mem_range_self n)⟩
  | empty =>
    rw [image_empty]
    exact @MeasurableSet.empty _ (aeGeneratedSpace mixture D)
  | compl T _ ih =>
    rw [compl_eq_univ_sdiff, image_sdiff Sum.inl_injective, image_univ]
    exact hL.diff ih
  | iUnion f _ ih =>
    rw [image_iUnion]
    exact MeasurableSet.iUnion ih

-- A generator outside the countable subfamily is independent of the left component and of
-- its own intersection with that component. Since the left component has positive measure,
-- the generator has probability zero or one.
private theorem reduced_base {B : Set (Set CoinSum)} (hB : IsBase B mixture) :
    ∃ D ⊆ B, D.Countable ∧ ∀ A : Set CoinSum, MeasurableSet A →
      MeasurableSet[aeGeneratedSpace mixture D] A := by
  obtain ⟨D, hDB, hDc, hD⟩ := countable_support_left hB
  have hL : MeasurableSet[aeGeneratedSpace mixture D] leftComponent := by
    simpa only [image_univ] using hD univ MeasurableSet.univ
  have hLpos : mixture leftComponent ≠ 0 := by
    rw [leftComponent, ← image_univ, mixture_inl MeasurableSet.univ, measure_univ, mul_one]
    norm_num
  have hle : generateFrom B ≤ aeGeneratedSpace mixture D := by
    apply generateFrom_le
    intro A hA
    by_cases hAD : A ∈ D
    · exact (measurableSet_generateFrom hAD).eventuallyMeasurableSet
    · have hAL : MeasurableSet[aeGeneratedSpace mixture D] (A ∩ leftComponent) := by
        rw [← image_preimage_eq_inter_range]
        exact hD _ (measurable_inl (hB.1 A hA))
      have he := measure_inter_of_base hB hDB hA hAD hL
      have he' := measure_inter_of_base hB hDB hA hAD hAL
      rw [← inter_assoc, inter_self] at he'
      by_cases hz : mixture A = 0
      · exact ⟨∅, @MeasurableSet.empty _ (generateFrom D), ae_eq_empty.mpr hz⟩
      · have hnonzero : mixture (A ∩ leftComponent) ≠ 0 := by
          rw [he]
          exact mul_ne_zero hz hLpos
        have hone : mixture A = 1 := by
          apply (ENNReal.mul_left_inj hnonzero (measure_ne_top _ _)).mp
          simpa only [one_mul] using he'.symm
        exact ⟨univ, @MeasurableSet.univ _ (generateFrom D),
          (ae_eq_univ_iff_measure_eq (hB.1 A hA).nullMeasurableSet).mpr
            (hone.trans measure_univ.symm)⟩
  refine ⟨D, hDB, hDc, fun A hA ↦ ?_⟩
  obtain ⟨C, hC, he⟩ := exists_ae_generate hB hA
  exact EventuallyMeasurableSet.congr (hle C hC) he

private theorem coinEvent_injective (ι : Type*) : Function.Injective (@coinEvent ι) := by
  classical
  intro i j h
  by_contra hij
  have hm : (fun k ↦ decide (k = i)) ∈ coinEvent i := by simp [coinEvent]
  rw [h] at hm
  simp [coinEvent, Ne.symm hij] at hm

-- A fresh coordinate on the right cannot agree almost everywhere with a set generated
-- by a countable family, since it is independent of every set generated by that family.
private theorem mixture_no_base (B : Set (Set CoinSum)) : ¬ IsBase B mixture := by
  intro hB
  obtain ⟨D, hDB, hDc, hD⟩ := reduced_base hB
  let : Countable D := hDc
  have hproj (A : D) :
      MeasurableSet[generateFrom (range (@coinEvent (Set ℕ)))] (Sum.inr ⁻¹' (A : Set CoinSum)) := by
    rw [generateFrom_coinEvent]
    exact measurable_inr (hB.1 A (hDB A.property))
  obtain ⟨F, hF, hFc, hFgen⟩ := common_countable_support hproj
  let J := coinEvent ⁻¹' F
  have hJc : J.Countable := hFc.preimage (coinEvent_injective _)
  have hJF : coinEvent '' J = F := by
    rw [image_preimage_eq_inter_range, inter_eq_left.mpr hF]
  obtain ⟨i, hi⟩ : ∃ i, i ∉ J := by
    by_contra! h
    exact not_countable_univ (eq_univ_of_forall h ▸ hJc)
  let E : Set CoinSum := Sum.inr '' coinEvent i
  have hE : MeasurableSet E := (measurableSet_coinEvent i).inr_image
  obtain ⟨C, hC, he⟩ := hD E hE
  have hCm : MeasurableSet C := generateFrom_le (fun A hA ↦ hB.1 A (hDB hA)) C hC
  have hCr : MeasurableSet[generateFrom (coinEvent '' J)] (Sum.inr ⁻¹' C) := by
    have hle : generateFrom (preimage (Sum.inr : (Set ℕ → Bool) → CoinSum) '' D) ≤
        generateFrom F := by
      apply generateFrom_le
      rintro _ ⟨A, hA, rfl⟩
      exact hFgen ⟨A, hA⟩
    rw [hJF]
    exact hle _ (comap_generateFrom ▸ ⟨C, hC, rfl⟩)
  have hz : coinProduct (Set ℕ) (Sum.inr ⁻¹' (E ∆ C)) = 0 := by
    have h := measure_symmDiff_eq_zero_iff.mpr he
    rw [mixture_apply (hE.symmDiff hCm)] at h
    exact (add_eq_zero.mp ((mul_eq_zero.mp h).resolve_left (by norm_num))).2
  have he' : coinEvent i =ᵐ[coinProduct (Set ℕ)] Sum.inr ⁻¹' C := by
    apply measure_symmDiff_eq_zero_iff.mp
    simpa [preimage_symmDiff, E, Sum.inr_injective.preimage_image] using hz
  have heq := measure_inter_of_ae_eq he'
    (measure_inter_generate measurableSet_coinEvent (indep_coinEvent _) hi hCr)
  rw [inter_self, measure_coinEvent] at heq
  have heq' : 1 = (1 / 2 : ℝ≥0∞) :=
    (ENNReal.mul_right_inj (a := 1 / 2) (by norm_num) (by simp)).mp
      (by simpa only [mul_one] using heq)
  exact (ENNReal.half_lt_self (a := 1) one_ne_zero ENNReal.one_ne_top).ne' heq'

end szpilrajn191_refuted

/--
**Szpilrajn's Problem 191 has a negative answer.** The claim of Szpilrajn's Problem 191 is false:
not every convex measure possesses a base. That is, there are a measurable space $X$ and a convex
measure $\mu$ on $X$ such that no class of subsets of $X$ is a base of $\mu$.

A non-atomic (convex) measure has a base if and only if its
measure algebra is homogeneous, and the direct sum of Lebesgue measure
spaces gives a counterexample whose measure algebra is not homogeneous.

Source: E. Szpilrajn, Problem 191 of the Scottish Book; the sets `B n`
of numbers in `[0, 1]` whose `n`-th binary digit is `1` form a base for
Lebesgue measure on `[0, 1]`. See the commentary in R. D. Mauldin (ed.),
The Scottish Book, 2nd ed. (Birkhäuser, 2015).
-/
theorem szpilrajn191_refuted : ¬ ScottishBookProblem191Claim := by
  intro h
  obtain ⟨B, hB⟩ := h szpilrajn191_refuted.CoinSum _ szpilrajn191_refuted.mixture_convex
  exact szpilrajn191_refuted.mixture_no_base B hB

end MathlibExt.MeasureTheory.ScottishBook191Wanted
