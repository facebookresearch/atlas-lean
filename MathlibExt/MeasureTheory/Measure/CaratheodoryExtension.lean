module

public import Mathlib.MeasureTheory.Measure.AddContent
public import Mathlib.MeasureTheory.Measure.Restrict
public import Mathlib.MeasureTheory.OuterMeasure.OfAddContent
public import Mathlib.MeasureTheory.SetAlgebra
public import Mathlib.MeasureTheory.SetSemiring

/-!
# Carathéodory's extension theorem

If `μ₀` is a `σ`-finite, `σ`-subadditive additive content on a set algebra `𝒜`,
then there exists a *unique* measure on the `σ`-algebra generated by `𝒜`
extending `μ₀`.

## Source

This formalizes the target "Caratheéodory Extension Theorem" (Lecture 2,
section "Caratheéodory Extension Theorem") of
`v1/Atlas/TheoryOfProbability/targets.yaml`: "If `μ` is a `σ`-finite measure
on an algebra `A` then `μ` has a unique extension to the `σ`-algebra generated
by `A`." Its v1 formalization is
`v1/Atlas/TheoryOfProbability/code/CaratheodoryExtension.lean`
(`caratheodory_extension_theorem`).

## Relation to Mathlib

Mathlib has the two ingredients separately but not the combined
existence-and-uniqueness statement: existence is
`MeasureTheory.AddContent.measure`, and uniqueness is
`MeasureTheory.Measure.ext_of_generateFrom_of_iUnion`. This file packages
them as the book's theorem. The `R^d` rectangle-function existence
statement (`caratheodory_extension_rectangleFunction` in v1's
`ProbMeasuresRd.lean`), which would additionally require building a
content from a distribution function and verifying `σ`-subadditivity, is
left unproved in v1 and is not claimed here.

## Main results

* `MeasureTheory.exists_measure_extension`: existence half: a
  `σ`-subadditive additive content on a set algebra extends to a measure
  on the generated `σ`-algebra, agreeing with the content on the algebra.
* `MeasureTheory.caratheodory_extension_theorem`: the full theorem:
  under a `σ`-finiteness hypothesis (a cover by sets of the algebra of
  finite content), the extension is unique.
-/

@[expose] public section

open scoped ENNReal

noncomputable section

open Set MeasureTheory MeasureTheory.Measure MeasurableSpace

namespace MeasureTheory

/-- **Every algebra of sets is a semiring of sets.** If $\mathcal{A}$ is an algebra of sets on
$\alpha$, then $\mathcal{A}$ is a semiring of sets: $\emptyset \in \mathcal{A}$, $s \cap t \in
\mathcal{A}$ for all $s, t \in \mathcal{A}$, and for all $s, t \in \mathcal{A}$ the difference
$s \setminus t$ is the union of finitely many pairwise disjoint members of $\mathcal{A}$. -/
theorem isSetSemiring_of_isSetAlgebra {α : Type*} {𝒜 : Set (Set α)} (h : IsSetAlgebra 𝒜) :
    IsSetSemiring 𝒜 :=
  (IsSetRing.mk h.empty_mem (fun {_} {_} hs ht => h.union_mem hs ht)
    (fun {_} {_} hs ht => h.sdiff_mem hs ht)).isSetSemiring

/-- **Every algebra of sets is a π-system.** If $\mathcal{A}$ is an algebra of sets on $\alpha$,
then $\mathcal{A}$ is a $\pi$-system: for all $s, t \in \mathcal{A}$ with $s \cap t$ nonempty, we
have $s \cap t \in \mathcal{A}$. -/
lemma isSetAlgebra_isPiSystem {α : Type*} {𝒜 : Set (Set α)} (h : IsSetAlgebra 𝒜) :
    IsPiSystem 𝒜 := fun _s hs _t ht _ => h.inter_mem hs ht

/-- **Existence of the Carathéodory extension.** Let $\mathcal{A}$ be an algebra of sets on
$\alpha$ and let $\mu_0$ be an additive content on $\mathcal{A}$ with values in $[0, \infty]$
that is $\sigma$-subadditive: whenever $s_0, s_1, \dots \in \mathcal{A}$ and
$\bigcup_i s_i \in \mathcal{A}$, we have $\mu_0(\bigcup_i s_i) \le \sum_i \mu_0(s_i)$. Then there
is a measure $\mu$ on the $\sigma$-algebra $\sigma(\mathcal{A})$ generated by $\mathcal{A}$ such
that $\mu(s) = \mu_0(s)$ for every $s \in \mathcal{A}$. -/
lemma exists_measure_extension
    {α : Type*}
    (𝒜 : Set (Set α))
    (h𝒜 : IsSetAlgebra 𝒜)
    (μ₀ : AddContent ℝ≥0∞ 𝒜)
    (hμ₀_sigma : μ₀.IsSigmaSubadditive) :
    ∃ μ : @Measure α (generateFrom 𝒜), ∀ s ∈ 𝒜, μ s = μ₀ s := by
  have h_semi : IsSetSemiring 𝒜 := isSetSemiring_of_isSetAlgebra h𝒜
  exact ⟨μ₀.measure (mα := generateFrom 𝒜) h_semi le_rfl hμ₀_sigma, fun s hs =>
    μ₀.measure_eq (mα := generateFrom 𝒜) h_semi rfl hμ₀_sigma hs⟩

/-- **Carathéodory extension theorem.** Let $\mathcal{A}$ be an algebra of sets on $\alpha$ and
let $\mu_0$ be an additive content on $\mathcal{A}$ with values in $[0, \infty]$ that is
$\sigma$-subadditive: whenever $s_0, s_1, \dots \in \mathcal{A}$ and
$\bigcup_i s_i \in \mathcal{A}$, we have $\mu_0(\bigcup_i s_i) \le \sum_i \mu_0(s_i)$. Suppose
there are sets $B_0, B_1, \dots \in \mathcal{A}$ with $\bigcup_i B_i = \alpha$ and
$\mu_0(B_i) < \infty$ for every $i$. Then there is exactly one measure $\mu$ on the
$\sigma$-algebra $\sigma(\mathcal{A})$ generated by $\mathcal{A}$ such that
$\mu(s) = \mu_0(s)$ for every $s \in \mathcal{A}$. -/
theorem caratheodory_extension_theorem
    {α : Type*}
    (𝒜 : Set (Set α))
    (h𝒜 : IsSetAlgebra 𝒜)
    (μ₀ : AddContent ℝ≥0∞ 𝒜)
    (hμ₀_sigma : μ₀.IsSigmaSubadditive)
    (B : ℕ → Set α)
    (hB_mem : ∀ i, B i ∈ 𝒜)
    (hB_cover : ⋃ i, B i = univ)
    (hB_fin : ∀ i, μ₀ (B i) ≠ ⊤) :
    ∃! μ : @Measure α (generateFrom 𝒜), ∀ s ∈ 𝒜, μ s = μ₀ s := by
  obtain ⟨μ, hμ⟩ := exists_measure_extension 𝒜 h𝒜 μ₀ hμ₀_sigma
  refine ⟨μ, hμ, fun ν hν => ?_⟩
  exact (Measure.ext_of_generateFrom_of_iUnion 𝒜 B rfl
    (isSetAlgebra_isPiSystem h𝒜) hB_cover hB_mem
    (fun i => by rw [hμ (B i) (hB_mem i)]; exact hB_fin i)
    (fun s hs => by rw [hμ s hs, hν s hs])).symm

end MeasureTheory

end
