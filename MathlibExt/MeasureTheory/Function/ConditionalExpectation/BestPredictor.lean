module

public import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real

/-!
# The conditional expectation is the best square-integrable predictor

On a finite measure space, let `Y` be square-integrable and `m` a sub-σ-algebra (the information
available to a predictor).

* `integral_sub_condExp_mul_eq_zero`: the residual `Y - μ[Y|m]` is orthogonal to every
  square-integrable strongly `m`-measurable `h`.
* `integral_sq_sub_eq_integral_sq_sub_condExp_add` (**Pythagorean identity**): for every
  square-integrable strongly `m`-measurable `g`,
  `∫ (Y - g)² = ∫ (Y - μ[Y|m])² + ∫ (μ[Y|m] - g)²`.
* `integral_sq_sub_condExp_le`: hence `μ[Y|m]` minimizes the mean squared error among such
  predictions; `integral_sq_sub_condExp_comap_le`: with `m` generated by a random variable `X`,
  `E[Y | X]` beats every square-integrable `h ∘ X` with `h` measurable (the regression function
  is the Bayes-optimal regressor under squared loss).

Mathlib states the orthogonality at the level of `L²`
(`MeasureTheory.inner_condExpL2_left_eq_right`); this file states it and its consequences for
functions and Bochner integrals.
-/

@[expose] public section

namespace MeasureTheory

variable {Ω : Type*} {m mΩ : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]

variable {Ω : Type*} {m mΩ : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]

/-- Orthogonality of the residual `Y - E[Y | m]` to every square-integrable `m`-measurable
`h`. -/
theorem integral_sub_condExp_mul_eq_zero (hm : m ≤ mΩ) {Y h : Ω → ℝ} (hY : MemLp Y 2 μ)
    (hh : MemLp h 2 μ) (hhm : StronglyMeasurable[m] h) :
    ∫ ω, (Y ω - μ[Y|m] ω) * h ω ∂μ = 0 := by
  have hc : MemLp (μ[Y|m]) 2 μ := hY.condExp one_le_two
  have hhY : Integrable (h * Y) μ := hh.integrable_mul hY
  have hhc : Integrable (h * μ[Y|m]) μ := hh.integrable_mul hc
  have key : ∫ ω, (h * Y) ω ∂μ = ∫ ω, (h * μ[Y|m]) ω ∂μ := by
    rw [← integral_condExp hm (f := h * Y)]
    exact integral_congr_ae (condExp_mul_of_stronglyMeasurable_left hhm hhY
      (hY.integrable one_le_two))
  have hsplit : (fun ω => (Y ω - μ[Y|m] ω) * h ω) = fun ω => (h * Y) ω - (h * μ[Y|m]) ω := by
    funext ω
    simp only [Pi.mul_apply]
    ring
  rw [hsplit, integral_sub hhY hhc, key, sub_self]

/-- **Pythagorean identity for the conditional mean**: for every square-integrable
`m`-measurable prediction `g`,
`E[(Y - g)²] = E[(Y - E[Y | m])²] + E[(E[Y | m] - g)²]`. -/
theorem integral_sq_sub_eq_integral_sq_sub_condExp_add (hm : m ≤ mΩ) {Y g : Ω → ℝ}
    (hY : MemLp Y 2 μ) (hg : MemLp g 2 μ) (hgm : StronglyMeasurable[m] g) :
    ∫ ω, (Y ω - g ω) ^ 2 ∂μ =
      ∫ ω, (Y ω - μ[Y|m] ω) ^ 2 ∂μ + ∫ ω, (μ[Y|m] ω - g ω) ^ 2 ∂μ := by
  have hc : MemLp (μ[Y|m]) 2 μ := hY.condExp one_le_two
  have hr : MemLp (Y - μ[Y|m]) 2 μ := hY.sub hc
  have hd : MemLp (μ[Y|m] - g) 2 μ := hc.sub hg
  have hdm : StronglyMeasurable[m] (μ[Y|m] - g) := stronglyMeasurable_condExp.sub hgm
  have hcross := integral_sub_condExp_mul_eq_zero hm hY hd hdm
  have h1 : Integrable (fun ω => (Y ω - μ[Y|m] ω) ^ 2) μ := hr.integrable_sq
  have h2 : Integrable (fun ω => (μ[Y|m] ω - g ω) ^ 2) μ := hd.integrable_sq
  have h3 : Integrable (fun ω => 2 * ((Y ω - μ[Y|m] ω) * (μ[Y|m] ω - g ω))) μ :=
    (hr.integrable_mul hd).const_mul 2
  have hexp : (fun ω => (Y ω - g ω) ^ 2) = fun ω => ((Y ω - μ[Y|m] ω) ^ 2 +
      (μ[Y|m] ω - g ω) ^ 2) + 2 * ((Y ω - μ[Y|m] ω) * (μ[Y|m] ω - g ω)) := by
    funext ω
    ring
  have h12 : Integrable (fun ω => (Y ω - μ[Y|m] ω) ^ 2 + (μ[Y|m] ω - g ω) ^ 2) μ := h1.add h2
  rw [hexp, integral_add h12 h3, integral_add h1 h2, integral_const_mul]
  simp only [Pi.sub_apply] at hcross
  rw [hcross, mul_zero, add_zero]

/-- **The conditional mean minimizes the expected squared error** among square-integrable
`m`-measurable predictions. -/
theorem integral_sq_sub_condExp_le (hm : m ≤ mΩ) {Y g : Ω → ℝ} (hY : MemLp Y 2 μ)
    (hg : MemLp g 2 μ) (hgm : StronglyMeasurable[m] g) :
    ∫ ω, (Y ω - μ[Y|m] ω) ^ 2 ∂μ ≤ ∫ ω, (Y ω - g ω) ^ 2 ∂μ := by
  rw [integral_sq_sub_eq_integral_sq_sub_condExp_add hm hY hg hgm]
  exact le_add_of_nonneg_right (integral_nonneg fun ω => sq_nonneg _)

/-- **The regression function is the Bayes-optimal regressor**: for features `X` and a
square-integrable response `Y`, the conditional mean `E[Y | X]` (conditional expectation given
the σ-algebra generated by `X`) has expected squared error at most that of every
square-integrable prediction `h ∘ X`. -/
theorem integral_sq_sub_condExp_comap_le {𝓧 : Type*} [m𝓧 : MeasurableSpace 𝓧] {X : Ω → 𝓧}
    (hX : Measurable X) {Y : Ω → ℝ} (hY : MemLp Y 2 μ) {h : 𝓧 → ℝ} (hh : Measurable h)
    (hhX : MemLp (h ∘ X) 2 μ) :
    ∫ ω, (Y ω - μ[Y|m𝓧.comap X] ω) ^ 2 ∂μ ≤ ∫ ω, (Y ω - h (X ω)) ^ 2 ∂μ :=
  integral_sq_sub_condExp_le hX.comap_le hY hhX
    (hh.comp (Measurable.of_comap_le le_rfl)).stronglyMeasurable

end MeasureTheory
