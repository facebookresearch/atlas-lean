module

public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import Mathlib.RingTheory.Grassmannian

import all Mathlib.RingTheory.Grassmannian
import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
import Mathlib.LinearAlgebra.TensorProduct.Pi
import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# The chart algebra of a Grassmannian chart is the whole ring

For `x : Fin k → M`, the Grassmannian chart at `x` over an `R`-algebra `A`
consists of the points `N` of `Module.Grassmannian A (A ⊗[R] M) k` for which
the vectors `N.mkQ (1 ⊗ₜ x i)` form a basis of the quotient, in the sense that
`v ↦ ∑ i, v i • N.mkQ (1 ⊗ₜ x i)` is bijective. Such a point is the kernel of
`ψ.liftBaseChange A : A ⊗[R] M →ₗ[A] (Fin k → A)` for a unique `R`-linear map
`ψ : M →ₗ[R] (Fin k → A)` sending each `x j` to `Pi.single j 1`, and this gives
the chart equivalence used below.

If a scheme `Gr` represents the Grassmannian functor, if the chart at `x`
is the open `V x` of `Gr`, and if `g : ι → M` spans `M`, then a point `N` of
the chart over `S` whose representing map `Spec S ⟶ Gr` is an open immersion
with image `V x` already comes from the subalgebra of `S` generated by the
chart coordinates of the `g a`: that subalgebra is all of `S`.
-/

@[expose] public section

open scoped TensorProduct
open CategoryTheory AlgebraicGeometry

universe u v w w₁

section ChartEquiv

variable (R : Type u) [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
  {k : ℕ} (x : Fin k → M)
variable (A : Type w) [CommRing A] [Algebra R A]

private abbrev Chart :=
  {N : Module.Grassmannian A (A ⊗[R] M) k //
    Function.Bijective fun v : Fin k → A =>
      ∑ i, v i • N.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] x i)}

private abbrev HomX :=
  {ψ : M →ₗ[R] (Fin k → A) // ∀ j, ψ (x j) = Pi.single j 1}

variable {R A}

private def cmap (N : Submodule A (A ⊗[R] M)) :
    (Fin k → A) →ₗ[A] (A ⊗[R] M) ⧸ N :=
  Fintype.linearCombination A (fun i => N.mkQ ((1 : A) ⊗ₜ[R] x i))

private lemma coe_cmap (N : Submodule A (A ⊗[R] M)) :
    ⇑(cmap x N) =
      fun v : Fin k → A => ∑ i, v i • N.mkQ ((1 : A) ⊗ₜ[R] x i) :=
  rfl

private lemma cmap_single (N : Submodule A (A ⊗[R] M)) (j : Fin k) :
    cmap x N (Pi.single j 1) = N.mkQ ((1 : A) ⊗ₜ[R] x j) := by
  classical
  simp [cmap]

private noncomputable def coordEquiv (N : Chart R x A) :
    (Fin k → A) ≃ₗ[A] (A ⊗[R] M) ⧸ N.1.toSubmodule :=
  LinearEquiv.ofBijective (cmap x N.1.toSubmodule) N.2

private lemma coordEquiv_apply (N : Chart R x A) (v : Fin k → A) :
    coordEquiv x N v = cmap x N.1.toSubmodule v :=
  rfl

private lemma coordEquiv_symm_mkQ_x (N : Chart R x A) (j : Fin k) :
    (coordEquiv x N).symm (N.1.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] x j)) =
      Pi.single j 1 := by
  rw [LinearEquiv.symm_apply_eq, coordEquiv_apply, cmap_single]

private noncomputable def toHomX (N : Chart R x A) : HomX R x A :=
  ⟨(((coordEquiv x N).symm.toLinearMap ∘ₗ N.1.toSubmodule.mkQ).restrictScalars R) ∘ₗ
      TensorProduct.mk R A M 1,
    fun j => by
      simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars,
        LinearEquiv.coe_coe, Function.comp_apply, TensorProduct.mk_apply]
      exact coordEquiv_symm_mkQ_x x N j⟩

private lemma toHomX_apply (N : Chart R x A) (m : M) :
    (toHomX x N).1 m =
      (coordEquiv x N).symm (N.1.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] m)) :=
  rfl

private noncomputable abbrev ext' (ψ : M →ₗ[R] (Fin k → A)) :
    A ⊗[R] M →ₗ[A] (Fin k → A) :=
  ψ.liftBaseChange A

private lemma ext'_surjective (ψ : HomX R x A) :
    Function.Surjective (ext' ψ.1) := by
  intro v
  refine ⟨∑ i, v i ⊗ₜ[R] x i, ?_⟩
  simp only [map_sum, LinearMap.liftBaseChange_tmul, ψ.2]
  ext i
  simp [Finset.sum_apply, Pi.single_apply]

private noncomputable def quotEquiv (ψ : HomX R x A) :
    ((A ⊗[R] M) ⧸ LinearMap.ker (ext' ψ.1)) ≃ₗ[A] (Fin k → A) :=
  (ext' ψ.1).quotKerEquivOfSurjective (ext'_surjective x ψ)

private lemma quotEquiv_mkQ (ψ : HomX R x A) (p : A ⊗[R] M) :
    quotEquiv x ψ ((LinearMap.ker (ext' ψ.1)).mkQ p) = ext' ψ.1 p :=
  LinearMap.quotKerEquivOfSurjective_apply_mk _ _ _

private lemma quotEquiv_cmap (ψ : HomX R x A) (v : Fin k → A) :
    quotEquiv x ψ (cmap x (LinearMap.ker (ext' ψ.1)) v) = v := by
  simp only [coe_cmap, map_sum, map_smul, quotEquiv_mkQ,
    LinearMap.liftBaseChange_tmul, one_smul, ψ.2]
  ext i
  simp [Finset.sum_apply, Pi.single_apply]

private lemma cmap_ker_eq (ψ : HomX R x A) :
    ⇑(cmap x (LinearMap.ker (ext' ψ.1))) = (quotEquiv x ψ).symm := by
  funext v
  rw [eq_comm, LinearEquiv.symm_apply_eq, quotEquiv_cmap]

private noncomputable def ofHomX (ψ : HomX R x A) : Chart R x A := by
  refine ⟨{ toSubmodule := LinearMap.ker (ext' ψ.1)
            finite_quotient := Module.Finite.equiv (quotEquiv x ψ).symm
            projective_quotient :=
              Module.Projective.of_equiv (quotEquiv x ψ).symm
            rankAtStalk_eq := fun p => ?_ }, ?_⟩
  · have : Nontrivial A := by
      by_contra h
      have := not_nontrivial_iff_subsingleton.mp h
      exact IsEmpty.false p
    rw [Module.rankAtStalk_eq_of_equiv (quotEquiv x ψ),
      Module.rankAtStalk_eq_finrank_of_free, Module.finrank_fin_fun]
    rfl
  · change Function.Bijective (cmap x (LinearMap.ker (ext' ψ.1)))
    rw [cmap_ker_eq]
    exact (quotEquiv x ψ).symm.bijective

private lemma ofHomX_toSubmodule (ψ : HomX R x A) :
    (ofHomX x ψ).1.toSubmodule = LinearMap.ker (ext' ψ.1) :=
  rfl

private lemma ext'_toHomX (N : Chart R x A) :
    ext' (toHomX x N).1 =
      (coordEquiv x N).symm.toLinearMap ∘ₗ N.1.toSubmodule.mkQ := by
  refine TensorProduct.AlgebraTensorModule.ext fun a m => ?_
  change (toHomX x N).1.liftBaseChange A (a ⊗ₜ[R] m) =
    (coordEquiv x N).symm (N.1.toSubmodule.mkQ (a ⊗ₜ[R] m))
  rw [LinearMap.liftBaseChange_tmul, toHomX_apply, ← map_smul, ← map_smul,
    ← TensorProduct.tmul_eq_smul_one_tmul]

private lemma ofHomX_toHomX (N : Chart R x A) : ofHomX x (toHomX x N) = N := by
  apply Subtype.ext
  apply Module.Grassmannian.ext
  rw [ofHomX_toSubmodule, ext'_toHomX, LinearEquiv.ker_comp,
    Submodule.ker_mkQ]

private lemma coordEquiv_ofHomX_symm (ψ : HomX R x A) (y) :
    (coordEquiv x (ofHomX x ψ)).symm y = quotEquiv x ψ y := by
  have h1 : (coordEquiv x (ofHomX x ψ))
      ((coordEquiv x (ofHomX x ψ)).symm y) = y :=
    LinearEquiv.apply_symm_apply _ _
  rw [coordEquiv_apply] at h1
  have h2 := congrArg (quotEquiv x ψ) h1
  change quotEquiv x ψ (cmap x (LinearMap.ker (ext' ψ.1)) _) = _ at h2
  rwa [quotEquiv_cmap] at h2

private lemma toHomX_ofHomX (ψ : HomX R x A) : toHomX x (ofHomX x ψ) = ψ := by
  apply Subtype.ext
  apply LinearMap.ext
  intro m
  rw [toHomX_apply, coordEquiv_ofHomX_symm]
  change quotEquiv x ψ ((LinearMap.ker (ext' ψ.1)).mkQ ((1 : A) ⊗ₜ[R] m)) = _
  rw [quotEquiv_mkQ, LinearMap.liftBaseChange_tmul, one_smul]

private noncomputable def chartEquiv : Chart R x A ≃ HomX R x A where
  toFun := toHomX x
  invFun := ofHomX x
  left_inv := ofHomX_toHomX x
  right_inv := toHomX_ofHomX x

private lemma sum_chartEquiv_smul (N : Chart R x A) (m : M) :
    ∑ i, (chartEquiv x N).1 m i • N.1.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] x i) =
      N.1.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] m) := by
  change cmap x N.1.toSubmodule
      ((coordEquiv x N).symm (N.1.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] m))) = _
  rw [← coordEquiv_apply, LinearEquiv.apply_symm_apply]

variable {B : Type w} [CommRing B] [Algebra R B] (φ : A →ₐ[R] B)

private def pushHomX (ψ : HomX R x A) : HomX R x B :=
  ⟨(φ.toLinearMap.compLeft (Fin k)) ∘ₗ ψ.1, fun j => by
    ext i
    simp [LinearMap.compLeft, ψ.2, Pi.single_apply, apply_ite φ]⟩

private lemma pushHomX_apply (ψ : HomX R x A) (m : M) (i : Fin k) :
    (pushHomX x φ ψ).1 m i = φ (ψ.1 m i) :=
  rfl

private lemma map_ofHomX_toSubmodule (ψ : HomX R x A) :
    (Module.Grassmannian.map φ (ofHomX x ψ).1).toSubmodule =
      LinearMap.ker (ext' (pushHomX x φ ψ).1) := by
  classical
  let : Algebra A B := φ.toAlgebra
  let : IsScalarTower R A B :=
    IsScalarTower.of_algebraMap_eq' <| IsScalarTower.algebraMap_eq R A B
  have hmap : ((quotEquiv x ψ).baseChange A B _ _ ≪≫ₗ
        TensorProduct.piScalarRight A B B (Fin k)).toLinearMap ∘ₗ
      Module.Grassmannian.baseChangeMkQ B (LinearMap.ker (ext' ψ.1)) =
      ext' (pushHomX x φ ψ).1 := by
    refine TensorProduct.AlgebraTensorModule.ext (A := B) fun b m => ?_
    have hbc : Module.Grassmannian.baseChangeMkQ B
          (LinearMap.ker (ext' ψ.1)) ((1 : B) ⊗ₜ[R] m) =
        (1 : B) ⊗ₜ[A] ((LinearMap.ker (ext' ψ.1)).mkQ
          ((1 : A) ⊗ₜ[R] m)) := by
      simp [Module.Grassmannian.baseChangeMkQ]
    rw [show b ⊗ₜ[R] m = b • ((1 : B) ⊗ₜ[R] m) by
      simp [TensorProduct.smul_tmul'], map_smul, map_smul,
      LinearMap.comp_apply, hbc]
    ext i
    simp only [Submodule.mkQ_apply, LinearEquiv.coe_coe, LinearEquiv.trans_apply,
      LinearEquiv.baseChange_tmul, TensorProduct.piScalarRight_apply,
      TensorProduct.piScalarRightHom_tmul, Pi.smul_apply, smul_eq_mul, Algebra.mul_smul_comm,
      mul_one, LinearMap.liftBaseChange_tmul, one_smul, pushHomX_apply]
    rw [← Submodule.mkQ_apply, quotEquiv_mkQ, LinearMap.liftBaseChange_tmul,
      one_smul, Algebra.smul_def, mul_comm]
    rfl
  rw [Module.Grassmannian.map_toSubmodule, ofHomX_toSubmodule, ← hmap,
    LinearMap.ker_comp, LinearEquiv.ker, Submodule.comap_bot]

private lemma map_ofHomX (ψ : HomX R x A) :
    Module.Grassmannian.map φ (ofHomX x ψ).1 =
      (ofHomX x (pushHomX x φ ψ)).1 :=
  Module.Grassmannian.ext (map_ofHomX_toSubmodule x φ ψ)

private lemma map_mem_chart (N : Chart R x A) :
    Function.Bijective fun v : Fin k → B =>
      ∑ i, v i •
        (Module.Grassmannian.map φ N.1).toSubmodule.mkQ ((1 : B) ⊗ₜ[R] x i) := by
  have hN : N = ofHomX x (toHomX x N) := (ofHomX_toHomX x N).symm
  rw [hN, map_ofHomX]
  exact (ofHomX x (pushHomX x φ (toHomX x N))).2

private lemma chartEquiv_map (N : Chart R x A) :
    chartEquiv x ⟨Module.Grassmannian.map φ N.1, map_mem_chart x φ N⟩ =
      pushHomX x φ (chartEquiv x N) := by
  have hN : N = ofHomX x (toHomX x N) := (ofHomX_toHomX x N).symm
  have hthis : (⟨Module.Grassmannian.map φ N.1, map_mem_chart x φ N⟩ :
      Chart R x B) = ofHomX x (pushHomX x φ (toHomX x N)) := by
    apply Subtype.ext
    change Module.Grassmannian.map φ N.1 = _
    conv_lhs => rw [hN]
    exact map_ofHomX x φ (toHomX x N)
  rw [hthis]
  exact toHomX_ofHomX x _

end ChartEquiv

section Adjoin

private noncomputable def T {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M) :
    Subalgebra R S :=
  Algebra.adjoin R {s : S | ∃ (a : ι) (c : Fin k → S) (i : Fin k),
    ∑ j, c j • N.1.toSubmodule.mkQ ((1 : S) ⊗ₜ[R] x j) =
        N.1.toSubmodule.mkQ ((1 : S) ⊗ₜ[R] g a) ∧
      s = c i}

private theorem chartEquiv_g_mem {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (a : ι) (i : Fin k) :
    (chartEquiv x N).1 (g a) i ∈ T x N g :=
  Algebra.subset_adjoin ⟨a, (chartEquiv x N).1 (g a), i,
    sum_chartEquiv_smul x N (g a), rfl⟩

private theorem chartEquiv_mem {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) (m : M) (i : Fin k) :
    (chartEquiv x N).1 m i ∈ T x N g := by
  have hm : m ∈ Submodule.span R (Set.range g) := by rw [hg]; trivial
  induction hm using Submodule.span_induction with
  | mem m hm =>
    obtain ⟨a, rfl⟩ := hm
    exact chartEquiv_g_mem x N g a i
  | zero => rw [map_zero]; exact zero_mem _
  | add m m' _ _ hm hm' => rw [map_add]; exact add_mem hm hm'
  | smul r m _ hm =>
    rw [map_smul, Pi.smul_apply]
    exact Subalgebra.smul_mem _ hm r

private noncomputable def ψT {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) :
    M →ₗ[R] (Fin k → T x N g) where
  toFun m i := ⟨(chartEquiv x N).1 m i, chartEquiv_mem x N g hg m i⟩
  map_add' m m' := by
    funext i; apply Subtype.ext
    simp only [map_add, Pi.add_apply, Subalgebra.coe_add]
  map_smul' r m := by
    funext i; apply Subtype.ext
    simp only [map_smul, Pi.smul_apply, RingHom.id_apply, Subalgebra.coe_smul]

private theorem ψT_apply_val {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) (m : M) (i : Fin k) :
    ((ψT x N g hg m i : T x N g) : S) = (chartEquiv x N).1 m i :=
  rfl

private theorem ψT_x {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) (j : Fin k) :
    ψT x N g hg (x j) = Pi.single j 1 := by
  funext i
  apply Subtype.ext
  rw [ψT_apply_val, (chartEquiv x N).2 j, Pi.single_apply, Pi.single_apply]
  split_ifs <;> rfl

private noncomputable def NT {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) :
    Chart R x (T x N g) :=
  (chartEquiv x).symm ⟨ψT x N g hg, ψT_x x N g hg⟩

private theorem map_val_NT {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] {k : ℕ} (x : Fin k → M) {S : Type w}
    [CommRing S] [Algebra R S] (N : Chart R x S) {ι : Type w₁} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) :
    Module.Grassmannian.map (T x N g).val (NT x N g hg).1 = N.1 := by
  have key : (⟨Module.Grassmannian.map (T x N g).val (NT x N g hg).1,
      map_mem_chart x (T x N g).val (NT x N g hg)⟩ : Chart R x S) = N := by
    apply (chartEquiv x).injective
    rw [chartEquiv_map]
    apply Subtype.ext
    apply LinearMap.ext
    intro m
    funext i
    rw [pushHomX_apply]
    unfold NT
    rw [Equiv.apply_symm_apply]
    rfl
  exact congrArg Subtype.val key

end Adjoin

namespace Module
namespace Grassmannian

/-- Let `Gr` be a scheme over `Spec R` that represents the Grassmannian functor
`A ↦ Module.Grassmannian A (A ⊗[R] M) k` naturally in `A` (`pt`, `hpt`), and let `V x` be
the open of `Gr` through which exactly the points of the chart at `x` factor (`hVchart`).
If `g : ι → M` spans `M` and `N` is a point over `S` whose representing map
`Spec S ⟶ Gr` is an open immersion with image `V x`, then the chart coordinates of the
`g a`, the coefficients `c i` with `∑ j, c j • N.mkQ (1 ⊗ₜ x j) = N.mkQ (1 ⊗ₜ g a)`,
generate `S` as an `R`-algebra. -/
theorem adjoin_eq_top_of_isOpenImmersion_of_opensRange_eq
    (R : Type u) [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    (k : ℕ) (Gr : Scheme.{u}) (p : Gr ⟶ Spec (CommRingCat.of R))
    (pt : ∀ (A : Type u) [CommRing A] [Algebra R A],
      Module.Grassmannian A (A ⊗[R] M) k ≃
        {g : Spec (CommRingCat.of A) ⟶ Gr //
          g ≫ p = Spec.map (CommRingCat.ofHom (algebraMap R A))})
    (hpt : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra R A]
      [Algebra R B] (φ : A →ₐ[R] B)
      (N : Module.Grassmannian A (A ⊗[R] M) k),
      (pt B (Module.Grassmannian.map φ N)).1 =
        Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (pt A N).1)
    (V : (Fin k → M) → Gr.Opens)
    (hVchart : ∀ (x : Fin k → M) (A : Type u) [CommRing A] [Algebra R A]
      (N : Module.Grassmannian A (A ⊗[R] M) k),
      Set.range (pt A N).1.base ⊆ (V x : Set Gr) ↔
        Function.Bijective fun v : Fin k → A =>
          ∑ i, v i • N.toSubmodule.mkQ ((1 : A) ⊗ₜ[R] x i))
    (ι : Type w) (g : ι → M) (hg : Submodule.span R (Set.range g) = ⊤)
    (x : Fin k → M) (S : Type u) [CommRing S] [Algebra R S]
    (N : Module.Grassmannian S (S ⊗[R] M) k)
    [IsOpenImmersion (pt S N).1] (hN : (pt S N).1.opensRange = V x) :
    Algebra.adjoin R {s : S | ∃ (a : ι) (c : Fin k → S) (i : Fin k),
        ∑ j, c j • N.toSubmodule.mkQ ((1 : S) ⊗ₜ[R] x j) =
            N.toSubmodule.mkQ ((1 : S) ⊗ₜ[R] g a) ∧
          s = c i} = ⊤ := by
  have hrange : Set.range (pt S N).1.base = (V x : Set Gr) := by
    rw [← hN]; rfl
  have hx : Function.Bijective fun v : Fin k → S =>
      ∑ i, v i • N.toSubmodule.mkQ ((1 : S) ⊗ₜ[R] x i) :=
    (hVchart x S N).mp hrange.le
  let Nc : Chart R x S := ⟨N, hx⟩
  change T (R := R) x Nc g = ⊤
  set T' : Subalgebra R S := T (R := R) x Nc g with hT'
  let NT' : Chart R x T' := NT x Nc g hg
  let t : Spec (CommRingCat.of T') ⟶ Gr := (pt T' NT'.1).1
  have ht : Set.range t.base ⊆ Set.range (pt S N).1.base := by
    rw [hrange]
    exact (hVchart x T' NT'.1).mpr NT'.2
  let l : Spec (CommRingCat.of T') ⟶ Spec (CommRingCat.of S) :=
    IsOpenImmersion.lift (pt S N).1 t ht
  have hl : l ≫ (pt S N).1 = t := IsOpenImmersion.lift_fac _ _ _
  let σ : CommRingCat.of S ⟶ CommRingCat.of T' := Spec.preimage l
  have hσ : Spec.map σ = l := Spec.map_preimage l
  have hmap : Module.Grassmannian.map T'.val NT'.1 = N :=
    map_val_NT x Nc g hg
  have hnat := hpt T' S T'.val NT'.1
  rw [hmap] at hnat
  have hcomp : Spec.map (σ ≫ CommRingCat.ofHom T'.val.toRingHom) ≫
      (pt S N).1 = 𝟙 _ ≫ (pt S N).1 := by
    rw [Spec.map_comp, Category.assoc, hσ, hl, Category.id_comp]
    exact hnat.symm
  rw [cancel_mono] at hcomp
  rw [Spec.map_eq_id] at hcomp
  rw [eq_top_iff]
  intro s _
  have hs : (T'.val) (σ.hom s) = s := by
    have hcongr := congrArg
      (fun f : CommRingCat.of S ⟶ CommRingCat.of S => f.hom s) hcomp
    simpa using hcongr
  rw [← hs]
  exact (σ.hom s).2

end Grassmannian
end Module
