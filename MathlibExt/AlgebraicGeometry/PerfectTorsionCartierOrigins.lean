module

public import MathlibExt.AlgebraicGeometry.HurwitzBranchComplexes
public import Mathlib.AlgebraicGeometry.Morphisms.Finite

/-!
# Actual Cartier-divisor origin of a perfect torsion complex

The divisor is an actual closed subscheme with finite flat projection.
Its ideal is the kernel of the native structure unit. On a covering
collection of affine opens it is generated by a genuine nonzero divisor.
The generator is fixed, up to a base unit, by the concrete odd-to-even
determinant of d+h on an actual finite-free representative of the given
derived complex. Total quotients and affine rings retain nilpotents.

Reference: Fantechi–Pandharipande math/9905104v1, §1.2, Proposition 1,
and §§2.3–3.2. No function assigning a branch divisor is assumed.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.PerfectTorsionCartierOrigins

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
open MathlibExt.AlgebraicGeometry.FourierMukai
open MathlibExt.AlgebraicGeometry.CoherentCurveLinearSeries
open MathlibExt.AlgebraicGeometry.RationalResolution
open MathlibExt.AlgebraicGeometry.GlobalPerfectObstructionTheory
open MathlibExt.Algebra.Homology.PerfectTorsionDeterminants
attribute [local instance] HasDerivedCategory.standard

/-- An actual finite flat relative effective Cartier divisor of the given degree. -/
structure EffectiveCartierFamily {Y S : Scheme.{0}} (q : Y ⟶ S) (r : ℕ) where
  Z : Scheme.{0}
  inclusion : Z ⟶ Y
  [closed : IsClosedImmersion inclusion]
  [finite : IsFinite (inclusion ≫ q)]
  [flat : Flat (inclusion ≫ q)]
  [finitePresentation : LocallyOfFinitePresentation (inclusion ≫ q)]
  cartier : ∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ IsAffineOpen U ∧
    ∃ a : Γ(Y,U), a ∈ nonZeroDivisors Γ(Y,U) ∧
      Set.range ((kernel.ι (structureUnit inclusion)).app U) =
        Set.range (fun b : Γ(Y,U) => b * a)
  degree : ∀ (Ω : Type) [Field Ω] [IsAlgClosed Ω] (p : Spec (.of Ω) ⟶ S),
    Module.finrank Ω (cohomology (pullback.snd (inclusion ≫ q) p)
      (structureModule (pullback (inclusion ≫ q) p)) 0) = r

attribute [instance] EffectiveCartierFamily.closed EffectiveCartierFamily.finite
  EffectiveCartierFamily.flat EffectiveCartierFamily.finitePresentation

/-- The actual Cartier ideal, including its nonreduced scheme structure. -/
def EffectiveCartierFamily.ideal {Y S : Scheme.{0}} {q : Y ⟶ S} {r : ℕ}
    (D : EffectiveCartierFamily q r) : Y.Modules := kernel (structureUnit D.inclusion)

/-- The ideal as the actual subobject of the fixed structure module. -/
def EffectiveCartierFamily.idealSubobject {Y S : Scheme.{0}} {q : Y ⟶ S} {r : ℕ}
    (D : EffectiveCartierFamily q r) : Subobject (structureModule Y) :=
  Subobject.mk (kernel.ι (structureUnit D.inclusion))

/-- Cartier classes identify exactly the same embedded scheme ideal. -/
def cartierSetoid {Y S : Scheme.{0}} (q : Y ⟶ S) (r : ℕ) :
    Setoid (EffectiveCartierFamily q r) where
  r D E := D.idealSubobject = E.idealSubobject
  iseqv := ⟨fun _ => rfl, fun h => h.symm, fun h k => h.trans k⟩

abbrev CartierClasses {Y S : Scheme.{0}} (q : Y ⟶ S) (r : ℕ) := Quotient (cartierSetoid q r)

def cartierClass {Y S : Scheme.{0}} {q : Y ⟶ S} {r : ℕ} (D : EffectiveCartierFamily q r) :
    CartierClasses q r := Quotient.mk (cartierSetoid q r) D

/-- A local finite-free determinant presentation tied to this same actual ideal. -/
structure LocalOrigin {Y S : Scheme.{0}} {q : Y ⟶ S} {r : ℕ}
    (D : EffectiveCartierFamily q r) (C : CochainComplex Y.Modules ℤ) (y : Y) where
  U : Y.Opens
  affine : IsAffineOpen U
  contains : y ∈ U
  complex : CochainComplex (ModuleCat Γ(Y,U)) ℤ
  comparison : complex ⟶ sectionsComplex C U
  weak : QuasiIso comparison
  torsion : TorsionPresentation complex
  parity : OddIndex torsion ≃ EvenIndex torsion
  equation : Γ(Y,U)
  regular : equation ∈ nonZeroDivisors Γ(Y,U)
  ideal : Set.range ((kernel.ι (structureUnit D.inclusion)).app U) =
    Set.range (fun b : Γ(Y,U) => b * equation)
  unit : Γ(Y,U)ˣ
  normalized : algebraMap Γ(Y,U) (TotalQuotient Γ(Y,U)) equation =
    algebraMap Γ(Y,U) (TotalQuotient Γ(Y,U)) (unit : Γ(Y,U)) *
      torsionDeterminant torsion parity

/-- The Cartier ideal is source-fixed by the actual given derived complex. -/
structure CartierOrigin {Y S : Scheme.{0}} {q : Y ⟶ S} {r : ℕ}
    (D : EffectiveCartierFamily q r) (E : FourierMukai.D Y) where
  quasicoherent : FourierMukai.quasicoherent Y E
  complex : CochainComplex Y.Modules ℤ
  comparison : DerivedCategory.Q.obj complex ≅ E
  injective : ∀ (A B : CochainComplex Y.Modules ℤ) (i : A ⟶ B), Mono i → QuasiIso i →
    ∀ f : A ⟶ complex, ∃ g : B ⟶ complex, i ≫ g = f
  chart : ∀ y : Y, LocalOrigin D complex y

/-- Actual divisor isomorphisms commute with their closed-subscheme embeddings. -/
structure Hom {Y S : Scheme.{0}} {q : Y ⟶ S} {r : ℕ}
    (D E : EffectiveCartierFamily q r) where
  iso : D.Z ≅ E.Z
  inclusion : iso.hom ≫ E.inclusion = D.inclusion

/-- The actual base-change normalization retains the whole Cartier subscheme. -/
structure BaseChange {Y S S' : Scheme.{0}} {q : Y ⟶ S} {r : ℕ}
    (D : EffectiveCartierFamily q r) (b : S' ⟶ S)
    (E : EffectiveCartierFamily (pullback.snd q b) r) where
  map : E.Z ⟶ D.Z
  divisorSquare : IsPullback map E.inclusion D.inclusion (pullback.fst q b)
  normalized : IsPullback map (E.inclusion ≫ pullback.snd q b) (D.inclusion ≫ q) b

end MathlibExt.AlgebraicGeometry.PerfectTorsionCartierOrigins
