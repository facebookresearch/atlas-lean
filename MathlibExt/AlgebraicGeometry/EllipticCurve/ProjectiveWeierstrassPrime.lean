namespace WeierstrassCurve.Projective

/-- The monic cubic in one variable `T` over `MvPolynomial (Fin 2) F` whose polynomial `toPoly`
is the negative of the image of the projective Weierstrass polynomial under `finSuccEquiv F 2`
(`finSuccEquiv_polynomial`). That equivalence sends `X 0` to `T` and `X 1`, `X 2` to the
coefficient variables `X 0`, `X 1`; writing `Y`, `Z` for these, the polynomial is
$T^3 + a_2 Z T^2 + (a_4 Z^2 - a_1 Y Z) T + (a_6 Z^3 - Y^2 Z - a_3 Y Z^2)$.
No coordinate is set to `1`, so this is not a dehomogenization: it rewrites the same
homogeneous cubic with `X 0` separated. -/
noncomputable def weierstrassCubic {F : Type*} [CommRing F]
    (V : Projective F) : Cubic (MvPolynomial (Fin 2) F) :=
  ⟨1, C V.a₂ * X 1, C V.a₄ * X 1 ^ 2 - C V.a₁ * X 0 * X 1,
    C V.a₆ * X 1 ^ 3 - X 0 ^ 2 * X 1 - C V.a₃ * X 0 * X 1 ^ 2⟩

/-- The constant coefficient of the associated cubic polynomial. -/
public theorem weierstrassCubic_toPoly_coeff_zero {F : Type*} [CommRing F]
    (V : Projective F) :
    (weierstrassCubic V).toPoly.coeff 0
      = C V.a₆ * X 1 ^ 3 - X 0 ^ 2 * X 1 - C V.a₃ * X 0 * X 1 ^ 2 := by
  rw [Cubic.coeff_eq_d]
  rfl

/-- The linear coefficient of the associated cubic polynomial. -/
public theorem weierstrassCubic_toPoly_coeff_one {F : Type*} [CommRing F]
    (V : Projective F) :
    (weierstrassCubic V).toPoly.coeff 1
      = C V.a₄ * X 1 ^ 2 - C V.a₁ * X 0 * X 1 := by
  rw [Cubic.coeff_eq_c]
  rfl

/-- The quadratic coefficient of the associated cubic polynomial. -/
public theorem weierstrassCubic_toPoly_coeff_two {F : Type*} [CommRing F]
    (V : Projective F) :
    (weierstrassCubic V).toPoly.coeff 2 = C V.a₂ * X 1 := by
  rw [Cubic.coeff_eq_b]
  rfl

/-- Separating the first variable identifies the projective Weierstrass
polynomial with the negative of the associated cubic polynomial. -/
public theorem finSuccEquiv_polynomial {F : Type*} [CommRing F]
    (V : Projective F) :
    finSuccEquiv F 2 V.polynomial = -(weierstrassCubic V).toPoly := by
  have h1 : (1 : Fin 3) = (0 : Fin 2).succ := rfl
  have h2 : (2 : Fin 3) = (1 : Fin 2).succ := rfl
  have hC : ∀ a : F, finSuccEquiv F 2 (C a) = Polynomial.C (C a) := fun a => by
    simp [finSuccEquiv_apply]
  rw [WeierstrassCurve.Projective.polynomial, weierstrassCubic, Cubic.toPoly]
  simp only [map_add, map_sub, map_mul, map_pow, map_one, finSuccEquiv_X_zero, h1, h2,
    finSuccEquiv_X_succ, hC]
  ring

/-- The associated cubic polynomial is monic. -/
public theorem weierstrassCubic_toPoly_monic {F : Type*} [CommRing F]
    (V : Projective F) : (weierstrassCubic V).toPoly.Monic :=
  Cubic.monic_of_a_eq_one rfl

/-- Over a domain, the associated cubic polynomial has degree `3`. -/
public theorem weierstrassCubic_toPoly_natDegree {F : Type*} [CommRing F]
    [IsDomain F] (V : Projective F) :
    (weierstrassCubic V).toPoly.natDegree = 3 :=
  Cubic.natDegree_of_a_ne_zero one_ne_zero

/-- Over a domain, the associated cubic polynomial is Eisenstein at the
prime ideal generated by `X 1`. -/
public theorem weierstrassCubic_isEisensteinAt {F : Type*} [CommRing F]
    [IsDomain F] (V : Projective F) :
    (weierstrassCubic V).toPoly.IsEisensteinAt
      (Ideal.span {(X 1 : MvPolynomial (Fin 2) F)}) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [(weierstrassCubic_toPoly_monic V).leadingCoeff]
    intro h
    rw [Ideal.mem_span_singleton] at h
    exact MvPolynomial.prime_X.not_isUnit (isUnit_of_dvd_one h)
  · intro n hn
    rw [weierstrassCubic_toPoly_natDegree V] at hn
    interval_cases n
    · rw [weierstrassCubic_toPoly_coeff_zero, Ideal.mem_span_singleton]
      exact ⟨C V.a₆ * X 1 ^ 2 - X 0 ^ 2 - C V.a₃ * X 0 * X 1, by ring⟩
    · rw [weierstrassCubic_toPoly_coeff_one, Ideal.mem_span_singleton]
      exact ⟨C V.a₄ * X 1 - C V.a₁ * X 0, by ring⟩
    · rw [weierstrassCubic_toPoly_coeff_two, Ideal.mem_span_singleton]
      exact ⟨C V.a₂, by ring⟩
  · rw [weierstrassCubic_toPoly_coeff_zero, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton]
    intro hdvd
    have he : (X 1 : MvPolynomial (Fin 2) F)
        * (C V.a₆ * X 1 ^ 2 - X 0 ^ 2 - C V.a₃ * X 0 * X 1)
        = C V.a₆ * X 1 ^ 3 - X 0 ^ 2 * X 1 - C V.a₃ * X 0 * X 1 ^ 2 := by ring
    have h2 : (X 1 : MvPolynomial (Fin 2) F)
        ∣ C V.a₆ * X 1 ^ 2 - X 0 ^ 2 - C V.a₃ * X 0 * X 1 := by
      refine (mul_dvd_mul_iff_left (MvPolynomial.X_ne_zero (1 : Fin 2))).mp ?_
      rw [show (X 1 : MvPolynomial (Fin 2) F) * X 1 = X 1 ^ 2 from (pow_two _).symm, he]
      exact hdvd
    have h3 : (X 1 : MvPolynomial (Fin 2) F) ∣ X 0 ^ 2 := by
      have h4 := dvd_sub (dvd_sub
        (dvd_mul_right (X 1 : MvPolynomial (Fin 2) F) (C V.a₆ * X 1))
        (dvd_mul_right (X 1 : MvPolynomial (Fin 2) F) (C V.a₃ * X 0))) h2
      have h5 : X 1 * (C V.a₆ * X 1) - X 1 * (C V.a₃ * X 0)
          - (C V.a₆ * X 1 ^ 2 - X 0 ^ 2 - C V.a₃ * X 0 * X 1)
          = (X 0 ^ 2 : MvPolynomial (Fin 2) F) := by ring
      rwa [h5] at h4
    have h6 : (X 1 : MvPolynomial (Fin 2) F) ∣ X 0 :=
      MvPolynomial.prime_X.dvd_of_dvd_pow h3
    rw [MvPolynomial.X_dvd_X] at h6
    exact absurd h6 (by decide)

/-- Over a domain, the associated cubic polynomial is irreducible. -/
public theorem irreducible_weierstrassCubic_toPoly {F : Type*} [CommRing F]
    [IsDomain F] (V : Projective F) :
    Irreducible (weierstrassCubic V).toPoly :=
  (weierstrassCubic_isEisensteinAt V).irreducible
    ((Ideal.span_singleton_prime (MvPolynomial.X_ne_zero _)).mpr
      MvPolynomial.prime_X)
    (weierstrassCubic_toPoly_monic V).isPrimitive
    (by rw [weierstrassCubic_toPoly_natDegree V]; norm_num)

/-- Over a domain, the projective Weierstrass polynomial is irreducible. -/
public theorem irreducible_polynomial {F : Type*} [CommRing F] [IsDomain F]
    (V : Projective F) : Irreducible V.polynomial := by
  have hneg : Irreducible (-(weierstrassCubic V).toPoly) :=
    (Associated.irreducible ⟨-1, by simp⟩ (irreducible_weierstrassCubic_toPoly V))
  have himg : Irreducible (finSuccEquiv F 2 V.polynomial) := by
    rw [finSuccEquiv_polynomial V]
    exact hneg
  exact (MulEquiv.irreducible_iff (finSuccEquiv F 2)).mp himg

/-- Over a domain, the projective Weierstrass polynomial is nonzero. -/
public theorem polynomial_ne_zero {F : Type*} [CommRing F] [IsDomain F]
    (V : Projective F) : V.polynomial ≠ 0 :=
  (irreducible_polynomial V).ne_zero

/-- Over a domain, the projective Weierstrass polynomial is not a unit. -/
public theorem not_isUnit_polynomial {F : Type*} [CommRing F] [IsDomain F]
    (V : Projective F) : ¬IsUnit V.polynomial :=
  (irreducible_polynomial V).not_isUnit

/-- Over a unique factorization domain, the projective Weierstrass
polynomial is prime. -/
public theorem prime_polynomial {F : Type*} [CommRing F] [IsDomain F]
    [UniqueFactorizationMonoid F] (V : Projective F) :
    Prime V.polynomial :=
  UniqueFactorizationMonoid.irreducible_iff_prime.mp (irreducible_polynomial V)

/-- Over a unique factorization domain, the ideal generated by the projective
Weierstrass polynomial is prime. -/
public theorem span_polynomial_isPrime {F : Type*} [CommRing F] [IsDomain F]
    [UniqueFactorizationMonoid F] (V : Projective F) :
    (Ideal.span {V.polynomial}).IsPrime :=
  (Ideal.span_singleton_prime (polynomial_ne_zero V)).mpr (prime_polynomial V)

/-- Over a unique factorization domain, the quotient by the projective Weierstrass
polynomial is a domain. -/
public theorem isDomain_quotient_span_polynomial {F : Type*} [CommRing F]
    [IsDomain F] [UniqueFactorizationMonoid F] (V : Projective F) :
    IsDomain (MvPolynomial (Fin 3) F ⧸ Ideal.span {V.polynomial}) := by
  have h : (Ideal.span {V.polynomial}).IsPrime := span_polynomial_isPrime V
  exact Ideal.Quotient.isDomain _

/-- The projective Weierstrass polynomial is homogeneous of degree `3`. -/
public theorem isHomogeneous_polynomial {F : Type*} [CommRing F]
    (V : Projective F) : V.polynomial.IsHomogeneous 3 := by
  have hA : (X 1 ^ 2 * X 2 : MvPolynomial (Fin 3) F).IsHomogeneous 3 := by
    have h := (isHomogeneous_X_pow (1 : Fin 3) 2).mul (isHomogeneous_X F (2 : Fin 3))
    norm_num at h
    exact h
  have hB : (C V.a₁ * X 0 * X 1 * X 2 : MvPolynomial (Fin 3) F).IsHomogeneous 3 := by
    have h := ((isHomogeneous_C_mul_X V.a₁ (0 : Fin 3)).mul
      (isHomogeneous_X F (1 : Fin 3))).mul (isHomogeneous_X F (2 : Fin 3))
    norm_num at h
    exact h
  have hC : (C V.a₃ * X 1 * X 2 ^ 2 : MvPolynomial (Fin 3) F).IsHomogeneous 3 := by
    have h := (isHomogeneous_C_mul_X V.a₃ (1 : Fin 3)).mul
      (isHomogeneous_X_pow (2 : Fin 3) 2)
    norm_num at h
    exact h
  have hD : (X 0 ^ 3 : MvPolynomial (Fin 3) F).IsHomogeneous 3 :=
    isHomogeneous_X_pow (0 : Fin 3) 3
  have hE : (C V.a₂ * X 0 ^ 2 * X 2 : MvPolynomial (Fin 3) F).IsHomogeneous 3 := by
    have h := (isHomogeneous_C_mul_X_pow V.a₂ (0 : Fin 3) 2).mul
      (isHomogeneous_X F (2 : Fin 3))
    norm_num at h
    exact h
  have hF : (C V.a₄ * X 0 * X 2 ^ 2 : MvPolynomial (Fin 3) F).IsHomogeneous 3 := by
    have h := (isHomogeneous_C_mul_X V.a₄ (0 : Fin 3)).mul
      (isHomogeneous_X_pow (2 : Fin 3) 2)
    norm_num at h
    exact h
  have hG : (C V.a₆ * X 2 ^ 3 : MvPolynomial (Fin 3) F).IsHomogeneous 3 :=
    isHomogeneous_C_mul_X_pow V.a₆ (2 : Fin 3) 3
  rw [WeierstrassCurve.Projective.polynomial]
  exact ((hA.add hB).add hC).sub (((hD.add hE).add hF).add hG)

/-- Over a domain, the projective Weierstrass polynomial has total degree `3`. -/
public theorem totalDegree_polynomial {F : Type*} [CommRing F] [IsDomain F]
    (V : Projective F) : V.polynomial.totalDegree = 3 :=
  (isHomogeneous_polynomial V).totalDegree (polynomial_ne_zero V)

end WeierstrassCurve.Projective
