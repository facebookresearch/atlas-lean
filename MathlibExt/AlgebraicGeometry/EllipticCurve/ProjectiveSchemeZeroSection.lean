module

public import MathlibExt.AlgebraicGeometry.EllipticCurve.ProjectiveSchemeChartAtInfinity
public import MathlibExt.AlgebraicGeometry.EllipticCurve.ProjectiveSchemeAffineChart
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The point at infinity of the projective Weierstrass curve

Let `W` be a Weierstrass curve over a commutative ring `R`, with projective curve
`E = Proj S_W` (`WeierstrassCurve.ProjectiveScheme`). The basic opens `D₊(X), D₊(Y), D₊(Z)` cover
`E`, and a point outside `D₊(Z)` lies in `D₊(Y)`, since `Z = 0` forces `X³ = 0`. Over a field, the
complement of the affine chart `D₊(Z) = Spec A_W` is exactly the image of the zero section
`O = [0 : 1 : 0]` (`WeierstrassCurve.range_zeroSection_eq_compl_basicOpen`).

## Main results

* `WeierstrassCurve.iSup_basicOpen_projectiveCoordinate`: `D₊(X), D₊(Y), D₊(Z)` cover `E`.
* `WeierstrassCurve.mem_basicOpen_one_of_notMem_basicOpen_two`: `E ∖ D₊(Z) ⊆ D₊(Y)`.
* `WeierstrassCurve.range_zeroSection_eq_compl_basicOpen`: over a field, `O` is `E ∖ D₊(Z)`.

## References

* J. S. Milne, *Elliptic Curves*, second edition, World Scientific, 2021, author's version
  <https://jmilne.org/math/Books/EC2.pdf>, Chapter I, §4, p. 34, and Example 4.20, p. 38.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization

universe u

namespace WeierstrassCurve

variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The irrelevant ideal of `S_W` is generated by the coordinates `X, Y, Z`. -/
theorem irrelevant_le_span_coordinates :
    (HomogeneousIdeal.irrelevant W.projectiveGrading).toIdeal ≤
      Ideal.span (Set.range W.projectiveCoordinate) := by
  intro a ha
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  have h0 : GradedRing.proj W.projectiveGrading 0 (Ideal.Quotient.mk _ p) = 0 :=
    (HomogeneousIdeal.mem_irrelevant_iff _ _).mp ha
  have hdec := W.isHomogeneous_span_polynomial.decompose_mk p 0
  have hc : Ideal.Quotient.mk (Ideal.span {W.toProjective.polynomial}) (C (p.coeff 0)) = 0 := by
    rw [← h0, GradedRing.proj_apply, hdec]
    congr 1
    exact ((MvPolynomial.decomposition.decompose'_apply p 0).trans
      (homogeneousComponent_zero p)).symm
  have hsub : p - C (p.coeff 0) ∈ Ideal.span (Set.range (X : Fin 3 → MvPolynomial (Fin 3) R)) := by
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    by_contra! h
    have hm0 : m = 0 := Finsupp.ext fun i => h i (Set.mem_univ i)
    subst hm0
    simp [MvPolynomial.mem_support_iff] at hm
  have := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {W.toProjective.polynomial})) hsub
  rw [Ideal.map_span, ← Set.range_comp] at this
  rw [show p = (p - C (p.coeff 0)) + C (p.coeff 0) by ring, map_add, hc, add_zero]
  exact this
/-- The basic opens `D₊(X), D₊(Y), D₊(Z)` cover `Proj S_W`. -/
theorem iSup_basicOpen_projectiveCoordinate :
    ⨆ i, Proj.basicOpen W.projectiveGrading (W.projectiveCoordinate i) = ⊤ :=
  Proj.iSup_basicOpen_eq_top _ _ W.irrelevant_le_span_coordinates

/-- In `S_W`, `X³` is a multiple of `Z`. -/
theorem coordinate_zero_pow_three_mem_span :
    W.projectiveCoordinate 0 ^ 3 ∈ Ideal.span {W.projectiveCoordinate 2} := by
  rw [Ideal.mem_span_singleton']
  refine ⟨W.projectiveCoordinate 1 ^ 2 +
      algebraMap R _ W.a₁ * W.projectiveCoordinate 0 * W.projectiveCoordinate 1 +
      algebraMap R _ W.a₃ * W.projectiveCoordinate 1 * W.projectiveCoordinate 2 -
      algebraMap R _ W.a₂ * W.projectiveCoordinate 0 ^ 2 -
      algebraMap R _ W.a₄ * W.projectiveCoordinate 0 * W.projectiveCoordinate 2 -
      algebraMap R _ W.a₆ * W.projectiveCoordinate 2 ^ 2, ?_⟩
  linear_combination W.coordinate_relation

/-- **The points with `Z = 0` lie in the chart at infinity.** A point of `Proj S_W` outside
`D₊(Z)` lies in `D₊(Y)`: its homogeneous prime contains `Z`, hence `X³` and `X`, and it does not
contain the irrelevant ideal. -/
theorem mem_basicOpen_one_of_notMem_basicOpen_two (x : W.ProjectiveScheme)
    (hx : x ∉ Proj.basicOpen W.projectiveGrading (W.projectiveCoordinate 2)) :
    x ∈ Proj.basicOpen W.projectiveGrading (W.projectiveCoordinate 1) := by
  rw [Proj.mem_basicOpen, not_not] at hx
  have hX : W.projectiveCoordinate 0 ∈ x.asHomogeneousIdeal :=
    x.isPrime.mem_of_pow_mem 3 ((Ideal.span_singleton_le_iff_mem _).mpr hx
      W.coordinate_zero_pow_three_mem_span)
  have hcov : x ∈ (⊤ : (W.ProjectiveScheme).Opens) := trivial
  rw [← W.iSup_basicOpen_projectiveCoordinate, TopologicalSpace.Opens.mem_iSup] at hcov
  obtain ⟨i, hi⟩ := hcov
  rw [Proj.mem_basicOpen] at hi
  fin_cases i
  · exact absurd hX hi
  · exact (Proj.mem_basicOpen _ _ _).mpr hi
  · exact absurd hx hi

/-- In the chart at infinity, `D₊(Z)` is the locus `w ≠ 0`. -/
theorem chartAtInfinity_base_mem_basicOpen_two_iff
    (q : Spec (CommRingCat.of W.CoordinateRingAtInfinity)) :
    W.chartAtInfinity.base q ∈ Proj.basicOpen W.projectiveGrading (W.projectiveCoordinate 2) ↔
      W.wAtInfinity ∉ q.asIdeal := by
  have h := Proj.awayι_preimage_basicOpen W.projectiveGrading (W.projectiveCoordinate_mem 1)
    Nat.one_pos (W.projectiveCoordinate_mem 2) Nat.one_pos
  have hq := congrArg (fun U : TopologicalSpace.Opens _ =>
    (Spec.map W.awayYRingEquiv.toCommRingCatIso.hom).base q ∈ U) h
  simp only [eq_iff_iff] at hq
  rw [chartAtInfinity, Scheme.Hom.comp_base, TopCat.comp_app]
  refine (TopologicalSpace.Opens.mem_mk.symm.trans hq).trans ?_
  have he : Away.isLocalizationElem (W.projectiveCoordinate_mem 1) (W.projectiveCoordinate_mem 2) =
      W.zOverY := by
    simp only [Away.isLocalizationElem, zOverY, pow_one]
  refine (PrimeSpectrum.mem_basicOpen _ _).trans ?_
  rw [he]
  change W.awayYRingEquiv W.zOverY ∉ q.asIdeal ↔ _
  rw [awayYRingEquiv_zOverY]

/-- The kernel of evaluation at the point at infinity is contained in every ideal containing
`z` and `w`. -/
theorem ker_evalAtInfinity_le {q : Ideal W.CoordinateRingAtInfinity} (hz : W.zAtInfinity ∈ q)
    (hw : W.wAtInfinity ∈ q) : RingHom.ker W.evalAtInfinity ≤ q := by
  intro b hb
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [RingHom.mem_ker, evalAtInfinity_mk] at hb
  have hsub : p ∈ Ideal.span (Set.range (X : Fin 2 → MvPolynomial (Fin 2) R)) := by
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    by_contra! h
    have hm0 : m = 0 := Finsupp.ext fun i => h i (Set.mem_univ i)
    subst hm0
    rw [MvPolynomial.mem_support_iff, ← constantCoeff_eq] at hm
    exact hm hb
  have := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {W.polynomialAtInfinity})) hsub
  rw [Ideal.map_span, ← Set.range_comp] at this
  refine (Ideal.span_le.mpr ?_) this
  rintro _ ⟨i, rfl⟩
  fin_cases i
  · exact hz
  · exact hw

/-- In `B_W`, `z³` is a multiple of `w`. -/
theorem zAtInfinity_pow_three_mem_span :
    W.zAtInfinity ^ 3 ∈ Ideal.span {W.wAtInfinity} := by
  rw [Ideal.mem_span_singleton']
  refine ⟨1 + algebraMap R _ W.a₁ * W.zAtInfinity + algebraMap R _ W.a₃ * W.wAtInfinity -
      algebraMap R _ W.a₂ * W.zAtInfinity ^ 2 -
      algebraMap R _ W.a₄ * W.zAtInfinity * W.wAtInfinity -
      algebraMap R _ W.a₆ * W.wAtInfinity ^ 2, ?_⟩
  linear_combination W.relation_atInfinity

/-- Over a field, the only prime of `B_W` containing `w` is the kernel of evaluation at the
point at infinity `z = w = 0`. -/
theorem eq_ker_evalAtInfinity {F : Type u} [Field F] (W : WeierstrassCurve F)
    {q : Ideal W.CoordinateRingAtInfinity} [q.IsPrime] (hw : W.wAtInfinity ∈ q) :
    q = RingHom.ker W.evalAtInfinity := by
  have hz : W.zAtInfinity ∈ q := Ideal.IsPrime.mem_of_pow_mem ‹_› 3
    ((Ideal.span_singleton_le_iff_mem _).mpr hw W.zAtInfinity_pow_three_mem_span)
  have hmax : (RingHom.ker W.evalAtInfinity).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective W.evalAtInfinity fun r =>
      ⟨algebraMap F _ r, W.evalAtInfinity.commutes r⟩
  exact (hmax.eq_of_le (Ideal.IsPrime.ne_top ‹_›) (W.ker_evalAtInfinity_le hz hw)).symm

/-- The point of `Spec B_W` underlying the zero section: the prime `ker (evalAtInfinity)`. -/
theorem specMap_evalAtInfinity_base_asIdeal {F : Type u} [Field F] (W : WeierstrassCurve F)
    (pt : Spec (CommRingCat.of F)) :
    ((Spec.map (CommRingCat.ofHom W.evalAtInfinity.toRingHom)).base pt).asIdeal =
      RingHom.ker W.evalAtInfinity := by
  change Ideal.comap _ pt.asIdeal = _
  have := pt.isPrime
  rw [Ideal.eq_bot_of_prime pt.asIdeal]
  rfl

/-- **Over a field, the affine chart is the complement of the point at infinity.** Let `W` be a
Weierstrass curve over a field `F`, with projective curve `E = Proj S_W` and zero section
`O = [0 : 1 : 0]`. Then the image of `O` is exactly the complement of the basic open
`D₊(Z) = E ∩ {Z ≠ 0}`, the image of the affine chart `Spec A_W`.

Source: J. S. Milne, *Elliptic Curves*, 2nd ed., author's version
<https://jmilne.org/math/Books/EC2.pdf>, Example 4.20, p. 38: the curve "has exactly one point at
infinity, namely, `(0 : 1 : 0)`" (stated there for `Y² Z = X³ + a X Z² + b Z³`; the general
Weierstrass cubic is the same: `Z = 0` forces `X³ = 0`). The discriminant is not used. -/
theorem range_zeroSection_eq_compl_basicOpen {F : Type u} [Field F] (W : WeierstrassCurve F) :
    Set.range W.zeroSection.base =
      ((Proj.basicOpen W.projectiveGrading (W.projectiveCoordinate 2) :
        Set W.ProjectiveScheme))ᶜ := by
  ext x
  constructor
  · rintro ⟨pt, rfl⟩
    rw [Set.mem_compl_iff, SetLike.mem_coe, zeroSection, Scheme.Hom.comp_base, TopCat.comp_app,
      chartAtInfinity_base_mem_basicOpen_two_iff, not_not, specMap_evalAtInfinity_base_asIdeal,
      RingHom.mem_ker, evalAtInfinity_wAtInfinity]
  · intro hx
    have hY := W.mem_basicOpen_one_of_notMem_basicOpen_two x hx
    rw [← opensRange_chartAtInfinity] at hY
    obtain ⟨q, rfl⟩ := hY
    have hw : W.wAtInfinity ∈ q.asIdeal := by
      by_contra h
      exact hx ((W.chartAtInfinity_base_mem_basicOpen_two_iff q).mpr h)
    have := q.isPrime
    have hq := W.eq_ker_evalAtInfinity (q := q.asIdeal) hw
    refine ⟨IsLocalRing.closedPoint F, ?_⟩
    change W.chartAtInfinity.base ((Spec.map (CommRingCat.ofHom W.evalAtInfinity.toRingHom)).base
      (IsLocalRing.closedPoint F)) = W.chartAtInfinity.base q
    congr 1
    exact PrimeSpectrum.ext ((W.specMap_evalAtInfinity_base_asIdeal _).trans hq.symm)

end WeierstrassCurve
