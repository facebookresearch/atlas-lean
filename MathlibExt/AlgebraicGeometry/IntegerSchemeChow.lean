/-!
# Integral scheme Chow groups on an actual cycle quotient

The grading is signed and negative degrees have no supported points. Rational
equivalence is generated by actual closed integral subschemes and their
function-field principal cycles. The ambient scheme is finite type over the
coefficient field: the dimension filter is not claimed valid on arbitrary
Noetherian bases or under arbitrary transcendental scalar extension.
-/

@[expose] public noncomputable section
namespace AlgebraicGeometry.IntegerSchemeChow

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open StackCycleGeometry

structure FieldScheme (k : Type) [Field k] where
  scheme : Over (Spec (.of k))
  [finiteType : LocallyOfFiniteType scheme.hom]
  [quasiCompact : QuasiCompact scheme.hom]
  [noetherian : IsNoetherian scheme.left]

attribute [instance] FieldScheme.finiteType FieldScheme.quasiCompact FieldScheme.noetherian

def PointDimension (X : Scheme.{0}) (x : X) (d : ℤ) : Prop :=
  ∃ n : ℕ, (n : ℤ) = d ∧ Order.height x = n

def cyclesOfDimension (X : Scheme.{0}) (d : ℤ) :
    AddSubgroup (AlgebraicCycle X ℤ) where
  carrier := {c | ∀ x, c x ≠ 0 → PointDimension X x d}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb x hx
    by_cases h : a x = 0
    · exact hb x (by simpa [h] using hx)
    · exact ha x h
  neg_mem' := by
    intro a ha x hx
    exact ha x (by simpa using hx)

abbrev CycleGroup (X : Scheme.{0}) (d : ℤ) := cyclesOfDimension X d

def dimensionPart (X : Scheme.{0}) (d : ℤ) (c : AlgebraicCycle X ℤ) :
    CycleGroup X d := by
  classical
  let z : AlgebraicCycle X ℤ :=
    { toFun := fun x => if PointDimension X x d then c x else 0
      supportWithinDomain' := Set.subset_univ _
      supportLocallyFiniteWithinDomain' := by
        intro x _
        obtain ⟨U, hU, hfin⟩ := c.locallyFiniteSupport x
        refine ⟨U, hU, hfin.subset ?_⟩
        intro y hy
        refine ⟨hy.1, ?_⟩
        by_cases h : PointDimension X y d
        · simpa [Function.mem_support, h] using hy.2
        · simpa [Function.mem_support, h] using hy.2 }
  exact ⟨z, by intro x hx; by_contra h; exact hx (by simp [z, h])⟩

structure ClosedIntegralScheme (X : Scheme.{0}) (d : ℤ) where
  scheme : Scheme.{0}
  [integral : IsIntegral scheme]
  [noetherian : IsNoetherian scheme]
  inclusion : scheme ⟶ X
  [closed : IsClosedImmersion inclusion]
  dimension : ℕ
  dimension_eq : (dimension : ℤ) = d
  krullDimension_eq : topologicalKrullDim scheme = (dimension : ℕ)

attribute [instance] ClosedIntegralScheme.integral ClosedIntegralScheme.noetherian
  ClosedIntegralScheme.closed

def closedCycle {X : Scheme.{0}} {d : ℤ} (W : ClosedIntegralScheme X d) :
    CycleGroup X d :=
  dimensionPart X d (AlgebraicCycle.map W.inclusion Order.height Order.height
    (integralFundamentalCycle W.scheme))

def IsPrincipalRelation (X : Scheme.{0}) (d : ℤ) (c : CycleGroup X d) : Prop :=
  ∃ (W : ClosedIntegralScheme X (d + 1)) (f : W.scheme.functionFieldˣ)
      (D : PrincipalSchemeCycle W.scheme (f : W.scheme.functionField)),
    c = dimensionPart X d (AlgebraicCycle.map W.inclusion Order.height Order.height D.val)

def rationalEquivalences (X : Scheme.{0}) (d : ℤ) : AddSubgroup (CycleGroup X d) :=
  AddSubgroup.closure {c | IsPrincipalRelation X d c}

abbrev ChowGroup {k : Type} [Field k] (X : FieldScheme k) (d : ℤ) :=
  CycleGroup X.scheme.left d ⧸ rationalEquivalences X.scheme.left d

def cycleClass {k : Type} [Field k] (X : FieldScheme k) (d : ℤ) :
    CycleGroup X.scheme.left d →+ ChowGroup X d :=
  QuotientAddGroup.mk' (rationalEquivalences X.scheme.left d)

abbrev RationalChowGroup {k : Type} [Field k] (X : FieldScheme k) (d : ℤ) :=
  TensorProduct ℤ ℚ (ChowGroup X d)

/-- A degree map on zero-cycles of a proper $k$-scheme $X$: an additive map from the Chow group of
zero-cycles of $X$ to $\mathbb{Z}$ sending the class of every zero-cycle $\sum_x n_x [x]$ to
$\sum_x n_x [\kappa(x) : k]$. -/
structure DegreeComparison {k : Type} [Field k] (X : FieldScheme k)
    [IsProper X.scheme.hom] where
  degree : ChowGroup X 0 →+ ℤ
  normalized : ∀ c : CycleGroup X.scheme.left 0,
    degree (cycleClass X 0 c) = AlgebraicCycle.degree X.scheme.hom c.val

end AlgebraicGeometry.IntegerSchemeChow
