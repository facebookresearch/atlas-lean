module

public import Mathlib.AlgebraicGeometry.Scheme
public import Mathlib.Topology.Instances.Complex

@[expose] public section

/-!
# The topology of complex analytification

For a scheme over `ℂ`, its complex points are the sections of its structure
morphism. We give them the topology generated by sets
`{p ∈ U(ℂ) | g(p) ∈ V}`, where `U` is a scheme open, `g` is a regular function
on `U`, and `V` is open in `ℂ`. For a scheme locally of finite type over `ℂ`,
this is the usual topology of its analytification.

The generators here allow all scheme opens. The equivalent presentation using
only affine opens is used in AxiomMath/Weil: regular functions on every open
are continuous for that presentation, as proved there in
`ComplexPoints.continuous_eval_of_isOpen`. Allowing all opens makes the proof
of functoriality direct.

Only the underlying topological space is constructed here. The sheaf of
holomorphic functions of a complex analytic space is not needed for rational
Betti sheaves.

## References

* E. Freitag and R. Kiehl, *Étale Cohomology and the Weil Conjecture*,
  Chapter I, §11.
* A. Grothendieck, *Revêtements étales et groupe fondamental*,
  SGA 1, Exposé XII, §1.
* AxiomMath/Weil, the source paths and revision in the attribution above.
-/

noncomputable section

open CategoryTheory TopologicalSpace
open _root_.AlgebraicGeometry

namespace MathlibExt.AlgebraicGeometry.ComplexAnalytification

/-- The complex points of a scheme over `ℂ`: sections of its structure map. -/
def ComplexPoints {Y : Scheme.{0}} (y : Y ⟶ Spec (.of ℂ)) : Type :=
  {p : Spec (.of ℂ) ⟶ Y // p ≫ y = 𝟙 _}

namespace ComplexPoints

variable {Y : Scheme.{0}} {y : Y ⟶ Spec (.of ℂ)}

/-- The scheme morphism underlying a complex point. -/
def hom (p : ComplexPoints y) : Spec (.of ℂ) ⟶ Y := p.1

@[ext]
theorem ext {p q : ComplexPoints y} (h : p.hom = q.hom) : p = q :=
  Subtype.ext h

@[simp]
theorem hom_comp (p : ComplexPoints y) : p.hom ≫ y = 𝟙 _ := p.2

/-- A complex point lies in a scheme open when its image lies in that open. -/
def Mem (p : ComplexPoints y) (U : Y.Opens) : Prop :=
  p.hom ⁻¹ᵁ U = ⊤

/-- Evaluation of a regular function at a complex point of its domain. -/
def eval {U : Y.Opens} (g : Γ(Y, U)) (p : ComplexPoints y)
    (hp : p.Mem U) : ℂ :=
  (Scheme.ΓSpecIso (.of ℂ)).hom (p.hom.appLE U ⊤ hp.ge g)

/-- The basic analytic open associated with a regular function and an open
subset of the complex numbers. -/
def basicSet (U : Y.Opens) (g : Γ(Y, U)) (V : Set ℂ) :
    Set (ComplexPoints y) :=
  {p | ∃ hp : p.Mem U, eval g p hp ∈ V}

/-- The generators for the analytic topology, using all scheme opens. -/
def basicSets (y : Y ⟶ Spec (.of ℂ)) : Set (Set (ComplexPoints y)) :=
  {s | ∃ (U : Y.Opens) (g : Γ(Y, U)) (V : Set ℂ),
    IsOpen V ∧ s = basicSet U g V}

/-- The analytic topology on the complex points of a scheme over `ℂ`. -/
instance instTopologicalSpace : TopologicalSpace (ComplexPoints y) :=
  TopologicalSpace.generateFrom (basicSets y)

/-- Each defining basic set is open in the analytic topology. -/
theorem isOpen_basicSet (U : Y.Opens) (g : Γ(Y, U)) {V : Set ℂ}
    (hV : IsOpen V) : IsOpen (basicSet (y := y) U g V) :=
  TopologicalSpace.GenerateOpen.basic _ ⟨U, g, V, hV, rfl⟩

/-- Continuity into the complex points can be checked on the defining sets. -/
theorem continuous_iff {X : Type*} [TopologicalSpace X]
    {f : X → ComplexPoints y} :
    Continuous f ↔ ∀ (U : Y.Opens) (g : Γ(Y, U)) (V : Set ℂ),
      IsOpen V → IsOpen (f ⁻¹' basicSet U g V) := by
  rw [continuous_generateFrom_iff]
  constructor
  · intro h U g V hV
    exact h _ ⟨U, g, V, hV, rfl⟩
  · rintro h _ ⟨U, g, V, hV, rfl⟩
    exact h U g V hV

/-- Membership in a scheme open is membership of the underlying scheme point. -/
theorem mem_iff {p : ComplexPoints y} {U : Y.Opens}
    (x : Spec (.of ℂ)) : p.Mem U ↔ p.hom.base x ∈ U := by
  have : Subsingleton (Spec (.of ℂ)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum ℂ))
  constructor
  · intro h
    have : x ∈ p.hom ⁻¹ᵁ U := by rw [h]; trivial
    exact this
  · intro h
    refine eq_top_iff.2 fun z _ => ?_
    rw [Subsingleton.elim z x]
    exact h

/-- The scheme point underlying a complex point. -/
def schemePoint (p : ComplexPoints y) : Y :=
  p.hom.base (Classical.choice
    (inferInstance : Nonempty (Spec (.of ℂ))))

/-- The underlying scheme point lies in exactly the same scheme opens. -/
theorem schemePoint_mem_iff (p : ComplexPoints y) (U : Y.Opens) :
    p.schemePoint ∈ U ↔ p.Mem U :=
  (mem_iff _).symm

/-- Taking the whole complex plane gives the points of the scheme open. -/
theorem basicSet_univ (U : Y.Opens) (g : Γ(Y, U)) :
    basicSet (y := y) U g Set.univ = {p | p.Mem U} := by
  ext p
  simp [basicSet]

/-- The complex points of every scheme open form an analytic open. -/
theorem isOpen_setOf_mem (U : Y.Opens) :
    IsOpen {p : ComplexPoints y | p.Mem U} := by
  rw [← basicSet_univ U 0]
  exact isOpen_basicSet U 0 isOpen_univ

/-- Every regular function is continuous on the complex points of its domain. -/
theorem continuous_eval (U : Y.Opens) (g : Γ(Y, U)) :
    Continuous fun p : {p : ComplexPoints y // p.Mem U} =>
      eval g p.1 p.2 := by
  rw [continuous_def]
  intro V hV
  convert (isOpen_basicSet U g hV).preimage continuous_subtype_val using 1
  ext p
  exact ⟨fun h => ⟨p.2, h⟩, fun ⟨_, h⟩ => h⟩

variable {Y' Y'' : Scheme.{0}}
  {y' : Y' ⟶ Spec (.of ℂ)} {y'' : Y'' ⟶ Spec (.of ℂ)}

/-- The map on complex points induced by a morphism over the complex numbers. -/
def map (f : Y ⟶ Y') (hf : f ≫ y' = y) (p : ComplexPoints y) :
    ComplexPoints y' :=
  ⟨p.hom ≫ f, by rw [Category.assoc, hf, p.hom_comp]⟩

@[simp]
theorem map_hom (f : Y ⟶ Y') (hf : f ≫ y' = y)
    (p : ComplexPoints y) : (map f hf p).hom = p.hom ≫ f := rfl

/-- Evaluation after applying a morphism is evaluation of the pulled-back
regular function. -/
theorem eval_map_point (f : Y ⟶ Y') (hf : f ≫ y' = y)
    {U : Y'.Opens} (g : Γ(Y', U)) (p : ComplexPoints y)
    (hp : (map f hf p).Mem U) :
    eval g (map f hf p) hp = eval (f.app U g) p hp := by
  simp only [eval, map_hom]
  rw [Scheme.Hom.comp_appLE]
  rfl

@[simp]
theorem map_id (p : ComplexPoints y) :
    map (𝟙 Y) (Category.id_comp y) p = p :=
  ext (Category.comp_id _)

/-- The map on complex points respects composition. -/
theorem map_comp (f : Y ⟶ Y') (hf : f ≫ y' = y)
    (f' : Y' ⟶ Y'') (hf' : f' ≫ y'' = y') (p : ComplexPoints y) :
    map (f ≫ f') (by rw [Category.assoc, hf', hf]) p =
      map f' hf' (map f hf p) :=
  ext (Category.assoc _ _ _).symm

/-- Morphisms of schemes over the complex numbers act continuously on their
complex points. -/
theorem continuous_map (f : Y ⟶ Y') (hf : f ≫ y' = y) :
    Continuous (map f hf) := by
  rw [continuous_iff]
  intro U g V hV
  have h : map f hf ⁻¹' basicSet U g V =
      basicSet (f ⁻¹ᵁ U) (f.app U g) V := by
    ext p
    exact ⟨fun ⟨hp, h⟩ => ⟨hp, (eval_map_point f hf g p hp) ▸ h⟩,
      fun ⟨hp, h⟩ => ⟨hp, (eval_map_point f hf g p hp).symm ▸ h⟩⟩
  rw [h]
  exact isOpen_basicSet _ _ hV

end ComplexPoints

/-- The topological space of complex points of a scheme over `ℂ`. -/
def space (X : Over (Spec (.of ℂ))) : TopCat :=
  TopCat.of (ComplexPoints X.hom)

/-- The continuous map induced by a morphism of schemes over `ℂ`. -/
def spaceMap {X Y : Over (Spec (.of ℂ))} (f : X ⟶ Y) :
    space X ⟶ space Y :=
  TopCat.ofHom ⟨ComplexPoints.map f.left f.w,
    ComplexPoints.continuous_map f.left f.w⟩

/-- The topological complex-points functor on schemes over `ℂ`. -/
def functor : Over (Spec (.of ℂ)) ⥤ TopCat where
  obj := space
  map := spaceMap
  map_id X := by
    apply TopCat.ext
    intro p
    exact ComplexPoints.map_id p
  map_comp f g := by
    apply TopCat.ext
    intro p
    exact ComplexPoints.map_comp f.left f.w g.left g.w p

end MathlibExt.AlgebraicGeometry.ComplexAnalytification
