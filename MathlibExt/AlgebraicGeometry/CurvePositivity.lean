module

public import MathlibExt.AlgebraicGeometry.CurveVectorBundles
public import MathlibExt.AlgebraicGeometry.SchemeModulesTensor

/-!
# Curve line-bundle positivity

Tensor powers are those of `SchemeModulesTensor` (actual presheaf tensor
followed by sheafification), re-exported here. Torsion and semiampleness are
predicates on line bundles: some positive power is trivial, respectively
generated by global sections. On a proper curve, bigness
of a line bundle is positive linear asymptotic growth of the sections of its
powers, the dimension-one definition. On an integral proper curve, nefness
is nonnegative degree (on a reducible curve it is nonnegative degree on each
component, so the predicate is not stated there). These are curve
predicates, rather than a substitute for higher-dimensional numerical
positivity.

Reference: Lazarsfeld, *Positivity in Algebraic Geometry I*, Chapter 1,
https://doi.org/10.1007/978-3-642-18808-4.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.CurvePositivity

open CategoryTheory CategoryTheory.MonoidalCategory
open _root_.AlgebraicGeometry
open MathlibExt.AlgebraicGeometry.CoherentCurveLinearSeries
open MathlibExt.AlgebraicGeometry.CurveVectorBundles

export _root_.MathlibExt.AlgebraicGeometry.SchemeModulesTensor (moduleTensor power)

universe u

/-- Some positive tensor power of the line bundle `L` is trivial. -/
def IsTorsion {X : Scheme.{u}} (L : X.Modules) (_hL : IsLineBundle L) : Prop :=
  ∃ n : ℕ, 0 < n ∧ Nonempty (power L n ≅ structureModule X)

/-- Some positive tensor power of the line bundle `L` is generated by global sections. -/
def IsSemiample {X : Scheme.{u}} (L : X.Modules) (_hL : IsLineBundle L) : Prop :=
  ∃ n : ℕ, 0 < n ∧ GloballyGenerated (power L n)

/-- Positive asymptotic linear section growth of a line bundle on a proper
curve: `h⁰(L^{⊗ n}) ≥ c n` for some `c > 0` and all large `n`. -/
def IsBigOnCurve {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProperCurve f] (L : X.Modules)
    (_hL : IsLineBundle L) : Prop :=
  ∃ c : ℚ, 0 < c ∧ ∃ N : ℕ, ∀ n ≥ N,
    c * n ≤ (Module.finrank k (cohomology f (power L n) 0) : ℚ)

/-- Numerical nefness of a line bundle on an integral proper curve: nonnegative degree. -/
def IsNefOnCurve {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProperCurve f] [IsIntegral X] (L : X.Modules)
    (hL : IsLineBundle L) : Prop :=
  0 ≤ degree f L hL

end MathlibExt.AlgebraicGeometry.CurvePositivity
