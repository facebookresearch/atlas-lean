-- Authors: @toskua, Avocado
module
public import MathlibExt.AlgebraicGeometry.Sites.SmallEtaleCoefficientSections
public import Mathlib.RingTheory.Etale.Finite
public import Mathlib.RingTheory.Etale.Field
public import Mathlib.RingTheory.RingHom.Etale
public import Mathlib.CategoryTheory.Sites.Equivalence
public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.AlgebraicGeometry.Sites.EtalePoint

/-! # The finite étale algebra basis of the original field site

The literal spectrum functor identifies finite étale algebras over a field with
its original affine étale basis. The transported topology is generated by finite
families of the original covering arrows, including the empty cover.

The common-universe sheaf equivalence extends to the full original small site,
with every section restriction and sheaf-morphism component retained. Original
smaller coefficients are lifted exactly once. The prescribed separable closure
provides the same geometric lifts and literal algebra embeddings, naturally in
every algebra map.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open CategoryTheory CategoryTheory.Limits Opposite
universe u v w

namespace AlgebraicGeometry.Scheme.DerivedSections

variable (k : Type u) [Field k]

/-- The literal spectrum functor from finite etale algebras to the original affine site. -/
def fieldFiniteEtaleSpec :
    (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ ⥤ (Spec (.of k)).AffineEtale where
  obj A := by
    let : Etale (Spec.algebraMap k A.unop) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    exact AffineEtale.mk (Spec.algebraMap k A.unop)
  map {A B} f :=
    MorphismProperty.CostructuredArrow.homMk
      (CommRingCat.ofHom f.unop.hom.hom.toRingHom).op trivial (by
        change Spec.map (CommRingCat.ofHom f.unop.hom.hom.toRingHom) ≫
          Spec.algebraMap k B.unop = Spec.algebraMap k A.unop
        rw [← Spec.map_comp]
        congr 1
        ext x
        exact f.unop.hom.hom.commutes x)
  map_id A := by
    apply MorphismProperty.CostructuredArrow.Hom.ext
    rfl
  map_comp f g := by
    apply MorphismProperty.CostructuredArrow.Hom.ext
    rfl

theorem fieldFiniteEtaleSpec_obj_left (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) :
    ((fieldFiniteEtaleSpec k).obj A).left = op (CommRingCat.of A.unop) := rfl

theorem fieldFiniteEtaleSpec_obj_hom (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) :
    ((fieldFiniteEtaleSpec k).obj A).hom = Spec.algebraMap k A.unop := rfl

instance fieldFiniteEtaleSpec_faithful : (fieldFiniteEtaleSpec k).Faithful where
  map_injective {A B} f g h := by
    apply Quiver.Hom.unop_inj
    ext x
    exact congrArg (fun z => z.left.unop.hom x) h

instance fieldFiniteEtaleSpec_full : (fieldFiniteEtaleSpec k).Full where
  map_surjective {A B} f := by
    let g : B.unop →ₐ[k] A.unop :=
      Spec.homEquivAlgHom ⟨Scheme.Spec.map f.left, f.w⟩
    refine ⟨(ObjectProperty.homMk (CommAlgCat.ofHom g)).op, ?_⟩
    apply MorphismProperty.CostructuredArrow.Hom.ext
    apply Quiver.Hom.unop_inj
    apply Spec.map_injective
    change (Spec.homEquivAlgHom.symm g).val = Scheme.Spec.map f.left
    exact congrArg Subtype.val (Spec.homEquivAlgHom.symm_apply_apply
      ⟨Scheme.Spec.map f.left, f.w⟩)

set_option backward.isDefEq.respectTransparency.types false in
instance fieldFiniteEtaleSpec_essSurj : (fieldFiniteEtaleSpec k).EssSurj where
  mem_essImage A := by
    let R := A.left.unop
    let φ : CommRingCat.of k ⟶ R := Spec.preimage A.hom
    let : Algebra k R := φ.hom.toAlgebra
    have hSpec : Spec.algebraMap k R = A.hom := by
      change Spec.map φ = A.hom
      exact Spec.map_preimage A.hom
    let : Algebra.Etale k R := RingHom.etale_algebraMap.mp
      ((HasRingHomProperty.Spec_iff (P := @Etale)).mp
        (show Etale (Spec.algebraMap k R) from by rw [hSpec]; exact A.prop))
    let : Module.Finite k R := Algebra.FormallyUnramified.finite_of_free k R
    let B := CommAlgCat.FiniteEtale.of k R
    refine ⟨op B, ⟨?_⟩⟩
    exact MorphismProperty.CostructuredArrow.isoMk (Iso.refl _) trivial trivial (by
      change Scheme.Spec.map (𝟙 A.left) ≫ A.hom = Spec.algebraMap k R
      rw [CategoryTheory.Functor.map_id, Category.id_comp]
      exact hSpec.symm)

instance fieldFiniteEtaleSpec_isEquivalence : (fieldFiniteEtaleSpec k).IsEquivalence where

/-- The original finite-algebra spectrum functor is an actual equivalence. -/
def fieldFiniteEtaleEquivalence :
    (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ ≌ (Spec (.of k)).AffineEtale :=
  (fieldFiniteEtaleSpec k).asEquivalence

/-- The literal finite-algebra spectrum functor to the original small site. -/
def fieldFiniteEtaleToEtale :
    (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ ⥤ (Spec (.of k)).Etale :=
  fieldFiniteEtaleSpec k ⋙ AffineEtale.Spec (Spec (.of k))

/-- The topology transported from the actual original affine etale basis. -/
def fieldFiniteEtaleTopology :
    GrothendieckTopology (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ :=
  (fieldFiniteEtaleSpec k).inducedTopology (AffineEtale.topology (Spec (.of k)))

/-- Every actual algebra family covers exactly when its original spectra cover. -/
theorem fieldFiniteEtaleCover_iff {ι : Type*}
    {A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ}
    {B : ι → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ} (f : ∀ i, B i ⟶ A) :
    Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A ↔
      ⋃ i, Set.range ((fieldFiniteEtaleToEtale k).map (f i)).left = Set.univ := by
  rw [fieldFiniteEtaleTopology,
    Functor.mem_inducedTopology_iff_of_isCoverDense,
    Sieve.functorPushforward_ofArrows, AffineEtale.topology,
    Functor.mem_inducedTopology_iff_of_isCoverDense,
    Sieve.functorPushforward_ofArrows, Scheme.ofArrows_mem_smallEtaleTopology_iff]
  rfl

/-- The actual basis sheaf equivalence at every independent common coefficient size. -/
def fieldFiniteEtaleSheafEquivalence :
    Sheaf (fieldFiniteEtaleTopology k) AddCommGrpCat.{max u w} ≌
      Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w} := by
  let S := Spec (.of k)
  let e := fieldFiniteEtaleEquivalence k
  let : e.symm.inverse.IsDenseSubsite (fieldFiniteEtaleTopology k)
      (AffineEtale.topology S) := by
    change (fieldFiniteEtaleSpec k).IsDenseSubsite
      ((fieldFiniteEtaleSpec k).inducedTopology (AffineEtale.topology S))
      (AffineEtale.topology S)
    infer_instance
  let a := e.symm.sheafCongr (AffineEtale.topology S) (fieldFiniteEtaleTopology k)
    AddCommGrpCat.{max u w}
  let F := (AffineEtale.Spec S).sheafPushforwardContinuous AddCommGrpCat.{max u w}
    (AffineEtale.topology S) S.smallEtaleTopology
  let : F.IsEquivalence := Functor.isEquivalence_of_isOneHypercoverDense.{u}
    (AffineEtale.Spec S) (AffineEtale.topology S) S.smallEtaleTopology AddCommGrpCat.{max u w}
  exact a.symm.trans F.asEquivalence.symm

/-- Restriction is evaluation on the same original spectrum object. -/
theorem fieldFiniteEtaleSheafEquivalence_inverse_obj
    (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj Q).obj.obj (op A) =
      Q.obj.obj (op ((fieldFiniteEtaleToEtale k).obj A)) := rfl

/-- Every original sheaf map has its same original section component. -/
theorem fieldFiniteEtaleSheafEquivalence_inverse_map
    {Q Q' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w}} (τ : Q ⟶ Q')
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.map τ).hom.app (op A) =
      τ.hom.app (op ((fieldFiniteEtaleToEtale k).obj A)) := rfl

/-- Original geometric lifts are exactly the literal algebra embeddings. -/
def fieldFiniteEtaleFiberEquiv (Ω : Type u) [Field Ω] [Algebra k Ω] [IsSepClosed Ω]
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) :
    (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.obj
        ((fieldFiniteEtaleToEtale k).obj A) ≃ (A.unop →ₐ[k] Ω) where
  toFun z := Spec.homEquivAlgHom ⟨z.left, z.w⟩
  invFun h := Over.homMk (Spec.homEquivAlgHom.symm h).val
    (Spec.homEquivAlgHom.symm h).property
  left_inv z := by
    apply Over.OverMorphism.ext
    exact congrArg Subtype.val (Spec.homEquivAlgHom.symm_apply_apply ⟨z.left, z.w⟩)
  right_inv h := by
    change Spec.homEquivAlgHom (Spec.homEquivAlgHom.symm h) = h
    exact Spec.homEquivAlgHom.apply_symm_apply h

/-- The actual spectrum arrow is the original algebra map, without a changed carrier. -/
theorem fieldFiniteEtaleSpec_map_left
    {A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ} (f : A ⟶ B) :
    ((fieldFiniteEtaleSpec k).map f).left =
      (CommRingCat.ofHom f.unop.hom.hom.toRingHom).op := rfl

/-- Every original basis cover has a finite subfamily of its same original arrows. -/
theorem fieldFiniteEtaleCover_finite_subfamily {ι : Type*}
    {A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ}
    {B : ι → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ} (f : ∀ i, B i ⟶ A)
    (h : Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A) :
    ∃ t : Set ι, t.Finite ∧
      Sieve.ofArrows (fun j : t => B j.val) (fun j => f j.val) ∈
        fieldFiniteEtaleTopology k A := by
  classical
  let X := ((fieldFiniteEtaleToEtale k).obj A).left
  let : Finite X := by
    change Finite (PrimeSpectrum A.unop.obj)
    infer_instance
  have hu := (fieldFiniteEtaleCover_iff k f).mp h
  have H : ∀ x : X, ∃ i : ι,
      ∃ y : ((fieldFiniteEtaleToEtale k).obj (B i)).left,
        ((fieldFiniteEtaleToEtale k).map (f i)).left y = x := by
    intro x
    have hx : x ∈ ⋃ i, Set.range ((fieldFiniteEtaleToEtale k).map (f i)).left := by
      rw [hu]
      trivial
    simpa only [Set.mem_iUnion, Set.mem_range] using hx
  choose i y hi using H
  refine ⟨Set.range i, Set.finite_range i, ?_⟩
  rw [fieldFiniteEtaleCover_iff]
  ext x
  simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
  exact ⟨⟨i x, ⟨x, rfl⟩⟩, y x, hi x⟩

/-- The finite etale algebra of the actual empty spectrum. -/
def fieldFiniteEtaleEmptyObject : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ :=
  op (CommAlgCat.FiniteEtale.of k (Fin 0 → k))

/-- The empty family is a covering of the original empty spectrum object. -/
theorem fieldFiniteEtale_empty_cover :
    Sieve.ofArrows (fun i : Fin 0 => Fin.elim0 i)
      (fun i : Fin 0 => Fin.elim0 i) ∈
        fieldFiniteEtaleTopology k (fieldFiniteEtaleEmptyObject k) := by
  rw [fieldFiniteEtaleCover_iff]
  let : IsEmpty ((fieldFiniteEtaleToEtale k).obj (fieldFiniteEtaleEmptyObject k)).left := by
    change IsEmpty (PrimeSpectrum (Fin 0 → k))
    infer_instance
  ext x
  exact isEmptyElim x

/-- The same original restriction arrow gives the same section restriction. -/
theorem fieldFiniteEtaleSheafEquivalence_inverse_restrict
    (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
    {A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖᵒᵖ} (f : A ⟶ B) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj Q).obj.map f =
      Q.obj.map ((fieldFiniteEtaleToEtale k).op.map f) := rfl

/-- The actual basis extension and restriction have their fixed natural unit. -/
theorem fieldFiniteEtaleSheafEquivalence_unit_naturality
    {Q Q' : Sheaf (fieldFiniteEtaleTopology k) AddCommGrpCat.{max u w}} (τ : Q ⟶ Q') :
    τ ≫ (fieldFiniteEtaleSheafEquivalence.{u, w} k).unitIso.hom.app Q' =
      (fieldFiniteEtaleSheafEquivalence.{u, w} k).unitIso.hom.app Q ≫
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).functor ⋙
          (fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse).map τ :=
  (fieldFiniteEtaleSheafEquivalence.{u, w} k).unitIso.hom.naturality τ

/-- The full original-site sheaves have the same actual natural counit. -/
theorem fieldFiniteEtaleSheafEquivalence_counit_naturality
    {Q Q' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w}} (τ : Q ⟶ Q') :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse ⋙
        (fieldFiniteEtaleSheafEquivalence.{u, w} k).functor).map τ ≫
      (fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q' =
        (fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q ≫ τ :=
  (fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.naturality τ

/-- The left comparison triangle holds for every basis sheaf. -/
theorem fieldFiniteEtaleSheafEquivalence_left_triangle
    (Q : Sheaf (fieldFiniteEtaleTopology k) AddCommGrpCat.{max u w}) :
    (fieldFiniteEtaleSheafEquivalence.{u, w} k).functor.map
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).unitIso.hom.app Q) ≫
      (fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).functor.obj Q) =
      𝟙 ((fieldFiniteEtaleSheafEquivalence.{u, w} k).functor.obj Q) :=
  (fieldFiniteEtaleSheafEquivalence.{u, w} k).functor_unitIso_comp Q

/-- The right comparison triangle holds for every full-site sheaf. -/
theorem fieldFiniteEtaleSheafEquivalence_right_triangle
    (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w}) :
    (fieldFiniteEtaleSheafEquivalence.{u, w} k).unitIso.hom.app
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj Q) ≫
      (fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.map
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q) =
      𝟙 ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj Q) :=
  (fieldFiniteEtaleSheafEquivalence.{u, w} k).toAdjunction.right_triangle_components Q

set_option backward.isDefEq.respectTransparency.types false in
/-- The actual geometric-fiber correspondence respects every original algebra map. -/
theorem fieldFiniteEtaleFiberEquiv_naturality
    (Ω : Type u) [Field Ω] [Algebra k Ω] [IsSepClosed Ω]
    {A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ} (f : A ⟶ B)
    (z : (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.obj
      ((fieldFiniteEtaleToEtale k).obj A)) :
    fieldFiniteEtaleFiberEquiv k Ω B
        ((Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.map
          ((fieldFiniteEtaleToEtale k).map f) z) =
      (fieldFiniteEtaleFiberEquiv k Ω A z).comp f.unop.hom.hom := by
  apply Spec.homEquivAlgHom.symm.injective
  apply Subtype.ext
  let y := (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.map
    ((fieldFiniteEtaleToEtale k).map f) z
  have hleft : (Spec.homEquivAlgHom.symm (fieldFiniteEtaleFiberEquiv k Ω B y)).val =
      y.left :=
    congrArg Subtype.val (Spec.homEquivAlgHom.symm_apply_apply ⟨y.left, y.w⟩)
  rw [hleft]
  change z.left ≫ Spec.map (CommRingCat.ofHom f.unop.hom.hom.toRingHom) =
    Spec.map (CommRingCat.ofHom
      ((fieldFiniteEtaleFiberEquiv k Ω A z).comp f.unop.hom.hom).toRingHom)
  have hz : Spec.map (CommRingCat.ofHom
      (fieldFiniteEtaleFiberEquiv k Ω A z).toRingHom) = z.left :=
    congrArg Subtype.val (Spec.homEquivAlgHom.symm_apply_apply ⟨z.left, z.w⟩)
  rw [← hz]
  exact (Spec.map_comp (CommRingCat.ofHom f.unop.hom.hom.toRingHom)
    (CommRingCat.ofHom (fieldFiniteEtaleFiberEquiv k Ω A z).toRingHom)).symm

/-- One natural isomorphism uses the prescribed original point and every embedding map. -/
def fieldFiniteEtaleFiberIso (Ω : Type u) [Field Ω] [Algebra k Ω] [IsSepClosed Ω] :
    fieldFiniteEtaleToEtale k ⋙ (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber ≅
      CommAlgCat.FiniteEtale.fiber k Ω ⋙ CategoryTheory.forget FintypeCat.{u} :=
  NatIso.ofComponents (fun A => (fieldFiniteEtaleFiberEquiv k Ω A).toIso)
    (by intro A B f; ext z; exact fieldFiniteEtaleFiberEquiv_naturality k Ω f z)

/-- A covering sieve contains a genuinely finite family of its original covering arrows. -/
theorem fieldFiniteEtaleTopology_finite_generators
    {A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ} (S : Sieve A) :
    S ∈ fieldFiniteEtaleTopology k A ↔
      ∃ (I : Type (u + 1)) (B : I → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
        (f : ∀ i, B i ⟶ A),
        Finite I ∧ Sieve.ofArrows B f ≤ S ∧
          Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A := by
  constructor
  · intro h
    obtain ⟨I, B, f, rfl⟩ := S.exists_eq_ofArrows
    obtain ⟨t, ht, hc⟩ := fieldFiniteEtaleCover_finite_subfamily k f h
    refine ⟨t, (fun j : t => B j.val), (fun j => f j.val),
      Set.finite_coe_iff.mpr ht, ?_, hc⟩
    exact Sieve.generate_mono (Presieve.ofArrows_comp_le f Subtype.val)
  · rintro ⟨I, B, f, _, hs, hc⟩
    exact (fieldFiniteEtaleTopology k).superset_covering hs hc

/-- The actual finite covering families form a coverage of the original algebra basis. -/
def fieldFiniteEtaleFiniteCoverage : Coverage (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ where
  coverings A := {R | ∃ (I : Type (u + 1))
      (B : I → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (f : ∀ i, B i ⟶ A),
      Finite I ∧ R = Presieve.ofArrows B f ∧
        Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A}
  pullback := by
    intro X Y f R hR
    have hcov : Sieve.generate R ∈ fieldFiniteEtaleTopology k X := by
      obtain ⟨I, B, g, _, rfl, hg⟩ := hR
      exact hg
    have hp := (fieldFiniteEtaleTopology k).pullback_stable f hcov
    obtain ⟨I, B, g, hI, hs, hc⟩ :=
      (fieldFiniteEtaleTopology_finite_generators k ((Sieve.generate R).pullback f)).mp hp
    refine ⟨Presieve.ofArrows B g, ⟨I, B, g, hI, rfl, hc⟩, ?_⟩
    intro Z a ha
    exact hs a (Sieve.le_generate _ Z a ha)

/-- The transported original topology is exactly generated by these finite covers. -/
theorem fieldFiniteEtaleTopology_eq_finiteCoverage :
    (fieldFiniteEtaleFiniteCoverage k).toGrothendieck = fieldFiniteEtaleTopology k := by
  apply le_antisymm
  · apply ((Coverage.gi ((CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)).gc _ _).mpr
    intro X R hR
    obtain ⟨I, B, f, _, rfl, hc⟩ := hR
    exact hc
  · intro X S hS
    obtain ⟨I, B, f, hI, hs, hc⟩ :=
      (fieldFiniteEtaleTopology_finite_generators k S).mp hS
    apply (fieldFiniteEtaleFiniteCoverage k).toGrothendieck.superset_covering hs
    rw [Coverage.mem_toGrothendieck]
    exact Coverage.Saturate.of X (Presieve.ofArrows B f) ⟨I, B, f, hI, rfl, hc⟩

/-- The same one coefficient lift has its literal original basis section values. -/
theorem fieldFiniteEtaleSheafEquivalence_original_obj
    (F : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{w})
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj
      ((liftCoefficients.{u, w} (Spec (.of k))).obj F)).obj.obj (op A) =
        AddCommGrpCat.of (ULift.{u} (F.obj.obj (op ((fieldFiniteEtaleToEtale k).obj A)))) := rfl

/-- The counit is an actual section isomorphism on every original full-site object. -/
theorem fieldFiniteEtaleSheafEquivalence_counit_app_isIso
    (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
    (U : (Spec (.of k)).Etale) :
    IsIso (((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q).hom.app
      (op U)) := by
  infer_instance

/-- Full-site restriction maps commute with the actual extension counit. -/
theorem fieldFiniteEtaleSheafEquivalence_counit_restrict
    (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
    {U V : (Spec (.of k)).Etale} (f : U ⟶ V) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).functor.obj
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj Q)).obj.map f.op ≫
      ((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q).hom.app (op U) =
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q).hom.app (op V) ≫
      Q.obj.map f.op :=
  ((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q).hom.naturality f.op

/-- Every full-site sheaf-morphism component is retained through the same counit. -/
theorem fieldFiniteEtaleSheafEquivalence_counit_map_app
    {Q Q' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w}} (τ : Q ⟶ Q')
    (U : (Spec (.of k)).Etale) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).functor.map
        ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.map τ)).hom.app (op U) ≫
      ((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q').hom.app (op U) =
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).counitIso.hom.app Q).hom.app (op U) ≫
      τ.hom.app (op U) :=
  congrArg (fun f => f.hom.app (op U))
    (fieldFiniteEtaleSheafEquivalence_counit_naturality.{u, w} k τ)

/-- Every original smaller-coefficient map is lifted once, on the same basis section. -/
theorem fieldFiniteEtaleSheafEquivalence_original_map
    {F F' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{w}} (τ : F ⟶ F')
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
    (x : F.obj.obj (op ((fieldFiniteEtaleToEtale k).obj A))) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.map
      ((liftCoefficients.{u, w} (Spec (.of k))).map τ)).hom.app (op A) (ULift.up x) =
        ULift.up (τ.hom.app (op ((fieldFiniteEtaleToEtale k).obj A)) x) := rfl

/-- The same original restriction map is retained after the single coefficient lift. -/
theorem fieldFiniteEtaleSheafEquivalence_original_restrict
    (F : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{w})
    {A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ} (f : A ⟶ B)
    (x : F.obj.obj (op ((fieldFiniteEtaleToEtale k).obj B))) :
    ((fieldFiniteEtaleSheafEquivalence.{u, w} k).inverse.obj
      ((liftCoefficients.{u, w} (Spec (.of k))).obj F)).obj.map f.op (ULift.up x) =
        ULift.up (F.obj.map ((fieldFiniteEtaleToEtale k).map f).op x) := rfl

/-- All original algebra objects, arrows and finite covering generators use the same site. -/
def FieldFiniteEtaleSiteLaws : Prop :=
  (fieldFiniteEtaleSpec k).IsEquivalence ∧
  (fieldFiniteEtaleEquivalence k).functor = fieldFiniteEtaleSpec k ∧
  (∀ A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ,
    ((fieldFiniteEtaleSpec k).obj A).left = op (CommRingCat.of A.unop) ∧
      ((fieldFiniteEtaleSpec k).obj A).hom = Spec.algebraMap k A.unop) ∧
  (∀ (A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (f : A ⟶ B),
    ((fieldFiniteEtaleSpec k).map f).left =
      (CommRingCat.ofHom f.unop.hom.hom.toRingHom).op) ∧
  (∀ (ι : Type v) (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
      (B : ι → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (f : ∀ i, B i ⟶ A),
    Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A ↔
      ⋃ i, Set.range ((fieldFiniteEtaleToEtale k).map (f i)).left = Set.univ) ∧
  (∀ (ι : Type v) (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
      (B : ι → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (f : ∀ i, B i ⟶ A),
    Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A →
      ∃ t : Set ι, t.Finite ∧
        Sieve.ofArrows (fun j : t => B j.val) (fun j => f j.val) ∈
          fieldFiniteEtaleTopology k A) ∧
  (∀ (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (S : Sieve A),
    S ∈ fieldFiniteEtaleTopology k A ↔
      ∃ (I : Type (u + 1)) (B : I → (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
        (f : ∀ i, B i ⟶ A), Finite I ∧ Sieve.ofArrows B f ≤ S ∧
          Sieve.ofArrows B f ∈ fieldFiniteEtaleTopology k A) ∧
  (fieldFiniteEtaleFiniteCoverage k).toGrothendieck = fieldFiniteEtaleTopology k ∧
  Sieve.ofArrows (fun i : Fin 0 => Fin.elim0 i) (fun i : Fin 0 => Fin.elim0 i) ∈
    fieldFiniteEtaleTopology k (fieldFiniteEtaleEmptyObject k)

/-- Full-site extension, basis restriction and both natural comparisons retain every map. -/
def FieldFiniteEtaleSheafLaws : Prop :=
  let E := fieldFiniteEtaleSheafEquivalence.{u, w} k
  let L := liftCoefficients.{u, w} (Spec (.of k))
  (∀ (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
      (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ),
    (E.inverse.obj Q).obj.obj (op A) = Q.obj.obj (op ((fieldFiniteEtaleToEtale k).obj A))) ∧
  (∀ (Q Q' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
      (τ : Q ⟶ Q') (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ),
    (E.inverse.map τ).hom.app (op A) = τ.hom.app (op ((fieldFiniteEtaleToEtale k).obj A))) ∧
  (∀ (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
      (A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖᵒᵖ) (f : A ⟶ B),
    (E.inverse.obj Q).obj.map f = Q.obj.map ((fieldFiniteEtaleToEtale k).op.map f)) ∧
  (∀ (Q Q' : Sheaf (fieldFiniteEtaleTopology k) AddCommGrpCat.{max u w}) (τ : Q ⟶ Q'),
    τ ≫ E.unitIso.hom.app Q' = E.unitIso.hom.app Q ≫ (E.functor ⋙ E.inverse).map τ) ∧
  (∀ (Q Q' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w}) (τ : Q ⟶ Q'),
    (E.inverse ⋙ E.functor).map τ ≫ E.counitIso.hom.app Q' = E.counitIso.hom.app Q ≫ τ) ∧
  (∀ Q : Sheaf (fieldFiniteEtaleTopology k) AddCommGrpCat.{max u w},
    E.functor.map (E.unitIso.hom.app Q) ≫ E.counitIso.hom.app (E.functor.obj Q) =
      𝟙 (E.functor.obj Q)) ∧
  (∀ Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w},
    E.unitIso.hom.app (E.inverse.obj Q) ≫ E.inverse.map (E.counitIso.hom.app Q) =
      𝟙 (E.inverse.obj Q)) ∧
  (∀ (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
      (U : (Spec (.of k)).Etale), IsIso ((E.counitIso.hom.app Q).hom.app (op U))) ∧
  (∀ (Q : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
      (U V : (Spec (.of k)).Etale) (f : U ⟶ V),
    (E.functor.obj (E.inverse.obj Q)).obj.map f.op ≫
        (E.counitIso.hom.app Q).hom.app (op U) =
      (E.counitIso.hom.app Q).hom.app (op V) ≫ Q.obj.map f.op) ∧
  (∀ (Q Q' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{max u w})
      (τ : Q ⟶ Q') (U : (Spec (.of k)).Etale),
    (E.functor.map (E.inverse.map τ)).hom.app (op U) ≫
        (E.counitIso.hom.app Q').hom.app (op U) =
      (E.counitIso.hom.app Q).hom.app (op U) ≫ τ.hom.app (op U)) ∧
  (∀ (F : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{w})
      (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ),
    (E.inverse.obj (L.obj F)).obj.obj (op A) =
      AddCommGrpCat.of (ULift.{u} (F.obj.obj (op ((fieldFiniteEtaleToEtale k).obj A))))) ∧
  (∀ (F F' : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{w}) (τ : F ⟶ F')
      (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
      (x : F.obj.obj (op ((fieldFiniteEtaleToEtale k).obj A))),
    (E.inverse.map (L.map τ)).hom.app (op A) (ULift.up x) =
      ULift.up (τ.hom.app (op ((fieldFiniteEtaleToEtale k).obj A)) x)) ∧
  ∀ (F : Sheaf (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{w})
      (A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (f : A ⟶ B)
      (x : F.obj.obj (op ((fieldFiniteEtaleToEtale k).obj B))),
    (E.inverse.obj (L.obj F)).obj.map f.op (ULift.up x) =
      ULift.up (F.obj.map ((fieldFiniteEtaleToEtale k).map f).op x)

section SeparableClosure

attribute [local instance] IsSepClosure.sep_closed

variable (Ω : Type u) [Field Ω] [Algebra k Ω] [IsSepClosure k Ω]

/-- The fixed original geometric fiber for the prescribed separable closure. -/
def fieldFiniteEtaleGeometricFiberIso :
    fieldFiniteEtaleToEtale k ⋙ (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber ≅
      CommAlgCat.FiniteEtale.fiber k Ω ⋙ CategoryTheory.forget FintypeCat.{u} :=
  fieldFiniteEtaleFiberIso k Ω

/-- Its actual component is the original spectrum/algebra correspondence. -/
theorem fieldFiniteEtaleGeometricFiberIso_apply
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
    (z : (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.obj
      ((fieldFiniteEtaleToEtale k).obj A)) :
    (fieldFiniteEtaleGeometricFiberIso k Ω).hom.app A z =
      Spec.homEquivAlgHom ⟨z.left, z.w⟩ := rfl

/-- Its actual inverse gives the same original lift to the spectrum. -/
theorem fieldFiniteEtaleGeometricFiberIso_symm_apply
    (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (h : A.unop →ₐ[k] Ω) :
    (fieldFiniteEtaleGeometricFiberIso k Ω).inv.app A h =
      Over.homMk (Spec.homEquivAlgHom.symm h).val
        (Spec.homEquivAlgHom.symm h).property := rfl

/-- The prescribed original fiber and all original algebra arrows have the same comparison. -/
def FieldFiniteEtaleFiberLaws : Prop :=
  (∀ (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ)
      (z : (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.obj
        ((fieldFiniteEtaleToEtale k).obj A)),
    (fieldFiniteEtaleGeometricFiberIso k Ω).hom.app A z =
      Spec.homEquivAlgHom ⟨z.left, z.w⟩) ∧
  (∀ (A : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (h : A.unop →ₐ[k] Ω),
    (fieldFiniteEtaleGeometricFiberIso k Ω).inv.app A h =
      Over.homMk (Spec.homEquivAlgHom.symm h).val (Spec.homEquivAlgHom.symm h).property) ∧
  ∀ (A B : (CommAlgCat.FiniteEtale.{u} k)ᵒᵖ) (f : A ⟶ B)
      (z : (Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.obj
        ((fieldFiniteEtaleToEtale k).obj A)),
    fieldFiniteEtaleFiberEquiv k Ω B
        ((Scheme.pointSmallEtale (Spec.algebraMap k Ω)).fiber.map
          ((fieldFiniteEtaleToEtale k).map f) z) =
      (fieldFiniteEtaleFiberEquiv k Ω A z).comp f.unop.hom.hom

/-- The full original finite étale basis, topology, sheaf equivalence and geometric fiber. -/
theorem original_field_finite_etale_basis :
    FieldFiniteEtaleSiteLaws.{u, v} k ∧
      FieldFiniteEtaleSheafLaws.{u, w} k ∧ FieldFiniteEtaleFiberLaws k Ω := by
  refine ⟨?_, ?_, ?_⟩
  · refine ⟨inferInstance, rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro A
      exact ⟨fieldFiniteEtaleSpec_obj_left k A, fieldFiniteEtaleSpec_obj_hom k A⟩
    · intro A B f
      exact fieldFiniteEtaleSpec_map_left k f
    · intro ι A B f
      exact fieldFiniteEtaleCover_iff k f
    · intro ι A B f h
      exact fieldFiniteEtaleCover_finite_subfamily k f h
    · intro A S
      exact fieldFiniteEtaleTopology_finite_generators k S
    · exact fieldFiniteEtaleTopology_eq_finiteCoverage k
    · exact fieldFiniteEtale_empty_cover k
  · refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro Q A
      exact fieldFiniteEtaleSheafEquivalence_inverse_obj k Q A
    · intro Q Q' τ A
      exact fieldFiniteEtaleSheafEquivalence_inverse_map k τ A
    · intro Q A B f
      exact fieldFiniteEtaleSheafEquivalence_inverse_restrict k Q f
    · intro Q Q' τ
      exact fieldFiniteEtaleSheafEquivalence_unit_naturality k τ
    · intro Q Q' τ
      exact fieldFiniteEtaleSheafEquivalence_counit_naturality k τ
    · intro Q
      exact fieldFiniteEtaleSheafEquivalence_left_triangle k Q
    · intro Q
      exact fieldFiniteEtaleSheafEquivalence_right_triangle k Q
    · intro Q U
      exact fieldFiniteEtaleSheafEquivalence_counit_app_isIso k Q U
    · intro Q U V f
      exact fieldFiniteEtaleSheafEquivalence_counit_restrict k Q f
    · intro Q Q' τ U
      exact fieldFiniteEtaleSheafEquivalence_counit_map_app k τ U
    · intro F A
      exact fieldFiniteEtaleSheafEquivalence_original_obj k F A
    · intro F F' τ A x
      exact fieldFiniteEtaleSheafEquivalence_original_map k τ A x
    · intro F A B f x
      exact fieldFiniteEtaleSheafEquivalence_original_restrict k F f x
  · refine ⟨?_, ?_, ?_⟩
    · intro A z
      exact fieldFiniteEtaleGeometricFiberIso_apply k Ω A z
    · intro A h
      exact fieldFiniteEtaleGeometricFiberIso_symm_apply k Ω A h
    · intro A B f z
      exact fieldFiniteEtaleFiberEquiv_naturality k Ω f z

end SeparableClosure

end AlgebraicGeometry.Scheme.DerivedSections
