module

public import MathlibExt.AlgebraicGeometry.SmoothDeRhamBettiBridge
public import Mathlib.LinearAlgebra.BilinearForm.TensorProduct
public import Mathlib.LinearAlgebra.Complex.Module
public import Mathlib.LinearAlgebra.TensorProduct.Tower

/-!
# The actual BBF normalization, integral lattice and marked classes

The standard Beauville quadratic expression is the displayed complex-valued
wedge/integral formula below. A symmetric real bilinear form is fixed
by its positive proportionality to that expression on every
closed real two-form. Its integral form is evaluated on actual native
integer Betti classes through the normalized real de Rham bridge.

Primitivity is the unit ideal generated by all bilinear values B(x,y).
It is not a unit-gcd condition on squares B(x,x): the even primitive K3
lattice has all squares even. Signature and Fujiki are output conditions
on these fixed actual forms. The full H² pairing is not asserted to be a
polarization of the full weight-two Hodge structure.

Source: Huybrechts, *Compact Hyperkähler Manifolds: Basic Results*,
alg-geom/9705025v1, section 1.9 p8, gives n/2*I-(n-1)*L*R after volume
normalization. The unnormalized formula divides the mixed product by V.
Section 1.11 gives a positive RATIONAL Fujiki constant. The printed
Verbitsky 0908.4121v8 (1.1) has incompatible coefficients for n>=2; that
expression is retained separately without any BBF proportionality claim.
The standard formula is used on the diagonal and polarized. Native base change
is Mathlib 56a005855ea17e0b0958f73ec801ae140b0a1679,
LinearAlgebra/BilinearForm/TensorProduct (Eric Wieser, 2023, Apache 2.0);
native tensor tower sources credit Kim Morrison, Johan Commelin and Eric
Wieser. The imported wedge/integration sources retain their credits.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.BeauvilleBogomolovForms

open _root_.CategoryTheory HyperkahlerComplexStructures SmoothDeRhamBettiBridge
open KahlerClassGeometry CoordinateFormIntegrals ManifoldDifferentialForms
open scoped Manifold ContDiff TensorProduct BigOperators

variable (n : ℕ) (M : Type) [TopologicalSpace M] [ChartedSpace (Ambient n) M]
  [IsManifold 𝓘(ℝ, Ambient n) ∞ M] [IsManifold 𝓘(ℂ, Ambient n) ∞ M]
  [ExteriorTheory ℝ (Ambient n) M] [WedgeTheory (2 * n) M]

def realForm {p : ℕ} (alpha : RealForms n M p) : ComplexForms n M p := (alpha, 0)
def conjugateForm {p : ℕ} (alpha : ComplexForms n M p) : ComplexForms n M p := (alpha.1, -alpha.2)

def complexWedge {p q : ℕ} (alpha : ComplexForms n M p) (beta : ComplexForms n M q) :
    ComplexForms n M (p + q) :=
  (WedgeTheory.wedge p q alpha.1 beta.1 - WedgeTheory.wedge p q alpha.2 beta.2,
    WedgeTheory.wedge p q alpha.1 beta.2 + WedgeTheory.wedge p q alpha.2 beta.1)

def castComplexForm {p q : ℕ} (h : p = q) (alpha : ComplexForms n M p) : ComplexForms n M q :=
  (castForm (2 * n) M h alpha.1, castForm (2 * n) M h alpha.2)

def complexPower (alpha : ComplexForms n M 2) : (m : ℕ) → ComplexForms n M (2 * m)
  | 0 => (WedgeTheory.unit, 0)
  | m + 1 => castComplexForm n M (Nat.mul_succ 2 m).symm
      (complexWedge n M (complexPower alpha m) alpha)

variable (C : RealCoordinateMap (2 * n)) (A : IntegrationAtlas (2 * n) M)

def complexIntegral (alpha : ComplexForms n M ((2 * n) * 2)) : ℂ :=
  (integral (2 * n) M C A alpha.1 : ℂ) + Complex.I * (integral (2 * n) M C A alpha.2 : ℂ)

def symplecticVolume (sigma : ComplexForms n M 2) : ℂ :=
  complexIntegral n M C A (castComplexForm n M (by omega)
    (complexWedge n M (complexPower n M sigma n) (complexPower n M (conjugateForm n M sigma) n)))

def quadraticExpression (hpos : 0 < n) (sigma : ComplexForms n M 2)
    (eta : RealForms n M 2) (firstCoefficient mixedCoefficient : ℂ) : ℂ :=
  let om := complexPower n M sigma (n - 1)
  let barOm := complexPower n M (conjugateForm n M sigma) (n - 1)
  let omTop := complexPower n M sigma n
  let barTop := complexPower n M (conjugateForm n M sigma) n
  let first := complexIntegral n M C A (castComplexForm n M (by omega)
    (complexWedge n M (complexWedge n M (realForm n M eta) (realForm n M eta))
      (complexWedge n M om barOm)))
  let left := complexIntegral n M C A (castComplexForm n M (by omega)
    (complexWedge n M (complexWedge n M (realForm n M eta) om) barTop))
  let right := complexIntegral n M C A (castComplexForm n M (by omega)
    (complexWedge n M (complexWedge n M (realForm n M eta) omTop) barOm))
  firstCoefficient * first - mixedCoefficient * left * right / symplecticVolume n M C A sigma

/-- Standard Beauville formula, independently read in Huybrechts 1.9.
It has value V on sigma+bar(sigma) and n/2*I on real (1,1) classes. -/
def beauvilleQuadratic (hpos : 0 < n) (sigma : ComplexForms n M 2)
    (eta : RealForms n M 2) : ℂ :=
  quadraticExpression n M C A hpos sigma eta ((n : ℂ) / 2) ((n - 1 : ℕ) : ℂ)

/-- Uncalibrated printed Verbitsky v8 (1.1). This function carries no
claim of proportionality to the BBF or Fujiki form for n>=2. -/
def printedVerbitskyQuadratic (hpos : 0 < n) (sigma : ComplexForms n M 2)
    (eta : RealForms n M 2) : ℂ :=
  quadraticExpression n M C A hpos sigma eta 2 (((n - 1 : ℕ) : ℂ) / (n : ℂ))

def topPowerIntegral (eta : RealForms n M 2) : ℝ :=
  integral (2 * n) M C A (castForm (2 * n) M (by omega)
    (wedgePower (2 * n) M eta (2 * n)))

abbrev IntegralSecond := IntegralBetti.Cohomology (TopCat.of M) 2

structure Signature (q : LinearMap.BilinForm ℝ (RealH2 n M)) where
  count : ℕ
  count_eq : count = Module.finrank ℝ (RealH2 n M)
  positiveRank : 3 ≤ count
  coordinates : RealH2 n M ≃ₗ[ℝ] (Fin count → ℝ)
  value : ∀ v w : Fin count → ℝ, q (coordinates.symm v) (coordinates.symm w) =
    ∑ i, (if i.val < 3 then 1 else -1) * v i * w i

variable [LocalExteriorTheory n M] [IntegerCoefficientTheory M]
  (R : DeRhamResolution n M) (B : RealDeRhamComparison n M R)

set_option maxHeartbeats 1500000 in
-- Elaborating the native sheaf-derived integral carrier and every normalization
-- in one structure needs a larger limit; no mathematical proof search is run.
/-- Native integral and real forms, with every source normalization retained.
Constructing this data is the BBF/Fujiki target, not a hypothesis asserting
the resulting geometric period or Torelli theorem. -/
structure BBFForm (hpos : 0 < n) where
  integerPair : LinearMap.BilinForm ℤ (IntegralSecond M)
  pair : LinearMap.BilinForm ℝ (RealH2 n M)
  symmetric : ∀ x y, pair x y = pair y x
  nondegenerate : ∀ x, (∀ y, pair x y = 0) → x = 0
  primitive : Ideal.span (Set.range fun xy : IntegralSecond M × IntegralSecond M ↦
    integerPair xy.1 xy.2) = ⊤
  integral_symmetric : ∀ x y, integerPair x y = integerPair y x
  integral_value : ∀ x y : IntegralSecond M,
    pair (integralSmoothClass n M R B x) (integralSmoothClass n M R B y) = integerPair x y
  integerFinite : Module.Finite ℤ (IntegralSecond M)
  integerFree : Module.Free ℤ (IntegralSecond M)
  signature : Signature n M pair
  scale : HyperkahlerStructures n M → ℝ
  scale_positive : ∀ I, 0 < scale I
  kahler_positive : ∀ I : HyperkahlerStructures n M,
    0 < pair (classOfClosedTwoForm ℝ (Ambient n) M (chosenHyperkahler n M I).kahler.form)
      (classOfClosedTwoForm ℝ (Ambient n) M (chosenHyperkahler n M I).kahler.form)
  volume_nonzero : ∀ I : HyperkahlerStructures n M,
    symplecticVolume n M C A (chosenHyperkahler n M I).symplectic.form ≠ 0
  normalization : ∀ (I : HyperkahlerStructures n M) (eta : closedForms ℝ (Ambient n) M 2),
    (pair (classOfClosedTwoForm ℝ (Ambient n) M eta)
      (classOfClosedTwoForm ℝ (Ambient n) M eta) : ℂ) =
      (scale I : ℂ) * beauvilleQuadratic n M C A hpos
        (chosenHyperkahler n M I).symplectic.form eta.val
  fujikiConstant : ℚ
  fujikiPositive : 0 < fujikiConstant
  fujiki : ∀ eta : closedForms ℝ (Ambient n) M 2,
    topPowerIntegral n M C A eta.val = (fujikiConstant : ℝ) *
      (pair (classOfClosedTwoForm ℝ (Ambient n) M eta)
        (classOfClosedTwoForm ℝ (Ambient n) M eta)) ^ n

def complexPair {hpos : 0 < n} (Q : BBFForm n M C A R B hpos) :
    LinearMap.BilinForm ℂ (ComplexH2 n M) := Q.pair.baseChange ℂ

def conjugateClass : ComplexH2 n M →ₗ[ℝ] ComplexH2 n M :=
  TensorProduct.map Complex.conjAe.toLinearMap LinearMap.id

omit [IsManifold 𝓘(ℂ, Ambient n) ∞ M] [WedgeTheory (2 * n) M]
  [LocalExteriorTheory n M] [IntegerCoefficientTheory M] in
@[simp] theorem conjugateClass_tmul (z : ℂ) (x : RealH2 n M) :
    conjugateClass n M (TensorProduct.tmul ℝ z x) = TensorProduct.tmul ℝ (star z) x := by
  simp [conjugateClass]

structure Marking {hpos : 0 < n} (Q : BBFForm n M C A R B hpos)
    (L : Type*) [AddCommGroup L] [Module ℤ L] (q : LinearMap.BilinForm ℤ L) where
  integral : IntegralSecond M ≃ₗ[ℤ] L
  isometry : ∀ x y, q (integral x) (integral y) = Q.integerPair x y

/-- Native scalar-tensor extension of an actual integral marking. -/
def complexMarking {hpos : 0 < n} {Q : BBFForm n M C A R B hpos}
    (J : IntegralRealComparison n M R B) (L : Type*) [AddCommGroup L] [Module ℤ L]
    (q : LinearMap.BilinForm ℤ L) (m : Marking n M C A R B Q L q) :
    ComplexH2 n M ≃ₗ[ℂ] (ℂ ⊗[ℤ] L) :=
  (J.equiv.baseChange ℝ ℂ _ _).symm ≪≫ₗ
    TensorProduct.AlgebraTensorModule.cancelBaseChange ℤ ℝ ℂ ℂ (IntegralSecond M) ≪≫ₗ
      m.integral.baseChange ℤ ℂ _ _

def markedSymplecticClass {hpos : 0 < n} {Q : BBFForm n M C A R B hpos}
    (J : IntegralRealComparison n M R B) (L : Type*) [AddCommGroup L] [Module ℤ L]
    (q : LinearMap.BilinForm ℤ L) (m : Marking n M C A R B Q L q)
    (I : HyperkahlerStructures n M) : ℂ ⊗[ℤ] L :=
  complexMarking n M C A R B J L q m (symplecticClass n M I)

end MathlibExt.AlgebraicGeometry.BeauvilleBogomolovForms
