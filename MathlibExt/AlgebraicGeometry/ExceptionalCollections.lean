module

public import MathlibExt.CategoryTheory.Triangulated.ExceptionalGeneration
public import MathlibExt.AlgebraicGeometry.SphericalTwists

/-!
# Actual exceptional collections and their completed geometric generation consequence

The objects lie in the actual derived category of scheme modules. Scalar
endomorphisms use the canonical base-ring action, and exceptionality means
that this actual scalar map is bijective, with all other self-Hom degrees
zero. The generated category is the literal intersection of all strictly
full triangulated subcategories containing the objects.

The strong-generation implication from weak Hom detection and finite total
Hom is the complete public Axiom theorem port, specialized here to actual
scheme derived objects and the actual bounded coherent property. Generic
admissibility/projection and the full projective-space Beilinson equivalence
are positively complete elsewhere in the public source, not new requests.

Source: Stacks Project Tag0FYB; AxiomMath/Stacks, revision
c496df0d9beea9deaeabcea8492605f9a0a2313b,
CategoryTheory/Triangulated/ExceptionalCollectionFiniteness.lean and
AlgebraicGeometry/ProjectiveSpace/ExampleGenerator/BeilinsonEquivalence.lean.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.ExceptionalCollections

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open _root_.AlgebraicGeometry
open FourierMukai SchemeModuleLinear SphericalTwists

attribute [local instance] HasDerivedCategory.standard

universe u

variable (k : Type u) [Field k] (X : Over (Spec (.of k)))

local instance : Linear k X.left.Modules := modulesLinear k X

/-- The actual scalar endomorphism map; its bijectivity rules out the zero object. -/
def scalarEnd (E : D X.left) : k →ₗ[k] (E ⟶ E) where
  toFun c := c • 𝟙 E
  map_add' _ _ := add_smul _ _ _
  map_smul' _ _ := mul_smul _ _ _

/-- Exceptionality on the actual derived carrier, with the scalar map pinned. -/
def IsExceptional (E : D X.left) : Prop :=
  Function.Bijective (scalarEnd k X E) ∧
    ∀ n : ℤ, n ≠ 0 → Subsingleton (E ⟶ E⟦n⟧)

/-- The actual strictly full triangulated category generated by a finite object family. -/
def generatedBy {r : ℕ} (G : Fin r → D X.left) : ObjectProperty (D X.left) := fun M ↦
  ∀ P : ObjectProperty (D X.left), P.IsTriangulated → P.IsClosedUnderIsomorphisms →
    (∀ a, P (G a)) → P M

/-- Weak detection by actual graded Hom, not an assumed triangulated generation conclusion. -/
def WeaklyDetects {r : ℕ} (G : Fin r → D X.left) : Prop :=
  ∀ M : D X.left, boundedCoherent X.left M →
    (∀ a (n : ℤ), Subsingleton (G a ⟶ M⟦n⟧)) → IsZero M

/-- The source-proved finite-Hom exceptional-generation theorem on actual scheme objects. -/
theorem exceptional_generation {r : ℕ} (G : Fin r → D X.left)
    (hExc : ∀ a, IsExceptional k X (G a))
    (hSemi : ∀ a b : Fin r, a < b → ∀ n : ℤ, Subsingleton (G b ⟶ (G a)⟦n⟧))
    (hFin : ∀ a b : Fin r, a < b → HasFiniteTotalHom k (G a) (G b))
    [(boundedCoherent X.left).IsTriangulated]
    [(boundedCoherent X.left).IsClosedUnderIsomorphisms]
    (hG : ∀ a, boundedCoherent X.left (G a)) (hDetect : WeaklyDetects k X G)
    (M : D X.left) (hM : boundedCoherent X.left M)
    (hHom : ∀ a, HasFiniteTotalHom k (G a) M) : generatedBy k X G M := by
  intro P hP hPIso hPG
  let := hP
  let := hPIso
  apply prop_of_hasFiniteTotalHom_of_exceptional k G
    (fun a e ↦ by
      obtain ⟨c, hc⟩ := (hExc a).1.2 e
      exact ⟨c, hc.symm⟩) (fun a ↦ (hExc a).2) hSemi hFin
    (boundedCoherent X.left) hG hDetect P hPG M hM hHom

end MathlibExt.AlgebraicGeometry.ExceptionalCollections
