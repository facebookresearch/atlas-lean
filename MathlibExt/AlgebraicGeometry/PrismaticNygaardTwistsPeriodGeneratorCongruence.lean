module

public import MathlibExt.AlgebraicGeometry.PrismaticPeriodFrames

import Mathlib.Algebra.Ring.GeomSum

/-!
# Period generator congruence

The cyclotomic period generator satisfies the congruence modulo the successive
Frobenius ideal products.

References: Bhatt--Morrow--Scholze, *Topological Hochschild homology and integral p-adic Hodge
theory*, arXiv:1802.03261v2, Theorem 1.12(3)--(5), Proposition 6.5, Remark 6.6 and Section 7.4;
Bhatt--Morrow--Scholze, *Integral p-adic Hodge theory*, arXiv:1602.03148v3, Example 4.24;
Bhatt--Scholze, *Prisms and prismatic cohomology*, arXiv:1905.08229v4, Theorems 1.12--1.14.
-/

@[expose] public noncomputable section

namespace WantedExt.AlgebraicGeometry.PrismaticNygaardTwists

open MathlibExt.RingTheory MathlibExt.RingTheory.BoundedPrisms
open MathlibExt.AlgebraicGeometry.PrismaticBreuilKisinSeeds
open MathlibExt.AlgebraicGeometry.PrismaticPeriodFrames
open scoped BigOperators

private theorem frobenius_xi
    (p : ℕ) [Fact p.Prime] (P : Prism.{0} p)
    (hPerfect : Function.Bijective (DeltaRing.frobenius p P.ring)) (epsilon : P.ring) :
    DeltaRing.frobenius p P.ring (xi p P hPerfect epsilon) =
      ∑ k ∈ Finset.range p, epsilon ^ k := by
  rw [xi, RingHom.map_geom_sum]
  have hphi : DeltaRing.frobenius p P.ring (inversePhi p P hPerfect epsilon) = epsilon :=
    (RingEquiv.ofBijective (DeltaRing.frobenius p P.ring) hPerfect).apply_symm_apply epsilon
  rw [hphi]

private theorem phiPower_xi
    (p : ℕ) [Fact p.Prime] (P : Prism.{0} p)
    (hPerfect : Function.Bijective (DeltaRing.frobenius p P.ring)) (epsilon : P.ring)
    (n : ℕ) :
    phiPower p P (n + 1) (xi p P hPerfect epsilon) =
      ∑ k ∈ Finset.range p, (phiPower p P n epsilon) ^ k := by
  induction n with
  | zero =>
    simpa only [phiPower, RingHom.comp_apply, RingHom.id_apply] using
      frobenius_xi p P hPerfect epsilon
  | succ n ih =>
    simpa only [phiPower, RingHom.comp_apply, map_sum, map_pow] using
      congrArg (DeltaRing.frobenius p P.ring) ih

/-- Let $p$ be a prime, $(P, I)$ a perfect prism and $\varepsilon \in P$ a unit with
$\varphi(\varepsilon) = \varepsilon^p$ and $\varepsilon \equiv 1 \pmod I$, such that $I$ is
generated by $\xi = \sum_{k < p} \varphi^{-1}(\varepsilon)^k$. Then
$\varphi^{n+2}(\xi) - p \in \varphi(I)\varphi^2(I) \cdots \varphi^{n+1}(I)$ for every $n \ge 0$. -/
public theorem periodGeneratorCongruence
    (p : ℕ) [Fact p.Prime] (P : Prism.{0} p)
    (hPerfect : Function.Bijective (DeltaRing.frobenius p P.ring))
    (epsilon : P.ring) (hUnit : IsUnit epsilon)
    (hTeichmuller : DeltaRing.frobenius p P.ring epsilon = epsilon ^ p)
    (hTheta : Ideal.Quotient.mk P.ideal epsilon = 1)
    (hIdeal : P.ideal = Ideal.span {xi p P hPerfect epsilon}) :
    ∀ n : ℕ, phiPower p P (n + 2) (xi p P hPerfect epsilon) - (p : P.ring) ∈ periodIdeal p P n
    := by
  obtain ⟨epsilon, rfl⟩ := hUnit
  have hepsilon : (epsilon : P.ring) - 1 ∈ P.ideal := Ideal.Quotient.eq_zero_iff_mem.mp (by
    simp only [map_sub, map_one, hTheta, sub_self])
  have hxi : xi p P hPerfect epsilon ∈ P.ideal := by
    rw [hIdeal]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hgeom (n : ℕ) :
      phiPower p P (n + 1) epsilon - 1 =
        (phiPower p P n epsilon - 1) * phiPower p P (n + 1) (xi p P hPerfect epsilon) := by
    induction n with
    | zero =>
      change DeltaRing.frobenius p P.ring epsilon - 1 =
        ((epsilon : P.ring) - 1) * DeltaRing.frobenius p P.ring (xi p P hPerfect epsilon)
      rw [hTeichmuller, frobenius_xi, mul_geom_sum]
    | succ n ih =>
      simpa only [phiPower, RingHom.comp_apply, map_sub, map_one, map_mul] using
        congrArg (DeltaRing.frobenius p P.ring) ih
  have hmem (n : ℕ) : phiPower p P (n + 1) epsilon - 1 ∈ periodIdeal p P n := by
    induction n with
    | zero =>
      simpa only [periodIdeal, map_sub, map_one] using
        Ideal.mem_map_of_mem (phiPower p P 1) hepsilon
    | succ n ih =>
      rw [hgeom]
      exact Ideal.mul_mem_mul ih (Ideal.mem_map_of_mem _ hxi)
  intro n
  rw [phiPower_xi p P hPerfect epsilon (n + 1)]
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have hepsilon : Ideal.Quotient.mk (periodIdeal p P n) (phiPower p P (n + 1) epsilon) = 1 :=
    sub_eq_zero.mp (by
      simpa only [map_sub, map_one] using Ideal.Quotient.eq_zero_iff_mem.mpr (hmem n))
  simp [map_sum, hepsilon]

end WantedExt.AlgebraicGeometry.PrismaticNygaardTwists
