module

public import Mathlib.Topology.Algebra.Group.Subgroup
public import Mathlib.Topology.Algebra.Group.Units
public import Mathlib.Topology.Algebra.MulAction
public import Mathlib.LinearAlgebra.Basis.Basic
public import MathlibExt.AlgebraicGeometry.CoxNormalizedSheafification
public import MathlibExt.AlgebraicGeometry.ComplexAnalytification

/-!
# Analytic Cox coordinates on the shared toric charts

The fan, its rays, the toric charts `Spec ℂ[σ∨ ∩ M]` and their realization are
those of `FiniteToricCoordinates` and `CoxGradedSheaves`, used by every Cox
module. A smooth fan has every cone generated by part of a lattice basis,
namely the generators of its rays.

The Cox open consists of complex coordinate tuples whose zero coordinates are
contained in some cone. The Cox group is the actual kernel of the ray-matrix
character homomorphism on complex unit tori. Its coordinate action and
continuity are proved. The orbit quotient has its actual quotient topology.
The uniformization is normalized against every literal ray-pairing monomial
and actual complex point of every chart; coefficient scalars are fixed by the
charts' maps over `Spec ℂ`.

Reference: D. Cox, *The homogeneous coordinate ring of a toric variety*,
https://arxiv.org/abs/alg-geom/9210008v3, §2, Theorem 2.1(ii--iii),
Lemmas 2.2--2.3, pp.5--9, including the stated analytic version.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.ToricCoxCoordinates

open _root_.CategoryTheory _root_.AlgebraicGeometry
open MathlibExt.AlgebraicGeometry.ComplexAnalytification
open MathlibExt.AlgebraicGeometry.FiniteToricCoordinates
open MathlibExt.AlgebraicGeometry.CoxGradedSheaves
open MathlibExt.AlgebraicGeometry.CoxNormalizedSheafification
open scoped BigOperators

variable {n : ℕ} {F : FiniteFan n} (R : Rays F)

/-- Every cone is generated by the generators of its rays, which are part of a
lattice basis, and the fan covers the whole space. -/
structure SmoothComplete : Prop where
  smooth : ∀ σ ∈ F.cones,
    (∃ b : Module.Basis (Fin n) ℤ (Lattice n),
      ∃ e : {i // rayInCone R σ i} → Fin n, Function.Injective e ∧
        ∀ i, R.generator i.val = b (e i)) ∧
    σ = PointedCone.hull ℝ (latticeCast n '' {v | ∃ i, rayInCone R σ i ∧ R.generator i = v})
  complete : F.IsComplete

def coxLocus : Set (Fin R.count → ℂ) :=
  {z | ∃ σ ∈ F.cones, ∀ i, ¬rayInCone R σ i → z i ≠ 0}

abbrev CoxOpen := {z : Fin R.count → ℂ // z ∈ coxLocus R}

def characterHom : (Fin R.count → ℂˣ) →* (Fin n → ℂˣ) where
  toFun g j := ∏ i, g i ^ (R.generator i j)
  map_one' := by funext j; simp
  map_mul' g h := by funext j; simp [Pi.mul_apply, mul_zpow, Finset.prod_mul_distrib]

abbrev CoxGroup := (characterHom R).ker

instance coxAction : MulAction (CoxGroup R) (CoxOpen R) where
  smul g z := ⟨fun i => (g.val i : ℂ) * z.val i, by
    obtain ⟨σ, hσ, hz⟩ := z.property
    exact ⟨σ, hσ, fun i hi => mul_ne_zero (Units.ne_zero (g.val i)) (hz i hi)⟩⟩
  one_smul z := by
    apply Subtype.ext
    funext i
    change (1 : ℂ) * z.val i = z.val i
    exact one_mul _
  mul_smul g h z := by
    apply Subtype.ext
    funext i
    change ((g.val i * h.val i : ℂˣ) : ℂ) * z.val i =
      (g.val i : ℂ) * ((h.val i : ℂ) * z.val i)
    simp [mul_assoc]

instance continuousCoxAction : ContinuousSMul (CoxGroup R) (CoxOpen R) where
  continuous_smul := by
    apply Continuous.subtype_mk
    apply continuous_pi
    intro i
    have hg : Continuous (fun p : CoxGroup R × CoxOpen R => p.1.val i) :=
      (continuous_apply i).comp (continuous_subtype_val.comp continuous_fst)
    have hz : Continuous (fun p : CoxGroup R × CoxOpen R => p.2.val i) :=
      (continuous_apply i).comp (continuous_subtype_val.comp continuous_snd)
    exact (Units.continuous_val.comp hg).mul hz

abbrev CoxQuotient := Quotient (MulAction.orbitRel (CoxGroup R) (CoxOpen R))

def coxMonomial (z : CoxOpen R) (u : Lattice n) : ℂ :=
  ∏ i, z.val i ^ (rayPairing R u i)

/-- The value of the character `u` at a complex point of the chart of `σ`. -/
def characterValue (σ : Cone n) (u : dualSemigroup σ) (p : space (affineChart ℂ σ)) : ℂ :=
  ComplexPoints.eval
    ((Scheme.ΓSpecIso (.of (CoordinateRing ℂ σ))).inv (AddMonoidAlgebra.single u (1 : ℂ))) p
    (by simp [ComplexPoints.Mem])

/-- The Cox uniformization target is an actual orbit-space homeomorphism,
normalized on every monomial and every eligible affine chart of the realization. -/
structure CoxUniformization (T : Realization ℂ F) where
  homeomorphism : CoxQuotient R ≃ₜ space T.scheme
  normalization : ∀ (z : CoxOpen R) (σ : F.Face)
      (_inChart : ∀ i, ¬rayInCone R σ.val i → z.val i ≠ 0),
    ∃ p : space (affineChart ℂ σ.val),
      homeomorphism (Quotient.mk'' z) = spaceMap (T.chartMap σ) p ∧
      ∀ u : dualSemigroup σ.val, characterValue σ.val u p = coxMonomial R z u.val

end MathlibExt.AlgebraicGeometry.ToricCoxCoordinates
