/-!
# Actual numerical monoid and open/closed Hall grading components

The numerical classes are the actual integral Euler profiles of
coherent sheaves. The monoid is generated by those actual classes.
Every family-component predicate tests all algebraically closed
coefficient fields and all geometric parameter maps, including
families with no complex-valued points on their parameter scheme.

The component stack is the full cut by that predicate. The grading
projection is the actual two-fibre restriction of every generator
to that open/closed component, then quotient descent.

Reference: Bridgeland, arXiv:1002.4374v3, §2.1, equation (24), §5.2.
The Calabi–Yau scope below retains the source's H^1(O_X)=0 assumption
and the actual trivialization of the algebraic top-form sheaf.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.HallNumericalGradingModels

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.Opposite
open _root_.AlgebraicGeometry
open CoherentCurveLinearSeries AlgebraicBundleGeometry
open ProjectiveLineSystems
open GeometricHallStackFunctions HallFamilyStackModels HallConvolutionOperations
open HallSemiclassicalOperations HallExactSequenceFamilies
open StablePairFamilies StablePairParameterPullbacks StackCycleGeometry StackFibreModels

variable (X : Over (Spec (.of ℂ)))

/-- Smooth projective CY3 retains the actual canonical-line trivialization and H^1(O)=0. -/
structure CalabiYauThreefold extends Threefold X where
  canonical : AlgebraicDifferentialSheaves.forms ℂ X 3 ≅ structureModule X.left
  h1_zero : IsZero (cohomology X.hom (structureModule X.left) 1)

/-- The native product projection is invertible at the actual base point. -/
def pointProjection : StablePairFamilies.total X complexPoint ⟶ X.left :=
  pullback.fst X.hom (𝟙 (Spec (.of ℂ)))

instance pointProjection_isIso : IsIso (pointProjection X) := by
  dsimp [pointProjection]
  infer_instance

/-- Read the actual absolute sheaf of a complex-valued family. -/
def pointSheaf (F : HallExactSequenceFamilies.Family X complexPoint) : X.left.Modules :=
  (Scheme.Modules.pullback (inv (pointProjection X))).obj F.module

/-- Only proofs of the native numerical membership and product-point properties are supplied. -/
structure NumericalData (HX : Threefold X) where
  membership : ∀ F : CoherentObject X, sheafCurveDegrees X HX F ∈ CurveLattice X
  pointProperties : ∀ F : HallExactSequenceFamilies.Family X complexPoint,
    StablePairFamilies.coherent (pointSheaf X F) ∧ supportDimension (pointSheaf X F) ≤ (1 : ℕ)

variable {X}

def actualClass {HX : Threefold X} (N : NumericalData X HX) (F : CoherentObject X) :
    CurveLattice X × ℤ := numericalClass X HX F (N.membership F)

/-- The effective numerical monoid is generated by classes of actual coherent objects. -/
def numericalMonoid {HX : Threefold X} (N : NumericalData X HX) :
    AddSubmonoid (CurveLattice X × ℤ) := AddSubmonoid.closure (Set.range (actualClass N))

abbrev Delta {HX : Threefold X} (N : NumericalData X HX) := numericalMonoid N

def objectClass {HX : Threefold X} (N : NumericalData X HX) (F : CoherentObject X) : Delta N :=
  ⟨actualClass N F,AddSubmonoid.subset_closure ⟨F,rfl⟩⟩

def familyClass {HX : Threefold X} (N : NumericalData X HX)
    (F : HallExactSequenceFamilies.Family X complexPoint) : Delta N :=
  objectClass N ⟨pointSheaf X F,N.pointProperties F⟩

/-- The actual complex numerical monoid algebra with its native multiplication. -/
abbrev NumericalAlgebra {HX : Threefold X} (N : NumericalData X HX) := AddMonoidAlgebra ℂ (Delta N)

variable (X)

def geometricModule {T : Over (Spec (.of ℂ))} (F : HallExactSequenceFamilies.Family X T)
    (Ω : Type) [Field Ω] [IsAlgClosed Ω] [Algebra ℂ Ω] (p : geometricParameter Ω ⟶ T) :
    (StablePairFamilies.total X (geometricParameter Ω)).Modules :=
  (Scheme.Modules.pullback (productMap X p)).obj F.module

/-- The two-term difference `dim H⁰ - dim H¹` over the geometric coefficient field, computed for
any module. It is the Euler characteristic only when the cohomology is finite-dimensional and
vanishes in degrees at least two, e.g. for coherent sheaves supported in dimension at most one on
the proper threefold (the sheaves of the Hall category, `FamilyClass`). -/
def twoTermEuler (Ω : Type) [Field Ω] [Algebra ℂ Ω]
    (F : (StablePairFamilies.total X (geometricParameter Ω)).Modules) : ℤ :=
  (Module.finrank Ω (cohomology (projection X (geometricParameter Ω)) F 0) : ℤ) -
    Module.finrank Ω (cohomology (projection X (geometricParameter Ω)) F 1)

/-- The two-term curve profile `L ↦ twoTermEuler (F ⊗ L) - twoTermEuler F`. For a coherent sheaf
`F` supported in dimension at most one (the sheaves of the Hall category) this is the degree
profile of its curve class; vanishing of the higher cohomology of `F` and `F ⊗ L` alone does not
suffice (for the structure sheaf of a plane in `ℙ³` the values at `𝒪(1)` and `𝒪(2)` are 2 and 5,
which is not additive). -/
def twoTermCurveProfile (Ω : Type) [Field Ω] [Algebra ℂ Ω]
    (F : (StablePairFamilies.total X (geometricParameter Ω)).Modules) : LineBundle X.left → ℤ :=
  fun L => twoTermEuler X Ω
    (AlgebraicLineBundleFamilies.moduleTensor (StablePairFamilies.total X (geometricParameter Ω)) F
      ((Scheme.Modules.pullback (pullback.fst X.hom (geometricParameter Ω).hom)).obj L.val)) -
    twoTermEuler X Ω F

variable {X}

/-- A family lies in C_α on all geometric tests, not only on C-valued parameters. -/
def FamilyClass {HX : Threefold X} {N : NumericalData X HX} (α : Delta N)
    {T : Over (Spec (.of ℂ))} (F : HallExactSequenceFamilies.Family X T) : Prop :=
  ∀ (Ω : Type) [Field Ω] [IsAlgClosed Ω] [Algebra ℂ Ω] (p : geometricParameter Ω ⟶ T),
    (twoTermCurveProfile X Ω (geometricModule X F Ω p),
      twoTermEuler X Ω (geometricModule X F Ω p)) = (α.val.1.val,α.val.2)

/-- The component is a genuine open/closed full family cut of the actual moduli stack. -/
structure NumericalComponent {HX : Threefold X} (N : NumericalData X HX)
    (H : HallStacks X) (α : Delta N) where
  carrier : LocallyFiniteTypeStack
  inclusion : StackHom carrier.stack H.moduli
  fullyFaithful : ∀ T : Over (Spec (.of ℂ)), (component inclusion T).FullyFaithful
  image : ∀ (T : Over (Spec (.of ℂ))) (F : H.moduli.Fibre T),
    (∃ q : carrier.stack.Fibre T, Nonempty ((component inclusion T).obj q ≅ F)) ↔
      FamilyClass α ((H.families.fibre T).functor.obj F)
  fibre : ∀ (T : Over (Spec (.of ℂ))) (F : H.moduli.Fibre T), SchemeFibreModel inclusion T F
  openImmersion : ∀ (T : Over (Spec (.of ℂ))) (F : H.moduli.Fibre T),
    IsOpenImmersion (fibre T F).scheme.hom
  closed : ∀ (T : Over (Spec (.of ℂ))) (F : H.moduli.Fibre T),
    IsClosedImmersion (fibre T F).scheme.hom

/-- A homogeneous regular generator has its actual factorization through C_α. -/
structure HomogeneousGenerator {HX : Threefold X} {N : NumericalData X HX}
    {H : HallStacks X} {α : Delta N} (C : NumericalComponent N H α)
    (g : Generator H.moduli) where
  factor : StackHom g.source.stack C.carrier.stack
  normalized : StackVectorBundles.TwoIso
    (Pseudofunctor.StrongTrans.vcomp factor C.inclusion) g.map

def restrictedGenerator {HX : Threefold X} {N : NumericalData X HX}
    {H : HallStacks X} {α : Delta N} {C : NumericalComponent N H α}
    {g : Generator H.moduli} (D : FiniteTwoFibreModel g.map C.inclusion) : Generator H.moduli :=
  ⟨D.source,Pseudofunctor.StrongTrans.vcomp D.fst g.map⟩

def rawProjection {HX : Threefold X} {N : NumericalData X HX}
    {H : HallStacks X} {α : Delta N} {C : NumericalComponent N H α}
    (D : ∀ g : Generator H.moduli, FiniteTwoFibreModel g.map C.inclusion) :
    StagedFormal H.moduli →ₗ[ℂ] LefschetzStackFunctions H.moduli :=
  Finsupp.linearCombination ℂ (fun a => stageSymbol (restrictedGenerator (D a.1)) a.2)

def ProjectionDescent {HX : Threefold X} {N : NumericalData X HX}
    {H : HallStacks X} {α : Delta N} {C : NumericalComponent N H α}
    (D : ∀ g : Generator H.moduli, FiniteTwoFibreModel g.map C.inclusion) : Prop :=
  stagedRelations H.moduli ≤ (rawProjection D).ker

def numericalProjection {HX : Threefold X} {N : NumericalData X HX}
    {H : HallStacks X} {α : Delta N} {C : NumericalComponent N H α}
    {D : ∀ g : Generator H.moduli, FiniteTwoFibreModel g.map C.inclusion}
    (h : ProjectionDescent D) : LefschetzStackFunctions H.moduli →ₗ[ℂ]
      LefschetzStackFunctions H.moduli := (stagedRelations H.moduli).liftQ (rawProjection D) h

/-- All projection maps are computed from their actual component two-fibres. -/
structure NumericalProjectionData {HX : Threefold X} (N : NumericalData X HX) (H : HallStacks X) where
  component : ∀ α : Delta N, NumericalComponent N H α
  restriction : ∀ (α : Delta N) (g : Generator H.moduli),
    FiniteTwoFibreModel g.map (component α).inclusion
  descent : ∀ α : Delta N, ProjectionDescent (restriction α)

def NumericalProjectionData.projection {HX : Threefold X} {N : NumericalData X HX}
    {H : HallStacks X} (P : NumericalProjectionData N H) (α : Delta N) :=
  numericalProjection (P.descent α)

end MathlibExt.AlgebraicGeometry.HallNumericalGradingModels
