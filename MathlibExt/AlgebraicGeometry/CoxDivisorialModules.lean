module

public import MathlibExt.AlgebraicGeometry.CoxNormalizedSheafification
public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Order.SupIndep
public import Mathlib.Algebra.Homology.ShortComplex.Exact

/-!
# Cox shifts and the actual toric divisorial chart modules

An invariant divisor is its integer coefficient on every enumerated ray.
The local divisorial module is the submodule of the actual lattice group
algebra generated by characters satisfying <m,n_rho> >= -a_rho on the cone.
Thus it is defined independently of Cox sheafification. The Cox shift uses
S(alpha)_beta = S_(alpha+beta). Its comparison sends each admissible character
to the literal shifted polynomial fraction, for every allowed denominator.

The global divisorial sheaf is pinned on the whole affine cover and its face
restrictions. Neither its construction nor the shift comparison assumes
Cartier invertibility. They are separate normalized construction requests.

Reference: Cox, alg-geom/9210008v3, Proposition 3.1 and formula (5), pp11–12.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.CoxDivisorialModules

open CategoryTheory _root_.AlgebraicGeometry FiniteToricCoordinates CoxGradedSheaves
  CoxNormalizedSheafification

variable {n : ℕ} {F : FiniteFan n} (R : Rays F)

abbrev InvariantDivisor := Fin R.count → ℤ

def divisorClass (D : InvariantDivisor R) : DegreeGroup R :=
  QuotientAddGroup.mk' (characterRayMap R).range D

/-- The shifted Cox polynomial module has the source's literal grading. -/
def shiftedPolynomial (α : DegreeGroup R) : GradedModule R := by
  classical
  letI : DecidableEq (DegreeGroup R) := Classical.decEq _
  let pieces : DegreeGroup R → Submodule ℂ (CoxRing R) :=
    fun β ↦ homogeneous R (α + β)
  letI : DirectSum.Decomposition (homogeneous R) := coxDecomposition R
  have h : DirectSum.IsInternal pieces := by
    apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    · exact (DirectSum.Decomposition.isInternal (homogeneous R)).submodule_iSupIndep.comp
        (Equiv.addLeft α).injective
    · change (⨆ β, homogeneous R (Equiv.addLeft α β)) = ⊤
      rw [Equiv.iSup_comp (Equiv.addLeft α)]
      exact (DirectSum.Decomposition.isInternal (homogeneous R)).submodule_iSup_eq_top
  exact
    { object := ModuleCat.of (CoxRing R) (CoxRing R)
      piece := fun β ↦ (pieces β).toAddSubgroup
      decomposition :=
        { decompose' := h.chooseDecomposition.decompose'
          left_inv := h.chooseDecomposition.left_inv
          right_inv := h.chooseDecomposition.right_inv }
      graded_smul := by
        intro a b p hp x hx
        change p * x ∈ homogeneous R (α + (a + b))
        have hm := MvPolynomial.IsWeightedHomogeneous.mul hp hx
        simpa [add_assoc, add_left_comm] using hm }

abbrev LaurentRing := AddMonoidAlgebra ℂ (Lattice n)

def chartLaurentMap (σ : Cone n) : CoordinateRing ℂ σ →ₐ[ℂ] LaurentRing (n := n) :=
  AddMonoidAlgebra.mapDomainAlgHom ℂ ℂ (dualSemigroup σ).subtype

instance chartLaurentModule (σ : Cone n) :
    Module (CoordinateRing ℂ σ) (LaurentRing (n := n)) :=
  Module.compHom _ (chartLaurentMap σ).toRingHom

def AdmissibleCharacter (σ : Cone n) (D : InvariantDivisor R) (u : Lattice n) : Prop :=
  ∀ i, rayInCone R σ i → 0 ≤ rayPairing R u i + D i

/-- The actual local sections of the toric reflexive divisorial sheaf. -/
def divisorModule (σ : Cone n) (D : InvariantDivisor R) :
    Submodule (CoordinateRing ℂ σ) (LaurentRing (n := n)) :=
  Submodule.span _ {v | ∃ u : Lattice n, AdmissibleCharacter R σ D u ∧
    v = AddMonoidAlgebra.single u 1}

def divisorCharacter (σ : Cone n) (D : InvariantDivisor R) (u : Lattice n)
    (h : AdmissibleCharacter R σ D u) : divisorModule R σ D :=
  ⟨AddMonoidAlgebra.single u 1, Submodule.subset_span ⟨u, h, rfl⟩⟩

def divisorSheaf (σ : F.Face) (D : InvariantDivisor R) :
    (affineChart ℂ σ.val).left.Modules :=
  tilde (ModuleCat.of (CoordinateRing ℂ σ.val) (divisorModule R σ.val D))

def divisorSection (σ : F.Face) (D : InvariantDivisor R)
    (v : divisorModule R σ.val D) : Γ(divisorSheaf R σ D, ⊤) :=
  (tilde.toOpen (R := CommRingCat.of (CoordinateRing ℂ σ.val))
    (ModuleCat.of (CoordinateRing ℂ σ.val) (divisorModule R σ.val D)) ⊤).hom v

/-- The genuine face restriction has the identity underlying Laurent function. -/
structure DivisorFaceMap (σ τ : F.Face) (h : τ.val.IsFaceOf σ.val)
    (D : InvariantDivisor R) where
  map : divisorModule R σ.val D →ₛₗ[(faceRingMap ℂ h).toRingHom]
    divisorModule R τ.val D
  normalized : ∀ v, (map v).val = v.val
  iso : (Scheme.Modules.pullback (faceMap ℂ h).left).obj (divisorSheaf R σ D) ≅
    divisorSheaf R τ D
  sections : ∀ v : divisorModule R σ.val D,
    ((Scheme.Modules.pullbackPushforwardAdjunction (faceMap ℂ h).left).unit.app
        (divisorSheaf R σ D) ≫
      (Scheme.Modules.pushforward (faceMap ℂ h).left).map iso.hom).app ⊤
        (divisorSection R σ D v) = divisorSection R τ D (map v)

/-- Global O(D), characterized independently by actual Laurent chart sections. -/
structure DivisorialSheaf (T : Realization ℂ F) (D : InvariantDivisor R) where
  sheaf : T.scheme.left.Modules
  localIso : ∀ σ : F.Face,
    (Scheme.Modules.pullback (T.chartMap σ).left).obj sheaf ≅ divisorSheaf R σ D
  face : ∀ (σ τ : F.Face) (h : τ.val.IsFaceOf σ.val), DivisorFaceMap R σ τ h D
  compatible : ∀ (σ τ : F.Face) (h : τ.val.IsFaceOf σ.val),
    (Scheme.Modules.pullback (faceMap ℂ h).left).map (localIso σ).hom ≫
      (face σ τ h).iso.hom =
        (globalFaceIso T σ τ h sheaf).hom ≫ (localIso τ).hom
  quasicoherent : sheaf.IsQuasicoherent

def AdmissibleDenominator (σ : Cone n) (D : InvariantDivisor R)
    (u : Lattice n) (a : ℕ) : Prop := by
  classical
  exact ∀ i, 0 ≤ rayPairing R u i + D i + if rayInCone R σ i then 0 else (a : ℤ)

def shiftedNumerator (σ : Cone n) (D : InvariantDivisor R)
    (u : Lattice n) (a : ℕ) : CoxRing R := by
  classical
  exact MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm fun i ↦
    (rayPairing R u i + D i + if rayInCone R σ i then 0 else (a : ℤ)).toNat) 1

def shiftedChartModule (C : ChartComparison R) (σ : F.Face)
    (D : InvariantDivisor R) : ModuleCat (CoordinateRing ℂ σ.val) :=
  (ModuleCat.restrictScalars (C.iso σ).toRingHom).obj
    (ModuleCat.of (degreeZeroAlgebra R σ.val)
      (degreeZeroModule R σ.val (shiftedPolynomial R (divisorClass R D))))

/-- The comparison is fixed on every character and every admissible fraction.
The affine sheaf map is fixed by its actual tilde global sections. -/
structure ShiftChartComparison (C : ChartComparison R) (σ : F.Face)
    (D : InvariantDivisor R) where
  moduleIso : divisorModule R σ.val D ≃ₗ[CoordinateRing ℂ σ.val]
    shiftedChartModule R C σ D
  character : ∀ (u : Lattice n) (h : AdmissibleCharacter R σ.val D u) (a : ℕ),
    AdmissibleDenominator R σ.val D u a →
      (moduleIso (divisorCharacter R σ.val D u h)).val =
        LocalizedModule.mk (shiftedNumerator R σ.val D u a) (denominatorPower R σ.val a)
  sheafIso : divisorSheaf R σ D ≅
    localSheaf R C σ (shiftedPolynomial R (divisorClass R D))
  sections : ∀ v : divisorModule R σ.val D,
    sheafIso.hom.app ⊤ (divisorSection R σ D v) =
      localSection R C σ (shiftedPolynomial R (divisorClass R D)) (moduleIso v)

end MathlibExt.AlgebraicGeometry.CoxDivisorialModules
