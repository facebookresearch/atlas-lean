module

public import Mathlib.AlgebraicGeometry.ResidueField
public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction
public import Mathlib.Analysis.Normed.Unbundled.RingSeminorm
public import Mathlib.Topology.Category.TopCat.Basic
public import Mathlib.Topology.Order.Basic
public import Mathlib.CategoryTheory.Comma.Over.Basic

/-!
# Actual valued points of algebraic Berkovich analytification

A point consists of an actual scheme point and a real absolute value on
its actual residue field, extending the norm of the ground field. The
topology is generated by evaluations of actual regular sections on actual
scheme opens. Scheme maps act through their actual residue-field maps.

This constructs the underlying topological realization and its maps.
An analytic structure sheaf, affinoid atlas and coherent comparison need
additional geometry, and are not asserted by the point construction.

Reference: Berkovich, *Spectral theory and analytic geometry over
non-Archimedean fields*, §§3.4–3.5; Zomervrucht, *Berkovich analytification*,
formula (2.3), p. 3, and Example 2.2, p. 2.
https://www.mi.fu-berlin.de/math/groups/arithmetic_geometry/research_seminar/documents/berkovich03.pdf
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace MathlibExt.AlgebraicGeometry.BerkovichAnalytification

open _root_.AlgebraicGeometry _root_.CategoryTheory Opposite

variable (K : Type) [NormedField K]

abbrev AlgebraicScheme := Over (Spec (CommRingCat.of.{0} K))

/-- The scalar map to an actual scheme-point residue field. -/
def scalarMap (X : AlgebraicScheme K) (x : X.left) :
    K →+* X.left.residueField x :=
  ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ X.hom.appTop ≫
    X.left.Γevaluation x).hom

/-- Real-valued analytic points, with their actual residue-field norm. -/
structure Point (X : AlgebraicScheme K) where
  schemePoint : X.left
  absoluteValue : AbsoluteValue (X.left.residueField schemePoint) ℝ
  ultrametric : ∀ a b, absoluteValue (a + b) ≤
    max (absoluteValue a) (absoluteValue b)
  extends_norm : ∀ a : K, absoluteValue (scalarMap K X schemePoint a) = ‖a‖

namespace Point

variable {K} {X : AlgebraicScheme K}

/-- Evaluate an actual regular section in the point's valued residue field. -/
def eval (p : Point K X) {U : X.left.Opens} (s : Γ(X.left, U))
    (hp : p.schemePoint ∈ U) : ℝ :=
  p.absoluteValue (X.left.evaluation U p.schemePoint hp s)

theorem eval_zero (p : Point K X) (U : X.left.Opens)
    (hp : p.schemePoint ∈ U) : p.eval (0 : Γ(X.left, U)) hp = 0 := by
  simp only [eval, map_zero]

end Point

variable (X : AlgebraicScheme K)

/-- A regular-evaluation inverse image, with its actual open domain. -/
def basicSet (U : X.left.Opens) (s : Γ(X.left, U)) (V : Set ℝ) :
    Set (Point K X) :=
  {p | ∃ hp : p.schemePoint ∈ U, p.eval s hp ∈ V}

/-- Generators of the weakest regular-evaluation topology. -/
def basicSets : Set (Set (Point K X)) :=
  {S | ∃ (U : X.left.Opens) (s : Γ(X.left, U)) (V : Set ℝ),
    IsOpen V ∧ S = basicSet K X U s V}

instance pointTopology : TopologicalSpace (Point K X) :=
  TopologicalSpace.generateFrom (basicSets K X)

/-- The actual underlying topological Berkovich realization. -/
def space : TopCat := TopCat.of (Point K X)

theorem isOpen_basicSet (U : X.left.Opens) (s : Γ(X.left, U))
    (V : Set ℝ) (hV : IsOpen V) : IsOpen (basicSet K X U s V) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨U, s, V, hV, rfl⟩

theorem isOpen_schemePreimage (U : X.left.Opens) :
    IsOpen {p : Point K X | p.schemePoint ∈ U} := by
  have h := isOpen_basicSet K X U 0 Set.univ isOpen_univ
  simpa only [basicSet, Set.mem_ofPred_eq, Set.mem_univ,
    and_true, exists_prop] using h

/-- The projection is an actual continuous map to the scheme space. -/
def projection : space K X ⟶ X.left.toRingedSpace.carrier :=
  TopCat.ofHom
  { toFun p := p.schemePoint
    continuous_toFun := by
      rw [continuous_def]
      intro U hU
      exact isOpen_schemePreimage K X ⟨U, hU⟩ }

variable {K X} {Y : AlgebraicScheme K}

/-- The pullback of a real absolute value `v` on a field `B` along a field homomorphism
`f : A →+* B`: the function `a ↦ v (f a)` on `A`, an absolute value since `f` is injective. -/
abbrev pullAbsoluteValue {A B : Type} [Field A] [Field B]
    (v : AbsoluteValue B ℝ) (f : A →+* B) : AbsoluteValue A ℝ :=
  v.comp f.injective

/-- The base-scalar maps commute through the actual residue-field map. -/
theorem scalarMap_naturality (f : X ⟶ Y) (x : X.left) (a : K) :
    f.left.residueFieldMap x (scalarMap K Y (f.left x) a) =
      scalarMap K X x a := by
  have h : ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ Y.hom.appTop ≫
        Y.left.Γevaluation (f.left x)) ≫ f.left.residueFieldMap x =
      (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ X.hom.appTop ≫
        X.left.Γevaluation x := by
    rw [Category.assoc, Category.assoc, Scheme.Γevaluation_naturality,
      ← Category.assoc Y.hom.appTop, ← Scheme.Hom.comp_appTop, Over.w]
  exact congrArg (fun g : CommRingCat.of K ⟶ X.left.residueField x => g.hom a) h

/-- The point map is fixed by the scheme's residue-field comorphism. -/
def mapPoint (f : X ⟶ Y) (p : Point K X) : Point K Y where
  schemePoint := f.left p.schemePoint
  absoluteValue := pullAbsoluteValue p.absoluteValue
    (f.left.residueFieldMap p.schemePoint).hom
  ultrametric a b := by
    change p.absoluteValue (f.left.residueFieldMap p.schemePoint (a + b)) ≤ _
    exact (congrArg p.absoluteValue
      (map_add (f.left.residueFieldMap p.schemePoint).hom a b)).le.trans
        (p.ultrametric _ _)
  extends_norm a := by
    change p.absoluteValue
      (f.left.residueFieldMap p.schemePoint (scalarMap K Y _ a)) = ‖a‖
    rw [scalarMap_naturality]
    exact p.extends_norm a

/-- Every regular evaluation is transported by the actual pullback section. -/
theorem mapPoint_eval (f : X ⟶ Y) (p : Point K X)
    {U : Y.left.Opens} (s : Γ(Y.left, U)) (hp : f.left p.schemePoint ∈ U) :
    (mapPoint f p).eval s hp = p.eval (f.left.app U s) hp := by
  have h₁ := congrArg
    (fun g : Y.left.presheaf.stalk (f.left p.schemePoint) ⟶
      X.left.residueField p.schemePoint =>
        g.hom (Y.left.presheaf.germ U (f.left p.schemePoint) hp s))
    (Scheme.residue_residueFieldMap f.left p.schemePoint)
  have h₂ := LocallyRingedSpace.stalkMap_germ_apply
    f.left.toLRSHom U p.schemePoint hp s
  exact congrArg p.absoluteValue
    (h₁.trans (congrArg (X.left.residue p.schemePoint).hom h₂))

theorem preimage_basicSet (f : X ⟶ Y) (U : Y.left.Opens)
    (s : Γ(Y.left, U)) (V : Set ℝ) :
    mapPoint f ⁻¹' basicSet K Y U s V =
      basicSet K X (f.left ⁻¹ᵁ U) (f.left.app U s) V := by
  ext p
  constructor
  · rintro ⟨hp, h⟩
    exact ⟨hp, by simpa only [mapPoint_eval] using h⟩
  · rintro ⟨hp, h⟩
    exact ⟨hp, by simpa only [mapPoint_eval] using h⟩

/-- Scheme morphisms induce continuous maps for the real-evaluation topology. -/
theorem continuous_mapPoint (f : X ⟶ Y) : Continuous (mapPoint f) := by
  rw [pointTopology, continuous_generateFrom_iff]
  rintro S ⟨U, s, V, hV, rfl⟩
  rw [preimage_basicSet]
  exact isOpen_basicSet K X _ _ _ hV

def map (f : X ⟶ Y) : space K X ⟶ space K Y :=
  TopCat.ofHom ⟨mapPoint f, continuous_mapPoint f⟩

@[simp]
theorem pullAbsoluteValue_id {A : Type} [Field A]
    (v : AbsoluteValue A ℝ) : pullAbsoluteValue v (RingHom.id A) = v := by
  ext a
  rfl

@[simp]
theorem pullAbsoluteValue_comp {A B C : Type}
    [Field A] [Field B] [Field C] (v : AbsoluteValue C ℝ)
    (f : A →+* B) (g : B →+* C) :
    pullAbsoluteValue v (g.comp f) =
      pullAbsoluteValue (pullAbsoluteValue v g) f := by
  ext a
  rfl

@[simp]
theorem mapPoint_id (p : Point K X) : mapPoint (𝟙 X) p = p := by
  cases p
  simp only [mapPoint, Over.id_left, Scheme.residueFieldMap_id]
  congr 1

@[simp]
theorem mapPoint_comp {Z : AlgebraicScheme K} (f : X ⟶ Y) (g : Y ⟶ Z)
    (p : Point K X) : mapPoint (f ≫ g) p = mapPoint g (mapPoint f p) := by
  cases p
  simp only [mapPoint, Over.comp_left, Scheme.residueFieldMap_comp,
    CommRingCat.hom_comp, pullAbsoluteValue_comp]
  rfl

/-- The underlying topological realization is a genuine functor. -/
def functor : AlgebraicScheme K ⥤ TopCat where
  obj := space K
  map := map
  map_id X := by
    ext p
    exact mapPoint_id p
  map_comp f g := by
    ext p
    exact mapPoint_comp f g p

end MathlibExt.AlgebraicGeometry.BerkovichAnalytification
