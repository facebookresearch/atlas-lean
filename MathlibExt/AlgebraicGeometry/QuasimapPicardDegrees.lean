module

public import MathlibExt.AlgebraicGeometry.QuasimapBasepointDefects
public import Mathlib.GroupTheory.FreeAbelianGroup

/-!
# Equivariant Picard degree from actual linearized line bundles

The equivariant Picard carrier is generated by actual linearized lines,
with actual equivariant isomorphism, tensor-product and trivial-line
relations. The tensor relation retains the original line action on all
global section pairs. On affine W these sections generate the source
modules, so it fixes the action on the entire tensor, including mixed
sections on G × W.

A degree functional lands in Z and its value on every generator is the
native Euler-characteristic degree of that line's actual torsor descent.
No freely named line-degree or cycle-valued defect map occurs here.

Reference: Ciocan-Fontanine–Kim–Maulik, arXiv:1106.3724v2,
§2.4, Definition 2.4.1 and §7.1, equation (7.1.3).
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.QuasimapPicardDegrees

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open _root_.AlgebraicGeometry
open LinearizedLineBundles LineBundleTaskContracts CoherentCurveLinearSeries
open AlgebraicLineBundleFamilies QuasimapAssociatedFamilies

universe u
variable {R : Type u} [CommRing R]
variable (G W : Over (Spec (.of R))) [GrpObj G] [ModObj G W]

/-- An actual equivariant line isomorphism, retaining its full action square. -/
structure LineIso (L M : LinearizedLineBundle G W) where
  iso : L.module ≅ M.module
  equivariant :
    (Scheme.Modules.pullback (action G W)).map iso.hom ≫ M.linearization.comparison.hom =
      L.linearization.comparison.hom ≫
        (Scheme.Modules.pullback (projection G W)).map iso.hom

/-- A tensor-line relation uses actual sheaf tensor and its actual action.
The projection pairing is fixed on every pulled global generator pair. -/
structure TensorLine (L M N : LinearizedLineBundle G W) where
  pairing : moduleTensor W.left L.module M.module ≅ N.module
  projectionPairing :
    moduleTensor (G ⊗ W).left
      ((Scheme.Modules.pullback (projection G W)).obj L.module)
      ((Scheme.Modules.pullback (projection G W)).obj M.module) ⟶
        (Scheme.Modules.pullback (projection G W)).obj N.module
  projection_normalized : ∀ (s : Section L.module) (t : Section M.module),
    tensorSection (pullbackSection (projection G W) s)
      (pullbackSection (projection G W) t) ≫ projectionPairing =
        pullbackSection (projection G W) (tensorSection s t ≫ pairing.hom)
  equivariant : ∀ (s : Section L.module) (t : Section M.module),
    pullbackSection (action G W) (tensorSection s t ≫ pairing.hom) ≫
        N.linearization.comparison.hom =
      tensorSection (pullbackSection (action G W) s ≫ L.linearization.comparison.hom)
        (pullbackSection (action G W) t ≫ M.linearization.comparison.hom) ≫ projectionPairing

/-- The trivial-line relation fixes the action of its actual unit generator. -/
structure TrivialLine (L : LinearizedLineBundle G W) where
  trivial : structureModule W.left ≅ L.module
  equivariant : pullbackSection (action G W) trivial.hom ≫ L.linearization.comparison.hom =
    pullbackSection (projection G W) trivial.hom

/-- Actual equivariant-line, tensor and unit relations in the free group of lines. -/
def picardRelations [IsAffine G.left] [IsAffine W.left] :
    AddSubgroup (FreeAbelianGroup (LinearizedLineBundle G W)) :=
  AddSubgroup.closure {z |
    (∃ (L M : LinearizedLineBundle G W), Nonempty (LineIso G W L M) ∧
      z = FreeAbelianGroup.of L - FreeAbelianGroup.of M) ∨
    (∃ (L M N : LinearizedLineBundle G W), Nonempty (TensorLine G W L M N) ∧
      z = FreeAbelianGroup.of N - FreeAbelianGroup.of L - FreeAbelianGroup.of M) ∨
    (∃ L : LinearizedLineBundle G W, Nonempty (TrivialLine G W L) ∧
      z = FreeAbelianGroup.of L)}

abbrev EquivariantPicard [IsAffine G.left] [IsAffine W.left] :=
  FreeAbelianGroup (LinearizedLineBundle G W) ⧸ picardRelations G W

def lineClass [IsAffine G.left] [IsAffine W.left]
    (L : LinearizedLineBundle G W) : EquivariantPicard G W :=
  QuotientAddGroup.mk' (picardRelations G W) (FreeAbelianGroup.of L)

variable {G W}

/-- One actual descended line for each equivariant line, on a proper curve `C`, so that each
line has its native degree. -/
structure InducedDegrees {k : Type u} [Field k]
    {C : Over (Spec (.of k))} (G W : Over (Spec (.of k))) [GrpObj G] [ModObj G W]
    (P : GroupTorsorGeometry.QuotientObject G W C) where
  line : ∀ L : LinearizedLineBundle G W,
    QuotientLineDescentModels.DescendedLine G W P L
  properCurve : IsProperCurve C.hom

/-- The native integer degree of the actual induced line. -/
def inducedDegree {k : Type u} [Field k]
    {C : Over (Spec (.of k))} {G W : Over (Spec (.of k))} [GrpObj G] [ModObj G W]
    {P : GroupTorsorGeometry.QuotientObject G W C} (D : InducedDegrees G W P)
    (L : LinearizedLineBundle G W) : ℤ :=
  letI := D.properCurve
  degree C.hom (D.line L).module (D.line L).line

/-- β is a genuine Picard-group functional, fixed on every actual line generator. -/
structure DegreeFunctional {k : Type u} [Field k]
    {C : Over (Spec (.of k))} {G W : Over (Spec (.of k))} [GrpObj G] [ModObj G W]
    [IsAffine G.left] [IsAffine W.left] {P : GroupTorsorGeometry.QuotientObject G W C}
    (D : InducedDegrees G W P) where
  beta : EquivariantPicard G W →+ ℤ
  normalized : ∀ L : LinearizedLineBundle G W, beta (lineClass G W L) = inducedDegree D L

end MathlibExt.AlgebraicGeometry.QuasimapPicardDegrees
