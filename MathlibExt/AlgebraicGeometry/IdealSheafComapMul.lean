open AlgebraicGeometry in
/-- Pullback of ideal sheaves preserves multiplication. -/
public theorem AlgebraicGeometry.Scheme.IdealSheafData.comap_mul
    {X Y : Scheme.{u}} (I J : Y.IdealSheafData) (f : X ⟶ Y) :
    (I * J).comap f = I.comap f * J.comap f := by
  let ι := Σ U : Y.affineOpens, {V : X.affineOpens //
    (V : X.Opens) ≤ f ⁻¹ᵁ (U : Y.Opens)}
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (fun i : ι ↦ i.2.1) ?_ ?_
  · refine top_le_iff.mp fun x _ ↦ ?_
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f.base x)) isOpen_univ
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ f ⁻¹ᵁ U from hxU)
        (f ⁻¹ᵁ U).isOpen
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨U, hU⟩, ⟨V, hV⟩, hVU⟩, hxV⟩
  · rintro ⟨U, V, hVU⟩
    change ((I * J).comap f).ideal V = (I.comap f * J.comap f).ideal V
    rw [IdealSheafComapMulAux.ideal_comap_of_le _ f U V hVU]
    simp only [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply]
    rw [IdealSheafComapMulAux.ideal_comap_of_le I f U V hVU,
      IdealSheafComapMulAux.ideal_comap_of_le J f U V hVU, Ideal.map_mul]
