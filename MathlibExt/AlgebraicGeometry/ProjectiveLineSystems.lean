module

public import MathlibExt.AlgebraicGeometry.CurvePositivity
public import MathlibExt.AlgebraicGeometry.ProjectiveSpace
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.AlgebraicGeometry.Noetherian

/-!
# Actual projective varieties and ample line systems

Projectivity over a field is `ProjectiveSpace.IsProjective`: an actual
closed immersion into projective space. On a Noetherian scheme, ampleness
uses Serre's global-generation criterion: every finitely presented module
(Mathlib's `SheafOfModules.IsFinitePresentation`) becomes generated by
global sections after all sufficiently large tensor twists. The tensors are
the actual scheme-module constructors.

References: Stacks Project, Sections on ample invertible sheaves;
Lazarsfeld, *Positivity in Algebraic Geometry I*, Chapter 1.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.ProjectiveLineSystems

open CategoryTheory CategoryTheory.Limits _root_.AlgebraicGeometry
open MathlibExt.AlgebraicGeometry.CoherentCurveLinearSeries
open MathlibExt.AlgebraicGeometry.CurveVectorBundles
open MathlibExt.AlgebraicGeometry.CurvePositivity

universe u

/-- A projective scheme over a field: a transparent alias of `ProjectiveSpace.IsProjective`
(a closed immersion over `k` into projective space). Despite the name it asserts projectivity
only, not integrality or reducedness. Deprecated: use `ProjectiveSpace.IsProjective`. -/
@[deprecated MathlibExt.AlgebraicGeometry.ProjectiveSpace.IsProjective (since := "2026-11-24")]
abbrev IsProjectiveVariety {k : Type u} [Field k] (X : Over (Spec (.of k))) : Prop :=
  ProjectiveSpace.IsProjective X

/-- The invertible sheaves on a scheme. -/
abbrev LineBundle (X : Scheme.{u}) := {L : X.Modules // IsLineBundle L}

/-- Ampleness of a line bundle on a Noetherian scheme, by Serre's criterion: for every
finitely presented (that is, coherent) module `F`, the twists `F ⊗ L^{⊗ m}` are generated
by global sections for all large `m`. (Without quasi-compactness this criterion does not
characterize ampleness, so it is only stated on Noetherian schemes.) -/
def IsAmpleLine {X : Scheme.{u}} [IsNoetherian X] (L : LineBundle X) : Prop :=
  ∀ F : X.Modules, SheafOfModules.IsFinitePresentation (R := X.ringCatSheaf) F →
    ∃ N : ℕ, ∀ m ≥ N,
      GloballyGenerated (moduleTensor X F (power L.val m))

/-- An inverse of an invertible sheaf: an invertible sheaf whose tensor product with
it is trivial. -/
structure InverseLine {X : Scheme.{u}} (L : LineBundle X) where
  /-- The inverse invertible sheaf. -/
  inverse : LineBundle X
  /-- The tensor product is trivial. -/
  tensor : Nonempty (moduleTensor X L.val inverse.val ≅ structureModule X)

end MathlibExt.AlgebraicGeometry.ProjectiveLineSystems
