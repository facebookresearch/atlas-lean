module

public import MathlibExt.AlgebraicGeometry.PlurigenusFamilies
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent

/-!
# Actual projective varieties and ample line systems

Projectivity over a field is an actual closed immersion into projective
space. Ampleness uses the coherent-sheaf global-generation criterion:
every finite-presentation module becomes generated by a finite family of
global sections after all sufficiently large positive tensor twists.
The tensors and epimorphisms are the actual scheme-module constructors.

References: Stacks Project, Sections on ample invertible sheaves;
Lazarsfeld, *Positivity in Algebraic Geometry I*, Chapter 1.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.ProjectiveLineSystems

open CategoryTheory CategoryTheory.Limits _root_.AlgebraicGeometry
open MathlibExt.AlgebraicGeometry.CoherentCurveLinearSeries
open MathlibExt.AlgebraicGeometry.CurveVectorBundles
open MathlibExt.AlgebraicGeometry.CurvePositivity

universe u

def IsProjectiveVariety {k : Type u} [Field k]
    (X : Over (Spec (.of k))) : Prop :=
  ∃ n : ℕ, ∃ i : X ⟶ SurfaceHilbertSchemes.projectiveSpace k n,
    IsClosedImmersion i.left

abbrev LineBundle (X : Scheme.{u}) := {L : X.Modules // IsLineBundle L}

/-- Local finite presentation by actual finite free sheaf maps and cokernels. -/
def IsLocallyFinitelyPresentedModule {X : Scheme.{u}} (F : X.Modules) : Prop :=
  ∀ x : X, ∃ U : X.Opens, x ∈ U ∧ ∃ a b : ℕ,
    ∃ d : trivialBundle U a ⟶ trivialBundle U b,
      Nonempty ((Scheme.Modules.pullback U.ι).obj F ≅ cokernel d)

/-- The actual Serre global-generation criterion for ampleness. -/
def IsAmpleLine {X : Scheme.{u}} (L : LineBundle X) : Prop :=
  ∀ F : X.Modules, IsLocallyFinitelyPresentedModule F →
    ∃ N : ℕ, ∀ m ≥ N,
      GloballyGenerated (moduleTensor X F (power L.val m))

structure InverseLine {X : Scheme.{u}} (L : LineBundle X) where
  inverse : LineBundle X
  tensor : Nonempty (moduleTensor X L.val inverse.val ≅ structureModule X)

end MathlibExt.AlgebraicGeometry.ProjectiveLineSystems
