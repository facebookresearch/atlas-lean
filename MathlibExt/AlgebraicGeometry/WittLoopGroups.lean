module

public import Mathlib.RingTheory.WittVector.Compare
public import Mathlib.CategoryTheory.Monoidal.Cartesian.Grp
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.RingTheory.RingHom.FaithfullyFlat
public import MathlibExt.AlgebraicGeometry.WittLatticeFamilies

/-!
# Actual Witt loop groups and their fpqc quotient

The test rings are actual perfect prime-field algebras. Positive loops are
scheme-valued points over W(R), and loops are points over W(R)[1/p]. The
base map from Z_p is the native Witt-vector comparison followed by the
actual coefficient map. No abstract loop group replaces these points.

The quotient is the coequalizer of the actual right positive-loop action,
followed by sheafification for the topology generated by faithfully flat
affine maps. Scheme or ind-scheme representation, Schubert geometry and
Satake comparisons are separate geometric contracts.

Reference: Zhu, arXiv:1407.8519v3, Section1.1 and formula(0.1.2).
Native Witt maps, group Yoneda and sheafification are completed Mathlib
constructions. This file assembles their actual coefficient and quotient
maps rather than requesting those constructions anew.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace MathlibExt.AlgebraicGeometry.WittLoopGroups

open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open _root_.CategoryTheory.MonObj _root_.AlgebraicGeometry
open WittLatticeFamilies

variable (p : ℕ) [Fact p.Prime]

/-- The actual canonical Z_p-algebra map on every Witt test ring. -/
def scalarMap (R : PerfectAlgebra p) : ℤ_[p] →+* WittVector p R.obj :=
  (WittVector.map (algebraMap (ZMod p) R.obj)).comp
    (WittVector.fromPadicInt p)

/-- Scalar compatibility is fixed by the actual coefficient ring map. -/
theorem scalarMap_naturality {R S : PerfectAlgebra p} (f : R ⟶ S) :
    (WittVector.map f.hom.hom.toRingHom).comp (scalarMap p R) =
      scalarMap p S := by
  ext a n
  change f.hom.hom (algebraMap (ZMod p) R.obj
    ((WittVector.fromPadicInt p a).coeff n)) = _
  exact f.hom.hom.commutes _

/-- The actual positive-loop affine test, over Z_p. -/
def integralTest (R : PerfectAlgebra p) : Over (Spec (.of ℤ_[p])) :=
  Over.mk (Spec.map (CommRingCat.ofHom (scalarMap p R)))

/-- The actual p-inverted affine test, with the same prescribed scalars. -/
def rationalTest (R : PerfectAlgebra p) : Over (Spec (.of ℤ_[p])) :=
  Over.mk (Spec.map (CommRingCat.ofHom
    ((algebraMap (WittVector p R.obj)
      (Localization.Away (p : WittVector p R.obj))).comp (scalarMap p R))))

/-- The contravariant positive-loop test morphism. -/
def integralMap {R S : PerfectAlgebra p} (f : R ⟶ S) :
    integralTest p S ⟶ integralTest p R :=
  Over.homMk (Spec.map (CommRingCat.ofHom
    (WittVector.map f.hom.hom.toRingHom))) (by
      change Spec.map (CommRingCat.ofHom (WittVector.map f.hom.hom.toRingHom)) ≫
        Spec.map (CommRingCat.ofHom (scalarMap p R)) =
          Spec.map (CommRingCat.ofHom (scalarMap p S))
      rw [← Spec.map_comp]
      exact congrArg (fun h ↦ Spec.map (CommRingCat.ofHom h))
        (scalarMap_naturality p f))

/-- Localization preserves the coefficient square on every element. -/
theorem fractionMap_scalar {R S : PerfectAlgebra p} (f : R ⟶ S)
    (a : ℤ_[p]) :
    fractionMap p f (algebraMap _ _ (scalarMap p R a)) =
      algebraMap _ _ (scalarMap p S a) := by
  simp only [fractionMap, Localization.awayLift, IsLocalization.Away.lift_eq,
    RingHom.comp_apply]
  exact congrArg (algebraMap _ _) (RingHom.congr_fun (scalarMap_naturality p f) a)

/-- The actual contravariant rational-loop test morphism. -/
def rationalMap {R S : PerfectAlgebra p} (f : R ⟶ S) :
    rationalTest p S ⟶ rationalTest p R :=
  Over.homMk (Spec.map (CommRingCat.ofHom (fractionMap p f))) (by
    change Spec.map (CommRingCat.ofHom (fractionMap p f)) ≫
      Spec.map (CommRingCat.ofHom ((algebraMap _ _).comp (scalarMap p R))) =
        Spec.map (CommRingCat.ofHom ((algebraMap _ _).comp (scalarMap p S)))
    rw [← Spec.map_comp]
    congr 1
    ext a
    exact fractionMap_scalar p f a)

/-- The integral test functor, with literal coefficientwise Witt maps. -/
def integralTests : (PerfectAlgebra p)ᵒᵖ ⥤ Over (Spec (.of ℤ_[p])) where
  obj R := integralTest p R.unop
  map f := integralMap p f.unop
  map_id R := by
    apply Over.OverMorphism.ext
    change Spec.map (CommRingCat.ofHom
      (WittVector.map (RingHom.id R.unop.obj))) = 𝟙 _
    have h : WittVector.map (RingHom.id R.unop.obj) =
        RingHom.id (WittVector p R.unop.obj) := WittVector.map_id _
    rw [h]
    exact Spec.map_id _
  map_comp {R S T} f g := by
    apply Over.OverMorphism.ext
    change Spec.map (CommRingCat.ofHom (WittVector.map _)) =
      Spec.map (CommRingCat.ofHom (WittVector.map f.unop.hom.hom.toRingHom)) ≫
        Spec.map (CommRingCat.ofHom (WittVector.map g.unop.hom.hom.toRingHom))
    rw [← Spec.map_comp]
    congr 1

/-- The localization map is an actual map of test schemes. -/
def localization (R : PerfectAlgebra p) : rationalTest p R ⟶ integralTest p R :=
  Over.homMk (Spec.map (CommRingCat.ofHom (algebraMap _ _))) (by
    change Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫
      Spec.map (CommRingCat.ofHom (scalarMap p R)) =
        Spec.map (CommRingCat.ofHom ((algebraMap _ _).comp (scalarMap p R)))
    rw [← Spec.map_comp]
    rfl)

/-- The rational test functor, induced by actual localization maps. -/
def rationalTests : (PerfectAlgebra p)ᵒᵖ ⥤ Over (Spec (.of ℤ_[p])) where
  obj R := rationalTest p R.unop
  map f := rationalMap p f.unop
  map_id R := by
    apply Over.OverMorphism.ext
    have h : fractionMap p (𝟙 R.unop) = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers
        (p : WittVector p R.unop.obj))
      ext a
      simp only [fractionMap, Localization.awayLift, IsLocalization.Away.lift_eq,
        RingHom.comp_apply, RingHom.id_apply]
      rfl
    change Spec.map (CommRingCat.ofHom (fractionMap p (𝟙 R.unop))) = 𝟙 _
    rw [h]
    exact Spec.map_id _
  map_comp {R S T} f g := by
    apply Over.OverMorphism.ext
    change Spec.map (CommRingCat.ofHom (fractionMap p (f ≫ g).unop)) =
      Spec.map (CommRingCat.ofHom (fractionMap p f.unop)) ≫
        Spec.map (CommRingCat.ofHom (fractionMap p g.unop))
    rw [← Spec.map_comp]
    have h : fractionMap p (f ≫ g).unop =
        (fractionMap p f.unop).comp (fractionMap p g.unop) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers
        (p : WittVector p T.unop.obj))
      ext a
      simp only [fractionMap, Localization.awayLift, IsLocalization.Away.lift_eq,
        RingHom.comp_apply]
      rfl
    exact congrArg (fun h ↦ Spec.map (CommRingCat.ofHom h)) h

/-- The actual natural localization map between integral and rational tests. -/
def localizations : rationalTests p ⟶ integralTests p where
  app R := localization p R.unop
  naturality {R S} f := by
    apply Over.OverMorphism.ext
    change Spec.map (CommRingCat.ofHom (fractionMap p f.unop)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap _ _)) =
        Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫
          Spec.map (CommRingCat.ofHom (WittVector.map f.unop.hom.hom.toRingHom))
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    ext a
    change fractionMap p f.unop (algebraMap _ _ a) =
      algebraMap _ _ (WittVector.map f.unop.hom.hom.toRingHom a)
    simp only [fractionMap, Localization.awayLift, IsLocalization.Away.lift_eq,
      RingHom.comp_apply]

variable (G : Over (Spec (.of ℤ_[p]))) [GrpObj G]

/-- Actual group-scheme points over W(R), on all perfect affine tests. -/
def positiveLoops : PerfectAlgebra p ⥤ GrpCat.{0} :=
  (integralTests p).rightOp ⋙ yonedaGrpObj G

/-- Actual group-scheme points over W(R)[1/p]. -/
def loops : PerfectAlgebra p ⥤ GrpCat.{0} :=
  (rationalTests p).rightOp ⋙ yonedaGrpObj G

/-- The actual positive-loop inclusion, fixed by localization on test schemes. -/
def positiveToLoop : positiveLoops p G ⟶ loops p G :=
  Functor.whiskerRight (NatTrans.rightOp (localizations p)) (yonedaGrpObj G)

/-- The exact affine fpqc generators: finite jointly faithfully flat families of perfect
algebras, that is, families whose product map is faithfully flat. Finite families, including the
empty family covering the zero algebra, make sheaves preserve finite products, as Zhu,
arXiv:1407.8519v3, Appendix A.1.1 requires in addition to the faithfully flat equaliser
condition. -/
def fpqcPrecoverage : Precoverage (PerfectAlgebra p)ᵒᵖ where
  coverings R := {s | ∃ (J : Type) (_ : Finite J) (S : J → PerfectAlgebra p)
    (f : ∀ i, R.unop ⟶ S i),
    (RingHom.pi fun i ↦ (f i).hom.hom.toRingHom).FaithfullyFlat ∧
      s = Presieve.ofArrows (fun i ↦ Opposite.op (S i)) fun i ↦ (f i).op}

/-- The topology generated by actual finite jointly faithfully flat affine families. -/
def fpqcTopology : GrothendieckTopology (PerfectAlgebra p)ᵒᵖ :=
  (fpqcPrecoverage p).toGrothendieck

end MathlibExt.AlgebraicGeometry.WittLoopGroups
