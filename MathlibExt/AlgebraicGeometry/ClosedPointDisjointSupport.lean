/-!
# A closed point disjoint from an ideal sheaf support

An ideal sheaf is invertible when, locally on affine basic opens, its ideal
is generated by a single non-zero-divisor. The top ideal sheaf is invertible.
If a closed immersion from the spectrum of a local ring sends its closed
point outside the support of an ideal sheaf, the pulled-back kernel ideal
sheaf on the subscheme is the top one, hence invertible, and every map out
of it to a spectrum has rank zero everywhere.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- An ideal sheaf is invertible when every point lies in an affine basic
open on which the ideal is generated by a non-zero-divisor. -/
public def IsInvertible (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ (U : X.affineOpens) (f : Γ(X, U)), x ∈ X.basicOpen f ∧
    ∃ g ∈ nonZeroDivisors Γ(X, X.affineBasicOpen f),
      I.ideal (X.affineBasicOpen f) = Ideal.span {g}

/-- The top ideal sheaf is invertible: locally it is generated by `1`. -/
public theorem isInvertible_top : (⊤ : X.IdealSheafData).IsInvertible := by
  intro x
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  refine ⟨⟨U, hU⟩, 1, by simpa using hxU, 1, one_mem _, ?_⟩
  rw [ideal_top, Pi.top_apply, Ideal.span_singleton_one]

end AlgebraicGeometry.Scheme.IdealSheafData

namespace AlgebraicGeometry

/-- If the closed point of a local ring maps under a closed immersion
outside the support of an ideal sheaf `J`, then the kernel of the immersion
pulled back to the subscheme cut out by `J` is the top ideal sheaf. It is
therefore invertible, the resulting closed immersion composed with any map
to a spectrum is finite, and its rank vanishes at every point. -/
public theorem Scheme.Hom.comap_ker_eq_top_and_finrank_eq_zero_of_closedPoint_notMem_support
    {O : Type u} [CommRing O] [IsLocalRing O] {X : Scheme.{u}}
    (σ : Spec (CommRingCat.of O) ⟶ X) [IsClosedImmersion σ]
    (J : X.IdealSheafData) (hJ : σ.base (IsLocalRing.closedPoint O) ∉ J.support)
    {k : Type u} [Field k] (y : J.subscheme ⟶ Spec (CommRingCat.of k)) :
    σ.ker.comap J.subschemeι = ⊤ ∧
      (σ.ker.comap J.subschemeι).IsInvertible ∧
      IsFinite ((σ.ker.comap J.subschemeι).subschemeι ≫ y) ∧
      ∀ q : Spec (CommRingCat.of k),
        ((σ.ker.comap J.subschemeι).subschemeι ≫ y).finrank q = 0 := by
  have hrange : ∀ x ∈ Set.range σ.base, x ∉ (J.support : Set X) := by
    rintro _ ⟨t, rfl⟩ ht
    exact hJ ((((IsLocalRing.specializes_closedPoint t).map σ.base.hom.continuous)).mem_closed
      J.support.isClosed ht)
  have hsupp : ((σ.ker).support : Set X) = Set.range σ.base := by
    rw [Scheme.Hom.support_ker, (Scheme.Hom.isClosedEmbedding σ).isClosed_range.closure_eq]
  have hK : σ.ker.comap J.subschemeι = ⊤ := by
    apply (Scheme.IdealSheafData.support_eq_bot_iff _).mp
    rw [Scheme.IdealSheafData.support_comap]
    refine le_bot_iff.mp fun w hw => ?_
    have hw' : J.subschemeι.base w ∈ ((σ.ker).support : Set X) := hw
    rw [hsupp] at hw'
    refine hrange _ hw' ?_
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨w, rfl⟩
  rw [hK]
  refine ⟨rfl, Scheme.IdealSheafData.isInvertible_top, inferInstance, fun q => ?_⟩
  generalize ((⊤ : (J.subscheme).IdealSheafData).subschemeι ≫ y) = g
  haveI : IsOpenImmersion g := isOpenImmersion_of_isEmpty g
  have hns : ¬ Surjective g := fun h => by
    obtain ⟨x, -⟩ := h.surj q
    exact isEmptyElim x
  rw [← Scheme.Hom.one_le_finrank_iff_surjective] at hns
  simp only [Pi.le_def, Pi.one_apply, not_forall, not_le, Nat.lt_one_iff] at hns
  obtain ⟨y', hy'⟩ := hns
  rwa [Subsingleton.elim q y']

end AlgebraicGeometry
