module

public import MathlibExt.Algebra.Group.Submonoid.PowerRootClosure
public import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup
public import Mathlib.GroupTheory.Torsion
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Algebra.Category.MonCat.Basic

/-!
# The explicit group quotient and root closure for basic log maps

Relations are (chi1(m),-chi2(m),u_q(m)) in the actual product of generic
vertex groupifications and node integers. Quotienting by their generated
subgroup and then its quotient torsion is exactly quotienting by the
saturated relation subgroup. The monoid is the positive-power root closure
of the actual image of the vertex monoids and nonnegative node generators.

This construction alone does not force sharpness or nonzero smoothing
parameters. Gross--Siebert Example1.17 gives genuine inadmissible types;
their geometric realizability hypothesis is essential. Geometric consumers
must pin these monoids/generizations/contacts to actual sheaf fibres.
Reference: Gross--Siebert, arXiv:1102.4322v2, Construction1.16, equation1.14,
Proposition1.19 and Example1.17. All objects and maps below are computed.
-/

@[expose] public noncomputable section
namespace MathlibExt.AlgebraicGeometry.LogMapBasicMonoids
open _root_.CategoryTheory
universe u v

local instance (A : Type*) : DecidableEq A := Classical.decEq A

/-- Pure contact data; geometric callers identify the monoids with actual
small-etale fibres and the two maps with actual branch generizations.

The source's dual graphs are finite: for finite `V` and `E` (all geometric
callers index by `Fin`) the products used below are the direct sums of
Construction 1.16. For infinite index types the construction is not the
source's basic monoid. -/
structure ContactDiagram (V E : Type v) where
  vertex : V → CommMonCat.{u}
  node : E → CommMonCat.{u}
  branch1 : E → V
  branch2 : E → V
  generization1 : ∀ e, node e →* vertex (branch1 e)
  generization2 : ∀ e, node e →* vertex (branch2 e)
  contact : ∀ e, Additive (Algebra.GrothendieckGroup (node e)) →+ ℤ

abbrev TotalGroup {V E : Type v} (D : ContactDiagram.{u,v} V E) :=
  (∀ i : V, Additive (Algebra.GrothendieckGroup (D.vertex i))) × (E → ℤ)

/-- The source relation has its prescribed two branch signs. Self-nodes
are allowed: the two contributions are subtracted in the same vertex slot. -/
def relation {V E : Type v} (D : ContactDiagram.{u,v} V E) (e : E) (m : D.node e) :
    TotalGroup D :=
  (fun i =>
    (if h : i = D.branch1 e then h.symm ▸ Additive.ofMul
      (Algebra.GrothendieckGroup.of (D.generization1 e m)) else 0) -
    (if h : i = D.branch2 e then h.symm ▸ Additive.ofMul
      (Algebra.GrothendieckGroup.of (D.generization2 e m)) else 0),
   fun q => if q = e then D.contact e (Additive.ofMul (Algebra.GrothendieckGroup.of m)) else 0)

/-- The actual subgroup generated by every node relation. -/
def relations {V E : Type v} (D : ContactDiagram.{u,v} V E) : AddSubgroup (TotalGroup D) :=
  AddSubgroup.closure {x | ∃ e m, x = relation D e m}

abbrev RelationQuotient {V E : Type v} (D : ContactDiagram.{u,v} V E) :=
  TotalGroup D ⧸ relations D

/-- The torsion-free quotient implements saturation of the relation subgroup. -/
abbrev BasicGroup {V E : Type v} (D : ContactDiagram.{u,v} V E) :=
  RelationQuotient D ⧸ AddCommGroup.torsion (RelationQuotient D)

def groupProjection {V E : Type v} (D : ContactDiagram.{u,v} V E) :
    TotalGroup D →+ BasicGroup D :=
  (QuotientAddGroup.mk' (AddCommGroup.torsion (RelationQuotient D))).comp
    (QuotientAddGroup.mk' (relations D))

/-- Every node relation vanishes in the basic group. -/
theorem groupProjection_relation {V E : Type v} (D : ContactDiagram.{u,v} V E) (e : E)
    (m : D.node e) : groupProjection D (relation D e m) = 0 := by
  have h : (QuotientAddGroup.mk' (relations D)) (relation D e m) = 0 :=
    (QuotientAddGroup.eq_zero_iff _).2 (AddSubgroup.subset_closure ⟨e, m, rfl⟩)
  simp only [groupProjection, AddMonoidHom.comp_apply, h, map_zero]

/-- The actual product of positive vertex and smoothing entries. -/
abbrev PositiveData {V E : Type v} (D : ContactDiagram.{u,v} V E) :=
  (∀ i : V, D.vertex i) × (E → ℕ)

def positiveGroup {V E : Type v} (D : ContactDiagram.{u,v} V E) (p : PositiveData D) :
    TotalGroup D :=
  (fun i => Additive.ofMul (Algebra.GrothendieckGroup.of (p.1 i)), fun e => (p.2 e : ℤ))

def positiveImage {V E : Type v} (D : ContactDiagram.{u,v} V E) :
    Submonoid (Multiplicative (BasicGroup D)) :=
  Submonoid.closure (Set.range fun p : PositiveData D =>
    Multiplicative.ofAdd (groupProjection D (positiveGroup D p)))

/-- The actual saturated basic monoid, without a premature sharpness claim. -/
def basicMonoid {V E : Type v} (D : ContactDiagram.{u,v} V E) :
    Submonoid (Multiplicative (BasicGroup D)) := (positiveImage D).powerRootClosure

/-- Every positive image has its canonical value in that root closure. -/
def positiveClass {V E : Type v} (D : ContactDiagram.{u,v} V E) (p : PositiveData D) :
    basicMonoid D :=
  ⟨Multiplicative.ofAdd (groupProjection D (positiveGroup D p)),
    Submonoid.le_powerRootClosure _ (Submonoid.subset_closure ⟨p,rfl⟩)⟩

/-- The actual node smoothing generator. Its nontriviality is a geometric
admissibility condition, never a consequence of this raw construction. -/
def smoothing {V E : Type v} (D : ContactDiagram.{u,v} V E) (e : E) : basicMonoid D :=
  positiveClass D (fun _i => 1, fun q => if q = e then 1 else 0)

end MathlibExt.AlgebraicGeometry.LogMapBasicMonoids
