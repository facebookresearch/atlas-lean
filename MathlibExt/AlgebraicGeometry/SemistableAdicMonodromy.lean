module

public import MathlibExt.AlgebraicGeometry.PadicNeronModels
public import MathlibExt.AlgebraicGeometry.SemistableModels
public import MathlibExt.AlgebraicGeometry.AdicLinearFunctoriality
public import MathlibExt.AlgebraicGeometry.GeometricAdicGaloisOperators
public import Mathlib.FieldTheory.Galois.Infinite
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.NumberTheory.Padics.Complex

/-!
# Actual semistable models and adic inertia operators

The generic model definitions in `SemistableModels` work over any actual
discrete valuation ring and uniformizer. This consumer specializes them
to Spec Z_p and its actual residue field. It keeps the actual chart,
reduced-fibre and global smooth-component conditions.

Inertia fixes the actual intermediate field generated by the roots of
X^(p^f)-X, f > 0, in the actual algebraic closure of Q_p. This is the
proved presentation of Q_p's maximal unramified extension in the cited
TauCeti source. The coefficient module is continuous Q_ell, and every
cohomology operator is the fixed inverse-image map along id_X x Spec sigma.
No cohomology, monodromy or spectral-sequence operator is selected as data.

Reference: L. Illusie, *Autour du theoreme de monodromie locale*,
Astérisque 223 (1994), Exposé I, section 3.1, pp. 33--34.
https://www.numdam.org/item/AST_1994__223__9_0/
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace MathlibExt.AlgebraicGeometry.SemistableAdicMonodromy

open _root_.CategoryTheory _root_.CategoryTheory.Limits
open _root_.TopologicalSpace _root_.AlgebraicGeometry
open _root_.AlgebraicGeometry.Scheme
open PadicNeronModels GeometricAdicGaloisOperators AdicLinearFunctoriality

variable (p : ℕ) [Fact p.Prime]

/-- The absolute Galois group of $\mathbb{Q}_p$: the group of $\mathbb{Q}_p$-algebra automorphisms
of the algebraic closure $\overline{\mathbb{Q}}_p$ (`PadicAlgCl p`). -/
abbrev Galois := PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p

/-- The root presentation of the actual maximal unramified field. The
f=0 polynomial is excluded because it is identically zero. -/
def unramifiedField : IntermediateField ℚ_[p] (PadicAlgCl p) :=
  IntermediateField.adjoin ℚ_[p]
    {x : PadicAlgCl p | ∃ f : ℕ, f ≠ 0 ∧ x ^ (p ^ f) = x}

/-- Inertia is the actual fixing subgroup of the unramified field. -/
def inertia : Subgroup (Galois p) := (unramifiedField p).fixingSubgroup

/-- Its membership is fixed by the actual unramified root equations. -/
theorem mem_inertia_iff (σ : Galois p) :
    σ ∈ inertia p ↔ ∀ (x : PadicAlgCl p) (f : ℕ),
      f ≠ 0 → x ^ (p ^ f) = x → σ x = x := by
  rw [inertia, IntermediateField.mem_fixingSubgroup_iff, unramifiedField]
  constructor
  · intro h x f hf hx
    exact h x (IntermediateField.subset_adjoin _ _ ⟨f, hf, hx⟩)
  · intro h
    exact (IntermediateField.forall_mem_adjoin_smul_eq_self_iff
      (F := ℚ_[p]) σ).mpr (fun x ⟨f, hf, hx⟩ ↦ h x f hf hx)

variable (X : Over (trait p))

/-- Consume the general actual-DVR model, with p as uniformizer.
The native residue field Z_p/(p) is canonically F_p. -/
abbrev IsStrictlySemistable : Prop :=
  SemistableModels.IsStrictlySemistable ℤ_[p] (p : ℤ_[p]) X

variable (ell : ℕ) [Fact ell.Prime]

/-- The actual geometric generic fibre X x_Zp Q_p^alg. -/
abbrev GeometricGenericFibre : Scheme :=
  geometricFibre ((genericFunctor p).obj X) (PadicAlgCl p)

/-- The actual continuous rational pro-etale cohomology module. -/
abbrev Cohomology (n : ℕ) :=
  AdicCohomology ell (GeometricGenericFibre p X) n

/-- The linear Galois operator is the actual normalized scheme pullback. -/
def galoisOperator (σ : Galois p) (n : ℕ) :
    Module.End ℚ_[ell] (Cohomology p X ell n) :=
  continuousPullbackLinear ℚ_[ell] (RationalCoefficients.{0} ell)
    (galoisSchemeOperator ((genericFunctor p).obj X) (PadicAlgCl p) σ) n

/-- It is pointwise the existing actual geometric Galois operator. -/
theorem galoisOperator_apply (σ : Galois p) (n : ℕ)
    (a : Cohomology p X ell n) :
    galoisOperator p X ell σ n a =
      galoisCohomologyOperator ((genericFunctor p).obj X)
        (PadicAlgCl p) ell σ n a := rfl

end MathlibExt.AlgebraicGeometry.SemistableAdicMonodromy
