module

public import MathlibExt.AlgebraicGeometry.BerkovichAnalytification
public import Mathlib.Algebra.Category.ModuleCat.Stalk
public import Mathlib.Analysis.Normed.Field.Instances
public import Mathlib.Analysis.Normed.Module.Completion
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import MathlibExt.AlgebraicGeometry.CoherentCurveLinearSeries

/-!
# Actual completed residue-field fibres and local line metrics

A point uses a real absolute value on its actual scheme residue field,
extending the ground-field norm. Both archimedean and nonarchimedean
absolute values are allowed. The topology is generated by evaluation of
actual regular sections. The nonarchimedean subspace is distinguished
explicitly rather than used to stand for every arithmetic place.

The fibre of a native module sheaf is H(x) tensor O_x its actual stalk,
where H(x) is the native normed completion of that valued residue field.
Local sections evaluate by the actual stalk germ and pure tensor. A metric
is a genuine positive homogeneous fibre norm, continuous on all such
local-section evaluations. There is no arbitrary height or fibre carrier.

Reference: Yuan--Zhang, arXiv:2105.13587v9, Section3.2, p72, and A.5.1.
The point evaluation adapts the completed Atlas BerkovichAnalytification
definition by allowing archimedean absolute values; all completion,
module-stalk and tensor operations are native Mathlib constructions.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace MathlibExt.AlgebraicGeometry.ValuedLineFibres

open _root_.CategoryTheory Opposite _root_.AlgebraicGeometry
open scoped TensorProduct

variable (K : Type) [NormedField K]
  (X : Over (Spec (.of K)))

/-- Absolute-valued residue points, retaining archimedean places. -/
structure Point where
  schemePoint : X.left
  absoluteValue : AbsoluteValue (X.left.residueField schemePoint) ℝ
  extends_norm : ∀ a : K,
    absoluteValue (BerkovichAnalytification.scalarMap K X schemePoint a) = ‖a‖

/-- Actual regular evaluation at an absolute-valued residue point. -/
def Point.eval (p : Point K X) {U : X.left.Opens} (s : Γ(X.left, U))
    (hp : p.schemePoint ∈ U) : ℝ :=
  p.absoluteValue (X.left.evaluation U p.schemePoint hp s)

/-- The actual local regular-evaluation topology. -/
def basicSets : Set (Set (Point K X)) :=
  {V | ∃ (U : X.left.Opens) (s : Γ(X.left, U)) (W : Set ℝ),
    IsOpen W ∧ V = {p | ∃ hp : p.schemePoint ∈ U, p.eval K X s hp ∈ W}}

instance pointTopology : TopologicalSpace (Point K X) :=
  TopologicalSpace.generateFrom (basicSets K X)

/-- The nonarchimedean part is an actual subtype, not an all-place proxy. -/
abbrev NonArchPoint := {p : Point K X // ∀ a b,
  p.absoluteValue (a + b) ≤ max (p.absoluteValue a) (p.absoluteValue b)}

/-- Existing Berkovich points give these precise nonarchimedean points. -/
def ofBerkovich (p : BerkovichAnalytification.Point K X) : NonArchPoint K X :=
  ⟨⟨p.schemePoint, p.absoluteValue, p.extends_norm⟩, p.ultrametric⟩

/-- Keep the normed residue-field type indexed by the actual absolute value. -/
def Residue (p : Point K X) : Type := X.left.residueField p.schemePoint

instance residueField (p : Point K X) : Field (Residue K X p) :=
  inferInstanceAs (Field (X.left.residueField p.schemePoint))

instance residueNormedField (p : Point K X) : NormedField (Residue K X p) :=
  p.absoluteValue.toNormedField

/-- The actual normed completion H(x), with native field and ring maps. -/
abbrev CompletedResidue (p : Point K X) := UniformSpace.Completion (Residue K X p)

/-- The native completion unit on the actual residue field. -/
def completionUnit (p : Point K X) :
    X.left.residueField p.schemePoint →+* CompletedResidue K X p :=
  (show Residue K X p →+* CompletedResidue K X p from
    UniformSpace.Completion.coeRingHom)

/-- The actual local-ring scalar map into H(x). -/
def localScalarMap (p : Point K X) :
    X.left.presheaf.stalk p.schemePoint →+* CompletedResidue K X p :=
  (completionUnit K X p).comp (X.left.residue p.schemePoint).hom

instance completedLocalAlgebra (p : Point K X) :
    Algebra (X.left.presheaf.stalk p.schemePoint) (CompletedResidue K X p) :=
  (localScalarMap K X p).toAlgebra

variable (L : X.left.Modules)

/-- The actual stalk of the module sheaf, with the native local-ring action. -/
abbrev moduleStalk (p : Point K X) :=
  TopCat.Presheaf.stalk L.val.presheaf p.schemePoint

/-- The genuine completed residue-field fibre H(x) tensor O_x L_x. -/
abbrev Fibre (p : Point K X) :=
  CompletedResidue K X p ⊗[X.left.presheaf.stalk p.schemePoint] moduleStalk K X L p

/-- A local section evaluates by its actual germ and the native pure tensor. -/
def evaluateSection {U : X.left.Opens} (s : L.val.obj (op U))
    (p : Point K X) (hp : p.schemePoint ∈ U) : Fibre K X L p :=
  1 ⊗ₜ[X.left.presheaf.stalk p.schemePoint]
    TopCat.Presheaf.germ L.val.presheaf U p.schemePoint hp s

/-- The actual zero section evaluates to zero in the completed fibre. -/
theorem evaluateSection_zero (U : X.left.Opens) (p : Point K X)
    (hp : p.schemePoint ∈ U) :
    evaluateSection K X L (0 : L.val.obj (op U)) p hp = 0 := by
  simp [evaluateSection]

/-- Scalars in local regular sections act through their actual residue value. -/
theorem evaluateSection_smul {U : X.left.Opens} (a : Γ(X.left, U))
    (s : L.val.obj (op U)) (p : Point K X) (hp : p.schemePoint ∈ U) :
    evaluateSection K X L (a • s) p hp =
      completionUnit K X p (X.left.evaluation U p.schemePoint hp a) •
        evaluateSection K X L s p hp := by
  unfold evaluateSection
  rw [PresheafOfModules.germ_smul (R := X.left.presheaf)]
  change (1 : CompletedResidue K X p) ⊗ₜ[X.left.presheaf.stalk p.schemePoint]
    (X.left.presheaf.germ U p.schemePoint hp a •
      TopCat.Presheaf.germ L.val.presheaf U p.schemePoint hp s) = _
  rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
  simp only [Algebra.smul_def, mul_one]
  rfl

/-- A genuine fibre norm, fixed to actual completed-field scalar action. -/
structure FibreNorm (p : Point K X) where
  norm : Fibre K X L p → ℝ
  nonnegative : ∀ v, 0 ≤ norm v
  zero : ∀ v, norm v = 0 ↔ v = 0
  triangle : ∀ v w, norm (v + w) ≤ norm v + norm w
  homogeneous : ∀ (a : CompletedResidue K X p) v, norm (a • v) = ‖a‖ * norm v

/-- A continuous metric on an actual algebraic line sheaf. -/
structure MetrizedLine where
  line : CoherentCurveLinearSeries.IsLineBundle L
  fibreNorm : ∀ p : Point K X, FibreNorm K X L p
  continuous : ∀ (U : X.left.Opens) (s : L.val.obj (op U)),
    Continuous (fun p : {p : Point K X // p.schemePoint ∈ U} ↦
      (fibreNorm p.val).norm (evaluateSection K X L s p.val p.property))

end MathlibExt.AlgebraicGeometry.ValuedLineFibres
