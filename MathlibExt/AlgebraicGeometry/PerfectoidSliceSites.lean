module

public import Mathlib.CategoryTheory.Comma.Over.Pullback
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.DenseSubsite.Basic
public import MathlibExt.AlgebraicGeometry.PerfectoidDiamondModels

/-!
# Actual slice v-sites and the diamond relation map

Small v-sheaves are characterized by affine-perfectoid covering families.
Their slice v-site contains every small v-sheaf over the given object;
its covering families are jointly epimorphic families of actual sheaf maps.
The affine test site retains the actual perfectoid rings and bounded maps.
The ring and plus-ring presheaves are literal restrictions of the affine
structural presheaves. Reindexing is actual composition of sheaf maps.

The map from a pro-etale relation to its quotient's kernel pair is the
native pullback lift of its two legs. Its invertibility is a separate
construction/proof request, not part of the definition of a relation.

Sources: Scholze, arXiv:1709.07343v4, Definitions 8.1, 12.1 and 14.1;
Proposition 11.3(ii). The sites here are universe-bounded models, rather than a claim of size
independence: the slice site over a small v-sheaf models `F_v` of Definition 14.1(iii), whose
objects are all maps from small v-sheaves. The affinoid perfectoid test category `AffineTest` is a
separate category; the comparison of its sheaf category with that of the slice site is not
formalized here.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.PerfectoidSliceSites

open CategoryTheory CategoryTheory.Limits Opposite
open AffinePerfectoidVSite PerfectoidDiamondModels

variable (p : ℕ) [Fact p.Prime]

/-- The actual affine-perfectoid Yoneda/sheafification functor. -/
def affineFunctor : Affine p ⥤ VSheaf p :=
  yoneda ⋙ (Functor.whiskeringRight _ _ _).obj liftTypes ⋙
    presheafToSheaf (topology p) (Type 1)

/-- A covering by actual perfectoid affine sheaves. -/
def HasPerfectoidCover (F : VSheaf p) : Prop :=
  ∃ (I : Type 1) (U : I → Affine p)
    (a : ∀ i, affineSheaf p (U i) ⟶ F),
    JointlyEpi p (fun i ↦ affineSheaf p (U i)) a

/-- The actual category of small v-sheaves at the declared universe bound. -/
abbrev SmallVSheaf :=
  (show ObjectProperty (VSheaf p) from HasPerfectoidCover p).FullSubcategory

/-- Joint surjectivity in the sheaf topos, expressed by joint epimorphy. -/
def JointlySurjective {I : Type 1} {F : SmallVSheaf p}
    (U : I → SmallVSheaf p) (a : ∀ i, U i ⟶ F) : Prop :=
  JointlyEpi p (fun i ↦ (U i).obj) (fun i ↦ (a i).hom)

/-- The v-topology generated by the actual jointly surjective families. -/
def vTopology : GrothendieckTopology (SmallVSheaf p) :=
  sInf {J | ∀ (I : Type 1) (F : SmallVSheaf p)
    (U : I → SmallVSheaf p) (a : ∀ i, U i ⟶ F),
    JointlySurjective p U a → Sieve.ofArrows U a ∈ J F}

/-- The v-site $F_v$ of a small v-sheaf $F$ (Scholze, *Étale cohomology of diamonds*,
Definition 14.1(iii)), as a category: the slice category over $F$ of small v-sheaves, whose
objects are all maps $F' \to F$ from small v-sheaves $F'$; its topology `siteTopology` is the
slice of the topology generated by jointly epimorphic families. Here $p$ is a prime, v-sheaves are
sheaves for the v-topology on affinoid perfectoid spaces of characteristic $p$, and a v-sheaf is
small when it admits a jointly epimorphic family of maps from affinoid perfectoid spaces indexed
in a fixed universe. -/
abbrev VSite (F : SmallVSheaf p) := Over F

/-- Its topology is the native slice of the actual v-topology. -/
def siteTopology (F : SmallVSheaf p) : GrothendieckTopology (VSite p F) :=
  (vTopology p).over F

/-- Reindex the actual slice site by composing its structure maps. -/
abbrev reindex {F G : SmallVSheaf p} (f : F ⟶ G) :
    VSite p F ⥤ VSite p G := Over.map f

/-- Native inverse image on sheaves, with every section restriction fixed. -/
abbrev inverseImage (A : Type*) [Category A]
    {F G : SmallVSheaf p} (f : F ⟶ G) :
    Sheaf (siteTopology p G) A ⥤ Sheaf (siteTopology p F) A :=
  (vTopology p).overMapPullback A f

/-- The native identity comparison for these inverse-image functors. -/
def inverseImageId (A : Type*) [Category A] (F : SmallVSheaf p) :
    inverseImage p A (𝟙 F) ≅ 𝟭 _ :=
  (vTopology p).overMapPullbackId A F

/-- The native composition comparison, with the actual slice maps. -/
def inverseImageComp (A : Type*) [Category A]
    {F G H : SmallVSheaf p} (f : F ⟶ G) (g : G ⟶ H) :
    inverseImage p A g ⋙ inverseImage p A f ≅ inverseImage p A (f ≫ g) :=
  (vTopology p).overMapPullbackComp A f g

/-- Every actual affine chart map into the specified v-sheaf. -/
abbrev AffineTest (F : VSheaf p) := CostructuredArrow (affineFunctor p) F

/-- Forget a chart map while retaining its real perfectoid algebra. -/
abbrev projection (F : VSheaf p) : AffineTest p F ⥤ Affine p :=
  CostructuredArrow.proj (affineFunctor p) F

/-- The affine test site's exact compact-open covering rule. -/
def testTopology (F : VSheaf p) : GrothendieckTopology (AffineTest p F) :=
  sInf {J | ∀ (I : Type 1) (T : AffineTest p F)
    (U : I → AffineTest p F) (a : ∀ i, U i ⟶ T),
    IsVCover p ((projection p F).obj T)
      (fun i ↦ (projection p F).obj (U i))
      (fun i ↦ (projection p F).map (a i)) → Sieve.ofArrows U a ∈ J T}

/-- The same actual chart with its map postcomposed by the specified map. -/
abbrev reindexTests {F G : VSheaf p} (f : F ⟶ G) :
    AffineTest p F ⥤ AffineTest p G := CostructuredArrow.map f

/-- Postcomposition leaves the actual local perfectoid algebra unchanged. -/
theorem reindexTests_projection {F G : VSheaf p} (f : F ⟶ G) :
    reindexTests p f ⋙ projection p G = projection p F := rfl

/-- The literal ring presheaf on the actual affine tests. -/
def structurePresheaf (F : VSheaf p) : (AffineTest p F)ᵒᵖ ⥤ CommRingCat.{1} :=
  (projection p F).op ⋙ AffinePerfectoidVSite.structurePresheaf p

/-- The literal plus-ring presheaf on the actual affine tests. -/
def integralPresheaf (F : VSheaf p) : (AffineTest p F)ᵒᵖ ⥤ CommRingCat.{1} :=
  (projection p F).op ⋙ AffinePerfectoidVSite.integralPresheaf p

/-- An affine test has precisely its own plus ring as coefficients. -/
theorem integralPresheaf_obj (F : VSheaf p) (T : AffineTest p F) :
    (integralPresheaf p F).obj (op T) = CommRingCat.of (ULift.{1} T.left.plus) := rfl

/-- The quotient atlas map is the actual coequalizer arrow. -/
abbrev quotientAtlas (R : Relation p) : R.X.sheaf ⟶ Relation.quotient p R :=
  coequalizer.π R.source R.target

/-- The prescribed relation-to-kernel-pair comparison. -/
def relationToKernel (R : Relation p) :
    R.R.sheaf ⟶ pullback (quotientAtlas p R) (quotientAtlas p R) :=
  pullback.lift R.source R.target (coequalizer.condition R.source R.target)

/-- The first comparison leg is the original source map. -/
theorem relationToKernel_fst (R : Relation p) :
    relationToKernel p R ≫ pullback.fst (quotientAtlas p R) (quotientAtlas p R) =
      R.source := pullback.lift_fst _ _ _

/-- The second comparison leg is the original target map. -/
theorem relationToKernel_snd (R : Relation p) :
    relationToKernel p R ≫ pullback.snd (quotientAtlas p R) (quotientAtlas p R) =
      R.target := pullback.lift_snd _ _ _

end MathlibExt.AlgebraicGeometry.PerfectoidSliceSites
