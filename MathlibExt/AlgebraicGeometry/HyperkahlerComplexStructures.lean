/-!
# Actual complex structures and simple hyperkähler hypotheses

The underlying manifold has a fixed real smooth structure. A variable
complex structure is an actual smooth tangent operator J with J²=-1 that
is integrable: it admits an atlas of complex coordinate charts, normalized by
their derivatives. Only the existence of such an atlas is recorded, so a
complex structure is determined by its operator. Its topology is generated by
uniform bounds for every actual chart jet on every compact subset, namely the
usual smooth topology. Holomorphic forms are holomorphic in every complex chart
of every such atlas; Kähler positivity and symplectic nondegeneracy are tested
on the operator. Neither a Hodge carrier nor a period map is selected.

Complex-valued real-smooth forms are the actual real/imaginary pair of the
native smooth real tangent forms. H² is the real closed/exact quotient;
its complexification is the native tensor C⊗_R H², not the holomorphic-form
quotient obtained by changing the differentiability field to C.

Source: Verbitsky, arXiv:0908.4121v8, sections 1.1–1.3 and
Definitions 1.5, 1.8. Ordinary form/integration source credits are retained
in the imported modules; native charts, derivatives, diffeomorphisms and
tensor products are Mathlib 56a005855ea17e0b0958f73ec801ae140b0a1679,
Apache 2.0 (Nicolò Cavalleri, Yury Kudryashov and Mathlib contributors).
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.HyperkahlerComplexStructures

open _root_.CategoryTheory TopologicalSpace ManifoldDifferentialForms
open KahlerClassGeometry CoordinateFormIntegrals
open scoped Manifold ContDiff TensorProduct

abbrev Ambient (n : ℕ) := Coordinates (2 * n)

variable (n : ℕ) (M : Type) [TopologicalSpace M] [ChartedSpace (Ambient n) M]
  [IsManifold 𝓘(ℝ, Ambient n) ∞ M]

abbrev TangentOperator := (x : M) → TangentSpace 𝓘(ℝ, Ambient n) x →L[ℝ]
  TangentSpace 𝓘(ℝ, Ambient n) x

def complexCoordinateMultiply (v : Ambient n) : Ambient n := Complex.I • v

def chartOperator (J : TangentOperator n M) (a : M) (z : Ambient n) :
    Ambient n →L[ℝ] Ambient n :=
  let f := extChartAt 𝓘(ℝ, Ambient n) a
  (mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f (f.symm z)).comp
    ((J (f.symm z)).comp (mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f.symm z))

def IsSmoothOperator (J : TangentOperator n M) : Prop :=
  ∀ a : M, ContDiffOn ℝ ∞ (chartOperator n M J a) (extChartAt 𝓘(ℝ, Ambient n) a).target

/-- An atlas of complex coordinate charts for the operator `J`: smooth charts
whose derivatives carry `J` to multiplication by `i`, with holomorphic
transitions. -/
structure ComplexAtlas (J : TangentOperator n M) where
  charts : Set (OpenPartialHomeomorph M (Ambient n))
  atPoint : M → OpenPartialHomeomorph M (Ambient n)
  mem : ∀ x, atPoint x ∈ charts
  source : ∀ x, x ∈ (atPoint x).source
  smooth : ∀ f ∈ charts,
    ContMDiffOn 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) ∞ f f.source
  smoothInverse : ∀ f ∈ charts,
    ContMDiffOn 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) ∞ f.symm f.target
  holomorphicTransitions : ∀ f ∈ charts, ∀ g ∈ charts,
    ContDiffOn ℂ ∞ (fun z ↦ g (f.symm z)) (f.target ∩ f.symm ⁻¹' g.source)
  complexDerivative : ∀ f ∈ charts, ∀ x ∈ f.source, ∀ v : Ambient n,
    mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f x (J x v) =
      complexCoordinateMultiply n (mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f x v)
  orientation : ∀ f ∈ charts, ∀ x ∈ f.source,
    0 < LinearMap.det (mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f x).toLinearMap

/-- An integrable almost complex structure: a smooth tangent operator with
`J² = -1` admitting a complex atlas. It is determined by its operator. -/
@[ext]
structure ComplexStructure where
  operator : TangentOperator n M
  square : ∀ x v, operator x (operator x v) = -v
  smooth : IsSmoothOperator n M operator
  integrable : Nonempty (ComplexAtlas n M operator)

def jetBall (r : ℕ) (a : M) (K : Set (Ambient n)) (I : ComplexStructure n M) (epsilon : ℝ) :
    Set (ComplexStructure n M) :=
  {J | ∀ z ∈ K,
    ‖iteratedFDerivWithin ℝ r (chartOperator n M J.operator a)
        (extChartAt 𝓘(ℝ, Ambient n) a).target z -
      iteratedFDerivWithin ℝ r (chartOperator n M I.operator a)
        (extChartAt 𝓘(ℝ, Ambient n) a).target z‖ < epsilon}

instance complexStructureTopology : TopologicalSpace (ComplexStructure n M) :=
  TopologicalSpace.generateFrom {U | ∃ (r : ℕ) (a : M) (K : Set (Ambient n)),
    IsCompact K ∧ K ⊆ (extChartAt 𝓘(ℝ, Ambient n) a).target ∧
      ∃ (I : ComplexStructure n M) (epsilon : ℝ), 0 < epsilon ∧
        U = jetBall n M r a K I epsilon}

variable [ExteriorTheory ℝ (Ambient n) M]

abbrev RealForms (p : ℕ) := GlobalForms ℝ (Ambient n) M p
abbrev ComplexForms (p : ℕ) := RealForms n M p × RealForms n M p
abbrev RealH2 := DeRhamH2 ℝ (Ambient n) M
abbrev ComplexH2 := ℂ ⊗[ℝ] RealH2 n M

def formValue (alpha : ComplexForms n M 2) (x : M) (u v : Ambient n) : ℂ :=
  (alpha.1.val ⟨x, by trivial⟩ ![u, v] : ℂ) +
    Complex.I * (alpha.2.val ⟨x, by trivial⟩ ![u, v] : ℂ)

def chartFormValue (alpha : ComplexForms n M 2) (f : OpenPartialHomeomorph M (Ambient n))
    (z : Ambient n) (v : Fin 2 → Ambient n) : ℂ := by
  classical
  exact if hz : z ∈ f.target then
    let x := f.symm z
    let df := mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f.symm z
    (alpha.1.val ⟨x, by trivial⟩ (fun i ↦ df (v i)) : ℂ) +
      Complex.I * (alpha.2.val ⟨x, by trivial⟩ (fun i ↦ df (v i)) : ℂ)
  else 0

structure HolomorphicTwoForm (I : ComplexStructure n M) where
  form : ComplexForms n M 2
  type : ∀ x u v,
    formValue n M form x (I.operator x u) v = Complex.I * formValue n M form x u v
  holomorphic : ∀ (atlas : ComplexAtlas n M I.operator), ∀ f ∈ atlas.charts,
    ∀ v : Fin 2 → Ambient n,
    ContDiffOn ℂ ∞ (fun z ↦ chartFormValue n M form f z v) f.target

def IsClosed (alpha : ComplexForms n M 2) : Prop :=
  d ℝ (Ambient n) M 2 alpha.1 = 0 ∧ d ℝ (Ambient n) M 2 alpha.2 = 0

def complexClass (alpha : ComplexForms n M 2) (h : IsClosed n M alpha) : ComplexH2 n M :=
  TensorProduct.tmul ℝ (1 : ℂ)
      (classOfClosedTwoForm ℝ (Ambient n) M ⟨alpha.1, h.1⟩) +
    TensorProduct.tmul ℝ Complex.I
      (classOfClosedTwoForm ℝ (Ambient n) M ⟨alpha.2, h.2⟩)

structure KahlerWitness (I : ComplexStructure n M) where
  form : closedForms ℝ (Ambient n) M 2
  type : ∀ x u v,
    form.val.val ⟨x, by trivial⟩ ![I.operator x u, I.operator x v] =
      form.val.val ⟨x, by trivial⟩ ![u, v]
  positive : ∀ x (v : Ambient n), v ≠ 0 →
    0 < form.val.val ⟨x, by trivial⟩ ![v, I.operator x v]

structure HyperkahlerType (I : ComplexStructure n M) where
  kahler : KahlerWitness n M I
  symplectic : HolomorphicTwoForm n M I
  closed : IsClosed n M symplectic.form
  nondegenerate : ∀ x (u : Ambient n), u ≠ 0 →
    ∃ v : Ambient n, formValue n M symplectic.form x u v ≠ 0
  h20 : ∀ theta : HolomorphicTwoForm n M I, ∃ c : ℂ,
    ∀ x u v, formValue n M theta.form x u v = c * formValue n M symplectic.form x u v

/-- Witnesses do not add extra metric or symplectic-form choices to the
space of complex structures. -/
abbrev HyperkahlerStructures := {I : ComplexStructure n M // Nonempty (HyperkahlerType n M I)}

def chosenHyperkahler (I : HyperkahlerStructures n M) : HyperkahlerType n M I.val :=
  Classical.choice I.property

def symplecticClass (I : HyperkahlerStructures n M) : ComplexH2 n M :=
  complexClass n M (chosenHyperkahler n M I).symplectic.form (chosenHyperkahler n M I).closed

def periodLine (I : HyperkahlerStructures n M) : Submodule ℂ (ComplexH2 n M) :=
  Submodule.span ℂ {symplecticClass n M I}

end MathlibExt.AlgebraicGeometry.HyperkahlerComplexStructures
