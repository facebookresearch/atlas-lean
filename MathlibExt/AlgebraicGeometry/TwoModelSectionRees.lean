/-!
# Actual two-model section-Rees generators and coefficient comparison

The filtration is the published intersection/rescaling/reduction of
actual R-section lattices. Special-fibre coordinates use a single actual
scheme/line isomorphism and the native powers of that same line map.
The Rees ring is the subalgebra generated by the actual filtered-section
monomials z^m t^-a and the parameter t inside a literal Laurent polynomial
ring. Its coefficientwise comparison is a separate normalized obligation,
not a freely supplied graded algebra or degeneration score.

Source: Blum--Xu arXiv1812.03538v2, §§3--4. Generic Rees/Proj and section
algebra constructions are source-covered; their exact two-model comparison
remains explicit.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

attribute [local instance 2000] CommRing.toCommSemiring CommRing.toRing Ring.toSemiring

namespace MathlibExt.AlgebraicGeometry.TwoModelSectionRees

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.AlgebraicGeometry
open _root_.CategoryTheory.MonoidalCategory
open MathlibExt.AlgebraicGeometry.LogPairs
open MathlibExt.AlgebraicGeometry.DVRSectionLattices
open MathlibExt.AlgebraicGeometry.DVRGradedSectionFamilies
open MathlibExt.AlgebraicGeometry.GenericSectionMaps
open MathlibExt.AlgebraicGeometry.LineBundleTaskContracts
open MathlibExt.AlgebraicGeometry.CenteredValuationSections
open MathlibExt.AlgebraicGeometry.BirationalSectionCoordinates
open MathlibExt.AlgebraicGeometry.RestrictedAdjointSections
attribute [local instance] LogPairs.fractionAlgebra

variable {R K : Type} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field K] [Algebra R K] [IsFractionRing R K]

/-- Actual special-fibre normal variety, line and rational section coordinates. -/
structure SpecialCoordinates (D : TwoModels (R := R) (K := K)) (n : ℕ) where
  variety : NormalVariety (IsLocalRing.ResidueField R) n
  valuation : CenteredValuation variety
  series : SectionSeries variety valuation
  schemeIso : specialFiber D.first ≅ variety.X
  lineIso : (Scheme.Modules.pullback
    (schemeIso.inv.left ≫ specialProjection D.first)).obj D.firstLine ≅ series.line
  powers : PowerPullback (schemeIso.inv.left ≫ specialProjection D.first)
  product : SectionProduct series.line
  productNormalized : ∀ a b
    (s : GenericSectionMaps.Sections variety.X (power series.line a))
    (t : GenericSectionMaps.Sections variety.X (power series.line b)),
    (series.evaluation (a+b)).map (sectionProduct product a b s t) =
      (series.evaluation a).map s * (series.evaluation b).map t
  unitNormalized : (series.evaluation 0).map
    (homSection variety.X (𝟙 (CoherentCurveLinearSeries.structureModule variety.X.left))) = 1

namespace SpecialCoordinates
variable {D : TwoModels (R := R) (K := K)} {n : ℕ} (A : SpecialCoordinates D n)

/-- Every power coordinate comparison is computed from the same line comparison. -/
def moduleIso (m : ℕ) :
    (Scheme.Modules.pullback A.schemeIso.inv.left).obj
      ((Scheme.Modules.pullback (specialProjection D.first)).obj (power D.firstLine m)) ≅
        power A.series.line m :=
  (Scheme.Modules.pullbackComp A.schemeIso.inv.left (specialProjection D.first)).app
      (power D.firstLine m) ≪≫
  (A.powers.powers.comparison m).app D.firstLine ≪≫
  (powerFunctor A.variety.X.left m).mapIso A.lineIso

/-- Literal actual special-section pullback followed by the fixed germ evaluator. -/
def sectionValue (m : ℕ) (s : SpecialRSections D.first (power D.firstLine m)) :
    FunctionField A.variety := by
  let s' : GenericSectionMaps.Sections (specialFiber D.first)
      ((Scheme.Modules.pullback (specialProjection D.first)).obj (power D.firstLine m)) := s
  exact (A.series.evaluation m).map (pullSection A.schemeIso.inv (A.moduleIso m).hom s')

abbrev Ambient := LaurentPolynomial (Polynomial (FunctionField A.variety))

@[instance_reducible]
def ambientAlgebra : Algebra (IsLocalRing.ResidueField R) A.Ambient := by
  letI := fractionAlgebra A.variety
  infer_instance

attribute [local instance] ambientAlgebra

/-- Every coefficient image is the span of actual reduced filtered sections. -/
def coefficientImage (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K))
    (m : ℕ) (a : ℤ) : Submodule (IsLocalRing.ResidueField R) (FunctionField A.variety) := by
  letI := fractionAlgebra A.variety
  exact Submodule.span (IsLocalRing.ResidueField R)
    {v | ∃ s ∈ D.forwardFiltration C u m a, v = A.sectionValue m s}

/-- Actual filtered-section monomial in two formal variables. -/
def sectionMonomial (m : ℕ) (a : ℤ) (s : SpecialRSections D.first (power D.firstLine m)) :
    A.Ambient :=
  LaurentPolynomial.C (Polynomial.monomial m (A.sectionValue m s)) * LaurentPolynomial.T (-a)

/-- The Rees algebra is generated by actual filtered sections and the actual parameter. -/
def reesAlgebra (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :
    Subalgebra (IsLocalRing.ResidueField R) A.Ambient := by
  letI := A.ambientAlgebra
  exact Algebra.adjoin (IsLocalRing.ResidueField R)
    ({LaurentPolynomial.T 1} ∪
      {r | ∃ m : ℕ, ∃ a : ℤ, ∃ s ∈ D.forwardFiltration C u m a,
        r = A.sectionMonomial m a s})

/-- Exact coefficientwise condition for the geometric Rees comparison. -/
def HasReesCoefficients (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :
    Prop :=
  ∀ r : A.Ambient, r ∈ A.reesAlgebra C u ↔
    ∀ a : ℤ, ∀ m : ℕ, (r.coeff a).coeff m ∈
      A.coefficientImage C u m (-a)

/-- The parameter is the actual degree-zero Laurent monomial t. -/
def parameter (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :
    A.reesAlgebra C u :=
  ⟨LaurentPolynomial.T 1, Algebra.subset_adjoin (Or.inl (Set.mem_singleton _))⟩

/-- The actual special graded coefficient ring is the fixed parameter-zero quotient. -/
def centralRing (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :=
  (A.reesAlgebra C u) ⧸ Ideal.span {A.parameter C u}

/-- The actual parameter-one fibre coefficient ring. -/
def fibreOneRing (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :=
  (A.reesAlgebra C u) ⧸ Ideal.span {A.parameter C u - 1}

/-- Inverting t is expressed by adjoining its actual Laurent inverse in the same ambient ring. -/
def genericAlgebra (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :
    Subalgebra (IsLocalRing.ResidueField R) A.Ambient :=
  Algebra.adjoin (IsLocalRing.ResidueField R)
    ((A.reesAlgebra C u : Set A.Ambient) ∪ {LaurentPolynomial.T (-1)})

/-- The literal Laurent section algebra of the actual polarized special fibre. -/
def sectionLaurentAlgebra : Subalgebra (IsLocalRing.ResidueField R) A.Ambient :=
  Algebra.adjoin (IsLocalRing.ResidueField R)
    ({LaurentPolynomial.T 1, LaurentPolynomial.T (-1)} ∪
      {r | ∃ m : ℕ, ∃ s : SpecialRSections D.first (power D.firstLine m),
        r = A.sectionMonomial m 0 s})


/-- The base polynomial algebra is computed by the actual parameter t. -/
@[instance_reducible]
def parameterAlgebra (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) :
    Algebra (Polynomial (IsLocalRing.ResidueField R)) (A.reesAlgebra C u) :=
  (Polynomial.aeval (A.parameter C u)).toRingHom.toAlgebra

attribute [local instance] parameterAlgebra

/-- Native grading certificate: every piece has exactly the actual z-homogeneous coefficients. -/
structure ReesGrading (C : D.GradedComparisons) (u : Uniformizer (R := R) (K := K)) where
  pieces : ℕ → Submodule (Polynomial (IsLocalRing.ResidueField R)) (A.reesAlgebra C u)
  normalized : ∀ m (r : A.reesAlgebra C u), r ∈ pieces m ↔
    ∀ a : ℤ, ∀ j : ℕ, j ≠ m → ((r.val.coeff a).coeff j) = 0
  [graded : GradedAlgebra pieces]

namespace ReesGrading
variable {C : D.GradedComparisons} {u : Uniformizer (R := R) (K := K)}
  (G : ReesGrading A C u)

/-- The actual projective scheme of the fixed graded Rees algebra. -/
def scheme : Scheme.{0} := by
  letI := A.parameterAlgebra C u
  letI := G.graded
  exact Proj G.pieces

/-- Native Proj map to the actual parameter affine line. -/
def projection : G.scheme ⟶ Spec (.of (Polynomial (IsLocalRing.ResidueField R))) := by
  letI := A.parameterAlgebra C u
  letI := G.graded
  exact MathlibExt.AlgebraicGeometry.ProjectiveSpace.projToSpec G.pieces

def asOver : Over (Spec (.of (IsLocalRing.ResidueField R))) :=
  Over.mk (G.projection ≫ (PolarizedTestConfigurations.AffineLine (IsLocalRing.ResidueField R)).hom)

def overProjection :
    G.asOver ⟶ PolarizedTestConfigurations.AffineLine (IsLocalRing.ResidueField R) :=
  Over.homMk G.projection

/-- Desired exact two-model Rees realization on the fixed native Proj.
The generic comparison is over the actual Laurent parameter; the algebra
identification is the computed inclusion in the common coefficient ring. -/
structure Realization where
  coefficients : A.HasReesCoefficients C u
  genericAlgebra : A.genericAlgebra C u = A.sectionLaurentAlgebra
  [flat : Flat G.projection]
  projective : RelativeProjectivity.IsHProjectiveOver G.overProjection
  genericIso : pullback G.overProjection
      (PolarizedTestConfigurations.torusInclusion (IsLocalRing.ResidueField R)) ≅
    A.variety.X ⊗ PolarizedTestConfigurations.Torus (IsLocalRing.ResidueField R)
  genericOver : genericIso.hom ≫
      CategoryTheory.CartesianMonoidalCategory.snd A.variety.X
        (PolarizedTestConfigurations.Torus (IsLocalRing.ResidueField R)) = pullback.snd _ _

/-- The central fibre is a literal scheme fibre of the computed Proj map. -/
def central :=
  pullback G.overProjection (PolarizedTestConfigurations.affinePoint (IsLocalRing.ResidueField R) 0)

/-- A central log-Fano comparison has an actual normal log pair and actual fibre isomorphism.
This is a result type, not a claimed constructor for arbitrary filtrations. -/
structure CentralLogFano where
  pair : LogPair (IsLocalRing.ResidueField R) n
  comparison : G.central ≅ pair.variety.X
  klt : IsKlt pair
  adjointAmple : RelativeMoriContracts.IsRelativelyAmpleR
    (CategoryTheory.Over.homMk pair.variety.X.hom :
      pair.variety.X ⟶ CategoryTheory.Over.mk (𝟙 (Spec (.of (IsLocalRing.ResidueField R)))))
    (RelativeMoriContracts.negativeCombination pair.adjoint)

end ReesGrading

end SpecialCoordinates
end MathlibExt.AlgebraicGeometry.TwoModelSectionRees
