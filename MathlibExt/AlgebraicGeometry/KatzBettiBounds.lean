module

public import MathlibExt.AlgebraicGeometry.ContinuousAdicCompactSupports
public import Mathlib.Algebra.MvPolynomial.Degrees

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

/-!
# Affine schemes cut out by equations, and their compact `ℓ`-adic Betti numbers

`affineVariety F` is the affine scheme `Spec(k[x_1, …, x_N]/(F_1, …, F_r))` over `k`. Its
compactly supported rational `ℓ`-adic cohomology, computed in a compactification `c`, is
`CompactAdicCohomology ell c n`: `Ext` from the constant sheaf into the compact-support kernel
`ker(F → i_* i^* F) = j_! j^* F` of the sheaf `F = C(-, ℚ_ℓ)`, that is `H^n(Y, j_! j^* F)`,
which is `H^n_c` in the sense of Bhatt–Scholze, Definition 6.7.6 (see
`ContinuousAdicCompactSupports`). `katzBound N r d = 6 · 2^r · (3 + r d)^(N + 1)` is Katz's bound
for the sum of the compact Betti numbers.

Reference: N. M. Katz, Sums of Betti numbers in arbitrary characteristic,
Corollary of Theorem 1, p. 4, https://web.math.princeton.edu/~nmk/BettiSum14.pdf.
-/

namespace MathlibExt.AlgebraicGeometry.KatzBettiBounds

open CategoryTheory CategoryTheory.Limits
open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme
open MathlibExt.AlgebraicGeometry.ContinuousAdicCoefficients
open MathlibExt.AlgebraicGeometry.ProEtaleCohomologyFunctoriality
open MathlibExt.AlgebraicGeometry.ContinuousAdicCompactSupports

universe u

/-- The ideal generated by the equations. -/
def equationsIdeal {k : Type u} [Field k] {N r : ℕ}
    (F : Fin r → MvPolynomial (Fin N) k) : Ideal (MvPolynomial (Fin N) k) :=
  Ideal.span (Set.range F)

/-- The coordinate ring `k[x_1, …, x_N]/(F_1, …, F_r)`. -/
abbrev affineCoordinateRing {k : Type u} [Field k] {N r : ℕ}
    (F : Fin r → MvPolynomial (Fin N) k) :=
  MvPolynomial (Fin N) k ⧸ equationsIdeal F

/-- The affine scheme cut out by the equations, over `k`. -/
def affineVariety {k : Type u} [Field k] {N r : ℕ}
    (F : Fin r → MvPolynomial (Fin N) k) : Over (Spec (.of k)) :=
  Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k (affineCoordinateRing F))))

/-- The kernel of the unit `F → i_* i^* F` for sheaves of modules. -/
def moduleBoundaryKernel (R : Type) [CommRing R] {Z Y : Scheme.{u}} (i : Z ⟶ Y) :
    CoefficientSheaf Y R ⥤ CoefficientSheaf Y R := by
  let : HasLimits (ModuleCat.{u + 1} R) :=
    ModuleCat.hasLimitsOfSize.{u + 1, u + 1, u + 1, 0}
  exact kernel (pullbackAdjunction R i).unit

/-- Compactly supported rational `ℓ`-adic cohomology, computed in the compactification `c`. -/
abbrev CompactAdicCohomology {k : Type u} [Field k] {X : Over (Spec (.of k))}
    (ell : ℕ) [Fact ell.Prime] (c : ClosedCompactification X) (n : ℕ) :=
  Cohomology ℚ_[ell] c.ambient.left
    ((moduleBoundaryKernel ℚ_[ell] c.closedMap).obj
      (continuousModuleSheaf ℚ_[ell] (ULift.{u + 1} ℚ_[ell]) c.ambient.left)) n

/-- Katz's explicit constant $6 \cdot 2^r (3 + r d)^{N+1}$ in the Corollary of Theorem 1. -/
def katzBound (N r d : ℕ) : ℕ := 6 * 2 ^ r * (3 + r * d) ^ (N + 1)

end MathlibExt.AlgebraicGeometry.KatzBettiBounds
