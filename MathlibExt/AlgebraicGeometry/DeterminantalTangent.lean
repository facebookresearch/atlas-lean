module

public import MathlibExt.AlgebraicGeometry.AffineTangent
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# Tangents of generic determinantal schemes

The defining ideal is generated by the actual `(r+1)`-minor polynomials.
The tangent module uses their polynomial differentials, preserving the
scheme equations rather than substituting an arbitrary rank-locus object.

Reference: Bruns–Vetter, *Determinantal Rings*, Chapter 2,
https://doi.org/10.1007/BFb0080378.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.DeterminantalTangent

open MathlibExt.AlgebraicGeometry.AffineTangent

variable {k : Type*} [Field k] {m n : ℕ}

/-- A generic minor, indexed by actual row and column selections. -/
def minorPolynomial (r : ℕ) (rows : Fin (r + 1) ↪ Fin m)
    (cols : Fin (r + 1) ↪ Fin n) : MvPolynomial (Fin m × Fin n) k :=
  Matrix.det (fun i j : Fin (r + 1) ↦ MvPolynomial.X (rows i, cols j))

/-- Equations of the generic scheme of matrices with rank at most `r`. -/
def minorIdeal (r : ℕ) : Ideal (MvPolynomial (Fin m × Fin n) k) :=
  Ideal.span (Set.range fun p :
      (Fin (r + 1) ↪ Fin m) × (Fin (r + 1) ↪ Fin n) ↦
    minorPolynomial r p.1 p.2)

/-- The actual polynomial tangent module at the matrix `A`. -/
def tangent (r : ℕ) (A : Matrix (Fin m) (Fin n) k) :
    Submodule k ((Fin m × Fin n) → k) :=
  tangentIdeal (minorIdeal r) (fun ij ↦ A ij.1 ij.2)

end MathlibExt.AlgebraicGeometry.DeterminantalTangent
