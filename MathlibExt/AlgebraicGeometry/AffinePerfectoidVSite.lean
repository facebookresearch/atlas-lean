module

public import Mathlib.Topology.Compactness.Compact
public import Mathlib.CategoryTheory.Sites.Grothendieck
public import Mathlib.CategoryTheory.Sites.Sheafification
public import Mathlib.Algebra.Category.Ring.Limits
public import Mathlib.Algebra.Ring.ULift
public import MathlibExt.RingTheory.CompleteHuberPairModels

/-!
# The actual affine characteristic-p perfectoid v-site

Objects are the complete uniform Tate Huber-pair models. Their point
spaces contain all valuation ranks. The v-cover rule is the literal
finite-cover condition on every quasicompact open subset; it is not an
arbitrary predicate called a cover.

The two structural presheaves have the actual rings and plus rings as
values. Their sheafifications are specified canonically. General global
atlas/pro-etale/diamond realizations are separate normalized providers,
not an assertion that every v-sheaf is a perfectoid space.

Reference: Scholze, *Etale cohomology of diamonds*,
arXiv:1709.07343v4, Definition 8.1(iii), p39. Completed local ring/Spa
source primitives are credited by their imported standalone models.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.AffinePerfectoidVSite

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open MathlibExt.RingTheory.CompleteHuberPairModels

variable (p : ℕ) [Fact p.Prime]

abbrev Affine := CharPPerfectoidPair p
abbrev Space (P : Affine p) := P.toHuberPair.Space

/-- The actual continuous map on all-rank affine perfectoid points. -/
def topologicalMap {P Q : Affine p} (f : P ⟶ Q) :
    TopCat.of (Space p P) ⟶ TopCat.of (Space p Q) :=
  TopCat.ofHom ⟨spaceMap p f, continuous_spaceMap p f⟩

/-- The defining finite quasicompact-open condition of a v-cover. -/
def IsVCover {ι : Type 1} (P : Affine p) (U : ι → Affine p)
    (f : ∀ i, U i ⟶ P) : Prop :=
  ∀ W : Opens (Space p P), IsCompact (W : Set (Space p P)) →
    ∃ J : Finset ι, ∃ V : ∀ i, Opens (Space p (U i)),
      (∀ i ∈ J, IsCompact (V i : Set (Space p (U i)))) ∧
      (W : Set (Space p P)) = ⋃ i ∈ J,
        spaceMap p (f i) '' (V i : Set (Space p (U i)))

/-- The Grothendieck topology generated by these actual v-cover families. -/
def topology : GrothendieckTopology (Affine p) :=
  sInf {J | ∀ (ι : Type 1) (P : Affine p) (U : ι → Affine p)
    (f : ∀ i, U i ⟶ P), IsVCover p P U f →
      Sieve.ofArrows U f ∈ J P}

theorem cover_mem {ι : Type 1} (P : Affine p) (U : ι → Affine p)
    (f : ∀ i, U i ⟶ P) (h : IsVCover p P U f) :
    Sieve.ofArrows U f ∈ topology p P := by
  rw [topology, GrothendieckTopology.mem_sInf]
  intro J hJ
  exact hJ ι P U f h

/-- The actual structural ring presheaf, with only a universe lift. -/
def structurePresheaf : (Affine p)ᵒᵖ ⥤ CommRingCat.{1} where
  obj P := CommRingCat.of (ULift.{1} P.unop.ring)
  map f := CommRingCat.ofHom
    (ULift.ringEquiv.symm.toRingHom.comp
      (f.unop.hom.comp ULift.ringEquiv.toRingHom))
  map_id _ := by ext a; rfl
  map_comp _ _ := by ext a; rfl

/-- The actual integral structural ring presheaf. -/
def integralPresheaf : (Affine p)ᵒᵖ ⥤ CommRingCat.{1} where
  obj P := CommRingCat.of (ULift.{1} P.unop.plus)
  map f := CommRingCat.ofHom
    { toFun a := ULift.up ⟨f.unop.hom a.down, f.unop.plus _ a.down.2⟩
      map_zero' := ULift.ext (Subtype.ext (map_zero _))
      map_one' := ULift.ext (Subtype.ext (map_one _))
      map_add' _ _ := ULift.ext (Subtype.ext (map_add _ _ _))
      map_mul' _ _ := ULift.ext (Subtype.ext (map_mul _ _ _)) }
  map_id _ := by ext a; rfl
  map_comp _ _ := by ext a; rfl

/-- Actual v-sheaves on the affine perfectoid basis. -/
abbrev VSheaf := Sheaf (topology p) (Type 1)

/-- The canonically sheafified structural ring. -/
def structureSheaf [HasSheafify (topology p) CommRingCat.{1}] :
    Sheaf (topology p) CommRingCat.{1} :=
  (presheafToSheaf (topology p) CommRingCat.{1}).obj
    (structurePresheaf p)

/-- The canonically sheafified integral structural ring. -/
def integralSheaf [HasSheafify (topology p) CommRingCat.{1}] :
    Sheaf (topology p) CommRingCat.{1} :=
  (presheafToSheaf (topology p) CommRingCat.{1}).obj
    (integralPresheaf p)

end MathlibExt.AlgebraicGeometry.AffinePerfectoidVSite
