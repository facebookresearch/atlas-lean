/-!
# Actual marked periods and birational Teichmüller quotients

Teich is the quotient of actual integrable hyperkähler complex structures
by actual smooth isotopies and their derivative pullbacks. Its topology is
the quotient of the smooth chart-jet topology. Birational Teich is the
equivalence quotient generated by the source's neighbourhood-intersection
inseparability relation. This relation is not Mathlib's `Inseparable`,
which means identical neighbourhood filters. Transitivity and Hausdorff
manifold realization are source conclusions, not defining assumptions.

The period point is a line in the native complexified marked lattice with
the actual isotropic/positive BBF predicates. The period map is normalized
to the actual class of the holomorphic symplectic form. Its manifold
presentations are normalized: period charts are literal projective basis
ratios; Teich charts are exactly the quotient smooth structure detected by
all actual smooth J-families, with actual local J-family inverses.
Consequently a native diffeomorphism of these presentations is a geometric
Torelli target, not an atlas selected solely to make an arbitrary map smooth.

Source: Verbitsky, arXiv:0908.4121v8, Definitions 1.5, 1.8, 1.13,
Theorems 1.9, 1.15 and 1.17. Native projectivization, topology and
diffeomorphisms are Mathlib 56a005855ea17e0b0958f73ec801ae140b0a1679,
Apache 2.0 (source headers retained in dependencies). No abstract Hodge
isometry is asserted to imply birational equivalence.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.HyperkahlerPeriods

open _root_.CategoryTheory TopologicalSpace HyperkahlerComplexStructures ManifoldDifferentialForms
open BeauvilleBogomolovForms SmoothDeRhamBettiBridge KahlerClassGeometry CoordinateFormIntegrals
open scoped Manifold ContDiff TensorProduct Topology

variable (n : ℕ) (M : Type) [TopologicalSpace M] [ChartedSpace (Ambient n) M]
  [IsManifold 𝓘(ℝ, Ambient n) ∞ M] [ExteriorTheory ℝ (Ambient n) M]

abbrev SmoothSelfDiffeomorphism := Diffeomorph 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) M M ∞

structure SmoothIsotopy (f : SmoothSelfDiffeomorphism n M) where
  family : ℝ → SmoothSelfDiffeomorphism n M
  zero : family 0 = Diffeomorph.refl 𝓘(ℝ, Ambient n) M ∞
  one : family 1 = f
  smooth : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, Ambient n)) 𝓘(ℝ, Ambient n) ∞
    (fun tx : ℝ × M ↦ family tx.1 tx.2)
  inverseSmooth : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, Ambient n)) 𝓘(ℝ, Ambient n) ∞
    (fun tx : ℝ × M ↦ (family tx.1).symm tx.2)

def isotopyRelation (I J : HyperkahlerStructures n M) : Prop :=
  ∃ f : SmoothSelfDiffeomorphism n M, Nonempty (SmoothIsotopy n M f) ∧
    ∀ x v, mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f x (I.val.operator x v) =
      J.val.operator (f x) (mfderiv 𝓘(ℝ, Ambient n) 𝓘(ℝ, Ambient n) f x v)

def teichSetoid : Setoid (HyperkahlerStructures n M) := Relation.EqvGen.setoid (isotopyRelation n M)
abbrev Teich := Quotient (teichSetoid n M)

def toTeich (I : HyperkahlerStructures n M) : Teich n M := Quotient.mk _ I

/-- Verbitsky's nonseparation relation: every pair of open neighbourhoods
intersects. It must not be replaced by identical neighbourhood filters. -/
def unseparated (x y : Teich n M) : Prop :=
  ∀ U V : Set (Teich n M), IsOpen U → IsOpen V → x ∈ U → y ∈ V → (U ∩ V).Nonempty

def birationalSetoid : Setoid (Teich n M) := Relation.EqvGen.setoid (unseparated n M)
abbrev BirationalTeich := Quotient (birationalSetoid n M)

def toBirational (I : HyperkahlerStructures n M) : BirationalTeich n M :=
  Quotient.mk _ (toTeich n M I)

abbrev Component (a : BirationalTeich n M) :=
  {x : BirationalTeich n M // x ∈ connectedComponent a}

def familyChartOperator (d : ℕ) (U : Opens (Coordinates d))
    (F : U → HyperkahlerStructures n M) (a : M) (pz : Coordinates d × Ambient n) :
    Ambient n →L[ℝ] Ambient n := by
  classical
  exact if hp : pz.1 ∈ U then chartOperator n M (F ⟨pz.1, hp⟩).val.operator a pz.2 else 0

structure SmoothFamily (d : ℕ) (U : Opens (Coordinates d)) where
  structures : U → HyperkahlerStructures n M
  smooth : ∀ a : M, ContDiffOn ℝ ∞ (familyChartOperator n M d U structures a)
    ((U : Set (Coordinates d)) ×ˢ (extChartAt 𝓘(ℝ, Ambient n) a).target)

def nativeTeichChart {d : ℕ} {a : BirationalTeich n M}
    (C : ChartedSpace (Coordinates d) (Component n M a)) (x : Component n M a) :
    OpenPartialHomeomorph (Component n M a) (Coordinates d) := C.chartAt x

def teichChartTarget {d : ℕ} {a : BirationalTeich n M}
    (C : ChartedSpace (Coordinates d) (Component n M a)) (x : Component n M a) :
    Opens (Coordinates d) :=
  ⟨(nativeTeichChart n M C x).target, (nativeTeichChart n M C x).open_target⟩

def familyCoordinates {d k : ℕ} {a : BirationalTeich n M}
    (C : ChartedSpace (Coordinates d) (Component n M a)) (x : Component n M a)
    (U : Opens (Coordinates k)) (F : SmoothFamily n M k U)
    (h : ∀ z : U, toBirational n M (F.structures z) ∈ connectedComponent a)
    (z : Coordinates k) : Coordinates d := by
  classical
  exact if hz : z ∈ U then
    nativeTeichChart n M C x ⟨toBirational n M (F.structures ⟨z, hz⟩), h ⟨z, hz⟩⟩ else 0

def familyChartDomain {d k : ℕ} {a : BirationalTeich n M}
    (C : ChartedSpace (Coordinates d) (Component n M a)) (x : Component n M a)
    (U : Opens (Coordinates k)) (F : SmoothFamily n M k U)
    (h : ∀ z : U, toBirational n M (F.structures z) ∈ connectedComponent a) :
    Set (Coordinates k) :=
  {z | ∃ hz : z ∈ U,
    (⟨toBirational n M (F.structures ⟨z, hz⟩), h ⟨z, hz⟩⟩ : Component n M a) ∈
      (nativeTeichChart n M C x).source}

/-- A presentation of the actual quotient smooth structure in both
directions: all smooth J-families are detected, and chart inverses lift. -/
structure SmoothTeichAtlas (d : ℕ) (a : BirationalTeich n M) where
  charts : ChartedSpace (Coordinates d) (Component n M a)
  manifold : letI := charts; IsManifold 𝓘(ℝ, Coordinates d) ∞ (Component n M a)
  chartFamilies : ∀ x : Component n M a, SmoothFamily n M d (teichChartTarget n M charts x)
  chart_inverse : ∀ (x : Component n M a) (z : teichChartTarget n M charts x),
    toBirational n M ((chartFamilies x).structures z) =
      ((nativeTeichChart n M charts x).symm z.val).val
  detects : ∀ (k : ℕ) (U : Opens (Coordinates k)) (F : SmoothFamily n M k U)
    (h : ∀ z : U, toBirational n M (F.structures z) ∈ connectedComponent a)
    (x : Component n M a), ContDiffOn ℝ ∞ (familyCoordinates n M charts x U F h)
      (familyChartDomain n M charts x U F h)

section Lattice

variable (L : Type*) [AddCommGroup L] [Module ℤ L] [Module.Finite ℤ L]

abbrev ComplexLattice := ℂ ⊗[ℤ] L

instance complexLatticeTopology : TopologicalSpace (ComplexLattice L) :=
  TopologicalSpace.induced (Module.finBasis ℂ (ComplexLattice L)).equivFun inferInstance

instance latticeProjectiveTopology : TopologicalSpace (Projectivization ℂ (ComplexLattice L)) :=
  inferInstanceAs (TopologicalSpace (Quotient (projectivizationSetoid ℂ (ComplexLattice L))))

def latticeConjugate : ComplexLattice L →ₗ[ℤ] ComplexLattice L :=
  TensorProduct.map (Complex.conjAe.toLinearMap.restrictScalars ℤ) LinearMap.id

variable (q : LinearMap.BilinForm ℤ L)

def periodDomain : Set (Projectivization ℂ (ComplexLattice L)) :=
  {l | (∀ z ∈ l.submodule, q.baseChange ℂ z z = 0) ∧
    ∀ z ∈ l.submodule, z ≠ 0 →
      (q.baseChange ℂ z (latticeConjugate L z)).im = 0 ∧
        0 < (q.baseChange ℂ z (latticeConjugate L z)).re}

abbrev PeriodPoint := {l : Projectivization ℂ (ComplexLattice L) // l ∈ periodDomain L q}
/-- The rank minus two, in natural numbers: the complex dimension of the period
quadric when `q` is a nondegenerate form on a lattice of rank at least `3`, as
for the BBF form of a marked hyperkähler manifold. -/
abbrev PeriodDimension := Module.finrank ℂ (ComplexLattice L) - 2

def projectiveRatio (p : Fin (Module.finrank ℂ (ComplexLattice L)))
    (rows : Fin (PeriodDimension L) ↪ Fin (Module.finrank ℂ (ComplexLattice L)))
    (x : PeriodPoint L q) : Coordinates (PeriodDimension L) :=
  WithLp.toLp 2 (fun i ↦ (Module.finBasis ℂ (ComplexLattice L)).equivFun x.val.rep (rows i) /
    (Module.finBasis ℂ (ComplexLattice L)).equivFun x.val.rep p)

structure QuadricPeriodAtlas where
  charts : ChartedSpace (Coordinates (PeriodDimension L)) (PeriodPoint L q)
  manifold : letI := charts
    IsManifold 𝓘(ℝ, Coordinates (PeriodDimension L)) ∞ (PeriodPoint L q)
  pivot : PeriodPoint L q → Fin (Module.finrank ℂ (ComplexLattice L))
  deleted : PeriodPoint L q → Fin (Module.finrank ℂ (ComplexLattice L))
  distinct : ∀ x, pivot x ≠ deleted x
  rows : PeriodPoint L q →
    (Fin (PeriodDimension L) ↪ Fin (Module.finrank ℂ (ComplexLattice L)))
  rows_range : ∀ x i, i ∈ Set.range (rows x) ↔ i ≠ pivot x ∧ i ≠ deleted x
  pivot_nonzero : ∀ x y, y ∈ (charts.chartAt x).source →
    (Module.finBasis ℂ (ComplexLattice L)).equivFun y.val.rep (pivot x) ≠ 0
  normalization : ∀ x y, y ∈ (charts.chartAt x).source →
    charts.chartAt x y = projectiveRatio L q (pivot x) (rows x) y

end Lattice

variable [IsManifold 𝓘(ℂ, Ambient n) ∞ M] [WedgeTheory (2 * n) M]
  (C : RealCoordinateMap (2 * n)) (A : IntegrationAtlas (2 * n) M)
  [LocalExteriorTheory n M] [IntegerCoefficientTheory M]
  (R : DeRhamResolution n M) (B : RealDeRhamComparison n M R)
  {hpos : 0 < n} (Q : BBFForm n M C A R B hpos) (J : IntegralRealComparison n M R B)
  (L : Type*) [AddCommGroup L] [Module ℤ L] [Module.Finite ℤ L]
  (q : LinearMap.BilinForm ℤ L) (m : Marking n M C A R B Q L q)

structure NormalizedPeriodMap where
  map : C(BirationalTeich n M, PeriodPoint L q)
  normalization : ∀ I : HyperkahlerStructures n M,
    (map (toBirational n M I)).val.submodule =
      Submodule.span ℂ {markedSymplecticClass n M C A R B J L q m I}

def NativeTorelliDiffeomorphism (a : BirationalTeich n M)
    (T : SmoothTeichAtlas n M (PeriodDimension L) a) (P : QuadricPeriodAtlas L q) : Type _ := by
  letI := T.charts
  letI := P.charts
  exact Diffeomorph 𝓘(ℝ, Coordinates (PeriodDimension L))
    𝓘(ℝ, Coordinates (PeriodDimension L))
    (Component n M a) (PeriodPoint L q) ∞

def diffeomorphismValue {a : BirationalTeich n M}
    (T : SmoothTeichAtlas n M (PeriodDimension L) a) (P : QuadricPeriodAtlas L q)
    (e : NativeTorelliDiffeomorphism n M L q a T P) (x : Component n M a) : PeriodPoint L q := by
  letI := T.charts
  letI := P.charts
  let e' : Diffeomorph 𝓘(ℝ, Coordinates (PeriodDimension L))
    𝓘(ℝ, Coordinates (PeriodDimension L))
      (Component n M a) (PeriodPoint L q) ∞ := e
  exact e' x

structure TorelliDiffeomorphism (a : BirationalTeich n M)
    (F : NormalizedPeriodMap n M C A R B Q J L q m)
    (T : SmoothTeichAtlas n M (PeriodDimension L) a) (P : QuadricPeriodAtlas L q) where
  diffeomorphism : NativeTorelliDiffeomorphism n M L q a T P
  normalization : ∀ x : Component n M a,
    diffeomorphismValue n M L q T P diffeomorphism x = F.map x.val

end MathlibExt.AlgebraicGeometry.HyperkahlerPeriods
