module

public import MathlibExt.AlgebraicGeometry.Correspondence.LocalizedIntersectionLength
public import MathlibExt.Algebra.Homology.KoszulComplexFamilyEuler
public import MathlibExt.Algebra.Homology.KoszulComplexHomologyZero

/-!
# Actual local diagonal Koszul complexes at generic supports

Localize the original finite family of diagonal equations at an actual
minimal prime of their generated ideal. The generic-support theorem
derives finite length of the local quotient. Annihilation and boundedness
of the genuine finite-family Koszul complex then derive finite length in
every homological degree and a bounded alternating-sum Euler invariant.

No finite-length certificate is required, and higher Koszul homology is
retained. Identifying this invariant with Serre's Tor multiplicity still
requires the actual diagonal resolution and its comparison.
-/

@[expose] public section

noncomputable section

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.FiniteCorrespondenceIntersection

universe u v

variable (R : Type u) [CommRing R] {I : Type v}

/-- The original diagonal equations in the actual local ring. -/
def localizedDiagonalFamily (a : I → R) (p : Ideal R) [p.IsPrime] :
    I → Localization.AtPrime p :=
  fun i => algebraMap R (Localization.AtPrime p) (a i)

/-- Localization of the original diagonal ideal is exactly the ideal
generated by the original localized equations. -/
theorem localizedDiagonalIdeal_eq
    (a : I → R) (p : Ideal R) [p.IsPrime] :
    Ideal.span (Set.range (localizedDiagonalFamily R a p)) =
      (Ideal.span (Set.range a)).map (algebraMap R (Localization.AtPrime p)) := by
  rw [Ideal.map_span]
  apply congrArg Ideal.span
  exact Set.range_comp _ _

/-- At an actual minimal prime of the original diagonal ideal, its local
quotient has finite length. The minimal-prime condition replaces a
supplied finite-length input. -/
theorem localizedDiagonalQuotient_length_ne_top
    [IsNoetherianRing R] (a : I → R) (p : Ideal R) [p.IsPrime]
    (hp : p ∈ (Ideal.span (Set.range a)).minimalPrimes) :
    Module.length (Localization.AtPrime p)
      (Localization.AtPrime p ⧸ Ideal.span (Set.range (localizedDiagonalFamily R a p))) ≠ ⊤ := by
  rw [localizedDiagonalIdeal_eq]
  exact localizedIntersectionQuotient_length_ne_top R _ p hp

variable [Fintype I]

/-- The genuine local diagonal complex has finite-length homology in
every degree, with the original finite-family cutoff. -/
def localizedDiagonalKoszulFiniteLength
    [IsNoetherianRing R] (a : I → R) (p : Ideal R) [p.IsPrime]
    (hp : p ∈ (Ideal.span (Set.range a)).minimalPrimes) :
    HomologicalComplex.FiniteLengthHomologyData (Localization.AtPrime p)
      (KoszulComplex.familyComplex (Localization.AtPrime p) (localizedDiagonalFamily R a p)) :=
  KoszulComplex.familyFiniteLengthHomologyDataOfQuotient (Localization.AtPrime p)
    (localizedDiagonalFamily R a p) (localizedDiagonalQuotient_length_ne_top R a p hp)

/-- Every degree of the actual local diagonal Koszul homology has finite
length, retaining all higher terms. -/
theorem localizedDiagonalKoszul_homology_length_ne_top
    [IsNoetherianRing R] (a : I → R) (p : Ideal R) [p.IsPrime]
    (hp : p ∈ (Ideal.span (Set.range a)).minimalPrimes) (j : ℕ) :
    Module.length (Localization.AtPrime p)
      ((KoszulComplex.familyComplex (Localization.AtPrime p)
        (localizedDiagonalFamily R a p)).homology j) ≠ ⊤ :=
  KoszulComplex.familyHomology_length_ne_top_of_quotient (Localization.AtPrime p)
    (localizedDiagonalFamily R a p) j (localizedDiagonalQuotient_length_ne_top R a p hp)

/-- The Euler invariant of the actual local diagonal complex. -/
def localizedDiagonalKoszulEuler
    [IsNoetherianRing R] (a : I → R) (p : Ideal R) [p.IsPrime]
    (hp : p ∈ (Ideal.span (Set.range a)).minimalPrimes) : ℤ :=
  KoszulComplex.familyEulerCharacteristicOfQuotient (Localization.AtPrime p)
    (localizedDiagonalFamily R a p) (localizedDiagonalQuotient_length_ne_top R a p hp)

/-- Its actual bounded alternating sum includes every original Koszul
homology degree through the number of diagonal equations. -/
theorem localizedDiagonalKoszulEuler_eq
    [IsNoetherianRing R] (a : I → R) (p : Ideal R) [p.IsPrime]
    (hp : p ∈ (Ideal.span (Set.range a)).minimalPrimes) :
    localizedDiagonalKoszulEuler R a p hp =
      ∑ j ∈ Finset.range (Fintype.card I + 1), (-1 : ℤ) ^ j *
        (Module.length (Localization.AtPrime p)
          ((KoszulComplex.familyComplex (Localization.AtPrime p)
            (localizedDiagonalFamily R a p)).homology j)).toNat :=
  KoszulComplex.familyEulerCharacteristicOfQuotient_eq _ _ _

/-- Degree zero is the actual local intersection quotient. This computes
one term without replacing the full alternating sum by that term. -/
def localizedDiagonalKoszulHomologyZeroEquiv
    (a : I → R) (p : Ideal R) [p.IsPrime] :
    (KoszulComplex.familyComplex (Localization.AtPrime p)
      (localizedDiagonalFamily R a p)).homology 0 ≃ₗ[Localization.AtPrime p]
        Localization.AtPrime p ⧸ Ideal.span (Set.range (localizedDiagonalFamily R a p)) :=
  KoszulComplex.familyHomologyZeroLinearEquivQuotient _ _

end AlgebraicGeometry.FiniteCorrespondenceIntersection
