module

public import MathlibExt.AlgebraicGeometry.FiniteToricCoordinates
public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Analysis.Complex.Basic
public import Mathlib.Algebra.Category.ModuleCat.Basic

/-!
# Literal Cox grading and degree-zero localized modules

The degree group is the actual cokernel of the character/ray pairing map.
The Cox ring is a polynomial ring with Mathlib's weighted homogeneous
decomposition. A localized degree-zero ring/module is generated by the
actual fractions whose numerator degree equals the denominator degree.
No abstract ring or sheaf is supplied and called the Cox construction.

Reference: D. Cox, *The Homogeneous Coordinate Ring of a Toric Variety*,
alg-geom/9210008v3, Theorem 2.1 and Proposition 3.1/Theorem 3.2.
Geometric quotient statements require simplicial fans; the categorical
quotient is the broader statement. The geometric divisor-class comparison
and the assembled sheafification remain normalized construction dependencies.
The polynomial grading/localization primitives are already Mathlib results.
-/

@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.CoxGradedSheaves

open CategoryTheory FiniteToricCoordinates
open scoped BigOperators

variable {n : ℕ} (F : FiniteFan n)

/-- The ray catalogue enumerates actual one-dimensional cones and fixes
their primitive positive lattice generators. -/
structure Rays where
  count : ℕ
  cone : Fin count → Cone n
  generator : Fin count → Lattice n
  injective : Function.Injective cone
  enumerates : Set.range cone = {σ | σ ∈ F.cones ∧ coneDimension σ = 1}
  cone_eq : ∀ i, cone i = PointedCone.hull ℝ {latticeCast n (generator i)}
  primitive : ∀ i, AddSubgroup.zmultiples (generator i) = coneLattice (cone i)
  spanning : Submodule.span ℝ (Set.range fun i ↦ latticeCast n (generator i)) = ⊤

variable {F} (R : Rays F)

def characterRayMap : Lattice n →+ (Fin R.count → ℤ) where
  toFun u i := ∑ j, u j * R.generator i j
  map_zero' := by ext i; simp
  map_add' u v := by ext i; simp [add_mul, Finset.sum_add_distrib]

abbrev DegreeGroup := (Fin R.count → ℤ) ⧸ (characterRayMap R).range

local instance : DecidableEq (DegreeGroup R) := Classical.decEq _

def rayDegree (i : Fin R.count) : DegreeGroup R :=
  (QuotientAddGroup.mk' (characterRayMap R).range) (Pi.single i 1)

abbrev CoxRing := MvPolynomial (Fin R.count) ℂ

abbrev homogeneous (a : DegreeGroup R) : Submodule ℂ (CoxRing R) :=
  MvPolynomial.weightedHomogeneousSubmodule ℂ (rayDegree R) a

@[instance_reducible]
def coxDecomposition : DirectSum.Decomposition (homogeneous R) := by
  classical
  exact MvPolynomial.weightedDecomposition ℂ (rayDegree R)

@[instance_reducible]
def coxGradedAlgebra : GradedAlgebra (homogeneous R) := by
  classical
  exact MvPolynomial.weightedGradedAlgebra ℂ (rayDegree R)

def rayInCone (σ : Cone n) (i : Fin R.count) : Prop := R.cone i ≤ σ

def denominator (σ : Cone n) : CoxRing R := by
  classical
  exact ∏ i, if rayInCone R σ i then 1 else MvPolynomial.X i

def denominatorDegree (σ : Cone n) : DegreeGroup R := by
  classical
  exact ∑ i, if rayInCone R σ i then 0 else rayDegree R i

def irrelevantIdeal : Ideal (CoxRing R) :=
  Ideal.span (denominator R '' (F.cones : Set (Cone n)))

abbrev LocalRing (σ : Cone n) := Localization.Away (denominator R σ)

def denominatorPower (σ : Cone n) (a : ℕ) : Submonoid.powers (denominator R σ) :=
  ⟨denominator R σ ^ a, ⟨a, rfl⟩⟩

def zeroDegreeFractions (σ : Cone n) : Set (LocalRing R σ) :=
  {x | ∃ (a : ℕ) (p : CoxRing R), p ∈ homogeneous R (a • denominatorDegree R σ) ∧
    x = Localization.mk p (denominatorPower R σ a)}

/-- The actual localized degree-zero algebra, including its constant scalars. -/
def degreeZeroAlgebra (σ : Cone n) : Subalgebra ℂ (LocalRing R σ) :=
  Algebra.adjoin ℂ (zeroDegreeFractions R σ)

/-- A genuine graded module over the actual Cox ring. -/
structure GradedModule where
  object : ModuleCat.{0} (CoxRing R)
  piece : DegreeGroup R → AddSubgroup object
  decomposition : DirectSum.Decomposition piece
  graded_smul : ∀ a b (p : CoxRing R), p ∈ homogeneous R a →
    ∀ x : object, x ∈ piece b → p • x ∈ piece (a + b)

namespace GradedModule

variable {R} (M N P : GradedModule R)

structure Hom where
  map : M.object →ₗ[CoxRing R] N.object
  graded : ∀ a (x : M.object), x ∈ M.piece a → map x ∈ N.piece a

@[ext]
theorem Hom.ext {f g : Hom M N} (h : f.map = g.map) : f = g := by
  cases f
  cases g
  cases h
  rfl

def Hom.id : Hom M M := ⟨LinearMap.id, fun _ _ h ↦ h⟩

def Hom.comp (f : Hom M N) (g : Hom N P) : Hom M P :=
  ⟨g.map.comp f.map, fun a x h ↦ g.graded a _ (f.graded a x h)⟩

instance : Category (GradedModule R) where
  Hom := Hom
  id := Hom.id
  comp f g := Hom.comp _ _ _ f g
  id_comp f := Hom.ext _ _ (by ext x; rfl)
  comp_id f := Hom.ext _ _ (by ext x; rfl)
  assoc f g h := Hom.ext _ _ (by ext x; rfl)

end GradedModule

variable (σ : Cone n) (M : GradedModule R)

abbrev LocalModule := LocalizedModule (Submonoid.powers (denominator R σ)) M.object

instance localModuleStructure : Module (LocalRing R σ) (LocalModule R σ M) :=
  inferInstanceAs (Module (Localization (Submonoid.powers (denominator R σ)))
    (LocalizedModule (Submonoid.powers (denominator R σ)) M.object))

instance degreeZeroModuleStructure : Module (degreeZeroAlgebra R σ) (LocalModule R σ M) :=
  Module.compHom (LocalModule R σ M) (degreeZeroAlgebra R σ).val.toRingHom

def zeroModuleFractions : Set (LocalModule R σ M) :=
  {x | ∃ (a : ℕ) (m : M.object), m ∈ M.piece (a • denominatorDegree R σ) ∧
    x = LocalizedModule.mk m (denominatorPower R σ a)}

/-- The local module uses literal homogeneous fractions and their scalar span. -/
def degreeZeroModule : Submodule (degreeZeroAlgebra R σ) (LocalModule R σ M) :=
  Submodule.span _ (zeroModuleFractions R σ M)

end MathlibExt.AlgebraicGeometry.CoxGradedSheaves
