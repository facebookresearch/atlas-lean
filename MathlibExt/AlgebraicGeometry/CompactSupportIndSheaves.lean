module

public import Mathlib.Algebra.Category.ModuleCat.FilteredColimits
public import Mathlib.Algebra.Category.ModuleCat.Limits
public import Mathlib.Topology.Sheaves.Abelian
public import Mathlib.Topology.Sheaves.Stalks
public import Mathlib.CategoryTheory.Category.ULift
public import Mathlib.CategoryTheory.Abelian.Transfer
public import Mathlib.CategoryTheory.Abelian.Indization
public import Mathlib.Algebra.Homology.DerivedCategory.HomologySequence

/-!
# Native ind-sheaves generated by actual compact-support sheaves

Ordinary compact support is closure of the nonzero stalk locus. The
ind-sheaf category is the native Ind category of the compact-support
sheaf category, with filtered index categories in `Type 0`: these are
the U-small filtrant systems of Kashiwara--Schapira. Mathlib builds the
abelian structure of an Ind category only for small categories, so the
abelian structure of the ind-sheaves is part of the structural source
(Kashiwara--Schapira, Categories and Sheaves, Theorem 8.6.5(i)).
Ind-object supports are never replaced by their ordinary stalk loci.

Source: D'Agnolo--Kashiwara1311.2374v2, Section2.2 and Definition3.2.6;
Kashiwara--Schapira, Ind-sheaves. Native Ind constructions are
Mathlib56a005855ea17e0b0958f73ec801ae140b0a1679, Markus Himmel/Adam Topaz,
Apache2.0. Structural abelian-source proofs remain separate requests.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.CompactSupportIndSheaves

open _root_.CategoryTheory _root_.CategoryTheory.Limits TopologicalSpace

variable (k : Type) [Field k] (X : TopCat.{0})

abbrev OrdinarySheaf := TopCat.Sheaf (ModuleCat.{0} k) X

/-- Ordinary sheaf support uses the actual native filtered-colimit stalks. -/
def ordinarySupport (F : OrdinarySheaf k X) : Set X :=
  closure {x : X | ¬IsZero (F.presheaf.stalk x)}

def IsCompactSupported : ObjectProperty (OrdinarySheaf k X) :=
  fun F => IsCompact (ordinarySupport k X F)

abbrev CompactSheaf := (IsCompactSupported k X).FullSubcategory

/-- Native Ind construction on actual compact-supported sheaves. Its filtered index categories
are small (`Type 0`), as for the U-small filtrant systems of Kashiwara--Schapira. -/
abbrev IndSheaf := Ind (CompactSheaf k X)

/-- Abelian structure for compactly supported sheaves of $k$-modules ($k$ a field) on $X$ and for
their ind-sheaves. An instance records that the full subcategory `CompactSheaf k X` of sheaves with
compact support has finite products, kernels and cokernels, and that, with the hom-groups inherited
from all sheaves, every coimage-image comparison in it is an isomorphism; and it gives an abelian
structure `indAbelian` on the ind-sheaves `Ind (CompactSheaf k X)` (cf. Kashiwara–Schapira,
*Categories and Sheaves*, Theorem 8.6.5(i)). -/
class CompactSheafSource where
  [hasFiniteProducts : Limits.HasFiniteProducts (CompactSheaf k X)]
  [hasKernels : Limits.HasKernels (CompactSheaf k X)]
  [hasCokernels : Limits.HasCokernels (CompactSheaf k X)]
  coimageImage : ∀ {F G : CompactSheaf k X} (f : F ⟶ G),
    IsIso (Abelian.coimageImageComparison f)
  indAbelian : Abelian (IndSheaf k X)

attribute [instance] CompactSheafSource.hasFiniteProducts CompactSheafSource.hasKernels
  CompactSheafSource.hasCokernels CompactSheafSource.indAbelian

/-- The abelian structure of the compact-support sheaves, on their inherited hom-groups. -/
instance compactSheafAbelian [CompactSheafSource k X] : Abelian (CompactSheaf k X) :=
  haveI : ∀ {F G : CompactSheaf k X} (f : F ⟶ G), IsIso (Abelian.coimageImageComparison f) :=
    fun f => CompactSheafSource.coimageImage f
  Abelian.ofCoimageImageComparisonIsIso

section TopCatOf

/-! Lean 4.36 does not find the generic instances above at `X := TopCat.of M`: their keys keep the
carrier of `X`, which the query reduces to `M`. These restate them at `TopCat.of M`. -/

variable (M : Type) [TopologicalSpace M] [CompactSheafSource k (TopCat.of M)]

instance hasFiniteProductsOf : Limits.HasFiniteProducts (CompactSheaf k (TopCat.of M)) :=
  CompactSheafSource.hasFiniteProducts
instance hasKernelsOf : Limits.HasKernels (CompactSheaf k (TopCat.of M)) :=
  CompactSheafSource.hasKernels
instance hasCokernelsOf : Limits.HasCokernels (CompactSheaf k (TopCat.of M)) :=
  CompactSheafSource.hasCokernels
instance indAbelianOf : Abelian (IndSheaf k (TopCat.of M)) := CompactSheafSource.indAbelian
instance compactSheafAbelianOf : Abelian (CompactSheaf k (TopCat.of M)) :=
  compactSheafAbelian k (TopCat.of M)

end TopCatOf

/-- Original compact sheaves enter through the native Ind Yoneda embedding. -/
def compactToInd : CompactSheaf k X ⥤ IndSheaf k X :=
  Ind.yoneda

/-- The full presheaf realization is the native Ind inclusion on the original compact category. -/
def indRealization : IndSheaf k X ⥤ (CompactSheaf k X)ᵒᵖ ⥤ Type :=
  Ind.inclusion (CompactSheaf k X)

/-- The true filtered presentation consists of original compact-support objects and every native map. -/
def indPresentation (F : IndSheaf k X) :
    IndObjectPresentation ((indRealization k X).obj F) := Ind.presentation F

variable [CompactSheafSource k X]
attribute [local instance] HasDerivedCategory.standard

abbrev IndDerived := DerivedCategory (IndSheaf k X)

/-- Boundedness refers to actual cohomology objects of the native derived category. -/
def IsBounded : ObjectProperty (IndDerived k X) := fun F =>
  ∃ a b : ℤ, ∀ n : ℤ, n<a ∨ b<n →
    IsZero ((DerivedCategory.homologyFunctor (IndSheaf k X) n).obj F)

/-- The full bounded derived category, retaining noninvertible maps. -/
abbrev BoundedIndDerived := (IsBounded k X).FullSubcategory

end MathlibExt.AlgebraicGeometry.CompactSupportIndSheaves
