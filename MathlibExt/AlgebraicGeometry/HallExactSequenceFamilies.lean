module

public import MathlibExt.AlgebraicGeometry.StablePairFamilies
public import MathlibExt.AlgebraicGeometry.StablePairParameterPullbacks
public import MathlibExt.AlgebraicGeometry.NumericalCurveCones
public import MathlibExt.AlgebraicGeometry.LineBundlePullback
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact

/-!
# Actual coherent-family and exact-sequence groupoids for Hall correspondences

Families are coherent module sheaves on X × T, flat over T, with
all geometric fibres supported in dimension at most one. The exact
sequence has its actual module arrows and native ShortExact condition.
Its three projections are the actual subobject, quotient and middle term.

Numerical curve classes are integral degree profiles on all actual
line bundles, generated by proper smooth curve maps. A coherent
sheaf's profile is the actual Euler-characteristic difference under
tensoring with a line bundle; its integer component is its actual χ.

Reference: Bridgeland, arXiv:1002.4374v3, §3–5, (15), (23)–(25).
The generic coherent stack/category sources in AxiomMath/Stacks,
c496df0d9beea9deaeabcea8492605f9a0a2313b, Quot/CoherentStack.lean
and CoherentStackCategory.lean (Apache 2.0), supply the separate native
stack/source comparison. No abstract K0 category replaces these families.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.HallExactSequenceFamilies

open CategoryTheory CategoryTheory.Limits Opposite
open _root_.AlgebraicGeometry
open StablePairFamilies StablePairParameterPullbacks CoherentCurveLinearSeries
open LineBundleTaskContracts ProjectiveLineSystems
open AlgebraicLineBundleFamilies

variable (X T : Over (Spec (.of ℂ)))

/-- The actual coherent, relatively flat family on the product. -/
structure Family where
  module : (total X T).Modules
  coherent : StablePairFamilies.coherent module
  flat : FlatOver (projection X T) module
  lowDimension : ∀ (Ω : Type) [Field Ω] [IsAlgClosed Ω] (p : Spec (.of Ω) ⟶ T.left),
    supportDimension
      ((Scheme.Modules.pullback (pullback.fst (projection X T) p)).obj module) ≤ (1 : ℕ)

variable {X T}

instance familyCategory : Category (Family X T) where
  Hom F G := F.module ≅ G.module
  id F := Iso.refl _
  comp a b := a ≪≫ b
  id_comp a := by apply Iso.ext; exact Category.id_comp _
  comp_id a := by apply Iso.ext; exact Category.comp_id _
  assoc a b c := by apply Iso.ext; exact Category.assoc _ _ _

instance familyIsGroupoid : IsGroupoid (Family X T) where
  all_isIso a := by
    exact ⟨⟨a.symm, by apply Iso.ext; exact a.hom_inv_id,
      by apply Iso.ext; exact a.inv_hom_id⟩⟩

/-- A short exact sequence of the actual S-flat families. -/
structure Sequence where
  sub : Family X T
  middle : Family X T
  quotient : Family X T
  inclusion : sub.module ⟶ middle.module
  projection : middle.module ⟶ quotient.module
  zero : inclusion ≫ projection = 0
  exact : (ShortComplex.mk inclusion projection zero).ShortExact

/-- Isomorphisms of actual short exact sequences commute with both original arrows. -/
structure SequenceHom (A B : Sequence (X := X) (T := T)) where
  sub : A.sub.module ≅ B.sub.module
  middle : A.middle.module ≅ B.middle.module
  quotient : A.quotient.module ≅ B.quotient.module
  inclusion : A.inclusion ≫ middle.hom = sub.hom ≫ B.inclusion
  projection : A.projection ≫ quotient.hom = middle.hom ≫ B.projection

@[ext] theorem SequenceHom.ext {A B : Sequence (X := X) (T := T)}
    {a b : SequenceHom A B} (hs : a.sub.hom=b.sub.hom)
    (hm : a.middle.hom=b.middle.hom) (hq : a.quotient.hom=b.quotient.hom) : a=b := by
  have hs' := Iso.ext hs
  have hm' := Iso.ext hm
  have hq' := Iso.ext hq
  cases a
  cases b
  cases hs'
  cases hm'
  cases hq'
  rfl

instance sequenceCategory : Category (Sequence (X := X) (T := T)) where
  Hom := SequenceHom
  id A := ⟨Iso.refl _,Iso.refl _,Iso.refl _,by simp,by simp⟩
  comp a b :=
    ⟨a.sub ≪≫ b.sub,a.middle ≪≫ b.middle,a.quotient ≪≫ b.quotient,
      by
        dsimp only [Iso.trans_hom]
        rw [← Category.assoc,a.inclusion,Category.assoc,b.inclusion,← Category.assoc],
      by
        dsimp only [Iso.trans_hom]
        rw [← Category.assoc,a.projection,Category.assoc,b.projection,← Category.assoc]⟩
  id_comp a := by
    apply SequenceHom.ext <;> exact Category.id_comp _
  comp_id a := by
    apply SequenceHom.ext <;> exact Category.comp_id _
  assoc a b c := by
    apply SequenceHom.ext <;> exact Category.assoc _ _ _

instance sequenceIsGroupoid : IsGroupoid (Sequence (X := X) (T := T)) where
  all_isIso a := by
    let b : SequenceHom _ _ :=
      ⟨a.sub.symm,a.middle.symm,a.quotient.symm,by
        have h := congrArg (fun f => a.sub.inv ≫ f ≫ a.middle.inv) a.inclusion
        simpa [Category.assoc] using h.symm,by
        have h := congrArg (fun f => a.middle.inv ≫ f ≫ a.quotient.inv) a.projection
        simpa [Category.assoc] using h.symm⟩
    refine ⟨⟨b, ?_, ?_⟩⟩
    · apply SequenceHom.ext
      · change a.sub.hom ≫ a.sub.inv = 𝟙 _
        exact a.sub.hom_inv_id
      · change a.middle.hom ≫ a.middle.inv = 𝟙 _
        exact a.middle.hom_inv_id
      · change a.quotient.hom ≫ a.quotient.inv = 𝟙 _
        exact a.quotient.hom_inv_id
    · apply SequenceHom.ext
      · change a.sub.inv ≫ a.sub.hom = 𝟙 _
        exact a.sub.inv_hom_id
      · change a.middle.inv ≫ a.middle.hom = 𝟙 _
        exact a.middle.inv_hom_id
      · change a.quotient.inv ≫ a.quotient.hom = 𝟙 _
        exact a.quotient.inv_hom_id

/-- The subobject stack projection on actual families. -/
def subobject : Sequence (X := X) (T := T) ⥤ Family X T where
  obj A := A.sub
  map a := a.sub
  map_id _A := rfl
  map_comp _a _b := rfl

/-- The quotient stack projection on the same native sequence. -/
def quotient : Sequence (X := X) (T := T) ⥤ Family X T where
  obj A := A.quotient
  map a := a.quotient
  map_id _A := rfl
  map_comp _a _b := rfl

/-- The middle-term stack projection defining Hall pushforward. -/
def middleTerm : Sequence (X := X) (T := T) ⥤ Family X T where
  obj A := A.middle
  map a := a.middle
  map_id _A := rfl
  map_comp _a _b := rfl

variable (X : Over (Spec (.of ℂ)))

/-- The actual alternating ranks in degrees zero and one. -/
def cohomologyDifference (F : X.left.Modules) : ℤ :=
  (Module.finrank ℂ (cohomology X.hom F 0) : ℤ) - Module.finrank ℂ (cohomology X.hom F 1)

/-- The underlying low-dimensional coherent object. -/
abbrev CoherentObject := {F : X.left.Modules //
  StablePairFamilies.coherent F ∧ supportDimension F ≤ (1 : ℕ)}

/-- On the proper threefold these are all nonzero cohomological degrees of this sheaf. -/
def sheafEuler (_HX : Threefold X) (F : CoherentObject X) : ℤ :=
  cohomologyDifference X F.val

/-- Degree profile of a map from a proper integral curve (possibly singular). -/
def integralCurveDegrees (C : NumericalCurveCones.Curve X) : LineBundle X.left → ℤ :=
  fun L => degree C.source.hom ((Scheme.Modules.pullback C.map.left).obj L.val)
    (L.2.pullback C.map.left)

/-- The actual integral numerical curve lattice, with no assigned pairing. -/
def CurveLattice : AddSubgroup (LineBundle X.left → ℤ) :=
  AddSubgroup.closure (Set.range (integralCurveDegrees X))

/-- The actual line-bundle degree profile of a low-dimensional coherent sheaf. -/
def sheafCurveDegrees (HX : Threefold X) (F : CoherentObject X) : LineBundle X.left → ℤ :=
  fun L => cohomologyDifference X (moduleTensor X.left F.val L.val) - sheafEuler X HX F

/-- The paper's (β,n), computed from the sheaf's actual Euler profile and χ. -/
def numericalClass (HX : Threefold X) (F : CoherentObject X)
    (h : sheafCurveDegrees X HX F ∈ CurveLattice X) :
    CurveLattice X × ℤ := (⟨sheafCurveDegrees X HX F,h⟩,sheafEuler X HX F)

end MathlibExt.AlgebraicGeometry.HallExactSequenceFamilies
