module

public import MathlibExt.AlgebraicGeometry.QuasimapAssociatedFamilies
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.RingTheory.Length

/-!
# Quasimap unstable ideals, basepoint schemes and native defect lengths

The unstable ideal is generated by actual invariant sections in positive
polarization powers. Power trivializations send 1 to the fixed section
power, so coefficient functions are determined by the polarization.
The associated unstable subscheme and the base locus are actual closed
scheme pullbacks. No family flatness is imposed on that pullback.

The local defect uses the actual stalk quotient of its ideal submodule.
The general rational length is the infimum of the native divisor orders
of nonzero pulled invariant sections divided by their positive powers.
The integral ideal-length comparison requires the paper's degree-one
generation hypothesis, recorded separately.

Reference: Ciocan-Fontanine–Kim–Maulik, arXiv:1106.3724v2,
Definition 7.1.1 and equations (7.1.1)–(7.1.2).
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

namespace MathlibExt.AlgebraicGeometry.QuasimapBasepointDefects

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open _root_.AlgebraicGeometry
open GroupTorsorGeometry QuasimapAssociatedFamilies
open LinearizedLineBundles LineBundleTaskContracts CoherentCurveLinearSeries

universe u
variable {S : Scheme.{u}} (G W : Over S) [GrpObj G] [ModObj G W]

/-- A linearized trivial line, with every ordinary power's coefficient
normalization fixed. The linearization is arbitrary: the character polarization
of Ciocan-Fontanine–Kim–Maulik §2.2 is the case where the action in the fixed
trivialization is induced by one character of `G`. -/
structure CharacterPolarization where
  line : LinearizedLineBundle G W
  trivial : structureModule W.left ≅ line.module
  powerTrivial : ∀ m : ℕ, structureModule W.left ≅ power line.module m
  power_normalized : ∀ m, (powerTrivial m).hom = sectionPower trivial.hom m
  actionPowers : PullbackPowers (action G W)
  projectionPowers : PullbackPowers (projection G W)

variable {G W}

/-- The native regular coefficient of a section in the fixed character trivialization. -/
def invariantCoefficient (L : CharacterPolarization G W) (m : ℕ)
    (s : Section (power L.line.module m)) : Γ(W.left, ⊤) :=
  (s ≫ (L.powerTrivial m).inv).val.app (op ⊤) (1 : Γ(W.left, ⊤))

/-- All positive-degree actual invariant coefficient functions, without taking radicals. -/
def invariantFunctions (L : CharacterPolarization G W) : Set Γ(W.left, ⊤) :=
  {f | ∃ (m : ℕ), 0 < m ∧ ∃ (s : Section (power L.line.module m)),
    IsInvariantPowerSection G W L.line.linearization L.actionPowers L.projectionPowers m s ∧
      invariantCoefficient L m s = f}

/-- The scheme-theoretic unstable ideal retains nilpotents and multiplicities. -/
def unstableIdeal (L : CharacterPolarization G W) : Ideal Γ(W.left, ⊤) :=
  Ideal.span (invariantFunctions L)

/-- The actual unstable affine closed subscheme. -/
def unstableScheme [IsAffine W.left] (L : CharacterPolarization G W) : Scheme.{u} :=
  Spec (.of (Γ(W.left, ⊤) ⧸ unstableIdeal L))

def unstableInclusion [IsAffine W.left] (L : CharacterPolarization G W) :
    unstableScheme L ⟶ W.left :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (unstableIdeal L))) ≫ W.left.isoSpec.inv

/-- The actual unstable subscheme in a specified associated bundle:
the quotient map pulls it back to the literal product with W^us. -/
structure AssociatedUnstable [IsAffine W.left] (L : CharacterPolarization G W)
    {T : Over S} (P : QuotientObject G W T) (B : AssociatedBundle G W P) where
  scheme : Scheme.{u}
  inclusion : scheme ⟶ B.bundle.left
  [closed : IsClosedImmersion inclusion]
  quotientPullback : pullback inclusion B.quotient.left ≅
    pullback (unstableInclusion L)
      (CategoryTheory.CartesianMonoidalCategory.snd P.torsor.total W).left
  normalized : quotientPullback.hom ≫
      pullback.snd (unstableInclusion L)
        (CategoryTheory.CartesianMonoidalCategory.snd P.torsor.total W).left =
    pullback.snd inclusion B.quotient.left

attribute [instance] AssociatedUnstable.closed

/-- The basepoint scheme is the literal section pullback of the unstable subscheme. -/
def basepointScheme [IsAffine W.left] (L : CharacterPolarization G W)
    {T : Over S} {P : QuotientObject G W T} {B : AssociatedBundle G W P}
    (U : AssociatedUnstable L P B) : Scheme.{u} :=
  pullback U.inclusion B.sectionMap.left

def basepointInclusion [IsAffine W.left] (L : CharacterPolarization G W)
    {T : Over S} {P : QuotientObject G W T} {B : AssociatedBundle G W P}
    (U : AssociatedUnstable L P B) : basepointScheme L U ⟶ T.left :=
  pullback.snd U.inclusion B.sectionMap.left

/-- The native germ quotient of a specified local ideal. -/
def localIdealLength {C : Scheme.{u}} (x : C)
    (I : Submodule (C.presheaf.stalk x) (C.presheaf.stalk x)) : ℕ∞ :=
  Module.length (C.presheaf.stalk x) ((C.presheaf.stalk x) ⧸ I)

/-- The actual stalk ideal of an embedded closed subscheme, using all
local regular functions whose pullback is zero. -/
def closedGermIdeal {Z C : Scheme.{u}} (i : Z ⟶ C) (x : C) :
    Ideal (C.presheaf.stalk x) :=
  Ideal.span {r | ∃ (U : C.Opens) (hx : x ∈ U) (a : Γ(C, U)),
    i.app U a = 0 ∧ C.presheaf.germ U x hx a = r}

/-- The integral ideal defect is computed from the actual basepoint scheme. -/
def basepointIdealLength [IsAffine W.left] (L : CharacterPolarization G W)
    {T : Over S} {P : QuotientObject G W T} {B : AssociatedBundle G W P}
    (U : AssociatedUnstable L P B) (x : T.left) : ℕ∞ :=
  Module.length (T.left.presheaf.stalk x)
    ((T.left.presheaf.stalk x) ⧸ closedGermIdeal (basepointInclusion L U) x)

end MathlibExt.AlgebraicGeometry.QuasimapBasepointDefects
