module

public import Mathlib.LinearAlgebra.TensorAlgebra.Basic
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Milnor K-theory

The Milnor K-ring of a field `F` is the quotient of the tensor algebra over `ℤ`
on the additive group `Fˣ` by the ideal generated by `[a] * [1 - a]` for `a ≠ 0, 1`.

`TensorRing` and `MilnorKRing` are transparent aliases for their standard quotient
constructions.  This keeps the inherited algebraic structure definitionally available,
as is customary for quotient-based objects in Mathlib.  The graded ring is the ambient
construction; the user-facing degree-`n` group `MilnorK F n` is definitionally the
canonical degree component `MilnorKRing.degree F n`.

## Main definitions
* `MilnorK.TensorRing`
* `MilnorK.steinbergSet`
* `MilnorK.steinbergIdeal`
* `MilnorK.MilnorKRing`
* `MilnorK.MilnorKRing.mk`
* `MilnorK.MilnorKRing.symbol`
* `MilnorK.MilnorKRing.lift`

## Main results
* `MilnorK.MilnorKRing.steinberg_zero`
* `MilnorK.MilnorKRing.mk_surjective`
* `MilnorK.MilnorKRing.hom_ext`
-/

@[expose] public section

open TensorAlgebra
open scoped TensorAlgebra

namespace MilnorK

variable (F : Type*) [Field F]

/-- The tensor algebra over `ℤ` on `Fˣ`. -/
abbrev TensorRing (F : Type*) [Field F] := TensorAlgebra ℤ (Additive Fˣ)

/-- Steinberg generators as a set in the tensor algebra. -/
def steinbergSet : Set (TensorRing F) :=
  { TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
      TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))
    | (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1) }

/-- The two-sided ideal generated by Steinberg elements. -/
def steinbergIdeal : TwoSidedIdeal (TensorRing F) :=
  TwoSidedIdeal.span (steinbergSet F)

/-- The Milnor K-ring of `F`. -/
abbrev MilnorKRing := (steinbergIdeal F).ringCon.Quotient

namespace MilnorKRing

/-- The ring structure on `MilnorKRing F` inherited from the quotient. -/
instance : Ring (MilnorKRing F) := by unfold MilnorKRing; infer_instance

/-- `MilnorKRing F` is inhabited via its zero element. -/
instance : Inhabited (MilnorKRing F) := by unfold MilnorKRing; infer_instance

/-- The canonical projection `TensorRing F →+* MilnorKRing F`. -/
def mk : TensorRing F →+* MilnorKRing F :=
  (steinbergIdeal F).ringCon.mk'

/-- The degree-one symbol sending `u : Fˣ` to the class of the tensor generator
`ι (ofMul u)` in the Milnor K-ring. -/
def symbol (u : Fˣ) : MilnorKRing F :=
  mk F (TensorAlgebra.ι ℤ (Additive.ofMul u))

/-- The symbol `symbol F u` is the quotient projection of the degree-one tensor generator. -/
lemma symbol_mk (u : Fˣ) :
    symbol F u = (steinbergIdeal F).ringCon.mk'
      (TensorAlgebra.ι ℤ (Additive.ofMul u)) := rfl

/-- The additive version of `symbol`. -/
def symbolAddHom : Additive Fˣ →+ MilnorKRing F :=
  (mk F).toAddMonoidHom.comp (TensorAlgebra.ι ℤ).toAddMonoidHom

/-- Evaluating `symbolAddHom` at `ofMul u` recovers `symbol`. -/
@[simp]
lemma symbolAddHom_apply (u : Fˣ) :
    symbolAddHom F (Additive.ofMul u) = symbol F u := rfl

/-- The symbol of `1 : Fˣ` is zero, since the underlying additive group sends `1` to `0`. -/
@[simp]
lemma symbol_one : symbol F 1 = 0 := by
  rw [← symbolAddHom_apply F 1, ofMul_one, map_zero]

/-- The symbol is additive on multiplication: `symbol (a * b) = symbol a + symbol b`. -/
@[simp]
lemma symbol_mul (a b : Fˣ) : symbol F (a * b) = symbol F a + symbol F b := by
  rw [← symbolAddHom_apply F (a * b), ← symbolAddHom_apply F a, ← symbolAddHom_apply F b,
    ofMul_mul, map_add]

/-- The tensor product `ι[a] * ι[1 - a]` lies in the Steinberg ideal. -/
lemma steinberg_mem (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1) :
    TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
      TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))
      ∈ steinbergIdeal F := by
  have hmem : TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
      TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))
      ∈ steinbergSet F :=
    ⟨a, ha0, ha1, rfl⟩
  exact TwoSidedIdeal.subset_span hmem

/-- The Steinberg relation `symbol a * symbol (1 - a) = 0`. -/
theorem steinberg_zero (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1) :
    symbol F (Units.mk0 a ha0) * symbol F (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)) = 0 := by
  unfold symbol mk
  rw [← RingHom.map_mul]
  change (steinbergIdeal F).ringCon.mk' _ = (steinbergIdeal F).ringCon.mk' 0
  simp only [RingCon.coe_mk']
  rw [RingCon.eq]
  rw [← TwoSidedIdeal.mem_iff]
  exact steinberg_mem F a ha0 ha1

/-- The canonical projection is surjective. -/
lemma mk_surjective : Function.Surjective (mk F) :=
  RingCon.mk'_surjective _

/-- Extensionality for `MilnorKRing F →+* A`. -/
theorem hom_ext {A : Type*} [Ring A] {f g : MilnorKRing F →+* A}
    (h : f.comp (mk F) = g.comp (mk F)) : f = g :=
  RingCon.Quotient.hom_ext h

/-- If `f` kills Steinberg generators then `steinbergIdeal ≤ ker f`. -/
lemma steinbergIdeal_le_ker {A : Type*} [Ring A] (f : TensorRing F →+* A)
    (hf : ∀ (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1),
      f (TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
        TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))) = 0) :
    steinbergIdeal F ≤ TwoSidedIdeal.ker f := by
  intro x hx
  rw [TwoSidedIdeal.mem_ker]
  refine TwoSidedIdeal.span_induction ?_ ?_ ?_ ?_ ?_ ?_ hx
  · intro y hy
    rcases hy with ⟨a, ha0, ha1, rfl⟩
    exact hf a ha0 ha1
  · simp
  · intro x y _ _ hx hy
    rw [map_add, hx, hy, add_zero]
  · intro x _ hx
    rw [map_neg, hx, neg_zero]
  · intro a x _ hx
    rw [map_mul, hx, mul_zero]
  · intro b x _ hx
    rw [map_mul, hx, zero_mul]

/-- The lift `MilnorKRing F →+* A` of `f` killing Steinberg generators. -/
def lift {A : Type*} [Ring A] (f : TensorRing F →+* A)
    (hf : ∀ (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1),
      f (TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
        TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))) = 0) :
    MilnorKRing F →+* A :=
  (steinbergIdeal F).ringCon.lift f <| by
    have hker : RingCon.ker f = (TwoSidedIdeal.ker f).ringCon := by
      ext x y
      simp [RingCon.ker, TwoSidedIdeal.ker_ringCon]
    rw [hker]
    exact (TwoSidedIdeal.ringCon_le_iff).mp (steinbergIdeal_le_ker F f hf)

/-- The lift satisfies `lift f (mk x) = f x`, i.e. it extends `f` along the quotient. -/
@[simp]
lemma lift_mk {A : Type*} [Ring A] (f : TensorRing F →+* A)
    (hf : ∀ (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1),
      f (TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
        TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))) = 0)
    (x : TensorRing F) :
    lift F f hf (mk F x) = f x :=
  RingCon.lift_mk' _ _

/-- Uniqueness of the factorisation through `MilnorKRing`: any `g` with `g ∘ mk = f`
coincides with the constructed lift. -/
lemma lift_unique {A : Type*} [Ring A] (f : TensorRing F →+* A)
    (hf : ∀ (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1),
      f (TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a ha0)) *
        TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 (1 - a) (sub_ne_zero.mpr ha1.symm)))) = 0)
    (g : MilnorKRing F →+* A) (hg : g.comp (mk F) = f) :
    g = lift F f hf :=
  RingCon.lift_unique _ g hg

end MilnorKRing

end MilnorK
