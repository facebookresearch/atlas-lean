module

public import MathlibExt.KTheory.Milnor.DegreeMultilinearSymbol

/-!
# Generation of degree pieces by ordered symbols

This module shows that the degree filtrations on `TensorRing` and `MilnorKRing`
are generated by ordered lists of units.

For `TensorRing F`, the degree-`n` graded piece is the `ℤ`-span of ordered
products `ι(a₁) * … * ι(aₙ)` indexed by `List Fˣ` of length `n`, recorded as
`tensorList`. The statement `degree_eq_span_tensorList` makes this spanning
property explicit and `tensorList_mem_degree` gives the degree membership.
Degree zero is the span of `1`.

Applying `mkLinear` descends the same description to `MilnorKRing F`:
`degree F n` is the `ℤ`-span of `symbolList` over length-`n` unit lists.
These explicit spanning sets are the interface used to manipulate degrees via
ordered symbols and to relate tensor and Milnor generators.

The same degree pieces are also generated by `Fin`-indexed tuple symbols
`symbolTuple`. We record this second presentation as `symbolTupleSet` and
prove the corresponding spanning and extensionality lemmas.

## Main definitions

* `TensorRing.tensorListSet`, `MilnorKRing.symbolListSet`, `MilnorKRing.symbolTupleSet`

## Main results

* `TensorRing.degree_eq_span_tensorList`, `MilnorKRing.degree_eq_span_symbolList`
* `MilnorKRing.symbolTupleSet`, `MilnorKRing.degree_eq_span_symbolTuple`,
  `MilnorKRing.span_range_symbolTuple_eq_top`, `MilnorKRing.symbolTuple_ext`

The public tuple-generation surface of this module is exactly
`symbolTupleSet`, `degree_eq_span_symbolTuple`, `span_range_symbolTuple_eq_top`,
and `symbolTuple_ext`; the list/tuple set equality is an internal bridge.
-/

@[expose] public section

open TensorAlgebra
open scoped TensorAlgebra Pointwise

namespace MilnorK

variable (F : Type*) [Field F]

namespace TensorRing

/-- Ordered tensor product of units in the tensor ring. -/
def tensorList : List Fˣ → TensorRing F
  | [] => 1
  | x :: xs => TensorAlgebra.ι ℤ (Additive.ofMul x) * tensorList xs

/-- Empty tensor list evaluates to `1` in the tensor ring. -/
@[simp]
theorem tensorList_nil : tensorList F ([] : List Fˣ) = 1 := rfl

/-- Cons expands as product of the head inclusion `ι(a)` with the tail
`tensorList`. -/
@[simp]
theorem tensorList_cons (a : Fˣ) (l : List Fˣ) :
    tensorList F (a :: l) =
      TensorAlgebra.ι ℤ (Additive.ofMul a) * tensorList F l := rfl

/-- A singleton list evaluates to the degree-one inclusion of the unit. -/
theorem tensorList_singleton (a : Fˣ) :
    tensorList F [a] = TensorAlgebra.ι ℤ (Additive.ofMul a) := by
  simp [tensorList_cons, tensorList_nil]

/-- Tensor lists are multiplicative with respect to list concatenation. -/
theorem tensorList_append (l₁ l₂ : List Fˣ) :
    tensorList F (l₁ ++ l₂) = tensorList F l₁ * tensorList F l₂ := by
  induction l₁ with
  | nil => simp [tensorList_nil, one_mul]
  | cons hd tl ih => simp [List.cons_append, tensorList_cons, ih, mul_assoc]

/-- An ordered tensor list of length `n` lies in `degree F n` of the tensor
grading. -/
theorem tensorList_mem_degree (xs : List Fˣ) :
    tensorList F xs ∈ TensorRing.degree F xs.length := by
  have h_prod_eq : tensorList F xs =
      (xs.map fun u => TensorAlgebra.ι ℤ (Additive.ofMul u)).prod := by
    induction xs with
    | nil => simp [tensorList_nil]
    | cons hd tl ih => simp [tensorList_cons, ih]
  rw [h_prod_eq]
  have h_mem : ∀ y ∈ xs.map fun u => TensorAlgebra.ι ℤ (Additive.ofMul u),
      y ∈ TensorRing.degree F 1 := by
    intro y hy
    rcases List.mem_map.mp hy with ⟨u, _, rfl⟩
    rw [TensorRing.degree, TensorAlgebra.degree_one]
    exact LinearMap.mem_range_self _ _
  have h_list_mem :
      (xs.map fun u => TensorAlgebra.ι ℤ (Additive.ofMul u)).prod ∈
        TensorRing.degree F (xs.map fun u => TensorAlgebra.ι ℤ (Additive.ofMul u)).length :=
    TensorAlgebra.list_prod_mem_degree h_mem
  have h_len :
      (xs.map fun u => TensorAlgebra.ι ℤ (Additive.ofMul u)).length = xs.length := by
    simp
  rwa [h_len] at h_list_mem

/-- The set of ordered tensor lists of fixed length. -/
def tensorListSet (n : ℕ) : Set (TensorRing F) :=
  { x | ∃ xs : List Fˣ, xs.length = n ∧ x = tensorList F xs }

private lemma tensorList_ofFn (n : ℕ) (f : Fin n → Fˣ) :
    tensorList F (List.ofFn f) =
      (List.ofFn (fun i => TensorAlgebra.ι ℤ (Additive.ofMul (f i)))).prod := by
  induction n with
  | zero => simp [List.ofFn_zero, tensorList_nil]
  | succ n ih => simp [List.ofFn_succ, tensorList_cons, List.prod_cons, ih]

private lemma tprod_fin_cases (n : ℕ) (a : Additive Fˣ) (f : Fin n → Additive Fˣ) :
    TensorAlgebra.tprod ℤ (Additive Fˣ) (n + 1) (Fin.cases a f) =
      TensorAlgebra.ι ℤ a * TensorAlgebra.tprod ℤ (Additive Fˣ) n f := by
  simp only [TensorAlgebra.tprod_apply, List.ofFn_succ, List.prod_cons]
  have h0 : (TensorAlgebra.ι ℤ (Fin.cases a f 0)) = TensorAlgebra.ι ℤ a := by simp
  have h1 : (fun i : Fin n => TensorAlgebra.ι ℤ (Fin.cases a f i.succ)) =
      (fun i : Fin n => TensorAlgebra.ι ℤ (f i)) := by funext i; simp
  rw [h0, h1]

private lemma tensorList_mem_range_tprod (xs : List Fˣ) :
    tensorList F xs ∈ Set.range (TensorAlgebra.tprod ℤ (Additive Fˣ) xs.length) := by
  induction xs with
  | nil =>
    exact ⟨Fin.elim0, by simp [tensorList_nil, TensorAlgebra.tprod_apply, List.ofFn_zero]⟩
  | cons hd tl ih =>
    obtain ⟨f_tl, hf_tl⟩ := ih
    let f : Fin (tl.length + 1) → Additive Fˣ :=
      Fin.cases (Additive.ofMul hd) f_tl
    have hf : TensorAlgebra.tprod ℤ (Additive Fˣ) (tl.length + 1) f =
        tensorList F (hd :: tl) := by
      calc TensorAlgebra.tprod ℤ (Additive Fˣ) (tl.length + 1) f
          = TensorAlgebra.ι ℤ (Additive.ofMul hd) *
              TensorAlgebra.tprod ℤ (Additive Fˣ) tl.length f_tl := by
            exact tprod_fin_cases F tl.length (Additive.ofMul hd) f_tl
        _ = TensorAlgebra.ι ℤ (Additive.ofMul hd) * tensorList F tl := by rw [hf_tl]
        _ = tensorList F (hd :: tl) := by simp [tensorList_cons]
    have h_len_eq : (hd :: tl).length = tl.length + 1 := rfl
    rw [h_len_eq]
    exact ⟨f, hf⟩

private lemma range_tprod_subset_tensorListSet (n : ℕ) :
    Set.range (TensorAlgebra.tprod ℤ (Additive Fˣ) n) ⊆ tensorListSet F n := by
  intro x hx
  obtain ⟨f, rfl⟩ := hx
  let u : Fin n → Fˣ := fun i => Additive.toMul (f i)
  have h_eq : TensorAlgebra.tprod ℤ (Additive Fˣ) n f = tensorList F (List.ofFn u) := by
    calc TensorAlgebra.tprod ℤ (Additive Fˣ) n f
        = (List.ofFn fun i => TensorAlgebra.ι ℤ (f i)).prod := by
          simp [TensorAlgebra.tprod_apply]
      _ = (List.ofFn fun i => TensorAlgebra.ι ℤ (Additive.ofMul (u i))).prod := by simp [u]
      _ = tensorList F (List.ofFn u) := (tensorList_ofFn F n u).symm
  exact ⟨List.ofFn u, by simp, h_eq⟩

/-- Degree `n` is spanned by ordered tensor lists of length `n`. -/
theorem degree_eq_span_tensorList (n : ℕ) :
    TensorRing.degree F n = Submodule.span ℤ (tensorListSet F n) := by
  have h_base := TensorAlgebra.degree_eq_span_range_tprod (R := ℤ) (M := Additive Fˣ) n
  have h_deg_eq : TensorRing.degree F n = TensorAlgebra.degree ℤ (Additive Fˣ) n := rfl
  have h_set_eq :
      Set.range (TensorAlgebra.tprod ℤ (Additive Fˣ) n) = tensorListSet F n := by
    apply Set.Subset.antisymm
    · exact range_tprod_subset_tensorListSet F n
    · intro y hy
      obtain ⟨xs, hlen, rfl⟩ := hy
      have h_mem := tensorList_mem_range_tprod F xs
      rw [hlen] at h_mem
      exact h_mem
  rw [h_deg_eq, h_base, h_set_eq]

/-- Span of `tensorListSet n` is contained in degree `n`. -/
theorem span_tensorList_le_degree (n : ℕ) :
    Submodule.span ℤ (tensorListSet F n) ≤ TensorRing.degree F n := by
  simp [degree_eq_span_tensorList]

/-- Degree zero is spanned by `1`. -/
theorem degree_zero_eq_span_one :
    TensorRing.degree F 0 = Submodule.span ℤ ({1} : Set (TensorRing F)) := by
  rw [TensorRing.degree, TensorAlgebra.degree_zero, Submodule.one_eq_span]

/-- In degree zero the tensor-list set is the singleton `{1}`. -/
theorem tensorListSet_zero : tensorListSet F 0 = {1} := by
  ext x
  constructor
  · rintro ⟨xs, hlen, rfl⟩
    have : xs = [] := List.length_eq_zero_iff.mp hlen
    simp [this, tensorList_nil]
  · intro hx
    simp only [Set.mem_singleton_iff] at hx
    refine ⟨[], ?_, ?_⟩
    · simp
    · simp [hx, tensorList_nil]

end TensorRing

namespace MilnorKRing

open TensorRing

/-- `mkLinear` maps tensor lists to symbol lists. -/
theorem mkLinear_tensorList (xs : List Fˣ) :
    mkLinear F (TensorRing.tensorList F xs) = symbolList F xs := by
  induction xs with
  | nil => simp [TensorRing.tensorList_nil, symbolList_nil, mkLinear_apply]
  | cons hd tl ih =>
      simp only [TensorRing.tensorList_cons, symbolList_cons]
      calc mkLinear F (TensorAlgebra.ι ℤ (Additive.ofMul hd) * TensorRing.tensorList F tl)
          = mk F (TensorAlgebra.ι ℤ (Additive.ofMul hd) * TensorRing.tensorList F tl) := by
            simp [mkLinear_apply]
        _ = mk F (TensorAlgebra.ι ℤ (Additive.ofMul hd)) *
              mk F (TensorRing.tensorList F tl) := by simp [map_mul]
        _ = symbol F hd * mk F (TensorRing.tensorList F tl) := by simp [symbol]
        _ = symbol F hd * mkLinear F (TensorRing.tensorList F tl) := by
            simp [mkLinear_apply]
        _ = symbol F hd * symbolList F tl := by rw [ih]
        _ = symbolList F (hd :: tl) := by simp [symbolList_cons]

/-- The set of ordered symbol lists of fixed length. -/
def symbolListSet (n : ℕ) : Set (MilnorKRing F) :=
  { x | ∃ xs : List Fˣ, xs.length = n ∧ x = symbolList F xs }

private lemma image_tensorListSet_eq_symbolListSet (n : ℕ) :
    mkLinear F '' TensorRing.tensorListSet F n = symbolListSet F n := by
  ext x
  constructor
  · rintro ⟨y, ⟨xs, hlen, rfl⟩, rfl⟩
    exact ⟨xs, hlen, mkLinear_tensorList F xs⟩
  · rintro ⟨xs, hlen, rfl⟩
    exact ⟨TensorRing.tensorList F xs, ⟨xs, hlen, rfl⟩, mkLinear_tensorList F xs⟩

/-- Degree `n` is spanned by ordered symbol lists of length `n`. -/
theorem degree_eq_span_symbolList (n : ℕ) :
    degree F n = Submodule.span ℤ (symbolListSet F n) := by
  unfold degree
  rw [TensorRing.degree_eq_span_tensorList F n]
  rw [Submodule.map_span]
  rw [← image_tensorListSet_eq_symbolListSet F n]

/-- Span of `symbolListSet n` is contained in degree `n`. -/
theorem span_symbolList_le_degree (n : ℕ) :
    Submodule.span ℤ (symbolListSet F n) ≤ degree F n := by
  simp [degree_eq_span_symbolList]

/-- Membership in degree via symbol list span. -/
theorem mem_degree_of_mem_span_symbolList {n : ℕ} {x : MilnorKRing F}
    (hx : x ∈ Submodule.span ℤ (symbolListSet F n)) :
    x ∈ degree F n :=
  span_symbolList_le_degree F n hx

/-- Degree zero is spanned by `1`. -/
theorem degree_zero_eq_span_one :
    degree F 0 = Submodule.span ℤ ({1} : Set (MilnorKRing F)) := by
  unfold degree
  rw [TensorRing.degree_zero_eq_span_one F, Submodule.map_span]
  simp [mkLinear_apply]

/-- In degree zero the symbol-list set is the singleton `{1}`. -/
theorem symbolListSet_zero : symbolListSet F 0 = {1} := by
  ext x
  constructor
  · rintro ⟨xs, hlen, rfl⟩
    have : xs = [] := List.length_eq_zero_iff.mp hlen
    simp [this, symbolList_nil]
  · intro hx
    simp only [Set.mem_singleton_iff] at hx
    refine ⟨[], ?_, ?_⟩
    · simp
    · simp [hx, symbolList_nil]

/-- The set of tuple symbols of length `n` as elements of `MilnorKRing F`.

This is the `Fin`-indexed counterpart of `symbolListSet`: every tuple symbol
`symbolTuple F n v` coerces to `symbolList F (List.ofFn v)`, and conversely
every list symbol of length `n` arises from a tuple via `ofFn`. -/
noncomputable def symbolTupleSet (n : ℕ) : Set (MilnorKRing F) :=
  Set.range (fun v : Fin n → Fˣ => (symbolTuple F n v : MilnorKRing F))

/-- List symbols and tuple symbols generate the same set in `MilnorKRing F`. -/
private theorem symbolListSet_eq_symbolTupleSet (n : ℕ) :
    symbolListSet F n = symbolTupleSet F n := by
  apply Set.Subset.antisymm
  · intro x hx
    obtain ⟨xs, hlen, rfl⟩ := hx
    let v : Fin n → Fˣ := fun i => xs[i.val]'(by rw [hlen]; exact i.is_lt)
    have h_ofFn : List.ofFn v = xs := by
      apply List.ext_getElem
      · simp [hlen]
      · intro i h1 h2
        simp only [List.getElem_ofFn, v]
    have h_coe : (symbolTuple F n v : MilnorKRing F) = symbolList F xs := by
      calc (symbolTuple F n v : MilnorKRing F)
          = symbolList F (List.ofFn v) := symbolTuple_coe F n v
        _ = symbolList F xs := by rw [h_ofFn]
    exact ⟨v, h_coe⟩
  · intro x hx
    obtain ⟨v, rfl⟩ := hx
    exact ⟨List.ofFn v, by simp, symbolTuple_coe F n v⟩

/-- Degree `n` is spanned by tuple symbols `symbolTuple F n`. -/
theorem degree_eq_span_symbolTuple (n : ℕ) :
    degree F n = Submodule.span ℤ (symbolTupleSet F n) := by
  calc degree F n
      = Submodule.span ℤ (symbolListSet F n) := degree_eq_span_symbolList F n
    _ = Submodule.span ℤ (symbolTupleSet F n) := by
        rw [symbolListSet_eq_symbolTupleSet F n]

/-- The range of `symbolTuple F n` spans the degree-`n` subtype. -/
theorem span_range_symbolTuple_eq_top (n : ℕ) :
    Submodule.span ℤ (Set.range (symbolTuple F n)) = ⊤ := by
  let p := degree F n
  let s : (Fin n → Fˣ) → MilnorKRing F := fun v =>
    (symbolTuple F n v : MilnorKRing F)
  have hs : ∀ v, s v ∈ p := fun v => (symbolTuple F n v).2
  have h_span : Submodule.span ℤ (Set.range s) = p := by
    have h_eq : Set.range s = symbolTupleSet F n := rfl
    rw [h_eq, ← degree_eq_span_symbolTuple F n]
  have h_top : Submodule.span ℤ
      (Set.range (fun v => (⟨s v, hs v⟩ : p))) = ⊤ := by
    rw [Submodule.span_range_subtype_eq_top_iff p hs]
    exact h_span
  have h_range_eq : Set.range (symbolTuple F n) =
      Set.range (fun v => (⟨s v, hs v⟩ : p)) := by
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      exact ⟨v, Subtype.ext rfl⟩
    · rintro ⟨v, rfl⟩
      exact ⟨v, rfl⟩
  rw [h_range_eq]
  exact h_top

/-- Two linear maps out of `degree F n` coincide if they agree on tuple symbols. -/
theorem symbolTuple_ext {M : Type*} [AddCommGroup M] [Module ℤ M] {n : ℕ}
    (f g : ↥(degree F n) →ₗ[ℤ] M)
    (h : ∀ v : Fin n → Fˣ, f (symbolTuple F n v) = g (symbolTuple F n v)) :
    f = g := by
  apply LinearMap.ext_on_range (span_range_symbolTuple_eq_top F n)
  intro v
  exact h v

end MilnorKRing

end MilnorK
