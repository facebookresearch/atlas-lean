module

public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.CategoryTheory.Skeletal
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic
public import MathlibExt.CategoryTheory.Waldhausen.Basic

/-!
# Grothendieck group of a Waldhausen structure without gluing

For a category `C` with a `WaldhausenCategoryWithoutGluing` structure, the group
`K₀(C)` is the free abelian group on isomorphism classes of objects modulo
the subgroup generated by

* weak equivalences `f : X ⟶ Y`, imposing `[X] = [Y]`;
* cofibration sequences `X ⟶ Y ⟶ Z`, imposing `[Y] = [X] + [Z]`.

The construction is nonadditive: no `Preadditive`, biproduct, exact-category, or ring
assumptions are used. Weak equivalences and cofibrations are the `MorphismProperty`
classes from `CategoryTheory.WaldhausenCategoryWithoutGluing`, each multiplicative and respecting
isomorphisms, with `0 ⟶ X` always a cofibration and pushouts along cofibrations
existing.

Its universal property: for any additive commutative group `A`, a set map
`φ : Skeleton C → A` that is invariant under weak equivalence and additive on
cofibration sequences factors uniquely through `K₀`.

## Main definitions
* `WaldhausenKTheory.K0Rel` — the relation subgroup on `FreeAbelianGroup (Skeleton C)`
* `WaldhausenKTheory.K0` — the Waldhausen `K₀` group
* `WaldhausenKTheory.K0.mk` — the `K₀` class of an object
* `WaldhausenKTheory.K0.lift` — the universal map into an additive group
* `WaldhausenKTheory.K0.lift_mk`, `WaldhausenKTheory.K0.hom_ext`,
  `WaldhausenKTheory.K0.lift_unique` — universal-property API
* `WaldhausenKTheory.K0.mk_eq_of_weakEquivalence`,
  `WaldhausenKTheory.K0.mk_eq_of_cofibrationSequence`,
  `WaldhausenKTheory.K0.mk_eq_of_iso` — generator lemmas
* `WaldhausenKTheory.K0.mk_zero` — the zero-object class vanishes

## Implementation notes
The quotient/lift pattern follows the exact-category `K₀` construction, but no
exact-category structure is imported or duplicated. The pushout requirement is the
existential `WaldhausenCategoryWithoutGluing.cofibration_pushout`, matching the exact-category
admissible-mono pushout shape but without additivity.

## References
* F. Waldhausen, *Algebraic K-theory of spaces*, Lecture Notes in Math. 1126.
* C. Weibel, *The K-book*, Chapter II.
-/

@[expose] public section

open CategoryTheory Limits ZeroObject

universe v u

namespace WaldhausenKTheory

variable (C : Type u) [Category.{v} C] [HasZeroObject C] [WaldhausenCategoryWithoutGluing C]

/-- The relation subgroup on `FreeAbelianGroup (Skeleton C)` generated by

* `of Y - of X` for a weak equivalence `X ⟶ Y`;
* `of Y - of X - of Z` for a cofibration sequence `X ⟶ Y ⟶ Z`.

Quotienting by this subgroup imposes `[X] = [Y]` for weak equivalences and
`[Y] = [X] + [Z]` for cofibration sequences. -/
def K0Rel : AddSubgroup (FreeAbelianGroup (Skeleton C)) :=
  AddSubgroup.closure
    ({ x |
        ∃ (X Y : C) (f : X ⟶ Y),
          IsWeakEquivalence (C := C) f ∧
            x = FreeAbelianGroup.of (toSkeleton Y) - FreeAbelianGroup.of (toSkeleton X) } ∪
      { x |
        ∃ (X Y Z : C) (f : X ⟶ Y) (g : Y ⟶ Z),
          IsCofibrationSequence (C := C) f g ∧
            x = FreeAbelianGroup.of (toSkeleton Y) - FreeAbelianGroup.of (toSkeleton X) -
              FreeAbelianGroup.of (toSkeleton Z) })

/-- The Waldhausen `K₀` group: free abelian group on `Skeleton C` modulo the
weak-equivalence and cofibration-sequence relations. -/
abbrev K0 : Type u :=
  FreeAbelianGroup (Skeleton C) ⧸ K0Rel C

variable {C}

/-- The `K₀` class of an object. -/
def K0.mk (X : C) : K0 C :=
  QuotientAddGroup.mk (FreeAbelianGroup.of (toSkeleton X))

/-- Weak equivalences identify `K₀` classes. -/
lemma K0.mk_eq_of_weakEquivalence {X Y : C} (f : X ⟶ Y)
    (hf : IsWeakEquivalence (C := C) f) : (K0.mk X : K0 C) = K0.mk Y := by
  unfold K0.mk
  rw [QuotientAddGroup.eq_iff_sub_mem]
  have hMem :
      FreeAbelianGroup.of (toSkeleton Y) - FreeAbelianGroup.of (toSkeleton X) ∈ K0Rel C := by
    apply AddSubgroup.subset_closure
    apply Set.mem_union_left
    exact ⟨X, Y, f, hf, rfl⟩
  have hNeg :
      FreeAbelianGroup.of (toSkeleton X) - FreeAbelianGroup.of (toSkeleton Y) ∈ K0Rel C := by
    have h := AddSubgroup.neg_mem (K0Rel C) hMem
    simpa [neg_sub] using h
  exact hNeg

/-- Cofibration sequences give additivity: `[Y] = [X] + [Z]`. -/
lemma K0.mk_eq_of_cofibrationSequence {X Y Z : C} {f : X ⟶ Y} {g : Y ⟶ Z}
    (h : IsCofibrationSequence (C := C) f g) :
    (K0.mk Y : K0 C) = K0.mk X + K0.mk Z := by
  unfold K0.mk
  rw [← QuotientAddGroup.mk_add, QuotientAddGroup.eq_iff_sub_mem, ← sub_sub]
  apply AddSubgroup.subset_closure
  apply Set.mem_union_right
  exact ⟨X, Y, Z, f, g, h, rfl⟩

/-- Isomorphic objects have the same `K₀` class. -/
lemma K0.mk_eq_of_iso {X Y : C} (e : X ≅ Y) :
    (K0.mk X : K0 C) = K0.mk Y := by
  have hf : IsWeakEquivalence (C := C) e.hom :=
    MorphismProperty.of_isIso (WaldhausenCategoryWithoutGluing.weakEquivalences (C := C)) e.hom
  exact K0.mk_eq_of_weakEquivalence e.hom hf

/-- The class of the zero object vanishes. -/
@[simp]
lemma K0.mk_zero : (K0.mk (0 : C) : K0 C) = 0 := by
  have hCof : IsCofibration (C := C) (𝟙 (0 : C)) :=
    WaldhausenCategoryWithoutGluing.zero_isCofibration (0 : C) (𝟙 (0 : C))
  have hSeq : IsCofibrationSequence (C := C) (𝟙 (0 : C)) (𝟙 (0 : C)) := by
    refine ⟨hCof, 𝟙 (0 : C), 𝟙 (0 : C), ?_⟩
    -- the identity square on `0` is a pushout
    have hPush : IsPushout (𝟙 (0 : C)) (𝟙 (0 : C)) (𝟙 (0 : C)) (𝟙 (0 : C)) :=
      IsPushout.of_horiz_isIso ⟨by simp⟩
    exact hPush
  have hAdd : (K0.mk (0 : C) : K0 C) = K0.mk (0 : C) + K0.mk (0 : C) :=
    K0.mk_eq_of_cofibrationSequence hSeq
  have hZeroAdd : K0.mk (0 : C) + (0 : K0 C) = K0.mk (0 : C) + K0.mk (0 : C) :=
    (add_zero _).trans hAdd
  exact (add_left_cancel hZeroAdd).symm

/-- Universal property: a map `φ : Skeleton C → A` invariant under weak equivalence
and additive on cofibration sequences factors uniquely through `K₀`.

`hφ_we` expresses invariance under weak equivalence, `hφ_cofib` expresses
additivity on cofibration sequences. -/
noncomputable def K0.lift {A : Type*} [AddCommGroup A] (φ : Skeleton C → A)
    (hφ_we : ∀ {X Y : C} (f : X ⟶ Y),
      IsWeakEquivalence (C := C) f → φ (toSkeleton X) = φ (toSkeleton Y))
    (hφ_cofib : ∀ {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z),
      IsCofibrationSequence (C := C) f g →
        φ (toSkeleton Y) = φ (toSkeleton X) + φ (toSkeleton Z)) :
    K0 C →+ A :=
  QuotientAddGroup.lift (K0Rel C) (FreeAbelianGroup.lift φ) (by
    unfold K0Rel
    rw [AddSubgroup.closure_le]
    rintro x hx
    rcases hx with hx | hx
    · obtain ⟨X, Y, f, hf, rfl⟩ := hx
      simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub,
        FreeAbelianGroup.lift_apply_of]
      rw [hφ_we f hf]
      simp
    · obtain ⟨X, Y, Z, f, g, hg, rfl⟩ := hx
      simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub,
        FreeAbelianGroup.lift_apply_of]
      rw [hφ_cofib f g hg]
      simp)

@[simp]
lemma K0.lift_mk {A : Type*} [AddCommGroup A] (φ : Skeleton C → A)
    (hφ_we : ∀ {X Y : C} (f : X ⟶ Y),
      IsWeakEquivalence (C := C) f → φ (toSkeleton X) = φ (toSkeleton Y))
    (hφ_cofib : ∀ {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z),
      IsCofibrationSequence (C := C) f g →
        φ (toSkeleton Y) = φ (toSkeleton X) + φ (toSkeleton Z))
    (X : C) :
    K0.lift (C := C) φ hφ_we hφ_cofib (K0.mk X) = φ (toSkeleton X) := by
  simp only [K0.lift, K0.mk]
  rw [QuotientAddGroup.lift_mk', FreeAbelianGroup.lift_apply_of]

@[ext]
lemma K0.hom_ext {A : Type*} [AddCommGroup A] {f g : K0 C →+ A}
    (h : ∀ (X : C), f (K0.mk X) = g (K0.mk X)) : f = g := by
  apply QuotientAddGroup.addMonoidHom_ext
  apply FreeAbelianGroup.lift_ext
  intro a
  have ha : toSkeleton (Quotient.out a) = a := Quotient.out_eq a
  have h0 : f (K0.mk (Quotient.out a)) = g (K0.mk (Quotient.out a)) := h _
  simpa [K0.mk, QuotientAddGroup.mk'_apply, ha] using h0

/-- For a function `φ` on `Skeleton C` respecting weak equivalences and
additive on cofibration sequences, any additive homomorphism agreeing
with `φ` on every object class equals its universal lift. -/
lemma K0.lift_unique {A : Type*} [AddCommGroup A] (φ : Skeleton C → A)
    (hφ_we : ∀ {X Y : C} (f : X ⟶ Y),
      IsWeakEquivalence (C := C) f → φ (toSkeleton X) = φ (toSkeleton Y))
    (hφ_cofib : ∀ {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z),
      IsCofibrationSequence (C := C) f g →
        φ (toSkeleton Y) = φ (toSkeleton X) + φ (toSkeleton Z))
    (g : K0 C →+ A) (hg : ∀ (X : C), g (K0.mk X) = φ (toSkeleton X)) :
    g = K0.lift φ hφ_we hφ_cofib :=
  K0.hom_ext fun X => by rw [hg, K0.lift_mk]

end WaldhausenKTheory
