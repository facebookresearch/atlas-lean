module

public import MathlibExt.KTheory.Ring.K2.MatsumotoTitsBruhatFiber
public import MathlibExt.KTheory.Ring.K2.MatsumotoTitsBruhatWeylAction
public import MathlibExt.KTheory.Ring.K2.MatsumotoTitsBruhatActionSubgroups
public import MathlibExt.LinearAlgebra.Matrix.GeneralLinearGroup.UpperWeylGeneration
public import MathlibExt.GroupTheory.SubgroupClosureCommutation
public import Mathlib.GroupTheory.Subgroup.Center
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# The left extension group from Tits Bruhat actions

Forms the subgroup generated by paired upper, adjacent Weyl and central actions
on the Tits Bruhat fibre. Its Milnor K₂ inclusion is injective and central, and
its projection to the special linear group is surjective in rank at least two.
-/

@[expose] public section

universe u

open Matrix
open Matrix.GeneralLinearGroup
open MatsumotoTitsBruhatFiber

namespace MatsumotoTitsBruhatFiber

section LeftExtension

variable (F : Type u) [Field F] (n : ℕ)

/-- Paired generators for the left extension:
upper pairs, adjacent left-Weyl pairs with unit `1`,
and central pairs. -/
def leftExtensionPairGenerators :
    Set (Matrix.SpecialLinearGroup (Fin n) F ×
      Equiv.Perm (X F n)) :=
  { p | ∃ u : upperElementarySubgroup (Fin n) F,
      p = (UpperElementary.toSLHom u, leftUpperPerm u) } ∪
  { p | ∃ (i j : Fin n) (hij : i ⋖ j),
      p = (weylSLUnit i j hij.ne (1 : Fˣ),
        leftWeylPerm hij) } ∪
  { p | ∃ c : Multiplicative (MilnorK F 2),
      p = (1, centralPerm c) }

/-- Left extension subgroup as closure of paired generators. -/
def leftExtensionSubgroup :
    Subgroup (Matrix.SpecialLinearGroup (Fin n) F ×
      Equiv.Perm (X F n)) :=
  Subgroup.closure (leftExtensionPairGenerators F n)

theorem leftUpperPair_mem_leftExtensionSubgroup
    (u : upperElementarySubgroup (Fin n) F) :
    (UpperElementary.toSLHom u,
        leftUpperPerm (F := F) (n := n) u) ∈
      leftExtensionSubgroup F n := by
  apply Subgroup.subset_closure
  show (UpperElementary.toSLHom u, leftUpperPerm u) ∈
    leftExtensionPairGenerators F n
  exact Or.inl (Or.inl ⟨u, rfl⟩)

theorem leftWeylPair_mem_leftExtensionSubgroup
    {i j : Fin n} (hij : i ⋖ j) :
    (weylSLUnit i j hij.ne (1 : Fˣ),
        leftWeylPerm (F := F) (n := n) hij) ∈
      leftExtensionSubgroup F n := by
  apply Subgroup.subset_closure
  show (weylSLUnit i j hij.ne (1 : Fˣ), leftWeylPerm hij) ∈
    leftExtensionPairGenerators F n
  exact Or.inl (Or.inr ⟨i, j, hij, rfl⟩)

theorem centralPair_mem_leftExtensionSubgroup
    (c : Multiplicative (MilnorK F 2)) :
    ((1 : Matrix.SpecialLinearGroup (Fin n) F),
        centralPerm (F := F) (n := n) c) ∈
      leftExtensionSubgroup F n := by
  apply Subgroup.subset_closure
  show ((1 : Matrix.SpecialLinearGroup (Fin n) F),
      centralPerm (F := F) (n := n) c) ∈
    leftExtensionPairGenerators F n
  exact Or.inr ⟨c, rfl⟩

/-- Compatible pairs: permutation acts on `X` by left-multiplying the
`fst` coordinate by the `SL` component. -/
def leftCompatiblePairSubgroup :
    Subgroup (Matrix.SpecialLinearGroup (Fin n) F ×
      Equiv.Perm (X F n)) where
  carrier :=
    { p | ∀ x : X F n, X.fst (p.2 x) = p.1 * X.fst x }
  one_mem' := by
    intro x
    simp
  mul_mem' := by
    intro a b ha hb x
    have ha' : ∀ y : X F n, X.fst (a.2 y) = a.1 * X.fst y := ha
    have hb' : ∀ y : X F n, X.fst (b.2 y) = b.1 * X.fst y := hb
    change X.fst ((a * b).2 x) = (a * b).1 * X.fst x
    have hProdFst : (a * b).1 = a.1 * b.1 := rfl
    have hProdSnd : (a * b).2 = a.2 * b.2 := rfl
    calc X.fst ((a * b).2 x)
        = X.fst ((a.2 * b.2) x) := by rw [hProdSnd]
      _ = X.fst (a.2 (b.2 x)) := by rw [Equiv.Perm.mul_apply]
      _ = a.1 * X.fst (b.2 x) := ha' (b.2 x)
      _ = a.1 * (b.1 * X.fst x) := by rw [hb' x]
      _ = (a.1 * b.1) * X.fst x := by rw [mul_assoc]
      _ = (a * b).1 * X.fst x := by rw [hProdFst]
  inv_mem' := by
    intro a ha x
    have ha' : ∀ y : X F n, X.fst (a.2 y) = a.1 * X.fst y := ha
    change X.fst ((a⁻¹).2 x) = (a⁻¹).1 * X.fst x
    have hInvFst : (a⁻¹).1 = (a.1)⁻¹ := rfl
    have hInvSnd : (a⁻¹).2 = (a.2)⁻¹ := rfl
    have hApply : a.2 ((a.2)⁻¹ x) = x := by
      simp
    have h1 : X.fst (a.2 ((a.2)⁻¹ x)) = a.1 * X.fst ((a.2)⁻¹ x) :=
      ha' ((a.2)⁻¹ x)
    rw [hApply] at h1
    calc X.fst ((a⁻¹).2 x)
        = X.fst ((a.2)⁻¹ x) := by rw [hInvSnd]
      _ = (a.1)⁻¹ * (a.1 * X.fst ((a.2)⁻¹ x)) := by
          rw [inv_mul_cancel_left]
      _ = (a.1)⁻¹ * X.fst x := by rw [← h1]
      _ = (a⁻¹).1 * X.fst x := by rw [hInvFst]

theorem leftUpperPair_compatible
    (u : upperElementarySubgroup (Fin n) F) (x : X F n) :
    X.fst (leftUpperPerm (F := F) (n := n) u x) =
      UpperElementary.toSLHom u * X.fst x :=
  rfl

theorem leftWeylPair_compatible
    {i j : Fin n} (hij : i ⋖ j) (x : X F n) :
    X.fst (leftWeylPerm (F := F) (n := n) hij x) =
      weylSLUnit i j hij.ne (1 : Fˣ) * X.fst x :=
  rfl

theorem centralPair_compatible
    (c : Multiplicative (MilnorK F 2)) (x : X F n) :
    X.fst (centralPerm (F := F) (n := n) c x) =
      (1 : Matrix.SpecialLinearGroup (Fin n) F) * X.fst x := by
  simp

theorem leftUpperPair_mem_leftCompatible
    (u : upperElementarySubgroup (Fin n) F) :
    (UpperElementary.toSLHom u,
        leftUpperPerm (F := F) (n := n) u) ∈
      leftCompatiblePairSubgroup F n := by
  intro x
  exact leftUpperPair_compatible F n u x

theorem leftWeylPair_mem_leftCompatible
    {i j : Fin n} (hij : i ⋖ j) :
    (weylSLUnit i j hij.ne (1 : Fˣ),
        leftWeylPerm (F := F) (n := n) hij) ∈
      leftCompatiblePairSubgroup F n := by
  intro x
  exact leftWeylPair_compatible F n hij x

theorem centralPair_mem_leftCompatible
    (c : Multiplicative (MilnorK F 2)) :
    ((1 : Matrix.SpecialLinearGroup (Fin n) F),
        centralPerm (F := F) (n := n) c) ∈
      leftCompatiblePairSubgroup F n := by
  intro x
  exact centralPair_compatible F n c x

theorem leftExtensionPairGenerators_le_leftCompatible :
    leftExtensionPairGenerators F n ≤
      (leftCompatiblePairSubgroup F n : Set _) := by
  apply Set.union_subset
  · apply Set.union_subset
    · rintro p ⟨u, rfl⟩
      exact leftUpperPair_mem_leftCompatible F n u
    · rintro p ⟨i, j, hij, rfl⟩
      exact leftWeylPair_mem_leftCompatible F n hij
  · rintro p ⟨c, rfl⟩
    exact centralPair_mem_leftCompatible F n c

theorem leftExtensionSubgroup_le_leftCompatiblePairSubgroup :
    leftExtensionSubgroup F n ≤ leftCompatiblePairSubgroup F n :=
  (Subgroup.closure_le (K := leftCompatiblePairSubgroup F n)).mpr
    (leftExtensionPairGenerators_le_leftCompatible F n)

theorem leftExtension_compat
    {p : Matrix.SpecialLinearGroup (Fin n) F ×
      Equiv.Perm (X F n)}
    (hp : p ∈ leftExtensionSubgroup F n) (x : X F n) :
    X.fst (p.2 x) = p.1 * X.fst x :=
  leftExtensionSubgroup_le_leftCompatiblePairSubgroup F n hp x

/-- Restriction of the first projection to the left extension. -/
def leftExtensionProjHom :
    leftExtensionSubgroup F n →*
      Matrix.SpecialLinearGroup (Fin n) F where
  toFun p := p.val.1
  map_one' := rfl
  map_mul' _ _ := rfl

@[simp]
theorem leftExtensionProjHom_apply
    (p : leftExtensionSubgroup F n) :
    leftExtensionProjHom F n p = p.val.1 :=
  rfl

@[simp]
theorem leftExtensionProjHom_coe
    (p : leftExtensionSubgroup F n) (x : X F n) :
    X.fst (p.val.2 x) = leftExtensionProjHom F n p * X.fst x :=
  leftExtension_compat F n p.prop x

/-- Central pair homomorphism into the left extension. -/
noncomputable def centralPairHom :
    Multiplicative (MilnorK F 2) →*
      leftExtensionSubgroup F n where
  toFun c :=
    ⟨(1, centralPerm (F := F) (n := n) c),
      centralPair_mem_leftExtensionSubgroup F n c⟩
  map_one' := by
    apply Subtype.ext
    simp [centralPerm_one]
  map_mul' c₁ c₂ := by
    apply Subtype.ext
    simp [centralPerm_mul]

@[simp]
theorem centralPairHom_val
    (c : Multiplicative (MilnorK F 2)) :
    (centralPairHom F n c).val =
      ((1 : Matrix.SpecialLinearGroup (Fin n) F),
        centralPerm (F := F) (n := n) c) :=
  rfl

theorem centralPairHom_apply_fst
    (c : Multiplicative (MilnorK F 2)) :
    ((centralPairHom F n c).val).1 =
      (1 : Matrix.SpecialLinearGroup (Fin n) F) :=
  rfl

theorem centralPairHom_apply_snd
    (c : Multiplicative (MilnorK F 2)) :
    ((centralPairHom F n c).val).2 =
      centralPerm (F := F) (n := n) c :=
  rfl

theorem centralPairHom_injective :
    Function.Injective (centralPairHom (F := F) (n := n)) := by
  intro c₁ c₂ h
  have hVal :
      (centralPairHom F n c₁).val = (centralPairHom F n c₂).val :=
    congrArg Subtype.val h
  have hPerm :
      centralPerm (F := F) (n := n) c₁ =
        centralPerm (F := F) (n := n) c₂ := by
    have hSnd := congrArg Prod.snd hVal
    simpa using hSnd
  have hHom :
      centralHom (F := F) (n := n) c₁ =
        centralHom (F := F) (n := n) c₂ := by
    apply Equiv.ext
    intro x
    calc centralHom (F := F) (n := n) c₁ x
        = central (F := F) (n := n) c₁ x := by
          simp [centralHom_apply]
      _ = centralPerm (F := F) (n := n) c₁ x := by
          simp [← centralPerm_apply]
      _ = centralPerm (F := F) (n := n) c₂ x := by
          rw [hPerm]
      _ = central (F := F) (n := n) c₂ x := by
          simp [centralPerm_apply]
      _ = centralHom (F := F) (n := n) c₂ x := by
          simp [← centralHom_apply]
  exact centralHom_injective hHom

theorem centralPairHom_range_le_ker_leftExtensionProjHom :
    (centralPairHom (F := F) (n := n)).range ≤
      (leftExtensionProjHom F n).ker := by
  intro y hy
  rw [MonoidHom.mem_range] at hy
  obtain ⟨c, rfl⟩ := hy
  rw [MonoidHom.mem_ker]
  rfl

theorem centralPair_commutes_with_leftExtensionGenerators
    (c₀ : Multiplicative (MilnorK F 2))
    {g : Matrix.SpecialLinearGroup (Fin n) F ×
      Equiv.Perm (X F n)}
    (hg : g ∈ leftExtensionPairGenerators F n) :
    Commute ((1 : Matrix.SpecialLinearGroup (Fin n) F),
        centralPerm (F := F) (n := n) c₀) g := by
  have hA :
      ∀ u : upperElementarySubgroup (Fin n) F,
        Commute ((1 : Matrix.SpecialLinearGroup (Fin n) F),
          centralPerm (F := F) (n := n) c₀)
          (UpperElementary.toSLHom u, leftUpperPerm u) := by
    intro u
    rw [Commute, SemiconjBy]
    apply Prod.ext
    · simp
    · simp [centralPerm_leftUpperPerm_comm]
  have hB :
      ∀ (i j : Fin n) (hij : i ⋖ j),
        Commute ((1 : Matrix.SpecialLinearGroup (Fin n) F),
          centralPerm (F := F) (n := n) c₀)
          (weylSLUnit i j hij.ne (1 : Fˣ), leftWeylPerm hij) := by
    intro i j hij
    rw [Commute, SemiconjBy]
    apply Prod.ext
    · simp
    · simp [centralPerm_leftWeylPerm_comm hij c₀]
  have hC :
      ∀ c : Multiplicative (MilnorK F 2),
        Commute ((1 : Matrix.SpecialLinearGroup (Fin n) F),
          centralPerm (F := F) (n := n) c₀)
          ((1 : Matrix.SpecialLinearGroup (Fin n) F),
            centralPerm (F := F) (n := n) c) := by
    intro c
    rw [Commute, SemiconjBy]
    apply Prod.ext
    · simp
    · change centralPerm (F := F) (n := n) c₀ *
          centralPerm (F := F) (n := n) c =
        centralPerm (F := F) (n := n) c *
          centralPerm (F := F) (n := n) c₀
      have h1 :
          centralPerm (F := F) (n := n) c₀ *
              centralPerm (F := F) (n := n) c =
            centralPerm (F := F) (n := n) (c₀ * c) := by
        rw [← centralPerm_mul]
      have h2 :
          centralPerm (F := F) (n := n) c *
              centralPerm (F := F) (n := n) c₀ =
            centralPerm (F := F) (n := n) (c * c₀) := by
        rw [← centralPerm_mul]
      have hComm : c₀ * c = c * c₀ := mul_comm c₀ c
      rw [h1, h2, hComm]
  have hSubset :
      leftExtensionPairGenerators F n ⊆
        { g | Commute
          ((1 : Matrix.SpecialLinearGroup (Fin n) F),
            centralPerm (F := F) (n := n) c₀) g } := by
    apply Set.union_subset
    · apply Set.union_subset
      · rintro p ⟨u, rfl⟩
        exact hA u
      · rintro p ⟨i, j, hij, rfl⟩
        exact hB i j hij
    · rintro p ⟨c, rfl⟩
      exact hC c
  exact hSubset hg

theorem centralPair_mem_centralizer_leftExtensionGenerators
    (c₀ : Multiplicative (MilnorK F 2)) :
    ((1 : Matrix.SpecialLinearGroup (Fin n) F),
        centralPerm (F := F) (n := n) c₀) ∈
      Subgroup.centralizer (leftExtensionPairGenerators F n) := by
  rw [Subgroup.mem_centralizer_iff]
  intro g hg
  exact
    (centralPair_commutes_with_leftExtensionGenerators F n c₀ hg).symm

theorem centralPair_mem_centralizer_leftExtensionSubgroup
    (c₀ : Multiplicative (MilnorK F 2)) :
    ((1 : Matrix.SpecialLinearGroup (Fin n) F),
        centralPerm (F := F) (n := n) c₀) ∈
      Subgroup.centralizer (leftExtensionSubgroup F n : Set _) := by
  have hEq :
      Subgroup.centralizer (leftExtensionSubgroup F n : Set _) =
        Subgroup.centralizer (leftExtensionPairGenerators F n) := by
    unfold leftExtensionSubgroup
    rw [Subgroup.centralizer_closure]
  rw [hEq]
  exact centralPair_mem_centralizer_leftExtensionGenerators F n c₀

theorem centralPairHom_range_le_center :
    (centralPairHom (F := F) (n := n)).range ≤
      Subgroup.center (leftExtensionSubgroup F n) := by
  intro y hy
  rw [MonoidHom.mem_range] at hy
  obtain ⟨c, rfl⟩ := hy
  rw [Subgroup.mem_center_iff]
  intro z
  have hCent :=
    centralPair_mem_centralizer_leftExtensionSubgroup F n c
  have hMem : z.val ∈ leftExtensionSubgroup F n := z.prop
  have hComm :
      Commute
        ((1 : Matrix.SpecialLinearGroup (Fin n) F),
          centralPerm (F := F) (n := n) c) z.val :=
    ((Subgroup.mem_centralizer_iff.mp hCent) z.val hMem).symm
  have hCommVal :
      Commute (centralPairHom F n c).val z.val := by
    simpa [centralPairHom_val] using hComm
  change z * centralPairHom F n c = centralPairHom F n c * z
  apply Subtype.ext
  exact hCommVal.symm.eq

theorem upperWeylSubgroup_le_range_leftExtensionProjHom :
    Matrix.GeneralLinearGroup.upperWeylSubgroup (ι := Fin n) (R := F) ≤
      (leftExtensionProjHom F n).range := by
  rw [Matrix.GeneralLinearGroup.upperWeylSubgroup]
  apply (Subgroup.closure_le (K := (leftExtensionProjHom F n).range)).mpr
  intro g hg
  simp only [Matrix.GeneralLinearGroup.upperWeylGenerators, Set.mem_union,
    Set.mem_range] at hg
  rcases hg with hg | hg
  · obtain ⟨u, rfl⟩ := hg
    exact MonoidHom.mem_range.mpr
      ⟨⟨(Matrix.GeneralLinearGroup.UpperElementary.toSLHom u,
        leftUpperPerm (F := F) (n := n) u),
        leftUpperPair_mem_leftExtensionSubgroup F n u⟩, rfl⟩
  · obtain ⟨i, j, hij, rfl⟩ := hg
    exact MonoidHom.mem_range.mpr
      ⟨⟨(weylSLUnit i j hij.ne (1 : Fˣ), leftWeylPerm hij),
        leftWeylPair_mem_leftExtensionSubgroup (F := F) (n := n) hij⟩, rfl⟩

theorem leftExtensionProjHom_surjective (hn : 2 ≤ n) :
    Function.Surjective (leftExtensionProjHom F n) := by
  have hNontrivial : Nontrivial (Fin n) := (Fin.nontrivial_iff_two_le.mpr hn)
  have hTop :
      Matrix.GeneralLinearGroup.upperWeylSubgroup (ι := Fin n) (R := F) = ⊤ :=
    @Matrix.GeneralLinearGroup.upperWeylSubgroup_eq_top (Fin n) _ _ _ F _ hNontrivial
  have hLe :
      Matrix.GeneralLinearGroup.upperWeylSubgroup (ι := Fin n) (R := F) ≤
        (leftExtensionProjHom F n).range :=
    upperWeylSubgroup_le_range_leftExtensionProjHom F n
  have hRangeTop : (leftExtensionProjHom F n).range = ⊤ :=
    eq_top_iff.mpr (hTop ▸ hLe)
  exact (MonoidHom.range_eq_top.mp hRangeTop)

end LeftExtension

end MatsumotoTitsBruhatFiber

end
