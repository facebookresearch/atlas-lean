module

public import MathlibExt.KTheory.Ring.K2.SteinbergSymbolIndexIndependence
public import MathlibExt.KTheory.Ring.K2.StableSteinbergRankTwoBoundaryEval
public import MathlibExt.KTheory.Ring.K2.StableSteinbergFiniteWeylTorus

/-! # Torus-cocycle subgroup: easy inclusion

Easy inclusion `⟨range torusCocycle⟩ ≤ ker toStableE ⊓ finiteStage 2`.
No reverse inclusion claimed.
-/

@[expose] public section

namespace AlgebraicKTheory.StableSteinberg

universe u

variable {F : Type u} [Field F]

/-- Product-pair form of `torusCocycle` at `(0,1)` via `Set.range`. -/
def torusCocycleProd : Fˣ × Fˣ → StableSteinberg F :=
  fun p => torusCocycle (F := F) p.1 p.2

/-- Subgroup generated by `torusCocycle` at `(0,1)` over a field. -/
def torusCocycleSubgroup : Subgroup (StableSteinberg F) :=
  Subgroup.closure (Set.range (torusCocycleProd (F := F)))

private theorem torus01_mem_finiteStage_two (u : Fˣ) :
    torus (R := F) 0 1 (by omega) u ∈ finiteStage (R := F) 2 := by
  have h0 : (0 : ℕ) < 1 := by decide
  have hm := torus_mem_finiteStage_succ (F := F) h0 u
  have heq : (Nat.ne_of_lt h0 : (0 : ℕ) ≠ 1) = (by omega : 0 ≠ 1) :=
    Subsingleton.elim _ _
  have h_eq : torus (R := F) 0 1 (Nat.ne_of_lt h0) u =
      torus (R := F) 0 1 (by omega) u := by rw [heq]
  rw [← h_eq]; exact hm

private theorem torusCocycle_mem_finiteStage_two (u v : Fˣ) :
    torusCocycle (F := F) u v ∈ finiteStage (R := F) 2 := by
  unfold torusCocycle
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _
    (torus01_mem_finiteStage_two u) (torus01_mem_finiteStage_two v))
    ((finiteStage (R := F) 2).inv_mem (torus01_mem_finiteStage_two (u * v)))

/-- Easy inclusion into `ker toStableE ⊓ finiteStage 2`. -/
theorem torusCocycleSubgroup_le_inf_ker_toStableE_finiteStage_two :
    torusCocycleSubgroup (F := F) ≤
      MonoidHom.ker (toStableE (R := F)) ⊓ finiteStage (R := F) 2 := by
  rw [torusCocycleSubgroup, Subgroup.closure_le]
  intro g hg; obtain ⟨⟨u, v⟩, rfl⟩ := Set.mem_range.mp hg
  exact Subgroup.mem_inf.mpr ⟨MonoidHom.mem_ker.mpr
    (toStableE_torusCocycle (F := F) u v),
    torusCocycle_mem_finiteStage_two (F := F) u v⟩

theorem torusCocycleSubgroup_le_ker_toStableE :
    torusCocycleSubgroup (F := F) ≤ MonoidHom.ker (toStableE (R := F)) :=
  le_trans torusCocycleSubgroup_le_inf_ker_toStableE_finiteStage_two inf_le_left

theorem torusCocycleSubgroup_le_finiteStage_two :
    torusCocycleSubgroup (F := F) ≤ finiteStage (R := F) 2 :=
  le_trans torusCocycleSubgroup_le_inf_ker_toStableE_finiteStage_two inf_le_right

/-- Torus-cocycle subgroup lies in the finite torus subgroup; the rank hypothesis is `2 ≤ n`.

Each `(0, 1)` torus factor satisfies `0 < n` and `1 < n`, hence lies in
`finiteTorusSubgroup n` via `torus_mem_finiteTorusSubgroup`; closure then gives
the inclusion. No reverse inclusion, equality, normality, or Matsumoto claim;
no claim for `n < 2`. -/
theorem torusCocycleSubgroup_le_finiteTorusSubgroup {n : ℕ} (hn : 2 ≤ n) :
    torusCocycleSubgroup (F := F) ≤ finiteTorusSubgroup (R := F) n := by
  rw [torusCocycleSubgroup, Subgroup.closure_le]
  intro g hg
  obtain ⟨⟨u, v⟩, rfl⟩ := Set.mem_range.mp hg
  unfold torusCocycleProd torusCocycle
  have h0n : (0 : ℕ) < n := by omega
  have h1n : (1 : ℕ) < n := by omega
  have h01 : (0 : ℕ) ≠ 1 := by omega
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _
    (torus_mem_finiteTorusSubgroup h0n h1n h01 u)
    (torus_mem_finiteTorusSubgroup h0n h1n h01 v))
    ((finiteTorusSubgroup (R := F) n).inv_mem
      (torus_mem_finiteTorusSubgroup h0n h1n h01 (u * v)))

/-- Torus-cocycle subgroup lies in the center. -/
theorem torusCocycleSubgroup_le_center :
    torusCocycleSubgroup (F := F) ≤ Subgroup.center (StableSteinberg F) := by
  rw [torusCocycleSubgroup, Subgroup.closure_le]
  intro g hg
  obtain ⟨⟨u, v⟩, rfl⟩ := Set.mem_range.mp hg
  exact torusCocycle_mem_center (F := F) u v

/-- Every `torusCocycleAt` lies in the torus-cocycle subgroup. -/
theorem torusCocycleAt_mem_torusCocycleSubgroup (i j : ℕ) (hij : i ≠ j)
    (u v : Fˣ) :
    torusCocycleAt (F := F) i j hij u v ∈ torusCocycleSubgroup := by
  rw [torusCocycleAt_eq_torusCocycle]
  have h : torusCocycle (F := F) u v ∈
      Set.range (torusCocycleProd (F := F)) := ⟨(u, v), rfl⟩
  exact Subgroup.subset_closure h

/-- Finite stage 0 is `⊥`, so `ker ⊓ stage 0 ≤ torusCocycleSubgroup`.
    Nonclaim: does not prove rank-two base or full kernel generation. -/
theorem ker_toStableE_inf_finiteStage_zero_le_torusCocycleSubgroup :
    MonoidHom.ker (toStableE (R := F)) ⊓ finiteStage (R := F) 0 ≤
      torusCocycleSubgroup (F := F) := by
  calc _ ≤ finiteStage (R := F) 0 := inf_le_right
    _ = ⊥ := finiteStage_zero_eq_bot
    _ ≤ _ := bot_le

/-- Finite stage 1 is `⊥`, so `ker ⊓ stage 1 ≤ torusCocycleSubgroup`.
    Nonclaim: does not prove rank-two base or full kernel generation. -/
theorem ker_toStableE_inf_finiteStage_one_le_torusCocycleSubgroup :
    MonoidHom.ker (toStableE (R := F)) ⊓ finiteStage (R := F) 1 ≤
      torusCocycleSubgroup (F := F) := by
  calc _ ≤ finiteStage (R := F) 1 := inf_le_right
    _ = ⊥ := finiteStage_one_eq_bot
    _ ≤ _ := bot_le

/-- Only the singleton boundary-block kernel case, not finiteStage 2 kernel generation. -/
theorem ker_toStableE_lastBoundaryBlock_singleton_mem_torusCocycleSubgroup
    (b : Sum (Fin 1 → Multiplicative F) (Fin 1 → Multiplicative F))
    (h : toStableE (lastBoundaryBlock 1 b) = 1) :
    lastBoundaryBlock 1 b ∈ torusCocycleSubgroup := by
  cases b with
  | inl c =>
    rw [lastBoundaryBlock_inl] at h ⊢
    have hm : lastColumnProduct (R := F) 1 c ∈
        lastColumnSubgroup (R := F) 1 := by
      rw [← lastColumnProduct_range (R := F) 1]
      exact MonoidHom.mem_range.mpr ⟨c, rfl⟩
    have h1 : (1 : StableSteinberg F) ∈ lastColumnSubgroup (R := F) 1 :=
      (lastColumnSubgroup (R := F) 1).one_mem
    have he : toStableE (R := F) (lastColumnProduct (R := F) 1 c) =
        toStableE (R := F) 1 := by rw [h, map_one]
    have heq : lastColumnProduct (R := F) 1 c = 1 :=
      toStableE_injOn_lastColumnSubgroup (R := F) 1 hm h1 he
    rw [heq]; exact (torusCocycleSubgroup (F := F)).one_mem
  | inr r =>
    rw [lastBoundaryBlock_inr] at h ⊢
    have hm : lastRowProduct (R := F) 1 r ∈ lastRowSubgroup (R := F) 1 := by
      rw [← lastRowProduct_range (R := F) 1]
      exact MonoidHom.mem_range.mpr ⟨r, rfl⟩
    have h1 : (1 : StableSteinberg F) ∈ lastRowSubgroup (R := F) 1 :=
      (lastRowSubgroup (R := F) 1).one_mem
    have he : toStableE (R := F) (lastRowProduct (R := F) 1 r) =
        toStableE (R := F) 1 := by rw [h, map_one]
    have heq : lastRowProduct (R := F) 1 r = 1 :=
      toStableE_injOn_lastRowSubgroup (R := F) 1 hm h1 he
    rw [heq]; exact (torusCocycleSubgroup (F := F)).one_mem

/-- Column-then-row pair kernel membership for `Fin 1` only.

If `toStableE (lastBoundaryBlock 1 (inl c) * lastBoundaryBlock 1 (inr r)) = 1`,
then the product lies in `torusCocycleSubgroup`. No claim about arbitrary
`Sum` pairs, row-then-column order, `finiteStage 2`, or global normal forms.
Uses `toStableE_lastBoundaryBlock_one_mul_one_eq_one_imp` to force `c = 1`,
`r = 1`, then public block/product hom APIs to reduce to `1`. -/
theorem ker_toStableE_lastBoundaryBlock_col_row_pair_mem_torusCocycleSubgroup
    (c r : Fin 1 → Multiplicative F)
    (h : toStableE (R := F)
      (lastBoundaryBlock 1 (Sum.inl c) * lastBoundaryBlock 1 (Sum.inr r)) = 1) :
    lastBoundaryBlock (R := F) 1 (Sum.inl c) * lastBoundaryBlock 1 (Sum.inr r) ∈
      torusCocycleSubgroup := by
  have hcr := toStableE_lastBoundaryBlock_one_mul_one_eq_one_imp (F := F) c r h
  obtain ⟨hc1, hr1⟩ := hcr
  rw [lastBoundaryBlock_inl, lastBoundaryBlock_inr, hc1, hr1,
    map_one (lastColumnProduct (R := F) 1), map_one (lastRowProduct (R := F) 1),
    mul_one]
  exact (torusCocycleSubgroup (F := F)).one_mem

/-- Row-then-column pair kernel membership for `Fin 1` only.

If `toStableE (lastBoundaryBlock 1 (inr r) * lastBoundaryBlock 1 (inl c)) = 1`,
then the product lies in `torusCocycleSubgroup`. No claim about arbitrary
`Sum` pairs, arbitrary `finiteStage 2` normalization, or the rank-two kernel
base. Uses `toStableE_lastBoundaryBlock_inr_mul_inl_eq_one_imp` to force
`r = 1`, `c = 1`, then public block/product hom APIs to reduce to `1`. -/
theorem ker_toStableE_lastBoundaryBlock_row_col_pair_mem_torusCocycleSubgroup
    (r c : Fin 1 → Multiplicative F)
    (h : toStableE (R := F)
      (lastBoundaryBlock 1 (Sum.inr r) * lastBoundaryBlock 1 (Sum.inl c)) = 1) :
    lastBoundaryBlock (R := F) 1 (Sum.inr r) * lastBoundaryBlock 1 (Sum.inl c) ∈
      torusCocycleSubgroup := by
  have hrc := toStableE_lastBoundaryBlock_inr_mul_inl_eq_one_imp (F := F) r c h
  obtain ⟨hr1, hc1⟩ := hrc
  rw [lastBoundaryBlock_inr, lastBoundaryBlock_inl, hr1, hc1,
    map_one (lastRowProduct (R := F) 1), map_one (lastColumnProduct (R := F) 1),
    mul_one]
  exact (torusCocycleSubgroup (F := F)).one_mem

private theorem fin1_eq_mulSingle_local (c : Fin 1 → Multiplicative F) :
    c = Pi.mulSingle (0 : Fin 1) (c 0) := by
  ext j; have hj : j = (0 : Fin 1) := Subsingleton.elim _ _; subst hj; simp

private theorem nat01_fin2_eq (a : F) :
    StableE.natElementary (R := F) 0 1 (by decide) a =
      StableE.elementary (R := F) 2 (0 : Fin 2) 1 (by decide) a := by
  calc StableE.natElementary (R := F) 0 1 (by decide) a
      = StableE.natElementary (R := F) 0 1
          (fun hh : (0 : ℕ) = 1 =>
            (show (0 : Fin 2) ≠ 1 by decide)
              (Fin.eq_of_val_eq hh)) a := by
        exact congrArg
          (fun hij => StableE.natElementary (R := F) 0 1 hij a)
          (Subsingleton.elim _ _)
    _ = StableE.elementary (R := F) 2 (0 : Fin 2) 1 (by decide) a :=
        StableE.natElementary_fin (R := F) (n := 2) (i := (0 : Fin 2))
          (j := (1 : Fin 2)) (by decide) a

private theorem nat10_fin2_eq (a : F) :
    StableE.natElementary (R := F) 1 0 (by decide) a =
      StableE.elementary (R := F) 2 (1 : Fin 2) 0 (by decide) a := by
  calc StableE.natElementary (R := F) 1 0 (by decide) a
      = StableE.natElementary (R := F) 1 0
          (fun hh : (1 : ℕ) = 0 =>
            (show (1 : Fin 2) ≠ 0 by decide)
              (Fin.eq_of_val_eq hh)) a := by
        exact congrArg
          (fun hij => StableE.natElementary (R := F) 1 0 hij a)
          (Subsingleton.elim _ _)
    _ = StableE.elementary (R := F) 2 (1 : Fin 2) 0 (by decide) a :=
        StableE.natElementary_fin (R := F) (n := 2) (i := (1 : Fin 2))
          (j := (0 : Fin 2)) (by decide) a

/-- Column-row-column length-three kernel for `Fin 1`.

If `toStableE (inl c1 * inr r * inl c2)=1` then triple ∈ `torusCocycleSubgroup`.
Matrix: `E01(a1) E10(b) E01(a2)=[[1+a1b,a1+a2+a1 b a2],[b,1+b a2]]=1`
forces `b=0` via `(1,0)` and `a1+a2=0` via `(0,1)`; word reduces via `x_add`/`x_zero`. -/
theorem ker_toStableE_lastBoundaryBlock_col_row_col_triple_mem_torusCocycleSubgroup
    (c1 c2 r : Fin 1 → Multiplicative F)
    (h : toStableE (R := F)
      (lastBoundaryBlock 1 (Sum.inl c1) * lastBoundaryBlock 1 (Sum.inr r) *
        lastBoundaryBlock 1 (Sum.inl c2)) = 1) :
    lastBoundaryBlock (R := F) 1 (Sum.inl c1) * lastBoundaryBlock 1 (Sum.inr r) *
      lastBoundaryBlock 1 (Sum.inl c2) ∈ torusCocycleSubgroup := by
  have h_inl1 := toStableE_lastBoundaryBlock_inl_one (R := F) c1
  have h_inr := toStableE_lastBoundaryBlock_inr_one (R := F) r
  have h_inl2 := toStableE_lastBoundaryBlock_inl_one (R := F) c2
  have h_map : toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c1)) *
      toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r)) *
      toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c2)) = 1 := by
    calc toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c1)) *
        toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r)) *
        toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c2))
        = toStableE (R := F)
            (lastBoundaryBlock 1 (Sum.inl c1) *
              lastBoundaryBlock 1 (Sum.inr r)) *
          toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c2)) := by
          rw [← map_mul]
      _ = toStableE (R := F)
          (lastBoundaryBlock 1 (Sum.inl c1) *
            lastBoundaryBlock 1 (Sum.inr r) *
            lastBoundaryBlock 1 (Sum.inl c2)) := by
          rw [← map_mul]
      _ = 1 := h
  rw [h_inl1, h_inr, h_inl2] at h_map
  set a1 := (c1 0).toAdd; set b := (r 0).toAdd; set a2 := (c2 0).toAdd
  have h_prod : StableE.natElementary (R := F) 0 1 (by decide) a1 *
      StableE.natElementary (R := F) 1 0 (by decide) b *
      StableE.natElementary (R := F) 0 1 (by decide) a2 = 1 := h_map
  rw [nat01_fin2_eq (F := F) a1, nat10_fin2_eq (F := F) b,
    nat01_fin2_eq (F := F) a2] at h_prod
  have h_from : StableE.fromFinite (R := F) 2
      (Matrix.GeneralLinearGroup.ElementarySubgroup.elementary
        (0 : Fin 2) 1 (by decide) a1 *
      Matrix.GeneralLinearGroup.ElementarySubgroup.elementary
        (1 : Fin 2) 0 (by decide) b *
      Matrix.GeneralLinearGroup.ElementarySubgroup.elementary
        (0 : Fin 2) 1 (by decide) a2) = 1 := by
    simp only [map_mul, StableE.fromFinite_elementary]; exact h_prod
  have h_from_eq := h_from.trans (map_one (StableE.fromFinite (R := F) 2)).symm
  have h_gl : Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a1 *
      Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b *
      Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a2 =
      (1 : Matrix.GeneralLinearGroup (Fin 2) F) := by
    simpa using congrArg Subtype.val
      (StableE.fromFinite_injective (R := F) (n := 2) h_from_eq)
  have h_b_zero : b = 0 := by
    have : (Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a1 *
        Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b *
        Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a2 :
        Matrix.GeneralLinearGroup (Fin 2) F).val 1 0 = 0 := by rw [h_gl]; simp
    simpa [Matrix.GeneralLinearGroup.coe_elementary, Matrix.single,
      Matrix.one_apply, Matrix.mul_apply, Fin.sum_univ_two] using this
  have h_a_sum : a1 + a2 = 0 := by
    have : (Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a1 *
        Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b *
        Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a2 :
        Matrix.GeneralLinearGroup (Fin 2) F).val 0 1 = 0 := by rw [h_gl]; simp
    simpa [Matrix.GeneralLinearGroup.coe_elementary, Matrix.single,
      Matrix.one_apply, Matrix.mul_apply, Fin.sum_univ_two, h_b_zero] using this
  have h_c1_x : lastBoundaryBlock (R := F) 1 (Sum.inl c1) =
      x (R := F) 0 1 (by decide) a1 := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inl c1)
        = lastColumnProduct (R := F) 1 c1 := by rw [lastBoundaryBlock_inl]
      _ = lastColumnProduct (R := F) 1
          (Pi.mulSingle (0 : Fin 1) (c1 0)) := by
          rw [← fin1_eq_mulSingle_local (F := F) c1]
      _ = x (R := F) 0 1 (Nat.ne_of_lt (by decide : 0 < 1)) a1 := by
          convert lastColumnProduct_mulSingle (R := F) 1 (0 : Fin 1) (c1 0) using 1
          simp [a1]
      _ = x (R := F) 0 1 (by decide) a1 := by
          have : (Nat.ne_of_lt (by decide : 0 < 1) : 0 ≠ 1) =
              (by decide : 0 ≠ 1) := Subsingleton.elim _ _
          rw [this]
  have h_r_x : lastBoundaryBlock (R := F) 1 (Sum.inr r) =
      x (R := F) 1 0 (by decide) b := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inr r)
        = lastRowProduct (R := F) 1 r := by rw [lastBoundaryBlock_inr]
      _ = lastRowProduct (R := F) 1 (Pi.mulSingle (0 : Fin 1) (r 0)) := by
          rw [← fin1_eq_mulSingle_local (F := F) r]
      _ = x (R := F) 1 0
          (Ne.symm (Nat.ne_of_lt (by decide : 0 < 1))) b := by
          convert lastRowProduct_mulSingle (R := F) 1 (0 : Fin 1) (r 0) using 1
          simp [b]
      _ = x (R := F) 1 0 (by decide) b := by
          have : (Ne.symm (Nat.ne_of_lt (by decide : 0 < 1)) : 1 ≠ 0) =
              (by decide : 1 ≠ 0) := Subsingleton.elim _ _
          rw [this]
  have h_c2_x : lastBoundaryBlock (R := F) 1 (Sum.inl c2) =
      x (R := F) 0 1 (by decide) a2 := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inl c2)
        = lastColumnProduct (R := F) 1 c2 := by rw [lastBoundaryBlock_inl]
      _ = lastColumnProduct (R := F) 1
          (Pi.mulSingle (0 : Fin 1) (c2 0)) := by
          rw [← fin1_eq_mulSingle_local (F := F) c2]
      _ = x (R := F) 0 1 (Nat.ne_of_lt (by decide : 0 < 1)) a2 := by
          convert lastColumnProduct_mulSingle (R := F) 1 (0 : Fin 1) (c2 0) using 1
          simp [a2]
      _ = x (R := F) 0 1 (by decide) a2 := by
          have : (Nat.ne_of_lt (by decide : 0 < 1) : 0 ≠ 1) =
              (by decide : 0 ≠ 1) := Subsingleton.elim _ _
          rw [this]
  have h_word : lastBoundaryBlock (R := F) 1 (Sum.inl c1) *
      lastBoundaryBlock 1 (Sum.inr r) * lastBoundaryBlock 1 (Sum.inl c2) =
      x (R := F) 0 1 (by decide) a1 * x (R := F) 1 0 (by decide) b *
        x (R := F) 0 1 (by decide) a2 := by rw [h_c1_x, h_r_x, h_c2_x]
  have h_eq_one : lastBoundaryBlock (R := F) 1 (Sum.inl c1) *
      lastBoundaryBlock 1 (Sum.inr r) * lastBoundaryBlock 1 (Sum.inl c2) = 1 := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inl c1) *
        lastBoundaryBlock 1 (Sum.inr r) * lastBoundaryBlock 1 (Sum.inl c2)
        = x (R := F) 0 1 (by decide) a1 * x (R := F) 1 0 (by decide) b *
            x (R := F) 0 1 (by decide) a2 := h_word
      _ = x (R := F) 0 1 (by decide) a1 * x (R := F) 1 0 (by decide) 0 *
            x (R := F) 0 1 (by decide) a2 := by rw [h_b_zero]
      _ = x (R := F) 0 1 (by decide) a1 * 1 *
            x (R := F) 0 1 (by decide) a2 := by rw [x_zero]
      _ = x (R := F) 0 1 (by decide) a1 *
            x (R := F) 0 1 (by decide) a2 := by rw [mul_one]
      _ = x (R := F) 0 1 (by decide) (a1 + a2) := by
          rw [x_add (R := F) 0 1 (by decide) a1 a2]
      _ = x (R := F) 0 1 (by decide) (0 : F) := by rw [h_a_sum]
      _ = 1 := by rw [x_zero]
  rw [h_eq_one]; exact (torusCocycleSubgroup (F := F)).one_mem

/-- Row-column-row length-three kernel for `Fin 1`.

If `toStableE (inr r1 * inl c * inr r2)=1` then triple ∈ `torusCocycleSubgroup`.
Matrix: `E10(b1) E01(a) E10(b2)=[[1+a b2,a],[b1+b2+b1 a b2,1+b1 a]]=1`
forces `a=0` via `(0,1)` and `b1+b2=0` via `(1,0)`; word reduces via `x_add`/`x_zero`. -/
theorem ker_toStableE_lastBoundaryBlock_row_col_row_triple_mem_torusCocycleSubgroup
    (r1 r2 c : Fin 1 → Multiplicative F)
    (h : toStableE (R := F)
      (lastBoundaryBlock 1 (Sum.inr r1) * lastBoundaryBlock 1 (Sum.inl c) *
        lastBoundaryBlock 1 (Sum.inr r2)) = 1) :
    lastBoundaryBlock (R := F) 1 (Sum.inr r1) * lastBoundaryBlock 1 (Sum.inl c) *
      lastBoundaryBlock 1 (Sum.inr r2) ∈ torusCocycleSubgroup := by
  have h_inr1 := toStableE_lastBoundaryBlock_inr_one (R := F) r1
  have h_inl := toStableE_lastBoundaryBlock_inl_one (R := F) c
  have h_inr2 := toStableE_lastBoundaryBlock_inr_one (R := F) r2
  have h_map : toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r1)) *
      toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c)) *
      toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r2)) = 1 := by
    calc toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r1)) *
        toStableE (R := F) (lastBoundaryBlock 1 (Sum.inl c)) *
        toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r2))
        = toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r1) *
            lastBoundaryBlock 1 (Sum.inl c)) *
          toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r2)) := by rw [← map_mul]
      _ = toStableE (R := F) (lastBoundaryBlock 1 (Sum.inr r1) *
            lastBoundaryBlock 1 (Sum.inl c) *
            lastBoundaryBlock 1 (Sum.inr r2)) := by rw [← map_mul]
      _ = 1 := h
  rw [h_inr1, h_inl, h_inr2] at h_map
  set b1 := (r1 0).toAdd; set a := (c 0).toAdd; set b2 := (r2 0).toAdd
  have h_prod : StableE.natElementary (R := F) 1 0 (by decide) b1 *
      StableE.natElementary (R := F) 0 1 (by decide) a *
      StableE.natElementary (R := F) 1 0 (by decide) b2 = 1 := h_map
  rw [nat10_fin2_eq (F := F) b1, nat01_fin2_eq (F := F) a,
    nat10_fin2_eq (F := F) b2] at h_prod
  have h_from : StableE.fromFinite (R := F) 2
      (Matrix.GeneralLinearGroup.ElementarySubgroup.elementary
        (1 : Fin 2) 0 (by decide) b1 *
      Matrix.GeneralLinearGroup.ElementarySubgroup.elementary
        (0 : Fin 2) 1 (by decide) a *
      Matrix.GeneralLinearGroup.ElementarySubgroup.elementary
        (1 : Fin 2) 0 (by decide) b2) = 1 := by
    simp only [map_mul, StableE.fromFinite_elementary]; exact h_prod
  have h_from_eq := h_from.trans (map_one (StableE.fromFinite (R := F) 2)).symm
  have h_gl : Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b1 *
      Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a *
      Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b2 =
      (1 : Matrix.GeneralLinearGroup (Fin 2) F) := by
    simpa using congrArg Subtype.val
      (StableE.fromFinite_injective (R := F) (n := 2) h_from_eq)
  have h_a_zero : a = 0 := by
    have : (Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b1 *
        Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a *
        Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b2 :
        Matrix.GeneralLinearGroup (Fin 2) F).val 0 1 = 0 := by rw [h_gl]; simp
    simpa [Matrix.GeneralLinearGroup.coe_elementary, Matrix.single,
      Matrix.one_apply, Matrix.mul_apply, Fin.sum_univ_two] using this
  have h_b_sum : b1 + b2 = 0 := by
    have : (Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b1 *
        Matrix.GeneralLinearGroup.elementary (0 : Fin 2) 1 (by decide) a *
        Matrix.GeneralLinearGroup.elementary (1 : Fin 2) 0 (by decide) b2 :
        Matrix.GeneralLinearGroup (Fin 2) F).val 1 0 = 0 := by rw [h_gl]; simp
    simpa [Matrix.GeneralLinearGroup.coe_elementary, Matrix.single,
      Matrix.one_apply, Matrix.mul_apply, Fin.sum_univ_two, h_a_zero] using this
  have h_r1_x : lastBoundaryBlock (R := F) 1 (Sum.inr r1) =
      x (R := F) 1 0 (by decide) b1 := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inr r1)
        = lastRowProduct (R := F) 1 r1 := by rw [lastBoundaryBlock_inr]
      _ = lastRowProduct (R := F) 1 (Pi.mulSingle (0 : Fin 1) (r1 0)) := by
          rw [← fin1_eq_mulSingle_local (F := F) r1]
      _ = x (R := F) 1 0
          (Ne.symm (Nat.ne_of_lt (by decide : 0 < 1))) b1 := by
          convert lastRowProduct_mulSingle (R := F) 1 (0 : Fin 1) (r1 0) using 1
          simp [b1]
      _ = x (R := F) 1 0 (by decide) b1 := by
          have : (Ne.symm (Nat.ne_of_lt (by decide : 0 < 1)) : 1 ≠ 0) =
              (by decide : 1 ≠ 0) := Subsingleton.elim _ _
          rw [this]
  have h_c_x : lastBoundaryBlock (R := F) 1 (Sum.inl c) =
      x (R := F) 0 1 (by decide) a := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inl c)
        = lastColumnProduct (R := F) 1 c := by rw [lastBoundaryBlock_inl]
      _ = lastColumnProduct (R := F) 1
          (Pi.mulSingle (0 : Fin 1) (c 0)) := by
          rw [← fin1_eq_mulSingle_local (F := F) c]
      _ = x (R := F) 0 1 (Nat.ne_of_lt (by decide : 0 < 1)) a := by
          convert lastColumnProduct_mulSingle (R := F) 1 (0 : Fin 1) (c 0) using 1
          simp [a]
      _ = x (R := F) 0 1 (by decide) a := by
          have : (Nat.ne_of_lt (by decide : 0 < 1) : 0 ≠ 1) =
              (by decide : 0 ≠ 1) := Subsingleton.elim _ _
          rw [this]
  have h_r2_x : lastBoundaryBlock (R := F) 1 (Sum.inr r2) =
      x (R := F) 1 0 (by decide) b2 := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inr r2)
        = lastRowProduct (R := F) 1 r2 := by rw [lastBoundaryBlock_inr]
      _ = lastRowProduct (R := F) 1 (Pi.mulSingle (0 : Fin 1) (r2 0)) := by
          rw [← fin1_eq_mulSingle_local (F := F) r2]
      _ = x (R := F) 1 0
          (Ne.symm (Nat.ne_of_lt (by decide : 0 < 1))) b2 := by
          convert lastRowProduct_mulSingle (R := F) 1 (0 : Fin 1) (r2 0) using 1
          simp [b2]
      _ = x (R := F) 1 0 (by decide) b2 := by
          have : (Ne.symm (Nat.ne_of_lt (by decide : 0 < 1)) : 1 ≠ 0) =
              (by decide : 1 ≠ 0) := Subsingleton.elim _ _
          rw [this]
  have h_word : lastBoundaryBlock (R := F) 1 (Sum.inr r1) *
      lastBoundaryBlock 1 (Sum.inl c) * lastBoundaryBlock 1 (Sum.inr r2) =
      x (R := F) 1 0 (by decide) b1 * x (R := F) 0 1 (by decide) a *
        x (R := F) 1 0 (by decide) b2 := by rw [h_r1_x, h_c_x, h_r2_x]
  have h_eq_one : lastBoundaryBlock (R := F) 1 (Sum.inr r1) *
      lastBoundaryBlock 1 (Sum.inl c) * lastBoundaryBlock 1 (Sum.inr r2) = 1 := by
    calc lastBoundaryBlock (R := F) 1 (Sum.inr r1) *
        lastBoundaryBlock 1 (Sum.inl c) * lastBoundaryBlock 1 (Sum.inr r2)
        = x (R := F) 1 0 (by decide) b1 * x (R := F) 0 1 (by decide) a *
            x (R := F) 1 0 (by decide) b2 := h_word
      _ = x (R := F) 1 0 (by decide) b1 * x (R := F) 0 1 (by decide) 0 *
            x (R := F) 1 0 (by decide) b2 := by rw [h_a_zero]
      _ = x (R := F) 1 0 (by decide) b1 * 1 *
            x (R := F) 1 0 (by decide) b2 := by rw [x_zero]
      _ = x (R := F) 1 0 (by decide) b1 * x (R := F) 1 0 (by decide) b2 := by rw [mul_one]
      _ = x (R := F) 1 0 (by decide) (b1 + b2) := by
          rw [x_add (R := F) 1 0 (by decide) b1 b2]
      _ = x (R := F) 1 0 (by decide) (0 : F) := by rw [h_b_sum]
      _ = 1 := by rw [x_zero]
  rw [h_eq_one]; exact (torusCocycleSubgroup (F := F)).one_mem

/-- Same-side collapse `inl`/`inl` for arbitrary `n`.

Two consecutive `lastBoundaryBlock n (inl _)` factors on the same side collapse to a single
block with pointwise product coefficients. Uses `lastBoundaryBlock_inl` and
`lastColumnProduct` monoid-homomorphism `map_mul`. -/
theorem lastBoundaryBlock_inl_mul_inl {R : Type u} [Ring R] (n : ℕ)
    (c₁ c₂ : Fin n → Multiplicative R) :
    lastBoundaryBlock n (Sum.inl c₁) * lastBoundaryBlock n (Sum.inl c₂) =
      lastBoundaryBlock n (Sum.inl (c₁ * c₂)) := by
  rw [lastBoundaryBlock_inl, lastBoundaryBlock_inl, lastBoundaryBlock_inl, ← map_mul]

/-- Same-side collapse `inr`/`inr` for arbitrary `n`.

Two consecutive `lastBoundaryBlock n (inr _)` factors on the same side collapse to a single
block with pointwise product coefficients. Uses `lastBoundaryBlock_inr` and
`lastRowProduct` monoid-homomorphism `map_mul`. -/
theorem lastBoundaryBlock_inr_mul_inr {R : Type u} [Ring R] (n : ℕ)
    (r₁ r₂ : Fin n → Multiplicative R) :
    lastBoundaryBlock n (Sum.inr r₁) * lastBoundaryBlock n (Sum.inr r₂) =
      lastBoundaryBlock n (Sum.inr (r₁ * r₂)) := by
  rw [lastBoundaryBlock_inr, lastBoundaryBlock_inr, lastBoundaryBlock_inr, ← map_mul]

/-- Coefficient-one `inl` boundary block equals `1`. Tiny reusable helper. -/
theorem lastBoundaryBlock_inl_one {R : Type u} [Ring R] (n : ℕ) :
    lastBoundaryBlock n (Sum.inl (1 : Fin n → Multiplicative R)) = 1 := by
  rw [lastBoundaryBlock_inl, map_one]

/-- Coefficient-one `inr` boundary block equals `1`. Tiny reusable helper. -/
theorem lastBoundaryBlock_inr_one {R : Type u} [Ring R] (n : ℕ) :
    lastBoundaryBlock n (Sum.inr (1 : Fin n → Multiplicative R)) = 1 := by
  rw [lastBoundaryBlock_inr, map_one]

/-- `Fin 1` specialization: `inl` followed by `inl` collapses with pointwise product. -/
theorem lastBoundaryBlock_one_inl_mul_inl (c₁ c₂ : Fin 1 → Multiplicative F) :
    lastBoundaryBlock (R := F) 1 (Sum.inl c₁) * lastBoundaryBlock 1 (Sum.inl c₂) =
      lastBoundaryBlock 1 (Sum.inl (c₁ * c₂)) :=
  lastBoundaryBlock_inl_mul_inl 1 c₁ c₂

/-- `Fin 1` specialization: `inr` followed by `inr` collapses with pointwise product. -/
theorem lastBoundaryBlock_one_inr_mul_inr (r₁ r₂ : Fin 1 → Multiplicative F) :
    lastBoundaryBlock (R := F) 1 (Sum.inr r₁) * lastBoundaryBlock 1 (Sum.inr r₂) =
      lastBoundaryBlock 1 (Sum.inr (r₁ * r₂)) :=
  lastBoundaryBlock_inr_mul_inr 1 r₁ r₂

/-- `Fin 1` coefficient-one `inl` block equals `1`. -/
theorem lastBoundaryBlock_one_inl_one :
    lastBoundaryBlock (R := F) 1 (Sum.inl (1 : Fin 1 → Multiplicative F)) = 1 :=
  lastBoundaryBlock_inl_one 1

/-- `Fin 1` coefficient-one `inr` block equals `1`. -/
theorem lastBoundaryBlock_one_inr_one :
    lastBoundaryBlock (R := F) 1 (Sum.inr (1 : Fin 1 → Multiplicative F)) = 1 :=
  lastBoundaryBlock_inr_one 1

/-! ## Alternating normal form via same-side merging (adjacent Chain)

Every `g ∈ finiteStage (n+1)` has a word `L` of `lastBoundaryBlock n`
blocks whose adjacent sides alternate, i.e. `L` satisfies
`List.IsChain BoundaryBlocksAlternate`. Normalization repeatedly merges
only adjacent same-side blocks `inl c1 * inl c2 → inl (c1*c2)` and
`inr r1 * inr r2 → inr (r1*r2)` via `lastBoundaryBlock_inl_mul_inl` and
`lastBoundaryBlock_inr_mul_inr`, preserving exact product order.
Termination measure: `L.length` strictly decreases:
`|b1::b2::rest| = 2+|rest| → |merged::rest| = 1+|rest|`
or `|b2::rest| = 1+|rest|` for opposite-side step. No equal-index
factorization is used. The public existence theorem does not claim
`List.Pairwise`, length ≤ 2, arbitrary zero-forcing, or full kernel
generation; it states only the sound adjacent-alternating `Chain` property.
-/

private def blockSide {R : Type u} {n : ℕ}
    (b : Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)) : Bool :=
  match b with
  | Sum.inl _ => true
  | Sum.inr _ => false

/-- Two adjacent boundary blocks alternate sides: an `inl` (column) block followed by
an `inr` (row) block, or vice versa. This predicate is the public interface for the
alternating last-boundary-block normal form; it does not claim equal-index,
kernel, or cocycle properties. -/
public def BoundaryBlocksAlternate {R : Type u} {n : ℕ}
    (a b : Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)) : Prop :=
  match a, b with
  | Sum.inl _, Sum.inr _ => True
  | Sum.inr _, Sum.inl _ => True
  | _, _ => False

/-- Merges adjacent same-side boundary blocks, preserves order and product via
companion lemmas `normalizeBoundaryBlocks_preserves_prod` and
`normalizeBoundaryBlocks_chain`, and makes no claim of minimality or idempotence. -/
public def normalizeBoundaryBlocks {R : Type u} [Ring R] (n : ℕ) :
    List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)) →
    List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))
  | [] => []
  | [b] => [b]
  | b1 :: b2 :: rest =>
    match b1, b2 with
    | Sum.inl c1, Sum.inl c2 =>
      normalizeBoundaryBlocks n (Sum.inl (c1 * c2) :: rest)
    | Sum.inr r1, Sum.inr r2 =>
      normalizeBoundaryBlocks n (Sum.inr (r1 * r2) :: rest)
    | _, _ =>
      b1 :: normalizeBoundaryBlocks n (b2 :: rest)
termination_by L => L.length
decreasing_by
  all_goals simp only [List.length]
  all_goals exact Nat.lt_succ_self _

private theorem normalizeBoundaryBlocks_ne_nil_of_ne_nil {R : Type u} [Ring R]
    (n : ℕ) :
    ∀ (L : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))),
      L ≠ [] → normalizeBoundaryBlocks n L ≠ []
  | [], h => by contradiction
  | [b], _ => by
    simp only [normalizeBoundaryBlocks]
    exact List.cons_ne_nil b []
  | Sum.inl c1 :: Sum.inl c2 :: rest, _ => by
    have ih := normalizeBoundaryBlocks_ne_nil_of_ne_nil n
      (Sum.inl (c1 * c2) :: rest) (by simp)
    simp only [normalizeBoundaryBlocks] at *
    exact ih
  | Sum.inr r1 :: Sum.inr r2 :: rest, _ => by
    have ih := normalizeBoundaryBlocks_ne_nil_of_ne_nil n
      (Sum.inr (r1 * r2) :: rest) (by simp)
    simp only [normalizeBoundaryBlocks] at *
    exact ih
  | Sum.inl _ :: Sum.inr _ :: rest, _ => by
    simp only [normalizeBoundaryBlocks]
    exact List.cons_ne_nil _ _
  | Sum.inr _ :: Sum.inl _ :: rest, _ => by
    simp only [normalizeBoundaryBlocks]
    exact List.cons_ne_nil _ _
termination_by L => L.length
decreasing_by
  all_goals simp only [List.length]
  all_goals exact Nat.lt_succ_self _

private theorem normalizeBoundaryBlocks_cons_head_side {R : Type u} [Ring R]
    (n : ℕ) :
    ∀ (b : Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))
      (rest : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)))
      (hd : Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))
      (tl : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))),
      normalizeBoundaryBlocks n (b :: rest) = hd :: tl →
      blockSide (R := R) hd = blockSide (R := R) b
  | _, [], hd, tl, h_eq => by
    simp only [normalizeBoundaryBlocks] at h_eq
    cases h_eq
    rfl
  | Sum.inl c1, Sum.inl c2 :: rest, hd, tl, h_eq => by
    simp only [normalizeBoundaryBlocks] at h_eq
    have ih := normalizeBoundaryBlocks_cons_head_side n
      (Sum.inl (c1 * c2)) rest hd tl h_eq
    -- side of merged inl equals side of original inl
    rw [ih]
    rfl
  | Sum.inr r1, Sum.inr r2 :: rest, hd, tl, h_eq => by
    simp only [normalizeBoundaryBlocks] at h_eq
    have ih := normalizeBoundaryBlocks_cons_head_side n
      (Sum.inr (r1 * r2)) rest hd tl h_eq
    rw [ih]
    rfl
  | Sum.inl _c1, Sum.inr _r2 :: _rest, hd, tl, h_eq => by
    simp only [normalizeBoundaryBlocks] at h_eq
    cases h_eq
    rfl
  | Sum.inr _r1, Sum.inl _c2 :: _rest, hd, tl, h_eq => by
    simp only [normalizeBoundaryBlocks] at h_eq
    cases h_eq
    rfl
termination_by b rest _ _ => (b :: rest).length
decreasing_by
  all_goals simp only [List.length]
  all_goals exact Nat.lt_succ_self _

/-- Normalization preserves the represented product. -/
public theorem normalizeBoundaryBlocks_preserves_prod {R : Type u} [Ring R]
    (n : ℕ) :
    ∀ (L : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))),
      (L.map (lastBoundaryBlock (R := R) n)).prod =
      ((normalizeBoundaryBlocks n L).map (lastBoundaryBlock n)).prod
  | [] => by
    simp only [normalizeBoundaryBlocks]
  | [b] => by
    simp only [normalizeBoundaryBlocks]
  | Sum.inl c1 :: Sum.inl c2 :: rest => by
    calc ((Sum.inl c1 :: Sum.inl c2 :: rest).map (lastBoundaryBlock (R := R) n)).prod
        = lastBoundaryBlock n (Sum.inl c1) *
          ((Sum.inl c2 :: rest).map (lastBoundaryBlock n)).prod := by
          simp
      _ = lastBoundaryBlock n (Sum.inl c1) * (lastBoundaryBlock n (Sum.inl c2) *
          (rest.map (lastBoundaryBlock n)).prod) := by
          simp only [List.map_cons, List.prod_cons]
      _ = lastBoundaryBlock n (Sum.inl c1) * lastBoundaryBlock n (Sum.inl c2) *
          (rest.map (lastBoundaryBlock n)).prod := by
          rw [mul_assoc]
      _ = lastBoundaryBlock n (Sum.inl (c1 * c2)) *
          (rest.map (lastBoundaryBlock n)).prod := by
          rw [lastBoundaryBlock_inl_mul_inl]
      _ = ((Sum.inl (c1 * c2) :: rest).map (lastBoundaryBlock n)).prod := by simp
      _ = ((normalizeBoundaryBlocks n (Sum.inl (c1 * c2) :: rest)).map
            (lastBoundaryBlock n)).prod := by
        rw [normalizeBoundaryBlocks_preserves_prod]
      _ = ((normalizeBoundaryBlocks n (Sum.inl c1 :: Sum.inl c2 :: rest)).map
            (lastBoundaryBlock n)).prod := by
        simp only [normalizeBoundaryBlocks]
  | Sum.inr r1 :: Sum.inr r2 :: rest => by
    calc ((Sum.inr r1 :: Sum.inr r2 :: rest).map (lastBoundaryBlock (R := R) n)).prod
        = lastBoundaryBlock n (Sum.inr r1) *
          ((Sum.inr r2 :: rest).map (lastBoundaryBlock n)).prod := by
          simp
      _ = lastBoundaryBlock n (Sum.inr r1) * (lastBoundaryBlock n (Sum.inr r2) *
          (rest.map (lastBoundaryBlock n)).prod) := by
          simp only [List.map_cons, List.prod_cons]
      _ = lastBoundaryBlock n (Sum.inr r1) * lastBoundaryBlock n (Sum.inr r2) *
          (rest.map (lastBoundaryBlock n)).prod := by
          rw [mul_assoc]
      _ = lastBoundaryBlock n (Sum.inr (r1 * r2)) *
          (rest.map (lastBoundaryBlock n)).prod := by
          rw [lastBoundaryBlock_inr_mul_inr]
      _ = ((Sum.inr (r1 * r2) :: rest).map (lastBoundaryBlock n)).prod := by simp
      _ = ((normalizeBoundaryBlocks n (Sum.inr (r1 * r2) :: rest)).map
            (lastBoundaryBlock n)).prod := by
        rw [normalizeBoundaryBlocks_preserves_prod]
      _ = ((normalizeBoundaryBlocks n (Sum.inr r1 :: Sum.inr r2 :: rest)).map
            (lastBoundaryBlock n)).prod := by
        simp only [normalizeBoundaryBlocks]
  | Sum.inl c1 :: Sum.inr r2 :: rest => by
    calc ((Sum.inl c1 :: Sum.inr r2 :: rest).map (lastBoundaryBlock (R := R) n)).prod
        = lastBoundaryBlock n (Sum.inl c1) *
          ((Sum.inr r2 :: rest).map (lastBoundaryBlock n)).prod := by simp
      _ = lastBoundaryBlock n (Sum.inl c1) *
          ((normalizeBoundaryBlocks n (Sum.inr r2 :: rest)).map
            (lastBoundaryBlock n)).prod := by
        rw [normalizeBoundaryBlocks_preserves_prod]
      _ = ((Sum.inl c1 :: normalizeBoundaryBlocks n (Sum.inr r2 :: rest)).map
            (lastBoundaryBlock n)).prod := by simp
      _ = ((normalizeBoundaryBlocks n (Sum.inl c1 :: Sum.inr r2 :: rest)).map
            (lastBoundaryBlock n)).prod := by
        simp only [normalizeBoundaryBlocks]
  | Sum.inr r1 :: Sum.inl c2 :: rest => by
    calc ((Sum.inr r1 :: Sum.inl c2 :: rest).map (lastBoundaryBlock (R := R) n)).prod
        = lastBoundaryBlock n (Sum.inr r1) *
          ((Sum.inl c2 :: rest).map (lastBoundaryBlock n)).prod := by simp
      _ = lastBoundaryBlock n (Sum.inr r1) *
          ((normalizeBoundaryBlocks n (Sum.inl c2 :: rest)).map
            (lastBoundaryBlock n)).prod := by
        rw [normalizeBoundaryBlocks_preserves_prod]
      _ = ((Sum.inr r1 :: normalizeBoundaryBlocks n (Sum.inl c2 :: rest)).map
            (lastBoundaryBlock n)).prod := by simp
      _ = ((normalizeBoundaryBlocks n (Sum.inr r1 :: Sum.inl c2 :: rest)).map
            (lastBoundaryBlock n)).prod := by
        simp only [normalizeBoundaryBlocks]
termination_by L => L.length
decreasing_by
  all_goals simp only [List.length]
  all_goals exact Nat.lt_succ_self _

/-- Normalization produces an alternating chain. -/
public theorem normalizeBoundaryBlocks_chain {R : Type u} [Ring R]
    (n : ℕ) :
    ∀ (L : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))),
      List.IsChain (BoundaryBlocksAlternate (n := n)) (normalizeBoundaryBlocks n L)
  | [] => by
    simp only [normalizeBoundaryBlocks]
    exact List.IsChain.nil
  | [b] => by
    simp only [normalizeBoundaryBlocks]
    exact List.IsChain.singleton b
  | Sum.inl c1 :: Sum.inl c2 :: rest => by
    have ih := normalizeBoundaryBlocks_chain n (Sum.inl (c1 * c2) :: rest)
    simp only [normalizeBoundaryBlocks]
    exact ih
  | Sum.inr r1 :: Sum.inr r2 :: rest => by
    have ih := normalizeBoundaryBlocks_chain n (Sum.inr (r1 * r2) :: rest)
    simp only [normalizeBoundaryBlocks]
    exact ih
  | Sum.inl c1 :: Sum.inr r2 :: rest => by
    have ih := normalizeBoundaryBlocks_chain n (Sum.inr r2 :: rest)
    simp only [normalizeBoundaryBlocks]
    cases h_norm : normalizeBoundaryBlocks n (Sum.inr r2 :: rest) with
    | nil =>
      have h_ne := normalizeBoundaryBlocks_ne_nil_of_ne_nil n
        (Sum.inr r2 :: rest) (by simp)
      rw [h_norm] at h_ne
      contradiction
    | cons t_head t_tail =>
      have h_side : blockSide (R := R) t_head = blockSide (R := R) (Sum.inr r2) :=
        normalizeBoundaryBlocks_cons_head_side n (Sum.inr r2) rest t_head t_tail h_norm
      have h_alt : BoundaryBlocksAlternate (n := n) (Sum.inl c1) t_head := by
        cases t_head with
        | inl _ =>
          cases h_side
        | inr _ =>
          simp [BoundaryBlocksAlternate]
      have ih' : List.IsChain (BoundaryBlocksAlternate (n := n)) (t_head :: t_tail) := by
        rw [← h_norm]
        exact ih
      exact List.IsChain.cons_cons h_alt ih'
  | Sum.inr r1 :: Sum.inl c2 :: rest => by
    have ih := normalizeBoundaryBlocks_chain n (Sum.inl c2 :: rest)
    simp only [normalizeBoundaryBlocks]
    cases h_norm : normalizeBoundaryBlocks n (Sum.inl c2 :: rest) with
    | nil =>
      have h_ne := normalizeBoundaryBlocks_ne_nil_of_ne_nil n
        (Sum.inl c2 :: rest) (by simp)
      rw [h_norm] at h_ne
      contradiction
    | cons t_head t_tail =>
      have h_side : blockSide (R := R) t_head = blockSide (R := R) (Sum.inl c2) :=
        normalizeBoundaryBlocks_cons_head_side n (Sum.inl c2) rest t_head t_tail h_norm
      have h_alt : BoundaryBlocksAlternate (n := n) (Sum.inr r1) t_head := by
        cases t_head with
        | inr _ =>
          cases h_side
        | inl _ =>
          simp [BoundaryBlocksAlternate]
      have ih' : List.IsChain (BoundaryBlocksAlternate (n := n)) (t_head :: t_tail) := by
        rw [← h_norm]
        exact ih
      exact List.IsChain.cons_cons h_alt ih'
termination_by L => L.length
decreasing_by
  all_goals simp only [List.length]
  all_goals exact Nat.lt_succ_self _

/-- Normalization does not increase length. -/
public theorem length_normalizeBoundaryBlocks_le {R : Type u} [Ring R]
    (n : ℕ) :
    ∀ (L : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))),
      (normalizeBoundaryBlocks (R := R) n L).length ≤ L.length
  | [] => by simp [normalizeBoundaryBlocks]
  | [b] => by simp [normalizeBoundaryBlocks]
  | Sum.inl c1 :: Sum.inl c2 :: rest => by
    simp only [normalizeBoundaryBlocks]
    have ih := length_normalizeBoundaryBlocks_le n (Sum.inl (c1 * c2) :: rest)
    calc (normalizeBoundaryBlocks n (Sum.inl (c1 * c2) :: rest)).length
        ≤ (Sum.inl (c1 * c2) :: rest).length := ih
      _ ≤ (Sum.inl c1 :: Sum.inl c2 :: rest).length := by simp [List.length]
  | Sum.inr r1 :: Sum.inr r2 :: rest => by
    simp only [normalizeBoundaryBlocks]
    have ih := length_normalizeBoundaryBlocks_le n (Sum.inr (r1 * r2) :: rest)
    calc (normalizeBoundaryBlocks n (Sum.inr (r1 * r2) :: rest)).length
        ≤ (Sum.inr (r1 * r2) :: rest).length := ih
      _ ≤ (Sum.inr r1 :: Sum.inr r2 :: rest).length := by simp [List.length]
  | Sum.inl c1 :: Sum.inr r2 :: rest => by
    simp only [normalizeBoundaryBlocks]
    have ih := length_normalizeBoundaryBlocks_le n (Sum.inr r2 :: rest)
    calc (normalizeBoundaryBlocks n (Sum.inr r2 :: rest)).length + 1
        ≤ (Sum.inr r2 :: rest).length + 1 := Nat.succ_le_succ ih
      _ = (Sum.inl c1 :: Sum.inr r2 :: rest).length := by simp [List.length]
  | Sum.inr r1 :: Sum.inl c2 :: rest => by
    simp only [normalizeBoundaryBlocks]
    have ih := length_normalizeBoundaryBlocks_le n (Sum.inl c2 :: rest)
    calc (normalizeBoundaryBlocks n (Sum.inl c2 :: rest)).length + 1
        ≤ (Sum.inl c2 :: rest).length + 1 := Nat.succ_le_succ ih
      _ = (Sum.inr r1 :: Sum.inl c2 :: rest).length := by simp [List.length]
termination_by L => L.length
decreasing_by
  all_goals simp only [List.length]
  all_goals exact Nat.lt_succ_self _

/-- Strict shortening when the head pair is same-side `inl`.
No claim of minimality, idempotence, or `Pairwise` alternation. -/
public theorem length_normalizeBoundaryBlocks_lt_of_adjacent_inl {R : Type u}
    [Ring R] (n : ℕ) (c1 c2 : Fin n → Multiplicative R)
    (rest : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))) :
    (normalizeBoundaryBlocks (R := R) n (Sum.inl c1 :: Sum.inl c2 :: rest)).length <
      (Sum.inl c1 :: Sum.inl c2 :: rest).length := by
  simp only [normalizeBoundaryBlocks]
  have h_le := length_normalizeBoundaryBlocks_le (R := R) n (Sum.inl (c1 * c2) :: rest)
  have h_lt : (Sum.inl (c1 * c2) :: rest).length <
      (Sum.inl c1 :: Sum.inl c2 :: rest).length := by simp [List.length]
  exact Nat.lt_of_le_of_lt h_le h_lt

/-- Strict shortening when the head pair is same-side `inr`.
No claim of minimality, idempotence, or `Pairwise` alternation. -/
public theorem length_normalizeBoundaryBlocks_lt_of_adjacent_inr {R : Type u}
    [Ring R] (n : ℕ) (r1 r2 : Fin n → Multiplicative R)
    (rest : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))) :
    (normalizeBoundaryBlocks (R := R) n (Sum.inr r1 :: Sum.inr r2 :: rest)).length <
      (Sum.inr r1 :: Sum.inr r2 :: rest).length := by
  simp only [normalizeBoundaryBlocks]
  have h_le := length_normalizeBoundaryBlocks_le (R := R) n (Sum.inr (r1 * r2) :: rest)
  have h_lt : (Sum.inr (r1 * r2) :: rest).length <
      (Sum.inr r1 :: Sum.inr r2 :: rest).length := by simp [List.length]
  exact Nat.lt_of_le_of_lt h_le h_lt

/-- Every `g ∈ finiteStage (n+1)` has an adjacent-alternating boundary-block list
representation with `List.IsChain BoundaryBlocksAlternate` (i.e. adjacent sides
differ). Uses `finiteStage_succ_exists_lastBoundaryBlocks` and
`normalizeBoundaryBlocks` which merges only adjacent same-side blocks via
`lastBoundaryBlock_inl_mul_inl` / `inr_mul_inr`, preserving exact product order.
Termination by `length`. The statement is the sound adjacent-alternating property:
it explicitly does not claim `List.Pairwise`, length ≤ 2, arbitrary zero-forcing,
or full kernel generation. No equal-index factorization beyond the `Fin 1`
kernel lemmas is used. -/
public theorem finiteStage_succ_exists_alternating_lastBoundaryBlocks
    {R : Type u} [Ring R] (n : ℕ) (g : StableSteinberg R)
    (hg : g ∈ finiteStage (R := R) (n + 1)) :
    ∃ L : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)),
      List.IsChain (BoundaryBlocksAlternate (n := n)) L ∧
      (L.map (lastBoundaryBlock (R := R) n)).prod = g := by
  obtain ⟨L0, hL0⟩ := finiteStage_succ_exists_lastBoundaryBlocks (R := R) hg
  refine ⟨normalizeBoundaryBlocks n L0, ?_, ?_⟩
  · exact normalizeBoundaryBlocks_chain n L0
  · have h_pres : (L0.map (lastBoundaryBlock (R := R) n)).prod =
        ((normalizeBoundaryBlocks n L0).map (lastBoundaryBlock (R := R) n)).prod :=
      normalizeBoundaryBlocks_preserves_prod n L0
    calc ((normalizeBoundaryBlocks n L0).map (lastBoundaryBlock (R := R) n)).prod
        = (L0.map (lastBoundaryBlock (R := R) n)).prod := h_pres.symm
      _ = g := hL0

/-! ## Cyclic same-side endpoint shortening

For a word `head :: middle ++ [last]` whose two endpoints are both `Sum.inl`
(and dually both `Sum.inr`) and whose boundary-block product lies in
`ker toStableE`, rotate the last block to the front, normalize, and record
the exact noncommutative conjugacy. Reuses the existing
`normalizeBoundaryBlocks` API for strict decrease and alternation.
No parity, even-length, finite-stage landing, Weyl, or Matsumoto claim.
Empty and singleton lists are not in the domain of the side-specific
theorems (the shape forces length ≥ 2); `n = 0` remains valid.
-/

private theorem cyclic_prod_conj {G : Type u} [Group G] {α : Type _}
    (head last : α) (middle : List α) (f : α → G) :
    ((last :: head :: middle).map f).prod =
      f last * ((head :: middle ++ [last]).map f).prod * (f last)⁻¹ := by
  have h1 : ((head :: middle ++ [last]).map f).prod =
      ((head :: middle).map f).prod * f last := by
    have hEq : head :: middle ++ [last] = (head :: middle) ++ [last] := by simp
    rw [hEq, List.map_append, List.prod_append]
    simp
  have h2 : ((last :: head :: middle).map f).prod =
      f last * ((head :: middle).map f).prod := by simp
  calc ((last :: head :: middle).map f).prod
      = f last * ((head :: middle).map f).prod := h2
    _ = f last * (((head :: middle).map f).prod * f last * (f last)⁻¹) := by
        simp [mul_assoc]
    _ = f last * ((head :: middle ++ [last]).map f).prod * (f last)⁻¹ := by
        rw [← h1, mul_assoc]

private theorem rotated_toStableE_eq_one {F : Type u} [Field F] {n : ℕ}
    (head last : Sum (Fin n → Multiplicative F) (Fin n → Multiplicative F))
    (middle : List (Sum (Fin n → Multiplicative F) (Fin n → Multiplicative F)))
    (hKer : toStableE (R := F) (((head :: middle ++ [last]).map (lastBoundaryBlock n)).prod) = 1) :
    toStableE (R := F) (((last :: head :: middle).map (lastBoundaryBlock n)).prod) = 1 := by
  have hConj := cyclic_prod_conj head last middle
    (lastBoundaryBlock (R := F) n)
  have hEq : ((last :: head :: middle).map (lastBoundaryBlock (R := F) n)).prod =
      lastBoundaryBlock (R := F) n last *
        (((head :: middle ++ [last]).map (lastBoundaryBlock (R := F) n)).prod) *
        (lastBoundaryBlock (R := F) n last)⁻¹ := hConj
  calc toStableE (R := F) (((last :: head :: middle).map (lastBoundaryBlock n)).prod)
      = toStableE (R := F)
          (lastBoundaryBlock n last *
            (((head :: middle ++ [last]).map (lastBoundaryBlock n)).prod) *
            (lastBoundaryBlock n last)⁻¹) := by rw [hEq]
    _ = toStableE (R := F) (lastBoundaryBlock n last) *
          toStableE (R := F) (((head :: middle ++ [last]).map (lastBoundaryBlock n)).prod) *
          toStableE (R := F) ((lastBoundaryBlock n last)⁻¹) := by
        simp [map_mul]
    _ = toStableE (R := F) (lastBoundaryBlock n last) * 1 *
          toStableE (R := F) ((lastBoundaryBlock n last)⁻¹) := by rw [hKer]
    _ = toStableE (R := F) (lastBoundaryBlock n last) *
          (toStableE (R := F) (lastBoundaryBlock n last))⁻¹ := by
        rw [mul_one, map_inv]
    _ = 1 := by rw [mul_inv_cancel]

/-- Cyclic same-side shortening for `Sum.inl` endpoints.

Orientation: word `L = Sum.inl cHead :: middle ++ [Sum.inl cLast]` with
`toStableE (prod L) = 1`. Rotate the last block to the front,
`Lrot = Sum.inl cLast :: Sum.inl cHead :: middle`, so `Lrot` starts with an
adjacent `inl`/`inl` pair.

Hypotheses: `n` arbitrary including `0`; `middle` may be `[]` (then
`L = [inl cHead, inl cLast]` of length 2). Shape forces length ≥ 2, so empty
and singleton are not inputs.

Conclusions:
- `toStableE (prod Lrot) = 1` (rotated kernel);
- with `Lnorm = normalizeBoundaryBlocks n Lrot`, `toStableE (prod Lnorm) = 1`;
- `Lnorm.length < L.length` via `length_normalizeBoundaryBlocks_lt_of_adjacent_inl`;
- `List.IsChain BoundaryBlocksAlternate Lnorm`;
- exact conjugacy `prod Lnorm = lastBlock * prod L * lastBlock⁻¹`
  (noncommutative, `lastBlock = lastBoundaryBlock n (Sum.inl cLast)`).

Nonclaims: no parity/odd-even, scalar pivot, finite-stage, Weyl, or Matsumoto
statement; does not claim `Lnorm` is `Pairwise` alternating or length ≤ 1;
does not claim the converse kernel transport without centrality. -/
public theorem cyclicSameSideShortening_inl {F : Type u} [Field F] (n : ℕ)
    (cHead cLast : Fin n → Multiplicative F)
    (middle : List (Sum (Fin n → Multiplicative F) (Fin n → Multiplicative F)))
    (hKer : toStableE (R := F)
      (((Sum.inl cHead :: middle ++ [Sum.inl cLast]).map (lastBoundaryBlock n)).prod) = 1) :
    toStableE (R := F)
        (((Sum.inl cLast :: Sum.inl cHead :: middle).map (lastBoundaryBlock n)).prod) = 1 ∧
      toStableE (R := F)
          (((normalizeBoundaryBlocks (R := F) n
              (Sum.inl cLast :: Sum.inl cHead :: middle)).map (lastBoundaryBlock n)).prod) = 1 ∧
      (normalizeBoundaryBlocks (R := F) n
          (Sum.inl cLast :: Sum.inl cHead :: middle)).length <
        (Sum.inl cHead :: middle ++ [Sum.inl cLast]).length ∧
      List.IsChain (BoundaryBlocksAlternate (n := n))
          (normalizeBoundaryBlocks (R := F) n (Sum.inl cLast :: Sum.inl cHead :: middle)) ∧
      ((normalizeBoundaryBlocks (R := F) n
            (Sum.inl cLast :: Sum.inl cHead :: middle)).map (lastBoundaryBlock (R := F) n)).prod =
        lastBoundaryBlock (R := F) n (Sum.inl cLast) *
          (((Sum.inl cHead :: middle ++ [Sum.inl cLast]).map (lastBoundaryBlock (R := F) n)).prod) *
          (lastBoundaryBlock (R := F) n (Sum.inl cLast))⁻¹ := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact rotated_toStableE_eq_one (Sum.inl cHead) (Sum.inl cLast) middle hKer
  · have hRot := rotated_toStableE_eq_one (Sum.inl cHead) (Sum.inl cLast) middle hKer
    have hPres := normalizeBoundaryBlocks_preserves_prod (R := F) n
      (Sum.inl cLast :: Sum.inl cHead :: middle)
    have hEq : ((normalizeBoundaryBlocks n
        (Sum.inl cLast :: Sum.inl cHead :: middle)).map (lastBoundaryBlock n)).prod =
        ((Sum.inl cLast :: Sum.inl cHead :: middle).map (lastBoundaryBlock n)).prod := by
      rw [← hPres]
    calc toStableE (R := F)
          (((normalizeBoundaryBlocks n
              (Sum.inl cLast :: Sum.inl cHead :: middle)).map (lastBoundaryBlock n)).prod)
        = toStableE (R := F)
            (((Sum.inl cLast :: Sum.inl cHead :: middle).map (lastBoundaryBlock n)).prod) := by
          rw [hEq]
      _ = 1 := hRot
  · have hLtAdj := length_normalizeBoundaryBlocks_lt_of_adjacent_inl (R := F) n
      cLast cHead middle
    have hLenL : (Sum.inl cHead :: middle ++ [Sum.inl cLast]).length =
        (Sum.inl cLast :: Sum.inl cHead :: middle).length := by
      simp [List.length]
    linarith
  · exact normalizeBoundaryBlocks_chain (R := F) n
      (Sum.inl cLast :: Sum.inl cHead :: middle)
  · have hPres : ((normalizeBoundaryBlocks (R := F) n
          (Sum.inl cLast :: Sum.inl cHead :: middle)).map (lastBoundaryBlock (R := F) n)).prod =
        ((Sum.inl cLast :: Sum.inl cHead :: middle).map (lastBoundaryBlock (R := F) n)).prod := by
      rw [← normalizeBoundaryBlocks_preserves_prod (R := F) n
        (Sum.inl cLast :: Sum.inl cHead :: middle)]
    have hConj :
        ((Sum.inl cLast :: Sum.inl cHead :: middle).map
            (lastBoundaryBlock (R := F) n)).prod =
        lastBoundaryBlock (R := F) n (Sum.inl cLast) *
          (((Sum.inl cHead :: middle ++ [Sum.inl cLast]).map
              (lastBoundaryBlock (R := F) n)).prod) *
          (lastBoundaryBlock (R := F) n (Sum.inl cLast))⁻¹ :=
      cyclic_prod_conj (Sum.inl cHead) (Sum.inl cLast) middle
        (lastBoundaryBlock (R := F) n)
    rw [hPres, hConj]

/-- Cyclic same-side shortening for `Sum.inr` endpoints.

Orientation: word `L = Sum.inr rHead :: middle ++ [Sum.inr rLast]` with
`toStableE (prod L) = 1`. Rotate the last block to the front,
`Lrot = Sum.inr rLast :: Sum.inr rHead :: middle`.

Hypotheses: `n` arbitrary including `0`; `middle` may be `[]`. Shape forces
length ≥ 2; empty and singleton are not inputs.

Conclusions: same five as the `inl` theorem, with `inr` sides and
`length_normalizeBoundaryBlocks_lt_of_adjacent_inr`.

Nonclaims: identical to the `inl` variant. -/
public theorem cyclicSameSideShortening_inr {F : Type u} [Field F] (n : ℕ)
    (rHead rLast : Fin n → Multiplicative F)
    (middle : List (Sum (Fin n → Multiplicative F) (Fin n → Multiplicative F)))
    (hKer : toStableE (R := F)
      (((Sum.inr rHead :: middle ++ [Sum.inr rLast]).map (lastBoundaryBlock n)).prod) = 1) :
    toStableE (R := F)
        (((Sum.inr rLast :: Sum.inr rHead :: middle).map (lastBoundaryBlock n)).prod) = 1 ∧
      toStableE (R := F)
          (((normalizeBoundaryBlocks (R := F) n
              (Sum.inr rLast :: Sum.inr rHead :: middle)).map (lastBoundaryBlock n)).prod) = 1 ∧
      (normalizeBoundaryBlocks (R := F) n
          (Sum.inr rLast :: Sum.inr rHead :: middle)).length <
        (Sum.inr rHead :: middle ++ [Sum.inr rLast]).length ∧
      List.IsChain (BoundaryBlocksAlternate (n := n))
          (normalizeBoundaryBlocks (R := F) n (Sum.inr rLast :: Sum.inr rHead :: middle)) ∧
      ((normalizeBoundaryBlocks (R := F) n
            (Sum.inr rLast :: Sum.inr rHead :: middle)).map (lastBoundaryBlock (R := F) n)).prod =
        lastBoundaryBlock (R := F) n (Sum.inr rLast) *
          (((Sum.inr rHead :: middle ++ [Sum.inr rLast]).map (lastBoundaryBlock (R := F) n)).prod) *
          (lastBoundaryBlock (R := F) n (Sum.inr rLast))⁻¹ := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact rotated_toStableE_eq_one (Sum.inr rHead) (Sum.inr rLast) middle hKer
  · have hRot := rotated_toStableE_eq_one (Sum.inr rHead) (Sum.inr rLast) middle hKer
    have hPres := normalizeBoundaryBlocks_preserves_prod (R := F) n
      (Sum.inr rLast :: Sum.inr rHead :: middle)
    have hEq : ((normalizeBoundaryBlocks n
        (Sum.inr rLast :: Sum.inr rHead :: middle)).map (lastBoundaryBlock n)).prod =
        ((Sum.inr rLast :: Sum.inr rHead :: middle).map (lastBoundaryBlock n)).prod := by
      rw [← hPres]
    calc toStableE (R := F)
          (((normalizeBoundaryBlocks n
              (Sum.inr rLast :: Sum.inr rHead :: middle)).map (lastBoundaryBlock n)).prod)
        = toStableE (R := F)
            (((Sum.inr rLast :: Sum.inr rHead :: middle).map (lastBoundaryBlock n)).prod) := by
          rw [hEq]
      _ = 1 := hRot
  · have hLtAdj := length_normalizeBoundaryBlocks_lt_of_adjacent_inr (R := F) n
      rLast rHead middle
    have hLenL : (Sum.inr rHead :: middle ++ [Sum.inr rLast]).length =
        (Sum.inr rLast :: Sum.inr rHead :: middle).length := by
      simp [List.length]
    linarith
  · exact normalizeBoundaryBlocks_chain (R := F) n
      (Sum.inr rLast :: Sum.inr rHead :: middle)
  · have hPres : ((normalizeBoundaryBlocks (R := F) n
          (Sum.inr rLast :: Sum.inr rHead :: middle)).map (lastBoundaryBlock (R := F) n)).prod =
        ((Sum.inr rLast :: Sum.inr rHead :: middle).map (lastBoundaryBlock (R := F) n)).prod := by
      rw [← normalizeBoundaryBlocks_preserves_prod (R := F) n
        (Sum.inr rLast :: Sum.inr rHead :: middle)]
    have hConj :
        ((Sum.inr rLast :: Sum.inr rHead :: middle).map
            (lastBoundaryBlock (R := F) n)).prod =
        lastBoundaryBlock (R := F) n (Sum.inr rLast) *
          (((Sum.inr rHead :: middle ++ [Sum.inr rLast]).map
              (lastBoundaryBlock (R := F) n)).prod) *
          (lastBoundaryBlock (R := F) n (Sum.inr rLast))⁻¹ :=
      cyclic_prod_conj (Sum.inr rHead) (Sum.inr rLast) middle
        (lastBoundaryBlock (R := F) n)
    rw [hPres, hConj]

/-- Side-agnostic induction transport via centrality.

If `h` is the normalized rotated product, `h ∈ torusCocycleSubgroup`,
and `h = w * g * w⁻¹` (exact noncommutative conjugacy with `w` the last
block), then `g ∈ torusCocycleSubgroup`. Uses
`torusCocycleSubgroup_le_center`: every element of the subgroup is central,
so conjugation is trivial on `h`, and `g = w⁻¹ * h * w = h`.

Orientation: agnostic to `inl`/`inr`; `w` may be any `StableSteinberg F`
element, in practice `lastBoundaryBlock n last`. Makes no length, chain,
or kernel claim beyond the two hypotheses. -/
public theorem torusCocycleSubgroup_mem_of_conj
    {F : Type u} [Field F] {g h w : StableSteinberg F}
    (hConj : h = w * g * w⁻¹) (hMem : h ∈ torusCocycleSubgroup (F := F)) :
    g ∈ torusCocycleSubgroup (F := F) := by
  have hCenter : h ∈ Subgroup.center (StableSteinberg F) :=
    torusCocycleSubgroup_le_center (F := F) hMem
  rw [Subgroup.mem_center_iff] at hCenter
  have hComm : h * w = w * h := (hCenter w).symm
  have hEq : g = h := by
    calc g = w⁻¹ * (w * g * w⁻¹) * w := by
          simp [mul_assoc]
      _ = w⁻¹ * h * w := by rw [← hConj]
      _ = w⁻¹ * (h * w) := by rw [mul_assoc]
      _ = w⁻¹ * (w * h) := by rw [hComm]
      _ = h := by rw [← mul_assoc, inv_mul_cancel, one_mul]
  rw [hEq]
  exact hMem

private theorem alternate_blockSide_ne {R : Type u} {n : ℕ}
    {a b : Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)}
    (h : BoundaryBlocksAlternate (n := n) a b) :
    blockSide (R := R) a ≠ blockSide (R := R) b := by
  cases a with
  | inl _ =>
    cases b with
    | inl _ => simp [BoundaryBlocksAlternate] at h
    | inr _ => simp [blockSide]
  | inr _ =>
    cases b with
    | inl _ => simp [blockSide]
    | inr _ => simp [BoundaryBlocksAlternate] at h

private theorem exists_head_middle_last {α : Type _}
    (L : List α) (h : 2 ≤ L.length) :
    ∃ head middle last, L = head :: middle ++ [last] := by
  induction L with
  | nil => simp at h
  | cons hd tl ih =>
    cases tl with
    | nil => simp at h
    | cons b rest =>
      by_cases hRest : rest = []
      · subst hRest
        exact ⟨hd, [], b, rfl⟩
      · have hTailLen : 2 ≤ (b :: rest).length := by
          have hr : 1 ≤ rest.length := by
            cases rest with
            | nil => contradiction
            | cons _ _ => simp
          simp
          omega
        obtain ⟨hd', mid', last', hEq'⟩ := ih hTailLen
        refine ⟨hd, hd' :: mid', last', ?_⟩
        calc hd :: b :: rest = hd :: (b :: rest) := rfl
          _ = hd :: (hd' :: mid' ++ [last']) := by rw [hEq']
          _ = hd :: hd' :: mid' ++ [last'] := by simp

private theorem decomp_parity {R : Type u} {n : ℕ}
    {head last : Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R)}
    {middle : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))}
    {L : List (Sum (Fin n → Multiplicative R) (Fin n → Multiplicative R))}
    (hEq : L = head :: middle ++ [last])
    (hChain : List.IsChain (BoundaryBlocksAlternate (n := n)) L) :
    (blockSide (R := R) head = blockSide (R := R) last) ↔
      (L.length % 2 = 1) := by
  match middle with
  | [] =>
    have hAB : BoundaryBlocksAlternate (n := n) head last := by
      have hChain' : List.IsChain (BoundaryBlocksAlternate (n := n))
          [head, last] := by
        have hEq' : L = [head, last] := by simpa using hEq
        rw [hEq'] at hChain
        exact hChain
      cases hChain' with
      | cons_cons hAB _ => exact hAB
    have hNe : blockSide (R := R) head ≠ blockSide (R := R) last :=
      alternate_blockSide_ne hAB
    have hLen2 : L.length = 2 := by
      have hLen : L.length = (head :: ([] : List _) ++ [last]).length := by rw [hEq]
      simpa using hLen
    constructor
    · intro hEqSide
      exfalso
      exact hNe hEqSide
    · intro hOdd
      rw [hLen2] at hOdd
      simp at hOdd
  | b :: rest =>
    have hHeadB : BoundaryBlocksAlternate (n := n) head b := by
      have hChain' : List.IsChain (BoundaryBlocksAlternate (n := n))
          (head :: b :: (rest ++ [last])) := by
        have hEq' : L = head :: b :: (rest ++ [last]) := by simpa using hEq
        rw [hEq'] at hChain
        exact hChain
      cases hChain' with
      | cons_cons hAB _ => exact hAB
    have hTailChain : List.IsChain (BoundaryBlocksAlternate (n := n))
        (b :: rest ++ [last]) := by
      have hChain' : List.IsChain (BoundaryBlocksAlternate (n := n))
          (head :: b :: (rest ++ [last])) := by
        have hEq' : L = head :: b :: (rest ++ [last]) := by simpa using hEq
        rw [hEq'] at hChain
        exact hChain
      cases hChain' with
      | cons_cons _ hTail => exact hTail
    have hFlipHeadB : blockSide (R := R) head ≠ blockSide (R := R) b :=
      alternate_blockSide_ne hHeadB
    have hParityTail :
        (blockSide (R := R) b = blockSide (R := R) last) ↔
          ((b :: rest ++ [last]).length % 2 = 1) :=
      decomp_parity (head := b) (middle := rest)
        (L := b :: rest ++ [last]) rfl hTailChain
    have hLen : L.length = (head :: b :: rest ++ [last]).length := by
      have : L = head :: b :: rest ++ [last] := by simpa using hEq
      rw [this]
    have hLenTail : (b :: rest ++ [last]).length + 1 = L.length := by
      rw [hLen]
      simp
    constructor
    · intro hEqSide
      have hBNeLast : blockSide (R := R) b ≠ blockSide (R := R) last := by
        cases hbHead : blockSide (R := R) head <;>
          cases hbB : blockSide (R := R) b <;>
            cases hbLast : blockSide (R := R) last <;> simp_all
      have hTailNotOdd : ¬((b :: rest ++ [last]).length % 2 = 1) := by
        rw [← hParityTail]
        exact hBNeLast
      omega
    · intro hOdd
      have hTailNotOdd : ¬((b :: rest ++ [last]).length % 2 = 1) := by omega
      have hBNeLast : blockSide (R := R) b ≠ blockSide (R := R) last := by
        rw [← hParityTail] at hTailNotOdd
        exact hTailNotOdd
      cases hbHead : blockSide (R := R) head <;>
        cases hbB : blockSide (R := R) b <;>
          cases hbLast : blockSide (R := R) last <;> simp_all
termination_by middle.length

/-- Odd-length normalized kernel shortening via cyclic same-side rotation.

For a normalized alternating word `L` of odd length at least three whose
boundary-block product lies in `ker toStableE`, the two endpoints lie on the
same side. Rotating the last block to the front creates an adjacent same-side
pair, normalizing strictly shortens the word while preserving the alternating
chain, the kernel condition, and the exact noncommutative conjugacy
`prod Lnorm = lastBlock * prod L * lastBlock⁻¹`. Membership of the normalized
product in `torusCocycleSubgroup` transports back to the original product
via centrality. Handles empty/singleton/length-two exclusion through
`3 ≤ L.length`; `n = 0` remains valid. No even-length, pivot, or Matsumoto
claim. -/
public theorem oddLengthNormalizedKernelShortening {F : Type u} [Field F]
    (n : ℕ)
    (L : List (Sum (Fin n → Multiplicative F) (Fin n → Multiplicative F)))
    (hChain : List.IsChain (BoundaryBlocksAlternate (n := n)) L)
    (hOdd : L.length % 2 = 1) (hLen : 3 ≤ L.length)
    (hKer : toStableE ((L.map (lastBoundaryBlock n)).prod) = 1) :
    ∃ (Lnorm : List (Sum (Fin n → Multiplicative F) (Fin n → Multiplicative F)))
      (w : StableSteinberg F),
      List.IsChain (BoundaryBlocksAlternate (n := n)) Lnorm ∧
      toStableE ((Lnorm.map (lastBoundaryBlock n)).prod) = 1 ∧
      Lnorm.length < L.length ∧
      (Lnorm.map (lastBoundaryBlock n)).prod =
        w * (L.map (lastBoundaryBlock n)).prod * w⁻¹ ∧
      ((Lnorm.map (lastBoundaryBlock n)).prod ∈ torusCocycleSubgroup →
        (L.map (lastBoundaryBlock n)).prod ∈ torusCocycleSubgroup) := by
  have hGe2 : 2 ≤ L.length := by omega
  obtain ⟨head, middle, last, hEq⟩ := exists_head_middle_last L hGe2
  have hSideEq : blockSide (R := F) head = blockSide (R := F) last :=
    (decomp_parity (R := F) hEq hChain).mpr hOdd
  cases head with
  | inl cHead =>
    cases last with
    | inl cLast =>
      have hEq' : L = Sum.inl cHead :: middle ++ [Sum.inl cLast] := hEq
      have hKer' : toStableE
          (((Sum.inl cHead :: middle ++ [Sum.inl cLast]).map (lastBoundaryBlock n)).prod) = 1 := by
        rw [← hEq']; exact hKer
      have hCyc := cyclicSameSideShortening_inl (F := F) n cHead cLast middle hKer'
      obtain ⟨_, hNormKer, hLt, hChainNorm, hConj⟩ := hCyc
      have hConjEq : ((normalizeBoundaryBlocks n
              (Sum.inl cLast :: Sum.inl cHead :: middle)).map (lastBoundaryBlock n)).prod =
            lastBoundaryBlock n (Sum.inl cLast) *
              ((L.map (lastBoundaryBlock n)).prod) *
              (lastBoundaryBlock n (Sum.inl cLast))⁻¹ := by
          rw [hConj, hEq']
      refine ⟨normalizeBoundaryBlocks n (Sum.inl cLast :: Sum.inl cHead :: middle),
        lastBoundaryBlock n (Sum.inl cLast), ?_, ?_, ?_, ?_, ?_⟩
      · exact hChainNorm
      · exact hNormKer
      · have hLenEq : L.length = (Sum.inl cHead :: middle ++ [Sum.inl cLast]).length := by
          rw [← hEq']
        linarith
      · exact hConjEq
      · intro hMem
        exact torusCocycleSubgroup_mem_of_conj hConjEq hMem
    | inr _ =>
      simp [blockSide] at hSideEq
  | inr rHead =>
    cases last with
    | inl _ =>
      simp [blockSide] at hSideEq
    | inr rLast =>
      have hEq' : L = Sum.inr rHead :: middle ++ [Sum.inr rLast] := hEq
      have hKer' : toStableE
          (((Sum.inr rHead :: middle ++ [Sum.inr rLast]).map (lastBoundaryBlock n)).prod) = 1 := by
        rw [← hEq']; exact hKer
      have hCyc := cyclicSameSideShortening_inr (F := F) n rHead rLast middle hKer'
      obtain ⟨_, hNormKer, hLt, hChainNorm, hConj⟩ := hCyc
      have hConjEq : ((normalizeBoundaryBlocks n
              (Sum.inr rLast :: Sum.inr rHead :: middle)).map (lastBoundaryBlock n)).prod =
            lastBoundaryBlock n (Sum.inr rLast) *
              ((L.map (lastBoundaryBlock n)).prod) *
              (lastBoundaryBlock n (Sum.inr rLast))⁻¹ := by
          rw [hConj, hEq']
      refine ⟨normalizeBoundaryBlocks n (Sum.inr rLast :: Sum.inr rHead :: middle),
        lastBoundaryBlock n (Sum.inr rLast), ?_, ?_, ?_, ?_, ?_⟩
      · exact hChainNorm
      · exact hNormKer
      · have hLenEq : L.length = (Sum.inr rHead :: middle ++ [Sum.inr rLast]).length := by
          rw [← hEq']
        linarith
      · exact hConjEq
      · intro hMem
        exact torusCocycleSubgroup_mem_of_conj hConjEq hMem

end AlgebraicKTheory.StableSteinberg

