module

public import MathlibExt.KTheory.Ring.K2.SteinbergPresentation

/-! # Finite support for the stable Steinberg group

Finite-stage subgroups exhaust `StableSteinberg R`. -/

namespace AlgebraicKTheory

universe u

namespace StableSteinberg

variable {R : Type u} [Ring R]

/-- The subgroup generated by roots whose two indices are below `n`. -/
@[expose] public def finiteStage (n : ℕ) : Subgroup (StableSteinberg R) :=
  Subgroup.closure
    { g | ∃ (i j : ℕ) (hij : i ≠ j) (a : R),
      g = x (R := R) i j hij a ∧ i < n ∧ j < n }

@[expose] public section

@[simp]
theorem x_zero (i j : ℕ) (hij : i ≠ j) :
    (x (R := R) i j hij (0 : R)) = (1 : StableSteinberg R) := by
  have h : x (R := R) i j hij (0 : R) * x i j hij (0 : R) = x i j hij (0 : R) := by
    have h_add := x_add (R := R) i j hij (0 : R) (0 : R)
    simpa [zero_add] using h_add
  have h_one : (1 : StableSteinberg R) * x (R := R) i j hij (0 : R) = x i j hij (0 : R) := by
    simp
  have h_eq : x (R := R) i j hij (0 : R) * x i j hij (0 : R) = 1 * x (R := R) i j hij (0 : R) := by
    rw [h, h_one]
  exact mul_right_cancel h_eq

@[simp]
theorem x_neg (i j : ℕ) (hij : i ≠ j) (a : R) :
    x (R := R) i j hij (-a) = (x i j hij a)⁻¹ := by
  have h_add : x (R := R) i j hij a * x i j hij (-a) = x i j hij (a + -a) :=
    x_add i j hij a (-a)
  have h_zero : x (R := R) i j hij (a + -a) = (1 : StableSteinberg R) := by
    have ha : a + -a = (0 : R) := add_neg_cancel a
    rw [ha]
    exact x_zero i j hij
  have h_mul : x (R := R) i j hij a * x i j hij (-a) = (1 : StableSteinberg R) := by
    rw [h_add, h_zero]
  have h_inv : x (R := R) i j hij (-a) = (x i j hij a)⁻¹ := by
    have h_eq : x (R := R) i j hij a * x i j hij (-a) = x (R := R) i j hij a * (x i j hij a)⁻¹ := by
      rw [h_mul, mul_inv_cancel]
    exact mul_left_cancel h_eq
  exact h_inv

theorem x_mem_finiteStage {n : ℕ} {i j : ℕ} {hij : i ≠ j} {a : R}
    (hi : i < n) (hj : j < n) :
    x (R := R) i j hij a ∈ finiteStage (R := R) n := by
  apply Subgroup.subset_closure
  exact ⟨i, j, hij, a, rfl, hi, hj⟩

/-- `finiteStage` is monotone in the bound. -/
theorem finiteStage_mono : Monotone (finiteStage (R := R)) := by
  intro m n hmn
  apply Subgroup.closure_mono
  intro g hg
  obtain ⟨i, j, hij, a, rfl, hi, hj⟩ := hg
  exact ⟨i, j, hij, a, rfl, Nat.lt_of_lt_of_le hi hmn, Nat.lt_of_lt_of_le hj hmn⟩

/-- Every element lies in some `finiteStage`. -/
theorem exists_mem_finiteStage (g : StableSteinberg R) :
    ∃ n, g ∈ finiteStage (R := R) n := by
  induction g using PresentedGroup.induction_on with
  | H w =>
    induction w using FreeGroup.induction_on with
    | one =>
      exact ⟨0, Subgroup.one_mem _⟩
    | of gen =>
      obtain ⟨i, j, hij, a⟩ := gen
      exact ⟨max i j + 1,
        x_mem_finiteStage (Nat.lt_succ_of_le (Nat.le_max_left i j))
          (Nat.lt_succ_of_le (Nat.le_max_right i j))⟩
    | inv_of gen ih =>
      obtain ⟨n, hn⟩ := ih
      have h_eq :
          (PresentedGroup.mk (steinbergRelations R) ((FreeGroup.of gen)⁻¹) :
            StableSteinberg R) =
            (PresentedGroup.mk (steinbergRelations R) (FreeGroup.of gen))⁻¹ := by
        simp
      rw [h_eq]
      exact ⟨n, Subgroup.inv_mem _ hn⟩
    | mul w1 w2 ih1 ih2 =>
      obtain ⟨m, hm⟩ := ih1
      obtain ⟨n, hn⟩ := ih2
      have hm' : (PresentedGroup.mk (steinbergRelations R) w1 : StableSteinberg R) ∈
          finiteStage (max m n) :=
        finiteStage_mono (Nat.le_max_left m n) hm
      have hn' : (PresentedGroup.mk (steinbergRelations R) w2 : StableSteinberg R) ∈
          finiteStage (max m n) :=
        finiteStage_mono (Nat.le_max_right m n) hn
      have h_eq :
          (PresentedGroup.mk (steinbergRelations R) (w1 * w2) : StableSteinberg R) =
            (PresentedGroup.mk (steinbergRelations R) w1) *
              (PresentedGroup.mk (steinbergRelations R) w2) := by
        simp
      rw [h_eq]
      exact ⟨max m n, Subgroup.mul_mem _ hm' hn'⟩

/-- No two distinct natural indices lie below `0`, so `finiteStage 0 = ⊥`. -/
theorem finiteStage_zero_eq_bot : finiteStage (R := R) 0 = ⊥ := by
  apply le_antisymm
  · rw [finiteStage, Subgroup.closure_le]
    intro g hg
    obtain ⟨i, j, hij, a, rfl, hi, _⟩ := hg
    exact absurd hi (Nat.not_lt_zero i)
  · exact bot_le

/-- No two distinct natural indices lie below `1`, so `finiteStage 1 = ⊥`. -/
theorem finiteStage_one_eq_bot : finiteStage (R := R) 1 = ⊥ := by
  apply le_antisymm
  · rw [finiteStage, Subgroup.closure_le]
    intro g hg
    obtain ⟨i, j, hij, a, rfl, hi, hj⟩ := hg
    have hi0 : i = 0 := Nat.lt_one_iff.mp hi
    have hj0 : j = 0 := Nat.lt_one_iff.mp hj
    exact (hij (by rw [hi0, hj0])).elim
  · exact bot_le

end

end StableSteinberg

end AlgebraicKTheory
