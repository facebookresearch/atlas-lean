module

public import MathlibExt.KTheory.Ring.K2.StableSteinbergFiniteSupport
public import MathlibExt.KTheory.Ring.K2.StableSteinbergWeyl

/-!
# Stable Steinberg root subgroups

Last-column and last-row subgroups of `StableSteinberg R` and their commuting
product descriptions over `Fin n`. Provides the product homomorphisms,
their evaluation on `Pi.mulSingle`, and the identification of the ranges with
the closure-generated root subgroups.
-/

namespace AlgebraicKTheory

universe u

namespace StableSteinberg

open scoped commutatorElement

variable {R : Type u} [Ring R]

/-- Subgroup generated by the last-column Steinberg generators. -/
@[expose]
public def lastColumnSubgroup (n : ℕ) : Subgroup (StableSteinberg R) :=
  Subgroup.closure { g | ∃ (i : ℕ) (_hi : i < n) (hij : i ≠ n) (a : R), g = x i n hij a }

/-- Subgroup generated by the last-row Steinberg generators. -/
@[expose]
public def lastRowSubgroup (n : ℕ) : Subgroup (StableSteinberg R) :=
  Subgroup.closure { g | ∃ (i : ℕ) (_hi : i < n) (hij : n ≠ i) (a : R), g = x n i hij a }

public theorem x_mem_lastColumnSubgroup {n : ℕ} {i : ℕ} (hi : i < n)
    {hij : i ≠ n} {a : R} :
    x i n hij a ∈ lastColumnSubgroup n := by
  apply Subgroup.subset_closure
  exact ⟨i, hi, hij, a, rfl⟩

public theorem x_mem_lastRowSubgroup {n : ℕ} {i : ℕ} (hi : i < n)
    {hij : n ≠ i} {a : R} :
    x n i hij a ∈ lastRowSubgroup n := by
  apply Subgroup.subset_closure
  exact ⟨i, hi, hij, a, rfl⟩

/-- `finiteStage n` is in the join of the last column and last row via the Chevalley commutator. -/
public theorem finiteStage_le_sup_lastColumnRow (n : ℕ) :
    finiteStage (R := R) n ≤ lastColumnSubgroup (R := R) n ⊔ lastRowSubgroup (R := R) n := by
  unfold finiteStage
  rw [Subgroup.closure_le]
  intro g hg
  obtain ⟨i, j, hij, a, rfl, hi, hj⟩ := hg
  have hi_n : i ≠ n := Nat.ne_of_lt hi
  have hn_j : n ≠ j := Ne.symm (Nat.ne_of_lt hj)
  have h_comm : ⁅x i n hi_n a, x n j hn_j (1 : R)⁆ = x i j hij (a * 1) :=
    x_chev i n j hi_n hn_j hij a 1
  have hx_c : x i n hi_n a ∈ lastColumnSubgroup (R := R) n := x_mem_lastColumnSubgroup hi
  have hx_r : x n j hn_j (1 : R) ∈ lastRowSubgroup (R := R) n := x_mem_lastRowSubgroup hj
  have hc : x i n hi_n a ∈ lastColumnSubgroup (R := R) n ⊔ lastRowSubgroup (R := R) n :=
    Subgroup.mem_sup_left hx_c
  have hr : x n j hn_j (1 : R) ∈ lastColumnSubgroup (R := R) n ⊔ lastRowSubgroup (R := R) n :=
    Subgroup.mem_sup_right hx_r
  have h_comm_mem : ⁅x i n hi_n a, x n j hn_j (1 : R)⁆ ∈
      lastColumnSubgroup (R := R) n ⊔ lastRowSubgroup (R := R) n :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hc hr)
      (Subgroup.inv_mem _ hc)) (Subgroup.inv_mem _ hr)
  have : x i j hij (a * 1) ∈ lastColumnSubgroup (R := R) n ⊔ lastRowSubgroup (R := R) n := by
    rw [← h_comm]; exact h_comm_mem
  rwa [mul_one] at this

private theorem x_eq_of_hij {i j : ℕ} {hij hij' : i ≠ j} {a : R} :
    x (R := R) i j hij a = x i j hij' a := by
  have h : hij = hij' := Subsingleton.elim hij hij'
  subst h
  rfl

/-- Indexed last-column root embedding `x i n` as a homomorphism;
    factor of the exposed boundary product. -/
@[expose]
public def lastColumnHom (n : ℕ) (i : Fin n) :
    Multiplicative R →* StableSteinberg R where
  toFun a := x i.val n (Nat.ne_of_lt i.isLt) a.toAdd
  map_one' := by
    simp [x_zero]
  map_mul' := by
    intro a b
    change x i.val n (Nat.ne_of_lt i.isLt) (a * b).toAdd =
      x i.val n (Nat.ne_of_lt i.isLt) a.toAdd *
        x i.val n (Nat.ne_of_lt i.isLt) b.toAdd
    have h : (a * b).toAdd = a.toAdd + b.toAdd := rfl
    rw [h]
    exact (x_add i.val n (Nat.ne_of_lt i.isLt) a.toAdd b.toAdd).symm

/-- Indexed last-row root embedding `x n i` as a homomorphism;
    factor of the exposed boundary product. -/
@[expose]
public def lastRowHom (n : ℕ) (i : Fin n) :
    Multiplicative R →* StableSteinberg R where
  toFun a := x n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) a.toAdd
  map_one' := by
    simp [x_zero]
  map_mul' := by
    intro a b
    change x n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) (a * b).toAdd =
      x n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) a.toAdd *
        x n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) b.toAdd
    have h : (a * b).toAdd = a.toAdd + b.toAdd := rfl
    rw [h]
    exact (x_add n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) a.toAdd b.toAdd).symm

/-- Pairwise commutation witness for the last-column embeddings,
    used to define the exposed boundary product. -/
public lemma lastColumnHom_pairwise_commute (n : ℕ) :
    Pairwise fun (i j : Fin n) => ∀ (a b : Multiplicative R),
      Commute (lastColumnHom n i a) (lastColumnHom n j b) := by
  intro i j _ a b
  have hi : (i.val ≠ n) := Nat.ne_of_lt i.isLt
  have hj : (j.val ≠ n) := Nat.ne_of_lt j.isLt
  have hcomm : ⁅x i.val n hi a.toAdd, x j.val n hj b.toAdd⁆ = 1 :=
    x_comm i.val n j.val n hi hj hi (Ne.symm hj) a.toAdd b.toAdd
  exact commutatorElement_eq_one_iff_commute.mp hcomm

/-- Pairwise commutation witness for the last-row embeddings,
    used to define the exposed boundary product. -/
public lemma lastRowHom_pairwise_commute (n : ℕ) :
    Pairwise fun (i j : Fin n) => ∀ (a b : Multiplicative R),
      Commute (lastRowHom n i a) (lastRowHom n j b) := by
  intro i j _ a b
  have hi : (n ≠ i.val) := Ne.symm (Nat.ne_of_lt i.isLt)
  have hj : (n ≠ j.val) := Ne.symm (Nat.ne_of_lt j.isLt)
  have hcomm : ⁅x n i.val hi a.toAdd, x n j.val hj b.toAdd⁆ = 1 :=
    x_comm n i.val n j.val hi hj hj (Nat.ne_of_lt i.isLt) a.toAdd b.toAdd
  exact commutatorElement_eq_one_iff_commute.mp hcomm

/-- Product homomorphism assembling the last-column embeddings `x i n` over `Fin n`. -/
@[expose]
public def lastColumnProduct (n : ℕ) :
    ((i : Fin n) → Multiplicative R) →* StableSteinberg R :=
  MonoidHom.noncommPiCoprod (fun i => lastColumnHom n i)
    (lastColumnHom_pairwise_commute n)

/-- Product homomorphism assembling the last-row embeddings `x n i` over `Fin n`. -/
@[expose]
public def lastRowProduct (n : ℕ) :
    ((i : Fin n) → Multiplicative R) →* StableSteinberg R :=
  MonoidHom.noncommPiCoprod (fun i => lastRowHom n i)
    (lastRowHom_pairwise_commute n)

/-- Evaluation of `lastColumnProduct` on a `Pi.mulSingle` generator. -/
@[simp]
public theorem lastColumnProduct_mulSingle (n : ℕ) (i : Fin n)
    (a : Multiplicative R) :
    lastColumnProduct n (Pi.mulSingle i a) =
      x i.val n (Nat.ne_of_lt i.isLt) a.toAdd := by
  simp [lastColumnProduct, lastColumnHom]

/-- Evaluation of `lastRowProduct` on a `Pi.mulSingle` generator. -/
@[simp]
public theorem lastRowProduct_mulSingle (n : ℕ) (i : Fin n)
    (a : Multiplicative R) :
    lastRowProduct n (Pi.mulSingle i a) =
      x n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) a.toAdd := by
  simp [lastRowProduct, lastRowHom]

/-- The range of `lastColumnProduct` is `lastColumnSubgroup`. -/
public theorem lastColumnProduct_range (n : ℕ) :
    (lastColumnProduct (R := R) n).range = lastColumnSubgroup (R := R) n := by
  unfold lastColumnProduct
  rw [MonoidHom.noncommPiCoprod_range]
  apply le_antisymm
  · apply iSup_le
    intro i y hy
    obtain ⟨a, ha⟩ := MonoidHom.mem_range.mp hy
    rw [← ha]
    have h_eq : lastColumnHom (R := R) n i a =
        x i.val n (Nat.ne_of_lt i.isLt) a.toAdd := rfl
    rw [h_eq]
    exact x_mem_lastColumnSubgroup i.isLt
  · unfold lastColumnSubgroup
    rw [Subgroup.closure_le]
    intro g hg
    obtain ⟨i, hi, hij, a, rfl⟩ := hg
    let ii : Fin n := ⟨i, hi⟩
    have hij' : (ii.val ≠ n) := Nat.ne_of_lt ii.isLt
    have h_eq : x i n hij a =
        lastColumnHom (R := R) n ii (Multiplicative.ofAdd a) := by
      have h1 : x i n hij a = x ii.val n hij' a := by
        apply x_eq_of_hij
      have h2 : x ii.val n hij' a =
          lastColumnHom (R := R) n ii (Multiplicative.ofAdd a) := by
        simp [lastColumnHom]
      rw [h1, h2]
    rw [h_eq]
    have h_mem : lastColumnHom (R := R) n ii (Multiplicative.ofAdd a) ∈
        (lastColumnHom (R := R) n ii).range :=
      MonoidHom.mem_range.mpr ⟨Multiplicative.ofAdd a, rfl⟩
    have h_le : (lastColumnHom (R := R) n ii).range ≤
        ⨆ i, (lastColumnHom (R := R) n i).range :=
      le_iSup (fun i => (lastColumnHom (R := R) n i).range) ii
    exact h_le h_mem

/-- The range of `lastRowProduct` is `lastRowSubgroup`. -/
public theorem lastRowProduct_range (n : ℕ) :
    (lastRowProduct (R := R) n).range = lastRowSubgroup (R := R) n := by
  unfold lastRowProduct
  rw [MonoidHom.noncommPiCoprod_range]
  apply le_antisymm
  · apply iSup_le
    intro i y hy
    obtain ⟨a, ha⟩ := MonoidHom.mem_range.mp hy
    rw [← ha]
    have h_eq : lastRowHom (R := R) n i a =
        x n i.val (Ne.symm (Nat.ne_of_lt i.isLt)) a.toAdd := rfl
    rw [h_eq]
    exact x_mem_lastRowSubgroup i.isLt
  · unfold lastRowSubgroup
    rw [Subgroup.closure_le]
    intro g hg
    obtain ⟨i, hi, hij, a, rfl⟩ := hg
    let ii : Fin n := ⟨i, hi⟩
    have hij' : (n ≠ ii.val) := Ne.symm (Nat.ne_of_lt ii.isLt)
    have h_eq : x n i hij a =
        lastRowHom (R := R) n ii (Multiplicative.ofAdd a) := by
      have h1 : x n i hij a = x n ii.val hij' a := by
        apply x_eq_of_hij
      have h2 : x n ii.val hij' a =
          lastRowHom (R := R) n ii (Multiplicative.ofAdd a) := by
        simp [lastRowHom]
      rw [h1, h2]
    rw [h_eq]
    have h_mem : lastRowHom (R := R) n ii (Multiplicative.ofAdd a) ∈
        (lastRowHom (R := R) n ii).range :=
      MonoidHom.mem_range.mpr ⟨Multiplicative.ofAdd a, rfl⟩
    have h_le : (lastRowHom (R := R) n ii).range ≤
        ⨆ i, (lastRowHom (R := R) n i).range :=
      le_iSup (fun i => (lastRowHom (R := R) n i).range) ii
    exact h_le h_mem

/-- `finiteStage (n+1)` is the join of the last column and row over `Fin n`. -/
public theorem finiteStage_succ_eq_sup_lastColumnRow (n : ℕ) :
    finiteStage (R := R) (n + 1) =
      lastColumnSubgroup (R := R) n ⊔ lastRowSubgroup (R := R) n := by
  apply le_antisymm
  · unfold finiteStage
    rw [Subgroup.closure_le]
    intro g hg
    obtain ⟨i, j, hij, a, rfl, hi, hj⟩ := hg
    have hi_le : i ≤ n := Nat.le_of_lt_succ hi
    have hj_le : j ≤ n := Nat.le_of_lt_succ hj
    rcases Nat.lt_or_eq_of_le hi_le with hi_lt | hi_eq
    · rcases Nat.lt_or_eq_of_le hj_le with hj_lt | hj_eq
      · exact finiteStage_le_sup_lastColumnRow n (x_mem_finiteStage hi_lt hj_lt)
      · subst hj_eq
        exact Subgroup.mem_sup_left (x_mem_lastColumnSubgroup hi_lt)
    · rcases Nat.lt_or_eq_of_le hj_le with hj_lt | hj_eq
      · subst hi_eq
        exact Subgroup.mem_sup_right (x_mem_lastRowSubgroup hj_lt)
      · subst hi_eq; subst hj_eq
        exact absurd rfl hij
  · apply sup_le
    · unfold lastColumnSubgroup
      rw [Subgroup.closure_le]
      intro g hg
      obtain ⟨i, hi, hij, a, rfl⟩ := hg
      exact x_mem_finiteStage (Nat.lt_trans hi (Nat.lt_succ_self n))
        (Nat.lt_succ_self n)
    · unfold lastRowSubgroup
      rw [Subgroup.closure_le]
      intro g hg
      obtain ⟨i, hi, hij, a, rfl⟩ := hg
      exact x_mem_finiteStage (Nat.lt_succ_self n)
        (Nat.lt_trans hi (Nat.lt_succ_self n))

/-- The commutator of a last-column and last-row generator lies in `finiteStage n`. -/
public theorem comm_lastColumnRow_mem_finiteStage {n i j : ℕ}
    (hi : i < n) (hj : j < n) (hij : i ≠ j) (a b : R) :
    ⁅x i n (Nat.ne_of_lt hi) a, x n j (Ne.symm (Nat.ne_of_lt hj)) b⁆ ∈
      finiteStage (R := R) n := by
  have h_eq : ⁅x i n (Nat.ne_of_lt hi) a,
      x n j (Ne.symm (Nat.ne_of_lt hj)) b⁆ = x i j hij (a * b) :=
    x_chev i n j (Nat.ne_of_lt hi) (Ne.symm (Nat.ne_of_lt hj)) hij a b
  rw [h_eq]
  exact x_mem_finiteStage hi hj

/-- Boundary torus subgroup generated by `torus i n u` for `i < n` and `u : Rˣ`. -/
@[expose]
public def boundaryTorusSubgroup (n : ℕ) : Subgroup (StableSteinberg R) :=
  Subgroup.closure { g | ∃ (i : ℕ) (_hi : i < n) (hij : i ≠ n) (u : Rˣ), g = torus i n hij u }

public theorem boundaryTorusSubgroup_le_finiteStage_succ (n : ℕ) :
    boundaryTorusSubgroup (R := R) n ≤ finiteStage (R := R) (n + 1) := by
  unfold boundaryTorusSubgroup
  rw [Subgroup.closure_le]
  intro g hg
  obtain ⟨i, hi, hij, u, rfl⟩ := hg
  unfold torus weyl
  have hi_succ : i < n + 1 := Nat.lt_trans hi (Nat.lt_succ_self n)
  have hn_succ : n < n + 1 := Nat.lt_succ_self n
  have hx_in : ∀ (a : R), x i n hij a ∈ finiteStage (R := R) (n + 1) :=
    fun a => x_mem_finiteStage hi_succ hn_succ
  have hx_ni : ∀ (a : R), x n i hij.symm a ∈ finiteStage (R := R) (n + 1) :=
    fun a => x_mem_finiteStage hn_succ hi_succ
  have h1 : x i n hij (↑u : R) ∈ finiteStage (R := R) (n + 1) := hx_in _
  have h2 : x n i hij.symm (-(↑u⁻¹ : R)) ∈ finiteStage (R := R) (n + 1) := hx_ni _
  have h3 : x i n hij (↑u : R) ∈ finiteStage (R := R) (n + 1) := hx_in _
  have hw_u : x i n hij (↑u : R) * x n i hij.symm (-(↑u⁻¹ : R)) * x i n hij (↑u : R) ∈
      finiteStage (R := R) (n + 1) :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ h1 h2) h3
  have h4 : x i n hij (↑(-1 : Rˣ) : R) ∈ finiteStage (R := R) (n + 1) := hx_in _
  have h5 : x n i hij.symm (-(↑(-1 : Rˣ)⁻¹ : R)) ∈ finiteStage (R := R) (n + 1) := hx_ni _
  have h6 : x i n hij (↑(-1 : Rˣ) : R) ∈ finiteStage (R := R) (n + 1) := hx_in _
  have hw_m1 : x i n hij (↑(-1 : Rˣ) : R) * x n i hij.symm (-(↑(-1 : Rˣ)⁻¹ : R)) *
      x i n hij (↑(-1 : Rˣ) : R) ∈ finiteStage (R := R) (n + 1) :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ h4 h5) h6
  exact Subgroup.mul_mem _ hw_u hw_m1

/-- For `[Field F]`, `hi : i < n`, `u : Fˣ`, `torus (R := F) i n _ u`
lies in `finiteStage (R := F) (n + 1)`. The `n + 1` bound is minimal for
`i < n + 1` and `n < n + 1`; the statement is vacuous at `n = 0`,
characteristic-two safe, and asserts only subgroup membership, not exact
torus multiplicativity nor any boundary-torus intersection statement. -/
public theorem torus_mem_finiteStage_succ {F : Type u} [Field F]
    {n i : ℕ} (hi : i < n) (u : Fˣ) :
    torus (R := F) i n (Nat.ne_of_lt hi) u ∈
      finiteStage (R := F) (n + 1) := by
  have h_mem : torus (R := F) i n (Nat.ne_of_lt hi) u ∈
      boundaryTorusSubgroup (R := F) n := by
    apply Subgroup.subset_closure
    exact ⟨i, hi, Nat.ne_of_lt hi, u, rfl⟩
  exact (boundaryTorusSubgroup_le_finiteStage_succ (R := F) n) h_mem

/-- For `[Field F]`, `hi : i < n`, `u : Fˣ`, the inverse
`(torus (R := F) i n _ u)⁻¹` lies in `finiteStage (R := F) (n + 1)`.
The `n + 1` bound is inherited from `torus_mem_finiteStage_succ`; the
statement is vacuous at `n = 0` and uses only subgroup inverse closure,
not torus multiplicativity or any new root wrapper. -/
public theorem torus_inv_mem_finiteStage_succ {F : Type u} [Field F]
    {n i : ℕ} (hi : i < n) (u : Fˣ) :
    (torus (R := F) i n (Nat.ne_of_lt hi) u)⁻¹ ∈
      finiteStage (R := F) (n + 1) := by
  exact (finiteStage (R := F) (n + 1)).inv_mem
    (torus_mem_finiteStage_succ hi u)

/-- For `[Field F]`, `hi : i < n`, the torus-corrected RHS of the
pending nonzero `1 + a * b` factorization lies in
`finiteStage (R := F) (n + 1)`. `n + 1` is the minimal boundary bound;
`n = 0` is vacuous; `n = 1` and characteristic two are covered;
this asserts membership only and no exact torus multiplicativity. -/
public theorem x_ij_div_u_mul_torus_inv_mul_x_ji_div_u_mem_finiteStage_succ
    {F : Type u} [Field F] {n i : ℕ} (hi : i < n) (a b : F)
    (hu : 1 + a * b ≠ 0) :
    let u := 1 + a * b
    let uUnit : Fˣ := Units.mk0 u hu
    x (R := F) i n (Nat.ne_of_lt hi) (a / u) *
      (torus (R := F) i n (Nat.ne_of_lt hi) uUnit)⁻¹ *
      x (R := F) n i (Ne.symm (Nat.ne_of_lt hi)) (b / u) ∈
      finiteStage (R := F) (n + 1) := by
  intro u uUnit
  have hi_succ : i < n + 1 := Nat.lt_trans hi (Nat.lt_succ_self n)
  have hn_succ : n < n + 1 := Nat.lt_succ_self n
  have h1 : x (R := F) i n (Nat.ne_of_lt hi) (a / u) ∈
      finiteStage (R := F) (n + 1) :=
    x_mem_finiteStage hi_succ hn_succ
  have h2 : (torus (R := F) i n (Nat.ne_of_lt hi) uUnit)⁻¹ ∈
      finiteStage (R := F) (n + 1) :=
    torus_inv_mem_finiteStage_succ hi uUnit
  have h3 : x (R := F) n i (Ne.symm (Nat.ne_of_lt hi)) (b / u) ∈
      finiteStage (R := F) (n + 1) :=
    x_mem_finiteStage hn_succ hi_succ
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ h1 h2) h3

/-- Row-before-column swap for distinct indices `i ≠ j` with
`i < n` and `j < n`. The product `x n j b * x i n a` has exactly
one adjacent row-before-column inversion; swapping it introduces
the single correction `x i j (-(a*b))`, which lies in
`finiteStage n` via `x_mem_finiteStage`. This is the atomic step
for the normal-form inversion-removal induction. -/
public theorem lastRow_mul_lastColumn_swap_distinct
    {n i j : ℕ} (hi : i < n) (hj : j < n) (hij : i ≠ j) (a b : R) :
    x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b *
      x i n (Nat.ne_of_lt hi) a =
      x i j hij (-(a * b)) *
        x i n (Nat.ne_of_lt hi) a *
        x n j (Ne.symm (Nat.ne_of_lt hj)) b := by
  have hi_n : i ≠ n := Nat.ne_of_lt hi
  have hn_j : n ≠ j := Ne.symm (Nat.ne_of_lt hj)
  have h_chev : ⁅x (R := R) i n hi_n a, x n j hn_j b⁆ =
      x i j hij (a * b) :=
    x_chev i n j hi_n hn_j hij a b
  have h_swap : ⁅x (R := R) n j hn_j b, x i n hi_n a⁆ =
      (⁅x (R := R) i n hi_n a, x n j hn_j b⁆)⁻¹ := by
    simp only [commutatorElement_def, mul_inv_rev, inv_inv, mul_assoc]
  have h_rc : ⁅x (R := R) n j hn_j b, x i n hi_n a⁆ =
      x i j hij (-(a * b)) := by
    calc
      ⁅x (R := R) n j hn_j b, x i n hi_n a⁆
          = (⁅x (R := R) i n hi_n a, x n j hn_j b⁆)⁻¹ := h_swap
      _ = (x i j hij (a * b))⁻¹ := by rw [h_chev]
      _ = x i j hij (-(a * b)) := by rw [← x_neg]
  have h_exp : x (R := R) n j hn_j b * x i n hi_n a *
      (x (R := R) n j hn_j b)⁻¹ * (x (R := R) i n hi_n a)⁻¹ =
      x i j hij (-(a * b)) := by
    simpa [commutatorElement_def] using h_rc
  calc
    x (R := R) n j hn_j b * x i n hi_n a
        = (x (R := R) n j hn_j b * x i n hi_n a *
          (x (R := R) n j hn_j b)⁻¹ * (x (R := R) i n hi_n a)⁻¹) *
          x i n hi_n a * x (R := R) n j hn_j b := by
          simp [mul_assoc]
    _ = x i j hij (-(a * b)) * x i n hi_n a *
        x (R := R) n j hn_j b := by rw [h_exp]

/-- Product of last-column generators over a list. -/
@[expose]
public def lastColumnListProd (n : ℕ) : List (Fin n × R) → StableSteinberg R
  | [] => 1 | p :: L => x p.1.val n (Nat.ne_of_lt p.1.isLt) p.2 *
      lastColumnListProd n L
/-- Ordered correction `∏ x i j (-(a*b))`; `i=j` gives `1`. -/
public def corrProd {n : ℕ} (j : ℕ) (b : R) : List (Fin n × R) → StableSteinberg R
  | [] => 1 | p :: L => if h : p.1.val ≠ j then
      x p.1.val j h (-(p.2 * b)) * corrProd j b L else corrProd j b L
private theorem corrProd_mem {n j : ℕ} (hj : j < n) (b : R)
    (L : List (Fin n × R)) : corrProd (R := R) j b L ∈ finiteStage n := by
  induction L with
  | nil => change (1 : StableSteinberg R) ∈ finiteStage n; exact (finiteStage n).one_mem
  | cons p L ih =>
    unfold corrProd; by_cases hp : p.1.val ≠ j
    · rw [dite_eq_left hp]
      exact (finiteStage n).mul_mem (x_mem_finiteStage p.1.isLt hj) ih
    · rw [dite_eq_right hp]; exact ih
private theorem col_elem_comm_corr {n j : ℕ} (b : R) (i : Fin n)
    (hi_j : i.val ≠ j) (a : R) (L : List (Fin n × R)) :
    x (R := R) i.val n (Nat.ne_of_lt i.isLt) a * corrProd (R := R) j b L =
      corrProd (R := R) j b L * x i.val n (Nat.ne_of_lt i.isLt) a := by
  induction L with
  | nil => simp only [corrProd, mul_one, one_mul]
  | cons p L ih =>
    unfold corrProd; by_cases hp : p.1.val ≠ j
    · rw [dite_eq_left hp]
      have hc : ⁅x (R := R) i.val n (Nat.ne_of_lt i.isLt) a,
          x p.1.val j hp (-(p.2 * b))⁆ = 1 :=
        x_comm i.val n p.1.val j (Nat.ne_of_lt i.isLt) hp hi_j
          (Ne.symm (Nat.ne_of_lt p.1.isLt)) a (-(p.2 * b))
      have heq := (commutatorElement_eq_one_iff_commute.mp hc).eq
      calc x i.val n (Nat.ne_of_lt i.isLt) a *
            (x p.1.val j hp (-(p.2 * b)) * corrProd j b L)
          = (x i.val n (Nat.ne_of_lt i.isLt) a *
              x p.1.val j hp (-(p.2 * b))) * corrProd j b L := by
            rw [mul_assoc]
        _ = (x p.1.val j hp (-(p.2 * b)) *
              x i.val n (Nat.ne_of_lt i.isLt) a) * corrProd j b L := by
            rw [heq]
        _ = x p.1.val j hp (-(p.2 * b)) *
            (x i.val n (Nat.ne_of_lt i.isLt) a * corrProd j b L) := by
            rw [mul_assoc]
        _ = x p.1.val j hp (-(p.2 * b)) *
            (corrProd j b L * x i.val n (Nat.ne_of_lt i.isLt) a) := by
            rw [ih]
        _ = (x p.1.val j hp (-(p.2 * b)) * corrProd j b L) *
            x i.val n (Nat.ne_of_lt i.isLt) a := by
            rw [mul_assoc]
    · rw [dite_eq_right hp]; exact ih
/-- One-sided list swap for distinct `i ≠ j`. -/
public theorem lastRow_mul_lastColumnList_swap_distinct
    {n j : ℕ} (hj : j < n) (b : R)
    (L : List (Fin n × R)) (hL : ∀ p ∈ L, p.1.val ≠ j) :
    corrProd (R := R) j b L ∈ finiteStage (R := R) n ∧
      x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b *
          lastColumnListProd (R := R) n L =
        corrProd (R := R) j b L * lastColumnListProd (R := R) n L *
          x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b := by
  constructor
  · exact corrProd_mem hj b L
  · revert hL
    induction L with
    | nil => intro _; simp [lastColumnListProd, corrProd]
    | cons p L ih =>
      intro hL
      have hp : p.1.val ≠ j := hL _ List.mem_cons_self
      have hT : ∀ q ∈ L, q.1.val ≠ j := fun q hq =>
        hL q (List.mem_cons_of_mem _ hq)
      have ih_eq := ih hT
      have h_col : lastColumnListProd (R := R) n (p :: L) =
          x p.1.val n (Nat.ne_of_lt p.1.isLt) p.2 *
            lastColumnListProd n L := rfl
      have h_corr : corrProd (R := R) j b (p :: L) =
          x p.1.val j hp (-(p.2 * b)) * corrProd j b L := by
        simp [corrProd, hp]
      have h_at := lastRow_mul_lastColumn_swap_distinct
          p.1.isLt hj hp p.2 b
      have h_comm := col_elem_comm_corr (R := R) b p.1 hp p.2 L
      calc x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b *
            lastColumnListProd n (p :: L)
          = (x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b *
              x p.1.val n (Nat.ne_of_lt p.1.isLt) p.2) *
            lastColumnListProd n L := by
            simp [h_col, mul_assoc]
        _ = x p.1.val j hp (-(p.2 * b)) *
              x p.1.val n (Nat.ne_of_lt p.1.isLt) p.2 *
              (corrProd j b L * lastColumnListProd n L *
                x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b) := by
            rw [h_at, mul_assoc, ih_eq]
        _ = x p.1.val j hp (-(p.2 * b)) *
              (corrProd j b L * x p.1.val n (Nat.ne_of_lt p.1.isLt) p.2) *
              lastColumnListProd n L *
              x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b := by
            simp only [mul_assoc]
            rw [← mul_assoc (x p.1.val n (Nat.ne_of_lt p.1.isLt) p.2)
              (corrProd j b L) (lastColumnListProd n L *
                x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b)]
            rw [h_comm]
            simp only [mul_assoc]
        _ = corrProd (R := R) j b (p :: L) *
              lastColumnListProd (R := R) n (p :: L) *
              x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b := by
            rw [h_corr, h_col]
            simp only [mul_assoc]

/-- Ordered product of last-row generators. Head-first. -/
@[expose]
public def lastRowListProd (n : ℕ) : List (Fin n × R) → StableSteinberg R
  | [] => 1
  | p :: L => x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2 *
      lastRowListProd n L

/-- Tail-first accumulated correction `∏ corrProd` for row list over
column list `C`. Preserves `-(a*b)` and order; `i=j` gives `1`. -/
public def twoListCorrProd {n : ℕ} (C : List (Fin n × R)) :
    List (Fin n × R) → StableSteinberg R
  | [] => 1
  | p :: Rl => twoListCorrProd C Rl * corrProd p.1.val p.2 C

/-- Restricted: `x n j` commutes with `corrProd j' b' L` when
`∀ p∈L, p.1≠j`. Only `x_comm` with `j≠p.1` and `n≠j'`. -/
private theorem row_gen_comm_corrProd {n : ℕ} {j : ℕ} (hj : j < n)
    {j' : ℕ} (hj' : j' < n) (b b' : R) (L : List (Fin n × R))
    (hD : ∀ p ∈ L, p.1.val ≠ j) :
    x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b *
      corrProd (R := R) j' b' L =
      corrProd (R := R) j' b' L *
      x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b := by
  induction L with
  | nil => simp [corrProd]
  | cons p L ih =>
    have hH : p.1.val ≠ j := hD _ List.mem_cons_self
    have hT : ∀ q ∈ L, q.1.val ≠ j :=
      fun q hq => hD q (List.mem_cons_of_mem _ hq)
    unfold corrProd
    by_cases hp' : p.1.val ≠ j'
    · rw [dite_eq_left hp']
      have hc : ⁅x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b,
          x p.1.val j' hp' (-(p.2 * b'))⁆ = 1 :=
        x_comm n j p.1.val j' (Ne.symm (Nat.ne_of_lt hj)) hp'
          (Ne.symm (Nat.ne_of_lt hj')) (Ne.symm hH) b (-(p.2 * b'))
      have heq := (commutatorElement_eq_one_iff_commute.mp hc).eq
      calc x n j _ b * (x p.1.val j' _ _ * corrProd j' b' L)
          = (x n j _ b * x p.1.val j' _ _) * corrProd j' b' L := by
            rw [mul_assoc]
        _ = (x p.1.val j' _ _ * x n j _ b) * corrProd j' b' L := by
            rw [heq]
        _ = x p.1.val j' _ _ * (x n j _ b * corrProd j' b' L) := by
            rw [mul_assoc]
        _ = x p.1.val j' _ _ * (corrProd j' b' L * x n j _ b) := by
            rw [ih hT]
        _ = (x p.1.val j' _ _ * corrProd j' b' L) * x n j _ b := by
            rw [mul_assoc]
    · rw [dite_eq_right hp']; exact ih hT

/-- Restricted: `x n j` commutes with `twoListCorrProd C Rl` when
`∀ p∈C, p.1≠j`. Each `corrProd` factor commutes via previous lemma. -/
private theorem row_gen_comm_twoListCorr {n : ℕ} {j : ℕ} (hj : j < n)
    (b : R) (C Rl : List (Fin n × R)) (hCj : ∀ p ∈ C, p.1.val ≠ j) :
    x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b *
      twoListCorrProd (R := R) C Rl =
      twoListCorrProd (R := R) C Rl *
      x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b := by
  induction Rl with
  | nil => simp [twoListCorrProd]
  | cons p Rl ih =>
    simp only [twoListCorrProd]
    have h1 := ih
    have h2 := row_gen_comm_corrProd hj p.1.isLt b p.2 C hCj
    calc x n j _ b * (twoListCorrProd C Rl * corrProd _ _ C)
        = (x n j _ b * twoListCorrProd C Rl) * corrProd _ _ C := by
          rw [mul_assoc]
      _ = (twoListCorrProd C Rl * x n j _ b) * corrProd _ _ C := by
          rw [h1]
      _ = twoListCorrProd C Rl * (x n j _ b * corrProd _ _ C) := by
          rw [mul_assoc]
      _ = twoListCorrProd C Rl * (corrProd _ _ C * x n j _ b) := by
          rw [h2]
      _ = (twoListCorrProd C Rl * corrProd _ _ C) * x n j _ b := by
          rw [mul_assoc]

/-- Last-row generator `x n j b` commutes with `twoListCorrProd C Rl` when `j < n`
and every `p ∈ C` satisfies `p.1.val ≠ j`.
Orientation: `x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b * twoListCorrProd (R := R) C Rl =
twoListCorrProd (R := R) C Rl * x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b`.
Hypotheses `hj : j < n` and `hCj : ∀ p ∈ C, p.1.val ≠ j` are required. This is a
commutation equality only—not normality, membership, collection, landing, kernel,
or Matsumoto. Generic over `[Ring R]` and characteristic-two safe. -/
public theorem lastRowGenerator_comm_twoListCorrProd {n : ℕ} {j : ℕ} (hj : j < n)
    (b : R) (C Rl : List (Fin n × R)) (hCj : ∀ p ∈ C, p.1.val ≠ j) :
    x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b * twoListCorrProd (R := R) C Rl =
      twoListCorrProd (R := R) C Rl * x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b :=
  row_gen_comm_twoListCorr hj b C Rl hCj

/-- Bounded two-list swap: distinct first components.
Invariant: `rowProd Rl * colProd = twoListCorr C Rl * colProd * rowProd Rl`
with `twoListCorr ∈ finiteStage n`. Tail-first, preserves `-(a*b)`. -/
public theorem lastRowList_mul_lastColumnList_swap_distinct
    {n : ℕ} (C Rl : List (Fin n × R))
    (hDisj : ∀ p ∈ C, ∀ q ∈ Rl, p.1.val ≠ q.1.val) :
    twoListCorrProd (R := R) C Rl ∈ finiteStage (R := R) n ∧
      lastRowListProd (R := R) n Rl * lastColumnListProd (R := R) n C =
        twoListCorrProd (R := R) C Rl * lastColumnListProd (R := R) n C *
          lastRowListProd (R := R) n Rl := by
  induction Rl with
  | nil =>
    constructor
    · simp only [twoListCorrProd]; exact (finiteStage n).one_mem
    · simp [lastRowListProd, twoListCorrProd]
  | cons p Rl ih =>
    have hCj : ∀ q ∈ C, q.1.val ≠ p.1.val :=
      fun q hq => hDisj q hq p List.mem_cons_self
    have hCt : ∀ q ∈ C, ∀ r ∈ Rl, q.1.val ≠ r.1.val :=
      fun q hq r hr => hDisj q hq r (List.mem_cons_of_mem _ hr)
    have ihR := ih hCt
    have hMT := ihR.1
    have hET := ihR.2
    have hOne := lastRow_mul_lastColumnList_swap_distinct
      p.1.isLt p.2 C hCj
    have hMO := hOne.1
    have hEO := hOne.2
    have hCm := row_gen_comm_twoListCorr p.1.isLt p.2 C Rl hCj
    constructor
    · simp only [twoListCorrProd]
      exact (finiteStage n).mul_mem hMT hMO
    · simp only [lastRowListProd, twoListCorrProd, mul_assoc] at *
      rw [hET, ← mul_assoc (x _ _ _ _) _ _, hCm, mul_assoc,
        ← mul_assoc (x _ _ _ _) _ _, hEO, mul_assoc, mul_assoc]

/-- Column-before-row atomic swap distinct `i≠j`, corr `x i j (a*b)`
in `finiteStage n`. Dual of row-before-col positive law. -/
public theorem lastColumn_mul_lastRow_swap_distinct
    {n i j : ℕ} (hi : i < n) (hj : j < n) (hij : i ≠ j) (a b : R) :
    x (R := R) i n (Nat.ne_of_lt hi) a *
      x n j (Ne.symm (Nat.ne_of_lt hj)) b =
      x i j hij (a * b) *
        x n j (Ne.symm (Nat.ne_of_lt hj)) b *
        x i n (Nat.ne_of_lt hi) a := by
  have hi_n : i ≠ n := Nat.ne_of_lt hi
  have hn_j : n ≠ j := Ne.symm (Nat.ne_of_lt hj)
  have h_chev : ⁅x (R := R) i n hi_n a, x n j hn_j b⁆ = x i j hij (a * b) :=
    x_chev i n j hi_n hn_j hij a b
  have h_exp : x (R := R) i n hi_n a * x n j hn_j b *
      (x (R := R) i n hi_n a)⁻¹ * (x (R := R) n j hn_j b)⁻¹ =
      x i j hij (a * b) := by simpa [commutatorElement_def] using h_chev
  calc x (R := R) i n hi_n a * x n j hn_j b
      = (x (R := R) i n hi_n a * x n j hn_j b *
        (x (R := R) i n hi_n a)⁻¹ * (x (R := R) n j hn_j b)⁻¹) *
        x n j hn_j b * x (R := R) i n hi_n a := by simp [mul_assoc]
    _ = x i j hij (a * b) * x n j hn_j b *
        x (R := R) i n hi_n a := by rw [h_exp]
/-- Ordered correction `∏ x i j (a*b)` col-before-row; `i=j`→`1`. Head-first. -/
public def corrProdCol {n : ℕ} (i : ℕ) (a : R) :
    List (Fin n × R) → StableSteinberg R
  | [] => 1
  | p :: L => if h : i ≠ p.1.val then x i p.1.val h (a * p.2) * corrProdCol i a L
      else corrProdCol i a L
private theorem corrProdCol_mem {n i : ℕ} (hi : i < n) (a : R)
    (L : List (Fin n × R)) :
    corrProdCol (R := R) i a L ∈ finiteStage (R := R) n := by
  induction L with
  | nil => exact (finiteStage n).one_mem
  | cons p L ih =>
    by_cases hp : i ≠ p.1.val
    · simp only [corrProdCol, dite_eq_left hp]
      exact (finiteStage n).mul_mem (x_mem_finiteStage hi p.1.isLt) ih
    · simp only [corrProdCol, dite_eq_right hp]
      exact ih
private theorem row_gen_comm_corrProdCol {n i j : ℕ} (hj : j < n)
    (hij : j ≠ i) (b a : R) (L : List (Fin n × R)) :
    x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b * corrProdCol (R := R) i a L =
      corrProdCol (R := R) i a L * x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b := by
  induction L with
  | nil => simp [corrProdCol]
  | cons p L ih =>
    by_cases hp : i ≠ p.1.val
    · simp only [corrProdCol, dite_eq_left hp]
      have hc : ⁅x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b,
          x i p.1.val hp (a * p.2)⁆ = 1 :=
        x_comm n j i p.1.val (Ne.symm (Nat.ne_of_lt hj)) hp
          (Ne.symm (Nat.ne_of_lt p.1.isLt)) hij b (a * p.2)
      have heq := (commutatorElement_eq_one_iff_commute.mp hc).eq
      calc x n j _ b * (x i _ _ _ * corrProdCol i a L)
          = (x n j _ b * x i _ _ _) * corrProdCol i a L := by rw [mul_assoc]
        _ = (x i _ _ _ * x n j _ b) * corrProdCol i a L := by rw [heq]
        _ = x i _ _ _ * (x n j _ b * corrProdCol i a L) := by rw [mul_assoc]
        _ = x i _ _ _ * (corrProdCol i a L * x n j _ b) := by rw [ih]
        _ = (x i _ _ _ * corrProdCol i a L) * x n j _ b := by rw [mul_assoc]
    · simp only [corrProdCol, dite_eq_right hp]
      exact ih
/-- Last-row generator `x n j b` commutes with `corrProdCol i a L` when `j < n` and `j ≠ i`.
Orientation: `x (R := R) n j b * corrProdCol (R := R) i a L =
corrProdCol (R := R) i a L * x (R := R) n j b`.
Hypotheses `hj : j < n` and `hij : j ≠ i` are required. This is a commutation equality
only—not normality, membership, collection, landing, kernel, or Matsumoto.
Generic over `[Ring R]` and characteristic-two safe. -/
public theorem lastRowGenerator_comm_corrProdCol {n i j : ℕ} (hj : j < n)
    (hij : j ≠ i) (b a : R) (L : List (Fin n × R)) :
    x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b * corrProdCol (R := R) i a L =
      corrProdCol (R := R) i a L * x (R := R) n j (Ne.symm (Nat.ne_of_lt hj)) b :=
  row_gen_comm_corrProdCol hj hij b a L

private theorem col_gen_comm_corrProdCol {n i i' : ℕ} (hi : i < n)
    (hi' : i' < n) (a a' : R) (Rl : List (Fin n × R))
    (hDisj : ∀ q ∈ Rl, q.1.val ≠ i) :
    x (R := R) i n (Nat.ne_of_lt hi) a * corrProdCol (R := R) i' a' Rl =
      corrProdCol (R := R) i' a' Rl * x (R := R) i n (Nat.ne_of_lt hi) a := by
  induction Rl with
  | nil => simp [corrProdCol]
  | cons p Rl ih =>
    have hq : p.1.val ≠ i := hDisj _ List.mem_cons_self
    have hT : ∀ q ∈ Rl, q.1.val ≠ i := fun q hq' => hDisj q (List.mem_cons_of_mem _ hq')
    by_cases hp' : i' ≠ p.1.val
    · simp only [corrProdCol, dite_eq_left hp']
      have hc : ⁅x (R := R) i n (Nat.ne_of_lt hi) a,
          x i' p.1.val hp' (a' * p.2)⁆ = 1 :=
        x_comm i n i' p.1.val (Nat.ne_of_lt hi) hp' (Ne.symm hq)
          (Ne.symm (Nat.ne_of_lt hi')) a (a' * p.2)
      have heq := (commutatorElement_eq_one_iff_commute.mp hc).eq
      calc x i n _ a * (x i' _ _ _ * corrProdCol i' a' Rl)
          = (x i n _ a * x i' _ _ _) * corrProdCol i' a' Rl := by rw [mul_assoc]
        _ = (x i' _ _ _ * x i n _ a) * corrProdCol i' a' Rl := by rw [heq]
        _ = x i' _ _ _ * (x i n _ a * corrProdCol i' a' Rl) := by rw [mul_assoc]
        _ = x i' _ _ _ * (corrProdCol i' a' Rl * x i n _ a) := by rw [ih hT]
        _ = (x i' _ _ _ * corrProdCol i' a' Rl) * x i n _ a := by rw [mul_assoc]
    · simp only [corrProdCol, dite_eq_right hp']
      exact ih hT
/-- Last-column generator `x i n a` commutes with `corrProdCol i' a' Rl` when `i < n`,
`i' < n`, and every `q ∈ Rl` satisfies `q.1.val ≠ i`.
Orientation: `x (R := R) i n (Nat.ne_of_lt hi) a * corrProdCol (R := R) i' a' Rl =
corrProdCol (R := R) i' a' Rl * x (R := R) i n (Nat.ne_of_lt hi) a`.
Hypotheses `hi : i < n`, `hi' : i' < n`, and `hDisj : ∀ q ∈ Rl, q.1.val ≠ i` are
required. This is a commutation equality only—not normality, membership, collection,
landing, kernel, or Matsumoto. Generic over `[Ring R]` and characteristic-two safe. -/
public theorem lastColumnGenerator_comm_corrProdCol {n i i' : ℕ} (hi : i < n)
    (hi' : i' < n) (a a' : R) (Rl : List (Fin n × R))
    (hDisj : ∀ q ∈ Rl, q.1.val ≠ i) :
    x (R := R) i n (Nat.ne_of_lt hi) a * corrProdCol (R := R) i' a' Rl =
      corrProdCol (R := R) i' a' Rl * x (R := R) i n (Nat.ne_of_lt hi) a :=
  col_gen_comm_corrProdCol hi hi' a a' Rl hDisj

/-- One-sided list swap col before row list distinct. -/
public theorem lastColumn_mul_lastRowList_swap_distinct
    {n i : ℕ} (hi : i < n) (a : R) (Rl : List (Fin n × R))
    (hDisj : ∀ p ∈ Rl, p.1.val ≠ i) :
    corrProdCol (R := R) i a Rl ∈ finiteStage (R := R) n ∧
      x (R := R) i n (Nat.ne_of_lt hi) a * lastRowListProd (R := R) n Rl =
        corrProdCol (R := R) i a Rl * lastRowListProd (R := R) n Rl *
          x (R := R) i n (Nat.ne_of_lt hi) a := by
  constructor
  · exact corrProdCol_mem hi a Rl
  · revert hDisj; induction Rl with
    | nil => intro _; simp [lastRowListProd, corrProdCol]
    | cons p Rl ih =>
      intro hDisj
      have hp : p.1.val ≠ i := hDisj _ List.mem_cons_self
      have hT : ∀ q ∈ Rl, q.1.val ≠ i := fun q hq => hDisj q (List.mem_cons_of_mem _ hq)
      have ih_eq := ih hT
      have h_row : lastRowListProd (R := R) n (p :: Rl) =
          x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2 * lastRowListProd n Rl := rfl
      have h_corr : corrProdCol (R := R) i a (p :: Rl) =
          x i p.1.val (Ne.symm hp) (a * p.2) * corrProdCol i a Rl := by
        simp [corrProdCol, Ne.symm hp]
      have h_at := lastColumn_mul_lastRow_swap_distinct hi p.1.isLt (Ne.symm hp) a p.2
      have h_comm := row_gen_comm_corrProdCol p.1.isLt hp p.2 a Rl
      calc x (R := R) i n (Nat.ne_of_lt hi) a * lastRowListProd n (p :: Rl)
          = (x (R := R) i n (Nat.ne_of_lt hi) a *
            x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2) * lastRowListProd n Rl := by
            simp [h_row, mul_assoc]
        _ = (x i p.1.val (Ne.symm hp) (a * p.2) *
            x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2 *
            x (R := R) i n (Nat.ne_of_lt hi) a) * lastRowListProd n Rl := by rw [h_at]
        _ = x i p.1.val (Ne.symm hp) (a * p.2) *
            x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2 *
            (x (R := R) i n (Nat.ne_of_lt hi) a * lastRowListProd n Rl) := by
            simp only [mul_assoc]
        _ = x i p.1.val (Ne.symm hp) (a * p.2) *
            x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2 *
            (corrProdCol i a Rl * lastRowListProd n Rl *
              x (R := R) i n (Nat.ne_of_lt hi) a) := by rw [ih_eq]
        _ = x i p.1.val (Ne.symm hp) (a * p.2) *
            (x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2 * corrProdCol i a Rl) *
            lastRowListProd n Rl * x (R := R) i n (Nat.ne_of_lt hi) a := by
            simp only [mul_assoc]
        _ = x i p.1.val (Ne.symm hp) (a * p.2) *
            (corrProdCol i a Rl * x n p.1.val (Ne.symm (Nat.ne_of_lt p.1.isLt)) p.2) *
            lastRowListProd n Rl * x (R := R) i n (Nat.ne_of_lt hi) a := by rw [h_comm]
        _ = corrProdCol (R := R) i a (p :: Rl) *
            lastRowListProd (R := R) n (p :: Rl) *
            x (R := R) i n (Nat.ne_of_lt hi) a := by rw [h_corr, h_row]; simp only [mul_assoc]
/-- Tail-first `∏ corrProdCol` over column list `C` with row list `Rl`. `i=j`→`1`. -/
public def twoListCorrCol {n : ℕ} (Rl : List (Fin n × R)) :
    List (Fin n × R) → StableSteinberg R
  | [] => 1
  | q :: Cs => twoListCorrCol Rl Cs * corrProdCol q.1.val q.2 Rl
private theorem twoListCorrCol_mem {n : ℕ} (Rl C : List (Fin n × R)) :
    twoListCorrCol (R := R) Rl C ∈ finiteStage (R := R) n := by
  induction C with
  | nil => simp [twoListCorrCol, finiteStage]
  | cons q Cs ih =>
    simp only [twoListCorrCol]
    exact (finiteStage n).mul_mem ih (corrProdCol_mem q.1.isLt q.2 Rl)
private theorem col_gen_comm_twoListCorrCol {n i : ℕ} (hi : i < n) (a : R)
    (Rl Cs : List (Fin n × R)) (hDisj : ∀ q ∈ Rl, q.1.val ≠ i) :
    x (R := R) i n (Nat.ne_of_lt hi) a * twoListCorrCol (R := R) Rl Cs =
      twoListCorrCol (R := R) Rl Cs * x (R := R) i n (Nat.ne_of_lt hi) a := by
  induction Cs with
  | nil => simp [twoListCorrCol]
  | cons q Cs ih =>
    simp only [twoListCorrCol]
    have h1 := ih
    have h2 := col_gen_comm_corrProdCol hi q.1.isLt a q.2 Rl hDisj
    calc x i n _ a * (twoListCorrCol Rl Cs * corrProdCol _ _ Rl)
        = (x i n _ a * twoListCorrCol Rl Cs) * corrProdCol _ _ Rl := by rw [mul_assoc]
      _ = (twoListCorrCol Rl Cs * x i n _ a) * corrProdCol _ _ Rl := by rw [h1]
      _ = twoListCorrCol Rl Cs * (x i n _ a * corrProdCol _ _ Rl) := by rw [mul_assoc]
      _ = twoListCorrCol Rl Cs * (corrProdCol _ _ Rl * x i n _ a) := by rw [h2]
      _ = (twoListCorrCol Rl Cs * corrProdCol _ _ Rl) * x i n _ a := by rw [mul_assoc]
/-- Last-column generator `x i n a` commutes with `twoListCorrCol Rl Cs` when `i < n`
and every `q ∈ Rl` satisfies `q.1.val ≠ i`.
Orientation: `x (R := R) i n a * twoListCorrCol (R := R) Rl Cs =
twoListCorrCol (R := R) Rl Cs * x (R := R) i n a`.
Hypotheses `hi : i < n` and disjointness `hDisj` are required. This is a commutation
equality only—not normality, membership, collection, landing, kernel, or Matsumoto.
Generic over `[Ring R]` and characteristic-two safe. -/
public theorem lastColumnGenerator_comm_twoListCorrCol {n i : ℕ} (hi : i < n) (a : R)
    (Rl Cs : List (Fin n × R)) (hDisj : ∀ q ∈ Rl, q.1.val ≠ i) :
    x (R := R) i n (Nat.ne_of_lt hi) a * twoListCorrCol (R := R) Rl Cs =
      twoListCorrCol (R := R) Rl Cs * x (R := R) i n (Nat.ne_of_lt hi) a :=
  col_gen_comm_twoListCorrCol hi a Rl Cs hDisj

/-- Bounded two-list swap distinct col-before-row, corr in `finiteStage n`.
Tail-first, `a*b`. No global normal form. -/
public theorem lastColumnList_mul_lastRowList_swap_distinct
    {n : ℕ} (C Rl : List (Fin n × R)) (hDisj : ∀ p ∈ C, ∀ q ∈ Rl, p.1.val ≠ q.1.val) :
    twoListCorrCol (R := R) Rl C ∈ finiteStage (R := R) n ∧
      lastColumnListProd (R := R) n C * lastRowListProd (R := R) n Rl =
        twoListCorrCol (R := R) Rl C * lastRowListProd (R := R) n Rl *
          lastColumnListProd (R := R) n C := by
  induction C with
  | nil =>
    constructor
    · simp [twoListCorrCol, finiteStage]
    · simp [lastColumnListProd, twoListCorrCol]
  | cons q Cs ih =>
    have hQR : ∀ r ∈ Rl, r.1.val ≠ q.1.val :=
      fun r hr => Ne.symm (hDisj q List.mem_cons_self r hr)
    have hCs : ∀ p ∈ Cs, ∀ r ∈ Rl, p.1.val ≠ r.1.val :=
      fun p hp r hr => hDisj p (List.mem_cons_of_mem _ hp) r hr
    have ihR := ih hCs; have hMT := ihR.1; have hET := ihR.2
    have hOne := lastColumn_mul_lastRowList_swap_distinct q.1.isLt q.2 Rl hQR
    have hMO := hOne.1; have hEO := hOne.2
    have hCm := col_gen_comm_twoListCorrCol q.1.isLt q.2 Rl Cs hQR
    constructor
    · simp only [twoListCorrCol]; exact (finiteStage n).mul_mem hMT hMO
    · simp only [lastColumnListProd, twoListCorrCol, mul_assoc] at *
      rw [hET, ← mul_assoc (x _ _ _ _) _ _, hCm, mul_assoc,
        ← mul_assoc (x _ _ _ _) _ _, hEO, mul_assoc, mul_assoc]

/-- Column-row-column collapse with distinct first coordinates.
Uses `lastColumnList_mul_lastRowList_swap_distinct` on `C₁` and `Rl`,
associativity, and `C = C₁ ++ C₂`; append identity for
`lastColumnListProd` proved locally. No Pi-level normal form. -/
public theorem lastColumnList_mul_lastRowList_mul_lastColumnList_collapse_distinct
    {n : ℕ} (C₁ Rl C₂ : List (Fin n × R))
    (hC₁ : ∀ p ∈ C₁, ∀ q ∈ Rl, p.1.val ≠ q.1.val) :
    ∃ f ∈ finiteStage (R := R) n, ∃ C : List (Fin n × R),
      lastColumnListProd (R := R) n C₁ * lastRowListProd (R := R) n Rl *
        lastColumnListProd (R := R) n C₂ =
        f * lastRowListProd (R := R) n Rl * lastColumnListProd (R := R) n C := by
  have hSwap := lastColumnList_mul_lastRowList_swap_distinct (R := R) C₁ Rl hC₁
  let f := twoListCorrCol (R := R) Rl C₁
  have hf_mem : f ∈ finiteStage (R := R) n := hSwap.1
  have hf_eq : lastColumnListProd (R := R) n C₁ * lastRowListProd (R := R) n Rl =
      f * lastRowListProd (R := R) n Rl * lastColumnListProd (R := R) n C₁ := hSwap.2
  have hAppend : lastColumnListProd (R := R) n (C₁ ++ C₂) =
      lastColumnListProd (R := R) n C₁ * lastColumnListProd (R := R) n C₂ := by
    suffices h : ∀ (l₁ l₂ : List (Fin n × R)),
        lastColumnListProd (R := R) n (l₁ ++ l₂) =
        lastColumnListProd (R := R) n l₁ * lastColumnListProd (R := R) n l₂ from
      h C₁ C₂
    intro l₁ l₂
    induction l₁ with
    | nil => simp [lastColumnListProd]
    | cons q Cs ih => simp [lastColumnListProd, ih, mul_assoc]
  refine ⟨f, hf_mem, C₁ ++ C₂, ?_⟩
  calc lastColumnListProd (R := R) n C₁ * lastRowListProd (R := R) n Rl *
        lastColumnListProd (R := R) n C₂
      = (lastColumnListProd (R := R) n C₁ * lastRowListProd (R := R) n Rl) *
        lastColumnListProd (R := R) n C₂ := by rw [mul_assoc]
    _ = (f * lastRowListProd (R := R) n Rl * lastColumnListProd (R := R) n C₁) *
        lastColumnListProd (R := R) n C₂ := by rw [hf_eq]
    _ = f * lastRowListProd (R := R) n Rl *
        (lastColumnListProd (R := R) n C₁ * lastColumnListProd (R := R) n C₂) := by
        simp only [mul_assoc]
    _ = f * lastRowListProd (R := R) n Rl *
        lastColumnListProd (R := R) n (C₁ ++ C₂) := by rw [← hAppend]

/-- Alternating boundary block for `finiteStage (n+1)`:
last-column or last-row product. Alphabet for explicit finite
alternating word for any `g ∈ finiteStage (n+1)`. No global
`finiteStage * column * row` normal form; fails for opposite
roots at `n = 1`. -/
@[expose]
public def lastBoundaryBlock (n : ℕ) :
    Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R) →
      StableSteinberg R
  | Sum.inl c => lastColumnProduct n c
  | Sum.inr r => lastRowProduct n r

/-- `lastBoundaryBlock` on `Sum.inl c` equals `lastColumnProduct n c`. -/
@[simp]
public theorem lastBoundaryBlock_inl (n : ℕ)
    (c : (i : Fin n) → Multiplicative R) :
    lastBoundaryBlock n (Sum.inl c) = lastColumnProduct n c := rfl

/-- `lastBoundaryBlock` on `Sum.inr r` equals `lastRowProduct n r`. -/
@[simp]
public theorem lastBoundaryBlock_inr (n : ℕ)
    (r : (i : Fin n) → Multiplicative R) :
    lastBoundaryBlock n (Sum.inr r) = lastRowProduct n r := rfl
private def boundaryBlockInv {n : ℕ} :
    Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R) →
    Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R)
  | Sum.inl c => Sum.inl c⁻¹
  | Sum.inr r => Sum.inr r⁻¹
private theorem lastColumnProduct_inv (n : ℕ)
    (c : (i : Fin n) → Multiplicative R) :
    lastColumnProduct (R := R) n c⁻¹ =
      (lastColumnProduct n c)⁻¹ :=
  map_inv (lastColumnProduct (R := R) n) c
private theorem lastRowProduct_inv (n : ℕ)
    (r : (i : Fin n) → Multiplicative R) :
    lastRowProduct (R := R) n r⁻¹ =
      (lastRowProduct n r)⁻¹ :=
  map_inv (lastRowProduct (R := R) n) r
private theorem lastBoundaryBlock_inv (n : ℕ)
    (b : Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R)) :
    lastBoundaryBlock (R := R) n (boundaryBlockInv b) =
      (lastBoundaryBlock n b)⁻¹ := by
  cases b <;> simp [lastBoundaryBlock, boundaryBlockInv,
    lastColumnProduct_inv, lastRowProduct_inv]
private def revInvBlocks {n : ℕ} :
    List (Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R)) →
    List (Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R))
  | [] => []
  | b :: L => revInvBlocks L ++ [boundaryBlockInv b]
private theorem revInvBlocks_map_prod_inv {n : ℕ}
    (L : List (Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R))) :
    ((revInvBlocks L).map (lastBoundaryBlock (R := R) n)).prod =
      ((L.map (lastBoundaryBlock n)).prod)⁻¹ := by
  induction L with
  | nil => simp [revInvBlocks]
  | cons b L ih =>
    simp only [revInvBlocks, List.map_append, List.prod_append,
      List.map_cons, List.prod_cons, lastBoundaryBlock_inv]
    rw [ih, mul_inv_rev]
    simp
/-- Alternating boundary-block word for `g ∈ finiteStage (n+1)`.
Finite alternation of column/row blocks, `n=0` gives `1`. Uses
`finiteStage_succ_eq_sup_lastColumnRow`, `sup_eq_closure`,
`lastColumnProduct_range`, `lastRowProduct_range` with closure
induction; avoids commutative `mem_sup`, normality, unconditional
swaps. Inverses stay inside same side. No global
`finiteStage * column * row` normal form. -/
public theorem finiteStage_succ_exists_lastBoundaryBlocks {n : ℕ}
    {g : StableSteinberg R} (hg : g ∈ finiteStage (R := R) (n + 1)) :
    ∃ L : List (Sum ((i : Fin n) → Multiplicative R)
      ((i : Fin n) → Multiplicative R)),
      (L.map (lastBoundaryBlock (R := R) n)).prod = g := by
  have h_eq := finiteStage_succ_eq_sup_lastColumnRow (R := R) n
  have h_sup := Subgroup.sup_eq_closure
    (lastColumnSubgroup (R := R) n) (lastRowSubgroup (R := R) n)
  rw [h_eq, h_sup] at hg
  let f := lastBoundaryBlock (R := R) n
  let P : StableSteinberg R → Prop :=
    fun x =>
      ∃ L : List (Sum ((i : Fin n) → Multiplicative R)
          ((i : Fin n) → Multiplicative R)),
        (L.map f).prod = x
  have hP : P g := by
    apply Subgroup.closure_induction (p := fun x _ => P x) _ _ _ _ hg
    · intro x hx
      rcases hx with hxC | hxR
      · have hxRg : x ∈ (lastColumnProduct (R := R) n).range := by
          rw [lastColumnProduct_range]; exact hxC
        obtain ⟨c, hc⟩ := MonoidHom.mem_range.mp hxRg
        exact ⟨[Sum.inl c], by simp [f, lastBoundaryBlock, hc]⟩
      · have hxRg : x ∈ (lastRowProduct (R := R) n).range := by
          rw [lastRowProduct_range]; exact hxR
        obtain ⟨r, hr⟩ := MonoidHom.mem_range.mp hxRg
        exact ⟨[Sum.inr r], by simp [f, lastBoundaryBlock, hr]⟩
    · exact ⟨[], by simp [f]⟩
    · intro x y _ _ hxI hyI
      obtain ⟨Lx, hLx⟩ := hxI; obtain ⟨Ly, hLy⟩ := hyI
      exact ⟨Lx ++ Ly, by
        rw [List.map_append, List.prod_append, hLx, hLy]⟩
    · intro x _ hxI
      obtain ⟨L, hL⟩ := hxI
      exact ⟨revInvBlocks L, by rw [revInvBlocks_map_prod_inv, hL]⟩
  exact hP

end StableSteinberg

end AlgebraicKTheory
