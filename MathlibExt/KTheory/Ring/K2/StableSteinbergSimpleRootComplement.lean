module

public import MathlibExt.KTheory.Ring.K2.StableSteinbergUpperUnipotent
public import MathlibExt.KTheory.Ring.K2.StableSteinbergFiniteWeylTorus

/-! # Finite Borel and simple-root complement

For a field `F` and finite rank `n`, the finite Borel subgroup as the join of
`upperUnipotentSubgroup n` with `finiteTorusSubgroup n`, the simple-root
subgroup generated by `x m (m + 1)`, and the simple-root complement generated
by all remaining positive roots below `n`.

Proves: every finite-torus element normalizes the upper-unipotent subgroup
(closure induction over torus and positive-root generators, six public
`torus_conj_x_*` cases plus an inline disjoint-support `x_comm` calculation);
the Borel product form `b = u * h` and `Borel ≤ finiteStage`; both the simple
root and its complement lie in the upper subgroup when `m + 1 < n`; the
complement is normalized by the full upper subgroup (only `x_comm`, `x_chev`,
`x_add`); every upper element factors as simple part times complement part
(existence only, no uniqueness); and conjugation by `weyl m (m + 1) 1` sends
the complement into the upper subgroup (four shared-index `weyl_conj_x_*`
patterns plus disjoint `x_comm`, all indices `< n` explicit).

Orientation: conjugation is always `c * y * c⁻¹` (conjugator on the left).
Hypotheses are always `m + 1 < n` for simple-root statements and no extra
hypothesis for Borel statements. Nonclaims: no quotient, Bruhat cell,
double-coset set, Weyl-on-torus transport, Lemma 24 subgroup, uniqueness of
the simple/complement factorization, or Matsumoto claim.
-/

namespace AlgebraicKTheory

namespace StableSteinberg

universe u

variable {F : Type u} [Field F]

open scoped commutatorElement

/-- Proof-irrelevance for `x`: different `≠` witnesses give the same generator. -/
private theorem x_eq_of_hij' {i j : ℕ} {hij hij' : i ≠ j} {a : F} :
    x (R := F) i j hij a = x (R := F) i j hij' a := by
  have h : hij = hij' := Subsingleton.elim hij hij'
  subst h
  rfl

/-- Finite Borel subgroup: join of the finite upper-unipotent and finite torus
subgroups. Purpose: finite-rank Borel carrier for Steinberg Lemmas 21--26.
Nonclaim: no Bruhat cell, quotient, or Matsumoto claim. -/
public def finiteBorelSubgroup (n : ℕ) : Subgroup (StableSteinberg F) :=
  upperUnipotentSubgroup (R := F) n ⊔ finiteTorusSubgroup (R := F) n

/-- Simple-root subgroup: closure of `x m (m + 1) a` over all `a`.
Purpose: the single excluded simple root of Lemma 17 / Corollary 5.
Nonclaim: no complement, quotient, or uniqueness claim. -/
public def simpleRootSubgroup (m : ℕ) : Subgroup (StableSteinberg F) :=
  Subgroup.closure
    { g | ∃ a : F, g = x (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m)) a }

/-- Simple-root complement: closure of all positive roots `x i j a` with
`i < j < n` except `(m, m + 1)`. Purpose: the `R = P - {a}` factor of
Corollary 5. Nonclaim: no quotient, uniqueness, or Bruhat claim. -/
public def simpleRootComplementSubgroup (n m : ℕ) : Subgroup (StableSteinberg F) :=
  Subgroup.closure
    { g | ∃ (i j : ℕ) (hij : i ≠ j) (a : F),
      g = x (R := F) i j hij a ∧ i < j ∧ i < n ∧ j < n ∧ ¬(i = m ∧ j = m + 1) }

/-- Generator membership for the simple root. -/
public theorem x_mem_simpleRootSubgroup (m : ℕ) (a : F) :
    x (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m)) a ∈
      simpleRootSubgroup (F := F) m := by
  apply Subgroup.subset_closure
  exact ⟨a, rfl⟩

/-- Generator membership for the complement. -/
public theorem x_mem_simpleRootComplementSubgroup {n m i j : ℕ} (hij : i ≠ j)
    (hlt : i < j) (hi : i < n) (hj : j < n) (hne : ¬(i = m ∧ j = m + 1)) (a : F) :
    x (R := F) i j hij a ∈ simpleRootComplementSubgroup (F := F) n m := by
  apply Subgroup.subset_closure
  exact ⟨i, j, hij, a, rfl, hlt, hi, hj, hne⟩

/-- The finite upper-unipotent subgroup lies in the finite Borel subgroup.
Purpose: left join inclusion for Lemma-24 two-cell arguments.
Hypotheses: none beyond the rank `n`. Orientation: `upper ≤ Borel`.
Nonclaim: no quotient, Bruhat, or Matsumoto claim. -/
public theorem upperUnipotentSubgroup_le_finiteBorelSubgroup (n : ℕ) :
    upperUnipotentSubgroup (R := F) n ≤ finiteBorelSubgroup (F := F) n :=
  le_sup_left

/-- The finite torus subgroup lies in the finite Borel subgroup.
Purpose: right join inclusion for Lemma-24 two-cell arguments.
Hypotheses: none beyond the rank `n`. Orientation: `torus ≤ Borel`.
Nonclaim: no quotient, Bruhat, or Matsumoto claim. -/
public theorem finiteTorusSubgroup_le_finiteBorelSubgroup (n : ℕ) :
    finiteTorusSubgroup (R := F) n ≤ finiteBorelSubgroup (F := F) n :=
  le_sup_right

/-- Every simple-root-subgroup element is a single `x m (m + 1)` generator.
Purpose: single-generator elimination for Lemma-24 two-cell arguments.
Hypotheses: membership in `simpleRootSubgroup m`; no rank bound.
Orientation: `g = x m (m + 1) _ a`. Nonclaim: no complement, uniqueness,
quotient, or Bruhat claim. -/
public theorem simpleRootSubgroup_exists_eq_x (m : ℕ) {g : StableSteinberg F}
    (hg : g ∈ simpleRootSubgroup (F := F) m) :
    ∃ a : F, g = x (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m)) a := by
  induction hg using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨a, rfl⟩ := hy
    exact ⟨a, rfl⟩
  | one =>
    exact ⟨0, (x_zero (R := F) _ _ _).symm⟩
  | mul g1 g2 _ _ ih1 ih2 =>
    obtain ⟨a, rfl⟩ := ih1
    obtain ⟨b, rfl⟩ := ih2
    exact ⟨a + b, x_add (R := F) _ _ _ a b⟩
  | inv g _ ih =>
    obtain ⟨a, rfl⟩ := ih
    exact ⟨-a, (x_neg (R := F) _ _ _ a).symm⟩

section BorelNormalization

/-- Torus generator commutes with a disjoint positive root: inline
disjoint-support calculation from `x_comm` only. If `{i, j} ∩ {p, q} = ∅`
then each `x`-factor of `torus i j u` commutes with `x p q a`,
so the torus commutes with it. Orientation: `torus * x = x * torus`. -/
private theorem torus_comm_of_disjoint_general {i j p q : ℕ} (hij : i ≠ j)
    (hpq : p ≠ q) (hip : i ≠ p) (hiq : i ≠ q) (hjp : j ≠ p) (hjq : j ≠ q)
    (u : Fˣ) (a : F) :
    Commute (torus (R := F) i j hij u) (x (R := F) p q hpq a) := by
  have h_comm_ij : Commute (x (R := F) i j hij (↑u : F))
      (x (R := F) p q hpq a) := by
    rw [commute_iff_eq]
    have h := x_comm (R := F) i j p q hij hpq hiq hjp (↑u : F) a
    exact (commutatorElement_eq_one_iff_commute.mp h).eq
  have h_comm_ji : Commute (x (R := F) j i hij.symm (-(↑u⁻¹ : F)))
      (x (R := F) p q hpq a) := by
    rw [commute_iff_eq]
    have h := x_comm (R := F) j i p q hij.symm hpq hjq hip (-(↑u⁻¹ : F)) a
    exact (commutatorElement_eq_one_iff_commute.mp h).eq
  have h_coe_neg1 : ((-1 : Fˣ) : F) = (-1 : F) := by simp
  have h_inv_neg1 : (-(↑(-1 : Fˣ)⁻¹ : F)) = (1 : F) := by
    have h : (-1 : Fˣ)⁻¹ = (-1 : Fˣ) := by ext; simp
    rw [h, h_coe_neg1, neg_neg]
  have h_comm_ij1 : Commute (x (R := F) i j hij (-1 : F))
      (x (R := F) p q hpq a) := by
    rw [commute_iff_eq]
    have h := x_comm (R := F) i j p q hij hpq hiq hjp (-1 : F) a
    exact (commutatorElement_eq_one_iff_commute.mp h).eq
  have h_comm_ji1 : Commute (x (R := F) j i hij.symm (1 : F))
      (x (R := F) p q hpq a) := by
    rw [commute_iff_eq]
    have h := x_comm (R := F) j i p q hij.symm hpq hjq hip (1 : F) a
    exact (commutatorElement_eq_one_iff_commute.mp h).eq
  have hWu : Commute (weyl (R := F) i j hij u)
      (x (R := F) p q hpq a) := by
    unfold weyl
    have h1 : Commute (x (R := F) i j hij (↑u : F) *
        x (R := F) j i hij.symm (-(↑u⁻¹ : F)))
        (x (R := F) p q hpq a) :=
      Commute.mul_left h_comm_ij h_comm_ji
    exact Commute.mul_left h1 h_comm_ij
  have hWm : Commute (weyl (R := F) i j hij (-1 : Fˣ))
      (x (R := F) p q hpq a) := by
    unfold weyl
    rw [h_coe_neg1, h_inv_neg1]
    have h1 : Commute (x (R := F) i j hij (-1 : F) *
        x (R := F) j i hij.symm (1 : F))
        (x (R := F) p q hpq a) :=
      Commute.mul_left h_comm_ij1 h_comm_ji1
    exact Commute.mul_left h1 h_comm_ij1
  unfold torus
  exact Commute.mul_left hWu hWm

/-- Forward torus-generator conjugation of a positive root stays upper.
Uses the six public `torus_conj_x_*` cases; the disjoint case is the inline
`x_comm` commute above. Every output root keeps both indices `< n`.
Orientation: `torus * x * torus⁻¹`. -/
private theorem torus_conj_positive_mem_upper {n i j p q : ℕ} (hij : i ≠ j)
    (hpq : p ≠ q) (hi : i < n) (hj : j < n) (hp : p < q) (hq : q < n)
    (u : Fˣ) (a : F) :
    torus (R := F) i j hij u * x (R := F) p q hpq a *
      (torus (R := F) i j hij u)⁻¹ ∈ upperUnipotentSubgroup (R := F) n := by
  have hp_lt_n : p < n := Nat.lt_trans hp hq
  by_cases h1 : p = i ∧ q = j
  · obtain ⟨rfl, rfl⟩ := h1
    -- After subst `i, j` are eliminated; remaining `p, q` with `hp : p < q`.
    have h_conj := torus_conj_x_ij (F := F) p q hpq u a
    rw [h_conj]
    exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
  · by_cases h2 : p = j ∧ q = i
    · obtain ⟨rfl, rfl⟩ := h2
      -- Remaining `p, q`; torus is now `torus q p`, root `x p q`.
      have h_conj := torus_conj_x_ji (F := F) q p hpq.symm u a
      -- `torus_conj_x_ji` with `(i := q) (j := p)` concludes `x p q`.
      have h_eq : torus (R := F) q p hpq.symm u * x (R := F) p q hpq a *
          (torus (R := F) q p hpq.symm u)⁻¹ =
          x (R := F) p q hpq ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) := h_conj
      rw [h_eq]
      exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
    · by_cases h3 : p = i
      · subst h3
        -- Remaining `p, j, q`; `hij : p ≠ j`, torus `torus p j`, root `x p q`.
        have hq_ne_j : q ≠ j := fun hqj => h1 ⟨rfl, hqj⟩
        have hjq : j ≠ q := Ne.symm hq_ne_j
        have h_conj := torus_conj_x_ik (R := F) p j q hij hjq hpq u a
        rw [h_conj]
        exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
      · by_cases h4 : p = j
        · subst h4
          -- Remaining `p, i, q`; `hij : i ≠ p`, torus `torus i p`, root `x p q`.
          have hq_ne_i : q ≠ i := fun hqi => h2 ⟨rfl, hqi⟩
          have hiq : i ≠ q := Ne.symm hq_ne_i
          have h_conj := torus_conj_x_jk (R := F) i p q hij hpq hiq u a
          rw [h_conj]
          exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
        · by_cases h5 : q = i
          · subst h5
            -- Remaining `p, q, j`; `hij : q ≠ j`, torus `torus q j`, root `x p q`.
            have hj_ne_p : j ≠ p := fun hjp => h4 hjp.symm
            have hi_ne_p : q ≠ p := (ne_of_lt hp).symm
            have h_conj := torus_conj_x_ki (R := F) q j p hij hj_ne_p hi_ne_p u a
            rw [h_conj]
            exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
          · by_cases h6 : q = j
            · subst h6
              -- Remaining `p, q, i`; `hij : i ≠ q`, torus `torus i q`, root `x p q`.
              have hi_ne_p : i ≠ p := fun hip => h3 hip.symm
              have hqp : q ≠ p := (ne_of_lt hp).symm
              have h_conj := torus_conj_x_kj (R := F) i q p hij hqp hi_ne_p u a
              rw [h_conj]
              exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
            · have hip : i ≠ p := fun hip => h3 hip.symm
              have hiq : i ≠ q := fun hiq => h5 hiq.symm
              have hjp : j ≠ p := fun hjp => h4 hjp.symm
              have hjq : j ≠ q := fun hjq => h6 hjq.symm
              have h_comm := torus_comm_of_disjoint_general (F := F) hij hpq
                hip hiq hjp hjq u a
              have h_eq : torus (R := F) i j hij u * x (R := F) p q hpq a *
                  (torus (R := F) i j hij u)⁻¹ = x (R := F) p q hpq a :=
                h_comm.mul_inv_cancel
              rw [h_eq]
              exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _

/-- Inverse torus-generator conjugation of a positive root stays upper.
For each of the six scaling patterns the preimage coefficient is inverse
rescaling; the disjoint case uses the inverse commute. Every output root
keeps both indices `< n`. Orientation: `torus⁻¹ * x * torus`. -/
private theorem torus_inv_conj_positive_mem_upper {n i j p q : ℕ} (hij : i ≠ j)
    (hpq : p ≠ q) (hi : i < n) (hj : j < n) (hp : p < q) (hq : q < n)
    (u : Fˣ) (a : F) :
    (torus (R := F) i j hij u)⁻¹ * x (R := F) p q hpq a *
      torus (R := F) i j hij u ∈ upperUnipotentSubgroup (R := F) n := by
  have hp_lt_n : p < n := Nat.lt_trans hp hq
  have hU : (↑u : F) * (↑u⁻¹ : F) = 1 := by simp
  have hUinv : (↑u⁻¹ : F) * (↑u : F) = 1 := by simp
  by_cases h1 : p = i ∧ q = j
  · obtain ⟨rfl, rfl⟩ := h1
    -- Remaining `p, q`; torus `torus p q`, root `x p q`.
    have h_forward : torus (R := F) p q hpq u *
          x (R := F) p q hpq ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) *
          (torus (R := F) p q hpq u)⁻¹ =
        x (R := F) p q hpq a := by
      have h_conj := torus_conj_x_ij (F := F) p q hpq u
        ((↑u⁻¹ : F) * a * (↑u⁻¹ : F))
      have h_scale : (↑u : F) * ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) * (↑u : F) = a := by
        calc (↑u : F) * ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) * (↑u : F)
            = ((↑u : F) * (↑u⁻¹ : F)) * a * ((↑u⁻¹ : F) * (↑u : F)) := by ring
          _ = 1 * a * 1 := by rw [hU, hUinv]
          _ = a := by rw [one_mul, mul_one]
      calc torus (R := F) p q hpq u *
            x (R := F) p q hpq ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) *
            (torus (R := F) p q hpq u)⁻¹
          = x (R := F) p q hpq
              ((↑u : F) * ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) * (↑u : F)) := h_conj
        _ = x (R := F) p q hpq a := by rw [h_scale]
    have h_eq : (torus (R := F) p q hpq u)⁻¹ * x (R := F) p q hpq a *
          torus (R := F) p q hpq u =
        x (R := F) p q hpq ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) := by
      calc (torus (R := F) p q hpq u)⁻¹ * x (R := F) p q hpq a *
            torus (R := F) p q hpq u
          = (torus (R := F) p q hpq u)⁻¹ *
              (torus (R := F) p q hpq u *
                x (R := F) p q hpq ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) *
                (torus (R := F) p q hpq u)⁻¹) *
              torus (R := F) p q hpq u := by
            rw [h_forward]
        _ = x (R := F) p q hpq ((↑u⁻¹ : F) * a * (↑u⁻¹ : F)) := by
            simp [mul_assoc]
    rw [h_eq]
    exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
  · by_cases h2 : p = j ∧ q = i
    · obtain ⟨rfl, rfl⟩ := h2
      -- Remaining `p, q`; torus `torus q p`, root `x p q`.
      have h_forward : torus (R := F) q p hpq.symm u *
          x (R := F) p q hpq ((↑u : F) * a * (↑u : F)) *
          (torus (R := F) q p hpq.symm u)⁻¹ =
          x (R := F) p q hpq a := by
        have h_conj := torus_conj_x_ji (F := F) q p hpq.symm u
          ((↑u : F) * a * (↑u : F))
        have h_scale : (↑u⁻¹ : F) * ((↑u : F) * a * (↑u : F)) * (↑u⁻¹ : F) = a := by
          calc (↑u⁻¹ : F) * ((↑u : F) * a * (↑u : F)) * (↑u⁻¹ : F)
              = ((↑u⁻¹ : F) * (↑u : F)) * a * ((↑u : F) * (↑u⁻¹ : F)) := by ring
            _ = 1 * a * 1 := by rw [hUinv, hU]
            _ = a := by rw [one_mul, mul_one]
        calc torus (R := F) q p hpq.symm u *
              x (R := F) p q hpq ((↑u : F) * a * (↑u : F)) *
              (torus (R := F) q p hpq.symm u)⁻¹
            = x (R := F) p q hpq
                ((↑u⁻¹ : F) * ((↑u : F) * a * (↑u : F)) * (↑u⁻¹ : F)) := by
              simpa using h_conj
          _ = x (R := F) p q hpq a := by rw [h_scale]
      have h_eq : (torus (R := F) q p hpq.symm u)⁻¹ * x (R := F) p q hpq a *
            torus (R := F) q p hpq.symm u =
          x (R := F) p q hpq ((↑u : F) * a * (↑u : F)) := by
        calc (torus (R := F) q p hpq.symm u)⁻¹ * x (R := F) p q hpq a *
              torus (R := F) q p hpq.symm u
            = (torus (R := F) q p hpq.symm u)⁻¹ *
                (torus (R := F) q p hpq.symm u *
                  x (R := F) p q hpq ((↑u : F) * a * (↑u : F)) *
                  (torus (R := F) q p hpq.symm u)⁻¹) *
                torus (R := F) q p hpq.symm u := by
              rw [h_forward]
          _ = x (R := F) p q hpq ((↑u : F) * a * (↑u : F)) := by
              simp [mul_assoc]
      rw [h_eq]
      exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
    · by_cases h3 : p = i
      · subst h3
        -- Remaining `p, j, q`; `hij : p ≠ j`, torus `torus p j`, root `x p q`.
        have hq_ne_j : q ≠ j := fun hqj => h1 ⟨rfl, hqj⟩
        have hjq : j ≠ q := Ne.symm hq_ne_j
        have h_forward : torus (R := F) p j hij u *
            x (R := F) p q hpq ((↑u⁻¹ : F) * a) *
            (torus (R := F) p j hij u)⁻¹ =
            x (R := F) p q hpq a := by
          have h_conj := torus_conj_x_ik (R := F) p j q hij hjq hpq u
            ((↑u⁻¹ : F) * a)
          have h_scale : (↑u : F) * ((↑u⁻¹ : F) * a) = a := by
            rw [← mul_assoc, hU, one_mul]
          calc torus (R := F) p j hij u *
                x (R := F) p q hpq ((↑u⁻¹ : F) * a) *
                (torus (R := F) p j hij u)⁻¹
              = x (R := F) p q hpq ((↑u : F) * ((↑u⁻¹ : F) * a)) := h_conj
            _ = x (R := F) p q hpq a := by rw [h_scale]
        have h_eq : (torus (R := F) p j hij u)⁻¹ * x (R := F) p q hpq a *
            torus (R := F) p j hij u =
            x (R := F) p q hpq ((↑u⁻¹ : F) * a) := by
          calc (torus (R := F) p j hij u)⁻¹ * x (R := F) p q hpq a *
                torus (R := F) p j hij u
              = (torus (R := F) p j hij u)⁻¹ *
                  (torus (R := F) p j hij u *
                    x (R := F) p q hpq ((↑u⁻¹ : F) * a) *
                    (torus (R := F) p j hij u)⁻¹) *
                  torus (R := F) p j hij u := by
                rw [h_forward]
            _ = x (R := F) p q hpq ((↑u⁻¹ : F) * a) := by simp [mul_assoc]
        rw [h_eq]
        exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
      · by_cases h4 : p = j
        · subst h4
          -- Remaining `p, i, q`; `hij : i ≠ p`, torus `torus i p`, root `x p q`.
          have hq_ne_i : q ≠ i := fun hqi => h2 ⟨rfl, hqi⟩
          have hjq : p ≠ q := ne_of_lt hp
          have hiq : i ≠ q := Ne.symm hq_ne_i
          have h_forward : torus (R := F) i p hij u *
              x (R := F) p q hjq ((↑u : F) * a) *
              (torus (R := F) i p hij u)⁻¹ =
              x (R := F) p q hjq a := by
            have h_conj := torus_conj_x_jk (R := F) i p q hij hjq hiq u
              ((↑u : F) * a)
            have h_scale : (↑u⁻¹ : F) * ((↑u : F) * a) = a := by
              rw [← mul_assoc, hUinv, one_mul]
            calc torus (R := F) i p hij u *
                  x (R := F) p q hjq ((↑u : F) * a) *
                  (torus (R := F) i p hij u)⁻¹
                = x (R := F) p q hjq ((↑u⁻¹ : F) * ((↑u : F) * a)) := h_conj
              _ = x (R := F) p q hjq a := by rw [h_scale]
          have h_eq : (torus (R := F) i p hij u)⁻¹ * x (R := F) p q hpq a *
              torus (R := F) i p hij u =
              x (R := F) p q hjq ((↑u : F) * a) := by
            have h_conv : x (R := F) p q hpq a = x (R := F) p q hjq a :=
              x_eq_of_hij'
            calc (torus (R := F) i p hij u)⁻¹ * x (R := F) p q hpq a *
                  torus (R := F) i p hij u
                = (torus (R := F) i p hij u)⁻¹ *
                    (torus (R := F) i p hij u *
                      x (R := F) p q hjq ((↑u : F) * a) *
                      (torus (R := F) i p hij u)⁻¹) *
                    torus (R := F) i p hij u := by
                  rw [h_forward, h_conv]
              _ = x (R := F) p q hjq ((↑u : F) * a) := by simp [mul_assoc]
          have h_back : x (R := F) p q hjq ((↑u : F) * a) =
              x (R := F) p q hpq ((↑u : F) * a) :=
            (x_eq_of_hij').symm
          rw [h_eq, h_back]
          exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
        · by_cases h5 : q = i
          · subst h5
            -- Remaining `p, q, j`; `hij : q ≠ j`, torus `torus q j`, root `x p q`.
            have hj_ne_p : j ≠ p := fun hjp => h4 hjp.symm
            have hi_ne_p : q ≠ p := (ne_of_lt hp).symm
            have h_forward : torus (R := F) q j hij u *
                x (R := F) p q hi_ne_p.symm (a * (↑u : F)) *
                (torus (R := F) q j hij u)⁻¹ =
                x (R := F) p q hi_ne_p.symm a := by
              have h_conj := torus_conj_x_ki (R := F) q j p hij hj_ne_p hi_ne_p u
                (a * (↑u : F))
              have h_scale : (a * (↑u : F)) * (↑u⁻¹ : F) = a := by
                rw [mul_assoc, hU, mul_one]
              calc torus (R := F) q j hij u *
                    x (R := F) p q hi_ne_p.symm (a * (↑u : F)) *
                    (torus (R := F) q j hij u)⁻¹
                  = x (R := F) p q hi_ne_p.symm
                      ((a * (↑u : F)) * (↑u⁻¹ : F)) := h_conj
                _ = x (R := F) p q hi_ne_p.symm a := by rw [h_scale]
            have h_eq : (torus (R := F) q j hij u)⁻¹ * x (R := F) p q hpq a *
                torus (R := F) q j hij u =
                x (R := F) p q hi_ne_p.symm (a * (↑u : F)) := by
              have h_conv : x (R := F) p q hpq a =
                  x (R := F) p q hi_ne_p.symm a :=
                x_eq_of_hij'
              calc (torus (R := F) q j hij u)⁻¹ * x (R := F) p q hpq a *
                    torus (R := F) q j hij u
                  = (torus (R := F) q j hij u)⁻¹ *
                      (torus (R := F) q j hij u *
                        x (R := F) p q hi_ne_p.symm (a * (↑u : F)) *
                        (torus (R := F) q j hij u)⁻¹) *
                      torus (R := F) q j hij u := by
                    rw [h_forward, h_conv]
                _ = x (R := F) p q hi_ne_p.symm (a * (↑u : F)) := by
                    simp [mul_assoc]
            have h_back : x (R := F) p q hi_ne_p.symm (a * (↑u : F)) =
                x (R := F) p q hpq (a * (↑u : F)) :=
              (x_eq_of_hij').symm
            rw [h_eq, h_back]
            exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
          · by_cases h6 : q = j
            · subst h6
              -- Remaining `p, q, i`; `hij : i ≠ q`, torus `torus i q`, root `x p q`.
              have hi_ne_p : i ≠ p := fun hip => h3 hip.symm
              have hj_ne_p : q ≠ p := (ne_of_lt hp).symm
              have h_forward : torus (R := F) i q hij u *
                  x (R := F) p q hj_ne_p.symm (a * (↑u⁻¹ : F)) *
                  (torus (R := F) i q hij u)⁻¹ =
                  x (R := F) p q hj_ne_p.symm a := by
                have h_conj := torus_conj_x_kj (R := F) i q p hij hj_ne_p hi_ne_p u
                  (a * (↑u⁻¹ : F))
                have h_scale : (a * (↑u⁻¹ : F)) * (↑u : F) = a := by
                  rw [mul_assoc, hUinv, mul_one]
                calc torus (R := F) i q hij u *
                      x (R := F) p q hj_ne_p.symm (a * (↑u⁻¹ : F)) *
                      (torus (R := F) i q hij u)⁻¹
                    = x (R := F) p q hj_ne_p.symm
                        ((a * (↑u⁻¹ : F)) * (↑u : F)) := h_conj
                  _ = x (R := F) p q hj_ne_p.symm a := by rw [h_scale]
              have h_eq : (torus (R := F) i q hij u)⁻¹ * x (R := F) p q hpq a *
                  torus (R := F) i q hij u =
                  x (R := F) p q hj_ne_p.symm (a * (↑u⁻¹ : F)) := by
                have h_conv : x (R := F) p q hpq a =
                    x (R := F) p q hj_ne_p.symm a :=
                  x_eq_of_hij'
                calc (torus (R := F) i q hij u)⁻¹ * x (R := F) p q hpq a *
                      torus (R := F) i q hij u
                    = (torus (R := F) i q hij u)⁻¹ *
                        (torus (R := F) i q hij u *
                          x (R := F) p q hj_ne_p.symm (a * (↑u⁻¹ : F)) *
                          (torus (R := F) i q hij u)⁻¹) *
                        torus (R := F) i q hij u := by
                      rw [h_forward, h_conv]
                  _ = x (R := F) p q hj_ne_p.symm (a * (↑u⁻¹ : F)) := by
                      simp [mul_assoc]
              have h_back : x (R := F) p q hj_ne_p.symm (a * (↑u⁻¹ : F)) =
                  x (R := F) p q hpq (a * (↑u⁻¹ : F)) :=
                (x_eq_of_hij').symm
              rw [h_eq, h_back]
              exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _
            · have hip : i ≠ p := fun hip => h3 hip.symm
              have hiq : i ≠ q := fun hiq => h5 hiq.symm
              have hjp : j ≠ p := fun hjp => h4 hjp.symm
              have hjq : j ≠ q := fun hjq => h6 hjq.symm
              have h_comm := torus_comm_of_disjoint_general (F := F) hij hpq
                hip hiq hjp hjq u a
              have h_eq : (torus (R := F) i j hij u)⁻¹ * x (R := F) p q hpq a *
                  torus (R := F) i j hij u =
                  x (R := F) p q hpq a := by
                have hC : Commute (torus (R := F) i j hij u)⁻¹
                    (x (R := F) p q hpq a) :=
                  h_comm.inv_left
                calc (torus (R := F) i j hij u)⁻¹ * x (R := F) p q hpq a *
                      torus (R := F) i j hij u
                    = x (R := F) p q hpq a * (torus (R := F) i j hij u)⁻¹ *
                      torus (R := F) i j hij u := by rw [hC.eq]
                  _ = x (R := F) p q hpq a := by simp [mul_assoc]
              rw [h_eq]
              exact x_mem_upperUnipotentSubgroup (R := F) hpq hp hp_lt_n hq _

/-- A finite-torus generator normalizes the upper-unipotent subgroup.
Both directions of `mem_normalizer_iff` hold; the inverse direction uses
inverse coefficient rescaling. Orientation: `torus * upper * torus⁻¹`. -/
private theorem torus_generator_mem_normalizer_upper {n i j : ℕ} (hij : i ≠ j)
    (hi : i < n) (hj : j < n) (u : Fˣ) :
    torus (R := F) i j hij u ∈
      Subgroup.normalizer (upperUnipotentSubgroup (R := F) n) := by
  let t := torus (R := F) i j hij u
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · intro hg
    induction hg using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨p, q, hpq, a, rfl, hp, hp_lt_n, hq⟩ := hy
      exact torus_conj_positive_mem_upper (F := F) hij hpq hi hj hp hq u a
    | one => simp
    | mul g1 g2 _ _ ih1 ih2 =>
      have h_eq : t * (g1 * g2) * t⁻¹ = (t * g1 * t⁻¹) * (t * g2 * t⁻¹) := by
        simp [mul_assoc]
      rw [h_eq]
      exact Subgroup.mul_mem _ ih1 ih2
    | inv g _ ih =>
      have h_eq : t * g⁻¹ * t⁻¹ = (t * g * t⁻¹)⁻¹ := by
        simp [mul_assoc]
      rw [h_eq]
      exact Subgroup.inv_mem _ ih
  · intro hg
    have h_inv_conj_mem : ∀ h ∈ upperUnipotentSubgroup (R := F) n,
        t⁻¹ * h * t ∈ upperUnipotentSubgroup (R := F) n := by
      intro h hh
      induction hh using Subgroup.closure_induction with
      | mem y hy =>
        obtain ⟨p, q, hpq, a, rfl, hp, hp_lt_n, hq⟩ := hy
        exact torus_inv_conj_positive_mem_upper (F := F) hij hpq hi hj hp hq u a
      | one => simp
      | mul g1 g2 _ _ ih1 ih2 =>
        have h_eq : t⁻¹ * (g1 * g2) * t = (t⁻¹ * g1 * t) * (t⁻¹ * g2 * t) := by
          simp [mul_assoc]
        rw [h_eq]
        exact Subgroup.mul_mem _ ih1 ih2
      | inv g _ ih =>
        have h_eq : t⁻¹ * g⁻¹ * t = (t⁻¹ * g * t)⁻¹ := by
          simp [mul_assoc]
        rw [h_eq]
        exact Subgroup.inv_mem _ ih
    have h_mem : t⁻¹ * (t * g * t⁻¹) * t ∈ upperUnipotentSubgroup (R := F) n :=
      h_inv_conj_mem (t * g * t⁻¹) hg
    have h_eq : t⁻¹ * (t * g * t⁻¹) * t = g := by simp [mul_assoc]
    rw [h_eq] at h_mem
    exact h_mem

/-- Every finite-torus element normalizes the upper-unipotent subgroup.
Proved by closure induction on torus generators. Purpose: Lemma 21(a) torus
part. Orientation: `torus * upper * torus⁻¹ ⊆ upper`.
Nonclaim: no Borel product, quotient, or Matsumoto claim. -/
public theorem finiteTorusSubgroup_le_normalizer_upperUnipotent (n : ℕ) :
    finiteTorusSubgroup (R := F) n ≤
      Subgroup.normalizer (upperUnipotentSubgroup (R := F) n) := by
  rw [finiteTorusSubgroup, Subgroup.closure_le]
  intro g hg
  obtain ⟨i, j, hij, u, rfl, hi, hj⟩ := hg
  exact torus_generator_mem_normalizer_upper (F := F) hij hi hj u

/-- Borel product characterization: every `b ∈ finiteBorelSubgroup n` factors
as `b = u * h` with `u` upper-unipotent and `h` finite-torus. Proved by
closure induction on the join (as closure of the union), moving torus factors
right with torus normalization. Orientation: upper factor on the left.
Nonclaim: no uniqueness, quotient, or Matsumoto claim. -/
public theorem finiteBorel_exists_upper_mul_torus {n : ℕ}
    {b : StableSteinberg F} (hb : b ∈ finiteBorelSubgroup (F := F) n) :
    ∃ u ∈ upperUnipotentSubgroup (R := F) n,
      ∃ h ∈ finiteTorusSubgroup (R := F) n, b = u * h := by
  have h_sup : finiteBorelSubgroup (F := F) n =
      Subgroup.closure
        ((upperUnipotentSubgroup (R := F) n : Set (StableSteinberg F)) ∪
          (finiteTorusSubgroup (R := F) n : Set (StableSteinberg F))) := by
    rw [finiteBorelSubgroup, Subgroup.sup_eq_closure]
  rw [h_sup] at hb
  induction hb using Subgroup.closure_induction with
  | mem y hy =>
    rcases hy with hu | hh
    · exact ⟨y, hu, 1, Subgroup.one_mem _, by simp⟩
    · exact ⟨1, Subgroup.one_mem _, y, hh, by simp⟩
  | one => exact ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, by simp⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨u1, hu1, h1, hh1, rfl⟩ := ihx
    obtain ⟨u2, hu2, h2, hh2, rfl⟩ := ihy
    have h_norm : h1 * u2 * h1⁻¹ ∈ upperUnipotentSubgroup (R := F) n := by
      have h_mem := Subgroup.mem_normalizer_iff.mp
        (finiteTorusSubgroup_le_normalizer_upperUnipotent (F := F) n hh1) u2
      exact h_mem.mp hu2
    refine ⟨u1 * (h1 * u2 * h1⁻¹), Subgroup.mul_mem _ hu1 h_norm,
      h1 * h2, Subgroup.mul_mem _ hh1 hh2, ?_⟩
    simp [mul_assoc]
  | inv x _ ih =>
    obtain ⟨u, hu, h, hh, rfl⟩ := ih
    have h_inv_mem : h⁻¹ ∈ finiteTorusSubgroup (R := F) n :=
      Subgroup.inv_mem _ hh
    have h_conj_mem : h⁻¹ * u⁻¹ * h ∈ upperUnipotentSubgroup (R := F) n := by
      -- `h⁻¹` normalizes since the normalizer is a subgroup.
      have h_norm_mem : h⁻¹ ∈
          Subgroup.normalizer (upperUnipotentSubgroup (R := F) n) :=
        Subgroup.inv_mem _
          (finiteTorusSubgroup_le_normalizer_upperUnipotent (F := F) n hh)
      have h_mem := Subgroup.mem_normalizer_iff.mp h_norm_mem u⁻¹
      have h := h_mem.mp (Subgroup.inv_mem _ hu)
      simpa [inv_inv] using h
    refine ⟨h⁻¹ * u⁻¹ * h, h_conj_mem, h⁻¹,
      h_inv_mem, ?_⟩
    simp [mul_assoc]

/-- The finite Borel lies in the finite stage. Both join factors do. -/
public theorem finiteBorelSubgroup_le_finiteStage (n : ℕ) :
    finiteBorelSubgroup (F := F) n ≤ finiteStage (R := F) n := by
  apply sup_le
  · exact upperUnipotentSubgroup_le_finiteStage (R := F) n
  · exact finiteTorusSubgroup_le_finiteStage (R := F) n

end BorelNormalization

section SimpleRoot

/-- The simple root lies in the upper subgroup when `m + 1 < n`.
Hypothesis `hm : m + 1 < n` supplies `m < n` and `m + 1 < n`. -/
public theorem simpleRootSubgroup_le_upperUnipotent {n m : ℕ} (hm : m + 1 < n) :
    simpleRootSubgroup (F := F) m ≤ upperUnipotentSubgroup (R := F) n := by
  rw [simpleRootSubgroup, Subgroup.closure_le]
  intro g hg
  obtain ⟨a, rfl⟩ := hg
  have hm_lt : m < m + 1 := Nat.lt_succ_self m
  have hm_n : m < n := Nat.lt_of_succ_lt hm
  exact x_mem_upperUnipotentSubgroup (R := F)
    (Nat.ne_of_lt (Nat.lt_succ_self m)) hm_lt hm_n hm a

/-- The complement lies in the upper subgroup when `m + 1 < n`.
Each generator is positive below `n`. -/
public theorem simpleRootComplementSubgroup_le_upperUnipotent {n m : ℕ}
    (_hm : m + 1 < n) :
    simpleRootComplementSubgroup (F := F) n m ≤
      upperUnipotentSubgroup (R := F) n := by
  rw [simpleRootComplementSubgroup, Subgroup.closure_le]
  intro g hg
  obtain ⟨i, j, hij, a, rfl, hlt, hi, hj, _hne⟩ := hg
  exact x_mem_upperUnipotentSubgroup (R := F) hij hlt hi hj a

/-- Upper-generator conjugation of a complement generator stays in the
complement. Uses only `x_comm` (disjoint, including same-first/second),
`x_chev` (the two shared-index Chevalley orders), and `x_add` (same pair).
The extra Chevalley factor has height at least two, so it cannot be the
excluded `(m, m + 1)` root. Orientation: `x_ij * x_pq * x_ij⁻¹`. -/
private theorem upper_conj_complement_generator_mem {n m i j p q : ℕ}
    (hij : i ≠ j) (hpq : p ≠ q)
    (hlt_ij : i < j) (hi : i < n) (hj : j < n)
    (hlt_pq : p < q) (hp : p < n) (hq : q < n)
    (hne : ¬(p = m ∧ q = m + 1)) (a b : F) :
    x (R := F) i j hij a * x (R := F) p q hpq b * (x (R := F) i j hij a)⁻¹ ∈
      simpleRootComplementSubgroup (F := F) n m := by
  by_cases h_same : i = p ∧ j = q
  · obtain ⟨rfl, rfl⟩ := h_same
    -- Same pair (`p, q` eliminated, `i, j` remain):
    -- `x(a) * x(b) * x(a)⁻¹ = x(b)` by `x_add` twice.
    have h_add1 : x (R := F) i j hij a * x i j hij b = x i j hij (a + b) :=
      x_add (R := F) i j hij a b
    have h_inv : (x (R := F) i j hij a)⁻¹ = x i j hij (-a) := by
      rw [← x_neg (R := F) i j hij a]
    have h_add2 : x (R := F) i j hij (a + b) * x i j hij (-a) =
        x i j hij b := by
      have h := x_add (R := F) i j hij (a + b) (-a)
      have h_ring : (a + b) + (-a) = b := by ring
      rw [h_ring] at h
      exact h
    have h_eq : x (R := F) i j hij a * x i j hij b * (x i j hij a)⁻¹ =
        x (R := F) i j hij b := by
      calc x (R := F) i j hij a * x i j hij b * (x i j hij a)⁻¹
          = (x (R := F) i j hij a * x i j hij b) * (x i j hij a)⁻¹ := by
            rw [mul_assoc]
        _ = x (R := F) i j hij (a + b) * (x i j hij a)⁻¹ := by rw [h_add1]
        _ = x (R := F) i j hij (a + b) * x i j hij (-a) := by rw [h_inv]
        _ = x (R := F) i j hij b := h_add2
    rw [h_eq]
    exact x_mem_simpleRootComplementSubgroup (F := F) hij hlt_ij hi hj hne b
  · by_cases hjp : j = p
    · subst hjp
      -- Direct Chevalley: `j = p`, so `i < j < q`; extra factor `x i q`.
      have hiq : i ≠ q := ne_of_lt (Nat.lt_trans hlt_ij hlt_pq)
      have hChev : ⁅x (R := F) i j hij a, x j q hpq b⁆ =
          x i q hiq (a * b) :=
        x_chev (R := F) i j q hij hpq hiq a b
      have hConj : x (R := F) i j hij a * x j q hpq b * (x i j hij a)⁻¹ =
          x i q hiq (a * b) * x j q hpq b := by
        have h1 : x (R := F) i j hij a * x j q hpq b * (x i j hij a)⁻¹ =
            (MulAut.conj (x i j hij a)) (x j q hpq b) := rfl
        have h2 : (MulAut.conj (x i j hij a)) (x j q hpq b) =
            ⁅x i j hij a, x j q hpq b⁆ * x j q hpq b :=
          conj_eq_commutatorElement_mul
        rw [h1, h2, hChev]
      rw [hConj]
      have hiq_lt : i < q := Nat.lt_trans hlt_ij hlt_pq
      have hne_iq : ¬(i = m ∧ q = m + 1) := by
        rintro ⟨rfl, rfl⟩
        -- `m < j < m + 1` is impossible.
        omega
      have h_extra : x (R := F) i q hiq (a * b) ∈
          simpleRootComplementSubgroup (F := F) n m :=
        x_mem_simpleRootComplementSubgroup (F := F) hiq hiq_lt hi hq hne_iq _
      have h_main : x (R := F) j q hpq b ∈
          simpleRootComplementSubgroup (F := F) n m :=
        x_mem_simpleRootComplementSubgroup (F := F) hpq hlt_pq hp hq hne b
      exact Subgroup.mul_mem _ h_extra h_main
    · by_cases hiq : i = q
      · subst hiq
        -- Inverse Chevalley (`q` eliminated, `i` remains):
        -- `p < i < j`; extra factor `x p j`.
        have hpj : p ≠ j := ne_of_lt (Nat.lt_trans hlt_pq hlt_ij)
        have hChev : ⁅x (R := F) p i hpq b, x i j hij a⁆ =
            x p j hpj (b * a) :=
          x_chev (R := F) p i j hpq hij hpj b a
        have hChevInv : ⁅x (R := F) i j hij a, x p i hpq b⁆ =
            x p j hpj (-(b * a)) := by
          have hInv : ⁅x (R := F) i j hij a, x p i hpq b⁆ =
              (⁅x (R := F) p i hpq b, x i j hij a⁆)⁻¹ :=
            (commutatorElement_inv _ _).symm
          rw [hInv, hChev, ← x_neg (R := F) p j hpj (b * a)]
        have hConj : x (R := F) i j hij a * x p i hpq b * (x i j hij a)⁻¹ =
            x p j hpj (-(b * a)) * x p i hpq b := by
          have h1 : x (R := F) i j hij a * x p i hpq b * (x i j hij a)⁻¹ =
              (MulAut.conj (x i j hij a)) (x p i hpq b) := rfl
          have h2 : (MulAut.conj (x i j hij a)) (x p i hpq b) =
              ⁅x i j hij a, x p i hpq b⁆ * x p i hpq b :=
            conj_eq_commutatorElement_mul
          rw [h1, h2, hChevInv]
        rw [hConj]
        have hpj_lt : p < j := Nat.lt_trans hlt_pq hlt_ij
        have hne_pj : ¬(p = m ∧ j = m + 1) := by
          rintro ⟨rfl, rfl⟩
          omega
        have h_extra : x (R := F) p j hpj (-(b * a)) ∈
            simpleRootComplementSubgroup (F := F) n m :=
          x_mem_simpleRootComplementSubgroup (F := F) hpj hpj_lt hp hj hne_pj _
        have h_main : x (R := F) p i hpq b ∈
            simpleRootComplementSubgroup (F := F) n m :=
          x_mem_simpleRootComplementSubgroup (F := F) hpq hlt_pq hp hq hne b
        exact Subgroup.mul_mem _ h_extra h_main
      · -- Disjoint (covers same-first, same-second, fully disjoint): `x_comm`.
        have hiq' : i ≠ q := fun h => hiq h
        have hjp' : j ≠ p := fun h => hjp h
        have h_comm : ⁅x (R := F) i j hij a, x p q hpq b⁆ = 1 :=
          x_comm (R := F) i j p q hij hpq hiq' hjp' a b
        have h_eq : x (R := F) i j hij a * x p q hpq b * (x i j hij a)⁻¹ =
            x (R := F) p q hpq b := by
          have h1 : x (R := F) i j hij a * x p q hpq b * (x i j hij a)⁻¹ =
              (MulAut.conj (x i j hij a)) (x p q hpq b) := rfl
          have h2 : (MulAut.conj (x i j hij a)) (x p q hpq b) =
              ⁅x i j hij a, x p q hpq b⁆ * x p q hpq b :=
            conj_eq_commutatorElement_mul
          rw [h1, h2, h_comm, one_mul]
        rw [h_eq]
        exact x_mem_simpleRootComplementSubgroup (F := F) hpq hlt_pq hp hq hne b

/-- An upper generator conjugates every complement element back into the
complement, by closure induction on the complement word using the
generator-generator case above. Orientation: `x_ij * y * x_ij⁻¹`. -/
private theorem upper_generator_conj_complement_mem {n m i j : ℕ} (hij : i ≠ j)
    (hlt_ij : i < j) (hi : i < n) (hj : j < n) (a : F)
    {y : StableSteinberg F} (hy : y ∈ simpleRootComplementSubgroup (F := F) n m) :
    x (R := F) i j hij a * y * (x (R := F) i j hij a)⁻¹ ∈
      simpleRootComplementSubgroup (F := F) n m := by
  let t := x (R := F) i j hij a
  induction hy using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨p, q, hpq, b, rfl, hlt_pq, hp, hq, hne⟩ := hz
    exact upper_conj_complement_generator_mem (F := F) hij hpq
      hlt_ij hi hj hlt_pq hp hq hne a b
  | one => simp
  | mul g1 g2 _ _ ih1 ih2 =>
    have h_eq : t * (g1 * g2) * t⁻¹ = (t * g1 * t⁻¹) * (t * g2 * t⁻¹) := by
      simp [mul_assoc]
    rw [h_eq]
    exact Subgroup.mul_mem _ ih1 ih2
  | inv g _ ih =>
    have h_eq : t * g⁻¹ * t⁻¹ = (t * g * t⁻¹)⁻¹ := by
      simp [mul_assoc]
    rw [h_eq]
    exact Subgroup.inv_mem _ ih

/-- An upper generator lies in the normalizer of the complement.
Forward uses the previous lemma; backward conjugates back with `x_ij (-a)`,
which is the inverse generator. Orientation: `x_ij * complement * x_ij⁻¹`. -/
private theorem upper_generator_mem_normalizer_complement {n m i j : ℕ}
    (hij : i ≠ j) (hlt_ij : i < j) (hi : i < n) (hj : j < n) (a : F) :
    x (R := F) i j hij a ∈
      Subgroup.normalizer (simpleRootComplementSubgroup (F := F) n m) := by
  let t := x (R := F) i j hij a
  have h_inv_eq : t⁻¹ = x (R := F) i j hij (-a) := by
    rw [← x_neg (R := F) i j hij a]
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · intro hg
    exact upper_generator_conj_complement_mem (F := F) hij hlt_ij hi hj a hg
  · intro hg
    have h_back : x (R := F) i j hij (-a) * (t * g * t⁻¹) *
        (x (R := F) i j hij (-a))⁻¹ ∈
        simpleRootComplementSubgroup (F := F) n m :=
      upper_generator_conj_complement_mem (F := F) hij hlt_ij hi hj (-a) hg
    have h_eq : x (R := F) i j hij (-a) * (t * g * t⁻¹) *
        (x (R := F) i j hij (-a))⁻¹ = g := by
      calc x (R := F) i j hij (-a) * (t * g * t⁻¹) *
            (x (R := F) i j hij (-a))⁻¹
          = t⁻¹ * (t * g * t⁻¹) * t := by
            rw [← h_inv_eq, inv_inv]
        _ = g := by simp [mul_assoc]
    rw [h_eq] at h_back
    exact h_back

/-- The full upper-unipotent subgroup normalizes the complement.
Proved by closure induction on upper generators. Purpose: Lemma 16
normality `Xs ▷ X_I` for `S = P`, `I = P - {a}`.
Orientation: `upper * complement * upper⁻¹ ⊆ complement`.
Nonclaim: no uniqueness or Bruhat claim. -/
public theorem upperUnipotent_le_normalizer_complement {n m : ℕ} :
    upperUnipotentSubgroup (R := F) n ≤
      Subgroup.normalizer (simpleRootComplementSubgroup (F := F) n m) := by
  rw [upperUnipotentSubgroup, Subgroup.closure_le]
  intro g hg
  obtain ⟨i, j, hij, a, rfl, hlt_ij, hi, hj⟩ := hg
  exact upper_generator_mem_normalizer_complement (F := F) hij hlt_ij hi hj a

/-- Existence/product decomposition: every `u ∈ upperUnipotentSubgroup n`
factors as `u = xpart * rest` with `xpart` in the simple-root subgroup and
`rest` in the complement. No uniqueness claim. Uses normality of the
complement to move simple factors left. Orientation: simple factor left. -/
public theorem upperUnipotent_exists_simple_mul_complement {n m : ℕ}
    (hm : m + 1 < n) {u : StableSteinberg F}
    (hu : u ∈ upperUnipotentSubgroup (R := F) n) :
    ∃ xpart ∈ simpleRootSubgroup (F := F) m,
      ∃ rest ∈ simpleRootComplementSubgroup (F := F) n m, u = xpart * rest := by
  induction hu using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨i, j, hij, a, rfl, hlt_ij, hi, hj⟩ := hy
    by_cases h_eq : i = m ∧ j = m + 1
    · obtain ⟨rfl, rfl⟩ := h_eq
      -- `m` eliminated, `i` remains; proofs are irrelevant so `exact` suffices.
      have h_mem : x (R := F) i (i + 1) hij a ∈ simpleRootSubgroup (F := F) i :=
        x_mem_simpleRootSubgroup (F := F) i a
      exact ⟨_, h_mem, 1, Subgroup.one_mem _, by simp⟩
    · have h_mem : x (R := F) i j hij a ∈
          simpleRootComplementSubgroup (F := F) n m :=
        x_mem_simpleRootComplementSubgroup (F := F) hij hlt_ij hi hj h_eq a
      exact ⟨1, Subgroup.one_mem _, _, h_mem, by simp⟩
  | one => exact ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, by simp⟩
  | mul x y _ _ ihx ihy =>
    obtain ⟨h1, hh1, n1, hn1, rfl⟩ := ihx
    obtain ⟨h2, hh2, n2, hn2, rfl⟩ := ihy
    -- Move `n1` past `h2`: `n1 * h2 = h2 * (h2⁻¹ * n1 * h2)`.
    have h2_mem_upper : h2 ∈ upperUnipotentSubgroup (R := F) n :=
      simpleRootSubgroup_le_upperUnipotent (F := F) hm hh2
    have h_norm : h2⁻¹ * n1 * h2 ∈ simpleRootComplementSubgroup (F := F) n m := by
      have h_mem_inv := Subgroup.mem_normalizer_iff''.mp
        (upperUnipotent_le_normalizer_complement (F := F) (n := n) (m := m)
          h2_mem_upper) n1
      exact h_mem_inv.mp hn1
    refine ⟨h1 * h2, Subgroup.mul_mem _ hh1 hh2,
      (h2⁻¹ * n1 * h2) * n2, Subgroup.mul_mem _ h_norm hn2, ?_⟩
    simp [mul_assoc]
  | inv x _ ih =>
    obtain ⟨h, hh, nn, hnn, rfl⟩ := ih
    have h_mem_upper : h ∈ upperUnipotentSubgroup (R := F) n :=
      simpleRootSubgroup_le_upperUnipotent (F := F) hm hh
    -- `(h * nn)⁻¹ = h⁻¹ * (h * nn⁻¹ * h⁻¹)`.
    have h_conj : h * nn⁻¹ * h⁻¹ ∈ simpleRootComplementSubgroup (F := F) n m := by
      have h_mem := Subgroup.mem_normalizer_iff.mp
        (upperUnipotent_le_normalizer_complement (F := F) (n := n) (m := m)
          h_mem_upper) nn⁻¹
      exact h_mem.mp (Subgroup.inv_mem _ hnn)
    refine ⟨h⁻¹, Subgroup.inv_mem _ hh, h * nn⁻¹ * h⁻¹, h_conj, ?_⟩
    simp [mul_assoc]

end SimpleRoot

section WeylPreservation

/-- Weyl generator commutes with a disjoint positive root: inline
disjoint-support calculation from `x_comm` only. Each of the three
`x`-factors of `weyl m (m + 1) 1` commutes with `x p q a`.
Orientation: `weyl * x = x * weyl`. -/
private theorem weyl_comm_of_disjoint_x {m p q : ℕ} (hmm : m ≠ m + 1)
    (hpq : p ≠ q) (hmp : m ≠ p) (hmq : m ≠ q) (hm1p : m + 1 ≠ p)
    (hm1q : m + 1 ≠ q) (a : F) :
    Commute (weyl (R := F) m (m + 1) hmm (1 : Fˣ))
      (x (R := F) p q hpq a) := by
  have h1 : Commute (x (R := F) m (m + 1) hmm ((1 : Fˣ) : F))
      (x (R := F) p q hpq a) := by
    rw [commute_iff_eq]
    have h := x_comm (R := F) m (m + 1) p q hmm hpq hmq hm1p
      ((1 : Fˣ) : F) a
    exact (commutatorElement_eq_one_iff_commute.mp h).eq
  have h2 : Commute (x (R := F) (m + 1) m hmm.symm (-(↑(1 : Fˣ)⁻¹ : F)))
      (x (R := F) p q hpq a) := by
    rw [commute_iff_eq]
    have h := x_comm (R := F) (m + 1) m p q hmm.symm hpq hm1q hmp
      (-(↑(1 : Fˣ)⁻¹ : F)) a
    exact (commutatorElement_eq_one_iff_commute.mp h).eq
  unfold weyl
  have h12 : Commute (x (R := F) m (m + 1) hmm ((1 : Fˣ) : F) *
      x (R := F) (m + 1) m hmm.symm (-(↑(1 : Fˣ)⁻¹ : F)))
      (x (R := F) p q hpq a) :=
    Commute.mul_left h1 h2
  exact Commute.mul_left h12 h1

/-- Weyl conjugation of a complement generator stays upper.
Covers the four shared-index patterns with the public `weyl_conj_x_*`
lemmas and the disjoint case by `x_comm` (via the commute above).
Every output index is `< n` explicit. Orientation: `weyl * x * weyl⁻¹`.
Hypothesis `hm : m + 1 < n`. Nonclaim: no complement stability. -/
private theorem weyl_conj_complement_generator_mem_upper {n m p q : ℕ}
    (hm : m + 1 < n) (hpq : p ≠ q) (hlt_pq : p < q) (hp : p < n) (hq : q < n)
    (hne : ¬(p = m ∧ q = m + 1)) (a : F) :
    weyl (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) *
      x (R := F) p q hpq a *
      (weyl (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m))
        (1 : Fˣ))⁻¹ ∈
      upperUnipotentSubgroup (R := F) n := by
  have hmm : m ≠ m + 1 := Nat.ne_of_lt (Nat.lt_succ_self m)
  have hm_n : m < n := Nat.lt_of_succ_lt hm
  have hmm' : m ≠ m + 1 := hmm
  by_cases h_pm : p = m
  · by_cases h_qm1 : q = m + 1
    · exfalso
      exact hne ⟨h_pm, h_qm1⟩
    · obtain rfl := Eq.symm h_pm
      -- `p` eliminated, `m` kept; root `x m q` with `q ≠ m + 1`.
      have hjq : m + 1 ≠ q := fun h => h_qm1 h.symm
      have hiq : m ≠ q := ne_of_lt hlt_pq
      have h_conj := weyl_conj_x_ik (R := F) m (m + 1) q hmm hjq hiq
        (1 : Fˣ) a
      have h_eq : weyl (R := F) m (m + 1) hmm (1 : Fˣ) *
          x (R := F) m q hiq a *
          (weyl (R := F) m (m + 1) hmm (1 : Fˣ))⁻¹ =
          x (R := F) (m + 1) q hjq (-((↑(1 : Fˣ)⁻¹ : F) * a)) := h_conj
      have h_conv : x (R := F) m q hpq a = x (R := F) m q hiq a :=
        x_eq_of_hij'
      have h_wconv : weyl (R := F) m (m + 1)
          (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) =
          weyl (R := F) m (m + 1) hmm (1 : Fˣ) := rfl
      rw [h_conv, h_wconv, h_wconv, h_eq]
      have hm1_lt_q : m + 1 < q := by omega
      exact x_mem_upperUnipotentSubgroup (R := F) hjq hm1_lt_q hm hq _
  · by_cases h_qm1 : q = m + 1
    · subst h_qm1
      -- `x p (m+1)` with `p ≠ m`: `weyl_conj_x_kj` gives `x p m`.
      have hpm : p ≠ m := h_pm
      have hpm_lt : p < m := by omega
      have hmp : m ≠ p := Ne.symm hpm
      have hm1p : m + 1 ≠ p := (ne_of_lt (Nat.lt_trans hpm_lt
        (Nat.lt_succ_self m))).symm
      have hkj : m + 1 ≠ p := hm1p
      have h_conj := weyl_conj_x_kj (R := F) m (m + 1) p hmm hkj hmp
        (1 : Fˣ) a
      have h_conv : x (R := F) p (m + 1) hpq a =
          x (R := F) p (m + 1) (ne_of_lt hlt_pq) a :=
        x_eq_of_hij'
      have h_wconv : weyl (R := F) m (m + 1)
          (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) =
          weyl (R := F) m (m + 1) hmm (1 : Fˣ) := rfl
      have hpm_ne : p ≠ m := hpm
      have h_eq : weyl (R := F) m (m + 1) hmm (1 : Fˣ) *
          x (R := F) p (m + 1) (ne_of_lt hlt_pq) a *
          (weyl (R := F) m (m + 1) hmm (1 : Fˣ))⁻¹ =
          x (R := F) p m hpm_ne (a * (↑(1 : Fˣ)⁻¹ : F)) := by
        have := h_conj
        -- `weyl_conj_x_kj` concludes `x k i` with `hik.symm`; unify proofs.
        simpa using this
      rw [h_conv, h_wconv, h_wconv, h_eq]
      exact x_mem_upperUnipotentSubgroup (R := F) hpm_ne hpm_lt hp hm_n _
    · by_cases h_pm1 : p = m + 1
      · subst h_pm1
        -- `x (m+1) q`: `weyl_conj_x_jk` gives `x m q`.
        have hjq : m + 1 ≠ q := ne_of_lt hlt_pq
        have hiq : m ≠ q := ne_of_lt (Nat.lt_trans (Nat.lt_succ_self m) hlt_pq)
        have h_conj := weyl_conj_x_jk (R := F) m (m + 1) q hmm hjq hiq
          (1 : Fˣ) a
        have h_conv : x (R := F) (m + 1) q hpq a =
            x (R := F) (m + 1) q hjq a :=
          x_eq_of_hij'
        have h_wconv : weyl (R := F) m (m + 1)
            (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) =
            weyl (R := F) m (m + 1) hmm (1 : Fˣ) := rfl
        rw [h_conv, h_wconv, h_wconv, h_conj]
        have hm_lt_q : m < q := Nat.lt_trans (Nat.lt_succ_self m) hlt_pq
        exact x_mem_upperUnipotentSubgroup (R := F) hiq hm_lt_q hm_n hq _
      · by_cases h_qm : q = m
        · obtain rfl := Eq.symm h_qm
          -- `q` eliminated, `m` kept; root `x p m`.
          have hpj : p ≠ m + 1 := h_pm1
          have hpm : p ≠ m := h_pm
          have hjp : m + 1 ≠ p := Ne.symm hpj
          have hmp : m ≠ p := Ne.symm hpm
          have h_conj := weyl_conj_x_ki (R := F) m (m + 1) p hmm hjp hmp
            (1 : Fˣ) a
          have h_conv : x (R := F) p m hpq a =
              x (R := F) p m (Ne.symm hmp) a :=
            x_eq_of_hij'
          have h_wconv : weyl (R := F) m (m + 1)
              (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) =
              weyl (R := F) m (m + 1) hmm (1 : Fˣ) := rfl
          rw [h_conv, h_wconv, h_wconv, h_conj]
          have hp_lt_m1 : p < m + 1 := Nat.lt_trans hlt_pq (Nat.lt_succ_self m)
          have hpm1 : p ≠ m + 1 := ne_of_lt hp_lt_m1
          exact x_mem_upperUnipotentSubgroup (R := F) hpm1 hp_lt_m1 hp hm _
        · -- Disjoint: `{p, q} ∩ {m, m+1} = ∅`.
          have hmp : m ≠ p := fun h => h_pm h.symm
          have hmq : m ≠ q := fun h => h_qm h.symm
          have hm1p : m + 1 ≠ p := fun h => h_pm1 h.symm
          have hm1q : m + 1 ≠ q := fun h => h_qm1 h.symm
          have h_comm := weyl_comm_of_disjoint_x (F := F) hmm hpq
            hmp hmq hm1p hm1q a
          have h_wconv : weyl (R := F) m (m + 1)
              (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) =
              weyl (R := F) m (m + 1) hmm (1 : Fˣ) := rfl
          have h_eq : weyl (R := F) m (m + 1)
              (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) *
              x (R := F) p q hpq a *
              (weyl (R := F) m (m + 1)
                (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ))⁻¹ =
              x (R := F) p q hpq a := by
            rw [h_wconv]
            exact h_comm.mul_inv_cancel
          rw [h_eq]
          exact x_mem_upperUnipotentSubgroup (R := F) hpq hlt_pq hp hq _

/-- Conjugation by `weyl m (m + 1) 1` sends the complement into the upper
subgroup. Proved by closure induction on complement words using the
generator case above; the target is a subgroup so conjugation distributes
over products and inverses. Hypothesis `hm : m + 1 < n`.
Orientation: `weyl * complement * weyl⁻¹ ⊆ upper`.
Nonclaim: no complement stability, quotient, or Lemma 24 claim. -/
public theorem weyl_conj_complement_mem_upper {n m : ℕ} (hm : m + 1 < n)
    {g : StableSteinberg F} (hg : g ∈ simpleRootComplementSubgroup (F := F) n m) :
    weyl (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ) * g *
      (weyl (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m))
        (1 : Fˣ))⁻¹ ∈
      upperUnipotentSubgroup (R := F) n := by
  let w := weyl (R := F) m (m + 1) (Nat.ne_of_lt (Nat.lt_succ_self m)) (1 : Fˣ)
  induction hg using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨p, q, hpq, a, rfl, hlt_pq, hp, hq, hne⟩ := hy
    exact weyl_conj_complement_generator_mem_upper (F := F) hm hpq hlt_pq hp hq hne a
  | one => simp
  | mul g1 g2 _ _ ih1 ih2 =>
    have h_eq : w * (g1 * g2) * w⁻¹ = (w * g1 * w⁻¹) * (w * g2 * w⁻¹) := by
      simp [mul_assoc]
    rw [h_eq]
    exact Subgroup.mul_mem _ ih1 ih2
  | inv g _ ih =>
    have h_eq : w * g⁻¹ * w⁻¹ = (w * g * w⁻¹)⁻¹ := by
      simp [mul_assoc]
    rw [h_eq]
    exact Subgroup.inv_mem _ ih

end WeylPreservation

end StableSteinberg

end AlgebraicKTheory
