module

public import MathlibExt.KTheory.Ring.StableGeneralLinear.Basic
public import MathlibExt.LinearAlgebra.Matrix.GeneralLinearGroup.ElementarySubgroup

/-! # Stable elementary subgroup of `StableGL`

Group-level API for `E∞(R)` generated by finite-stage elementary
representatives.
-/

@[expose] public section

open CategoryTheory Matrix.GeneralLinearGroup

universe u

namespace AlgebraicKTheory

noncomputable section

/-- Generator set for `E∞(R)`. -/
def stableElementarySet (R : Type u) [Ring R] : Set (StableGL R) :=
  { x | ∃ (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R),
      x = StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a) }

/-- Stable elementary subgroup `E∞(R)`. -/
def stableElementarySubgroup (R : Type u) [Ring R] : Subgroup (StableGL R) :=
  Subgroup.closure (stableElementarySet R)

/-- Underlying type of `E∞(R)`. -/
abbrev StableE (R : Type u) [Ring R] : Type u :=
  ↥(stableElementarySubgroup R)

theorem stableElementary_mem {R : Type u} [Ring R] {n : ℕ}
    {i j : Fin n} {hij : i ≠ j} {a : R} :
    StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a) ∈
      stableElementarySubgroup R := by
  apply Subgroup.subset_closure
  exact ⟨n, i, j, hij, a, rfl⟩

namespace StableE

/-- Bundled generator. -/
def elementary {R : Type u} [Ring R] (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    StableE R :=
  ⟨StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a), stableElementary_mem⟩

@[simp]
theorem coe_elementary {R : Type u} [Ring R] {n : ℕ} (i j : Fin n) (hij : i ≠ j) (a : R) :
    (↑(elementary (R := R) n i j hij a) : StableGL R) =
      StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a) :=
  rfl

/-! ### Inclusion from finite levels -/

theorem fromFinite_mem {R : Type u} [Ring R] (n : ℕ)
    {g : Matrix.GeneralLinearGroup (Fin n) R}
    (hg : g ∈ Matrix.GeneralLinearGroup.elementarySubgroup (Fin n) R) :
    ((StableGL.inclusion n).app (SemiRingCat.of R)).hom g ∈ stableElementarySubgroup R := by
  let φ : Matrix.GeneralLinearGroup (Fin n) R →* StableGL R :=
    ((StableGL.inclusion n).app (SemiRingCat.of R)).hom
  have hset : Matrix.GeneralLinearGroup.elementarySet (Fin n) R ≤
      (stableElementarySubgroup R).comap φ := by
    intro y hy
    obtain ⟨i, j, hij, a, rfl⟩ := hy
    exact (Subgroup.mem_comap).mpr (stableElementary_mem (hij := hij))
  have hclosure : Matrix.GeneralLinearGroup.elementarySubgroup (Fin n) R ≤
      (stableElementarySubgroup R).comap φ := by
    change Subgroup.closure (Matrix.GeneralLinearGroup.elementarySet (Fin n) R) ≤ _
    rw [Subgroup.closure_le]
    exact hset
  exact (Subgroup.mem_comap).mp (hclosure hg)

/-- Map `Eₙ(R) →* E∞(R)`. -/
noncomputable def fromFinite (R : Type u) [Ring R] (n : ℕ) :
    Matrix.GeneralLinearGroup.elementarySubgroup (Fin n) R →* StableE R :=
  ((StableGL.inclusion n).app (SemiRingCat.of R)).hom.restrict
    (fun _g hg => fromFinite_mem (R := R) n hg)

@[simp]
theorem coe_fromFinite (R : Type u) [Ring R] (n : ℕ)
    (g : Matrix.GeneralLinearGroup.elementarySubgroup (Fin n) R) :
    (↑(fromFinite R n g) : StableGL R) =
      StableGL.of (↑g : Matrix.GeneralLinearGroup (Fin n) R) :=
  rfl

@[simp]
theorem fromFinite_elementary (R : Type u) [Ring R] {n : ℕ}
    (i j : Fin n) (hij : i ≠ j) (a : R) :
    fromFinite R n (Matrix.GeneralLinearGroup.ElementarySubgroup.elementary i j hij a) =
      elementary (R := R) n i j hij a :=
  rfl

/-! ### Coefficient maps -/

variable {R : Type u} [Ring R] {S : Type u} [Ring S] {T : Type u} [Ring T]

theorem mapRingHom_mem (f : R →+* S) {x : StableGL R}
    (hx : x ∈ stableElementarySubgroup R) :
    (StableGL.functor.map (SemiRingCat.ofHom f)).hom x ∈ stableElementarySubgroup S := by
  let φ : StableGL R →* StableGL S :=
    (StableGL.functor.map (SemiRingCat.ofHom f)).hom
  have hset : stableElementarySet R ≤ (stableElementarySubgroup S).comap φ := by
    intro y hy
    obtain ⟨m, i, j, hij, a, rfl⟩ := hy
    apply (Subgroup.mem_comap).mpr
    have h_eq :
        φ (StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a)) =
          (StableGL.functor.map (SemiRingCat.ofHom f))
            (StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a)) := rfl
    rw [h_eq, StableGL.map_of]
    simp only [Matrix.GeneralLinearGroup.mapRingHom_elementary]
    exact stableElementary_mem (hij := hij)
  have hclosure : stableElementarySubgroup R ≤ (stableElementarySubgroup S).comap φ := by
    change Subgroup.closure (stableElementarySet R) ≤ _
    rw [Subgroup.closure_le]
    exact hset
  exact (Subgroup.mem_comap).mp (hclosure hx)

/-- Coefficient map `E∞(R) →* E∞(S)`. -/
noncomputable def mapRingHom (f : R →+* S) : StableE R →* StableE S :=
  (StableGL.functor.map (SemiRingCat.ofHom f)).hom.restrict
    (fun _x hx => mapRingHom_mem (R := R) (S := S) f hx)

@[simp]
theorem coe_mapRingHom (f : R →+* S) (x : StableE R) :
    (↑(mapRingHom f x) : StableGL S) =
      (StableGL.functor.map (SemiRingCat.ofHom f)) (↑x) :=
  rfl

@[simp]
theorem mapRingHom_elementary (f : R →+* S) (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    mapRingHom (R := R) (S := S) f (elementary (R := R) n i j hij a) =
      elementary (R := S) n i j hij (f a) := by
  apply Subtype.ext
  calc (↑(mapRingHom (R := R) (S := S) f (elementary (R := R) n i j hij a)) : StableGL S)
      = (StableGL.functor.map (SemiRingCat.ofHom f))
          (↑(elementary (R := R) n i j hij a) : StableGL R) := rfl
    _ = (StableGL.functor.map (SemiRingCat.ofHom f))
          (StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij a)) := by
          simp only [coe_elementary]
    _ = StableGL.of (Matrix.GeneralLinearGroup.mapRingHom f
          (Matrix.GeneralLinearGroup.elementary i j hij a)) := by
          rw [StableGL.map_of]
    _ = StableGL.of (Matrix.GeneralLinearGroup.elementary i j hij (f a)) := by
          rw [Matrix.GeneralLinearGroup.mapRingHom_elementary]
    _ = ↑(elementary (R := S) n i j hij (f a) : StableE S) := by
          simp only [coe_elementary]

@[simp]
theorem mapRingHom_id : mapRingHom (R := R) (RingHom.id R) = MonoidHom.id _ := by
  apply MonoidHom.ext
  intro x
  apply Subtype.ext
  have h_of : SemiRingCat.ofHom (RingHom.id R) = 𝟙 (SemiRingCat.of R) := rfl
  calc (↑(mapRingHom (R := R) (RingHom.id R) x) : StableGL R)
      = (StableGL.functor.map (SemiRingCat.ofHom (RingHom.id R))) (↑x) := rfl
    _ = (StableGL.functor.map (𝟙 (SemiRingCat.of R))) (↑x) := by rw [h_of]
    _ = (𝟙 (StableGL.functor.obj (SemiRingCat.of R))) (↑x) := by
          rw [StableGL.functor.map_id]
    _ = ↑x := rfl

theorem mapRingHom_comp (f : R →+* S) (g : S →+* T) :
    mapRingHom (R := R) (S := T) (g.comp f) =
      (mapRingHom (R := S) (S := T) g).comp (mapRingHom (R := R) (S := S) f) := by
  apply MonoidHom.ext
  intro x
  apply Subtype.ext
  have h_of : SemiRingCat.ofHom (g.comp f) = SemiRingCat.ofHom f ≫ SemiRingCat.ofHom g := rfl
  calc (↑(mapRingHom (R := R) (S := T) (g.comp f) x) : StableGL T)
      = (StableGL.functor.map (SemiRingCat.ofHom (g.comp f))) (↑x) := rfl
    _ = (StableGL.functor.map (SemiRingCat.ofHom f ≫ SemiRingCat.ofHom g)) (↑x) := by
          rw [h_of]
    _ = (StableGL.functor.map (SemiRingCat.ofHom f) ≫
          StableGL.functor.map (SemiRingCat.ofHom g)) (↑x) := by
          rw [Functor.map_comp]
    _ = (StableGL.functor.map (SemiRingCat.ofHom g))
          ((StableGL.functor.map (SemiRingCat.ofHom f)) (↑x)) := rfl
    _ = (StableGL.functor.map (SemiRingCat.ofHom g))
          (↑(mapRingHom (R := R) (S := S) f x)) := rfl
    _ = ↑(mapRingHom (R := S) (S := T) g (mapRingHom (R := R) (S := S) f x)) := rfl
    _ = ↑(((mapRingHom (R := S) (S := T) g).comp (mapRingHom (R := R) (S := S) f)) x) := rfl

theorem mapRingHom_fromFinite (f : R →+* S) (n : ℕ) :
    (mapRingHom (R := R) (S := S) f).comp (fromFinite (R := R) n) =
      (fromFinite (R := S) n).comp
        (Matrix.GeneralLinearGroup.ElementarySubgroup.mapRingHom (n := Fin n) f) := by
  apply MonoidHom.ext
  intro g
  apply Subtype.ext
  calc (↑((mapRingHom (R := R) (S := S) f).comp (fromFinite (R := R) n) g) : StableGL S)
      = (↑(mapRingHom (R := R) (S := S) f (fromFinite (R := R) n g)) : StableGL S) := rfl
    _ = (StableGL.functor.map (SemiRingCat.ofHom f)) (↑(fromFinite (R := R) n g)) := rfl
    _ = (StableGL.functor.map (SemiRingCat.ofHom f))
          (StableGL.of (↑g : Matrix.GeneralLinearGroup (Fin n) R)) := rfl
    _ = StableGL.of (Matrix.GeneralLinearGroup.mapRingHom f (↑g)) := by
          rw [StableGL.map_of]
    _ = StableGL.of
          (↑(ElementarySubgroup.mapRingHom (n := Fin n) f g)) := by
          rw [← ElementarySubgroup.coe_mapRingHom]
    _ = ↑(fromFinite (R := S) n
          (Matrix.GeneralLinearGroup.ElementarySubgroup.mapRingHom (n := Fin n) f g)) := by
          rw [coe_fromFinite]
    _ = ↑((fromFinite (R := S) n).comp
          (Matrix.GeneralLinearGroup.ElementarySubgroup.mapRingHom (n := Fin n) f) g) := rfl

end StableE

end

end AlgebraicKTheory

end
