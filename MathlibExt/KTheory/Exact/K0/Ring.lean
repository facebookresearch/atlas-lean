module

public import Mathlib.CategoryTheory.Monoidal.Skeleton
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import MathlibExt.CategoryTheory.ExactCategory.Monoidal
public import MathlibExt.KTheory.Exact.K0.Basic

/-!
# Commutative ring structure on K₀

When the tensor product on a braided monoidal exact category is biexact,
it induces a commutative ring structure on `K₀` with
`[X] * [Y] = [X ⊗ Y]` and `1 = [𝟙]`.

-/

@[expose] public section

open CategoryTheory MonoidalCategory Limits

universe v u

namespace AlgebraicKTheory

open CategoryTheory.ExactCategory Limits

variable (C : Type u) [Category.{v} C] [Preadditive C]
  [HasZeroObject C] [HasBinaryBiproducts C] [ExactCategory C]
  [MonoidalCategory C] [BraidedCategory C] [MonoidalPreadditive C] [IsTensorBiexact C]

-- Retain the original free-abelian ring underlying this exact-category quotient.
attribute [local instance] FreeAbelianGroup.instCommRingOfCommMonoid

private lemma freeAbelianGroup_of_mul {M : Type*} [CommMonoid M] (x y : M) :
    FreeAbelianGroup.of x * FreeAbelianGroup.of y = FreeAbelianGroup.of (x * y) := by
  change FreeAbelianGroup.lift
    (fun y ↦ FreeAbelianGroup.lift (fun x ↦ FreeAbelianGroup.of (x * y))
      (FreeAbelianGroup.of x)) (FreeAbelianGroup.of y) = FreeAbelianGroup.of (x * y)
  rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]

/-- The ideal generated by exact-category `K₀` relations. -/
noncomputable def K0Ideal : Ideal (FreeAbelianGroup (Skeleton C)) where
  __ := K0Rel C
  smul_mem' := by
    intro c x hx
    rw [smul_eq_mul]
    induction hx using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨S, hS, rfl⟩ := hy
      have mul_mem : ∀ (s : Skeleton C),
          FreeAbelianGroup.of s *
            (FreeAbelianGroup.of (toSkeleton S.X₂) -
              FreeAbelianGroup.of (toSkeleton S.X₁) -
              FreeAbelianGroup.of (toSkeleton S.X₃)) ∈ K0Rel C := by
        intro s
        have hmul : ∀ (Y : C), s * toSkeleton Y = toSkeleton (Quotient.out s ⊗ Y) := by
          intro Y
          have : toSkeleton (Quotient.out s) = s := Quotient.out_eq s
          calc s * toSkeleton Y
              = toSkeleton (Quotient.out s) * toSkeleton Y := by rw [this]
            _ = toSkeleton (Quotient.out s ⊗ Y) := (Skeleton.toSkeleton_tensorObj _ _).symm
        simp only [mul_sub, freeAbelianGroup_of_mul, hmul]
        apply AddSubgroup.subset_closure
        exact ⟨S.map (tensorLeft (Quotient.out s)),
          IsTensorBiexact.map_tensorLeft _ hS, rfl⟩
      induction c using FreeAbelianGroup.induction_on with
      | zero => simp
      | of s => exact mul_mem s
      | neg s =>
        rw [neg_mul]
        exact (K0Rel C).neg_mem (mul_mem s)
      | add a b ha hb =>
        rw [add_mul]
        exact (K0Rel C).add_mem ha hb
    | zero =>
      simp
    | add a b _ _ iha ihb =>
      rw [mul_add]
      exact (K0Rel C).add_mem iha ihb
    | neg a _ iha =>
      rw [mul_neg]
      exact (K0Rel C).neg_mem iha

noncomputable instance : CommRing (K0 C) :=
  inferInstanceAs (CommRing (FreeAbelianGroup (Skeleton C) ⧸ K0Ideal C))

@[simp] lemma K0.mk_mul (X Y : C) :
    (K0.mk X : K0 C) * K0.mk Y = K0.mk (X ⊗ Y) := by
  simp only [K0.mk, ← freeAbelianGroup_of_mul, Skeleton.toSkeleton_tensorObj]
  rfl

@[simp] lemma K0.one_eq :
    K0.mk (𝟙_ C) = (1 : K0 C) := by
  simp only [K0.mk, Skeleton.one_eq.symm]
  rfl

end AlgebraicKTheory
