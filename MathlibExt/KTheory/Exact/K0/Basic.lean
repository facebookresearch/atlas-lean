module

public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.CategoryTheory.Skeletal
public import MathlibExt.CategoryTheory.ExactCategory.Basic

/-!
# The algebraic K₀ group of an exact category

For an exact category $(𝒞,ℰ)$, its algebraic K₀ group is the quotient of the free
abelian group on isomorphism classes of objects by relations
[Y] = [X] + [Z] for all exact sequences 0 -> X -> Y -> Z -> 0.

Its universal property is as follows : if A is an abelian group and
φ : (Skeleton C) → A is a set-map such that each exact sequence 0 -> X -> Y -> Z -> 0
satisfies φ([Y]) = φ([X]) + φ([Z]), then there exists a unique abelian group morphism
Φ : K₀(𝒞,ℰ) → A

## Main definitions
* `AlgebraicKTheory.K0`
* `AlgebraicKTheory.K0.mk`
* `AlgebraicKTheory.K0.lift`

## Main results
* `AlgebraicKTheory.K0.lift_unique`
* `AlgebraicKTheory.K0.hom_ext`
* `AlgebraicKTheory.K0.mk_eq_of_admissibleExact`
* `AlgebraicKTheory.K0.mk_biprod`
* `AlgebraicKTheory.K0.mk_zero`
* `AlgebraicKTheory.K0.mk_eq_zero_of_isZero`
* `AlgebraicKTheory.K0.subsingleton_of_forall_isZero`

## Implementation notes
`K0 C` depends on the Quillen exact structure, encoded by `[ExactCategory C]`.

## References
* [C. Weibel, *The K-book: Chapter II.7*][weibel-k-book]
* [D. Quillen, *Higher algebraic K-theory: I*][quillen-higher-algk-I]
-/

@[expose] public section

open CategoryTheory Limits
open ZeroObject

universe v u

namespace AlgebraicKTheory

variable (C : Type u) [Category.{v} C] [Preadditive C]
  [HasZeroObject C] [HasBinaryBiproducts C] [ExactCategory C]

/-- The subgroup generated by exact sequence relations -/
def K0Rel : AddSubgroup (FreeAbelianGroup (Skeleton C)) :=
  AddSubgroup.closure
    {x | ∃ S : ShortComplex C, ExactCategory.IsAdmissibleExact S ∧
      x = FreeAbelianGroup.of (toSkeleton S.X₂) - FreeAbelianGroup.of (toSkeleton S.X₁)
      - FreeAbelianGroup.of (toSkeleton S.X₃)}

/-- The K₀ group of an exact category -/
abbrev K0 : Type u := FreeAbelianGroup (Skeleton C) ⧸ K0Rel C

variable {C}

/-- The K₀-class of an object -/
def K0.mk (X : C) : K0 C := QuotientAddGroup.mk (FreeAbelianGroup.of (toSkeleton X))

lemma K0.mk_congr_of_iso {X Y : C} (e : X ≅ Y) :
    (K0.mk X : K0 C) = K0.mk Y := by
  unfold K0.mk
  rw [congr_toSkeleton_of_iso e]

/-- The universal property morphism -/
noncomputable def K0.lift {A : Type*} [AddCommGroup A] (φ : Skeleton C → A)
    (hφ : ∀ S : ShortComplex C, ExactCategory.IsAdmissibleExact S →
      φ (toSkeleton S.X₂) = φ (toSkeleton S.X₁) + φ (toSkeleton S.X₃)) : K0 C →+ A :=
    QuotientAddGroup.lift (K0Rel C) (FreeAbelianGroup.lift φ) (by
      unfold K0Rel
      rw [AddSubgroup.closure_le]
      rintro _ ⟨S, hS, rfl⟩
      simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, FreeAbelianGroup.lift_apply_of]
      rw [hφ S hS]; abel)

@[simp] lemma K0.lift_mk {A : Type*} [AddCommGroup A] (φ : Skeleton C → A)
    (hφ : ∀ S : ShortComplex C, ExactCategory.IsAdmissibleExact S →
      φ (toSkeleton S.X₂) = φ (toSkeleton S.X₁) + φ (toSkeleton S.X₃)) (X : C) :
    K0.lift φ hφ (K0.mk X) = φ (toSkeleton X) := by
  simp only [K0.lift, K0.mk]
  rw [QuotientAddGroup.lift_mk', FreeAbelianGroup.lift_apply_of]

@[ext] lemma K0.hom_ext {A : Type*} [AddCommGroup A] {f g : K0 C →+ A}
    (h : ∀ (X : C), f (K0.mk X) = g (K0.mk X)) :
    f = g := by
  apply QuotientAddGroup.addMonoidHom_ext
  apply FreeAbelianGroup.lift_ext
  intro a
  have ha : toSkeleton (Quotient.out a) = a := Quotient.out_eq a
  have : f (K0.mk (Quotient.out a)) = g (K0.mk (Quotient.out a)) := h _
  simpa [K0.mk, QuotientAddGroup.mk'_apply, ha] using this

lemma K0.lift_unique {A : Type*} [AddCommGroup A] (φ : Skeleton C → A)
    (hφ : ∀ S : ShortComplex C, ExactCategory.IsAdmissibleExact S →
      φ (toSkeleton S.X₂) = φ (toSkeleton S.X₁) + φ (toSkeleton S.X₃))
    (g : K0 C →+ A) (hg : ∀ X : C, g (K0.mk X) = φ (toSkeleton X)) :
    g = K0.lift φ hφ :=
  K0.hom_ext fun X => by rw [hg, K0.lift_mk]

lemma K0.mk_eq_of_admissibleExact {S : ShortComplex C}
    (hS : ExactCategory.IsAdmissibleExact S) :
    K0.mk S.X₂ = K0.mk S.X₁ + K0.mk S.X₃ := by
  rw [K0.mk, K0.mk, K0.mk, ← QuotientAddGroup.mk_add, QuotientAddGroup.eq_iff_sub_mem, ← sub_sub]
  exact AddSubgroup.subset_closure ⟨S, hS, rfl⟩

@[simp] lemma K0.mk_biprod (X Y : C) :
    K0.mk (X ⊞ Y) = K0.mk X + K0.mk Y :=
  K0.mk_eq_of_admissibleExact (ExactCategory.isAdmissibleExact_split X Y)

/-- The class of the zero object vanishes in `K₀`. -/
@[simp] lemma K0.mk_zero : (K0.mk (0 : C) : K0 C) = 0 := by
  have hZero : IsZero (0 : C) := isZero_zero C
  have iso : (0 : C) ≅ (0 : C) ⊞ (0 : C) := isoBiprodZero hZero
  have hBip : K0.mk ((0 : C) ⊞ (0 : C)) = K0.mk (0 : C) + K0.mk (0 : C) :=
    K0.mk_biprod (0 : C) (0 : C)
  have hCong : K0.mk ((0 : C) ⊞ (0 : C)) = K0.mk (0 : C) :=
    K0.mk_congr_of_iso iso.symm
  have hEq : (K0.mk (0 : C) : K0 C) = K0.mk (0 : C) + K0.mk (0 : C) := hCong.symm.trans hBip
  have hAdd : K0.mk (0 : C) + 0 = K0.mk (0 : C) + K0.mk (0 : C) := (add_zero _).trans hEq
  have h0 : (0 : K0 C) = K0.mk (0 : C) := add_left_cancel hAdd
  exact h0.symm

/-- The `K₀`-class of any zero object vanishes. -/
lemma K0.mk_eq_zero_of_isZero {X : C} (hX : IsZero X) : K0.mk X = 0 :=
  (K0.mk_congr_of_iso hX.isoZero).trans K0.mk_zero

/-- If every object of an exact category is zero, then its `K₀` is subsingleton. -/
theorem K0.subsingleton_of_forall_isZero (h : ∀ X : C, IsZero X) :
    Subsingleton (K0 C) := by
  have hId : AddMonoidHom.id (K0 C) = 0 := by
    apply K0.hom_ext
    intro X
    simp only [AddMonoidHom.id_apply, AddMonoidHom.zero_apply,
      K0.mk_eq_zero_of_isZero (h X)]
  constructor
  intro x y
  have hx : x = 0 := by
    calc x = AddMonoidHom.id (K0 C) x := rfl
      _ = (0 : K0 C →+ K0 C) x := by rw [hId]
      _ = 0 := rfl
  have hy : y = 0 := by
    calc y = AddMonoidHom.id (K0 C) y := rfl
      _ = (0 : K0 C →+ K0 C) y := by rw [hId]
      _ = 0 := rfl
  exact hx.trans hy.symm

end AlgebraicKTheory
