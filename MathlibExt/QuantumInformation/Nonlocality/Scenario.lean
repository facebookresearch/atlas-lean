module

public import Mathlib.Data.Fintype.Pi
public import Mathlib.Data.Fintype.BigOperators
public import Mathlib.Data.Fin.Basic
public import Mathlib.Basic.Real.Basic
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise

/-!
# Finite Bell scenarios

Uniform finite Bell scenarios with party, setting, and outcome counts.
Defines setting and outcome assignments, deterministic response functions,
normalized conditional behaviors with extensionality, and the deterministic
behavior construction.
-/

@[expose] public section

open Finset BigOperators

namespace QuantumInformation
namespace Nonlocality

/-- Uniform finite Bell scenario: `n` parties each with `m` settings and `k` outcomes. -/
structure BellScenario where
  /-- The number of parties. -/
  numParties : ℕ
  /-- The number of measurement settings available to each party. -/
  numSettings : ℕ
  /-- The number of outcomes of each measurement. -/
  numOutcomes : ℕ
  deriving DecidableEq

namespace BellScenario

/-- Assignment of a measurement setting to each party. -/
abbrev SettingAssignment (S : BellScenario) := Fin S.numParties → Fin S.numSettings

/-- Assignment of an outcome to each party. -/
abbrev OutcomeAssignment (S : BellScenario) := Fin S.numParties → Fin S.numOutcomes

/-- Deterministic response assigning a fixed outcome to each local setting. -/
abbrev DeterministicResponse (S : BellScenario) :=
  (p : Fin S.numParties) → Fin S.numSettings → Fin S.numOutcomes

instance settingFintype (S : BellScenario) : Fintype S.SettingAssignment :=
  Pi.instFintype

instance outcomeFintype (S : BellScenario) : Fintype S.OutcomeAssignment :=
  Pi.instFintype

instance settingDecEq (S : BellScenario) : DecidableEq S.SettingAssignment :=
  inferInstance

instance outcomeDecEq (S : BellScenario) : DecidableEq S.OutcomeAssignment :=
  inferInstance

instance deterministicResponseFintype (S : BellScenario) : Fintype S.DeterministicResponse :=
  Pi.instFintype

instance deterministicResponseDecEq (S : BellScenario) : DecidableEq S.DeterministicResponse :=
  inferInstance

/-- Outcome assignment induced by a deterministic response and setting choice. -/
def responseToOutcome (S : BellScenario) (f : S.DeterministicResponse)
    (x : S.SettingAssignment) : S.OutcomeAssignment :=
  fun p => f p (x p)

/-- Conditional behavior: for each setting assignment, a distribution over outcome assignments. -/
structure Behavior (S : BellScenario) where
  /-- The probability `prob x y` of outcome assignment `y` given setting assignment `x`. -/
  prob : S.SettingAssignment → S.OutcomeAssignment → ℝ
  nonneg : ∀ x y, 0 ≤ prob x y
  normalized : ∀ x, ∑ y : S.OutcomeAssignment, prob x y = 1

namespace Behavior

theorem ext {S : BellScenario} {B₁ B₂ : Behavior S}
    (h : ∀ x y, B₁.prob x y = B₂.prob x y) : B₁ = B₂ := by
  cases B₁ with
  | mk p₁ h₁₁ h₁₂ =>
    cases B₂ with
    | mk p₂ h₂₁ h₂₂ =>
      simp only at h
      have hp : p₁ = p₂ := funext fun x => funext fun y => h x y
      subst hp
      rfl

end Behavior

/-- The normalized deterministic behavior generated by a deterministic response function.

For each setting assignment `x`, the behavior assigns probability 1 to the outcome
assignment determined by `f` on `x`, modelling a local deterministic strategy. -/
noncomputable def deterministicBehavior (S : BellScenario) (f : S.DeterministicResponse) :
    Behavior S where
  prob := fun x y => if y = S.responseToOutcome f x then 1 else 0
  nonneg := by
    intro x y
    split_ifs
    · exact zero_le_one
    · exact le_rfl
  normalized := by
    intro x
    let y₀ := S.responseToOutcome f x
    have h : (∑ y : S.OutcomeAssignment, if y = y₀ then (1 : ℝ) else 0) = 1 := by
      calc
        (∑ y : S.OutcomeAssignment, if y = y₀ then (1 : ℝ) else 0) =
            ∑ y ∈ (Finset.univ : Finset S.OutcomeAssignment), if y = y₀ then (1 : ℝ) else 0 := by
          rfl
        _ = if y₀ ∈ (Finset.univ : Finset S.OutcomeAssignment) then (1 : ℝ) else 0 := by
          simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
        _ = 1 := by simp
    exact h

theorem deterministicBehavior_prob (S : BellScenario) (f : S.DeterministicResponse)
    (x : S.SettingAssignment) (y : S.OutcomeAssignment) :
    (deterministicBehavior S f).prob x y =
      if y = S.responseToOutcome f x then 1 else 0 := by
  rfl

end BellScenario

end Nonlocality
end QuantumInformation
