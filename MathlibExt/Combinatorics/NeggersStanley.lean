/-!
# A counterexample to Neggers' conjecture

`neggersConjecture_refuted` uses Stembridge's naturally labeled poset on 17 vertices.
Its descent polynomial is computed by choosing successive minimal elements.

The diagram and polynomial are reproduced in Ohsugi and Tsuchiya, *Reflexive polytopes arising
from bipartite graphs with γ-positivity associated to interior polynomials*, Example 3.7
and Figure 5 (https://arxiv.org/abs/1810.12258).

Source: R. P. Stanley, Positivity Problems and Conjectures in Algebraic Combinatorics (1999),
Problem 20 (Neggers–Stanley conjecture). UnsolvedMath record UM-00801194 (`AMR-156-0020`), dataset
ulamai/UnsolvedMath v1.8.0.

The poset lives on the labels `Fin n` and is given by a relation `R` (`R i j` meaning `i <_P j`)
with `R i j → i < j`, i.e. the labeling is natural; linear extensions of `R` and of its transitive
closure coincide, so transitivity is not imposed. The natural-labeling case is Neggers' original
conjecture; refuting it refutes Stanley's extension to arbitrary labelings. A linear extension is a
permutation `w` (the word `w 0, …, w (n - 1)`) with `w a` before `w b` whenever `R (w a) (w b)`, and
`d(w)` counts the `i` with `w i > w (i + 1)`. `W(P, x)` is nonzero (the identity is a linear
extension), so real-rootedness is `Polynomial.IsRealRooted` (MathlibExt) of its image in `ℂ[x]`.
Stembridge's `W_P(t) = ∑ t^{d(w)+1}` differs by the factor `t`.
-/

@[expose] public section

namespace MathlibExt.Combinatorics.NeggersStanleyPosetConjectureAMR156Problem0020Wanted

/-- **Number of descents of a permutation of $\{0, \dots, n-1\}$.** For a permutation $w$ of
$\{0, 1, \dots, n-1\}$, read as the word $w(0)\,w(1) \cdots w(n-1)$, the number of descents
$d(w)$ is the number of indices $i$ with $i + 1 < n$ and $w(i) > w(i+1)$. -/
abbrev descentCount {n : ℕ} (w : Equiv.Perm (Fin n)) : ℕ :=
  -- Unfold the shared count once to preserve the body of the original declaration.
  delta% MetaMathlibExt.permDescents w

open Classical in
/-- **The $W$-polynomial of a labeled poset.** Let $R$ be a relation on the labels
$\{0, 1, \dots, n-1\}$, with $R(i, j)$ read as $i <_P j$ in the poset $P$ it generates. A linear
extension of $P$ is a permutation $w$ of the labels such that $a < b$ whenever $R(w(a), w(b))$,
that is, a word $w(0)\,w(1) \cdots w(n-1)$ listing every label once with $w(a)$ before $w(b)$
whenever $R(w(a), w(b))$. The $W$-polynomial is the integer polynomial
$W(P, x) = \sum_w x^{d(w)}$, summed over the linear extensions $w$ of $P$, where $d(w)$ is the
number of descents of $w$.

Linear extensions of $R$ and of its transitive closure coincide, so $R$ need not be transitive. -/
noncomputable def wPolynomial {n : ℕ} (R : Fin n → Fin n → Prop) : Polynomial ℤ :=
  ∑ w : Equiv.Perm (Fin n) with ∀ a b, R (w a) (w b) → a < b, Polynomial.X ^ descentCount w

/-- **Neggers' conjecture.** For every $n$ and every relation $R$ on the labels
$\{0, 1, \dots, n-1\}$ that is naturally labeled, meaning that $R(i, j)$ implies $i < j$, every
complex zero of the $W$-polynomial $W(P, x)$ of the poset $P$ generated by $R$ is real.

This is Stanley, Positivity Problems, Problem 20, for naturally labeled posets. -/
def neggersConjecture : Prop :=
  ∀ (n : ℕ) (R : Fin n → Fin n → Prop), (∀ i j, R i j → i < j) →
    ((wPolynomial R).map (Int.castRingHom ℂ)).IsRealRooted

open Polynomial

-- At each step only a minimal remaining label can start the word.
private def minima {α : Type*} (r : α → α → Bool) (s : List α) : List α :=
  s.filter fun a => !(s.any fun b => r b a)

private theorem mem_minima {α : Type*} {r : α → α → Bool} {s : List α} {a : α} :
    a ∈ minima r s ↔ a ∈ s ∧ ∀ b ∈ s, r b a = false := by
  simp [minima]

private def words {α : Type*} [DecidableEq α] (r : α → α → Bool) :
    ℕ → List α → List (List α)
  | 0, _ => [[]]
  | k + 1, s => (minima r s).flatMap fun a => (words r k (s.erase a)).map (a :: ·)

private theorem words_nodup {α : Type*} [DecidableEq α] (r : α → α → Bool)
    (k : ℕ) {s : List α} (hs : s.Nodup) : (words r k s).Nodup := by
  induction k generalizing s with
  | zero => simp [words]
  | succ k ih =>
    apply List.nodup_flatMap.mpr
    refine ⟨fun a _ => (ih (hs.erase a)).map List.cons_injective, ?_⟩
    apply (hs.filter _).imp
    intro a b hab w hw hw'
    obtain ⟨_, _, rfl⟩ := List.mem_map.mp hw
    obtain ⟨_, _, he⟩ := List.mem_map.mp hw'
    exact hab (List.cons.inj he).1.symm

private theorem mem_words {α : Type*} [DecidableEq α] (r : α → α → Bool)
    (hirr : ∀ a, r a a = false) (k : ℕ) {s w : List α} (hs : s.length = k) :
    w ∈ words r k s ↔ w.Perm s ∧ w.Pairwise (fun a b => r b a = false) := by
  induction k generalizing s w with
  | zero =>
    obtain rfl := List.length_eq_zero_iff.mp hs
    cases w <;> simp [words]
  | succ k ih =>
    simp only [words, List.mem_flatMap, List.mem_map]
    cases w with
    | nil =>
      have hn : s ≠ [] := by
        rintro rfl
        simp at hs
      simp [hn, List.nil_perm]
    | cons a t =>
      constructor
      · rintro ⟨b, hb, u, hu, he⟩
        obtain ⟨rfl, rfl⟩ := List.cons.inj he
        obtain ⟨hb, hmin⟩ := mem_minima.mp hb
        obtain ⟨hp, ho⟩ := (ih (by simp [List.length_erase_of_mem hb, hs])).mp hu
        have hp' := (hp.cons b).trans (List.perm_cons_erase hb).symm
        exact ⟨hp', List.pairwise_cons.mpr ⟨fun x hx => hmin x
          (hp'.mem_iff.mp (List.mem_cons_of_mem _ hx)), ho⟩⟩
      · rintro ⟨hp, ho⟩
        have ha := hp.mem_iff.mp List.mem_cons_self
        obtain ⟨hhead, htail⟩ := List.pairwise_cons.mp ho
        refine ⟨a, mem_minima.mpr ⟨ha, fun b hb => ?_⟩, t, ?_, rfl⟩
        · rcases List.mem_cons.mp (hp.mem_iff.mpr hb) with rfl | hb
          · exact hirr _
          · exact hhead _ hb
        · apply (ih (by simp [List.length_erase_of_mem ha, hs])).mpr
          exact ⟨(List.perm_cons a).mp (hp.trans (List.perm_cons_erase ha)), htail⟩

-- Include the comparison with the preceding label; a preceding zero starts a word
-- without introducing a descent.
private def drops {n : ℕ} (prev : Fin n) : List (Fin n) → ℕ
  | [] => 0
  | a :: t => (if a < prev then 1 else 0) + drops a t

private theorem drops_ofFn {n m : ℕ} (prev : Fin n) (f : Fin m → Fin n) :
    drops prev (List.ofFn f) = (if ∃ h : 0 < m, f ⟨0, h⟩ < prev then 1 else 0) +
      (Finset.univ.filter fun i : Fin m =>
        ∃ h : i.val + 1 < m, f ⟨i.val + 1, h⟩ < f i).card := by
  induction m generalizing prev with
  | zero => simp [drops]
  | succ m ih =>
    rw [List.ofFn_succ, drops, ih, Fin.card_filter_univ_succ']
    apply congrArg₂ (· + ·)
    · apply if_congr _ rfl rfl
      exact ⟨fun h => ⟨Nat.zero_lt_succ _, h⟩, fun ⟨_, h⟩ => h⟩
    · apply congrArg₂ (· + ·)
      · apply if_congr _ rfl rfl
        exact ⟨fun ⟨h, hd⟩ => ⟨Nat.succ_lt_succ h, hd⟩,
          fun ⟨h, hd⟩ => ⟨Nat.lt_of_succ_lt_succ h, hd⟩⟩
      · apply congrArg Finset.card
        ext i
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨fun ⟨h, hd⟩ => ⟨Nat.succ_lt_succ h, hd⟩,
          fun ⟨h, hd⟩ => ⟨Nat.lt_of_succ_lt_succ h, hd⟩⟩

private theorem drops_eq_descentCount {n : ℕ} [NeZero n] (w : Equiv.Perm (Fin n)) :
    drops 0 (List.ofFn w) = descentCount w := by
  rw [drops_ofFn]
  simp [descentCount]

-- Add coefficient lists, padding the shorter list with zeros.
private abbrev addCoeffs (p q : List ℤ) :=
  List.zipWithAll (fun a b => a.getD 0 + b.getD 0) p q

private def coefficients {n : ℕ} (r : Fin n → Fin n → Bool) :
    ℕ → List (Fin n) → Fin n → List ℤ
  | 0, _, _ => [1]
  | k + 1, s, prev => (minima r s).foldr (fun a acc =>
      let cs := coefficients r k (s.erase a) a
      addCoeffs (if a < prev then 0 :: cs else cs) acc) []

private theorem coefficients_spec {n : ℕ} (r : Fin n → Fin n → Bool) (k : ℕ)
    (s : List (Fin n)) (prev : Fin n) :
    ofCoeffList (coefficients r k s prev) =
      ((words r k s).map fun w => (X : ℤ[X]) ^ drops prev w).sum := by
  induction k generalizing s prev with
  | zero => simp [coefficients, words, drops, ofCoeffList_cons]
  | succ k ih =>
    simp only [coefficients, words]
    induction minima r s with
    | nil => simp
    | cons a l hl =>
      simp only [List.foldr_cons, List.flatMap_cons, List.map_append, List.sum_append,
        List.map_map]
      rw [ofCoeffList_zipWithAll_add, hl]
      by_cases h : a < prev
      · simp [h, ih, Function.comp_def, drops, pow_add, List.sum_map_mul_left]
      · simp [h, ih, Function.comp_def, drops]

private theorem linear_iff_pairwise {n : ℕ} (r : Fin n → Fin n → Bool)
    (hirr : ∀ a, r a a = false) (w : Equiv.Perm (Fin n)) :
    (∀ a b, r (w a) (w b) = true → a < b) ↔
      (List.ofFn w).Pairwise (fun a b => r b a = false) := by
  rw [List.pairwise_ofFn]
  constructor
  · intro h i j hij
    cases he : r (w j) (w i) with
    | false => rfl
    | true => exact (hij.asymm (h _ _ he)).elim
  · intro h a b hab
    by_contra! hba
    rcases hba.eq_or_lt with rfl | hlt
    · simp [hirr] at hab
    · simp [h hlt] at hab

private theorem wPolynomial_eq {n : ℕ} [NeZero n] (r : Fin n → Fin n → Bool)
    (hirr : ∀ a, r a a = false) :
    wPolynomial (fun a b => r a b = true) =
      ofCoeffList (coefficients r n (List.finRange n) 0) := by
  classical
  let ws := words r n (List.finRange n)
  let W : Finset (List (Fin n)) := ⟨ws, words_nodup r n (List.nodup_finRange n)⟩
  have hW (w : List (Fin n)) : w ∈ W ↔
      w.Perm (List.finRange n) ∧ w.Pairwise (fun a b => r b a = false) :=
    mem_words r hirr n List.length_finRange
  rw [coefficients_spec]
  change _ = ∑ w ∈ W, X ^ drops 0 w
  unfold wPolynomial
  apply Finset.sum_bij (fun (w : Equiv.Perm (Fin n)) _ => List.ofFn w)
  · intro w hw
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hw
    exact (hW _).mpr ⟨w.ofFn_comp_perm id, (linear_iff_pairwise r hirr w).mp hw⟩
  · intro w _ v _ he
    exact Equiv.ext (congrFun (List.ofFn_injective he))
  · intro l hl
    obtain ⟨hp, ho⟩ := (hW _).mp hl
    have hlen : l.length = n := hp.length_eq.trans List.length_finRange
    let w := (finCongr hlen.symm).trans
      ((hp.nodup_iff.mpr (List.nodup_finRange n)).getEquivOfForallMemList l
        (fun a => hp.mem_iff.mpr (List.mem_finRange a)))
    have hw : List.ofFn w = l := (List.ofFn_congr hlen l.get).symm.trans (List.ofFn_get l)
    refine ⟨w, ?_, hw⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact (linear_iff_pairwise r hirr w).mpr (hw ▸ ho)
  · intro w _
    rw [drops_eq_descentCount]

-- Cover relations in Stembridge's diagram (with labels reduced by one).
-- The two vertical chains consist of the even and the odd labels, respectively.
private def covers (i j : Fin 17) : Bool :=
  let a := i.val
  let b := j.val
  (b == a + 2) || (a % 2 == 1 && a ≤ 11 && b == a + 1) ||
    (a == 13 && b == 16) || (a % 2 == 0 && a ≤ 4 && b == a + 11)

private def stembridgeCoeffs : List ℤ := [1, 32, 336, 1420, 2534, 1946, 658, 86, 3]

private theorem coefficients_example :
    coefficients covers 17 (List.finRange 17) 0 = stembridgeCoeffs := by decide +kernel

-- Moving away from the real axis increases the squared distance to each real root.
private theorem normSq_eval_le (p : ℂ[X]) (h : p.IsRealRooted) (z : ℂ) :
    Complex.normSq (p.eval z.re) ≤ Complex.normSq (p.eval z) := by
  simp only [(IsAlgClosed.splits p).eval_eq_prod_roots, map_mul, map_multiset_prod,
    Multiset.map_map]
  apply mul_le_mul_of_nonneg_left _ (Complex.normSq_nonneg _)
  apply Multiset.prod_map_le_prod_map₀ _ _ (fun _ _ => Complex.normSq_nonneg _)
  intro a ha
  simp only [Function.comp_apply, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
    Complex.ofReal_re, Complex.ofReal_im, h a ha, sub_zero, mul_zero, add_zero]
  nlinarith [sq_nonneg z.im]

/--
**Neggers' conjecture is false.** There exist $n$ and a naturally labeled relation $R$ on the
labels $\{0, 1, \dots, n-1\}$, one in which $R(i, j)$ implies $i < j$, such that the
$W$-polynomial $W(P, x)$ of the poset $P$ generated by $R$ has a complex zero that is not real.

Stembridge found naturally labeled posets on $17$ elements whose $W$-polynomials have non-real
zeros, disproving Neggers' conjecture and hence the Neggers–Stanley conjecture (Brändén had
earlier given counterexamples with non-natural labelings).

Source: R. P. Stanley,
Positivity Problems and Conjectures in Algebraic Combinatorics (1999), Problem 20 (Neggers–Stanley
conjecture); resolution: J. R. Stembridge, Counterexamples to the poset conjectures of Neggers,
Stanley, and Stembridge, Trans. Amer. Math. Soc. 359 (2007), 1115-1128; P. Brändén, Counterexamples
to the Neggers-Stanley conjecture, Electron. Res. Announc. Amer. Math. Soc. 10 (2004), 155-158
(non-natural labelings), Stembridge, Introduction: there exist naturally labeled narrow posets on 17
vertices whose W-polynomials have non-real zeros (and none smaller), disproving Neggers' original
conjecture; Figure 1 gives one, with W-polynomial t + 32t² + 336t³ + 1420t⁴ + 2534t⁵ + 1946t⁶ +
658t⁷ + 86t⁸ + 3t⁹, https://websites.umich.edu/~jrs/papers/pocon.pdf.
-/
public theorem neggersConjecture_refuted : ¬ neggersConjecture := by
  intro hc
  have hnat : ∀ i j : Fin 17, covers i j = true → i < j := by decide
  have h := hc 17 (fun i j => covers i j = true) hnat
  rw [wPolynomial_eq covers (by decide), coefficients_example] at h
  -- At this rational complex point the squared modulus is smaller than on the real axis.
  let z : ℂ := ⟨-13 / 7, 1 / 7⟩
  have hle := normSq_eval_le _ h z
  norm_num [stembridgeCoeffs, map_ofCoeffList, ofCoeffList_cons, Complex.normSq_apply,
    Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im, z] at hle

end MathlibExt.Combinatorics.NeggersStanleyPosetConjectureAMR156Problem0020Wanted
