namespace MathlibExt.Combinatorics.Graph.ArcNetworkLaplacian

/-!
# Weighted Laplacians of arc networks and their grounded blocks

## Overview

For a finite arc network with head-positive incidence matrix
`B = incidenceMatrix tail head` (see `ArcNetwork`) and real arc weights `w`, the
weighted Laplacian is `B * diagonal w * Bᵀ`. This file proves the energy
identity for its quadratic form, characterizes its kernel for nonnegative
weights through the connected components of the graph of positive-weight arcs,
and shows that deleting the row and column of a ground node `r` leaves a
positive definite (hence invertible) matrix as soon as every node is reachable
from `r` through positive-weight arcs.

The weighted Laplacian is written out as the explicit product rather than given
a new name, so that tail-positive incidences `-B` (as used in circuit analysis)
reduce to it by cancelling the two signs. Zero-weight arcs are allowed; they
contribute nothing and do not count for connectivity. Loops contribute nothing
either. Arcs are indexed by an arbitrary finite type, so parallel and
antiparallel arcs are allowed.

## Main definitions

- `positiveArcGraph tail head w`: the simple graph on the nodes generated by the
  arcs of positive weight, ignoring orientation.

## Key results

- `dotProduct_weightedLaplacian_mulVec`: the energy identity
  `x ⬝ᵥ (B * diagonal w * Bᵀ) *ᵥ x = ∑ e, w e * (x (head e) - x (tail e)) ^ 2`.
- `weightedLaplacian_mulVec_eq_zero_iff`: for nonnegative weights, `L *ᵥ x = 0`
  iff `x` is constant on every component of `positiveArcGraph`.
- `weightedLaplacian_mulVec_eq_zero_iff_of_reachable`: with every node reachable
  from `r`, the kernel is the constant vectors.
- `grounded_weightedLaplacian_posDef`: nonnegative weights and every node
  reachable from `r` make the ground-deleted Laplacian positive definite.
- `grounded_weightedLaplacian_isUnit`: the ground-deleted Laplacian is
  invertible under the same hypotheses.

## References

- C. Godsil and G. Royle, *Algebraic Graph Theory*, Graduate Texts in
  Mathematics 207, Springer, 2001, Chapter 13 (the Laplacian as `B Bᵀ` and its
  kernel).
- B. Bollobás, *Modern Graph Theory*, Graduate Texts in Mathematics 184,
  Springer, 1998, Chapter II (electrical networks and grounded potentials).
-/

open Matrix MathlibExt.Combinatorics.Graph.ArcNetwork

/-- The undirected graph on the nodes generated by the arcs of positive weight:
`u` and `v` are adjacent iff `u ≠ v` and some arc of positive weight joins them in
either direction. -/
def positiveArcGraph {V E : Type*} (tail head : E → V) (w : E → ℝ) : SimpleGraph V :=
  SimpleGraph.fromRel fun u v => ∃ e, 0 < w e ∧ tail e = u ∧ head e = v

variable {V E : Type*} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

/-- The transposed incidence matrix reads the potential difference across an
arc: `(Bᵀ *ᵥ x) e = x (head e) - x (tail e)`. -/
theorem incidenceMatrix_transpose_mulVec_apply (tail head : E → V) (x : V → ℝ) (e : E) :
    ((incidenceMatrix tail head)ᵀ *ᵥ x) e = x (head e) - x (tail e) := by
  simp [Matrix.mulVec, dotProduct, incidenceMatrix, sub_mul, Finset.sum_sub_distrib]

/-- **Energy identity.** The quadratic form of the weighted Laplacian is the
weighted sum of squared potential differences across the arcs. -/
theorem dotProduct_weightedLaplacian_mulVec (tail head : E → V) (w : E → ℝ) (x : V → ℝ) :
    x ⬝ᵥ ((incidenceMatrix tail head * diagonal w * (incidenceMatrix tail head)ᵀ) *ᵥ x) =
      ∑ e, w e * (x (head e) - x (tail e)) ^ 2 := by
  rw [← mulVec_mulVec, ← mulVec_mulVec, dotProduct_mulVec, ← mulVec_transpose]
  simp only [dotProduct, mulVec_diagonal, incidenceMatrix_transpose_mulVec_apply]
  refine Finset.sum_congr rfl fun e _ => ?_
  ring

/-- The weighted Laplacian is symmetric (Hermitian over `ℝ`). -/
theorem weightedLaplacian_isHermitian (tail head : E → V) (w : E → ℝ) :
    (incidenceMatrix tail head * diagonal w * (incidenceMatrix tail head)ᵀ).IsHermitian := by
  have h := isHermitian_mul_mul_conjTranspose (incidenceMatrix tail head)
    (isHermitian_diagonal (n := E) w)
  simpa [conjTranspose_eq_transpose_of_trivial] using h

omit [Fintype V] [DecidableEq V] [DecidableEq E] in
/-- Zero energy with nonnegative weights forces equal potentials at any two
nodes joined by a walk of positive-weight arcs. -/
theorem eq_of_energy_eq_zero (tail head : E → V) (w : E → ℝ) (hw : ∀ e, 0 ≤ w e)
    (x : V → ℝ) (h0 : ∑ e, w e * (x (head e) - x (tail e)) ^ 2 = 0) {u v : V}
    (huv : (positiveArcGraph tail head w).Reachable u v) : x u = x v := by
  have hterm : ∀ e, w e * (x (head e) - x (tail e)) ^ 2 = 0 := fun e =>
    (Finset.sum_eq_zero_iff_of_nonneg (fun e _ => mul_nonneg (hw e) (sq_nonneg _))).mp h0 e
      (Finset.mem_univ e)
  have harc : ∀ e, 0 < w e → x (tail e) = x (head e) := by
    intro e he
    rcases mul_eq_zero.mp (hterm e) with h | h
    · exact absurd h he.ne'
    · have := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h
      linarith
  have hadj : ∀ a b, (positiveArcGraph tail head w).Adj a b → x a = x b := by
    intro a b hab
    rcases (SimpleGraph.fromRel_adj _ a b).mp hab with
      ⟨_, ⟨e, he, hta, hhb⟩ | ⟨e, he, htb, hha⟩⟩
    · rw [← hta, ← hhb]
      exact harc e he
    · rw [← htb, ← hha]
      exact (harc e he).symm
  obtain ⟨p⟩ := huv
  induction p with
  | nil => rfl
  | cons hab _ ih => exact (hadj _ _ hab).trans ih

/-- **Kernel of the weighted Laplacian.** With nonnegative weights, `L *ᵥ x = 0`
iff `x` is constant on every connected component of the positive-weight arc
graph. -/
theorem weightedLaplacian_mulVec_eq_zero_iff (tail head : E → V) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (x : V → ℝ) :
    (incidenceMatrix tail head * diagonal w * (incidenceMatrix tail head)ᵀ) *ᵥ x = 0 ↔
      ∀ u v, (positiveArcGraph tail head w).Reachable u v → x u = x v := by
  constructor
  · intro hL u v huv
    have h0 := dotProduct_weightedLaplacian_mulVec tail head w x
    rw [hL, dotProduct_zero] at h0
    exact eq_of_energy_eq_zero tail head w hw x h0.symm huv
  · intro hc
    have hflow : diagonal w *ᵥ ((incidenceMatrix tail head)ᵀ *ᵥ x) = 0 := by
      funext e
      rw [mulVec_diagonal, incidenceMatrix_transpose_mulVec_apply, Pi.zero_apply]
      rcases (hw e).lt_or_eq with he | he
      · by_cases hte : tail e = head e
        · rw [hte, sub_self, mul_zero]
        · have hadj : (positiveArcGraph tail head w).Adj (tail e) (head e) :=
            (SimpleGraph.fromRel_adj _ _ _).mpr ⟨hte, Or.inl ⟨e, he, rfl, rfl⟩⟩
          rw [hc _ _ hadj.reachable, sub_self, mul_zero]
      · rw [← he, zero_mul]
    rw [← mulVec_mulVec, ← mulVec_mulVec, hflow, mulVec_zero]

/-- With nonnegative weights and every node reachable from `r` through
positive-weight arcs, `L *ᵥ x = 0` iff `x` is constant, i.e. `x v = x r` for
every node `v`. -/
theorem weightedLaplacian_mulVec_eq_zero_iff_of_reachable (tail head : E → V) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (r : V) (hconn : ∀ v, (positiveArcGraph tail head w).Reachable r v)
    (x : V → ℝ) :
    (incidenceMatrix tail head * diagonal w * (incidenceMatrix tail head)ᵀ) *ᵥ x = 0 ↔
      ∀ v, x v = x r := by
  rw [weightedLaplacian_mulVec_eq_zero_iff tail head w hw]
  exact ⟨fun h v => (h r v (hconn v)).symm, fun h u v _ => by rw [h u, h v]⟩

/-- The quadratic form of a ground-deleted matrix is the full quadratic form on
the extension of the vector by zero at the ground node. -/
private theorem grounded_quadratic_eq (M : Matrix V V ℝ) (r : V) (y : {v // v ≠ r} → ℝ) :
    y ⬝ᵥ (M.submatrix (Subtype.val : {v // v ≠ r} → V) Subtype.val *ᵥ y) =
      (fun v => if h : v = r then 0 else y ⟨v, h⟩) ⬝ᵥ
        (M *ᵥ fun v => if h : v = r then 0 else y ⟨v, h⟩) := by
  set x : V → ℝ := fun v => if h : v = r then 0 else y ⟨v, h⟩ with hxdef
  have hx : ∀ i : {v // v ≠ r}, x i = y i := fun i => by simp [hxdef, i.2]
  have hxr : x r = 0 := by simp [hxdef]
  have key : ∀ f : V → ℝ, f r = 0 → ∑ v, f v = ∑ i : {v // v ≠ r}, f i := by
    intro f hf
    rw [Fintype.sum_eq_add_sum_subtype_ne f r, hf, zero_add]
  have hinner : ∀ u : V, (M *ᵥ x) u = ∑ j : {v // v ≠ r}, M u j * y j := by
    intro u
    simp only [mulVec, dotProduct]
    rw [key _ (by simp [hxr])]
    exact Finset.sum_congr rfl fun j _ => by rw [hx]
  simp only [dotProduct]
  rw [key _ (by simp [hxr])]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [hx, hinner]
  simp [mulVec, dotProduct, submatrix_apply]

/-- **Grounded weighted Laplacian is positive definite.** Nonnegative arc weights
and every node reachable from the ground `r` through positive-weight arcs make
the weighted Laplacian with the row and column of `r` deleted positive definite. -/
theorem grounded_weightedLaplacian_posDef (tail head : E → V) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (r : V) (hconn : ∀ v, (positiveArcGraph tail head w).Reachable r v) :
    ((incidenceMatrix tail head * diagonal w * (incidenceMatrix tail head)ᵀ).submatrix
      (Subtype.val : {v // v ≠ r} → V) Subtype.val).PosDef := by
  refine PosDef.of_dotProduct_mulVec_pos
    ((weightedLaplacian_isHermitian tail head w).submatrix _) fun y hy => ?_
  rw [star_trivial, grounded_quadratic_eq, dotProduct_weightedLaplacian_mulVec]
  set x : V → ℝ := fun v => if h : v = r then 0 else y ⟨v, h⟩ with hxdef
  refine lt_of_le_of_ne
    (Finset.sum_nonneg fun e _ => mul_nonneg (hw e) (sq_nonneg _)) fun h0 => hy ?_
  funext i
  have hxr : x r = 0 := by simp [hxdef]
  have hxi : x i = y i := by simp [hxdef, i.2]
  rw [Pi.zero_apply, ← hxi, ← eq_of_energy_eq_zero tail head w hw x h0.symm (hconn i), hxr]

/-- The grounded weighted Laplacian is invertible under the hypotheses of
`grounded_weightedLaplacian_posDef`. -/
theorem grounded_weightedLaplacian_isUnit (tail head : E → V) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (r : V) (hconn : ∀ v, (positiveArcGraph tail head w).Reachable r v) :
    IsUnit ((incidenceMatrix tail head * diagonal w * (incidenceMatrix tail head)ᵀ).submatrix
      (Subtype.val : {v // v ≠ r} → V) (Subtype.val : {v // v ≠ r} → V)) :=
  (grounded_weightedLaplacian_posDef tail head w hw r hconn).isUnit

/-- With strictly positive weights `r`, the `r`-weighted
arc graph is the constant-weight (underlying) graph. -/
theorem positiveArcGraph_eq_of_pos {V E : Type*} (tail head : E → V)
    {r : E → ℝ} (hr : ∀ e, 0 < r e) :
    positiveArcGraph tail head r
      = positiveArcGraph tail head (fun _ => (1 : ℝ)) := by
  ext u v
  simp only [positiveArcGraph, SimpleGraph.fromRel_adj]
  constructor
  · rintro ⟨hne, ⟨e, _, ht, hh⟩ | ⟨e, _, ht, hh⟩⟩
    · exact ⟨hne, Or.inl ⟨e, zero_lt_one, ht, hh⟩⟩
    · exact ⟨hne, Or.inr ⟨e, zero_lt_one, ht, hh⟩⟩
  · rintro ⟨hne, ⟨e, _, ht, hh⟩ | ⟨e, _, ht, hh⟩⟩
    · exact ⟨hne, Or.inl ⟨e, hr e, ht, hh⟩⟩
    · exact ⟨hne, Or.inr ⟨e, hr e, ht, hh⟩⟩

end MathlibExt.Combinatorics.Graph.ArcNetworkLaplacian
