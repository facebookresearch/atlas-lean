/-!
# The Buys–Polak–Zuiddam lower bound for the twenty-one-cycle

BPZ profiles and the twenty-one-cycle root-rate bound. The bound follows from the stronger
bound `11466 ^ (1/4)`, given by the authors' independent set of `26 * 21 ^ 2 = 11466` words in
the fourth strong power of the 21-cycle: the union of 26 cosets of the subgroup of
`(ZMod 21) ^ 4` generated by `(1, 0, 0, 2)` and `(0, 1, 2, 0)`.

Source: Pjotr Buys, Sven Polak and Jeroen Zuiddam,
*Lean-verified lower bounds for the Shannon capacity of odd cycles*, arXiv:2607.29681v1
(2026), for the profiles and the bound; the coset code is from the authors' Lean repository
https://github.com/spectra-research/shannon-capacity-lean, revision
aa21eeb12b75b0413d3fa9fb4208b5d0bf2c4d65, `ShannonBounds/BaseC21CosetData.lean` and
`ShannonBounds/CosetC21.lean`.
-/

@[expose] public section

namespace MathlibExt.Combinatorics.Coding.CycleShannonBoundsWanted

open MathlibExt.Combinatorics.Coding.CycleGraphCode

/-- **BPZ profiles.** A BPZ profile is an arbitrary quadruple of integers, called its code,
pairs, auxiliary and neutral coordinates: the four integer coordinates propagated by the
valid-tuple product of Buys, Polak and Zuiddam. No validity condition is imposed on the
quadruple.

Source: BPZ, arXiv:2607.29681, valid-tuple profiles. -/
structure BPZProfile where
  code : ℤ
  pairs : ℤ
  auxiliary : ℤ
  neutral : ℤ
  deriving DecidableEq, Repr

/-- **Product of BPZ profiles.** For $i = 1, 2$ let $p_i = (c_i, \pi_i, a_i, z_i)$ be a BPZ
profile, with integer code, pairs, auxiliary and neutral coordinates. The product $p_1 \star p_2$
is the BPZ profile with code coordinate $(c_1 - \pi_1)(c_2 - \pi_2) + a_1 \pi_2 + \pi_1 a_2$,
pairs coordinate $z_1 \pi_2 + \pi_1 z_2$, auxiliary coordinate $a_1 a_2$ and neutral coordinate
$z_1 z_2 + (a_1 - z_1)(a_2 - z_2)$.

The product is arithmetic on the four coordinates only; it does not supply an independent set.

Source: BPZ, arXiv:2607.29681, the profile product. -/
def BPZProfile.star (p₁ p₂ : BPZProfile) : BPZProfile where
  code :=
    (p₁.code - p₁.pairs) * (p₂.code - p₂.pairs) +
      p₁.auxiliary * p₂.pairs + p₁.pairs * p₂.auxiliary
  pairs := p₁.neutral * p₂.pairs + p₁.pairs * p₂.neutral
  auxiliary := p₁.auxiliary * p₂.auxiliary
  neutral :=
    p₁.neutral * p₂.neutral +
      (p₁.auxiliary - p₁.neutral) * (p₂.auxiliary - p₂.neutral)

/-- **Iterated squaring of BPZ profiles.** Write $\star$ for the BPZ profile product. For a
natural number $k$ and a BPZ profile $p$, the $k$-fold iterated square $S_k(p)$ is defined by
$S_0(p) = p$ and $S_{k+1}(p) = S_k(p \star p)$; that is, $S_k(p)$ is obtained from $p$ by
squaring $k$ times under $\star$.

Source: BPZ, arXiv:2607.29681, iterated profile products. -/
def bpzProfileSquareIter : ℕ → BPZProfile → BPZProfile
  | 0, p => p
  | k + 1, p => bpzProfileSquareIter k (p.star p)

/-- **Buys–Polak–Zuiddam one-block profile for the 21-cycle.** This is the Buys–Polak–Zuiddam
(BPZ) profile whose code, pairs, auxiliary and neutral coordinates are $11441$, $10$,
$11441$ and $11398$.

Only these four integers are recorded, not BPZ's four-dimensional construction behind them.

Source: BPZ, arXiv:2607.29681, twenty-one-cycle construction. -/
def bpzC21Pi1 : BPZProfile := ⟨11441, 10, 11441, 11398⟩

/-- **Buys–Polak–Zuiddam 1024-block profile for the 21-cycle.** Let $p_0$ be the one-block
21-cycle profile, whose code, pairs, auxiliary and neutral coordinates are $11441$, $10$,
$11441$ and $11398$, and let $p_{j+1} = p_j \star p_j$, where $\star$ is the
Buys–Polak–Zuiddam (BPZ) profile product. This profile is $p_{10}$, the result of squaring
$p_0$ ten times.

Source: BPZ, arXiv:2607.29681, twenty-one-cycle construction. -/
def bpzC21Pi1024 : BPZProfile := bpzProfileSquareIter 10 bpzC21Pi1

private def quotientCode : Fin 26 → ZMod 21 × ZMod 21 :=
  ![⟨0, 2⟩, ⟨1, 19⟩, ⟨2, 15⟩, ⟨3, 6⟩, ⟨3, 10⟩, ⟨4, 2⟩,
    ⟨5, 19⟩, ⟨6, 15⟩, ⟨7, 7⟩, ⟨7, 11⟩, ⟨8, 3⟩, ⟨9, 20⟩,
    ⟨10, 16⟩, ⟨11, 8⟩, ⟨11, 12⟩, ⟨12, 4⟩, ⟨13, 0⟩, ⟨14, 17⟩,
    ⟨15, 13⟩, ⟨16, 5⟩, ⟨16, 9⟩, ⟨17, 1⟩, ⟨18, 18⟩, ⟨19, 14⟩, ⟨20, 6⟩, ⟨20, 10⟩]

private abbrev NearZero (a : ZMod 21) : Prop := a = -1 ∨ a = 0 ∨ a = 1

private theorem quotient_injective : Function.Injective quotientCode := by
  decide +kernel

private theorem quotient_certificate (i j : Fin 26) (a b : ZMod 21)
    (ha : NearZero a) (hb : NearZero b)
    (hy : NearZero (2 * b + (quotientCode i).1 - (quotientCode j).1))
    (hz : NearZero (2 * a + (quotientCode i).2 - (quotientCode j).2)) :
    i = j ∧ a = 0 ∧ b = 0 := by
  rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl <;>
    revert i j <;> decide +kernel

private def encode (p : Fin 26 × (ZMod 21 × ZMod 21)) : Fin 4 → ZMod 21 :=
  ![p.2.1, p.2.2, 2 * p.2.2 + (quotientCode p.1).1,
    2 * p.2.1 + (quotientCode p.1).2]

private theorem encode_injective : Function.Injective encode := by
  intro p q h
  have hu : p.2.1 = q.2.1 := congrFun h 0
  have hv : p.2.2 = q.2.2 := congrFun h 1
  have hy := congrFun h 2
  have hz := congrFun h 3
  simp only [encode, Matrix.cons_val_two, Matrix.cons_val_three] at hy hz
  rw [hv] at hy
  rw [hu] at hz
  have hi := quotient_injective (Prod.ext (add_left_cancel hy) (add_left_cancel hz))
  exact Prod.ext hi (Prod.ext hu hv)

private theorem encode_separated (p q : Fin 26 × (ZMod 21 × ZMod 21))
    (h : ∀ i, NearZero ((encode p - encode q) i)) : encode p - encode q = 0 := by
  have hy : NearZero (2 * (p.2.2 - q.2.2) + (quotientCode p.1).1 -
      (quotientCode q.1).1) := by
    convert h 2 using 1
    simp [encode, Pi.sub_apply]
    ring
  have hz : NearZero (2 * (p.2.1 - q.2.1) + (quotientCode p.1).2 -
      (quotientCode q.1).2) := by
    convert h 3 using 1
    simp [encode, Pi.sub_apply]
    ring
  obtain ⟨hi, hu, hv⟩ := quotient_certificate p.1 q.1 (p.2.1 - q.2.1)
    (p.2.2 - q.2.2) (h 0) (h 1) hy hz
  have hpq : p = q := Prod.ext hi (Prod.ext (sub_eq_zero.mp hu) (sub_eq_zero.mp hv))
  simp [hpq]

private theorem coset_lowerBound :
    ENNReal.rpow 11466 ((4 : ℝ)⁻¹) ≤ shannonCapacityCycle 21 := by
  apply cycleConstruction_implies_lowerBound 21 4 11466 (by decide)
  let A := Finset.univ.map ⟨encode, encode_injective⟩
  refine ⟨A, ?_, ?_⟩
  · rintro x ⟨a, ha, b, hb, rfl⟩ h
    obtain ⟨p, _, rfl⟩ := Finset.mem_map.mp ha
    obtain ⟨q, _, rfl⟩ := Finset.mem_map.mp hb
    exact encode_separated p q h
  · rw [Finset.card_map, Finset.card_univ, Fintype.card_prod, Fintype.card_prod,
      Fintype.card_fin, ZMod.card]

private theorem profile_code_le : bpzC21Pi1024.code.toNat ≤ 11466 ^ 1024 := by
  decide +kernel

/-- **Buys–Polak–Zuiddam lower bound for the capacity of the 21-cycle.** Let $c$ be the code
coordinate of BPZ's final twenty-one-cycle profile after ten squarings, and let
$M = \max(c, 0)$. Then $M^{1/4096}$ is at most the Shannon capacity of the $21$-cycle, as an
inequality in $[0, \infty]$.

Source: BPZ, arXiv:2607.29681, exact twenty-one-cycle root rate. -/
theorem bpz2026CycleTwentyOneLowerBound :
  ENNReal.rpow (bpzC21Pi1024.code.toNat : ENNReal) ((4096 : ℝ)⁻¹) ≤ shannonCapacityCycle 21
    := by
  calc
    ENNReal.rpow (bpzC21Pi1024.code.toNat : ENNReal) ((4096 : ℝ)⁻¹)
        ≤ ENNReal.rpow ((11466 : ENNReal) ^ 1024) ((4096 : ℝ)⁻¹) := by
      apply ENNReal.rpow_le_rpow _ (by norm_num)
      exact_mod_cast profile_code_le
    _ = ENNReal.rpow 11466 ((4 : ℝ)⁻¹) := by
      rw [ENNReal.rpow_eq_pow, ENNReal.rpow_eq_pow, ← ENNReal.rpow_natCast_mul]
      norm_num
    _ ≤ shannonCapacityCycle 21 := coset_lowerBound

end MathlibExt.Combinatorics.Coding.CycleShannonBoundsWanted
