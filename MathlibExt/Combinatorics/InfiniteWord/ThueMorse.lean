module

public import Mathlib.Data.List.Basic
public import Mathlib.Data.Nat.Digits.Defs

@[expose] public section

namespace MetaMathlibExt

/-- **Thue–Morse substitution.** The Thue–Morse substitution $\sigma$ on the alphabet $\{0, 1\}$
sends each letter to a word of length two: $\sigma(0) = 01$ and $\sigma(1) = 10$.

Source: Example 2 in Scott Balchin and Dan Rust, *Computations for Symbolic
Substitutions*, Journal of Integer Sequences 20 (2017):
https://cs.uwaterloo.ca/journals/JIS/VOL20/Rust/rust3.tex. -/
def thueMorseSubstitution : Bool → List Bool
  | false => [false, true]
  | true => [true, false]

/-- **Thue–Morse blocks.** Let $\sigma$ be the Thue–Morse substitution, $\sigma(0) = 01$ and
$\sigma(1) = 10$, applied to finite words over $\{0, 1\}$ letter by letter. For a natural number
$n$, the $n$th Thue–Morse block is the finite word $\sigma^n(0)$: the $0$th block is the
one-letter word $0$, and the $(n+1)$st block is obtained from the $n$th by replacing each letter
$a$ with $\sigma(a)$. -/
def thueMorseBlock : Nat → List Bool
  | 0 => [false]
  | n + 1 => (thueMorseBlock n).flatMap thueMorseSubstitution

/-- **Thue–Morse sequence.** The Thue–Morse sequence $t_0 t_1 t_2 \cdots$ over $\{0, 1\}$ is
indexed from $0$, and $t_n = 1$ exactly when the binary expansion of $n$ has an odd number of
digits equal to $1$; otherwise $t_n = 0$.

Source: Eiji Miyanohara, *Transcendence of Digital Expansions Generated by a Generalized
Thue-Morse Sequence*, Journal of Integer Sequences 18 (2015), which lists the initial blocks
`0`, `01`, `0110` and `01101001` and the limit beginning `0110100110010110`:
https://cs.uwaterloo.ca/journals/JIS/VOL18/Miyanohara/miy5.tex. Evaluation here uses the binary
digits of the index, in time and space logarithmic in it, rather than an exponentially long
block. -/
def thueMorse (n : Nat) : Bool :=
  decide ((Nat.digits 2 n).count 1 % 2 = 1)

end MetaMathlibExt
