/-!
# Weighted Davenport constants of abelian prime-power groups

When the weight bound divides the smallest cyclic order,
`weightedDavenport_pi_zmod_prime_pow_of_dvd` computes the weighted Davenport constant.
The upper bound uses the group algebra over the prime field.
-/

namespace MetaMathlibExt
namespace weightedDavenport_pi_zmod_prime_pow_of_dvd

open Finset

-- Modulo the ideal generated by the differences 1 - bᵢ, every monomial is 1.
-- In a product of more than ∑ (qᵢ - 1) such differences of monomials, every
-- expanded term contains one of the vanishing powers (1 - bᵢ) ^ qᵢ.
private theorem prod_one_sub_monomial_eq_zero {ι κ R : Type*} [Fintype ι] [Fintype κ]
    [CommRing R] (b : ι → R) (q : ι → ℕ) (hq : ∀ i, (1 - b i) ^ q i = 0)
    (w : κ → ι → ℕ) (hlen : ∑ i, (q i - 1) < Fintype.card κ) :
    ∏ j, (1 - ∏ i, b i ^ w j i) = 0 := by
  classical
  let I := Ideal.span (Set.range fun i => 1 - b i)
  have hb (i) : Ideal.Quotient.mk I 1 = Ideal.Quotient.mk I (b i) :=
    Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨i, rfl⟩)
  have hmem (j : κ) : 1 - ∏ i, b i ^ w j i ∈ I := by
    apply Ideal.Quotient.eq.mp
    simp [map_prod, ← hb]
  choose a ha using fun j => Ideal.mem_span_range_iff_exists_fun.mp (hmem j)
  simp_rw [← ha, Fintype.prod_sum]
  apply sum_eq_zero
  intro f _
  rw [prod_mul_distrib, ← prod_fiberwise' univ f (fun i => 1 - b i)]
  simp only [prod_const]
  suffices ∃ i, q i ≤ (univ.filter fun j => f j = i).card by
    obtain ⟨i, hi⟩ := this
    apply mul_eq_zero_of_right
    exact prod_eq_zero (mem_univ i) (pow_eq_zero_of_le hi (hq i))
  by_contra! h
  have hcard := sum_le_sum (s := univ) fun i _ => Nat.le_sub_one_of_lt (h i)
  rw [sum_card_fiberwise_eq_card_filter univ univ f] at hcard
  exact hlen.not_ge (by simpa using hcard)

-- In the expansion over subsets of positions, the empty subset contributes 1
-- to the coefficient of zero. A vanishing product needs a second zero-sum subset.
private theorem exists_sum_eq_zero_of_prod_eq_zero {G κ : Type*}
    [AddCommMonoid G] [Fintype κ] {p : ℕ} [Fact p.Prime] (x : κ → G)
    (h : ∏ j, (1 - AddMonoidAlgebra.single (x j) (1 : ZMod p)) = 0) :
    ∃ s : Finset κ, s.Nonempty ∧ ∑ j ∈ s, x j = 0 := by
  classical
  by_contra! hfree
  simp_rw [sub_eq_add_neg, ← AddMonoidAlgebra.single_neg] at h
  rw [prod_one_add] at h
  have hcoeff := congrArg (fun z : AddMonoidAlgebra (ZMod p) G => z.coeff 0) h
  simp only [AddMonoidAlgebra.prod_single, AddMonoidAlgebra.coeff_sum,
    Finsupp.finsetSum_apply, AddMonoidAlgebra.coeff_single, Finsupp.single_apply,
    AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] at hcoeff
  rw [sum_eq_single ∅] at hcoeff
  · simp at hcoeff
  · intro s _ hs
    simp [hfree s (Finset.nonempty_iff_ne_empty.mpr hs)]
  · simp

-- Use the scaled coordinate generators in the group algebra. Their orders divide
-- p ^ (eᵢ - t), so Frobenius kills the corresponding powers of their differences.
private theorem exists_scaled_zero_sum {p r : ℕ} [Fact p.Prime] (e : Fin r → ℕ)
    (t : ℕ) (ht : ∀ i, t ≤ e i) {κ : Type*} [Fintype κ]
    (x : κ → (i : Fin r) → ZMod (p ^ e i))
    (hlen : ∑ i, (p ^ (e i - t) - 1) < Fintype.card κ) :
    ∃ s : Finset κ, s.Nonempty ∧ ∑ j ∈ s, (p ^ t) • x j = 0 := by
  classical
  have : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have : CharP (AddMonoidAlgebra (ZMod p) ((i : Fin r) → ZMod (p ^ e i))) p :=
    charP_of_injective_algebraMap' (ZMod p) p
  let g (i : Fin r) : (k : Fin r) → ZMod (p ^ e k) := Pi.single i ((p ^ t : ℕ) : ZMod (p ^ e i))
  let b (i : Fin r) := AddMonoidAlgebra.single (g i) (1 : ZMod p)
  have hpow (i) : (1 - b i) ^ p ^ (e i - t) = 0 := by
    have hg : p ^ (e i - t) • g i = 0 := by
      funext k
      by_cases hk : k = i
      · subst k
        simp only [Pi.smul_apply, g, Pi.single_eq_same, nsmul_eq_mul, ← Nat.cast_mul,
          ← pow_add, Nat.sub_add_cancel (ht i), ZMod.natCast_self, Pi.zero_apply]
      · simp [g, Pi.single_eq_of_ne hk]
    dsimp only [b]
    rw [sub_pow_char_pow, one_pow, AddMonoidAlgebra.single_pow, hg, one_pow,
      ← AddMonoidAlgebra.one_def, sub_self]
  let w (j : κ) (i : Fin r) := (x j i).val
  have hx (j) : ∏ i, b i ^ w j i = AddMonoidAlgebra.single (p ^ t • x j) 1 := by
    simp only [b, AddMonoidAlgebra.single_pow, one_pow, AddMonoidAlgebra.prod_single,
      prod_const_one]
    congr 1
    funext k
    rw [Finset.sum_apply k, Fintype.sum_eq_single k]
    · simp [w, g, nsmul_eq_mul, mul_comm]
    · intro i hik
      simp [g, Pi.single_eq_of_ne (Ne.symm hik)]
  apply exists_sum_eq_zero_of_prod_eq_zero (p := p)
  simpa only [hx] using prod_one_sub_monomial_eq_zero b _ hpow w hlen

-- Write n = q * d = β * k. Since (q - 1) * β < n and d ≤ β,
-- the integer quotient k is both at least and at most q.
private theorem bound_eq_weight {q d β : ℕ} (hq : 1 < q) (hd : 0 < d)
    (hdβ : d ≤ β) (hlt : (q - 1) * β < q * d) (hdvd : β ∣ q * d) : β = d := by
  obtain ⟨k, hk⟩ := hdvd
  have hβ : 0 < β := hd.trans_le hdβ
  have h₁ : q - 1 < k := by
    rw [hk, mul_comm β] at hlt
    exact Nat.lt_of_mul_lt_mul_right hlt
  have h₂ : k ≤ q := by
    apply Nat.le_of_mul_le_mul_left (c := β) _ hβ
    rw [← hk]
    simpa [mul_comm] using Nat.mul_le_mul_left q hdβ
  have : k = q := by omega
  subst k
  exact Nat.eq_of_mul_eq_mul_left (by omega : 0 < q) (by simpa [mul_comm] using hk.symm)

end weightedDavenport_pi_zmod_prime_pow_of_dvd

open weightedDavenport_pi_zmod_prime_pow_of_dvd in
/-- **Weighted Davenport constant of abelian $p$-groups, divisible case.** Let $p$ be a prime,
let $r \ge 1$, let $e_1 \le e_2 \le \dots \le e_r$ be natural numbers and let
$G = \mathbb{Z}/p^{e_1}\mathbb{Z} \oplus \dots \oplus \mathbb{Z}/p^{e_r}\mathbb{Z}$. Let $c$ be a
natural number with $1 \le c \le e_1$, put $\beta = \lceil p^{e_1}/(p^c - 1) \rceil - 1$ and let
$A$ be a finite set of natural numbers with $p^{e_1 - c} \in A \subseteq \{1, \dots, \beta\}$. If
$\beta \mid p^{e_1}$, then the $A$-weighted Davenport constant of $G$ is
$D_A(G) = 1 + \sum_{i=1}^{r} (\lceil p^{e_i}/\beta \rceil - 1)$.

Source: Md Ibrahim Molla, *New Families of Weight Sets Yielding Prescribed Weighted Zero-Sum
Constants*, INTEGERS 26 (2026), Article A89, Theorem 7(i) (`integers-2026-A89-thm-7`). -/
public theorem weightedDavenport_pi_zmod_prime_pow_of_dvd (p r c : ℕ) (hp : p.Prime)
    (hr : 0 < r) (e : Fin r → ℕ) (hmono : Monotone e) (hc : 1 ≤ c) (hce : c ≤ e ⟨0, hr⟩)
    (A : Finset ℕ) (hmem : p ^ (e ⟨0, hr⟩ - c) ∈ A)
    (hsub : A ⊆ Finset.Icc 1 (p ^ e ⟨0, hr⟩ ⌈/⌉ (p ^ c - 1) - 1))
    (hβ : p ^ e ⟨0, hr⟩ ⌈/⌉ (p ^ c - 1) - 1 ∣ p ^ e ⟨0, hr⟩) :
    weightedDavenport A ((i : Fin r) → ZMod (p ^ e i)) =
      ((1 + ∑ i, (p ^ e i ⌈/⌉ (p ^ e ⟨0, hr⟩ ⌈/⌉ (p ^ c - 1) - 1) - 1) : ℕ) : ℕ∞) := by
  let t := e ⟨0, hr⟩ - c
  let d := p ^ t
  let q := p ^ c
  let β := p ^ e ⟨0, hr⟩ ⌈/⌉ (q - 1) - 1
  have hq : 1 < q := Nat.one_lt_pow (by omega) hp.one_lt
  have hd : 0 < d := pow_pos hp.pos _
  have hn : p ^ e ⟨0, hr⟩ = q * d := by
    rw [← pow_add, Nat.add_sub_of_le hce]
  have hdβ : d ≤ β := (Finset.mem_Icc.mp (hsub hmem)).2
  have hβeq : β = d := by
    apply bound_eq_weight hq hd hdβ _ (hn ▸ hβ)
    rw [← hn]
    apply (gc_mul_ceilDiv (by omega : 0 < q - 1)).lt_iff_lt.mp
    change β < p ^ e ⟨0, hr⟩ ⌈/⌉ (q - 1)
    dsimp only [β] at hdβ ⊢
    omega
  have ht (i : Fin r) : t ≤ e i :=
    (Nat.sub_le ..).trans (hmono (show (⟨0, hr⟩ : Fin r) ≤ i from Nat.zero_le _))
  have hceil (i : Fin r) : p ^ e i ⌈/⌉ β = p ^ (e i - t) := by
    have hi : p ^ e i = d * p ^ (e i - t) := by
      dsimp only [d]
      rw [← pow_add, Nat.add_sub_of_le (ht i)]
    rw [hi, hβeq]
    exact smul_ceilDiv hd _
  change weightedDavenport A _ = ((1 + ∑ i, (p ^ e i ⌈/⌉ β - 1) : ℕ) : ℕ∞)
  apply le_antisymm
  · apply weightedDavenport_le
    intro s hs hfree
    have : Fact p.Prime := ⟨hp⟩
    obtain ⟨I, hI, hzero⟩ := exists_scaled_zero_sum e t ht s.get (by simp [hs, hceil])
    exact hfree I hI (fun _ => d) (fun _ _ => hmem) hzero
  · obtain ⟨s, hs, hfree⟩ := exists_weightedZeroSumFree_pi_zmod_prime_pow p r c hp hr e hmono hc hce
    have hA : IsWeightedZeroSumFree A s :=
      fun I hI a ha => hfree I hI a fun i hi => hsub (ha i hi)
    rw [Nat.add_comm, ← hs, Nat.cast_add_one]
    exact ENat.natCast_add_one_le_iff.mpr (lt_weightedDavenport hA)

end MetaMathlibExt
