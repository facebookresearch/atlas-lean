module

public import Mathlib.Combinatorics.SimpleGraph.Maps
public import Mathlib.Combinatorics.SimpleGraph.Sum

/-!
# Clique-width

A `k`-expression builds a vertex-labelled graph, with labels in `Fin k`, from single labelled
vertices by disjoint union `⊕`, by `η_{i,j}` (join every vertex labelled `i` to every vertex
labelled `j`, for `i ≠ j`) and by `ρ_{i→j}` (relabel `i` as `j`). The clique-width of a graph
is the least `k` such that some labelling of the graph is the value of a `k`-expression, up to
isomorphism (Courcelle, Engelfriet and Rozenberg 1993; Courcelle and Olariu 2000). We follow the
description recalled by Oum and Seymour (2006, Section 6).

We record "clique-width at most `k`" as the predicate `SimpleGraph.HasCliqueWidthAtMost`; the
graph with no vertices satisfies it for every `k`.

## References

* S. Oum and P. Seymour, *Approximating clique-width and branch-width*, J. Combin. Theory
  Ser. B 96 (2006) 514–528 (author's preprint of 20 October 2004), Section 6 (proof of
  Proposition 6.3).
* B. Courcelle and S. Olariu, *Upper bounds to the clique width of graphs*, Discrete Appl. Math.
  101 (2000) 77–114 (original definition; not consulted here).
-/

@[expose] public section

namespace SimpleGraph

universe u

/-- **Graphs generated by `k`-expressions.** `CWExpressible k V G lab` says that the graph `G` on
`V` with vertex labelling `lab : V → Fin k` is, up to isomorphism, the value of a `k`-expression:
it is a single vertex with any label (`·ᵢ`), the disjoint union `⊕` of two such labelled graphs,
obtained from one by `η_{i,j}` with `i ≠ j` (adding every edge between a vertex labelled `i` and a
vertex labelled `j`) or by `ρ_{i→j}` (relabelling every `i` as `j`), or an isomorphic copy of one
(Oum and Seymour, *Approximating clique-width and branch-width*, J. Combin. Theory Ser. B 96
(2006), Section 6: a `k`-expression is a well-formed expression in the constants, the two unary
operators and the binary disjoint union). -/
inductive CWExpressible (k : ℕ) : (V : Type u) → SimpleGraph V → (V → Fin k) → Prop
  /-- `·ᵢ`: a single vertex labelled `i`. -/
  | vertex (V : Type u) [Unique V] (i : Fin k) : CWExpressible k V ⊥ (fun _ => i)
  /-- `⊕`: disjoint union of two labelled graphs. -/
  | union {V W : Type u} {G : SimpleGraph V} {H : SimpleGraph W} {l : V → Fin k} {m : W → Fin k} :
      CWExpressible k V G l → CWExpressible k W H m →
      CWExpressible k (V ⊕ W) (G ⊕g H) (Sum.elim l m)
  /-- `η_{i,j}`, `i ≠ j`: join every vertex labelled `i` to every vertex labelled `j`. -/
  | join {V : Type u} {G : SimpleGraph V} {l : V → Fin k} (i j : Fin k) (hij : i ≠ j) :
      CWExpressible k V G l →
      CWExpressible k V (G ⊔ SimpleGraph.fromRel (fun x y => l x = i ∧ l y = j)) l
  /-- `ρ_{i→j}`: relabel every vertex labelled `i` as `j`. -/
  | relabel {V : Type u} {G : SimpleGraph V} {l : V → Fin k} (i j : Fin k) :
      CWExpressible k V G l → CWExpressible k V G (fun x => if l x = i then j else l x)
  /-- Isomorphic copies of generated labelled graphs are generated. -/
  | iso {V W : Type u} {G : SimpleGraph V} {l : V → Fin k} (e : V ≃ W) :
      CWExpressible k V G l → CWExpressible k W (G.map e.toEmbedding) (l ∘ e.symm)

/-- **Clique-width at most `k`.** A graph `G` has clique-width at most `k` if it has no vertices or
some labelling of it is generated by a `k`-expression (Oum and Seymour, *Approximating clique-width
and branch-width*, J. Combin. Theory Ser. B 96 (2006), Section 6). The clique-width `cw(G)` is
the least such `k`. -/
def HasCliqueWidthAtMost {V : Type u} (G : SimpleGraph V) (k : ℕ) : Prop :=
  IsEmpty V ∨ ∃ l : V → Fin k, CWExpressible k V G l

/-- **A single vertex has clique-width at most one.** -/
theorem hasCliqueWidthAtMost_one_of_unique {V : Type u} [Unique V] (G : SimpleGraph V) :
    G.HasCliqueWidthAtMost 1 := by
  have hG : G = ⊥ := by
    ext x y
    simp [Subsingleton.elim x y]
  subst hG
  exact Or.inr ⟨fun _ => 0, CWExpressible.vertex V 0⟩

end SimpleGraph
