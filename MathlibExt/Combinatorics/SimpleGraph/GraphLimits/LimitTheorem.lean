section Bits

variable {V : Type*}

/-- The label of `v` formed by its first `j` bits. -/
private def pre (β : V → ℕ → Bool) (j : ℕ) (v : V) : Fin j → Bool := fun l => β v l

private lemma pre_eq_pre_iff (β : V → ℕ → Bool) (j : ℕ) (x y : V) :
    pre β j x = pre β j y ↔ ∀ l < j, β x l = β y l := by
  simp only [pre, funext_iff, Fin.forall_iff]

variable [DecidableEq V]

/-- Write the membership bits of `S` and `T` at the positions `j` and `j + 1`. -/
private def addBits (β : V → ℕ → Bool) (j : ℕ) (S T : Finset V) : V → ℕ → Bool :=
  fun v i => if i = j then decide (v ∈ S) else if i = j + 1 then decide (v ∈ T) else β v i

private lemma addBits_of_lt {β : V → ℕ → Bool} {j : ℕ} {S T : Finset V} {v : V} {i : ℕ}
    (hi : i < j) : addBits β j S T v i = β v i := by
  have h1 : i ≠ j := hi.ne
  have h2 : i ≠ j + 1 := by omega
  simp [addBits, h1, h2]

private lemma pre_addBits_eq_iff (β : V → ℕ → Bool) (j : ℕ) (S T : Finset V) (x y : V) :
    pre (addBits β j S T) (j + 2) x = pre (addBits β j S T) (j + 2) y ↔
      pre β j x = pre β j y ∧ (x ∈ S ↔ y ∈ S) ∧ (x ∈ T ↔ y ∈ T) := by
  rw [pre_eq_pre_iff, pre_eq_pre_iff]
  constructor
  · intro h
    refine ⟨fun l hl => ?_, ?_, ?_⟩
    · have := h l (by omega)
      rwa [addBits_of_lt hl, addBits_of_lt hl] at this
    · simpa [addBits] using h j (by omega)
    · simpa [addBits] using h (j + 1) (by omega)
  · rintro ⟨h1, h2, h3⟩ l hl
    rcases (show l < j ∨ l = j ∨ l = j + 1 by omega) with h | rfl | rfl
    · rw [addBits_of_lt h, addBits_of_lt h]
      exact h1 l h
    · simp [addBits, h2]
    · simp [addBits, h3]

end Bits

section Labels

variable {V L : Type*} [Fintype V] [DecidableEq V] [DecidableEq L]

/-- The relation "same label" of a labelling. -/
private def labelSetoid (lab : V → L) : Setoid V where
  r x y := lab x = lab y
  iseqv := ⟨fun _ => rfl, Eq.symm, Eq.trans⟩

private instance labelSetoid.decidableRel (lab : V → L) : DecidableRel (labelSetoid lab).r :=
  fun x y => inferInstanceAs (Decidable (lab x = lab y))

/-- The partition of `V` into the fibres of a labelling. -/
private def labelPartition (lab : V → L) : Finpartition (Finset.univ : Finset V) :=
  Finpartition.ofSetoid (labelSetoid lab)

private lemma part_labelPartition (lab : V → L) (x : V) :
    (labelPartition lab).part x = Finset.univ.filter (fun y => lab y = lab x) := by
  ext y
  rw [labelPartition, Finpartition.mem_part_ofSetoid_iff_rel]
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  change lab x = lab y ↔ lab y = lab x
  exact eq_comm

omit [DecidableEq V] in
private lemma filter_label_eq_iff (lab : V → L) (x y : V) :
    Finset.univ.filter (fun z => lab z = lab x) = Finset.univ.filter (fun z => lab z = lab y) ↔
      lab x = lab y := by
  constructor
  · intro h
    have hx : x ∈ Finset.univ.filter (fun z => lab z = lab y) := by
      rw [← h]
      simp
    simpa using hx
  · intro h
    rw [h]

private lemma partitionAverage_congr {P Q : Finpartition (Finset.univ : Finset V)}
    (h : ∀ x, P.part x = Q.part x) (w : Sym2 V → ℝ) :
    partitionAverage P w = partitionAverage Q w := by
  funext z
  induction z using Sym2.ind with
  | _ x y => rw [partitionAverage_apply, partitionAverage_apply, h x, h y]

private lemma partitionEnergy_congr {P Q : Finpartition (Finset.univ : Finset V)}
    (h : ∀ x, P.part x = Q.part x) (w : Sym2 V → ℝ) :
    partitionEnergy P w = partitionEnergy Q w := by
  simp only [partitionEnergy, partitionAverage_congr h w]

private lemma part_refineBy_labelPartition (β : V → ℕ → Bool) (j : ℕ) (S T : Finset V)
    (x : V) : (refineBy (labelPartition (pre β j)) S T).part x =
      (labelPartition (pre (addBits β j S T) (j + 2))).part x := by
  ext y
  rw [part_labelPartition, Finset.mem_filter, refineBy, Finpartition.mem_part_ofSetoid_iff_rel]
  change (labelPartition (pre β j)).part x = (labelPartition (pre β j)).part y ∧
      (x ∈ S ↔ y ∈ S) ∧ (x ∈ T ↔ y ∈ T) ↔ _
  rw [part_labelPartition, part_labelPartition, filter_label_eq_iff, eq_comm,
    pre_addBits_eq_iff]
  simp only [Finset.mem_univ, true_and]
  constructor
  · rintro ⟨h1, h2, h3⟩
    exact ⟨h1, h2.symm, h3.symm⟩
  · rintro ⟨h1, h2, h3⟩
    exact ⟨h1, h2.symm, h3.symm⟩

private lemma partitionAverage_addBits_empty (β : V → ℕ → Bool) (j : ℕ) (w : Sym2 V → ℝ) :
    partitionAverage (labelPartition (pre (addBits β j ∅ ∅) (j + 2))) w =
      partitionAverage (labelPartition (pre β j)) w := by
  refine partitionAverage_congr (fun x => ?_) w
  rw [part_labelPartition, part_labelPartition]
  ext y
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  rw [pre_addBits_eq_iff]
  simp

/-- One step of the energy increment argument, with the witnessing sets made explicit. -/
private lemma exists_sets_energy_gain (hV : 0 < Fintype.card V)
    (P : Finpartition (Finset.univ : Finset V)) (w : Sym2 V → ℝ) {ε : ℝ} (hε : 0 < ε)
    (hP : ε * kernelL2Norm w < cutNorm (w - partitionAverage P w)) :
    ∃ S T : Finset V, partitionEnergy P w + ε ^ 2 * ∑ x, ∑ y, w s(x, y) ^ 2 <
      partitionEnergy (refineBy P S T) w := by
  set n : ℝ := (Fintype.card V : ℝ) with hn_def
  have hn : 0 < n := by rw [hn_def]; exact_mod_cast hV
  set A2 := ∑ x, ∑ y, w s(x, y) ^ 2 with hA2
  have hA2nn : 0 ≤ A2 := Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _
  obtain ⟨⟨S, T⟩, -, hST⟩ := Finset.exists_mem_eq_sup'
    (Finset.univ_nonempty (α := Finset V × Finset V))
    (fun p => |∑ x ∈ p.1, ∑ y ∈ p.2, (w - partitionAverage P w) s(x, y)|)
  refine ⟨S, T, ?_⟩
  have hinc := sq_sum_sub_partitionAverage_le P w S T
  have hL2 : kernelL2Norm w = Real.sqrt A2 / n := by
    rw [kernelL2Norm, ← hA2, ← hn_def, Real.sqrt_div' _ (sq_nonneg n), Real.sqrt_sq hn.le]
  have hcut : cutNorm (w - partitionAverage P w) =
      |∑ x ∈ S, ∑ y ∈ T, (w - partitionAverage P w) s(x, y)| / n ^ 2 := by
    rw [cutNorm, cutMax, hST]
  rw [hcut, hL2, lt_div_iff₀ (by positivity)] at hP
  have hbig : ε * n * Real.sqrt A2 <
      |∑ x ∈ S, ∑ y ∈ T, (w - partitionAverage P w) s(x, y)| := by
    have : ε * (Real.sqrt A2 / n) * n ^ 2 = ε * n * Real.sqrt A2 := by field_simp
    linarith
  have h0 : 0 ≤ ε * n * Real.sqrt A2 := by positivity
  have hsq : (ε * n * Real.sqrt A2) ^ 2 <
      (∑ x ∈ S, ∑ y ∈ T, (w - partitionAverage P w) s(x, y)) ^ 2 := by
    rw [← sq_abs (∑ x ∈ S, ∑ y ∈ T, (w - partitionAverage P w) s(x, y))]
    exact pow_lt_pow_left₀ hbig h0 two_ne_zero
  have hexp : (ε * n * Real.sqrt A2) ^ 2 = n ^ 2 * (ε ^ 2 * A2) := by
    rw [mul_pow, mul_pow, Real.sq_sqrt hA2nn]
    ring
  rw [hexp] at hsq
  have := lt_of_lt_of_le hsq hinc
  have h' := lt_of_mul_lt_mul_left this (by positivity : (0 : ℝ) ≤ n ^ 2)
  linarith

/-- **One level of nested weak regularity.** If `(m + 1) ε² ≥ 1`, then starting from any bit
labelling, `m` further steps, each writing two bits after position `j` (the membership bits of a
witnessing rectangle, or two zero bits once the partition is good), give a partition whose average
is within `ε ‖w‖₂` of `w` in the cut norm; the first `j` bits are unchanged. -/
private lemma exists_extend_good (hV : 0 < Fintype.card V) (w : Sym2 V → ℝ) {ε : ℝ}
    (hε : 0 < ε) {m : ℕ} (hm : 1 ≤ ((m : ℝ) + 1) * ε ^ 2) (β₀ : V → ℕ → Bool) (j : ℕ) :
    ∃ β : V → ℕ → Bool, (∀ v, ∀ i < j, β v i = β₀ v i) ∧
      cutNorm (w - partitionAverage (labelPartition (pre β (j + 2 * m))) w) ≤
        ε * kernelL2Norm w := by
  set A2 := ∑ x, ∑ y, w s(x, y) ^ 2 with hA2
  have hA2nn : 0 ≤ A2 := Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _
  have claim : ∀ t ≤ m, ∃ β : V → ℕ → Bool, (∀ v, ∀ i < j, β v i = β₀ v i) ∧
      (cutNorm (w - partitionAverage (labelPartition (pre β (j + 2 * t))) w) ≤
          ε * kernelL2Norm w ∨
        (t : ℝ) * (ε ^ 2 * A2) ≤ partitionEnergy (labelPartition (pre β (j + 2 * t))) w) := by
    intro t
    induction t with
    | zero =>
      intro _
      refine ⟨β₀, fun _ _ _ => rfl, Or.inr ?_⟩
      simp only [CharP.cast_eq_zero, zero_mul]
      exact Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _
    | succ t ih =>
      intro ht
      obtain ⟨β, hβ, hprev⟩ := ih (by omega)
      have hj : j + 2 * (t + 1) = j + 2 * t + 2 := by ring
      by_cases hgood : cutNorm (w - partitionAverage (labelPartition (pre β (j + 2 * t))) w) ≤
          ε * kernelL2Norm w
      · refine ⟨addBits β (j + 2 * t) ∅ ∅, fun v i hi => ?_, Or.inl ?_⟩
        · rw [addBits_of_lt (by omega)]
          exact hβ v i hi
        · rw [hj, partitionAverage_addBits_empty]
          exact hgood
      · have hE := hprev.resolve_left hgood
        obtain ⟨S, T, hST⟩ := exists_sets_energy_gain hV _ w hε (not_le.1 hgood)
        refine ⟨addBits β (j + 2 * t) S T, fun v i hi => ?_, Or.inr ?_⟩
        · rw [addBits_of_lt (by omega)]
          exact hβ v i hi
        · rw [hj, ← partitionEnergy_congr (part_refineBy_labelPartition β _ S T) w]
          push_cast
          linarith
  obtain ⟨β, hβ, h⟩ := claim m le_rfl
  refine ⟨β, hβ, ?_⟩
  by_contra hgood
  have hE := h.resolve_left hgood
  obtain ⟨S, T, hST⟩ := exists_sets_energy_gain hV _ w hε (not_le.1 hgood)
  have hle := partitionEnergy_le (refineBy (labelPartition (pre β (j + 2 * m))) S T) w
  have h1 : A2 ≤ ((m : ℝ) + 1) * ε ^ 2 * A2 := by nlinarith
  nlinarith

omit [DecidableEq V] in
private lemma kernelL2Norm_le_one (hV : 0 < Fintype.card V) {w : Sym2 V → ℝ}
    (hw : ∀ z, w z ∈ Icc (0 : ℝ) 1) : kernelL2Norm w ≤ 1 := by
  rw [kernelL2Norm, Real.sqrt_le_one, div_le_one (by positivity)]
  calc ∑ x, ∑ y, w s(x, y) ^ 2 ≤ ∑ _x : V, ∑ _y : V, (1 : ℝ) :=
        Finset.sum_le_sum fun x _ => Finset.sum_le_sum fun y _ => by
          have := hw s(x, y)
          nlinarith [this.1, this.2]
    _ = (Fintype.card V : ℝ) ^ 2 := by simp [sq]

/-- The bit budget of the nested partitions: the partition by the first `bitLevel (k + 1)` bits
is weakly `1 / (k + 1)`-regular. -/
private def bitLevel : ℕ → ℕ
  | 0 => 0
  | k + 1 => bitLevel k + 2 * (k + 1) ^ 2

private lemma bitLevel_succ (k : ℕ) : bitLevel (k + 1) = bitLevel k + 2 * (k + 1) ^ 2 := rfl

private lemma bitLevel_strictMono : StrictMono bitLevel :=
  strictMono_nat_of_lt_succ fun k => by
    rw [bitLevel_succ]
    have : 0 < 2 * (k + 1) ^ 2 := by positivity
    omega

private lemma le_bitLevel (k : ℕ) : k ≤ bitLevel k := by
  induction k with
  | zero => exact le_rfl
  | succ k ih => rw [bitLevel_succ]; nlinarith

/-- **Nested weak regularity.** Every weighted graph with weights in `[0, 1]` on a nonempty finite
vertex set has a bit labelling such that, for every `k`, the partition by the first
`bitLevel (k + 1)` bits is weakly `1 / (k + 1)`-regular. -/
private lemma exists_bits (hV : 0 < Fintype.card V) (w : Sym2 V → ℝ)
    (hw : ∀ z, w z ∈ Icc (0 : ℝ) 1) :
    ∃ β : V → ℕ → Bool, ∀ k : ℕ,
      cutNorm (w - partitionAverage (labelPartition (pre β (bitLevel (k + 1)))) w) ≤
        1 / (k + 1) := by
  have hL2 := kernelL2Norm_le_one hV hw
  have step : ∀ (k : ℕ) (β₀ : V → ℕ → Bool), ∃ β : V → ℕ → Bool,
      (∀ v, ∀ i < bitLevel k, β v i = β₀ v i) ∧
      cutNorm (w - partitionAverage (labelPartition (pre β (bitLevel (k + 1)))) w) ≤
        1 / (k + 1) := by
    intro k β₀
    have hε : (0 : ℝ) < 1 / (k + 1) := by positivity
    have hm : 1 ≤ ((((k + 1) ^ 2 : ℕ) : ℝ) + 1) * (1 / ((k : ℝ) + 1)) ^ 2 := by
      have hk : (0 : ℝ) < (k + 1) ^ 2 := by positivity
      push_cast
      rw [div_pow, one_pow, mul_one_div, le_div_iff₀ hk]
      linarith
    obtain ⟨β, hβ, hgood⟩ := exists_extend_good hV w hε hm β₀ (bitLevel k)
    refine ⟨β, hβ, ?_⟩
    calc _ ≤ 1 / ((k : ℝ) + 1) * kernelL2Norm w := hgood
      _ ≤ 1 / ((k : ℝ) + 1) * 1 := by gcongr
      _ = _ := mul_one _
  choose ext hext_agree hext_good using step
  let seq : ℕ → V → ℕ → Bool := fun k => Nat.rec (fun _ _ => false) (fun k b => ext k b) k
  have hseq_succ : ∀ k, seq (k + 1) = ext k (seq k) := fun k => rfl
  have hagree : ∀ k k', k ≤ k' → ∀ v, ∀ i < bitLevel k, seq k' v i = seq k v i := by
    intro k k' hkk'
    induction k', hkk' using Nat.le_induction with
    | base => intros; rfl
    | succ k' hk ih =>
      intro v i hi
      rw [hseq_succ, hext_agree k' (seq k') v i
        (lt_of_lt_of_le hi (bitLevel_strictMono.monotone hk))]
      exact ih v i hi
  refine ⟨fun v i => seq (i + 1) v i, fun k => ?_⟩
  have hpre : pre (fun v i => seq (i + 1) v i) (bitLevel (k + 1)) =
      pre (seq (k + 1)) (bitLevel (k + 1)) := by
    funext v l
    simp only [pre]
    rcases le_total ((l : ℕ) + 1) (k + 1) with h | h
    · exact (hagree _ _ h v l (lt_of_lt_of_le (Nat.lt_succ_self _) (le_bitLevel _))).symm
    · exact hagree _ _ h v l l.2
  rw [hpre]
  exact hext_good k (seq k)

end Labels


section Masses

variable {V L : Type*} [Fintype V] [DecidableEq L]

/-- The number of vertices with label `s`. -/
private def cnt (lab : V → L) (s : L) : ℝ := ∑ v, if lab v = s then (1 : ℝ) else 0

/-- The total weight between the vertices labelled `s` and those labelled `s'`. -/
private def esum (lab : V → L) (w : Sym2 V → ℝ) (s s' : L) : ℝ :=
  ∑ p : V × V, if (lab p.1, lab p.2) = (s, s') then w s(p.1, p.2) else 0

private lemma sum_filter_sum_ite {X Y Z : Type*} [Fintype X] [Fintype Y] [DecidableEq Y]
    [DecidableEq Z] (f : X → Y) (g : Y → Z) (z : Z) (c : X → ℝ) :
    ∑ y ∈ Finset.univ.filter (fun y => g y = z), ∑ x, (if f x = y then c x else 0) =
      ∑ x, if g (f x) = z then c x else 0 := by
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Finset.sum_ite_eq]
  simp

private lemma cnt_comp {L' : Type*} [Fintype L] [DecidableEq L'] (lab : V → L) (g : L → L')
    (s : L') : cnt (g ∘ lab) s = ∑ t ∈ Finset.univ.filter (fun t => g t = s), cnt lab t := by
  simp only [cnt]
  rw [sum_filter_sum_ite]
  rfl

private lemma esum_comp {L' : Type*} [Fintype L] [DecidableEq L'] (lab : V → L) (g : L → L')
    (w : Sym2 V → ℝ) (s s' : L') :
    esum (g ∘ lab) w s s' = ∑ q ∈ Finset.univ.filter (fun q : L × L => (g q.1, g q.2) = (s, s')),
      esum lab w q.1 q.2 := by
  simp only [esum]
  have h := sum_filter_sum_ite (fun p : V × V => (lab p.1, lab p.2))
    (fun q : L × L => (g q.1, g q.2)) (s, s') (fun p => w s(p.1, p.2))
  rw [h]
  rfl

private lemma cnt_eq_card (lab : V → L) (s : L) :
    cnt lab s = ((Finset.univ.filter (fun v => lab v = s)).card : ℝ) := by
  rw [cnt, Finset.sum_boole]

private lemma esum_eq_sum_filter (lab : V → L) (w : Sym2 V → ℝ) (s s' : L) :
    esum lab w s s' = ∑ a ∈ Finset.univ.filter (fun v => lab v = s),
      ∑ b ∈ Finset.univ.filter (fun v => lab v = s'), w s(a, b) := by
  rw [esum, Fintype.sum_prod_type, Finset.sum_filter]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_filter]
  by_cases h : lab a = s <;> simp [h]

private lemma partitionAverage_labelPartition [DecidableEq V] (lab : V → L) (w : Sym2 V → ℝ)
    (x y : V) : partitionAverage (labelPartition lab) w s(x, y) =
      esum lab w (lab x) (lab y) / (cnt lab (lab x) * cnt lab (lab y)) := by
  rw [partitionAverage_apply, part_labelPartition, part_labelPartition, esum_eq_sum_filter,
    cnt_eq_card, cnt_eq_card]

private lemma esum_comm (lab : V → L) (w : Sym2 V → ℝ) (s s' : L) :
    esum lab w s s' = esum lab w s' s := by
  rw [esum, esum, ← (Equiv.prodComm V V).sum_comp]
  refine Finset.sum_congr rfl fun p _ => ?_
  simp only [Equiv.prodComm_apply, Prod.fst_swap, Prod.snd_swap, Prod.mk.injEq]
  exact if_congr and_comm (congrArg w Sym2.eq_swap) rfl

private lemma cnt_nonneg (lab : V → L) (s : L) : 0 ≤ cnt lab s :=
  Finset.sum_nonneg fun _ _ => by split_ifs <;> norm_num

private lemma cnt_le_card (lab : V → L) (s : L) : cnt lab s ≤ Fintype.card V := by
  calc cnt lab s ≤ ∑ _v : V, (1 : ℝ) :=
        Finset.sum_le_sum fun _ _ => by split_ifs <;> norm_num
    _ = Fintype.card V := by simp

private lemma esum_nonneg (lab : V → L) {w : Sym2 V → ℝ} (hw : ∀ z, 0 ≤ w z) (s s' : L) :
    0 ≤ esum lab w s s' :=
  Finset.sum_nonneg fun _ _ => by split_ifs <;> simp [hw]

private lemma esum_le (lab : V → L) {w : Sym2 V → ℝ} (hw : ∀ z, w z ≤ 1) (s s' : L) :
    esum lab w s s' ≤ cnt lab s * cnt lab s' := by
  rw [cnt, cnt, Finset.sum_mul_sum, esum, Fintype.sum_prod_type]
  refine Finset.sum_le_sum fun a _ => Finset.sum_le_sum fun b _ => ?_
  by_cases ha : lab a = s <;> by_cases hb : lab b = s' <;> simp [ha, hb, hw]

/-- Restriction of a bit string to its first `i` bits. -/
private def res {i j : ℕ} (h : i ≤ j) (t : Fin j → Bool) : Fin i → Bool :=
  fun l => t (Fin.castLE h l)

omit [Fintype V] in
private lemma res_comp_pre (β : V → ℕ → Bool) {i j : ℕ} (h : i ≤ j) :
    res h ∘ pre β j = pre β i := rfl

omit [Fintype V] in
private lemma pre_succ (β : V → ℕ → Bool) (j : ℕ) (v : V) :
    pre β (j + 1) v = Fin.snoc (pre β j v) (β v j) := by
  funext l
  induction l using Fin.lastCases with
  | last => simp [pre]
  | cast l => simp [pre]

private lemma cnt_pre_succ (β : V → ℕ → Bool) (j : ℕ) (s : Fin j → Bool) :
    cnt (pre β j) s = cnt (pre β (j + 1)) (Fin.snoc s false) +
      cnt (pre β (j + 1)) (Fin.snoc s true) := by
  simp only [cnt, ← Finset.sum_add_distrib, pre_succ]
  refine Finset.sum_congr rfl fun v _ => ?_
  have key : ∀ b : Bool, (Fin.snoc (pre β j v) (β v j) = (Fin.snoc s b : Fin (j + 1) → Bool)) ↔
      pre β j v = s ∧ β v j = b := fun b => Fin.snoc_injective2.eq_iff
  simp only [key]
  by_cases h : pre β j v = s <;> cases β v j <;> simp [h]

private lemma cnt_pre_zero (β : V → ℕ → Bool) (s : Fin 0 → Bool) :
    cnt (pre β 0) s = Fintype.card V := by
  simp only [cnt, show ∀ v, pre β 0 v = s from fun v => Subsingleton.elim _ _, ↓reduceIte,
    Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]

/-- Sums over maps into the vertices, grouped by the labels of the images. -/
private lemma sum_comp_eq_sum_prod_cnt {α : Type*} [Fintype α] [DecidableEq α] [Fintype L]
    (lab : V → L) (g : (α → L) → ℝ) :
    ∑ φ : α → V, g (lab ∘ φ) = ∑ σ : α → L, (∏ i, cnt lab (σ i)) * g σ := by
  have h1 : ∀ σ : α → L, ∏ i, cnt lab (σ i) = ∑ φ : α → V, if lab ∘ φ = σ then (1 : ℝ) else 0 := by
    intro σ
    simp only [cnt]
    rw [Fintype.prod_sum]
    refine Finset.sum_congr rfl fun φ _ => ?_
    rw [Finset.prod_boole]
    simp [funext_iff]
  simp_rw [h1, Finset.sum_mul, ite_mul, one_mul, zero_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun φ _ => ?_
  rw [Finset.sum_ite_eq]
  simp

/-- **Densities in a partition average.** The density of `F` in the partition average of `w` over
the fibres of a labelling is a polynomial in the masses of the classes and the averaged weights. -/
private lemma homDensity_partitionAverage {α : Type*} [Fintype α] [DecidableEq α] [DecidableEq V]
    [Fintype L] (F : SimpleGraph α) [DecidableRel F.Adj] (lab : V → L) (w : Sym2 V → ℝ)
    (Dt : Sym2 L → ℝ)
    (hD : ∀ x y, partitionAverage (labelPartition lab) w s(x, y) = Dt s(lab x, lab y)) :
    homDensity F (partitionAverage (labelPartition lab) w) =
      ∑ σ : α → L, (∏ i, (cnt lab (σ i) / Fintype.card V)) * homWeight F Dt σ := by
  have hw : ∀ φ : α → V, homWeight F (partitionAverage (labelPartition lab) w) φ =
      homWeight F Dt (lab ∘ φ) := by
    intro φ
    unfold homWeight
    refine Finset.prod_congr rfl fun e _ => ?_
    induction e using Sym2.ind with
    | _ a b => simp [hD]
  rw [homDensity]
  simp_rw [hw]
  rw [sum_comp_eq_sum_prod_cnt lab (homWeight F Dt), Finset.sum_div]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [Finset.prod_div_distrib, Finset.prod_const, Finset.card_univ]
  ring

end Masses

section Cells

variable (a : ∀ j, (Fin j → Bool) → ℝ)

/-- Left endpoints of the cells of the bit strings, for the masses `a`. -/
private noncomputable def leftEnd : ∀ j, (Fin j → Bool) → ℝ
  | 0, _ => 0
  | j + 1, s => leftEnd j (Fin.init s) +
      if s (Fin.last j) then a (j + 1) (Fin.snoc (Fin.init s) false) else 0

/-- The first `j` bits of `x` in the binary search through the cells of the masses `a`. -/
private noncomputable def cellOf (x : ℝ) : ∀ j, Fin j → Bool
  | 0 => fun l => l.elim0
  | j + 1 => Fin.snoc (cellOf x j)
      (decide (leftEnd a j (cellOf x j) + a (j + 1) (Fin.snoc (cellOf x j) false) ≤ x))

private lemma leftEnd_snoc (j : ℕ) (s : Fin j → Bool) (b : Bool) :
    leftEnd a (j + 1) (Fin.snoc s b) =
      leftEnd a j s + if b then a (j + 1) (Fin.snoc s false) else 0 := by
  simp [leftEnd, Fin.init_snoc]

private lemma cellOf_succ (x : ℝ) (j : ℕ) : cellOf a x (j + 1) = Fin.snoc (cellOf a x j)
    (decide (leftEnd a j (cellOf a x j) + a (j + 1) (Fin.snoc (cellOf a x j) false) ≤ x)) :=
  rfl

variable {a}

private lemma leftEnd_bounds (ha0 : ∀ j s, 0 ≤ a j s) (ha1 : ∀ s, a 0 s = 1)
    (ha2 : ∀ j s, a j s = a (j + 1) (Fin.snoc s false) + a (j + 1) (Fin.snoc s true)) :
    ∀ j s, 0 ≤ leftEnd a j s ∧ leftEnd a j s + a j s ≤ 1
  | 0, s => by simp [leftEnd, ha1]
  | j + 1, s => by
    obtain ⟨s', b, rfl⟩ : ∃ s' b, s = Fin.snoc s' b :=
      ⟨Fin.init s, s (Fin.last j), (Fin.snoc_init_self s).symm⟩
    have ih := leftEnd_bounds ha0 ha1 ha2 j s'
    have h2 := ha2 j s'
    have h0f := ha0 (j + 1) (Fin.snoc s' false)
    have h0t := ha0 (j + 1) (Fin.snoc s' true)
    rw [leftEnd_snoc]
    cases b <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> constructor <;> linarith

private lemma cellOf_eq_iff (ha0 : ∀ j s, 0 ≤ a j s) (ha1 : ∀ s, a 0 s = 1)
    (ha2 : ∀ j s, a j s = a (j + 1) (Fin.snoc s false) + a (j + 1) (Fin.snoc s true))
    {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x < 1) :
    ∀ j s, cellOf a x j = s ↔ leftEnd a j s ≤ x ∧ x < leftEnd a j s + a j s
  | 0, s => by
    simp only [leftEnd, ha1, zero_add]
    exact ⟨fun _ => ⟨hx0, hx1⟩, fun _ => Subsingleton.elim _ _⟩
  | j + 1, s => by
    obtain ⟨s', b, rfl⟩ : ∃ s' b, s = Fin.snoc s' b :=
      ⟨Fin.init s, s (Fin.last j), (Fin.snoc_init_self s).symm⟩
    have ih := cellOf_eq_iff ha0 ha1 ha2 hx0 hx1 j s'
    have h2 := ha2 j s'
    have h0f := ha0 (j + 1) (Fin.snoc s' false)
    have h0t := ha0 (j + 1) (Fin.snoc s' true)
    rw [cellOf_succ, Fin.snoc_injective2.eq_iff, leftEnd_snoc]
    have e1 : (cellOf a x j = s' ∧ decide (leftEnd a j (cellOf a x j) +
        a (j + 1) (Fin.snoc (cellOf a x j) false) ≤ x) = b) ↔
        (cellOf a x j = s' ∧ decide (leftEnd a j s' + a (j + 1) (Fin.snoc s' false) ≤ x) = b) := by
      constructor <;> rintro ⟨hc, hd⟩ <;> subst hc <;> exact ⟨rfl, hd⟩
    rw [e1, ih]
    cases b
    · simp only [Bool.false_eq_true, ↓reduceIte, add_zero, decide_eq_false_iff_not, not_le]
      constructor
      · rintro ⟨⟨h1, -⟩, h3⟩
        exact ⟨h1, h3⟩
      · rintro ⟨h1, h3⟩
        exact ⟨⟨h1, by linarith⟩, h3⟩
    · simp only [↓reduceIte, decide_eq_true_eq]
      constructor
      · rintro ⟨⟨-, h2⟩, h3⟩
        exact ⟨h3, by linarith⟩
      · rintro ⟨h1, h3⟩
        exact ⟨⟨by linarith, by linarith⟩, h1⟩

variable (a) in
private lemma measurable_cellOf : ∀ j, Measurable fun x => cellOf a x j
  | 0 => measurable_const
  | j + 1 => by
    have ih := measurable_cellOf j
    have hθ : Measurable fun x =>
        leftEnd a j (cellOf a x j) + a (j + 1) (Fin.snoc (cellOf a x j) false) :=
      (measurable_of_countable (fun s => leftEnd a j s + a (j + 1) (Fin.snoc s false))).comp ih
    have hb : Measurable fun x => decide
        (leftEnd a j (cellOf a x j) + a (j + 1) (Fin.snoc (cellOf a x j) false) ≤ x) := by
      apply measurable_to_bool
      have := measurableSet_le hθ measurable_id
      simpa [Set.preimage] using this
    simp only [cellOf_succ]
    refine measurable_pi_iff.2 fun l => ?_
    induction l using Fin.lastCases with
    | last => simpa using hb
    | cast l =>
      simp only [Fin.snoc_castSucc]
      exact (measurable_pi_apply l).comp ih

private lemma cellOf_res (x : ℝ) {i j : ℕ} (h : i ≤ j) : res h (cellOf a x j) = cellOf a x i := by
  induction j, h using Nat.le_induction with
  | base => rfl
  | succ j hij ih =>
    rw [← ih]
    funext l
    simp only [res, cellOf_succ]
    have : (Fin.castLE (by omega) l : Fin (j + 1)) = Fin.castSucc (Fin.castLE hij l) :=
      Fin.ext rfl
    rw [this, Fin.snoc_castSucc]

/-- The uniform probability measure on `[0, 1]`. -/
private noncomputable abbrev unitI : Measure ℝ := volume.restrict (Icc 0 1)

private instance unitI.isProbabilityMeasure : IsProbabilityMeasure unitI :=
  ⟨by simp [unitI]⟩

private lemma unitI_cellOf (ha0 : ∀ j s, 0 ≤ a j s) (ha1 : ∀ s, a 0 s = 1)
    (ha2 : ∀ j s, a j s = a (j + 1) (Fin.snoc s false) + a (j + 1) (Fin.snoc s true))
    (j : ℕ) (s : Fin j → Bool) : unitI.real {x | cellOf a x j = s} = a j s := by
  have hmeas : MeasurableSet {x | cellOf a x j = s} :=
    measurable_cellOf a j (measurableSet_singleton s)
  have hset : {x | cellOf a x j = s} ∩ Ico 0 1 = Ico (leftEnd a j s) (leftEnd a j s + a j s) := by
    ext x
    simp only [mem_inter_iff, Set.mem_ofPred_eq, mem_Ico]
    have hb := leftEnd_bounds ha0 ha1 ha2 j s
    constructor
    · rintro ⟨h, h0, h1⟩
      exact (cellOf_eq_iff ha0 ha1 ha2 h0 h1 j s).1 h
    · rintro ⟨h1, h2⟩
      have h0 : 0 ≤ x := le_trans hb.1 h1
      have h1' : x < 1 := lt_of_lt_of_le h2 hb.2
      exact ⟨(cellOf_eq_iff ha0 ha1 ha2 h0 h1' j s).2 ⟨h1, h2⟩, h0, h1'⟩
  rw [measureReal_def, unitI, ← Measure.restrict_congr_set Ico_ae_eq_Icc,
    Measure.restrict_apply hmeas, hset, Real.volume_Ico, add_sub_cancel_left,
    ENNReal.toReal_ofReal (ha0 j s)]

end Cells


section Martingale

/-- Integrals of functions of a map into a finite type are finite sums. -/
private lemma integral_comp_fintype {Ω β : Type*} [MeasurableSpace Ω] [MeasurableSpace β]
    [Fintype β] [MeasurableSingletonClass β] {ν : Measure Ω} [IsFiniteMeasure ν] {f : Ω → β}
    (hf : Measurable f) (G : β → ℝ) :
    ∫ p, G (f p) ∂ν = ∑ b, ν.real (f ⁻¹' {b}) * G b := by
  rw [← integral_map hf.aemeasurable (measurable_of_finite G).aestronglyMeasurable,
    integral_fintype Integrable.of_finite]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [smul_eq_mul, measureReal_def, Measure.map_apply hf (measurableSet_singleton b),
    measureReal_def]

variable (a : ∀ j, (Fin j → Bool) → ℝ) (e : ∀ j, (Fin j → Bool) → (Fin j → Bool) → ℝ)

/-- The averaged weight between two cells of level `j`. -/
private noncomputable def stepD (j : ℕ) (s s' : Fin j → Bool) : ℝ := e j s s' / (a j s * a j s')

/-- The pair of level-`j` cells of a point of the plane. -/
private noncomputable def cellPair (j : ℕ) (p : ℝ × ℝ) : (Fin j → Bool) × (Fin j → Bool) :=
  (cellOf a p.1 j, cellOf a p.2 j)

/-- The step kernel of level `j`. -/
private noncomputable def stepK (j : ℕ) (p : ℝ × ℝ) : ℝ :=
  stepD a e j (cellPair a j p).1 (cellPair a j p).2

private lemma measurable_cellPair (j : ℕ) : Measurable (cellPair a j) :=
  ((measurable_cellOf a j).comp measurable_fst).prodMk ((measurable_cellOf a j).comp measurable_snd)

private lemma cellPair_res {i j : ℕ} (h : i ≤ j) (p : ℝ × ℝ) :
    cellPair a i p = (res h (cellPair a j p).1, res h (cellPair a j p).2) := by
  simp [cellPair, cellOf_res]

/-- The filtration generated by the cells of the successive levels. -/
private noncomputable def cellFiltration :
    Filtration ℕ (inferInstance : MeasurableSpace (ℝ × ℝ)) where
  seq j := MeasurableSpace.comap (cellPair a j) inferInstance
  mono' i j hij := by
    have : cellPair a i = (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res hij q.1, res hij q.2)) ∘ cellPair a j := by
      funext p
      exact cellPair_res a hij p
    simp only
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_of_countable _).comap_le
  le' j := (measurable_cellPair a j).comap_le

private lemma measurable_stepK (j : ℕ) : Measurable (stepK a e j) :=
  (measurable_of_countable (fun q : (Fin j → Bool) × (Fin j → Bool) => stepD a e j q.1 q.2)).comp
    (measurable_cellPair a j)

private lemma stronglyMeasurable_stepK (j : ℕ) :
    StronglyMeasurable[cellFiltration a j] (stepK a e j) := by
  have h1 : Measurable[cellFiltration a j] (cellPair a j) := comap_measurable (cellPair a j)
  exact ((measurable_of_countable
    (fun q : (Fin j → Bool) × (Fin j → Bool) => stepD a e j q.1 q.2)).comp h1).stronglyMeasurable

private lemma div_mem_unitInterval {x y : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ y) : x / y ∈ Icc (0 : ℝ) 1 := by
  have hy : 0 ≤ y := le_trans h0 h1
  refine ⟨div_nonneg h0 hy, ?_⟩
  rcases hy.eq_or_lt with h | h
  · rw [← h, div_zero]
    exact zero_le_one
  · exact (div_le_one h).2 h1

variable {a e}

private lemma stepK_mem (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') (j : ℕ)
    (p : ℝ × ℝ) : stepK a e j p ∈ Icc (0 : ℝ) 1 :=
  div_mem_unitInterval (hle _ _ _).1 (hle _ _ _).2

private lemma norm_stepK_le (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') (j : ℕ)
    (p : ℝ × ℝ) : ‖stepK a e j p‖ ≤ 1 := by
  have := stepK_mem hle j p
  rw [Real.norm_eq_abs, abs_le]
  constructor <;> linarith [this.1, this.2]

private lemma integrable_stepK (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s')
    (j : ℕ) : Integrable (stepK a e j) (unitI.prod unitI) :=
  Integrable.of_bound (measurable_stepK a e j).aestronglyMeasurable 1
    (ae_of_all _ (norm_stepK_le hle j))

private lemma measureReal_cellPair (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (j : ℕ) (q : (Fin j → Bool) × (Fin j → Bool)) :
    (unitI.prod unitI).real (cellPair a j ⁻¹' {q}) = a j q.1 * a j q.2 := by
  have : cellPair a j ⁻¹' {q} = {x | cellOf a x j = q.1} ×ˢ {y | cellOf a y j = q.2} := by
    ext p
    simp [cellPair, Prod.ext_iff]
  rw [this, measureReal_prod_prod, hcell, hcell]

private lemma mul_stepD (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') (j : ℕ)
    (s s' : Fin j → Bool) : a j s * a j s' * stepD a e j s s' = e j s s' := by
  rw [stepD]
  by_cases h : a j s * a j s' = 0
  · have := hle j s s'
    rw [h, zero_mul]
    linarith [this.1, this.2]
  · rw [mul_comm]
    exact div_mul_cancel₀ _ h

open scoped Classical in
private lemma setIntegral_stepK (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') {i j : ℕ} (hij : i ≤ j)
    (B : Set ((Fin i → Bool) × (Fin i → Bool))) :
    ∫ p in cellPair a i ⁻¹' B, stepK a e j p ∂(unitI.prod unitI) =
      ∑ q : (Fin j → Bool) × (Fin j → Bool),
        if (res hij q.1, res hij q.2) ∈ B then e j q.1 q.2 else 0 := by
  have hB : MeasurableSet B := (Set.to_countable B).measurableSet
  rw [← integral_indicator (measurable_cellPair a i hB)]
  have hfun : (cellPair a i ⁻¹' B).indicator (stepK a e j) = fun p =>
      (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        if (res hij q.1, res hij q.2) ∈ B then stepD a e j q.1 q.2 else 0) (cellPair a j p) := by
    funext p
    simp only [Set.indicator, Set.mem_preimage, cellPair_res a hij p, stepK]
  rw [hfun, integral_comp_fintype (measurable_cellPair a j)]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [measureReal_cellPair hcell]
  split_ifs
  · exact mul_stepD hle j q.1 q.2
  · simp

open scoped Classical in
private lemma setIntegral_stepK_self (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') {i : ℕ}
    (B : Set ((Fin i → Bool) × (Fin i → Bool))) :
    ∫ p in cellPair a i ⁻¹' B, stepK a e i p ∂(unitI.prod unitI) =
      ∑ r : (Fin i → Bool) × (Fin i → Bool), if r ∈ B then e i r.1 r.2 else 0 := by
  have hB : MeasurableSet B := (Set.to_countable B).measurableSet
  rw [← integral_indicator (measurable_cellPair a i hB)]
  have hfun : (cellPair a i ⁻¹' B).indicator (stepK a e i) = fun p =>
      (fun r : (Fin i → Bool) × (Fin i → Bool) =>
        if r ∈ B then stepD a e i r.1 r.2 else 0) (cellPair a i p) := by
    funext p
    simp only [Set.indicator, Set.mem_preimage, stepK]
  rw [hfun, integral_comp_fintype (measurable_cellPair a i)]
  refine Finset.sum_congr rfl fun r _ => ?_
  rw [measureReal_cellPair hcell]
  split_ifs
  · exact mul_stepD hle i r.1 r.2
  · simp

/-- **The step kernels form a martingale** for the filtration generated by the cells: the average
of the level-`j` kernel over a level-`i` cell is the level-`i` kernel, because the edge masses are
additive under refinement. -/
private lemma martingale_stepK (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hres : ∀ i j (h : i ≤ j) (r : (Fin i → Bool) × (Fin i → Bool)), e i r.1 r.2 =
      ∑ q ∈ Finset.univ.filter (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res h q.1, res h q.2) = r), e j q.1 q.2)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') :
    Martingale (fun j => stepK a e j) (cellFiltration a) (unitI.prod unitI) := by
  refine ⟨fun j => stronglyMeasurable_stepK a e j, fun i j hij => ?_⟩
  have : IsFiniteMeasure ((unitI.prod unitI).trim ((cellFiltration a).le i)) :=
    isFiniteMeasure_trim _
  refine (ae_eq_condExp_of_forall_setIntegral_eq ((cellFiltration a).le i)
    (integrable_stepK hle j) (fun s _ _ => (integrable_stepK hle i).integrableOn)
    (fun s hs _ => ?_) (stronglyMeasurable_stepK a e i).aestronglyMeasurable).symm
  obtain ⟨B, -, rfl⟩ := hs
  rw [setIntegral_stepK hcell hle hij B, setIntegral_stepK_self hcell hle B]
  conv_rhs => rw [← Finset.sum_fiberwise Finset.univ
    (fun q : (Fin j → Bool) × (Fin j → Bool) => (res hij q.1, res hij q.2))]
  refine Finset.sum_congr rfl fun r _ => ?_
  by_cases hr : r ∈ B
  · rw [ite_eq_left hr, hres i j hij r]
    refine Finset.sum_congr rfl fun q hq => ?_
    rw [(Finset.mem_filter.1 hq).2, ite_eq_left hr]
  · rw [ite_eq_right hr]
    refine (Finset.sum_eq_zero fun q hq => ?_).symm
    rw [(Finset.mem_filter.1 hq).2, ite_eq_right hr]

private lemma ae_tendsto_stepK (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hres : ∀ i j (h : i ≤ j) (r : (Fin i → Bool) × (Fin i → Bool)), e i r.1 r.2 =
      ∑ q ∈ Finset.univ.filter (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res h q.1, res h q.2) = r), e j q.1 q.2)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') :
    ∀ᵐ p ∂(unitI.prod unitI), ∃ c, Tendsto (fun j => stepK a e j p) atTop (𝓝 c) := by
  refine (martingale_stepK hcell hres hle).submartingale.exists_ae_tendsto_of_bdd
    (lt_of_le_of_lt (iSup_le fun j => ?_) ENNReal.one_lt_top)
  have := eLpNorm_le_of_ae_bound (μ := unitI.prod unitI) (p := 1)
    (measurable_stepK a e j).aestronglyMeasurable (ae_of_all _ (norm_stepK_le hle j))
  simpa using this

variable (a e) in
/-- The limit kernel: the upper limit of the step kernels, clamped to `[0, 1]`. -/
private noncomputable def limK (p : ℝ × ℝ) : ℝ :=
  max 0 (min 1 (limsup (fun j => stepK a e j p) atTop))

variable (a e) in
private lemma measurable_limK : Measurable (limK a e) :=
  measurable_const.max (measurable_const.min (Measurable.limsup fun j => measurable_stepK a e j))

variable (a e) in
private lemma limK_mem (p : ℝ × ℝ) : limK a e p ∈ Icc (0 : ℝ) 1 :=
  ⟨le_max_left _ _, max_le zero_le_one (min_le_left _ _)⟩

private lemma stepK_swap (hsymm : ∀ j s s', e j s s' = e j s' s) (j : ℕ) (x y : ℝ) :
    stepK a e j (x, y) = stepK a e j (y, x) := by
  simp only [stepK, cellPair, stepD, hsymm j (cellOf a x j), mul_comm (a j (cellOf a x j))]

private lemma limK_swap (hsymm : ∀ j s s', e j s s' = e j s' s) (x y : ℝ) :
    limK a e (x, y) = limK a e (y, x) := by
  simp only [limK, stepK_swap hsymm _ x y]

private lemma ae_tendsto_limK (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hres : ∀ i j (h : i ≤ j) (r : (Fin i → Bool) × (Fin i → Bool)), e i r.1 r.2 =
      ∑ q ∈ Finset.univ.filter (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res h q.1, res h q.2) = r), e j q.1 q.2)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') :
    ∀ᵐ p ∂(unitI.prod unitI), Tendsto (fun j => stepK a e j p) atTop (𝓝 (limK a e p)) := by
  filter_upwards [ae_tendsto_stepK hcell hres hle] with p ⟨c, hc⟩
  have hc01 : c ∈ Icc (0 : ℝ) 1 :=
    isClosed_Icc.mem_of_tendsto hc (Eventually.of_forall fun j => stepK_mem hle j p)
  have : limK a e p = c := by
    rw [limK, hc.limsup_eq, min_eq_right hc01.2, max_eq_right hc01.1]
  rw [this]
  exact hc

private lemma tendsto_integral_abs_sub
    (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hres : ∀ i j (h : i ≤ j) (r : (Fin i → Bool) × (Fin i → Bool)), e i r.1 r.2 =
      ∑ q ∈ Finset.univ.filter (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res h q.1, res h q.2) = r), e j q.1 q.2)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s') :
    Tendsto (fun j => ∫ p, |stepK a e j p - limK a e p| ∂(unitI.prod unitI)) atTop (𝓝 0) := by
  have := tendsto_integral_of_dominated_convergence (μ := unitI.prod unitI) (fun _ => (1 : ℝ))
    (F := fun j p => |stepK a e j p - limK a e p|) (f := fun _ => 0)
    (fun j => (continuous_abs.measurable.comp
      ((measurable_stepK a e j).sub (measurable_limK a e))).aestronglyMeasurable)
    (integrable_const 1)
    (fun j => ae_of_all _ fun p => by
      have h1 := stepK_mem hle j p
      have h2 := limK_mem a e p
      rw [Real.norm_eq_abs, abs_abs, abs_le]
      constructor <;> linarith [h1.1, h1.2, h2.1, h2.2])
    (by
      filter_upwards [ae_tendsto_limK hcell hres hle] with p hp
      simpa using (hp.sub_const (limK a e p)).abs)
  simpa using this

/-- The cut norm of a bounded measurable kernel is at most its `L¹` norm on the unit square. -/
private lemma graphonCutNorm_le_integral {f : ℝ → ℝ → ℝ} (hf : Measurable (Function.uncurry f))
    (hb : ∀ x y, |f x y| ≤ 1) :
    graphonCutNorm f ≤ ∫ p, |f p.1 p.2| ∂(unitI.prod unitI) := by
  have hμ : unitI.prod unitI = volume.restrict (Icc (0 : ℝ) 1 ×ˢ Icc 0 1) := by
    rw [unitI, Measure.prod_restrict, ← Measure.volume_eq_prod]
  have : Nonempty CutPair :=
    ⟨⟨(∅, ∅), MeasurableSet.empty, MeasurableSet.empty, empty_subset _, empty_subset _⟩⟩
  have hint : Integrable (fun p : ℝ × ℝ => f p.1 p.2)
      (volume.restrict (Icc (0 : ℝ) 1 ×ˢ Icc 0 1)) := by
    rw [← hμ]
    exact Integrable.of_bound hf.aestronglyMeasurable 1
      (ae_of_all _ fun p => by simpa [Real.norm_eq_abs] using hb p.1 p.2)
  refine ciSup_le fun q => ?_
  calc |∫ z in q.1.1 ×ˢ q.1.2, f z.1 z.2| ≤ ∫ z in q.1.1 ×ˢ q.1.2, |f z.1 z.2| :=
        abs_integral_le_integral_abs
    _ ≤ ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc 0 1, |f z.1 z.2| :=
        setIntegral_mono_set hint.abs (ae_of_all _ fun _ => abs_nonneg _)
          (Eventually.of_forall fun z hz => prod_mono q.2.2.2.1 q.2.2.2.2 hz)
    _ = ∫ p, |f p.1 p.2| ∂(unitI.prod unitI) := by rw [hμ]

/-- **The densities of the step kernels converge** to those of the limit kernel, by the counting
lemma for graphons and the `L¹` convergence of the martingale. -/
private lemma tendsto_graphonHomDensity_stepK
    (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    (hres : ∀ i j (h : i ≤ j) (r : (Fin i → Bool) × (Fin i → Bool)), e i r.1 r.2 =
      ∑ q ∈ Finset.univ.filter (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res h q.1, res h q.2) = r), e j q.1 q.2)
    (hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s')
    (hsymm : ∀ j s s', e j s s' = e j s' s) {k : ℕ} (F : SimpleGraph (Fin k))
    [DecidableRel F.Adj] :
    Tendsto (fun j => graphonHomDensity F (fun x y => stepK a e j (x, y))) atTop
      (𝓝 (graphonHomDensity F (fun x y => limK a e (x, y)))) := by
  have hW : IsGraphon (fun x y => limK a e (x, y)) :=
    ⟨measurable_limK a e, fun x y => limK_swap hsymm x y, fun x y => limK_mem a e (x, y)⟩
  have hV : ∀ j, IsGraphon (fun x y => stepK a e j (x, y)) := fun j =>
    ⟨measurable_stepK a e j, fun x y => stepK_swap hsymm j x y, fun x y => stepK_mem hle j (x, y)⟩
  have hlim : Tendsto (fun j => (F.edgeFinset.card : ℝ) *
      ∫ p, |stepK a e j p - limK a e p| ∂(unitI.prod unitI)) atTop (𝓝 0) := by
    simpa using (tendsto_integral_abs_sub hcell hres hle).const_mul (F.edgeFinset.card : ℝ)
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun j => norm_nonneg _) (fun j => ?_) hlim
  rw [Real.norm_eq_abs]
  refine (abs_graphonHomDensity_sub_le F (hV j) hW).trans ?_
  gcongr
  refine graphonCutNorm_le_integral ((measurable_stepK a e j).sub (measurable_limK a e))
    fun x y => ?_
  have h1 := stepK_mem hle j (x, y)
  have h2 := limK_mem a e (x, y)
  rw [abs_le]
  constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]

/-- Products over the edges of a graph on `Fin k` are products over the ordered pairs `i < j` of
adjacent vertices. -/
private lemma prod_edgeFinset_eq_prod_prod {k : ℕ} (F : SimpleGraph (Fin k)) [DecidableRel F.Adj]
    (f : Sym2 (Fin k) → ℝ) :
    ∏ e ∈ F.edgeFinset, f e =
      ∏ i : Fin k, ∏ j : Fin k, if i < j ∧ F.Adj i j then f s(i, j) else 1 := by
  rw [← Fintype.prod_prod_type' (fun i j => if i < j ∧ F.Adj i j then f s(i, j) else 1),
    ← Finset.prod_filter]
  symm
  refine Finset.prod_nbij (fun p => s(p.1, p.2)) (fun p hp => ?_) (fun p hp q hq hpq => ?_)
    (fun e he => ?_) (fun _ _ => rfl)
  · have hp' := (Finset.mem_filter.mp hp).2
    exact SimpleGraph.mem_edgeFinset.mpr (F.mem_edgeSet.mpr hp'.2)
  · have hp' := (Finset.mem_filter.mp (Finset.mem_coe.mp hp)).2.1
    have hq' := (Finset.mem_filter.mp (Finset.mem_coe.mp hq)).2.1
    rcases Sym2.eq_iff.mp hpq with h | h
    · exact Prod.ext h.1 h.2
    · exact (lt_asymm hq' (by rw [← h.1, ← h.2]; exact hp')).elim
  · induction e using Sym2.ind with
    | _ i j =>
      have hij := F.mem_edgeSet.mp (SimpleGraph.mem_edgeFinset.mp (Finset.mem_coe.mp he))
      rcases lt_or_gt_of_ne hij.ne with h | h
      · exact ⟨(i, j), by simp [h, hij], rfl⟩
      · exact ⟨(j, i), by simp [h, hij.symm], Sym2.eq_swap⟩

/-- **Densities of a step kernel.** The density of `F` in the level-`j` step kernel is the
polynomial in the masses and averaged weights of the cells. -/
private lemma graphonHomDensity_stepK (hcell : ∀ j s, unitI.real {x | cellOf a x j = s} = a j s)
    {k : ℕ} (F : SimpleGraph (Fin k)) [DecidableRel F.Adj] (j : ℕ)
    (Dt : Sym2 (Fin j → Bool) → ℝ) (hDt : ∀ s s', Dt s(s, s') = stepD a e j s s') :
    graphonHomDensity F (fun x y => stepK a e j (x, y)) =
      ∑ σ : Fin k → (Fin j → Bool), (∏ i, a j (σ i)) * homWeight F Dt σ := by
  rw [graphonHomDensity, volume_pi, Measure.restrict_pi_pi]
  have hcv : Measurable fun x : Fin k → ℝ => fun i => cellOf a (x i) j :=
    measurable_pi_iff.2 fun i => (measurable_cellOf a j).comp (measurable_pi_apply i)
  have hfun : (fun x : Fin k → ℝ => ∏ i : Fin k, ∏ i' : Fin k,
      if i < i' ∧ F.Adj i i' then stepK a e j (x i, x i') else 1) =
        fun x => homWeight F Dt (fun i => cellOf a (x i) j) := by
    funext x
    rw [homWeight, prod_edgeFinset_eq_prod_prod]
    simp only [Sym2.map_mk, hDt, stepK, cellPair]
  rw [hfun, integral_comp_fintype hcv]
  refine Finset.sum_congr rfl fun σ _ => ?_
  congr 1
  have hpre : (fun x : Fin k → ℝ => fun i => cellOf a (x i) j) ⁻¹' {σ} =
      Set.univ.pi fun i => {x | cellOf a x j = σ i} := by
    ext x
    simp [funext_iff]
  rw [hpre, measureReal_def, Measure.pi_pi, ENNReal.toReal_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [← measureReal_def, hcell]

end Martingale

section Polynomial

/-- **Continuity of the density polynomial.** If the masses and edge masses of the classes
converge, the densities converge, also when some limit masses vanish. -/
private lemma tendsto_sum_prod_homWeight {L : Type*} [Fintype L] {k : ℕ}
    (F : SimpleGraph (Fin k)) [DecidableRel F.Adj] {A : ℕ → L → ℝ} {E : ℕ → L → L → ℝ}
    {a : L → ℝ} {e : L → L → ℝ} (hA : ∀ s, Tendsto (fun n => A n s) atTop (𝓝 (a s)))
    (hE : ∀ s s', Tendsto (fun n => E n s s') atTop (𝓝 (e s s')))
    (hA01 : ∀ n s, A n s ∈ Icc (0 : ℝ) 1)
    (hEle : ∀ n s s', 0 ≤ E n s s' ∧ E n s s' ≤ A n s * A n s')
    (DtA : ℕ → Sym2 L → ℝ) (hDtA : ∀ n s s', DtA n s(s, s') = E n s s' / (A n s * A n s'))
    (Dt : Sym2 L → ℝ) (hDt : ∀ s s', Dt s(s, s') = e s s' / (a s * a s')) :
    Tendsto (fun n => ∑ σ : Fin k → L, (∏ i, A n (σ i)) * homWeight F (DtA n) σ) atTop
      (𝓝 (∑ σ : Fin k → L, (∏ i, a (σ i)) * homWeight F Dt σ)) := by
  refine tendsto_finsetSum _ fun σ _ => ?_
  by_cases hpos : ∀ i, 0 < a (σ i)
  · refine (tendsto_finsetProd _ fun i _ => hA (σ i)).mul ?_
    refine tendsto_finsetProd _ fun z _ => ?_
    induction z using Sym2.ind with
    | _ u v =>
      simp only [Sym2.map_mk, hDtA, hDt]
      exact (hE _ _).div ((hA _).mul (hA _)) (mul_pos (hpos u) (hpos v)).ne'
  · push Not at hpos
    obtain ⟨i₀, hi₀⟩ := hpos
    have ha0 : a (σ i₀) = 0 :=
      le_antisymm hi₀ (ge_of_tendsto' (hA _) fun n => (hA01 n _).1)
    have hlim0 : (∏ i, a (σ i)) * homWeight F Dt σ = 0 := by
      rw [Finset.prod_eq_zero (Finset.mem_univ i₀) ha0, zero_mul]
    rw [hlim0]
    have hDtA01 : ∀ n z, DtA n z ∈ Icc (0 : ℝ) 1 := by
      intro n z
      induction z using Sym2.ind with
      | _ u v => rw [hDtA]; exact div_mem_unitInterval (hEle n u v).1 (hEle n u v).2
    have hbound : ∀ n, ‖(∏ i, A n (σ i)) * homWeight F (DtA n) σ‖ ≤ A n (σ i₀) := by
      intro n
      have hP0 : 0 ≤ ∏ i, A n (σ i) := Finset.prod_nonneg fun i _ => (hA01 n _).1
      have hP : ∏ i, A n (σ i) ≤ A n (σ i₀) := by
        rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i₀)]
        calc A n (σ i₀) * ∏ i ∈ Finset.univ.erase i₀, A n (σ i) ≤ A n (σ i₀) * 1 :=
              mul_le_mul_of_nonneg_left
                (Finset.prod_le_one₀ (fun i _ => (hA01 n _).1) fun i _ => (hA01 n _).2)
                (hA01 n _).1
          _ = A n (σ i₀) := mul_one _
      have hH0 : 0 ≤ homWeight F (DtA n) σ :=
        Finset.prod_nonneg fun _ _ => (hDtA01 n _).1
      have hH1 : homWeight F (DtA n) σ ≤ 1 :=
        Finset.prod_le_one₀ (fun _ _ => (hDtA01 n _).1) fun _ _ => (hDtA01 n _).2
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hP0 hH0)]
      calc (∏ i, A n (σ i)) * homWeight F (DtA n) σ ≤ A n (σ i₀) * 1 :=
            mul_le_mul hP hH1 hH0 (hA01 n _).1
        _ = A n (σ i₀) := mul_one _
    exact squeeze_zero_norm hbound (ha0 ▸ hA (σ i₀))

end Polynomial


private lemma partitionAverage_mem {V : Type*} [Fintype V] [DecidableEq V]
    (P : Finpartition (Finset.univ : Finset V)) {w : Sym2 V → ℝ}
    (hw : ∀ z, w z ∈ Icc (0 : ℝ) 1) (z : Sym2 V) :
    0 ≤ partitionAverage P w z ∧ partitionAverage P w z ≤ 1 := by
  induction z using Sym2.ind with
  | _ x y =>
    rw [partitionAverage_apply]
    have hx : 0 < ((P.part x).card : ℝ) := by
      exact_mod_cast Finset.card_pos.2 ⟨x, P.mem_part (Finset.mem_univ x)⟩
    have hy : 0 < ((P.part y).card : ℝ) := by
      exact_mod_cast Finset.card_pos.2 ⟨y, P.mem_part (Finset.mem_univ y)⟩
    constructor
    · exact div_nonneg (Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => (hw _).1)
        (by positivity)
    · rw [div_le_one (by positivity)]
      calc ∑ a ∈ P.part x, ∑ b ∈ P.part y, w s(a, b) ≤
            ∑ _a ∈ P.part x, ∑ _b ∈ P.part y, (1 : ℝ) :=
            Finset.sum_le_sum fun _ _ => Finset.sum_le_sum fun _ _ => (hw _).2
        _ = _ := by simp

/-- **Lovász–Szegedy limit theorem.** Every convergent sequence of (nonempty) simple graphs has a
graphon limit: there is a graphon `W` with `t(F, Gₙ) → t(F, W)` for every simple graph `F`
(Lovász–Szegedy, *Limits of dense graph sequences* (2006), Theorem 2.2, (a) ⇒ (b);
Borgs–Chayes–Lovász–Sós–Vesztergombi, *Convergent sequences of dense graphs I* (2008),
Theorem 3.1). -/
public theorem exists_graphon_limit {N : ℕ → ℕ} (G : ∀ n, SimpleGraph (Fin (N n)))
    [∀ n, DecidableRel (G n).Adj] (hN : ∀ n, 0 < N n) (hG : IsConvergentGraphSequence G) :
    ∃ W : ℝ → ℝ → ℝ, IsGraphon W ∧ ∀ (k : ℕ) (F : SimpleGraph (Fin k)) [DecidableRel F.Adj],
      Tendsto (fun n => homDensity F (adjWeight (G n))) atTop (𝓝 (graphonHomDensity F W)) := by
  -- nested weakly regular bit labellings of the graphs
  have hw01 : ∀ n z, adjWeight (G n) z ∈ Icc (0 : ℝ) 1 := fun n z =>
    adjWeight_mem_unitInterval (G n) z
  have hcard : ∀ n, 0 < Fintype.card (Fin (N n)) := fun n => by simpa using hN n
  choose β hβ using fun n => exists_bits (hcard n) (adjWeight (G n)) (hw01 n)
  -- masses and edge masses of the cells
  set A : ℕ → ∀ j, (Fin j → Bool) → ℝ := fun n j s => cnt (pre (β n) j) s / N n with hA_def
  set E : ℕ → ∀ j, (Fin j → Bool) → (Fin j → Bool) → ℝ := fun n j s s' =>
    esum (pre (β n) j) (adjWeight (G n)) s s' / (N n : ℝ) ^ 2 with hE_def
  have hNpos : ∀ n, (0 : ℝ) < N n := fun n => Nat.cast_pos.2 (hN n)
  have hA01 : ∀ n j s, A n j s ∈ Icc (0 : ℝ) 1 := fun n j s => by
    refine ⟨div_nonneg (cnt_nonneg _ _) (hNpos n).le, (div_le_one (hNpos n)).2 ?_⟩
    simpa using cnt_le_card (pre (β n) j) s
  have hEle : ∀ n j s s', 0 ≤ E n j s s' ∧ E n j s s' ≤ A n j s * A n j s' := fun n j s s' => by
    refine ⟨div_nonneg (esum_nonneg _ (fun z => (hw01 n z).1) _ _) (by positivity), ?_⟩
    have h := esum_le (pre (β n) j) (fun z => (hw01 n z).2) s s'
    simp only [hA_def, hE_def]
    rw [div_mul_div_comm, ← sq]
    exact div_le_div_of_nonneg_right h (by positivity)
  -- a subsequence along which all masses and edge masses converge
  obtain ⟨ψ, hψ, a, e, hAa, hEe⟩ : ∃ ψ : ℕ → ℕ, StrictMono ψ ∧
      ∃ (a : ∀ j, (Fin j → Bool) → ℝ) (e : ∀ j, (Fin j → Bool) → (Fin j → Bool) → ℝ),
        (∀ j s, Tendsto (fun n => A (ψ n) j s) atTop (𝓝 (a j s))) ∧
        (∀ j s s', Tendsto (fun n => E (ψ n) j s s') atTop (𝓝 (e j s s'))) := by
    let X : ℕ → (Bool × Σ j : ℕ, (Fin j → Bool) × (Fin j → Bool)) → ℝ := fun n i =>
      if i.1 then A n i.2.1 i.2.2.1 else E n i.2.1 i.2.2.1 i.2.2.2
    have hX : ∀ n, X n ∈ Set.univ.pi fun _ => Icc (0 : ℝ) 1 := by
      intro n i _
      by_cases h : i.1
      · simp only [X, h, ↓reduceIte]
        exact hA01 n _ _
      · simp only [X, h, Bool.false_eq_true, ↓reduceIte]
        obtain ⟨h0, h1⟩ := hEle n i.2.1 i.2.2.1 i.2.2.2
        have hx := hA01 n i.2.1 i.2.2.1
        have hy := hA01 n i.2.1 i.2.2.2
        exact ⟨h0, h1.trans ((mul_le_mul hx.2 hy.2 hy.1 zero_le_one).trans (one_mul 1).le)⟩
    obtain ⟨x, -, ψ, hψ, hlim⟩ := (isCompact_univ_pi fun _ => isCompact_Icc).tendsto_subseq hX
    have hcoord := tendsto_pi_nhds.1 hlim
    exact ⟨ψ, hψ, fun j s => x (true, ⟨j, s, s⟩), fun j s s' => x (false, ⟨j, s, s'⟩),
      fun j s => hcoord (true, ⟨j, s, s⟩), fun j s s' => hcoord (false, ⟨j, s, s'⟩)⟩
  -- the limits form a mass system with additive edge masses
  have ha0 : ∀ j s, 0 ≤ a j s := fun j s => ge_of_tendsto' (hAa j s) fun n => (hA01 _ j s).1
  have ha1 : ∀ s, a 0 s = 1 := fun s => by
    refine tendsto_nhds_unique (hAa 0 s) ?_
    have : ∀ n, A (ψ n) 0 s = 1 := fun n => by
      simp only [hA_def, cnt_pre_zero, Fintype.card_fin]
      exact div_self (hNpos _).ne'
    simp only [this]
    exact tendsto_const_nhds
  have ha2 : ∀ j s, a j s = a (j + 1) (Fin.snoc s false) + a (j + 1) (Fin.snoc s true) := by
    intro j s
    refine tendsto_nhds_unique (hAa j s) ?_
    have : ∀ n, A (ψ n) j s = A (ψ n) (j + 1) (Fin.snoc s false) +
        A (ψ n) (j + 1) (Fin.snoc s true) := fun n => by
      simp only [hA_def, cnt_pre_succ (β (ψ n)) j s, add_div]
    simp only [this]
    exact (hAa _ _).add (hAa _ _)
  have hle : ∀ j s s', 0 ≤ e j s s' ∧ e j s s' ≤ a j s * a j s' := fun j s s' =>
    ⟨ge_of_tendsto' (hEe j s s') fun n => (hEle _ j s s').1,
      le_of_tendsto_of_tendsto' (hEe j s s') ((hAa j s).mul (hAa j s'))
        fun n => (hEle _ j s s').2⟩
  have hsymm : ∀ j s s', e j s s' = e j s' s := fun j s s' => by
    refine tendsto_nhds_unique (hEe j s s') ?_
    have : ∀ n, E (ψ n) j s s' = E (ψ n) j s' s := fun n => by
      simp only [hE_def, esum_comm]
    simp only [this]
    exact hEe j s' s
  have hres : ∀ i j (h : i ≤ j) (r : (Fin i → Bool) × (Fin i → Bool)), e i r.1 r.2 =
      ∑ q ∈ Finset.univ.filter (fun q : (Fin j → Bool) × (Fin j → Bool) =>
        (res h q.1, res h q.2) = r), e j q.1 q.2 := by
    intro i j h r
    refine tendsto_nhds_unique (hEe i r.1 r.2) ?_
    have : ∀ n, E (ψ n) i r.1 r.2 = ∑ q ∈ Finset.univ.filter
        (fun q : (Fin j → Bool) × (Fin j → Bool) => (res h q.1, res h q.2) = r),
          E (ψ n) j q.1 q.2 := fun n => by
      simp only [hE_def]
      rw [← Finset.sum_div, ← res_comp_pre (β (ψ n)) h, esum_comp, Prod.mk.eta]
    simp only [this]
    exact tendsto_finsetSum _ fun q _ => hEe j q.1 q.2
  have hcell := unitI_cellOf ha0 ha1 ha2
  -- the limit graphon
  refine ⟨fun x y => limK a e (x, y),
    ⟨measurable_limK a e, fun x y => limK_swap hsymm x y, fun x y => limK_mem a e (x, y)⟩,
    fun k F _ => ?_⟩
  obtain ⟨τ, hτ⟩ := hG k F
  suffices hτW : τ = graphonHomDensity F (fun x y => limK a e (x, y)) by
    rw [← hτW]
    exact hτ
  -- at level `k₀`, the limit density is within `|E(F)| / (k₀ + 1)` of the step kernel's density
  have hlevel : ∀ k₀ : ℕ, |τ - graphonHomDensity F
      (fun x y => stepK a e (bitLevel (k₀ + 1)) (x, y))| ≤
        F.edgeFinset.card * (1 / ((k₀ : ℝ) + 1)) := by
    intro k₀
    set j := bitLevel (k₀ + 1) with hj
    let DtA : ℕ → Sym2 (Fin j → Bool) → ℝ := fun n => Sym2.lift
      ⟨fun s s' => E n j s s' / (A n j s * A n j s'), fun s s' => by
        simp only [hE_def, esum_comm (pre (β n) j) _ s s', mul_comm (A n j s)]⟩
    let Dt : Sym2 (Fin j → Bool) → ℝ := Sym2.lift
      ⟨stepD a e j, fun s s' => by simp only [stepD, hsymm j s s', mul_comm (a j s)]⟩
    have hΦ : ∀ n, homDensity F (partitionAverage (labelPartition (pre (β n) j))
        (adjWeight (G n))) = ∑ σ : Fin k → (Fin j → Bool),
          (∏ i, A n j (σ i)) * homWeight F (DtA n) σ := by
      intro n
      rw [homDensity_partitionAverage F (pre (β n) j) (adjWeight (G n)) (DtA n)]
      · simp only [Fintype.card_fin, hA_def]
      · intro x y
        rw [partitionAverage_labelPartition]
        simp only [DtA, Sym2.lift_mk, hA_def, hE_def]
        have hN0 : (N n : ℝ) ≠ 0 := (hNpos n).ne'
        rw [div_mul_div_comm, ← sq, div_div_div_cancel_right₀ (pow_ne_zero 2 hN0)]
    have hn : ∀ n, |homDensity F (adjWeight (G n)) - ∑ σ : Fin k → (Fin j → Bool),
        (∏ i, A n j (σ i)) * homWeight F (DtA n) σ| ≤
          F.edgeFinset.card * (1 / ((k₀ : ℝ) + 1)) := by
      intro n
      have hcount := abs_homDensity_sub_homDensity_le F (adjWeight (G n))
        (partitionAverage (labelPartition (pre (β n) j)) (adjWeight (G n)))
        (adjWeight_mem_unitInterval _) (partitionAverage_mem _ (hw01 n))
      rw [hΦ n] at hcount
      exact hcount.trans (mul_le_mul_of_nonneg_left (hβ n k₀) (Nat.cast_nonneg _))
    have hlimΦ : Tendsto (fun n => ∑ σ : Fin k → (Fin j → Bool),
        (∏ i, A (ψ n) j (σ i)) * homWeight F (DtA (ψ n)) σ) atTop
          (𝓝 (graphonHomDensity F (fun x y => stepK a e j (x, y)))) := by
      rw [graphonHomDensity_stepK hcell F j Dt (fun s s' => by simp [Dt])]
      exact tendsto_sum_prod_homWeight F (fun s => hAa j s) (fun s s' => hEe j s s')
        (fun n s => hA01 _ j s) (fun n s s' => hEle _ j s s') (fun n => DtA (ψ n))
        (fun n s s' => by simp [DtA]) Dt (fun s s' => by simp [Dt, stepD])
    have hτψ : Tendsto (fun n => homDensity F (adjWeight (G (ψ n)))) atTop (𝓝 τ) :=
      hτ.comp hψ.tendsto_atTop
    exact le_of_tendsto' ((hτψ.sub hlimΦ).abs) fun n => hn (ψ n)
  -- let the level tend to infinity
  have hconv : Tendsto (fun k₀ : ℕ => graphonHomDensity F
      (fun x y => stepK a e (bitLevel (k₀ + 1)) (x, y))) atTop
        (𝓝 (graphonHomDensity F (fun x y => limK a e (x, y)))) :=
    (tendsto_graphonHomDensity_stepK hcell hres hle hsymm F).comp
      (bitLevel_strictMono.tendsto_atTop.comp (tendsto_add_atTop_nat 1))
  have hbound : Tendsto (fun k₀ : ℕ => (F.edgeFinset.card : ℝ) * (1 / ((k₀ : ℝ) + 1))) atTop
      (𝓝 0) := by
    simpa using tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (F.edgeFinset.card : ℝ)
  have h0 : |τ - graphonHomDensity F (fun x y => limK a e (x, y))| ≤ 0 :=
    le_of_tendsto_of_tendsto' ((tendsto_const_nhds.sub hconv).abs) hbound hlevel
  exact sub_eq_zero.1 (abs_nonpos_iff.1 h0)

end MathlibExt.Combinatorics.SimpleGraph.GraphLimitsWanted
