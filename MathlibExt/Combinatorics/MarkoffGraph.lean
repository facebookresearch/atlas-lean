/-!
# Chen's theorem for Markoff graphs

The Markoff graph over `ZMod p`.

Vertices are nonzero solutions to the Markoff equation
`x₀² + x₁² + x₂² = 3 x₀ x₁ x₂`,
and edges are generated by the three Vieta involutions.

`dvd_card_connectedComponent_markoffGraph` proves that for primes `p > 3` each component has
cardinality divisible by `p`, by summing Martin's coordinates over the component.
-/

@[expose] public section

namespace MathlibExt.Combinatorics.MarkoffGraphWanted
namespace Combinatorics

open scoped BigOperators

set_option linter.dupNamespace false in
/-- **Markoff triples modulo an integer.** The vertices are the nonzero triples
$(x_0,x_1,x_2)$ over `ZMod p` satisfying $x_0^2+x_1^2+x_2^2=3x_0x_1x_2$.

Source: Daniel E. Martin, *A new proof of Chen's theorem for Markoff graphs*,
https://arxiv.org/abs/2502.15960. -/
abbrev MarkoffTriple (p : ℕ) :=
  { x : Fin 3 → ZMod p //
      x ≠ 0 ∧ x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 = (3 : ZMod p) * x 0 * x 1 * x 2 }

set_option linter.dupNamespace false in
/-- **Markoff graph modulo an integer.** Two distinct nonzero Markoff triples over `ZMod p`
are adjacent when one is obtained from the other by replacing a single coordinate $x_i$
with $3x_jx_k-x_i$, where $j$ and $k$ are the other two indices.

Source: Daniel E. Martin, *A new proof of Chen's theorem for Markoff graphs*,
https://arxiv.org/abs/2502.15960. -/
def markoffGraph (p : ℕ) : SimpleGraph (MarkoffTriple p) where
  Adj x y :=
    x ≠ y ∧
      ((y.1 0 = (3 : ZMod p) * x.1 1 * x.1 2 - x.1 0 ∧ y.1 1 = x.1 1 ∧ y.1 2 = x.1 2) ∨
       (y.1 1 = (3 : ZMod p) * x.1 0 * x.1 2 - x.1 1 ∧ y.1 0 = x.1 0 ∧ y.1 2 = x.1 2) ∨
       (y.1 2 = (3 : ZMod p) * x.1 0 * x.1 1 - x.1 2 ∧ y.1 0 = x.1 0 ∧ y.1 1 = x.1 1))
  symm.symm := by
    intro x y hxy
    rcases hxy with ⟨hneq, hmove | hmove | hmove⟩
    · constructor
      · exact hneq.symm
      · refine Or.inl ?_
        rcases hmove with ⟨h0, h1, h2⟩
        constructor
        · rw [h1, h2, h0]
          simp [sub_eq_add_neg, add_left_comm, add_comm]
        · exact ⟨by simp [h1], by simp [h2]⟩
    · constructor
      · exact hneq.symm
      · refine Or.inr <| Or.inl ?_
        rcases hmove with ⟨h1, h0, h2⟩
        constructor
        · rw [h0, h2, h1]
          simp [sub_eq_add_neg, add_left_comm, add_comm]
        · exact ⟨by simp [h0], by simp [h2]⟩
    · constructor
      · exact hneq.symm
      · refine Or.inr <| Or.inr ?_
        rcases hmove with ⟨h2, h0, h1⟩
        constructor
        · rw [h0, h1, h2]
          simp [sub_eq_add_neg, add_comm]
        · exact ⟨by simp [h0], by simp [h1]⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

variable {p : ℕ}

-- The sum of the two possible values of coordinate i, with the other two held fixed.
private def rootSum (x : Fin 3 → ZMod p) : Fin 3 → ZMod p :=
  ![3 * x 1 * x 2, 3 * x 0 * x 2, 3 * x 0 * x 1]

private def reflectCoord (i : Fin 3) (x : Fin 3 → ZMod p) : Fin 3 → ZMod p :=
  Function.update x i (rootSum x i - x i)

private lemma rootSum_reflect (i : Fin 3) (x : Fin 3 → ZMod p) :
    rootSum (reflectCoord i x) i = rootSum x i := by
  fin_cases i <;> rfl

private lemma reflect_involutive (i : Fin 3) : Function.Involutive (reflectCoord (p := p) i) := by
  intro x
  change Function.update (reflectCoord i x) i
    (rootSum (reflectCoord i x) i - reflectCoord i x i) = x
  rw [rootSum_reflect]
  simp [reflectCoord, Function.update_idem]

private def vieta (i : Fin 3) (x : MarkoffTriple p) : MarkoffTriple p := by
  refine ⟨reflectCoord i x.1, ?_, ?_⟩
  · have hzero : reflectCoord (p := p) i 0 = 0 := by
      fin_cases i <;> simp [reflectCoord, rootSum, Function.update_zero]
    intro h
    exact x.2.1 ((reflect_involutive i).injective (h.trans hzero.symm))
  · have h := x.2.2
    fin_cases i <;> dsimp [reflectCoord, rootSum, Function.update] <;> linear_combination h

private lemma mem_vieta (c : (markoffGraph p).ConnectedComponent) (i : Fin 3)
    (x : MarkoffTriple p) (hx : x ∈ c.supp) : vieta i x ∈ c.supp := by
  by_cases h : x = vieta i x
  · rwa [← h]
  · apply (c.mem_supp_congr_adj (v := x) (w := vieta i x) ?_).mp hx
    refine ⟨h, ?_⟩
    fin_cases i
    · exact Or.inl ⟨rfl, rfl, rfl⟩
    · exact Or.inr (Or.inl ⟨rfl, rfl, rfl⟩)
    · exact Or.inr (Or.inr ⟨rfl, rfl, rfl⟩)

private def componentVieta (c : (markoffGraph p).ConnectedComponent) (i : Fin 3) :
    Equiv.Perm c :=
  Function.Involutive.toPerm (fun x ↦ ⟨vieta i x.1, mem_vieta c i x.1 x.2⟩)
    (fun x ↦ Subtype.ext (Subtype.ext (reflect_involutive i x.1.1)))

variable [Fact p.Prime]

-- Twice Martin's coordinate minus one. When the other two coordinates have zero
-- product, Martin's coordinate is 1/2, and the centered weight is zero.
private def weight (x : Fin 3 → ZMod p) (i : Fin 3) : ZMod p :=
  (2 * x i - rootSum x i) / rootSum x i

private lemma weight_reflect (i : Fin 3) (x : Fin 3 → ZMod p) :
    weight (reflectCoord i x) i = -weight x i := by
  simp only [weight, rootSum_reflect, ← neg_div]
  rw [reflectCoord, Function.update_self]
  congr 1
  ring

private lemma sum_weight (h3 : (3 : ZMod p) ≠ 0) (x : MarkoffTriple p) :
    ∑ i, weight x.1 i = -1 := by
  have h := x.2.2
  have hn : x.1 0 ≠ 0 ∨ x.1 1 ≠ 0 ∨ x.1 2 ≠ 0 := by
    by_contra! hz
    apply x.2.1
    funext i
    fin_cases i <;> simp_all
  rw [Fin.sum_univ_three]
  dsimp [weight, rootSum]
  by_cases ha : x.1 0 = 0 <;> by_cases hb : x.1 1 = 0 <;> by_cases hc : x.1 2 = 0
  all_goals simp_all
  field_simp
  linear_combination 2 * h

/- For prime `p > 3`, every connected component of the nonzero Markoff graph over `ZMod p`
has cardinality divisible by `p`. -/
set_option linter.dupNamespace false in
/-- **Chen's theorem for Markoff graphs.** Let $p > 3$ be a prime. The Markoff graph over
$\mathbb{Z}/p\mathbb{Z}$ has as vertices the nonzero triples $(x_0, x_1, x_2)$ of elements of
$\mathbb{Z}/p\mathbb{Z}$ with $x_0^2 + x_1^2 + x_2^2 = 3 x_0 x_1 x_2$, and two distinct
triples are adjacent when one is obtained from the other by a Vieta involution, which replaces
one coordinate $x_i$ by $3 x_j x_k - x_i$ and keeps the other two coordinates $x_j$, $x_k$,
where $\{i, j, k\} = \{0, 1, 2\}$. Every connected component of this graph has a number of
vertices divisible by $p$.

Source: https://link.springer.com/article/10.1007/s00222-025-01346-9 Via
leanprover/lean-eval@38361be, problem `dvd_card_connectedComponent_markoffGraph`. -/
public theorem dvd_card_connectedComponent_markoffGraph
    {p : ℕ} (hp : Nat.Prime p) (hgt : 3 < p) :
    ∀ c : (markoffGraph p).ConnectedComponent, p ∣ Nat.card c := by
  classical
  intro c
  let : Fact p.Prime := ⟨hp⟩
  let : Fintype c := Fintype.ofFinite c
  have hsmall (n : ℕ) (hn : 0 < n) (hnp : n < p) : (n : ZMod p) ≠ 0 :=
    fun h ↦ hnp.not_ge (Nat.le_of_dvd hn ((ZMod.natCast_eq_zero_iff n p).mp h))
  have h2 : (2 : ZMod p) ≠ 0 := hsmall 2 (by decide) (by omega)
  have h3 : (3 : ZMod p) ≠ 0 := hsmall 3 (by decide) hgt
  have cancel (i : Fin 3) : ∑ x : c, weight x.1.1 i = 0 := by
    have h := Equiv.sum_comp (componentVieta c i) (fun x : c ↦ weight x.1.1 i)
    change ∑ x : c, weight (reflectCoord i x.1.1) i = _ at h
    simp only [weight_reflect, Finset.sum_neg_distrib] at h
    apply (mul_eq_zero.mp ?_).resolve_left h2
    simpa only [two_mul] using neg_eq_iff_add_eq_zero.mp h
  apply (ZMod.natCast_eq_zero_iff _ _).mp
  have h : ∑ x : c, ∑ i, weight x.1.1 i = 0 := by
    rw [Finset.sum_comm]
    simp [cancel]
  simpa [sum_weight h3, Nat.card_eq_fintype_card] using h

end Combinatorics

end MathlibExt.Combinatorics.MarkoffGraphWanted
