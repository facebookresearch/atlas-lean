/-!
# The Chow ring of a matroid

Following K. Adiprasito, J. Huh and E. Katz, *Hodge theory for combinatorial geometries*,
Ann. of Math. 188 (2018), 381–452 (arXiv:1511.02888v2), Definition 1.3 and Section 5.3 (the
presentation is due to Feichtner and Yuzvinsky): for a matroid `M` on `E`, let `S_M` be the
polynomial ring over `ℝ` with one variable `x_F` for each nonempty proper flat `F` of `M`. The
Chow ring of `M` is `A*(M)_ℝ = S_M / (I_M + J_M)`, where `I_M` is generated by the products
`x_{F₁} x_{F₂}` of incomparable nonempty proper flats and `J_M` by the linear forms
`∑_{i₁ ∈ F} x_F - ∑_{i₂ ∈ F} x_F` for distinct `i₁, i₂ ∈ E`.

This file defines the ring, its graded pieces `A^q(M)_ℝ` (the images of the homogeneous
polynomials of degree `q`; the ideal is generated by homogeneous elements), the classes `α_M`
and `β_M` of AHK Definition 5.7, strictly submodular functions and the associated classes
`ℓ(c) = ∑_F c_F x_F` of AHK Section 1.2, and the normalisation `IsDegreeMap` of a degree map
(AHK Definition 5.9). It proves the defining relations (`x_mul_x_eq_zero_of_incomparable`,
`alphaClass_eq`), that `α_M + β_M = ∑_F x_F` and `β_M` does not depend on the element
(`alphaClass_add_betaClass`, `betaClass_eq`), and that `I ↦ |I| |E \ I|` is strictly submodular
(`isStrictlySubmodular_ncard_mul_ncard_diff`, AHK Section 1.2). The existence of the degree map,
the hard Lefschetz theorem and the Hodge–Riemann relations are stated in
`WantedExt.Combinatorics.MatroidHodgeTheoryWanted`.

The definitions are intended for finite matroids; sums over flats are `finsum`s, which agree with
finite sums when the matroid is finite.
-/

@[expose] public section

namespace MathlibExt.Combinatorics.Matroid.Chow

open MvPolynomial

variable {α : Type*} (M : _root_.Matroid α)

/-- **Nonempty proper flats of a matroid.** The flats `F` of `M` with `F ≠ ∅` and `F ≠ E`; they
index the variables `x_F` of the Chow ring (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Definition 1.3). -/
abbrev ProperFlat : Type _ := {F : Set α // M.IsFlat F ∧ F.Nonempty ∧ F ≠ M.E}

instance finite_properFlat [M.Finite] : Finite (ProperFlat M) := by
  have : Finite {F : Set α // F ⊆ M.E} :=
    Set.Finite.to_subtype (M.ground_finite.finite_subsets)
  exact Finite.of_injective
    (fun F : ProperFlat M => (⟨F.1, F.2.1.subset_ground⟩ : {F : Set α // F ⊆ M.E}))
    (fun F G h => Subtype.ext (by simpa using congrArg Subtype.val h))

/-- **The Chow ideal `I_M + J_M` of a matroid** (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Definition 1.3). In the polynomial ring
`ℝ[x_F]` over the nonempty proper flats `F` of `M`, it is generated by the monomials
`x_{F₁} x_{F₂}` for incomparable `F₁, F₂` (the ideal `I_M`) and by the linear forms
`∑_{i₁ ∈ F} x_F - ∑_{i₂ ∈ F} x_F` for distinct elements `i₁, i₂` of the ground set (the ideal
`J_M`). -/
noncomputable def chowIdeal : Ideal (MvPolynomial (ProperFlat M) ℝ) :=
  Ideal.span {p | ∃ F G : ProperFlat M, ¬ F.1 ⊆ G.1 ∧ ¬ G.1 ⊆ F.1 ∧ p = X F * X G} ⊔
    Ideal.span {p | ∃ i ∈ M.E, ∃ j ∈ M.E, i ≠ j ∧
      p = (∑ᶠ (F : ProperFlat M) (_ : i ∈ F.1), X F) - ∑ᶠ (F : ProperFlat M) (_ : j ∈ F.1), X F}

/-- **The Chow ring `A*(M)_ℝ` of a matroid** (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Definition 1.3; Feichtner and Yuzvinsky,
Invent. Math. 155 (2004)). It is the quotient of the polynomial ring `ℝ[x_F]`, one variable for
each nonempty proper flat `F` of `M`, by the Chow ideal `I_M + J_M`. -/
abbrev ChowRing : Type _ := MvPolynomial (ProperFlat M) ℝ ⧸ chowIdeal M

/-- **The generator `x_F` of the Chow ring** attached to a nonempty proper flat `F` (Adiprasito,
Huh and Katz, *Hodge theory for combinatorial geometries*, Ann. of Math. 188 (2018),
Definition 1.3). -/
noncomputable def x (F : ProperFlat M) : ChowRing M :=
  Ideal.Quotient.mk (chowIdeal M) (X F)

/-- **Graded piece `A^q(M)_ℝ` of the Chow ring** (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Definition 1.3 and Section 5.2). The image
in `A*(M)_ℝ` of the homogeneous polynomials of degree `q` in the variables `x_F`; the Chow ideal
is generated by homogeneous elements, so these subspaces grade the ring. -/
noncomputable def gradedPiece (q : ℕ) : Submodule ℝ (ChowRing M) :=
  (homogeneousSubmodule (ProperFlat M) ℝ q).map
    (Ideal.Quotient.mkₐ ℝ (chowIdeal M)).toLinearMap

/-- **The class `α_M`** (Adiprasito, Huh and Katz, *Hodge theory for combinatorial geometries*,
Ann. of Math. 188 (2018), Definition 5.7). For an element `i` of the ground set, the class of
`α_{M,i} = ∑_{i ∈ F} x_F`, the sum over the nonempty proper flats containing `i`; by the linear
relations it does not depend on `i ∈ E`. -/
noncomputable def alphaClass (i : α) : ChowRing M :=
  Ideal.Quotient.mk (chowIdeal M) (∑ᶠ (F : ProperFlat M) (_ : i ∈ F.1), X F)

/-- **The class `β_M`** (Adiprasito, Huh and Katz, *Hodge theory for combinatorial geometries*,
Ann. of Math. 188 (2018), Definition 5.7). For an element `i` of the ground set, the class of
`β_{M,i} = ∑_{i ∉ F} x_F`, the sum over the nonempty proper flats not containing `i`; it does
not depend on `i ∈ E`. -/
noncomputable def betaClass (i : α) : ChowRing M :=
  Ideal.Quotient.mk (chowIdeal M) (∑ᶠ (F : ProperFlat M) (_ : i ∉ F.1), X F)

/-- **Strictly submodular function** (Adiprasito, Huh and Katz, *Hodge theory for combinatorial
geometries*, Ann. of Math. 188 (2018), Section 1.2). A real function `c` on the nonempty proper
subsets of `E` is strictly submodular if `c(I₁) + c(I₂) > c(I₁ ∩ I₂) + c(I₁ ∪ I₂)` for any two
incomparable subsets `I₁, I₂ ⊆ E`, where `c(∅)` and `c(E)` are replaced by zero. Here `c` is a
function on all sets with `c ∅ = 0` and `c E = 0`, and its values off the subsets of `E` are
irrelevant. -/
def IsStrictlySubmodular (c : Set α → ℝ) : Prop :=
  c ∅ = 0 ∧ c M.E = 0 ∧
    ∀ I₁ I₂ : Set α, I₁ ⊆ M.E → I₂ ⊆ M.E → ¬ I₁ ⊆ I₂ → ¬ I₂ ⊆ I₁ →
      c (I₁ ∩ I₂) + c (I₁ ∪ I₂) < c I₁ + c I₂

/-- **A strictly submodular function** (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Section 1.2). For a finite matroid `M` on
`E`, the function `I ↦ |I| |E \ I|` is strictly submodular; in particular strictly submodular
functions exist. -/
theorem isStrictlySubmodular_ncard_mul_ncard_diff [M.Finite] :
    IsStrictlySubmodular M (fun I => (I.ncard : ℝ) * ((M.E \ I).ncard : ℝ)) := by
  have hE := M.ground_finite
  refine ⟨by simp, by simp, ?_⟩
  intro I₁ I₂ h₁ h₂ h₁₂ h₂₁
  have f₁ : I₁.Finite := hE.subset h₁
  have f₂ : I₂.Finite := hE.subset h₂
  have hP : 0 < (I₁ \ I₂).ncard := by
    rw [Set.ncard_pos (f₁.sdiff)]
    exact Set.sdiff_nonempty.mpr h₁₂
  have hQ : 0 < (I₂ \ I₁).ncard := by
    rw [Set.ncard_pos (f₂.sdiff)]
    exact Set.sdiff_nonempty.mpr h₂₁
  have e₁ := Set.ncard_inter_add_ncard_sdiff_eq_ncard I₁ I₂ f₁
  have e₂ := Set.ncard_inter_add_ncard_sdiff_eq_ncard I₂ I₁ f₂
  have eu := Set.ncard_union_add_ncard_inter I₁ I₂ f₁ f₂
  rw [Set.inter_comm] at e₂
  have hU : I₁ ∪ I₂ ⊆ M.E := Set.union_subset h₁ h₂
  have hA : I₁ ∩ I₂ ⊆ M.E := Set.inter_subset_left.trans h₁
  have d₁ := Set.ncard_sdiff h₁ f₁
  have d₂ := Set.ncard_sdiff h₂ f₂
  have dU := Set.ncard_sdiff hU (f₁.union f₂)
  have dA := Set.ncard_sdiff hA (f₁.subset Set.inter_subset_left)
  have l₁ := Set.ncard_le_ncard h₁ hE
  have l₂ := Set.ncard_le_ncard h₂ hE
  have lU := Set.ncard_le_ncard hU hE
  have lA := Set.ncard_le_ncard hA hE
  simp only
  rw [d₁, d₂, dU, dA]
  push_cast [l₁, l₂, lU, lA]
  have ha : (I₁.ncard : ℝ) = ((I₁ ∩ I₂).ncard : ℝ) + ((I₁ \ I₂).ncard : ℝ) := by
    exact_mod_cast e₁.symm
  have hb : (I₂.ncard : ℝ) = ((I₁ ∩ I₂).ncard : ℝ) + ((I₂ \ I₁).ncard : ℝ) := by
    exact_mod_cast e₂.symm
  have hu : ((I₁ ∪ I₂).ncard : ℝ) + ((I₁ ∩ I₂).ncard : ℝ) = (I₁.ncard : ℝ) + I₂.ncard := by
    exact_mod_cast eu
  have hp : (1 : ℝ) ≤ ((I₁ \ I₂).ncard : ℝ) := by exact_mod_cast hP
  have hq : (1 : ℝ) ≤ ((I₂ \ I₁).ncard : ℝ) := by exact_mod_cast hQ
  have hy : ((I₁ ∪ I₂).ncard : ℝ) =
      ((I₁ ∩ I₂).ncard : ℝ) + ((I₁ \ I₂).ncard : ℝ) + ((I₂ \ I₁).ncard : ℝ) := by
    linarith
  rw [ha, hb, hy]
  nlinarith [mul_pos (by linarith : (0 : ℝ) < ((I₁ \ I₂).ncard : ℝ))
    (by linarith : (0 : ℝ) < ((I₂ \ I₁).ncard : ℝ))]

/-- **The class `ℓ(c)`** (Adiprasito, Huh and Katz, *Hodge theory for combinatorial geometries*,
Ann. of Math. 188 (2018), Section 1.2). For a function `c` on subsets of `E`, the class of
`∑_F c_F x_F` in `A¹(M)_ℝ`, the sum over all nonempty proper flats `F`. When `c` is strictly
submodular this is the Lefschetz class of AHK Theorem 1.4. -/
noncomputable def ellClass (c : Set α → ℝ) : ChowRing M :=
  Ideal.Quotient.mk (chowIdeal M) (∑ᶠ F : ProperFlat M, c F.1 • X F)

/-- **Degree map of a matroid of rank `r + 1`** (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Definition 5.9 and Proposition 5.10). A
linear map `deg : A*(M)_ℝ → ℝ` is a degree map for `r` if it vanishes on every graded piece
`A^q(M)_ℝ` with `q ≠ r` and satisfies `deg(x_{F₁} ⋯ x_{F_r}) = 1` for every flag
`F₁ ⊊ ⋯ ⊊ F_r` of nonempty proper flats. On `A^r(M)_ℝ` this is AHK's normalisation
`deg(x_𝓕) = 1` for the monomials of the `r`-dimensional cones of the Bergman fan. -/
def IsDegreeMap (r : ℕ) (deg : ChowRing M →ₗ[ℝ] ℝ) : Prop :=
  (∀ q, q ≠ r → ∀ a ∈ gradedPiece M q, deg a = 0) ∧
    ∀ F : Fin r → ProperFlat M, StrictMono (fun k => (F k).1) → deg (∏ k, x M (F k)) = 1

/-- The product `x_{F₁} x_{F₂}` of two incomparable nonempty proper flats vanishes in the Chow
ring (Adiprasito, Huh and Katz, *Hodge theory for combinatorial geometries*, Ann. of Math. 188
(2018), Definition 1.3, the ideal `I_M`). -/
theorem x_mul_x_eq_zero_of_incomparable {F G : ProperFlat M} (hFG : ¬ F.1 ⊆ G.1)
    (hGF : ¬ G.1 ⊆ F.1) : x M F * x M G = 0 := by
  unfold x
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mem_sup_left (Ideal.subset_span ⟨F, G, hFG, hGF, rfl⟩)

/-- The linear relations: for elements `i, j` of the ground set the classes
`∑_{i ∈ F} x_F` and `∑_{j ∈ F} x_F` agree, so `α_M` does not depend on the chosen element
(Adiprasito, Huh and Katz, *Hodge theory for combinatorial geometries*, Ann. of Math. 188 (2018),
Definition 1.3, the ideal `J_M`, and Definition 5.7). -/
theorem alphaClass_eq {i j : α} (hi : i ∈ M.E) (hj : j ∈ M.E) :
    alphaClass M i = alphaClass M j := by
  by_cases hij : i = j
  · rw [hij]
  unfold alphaClass
  rw [Ideal.Quotient.eq]
  exact Ideal.mem_sup_right (Ideal.subset_span ⟨i, hi, j, hj, hij, rfl⟩)

/-- For a finite matroid, `α_{M,i} + β_{M,i} = ∑_F x_F` for every element `i`: every nonempty
proper flat either contains `i` or does not (Adiprasito, Huh and Katz, *Hodge theory for
combinatorial geometries*, Ann. of Math. 188 (2018), Definition 5.7). -/
theorem alphaClass_add_betaClass [M.Finite] (i : α) :
    alphaClass M i + betaClass M i =
      Ideal.Quotient.mk (chowIdeal M) (∑ᶠ F : ProperFlat M, X F) := by
  classical
  unfold alphaClass betaClass
  rw [← map_add]
  congr 1
  simp only [finsum_eq_if]
  rw [← finsum_add_distrib (Set.toFinite _) (Set.toFinite _)]
  congr 1
  ext F
  by_cases h : i ∈ F.1 <;> simp [h]

/-- For a finite matroid the class `β_M` does not depend on the chosen element: `β_{M,i}` and
`β_{M,j}` agree for `i, j ∈ E` (Adiprasito, Huh and Katz, *Hodge theory for combinatorial
geometries*, Ann. of Math. 188 (2018), Definition 5.7). -/
theorem betaClass_eq [M.Finite] {i j : α} (hi : i ∈ M.E) (hj : j ∈ M.E) :
    betaClass M i = betaClass M j := by
  have hi' := alphaClass_add_betaClass M i
  have hj' := alphaClass_add_betaClass M j
  rw [alphaClass_eq M hi hj] at hi'
  exact add_left_cancel (hi'.trans hj'.symm)

/-- Each generator `x_F` lies in the degree-one piece `A¹(M)_ℝ`. -/
theorem x_mem_gradedPiece_one (F : ProperFlat M) : x M F ∈ gradedPiece M 1 :=
  ⟨X F, isHomogeneous_X ℝ F, rfl⟩

/-- The class `ℓ(c)` lies in the degree-one piece `A¹(M)_ℝ` (Adiprasito, Huh and Katz, *Hodge
theory for combinatorial geometries*, Ann. of Math. 188 (2018), Section 1.2). -/
theorem ellClass_mem_gradedPiece_one (c : Set α → ℝ) : ellClass M c ∈ gradedPiece M 1 := by
  classical
  refine ⟨∑ᶠ F : ProperFlat M, c F.1 • X F, ?_, rfl⟩
  by_cases h : (Function.support fun F : ProperFlat M => c F.1 • (X F : MvPolynomial _ ℝ)).Finite
  · rw [finsum_eq_sum _ h]
    exact Submodule.sum_mem _ fun F _ => Submodule.smul_mem _ _ (isHomogeneous_X ℝ F)
  · rw [finsum_of_infinite_support h]
    exact Submodule.zero_mem _

end MathlibExt.Combinatorics.Matroid.Chow
