/-!
# Localizations of standard smooth algebras of relative dimension one

The localization at a maximal ideal of a standard smooth algebra of relative
dimension `1` over a field is a discrete valuation ring. The key step is
that a Noetherian local ring whose maximal ideal is generated by a single
regular element is a domain.
-/

@[expose] public section

namespace IsLocalRing

/-- A Noetherian local ring whose maximal ideal is generated by a single
regular element is a domain. -/
theorem isDomain_of_maximalIdeal_eq_span {L : Type*} [CommRing L] [IsLocalRing L]
    [IsNoetherianRing L] {ϖ : L} (hreg : IsSMulRegular L ϖ)
    (hmax : maximalIdeal L = Ideal.span {ϖ}) : IsDomain L := by
  classical
  have hpow : ∀ n : ℕ, maximalIdeal L ^ n = Ideal.span {ϖ ^ n} := fun n => by
    rw [hmax, Ideal.span_singleton_pow]
  have key : ∀ x : L, x ≠ 0 → ∃ (n : ℕ) (w : L), IsUnit w ∧ x = w * ϖ ^ n := by
    intro x hx
    have hex : ∃ n : ℕ, x ∉ maximalIdeal L ^ n := by
      by_contra! h
      apply hx
      have hmem : x ∈ ⨅ n : ℕ, maximalIdeal L ^ n := Ideal.mem_iInf.mpr h
      rwa [Ideal.iInf_pow_eq_bot_of_isLocalRing _
        (IsLocalRing.maximalIdeal.isMaximal L).ne_top, Ideal.mem_bot] at hmem
    have hn0 : Nat.find hex ≠ 0 := by
      intro h0
      have := Nat.find_spec hex
      rw [h0, pow_zero, Ideal.one_eq_top] at this
      exact this trivial
    obtain ⟨j, hj⟩ : ∃ j, Nat.find hex = j + 1 := Nat.exists_eq_succ_of_ne_zero hn0
    have hxj : x ∈ maximalIdeal L ^ j := by
      have := Nat.find_min hex (m := j) (by omega)
      exact not_not.mp this
    have hxj1 : x ∉ maximalIdeal L ^ (j + 1) := hj ▸ Nat.find_spec hex
    rw [hpow] at hxj hxj1
    obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hxj
    refine ⟨j, w, ?_, rfl⟩
    by_contra hw
    apply hxj1
    have hw' : w ∈ maximalIdeal L := hw
    rw [hmax] at hw'
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hw'
    exact Ideal.mem_span_singleton'.mpr ⟨c, by ring⟩
  have : NoZeroDivisors L := ⟨fun {a b} hab => by
    by_contra h
    push Not at h
    obtain ⟨n, w, hw, rfl⟩ := key a h.1
    obtain ⟨m, w', hw', rfl⟩ := key b h.2
    have hreg' : IsSMulRegular L (ϖ ^ (n + m)) := hreg.pow (n + m)
    have h0 : ϖ ^ (n + m) • (w * w') = ϖ ^ (n + m) • (0 : L) := by
      rw [smul_eq_mul, smul_zero, ← hab]; ring
    exact (hw.mul hw').ne_zero (hreg' h0)⟩
  exact NoZeroDivisors.to_isDomain L

end IsLocalRing

namespace Algebra

namespace IsStandardSmoothOfRelativeDimension

/-- The localization at a maximal ideal of a standard smooth algebra of
relative dimension `1` over a field is a discrete valuation ring. -/
theorem isDiscreteValuationRing_localization_atPrime
    {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
    [Algebra.IsStandardSmoothOfRelativeDimension 1 k A]
    (p : Ideal A) [p.IsMaximal] :
    ∃ _ : IsDomain (Localization.AtPrime p), IsDiscreteValuationRing (Localization.AtPrime p) := by
  classical
  obtain ⟨g, hg⟩ :=
    Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial 1 (R := k) (S := A)
  let P := MvPolynomial (Fin 1) k
  have hFieldAp : Field (A ⧸ p) := Ideal.Quotient.field p
  let _ : Algebra P A := g.toRingHom.toAlgebra
  have : Algebra.Etale P A := hg
  have : IsScalarTower k P A := IsScalarTower.of_algebraMap_eq fun c => (g.commutes c).symm
  have hFinAp : Module.Finite k (A ⧸ p) := by
    have hFTkA : Algebra.FiniteType k A :=
      (inferInstance : Algebra.FiniteType k P).trans (inferInstance : Algebra.FiniteType P A)
    have hFT : Algebra.FiniteType k (A ⧸ p) := inferInstance
    obtain ⟨ι, hι, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial'.mp hFT
    have hInt : (algebraMap k (A ⧸ p)).IsIntegral := by
      rw [← f.comp_algebraMap]
      exact @MvPolynomial.comp_C_integral_of_surjective_of_isJacobsonRing
        k _ _ ι _ (A ⧸ p) (Ideal.Quotient.field p) f.toRingHom hf
    have hIsInt : Algebra.IsIntegral k (A ⧸ p) := Algebra.isIntegral_def.mpr hInt
    exact Algebra.IsIntegral.finite
  let e : P ≃ₐ[k] Polynomial k := MvPolynomial.uniqueAlgEquiv k (Fin 1)
  have : IsPrincipalIdealRing P :=
    IsPrincipalIdealRing.of_surjective (e.symm : Polynomial k →+* P) e.symm.surjective
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing P A
  let q : Ideal P := p.under P
  have hqprime : q.IsPrime := Ideal.comap_isPrime (algebraMap P A) p
  have hq0 : q ≠ ⊥ := by
    intro hq
    have hker : RingHom.ker (algebraMap P (A ⧸ p)) = ⊥ := by
      ext x
      rw [RingHom.mem_ker, Ideal.mem_bot]
      change (Ideal.Quotient.mk p) (algebraMap P A x) = 0 ↔ x = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, ← Ideal.under_def,
        show p.under P = ⊥ from hq, Ideal.mem_bot]
    have hinj : Function.Injective (algebraMap P (A ⧸ p)) :=
      (RingHom.injective_iff_ker_eq_bot _).mpr hker
    have hTower := IsScalarTower.of_algebraMap_eq (R := k) (S := P) (A := A ⧸ p) fun x => by
      change (Ideal.Quotient.mk p) (algebraMap k A x) =
        (Ideal.Quotient.mk p) (algebraMap P A (algebraMap k P x))
      rw [IsScalarTower.algebraMap_apply k P A]
    have hfinP : Module.Finite k P :=
      Module.Finite.of_injective (IsScalarTower.toAlgHom k P (A ⧸ p)).toLinearMap hinj
    have hfinPoly : Module.Finite k (Polynomial k) :=
      Module.Finite.of_injective e.symm.toLinearMap e.symm.injective
    have hfd : FiniteDimensional k (Polynomial k) := hfinPoly
    have hlt :=
      (Polynomial.basisMonomials (R := k)).linearIndependent.lt_aleph0_of_finiteDimensional
    rw [Cardinal.mk_nat] at hlt
    exact (lt_irrefl Cardinal.aleph0) hlt
  obtain ⟨π, hπ⟩ := (IsPrincipalIdealRing.principal q).principal
  have hπ0 : π ≠ 0 := by
    rintro rfl
    exact hq0 (by rw [hπ]; simp)
  set L := Localization.AtPrime p
  let _ := Localization.AtPrime.algebraOfLiesOver q p
  have hmap : q.map (algebraMap P L) = IsLocalRing.maximalIdeal L :=
    ((Algebra.isUnramifiedAt_iff_map_eq (R := P) (p := q) (q := p)).mp inferInstance).2
  have hmaxL : IsLocalRing.maximalIdeal L = Ideal.span {algebraMap P L π} := by
    rw [← hmap, hπ]
    rw [Ideal.map_span, Set.image_singleton]
  have : Module.Flat P L := Module.Flat.trans P A L
  have hreg : IsSMulRegular L (algebraMap P L π) := by
    have h : IsSMulRegular L π :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hπ0)
    intro a b hab
    apply h
    simpa [Algebra.smul_def] using hab
  have hne : IsLocalRing.maximalIdeal L ≠ ⊥ := by
    rw [hmaxL, ne_eq, Ideal.span_singleton_eq_bot]
    intro h0
    have : (algebraMap P L π) • (1 : L) = (algebraMap P L π) • (0 : L) := by simp [h0]
    exact one_ne_zero (hreg this)
  have hnf : ¬ IsField L := fun hF => hne ((IsLocalRing.isField_iff_maximalIdeal_eq).mp hF)
  have hdom : IsDomain L := IsLocalRing.isDomain_of_maximalIdeal_eq_span hreg hmaxL
  have hprinc : (IsLocalRing.maximalIdeal L).IsPrincipal := ⟨⟨algebraMap P L π, hmaxL⟩⟩
  exact ⟨hdom, ((IsDiscreteValuationRing.TFAE L hnf).out 5 1).mp hprinc⟩

end IsStandardSmoothOfRelativeDimension

end Algebra
