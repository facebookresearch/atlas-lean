-- Author: @toskua, Avocado
module

public import MathlibExt.Algebra.Homology.KoszulComplexFamily
public import MathlibExt.LinearAlgebra.ExteriorPower.ContractionWedge
public import MathlibExt.Algebra.Homology.FiniteHomology
public import MathlibExt.RingTheory.Length.AnnihilatorQuotient
public import Mathlib.Algebra.Homology.Homotopy
public import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
public import Mathlib.Algebra.Homology.ShortComplex.Linear
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Annihilation of Koszul homology

Left exterior multiplication by a vector is a chain homotopy between scalar
multiplication by its coefficient and zero on the Koszul complex.  It follows
that the range ideal of the coefficient functional annihilates every Koszul
homology module.

-/

@[expose] public section

set_option autoImplicit false
noncomputable section

open CategoryTheory

namespace KoszulComplex

universe u v

variable (R : Type u) [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

/-- Compatibility facade for left exterior multiplication by a fixed vector,
between consecutive exterior powers. -/
noncomputable abbrev wedgeLeft (m : M) (n : ℕ) :
    (⋀[R]^n M) →ₗ[R] (⋀[R]^(n + 1) M) :=
  exteriorPower.wedgeLeft R M m n

/-- Left exterior multiplication prepends the fixed vector to a decomposable
wedge. -/
theorem wedgeLeft_apply_ιMulti (m : M) (n : ℕ) (a : Fin n → M) :
    wedgeLeft R M m n (exteriorPower.ιMulti R n a) =
      exteriorPower.ιMulti R (n + 1) (Matrix.vecCons m a) :=
  exteriorPower.wedgeLeft_apply_ιMulti R M m n a

/-- Cartan's contraction identity for left exterior multiplication. -/
theorem differential_comp_wedgeLeft_add_wedgeLeft_comp_differential
    (x : M →ₗ[R] R) (m : M) (n : ℕ) :
    (differential R M x (n + 1)).comp (wedgeLeft R M m (n + 1)) +
        (wedgeLeft R M m n).comp (differential R M x n) =
      x m • LinearMap.id := by
  simpa only [differential_eq_contractLeft] using
    exteriorPower.contractLeft_comp_wedgeLeft_add_wedgeLeft_comp_contractLeft R M x m n

/-- Degree-zero endpoint of Cartan's contraction identity. -/
theorem differential_comp_wedgeLeft_zero
    (x : M →ₗ[R] R) (m : M) :
    (differential R M x 0).comp (wedgeLeft R M m 0) =
      x m • LinearMap.id := by
  simpa only [differential_eq_contractLeft] using
    exteriorPower.contractLeft_comp_wedgeLeft_zero R M x m

/-- The degree-raising maps used in the null-homotopy of scalar
multiplication on the Koszul complex. -/
noncomputable def wedgeLeftHomotopyComponent
    (x : M →ₗ[R] R) (m : M) (i j : ℕ)
    (hij : (ComplexShape.down ℕ).Rel j i) :
    (complex R M x).X i ⟶ (complex R M x).X j := by
  have hj : j = i + 1 := by
    simpa only [ComplexShape.down_Rel] using hij.symm
  subst j
  exact ModuleCat.ofHom (wedgeLeft R M m i)

/-- The null-homotopic chain map generated by left exterior multiplication
by `m`. -/
noncomputable def wedgeLeftNullHomotopicMap
    (x : M →ₗ[R] R) (m : M) :
    complex R M x ⟶ complex R M x :=
  Homotopy.nullHomotopicMap'
    (wedgeLeftHomotopyComponent R M x m)

/-- The chain map generated by the exterior-multiplication homotopy is scalar
multiplication by the coefficient `x m`. -/
theorem wedgeLeftNullHomotopicMap_eq_smul_id
    (x : M →ₗ[R] R) (m : M) :
    wedgeLeftNullHomotopicMap R M x m =
      x m • 𝟙 (complex R M x) := by
  apply HomologicalComplex.hom_ext
  intro i
  cases i with
  | zero =>
      rw [wedgeLeftNullHomotopicMap,
        Homotopy.nullHomotopicMap'_f_of_not_rel_left
          (r₁₀ := (show (ComplexShape.down ℕ).Rel 1 0 by rfl))
          (fun l h => by
            simp only [ComplexShape.down_Rel] at h
            omega)]
      change ModuleCat.ofHom
          ((differential R M x 0).comp (wedgeLeft R M m 0)) =
        ModuleCat.ofHom (x m • LinearMap.id)
      rw [differential_comp_wedgeLeft_zero]
      rfl
  | succ n =>
      rw [wedgeLeftNullHomotopicMap,
        Homotopy.nullHomotopicMap'_f
          (r₂₁ := (show (ComplexShape.down ℕ).Rel (n + 2) (n + 1) by rfl))
          (r₁₀ := (show (ComplexShape.down ℕ).Rel (n + 1) n by rfl))]
      dsimp [wedgeLeftHomotopyComponent]
      rw [complex_d_succ, complex_d_succ]
      apply ModuleCat.hom_ext
      change (wedgeLeft R M m n).comp (differential R M x n) +
          (differential R M x (n + 1)).comp
            (wedgeLeft R M m (n + 1)) =
        x m • LinearMap.id
      calc
        _ = (differential R M x (n + 1)).comp
              (wedgeLeft R M m (n + 1)) +
            (wedgeLeft R M m n).comp (differential R M x n) :=
          add_comm _ _
        _ = _ :=
          differential_comp_wedgeLeft_add_wedgeLeft_comp_differential
            R M x m n

/-- Explicit null-homotopy of scalar multiplication by a coefficient of the
Koszul functional. -/
noncomputable def smulIdHomotopyZero
    (x : M →ₗ[R] R) (m : M) :
    Homotopy (x m • 𝟙 (complex R M x)) 0 :=
  wedgeLeftNullHomotopicMap_eq_smul_id R M x m ▸
    Homotopy.nullHomotopy'
      (wedgeLeftHomotopyComponent R M x m)

private theorem homologyMap_smul_moduleCat
    {K L : ChainComplex (ModuleCat R) ℕ} (r : R) (f : K ⟶ L)
    (n : ℕ) :
    HomologicalComplex.homologyMap (r • f) n =
      r • HomologicalComplex.homologyMap f n := by
  have hmap :
      (HomologicalComplex.shortComplexFunctor
          (ModuleCat R) (ComplexShape.down ℕ) n).map (r • f) =
        r • (HomologicalComplex.shortComplexFunctor
          (ModuleCat R) (ComplexShape.down ℕ) n).map f := by
    ext <;> rfl
  dsimp only [HomologicalComplex.homologyMap]
  rw [hmap, ShortComplex.homologyMap_smul]

/-- Scalar multiplication by any coefficient value acts by zero on every
Koszul homology object. -/
theorem coefficient_smul_id_homology_eq_zero
    (x : M →ₗ[R] R) (m : M) (n : ℕ) :
    x m • 𝟙 ((complex R M x).homology n) = 0 := by
  have h := (smulIdHomotopyZero R M x m).homologyMap_eq n
  rw [homologyMap_smul_moduleCat,
    HomologicalComplex.homologyMap_id,
    HomologicalComplex.homologyMap_zero] at h
  exact h

/-- Every value of the coefficient functional annihilates every element of
Koszul homology. -/
theorem coefficient_smul_homology_eq_zero
    (x : M →ₗ[R] R) (m : M) (n : ℕ)
    (z : (complex R M x).homology n) :
    x m • z = 0 := by
  have h := coefficient_smul_id_homology_eq_zero R M x m n
  have hz := congrArg
    (fun f : (complex R M x).homology n ⟶
        (complex R M x).homology n => f z) h
  simpa using hz

/-- The range ideal of a Koszul functional is contained in the annihilator
of every Koszul homology module. -/
theorem ideal_le_homology_annihilator
    (x : M →ₗ[R] R) (n : ℕ) :
    ideal R M x ≤
      Module.annihilator R ((complex R M x).homology n) := by
  rintro r ⟨m, rfl⟩
  exact Module.mem_annihilator.mpr
    (coefficient_smul_homology_eq_zero R M x m n)

/-- The ideal spanned by a finite coefficient family annihilates every
homology module of its Koszul complex. -/
theorem familyIdeal_le_homology_annihilator
    {I : Type v} [Fintype I] (a : I → R) (n : ℕ) :
    Ideal.span (Set.range a) ≤
      Module.annihilator R ((familyComplex R a).homology n) := by
  rw [← familyIdeal_eq_span R a]
  exact ideal_le_homology_annihilator R (I → R)
    (familyFunctional R a) n

/-- Over a Noetherian ring, every homology module of a finite-family Koszul
complex has finite length as soon as the quotient by the family ideal does. -/
theorem familyHomology_length_ne_top_of_quotient
    [IsNoetherianRing R] {I : Type v} [Fintype I]
    (a : I → R) (n : ℕ)
    (hquot : Module.length R (R ⧸ Ideal.span (Set.range a)) ≠ ⊤) :
    Module.length R ((familyComplex R a).homology n) ≠ ⊤ := by
  have : Module.Finite R ((familyComplex R a).X n) :=
    familyComplex_finite R a n
  have : Module.Finite R ((familyComplex R a).homology n) :=
    HomologicalComplex.homology_finite_of_finite R
      (familyComplex R a) n
  exact Module.length_ne_top_of_finite_of_ideal_le_annihilator
    R ((familyComplex R a).homology n) (Ideal.span (Set.range a))
      (familyIdeal_le_homology_annihilator R a n) hquot

end KoszulComplex
