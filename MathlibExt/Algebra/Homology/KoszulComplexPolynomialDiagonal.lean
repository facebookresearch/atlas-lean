module

public import MathlibExt.Algebra.Homology.KoszulComplex.Finsupp
public import MathlibExt.RingTheory.MvPolynomial.EnvelopingDiagonalRegular
public import MathlibExt.Algebra.Homology.Hochschild.AdjacentBarEnveloping
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.Homology.QuasiIso

/-!
# The polynomial diagonal Koszul resolution

Let A = MvPolynomial σ k for a commutative ring k and an arbitrary variable type σ. In the
enveloping ring E = A ⊗[k] Aᵐᵒᵖ, the differences δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i) define the Koszul
complex on the free coordinate module σ →₀ E. Its terms are exterior powers, and its boundary
is signed deletion with coefficients δ_i.

Every term is projective, and the complex is exact in every positive degree. The ideal
generated by the differences is the kernel of multiplication E → A. Consequently the quotient
is A, with its regular enveloping action, and the multiplication augmentation gives a
projective resolution of the canonical lifted A-module. The coefficient ring may have zero
divisors, and σ need not be finite.

The degree-zero augmentation sends an exterior scalar z to ULift.up (μ(exteriorPower.zeroEquiv
E V z)). The coordinate comparisons below characterize this same map at its exterior-power and
chain-complex endpoints.

See Weibel, *An Introduction to Homological Algebra*, Chapters 4 and 9.
-/

@[expose] public section
noncomputable section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u v

namespace KoszulComplex

variable (k : Type u) [CommRing k] (σ : Type v)

local notation "A" => MvPolynomial σ k
local notation "E" => MvPolynomial.PolynomialEnveloping k σ
local notation "V" => (σ →₀ E)
local notation "δ" => MvPolynomial.diagonalDifference k σ
local notation "x" => finsuppFunctional E δ
local notation "I" => ideal E V x

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Define polynomialDiagonalComplex as finsuppComplex E
δ. Its degree-n object is ⋀[E]^n V, and its boundary contracts with the E-linear functional
sending the unit coordinate at i to δ_i. -/
abbrev polynomialDiagonalComplex : ChainComplex (ModuleCat.{max u v} E) ℕ :=
  finsuppComplex E δ

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). For every n : ℕ, (polynomialDiagonalComplex k σ).X n
= ModuleCat.of E (⋀[E]^n V). The complex lies in ModuleCat.{max u v} E for k : Type u and σ :
Type v. -/
theorem polynomialDiagonalComplex_X (n : ℕ) :
    (polynomialDiagonalComplex k σ).X n = ModuleCat.of E (⋀[E]^n V) := rfl

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). For n : ℕ and any f : Fin (n + 1) → σ, write e_i for
the unit coordinate at i. The boundary of e_(f 0) ∧ … ∧ e_(f n) is ∑ j : Fin (n + 1), ((−1 :
E)^j * δ_(f j)) • (⋀ q : Fin n, e_(f(j.succAbove q))). The remaining coordinates retain their
order. -/
theorem polynomialDiagonalDifferential_basis (n : ℕ) (f : Fin (n + 1) → σ) :
    ((polynomialDiagonalComplex k σ).d (n + 1) n).hom
        (exteriorPower.ιMulti E (n + 1) (fun j => Finsupp.single (f j) 1)) =
      ∑ j : Fin (n + 1), (((-1 : E) ^ j.val) * δ (f j)) •
        exteriorPower.ιMulti E n (fun q => Finsupp.single (f (j.succAbove q)) 1) := by
  change ((complex E V x).d (n + 1) n).hom _ = _
  rw [complex_d_succ]
  exact finsuppDifferential_apply_basis E δ n f

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). For each n : ℕ, the object
(polynomialDiagonalComplex k σ).X n is projective in ModuleCat.{max u v} E, since it is an
exterior power of the free coordinate module V. -/
theorem polynomialDiagonalComplex_projective (n : ℕ) :
    Projective ((polynomialDiagonalComplex k σ).X n) :=
  finsuppComplex_projective E δ n

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). For every n : ℕ, polynomialDiagonalComplex k σ is
exact at degree n + 1. Finite ordered subfamilies of distinct polynomial differences are
weakly regular, and finite exterior support gives boundaries for all positive-degree cycles. -/
theorem polynomialDiagonalComplex_exactAt (n : ℕ) :
    (polynomialDiagonalComplex k σ).ExactAt (n + 1) :=
  finsuppComplex_exactAt_of_finite_isWeaklyRegular E δ
    (fun f hf => MvPolynomial.diagonalDifference_isWeaklyRegular k σ f hf) n

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. Then I = RingHom.ker μ.toRingHom.
Equivalently, the ideal which is the range of the Koszul coefficient functional on V is
exactly the kernel of diagonal multiplication. -/
theorem polynomialDiagonalIdeal_eq_ker_multiplication :
    I = RingHom.ker (MvPolynomial.diagonalMultiplication k σ).toRingHom := by
  rw [finsuppIdeal_eq_span]
  exact MvPolynomial.diagonalDifferenceIdeal_eq_ker_multiplication k σ

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. There is a ring equivalence
polynomialDiagonalQuotientRingEquiv : E ⧸ I ≃+* A induced by μ, since I = ker μ and μ is
surjective. -/
def polynomialDiagonalQuotientRingEquiv : (E ⧸ I) ≃+* A :=
  (Ideal.quotientEquivAlgOfEq E (polynomialDiagonalIdeal_eq_ker_multiplication k
      σ)).toRingEquiv.trans
    ((MvPolynomial.diagonalMultiplication k σ).toRingHom.quotientKerEquivOfSurjective
      (MvPolynomial.diagonalMultiplication_surjective k σ))

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. For z : E,
polynomialDiagonalQuotientRingEquiv k σ (Ideal.Quotient.mk I z) = μ(z). -/
@[simp]
theorem polynomialDiagonalQuotientRingEquiv_mk (z : E) :
    polynomialDiagonalQuotientRingEquiv k σ (Ideal.Quotient.mk I z) =
      MvPolynomial.diagonalMultiplication k σ z := by
  change (MvPolynomial.diagonalMultiplication k σ).toRingHom.quotientKerEquivOfSurjective
    (MvPolynomial.diagonalMultiplication_surjective k σ)
      ((Ideal.quotientEquivAlgOfEq E (polynomialDiagonalIdeal_eq_ker_multiplication k σ))
        (Ideal.Quotient.mk I z)) = _
  simp only [Ideal.quotientEquivAlgOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  rfl

private theorem polynomialDiagonal_regular_action (z : E) (a : A) :
    ModuleCat.Algebra.Hochschild.AdjacentBar.regularEnvelopingAction k A z a =
      MvPolynomial.diagonalMultiplication k σ z * a := by
  induction z using TensorProduct.inductionOn with
  | tmul l r =>
      have ht := MvPolynomial.diagonalMultiplication_tmul k σ l r.unop
      rw [MulOpposite.op_unop] at ht
      rw [ModuleCat.Algebra.Hochschild.AdjacentBar.regularEnvelopingAction,
        AlgHom.mulLeftRight_apply, ht]
      ac_rfl
  | add z w hz hw =>
      simp only [map_add, LinearMap.add_apply, add_mul, hz, hw]

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). View the canonical lifted carrier ULift A as an
E-module by (l ⊗ op r) • a = l * a * r. The object polynomialDiagonalTarget k σ is this
regular E-module in ModuleCat.{max u v} E. -/
abbrev polynomialDiagonalTarget : ModuleCat.{max u v} E :=
  ModuleCat.Algebra.Hochschild.AdjacentBar.regularEnvelopingTarget k A

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The quotient ring equivalence lifts to
an E-linear equivalence E ⧸ I ≃ₗ[E] polynomialDiagonalTarget k σ by [z] ↦ ULift.up (μ(z)).
Scalar linearity uses the regular action μ(e) * a. -/
def polynomialDiagonalQuotientEquiv : (E ⧸ I) ≃ₗ[E] polynomialDiagonalTarget k σ where
  toFun q := ULift.up (polynomialDiagonalQuotientRingEquiv k σ q)
  invFun a := (polynomialDiagonalQuotientRingEquiv k σ).symm a.down
  left_inv q := (polynomialDiagonalQuotientRingEquiv k σ).symm_apply_apply q
  right_inv a := by
    apply ULift.ext
    exact (polynomialDiagonalQuotientRingEquiv k σ).apply_symm_apply a.down
  map_add' q r := by
    apply ULift.ext
    exact (polynomialDiagonalQuotientRingEquiv k σ).map_add q r
  map_smul' z q := by
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
    apply ULift.ext
    change polynomialDiagonalQuotientRingEquiv k σ (Ideal.Quotient.mk I (z * p)) =
      ModuleCat.Algebra.Hochschild.AdjacentBar.regularEnvelopingAction k A z
        (polynomialDiagonalQuotientRingEquiv k σ (Ideal.Quotient.mk I p))
    rw [polynomialDiagonalQuotientRingEquiv_mk, polynomialDiagonalQuotientRingEquiv_mk,
      map_mul, polynomialDiagonal_regular_action]

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The canonical up/down equivalence
followed by polynomialDiagonalQuotientEquiv gives an E-module isomorphism from ModuleCat.of E
(ULift.{max u v} (E ⧸ I)) to polynomialDiagonalTarget k σ. -/
def polynomialDiagonalQuotientTargetIso :
    ModuleCat.of E (ULift.{max u v} (E ⧸ I)) ≅ polynomialDiagonalTarget k σ :=
  ((ULift.moduleEquiv : ULift.{max u v} (E ⧸ I) ≃ₗ[E] E ⧸ I).trans
    (polynomialDiagonalQuotientEquiv k σ)).toModuleIso

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. For z : E,
polynomialDiagonalQuotientTargetIso.hom sends ULift.up (Ideal.Quotient.mk I z) to ULift.up
(μ(z)). -/
theorem polynomialDiagonalQuotientTargetIso_mk (z : E) :
    (polynomialDiagonalQuotientTargetIso k σ).hom.hom (ULift.up (Ideal.Quotient.mk I z)) =
      ULift.up (MvPolynomial.diagonalMultiplication k σ z) := by
  change ULift.up (polynomialDiagonalQuotientRingEquiv k σ (Ideal.Quotient.mk I z)) = _
  rw [polynomialDiagonalQuotientRingEquiv_mk]

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The chain map
polynomialDiagonalAugmentation goes from polynomialDiagonalComplex k σ to the complex
concentrated in degree zero at polynomialDiagonalTarget k σ. It is the Koszul quotient
augmentation followed by the quotient-to-polynomial target isomorphism. -/
def polynomialDiagonalAugmentation : polynomialDiagonalComplex k σ ⟶
    (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ) :=
  augmentation E V x ≫ (ChainComplex.single₀ (ModuleCat.{max u v} E)).map
    (polynomialDiagonalQuotientTargetIso k σ).hom

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The map
polynomialDiagonalAugmentationQuotientComponent : ModuleCat.of E (⋀[E]^0 V) ⟶
polynomialDiagonalTarget k σ is the degree-zero quotient augmentation followed by the lifted
quotient-target isomorphism, transported through the source and concentrated-target
degree-zero object equalities. -/
def polynomialDiagonalAugmentationQuotientComponent :
    ModuleCat.of E (⋀[E]^0 V) ⟶ polynomialDiagonalTarget k σ := by
  let Q : ModuleCat.{max u v} E := ModuleCat.of E (ULift.{max u v} (E ⧸ I))
  let F : polynomialDiagonalComplex k σ ⟶ (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q :=
    augmentation E V x
  let g : (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q ⟶
      (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ) :=
    (ChainComplex.single₀ (ModuleCat.{max u v} E)).map
      (polynomialDiagonalQuotientTargetIso k σ).hom
  exact (eqToIso (polynomialDiagonalComplex_X k σ 0)).inv ≫ (F.f 0 ≫ g.f 0) ≫
    (eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))).hom

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. Define the E-linear map
polynomialDiagonalAugmentationLinear : ⋀[E]^0 V →ₗ[E] polynomialDiagonalTarget k σ by z ↦
ULift.up (μ(exteriorPower.zeroEquiv E V z)). -/
def polynomialDiagonalAugmentationLinear : (⋀[E]^0 V) →ₗ[E] polynomialDiagonalTarget k σ where
  toFun z := ULift.up (MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V z))
  map_add' z z' := by
    apply ULift.ext
    change MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V (z + z')) = _
    rw [map_add, map_add]
    rfl
  map_smul' e z := by
    apply ULift.ext
    change MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V (e • z)) =
      ModuleCat.Algebra.Hochschild.AdjacentBar.regularEnvelopingAction k A e
        (MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V z))
    rw [map_smul, smul_eq_mul, map_mul, polynomialDiagonal_regular_action]

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. For z : ⋀[E]^0 V, write e₀(z) =
exteriorPower.zeroEquiv E V z : E. Then polynomialDiagonalAugmentationLinear k σ z = ULift.up
(μ(e₀(z))). -/
theorem polynomialDiagonalAugmentationLinear_apply (z : ⋀[E]^0 V) :
    polynomialDiagonalAugmentationLinear k σ z =
      ULift.up (MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V z)) := by
  rfl

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. Transporting the degree-zero component
of polynomialDiagonalAugmentation through the equalities K₀ = ModuleCat.of E (⋀[E]^0 V) and
single₀(target).X 0 = target defines polynomialDiagonalAugmentationZeroComponent from the
exterior degree-zero module to the regular polynomial target. -/
def polynomialDiagonalAugmentationZeroComponent :
    ModuleCat.of E (⋀[E]^0 V) ⟶ polynomialDiagonalTarget k σ :=
  (eqToIso (polynomialDiagonalComplex_X k σ 0)).inv ≫
    (polynomialDiagonalAugmentation k σ).f 0 ≫
      (eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))).hom

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The underlying E-linear map of
polynomialDiagonalAugmentationZeroComponent equals polynomialDiagonalAugmentationLinear,
namely z ↦ ULift.up (μ(exteriorPower.zeroEquiv E V z)). -/
theorem polynomialDiagonalAugmentationZeroComponent_eq :
    ((polynomialDiagonalAugmentationZeroComponent k σ).hom :
      (⋀[E]^0 V) →ₗ[E] polynomialDiagonalTarget k σ) =
      polynomialDiagonalAugmentationLinear k σ := by
  let Q : ModuleCat.{max u v} E := ModuleCat.of E (ULift.{max u v} (E ⧸ I))
  let g : (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q ⟶
      (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ) :=
    (ChainComplex.single₀ (ModuleCat.{max u v} E)).map
      (polynomialDiagonalQuotientTargetIso k σ).hom
  let F : polynomialDiagonalComplex k σ ⟶ (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q :=
    augmentation E V x
  have h1 := HomologicalComplex.comp_f
    (C₁ := polynomialDiagonalComplex k σ)
    (C₂ := (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q)
    (C₃ := (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ))
    F g 0
  have hsource : (eqToIso (polynomialDiagonalComplex_X k σ 0)).inv =
      𝟙 (ModuleCat.of E (⋀[E]^0 V)) :=
    eqToHom_refl _ (polynomialDiagonalComplex_X k σ 0).symm
  have htarget : (eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))).hom =
      𝟙 (polynomialDiagonalTarget k σ) :=
    eqToHom_refl _ (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))
  have hcomponent : polynomialDiagonalAugmentationZeroComponent k σ =
      F.f 0 ≫ (polynomialDiagonalQuotientTargetIso k σ).hom := by
    change (eqToIso (polynomialDiagonalComplex_X k σ 0)).inv ≫
      (F ≫ g).f 0 ≫
        (eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))).hom = _
    rw [h1, hsource, htarget]
    exact (Category.id_comp ((F.f 0 ≫ g.f 0) ≫ 𝟙 (polynomialDiagonalTarget k σ))).trans
      ((Category.comp_id (F.f 0 ≫ g.f 0)).trans
        (congrArg (fun h => F.f 0 ≫ h)
          (ChainComplex.single₀_map_f_zero (polynomialDiagonalQuotientTargetIso k σ).hom)))
  apply LinearMap.ext
  intro z
  have hvalue := (augmentation_f_zero_apply E V x z).trans
    ((augmentationLinearLifted_apply E V x z).trans
      (congrArg ULift.up (augmentationLinear_apply E V x z)))
  have hpoint := ConcreteCategory.congr_hom hcomponent z
  have hcomputed := hpoint.trans
    ((ModuleCat.comp_apply (F.f 0) (polynomialDiagonalQuotientTargetIso k σ).hom z).trans
      ((congrArg (polynomialDiagonalQuotientTargetIso k σ).hom.hom hvalue).trans
        (polynomialDiagonalQuotientTargetIso_mk k σ (exteriorPower.zeroEquiv E V z))))
  exact hcomputed.trans (polynomialDiagonalAugmentationLinear_apply k σ z).symm

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. For z : ⋀[E]^0 V, write e₀(z) =
exteriorPower.zeroEquiv E V z : E. The value of
polynomialDiagonalAugmentationZeroComponent.hom on z is ULift.up (μ(e₀(z))). -/
theorem polynomialDiagonalAugmentationZeroComponent_apply (z : ⋀[E]^0 V) :
    (polynomialDiagonalAugmentationZeroComponent k σ).hom z =
      ULift.up (MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V z)) := by
  rw [polynomialDiagonalAugmentationZeroComponent_eq]
  exact polynomialDiagonalAugmentationLinear_apply k σ z

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. For z : ⋀[E]^0 V, write e₀(z) =
exteriorPower.zeroEquiv E V z : E. The value of
polynomialDiagonalAugmentationQuotientComponent.hom on z is ULift.up (μ(e₀(z))). -/
theorem polynomialDiagonalAugmentationQuotientComponent_apply (z : ⋀[E]^0 V) :
    (polynomialDiagonalAugmentationQuotientComponent k σ).hom z =
      ULift.up (MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V z)) := by
  let Q : ModuleCat.{max u v} E := ModuleCat.of E (ULift.{max u v} (E ⧸ I))
  let F : polynomialDiagonalComplex k σ ⟶ (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q :=
    augmentation E V x
  let g : (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q ⟶
      (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ) :=
    (ChainComplex.single₀ (ModuleCat.{max u v} E)).map
      (polynomialDiagonalQuotientTargetIso k σ).hom
  have hcomp := HomologicalComplex.comp_f
    (C₁ := polynomialDiagonalComplex k σ)
    (C₂ := (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj Q)
    (C₃ := (ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ))
    F g 0
  have hraw : polynomialDiagonalAugmentationZeroComponent k σ =
      polynomialDiagonalAugmentationQuotientComponent k σ :=
    congrArg (fun h : (polynomialDiagonalComplex k σ).X 0 ⟶
      ((ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ)).X 0 =>
        (eqToIso (polynomialDiagonalComplex_X k σ 0)).inv ≫ h ≫
          (eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))).hom) hcomp
  have hlinear := congrArg (fun f : ModuleCat.of E (⋀[E]^0 V) ⟶
    polynomialDiagonalTarget k σ => f.hom) hraw
  exact (LinearMap.congr_fun hlinear z).symm.trans
    (polynomialDiagonalAugmentationZeroComponent_apply k σ z)

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The map
polynomialDiagonalAugmentationNativeComponent goes from polynomialDiagonalComplex.X 0 to
single₀(polynomialDiagonalTarget).X 0. It is obtained by transporting
polynomialDiagonalAugmentationQuotientComponent back from its exterior-power source and target
coordinates to these complex objects. -/
def polynomialDiagonalAugmentationNativeComponent :
    (polynomialDiagonalComplex k σ).X 0 ⟶
      ((ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ)).X 0 :=
  (eqToIso (polynomialDiagonalComplex_X k σ 0)).hom ≫
    polynomialDiagonalAugmentationQuotientComponent k σ ≫
      (eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))).inv

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The degree-zero component of
polynomialDiagonalAugmentation equals polynomialDiagonalAugmentationNativeComponent, the
quotient augmentation followed by target identification and transported to the chain-complex
endpoints. -/
theorem polynomialDiagonalAugmentation_f_zero :
    (polynomialDiagonalAugmentation k σ).f 0 =
      polynomialDiagonalAugmentationNativeComponent k σ := by
  let S := eqToIso (polynomialDiagonalComplex_X k σ 0)
  let T := eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))
  have hraw : S.inv ≫ (polynomialDiagonalAugmentation k σ).f 0 ≫ T.hom =
      polynomialDiagonalAugmentationQuotientComponent k σ := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    exact (polynomialDiagonalAugmentationZeroComponent_apply k σ z).trans
      (polynomialDiagonalAugmentationQuotientComponent_apply k σ z).symm
  apply (cancel_epi S.inv).1
  apply (cancel_mono T.hom).1
  change (S.inv ≫ (polynomialDiagonalAugmentation k σ).f 0) ≫ T.hom =
    (S.inv ≫ (S.hom ≫ polynomialDiagonalAugmentationQuotientComponent k σ ≫ T.inv)) ≫ T.hom
  have hright :
      (S.inv ≫ (S.hom ≫ polynomialDiagonalAugmentationQuotientComponent k σ ≫ T.inv)) ≫ T.hom =
        polynomialDiagonalAugmentationQuotientComponent k σ := by
    simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
  exact (Category.assoc S.inv ((polynomialDiagonalAugmentation k σ).f 0) T.hom).trans
    (hraw.trans hright.symm)

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. For z : ⋀[E]^0 V, write e₀(z) =
exteriorPower.zeroEquiv E V z : E. In the canonical degree-zero exterior coordinates,
(polynomialDiagonalAugmentation k σ).f 0 sends z to ULift.up (μ(e₀(z))). -/
theorem polynomialDiagonalAugmentation_apply (z : ⋀[E]^0 V) :
    ((polynomialDiagonalAugmentation k σ).f 0).hom z =
      ULift.up (MvPolynomial.diagonalMultiplication k σ (exteriorPower.zeroEquiv E V z)) := by
  let S := eqToIso (polynomialDiagonalComplex_X k σ 0)
  let T := eqToIso (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))
  let g : (polynomialDiagonalComplex k σ).X 0 ⟶
      ((ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ)).X 0 :=
    (polynomialDiagonalAugmentation k σ).f 0
  have hs : S.inv = 𝟙 (ModuleCat.of E (⋀[E]^0 V)) :=
    eqToHom_refl _ (polynomialDiagonalComplex_X k σ 0).symm
  have ht : T.hom = 𝟙 (polynomialDiagonalTarget k σ) :=
    eqToHom_refl _ (ChainComplex.single₀_obj_zero (polynomialDiagonalTarget k σ))
  have hsvalue : S.inv.hom z = z :=
    (LinearMap.congr_fun
      (congrArg (fun f : ModuleCat.of E (⋀[E]^0 V) ⟶ (polynomialDiagonalComplex k σ).X 0 => f.hom)
        hs) z).trans (LinearMap.id_apply z)
  have htvalue : T.hom.hom (g.hom z) = g.hom z :=
    (LinearMap.congr_fun
      (congrArg (fun f :
        ((ChainComplex.single₀ (ModuleCat.{max u v} E)).obj (polynomialDiagonalTarget k σ)).X 0 ⟶
          polynomialDiagonalTarget k σ => f.hom) ht) (g.hom z)).trans
        (LinearMap.id_apply (g.hom z))
  have hcoordinate := (ModuleCat.comp_apply S.inv (g ≫ T.hom) z).trans
    ((congrArg (g ≫ T.hom).hom hsvalue).trans
      ((ModuleCat.comp_apply g T.hom z).trans htvalue))
  exact hcoordinate.symm.trans (polynomialDiagonalAugmentationZeroComponent_apply k σ z)

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The augmentation from the exterior
Koszul complex on the δ_i to single₀(polynomialDiagonalTarget k σ) is a quasi-isomorphism. Its
degree-zero homology map identifies the quotient by I with the regular polynomial target, and
its positive homology vanishes. -/
instance polynomialDiagonalAugmentation_quasiIso : QuasiIso (polynomialDiagonalAugmentation k σ) :=
    by
  letI : QuasiIso (augmentation E V x) :=
    finsuppAugmentation_quasiIso_of_finite_isWeaklyRegular E δ
      (fun f hf => MvPolynomial.diagonalDifference_isWeaklyRegular k σ f hf)
  unfold polynomialDiagonalAugmentation
  infer_instance

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The projective exterior terms and
multiplication augmentation define a ProjectiveResolution of polynomialDiagonalTarget k σ over
E. The underlying chain complex is polynomialDiagonalComplex k σ and its augmentation is
polynomialDiagonalAugmentation k σ. -/
def polynomialDiagonalProjectiveResolution : ProjectiveResolution (polynomialDiagonalTarget k σ)
    where
  complex := polynomialDiagonalComplex k σ
  projective := polynomialDiagonalComplex_projective k σ
  π := polynomialDiagonalAugmentation k σ
  quasiIso := polynomialDiagonalAugmentation_quasiIso k σ

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). The underlying complex of
polynomialDiagonalProjectiveResolution k σ equals polynomialDiagonalComplex k σ, with degree-n
term ⋀[E]^n V and signed deletion coefficients δ_i. -/
@[simp]
theorem polynomialDiagonalProjectiveResolution_complex :
    (polynomialDiagonalProjectiveResolution k σ).complex = polynomialDiagonalComplex k σ := rfl

/-- Let k be a commutative ring and σ any index type. Put A = MvPolynomial σ k, E = A ⊗[k] Aᵐᵒᵖ, V
= σ →₀ E and δ_i = X_i ⊗ 1 − 1 ⊗ op(X_i). Let I be the ideal generated by the δ_i and μ : E
→ₐ[k] A the multiplication map, with μ(l ⊗ op r) = l * r. View the canonical lifted carrier
ULift A as an E-module by (l ⊗ op r) • a = l * a * r. The augmentation π of
polynomialDiagonalProjectiveResolution k σ is polynomialDiagonalAugmentation k σ. In degree
zero it sends z to ULift.up (μ(exteriorPower.zeroEquiv E V z)), and its positive-degree target
components are zero. -/
@[simp]
theorem polynomialDiagonalProjectiveResolution_π :
    (polynomialDiagonalProjectiveResolution k σ).π = polynomialDiagonalAugmentation k σ := rfl

end KoszulComplex
