/-!
# The normalized coefficient Hochschild complex

The degeneracy quotient has tensor coordinates
M ⊗[k] TensorPower(k, n, A/(k·1)). Here A/(k·1) is a ground
module; its factors carry neither an algebra structure nor an
A-module structure. The full Hochschild boundary descends to these
coordinates, and the normalization projection is a quasi-isomorphism
for arbitrary coefficients and independent universes.
-/

@[expose] public section
noncomputable section

open CategoryTheory Category Limits Opposite AlgebraicTopology
open scoped TensorProduct Simplicial BigOperators

universe u v w z t s

namespace ModuleCat.Algebra.Hochschild

attribute [local instance] uliftSMulCommClass

section GroundLevels

variable (k : Type u) (A : Type v) [CommRing k] [AddCommGroup A] [Module k A] [One A]

/-- The ground submodule generated by the original distinguished element 1. -/
def unitSubmodule : Submodule k A := Submodule.span k ({1} : Set A)

/-- The original element 1 belongs to its ground span. -/
theorem one_mem_unitSubmodule : (1 : A) ∈ unitSubmodule k A :=
  Submodule.subset_span (by simp)

/-- The literal ground-module quotient A/(k·1). -/
abbrev quotientCarrier := A ⧸ unitSubmodule k A

variable (M : Type w) [AddCommGroup M] [Module k M]

/-- The normalized coefficient tensor level, retaining the original coefficient module. -/
abbrev normalizedChainLevel (n : ℕ) : ModuleCat.{max u v w} k :=
  ModuleCat.of k (M ⊗[k] TensorPower k n (quotientCarrier k A))

/-- The original factorwise quotient map, with identity on the coefficient. -/
def normalizationLevelMap (n : ℕ) :
    ModuleCat.of k (M ⊗[k] TensorPower k n A) ⟶ normalizedChainLevel k A M n :=
  ModuleCat.ofHom (TensorPower.coefficientQuotientMap (unitSubmodule k A) M n)

/-- The pure representative maps to its original quotient classes. -/
@[simp]
theorem normalizationLevelMap_tmul_tprod (n : ℕ) (m : M) (a : Fin n → A) :
    (normalizationLevelMap k A M n).hom (m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i)) :=
  TensorPower.coefficientQuotientMap_tmul_tprod _ _ _ _ _

/-- The factorwise projection is epic for arbitrary coefficients. -/
instance normalizationLevelMap_epi (n : ℕ) : Epi (normalizationLevelMap k A M n) :=
  (ModuleCat.epi_iff_surjective _).2
    (TensorPower.coefficientQuotientMap_surjective (unitSubmodule k A) M n)

/-- Its true kernel is the ground span of the original tensors with a unit-span factor. -/
theorem normalizationLevelMap_ker (n : ℕ) :
    LinearMap.ker (normalizationLevelMap k A M n).hom =
      TensorPower.coefficientQuotientRelations (unitSubmodule k A) M n :=
  TensorPower.coefficientQuotientMap_ker _ _ _

/-- A tensor with an unit in a tail factor is killed by the normalized projection. -/
theorem normalizationLevelMap_unit_factor (n : ℕ) (m : M) (a : Fin n → A)
    (i : Fin n) (hi : a i = 1) :
    (normalizationLevelMap k A M n).hom (m ⊗ₜ[k] PiTensorProduct.tprod k a) = 0 := by
  have h : m ⊗ₜ[k] PiTensorProduct.tprod k a ∈
      TensorPower.coefficientQuotientRelations (unitSubmodule k A) M n :=
    Submodule.subset_span ⟨m, a, ⟨i, by rw [hi]; exact one_mem_unitSubmodule k A⟩, rfl⟩
  rw [← normalizationLevelMap_ker] at h
  exact h

variable {k A M} {B : Type z} [AddCommGroup B] [Module k B] [One B]
  {N : Type t} [AddCommGroup N] [Module k N]

/-- A ground-linear map preserving the distinguished element preserves its ground span. -/
theorem unitSubmodule_le_comap (g : A →ₗ[k] B) (hOne : g 1 = 1) :
    unitSubmodule k A ≤ (unitSubmodule k B).comap g := by
  apply Submodule.span_le.mpr
  rintro a (ha : a ∈ ({1} : Set A))
  obtain rfl := Set.mem_singleton_iff.mp ha
  change g 1 ∈ unitSubmodule k B
  rw [hOne]
  exact one_mem_unitSubmodule k B

/-- The factor-quotient map of normalized levels, with independent raw universes. -/
def normalizedLevelLinearMap (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ) :
    M ⊗[k] TensorPower k n (quotientCarrier k A) →ₗ[k]
      N ⊗[k] TensorPower k n (quotientCarrier k B) :=
  TensorProduct.map f (PiTensorProduct.map (fun _ : Fin n =>
    (unitSubmodule k A).mapQ (unitSubmodule k B) g (unitSubmodule_le_comap g hOne)))

/-- The normalized tensor map retains the original coefficient and quotient values. -/
theorem normalizedLevelLinearMap_tmul_tprod (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ) (m : M) (a : Fin n → A) :
    normalizedLevelLinearMap g f hOne n
        (m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i))) =
      f m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k B).mkQ (g (a i))) := by
  have hmap (x : A) :
      (unitSubmodule k A).mapQ (unitSubmodule k B) g (unitSubmodule_le_comap g hOne)
        ((unitSubmodule k A).mkQ x) = (unitSubmodule k B).mkQ (g x) :=
    DFunLike.congr_fun (Submodule.mapQ_mkQ (unitSubmodule k A) (unitSubmodule k B) g
      (h := unitSubmodule_le_comap g hOne)) x
  simp only [normalizedLevelLinearMap, TensorProduct.map_tmul,
    PiTensorProduct.map_tprod, hmap]

/-- The full factorwise quotient square for arbitrary ground maps preserving 1. -/
theorem normalizationLevelMap_naturality (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ) :
    (normalizedLevelLinearMap g f hOne n).comp (normalizationLevelMap k A M n).hom =
      (normalizationLevelMap k B N n).hom.comp
        (TensorProduct.map f (PiTensorProduct.map (fun _ : Fin n => g))) :=
  TensorPower.coefficientQuotientMap_naturality f g (unitSubmodule_le_comap g hOne) n

end GroundLevels

section IndependentGroundLevels

variable {k : Type u} [CommRing k]
  {A : Type v} [AddCommGroup A] [Module k A] [One A]
  {B : Type z} [AddCommGroup B] [Module k B] [One B]
  {M : Type w} [AddCommGroup M] [Module k M]
  {N : Type t} [AddCommGroup N] [Module k N]

/-- The quotient-level map in a common lifted category, with independent coefficients. -/
def normalizedLevelMapLift (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ) :
    (ModuleCat.uliftFunctor.{max z t, max u v w} k).obj
        (normalizedChainLevel k A M n) ⟶
      (ModuleCat.uliftFunctor.{max v w, max u z t} k).obj
        (normalizedChainLevel k B N n) :=
  ModuleCat.ofHom (ULift.moduleEquiv.symm.toLinearMap.comp
    ((normalizedLevelLinearMap g f hOne n).comp ULift.moduleEquiv.toLinearMap))

/-- Lifting retains the original coefficient map and the original ground quotient map. -/
@[simp]
theorem normalizedLevelMapLift_apply (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ)
    (x : (ModuleCat.uliftFunctor.{max z t, max u v w} k).obj
      (normalizedChainLevel k A M n)) :
    (normalizedLevelMapLift g f hOne n).hom x =
      ULift.up (normalizedLevelLinearMap g f hOne n x.down) := rfl

/-- Every lifted pure representative has the mapped coefficient and quotient factors. -/
theorem normalizedLevelMapLift_tmul_tprod (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ) (m : M) (a : Fin n → A) :
    (normalizedLevelMapLift g f hOne n).hom
        (ULift.up (m ⊗ₜ[k] PiTensorProduct.tprod k
          (fun i => (unitSubmodule k A).mkQ (a i)))) =
      ULift.up (f m ⊗ₜ[k] PiTensorProduct.tprod k
        (fun i => (unitSubmodule k B).mkQ (g (a i)))) := by
  change (ULift.up (normalizedLevelLinearMap g f hOne n
      (m ⊗ₜ[k] PiTensorProduct.tprod k
        (fun i => (unitSubmodule k A).mkQ (a i)))) :
      ULift.{max v w} (N ⊗[k] TensorPower k n (quotientCarrier k B))) =
    ULift.up (f m ⊗ₜ[k] PiTensorProduct.tprod k
      (fun i => (unitSubmodule k B).mkQ (g (a i))))
  exact congrArg ULift.up (normalizedLevelLinearMap_tmul_tprod g f hOne n m a)

/-- The lifted map is from the full original quotient square, without a support condition. -/
theorem normalizedLevelMapLift_quotient (g : A →ₗ[k] B) (f : M →ₗ[k] N)
    (hOne : g 1 = 1) (n : ℕ) (x : M ⊗[k] TensorPower k n A) :
    (normalizedLevelMapLift g f hOne n).hom
        (ULift.up ((normalizationLevelMap k A M n).hom x)) =
      ULift.up ((normalizationLevelMap k B N n).hom
        (TensorProduct.map f (PiTensorProduct.map (fun _ : Fin n => g)) x)) := by
  change ULift.up (normalizedLevelLinearMap g f hOne n
      ((normalizationLevelMap k A M n).hom x)) = _
  exact congrArg ULift.up
    (DFunLike.congr_fun (normalizationLevelMap_naturality g f hOne n) x)

end IndependentGroundLevels

section CoefficientLiftLevels

variable (k : Type u) (A : Type v) (M : Type w)
  [CommRing k] [AddCommGroup A] [Module k A] [One A]
  [AddCommGroup M] [Module k M]

/-- Coefficient-only lifting agrees with the native lift of the whole normalized ground tensor. -/
def normalizedCoefficientLiftEquiv (n : ℕ) :
    ULift.{z} M ⊗[k] TensorPower k n (quotientCarrier k A) ≃ₗ[k]
      ULift.{z} (M ⊗[k] TensorPower k n (quotientCarrier k A)) :=
  (TensorProduct.congr (ULift.moduleEquiv : ULift.{z} M ≃ₗ[k] M)
    (LinearEquiv.refl k (TensorPower k n (quotientCarrier k A)))).trans
      (ULift.moduleEquiv : ULift.{z} (M ⊗[k] TensorPower k n (quotientCarrier k A))
        ≃ₗ[k] M ⊗[k] TensorPower k n (quotientCarrier k A)).symm

/-- The lift comparison retains every coefficient and quotient factor. -/
@[simp]
theorem normalizedCoefficientLiftEquiv_tprod (n : ℕ) (m : ULift.{z} M)
    (a : Fin n → quotientCarrier k A) :
    normalizedCoefficientLiftEquiv k A M n (m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      ULift.up (m.down ⊗ₜ[k] PiTensorProduct.tprod k a) := by
  simp only [normalizedCoefficientLiftEquiv, LinearEquiv.trans_apply, TensorProduct.congr_tmul]
  rfl

/-- The inverse whole-level lift restores the original lifted coefficient tensor. -/
@[simp]
theorem normalizedCoefficientLiftEquiv_symm_up_tprod (n : ℕ) (m : M)
    (a : Fin n → quotientCarrier k A) :
    (normalizedCoefficientLiftEquiv k A M n).symm
        (ULift.up (m ⊗ₜ[k] PiTensorProduct.tprod k a)) =
      ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k a := by
  apply (normalizedCoefficientLiftEquiv k A M n).injective
  rw [LinearEquiv.apply_symm_apply, normalizedCoefficientLiftEquiv_tprod]

end CoefficientLiftLevels

section CoefficientBar

variable (k : Type u) (A : Type v) (M : Type w)
  [CommRing k] [Ring A] [Algebra k A] [AddCommGroup M]
  [Module A M] [Module Aᵐᵒᵖ M] [Module k M]
  [SMulCommClass A Aᵐᵒᵖ M] [SMulCommClass k A M]
  [SMulCommClass k Aᵐᵒᵖ M] [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]

/-- The degeneracy quotient of the coefficient bar. -/
def nativeNormalizedComplex : ChainComplex (ModuleCat.{max u v w} k) ℕ :=
  NormalizedQuotient.obj (coefficientBar k A M)

/-- The original raw complex projects through its native bar coordinates. -/
def nativeNormalizationProjection : chainComplex k A M ⟶ nativeNormalizedComplex k A M :=
  (chainComplexIso k A M).hom ≫ NormalizedQuotient.projection (coefficientBar k A M)

/-- Actual degree components retain the coefficient-bar coordinates. -/
@[simp]
theorem nativeNormalizationProjection_f (n : ℕ) :
    (nativeNormalizationProjection k A M).f n =
      (coefficientBarObjIso k A M n).inv ≫
        (NormalizedQuotient.projection (coefficientBar k A M)).f n := by
  rfl

/-- The original raw projection is epic in each degree. -/
instance nativeNormalizationProjection_f_epi (n : ℕ) :
    Epi ((nativeNormalizationProjection k A M).f n) := by
  exact (epi_comp_iff_of_epi (coefficientBarObjIso k A M n).inv
    ((NormalizedQuotient.projection (coefficientBar k A M)).f n)).2
      (NormalizedQuotient.projection_f_epi (coefficientBar k A M) n)

/-- Actual unit degeneracy coordinates are the native simplicial coordinates. -/
@[reassoc]
theorem coefficientBarObjIso_hom_degeneracy (n : ℕ) (i : Fin (n + 1)) :
    (coefficientBarObjIso k A M n).hom ≫ degeneracy k A M n i =
      (coefficientBar k A M).σ i ≫ (coefficientBarObjIso k A M (n + 1)).hom := by
  rw [degeneracy]
  simp only [Iso.hom_inv_id_assoc]

/-- The simplicial degeneracy is killed by the original raw quotient projection. -/
@[reassoc]
theorem degeneracy_nativeNormalizationProjection (n : ℕ) (i : Fin (n + 1)) :
    degeneracy k A M n i ≫ (nativeNormalizationProjection k A M).f (n + 1) = 0 := by
  change
    ((coefficientBarObjIso k A M n).inv ≫ (coefficientBar k A M).σ i ≫
      (coefficientBarObjIso k A M (n + 1)).hom) ≫
      ((coefficientBarObjIso k A M (n + 1)).inv ≫
        (NormalizedQuotient.projection (coefficientBar k A M)).f (n + 1)) = 0
  simp only [Category.assoc, Iso.hom_inv_id_assoc,
    NormalizedQuotient.degeneracy_comp_projection, Limits.comp_zero]

/-- A tail unit in a raw tensor lies in the native degeneracy kernel. -/
theorem nativeNormalizationProjection_unit_factor (n : ℕ) (m : M)
    (a : Fin (n + 1) → A) (i : Fin (n + 1)) (hi : a i = 1) :
    ((nativeNormalizationProjection k A M).f (n + 1)).hom
      (m ⊗ₜ[k] PiTensorProduct.tprod k a) = 0 := by
  let b : Fin n → A := Fin.removeNth i a
  have ha : hochschildInsertOne i b = a := by
    dsimp only [hochschildInsertOne, b]
    rw [Fin.insertNth_removeNth]
    funext j
    by_cases hj : j = i
    · subst j
      simp [hi]
    · simp [hj]
  have hvalue := degeneracy_tprod k A M n i m b
  rw [ha] at hvalue
  have hzero : (degeneracy k A M n i ≫
      (nativeNormalizationProjection k A M).f (n + 1)).hom
        (m ⊗ₜ[k] PiTensorProduct.tprod k b) = 0 := by
    rw [degeneracy_nativeNormalizationProjection, ModuleCat.hom_zero, LinearMap.zero_apply]
  change ((nativeNormalizationProjection k A M).f (n + 1)).hom
    ((degeneracy k A M n i).hom (m ⊗ₜ[k] PiTensorProduct.tprod k b)) = 0 at hzero
  rw [hvalue] at hzero
  exact hzero

/-- The full ground unit-span relation is killed by the projection. -/
theorem nativeNormalizationProjection_relation (n : ℕ) (m : M) (a : Fin n → A)
    (i : Fin n) (hi : a i ∈ unitSubmodule k A) :
    ((nativeNormalizationProjection k A M).f n).hom
      (m ⊗ₜ[k] PiTensorProduct.tprod k a) = 0 := by
  cases n with
  | zero => exact Fin.elim0 i
  | succ n =>
      let p : (M ⊗[k] TensorPower k (n + 1) A) →ₗ[k]
          (nativeNormalizedComplex k A M).X (n + 1) :=
        ((nativeNormalizationProjection k A M).f (n + 1)).hom
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hi
      let b : Fin (n + 1) → A := Function.update a i 1
      have ha : Function.update a i (c • (1 : A)) = a := by
        funext j
        by_cases hj : j = i
        · subst j
          simp [hc]
        · simp [hj]
      have ht : PiTensorProduct.tprod k a = c • PiTensorProduct.tprod k b := by
        calc
          _ = PiTensorProduct.tprod k (Function.update a i (c • (1 : A))) :=
            congrArg (PiTensorProduct.tprod k) ha.symm
          _ = _ := (PiTensorProduct.tprod k).map_update_smul a i c 1
      have hb : p (m ⊗ₜ[k] PiTensorProduct.tprod k b) = 0 :=
        nativeNormalizationProjection_unit_factor k A M n m b i (by simp [b])
      change p (m ⊗ₜ[k] PiTensorProduct.tprod k a) = 0
      calc
        _ = p (m ⊗ₜ[k] (c • PiTensorProduct.tprod k b)) :=
          congrArg p (congrArg (fun y => m ⊗ₜ[k] y) ht)
        _ = p (c • (m ⊗ₜ[k] PiTensorProduct.tprod k b)) :=
          congrArg p (TensorProduct.tmul_smul c m (PiTensorProduct.tprod k b))
        _ = c • p (m ⊗ₜ[k] PiTensorProduct.tprod k b) := p.map_smul c _
        _ = 0 := (congrArg (fun x => c • x) hb).trans (smul_zero c)

/-- The literal tensor projection kills the unit-insertion degeneracy. -/
@[reassoc]
theorem degeneracy_normalizationLevelMap (n : ℕ) (i : Fin (n + 1)) :
    degeneracy k A M n i ≫ normalizationLevelMap k A M (n + 1) = 0 := by
  apply ModuleCat.hom_ext
  apply tensorPower_ext
  intro m a
  change (normalizationLevelMap k A M (n + 1)).hom
    ((degeneracy k A M n i).hom (m ⊗ₜ[k] PiTensorProduct.tprod k a)) = 0
  rw [degeneracy_tprod]
  exact normalizationLevelMap_unit_factor k A M (n + 1) m _ i (by
    simp [hochschildInsertOne])

/-- The native degree quotient descends to the original A/(k·1) tensor coordinates. -/
def projectionToNormalizedLevel (n : ℕ) :
    (nativeNormalizedComplex k A M).X n ⟶ normalizedChainLevel k A M n :=
  NormalizedQuotient.descAt (coefficientBar k A M) n
    ((coefficientBarObjIso k A M n).hom ≫ normalizationLevelMap k A M n) (by
      cases n with
      | zero =>
          exact (DoldKan.degeneraciesVanish_zero_iff_true
            (X := coefficientBar k A M) _).2 True.intro
      | succ n =>
          apply (DoldKan.degeneraciesVanish_succ_iff
            (X := coefficientBar k A M) _).2
          intro i
          calc
            _ = ((coefficientBar k A M).σ i ≫
                (coefficientBarObjIso k A M (n + 1)).hom) ≫
                  normalizationLevelMap k A M (n + 1) := (Category.assoc _ _ _).symm
            _ = ((coefficientBarObjIso k A M n).hom ≫ degeneracy k A M n i) ≫
                normalizationLevelMap k A M (n + 1) :=
              congrArg (fun f => f ≫ normalizationLevelMap k A M (n + 1))
                (coefficientBarObjIso_hom_degeneracy k A M n i).symm
            _ = 0 := by
              rw [Category.assoc, degeneracy_normalizationLevelMap, Limits.comp_zero])

/-- The degree-coordinate descent has the original projection characteristic. -/
@[reassoc]
theorem nativeNormalizationProjection_projectionToLevel (n : ℕ) :
    (nativeNormalizationProjection k A M).f n ≫ projectionToNormalizedLevel k A M n =
      normalizationLevelMap k A M n := by
  have hq :
      (NormalizedQuotient.projection (coefficientBar k A M)).f n ≫
        (projectionToNormalizedLevel k A M n :
          (NormalizedQuotient.obj (coefficientBar k A M)).X n ⟶
            normalizedChainLevel k A M n) =
      (coefficientBarObjIso k A M n).hom ≫ normalizationLevelMap k A M n := by
    unfold projectionToNormalizedLevel
    exact NormalizedQuotient.projection_f_descAt _ _ _ _
  change
    ((coefficientBarObjIso k A M n).inv ≫
      (NormalizedQuotient.projection (coefficientBar k A M)).f n) ≫
      (projectionToNormalizedLevel k A M n :
        (NormalizedQuotient.obj (coefficientBar k A M)).X n ⟶
          normalizedChainLevel k A M n) = normalizationLevelMap k A M n
  calc
    _ = (coefficientBarObjIso k A M n).inv ≫
        ((NormalizedQuotient.projection (coefficientBar k A M)).f n ≫
          projectionToNormalizedLevel k A M n) := Category.assoc _ _ _
    _ = (coefficientBarObjIso k A M n).inv ≫
        ((coefficientBarObjIso k A M n).hom ≫ normalizationLevelMap k A M n) :=
      congrArg (fun f : (coefficientBar k A M).obj (op ⦋n⦌) ⟶
        normalizedChainLevel k A M n => (coefficientBarObjIso k A M n).inv ≫ f) hq
    _ = normalizationLevelMap k A M n :=
      (coefficientBarObjIso k A M n).inv_hom_id_assoc _

/-- The tensor quotient universal property gives the inverse degree coordinates. -/
def normalizedLevelSection (n : ℕ) :
    normalizedChainLevel k A M n ⟶ (nativeNormalizedComplex k A M).X n :=
  ModuleCat.ofHom (TensorPower.liftCoefficientQuotient (unitSubmodule k A) M n
    ((nativeNormalizationProjection k A M).f n).hom
    ((TensorPower.coefficientQuotientRelations_le_ker_iff _ _ _ _).2
      (nativeNormalizationProjection_relation k A M n)))

/-- The inverse coordinates retain the original projection before quotienting. -/
@[reassoc]
theorem normalizationLevelMap_section (n : ℕ) :
    normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n =
      (nativeNormalizationProjection k A M).f n := by
  apply ModuleCat.hom_ext
  exact TensorPower.liftCoefficientQuotient_comp _ _ _ _ _

/-- Both coordinate directions are from the two quotient universal properties. -/
def normalizationCoordinates (n : ℕ) :
    (nativeNormalizedComplex k A M).X n ≅ normalizedChainLevel k A M n where
  hom := projectionToNormalizedLevel k A M n
  inv := normalizedLevelSection k A M n
  hom_inv_id := by
    let p : chainLevel k A M n ⟶ (nativeNormalizedComplex k A M).X n :=
      (nativeNormalizationProjection k A M).f n
    letI : Epi p := nativeNormalizationProjection_f_epi k A M n
    have hq : p ≫ projectionToNormalizedLevel k A M n =
        normalizationLevelMap k A M n :=
      nativeNormalizationProjection_projectionToLevel k A M n
    have hs : normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n = p :=
      normalizationLevelMap_section k A M n
    apply (cancel_epi p).1
    change p ≫ (projectionToNormalizedLevel k A M n ≫ normalizedLevelSection k A M n) =
      p ≫ 𝟙 ((nativeNormalizedComplex k A M).X n)
    calc
      _ = (p ≫ projectionToNormalizedLevel k A M n) ≫ normalizedLevelSection k A M n :=
        (Category.assoc _ _ _).symm
      _ = normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n :=
        congrArg (fun f : chainLevel k A M n ⟶ normalizedChainLevel k A M n =>
          f ≫ normalizedLevelSection k A M n) hq
      _ = p := hs
      _ = _ := (Category.comp_id p).symm
  inv_hom_id := by
    let p : chainLevel k A M n ⟶ (nativeNormalizedComplex k A M).X n :=
      (nativeNormalizationProjection k A M).f n
    have hq : p ≫ projectionToNormalizedLevel k A M n =
        normalizationLevelMap k A M n :=
      nativeNormalizationProjection_projectionToLevel k A M n
    have hs : normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n = p :=
      normalizationLevelMap_section k A M n
    apply (cancel_epi (normalizationLevelMap k A M n)).1
    calc
      normalizationLevelMap k A M n ≫
          (normalizedLevelSection k A M n ≫ projectionToNormalizedLevel k A M n) =
          (normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n) ≫
            projectionToNormalizedLevel k A M n := (Category.assoc _ _ _).symm
      _ = p ≫ projectionToNormalizedLevel k A M n :=
        congrArg (fun f : chainLevel k A M n ⟶ (nativeNormalizedComplex k A M).X n =>
          f ≫ projectionToNormalizedLevel k A M n) hs
      _ = normalizationLevelMap k A M n := hq
      _ = _ := (Category.comp_id (normalizationLevelMap k A M n)).symm

/-- The full native quotient differential transported to the original normalized tensor levels. -/
def normalizedChainComplex : ChainComplex (ModuleCat.{max u v w} k) ℕ :=
  (nativeNormalizedComplex k A M).changeObjects (normalizationCoordinates k A M)

/-- Each normalized degree has exactly the original coefficient/A/(k·1) tensor carrier. -/
@[simp]
theorem normalizedChainComplex_X (n : ℕ) :
    (normalizedChainComplex k A M).X n = normalizedChainLevel k A M n := rfl

/-- Actual degree-coordinate isomorphisms assemble to the full normalized complex isomorphism. -/
def normalizationIso : nativeNormalizedComplex k A M ≅ normalizedChainComplex k A M :=
  (nativeNormalizedComplex k A M).changeObjectsIso (normalizationCoordinates k A M)

/-- The full complex comparison retains each original degree-coordinate map. -/
@[simp]
theorem normalizationIso_hom_f (n : ℕ) :
    (normalizationIso k A M).hom.f n = (normalizationCoordinates k A M n).hom := rfl

/-- The original raw Hochschild complex maps to its literal normalized tensor quotient. -/
def normalizationProjection : chainComplex k A M ⟶ normalizedChainComplex k A M :=
  nativeNormalizationProjection k A M ≫ (normalizationIso k A M).hom

/-- The normalized chain projection is the original factorwise quotient in each degree. -/
@[simp]
theorem normalizationProjection_f (n : ℕ) :
    (normalizationProjection k A M).f n = normalizationLevelMap k A M n := by
  change (nativeNormalizationProjection k A M).f n ≫
      (projectionToNormalizedLevel k A M n :
        (nativeNormalizedComplex k A M).X n ⟶ normalizedChainLevel k A M n) =
    normalizationLevelMap k A M n
  exact nativeNormalizationProjection_projectionToLevel k A M n

/-- The original normalized projection is epic as a map of complexes. -/
instance normalizationProjection_epi : Epi (normalizationProjection k A M) := by
  letI : Epi (nativeNormalizationProjection k A M) :=
    HomologicalComplex.epi_of_epi_f _ (nativeNormalizationProjection_f_epi k A M)
  exact (inferInstance :
    Epi (nativeNormalizationProjection k A M ≫ (normalizationIso k A M).hom))

/-- Native simplicial normalization earns the raw Hochschild quotient quasi-isomorphism. -/
instance normalizationProjection_quasiIso : QuasiIso (normalizationProjection k A M) := by
  let e : chainComplex k A M ≅
      (alternatingFaceMapComplex (ModuleCat.{max u v w} k)).obj (coefficientBar k A M) :=
    chainComplexIso k A M
  let p : (alternatingFaceMapComplex (ModuleCat.{max u v w} k)).obj
      (coefficientBar k A M) ⟶ NormalizedQuotient.obj (coefficientBar k A M) :=
    NormalizedQuotient.projection (coefficientBar k A M)
  letI : QuasiIso p := NormalizedQuotient.projection_quasiIso (coefficientBar k A M)
  letI : QuasiIso (nativeNormalizationProjection k A M) :=
    _root_.quasiIso_comp e.hom p
  exact _root_.quasiIso_comp
    (nativeNormalizationProjection k A M) (normalizationIso k A M).hom

/-- The entire Hochschild boundary descends through the original quotient map. -/
@[reassoc]
theorem normalizationLevelMap_d (n : ℕ) :
    normalizationLevelMap k A M (n + 1) ≫ (normalizedChainComplex k A M).d (n + 1) n =
      boundary k A M n ≫ normalizationLevelMap k A M n := by
  let d : normalizedChainLevel k A M (n + 1) ⟶ normalizedChainLevel k A M n :=
    (normalizedChainComplex k A M).d (n + 1) n
  let b : chainLevel k A M (n + 1) ⟶ chainLevel k A M n :=
    (chainComplex k A M).d (n + 1) n
  let f₁ : chainLevel k A M (n + 1) ⟶ normalizedChainLevel k A M (n + 1) :=
    (normalizationProjection k A M).f (n + 1)
  let f₀ : chainLevel k A M n ⟶ normalizedChainLevel k A M n :=
    (normalizationProjection k A M).f n
  have h : f₁ ≫ d = b ≫ f₀ := (normalizationProjection k A M).comm (n + 1) n
  have hf₁ : f₁ = normalizationLevelMap k A M (n + 1) :=
    normalizationProjection_f k A M (n + 1)
  have hf₀ : f₀ = normalizationLevelMap k A M n := normalizationProjection_f k A M n
  have hb : b = boundary k A M n := chainComplex_d k A M n
  change normalizationLevelMap k A M (n + 1) ≫ d =
    boundary k A M n ≫ normalizationLevelMap k A M n
  calc
    _ = f₁ ≫ d :=
      congrArg (fun f : chainLevel k A M (n + 1) ⟶ normalizedChainLevel k A M (n + 1) =>
        f ≫ d) hf₁.symm
    _ = b ≫ f₀ := h
    _ = boundary k A M n ≫ normalizationLevelMap k A M n :=
      congrArg₂ (fun (f : chainLevel k A M (n + 1) ⟶ chainLevel k A M n)
        (g : chainLevel k A M n ⟶ normalizedChainLevel k A M n) => f ≫ g) hb hf₀

/-- Pure normalized representatives are evaluated by projecting the complete original boundary. -/
theorem normalizedChainComplex_d_tmul_tprod (n : ℕ) (m : M) (a : Fin (n + 1) → A) :
    ((normalizedChainComplex k A M).d (n + 1) n).hom
        (m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i))) =
      ∑ i : Fin (n + 2), (-1 : ℤ) ^ i.val •
        (normalizationLevelMap k A M n).hom (faceValue k A M n i m a) := by
  let d : (M ⊗[k] TensorPower k (n + 1) (quotientCarrier k A)) →ₗ[k]
      M ⊗[k] TensorPower k n (quotientCarrier k A) :=
    ((normalizedChainComplex k A M).d (n + 1) n).hom
  let q₁ : (M ⊗[k] TensorPower k (n + 1) A) →ₗ[k]
      M ⊗[k] TensorPower k (n + 1) (quotientCarrier k A) :=
    (normalizationLevelMap k A M (n + 1)).hom
  let q₀ : (M ⊗[k] TensorPower k n A) →ₗ[k]
      M ⊗[k] TensorPower k n (quotientCarrier k A) :=
    (normalizationLevelMap k A M n).hom
  let b : (M ⊗[k] TensorPower k (n + 1) A) →ₗ[k] M ⊗[k] TensorPower k n A :=
    (boundary k A M n).hom
  have hd : d.comp q₁ = q₀.comp b :=
    congrArg (fun f : chainLevel k A M (n + 1) ⟶ normalizedChainLevel k A M n => f.hom)
      (normalizationLevelMap_d k A M n)
  have hq : q₁ (m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i)) :=
    normalizationLevelMap_tmul_tprod k A M (n + 1) m a
  have hb : b (m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      ∑ i : Fin (n + 2), (-1 : ℤ) ^ i.val • faceValue k A M n i m a :=
    boundary_tprod k A M n m a
  have h : d (q₁ (m ⊗ₜ[k] PiTensorProduct.tprod k a)) =
      q₀ (b (m ⊗ₜ[k] PiTensorProduct.tprod k a)) :=
    DFunLike.congr_fun hd (m ⊗ₜ[k] PiTensorProduct.tprod k a)
  change d (m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i))) =
    ∑ i : Fin (n + 2), (-1 : ℤ) ^ i.val • q₀ (faceValue k A M n i m a)
  calc
    _ = d (q₁ (m ⊗ₜ[k] PiTensorProduct.tprod k a)) := congrArg d hq.symm
    _ = q₀ (b (m ⊗ₜ[k] PiTensorProduct.tprod k a)) := h
    _ = q₀ (∑ i : Fin (n + 2), (-1 : ℤ) ^ i.val • faceValue k A M n i m a) :=
      congrArg q₀ hb
    _ = _ := by simp only [map_sum, map_zsmul]

/-- Any degree map killing the original unit degeneracies descends to the tensor quotient. -/
def normalizationDescAt (n : ℕ) {T : ModuleCat.{max u v w} k}
    (f : chainLevel k A M n ⟶ T)
    (h : DoldKan.DegeneraciesVanish ((coefficientBarObjIso k A M n).hom ≫ f)) :
    normalizedChainLevel k A M n ⟶ T :=
  (normalizationCoordinates k A M n).inv ≫
    NormalizedQuotient.descAt (coefficientBar k A M) n
      ((coefficientBarObjIso k A M n).hom ≫ f) h

/-- Degreewise descent retains the original factorwise projection square. -/
@[reassoc]
theorem normalizationLevelMap_descAt (n : ℕ) {T : ModuleCat.{max u v w} k}
    (f : chainLevel k A M n ⟶ T)
    (h : DoldKan.DegeneraciesVanish ((coefficientBarObjIso k A M n).hom ≫ f)) :
    normalizationLevelMap k A M n ≫ normalizationDescAt k A M n f h = f := by
  let P : ModuleCat.{max u v w} k := (nativeNormalizedComplex k A M).X n
  let p : chainLevel k A M n ⟶ P := (nativeNormalizationProjection k A M).f n
  let q : (coefficientBar k A M).obj (op ⦋n⦌) ⟶ P :=
    (NormalizedQuotient.projection (coefficientBar k A M)).f n
  let d : P ⟶ T := NormalizedQuotient.descAt (coefficientBar k A M) n
    ((coefficientBarObjIso k A M n).hom ≫ f) h
  have hp : p = (coefficientBarObjIso k A M n).inv ≫ q :=
    nativeNormalizationProjection_f k A M n
  have hq : q ≫ d = (coefficientBarObjIso k A M n).hom ≫ f :=
    NormalizedQuotient.projection_f_descAt (coefficientBar k A M) n
      ((coefficientBarObjIso k A M n).hom ≫ f) h
  have hs : normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n = p :=
    normalizationLevelMap_section k A M n
  change normalizationLevelMap k A M n ≫ (normalizedLevelSection k A M n ≫ d) = f
  calc
    normalizationLevelMap k A M n ≫ (normalizedLevelSection k A M n ≫ d) =
        (normalizationLevelMap k A M n ≫ normalizedLevelSection k A M n) ≫ d :=
      (Category.assoc _ _ _).symm
    _ = p ≫ d :=
      congrArg (fun a : chainLevel k A M n ⟶ P => a ≫ d) hs
    _ = ((coefficientBarObjIso k A M n).inv ≫ q) ≫ d :=
      congrArg (fun a : chainLevel k A M n ⟶ P => a ≫ d) hp
    _ = (coefficientBarObjIso k A M n).inv ≫ (q ≫ d) := Category.assoc _ _ _
    _ = (coefficientBarObjIso k A M n).inv ≫
        ((coefficientBarObjIso k A M n).hom ≫ f) :=
      congrArg (fun a : (coefficientBar k A M).obj (op ⦋n⦌) ⟶ T =>
        (coefficientBarObjIso k A M n).inv ≫ a) hq
    _ = f := Iso.inv_hom_id_assoc _ f

/-- A degree map on the quotient is determined by its original projection. -/
theorem normalizationDescAt_unique (n : ℕ) {T : ModuleCat.{max u v w} k}
    (f : chainLevel k A M n ⟶ T)
    (h : DoldKan.DegeneraciesVanish ((coefficientBarObjIso k A M n).hom ≫ f))
    (g : normalizedChainLevel k A M n ⟶ T)
    (hg : normalizationLevelMap k A M n ≫ g = f) :
    g = normalizationDescAt k A M n f h := by
  apply (cancel_epi (normalizationLevelMap k A M n)).1
  exact hg.trans (normalizationLevelMap_descAt k A M n f h).symm

/-- Pure quotient representatives evaluate by the original degree map. -/
theorem normalizationDescAt_tmul_tprod (n : ℕ) {T : ModuleCat.{max u v w} k}
    (f : chainLevel k A M n ⟶ T)
    (h : DoldKan.DegeneraciesVanish ((coefficientBarObjIso k A M n).hom ≫ f))
    (m : M) (a : Fin n → A) :
    (normalizationDescAt k A M n f h).hom
        (m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i))) =
      f.hom (m ⊗ₜ[k] PiTensorProduct.tprod k a) := by
  let q : M ⊗[k] TensorPower k n A →ₗ[k]
      M ⊗[k] TensorPower k n (quotientCarrier k A) :=
    (normalizationLevelMap k A M n).hom
  let d : M ⊗[k] TensorPower k n (quotientCarrier k A) →ₗ[k] T :=
    (normalizationDescAt k A M n f h).hom
  have hf : d.comp q = f.hom :=
    congrArg (fun g : chainLevel k A M n ⟶ T => g.hom)
      (normalizationLevelMap_descAt k A M n f h)
  have hq : q (m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      m ⊗ₜ[k] PiTensorProduct.tprod k (fun i => (unitSubmodule k A).mkQ (a i)) :=
    normalizationLevelMap_tmul_tprod k A M n m a
  exact (congrArg (fun x : M ⊗[k] TensorPower k n (quotientCarrier k A) => d x)
    hq.symm).trans (DFunLike.congr_fun hf (m ⊗ₜ[k] PiTensorProduct.tprod k a))

/-- Unit-degeneracy vanishing gives native degeneracy vanishing in the original bar coordinates. -/
theorem nativeNormalizationDesc_degeneraciesVanish
    {L : ChainComplex (ModuleCat.{max u v w} k) ℕ}
    (f : chainComplex k A M ⟶ L)
    (h : ∀ n (i : Fin (n + 1)), degeneracy k A M n i ≫ f.f (n + 1) = 0)
    (n : ℕ) :
    DoldKan.DegeneraciesVanish (X := coefficientBar k A M) (n := n)
      ((((chainComplexIso k A M).inv ≫ f).f n) :
        (coefficientBar k A M).obj (op ⦋n⦌) ⟶ L.X n) := by
  change DoldKan.DegeneraciesVanish
    ((coefficientBarObjIso k A M n).hom ≫ (f.f n : chainLevel k A M n ⟶ L.X n))
  cases n with
  | zero =>
      exact (DoldKan.degeneraciesVanish_zero_iff_true (X := coefficientBar k A M)
        ((coefficientBarObjIso k A M 0).hom ≫
          (f.f 0 : chainLevel k A M 0 ⟶ L.X 0))).2 True.intro
  | succ n =>
      apply (DoldKan.degeneraciesVanish_succ_iff (X := coefficientBar k A M) (n := n)
        ((coefficientBarObjIso k A M (n + 1)).hom ≫
          (f.f (n + 1) : chainLevel k A M (n + 1) ⟶ L.X (n + 1)))).2
      intro i
      let fₙ : chainLevel k A M (n + 1) ⟶ L.X (n + 1) := f.f (n + 1)
      change (coefficientBar k A M).σ i ≫
        ((coefficientBarObjIso k A M (n + 1)).hom ≫ fₙ) = 0
      have hσ : (coefficientBarObjIso k A M n).hom ≫ degeneracy k A M n i =
          (coefficientBar k A M).σ i ≫ (coefficientBarObjIso k A M (n + 1)).hom :=
        coefficientBarObjIso_hom_degeneracy k A M n i
      have hf : degeneracy k A M n i ≫ fₙ = 0 := h n i
      calc
        (coefficientBar k A M).σ i ≫
            ((coefficientBarObjIso k A M (n + 1)).hom ≫ fₙ) =
            ((coefficientBar k A M).σ i ≫
              (coefficientBarObjIso k A M (n + 1)).hom) ≫ fₙ :=
          (Category.assoc _ _ _).symm
        _ = ((coefficientBarObjIso k A M n).hom ≫ degeneracy k A M n i) ≫ fₙ :=
          congrArg (fun a : (coefficientBar k A M).obj (op ⦋n⦌) ⟶
            chainLevel k A M (n + 1) => a ≫ fₙ) hσ.symm
        _ = (coefficientBarObjIso k A M n).hom ≫ (degeneracy k A M n i ≫ fₙ) :=
          Category.assoc _ _ _
        _ = (coefficientBarObjIso k A M n).hom ≫ 0 :=
          congrArg (fun a : chainLevel k A M n ⟶ L.X (n + 1) =>
            (coefficientBarObjIso k A M n).hom ≫ a) hf
        _ = 0 := Limits.comp_zero

/-- Universal chain descent through the literal normalized complex, using unit degeneracies. -/
def normalizationDesc {L : ChainComplex (ModuleCat.{max u v w} k) ℕ}
    (f : chainComplex k A M ⟶ L)
    (h : ∀ n (i : Fin (n + 1)), degeneracy k A M n i ≫ f.f (n + 1) = 0) :
    normalizedChainComplex k A M ⟶ L :=
  (normalizationIso k A M).inv ≫ NormalizedQuotient.desc (coefficientBar k A M)
    ((chainComplexIso k A M).inv ≫ f)
    (nativeNormalizationDesc_degeneraciesVanish k A M f h)

/-- The universal normalized descent retains the original chain-map square. -/
@[reassoc]
theorem normalizationProjection_desc {L : ChainComplex (ModuleCat.{max u v w} k) ℕ}
    (f : chainComplex k A M ⟶ L)
    (h : ∀ n (i : Fin (n + 1)), degeneracy k A M n i ≫ f.f (n + 1) = 0) :
    normalizationProjection k A M ≫ normalizationDesc k A M f h = f := by
  let K₀ : ChainComplex (ModuleCat.{max u v w} k) ℕ :=
    (alternatingFaceMapComplex (ModuleCat.{max u v w} k)).obj (coefficientBar k A M)
  let Q : ChainComplex (ModuleCat.{max u v w} k) ℕ :=
    NormalizedQuotient.obj (coefficientBar k A M)
  let c : chainComplex k A M ≅ K₀ := chainComplexIso k A M
  let e : Q ≅ normalizedChainComplex k A M := normalizationIso k A M
  let p : K₀ ⟶ Q := NormalizedQuotient.projection (coefficientBar k A M)
  let f₀ : K₀ ⟶ L := c.inv ≫ f
  let hd : ∀ n, DoldKan.DegeneraciesVanish (X := coefficientBar k A M) (n := n)
      (f₀.f n) := nativeNormalizationDesc_degeneraciesVanish k A M f h
  let d : Q ⟶ L := NormalizedQuotient.desc (coefficientBar k A M) f₀ hd
  have hp : p ≫ d = f₀ :=
    NormalizedQuotient.projection_desc (coefficientBar k A M) f₀ hd
  change ((c.hom ≫ p) ≫ e.hom) ≫ (e.inv ≫ d) = f
  calc
    ((c.hom ≫ p) ≫ e.hom) ≫ (e.inv ≫ d) =
        (c.hom ≫ p) ≫ (e.hom ≫ (e.inv ≫ d)) := Category.assoc _ _ _
    _ = (c.hom ≫ p) ≫ d :=
      congrArg (fun a : Q ⟶ L => (c.hom ≫ p) ≫ a) (e.hom_inv_id_assoc d)
    _ = c.hom ≫ (p ≫ d) := Category.assoc _ _ _
    _ = c.hom ≫ f₀ := congrArg (fun a : K₀ ⟶ L => c.hom ≫ a) hp
    _ = f := c.hom_inv_id_assoc f

/-- Each descended degree retains its original factorwise quotient characteristic. -/
@[reassoc]
theorem normalizationLevelMap_desc_f {L : ChainComplex (ModuleCat.{max u v w} k) ℕ}
    (f : chainComplex k A M ⟶ L)
    (h : ∀ n (i : Fin (n + 1)), degeneracy k A M n i ≫ f.f (n + 1) = 0) (n : ℕ) :
    normalizationLevelMap k A M n ≫ (normalizationDesc k A M f h).f n = f.f n := by
  let p : chainLevel k A M n ⟶ normalizedChainLevel k A M n :=
    (normalizationProjection k A M).f n
  let d : normalizedChainLevel k A M n ⟶ L.X n := (normalizationDesc k A M f h).f n
  have hp : p = normalizationLevelMap k A M n := normalizationProjection_f k A M n
  have hc : p ≫ d = (f.f n : chainLevel k A M n ⟶ L.X n) :=
    congrArg (fun g : chainComplex k A M ⟶ L =>
      (g.f n : chainLevel k A M n ⟶ L.X n)) (normalizationProjection_desc k A M f h)
  exact (congrArg (fun a : chainLevel k A M n ⟶ normalizedChainLevel k A M n => a ≫ d)
    hp).symm.trans hc

omit [SMulCommClass A Aᵐᵒᵖ M] [SMulCommClass k A M]
  [SMulCommClass k Aᵐᵒᵖ M] [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]
  [Module A M] [Module Aᵐᵒᵖ M] in
/-- The quotient projection is compatible with coefficient-only and whole-level lifting. -/
@[reassoc]
theorem normalizationLevelMap_coefficientLift (n : ℕ) :
    normalizationLevelMap k A (ULift.{z} M) n ≫
        (normalizedCoefficientLiftEquiv k A M n).toModuleIso.hom =
      (coefficientLiftEquiv k A M n).toModuleIso.hom ≫
        (ModuleCat.uliftFunctor.{z, max u v w} k).map (normalizationLevelMap k A M n) := by
  apply ModuleCat.hom_ext
  apply tensorPower_ext
  intro m a
  obtain ⟨m⟩ := m
  change normalizedCoefficientLiftEquiv k A M n
      ((normalizationLevelMap k A (ULift.{z} M) n).hom
        (ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k a)) =
    ULift.up ((normalizationLevelMap k A M n).hom
      (m ⊗ₜ[k] PiTensorProduct.tprod k a))
  rw [normalizationLevelMap_tmul_tprod, normalizedCoefficientLiftEquiv_tprod,
    normalizationLevelMap_tmul_tprod]

/-- Whole-complex lifting of the normalized bar is from the quotient square. -/
def normalizedCoefficientLiftComplexIso :
    normalizedChainComplex k A (ULift.{z} M) ≅
      ((ModuleCat.uliftFunctor.{z, max u v w} k).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (normalizedChainComplex k A M) := by
  let F : ModuleCat.{max u v w} k ⥤ ModuleCat.{max u v w z} k :=
    ModuleCat.uliftFunctor.{z, max u v w} k
  let K : ChainComplex (ModuleCat.{max u v w} k) ℕ := normalizedChainComplex k A M
  let L : ChainComplex (ModuleCat.{max u v w z} k) ℕ :=
    normalizedChainComplex k A (ULift.{z} M)
  let R : ChainComplex (ModuleCat.{max u v w} k) ℕ := chainComplex k A M
  let R' : ChainComplex (ModuleCat.{max u v w z} k) ℕ := chainComplex k A (ULift.{z} M)
  let p : R ⟶ K := normalizationProjection k A M
  let p' : R' ⟶ L := normalizationProjection k A (ULift.{z} M)
  let r : R' ≅ (F.mapHomologicalComplex (ComplexShape.down ℕ)).obj R :=
    coefficientLiftComplexIso k A M
  let e (n : ℕ) : L.X n ≅ F.obj (K.X n) :=
    (normalizedCoefficientLiftEquiv k A M n).toModuleIso
  have hp (n : ℕ) : p'.f n ≫ (e n).hom = r.hom.f n ≫ F.map (p.f n) := by
    change (normalizationProjection k A (ULift.{z} M)).f n ≫
        (normalizedCoefficientLiftEquiv k A M n).toModuleIso.hom =
      (coefficientLiftEquiv k A M n).toModuleIso.hom ≫
        F.map ((normalizationProjection k A M).f n)
    rw [normalizationProjection_f, normalizationProjection_f]
    exact normalizationLevelMap_coefficientLift k A M n
  refine HomologicalComplex.Hom.isoOfComponents e ?_
  intro i j hij
  change (e i).hom ≫ F.map (K.d i j) = L.d i j ≫ (e j).hom
  haveI : Epi (p'.f i) := by
    have hq : p'.f i =
        (normalizationLevelMap k A (ULift.{z} M) i : R'.X i ⟶ L.X i) :=
      normalizationProjection_f k A (ULift.{z} M) i
    have hEpi : Epi
        (normalizationLevelMap k A (ULift.{z} M) i : R'.X i ⟶ L.X i) :=
      normalizationLevelMap_epi k A (ULift.{z} M) i
    exact hq.symm ▸ hEpi
  have hr : r.hom.f i ≫ F.map (R.d i j) = R'.d i j ≫ r.hom.f j :=
    r.hom.comm i j
  apply (cancel_epi (p'.f i)).1
  calc
    p'.f i ≫ ((e i).hom ≫ F.map (K.d i j)) =
        (p'.f i ≫ (e i).hom) ≫ F.map (K.d i j) :=
      (Category.assoc _ _ _).symm
    _ = (r.hom.f i ≫ F.map (p.f i)) ≫ F.map (K.d i j) :=
      congrArg (fun a => a ≫ F.map (K.d i j)) (hp i)
    _ = r.hom.f i ≫ F.map (p.f i ≫ K.d i j) := by
      rw [F.map_comp, Category.assoc]
    _ = r.hom.f i ≫ F.map (R.d i j ≫ p.f j) :=
      congrArg (fun a => r.hom.f i ≫ F.map a) (p.comm i j)
    _ = (r.hom.f i ≫ F.map (R.d i j)) ≫ F.map (p.f j) := by
      rw [F.map_comp, Category.assoc]
    _ = (R'.d i j ≫ r.hom.f j) ≫ F.map (p.f j) :=
      congrArg (fun a => a ≫ F.map (p.f j)) hr
    _ = R'.d i j ≫ (r.hom.f j ≫ F.map (p.f j)) := Category.assoc _ _ _
    _ = R'.d i j ≫ (p'.f j ≫ (e j).hom) :=
      congrArg (fun a => R'.d i j ≫ a) (hp j).symm
    _ = (R'.d i j ≫ p'.f j) ≫ (e j).hom := (Category.assoc _ _ _).symm
    _ = (p'.f i ≫ L.d i j) ≫ (e j).hom :=
      congrArg (fun a => a ≫ (e j).hom) (p'.comm i j).symm
    _ = p'.f i ≫ (L.d i j ≫ (e j).hom) := Category.assoc _ _ _

/-- The whole-complex lift retains the original normalized tensor degree equivalence. -/
@[simp]
theorem normalizedCoefficientLiftComplexIso_hom_f (n : ℕ) :
    ((normalizedCoefficientLiftComplexIso k A M).hom.f n).hom =
      (normalizedCoefficientLiftEquiv k A M n).toLinearMap := rfl

/-- The inverse complex lift retains the inverse normalized tensor coordinates. -/
@[simp]
theorem normalizedCoefficientLiftComplexIso_inv_f (n : ℕ) :
    ((normalizedCoefficientLiftComplexIso k A M).inv.f n).hom =
      (normalizedCoefficientLiftEquiv k A M n).symm.toLinearMap := rfl

/-- Lifting the original quotient projection commutes as a square of chain maps. -/
@[reassoc]
theorem normalizationProjection_coefficientLift :
    normalizationProjection k A (ULift.{z} M) ≫
        (normalizedCoefficientLiftComplexIso k A M).hom =
      (coefficientLiftComplexIso k A M).hom ≫
        ((ModuleCat.uliftFunctor.{z, max u v w} k).mapHomologicalComplex
          (ComplexShape.down ℕ)).map (normalizationProjection k A M) := by
  apply HomologicalComplex.Hom.ext
  funext n
  change (normalizationProjection k A (ULift.{z} M)).f n ≫
      (normalizedCoefficientLiftEquiv k A M n).toModuleIso.hom =
    (coefficientLiftEquiv k A M n).toModuleIso.hom ≫
      (ModuleCat.uliftFunctor.{z, max u v w} k).map
        ((normalizationProjection k A M).f n)
  rw [normalizationProjection_f, normalizationProjection_f]
  exact normalizationLevelMap_coefficientLift k A M n

end CoefficientBar

section Maps

variable {k : Type u} [CommRing k]
  {A : Type v} [Ring A] [Algebra k A] {B : Type z} [Ring B] [Algebra k B]
  {M : Type w} [AddCommGroup M] [Module k M]
  [Module A M] [Module Aᵐᵒᵖ M] [SMulCommClass A Aᵐᵒᵖ M]
  [SMulCommClass k A M] [SMulCommClass k Aᵐᵒᵖ M]
  [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]
  {N : Type t} [AddCommGroup N] [Module k N]
  [Module B N] [Module Bᵐᵒᵖ N] [SMulCommClass B Bᵐᵒᵖ N]
  [SMulCommClass k B N] [SMulCommClass k Bᵐᵒᵖ N]
  [IsScalarTower k B N] [IsScalarTower k Bᵐᵒᵖ N]

/-- The lifted unit-preserving tensor map kills unit degeneracies after normalization. -/
theorem liftedMapAt_normalizationProjection_degeneracy.{s₁, u₁, v₁, z₁, w₁, t₁}
    {k : Type u₁} [CommRing k]
    {A : Type v₁} [Ring A] [Algebra k A]
    {B : Type z₁} [Ring B] [Algebra k B]
    {M : Type w₁} [AddCommGroup M] [Module k M]
    [Module A M] [Module Aᵐᵒᵖ M] [SMulCommClass A Aᵐᵒᵖ M]
    [SMulCommClass k A M] [SMulCommClass k Aᵐᵒᵖ M]
    [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]
    {N : Type t₁} [AddCommGroup N] [Module k N]
    [Module B N] [Module Bᵐᵒᵖ N] [SMulCommClass B Bᵐᵒᵖ N]
    [SMulCommClass k B N] [SMulCommClass k Bᵐᵒᵖ N]
    [IsScalarTower k B N] [IsScalarTower k Bᵐᵒᵖ N]
    (g : A →ₐ[k] B) (f : M →ₗ[k] N)
    (hleft : ∀ a m, f (a • m) = g a • f m)
    (hright : ∀ a m, f (MulOpposite.op a • m) = MulOpposite.op (g a) • f m)
    (n : ℕ) (i : Fin (n + 1)) :
    degeneracy k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i ≫
      (liftedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g.toNonUnitalAlgHom f hleft hright ≫
        normalizationProjection k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N)).f (n + 1) = 0 := by
  let r : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) (n + 1) ⟶
      chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) :=
    (liftedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g.toNonUnitalAlgHom f hleft hright).f (n + 1)
  let p : chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) ⟶
      normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) :=
    (normalizationProjection k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N)).f (n + 1)
  let q : chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) ⟶
      normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) :=
    normalizationLevelMap k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1)
  have hp : p = q := normalizationProjection_f k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1)
  have hz : degeneracy k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i ≫ (r ≫ q) = 0 := by
    apply ModuleCat.hom_ext
    apply tensorPower_ext
    intro m a
    change q.hom (r.hom
      ((degeneracy k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i).hom
        (m ⊗ₜ[k] PiTensorProduct.tprod k a))) = 0
    have hd : (degeneracy k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i).hom
        (m ⊗ₜ[k] PiTensorProduct.tprod k a) =
        m ⊗ₜ[k] PiTensorProduct.tprod k (hochschildInsertOne i a) :=
      degeneracy_tprod k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i m a
    have hr : r.hom (m ⊗ₜ[k] PiTensorProduct.tprod k (hochschildInsertOne i a)) =
        ULift.up (f m.down) ⊗ₜ[k] PiTensorProduct.tprod k
          (fun j => g ((hochschildInsertOne i a) j)) :=
      liftedMapAt_f_tprod.{u₁, v₁, z₁, w₁, t₁, s₁}
        g.toNonUnitalAlgHom f hleft hright (n + 1) m (hochschildInsertOne i a)
    have hq : q.hom (ULift.up (f m.down) ⊗ₜ[k] PiTensorProduct.tprod k
        (fun j => g ((hochschildInsertOne i a) j))) = 0 :=
      normalizationLevelMap_unit_factor k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N)
        (n + 1) (ULift.up (f m.down)) _ i (by simp [hochschildInsertOne])
    exact (congrArg (fun x : ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N ⊗[k]
        TensorPower k (n + 1) B => q.hom x)
      ((congrArg (fun x : ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M ⊗[k]
        TensorPower k (n + 1) A => r.hom x) hd).trans hr)).trans hq
  change degeneracy k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i ≫ (r ≫ p) = 0
  exact (congrArg (fun a : chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) ⟶
    normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) (n + 1) =>
      degeneracy k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n i ≫ (r ≫ a)) hp).trans hz

/-- A unit-preserving algebra/coefficient map descends in the common lifted category. -/
def normalizedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁}
    {k : Type u₁} [CommRing k]
    {A : Type v₁} [Ring A] [Algebra k A]
    {B : Type z₁} [Ring B] [Algebra k B]
    {M : Type w₁} [AddCommGroup M] [Module k M]
    [Module A M] [Module Aᵐᵒᵖ M] [SMulCommClass A Aᵐᵒᵖ M]
    [SMulCommClass k A M] [SMulCommClass k Aᵐᵒᵖ M]
    [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]
    {N : Type t₁} [AddCommGroup N] [Module k N]
    [Module B N] [Module Bᵐᵒᵖ N] [SMulCommClass B Bᵐᵒᵖ N]
    [SMulCommClass k B N] [SMulCommClass k Bᵐᵒᵖ N]
    [IsScalarTower k B N] [IsScalarTower k Bᵐᵒᵖ N]
    (g : A →ₐ[k] B) (f : M →ₗ[k] N)
    (hleft : ∀ a m, f (a • m) = g a • f m)
    (hright : ∀ a m, f (MulOpposite.op a • m) = MulOpposite.op (g a) • f m) :
    normalizedChainComplex k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) ⟶
      normalizedChainComplex k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) :=
  normalizationDesc k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M)
    (liftedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g.toNonUnitalAlgHom f hleft hright ≫
      normalizationProjection k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N))
    (liftedMapAt_normalizationProjection_degeneracy.{s₁, u₁, v₁, z₁, w₁, t₁}
      g f hleft hright)

/-- The common-world normalized map retains the original raw projection square. -/
@[reassoc]
theorem normalizationProjection_normalizedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁}
    {k : Type u₁} [CommRing k]
    {A : Type v₁} [Ring A] [Algebra k A]
    {B : Type z₁} [Ring B] [Algebra k B]
    {M : Type w₁} [AddCommGroup M] [Module k M]
    [Module A M] [Module Aᵐᵒᵖ M] [SMulCommClass A Aᵐᵒᵖ M]
    [SMulCommClass k A M] [SMulCommClass k Aᵐᵒᵖ M]
    [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]
    {N : Type t₁} [AddCommGroup N] [Module k N]
    [Module B N] [Module Bᵐᵒᵖ N] [SMulCommClass B Bᵐᵒᵖ N]
    [SMulCommClass k B N] [SMulCommClass k Bᵐᵒᵖ N]
    [IsScalarTower k B N] [IsScalarTower k Bᵐᵒᵖ N]
    (g : A →ₐ[k] B) (f : M →ₗ[k] N)
    (hleft : ∀ a m, f (a • m) = g a • f m)
    (hright : ∀ a m, f (MulOpposite.op a • m) = MulOpposite.op (g a) • f m) :
    normalizationProjection k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) ≫
        normalizedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g f hleft hright =
      liftedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g.toNonUnitalAlgHom f hleft hright ≫
        normalizationProjection k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) :=
  normalizationProjection_desc k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M)
    (liftedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g.toNonUnitalAlgHom f hleft hright ≫
      normalizationProjection k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N))
    (liftedMapAt_normalizationProjection_degeneracy.{s₁, u₁, v₁, z₁, w₁, t₁}
      g f hleft hright)

/-- The common-world normalized chain map retains coefficient and algebra values. -/
theorem normalizedMapAt_f_tmul_tprod.{s₁, u₁, v₁, z₁, w₁, t₁}
    {k : Type u₁} [CommRing k]
    {A : Type v₁} [Ring A] [Algebra k A]
    {B : Type z₁} [Ring B] [Algebra k B]
    {M : Type w₁} [AddCommGroup M] [Module k M]
    [Module A M] [Module Aᵐᵒᵖ M] [SMulCommClass A Aᵐᵒᵖ M]
    [SMulCommClass k A M] [SMulCommClass k Aᵐᵒᵖ M]
    [IsScalarTower k A M] [IsScalarTower k Aᵐᵒᵖ M]
    {N : Type t₁} [AddCommGroup N] [Module k N]
    [Module B N] [Module Bᵐᵒᵖ N] [SMulCommClass B Bᵐᵒᵖ N]
    [SMulCommClass k B N] [SMulCommClass k Bᵐᵒᵖ N]
    [IsScalarTower k B N] [IsScalarTower k Bᵐᵒᵖ N]
    (g : A →ₐ[k] B) (f : M →ₗ[k] N)
    (hleft : ∀ a m, f (a • m) = g a • f m)
    (hright : ∀ a m, f (MulOpposite.op a • m) = MulOpposite.op (g a) • f m)
    (n : ℕ) (m : M) (a : Fin n → A) :
    ((normalizedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g f hleft hright).f n).hom
        (ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k
          (fun i => (unitSubmodule k A).mkQ (a i))) =
      ULift.up (f m) ⊗ₜ[k] PiTensorProduct.tprod k
        (fun i => (unitSubmodule k B).mkQ (g (a i))) := by
  let p : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
      normalizedChainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n :=
    normalizationLevelMap k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n
  let q : chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n ⟶
      normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n :=
    normalizationLevelMap k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n
  let r : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
      chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n :=
    (liftedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g.toNonUnitalAlgHom f hleft hright).f n
  let d : normalizedChainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
      normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n :=
    (normalizedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g f hleft hright).f n
  let p' : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
      normalizedChainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n :=
    (normalizationProjection k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M)).f n
  let q' : chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n ⟶
      normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n :=
    (normalizationProjection k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N)).f n
  have hp : p' = p := normalizationProjection_f k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n
  have hq : q' = q := normalizationProjection_f k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n
  have hc : p' ≫ d = r ≫ q' :=
    congrArg (fun φ : chainComplex k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) ⟶
        normalizedChainComplex k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) =>
      (φ.f n : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
        normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n))
      (normalizationProjection_normalizedMapAt.{s₁, u₁, v₁, z₁, w₁, t₁} g f hleft hright)
  have hmap : p ≫ d = r ≫ q :=
    (congrArg (fun φ : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
      normalizedChainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n => φ ≫ d) hp).symm.trans
      (hc.trans (congrArg (fun φ : chainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n ⟶
        normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n => r ≫ φ) hq))
  have hf : d.hom.comp p.hom = q.hom.comp r.hom :=
    congrArg (fun φ : chainLevel k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M) n ⟶
      normalizedChainLevel k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N) n => φ.hom) hmap
  have hpx : p.hom (ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k
        (fun i => (unitSubmodule k A).mkQ (a i)) :=
    normalizationLevelMap_tmul_tprod k A (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M)
      n (ULift.up m) a
  have hrx : r.hom (ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k a) =
      ULift.up (f m) ⊗ₜ[k] PiTensorProduct.tprod k (fun i => g (a i)) :=
    liftedMapAt_f_tprod.{u₁, v₁, z₁, w₁, t₁, s₁}
      g.toNonUnitalAlgHom f hleft hright n (ULift.up m) a
  have hqx : q.hom (ULift.up (f m) ⊗ₜ[k] PiTensorProduct.tprod k (fun i => g (a i))) =
      ULift.up (f m) ⊗ₜ[k] PiTensorProduct.tprod k
        (fun i => (unitSubmodule k B).mkQ (g (a i))) :=
    normalizationLevelMap_tmul_tprod k B (ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N)
      n (ULift.up (f m)) (fun i => g (a i))
  exact (congrArg (fun x : ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} M ⊗[k]
      TensorPower k n (quotientCarrier k A) => d.hom x) hpx.symm).trans
    ((DFunLike.congr_fun hf (ULift.up m ⊗ₜ[k] PiTensorProduct.tprod k a)).trans
      ((congrArg (fun x : ULift.{max u₁ v₁ z₁ w₁ t₁ s₁} N ⊗[k]
        TensorPower k n B => q.hom x) hrx).trans hqx))
end Maps

end ModuleCat.Algebra.Hochschild
