module

public import MathlibExt.Algebra.Homology.Hochschild.SymmetricEulerianOperators
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# The rational kernel description of proper shuffle relations

Let k be a commutative ℚ-algebra, A a commutative k-algebra and M a compatible A-module. In M
⊗[k] A⊗n, the relation module generated by shuffle inputs with both degrees positive is
ker(pₙ), where pₙ=eₙ⁽⁰⁾+eₙ⁽¹⁾. Higher Eulerian weights lie in that relation module; proper
shuffle products are killed by pₙ. The quotient therefore identifies with range(pₙ), including
the degree-zero convention.

See J.-L. Loday, Cyclic Homology, 2nd ed., §4.5, for the rational Harrison summand.
-/

@[expose] public section
noncomputable section

open CategoryTheory
open scoped TensorProduct BigOperators MonoidalCategory

universe u v w

namespace ModuleCat.Algebra.Hochschild.Symmetric

attribute [local instance] ModuleCat.Algebra.Hochschild.uliftSMulCommClass

variable (k : Type u) [CommRing k] [Algebra ℚ k]
  (A : Type v) [CommRing A] [Algebra k A]
  (M : Type w) [AddCommGroup M] [Module k M] [Module A M]
  [SMulCommClass k A M] [IsScalarTower k A M]

/-- A nonzero rational scalar cancels on a k-module.

For a commutative ℚ-algebra k and a k-module V, if r≠0 in ℚ and algebraMap(r)·x=0, then x=0,
since algebraMap(r) has inverse algebraMap(r⁻¹). -/
theorem rational_scalar_cancel {V : Type*} [AddCommGroup V] [Module k V]
    (r : ℚ) (hr : r ≠ 0) (x : V) (hx : (algebraMap ℚ k r) • x = 0) : x = 0 := by
  have h := congrArg (fun y : V => (algebraMap ℚ k r⁻¹) • y) hx
  rw [smul_smul, ← map_mul, inv_mul_cancel₀ hr, map_one, one_smul, smul_zero] at h
  exact h

/-- Higher powers of two differ from two over the rationals.

For a natural weight i≥2, (2:ℚ)ⁱ-2 is nonzero. This separates higher Eulerian eigenvalues from
the lowest positive weight. -/
theorem two_pow_sub_two_ne_zero (i : ℕ) (hi : 2 ≤ i) : (2 : ℚ) ^ i - 2 ≠ 0 := by
  have hpow : ∀ j : ℕ, (2 : ℚ) ^ (j + 2) > 2 := by
    intro j
    induction j with
    | zero => norm_num
    | succ j hj =>
      rw [show j + 1 + 2 = (j + 2) + 1 by omega, pow_succ]
      nlinarith
  obtain ⟨j, rfl⟩ : ∃ j : ℕ, i = j + 2 := ⟨i - 2, by omega⟩
  exact sub_ne_zero.mpr (ne_of_gt (hpow j))

/-- The ground-linear zero-plus-first coefficient projector.

For a commutative ℚ-algebra k, a commutative k-algebra A and a compatible A-module M,
firstEulerianOperator(n)=eₙ⁽⁰⁾+eₙ⁽¹⁾ on M ⊗[k] A⊗n. -/
def firstEulerianOperator (n : ℕ) : Module.End k (M ⊗[k] TensorPower k n A) :=
  coefficientEulerianOperator k A M n 0 + coefficientEulerianOperator k A M n 1

/-- Every higher Eulerian coefficient component is a proper shuffle relation.

For a commutative ℚ-algebra k, a commutative k-algebra A and a compatible A-module M, for
2≤i≤n, eₙ⁽ⁱ⁾(x) lies in rawPositiveRelations(n) for every coefficient tensor x. -/
theorem higherEulerian_mem_proper (n i : ℕ) (hi : 2 ≤ i) (hin : i ≤ n)
    (x : M ⊗[k] TensorPower k n A) :
    coefficientEulerianOperator k A M n i x ∈
      ModuleCat.Algebra.Hochschild.Symmetric.rawPositiveRelations k A M n := by
  have hn : 0 < n := by omega
  let y := coefficientEulerianOperator k A M n i x
  have heig : lambdaTwoOperator k A M n y = (algebraMap ℚ k ((2 : ℚ) ^ i)) • y :=
    DFunLike.congr_fun (lambdaTwo_comp_eulerian k A M n i hin) x
  have hrel := lambdaTwo_sub_two_mem k A M n hn y
  have heq : lambdaTwoOperator k A M n y - (2 : k) • y =
      (algebraMap ℚ k ((2 : ℚ) ^ i - 2)) • y := by
    rw [heig, map_sub, sub_smul]
    have htwo : algebraMap ℚ k (2 : ℚ) = (2 : k) := by
      rw [show (2 : ℚ) = 1 + 1 by norm_num, map_add, map_one]
      norm_num
    rw [htwo]
  rw [heq] at hrel
  have h := (ModuleCat.Algebra.Hochschild.Symmetric.rawPositiveRelations k A M n).smul_mem
    (algebraMap ℚ k (((2 : ℚ) ^ i - 2)⁻¹)) hrel
  simpa only [smul_smul, ← map_mul, inv_mul_cancel₀ (two_pow_sub_two_ne_zero i hi),
    map_one, one_smul] using h

/-- The lowest coefficient projector kills both-positive shuffle pairings.

For a commutative ℚ-algebra k, a commutative k-algebra A and a compatible A-module M, for
p,q>0, pₚ₊ᵩ applied to the (p,q) coefficient pairing is zero on every pair of inputs. -/
theorem firstEulerian_pairing_zero (p q : ℕ) (hp : 0 < p) (hq : 0 < q)
    (u : ULift.{w} A ⊗[k] TensorPower k p A) (v : M ⊗[k] TensorPower k q A) :
  letI : MonoidalCategoryStruct (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.tensorStructure.{u, max v w} (R := k)
  letI : MonoidalCategory (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalCategory.{u, max v w} (R := k)
  letI : MonoidalPreadditive (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalPreadditive.{u, max v w} (R := k)
  letI : MonoidalLinear k (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalLinear.{u, max v w} (R := k)
  coefficientEulerianOperator k A M (p + q) 1
      (((ModuleCat.Algebra.Hochschild.Symmetric.pairing.{u, v, w} k A M).pair p q).hom (u ⊗ₜ[k] v)) = 0 := by
  classical
  letI : MonoidalCategoryStruct (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.tensorStructure.{u, max v w} (R := k)
  letI : MonoidalCategory (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalCategory.{u, max v w} (R := k)
  letI : MonoidalPreadditive (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalPreadditive.{u, max v w} (R := k)
  letI : MonoidalLinear k (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalLinear.{u, max v w} (R := k)
  let μ : (ULift.{w} A ⊗[k] TensorPower k p A) ⊗[k] (M ⊗[k] TensorPower k q A) →ₗ[k]
      M ⊗[k] TensorPower k (p + q) A :=
    ((ModuleCat.Algebra.Hochschild.Symmetric.pairing.{u, v, w} k A M).pair p q).hom
  change coefficientEulerianOperator k A M (p + q) 1 (μ (u ⊗ₜ[k] v)) = 0
  have hu : u = ∑ i : Fin (p + 1), coefficientEulerianOperator k A (ULift.{w} A) p i.val u := by
    have h := DFunLike.congr_fun (coefficientEulerian_projector_laws k A (ULift.{w} A) p).1 u
    simpa only [LinearMap.sum_apply, LinearMap.id_apply] using h.symm
  have hv : v = ∑ j : Fin (q + 1), coefficientEulerianOperator k A M q j.val v := by
    have h := DFunLike.congr_fun (coefficientEulerian_projector_laws k A M q).1 v
    simpa only [LinearMap.sum_apply, LinearMap.id_apply] using h.symm
  rw [hu, hv, TensorProduct.sum_tmul]
  simp_rw [TensorProduct.tmul_sum]
  simp only [map_sum]
  apply Finset.sum_eq_zero
  intro i hi
  apply Finset.sum_eq_zero
  intro j hj
  by_cases hi0 : i.val = 0
  · rw [hi0, coefficientEulerian_zero_weight k A (ULift.{w} A) p hp]
    simp
  by_cases hj0 : j.val = 0
  · rw [hj0, coefficientEulerian_zero_weight k A M q hq]
    simp
  let a := coefficientEulerianOperator k A (ULift.{w} A) p i.val u
  let b := coefficientEulerianOperator k A M q j.val v
  let y := μ (a ⊗ₜ[k] b)
  have hweight : lambdaTwoOperator k A M (p + q) y =
      (algebraMap ℚ k ((2 : ℚ) ^ (i.val + j.val))) • y := by
    have hpair : (lambdaTwoOperator k A M (p + q)).comp μ =
        μ.comp (TensorProduct.map (lambdaTwoOperator k A (ULift.{w} A) p)
          (lambdaTwoOperator k A M q)) := lambdaTwo_pairing k A M p q
    have h := DFunLike.congr_fun hpair (a ⊗ₜ[k] b)
    have ha : lambdaTwoOperator k A (ULift.{w} A) p a =
        (algebraMap ℚ k ((2 : ℚ) ^ i.val)) • a :=
      DFunLike.congr_fun (lambdaTwo_comp_eulerian k A (ULift.{w} A) p i.val
        (Nat.le_of_lt_succ i.isLt)) u
    have hb : lambdaTwoOperator k A M q b = (algebraMap ℚ k ((2 : ℚ) ^ j.val)) • b :=
      DFunLike.congr_fun (lambdaTwo_comp_eulerian k A M q j.val (Nat.le_of_lt_succ j.isLt)) v
    change lambdaTwoOperator k A M (p + q) y =
      μ
        (lambdaTwoOperator k A (ULift.{w} A) p a ⊗ₜ[k] lambdaTwoOperator k A M q b) at h
    rw [ha, hb, TensorProduct.smul_tmul_smul, map_smul] at h
    simpa only [← map_mul, ← pow_add] using h
  have hfirst := DFunLike.congr_fun
    (eulerian_comp_lambdaTwo k A M (p + q) 1 (by omega)) y
  change coefficientEulerianOperator k A M (p + q) 1
      (lambdaTwoOperator k A M (p + q) y) =
    (algebraMap ℚ k ((2 : ℚ) ^ 1)) • coefficientEulerianOperator k A M (p + q) 1 y at hfirst
  rw [hweight, map_smul, pow_one] at hfirst
  have hzero : (algebraMap ℚ k ((2 : ℚ) ^ (i.val + j.val) - 2)) •
      coefficientEulerianOperator k A M (p + q) 1 y = 0 := by
    rw [map_sub, sub_smul]
    exact sub_eq_zero.mpr hfirst
  exact rational_scalar_cancel k ((2 : ℚ) ^ (i.val + j.val) - 2)
    (two_pow_sub_two_ne_zero (i.val + j.val) (by omega)) _ hzero

/-- The proper-shuffle submodule is the kernel of the coefficient lowest projector.

For a commutative ℚ-algebra k, a commutative k-algebra A and a compatible A-module M,
rawPositiveRelations(n)=ker(eₙ⁽⁰⁾+eₙ⁽¹⁾), using strictly positive degrees in both shuffle
inputs. -/
theorem rawPositiveRelations_eq_firstEulerianKernel (n : ℕ) :
    ModuleCat.Algebra.Hochschild.Symmetric.rawPositiveRelations k A M n =
      LinearMap.ker (firstEulerianOperator k A M n) := by
  classical
  letI : MonoidalCategoryStruct (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.tensorStructure.{u, max v w} (R := k)
  letI : MonoidalCategory (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalCategory.{u, max v w} (R := k)
  letI : MonoidalPreadditive (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalPreadditive.{u, max v w} (R := k)
  letI : MonoidalLinear k (ModuleCat.{max u v w} k) :=
    ModuleCat.UniverseTensor.monoidalLinear.{u, max v w} (R := k)
  apply le_antisymm
  · change HomologicalComplex.ChainGradedPairing.positiveImages
      (ModuleCat.Algebra.Hochschild.Symmetric.pairing.{u, v, w} k A M) n ≤ _
    apply iSup_le
    rintro ⟨⟨p, q⟩, hp, hq, h⟩
    subst n
    apply LinearMap.range_le_ker_iff.mpr
    apply TensorProduct.ext'
    intro u v
    change firstEulerianOperator k A M (p + q)
      (((ModuleCat.Algebra.Hochschild.Symmetric.pairing.{u, v, w} k A M).pair p q).hom (u ⊗ₜ[k] v)) = 0
    rw [firstEulerianOperator, coefficientEulerian_zero_weight k A M (p + q) (by omega), zero_add]
    exact firstEulerian_pairing_zero k A M p q hp hq u v
  · intro x hx
    by_cases hn : n = 0
    · subst n
      have hx0 : x = 0 := by
        change firstEulerianOperator k A M 0 x = 0 at hx
        simpa only [firstEulerianOperator, coefficientEulerian_degree_zero,
          coefficientEulerian_outside k A M 0 1 (by omega), add_zero, LinearMap.id_apply] using hx
      rw [hx0]
      exact Submodule.zero_mem _
    have hnpos : 0 < n := Nat.pos_of_ne_zero hn
    have hx1 : coefficientEulerianOperator k A M n 1 x = 0 := by
      change firstEulerianOperator k A M n x = 0 at hx
      simpa only [firstEulerianOperator, coefficientEulerian_zero_weight k A M n hnpos,
        zero_add] using hx
    have hsum : x = ∑ i : Fin (n + 1), coefficientEulerianOperator k A M n i.val x := by
      have h := DFunLike.congr_fun (coefficientEulerian_projector_laws k A M n).1 x
      simpa only [LinearMap.sum_apply, LinearMap.id_apply] using h.symm
    rw [hsum]
    apply Submodule.sum_mem
    intro i hi
    by_cases hi0 : i.val = 0
    · rw [hi0, coefficientEulerian_zero_weight k A M n hnpos]
      exact Submodule.zero_mem _
    by_cases hi1 : i.val = 1
    · rw [hi1, hx1]
      exact Submodule.zero_mem _
    exact higherEulerian_mem_proper k A M n i.val (by omega) (Nat.le_of_lt_succ i.isLt) x

/-- The ground-linear proper quotient equals the coefficient lowest-projector image.

For a commutative ℚ-algebra k, a commutative k-algebra A and a compatible A-module M, the nth
term of positiveQuotient is k-linearly equivalent to range(firstEulerianOperator(n)). -/
def firstEulerianQuotientLevelEquiv (n : ℕ) :
    (ModuleCat.Algebra.Hochschild.Symmetric.positiveQuotient k A M).X n ≃ₗ[k]
      LinearMap.range (firstEulerianOperator k A M n) :=
  (Submodule.quotEquivOfEq _ _ (rawPositiveRelations_eq_firstEulerianKernel k A M n)).trans
    (firstEulerianOperator k A M n).quotKerEquivRange

end ModuleCat.Algebra.Hochschild.Symmetric
