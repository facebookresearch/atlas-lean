-- Author: @toskua, Avocado
module

public import MathlibExt.Algebra.Homology.KoszulComplexBaseChange
public import MathlibExt.Algebra.Homology.KoszulComplexFamily
public import Mathlib.RingTheory.TensorProduct.Pi
public import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# Base change for finite-family Koszul complexes

For a finite family, the scalar-extended standard module is canonically
identified with the standard module over the target ring. This file compares
the resulting Koszul complexes, generated ideals, quotient algebras, and raw
degree-zero augmentations.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

noncomputable section

open CategoryTheory
open scoped TensorProduct

universe u v w

namespace KoszulComplex

variable (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
variable {I : Type w} [Fintype I]

/-- The image of a finite family under the algebra map. -/
def mappedFamily (a : I → R) : I → S :=
  fun i => algebraMap R S (a i)

/-- Canonical algebra-level scalar extension of the standard finite free
module. -/
@[no_expose]
def familyModuleBaseChangeAlgEquiv :
    S ⊗[R] (I → R) ≃ₐ[S] (I → S) := by
  classical
  exact Algebra.TensorProduct.piScalarRight R S S I

@[simp]
theorem familyModuleBaseChangeAlgEquiv_tmul (s : S) (f : I → R) :
    familyModuleBaseChangeAlgEquiv R S (I := I) (s ⊗ₜ[R] f) =
      fun i => algebraMap R S (f i) * s := by
  classical
  rw [familyModuleBaseChangeAlgEquiv]
  ext i
  rw [Algebra.TensorProduct.piScalarRight_tmul_apply,
    Algebra.smul_def]

/-- Linear view of `familyModuleBaseChangeAlgEquiv` for exterior-power and
Koszul consumers. -/
def familyModuleBaseChangeEquiv :
    S ⊗[R] (I → R) ≃ₗ[S] (I → S) :=
  (familyModuleBaseChangeAlgEquiv R S (I := I)).toLinearEquiv

/-- The finite-family coefficient functional commutes with scalar extension
and the canonical finite-product comparison. -/
theorem familyFunctional_baseChange (a : I → R) :
    (familyFunctional S (mappedFamily R S a)).comp
        (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap =
      baseChangeFunctional R S (I → R) (familyFunctional R a) := by
  classical
  apply TensorProduct.AlgebraTensorModule.curry_injective
  apply LinearMap.ext
  intro s
  apply LinearMap.ext
  intro f
  change familyFunctional S (mappedFamily R S a)
      (familyModuleBaseChangeAlgEquiv R S (I := I) (s ⊗ₜ[R] f)) =
    baseChangeFunctional R S (I → R) (familyFunctional R a)
      (s ⊗ₜ[R] f)
  rw [familyModuleBaseChangeAlgEquiv_tmul,
    baseChangeFunctional_tmul]
  simp only [familyFunctional, mappedFamily,
    Fintype.linearCombination_apply, Algebra.smul_def]
  rw [map_sum]
  simp only [map_mul]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  simp only [Algebra.algebraMap_self_apply]
  ring

/-- The ideal generated by a finite family commutes with extension of
scalars. -/
theorem familyIdeal_map (a : I → R) :
    (ideal R (I → R) (familyFunctional R a)).map (algebraMap R S) =
      ideal S (I → S) (familyFunctional S (mappedFamily R S a)) := by
  rw [familyIdeal_eq_span, familyIdeal_eq_span, Ideal.map_span]
  congr 1
  ext s
  simp only [Set.mem_image, Set.mem_range, mappedFamily]
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨a i, ⟨i, rfl⟩, rfl⟩

/-- The universe-lifted target finite-family Koszul complex. -/
def familyBaseChangeTargetComplex (a : I → R) :
    ChainComplex (ModuleCat.{max u v w} S) ℕ :=
  ((ModuleCat.uliftFunctor.{u, max v w} S).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
    (familyComplex S (mappedFamily R S a))

/-- The degree-`n` object of the lifted target family complex. -/
theorem familyBaseChangeTargetComplex_X (a : I → R) (n : ℕ) :
    (familyBaseChangeTargetComplex R S a).X n =
      ModuleCat.of S
        (ULift.{u, max v w} (⋀[S]^n (I → S))) := by
  unfold familyBaseChangeTargetComplex
  rfl

/-- The successor differential of the lifted target family complex. -/
theorem familyBaseChangeTargetComplex_d_succ (a : I → R) (n : ℕ) :
    (familyBaseChangeTargetComplex R S a).d (n + 1) n =
      ModuleCat.ofHom
        (ULift.moduleEquiv.symm.toLinearMap.comp
          ((differential S (I → S)
            (familyFunctional S (mappedFamily R S a)) n).comp
              ULift.moduleEquiv.toLinearMap)) := by
  unfold familyBaseChangeTargetComplex
  change (ModuleCat.uliftFunctor.{u, max v w} S).map
      ((complex S (I → S)
        (familyFunctional S (mappedFamily R S a))).d (n + 1) n) = _
  rw [complex_d_succ, ModuleCat.uliftFunctor_map]
  rfl

/-- Degreewise finite-family exterior base-change equivalence, including the
standard-module comparison and universe lift. -/
@[no_expose]
def familyBaseChangeComponentEquiv (n : ℕ) :
    S ⊗[R] (⋀[R]^n (I → R)) ≃ₗ[S]
      ULift.{u, max v w} (⋀[S]^n (I → S)) :=
  ((exteriorPower.baseChangeEquiv R S (I → R) n).trans
    (exteriorPower.mapEquiv S (S ⊗[R] (I → R)) n
      (familyModuleBaseChangeEquiv R S (I := I)))).trans
        ULift.moduleEquiv.symm

@[simp]
theorem familyBaseChangeComponentEquiv_apply_tmul_ιMulti
    (n : ℕ) (s : S) (b : Fin n → (I → R)) :
    familyBaseChangeComponentEquiv R S (I := I) n
        (s ⊗ₜ[R] exteriorPower.ιMulti R n b) =
      ULift.up (s • exteriorPower.ιMulti S n
        (fun k i => algebraMap R S (b k i))) := by
  rw [familyBaseChangeComponentEquiv, LinearEquiv.trans_apply,
    LinearEquiv.trans_apply,
    exteriorPower.baseChangeEquiv_apply_tmul_ιMulti,
    map_smul, exteriorPower.mapEquiv_apply_ιMulti]
  apply ULift.down_injective
  change s • exteriorPower.ιMulti S n
      ((familyModuleBaseChangeEquiv R S (I := I)) ∘
        fun k => (1 : S) ⊗ₜ[R] b k) =
    s • exteriorPower.ιMulti S n
      (fun k i => algebraMap R S (b k i))
  congr 2
  funext k i
  simp [familyModuleBaseChangeEquiv,
    familyModuleBaseChangeAlgEquiv_tmul]

private theorem familyBaseChangeComponentEquiv_down (n : ℕ) :
    ULift.moduleEquiv.toLinearMap.comp
        (familyBaseChangeComponentEquiv R S (I := I) n).toLinearMap =
      (exteriorPower.map n
        (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap).comp
        (exteriorPower.baseChangeMap R S (I → R) n) := by
  classical
  apply TensorProduct.AlgebraTensorModule.curry_injective
  apply LinearMap.ext
  intro s
  apply exteriorPower.linearMap_ext
    (R := R) (n := n) (M := I → R) (N := ⋀[S]^n (I → S))
  apply AlternatingMap.ext
  intro b
  change (familyBaseChangeComponentEquiv R S (I := I) n
      (s ⊗ₜ[R] exteriorPower.ιMulti R n b)).down =
    exteriorPower.map n
      (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap
        (exteriorPower.baseChangeMap R S (I → R) n
          (s ⊗ₜ[R] exteriorPower.ιMulti R n b))
  rw [familyBaseChangeComponentEquiv_apply_tmul_ιMulti,
    exteriorPower.baseChangeMap_apply_tmul_ιMulti,
    map_smul, exteriorPower.map_apply_ιMulti]
  apply congrArg (fun t => s • t)
  apply congrArg (exteriorPower.ιMulti S n)
  funext k i
  simp [familyModuleBaseChangeEquiv,
    familyModuleBaseChangeAlgEquiv_tmul]

private theorem family_differential_baseChange_lifted
    (a : I → R) (n : ℕ) :
    (ULift.moduleEquiv.symm.toLinearMap.comp
        ((differential S (I → S)
          (familyFunctional S (mappedFamily R S a)) n).comp
            ULift.moduleEquiv.toLinearMap)).comp
      (familyBaseChangeComponentEquiv R S (I := I) (n + 1)).toLinearMap =
    (familyBaseChangeComponentEquiv R S (I := I) n).toLinearMap.comp
      ((differential R (I → R) (familyFunctional R a) n).baseChange S) := by
  classical
  apply LinearMap.ext
  intro q
  apply ULift.down_injective
  change differential S (I → S)
      (familyFunctional S (mappedFamily R S a)) n
      (familyBaseChangeComponentEquiv R S (I := I) (n + 1) q).down =
    (familyBaseChangeComponentEquiv R S (I := I) n
      (((differential R (I → R) (familyFunctional R a) n).baseChange S) q)).down
  have hnext :
      (familyBaseChangeComponentEquiv R S (I := I) (n + 1) q).down =
        exteriorPower.map (n + 1)
          (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap
            (exteriorPower.baseChangeMap R S (I → R) (n + 1) q) :=
    LinearMap.congr_fun
      (familyBaseChangeComponentEquiv_down R S (I := I) (n + 1)) q
  have hn :
      (familyBaseChangeComponentEquiv R S (I := I) n
        (((differential R (I → R) (familyFunctional R a) n).baseChange S) q)).down =
        exteriorPower.map n
          (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap
            (exteriorPower.baseChangeMap R S (I → R) n
              (((differential R (I → R)
                (familyFunctional R a) n).baseChange S) q)) :=
    LinearMap.congr_fun
      (familyBaseChangeComponentEquiv_down R S (I := I) n)
      (((differential R (I → R) (familyFunctional R a) n).baseChange S) q)
  rw [hnext, hn]
  calc
    _ = exteriorPower.map n
          (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap
        (differential S (S ⊗[R] (I → R))
          (baseChangeFunctional R S (I → R) (familyFunctional R a)) n
            (exteriorPower.baseChangeMap R S (I → R) (n + 1) q)) := by
          have hnat := differential_naturality S (S ⊗[R] (I → R))
            (baseChangeFunctional R S (I → R) (familyFunctional R a))
            (familyFunctional S (mappedFamily R S a))
            (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap
            (familyFunctional_baseChange R S a) n
          exact LinearMap.congr_fun hnat
            (exteriorPower.baseChangeMap R S (I → R) (n + 1) q)
    _ = _ := by
      exact congrArg
        (fun t => exteriorPower.map n
          (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap t)
        (LinearMap.congr_fun
          (differential_baseChange R S (I → R) (familyFunctional R a) n) q)

/-- The degreewise module isomorphism underlying `familyBaseChangeIso`. -/
@[no_expose]
def familyBaseChangeComponentIso (a : I → R) (n : ℕ) :
    (baseChangeComplex R S (I → R) (familyFunctional R a)).X n ≅
      (familyBaseChangeTargetComplex R S a).X n :=
  eqToIso (baseChangeComplex_X R S (I → R) (familyFunctional R a) n) ≪≫
    (familyBaseChangeComponentEquiv R S (I := I) n).toModuleIso ≪≫
      eqToIso (familyBaseChangeTargetComplex_X R S a n).symm

/-- The scalar extension of a finite-family Koszul complex is isomorphic to
the universe-lifted Koszul complex of the mapped family. -/
@[no_expose]
def familyBaseChangeIso (a : I → R) :
    baseChangeComplex R S (I → R) (familyFunctional R a) ≅
      familyBaseChangeTargetComplex R S a :=
  HomologicalComplex.Hom.isoOfComponents
    (familyBaseChangeComponentIso R S a)
    (fun i j hij => by
      change j + 1 = i at hij
      subst i
      rw [baseChangeComplex_d_succ,
        familyBaseChangeTargetComplex_d_succ]
      change ModuleCat.ofHom
          (familyBaseChangeComponentEquiv R S (I := I) (j + 1)).toLinearMap ≫
            ModuleCat.ofHom
              (ULift.moduleEquiv.symm.toLinearMap.comp
                ((differential S (I → S)
                  (familyFunctional S (mappedFamily R S a)) j).comp
                    ULift.moduleEquiv.toLinearMap)) =
        ModuleCat.ofHom
            ((differential R (I → R) (familyFunctional R a) j).baseChange S) ≫
          ModuleCat.ofHom
            (familyBaseChangeComponentEquiv R S (I := I) j).toLinearMap
      rw [← ModuleCat.ofHom_comp, ← ModuleCat.ofHom_comp]
      exact ModuleCat.hom_ext
        (family_differential_baseChange_lifted R S a j))

/-- The forward component of `familyBaseChangeIso` is the reviewed
degreewise component isomorphism. -/
theorem familyBaseChangeIso_hom_f (a : I → R) (n : ℕ) :
    (familyBaseChangeIso R S a).hom.f n =
      (familyBaseChangeComponentIso R S a n).hom := by
  unfold familyBaseChangeIso
  rfl

/-- Algebra-level scalar extension of the quotient by a finite-family ideal. -/
@[no_expose]
def familyQuotientBaseChangeAlgEquiv (a : I → R) :
    S ⊗[R] (R ⧸ ideal R (I → R) (familyFunctional R a)) ≃ₐ[S]
      S ⧸ ideal S (I → S) (familyFunctional S (mappedFamily R S a)) :=
  (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S
      (ideal R (I → R) (familyFunctional R a))).symm.trans
    (Ideal.quotientEquivAlgOfEq S (familyIdeal_map R S a))

@[simp]
theorem familyQuotientBaseChangeAlgEquiv_tmul_mk (a : I → R)
    (s : S) (r : R) :
    familyQuotientBaseChangeAlgEquiv R S a
        (s ⊗ₜ[R] Ideal.Quotient.mk
          (ideal R (I → R) (familyFunctional R a)) r) =
      Ideal.Quotient.mk
        (ideal S (I → S) (familyFunctional S (mappedFamily R S a)))
        (algebraMap R S r * s) := by
  rw [familyQuotientBaseChangeAlgEquiv, AlgEquiv.trans_apply]
  change Ideal.quotientEquivAlgOfEq S (familyIdeal_map R S a)
      (Ideal.Quotient.mk
        ((ideal R (I → R) (familyFunctional R a)).map (algebraMap R S))
        (r • s)) = _
  rw [Ideal.quotientEquivAlgOfEq_mk, Algebra.smul_def]

/-- Linear view of `familyQuotientBaseChangeAlgEquiv`. -/
def familyQuotientBaseChangeEquiv (a : I → R) :
    S ⊗[R] (R ⧸ ideal R (I → R) (familyFunctional R a)) ≃ₗ[S]
      S ⧸ ideal S (I → S) (familyFunctional S (mappedFamily R S a)) :=
  (familyQuotientBaseChangeAlgEquiv R S a).toLinearEquiv

@[simp]
theorem familyQuotientBaseChangeEquiv_tmul_mk (a : I → R)
    (s : S) (r : R) :
    familyQuotientBaseChangeEquiv R S a
        (s ⊗ₜ[R] Ideal.Quotient.mk
          (ideal R (I → R) (familyFunctional R a)) r) =
      Ideal.Quotient.mk
        (ideal S (I → S) (familyFunctional S (mappedFamily R S a)))
        (algebraMap R S r * s) :=
  familyQuotientBaseChangeAlgEquiv_tmul_mk R S a s r

/-- The raw degree-zero augmentation square for finite-family base change. -/
theorem family_augmentationLinear_baseChange (a : I → R) :
    (familyQuotientBaseChangeEquiv R S a).toLinearMap.comp
        ((augmentationLinear R (I → R)
          (familyFunctional R a)).baseChange S) =
      (augmentationLinear S (I → S)
        (familyFunctional S (mappedFamily R S a))).comp
          ((exteriorPower.map 0
            (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap).comp
              (exteriorPower.baseChangeMap R S (I → R) 0)) := by
  classical
  apply TensorProduct.AlgebraTensorModule.curry_injective
  apply LinearMap.ext
  intro s
  apply exteriorPower.linearMap_ext
    (R := R) (n := 0) (M := I → R)
      (N := S ⧸ ideal S (I → S)
        (familyFunctional S (mappedFamily R S a)))
  apply AlternatingMap.ext
  intro b
  change familyQuotientBaseChangeEquiv R S a
      (((augmentationLinear R (I → R)
        (familyFunctional R a)).baseChange S)
          (s ⊗ₜ[R] exteriorPower.ιMulti R 0 b)) =
    augmentationLinear S (I → S)
      (familyFunctional S (mappedFamily R S a))
        (exteriorPower.map 0
          (familyModuleBaseChangeEquiv R S (I := I)).toLinearMap
            (exteriorPower.baseChangeMap R S (I → R) 0
              (s ⊗ₜ[R] exteriorPower.ιMulti R 0 b)))
  rw [LinearMap.baseChange_tmul, augmentationLinear_apply_ιMulti,
    familyQuotientBaseChangeEquiv_tmul_mk,
    exteriorPower.baseChangeMap_apply_tmul_ιMulti,
    map_smul, exteriorPower.map_apply_ιMulti,
    map_smul, augmentationLinear_apply_ιMulti]
  rw [map_one, one_mul]
  simpa using (Ideal.Quotient.mkₐ S
    (ideal S (I → S) (familyFunctional S (mappedFamily R S a)))).toLinearMap.map_smul s (1 : S)

end KoszulComplex
