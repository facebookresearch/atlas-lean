/-!
# Kolyvagin's derivative operator in the group ring of a cyclic group

Let `R` be a commutative ring and `G` a finite cyclic group of order `ℓ + 1` with generator `σ`,
and write `Tr = ∑_{g ∈ G} g` in the group ring `R[G]`. Then:

* `D⁰ = ∑_{i=1}^{ℓ} i σⁱ` satisfies `(σ - 1) D⁰ = ℓ + 1 - Tr`
  (`MonoidAlgebra.of_sub_one_mul_sum_Icc_smul_pow`);
* the kernel of multiplication by `σ - 1` on `R[G]` is `R · Tr`
  (`MonoidAlgebra.of_sub_one_mul_eq_zero_iff`);
* so the solutions `D` of `(σ - 1) D = ℓ + 1 - Tr` are exactly the elements `D⁰ + c Tr`, `c ∈ R`
  (`MonoidAlgebra.of_sub_one_mul_eq_natCast_sub_sum_iff`).

For `R = ℤ` and `G = G_ℓ = Gal(K_n / K_{n/ℓ})`, this is Gross's equation (3.5) and Kolyvagin's
choice `D⁰_ℓ` of the derivative operator. The statements here allow any commutative ring `R` in
place of `ℤ`, and need no lower bound on `ℓ` (for `ℓ = 0` the group is trivial).

## Proof

Multiplication by `σ` shifts `iσⁱ` to `iσⁱ⁺¹`, so `(σ - 1) D⁰` telescopes to
`(ℓ + 1) σ^{ℓ+1} - ∑_{i=1}^{ℓ+1} σⁱ = ℓ + 1 - Tr`, using `σ^{ℓ+1} = 1` and that
`i ↦ σⁱ` is a bijection from `{0, …, ℓ}` onto `G`. An element `x` with `σ x = x` has coefficients
invariant under left translation by `σ`, hence constant on `G = ⟨σ⟩`, so `x = x(1) · Tr`.

## References

* B. H. Gross, *Kolyvagin's work on modular elliptic curves*, in *L-functions and arithmetic*
  (Durham, 1989), London Math. Soc. Lecture Note Ser. 153, Cambridge Univ. Press, 1991,
  235–256: (3.5) and the text around it, pp. 239–240.
-/

@[expose] public section

open Finset

namespace MonoidAlgebra

variable {R : Type*} [CommRing R] {G : Type*} [Group G] [Fintype G]

private theorem coeff_sum_of_apply (g : G) : (∑ h : G, of R G h).coeff g = 1 := by
  rw [coeff_sum, Finsupp.finsetSum_apply]
  simp [of_apply, coeff_single]

private theorem of_mul_sum_of (σ : G) : of R G σ * ∑ h : G, of R G h = ∑ h : G, of R G h := by
  rw [Finset.mul_sum]
  simp_rw [← map_mul]
  exact Fintype.sum_equiv (Equiv.mulLeft σ) _ _ fun _ => rfl

/-- **The kernel of `σ - 1` on the group ring of a cyclic group.** Let `R` be a commutative ring
and `G` a finite group generated by `σ`. An element `x` of the group ring `R[G]` satisfies
`(σ - 1) x = 0` if and only if `x = c • ∑_{g ∈ G} g` for some `c ∈ R`. -/
theorem of_sub_one_mul_eq_zero_iff {σ : G} (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ)
    (x : MonoidAlgebra R G) :
    (of R G σ - 1) * x = 0 ↔ ∃ c : R, x = c • ∑ g : G, of R G g := by
  constructor
  · intro hx
    have h1 : of R G σ * x = x := by
      rwa [sub_mul, one_mul, sub_eq_zero] at hx
    have hfix : ∀ g, x.coeff (σ⁻¹ * g) = x.coeff g := by
      intro g
      have := congrArg (fun y => y.coeff g) h1
      simpa [of_apply, coeff_single_mul_apply] using this
    have hpow : ∀ (k : ℤ) (g : G), x.coeff (σ ^ k * g) = x.coeff g := by
      intro k
      induction k using Int.induction_on with
      | zero => simp
      | succ k ih =>
        intro g
        rw [zpow_add_one, mul_assoc, ih, ← hfix (σ * g), inv_mul_cancel_left]
      | pred k ih =>
        intro g
        rw [zpow_sub_one, mul_assoc, ih, hfix]
    refine ⟨x.coeff 1, MonoidAlgebra.ext (Finsupp.ext fun g => ?_)⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hσ g)
    rw [coeff_smul, Finsupp.smul_apply, coeff_sum_of_apply, smul_eq_mul, mul_one,
      ← hpow k 1, mul_one]
  · rintro ⟨c, rfl⟩
    rw [mul_smul_comm, sub_mul, one_mul, of_mul_sum_of, sub_self, smul_zero]

/-- **Kolyvagin's derivative operator.** Let `R` be a commutative ring and `G` a finite group of
order `ℓ + 1` generated by `σ`. In the group ring `R[G]`, the element
`D⁰ = ∑_{i=1}^{ℓ} i σⁱ` satisfies `(σ - 1) D⁰ = ℓ + 1 - ∑_{g ∈ G} g`. -/
theorem of_sub_one_mul_sum_Icc_smul_pow {σ : G} (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ) {ℓ : ℕ}
    (hG : Fintype.card G = ℓ + 1) :
    (of R G σ - 1) * ∑ i ∈ Icc 1 ℓ, (i : R) • of R G (σ ^ i) =
      ((ℓ + 1 : ℕ) : MonoidAlgebra R G) - ∑ g : G, of R G g := by
  have hord : orderOf σ = ℓ + 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hσ, Nat.card_eq_fintype_card, hG]
  have hpow : σ ^ (ℓ + 1) = 1 := hord ▸ pow_orderOf_eq_one σ
  set a : ℕ → MonoidAlgebra R G := fun i => of R G (σ ^ i) with ha
  have hTr : ∑ g : G, of R G g = ∑ i ∈ range (ℓ + 1), a i := by
    have hinj : Function.Injective (fun i : Fin (ℓ + 1) => σ ^ (i : ℕ)) := by
      intro i j hij
      exact Fin.ext (pow_injOn_Iio_orderOf (by rw [Set.mem_Iio, hord]; exact i.2)
        (by rw [Set.mem_Iio, hord]; exact j.2) hij)
    have hbij := (Fintype.bijective_iff_injective_and_card _).mpr ⟨hinj, by simp [hG]⟩
    rw [← Fin.sum_univ_eq_sum_range a (ℓ + 1)]
    exact (Fintype.sum_bijective _ hbij _ _ fun _ => rfl).symm
  have hD : ∑ i ∈ Icc 1 ℓ, (i : R) • a i = ∑ i ∈ range (ℓ + 1), (i : R) • a i := by
    rw [Finset.sum_range_succ', Nat.cast_zero, zero_smul, add_zero,
      ← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel]
    exact Finset.sum_congr rfl fun i _ => by rw [add_comm]
  have hshift : ∀ i, of R G σ * a i = a (i + 1) := fun i => by
    rw [ha, ← map_mul, ← pow_succ']
  have key : ∀ i : ℕ, (of R G σ - 1) * ((i : R) • a i) =
      ((((i + 1 : ℕ) : R) • a (i + 1)) - (i : R) • a i) - a (i + 1) := fun i => by
    rw [mul_smul_comm, sub_mul, one_mul, hshift, Nat.cast_add, Nat.cast_one, add_smul, one_smul,
      smul_sub]
    abel
  have hsum : ∑ i ∈ range (ℓ + 1), a (i + 1) = ∑ i ∈ range (ℓ + 1), a i := by
    have h1 := Finset.sum_range_succ' a (ℓ + 1)
    have h2 := Finset.sum_range_succ a (ℓ + 1)
    have hlast : a (ℓ + 1) = a 0 := by simp only [ha, hpow, pow_zero]
    rw [hlast] at h2
    exact add_right_cancel (h1.symm.trans h2)
  change (of R G σ - 1) * ∑ i ∈ Icc 1 ℓ, (i : R) • a i = _
  rw [hD, Finset.mul_sum, Finset.sum_congr rfl fun i _ => key i, Finset.sum_sub_distrib,
    Finset.sum_range_sub (fun i => ((i : ℕ) : R) • a i), hsum, ← hTr]
  congr 1
  rw [Nat.cast_zero, zero_smul, sub_zero, ha]
  simp only [hpow, map_one]
  rw [Nat.cast_smul_eq_nsmul, nsmul_one]

/-- **The solutions of Kolyvagin's equation `(σ - 1) D = ℓ + 1 - Tr`.** Let `R` be a commutative
ring and `G` a finite group of order `ℓ + 1` generated by `σ`, and `Tr = ∑_{g ∈ G} g`. An element
`D` of the group ring `R[G]` satisfies `(σ - 1) D = ℓ + 1 - Tr` if and only if
`D = ∑_{i=1}^{ℓ} i σⁱ + c • Tr` for some `c ∈ R`. -/
theorem of_sub_one_mul_eq_natCast_sub_sum_iff {σ : G} (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ)
    {ℓ : ℕ} (hG : Fintype.card G = ℓ + 1) (D : MonoidAlgebra R G) :
    (of R G σ - 1) * D = ((ℓ + 1 : ℕ) : MonoidAlgebra R G) - ∑ g : G, of R G g ↔
      ∃ c : R, D = ∑ i ∈ Icc 1 ℓ, (i : R) • of R G (σ ^ i) + c • ∑ g : G, of R G g := by
  rw [← of_sub_one_mul_sum_Icc_smul_pow hσ hG, ← sub_eq_zero, ← mul_sub,
    of_sub_one_mul_eq_zero_iff hσ]
  simp_rw [sub_eq_iff_eq_add']

end MonoidAlgebra

end
