module

public import MathlibExt.Algebra.Category.FGModuleCat.RestrictScalars
public import MathlibExt.Algebra.Category.ModuleCat.Prod.Embeddings

/-!
# Product ring embeddings for `FGModuleCat`

Embedding functors `FGModuleCat R ⥤ FGModuleCat (R × S)` and
`FGModuleCat S ⥤ FGModuleCat (R × S)` via restriction of scalars along
`RingHom.fst` and `RingHom.snd`. Shows `fst` and `snd` are of finite
restriction, gives additive instances, simp lemmas for objects, maps,
underlying `ModuleCat` objects, and pointwise evaluation, plus
comparison isomorphisms after forgetting to `ModuleCat`.
-/

@[expose] public section

open CategoryTheory

universe u v

namespace RingHom

variable {R S : Type u} [Ring R] [Ring S]

/-- `fst : R × S →+* R` is of finite restriction: `R` is cyclic over `R × S`
via `(r,s) • x = r * x`, generated by `1`. -/
theorem isFinite_fst : IsFinite (fst R S) := by
  unfold IsFinite
  let : Module (R × S) R := (fst R S).toModule
  let f : (R × S) →ₗ[R × S] R :=
    { toFun := Prod.fst
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hSurj : Function.Surjective f := by
    intro y
    exact ⟨(y, 0), rfl⟩
  exact Module.Finite.of_surjective f hSurj

/-- `snd : R × S →+* S` is of finite restriction: `S` is cyclic over `R × S`
via `(r,s) • y = s * y`, generated by `1`. -/
theorem isFinite_snd : IsFinite (snd R S) := by
  unfold IsFinite
  let : Module (R × S) S := (snd R S).toModule
  let f : (R × S) →ₗ[R × S] S :=
    { toFun := Prod.snd
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hSurj : Function.Surjective f := by
    intro y
    exact ⟨(0, y), rfl⟩
  exact Module.Finite.of_surjective f hSurj

end RingHom

namespace FGModuleCat

variable (R S : Type u) [Ring R] [Ring S]

/-- Embedding `FGModuleCat R ⥤ FGModuleCat (R × S)` via `RingHom.fst`.

An `R`-module `M` is regarded as an `(R × S)`-module by `(r,s) • m = r • m`.
This is `restrictScalars` along `fst`, using that `fst` is finite. -/
noncomputable abbrev prodEmbeddingFst : FGModuleCat.{u} R ⥤ FGModuleCat.{u} (R × S) :=
  restrictScalars (RingHom.fst R S) (RingHom.isFinite_fst)

/-- Embedding `FGModuleCat S ⥤ FGModuleCat (R × S)` via `RingHom.snd`.

An `S`-module `M` is regarded as an `(R × S)`-module by `(r,s) • m = s • m`.
This is `restrictScalars` along `snd`, using that `snd` is finite. -/
noncomputable abbrev prodEmbeddingSnd : FGModuleCat.{u} S ⥤ FGModuleCat.{u} (R × S) :=
  restrictScalars (RingHom.snd R S) (RingHom.isFinite_snd)

/-- Additivity of `prodEmbeddingFst`. -/
instance prodEmbeddingFst_additive : (prodEmbeddingFst R S).Additive :=
  inferInstance

/-- Additivity of `prodEmbeddingSnd`. -/
instance prodEmbeddingSnd_additive : (prodEmbeddingSnd R S).Additive :=
  inferInstance

/-- Object formula for `prodEmbeddingFst`. -/
@[simp]
theorem prodEmbeddingFst_obj (M : FGModuleCat.{u} R) :
    (prodEmbeddingFst R S).obj M = (restrictScalars (RingHom.fst R S) RingHom.isFinite_fst).obj M :=
  rfl

/-- Object formula for `prodEmbeddingSnd`. -/
@[simp]
theorem prodEmbeddingSnd_obj (M : FGModuleCat.{u} S) :
    (prodEmbeddingSnd R S).obj M = (restrictScalars (RingHom.snd R S) RingHom.isFinite_snd).obj M :=
  rfl

/-- Morphism formula for `prodEmbeddingFst`. -/
@[simp]
theorem prodEmbeddingFst_map {M N : FGModuleCat.{u} R} (f : M ⟶ N) :
    (prodEmbeddingFst R S).map f =
      (restrictScalars (RingHom.fst R S) RingHom.isFinite_fst).map f :=
  rfl

/-- Morphism formula for `prodEmbeddingSnd`. -/
@[simp]
theorem prodEmbeddingSnd_map {M N : FGModuleCat.{u} S} (f : M ⟶ N) :
    (prodEmbeddingSnd R S).map f =
      (restrictScalars (RingHom.snd R S) RingHom.isFinite_snd).map f :=
  rfl

/-- Underlying `ModuleCat` object formula for `prodEmbeddingFst`. -/
@[simp]
theorem prodEmbeddingFst_obj_obj (M : FGModuleCat.{u} R) :
    ((prodEmbeddingFst R S).obj M).obj =
      (ModuleCat.prodEmbeddingFst R S).obj M.obj :=
  rfl

/-- Underlying `ModuleCat` object formula for `prodEmbeddingSnd`. -/
@[simp]
theorem prodEmbeddingSnd_obj_obj (M : FGModuleCat.{u} S) :
    ((prodEmbeddingSnd R S).obj M).obj =
      (ModuleCat.prodEmbeddingSnd R S).obj M.obj :=
  rfl

/-- Underlying `ModuleCat` morphism formula for `prodEmbeddingFst`. -/
@[simp]
theorem prodEmbeddingFst_map_hom {M N : FGModuleCat.{u} R} (f : M ⟶ N) :
    ((prodEmbeddingFst R S).map f).hom =
      (ModuleCat.prodEmbeddingFst R S).map f.hom :=
  rfl

/-- Underlying `ModuleCat` morphism formula for `prodEmbeddingSnd`. -/
@[simp]
theorem prodEmbeddingSnd_map_hom {M N : FGModuleCat.{u} S} (f : M ⟶ N) :
    ((prodEmbeddingSnd R S).map f).hom =
      (ModuleCat.prodEmbeddingSnd R S).map f.hom :=
  rfl

/-- Scalar action for `prodEmbeddingFst` uses the first projection. -/
theorem prodEmbeddingFst_smul_def {M : FGModuleCat.{u} R}
    (p : R × S) (m : (prodEmbeddingFst R S).obj M) :
    p • m = p.1 • (show M from m) :=
  rfl

/-- Scalar action for `prodEmbeddingSnd` uses the second projection. -/
theorem prodEmbeddingSnd_smul_def {M : FGModuleCat.{u} S}
    (p : R × S) (m : (prodEmbeddingSnd R S).obj M) :
    p • m = p.2 • (show M from m) :=
  rfl

/-- Pointwise morphism formula for `prodEmbeddingFst`. -/
theorem prodEmbeddingFst_map_apply {M N : FGModuleCat.{u} R}
    (f : M ⟶ N) (x : M) :
    (prodEmbeddingFst R S).map f x = f x :=
  rfl

/-- Pointwise morphism formula for `prodEmbeddingSnd`. -/
theorem prodEmbeddingSnd_map_apply {M N : FGModuleCat.{u} S}
    (f : M ⟶ N) (x : M) :
    (prodEmbeddingSnd R S).map f x = f x :=
  rfl

/-- Comparison iso after forgetting: `FG` embedding via `fst` aligns with `ModuleCat`. -/
noncomputable def prodEmbeddingFstCompForget₂Iso :
    prodEmbeddingFst R S ⋙ forget₂ (FGModuleCat.{u} (R × S)) (ModuleCat.{u} (R × S)) ≅
      forget₂ (FGModuleCat.{u} R) (ModuleCat.{u} R) ⋙ ModuleCat.prodEmbeddingFst R S :=
  restrictScalarsCompForget₂Iso (RingHom.fst R S) (RingHom.isFinite_fst)

/-- Comparison iso after forgetting: `FG` embedding via `snd` aligns with `ModuleCat`. -/
noncomputable def prodEmbeddingSndCompForget₂Iso :
    prodEmbeddingSnd R S ⋙ forget₂ (FGModuleCat.{u} (R × S)) (ModuleCat.{u} (R × S)) ≅
      forget₂ (FGModuleCat.{u} S) (ModuleCat.{u} S) ⋙ ModuleCat.prodEmbeddingSnd R S :=
  restrictScalarsCompForget₂Iso (RingHom.snd R S) (RingHom.isFinite_snd)

end FGModuleCat
