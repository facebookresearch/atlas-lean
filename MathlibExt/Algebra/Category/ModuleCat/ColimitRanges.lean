module

public import Mathlib.Algebra.Category.ModuleCat.Colimits
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Colimit legs span the module colimit

Let R be a ring in universe u and D:J→ModuleCat_v(R) a diagram, with independent object and
morphism universes for J. For a colimit cocone c with legs ι_j:D(j)→c.pt, the supremum of their
R-linear ranges is the whole module c.pt.

The submodule supremum therefore expresses every colimit element as a finite sum of source-leg
images. This holds for arbitrary diagram shapes, including the empty shape. Quotienting by that
supremum kills every leg, and the colimit universal property makes the quotient map zero.
-/

@[expose] public section
noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace ModuleCat

universe u v uJ vJ

variable {R : Type u} [Ring R] {J : Type uJ} [Category.{vJ} J]
  {D : J ⥤ ModuleCat.{v} R} {c : Cocone D}

/-- Let R be a ring in universe u, J a category with independent object and morphism universes
uJ,vJ, and D:J→ModuleCat_v(R). For a cocone c and j∈J, its leg ι_j:D(j)→c.pt has the same
underlying R-linear map D(j)→c.pt. No colimit assumption is needed to define this map. -/
abbrev colimitLegLinearMap (c : Cocone D) (j : J) : D.obj j →ₗ[R] c.pt := (c.ι.app j).hom

/-- Let R be a ring in universe u, J a category in object and morphism universes uJ,vJ, and
D:J→ModuleCat_v(R). If c is a colimit cocone with legs ι_j, then ⋁_{j∈J}im_R(ι_j)=⊤ as
submodules of c.pt. Every colimit element is therefore in the R-submodule generated by all
source-leg images. -/
lemma IsColimit.iSup_range_eq_top (h : IsColimit c) :
    (⨆ j : J, LinearMap.range (colimitLegLinearMap c j)) = ⊤ := by
  let S : Submodule R c.pt := ⨆ j : J, LinearMap.range (colimitLegLinearMap c j)
  let Q := ModuleCat.of R (c.pt ⧸ S)
  let q : c.pt ⟶ Q := ModuleCat.ofHom S.mkQ
  have hq : q = 0 := h.hom_ext (fun j => by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change S.mkQ ((c.ι.app j).hom x) = 0
    exact (Submodule.Quotient.mk_eq_zero S).2
      ((le_iSup (fun k : J => LinearMap.range (colimitLegLinearMap c k)) j) ⟨x, rfl⟩))
  apply top_unique
  intro x _
  have hx : S.mkQ x = 0 := by
    have e := congrArg (fun f : c.pt ⟶ Q => f.hom x) hq
    exact e
  exact (Submodule.Quotient.mk_eq_zero S).1 hx

end ModuleCat
