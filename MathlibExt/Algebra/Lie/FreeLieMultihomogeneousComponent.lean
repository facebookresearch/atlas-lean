module

public import Mathlib.Algebra.Lie.Free

@[expose] public section

namespace MetaMathlibExt

variable (K : Type) [Field K] {r : ℕ}

/-- **Free Lie monomials.** Let $K$ be a field, $r$ a natural number, and $L$ the free Lie algebra
over $K$ on generators $x_0, \dots, x_{r-1}$. The relation "$x$ is a homogeneous Lie monomial of
multidegree $d$", for $d \in \mathbb{N}^r$ and $x \in L$, is defined inductively: each generator
$x_i$ is a monomial of multidegree $e_i$, which is $1$ at $i$ and $0$ elsewhere; and if $x$ is a
monomial of multidegree $a$ and $y$ is a monomial of multidegree $b$, then the bracket $[x, y]$
is a monomial of multidegree $a + b$, computed pointwise. There are no other monomials. -/
inductive IsFreeLieMonomial : (Fin r → ℕ) → FreeLieAlgebra K (Fin r) → Prop where
  | gen (i : Fin r) :
      IsFreeLieMonomial (Function.update (fun _ => 0) i 1) (FreeLieAlgebra.of K i)
  | bracket {a b : Fin r → ℕ} {x y : FreeLieAlgebra K (Fin r)} :
      IsFreeLieMonomial a x → IsFreeLieMonomial b y →
        IsFreeLieMonomial (fun i => a i + b i) (Bracket.bracket x y)

/-- **Multihomogeneous components of a free Lie algebra.** Let $K$ be a field, $r$ a natural
number, and $L$ the free Lie algebra over $K$ on generators $x_0, \dots, x_{r-1}$. For a
multidegree $d \in \mathbb{N}^r$, the multihomogeneous component of $L$ of multidegree $d$ is the
$K$-linear span of the homogeneous Lie monomials of multidegree $d$, that is, of the iterated
brackets of the generators in which each $x_i$ occurs exactly $d_i$ times.

These components distinguish multidegrees, not only the total bracket length.

Source: Pieter Moree, *Convoluted Convolved Fibonacci Numbers*, Journal of
Integer Sequences 7 (2004), Article 04.2.2, Witt's formula paragraph (the
subspace `H` generated by homogeneous elements of multidegree
`(n₁, …, nᵣ)`), lines 621–628,
<https://cs.uwaterloo.ca/journals/JIS/VOL7/Moree/moree12.tex>. -/
noncomputable def freeLieMultihomogeneousComponent (degree : Fin r → ℕ) :
    Submodule K (FreeLieAlgebra K (Fin r)) :=
  Submodule.span K { x | IsFreeLieMonomial K degree x }

end MetaMathlibExt
