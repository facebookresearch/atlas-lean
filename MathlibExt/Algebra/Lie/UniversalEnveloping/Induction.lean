module

public import Mathlib.Algebra.Lie.UniversalEnveloping

/-!
# Induction by scalars and Lie generators in a universal enveloping algebra

Let R be a commutative ring and L an R-Lie algebra. The enveloping
algebra U_R(L) is generated by the scalar image of R and the Lie image
ι(L), under multiplication and addition.

Consequently a proposition about elements of U_R(L) holds everywhere
if it holds on all scalar elements and all Lie generators and is
closed under products and sums. The statement applies to arbitrary
R-Lie algebras, with independent ring and Lie-carrier universes.
-/

@[expose] public section

universe u v

namespace UniversalEnvelopingAlgebra

variable (R : Type u) [CommRing R]
  (L : Type v) [LieRing L] [LieAlgebra R L]

/-- For a commutative ring R, an R-Lie algebra L and a predicate
C on U_R(L), assume C(algebraMap(r)) for every r ∈ R,
C(ι(x)) for every x ∈ L, and that C(a),C(b) imply both C(ab)
and C(a+b). Then C(a) holds for every a ∈ U_R(L).
The ring and Lie-carrier worlds are independent. -/
@[elab_as_elim]
theorem induction {C : UniversalEnvelopingAlgebra R L → Prop}
    (algebraMap : ∀ r : R, C (algebraMap R (UniversalEnvelopingAlgebra R L) r))
    (ι : ∀ x : L, C (UniversalEnvelopingAlgebra.ι R x))
    (mul : ∀ a b, C a → C b → C (a * b))
    (add : ∀ a b, C a → C b → C (a + b))
    (a : UniversalEnvelopingAlgebra R L) : C a := by
  have hsurj : Function.Surjective (mkAlgHom R L) :=
    RingCon.mkₐ_surjective (α := R) (UniversalEnvelopingAlgebra.ringCon R L)
  obtain ⟨t, rfl⟩ := hsurj a
  induction t using TensorAlgebra.induction with
  | algebraMap r =>
      rw [(mkAlgHom R L).commutes]
      exact algebraMap r
  | ι x => exact ι x
  | mul t s ht hs =>
      rw [map_mul]
      exact mul _ _ ht hs
  | add t s ht hs =>
      rw [map_add]
      exact add _ _ ht hs

end UniversalEnvelopingAlgebra
