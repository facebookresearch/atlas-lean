module

public import Mathlib.RingTheory.Ideal.Span
public import MathlibExt.Algebra.DeepPowerSumCongruences.DividedPowerIdeal

import Mathlib.Data.Nat.Choose.Dvd
import Mathlib.Data.Nat.Choose.Sum
import Mathlib.RingTheory.Ideal.BigOperators
import Mathlib.RingTheory.Ideal.Operations

/-!
# A factorial-divisibility criterion for a generated ideal

The predicate `IsDividedPowerIdeal` says that for every `x` in the ideal and every positive `n`,
`x ^ n` is `n!` times an element of the ideal. The criterion does not require torsion-freeness.
When multiplication by `n!` has a nontrivial kernel on the ideal, such witnesses need not be
unique, and the result does not construct a compatible `DividedPowers` structure.

## References

- Samuele Anni, Alexandru Ghitza and Anna Medvedovsky, *Elementary Symmetric Functions and Deep
  Power-Sum Congruences*, INTEGERS 24 (2024), Article A46, pp. 1–26, Proposition 5.
  The proof uses their prime-power criterion (Corollary 4).
-/

namespace MetaMathlibExt

/-- **Divided-power ideals generated by a set.** Let $p$ be a prime and $A$ a commutative ring in
which every natural number not divisible by $p$ is a unit (a $\mathbb{Z}_{(p)}$-algebra). For a
subset $S \subseteq A$, the ideal $\mathfrak{a}$ generated by $S$ is a divided-power ideal if and
only if for every $a \in S$ there is $c \in \mathfrak{a}$ with $a^p = pc$, that is,
$a^p \in p\mathfrak{a}$.

Torsion-freeness of $A$ is not needed for the factorial-divisibility predicate
`IsDividedPowerIdeal`; no `DividedPowers` structure is constructed.

Source: S. Anni, A. Ghitza and A. Medvedovsky, *Elementary Symmetric Functions and Deep Power-Sum
Congruences*, INTEGERS 24 (2024), Article A46, Proposition 5 (`integers-2024-A46-prop-5`). -/
public theorem isDividedPowerIdeal_span_iff {p : ℕ} [Fact p.Prime]
    {A : Type*} [CommRing A] (hA : ∀ n : ℕ, ¬ p ∣ n → IsUnit (n : A)) (S : Set A) :
    IsDividedPowerIdeal (Ideal.span S) ↔ ∀ a ∈ S, ∃ c ∈ Ideal.span S, a ^ p = (p : A) * c := by
  rw [isDividedPowerIdeal_iff_pow_prime_mem hA]
  refine ⟨fun h a ha => h a (Ideal.subset_span ha), ?_⟩
  intro h a ha
  have hp : p.Prime := Fact.out
  let J : Ideal A := Ideal.span {(p : A)} * Ideal.span S
  have mem_J (x : A) : x ∈ J ↔ ∃ c ∈ Ideal.span S, x = (p : A) * c := by
    simp only [J, Ideal.mem_span_singleton_mul, eq_comm]
  apply (mem_J _).mp
  induction ha using Submodule.span_induction with
  | mem x hx => exact (mem_J _).mpr (h x hx)
  | zero => simpa only [zero_pow hp.ne_zero] using J.zero_mem
  | add x y hx _ ihx ihy =>
    rw [add_pow]
    refine J.sum_mem fun k hk => ?_
    by_cases hk0 : k = 0
    · simpa only [hk0, pow_zero, one_mul, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one,
        mul_one] using ihy
    by_cases hkp : k = p
    · simpa only [hkp, Nat.sub_self, pow_zero, Nat.choose_self, Nat.cast_one, mul_one] using ihx
    have hlt : k < p := lt_of_le_of_ne (Nat.le_of_lt_succ (Finset.mem_range.mp hk)) hkp
    obtain ⟨m, hm⟩ := hp.dvd_choose_self hk0 hlt
    -- A mixed term has one factor from (p) and another from the span.
    have hmem : (p : A) * x ^ k ∈ J :=
      Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_singleton _))
        ((Ideal.span S).pow_mem_of_mem hx k (Nat.pos_of_ne_zero hk0))
    have heq : x ^ k * y ^ (p - k) * (p.choose k : A) =
        (y ^ (p - k) * (m : A)) * ((p : A) * x ^ k) := by
      rw [hm, Nat.cast_mul]
      ac_rfl
    exact heq ▸ J.mul_mem_left _ hmem
  | smul r x _ ih =>
    rw [smul_eq_mul, mul_pow]
    exact J.mul_mem_left (r ^ p) ih

end MetaMathlibExt
