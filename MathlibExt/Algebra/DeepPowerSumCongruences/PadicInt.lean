module

public import Mathlib.NumberTheory.Padics.PadicIntegers
public import MathlibExt.Algebra.DeepPowerSumCongruences.DividedPowerIdeal

import Mathlib.RingTheory.DividedPowers.Padic

/-!
# The divided-power ideal of p-adic integers generated by p

## References

- Samuele Anni, Alexandru Ghitza and Anna Medvedovsky, *Elementary Symmetric Functions and Deep
  Power-Sum Congruences*, INTEGERS 24 (2024), Article A46, pp. 1–26, Corollary 8 (last sentence).
- Mathlib, `Mathlib.RingTheory.DividedPowers.Padic`, `PadicInt.dividedPowers`.
-/

namespace MetaMathlibExt

/-- **$(p)$ is a divided-power ideal of $\mathbb{Z}_p$.** For every prime $p$, the ideal generated
by $p$ in the ring $\mathbb{Z}_p$ of $p$-adic integers is a divided-power ideal.

Source: S. Anni, A. Ghitza and A. Medvedovsky, *Elementary Symmetric Functions and Deep Power-Sum
Congruences*, INTEGERS 24 (2024), Article A46, Corollary 8, last sentence
(`integers-2024-A46-cor-8`). -/
public theorem isDividedPowerIdeal_span_prime_padicInt (p : ℕ) [Fact p.Prime] :
    IsDividedPowerIdeal (Ideal.span {(p : ℤ_[p])}) := by
  intro a ha k hk
  let hI := PadicInt.dividedPowers p
  exact ⟨hI.dpow k a, hI.dpow_mem (Nat.ne_of_gt hk) ha, (hI.factorial_mul_dpow_eq_pow ha).symm⟩

end MetaMathlibExt
