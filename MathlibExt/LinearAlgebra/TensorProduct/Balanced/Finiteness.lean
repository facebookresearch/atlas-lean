module

public import MathlibExt.LinearAlgebra.TensorProduct.Balanced
public import Mathlib.LinearAlgebra.TensorProduct.Finiteness

/-!
# Finite expressions in balanced tensor products

Let k be a commutative ring, R a semiring, M a right R-module and
N a left R-module, with both M and N additive commutative groups carrying
k-module structures. All four carrier universes may be independent.
The balanced tensor product is the quotient of M ⊗[k] N by the k-submodule
generated by (m r) ⊗ n - m ⊗ (r n).

Every element of this quotient is a finite sum of ordered pure classes
[m ⊗ n]. This is a statement about individual tensor elements and imposes
no finite-generation condition on either module.
-/

@[expose] public section

open scoped TensorProduct

universe u v w z

namespace TensorProduct.Balanced

variable (k : Type u) (R : Type v) (M : Type w) (N : Type z)
  [CommRing k] [Semiring R] [AddCommGroup M] [AddCommGroup N]
  [Module k M] [Module k N] [Module Rᵐᵒᵖ M] [Module R N]

/-- Let k be a commutative ring, R a semiring, M a right R-module
and N a left R-module, both additive commutative groups with k-module
structures. For every x ∈ M ⊗_R N, formed as the balanced quotient
of M ⊗[k] N, there is a finite set s of pairs (m, n) with
x = ∑_(m,n)∈s [m ⊗ n]. The ring and module universes are independent. -/
theorem exists_finset (x : TensorProduct.Balanced k R M N) :
    ∃ s : Finset (M × N), x = ∑ a ∈ s, mk k R M N a.1 a.2 := by
  classical
  obtain ⟨z, rfl⟩ := (balanceRelations k R M N).mkQ_surjective x
  obtain ⟨s, hs⟩ := TensorProduct.exists_finset z
  refine ⟨s, ?_⟩
  change (balanceRelations k R M N).mkQ z =
    ∑ a ∈ s, (balanceRelations k R M N).mkQ (a.1 ⊗ₜ[k] a.2)
  rw [hs, map_sum]

end TensorProduct.Balanced
