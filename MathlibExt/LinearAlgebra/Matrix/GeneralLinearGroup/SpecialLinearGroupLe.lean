/-!
# Semisimple subgroups of `GL₂(𝔽_ℓ)` of order divisible by `ℓ` contain `SL₂(𝔽_ℓ)`

* `Matrix.GeneralLinearGroup.specialLinearGroup_le_of_dvd_card`: let `G` be a subgroup of
  `GL₂(𝔽_ℓ)` whose order is divisible by `ℓ`, such that every `G`-stable line of `𝔽_ℓ²` has a
  `G`-stable complement. Then `G` contains `SL₂(𝔽_ℓ)`.
* `Matrix.GeneralLinearGroup.mem_closure_transvections`: over any field `F`, every element of
  `SL₂(F)` is a product of the elementary transvections `!![1, x; 0, 1]` and `!![1, 0; x, 1]`,
  the case `n = 2` of the generation of `SL_n(F)` by elementary transvections.

Proof: by Cauchy's theorem `G` has an element `u` of order `ℓ`, and `u - 1` is a nonzero
square-zero matrix (`sub_one_mul_self_eq_zero_of_orderOf_eq`), so `u` is a transvection fixing a
line `D`. If every transvection of `G` fixed `D`, then `D` would be `G`-stable, and `u` would act
trivially on a `G`-stable complement, so `u = 1`. Otherwise two transvections of `G` fix distinct
lines; in a basis of these lines they are `!![1, a; 0, 1]` and `!![1, 0; b, 1]`, and suitable
powers give `!![1, 1; 0, 1]` and `!![1, 0; 1, 1]`, whose powers are all the elementary
transvections.

## References

* A. V. Sutherland, *Computing images of Galois representations attached to elliptic curves*,
  Forum Math. Sigma 4 (2016), e4: Proposition 3.1, p. 10, first sentence.
* P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*, Ann. Sci. École Norm. Sup. (4) 7
  (1974), 507–530: démonstration of Proposition 7.2, p. 524, condition (a).
-/

@[expose] public section

set_option autoImplicit false

open Matrix

namespace Matrix.GeneralLinearGroup

variable {F : Type*} [Field F]

/-- **Upper elementary transvection.** For $x \in F$, the matrix
$\begin{pmatrix} 1 & x \\ 0 & 1 \end{pmatrix}$ of $\mathrm{GL}_2(F)$. -/
def upperTransvection (x : F) : GL (Fin 2) F :=
  mkOfDetNeZero !![1, x; 0, 1] (by simp [Matrix.det_fin_two])

/-- **Lower elementary transvection.** For $x \in F$, the matrix
$\begin{pmatrix} 1 & 0 \\ x & 1 \end{pmatrix}$ of $\mathrm{GL}_2(F)$. -/
def lowerTransvection (x : F) : GL (Fin 2) F :=
  mkOfDetNeZero !![1, 0; x, 1] (by simp [Matrix.det_fin_two])

/-- The matrix of `upperTransvection x`. -/
theorem coe_upperTransvection (x : F) :
    (upperTransvection x : Matrix (Fin 2) (Fin 2) F) = !![1, x; 0, 1] := rfl

/-- The matrix of `lowerTransvection x`. -/
theorem coe_lowerTransvection (x : F) :
    (lowerTransvection x : Matrix (Fin 2) (Fin 2) F) = !![1, 0; x, 1] := rfl

/-- Powers of an upper elementary transvection: the $k$-th power of
$\begin{pmatrix} 1 & x \\ 0 & 1 \end{pmatrix}$ is
$\begin{pmatrix} 1 & kx \\ 0 & 1 \end{pmatrix}$. -/
theorem upperTransvection_pow (x : F) (k : ℕ) :
    upperTransvection x ^ k = upperTransvection (k * x) := by
  induction k with
  | zero =>
    ext i j
    fin_cases i <;> fin_cases j <;> simp [coe_upperTransvection]
  | succ k ih =>
    rw [pow_succ, ih]
    ext i j
    simp only [Units.val_mul, coe_upperTransvection, Matrix.mul_fin_two]
    fin_cases i <;> fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue,
      of_apply, cons_val', cons_val_zero, cons_val_one, cons_val_fin_one] <;> push_cast <;> ring1

/-- Powers of a lower elementary transvection: the $k$-th power of
$\begin{pmatrix} 1 & 0 \\ x & 1 \end{pmatrix}$ is
$\begin{pmatrix} 1 & 0 \\ kx & 1 \end{pmatrix}$. -/
theorem lowerTransvection_pow (x : F) (k : ℕ) :
    lowerTransvection x ^ k = lowerTransvection (k * x) := by
  induction k with
  | zero =>
    ext i j
    fin_cases i <;> fin_cases j <;> simp [coe_lowerTransvection]
  | succ k ih =>
    rw [pow_succ, ih]
    ext i j
    simp only [Units.val_mul, coe_lowerTransvection, Matrix.mul_fin_two]
    fin_cases i <;> fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue,
      of_apply, cons_val', cons_val_zero, cons_val_one, cons_val_fin_one] <;> push_cast <;> ring1

/-- **$\mathrm{SL}_2(F)$ is generated by elementary transvections.** Over a field $F$, a subgroup of
$\mathrm{GL}_2(F)$ containing every $\begin{pmatrix} 1 & x \\ 0 & 1 \end{pmatrix}$ and every
$\begin{pmatrix} 1 & 0 \\ x & 1 \end{pmatrix}$, $x \in F$, contains $\mathrm{SL}_2(F)$. A matrix
$\begin{pmatrix} a & b \\ c & d \end{pmatrix}$ of determinant $1$ with $c \neq 0$ is
$\begin{pmatrix} 1 & (a-1)/c \\ 0 & 1 \end{pmatrix} \begin{pmatrix} 1 & 0 \\ c & 1 \end{pmatrix}
\begin{pmatrix} 1 & (d-1)/c \\ 0 & 1 \end{pmatrix}$; if $c = 0$, multiplying on the left by
$\begin{pmatrix} 1 & 0 \\ 1 & 1 \end{pmatrix}$ makes the lower-left entry $a \neq 0$. This is the
case $n = 2$ of the generation of $\mathrm{SL}_n(F)$ by elementary transvections. -/
theorem mem_closure_transvections (X : SpecialLinearGroup (Fin 2) F) {H : Subgroup (GL (Fin 2) F)}
    (hu : ∀ x : F, upperTransvection x ∈ H) (hl : ∀ x : F, lowerTransvection x ∈ H) :
    SpecialLinearGroup.toGL X ∈ H := by
  have hdet : X 0 0 * X 1 1 - X 0 1 * X 1 0 = 1 := by
    rw [← Matrix.det_fin_two]; exact X.2
  -- a matrix of determinant one with nonzero lower-left entry
  have key : ∀ g : GL (Fin 2) F, (g : Matrix (Fin 2) (Fin 2) F).det = 1 →
      (g : Matrix (Fin 2) (Fin 2) F) 1 0 ≠ 0 → g ∈ H := by
    intro g hg hc
    set M := (g : Matrix (Fin 2) (Fin 2) F)
    have hg' : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by rw [← Matrix.det_fin_two]; exact hg
    have : g = upperTransvection ((M 0 0 - 1) / M 1 0) * lowerTransvection (M 1 0) *
        upperTransvection ((M 1 1 - 1) / M 1 0) := by
      ext i j
      simp only [Units.val_mul, coe_upperTransvection, coe_lowerTransvection, Matrix.mul_fin_two]
      fin_cases i <;> fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue,
        of_apply, cons_val', cons_val_zero, cons_val_one, cons_val_fin_one] <;>
        first | ring1 | (field_simp; ring1) | (field_simp; linear_combination -hg')
    rw [this]
    exact mul_mem (mul_mem (hu _) (hl _)) (hu _)
  by_cases hc : X 1 0 = 0
  · have ha : X 0 0 ≠ 0 := by
      intro ha; rw [ha, hc] at hdet; simp at hdet
    have h1 : lowerTransvection 1 * SpecialLinearGroup.toGL X ∈ H := by
      apply key
      · rw [Units.val_mul, Matrix.det_mul, coe_lowerTransvection, Matrix.det_fin_two_of]
        simp
      · simpa [coe_lowerTransvection, Matrix.mul_apply, Fin.sum_univ_two, hc] using ha
    have : SpecialLinearGroup.toGL X = lowerTransvection (-1) *
        (lowerTransvection 1 * SpecialLinearGroup.toGL X) := by
      rw [← mul_assoc]
      have : lowerTransvection (-1 : F) * lowerTransvection 1 = 1 := by
        ext i j
        simp only [Units.val_mul, coe_lowerTransvection, Matrix.mul_fin_two, Units.val_one]
        fin_cases i <;> fin_cases j <;> simp
      rw [this, one_mul]
    rw [this]
    exact mul_mem (hl _) h1
  · exact key _ X.2 hc


/-- The determinant of the $2 \times 2$ matrix with columns $v$ and $w$ is
$v_0 w_1 - w_0 v_1$. -/
theorem det_cols (v w : Fin 2 → F) :
    (Matrix.of fun i j => ![v, w] j i).det = v 0 * w 1 - w 0 * v 1 := by
  simp [Matrix.det_fin_two]

/-- **Proportional columns.** If $v \neq 0$ and the matrix with columns $v, w \in F^2$ is singular,
then $w = c v$ for some $c \in F$. -/
theorem exists_eq_smul_of_det_cols_eq_zero {v w : Fin 2 → F} (hv : v ≠ 0)
    (h : (Matrix.of fun i j => ![v, w] j i).det = 0) : ∃ c : F, w = c • v := by
  rw [det_cols] at h
  by_cases h0 : v 0 = 0
  · have h1 : v 1 ≠ 0 := by
      intro h1; apply hv; ext i; fin_cases i <;> simp [h0, h1]
    refine ⟨w 1 / v 1, ?_⟩
    have hw0 : w 0 = 0 := by
      rw [h0, zero_mul, zero_sub, neg_eq_zero] at h
      exact (mul_eq_zero.1 h).resolve_right h1
    ext i
    fin_cases i
    · simp [hw0, h0]
    · simp; field_simp
  · refine ⟨w 0 / v 0, ?_⟩
    ext i
    fin_cases i
    · simp; field_simp
    · simp; field_simp; linear_combination h

/-- **The kernel of a nonzero $2 \times 2$ matrix is at most a line.** If $N \in M_2(F)$ is
nonzero, $N v = 0$ with $v \neq 0$ and $N w = 0$, then $w = c v$ for some $c \in F$. -/
theorem exists_eq_smul_of_mulVec_eq_zero {N : Matrix (Fin 2) (Fin 2) F} (hN : N ≠ 0)
    {v w : Fin 2 → F} (hv0 : v ≠ 0) (hv : N *ᵥ v = 0) (hw : N *ᵥ w = 0) :
    ∃ c : F, w = c • v := by
  refine exists_eq_smul_of_det_cols_eq_zero hv0 (by_contra fun hdet => hN ?_)
  have hNV : N * (Matrix.of fun i j => ![v, w] j i) = 0 := by
    ext i j
    fin_cases j
    · simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using
        congrFun hv i
    · simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using
        congrFun hw i
  have hu : IsUnit (Matrix.of fun i j => ![v, w] j i) :=
    (Matrix.isUnit_iff_isUnit_det _).2 (isUnit_iff_ne_zero.2 hdet)
  exact (hu.mul_left_eq_zero).1 hNV

/-- **Square-zero $2 \times 2$ matrices have rank one.** If $N \in M_2(F)$ is nonzero with
$N^2 = 0$, there is $e \neq 0$ with $N e = 0$ such that every $N x$ is a multiple of $e$. -/
theorem exists_forall_mulVec_eq_smul {N : Matrix (Fin 2) (Fin 2) F} (hN : N ≠ 0)
    (hN2 : N * N = 0) :
    ∃ e : Fin 2 → F, e ≠ 0 ∧ N *ᵥ e = 0 ∧ ∀ x, ∃ c : F, N *ᵥ x = c • e := by
  obtain ⟨j, hj⟩ : ∃ j, N *ᵥ Pi.single j 1 ≠ 0 := by
    by_contra! h
    apply hN
    ext i j
    have := congrFun (h j) i
    rwa [Matrix.mulVec_single_one] at this
  have hNe : N *ᵥ (N *ᵥ Pi.single j 1) = 0 := by rw [Matrix.mulVec_mulVec, hN2, Matrix.zero_mulVec]
  refine ⟨_, hj, hNe, fun x => exists_eq_smul_of_mulVec_eq_zero hN hj hNe ?_⟩
  rw [Matrix.mulVec_mulVec, hN2, Matrix.zero_mulVec]


/-- **Elements of order $\ell$ are transvections.** If $g \in \mathrm{GL}_2(\mathbb{F}_\ell)$ has
order $\ell$, then $g - 1$ is nonzero and $(g - 1)^2 = 0$. -/
theorem sub_one_mul_self_eq_zero_of_orderOf_eq {ℓ : ℕ} [Fact ℓ.Prime] {g : GL (Fin 2) (ZMod ℓ)}
    (hg : orderOf g = ℓ) :
    ((g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) * ((g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) = 0 ∧
      (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 ≠ 0 := by
  have hp := (Fact.out : ℓ.Prime)
  set N := (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1
  have hN0 : N ≠ 0 := by
    intro h
    have : g = 1 := Units.ext (sub_eq_zero.1 h)
    rw [this, orderOf_one] at hg
    exact hp.one_lt.ne hg
  have hNl : N ^ ℓ = 0 := by
    have hgl : g ^ ℓ = 1 := by have := pow_orderOf_eq_one g; rwa [hg] at this
    rw [sub_pow_char_of_commute ℓ (Commute.one_right _), one_pow, ← Units.val_pow_eq_pow_val,
      hgl, Units.val_one, sub_self]
  have hdet : N.det = 0 := by
    have := congrArg Matrix.det hNl
    rw [Matrix.det_pow, Matrix.det_zero] at this
    exact pow_eq_zero_iff hp.ne_zero |>.1 this
  -- Cayley–Hamilton: `N * N = tr N • N`
  have hCH : N * N = N.trace • N := by
    have h := N.aeval_self_charpoly
    simp only [Matrix.charpoly_fin_two, sq, map_add, Polynomial.aeval_sub, map_mul,
      Polynomial.aeval_X, Polynomial.aeval_C, Algebra.algebraMap_eq_smul_one, smul_mul_assoc,
      one_mul, hdet, zero_smul, add_zero] at h
    rw [← sub_eq_zero, h]
  have hpow : ∀ k : ℕ, N ^ (k + 1) = N.trace ^ k • N := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ, ih, smul_mul_assoc, hCH, smul_smul, pow_succ]
  have hNl' : N ^ (ℓ - 1 + 1) = 0 := by rw [Nat.sub_add_cancel hp.one_le]; exact hNl
  rw [hpow, smul_eq_zero] at hNl'
  have ht : N.trace = 0 := IsNilpotent.eq_zero ⟨_, hNl'.resolve_right hN0⟩
  exact ⟨by rw [hCH, ht, zero_smul], hN0⟩


/-- Multiplying the matrix with columns $v, w$ on the left by $A$ gives the matrix with columns
$A v, A w$. -/
theorem mul_cols (A : Matrix (Fin 2) (Fin 2) F) (v w : Fin 2 → F) :
    A * (Matrix.of fun i j => ![v, w] j i) = Matrix.of fun i j => ![A *ᵥ v, A *ᵥ w] j i := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The matrix with columns $v, w$ times $\begin{pmatrix} 1 & a \\ 0 & 1 \end{pmatrix}$ has columns
$v, a v + w$. -/
theorem cols_mul_upper (v w : Fin 2 → F) (a : F) :
    (Matrix.of fun i j => ![v, w] j i) * !![1, a; 0, 1] =
      Matrix.of fun i j => ![v, a • v + w] j i := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, mul_comm, add_comm]

/-- The matrix with columns $v, w$ times $\begin{pmatrix} 1 & 0 \\ b & 1 \end{pmatrix}$ has columns
$v + b w, w$. -/
theorem cols_mul_lower (v w : Fin 2 → F) (b : F) :
    (Matrix.of fun i j => ![v, w] j i) * !![1, 0; b, 1] =
      Matrix.of fun i j => ![v + b • w, w] j i := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, mul_comm]

/-- $t v = v + (t - 1) v$. -/
theorem mulVec_eq_add_sub_one (t : Matrix (Fin 2) (Fin 2) F) (v : Fin 2 → F) :
    t *ᵥ v = v + (t - 1) *ᵥ v := by
  rw [Matrix.sub_mulVec, Matrix.one_mulVec, add_sub_cancel]


/-- **Semisimple subgroups of order divisible by $\ell$ contain $\mathrm{SL}_2(\mathbb{F}_\ell)$.**
Let $\ell$ be a prime and $G$ a subgroup of $\mathrm{GL}_2(\mathbb{F}_\ell)$ whose order is
divisible by $\ell$. Suppose that every $G$-stable line $L$ of $\mathbb{F}_\ell^2$ (a
one-dimensional subspace with $g L \subseteq L$ for $g \in G$) has a $G$-stable complement. Then
$\mathrm{SL}_2(\mathbb{F}_\ell) \subseteq G$.

Source: A. V. Sutherland, *Computing images of Galois representations attached to elliptic
curves*, Forum Math. Sigma 4 (2016), e4, Proposition 3.1, p. 10, first sentence
("If G contains an element of order ℓ then G ⊆ B(ℓ) or SL₂(ℓ) ⊆ G"), for odd $\ell$.

Source: P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*,
Ann. Sci. École Norm. Sup. (4) 7 (1974), 507–530,
démonstration of Proposition 7.2, p. 524, condition (a). -/
theorem specialLinearGroup_le_of_dvd_card {ℓ : ℕ} [Fact ℓ.Prime]
    {G : Subgroup (GL (Fin 2) (ZMod ℓ))} (hdvd : ℓ ∣ Nat.card G)
    (hss : ∀ L : Submodule (ZMod ℓ) (Fin 2 → ZMod ℓ), Module.finrank (ZMod ℓ) L = 1 →
      (∀ g ∈ G, ∀ v ∈ L, (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) *ᵥ v ∈ L) →
      ∃ L' : Submodule (ZMod ℓ) (Fin 2 → ZMod ℓ), IsCompl L L' ∧
        ∀ g ∈ G, ∀ v ∈ L', (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) *ᵥ v ∈ L')
    (X : SpecialLinearGroup (Fin 2) (ZMod ℓ)) : SpecialLinearGroup.toGL X ∈ G := by
  classical
  have hp := (Fact.out : ℓ.Prime)
  -- an element `u` of order `ℓ`, a transvection
  obtain ⟨u0, hu0⟩ := exists_prime_orderOf_dvd_card' ℓ hdvd
  set u : GL (Fin 2) (ZMod ℓ) := (u0 : GL (Fin 2) (ZMod ℓ))
  have huG : u ∈ G := u0.2
  obtain ⟨hNu2, hNu0⟩ := sub_one_mul_self_eq_zero_of_orderOf_eq (g := u)
    (by rw [Subgroup.orderOf_coe]; exact hu0)
  set Nu := (u : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 with hNuDef
  obtain ⟨e, he0, hNe, hmul⟩ := exists_forall_mulVec_eq_smul hNu0 hNu2
  -- conjugation of `t - 1`
  have hconjN : ∀ g t : GL (Fin 2) (ZMod ℓ),
      ((g * t * g⁻¹ : GL (Fin 2) (ZMod ℓ)) : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 =
        (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) * ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) *
          ((g⁻¹ : GL (Fin 2) (ZMod ℓ)) : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) := by
    intro g t
    rw [Units.val_mul, Units.val_mul, mul_sub, sub_mul, mul_one, ← Units.val_mul g g⁻¹,
      mul_inv_cancel, Units.val_one]
  by_cases hall : ∀ t ∈ G, (t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 ≠ 0 →
      ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) *
        ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) = 0 →
      ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) *ᵥ e = 0
  · -- all transvections of `G` fix the line of `e`: it is `G`-stable, a contradiction
    exfalso
    set D := Submodule.span (ZMod ℓ) {e}
    have hD : Module.finrank (ZMod ℓ) D = 1 := finrank_span_singleton he0
    have hstab : ∀ g ∈ G, ∀ v ∈ D, (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) *ᵥ v ∈ D := by
      intro g hg v hv
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hv
      rw [Matrix.mulVec_smul]
      refine Submodule.smul_mem _ _ ?_
      set t := g * u * g⁻¹
      have hNt : (t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 =
          (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) * Nu *
          ((g⁻¹ : GL (Fin 2) (ZMod ℓ)) : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) := hconjN g u
      have hNt0 : (t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 ≠ 0 := by
        rw [hNt]
        intro h
        apply hNu0
        have := congrArg (fun M => ((g⁻¹ : GL (Fin 2) (ZMod ℓ)) : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) *
          M * (g : Matrix (Fin 2) (Fin 2) (ZMod ℓ))) h
        simp only [mul_assoc, Units.inv_mul, mul_one, mul_zero, zero_mul] at this
        rwa [← mul_assoc, Units.inv_mul, one_mul] at this
      have hNt2 : ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) *
          ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) = 0 := by
        rw [hNt]
        simp only [mul_assoc]
        rw [← mul_assoc ((g⁻¹ : GL (Fin 2) (ZMod ℓ)) : Matrix (Fin 2) (Fin 2) (ZMod ℓ)),
          Units.inv_mul, one_mul, ← mul_assoc Nu, hNu2, zero_mul, mul_zero]
      have h1 := hall t (mul_mem (mul_mem hg huG) (inv_mem hg)) hNt0 hNt2
      have h2 : ((t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1) *ᵥ
          ((g : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) *ᵥ e) = 0 := by
        rw [hNt, Matrix.mulVec_mulVec, mul_assoc, mul_assoc, Units.inv_mul, mul_one,
          ← Matrix.mulVec_mulVec, hNe, Matrix.mulVec_zero]
      obtain ⟨c, hc⟩ := exists_eq_smul_of_mulVec_eq_zero hNt0 he0 h1 h2
      rw [hc]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self e)
    obtain ⟨D', hcompl, hD'⟩ := hss D hD hstab
    apply hNu0
    have hzero : ∀ x : Fin 2 → ZMod ℓ, Nu *ᵥ x = 0 := by
      intro x
      have hx : x ∈ D ⊔ D' := by rw [hcompl.sup_eq_top]; trivial
      obtain ⟨d, hd, d', hd', rfl⟩ := Submodule.mem_sup.1 hx
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hd
      rw [Matrix.mulVec_add, Matrix.mulVec_smul, hNe, smul_zero, zero_add]
      have hin' : Nu *ᵥ d' ∈ D' := by
        rw [Matrix.sub_mulVec, Matrix.one_mulVec]
        exact sub_mem (hD' u huG d' hd') hd'
      obtain ⟨c', hc'⟩ := hmul d'
      have hin : Nu *ᵥ d' ∈ D := by
        rw [hc']; exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self e)
      have := hcompl.disjoint.le_bot ⟨hin, hin'⟩
      simpa using this
    ext i j
    simpa [Matrix.mulVec_single_one] using congrFun (hzero (Pi.single j 1)) i
  · -- a transvection `s` of `G` moving the line of `e`
    push Not at hall
    obtain ⟨s, hsG, hNs0, hNs2, hNse⟩ := hall
    set Ns := (s : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) - 1 with hNsDef
    obtain ⟨e', he'0, hNe', hmul'⟩ := exists_forall_mulVec_eq_smul hNs0 hNs2
    obtain ⟨b, hb⟩ := hmul' e
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [zero_smul] at hb
      exact hNse hb
    have hnot : ∀ c : ZMod ℓ, e' ≠ c • e := by
      intro c hc
      apply hNse
      have hc0 : c ≠ 0 := by
        rintro rfl
        rw [zero_smul] at hc
        exact he'0 hc
      have : c • (Ns *ᵥ e) = 0 := by rw [← Matrix.mulVec_smul, ← hc, hNe']
      exact (smul_eq_zero.1 this).resolve_left hc0
    obtain ⟨a, ha⟩ := hmul e'
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [zero_smul] at ha
      obtain ⟨c, hc⟩ := exists_eq_smul_of_mulVec_eq_zero hNu0 he0 hNe ha
      exact hnot c hc
    -- the basis `e, e'`
    set P := Matrix.of fun i j => ![e, e'] j i
    have hP : P.det ≠ 0 := by
      intro h
      obtain ⟨c, hc⟩ := exists_eq_smul_of_det_cols_eq_zero he0 h
      exact hnot c hc
    set PG := mkOfDetNeZero P hP
    have hPG : (PG : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) = P := rfl
    have huP : (u : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) * P = P * !![1, a; 0, 1] := by
      rw [mul_cols, cols_mul_upper, mulVec_eq_add_sub_one _ e, mulVec_eq_add_sub_one _ e',
        ← hNuDef, hNe, ha, add_zero, add_comm e']
    have hsP : (s : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) * P = P * !![1, 0; b, 1] := by
      rw [mul_cols, cols_mul_lower, mulVec_eq_add_sub_one _ e, mulVec_eq_add_sub_one _ e',
        ← hNsDef, hb, hNe', add_zero]
    have hconj : ∀ t : GL (Fin 2) (ZMod ℓ), ∀ M : Matrix (Fin 2) (Fin 2) (ZMod ℓ),
        (t : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) * P = P * M →
          ((PG⁻¹ * t * PG : GL (Fin 2) (ZMod ℓ)) : Matrix (Fin 2) (Fin 2) (ZMod ℓ)) = M := by
      intro t M h
      rw [Units.val_mul, Units.val_mul, mul_assoc, hPG, h, ← hPG, ← mul_assoc, Units.inv_mul,
        one_mul]
    set G₀ := G.map (MulAut.conj PG⁻¹).toMonoidHom
    have hmem : ∀ g ∈ G, PG⁻¹ * g * PG ∈ G₀ := by
      intro g hg
      refine ⟨g, hg, ?_⟩
      simp
    have hU1 : upperTransvection 1 ∈ G₀ := by
      have h := hmem _ (pow_mem huG (a⁻¹).val)
      have hc : PG⁻¹ * u * PG = upperTransvection a := Units.ext (hconj u _ huP)
      have heq : PG⁻¹ * u ^ (a⁻¹).val * PG = upperTransvection a ^ (a⁻¹).val := by
        have := conj_pow (a := PG⁻¹) (b := u) (i := (a⁻¹).val)
        rw [inv_inv] at this
        rw [← this, hc]
      rw [heq, upperTransvection_pow, ZMod.natCast_zmod_val, inv_mul_cancel₀ ha0] at h
      exact h
    have hL1 : lowerTransvection 1 ∈ G₀ := by
      have h := hmem _ (pow_mem hsG (b⁻¹).val)
      have hc : PG⁻¹ * s * PG = lowerTransvection b := Units.ext (hconj s _ hsP)
      have heq : PG⁻¹ * s ^ (b⁻¹).val * PG = lowerTransvection b ^ (b⁻¹).val := by
        have := conj_pow (a := PG⁻¹) (b := s) (i := (b⁻¹).val)
        rw [inv_inv] at this
        rw [← this, hc]
      rw [heq, lowerTransvection_pow, ZMod.natCast_zmod_val, inv_mul_cancel₀ hb0] at h
      exact h
    have hU : ∀ x : ZMod ℓ, upperTransvection x ∈ G₀ := by
      intro x
      have := pow_mem hU1 x.val
      rwa [upperTransvection_pow, mul_one, ZMod.natCast_zmod_val] at this
    have hL : ∀ x : ZMod ℓ, lowerTransvection x ∈ G₀ := by
      intro x
      have := pow_mem hL1 x.val
      rwa [lowerTransvection_pow, mul_one, ZMod.natCast_zmod_val] at this
    -- conjugate back
    let Y : SpecialLinearGroup (Fin 2) (ZMod ℓ) :=
      ⟨((PG⁻¹ * SpecialLinearGroup.toGL X * PG : GL (Fin 2) (ZMod ℓ)) :
        Matrix (Fin 2) (Fin 2) (ZMod ℓ)), by
        rw [Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul, mul_right_comm,
          ← Matrix.det_mul, Units.inv_mul, Matrix.det_one, one_mul]
        exact X.2⟩
    obtain ⟨g, hg, hgeq⟩ := mem_closure_transvections Y hU hL
    have hYeq : SpecialLinearGroup.toGL Y = PG⁻¹ * SpecialLinearGroup.toGL X * PG := Units.ext rfl
    rw [hYeq] at hgeq
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv] at hgeq
    have : g = SpecialLinearGroup.toGL X := by
      simpa using hgeq
    rw [← this]
    exact hg

end Matrix.GeneralLinearGroup

