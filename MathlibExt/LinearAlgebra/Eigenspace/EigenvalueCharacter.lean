module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.Module.LinearMap.End
import Mathlib.Algebra.Group.IsApply
import Mathlib.Algebra.Algebra.Basic

/-!
# The eigenvalue character of a common eigenvector

Let `F ⊆ L` be fields, `A` an `F`-algebra generated by a set `X`, and `δ : A → End_L(V)` an
`F`-linear map with `δ 1 = 1` that is multiplicative or anti-multiplicative. If `v ≠ 0` is an
eigenvector of every `δ x`, `x ∈ X`, then it is an eigenvector of every `δ a`, and its eigenvalues
form an `F`-algebra homomorphism `χ : A → L` whose image is generated by `χ '' X`
(`Module.End.exists_algHom_of_forall_mem_span_singleton_of_mul_rev`,
`Module.End.exists_algHom_of_forall_mem_span_singleton`).

## References

* G. Shimura, *On the factors of the jacobian variety of a modular function field*, J. Math. Soc.
  Japan 25 (1973), 523–544: §1, p. 526, proof of Theorem 1.
-/

@[expose] public section

set_option autoImplicit false

namespace Module.End

variable {F L A V : Type*} [Field F] [Field L] [Algebra F L] [Ring A] [Algebra F A]
  [AddCommGroup V] [Module L V] [Module F V] [IsScalarTower F L V]

/-- **The eigenvalue character, assuming eigenvalues multiply.** Let $F \subseteq L$ be fields,
$A$ an $F$-algebra generated by $X$, $V$ an $L$-vector space and
$\delta \colon A \to \mathrm{End}_L(V)$ an $F$-linear map with $\delta(1) = 1$ such that whenever
$\delta(a) v = c v$ and $\delta(b) v = d v$, then $\delta(ab) v = cd\, v$. If $v \neq 0$ and
$\delta(x) v \in L v$ for $x \in X$, there is an
$F$-algebra homomorphism $\chi \colon A \to L$ with $\delta(a) v = \chi(a) v$ for all $a$, whose
image is the subalgebra generated by $\chi(X)$. -/
theorem exists_algHom_of_forall_mem_span_singleton_aux {X : Set A}
    (hX : Algebra.adjoin F X = ⊤) (δ : A →ₗ[F] Module.End L V) (h1 : δ 1 = 1)
    (hmul : ∀ (a b : A) (c d : L) (v : V), δ a v = c • v → δ b v = d • v →
      δ (a * b) v = (c * d) • v)
    {v : V} (hv : v ≠ 0) (hX' : ∀ x ∈ X, ∃ c : L, δ x v = c • v) :
    ∃ χ : A →ₐ[F] L, (∀ a, δ a v = χ a • v) ∧ χ.range = Algebra.adjoin F (χ '' X) := by
  classical
  have huniq : ∀ c d : L, c • v = d • v → c = d := by
    intro c d h
    by_contra hcd
    apply hv
    have h0 : (c - d) • v = 0 := by rw [sub_smul, h, sub_self]
    calc v = (c - d)⁻¹ • ((c - d) • v) := by
          rw [smul_smul, inv_mul_cancel₀ (sub_ne_zero.2 hcd), one_smul]
      _ = 0 := by rw [h0, smul_zero]
  have hall : ∀ a : A, ∃ c : L, δ a v = c • v := by
    intro a
    have ha : a ∈ Algebra.adjoin F X := hX ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact hX' x hx
    | algebraMap r =>
      refine ⟨algebraMap F L r, ?_⟩
      rw [Algebra.algebraMap_eq_smul_one, map_smul, h1, LinearMap.smul_apply, one_apply_eq_self,
        algebraMap_smul]
    | add x y _ _ hx hy =>
      obtain ⟨c, hc⟩ := hx
      obtain ⟨d, hd⟩ := hy
      exact ⟨c + d, by rw [map_add, LinearMap.add_apply, hc, hd, add_smul]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨c, hc⟩ := hx
      obtain ⟨d, hd⟩ := hy
      exact ⟨c * d, hmul x y c d v hc hd⟩
  choose χ hχ using hall
  let χ' : A →ₐ[F] L :=
    { toFun := χ
      map_one' := huniq _ _ (by rw [← hχ, h1, one_apply_eq_self, one_smul])
      map_mul' := fun a b => huniq _ _ (by rw [← hχ, hmul a b _ _ v (hχ a) (hχ b)])
      map_zero' := huniq _ _ (by rw [← hχ, map_zero, LinearMap.zero_apply, zero_smul])
      map_add' := fun a b => huniq _ _ (by
        rw [← hχ, map_add, LinearMap.add_apply, hχ a, hχ b, add_smul])
      commutes' := fun r => huniq _ _ (by
        rw [← hχ, Algebra.algebraMap_eq_smul_one, map_smul, h1, LinearMap.smul_apply,
          one_apply_eq_self, algebraMap_smul]) }
  refine ⟨χ', hχ, ?_⟩
  rw [← Algebra.map_top, ← hX, AlgHom.map_adjoin]


/-- **The eigenvalue character of a common eigenvector.** Let $F \subseteq L$ be fields,
$\mathfrak{A}$ an $F$-algebra generated by a subset $X$, $V$ a vector space over $L$, and
$\delta \colon \mathfrak{A} \to \mathrm{End}_L(V)$ an $F$-linear map with
$\delta(1) = \mathrm{id}_V$ and $\delta(ab) = \delta(b) \circ \delta(a)$. Let $v \in V$ be nonzero
with
$\delta(x)(v) \in L v$ for every $x \in X$. Then there is a homomorphism of $F$-algebras
$\chi \colon \mathfrak{A} \to L$ with
$\delta(a)(v) = \chi(a)\, v$ for every $a \in \mathfrak{A}$ (in particular $\delta(a)(v) \in L v$),
whose image is the $F$-subalgebra of $L$ generated by the $\chi(x)$, $x \in X$.

Source: G. Shimura, *On the factors of the jacobian variety of a modular function field*,
J. Math. Soc. Japan 25 (1973), 523–544, §1, p. 526, proof of Theorem 1 ("we can define a
homomorphism $\rho$ of $\mathfrak{T}$ onto $K$ by $\rho(\xi_n) = a_n$"), for the Hecke algebra
$\mathfrak{T}$ generated by the $\xi_n$, acting on $V = D_J$ with $v = \mu(f)$. -/
theorem exists_algHom_of_forall_mem_span_singleton_of_mul_rev {X : Set A}
    (hX : Algebra.adjoin F X = ⊤) (δ : A →ₗ[F] Module.End L V) (h1 : δ 1 = 1)
    (hmul : ∀ a b : A, δ (a * b) = δ b * δ a) {v : V} (hv : v ≠ 0)
    (hX' : ∀ x ∈ X, ∃ c : L, δ x v = c • v) :
    ∃ χ : A →ₐ[F] L, (∀ a, δ a v = χ a • v) ∧ χ.range = Algebra.adjoin F (χ '' X) :=
  exists_algHom_of_forall_mem_span_singleton_aux hX δ h1 (fun a b c d v ha hb => by
    rw [hmul, mul_apply_eq_comp, ha, map_smul, hb, smul_smul]) hv hX'

/-- **The eigenvalue character of a common eigenvector, multiplicative case.** As
`exists_algHom_of_forall_mem_span_singleton_of_mul_rev`, with
$\delta(ab) = \delta(a) \circ \delta(b)$ instead of $\delta(ab) = \delta(b) \circ \delta(a)$.

Source: G. Shimura, *On the factors of the jacobian variety of a modular function field*,
J. Math. Soc. Japan 25 (1973), 523–544, §1, p. 526, proof of Theorem 1 ("we can define a
homomorphism $\rho$ of $\mathfrak{T}$ onto $K$ by $\rho(\xi_n) = a_n$"), for the Hecke algebra
$\mathfrak{T}$ generated by the $\xi_n$. -/
theorem exists_algHom_of_forall_mem_span_singleton {X : Set A}
    (hX : Algebra.adjoin F X = ⊤) (δ : A →ₗ[F] Module.End L V) (h1 : δ 1 = 1)
    (hmul : ∀ a b : A, δ (a * b) = δ a * δ b) {v : V} (hv : v ≠ 0)
    (hX' : ∀ x ∈ X, ∃ c : L, δ x v = c • v) :
    ∃ χ : A →ₐ[F] L, (∀ a, δ a v = χ a • v) ∧ χ.range = Algebra.adjoin F (χ '' X) :=
  exists_algHom_of_forall_mem_span_singleton_aux hX δ h1 (fun a b c d v ha hb => by
    rw [hmul, mul_apply_eq_comp, hb, map_smul, ha, smul_smul, mul_comm]) hv hX'

end Module.End

end
