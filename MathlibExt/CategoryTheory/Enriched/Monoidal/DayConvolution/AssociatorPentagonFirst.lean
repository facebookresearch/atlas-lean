open AssociatorQuadNested
variable (F G H J : EnrichedFunctor V I V) (m : I)

/-- The complete first nested Day pentagon route retains the original AB/BC weights and
  coefficients. -/
theorem first_route (X : ((I × I) × I) × I) :
    genA d F G H J m X ≫ (AssociatorConstruction.componentIso d (day d F G) H J m).hom ≫
      (AssociatorConstruction.componentIso d F G (day d H J) m).hom =
    ((AssociatorQuadFlat.weightIsoAB d m X).hom ⊗ₘ (AssociatorQuadCoefficient.edgeAB F G H J X).hom)
      ≫
      ((AssociatorQuadFlat.weightIsoBC d m X).hom ⊗ₘ (AssociatorQuadCoefficient.edgeBC F G H J
        X).hom) ≫
        genC d F G H J m X := by
  let A := valueA d F G H J m
  let B := valueB d F G H J m
  let C := valueC d F G H J m
  let a : A ⟶ B := (AssociatorConstruction.componentIso d (day d F G) H J m).hom
  let b : B ⟶ C := (AssociatorConstruction.componentIso d F G (day d H J) m).hom
  let gA : AssociatorQuadFlat.objects d F G H J m .a X ⟶ A := genA d F G H J m X
  let gB : AssociatorQuadFlat.objects d F G H J m .b X ⟶ B := genB d F G H J m X
  let gC : AssociatorQuadFlat.objects d F G H J m .c X ⟶ C := genC d F G H J m X
  let w₁ : AssociatorQuadFlat.objects d F G H J m .a X ⟶ AssociatorQuadFlat.objects d F G H J m .b X
    :=
    (AssociatorQuadFlat.weightIsoAB d m X).hom ⊗ₘ (AssociatorQuadCoefficient.edgeAB F G H J X).hom
  let w₂ : AssociatorQuadFlat.objects d F G H J m .b X ⟶ AssociatorQuadFlat.objects d F G H J m .c X
    :=
    (AssociatorQuadFlat.weightIsoBC d m X).hom ⊗ₘ (AssociatorQuadCoefficient.edgeBC F G H J X).hom
  have h₁ : gA ≫ a = w₁ ≫ gB := genA_associator d F G H J m X
  have h₂ : gB ≫ b = w₂ ≫ gC := genB_associator d F G H J m X
  change gA ≫ a ≫ b = w₁ ≫ w₂ ≫ gC
  rw [← Category.assoc, h₁, Category.assoc, h₂]
end CategoryTheory.EnrichedDayKernel.AssociatorQuadFirstRoute
