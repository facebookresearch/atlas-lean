module

public import MathlibExt.CategoryTheory.SheafKernelCompletionMaps
public import Mathlib.RingTheory.Localization.Basic

/-!
# Localization along a local theta line and its full filtration

The denominator set is generated by images of genuine local generators
of an ABSOLUTE theta line. A generator must generate after every
restriction. Native sheafification glues the resulting localizations;
the construction asks for no global generator and includes zero rings.

The full filtration is the smallest sheaf of submodules over the
POSITIVE ring containing the original fractions `t^(-j) Fil^(i+j)`.
Positive powers are the ideal SHEAF powers from sheafified quotients.
It is not an ideal over the localized ring.

Reference: Scholze, arXiv:1205.3463v2, Definition 6.1, Remark 6.2 and
Definition 6.8. Native Mathlib localization, submodule lattices and
sheafification: Apache 2.0, revision
`56a005855ea17e0b0958f73ec801ae140b0a1679`.
-/

@[expose] public noncomputable section

namespace MathlibExt.CategoryTheory.SheafLocalGeneratorLocalization

open _root_.CategoryTheory _root_.CategoryTheory.Limits Opposite
open SheafKernelCompletion SheafKernelCompletionMaps

universe v u

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  (A H R : Sheaf J CommRingCat.{1}) (θ : A ⟶ H) (a : A ⟶ R)

/-- A local generator is hereditary; injectivity also holds on an empty object. -/
def IsLocalGenerator (U : Cᵒᵖ) (t : A.obj.obj U) : Prop :=
  ∀ (V : Cᵒᵖ) (f : U ⟶ V),
    Ideal.span {((A.obj.map f).hom t)} = kernelIdeal A H θ V ∧
      Function.Injective (fun x : A.obj.obj V => ((A.obj.map f).hom t) * x)

theorem localGenerator_restrict {U V : Cᵒᵖ} (f : U ⟶ V)
    (t : A.obj.obj U) (h : IsLocalGenerator A H θ U t) :
    IsLocalGenerator A H θ V ((A.obj.map f).hom t) := by
  intro W g
  simpa only [Functor.map_comp, CommRingCat.comp_apply] using h W (f ≫ g)

/-- Existence is local on the full site, with no distinguished global element. -/
def IsLocallyThetaLine : Prop :=
  ∀ U : C, ∃ S : Sieve U, S ∈ J U ∧
    ∀ (V : C) (f : V ⟶ U), S f →
      ∃ t : A.obj.obj (op V), IsLocalGenerator A H θ (op V) t

def denominators (U : Cᵒᵖ) : Submonoid (R.obj.obj U) :=
  Submonoid.closure ((a.hom.app U).hom '' {t | IsLocalGenerator A H θ U t})

theorem denominators_restrict {U V : Cᵒᵖ} (f : U ⟶ V) :
    denominators A H R θ a U ≤
      (denominators A H R θ a V).comap (R.obj.map f).hom := by
  apply Submonoid.closure_le.mpr
  rintro _ ⟨t, ht, rfl⟩
  apply Submonoid.subset_closure
  refine ⟨(A.obj.map f).hom t, localGenerator_restrict A H θ f t ht, ?_⟩
  exact congrArg (fun g => g.hom t) (a.hom.naturality f)

def rawLocalization : Cᵒᵖ ⥤ CommRingCat.{1} where
  obj U := CommRingCat.of (Localization (denominators A H R θ a U))
  map {U V} f := CommRingCat.ofHom
    (IsLocalization.map (Localization (denominators A H R θ a V))
      (R.obj.map f).hom (denominators_restrict A H R θ a f))
  map_id U := by
    apply CommRingCat.hom_ext
    apply IsLocalization.ringHom_ext (denominators A H R θ a U)
    ext x
    simp
  map_comp {U V W} f g := by
    apply CommRingCat.hom_ext
    apply IsLocalization.ringHom_ext (denominators A H R θ a U)
    ext x
    simp

def rawUnit : R.obj ⟶ rawLocalization A H R θ a where
  app U := CommRingCat.ofHom (algebraMap _ (Localization (denominators A H R θ a U)))
  naturality {U V} f := by ext x; simp [rawLocalization]

variable [HasSheafify J CommRingCat.{1}]

/-- Native sheafification permits different theta generators and denominators locally. -/
def localization : Sheaf J CommRingCat.{1} :=
  (presheafToSheaf J CommRingCat.{1}).obj (rawLocalization A H R θ a)

def unit : R ⟶ localization A H R θ a :=
  inv ((sheafificationAdjunction J CommRingCat.{1}).counit.app R) ≫
    (presheafToSheaf J CommRingCat.{1}).map (rawUnit A H R θ a)

section Maps

variable (R' : Sheaf J CommRingCat.{1}) (a' : A ⟶ R')
  (b : R ⟶ R') (square : a ≫ b = a')

include square in
theorem denominators_map (U : Cᵒᵖ) :
    denominators A H R θ a U ≤
      (denominators A H R' θ a' U).comap (b.hom.app U).hom := by
  apply Submonoid.closure_le.mpr
  rintro _ ⟨t, ht, rfl⟩
  apply Submonoid.subset_closure
  refine ⟨t, ht, ?_⟩
  exact (congrArg (fun f => (f.hom.app U).hom t) square).symm

def rawMap : rawLocalization A H R θ a ⟶ rawLocalization A H R' θ a' where
  app U := CommRingCat.ofHom
    (IsLocalization.map (Localization (denominators A H R' θ a' U))
      (b.hom.app U).hom (denominators_map A H R θ a R' a' b square U))
  naturality {U V} f := by
    dsimp [rawLocalization]
    apply CommRingCat.hom_ext
    apply IsLocalization.ringHom_ext (denominators A H R θ a U)
    ext x
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      IsLocalization.map_eq]
    exact congrArg (algebraMap _ (Localization (denominators A H R' θ a' V)))
      (congrArg (fun g => g.hom x) (b.hom.naturality f))

/-- The full scalar map is sheafification of the original generator-localization map. -/
def localizationMap : localization A H R θ a ⟶ localization A H R' θ a' :=
  (presheafToSheaf J CommRingCat.{1}).map (rawMap A H R θ a R' a' b square)

end Maps

/-- The genuine local generator is an actual unit in the constructed localization. -/
def generatorUnit (U : Cᵒᵖ) (t : A.obj.obj U) (ht : IsLocalGenerator A H θ U t) :
    ((localization A H R θ a).obj.obj U)ˣ :=
  Units.map ((toSheafify J (rawLocalization A H R θ a)).app U).hom.toMonoidHom
    (IsLocalization.map_units (M := denominators A H R θ a U)
      (Localization (denominators A H R θ a U))
      ⟨(a.hom.app U).hom t, Submonoid.subset_closure ⟨t, ht, rfl⟩⟩).unit

section Submodules

variable (F : Sheaf J CommRingCat.{1}) (η : R ⟶ F)

/-- A sheaf of submodules of `F`, with scalar ring `R`, stated on every site object. -/
structure SaturatedSubmodule where
  sections : ∀ U : Cᵒᵖ, letI := (η.hom.app U).hom.toAlgebra
    Submodule (R.obj.obj U) (F.obj.obj U)
  restrict : ∀ {U V : Cᵒᵖ} (f : U ⟶ V) (x : F.obj.obj U),
    x ∈ sections U → (F.obj.map f).hom x ∈ sections V
  localMembership : ∀ (U : Cᵒᵖ) (x : F.obj.obj U) (S : Sieve U.unop), S ∈ J U.unop →
    (∀ (V : C) (f : V ⟶ U.unop), S f →
      (F.obj.map f.op).hom x ∈ sections (op V)) → x ∈ sections U

end Submodules

variable (S : Sheaf J CommRingCat.{1}) (ϑ : R ⟶ S)

/-- The literal normalized fractions, with arbitrary integer Hodge index. -/
def ContainsFractions (i : ℤ)
    (M : SaturatedSubmodule R (localization A H R θ a) (unit A H R θ a)) : Prop :=
  ∀ (U : Cᵒᵖ) (t : A.obj.obj U) (ht : IsLocalGenerator A H θ U t)
    (j : ℤ) (x : R.obj.obj U), x ∈ idealSheafPower R S ϑ (i + j).toNat U →
      ((generatorUnit A H R θ a U t ht ^ (-j) : ((localization A H R θ a).obj.obj U)ˣ) :
        (localization A H R θ a).obj.obj U) * ((unit A H R θ a).hom.app U).hom x ∈ M.sections U

/-- The smallest saturated positive-ring submodule containing all original fractions. -/
def fullFiltration (i : ℤ) :
    SaturatedSubmodule R (localization A H R θ a) (unit A H R θ a) where
  sections U := by
    letI := ((unit A H R θ a).hom.app U).hom.toAlgebra
    exact ⨅ (M : SaturatedSubmodule R (localization A H R θ a) (unit A H R θ a))
      (_h : ContainsFractions A H R θ a S ϑ i M), M.sections U
  restrict f x hx := by
    simp only [Submodule.mem_iInf] at hx ⊢
    intro M hM
    exact M.restrict f x (hx M hM)
  localMembership U x Q hQ hx := by
    simp only [Submodule.mem_iInf] at hx ⊢
    intro M hM
    exact M.localMembership U x Q hQ (fun V f hf => hx V f hf M hM)

theorem fullFiltration_contains (i : ℤ) :
    ContainsFractions A H R θ a S ϑ i (fullFiltration A H R θ a S ϑ i) := by
  intro U t ht j x hx
  simp only [fullFiltration, Submodule.mem_iInf]
  intro M hM
  exact hM U t ht j x hx

/-- This is the normalization minimality, on every original object. -/
theorem fullFiltration_le (i : ℤ)
    (M : SaturatedSubmodule R (localization A H R θ a) (unit A H R θ a))
    (hM : ContainsFractions A H R θ a S ϑ i M) (U : Cᵒᵖ) :
    (fullFiltration A H R θ a S ϑ i).sections U ≤ M.sections U := by
  intro x hx
  simp only [fullFiltration, Submodule.mem_iInf] at hx
  exact hx M hM

end MathlibExt.CategoryTheory.SheafLocalGeneratorLocalization
