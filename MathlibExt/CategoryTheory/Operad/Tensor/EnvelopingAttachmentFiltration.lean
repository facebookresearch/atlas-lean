/-!
## Original generator and every original free-profile cofan of the two attachment legs
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance readbackFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance readbackTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance readbackProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

theorem newMap_hom (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (newMap O A x y).hom = profileMap O.toCollection (newGenerators O A x y) ≫ (endpoint O A x y).action := rfl

/-- Every original Free_O Xprime generator enters the same original
attachment carrier by exactly the original constructed new-generator map. -/
theorem newMap_originalGenerator (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (profileUnit O).app Xprime ≫ (newMap O A x y).hom = newGenerators O A x y := newMap_classifier O A x y

/-- Every original heterogeneous/nullary free O-profile cofan of the
new algebra leg evaluates by the original new-generator tensor map and original endpoint operation. -/
theorem newMap_profile (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) (P : AnalyticIndex W d) :
    profileι O.toCollection Xprime P ≫ (newMap O A x y).hom d =
      (analyticSummandCarrierMap O.toCollection (newGenerators O A x y)).app P ≫ (endpoint O A x y).operations.app d P
        := by
  let M := endpoint O A x y
  let g := newGenerators O A x y
  let i := profileι O.toCollection Xprime P
  let m := profileMap O.toCollection g d
  let a := M.action d
  let t := (analyticSummandCarrierMap O.toCollection g).app P
  let j := profileι O.toCollection M.carrier P
  exact (Category.assoc i m a).symm.trans ((congrArg (· ≫ a) (profileι_map O.toCollection g P)).trans
    ((Category.assoc t j a).trans (congrArg (t ≫ ·) (M.action_operation d P))))

/-- Every original free Env profile of the actual attaching map retains
the original y-classifier, canonical original A-carrier operations and original initial-Env comparison map. -/
theorem envAttachingMap_profile (O : ColoredOperadObj W C) (A : Algebra O) {X : W → C}
    (y : freeAlgebra O X ⟶ A) (d : W) (P : AnalyticIndex W d) :
    profileι (envelopingOperad O A).toCollection X P ≫ (envAttachingMap O A y).hom d =
      (analyticSummandCarrierMap (envelopingOperad O A).toCollection (sourceClassifier O A y)).app P ≫
        (canonicalEnvelopingAlgebra O A).operations.app d P ≫ (baseInitialIso O A).hom.hom d := by
  let E := envelopingOperad O A
  let M := canonicalEnvelopingAlgebra O A
  let g := sourceClassifier O A y
  let i := profileι E.toCollection X P
  let m := profileMap E.toCollection g d
  let a := M.action d
  let b := (baseInitialIso O A).hom.hom d
  let t := (analyticSummandCarrierMap E.toCollection g).app P
  let j := profileι E.toCollection M.carrier P
  have h : i ≫ m ≫ a = t ≫ M.operations.app d P :=
    (Category.assoc i m a).symm.trans ((congrArg (· ≫ a) (profileι_map E.toCollection g P)).trans
      ((Category.assoc t j a).trans (congrArg (t ≫ ·) (M.action_operation d P))))
  exact (Category.assoc i (m ≫ a) b).symm.trans
    ((congrArg (· ≫ b) h).trans (Category.assoc t (M.operations.app d P) b))


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

end
end AttachmentSource170


section AttachmentSource171


/-!
## The original colored tensor free-algebra pushout's full profile-cell filtration
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits HomotopicalAlgebra InitialAttachment InitialAttachment.ProfileCells

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance cellHistoryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance cellHistorySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance cellHistoryProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance cellHistoryInitial : HasInitial C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete PEmpty)

/-- Every actual finite original profile gives its original Env coefficient
tensor input-cube arrow, balanced at BOTH original Aut quotient objects,
and supported at its same original output color in the original carrier category. -/
def originalProfileArrow (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow (W → C) :=
  colorArrow P.outputColor (balancedProfileArrow (envelopingOperad O A) x P)

/-- The class is generated by those actual original finite profile arrows,
including original empty profiles and their genuine nullary data. -/
def profileProperty (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) : MorphismProperty (W → C) :=
  MorphismProperty.ofHoms (fun P : ColoredProfile W => (originalProfileArrow O A x P).hom)

/-- Every actual occurring representative cell is the same original profile
arrow, with its original output and full tensor coefficient/Aut quotients. -/
theorem occurringCell_mem (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) (p : RawCellIndex W N) :
    profileProperty O A x (profileCellMap O A x N p) :=
  MorphismProperty.ofHoms.mk (representativeProfile p.1 p.2)

/-- The actual original O-algebra pushout old-leg carrier map is a countable
transfinite composition of actual cobase changes of coproducts of the genuine
original Env profile arrows. The whole source/target, recursive stages,
cofans, labels, original x/y maps and full algebra pushout are retained. -/
def originalProfileTransfiniteComposition (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (MorphismProperty.coproducts.{us} (profileProperty O A x)).pushouts.TransfiniteCompositionOfShape
      ℕ (OriginalAttachment.oldMap O A x y).hom :=
  (originalRelativeCellComplex O A x y).transfiniteCompositionOfShape'
    (fun s => occurringCell_mem O A x s.j s.i)

/-- The SAME actual original underlying pushout arrow belongs to the actual
cellular closure of the original coefficient-weighted, Aut-balanced input
pushout-product arrows at every original finite profile/output. -/
theorem original_isProfileCellular (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    MorphismProperty.transfiniteCompositions.{0}
      (MorphismProperty.coproducts.{us} (profileProperty O A x)).pushouts
        (OriginalAttachment.oldMap O A x y).hom :=
  MorphismProperty.transfiniteCompositionsOfShape_le_transfiniteCompositions _ ℕ _
    (originalProfileTransfiniteComposition O A x y).mem

/-- Full original colored tensor free-algebra attachment filtration. The
actual original algebra endpoint is a genuine pushout and its SAME underlying
carrier-family old leg has the constructed original Env profile-cell history.
The operad, algebra, attachment, free maps and all source hypotheses are the
inputs; all Env, stage, cofan, pushout and history results are constructed. -/
theorem coloredTensorOperadicFreePushoutFiltration (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    IsPushout y ((freeAlgebraFunctor O).map x) (OriginalAttachment.oldMap O A x y)
        (OriginalAttachment.newMap O A x y) ∧
      Nonempty (RelativeCellComplex.{us} (profileCellMap O A x) (OriginalAttachment.oldMap O A x y).hom) ∧
        MorphismProperty.transfiniteCompositions.{0}
          (MorphismProperty.coproducts.{us} (profileProperty O A x)).pushouts
            (OriginalAttachment.oldMap O A x y).hom :=
  ⟨OriginalAttachment.isPushout O A x y, ⟨originalRelativeCellComplex O A x y⟩,
    original_isProfileCellular O A x y⟩


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
end AttachmentSource171


section AttachmentSource172


/-!
## The actual original Env(O,A) coefficient tensor attachment cells and finite symmetries
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance envelopingAttachmentCellFiniteTensor : FiniteTensor C :=
  FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original actual coefficient tensor of the iterated original
heterogeneous x pushout product, before its actual finite symmetry quotient. -/
def envelopingAttachmentUnbalancedCell (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow C :=
  InitialAttachment.profilePushoutProductArrow (envelopingOperad O A) x P

/-- Both actual boundary and top are balanced over the original finite
profile automorphism group, retaining the actual Env coefficient maps. -/
def envelopingAttachmentProfileCell (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow C :=
  InitialAttachment.balancedProfileArrow (envelopingOperad O A) x P

/-- The original coefficient tensor pushout product maps to its actual
balanced cell through both original finite-symmetry quotient legs. -/
def envelopingAttachmentCellQuotient (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) :
    envelopingAttachmentUnbalancedCell O A x P ⟶ envelopingAttachmentProfileCell O A x P :=
  InitialAttachment.Continuation.profilePushoutProductBalancedCofan (envelopingOperad O A) x P

/-- Every original profile permutation acts on the actual coefficient
tensor pushout-product arrow, including all its original proper faces. -/
def envelopingAttachmentCellPermutation (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    envelopingAttachmentUnbalancedCell O A x P ⟶ envelopingAttachmentUnbalancedCell O A x P :=
  InitialAttachment.Continuation.profilePushoutProductAutArrow (envelopingOperad O A) x P g

/-- Both actual original finite-symmetry quotient maps satisfy the
complete original coefficient/input permutation relation. -/
theorem envelopingAttachmentCellPermutation_quotient (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    envelopingAttachmentCellPermutation O A x P g ≫ envelopingAttachmentCellQuotient O A x P =
      envelopingAttachmentCellQuotient O A x P :=
  InitialAttachment.Continuation.profilePushoutProductAutArrow_balanced (envelopingOperad O A) x P g

/-- The displayed finite symmetry group is exactly the product of
the original color-fiber permutation groups with their actual multiplicities. -/
def envelopingAttachmentProfileSymmetry (P : ColoredProfile W) :
    Aut P ≃* (∀ r : W, Equiv.Perm (Fin (colorMultiplicity P r))) :=
  profileAutSigmaMulEquiv P

/-- Each original cell coefficient is precisely the actual original
weighted Env(O,A) coefficient coequalizer at that same full profile. -/
theorem envelopingAttachmentCell_coefficient (O : ColoredOperadObj W C) (A : Algebra O)
    (P : ColoredProfile W) :
    (envelopingOperad O A).toCollection.obj P = envelopingCoefficientObj O A P := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end AttachmentSource172


section AttachmentSource173


/-!
## Original coefficient tensor pushout products and both profile symmetry quotients
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits InitialAttachment InitialAttachment.Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance cppCellsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance cppCellsSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance cppCellsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance cppCellsInitial : HasInitial C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete PEmpty)

/-- The actual original heterogeneous coefficient tensor of the original
iterated pushout products, at its original output color. -/
def originalUnbalancedProfileArrow (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow (W → C) :=
  colorArrow P.outputColor (envelopingAttachmentUnbalancedCell O A x P)

/-- The original boundary and top symmetry quotients give the actual original
whole-family cell projection. Both coefficient/input quotient maps survive. -/
def originalProfileQuotient (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) :
    originalUnbalancedProfileArrow O A x P ⟶ originalProfileArrow O A x P :=
  (colorFunctor P.outputColor).mapArrow.map (envelopingAttachmentCellQuotient O A x P)

/-- Each original profile automorphism acts on the whole original
coefficient/input pushout-product arrow, with every proper face retained. -/
def originalProfilePermutation (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    originalUnbalancedProfileArrow O A x P ⟶ originalUnbalancedProfileArrow O A x P :=
  (colorFunctor P.outputColor).mapArrow.map (envelopingAttachmentCellPermutation O A x P g)

/-- Both original quotient legs satisfy the full original coefficient/input
automorphism relation in the unchanged whole carrier-family category. -/
theorem originalProfilePermutation_quotient (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    originalProfilePermutation O A x P g ≫ originalProfileQuotient O A x P =
      originalProfileQuotient O A x P :=
  ((colorFunctor P.outputColor).mapArrow.map_comp _ _).symm.trans
    (congrArg (colorFunctor P.outputColor).mapArrow.map (envelopingAttachmentCellPermutation_quotient O A x P g))

/-- The original symmetry group is the exact product of its original
color-fiber permutation groups, including all zero multiplicities. -/
def originalProfileSigma (P : ColoredProfile W) :
    Aut P ≃* (∀ r : W, Equiv.Perm (Fin (colorMultiplicity P r))) :=
  envelopingAttachmentProfileSymmetry P

/-- The coefficient in every actual attaching cell is the genuine original
Env(O,A) coefficient coequalizer, not an externally supplied object. -/
theorem originalProfileCoefficient (O : ColoredOperadObj W C) (A : Algebra O) (P : ColoredProfile W) :
    (envelopingOperad O A).toCollection.obj P = envelopingCoefficientObj O A P := rfl

/-- Every original whole-family cell evaluates to the SAME original balanced
coefficient tensor pushout-product arrow at its original output color. -/
def originalProfileAtOutput (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Arrow.mk ((originalProfileArrow O A x P).hom P.outputColor) ≅
      envelopingAttachmentProfileCell O A x P :=
  Arrow.isoMk (atColorIso P.outputColor _) (atColorIso P.outputColor _)
    (colorMap_at P.outputColor _).symm

/-- The full original empty-profile Env coefficient is the original actual
O-algebra carrier through its genuine original nullary comparison. -/
def originalNullaryCoefficient (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (envelopingOperad O A).toCollection.obj (ColoredProfile.nullary d) ≅ A.carrier d :=
  envelopingOperadNullaryIso O A d


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
end AttachmentSource173


section AttachmentSource174


/-!
## Original profile coproduct Arrow isomorphism and whole Hom equivalence
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance profileSumFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance profileSumSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance profileSumAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance profileSumDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance profileSumPuncturedColimits (n : ℕ) :
    HasColimitsOfShape (PuncturedMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance profileSumClassColimits (n : ℕ) :
    HasColimitsOfShape (Discrete (ProfileClass W n)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The balanced boundary object for the representative of a profile class. -/
def profileCellSources (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) : C :=
  (balancedProfileArrow E x (representativeProfile d s)).left

/-- The balanced full-input object for the representative of a profile class. -/
def profileCellTargets (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) : C :=
  (balancedProfileArrow E x (representativeProfile d s)).right

/-- The balanced boundary morphism for the representative of a profile class. -/
def profileCellMaps (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    profileCellSources E x d n s ⟶ profileCellTargets E x d n s :=
  (balancedProfileArrow E x (representativeProfile d s)).hom

/-- The literal coproduct of the original actual balanced profile maps. -/
def profileCellSumArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : Arrow C :=
  Arrow.mk (Limits.Sigma.map (profileCellMaps E x d n))

/-- Identify the coproduct of representative profile boundaries with the balanced degree boundary.
-/
def profileCellSourceIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    (profileCellSumArrow E x d n).left ≅ (degreeBalancedArrow E x d n).left :=
  (colimit.isColimit (Discrete.functor (profileCellSources E x d n))).coconePointUniqueUpToIso
    (operadBoundaryIsColimit E x d n)

/-- Identify the coproduct of representative profile tops with the balanced degree top. -/
def profileCellTargetIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    (profileCellSumArrow E x d n).right ≅ (degreeBalancedArrow E x d n).right :=
  (colimit.isColimit (Discrete.functor (profileCellTargets E x d n))).coconePointUniqueUpToIso
    (operadTopIsColimit E x d n)

theorem profileCellSourceIso_cofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    Limits.Sigma.ι (profileCellSources E x d n) s ≫ (profileCellSourceIso E x d n).hom =
      (operadProfileCellCofan E x d n s).left :=
  (IsColimit.comp_coconePointUniqueUpToIso_hom (colimit.isColimit (Discrete.functor (profileCellSources E x d n)))
    (operadBoundaryIsColimit E x d n) (Discrete.mk s)).trans (operadProfileCellCofan_left E x d n s).symm

theorem profileCellTargetIso_cofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    Limits.Sigma.ι (profileCellTargets E x d n) s ≫ (profileCellTargetIso E x d n).hom =
      (operadProfileCellCofan E x d n s).right :=
  IsColimit.comp_coconePointUniqueUpToIso_hom (colimit.isColimit (Discrete.functor (profileCellTargets E x d n)))
    (operadTopIsColimit E x d n) (Discrete.mk s)

theorem profileCellSum_square (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    (profileCellSourceIso E x d n).hom ≫ (degreeBalancedArrow E x d n).hom =
      (profileCellSumArrow E x d n).hom ≫ (profileCellTargetIso E x d n).hom := by
  apply Limits.Sigma.hom_ext
  intro s
  let j := Limits.Sigma.ι (profileCellSources E x d n) s
  have hl : j ≫ ((profileCellSourceIso E x d n).hom ≫ (degreeBalancedArrow E x d n).hom) =
      (operadProfileCellCofan E x d n s).left ≫ (degreeBalancedArrow E x d n).hom :=
    (Category.assoc j _ _).symm.trans
      (congrArg (· ≫ (degreeBalancedArrow E x d n).hom) (profileCellSourceIso_cofan E x d n s))
  have hr : j ≫ ((profileCellSumArrow E x d n).hom ≫ (profileCellTargetIso E x d n).hom) =
      profileCellMaps E x d n s ≫ (operadProfileCellCofan E x d n s).right :=
    (Category.assoc j _ _).symm.trans
      ((congrArg (· ≫ (profileCellTargetIso E x d n).hom) (Limits.Sigma.ι_map (profileCellMaps E x d n) s)).trans
        ((Category.assoc _ _ _).trans
          (congrArg (profileCellMaps E x d n s ≫ ·) (profileCellTargetIso_cofan E x d n s))))
  exact hl.trans ((operadProfileCellCofan E x d n s).w.trans hr.symm)

/-- The actual original degree arrow is the actual coproduct arrow of its
original full profile quotients, with both original projection comparisons. -/
def operadProfileCoproductIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    profileCellSumArrow E x d n ≅ degreeBalancedArrow E x d n :=
  Arrow.isoMk (profileCellSourceIso E x d n) (profileCellTargetIso E x d n) (profileCellSum_square E x d n)

/-- The componentwise coproduct injection of one balanced representative profile arrow. -/
def profileCellSumCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    balancedProfileArrow E x (representativeProfile d s) ⟶ profileCellSumArrow E x d n :=
  Arrow.homMk (Limits.Sigma.ι (profileCellSources E x d n) s) (Limits.Sigma.ι (profileCellTargets E x d n) s)
    (Limits.Sigma.ι_map (profileCellMaps E x d n) s)

theorem operadProfileCoproductIso_cofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    profileCellSumCofan E x d n s ≫ (operadProfileCoproductIso E x d n).hom = operadProfileCellCofan E x d n s := by
  apply Arrow.hom_ext
  · exact profileCellSourceIso_cofan E x d n s
  · exact profileCellTargetIso_cofan E x d n s

/-- Every whole Arrow map is exactly its family of original profile-cell
maps, with both inverse/round-trip laws supplied by the proved coproduct UP. -/
def operadDegreeHomEquiv (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (Y : Arrow C) :
    (degreeBalancedArrow E x d n ⟶ Y) ≃
      (∀ s : ProfileClass W n, balancedProfileArrow E x (representativeProfile d s) ⟶ Y) where
  toFun f s := operadProfileCellCofan E x d n s ≫ f
  invFun f := operadProfileCellsDesc E x d n (Cofan.mk Y f)
  left_inv f := by
    apply (operadArrowIsColimit E x d n).hom_ext
    intro s
    exact operadProfileCellsDesc_fac E x d n (Cofan.mk Y (fun s => operadProfileCellCofan E x d n s ≫ f)) s.as
  right_inv f := by
    funext s
    exact operadProfileCellsDesc_fac E x d n (Cofan.mk Y f) s


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

