/-!
## Actual original coefficient and input maps at every full top profile
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The full original top map retains the actual operation coefficient map
and the actual original input/color permutation. -/
def topFactorsMap (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {P Q : ColoredProfile W} (f : P ⟶ Q) :
    (coefficientInputFactors (markedProfileFunctor P.outputColor ⋙ O)
      (FiniteFamily.map (markedInputCarrier x))).obj (topMarkedProfile P) ⟶
    (coefficientInputFactors (markedProfileFunctor Q.outputColor ⋙ O)
      (FiniteFamily.map (markedInputCarrier x))).obj (topMarkedProfile Q) :=
  coefficientLeafMap (O.map f) ((FiniteFamily.map (markedInputCarrier x)).map (topProfileHom f))

theorem topOperationFactorsIso_map (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {P Q : ColoredProfile W} (f : P ⟶ Q) :
    topFactorsMap O x f ≫ (topOperationFactorsIso O x Q).hom =
      (topOperationFactorsIso O x P).hom ≫ (operationFactorsFunctor O Xprime).map f := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
        let m := O.map f
        change HEq (m ≫ 𝟙 _) (𝟙 _ ≫ m)
        exact heq_of_eq ((Category.comp_id m).trans (Category.id_comp m).symm)
    | some i =>
        let e : ((Finset.univ, Discrete.mk (P.inputColor i)) : MarkedColor W) =
            (Finset.univ, Discrete.mk (Q.inputColor (f.inputEquiv i))) :=
          Prod.ext rfl (congrArg Discrete.mk (f.inputColor_eq i))
        change HEq ((markedInputCarrier x).map (eqToHom e) ≫ eqToHom (markedCarrier_top x _))
          (eqToHom (markedCarrier_top x _) ≫ eqToHom (congrArg Xprime (f.inputColor_eq i)))
        apply heq_of_eq
        rw [eqToHom_map (markedInputCarrier x), eqToHom_trans, eqToHom_trans]

variable [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationEnumerationFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- Tensoring the original top-factor square retains the actual original
operation summand map at every full heterogeneous profile. -/
theorem topOperationTensorIso_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {P Q : ColoredProfile W} (f : P ⟶ Q) :
    (FiniteTensor.tensor (V := C)).map (topFactorsMap E.toCollection x f) ≫
        (topOperationTensorIso E x Q).hom =
      (topOperationTensorIso E x P).hom ≫ (operationSummandFunctor E.toCollection Xprime).map f :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
    ((congrArg (FiniteTensor.tensor (V := C)).map (topOperationFactorsIso_map E.toCollection x f)).trans
      ((FiniteTensor.tensor (V := C)).map_comp _ _))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
