/-!
## The actual continuous carrier history of the original initial-algebra attachment
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping EndpointRelations

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationAttachmentHistoryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationAttachmentHistorySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationAttachmentHistoryProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationAttachmentHistoryFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- Both source and target maps in this Arrow Iso are original: identity at
the genuine initial carrier and the constructed original endpoint comparison. -/
def recursiveAttachmentRootArrowIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Arrow.mk (recursiveStageRootMap E x a d) ≅ Arrow.mk ((endpointOldMap E x a).hom d) :=
  Arrow.isoMk' _ _ (Iso.refl _) (recursiveAttachmentEndpointIso E x a d)
    ((Category.id_comp _).trans (recursiveStageRootMap_toEndpoint E x a d).symm)

/-- This constructs the whole countable continuous carrier history of the
literal original attachment arrow. Every successor is its actual source
pushout, and the colimit is the carrier of the genuine original algebra endpoint. -/
def attachmentHistory (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    TransfiniteCompositionOfShape ℕ ((endpointOldMap E x a).hom d) :=
  (recursiveStageHistory E x a d).ofArrowIso (recursiveAttachmentRootArrowIso E x a d)

theorem attachmentHistory_obj (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (attachmentHistory E x a d).F.obj N = recursiveStage E x a d N := rfl

theorem attachmentHistory_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) :
    (attachmentHistory E x a d).F.map (homOfLE h) = recursiveStageMap E x a d h := rfl

theorem attachmentHistory_succ (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (attachmentHistory E x a d).F.map (homOfLE (Nat.le_succ N)) = recursiveConnectingMap E x a d N :=
  recursiveStageMap_succ E x a d N

theorem attachmentHistory_incl (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (attachmentHistory E x a d).incl.app N = recursiveAttachmentStageLeg E x a d N := rfl

@[reassoc]
theorem attachmentHistory_initial (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (attachmentHistory E x a d).incl.app 0 = (endpointOldMap E x a).hom d :=
  recursiveAttachmentStageLeg_zero E x a d

/-- Every step uses the unchanged original balanced boundary, actual
recursive attaching map and literal new degree cofan. -/
theorem attachmentHistory_successorIsPushout (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    IsPushout (recursiveAttachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom
      ((attachmentHistory E x a d).F.map (homOfLE (Nat.le_succ N))) (recursiveNewDegreeCofan E x a d N) := by
  rw [attachmentHistory_succ]
  exact recursiveSuccessorIsPushout E x a d N

@[reassoc]
theorem attachmentHistory_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    recursiveProfileCofan E x a N P hP ≫ (attachmentHistory E x a P.outputColor).incl.app N =
      endpointProfileLeg E x a (profileInputs P) :=
  recursiveAttachmentStageProfile E x a N P hP

@[reassoc]
theorem attachmentHistory_degree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N j : ℕ) (hj : j ≤ N) :
    recursiveDegreeCofan E x a d N j hj ≫ (attachmentHistory E x a d).incl.app N =
      degreeFreeMap E x d j ≫ (endpointNewMap E x a).hom d :=
  recursiveAttachmentStageDegree E x a d N j hj

/-- The algebra endpoint retains the full universal property of the
original genuine algebra span, independently of the carrier history. -/
def attachmentHistoryHomEquiv (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (M : Algebra E) :
    (attachmentEndpoint E x a ⟶ M) ≃ CompatibleAttachmentPair E x a M := endpointHomEquiv E x a M


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
