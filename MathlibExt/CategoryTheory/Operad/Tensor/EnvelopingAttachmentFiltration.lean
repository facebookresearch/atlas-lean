section AttachmentSource121


/-!
## All original operation cofactors in the constructed countable colimit
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationOmegaCofanFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationOmegaCofanSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationOmegaCofanProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationOmegaCofanFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The profile summand leg into the stage colimit, inserted at its input degree. -/
def omegaProfileCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) :
    (operationSummandFunctor E.toCollection Xprime).obj P ⟶ stageEndpoint E x a P.outputColor :=
  stageProfileLeg E x a (inputCount P) P (Nat.le_refl _) ≫ stageι E x a P.outputColor (inputCount P)

/-- Every later original stage gives this same original operation cofan. -/
@[reassoc]
theorem omegaProfileCofan_atStage (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    stageProfileLeg E x a N P hP ≫ stageι E x a P.outputColor N = omegaProfileCofan E x a P := by
  let j := stageProfileLeg E x a (inputCount P) P (Nat.le_refl _)
  let m := stageMap E x a P.outputColor hP
  let i := stageι E x a P.outputColor N
  have hj : j ≫ m = stageProfileLeg E x a N P hP := stageProfileLeg_map E x a hP P (Nat.le_refl _)
  exact (congrArg (· ≫ i) hj.symm).trans
    ((Category.assoc j m i).trans (congrArg (j ≫ ·) (stageι_naturality E x a P.outputColor hP)))

/-- Fixed-output original profile morphisms preserve all these actual cofans. -/
theorem omegaProfileCofan_analytic_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P Q : AnalyticIndex W d} (f : P ⟶ Q) :
    (analyticSummand E.toCollection Xprime).map f ≫ omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj Q) =
      omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) := by
  let T := FiniteTensor.tensor (V := C)
  let F := analyticToProfileFunctor W d
  let m := (operationSummandFunctor E.toCollection Xprime).map (F.map f)
  let N := max (inputCount ((analyticToProfileFunctor W d).obj P)) (inputCount ((analyticToProfileFunctor W d).obj Q))
  let hP : inputCount ((analyticToProfileFunctor W d).obj P) ≤ N := Nat.le_max_left _ _
  let hQ : inputCount ((analyticToProfileFunctor W d).obj Q) ≤ N := Nat.le_max_right _ _
  let j := stageProfileLeg E x a N ((analyticToProfileFunctor W d).obj P) hP
  let k := stageProfileLeg E x a N ((analyticToProfileFunctor W d).obj Q) hQ
  let i := stageι E x a d N
  have hm : m = (analyticSummand E.toCollection Xprime).map f :=
    congrArg T.map (operationFactorsFunctor_map_restrict E.toCollection Xprime f)
  have h : m ≫ k = j :=
    (stageProfileLeg_naturality E x a N (F.map f) hP hQ).trans (Category.comp_id j)
  have hPι : j ≫ i = omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) := omegaProfileCofan_atStage E x a N
    ((analyticToProfileFunctor W d).obj P) hP
  have hQι : k ≫ i = omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj Q) := omegaProfileCofan_atStage E x a N
    ((analyticToProfileFunctor W d).obj Q) hQ
  exact (congrArg (fun z => z ≫ omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj Q)) hm).symm.trans
    ((congrArg (m ≫ ·) hQι.symm).trans
      ((Category.assoc m k i).symm.trans ((congrArg (· ≫ i) h).trans hPι)))

/-- The original genuine new free-algebra profile diagram has its actual
cocone in the constructed countable carrier. -/
def omegaFreeCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Cocone (analyticSummand (d := d) E.toCollection Xprime) where
  pt := stageEndpoint E x a d
  ι.app P := omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P)
  ι.naturality _P _Q f := (omegaProfileCofan_analytic_naturality E x a d f).trans (Category.comp_id _).symm

/-- The free-algebra carrier map induced by the profile cofan of the stage colimit. -/
def omegaFreeMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (freeAlgebra E Xprime).carrier d ⟶ stageEndpoint E x a d :=
  colimit.desc _ (omegaFreeCocone E x a d)

@[reassoc (attr := simp)]
theorem omegaFreeMap_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : AnalyticIndex W d) :
    profileι E.toCollection Xprime P ≫ omegaFreeMap E x a d = omegaProfileCofan E x a ((analyticToProfileFunctor W
      d).obj P) :=
  colimit.ι_desc _ _

/-- The complete original proper-face and all-top relations hold in the
actual countable colimit. No compatibility equation is a construction input. -/
theorem omega_markedFace (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    normalizedMarkedFaceContraction E x a d P ≫ omegaProfileCofan E x a (survivingProfile d P) =
      (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P) ≫
        (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
        omegaProfileCofan E x a ((markedProfileFunctor d).obj P) := by
  let F := (markedProfileFunctor d).obj P
  let S := survivingProfile d P
  let N := inputCount F
  let hS := survivingCount_le d P
  let n := normalizedMarkedFaceContraction E x a d P
  let t := (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P)
  let p := (topOperationTensorIso E x F).hom
  let i := stageι E x a d N
  let l := stageProfileLeg E x a N S hS
  let r := stageProfileLeg E x a N F (Nat.le_refl _)
  have h : n ≫ l = t ≫ p ≫ r := stage_face_anyMarked E x a d N P (Nat.le_refl _)
  have hl : l ≫ i = omegaProfileCofan E x a S := omegaProfileCofan_atStage E x a N S hS
  have hr : r ≫ i = omegaProfileCofan E x a F := omegaProfileCofan_atStage E x a N F (Nat.le_refl _)
  exact (congrArg (n ≫ ·) hl.symm).trans
    ((Category.assoc n l i).symm.trans
      ((congrArg (· ≫ i) h).trans
        ((Category.assoc t (p ≫ r) i).trans
          ((congrArg (t ≫ ·) (Category.assoc p r i)).trans (congrArg (fun z => t ≫ p ≫ z) hr)))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource121


section AttachmentSource122


/-!
## The original degree cofans in the genuine new free algebra
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationDegreeFreeFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationDegreeFreeSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationDegreeFreeProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationDegreeFreeDegree (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- Every actual marked degree top is its original full free profile cofan. -/
def degreeFreeCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : Cocone (degreeTopTensorDiagram E x d n) where
  pt := (freeAlgebra E Xprime).carrier d
  ι.app P :=
    (topOperationTensorIso E x ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P))).hom ≫
      profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W)
        n).obj P)))
  ι.naturality P Q f := by
    let D := markedTensorDiagram E x d
    let g := (degreeMarkedInclusion (W := W) n).map f
    let p := (topOperationTensorIso E x ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P))).hom
    let q := (topOperationTensorIso E x ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj Q))).hom
    let j := profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W :=
      W) n).obj P)))
    let k := profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W :=
      W) n).obj Q)))
    let m := (operationSummandFunctor E.toCollection Xprime).map ((markedProfileFunctor d).map g)
    have hp : D.map ((allTopInputs (W := W)).map g) ≫ q = p ≫ m := topOperationTensorIso_marked E x d g
    have hm : m ≫ k = j :=
      (profileι_full_relabel E.toCollection Xprime ((markedProfileFunctor d).map g)).trans (Category.comp_id j)
    exact (Category.assoc _ q k).symm.trans
      ((congrArg (· ≫ k) hp).trans
        ((Category.assoc p m k).trans ((congrArg (p ≫ ·) hm).trans (Category.comp_id _).symm)))

/-- The map from a balanced degree top object to the new free-algebra carrier. -/
def degreeFreeMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    degreeBalancedTop E x d n ⟶ (freeAlgebra E Xprime).carrier d :=
  colimit.desc _ (degreeFreeCocone E x d n)

@[reassoc]
theorem degreeFreeMap_ι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (P : DegreeMarkedInputs W n) :
    colimit.ι (degreeTopTensorDiagram E x d n) P ≫ degreeFreeMap E x d n =
      (topOperationTensorIso E x ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P))).hom ≫
        profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W)
          n).obj P))) :=
  colimit.ι_desc _ _

/-- The degree projection retains each original full profile injection,
including its original finite input enumeration and every original color. -/
@[reassoc (attr := simp)]
theorem degreeFreeMap_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profileDegreeSummandCofan E x P ≫ degreeFreeMap E x P.outputColor (inputCount P) =
      profileι E.toCollection Xprime (profileInputs P) := by
  let d := P.outputColor
  let n := inputCount P
  let Q := (degreeMarkedInclusion (W := W) n).obj (enumeratedTopWord P)
  let F := (markedProfileFunctor d).obj Q
  let g := (topEnumerationIso P).hom
  let D := markedTensorDiagram E x d
  let p := topOperationTensorIso E x P
  let q := (topOperationTensorIso E x F).hom
  let j := profileι E.toCollection Xprime (profileInputs P)
  let k := profileι E.toCollection Xprime (profileInputs F)
  let m := (operationSummandFunctor E.toCollection Xprime).map ((markedProfileFunctor d).map g)
  let i := colimit.ι (degreeTopTensorDiagram E x d n) (enumeratedTopWord P)
  let f := degreeFreeMap E x d n
  have hg : (allTopInputs (W := W)).map g = g := markedHom_ext rfl
  have hp : D.map g ≫ q = p.hom ≫ m :=
    (congrArg (fun z => D.map z ≫ q) hg).symm.trans (topOperationTensorIso_marked E x d g)
  have hm : m ≫ k = j :=
    (profileι_full_relabel E.toCollection Xprime ((markedProfileFunctor d).map g)).trans (Category.comp_id j)
  have hi : i ≫ f = q ≫ k := degreeFreeMap_ι E x d n (enumeratedTopWord P)
  have h : D.map g ≫ i ≫ f = p.hom ≫ j :=
    (congrArg (D.map g ≫ ·) hi).trans
      ((Category.assoc (D.map g) q k).symm.trans
        ((congrArg (· ≫ k) hp).trans
          ((Category.assoc p.hom m k).trans (congrArg (p.hom ≫ ·) hm))))
  change (p.inv ≫ D.map g ≫ i) ≫ f = j
  exact (Category.assoc p.inv (D.map g ≫ i) f).trans
    ((congrArg (p.inv ≫ ·) (Category.assoc (D.map g) i f)).trans
      ((congrArg (p.inv ≫ ·) h).trans (Iso.inv_hom_id_assoc p j)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource122


section AttachmentSource123


/-!
## Original marked representatives of the free coproduct presentation

Every original selected input uses the original new coproduct inclusion; every
unselected input uses the original old coproduct inclusion. The coefficient,
input set, colors and nullary profile remain those of the original marked word.
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance mixedFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance mixedTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance mixedProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance mixedBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)

/-- The original new generator and actual old attachment arrow give the
literal original coproduct fold, at every independent original color. -/
def originalFold {X Xprime : W → C} (x : X ⟶ Xprime) : colorSum Xprime X ⟶ Xprime :=
  fun d => coprod.desc (𝟙 (Xprime d)) (x d)

omit [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C] [Small.{us} W] in
theorem originalInl_fold {X Xprime : W → C} (x : X ⟶ Xprime) :
    colorInl Xprime X ≫ originalFold x = 𝟙 Xprime := by
  funext d
  exact coprod.inl_desc _ _

omit [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C] [Small.{us} W] in
theorem originalInr_fold {X Xprime : W → C} (x : X ⟶ Xprime) :
    colorInr Xprime X ≫ originalFold x = x := by
  funext d
  exact coprod.inr_desc _ _

/-- The actual right relation is the actual free image of the original
coproduct fold. This is a whole algebra-map equality. -/
theorem relationRight_freeFold (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) : relationRight E x = (freeAlgebraFunctor E).map (originalFold x) := by
  let F := freeAlgebraFunctor E
  apply freeSum_hom_ext E
  · exact (freeInl_sumDesc E _ _).trans
      ((F.map_id Xprime).symm.trans
        ((congrArg F.map (originalInl_fold x).symm).trans (F.map_comp _ _)))
  · exact (freeInr_sumDesc E _ _).trans
      ((congrArg F.map (originalInr_fold x).symm).trans (F.map_comp _ _))

omit [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
  [Small.{us} W] [HasColimitsOfSize.{us, us} C] in
/-- The actual selected coordinate is its original new object. -/
theorem selectedCarrier {X Xprime : W → C} (x : X ⟶ Xprime)
    (P : MarkedInputs W) (i : P.index) (h : SelectedInput P i) :
    (markedInputCarrier x).obj (P.obj i) = Xprime (P.obj i).2.as := by
  change (markedInputCarrier x).obj ((P.obj i).1, Discrete.mk (P.obj i).2.as) = _
  rw [h]
  exact markedCarrier_top x _

/-- Original coproduct inclusions on the literal original marked input set. -/
def mixedLeafMap {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    (FiniteFamily.map (markedInputCarrier x)).obj P ⟶
      profileLeafFamily (colorSum Xprime X) ((markedProfileFunctor d).obj P) where
  equiv := Equiv.refl P.index
  hom i := if h : SelectedInput P i then
      eqToHom (selectedCarrier x P i h) ≫ coprod.inl
    else
      eqToHom (markedCarrier_old x (P.obj i).1 h (P.obj i).2.as) ≫ coprod.inr

/-- The actual marked coefficient and original coproduct leaf inclusions,
with the complete original operation-factor comparison. -/
def mixedFactorsMap (E : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    markedSourceFactors E x d P ⟶
      (operationFactorsFunctor E (colorSum Xprime X)).obj ((markedProfileFunctor d).obj P) :=
  coefficientLeafMap (𝟙 (E.obj ((markedProfileFunctor d).obj P))) (mixedLeafMap x d P) ≫
    (profileOperationFactorsIso E (colorSum Xprime X) ((markedProfileFunctor d).obj P)).hom

/-- Every original mixed marked profile enters the original free coproduct
algebra through its original coefficient-weighted profile cofan. -/
def mixedCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    (markedTensorDiagram E x d).obj P ⟶ (freeAlgebra E (colorSum Xprime X)).carrier d :=
  (FiniteTensor.tensor (V := C)).map (mixedFactorsMap E.toCollection x d P) ≫
    profileι E.toCollection (colorSum Xprime X) (profileInputs ((markedProfileFunctor d).obj P))


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource123


section AttachmentSource124


/-!
## Literal original right-relation evaluation of mixed free representatives
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits MonoidalCategory Enveloping Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The original carrier map at every original profile leaf position. -/
def carrierLeafMap {A B : W → C} (f : A ⟶ B) (P : ColoredProfile W) :
    profileLeafFamily A P ⟶ profileLeafFamily B P where
  equiv := Equiv.refl P.inputs
  hom i := f (P.inputColor i)

private theorem AttachmentSource124_markedPromotion {X Xprime : W → C} (x : X ⟶ Xprime)
    (p : MarkedColor W) :
    (markedInputCarrier x).map
        (show p ⟶ (Finset.univ, p.2) from
          (homOfLE (Finset.subset_univ p.1), 𝟙 p.2)) ≫
        eqToHom (markedCarrier_top x p.2.as) =
      if h : p.1 = Finset.univ then
        eqToHom (by
          rw [h]
          exact markedCarrier_top x p.2.as)
      else
        eqToHom (markedCarrier_old x p.1 h p.2.as) ≫ x p.2.as := by
  rcases p with ⟨s, ⟨r⟩⟩
  by_cases h : s = Finset.univ
  · subst s
    rw [dite_eq_left rfl]
    have hm :
        (show ((Finset.univ : FiniteCube.Index 1), Discrete.mk r) ⟶
            (Finset.univ, Discrete.mk r) from
          (homOfLE (Finset.subset_univ Finset.univ), 𝟙 (Discrete.mk r))) = 𝟙 _ :=
      Subsingleton.elim _ _
    rw [hm, Functor.map_id]
    exact Category.id_comp _
  · have he : s = ∅ :=
      congrArg Subtype.val (FiniteCube.puncturedOne_eq_empty ⟨s, h⟩)
    subst s
    rw [dite_eq_right h]
    let m : ((∅ : FiniteCube.Index 1), Discrete.mk r) ⟶ (Finset.univ, Discrete.mk r) :=
      (homOfLE (Finset.empty_subset Finset.univ), 𝟙 (Discrete.mk r))
    have hh : HEq ((markedInputCarrier x).map m) (x r) :=
      markedInputCarrier_arrow x r
    have hs := markedCarrier_old x ∅ h r
    have ht := markedCarrier_top x r
    have hm := (conj_eqToHom_iff_heq ((markedInputCarrier x).map m) (x r) hs ht).mpr hh
    change (markedInputCarrier x).map m ≫ eqToHom ht = eqToHom hs ≫ x r
    rw [hm]
    simp only [Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id]

variable [HasColimitsOfSize.{us, us} C]

local instance rightBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)

/-- The coproduct fold sends the original selected inclusion to the original
identity, and the original old inclusion to exactly the original x component.
The right side is the literal original marked-coordinate promotion. -/
theorem mixedLeafMap_fold {X Xprime : W → C} (x : X ⟶ Xprime)
    (d : W) (P : MarkedInputs W) (i : P.index) :
    (mixedLeafMap x d P).hom i ≫ originalFold x (P.obj i).2.as =
      (markedInputCarrier x).map (((toAllTopInputs (W := W)).app P).hom i) ≫
        eqToHom (markedCarrier_top x (P.obj i).2.as) := by
  have hm := AttachmentSource124_markedPromotion x (P.obj i)
  by_cases h : SelectedInput P i
  · let e := eqToHom (selectedCarrier x P i h)
    let q := originalFold x (P.obj i).2.as
    have hl : (mixedLeafMap x d P).hom i = e ≫ coprod.inl := dite_eq_left h
    have hp : (coprod.inl : Xprime (P.obj i).2.as ⟶ colorSum Xprime X (P.obj i).2.as) ≫ q = 𝟙 _ :=
      coprod.inl_desc _ _
    have hc : (markedInputCarrier x).map (((toAllTopInputs (W := W)).app P).hom i) ≫
        eqToHom (markedCarrier_top x (P.obj i).2.as) = e := hm.trans (dite_eq_left h)
    exact (congrArg (· ≫ q) hl).trans
      ((Category.assoc e coprod.inl q).trans
        ((congrArg (e ≫ ·) hp).trans ((Category.comp_id e).trans hc.symm)))
  · let e := eqToHom (markedCarrier_old x (P.obj i).1 h (P.obj i).2.as)
    let q := originalFold x (P.obj i).2.as
    have hl : (mixedLeafMap x d P).hom i = e ≫ coprod.inr := dite_eq_right h
    have hp : (coprod.inr : X (P.obj i).2.as ⟶ colorSum Xprime X (P.obj i).2.as) ≫ q = x _ :=
      coprod.inr_desc _ _
    have hc : (markedInputCarrier x).map (((toAllTopInputs (W := W)).app P).hom i) ≫
        eqToHom (markedCarrier_top x (P.obj i).2.as) = e ≫ x _ := hm.trans (dite_eq_right h)
    exact (congrArg (· ≫ q) hl).trans
      ((Category.assoc e coprod.inr q).trans ((congrArg (e ≫ ·) hp).trans hc.symm))

omit [HasColimitsOfSize.{us, us} C] in
/-- The full original coefficient profile is unchanged by promotion. -/
theorem markedPromotion_profile (d : W) (P : MarkedInputs W) :
    (markedProfileFunctor d).map ((toAllTopInputs (W := W)).app P) =
      𝟙 ((markedProfileFunctor d).obj P) := ColoredProfile.Hom.ext rfl

/-- All original mixed coefficient/input factors evaluate to precisely the
original marked top factors, with the original coefficient identity. -/
theorem mixedFactors_fold (E : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    mixedFactorsMap E x d P ≫
        (analyticFactorsCarrierMap E (originalFold x)).app
          (profileInputs ((markedProfileFunctor d).obj P)) =
      (coefficientInputFactors (markedProfileFunctor d ⋙ E)
        (FiniteFamily.map (markedInputCarrier x))).map ((toAllTopInputs (W := W)).app P) ≫
          (topOperationFactorsIso E x ((markedProfileFunctor d).obj P)).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      let f := E.map ((markedProfileFunctor d).map ((toAllTopInputs (W := W)).app P))
      have hf : f = 𝟙 (E.obj ((markedProfileFunctor d).obj P)) :=
        (congrArg E.map (markedPromotion_profile d P)).trans (E.map_id _)
      have hl : (𝟙 (E.obj ((markedProfileFunctor d).obj P)) ≫ 𝟙 _) ≫ 𝟙 _ = 𝟙 _ :=
        (congrArg (· ≫ 𝟙 _) (Category.id_comp _)).trans (Category.id_comp _)
      have hr : f ≫ 𝟙 _ = 𝟙 _ := (Category.comp_id f).trans hf
      exact heq_of_eq (hl.trans hr.symm)
    | some i =>
      change HEq (((mixedLeafMap x d P).hom i ≫ 𝟙 _) ≫
        originalFold x (P.obj i).2.as)
        ((markedInputCarrier x).map (((toAllTopInputs (W := W)).app P).hom i) ≫
          eqToHom (markedCarrier_top x (P.obj i).2.as))
      exact heq_of_eq ((congrArg (· ≫ originalFold x (P.obj i).2.as) (Category.comp_id _)).trans
        (mixedLeafMap_fold x d P i))

section Tensor

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance rightFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance rightTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance rightProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual mixed representative followed by the original right relation
is the literal original all-top x face followed by its original free cofan. -/
theorem mixedCofan_relationRight (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    mixedCofan E x d P ≫ (relationRight E x).hom d =
      (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P) ≫
        (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
          profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj P)) := by
  let T := FiniteTensor.tensor (V := C)
  let F := (markedProfileFunctor d).obj P
  let m := mixedFactorsMap E.toCollection x d P
  let r := (analyticFactorsCarrierMap E.toCollection (originalFold x)).app (profileInputs F)
  let t := (coefficientInputFactors (markedProfileFunctor d ⋙ E.toCollection)
    (FiniteFamily.map (markedInputCarrier x))).map ((toAllTopInputs (W := W)).app P)
  let b := (topOperationFactorsIso E.toCollection x F).hom
  have hf : T.map m ≫ T.map r = T.map t ≫ T.map b :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (mixedFactors_fold E.toCollection x d P)).trans (T.map_comp _ _))
  let p := profileι E.toCollection (colorSum Xprime X) (profileInputs F)
  let q := profileι E.toCollection Xprime (profileInputs F)
  let h := profileMap E.toCollection (originalFold x) d
  have hr : (relationRight E x).hom d = h :=
    congrArg (fun z => z.hom d) (relationRight_freeFold E x)
  have hp : p ≫ h = T.map r ≫ q := profileι_map E.toCollection (originalFold x) (profileInputs F)
  exact (congrArg (mixedCofan E x d P ≫ ·) hr).trans
    ((Category.assoc (T.map m) p h).trans
      ((congrArg (T.map m ≫ ·) hp).trans
        ((Category.assoc (T.map m) (T.map r) q).symm.trans
          ((congrArg (· ≫ q) hf).trans (Category.assoc (T.map t) (T.map b) q)))))


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
