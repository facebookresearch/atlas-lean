/-!
## The original full-degree colimit is the coproduct of genuine profile top quotients
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance degreeTopSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance degreeTopAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

local instance degreeTopDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The balanced top summand of one profile class in the raw degree colimit. -/
def degreeTopSummand (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) (s : ProfileClass W n) :
    (geometryBalancedProfileArrow D (representativeProfile d s)).right ⟶
      colimit (rawDegreeDiagram D n) :=
  (representativeTopIsColimit D d s).desc
    ((colimit.cocone (rawDegreeDiagram D n)).whisker (representativeCubeInclusion s))

theorem degreeTopSummand_face (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (s : ProfileClass W n) (S : RepresentativeCube s) :
    (representativeTopCocone D d s).ι.app S ≫ degreeTopSummand D d n s =
      colimit.ι (rawDegreeDiagram D n) (representativeVertex s S) :=
  (representativeTopIsColimit D d s).fac _ S

/-- The cofan of balanced profile tops with vertex the raw degree colimit. -/
def degreeTopCofan (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) :
    Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).right) :=
  Cofan.mk (colimit (rawDegreeDiagram D n)) (degreeTopSummand D d n)

/-- The raw degree colimit structure after restriction to profile-class representative cubes. -/
def topSigmaIsColimit (D : MarkedInputs W ⥤ C) (n : ℕ) :
    IsColimit ((colimit.cocone (rawDegreeDiagram D n)).whisker (cubeInclusion (W := W) n)) :=
  (Functor.Final.isColimitWhiskerEquiv (cubeInclusion (W := W) n)
    (colimit.cocone (rawDegreeDiagram D n))).symm (colimit.isColimit _)

/-- Extend a cofan of balanced profile tops to the coproduct of representative cube diagrams. -/
def topTargetSigmaCocone (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).right)) :
    Cocone (cubeInclusion (W := W) n ⋙ rawDegreeDiagram D n) where
  pt := t.pt
  ι.app q := (representativeTopCocone D d q.1).ι.app q.2 ≫ t.inj q.1
  ι.naturality := by
    rintro ⟨s, S⟩ ⟨_, T⟩ ⟨f⟩
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ t.inj s) ((representativeTopCocone D d s).w f)).trans
        (Category.comp_id _).symm)

/-- Descend the raw degree colimit to a cofan of balanced profile tops. -/
def degreeTopDesc (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).right)) :
    (degreeTopCofan D d n).pt ⟶ t.pt :=
  (topSigmaIsColimit D n).desc (topTargetSigmaCocone D d n t)

theorem degreeTopDesc_fac (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).right))
    (s : ProfileClass W n) : (degreeTopCofan D d n).inj s ≫ degreeTopDesc D d n t = t.inj s := by
  apply (representativeTopIsColimit D d s).hom_ext
  intro S
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ degreeTopDesc D d n t) (degreeTopSummand_face D d n s S)).trans
      ((topSigmaIsColimit D n).fac (topTargetSigmaCocone D d n t) ⟨s, S⟩))

theorem degreeTopDesc_unique (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).right))
    (m : (degreeTopCofan D d n).pt ⟶ t.pt)
    (w : ∀ s, (degreeTopCofan D d n).inj s ≫ m = t.inj s) :
    m = degreeTopDesc D d n t := by
  apply (topSigmaIsColimit D n).hom_ext
  rintro ⟨s, S⟩
  exact (congrArg (· ≫ m) (degreeTopSummand_face D d n s S).symm).trans
    ((Category.assoc _ _ _).trans
      ((congrArg ((representativeTopCocone D d s).ι.app S ≫ ·) (w s)).trans
        ((topSigmaIsColimit D n).fac (topTargetSigmaCocone D d n t) ⟨s, S⟩).symm))

/-- The colimit structure expressing the raw degree object as a coproduct of balanced profile tops.
-/
def degreeTopIsColimit (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) :
    IsColimit (degreeTopCofan D d n) :=
  Cofan.IsColimit.mk _ (degreeTopDesc D d n) (degreeTopDesc_fac D d n)
    (degreeTopDesc_unique D d n)


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
