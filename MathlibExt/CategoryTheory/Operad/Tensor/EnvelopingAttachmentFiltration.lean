section AttachmentSource148


/-!
## Actual cells supported at their original output color
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasInitial C]

/-- Classical color equality for the colorwise support maps of the carrier filtration. -/
local instance colorDecidableEq : DecidableEq W := Classical.decEq _

private theorem AttachmentSource148_colorTransportComp {D : Type*} [Category* D] {X Y Z X' Y' Z' : D}
    (a : X ≅ X') (b : Y ≅ Y') (c : Z ≅ Z') (f : X' ⟶ Y') (g : Y' ⟶ Z') :
    (a.hom ≫ f ≫ b.inv) ≫ (b.hom ≫ g ≫ c.inv) = a.hom ≫ (f ≫ g) ≫ c.inv := by
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

private theorem AttachmentSource148_colorReindexComp {D : Type*} [Category* D] {X Y Z T : D}
    (a : X ≅ T) (b : Y ≅ T) (c : Z ≅ T) :
    (a.hom ≫ b.inv) ≫ (b.hom ≫ c.inv) = a.hom ≫ c.inv := by
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

/-- An original cell object lies at its original output color; all other
colors retain the original initial object. -/
def colorObject (w : W) (Z : C) : W → C :=
  fun d => if d = w then Z else ⊥_ C

/-- The original cell map acts at its own original output color, with all
original endpoint transports and every other original initial color retained. -/
def colorMap (w : W) {Z Z' : C} (f : Z ⟶ Z') : colorObject w Z ⟶ colorObject w Z' :=
  fun d => if h : d = w then
      eqToHom (show colorObject w Z d = Z from ite_eq_left h) ≫ f ≫
        eqToHom (show colorObject w Z' d = Z' from ite_eq_left h).symm
    else
      eqToHom (show colorObject w Z d = ⊥_ C from ite_eq_right h) ≫
        eqToHom (show colorObject w Z' d = ⊥_ C from ite_eq_right h).symm

theorem colorMap_id (w : W) (Z : C) : colorMap w (𝟙 Z) = 𝟙 (colorObject w Z) := by
  funext d
  by_cases h : d = w
  · simp only [colorMap, dite_eq_left h, Category.id_comp, eqToHom_trans, eqToHom_refl]
    rfl
  · simp only [colorMap, dite_eq_right h, eqToHom_trans, eqToHom_refl]
    rfl

theorem colorMap_comp (w : W) {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) :
    colorMap w (f ≫ g) = colorMap w f ≫ colorMap w g := by
  funext d
  change colorMap w (f ≫ g) d = colorMap w f d ≫ colorMap w g d
  by_cases h : d = w
  · let a := eqToIso (show colorObject w X d = X from ite_eq_left h)
    let b := eqToIso (show colorObject w Y d = Y from ite_eq_left h)
    let c := eqToIso (show colorObject w Z d = Z from ite_eq_left h)
    have hf : colorMap w f d = a.hom ≫ f ≫ b.inv := dite_eq_left h
    have hg : colorMap w g d = b.hom ≫ g ≫ c.inv := dite_eq_left h
    have hfg : colorMap w (f ≫ g) d = a.hom ≫ (f ≫ g) ≫ c.inv := dite_eq_left h
    exact hfg.trans ((AttachmentSource148_colorTransportComp a b c f g).symm.trans
      (congrArg₂ (fun f g => f ≫ g) hf hg).symm)
  · let a := eqToIso (show colorObject w X d = ⊥_ C from ite_eq_right h)
    let b := eqToIso (show colorObject w Y d = ⊥_ C from ite_eq_right h)
    let c := eqToIso (show colorObject w Z d = ⊥_ C from ite_eq_right h)
    have hf : colorMap w f d = a.hom ≫ b.inv := dite_eq_right h
    have hg : colorMap w g d = b.hom ≫ c.inv := dite_eq_right h
    have hfg : colorMap w (f ≫ g) d = a.hom ≫ c.inv := dite_eq_right h
    exact hfg.trans ((AttachmentSource148_colorReindexComp a b c).symm.trans (congrArg₂ (fun f g => f ≫ g) hf hg).symm)

/-- The actual original color-support construction is a functor on the
unchanged original objects and original cell arrows. -/
def colorFunctor (w : W) : C ⥤ (W → C) where
  obj := colorObject w
  map := colorMap w
  map_id := colorMap_id w
  map_comp := colorMap_comp w

/-- The original output color has precisely the original cell object. -/
def atColorIso (w : W) (Z : C) : colorObject w Z w ≅ Z :=
  eqToIso (show colorObject w Z w = Z from ite_eq_left rfl)

/-- Every other original color remains the original initial object. -/
def awayColorIso (w : W) (Z : C) (d : W) (h : d ≠ w) : colorObject w Z d ≅ ⊥_ C :=
  eqToIso (show colorObject w Z d = ⊥_ C from ite_eq_right h)

/-- Inserting the actual original cell map is its original map at the same
original output color, with both original object comparisons retained. -/
theorem colorMap_at (w : W) {Z Z' : C} (f : Z ⟶ Z') :
    colorMap w f w ≫ (atColorIso w Z').hom = (atColorIso w Z).hom ≫ f := by
  let a := atColorIso w Z
  let b := atColorIso w Z'
  have hc : colorMap w f w = a.hom ≫ f ≫ b.inv := dite_eq_left rfl
  have hb : (f ≫ b.inv) ≫ b.hom = f :=
    (Category.assoc f b.inv b.hom).trans
      ((congrArg (f ≫ ·) b.inv_hom_id).trans (Category.comp_id f))
  exact (congrArg (· ≫ b.hom) hc).trans
    ((Category.assoc a.hom (f ≫ b.inv) b.hom).trans (congrArg (a.hom ≫ ·) hb))

/-- The actual original cell arrow in the whole color-indexed category. -/
def colorArrow (w : W) (f : Arrow C) : Arrow (W → C) :=
  Arrow.mk (colorMap w f.hom)

/-- A map out of an actual color-supported object is completely determined
by its actual original component at that original output color. -/
theorem colorHom_ext (w : W) (Z : C) {M : W → C} {f g : colorObject w Z ⟶ M}
    (h : f w = g w) : f = g := by
  funext d
  by_cases hd : d = w
  · subst d
    exact h
  · let e := awayColorIso w Z d hd
    apply (cancel_epi e.inv).1
    exact initial.hom_ext _ _

/-- The original component map gives an actual whole-family cell inclusion,
using only the original initial maps at every other original color. -/
def colorInclusion (w : W) {Z : C} {M : W → C} (f : Z ⟶ M w) : colorObject w Z ⟶ M :=
  fun d => if h : d = w then
      eqToHom (show colorObject w Z d = Z from ite_eq_left h) ≫ f ≫ eqToHom (congrArg M h).symm
    else
      eqToHom (show colorObject w Z d = ⊥_ C from ite_eq_right h) ≫ initial.to (M d)

/-- The whole actual color-supported inclusion reads back to the original
component map through its actual original source comparison. -/
theorem colorInclusion_at (w : W) {Z : C} {M : W → C} (f : Z ⟶ M w) :
    (atColorIso w Z).inv ≫ colorInclusion w f w = f := by
  let e := atColorIso w Z
  have ht : colorInclusion w f w = e.hom ≫ f ≫ 𝟙 (M w) := dite_eq_left rfl
  have h : colorInclusion w f w = e.hom ≫ f :=
    ht.trans (congrArg (e.hom ≫ ·) (Category.comp_id f))
  exact (congrArg (e.inv ≫ ·) h).trans (e.inv_hom_id_assoc f)

/-- Composition of actual supported-cell maps retains the exact original
component map and every other original initial component. -/
theorem colorInclusion_pre (w : W) {X Z : C} {M : W → C} (f : X ⟶ Z) (g : Z ⟶ M w) :
    colorMap w f ≫ colorInclusion w g = colorInclusion w (f ≫ g) := by
  apply colorHom_ext w X
  apply (cancel_epi (atColorIso w X).inv).1
  have hm : (atColorIso w X).inv ≫ colorMap w f w = f ≫ (atColorIso w Z).inv := by
    apply (cancel_mono (atColorIso w Z).hom).1
    exact (Category.assoc _ _ _).trans
      ((congrArg ((atColorIso w X).inv ≫ ·) (colorMap_at w f)).trans
        (((atColorIso w X).inv_hom_id_assoc f).trans
          ((Category.assoc f (atColorIso w Z).inv (atColorIso w Z).hom).trans
            ((congrArg (f ≫ ·) (atColorIso w Z).inv_hom_id).trans (Category.comp_id f))).symm))
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ colorInclusion w g w) hm).trans
      ((Category.assoc f (atColorIso w Z).inv (colorInclusion w g w)).trans
        ((congrArg (f ≫ ·) (colorInclusion_at w g)).trans (colorInclusion_at w (f ≫ g)).symm)))


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
end AttachmentSource148


section AttachmentSource149


/-!
## Original output-color cell cofactors in the whole carrier-family category
-/

set_option autoImplicit false
noncomputable section
universe uc ui u v

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasInitial C]

/-- A supported original component inclusion followed by an original whole
carrier-family map retains the original composite component at that color. -/
theorem colorInclusion_post (w : W) {Z : C} {M N : W → C} (f : Z ⟶ M w) (g : M ⟶ N) :
    colorInclusion w f ≫ g = colorInclusion w (f ≫ g w) := by
  apply colorHom_ext w Z
  apply (cancel_epi (atColorIso w Z).inv).1
  exact (Category.assoc (atColorIso w Z).inv (colorInclusion w f w) (g w)).symm.trans
    ((congrArg (· ≫ g w) (colorInclusion_at w f)).trans (colorInclusion_at w (f ≫ g w)).symm)

/-- Each original component object remains at its original output color. -/
def supportedObjects {I : W → Type ui} (D : ∀ w, I w → C) : (Σ w, I w) → (W → C) :=
  fun p => colorObject p.1 (D p.1 p.2)

/-- All original output-color cofactors are actual cofactors of one original
whole carrier-family object, with all other colors kept initial. -/
def supportedCofan {I : W → Type ui} {D : ∀ w, I w → C} (c : ∀ w, Cofan (D w)) :
    Cofan (supportedObjects D) :=
  Cofan.mk (fun w => (c w).pt) (fun p => colorInclusion p.1 ((c p.1).inj p.2))

/-- Read any actual whole supported cofan at one original output color. -/
def supportedCofanAt {I : W → Type ui} {D : ∀ w, I w → C}
    (s : Cofan (supportedObjects D)) (w : W) : Cofan (D w) :=
  Cofan.mk (s.pt w) (fun i => (atColorIso w (D w i)).inv ≫ s.inj ⟨w, i⟩ w)

/-- Source or target original component coproduct UPs construct the full
whole carrier-family coproduct UP, retaining all original actual injections
and complete componentwise descendants/uniqueness. -/
def supportedIsColimit {I : W → Type ui} {D : ∀ w, I w → C}
    (c : ∀ w, Cofan (D w)) (hc : ∀ w, IsColimit (c w)) : IsColimit (supportedCofan c) where
  desc s w := (hc w).desc (supportedCofanAt s w)
  fac s p := by
    rcases p with ⟨⟨w, i⟩⟩
    apply colorHom_ext w (D w i)
    apply (cancel_epi (atColorIso w (D w i)).inv).1
    let g := (hc w).desc (supportedCofanAt s w)
    exact (Category.assoc (atColorIso w (D w i)).inv
      (colorInclusion w (M := fun w => (c w).pt) ((c w).inj i) w) g).symm.trans
      ((congrArg (· ≫ g) (colorInclusion_at w (M := fun w => (c w).pt) ((c w).inj i))).trans
        ((hc w).fac (supportedCofanAt s w) ⟨i⟩))
  uniq s f h := by
    funext w
    apply (hc w).uniq (supportedCofanAt s w) (f w)
    rintro ⟨i⟩
    have hi : colorInclusion w (M := fun w => (c w).pt) ((c w).inj i) w ≫ f w =
        s.ι.app ⟨⟨w, i⟩⟩ w :=
      congrFun (h ⟨⟨w, i⟩⟩) w
    exact (congrArg (· ≫ f w) (colorInclusion_at w (M := fun w => (c w).pt) ((c w).inj i)).symm).trans
      ((Category.assoc (atColorIso w (D w i)).inv
        (colorInclusion w (M := fun w => (c w).pt) ((c w).inj i) w) (f w)).trans
        (congrArg ((atColorIso w (D w i)).inv ≫ ·) hi))

/-- The original paired source/target component cofactors retain their actual
original cell-arrow square in the whole color-indexed carrier category. -/
theorem supportedCellSquare {I : W → Type ui} {D E : ∀ w, I w → C}
    (c : ∀ w, Cofan (D w)) (c' : ∀ w, Cofan (E w))
    (f : ∀ w i, D w i ⟶ E w i) (g : (fun w => (c w).pt) ⟶ (fun w => (c' w).pt))
    (h : ∀ w i, (c w).inj i ≫ g w = f w i ≫ (c' w).inj i) (p : Σ w, I w) :
    (supportedCofan c).inj p ≫ g = colorMap p.1 (f p.1 p.2) ≫ (supportedCofan c').inj p := by
  change colorInclusion p.1 (M := fun w => (c w).pt) ((c p.1).inj p.2) ≫ g =
    colorMap p.1 (f p.1 p.2) ≫ colorInclusion p.1 (M := fun w => (c' w).pt) ((c' p.1).inj p.2)
  exact (colorInclusion_post p.1 ((c p.1).inj p.2) g).trans
    ((congrArg (colorInclusion p.1 (M := fun w => (c' w).pt)) (h p.1 p.2)).trans
      (colorInclusion_pre p.1 (M := fun w => (c' w).pt) (f p.1 p.2) ((c' p.1).inj p.2)).symm)


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

