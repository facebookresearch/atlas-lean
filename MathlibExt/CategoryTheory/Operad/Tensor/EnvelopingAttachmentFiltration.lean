section AttachmentSource044


set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory

variable {W : Type uc}

/-- The original profile morphism with its explicit original input inverse. -/
def originalProfileHomIso {P Q : ColoredProfile W} (f : P ⟶ Q) : P ≅ Q where
  hom := f
  inv := ColoredProfile.Hom.symm f
  hom_inv_id := ColoredProfile.Hom.ext f.inputEquiv.self_trans_symm
  inv_hom_id := ColoredProfile.Hom.ext f.inputEquiv.symm_trans_self

theorem originalProfileHomIso_eq {P Q : ColoredProfile W} (f : P ⟶ Q) :
    asIso (C := ColoredProfile W) f = originalProfileHomIso f := Iso.ext rfl

/-- The inverse of the actual original profile morphism is exactly its
original color-preserving inverse input bijection. -/
theorem originalProfile_asIso_inv {P Q : ColoredProfile W} (f : P ⟶ Q) :
    (asIso (C := ColoredProfile W) f).inv = ColoredProfile.Hom.symm f :=
  congrArg Iso.inv (originalProfileHomIso_eq f)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

