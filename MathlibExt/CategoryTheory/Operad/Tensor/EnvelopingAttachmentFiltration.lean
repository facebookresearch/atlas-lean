/-!
## The original initial-algebra leg of the constructed attachment history
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping EndpointRelations

private theorem AttachmentSource146_triplePost {V : Type*} [Category* V] {A B K Y Z : V}
    (f : A ⟶ B) (g : B ⟶ K) (h : K ⟶ Y) (q : Y ⟶ Z) :
    (f ≫ g ≫ h) ≫ q = f ≫ g ≫ h ≫ q :=
  (Category.assoc f (g ≫ h) q).trans (congrArg (f ≫ ·) (Category.assoc g h q))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationRootEndpointFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationRootEndpointSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationRootEndpointProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationRootEndpointFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationRootEndpointDegree : HasColimitsOfShape (DegreeMarkedInputs W 0) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The original zero-degree cofan followed by the original endpoint
projection is exactly the original initial-algebra leg through its original nil Iso. -/
theorem degreeFreeMap_zero_endpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    degreeFreeMap E x d 0 ≫ (endpointNewMap E x a).hom d =
      (zeroBalancedInitialIso E x d).hom ≫ (endpointOldMap E x a).hom d := by
  let T := degreeTopTensorDiagram E x d 0
  let z := zeroMarkedWord (W := W)
  let i := colimit.ι T z
  let : IsIso i := isIso_ι_of_isTerminal (zeroMarkedIsTerminal (W := W)) T
  let g := degreeFreeMap E x d 0
  let δ := zeroBalancedInitialIso E x d
  let π := (endpointNewMap E x a).hom d
  let o := (endpointOldMap E x a).hom d
  let r := (zeroMarkedTensorIso E x d).hom
  let n := nullaryToInitial E d
  let b := (nullarySummandIso E.toCollection Xprime d).inv
  let q := profileι E.toCollection Xprime (AnalyticIndex.nullary (d := d))
  let p := (topOperationTensorIso E x (zeroMarkedProfile d)).hom
  let j := profileι E.toCollection Xprime (profileInputs (zeroMarkedProfile d))
  have hl : i ≫ g ≫ π = (p ≫ j) ≫ π :=
    (Category.assoc i g π).symm.trans (congrArg (· ≫ π) (degreeFreeMap_ι E x d 0 z))
  have hn : n ≫ o = b ≫ q ≫ π := endpoint_original_nullary E x a d
  have hs : r ≫ b ≫ q = p ≫ j := zeroMarkedTensor_freeCofan E x d
  have hr : i ≫ δ.hom ≫ o = (p ≫ j) ≫ π :=
    (Category.assoc i δ.hom o).symm.trans
      ((congrArg (· ≫ o) (zeroBalancedInitialIso_ι E x d)).trans
        ((Category.assoc r n o).trans
          ((congrArg (r ≫ ·) hn).trans
            ((AttachmentSource146_triplePost r b q π).symm.trans (congrArg (· ≫ π) hs)))))
  apply (cancel_epi i).1
  exact hl.trans hr.symm

/-- The constructed bounded-stage root, transported to the genuine endpoint,
is literally the original initial-algebra attaching leg. -/
@[reassoc (attr := simp)]
theorem stageRootMap_toEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    stageRootMap E x a d ≫ (omegaEndpointIso E x a d).hom = (endpointOldMap E x a).hom d := by
  let δ := zeroBalancedInitialIso E x d
  let e := stageZeroIso E x a d
  let j := stageDegreeLeg E x a d 0 0 (Nat.le_refl _)
  let i := stageι E x a d 0
  let r := stageRootMap E x a d
  let f := (omegaEndpointIso E x a d).hom
  let π := (endpointNewMap E x a).hom d
  let g := degreeFreeMap E x d 0
  have hj : j ≫ e.hom = δ.hom := stageZeroIso_degree E x a d
  have he : δ.hom ≫ e.inv = j :=
    (congrArg (· ≫ e.inv) hj.symm).trans
      ((Category.assoc j e.hom e.inv).trans
        ((congrArg (j ≫ ·) e.hom_inv_id).trans (Category.comp_id j)))
  have hr : δ.hom ≫ r = j ≫ i :=
    (Category.assoc δ.hom e.inv i).symm.trans (congrArg (· ≫ i) he)
  have h : δ.hom ≫ r ≫ f = g ≫ π :=
    (Category.assoc δ.hom r f).symm.trans
      ((congrArg (· ≫ f) hr).trans
        ((Category.assoc j i f).trans
          ((congrArg (j ≫ ·) (stageι_toEndpoint E x a d 0)).trans
            (stageCoforkDesc_degree E x a d 0 0 (Nat.le_refl _) (endpointCarrierCofork E x a d)))))
  apply (cancel_epi δ.hom).1
  exact h.trans (degreeFreeMap_zero_endpoint E x a d)

/-- The countable colimit of the literal recursive original pushouts starts
at the original initial carrier and ends at its original actual attachment leg. -/
@[reassoc (attr := simp)]
theorem recursiveStageRootMap_toEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveStageRootMap E x a d ≫ (recursiveAttachmentEndpointIso E x a d).hom =
      (endpointOldMap E x a).hom d := by
  let r := recursiveStageRootMap E x a d
  let q := (recursiveStageEndpointIso E x a d).hom
  let f := (omegaEndpointIso E x a d).hom
  exact (Category.assoc r q f).symm.trans
    ((congrArg (· ≫ f) (recursiveStageRootMap_comparison E x a d)).trans (stageRootMap_toEndpoint E x a d))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource146


