/-!
## Actual Env endpoint descent classified by both original O-algebra span maps
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

private theorem AttachmentSource165_originalOldFactor {V : Type*} [Category* V] {X A B D : V}
    (e : X ≅ A) (i : A ⟶ B) (f : B ⟶ D) (g : X ⟶ D)
    (h : i ≫ f = e.inv ≫ g) : (e.hom ≫ i) ≫ f = g := by
  rw [Category.assoc, h]
  simp only [Iso.hom_inv_id_assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C := hasProfileColimitsOfSmallColors C d

variable (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
variable (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A)
variable {M : Algebra O} (a : A ⟶ M) (z : freeAlgebra O Xprime ⟶ M)
variable (h : y ≫ a = (freeAlgebraFunctor O).map x ≫ z)

/-- Both original O-algebra maps and their original y/x condition
construct a genuine full Env endpoint factor through the original initial-attachment universal property. -/
def envDesc : envEndpoint O A x y ⟶ underAEnvelopingObject O A (Under.mk a) :=
  InitialAttachment.endpointDesc (envelopingOperad O A) x (envAttachingMap O A y)
    (targetOldEnvMap O A (Under.mk a)) (targetNewEnvMap O A (Under.mk a) z)
    (targetEnvCompatibility O A x y (Under.mk a) z h)

/-- The descended Env map retains the exact original new free-Env algebra leg. -/
theorem envDesc_new :
    InitialAttachment.endpointNewMap (envelopingOperad O A) x (envAttachingMap O A y) ≫ envDesc O A x y a z h =
      targetNewEnvMap O A (Under.mk a) z :=
  InitialAttachment.endpointNewMap_desc (envelopingOperad O A) x (envAttachingMap O A y) _ _ _

/-- The descended Env map retains the exact original initial Env
algebra leg and original A/nil canonical target map. -/
theorem envDesc_old :
    InitialAttachment.endpointOldMap (envelopingOperad O A) x (envAttachingMap O A y) ≫ envDesc O A x y a z h =
      targetOldEnvMap O A (Under.mk a) :=
  InitialAttachment.endpointOldMap_desc (envelopingOperad O A) x (envAttachingMap O A y) _ _ _

/-- The actual original canonical A-carrier Env map factors to the
target canonical Env algebra map of the actual original A-arrow. -/
theorem canonicalEndpointMap_envDesc :
    canonicalEndpointMap O A x y ≫ envDesc O A x y a z h = canonicalEnvelopingAlgebraMap O a :=
  AttachmentSource165_originalOldFactor (baseInitialIso O A)
    (InitialAttachment.endpointOldMap (envelopingOperad O A) x (envAttachingMap O A y))
    (envDesc O A x y a z h) (canonicalEnvelopingAlgebraMap O a) (envDesc_old O A x y a z h)

/-- The original A leg's whole carrier factors through the actual
Env descendant as precisely the original given A-arrow carrier. -/
theorem envDesc_old_hom :
    (oldMap O A x y).hom ≫ (envDesc O A x y a z h).hom = a.hom := by
  have hc : (canonicalEndpointMap O A x y).hom ≫ (envDesc O A x y a z h).hom = a.hom :=
    (congrArg Algebra.Hom.hom (canonicalEndpointMap_envDesc O A x y a z h)).trans (canonicalEnvelopingAlgebraMap_hom O
      a)
  exact (congrArg (· ≫ (envDesc O A x y a z h).hom) (canonicalEndpointMap_hom O A x y)).symm.trans hc

/-- Every original Xprime generator factors through the actual Env
descendant to the original Free_O Xprime target classifier, on its unchanged original carrier. -/
theorem envDesc_generators :
    newGenerators O A x y ≫ (envDesc O A x y a z h).hom = tensorFreeHomEquiv O Xprime M z := by
  let E := envelopingOperad O A
  let B := underAEnvelopingObject O A (Under.mk a)
  let e := tensorFreeHomEquiv E Xprime B
  let j := InitialAttachment.endpointNewMap E x (envAttachingMap O A y)
  let f := envDesc O A x y a z h
  let c := tensorFreeHomEquiv O Xprime M z
  exact (tensorFreeHomEquiv_target E Xprime j f).symm.trans
    ((congrArg e (envDesc_new O A x y a z h)).trans (classifier_lift E Xprime B c))

/-- Every actual full Env map with the original new free leg is
uniquely the original endpoint factor classified by the original O pair. -/
theorem envDesc_unique (f : envEndpoint O A x y ⟶ underAEnvelopingObject O A (Under.mk a))
    (hf : InitialAttachment.endpointNewMap (envelopingOperad O A) x (envAttachingMap O A y) ≫ f =
      targetNewEnvMap O A (Under.mk a) z) : f = envDesc O A x y a z h :=
  InitialAttachment.endpointDesc_unique (envelopingOperad O A) x (envAttachingMap O A y) _ _ _ f hf


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

