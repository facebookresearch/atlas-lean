section AttachmentSource045


/-!
## Original full-root maps for simultaneous and successive contractions
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource045_inverseSquare {D : Type*} [Category* D] {X X' A A' : D}
    (s : X ≅ A) (s' : X' ≅ A') (r : X ⟶ X') (f : A ⟶ A')
    (h : r ≫ s'.hom = s.hom ≫ f) : f ≫ s'.inv = s.inv ≫ r := by
  apply (cancel_epi s.hom).1
  have hb : (s.hom ≫ f) ≫ s'.inv = r :=
    (congrArg (· ≫ s'.inv) h.symm).trans
      ((Category.assoc r s'.hom s'.inv).trans
        ((congrArg (r ≫ ·) s'.hom_inv_id).trans (Category.comp_id r)))
  exact ((Category.assoc s.hom f s'.inv).symm.trans hb).trans
    (Iso.hom_inv_id_assoc s r).symm

private theorem AttachmentSource045_triplePost {D : Type*} [Category* D] {A B C E Z : D}
    (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (q : E ⟶ Z) :
    (f ≫ g ≫ h) ≫ q = f ≫ g ≫ h ≫ q :=
  (Category.assoc f (g ≫ h) q).trans (congrArg (f ≫ ·) (Category.assoc g h q))

variable {W : Type uc}

/-- Regard a contracted source input selected at the target as a residual old input. -/
def residualOldOfSource {P Q : MarkedInputs W} (g : P ⟶ Q) (i : (contractedInputs P).index)
    (hi : SelectedInput Q (g.equiv i.1)) : (iterationOldInputs g).index :=
  ⟨⟨g.equiv i.1, hi⟩, fun h => i.2 ((congrArg (SelectedInput P) (g.equiv.symm_apply_apply i.1)).mp h)⟩

theorem iterationContracted_position_selected {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : (contractedInputs P).index) (hi : SelectedInput Q (g.equiv i.1)) :
    iterationContractedEquiv g i = Sum.inl (residualOldOfSource g i hi) := by
  change (if h : SelectedInput Q (g.equiv i.1) then _ else _) = _
  exact dite_eq_left hi

theorem iterationContracted_position_old {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : (contractedInputs P).index) (hi : ¬ SelectedInput Q (g.equiv i.1)) :
    iterationContractedEquiv g i = Sum.inr ⟨g.equiv i.1, hi⟩ := by
  change (if h : SelectedInput Q (g.equiv i.1) then _ else _) = _
  exact dite_eq_right hi

/-- Identify the twice-extended residual profile with the extended target-survivor profile. -/
def iterationExtendedSelectionIso (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    extendProfile (extendProfile (iterationProfile d g) (iterationOldInputs g)) (iterationRemainingInputs g) ≅
      extendProfile (survivingProfile d Q) (iterationRemainingInputs g) where
  hom := extendProfileMap (selectionRootHom d (residualMarkedInputs g)) (𝟙 (iterationRemainingInputs g))
  inv := extendProfileMap (iterationRootHom d g) (𝟙 (iterationRemainingInputs g))
  hom_inv_id := by
    apply ColoredProfile.Hom.ext
    apply Equiv.ext
    intro i
    cases i with
    | inl i =>
        exact congrArg Sum.inl (congrArg (fun f => f.inputEquiv i)
          (asIso (C := ColoredProfile W) (selectionRootHom d (residualMarkedInputs g))).hom_inv_id)
    | inr _ => rfl
  inv_hom_id := by
    apply ColoredProfile.Hom.ext
    apply Equiv.ext
    intro i
    cases i with
    | inl i =>
        exact congrArg Sum.inl (congrArg (fun f => f.inputEquiv i)
          (asIso (C := ColoredProfile W) (selectionRootHom d (residualMarkedInputs g))).inv_hom_id)
    | inr _ => rfl

/-- Identify the residual profile extended by both old-input groups with the target profile. -/
def iterationSelectionIso (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    extendProfile (iterationProfile d g)
        (DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)) ≅
      (markedProfileFunctor d).obj Q :=
  (originalProfileHomIso (DisjointNullary.rootSumAssocHom (iterationProfile d g) (iterationOldInputs g)
    (iterationRemainingInputs g))).symm ≪≫
    iterationExtendedSelectionIso d g ≪≫ originalProfileHomIso (selectionRootHom d Q)

/-- The actual original input maps commute through the full surviving/old
partition and the original input sum association. -/
theorem iterationSelection_forward (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    extendProfileMap (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom ≫
      (iterationSelectionIso d g).hom = selectionRootHom d P ≫ (markedProfileFunctor d).map g := by
  let t := (iterationSelectionIso d g).hom
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl i => rfl
  | inr i =>
      change t.inputEquiv (Sum.inr (iterationContractedEquiv g i)) = g.equiv i.1
      by_cases hi : SelectedInput Q (g.equiv i.1)
      · exact (congrArg (fun j => t.inputEquiv (Sum.inr j))
          (iterationContracted_position_selected g i hi)).trans rfl
      · exact (congrArg (fun j => t.inputEquiv (Sum.inr j))
          (iterationContracted_position_old g i hi)).trans rfl

/-- Map the source profile to the residual profile extended by both old-input groups. -/
def iterationWholeRootHom (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedProfileFunctor d).obj P ⟶
      extendProfile (extendProfile (iterationProfile d g) (iterationOldInputs g)) (iterationRemainingInputs g) :=
  (markedProfileFunctor d).map g ≫ (asIso (selectionRootHom d Q)).inv ≫
    extendProfileMap (iterationRootHom d g) (𝟙 (iterationRemainingInputs g))

/-- The original successive-contraction root map followed by the original
sum association is the unchanged original simultaneous survivor/old root map. -/
theorem iterationWholeRoot_triangle (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    iterationWholeRootHom d g ≫
      DisjointNullary.rootSumAssocHom (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g) =
    (asIso (selectionRootHom d P)).inv ≫
      extendProfileMap (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom := by
  let s := asIso (selectionRootHom d P)
  let s' := iterationSelectionIso d g
  let r := extendProfileMap (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom
  let f := (markedProfileFunctor d).map g
  have h : f ≫ s'.inv = s.inv ≫ r := AttachmentSource045_inverseSquare s s' r f (iterationSelection_forward d g)
  let a := (asIso (selectionRootHom d Q)).inv
  let a' := ColoredProfile.Hom.symm (selectionRootHom d Q)
  let b := extendProfileMap (iterationRootHom d g) (𝟙 (iterationRemainingInputs g))
  let q := DisjointNullary.rootSumAssocHom (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g)
  have ha : a = a' := originalProfile_asIso_inv (selectionRootHom d Q)
  have h' : f ≫ a' ≫ b ≫ q = s.inv ≫ r := h
  exact (AttachmentSource045_triplePost f a b q).trans
    ((congrArg (fun z => f ≫ z ≫ b ≫ q) ha).trans h')


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource045


section AttachmentSource046


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource046_transportedIsoHom {D : Type*} [Category* D] {A B B' : D}
    (e : B = B') (i : A ≅ B) :
    HEq ((Eq.mp (congrArg (fun k => A ≅ k) e) i).hom) i.hom := by
  cases e
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem iterationLeaf_position_top {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    (R : MarkedInputs W) (i : R.index) (hi : SelectedInput R i) :
    (iterationLeafIso x d R).hom.equiv i = Sum.inr ⟨i, hi⟩ := by
  change (if h : SelectedInput R i then _ else _) = _
  exact dite_eq_left hi

theorem iterationLeaf_position_old {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    (R : MarkedInputs W) (i : R.index) (hi : ¬ SelectedInput R i) :
    (iterationLeafIso x d R).hom.equiv i = Sum.inl ⟨i, hi⟩ := by
  change (if h : SelectedInput R i then _ else _) = _
  exact dite_eq_right hi

theorem iterationLeaf_component_top {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    (R : MarkedInputs W) (i : R.index) (hi : SelectedInput R i) :
    HEq ((iterationLeafIso x d R).hom.hom i) (eqToHom (markedTopCarrierEq x R i hi)) := by
  let Y := LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)
  have hp : iterationLeafEquiv R i = Sum.inr ⟨i, hi⟩ := by
    change (if h : SelectedInput R i then _ else _) = _
    exact dite_eq_left hi
  have ht : Xprime (R.obj i).2.as = Y.obj (iterationLeafEquiv R i) := (congrArg Y.obj hp).symm
  have h := AttachmentSource046_transportedIsoHom ht (eqToIso (markedTopCarrierEq x R i hi))
  simpa only [iterationLeafIso, FiniteFamily.isoOfComponents, dite_eq_left hi, Y] using! h

theorem iterationLeaf_component_old {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    (R : MarkedInputs W) (i : R.index) (hi : ¬ SelectedInput R i) :
    HEq ((iterationLeafIso x d R).hom.hom i)
      (eqToHom (markedCarrier_old x (R.obj i).1 hi (R.obj i).2.as)) := by
  let Y := LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)
  have hp : iterationLeafEquiv R i = Sum.inl ⟨i, hi⟩ := by
    change (if h : SelectedInput R i then _ else _) = _
    exact dite_eq_right hi
  have ht : X (R.obj i).2.as = Y.obj (iterationLeafEquiv R i) := (congrArg Y.obj hp).symm
  have h := AttachmentSource046_transportedIsoHom ht (eqToIso (markedCarrier_old x (R.obj i).1 hi (R.obj i).2.as))
  simpa only [iterationLeafIso, FiniteFamily.isoOfComponents, dite_eq_right hi, Y] using! h


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
