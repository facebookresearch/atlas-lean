section AttachmentSource152


/-!
## Factor every actual original fixed-profile marked morphism

An original marked cube morphism consists of an original color-preserving
input permutation followed by an original coordinate face. Both factors
are constructed from that actual morphism.
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}
/-- Classical input equality for the actual-profile cube morphisms and subsets. -/
local instance morphismInputDecidableEq (P : ColoredProfile W) : DecidableEq P.inputs := Classical.decEq _

/-- The actual original profile automorphism underlying a marked cube map. -/
def cubeProfileAut (P : ColoredProfile W) {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) : Aut P :=
  Aut.of (asIso (show P ⟶ P from
    { inputEquiv := f.equiv
      inputColor_eq i := Discrete.eq_of_hom (f.hom i).2
      outputColor_eq := rfl }))

theorem cubeProfileAut_inputs (P : ColoredProfile W) {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) :
    (cubeProfileAut P f).asIso.hom.inputEquiv = f.equiv := rfl

/-- The original coordinate maps force precisely the original relabelled
subset inclusion, retaining every heterogeneous input. -/
theorem cubeProfileAut_subset (P : ColoredProfile W) {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) :
    profileAutSubset P (cubeProfileAut P f) S ⊆ T := by
  classical
  intro j hj
  rcases Finset.mem_map.mp hj with ⟨i, hi, rfl⟩
  have hm : inputCoordinate P S i ⊆ inputCoordinate P T (f.equiv i) := leOfHom (f.hom i).1
  by_contra ht
  have hz : (0 : Fin 1) ∈ inputCoordinate P S i := by
    change (0 : Fin 1) ∈ (if i ∈ S then (Finset.univ : FiniteCube.Index 1) else ∅)
    rw [ite_eq_left hi]
    exact Finset.mem_univ _
  have hz' := hm hz
  have hzero : inputCoordinate P T (f.equiv i) = ∅ := by
    unfold inputCoordinate
    exact ite_eq_right ht
  rw [hzero] at hz'
  exact Finset.notMem_empty _ hz'

/-- The literal original marked morphism is the original profile
automorphism vertex map followed by its original coordinate face. -/
theorem cubeProfileAut_factor (P : ColoredProfile W) {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) :
    f = (profileAutInputVertexIso P (cubeProfileAut P f) S).hom ≫
      (originalInputCube P).map (homOfLE (cubeProfileAut_subset P f)) := by
  apply markedHom_ext
  exact (Equiv.trans_refl f.equiv).symm

/-- Forgetting the marks retains the original actual coefficient profile
map, rather than an arbitrary action comparison. -/
theorem cubeProfileAut_coefficient (P : ColoredProfile W) {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) :
    (markedProfileFunctor P.outputColor).map f = (cubeProfileAut P f).asIso.hom :=
  ColoredProfile.Hom.ext rfl

section TensorDiagram

variable {C : Type u} [Category.{v} C]

/-- Every original coefficient/input tensor diagram preserves both literal
factors of the actual marked map. No tensor or operad law is an input. -/
theorem cubeProfileAut_tensor_factor (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) :
    D.map f = D.map (profileAutInputVertexIso P (cubeProfileAut P f) S).hom ≫
      D.map ((originalInputCube P).map (homOfLE (cubeProfileAut_subset P f))) :=
  (congrArg D.map (cubeProfileAut_factor P f)).trans (D.map_comp _ _)

end TensorDiagram


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource152


section AttachmentSource153


/-!
## Actual boundary quotient cofans for the full original profile face category
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}
/-- Classical input equality for the full profile boundary and its proper subsets. -/
local instance boundaryProfileDecidableEq (P : ColoredProfile W) : DecidableEq P.inputs := Classical.decEq _

/-- All actual marked morphisms between original vertices of P. -/
abbrev FullProfileCube (P : ColoredProfile W) :=
  InducedCategory (MarkedInputs W) (originalInputCube P).obj

/-- Include the full cube on a profile's actual inputs into marked inputs. -/
def fullCubeInclusion (P : ColoredProfile W) : FullProfileCube P ⥤ MarkedInputs W :=
  inducedFunctor _

/-- The full subcategory of the actual-input profile cube on proper subsets. -/
abbrev FullProfilePunctured (P : ColoredProfile W) :=
  InducedCategory (FullProfileCube P) (fun S : ProfilePuncturedInputSets P => S.1)

/-- Include the full punctured profile cube into the full profile cube. -/
def fullPuncturedInclusion (P : ColoredProfile W) : FullProfilePunctured P ⥤ FullProfileCube P :=
  inducedFunctor _

/-- Every original coordinate face enters the full fixed-profile category. -/
def fullProfileFaces (P : ColoredProfile W) : ProfileInputSets P ⥤ FullProfileCube P where
  obj S := S
  map f := InducedCategory.homMk ((originalInputCube P).map f)
  map_id S := InducedCategory.hom_ext ((originalInputCube P).map_id S)
  map_comp f g := InducedCategory.hom_ext ((originalInputCube P).map_comp f g)

/-- Include the ordinary proper-face diagram into the full punctured profile cube. -/
def fullProfilePuncturedFaces (P : ColoredProfile W) :
    ProfilePuncturedInputSets P ⥤ FullProfilePunctured P where
  obj S := S
  map f := InducedCategory.homMk (InducedCategory.homMk
    ((originalInputCube P).map ((originalPuncturedInclusion P).map f)))
  map_id S := by
    apply InducedCategory.hom_ext
    apply InducedCategory.hom_ext
    exact (originalInputCube P).map_id S.1
  map_comp f g := by
    apply InducedCategory.hom_ext
    apply InducedCategory.hom_ext
    exact (originalInputCube P).map_comp
      ((originalPuncturedInclusion P).map f) ((originalPuncturedInclusion P).map g)

section Diagram

variable {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]

local instance boundaryProfileSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance boundaryProfileAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- Evaluate `D` on the full cube of a profile's actual inputs. -/
def fullCubeTensor (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) : FullProfileCube P ⥤ C :=
  fullCubeInclusion P ⋙ D

/-- Evaluate `D` on the full punctured cube of a profile's actual inputs. -/
def fullPuncturedTensor (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) : FullProfilePunctured P ⥤ C :=
  fullPuncturedInclusion P ⋙ fullCubeTensor D P

/-- The literal original two quotient legs: original proper face into its
boundary, followed by the original full Aut(P) quotient projection. -/
def boundaryQuotientLeg (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (S : ProfilePuncturedInputSets P) :
    (geometryPuncturedTensor D P).obj S ⟶ colimit (geometryBoundaryActionFunctor D P) :=
  colimit.ι (geometryPuncturedTensor D P) S ≫
    colimit.ι (geometryBoundaryActionFunctor D P) (SingleObj.star (Aut P))

theorem boundaryQuotientLeg_face (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    {S T : ProfilePuncturedInputSets P} (f : S ⟶ T) :
    (geometryPuncturedTensor D P).map f ≫ boundaryQuotientLeg D P T =
      boundaryQuotientLeg D P S :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ colimit.ι (geometryBoundaryActionFunctor D P) (SingleObj.star (Aut P)))
      (colimit.w (geometryPuncturedTensor D P) f))

theorem boundaryQuotientLeg_aut (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (g : Aut P) (S : ProfilePuncturedInputSets P) :
    D.map (profileAutInputVertexIso P g S.1).hom ≫
        boundaryQuotientLeg D P ((profileAutPunctured P g).obj S) =
      boundaryQuotientLeg D P S := by
  let B := geometryPuncturedTensor D P
  let A := geometryBoundaryActionFunctor D P
  let j := colimit.ι A (SingleObj.star (Aut P))
  have hg : geometryAutMap D P g ≫ j = j :=
    colimit.w A (show SingleObj.star (Aut P) ⟶ SingleObj.star (Aut P) from g)
  exact (Category.assoc _ _ j).symm.trans
    ((congrArg (· ≫ j) (geometryAutMap_face D P g S).symm).trans
      ((Category.assoc (colimit.ι B S) (geometryAutMap D P g) j).trans
        (congrArg (colimit.ι B S ≫ ·) hg)))

/-- Naturality for every actual original full marked morphism follows
from its independently proved original permutation/face factorization. -/
theorem boundaryQuotientLeg_naturality (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    {S T : FullProfilePunctured P} (f : S ⟶ T) :
    (fullPuncturedTensor D P).map f ≫ boundaryQuotientLeg D P T =
      boundaryQuotientLeg D P S := by
  let m := f.hom.hom
  let g := cubeProfileAut P m
  let Sg := (profileAutPunctured P g).obj S
  let h : Sg ⟶ T := homOfLE (cubeProfileAut_subset P m)
  have hm : D.map m = D.map (profileAutInputVertexIso P g S.1).hom ≫
      (geometryPuncturedTensor D P).map h := cubeProfileAut_tensor_factor D P m
  exact (congrArg (· ≫ boundaryQuotientLeg D P T) hm).trans
    ((Category.assoc _ _ _).trans
      ((congrArg (D.map (profileAutInputVertexIso P g S.1).hom ≫ ·)
        (boundaryQuotientLeg_face D P h)).trans (boundaryQuotientLeg_aut D P g S)))

/-- The full original punctured profile category has the actual boundary
Aut(P) quotient as its constructed cofan target, with literal original legs. -/
def fullProfileBoundaryCocone (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) :
    Cocone (fullPuncturedTensor D P) where
  pt := colimit (geometryBoundaryActionFunctor D P)
  ι.app S := boundaryQuotientLeg D P S
  ι.naturality _ _ f := (boundaryQuotientLeg_naturality D P f).trans (Category.comp_id _).symm


end Diagram

