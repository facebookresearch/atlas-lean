/-!
## Original representative boundary and top cofans, with both colimit proofs
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]

local instance representativeCofanSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance representativeCofanAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- Restrict `D` to the degree-`n` marked-input category. -/
def rawDegreeDiagram (D : MarkedInputs W ⥤ C) (n : ℕ) : DegreeMarkedInputs W n ⥤ C :=
  degreeMarkedInclusion (W := W) n ⋙ D

/-- Restrict the degree-marked diagram to its punctured subcategory. -/
def rawPuncturedDegreeDiagram (D : MarkedInputs W ⥤ C) (n : ℕ) : PuncturedMarkedInputs W n ⥤ C :=
  puncturedMarkedInclusion (W := W) n ⋙ rawDegreeDiagram D n

/-- Restrict the degree-marked diagram to a profile-class representative cube. -/
def representativeCubeDiagram (D : MarkedInputs W ⥤ C) {n : ℕ} (s : ProfileClass W n) :
    RepresentativeCube s ⥤ C := representativeCubeInclusion s ⋙ rawDegreeDiagram D n

/-- Restrict the punctured degree-marked diagram to a representative punctured cube. -/
def representativePuncturedDiagram (D : MarkedInputs W ⥤ C) {n : ℕ} (s : ProfileClass W n) :
    RepresentativePunctured s ⥤ C := puncturedRepresentativeInclusion s ⋙ rawPuncturedDegreeDiagram D n

/-- Literal original Aut(P) boundary quotient legs for the representative
proper faces, after the proved original finite input-top comparison. -/
def representativeBoundaryCocone (D : MarkedInputs W ⥤ C) (d : W) {n : ℕ}
    (s : ProfileClass W n) : Cocone (representativePuncturedDiagram D s) :=
  (fullProfileBoundaryCocone D (representativeProfile d s)).whisker
    (representativeFullPuncturedFunctor d s)

/-- The representative boundary colimit structure, transported along the final punctured-cube
inclusion. -/
def representativeBoundaryIsColimit (D : MarkedInputs W ⥤ C) (d : W) {n : ℕ}
    (s : ProfileClass W n) : IsColimit (representativeBoundaryCocone D d s) :=
  (Functor.Final.isColimitWhiskerEquiv (representativeFullPuncturedFunctor d s)
    (fullProfileBoundaryCocone D (representativeProfile d s))).symm
      (fullProfileBoundaryIsColimit D (representativeProfile d s))

/-- Literal original coordinate-to-top map followed by the actual original
Aut(P) top quotient projection, on every original representative vertex. -/
def representativeTopCocone (D : MarkedInputs W ⥤ C) (d : W) {n : ℕ}
    (s : ProfileClass W n) : Cocone (representativeCubeDiagram D s) :=
  (fullProfileTopCocone D (representativeProfile d s)).whisker (representativeFullCubeFunctor d s)

/-- The representative top colimit structure, transported along the final full-cube inclusion. -/
def representativeTopIsColimit (D : MarkedInputs W ⥤ C) (d : W) {n : ℕ}
    (s : ProfileClass W n) : IsColimit (representativeTopCocone D d s) :=
  (Functor.Final.isColimitWhiskerEquiv (representativeFullCubeFunctor d s)
    (fullProfileTopCocone D (representativeProfile d s))).symm
      (fullProfileTopIsColimit D (representativeProfile d s))

/-- Every original proper face retains the actual original balanced
boundary-to-top arrow between the two constructed quotient cofans. -/
theorem representativeBoundaryTop_square (D : MarkedInputs W ⥤ C) (d : W) {n : ℕ}
    (s : ProfileClass W n) (S : RepresentativePunctured s) :
    (representativeBoundaryCocone D d s).ι.app S ≫ (geometryBalancedProfileArrow D (representativeProfile d s)).hom =
      (representativeTopCocone D d s).ι.app S.1 := by
  let P := representativeProfile d s
  let S' := toOriginalProperSet s d S
  let B := geometryPuncturedTensor D P
  let A := geometryBoundaryActionFunctor D P
  let T := geometryInputTopActionFunctor D P
  let j := colimit.ι A (SingleObj.star (Aut P))
  let k := colimit.ι T (SingleObj.star (Aut P))
  have hj : j ≫ (geometryBalancedProfileArrow D P).hom = geometryBoundaryToTop D P ≫ k :=
    ι_colimMap (geometryBoundaryTopTransformation D P) (SingleObj.star (Aut P))
  exact (Category.assoc (colimit.ι B S') j (geometryBalancedProfileArrow D P).hom).trans
    ((congrArg (colimit.ι B S' ≫ ·) hj).trans
      ((Category.assoc (colimit.ι B S') (geometryBoundaryToTop D P) k).symm.trans
        (congrArg (· ≫ k) (geometryBoundaryToTop_face D P S'))))


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
