/-!
## Actual finite-profile classes and original marked-face representatives

The representatives are chosen from the genuine degree color groupoid.
Their vertices retain the original marked input family. Each coordinate
normalization is an actual original marked-input isomorphism.
-/

set_option autoImplicit false
noncomputable section
universe uc us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- Classical equality on representative input coordinates for the profile-class cube. -/
local instance representativeIndexDecidableEq (n : ℕ) : DecidableEq (Fin n) := Classical.decEq _

/-- Every actual degree-color morphism is its original finite-family
isomorphism; the input permutation and all original colors are retained. -/
def pureDegreeHomIso {n : ℕ} {P Q : PureDegreeInputs W n} (f : P ⟶ Q) : P ≅ Q := by
  let m := (pureDegreeInclusion (W := W) n).map f
  let e := FiniteFamily.isoOfComponents m.equiv (fun i => asIso (m.hom i))
  have he : e.hom = m := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      exact HEq.rfl
  refine ⟨f, InducedCategory.homMk e.inv, ?_, ?_⟩
  · apply (pureDegreeInclusion (W := W) n).map_injective
    change m ≫ e.inv = 𝟙 _
    exact (congrArg (· ≫ e.inv) he.symm).trans e.hom_inv_id
  · apply (pureDegreeInclusion (W := W) n).map_injective
    change e.inv ≫ m = 𝟙 _
    exact (congrArg (e.inv ≫ ·) he.symm).trans e.inv_hom_id

instance pureDegreeGroupoid (n : ℕ) : Groupoid (PureDegreeInputs W n) :=
  Groupoid.ofIsIso (fun f => by
    have h : IsIso (pureDegreeHomIso f).hom := inferInstance
    exact h)

/-- Isomorphism classes of the actual original degree-n color profiles. -/
abbrev ProfileClass (W : Type uc) (n : ℕ) := Skeleton (PureDegreeInputs W n)

/-- The representative is an actual object of the original color groupoid. -/
def representativeWord {n : ℕ} (s : ProfileClass W n) : PureDegreeInputs W n :=
  (fromSkeleton (PureDegreeInputs W n)).obj s

theorem representativeWord_class {n : ℕ} (s : ProfileClass W n) :
    toSkeleton (representativeWord s) = s := toSkeleton_fromSkeleton_obj s

/-- The original full colored profile at the original output and degree. -/
def representativeProfile (d : W) {n : ℕ} (s : ProfileClass W n) : ColoredProfile W :=
  ⟨FintypeCat.of (Fin n), representativeWord s, d⟩

theorem representativeProfile_output (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeProfile d s).outputColor = d := rfl

theorem representativeProfile_degree (d : W) {n : ℕ} (s : ProfileClass W n) :
    inputCount (representativeProfile d s) = n := by
  rw [inputCount, Fintype.card_eq_nat_card]
  exact Nat.card_fin n

instance profileClassSmall [Small.{us} W] (n : ℕ) : Small.{us} (ProfileClass W n) := by
  apply small_of_surjective.{us} (f := fun q : PureDegreeInputs W n => toSkeleton q)
  intro s
  exact ⟨representativeWord s, representativeWord_class s⟩

/-- The class of a genuine original marked family forgets only its marks. -/
def degreeClass {n : ℕ} (q : DegreeMarkedInputs W n) : ProfileClass W n :=
  toSkeleton ((forgetDegreeMarks (W := W) n).obj q)

theorem degreeClass_map {n : ℕ} {q r : DegreeMarkedInputs W n} (f : q ⟶ r) :
    degreeClass q = degreeClass r :=
  congr_toSkeleton_of_iso (asIso ((forgetDegreeMarks (W := W) n).map f))

/-- Every original coordinate is its actual old or top one-slot coordinate. -/
theorem oneCoordinate (a : FiniteCube.Index 1) :
    (if (0 : Fin 1) ∈ a then (Finset.univ : FiniteCube.Index 1) else ∅) = a := by
  classical
  apply Finset.ext
  intro i
  have hi : i = (0 : Fin 1) := Subsingleton.elim _ _
  subst i
  by_cases h : (0 : Fin 1) ∈ a <;> simp only [h, ite_true, ite_false, Finset.mem_univ,
    Finset.notMem_empty, iff_self]

/-- An actual original subset vertex of the representative, with all colors. -/
def representativeVertex {n : ℕ} (s : ProfileClass W n) (S : Finset (Fin n)) :
    DegreeMarkedInputs W n :=
  fun i => ((if i ∈ S then Finset.univ else ∅),
    Discrete.mk (representativeWord s i))

theorem representativeVertex_original (d : W) {n : ℕ} (s : ProfileClass W n)
    (S : Finset (Fin n)) :
    (degreeMarkedInclusion (W := W) n).obj (representativeVertex s S) =
      (originalInputCube (representativeProfile d s)).obj S := rfl

theorem representativeVertex_forget {n : ℕ} (s : ProfileClass W n)
    (S : Finset (Fin n)) :
    (forgetDegreeMarks (W := W) n).obj (representativeVertex s S) = representativeWord s := rfl

theorem representativeVertex_class {n : ℕ} (s : ProfileClass W n)
    (S : Finset (Fin n)) : degreeClass (representativeVertex s S) = s :=
  representativeWord_class s

/-- A genuine original color-preserving input isomorphism to a representative. -/
def normalizationColorIso {n : ℕ} (q : DegreeMarkedInputs W n) :
    representativeWord (degreeClass q) ≅ (forgetDegreeMarks (W := W) n).obj q :=
  fromSkeletonToSkeletonIso _

/-- The input permutation that normalizes a marked word to its profile-class representative. -/
def normalizationInputEquiv {n : ℕ} (q : DegreeMarkedInputs W n) : Fin n ≃ Fin n :=
  ((pureDegreeInclusion (W := W) n).map (normalizationColorIso q).hom).equiv

/-- The subset records precisely the actual top coordinates after the
actual representative input bijection; no degree is omitted. -/
def normalizationSubset {n : ℕ} (q : DegreeMarkedInputs W n) : Finset (Fin n) :=
  Finset.univ.filter (fun i => (0 : Fin 1) ∈ (q (normalizationInputEquiv q i)).1)

theorem normalization_coordinate {n : ℕ} (q : DegreeMarkedInputs W n) (i : Fin n) :
    ((representativeVertex (degreeClass q) (normalizationSubset q)) i).1 =
      (q (normalizationInputEquiv q i)).1 := by
  classical
  change (if i ∈ normalizationSubset q then (Finset.univ : FiniteCube.Index 1) else ∅) = _
  simp only [normalizationSubset, Finset.mem_filter, Finset.mem_univ, true_and]
  exact oneCoordinate _

/-- The normalization is the actual original finite-family isomorphism,
with its original input permutation and every original coordinate/color map. -/
def normalizationMarkedIso {n : ℕ} (q : DegreeMarkedInputs W n) :
    (degreeMarkedInclusion (W := W) n).obj
        (representativeVertex (degreeClass q) (normalizationSubset q)) ≅
      (degreeMarkedInclusion (W := W) n).obj q :=
  FiniteFamily.isoOfComponents (normalizationInputEquiv q)
    (fun i => by
      let h : Discrete.mk (representativeWord (degreeClass q) i) ⟶
          (q (normalizationInputEquiv q i)).2 :=
        ((pureDegreeInclusion (W := W) n).map (normalizationColorIso q).hom).hom i
      exact Iso.prod (eqToIso (normalization_coordinate q i)) (Discrete.eqToIso (Discrete.eq_of_hom h)))

/-- Identify the normalized representative vertex with the original marked word. -/
def normalizationIso {n : ℕ} (q : DegreeMarkedInputs W n) :
    representativeVertex (degreeClass q) (normalizationSubset q) ≅ q where
  hom := InducedCategory.homMk (normalizationMarkedIso q).hom
  inv := InducedCategory.homMk (normalizationMarkedIso q).inv
  hom_inv_id := by
    apply (degreeMarkedInclusion (W := W) n).map_injective
    exact (normalizationMarkedIso q).hom_inv_id
  inv_hom_id := by
    apply (degreeMarkedInclusion (W := W) n).map_injective
    exact (normalizationMarkedIso q).inv_hom_id

theorem normalizationIso_inputs {n : ℕ} (q : DegreeMarkedInputs W n) :
    ((degreeMarkedInclusion (W := W) n).map (normalizationIso q).hom).equiv =
      normalizationInputEquiv q := rfl

/-- Every actual punctured marked profile normalizes to an actual proper
subset of the same original representative input set. -/
theorem normalizationSubset_punctured {n : ℕ} (q : PuncturedMarkedInputs W n) :
    normalizationSubset q.1 ≠ Finset.univ := by
  intro h
  rcases q.2 with ⟨i, hi⟩
  let j := (normalizationInputEquiv q.1).symm i
  have hj : j ∈ normalizationSubset q.1 := h.symm ▸ Finset.mem_univ j
  have hc := normalization_coordinate q.1 j
  change (if j ∈ normalizationSubset q.1 then (Finset.univ : FiniteCube.Index 1) else ∅) = _ at hc
  rw [ite_eq_left hj] at hc
  have he : normalizationInputEquiv q.1 j = i := Equiv.apply_symm_apply _ _
  exact hi ((congrArg (fun k => (q.1 k).1) he).symm.trans hc.symm)

/-- The full fixed-profile cube category retains all actual original
profile automorphisms as well as every original subset face. -/
abbrev RepresentativeCube {n : ℕ} (s : ProfileClass W n) :=
  InducedCategory (DegreeMarkedInputs W n) (representativeVertex s)

/-- Include a profile-class representative cube into the degree-marked category. -/
def representativeCubeInclusion {n : ℕ} (s : ProfileClass W n) :
    RepresentativeCube s ⥤ DegreeMarkedInputs W n := inducedFunctor _

/-- The full subcategory of a representative cube on its proper input subsets. -/
abbrev RepresentativePunctured {n : ℕ} (s : ProfileClass W n) :=
  InducedCategory (RepresentativeCube s)
    (fun S : {S : Finset (Fin n) // S ≠ Finset.univ} => S.1)

/-- Include the punctured representative cube into its full representative cube. -/
def representativePuncturedInclusion {n : ℕ} (s : ProfileClass W n) :
    RepresentativePunctured s ⥤ RepresentativeCube s := inducedFunctor _

/-- The disjoint union is indexed by actual original profile classes. -/
abbrev CubeIndex (W : Type uc) (n : ℕ) := Σ s : ProfileClass W n, RepresentativeCube s

/-- Include the coproduct of profile-class representative cubes into degree-marked inputs. -/
def cubeInclusion (n : ℕ) : CubeIndex W n ⥤ DegreeMarkedInputs W n :=
  Sigma.desc (fun s => representativeCubeInclusion s)

instance cubeInclusionFull (n : ℕ) : (cubeInclusion (W := W) n).Full where
  map_surjective := by
    rintro ⟨s, S⟩ ⟨t, T⟩ f
    have h : s = t := (representativeVertex_class s S).symm.trans
      ((degreeClass_map f).trans (representativeVertex_class t T))
    subst t
    exact ⟨Sigma.SigmaHom.mk (InducedCategory.homMk f), rfl⟩

instance cubeInclusionFaithful (n : ℕ) : (cubeInclusion (W := W) n).Faithful where
  map_injective := by
    rintro ⟨s, S⟩ ⟨t, T⟩ ⟨f⟩ ⟨g⟩ h
    change f.hom = g.hom at h
    exact congrArg Sigma.SigmaHom.mk (InducedCategory.hom_ext h)

instance cubeInclusionEssSurj (n : ℕ) : (cubeInclusion (W := W) n).EssSurj where
  mem_essImage q := ⟨⟨degreeClass q, normalizationSubset q⟩, ⟨normalizationIso q⟩⟩

instance cubeInclusionIsEquivalence (n : ℕ) : (cubeInclusion (W := W) n).IsEquivalence where

/-- The equivalence between the profile-class cube index and degree-marked inputs. -/
def cubeEquivalence (n : ℕ) : CubeIndex W n ≌ DegreeMarkedInputs W n :=
  (cubeInclusion (W := W) n).asEquivalence


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells


end
