section AttachmentSource055


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource055_composeThreePost {D : Type*} [Category* D] {A B C E Z : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ Z) :
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The exact original common successive-contraction source followed by the
unchanged original simultaneous factor map is the original marked contraction
source followed by the actual survivor and old-input relabelling maps. -/
theorem iterationCommonSource_triangle (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    iterationCommonSourceMap O x d g ≫
      (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
        (normalizedSimultaneousFactorMap O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g))
        (𝟙 (iterationSurvivorLeaves Xprime d (residualMarkedInputs g)))) =
    (markedContractionFactorsIso O x d P).hom ≫
      (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
        (contractionInputMap O X (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom)
        (profileLeafIso Xprime (residualSurvivorProfileHom d g)).hom) := by
  let R := residualMarkedInputs g
  let K := iterationCoefficientInputs O X d g
  let M := iterationOldLeaves X R
  let L := iterationSurvivorLeaves Xprime d R
  let a := (partialMarkedFactorsIso O x d g).hom
  let b := iterationNormalizationMap O x d g
  let c := (LeafFusion.rawIso K M L).inv
  let e := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (normalizedSimultaneousFactorMap O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g)) (𝟙
      L))
  have h : c ≫ e = simultaneousFusionMap O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g)
    L :=
    simultaneousFusionMap_original O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g) L
  exact (AttachmentSource055_composeThreePost a b c e).trans
    ((congrArg (a ≫ b ≫ ·) h).trans (EndpointRelations.iterationSource_triangle O x d g))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource055


section AttachmentSource056


/-!
## The iterated old/survivor source is the unchanged original marked contraction source
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource056_dependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The original residual root selection and original old/survivor leaf map
followed by the original output frame are exactly the existing marked source map. -/
theorem iterationSource_original (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (R : MarkedInputs W) :
    coefficientLeafMap (O.map (asIso (selectionRootHom d R)).inv) (iterationLeafIso x d R).hom ≫
      (LeafFusion.outputIso (O.obj (extendProfile (survivingProfile d R) (contractedInputs R)))
        (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)).hom =
      (markedContractionFactorsIso O x d R).hom := by
  let M := iterationOldLeaves X R
  let L := iterationSurvivorLeaves Xprime d R
  let X0 := O.obj (extendProfile (survivingProfile d R) (contractedInputs R))
  let out := (LeafFusion.outputIso X0 M L).hom
  let B := markedContractionFactors O X Xprime d R
  let e := (iterationLeafIso x d R).hom
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i =>
        by_cases hi : SelectedInput R i
        · change out.equiv (some (e.equiv i)) = (markedContractionFactorsIso O x d R).hom.equiv (some i)
          exact ((congrArg (fun j => out.equiv (some j)) (iterationLeaf_position_top x d R i hi)).trans rfl).trans
            (markedContraction_position_top O x d R i hi).symm
        · change out.equiv (some (e.equiv i)) = (markedContractionFactorsIso O x d R).hom.equiv (some i)
          exact ((congrArg (fun j => out.equiv (some j)) (iterationLeaf_position_old x d R i hi)).trans rfl).trans
            (markedContraction_position_old O x d R i hi).symm
  · intro i
    cases i with
    | none =>
        let f := O.map (asIso (selectionRootHom d R)).inv
        change HEq (f ≫ 𝟙 X0) f
        exact heq_of_eq (Category.comp_id f)
    | some i =>
        by_cases hi : SelectedInput R i
        · let p := e.equiv i
          have hp : p = Sum.inr ⟨i, hi⟩ := iterationLeaf_position_top x d R i hi
          have ha : (LeafFusion.leafSum M L).obj p = Xprime (R.obj i).2.as := congrArg (LeafFusion.leafSum M L).obj hp
          have hb : B.obj (out.equiv (some p)) = Xprime (R.obj i).2.as :=
            congrArg (fun j => B.obj (out.equiv (some j))) hp
          have ho : HEq (out.hom (some p)) (𝟙 (Xprime (R.obj i).2.as)) :=
            (AttachmentSource056_dependentApply out.hom (congrArg some hp)).trans HEq.rfl
          have hc := heq_comp rfl ha hb (iterationLeaf_component_top x d R i hi) ho
          exact hc.trans ((heq_of_eq (Category.comp_id (eqToHom (markedTopCarrierEq x R i hi)))).trans
            (markedContraction_component_top O x d R i hi).symm)
        · let p := e.equiv i
          have hp : p = Sum.inl ⟨i, hi⟩ := iterationLeaf_position_old x d R i hi
          have ha : (LeafFusion.leafSum M L).obj p = X (R.obj i).2.as := congrArg (LeafFusion.leafSum M L).obj hp
          have hb : B.obj (out.equiv (some p)) = X (R.obj i).2.as :=
            congrArg (fun j => B.obj (out.equiv (some j))) hp
          have ho : HEq (out.hom (some p)) (𝟙 (X (R.obj i).2.as)) :=
            (AttachmentSource056_dependentApply out.hom (congrArg some hp)).trans HEq.rfl
          have hc := heq_comp rfl ha hb (iterationLeaf_component_old x d R i hi) ho
          exact hc.trans ((heq_of_eq (Category.comp_id (eqToHom (markedCarrier_old x (R.obj i).1 hi (R.obj
            i).2.as)))).trans
            (markedContraction_component_old O x d R i hi).symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource056


section AttachmentSource057


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource057_cancelFrame {D : Type*} [Category* D] {A B X Y : D}
    (e : X ≅ Y) (a : A ⟶ B) (b : B ⟶ Y) : (a ≫ b ≫ e.inv) ≫ e.hom = a ≫ b := by
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem iterationCommonSourceMap_cancel (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    iterationCommonSourceMap O x d g ≫
      (LeafFusion.rawIso (iterationCoefficientInputs O X d g)
        (iterationOldLeaves X (residualMarkedInputs g))
        (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))).hom =
      (partialMarkedFactorsIso O x d g).hom ≫ iterationNormalizationMap O x d g :=
  AttachmentSource057_cancelFrame _ _ _

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationIterationReadbackFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationIterationReadbackSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationIterationReadbackProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The unchanged original residual normalized contraction has exactly the
original residual root map, original old/survivor input map and original final evaluation. -/
theorem normalizedMarkedFaceContraction_iteration (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (R : MarkedInputs W) :
    normalizedMarkedFaceContraction E x a d R =
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (E.toCollection.map (asIso (selectionRootHom d R)).inv) (iterationLeafIso x d R).hom) ≫
      (FiniteTensor.tensor (V := C)).map
        (LeafFusion.outputIso (E.toCollection.obj (extendProfile (survivingProfile d R) (contractedInputs R)))
          (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)).hom ≫
      coefficientContractionTensor E a (survivingProfile d R) (contractedInputs R)
        (iterationSurvivorLeaves Xprime d R) ≫
      (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d R)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let r := T.map (coefficientLeafMap (E.toCollection.map (asIso (selectionRootHom d R)).inv)
    (iterationLeafIso x d R).hom)
  let v := T.map (LeafFusion.outputIso
    (E.toCollection.obj (extendProfile (survivingProfile d R) (contractedInputs R)))
    (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)).hom
  let c := coefficientContractionTensor E a (survivingProfile d R) (contractedInputs R)
    (iterationSurvivorLeaves Xprime d R)
  let p := (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d R)).hom
  have hsource : T.map (markedContractionFactorsIso E.toCollection x d R).hom = r ≫ v :=
    (congrArg T.map (iterationSource_original E.toCollection x d R).symm).trans (T.map_comp _ _)
  have h : normalizedMarkedFaceContraction E x a d R =
      T.map (markedContractionFactorsIso E.toCollection x d R).hom ≫ c ≫ p :=
    normalizedMarkedFaceContraction_deleted E x a d R
  exact h.trans ((congrArg (· ≫ c ≫ p) hsource).trans (Category.assoc r v (c ≫ p)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource057


section AttachmentSource058


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource058_rootEvaluationSquare {D : Type*} [Category* D] {A B B' C E F G H : D}
    (r : A ⟶ B) (c : B ⟶ C) (h : C ⟶ E) (v : E ⟶ F) (d : F ⟶ G) (p : G ⟶ H)
    (m : B ⟶ B') (c' : B' ⟶ E) (hc : c ≫ h = m ≫ c') :
    (r ≫ c) ≫ (h ≫ v ≫ d ≫ p) = r ≫ m ≫ c' ≫ v ≫ d ≫ p := by
  calc
    (r ≫ c) ≫ (h ≫ v ≫ d ≫ p) = r ≫ (c ≫ h) ≫ v ≫ d ≫ p := by simp only [Category.assoc]
    _ = r ≫ (m ≫ c') ≫ v ≫ d ≫ p := congrArg (fun f => r ≫ f ≫ v ≫ d ≫ p) hc
    _ = r ≫ m ≫ c' ≫ v ≫ d ≫ p := by simp only [Category.assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationIterationFirstFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationIterationFirstSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationIterationFirstProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual first partial contraction followed by the unchanged original
residual contraction has its complete original two-stage normalized tensor source. -/
theorem partialMarkedContraction_firstFactor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P Q : MarkedInputs W} (g : P ⟶ Q) :
    partialMarkedContraction E x a d g ≫ normalizedMarkedFaceContraction E x a d (residualMarkedInputs g) =
      (FiniteTensor.tensor (V := C)).map (partialMarkedFactorsIso E.toCollection x d g).hom ≫
      (FiniteTensor.tensor (V := C)).map (iterationNormalizationMap E.toCollection x d g) ≫
      coefficientContractionTensor E a
        (extendProfile (iterationProfile d g) (iterationOldInputs g)) (iterationRemainingInputs g)
        (LeafFusion.leafSum (iterationOldLeaves X (residualMarkedInputs g))
          (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))) ≫
      (FiniteTensor.tensor (V := C)).map
        (LeafFusion.outputIso (E.toCollection.obj (extendProfile (iterationProfile d g) (iterationOldInputs g)))
          (iterationOldLeaves X (residualMarkedInputs g))
          (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))).hom ≫
      coefficientContractionTensor E a (iterationProfile d g) (iterationOldInputs g)
        (iterationSurvivorLeaves Xprime d (residualMarkedInputs g)) ≫
      (profileCoefficientLeafTensorIso E.toCollection Xprime (iterationProfile d g)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let R := residualMarkedInputs g
  let S := iterationProfile d g
  let Q1 := iterationOldInputs g
  let Q2 := iterationRemainingInputs g
  let M := iterationOldLeaves X R
  let L := iterationSurvivorLeaves Xprime d R
  let r := T.map (partialMarkedFactorsIso E.toCollection x d g).hom
  let c := coefficientContractionTensor E a (survivingProfile d Q) Q2 (residualLeafFamily x g)
  let h := T.map (coefficientLeafMap (E.toCollection.map (iterationRootHom d g)) (iterationLeafIso x d R).hom)
  let v := T.map (LeafFusion.outputIso (E.toCollection.obj (extendProfile S Q1)) M L).hom
  let e := coefficientContractionTensor E a S Q1 L
  let p := (profileCoefficientLeafTensorIso E.toCollection Xprime S).hom
  let m := T.map (iterationNormalizationMap E.toCollection x d g)
  let c' := coefficientContractionTensor E a (extendProfile S Q1) Q2 (LeafFusion.leafSum M L)
  have hc : c ≫ h = m ≫ c' :=
    (coefficientContractionTensor_joint E a (iterationRootHom d g) (𝟙 Q2) (iterationLeafIso x d R).hom).symm
  have hn : normalizedMarkedFaceContraction E x a d R = h ≫ v ≫ e ≫ p :=
    normalizedMarkedFaceContraction_iteration E x a d R
  change (r ≫ c) ≫ normalizedMarkedFaceContraction E x a d R = r ≫ m ≫ c' ≫ v ≫ e ≫ p
  exact (congrArg ((r ≫ c) ≫ ·) hn).trans (AttachmentSource058_rootEvaluationSquare r c h v e p m c' hc)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource058


section AttachmentSource059


/-!
## Original sequential contraction on its exact coefficient/leaf source comparison
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationNormalizedSequentialFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationNormalizedSequentialSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationNormalizedSequentialProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original sequential contraction precomposed by its actual original
coefficient/leaf grouping comparison. -/
def normalizedSequentialInputContraction (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
      (constantInputFamily E.toCollection X (extendProfile P Q1) Q2) ((addedAlgebraInputs X).obj Q1))) ⟶
      E.toCollection.obj P :=
  (FiniteTensor.tensor (V := C)).map
      ((FiniteFamily.flatten (C := C)).map (sequentialInputGroupingIso E.toCollection X P Q1 Q2).inv) ≫
    sequentialInputContraction E a P Q1 Q2

theorem normalizedSequentialInputContraction_split (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    normalizedSequentialInputContraction E a P Q1 Q2 =
      (coefficientLeavesNormalization (constantInputFamily E.toCollection X (extendProfile P Q1) Q2)
        ((addedAlgebraInputs X).obj Q1) ≫
        (coefficientLeafTensorFunctor ((addedAlgebraInputs X).obj Q1)).map
          (deletedCoefficientContraction E a (extendProfile P Q1) Q2)) ≫
      deletedCoefficientContraction E a P Q1 := by
  let e := (FiniteTensor.tensor (V := C)).mapIso
    ((FiniteFamily.flatten (C := C)).mapIso (sequentialInputGroupingIso E.toCollection X P Q1 Q2))
  exact (congrArg (e.inv ≫ ·) (sequentialInputContraction_split E a P Q1 Q2)).trans
    (Iso.inv_hom_id_assoc e _)

/-- Original disjoint coefficient association gives the unchanged original
simultaneous contraction through the same exact original grouping comparison. -/
theorem normalizedSequentialInputContraction_assoc (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    normalizedSequentialInputContraction E a P Q1 Q2 =
      (FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.flatten (C := C)).map (sequentialInputGroupingIso E.toCollection X P Q1 Q2).inv) ≫
        simultaneousInputContraction E a P Q1 Q2 :=
  congrArg ((FiniteTensor.tensor (V := C)).map
    ((FiniteFamily.flatten (C := C)).map (sequentialInputGroupingIso E.toCollection X P Q1 Q2).inv) ≫ ·)
      (sequentialInputContraction_eq_simultaneous E a P Q1 Q2)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource059


section AttachmentSource060


set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

open CategoryTheory

private theorem AttachmentSource060_mapPostRoute {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A : E} {X Y Z : D} (n : A ⟶ F.obj X) (f : X ⟶ Y) (d : Y ⟶ Z)
    (r : A ⟶ F.obj Y) (h : n ≫ F.map f = r) :
    n ≫ F.map (f ≫ d) = r ≫ F.map d :=
  (congrArg (n ≫ ·) (F.map_comp f d)).trans
    ((Category.assoc n (F.map f) (F.map d)).symm.trans (congrArg (· ≫ F.map d) h))

private theorem AttachmentSource060_fivePost {D : Type*} [Category* D] {A B C E F G H : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) (e : F ⟶ G) (h : G ⟶ H) :
    (a ≫ b ≫ c ≫ d ≫ e) ≫ h = a ≫ b ≫ c ≫ d ≫ e ≫ h := by
  simp only [Category.assoc]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The original two-level tensor fusion retains an arbitrary actual
final coefficient evaluation, with both original input groups unchanged. -/
theorem tensorFusion_last (K M L : FiniteFamily C) (X Y : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X)
    (d : (FiniteTensor.tensor (V := C)).obj ((coefficientLeafFamilyFunctor M).obj X) ⟶ Y) :
    coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K M)) L ≫
      (coefficientLeafTensorFunctor L).map
        ((coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor M).map f) ≫ d) =
    (FiniteTensor.tensor (V := C)).map (rawIso K M L).hom ≫
      coefficientLeavesNormalization K (leafSum M L) ≫
      (coefficientLeafTensorFunctor (leafSum M L)).map f ≫
      (FiniteTensor.tensor (V := C)).map (outputIso X M L).hom ≫
      coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L ≫
        (coefficientLeafTensorFunctor L).map d := by
  let n := coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K M)) L
  let U := coefficientLeafTensorFunctor L
  let a := (FiniteTensor.tensor (V := C)).map (rawIso K M L).hom
  let b := coefficientLeavesNormalization K (leafSum M L)
  let c := (coefficientLeafTensorFunctor (leafSum M L)).map f
  let e := (FiniteTensor.tensor (V := C)).map (outputIso X M L).hom
  let p := coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L
  have h := AttachmentSource060_mapPostRoute U n (coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor
    M).map f)
    d (a ≫ b ≫ c ≫ e ≫ p) (tensorFusion K M L X f)
  exact h.trans (AttachmentSource060_fivePost a b c e p (U.map d))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

end
end AttachmentSource060


section AttachmentSource061


/-!
## The original successive contractions factor through their actual sequential coefficient map
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource061_factorToFused {D : Type*} [Category* D]
    {A B C E F G H J K L M : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : A ⟶ E) (raw : E ⟶ C)
    (s : C ⟶ F) (u : F ⟶ G) (v : G ⟶ H) (t : H ⟶ J) (w : J ⟶ K)
    (n : E ⟶ L) (e : L ⟶ K) (p : K ⟶ M)
    (hs : c ≫ raw = a ≫ b) (hf : n ≫ e = raw ≫ s ≫ u ≫ v ≫ t ≫ w) :
    a ≫ b ≫ (s ≫ u) ≫ v ≫ (t ≫ w) ≫ p = c ≫ n ≫ e ≫ p := by
  calc
    a ≫ b ≫ (s ≫ u) ≫ v ≫ (t ≫ w) ≫ p = (a ≫ b) ≫ s ≫ u ≫ v ≫ t ≫ w ≫ p := by simp only [Category.assoc]
    _ = (c ≫ raw) ≫ s ≫ u ≫ v ≫ t ≫ w ≫ p := congrArg (· ≫ s ≫ u ≫ v ≫ t ≫ w ≫ p) hs.symm
    _ = c ≫ (raw ≫ s ≫ u ≫ v ≫ t ≫ w) ≫ p := by simp only [Category.assoc]
    _ = c ≫ (n ≫ e) ≫ p := congrArg (fun f => c ≫ f ≫ p) hf.symm
    _ = c ≫ n ≫ e ≫ p := by simp only [Category.assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationIterationFactorFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationIterationFactorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationIterationFactorProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The literal original first and residual contractions factor through the
original sequential coefficient contraction on the complete original source.
No association or stage law is supplied as a premise. -/
theorem partialMarkedContraction_sequentialFactor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P Q : MarkedInputs W} (g : P ⟶ Q) :
    partialMarkedContraction E x a d g ≫ normalizedMarkedFaceContraction E x a d (residualMarkedInputs g) =
      (FiniteTensor.tensor (V := C)).map (iterationCommonSourceMap E.toCollection x d g) ≫
      coefficientLeavesNormalization
        ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
          (iterationCoefficientInputs E.toCollection X d g) (iterationOldLeaves X (residualMarkedInputs g))))
        (iterationSurvivorLeaves Xprime d (residualMarkedInputs g)) ≫
      (coefficientLeafTensorFunctor (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))).map
        (normalizedSequentialInputContraction E a (iterationProfile d g) (iterationOldInputs g)
          (iterationRemainingInputs g)) ≫
      (profileCoefficientLeafTensorIso E.toCollection Xprime (iterationProfile d g)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let R := residualMarkedInputs g
  let S := iterationProfile d g
  let Q1 := iterationOldInputs g
  let Q2 := iterationRemainingInputs g
  let K := iterationCoefficientInputs E.toCollection X d g
  let M := iterationOldLeaves X R
  let L := iterationSurvivorLeaves Xprime d R
  let X0 := E.toCollection.obj (extendProfile S Q1)
  let Y0 := E.toCollection.obj S
