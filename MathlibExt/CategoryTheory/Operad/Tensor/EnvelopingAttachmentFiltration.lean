/-!
## The original attachment arrow is a constructed transfinite composition of actual profile cells
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping ProfileCells HomotopicalAlgebra

/-- All positive-degree profile classes, indexed together with their attachment stage. -/
abbrev TotalProfileCell (W : Type uc) := Σ N : ℕ, ProfileClass W (N + 1)

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationCellularHistoryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationCellularHistorySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationCellularHistoryProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationCellularHistoryFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The generating arrows are precisely the actual original balanced
coefficient tensor profile cells at their actual original positive degrees. -/
def totalProfileCellArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (i : TotalProfileCell W) : Arrow C :=
  profileStageCellArrow E x d i.1 i.2

/-- The underlying morphism of the profile cell indexed by its stage and class. -/
def totalProfileCellMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (i : TotalProfileCell W) :
    (totalProfileCellArrow E x d i).left ⟶ (totalProfileCellArrow E x d i).right :=
  (totalProfileCellArrow E x d i).hom

/-- The full filtration construction includes the actual original stages,
all profile cells, their pushouts, well-order continuity and the genuine
original endpoint leg. No filtration or cell-history certificate is an input. -/
def attachmentCellTransfiniteComposition (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (MorphismProperty.coproducts.{us} (MorphismProperty.ofHoms (totalProfileCellMap E x
      d))).pushouts.TransfiniteCompositionOfShape
      ℕ ((endpointOldMap E x a).hom d) :=
  (attachmentRelativeCellComplex E x a d).transfiniteCompositionOfShape'
    (fun γ => MorphismProperty.ofHoms.mk (f := totalProfileCellMap E x d) ⟨γ.j, γ.i⟩)

theorem attachmentCellTransfiniteComposition_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) :
    (attachmentCellTransfiniteComposition E x a d).F.map (homOfLE h) = recursiveStageMap E x a d h := rfl

theorem attachmentCellTransfiniteComposition_incl (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (attachmentCellTransfiniteComposition E x a d).incl.app N = recursiveAttachmentStageLeg E x a d N := rfl

@[reassoc]
theorem attachmentCellTransfiniteComposition_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    recursiveProfileCofan E x a N P hP ≫ (attachmentCellTransfiniteComposition E x a P.outputColor).incl.app N =
      profileι E.toCollection Xprime (profileInputs P) ≫ (endpointNewMap E x a).hom P.outputColor :=
  attachmentHistory_profile E x a N P hP

theorem attachment_isCellular (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    MorphismProperty.transfiniteCompositionsOfShape
      (MorphismProperty.coproducts.{us} (MorphismProperty.ofHoms (totalProfileCellMap E x d))).pushouts
        ℕ ((endpointOldMap E x a).hom d) := ⟨attachmentCellTransfiniteComposition E x a d⟩


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
