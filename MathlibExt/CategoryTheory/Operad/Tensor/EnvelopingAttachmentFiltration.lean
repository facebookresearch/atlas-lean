section AttachmentSource160


/-!
## Full original profile-quotient arrow cofans and their universal property
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance rawArrowSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance rawArrowAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance rawArrowDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance rawArrowPuncturedColimits (n : ℕ) :
    HasColimitsOfShape (PuncturedMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The punctured degree cocone given by inclusion into the full degree colimit. -/
def rawBoundaryCocone (D : MarkedInputs W ⥤ C) (n : ℕ) : Cocone (rawPuncturedDegreeDiagram D n) where
  pt := colimit (rawDegreeDiagram D n)
  ι.app q := colimit.ι (rawDegreeDiagram D n) q.1
  ι.naturality _ _ f :=
    (colimit.w (rawDegreeDiagram D n) ((puncturedMarkedInclusion (W := W) n).map f)).trans
      (Category.comp_id _).symm

/-- The colimit map induced by including punctured degree-marked inputs into all degree-marked
inputs. -/
def rawBoundaryToDegree (D : MarkedInputs W ⥤ C) (n : ℕ) :
    colimit (rawPuncturedDegreeDiagram D n) ⟶ colimit (rawDegreeDiagram D n) :=
  colimit.desc _ (rawBoundaryCocone D n)

theorem rawBoundaryToDegree_face (D : MarkedInputs W ⥤ C) (n : ℕ) (q : PuncturedMarkedInputs W n) :
    colimit.ι (rawPuncturedDegreeDiagram D n) q ≫ rawBoundaryToDegree D n =
      colimit.ι (rawDegreeDiagram D n) q.1 := colimit.ι_desc (rawBoundaryCocone D n) q

theorem degreeBoundaryTop_square (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) (s : ProfileClass W n) :
    degreeBoundarySummand D d n s ≫ rawBoundaryToDegree D n =
      (geometryBalancedProfileArrow D (representativeProfile d s)).hom ≫ degreeTopSummand D d n s := by
  apply (representativeBoundaryIsColimit D d s).hom_ext
  intro S
  let j := (representativeBoundaryCocone D d s).ι.app S
  have hb : j ≫ (degreeBoundarySummand D d n s ≫ rawBoundaryToDegree D n) =
      colimit.ι (rawDegreeDiagram D n) (representativeVertex s S.1) :=
    (Category.assoc j _ _).symm.trans
      ((congrArg (· ≫ rawBoundaryToDegree D n) (degreeBoundarySummand_face D d n s S)).trans
        (rawBoundaryToDegree_face D n (representativePuncturedVertex s S)))
  have ht : j ≫ ((geometryBalancedProfileArrow D (representativeProfile d s)).hom ≫ degreeTopSummand D d n s) =
      colimit.ι (rawDegreeDiagram D n) (representativeVertex s S.1) :=
    (Category.assoc j _ _).symm.trans
      ((congrArg (· ≫ degreeTopSummand D d n s) (representativeBoundaryTop_square D d s S)).trans
        (degreeTopSummand_face D d n s S.1))
  exact hb.trans ht.symm

/-- The arrow from the punctured degree colimit to the full degree colimit. -/
def rawDegreeArrow (D : MarkedInputs W ⥤ C) (n : ℕ) : Arrow C := Arrow.mk (rawBoundaryToDegree D n)

/-- Both original profile quotient legs form an actual full arrow cofan. -/
def rawDegreeCellCofan (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) (s : ProfileClass W n) :
    geometryBalancedProfileArrow D (representativeProfile d s) ⟶ rawDegreeArrow D n :=
  Arrow.homMk (degreeBoundarySummand D d n s) (degreeTopSummand D d n s) (degreeBoundaryTop_square D d n s)

/-- The cofan of balanced profile arrows with vertex the raw degree boundary arrow. -/
def rawDegreeArrowCofan (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) :
    Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s)) :=
  Cofan.mk (rawDegreeArrow D n) (rawDegreeCellCofan D d n)

/-- Take the boundary components of a cofan of balanced profile arrows. -/
def arrowTargetBoundaryCofan (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s))) :
    Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).left) :=
  Cofan.mk t.pt.left (fun s => (t.inj s).left)

/-- Take the top components of a cofan of balanced profile arrows. -/
def arrowTargetTopCofan (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s))) :
    Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).right) :=
  Cofan.mk t.pt.right (fun s => (t.inj s).right)

theorem rawDegreeArrowDesc_square (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s))) :
    degreeBoundaryDesc D d n (arrowTargetBoundaryCofan D d n t) ≫ t.pt.hom =
      (rawDegreeArrow D n).hom ≫ degreeTopDesc D d n (arrowTargetTopCofan D d n t) := by
  let l := degreeBoundaryDesc D d n (arrowTargetBoundaryCofan D d n t)
  let r := degreeTopDesc D d n (arrowTargetTopCofan D d n t)
  apply (degreeBoundaryIsColimit D d n).hom_ext
  intro q
  let s := q.as
  let j := degreeBoundarySummand D d n s
  have hl : j ≫ (l ≫ t.pt.hom) = (t.inj s).left ≫ t.pt.hom :=
    (Category.assoc j l t.pt.hom).symm.trans
      (congrArg (· ≫ t.pt.hom) (degreeBoundaryDesc_fac D d n (arrowTargetBoundaryCofan D d n t) s))
  have hr : j ≫ ((rawDegreeArrow D n).hom ≫ r) =
      (geometryBalancedProfileArrow D (representativeProfile d s)).hom ≫ (t.inj s).right :=
    (Category.assoc j _ r).symm.trans
      ((congrArg (· ≫ r) (degreeBoundaryTop_square D d n s)).trans
        ((Category.assoc _ (degreeTopSummand D d n s) r).trans
          (congrArg ((geometryBalancedProfileArrow D (representativeProfile d s)).hom ≫ ·)
            (degreeTopDesc_fac D d n (arrowTargetTopCofan D d n t) s))))
  exact hl.trans ((t.inj s).w.trans hr.symm)

/-- The actual full descendant is built from both original coproduct
descents and their proved original arrow square. -/
def rawDegreeArrowDesc (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s))) :
    (rawDegreeArrowCofan D d n).pt ⟶ t.pt :=
  Arrow.homMk (degreeBoundaryDesc D d n (arrowTargetBoundaryCofan D d n t))
    (degreeTopDesc D d n (arrowTargetTopCofan D d n t)) (rawDegreeArrowDesc_square D d n t)

theorem rawDegreeArrowDesc_fac (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s)))
    (s : ProfileClass W n) : (rawDegreeArrowCofan D d n).inj s ≫ rawDegreeArrowDesc D d n t = t.inj s := by
  apply Arrow.hom_ext
  · exact degreeBoundaryDesc_fac D d n (arrowTargetBoundaryCofan D d n t) s
  · exact degreeTopDesc_fac D d n (arrowTargetTopCofan D d n t) s

theorem rawDegreeArrowDesc_unique (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => geometryBalancedProfileArrow D (representativeProfile d s)))
    (m : (rawDegreeArrowCofan D d n).pt ⟶ t.pt)
    (w : ∀ s, (rawDegreeArrowCofan D d n).inj s ≫ m = t.inj s) :
    m = rawDegreeArrowDesc D d n t := by
  apply Arrow.hom_ext
  · exact degreeBoundaryDesc_unique D d n (arrowTargetBoundaryCofan D d n t) m.left
      (fun s => congrArg Arrow.Hom.left (w s))
  · exact degreeTopDesc_unique D d n (arrowTargetTopCofan D d n t) m.right
      (fun s => congrArg Arrow.Hom.right (w s))

/-- The genuine original profile quotient arrows have the constructed
degree arrow as their coproduct in Arrow C, with both complete endpoint cofans. -/
def rawDegreeArrowIsColimit (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) :
    IsColimit (rawDegreeArrowCofan D d n) :=
  Cofan.IsColimit.mk _ (rawDegreeArrowDesc D d n) (rawDegreeArrowDesc_fac D d n)
    (rawDegreeArrowDesc_unique D d n)


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource160


section AttachmentSource161


/-!
## The original full-degree colimit and its original all-top colimit
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The degree-marked diagram obtained by replacing every marking by full selection. -/
def rawTopDiagram (D : MarkedInputs W ⥤ C) (n : ℕ) : DegreeMarkedInputs W n ⥤ C :=
  degreeMarkedInclusion (W := W) n ⋙ allTopInputs ⋙ D

/-- Replace a degree-marked word by the fully selected word with the same colors. -/
def degreeTopReplacement (n : ℕ) : DegreeMarkedInputs W n ⥤ DegreeMarkedInputs W n :=
  forgetDegreeMarks (W := W) n ⋙ pureToMarked n

/-- Every original coordinate map to its original top, in the original diagram. -/
def rawToTopTransformation (D : MarkedInputs W ⥤ C) (n : ℕ) :
    rawDegreeDiagram D n ⟶ rawTopDiagram D n where
  app q := D.map ((toAllTopInputs (W := W)).app ((degreeMarkedInclusion (W := W) n).obj q))
  naturality _ _ f := (Functor.whiskerRight (toAllTopInputs (W := W)) D).naturality
    ((degreeMarkedInclusion (W := W) n).map f)

theorem rawToTop_originalFace (D : MarkedInputs W ⥤ C) (n : ℕ) (q : DegreeMarkedInputs W n) :
    (rawToTopTransformation D n).app q =
      (rawDegreeDiagram D n).map ((degreeToPureTop (W := W) n).app q) :=
  congrArg D.map (markedHom_ext rfl)

theorem rawTopMap_replacement (D : MarkedInputs W ⥤ C) (n : ℕ)
    {q r : DegreeMarkedInputs W n} (f : q ⟶ r) :
    (rawTopDiagram D n).map f = (rawDegreeDiagram D n).map ((degreeTopReplacement (W := W) n).map f) :=
  congrArg D.map (markedHom_ext rfl)

theorem rawTop_originalFace_identity (D : MarkedInputs W ⥤ C) (n : ℕ) (q : DegreeMarkedInputs W n) :
    (rawTopDiagram D n).map ((degreeToPureTop (W := W) n).app q) =
      𝟙 ((rawTopDiagram D n).obj q) := by
  let m := (allTopInputs (W := W)).map
    ((degreeMarkedInclusion (W := W) n).map ((degreeToPureTop (W := W) n).app q))
  have hm : m = 𝟙 ((allTopInputs (W := W)).obj ((degreeMarkedInclusion (W := W) n).obj q)) :=
    markedHom_ext rfl
  exact (congrArg D.map hm).trans (D.map_id _)

theorem rawToTop_at_replacement (D : MarkedInputs W ⥤ C) (n : ℕ) (q : DegreeMarkedInputs W n) :
    (rawToTopTransformation D n).app ((degreeTopReplacement (W := W) n).obj q) =
      𝟙 ((rawTopDiagram D n).obj q) := by
  let m := (toAllTopInputs (W := W)).app
    ((degreeMarkedInclusion (W := W) n).obj ((degreeTopReplacement (W := W) n).obj q))
  have hm : m = 𝟙 ((degreeMarkedInclusion (W := W) n).obj ((degreeTopReplacement (W := W) n).obj q)) :=
    markedHom_ext rfl
  exact (congrArg D.map hm).trans (D.map_id _)

section Colimit

variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance degreeTopComparisonColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The colimit map induced by replacing every degree marking by full selection. -/
def rawToTopMap (D : MarkedInputs W ⥤ C) (n : ℕ) :
    colimit (rawDegreeDiagram D n) ⟶ colimit (rawTopDiagram D n) :=
  colimMap (rawToTopTransformation D n)

/-- The raw degree colimit cocone on fully selected degree words. -/
def topToRawCocone (D : MarkedInputs W ⥤ C) (n : ℕ) : Cocone (rawTopDiagram D n) where
  pt := colimit (rawDegreeDiagram D n)
  ι.app q := colimit.ι (rawDegreeDiagram D n) ((degreeTopReplacement (W := W) n).obj q)
  ι.naturality _ _ f :=
    (congrArg (· ≫ colimit.ι (rawDegreeDiagram D n) ((degreeTopReplacement (W := W) n).obj _))
      (rawTopMap_replacement D n f)).trans
      ((colimit.w (rawDegreeDiagram D n) ((degreeTopReplacement (W := W) n).map f)).trans
        (Category.comp_id _).symm)

/-- The map from the fully selected degree colimit back to the raw degree colimit. -/
def topToRawMap (D : MarkedInputs W ⥤ C) (n : ℕ) :
    colimit (rawTopDiagram D n) ⟶ colimit (rawDegreeDiagram D n) :=
  colimit.desc _ (topToRawCocone D n)

theorem rawToTopMap_face (D : MarkedInputs W ⥤ C) (n : ℕ) (q : DegreeMarkedInputs W n) :
    colimit.ι (rawDegreeDiagram D n) q ≫ rawToTopMap D n =
      (rawToTopTransformation D n).app q ≫ colimit.ι (rawTopDiagram D n) q :=
  ι_colimMap _ _

theorem topToRawMap_face (D : MarkedInputs W ⥤ C) (n : ℕ) (q : DegreeMarkedInputs W n) :
    colimit.ι (rawTopDiagram D n) q ≫ topToRawMap D n =
      colimit.ι (rawDegreeDiagram D n) ((degreeTopReplacement (W := W) n).obj q) :=
  colimit.ι_desc (topToRawCocone D n) q

theorem rawToTopToRaw (D : MarkedInputs W ⥤ C) (n : ℕ) :
    rawToTopMap D n ≫ topToRawMap D n = 𝟙 (colimit (rawDegreeDiagram D n)) := by
  let F := rawDegreeDiagram D n
  let T := rawTopDiagram D n
  apply colimit.hom_ext (F := F)
  intro q
  exact (Category.assoc (colimit.ι F q) (rawToTopMap D n) (topToRawMap D n)).symm.trans
    ((congrArg (· ≫ topToRawMap D n) (rawToTopMap_face D n q)).trans
      ((Category.assoc _ (colimit.ι T q) (topToRawMap D n)).trans
        ((congrArg ((rawToTopTransformation D n).app q ≫ ·) (topToRawMap_face D n q)).trans
          ((congrArg (· ≫ colimit.ι F ((degreeTopReplacement (W := W) n).obj q))
            (rawToTop_originalFace D n q)).trans
            ((colimit.w F ((degreeToPureTop (W := W) n).app q)).trans (Category.comp_id _).symm)))))

theorem topToRawToTop (D : MarkedInputs W ⥤ C) (n : ℕ) :
    topToRawMap D n ≫ rawToTopMap D n = 𝟙 (colimit (rawTopDiagram D n)) := by
  let T := rawTopDiagram D n
  let R := degreeTopReplacement (W := W) n
  apply colimit.hom_ext (F := T)
  intro q
  have hj : colimit.ι T (R.obj q) = colimit.ι T q :=
    (Category.id_comp (colimit.ι T (R.obj q))).symm.trans
      ((congrArg (· ≫ colimit.ι T (R.obj q)) (rawTop_originalFace_identity D n q)).symm.trans
        (colimit.w T ((degreeToPureTop (W := W) n).app q)))
  exact (Category.assoc (colimit.ι T q) (topToRawMap D n) (rawToTopMap D n)).symm.trans
    ((congrArg (· ≫ rawToTopMap D n) (topToRawMap_face D n q)).trans
      ((rawToTopMap_face D n (R.obj q)).trans
        ((congrArg (· ≫ colimit.ι T (R.obj q)) (rawToTop_at_replacement D n q)).trans
          ((Category.id_comp (colimit.ι T (R.obj q))).trans (hj.trans (Category.comp_id _).symm)))))

/-- Both actual original colimit comparisons, with their original projection
beta equations and inverse laws. No desired all-top colimit is a premise. -/
def rawDegreeTopIso (D : MarkedInputs W ⥤ C) (n : ℕ) :
    colimit (rawDegreeDiagram D n) ≅ colimit (rawTopDiagram D n) where
  hom := rawToTopMap D n
  inv := topToRawMap D n
  hom_inv_id := rawToTopToRaw D n
  inv_hom_id := topToRawToTop D n


end Colimit

end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
