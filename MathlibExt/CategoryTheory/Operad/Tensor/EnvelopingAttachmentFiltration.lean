variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance inputTopFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The profile-automorphism representation on the full coefficient-weighted input tensor. -/
def inputTopRepresentation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Aut P →* End ((originalInputTensorCube E x P).obj Finset.univ) :=
  geometryInputTopRepresentation (markedTensorDiagram E x P.outputColor) P

/-- The actual top representation is precisely the original relabelling map
at the original top followed by its original finite-set-to-top comparison. -/
theorem inputTopRepresentation_hom (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    (inputTopRepresentation E x P g).asHom =
      (markedTensorDiagram E x P.outputColor).map (profileAutInputVertexIso P g Finset.univ).hom ≫
        (originalInputTensorCube E x P).map (eqToHom (profileAutSubset_univ P g)) :=
  geometryInputTopRepresentation_hom (markedTensorDiagram E x P.outputColor) P g

/-- The action diagram on the full coefficient-weighted input tensor. -/
def inputTopActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : SingleObj (Aut P) ⥤ C :=
  SingleObj.functor (inputTopRepresentation E x P)


