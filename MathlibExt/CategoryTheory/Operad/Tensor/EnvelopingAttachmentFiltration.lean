/-!
## Actual original O-algebra descendant and both original algebra factors
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance descFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance descTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance descProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C := hasProfileColimitsOfSmallColors
  C d

variable (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
variable (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A)
variable {M : Algebra O} (a : A ⟶ M) (z : freeAlgebra O Xprime ⟶ M)
variable (h : y ≫ a = (freeAlgebraFunctor O).map x ≫ z)

/-- The actual initial Env endpoint descendant is transported by
the actual constructed equivalence to a genuine original under-A algebra map. -/
def descUnder : endpointUnder O A x y ⟶ Under.mk a :=
  (underEnvHomEquiv O A (envEndpoint O A x y) (Under.mk a)).symm (envDesc O A x y a z h)

/-- Both original compatible O-algebra maps construct an actual full
original O-algebra factor map from the same constructed attachment object. -/
def desc : endpoint O A x y ⟶ M := (descUnder O A x y a z h).right

theorem desc_hom : (desc O A x y a z h).hom = (envDesc O A x y a z h).hom :=
  underEnvHomEquiv_symm_hom O A (envEndpoint O A x y) (Under.mk a) (envDesc O A x y a z h)

/-- The actual original A-leg factors to the given original A-arrow,
by the genuine original under-A triangle of the constructed descendant. -/
theorem oldMap_desc : oldMap O A x y ≫ desc O A x y a z h = a := Under.w (descUnder O A x y a z h)

/-- The actual original Free_O Xprime leg factors to the given
original free-algebra arrow, by the exact original Xprime generator classifier. -/
theorem newMap_desc : newMap O A x y ≫ desc O A x y a z h = z := by
  let e := tensorFreeHomEquiv O Xprime M
  let f := desc O A x y a z h
  have hc : e (newMap O A x y ≫ f) = newGenerators O A x y ≫ f.hom :=
    (tensorFreeHomEquiv_target O Xprime (newMap O A x y) f).trans
      (congrArg (· ≫ f.hom) (newMap_classifier O A x y))
  exact e.injective (hc.trans ((congrArg (newGenerators O A x y ≫ ·) (desc_hom O A x y a z h)).trans
    (envDesc_generators O A x y a z h)))

/-- Every actual original O-algebra map with both original factors
is uniquely the constructed whole original attachment descendant. -/
theorem desc_unique (f : endpoint O A x y ⟶ M)
    (hold : oldMap O A x y ≫ f = a) (hnew : newMap O A x y ≫ f = z) : f = desc O A x y a z h := by
  let B : Under A := Under.mk a
  let u : endpointUnder O A x y ⟶ B := Under.homMk f hold
  let eqv := underEnvHomEquiv O A (envEndpoint O A x y) B
  let fE := eqv u
  let E := envelopingOperad O A
  let target := underAEnvelopingObject O A B
  let eE := tensorFreeHomEquiv E Xprime target
  let eO := tensorFreeHomEquiv O Xprime M
  let j := InitialAttachment.endpointNewMap E x (envAttachingMap O A y)
  let c := eO z
  have hf : fE.hom = f.hom := underEnvHomEquiv_hom O A (envEndpoint O A x y) B u
  have hO : newGenerators O A x y ≫ f.hom = c :=
    ((tensorFreeHomEquiv_target O Xprime (newMap O A x y) f).trans
      (congrArg (· ≫ f.hom) (newMap_classifier O A x y))).symm.trans (congrArg eO hnew)
  have hclass : eE (j ≫ fE) = eE (targetNewEnvMap O A B z) :=
    (tensorFreeHomEquiv_target E Xprime j fE).trans
      ((congrArg (newGenerators O A x y ≫ ·) hf).trans
        (hO.trans (classifier_lift E Xprime target c).symm))
  have hE : fE = envDesc O A x y a z h := envDesc_unique O A x y a z h fE (eE.injective hclass)
  have hu : u = descUnder O A x y a z h := eqv.injective
    (hE.trans (eqv.apply_symm_apply (envDesc O A x y a z h)).symm)
  exact congrArg (fun k : endpointUnder O A x y ⟶ B => k.right) hu

/-- The two original algebra factors determine every whole original
algebra map from the same constructed endpoint. -/
theorem hom_ext {M : Algebra O} {f g : endpoint O A x y ⟶ M}
    (hold : oldMap O A x y ≫ f = oldMap O A x y ≫ g)
    (hnew : newMap O A x y ≫ f = newMap O A x y ≫ g) : f = g := by
  let a := oldMap O A x y ≫ g
  let z := newMap O A x y ≫ g
  have h : y ≫ a = (freeAlgebraFunctor O).map x ≫ z :=
    (Category.assoc y (oldMap O A x y) g).symm.trans
      ((congrArg (· ≫ g) (originalSquare O A x y)).trans (Category.assoc _ _ g))
  exact (desc_unique O A x y a z h f hold hnew).trans (desc_unique O A x y a z h g rfl rfl).symm


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

end
