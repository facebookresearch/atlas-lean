/-!
## Full original partial-contraction associativity on every original marked face
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource064_fourStageRoute {V : Type*} [Category* V] {A B C D E F G H Z : V}
    (c : A ⟶ B) (n : B ⟶ C) (s : C ⟶ D) (p : D ⟶ Z)
    (b : B ⟶ E) (e : E ⟶ D) (r : A ⟶ F) (j : F ⟶ E)
    (e0 : F ⟶ G) (z : G ⟶ D) (p0 : G ⟶ H) (f : H ⟶ Z)
    (hn : n ≫ s = b ≫ e) (hs : c ≫ b = r ≫ j)
    (he : j ≫ e = e0 ≫ z) (hz : z ≫ p = p0 ≫ f) :
    c ≫ n ≫ s ≫ p = (r ≫ e0 ≫ p0) ≫ f := by
  calc
    c ≫ n ≫ s ≫ p = c ≫ (n ≫ s) ≫ p := by simp only [Category.assoc]
    _ = c ≫ (b ≫ e) ≫ p := congrArg (fun h => c ≫ h ≫ p) hn
    _ = (c ≫ b) ≫ e ≫ p := by simp only [Category.assoc]
    _ = (r ≫ j) ≫ e ≫ p := congrArg (· ≫ e ≫ p) hs
    _ = r ≫ (j ≫ e) ≫ p := by simp only [Category.assoc]
    _ = r ≫ (e0 ≫ z) ≫ p := congrArg (fun h => r ≫ h ≫ p) he
    _ = r ≫ e0 ≫ (z ≫ p) := by simp only [Category.assoc]
    _ = r ≫ e0 ≫ (p0 ≫ f) := congrArg (r ≫ e0 ≫ ·) hz
    _ = (r ≫ e0 ≫ p0) ≫ f := by simp only [Category.assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationPartialAssocFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationPartialAssocSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationPartialAssocProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Contracting the original inputs still old after a face map, and then the
original residual old inputs, equals the unchanged original full contraction.
Every original root/input/color map and empty-input correction is retained. -/
theorem partialMarkedContraction_assoc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P Q : MarkedInputs W} (g : P ⟶ Q) :
    partialMarkedContraction E x a d g ≫ normalizedMarkedFaceContraction E x a d (residualMarkedInputs g) =
      normalizedMarkedFaceContraction E x a d P ≫
        (operationSummandFunctor E.toCollection Xprime).map (residualSurvivorProfileHom d g) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let R := residualMarkedInputs g
  let S := iterationProfile d g
  let Q1 := iterationOldInputs g
  let Q2 := iterationRemainingInputs g
  let Qsum := DisjointNullary.inputSum Q1 Q2
  let L := iterationSurvivorLeaves Xprime d R
  let U := coefficientLeafTensorFunctor L
  let k := normalizedSimultaneousFactorMap E.toCollection X S Q1 Q2
  let c := T.map (iterationCommonSourceMap E.toCollection x d g)
  let n := coefficientLeavesNormalization
    (F.obj (coefficientLeavesNested (iterationCoefficientInputs E.toCollection X d g) (iterationOldLeaves X R))) L
  let s := U.map (normalizedSequentialInputContraction E a S Q1 Q2)
  let p := (profileCoefficientLeafTensorIso E.toCollection Xprime S).hom
  let b := T.map (F.map (coefficientLeavesNestedMap k (𝟙 L)))
  let e := coefficientContractionTensor E a S Qsum L
  let r := T.map (markedContractionFactorsIso E.toCollection x d P).hom
  let f0 := residualSurvivorProfileHom d g
  let l0 := (profileLeafIso Xprime f0).hom
  let j := T.map (F.map (coefficientLeavesNestedMap
    (contractionInputMap E.toCollection X f0 (iterationContractedInputsIso g).hom) l0))
  let S0 := survivingProfile d P
  let Q0 := contractedInputs P
  let L0 := profileLeafFamily Xprime S0
  let e0 := coefficientContractionTensor E a S0 Q0 L0
  let z := T.map (coefficientLeafMap (E.toCollection.map f0) l0)
  let p0 := (profileCoefficientLeafTensorIso E.toCollection Xprime S0).hom
  let f := (operationSummandFunctor E.toCollection Xprime).map f0
  have hn : n ≫ s = b ≫ e :=
    (congrArg (n ≫ ·) (congrArg U.map (normalizedSequentialInputContraction_simFactor E a S Q1 Q2))).trans
      (TensorNormalization.normalization_preMap k (deletedCoefficientContraction E a S Qsum))
  have hs : c ≫ b = r ≫ j := (T.map_comp _ _).symm.trans
    ((congrArg T.map (iterationCommonSource_triangle E.toCollection x d g)).trans (T.map_comp _ _))
  have he : j ≫ e = e0 ≫ z := coefficientContractionTensor_joint E a f0 (iterationContractedInputsIso g).hom l0
  have hz : z ≫ p = p0 ≫ f := (profileCoefficientLeafTensorIso_naturality E.toCollection Xprime f0).symm
  have hseq : partialMarkedContraction E x a d g ≫ normalizedMarkedFaceContraction E x a d R = c ≫ n ≫ s ≫ p :=
    partialMarkedContraction_sequentialFactor E x a d g
  have hnorm : normalizedMarkedFaceContraction E x a d P = r ≫ e0 ≫ p0 := normalizedMarkedFaceContraction_deleted E x a
    d P
  exact hseq.trans ((AttachmentSource064_fourStageRoute c n s p b e r j e0 z p0 f hn hs he hz).trans
    (congrArg (· ≫ f) hnorm.symm))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource064


section AttachmentSource065



set_option autoImplicit false

noncomputable section

universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory

attribute [local instance] FintypeCat.fintype

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance binaryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The two-object family with values `X` and `Y` in that order. -/
def binaryObjects (X Y : C) : Fin 2 → C := Fin.cases X (fun _ => Y)

/-- The componentwise map of two-object families induced by `f` and `g`. -/
def binaryObjectMap {X Xprime Y Yprime : C} (f : X ⟶ Xprime) (g : Y ⟶ Yprime) :
    binaryObjects X Y ⟶ binaryObjects Xprime Yprime := Fin.cases f (fun _ => g)

/-- The actual produced finite tensor on two original objects is the original
binary monoidal tensor, with its original degree-zero unitor retained. -/
def binaryTensorIso (X Y : C) :
    (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Fin 2))).obj (binaryObjects X Y) ≅ X ⊗ Y :=
  fixedToOrderedIso (binaryObjects X Y) ≪≫ tensorIso (λ_ X) (Iso.refl Y)

/-- The two-object comparison retains both original component maps. -/
theorem binaryTensorIso_naturality {X Xprime Y Yprime : C} (f : X ⟶ Xprime) (g : Y ⟶ Yprime) :
    (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Fin 2))).map (binaryObjectMap f g) ≫
        (binaryTensorIso Xprime Yprime).hom =
      (binaryTensorIso X Y).hom ≫ (f ⊗ₘ g) := by
  let p := binaryObjects X Y
  let q := binaryObjects Xprime Yprime
  let a := (tensorIso (λ_ X) (Iso.refl Y)).hom
  let b := (tensorIso (λ_ Xprime) (Iso.refl Yprime)).hom
  have hc : OrderedTensor.map (binaryObjectMap f g) ≫ b = a ≫ (f ⊗ₘ g) := by
    change ((𝟙 (𝟙_ C) ⊗ₘ f) ⊗ₘ g) ≫ ((λ_ Xprime).hom ⊗ₘ 𝟙 Yprime) =
      ((λ_ X).hom ⊗ₘ 𝟙 Y) ≫ (f ⊗ₘ g)
    rw [tensorHom_comp_tensorHom, tensorHom_comp_tensorHom,
      Category.comp_id, Category.id_comp, id_tensorHom, leftUnitor_naturality]
  exact (Category.assoc _ (fixedToOrderedIso q).hom b).symm.trans
    ((congrArg (· ≫ b) (fixedToOrderedIso_naturality (binaryObjectMap f g))).trans
      ((Category.assoc (fixedToOrderedIso p).hom _ b).trans
        ((congrArg ((fixedToOrderedIso p).hom ≫ ·) hc).trans
          (Category.assoc _ a (f ⊗ₘ g)).symm)))


end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource065


section AttachmentSource066



set_option autoImplicit false

noncomputable section

universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory

attribute [local instance] FintypeCat.fintype

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance coefficientBinaryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The original coefficient singleton and original leaf family are the two
original finite tensor blocks. -/
def coefficientBlocks (Y : C) (L : FiniteFamily C) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Fin 2)
  obj := binaryObjects ((FiniteFamily.singleton (C := C)).obj Y) L

/-- Map the coefficient singleton and leaf block independently in the two-block family. -/
def coefficientBlocksMap {Y Yprime : C} (f : Y ⟶ Yprime) {L Lprime : FiniteFamily C}
    (l : L ⟶ Lprime) : coefficientBlocks Y L ⟶ coefficientBlocks Yprime Lprime where
  equiv := Equiv.refl (Fin 2)
  hom := binaryObjectMap ((FiniteFamily.singleton (C := C)).map f) l

/-- The exact original two-block dependent-sum input index is the original
coefficient-first Option index, retaining every original leaf position. -/
def coefficientBlockInputEquiv (Y : C) (L : FiniteFamily C) :
    ((FiniteFamily.flatten (C := C)).obj (coefficientBlocks Y L)).index ≃
      ((coefficientLeafFamilyFunctor L).obj Y).index where
  toFun p := Fin.cases (fun _ => none) (fun _ j => some j) p.1 p.2
  invFun p := match p with
    | none => ⟨(0 : Fin 2), PUnit.unit⟩
    | some j => ⟨(1 : Fin 2), j⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    change Fin 2 at i
    cases i using Fin.cases with
    | zero =>
      change PUnit at j
      cases j
      rfl
    | succ i =>
      have hi : i = 0 := Subsingleton.elim _ _
      cases hi
      rfl
  right_inv p := by cases p <;> rfl

/-- Flattening the original coefficient and leaf blocks changes only their
displayed finite input bijection, with every original object preserved. -/
def coefficientBlocksFlattenIso (Y : C) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (coefficientBlocks Y L) ≅
      (coefficientLeafFamilyFunctor L).obj Y :=
  FiniteFamily.isoOfComponents (coefficientBlockInputEquiv Y L) (fun p => by
    rcases p with ⟨i, j⟩
    change Fin 2 at i
    cases i using Fin.cases with
    | zero =>
      change PUnit at j
      cases j
      exact Iso.refl _
    | succ _ => exact Iso.refl _)

omit [MonoidalCategory C] [SymmetricCategory C] in
/-- The original coefficient map and every original leaf component map and
permutation commute with the original two-block flattening comparison. -/
theorem coefficientBlocksFlattenIso_naturality {Y Yprime : C} (f : Y ⟶ Yprime)
    {L Lprime : FiniteFamily C} (l : L ⟶ Lprime) :
    (FiniteFamily.flatten (C := C)).map (coefficientBlocksMap f l) ≫
        (coefficientBlocksFlattenIso Yprime Lprime).hom =
      (coefficientBlocksFlattenIso Y L).hom ≫ coefficientLeafMap f l := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    rintro ⟨i, j⟩
    change Fin 2 at i
    cases i using Fin.cases with
    | zero =>
      change PUnit at j
      cases j
      rfl
    | succ _ => rfl
  · rintro ⟨i, j⟩
    change Fin 2 at i
    cases i using Fin.cases with
    | zero =>
      change PUnit at j
      cases j
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)
    | succ _ =>
      exact heq_of_eq ((Category.comp_id (l.hom j)).trans (Category.id_comp (l.hom j)).symm)

/-- The original coefficient singleton tensor unitor and original leaf tensor
are retained in the original two-object tensor source. -/
def coefficientBlocksCollapseIso (Y : C) (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (coefficientBlocks Y L) ≅
      (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Fin 2))).obj
        (binaryObjects Y ((FiniteTensor.tensor (V := C)).obj L)) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Fin 2)) (fun i => by
    change Fin 2 at i
    cases i using Fin.cases with
    | zero => exact (FiniteTensor.singletonIso (V := C)).app Y
    | succ _ => exact Iso.refl _)

/-- The original coefficient unitor and leaf tensor retain the original map
and arbitrary original leaf relabelling. -/
theorem coefficientBlocksCollapseIso_naturality {Y Yprime : C} (f : Y ⟶ Yprime)
    {L Lprime : FiniteFamily C} (l : L ⟶ Lprime) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (coefficientBlocksMap f l) ≫
        (coefficientBlocksCollapseIso Yprime Lprime).hom =
      (coefficientBlocksCollapseIso Y L).hom ≫
        (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Fin 2))).map
          (binaryObjectMap f ((FiniteTensor.tensor (V := C)).map l)) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    change Fin 2 at i
    cases i using Fin.cases with
    | zero => exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).hom.naturality f)
    | succ _ => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- The actual original unbiased coefficient/leaf tensor is the original
binary coefficient tensor with the actual original finite leaf tensor. Empty
leaves retain the original unit and every comparison is constructed. -/
def coefficientBinaryTensorIso (Y : C) (L : FiniteFamily C) :
    (coefficientLeafTensorFunctor L).obj Y ≅ Y ⊗ (FiniteTensor.tensor (V := C)).obj L :=
  (FiniteTensor.tensor (V := C)).mapIso (coefficientBlocksFlattenIso Y L).symm ≪≫
    (FiniteTensor.flattenIso (V := C)).app (coefficientBlocks Y L) ≪≫
    (FiniteTensor.tensor (V := C)).mapIso (coefficientBlocksCollapseIso Y L) ≪≫
    binaryTensorIso Y ((FiniteTensor.tensor (V := C)).obj L)

theorem coefficientBinaryTensorIso_hom (Y : C) (L : FiniteFamily C) :
    (coefficientBinaryTensorIso Y L).hom =
      (FiniteTensor.tensor (V := C)).map (coefficientBlocksFlattenIso Y L).inv ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (coefficientBlocks Y L) ≫
          (FiniteTensor.tensor (V := C)).map (coefficientBlocksCollapseIso Y L).hom ≫
            (binaryTensorIso Y ((FiniteTensor.tensor (V := C)).obj L)).hom := rfl

private theorem AttachmentSource066_fourSquareChain {D : Type*} [Category* D]
    {A₀ A₁ A₂ A₃ A₄ B₀ B₁ B₂ B₃ B₄ : D}
    (m₀ : A₀ ⟶ B₀) (m₁ : A₁ ⟶ B₁) (m₂ : A₂ ⟶ B₂) (m₃ : A₃ ⟶ B₃) (m₄ : A₄ ⟶ B₄)
    (a₀ : A₀ ⟶ A₁) (a₁ : A₁ ⟶ A₂) (a₂ : A₂ ⟶ A₃) (a₃ : A₃ ⟶ A₄)
    (b₀ : B₀ ⟶ B₁) (b₁ : B₁ ⟶ B₂) (b₂ : B₂ ⟶ B₃) (b₃ : B₃ ⟶ B₄)
    (h₀ : m₀ ≫ b₀ = a₀ ≫ m₁) (h₁ : m₁ ≫ b₁ = a₁ ≫ m₂)
    (h₂ : m₂ ≫ b₂ = a₂ ≫ m₃) (h₃ : m₃ ≫ b₃ = a₃ ≫ m₄) :
    m₀ ≫ (b₀ ≫ b₁ ≫ b₂ ≫ b₃) = (a₀ ≫ a₁ ≫ a₂ ≫ a₃) ≫ m₄ := by
  simp only [Category.assoc]
  rw [← Category.assoc m₀ b₀ (b₁ ≫ b₂ ≫ b₃), h₀,
    Category.assoc a₀ m₁ (b₁ ≫ b₂ ≫ b₃),
    ← Category.assoc m₁ b₁ (b₂ ≫ b₃), h₁,
    Category.assoc a₁ m₂ (b₂ ≫ b₃),
    ← Category.assoc m₂ b₂ b₃, h₂, Category.assoc a₂ m₃ b₃, h₃]

/-- The full original coefficient/leaf comparison is natural in the original
coefficient map and every original heterogeneous leaf map and permutation. -/
theorem coefficientBinaryTensorIso_naturality {Y Yprime : C} (f : Y ⟶ Yprime)
    {L Lprime : FiniteFamily C} (l : L ⟶ Lprime) :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap f l) ≫
        (coefficientBinaryTensorIso Yprime Lprime).hom =
      (coefficientBinaryTensorIso Y L).hom ≫
        (f ⊗ₘ (FiniteTensor.tensor (V := C)).map l) := by
  let T := FiniteTensor.tensor (V := C)
  let F := coefficientBlocksMap f l
  let A := coefficientBlocks Y L
  let B := coefficientBlocks Yprime Lprime
  let e := coefficientBlocksFlattenIso Y L
  let e' := coefficientBlocksFlattenIso Yprime Lprime
  have hinv : coefficientLeafMap f l ≫ e'.inv = e.inv ≫ (FiniteFamily.flatten (C := C)).map F := by
    apply (cancel_mono e'.hom).1
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [coefficientBlocksFlattenIso_naturality f l, ← Category.assoc,
      Iso.inv_hom_id, Category.id_comp]
  have h₀ : T.map (coefficientLeafMap f l) ≫ T.map e'.inv =
      T.map e.inv ≫ T.map ((FiniteFamily.flatten (C := C)).map F) :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hinv).trans (T.map_comp _ _))
  have h₁ : T.map ((FiniteFamily.flatten (C := C)).map F) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app B =
        (FiniteTensor.flattenIso (V := C)).hom.app A ≫
