/-!
## Original recursive stage, degree and profile cofactors at the genuine endpoint
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping EndpointRelations

private theorem AttachmentSource187_transportProfile {V : Type*} [Category* V] {A X S Y Z T : V}
    (j : A ⟶ S) (e : X ≅ S) (i : X ⟶ Y) (q : Y ⟶ Z) (k : S ⟶ Z) (f : Z ⟶ T)
    (h : i ≫ q = e.hom ≫ k) : (j ≫ e.inv) ≫ (i ≫ q ≫ f) = j ≫ k ≫ f := by
  have hh := congrArg (fun r => j ≫ e.inv ≫ r ≫ f) h
  simpa only [Category.assoc, Iso.inv_hom_id_assoc] using hh

private theorem AttachmentSource187_familyMap_transport {I : Type*} {V : Type*} [Category* V]
    (A B : I → V) (f : ∀ i, A i ⟶ B i) {i j : I} (h : i = j) :
    eqToHom (congrArg A h) ≫ f j = f i ≫ eqToHom (congrArg B h) := by
  cases h
  exact (Category.id_comp _).trans (Category.comp_id _).symm

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationRecursiveEndpointCofansFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationRecursiveEndpointCofansSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationRecursiveEndpointCofansProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationRecursiveEndpointCofansFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The leg from a recursive pushout stage to the genuine algebra attachment endpoint. -/
def recursiveAttachmentStageLeg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    recursiveStage E x a d N ⟶ (attachmentEndpoint E x a).carrier d :=
  recursiveStageι E x a d N ≫ (recursiveAttachmentEndpointIso E x a d).hom

@[reassoc (attr := simp)]
theorem recursiveAttachmentStageLeg_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) :
    recursiveStageMap E x a d h ≫ recursiveAttachmentStageLeg E x a d M =
      recursiveAttachmentStageLeg E x a d N :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ (recursiveAttachmentEndpointIso E x a d).hom) (recursiveStageι_naturality E x a d h))

@[reassoc]
theorem recursiveAttachmentStageLeg_zero (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveAttachmentStageLeg E x a d 0 = (endpointOldMap E x a).hom d :=
  recursiveStageRootMap_toEndpoint E x a d

/-- The cocone of recursive pushout stages at the genuine algebra attachment endpoint. -/
def recursiveAttachmentCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Cocone (recursiveStageDiagram E x a d) where
  pt := (attachmentEndpoint E x a).carrier d
  ι.app N := recursiveAttachmentStageLeg E x a d N
  ι.naturality _N _M f := (recursiveAttachmentStageLeg_map E x a d (leOfHom f)).trans (Category.comp_id _).symm

/-- The complete original recursive-stage cocone has the genuine endpoint
as its actual colimit; this is transported from the constructed colimit Iso. -/
def recursiveAttachmentIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    IsColimit (recursiveAttachmentCocone E x a d) :=
  IsColimit.ofIsoColimit (colimit.isColimit (recursiveStageDiagram E x a d))
    (Cocone.ext (recursiveAttachmentEndpointIso E x a d))

/-- Every original degree cofan in each actual recursive pushout stage reads
back as the original genuine new-free-algebra degree cofan and endpoint projection. -/
@[reassoc (attr := simp)]
theorem recursiveAttachmentStageDegree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (N j : ℕ) (hj : j ≤ N) :
    recursiveDegreeCofan E x a d N j hj ≫ recursiveAttachmentStageLeg E x a d N =
      degreeFreeMap E x d j ≫ (endpointNewMap E x a).hom d := by
  let l := stageDegreeLeg E x a d N j hj
  let e := recursiveStageComparison E x a d N
  let i := recursiveStageι E x a d N
  let q := (recursiveStageEndpointIso E x a d).hom
  let k := stageι E x a d N
  let f := (omegaEndpointIso E x a d).hom
  have ht := AttachmentSource187_transportProfile l e i q k f (recursiveStageEndpointIso_ι E x a d N)
  have hs : l ≫ k ≫ f = degreeFreeMap E x d j ≫ (endpointNewMap E x a).hom d :=
    (congrArg (l ≫ ·) (stageι_toEndpoint E x a d N)).trans
      (stageCoforkDesc_degree E x a d N j hj (endpointCarrierCofork E x a d))
  exact ht.trans hs

/-- Every original full colored profile retains its original coefficient,
leaf maps, degree cofan and actual endpoint projection in the recursive stages. -/
@[reassoc (attr := simp)]
theorem recursiveAttachmentStageProfile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    recursiveProfileCofan E x a N P hP ≫ recursiveAttachmentStageLeg E x a P.outputColor N =
      endpointProfileLeg E x a (profileInputs P) := by
  let d := P.outputColor
  let j := stageProfileLeg E x a N P hP
  let e := recursiveStageComparison E x a d N
  let i := recursiveStageι E x a d N
  let q := (recursiveStageEndpointIso E x a d).hom
  let k := stageι E x a d N
  let f := (omegaEndpointIso E x a d).hom
  have ht := AttachmentSource187_transportProfile j e i q k f (recursiveStageEndpointIso_ι E x a d N)
  have hs : j ≫ k ≫ f = endpointProfileLeg E x a (profileInputs P) :=
    (Category.assoc j k f).symm.trans
      ((congrArg (· ≫ f) (omegaProfileCofan_atStage E x a N P hP)).trans
        (omegaEndpointIso_profile E x a d (profileInputs P)))
  exact ht.trans hs

/-- Every original profile permutation and output-color transport preserves
the unchanged endpoint profile cofan. -/
@[reassoc]
theorem endpointProfileLeg_full_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E)
    {P Q : ColoredProfile W} (g : P ⟶ Q) :
    (operationSummandFunctor E.toCollection Xprime).map g ≫ endpointProfileLeg E x a (profileInputs Q) =
      endpointProfileLeg E x a (profileInputs P) ≫
        eqToHom (congrArg (attachmentEndpoint E x a).carrier g.outputColor_eq) := by
  let m := (operationSummandFunctor E.toCollection Xprime).map g
  let i := profileι E.toCollection Xprime (profileInputs P)
  let j := profileι E.toCollection Xprime (profileInputs Q)
  let p := (endpointNewMap E x a).hom P.outputColor
  let q := (endpointNewMap E x a).hom Q.outputColor
  let u := eqToHom (congrArg (freeAlgebra E Xprime).carrier g.outputColor_eq)
  let v := eqToHom (congrArg (attachmentEndpoint E x a).carrier g.outputColor_eq)
  have hm : m ≫ j = i ≫ u := profileι_full_relabel E.toCollection Xprime g
  have hu : u ≫ q = p ≫ v :=
    AttachmentSource187_familyMap_transport (freeAlgebra E Xprime).carrier (attachmentEndpoint E x a).carrier
      (endpointNewMap E x a).hom g.outputColor_eq
  exact (Category.assoc m j q).symm.trans
    ((congrArg (· ≫ q) hm).trans
      ((Category.assoc i u q).trans ((congrArg (i ≫ ·) hu).trans (Category.assoc i p v).symm)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
