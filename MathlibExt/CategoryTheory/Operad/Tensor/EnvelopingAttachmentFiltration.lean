/-!
## All original Env profile-cell cofactors in the whole carrier-family category
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits InitialAttachment InitialAttachment.ProfileCells

variable {W : Type uc}

/-- Every actual occurring cell retains its original output and profile class. -/
abbrev RawCellIndex (W : Type uc) (N : ℕ) := Σ _d : W, ProfileClass W (N + 1)

instance rawCellIndexSmall [Small.{us} W] (N : ℕ) : Small.{us} (RawCellIndex W N) := inferInstance

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance originalProfileCofansFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance originalProfileCofansSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance originalProfileCofansProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance originalProfileCofansInitial : HasInitial C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete PEmpty)

/-- The actual original balanced profile arrow, at its actual original output
color, is a full original carrier-family arrow. All other colors stay initial. -/
def profileCell (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) (p : RawCellIndex W N) : Arrow (W → C) :=
  colorArrow p.1 (balancedProfileArrow (envelopingOperad O A) x (representativeProfile p.1 p.2))

/-- The underlying morphism of an enveloping profile cell. -/
def profileCellMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) (p : RawCellIndex W N) :
    (profileCell O A x N p).left ⟶ (profileCell O A x N p).right := (profileCell O A x N p).hom

/-- The full original source profile cofan retains both the actual original
Aut boundary quotient and original output color at every occurring cell. -/
def profileSourceCofan (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : Cofan (fun p : RawCellIndex W N => (profileCell O A x N p).left) :=
  supportedCofan (fun d => operadBoundaryCofan (envelopingOperad O A) x d (N + 1))

/-- The full original target profile cofan retains the actual original Aut top
quotient and its original color at every occurring cell. -/
def profileTargetCofan (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : Cofan (fun p : RawCellIndex W N => (profileCell O A x N p).right) :=
  supportedCofan (fun d => operadTopCofan (envelopingOperad O A) x d (N + 1))

/-- All source quotient cofactors have a constructed full family coproduct UP. -/
def profileSourceIsColimit (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : IsColimit (profileSourceCofan O A x N) :=
  supportedIsColimit _ (fun d => operadBoundaryIsColimit (envelopingOperad O A) x d (N + 1))

/-- All target quotient cofactors have a constructed full family coproduct UP. -/
def profileTargetIsColimit (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : IsColimit (profileTargetCofan O A x N) :=
  supportedIsColimit _ (fun d => operadTopIsColimit (envelopingOperad O A) x d (N + 1))

/-- The two actual family coproduct points are the unchanged original degree
source and target, not independently supplied carrier objects. -/
theorem profileSource_point (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : (profileSourceCofan O A x N).pt = degreeSource O A x N := rfl

theorem profileTarget_point (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : (profileTargetCofan O A x N).pt = degreeTarget O A x N := rfl

/-- Every original cell retains its full boundary-to-top square under the
original degree arrow in the whole carrier-family category. -/
theorem profileCell_degreeSquare (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) (p : RawCellIndex W N) :
    (profileSourceCofan O A x N).inj p ≫ degreeMap O A x N =
      profileCellMap O A x N p ≫ (profileTargetCofan O A x N).inj p := by
  let E := envelopingOperad O A
  have h : ∀ d s, (operadBoundaryCofan E x d (N + 1)).inj s ≫
      (degreeBalancedArrow E x d (N + 1)).hom =
    (balancedProfileArrow E x (representativeProfile d s)).hom ≫
      (operadTopCofan E x d (N + 1)).inj s := by
    intro d s
    exact (congrArg (· ≫ (degreeBalancedArrow E x d (N + 1)).hom)
      (operadProfileCellCofan_left E x d (N + 1) s).symm).trans
        (Arrow.w (operadProfileCellCofan E x d (N + 1) s))
  exact supportedCellSquare
    (fun d => operadBoundaryCofan E x d (N + 1))
    (fun d => operadTopCofan E x d (N + 1))
    (fun d s => (balancedProfileArrow E x (representativeProfile d s)).hom)
    (degreeMap O A x N) h p

/-- Every original occurring cell reads back to its original coefficient and
both actual original Aut quotient points at its same original output color. -/
def profileCellColorIso (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) (p : RawCellIndex W N) :
    Arrow.mk (profileCellMap O A x N p p.1) ≅
      balancedProfileArrow (envelopingOperad O A) x (representativeProfile p.1 p.2) :=
  Arrow.isoMk (atColorIso p.1 _) (atColorIso p.1 _) (colorMap_at p.1 _).symm


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
end AttachmentSource163


section AttachmentSource164


/-!
## Actual original profile cells attached in the whole carrier-family history
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits HomotopicalAlgebra InitialAttachment InitialAttachment.ProfileCells

variable {W : Type uc} [Small.{us} W]

/-- The actual output/profile occurrences have a genuinely source-small
index, with the original occurrence recovered by the explicit equivalence. -/
abbrev FamilyCellIndex (W : Type uc) [Small.{us} W] (N : ℕ) : Type us :=
  Shrink.{us} (RawCellIndex W N)

/-- Identify the source-small family-cell index with the raw profile-cell index. -/
def familyCellIndexEquiv (N : ℕ) : FamilyCellIndex W N ≃ RawCellIndex W N :=
  (equivShrink (RawCellIndex W N)).symm

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance familyCellsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance familyCellsSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance familyCellsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The constructed original source/target profile coproducts and genuine
whole-family successor pushout construct the full original AttachCells data. -/
def familyStageCellsLarge (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    AttachCells.{uc} (profileCellMap O A x N)
      ((originalHistory O A x y).F.map (homOfLE (Nat.le_succ N))) where
  ι := RawCellIndex W N
  π := id
  cofan₁ := profileSourceCofan O A x N
  cofan₂ := profileTargetCofan O A x N
  isColimit₁ := profileSourceIsColimit O A x N
  isColimit₂ := profileTargetIsColimit O A x N
  m := degreeMap O A x N
  hm := profileCell_degreeSquare O A x N
  g₁ := attachingFamilyMap O A x y N
  g₂ := successorNewMap O A x y N
  isPushout := historySuccessorIsPushout O A x y N

/-- All original profile/output occurrences are retained after exact
source-universe shrinking; the original cofans and both pushout legs remain. -/
def familyStageCells (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    AttachCells.{us} (profileCellMap O A x N)
      ((originalHistory O A x y).F.map (homOfLE (Nat.le_succ N))) :=
  (familyStageCellsLarge O A x y N).reindex (familyCellIndexEquiv (W := W) N)

theorem familyStageCells_index (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    (familyStageCells O A x y N).ι = FamilyCellIndex W N := rfl

/-- Each original attached cell retains its original output and full profile. -/
theorem familyStageCells_label (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) (i : FamilyCellIndex W N) :
    (familyStageCells O A x y N).π i = familyCellIndexEquiv (W := W) N i := rfl

/-- Both original Aut quotient top and original recursive new leg are
retained in each actual whole-family cell inclusion. -/
theorem familyStageCells_cell (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) (i : FamilyCellIndex W N) :
    (familyStageCells O A x y N).cell i =
      (profileTargetCofan O A x N).inj (familyCellIndexEquiv (W := W) N i) ≫ successorNewMap O A x y N := rfl

