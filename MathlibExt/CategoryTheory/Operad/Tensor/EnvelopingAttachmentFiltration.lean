section AttachmentSource015


/-!
## Original local unit insertions on the genuine three-level nullary source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original root singleton, empty P unit sources, and actual
Q1/Q2 nullary coefficient singletons before local unit insertion. -/
def rawLocalGroups (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option ((P.inputs ⊕ Q1.index) ⊕ Q2.index))
  obj i := match i with
    | none => (FiniteFamily.singleton (C := C)).obj (E.obj (extendProfile (extendProfile P Q1) Q2))
    | some (Sum.inl (Sum.inl _)) => FiniteFamily.empty
    | some (Sum.inl (Sum.inr i)) => (FiniteFamily.singleton (C := C)).obj (E.obj (ColoredProfile.nullary (Q1.obj i).as))
    | some (Sum.inr i) => (FiniteFamily.singleton (C := C)).obj (E.obj (ColoredProfile.nullary (Q2.obj i).as))

/-- The actual root/Q2/Q1 coefficient source maps to the original local
empty/singleton source through its literal Option/Sigma coefficient bijection. -/
def rawLocalSourceIso (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sourceFactors E P Q1 Q2 ≅ (FiniteFamily.flatten (C := C)).obj (rawLocalGroups E P Q1 Q2) :=
  FiniteFamily.isoOfComponents
    { toFun := fun x => match x with
        | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
        | ⟨none, some i⟩ => ⟨some (Sum.inr i), PUnit.unit⟩
        | ⟨some i, _⟩ => ⟨some (Sum.inl (Sum.inr i)), PUnit.unit⟩
      invFun := fun x => match x with
        | ⟨none, _⟩ => ⟨none, none⟩
        | ⟨some (Sum.inl (Sum.inl _)), j⟩ => j.elim
        | ⟨some (Sum.inl (Sum.inr i)), _⟩ => ⟨some i, PUnit.unit⟩
        | ⟨some (Sum.inr i), _⟩ => ⟨none, some i⟩
      left_inv := fun x => by
        rcases x with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; rfl
      right_inv := fun x => by
        rcases x with ⟨i, j⟩
        cases i with
        | none => cases j; rfl
        | some i =>
            cases i with
            | inl i => cases i with
                | inl i => cases j
                | inr i => cases j; rfl
            | inr i => cases j; rfl }
    (fun x => match x with
      | ⟨none, none⟩ => Iso.refl _
      | ⟨none, some _⟩ => Iso.refl _
      | ⟨some _, _⟩ => Iso.refl _)

/-- The raw local blocks retain the original root sum-association map
and map to the actual frozen P empty/singleton blocks. -/
def rawLocalBlocksIso (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    rawLocalGroups E P Q1 Q2 ≅
      frozenVariableBlocks P.inputs
        (frozenCoefficientFamily E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | none => Sum.inr none
        | some (Sum.inl (Sum.inl i)) => Sum.inl i
        | some (Sum.inl (Sum.inr i)) => Sum.inr (some (Sum.inl i))
        | some (Sum.inr i) => Sum.inr (some (Sum.inr i))
      invFun := fun i => match i with
        | Sum.inl i => some (Sum.inl (Sum.inl i))
        | Sum.inr none => none
        | Sum.inr (some (Sum.inl i)) => some (Sum.inl (Sum.inr i))
        | Sum.inr (some (Sum.inr i)) => some (Sum.inr i)
      left_inv := fun i => by
        cases i with
        | none => rfl
        | some i => cases i with
            | inl i => cases i <;> rfl
            | inr i => rfl
      right_inv := fun i => by
        cases i with
        | inl i => rfl
        | inr i => cases i with
            | none => rfl
            | some i => cases i <;> rfl }
    (fun i => match i with
      | none => (FiniteFamily.singleton (C := C)).mapIso (E.mapIso (asIso (rootSumAssocHom P Q1 Q2)))
      | some (Sum.inl (Sum.inl _)) => Iso.refl _
      | some (Sum.inl (Sum.inr _)) => Iso.refl _
      | some (Sum.inr _) => Iso.refl _)

variable [FiniteTensor C]

/-- Each genuine local coefficient source receives its original unit
insertion: P's right unit at the unit coefficient, Q1's left unit at
its nullary coefficient, and Q2's empty-input right unit at its nullary coefficient. -/
def localInsertions (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawLocalGroups E.toCollection P Q1 Q2) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2)) where
  equiv := Equiv.refl _
  hom i := match i with
    | none => (FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map
        (E.toCollection.map (frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
          ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2))))
    | some (Sum.inl (Sum.inl i)) => E.unit (P.inputColor i) ≫
        ColoredOperadObj.rightUnitInsert E.toCollection E.unit (ColoredSubstitutionData.unitProfile (P.inputColor i))
    | some (Sum.inl (Sum.inr i)) =>
        (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as)) ≫
          ColoredOperadObj.leftUnitInsert E.toCollection E.unit (ColoredProfile.nullary (Q1.obj i).as)
    | some (Sum.inr i) =>
        (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (ColoredProfile.nullary (Q2.obj i).as)) ≫
          ColoredOperadObj.rightUnitInsert E.toCollection E.unit (ColoredProfile.nullary (Q2.obj i).as)

/-- The original raw coefficients map to the full genuine three-level
associativity source by actual local tensor unit insertions and flattenings. -/
def expandedAssocSource (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    source E.toCollection P Q1 Q2 ⟶ ColoredOperadObj.associativityCommonSource E.toCollection (assocData P Q1 Q2) :=
  (FiniteTensor.tensor (V := C)).map (rawLocalSourceIso E.toCollection P Q1 Q2).hom ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (rawLocalGroups E.toCollection P Q1 Q2) ≫
      (FiniteTensor.tensor (V := C)).map (localInsertions E P Q1 Q2) ≫
        (FiniteTensor.flattenIso (V := C)).inv.app
          (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2))

/-- The literal remaining factor map after every original local unit law. -/
def collapsedLocalFactors (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawLocalGroups E.toCollection P Q1 Q2) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj
        (frozenSubstitution P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))) where
  equiv := Equiv.optionCongr (Equiv.sumAssoc P.inputs Q1.index Q2.index)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (extendProfile (extendProfile P Q1) Q2))
      ≫
        E.toCollection.map (rootSumAssocHom P Q1 Q2 ≫
          frozenOuterProfileHom P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)))
    | some (Sum.inl (Sum.inl i)) => E.unit (P.inputColor i)
    | some (Sum.inl (Sum.inr i)) => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj
      (ColoredProfile.nullary (Q1.obj i).as))
    | some (Sum.inr i) => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (ColoredProfile.nullary
      (Q2.obj i).as))

/-- The two genuine E-associativity routes agree on the actual expanded
original coefficient source and the actual original final profile map. -/
theorem original_assoc (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    expandedAssocSource E P Q1 Q2 ≫
        ColoredOperadObj.associativityRouteA E.toCollection E.subst (assocData P Q1 Q2) ≫
        E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
          Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) =
      expandedAssocSource E P Q1 Q2 ≫
        ColoredOperadObj.associativityRouteB E.toCollection E.subst (assocData P Q1 Q2) ≫
        E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
          Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) :=
  congrArg (fun a => expandedAssocSource E P Q1 Q2 ≫ a ≫
    E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
      Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2))) (E.assoc (assocData P Q1 Q2))


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource015


section AttachmentSource016


/-!
## Local original unit laws identify the simultaneous nullary association route
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

private theorem AttachmentSource016_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem AttachmentSource016_sourceFold {V : Type*} [Category* V]
    {X A B D E F G H : V} (p : X ⟶ A) (a : A ⟶ B) (f : B ⟶ H)
    (n : B ⟶ D) (b : D ⟶ E) (c : E ⟶ H) (r : A ⟶ F) (a' : F ⟶ D)
    (p' : X ⟶ G) (e : G ⟶ F)
    (hf : f = n ≫ b ≫ c) (hn : a ≫ n = r ≫ a') (hp : p ≫ r = p' ≫ e) :
    p ≫ a ≫ f = p' ≫ (e ≫ a' ≫ b) ≫ c := by
  rw [hf]
  simp only [Category.assoc]
  rw [← Category.assoc a n (b ≫ c), hn]
  simp only [Category.assoc]
  rw [← Category.assoc p r (a' ≫ b ≫ c), hp]
  simp only [Category.assoc]

private theorem AttachmentSource016_totalMapFold {V : Type*} [Category* V] {X A B D E F : V}
    (a : X ⟶ A) (f : A ⟶ B) (s : B ⟶ D) (t : D ⟶ E) (r : E ⟶ F) (u : D ⟶ F)
    (hu : u = t ≫ r) : a ≫ (f ≫ s ≫ t) ≫ r = (a ≫ f) ≫ s ≫ u := by
  rw [hu]
  simp only [Category.assoc]

private theorem AttachmentSource016_routeAFold {V : Type*} [Category* V]
    {X A B D E F G H K M : V} (p : X ⟶ A) (a : A ⟶ B) (l : B ⟶ D)
    (i : D ⟶ E) (j : E ⟶ D) (g : D ⟶ F) (s : F ⟶ G) (q : G ⟶ H)
    (k : H ⟶ M) (h : F ⟶ K) (s' : K ⟶ H) (m : B ⟶ K) (n : X ⟶ K)
    (hi : i ≫ j = 𝟙 D) (hl : l ≫ g ≫ h = m) (hs : s ≫ q = h ≫ s') (hp : p ≫ a ≫ m = n) :
    (p ≫ a ≫ l ≫ i) ≫ (j ≫ g ≫ s) ≫ (q ≫ k) = n ≫ s' ≫ k := by
  have hm : p ≫ a ≫ l ≫ g ≫ h = n := by
    simpa only [Category.assoc] using (congrArg (p ≫ a ≫ ·) hl).trans hp
  have ht : p ≫ a ≫ l ≫ g ≫ h ≫ s' ≫ k = n ≫ s' ≫ k := by
    simpa only [Category.assoc] using congrArg (fun t => t ≫ s' ≫ k) hm
  simp only [Category.assoc]
  rw [← Category.assoc i j (g ≫ s ≫ q ≫ k), hi, Category.id_comp]
  rw [← Category.assoc s q k, hs]
  simpa only [Category.assoc] using ht

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original local branch is eliminated by its genuine E-unit law,
after its original unit-total profile map; the root retains its exact sum association. -/
theorem localInsertions_collapse (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    localInsertions E P Q1 Q2 ≫
        ColoredOperadObj.AssocInsertion.groupingAToFactorsHom E.toCollection E.subst (assocData P Q1 Q2) ≫
        (ColoredOperadObj.substitutionFactors E.toCollection).map (afterInnerCompare P Q1 Q2) =
      collapsedLocalFactors E P Q1 Q2 := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let X := E.toCollection.obj (extendProfile (extendProfile P Q1) Q2)
        let f := frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
          ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2)
        let g := ColoredSubstitutionData.outerProfileMap
          (d := (assocData P Q1 Q2).outerAfterInnerData) (afterInnerCompare P Q1 Q2)
        let a := (FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map (E.toCollection.map f))
        let b := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (assocData P Q1
          Q2).middleData.outerProfile)
        let c := E.toCollection.map g
        let d := (FiniteTensor.singletonIso (V := C)).hom.app X
        let r := E.toCollection.map (rootSumAssocHom P Q1 Q2 ≫
          frozenOuterProfileHom P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)))
        change HEq (a ≫ b ≫ c) (d ≫ r)
        have hn : a ≫ b = d ≫ E.toCollection.map f :=
          (FiniteTensor.singletonIso (V := C)).hom.naturality (E.toCollection.map f)
        have hp : E.toCollection.map f ≫ c = r := (E.toCollection.map_comp _ _).symm.trans
          (congrArg E.toCollection.map ((Category.assoc _ _ _).trans (rootProfile_readback P Q1 Q2)))
        exact heq_of_eq ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ c) hn).trans ((Category.assoc _ _ _).trans (congrArg (d ≫ ·) hp))))
    | some i =>
        cases i with
        | inl i =>
            cases i with
            | inl i =>
                let c := P.inputColor i
                let u := E.unit c
                let p := ColoredOperadObj.rightUnitInsert E.toCollection E.unit (ColoredSubstitutionData.unitProfile c)
                let s := E.subst.app (ColoredSubstitutionData.rightUnit (ColoredSubstitutionData.unitProfile c))
                let q := E.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom
                  (ColoredSubstitutionData.unitProfile c))
                change HEq ((u ≫ p) ≫ s ≫ q) u
                exact heq_of_eq ((Category.assoc _ _ _).trans
                  ((congrArg (u ≫ ·) (E.right_unit (ColoredSubstitutionData.unitProfile c))).trans (Category.comp_id
                    u)))
            | inr i =>
                let N := ColoredProfile.nullary (Q1.obj i).as
                let u := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj N)
                let p := ColoredOperadObj.leftUnitInsert E.toCollection E.unit N
                let s := E.subst.app (ColoredSubstitutionData.leftUnit N)
                let q := E.toCollection.map (ColoredSubstitutionData.leftUnitTotalHom N)
                change HEq ((u ≫ p) ≫ s ≫ q) u
                exact heq_of_eq ((Category.assoc _ _ _).trans
                  ((congrArg (u ≫ ·) (E.left_unit N)).trans (Category.comp_id u)))
        | inr i =>
            let N := ColoredProfile.nullary (Q2.obj i).as
            let u := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj N)
            let p := ColoredOperadObj.rightUnitInsert E.toCollection E.unit N
            let s := E.subst.app (ColoredSubstitutionData.rightUnit N)
            let q := E.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom N)
            change HEq ((u ≫ p) ≫ s ≫ q) u
            exact heq_of_eq ((Category.assoc _ _ _).trans
              ((congrArg (u ≫ ·) (E.right_unit N)).trans (Category.comp_id u)))

omit [FiniteTensor C] in
/-- The root/Q2/Q1 coefficient bijection retains exactly the original
simultaneous coefficient map after the genuine local empty/singleton blocks. -/
theorem rawLocalFlatten_readback (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (rawLocalSourceIso E P Q1 Q2).hom ≫
        (FiniteFamily.flatten (C := C)).map (rawLocalBlocksIso E P Q1 Q2).hom ≫
        (frozenVariableFlattenIso P.inputs
          (frozenCoefficientFamily E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)))).hom =
      simultaneousFactorMap E P Q1 Q2 := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro x
    rcases x with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl
  · intro x
    rcases x with ⟨i, j⟩
    cases i with
    | none =>
        cases j with
        | none =>
            let f := E.map (rootSumAssocHom P Q1 Q2)
            change HEq (𝟙 _ ≫ f ≫ 𝟙 _) f
            exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _))
        | some j =>
            let X := E.obj (ColoredProfile.nullary (Q2.obj j).as)
            change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
            exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))
    | some i =>
        cases j
        let X := E.obj (ColoredProfile.nullary (Q1.obj i).as)
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))

/-- The local branch unit sources are exactly the original frozen P units
after the original scalar and singleton comparisons. -/
theorem rawLocalBlocks_collapse (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rawLocalBlocksIso E.toCollection P Q1 Q2).hom ≫
        (frozenVariableBlockIso P.inputs
          (frozenCoefficientFamily E.toCollection P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)))).hom
            ≫
        frozenUnitCoefficientMap E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)) =
      collapsedLocalFactors E P Q1 Q2 := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i => cases i with
        | inl i => cases i <;> rfl
        | inr i => rfl
  · intro i
    cases i with
    | none =>
        let f := E.toCollection.map (rootSumAssocHom P Q1 Q2)
        let g := E.toCollection.map (frozenOuterProfileHom P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1
          Q2)))
        let a := (FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map f)
        let b := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (extendProfile P (inputSum Q1 Q2)))
        let c := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (extendProfile (extendProfile P Q1)
          Q2))
        change HEq (a ≫ b ≫ g) (c ≫ E.toCollection.map (rootSumAssocHom P Q1 Q2 ≫
          frozenOuterProfileHom P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))))
        exact heq_of_eq ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ g) ((FiniteTensor.singletonIso (V := C)).hom.naturality f)).trans
            ((Category.assoc _ _ _).trans
              (congrArg (c ≫ ·) (E.toCollection.map_comp _ _).symm))))
    | some i =>
        cases i with
        | inl i =>
            cases i with
            | inl i =>
                let u := E.unit (P.inputColor i)
                change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ 𝟙 _ ≫ u) u
                exact heq_of_eq ((congrArg (fun a => a ≫ 𝟙 _ ≫ u) ((FiniteTensor.tensor (V := C)).map_id _)).trans
                  ((Category.id_comp _).trans (Category.id_comp _)))
            | inr i =>
                let X := E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as)
                let s := (FiniteTensor.singletonIso (V := C)).hom.app X
                change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) ≫ s ≫ 𝟙 X)
                  s
                exact heq_of_eq ((congrArg (fun a => a ≫ s ≫ 𝟙 X) ((FiniteTensor.tensor (V := C)).map_id _)).trans
                  ((Category.id_comp _).trans (Category.comp_id _)))
        | inr i =>
            let X := E.toCollection.obj (ColoredProfile.nullary (Q2.obj i).as)
            let s := (FiniteTensor.singletonIso (V := C)).hom.app X
            change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) ≫ s ≫ 𝟙 X) s
            exact heq_of_eq ((congrArg (fun a => a ≫ s ≫ 𝟙 X) ((FiniteTensor.tensor (V := C)).map_id _)).trans
              ((Category.id_comp _).trans (Category.comp_id _)))

/-- The collapsed local unit source is exactly the original simultaneous
frozen coefficient tensor source, with its original root/input coefficient permutation. -/
theorem collapsedSource_readback (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (rawLocalSourceIso E.toCollection P Q1 Q2).hom ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (rawLocalGroups E.toCollection P Q1 Q2) ≫
        (FiniteTensor.tensor (V := C)).map (collapsedLocalFactors E P Q1 Q2) =
      (FiniteTensor.tensor (V := C)).map (simultaneousFactorMap E.toCollection P Q1 Q2) ≫
        frozenSubstitutionCoefficientTensorMap E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let K := frozenCoefficientFamily E.toCollection P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))
  let z := rawLocalSourceIso E.toCollection P Q1 Q2
  let b := rawLocalBlocksIso E.toCollection P Q1 Q2
  let e := frozenVariableFlattenIso P.inputs K
  let v := (frozenVariableBlockIso P.inputs K).hom
  let u := frozenUnitCoefficientMap E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))
  let s := simultaneousFactorMap E.toCollection P Q1 Q2
  have hr : (z.hom ≫ F.map b.hom) ≫ e.hom = s :=
    (Category.assoc _ _ _).trans (rawLocalFlatten_readback E.toCollection P Q1 Q2)
  have he : z.hom ≫ F.map b.hom = s ≫ e.inv := (e.eq_comp_inv).2 hr
  have hp : T.map z.hom ≫ T.map (F.map b.hom) = T.map s ≫ T.map e.inv :=
    (T.map_comp _ _).symm.trans ((congrArg T.map he).trans (T.map_comp _ _))
  have hn := (FiniteTensor.flattenIso (V := C)).hom.naturality b.hom |>.symm
  have hf : T.map (collapsedLocalFactors E P Q1 Q2) =
      T.map ((FiniteFamily.map T).map b.hom) ≫ T.map v ≫ T.map u :=
    (congrArg T.map (rawLocalBlocks_collapse E P Q1 Q2).symm).trans
      (AttachmentSource016_mapThree T ((FiniteFamily.map T).map b.hom) v u)
  exact AttachmentSource016_sourceFold (T.map z.hom)
    ((FiniteTensor.flattenIso (V := C)).hom.app (rawLocalGroups E.toCollection P Q1 Q2))
    (T.map (collapsedLocalFactors E P Q1 Q2)) (T.map ((FiniteFamily.map T).map b.hom))
    (T.map v) (T.map u) (T.map (F.map b.hom))
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks P.inputs K))
    (T.map s) (T.map e.inv) hf hn hp

/-- The simultaneous route retains the original complete final total-profile map. -/
theorem simultaneousRoute_normalized (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    simultaneousRoute E P Q1 Q2 =
      ((FiniteTensor.tensor (V := C)).map (simultaneousFactorMap E.toCollection P Q1 Q2) ≫
        frozenSubstitutionCoefficientTensorMap E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))) ≫
      E.subst.app (frozenSubstitution P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))) ≫
      E.toCollection.map (Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) :=
  AttachmentSource016_totalMapFold _ _ _ _ _ _ (E.toCollection.map_comp _ _)

/-- The original inside-first E-association route is exactly the
simultaneous original frozen nullary contraction after every local E-unit law. -/
theorem associationRouteA_isSimultaneous (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    expandedAssocSource E P Q1 Q2 ≫
        ColoredOperadObj.associativityRouteA E.toCollection E.subst (assocData P Q1 Q2) ≫
        E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
          Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) =
      simultaneousRoute E P Q1 Q2 := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData P Q1 Q2
  let c := afterInnerCompare P Q1 Q2
  let p := T.map (rawLocalSourceIso E.toCollection P Q1 Q2).hom
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (rawLocalGroups E.toCollection P Q1 Q2)
  let l := T.map (localInsertions E P Q1 Q2)
  let e := (FiniteTensor.flattenIso (V := C)).app (ColoredOperadObj.AssocInsertion.groupingA E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingAToFactorsHom E.toCollection E.subst d)
  let s := E.subst.app d.outerAfterInnerData
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap c)
  let k := E.toCollection.map (Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2))
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map c
  let s' := E.subst.app (frozenSubstitution P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)))
  let m := T.map (collapsedLocalFactors E P Q1 Q2)
  let n := T.map (simultaneousFactorMap E.toCollection P Q1 Q2) ≫
    frozenSubstitutionCoefficientTensorMap E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2))
  have hl : l ≫ g ≫ h = m :=
    (AttachmentSource016_mapThree T (localInsertions E P Q1 Q2)
      (ColoredOperadObj.AssocInsertion.groupingAToFactorsHom E.toCollection E.subst d)
      ((ColoredOperadObj.substitutionFactors E.toCollection).map c)).symm.trans
        (congrArg T.map (localInsertions_collapse E P Q1 Q2))
  have hs : s ≫ q = h ≫ s' := (E.subst.naturality c).symm
  have hp : p ≫ a ≫ m = n := collapsedSource_readback E P Q1 Q2
  have ht : E.toCollection.map (ColoredSubstitutionData.totalProfileMap c ≫
      Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) = q ≫ k := E.toCollection.map_comp _ _
  exact (congrArg (fun q => expandedAssocSource E P Q1 Q2 ≫
    ColoredOperadObj.associativityRouteA E.toCollection E.subst d ≫ q) ht).trans
      ((AttachmentSource016_routeAFold p a l e.inv e.hom g s q k h s' m n e.inv_hom_id hl hs hp).trans
        (simultaneousRoute_normalized E P Q1 Q2).symm)


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource016


section AttachmentSource017


/-!
## The original shared unary-unit positions distributed through local association blocks
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

private theorem AttachmentSource017_cancelPrefix {V : Type*} [Category* V] {X A Y : V}
    (e : X ≅ A) (r : A ⟶ Y) (p : X ⟶ Y) (h : r = e.inv ≫ p) : e.hom ≫ r = p :=
  (congrArg (e.hom ≫ ·) h).trans
    ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ p) e.hom_inv_id).trans (Category.id_comp p)))

private theorem AttachmentSource017_preparationFold {V : Type*} [Category* V] {X A B C D E F : V}
    (pu : X ⟶ A) (v : A ⟶ B) (g : B ⟶ C) (c : C ⟶ F)
    (z : X ⟶ D) (pb : D ⟶ B) (a : D ⟶ E) (l : E ⟶ F)
    (hv : z ≫ pb = pu ≫ v) (hd : pb ≫ g ≫ c = a ≫ l) : pu ≫ (v ≫ g) ≫ c = z ≫ a ≫ l := by
  simp only [Category.assoc]
  rw [← Category.assoc pu v (g ≫ c), ← hv]
  simp only [Category.assoc]
  rw [hd]

private theorem AttachmentSource017_cancelLastInverse {V : Type*} [Category* V] {X A B D E : V}
    (z : X ⟶ A) (a : A ⟶ B) (l : B ⟶ D) (e : E ≅ D) :
    (z ≫ a ≫ l ≫ e.inv) ≫ e.hom = z ≫ a ≫ l := by
  simp only [Category.assoc, e.inv_hom_id, Category.comp_id]

variable {W : Type u}

/-- The actual shared middle P/Q1 unit positions, followed by the surviving P inner unit positions. -/
def unitSlots (P : ColoredProfile W) (Q1 : ColoredInputs W) : FintypeCat.{0} :=
  FintypeCat.of ((P.inputs ⊕ Q1.index) ⊕ P.inputs)

/-- The original local unit counts: two at P, one at Q1, none at the root and Q2. -/
def unitsA (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    Option ((P.inputs ⊕ Q1.index) ⊕ Q2.index) → FintypeCat.{0}
  | none => FintypeCat.of (Fin 0)
  | some (Sum.inl (Sum.inl _)) => FintypeCat.of (Option PUnit)
  | some (Sum.inl (Sum.inr _)) => FintypeCat.of PUnit
  | some (Sum.inr _) => FintypeCat.of (Fin 0)

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The exact original shared unit-position bijection to the actual local block positions. -/
def unitSlotsAEquiv (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    unitSlots P Q1 ≃ blockUnitIndex (rawLocalGroups E P Q1 Q2) (unitsA P Q1 Q2) where
  toFun i := match i with
    | Sum.inl (Sum.inl i) => ⟨some (Sum.inl (Sum.inl i)), none⟩
    | Sum.inl (Sum.inr i) => ⟨some (Sum.inl (Sum.inr i)), PUnit.unit⟩
    | Sum.inr i => ⟨some (Sum.inl (Sum.inl i)), some PUnit.unit⟩
  invFun x := match x with
    | ⟨none, j⟩ => Fin.elim0 j
    | ⟨some (Sum.inl (Sum.inl i)), none⟩ => Sum.inl (Sum.inl i)
    | ⟨some (Sum.inl (Sum.inl i)), some _⟩ => Sum.inr i
    | ⟨some (Sum.inl (Sum.inr i)), _⟩ => Sum.inl (Sum.inr i)
    | ⟨some (Sum.inr _), j⟩ => Fin.elim0 j
  left_inv i := by cases i with
    | inl i => cases i <;> rfl
    | inr i => rfl
  right_inv x := by
    rcases x with ⟨i, j⟩
    cases i with
    | none => exact Fin.elim0 j
    | some i => cases i with
        | inl i => cases i with
            | inl i => cases j with
                | none => rfl
                | some j => cases j; rfl
            | inr i => cases j; rfl
        | inr i => exact Fin.elim0 j

/-- The literal original root/unit/constant coefficient map in every local block. -/
def unitBlocksA (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W)
    (i : (rawLocalGroups E.toCollection P Q1 Q2).index) :
    frozenVariableUnitFamily (unitsA P Q1 Q2 i) ((rawLocalGroups E.toCollection P Q1 Q2).obj i) ⟶
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2)).obj i :=
  match i with
  | none => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (extendProfile (extendProfile P Q1) Q2)))).hom ≫
      (FiniteFamily.singleton (C := C)).map
        (E.toCollection.map (frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
          ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2)))
  | some (Sum.inl (Sum.inl i)) =>
      UnitSource.bareMap (E.toCollection.obj (ColoredSubstitutionData.unitProfile (P.inputColor i)))
        (FintypeCat.of PUnit) (E.unit (P.inputColor i)) ≫
      Unit.rightCoefficientBareMap E (ColoredSubstitutionData.unitProfile (P.inputColor i))
  | some (Sum.inl (Sum.inr i)) => Linear.Constants.leftFrozenUnitMap E (ColoredProfile.nullary (Q1.obj i).as)
  | some (Sum.inr i) =>
      (Unit.rightUnitPositionIso (E.toCollection.obj (ColoredProfile.nullary (Q2.obj i).as)) (FintypeCat.of (Fin
        0))).hom ≫
      Unit.rightCoefficientBareMap E (ColoredProfile.nullary (Q2.obj i).as)

/-- Every local original block insertion is exactly its literal local unit prefix. -/
theorem unitBlocksA_applied (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    blockUnitAppliedMap (rawLocalGroups E.toCollection P Q1 Q2) (unitsA P Q1 Q2)
        (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2)).obj (unitBlocksA E P Q1 Q2) =
      localInsertions E P Q1 Q2 := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let X := E.toCollection.obj (extendProfile (extendProfile P Q1) Q2)
        let L := (FiniteFamily.singleton (C := C)).obj X
        let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) L).hom
        let e := (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) L).hom
        let f := (FiniteFamily.singleton (C := C)).map
          (E.toCollection.map (frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
            ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2)))
        let T := FiniteTensor.tensor (V := C)
        exact heq_of_eq ((congrArg (p ≫ ·) (T.map_comp e f)).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ T.map f) (ZeroVariable.emptyPrefix_unit (FintypeCat.of (Fin 0)) L)).trans (Category.id_comp
              _))))
    | some i =>
        cases i with
        | inl i =>
            cases i with
            | inl i =>
                let c := P.inputColor i
                let X := E.toCollection.obj (ColoredSubstitutionData.unitProfile c)
                let f := Unit.rightCoefficientBareMap E (ColoredSubstitutionData.unitProfile c)
                have h := congrArg (fun f => E.unit c ≫ UnitInsertion.rightInsertFromFactor X (FintypeCat.of PUnit) f)
                  (Unit.rightCoefficientFactor_normalized E (ColoredSubstitutionData.unitProfile c))
                exact heq_of_eq ((h.trans (UnitSource.rightInsert_fromUnit X (FintypeCat.of PUnit) (E.unit c) f)).symm)
            | inr i =>
                let N := ColoredProfile.nullary (Q1.obj i).as
                let e := (FiniteTensor.singletonIso (V := C)).app (E.toCollection.obj N)
                exact heq_of_eq (AttachmentSource017_cancelPrefix e (ColoredOperadObj.leftUnitInsert E.toCollection
                  E.unit N)
                  ((frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C := C)).obj
                    (E.toCollection.obj N))).hom ≫
                    (FiniteTensor.tensor (V := C)).map (Linear.Constants.leftFrozenUnitMap E N))
                  (Linear.Constants.leftUnitInsert_normalized E N) |>.symm)
        | inr i =>
            let N := ColoredProfile.nullary (Q2.obj i).as
            let e := (FiniteTensor.singletonIso (V := C)).app (E.toCollection.obj N)
            exact heq_of_eq (AttachmentSource017_cancelPrefix e (ColoredOperadObj.rightUnitInsert E.toCollection E.unit
              N)
              ((frozenVariableTensorUnitIso N.inputs ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj N))).hom
                ≫
                (FiniteTensor.tensor (V := C)).map ((Unit.rightUnitPositionIso (E.toCollection.obj N) N.inputs).hom ≫
                  Unit.rightCoefficientBareMap E N)) (Unit.rightUnitInsertion_normalized E N) |>.symm)

/-- The actual shared original unit and raw coefficient source map to grouping A. -/
def globalFactorA (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    frozenVariableUnitFamily (unitSlots P Q1) (sourceFactors E.toCollection P Q1 Q2) ⟶
      (FiniteFamily.flatten (C := C)).obj (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2))
        :=
  Variable.unitFamilyMap (unitSlotsAEquiv E.toCollection P Q1 Q2) (rawLocalSourceIso E.toCollection P Q1 Q2).hom ≫
    blockUnitGlobalMap (rawLocalGroups E.toCollection P Q1 Q2) (unitsA P Q1 Q2)
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2)).obj (unitBlocksA E P Q1 Q2)

/-- The shared original global unit prefix is exactly the independently
constructed original local unit insertion source for E.assoc. -/
theorem globalFactorA_source (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (frozenVariableTensorUnitIso (unitSlots P Q1) (sourceFactors E.toCollection P Q1 Q2)).hom ≫
        (FiniteTensor.tensor (V := C)).map (globalFactorA E P Q1 Q2) =
      expandedAssocSource E P Q1 Q2 := by
  let T := FiniteTensor.tensor (V := C)
  let N := rawLocalGroups E.toCollection P Q1 Q2
  let J := unitsA P Q1 Q2
  let M := ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2)
  let z := T.map (rawLocalSourceIso E.toCollection P Q1 Q2).hom
  let pu := (frozenVariableTensorUnitIso (unitSlots P Q1) (sourceFactors E.toCollection P Q1 Q2)).hom
  let pb := (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N)).hom
  let v := T.map (Variable.unitFamilyMap (unitSlotsAEquiv E.toCollection P Q1 Q2) (rawLocalSourceIso E.toCollection P Q1
    Q2).hom)
  let g := T.map (blockUnitGlobalMap N J M.obj (unitBlocksA E P Q1 Q2))
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let l := T.map (localInsertions E P Q1 Q2)
  let e := (FiniteTensor.flattenIso (V := C)).app M
  have hv : z ≫ pb = pu ≫ v := Variable.tensorUnitIso_naturality
    (unitSlotsAEquiv E.toCollection P Q1 Q2) (rawLocalSourceIso E.toCollection P Q1 Q2).hom
  have hd : pb ≫ g ≫ e.hom = a ≫ l := (tensorUnitBlock_applied N J M.obj (unitBlocksA E P Q1 Q2)).trans
    (congrArg (a ≫ ·) (congrArg T.map (unitBlocksA_applied E P Q1 Q2)))
  apply (cancel_mono e.hom).1
  exact (Category.assoc _ _ _).trans
    ((congrArg (fun g => pu ≫ g ≫ e.hom) (T.map_comp _ _)).trans
      ((AttachmentSource017_preparationFold pu v g e.hom z pb a l hv hd).trans (AttachmentSource017_cancelLastInverse z
        a l e).symm))


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource017


section AttachmentSource018


/-!
## The same original unit and coefficient source in the root-first association grouping
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root-first raw source: root/Q2 coefficients in its
root block, empty sources for P units, and singleton Q1 nullary coefficients. -/
def rawBlocksB (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option (assocData P Q1 Q2).middleData.totalProfile.inputs)
  obj i := match i with
    | none => frozenCoefficientFamily E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)
    | some ⟨Sum.inl (Sum.inl _), _⟩ => FiniteFamily.empty
    | some ⟨Sum.inl (Sum.inr i), _⟩ => (FiniteFamily.singleton (C := C)).obj (E.obj (ColoredProfile.nullary (Q1.obj
      i).as))
    | some ⟨Sum.inr _, j⟩ => Fin.elim0 j

/-- The original middle P/Q1 units are inserted at the root; each
surviving P inner coefficient has its original single unit source. -/
def unitsB (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    Option (assocData P Q1 Q2).middleData.totalProfile.inputs → FintypeCat.{0}
  | none => FintypeCat.of (P.inputs ⊕ Q1.index)
  | some ⟨Sum.inl (Sum.inl _), _⟩ => FintypeCat.of PUnit
  | some ⟨Sum.inl (Sum.inr _), _⟩ => FintypeCat.of (Fin 0)
  | some ⟨Sum.inr _, j⟩ => Fin.elim0 j

/-- The actual shared semantic unit positions map to the actual root-first block positions. -/
def unitSlotsBEquiv (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    unitSlots P Q1 ≃ blockUnitIndex (rawBlocksB E P Q1 Q2) (unitsB P Q1 Q2) where
  toFun i := match i with
    | Sum.inl i => ⟨none, i⟩
    | Sum.inr i => ⟨some ⟨Sum.inl (Sum.inl i), PUnit.unit⟩, PUnit.unit⟩
  invFun x := match x with
    | ⟨none, i⟩ => Sum.inl i
    | ⟨some ⟨Sum.inl (Sum.inl i), _⟩, _⟩ => Sum.inr i
    | ⟨some ⟨Sum.inl (Sum.inr _), _⟩, j⟩ => Fin.elim0 j
    | ⟨some ⟨Sum.inr _, j⟩, _⟩ => Fin.elim0 j
  left_inv i := by cases i <;> rfl
  right_inv x := by
    rcases x with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i =>
        rcases i with ⟨i, k⟩
        cases i with
        | inl i => cases i with
            | inl i => cases j; cases k; rfl
            | inr i => exact Fin.elim0 j
        | inr i => exact Fin.elim0 k

/-- The actual original root/Q2/Q1 coefficient family is the raw
root-first block source, with all empty P positions retained. -/
def rawSourceBIso (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sourceFactors E P Q1 Q2 ≅ (FiniteFamily.flatten (C := C)).obj (rawBlocksB E P Q1 Q2) :=
  FiniteFamily.isoOfComponents
    { toFun := fun x => match x with
        | ⟨none, i⟩ => ⟨none, i⟩
        | ⟨some i, _⟩ => ⟨some ⟨Sum.inl (Sum.inr i), PUnit.unit⟩, PUnit.unit⟩
      invFun := fun x => match x with
        | ⟨none, i⟩ => ⟨none, i⟩
        | ⟨some ⟨Sum.inl (Sum.inl _), _⟩, j⟩ => j.elim
        | ⟨some ⟨Sum.inl (Sum.inr i), _⟩, _⟩ => ⟨some i, PUnit.unit⟩
        | ⟨some ⟨Sum.inr _, j⟩, _⟩ => Fin.elim0 j
      left_inv := fun x => by
        rcases x with ⟨i, j⟩
        cases i with
        | none => rfl
        | some i => cases j; rfl
      right_inv := fun x => by
        rcases x with ⟨i, j⟩
        cases i with
        | none => rfl
        | some i =>
            rcases i with ⟨i, k⟩
            cases i with
            | inl i => cases i with
                | inl i => cases j
                | inr i => cases j; cases k; rfl
            | inr i => exact Fin.elim0 k }
    (fun x => match x with | ⟨none, _⟩ => Iso.refl _ | ⟨some _, _⟩ => Iso.refl _)

/-- Every original root-first block uses its literal original unit/coefficient map. -/
def unitBlocksB (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W)
    (i : (rawBlocksB E.toCollection P Q1 Q2).index) :
    frozenVariableUnitFamily (unitsB P Q1 Q2 i) ((rawBlocksB E.toCollection P Q1 Q2).obj i) ⟶
      (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)).obj i :=
  match i with
  | none => frozenUnitCoefficientMap E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
      (ColoredOperadObj.substitutionFactors E.toCollection).map (middleCompare P Q1 Q2)
  | some ⟨Sum.inl (Sum.inl i), _⟩ => UnitSource.oneSingletonMap ≫
      (FiniteFamily.singleton (C := C)).map (E.unit (P.inputColor i))
  | some ⟨Sum.inl (Sum.inr i), _⟩ => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as)))).hom
  | some ⟨Sum.inr _, j⟩ => Fin.elim0 j

/-- The original shared unit and coefficient source maps to the actual root-first coefficient grouping. -/
def globalFactorB (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    frozenVariableUnitFamily (unitSlots P Q1) (sourceFactors E.toCollection P Q1 Q2) ⟶
      (FiniteFamily.flatten (C := C)).obj (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2))
        :=
  Variable.unitFamilyMap (unitSlotsBEquiv E.toCollection P Q1 Q2) (rawSourceBIso E.toCollection P Q1 Q2).hom ≫
    blockUnitGlobalMap (rawBlocksB E.toCollection P Q1 Q2) (unitsB P Q1 Q2)
      (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)).obj (unitBlocksB E P Q1 Q2)

/-- The actual root-first raw blocks are precisely original empty P blocks
and the original sequential root/Q2/Q1 coefficient blocks. -/
def rawBEmptyOuterIso (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    rawBlocksB E P Q1 Q2 ≅ EmptyOuter.blocks P.inputs (sequentialGrouping E P Q1 Q2) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | none => Sum.inr none
        | some ⟨Sum.inl (Sum.inl i), _⟩ => Sum.inl i
        | some ⟨Sum.inl (Sum.inr i), _⟩ => Sum.inr (some i)
        | some ⟨Sum.inr _, j⟩ => Fin.elim0 j
      invFun := fun i => match i with
        | Sum.inl i => some ⟨Sum.inl (Sum.inl i), PUnit.unit⟩
        | Sum.inr none => none
        | Sum.inr (some i) => some ⟨Sum.inl (Sum.inr i), PUnit.unit⟩
      left_inv := fun i => by
        cases i with
        | none => rfl
        | some i => rcases i with ⟨i, j⟩; cases i with
            | inl i => cases i <;> cases j <;> rfl
            | inr i => exact Fin.elim0 j
      right_inv := fun i => by
        cases i with
        | inl i => rfl
        | inr i => cases i <;> rfl }
    (fun i => match i with
      | none => Iso.refl _
      | some ⟨Sum.inl (Sum.inl _), _⟩ => Iso.refl _
      | some ⟨Sum.inl (Sum.inr _), _⟩ => Iso.refl _
      | some ⟨Sum.inr _, j⟩ => Fin.elim0 j)

/-- The original coefficient factor map after the first Q2 contraction,
with the original P units and original singleton Q1 constants. -/
def postFirstMap (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawBlocksB E.toCollection P Q1 Q2) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj (frozenSubstitution P Q1 (Linear.Constants.branches
        Q1)) where
  equiv := Equiv.optionCongr (innerCompare P Q1 Q2).innerHom.equiv
  hom i := match i with
    | none => (firstFactorMap E P Q1 Q2).hom none ≫ E.toCollection.map (frozenOuterProfileHom P Q1
      (Linear.Constants.branches Q1))
    | some ⟨Sum.inl (Sum.inl i), _⟩ => E.unit (P.inputColor i)
    | some ⟨Sum.inl (Sum.inr i), _⟩ => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj
      (ColoredProfile.nullary (Q1.obj i).as))
    | some ⟨Sum.inr _, j⟩ => Fin.elim0 j


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource018


section AttachmentSource019


/-!
## Original root-first block contraction and surviving unit coefficient maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

private theorem AttachmentSource019_totalFold {V : Type*} [Category* V] {X A B D E F : V}
    (g : X ⟶ A) (s : A ⟶ B) (t : B ⟶ D) (r : D ⟶ E) (q : B ⟶ E) (j : E ⟶ F)
    (hq : q = t ≫ r) : (g ≫ s ≫ t) ≫ r ≫ j = (g ≫ s ≫ q) ≫ j := by
  rw [hq]
  simp only [Category.assoc]

private theorem AttachmentSource019_rootFold {V : Type*} [Category* V] {X A B D E F G : V}
    (p : X ⟶ A) (u : A ⟶ B) (s : B ⟶ D) (q : D ⟶ G)
    (t : A ⟶ E) (r : E ⟶ D) (y : E ⟶ F) (j : F ⟶ G)
    (hs : u ≫ s = t ≫ r) (hr : r ≫ q = y ≫ j) :
    (p ≫ u) ≫ s ≫ q = (p ≫ t ≫ y) ≫ j := by
  simp only [Category.assoc]
  rw [← Category.assoc u s q, hs]
  simp only [Category.assoc]
  rw [hr]

private theorem AttachmentSource019_singleValueFold {V : Type*} [Category* V] {U A B D E : V}
    (p : U ⟶ A) (l : A ⟶ B) (y : B ⟶ D) (s : D ⟶ E)
    (i : U ⟶ B) (r : B ⟶ U) (η : U ⟶ E)
    (hp : p ≫ l = i) (hs : y ≫ s = r ≫ η) (hi : i ≫ r = 𝟙 U) :
    (p ≫ (l ≫ y)) ≫ s = η := by
  simp only [Category.assoc]
  rw [← Category.assoc p l (y ≫ s), hp, hs, ← Category.assoc i r η, hi, Category.id_comp]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The first actual nullary contraction keeps its complete original total-profile map. -/
theorem firstFactorMap_normalized (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (firstFactorMap E P Q1 Q2).hom none =
      frozenSubstitutionCoefficientTensorMap E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
        E.subst.app (frozenSubstitution (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)) ≫
        E.toCollection.map (Linear.Constants.substitutionTotalHom (extendProfile P Q1) Q2) := by
  let g := frozenSubstitutionCoefficientTensorMap E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)
  let s := E.subst.app (frozenSubstitution (extendProfile P Q1) Q2 (Linear.Constants.branches Q2))
  let t := E.toCollection.map (frozenTotalProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2))
  let r := E.toCollection.map (Linear.Constants.totalProfileHom (extendProfile P Q1) Q2)
  let q := E.toCollection.map (Linear.Constants.substitutionTotalHom (extendProfile P Q1) Q2)
  have hq : q = t ≫ r := E.toCollection.map_comp _ _
  exact (Category.assoc g (s ≫ t) r).trans
    ((congrArg (g ≫ ·) (Category.assoc s t r)).trans (congrArg (g ≫ s ≫ ·) hq.symm))

/-- The actual root-first middle block uses the original Q2 tensor
coefficient map and the original middle-datum comparison. -/
theorem rootBlockApplied_readback (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (blockUnitAppliedMap (rawBlocksB E.toCollection P Q1 Q2) (unitsB P Q1 Q2)
      (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)).obj (unitBlocksB E P Q1 Q2)).hom
        none =
      frozenSubstitutionCoefficientTensorMap E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
        (ColoredOperadObj.substitutionSource E.toCollection).map (middleCompare P Q1 Q2) := by
  let T := FiniteTensor.tensor (V := C)
  let p := (frozenVariableTensorUnitIso (extendProfile P Q1).inputs
    (frozenCoefficientFamily E.toCollection (extendProfile P Q1) Q2 (Linear.Constants.branches Q2))).hom
  let f := frozenUnitCoefficientMap E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)
  let g := (ColoredOperadObj.substitutionFactors E.toCollection).map (middleCompare P Q1 Q2)
  exact (congrArg (p ≫ ·) (T.map_comp f g)).trans (Category.assoc _ _ _).symm

/-- Every original root-first block contracts to the actual second
frozen substitution source: Q2 is contracted at the root, P units remain
the original units, and Q1 coefficients retain their original singleton maps. -/
theorem unitBlocksB_contract (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    blockUnitAppliedMap (rawBlocksB E.toCollection P Q1 Q2) (unitsB P Q1 Q2)
        (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)).obj (unitBlocksB E P Q1 Q2) ≫
      ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst (assocData P Q1 Q2) ≫
      (ColoredOperadObj.substitutionFactors E.toCollection).map (innerCompare P Q1 Q2) =
    postFirstMap E P Q1 Q2 := by
  let A := blockUnitAppliedMap (rawBlocksB E.toCollection P Q1 Q2) (unitsB P Q1 Q2)
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)).obj (unitBlocksB E P Q1 Q2)
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let c := middleCompare P Q1 Q2
        let d := assocData P Q1 Q2
        let p := frozenSubstitutionCoefficientTensorMap E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)
        let u := (ColoredOperadObj.substitutionSource E.toCollection).map c
        let s := E.subst.app d.middleData
        let q := E.toCollection.map (ColoredSubstitutionData.outerProfileMap (innerCompare P Q1 Q2))
        let t := E.subst.app (frozenSubstitution (extendProfile P Q1) Q2 (Linear.Constants.branches Q2))
        let r := E.toCollection.map (ColoredSubstitutionData.totalProfileMap c)
        let y := E.toCollection.map (Linear.Constants.substitutionTotalHom (extendProfile P Q1) Q2)
        let j := E.toCollection.map (frozenOuterProfileHom P Q1 (Linear.Constants.branches Q1))
        have hs : u ≫ s = t ≫ r := E.subst.naturality c
        have hr : r ≫ q = y ≫ j := (E.toCollection.map_comp _ _).symm.trans
          ((congrArg E.toCollection.map (middleTotal_readback P Q1 Q2)).trans (E.toCollection.map_comp _ _))
        change HEq (A.hom none ≫ s ≫ q) ((firstFactorMap E P Q1 Q2).hom none ≫ j)
        exact heq_of_eq ((congrArg (· ≫ s ≫ q) (rootBlockApplied_readback E P Q1 Q2)).trans
          ((AttachmentSource019_rootFold p u s q t r y j hs hr).trans
            (congrArg (· ≫ j) (firstFactorMap_normalized E P Q1 Q2).symm)))
    | some i =>
        rcases i with ⟨i, k⟩
        cases i with
        | inl i =>
            cases i with
            | inl i =>
                let X := E.toCollection.obj (ColoredSubstitutionData.unitProfile (P.inputColor i))
                let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
                let η := E.unit (P.inputColor i)
                let p := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C)).hom
                let l := (FiniteTensor.tensor (V := C)).map (UnitSource.oneSingletonMap (C := C))
                let y := (FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map η)
                let s := (FiniteTensor.singletonIso (V := C)).hom.app X
                let q := E.toCollection.map (𝟙 (ColoredSubstitutionData.unitProfile (P.inputColor i)))
                let e := (FiniteTensor.singletonIso (V := C)).app U
                let f := UnitSource.oneSingletonMap (C := C) ≫ (FiniteFamily.singleton (C := C)).map η
                change HEq ((p ≫ (FiniteTensor.tensor (V := C)).map f) ≫ s ≫ q) η
                have h : (p ≫ (l ≫ y)) ≫ s = η := AttachmentSource019_singleValueFold p l y s e.inv e.hom η
                  UnitSource.onePrefix_singleton ((FiniteTensor.singletonIso (V := C)).hom.naturality η) e.inv_hom_id
                exact heq_of_eq ((congrArg (fun f => (p ≫ f) ≫ s ≫ q) ((FiniteTensor.tensor (V := C)).map_comp _
                  _)).trans
                  ((Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ q) h).trans
                      ((congrArg (η ≫ ·) (E.toCollection.map_id _)).trans (Category.comp_id _)))))
            | inr i =>
                let X := E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as)
                let L := (FiniteFamily.singleton (C := C)).obj X
                let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) L).hom
                let e := (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) L).hom
                let s := (FiniteTensor.singletonIso (V := C)).hom.app X
                let q := E.toCollection.map (𝟙 (ColoredProfile.nullary (Q1.obj i).as))
                change HEq ((p ≫ (FiniteTensor.tensor (V := C)).map e) ≫ s ≫ q) s
                exact heq_of_eq ((congrArg (· ≫ s ≫ q) (ZeroVariable.emptyPrefix_unit (FintypeCat.of (Fin 0)) L)).trans
                  ((Category.id_comp _).trans
                    ((congrArg (s ≫ ·) (E.toCollection.map_id _)).trans (Category.comp_id _))))
        | inr i => exact Fin.elim0 k


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource019


section AttachmentSource020


/-!
## The actual original root-first source is the literal sequential nullary contraction source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

private theorem AttachmentSource020_mapFour {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) :
    F.map (a ≫ b ≫ c ≫ d) = F.map a ≫ F.map b ≫ F.map c ≫ F.map d := by simp only [Functor.map_comp]

private theorem AttachmentSource020_sourceFold {V : Type*} [Category* V] {X A B D E F G H K Y : V}
    (p : X ⟶ A) (a : A ⟶ B) (f : B ⟶ Y) (b : B ⟶ D) (r : D ⟶ E) (u : E ⟶ F) (c : F ⟶ Y)
    (z : A ⟶ G) (q : G ⟶ D) (e : X ⟶ G) (n : X ⟶ H) (p1 : H ⟶ E)
    (d : H ⟶ K) (p2 : K ⟶ F)
    (hf : f = b ≫ r ≫ u ≫ c) (hn : a ≫ b = z ≫ q) (hp : p ≫ z = e)
    (he : e ≫ q ≫ r = n ≫ p1) (hu : p1 ≫ u = d ≫ p2) :
    p ≫ a ≫ f = n ≫ d ≫ (p2 ≫ c) := by
  rw [hf]
  rw [← Category.assoc a b (r ≫ u ≫ c), hn]
  simp only [Category.assoc]
  rw [← Category.assoc p z (q ≫ r ≫ u ≫ c), hp]
  have hpost : e ≫ q ≫ r ≫ u ≫ c = n ≫ p1 ≫ u ≫ c := by
    simpa only [Category.assoc] using congrArg (fun x => x ≫ u ≫ c) he
  rw [hpost]
  rw [← Category.assoc p1 u c, hu]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- The original source maps erase exactly the introduced empty P blocks
and retain every original root/Q2/Q1 coefficient position. -/
theorem rawBSource_erase (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (rawSourceBIso E P Q1 Q2).hom ≫
        (FiniteFamily.flatten (C := C)).map (rawBEmptyOuterIso E P Q1 Q2).hom ≫
        (EmptyOuter.eraseIso P.inputs (sequentialGrouping E P Q1 Q2)).hom =
      𝟙 (sourceFactors E P Q1 Q2) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro x
    rcases x with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl
  · intro x
    rcases x with ⟨i, j⟩
    cases i with
    | none =>
        cases j with
        | none =>
            let X := E.obj (extendProfile (extendProfile P Q1) Q2)
            change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
            exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))
        | some j =>
            let X := E.obj (ColoredProfile.nullary (Q2.obj j).as)
            change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
            exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))
    | some i =>
        cases j
        let X := E.obj (ColoredProfile.nullary (Q1.obj i).as)
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))

/-- The actual root-first factor map is the original empty P block
comparison, original first contraction map, and original second frozen factor map. -/
theorem postFirstMap_factor (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rawBEmptyOuterIso E.toCollection P Q1 Q2).hom ≫
        (EmptyOuter.pointIso P.inputs (sequentialGrouping E.toCollection P Q1 Q2)).hom ≫
        frozenVariableUnitFamilyMap P.inputs (firstFactorMap E P Q1 Q2) ≫
        frozenUnitCoefficientMap E P Q1 (Linear.Constants.branches Q1) =
      postFirstMap E P Q1 Q2 := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i => rcases i with ⟨i, j⟩; cases i with
        | inl i => cases i <;> cases j <;> rfl
        | inr i => exact Fin.elim0 j
  · intro i
    cases i with
    | none =>
        let K := frozenCoefficientFamily E.toCollection (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)
        let X := (FiniteTensor.tensor (V := C)).obj K
        let f := (firstFactorMap E P Q1 Q2).hom none
        let g := E.toCollection.map (frozenOuterProfileHom P Q1 (Linear.Constants.branches Q1))
        change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 K) ≫ 𝟙 X ≫ f ≫ g) (f ≫ g)
        exact heq_of_eq ((congrArg (fun k => k ≫ 𝟙 X ≫ f ≫ g) ((FiniteTensor.tensor (V := C)).map_id _)).trans
          ((Category.id_comp _).trans (Category.id_comp _)))
    | some i =>
        rcases i with ⟨i, j⟩
        cases i with
        | inl i =>
            cases i with
            | inl i =>
                let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
                let η := E.unit (P.inputColor i)
                change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ 𝟙 U ≫ 𝟙 U ≫
                  η) η
                exact heq_of_eq ((congrArg (fun k => k ≫ 𝟙 U ≫ 𝟙 U ≫ η) ((FiniteTensor.tensor (V := C)).map_id _)).trans
                  ((Category.id_comp _).trans ((Category.id_comp _).trans (Category.id_comp _))))
            | inr i =>
                let X := E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as)
                let Y := (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.singleton (C := C)).obj X)
                let s := (FiniteTensor.singletonIso (V := C)).hom.app X
                change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) ≫ 𝟙 Y ≫ s ≫
                  𝟙 X) s
                exact heq_of_eq ((congrArg (fun k => k ≫ 𝟙 Y ≫ s ≫ 𝟙 X) ((FiniteTensor.tensor (V := C)).map_id _)).trans
                  ((Category.id_comp _).trans ((Category.id_comp _).trans (Category.comp_id _))))
        | inr i => exact Fin.elim0 j

/-- The actual root-first tensor source becomes exactly the original
sequential first-factor map followed by the original second frozen tensor map. -/
theorem postFirstSource_readback (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (rawSourceBIso E.toCollection P Q1 Q2).hom ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (rawBlocksB E.toCollection P Q1 Q2) ≫
        (FiniteTensor.tensor (V := C)).map (postFirstMap E P Q1 Q2) =
      (FiniteTensor.flattenIso (V := C)).hom.app (sequentialGrouping E.toCollection P Q1 Q2) ≫
        (FiniteTensor.tensor (V := C)).map (firstFactorMap E P Q1 Q2) ≫
        frozenSubstitutionCoefficientTensorMap E P Q1 (Linear.Constants.branches Q1) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := sequentialGrouping E.toCollection P Q1 Q2
  let b := rawBEmptyOuterIso E.toCollection P Q1 Q2
  let er := EmptyOuter.eraseIso P.inputs N
  let p := T.map (rawSourceBIso E.toCollection P Q1 Q2).hom
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (rawBlocksB E.toCollection P Q1 Q2)
  let f := T.map (postFirstMap E P Q1 Q2)
  let bt := T.map ((FiniteFamily.map T).map b.hom)
  let r := T.map (EmptyOuter.pointIso P.inputs N).hom
  let u := T.map (frozenVariableUnitFamilyMap P.inputs (firstFactorMap E P Q1 Q2))
  let c := T.map (frozenUnitCoefficientMap E P Q1 (Linear.Constants.branches Q1))
  let z := T.map (F.map b.hom)
  let q := (FiniteTensor.flattenIso (V := C)).hom.app (EmptyOuter.blocks P.inputs N)
  let e := T.map er.inv
  let n := (FiniteTensor.flattenIso (V := C)).hom.app N
  let p1 := (frozenVariableTensorUnitIso P.inputs ((FiniteFamily.map T).obj N)).hom
  let d := T.map (firstFactorMap E P Q1 Q2)
  let p2 := (frozenVariableTensorUnitIso P.inputs
    (frozenCoefficientFamily E.toCollection P Q1 (Linear.Constants.branches Q1))).hom
  have hf : f = bt ≫ r ≫ u ≫ c := (congrArg T.map (postFirstMap_factor E P Q1 Q2).symm).trans
    (AttachmentSource020_mapFour T _ _ _ _)
  have hn : a ≫ bt = z ≫ q := (FiniteTensor.flattenIso (V := C)).hom.naturality b.hom |>.symm
  have hRaw : ((rawSourceBIso E.toCollection P Q1 Q2).hom ≫ F.map b.hom) ≫ er.hom = 𝟙 _ :=
    (Category.assoc _ _ _).trans (rawBSource_erase E.toCollection P Q1 Q2)
  have hInv : (rawSourceBIso E.toCollection P Q1 Q2).hom ≫ F.map b.hom = er.inv := (er.comp_hom_eq_id).1 hRaw
  have hp : p ≫ z = e := (T.map_comp _ _).symm.trans (congrArg T.map hInv)
  have he : e ≫ q ≫ r = n ≫ p1 := EmptyOuter.normalization P.inputs N
  have hu : p1 ≫ u = d ≫ p2 := frozenVariableTensorUnitIso_naturality P.inputs (firstFactorMap E P Q1 Q2) |>.symm
  exact AttachmentSource020_sourceFold p a f bt r u c z q e n p1 d p2 hf hn hp he hu


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource020


section AttachmentSource021


/-!
## The exact original shared coefficient and unit map under associativity regrouping
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Both original association groupings use exactly the same original
root, Q1/Q2 constants and middle/inner unit maps, through the actual
Option/Sigma association coefficient permutation. -/
theorem globalFactors_regroup (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    globalFactorA E P Q1 Q2 ≫
        ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData P Q1 Q2) =
      globalFactorB E P Q1 Q2 := by
  let NA := rawLocalGroups E.toCollection P Q1 Q2
  let JA := unitsA P Q1 Q2
  let MA := ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData P Q1 Q2)
  let fA := unitBlocksA E P Q1 Q2
  let eA := unitSlotsAEquiv E.toCollection P Q1 Q2
  let zA := (rawLocalSourceIso E.toCollection P Q1 Q2).hom
  let NB := rawBlocksB E.toCollection P Q1 Q2
  let JB := unitsB P Q1 Q2
  let MB := ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)
  let fB := unitBlocksB E P Q1 Q2
  let eB := unitSlotsBEquiv E.toCollection P Q1 Q2
  let zB := (rawSourceBIso E.toCollection P Q1 Q2).hom
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | inl i => cases i with
        | inl i => cases i <;> rfl
        | inr i => rfl
    | inr i =>
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; rfl
  · intro i
    cases i with
    | inl i =>
        cases i with
        | inl i =>
            cases i with
            | inl i =>
                let u : unitSlots P Q1 := Sum.inl (Sum.inl i)
                let Y := E.toCollection.obj (ColoredSubstitutionData.rightUnit (ColoredSubstitutionData.unitProfile
                  (P.inputColor i))).outerProfile
                have ha := UnitBlocks.relabeledGlobal_unit_hom NA JA MA.obj fA eA zA u
                have hb := UnitBlocks.relabeledGlobal_unit_hom NB JB MB.obj fB eB zB u
                change HEq ((globalFactorA E P Q1 Q2).hom (Sum.inl u) ≫ 𝟙 Y)
                  ((globalFactorB E P Q1 Q2).hom (Sum.inl u))
                exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) ha).trans ((Category.comp_id _).trans hb.symm))
            | inr i =>
                let u : unitSlots P Q1 := Sum.inl (Sum.inr i)
                let Y := E.toCollection.obj (ColoredSubstitutionData.leftUnit (ColoredProfile.nullary (Q1.obj
                  i).as)).outerProfile
                have ha := UnitBlocks.relabeledGlobal_unit_hom NA JA MA.obj fA eA zA u
                have hb := UnitBlocks.relabeledGlobal_unit_hom NB JB MB.obj fB eB zB u
                change HEq ((globalFactorA E P Q1 Q2).hom (Sum.inl u) ≫ 𝟙 Y)
                  ((globalFactorB E P Q1 Q2).hom (Sum.inl u))
                exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) ha).trans ((Category.comp_id _).trans hb.symm))
        | inr i =>
            let u : unitSlots P Q1 := Sum.inr i
            let Y := E.toCollection.obj (ColoredSubstitutionData.unitProfile (P.inputColor i))
            have ha := UnitBlocks.relabeledGlobal_unit_hom NA JA MA.obj fA eA zA u
            have hb := UnitBlocks.relabeledGlobal_unit_hom NB JB MB.obj fB eB zB u
            change HEq ((globalFactorA E P Q1 Q2).hom (Sum.inl u) ≫ 𝟙 Y)
              ((globalFactorB E P Q1 Q2).hom (Sum.inl u))
            exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) ha).trans ((Category.comp_id _).trans hb.symm))
    | inr i =>
        rcases i with ⟨i, j⟩
        cases i with
        | none =>
            cases j with
            | none =>
                let r : (sourceFactors E.toCollection P Q1 Q2).index := ⟨none, none⟩
                let X := E.toCollection.obj (extendProfile (extendProfile P Q1) Q2)
                let Y := E.toCollection.obj (assocData P Q1 Q2).middleData.outerProfile
                let a := E.toCollection.map (frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches
                  Q2))
                let b := E.toCollection.map (ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2))
                let c := E.toCollection.map (frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches
                  Q2) ≫
                  ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2))
                have ha := UnitBlocks.relabeledGlobal_coefficient_hom NA JA MA.obj fA eA zA r
                have hb := UnitBlocks.relabeledGlobal_coefficient_hom NB JB MB.obj fB eB zB r
                change HEq ((globalFactorA E P Q1 Q2).hom (Sum.inr r) ≫ 𝟙 Y)
                  ((globalFactorB E P Q1 Q2).hom (Sum.inr r))
                have hh : (𝟙 X ≫ 𝟙 X ≫ c) ≫ 𝟙 Y = 𝟙 X ≫ a ≫ b :=
                  (congrArg (· ≫ 𝟙 Y) ((Category.id_comp _).trans (Category.id_comp c))).trans
                    ((Category.comp_id c).trans
                      ((E.toCollection.map_comp
                        (frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2))
                        (ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2))).trans
                          (Category.id_comp (a ≫ b)).symm))
                exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) ha).trans (hh.trans hb.symm))
            | some j =>
                let r : (sourceFactors E.toCollection P Q1 Q2).index := ⟨none, some j⟩
                let Y := E.toCollection.obj (ColoredSubstitutionData.rightUnit (ColoredProfile.nullary (Q2.obj
                  j).as)).outerProfile
                have ha := UnitBlocks.relabeledGlobal_coefficient_hom NA JA MA.obj fA eA zA r
                have hb := UnitBlocks.relabeledGlobal_coefficient_hom NB JB MB.obj fB eB zB r
                change HEq ((globalFactorA E P Q1 Q2).hom (Sum.inr r) ≫ 𝟙 Y)
                  ((globalFactorB E P Q1 Q2).hom (Sum.inr r))
                exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) ha).trans ((Category.comp_id _).trans hb.symm))
        | some i =>
            cases j
            let r : (sourceFactors E.toCollection P Q1 Q2).index := ⟨some i, PUnit.unit⟩
            let Y := E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as)
            have ha := UnitBlocks.relabeledGlobal_coefficient_hom NA JA MA.obj fA eA zA r
            have hb := UnitBlocks.relabeledGlobal_coefficient_hom NB JB MB.obj fB eB zB r
            change HEq ((globalFactorA E P Q1 Q2).hom (Sum.inr r) ≫ 𝟙 Y)
              ((globalFactorB E P Q1 Q2).hom (Sum.inr r))
            exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) ha).trans ((Category.comp_id _).trans hb.symm))


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource021


section AttachmentSource022


/-!
## Original E-association root-first route is the literal sequential nullary contraction
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

private theorem AttachmentSource022_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem AttachmentSource022_preparationFold {V : Type*} [Category* V] {X A B C D E F : V}
    (pu : X ⟶ A) (v : A ⟶ B) (g : B ⟶ C) (c : C ⟶ F)
    (z : X ⟶ D) (pb : D ⟶ B) (a : D ⟶ E) (l : E ⟶ F)
    (hv : z ≫ pb = pu ≫ v) (hd : pb ≫ g ≫ c = a ≫ l) : pu ≫ (v ≫ g) ≫ c = z ≫ a ≫ l := by
  simp only [Category.assoc]
  rw [← Category.assoc pu v (g ≫ c), ← hv]
  simp only [Category.assoc]
  rw [hd]

private theorem AttachmentSource022_groupingFold {V : Type*} [Category* V] {X A B C Y : V}
    (p : X ⟶ A) (a : A ⟶ B) (θ : X ⟶ B) (r : B ⟶ C) (b : A ⟶ C) (k : C ⟶ Y)
    (hθ : p ≫ a = θ) (hb : a ≫ r = b) : θ ≫ r ≫ k = p ≫ b ≫ k := by
  rw [← hθ]
  simp only [Category.assoc]
  rw [← Category.assoc a r k, hb]

private theorem AttachmentSource022_totalFold {V : Type*} [Category* V] {X A B D E F G : V}
    (a : X ⟶ A) (b : A ⟶ B) (f : B ⟶ D) (s : D ⟶ E) (t : E ⟶ F) (r : F ⟶ G) (k : E ⟶ G)
    (hk : k = t ≫ r) : a ≫ b ≫ (f ≫ s ≫ t) ≫ r = (a ≫ b ≫ f) ≫ s ≫ k := by
  rw [hk]
  simp only [Category.assoc]

private theorem AttachmentSource022_routeBFold {V : Type*} [Category* V]
    {X A B C D E F G H J K L : V} (θ : X ⟶ A) (r : A ⟶ B) (a : B ⟶ C)
    (g : C ⟶ D) (s : D ⟶ E) (t : E ⟶ F) (q : F ⟶ K)
    (z : X ⟶ G) (ar : G ⟶ H) (l : H ⟶ C) (qi : E ⟶ J) (k : J ⟶ K)
    (hi : D ⟶ L) (s2 : L ⟶ J) (m : H ⟶ L) (n : X ⟶ L)
    (hsrc : θ ≫ r ≫ a = z ≫ ar ≫ l) (ht : t ≫ q = qi ≫ k)
    (hs : s ≫ qi = hi ≫ s2) (hf : l ≫ g ≫ hi = m) (hp : z ≫ ar ≫ m = n) :
    θ ≫ (r ≫ a ≫ g ≫ s ≫ t) ≫ q = n ≫ s2 ≫ k := by
  have hsource : θ ≫ r ≫ a ≫ g ≫ s ≫ qi ≫ k = z ≫ ar ≫ l ≫ g ≫ s ≫ qi ≫ k := by
    simpa only [Category.assoc] using congrArg (fun x => x ≫ g ≫ s ≫ qi ≫ k) hsrc
  have hfactor : z ≫ ar ≫ l ≫ g ≫ hi = n := by
    simpa only [Category.assoc] using (congrArg (z ≫ ar ≫ ·) hf).trans hp
  have hpost : z ≫ ar ≫ l ≫ g ≫ hi ≫ s2 ≫ k = n ≫ s2 ≫ k := by
    simpa only [Category.assoc] using congrArg (fun x => x ≫ s2 ≫ k) hfactor
  simp only [Category.assoc]
  rw [ht]
  rw [hsource, ← Category.assoc s qi k, hs]
  simpa only [Category.assoc] using hpost

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual expanded source through the original association coefficient
permutation is the original root-first blockwise unit insertion source. -/
theorem groupingB_source_readback (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    expandedAssocSource E P Q1 Q2 ≫
        (FiniteTensor.tensor (V := C)).map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection
          (assocData P Q1 Q2)) ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData
          P Q1 Q2)) =
      (FiniteTensor.tensor (V := C)).map (rawSourceBIso E.toCollection P Q1 Q2).hom ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (rawBlocksB E.toCollection P Q1 Q2) ≫
        (FiniteTensor.tensor (V := C)).map
          (blockUnitAppliedMap (rawBlocksB E.toCollection P Q1 Q2) (unitsB P Q1 Q2)
            (ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)).obj (unitBlocksB E P Q1 Q2))
              := by
  let T := FiniteTensor.tensor (V := C)
  let N := rawBlocksB E.toCollection P Q1 Q2
  let J := unitsB P Q1 Q2
  let M := ColoredOperadObj.AssocInsertion.groupingB E.toCollection (assocData P Q1 Q2)
  let p := (frozenVariableTensorUnitIso (unitSlots P Q1) (sourceFactors E.toCollection P Q1 Q2)).hom
  let a := T.map (globalFactorA E P Q1 Q2)
  let r := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData P Q1 Q2))
  let b := T.map (globalFactorB E P Q1 Q2)
  let θ := expandedAssocSource E P Q1 Q2
  let c := (FiniteTensor.flattenIso (V := C)).hom.app M
  let z := T.map (rawSourceBIso E.toCollection P Q1 Q2).hom
  let pb := (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N)).hom
  let v := T.map (Variable.unitFamilyMap (unitSlotsBEquiv E.toCollection P Q1 Q2) (rawSourceBIso E.toCollection P Q1
    Q2).hom)
  let g := T.map (blockUnitGlobalMap N J M.obj (unitBlocksB E P Q1 Q2))
  let ar := (FiniteTensor.flattenIso (V := C)).hom.app N
  let l := T.map (blockUnitAppliedMap N J M.obj (unitBlocksB E P Q1 Q2))
  have hθ : p ≫ a = θ := globalFactorA_source E P Q1 Q2
  have hb : a ≫ r = b := (T.map_comp _ _).symm.trans (congrArg T.map (globalFactors_regroup E P Q1 Q2))
  have hv : z ≫ pb = p ≫ v := Variable.tensorUnitIso_naturality (unitSlotsBEquiv E.toCollection P Q1 Q2)
    (rawSourceBIso E.toCollection P Q1 Q2).hom
  have hd : pb ≫ g ≫ c = ar ≫ l := tensorUnitBlock_applied N J M.obj (unitBlocksB E P Q1 Q2)
  exact (AttachmentSource022_groupingFold p a θ r b c hθ hb).trans
    ((congrArg (fun b => p ≫ b ≫ c) (T.map_comp _ _)).trans (AttachmentSource022_preparationFold p v g c z pb ar l hv
      hd))

/-- The sequential route retains both actual original frozen partial
substitutions and its exact original complete second total-profile map. -/
theorem sequentialRoute_normalized (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sequentialRoute E P Q1 Q2 =
      ((FiniteTensor.flattenIso (V := C)).hom.app (sequentialGrouping E.toCollection P Q1 Q2) ≫
        (FiniteTensor.tensor (V := C)).map (firstFactorMap E P Q1 Q2) ≫
        frozenSubstitutionCoefficientTensorMap E P Q1 (Linear.Constants.branches Q1)) ≫
      E.subst.app (frozenSubstitution P Q1 (Linear.Constants.branches Q1)) ≫
        E.toCollection.map (Linear.Constants.substitutionTotalHom P Q1) :=
  AttachmentSource022_totalFold _ _ _ _ _ _ _ (E.toCollection.map_comp _ _)

/-- The actual root-first E-association route is exactly the original
sequential Q2-then-Q1 frozen nullary contraction, with all original source
unit insertions, tensor groupings and empty total-profile maps retained. -/
theorem associationRouteB_isSequential (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    expandedAssocSource E P Q1 Q2 ≫
        ColoredOperadObj.associativityRouteB E.toCollection E.subst (assocData P Q1 Q2) ≫
        E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
          Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) =
      sequentialRoute E P Q1 Q2 := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData P Q1 Q2
  let i := innerCompare P Q1 Q2
  let θ := expandedAssocSource E P Q1 Q2
  let r := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection d)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (ColoredOperadObj.AssocInsertion.groupingB E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst d)
  let s := E.subst.app d.innerData
  let t := E.toCollection.map d.totalHom
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
    Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2))
  let z := T.map (rawSourceBIso E.toCollection P Q1 Q2).hom
  let ar := (FiniteTensor.flattenIso (V := C)).hom.app (rawBlocksB E.toCollection P Q1 Q2)
  let l := T.map (blockUnitAppliedMap (rawBlocksB E.toCollection P Q1 Q2) (unitsB P Q1 Q2)
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection d).obj (unitBlocksB E P Q1 Q2))
  let qi := E.toCollection.map (ColoredSubstitutionData.totalProfileMap i)
  let k := E.toCollection.map (Linear.Constants.substitutionTotalHom P Q1)
  let hi := (ColoredOperadObj.substitutionSource E.toCollection).map i
  let s2 := E.subst.app (frozenSubstitution P Q1 (Linear.Constants.branches Q1))
  let m := T.map (postFirstMap E P Q1 Q2)
  let n := (FiniteTensor.flattenIso (V := C)).hom.app (sequentialGrouping E.toCollection P Q1 Q2) ≫
    T.map (firstFactorMap E P Q1 Q2) ≫ frozenSubstitutionCoefficientTensorMap E P Q1 (Linear.Constants.branches Q1)
  have hsrc : θ ≫ r ≫ a = z ≫ ar ≫ l := groupingB_source_readback E P Q1 Q2
  have htotal : d.totalHom ≫ (ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
      Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2)) =
      ColoredSubstitutionData.totalProfileMap i ≫ Linear.Constants.substitutionTotalHom P Q1 := totalProfile_readback P
        Q1 Q2
  have ht : t ≫ q = qi ≫ k := (E.toCollection.map_comp _ _).symm.trans
    ((congrArg E.toCollection.map htotal).trans (E.toCollection.map_comp _ _))
  have hs : s ≫ qi = hi ≫ s2 := (E.subst.naturality i).symm
  have hf : l ≫ g ≫ hi = m := (AttachmentSource022_mapThree T _ _ _).symm.trans (congrArg T.map (unitBlocksB_contract E
    P Q1 Q2))
  have hp : z ≫ ar ≫ m = n := postFirstSource_readback E P Q1 Q2
  exact (AttachmentSource022_routeBFold θ r a g s t q z ar l qi k hi s2 m n hsrc ht hs hf hp).trans
    (sequentialRoute_normalized E P Q1 Q2).symm


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource022


section AttachmentSource023


/-!
## Pure original disjoint nullary coefficient substitution associativity
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The two original Q2-then-Q1 and simultaneous Q1⊔Q2 nullary
coefficient routes agree, with their actual root, unit insertions,
finite tensor regroupings and empty total-profile maps retained. -/
theorem sequential_eq_simultaneous (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sequentialRoute E P Q1 Q2 = simultaneousRoute E P Q1 Q2 :=
  (associationRouteB_isSequential E P Q1 Q2).symm.trans
    ((original_assoc E P Q1 Q2).symm.trans (associationRouteA_isSimultaneous E P Q1 Q2))

/-- The source-faithful disjoint nullary coefficient associativity
equation uses only the original frozenPartialSubstitution operations,
original input permutations and original empty-input deletion maps. -/
theorem coefficient_assoc (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.flattenIso (V := C)).hom.app (sequentialGrouping E.toCollection P Q1 Q2) ≫
        (FiniteTensor.tensor (V := C)).map (firstFactorMap E P Q1 Q2) ≫
        frozenPartialSubstitution E P Q1 (Linear.Constants.branches Q1) ≫
        E.toCollection.map (Linear.Constants.totalProfileHom P Q1) =
      (FiniteTensor.tensor (V := C)).map (simultaneousFactorMap E.toCollection P Q1 Q2) ≫
        frozenPartialSubstitution E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)) ≫
        E.toCollection.map (Linear.Constants.totalProfileHom P (inputSum Q1 Q2)) :=
  sequential_eq_simultaneous E P Q1 Q2


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource023


section AttachmentSource024


/-!
## Original attaching-value inputs for two successive disjoint contractions
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationAssocFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationAssocTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationAssocProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The unchanged original coefficient contraction followed by its original
empty-input deletion. -/
def deletedCoefficientContraction (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj (constantInputFamily E.toCollection X P Q) ⟶
      E.toCollection.obj P :=
  initialCoefficientContraction E a P Q ≫ E.toCollection.map (constantInputsDeletionHom P Q)

/-- The actual root/Q2 input block and the original Q1 singleton inputs. -/
def sequentialInputGrouping (E : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option Q1.index)
  obj i := match i with
    | none => constantInputFamily E X (extendProfile P Q1) Q2
    | some i => (FiniteFamily.singleton (C := C)).obj (X (Q1.obj i).as)

/-- Convert every original X input to its attaching nullary coefficient in
its original block; the root coefficient is unchanged. -/
def attachingCoefficientBlocks (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sequentialInputGrouping E.toCollection X P Q1 Q2 ⟶
      DisjointNullary.sequentialGrouping E.toCollection P Q1 Q2 where
  equiv := Equiv.refl (Option Q1.index)
  hom i := match i with
    | none => constantInputCoefficientMap E a (extendProfile P Q1) Q2
    | some i => (FiniteFamily.singleton (C := C)).map (attachingNullaryValue E a (Q1.obj i).as)

/-- Contract precisely the original Q2 block and retain every Q1 input. -/
def firstInputFactorMap (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (sequentialInputGrouping E.toCollection X P Q1 Q2) ⟶
      constantInputFamily E.toCollection X P Q1 where
  equiv := Equiv.refl (Option Q1.index)
  hom i := match i with
    | none => deletedCoefficientContraction E a (extendProfile P Q1) Q2
    | some i => (FiniteTensor.singletonIso (V := C)).hom.app (X (Q1.obj i).as)

/-- The original root sum association and the actual Q2/Q1 input
permutation put the inputs into the unchanged simultaneous contraction. -/
def simultaneousInputFactorMap (E : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).obj (sequentialInputGrouping E X P Q1 Q2) ⟶
      constantInputFamily E X P (DisjointNullary.inputSum Q1 Q2) where
  equiv :=
    { toFun := fun i => match i with
        | ⟨none, none⟩ => none
        | ⟨none, some i⟩ => some (Sum.inr i)
        | ⟨some i, _⟩ => some (Sum.inl i)
      invFun := fun i => match i with
        | none => ⟨none, none⟩
        | some (Sum.inl i) => ⟨some i, PUnit.unit⟩
        | some (Sum.inr i) => ⟨none, some i⟩
      left_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; rfl
      right_inv := fun i => by
        cases i with
        | none => rfl
        | some i => cases i <;> rfl }
  hom i := match i with
    | ⟨none, none⟩ => E.map (DisjointNullary.rootSumAssocHom P Q1 Q2)
    | ⟨none, some _⟩ => 𝟙 _
    | ⟨some _, _⟩ => 𝟙 _

/-- The original Q2-then-Q1 attaching-value contraction on its full tensor source. -/
def sequentialInputContraction (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.flatten (C := C)).obj (sequentialInputGrouping E.toCollection X P Q1 Q2)) ⟶
      E.toCollection.obj P :=
  (FiniteTensor.flattenIso (V := C)).hom.app (sequentialInputGrouping E.toCollection X P Q1 Q2) ≫
    (FiniteTensor.tensor (V := C)).map (firstInputFactorMap E a P Q1 Q2) ≫
      deletedCoefficientContraction E a P Q1

/-- The simultaneous original Q1⊔Q2 attaching-value contraction. -/
def simultaneousInputContraction (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.flatten (C := C)).obj (sequentialInputGrouping E.toCollection X P Q1 Q2)) ⟶
      E.toCollection.obj P :=
  (FiniteTensor.tensor (V := C)).map (simultaneousInputFactorMap E.toCollection X P Q1 Q2) ≫
    deletedCoefficientContraction E a P (DisjointNullary.inputSum Q1 Q2)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource024


section AttachmentSource025


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationAssocMapsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationAssocMapsTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationAssocMapsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual Q2 contraction commutes with converting the unchanged Q1
inputs to the original attaching nullary coefficients. -/
theorem attachingCoefficientBlocks_first (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (attachingCoefficientBlocks E a P Q1 Q2) ≫
        DisjointNullary.firstFactorMap E P Q1 Q2 =
      firstInputFactorMap E a P Q1 Q2 ≫ constantInputCoefficientMap E a P Q1 := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let f := (FiniteTensor.tensor (V := C)).map
          (constantInputCoefficientMap E a (extendProfile P Q1) Q2)
        let g := frozenPartialSubstitution E (extendProfile P Q1) Q2 (constantBranches Q2)
        let h := E.toCollection.map (constantInputsDeletionHom (extendProfile P Q1) Q2)
        change HEq (f ≫ (DisjointNullary.firstFactorMap E P Q1 Q2).hom none)
          (((f ≫ g) ≫ h) ≫ 𝟙 _)
        apply heq_of_eq
        exact (congrArg (f ≫ ·) (DisjointNullary.firstFactorMap_root E P Q1 Q2)).trans
          ((Category.assoc f g h).symm.trans (Category.comp_id _).symm)
    | some i =>
        let b := attachingNullaryValue E a (Q1.obj i).as
        change HEq ((FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.singleton (C := C)).map b) ≫
            (FiniteTensor.singletonIso (V := C)).hom.app _)
          ((FiniteTensor.singletonIso (V := C)).hom.app _ ≫ b)
        exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).hom.naturality b)

/-- The actual flattened input map and coefficient permutation commute;
every original Q2/Q1 input retains its original attaching-value map. -/
theorem attachingCoefficientBlocks_simultaneous (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).map (attachingCoefficientBlocks E a P Q1 Q2) ≫
        DisjointNullary.simultaneousFactorMap E.toCollection P Q1 Q2 =
      simultaneousInputFactorMap E.toCollection X P Q1 Q2 ≫
        constantInputCoefficientMap E a P (DisjointNullary.inputSum Q1 Q2) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    rintro ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl
  · intro i
    rcases i with ⟨i, j⟩
    cases i with
    | none =>
        cases j with
        | none =>
            let f := E.toCollection.map (DisjointNullary.rootSumAssocHom P Q1 Q2)
            change HEq (𝟙 _ ≫ f) (f ≫ 𝟙 _)
            exact heq_of_eq ((Category.id_comp f).trans (Category.comp_id f).symm)
        | some j =>
            let b := attachingNullaryValue E a (Q2.obj j).as
            change HEq (b ≫ 𝟙 _) (𝟙 _ ≫ b)
            exact heq_of_eq ((Category.comp_id b).trans (Category.id_comp b).symm)
    | some i =>
        cases j
        let b := attachingNullaryValue E a (Q1.obj i).as
        change HEq (b ≫ 𝟙 _) (𝟙 _ ≫ b)
        exact heq_of_eq ((Category.comp_id b).trans (Category.id_comp b).symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource025


section AttachmentSource026


/-!
## Associativity of the actual original attaching-value contractions
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource026_flatRoute {D : Type*} [Category* D]
    {A B C D' E F G : D} (f : A ⟶ B) (n' : B ⟶ C) (h : C ⟶ D') (p : D' ⟶ G)
    (n : A ⟶ E) (g : E ⟶ C) (u : E ⟶ F) (i : F ⟶ D')
    (hf : f ≫ n' = n ≫ g) (hh : g ≫ h = u ≫ i) :
    f ≫ n' ≫ h ≫ p = n ≫ u ≫ i ≫ p := by
  calc
    f ≫ n' ≫ h ≫ p = (f ≫ n') ≫ h ≫ p := (Category.assoc _ _ _).symm
    _ = (n ≫ g) ≫ h ≫ p := congrArg (· ≫ h ≫ p) hf
    _ = n ≫ (g ≫ h) ≫ p := by simp only [Category.assoc]
    _ = n ≫ (u ≫ i) ≫ p := congrArg (fun q => n ≫ q ≫ p) hh
    _ = n ≫ u ≫ i ≫ p := by simp only [Category.assoc]

private theorem AttachmentSource026_postRoute {D : Type*} [Category* D]
    {A B C D' E : D} (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E)
    (u : A ⟶ D') (v : D' ⟶ C) (he : f ≫ g = u ≫ v) :
    f ≫ g ≫ h = u ≫ v ≫ h :=
  (Category.assoc f g h).symm.trans
    ((congrArg (· ≫ h) he).trans (Category.assoc u v h))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationAssocLawFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationAssocLawTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationAssocLawProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Precomposing the original sequential coefficient route by the original
attaching-value maps gives exactly the original sequential input contraction. -/
theorem attachingCoefficientBlocks_sequentialRoute (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (attachingCoefficientBlocks E a P Q1 Q2)) ≫
      DisjointNullary.sequentialRoute E P Q1 Q2 = sequentialInputContraction E a P Q1 Q2 := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let MT := FiniteFamily.map T
  let H := attachingCoefficientBlocks E a P Q1 Q2
  let b := constantInputCoefficientMap E a P Q1
  let p := frozenPartialSubstitution E P Q1 (constantBranches Q1) ≫
    E.toCollection.map (constantInputsDeletionHom P Q1)
  have hf : T.map (F.map H) ≫ (FiniteTensor.flattenIso (V := C)).hom.app _ =
      (FiniteTensor.flattenIso (V := C)).hom.app _ ≫ T.map (MT.map H) :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality H
  have hh : T.map (MT.map H) ≫ T.map (DisjointNullary.firstFactorMap E P Q1 Q2) =
      T.map (firstInputFactorMap E a P Q1 Q2) ≫ T.map b :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (attachingCoefficientBlocks_first E a P Q1 Q2)).trans (T.map_comp _ _))
  have he := AttachmentSource026_flatRoute (T.map (F.map H))
    ((FiniteTensor.flattenIso (V := C)).hom.app _)
    (T.map (DisjointNullary.firstFactorMap E P Q1 Q2)) p
    ((FiniteTensor.flattenIso (V := C)).hom.app _) (T.map (MT.map H))
    (T.map (firstInputFactorMap E a P Q1 Q2)) (T.map b) hf hh
  simpa only [DisjointNullary.sequentialRoute, DisjointNullary.deletionHom_eq_initial,
    sequentialInputContraction, deletedCoefficientContraction, initialCoefficientContraction,
    DisjointNullary.branches_eq_initial, T, F, MT, H, b, p, Category.assoc] using! he

/-- Precomposing the original simultaneous coefficient route retains exactly
the actual root association, input permutation and original attaching values. -/
theorem attachingCoefficientBlocks_simultaneousRoute (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (attachingCoefficientBlocks E a P Q1 Q2)) ≫
      DisjointNullary.simultaneousRoute E P Q1 Q2 = simultaneousInputContraction E a P Q1 Q2 := by
  let T := FiniteTensor.tensor (V := C)
  let f := (FiniteFamily.flatten (C := C)).map (attachingCoefficientBlocks E a P Q1 Q2)
  let g := DisjointNullary.simultaneousFactorMap E.toCollection P Q1 Q2
  let u := simultaneousInputFactorMap E.toCollection X P Q1 Q2
  let v := constantInputCoefficientMap E a P (DisjointNullary.inputSum Q1 Q2)
  let p := frozenPartialSubstitution E P (DisjointNullary.inputSum Q1 Q2)
      (constantBranches (DisjointNullary.inputSum Q1 Q2)) ≫
    E.toCollection.map (constantInputsDeletionHom P (DisjointNullary.inputSum Q1 Q2))
  have hm : T.map f ≫ T.map g = T.map u ≫ T.map v :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (attachingCoefficientBlocks_simultaneous E a P Q1 Q2)).trans
        (T.map_comp _ _))
  have he := AttachmentSource026_postRoute (T.map f) (T.map g) p (T.map u) (T.map v) hm
  simpa only [DisjointNullary.simultaneousRoute, DisjointNullary.deletionHom_eq_initial,
    simultaneousInputContraction, deletedCoefficientContraction, initialCoefficientContraction,
    DisjointNullary.branches_eq_initial, T, f, g, u, v, p, Category.assoc] using! he

/-- The unchanged original attaching-value contractions associate on the
complete original root/Q2/Q1 tensor source, including every empty block. -/
theorem sequentialInputContraction_eq_simultaneous (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sequentialInputContraction E a P Q1 Q2 = simultaneousInputContraction E a P Q1 Q2 :=
  (attachingCoefficientBlocks_sequentialRoute E a P Q1 Q2).symm.trans
    ((congrArg ((FiniteTensor.tensor (V := C)).map
      ((FiniteFamily.flatten (C := C)).map (attachingCoefficientBlocks E a P Q1 Q2)) ≫ ·)
        (DisjointNullary.sequential_eq_simultaneous E P Q1 Q2)).trans
      (attachingCoefficientBlocks_simultaneousRoute E a P Q1 Q2))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource026


section AttachmentSource027


/-!
## Original attaching-value contraction naturality with all source maps retained
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationNaturalFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationNaturalTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationNaturalProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The genuine original contraction is literally the checked constants
representative at the identity E map and the actual attaching values. -/
theorem deletedCoefficientContraction_representative (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    deletedCoefficientContraction E a P Q =
      Linear.Constants.representative (𝟙 E) X (attachingNullaryValue E a) P Q := by
  let T := FiniteTensor.tensor (V := C)
  let b := attachingNullaryValue E a
  let c := constantInputCoefficientMap E a P Q
  let c' := Linear.Constants.coefficientMap (𝟙 E) X b P Q
  let s := frozenPartialSubstitution E P Q (constantBranches Q)
  let t := E.toCollection.map (constantInputsDeletionHom P Q)
  let t' := E.toCollection.map (Linear.Constants.totalProfileHom P Q)
  have hc : c' = c := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i <;> exact HEq.rfl
  have ht : t' = t := congrArg E.toCollection.map (DisjointNullary.deletionHom_eq_initial P Q)
  change (T.map c ≫ s) ≫ t = T.map c' ≫ s ≫ t'
  exact (Category.assoc (T.map c) s t).trans
    ((congrArg (· ≫ s ≫ t) (congrArg T.map hc.symm)).trans
      (congrArg (T.map c' ≫ s ≫ ·) ht.symm))

/-- Every original contracted-input bijection preserves the literal original
contraction, with its original root coefficient and colorwise input maps. -/
theorem deletedCoefficientContraction_inputs (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (E.toCollection.map (extendProfileMap (𝟙 P) g)) ((addedAlgebraInputs X).map g)) ≫
      deletedCoefficientContraction E a P Q' = deletedCoefficientContraction E a P Q := by
  rw [deletedCoefficientContraction_representative, deletedCoefficientContraction_representative]
  exact Linear.Constants.representative_inputs (𝟙 E) X (attachingNullaryValue E a) P g

/-- Every original survivor-profile bijection preserves the literal original
contraction and the original E coefficient action at the target. -/
theorem deletedCoefficientContraction_variables (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) {P P' : ColoredProfile W}
    (f : P ⟶ P') (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (E.toCollection.map (extendProfileMap f (𝟙 Q))) (𝟙 ((addedAlgebraInputs X).obj Q))) ≫
      deletedCoefficientContraction E a P' Q =
        deletedCoefficientContraction E a P Q ≫ E.toCollection.map f := by
  rw [deletedCoefficientContraction_representative, deletedCoefficientContraction_representative]
  exact Linear.Constants.representative_variables (𝟙 E) X (attachingNullaryValue E a) f Q


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource027


section AttachmentSource028


/-!
## Weighted original contraction naturality and the exact marked-face readback
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource028_twoSquares {D : Type*} [Category* D] {A B K L X Y : D}
    (a : A ⟶ B) (n : A ⟶ K) (n' : B ⟶ L) (k : K ⟶ L)
    (d : K ⟶ X) (e : L ⟶ Y) (f : X ⟶ Y)
    (hn : a ≫ n' = n ≫ k) (hd : k ≫ e = d ≫ f) :
    a ≫ (n' ≫ e) = (n ≫ d) ≫ f := by
  exact (Category.assoc a n' e).symm.trans
    ((congrArg (· ≫ e) hn).trans
      ((Category.assoc n k e).trans
        ((congrArg (n ≫ ·) hd).trans (Category.assoc n d f).symm)))

private theorem AttachmentSource028_normalizationSquare {D : Type*} [Category* D] [FiniteTensor D]
    {K K' L L' : FiniteFamily D} {X Y : D} (k : K ⟶ K') (l : L ⟶ L')
    (d : (FiniteTensor.tensor (V := D)).obj K ⟶ X)
    (e : (FiniteTensor.tensor (V := D)).obj K' ⟶ Y) (f : X ⟶ Y)
    (h : (FiniteTensor.tensor (V := D)).map k ≫ e = d ≫ f) :
    (FiniteTensor.tensor (V := D)).map
        ((FiniteFamily.flatten (C := D)).map (coefficientLeavesNestedMap k l)) ≫
      (coefficientLeavesNormalization K' L' ≫ (coefficientLeafTensorFunctor L').map e) =
    (coefficientLeavesNormalization K L ≫ (coefficientLeafTensorFunctor L).map d) ≫
      (FiniteTensor.tensor (V := D)).map (coefficientLeafMap f l) := by
  let T := FiniteTensor.tensor (V := D)
  have hs : coefficientLeafMap (T.map k) l ≫ (coefficientLeafFamilyFunctor L').map e =
      (coefficientLeafFamilyFunctor L).map d ≫ coefficientLeafMap f l :=
    (coefficientLeafMap_post (T.map k) e l).trans
      ((congrArg (fun g => coefficientLeafMap g l) h).trans (coefficientLeafMap_pre d f l).symm)
  have ht : T.map (coefficientLeafMap (T.map k) l) ≫ (coefficientLeafTensorFunctor L').map e =
      (coefficientLeafTensorFunctor L).map d ≫ T.map (coefficientLeafMap f l) :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hs).trans (T.map_comp _ _))
  exact AttachmentSource028_twoSquares _ _ _ _ _ _ _ (coefficientLeavesNormalization_naturality k l) ht

private theorem AttachmentSource028_mapFuse {D V : Type*} [Category* D] [Category* V] (U : D ⥤ V)
    {A B K : V} {X Y Z : D} (a : A ⟶ B) (n : B ⟶ U.obj X)
    (f : X ⟶ Y) (g : Y ⟶ Z) (p : U.obj Z ⟶ K) :
    a ≫ n ≫ U.map f ≫ U.map g ≫ p = a ≫ n ≫ U.map (f ≫ g) ≫ p := by
  exact congrArg (a ≫ n ≫ ·)
    ((Category.assoc (U.map f) (U.map g) p).symm.trans
      (congrArg (· ≫ p) (U.map_comp f g).symm))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationWeightedNaturalFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationWeightedNaturalTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationWeightedNaturalProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The exact original weighted contraction followed by the actual empty-input
deletion, still retaining every original survivor leaf. -/
def deletedWeightedContraction (E : ColoredOperadObj W C) {X : W → C} (Xprime : W → C)
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    initialContractionSource E.toCollection X Xprime P Q ⟶
      (coefficientLeafTensorFunctor (profileLeafFamily Xprime P)).obj (E.toCollection.obj P) :=
  coefficientLeavesNormalization (constantInputFamily E.toCollection X P Q) (profileLeafFamily Xprime P) ≫
    (coefficientLeafTensorFunctor (profileLeafFamily Xprime P)).map (deletedCoefficientContraction E a P Q)

/-- The original marked proper-face map is unchanged under the literal
deleted weighted contraction readback. -/
theorem normalizedMarkedFaceContraction_deleted (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    normalizedMarkedFaceContraction E x a d P =
      (FiniteTensor.tensor (V := C)).map (markedContractionFactorsIso E.toCollection x d P).hom ≫
        deletedWeightedContraction E Xprime a (survivingProfile d P) (contractedInputs P) ≫
          (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d P)).hom := by
  let S := survivingProfile d P
  let Q := contractedInputs P
  let U := coefficientLeafTensorFunctor (profileLeafFamily Xprime S)
  let r := (FiniteTensor.tensor (V := C)).map (markedContractionFactorsIso E.toCollection x d P).hom
  let n := coefficientLeavesNormalization (constantInputFamily E.toCollection X S Q) (profileLeafFamily Xprime S)
  let f := initialCoefficientContraction E a S Q
  let g := E.toCollection.map (constantInputsDeletionHom S Q)
  let p := (profileCoefficientLeafTensorIso E.toCollection Xprime S).hom
  change (r ≫ (n ≫ U.map f)) ≫ U.map g ≫ p = r ≫ (n ≫ U.map (f ≫ g)) ≫ p
  exact (Category.assoc r (n ≫ U.map f) (U.map g ≫ p)).trans
    ((congrArg (r ≫ ·) (Category.assoc n (U.map f) (U.map g ≫ p))).trans
      ((AttachmentSource028_mapFuse U r n f g p).trans
        (congrArg (r ≫ ·) (Category.assoc n (U.map (f ≫ g)) p).symm)))

/-- The original survivor-profile action and original leaf bijection commute
with the full original weighted contraction. -/
theorem deletedWeightedContraction_variables (E : ColoredOperadObj W C) {X : W → C}
    (Xprime : W → C) (a : freeAlgebra E X ⟶ initialAlgebra E)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap
          (coefficientLeafMap (E.toCollection.map (extendProfileMap f (𝟙 Q))) (𝟙 ((addedAlgebraInputs X).obj Q)))
          (profileLeafIso Xprime f).hom)) ≫
      deletedWeightedContraction E Xprime a P' Q =
    deletedWeightedContraction E Xprime a P Q ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (E.toCollection.map f) (profileLeafIso Xprime f).hom) :=
  AttachmentSource028_normalizationSquare _ _ _ _ _ (deletedCoefficientContraction_variables E a f Q)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource028


section AttachmentSource029


/-!
## Finite coefficient normalization commutes with the actual coefficient and leaf maps
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.TensorNormalization

open CategoryTheory

private theorem AttachmentSource029_twoSquares {D : Type*} [Category* D] {A B K L X Y : D}
    (a : A ⟶ B) (n : A ⟶ K) (n' : B ⟶ L) (k : K ⟶ L)
    (d : K ⟶ X) (e : L ⟶ Y) (f : X ⟶ Y)
    (hn : a ≫ n' = n ≫ k) (hd : k ≫ e = d ≫ f) :
    a ≫ (n' ≫ e) = (n ≫ d) ≫ f := by
  exact (Category.assoc a n' e).symm.trans
    ((congrArg (· ≫ e) hn).trans
      ((Category.assoc n k e).trans
        ((congrArg (n ≫ ·) hd).trans (Category.assoc n d f).symm)))

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The original coefficient normalization commutes with every original
coefficient square and arbitrary heterogeneous retained-leaf map. -/
theorem coefficientNormalizationSquare {K K' L L' : FiniteFamily C} {X Y : C}
    (k : K ⟶ K') (l : L ⟶ L')
    (d : (FiniteTensor.tensor (V := C)).obj K ⟶ X)
    (e : (FiniteTensor.tensor (V := C)).obj K' ⟶ Y) (f : X ⟶ Y)
    (h : (FiniteTensor.tensor (V := C)).map k ≫ e = d ≫ f) :
    (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap k l)) ≫
      (coefficientLeavesNormalization K' L' ≫ (coefficientLeafTensorFunctor L').map e) =
    (coefficientLeavesNormalization K L ≫ (coefficientLeafTensorFunctor L).map d) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap f l) := by
  let T := FiniteTensor.tensor (V := C)
  have hs : coefficientLeafMap (T.map k) l ≫ (coefficientLeafFamilyFunctor L').map e =
      (coefficientLeafFamilyFunctor L).map d ≫ coefficientLeafMap f l :=
    (coefficientLeafMap_post (T.map k) e l).trans
      ((congrArg (fun g => coefficientLeafMap g l) h).trans (coefficientLeafMap_pre d f l).symm)
  have ht : T.map (coefficientLeafMap (T.map k) l) ≫ (coefficientLeafTensorFunctor L').map e =
      (coefficientLeafTensorFunctor L).map d ≫ T.map (coefficientLeafMap f l) :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hs).trans (T.map_comp _ _))
  exact AttachmentSource029_twoSquares _ _ _ _ _ _ _ (coefficientLeavesNormalization_naturality k l) ht

/-- An arbitrary coefficient evaluation commutes with each actual retained
leaf map, including the original empty leaf family. -/
theorem coefficientNormalizationLeaves {K L L' : FiniteFamily C} {X : C}
    (d : (FiniteTensor.tensor (V := C)).obj K ⟶ X) (l : L ⟶ L') :
    (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (𝟙 K) l)) ≫
      (coefficientLeavesNormalization K L' ≫ (coefficientLeafTensorFunctor L').map d) =
    (coefficientLeavesNormalization K L ≫ (coefficientLeafTensorFunctor L).map d) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 X) l) := by
  have h : (FiniteTensor.tensor (V := C)).map (𝟙 K) ≫ d = d ≫ 𝟙 X :=
    (congrArg (· ≫ d) ((FiniteTensor.tensor (V := C)).map_id K)).trans
      ((Category.id_comp d).trans (Category.comp_id d).symm)
  exact coefficientNormalizationSquare (𝟙 K) l d d (𝟙 X) h


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.TensorNormalization

end
end AttachmentSource029


section AttachmentSource030


/-!
## Original coefficient and two retained-leaf groups: exact finite source frames
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

open CategoryTheory
attribute [local instance] FintypeCat.fintype

private theorem AttachmentSource030_identityFour {D : Type*} [Category* D] (X : D) :
    (𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X = 𝟙 X :=
  (congrArg (· ≫ 𝟙 X ≫ 𝟙 X) (Category.id_comp (𝟙 X))).trans
    ((Category.id_comp (𝟙 X ≫ 𝟙 X)).trans (Category.id_comp (𝟙 X)))

variable {C : Type u} [Category.{v} C]

/-- Concatenate two finite families using the disjoint union of their index types. -/
def leafSum (M L : FiniteFamily C) : FiniteFamily C where
  index := FintypeCat.of (M.index ⊕ L.index)
  obj i := match i with | Sum.inl i => M.obj i | Sum.inr i => L.obj i

/-- The outer family of tensor blocks in the nested coefficient/leaf triple. -/
def outerBlocks (K M L : FiniteFamily C) : FiniteFamily (FiniteFamily C) :=
  (FiniteFamily.flatten (C := FiniteFamily C)).obj
    (coefficientLeavesTriple (coefficientLeavesNested K M) L)

/-- The actual root/M/L block bijection retains each original block. -/
def blocksIso (K M L : FiniteFamily C) :
    outerBlocks K M L ≅ coefficientLeavesNested K (leafSum M L) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | ⟨none, none⟩ => none
        | ⟨none, some i⟩ => some (Sum.inl i)
        | ⟨some i, _⟩ => some (Sum.inr i)
      invFun := fun i => match i with
        | none => ⟨none, none⟩
        | some (Sum.inl i) => ⟨none, some i⟩
        | some (Sum.inr i) => ⟨some i, PUnit.unit⟩
      left_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; rfl
      right_inv := fun i => by
        cases i with
        | none => rfl
        | some i => cases i <;> rfl }
    (fun i => match i with
      | ⟨none, none⟩ => Iso.refl K
      | ⟨none, some i⟩ => Iso.refl ((FiniteFamily.singleton (C := C)).obj (M.obj i))
      | ⟨some i, _⟩ => Iso.refl ((FiniteFamily.singleton (C := C)).obj (L.obj i)))

/-- The complete root/M/L atomic source uses exactly the original two
coefficient-leaf singleton levels, with no retained input discarded. -/
def rawIso (K M L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K M)) L) ≅
      (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K (leafSum M L)) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | ⟨none, ⟨none, i⟩⟩ => ⟨none, i⟩
        | ⟨none, ⟨some i, _⟩⟩ => ⟨some (Sum.inl i), PUnit.unit⟩
        | ⟨some i, _⟩ => ⟨some (Sum.inr i), PUnit.unit⟩
      invFun := fun i => match i with
        | ⟨none, i⟩ => ⟨none, ⟨none, i⟩⟩
        | ⟨some (Sum.inl i), _⟩ => ⟨none, ⟨some i, PUnit.unit⟩⟩
        | ⟨some (Sum.inr i), _⟩ => ⟨some i, PUnit.unit⟩
      left_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none =>
            rcases j with ⟨j, k⟩
            cases j with
            | none => rfl
            | some i => cases k; rfl
        | some i => cases j; rfl
      right_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none => rfl
        | some i => cases j; cases i <;> rfl }
    (fun i => match i with
      | ⟨none, ⟨none, i⟩⟩ => Iso.refl (K.obj i)
      | ⟨none, ⟨some i, _⟩⟩ => Iso.refl (M.obj i)
      | ⟨some i, _⟩ => Iso.refl (L.obj i))

/-- Regroup the actual evaluated root and M/L leaves into the original
coefficient/M family followed by the original L family. -/
def outputIso (X : C) (M L : FiniteFamily C) :
    (coefficientLeafFamilyFunctor (leafSum M L)).obj X ≅
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested ((coefficientLeafFamilyFunctor M).obj X) L) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | none => ⟨none, none⟩
        | some (Sum.inl i) => ⟨none, some i⟩
        | some (Sum.inr i) => ⟨some i, PUnit.unit⟩
      invFun := fun i => match i with
        | ⟨none, none⟩ => none
        | ⟨none, some i⟩ => some (Sum.inl i)
        | ⟨some i, _⟩ => some (Sum.inr i)
      left_inv := fun i => by
        cases i with
        | none => rfl
        | some i => cases i <;> rfl
      right_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; rfl }
    (fun i => match i with
      | none => Iso.refl X
      | some (Sum.inl i) => Iso.refl (M.obj i)
      | some (Sum.inr i) => Iso.refl (L.obj i))

/-- The exact original triple flatten and block maps give the same complete
atomic source map as the direct root/M/L input bijection. -/
theorem rawTriangle (K M L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L).inv ≫
      FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple (coefficientLeavesNested K M) L) ≫
      (FiniteFamily.flatten (C := C)).map (blocksIso K M L).hom = (rawIso K M L).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    rintro ⟨i, j⟩
    cases i with
    | none =>
        rcases j with ⟨j, k⟩
        cases j with
        | none => rfl
        | some j => cases k; rfl
    | some i => cases j; rfl
  · rintro ⟨i, j⟩
    cases i with
    | none =>
        rcases j with ⟨j, k⟩
        cases j with
        | none =>
            let X := K.obj k
            change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
            exact heq_of_eq (AttachmentSource030_identityFour X)
        | some j =>
            cases k
            let X := M.obj j
            change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
            exact heq_of_eq (AttachmentSource030_identityFour X)
    | some i =>
        cases j
        let X := L.obj i
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (AttachmentSource030_identityFour X)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

end
end AttachmentSource030


section AttachmentSource031


/-!
## Exact original block maps for successive coefficient and retained-input evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

open CategoryTheory

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- Evaluate the actual original root block and only collapse the actual
singleton tensor of each retained M input. -/
def firstEvaluation (K M : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (coefficientLeavesNested K M) ⟶
      (coefficientLeafFamilyFunctor M).obj X where
  equiv := Equiv.refl (Option M.index)
  hom i := match i with
    | none => f
    | some i => (FiniteTensor.singletonIso (V := C)).hom.app (M.obj i)

/-- Evaluate the coefficient tensor by `f` while retaining both leaf families. -/
def tripleToOutputMap (K M L : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (outerBlocks K M L) ⟶
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested ((coefficientLeafFamilyFunctor M).obj X) L) :=
  (FiniteFamily.flatten (C := C)).map (coefficientLeavesTripleTensorMap (coefficientLeavesNested K M) L) ≫
    (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (firstEvaluation K M X f) (𝟙 L))

/-- The actual block evaluation keeps the original root and both retained
leaf groups, with the same original singleton tensor collapses in either route. -/
theorem tripleToOutputMap_factor (K M L : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    tripleToOutputMap K M L X f =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (blocksIso K M L).hom ≫
        coefficientLeavesCollapse K (leafSum M L) ≫
        (coefficientLeafFamilyFunctor (leafSum M L)).map f ≫ (outputIso X M L).hom := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    rintro ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl
  · rintro ⟨i, j⟩
    cases i with
    | none =>
        cases j with
        | none =>
            change HEq (𝟙 (T.obj K) ≫ f) (T.map (𝟙 K) ≫ 𝟙 (T.obj K) ≫ f ≫ 𝟙 X)
            apply heq_of_eq
            simp only [T.map_id, Category.id_comp, Category.comp_id]
        | some j =>
            let S := (FiniteFamily.singleton (C := C)).obj (M.obj j)
            let s := (FiniteTensor.singletonIso (V := C)).hom.app (M.obj j)
            change HEq (𝟙 (T.obj S) ≫ s) (T.map (𝟙 S) ≫ s ≫ 𝟙 (M.obj j) ≫ 𝟙 (M.obj j))
            apply heq_of_eq
            simp only [T.map_id, Category.id_comp, Category.comp_id]
            exact (Category.comp_id s).symm
    | some i =>
        cases j
        let S := (FiniteFamily.singleton (C := C)).obj (L.obj i)
        let s := (FiniteTensor.singletonIso (V := C)).hom.app (L.obj i)
        change HEq (s ≫ 𝟙 (L.obj i)) (T.map (𝟙 S) ≫ s ≫ 𝟙 (L.obj i) ≫ 𝟙 (L.obj i))
        apply heq_of_eq
        simp only [T.map_id, Category.id_comp, Category.comp_id]


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

end
end AttachmentSource031


section AttachmentSource032


set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

open CategoryTheory

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

theorem firstEvaluation_factor (K M : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    coefficientLeavesCollapse K M ≫ (coefficientLeafFamilyFunctor M).map f = firstEvaluation K M X f := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp f)
    | some i => exact heq_of_eq (Category.comp_id ((FiniteTensor.singletonIso (V := C)).hom.app (M.obj i)))

/-- The original normalized root evaluation is exactly the tensor of the
original block evaluation, including every original singleton input unitor. -/
theorem firstEvaluation_normalized (K M : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor M).map f =
      (FiniteTensor.flattenIso (V := C)).hom.app (coefficientLeavesNested K M) ≫
        (FiniteTensor.tensor (V := C)).map (firstEvaluation K M X f) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (coefficientLeavesNested K M)
  let c := coefficientLeavesCollapse K M
  let g := (coefficientLeafFamilyFunctor M).map f
  let h := firstEvaluation K M X f
  change (a ≫ T.map c) ≫ T.map g = a ≫ T.map h
  exact (Category.assoc a (T.map c) (T.map g)).trans
    ((congrArg (a ≫ ·) (T.map_comp c g).symm).trans
      (congrArg (a ≫ ·) (congrArg T.map (firstEvaluation_factor K M X f))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

end
end AttachmentSource032


section AttachmentSource033


/-!
## Actual nested coefficient normalization followed by an arbitrary coefficient block map
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.TensorNormalization

open CategoryTheory

private theorem AttachmentSource033_nestedRoute {D : Type*} [Category* D]
    {A B C E F G H J K : D}
    (p : A ⟶ B) (n : B ⟶ C) (f : C ⟶ E) (h : E ⟶ K)
    (r : A ⟶ F) (s : F ⟶ G) (t : G ⟶ H) (n' : H ⟶ E)
    (e : H ⟶ J) (u : J ⟶ K)
    (ha : p ≫ n ≫ f = r ≫ s ≫ t ≫ n') (hn : e ≫ u = n' ≫ h) :
    p ≫ n ≫ (f ≫ h) = r ≫ s ≫ (t ≫ e) ≫ u := by
  calc
    p ≫ n ≫ (f ≫ h) = (p ≫ n ≫ f) ≫ h := by simp only [Category.assoc]
    _ = (r ≫ s ≫ t ≫ n') ≫ h := congrArg (· ≫ h) ha
    _ = r ≫ s ≫ t ≫ (n' ≫ h) := by simp only [Category.assoc]
    _ = r ≫ s ≫ t ≫ (e ≫ u) := congrArg (r ≫ s ≫ t ≫ ·) hn.symm
    _ = r ≫ s ≫ (t ≫ e) ≫ u := by simp only [Category.assoc]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- Evaluate the inner tensor blocks by `h` and retain the outer leaves `L`. -/
def outerEvaluationMap (N : FiniteFamily (FiniteFamily C)) (L : FiniteFamily C)
    {K' : FiniteFamily C} (h : (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N ⟶ K') :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        ((FiniteFamily.flatten (C := FiniteFamily C)).obj (coefficientLeavesTriple N L)) ⟶
      (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K' L) :=
  (FiniteFamily.flatten (C := C)).map (coefficientLeavesTripleTensorMap N L) ≫
    (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap h (𝟙 L))

/-- Evaluate the original coefficient blocks before or after normalization,
retaining both original coefficient levels and every original leaf. -/
theorem nestedCoefficientNormalization_map (N : FiniteFamily (FiniteFamily C)) (L : FiniteFamily C)
    {K' : FiniteFamily C} (h : (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N ⟶ K') :
    (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (coefficientLeavesTripleFlattenIso N L).hom) ≫
      coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj N) L ≫
      (coefficientLeafTensorFunctor L).map
        ((FiniteTensor.flattenIso (V := C)).hom.app N ≫ (FiniteTensor.tensor (V := C)).map h) =
    (FiniteTensor.tensor (V := C)).map (FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple N L)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app
        ((FiniteFamily.flatten (C := FiniteFamily C)).obj (coefficientLeavesTriple N L)) ≫
      (FiniteTensor.tensor (V := C)).map (outerEvaluationMap N L h) ≫ coefficientLeavesNormalization K' L := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let U := coefficientLeafTensorFunctor L
  let p := T.map (F.map (coefficientLeavesTripleFlattenIso N L).hom)
  let n := coefficientLeavesNormalization (F.obj N) L
  let f := U.map ((FiniteTensor.flattenIso (V := C)).hom.app N)
  let h' := U.map (T.map h)
  let r := T.map (FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple N L))
  let s := (FiniteTensor.flattenIso (V := C)).hom.app
    ((FiniteFamily.flatten (C := FiniteFamily C)).obj (coefficientLeavesTriple N L))
  let t := T.map (F.map (coefficientLeavesTripleTensorMap N L))
  let n' := coefficientLeavesNormalization ((FiniteFamily.map T).obj N) L
  let e := T.map (F.map (coefficientLeavesNestedMap h (𝟙 L)))
  let u := coefficientLeavesNormalization K' L
  have ha : p ≫ n ≫ f = r ≫ s ≫ t ≫ n' := coefficientLeavesNormalization_assoc N L
  have hid : T.map (coefficientLeafMap (T.map h) (𝟙 L)) = h' :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map h) L)
  have hn : e ≫ u = n' ≫ h' :=
    (coefficientLeavesNormalization_naturality h (𝟙 L)).trans (congrArg (n' ≫ ·) hid)
  have hl : U.map ((FiniteTensor.flattenIso (V := C)).hom.app N ≫ T.map h) = f ≫ h' := U.map_comp _ _
  have hr : T.map (outerEvaluationMap N L h) = t ≫ e := T.map_comp _ _
  exact (congrArg (p ≫ n ≫ ·) hl).trans
    ((AttachmentSource033_nestedRoute p n f h' r s t n' e u ha hn).trans
      (congrArg (fun k => r ≫ s ≫ k ≫ u) hr.symm))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.TensorNormalization

end
end AttachmentSource033


section AttachmentSource034


/-!
## Full tensor fusion of the original coefficient evaluation and two retained-leaf groups
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

open CategoryTheory

private theorem AttachmentSource034_mapFour {D E : Type*} [Category* D] [Category* E] (T : D ⥤ E)
    {A B C F G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ F) (d : F ⟶ G) :
    T.map (a ≫ b ≫ c ≫ d) = T.map a ≫ T.map b ≫ T.map c ≫ T.map d := by
  simp only [Functor.map_comp]

private theorem AttachmentSource034_prefactorRoute {D : Type*} [Category* D]
    {A B C E F G H J K M : D}
    (p : A ⟶ B) (raw : B ⟶ C) (r : A ⟶ E) (b : E ⟶ C)
    (a : C ⟶ F) (z : F ⟶ G) (u : G ⟶ H) (v : H ⟶ J) (n : J ⟶ M)
    (d : E ⟶ K) (e : K ⟶ F) (t : K ⟶ J)
    (hp : p ≫ raw = r ≫ b) (hn : b ≫ a = d ≫ e) (ht : e ≫ z ≫ u ≫ v = t) :
    p ≫ raw ≫ (a ≫ z) ≫ u ≫ v ≫ n = r ≫ d ≫ t ≫ n := by
  calc
    p ≫ raw ≫ (a ≫ z) ≫ u ≫ v ≫ n = (p ≫ raw) ≫ a ≫ z ≫ u ≫ v ≫ n := by simp only [Category.assoc]
    _ = (r ≫ b) ≫ a ≫ z ≫ u ≫ v ≫ n := congrArg (· ≫ a ≫ z ≫ u ≫ v ≫ n) hp
    _ = r ≫ (b ≫ a) ≫ z ≫ u ≫ v ≫ n := by simp only [Category.assoc]
    _ = r ≫ (d ≫ e) ≫ z ≫ u ≫ v ≫ n := congrArg (fun f => r ≫ f ≫ z ≫ u ≫ v ≫ n) hn
    _ = r ≫ d ≫ (e ≫ z ≫ u ≫ v) ≫ n := by simp only [Category.assoc]
    _ = r ≫ d ≫ t ≫ n := congrArg (fun f => r ≫ d ≫ f ≫ n) ht

variable {C : Type u} [Category.{v} C]

theorem rawPrefactor (K M L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L).hom ≫ (rawIso K M L).hom =
      FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple (coefficientLeavesNested K M) L) ≫
        (FiniteFamily.flatten (C := C)).map (blocksIso K M L).hom := by
  let e := (FiniteFamily.flatten (C := C)).mapIso
    (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L)
  let r := FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple (coefficientLeavesNested K M) L)
  let b := (FiniteFamily.flatten (C := C)).map (blocksIso K M L).hom
  have h : e.inv ≫ r ≫ b = (rawIso K M L).hom := rawTriangle K M L
  exact (congrArg (e.hom ≫ ·) h.symm).trans (Iso.hom_inv_id_assoc e (r ≫ b))

variable [FiniteTensor C]

theorem normalizedFactorized (K M L : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map
        (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L).hom) ≫
      coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K M)) L ≫
      (coefficientLeafTensorFunctor L).map
        (coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor M).map f) =
    (FiniteTensor.tensor (V := C)).map
        (FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple (coefficientLeavesNested K M) L)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (outerBlocks K M L) ≫
      (FiniteTensor.tensor (V := C)).map (tripleToOutputMap K M L X f) ≫
        coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L := by
  let T := FiniteTensor.tensor (V := C)
  let N := coefficientLeavesNested K M
  let p := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesTripleFlattenIso N L).hom)
  let n := coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj N) L
  let U := coefficientLeafTensorFunctor L
  have h := congrArg U.map (firstEvaluation_normalized K M X f)
  exact (congrArg (p ≫ n ≫ ·) h).trans
    (TensorNormalization.nestedCoefficientNormalization_map N L (firstEvaluation K M X f))

theorem prefactoredRight (K M L : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map
        (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L).hom) ≫
      (FiniteTensor.tensor (V := C)).map (rawIso K M L).hom ≫
      coefficientLeavesNormalization K (leafSum M L) ≫
      (coefficientLeafTensorFunctor (leafSum M L)).map f ≫
      (FiniteTensor.tensor (V := C)).map (outputIso X M L).hom ≫
        coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L =
    (FiniteTensor.tensor (V := C)).map
        (FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple (coefficientLeavesNested K M) L)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (outerBlocks K M L) ≫
      (FiniteTensor.tensor (V := C)).map (tripleToOutputMap K M L X f) ≫
        coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let p := T.map (F.map (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L).hom)
  let raw := T.map (rawIso K M L).hom
  let r := T.map (FiniteFamily.flattenAssocIso.hom.app (coefficientLeavesTriple (coefficientLeavesNested K M) L))
  let b := T.map (F.map (blocksIso K M L).hom)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (coefficientLeavesNested K (leafSum M L))
  let z := T.map (coefficientLeavesCollapse K (leafSum M L))
  let u := (coefficientLeafTensorFunctor (leafSum M L)).map f
  let v := T.map (outputIso X M L).hom
  let n := coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L
  let d := (FiniteTensor.flattenIso (V := C)).hom.app (outerBlocks K M L)
  let e := T.map ((FiniteFamily.map T).map (blocksIso K M L).hom)
  let t := T.map (tripleToOutputMap K M L X f)
  have hp : p ≫ raw = r ≫ b := (T.map_comp _ _).symm.trans
    ((congrArg T.map (rawPrefactor K M L)).trans (T.map_comp _ _))
  have hn : b ≫ a = d ≫ e := (FiniteTensor.flattenIso (V := C)).hom.naturality (blocksIso K M L).hom
  have ht : e ≫ z ≫ u ≫ v = t :=
    (AttachmentSource034_mapFour T _ _ _ _).symm.trans (congrArg T.map (tripleToOutputMap_factor K M L X f).symm)
  change p ≫ raw ≫ (a ≫ z) ≫ u ≫ v ≫ n = r ≫ d ≫ t ≫ n
  exact AttachmentSource034_prefactorRoute p raw r b a z u v n d e t hp hn ht

/-- The actual original normalization of two coefficient/leaf levels equals
normalizing all retained M/L inputs together, evaluating the original root,
and retaining the exact original output reindexing map. Only FiniteTensor laws are used. -/
theorem tensorFusion (K M L : FiniteFamily C) (X : C)
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ X) :
    coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K M)) L ≫
      (coefficientLeafTensorFunctor L).map
        (coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor M).map f) =
    (FiniteTensor.tensor (V := C)).map (rawIso K M L).hom ≫
      coefficientLeavesNormalization K (leafSum M L) ≫
      (coefficientLeafTensorFunctor (leafSum M L)).map f ≫
      (FiniteTensor.tensor (V := C)).map (outputIso X M L).hom ≫
        coefficientLeavesNormalization ((coefficientLeafFamilyFunctor M).obj X) L := by
  let e := (FiniteTensor.tensor (V := C)).mapIso
    ((FiniteFamily.flatten (C := C)).mapIso (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K M) L))
  let p := e.hom
  let : IsIso p := inferInstanceAs (IsIso e.hom)
  apply (cancel_epi p).1
  exact (normalizedFactorized K M L X f).trans (prefactoredRight K M L X f).symm


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation.LeafFusion

end
end AttachmentSource034


section AttachmentSource035


/-!
## Original marked profile isomorphisms and their actual survivor/complement maps
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

theorem markedIso_inv_apply {P P' : MarkedInputs W} (g : P ≅ P') (i : P.index) :
    g.inv.equiv (g.hom.equiv i) = i :=
  congrArg (fun f : P ⟶ P => f.equiv i) g.hom_inv_id

theorem markedIso_apply_inv {P P' : MarkedInputs W} (g : P ≅ P') (i : P'.index) :
    g.hom.equiv (g.inv.equiv i) = i := markedIso_inv_apply g.symm i

/-- An original marked profile isomorphism retains every original X/X′ coordinate. -/
theorem markedIso_coordinate {P P' : MarkedInputs W} (g : P ≅ P') (i : P.index) :
    (P.obj i).1 = (P'.obj (g.hom.equiv i)).1 := by
  have h := leOfHom (g.inv.hom (g.hom.equiv i)).1
  rw [markedIso_inv_apply g i] at h
  exact Finset.Subset.antisymm (leOfHom (g.hom.hom i).1) h

theorem markedIso_selected {P P' : MarkedInputs W} (g : P ≅ P') (i : P.index) :
    SelectedInput P i ↔ SelectedInput P' (g.hom.equiv i) := by
  change (P.obj i).1 = Finset.univ ↔ (P'.obj (g.hom.equiv i)).1 = Finset.univ
  rw [markedIso_coordinate g i]

/-- Restrict the actual original input bijection to its actual survivor positions. -/
def markedSurvivorEquiv {P P' : MarkedInputs W} (g : P ≅ P') :
    (survivingInputs P).index ≃ (survivingInputs P').index where
  toFun i := ⟨g.hom.equiv i.1, (markedIso_selected g i.1).mp i.2⟩
  invFun i := ⟨g.inv.equiv i.1, (markedIso_selected g.symm i.1).mp i.2⟩
  left_inv i := Subtype.ext (markedIso_inv_apply g i.1)
  right_inv i := Subtype.ext (markedIso_apply_inv g i.1)

/-- Restrict the same original input bijection to its actual contracted positions. -/
def markedContractedEquiv {P P' : MarkedInputs W} (g : P ≅ P') :
    (contractedInputs P).index ≃ (contractedInputs P').index where
  toFun i := ⟨g.hom.equiv i.1, (not_congr (markedIso_selected g i.1)).mp i.2⟩
  invFun i := ⟨g.inv.equiv i.1, (not_congr (markedIso_selected g.symm i.1)).mp i.2⟩
  left_inv i := Subtype.ext (markedIso_inv_apply g i.1)
  right_inv i := Subtype.ext (markedIso_apply_inv g i.1)

/-- The original survivor profile map uses the same survivor input bijection
and the actual original color component of the marked morphism. -/
def markedSurvivorProfileHom (d : W) {P P' : MarkedInputs W} (g : P ≅ P') :
    survivingProfile d P ⟶ survivingProfile d P' where
  inputEquiv := markedSurvivorEquiv g
  inputColor_eq i := Discrete.eq_of_hom (g.hom.hom i.1).2
  outputColor_eq := rfl

/-- The original contracted color family map retains its original color morphisms. -/
def markedContractedInputsIso {P P' : MarkedInputs W} (g : P ≅ P') :
    contractedInputs P ≅ contractedInputs P' :=
  FiniteFamily.isoOfComponents (markedContractedEquiv g)
    (fun i => eqToIso (congrArg Discrete.mk (Discrete.eq_of_hom (g.hom.hom i.1).2)))

/-- Original survivor/complement permutations and the actual full coefficient
profile map commute through the original sum-complement selection maps. -/
theorem selectionRootHom_iso (d : W) {P P' : MarkedInputs W} (g : P ≅ P') :
    extendProfileMap (markedSurvivorProfileHom d g) (markedContractedInputsIso g).hom ≫
        selectionRootHom d P' =
      selectionRootHom d P ≫ (markedProfileFunctor d).map g.hom := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i <;> rfl

/-- The actual original survivor degree is invariant under the original marked isomorphism. -/
theorem markedSurvivorDegree_eq (d : W) {P P' : MarkedInputs W} (g : P ≅ P') :
    inputCount (survivingProfile d P) = inputCount (survivingProfile d P') :=
  Fintype.card_congr (markedSurvivorEquiv g)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource035


section AttachmentSource036


/-!
## Exact original marked contraction index and leaf-component readbacks
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource036_transportedIsoHom {D : Type*} [Category* D] {A B B' : D}
    (e : B = B') (i : A ≅ B) :
    HEq ((Eq.mp (congrArg (fun k => A ≅ k) e) i).hom) i.hom := by
  cases e
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem markedTopCarrierEq {X Xprime : W → C} (x : X ⟶ Xprime)
    (P : MarkedInputs W) (i : P.index) (hi : SelectedInput P i) :
    (markedInputCarrier x).obj (P.obj i) = Xprime (P.obj i).2.as := by
  change (markedInputCarrier x).obj ((P.obj i).1, Discrete.mk (P.obj i).2.as) = _
  rw [hi]
  exact markedCarrier_top x _

theorem markedContraction_position_root (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    (markedContractionFactorsIso O x d P).hom.equiv none = ⟨none, none⟩ := rfl

theorem markedContraction_position_top (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W)
    (i : P.index) (hi : SelectedInput P i) :
    (markedContractionFactorsIso O x d P).hom.equiv (some i) =
      ⟨some ⟨i, hi⟩, PUnit.unit⟩ := by
  have hpos : contractionInputEquiv P (some i) = ⟨some ⟨i, hi⟩, PUnit.unit⟩ := by
    change (if h : SelectedInput P i then _ else _) = _
    exact dite_eq_left hi
  let k : (Σ j : Option (survivingInputs P).index,
      match j with | none => Option (contractedInputs P).index | some _ => PUnit) ≃
      (markedContractionFactors O X Xprime d P).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  change k (contractionInputEquiv P (some i)) = _
  exact (congrArg k hpos).trans rfl

theorem markedContraction_position_old (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W)
    (i : P.index) (hi : ¬ SelectedInput P i) :
    (markedContractionFactorsIso O x d P).hom.equiv (some i) =
      ⟨none, some ⟨i, hi⟩⟩ := by
  have hpos : contractionInputEquiv P (some i) = ⟨none, some ⟨i, hi⟩⟩ := by
    change (if h : SelectedInput P i then _ else _) = _
    exact dite_eq_right hi
  let k : (Σ j : Option (survivingInputs P).index,
      match j with | none => Option (contractedInputs P).index | some _ => PUnit) ≃
      (markedContractionFactors O X Xprime d P).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  change k (contractionInputEquiv P (some i)) = _
  exact (congrArg k hpos).trans rfl

theorem markedContraction_component_root (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    (markedContractionFactorsIso O x d P).hom.hom none =
      O.map (asIso (selectionRootHom d P)).inv := rfl

theorem markedContraction_component_top (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W)
    (i : P.index) (hi : SelectedInput P i) :
    HEq ((markedContractionFactorsIso O x d P).hom.hom (some i))
      (eqToHom (markedTopCarrierEq x P i hi)) := by
  have hpos : contractionInputEquiv P (some i) = ⟨some ⟨i, hi⟩, PUnit.unit⟩ := by
    change (if h : SelectedInput P i then _ else _) = _
    exact dite_eq_left hi
  let k : (Σ j : Option (survivingInputs P).index,
      match j with | none => Option (contractedInputs P).index | some _ => PUnit) ≃
      (markedContractionFactors O X Xprime d P).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  let Y := markedContractionFactors O X Xprime d P
  have ht : Xprime (P.obj i).2.as = Y.obj (k (contractionInputEquiv P (some i))) :=
    (congrArg (fun j => Y.obj (k j)) hpos).symm
  have h := AttachmentSource036_transportedIsoHom ht (eqToIso (markedTopCarrierEq x P i hi))
  simpa only [markedContractionFactorsIso, FiniteFamily.isoOfComponents, dite_eq_left hi,
    k, Y] using! h

theorem markedContraction_component_old (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W)
    (i : P.index) (hi : ¬ SelectedInput P i) :
    HEq ((markedContractionFactorsIso O x d P).hom.hom (some i))
      (eqToHom (markedCarrier_old x (P.obj i).1 hi (P.obj i).2.as)) := by
  have hpos : contractionInputEquiv P (some i) = ⟨none, some ⟨i, hi⟩⟩ := by
    change (if h : SelectedInput P i then _ else _) = _
    exact dite_eq_right hi
  let k : (Σ j : Option (survivingInputs P).index,
      match j with | none => Option (contractedInputs P).index | some _ => PUnit) ≃
      (markedContractionFactors O X Xprime d P).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  let Y := markedContractionFactors O X Xprime d P
  have ht : X (P.obj i).2.as = Y.obj (k (contractionInputEquiv P (some i))) :=
    (congrArg (fun j => Y.obj (k j)) hpos).symm
  have h := AttachmentSource036_transportedIsoHom ht (eqToIso (markedCarrier_old x (P.obj i).1 hi (P.obj i).2.as))
  simpa only [markedContractionFactorsIso, FiniteFamily.isoOfComponents, dite_eq_right hi,
    k, Y] using! h


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource036


section AttachmentSource037


/-!
## Exact original residual old and surviving inputs for iterated contractions
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc}

/-- The actual original residual inputs are classified into old and surviving
positions, retaining their original subtype indices. -/
def iterationLeafEquiv (R : MarkedInputs W) :
    R.index ≃ (contractedInputs R).index ⊕ (survivingInputs R).index where
  toFun i := if hi : SelectedInput R i then Sum.inr ⟨i, hi⟩ else Sum.inl ⟨i, hi⟩
  invFun i := match i with | Sum.inl i => i.1 | Sum.inr i => i.1
  left_inv i := by
    by_cases hi : SelectedInput R i
    · simp only [dite_eq_left hi]
    · simp only [dite_eq_right hi]
  right_inv i := by
    cases i with
    | inl i =>
        rcases i with ⟨i, hi⟩
        simp only [dite_eq_right hi]
    | inr i =>
        rcases i with ⟨i, hi⟩
        simp only [dite_eq_left hi]

variable {C : Type u} [Category.{v} C]

/-- The `X`-carrier leaves belonging to the inputs contracted by `R`. -/
def iterationOldLeaves (X : W → C) (R : MarkedInputs W) : FiniteFamily C :=
  (addedAlgebraInputs X).obj (contractedInputs R)

/-- The `Xprime`-carrier leaves belonging to the profile that survives `R`. -/
def iterationSurvivorLeaves (Xprime : W → C) (d : W) (R : MarkedInputs W) : FiniteFamily C :=
  profileLeafFamily Xprime (survivingProfile d R)

/-- The original marked residual leaf family is exactly the original old-X
and surviving-X′ families, through their actual original input partition. -/
def iterationLeafIso {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) (R : MarkedInputs W) :
    (FiniteFamily.map (markedInputCarrier x)).obj R ≅
      LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R) := by
  refine FiniteFamily.isoOfComponents
    (X := (FiniteFamily.map (markedInputCarrier x)).obj R)
    (Y := LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R))
    (iterationLeafEquiv R) (fun i => ?_)
  by_cases hi : SelectedInput R i
  · have hp : iterationLeafEquiv R i = Sum.inr ⟨i, hi⟩ := by
      change (if h : SelectedInput R i then _ else _) = _
      exact dite_eq_left hi
    change (markedInputCarrier x).obj (R.obj i) ≅
      (LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)).obj
        (iterationLeafEquiv R i)
    rw [hp]
    exact eqToIso (markedTopCarrierEq x R i hi)
  · have hp : iterationLeafEquiv R i = Sum.inl ⟨i, hi⟩ := by
      change (if h : SelectedInput R i then _ else _) = _
      exact dite_eq_right hi
    change (markedInputCarrier x).obj (R.obj i) ≅
      (LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)).obj
        (iterationLeafEquiv R i)
    rw [hp]
    exact eqToIso (markedCarrier_old x (R.obj i).1 hi (R.obj i).2.as)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource037


section AttachmentSource038


/-!
## Actual input permutations, promotions and residual marked survivor profiles
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- An original coordinate morphism preserves every already surviving X′ input. -/
theorem markedHom_selected {P Q : MarkedInputs W} (g : P ⟶ Q) (i : P.index)
    (hi : SelectedInput P i) : SelectedInput Q (g.equiv i) := by
  have h := leOfHom (g.hom i).1
  rw [hi] at h
  exact Finset.Subset.antisymm (Finset.subset_univ _) h

/-- An original input still at X after the face map was already at X before it. -/
theorem markedHom_old {P Q : MarkedInputs W} (g : P ⟶ Q) (i : Q.index)
    (hi : ¬ SelectedInput Q i) : ¬ SelectedInput P (g.equiv.symm i) := by
  intro h
  have h' := markedHom_selected g (g.equiv.symm i) h
  rw [g.equiv.apply_symm_apply] at h'
  exact hi h'

/-- Transport the original source marks through the original input bijection,
retaining the original target colors. -/
def transportedMarkedInputs {P Q : MarkedInputs W} (g : P ⟶ Q) : MarkedInputs W where
  index := Q.index
  obj i := ((P.obj (g.equiv.symm i)).1, (Q.obj i).2)

/-- The actual original input permutation precedes its coordinate promotion. -/
def markedFacePermutationIso {P Q : MarkedInputs W} (g : P ⟶ Q) :
    P ≅ transportedMarkedInputs g :=
  FiniteFamily.isoOfComponents g.equiv (fun i => eqToIso (Prod.ext
    (congrArg (fun j => (P.obj j).1) (g.equiv.symm_apply_apply i)).symm
    (congrArg Discrete.mk (Discrete.eq_of_hom (g.hom i).2))))

/-- The remaining map uses the actual original coordinate promotions and
retains the transported original colors and positions. -/
def markedFacePromotion {P Q : MarkedInputs W} (g : P ⟶ Q) :
    transportedMarkedInputs g ⟶ Q where
  equiv := Equiv.refl Q.index
  hom i :=
    (homOfLE (by
      have h := leOfHom (g.hom (g.equiv.symm i)).1
      exact (congrArg (fun j => (P.obj (g.equiv.symm i)).1 ⊆ (Q.obj j).1)
        (g.equiv.apply_symm_apply i)).mp h), 𝟙 (Q.obj i).2)

/-- Both original parts compose to the literal original marked face map. -/
theorem markedFace_factor {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedFacePermutationIso g).hom ≫ markedFacePromotion g = g := by
  apply markedHom_ext
  apply Equiv.ext
  intro i
  rfl

/-- The actual target survivors keep their original source X/X′ marks.
This is the genuine smaller residual face used between two contractions. -/
def residualMarkedInputs {P Q : MarkedInputs W} (g : P ⟶ Q) : MarkedInputs W where
  index := (survivingInputs Q).index
  obj i := ((P.obj (g.equiv.symm i.1)).1, (Q.obj i.1).2)

/-- Source survivors correspond to exactly the still-surviving positions
in the genuine residual marked profile. -/
def residualSurvivorEquiv {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (survivingInputs P).index ≃ (survivingInputs (residualMarkedInputs g)).index where
  toFun i :=
    ⟨⟨g.equiv i.1, markedHom_selected g i.1 i.2⟩, by
      change SelectedInput P (g.equiv.symm (g.equiv i.1))
      simpa only [g.equiv.symm_apply_apply] using i.2⟩
  invFun i := ⟨g.equiv.symm i.1.1, i.2⟩
  left_inv i := Subtype.ext (g.equiv.symm_apply_apply i.1)
  right_inv i := by
    apply Subtype.ext
    apply Subtype.ext
    exact g.equiv.apply_symm_apply i.1.1

/-- The original source survivor profile maps to the same survivors in the
residual profile by its actual original input and color bijection. -/
def residualSurvivorProfileHom (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    survivingProfile d P ⟶ survivingProfile d (residualMarkedInputs g) where
  inputEquiv := residualSurvivorEquiv g
  inputColor_eq i := Discrete.eq_of_hom (g.hom i.1).2
  outputColor_eq := rfl

/-- The residual profile has precisely the actual target survivor degree. -/
theorem residualDegree (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    inputCount ((markedProfileFunctor d).obj (residualMarkedInputs g)) = survivingDegree Q := rfl

/-- The actual residual coefficient profile is the original target survivor profile. -/
theorem residualProfile (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedProfileFunctor d).obj (residualMarkedInputs g) = survivingProfile d Q := rfl


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
