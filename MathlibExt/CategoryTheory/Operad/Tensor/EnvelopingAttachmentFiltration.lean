/-!
## Literal original operad degree arrow and its genuine profile-cell cofans
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance operadCofanFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance operadCofanSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance operadCofanAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance operadCofanDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance operadCofanPuncturedColimits (n : ℕ) :
    HasColimitsOfShape (PuncturedMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The original all-coordinate map compares the original boundary
colimit with the literal original degreeBalancedArrow, on every original face. -/
theorem rawToOperadDegree_square (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    rawBoundaryToDegree (markedTensorDiagram E x d) n ≫
        (rawDegreeTopIso (markedTensorDiagram E x d) n).hom = (degreeBalancedArrow E x d n).hom := by
  let D := markedTensorDiagram E x d
  let B := rawPuncturedDegreeDiagram D n
  apply colimit.hom_ext (F := B)
  intro q
  exact (Category.assoc (colimit.ι B q) (rawBoundaryToDegree D n) (rawDegreeTopIso D n).hom).symm.trans
    ((congrArg (· ≫ (rawDegreeTopIso D n).hom) (rawBoundaryToDegree_face D n q)).trans
      ((rawToTopMap_face D n q.1).trans (degreeBalancedArrow_face E x d n q).symm))

/-- Both original degree source/target objects and the original whole
arrow are compared by the actual original all-coordinate colimit maps. -/
def rawOperadDegreeIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    rawDegreeArrow (markedTensorDiagram E x d) n ≅ degreeBalancedArrow E x d n :=
  Arrow.isoMk (Iso.refl _) (rawDegreeTopIso (markedTensorDiagram E x d) n)
    ((Category.id_comp _).trans (rawToOperadDegree_square E x d n).symm)

/-- The actual original balanced profile arrow enters the actual original
degree arrow by both original constructed coefficient/input quotient legs. -/
def operadProfileCellCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    balancedProfileArrow E x (representativeProfile d s) ⟶ degreeBalancedArrow E x d n :=
  rawDegreeCellCofan (markedTensorDiagram E x d) d n s ≫ (rawOperadDegreeIso E x d n).hom

theorem operadProfileCellCofan_left (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    (operadProfileCellCofan E x d n s).left = degreeBoundarySummand (markedTensorDiagram E x d) d n s :=
  Category.comp_id _

theorem operadProfileCellCofan_right (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    (operadProfileCellCofan E x d n s).right =
      degreeTopSummand (markedTensorDiagram E x d) d n s ≫ rawToTopMap (markedTensorDiagram E x d) n := rfl

/-- The profile-boundary cofan of the coefficient-weighted degree boundary. -/
def operadBoundaryCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    Cofan (fun s : ProfileClass W n => (balancedProfileArrow E x (representativeProfile d s)).left) :=
  degreeBoundaryCofan (markedTensorDiagram E x d) d n

/-- The colimit structure expressing the degree boundary as a coproduct of balanced profile
boundaries. -/
def operadBoundaryIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : IsColimit (operadBoundaryCofan E x d n) :=
  degreeBoundaryIsColimit (markedTensorDiagram E x d) d n

/-- The profile-top cofan of the coefficient-weighted balanced degree top object. -/
def operadTopCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    Cofan (fun s : ProfileClass W n => (balancedProfileArrow E x (representativeProfile d s)).right) :=
  Cofan.mk (degreeBalancedArrow E x d n).right (fun s => (operadProfileCellCofan E x d n s).right)

/-- The colimit structure expressing the degree top as a coproduct of balanced profile tops. -/
def operadTopIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : IsColimit (operadTopCofan E x d n) :=
  IsColimit.ofIsoColimit (degreeTopIsColimit (markedTensorDiagram E x d) d n)
    (Cocone.ext (rawDegreeTopIso (markedTensorDiagram E x d) n))

/-- The balanced degree arrow cofan indexed by profile classes. -/
def operadArrowCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    Cofan (fun s : ProfileClass W n => balancedProfileArrow E x (representativeProfile d s)) :=
  Cofan.mk (degreeBalancedArrow E x d n) (operadProfileCellCofan E x d n)

/-- The actual degreeBalancedArrow is the genuine coproduct of the actual
original balanced profile arrows, with full original Arrow morphisms. -/
def operadArrowIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : IsColimit (operadArrowCofan E x d n) :=
  IsColimit.ofIsoColimit (rawDegreeArrowIsColimit (markedTensorDiagram E x d) d n)
    (Cocone.ext (rawOperadDegreeIso E x d n))

/-- Exact original punctured degree cofan readback before any tensor map
or profile quotient projection is forgotten. -/
theorem operadProfileCellCofan_boundary_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) (S : RepresentativePunctured s) :
    (representativeBoundaryCocone (markedTensorDiagram E x d) d s).ι.app S ≫
        (operadProfileCellCofan E x d n s).left =
      colimit.ι (puncturedMarkedTensorDiagram E x d n) (representativePuncturedVertex s S) :=
  (congrArg ((representativeBoundaryCocone (markedTensorDiagram E x d) d s).ι.app S ≫ ·)
    (operadProfileCellCofan_left E x d n s)).trans (degreeBoundarySummand_face (markedTensorDiagram E x d) d n s S)

/-- Every original full coordinate vertex retains the original to-top map
and the original degree-top cofan on the literal target projection. -/
theorem operadProfileCellCofan_top_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) (S : RepresentativeCube s) :
    (representativeTopCocone (markedTensorDiagram E x d) d s).ι.app S ≫
        (operadProfileCellCofan E x d n s).right =
      (degreeToTop E x d n).app (representativeVertex s S) ≫
        colimit.ι (degreeTopTensorDiagram E x d n) (representativeVertex s S) :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ rawToTopMap (markedTensorDiagram E x d) n)
      (degreeTopSummand_face (markedTensorDiagram E x d) d n s S)).trans
      (rawToTopMap_face (markedTensorDiagram E x d) n (representativeVertex s S)))

/-- Descend the balanced degree arrow to a compatible cofan of balanced profile arrows. -/
def operadProfileCellsDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => balancedProfileArrow E x (representativeProfile d s))) :
    degreeBalancedArrow E x d n ⟶ t.pt := (operadArrowIsColimit E x d n).desc t

theorem operadProfileCellsDesc_fac (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => balancedProfileArrow E x (representativeProfile d s)))
    (s : ProfileClass W n) : operadProfileCellCofan E x d n s ≫ operadProfileCellsDesc E x d n t = t.inj s :=
  (operadArrowIsColimit E x d n).fac t (Discrete.mk s)

theorem operadProfileCellsDesc_unique (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => balancedProfileArrow E x (representativeProfile d s)))
    (m : degreeBalancedArrow E x d n ⟶ t.pt)
    (w : ∀ s, operadProfileCellCofan E x d n s ≫ m = t.inj s) :
    m = operadProfileCellsDesc E x d n t :=
  (operadArrowIsColimit E x d n).uniq t m (fun s => w s.as)


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource162


