/-!
## Original free algebra profile and nullary evaluations
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- An arbitrary original input map retains the original nullary coefficient
and its actual empty input comparison. -/
theorem nullaryFactors_carrier (E : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (analyticFactorsCarrierMap E f).app (AnalyticIndex.nullary (d := d)) ≫
        (nullaryFactorsIso E B d).hom = (nullaryFactorsIso E A d).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i => exact Fin.elim0 i
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some i => exact Fin.elim0 i

omit [FiniteTensor C] in
/-- The original nullary coefficient insertion is independent of every
original carrier map, through both actual factor-comparison inverses. -/
theorem nullaryFactors_inv_carrier (E : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (nullaryFactorsIso E A d).inv ≫
        (analyticFactorsCarrierMap E f).app (AnalyticIndex.nullary (d := d)) =
      (nullaryFactorsIso E B d).inv := by
  let a := nullaryFactorsIso E A d
  let b := nullaryFactorsIso E B d
  let m := (analyticFactorsCarrierMap E f).app (AnalyticIndex.nullary (d := d))
  have h : m ≫ b.hom = a.hom := nullaryFactors_carrier E f d
  apply (cancel_mono b.hom).1
  exact (Category.assoc a.inv m b.hom).trans
    ((congrArg (a.inv ≫ ·) h).trans (a.inv_hom_id.trans b.inv_hom_id.symm))

/-- The actual original nullary tensor insertion is independent of every
original carrier map, including all original unit and singleton comparisons. -/
theorem nullarySummand_inv_carrier (E : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (nullarySummandIso E A d).inv ≫
        (analyticSummandCarrierMap E f).app (AnalyticIndex.nullary (d := d)) =
      (nullarySummandIso E B d).inv := by
  let T := FiniteTensor.tensor (V := C)
  let a := nullaryFactorsIso E A d
  let b := nullaryFactorsIso E B d
  let m := (analyticFactorsCarrierMap E f).app (AnalyticIndex.nullary (d := d))
  let s := (FiniteTensor.singletonIso (V := C)).app (E.obj (ColoredProfile.nullary d))
  have h : T.map a.inv ≫ T.map m = T.map b.inv :=
    (T.map_comp _ _).symm.trans (congrArg T.map (nullaryFactors_inv_carrier E f d))
  exact (Category.assoc s.inv (T.map a.inv) (T.map m)).trans (congrArg (s.inv ≫ ·) h)

variable [Small.{us} W] [∀ d : W, HasColimitsOfShape (AnalyticIndex W d) C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C]

/-- Every actual original free algebra arrow evaluates each original profile
cofan by its original generator restriction and genuine target operations. -/
theorem profileι_freeHom (E : ColoredOperadObj W C) (Y : W → C) (M : Algebra E)
    (h : freeAlgebra E Y ⟶ M) {d : W} (P : AnalyticIndex W d) :
    profileι E.toCollection Y P ≫ h.hom d =
      (analyticSummandCarrierMap E.toCollection (tensorFreeHomEquiv E Y M h)).app P ≫
        M.operations.app d P := by
  let g := tensorFreeHomEquiv E Y M h
  let p := profileι E.toCollection Y P
  let q := profileι E.toCollection M.carrier P
  let m := profileMap E.toCollection g d
  let t := (analyticSummandCarrierMap E.toCollection g).app P
  let a := M.action d
  have hh : (freeAlgebraLift E M g).hom d = h.hom d :=
    congrArg (fun z => z.hom d) ((tensorFreeHomEquiv E Y M).symm_apply_apply h)
  have hp : p ≫ m = t ≫ q := profileι_map E.toCollection g P
  have hq : q ≫ a = M.operations.app d P := M.operations.ι_desc P
  exact (congrArg (p ≫ ·) hh.symm).trans
    ((Category.assoc p m a).symm.trans
      ((congrArg (· ≫ a) hp).trans
        ((Category.assoc t q a).trans (congrArg (t ≫ ·) hq))))

/-- The original nullary coefficient followed by any actual original free
algebra arrow is precisely the genuine original target nullary operation. -/
theorem nullary_freeHom (E : ColoredOperadObj W C) (Y : W → C) (M : Algebra E)
    (h : freeAlgebra E Y ⟶ M) (d : W) :
    (nullarySummandIso E.toCollection Y d).inv ≫
        profileι E.toCollection Y (AnalyticIndex.nullary (d := d)) ≫ h.hom d =
      FrozenAlgebra.nullaryEvaluation M d := by
  let g := tensorFreeHomEquiv E Y M h
  let i := (nullarySummandIso E.toCollection Y d).inv
  let p := profileι E.toCollection Y (AnalyticIndex.nullary (d := d))
  let t := (analyticSummandCarrierMap E.toCollection g).app (AnalyticIndex.nullary (d := d))
  let n := (nullarySummandIso E.toCollection M.carrier d).inv
  let o := M.operations.app d (AnalyticIndex.nullary (d := d))
  have hp : p ≫ h.hom d = t ≫ o := profileι_freeHom E Y M h _
  have ht : i ≫ t = n := nullarySummand_inv_carrier E.toCollection g d
  exact (congrArg (i ≫ ·) hp).trans
    ((Category.assoc i t o).symm.trans (congrArg (· ≫ o) ht))


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource125


