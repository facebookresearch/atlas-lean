              (fun i => Xprime (P.inputColor (inputEnumeration P i))) S))).hom := rfl

private theorem AttachmentSource068_threeSquareChain {D : Type*} [Category* D]
    {A₀ A₁ A₂ A₃ B₀ B₁ B₂ B₃ : D}
    (m₀ : A₀ ⟶ B₀) (m₁ : A₁ ⟶ B₁) (m₂ : A₂ ⟶ B₂) (m₃ : A₃ ⟶ B₃)
    (a₀ : A₀ ⟶ A₁) (a₁ : A₁ ⟶ A₂) (a₂ : A₂ ⟶ A₃)
    (b₀ : B₀ ⟶ B₁) (b₁ : B₁ ⟶ B₂) (b₂ : B₂ ⟶ B₃)
    (h₀ : m₀ ≫ b₀ = a₀ ≫ m₁) (h₁ : m₁ ≫ b₁ = a₁ ≫ m₂) (h₂ : m₂ ≫ b₂ = a₂ ≫ m₃) :
    m₀ ≫ (b₀ ≫ b₁ ≫ b₂) = (a₀ ≫ a₁ ≫ a₂) ≫ m₃ := by
  simp only [Category.assoc]
  rw [← Category.assoc m₀ b₀ (b₁ ≫ b₂), h₀, Category.assoc a₀ m₁ (b₁ ≫ b₂),
    ← Category.assoc m₁ b₁ b₂, h₁, Category.assoc a₁ m₂ b₂, h₂]

/-- The full marked-to-original tensor comparison retains every original
punctured and top cube face, with precisely its original heterogeneous x maps. -/
theorem profileMarkedVertexTensorIso_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) {S T : FiniteCube.Index (inputCount P)} (f : S ⟶ T) :
    (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor).map f ≫
        (profileMarkedVertexTensorIso E x P T).hom =
      (profileMarkedVertexTensorIso E x P S).hom ≫ (profileTensorCube E x P).map f := by
  let A := FiniteTensor.tensor (V := C)
  let B := coefficientInputFactors (markedProfileFunctor P.outputColor ⋙ E.toCollection)
    (FiniteFamily.map (markedInputCarrier x))
  let l := (rawProfileLeafCube x P).map f
  let Y := E.toCollection.obj P
  let Vₛ := FiniteCube.vertexFamily
    (fun i => X (P.inputColor (inputEnumeration P i)))
    (fun i => Xprime (P.inputColor (inputEnumeration P i))) S
  let Vₜ := FiniteCube.vertexFamily
    (fun i => X (P.inputColor (inputEnumeration P i)))
    (fun i => Xprime (P.inputColor (inputEnumeration P i))) T
  let a := A.map (profileMarkedFactorsIso E x P S).hom
  let a' := A.map (profileMarkedFactorsIso E x P T).hom
  let b := (coefficientBinaryTensorIso Y ((rawProfileLeafCube x P).obj S)).hom
  let b' := (coefficientBinaryTensorIso Y ((rawProfileLeafCube x P).obj T)).hom
  let c := (tensorIso (Iso.refl Y) (fixedToOrderedIso Vₛ)).hom
  let c' := (tensorIso (Iso.refl Y) (fixedToOrderedIso Vₜ)).hom
  let m₀ := A.map (B.map ((profileMarkedCube P).map f))
  let m₁ := A.map (coefficientLeafMap (𝟙 Y) l)
  let m₂ := 𝟙 Y ⊗ₘ A.map l
  let m₃ := (profileTensorCube E x P).map f
  have h₀ : m₀ ≫ a' = a ≫ m₁ :=
    (A.map_comp _ _).symm.trans
      ((congrArg A.map (profileMarkedFactorsIso_face E x P f)).trans (A.map_comp _ _))
  have h₁ : m₁ ≫ b' = b ≫ m₂ := coefficientBinaryTensorIso_naturality (𝟙 Y) l
  have hleaf := fixedToOrderedIso_naturality
    (FiniteCube.familyMap (profileArrowFamily x P) (leOfHom f))
  have h₂ : m₂ ≫ c' = c ≫ m₃ := by
    let F := tensorLeft Y
    let g := OrderedTensor.map (FiniteCube.familyMap (profileArrowFamily x P) (leOfHom f))
    have hl : A.map l ≫ (fixedToOrderedIso Vₜ).hom = (fixedToOrderedIso Vₛ).hom ≫ g := hleaf
    have ht : F.map (A.map l) ≫ F.map (fixedToOrderedIso Vₜ).hom =
        F.map (fixedToOrderedIso Vₛ).hom ≫ F.map g :=
      (F.map_comp _ _).symm.trans ((congrArg F.map hl).trans (F.map_comp _ _))
    have hm : m₂ = F.map (A.map l) := id_tensorHom Y _
    have hc' : c' = F.map (fixedToOrderedIso Vₜ).hom := id_tensorHom Y _
    have hc : c = F.map (fixedToOrderedIso Vₛ).hom := id_tensorHom Y _
    have hg : m₃ = F.map g := rfl
    exact (congrArg (· ≫ c') hm).trans
      ((congrArg (F.map (A.map l) ≫ ·) hc').trans
        (ht.trans ((congrArg (· ≫ F.map g) hc).symm.trans (congrArg (c ≫ ·) hg).symm)))
  have h := AttachmentSource068_threeSquareChain m₀ m₁ m₂ m₃ a b c a' b' c' h₀ h₁ h₂
  exact (congrArg (m₀ ≫ ·) (profileMarkedVertexTensorIso_hom E x P T)).trans
    (h.trans (congrArg (· ≫ m₃) (profileMarkedVertexTensorIso_hom E x P S)).symm)

/-- The actual marked profile tensor cube is naturally the canonical original
coefficient-weighted FiniteCube, on every original input and every original face. -/
def profileMarkedTensorCubeIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor ≅ profileTensorCube E x P :=
  NatIso.ofComponents (profileMarkedVertexTensorIso E x P)
    (fun f => profileMarkedVertexTensorIso_face E x P f)


end Tensor

