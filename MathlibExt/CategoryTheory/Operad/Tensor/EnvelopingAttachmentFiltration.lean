local instance concreteBoundarySmallestColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The coefficient-weighted tensor cube on the actual inputs of a profile. -/
def originalInputTensorCube (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : ProfileInputSets P ⥤ C :=
  originalInputCube P ⋙ markedTensorDiagram E x P.outputColor

/-- The proper-face diagram of the coefficient-weighted input tensor cube. -/
def originalPuncturedTensor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : ProfilePuncturedInputSets P ⥤ C :=
  originalPuncturedInclusion P ⋙ originalInputTensorCube E x P

/-- The colimit of the coefficient-weighted proper-face tensor diagram. -/
def originalInputBoundary (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : C := colimit (originalPuncturedTensor E x P)

/-- Every original automorphism acts on each proper original input set and
its actual original coefficient/input tensor before the boundary quotient. -/
def boundaryAutCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    Cocone (originalPuncturedTensor E x P) where
  pt := originalInputBoundary E x P
  ι.app S := (markedTensorDiagram E x P.outputColor).map (profileAutInputVertexIso P g S.1).hom ≫
    colimit.ι (originalPuncturedTensor E x P) ((profileAutPunctured P g).obj S)
  ι.naturality S T h := by
    let D := markedTensorDiagram E x P.outputColor
    let q := (originalPuncturedInclusion P).map h
    let k := (profileAutSubsetFunctor P g).map q
    have hs : D.map ((originalInputCube P).map q) ≫ D.map (profileAutInputVertexIso P g T.1).hom =
        D.map (profileAutInputVertexIso P g S.1).hom ≫ D.map ((originalInputCube P).map k) :=
      (D.map_comp _ _).symm.trans
        ((congrArg D.map (profileAutInputVertexIso_face P g q)).trans (D.map_comp _ _))
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ colimit.ι (originalPuncturedTensor E x P) ((profileAutPunctured P g).obj T)) hs).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (D.map (profileAutInputVertexIso P g S.1).hom ≫ ·)
            (colimit.w (originalPuncturedTensor E x P) ((profileAutPunctured P g).map h))).trans
              (Category.comp_id _).symm)))

/-- The original automorphism boundary map is constructed from all the
original relabelled proper faces by the actual boundary colimit. -/
def boundaryAutMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    originalInputBoundary E x P ⟶ originalInputBoundary E x P :=
  colimit.desc _ (boundaryAutCocone E x P g)

theorem boundaryAutMap_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) (S : ProfilePuncturedInputSets P) :
    colimit.ι (originalPuncturedTensor E x P) S ≫ boundaryAutMap E x P g =
      (markedTensorDiagram E x P.outputColor).map (profileAutInputVertexIso P g S.1).hom ≫
        colimit.ι (originalPuncturedTensor E x P) ((profileAutPunctured P g).obj S) :=
  colimit.ι_desc _ _

theorem boundaryAutMap_one (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    boundaryAutMap E x P 1 = 𝟙 (originalInputBoundary E x P) := by
  let D := markedTensorDiagram E x P.outputColor
  let B := originalPuncturedTensor E x P
  apply colimit.hom_ext
  intro S
  let e : S = (profileAutPunctured P 1).obj S := Subtype.ext (profileAutSubset_one P S.1).symm
  let f := eqToHom e
  have hf : (originalPuncturedInclusion P).map f = eqToHom (profileAutSubset_one P S.1).symm :=
    Subsingleton.elim _ _
  have hm : D.map (profileAutInputVertexIso P 1 S.1).hom = B.map f :=
    (congrArg D.map (profileAutInputVertexIso_one P S.1)).trans
      (congrArg (fun k => D.map ((originalInputCube P).map k)) hf).symm
  exact (boundaryAutMap_face E x P 1 S).trans
    ((congrArg (· ≫ colimit.ι B ((profileAutPunctured P 1).obj S)) hm).trans
      ((colimit.w B f).trans (Category.comp_id _).symm))

/-- Composition of the actual original boundary action maps is the original
profile automorphism multiplication, with every original input permutation. -/
theorem boundaryAutMap_mul (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (f g : Aut P) :
    boundaryAutMap E x P (f * g) = boundaryAutMap E x P g ≫ boundaryAutMap E x P f :=
  geometryAutMap_mul (markedTensorDiagram E x P.outputColor) P f g

/-- The actual original profile group action on the full original punctured
tensor boundary is a genuine representation, not an assumed compatibility family. -/
def profileBoundaryRepresentation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Aut P →* End (originalInputBoundary E x P) where
  toFun g := End.of (boundaryAutMap E x P g)
  map_one' := End.ext (boundaryAutMap_one E x P)
  map_mul' f g := End.ext (boundaryAutMap_mul E x P f g)

/-- The action diagram for profile automorphisms on the coefficient-weighted boundary. -/
def profileBoundaryActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : SingleObj (Aut P) ⥤ C :=
  SingleObj.functor (profileBoundaryRepresentation E x P)


