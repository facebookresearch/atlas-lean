original action colimit, with no desired coinvariant object as input. -/
def profileTopOrbit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : C :=
  colimit (profileTopActionFunctor E x P)

/-- Every original profile automorphism satisfies its actual original tensor
coinvariant relation in the constructed orbit. -/
theorem profileTopOrbit_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    (profileTopRepresentation E x P g).asHom ≫
      colimit.ι (profileTopActionFunctor E x P) (SingleObj.star (Aut P)) =
        colimit.ι (profileTopActionFunctor E x P) (SingleObj.star (Aut P)) :=
