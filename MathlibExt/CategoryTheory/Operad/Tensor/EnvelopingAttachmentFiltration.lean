section AttachmentSource051


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource051_dependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The exact original Q1/Q2 coefficient permutation on the complete
root/Q2/Q1/retained-variable source. -/
def simultaneousFusionMap (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
      (constantInputFamily O X (extendProfile P Q1) Q2) (LeafFusion.leafSum ((addedAlgebraInputs X).obj Q1) L)) ⟶
    (FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested (constantInputFamily O X P (DisjointNullary.inputSum Q1 Q2)) L) where
  equiv :=
    { toFun := fun i => match i with
        | ⟨none, none⟩ => ⟨none, none⟩
        | ⟨none, some i⟩ => ⟨none, some (Sum.inr i)⟩
        | ⟨some (Sum.inl i), _⟩ => ⟨none, some (Sum.inl i)⟩
        | ⟨some (Sum.inr i), _⟩ => ⟨some i, PUnit.unit⟩
      invFun := fun i => match i with
        | ⟨none, none⟩ => ⟨none, none⟩
        | ⟨none, some (Sum.inl i)⟩ => ⟨some (Sum.inl i), PUnit.unit⟩
        | ⟨none, some (Sum.inr i)⟩ => ⟨none, some i⟩
        | ⟨some i, _⟩ => ⟨some (Sum.inr i), PUnit.unit⟩
      left_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; cases i <;> rfl
      right_inv := fun i => by
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j with | none => rfl | some i => cases i <;> rfl
        | some i => cases j; rfl }
  hom i := match i with
    | ⟨none, none⟩ => O.map (DisjointNullary.rootSumAssocHom P Q1 Q2)
    | ⟨none, some _⟩ => 𝟙 _
    | ⟨some (Sum.inl _), _⟩ => 𝟙 _
    | ⟨some (Sum.inr _), _⟩ => 𝟙 _

/-- The actual original grouping inverse and simultaneous coefficient map
give exactly the displayed full original root/Q1/Q2/variable source map. -/
theorem simultaneousFusionMap_original (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) (L : FiniteFamily C) :
    (LeafFusion.rawIso (constantInputFamily O X (extendProfile P Q1) Q2) ((addedAlgebraInputs X).obj Q1) L).inv ≫
      (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (normalizedSimultaneousFactorMap O X P Q1 Q2) (𝟙 L)) =
      simultaneousFusionMap O X P Q1 Q2 L := by
  let K := constantInputFamily O X (extendProfile P Q1) Q2
  let M := (addedAlgebraInputs X).obj Q1
  let e := (LeafFusion.rawIso K M L).inv
  let n := normalizedSimultaneousFactorMap O X P Q1 Q2
  let H := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap n (𝟙 L))
  let B := (FiniteFamily.flatten (C := C)).obj
    (coefficientLeavesNested ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K M)) L)
  let C' := (FiniteFamily.flatten (C := C)).obj
    (coefficientLeavesNested (constantInputFamily O X P (DisjointNullary.inputSum Q1 Q2)) L)
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    rintro ⟨i, j⟩
    cases i with
    | none =>
        cases j with
        | none =>
            change H.equiv (e.equiv ⟨none, none⟩) = ⟨none, none⟩
            exact (congrArg H.equiv (LeafFusion.rawInv_position_root K M L none)).trans
              (congrArg (fun i => (⟨none, i⟩ : C'.index)) (normalizedSimultaneous_position_root O X P Q1 Q2))
        | some j =>
            change H.equiv (e.equiv ⟨none, some j⟩) = ⟨none, some (Sum.inr j)⟩
            exact (congrArg H.equiv (LeafFusion.rawInv_position_root K M L (some j))).trans
              (congrArg (fun i => (⟨none, i⟩ : C'.index)) (normalizedSimultaneous_position_q2 O X P Q1 Q2 j))
    | some i =>
        cases j
        cases i with
        | inl i =>
            change H.equiv (e.equiv ⟨some (Sum.inl i), PUnit.unit⟩) = ⟨none, some (Sum.inl i)⟩
            exact (congrArg H.equiv (LeafFusion.rawInv_position_old K M L i)).trans
              (congrArg (fun j => (⟨none, j⟩ : C'.index)) (normalizedSimultaneous_position_q1 O X P Q1 Q2 i))
        | inr i =>
            change H.equiv (e.equiv ⟨some (Sum.inr i), PUnit.unit⟩) = ⟨some i, PUnit.unit⟩
            exact (congrArg H.equiv (LeafFusion.rawInv_position_survivor K M L i)).trans rfl
  · rintro ⟨i, j⟩
    cases i with
    | none =>
        cases j with
        | none =>
            let f := O.map (DisjointNullary.rootSumAssocHom P Q1 Q2)
            have hp : e.equiv ⟨none, none⟩ = ⟨none, ⟨none, none⟩⟩ := LeafFusion.rawInv_position_root K M L none
            have hb : B.obj (e.equiv ⟨none, none⟩) = K.obj none := congrArg B.obj hp
            have hc : C'.obj (H.equiv (e.equiv ⟨none, none⟩)) = (constantInputFamily O X P (DisjointNullary.inputSum Q1
              Q2)).obj none :=
              (congrArg (fun i => C'.obj (H.equiv i)) hp).trans
                (congrArg (fun i => C'.obj ⟨none, i⟩) (normalizedSimultaneous_position_root O X P Q1 Q2))
            have hh : HEq (H.hom (e.equiv ⟨none, none⟩)) f :=
              (AttachmentSource051_dependentApply H.hom hp).trans (heq_of_eq (normalizedSimultaneous_component_root O X
                P Q1 Q2))
            have he := heq_comp rfl hb hc (heq_of_eq (LeafFusion.rawInv_component_root K M L none)) hh
            exact he.trans (heq_of_eq (Category.id_comp f))
        | some j =>
            let A := X (Q2.obj j).as
            have hp : e.equiv ⟨none, some j⟩ = ⟨none, ⟨none, some j⟩⟩ := LeafFusion.rawInv_position_root K M L (some j)
            have hb : B.obj (e.equiv ⟨none, some j⟩) = A := congrArg B.obj hp
            have hc : C'.obj (H.equiv (e.equiv ⟨none, some j⟩)) = A :=
              (congrArg (fun i => C'.obj (H.equiv i)) hp).trans
                (congrArg (fun i => C'.obj ⟨none, i⟩) (normalizedSimultaneous_position_q2 O X P Q1 Q2 j))
            have hh : HEq (H.hom (e.equiv ⟨none, some j⟩)) (𝟙 A) :=
              (AttachmentSource051_dependentApply H.hom hp).trans (heq_of_eq (normalizedSimultaneous_component_q2 O X P
                Q1 Q2 j))
            have he := heq_comp rfl hb hc (heq_of_eq (LeafFusion.rawInv_component_root K M L (some j))) hh
            exact he.trans (heq_of_eq (Category.id_comp (𝟙 A)))
    | some i =>
        cases j
        cases i with
        | inl i =>
            let A := X (Q1.obj i).as
            have hp : e.equiv ⟨some (Sum.inl i), PUnit.unit⟩ = ⟨none, ⟨some i, PUnit.unit⟩⟩ :=
              LeafFusion.rawInv_position_old K M L i
            have hb : B.obj (e.equiv ⟨some (Sum.inl i), PUnit.unit⟩) = A := congrArg B.obj hp
            have hc : C'.obj (H.equiv (e.equiv ⟨some (Sum.inl i), PUnit.unit⟩)) = A :=
              (congrArg (fun j => C'.obj (H.equiv j)) hp).trans
                (congrArg (fun j => C'.obj ⟨none, j⟩) (normalizedSimultaneous_position_q1 O X P Q1 Q2 i))
            have hh : HEq (H.hom (e.equiv ⟨some (Sum.inl i), PUnit.unit⟩)) (𝟙 A) :=
              (AttachmentSource051_dependentApply H.hom hp).trans (heq_of_eq (normalizedSimultaneous_component_q1 O X P
                Q1 Q2 i))
            have he := heq_comp rfl hb hc (heq_of_eq (LeafFusion.rawInv_component_old K M L i)) hh
            exact he.trans (heq_of_eq (Category.id_comp (𝟙 A)))
        | inr i =>
            have hp : e.equiv ⟨some (Sum.inr i), PUnit.unit⟩ = ⟨some i, PUnit.unit⟩ :=
              LeafFusion.rawInv_position_survivor K M L i
            have hb : B.obj (e.equiv ⟨some (Sum.inr i), PUnit.unit⟩) = L.obj i := congrArg B.obj hp
            have hc : C'.obj (H.equiv (e.equiv ⟨some (Sum.inr i), PUnit.unit⟩)) = L.obj i := congrArg (fun j => C'.obj
              (H.equiv j)) hp
            have hh : HEq (H.hom (e.equiv ⟨some (Sum.inr i), PUnit.unit⟩)) (𝟙 (L.obj i)) :=
              (AttachmentSource051_dependentApply H.hom hp).trans HEq.rfl
            have he := heq_comp rfl hb hc (heq_of_eq (LeafFusion.rawInv_component_survivor K M L i)) hh
            exact he.trans (heq_of_eq (Category.id_comp (𝟙 (L.obj i))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource051


section AttachmentSource052


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource052_transportedIsoHom {D : Type*} [Category* D] {A B B' : D}
    (e : B = B') (i : A ≅ B) :
    HEq ((Eq.mp (congrArg (fun k => A ≅ k) e) i).hom) i.hom := by
  cases e
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem partialMarked_position_root (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (partialMarkedFactorsIso O x d g).hom.equiv none = ⟨none, none⟩ := rfl

theorem partialMarked_position_retained (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : P.index) (hi : SelectedInput Q (g.equiv i)) :
    (partialMarkedFactorsIso O x d g).hom.equiv (some i) = ⟨some ⟨g.equiv i, hi⟩, PUnit.unit⟩ := by
  have hp : contractionInputEquiv Q (some (g.equiv i)) = ⟨some ⟨g.equiv i, hi⟩, PUnit.unit⟩ := by
    change (if h : SelectedInput Q (g.equiv i) then _ else _) = _
    exact dite_eq_left hi
  let k : (Σ j : Option (survivingInputs Q).index,
      match j with | none => Option (contractedInputs Q).index | some _ => PUnit) ≃
      (partialMarkedFactors O x d g).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  change k (contractionInputEquiv Q (some (g.equiv i))) = _
  exact (congrArg k hp).trans rfl

theorem partialMarked_position_old (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : P.index) (hi : ¬ SelectedInput Q (g.equiv i)) :
    (partialMarkedFactorsIso O x d g).hom.equiv (some i) = ⟨none, some ⟨g.equiv i, hi⟩⟩ := by
  have hp : contractionInputEquiv Q (some (g.equiv i)) = ⟨none, some ⟨g.equiv i, hi⟩⟩ := by
    change (if h : SelectedInput Q (g.equiv i) then _ else _) = _
    exact dite_eq_right hi
  let k : (Σ j : Option (survivingInputs Q).index,
      match j with | none => Option (contractedInputs Q).index | some _ => PUnit) ≃
      (partialMarkedFactors O x d g).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  change k (contractionInputEquiv Q (some (g.equiv i))) = _
  exact (congrArg k hp).trans rfl

theorem partialMarked_component_root (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (partialMarkedFactorsIso O x d g).hom.hom none =
      O.map ((markedProfileFunctor d).map g) ≫ O.map (asIso (selectionRootHom d Q)).inv := rfl

theorem partialMarked_component_retained (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : P.index) (hi : SelectedInput Q (g.equiv i)) :
    HEq ((partialMarkedFactorsIso O x d g).hom.hom (some i))
      ((markedInputCarrier x).map (eqToHom (retainedMarkEq g i hi))) := by
  have hp : contractionInputEquiv Q (some (g.equiv i)) = ⟨some ⟨g.equiv i, hi⟩, PUnit.unit⟩ := by
    change (if h : SelectedInput Q (g.equiv i) then _ else _) = _
    exact dite_eq_left hi
  let k : (Σ j : Option (survivingInputs Q).index,
      match j with | none => Option (contractedInputs Q).index | some _ => PUnit) ≃
      (partialMarkedFactors O x d g).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  let Y := partialMarkedFactors O x d g
  have ht : (markedInputCarrier x).obj ((residualMarkedInputs g).obj ⟨g.equiv i, hi⟩) =
      Y.obj (k (contractionInputEquiv Q (some (g.equiv i)))) :=
    (congrArg (fun j => Y.obj (k j)) hp).symm
  have h := AttachmentSource052_transportedIsoHom ht ((markedInputCarrier x).mapIso (eqToIso (retainedMarkEq g i hi)))
  simpa only [partialMarkedFactorsIso, FiniteFamily.isoOfComponents, dite_eq_left hi, k, Y] using! h

theorem partialMarked_component_old (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : P.index) (hi : ¬ SelectedInput Q (g.equiv i)) :
    HEq ((partialMarkedFactorsIso O x d g).hom.hom (some i))
      (eqToHom (partialOldCarrierEq x g i hi)) := by
  have hp : contractionInputEquiv Q (some (g.equiv i)) = ⟨none, some ⟨g.equiv i, hi⟩⟩ := by
    change (if h : SelectedInput Q (g.equiv i) then _ else _) = _
    exact dite_eq_right hi
  let k : (Σ j : Option (survivingInputs Q).index,
      match j with | none => Option (contractedInputs Q).index | some _ => PUnit) ≃
      (partialMarkedFactors O x d g).index :=
    Equiv.sigmaCongrRight (fun j => by cases j <;> exact Equiv.refl _)
  let Y := partialMarkedFactors O x d g
  have ht : X (Q.obj (g.equiv i)).2.as = Y.obj (k (contractionInputEquiv Q (some (g.equiv i)))) :=
    (congrArg (fun j => Y.obj (k j)) hp).symm
  have h := AttachmentSource052_transportedIsoHom ht (eqToIso (partialOldCarrierEq x g i hi))
  simpa only [partialMarkedFactorsIso, FiniteFamily.isoOfComponents, dite_eq_right hi, k, Y] using! h


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource052


section AttachmentSource053


/-!
## Original input positions in successive and simultaneous contractions
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Enveloping Continuation

attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The literal original partial source, residual input normalization and
simultaneous old-input fusion map. -/
def iteratedSourceFactors (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    markedSourceFactors O x d P ⟶
      (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
        (constantInputFamily O X (iterationProfile d g)
          (DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)))
        (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))) :=
  (partialMarkedFactorsIso O x d g).hom ≫ iterationNormalizationMap O x d g ≫
    simultaneousFusionMap O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g)
      (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))

/-- The literal original marked contraction source followed by its original
survivor and contracted-input permutation. -/
def simultaneousSourceFactors (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    markedSourceFactors O x d P ⟶
      (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
        (constantInputFamily O X (iterationProfile d g)
          (DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)))
        (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))) :=
  (markedContractionFactorsIso O x d P).hom ≫
    (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
      (contractionInputMap O X (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom)
      (profileLeafIso Xprime (residualSurvivorProfileHom d g)).hom)

/-- Both literal original sources use the same full input bijection. The
three input cases retain original survivors, residual old inputs and inputs
that remain old after the original face map. -/
theorem iterationSource_equiv (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (iteratedSourceFactors O x d g).equiv = (simultaneousSourceFactors O x d g).equiv := by
  let R := residualMarkedInputs g
  let a := (partialMarkedFactorsIso O x d g).hom
  let n := iterationNormalizationMap O x d g
  let f := simultaneousFusionMap O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g)
    (iterationSurvivorLeaves Xprime d R)
  let r := (markedContractionFactorsIso O x d P).hom
  let s := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (contractionInputMap O X (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom)
    (profileLeafIso Xprime (residualSurvivorProfileHom d g)).hom)
  let T := (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
    (constantInputFamily O X (iterationProfile d g)
      (DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)))
    (iterationSurvivorLeaves Xprime d R))
  apply Equiv.ext
  intro i
  cases i with
  | none => rfl
  | some i =>
      by_cases hP : SelectedInput P i
      · have hQ : SelectedInput Q (g.equiv i) := markedHom_selected g i hP
        let j : R.index := ⟨g.equiv i, hQ⟩
        have hR : SelectedInput R j := by
          change SelectedInput P (g.equiv.symm (g.equiv i))
          exact (congrArg (SelectedInput P) (g.equiv.symm_apply_apply i)).symm.mp hP
        have ha : a.equiv (some i) = ⟨some j, PUnit.unit⟩ := partialMarked_position_retained O x d g i hQ
        have hn : n.equiv ⟨some j, PUnit.unit⟩ =
            ⟨some ((iterationLeafIso x d R).hom.equiv j), PUnit.unit⟩ :=
          iterationNormalization_position_retained O x d g j
        have hl : (iterationLeafIso x d R).hom.equiv j = Sum.inr ⟨j, hR⟩ :=
          iterationLeaf_position_top x d R j hR
        have hleft : f.equiv (n.equiv (a.equiv (some i))) =
            (⟨some ⟨j, hR⟩, PUnit.unit⟩ : T.index) :=
          (congrArg (fun k => f.equiv (n.equiv k)) ha).trans
            ((congrArg f.equiv hn).trans
              ((congrArg (fun k => f.equiv ⟨some k, PUnit.unit⟩) hl).trans rfl))
        have hright : s.equiv (r.equiv (some i)) =
            (⟨some ⟨j, hR⟩, PUnit.unit⟩ : T.index) :=
          (congrArg s.equiv (markedContraction_position_top O x d P i hP)).trans rfl
        exact hleft.trans hright.symm
      · by_cases hQ : SelectedInput Q (g.equiv i)
        · let j : R.index := ⟨g.equiv i, hQ⟩
          have hR : ¬ SelectedInput R j := by
            intro h
            change SelectedInput P (g.equiv.symm (g.equiv i)) at h
            exact hP ((congrArg (SelectedInput P) (g.equiv.symm_apply_apply i)).mp h)
          have ha : a.equiv (some i) = ⟨some j, PUnit.unit⟩ := partialMarked_position_retained O x d g i hQ
          have hn : n.equiv ⟨some j, PUnit.unit⟩ =
              ⟨some ((iterationLeafIso x d R).hom.equiv j), PUnit.unit⟩ :=
            iterationNormalization_position_retained O x d g j
          have hl : (iterationLeafIso x d R).hom.equiv j = Sum.inl ⟨j, hR⟩ :=
            iterationLeaf_position_old x d R j hR
          have hleft : f.equiv (n.equiv (a.equiv (some i))) =
              (⟨none, some (Sum.inl ⟨j, hR⟩)⟩ : T.index) :=
            (congrArg (fun k => f.equiv (n.equiv k)) ha).trans
              ((congrArg f.equiv hn).trans
                ((congrArg (fun k => f.equiv ⟨some k, PUnit.unit⟩) hl).trans rfl))
          have hr : r.equiv (some i) = ⟨none, some ⟨i, hP⟩⟩ :=
            markedContraction_position_old O x d P i hP
          have hu := iterationContracted_position_selected g ⟨i, hP⟩ hQ
          have hright : s.equiv (r.equiv (some i)) =
              (⟨none, some (Sum.inl ⟨j, hR⟩)⟩ : T.index) :=
            (congrArg s.equiv hr).trans
              (congrArg (fun k => (⟨none, some k⟩ : T.index)) hu)
          exact hleft.trans hright.symm
        · let j : (iterationRemainingInputs g).index := ⟨g.equiv i, hQ⟩
          have ha : a.equiv (some i) = ⟨none, some j⟩ := partialMarked_position_old O x d g i hQ
          have hn : n.equiv ⟨none, some j⟩ = ⟨none, some j⟩ :=
            iterationNormalization_position_remaining O x d g j
          have hleft : f.equiv (n.equiv (a.equiv (some i))) =
              (⟨none, some (Sum.inr j)⟩ : T.index) :=
            (congrArg (fun k => f.equiv (n.equiv k)) ha).trans ((congrArg f.equiv hn).trans rfl)
          have hr : r.equiv (some i) = ⟨none, some ⟨i, hP⟩⟩ :=
            markedContraction_position_old O x d P i hP
          have hu := iterationContracted_position_old g ⟨i, hP⟩ hQ
          have hright : s.equiv (r.equiv (some i)) =
              (⟨none, some (Sum.inr j)⟩ : T.index) :=
            (congrArg s.equiv hr).trans
              (congrArg (fun k => (⟨none, some k⟩ : T.index)) hu)
          exact hleft.trans hright.symm


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
