section AttachmentSource040


/-!
## Actual original coefficient contractions with arbitrary mixed retained inputs
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationMixedFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationMixedTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationMixedProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Normalize and contract the original coefficient/X family while retaining
the actual arbitrary finite family L of surviving inputs. -/
def coefficientContractionTensor (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W)
    (L : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested (constantInputFamily E.toCollection X P Q) L)) ⟶
        (coefficientLeafTensorFunctor L).obj (E.toCollection.obj P) :=
  coefficientLeavesNormalization (constantInputFamily E.toCollection X P Q) L ≫
    (coefficientLeafTensorFunctor L).map (deletedCoefficientContraction E a P Q)

/-- The actual original weighted contraction is exactly this tensor map
at its original all-X′ survivor family. -/
theorem coefficientContractionTensor_original (E : ColoredOperadObj W C) {X : W → C}
    (Xprime : W → C) (a : freeAlgebra E X ⟶ initialAlgebra E)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    coefficientContractionTensor E a P Q (profileLeafFamily Xprime P) =
      deletedWeightedContraction E Xprime a P Q := rfl

/-- Original coefficient/profile/input bijections and arbitrary heterogeneous
retained-leaf maps commute with the unchanged original attaching contraction. -/
theorem coefficientContractionTensor_joint (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) {P P' : ColoredProfile W}
    (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {L L' : FiniteFamily C} (l : L ⟶ L') :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (contractionInputMap E.toCollection X f g) l)) ≫
        coefficientContractionTensor E a P' Q' L' =
      coefficientContractionTensor E a P Q L ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (E.toCollection.map f) l) :=
  TensorNormalization.coefficientNormalizationSquare _ _ _ _ _ (deletedCoefficientContraction_joint E a f g)

/-- Promoting actual retained X inputs to X′ commutes with the original
contraction of the other X inputs. No retained leaf is discarded. -/
theorem coefficientContractionTensor_leaves (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W)
    {L L' : FiniteFamily C} (l : L ⟶ L') :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (𝟙 (constantInputFamily E.toCollection X P Q)) l)) ≫
        coefficientContractionTensor E a P Q L' =
      coefficientContractionTensor E a P Q L ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 (E.toCollection.obj P)) l) :=
  TensorNormalization.coefficientNormalizationLeaves _ l

/-- The original disjoint attaching-value contraction association law remains
true on the complete weighted source with arbitrary mixed retained inputs. -/
theorem attachingContractions_weighted_assoc (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W)
    (Q1 Q2 : ColoredInputs W) (L : FiniteFamily C) :
    coefficientLeavesNormalization
        ((FiniteFamily.flatten (C := C)).obj (sequentialInputGrouping E.toCollection X P Q1 Q2)) L ≫
      (coefficientLeafTensorFunctor L).map (sequentialInputContraction E a P Q1 Q2) =
    coefficientLeavesNormalization
        ((FiniteFamily.flatten (C := C)).obj (sequentialInputGrouping E.toCollection X P Q1 Q2)) L ≫
      (coefficientLeafTensorFunctor L).map (simultaneousInputContraction E a P Q1 Q2) :=
  congrArg (fun f => coefficientLeavesNormalization
    ((FiniteFamily.flatten (C := C)).obj (sequentialInputGrouping E.toCollection X P Q1 Q2)) L ≫
      (coefficientLeafTensorFunctor L).map f) (sequentialInputContraction_eq_simultaneous E a P Q1 Q2)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource040


section AttachmentSource041


/-!
## Original partial contraction retaining the genuine mixed residual face
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc}

/-- The original source coordinate and original color map identify a retained
input with its same original position in the mixed residual profile. -/
theorem retainedMarkEq {P Q : MarkedInputs W} (g : P ⟶ Q) (i : P.index)
    (hi : SelectedInput Q (g.equiv i)) :
    P.obj i = (residualMarkedInputs g).obj ⟨g.equiv i, hi⟩ :=
  Prod.ext (congrArg (fun j => (P.obj j).1) (g.equiv.symm_apply_apply i)).symm
    (congrArg Discrete.mk (Discrete.eq_of_hom (g.hom i).2))

variable {C : Type u} [Category.{v} C]

/-- The actual finite family of retained mixed X/X′ inputs. -/
def residualLeafFamily {X Xprime : W → C} (x : X ⟶ Xprime)
    {P Q : MarkedInputs W} (g : P ⟶ Q) : FiniteFamily C :=
  (FiniteFamily.map (markedInputCarrier x)).obj (residualMarkedInputs g)

/-- The exact normalized original coefficient/X/mixed-retained input family. -/
def partialMarkedFactors (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
    (constantInputFamily O X (survivingProfile d Q) (contractedInputs Q)) (residualLeafFamily x g))

/-- The same original Option/Sigma partition keeps precisely the target
survivors and contracts precisely its original X positions. -/
def partialMarkedIndexEquiv (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    Option P.index ≃ (partialMarkedFactors O x d g).index :=
  (Equiv.optionCongr g.equiv).trans ((contractionInputEquiv Q).trans
    (Equiv.sigmaCongrRight (fun i => by cases i <;> exact Equiv.refl _)))

/-- The literal original attaching X input retains its original target color. -/
theorem partialOldCarrierEq {X Xprime : W → C} (x : X ⟶ Xprime)
    {P Q : MarkedInputs W} (g : P ⟶ Q) (i : P.index)
    (hi : ¬ SelectedInput Q (g.equiv i)) :
    (markedInputCarrier x).obj (P.obj i) = X (Q.obj (g.equiv i)).2.as := by
  have hiP : ¬ SelectedInput P i := fun h => hi (markedHom_selected g i h)
  exact (markedCarrier_old x (P.obj i).1 hiP (P.obj i).2.as).trans
    (congrArg X (Discrete.eq_of_hom (g.hom i).2))

/-- The original marked source is merely regrouped by its actual input
bijection and target survivor partition. The root uses the original profile
map and selection inverse; retained leaves use the original color map. -/
def partialMarkedFactorsIso (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    markedSourceFactors O x d P ≅ partialMarkedFactors O x d g := by
  let k : (Σ i : Option (survivingInputs Q).index,
      match i with | none => Option (contractedInputs Q).index | some _ => PUnit) ≃
      (partialMarkedFactors O x d g).index :=
    Equiv.sigmaCongrRight (fun i => by cases i <;> exact Equiv.refl _)
  refine FiniteFamily.isoOfComponents
    (X := markedSourceFactors O x d P) (Y := partialMarkedFactors O x d g)
    (partialMarkedIndexEquiv O x d g) (fun i => ?_)
  cases i with
  | none =>
      exact O.mapIso (asIso ((markedProfileFunctor d).map g)) ≪≫
        (O.mapIso (asIso (selectionRootHom d Q))).symm
  | some i =>
      by_cases hi : SelectedInput Q (g.equiv i)
      · have hpos : contractionInputEquiv Q (some (g.equiv i)) =
            ⟨some ⟨g.equiv i, hi⟩, PUnit.unit⟩ := by
          change (if h : SelectedInput Q (g.equiv i) then _ else _) = _
          exact dite_eq_left hi
        change (markedInputCarrier x).obj (P.obj i) ≅
          (partialMarkedFactors O x d g).obj (k (contractionInputEquiv Q (some (g.equiv i))))
        rw [hpos]
        exact (markedInputCarrier x).mapIso (eqToIso (retainedMarkEq g i hi))
      · have hpos : contractionInputEquiv Q (some (g.equiv i)) =
            ⟨none, some ⟨g.equiv i, hi⟩⟩ := by
          change (if h : SelectedInput Q (g.equiv i) then _ else _) = _
          exact dite_eq_right hi
        change (markedInputCarrier x).obj (P.obj i) ≅
          (partialMarkedFactors O x d g).obj (k (contractionInputEquiv Q (some (g.equiv i))))
        rw [hpos]
        exact eqToIso (partialOldCarrierEq x g i hi)

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationPartialFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationPartialTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationPartialProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Contract the original inputs that remain at X in the target face,
retaining every actual X/X′ input of its genuine smaller residual face. -/
def partialMarkedContraction (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedTensorDiagram E x d).obj P ⟶
      (markedTensorDiagram E x d).obj (residualMarkedInputs g) :=
  (FiniteTensor.tensor (V := C)).map (partialMarkedFactorsIso E.toCollection x d g).hom ≫
    coefficientContractionTensor E a (survivingProfile d Q) (contractedInputs Q) (residualLeafFamily x g)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource041


section AttachmentSource042


/-!
## Exact original source for successive residual and remaining-old contractions
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc}

/-- The surviving profile for the residual marking of a marked-input morphism. -/
def iterationProfile (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) : ColoredProfile W :=
  survivingProfile d (residualMarkedInputs g)

/-- The old inputs contracted in the residual stage of a marked-input morphism. -/
def iterationOldInputs {P Q : MarkedInputs W} (g : P ⟶ Q) : ColoredInputs W :=
  contractedInputs (residualMarkedInputs g)

/-- The old inputs still contracted at the target of a marked-input morphism. -/
def iterationRemainingInputs {P Q : MarkedInputs W} (_g : P ⟶ Q) : ColoredInputs W := contractedInputs Q

/-- The original residual root selection maps the genuine target survivors
to the original disjoint residual-survivor and residual-old profile. -/
def iterationRootHom (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    survivingProfile d Q ⟶ extendProfile (iterationProfile d g) (iterationOldInputs g) :=
  (asIso (selectionRootHom d (residualMarkedInputs g))).inv

variable {C : Type u} [Category.{v} C]

/-- The coefficient and remaining old-input factors after separating two contraction stages. -/
def iterationCoefficientInputs (O : ColoredSymmetricCollection W C) (X : W → C)
    (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) : FiniteFamily C :=
  constantInputFamily O X (extendProfile (iterationProfile d g) (iterationOldInputs g)) (iterationRemainingInputs g)

/-- The common flattened factors for successive contraction of a marked-input morphism. -/
def iterationCommonFactors (O : ColoredSymmetricCollection W C) (X Xprime : W → C)
    (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
    ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
      (iterationCoefficientInputs O X d g) (iterationOldLeaves X (residualMarkedInputs g))))
    (iterationSurvivorLeaves Xprime d (residualMarkedInputs g)))

/-- The original residual root map and actual old/survivor leaf bijection
identify the first partial contraction with its exact iterated tensor source. -/
def iterationNormalizationMap (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    partialMarkedFactors O x d g ⟶
      (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
        (iterationCoefficientInputs O X d g)
        (LeafFusion.leafSum (iterationOldLeaves X (residualMarkedInputs g))
          (iterationSurvivorLeaves Xprime d (residualMarkedInputs g)))) :=
  (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (contractionInputMap O X (iterationRootHom d g) (𝟙 (iterationRemainingInputs g)))
    (iterationLeafIso x d (residualMarkedInputs g)).hom)

/-- The actual original source map into the complete original Q2/Q1/variable
tensor source retains the partial source, root selection and exact raw leaf frame. -/
def iterationCommonSourceMap (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    markedSourceFactors O x d P ⟶ iterationCommonFactors O X Xprime d g :=
  (partialMarkedFactorsIso O x d g).hom ≫ iterationNormalizationMap O x d g ≫
    (LeafFusion.rawIso (iterationCoefficientInputs O X d g)
      (iterationOldLeaves X (residualMarkedInputs g))
      (iterationSurvivorLeaves Xprime d (residualMarkedInputs g))).inv


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource042


section AttachmentSource043


/-!
## Actual original old-input partition into promoted residual and remaining-old positions
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc}

/-- Split the contracted source inputs into residual-stage inputs and target old inputs. -/
def iterationContractedEquiv {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (contractedInputs P).index ≃ (iterationOldInputs g).index ⊕ (iterationRemainingInputs g).index where
  toFun i := if hi : SelectedInput Q (g.equiv i.1) then
      Sum.inl ⟨⟨g.equiv i.1, hi⟩, fun h => i.2
        ((congrArg (SelectedInput P) (g.equiv.symm_apply_apply i.1)).mp h)⟩
    else Sum.inr ⟨g.equiv i.1, hi⟩
  invFun i := match i with
    | Sum.inl i => ⟨g.equiv.symm i.1.1, i.2⟩
    | Sum.inr i => ⟨g.equiv.symm i.1, markedHom_old g i.1 i.2⟩
  left_inv i := by
    by_cases hi : SelectedInput Q (g.equiv i.1)
    · simp only [dite_eq_left hi]
      exact Subtype.ext (g.equiv.symm_apply_apply i.1)
    · simp only [dite_eq_right hi]
      exact Subtype.ext (g.equiv.symm_apply_apply i.1)
  right_inv i := by
    cases i with
    | inl i =>
        have hi : SelectedInput Q (g.equiv (g.equiv.symm i.1.1)) :=
          (congrArg (SelectedInput Q) (g.equiv.apply_symm_apply i.1.1)).symm.mp i.1.2
        simp only [dite_eq_left hi]
        apply congrArg Sum.inl
        apply Subtype.ext
        apply Subtype.ext
        exact g.equiv.apply_symm_apply i.1.1
    | inr i =>
        have hi : ¬ SelectedInput Q (g.equiv (g.equiv.symm i.1)) :=
          (congrArg (fun j => ¬ SelectedInput Q j) (g.equiv.apply_symm_apply i.1)).symm.mp i.2
        simp only [dite_eq_right hi]
        exact congrArg Sum.inr (Subtype.ext (g.equiv.apply_symm_apply i.1))

theorem iterationContractedEquiv_color {P Q : MarkedInputs W} (g : P ⟶ Q)
    (i : (contractedInputs P).index) :
    ((contractedInputs P).obj i).as =
      ((DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)).obj
        (iterationContractedEquiv g i)).as := by
  by_cases hi : SelectedInput Q (g.equiv i.1)
  · let j : (iterationOldInputs g).index :=
      ⟨⟨g.equiv i.1, hi⟩, fun h => i.2 ((congrArg (SelectedInput P) (g.equiv.symm_apply_apply i.1)).mp h)⟩
    have hp : iterationContractedEquiv g i = Sum.inl j := by
      change (if h : SelectedInput Q (g.equiv i.1) then _ else _) = Sum.inl j
      exact dite_eq_left hi
    have hc : ((DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)).obj
        (iterationContractedEquiv g i)).as = (Q.obj (g.equiv i.1)).2.as :=
      (congrArg (fun j => ((DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)).obj j).as)
        hp).trans rfl
    exact (Discrete.eq_of_hom (g.hom i.1).2).trans hc.symm
  · let j : (iterationRemainingInputs g).index := ⟨g.equiv i.1, hi⟩
    have hp : iterationContractedEquiv g i = Sum.inr j := by
      change (if h : SelectedInput Q (g.equiv i.1) then _ else _) = Sum.inr j
      exact dite_eq_right hi
    have hc : ((DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)).obj
        (iterationContractedEquiv g i)).as = (Q.obj (g.equiv i.1)).2.as :=
      (congrArg (fun j => ((DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)).obj j).as)
        hp).trans rfl
    exact (Discrete.eq_of_hom (g.hom i.1).2).trans hc.symm

/-- The actual original contracted input family is the original disjoint sum
of residual old and remaining old inputs, retaining each actual original color map. -/
def iterationContractedInputsIso {P Q : MarkedInputs W} (g : P ⟶ Q) :
    contractedInputs P ≅ DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g) :=
  FiniteFamily.isoOfComponents (iterationContractedEquiv g)
    (fun i => eqToIso (congrArg Discrete.mk (iterationContractedEquiv_color g i)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
