section AttachmentSource135


/-!
## Descent through every original bounded-stage relation
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping EndpointRelations

private theorem AttachmentSource135_legPost {V : Type*} [Category* V] {A B K Y U Z : V}
    (f : A ⟶ B) (k : B ⟶ K) (l : K ⟶ Y) (q : Y ⟶ Z)
    (g : K ⟶ U) (h : U ⟶ Z) (i : B ⟶ U)
    (hl : l ≫ q = g ≫ h) (hk : k ≫ g = i) :
    (f ≫ k ≫ l) ≫ q = f ≫ i ≫ h := by
  simp only [Category.assoc]
  exact congrArg (f ≫ ·) ((congrArg (k ≫ ·) hl).trans
    ((Category.assoc k g h).symm.trans (congrArg (· ≫ h) hk)))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationOmegaDescentDataFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationOmegaDescentDataSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationOmegaDescentDataProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationOmegaDescentDataFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationOmegaDescentDataFaces (N : ℕ) : HasColimitsOfShape (Discrete (BoundedFace W N)) C :=
  HasColimitsOfShape.of_essentiallySmall C _
local instance continuationOmegaDescentDataDegree (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- An arbitrary test cofork of the original free relation pair receives all
the original bounded degree cofactors. This is the universal-property test,
not data used to construct the stages. -/
def coforkProfilesDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stageProfiles E x d N ⟶ s.pt :=
  Limits.Sigma.desc (fun i : Fin (N + 1) => degreeFreeMap E x d i.val ≫ s.π)

@[reassoc (attr := simp)]
theorem stageDegreeι_coforkProfilesDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N j : ℕ) (hj : j ≤ N)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stageDegreeι E x d N j hj ≫ coforkProfilesDesc E x a d N s = degreeFreeMap E x d j ≫ s.π :=
  Limits.Sigma.ι_comp_desc _ _

/-- The original marked relation in each arbitrary test cofork follows from
the full original free classifier betas. -/
theorem markedCofork_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) (P : MarkedInputs W) :
    normalizedMarkedFaceContraction E x a d P ≫
        profileι E.toCollection Xprime (profileInputs (survivingProfile d P)) ≫ s.π =
      (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P) ≫
        (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
          profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj P)) ≫ s.π := by
  let c := mixedCofan E x d P
  let L := (relationLeft E (Xprime := Xprime) a).hom d
  let R := (relationRight E x).hom d
  let n := normalizedMarkedFaceContraction E x a d P
  let t := (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P)
  let p := (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom
  let i := profileι E.toCollection Xprime (profileInputs (survivingProfile d P))
  let j := profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj P))
  have h := congrArg (c ≫ ·) s.condition
  have hl := congrArg (· ≫ s.π) (mixedCofan_relationLeft E x a d P)
  have hr := congrArg (· ≫ s.π) (mixedCofan_relationRight E x d P)
  have he : (n ≫ i) ≫ s.π = (t ≫ p ≫ j) ≫ s.π :=
    hl.symm.trans ((Category.assoc c L s.π).trans
      (h.trans ((Category.assoc c R s.π).symm.trans hr)))
  exact (Category.assoc n i s.π).symm.trans
    (he.trans ((Category.assoc t (p ≫ j) s.π).trans
      (congrArg (t ≫ ·) (Category.assoc p j s.π))))

/-- Every actual original bounded proper-face relation is preserved by the
test cofork map; no bounded-stage compatibility is supplied as an input. -/
theorem coforkProfilesDesc_relations (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stageRelationLeft E x a d N ≫ coforkProfilesDesc E x a d N s =
      stageRelationRight E x d N ≫ coforkProfilesDesc E x a d N s := by
  apply Limits.Sigma.hom_ext
  intro c
  let P := (degreeMarkedInclusion (W := W) c.degree).obj c.word
  let S := survivingProfile d P
  let F := (markedProfileFunctor d).obj P
  let n := normalizedMarkedFaceContraction E x a d P
  let k := profileDegreeSummandCofan E x S
  let α := stageDegreeι E x d N (inputCount S) ((c.survivor_lt d).le.trans c.bound)
  let t := (degreeToTop E x d c.degree).app c.word
  let i := colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word
  let β := stageDegreeι E x d N c.degree c.bound
  let j := Limits.Sigma.ι (fun c : BoundedFace W N => boundedFaceSource E x d c) c
  let L := stageRelationLeft E x a d N
  let R := stageRelationRight E x d N
  let q := coforkProfilesDesc E x a d N s
  let u := degreeFreeMap E x d (inputCount S)
  let v := degreeFreeMap E x d c.degree
  let p := (topOperationTensorIso E x F).hom
  let ιS := profileι E.toCollection Xprime (profileInputs S)
  let ιF := profileι E.toCollection Xprime (profileInputs F)
  have hL : j ≫ L = n ≫ k ≫ α := Limits.Sigma.ι_comp_desc _ _
  have hR : j ≫ R = t ≫ i ≫ β := Limits.Sigma.ι_comp_desc _ _
  have hα : α ≫ q = u ≫ s.π := stageDegreeι_coforkProfilesDesc E x a d N (inputCount S) _ s
  have hβ : β ≫ q = v ≫ s.π := stageDegreeι_coforkProfilesDesc E x a d N c.degree c.bound s
  have hk : k ≫ u = ιS := degreeFreeMap_profile E x S
  have hi : i ≫ v = p ≫ ιF := degreeFreeMap_ι E x d c.degree c.word
  have hl : j ≫ L ≫ q = n ≫ ιS ≫ s.π :=
    (Category.assoc j L q).symm.trans
      ((congrArg (· ≫ q) hL).trans (AttachmentSource135_legPost n k α q u s.π ιS hα hk))
  have hr : j ≫ R ≫ q = t ≫ p ≫ ιF ≫ s.π := by
    have hh := (Category.assoc j R q).symm.trans
      ((congrArg (· ≫ q) hR).trans (AttachmentSource135_legPost t i β q v s.π (p ≫ ιF) hβ hi))
    exact hh.trans (congrArg (t ≫ ·) (Category.assoc p ιF s.π))
  exact hl.trans ((markedCofork_relation E x a d s P).trans hr.symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource135


section AttachmentSource136


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource136_cofanPost {V : Type*} [Category* V] {A B K Y Z : V}
    (p : A ⟶ B) (l : B ⟶ K) (q : A ⟶ Y) (b : Y ⟶ K) (i : K ⟶ Z)
    (w : B ⟶ Z) (hc : p ≫ l = q ≫ b) (hl : l ≫ i = w) :
    q ≫ b ≫ i = p ≫ w :=
  (Category.assoc q b i).symm.trans
    ((congrArg (· ≫ i) hc.symm).trans
      ((Category.assoc p l i).trans (congrArg (p ≫ ·) hl)))

private theorem AttachmentSource136_factorExt {V : Type*} [Category* V] {A B K Y Z T : V}
    (q : A ⟶ Y) (b : Y ⟶ K) (i : K ⟶ Z) (p : A ⟶ B) (w : B ⟶ Z)
    (f g : Z ⟶ T) (hc : q ≫ b ≫ i = p ≫ w) (h : w ≫ f = w ≫ g) :
    q ≫ b ≫ i ≫ f = q ≫ b ≫ i ≫ g := by
  have hh := (congrArg (· ≫ f) hc).trans
    ((Category.assoc p w f).trans
      ((congrArg (p ≫ ·) h).trans
        ((Category.assoc p w g).symm.trans (congrArg (· ≫ g) hc).symm)))
  simpa only [Category.assoc] using hh

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationOmegaDensityFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationOmegaDensitySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationOmegaDensityProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationOmegaDensityFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationOmegaDensityDegree (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The original operation cofactors jointly determine every map from the
actual constructed countable carrier, by the actual degree and stage colimits. -/
theorem omegaProfileCofan_hom_ext (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) {Z : C}
    {f g : stageEndpoint E x a d ⟶ Z}
    (h : ∀ P : AnalyticIndex W d,
      omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) ≫ f =
        omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) ≫ g) : f = g := by
  apply colimit.hom_ext
  intro N
  apply stage_hom_ext E x a d N
  intro j hj
  apply colimit.hom_ext
  intro P
  let F := (markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) j).obj P)
  let hF : inputCount F ≤ N := (degreeProfile_count d j P).symm ▸ hj
  let p := (topOperationTensorIso E x F).hom
  let l := stageProfileLeg E x a N F hF
  let q := colimit.ι (degreeTopTensorDiagram E x d j) P
  let b := stageDegreeLeg E x a d N j hj
  let i := stageι E x a d N
  let w := omegaProfileCofan E x a F
  have hc : p ≫ l = q ≫ b := canonicalProfileStageCofan E x a d N j P hj
  have hl : l ≫ i = w := omegaProfileCofan_atStage E x a N F hF
  have hw : w ≫ f = w ≫ g := h (profileInputs F)
  exact AttachmentSource136_factorExt q b i p w f g (AttachmentSource136_cofanPost p l q b i w hc hl) hw

/-- The original free carrier maps onto the constructed countable carrier;
this follows from original operation cofan density rather than an assumption. -/
instance omegaFreeMapEpi (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Epi (omegaFreeMap E x a d) where
  left_cancellation f g h := by
    apply omegaProfileCofan_hom_ext E x a d
    intro P
    let p := profileι E.toCollection Xprime P
    let m := omegaFreeMap E x a d
    let w := omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P)
    have hm : p ≫ m = w := omegaFreeMap_profile E x a d P
    exact (congrArg (· ≫ f) hm.symm).trans
      ((Category.assoc p m f).trans
        ((congrArg (p ≫ ·) h).trans
          ((Category.assoc p m g).symm.trans (congrArg (· ≫ g) hm))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource136


section AttachmentSource137


/-!
## The genuine coequalizer universal property of the constructed countable carrier
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationOmegaDescentFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationOmegaDescentSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationOmegaDescentProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationOmegaDescentFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The original bounded-stage coequalizer supplies the unique map into each
test cofork of the original free pair, using all its actual proper faces. -/
def stageCoforkDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stage E x a d N ⟶ s.pt :=
  coequalizer.desc (coforkProfilesDesc E x a d N s) (coforkProfilesDesc_relations E x a d N s)

@[reassoc (attr := simp)]
theorem stageCoforkDesc_degree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N j : ℕ) (hj : j ≤ N)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stageDegreeLeg E x a d N j hj ≫ stageCoforkDesc E x a d N s = degreeFreeMap E x d j ≫ s.π := by
  let i := stageDegreeι E x d N j hj
  let L := stageRelationLeft E x a d N
  let R := stageRelationRight E x d N
  let q := stageCoforkDesc E x a d N s
  exact (Category.assoc i (coequalizer.π L R) q).trans
    ((congrArg (i ≫ ·) (coequalizer.π_desc _ _)).trans (stageDegreeι_coforkProfilesDesc E x a d N j hj s))

@[reassoc (attr := simp)]
theorem stageCoforkDesc_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) (P : AnalyticIndex W d)
    (hP : inputCount ((analyticToProfileFunctor W d).obj P) ≤ N) :
    stageProfileLeg E x a N ((analyticToProfileFunctor W d).obj P) hP ≫ stageCoforkDesc E x a d N s =
      profileι E.toCollection Xprime P ≫ s.π := by
  let F := (analyticToProfileFunctor W d).obj P
  let j := profileDegreeSummandCofan E x F
  let l := stageDegreeLeg E x a d N (inputCount F) hP
  let q := stageCoforkDesc E x a d N s
  let m := degreeFreeMap E x d (inputCount F)
  exact (Category.assoc j l q).trans
    ((congrArg (j ≫ ·) (stageCoforkDesc_degree E x a d N (inputCount F) hP s)).trans
      ((Category.assoc j m s.π).symm.trans (congrArg (· ≫ s.π) (degreeFreeMap_profile E x F))))

theorem stageCoforkDesc_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stageMap E x a d h ≫ stageCoforkDesc E x a d M s = stageCoforkDesc E x a d N s := by
  apply stage_hom_ext E x a d N
  intro j hj
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ stageCoforkDesc E x a d M s) (stageDegreeLeg_map E x a d h j hj)).trans
      ((stageCoforkDesc_degree E x a d M j (hj.trans h) s).trans (stageCoforkDesc_degree E x a d N j hj s).symm))

/-- The stage cocone induced by any cofork of the attachment relations. -/
def omegaCoforkCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) : Cocone (stageDiagram E x a d) where
  pt := s.pt
  ι.app N := stageCoforkDesc E x a d N s
  ι.naturality _N _M f := (stageCoforkDesc_map E x a d (leOfHom f) s).trans (Category.comp_id _).symm

/-- Descend the stage colimit to any cofork of the attachment relations. -/
def omegaCoforkDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) : stageEndpoint E x a d ⟶ s.pt :=
  colimit.desc _ (omegaCoforkCocone E x a d s)

@[reassoc (attr := simp)]
theorem omegaCoforkDesc_ι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    stageι E x a d N ≫ omegaCoforkDesc E x a d s = stageCoforkDesc E x a d N s := colimit.ι_desc _ _

@[reassoc (attr := simp)]
theorem omegaCoforkDesc_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) (P : AnalyticIndex W d) :
    omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) ≫ omegaCoforkDesc E x a d s =
      profileι E.toCollection Xprime P ≫ s.π := by
  let F := (analyticToProfileFunctor W d).obj P
  let N := inputCount F
  let j := stageProfileLeg E x a N F (Nat.le_refl _)
  let i := stageι E x a d N
  let q := omegaCoforkDesc E x a d s
  exact (Category.assoc j i q).trans
    ((congrArg (j ≫ ·) (omegaCoforkDesc_ι E x a d N s)).trans (stageCoforkDesc_profile E x a d N s P (Nat.le_refl _)))

@[reassoc (attr := simp)]
theorem omegaFreeMap_desc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) :
    omegaFreeMap E x a d ≫ omegaCoforkDesc E x a d s = s.π := by
  apply colimit.hom_ext
  intro P
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ omegaCoforkDesc E x a d s) (omegaFreeMap_profile E x a d P)).trans (omegaCoforkDesc_profile E x a d
      s P))

theorem omegaCoforkDesc_unique (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (s : Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d)) (m : stageEndpoint E x a d ⟶ s.pt)
    (hm : omegaFreeMap E x a d ≫ m = s.π) : m = omegaCoforkDesc E x a d s := by
  apply (cancel_epi (omegaFreeMap E x a d)).1
  exact hm.trans (omegaFreeMap_desc E x a d s).symm

/-- The countable carrier is the genuine coequalizer of the original
free-sum relation pair, with its full C-map universal property constructed. -/
def omegaCoforkIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    IsColimit (omegaCofork E x a d) :=
  Cofork.IsColimit.mk (omegaCofork E x a d) (omegaCoforkDesc E x a d)
    (omegaFreeMap_desc E x a d) (omegaCoforkDesc_unique E x a d)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
