section AttachmentSource092


/-!
## Pure original finite-profile cofans into their actual degree colimits
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance continuationRawDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- Evaluate `D` on the fully selected degree-`n` marked inputs. -/
def rawDegreeTopDiagram (D : MarkedInputs W ⥤ C) (n : ℕ) : DegreeMarkedInputs W n ⥤ C :=
  degreeMarkedInclusion (W := W) n ⋙ allTopInputs ⋙ D

/-- The raw original profile cofan retains the actual displayed enumeration
and the actual original degree colimit injection. -/
def rawEnumeratedCofan (D : MarkedInputs W ⥤ C) {n : ℕ}
    (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    D.obj (topMarkedProfile P) ⟶ colimit (rawDegreeTopDiagram D n) :=
  D.map (topEnumerationIsoWith P e).hom ≫
    colimit.ι (rawDegreeTopDiagram D n) (topWordWith P e)

/-- Every original profile permutation commutes with both actual raw cofans;
the statement holds for any original marked-input diagram. -/
theorem rawEnumeratedCofan_naturality (D : MarkedInputs W ⥤ C) {n : ℕ}
    {P Q : ColoredProfile W} (f : P ⟶ Q) (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) :
    D.map (topProfileHom (W := W) (P := P) (Q := Q) f) ≫ rawEnumeratedCofan D Q e' =
      rawEnumeratedCofan D P e := by
  let g := enumeratedDegreeMap (W := W) (P := P) (Q := Q) f e e'
  let k := (degreeMarkedInclusion (W := W) n).map g
  let k' := (allTopInputs (W := W)).map k
  let m := D.map (topProfileHom (W := W) (P := P) (Q := Q) f)
  let a := D.map (topEnumerationIsoWith Q e').hom
  let b := D.map (topEnumerationIsoWith P e).hom
  let V := rawDegreeTopDiagram D n
  let j := colimit.ι V (topWordWith P e)
  let j' := colimit.ι V (topWordWith Q e')
  have hk : k = k' := markedHom_ext rfl
  have hkm : D.map k = V.map g := congrArg D.map hk
  have ha : m ≫ a = b ≫ V.map g :=
    (D.map_comp _ _).symm.trans
      ((congrArg D.map (topEnumerationIsoWith_square (W := W) (P := P) (Q := Q) f e e')).trans
        ((D.map_comp _ _).trans (congrArg (b ≫ ·) hkm)))
  change m ≫ (a ≫ j') = b ≫ j
  exact (Category.assoc m a j').symm.trans
    ((congrArg (· ≫ j') ha).trans
      ((Category.assoc b (V.map g) j').trans (congrArg (b ≫ ·) (colimit.w V g))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource092


section AttachmentSource093


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The fixed-output top map is the literal original coefficient/input
diagram map, on both the coefficient and all original input components. -/
theorem topFactorsMap_fixedOutput (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) {d : W} {P Q : AnalyticIndex W d} (f : P ⟶ Q) :
    topFactorsMap O x ((analyticToProfileFunctor W d).map f) =
      (coefficientInputFactors (markedProfileFunctor d ⋙ O)
        (FiniteFamily.map (markedInputCarrier x))).map
          (topProfileHom (W := W) (P := P.toColoredProfile) (Q := Q.toColoredProfile)
            ((analyticToProfileFunctor W d).map f)) := by
  let f' := (analyticToProfileFunctor W d).map f
  have hp : (markedProfileFunctor d).map
      (topProfileHom (W := W) (P := P.toColoredProfile) (Q := Q.toColoredProfile) f') = f' :=
    ColoredProfile.Hom.ext rfl
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (congrArg O.map hp.symm)
    | some _ => exact HEq.rfl


