section AttachmentSource089


/-!
## Original tensor face promotion commutes with the actual partial contraction
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource089_threeSquares {D : Type*} [Category* D]
    {A A' B B' K K' X X' : D} (m : A ⟶ A') (a : A ⟶ B) (a' : A' ⟶ B')
    (h : B ⟶ B') (c : B ⟶ K) (c' : B' ⟶ K') (z : K ⟶ K')
    (p : K ⟶ X) (p' : K' ⟶ X') (f : X ⟶ X')
    (ha : m ≫ a' = a ≫ h) (hc : h ≫ c' = c ≫ z) (hp : z ≫ p' = p ≫ f) :
    m ≫ (a' ≫ c' ≫ p') = (a ≫ c ≫ p) ≫ f := by
  calc
    m ≫ (a' ≫ c' ≫ p') = (m ≫ a') ≫ c' ≫ p' := (Category.assoc _ _ _).symm
    _ = (a ≫ h) ≫ c' ≫ p' := congrArg (· ≫ c' ≫ p') ha
    _ = a ≫ (h ≫ c') ≫ p' := by simp only [Category.assoc]
    _ = a ≫ (c ≫ z) ≫ p' := congrArg (fun q => a ≫ q ≫ p') hc
    _ = a ≫ c ≫ (z ≫ p') := by simp only [Category.assoc]
    _ = a ≫ c ≫ (p ≫ f) := congrArg (a ≫ c ≫ ·) hp
    _ = (a ≫ c ≫ p) ≫ f := by simp only [Category.assoc]

private theorem AttachmentSource089_fourPost {D : Type*} [Category* D] {A B C E Z : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ Z) :
    (a ≫ b ≫ c) ≫ d = (a ≫ b) ≫ c ≫ d :=
  (congrArg (· ≫ d) (Category.assoc a b c).symm).trans (Category.assoc (a ≫ b) c d)

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationPromotionFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationPromotionTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationPromotionProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The unchanged original face promotion followed by its original contraction
is the actual partial contraction followed by the original retained-coordinate
promotion and original top operation comparison. -/
theorem partialMarkedContraction_promote (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedTensorDiagram E x d).map g ≫ normalizedMarkedFaceContraction E x a d Q =
      partialMarkedContraction E x a d g ≫
        (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app (residualMarkedInputs g)) ≫
          (topOperationTensorIso E x (survivingProfile d Q)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let S := survivingProfile d Q
  let K := contractedInputs Q
  let L := residualLeafFamily x g
  let L' := profileLeafFamily Xprime S
  let l := residualLeafTopMap x d g
  let r := T.map (partialMarkedFactorsIso E.toCollection x d g).hom
  let r' := T.map (markedContractionFactorsIso E.toCollection x d Q).hom
  let h := T.map (partialPromotionFactorsMap E.toCollection x d g)
  let c := coefficientContractionTensor E a S K L
  let c' := coefficientContractionTensor E a S K L'
  let z := T.map (coefficientLeafMap (𝟙 (E.toCollection.obj S)) l)
  let p := (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app (residualMarkedInputs g))
  let p' := (profileCoefficientLeafTensorIso E.toCollection Xprime S).hom
  let f := (topOperationTensorIso E x S).hom
  let m := (markedTensorDiagram E x d).map g
  have hr : m ≫ r' = r ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (partialPromotionFactors_square E.toCollection x d g)).trans (T.map_comp _ _))
  have hc : h ≫ c' = c ≫ z := coefficientContractionTensor_leaves E a S K l
  have hp : z ≫ p' = p ≫ f := residualLeafTopMap_tensor E x d g
  have he := AttachmentSource089_threeSquares m r r' h c c' z p p' f hr hc hp
  simpa only [partialMarkedContraction, normalizedMarkedFaceContraction_deleted,
    coefficientContractionTensor_original, m, r, r', h, c, c', z, p, p', f, S, K, L, L', l, T]
      using! he.trans (AttachmentSource089_fourPost r c p f)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource089


section AttachmentSource090


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationResetFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationResetDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The original degree top cofan depends on the actual original color word;
resetting only its redundant coordinate labels keeps the exact same cofan. -/
theorem degreeTopCofan_reset (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (P : DegreeMarkedInputs W n) :
    colimit.ι (degreeTopTensorDiagram E x d n)
        ((pureToMarked (W := W) n).obj ((forgetDegreeMarks (W := W) n).obj P)) =
      colimit.ι (degreeTopTensorDiagram E x d n) P := by
  let T := degreeTopTensorDiagram E x d n
  let q := (degreeToPureTop (W := W) n).app P
  have hmap : T.map q = 𝟙 (T.obj P) :=
    (degreeTopPureMap E x d n q).trans
      ((congrArg (pureDegreeTensorDiagram E x d n).map (forgetDegree_toPureTop n P)).trans
        ((pureDegreeTensorDiagram E x d n).map_id _))
  exact (Category.id_comp _).symm.trans
    ((congrArg (· ≫ colimit.ι T ((pureToMarked (W := W) n).obj ((forgetDegreeMarks (W := W) n).obj P))) hmap).symm.trans
      (colimit.w T q))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

