section AttachmentSource128


/-!
## Genuine target evaluation of the actual weighted attaching contraction
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance contractionEvaluationFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance contractionEvaluationTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance contractionEvaluationProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The literal original attaching nullary coefficients enter the actual
frozen target-algebra coefficient frame, with every retained variable fixed. -/
def contractionFrozenMap (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (M : Algebra E)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
        (constantInputFamily E.toCollection X P Q) (profileLeafFamily M.carrier P)) ⟶
      FrozenAlgebra.raw E.toCollection M.carrier P Q :=
  (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (constantInputCoefficientMap E a P Q) (𝟙 (profileLeafFamily M.carrier P)))

/-- The literal original coefficient contraction uses the same actual
nullary substitution and original empty-input deletion as the genuine
frozen algebra evaluator. -/
theorem deletedCoefficient_frozen (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    deletedCoefficientContraction E a P Q =
      (FiniteTensor.tensor (V := C)).map (constantInputCoefficientMap E a P Q) ≫
        (frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫
          E.toCollection.map (Linear.Constants.totalProfileHom P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let k := constantInputCoefficientMap E a P Q
  let f := frozenPartialSubstitution E P Q (constantBranches Q)
  let h := E.toCollection.map (constantInputsDeletionHom P Q)
  have hh : h = E.toCollection.map (Linear.Constants.totalProfileHom P Q) :=
    congrArg E.toCollection.map (nullaryTotalDeletion P Q)
  exact (Category.assoc (T.map k) f h).trans
    (congrArg (T.map k ≫ ·) (congrArg (f ≫ ·) hh))

/-- The actual weighted old-input contraction evaluated in any genuine
original target algebra is the original operation with the original
attaching nullary values in exactly the original old input positions. -/
theorem rawContraction_evaluation (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (M : Algebra E)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    coefficientContractionTensor E a P Q (profileLeafFamily M.carrier P) ≫
        (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
          M.operations.app P.outputColor (profileInputs P) =
      (FiniteTensor.tensor (V := C)).map (contractionFrozenMap E a M P Q) ≫
        (FiniteTensor.tensor (V := C)).map (FrozenAlgebra.evaluatedFactors E M P Q) ≫
          M.operations.app P.outputColor (profileInputs (extendProfile P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let L := profileLeafFamily M.carrier P
  let K := constantInputFamily E.toCollection X P Q
  let K' := FrozenAlgebra.coefficients E.toCollection P Q
  let k := constantInputCoefficientMap E a P Q
  let n := coefficientLeavesNormalization K L
  let n' := coefficientLeavesNormalization K' L
  let b := T.map (contractionFrozenMap E a M P Q)
  let q := coefficientLeafTensorFunctor L
  let δ := frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫
    E.toCollection.map (Linear.Constants.totalProfileHom P Q)
  let u := q.map (T.map k)
  let v := q.map δ
  let i := (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom
  let o := M.operations.app P.outputColor (profileInputs P)
  have hq : q.map (deletedCoefficientContraction E a P Q) = u ≫ v :=
    (congrArg q.map (deletedCoefficient_frozen E a P Q)).trans (q.map_comp _ _)
  have hu : T.map (coefficientLeafMap (T.map k) (𝟙 L)) = u :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map k) L)
  have hn : b ≫ n' = n ≫ u :=
    (coefficientLeavesNormalization_naturality k (𝟙 L)).trans (congrArg (n ≫ ·) hu)
  have he : n' ≫ v ≫ i ≫ o = T.map (FrozenAlgebra.evaluatedFactors E M P Q) ≫
      M.operations.app P.outputColor (profileInputs (extendProfile P Q)) :=
    FrozenAlgebra.partial_evaluation E M P Q
  exact (Category.assoc n (q.map (deletedCoefficientContraction E a P Q)) (i ≫ o)).trans
    ((congrArg (fun z => n ≫ z ≫ i ≫ o) hq).trans
      ((congrArg (n ≫ ·) (Category.assoc u v (i ≫ o))).trans
        ((Category.assoc n u (v ≫ i ≫ o)).symm.trans
          ((congrArg (fun z => z ≫ v ≫ i ≫ o) hn.symm).trans
            ((Category.assoc b n' (v ≫ i ≫ o)).trans (congrArg (b ≫ ·) he))))))

/-- The literal original marked contraction is its genuine original weighted
coefficient contraction followed by the original survivor-profile comparison. -/
theorem markedContraction_CCT (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    normalizedMarkedFaceContraction E x a d P =
      (FiniteTensor.tensor (V := C)).map (markedContractionFactorsIso E.toCollection x d P).hom ≫
        coefficientContractionTensor E a (survivingProfile d P) (contractedInputs P)
          (profileLeafFamily Xprime (survivingProfile d P)) ≫
            (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d P)).hom :=
  (normalizedMarkedFaceContraction_deleted E x a d P).trans
    (congrArg (fun c => (FiniteTensor.tensor (V := C)).map (markedContractionFactorsIso E.toCollection x d P).hom ≫
      c ≫ (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d P)).hom)
      (coefficientContractionTensor_original E Xprime a (survivingProfile d P) (contractedInputs P)).symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource128


section AttachmentSource129


/-!
## The original marked left-relation factors in the genuine frozen algebra frame
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping Continuation

attribute [local instance] FintypeCat.fintype

private theorem AttachmentSource129_leftFactorDependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance leftFactorsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance leftFactorsTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance leftFactorsProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance leftFactorsBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)

/-- The original marked source is regrouped into its original survivor/old
family, using original attaching nullary coefficients and original new free
generators at precisely those original input positions. -/
def markedFrozenMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    markedSourceFactors E.toCollection x d P ⟶
      FrozenAlgebra.raw E.toCollection (freeAlgebra E Xprime).carrier
        (survivingProfile d P) (contractedInputs P) :=
  (markedContractionFactorsIso E.toCollection x d P).hom ≫
    (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
      (constantInputCoefficientMap E a (survivingProfile d P) (contractedInputs P))
      (carrierLeafMap ((profileUnit E).app Xprime) (survivingProfile d P)))

/-- The entire original marked frozen factor route is the actual original
left-relation classifier route. The original root permutation cancels with
its inverse, original selected inputs use the original free generators, and
every original old input uses its actual original attaching-map image. -/
theorem markedFrozenMap_factors (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    markedFrozenMap E x a d P ≫
        FrozenAlgebra.evaluatedFactors E (freeAlgebra E Xprime) (survivingProfile d P) (contractedInputs P) ≫
          (operationFactorsFunctor E.toCollection (freeAlgebra E Xprime).carrier).map (selectionRootHom d P) =
      mixedFactorsMap E.toCollection x d P ≫
        (analyticFactorsCarrierMap E.toCollection (leftClassifier E a)).app
          (profileInputs ((markedProfileFunctor d).obj P)) := by
  let M := freeAlgebra E Xprime
  let S := survivingProfile d P
  let Q := contractedInputs P
  let η := (profileUnit E).app Xprime
  let α := (markedContractionFactorsIso E.toCollection x d P).hom
  let β := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (constantInputCoefficientMap E a S Q) (carrierLeafMap η S))
  let γ := FrozenAlgebra.evaluatedFactors E M S Q
  let δ := (operationFactorsFunctor E.toCollection M.carrier).map (selectionRootHom d P)
  let B := markedContractionFactors E.toCollection X Xprime d P
  let N := FrozenAlgebra.raw E.toCollection M.carrier S Q
  let V := (analyticFactors E.toCollection M.carrier).obj (profileInputs (extendProfile S Q))
  let T := (operationFactorsFunctor E.toCollection M.carrier).obj ((markedProfileFunctor d).obj P)
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i =>
        by_cases hi : SelectedInput P i
        · have hα : α.equiv (some i) = ⟨some ⟨i, hi⟩, PUnit.unit⟩ :=
            markedContraction_position_top E.toCollection x d P i hi
          exact (congrArg (fun k => δ.equiv (γ.equiv (β.equiv k))) hα).trans rfl
        · have hα : α.equiv (some i) = ⟨none, some ⟨i, hi⟩⟩ :=
            markedContraction_position_old E.toCollection x d P i hi
          exact (congrArg (fun k => δ.equiv (γ.equiv (β.equiv k))) hα).trans rfl
  · intro i
    cases i with
    | none =>
        let e := E.toCollection.mapIso (asIso (selectionRootHom d P))
        have hleft : e.inv ≫ (𝟙 _ ≫ (𝟙 _ ≫ e.hom)) = 𝟙 _ :=
          (congrArg (e.inv ≫ ·) ((Category.id_comp _).trans (Category.id_comp _))).trans e.inv_hom_id
        have hright : (𝟙 (E.toCollection.obj ((markedProfileFunctor d).obj P)) ≫ 𝟙 _) ≫ 𝟙 _ = 𝟙 _ :=
          (congrArg (· ≫ 𝟙 _) (Category.id_comp _)).trans (Category.id_comp _)
        exact heq_of_eq ((Category.assoc e.inv (𝟙 _) (𝟙 _ ≫ e.hom)).trans
          (hleft.trans hright.symm))
    | some i =>
        let r := (P.obj i).2.as
        let m := leftClassifier E (Xprime := Xprime) a r
        let L := (mixedLeafMap x d P).hom i
        by_cases hi : SelectedInput P i
        · let j : S.inputs := ⟨i, hi⟩
          let e := selectedCarrier x P i hi
          have hα : α.equiv (some i) = ⟨some j, PUnit.unit⟩ :=
            markedContraction_position_top E.toCollection x d P i hi
          have hβ : β.equiv (α.equiv (some i)) = (⟨some j, PUnit.unit⟩ : N.index) :=
            (congrArg β.equiv hα).trans rfl
          have hγ : γ.equiv (β.equiv (α.equiv (some i))) =
              (some (Sum.inl j) : V.index) := (congrArg γ.equiv hβ).trans rfl
          have hδ : δ.equiv (γ.equiv (β.equiv (α.equiv (some i)))) = (some i : T.index) :=
            (congrArg δ.equiv hγ).trans rfl
          have hB : B.obj (α.equiv (some i)) = Xprime r := congrArg B.obj hα
          have hN : N.obj (β.equiv (α.equiv (some i))) = M.carrier r := congrArg N.obj hβ
          have hV : V.obj (γ.equiv (β.equiv (α.equiv (some i)))) = M.carrier r := congrArg V.obj hγ
          have hT : T.obj (δ.equiv (γ.equiv (β.equiv (α.equiv (some i))))) = M.carrier r :=
            congrArg T.obj hδ
          have hA : HEq (α.hom (some i)) (eqToHom e) := markedContraction_component_top E.toCollection x d P i hi
          have hβm : HEq (β.hom (α.equiv (some i))) (η r) :=
            (AttachmentSource129_leftFactorDependentApply β.hom hα).trans HEq.rfl
          have hγm : HEq (γ.hom (β.equiv (α.equiv (some i)))) (𝟙 (M.carrier r)) :=
            (AttachmentSource129_leftFactorDependentApply γ.hom hβ).trans HEq.rfl
          have hδm : HEq (δ.hom (γ.equiv (β.equiv (α.equiv (some i))))) (𝟙 (M.carrier r)) :=
            (AttachmentSource129_leftFactorDependentApply δ.hom hγ).trans HEq.rfl
          have hγδ := heq_comp hN hV hT hγm hδm
          have hβγδ := heq_comp hB hN hT hβm hγδ
          have hleft : HEq ((markedFrozenMap E x a d P ≫ γ ≫ δ).hom (some i)) (eqToHom e ≫ η r) :=
            (heq_of_eq (Category.assoc (α.hom (some i)) (β.hom (α.equiv (some i)))
              (γ.hom (β.equiv (α.equiv (some i))) ≫ δ.hom (γ.equiv (β.equiv (α.equiv (some i))))))).trans
            ((heq_comp rfl hB hT hA hβγδ).trans
              (heq_of_eq (congrArg (eqToHom e ≫ ·)
                ((congrArg (η r ≫ ·) (Category.id_comp (𝟙 (M.carrier r)))).trans (Category.comp_id _)))))
          have hL : L = eqToHom e ≫ coprod.inl := dite_eq_left hi
          have hm : (coprod.inl : Xprime r ⟶ colorSum Xprime X r) ≫ m = η r := coprod.inl_desc _ _
          have hright : (L ≫ 𝟙 _) ≫ m = eqToHom e ≫ η r :=
            (congrArg (· ≫ m) (Category.comp_id L)).trans
              ((congrArg (· ≫ m) hL).trans
                ((Category.assoc (eqToHom e) coprod.inl m).trans (congrArg (eqToHom e ≫ ·) hm)))
          exact hleft.trans (heq_of_eq hright).symm
        · let j : Q.index := ⟨i, hi⟩
          let e := markedCarrier_old x (P.obj i).1 hi r
          let b := attachingNullaryValue E a r
          let n := FrozenAlgebra.nullaryEvaluation M r
          let v := attachingValue E a r ≫ (initialMap E M).hom r
          have hα : α.equiv (some i) = ⟨none, some j⟩ := markedContraction_position_old E.toCollection x d P i hi
          have hβ : β.equiv (α.equiv (some i)) = (⟨none, some j⟩ : N.index) :=
            (congrArg β.equiv hα).trans rfl
          have hγ : γ.equiv (β.equiv (α.equiv (some i))) =
              (some (Sum.inr j) : V.index) := (congrArg γ.equiv hβ).trans rfl
          have hδ : δ.equiv (γ.equiv (β.equiv (α.equiv (some i)))) = (some i : T.index) :=
            (congrArg δ.equiv hγ).trans rfl
          have hB : B.obj (α.equiv (some i)) = X r := congrArg B.obj hα
          have hN : N.obj (β.equiv (α.equiv (some i))) = E.toCollection.obj (ColoredProfile.nullary r) :=
            congrArg N.obj hβ
          have hV : V.obj (γ.equiv (β.equiv (α.equiv (some i)))) = M.carrier r := congrArg V.obj hγ
          have hT : T.obj (δ.equiv (γ.equiv (β.equiv (α.equiv (some i))))) = M.carrier r :=
            congrArg T.obj hδ
          have hA : HEq (α.hom (some i)) (eqToHom e) := markedContraction_component_old E.toCollection x d P i hi
          have hβm : HEq (β.hom (α.equiv (some i))) b := (AttachmentSource129_leftFactorDependentApply β.hom hα).trans
            HEq.rfl
          have hγm : HEq (γ.hom (β.equiv (α.equiv (some i)))) n :=
            (AttachmentSource129_leftFactorDependentApply γ.hom hβ).trans HEq.rfl
          have hδm : HEq (δ.hom (γ.equiv (β.equiv (α.equiv (some i))))) (𝟙 (M.carrier r)) :=
            (AttachmentSource129_leftFactorDependentApply δ.hom hγ).trans HEq.rfl
          have hγδ := heq_comp hN hV hT hγm hδm
          have hβγδ := heq_comp hB hN hT hβm hγδ
          have hv : b ≫ n ≫ 𝟙 (M.carrier r) = v :=
            (congrArg (b ≫ ·) (Category.comp_id n)).trans (attachingNullaryValue_map E a M r)
          have hleft : HEq ((markedFrozenMap E x a d P ≫ γ ≫ δ).hom (some i)) (eqToHom e ≫ v) :=
            (heq_of_eq (Category.assoc (α.hom (some i)) (β.hom (α.equiv (some i)))
              (γ.hom (β.equiv (α.equiv (some i))) ≫ δ.hom (γ.equiv (β.equiv (α.equiv (some i))))))).trans
            ((heq_comp rfl hB hT hA hβγδ).trans (heq_of_eq (congrArg (eqToHom e ≫ ·) hv)))
          have hL : L = eqToHom e ≫ coprod.inr := dite_eq_right hi
          have hm : (coprod.inr : X r ⟶ colorSum Xprime X r) ≫ m = v := coprod.inr_desc _ _
          have hright : (L ≫ 𝟙 _) ≫ m = eqToHom e ≫ v :=
            (congrArg (· ≫ m) (Category.comp_id L)).trans
              ((congrArg (· ≫ m) hL).trans
                ((Category.assoc (eqToHom e) coprod.inr m).trans (congrArg (eqToHom e ≫ ·) hm)))
          exact hleft.trans (heq_of_eq hright).symm


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource129


section AttachmentSource130


/-!
## Literal original left-relation evaluation of every marked free cofactor
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance leftEvaluationFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance leftEvaluationTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance leftEvaluationProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original mixed free cofan followed by the actual left relation
evaluates the original whole coefficient/input family by its original free
classifier and the genuine original new free-algebra operation. -/
theorem mixedCofan_leftEvaluation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    mixedCofan E x d P ≫ (relationLeft E a).hom d =
      (FiniteTensor.tensor (V := C)).map (mixedFactorsMap E.toCollection x d P ≫
        (analyticFactorsCarrierMap E.toCollection (leftClassifier E a)).app
          (profileInputs ((markedProfileFunctor d).obj P))) ≫
        (freeAlgebra E Xprime).operations.app d (profileInputs ((markedProfileFunctor d).obj P)) := by
  let T := FiniteTensor.tensor (V := C)
  let M := freeAlgebra E Xprime
  let F := (markedProfileFunctor d).obj P
  let m := mixedFactorsMap E.toCollection x d P
  let p := profileι E.toCollection (colorSum Xprime X) (profileInputs F)
  let h := (relationLeft E (Xprime := Xprime) a).hom d
  let o := M.operations.app d (profileInputs F)
  let c := (analyticFactorsCarrierMap E.toCollection (leftClassifier E (Xprime := Xprime) a)).app (profileInputs F)
  have hp : p ≫ h = T.map c ≫ o :=
    (profileι_freeHom E (colorSum Xprime X) M (relationLeft E a) (profileInputs F)).trans
      (congrArg (fun z => (analyticSummandCarrierMap E.toCollection z).app (profileInputs F) ≫ o)
        (relationLeft_classifier E a))
  exact (Category.assoc (T.map m) p h).trans
    ((congrArg (T.map m ≫ ·) hp).trans
      ((Category.assoc (T.map m) (T.map c) o).symm.trans
        (congrArg (· ≫ o) (T.map_comp m c).symm)))

/-- The genuine frozen new-free-algebra evaluation followed by the original
root/input profile map is exactly the original whole left-classifier evaluation. -/
theorem markedFrozen_evaluation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    (FiniteTensor.tensor (V := C)).map (markedFrozenMap E x a d P) ≫
        (FiniteTensor.tensor (V := C)).map
          (FrozenAlgebra.evaluatedFactors E (freeAlgebra E Xprime) (survivingProfile d P) (contractedInputs P)) ≫
          (freeAlgebra E Xprime).operations.app d (profileInputs (extendProfile (survivingProfile d P) (contractedInputs
            P))) =
      (FiniteTensor.tensor (V := C)).map (mixedFactorsMap E.toCollection x d P ≫
        (analyticFactorsCarrierMap E.toCollection (leftClassifier E a)).app
          (profileInputs ((markedProfileFunctor d).obj P))) ≫
        (freeAlgebra E Xprime).operations.app d (profileInputs ((markedProfileFunctor d).obj P)) := by
  let T := FiniteTensor.tensor (V := C)
  let M := freeAlgebra E Xprime
  let m := markedFrozenMap E x a d P
  let e := FrozenAlgebra.evaluatedFactors E M (survivingProfile d P) (contractedInputs P)
  let p := (operationFactorsFunctor E.toCollection M.carrier).map (selectionRootHom d P)
  let r := mixedFactorsMap E.toCollection x d P ≫
    (analyticFactorsCarrierMap E.toCollection (leftClassifier E a)).app (profileInputs ((markedProfileFunctor d).obj P))
  let o := M.operations.app d (profileInputs ((markedProfileFunctor d).obj P))
  let o' := M.operations.app d (profileInputs (extendProfile (survivingProfile d P) (contractedInputs P)))
  have hc : T.map m ≫ T.map e ≫ T.map p = T.map r :=
    (congrArg (T.map m ≫ ·) (T.map_comp e p).symm).trans
      ((T.map_comp m (e ≫ p)).symm.trans (congrArg T.map (markedFrozenMap_factors E x a d P)))
  have hp : T.map p ≫ o = o' :=
    (M.operations.profile_equivariance (selectionRootHom d P)).trans (Category.comp_id _)
  have h : (T.map m ≫ T.map e ≫ T.map p) ≫ o = T.map m ≫ T.map e ≫ o' :=
    (Category.assoc (T.map m) (T.map e ≫ T.map p) o).trans
      ((congrArg (T.map m ≫ ·) (Category.assoc (T.map e) (T.map p) o)).trans
        (congrArg (fun z => T.map m ≫ T.map e ≫ z) hp))
  exact h.symm.trans (congrArg (· ≫ o) hc)

/-- The literal original marked attaching contraction followed by the
original survivor free cofan is the original frozen source evaluated in the
genuine new free algebra. Every original old and new input remains present. -/
theorem markedContraction_freeEvaluation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    normalizedMarkedFaceContraction E x a d P ≫
        profileι E.toCollection Xprime (profileInputs (survivingProfile d P)) =
      (FiniteTensor.tensor (V := C)).map (markedFrozenMap E x a d P) ≫
        (FiniteTensor.tensor (V := C)).map
          (FrozenAlgebra.evaluatedFactors E (freeAlgebra E Xprime) (survivingProfile d P) (contractedInputs P)) ≫
          (freeAlgebra E Xprime).operations.app d
            (profileInputs (extendProfile (survivingProfile d P) (contractedInputs P))) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let M := freeAlgebra E Xprime
  let S := survivingProfile d P
  let Q := contractedInputs P
  let K := constantInputFamily E.toCollection X S Q
  let L := profileLeafFamily Xprime S
  let L' := profileLeafFamily M.carrier S
  let l := carrierLeafMap ((profileUnit E).app Xprime) S
  let k := constantInputCoefficientMap E a S Q
  let α := (markedContractionFactorsIso E.toCollection x d P).hom
  let r := T.map α
  let t := T.map (F.map (coefficientLeavesNestedMap (𝟙 K) l))
  let c := coefficientContractionTensor E a S Q L
  let c' := coefficientContractionTensor E a S Q L'
  let w := T.map (coefficientLeafMap (𝟙 (E.toCollection.obj S)) l)
  let j := (profileCoefficientLeafTensorIso E.toCollection Xprime S).hom
  let ι := profileι E.toCollection Xprime (profileInputs S)
  let j' := (profileCoefficientLeafTensorIso E.toCollection M.carrier S).hom
  let o := M.operations.app d (profileInputs S)
  let k' := T.map (contractionFrozenMap E a M S Q)
  let e := T.map (FrozenAlgebra.evaluatedFactors E M S Q)
  let o' := M.operations.app d (profileInputs (extendProfile S Q))
  have hn : normalizedMarkedFaceContraction E x a d P = r ≫ c ≫ j := markedContraction_CCT E x a d P
  have hg : w ≫ j' ≫ o = j ≫ ι := free_generator_coefficient E Xprime S
  have hl : t ≫ c' = c ≫ w := coefficientContractionTensor_leaves E a S Q l
  have he : c' ≫ j' ≫ o = k' ≫ e ≫ o' := rawContraction_evaluation E a M S Q
  have hf : coefficientLeavesNestedMap (𝟙 K) l ≫ coefficientLeavesNestedMap k (𝟙 L') =
      coefficientLeavesNestedMap k l :=
    (coefficientLeavesNestedMap_comp (𝟙 K) k l (𝟙 L')).trans
      (congrArg₂ (fun c l => coefficientLeavesNestedMap c l) (Category.id_comp k) (Category.comp_id l))
  have hF : F.map (coefficientLeavesNestedMap (𝟙 K) l) ≫ F.map (coefficientLeavesNestedMap k (𝟙 L')) =
      F.map (coefficientLeavesNestedMap k l) :=
    (F.map_comp _ _).symm.trans (congrArg F.map hf)
  have hT : t ≫ k' = T.map (F.map (coefficientLeavesNestedMap k l)) :=
    (T.map_comp _ _).symm.trans (congrArg T.map hF)
  have hp : r ≫ t ≫ k' = T.map (markedFrozenMap E x a d P) :=
    (congrArg (r ≫ ·) hT).trans (T.map_comp α (F.map (coefficientLeavesNestedMap k l))).symm
  have hc : c ≫ j ≫ ι = t ≫ k' ≫ e ≫ o' :=
    (congrArg (c ≫ ·) hg.symm).trans
      ((Category.assoc c w (j' ≫ o)).symm.trans
        ((congrArg (fun z => z ≫ j' ≫ o) hl.symm).trans
          ((Category.assoc t c' (j' ≫ o)).trans (congrArg (t ≫ ·) he))))
  have hpost : (r ≫ t ≫ k') ≫ e ≫ o' = r ≫ t ≫ k' ≫ e ≫ o' :=
    (Category.assoc r (t ≫ k') (e ≫ o')).trans
      (congrArg (r ≫ ·) (Category.assoc t k' (e ≫ o')))
  exact (congrArg (· ≫ ι) hn).trans
    ((Category.assoc r (c ≫ j) ι).trans
      ((congrArg (r ≫ ·) (Category.assoc c j ι)).trans
        ((congrArg (r ≫ ·) hc).trans
          (hpost.symm.trans (congrArg (fun z => z ≫ e ≫ o') hp)))))

/-- Every original mixed marked free cofactor evaluates the original left
relation by the actual original normalized nullary contraction into its
genuine original survivor profile and that same original free cofan. -/
theorem mixedCofan_relationLeft (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    mixedCofan E x d P ≫ (relationLeft E a).hom d =
      normalizedMarkedFaceContraction E x a d P ≫
        profileι E.toCollection Xprime (profileInputs (survivingProfile d P)) :=
  (mixedCofan_leftEvaluation E x a d P).trans
    ((markedContraction_freeEvaluation E x a d P).trans (markedFrozen_evaluation E x a d P)).symm


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
