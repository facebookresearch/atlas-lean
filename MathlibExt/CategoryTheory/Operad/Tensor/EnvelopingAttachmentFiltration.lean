/-!
## Full original colored-profile generators for the actual attachment history
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping ProfileCells HomotopicalAlgebra

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationOriginalProfileHistoryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationOriginalProfileHistorySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationOriginalProfileHistoryProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationOriginalProfileHistoryFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The generator family consists of the literal original balanced profile
arrows for every original finite colored profile, including nullary profiles. -/
def originalProfileCellArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow C := balancedProfileArrow E x P

/-- The underlying original balanced boundary morphism for a caller profile. -/
def originalProfileCellMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (originalProfileCellArrow E x P).left ⟶ (originalProfileCellArrow E x P).right :=
  (originalProfileCellArrow E x P).hom

/-- Reindexing only the cell types identifies the actual stage cells with
their original full colored profiles. Both original cofans and actual pushout maps remain. -/
def originalProfileStageCells (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    AttachCells.{us} (originalProfileCellMap E x)
      ((attachmentHistory E x a d).F.map (homOfLE (Nat.le_succ N))) :=
  (profileStageCells E x a d N).reindexCellTypes (originalProfileCellMap E x)
    (representativeProfile d) (fun _ => Iso.refl _)

theorem originalProfileStageCells_type (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (originalProfileStageCells E x a d N).π i = representativeProfile d (stageCellIndexEquiv (W := W) N i) := rfl

theorem originalProfileStageCells_cell (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (originalProfileStageCells E x a d N).cell i = (profileStageCells E x a d N).cell i := by
  let p := (operadProfileCellCofan E x d (N + 1) (stageCellIndexEquiv (W := W) N i)).right
  let n := recursiveNewDegreeCofan E x a d N
  change (𝟙 _ ≫ p) ≫ n = p ≫ n
  exact congrArg (· ≫ n) (Category.id_comp p)

/-- The full original profile family supplies a genuine constant-family
relative cell complex for the literal original initial-algebra attachment leg. -/
def originalProfileRelativeCellComplex (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    RelativeCellComplex.{us} (fun _ : ℕ => originalProfileCellMap E x) ((endpointOldMap E x a).hom d) where
  toTransfiniteCompositionOfShape := attachmentHistory E x a d
  attachCells N _hN := originalProfileStageCells E x a d N

/-- This complete history uses the original profile cell family directly,
with all pushouts, continuity, original source and genuine endpoint constructed. -/
def originalProfileCellTransfiniteComposition (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (MorphismProperty.coproducts.{us} (MorphismProperty.ofHoms (originalProfileCellMap E
      x))).pushouts.TransfiniteCompositionOfShape
      ℕ ((endpointOldMap E x a).hom d) :=
  (originalProfileRelativeCellComplex E x a d).transfiniteCompositionOfShape (originalProfileCellMap E x)

@[reassoc]
theorem originalProfileCellTransfiniteComposition_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    recursiveProfileCofan E x a N P hP ≫ (originalProfileCellTransfiniteComposition E x a P.outputColor).incl.app N =
      profileι E.toCollection Xprime (profileInputs P) ≫ (endpointNewMap E x a).hom P.outputColor :=
  attachmentHistory_profile E x a N P hP

theorem originalProfile_isCellular (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    MorphismProperty.transfiniteCompositionsOfShape
      (MorphismProperty.coproducts.{us} (MorphismProperty.ofHoms (originalProfileCellMap E x))).pushouts
        ℕ ((endpointOldMap E x a).hom d) := ⟨originalProfileCellTransfiniteComposition E x a d⟩


