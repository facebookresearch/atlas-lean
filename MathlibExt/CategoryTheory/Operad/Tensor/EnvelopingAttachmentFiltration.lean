namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance balancedProfileFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance balancedProfileSmallestColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance balancedProfileAutColimits (P : ColoredProfile W) : HasColimitsOfShape (SingleObj (Aut P)) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The actual original coefficient/input punctured cube is balanced over
its genuine original full profile automorphism group on both endpoints. -/
def balancedProfileArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow C :=
  geometryBalancedProfileArrow (markedTensorDiagram E x P.outputColor) P

/-- The original unbalanced coefficient/input cube has its canonical actual
arrow into the genuine profile group quotient, retaining both original legs. -/
def balancedProfileArrowCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor) P) ⟶
      balancedProfileArrow E x P :=
  Arrow.homMk
    (colimit.ι (geometryBoundaryActionFunctor (markedTensorDiagram E x P.outputColor) P) (SingleObj.star (Aut P)))
    (colimit.ι (geometryInputTopActionFunctor (markedTensorDiagram E x P.outputColor) P) (SingleObj.star (Aut P)))
    (ι_colimMap (geometryBoundaryTopTransformation (markedTensorDiagram E x P.outputColor) P) (SingleObj.star (Aut P)))

/-- Every original profile automorphism satisfies its genuine original
boundary coinvariant relation, including every heterogeneous original input. -/
theorem balancedProfileBoundary_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    boundaryAutMap E x P g ≫ (balancedProfileArrowCofan E x P).left =
      (balancedProfileArrowCofan E x P).left :=
  colimit.w (geometryBoundaryActionFunctor (markedTensorDiagram E x P.outputColor) P)
    (show SingleObj.star (Aut P) ⟶ SingleObj.star (Aut P) from g)

theorem balancedProfileTop_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    (inputTopRepresentation E x P g).asHom ≫ (balancedProfileArrowCofan E x P).right =
      (balancedProfileArrowCofan E x P).right :=
  colimit.w (geometryInputTopActionFunctor (markedTensorDiagram E x P.outputColor) P)
    (show SingleObj.star (Aut P) ⟶ SingleObj.star (Aut P) from g)


end CategoryTheory.Operad.Tensor.InitialAttachment

