def profileTopActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : SingleObj (Aut P) ⥤ C :=
  SingleObj.functor (profileTopRepresentation E x P)

/-- The same original action is expressed over the product of the symmetric
groups of the actual original color multiplicities, using the proved group
equivalence and retaining every original color fiber. -/
def profileSigmaTopActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    SingleObj (∀ r : W, Equiv.Perm (Fin (colorMultiplicity P r))) ⥤ C :=
  (profileAutSigmaMulEquiv P).symm.toSingleObjEquiv.functor ⋙ profileTopActionFunctor E x P

