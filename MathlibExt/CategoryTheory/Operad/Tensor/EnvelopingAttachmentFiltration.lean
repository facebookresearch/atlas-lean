section AttachmentSource118


/-!
## Literal recursively constructed original pushout stages
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

theorem pushoutChangeLeft {V : Type*} [Category* V] {A X Y P X' : V}
    {f : A ⟶ X} {g : A ⟶ Y} {i : X ⟶ P} {j : Y ⟶ P}
    (h : IsPushout f g i j) (e : X' ≅ X) :
    IsPushout (f ≫ e.inv) g (e.hom ≫ i) j := by
  apply h.of_iso' (Iso.refl A) e (Iso.refl Y) (Iso.refl P)
  · exact (Category.id_comp f).trans
      ((Category.assoc f e.inv e.hom).trans
        ((congrArg (f ≫ ·) e.inv_hom_id).trans (Category.comp_id f))).symm
  · exact (Category.id_comp g).trans (Category.comp_id g).symm
  · exact (Category.comp_id (e.hom ≫ i)).symm
  · exact (Category.id_comp j).trans (Category.comp_id j).symm

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationRecursiveFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationRecursiveSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationRecursiveProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationRecursiveFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- This dependent recursor constructs the actual original initial carrier at
zero and the literal original balanced-boundary pushout at every successor.
Its comparisons are constructed internally from the proved universal properties. -/
def recursiveStagePair (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (n : ℕ) → Σ K : C, K ≅ stage E x a d n
  | 0 => ⟨(initialAlgebra E).carrier d, (stageZeroIso E x a d).symm⟩
  | n + 1 =>
      let prev := recursiveStagePair E x a d n
      let f := attachingMap E x a d n ≫ prev.2.inv
      let g := (degreeBalancedArrow E x d (n + 1)).hom
      let h := pushoutChangeLeft (successorIsPushout E x a d n) prev.2
      ⟨pushout f g, h.isoPushout.symm⟩

/-- The recursively constructed pushout stage, extracted from its comparison pair. -/
def recursiveStage (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) : C :=
  (recursiveStagePair E x a d n).1

/-- The comparison isomorphism from a recursive pushout stage to its stage presentation. -/
def recursiveStageComparison (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveStage E x a d n ≅ stage E x a d n := (recursiveStagePair E x a d n).2

/-- Transport the degree-`n + 1` attaching map to the recursive stage at degree `n`. -/
def recursiveAttachingMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    (degreeBalancedArrow E x d (n + 1)).left ⟶ recursiveStage E x a d n :=
  attachingMap E x a d n ≫ (recursiveStageComparison E x a d n).inv

theorem recursiveStage_zero (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveStage E x a d 0 = (initialAlgebra E).carrier d := rfl

theorem recursiveStage_succ (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveStage E x a d (n + 1) =
      pushout (recursiveAttachingMap E x a d n) (degreeBalancedArrow E x d (n + 1)).hom := rfl

/-- The literal original successor connecting map is the actual pushout's old leg. -/
def recursiveConnectingMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveStage E x a d n ⟶ recursiveStage E x a d (n + 1) :=
  pushout.inl (recursiveAttachingMap E x a d n) (degreeBalancedArrow E x d (n + 1)).hom

/-- The new degree's original balanced top is the actual pushout's new leg. -/
def recursiveNewDegreeCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    degreeBalancedTop E x d (n + 1) ⟶ recursiveStage E x a d (n + 1) :=
  pushout.inr (recursiveAttachingMap E x a d n) (degreeBalancedArrow E x d (n + 1)).hom

theorem recursiveConnectingMap_comparison (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveConnectingMap E x a d n ≫ (recursiveStageComparison E x a d (n + 1)).hom =
      (recursiveStageComparison E x a d n).hom ≫ stageMap E x a d (Nat.le_succ n) := by
  let prev := recursiveStagePair E x a d n
  let h := pushoutChangeLeft (successorIsPushout E x a d n) prev.2
  exact h.inl_isoPushout_inv

theorem recursiveNewDegreeCofan_comparison (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveNewDegreeCofan E x a d n ≫ (recursiveStageComparison E x a d (n + 1)).hom =
      stageDegreeLeg E x a d (n + 1) (n + 1) (Nat.le_refl _) := by
  let prev := recursiveStagePair E x a d n
  let h := pushoutChangeLeft (successorIsPushout E x a d n) prev.2
  exact h.inr_isoPushout_inv

theorem recursiveSuccessorIsPushout (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    IsPushout (recursiveAttachingMap E x a d n) (degreeBalancedArrow E x d (n + 1)).hom
      (recursiveConnectingMap E x a d n) (recursiveNewDegreeCofan E x a d n) :=
  IsPushout.of_hasPushout _ _


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource118


section AttachmentSource119


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource119_transportId {V : Type*} [Category* V] {X S : V} (e : X ≅ S)
    (m : S ⟶ S) (h : m = 𝟙 S) : e.hom ≫ m ≫ e.inv = 𝟙 X := by
  rw [h]
  simp only [Category.id_comp, Iso.hom_inv_id]

private theorem AttachmentSource119_transportComp {V : Type*} [Category* V] {X Y Z S T U : V}
    (e : X ≅ S) (e' : Y ≅ T) (e'' : Z ≅ U) (f : S ⟶ T) (g : T ⟶ U) (r : S ⟶ U)
    (h : f ≫ g = r) :
    (e.hom ≫ f ≫ e'.inv) ≫ (e'.hom ≫ g ≫ e''.inv) = e.hom ≫ r ≫ e''.inv := by
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  exact congrArg (e.hom ≫ ·) ((Category.assoc f g e''.inv).symm.trans
    (congrArg (· ≫ e''.inv) h))

private theorem AttachmentSource119_cancelRightIso {V : Type*} [Category* V] {A B X Y : V}
    (e : X ≅ Y) (a : A ⟶ B) (b : B ⟶ Y) :
    (a ≫ b ≫ e.inv) ≫ e.hom = a ≫ b := by
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]

private theorem AttachmentSource119_transportCofan {V : Type*} [Category* V] {A X Y S T : V}
    (e : X ≅ S) (e' : Y ≅ T) (a : A ⟶ S) (f : S ⟶ T) (b : A ⟶ T) (h : a ≫ f = b) :
    (a ≫ e.inv) ≫ (e.hom ≫ f ≫ e'.inv) = b ≫ e'.inv := by
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  exact (Category.assoc a f e'.inv).symm.trans (congrArg (· ≫ e'.inv) h)

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationRecursiveMapsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationRecursiveMapsSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationRecursiveMapsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationRecursiveMapsFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- Transport the stage transition along the recursive-stage comparison isomorphisms. -/
def recursiveStageMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {n m : ℕ} (h : n ≤ m) : recursiveStage E x a d n ⟶ recursiveStage E x a d m :=
  (recursiveStageComparison E x a d n).hom ≫ stageMap E x a d h ≫ (recursiveStageComparison E x a d m).inv

theorem recursiveStageMap_id (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveStageMap E x a d (Nat.le_refl n) = 𝟙 (recursiveStage E x a d n) :=
  AttachmentSource119_transportId _ _ (stageMap_id E x a d n)

theorem recursiveStageMap_comp (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {n m k : ℕ} (h : n ≤ m) (h' : m ≤ k) :
    recursiveStageMap E x a d h ≫ recursiveStageMap E x a d h' = recursiveStageMap E x a d (h.trans h') :=
  AttachmentSource119_transportComp _ _ _ _ _ _ (stageMap_comp E x a d h h')

theorem recursiveStageMap_comparison (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {n m : ℕ} (h : n ≤ m) :
    recursiveStageMap E x a d h ≫ (recursiveStageComparison E x a d m).hom =
      (recursiveStageComparison E x a d n).hom ≫ stageMap E x a d h :=
  AttachmentSource119_cancelRightIso _ _ _

/-- The transported interval map at each successor is precisely the original
literal pushout connecting map; the entire diagram uses those actual maps. -/
theorem recursiveStageMap_succ (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (n : ℕ) :
    recursiveStageMap E x a d (Nat.le_succ n) = recursiveConnectingMap E x a d n := by
  apply (cancel_mono (recursiveStageComparison E x a d (n + 1)).hom).1
  exact (recursiveStageMap_comparison E x a d (Nat.le_succ n)).trans (recursiveConnectingMap_comparison E x a d n).symm

/-- The natural-number diagram of recursive pushout stages and transported transitions. -/
def recursiveStageDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) : ℕ ⥤ C where
  obj n := recursiveStage E x a d n
  map f := recursiveStageMap E x a d (leOfHom f)
  map_id n := recursiveStageMap_id E x a d n
  map_comp f g := (recursiveStageMap_comp E x a d (leOfHom f) (leOfHom g)).symm

/-- The natural isomorphism between recursive pushout stages and the stage presentation. -/
def recursiveStageIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveStageDiagram E x a d ≅ stageDiagram E x a d :=
  NatIso.ofComponents (fun n => recursiveStageComparison E x a d n) (by
    intro n m f
    exact recursiveStageMap_comparison E x a d (leOfHom f))

/-- The balanced degree-`j` cofan leg into recursive stage `N`. -/
def recursiveDegreeCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N j : ℕ) (hj : j ≤ N) :
    degreeBalancedTop E x d j ⟶ recursiveStage E x a d N :=
  stageDegreeLeg E x a d N j hj ≫ (recursiveStageComparison E x a d N).inv

/-- The operation summand leg of a profile into a recursive stage containing its degree. -/
def recursiveProfileCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    (operationSummandFunctor E.toCollection Xprime).obj P ⟶ recursiveStage E x a P.outputColor N :=
  stageProfileLeg E x a N P hP ≫ (recursiveStageComparison E x a P.outputColor N).inv

@[reassoc (attr := simp)]
theorem recursiveDegreeCofan_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) (j : ℕ) (hj : j ≤ N) :
    recursiveDegreeCofan E x a d N j hj ≫ recursiveStageMap E x a d h =
      recursiveDegreeCofan E x a d M j (hj.trans h) :=
  AttachmentSource119_transportCofan _ _ _ _ _ (stageDegreeLeg_map E x a d h j hj)

@[reassoc (attr := simp)]
theorem recursiveProfileCofan_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E)
    {N M : ℕ} (h : N ≤ M) (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    recursiveProfileCofan E x a N P hP ≫ recursiveStageMap E x a P.outputColor h =
      recursiveProfileCofan E x a M P (hP.trans h) :=
  AttachmentSource119_transportCofan _ _ _ _ _ (stageProfileLeg_map E x a h P hP)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource119


section AttachmentSource120


/-!
## The countable colimit of the actual recursive pushout stages
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationRecursiveContinuityFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationRecursiveContinuitySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationRecursiveContinuityProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationRecursiveContinuityFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The colimit of the natural-number diagram of recursive pushout stages. -/
abbrev recursiveStageEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) : C :=
  colimit (recursiveStageDiagram E x a d)

/-- Include a recursive pushout stage into its colimit endpoint. -/
def recursiveStageι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    recursiveStage E x a d N ⟶ recursiveStageEndpoint E x a d :=
  colimit.ι (recursiveStageDiagram E x a d) N

@[reassoc (attr := simp)]
theorem recursiveStageι_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) :
    recursiveStageMap E x a d h ≫ recursiveStageι E x a d M = recursiveStageι E x a d N :=
  colimit.w (recursiveStageDiagram E x a d) (homOfLE h)

/-- The colimit comparison uses the internally constructed stage comparisons,
including their exact original operation cofans and successor legs. -/
def recursiveStageEndpointIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveStageEndpoint E x a d ≅ stageEndpoint E x a d :=
  HasColimit.isoOfNatIso (recursiveStageIso E x a d)

@[reassoc (attr := simp)]
theorem recursiveStageEndpointIso_ι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    recursiveStageι E x a d N ≫ (recursiveStageEndpointIso E x a d).hom =
      (recursiveStageComparison E x a d N).hom ≫ stageι E x a d N :=
  HasColimit.ι_isoOfNatIso_hom (recursiveStageIso E x a d) N

/-- The initial-algebra carrier map into the recursive-stage colimit, through stage zero. -/
def recursiveStageRootMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (initialAlgebra E).carrier d ⟶ recursiveStageEndpoint E x a d :=
  recursiveStageι E x a d 0

@[reassoc (attr := simp)]
theorem recursiveStageRootMap_comparison (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveStageRootMap E x a d ≫ (recursiveStageEndpointIso E x a d).hom =
      stageRootMap E x a d :=
  recursiveStageEndpointIso_ι E x a d 0

theorem recursiveStageContinuous (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (recursiveStageDiagram E x a d).IsWellOrderContinuous := inferInstance

/-- This is the actual countable history of the constructed original pushout
stages. Its zero carrier, all connecting maps and colimit are constructed. -/
def recursiveStageHistory (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    TransfiniteCompositionOfShape ℕ (recursiveStageRootMap E x a d) where
  F := recursiveStageDiagram E x a d
  isoBot := Iso.refl _
  isWellOrderContinuous := recursiveStageContinuous E x a d
  incl := (colimit.cocone _).ι
  isColimit := colimit.isColimit _
  fac := Category.id_comp _

theorem recursiveStageHistory_succ (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (recursiveStageHistory E x a d).F.map (homOfLE (Nat.le_succ N)) =
      recursiveConnectingMap E x a d N :=
  recursiveStageMap_succ E x a d N


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
