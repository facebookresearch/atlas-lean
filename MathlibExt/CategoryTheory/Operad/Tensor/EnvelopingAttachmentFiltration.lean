section AttachmentSource039


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc}

theorem extension_variables_inputs {P P' : ColoredProfile W} (f : P ⟶ P')
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    extendProfileMap f (𝟙 Q) ≫ extendProfileMap (𝟙 P') g = extendProfileMap f g := by
  simpa only [Category.comp_id, Category.id_comp] using
    (extendProfileMap_comp f (𝟙 P') (𝟙 Q) g).symm

section Factors

variable {C : Type u} [Category.{v} C]

/-- The original joint coefficient and contracted-input map. -/
def contractionInputMap (O : ColoredSymmetricCollection W C) (X : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    constantInputFamily O X P Q ⟶ constantInputFamily O X P' Q' :=
  coefficientLeafMap (O.map (extendProfileMap f g)) ((addedAlgebraInputs X).map g)

theorem contractionInputMap_factor (O : ColoredSymmetricCollection W C) (X : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    coefficientLeafMap (O.map (extendProfileMap f (𝟙 Q))) (𝟙 ((addedAlgebraInputs X).obj Q)) ≫
      coefficientLeafMap (O.map (extendProfileMap (𝟙 P') g)) ((addedAlgebraInputs X).map g) =
        contractionInputMap O X f g := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
        exact heq_of_eq ((O.map_comp _ _).symm.trans
          (congrArg O.map (extension_variables_inputs f g)))
    | some i => exact heq_of_eq (Category.id_comp _)

end Factors

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationJointFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationJointTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationJointProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original simultaneous survivor/contracted-input bijections
preserve the unchanged original attaching-value contraction. -/
theorem deletedCoefficientContraction_joint (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) {P P' : ColoredProfile W}
    (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map (contractionInputMap E.toCollection X f g) ≫
      deletedCoefficientContraction E a P' Q' =
        deletedCoefficientContraction E a P Q ≫ E.toCollection.map f := by
  let T := FiniteTensor.tensor (V := C)
  let c := coefficientLeafMap (E.toCollection.map (extendProfileMap f (𝟙 Q))) (𝟙 ((addedAlgebraInputs X).obj Q))
  let c' := coefficientLeafMap (E.toCollection.map (extendProfileMap (𝟙 P') g)) ((addedAlgebraInputs X).map g)
  let r := deletedCoefficientContraction E a P' Q'
  have hm : T.map (contractionInputMap E.toCollection X f g) = T.map c ≫ T.map c' :=
    (congrArg T.map (contractionInputMap_factor E.toCollection X f g).symm).trans (T.map_comp c c')
  exact (congrArg (· ≫ r) hm).trans
    ((Category.assoc (T.map c) (T.map c') r).trans
      ((congrArg (T.map c ≫ ·) (deletedCoefficientContraction_inputs E a P' g)).trans
        (deletedCoefficientContraction_variables E a f Q)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
