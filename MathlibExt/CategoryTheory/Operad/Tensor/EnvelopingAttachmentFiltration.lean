section AttachmentSource169


/-!
## Complete genuine original O-algebra free-attachment pushout universal property
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance universalFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance universalTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance universalProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

variable (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
variable (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A)

/-- Both genuine original O-algebra target maps and exactly their
original y/x attachment relation. This is the original cofan target data. -/
@[ext]
structure CompatiblePair (M : Algebra O) where
  /-- The target algebra map from the original attached algebra `A`. -/
  oldMap : A ⟶ M
  /-- The target algebra map from the original operad's new free algebra. -/
  newMap : freeAlgebra O Xprime ⟶ M
  comm : y ≫ oldMap = (freeAlgebraFunctor O).map x ≫ newMap

/-- Every whole original O-algebra map from the actual constructed
attachment endpoint is equivalent to both original compatible span maps. -/
def homEquiv (M : Algebra O) : (endpoint O A x y ⟶ M) ≃ CompatiblePair O A x y M where
  toFun f :=
    { oldMap := oldMap O A x y ≫ f
      newMap := newMap O A x y ≫ f
      comm := (Category.assoc y (oldMap O A x y) f).symm.trans
        ((congrArg (· ≫ f) (originalSquare O A x y)).trans (Category.assoc _ _ f)) }
  invFun p := desc O A x y p.oldMap p.newMap p.comm
  left_inv f := (desc_unique O A x y (oldMap O A x y ≫ f) (newMap O A x y ≫ f) _ f rfl rfl).symm
  right_inv p := by
    apply CompatiblePair.ext
    · exact oldMap_desc O A x y p.oldMap p.newMap p.comm
    · exact newMap_desc O A x y p.oldMap p.newMap p.comm

/-- The complete original attachment universal property constructs
a unique genuine whole O-algebra factor with both exact original leg equations. -/
theorem existsUnique_desc (M : Algebra O) (a : A ⟶ M) (z : freeAlgebra O Xprime ⟶ M)
    (h : y ≫ a = (freeAlgebraFunctor O).map x ≫ z) :
    ∃! f : endpoint O A x y ⟶ M, oldMap O A x y ≫ f = a ∧ newMap O A x y ≫ f = z := by
  refine ⟨desc O A x y a z h, ⟨oldMap_desc O A x y a z h, newMap_desc O A x y a z h⟩, ?_⟩
  intro f hf
  exact desc_unique O A x y a z h f hf.1 hf.2

/-- The actual original O-algebra attachment pushout cofan retains
the original y, original free image of x and both constructed original algebra legs. -/
def pushoutCocone : PushoutCocone y ((freeAlgebraFunctor O).map x) :=
  PushoutCocone.mk (oldMap O A x y) (newMap O A x y) (originalSquare O A x y)

/-- The constructed actual original cofan has the complete O-algebra
colimit universal property, with both original factors and whole-map uniqueness proved. -/
def pushoutIsColimit : IsColimit (pushoutCocone O A x y) :=
  PushoutCocone.IsColimit.mk _
    (fun c => desc O A x y c.inl c.inr c.condition)
    (fun c => oldMap_desc O A x y c.inl c.inr c.condition)
    (fun c => newMap_desc O A x y c.inl c.inr c.condition)
    (fun c f hl hr => desc_unique O A x y c.inl c.inr c.condition f hl hr)

/-- The original free-attachment square is an actual genuine
O-algebra pushout at the constructed original attachment object. -/
theorem isPushout : IsPushout y ((freeAlgebraFunctor O).map x) (oldMap O A x y) (newMap O A x y) :=
  IsPushout.of_isColimit (pushoutIsColimit O A x y)


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

