/-!
## Original coefficient/leaf carrier maps and free generator evaluations
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping

variable {W : Type uc}

/-- Both actual empty-input deletions retain the same original variable
profile and its complete original input bijection. -/
theorem nullaryTotalDeletion (P : ColoredProfile W) (Q : ColoredInputs W) :
    constantInputsDeletionHom P Q = Linear.Constants.totalProfileHom P Q := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl _ => rfl
  | inr i => exact isEmptyElim i

variable {C : Type u} [Category.{v} C]

/-- The original coefficient/input factor comparison is natural under every
original carrier map, without changing the original coefficient or input set. -/
theorem profileFactors_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (P : ColoredProfile W) :
    (profileOperationFactorsIso O A P).hom ≫
        (analyticFactorsCarrierMap O f).app (profileInputs P) =
      coefficientLeafMap (𝟙 (O.obj P)) (carrierLeafMap f P) ≫
        (profileOperationFactorsIso O B P).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none => exact HEq.rfl
    | some i =>
        let g := f (P.inputColor i)
        exact heq_of_eq ((Category.id_comp g).trans (Category.comp_id g).symm)

section Tensor

variable [FiniteTensor C]

/-- The original full coefficient/leaf tensor comparison retains every
original carrier map on each original heterogeneous input position. -/
theorem profileCoefficientLeafTensor_carrier (O : ColoredSymmetricCollection W C)
    {A B : W → C} (f : A ⟶ B) (P : ColoredProfile W) :
    (profileCoefficientLeafTensorIso O A P).hom ≫
        (analyticSummandCarrierMap O f).app (profileInputs P) =
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 (O.obj P)) (carrierLeafMap f P)) ≫
        (profileCoefficientLeafTensorIso O B P).hom :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
    ((congrArg (FiniteTensor.tensor (V := C)).map (profileFactors_carrier O f P)).trans
      ((FiniteTensor.tensor (V := C)).map_comp _ _))

end Tensor

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance carrierEvaluationFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance carrierEvaluationTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance carrierEvaluationProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original free generators evaluate their original profile
operation to precisely the same original profile cofan. -/
theorem free_generator_operation (E : ColoredOperadObj W C) (Xprime : W → C)
    {d : W} (P : AnalyticIndex W d) :
    (analyticSummandCarrierMap E.toCollection ((profileUnit E).app Xprime)).app P ≫
        (freeAlgebra E Xprime).operations.app d P = profileι E.toCollection Xprime P := by
  let M := freeAlgebra E Xprime
  let η := (profileUnit E).app Xprime
  have hg : tensorFreeHomEquiv E Xprime M (𝟙 M) = η := by
    funext r
    exact Category.comp_id _
  have h := profileι_freeHom E Xprime M (𝟙 M) P
  exact (congrArg (fun z => (analyticSummandCarrierMap E.toCollection z).app P ≫ M.operations.app d P)
    hg.symm).trans (h.symm.trans (Category.comp_id _))

/-- Inserting the actual original free generators into the original retained
coefficient/leaf tensor gives exactly its original free profile cofan. -/
theorem free_generator_coefficient (E : ColoredOperadObj W C) (Xprime : W → C)
    (P : ColoredProfile W) :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 (E.toCollection.obj P))
        (carrierLeafMap ((profileUnit E).app Xprime) P)) ≫
      (profileCoefficientLeafTensorIso E.toCollection (freeAlgebra E Xprime).carrier P).hom ≫
        (freeAlgebra E Xprime).operations.app P.outputColor (profileInputs P) =
      (profileCoefficientLeafTensorIso E.toCollection Xprime P).hom ≫
        profileι E.toCollection Xprime (profileInputs P) := by
  let M := freeAlgebra E Xprime
  let η := (profileUnit E).app Xprime
  let i := (profileCoefficientLeafTensorIso E.toCollection Xprime P).hom
  let j := (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom
  let t := (analyticSummandCarrierMap E.toCollection η).app (profileInputs P)
  let c := (FiniteTensor.tensor (V := C)).map
    (coefficientLeafMap (𝟙 (E.toCollection.obj P)) (carrierLeafMap η P))
  let o := M.operations.app P.outputColor (profileInputs P)
  have hc : i ≫ t = c ≫ j := profileCoefficientLeafTensor_carrier E.toCollection η P
  exact (Category.assoc c j o).symm.trans
    ((congrArg (· ≫ o) hc.symm).trans
      ((Category.assoc i t o).trans (congrArg (i ≫ ·) (free_generator_operation E Xprime (profileInputs P)))))


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
