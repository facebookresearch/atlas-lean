/-!
## Genuine original coefficient pushout-product action quotients
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance quotientCPPFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance quotientCPPSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance quotientCPPAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The arrow-valued profile-automorphism action on the coefficient-weighted boundary map. -/
def originalProfileActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : SingleObj (Aut P) ⥤ Arrow C :=
  naturalArrowFunctor (geometryBoundaryTopTransformation (markedTensorDiagram E x P.outputColor) P)

theorem originalProfileActionFunctor_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    (originalProfileActionFunctor E x P).map (show SingleObj.star (Aut P) ⟶ SingleObj.star (Aut P) from g) =
      Continuation.originalProfileAutArrow E x P g := by
  apply Arrow.hom_ext
  · rfl
  · rfl

/-- The colimit cocone for the profile-automorphism action on the original boundary arrow. -/
def originalProfileActionCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Cocone (originalProfileActionFunctor E x P) :=
  naturalArrowCocone (geometryBoundaryTopTransformation (markedTensorDiagram E x P.outputColor) P)

/-- The colimit structure of the profile-automorphism quotient in the arrow category. -/
def originalProfileActionIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : IsColimit (originalProfileActionCocone E x P) :=
  naturalArrowIsColimit (geometryBoundaryTopTransformation (markedTensorDiagram E x P.outputColor) P)

theorem originalProfileActionCocone_leg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (originalProfileActionCocone E x P).ι.app (SingleObj.star (Aut P)) = balancedProfileArrowCofan E x P := rfl

section PushoutProduct

variable [MonoidalClosed C]

/-- The profile-automorphism representation on the coefficient-weighted pushout-product arrow. -/
def profileCPPArrowRepresentation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Aut P →* End (profilePushoutProductArrow E x P) where
  toFun g := End.of (Continuation.profilePushoutProductAutArrow E x P g)
  map_one' := End.ext (Continuation.profilePushoutProductAutArrow_one E x P)
  map_mul' f g := End.ext (Continuation.profilePushoutProductAutArrow_mul E x P f g)

/-- The arrow-valued action diagram of the coefficient-weighted pushout product. -/
def profileCPPActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : SingleObj (Aut P) ⥤ Arrow C :=
  SingleObj.functor (profileCPPArrowRepresentation E x P)

/-- The full original coefficient pushout product action is the actual
original input-set action, through the checked complete original Arrow Iso. -/
def profileCPPActionIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : originalProfileActionFunctor E x P ≅ profileCPPActionFunctor E x P :=
  NatIso.ofComponents (fun _ => Continuation.originalProfilePushoutProductIso E x P) (by
    intro j k g
    cases j
    cases k
    let e := Continuation.originalProfilePushoutProductIso E x P
    exact (congrArg (· ≫ e.hom) (originalProfileActionFunctor_map E x P g)).trans
      (Iso.hom_inv_id_assoc e (Continuation.originalProfileAutArrow E x P g ≫ e.hom)).symm)

/-- The original CPP quotient cofan is constructed from the actual
original action quotient and the actual original coefficient/input Arrow Iso. -/
def profileCPPActionCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Cocone (profileCPPActionFunctor E x P) :=
  (Cocone.precompose (profileCPPActionIso E x P).inv).obj (originalProfileActionCocone E x P)

/-- The colimit structure on the coefficient-weighted pushout-product action cocone. -/
def profileCPPActionIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : IsColimit (profileCPPActionCocone E x P) :=
  (IsColimit.precomposeInvEquiv (profileCPPActionIso E x P) (originalProfileActionCocone E x P)).symm
    (originalProfileActionIsColimit E x P)

/-- The literal original quotient leg, not merely an object formula. -/
theorem profileCPPActionCocone_leg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (profileCPPActionCocone E x P).ι.app (SingleObj.star (Aut P)) =
      Continuation.profilePushoutProductBalancedCofan E x P := rfl

/-- Reindex the pushout-product action by the product of same-color permutation groups. -/
def profileCPPProductActionFunctor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    SingleObj (∀ r : W, Equiv.Perm (Fin (colorMultiplicity P r))) ⥤ Arrow C :=
  (profileAutSigmaMulEquiv P).symm.toSingleObjEquiv.functor ⋙ profileCPPActionFunctor E x P

/-- The actual product of symmetric groups of the original color fibers
acts by the same original CPP maps and has the same original quotient cofan. -/
def profileCPPProductCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Cocone (profileCPPProductActionFunctor E x P) :=
  (profileCPPActionCocone E x P).whisker (profileAutSigmaMulEquiv P).symm.toSingleObjEquiv.functor

/-- The colimit structure after reindexing the action by same-color permutation groups. -/
def profileCPPProductIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : IsColimit (profileCPPProductCocone E x P) :=
  (Functor.Final.isColimitWhiskerEquiv (profileAutSigmaMulEquiv P).symm.toSingleObjEquiv.functor
    (profileCPPActionCocone E x P)).symm (profileCPPActionIsColimit E x P)

theorem profileCPPProductCocone_leg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (profileCPPProductCocone E x P).ι.app
        (SingleObj.star (∀ r : W, Equiv.Perm (Fin (colorMultiplicity P r)))) =
      Continuation.profilePushoutProductBalancedCofan E x P := rfl

theorem profileCPPProjection_top (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (Continuation.originalProfilePushoutProductIso E x P).hom.right ≫
        ((profileCPPActionCocone E x P).ι.app (SingleObj.star (Aut P))).right =
      (balancedProfileArrowCofan E x P).right :=
  congrArg Arrow.Hom.right (Continuation.originalProfilePushoutProductIso_balancedCofan E x P)

end PushoutProduct


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

