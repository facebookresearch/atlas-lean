/-!
## Actual caller profiles and their actual chosen class representatives
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- An actual displayed enumeration of the original caller input family. -/
def callerWord {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) : PureDegreeInputs W n :=
  fun i => P.inputColor (e i)

/-- The profile class of the caller's inputs, using the chosen enumeration `e`. -/
def callerClassWith {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) : ProfileClass W n :=
  toSkeleton (callerWord P e)

/-- Identify the chosen representative word with the caller's enumerated color word. -/
def callerColorIso {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    representativeWord (callerClassWith P e) ≅ callerWord P e := fromSkeletonToSkeletonIso _

/-- The representative-to-caller input equivalence induced by normalization and `e`. -/
def callerRepresentativeInputEquiv {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    Fin n ≃ P.inputs :=
  (((pureDegreeInclusion (W := W) n).map (callerColorIso P e).hom).equiv).trans e

/-- The chosen representative is genuinely isomorphic to the caller's
same original profile, with its actual input bijection and output retained. -/
def callerRepresentativeIsoWith {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    representativeProfile P.outputColor (callerClassWith P e) ≅ P :=
  asIso (show representativeProfile P.outputColor (callerClassWith P e) ⟶ P from
    { inputEquiv := callerRepresentativeInputEquiv P e
      inputColor_eq i := Discrete.eq_of_hom
        (((pureDegreeInclusion (W := W) n).map (callerColorIso P e).hom).hom i)
      outputColor_eq := rfl })

theorem callerRepresentativeIsoWith_inputs {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    (callerRepresentativeIsoWith P e).hom.inputEquiv = callerRepresentativeInputEquiv P e := rfl

/-- Every actual original profile map compares any two actual displayed
input enumerations by its original color-preserving input permutation. -/
def callerWordMap {n : ℕ} {P Q : ColoredProfile W} (f : P ⟶ Q)
    (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) : callerWord P e ⟶ callerWord Q e' :=
  InducedCategory.homMk
    { equiv := (e.trans f.inputEquiv).trans e'.symm
      hom i := Discrete.eqToHom' (by
        change P.inputColor (e i) = Q.inputColor (e' (((e.trans f.inputEquiv).trans e'.symm) i))
        exact (f.inputColor_eq (e i)).trans
          (congrArg Q.inputColor (e'.apply_symm_apply (f.inputEquiv (e i)))).symm) }

theorem callerClassWith_map {n : ℕ} {P Q : ColoredProfile W} (f : P ⟶ Q)
    (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) :
    callerClassWith P e = callerClassWith Q e' := congr_toSkeleton_of_iso (asIso (callerWordMap f e e'))

theorem callerClassWith_enumeration {n : ℕ} (P : ColoredProfile W)
    (e e' : Fin n ≃ P.inputs) : callerClassWith P e = callerClassWith P e' :=
  callerClassWith_map (𝟙 P) e e'

/-- The caller's profile class obtained from its canonical input enumeration. -/
def callerClass (P : ColoredProfile W) : ProfileClass W (inputCount P) :=
  callerClassWith P (inputEnumeration P)

/-- Identify the representative of the caller's profile class with the caller profile. -/
def callerRepresentativeIso (P : ColoredProfile W) :
    representativeProfile P.outputColor (callerClass P) ≅ P :=
  callerRepresentativeIsoWith P (inputEnumeration P)


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
