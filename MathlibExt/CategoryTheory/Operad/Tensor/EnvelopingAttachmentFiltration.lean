/-!
## The actual degree boundary is the coproduct of original profile boundary quotients
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance degreeBoundarySmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance degreeBoundaryAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

local instance degreeBoundaryPuncturedColimits (n : ℕ) :
    HasColimitsOfShape (PuncturedMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The original class boundary quotient enters the original degree
boundary through the actual original proper marked-face cocone. -/
def degreeBoundarySummand (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) (s : ProfileClass W n) :
    (geometryBalancedProfileArrow D (representativeProfile d s)).left ⟶
      colimit (rawPuncturedDegreeDiagram D n) :=
  (representativeBoundaryIsColimit D d s).desc
    ((colimit.cocone (rawPuncturedDegreeDiagram D n)).whisker (puncturedRepresentativeInclusion s))

theorem degreeBoundarySummand_face (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (s : ProfileClass W n) (S : RepresentativePunctured s) :
    (representativeBoundaryCocone D d s).ι.app S ≫ degreeBoundarySummand D d n s =
      colimit.ι (rawPuncturedDegreeDiagram D n) (representativePuncturedVertex s S) :=
  (representativeBoundaryIsColimit D d s).fac _ S

/-- Both the original degree object and each original quotient source
are retained literally in this constructed profile-class cofan. -/
def degreeBoundaryCofan (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) :
    Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).left) :=
  Cofan.mk (colimit (rawPuncturedDegreeDiagram D n)) (degreeBoundarySummand D d n)

/-- The punctured degree colimit structure after restriction to profile-class representative cubes.
-/
def boundarySigmaIsColimit (D : MarkedInputs W ⥤ C) (n : ℕ) :
    IsColimit ((colimit.cocone (rawPuncturedDegreeDiagram D n)).whisker (puncturedInclusion (W := W) n)) :=
  (Functor.Final.isColimitWhiskerEquiv (puncturedInclusion (W := W) n)
    (colimit.cocone (rawPuncturedDegreeDiagram D n))).symm (colimit.isColimit _)

/-- Any target family of maps from the actual boundary quotients gives
an original cocone on every actual original proper marked profile. -/
def boundaryTargetSigmaCocone (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).left)) :
    Cocone (puncturedInclusion (W := W) n ⋙ rawPuncturedDegreeDiagram D n) where
  pt := t.pt
  ι.app q := (representativeBoundaryCocone D d q.1).ι.app q.2 ≫ t.inj q.1
  ι.naturality := by
    rintro ⟨s, S⟩ ⟨_, T⟩ ⟨f⟩
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ t.inj s) ((representativeBoundaryCocone D d s).w f)).trans
        (Category.comp_id _).symm)

/-- Descend the degree boundary to a cofan of balanced profile boundaries. -/
def degreeBoundaryDesc (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).left)) :
    (degreeBoundaryCofan D d n).pt ⟶ t.pt :=
  (boundarySigmaIsColimit D n).desc (boundaryTargetSigmaCocone D d n t)

theorem degreeBoundaryDesc_fac (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).left))
    (s : ProfileClass W n) : (degreeBoundaryCofan D d n).inj s ≫ degreeBoundaryDesc D d n t = t.inj s := by
  apply (representativeBoundaryIsColimit D d s).hom_ext
  intro S
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ degreeBoundaryDesc D d n t) (degreeBoundarySummand_face D d n s S)).trans
      ((boundarySigmaIsColimit D n).fac (boundaryTargetSigmaCocone D d n t) ⟨s, S⟩))

theorem degreeBoundaryDesc_unique (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ)
    (t : Cofan (fun s : ProfileClass W n => (geometryBalancedProfileArrow D (representativeProfile d s)).left))
    (m : (degreeBoundaryCofan D d n).pt ⟶ t.pt)
    (w : ∀ s, (degreeBoundaryCofan D d n).inj s ≫ m = t.inj s) :
    m = degreeBoundaryDesc D d n t := by
  apply (boundarySigmaIsColimit D n).hom_ext
  rintro ⟨s, S⟩
  exact (congrArg (· ≫ m) (degreeBoundarySummand_face D d n s S).symm).trans
    ((Category.assoc _ _ _).trans
      ((congrArg ((representativeBoundaryCocone D d s).ι.app S ≫ ·) (w s)).trans
        ((boundarySigmaIsColimit D n).fac (boundaryTargetSigmaCocone D d n t) ⟨s, S⟩).symm))

/-- The degree boundary coproduct is proved from the actual original
categories and two original profile quotients, with no decomposition premise. -/
def degreeBoundaryIsColimit (D : MarkedInputs W ⥤ C) (d : W) (n : ℕ) :
    IsColimit (degreeBoundaryCofan D d n) :=
  Cofan.IsColimit.mk _ (degreeBoundaryDesc D d n) (degreeBoundaryDesc_fac D d n)
    (degreeBoundaryDesc_unique D d n)


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource158


