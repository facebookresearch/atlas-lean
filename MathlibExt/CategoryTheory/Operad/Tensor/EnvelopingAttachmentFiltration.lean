section AttachmentSource181


/-!
## Every original caller profile, its original faces and coefficient pushout product
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance callerCofanFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance callerCofanSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance callerCofanAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance callerCofanDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance callerCofanPuncturedColimits (n : ℕ) :
    HasColimitsOfShape (PuncturedMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- Convert a caller's proper input subset to the punctured cube of its representative. -/
def callerBoundarySubset (P : ColoredProfile W) (S : ProfilePuncturedInputSets P) :
    RepresentativePunctured (callerClass P) :=
  fromOriginalProperSet (callerClass P) P.outputColor
    ⟨profileSubsetPreimage (callerRepresentativeIso P) S.1,
      profileSubsetPreimage_punctured (callerRepresentativeIso P) S⟩

/-- Convert a caller's input subset to the full cube of its representative. -/
def callerVertexSubset (P : ColoredProfile W) (S : ProfileInputSets P) :
    RepresentativeCube (callerClass P) := profileSubsetPreimage (callerRepresentativeIso P) S

/-- The comparison retains both genuine original Aut(P) quotient objects. -/
def callerBalancedRepresentativeIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    balancedProfileArrow E x (representativeProfile P.outputColor (callerClass P)) ≅ balancedProfileArrow E x P :=
  profileQuotientArrowIso (markedTensorDiagram E x P.outputColor) (callerRepresentativeIso P)

/-- Identify the representative's unquotiented boundary arrow with the caller's boundary arrow. -/
def callerRawRepresentativeIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor)
      (representativeProfile P.outputColor (callerClass P))) ≅
        Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor) P) :=
  profileRawArrowIso (markedTensorDiagram E x P.outputColor) (callerRepresentativeIso P)

/-- Every original caller profile has its original whole balanced cofan
into the literal original degree arrow, through its actual input/profile Iso. -/
def callerProfileCellCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    balancedProfileArrow E x P ⟶ degreeBalancedArrow E x P.outputColor (inputCount P) :=
  (callerBalancedRepresentativeIso E x P).inv ≫
    operadProfileCellCofan E x P.outputColor (inputCount P) (callerClass P)

theorem callerProfileCellCofan_representative (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (callerBalancedRepresentativeIso E x P).hom ≫ callerProfileCellCofan E x P =
      operadProfileCellCofan E x P.outputColor (inputCount P) (callerClass P) :=
  Iso.hom_inv_id_assoc (callerBalancedRepresentativeIso E x P) _

/-- Every original caller proper face retains its literal original inverse
profile/input map, both original action quotients and the actual degree cofan. -/
theorem callerProfileCellCofan_boundary_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : FullProfilePunctured P) :
    (fullProfileBoundaryCocone (markedTensorDiagram E x P.outputColor) P).ι.app S ≫
        (callerProfileCellCofan E x P).left =
      (markedTensorDiagram E x P.outputColor).map (profileInverseVertex (callerRepresentativeIso P) S.1) ≫
        colimit.ι (puncturedMarkedTensorDiagram E x P.outputColor (inputCount P))
          (representativePuncturedVertex (callerClass P) (callerBoundarySubset P S)) := by
  let D := markedTensorDiagram E x P.outputColor
  let e := callerRepresentativeIso P
  let R := representativeProfile P.outputColor (callerClass P)
  let T : FullProfilePunctured R := ⟨profileSubsetPreimage e S.1, profileSubsetPreimage_punctured e S⟩
  let j := (fullProfileBoundaryCocone D P).ι.app S
  let m := D.map (profileInverseVertex e S.1)
  let f := operadProfileCellCofan E x P.outputColor (inputCount P) (callerClass P)
  exact (Category.assoc j (profileBoundaryPointIso D e).inv f.left).symm.trans
    ((congrArg (· ≫ f.left) (profileBoundaryPointIso_inverse_original D e S)).trans
      ((Category.assoc m ((fullProfileBoundaryCocone D R).ι.app T) f.left).trans
        (congrArg (m ≫ ·) (operadProfileCellCofan_boundary_face E x P.outputColor (inputCount P)
          (callerClass P) (callerBoundarySubset P S)))))

/-- Every original caller full vertex retains its original tensor map and
original to-top map/cofan, including the original nullary top vertex. -/
theorem callerProfileCellCofan_top_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : FullProfileCube P) :
    (fullProfileTopCocone (markedTensorDiagram E x P.outputColor) P).ι.app S ≫
        (callerProfileCellCofan E x P).right =
      (markedTensorDiagram E x P.outputColor).map (profileInverseVertex (callerRepresentativeIso P) S) ≫
        (degreeToTop E x P.outputColor (inputCount P)).app (representativeVertex (callerClass P) (callerVertexSubset P
          S)) ≫
          colimit.ι (degreeTopTensorDiagram E x P.outputColor (inputCount P))
            (representativeVertex (callerClass P) (callerVertexSubset P S)) := by
  let D := markedTensorDiagram E x P.outputColor
  let e := callerRepresentativeIso P
  let R := representativeProfile P.outputColor (callerClass P)
  let T := profileSubsetPreimage e S
  let j := (fullProfileTopCocone D P).ι.app S
  let m := D.map (profileInverseVertex e S)
  let f := operadProfileCellCofan E x P.outputColor (inputCount P) (callerClass P)
  exact (Category.assoc j (profileTopPointIso D e).inv f.right).symm.trans
    ((congrArg (· ≫ f.right) (profileTopPointIso_inverse_original D e S)).trans
      ((Category.assoc m ((fullProfileTopCocone D R).ι.app T) f.right).trans
        (congrArg (m ≫ ·) (operadProfileCellCofan_top_face E x P.outputColor (inputCount P)
          (callerClass P) (callerVertexSubset P S)))))

section PushoutProduct

variable [MonoidalClosed C]

/-- The original caller coefficient pushout product is compared to the
representative's actual original coefficient pushout product by the full raw Iso. -/
def callerProfilePushoutProductIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profilePushoutProductArrow E x (representativeProfile P.outputColor (callerClass P)) ≅ profilePushoutProductArrow E
      x P :=
  (Continuation.originalProfilePushoutProductIso E x (representativeProfile P.outputColor (callerClass P))).symm ≪≫
    callerRawRepresentativeIso E x P ≪≫ Continuation.originalProfilePushoutProductIso E x P

omit [Small.{us} W] in
theorem callerProfilePushoutProductIso_balanced (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (callerProfilePushoutProductIso E x P).hom ≫ Continuation.profilePushoutProductBalancedCofan E x P =
      Continuation.profilePushoutProductBalancedCofan E x (representativeProfile P.outputColor (callerClass P)) ≫
        (callerBalancedRepresentativeIso E x P).hom := by
  let D := markedTensorDiagram E x P.outputColor
  let R := representativeProfile P.outputColor (callerClass P)
  let r := Continuation.originalProfilePushoutProductIso E x R
  let p := Continuation.originalProfilePushoutProductIso E x P
  let a := callerRawRepresentativeIso E x P
  let b := callerBalancedRepresentativeIso E x P
  let k := geometryProfileQuotientProjection D R
  let l := geometryProfileQuotientProjection D P
  have h : a.hom ≫ l = k ≫ b.hom := profileRawQuotientIso_cofan D (callerRepresentativeIso P)
  change (r.inv ≫ a.hom ≫ p.hom) ≫ (p.inv ≫ l) = (r.inv ≫ k) ≫ b.hom
  exact (Category.assoc r.inv (a.hom ≫ p.hom) (p.inv ≫ l)).trans
    ((congrArg (r.inv ≫ ·) (Category.assoc a.hom p.hom (p.inv ≫ l))).trans
      ((congrArg (fun z => r.inv ≫ a.hom ≫ z) (Iso.hom_inv_id_assoc p l)).trans
        ((congrArg (r.inv ≫ ·) h).trans (Category.assoc r.inv k b.hom).symm)))

/-- The actual original coefficient pushout-product cofan at each caller
profile agrees with the representative degree cofan after both original Isos. -/
theorem callerProfilePushoutProductIso_degree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (callerProfilePushoutProductIso E x P).hom ≫
        (Continuation.profilePushoutProductBalancedCofan E x P ≫ callerProfileCellCofan E x P) =
      Continuation.profilePushoutProductBalancedCofan E x (representativeProfile P.outputColor (callerClass P)) ≫
        operadProfileCellCofan E x P.outputColor (inputCount P) (callerClass P) :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ callerProfileCellCofan E x P) (callerProfilePushoutProductIso_balanced E x P)).trans
      ((Category.assoc _ _ _).trans
        (congrArg (Continuation.profilePushoutProductBalancedCofan E x
          (representativeProfile P.outputColor (callerClass P)) ≫ ·) (callerProfileCellCofan_representative E x P))))

theorem callerPushoutProductDegree_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    Continuation.profilePushoutProductAutArrow E x P g ≫
        (Continuation.profilePushoutProductBalancedCofan E x P ≫ callerProfileCellCofan E x P) =
      Continuation.profilePushoutProductBalancedCofan E x P ≫ callerProfileCellCofan E x P :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ callerProfileCellCofan E x P) (Continuation.profilePushoutProductAutArrow_balanced E x P g))

end PushoutProduct


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource181


section AttachmentSource182


/-!
## Actual coordinate-cell refinement of the original profile degree arrow

The order is constructed on the actual profile classes. Every true cell
is the original full balanced profile map, with its original source and
target cofans and its genuine pushout square. The complete original degree
arrow, its continuous coordinate diagram and endpoint cofan are outputs.
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- Choose the well-ordering linear order on the actual degree-`n` profile classes. -/
local instance profileClassLinearOrder (n : ℕ) : LinearOrder (ProfileClass W n) := by
  classical
  exact linearOrderOfSTO (@WellOrderingRel (ProfileClass W n))

local instance profileClassWellFounded (n : ℕ) : WellFoundedLT (ProfileClass W n) :=
  WellOrderingRel.isWellOrder.wf

/-- The coordinate-cell order on degree-`n` profile classes, with initial and final endpoints. -/
abbrev ProfileCellOrder (W : Type uc) (n : ℕ) :=
  MorphismProperty.CoproductCells.cellOrder (ProfileClass W n)

/-- The successor order induced by the well-order on profile-cell coordinates. -/
local instance profileCellSuccOrder (n : ℕ) : SuccOrder (ProfileCellOrder W n) :=
  SuccOrder.ofLinearWellFoundedLT _

instance profileCellOrderSmall [Small.{us} W] (n : ℕ) : Small.{us} (ProfileCellOrder W n) := by
  let f : ((PUnit ⊕ ProfileClass W n) ⊕ PUnit) → ProfileCellOrder W n := fun
    | .inl (.inl _) => ((⊥ : WithBot (ProfileClass W n)) : WithTop _)
    | .inl (.inr s) => MorphismProperty.CoproductCells.cellIndex s
    | .inr _ => ⊤
  apply small_of_surjective.{us} (f := f)
  intro s
  cases s using WithTop.recTopCoe with
  | top => exact ⟨Sum.inr PUnit.unit, rfl⟩
  | coe b =>
    cases b using WithBot.recBotCoe with
    | bot => exact ⟨Sum.inl (Sum.inl PUnit.unit), rfl⟩
    | coe s => exact ⟨Sum.inl (Sum.inr s), rfl⟩

variable [MonoidalCategory C] [SymmetricCategory C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance coordinateFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance coordinateSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance coordinateAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance coordinateDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance coordinatePuncturedColimits (n : ℕ) :
    HasColimitsOfShape (PuncturedMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance coordinateClassColimits (n : ℕ) :
    HasColimitsOfShape (Discrete (ProfileClass W n)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The coordinate diagram that attaches the balanced profile cells one at a time. -/
def profileCellCoordinateDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : ProfileCellOrder W n ⥤ C :=
  MorphismProperty.CoproductCells.cellDiagram (profileCellMaps E x d n)

/-- The source injection for a profile cell at its coordinate in the cell order. -/
def profileCellCoordinateSource (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    (balancedProfileArrow E x (representativeProfile d s)).left ⟶
      (profileCellCoordinateDiagram E x d n).obj (MorphismProperty.CoproductCells.cellIndex s) :=
  MorphismProperty.CoproductCells.cellSourceInjection (profileCellMaps E x d n) s

/-- The target injection for a profile cell at the successor of its coordinate. -/
def profileCellCoordinateTarget (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    (balancedProfileArrow E x (representativeProfile d s)).right ⟶
      (profileCellCoordinateDiagram E x d n).obj (Order.succ (MorphismProperty.CoproductCells.cellIndex s)) :=
  MorphismProperty.CoproductCells.cellTargetInjection (profileCellMaps E x d n) s

/-- Each true refinement cell is the genuine pushout of its actual
original balanced profile arrow, with both original coordinate cofans. -/
theorem profileCellCoordinate_isPushout (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (s : ProfileClass W n) :
    IsPushout (balancedProfileArrow E x (representativeProfile d s)).hom
      (profileCellCoordinateSource E x d n s) (profileCellCoordinateTarget E x d n s)
      ((profileCellCoordinateDiagram E x d n).map
        (homOfLE (Order.le_succ (MorphismProperty.CoproductCells.cellIndex s)))) :=
  MorphismProperty.CoproductCells.cell_isPushout (profileCellMaps E x d n) s

theorem profileCellCoordinate_continuous (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : (profileCellCoordinateDiagram E x d n).IsWellOrderContinuous :=
  MorphismProperty.CoproductCells.coproductDiagram_continuous (profileCellMaps E x d n)
    MorphismProperty.CoproductCells.cellIndex

/-- The true original degree arrow has its constructed complete coordinate
history of original profile cobase changes and the retained dummy isomorphism. -/
def profileCellCoordinateHistory (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    (MorphismProperty.isomorphisms C ⊔ (MorphismProperty.ofHoms (profileCellMaps E x d
      n)).pushouts).TransfiniteCompositionOfShape
      (ProfileCellOrder W n) (degreeBalancedArrow E x d n).hom :=
  (MorphismProperty.CoproductCells.coproductMapOriginalCells (profileCellMaps E x d n)).ofArrowIso
    (operadProfileCoproductIso E x d n)

theorem profileCellCoordinateHistory_diagram (E : ColoredOperadObj W C) {X Xprime : W → C}
