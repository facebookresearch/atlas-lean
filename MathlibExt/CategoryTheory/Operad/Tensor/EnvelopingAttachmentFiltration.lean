section AttachmentSource080



set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc}

/-- Every actual original profile cube is a degree-marked profile diagram,
using solely its original finite input enumeration. -/
def profileDegreeCube (P : ColoredProfile W) :
    FiniteCube.Index (inputCount P) ⥤ DegreeMarkedInputs W (inputCount P) where
  obj S := FiniteCube.vertexFamily (profileDomainMarks P) (profileTopMarks P) S
  map f := InducedCategory.homMk ((profileMarkedCube P).map f)
  map_id S := by
    apply (degreeMarkedInclusion (W := W) (inputCount P)).map_injective
    exact (profileMarkedCube P).map_id S
  map_comp f g := by
    apply (degreeMarkedInclusion (W := W) (inputCount P)).map_injective
    exact (profileMarkedCube P).map_comp f g

theorem profileDegreeCube_punctured (P : ColoredProfile W) (S : FiniteCube.Punctured (inputCount P)) :
    IsPuncturedMarked ((profileDegreeCube P).obj S.1) := by
  classical
  have hn : ∃ i : Fin (inputCount P), i ∉ S.1 := by
    by_contra h
    apply S.2
    exact Finset.eq_univ_iff_forall.mpr (fun i => by
      by_contra hi
      exact h ⟨i, hi⟩)
  rcases hn with ⟨i, hi⟩
  refine ⟨i, ?_⟩
  change (if i ∈ S.1 then profileTopMarks P i else profileDomainMarks P i).1 ≠ Finset.univ
  rw [ite_eq_right hi]
  exact FiniteCube.puncturedOneEmpty.2

/-- Every actual original proper profile face lies in the same original
degree-n punctured symmetry diagram. -/
def profilePuncturedDegreeCube (P : ColoredProfile W) :
    FiniteCube.Punctured (inputCount P) ⥤ PuncturedMarkedInputs W (inputCount P) where
  obj S := ⟨(profileDegreeCube P).obj S.1, profileDegreeCube_punctured P S⟩
  map f := InducedCategory.homMk
    ((profileDegreeCube P).map ((FiniteCube.puncturedInclusion (inputCount P)).map f))
  map_id S := by
    apply (puncturedMarkedInclusion (W := W) (inputCount P)).map_injective
    exact (profileDegreeCube P).map_id S.1
  map_comp f g := by
    apply (puncturedMarkedInclusion (W := W) (inputCount P)).map_injective
    exact (profileDegreeCube P).map_comp _ _

section Tensor

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance cofanFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance cofanSmallestColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance cofanPuncturedColimits (n : ℕ) : HasColimitsOfShape (PuncturedMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

local instance cofanDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The genuine degree boundary receives every original proper profile face
through that same original marked profile and original tensor diagram. -/
def profileBoundaryToDegreeCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Cocone (FiniteCube.punctured (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor)) where
  pt := (degreeBalancedArrow E x P.outputColor (inputCount P)).left
  ι.app S := colimit.ι (puncturedMarkedTensorDiagram E x P.outputColor (inputCount P))
    ((profilePuncturedDegreeCube P).obj S)
  ι.naturality _ _ f :=
    (colimit.w (puncturedMarkedTensorDiagram E x P.outputColor (inputCount P))
      ((profilePuncturedDegreeCube P).map f)).trans (Category.comp_id _).symm

/-- Map a profile's tensor boundary into the balanced boundary of its input degree. -/
def profileBoundaryToDegree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    FiniteCube.boundary (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor) ⟶
      (degreeBalancedArrow E x P.outputColor (inputCount P)).left :=
  FiniteCube.boundaryDesc _ (profileBoundaryToDegreeCocone E x P)

/-- Map a profile's full input tensor into the balanced top object of its degree. -/
def profileTopToDegree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor).obj Finset.univ ⟶
      (degreeBalancedArrow E x P.outputColor (inputCount P)).right :=
  (degreeToTop E x P.outputColor (inputCount P)).app ((profileDegreeCube P).obj Finset.univ) ≫
    colimit.ι (degreeTopTensorDiagram E x P.outputColor (inputCount P))
      ((profileDegreeCube P).obj Finset.univ)

omit [MonoidalClosed C] in
theorem profileBoundaryToDegree_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : FiniteCube.Punctured (inputCount P)) :
    FiniteCube.boundaryι (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor) S ≫
        profileBoundaryToDegree E x P =
      colimit.ι (puncturedMarkedTensorDiagram E x P.outputColor (inputCount P))
        ((profilePuncturedDegreeCube P).obj S) :=
  FiniteCube.boundaryι_desc _ _ _

omit [MonoidalClosed C] in
/-- The original profile boundary and top cofan maps retain their same full
original boundary-to-top arrow inside the degree symmetry quotient. -/
theorem profileBoundaryToDegree_square (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    FiniteCube.boundaryToTop (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor) ≫
        profileTopToDegree E x P =
      profileBoundaryToDegree E x P ≫ (degreeBalancedArrow E x P.outputColor (inputCount P)).hom := by
  let F := profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor
  let D := degreeMarkedTensorDiagram E x P.outputColor (inputCount P)
  let T := degreeTopTensorDiagram E x P.outputColor (inputCount P)
  let a := degreeToTop E x P.outputColor (inputCount P)
  apply FiniteCube.boundary_hom_ext F
  intro S
  let g := (profileDegreeCube P).map (homOfLE (Finset.subset_univ S.1))
  have hn : F.map (homOfLE (Finset.subset_univ S.1)) ≫ profileTopToDegree E x P =
      a.app ((profileDegreeCube P).obj S.1) ≫ colimit.ι T ((profileDegreeCube P).obj S.1) :=
    (Category.assoc (D.map g) _ _).symm.trans
      ((congrArg (· ≫ colimit.ι T ((profileDegreeCube P).obj Finset.univ)) (a.naturality g)).trans
        ((Category.assoc _ _ _).trans
          (congrArg (a.app ((profileDegreeCube P).obj S.1) ≫ ·) (colimit.w T g))))
  have hl := (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ profileTopToDegree E x P) (FiniteCube.boundaryι_boundaryToTop F S))
  have hr := (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ (degreeBalancedArrow E x P.outputColor (inputCount P)).hom)
      (profileBoundaryToDegree_face E x P S)).trans
        (degreeBalancedArrow_face E x P.outputColor (inputCount P) ((profilePuncturedDegreeCube P).obj S)))
  exact hl.trans (hn.trans hr.symm)

/-- Every actual original profile supplies its original arrow cofan into the
actual degree symmetry quotient, with its original boundary and top maps. -/
def profileBoundaryCofanArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Arrow.mk (FiniteCube.boundaryToTop (profileMarkedCube P ⋙ markedTensorDiagram E x P.outputColor)) ⟶
      degreeBalancedArrow E x P.outputColor (inputCount P) :=
  Arrow.homMk (profileBoundaryToDegree E x P) (profileTopToDegree E x P)
    (profileBoundaryToDegree_square E x P).symm

/-- The same cofan starts at the original coefficient tensor of the original
heterogeneous iterated pushout product, through the full original arrow iso. -/
def profilePushoutProductCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profilePushoutProductArrow E x P ⟶ degreeBalancedArrow E x P.outputColor (inputCount P) :=
  (markedProfileBoundaryPushoutProductIso E x P).inv ≫ profileBoundaryCofanArrow E x P


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment

end
