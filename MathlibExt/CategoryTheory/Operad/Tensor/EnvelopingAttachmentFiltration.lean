section AttachmentSource131


/-!
## Actual original tensor coproduct cocones on every original finite profile
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits MonoidalCategory Enveloping

attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The coefficient factor occurs once, through its original identity. -/
def rootCocone (Y : C) : Cocone (Discrete.functor (fun _ : PUnit.{1} => Y)) where
  pt := Y
  ι.app _ := 𝟙 Y
  ι.naturality i j f := by
    rcases i with ⟨i⟩
    rcases j with ⟨j⟩
    cases i
    cases j
    have hf : f = 𝟙 _ := Subsingleton.elim _ _
    rw [hf]
    simp only [Functor.map_id]
    rfl

/-- The actual original coefficient cocone is colimiting, including its
original identity injection and complete descendant uniqueness. -/
def rootIsColimit (Y : C) : IsColimit (rootCocone Y) where
  desc c := c.ι.app ⟨PUnit.unit⟩
  fac c j := by
    rcases j with ⟨j⟩
    cases j
    exact Category.id_comp _
  uniq c f hf := (Category.id_comp f).symm.trans (hf ⟨PUnit.unit⟩)

/-- The original coefficient has one index; every original leaf has the
two actual original coproduct choices. -/
def sumFactorIndex {d : W} (P : AnalyticIndex W d) : Option P.inputs → Type
  | none => Discrete PUnit.{1}
  | some _ => Discrete WalkingPair

instance sumFactorCategory {d : W} (P : AnalyticIndex W d) (i : Option P.inputs) :
    Category.{0} (sumFactorIndex P i) := by
  cases i with
  | none => exact inferInstanceAs (Category.{0} (Discrete PUnit.{1}))
  | some _ => exact inferInstanceAs (Category.{0} (Discrete WalkingPair))

instance sumFactorEssentiallySmall {d : W} (P : AnalyticIndex W d) (i : Option P.inputs) :
    EssentiallySmall.{us} (sumFactorIndex P i) := by
  cases i with
  | none => exact inferInstanceAs (EssentiallySmall.{us} (Discrete PUnit.{1}))
  | some _ => exact inferInstanceAs (EssentiallySmall.{us} (Discrete WalkingPair))

variable [HasColimitsOfSize.{us, us} C]

local instance sumTensorBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)

/-- Every original tensor factor retains its actual coefficient object or its
actual pair of heterogeneous new and old input objects. -/
def sumFactorDiagram (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (i : Option P.inputs) : sumFactorIndex P i ⥤ C := by
  cases i with
  | none => exact Discrete.functor (fun _ : PUnit.{1} => E.obj P.toColoredProfile)
  | some i => exact pair (Xprime (P.inputColor i)) (X (P.inputColor i))

/-- The original coefficient identity and original binary coproduct injections
are the actual factor cocones. -/
def sumFactorCocone (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (i : Option P.inputs) :
    Cocone (sumFactorDiagram E Xprime X P i) := by
  cases i with
  | none => exact rootCocone (E.obj P.toColoredProfile)
  | some i =>
      exact BinaryCofan.mk
        (coprod.inl : Xprime (P.inputColor i) ⟶ Xprime (P.inputColor i) ⨿ X (P.inputColor i))
        coprod.inr

/-- Each original factor cocone is actually colimiting. This is derived from
the source colimits, with no tensor density or endpoint witness supplied. -/
def sumFactorIsColimit (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (i : Option P.inputs) :
    IsColimit (sumFactorCocone E Xprime X P i) := by
  cases i with
  | none => exact rootIsColimit (E.obj P.toColoredProfile)
  | some i => exact coprodIsCoprod (Xprime (P.inputColor i)) (X (P.inputColor i))

variable [FiniteTensor C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C]

/-- Tensor every original factor cocone on the unchanged original finite
coefficient/input index, including the original empty input profile. -/
def sumTensorRawCocone (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) :
    Cocone (FiniteMultifunctor.finiteIndexDiagram
      (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Option P.inputs)))
      (sumFactorDiagram E Xprime X P)) :=
  FiniteMultifunctor.finiteIndexCocone
    (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Option P.inputs)))
    (sumFactorCocone E Xprime X P)

/-- Separate source tensor colimit preservation constructs the full original
tensor coproduct universal property on every original finite profile. -/
def sumTensorRawIsColimit (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) : IsColimit (sumTensorRawCocone E Xprime X P) := by
  letI : DecidableEq (Option P.inputs) := Classical.decEq _
  letI : Functor.PreservesColimitsInEachSlot.{0, u, v, u, v, us}
      (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Option P.inputs))) :=
    FiniteTensorPreservesColimitsInEachSlot.preserves _
  exact FiniteMultifunctor.isColimitFiniteIndexCocone _ (sumFactorIsColimit E Xprime X P)

omit [FiniteTensor C] [FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C] in
/-- The tensor factor-cocone point is the unchanged original analytic factor
family. Only the original factor records are unfolded in this equality. -/
theorem sumTensorTargetFactors (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) :
    (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option P.inputs))).obj
        (fun i => (sumFactorCocone E Xprime X P i).pt) =
      (analyticFactors E (colorSum Xprime X)).obj P := by
  have h : (fun i : Option P.inputs => (sumFactorCocone E Xprime X P i).pt) =
      ((analyticFactors E (colorSum Xprime X)).obj P).obj := by
    funext i
    cases i <;> rfl
  exact congrArg
    (fun f : Option P.inputs → C =>
      (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option P.inputs))).obj f) h

/-- The actual original finite tensor comparison retains the same full
analytic coefficient/input family. -/
def sumTensorTargetIso (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) :
    (sumTensorRawCocone E Xprime X P).pt ≅
      (analyticSummand E (colorSum Xprime X)).obj P :=
  (FiniteTensor.tensor (V := C)).mapIso (eqToIso (sumTensorTargetFactors E Xprime X P))

/-- The original tensor product of factor cocones, at the literal original
analytic summand point through its actual finite-factor comparison. -/
def sumTensorCocone (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) :
    Cocone (FiniteMultifunctor.finiteIndexDiagram
      (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Option P.inputs)))
      (sumFactorDiagram E Xprime X P)) :=
  (sumTensorRawCocone E Xprime X P).extend (sumTensorTargetIso E Xprime X P).hom

/-- The full tensor coproduct universal property has the actual original
profile summand as its point, including every original injection. -/
def sumTensorIsColimit (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) : IsColimit (sumTensorCocone E Xprime X P) :=
  (sumTensorRawIsColimit E Xprime X P).ofIsoColimit
    (Cocone.ext (sumTensorTargetIso E Xprime X P) (fun _ => rfl))

omit [FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C] in
/-- The target is exactly the original profile summand on the original
colorwise coproduct, with the original coefficient and actual leaf objects. -/
theorem sumTensor_pt (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) :
    (sumTensorCocone E Xprime X P).pt =
      (analyticSummand E (colorSum Xprime X)).obj P := rfl

/-- The actual original finite tensor coproduct injections jointly determine
every original whole arrow out of that same original profile summand. -/
theorem sumTensor_hom_ext (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) {Z : C}
    {f g : (analyticSummand E (colorSum Xprime X)).obj P ⟶ Z}
    (h : ∀ p : ∀ i : Option P.inputs, sumFactorIndex P i,
      (sumTensorCocone E Xprime X P).ι.app p ≫ f =
        (sumTensorCocone E Xprime X P).ι.app p ≫ g) : f = g :=
  (sumTensorIsColimit E Xprime X P).hom_ext h


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource131


section AttachmentSource132


/-!
## Original marked choices of the actual free coproduct tensor factors
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits MonoidalCategory Enveloping

attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The two actual coproduct inputs have their original top and old marks. -/
def coproductMark : WalkingPair → FiniteCube.Index 1
  | WalkingPair.left => Finset.univ
  | WalkingPair.right => ∅

/-- Every independent original coproduct choice retains its original input
position and color. The marks do not change the original coefficient profile. -/
def coproductMarkedInputs {d : W} (P : AnalyticIndex W d) (b : P.inputs → WalkingPair) :
    MarkedInputs W where
  index := P.inputs
  obj i := (coproductMark (b i), Discrete.mk (P.inputColor i))

/-- The actual original coproduct factor is exactly its original marked input
object, with both original object transports retained. -/
def choiceCarrierIso {X Xprime : W → C} (x : X ⟶ Xprime) (r : W) (b : WalkingPair) :
    (pair (Xprime r) (X r)).obj ⟨b⟩ ≅
      (markedInputCarrier x).obj (coproductMark b, Discrete.mk r) := by
  cases b with
  | left => exact (eqToIso (markedCarrier_top x r)).symm
  | right => exact (eqToIso (markedCarrier_old x ∅ FiniteCube.puncturedOneEmpty.2 r)).symm

variable [HasColimitsOfSize.{us, us} C]

local instance choiceBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)

/-- The literal original coproduct inclusion at one actual marked input. -/
def choiceInclusion {X Xprime : W → C} (x : X ⟶ Xprime) (r : W) (b : WalkingPair) :
    (markedInputCarrier x).obj (coproductMark b, Discrete.mk r) ⟶ Xprime r ⨿ X r :=
  if h : coproductMark b = Finset.univ then
    eqToHom (by rw [h]; exact markedCarrier_top x r) ≫ coprod.inl
  else
    eqToHom (markedCarrier_old x (coproductMark b) h r) ≫ coprod.inr

/-- Both actual object transports cancel at the original coproduct inclusion. -/
theorem choiceCarrier_inclusion {X Xprime : W → C} (x : X ⟶ Xprime) (r : W) (b : WalkingPair) :
    (choiceCarrierIso x r b).hom ≫ choiceInclusion x r b =
      (BinaryCofan.mk (coprod.inl : Xprime r ⟶ Xprime r ⨿ X r) coprod.inr).ι.app ⟨b⟩ := by
  cases b with
  | left =>
      let e := eqToIso (markedCarrier_top x r)
      have hi : choiceInclusion x r WalkingPair.left = e.hom ≫ coprod.inl := dite_eq_left rfl
      exact (congrArg (e.inv ≫ ·) hi).trans (e.inv_hom_id_assoc _)
  | right =>
      let e := eqToIso (markedCarrier_old x ∅ FiniteCube.puncturedOneEmpty.2 r)
      have hi : choiceInclusion x r WalkingPair.right = e.hom ≫ coprod.inr :=
        dite_eq_right FiniteCube.puncturedOneEmpty.2
      exact (congrArg (e.inv ≫ ·) hi).trans (e.inv_hom_id_assoc _)

/-- The actual original tuple of tensor-coproduct choices before tensoring. -/
def sumChoiceFactors (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    FiniteFamily C :=
  (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option P.inputs))).obj
    (fun i => (sumFactorDiagram E Xprime X P i).obj (p i))

/-- The original coefficient remains fixed, and each original coproduct input
is compared with its own original marked input object. -/
def choiceFactorsIso (E : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {d : W} (P : AnalyticIndex W d)
    (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    sumChoiceFactors E Xprime X P p ≅
      markedSourceFactors E x d (coproductMarkedInputs P (fun i => (p (some i)).as)) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs))
    (fun i => match i with
      | none => Iso.refl _
      | some i => choiceCarrierIso x (P.inputColor i) (p (some i)).as)

/-- The actual original tuple injection into the tensor factor-cocone point. -/
def sumChoiceRawInjection (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    sumChoiceFactors E Xprime X P p ⟶
      (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option P.inputs))).obj
        (fun i => (sumFactorCocone E Xprime X P i).pt) :=
  (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option P.inputs))).map
    (fun i => (sumFactorCocone E Xprime X P i).ι.app (p i))

/-- The actual original tuple injection at the literal original analytic
factor family, retaining the original finite factor comparison. -/
def sumChoiceInjection (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    sumChoiceFactors E Xprime X P p ⟶ (analyticFactors E (colorSum Xprime X)).obj P :=
  sumChoiceRawInjection E Xprime X P p ≫ eqToHom (sumTensorTargetFactors E Xprime X P)

/-- The original coefficient identity and the two original coproduct
inclusions, on the literal original coefficient/input index. -/
def sumChoiceProfileInjection (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    sumChoiceFactors E Xprime X P p ⟶ (analyticFactors E (colorSum Xprime X)).obj P where
  equiv := Equiv.refl (Option P.inputs)
  hom i := match i with
    | none => 𝟙 (E.obj P.toColoredProfile)
    | some i =>
        (BinaryCofan.mk (coprod.inl : Xprime (P.inputColor i) ⟶
          Xprime (P.inputColor i) ⨿ X (P.inputColor i)) coprod.inr).ι.app (p (some i))

/-- The comparison to the original analytic factor record transports every
original factor by precisely its own original object equality. -/
theorem sumChoiceInjection_profile (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    sumChoiceInjection E Xprime X P p = sumChoiceProfileInjection E Xprime X P p := by
  let F := FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option P.inputs))
  have h : (fun i : Option P.inputs => (sumFactorCocone E Xprime X P i).pt) =
      ((analyticFactors E (colorSum Xprime X)).obj P).obj := by
    funext i
    cases i <;> rfl
  have he : eqToHom (sumTensorTargetFactors E Xprime X P) = F.map (eqToHom h) :=
    (eqToHom_map F h).symm
  change sumChoiceRawInjection E Xprime X P p ≫ eqToHom (sumTensorTargetFactors E Xprime X P) = _
  apply (congrArg (sumChoiceRawInjection E Xprime X P p ≫ ·) he).trans
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    have hi := Functor.eqToHom_proj h i
    cases i with
    | none =>
      change HEq (𝟙 (E.obj P.toColoredProfile) ≫ (eqToHom h) none) (𝟙 _)
      have hc : (eqToHom h) none = 𝟙 (E.obj P.toColoredProfile) := hi
      exact heq_of_eq ((congrArg (𝟙 (E.obj P.toColoredProfile) ≫ ·) hc).trans (Category.id_comp _))
    | some i =>
      let j := (BinaryCofan.mk (coprod.inl : Xprime (P.inputColor i) ⟶
        Xprime (P.inputColor i) ⨿ X (P.inputColor i)) coprod.inr).ι.app (p (some i))
      change HEq (j ≫ (eqToHom h) (some i)) j
      have hc : (eqToHom h) (some i) = 𝟙 (Xprime (P.inputColor i) ⨿ X (P.inputColor i)) := hi
      exact heq_of_eq ((congrArg (j ≫ ·) hc).trans (Category.comp_id j))

/-- Every original tensor-coproduct tuple is its original mixed marked
representative with exactly the same coefficient and original leaf inclusions. -/
theorem choiceFactors_mixed (E : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {d : W} (P : AnalyticIndex W d)
    (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    (choiceFactorsIso E x P p).hom ≫
        mixedFactorsMap E x d (coproductMarkedInputs P (fun i => (p (some i)).as)) =
      sumChoiceInjection E Xprime X P p := by
  apply Eq.trans (b := sumChoiceProfileInjection E Xprime X P p)
  · apply FiniteFamily.Hom_ext
    · apply Equiv.ext
      intro i
      cases i <;> rfl
    · intro i
      cases i with
      | none =>
          change HEq (𝟙 (E.obj P.toColoredProfile) ≫ (𝟙 _ ≫ 𝟙 _)) (𝟙 _)
          exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))
      | some i =>
          let b := (p (some i)).as
          let e := choiceCarrierIso x (P.inputColor i) b
          let M := coproductMarkedInputs P (fun i => (p (some i)).as)
          let l := (mixedLeafMap x d M).hom i
          have hl : l = choiceInclusion x (P.inputColor i) b := rfl
          change HEq (e.hom ≫ (l ≫ 𝟙 _))
            ((BinaryCofan.mk (coprod.inl : Xprime (P.inputColor i) ⟶
              Xprime (P.inputColor i) ⨿ X (P.inputColor i)) coprod.inr).ι.app (p (some i)))
          exact heq_of_eq ((congrArg (e.hom ≫ ·) (Category.comp_id l)).trans
            ((congrArg (e.hom ≫ ·) hl).trans (choiceCarrier_inclusion x (P.inputColor i) b)))
  · exact (sumChoiceInjection_profile E Xprime X P p).symm


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource132


section AttachmentSource133


/-!
## Joint density of the original mixed free coproduct profile cofactors
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits MonoidalCategory Enveloping

attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [HasColimitsOfSize.{us, us} C]

section Tensor

variable [FiniteTensor C]

/-- Each actual tensor-coproduct injection is the tensor of its original
whole finite-factor injection, including the actual target comparison. -/
theorem sumTensorCocone_injection (E : ColoredSymmetricCollection W C) (Xprime X : W → C)
    {d : W} (P : AnalyticIndex W d) (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    (sumTensorCocone E Xprime X P).ι.app p =
      (FiniteTensor.tensor (V := C)).map (sumChoiceInjection E Xprime X P p) :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm

end Tensor

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance densityFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance densityTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance densityProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every actual original tensor-coproduct injection followed by its original
free profile cofan is precisely the original mixed marked cofan through its
actual original input-object comparison. -/
theorem sumTensorCocone_mixed (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {d : W} (P : AnalyticIndex W d)
    (p : ∀ i : Option P.inputs, sumFactorIndex P i) :
    (sumTensorCocone E.toCollection Xprime X P).ι.app p ≫
        profileι E.toCollection (colorSum Xprime X) P =
      (FiniteTensor.tensor (V := C)).map (choiceFactorsIso E.toCollection x P p).hom ≫
        mixedCofan E x d (coproductMarkedInputs P (fun i => (p (some i)).as)) := by
  let T := FiniteTensor.tensor (V := C)
  let M := coproductMarkedInputs P (fun i => (p (some i)).as)
  let i := (choiceFactorsIso E.toCollection x P p).hom
  let m := mixedFactorsMap E.toCollection x d M
  let j := (sumTensorCocone E.toCollection Xprime X P).ι.app p
  let k := profileι E.toCollection (colorSum Xprime X) P
  have hj : j = T.map (sumChoiceInjection E.toCollection Xprime X P p) :=
    sumTensorCocone_injection E.toCollection Xprime X P p
  have hm : T.map (sumChoiceInjection E.toCollection Xprime X P p) = T.map i ≫ T.map m :=
    (congrArg T.map (choiceFactors_mixed E.toCollection x P p).symm).trans (T.map_comp _ _)
  exact (congrArg (· ≫ k) hj).trans
    ((congrArg (· ≫ k) hm).trans (Category.assoc (T.map i) (T.map m) k))

/-- The original mixed marked cofactors jointly determine every whole arrow
out of the actual original free coproduct algebra carrier. This includes every
finite heterogeneous profile, arbitrary colors, all permutations and nullary
profiles. The density is derived from the original factor and profile colimits. -/
theorem mixedCofan_hom_ext (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {Z : C}
    {f g : (freeAlgebra E (colorSum Xprime X)).carrier d ⟶ Z}
    (h : ∀ P : MarkedInputs W, mixedCofan E x d P ≫ f = mixedCofan E x d P ≫ g) : f = g := by
  apply colimit.hom_ext
  intro P
  apply sumTensor_hom_ext E.toCollection Xprime X P
  intro p
  let T := FiniteTensor.tensor (V := C)
  let M := coproductMarkedInputs P (fun i => (p (some i)).as)
  let j := (sumTensorCocone E.toCollection Xprime X P).ι.app p
  let k := profileι E.toCollection (colorSum Xprime X) P
  let i := T.map (choiceFactorsIso E.toCollection x P p).hom
  let c := mixedCofan E x d M
  have hc : j ≫ k = i ≫ c := sumTensorCocone_mixed E x P p
  have hh : c ≫ f = c ≫ g := h M
  exact (Category.assoc j k f).symm.trans
    ((congrArg (· ≫ f) hc).trans
      ((Category.assoc i c f).trans
        ((congrArg (i ≫ ·) hh).trans
          ((Category.assoc i c g).symm.trans
            ((congrArg (· ≫ g) hc).symm.trans (Category.assoc j k g))))))


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource133


section AttachmentSource134


/-!
## The original free coproduct relations in the actual constructed countable carrier
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping EndpointRelations

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationOmegaRelationsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationOmegaRelationsSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationOmegaRelationsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationOmegaRelationsFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The actual original free-sum relation maps are equalized by the
constructed countable carrier map, on every whole original carrier. -/
theorem omegaFreeMap_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (relationLeft E a).hom d ≫ omegaFreeMap E x a d =
      (relationRight E x).hom d ≫ omegaFreeMap E x a d := by
  apply mixedCofan_hom_ext E x d
  intro P
  let m := omegaFreeMap E x a d
  let c := mixedCofan E x d P
  let n := normalizedMarkedFaceContraction E x a d P
  let t := (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P)
  let p := (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom
  let i := profileι E.toCollection Xprime (profileInputs (survivingProfile d P))
  let j := profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj P))
  have hi : i ≫ m = omegaProfileCofan E x a (survivingProfile d P) :=
    omegaFreeMap_profile E x a d (profileInputs (survivingProfile d P))
  have hj : j ≫ m = omegaProfileCofan E x a ((markedProfileFunctor d).obj P) :=
    omegaFreeMap_profile E x a d (profileInputs ((markedProfileFunctor d).obj P))
  have hl : c ≫ (relationLeft E a).hom d ≫ m = n ≫ omegaProfileCofan E x a (survivingProfile d P) :=
    (Category.assoc c _ m).symm.trans
      ((congrArg (· ≫ m) (mixedCofan_relationLeft E x a d P)).trans
        ((Category.assoc n i m).trans (congrArg (n ≫ ·) hi)))
  have hr : c ≫ (relationRight E x).hom d ≫ m =
      t ≫ p ≫ omegaProfileCofan E x a ((markedProfileFunctor d).obj P) :=
    (Category.assoc c _ m).symm.trans
      ((congrArg (· ≫ m) (mixedCofan_relationRight E x d P)).trans
        ((Category.assoc t (p ≫ j) m).trans
          ((congrArg (t ≫ ·) (Category.assoc p j m)).trans (congrArg (fun z => t ≫ p ≫ z) hj))))
  exact hl.trans ((omega_markedFace E x a d P).trans hr.symm)

/-- The endpoint relation cofork carried by the stage colimit and its free-algebra map. -/
def omegaCofork (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Cofork ((relationLeft E a).hom d) ((relationRight E x).hom d) :=
  Cofork.ofπ (omegaFreeMap E x a d) (omegaFreeMap_relation E x a d)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

