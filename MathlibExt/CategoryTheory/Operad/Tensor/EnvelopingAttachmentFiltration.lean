namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem topFactorsMap_marked (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    topFactorsMap O x ((markedProfileFunctor d).map g) =
      (coefficientInputFactors (markedProfileFunctor d ⋙ O) (FiniteFamily.map (markedInputCarrier x))).map
        ((allTopInputs (W := W)).map g) := by
  let f := (markedProfileFunctor d).map g
  have hp : f = (markedProfileFunctor d).map ((allTopInputs (W := W)).map g) := ColoredProfile.Hom.ext rfl
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (congrArg O.map hp)
    | some i =>
        let F := markedInputCarrier x
        have h : ((topProfileHom (W := W) f).hom i) = (((allTopInputs (W := W)).map g).hom i) :=
          Subsingleton.elim _ _
        exact heq_of_eq (congrArg F.map h)

variable [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationMarkedTopFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The original marked input map at full tops is the original operation
profile map, with its actual original coefficient and color actions. -/
theorem topOperationTensorIso_marked (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedTensorDiagram E x d).map ((allTopInputs (W := W)).map g) ≫
      (topOperationTensorIso E x ((markedProfileFunctor d).obj Q)).hom =
    (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
      (operationSummandFunctor E.toCollection Xprime).map ((markedProfileFunctor d).map g) := by
  let T := FiniteTensor.tensor (V := C)
  have h : T.map (topFactorsMap E.toCollection x ((markedProfileFunctor d).map g)) =
      (markedTensorDiagram E x d).map ((allTopInputs (W := W)).map g) :=
    congrArg T.map (topFactorsMap_marked E.toCollection x d g)
  exact (congrArg (· ≫ (topOperationTensorIso E x ((markedProfileFunctor d).obj Q)).hom) h.symm).trans
    (topOperationTensorIso_map E x ((markedProfileFunctor d).map g))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
