section AttachmentSource083



set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc}

/-- The empty marked word, as an object of the degree-zero marked-input category. -/
def zeroMarkedWord : DegreeMarkedInputs W 0 := Fin.elim0

/-- The canonical morphism from a degree-zero marking to the empty marked word. -/
def toZeroMarkedWord (P : DegreeMarkedInputs W 0) : P ⟶ zeroMarkedWord :=
  InducedCategory.homMk
    { equiv := Equiv.refl (Fin 0)
      hom i := Fin.elim0 i }

/-- The original degree-zero profile category has its original empty profile
as terminal, without an inhabited-color assumption. -/
def zeroMarkedIsTerminal : IsTerminal (zeroMarkedWord (W := W)) :=
  IsTerminal.ofUniqueHom toZeroMarkedWord (fun P f => by
    apply (degreeMarkedInclusion (W := W) 0).map_injective
    apply markedHom_ext
    apply Equiv.ext
    intro i
    exact Fin.elim0 i)

/-- There is no original proper face in degree zero. -/
instance zeroPuncturedMarkedEmpty : IsEmpty (PuncturedMarkedInputs W 0) where
  false P := by
    rcases P.2 with ⟨i, _⟩
    exact Fin.elim0 i

/-- The nullary colored profile with output color `d`, obtained from the empty marked word. -/
def zeroMarkedProfile (d : W) : ColoredProfile W :=
  (markedProfileFunctor d).obj
    ((allTopInputs (W := W)).obj ((degreeMarkedInclusion (W := W) 0).obj zeroMarkedWord))

/-- The actual degree-zero representative retains its original output color
and is the original nullary coefficient profile. -/
def zeroMarkedProfileHom (d : W) : zeroMarkedProfile d ⟶ ColoredProfile.nullary d where
  inputEquiv := Equiv.refl (Fin 0)
  inputColor_eq i := Fin.elim0 i
  outputColor_eq := rfl

section Tensor

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance zeroDegreeFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance zeroDegreeColimits : HasColimitsOfShape (DegreeMarkedInputs W 0) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The original degree-zero coefficient/input family is the singleton of
its original coefficient, retaining the actual empty Option index comparison. -/
def zeroMarkedFactorsIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) :
    (coefficientInputFactors (markedProfileFunctor d ⋙ E.toCollection)
      (FiniteFamily.map (markedInputCarrier x))).obj
      ((allTopInputs (W := W)).obj ((degreeMarkedInclusion (W := W) 0).obj zeroMarkedWord)) ≅
      (FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (zeroMarkedProfile d)) :=
  FiniteFamily.isoOfComponents (Equiv.ofUnique (Option (Fin 0)) PUnit) (fun i => by
    cases i with
    | none => exact Iso.refl _
    | some i => exact Fin.elim0 i)

/-- The actual degree-zero marked tensor is precisely the original nullary E
coefficient, by the original singleton tensor unitor and profile comparison. -/
def zeroMarkedTensorIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) :
    (degreeTopTensorDiagram E x d 0).obj zeroMarkedWord ≅
      E.toCollection.obj (ColoredProfile.nullary d) :=
  (FiniteTensor.tensor (V := C)).mapIso (zeroMarkedFactorsIso E x d) ≪≫
    (FiniteTensor.singletonIso (V := C)).app (E.toCollection.obj (zeroMarkedProfile d)) ≪≫
    E.toCollection.mapIso (asIso (zeroMarkedProfileHom d))

/-- The original degree-zero balanced top is the actual carrier of the
constructed initial algebra, with the complete original nullary comparison. -/
def zeroBalancedInitialIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) : degreeBalancedTop E x d 0 ≅ (initialAlgebra E).carrier d := by
  let : HasTerminal (DegreeMarkedInputs W 0) := (zeroMarkedIsTerminal (W := W)).hasTerminal
  exact colimitOfTerminal (degreeTopTensorDiagram E x d 0) ≪≫
    (degreeTopTensorDiagram E x d 0).mapIso
      (terminalIsTerminal.uniqueUpToIso (zeroMarkedIsTerminal (W := W))) ≪≫
    zeroMarkedTensorIso E x d ≪≫ nullaryInitialIso E d


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment

