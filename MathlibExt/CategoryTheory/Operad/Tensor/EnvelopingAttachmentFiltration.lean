/-!
## The exact original O-algebra pushout carrier arrow and its degree history
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits InitialAttachment InitialAttachment.Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance rootArrowFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance rootArrowSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance rootArrowProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original recursive zero-stage cofan is the literal original old
Env-algebra endpoint leg, at every original output color. -/
theorem endpointCocone_zero (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (endpointCocone O A x y).ι.app 0 =
      (InitialAttachment.endpointOldMap (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y)).hom := by
  funext d
  exact recursiveStageRootMap_toEndpoint (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d

/-- The constructed whole original A-root arrow is precisely the underlying
original O-algebra pushout old leg. The original A/nil carrier and complete
original endpoint carrier are retained, with no Arrow comparison supplied. -/
theorem rootMap_original (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    rootMap O A x y = (OriginalAttachment.oldMap O A x y).hom :=
  (congrArg ((zeroIso O A x y).hom ≫ ·) (endpointCocone_zero O A x y)).trans
    (OriginalAttachment.canonicalEndpointMap_hom O A x y)

/-- The actual countable carrier-family history has the SAME original
O-algebra pushout arrow, original A source and original endpoint carrier. -/
def originalHistory (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    TransfiniteCompositionOfShape ℕ (OriginalAttachment.oldMap O A x y).hom :=
  (history O A x y).ofArrowIso (eqToIso (congrArg Arrow.mk (rootMap_original O A x y)))

/-- The same original countable history retains its literal original whole
recursive carrier-family diagram. -/
theorem originalHistory_diagram (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (originalHistory O A x y).F = diagram O A x y := rfl

/-- The genuine original balanced degree arrows in the original carrier
family category, constructed with every original output color. -/
def degreeProperty (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) : MorphismProperty (W → C) :=
  MorphismProperty.ofHoms (fun N : ℕ => degreeMap O A x N)

/-- The SAME original carrier arrow has an actual countable composition
of genuine cobase changes of its original balanced degree arrows. Every
successor is the original literal recursive pushout, not an input certificate. -/
def originalDegreeHistory (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (degreeProperty O A x).pushouts.TransfiniteCompositionOfShape ℕ (OriginalAttachment.oldMap O A x y).hom where
  __ := originalHistory O A x y
  map_mem N _hMax :=
    (degreeProperty O A x).pushouts_mk (historySuccessorIsPushout O A x y N) (MorphismProperty.ofHoms.mk N)

/-- Every original degree-history step is the actual original pushout of
the actual original degree balanced boundary-to-top arrow. -/
theorem originalDegreeHistory_successor (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    IsPushout (attachingFamilyMap O A x y N) (degreeMap O A x N)
      ((originalDegreeHistory O A x y).F.map (homOfLE (Nat.le_succ N))) (successorNewMap O A x y N) :=
  historySuccessorIsPushout O A x y N


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
