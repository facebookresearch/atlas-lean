/-- Original coefficient and leaf comparisons identify the actual marked
source factors with the original full profile coefficient and its original
heterogeneous X/X′ cube leaves. -/
def profileMarkedFactorsIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : FiniteCube.Index (inputCount P)) :
    (coefficientInputFactors (markedProfileFunctor P.outputColor ⋙ E.toCollection)
      (FiniteFamily.map (markedInputCarrier x))).obj ((profileMarkedCube P).obj S) ≅
      (coefficientLeafFamilyFunctor ((rawProfileLeafCube x P).obj S)).obj (E.toCollection.obj P) :=
  coefficientLeafIso (E.toCollection.mapIso (asIso (profileMarkedVertexHom P S)))
    (profileMarkedLeafFamilyIso x P S)

theorem profileMarkedFactorsIso_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) {S T : FiniteCube.Index (inputCount P)} (f : S ⟶ T) :
    (coefficientInputFactors (markedProfileFunctor P.outputColor ⋙ E.toCollection)
      (FiniteFamily.map (markedInputCarrier x))).map ((profileMarkedCube P).map f) ≫
        (profileMarkedFactorsIso E x P T).hom =
      (profileMarkedFactorsIso E x P S).hom ≫
        coefficientLeafMap (𝟙 (E.toCollection.obj P)) ((rawProfileLeafCube x P).map f) := by
  have hc : E.toCollection.map ((markedProfileFunctor P.outputColor).map ((profileMarkedCube P).map f)) ≫
      E.toCollection.map (profileMarkedVertexHom P T) = E.toCollection.map (profileMarkedVertexHom P S) :=
    (E.toCollection.map_comp _ _).symm.trans
      (congrArg E.toCollection.map (profileMarkedVertexHom_face P f))
  let c := E.toCollection.map ((markedProfileFunctor P.outputColor).map ((profileMarkedCube P).map f))
  let pS := E.toCollection.map (profileMarkedVertexHom P S)
  let pT := E.toCollection.map (profileMarkedVertexHom P T)
  let l := (FiniteFamily.map (markedInputCarrier x)).map ((profileMarkedCube P).map f)
  let lS := (profileMarkedLeafFamilyIso x P S).hom
  let lT := (profileMarkedLeafFamilyIso x P T).hom
  let g := (rawProfileLeafCube x P).map f
  have hc' : c ≫ pT = pS ≫ 𝟙 (E.toCollection.obj P) := hc.trans (Category.comp_id _).symm
  exact (coefficientLeafMap_comp c pT l lT).trans
    ((congrArg (fun k => coefficientLeafMap k (l ≫ lT)) hc').trans
      ((congrArg (coefficientLeafMap (pS ≫ 𝟙 (E.toCollection.obj P)))
        (profileMarkedLeafFamilyIso_face x P f)).trans
          (coefficientLeafMap_comp pS (𝟙 (E.toCollection.obj P)) lS g).symm))

/-- The actual marked profile cube vertex is the same original coefficient
tensor of the shared canonical heterogeneous FiniteCube vertex. The complete
comparison uses the original coefficient permutation, original leaf objects,
actual OfSymmetric finite tensor and original ordered enumeration comparison. -/
