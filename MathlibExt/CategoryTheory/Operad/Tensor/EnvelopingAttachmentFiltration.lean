section AttachmentSource081


/-!
## Original input-set coefficient arrows and their actual iterated pushout products
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory

private theorem AttachmentSource081_comparisonCofan {D : Type*} [Category* D] {A B C E : D}
    (e : A ≅ B) (f : A ≅ C) (k : A ⟶ E) :
    (e.symm ≪≫ f).inv ≫ (e.inv ≫ k) = f.inv ≫ k := by
  simp only [Iso.trans_inv, Iso.symm_inv, Category.assoc, Iso.hom_inv_id_assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The actual original finite input-set attaching arrow is the actual
coefficient tensor of the original iterated heterogeneous x pushout product. -/
def originalProfilePushoutProductIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor) P) ≅ profilePushoutProductArrow E x P :=
  (canonicalOriginalInputArrowIso (markedTensorDiagram E x P.outputColor) P).symm ≪≫
    markedProfileBoundaryPushoutProductIso E x P

/-- The original full degree cofan starts at the original input-set
attaching arrow and retains both original boundary and top components. -/
def originalProfileDegreeCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor) P) ⟶ degreeBalancedArrow E x P.outputColor
      (inputCount P) :=
  (canonicalOriginalInputArrowIso (markedTensorDiagram E x P.outputColor) P).inv ≫ profileBoundaryCofanArrow E x P

/-- The actual original coefficient pushout-product cofan is unchanged
under the full original input-set comparison, including every proper face. -/
theorem originalProfilePushoutProductIso_degreeCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (originalProfilePushoutProductIso E x P).inv ≫ originalProfileDegreeCofan E x P = profilePushoutProductCofan E x P
      :=
  AttachmentSource081_comparisonCofan _ _ _

/-- The actual original full Aut(P) quotient arrow receives the genuine
coefficient tensor pushout product through the original quotient cofan. -/
def profilePushoutProductBalancedCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : profilePushoutProductArrow E x P ⟶ balancedProfileArrow E x P :=
  (originalProfilePushoutProductIso E x P).inv ≫ balancedProfileArrowCofan E x P

omit [Small.{us} W] in
/-- The balanced-profile cofan retains exactly both actual original
Aut(P) quotient legs after the original full Arrow comparison. -/
theorem originalProfilePushoutProductIso_balancedCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (originalProfilePushoutProductIso E x P).hom ≫ profilePushoutProductBalancedCofan E x P = balancedProfileArrowCofan
      E x P := by
  let e := originalProfilePushoutProductIso E x P
  let k := balancedProfileArrowCofan E x P
  exact (Category.assoc e.hom e.inv k).symm.trans ((congrArg (· ≫ k) e.hom_inv_id).trans (Category.id_comp k))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource081


section AttachmentSource082


/-!
## The original profile action on the actual coefficient pushout-product arrow
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory

private theorem AttachmentSource082_conjugate_one {D : Type*} [Category* D] {A B : D} (e : A ≅ B) :
    e.inv ≫ (𝟙 A) ≫ e.hom = 𝟙 B := by
  simp only [Category.id_comp, e.inv_hom_id]

private theorem AttachmentSource082_conjugate_mul {D : Type*} [Category* D] {A B : D} (e : A ≅ B)
    (f g : A ⟶ A) :
    e.inv ≫ (g ≫ f) ≫ e.hom =
      (e.inv ≫ g ≫ e.hom) ≫ (e.inv ≫ f ≫ e.hom) := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc]

private theorem AttachmentSource082_conjugate_invariant {D : Type*} [Category* D] {A B Z : D}
    (e : A ≅ B) (f : A ⟶ A) (k : A ⟶ Z) (h : f ≫ k = k) :
    (e.inv ≫ f ≫ e.hom) ≫ (e.inv ≫ k) = e.inv ≫ k := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc, h]

private theorem AttachmentSource082_conjugate_face {D : Type*} [Category* D] {A B V V' : D}
    (e : A ≅ B) (f : A ⟶ A) (j : V ⟶ A) (j' : V' ⟶ A) (q : V ⟶ V')
    (h : j ≫ f = q ≫ j') :
    (j ≫ e.hom) ≫ (e.inv ≫ f ≫ e.hom) = q ≫ (j' ≫ e.hom) := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  exact (Category.assoc j f e.hom).symm.trans
    ((congrArg (· ≫ e.hom) h).trans (Category.assoc q j' e.hom))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationActionFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance continuationActionSmallestColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The action square consists of the original boundary permutation map
and original coefficient/input permutation at the full top. -/
def originalProfileAutArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor) P) ⟶
      Arrow.mk (geometryBoundaryToTop (markedTensorDiagram E x P.outputColor) P) :=
  Arrow.homMk (boundaryAutMap E x P g) (inputTopRepresentation E x P g).asHom
    (geometryBoundaryToTop_equivariance (markedTensorDiagram E x P.outputColor) P g)

theorem originalProfileAutArrow_one (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    originalProfileAutArrow E x P 1 = 𝟙 _ := by
  apply Arrow.hom_ext
  · exact boundaryAutMap_one E x P
  · exact congrArg End.asHom (inputTopRepresentation E x P).map_one

theorem originalProfileAutArrow_mul (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (f g : Aut P) :
    originalProfileAutArrow E x P (f * g) =
      originalProfileAutArrow E x P g ≫ originalProfileAutArrow E x P f := by
  apply Arrow.hom_ext
  · exact boundaryAutMap_mul E x P f g
  · exact congrArg End.asHom ((inputTopRepresentation E x P).map_mul f g)

/-- Both genuine original coinvariant cofans satisfy the action relation. -/
theorem originalProfileAutArrow_balanced (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    originalProfileAutArrow E x P g ≫ balancedProfileArrowCofan E x P =
      balancedProfileArrowCofan E x P := by
  apply Arrow.hom_ext
  · exact balancedProfileBoundary_relation E x P g
  · exact balancedProfileTop_relation E x P g

section PushoutProduct

variable [MonoidalClosed C]

/-- The genuine profile action on the coefficient tensor pushout product
uses the complete original input-set Arrow comparison. -/
def profilePushoutProductAutArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    profilePushoutProductArrow E x P ⟶ profilePushoutProductArrow E x P :=
  (originalProfilePushoutProductIso E x P).inv ≫ originalProfileAutArrow E x P g ≫
    (originalProfilePushoutProductIso E x P).hom

theorem profilePushoutProductAutArrow_one (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profilePushoutProductAutArrow E x P 1 = 𝟙 _ := by
  exact (congrArg (fun k => (originalProfilePushoutProductIso E x P).inv ≫ k ≫
    (originalProfilePushoutProductIso E x P).hom) (originalProfileAutArrow_one E x P)).trans
      (AttachmentSource082_conjugate_one _)

theorem profilePushoutProductAutArrow_mul (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (f g : Aut P) :
    profilePushoutProductAutArrow E x P (f * g) =
      profilePushoutProductAutArrow E x P g ≫ profilePushoutProductAutArrow E x P f := by
  exact (congrArg (fun k => (originalProfilePushoutProductIso E x P).inv ≫ k ≫
    (originalProfilePushoutProductIso E x P).hom) (originalProfileAutArrow_mul E x P f g)).trans
      (AttachmentSource082_conjugate_mul _ _ _)

theorem profilePushoutProductAutArrow_balanced (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    profilePushoutProductAutArrow E x P g ≫ profilePushoutProductBalancedCofan E x P =
      profilePushoutProductBalancedCofan E x P :=
  AttachmentSource082_conjugate_invariant _ _ _ (originalProfileAutArrow_balanced E x P g)

/-- The original tensor of every actual proper face is retained as a
cofan into the genuine coefficient tensor pushout-product source. -/
def profilePushoutProductFace (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : ProfilePuncturedInputSets P) :
    (originalPuncturedTensor E x P).obj S ⟶ (profilePushoutProductArrow E x P).left :=
  colimit.ι (originalPuncturedTensor E x P) S ≫
    (originalProfilePushoutProductIso E x P).hom.left

/-- The action on each proper face is the actual original coefficient
and heterogeneous input permutation, followed by its relabelled cofan. -/
theorem profilePushoutProductAutArrow_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) (S : ProfilePuncturedInputSets P) :
    profilePushoutProductFace E x P S ≫ (profilePushoutProductAutArrow E x P g).left =
      (markedTensorDiagram E x P.outputColor).map (profileAutInputVertexIso P g S.1).hom ≫
        profilePushoutProductFace E x P ((profileAutPunctured P g).obj S) :=
  AttachmentSource082_conjugate_face ((Arrow.leftFunc : Arrow C ⥤ C).mapIso (originalProfilePushoutProductIso E x P))
    _ _ _ _ (boundaryAutMap_face E x P g S)

/-- The top action retains the complete original top permutation map. -/
theorem profilePushoutProductAutArrow_top (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (g : Aut P) :
    (originalProfilePushoutProductIso E x P).hom.right ≫
      (profilePushoutProductAutArrow E x P g).right =
        (inputTopRepresentation E x P g).asHom ≫
          (originalProfilePushoutProductIso E x P).hom.right := by
  let e := (Arrow.rightFunc : Arrow C ⥤ C).mapIso (originalProfilePushoutProductIso E x P)
  exact (Category.assoc e.hom e.inv _).symm.trans
    ((congrArg (· ≫ _) e.hom_inv_id).trans (Category.id_comp _))

end PushoutProduct


