section AttachmentSource048


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- Regroup successive old-input extensions as one nested coefficient/leaf family. -/
def sequentialInputGroupingIso (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sequentialInputGrouping O X P Q1 Q2 ≅
      coefficientLeavesNested (constantInputFamily O X (extendProfile P Q1) Q2) ((addedAlgebraInputs X).obj Q1) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q1.index))
    (fun i => match i with
      | none => Iso.refl _
      | some i => Iso.refl ((FiniteFamily.singleton (C := C)).obj (X (Q1.obj i).as)))

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationSplitFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationSplitSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationSplitProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

theorem firstInputFactorMap_evaluation (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (sequentialInputGroupingIso E.toCollection X P Q1 Q2).hom ≫
      LeafFusion.firstEvaluation (constantInputFamily E.toCollection X (extendProfile P Q1) Q2)
        ((addedAlgebraInputs X).obj Q1) (E.toCollection.obj (extendProfile P Q1))
        (deletedCoefficientContraction E a (extendProfile P Q1) Q2) = firstInputFactorMap E a P Q1 Q2 := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let K := constantInputFamily E.toCollection X (extendProfile P Q1) Q2
        let f := deletedCoefficientContraction E a (extendProfile P Q1) Q2
        change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 K) ≫ f) f
        exact heq_of_eq ((congrArg (· ≫ f) ((FiniteTensor.tensor (V := C)).map_id K)).trans (Category.id_comp f))
    | some i =>
        let K := (FiniteFamily.singleton (C := C)).obj (X (Q1.obj i).as)
        let f := (FiniteTensor.singletonIso (V := C)).hom.app (X (Q1.obj i).as)
        change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 K) ≫ f) f
        exact heq_of_eq ((congrArg (· ≫ f) ((FiniteTensor.tensor (V := C)).map_id K)).trans (Category.id_comp f))

/-- The literal original sequential contraction is the original first
coefficient/X normalization and contraction followed by the original second contraction. -/
theorem sequentialInputContraction_split (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sequentialInputContraction E a P Q1 Q2 =
      (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (sequentialInputGroupingIso E.toCollection X P Q1 Q2).hom) ≫
      (coefficientLeavesNormalization (constantInputFamily E.toCollection X (extendProfile P Q1) Q2)
          ((addedAlgebraInputs X).obj Q1) ≫
        (coefficientLeafTensorFunctor ((addedAlgebraInputs X).obj Q1)).map
          (deletedCoefficientContraction E a (extendProfile P Q1) Q2)) ≫
      deletedCoefficientContraction E a P Q1 := by
  let T := FiniteTensor.tensor (V := C)
  let K := constantInputFamily E.toCollection X (extendProfile P Q1) Q2
  let M := (addedAlgebraInputs X).obj Q1
  let f := deletedCoefficientContraction E a (extendProfile P Q1) Q2
  let d := deletedCoefficientContraction E a P Q1
  let p := (FiniteTensor.flattenIso (V := C)).hom.app (coefficientLeavesNested K M)
  let e := sequentialInputGroupingIso E.toCollection X P Q1 Q2
  let n := (FiniteTensor.flattenIso (V := C)).hom.app (sequentialInputGrouping E.toCollection X P Q1 Q2)
  let m := T.map ((FiniteFamily.flatten (C := C)).map e.hom)
  let h := T.map ((FiniteFamily.map T).map e.hom)
  let v := T.map (LeafFusion.firstEvaluation K M _ f)
  have hn : m ≫ p = n ≫ h := (FiniteTensor.flattenIso (V := C)).hom.naturality e.hom
  have hv : h ≫ v = T.map (firstInputFactorMap E a P Q1 Q2) :=
    (T.map_comp _ _).symm.trans (congrArg T.map (firstInputFactorMap_evaluation E a P Q1 Q2))
  have hnorm : coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor M).map f = p ≫ v :=
    LeafFusion.firstEvaluation_normalized K M _ f
  have hleft : m ≫ (p ≫ v) ≫ d = n ≫ T.map (firstInputFactorMap E a P Q1 Q2) ≫ d :=
    (congrArg (m ≫ ·) (Category.assoc p v d)).trans
    ((Category.assoc m p (v ≫ d)).symm.trans
      ((congrArg (· ≫ v ≫ d) hn).trans
        ((Category.assoc n h (v ≫ d)).trans
          ((congrArg (n ≫ ·) (Category.assoc h v d).symm).trans (congrArg (n ≫ · ≫ d) hv)))))
  change n ≫ T.map (firstInputFactorMap E a P Q1 Q2) ≫ d =
    m ≫ ((coefficientLeavesNormalization K M ≫ (coefficientLeafTensorFunctor M).map f) ≫ d)
  exact hleft.symm.trans (congrArg (fun k => m ≫ (k ≫ d)) hnorm.symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource048


section AttachmentSource049


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The unchanged original simultaneous map uses the same exact grouping
comparison as the original sequential contraction. -/
def normalizedSimultaneousFactorMap (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
      (constantInputFamily O X (extendProfile P Q1) Q2) ((addedAlgebraInputs X).obj Q1)) ⟶
      constantInputFamily O X P (DisjointNullary.inputSum Q1 Q2) :=
  (FiniteFamily.flatten (C := C)).map (sequentialInputGroupingIso O X P Q1 Q2).inv ≫
    simultaneousInputFactorMap O X P Q1 Q2

theorem normalizedSimultaneous_position_root (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (normalizedSimultaneousFactorMap O X P Q1 Q2).equiv ⟨none, none⟩ = none := rfl

theorem normalizedSimultaneous_position_q2 (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) (i : Q2.index) :
    (normalizedSimultaneousFactorMap O X P Q1 Q2).equiv ⟨none, some i⟩ = some (Sum.inr i) := rfl

theorem normalizedSimultaneous_position_q1 (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) (i : Q1.index) :
    (normalizedSimultaneousFactorMap O X P Q1 Q2).equiv ⟨some i, PUnit.unit⟩ = some (Sum.inl i) := rfl

theorem normalizedSimultaneous_component_root (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (normalizedSimultaneousFactorMap O X P Q1 Q2).hom ⟨none, none⟩ =
      O.map (DisjointNullary.rootSumAssocHom P Q1 Q2) := by
  let A := O.obj (extendProfile (extendProfile P Q1) Q2)
  let f := O.map (DisjointNullary.rootSumAssocHom P Q1 Q2)
  change (𝟙 A ≫ 𝟙 A) ≫ f = f
  exact (congrArg (· ≫ f) (Category.id_comp (𝟙 A))).trans (Category.id_comp f)

theorem normalizedSimultaneous_component_q2 (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) (i : Q2.index) :
    (normalizedSimultaneousFactorMap O X P Q1 Q2).hom ⟨none, some i⟩ = 𝟙 (X (Q2.obj i).as) := by
  let A := X (Q2.obj i).as
  change (𝟙 A ≫ 𝟙 A) ≫ 𝟙 A = 𝟙 A
  exact (congrArg (· ≫ 𝟙 A) (Category.id_comp (𝟙 A))).trans (Category.id_comp (𝟙 A))

theorem normalizedSimultaneous_component_q1 (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) (i : Q1.index) :
    (normalizedSimultaneousFactorMap O X P Q1 Q2).hom ⟨some i, PUnit.unit⟩ = 𝟙 (X (Q1.obj i).as) := by
  let A := X (Q1.obj i).as
  change (𝟙 A ≫ 𝟙 A) ≫ 𝟙 A = 𝟙 A
  exact (congrArg (· ≫ 𝟙 A) (Category.id_comp (𝟙 A))).trans (Category.id_comp (𝟙 A))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
