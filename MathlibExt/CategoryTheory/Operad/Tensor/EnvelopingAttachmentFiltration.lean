/-!
## The genuine full-profile top quotient and its whole universal property
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]

local instance topProfileSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance topProfileAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

theorem cubeProfileAut_top_square (P : ColoredProfile W) {S T : ProfileInputSets P}
    (f : (originalInputCube P).obj S ⟶ (originalInputCube P).obj T) :
    f ≫ (originalInputCube P).map (originalTopFace P T) =
      (originalInputCube P).map (originalTopFace P S) ≫
        (originalInputTopDirectIso P (cubeProfileAut P f)).hom := by
  apply markedHom_ext
  apply Equiv.ext
  intro i
  rfl

omit [HasColimitsOfSize.{us, us} C] in
theorem inputTopAction_direct (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) (g : Aut P) :
    (geometryInputTopRepresentation D P g).asHom = D.map (originalInputTopDirectIso P g).hom :=
  (geometryInputTopRepresentation_hom D P g).trans (D.map_comp _ _).symm

/-- The actual full top cofan uses the original coordinate map and the
original actual Aut(P) top quotient projection, including empty profiles. -/
def topQuotientLeg (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) (S : ProfileInputSets P) :
    (fullCubeTensor D P).obj S ⟶ colimit (geometryInputTopActionFunctor D P) :=
  D.map ((originalInputCube P).map (originalTopFace P S)) ≫
    colimit.ι (geometryInputTopActionFunctor D P) (SingleObj.star (Aut P))

theorem topQuotientLeg_naturality (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    {S T : FullProfileCube P} (f : S ⟶ T) :
    (fullCubeTensor D P).map f ≫ topQuotientLeg D P T = topQuotientLeg D P S := by
  let m := f.hom
  let g := cubeProfileAut P m
  let a := D.map ((originalInputCube P).map (originalTopFace P S))
  let b := D.map ((originalInputCube P).map (originalTopFace P T))
  let A := geometryInputTopActionFunctor D P
  let j := colimit.ι A (SingleObj.star (Aut P))
  have hs : D.map m ≫ b = a ≫ (geometryInputTopRepresentation D P g).asHom :=
    (D.map_comp _ _).symm.trans
      ((congrArg D.map (cubeProfileAut_top_square P m)).trans
        ((D.map_comp _ _).trans (congrArg (a ≫ ·) (inputTopAction_direct D P g).symm)))
  have hg : (geometryInputTopRepresentation D P g).asHom ≫ j = j :=
    colimit.w A (show SingleObj.star (Aut P) ⟶ SingleObj.star (Aut P) from g)
  exact (Category.assoc (D.map m) b j).symm.trans
    ((congrArg (· ≫ j) hs).trans
      ((Category.assoc a _ j).trans (congrArg (a ≫ ·) hg)))

/-- The full-profile cube cocone with vertex the automorphism quotient of its full input object. -/
def fullProfileTopCocone (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) :
    Cocone (fullCubeTensor D P) where
  pt := colimit (geometryInputTopActionFunctor D P)
  ι.app S := topQuotientLeg D P S
  ι.naturality _ _ f := (topQuotientLeg_naturality D P f).trans (Category.comp_id _).symm

theorem fullProfileTopCocone_top (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) :
    (fullProfileTopCocone D P).ι.app Finset.univ =
      colimit.ι (geometryInputTopActionFunctor D P) (SingleObj.star (Aut P)) := by
  have h : originalTopFace P Finset.univ = 𝟙 (Finset.univ : ProfileInputSets P) := Subsingleton.elim _ _
  let j : D.obj ((originalInputCube P).obj Finset.univ) ⟶
      colimit (geometryInputTopActionFunctor D P) :=
    colimit.ι (geometryInputTopActionFunctor D P) (SingleObj.star (Aut P))
  have hm : D.map ((originalInputCube P).map (originalTopFace P Finset.univ)) =
      𝟙 (D.obj ((originalInputCube P).obj Finset.univ)) :=
    (congrArg D.map ((congrArg (originalInputCube P).map h).trans
      ((originalInputCube P).map_id Finset.univ))).trans (D.map_id _)
  exact (congrArg (· ≫ j) hm).trans (Category.id_comp j)

omit [HasColimitsOfSize.{us, us} C] in
theorem fullProfileTargetTop_balanced (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullCubeTensor D P)) (g : Aut P) :
    (geometryInputTopRepresentation D P g).asHom ≫ c.ι.app Finset.univ = c.ι.app Finset.univ :=
  (congrArg (· ≫ c.ι.app Finset.univ) (inputTopAction_direct D P g)).trans
    (c.w (InducedCategory.homMk (originalInputTopDirectIso P g).hom))

/-- The full-input action cocone induced by a cocone on the full profile cube. -/
def fullProfileTopTargetCocone (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullCubeTensor D P)) : Cocone (geometryInputTopActionFunctor D P) where
  pt := c.pt
  ι.app _ := c.ι.app Finset.univ
  ι.naturality _ _ g := (fullProfileTargetTop_balanced D P c g).trans (Category.comp_id _).symm

/-- Descend the automorphism quotient of the full input object to a full-profile cube cocone. -/
def fullProfileTopDesc (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullCubeTensor D P)) : (fullProfileTopCocone D P).pt ⟶ c.pt :=
  colimit.desc _ (fullProfileTopTargetCocone D P c)

theorem fullProfileTopDesc_face (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullCubeTensor D P)) (S : FullProfileCube P) :
    (fullProfileTopCocone D P).ι.app S ≫ fullProfileTopDesc D P c = c.ι.app S := by
  let a := D.map ((originalInputCube P).map (originalTopFace P S))
  let A := geometryInputTopActionFunctor D P
  let j := colimit.ι A (SingleObj.star (Aut P))
  exact (Category.assoc a j (fullProfileTopDesc D P c)).trans
    ((congrArg (a ≫ ·) (colimit.ι_desc (F := A) (fullProfileTopTargetCocone D P c) _)).trans
      (c.w ((fullProfileFaces P).map (originalTopFace P S))))

theorem fullProfileTopDesc_unique (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullCubeTensor D P)) (m : (fullProfileTopCocone D P).pt ⟶ c.pt)
    (w : ∀ S, (fullProfileTopCocone D P).ι.app S ≫ m = c.ι.app S) :
    m = fullProfileTopDesc D P c := by
  apply colimit.hom_ext (F := geometryInputTopActionFunctor D P)
  intro j
  cases j
  exact (congrArg (· ≫ m) (fullProfileTopCocone_top D P).symm).trans
    ((w Finset.univ).trans
      ((fullProfileTopDesc_face D P c Finset.univ).symm.trans
        (congrArg (· ≫ fullProfileTopDesc D P c) (fullProfileTopCocone_top D P))))

/-- The genuine top quotient is the full original fixed-profile cube
colimit; all source maps and its full universal property are outputs. -/
def fullProfileTopIsColimit (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) :
    IsColimit (fullProfileTopCocone D P) where
  desc := fullProfileTopDesc D P
  fac := fullProfileTopDesc_face D P
  uniq := fullProfileTopDesc_unique D P


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
