section AttachmentSource189

/-!
## Actual original profile cells attached at every recursive stage
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping ProfileCells HomotopicalAlgebra

variable {W : Type uc} [Small.{us} W]

/-- A source-small index for the profile classes attached at successor stage `N`. -/
abbrev StageCellIndex (W : Type uc) [Small.{us} W] (N : ℕ) : Type us :=
  Shrink.{us} (ProfileClass W (N + 1))

/-- Identify the source-small stage-cell index with the degree-`N + 1` profile classes. -/
def stageCellIndexEquiv (N : ℕ) : StageCellIndex W N ≃ ProfileClass W (N + 1) :=
  (equivShrink (ProfileClass W (N + 1))).symm

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationProfileStageCellsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationProfileStageCellsSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationProfileStageCellsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationProfileStageCellsFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The cell arrow is the unchanged original full profile-Aut quotient of
the original coefficient tensor input-cube arrow. -/
def profileStageCellArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (N : ℕ) (s : ProfileClass W (N + 1)) : Arrow C :=
  balancedProfileArrow E x (representativeProfile d s)

/-- The underlying morphism of one profile-class cell at successor stage `N`. -/
def profileStageCellMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (N : ℕ) (s : ProfileClass W (N + 1)) :
    (profileStageCellArrow E x d N s).left ⟶ (profileStageCellArrow E x d N s).right :=
  (profileStageCellArrow E x d N s).hom

/-- The two actual original profile-cell coproduct cofans and proved genuine
successor pushout construct the entire cell-attachment data at this stage. -/
def profileStageCellsLarge (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    AttachCells.{uc} (profileStageCellMap E x d N)
      ((attachmentHistory E x a d).F.map (homOfLE (Nat.le_succ N))) where
  ι := ProfileClass W (N + 1)
  π := id
  cofan₁ := operadBoundaryCofan E x d (N + 1)
  cofan₂ := operadTopCofan E x d (N + 1)
  isColimit₁ := operadBoundaryIsColimit E x d (N + 1)
  isColimit₂ := operadTopIsColimit E x d (N + 1)
  m := (degreeBalancedArrow E x d (N + 1)).hom
  hm s :=
    (congrArg (· ≫ (degreeBalancedArrow E x d (N + 1)).hom)
      (operadProfileCellCofan_left E x d (N + 1) s).symm).trans
        (Arrow.w (operadProfileCellCofan E x d (N + 1) s))
  g₁ := recursiveAttachingMap E x a d N
  g₂ := recursiveNewDegreeCofan E x a d N
  isPushout := attachmentHistory_successorIsPushout E x a d N

/-- The same actual profile cells have a genuinely small index at the
independent source colimit universe; all original cofans and pushout maps are retained. -/
def profileStageCells (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    AttachCells.{us} (profileStageCellMap E x d N)
      ((attachmentHistory E x a d).F.map (homOfLE (Nat.le_succ N))) :=
  (profileStageCellsLarge E x a d N).reindex (stageCellIndexEquiv (W := W) N)

theorem profileStageCells_index (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (profileStageCells E x a d N).ι = StageCellIndex W N := rfl

theorem profileStageCells_type (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (profileStageCells E x a d N).π i = stageCellIndexEquiv (W := W) N i := rfl

/-- Each actual cell inclusion is its unchanged original profile quotient
cofan followed by the literal pushout's original new leg. -/
theorem profileStageCells_cell (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (profileStageCells E x a d N).cell i =
      (operadProfileCellCofan E x d (N + 1) (stageCellIndexEquiv (W := W) N i)).right ≫
        recursiveNewDegreeCofan E x a d N := rfl

/-- The actual source attaching map retains the original balanced boundary
cofan and the original lower-stage contraction map. -/
theorem profileStageCells_attaching (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (profileStageCells E x a d N).cofan₁.inj i ≫ (profileStageCells E x a d N).g₁ =
      (operadProfileCellCofan E x d (N + 1) (stageCellIndexEquiv (W := W) N i)).left ≫
        recursiveAttachingMap E x a d N :=
  congrArg (· ≫ recursiveAttachingMap E x a d N)
    (operadProfileCellCofan_left E x d (N + 1) (stageCellIndexEquiv (W := W) N i)).symm

/-- All original profile cells, successor pushouts, the original initial
carrier and the true original algebra endpoint form an actual relative cell complex. -/
def attachmentRelativeCellComplex (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    RelativeCellComplex.{us} (profileStageCellMap E x d) ((endpointOldMap E x a).hom d) where
  toTransfiniteCompositionOfShape := attachmentHistory E x a d
  attachCells N _hN := profileStageCells E x a d N


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource189


