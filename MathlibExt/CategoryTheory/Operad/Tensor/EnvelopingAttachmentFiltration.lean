section AttachmentSource088


/-!
## The original face map commutes with the genuine residual-input promotion
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory MonoidalCategory Enveloping

private theorem AttachmentSource088_dependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

private theorem AttachmentSource088_carrierTransport {J D : Type*} [Category* J] [Category* D]
    (F : J ⥤ D) {A B : J} {X Y : D} (f : A ⟶ B) [Subsingleton (A ⟶ B)]
    (e : A = B) (hx : F.obj A = X) (hy : F.obj B = Y) (h : X = Y) :
    F.map f ≫ eqToHom hy = eqToHom hx ≫ eqToHom h := by
  have hf : f = eqToHom e := Subsingleton.elim _ _
  rw [hf, eqToHom_map F, eqToHom_trans, eqToHom_trans]

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The literal original residual promotion keeps the coefficient/X block
and promotes only the actual retained X/X′ leaf family. -/
def partialPromotionFactorsMap (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    partialMarkedFactors O x d g ⟶ markedContractionFactors O X Xprime d Q :=
  (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (𝟙 (constantInputFamily O X (survivingProfile d Q) (contractedInputs Q)))
    (residualLeafTopMap x d g))

/-- The original marked source map and the original Q contraction source
normalizer are exactly the residual partial source followed by the original
retained-input promotion. Every actual original input position is retained. -/
theorem partialPromotionFactors_square (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (coefficientInputFactors (markedProfileFunctor d ⋙ O) (FiniteFamily.map (markedInputCarrier x))).map g ≫
        (markedContractionFactorsIso O x d Q).hom =
      (partialMarkedFactorsIso O x d g).hom ≫ partialPromotionFactorsMap O x d g := by
  let F := markedInputCarrier x
  let A := partialMarkedFactors O x d g
  let B := markedContractionFactors O X Xprime d Q
  let H := partialPromotionFactorsMap O x d g
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i =>
        by_cases hi : SelectedInput Q (g.equiv i)
        · change (markedContractionFactorsIso O x d Q).hom.equiv (some (g.equiv i)) =
            H.equiv ((partialMarkedFactorsIso O x d g).hom.equiv (some i))
          exact (markedContraction_position_top O x d Q _ hi).trans
            ((congrArg H.equiv (partialMarked_position_retained O x d g i hi)).trans rfl).symm
        · change (markedContractionFactorsIso O x d Q).hom.equiv (some (g.equiv i)) =
            H.equiv ((partialMarkedFactorsIso O x d g).hom.equiv (some i))
          exact (markedContraction_position_old O x d Q _ hi).trans
            ((congrArg H.equiv (partialMarked_position_old O x d g i hi)).trans rfl).symm
  · intro i
    cases i with
    | none =>
        let f := O.map ((markedProfileFunctor d).map g)
        let s := O.map (asIso (selectionRootHom d Q)).inv
        change HEq (f ≫ s) ((f ≫ s) ≫ 𝟙 _)
        exact heq_of_eq (Category.comp_id _).symm
    | some i =>
        let j := g.equiv i
        by_cases hi : SelectedInput Q (g.equiv i)
        · let r : (survivingInputs Q).index := ⟨j, hi⟩
          let p : A.index := (partialMarkedFactorsIso O x d g).hom.equiv (some i)
          let p' : B.index := (markedContractionFactorsIso O x d Q).hom.equiv (some j)
          have hp : p = ⟨some r, PUnit.unit⟩ := partialMarked_position_retained O x d g i hi
          have ha : A.obj p = F.obj ((residualMarkedInputs g).obj r) := congrArg A.obj hp
          have hb : B.obj p' = Xprime (Q.obj j).2.as :=
            congrArg B.obj (markedContraction_position_top O x d Q j hi)
          have hc : B.obj (H.equiv p) = Xprime (Q.obj j).2.as :=
            congrArg (fun t => B.obj (H.equiv t)) hp
          have hh : HEq (H.hom p) ((residualLeafTopMap x d g).hom r) :=
            (AttachmentSource088_dependentApply H.hom hp).trans HEq.rfl
          have hl := heq_comp rfl rfl hb (HEq.rfl : HEq (F.map (g.hom i)) _)
            (markedContraction_component_top O x d Q j hi)
          have hr := heq_comp rfl ha hc (partialMarked_component_retained O x d g i hi) hh
          let eQ : Q.obj j = ((Finset.univ, Discrete.mk (Q.obj j).2.as) : MarkedColor W) :=
            Prod.ext hi rfl
          let t := (((toAllTopInputs (W := W)).app (residualMarkedInputs g)).hom r)
          let e := retainedMarkEq g i hi
          let u := eqToHom (markedCarrier_top x (Q.obj j).2.as)
          have hmarked : g.hom i ≫ eqToHom eQ = eqToHom e ≫ t := Subsingleton.elim _ _
          have hmap : F.map (g.hom i) ≫ F.map (eqToHom eQ) = F.map (eqToHom e) ≫ F.map t :=
