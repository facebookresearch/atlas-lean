/-!
## The actual Env source relation is exactly the original O free-attachment span relation
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance spanReadbackFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance spanReadbackTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance spanReadbackProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original y/x pair of O-algebra maps is equivalent to the
literal original initial-Env/free-Env source relation, on exactly its computed maps. -/
theorem targetCompatibility_iff (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (B : Under A) (z : freeAlgebra O Xprime ⟶ B.right) :
    y ≫ B.hom = (freeAlgebraFunctor O).map x ≫ z ↔
    envAttachingMap O A y ≫ targetOldEnvMap O A B =
      (freeAlgebraFunctor (envelopingOperad O A)).map x ≫ targetNewEnvMap O A B z := by
  constructor
  · exact targetEnvCompatibility O A x y B z
  · intro h
    let E := envelopingOperad O A
    let eE := tensorFreeHomEquiv E X (underAEnvelopingObject O A B)
    let eO := tensorFreeHomEquiv O X B.right
    let c := tensorFreeHomEquiv O Xprime B.right z
    have hright : eE ((freeAlgebraFunctor E).map x ≫ targetNewEnvMap O A B z) = x ≫ c :=
      (InitialAttachment.freeRestriction_source E x (targetNewEnvMap O A B z)).trans
        (congrArg (x ≫ ·) (classifier_lift E Xprime (underAEnvelopingObject O A B) c))
    have hc : sourceClassifier O A y ≫ B.hom.hom = x ≫ c :=
      (envAttachingMap_targetClassifier O A y B).symm.trans ((congrArg eE h).trans hright)
    exact eO.injective ((tensorFreeHomEquiv_target O X y B.hom).trans
      (hc.trans (InitialAttachment.freeRestriction_source O x z).symm))


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

