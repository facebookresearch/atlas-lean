section AttachmentSource047


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem iterationNormalization_position_root (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (iterationNormalizationMap O x d g).equiv ⟨none, none⟩ = ⟨none, none⟩ := rfl

theorem iterationNormalization_position_remaining (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) (i : (iterationRemainingInputs g).index) :
    (iterationNormalizationMap O x d g).equiv ⟨none, some i⟩ = ⟨none, some i⟩ := rfl

theorem iterationNormalization_position_retained (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) (i : (residualMarkedInputs g).index) :
    (iterationNormalizationMap O x d g).equiv ⟨some i, PUnit.unit⟩ =
      ⟨some ((iterationLeafIso x d (residualMarkedInputs g)).hom.equiv i), PUnit.unit⟩ := rfl

theorem iterationNormalization_component_root (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (iterationNormalizationMap O x d g).hom ⟨none, none⟩ =
      O.map (extendProfileMap (iterationRootHom d g) (𝟙 (iterationRemainingInputs g))) := rfl

theorem iterationNormalization_component_remaining (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) (i : (iterationRemainingInputs g).index) :
    (iterationNormalizationMap O x d g).hom ⟨none, some i⟩ = 𝟙 (X ((iterationRemainingInputs g).obj i).as) := by
  change (Discrete.functor X).map (𝟙 ((iterationRemainingInputs g).obj i)) = _
  exact Discrete.functor_map X _

theorem iterationNormalization_component_retained (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) (i : (residualMarkedInputs g).index) :
    (iterationNormalizationMap O x d g).hom ⟨some i, PUnit.unit⟩ =
      (iterationLeafIso x d (residualMarkedInputs g)).hom.hom i := rfl


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

