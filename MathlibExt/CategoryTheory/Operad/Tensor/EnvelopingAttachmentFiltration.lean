/-!
## Original whole carrier and Hom transport through the constructed actual Env/Under-A equivalence
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance transportFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance transportTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance transportProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual constructed equivalence unit retains the entire original
Env carrier identity, with its actual full original algebra round-trip map. -/
theorem equivalence_unit_hom (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    ((envelopingUnderAEquivalence O A).unit.app M).hom = 𝟙 M.carrier :=
  envelopingUnderA_roundTripIso_inv O A M

/-- The actual constructed equivalence counit retains the whole
original O-algebra carrier identity and original under-A triangle. -/
theorem equivalence_counit_hom (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    ((envelopingUnderAEquivalence O A).counit.app B).right.hom = 𝟙 B.right.carrier :=
  underAEnveloping_roundTripIso_hom O A B

/-- Genuine original under-A Hom maps and genuine Env Hom maps are
related by the actual constructed equivalence adjunction, with no equivalence outcome as a premise. -/
def underEnvHomEquiv (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) (B : Under A) :
    (envelopingUnderAObject O A M ⟶ B) ≃ (M ⟶ underAEnvelopingObject O A B) :=
  (envelopingUnderAEquivalence O A).toAdjunction.homEquiv M B

/-- Original Env Hom transport keeps exactly its entire original
carrier arrow through the actual identity-carrier under-A counit. -/
theorem underEnvHomEquiv_symm_hom (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) (B : Under A) (f : M ⟶ underAEnvelopingObject O A B) :
    ((underEnvHomEquiv O A M B).symm f).right.hom = f.hom := by
  let e := envelopingUnderAEquivalence O A
  let U := Under.forget A ⋙ Algebra.forget O
  have h0 : (underEnvHomEquiv O A M B).symm f = e.functor.map f ≫ e.counit.app B :=
    e.toAdjunction.homEquiv_symm_apply M B f
  have h : ((underEnvHomEquiv O A M B).symm f).right.hom =
      (envelopingUnderAMap O A f).right.hom ≫ (e.counit.app B).right.hom :=
    (congrArg U.map h0).trans (U.map_comp _ _)
  exact h.trans ((congrArg₂ (· ≫ ·) (envelopingUnderAMap_hom O A f) (equivalence_counit_hom O A B)).trans
    (Category.comp_id f.hom))

/-- Original under-A Hom transport keeps the whole original carrier
arrow by the actual inverse Hom law and proved counit carrier comparison. -/
theorem underEnvHomEquiv_hom (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) (B : Under A) (f : envelopingUnderAObject O A M ⟶ B) :
    (underEnvHomEquiv O A M B f).hom = f.right.hom := by
  let e := underEnvHomEquiv O A M B
  exact (underEnvHomEquiv_symm_hom O A M B (e f)).symm.trans
    (congrArg (fun g : envelopingUnderAObject O A M ⟶ B => g.right.hom) (e.symm_apply_apply f))


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

end
