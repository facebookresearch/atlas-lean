/-!
## Both quotient inverse comparisons on every original caller face
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]
local instance inverseFaceSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance inverseFaceAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The inverse marked-vertex map associated to a relabeled input subset. -/
def profileInverseVertex {P Q : ColoredProfile W} (e : P ≅ Q) (T : ProfileInputSets Q) :
    (originalInputCube Q).obj T ⟶ (originalInputCube P).obj (profileSubsetPreimage e T) :=
  (originalInputCube Q).map (eqToHom (profileSubset_preimage e T).symm) ≫
    (profileInputVertexIso e (profileSubsetPreimage e T)).inv

omit [HasColimitsOfSize.{us, us} C] in
theorem fullCubeTensor_eqToHom (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    {S T : FullProfileCube P} (h : S = T) :
    (fullCubeTensor D P).map (eqToHom h) = D.map ((originalInputCube P).map (eqToHom h)) := by
  cases h
  rfl

omit [HasColimitsOfSize.{us, us} C] in
theorem fullPuncturedTensor_eqToHom (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    {S T : FullProfilePunctured P} (h : S = T) :
    (fullPuncturedTensor D P).map (eqToHom h) =
      D.map ((originalInputCube P).map (eqToHom (congrArg Subtype.val h))) := by
  cases h
  rfl

/-- Every original proper caller face uses its actual inverse input
permutation and the literal original empty/top correction before quotienting. -/
theorem profileBoundaryPointIso_inverse_original (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W}
    (e : P ≅ Q) (T : FullProfilePunctured Q) :
    (fullProfileBoundaryCocone D Q).ι.app T ≫ (profileBoundaryPointIso D e).inv =
      D.map (profileInverseVertex e T.1) ≫ (fullProfileBoundaryCocone D P).ι.app
        ⟨profileSubsetPreimage e T.1, profileSubsetPreimage_punctured e T⟩ := by
  let S : FullProfilePunctured P := ⟨profileSubsetPreimage e T.1, profileSubsetPreimage_punctured e T⟩
  let Sq := (profileRelabelFullPuncturedFunctor e).obj S
  let h : Sq = T := Subtype.ext (profileSubset_preimage e T.1)
  let f : T ⟶ Sq := eqToHom h.symm
  let m := D.map ((originalInputCube Q).map (eqToHom (profileSubset_preimage e T.1).symm))
  let a := profileBoundaryPointIso D e
  let j := (fullProfileBoundaryCocone D P).ι.app S
  let k := (fullProfileBoundaryCocone D Q).ι.app Sq
  have hm : (fullPuncturedTensor D Q).map f = m := fullPuncturedTensor_eqToHom D Q h.symm
  exact (congrArg (· ≫ a.inv) ((fullProfileBoundaryCocone D Q).w f).symm).trans
    ((congrArg (fun z => (z ≫ k) ≫ a.inv) hm).trans
      ((Category.assoc m k a.inv).trans
        ((congrArg (m ≫ ·) (profileBoundaryPointIso_inverse_face D e S)).trans
          ((Category.assoc m (D.map (profileInputVertexIso e S.1).inv) j).symm.trans
            (congrArg (· ≫ j) (D.map_comp _ _).symm)))))

/-- Every full caller vertex, including the original nullary top, has
the literal original inverse tensor/profile map before both quotient legs. -/
theorem profileTopPointIso_inverse_original (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W}
    (e : P ≅ Q) (T : FullProfileCube Q) :
    (fullProfileTopCocone D Q).ι.app T ≫ (profileTopPointIso D e).inv =
      D.map (profileInverseVertex e T) ≫ (fullProfileTopCocone D P).ι.app (profileSubsetPreimage e T) := by
  let S : FullProfileCube P := profileSubsetPreimage e T
  let Sq := (profileRelabelFullCubeFunctor e).obj S
  let h : Sq = T := profileSubset_preimage e T
  let f : T ⟶ Sq := eqToHom h.symm
  let m := D.map ((originalInputCube Q).map (eqToHom (profileSubset_preimage e T).symm))
  let a := profileTopPointIso D e
  let j := (fullProfileTopCocone D P).ι.app S
  let k := (fullProfileTopCocone D Q).ι.app Sq
  have hm : (fullCubeTensor D Q).map f = m := fullCubeTensor_eqToHom D Q h.symm
  exact (congrArg (· ≫ a.inv) ((fullProfileTopCocone D Q).w f).symm).trans
    ((congrArg (fun z => (z ≫ k) ≫ a.inv) hm).trans
      ((Category.assoc m k a.inv).trans
        ((congrArg (m ≫ ·) (profileTopPointIso_inverse_face D e S)).trans
          ((Category.assoc m (D.map (profileInputVertexIso e S).inv) j).symm.trans
            (congrArg (· ≫ j) (D.map_comp _ _).symm)))))


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
