/-!
## Original mixed residual inputs and their actual top promotion maps
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The actual original all-top leaf family is the original X′ profile family. -/
def topLeafIso {X Xprime : W → C} (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (FiniteFamily.map (markedInputCarrier x)).obj (topMarkedProfile P) ≅ profileLeafFamily Xprime P :=
  FiniteFamily.isoOfComponents (Equiv.refl P.inputs) (fun i => eqToIso (markedCarrier_top x (P.inputColor i)))

/-- Promote every actual retained residual coordinate by its original x map,
then use the original top leaf comparison at its same original color. -/
def residualLeafTopMap {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    {P Q : MarkedInputs W} (g : P ⟶ Q) :
    residualLeafFamily x g ⟶ profileLeafFamily Xprime (survivingProfile d Q) :=
  (FiniteFamily.map (markedInputCarrier x)).map
      ((toAllTopInputs (W := W)).app (residualMarkedInputs g)) ≫
    (topLeafIso x (survivingProfile d Q)).hom

/-- The original residual top promotion preserves the actual original root coefficient. -/
theorem residualTopProfileMap (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (markedProfileFunctor d).map ((toAllTopInputs (W := W)).app (residualMarkedInputs g)) =
      𝟙 (survivingProfile d Q) := ColoredProfile.Hom.ext rfl

/-- The original joint coefficient/leaf top map is the literal original marked
diagram map followed by its actual original operation-factor comparison. -/
theorem residualLeafTopMap_factors (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    coefficientLeafMap (𝟙 (O.obj (survivingProfile d Q))) (residualLeafTopMap x d g) ≫
        (profileOperationFactorsIso O Xprime (survivingProfile d Q)).hom =
      (coefficientInputFactors (markedProfileFunctor d ⋙ O) (FiniteFamily.map (markedInputCarrier x))).map
          ((toAllTopInputs (W := W)).app (residualMarkedInputs g)) ≫
        (topOperationFactorsIso O x (survivingProfile d Q)).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
        let f := O.map ((markedProfileFunctor d).map
          ((toAllTopInputs (W := W)).app (residualMarkedInputs g)))
        have hf : f = 𝟙 (O.obj (survivingProfile d Q)) :=
          (congrArg O.map (residualTopProfileMap d g)).trans (O.map_id _)
        change HEq (𝟙 _ ≫ 𝟙 _) (f ≫ 𝟙 _)
        exact heq_of_eq (congrArg (· ≫ 𝟙 _) hf.symm)
    | some i =>
        let m := (markedInputCarrier x).map
          (((toAllTopInputs (W := W)).app (residualMarkedInputs g)).hom i)
        let t := eqToHom (markedCarrier_top x (Q.obj i.1).2.as)
        change HEq ((m ≫ t) ≫ 𝟙 _) (m ≫ t)
        exact heq_of_eq (Category.comp_id _)

variable [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationPartialLeafFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- Tensoring the actual original mixed residual leaf map gives exactly
the genuine original residual marked top operation source. -/
theorem residualLeafTopMap_tensor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (E.toCollection.obj (survivingProfile d Q))) (residualLeafTopMap x d g)) ≫
      (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d Q)).hom =
    (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app (residualMarkedInputs g)) ≫
      (topOperationTensorIso E x (survivingProfile d Q)).hom :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
    ((congrArg (FiniteTensor.tensor (V := C)).map (residualLeafTopMap_factors E.toCollection x d g)).trans
      ((FiniteTensor.tensor (V := C)).map_comp _ _))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
