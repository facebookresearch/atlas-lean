/-!
## Original profile enumerations and genuine degree-word morphisms
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc}

/-- Retain the original color/profile bijection on the original all-top inputs. -/
def topProfileHom {P Q : ColoredProfile W} (f : P ⟶ Q) :
    topMarkedProfile P ⟶ topMarkedProfile Q where
  equiv := f.inputEquiv
  hom i := eqToHom (Prod.ext rfl (congrArg Discrete.mk (f.inputColor_eq i)))

/-- Any displayed enumeration retains the same original full colored profile. -/
def topWordWith {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) : DegreeMarkedInputs W n :=
  fun i => (Finset.univ, Discrete.mk (P.inputColor (e i)))

/-- The actual profile-to-word comparison retains the inverse of the displayed enumeration. -/
def topEnumerationIsoWith {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    topMarkedProfile P ≅ (degreeMarkedInclusion (W := W) n).obj (topWordWith P e) :=
  FiniteFamily.isoOfComponents e.symm (fun i => eqToIso (Prod.ext rfl
    (congrArg Discrete.mk (congrArg P.inputColor (e.apply_symm_apply i))).symm))

/-- The genuine degree-word morphism is the actual original profile
permutation conjugated by the displayed two original input enumerations. -/
def enumeratedDegreeMap {n : ℕ} {P Q : ColoredProfile W} (f : P ⟶ Q)
    (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) : topWordWith P e ⟶ topWordWith Q e' :=
  InducedCategory.homMk
    { equiv := (e.trans f.inputEquiv).trans e'.symm
      hom i := eqToHom (Prod.ext rfl (congrArg Discrete.mk
        ((f.inputColor_eq (e i)).trans
          (congrArg Q.inputColor (e'.apply_symm_apply (f.inputEquiv (e i)))).symm))) }

/-- Every original profile map and both displayed enumerations commute
through the literal original marked input bijections. -/
theorem topEnumerationIsoWith_square {n : ℕ} {P Q : ColoredProfile W} (f : P ⟶ Q)
    (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) :
    topProfileHom (W := W) (P := P) (Q := Q) f ≫ (topEnumerationIsoWith Q e').hom =
      (topEnumerationIsoWith P e).hom ≫
        (degreeMarkedInclusion (W := W) n).map
          (enumeratedDegreeMap (W := W) (P := P) (Q := Q) f e e') := by
  apply markedHom_ext
  apply Equiv.ext
  intro i
  change e'.symm (f.inputEquiv i) = e'.symm (f.inputEquiv (e (e.symm i)))
  exact (congrArg (fun j => e'.symm (f.inputEquiv j)) (e.apply_symm_apply i)).symm

theorem topEnumerationIsoWith_original (P : ColoredProfile W) :
    topEnumerationIsoWith P (inputEnumeration P) = topEnumerationIso P := rfl


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
