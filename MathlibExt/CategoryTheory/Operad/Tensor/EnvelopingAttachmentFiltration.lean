/-!
## Original profile isomorphisms relabel every original marked cube face
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}
/-- The full relabelled category map keeps its literal original marked
source and target maps, before tensoring or taking either quotient. -/
def profileRelabelFullCubeFunctor {P Q : ColoredProfile W} (e : P ≅ Q) : FullProfileCube P ⥤ FullProfileCube Q where
  obj S := profileSubset e S
  map {X Y} f := InducedCategory.homMk ((profileInputVertexIso e X).inv ≫ f.hom ≫ (profileInputVertexIso e Y).hom)
  map_id S := by
    apply InducedCategory.hom_ext
    exact (congrArg ((profileInputVertexIso e S).inv ≫ ·)
      (Category.id_comp (profileInputVertexIso e S).hom)).trans (profileInputVertexIso e S).inv_hom_id
  map_comp {X Y Z} f g := by
    apply InducedCategory.hom_ext
    change (profileInputVertexIso e X).inv ≫ (f.hom ≫ g.hom) ≫ (profileInputVertexIso e Z).hom =
      ((profileInputVertexIso e X).inv ≫ f.hom ≫ (profileInputVertexIso e Y).hom) ≫
        ((profileInputVertexIso e Y).inv ≫ g.hom ≫ (profileInputVertexIso e Z).hom)
    simp only [Category.assoc, Iso.hom_inv_id_assoc]

instance profileRelabelFullCubeFull {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullCubeFunctor e).Full where
  map_surjective := by
    intro S T f
    refine ⟨InducedCategory.homMk ((profileInputVertexIso e S).hom ≫ f.hom ≫ (profileInputVertexIso e T).inv), ?_⟩
    apply InducedCategory.hom_ext
    change (profileInputVertexIso e S).inv ≫
      ((profileInputVertexIso e S).hom ≫ f.hom ≫ (profileInputVertexIso e T).inv) ≫
        (profileInputVertexIso e T).hom = f.hom
    exact (Category.assoc (profileInputVertexIso e S).inv _ (profileInputVertexIso e T).hom).symm.trans
      ((congrArg (· ≫ (profileInputVertexIso e T).hom)
        (Iso.inv_hom_id_assoc (profileInputVertexIso e S) (f.hom ≫ (profileInputVertexIso e T).inv))).trans
        ((Category.assoc f.hom (profileInputVertexIso e T).inv (profileInputVertexIso e T).hom).trans
          ((congrArg (f.hom ≫ ·) (profileInputVertexIso e T).inv_hom_id).trans (Category.comp_id f.hom))))

instance profileRelabelFullCubeFaithful {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullCubeFunctor e).Faithful where
  map_injective := by
    intro S T f g h
    apply InducedCategory.hom_ext
    have hm : (profileInputVertexIso e S).inv ≫ f.hom ≫ (profileInputVertexIso e T).hom =
        (profileInputVertexIso e S).inv ≫ g.hom ≫ (profileInputVertexIso e T).hom := congrArg (fun k => k.hom) h
    exact (cancel_mono (profileInputVertexIso e T).hom).mp ((cancel_epi (profileInputVertexIso e S).inv).mp hm)

instance profileRelabelFullCubeEssSurj {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullCubeFunctor e).EssSurj where
  mem_essImage T := ⟨profileSubsetPreimage e T, ⟨eqToIso (profileSubset_preimage e T)⟩⟩

instance profileRelabelFullCubeIsEquivalence {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullCubeFunctor e).IsEquivalence where

/-- Relabel the full punctured profile cube along a colored-profile isomorphism. -/
def profileRelabelFullPuncturedFunctor {P Q : ColoredProfile W} (e : P ≅ Q) :
    FullProfilePunctured P ⥤ FullProfilePunctured Q where
  obj S := ⟨profileSubset e S.1, profileSubset_punctured e S⟩
  map f := InducedCategory.homMk ((profileRelabelFullCubeFunctor e).map f.hom)
  map_id S := InducedCategory.hom_ext ((profileRelabelFullCubeFunctor e).map_id S.1)
  map_comp f g := InducedCategory.hom_ext ((profileRelabelFullCubeFunctor e).map_comp f.hom g.hom)

instance profileRelabelFullPuncturedFull {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullPuncturedFunctor e).Full where
  map_surjective := by
    intro S T f
    refine ⟨InducedCategory.homMk (InducedCategory.homMk
      ((profileInputVertexIso e S.1).hom ≫ f.hom.hom ≫ (profileInputVertexIso e T.1).inv)), ?_⟩
    apply InducedCategory.hom_ext
    apply InducedCategory.hom_ext
    change (profileInputVertexIso e S.1).inv ≫
      ((profileInputVertexIso e S.1).hom ≫ f.hom.hom ≫ (profileInputVertexIso e T.1).inv) ≫
        (profileInputVertexIso e T.1).hom = f.hom.hom
    exact (Category.assoc (profileInputVertexIso e S.1).inv _ (profileInputVertexIso e T.1).hom).symm.trans
      ((congrArg (· ≫ (profileInputVertexIso e T.1).hom)
        (Iso.inv_hom_id_assoc (profileInputVertexIso e S.1) (f.hom.hom ≫ (profileInputVertexIso e T.1).inv))).trans
        ((Category.assoc f.hom.hom (profileInputVertexIso e T.1).inv (profileInputVertexIso e T.1).hom).trans
          ((congrArg (f.hom.hom ≫ ·) (profileInputVertexIso e T.1).inv_hom_id).trans (Category.comp_id f.hom.hom))))

instance profileRelabelFullPuncturedFaithful {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullPuncturedFunctor e).Faithful where
  map_injective := by
    intro S T f g h
    apply InducedCategory.hom_ext
    apply InducedCategory.hom_ext
    have hm : (profileInputVertexIso e S.1).inv ≫ f.hom.hom ≫ (profileInputVertexIso e T.1).hom =
        (profileInputVertexIso e S.1).inv ≫ g.hom.hom ≫ (profileInputVertexIso e T.1).hom :=
      congrArg (fun k => k.hom.hom) h
    exact (cancel_mono (profileInputVertexIso e T.1).hom).mp ((cancel_epi (profileInputVertexIso e S.1).inv).mp hm)

instance profileRelabelFullPuncturedEssSurj {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullPuncturedFunctor e).EssSurj where
  mem_essImage T := ⟨⟨profileSubsetPreimage e T.1, profileSubsetPreimage_punctured e T⟩,
    ⟨eqToIso (Subtype.ext (profileSubset_preimage e T.1))⟩⟩

instance profileRelabelFullPuncturedIsEquivalence {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRelabelFullPuncturedFunctor e).IsEquivalence where

theorem profileRelabelFunctor_square {P Q : ColoredProfile W} (e : P ≅ Q)
    {S T : FullProfileCube P} (f : S ⟶ T) :
    f.hom ≫ (profileInputVertexIso e T).hom =
      (profileInputVertexIso e S).hom ≫ ((profileRelabelFullCubeFunctor e).map f).hom :=
  (Iso.hom_inv_id_assoc (profileInputVertexIso e S) (f.hom ≫ (profileInputVertexIso e T).hom)).symm

section Tensor

variable {C : Type u} [Category.{v} C]

/-- The natural isomorphism of full `D`-valued profile cubes induced by relabeling. -/
def profileRelabelCubeTensorIso (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    fullCubeTensor D P ≅ profileRelabelFullCubeFunctor e ⋙ fullCubeTensor D Q :=
  NatIso.ofComponents (fun S => D.mapIso (profileInputVertexIso e S)) (by
    intro S T f
    exact (D.map_comp _ _).symm.trans
      ((congrArg D.map (profileRelabelFunctor_square e f)).trans (D.map_comp _ _)))

/-- The natural isomorphism of full punctured `D`-valued profile cubes induced by relabeling. -/
def profileRelabelPuncturedTensorIso (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    fullPuncturedTensor D P ≅ profileRelabelFullPuncturedFunctor e ⋙ fullPuncturedTensor D Q :=
  NatIso.ofComponents (fun S => D.mapIso (profileInputVertexIso e S.1)) (by
    intro S T f
    exact (D.map_comp _ _).symm.trans
      ((congrArg D.map (profileRelabelFunctor_square e f.hom)).trans (D.map_comp _ _)))

end Tensor


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource176


section AttachmentSource178


/-!
## Original profile isomorphisms on both actual action quotients
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]

local instance profileQuotientSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance profileQuotientAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

theorem fullProfileBoundaryTop_square (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (S : FullProfilePunctured P) :
    (fullProfileBoundaryCocone D P).ι.app S ≫ (geometryBalancedProfileArrow D P).hom =
      (fullProfileTopCocone D P).ι.app S.1 := by
  let B := geometryPuncturedTensor D P
  let A := geometryBoundaryActionFunctor D P
  let T := geometryInputTopActionFunctor D P
  let j := colimit.ι A (SingleObj.star (Aut P))
  let k := colimit.ι T (SingleObj.star (Aut P))
  have hj : j ≫ (geometryBalancedProfileArrow D P).hom = geometryBoundaryToTop D P ≫ k :=
    ι_colimMap (geometryBoundaryTopTransformation D P) (SingleObj.star (Aut P))
  exact (Category.assoc (colimit.ι B S) j (geometryBalancedProfileArrow D P).hom).trans
    ((congrArg (colimit.ι B S ≫ ·) hj).trans
      ((Category.assoc (colimit.ι B S) (geometryBoundaryToTop D P) k).symm.trans
        (congrArg (· ≫ k) (geometryBoundaryToTop_face D P S))))

/-- The full punctured cube colimit cocone transported across a profile relabeling. -/
def relabeledBoundaryCocone (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    Cocone (fullPuncturedTensor D P) :=
  (Cocone.precompose (profileRelabelPuncturedTensorIso D e).hom).obj
    ((fullProfileBoundaryCocone D Q).whisker (profileRelabelFullPuncturedFunctor e))

/-- The colimit structure on the relabeled full punctured cube cocone. -/
def relabeledBoundaryIsColimit (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    IsColimit (relabeledBoundaryCocone D e) :=
  (IsColimit.precomposeHomEquiv (profileRelabelPuncturedTensorIso D e)
    ((fullProfileBoundaryCocone D Q).whisker (profileRelabelFullPuncturedFunctor e))).symm
    ((Functor.Final.isColimitWhiskerEquiv (profileRelabelFullPuncturedFunctor e)
      (fullProfileBoundaryCocone D Q)).symm (fullProfileBoundaryIsColimit D Q))

/-- The full profile cube colimit cocone transported across a profile relabeling. -/
def relabeledTopCocone (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    Cocone (fullCubeTensor D P) :=
  (Cocone.precompose (profileRelabelCubeTensorIso D e).hom).obj
    ((fullProfileTopCocone D Q).whisker (profileRelabelFullCubeFunctor e))

/-- The colimit structure on the relabeled full profile cube cocone. -/
def relabeledTopIsColimit (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    IsColimit (relabeledTopCocone D e) :=
  (IsColimit.precomposeHomEquiv (profileRelabelCubeTensorIso D e)
    ((fullProfileTopCocone D Q).whisker (profileRelabelFullCubeFunctor e))).symm
    ((Functor.Final.isColimitWhiskerEquiv (profileRelabelFullCubeFunctor e)
      (fullProfileTopCocone D Q)).symm (fullProfileTopIsColimit D Q))

/-- Both source and target are the actual original profile action
quotients, and the comparison is constructed from their proved UPs. -/
def profileBoundaryPointIso (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    (geometryBalancedProfileArrow D P).left ≅ (geometryBalancedProfileArrow D Q).left :=
  (fullProfileBoundaryIsColimit D P).coconePointUniqueUpToIso (relabeledBoundaryIsColimit D e)

/-- The isomorphism of balanced profile top objects induced by profile relabeling. -/
def profileTopPointIso (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    (geometryBalancedProfileArrow D P).right ≅ (geometryBalancedProfileArrow D Q).right :=
  (fullProfileTopIsColimit D P).coconePointUniqueUpToIso (relabeledTopIsColimit D e)

/-- Each original proper face retains its original finite-family map and
the actual original boundary quotient projections on both sides. -/
theorem profileBoundaryPointIso_face (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q)
    (S : FullProfilePunctured P) :
    (fullProfileBoundaryCocone D P).ι.app S ≫ (profileBoundaryPointIso D e).hom =
      D.map (profileInputVertexIso e S.1).hom ≫
        (fullProfileBoundaryCocone D Q).ι.app ((profileRelabelFullPuncturedFunctor e).obj S) :=
  IsColimit.comp_coconePointUniqueUpToIso_hom (fullProfileBoundaryIsColimit D P)
    (relabeledBoundaryIsColimit D e) S

theorem profileTopPointIso_face (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q)
    (S : FullProfileCube P) :
    (fullProfileTopCocone D P).ι.app S ≫ (profileTopPointIso D e).hom =
      D.map (profileInputVertexIso e S).hom ≫
        (fullProfileTopCocone D Q).ι.app ((profileRelabelFullCubeFunctor e).obj S) :=
  IsColimit.comp_coconePointUniqueUpToIso_hom (fullProfileTopIsColimit D P)
    (relabeledTopIsColimit D e) S

theorem profileQuotientArrow_square (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileBoundaryPointIso D e).hom ≫ (geometryBalancedProfileArrow D Q).hom =
      (geometryBalancedProfileArrow D P).hom ≫ (profileTopPointIso D e).hom := by
  apply (fullProfileBoundaryIsColimit D P).hom_ext
  intro S
  let Sq := (profileRelabelFullPuncturedFunctor e).obj S
  let j := (fullProfileBoundaryCocone D P).ι.app S
  let m := D.map (profileInputVertexIso e S.1).hom
  have hb : j ≫ ((profileBoundaryPointIso D e).hom ≫ (geometryBalancedProfileArrow D Q).hom) =
      m ≫ (fullProfileTopCocone D Q).ι.app Sq.1 :=
    (Category.assoc j _ _).symm.trans
      ((congrArg (· ≫ (geometryBalancedProfileArrow D Q).hom) (profileBoundaryPointIso_face D e S)).trans
        ((Category.assoc m _ _).trans (congrArg (m ≫ ·) (fullProfileBoundaryTop_square D Q Sq))))
  have ht : j ≫ ((geometryBalancedProfileArrow D P).hom ≫ (profileTopPointIso D e).hom) =
      m ≫ (fullProfileTopCocone D Q).ι.app Sq.1 :=
    (Category.assoc j _ _).symm.trans
      ((congrArg (· ≫ (profileTopPointIso D e).hom) (fullProfileBoundaryTop_square D P S)).trans
        (profileTopPointIso_face D e S.1))
  exact hb.trans ht.symm

/-- Every actual original profile isomorphism gives the genuine full
balanced Arrow isomorphism, with both original quotient maps retained. -/
def profileQuotientArrowIso (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    geometryBalancedProfileArrow D P ≅ geometryBalancedProfileArrow D Q :=
  Arrow.isoMk (profileBoundaryPointIso D e) (profileTopPointIso D e) (profileQuotientArrow_square D e)

theorem profileBoundaryPointIso_inverse_face (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q)
    (S : FullProfilePunctured P) :
    (fullProfileBoundaryCocone D Q).ι.app ((profileRelabelFullPuncturedFunctor e).obj S) ≫
        (profileBoundaryPointIso D e).inv =
      D.map (profileInputVertexIso e S.1).inv ≫ (fullProfileBoundaryCocone D P).ι.app S := by
  let h := D.mapIso (profileInputVertexIso e S.1)
  let j := (fullProfileBoundaryCocone D P).ι.app S
  let k := (fullProfileBoundaryCocone D Q).ι.app ((profileRelabelFullPuncturedFunctor e).obj S)
  let a := profileBoundaryPointIso D e
  apply (cancel_epi h.hom).mp
  exact (Category.assoc h.hom k a.inv).symm.trans
    ((congrArg (· ≫ a.inv) (profileBoundaryPointIso_face D e S).symm).trans
      ((Category.assoc j a.hom a.inv).trans
        ((congrArg (j ≫ ·) a.hom_inv_id).trans
          ((Category.comp_id j).trans (Iso.hom_inv_id_assoc h j).symm))))

theorem profileTopPointIso_inverse_face (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q)
    (S : FullProfileCube P) :
    (fullProfileTopCocone D Q).ι.app ((profileRelabelFullCubeFunctor e).obj S) ≫
        (profileTopPointIso D e).inv = D.map (profileInputVertexIso e S).inv ≫ (fullProfileTopCocone D P).ι.app S := by
  let h := D.mapIso (profileInputVertexIso e S)
  let j := (fullProfileTopCocone D P).ι.app S
  let k := (fullProfileTopCocone D Q).ι.app ((profileRelabelFullCubeFunctor e).obj S)
  let a := profileTopPointIso D e
  apply (cancel_epi h.hom).mp
  exact (Category.assoc h.hom k a.inv).symm.trans
    ((congrArg (· ≫ a.inv) (profileTopPointIso_face D e S).symm).trans
      ((Category.assoc j a.hom a.inv).trans
        ((congrArg (j ≫ ·) a.hom_inv_id).trans
          ((Category.comp_id j).trans (Iso.hom_inv_id_assoc h j).symm))))


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
end AttachmentSource178


section AttachmentSource179


/-!
## Original raw profile Arrow maps and their actual quotient projections
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]

local instance rawProfileSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance rawProfileAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The arrow map quotienting the input boundary and full vertex by profile automorphisms. -/
def geometryProfileQuotientProjection (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) :
    Arrow.mk (geometryBoundaryToTop D P) ⟶ geometryBalancedProfileArrow D P :=
  Arrow.homMk
    (colimit.ι (geometryBoundaryActionFunctor D P) (SingleObj.star (Aut P)))
    (colimit.ι (geometryInputTopActionFunctor D P) (SingleObj.star (Aut P)))
    (ι_colimMap (geometryBoundaryTopTransformation D P) (SingleObj.star (Aut P)))

/-- Both actual original quotient projections commute with the original
raw and balanced profile Arrow comparisons, preserving every source map. -/
theorem profileRawQuotientIso_cofan (D : MarkedInputs W ⥤ C) {P Q : ColoredProfile W} (e : P ≅ Q) :
    (profileRawArrowIso D e).hom ≫ geometryProfileQuotientProjection D Q =
      geometryProfileQuotientProjection D P ≫ (profileQuotientArrowIso D e).hom := by
  apply Arrow.hom_ext
  · let B := geometryPuncturedTensor D P
    let b := colimit.ι (geometryBoundaryActionFunctor D P) (SingleObj.star (Aut P))
    let bq := colimit.ι (geometryBoundaryActionFunctor D Q) (SingleObj.star (Aut Q))
    apply colimit.hom_ext (F := B)
    intro S
    let Sq := (profilePuncturedSubsetFunctor e).obj S
    let j := colimit.ι B S
    let m := D.map (profileInputVertexIso e S.1).hom
    have hl : j ≫ ((profileRawBoundaryIso D e).hom ≫ bq) =
        m ≫ (fullProfileBoundaryCocone D Q).ι.app Sq :=
      (Category.assoc j _ _).symm.trans
        ((congrArg (· ≫ bq) (profileRawBoundaryIso_face D e S)).trans (Category.assoc m _ bq))
    have hr : j ≫ (b ≫ (profileBoundaryPointIso D e).hom) =
        m ≫ (fullProfileBoundaryCocone D Q).ι.app Sq :=
      (Category.assoc j b _).symm.trans (profileBoundaryPointIso_face D e S)
    exact hl.trans hr.symm
  · let T := geometryInputTopActionFunctor D P
    let Tq := geometryInputTopActionFunctor D Q
    let j := colimit.ι T (SingleObj.star (Aut P))
    let k := colimit.ι Tq (SingleObj.star (Aut Q))
    let U : ProfileInputSets P := Finset.univ
    let m := D.map (profileInputVertexIso e U).hom
    let f : profileSubset e U ⟶ (Finset.univ : ProfileInputSets Q) := eqToHom (profileSubset_univ e)
    have hf : f = originalTopFace Q (profileSubset e U) := Subsingleton.elim _ _
    have hm : D.map (profileTopVertexIso e).hom =
        m ≫ D.map ((originalInputCube Q).map (originalTopFace Q (profileSubset e U))) :=
      (D.map_comp _ _).trans (congrArg (m ≫ ·) (congrArg (fun h => D.map ((originalInputCube Q).map h)) hf))
    have hl : D.map (profileTopVertexIso e).hom ≫ k =
        m ≫ (fullProfileTopCocone D Q).ι.app (profileSubset e U) :=
      (congrArg (· ≫ k) hm).trans (Category.assoc m _ k)
    have hr : j ≫ (profileTopPointIso D e).hom =
        m ≫ (fullProfileTopCocone D Q).ι.app (profileSubset e U) :=
      (congrArg (· ≫ (profileTopPointIso D e).hom) (fullProfileTopCocone_top D P).symm).trans
        (profileTopPointIso_face D e U)
    exact hl.trans hr.symm


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

