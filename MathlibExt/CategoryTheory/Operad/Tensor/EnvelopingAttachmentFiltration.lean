/-!
# Colored tensor-operad enveloping attachment filtrations

The original operad, genuine algebra and actual free attachment construct
the full Env coefficient-weighted filtration. Both original profile-symmetry
quotients, every original proper-face contraction, literal recursive pushout,
original profile/output cofactor and genuine original algebra endpoint remain.

The original SAME underlying carrier arrow has a source-small actual whole
carrier-family relative cell complex. Every original caller profile and CPP
cofan retains its coefficient/input/permutation/nullary maps. Actual profile
class coordinate refinement orders, continuous histories and all original
source/target cofactors are derived from those same original constructions.
-/

@[expose] public section

open CategoryTheory.OperadicOrbitCells.ProfileGeometry


section AttachmentSource000


/-!
## The actual algebra endpoint of an attachment to the initial algebra

This constructs the endpoint as a reflexive coequalizer of actual tensor free
algebras. All operation maps and algebra laws are created by the original
forgetful functor. The original attaching map and free image of the original
color-indexed arrow have a full pushout universal property at this endpoint.
-/


set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance endpointFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance endpointTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C

local instance endpointProfileColimits (d : W) :
    HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

local instance originalBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)

local instance originalParallelColimits : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- Original colorwise coproducts used for a reflexive presentation. -/
def colorSum (X Y : W → C) : W → C := fun d => X d ⨿ Y d

/-- The left inclusion into the colorwise coproduct of two carrier families. -/
def colorInl (X Y : W → C) : X ⟶ colorSum X Y :=
  fun d => (coprod.inl : X d ⟶ X d ⨿ Y d)

/-- The right inclusion into the colorwise coproduct of two carrier families. -/
def colorInr (X Y : W → C) : Y ⟶ colorSum X Y :=
  fun d => (coprod.inr : Y d ⟶ X d ⨿ Y d)

/-- Original free maps on the original colorwise coproduct inclusions. -/
def freeInl (E : ColoredOperadObj W C) (X Y : W → C) :
    freeAlgebra E X ⟶ freeAlgebra E (colorSum X Y) :=
  (freeAlgebraFunctor E).map (colorInl X Y)

/-- Apply the free algebra functor to the right colorwise coproduct inclusion. -/
def freeInr (E : ColoredOperadObj W C) (X Y : W → C) :
    freeAlgebra E Y ⟶ freeAlgebra E (colorSum X Y) :=
  (freeAlgebraFunctor E).map (colorInr X Y)

/-- Restriction along an original free map is restriction along its same
original carrier map, for the actual tensor free Hom equivalence. -/
theorem freeRestriction_source (E : ColoredOperadObj W C) {X Y : W → C}
    (f : X ⟶ Y) {B : Algebra E} (g : freeAlgebra E Y ⟶ B) :
    tensorFreeHomEquiv E X B ((freeAlgebraFunctor E).map f ≫ g) =
      f ≫ tensorFreeHomEquiv E Y B g := by
  let eX := tensorFreeHomEquiv E X B
  let eY := tensorFreeHomEquiv E Y B
  have h : eX.symm (f ≫ eY g) = (freeAlgebraFunctor E).map f ≫ g :=
    (tensorFreeHomEquiv_source E f (eY g)).trans
      (congrArg ((freeAlgebraFunctor E).map f ≫ ·) (eY.symm_apply_apply g))
  exact (congrArg eX h).symm.trans (eX.apply_symm_apply _)

/-- Extend an arbitrary pair of original free algebra maps across the actual
colorwise coproduct, using the full tensor free algebra Hom equivalence. -/
def freeSumDesc (E : ColoredOperadObj W C) {X Y : W → C} {B : Algebra E}
    (f : freeAlgebra E X ⟶ B) (g : freeAlgebra E Y ⟶ B) :
    freeAlgebra E (colorSum X Y) ⟶ B :=
  (tensorFreeHomEquiv E (colorSum X Y) B).symm
    (fun d => coprod.desc (tensorFreeHomEquiv E X B f d) (tensorFreeHomEquiv E Y B g d))

theorem freeInl_sumDesc (E : ColoredOperadObj W C) {X Y : W → C} {B : Algebra E}
    (f : freeAlgebra E X ⟶ B) (g : freeAlgebra E Y ⟶ B) :
    freeInl E X Y ≫ freeSumDesc E f g = f := by
  let e := tensorFreeHomEquiv E X B
  let t : colorSum X Y ⟶ B.carrier :=
    fun d => coprod.desc (e f d) (tensorFreeHomEquiv E Y B g d)
  have ht : colorInl X Y ≫ t = e f := by
    funext d
    exact coprod.inl_desc _ _
  exact (tensorFreeHomEquiv_source E (colorInl X Y) t).symm.trans
    ((congrArg e.symm ht).trans (e.symm_apply_apply f))

theorem freeInr_sumDesc (E : ColoredOperadObj W C) {X Y : W → C} {B : Algebra E}
    (f : freeAlgebra E X ⟶ B) (g : freeAlgebra E Y ⟶ B) :
    freeInr E X Y ≫ freeSumDesc E f g = g := by
  let e := tensorFreeHomEquiv E Y B
  let t : colorSum X Y ⟶ B.carrier :=
    fun d => coprod.desc (tensorFreeHomEquiv E X B f d) (e g d)
  have ht : colorInr X Y ≫ t = e g := by
    funext d
    exact coprod.inr_desc _ _
  exact (tensorFreeHomEquiv_source E (colorInr X Y) t).symm.trans
    ((congrArg e.symm ht).trans (e.symm_apply_apply g))

theorem freeSum_hom_ext (E : ColoredOperadObj W C) {X Y : W → C} {B : Algebra E}
    {f g : freeAlgebra E (colorSum X Y) ⟶ B}
    (hl : freeInl E X Y ≫ f = freeInl E X Y ≫ g)
    (hr : freeInr E X Y ≫ f = freeInr E X Y ≫ g) : f = g := by
  let e := tensorFreeHomEquiv E (colorSum X Y) B
  have hleft : colorInl X Y ≫ e f = colorInl X Y ≫ e g :=
    (freeRestriction_source E (colorInl X Y) f).symm.trans
      ((congrArg (tensorFreeHomEquiv E X B) hl).trans
        (freeRestriction_source E (colorInl X Y) g))
  have hright : colorInr X Y ≫ e f = colorInr X Y ≫ e g :=
    (freeRestriction_source E (colorInr X Y) f).symm.trans
      ((congrArg (tensorFreeHomEquiv E Y B) hr).trans
        (freeRestriction_source E (colorInr X Y) g))
  apply e.injective
  funext d
  apply coprod.hom_ext
  · exact congrFun hleft d
  · exact congrFun hright d

variable (E : ColoredOperadObj W C) {X Xprime : W → C}
variable (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E)

/-- The left relation includes the actual attaching map followed by the
canonical initial-algebra map into the actual new free algebra. -/
def relationLeft : freeAlgebra E (colorSum Xprime X) ⟶ freeAlgebra E Xprime :=
  freeSumDesc E (𝟙 _) (a ≫ initialMap E (freeAlgebra E Xprime))

/-- The right relation includes the free image of the original heterogeneous
color-indexed attachment arrow. -/
def relationRight : freeAlgebra E (colorSum Xprime X) ⟶ freeAlgebra E Xprime :=
  freeSumDesc E (𝟙 _) ((freeAlgebraFunctor E).map x)

/-- The identity summand of the free presentation supplies the actual common
section. Reflexivity is proved by both original free inclusion equations. -/
theorem relationIsReflexive : IsReflexivePair (relationLeft E a) (relationRight E x) :=
  IsReflexivePair.mk' (freeInl E Xprime X)
    (freeInl_sumDesc E _ _) (freeInl_sumDesc E _ _)

local instance actualRelationReflexive :
    IsReflexivePair (relationLeft E a) (relationRight E x) := relationIsReflexive E x a

/-- A1 creates the coequalizer of this actual original reflexive pair. This is
a constructed algebra colimit, with every original tensor operation retained. -/
theorem attachmentHasCoequalizer : HasCoequalizer (relationLeft E a) (relationRight E x) := by
  let : CreatesColimit (parallelPair (relationLeft E a) (relationRight E x))
      (Algebra.forget E) :=
    tensorAlgebraForgetCreatesReflexiveCoequalizer E _ _
  exact hasColimit_of_created _ (Algebra.forget E)

local instance actualAttachmentCoequalizer :
    HasCoequalizer (relationLeft E a) (relationRight E x) := attachmentHasCoequalizer E x a

/-- The actual endpoint algebra is constructed by the original free algebra
presentation and the original forgetful functor's colimit creation theorem. -/
def attachmentEndpoint : Algebra E := coequalizer (relationLeft E a) (relationRight E x)

/-- The coequalizer projection from the new free algebra to the attachment endpoint. -/
def endpointNewMap : freeAlgebra E Xprime ⟶ attachmentEndpoint E x a :=
  coequalizer.π _ _

/-- The initial-algebra leg of the attachment endpoint, through the new free algebra. -/
def endpointOldMap : initialAlgebra E ⟶ attachmentEndpoint E x a :=
  initialMap E (freeAlgebra E Xprime) ≫ endpointNewMap E x a

/-- Both original algebra legs satisfy the original free-attachment square. -/
theorem endpointOriginalSquare :
    a ≫ endpointOldMap E x a = (freeAlgebraFunctor E).map x ≫ endpointNewMap E x a := by
  let j := freeInr E Xprime X
  let q := endpointNewMap E x a
  let l := relationLeft E (Xprime := Xprime) a
  let r := relationRight E x
  have h := congrArg (j ≫ ·) (coequalizer.condition l r)
  have hl : j ≫ l = a ≫ initialMap E (freeAlgebra E Xprime) := freeInr_sumDesc E _ _
  have hr : j ≫ r = (freeAlgebraFunctor E).map x := freeInr_sumDesc E _ _
  exact (Category.assoc a _ q).symm.trans
    ((congrArg (· ≫ q) hl).symm.trans
      ((Category.assoc j l q).trans
        (h.trans ((Category.assoc j r q).symm.trans (congrArg (· ≫ q) hr)))))

/-- The original old leg is also the unique map from the constructed initial
algebra into this same actual endpoint. -/
theorem endpointOldMap_initial : endpointOldMap E x a = initialMap E (attachmentEndpoint E x a) :=
  initialMap_comp E _

variable {B : Algebra E}

/-- A compatible pair of original algebra maps equalizes the actual reflexive
presentation. No algebra pushout or desired factor map is an input. -/
theorem targetEqualizes (b : initialAlgebra E ⟶ B) (j : freeAlgebra E Xprime ⟶ B)
    (h : a ≫ b = (freeAlgebraFunctor E).map x ≫ j) :
    relationLeft E a ≫ j = relationRight E x ≫ j := by
  apply freeSum_hom_ext E
  · exact (Category.assoc _ _ j).symm.trans
      ((congrArg (· ≫ j) (freeInl_sumDesc E _ _)).trans
        ((Category.id_comp j).trans
          ((Category.id_comp j).symm.trans
            ((congrArg (· ≫ j) (freeInl_sumDesc E _ _)).symm.trans (Category.assoc _ _ j)))))
  · have hi : initialMap E (freeAlgebra E Xprime) ≫ j = b :=
      (initialMap_unique E B _).trans (initialMap_unique E B b).symm
    exact (Category.assoc _ _ j).symm.trans
      ((congrArg (· ≫ j) (freeInr_sumDesc E _ _)).trans
        ((Category.assoc a _ j).trans
          ((congrArg (a ≫ ·) hi).trans
            (h.trans ((congrArg (· ≫ j) (freeInr_sumDesc E _ _)).symm.trans
              (Category.assoc _ _ j))))))

/-- The actual full E-algebra factor map is the canonical descendent of the
proved original presentation relation. -/
def endpointDesc (b : initialAlgebra E ⟶ B) (j : freeAlgebra E Xprime ⟶ B)
    (h : a ≫ b = (freeAlgebraFunctor E).map x ≫ j) : attachmentEndpoint E x a ⟶ B :=
  coequalizer.desc j (targetEqualizes E x a b j h)

theorem endpointNewMap_desc (b : initialAlgebra E ⟶ B) (j : freeAlgebra E Xprime ⟶ B)
    (h : a ≫ b = (freeAlgebraFunctor E).map x ≫ j) :
    endpointNewMap E x a ≫ endpointDesc E x a b j h = j :=
  coequalizer.π_desc _ _

theorem endpointOldMap_desc (b : initialAlgebra E ⟶ B) (j : freeAlgebra E Xprime ⟶ B)
    (h : a ≫ b = (freeAlgebraFunctor E).map x ≫ j) :
    endpointOldMap E x a ≫ endpointDesc E x a b j h = b :=
  (initialMap_unique E B _).trans (initialMap_unique E B b).symm

theorem endpoint_hom_ext {f g : attachmentEndpoint E x a ⟶ B}
    (h : endpointNewMap E x a ≫ f = endpointNewMap E x a ≫ g) : f = g :=
  coequalizer.hom_ext h

theorem endpointDesc_unique (b : initialAlgebra E ⟶ B) (j : freeAlgebra E Xprime ⟶ B)
    (h : a ≫ b = (freeAlgebraFunctor E).map x ≫ j)
    (f : attachmentEndpoint E x a ⟶ B) (hf : endpointNewMap E x a ≫ f = j) :
    f = endpointDesc E x a b j h :=
  endpoint_hom_ext E x a (hf.trans (endpointNewMap_desc E x a b j h).symm)

/-- The actual original attachment pushout cocone at its constructed endpoint. -/
def endpointPushoutCocone : PushoutCocone a ((freeAlgebraFunctor E).map x) :=
  PushoutCocone.mk (endpointOldMap E x a) (endpointNewMap E x a)
    (endpointOriginalSquare E x a)

/-- The full algebra pushout universal property, including factor maps and
uniqueness, for the two actual original algebra legs. -/
def endpointPushoutIsColimit : IsColimit (endpointPushoutCocone E x a) :=
  PushoutCocone.IsColimit.mk _
    (fun c => endpointDesc E x a c.inl c.inr c.condition)
    (fun c => endpointOldMap_desc E x a c.inl c.inr c.condition)
    (fun c => endpointNewMap_desc E x a c.inl c.inr c.condition)
    (fun c f _ hr => endpointDesc_unique E x a c.inl c.inr c.condition f hr)

theorem endpointOriginalIsPushout :
    IsPushout a ((freeAlgebraFunctor E).map x) (endpointOldMap E x a) (endpointNewMap E x a) :=
  IsPushout.of_isColimit (endpointPushoutIsColimit E x a)


end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource000


section AttachmentSource001



set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance universalFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance universalTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C

local instance universalProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

variable (E : ColoredOperadObj W C) {X Xprime : W → C}
variable (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (B : Algebra E)

/-- The compatible pair consists of both original algebra maps and precisely
the original free attachment square. -/
@[ext]
structure CompatibleAttachmentPair where
  /-- The target algebra map from the initial algebra in the compatible attachment span. -/
  oldMap : initialAlgebra E ⟶ B
  /-- The target algebra map from the new free algebra in the compatible attachment span. -/
  newMap : freeAlgebra E Xprime ⟶ B
  comm : a ≫ oldMap = (freeAlgebraFunctor E).map x ≫ newMap

/-- The constructed initial-algebra attachment endpoint has the full Hom
equivalence of the original algebra pushout, with both inverse laws proved. -/
def endpointHomEquiv :
    (attachmentEndpoint E x a ⟶ B) ≃ CompatibleAttachmentPair E x a B where
  toFun f :=
    { oldMap := endpointOldMap E x a ≫ f
      newMap := endpointNewMap E x a ≫ f
      comm := (Category.assoc a _ f).symm.trans
        ((congrArg (· ≫ f) (endpointOriginalSquare E x a)).trans
          (Category.assoc ((freeAlgebraFunctor E).map x) _ f)) }
  invFun p := endpointDesc E x a p.oldMap p.newMap p.comm
  left_inv f := endpoint_hom_ext E x a
    (endpointNewMap_desc E x a _ _ _)
  right_inv p := by
    apply CompatibleAttachmentPair.ext
    · exact endpointOldMap_desc E x a p.oldMap p.newMap p.comm
    · exact endpointNewMap_desc E x a p.oldMap p.newMap p.comm


end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource001


section AttachmentSource002


/-!
## Original free-attachment maps into the actual initial enveloping algebra
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

private theorem AttachmentSource002_cancelIsoMiddle {V : Type*} [Category* V] {X A B Y : V}
    (f : X ⟶ A) (e : A ≅ B) (g : A ⟶ Y) : (f ≫ e.hom) ≫ (e.inv ≫ g) = f ≫ g := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C := hasProfileColimitsOfSmallColors C d

/-- The original A-carrier enveloping algebra has its actual full iso
to the actual initial E-algebra, through both original nullary coefficient comparisons. -/
def baseInitialIso (O : ColoredOperadObj W C) (A : Algebra O) :
    canonicalEnvelopingAlgebra O A ≅ InitialAttachment.initialAlgebra (envelopingOperad O A) :=
  canonicalEnvelopingAlgebraIso O A ≪≫ NullaryCarrier.algebraIso (envelopingOperad O A)

theorem baseInitialIso_hom (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (baseInitialIso O A).hom.hom d =
      (envelopingOperadNullaryIso O A d).inv ≫ InitialAttachment.nullaryToInitial (envelopingOperad O A) d := rfl

theorem baseInitialIso_inv (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (baseInitialIso O A).inv.hom d =
      InitialAttachment.initialToNullary (envelopingOperad O A) d ≫ (envelopingOperadNullaryIso O A d).hom := rfl

/-- The original y-classifier uses the original unary free-generator
map and the whole original O-algebra morphism y. -/
def sourceClassifier (O : ColoredOperadObj W C) (A : Algebra O) {X : W → C}
    (y : freeAlgebra O X ⟶ A) : X ⟶ A.carrier := tensorFreeHomEquiv O X A y

theorem sourceClassifier_original (O : ColoredOperadObj W C) (A : Algebra O) {X : W → C}
    (y : freeAlgebra O X ⟶ A) : sourceClassifier O A y = (profileUnit O).app X ≫ y.hom := rfl

/-- The original free O attaching map constructs a genuine free Env
attaching map into the actual initial Env algebra through the actual A-carrier algebra iso. -/
def envAttachingMap (O : ColoredOperadObj W C) (A : Algebra O) {X : W → C}
    (y : freeAlgebra O X ⟶ A) :
    freeAlgebra (envelopingOperad O A) X ⟶ InitialAttachment.initialAlgebra (envelopingOperad O A) :=
  freeAlgebraLift (envelopingOperad O A) (canonicalEnvelopingAlgebra O A) (sourceClassifier O A y) ≫ (baseInitialIso O
    A).hom

/-- The actual initial Env algebra maps into a genuine original target
under A through the inverse original A/nil comparison and actual canonical Env algebra map. -/
def targetOldEnvMap (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    InitialAttachment.initialAlgebra (envelopingOperad O A) ⟶ underAEnvelopingObject O A B :=
  (baseInitialIso O A).inv ≫ canonicalEnvelopingAlgebraMap O B.hom

theorem targetOldEnvMap_hom (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    (targetOldEnvMap O A B).hom = (baseInitialIso O A).inv.hom ≫ B.hom.hom :=
  congrArg ((baseInitialIso O A).inv.hom ≫ ·) (canonicalEnvelopingAlgebraMap_hom O B.hom)

theorem targetOldEnvMap_initial (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    targetOldEnvMap O A B = InitialAttachment.initialMap (envelopingOperad O A) (underAEnvelopingObject O A B) :=
  InitialAttachment.initialMap_unique (envelopingOperad O A) _ _

/-- The original free O new-input map supplies its original whole
Xprime classifier into the same actual unchanged target carrier. -/
def targetNewEnvMap (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) {Xprime : W → C}
    (z : freeAlgebra O Xprime ⟶ B.right) : freeAlgebra (envelopingOperad O A) Xprime ⟶ underAEnvelopingObject O A B :=
  freeAlgebraLift (envelopingOperad O A) (underAEnvelopingObject O A B) (tensorFreeHomEquiv O Xprime B.right z)

theorem classifier_lift (E : ColoredOperadObj W C) (X : W → C) (M : Algebra E) (f : X ⟶ M.carrier) :
    tensorFreeHomEquiv E X M (freeAlgebraLift E M f) = f := (tensorFreeHomEquiv E X M).apply_symm_apply f

/-- Every original under-A target retains the exact y-classifier after
the actual Env attaching map and actual initial-algebra target map. -/
theorem envAttachingMap_targetClassifier (O : ColoredOperadObj W C) (A : Algebra O) {X : W → C}
    (y : freeAlgebra O X ⟶ A) (B : Under A) :
    tensorFreeHomEquiv (envelopingOperad O A) X (underAEnvelopingObject O A B)
      (envAttachingMap O A y ≫ targetOldEnvMap O A B) = sourceClassifier O A y ≫ B.hom.hom := by
  let E := envelopingOperad O A
  let c := sourceClassifier O A y
  let f := freeAlgebraLift E (canonicalEnvelopingAlgebra O A) c
  let g := canonicalEnvelopingAlgebraMap O B.hom
  have h : envAttachingMap O A y ≫ targetOldEnvMap O A B = f ≫ g := AttachmentSource002_cancelIsoMiddle f
    (baseInitialIso O A) g
  exact (congrArg (tensorFreeHomEquiv E X (underAEnvelopingObject O A B)) h).trans
    ((tensorFreeHomEquiv_target E X f g).trans
      ((congrArg (· ≫ g.hom) (classifier_lift E X (canonicalEnvelopingAlgebra O A) c)).trans
        (congrArg (c ≫ ·) (canonicalEnvelopingAlgebraMap_hom O B.hom))))

/-- The original y/x algebra square is precisely the actual original
free Env attachment relation on the actual target maps, proved on original free generators. -/
theorem targetEnvCompatibility (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (B : Under A) (z : freeAlgebra O Xprime ⟶ B.right)
    (h : y ≫ B.hom = (freeAlgebraFunctor O).map x ≫ z) :
    envAttachingMap O A y ≫ targetOldEnvMap O A B =
      (freeAlgebraFunctor (envelopingOperad O A)).map x ≫ targetNewEnvMap O A B z := by
  let E := envelopingOperad O A
  let e := tensorFreeHomEquiv E X (underAEnvelopingObject O A B)
  let c := tensorFreeHomEquiv O Xprime B.right z
  have hc : sourceClassifier O A y ≫ B.hom.hom = x ≫ c :=
    (tensorFreeHomEquiv_target O X y B.hom).symm.trans
      ((congrArg (tensorFreeHomEquiv O X B.right) h).trans (InitialAttachment.freeRestriction_source O x z))
  have hright : e ((freeAlgebraFunctor E).map x ≫ targetNewEnvMap O A B z) = x ≫ c :=
    (InitialAttachment.freeRestriction_source E x (targetNewEnvMap O A B z)).trans
      (congrArg (x ≫ ·) (classifier_lift E Xprime (underAEnvelopingObject O A B) c))
  exact e.injective ((envAttachingMap_targetClassifier O A y B).trans (hc.trans hright.symm))


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

end
end AttachmentSource002


section AttachmentSource003


/-!
## The constructed original O-algebra attachment object and both original algebra legs
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C := hasProfileColimitsOfSmallColors C d

/-- The actual Env attachment endpoint is the checked original initial
algebra/free-input pushout construction at the actual y-classified map. -/
def envEndpoint (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : Algebra (envelopingOperad O A) :=
  InitialAttachment.attachmentEndpoint (envelopingOperad O A) x (envAttachingMap O A y)

/-- The actual constructed Env endpoint gives a genuine original
O-algebra under A through the proved full original restriction and A-map relation. -/
def endpointUnder (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : Under A := envelopingUnderAObject O A (envEndpoint O A x y)

/-- The original attachment object has all genuine original O
operations from its actual full Env endpoint and original O restriction. -/
def endpoint (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : Algebra O := (endpointUnder O A x y).right

/-- The original A leg is exactly the actual original A-arrow of the
constructed endpoint under A, with the original constant/nullary carrier readback. -/
def oldMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : A ⟶ endpoint O A x y := (endpointUnder O A x y).hom

theorem endpoint_carrier (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : (endpoint O A x y).carrier = (envEndpoint O A x y).carrier := rfl

/-- The original new generators are the original Env free generators
followed by the actual original initial-attachment new algebra leg. -/
def newGenerators (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : Xprime ⟶ (endpoint O A x y).carrier :=
  tensorFreeHomEquiv (envelopingOperad O A) Xprime (envEndpoint O A x y)
    (InitialAttachment.endpointNewMap (envelopingOperad O A) x (envAttachingMap O A y))

theorem newGenerators_original (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    newGenerators O A x y = (profileUnit (envelopingOperad O A)).app Xprime ≫
      (InitialAttachment.endpointNewMap (envelopingOperad O A) x (envAttachingMap O A y)).hom := rfl

/-- The genuine original Free_O Xprime leg is constructed by the actual
original O free lift on those actual original Env new generators. -/
def newMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : freeAlgebra O Xprime ⟶ endpoint O A x y :=
  freeAlgebraLift O (endpoint O A x y) (newGenerators O A x y)

theorem newMap_classifier (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    tensorFreeHomEquiv O Xprime (endpoint O A x y) (newMap O A x y) = newGenerators O A x y :=
  classifier_lift O Xprime (endpoint O A x y) (newGenerators O A x y)

/-- The original canonical A-carrier Env algebra enters the actual
endpoint through the exact original A/nil/initial iso and old Env leg. -/
def canonicalEndpointMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : canonicalEnvelopingAlgebra O A ⟶ envEndpoint O A x y :=
  (baseInitialIso O A).hom ≫ InitialAttachment.endpointOldMap (envelopingOperad O A) x (envAttachingMap O A y)

/-- The original A leg has exactly the original nullary Env/A
comparison inverse and original genuine endpoint nullary operation. -/
theorem oldMap_hom_nullary (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) :
    (oldMap O A x y).hom d = (envelopingOperadNullaryIso O A d).inv ≫ FrozenAlgebra.nullaryEvaluation (envEndpoint O A x
      y) d := by
  let M := envEndpoint O A x y
  let g := linearConstantGenerator O A.carrier d
  let p := (envelopingOperadProjection O A).toCollectionHom.app (ColoredProfile.nullary d)
  let n := FrozenAlgebra.nullaryEvaluation M d
  have h := congrFun (LinearAlgebraRelation.linearConstants_restrict O A.carrier (envelopingOperadProjection O A) M) d
  have hg : g ≫ p = (envelopingOperadNullaryIso O A d).inv := envelopingConstantGenerator_eq_inverse O A d
  exact h.trans ((Category.assoc g p n).symm.trans (congrArg (· ≫ n) hg))

/-- The actual canonical old Env map retains exactly the original
whole O-algebra A-leg carrier, derived from genuine nullary Hom naturality. -/
theorem canonicalEndpointMap_hom (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : (canonicalEndpointMap O A x y).hom = (oldMap O A x y).hom := by
  funext d
  let E := envelopingOperad O A
  let h := canonicalEndpointMap O A x y
  let e := envelopingOperadNullaryIso O A d
  let n := FrozenAlgebra.nullaryEvaluation (envEndpoint O A x y) d
  have h1 : e.hom ≫ h.hom d = n :=
    (congrArg (· ≫ h.hom d) (canonicalEnvelopingAlgebra_nullaryEvaluation O A d).symm).trans
      (algebraNullaryEvaluation_naturality E h d)
  have h2 : e.hom ≫ (oldMap O A x y).hom d = n :=
    (congrArg (e.hom ≫ ·) (oldMap_hom_nullary O A x y d)).trans (e.hom_inv_id_assoc n)
  exact (cancel_epi e.hom).1 (h1.trans h2.symm)

/-- The original y classifier into the actual old Env leg retains the
whole original canonical A-map carrier, with no span equality supplied as an output. -/
theorem envOldLeg_classifier (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    tensorFreeHomEquiv (envelopingOperad O A) X (envEndpoint O A x y)
      (envAttachingMap O A y ≫ InitialAttachment.endpointOldMap (envelopingOperad O A) x (envAttachingMap O A y)) =
    sourceClassifier O A y ≫ (canonicalEndpointMap O A x y).hom := by
  let E := envelopingOperad O A
  let f := freeAlgebraLift E (canonicalEnvelopingAlgebra O A) (sourceClassifier O A y)
  let b := (baseInitialIso O A).hom
  let i := InitialAttachment.endpointOldMap E x (envAttachingMap O A y)
  have h : tensorFreeHomEquiv E X (InitialAttachment.initialAlgebra E) (envAttachingMap O A y) =
      sourceClassifier O A y ≫ b.hom :=
    (tensorFreeHomEquiv_target E X f b).trans
      (congrArg (· ≫ b.hom) (classifier_lift E X (canonicalEnvelopingAlgebra O A) (sourceClassifier O A y)))
  exact (tensorFreeHomEquiv_target E X (envAttachingMap O A y) i).trans
    ((congrArg (· ≫ i.hom) h).trans (Category.assoc _ _ _))

/-- Both genuine original O-algebra legs satisfy the exact original
y/x free-attachment square, derived from the actual Env endpoint square on original classifiers. -/
theorem originalSquare (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    y ≫ oldMap O A x y = (freeAlgebraFunctor O).map x ≫ newMap O A x y := by
  let E := envelopingOperad O A
  let eE := tensorFreeHomEquiv E X (envEndpoint O A x y)
  have hEnv := InitialAttachment.endpointOriginalSquare E x (envAttachingMap O A y)
  have hclass : sourceClassifier O A y ≫ (canonicalEndpointMap O A x y).hom = x ≫ newGenerators O A x y :=
    (envOldLeg_classifier O A x y).symm.trans
      ((congrArg eE hEnv).trans (InitialAttachment.freeRestriction_source E x
        (InitialAttachment.endpointNewMap E x (envAttachingMap O A y))))
  have hc : sourceClassifier O A y ≫ (oldMap O A x y).hom = x ≫ newGenerators O A x y :=
    (congrArg (sourceClassifier O A y ≫ ·) (canonicalEndpointMap_hom O A x y)).symm.trans hclass
  let eO := tensorFreeHomEquiv O X (endpoint O A x y)
  have hl : eO (y ≫ oldMap O A x y) = sourceClassifier O A y ≫ (oldMap O A x y).hom :=
    tensorFreeHomEquiv_target O X y (oldMap O A x y)
  have hr : eO ((freeAlgebraFunctor O).map x ≫ newMap O A x y) = x ≫ newGenerators O A x y :=
    (InitialAttachment.freeRestriction_source O x (newMap O A x y)).trans
      (congrArg (x ≫ ·) (newMap_classifier O A x y))
  exact eO.injective (hl.trans (hc.trans hr.symm))


end CategoryTheory.Operad.Tensor.Enveloping.OriginalAttachment

end
end AttachmentSource003


section AttachmentSource004


/-!
## The original attachment carrier arrow and the actual initial-enveloping attachment arrow
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance originalInitialEnvelopingCarrierFiniteTensor : FiniteTensor C :=
  FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original A-carrier identifies with the actual initial
enveloping-algebra carrier through the actual original nullary maps. -/
def originalInitialEnvelopingCarrierIso (O : ColoredOperadObj W C) (A : Algebra O) :
    A.carrier ≅ (InitialAttachment.initialAlgebra (envelopingOperad O A)).carrier :=
  (Algebra.forget (envelopingOperad O A)).mapIso (OriginalAttachment.baseInitialIso O A)

/-- The entire original forward nullary/initial comparison survives literally. -/
theorem originalInitialEnvelopingCarrierIso_hom (O : ColoredOperadObj W C) (A : Algebra O) :
    (originalInitialEnvelopingCarrierIso O A).hom = (OriginalAttachment.baseInitialIso O A).hom.hom := rfl

/-- The entire original inverse initial/nullary comparison survives literally. -/
theorem originalInitialEnvelopingCarrierIso_inv (O : ColoredOperadObj W C) (A : Algebra O) :
    (originalInitialEnvelopingCarrierIso O A).inv = (OriginalAttachment.baseInitialIso O A).inv.hom := rfl

/-- The exact original A-to-O-attachment carrier arrow is isomorphic
to the actual initial-enveloping attachment carrier arrow. Both arrows
are constructed from the original O,A,y,x; the target carrier is literal
and the source comparison keeps every original nullary A-map. -/
def originalAttachmentCarrierArrowIso (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    Arrow.mk (OriginalAttachment.oldMap O A x y).hom ≅
      Arrow.mk (InitialAttachment.endpointOldMap (envelopingOperad O A) x
        (OriginalAttachment.envAttachingMap O A y)).hom :=
  Arrow.isoMk (originalInitialEnvelopingCarrierIso O A) (Iso.refl _)
    ((OriginalAttachment.canonicalEndpointMap_hom O A x y).trans (Category.comp_id _).symm)

/-- The actual arrow isomorphism has the original complete A/nil
source map and the identity on the actual original endpoint carrier. -/
theorem originalAttachmentCarrierArrowIso_hom_left (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (originalAttachmentCarrierArrowIso O A x y).hom.left = (originalInitialEnvelopingCarrierIso O A).hom := rfl

/-- The target of the actual arrow comparison retains the original endpoint carrier literally. -/
theorem originalAttachmentCarrierArrowIso_hom_right (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (originalAttachmentCarrierArrowIso O A x y).hom.right = 𝟙 (OriginalAttachment.endpoint O A x y).carrier := rfl

/-- The inverse arrow comparison retains the original complete initial/nil/A source map. -/
theorem originalAttachmentCarrierArrowIso_inv_left (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) :
    (originalAttachmentCarrierArrowIso O A x y).inv.left = (originalInitialEnvelopingCarrierIso O A).inv := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end AttachmentSource004


section AttachmentSource005


/-!
## Original attachment arrows at every actual output color
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance originalInitialEnvelopingColorFiniteTensor : FiniteTensor C :=
  FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Each original color keeps the actual original A/nil/initial
isomorphism obtained by the canonical family evaluation functor. -/
def originalInitialEnvelopingColorIso (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    A.carrier d ≅ (InitialAttachment.initialAlgebra (envelopingOperad O A)).carrier d :=
  (Pi.eval (fun _ : W => C) d).mapIso (originalInitialEnvelopingCarrierIso O A)

/-- Each original output color keeps the exact original O-algebra
attachment arrow and the actual initial-Env attachment arrow, with
the original A/nil source map and literal endpoint carrier. -/
def originalAttachmentColorArrowIso (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) :
    Arrow.mk ((OriginalAttachment.oldMap O A x y).hom d) ≅
      Arrow.mk ((InitialAttachment.endpointOldMap (envelopingOperad O A) x
        (OriginalAttachment.envAttachingMap O A y)).hom d) :=
  (Pi.eval (fun _ : W => C) d).mapArrow.mapIso (originalAttachmentCarrierArrowIso O A x y)

/-- The complete actual original nullary source comparison is retained at every color. -/
theorem originalAttachmentColorArrowIso_hom_left (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) :
    (originalAttachmentColorArrowIso O A x y d).hom.left = (originalInitialEnvelopingColorIso O A d).hom := rfl

/-- Every original target color retains its literal original endpoint carrier identity. -/
theorem originalAttachmentColorArrowIso_hom_right (O : ColoredOperadObj W C) (A : Algebra O)
    {X Xprime : W → C} (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) :
    (originalAttachmentColorArrowIso O A x y d).hom.right = 𝟙 ((OriginalAttachment.endpoint O A x y).carrier d) := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end AttachmentSource005


section AttachmentSource006


/-!
## Original heterogeneous profile tensor cube cells

Every displayed finite profile is retained. The coefficient is the coefficient
of the same original tensor operad, and every cube coordinate is the component
of the same original color-indexed arrow. The boundary comparison is the shared
finite cube's full arrow isomorphism, including every original proper face.
-/


set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory

attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance cellFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance cellSmallestColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The genuine coefficient-weighted cube of the same original operad and
original heterogeneous attachment arrow. -/
def profileTensorCube (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : FiniteCube.Index (inputCount P) ⥤ C :=
  FiniteCube.tensorCube (profileArrowFamily x P) ⋙ tensorLeft (E.toCollection.obj P)

/-- The genuine original coefficient-weighted punctured cube boundary arrow. -/
def profileBoundaryArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow C :=
  Arrow.mk (FiniteCube.boundaryToTop (profileTensorCube E x P))

/-- The exact original iterated pushout product, weighted by the actual original
operad coefficient. This includes the shared nullary initial-to-unit convention. -/
def profilePushoutProductArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) : Arrow C :=
  (tensorLeft (E.toCollection.obj P)).mapArrow.obj
    (FiniteCube.iteratedPushoutProduct (profileArrowFamily x P))

/-- The original full profile boundary arrow is the coefficient tensor of the
iterated pushout product of precisely its original heterogeneous input arrows. -/
def profileBoundaryPushoutProductIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profileBoundaryArrow E x P ≅ profilePushoutProductArrow E x P :=
  FiniteCube.boundaryPostArrowIso (FiniteCube.tensorCube (profileArrowFamily x P))
      (tensorLeft (E.toCollection.obj P)) ≪≫
    (tensorLeft (E.toCollection.obj P)).mapArrow.mapIso
      (FiniteCube.tensorBoundaryArrowIso (profileArrowFamily x P))

omit [MonoidalClosed C] [Small.{us} W] in
/-- Every original proper face enters the same original full coefficient cube
boundary, with its original x component maps to the top retained. -/
theorem profileBoundaryFace (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : FiniteCube.Punctured (inputCount P)) :
    FiniteCube.boundaryι (profileTensorCube E x P) S ≫ (profileBoundaryArrow E x P).hom =
      (profileTensorCube E x P).map (homOfLE (Finset.subset_univ S.1)) :=
  FiniteCube.boundaryι_boundaryToTop _ _

omit [MonoidalClosed C] [Small.{us} W] [HasColimitsOfSize.{us, us} C] in
/-- The source of every original coefficient cube vertex is exactly the
coefficient tensor of its original heterogeneous X/X′ coordinate choice. -/
theorem profileTensorCube_vertex (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) (S : FiniteCube.Index (inputCount P)) :
    (profileTensorCube E x P).obj S = E.toCollection.obj P ⊗
      OrderedTensor.obj (FiniteCube.vertexFamily
        (fun i => X (P.inputColor (inputEnumeration P i)))
        (fun i => Xprime (P.inputColor (inputEnumeration P i))) S) := rfl


end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource006


section AttachmentSource007


/-!
## Original profile symmetry and punctured tensor cube balance

A finite input family records its original color and its X/X′ coordinate.
Morphisms contain the actual original input bijection and the actual monotone
coordinate maps. Tensoring is the original coefficient/input tensor diagram.
The degree-n boundary colimit therefore retains all original punctured faces
and quotients simultaneously by every original color-preserving permutation.
-/


set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory
open Enveloping

attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- Forgetting a mark retains every original color and input permutation. -/
def forgetInputMarks : MarkedInputs W ⥤ ColoredInputs W :=
  FiniteFamily.map (Prod.snd (FiniteCube.Index 1) (Discrete W))

/-- The original coefficient profile of a marked input family, at its original
output color. -/
def markedProfileFunctor (d : W) : MarkedInputs W ⥤ ColoredProfile W :=
  forgetInputMarks ⋙ inputsToProfile d ⋙ analyticToProfileFunctor W d

/-- Setting every coordinate to X′ keeps all original colors and permutations. -/
def allTopInputs : MarkedInputs W ⥤ MarkedInputs W where
  obj P := ⟨P.index, fun i => (Finset.univ, (P.obj i).2)⟩
  map f :=
    { equiv := f.equiv
      hom i := (𝟙 Finset.univ, (f.hom i).2) }
  map_id _ := markedHom_ext rfl
  map_comp _ _ := markedHom_ext rfl

/-- Every actual coordinate has its original map into the X′ top coordinate. -/
def toAllTopInputs : 𝟭 (MarkedInputs W) ⟶ allTopInputs where
  app P :=
    { equiv := Equiv.refl P.index
      hom i := (homOfLE (Finset.subset_univ (P.obj i).1), 𝟙 (P.obj i).2) }
  naturality _ _ _ := markedHom_ext rfl

/-- The degree-n finite-word representatives retain all original permutations,
including relabellings among different heterogeneous color words. -/
abbrev DegreeMarkedInputs (W : Type uc) (n : ℕ) :=
  InducedCategory (MarkedInputs W)
    (fun p : Fin n → MarkedColor W =>
      (⟨FintypeCat.of (Fin n), p⟩ : MarkedInputs W))

/-- Include the marked inputs of degree `n` into all marked inputs. -/
def degreeMarkedInclusion (n : ℕ) : DegreeMarkedInputs W n ⥤ MarkedInputs W :=
  inducedFunctor _

instance degreeMarkedInclusionFaithful (n : ℕ) : (degreeMarkedInclusion (W := W) n).Faithful :=
  inferInstanceAs (inducedFunctor _).Faithful

/-- A punctured profile retains at least one actual original X input. -/
def IsPuncturedMarked {n : ℕ} (P : DegreeMarkedInputs W n) : Prop :=
  ∃ i : Fin n, (P i).1 ≠ Finset.univ

/-- The full subcategory of degree-`n` marked words with an unselected input. -/
abbrev PuncturedMarkedInputs (W : Type uc) (n : ℕ) :=
  InducedCategory (DegreeMarkedInputs W n)
    (fun p : {P : DegreeMarkedInputs W n // IsPuncturedMarked P} => p.1)

/-- Include the punctured marked inputs into the degree-`n` marked-input category. -/
def puncturedMarkedInclusion (n : ℕ) : PuncturedMarkedInputs W n ⥤ DegreeMarkedInputs W n :=
  inducedFunctor _

instance puncturedMarkedInclusionFaithful (n : ℕ) :
    (puncturedMarkedInclusion (W := W) n).Faithful :=
  inferInstanceAs (inducedFunctor _).Faithful

section Smallness

variable [Small.{us} W]

instance degreeMarkedSmall (n : ℕ) : Small.{us} (DegreeMarkedInputs W n) :=
  inferInstanceAs (Small.{us} (Fin n → FiniteCube.Index 1 × Discrete W))

instance degreeMarkedLocallySmall (n : ℕ) : LocallySmall.{us} (DegreeMarkedInputs W n) where
  hom_small P Q := by
    let m : (P ⟶ Q) → Equiv.Perm (Fin n) :=
      fun f => ((degreeMarkedInclusion (W := W) n).map f).equiv
    apply small_of_injective.{us} (f := m)
    intro f g h
    apply (degreeMarkedInclusion (W := W) n).map_injective
    exact markedHom_ext h

instance degreeMarkedEssentiallySmall (n : ℕ) :
    EssentiallySmall.{us} (DegreeMarkedInputs W n) :=
  essentiallySmall_of_small_of_locallySmall _

instance puncturedMarkedSmall (n : ℕ) : Small.{us} (PuncturedMarkedInputs W n) :=
  inferInstanceAs (Small.{us} {P : DegreeMarkedInputs W n // IsPuncturedMarked P})

instance puncturedMarkedLocallySmall (n : ℕ) : LocallySmall.{us} (PuncturedMarkedInputs W n) where
  hom_small _ _ :=
    small_of_injective.{us} (puncturedMarkedInclusion (W := W) n).map_injective

instance puncturedMarkedEssentiallySmall (n : ℕ) :
    EssentiallySmall.{us} (PuncturedMarkedInputs W n) :=
  essentiallySmall_of_small_of_locallySmall _

end Smallness

section TensorDiagram

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance markedFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance markedDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

local instance markedPuncturedColimits (n : ℕ) : HasColimitsOfShape (PuncturedMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- All original coefficient and leaf maps, including arbitrary input
permutations and heterogeneous original x components, form one actual diagram. -/
def markedTensorDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) : MarkedInputs W ⥤ C :=
  coefficientInputTensorDiagram
    (markedProfileFunctor d ⋙ E.toCollection)
    (FiniteFamily.map (markedInputCarrier x))

/-- Degree-n original profile cubes, retaining every original symmetry. -/
def degreeMarkedTensorDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : DegreeMarkedInputs W n ⥤ C :=
  degreeMarkedInclusion (W := W) n ⋙ markedTensorDiagram E x d

/-- All degree-n original proper cube faces with all original profile
relabelings; this is the genuine punctured symmetry-balance diagram. -/
def puncturedMarkedTensorDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : PuncturedMarkedInputs W n ⥤ C :=
  puncturedMarkedInclusion (W := W) n ⋙ degreeMarkedTensorDiagram E x d n

/-- The original degree-n top profile tensor diagram retains all original
colors and permutations after setting each input to X′. -/
def degreeTopTensorDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : DegreeMarkedInputs W n ⥤ C :=
  degreeMarkedInclusion (W := W) n ⋙ allTopInputs ⋙ markedTensorDiagram E x d

/-- The original full-coordinate face maps form the actual natural
transformation from the degree cube diagram to its top diagram. -/
def degreeToTop (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    degreeMarkedTensorDiagram E x d n ⟶ degreeTopTensorDiagram E x d n where
  app P := (markedTensorDiagram E x d).map
    ((toAllTopInputs (W := W)).app ((degreeMarkedInclusion (W := W) n).obj P))
  naturality _ _ f :=
    (Functor.whiskerRight (toAllTopInputs (W := W)) (markedTensorDiagram E x d)).naturality
      ((degreeMarkedInclusion (W := W) n).map f)

/-- The genuine degree-n balanced top object is constructed by its original
profile/coordinate colimit, rather than supplying its desired orbit quotient. -/
def degreeBalancedTop (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : C :=
  colimit (degreeTopTensorDiagram E x d n)

/-- The actual boundary-to-top cocone uses every original full-coordinate face
and every original symmetry in the same original degree colimit. -/
def balancedBoundaryCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    Cocone (puncturedMarkedTensorDiagram E x d n) where
  pt := degreeBalancedTop E x d n
  ι.app P := (degreeToTop E x d n).app P.1 ≫
    colimit.ι (degreeTopTensorDiagram E x d n) P.1
  ι.naturality P Q f := by
    let g := (puncturedMarkedInclusion (W := W) n).map f
    let D := degreeMarkedTensorDiagram E x d n
    let T := degreeTopTensorDiagram E x d n
    let a := degreeToTop E x d n
    exact (Category.assoc (D.map g) (a.app Q.1) (colimit.ι T Q.1)).symm.trans
      ((congrArg (· ≫ colimit.ι T Q.1) (a.naturality g)).trans
        ((Category.assoc (a.app P.1) (T.map g) (colimit.ι T Q.1)).trans
          ((congrArg (a.app P.1 ≫ ·) (colimit.w T g)).trans
            (Category.comp_id _).symm)))

/-- The genuine original degree-n balanced punctured tensor boundary arrow. -/
def degreeBalancedArrow (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : Arrow C :=
  Arrow.mk (colimit.desc _ (balancedBoundaryCocone E x d n))

omit [MonoidalClosed C] in
/-- Every original punctured marked profile retains its exact original face
map and same balanced degree-n boundary-to-top arrow. -/
theorem degreeBalancedArrow_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (P : PuncturedMarkedInputs W n) :
    colimit.ι (puncturedMarkedTensorDiagram E x d n) P ≫ (degreeBalancedArrow E x d n).hom =
      (degreeToTop E x d n).app P.1 ≫ colimit.ι (degreeTopTensorDiagram E x d n) P.1 :=
  colimit.ι_desc _ _


end TensorDiagram

end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource007


section AttachmentSource008


/-!
## Original nullary contractions at the constructed initial algebra

The attaching values are obtained from the actual original free algebra map.
They are converted to original nullary E coefficients by the constructed
initial-algebra comparison. The contraction then uses actual original operad
substitution and original variable-unit insertion, retaining every surviving
heterogeneous X′ input and all original finite tensor factors.
-/


set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance contractionFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance contractionTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C

local instance contractionProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original attaching value is the actual original free Hom restriction
of the actual original attaching algebra map. -/
def attachingValue (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) : X ⟶ (initialAlgebra E).carrier :=
  tensorFreeHomEquiv E X (initialAlgebra E) a

/-- Each original attaching input supplies its original nullary E coefficient
through the constructed initial-algebra carrier comparison. -/
def attachingNullaryValue (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (r : W) :
    X r ⟶ E.toCollection.obj (ColoredProfile.nullary r) :=
  attachingValue E a r ≫ initialToNullary E r

theorem attachingNullaryValue_original (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (r : W) :
    attachingNullaryValue E a r ≫ nullaryToInitial E r = attachingValue E a r :=
  (Category.assoc _ _ _).trans
    ((congrArg (attachingValue E a r ≫ ·) (initialToNullary_nullaryToInitial E r)).trans
      (Category.comp_id _))

/-- The original nullary branch at each original contracted color. -/
def constantBranches (Q : ColoredInputs W) : FrozenBranchTuple Q :=
  fun j => AnalyticIndex.nullary (d := (Q.obj j).as)

/-- The original coefficient/input tensor family before contraction. -/
def constantInputFamily (E : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) : FiniteFamily C :=
  (coefficientLeafFamilyFunctor ((addedAlgebraInputs X).obj Q)).obj
    (E.obj (extendProfile P Q))

/-- Convert exactly the original contracted X inputs to their actual original
nullary E coefficients, retaining the root coefficient and all its positions. -/
def constantInputCoefficientMap (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    constantInputFamily E.toCollection X P Q ⟶
      frozenCoefficientFamily E.toCollection P Q (constantBranches Q) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 (E.toCollection.obj (extendProfile P Q))
    | some j => attachingNullaryValue E a (Q.obj j).as

/-- Actual original E-substitution contracts every displayed original X
input, using the original unit at every surviving variable position. -/
def initialCoefficientContraction (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj (constantInputFamily E.toCollection X P Q) ⟶
      E.toCollection.obj (extendProfile P (frozenTotalInputs Q (constantBranches Q))) :=
  (FiniteTensor.tensor (V := C)).map (constantInputCoefficientMap E a P Q) ≫
    frozenPartialSubstitution E P Q (constantBranches Q)

/-- The exact original flattened coefficient/X/X′ source of a punctured face
contraction, retaining every heterogeneous surviving input. -/
def initialContractionSource (E : ColoredSymmetricCollection W C) (X Xprime : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) : C :=
  (FiniteTensor.tensor (V := C)).obj
    ((FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested (constantInputFamily E X P Q) (profileLeafFamily Xprime P)))

/-- The genuine original weighted contraction preserves all original surviving
X′ inputs while substituting the actual original nullary E coefficients of the
original attaching values. It uses the actual original finite tensor normalization. -/
def initialWeightedContraction (E : ColoredOperadObj W C) {X : W → C} (Xprime : W → C)
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) (Q : ColoredInputs W) :
    initialContractionSource E.toCollection X Xprime P Q ⟶
      (coefficientLeafTensorFunctor (profileLeafFamily Xprime P)).obj
        (E.toCollection.obj (extendProfile P (frozenTotalInputs Q (constantBranches Q)))) :=
  coefficientLeavesNormalization (constantInputFamily E.toCollection X P Q)
      (profileLeafFamily Xprime P) ≫
    (coefficientLeafTensorFunctor (profileLeafFamily Xprime P)).map
      (initialCoefficientContraction E a P Q)


end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource008


section AttachmentSource009



set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory Enveloping

attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- An input is selected when its one-dimensional marking is the full vertex. -/
abbrev SelectedInput (P : MarkedInputs W) (i : P.index) : Prop := (P.obj i).1 = Finset.univ

/-- The surviving original X′ inputs, with their original heterogeneous colors. -/
def survivingInputs (P : MarkedInputs W) : ColoredInputs W where
  index := FintypeCat.of {i : P.index // SelectedInput P i}
  obj i := (P.obj i.1).2

/-- The contracted original X inputs, with their original heterogeneous colors. -/
def contractedInputs (P : MarkedInputs W) : ColoredInputs W where
  index := FintypeCat.of {i : P.index // ¬ SelectedInput P i}
  obj i := (P.obj i.1).2

/-- The colored profile of the selected inputs, with output color `d`. -/
def survivingProfile (d : W) (P : MarkedInputs W) : ColoredProfile W :=
  ((inputsToProfile d).obj (survivingInputs P)).toColoredProfile

/-- The number of inputs that survive the marked contraction. -/
def survivingDegree (P : MarkedInputs W) : ℕ := Fintype.card (survivingInputs P).index

/-- Every original proper degree-n face contracts to a strictly earlier
degree, including the all-X face of degree zero. -/
theorem survivingDegree_punctured_lt {n : ℕ} (P : PuncturedMarkedInputs W n) :
    survivingDegree ((degreeMarkedInclusion (W := W) n).obj P.1) < n := by
  let Q := (degreeMarkedInclusion (W := W) n).obj P.1
  let : Fintype {i : Q.index // SelectedInput Q i} :=
    inferInstanceAs (Fintype (survivingInputs Q).index)
  rcases P.2 with ⟨i, hi⟩
  have h := Fintype.card_subtype_lt (p := SelectedInput Q) (x := i) hi
  have hc : Fintype.card Q.index = n :=
    (@Fintype.card_congr Q.index (Fin n) (inferInstanceAs (Fintype Q.index))
      (Fin.fintype n) (Equiv.refl (Fin n))).trans (Fintype.card_fin n)
  change Fintype.card (survivingInputs Q).index < n
  exact h.trans_eq hc

/-- The original full coefficient profile is exactly the disjoint surviving
and contracted original input family, via its actual original color bijection. -/
def selectionRootHom (d : W) (P : MarkedInputs W) :
    extendProfile (survivingProfile d P) (contractedInputs P) ⟶
      (markedProfileFunctor d).obj P where
  inputEquiv := Equiv.sumCompl (SelectedInput P)
  inputColor_eq i := by
    cases i <;> rfl
  outputColor_eq := rfl

/-- Original root, contracted inputs and surviving inputs are merely regrouped;
the exact Option/Sigma input bijection is retained. -/
def contractionInputEquiv (P : MarkedInputs W) :
    Option P.index ≃
      (Σ i : Option (survivingInputs P).index,
        match i with
        | none => Option (contractedInputs P).index
        | some _ => PUnit) where
  toFun i := match i with
    | none => ⟨none, none⟩
    | some i => if hi : SelectedInput P i then ⟨some ⟨i, hi⟩, PUnit.unit⟩
        else ⟨none, some ⟨i, hi⟩⟩
  invFun i := match i with
    | ⟨none, none⟩ => none
    | ⟨none, some i⟩ => some i.1
    | ⟨some i, _⟩ => some i.1
  left_inv i := by
    cases i with
    | none => rfl
    | some i =>
      by_cases hi : SelectedInput P i
      · simp only [dite_eq_left hi]
      · simp only [dite_eq_right hi]
  right_inv i := by
    rcases i with ⟨i, j⟩
    cases i with
    | none =>
      cases j with
      | none => rfl
      | some j =>
        rcases j with ⟨j, hj⟩
        simp only [dite_eq_right hj]
    | some i =>
      rcases i with ⟨i, hi⟩
      cases j
      simp only [dite_eq_left hi]


section Tensor

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance markedContractionFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance markedContractionTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C

local instance markedContractionProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The operad coefficient and marked carrier factors before contraction. -/
def markedSourceFactors (E : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) : FiniteFamily C :=
  (coefficientInputFactors (markedProfileFunctor d ⋙ E)
    (FiniteFamily.map (markedInputCarrier x))).obj P

/-- Flatten the coefficient, contracted `X` inputs and surviving `Xprime` leaves. -/
def markedContractionFactors (E : ColoredSymmetricCollection W C) (X Xprime : W → C)
    (d : W) (P : MarkedInputs W) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj
    (coefficientLeavesNested
      (constantInputFamily E X (survivingProfile d P) (contractedInputs P))
      (profileLeafFamily Xprime (survivingProfile d P)))

/-- The actual original marked cube source is isomorphic to the exact original
root/contracted/surviving tensor source of nullary operad substitution. -/
def markedContractionFactorsIso (E : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) :
    markedSourceFactors E x d P ≅ markedContractionFactors E X Xprime d P := by
  let k :
      (Σ i : Option (survivingInputs P).index,
        match i with
        | none => Option (contractedInputs P).index
        | some _ => PUnit) ≃ (markedContractionFactors E X Xprime d P).index :=
    Equiv.sigmaCongrRight (fun i => by cases i <;> exact Equiv.refl _)
  refine FiniteFamily.isoOfComponents
    (X := markedSourceFactors E x d P) (Y := markedContractionFactors E X Xprime d P)
    ((contractionInputEquiv P).trans k) (fun i => ?_)
  cases i with
  | none =>
    exact E.mapIso (asIso (selectionRootHom d P)).symm
  | some i =>
    by_cases hi : SelectedInput P i
    · have hpos : contractionInputEquiv P (some i) = ⟨some ⟨i, hi⟩, PUnit.unit⟩ := by
        change (if hi : SelectedInput P i then _ else _) = _
        exact dite_eq_left hi
      change (markedSourceFactors E x d P).obj (some i) ≅
        (markedContractionFactors E X Xprime d P).obj (k (contractionInputEquiv P (some i)))
      rw [hpos]
      change (markedInputCarrier x).obj (P.obj i) ≅ Xprime (P.obj i).2.as
      refine eqToIso ?_
      change (markedInputCarrier x).obj ((P.obj i).1, Discrete.mk (P.obj i).2.as) = _
      rw [hi]
      exact markedCarrier_top x _
    · have hneg : contractionInputEquiv P (some i) = ⟨none, some ⟨i, hi⟩⟩ := by
        change (if hi : SelectedInput P i then _ else _) = _
        exact dite_eq_right hi
      change (markedSourceFactors E x d P).obj (some i) ≅
        (markedContractionFactors E X Xprime d P).obj (k (contractionInputEquiv P (some i)))
      rw [hneg]
      change (markedInputCarrier x).obj (P.obj i) ≅ X (P.obj i).2.as
      exact eqToIso (markedCarrier_old x (P.obj i).1 hi (P.obj i).2.as)

/-- Every actual original marked profile has its actual original nullary
contraction map, retaining the actual attaching values and all surviving X′
inputs. The original root color, finite input bijection and units are retained. -/
def markedFaceContraction (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    (markedTensorDiagram E x d).obj P ⟶
      (coefficientLeafTensorFunctor (profileLeafFamily Xprime (survivingProfile d P))).obj
        (E.toCollection.obj (extendProfile (survivingProfile d P)
          (frozenTotalInputs (contractedInputs P) (constantBranches (contractedInputs P))))) :=
  (FiniteTensor.tensor (V := C)).map (markedContractionFactorsIso E.toCollection x d P).hom ≫
    initialWeightedContraction E Xprime a (survivingProfile d P) (contractedInputs P)


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource009


section AttachmentSource011



set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc}

/-- Actual degree-n color profiles with all their original color-preserving
permutations. The objects are finite words solely as small representatives. -/
abbrev PureDegreeInputs (W : Type uc) (n : ℕ) :=
  InducedCategory (ColoredInputs W)
    (fun p : Fin n → W =>
      (⟨FintypeCat.of (Fin n), fun i => Discrete.mk (p i)⟩ : ColoredInputs W))

/-- Include the colored input families of cardinality `n` into all colored inputs. -/
def pureDegreeInclusion (n : ℕ) : PureDegreeInputs W n ⥤ ColoredInputs W := inducedFunctor _

instance pureDegreeInclusionFaithful (n : ℕ) : (pureDegreeInclusion (W := W) n).Faithful :=
  inferInstanceAs (inducedFunctor _).Faithful

theorem coloredInputHom_ext {P Q : ColoredInputs W} {f g : P ⟶ Q} (h : f.equiv = g.equiv) :
    f = g := by
  rcases f with ⟨ef, hf⟩
  rcases g with ⟨eg, hg⟩
  cases h
  exact FiniteFamily.Hom_ext
    (f := { equiv := ef, hom := hf }) (g := { equiv := ef, hom := hg }) rfl
    (fun i => heq_of_eq (Subsingleton.elim (hf i) (hg i)))

/-- Forgetting the X/X′ coordinates retains the original degree profile. -/
def forgetDegreeMarks (n : ℕ) : DegreeMarkedInputs W n ⥤ PureDegreeInputs W n where
  obj P := fun i => (P i).2.as
  map f := InducedCategory.homMk
    { equiv := ((degreeMarkedInclusion (W := W) n).map f).equiv
      hom i := (((degreeMarkedInclusion (W := W) n).map f).hom i).2 }
  map_id P := by
    apply (pureDegreeInclusion (W := W) n).map_injective
    exact coloredInputHom_ext rfl
  map_comp f g := by
    apply (pureDegreeInclusion (W := W) n).map_injective
    exact coloredInputHom_ext rfl

/-- The all-X′ representative of every original degree profile. -/
def pureToMarked (n : ℕ) : PureDegreeInputs W n ⥤ DegreeMarkedInputs W n where
  obj P := fun i => (Finset.univ, Discrete.mk (P i))
  map f := InducedCategory.homMk
    { equiv := ((pureDegreeInclusion (W := W) n).map f).equiv
      hom i := (𝟙 Finset.univ, ((pureDegreeInclusion (W := W) n).map f).hom i) }
  map_id P := by
    apply (degreeMarkedInclusion (W := W) n).map_injective
    exact markedHom_ext rfl
  map_comp f g := by
    apply (degreeMarkedInclusion (W := W) n).map_injective
    exact markedHom_ext rfl

/-- Each original marked profile has its actual original full-coordinate face
into the all-X′ representative of its same original unmarked profile. -/
def degreeToPureTop (n : ℕ) :
    𝟭 (DegreeMarkedInputs W n) ⟶ forgetDegreeMarks n ⋙ pureToMarked n where
  app P := InducedCategory.homMk
    { equiv := Equiv.refl (Fin n)
      hom i := (homOfLE (Finset.subset_univ (P i).1), 𝟙 (P i).2) }
  naturality P Q f := by
    apply (degreeMarkedInclusion (W := W) n).map_injective
    exact markedHom_ext rfl

instance pureDegreeSmall [Small.{us} W] (n : ℕ) : Small.{us} (PureDegreeInputs W n) :=
  inferInstanceAs (Small.{us} (Fin n → W))

instance pureDegreeLocallySmall (n : ℕ) : LocallySmall.{us} (PureDegreeInputs W n) where
  hom_small P Q := by
    let m : (P ⟶ Q) → Equiv.Perm (Fin n) :=
      fun f => ((pureDegreeInclusion (W := W) n).map f).equiv
    apply small_of_injective.{us} (f := m)
    intro f g h
    apply (pureDegreeInclusion (W := W) n).map_injective
    exact coloredInputHom_ext h

instance pureDegreeEssentiallySmall [Small.{us} W] (n : ℕ) :
    EssentiallySmall.{us} (PureDegreeInputs W n) :=
  essentiallySmall_of_small_of_locallySmall _

section Tensor

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance orbitFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance orbitDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

local instance orbitPureDegreeColimits (n : ℕ) : HasColimitsOfShape (PureDegreeInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The genuine original degree-n profile orbit tensor diagram, with all input
coordinates at the original X′ carrier and all original symmetries retained. -/
def pureDegreeTensorDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : PureDegreeInputs W n ⥤ C :=
  pureToMarked (W := W) n ⋙ degreeMarkedTensorDiagram E x d n

/-- The original marked top diagram is the same original profile orbit
diagram after forgetting the redundant X/X′ coordinate labels. -/
def degreeTopPureIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    degreeTopTensorDiagram E x d n ≅
      forgetDegreeMarks (W := W) n ⋙ pureDegreeTensorDiagram E x d n :=
  NatIso.ofComponents (fun _ => Iso.refl _) (by
    intro P Q f
    let D := markedTensorDiagram E x d
    let l := (allTopInputs (W := W)).map ((degreeMarkedInclusion (W := W) n).map f)
    let r := (degreeMarkedInclusion (W := W) n).map
      ((pureToMarked (W := W) n).map ((forgetDegreeMarks (W := W) n).map f))
    exact (Category.comp_id (D.map l)).trans
      ((congrArg D.map (markedHom_ext (f := l) (g := r) rfl)).trans
        (Category.id_comp (D.map r)).symm))

omit [MonoidalClosed C] [Small.{us} W] [HasColimitsOfSize.{us, us} C] in
theorem degreeTopPureMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) {P Q : DegreeMarkedInputs W n} (f : P ⟶ Q) :
    (degreeTopTensorDiagram E x d n).map f =
      (pureDegreeTensorDiagram E x d n).map ((forgetDegreeMarks (W := W) n).map f) :=
  (Category.comp_id _).symm.trans
    (((degreeTopPureIso E x d n).hom.naturality f).trans (Category.id_comp _))

omit [Small.{us} W] in
theorem forgetDegree_pureToMarked_map (n : ℕ) {P Q : PureDegreeInputs W n} (f : P ⟶ Q) :
    (forgetDegreeMarks (W := W) n).map ((pureToMarked (W := W) n).map f) = f := by
  apply (pureDegreeInclusion (W := W) n).map_injective
  exact coloredInputHom_ext rfl

omit [Small.{us} W] in
theorem forgetDegree_toPureTop (n : ℕ) (P : DegreeMarkedInputs W n) :
    (forgetDegreeMarks (W := W) n).map ((degreeToPureTop (W := W) n).app P) =
      𝟙 ((forgetDegreeMarks (W := W) n).obj P) := by
  apply (pureDegreeInclusion (W := W) n).map_injective
  exact coloredInputHom_ext rfl

/-- The original pure profile quotient receives every original marked top
profile, by forgetting only its redundant coordinate label. -/
def topToPureCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : Cocone (degreeTopTensorDiagram E x d n) where
  pt := colimit (pureDegreeTensorDiagram E x d n)
  ι.app P := colimit.ι (pureDegreeTensorDiagram E x d n) ((forgetDegreeMarks (W := W) n).obj P)
  ι.naturality P Q f := by
    let V := pureDegreeTensorDiagram E x d n
    let F := forgetDegreeMarks (W := W) n
    exact (congrArg (· ≫ colimit.ι V (F.obj Q)) (degreeTopPureMap E x d n f)).trans
      ((colimit.w V (F.map f)).trans (Category.comp_id _).symm)

/-- The original all-X′ profile representatives supply the inverse cocone. -/
def pureToTopCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) : Cocone (pureDegreeTensorDiagram E x d n) where
  pt := colimit (degreeTopTensorDiagram E x d n)
  ι.app P := colimit.ι (degreeTopTensorDiagram E x d n) ((pureToMarked (W := W) n).obj P)
  ι.naturality P Q f := by
    let T := degreeTopTensorDiagram E x d n
    let V := pureDegreeTensorDiagram E x d n
    let G := pureToMarked (W := W) n
    have hmap : T.map (G.map f) = V.map f :=
      (degreeTopPureMap E x d n (G.map f)).trans
        (congrArg V.map (forgetDegree_pureToMarked_map n f))
    exact (congrArg (· ≫ colimit.ι T (G.obj Q)) hmap.symm).trans
      ((colimit.w T (G.map f)).trans (Category.comp_id _).symm)

/-- The colimit map from fully marked degree-`n` tensors to pure degree-`n` tensors. -/
def topToPureMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    colimit (degreeTopTensorDiagram E x d n) ⟶ colimit (pureDegreeTensorDiagram E x d n) :=
  colimit.desc _ (topToPureCocone E x d n)

/-- The colimit map from pure degree-`n` tensors to fully marked degree-`n` tensors. -/
def pureToTopMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    colimit (pureDegreeTensorDiagram E x d n) ⟶ colimit (degreeTopTensorDiagram E x d n) :=
  colimit.desc _ (pureToTopCocone E x d n)

omit [MonoidalClosed C] in
theorem topToPureMap_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (P : DegreeMarkedInputs W n) :
    colimit.ι (degreeTopTensorDiagram E x d n) P ≫ topToPureMap E x d n =
      colimit.ι (pureDegreeTensorDiagram E x d n) ((forgetDegreeMarks (W := W) n).obj P) :=
  colimit.ι_desc _ _

omit [MonoidalClosed C] in
theorem pureToTopMap_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) (P : PureDegreeInputs W n) :
    colimit.ι (pureDegreeTensorDiagram E x d n) P ≫ pureToTopMap E x d n =
      colimit.ι (degreeTopTensorDiagram E x d n) ((pureToMarked (W := W) n).obj P) :=
  colimit.ι_desc _ _

omit [MonoidalClosed C] in
theorem topToPureToTop (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    topToPureMap E x d n ≫ pureToTopMap E x d n =
      𝟙 (colimit (degreeTopTensorDiagram E x d n)) := by
  let T := degreeTopTensorDiagram E x d n
  let F := forgetDegreeMarks (W := W) n
  let G := pureToMarked (W := W) n
  apply colimit.hom_ext
  intro P
  let q := (degreeToPureTop (W := W) n).app P
  have hmap : T.map q = 𝟙 (T.obj P) :=
    (degreeTopPureMap E x d n q).trans
      ((congrArg (pureDegreeTensorDiagram E x d n).map (forgetDegree_toPureTop n P)).trans
        ((pureDegreeTensorDiagram E x d n).map_id _))
  have hι : colimit.ι T (G.obj (F.obj P)) = colimit.ι T P :=
    (Category.id_comp _).symm.trans
      ((congrArg (· ≫ colimit.ι T (G.obj (F.obj P))) hmap).symm.trans (colimit.w T q))
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ pureToTopMap E x d n) (topToPureMap_face E x d n P)).trans
      ((pureToTopMap_face E x d n (F.obj P)).trans (hι.trans (Category.comp_id _).symm)))

omit [MonoidalClosed C] in
theorem pureToTopToPure (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    pureToTopMap E x d n ≫ topToPureMap E x d n =
      𝟙 (colimit (pureDegreeTensorDiagram E x d n)) := by
  apply colimit.hom_ext
  intro P
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ topToPureMap E x d n) (pureToTopMap_face E x d n P)).trans
      ((topToPureMap_face E x d n ((pureToMarked (W := W) n).obj P)).trans
        (Category.comp_id _).symm))

/-- The constructed marked top colimit is exactly the original pure profile
symmetry quotient, with both original comparison maps and inverse laws retained. -/
def degreeBalancedTopOrbitIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (n : ℕ) :
    degreeBalancedTop E x d n ≅ colimit (pureDegreeTensorDiagram E x d n) where
  hom := topToPureMap E x d n
  inv := pureToTopMap E x d n
  hom_inv_id := topToPureToTop E x d n
  inv_hom_id := pureToTopToPure E x d n


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource011


section AttachmentSource012



set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc}

/-- Original nullary branches have no original remaining algebra inputs. -/
instance constantTotalInputsEmpty (Q : ColoredInputs W) :
    IsEmpty (frozenTotalInputs Q (constantBranches Q)).index where
  false p := by
    rcases p with ⟨j, k⟩
    change Fin 0 at k
    exact Fin.elim0 k

/-- Erase only the actual original empty family of nullary branch inputs,
retaining every original surviving variable input and its color. -/
def constantInputsDeletionHom (P : ColoredProfile W) (Q : ColoredInputs W) :
    extendProfile P (frozenTotalInputs Q (constantBranches Q)) ⟶ P where
  inputEquiv := Equiv.sumEmpty P.inputs (frozenTotalInputs Q (constantBranches Q)).index
  inputColor_eq i := by
    cases i with
    | inl i => rfl
    | inr i => exact isEmptyElim i
  outputColor_eq := rfl

/-- The actual empty-input deletion respects every original variable profile
map, including arbitrary original permutations and nullary variable profiles. -/
theorem constantInputsDeletionHom_naturality {P Pprime : ColoredProfile W}
    (f : P ⟶ Pprime) (Q : ColoredInputs W) :
    extendProfileMap f (𝟙 (frozenTotalInputs Q (constantBranches Q))) ≫
        constantInputsDeletionHom Pprime Q = constantInputsDeletionHom P Q ≫ f := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl i => rfl
  | inr i => exact isEmptyElim i

/-- The normalized target of an original proper face has its strictly smaller
actual original finite profile degree. -/
theorem survivingProfile_punctured_degree_lt {n : ℕ} (P : PuncturedMarkedInputs W n) (d : W) :
    inputCount (survivingProfile d ((degreeMarkedInclusion (W := W) n).obj P.1)) < n :=
  survivingDegree_punctured_lt P

section Tensor

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance faceTargetFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance faceTargetTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C

local instance faceTargetProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original marked face contracts to the ordinary original profile
summand of its surviving X′ inputs. This uses the actual original attaching
values, original nullary substitution, original empty-input deletion and
original coefficient/leaf comparison, without a supplied target map. -/
def normalizedMarkedFaceContraction (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    (markedTensorDiagram E x d).obj P ⟶
      (operationSummandFunctor E.toCollection Xprime).obj (survivingProfile d P) :=
  markedFaceContraction E x a d P ≫
    (coefficientLeafTensorFunctor (profileLeafFamily Xprime (survivingProfile d P))).map
      (E.toCollection.map (constantInputsDeletionHom (survivingProfile d P) (contractedInputs P))) ≫
    (profileCoefficientLeafTensorIso E.toCollection Xprime (survivingProfile d P)).hom


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment

end
end AttachmentSource012


section AttachmentSource013


/-!
## Original disjoint nullary contraction profiles and all source profile maps
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

variable {W : Type u}

/-- The actual concatenated original color family, with its disjoint input sum. -/
def inputSum (Q1 Q2 : ColoredInputs W) : ColoredInputs W where
  index := FintypeCat.of (Q1.index ⊕ Q2.index)
  obj i := match i with | Sum.inl i => Q1.obj i | Sum.inr i => Q2.obj i

/-- The actual root profile sum-association map, retaining every P/Q1/Q2 color. -/
def rootSumAssocHom (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    extendProfile (extendProfile P Q1) Q2 ⟶ extendProfile P (inputSum Q1 Q2) where
  inputEquiv := Equiv.sumAssoc P.inputs Q1.index Q2.index
  inputColor_eq i := by
    cases i with
    | inl i => cases i <;> rfl
    | inr i => rfl
  outputColor_eq := rfl

/-- Both consumers use the same actual original nullary branch family. -/
theorem branches_eq_initial (Q : ColoredInputs W) :
    Linear.Constants.branches Q = InitialAttachment.constantBranches Q := rfl

/-- Both consumers erase exactly the same actual empty input fibers. -/
theorem deletionHom_eq_initial (P : ColoredProfile W) (Q : ColoredInputs W) :
    Linear.Constants.totalProfileHom P Q = InitialAttachment.constantInputsDeletionHom P Q := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl i => rfl
  | inr i => exact Fin.elim0 i.2

/-- The genuine three-level operad datum for contracting Q2, then Q1.
Surviving P branches have both original unary units; Q1 has a unary
outer unit and nullary inner coefficient; Q2 has its original nullary
coefficient and the actual empty right-unit inner family. -/
def assocData (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) : ColoredAssocData W where
  outputColor := P.outputColor
  branches :=
    { index := FintypeCat.of ((P.inputs ⊕ Q1.index) ⊕ Q2.index)
      obj i := match i with
        | Sum.inl (Sum.inl i) => ColoredSubstitutionData.rightUnit (ColoredSubstitutionData.unitProfile (P.inputColor
          i))
        | Sum.inl (Sum.inr i) => ColoredSubstitutionData.leftUnit (ColoredProfile.nullary (Q1.obj i).as)
        | Sum.inr i => ColoredSubstitutionData.rightUnit (ColoredProfile.nullary (Q2.obj i).as) }

/-- The actual Q2 nullary substitution maps to the middle associativity datum
through the original unit-profile comparisons at every branch. -/
def middleCompare (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    frozenSubstitution (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ⟶
      (assocData P Q1 Q2).middleData where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl ((P.inputs ⊕ Q1.index) ⊕ Q2.index)
      hom i := match i with
        | Sum.inl (Sum.inl i) => ColoredSubstitutionData.rightUnitOuterHom (ColoredSubstitutionData.unitProfile
          (P.inputColor i))
        | Sum.inl (Sum.inr i) => ColoredSubstitutionData.leftUnitOuterHom (ColoredProfile.nullary (Q1.obj i).as)
        | Sum.inr i => ColoredSubstitutionData.rightUnitOuterHom (ColoredProfile.nullary (Q2.obj i).as) }

/-- The genuine flat inner family retains P units and contracts Q1;
its original Q2-empty branch positions are erased by their emptiness. -/
def innerCompare (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (assocData P Q1 Q2).innerData ⟶ frozenSubstitution P Q1 (Linear.Constants.branches Q1) where
  outputColor_eq := rfl
  innerHom :=
    { equiv :=
        { toFun := fun x => match x with
            | ⟨Sum.inl (Sum.inl i), _⟩ => Sum.inl i
            | ⟨Sum.inl (Sum.inr i), _⟩ => Sum.inr i
            | ⟨Sum.inr _, j⟩ => Fin.elim0 j
          invFun := fun x => match x with
            | Sum.inl i => ⟨Sum.inl (Sum.inl i), PUnit.unit⟩
            | Sum.inr i => ⟨Sum.inl (Sum.inr i), PUnit.unit⟩
          left_inv := fun x => by
            rcases x with ⟨i, j⟩
            cases i with
            | inl i => cases i <;> cases j <;> rfl
            | inr i => exact Fin.elim0 j
          right_inv := fun x => by cases x <;> rfl }
      hom x := match x with
        | ⟨Sum.inl (Sum.inl _), _⟩ => 𝟙 _
        | ⟨Sum.inl (Sum.inr _), _⟩ => 𝟙 _
        | ⟨Sum.inr _, j⟩ => Fin.elim0 j }

/-- Contracted local branch totals map to the actual simultaneous
P/(Q1⊔Q2) datum through their original unit-total profile maps. -/
def afterInnerCompare (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (assocData P Q1 Q2).outerAfterInnerData ⟶
      frozenSubstitution P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)) where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.sumAssoc P.inputs Q1.index Q2.index
      hom i := match i with
        | Sum.inl (Sum.inl i) => ColoredSubstitutionData.rightUnitTotalHom (ColoredSubstitutionData.unitProfile
          (P.inputColor i))
        | Sum.inl (Sum.inr i) => ColoredSubstitutionData.leftUnitTotalHom (ColoredProfile.nullary (Q1.obj i).as)
        | Sum.inr i => ColoredSubstitutionData.rightUnitTotalHom (ColoredProfile.nullary (Q2.obj i).as) }

/-- The middle/after-inner root maps are exactly the original full root sum association. -/
theorem rootProfile_readback (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    frozenOuterProfileHom (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
        ColoredSubstitutionData.outerProfileMap (middleCompare P Q1 Q2) ≫
        ColoredSubstitutionData.outerProfileMap
          (d := (assocData P Q1 Q2).outerAfterInnerData) (afterInnerCompare P Q1 Q2) =
      rootSumAssocHom P Q1 Q2 ≫ frozenOuterProfileHom P (inputSum Q1 Q2)
        (Linear.Constants.branches (inputSum Q1 Q2)) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl i => cases i <;> rfl
  | inr i => rfl

/-- The original Q2 total-profile map and actual empty deletion
give precisely the root-profile map for the second Q1 contraction. -/
theorem middleTotal_readback (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    ColoredSubstitutionData.totalProfileMap (middleCompare P Q1 Q2) ≫
        ColoredSubstitutionData.outerProfileMap (innerCompare P Q1 Q2) =
      Linear.Constants.substitutionTotalHom (extendProfile P Q1) Q2 ≫
        frozenOuterProfileHom P Q1 (Linear.Constants.branches Q1) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro x
  rcases x with ⟨i, j⟩
  cases i with
  | inl i => cases i <;> cases j <;> rfl
  | inr i => exact Fin.elim0 j

/-- The two actual final total-profile maps agree on all original surviving P inputs. -/
theorem totalProfile_readback (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (assocData P Q1 Q2).totalHom ≫ ColoredSubstitutionData.totalProfileMap (afterInnerCompare P Q1 Q2) ≫
        Linear.Constants.substitutionTotalHom P (inputSum Q1 Q2) =
      ColoredSubstitutionData.totalProfileMap (innerCompare P Q1 Q2) ≫
        Linear.Constants.substitutionTotalHom P Q1 := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro x
  rcases x with ⟨⟨i, j⟩, k⟩
  cases i with
  | inl i =>
      cases i with
      | inl i => cases j; cases k; rfl
      | inr i => exact Fin.elim0 k
  | inr i => exact Fin.elim0 j


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
end AttachmentSource013


section AttachmentSource014


/-!
## The two literal original disjoint-nullary contraction coefficient routes
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- Root plus actual Q2 nullary coefficients, followed by the actual
Q1 nullary singleton coefficients, with the original Option/Sigma indices. -/
def sequentialGrouping (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option Q1.index)
  obj i := match i with
    | none => frozenCoefficientFamily E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2)
    | some i => (FiniteFamily.singleton (C := C)).obj (E.obj (ColoredProfile.nullary (Q1.obj i).as))

/-- The full original root/Q2/Q1 coefficient family. -/
def sourceFactors (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    FiniteFamily C := (FiniteFamily.flatten (C := C)).obj (sequentialGrouping E P Q1 Q2)

/-- The actual coefficient permutation maps Q2-then-Q1 into Q1⊔Q2,
and the original root uses exactly its input sum-association profile map. -/
def simultaneousFactorMap (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    sourceFactors E P Q1 Q2 ⟶
      frozenCoefficientFamily E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)) where
  equiv :=
    { toFun := fun x => match x with
        | ⟨none, none⟩ => none
        | ⟨none, some i⟩ => some (Sum.inr i)
        | ⟨some i, _⟩ => some (Sum.inl i)
      invFun := fun x => match x with
        | none => ⟨none, none⟩
        | some (Sum.inl i) => ⟨some i, PUnit.unit⟩
        | some (Sum.inr i) => ⟨none, some i⟩
      left_inv := fun x => by
        rcases x with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; rfl
      right_inv := fun x => by
        cases x with
        | none => rfl
        | some i => cases i <;> rfl }
  hom x := match x with
    | ⟨none, none⟩ => E.map (rootSumAssocHom P Q1 Q2)
    | ⟨none, some _⟩ => 𝟙 _
    | ⟨some _, _⟩ => 𝟙 _

variable [FiniteTensor C]

/-- The original full tensor source, with no supplied operation law. -/
def source (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) : C :=
  (FiniteTensor.tensor (V := C)).obj (sourceFactors E P Q1 Q2)

/-- The first original frozen partial substitution contracts precisely Q2,
followed by its actual empty-input deletion; every Q1 coefficient is retained. -/
def firstFactorMap (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (sequentialGrouping E.toCollection P Q1 Q2) ⟶
      frozenCoefficientFamily E.toCollection P Q1 (Linear.Constants.branches Q1) where
  equiv := Equiv.refl (Option Q1.index)
  hom i := match i with
    | none => frozenPartialSubstitution E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
        E.toCollection.map (Linear.Constants.totalProfileHom (extendProfile P Q1) Q2)
    | some i => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (ColoredProfile.nullary (Q1.obj i).as))

/-- The complete literal original route that contracts Q2 and then Q1,
with both actual nullary empty-profile corrections retained. -/
def sequentialRoute (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    source E.toCollection P Q1 Q2 ⟶ E.toCollection.obj P :=
  (FiniteTensor.flattenIso (V := C)).hom.app (sequentialGrouping E.toCollection P Q1 Q2) ≫
    (FiniteTensor.tensor (V := C)).map (firstFactorMap E P Q1 Q2) ≫
      frozenPartialSubstitution E P Q1 (Linear.Constants.branches Q1) ≫
        E.toCollection.map (Linear.Constants.totalProfileHom P Q1)

/-- The complete literal simultaneous route after the actual original
root sum association and Q2/Q1-to-Q1⊔Q2 coefficient permutation. -/
def simultaneousRoute (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    source E.toCollection P Q1 Q2 ⟶ E.toCollection.obj P :=
  (FiniteTensor.tensor (V := C)).map (simultaneousFactorMap E.toCollection P Q1 Q2) ≫
    frozenPartialSubstitution E P (inputSum Q1 Q2) (Linear.Constants.branches (inputSum Q1 Q2)) ≫
      E.toCollection.map (Linear.Constants.totalProfileHom P (inputSum Q1 Q2))

theorem firstFactorMap_root (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W) :
    (firstFactorMap E P Q1 Q2).hom none =
      frozenPartialSubstitution E (extendProfile P Q1) Q2 (Linear.Constants.branches Q2) ≫
        E.toCollection.map (InitialAttachment.constantInputsDeletionHom (extendProfile P Q1) Q2) := by
  exact congrArg (_ ≫ ·) (congrArg E.toCollection.map (deletionHom_eq_initial (extendProfile P Q1) Q2))

omit [FiniteTensor C] in
theorem simultaneousFactorMap_root (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q1 Q2 : ColoredInputs W)
  :
    (simultaneousFactorMap E P Q1 Q2).hom ⟨none, none⟩ = E.map (rootSumAssocHom P Q1 Q2) := rfl

omit [FiniteTensor C] in
theorem simultaneousFactorMap_q2 (E : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    (Q1 Q2 : ColoredInputs W) (i : Q2.index) :
    (simultaneousFactorMap E P Q1 Q2).equiv ⟨none, some i⟩ = some (Sum.inr i) := rfl

omit [FiniteTensor C] in
theorem simultaneousFactorMap_q1 (E : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    (Q1 Q2 : ColoredInputs W) (i : Q1.index) :
    (simultaneousFactorMap E P Q1 Q2).equiv ⟨some i, PUnit.unit⟩ = some (Sum.inl i) := rfl


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary

end
