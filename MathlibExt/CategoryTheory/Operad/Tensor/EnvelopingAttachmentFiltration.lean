section AttachmentSource191

/-!
## Every actual cell keeps its original proper-face attaching map and endpoint cofan
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping ProfileCells HomotopicalAlgebra

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationProfileCellReadbackFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationProfileCellReadbackSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationProfileCellReadbackProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationProfileCellReadbackFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationProfileCellReadbackPunctured (n : ℕ) : HasColimitsOfShape (PuncturedMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The complete original balanced cell endpoint cofan remains its original
degree quotient cofan, original free projection and actual endpoint projection. -/
@[reassoc (attr := simp)]
theorem profileStageCells_endpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (profileStageCells E x a d N).cell i ≫ (attachmentHistory E x a d).incl.app (N + 1) =
      (operadProfileCellCofan E x d (N + 1) (stageCellIndexEquiv (W := W) N i)).right ≫
        degreeFreeMap E x d (N + 1) ≫ (endpointNewMap E x a).hom d := by
  let p := (operadProfileCellCofan E x d (N + 1) (stageCellIndexEquiv (W := W) N i)).right
  let n := recursiveNewDegreeCofan E x a d N
  let j := (attachmentHistory E x a d).incl.app (N + 1)
  exact (congrArg (· ≫ j) (profileStageCells_cell E x a d N i)).trans
    ((Category.assoc p n j).trans (congrArg (p ≫ ·) (recursiveNewDegreeCofan_endpoint E x a d N)))

/-- The attaching map of a source-small profile cell into recursive stage `N`. -/
def profileStageCellAttaching (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N) :
    (profileStageCellArrow E x d N (stageCellIndexEquiv (W := W) N i)).left ⟶ recursiveStage E x a d N :=
  (profileStageCells E x a d N).cofan₁.inj i ≫ (profileStageCells E x a d N).g₁

/-- Each actual original proper coefficient/input face attaches through its
original contraction into a strictly earlier survivor-degree stage cofan. -/
@[reassoc]
theorem profileStageCellAttaching_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N)
    (S : RepresentativePunctured (stageCellIndexEquiv (W := W) N i)) :
    (representativeBoundaryCocone (markedTensorDiagram E x d) d (stageCellIndexEquiv (W := W) N i)).ι.app S ≫
        profileStageCellAttaching E x a d N i =
      lowerFaceValue E x a d N (representativePuncturedVertex (stageCellIndexEquiv (W := W) N i) S) ≫
        (recursiveStageComparison E x a d N).inv := by
  let s := stageCellIndexEquiv (W := W) N i
  let c := (representativeBoundaryCocone (markedTensorDiagram E x d) d s).ι.app S
  let p := (operadProfileCellCofan E x d (N + 1) s).left
  let r := recursiveAttachingMap E x a d N
  let P := representativePuncturedVertex s S
  let j := colimit.ι (puncturedMarkedTensorDiagram E x d (N + 1)) P
  let f := attachingMap E x a d N
  let e := recursiveStageComparison E x a d N
  have hc : c ≫ p = j := operadProfileCellCofan_boundary_face E x d (N + 1) s S
  have h : c ≫ profileStageCellAttaching E x a d N i = j ≫ r :=
    (congrArg (c ≫ ·) (profileStageCells_attaching E x a d N i)).trans
      ((Category.assoc c p r).symm.trans (congrArg (· ≫ r) hc))
  exact h.trans ((Category.assoc j f e.inv).symm.trans
    (congrArg (· ≫ e.inv) (attachingMap_face E x a d N P)))

/-- Every original full profile automorphism preserves the actual cell
attaching map through its original boundary coinvariant cofan. -/
theorem profileStageCellAttaching_aut (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) (i : StageCellIndex W N)
    (g : Aut (representativeProfile d (stageCellIndexEquiv (W := W) N i))) :
    boundaryAutMap E x (representativeProfile d (stageCellIndexEquiv (W := W) N i)) g ≫
      (balancedProfileArrowCofan E x (representativeProfile d (stageCellIndexEquiv (W := W) N i))).left ≫
        profileStageCellAttaching E x a d N i =
      (balancedProfileArrowCofan E x (representativeProfile d (stageCellIndexEquiv (W := W) N i))).left ≫
        profileStageCellAttaching E x a d N i := by
  let P := representativeProfile d (stageCellIndexEquiv (W := W) N i)
  let b := boundaryAutMap E x P g
  let p := (balancedProfileArrowCofan E x P).left
  let f := profileStageCellAttaching E x a d N i
  exact (Category.assoc b p f).symm.trans (congrArg (· ≫ f) (balancedProfileBoundary_relation E x P g))

/-- The complete actual relative-cell history retains the exact original
profile cofan and original degree/free/endpoint maps for every cell. -/
@[reassoc]
theorem attachmentRelativeCellComplex_cell (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (γ : (attachmentRelativeCellComplex E x a d).Cells) :
    γ.ι = (operadProfileCellCofan E x d (γ.j + 1) γ.i).right ≫
      degreeFreeMap E x d (γ.j + 1) ≫ (endpointNewMap E x a).hom d :=
  profileStageCells_endpoint E x a d γ.j γ.k


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
