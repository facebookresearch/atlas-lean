/-!
## Original full-profile cofans into the actual degree tensor colimits
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc}

/-- The original input enumeration presents the same full colored profile
as a degree word, retaining every original color. -/
def enumeratedTopWord (P : ColoredProfile W) : DegreeMarkedInputs W (inputCount P) :=
  fun i => (Finset.univ, Discrete.mk (P.inputColor (inputEnumeration P i)))

/-- The original all-top profile maps to its actual degree representative
through the inverse of the original input enumeration. -/
def topEnumerationIso (P : ColoredProfile W) :
    topMarkedProfile P ≅
      (degreeMarkedInclusion (W := W) (inputCount P)).obj (enumeratedTopWord P) :=
  FiniteFamily.isoOfComponents (inputEnumeration P).symm (fun i => eqToIso (Prod.ext rfl
    (congrArg Discrete.mk (congrArg P.inputColor ((inputEnumeration P).apply_symm_apply i))).symm))

section Tensor

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationProfileFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The all-top marked factors are exactly the original operation coefficient
and the original X′ input factors, with the actual one-slot top comparisons. -/
def topOperationFactorsIso (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (coefficientInputFactors (markedProfileFunctor P.outputColor ⋙ O)
      (FiniteFamily.map (markedInputCarrier x))).obj (topMarkedProfile P) ≅
        (operationFactorsFunctor O Xprime).obj P :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs))
    (fun i => match i with
      | none => Iso.refl _
      | some i => eqToIso (markedCarrier_top x (P.inputColor i)))

/-- Tensoring the original factor comparison retains the genuine full
operation summand, including the nullary profile. -/
def topOperationTensorIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (markedTensorDiagram E x P.outputColor).obj (topMarkedProfile P) ≅
      (operationSummandFunctor E.toCollection Xprime).obj P :=
  (FiniteTensor.tensor (V := C)).mapIso (topOperationFactorsIso E.toCollection x P)

variable [MonoidalClosed C] [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance continuationProfileDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The genuine degree cofan of each original operation summand uses its
original finite input enumeration and the actual degree colimit injection. -/
def profileDegreeSummandCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    (operationSummandFunctor E.toCollection Xprime).obj P ⟶
      degreeBalancedTop E x P.outputColor (inputCount P) :=
  (topOperationTensorIso E x P).inv ≫
    (markedTensorDiagram E x P.outputColor).map (topEnumerationIso P).hom ≫
      colimit.ι (degreeTopTensorDiagram E x P.outputColor (inputCount P)) (enumeratedTopWord P)


end Tensor

end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

