/-!
## Original attaching values and the actual free left-relation classifier
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance leftValueFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance leftValueTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance leftValueProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance leftValueBinaryCoproducts : HasBinaryCoproducts C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete WalkingPair)
local instance leftValueInitial : HasInitial C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete PEmpty)

/-- The original nullary-to-initial comparison followed by the constructed
initial-algebra map is precisely the genuine target nullary operation. -/
theorem nullaryToInitial_map (E : ColoredOperadObj W C) (M : Algebra E) (d : W) :
    nullaryToInitial E d ≫ (initialMap E M).hom d = FrozenAlgebra.nullaryEvaluation M d := by
  let Y := initialCarrier (W := W) (C := C)
  let i := (nullarySummandIso E.toCollection Y d).inv
  let p := profileι E.toCollection Y (AnalyticIndex.nullary (d := d))
  let h := (initialMap E M).hom d
  exact (Category.assoc i p h).trans (nullary_freeHom E Y M (initialMap E M) d)

/-- The actual original attaching value, converted to its original nullary
coefficient, evaluates to the same actual original initial-map image. -/
theorem attachingNullaryValue_map (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (M : Algebra E) (d : W) :
    attachingNullaryValue E a d ≫ FrozenAlgebra.nullaryEvaluation M d =
      attachingValue E a d ≫ (initialMap E M).hom d := by
  let v := attachingValue E a d
  let n := initialToNullary E d
  let i := nullaryToInitial E d
  let m := (initialMap E M).hom d
  have hi : i ≫ m = FrozenAlgebra.nullaryEvaluation M d := nullaryToInitial_map E M d
  have hn : n ≫ i = 𝟙 ((initialAlgebra E).carrier d) := initialToNullary_nullaryToInitial E d
  have h : n ≫ i ≫ m = m :=
    (Category.assoc n i m).symm.trans
      ((congrArg (· ≫ m) hn).trans (Category.id_comp m))
  exact (congrArg (attachingNullaryValue E a d ≫ ·) hi.symm).trans
    ((Category.assoc v n (i ≫ m)).trans (congrArg (v ≫ ·) h))

/-- The original new generators and original attaching values followed by the
actual initial-algebra map give the literal original coproduct classifier. -/
def leftClassifier (E : ColoredOperadObj W C) {X Xprime : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) :
    colorSum Xprime X ⟶ (freeAlgebra E Xprime).carrier :=
  fun d => coprod.desc ((profileUnit E).app Xprime d)
    (attachingValue E a d ≫ (initialMap E (freeAlgebra E Xprime)).hom d)

/-- The actual original left relation is the actual free extension of its
original coproduct classifier, as a whole genuine algebra-map equality. -/
theorem relationLeft_freeLift (E : ColoredOperadObj W C) {X Xprime : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) :
    relationLeft E (Xprime := Xprime) a =
      freeAlgebraLift E (freeAlgebra E Xprime) (leftClassifier E a) := by
  let M := freeAlgebra E Xprime
  let j := initialMap E M
  let en := tensorFreeHomEquiv E Xprime M
  let eo := tensorFreeHomEquiv E X M
  have hn : en (𝟙 M) = (profileUnit E).app Xprime := by
    funext d
    exact Category.comp_id _
  have ho : eo (a ≫ j) = attachingValue E a ≫ j.hom := tensorFreeHomEquiv_target E X a j
  have h : (fun d => coprod.desc (en (𝟙 M) d) (eo (a ≫ j) d)) = leftClassifier E a := by
    funext d
    exact congrArg₂ (fun l r => coprod.desc l r) (congrFun hn d) (congrFun ho d)
  exact congrArg (freeAlgebraLift E M) h

/-- The full actual free Hom equivalence reads back the actual original
left-relation classifier, retaining both original coproduct branches. -/
theorem relationLeft_classifier (E : ColoredOperadObj W C) {X Xprime : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) :
    tensorFreeHomEquiv E (colorSum Xprime X) (freeAlgebra E Xprime) (relationLeft E a) =
      leftClassifier E a :=
  (congrArg (tensorFreeHomEquiv E (colorSum Xprime X) (freeAlgebra E Xprime))
    (relationLeft_freeLift E a)).trans
      ((tensorFreeHomEquiv E (colorSum Xprime X) (freeAlgebra E Xprime)).apply_symm_apply _)

/-- The original old classifier branch is the original attaching nullary
coefficient evaluated in the original new free algebra. -/
theorem leftClassifier_nullary (E : ColoredOperadObj W C) {X Xprime : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    leftClassifier E (Xprime := Xprime) a d =
      coprod.desc ((profileUnit E).app Xprime d)
        (attachingNullaryValue E a d ≫ FrozenAlgebra.nullaryEvaluation (freeAlgebra E Xprime) d) :=
  congrArg (coprod.desc ((profileUnit E).app Xprime d))
    (attachingNullaryValue_map E a (freeAlgebra E Xprime) d).symm


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
