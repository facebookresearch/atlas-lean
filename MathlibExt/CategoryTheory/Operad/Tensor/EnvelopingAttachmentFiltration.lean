namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationNewDegreeFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationNewDegreeSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationNewDegreeProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationNewDegreeFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The literal pushout's new leg is exactly the original recursive degree cofan. -/
theorem recursiveNewDegreeCofan_degree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    recursiveNewDegreeCofan E x a d N =
      recursiveDegreeCofan E x a d (N + 1) (N + 1) (Nat.le_refl _) := by
  let e := recursiveStageComparison E x a d (N + 1)
  let j := stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _)
  have h : recursiveDegreeCofan E x a d (N + 1) (N + 1) (Nat.le_refl _) ≫ e.hom = j :=
    (Category.assoc j e.inv e.hom).trans
      ((congrArg (j ≫ ·) e.inv_hom_id).trans (Category.comp_id j))
  apply (cancel_mono e.hom).1
  exact (recursiveNewDegreeCofan_comparison E x a d N).trans h.symm

/-- The new leg at every actual recursive pushout enters the genuine
endpoint by precisely the original degree cofan and endpoint projection. -/
@[reassoc]
theorem recursiveNewDegreeCofan_endpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    recursiveNewDegreeCofan E x a d N ≫ (attachmentHistory E x a d).incl.app (N + 1) =
      degreeFreeMap E x d (N + 1) ≫ (endpointNewMap E x a).hom d :=
  (congrArg (· ≫ (attachmentHistory E x a d).incl.app (N + 1)) (recursiveNewDegreeCofan_degree E x a d N)).trans
    (attachmentHistory_degree E x a d (N + 1) (N + 1) (Nat.le_refl _))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
