section AttachmentSource151


/-!
## Every original proper marked face in its actual profile class
-/

set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory

variable {W : Type uc}

/-- Classical equality on input coordinates for punctured representative cubes. -/
local instance puncturedIndexDecidableEq (n : ℕ) : DecidableEq (Fin n) := Classical.decEq _

theorem representativeVertex_punctured {n : ℕ} (s : ProfileClass W n)
    (S : Finset (Fin n)) : IsPuncturedMarked (representativeVertex s S) ↔ S ≠ Finset.univ := by
  classical
  constructor
  · rintro ⟨i, hi⟩ h
    subst S
    apply hi
    exact ite_eq_left (Finset.mem_univ i)
  · intro h
    have hn : ∃ i : Fin n, i ∉ S := by
      by_contra hn
      apply h
      exact Finset.eq_univ_iff_forall.mpr (fun i => by
        by_contra hi
        exact hn ⟨i, hi⟩)
    rcases hn with ⟨i, hi⟩
    refine ⟨i, ?_⟩
    change (if i ∈ S then (Finset.univ : FiniteCube.Index 1) else ∅) ≠ Finset.univ
    rw [ite_eq_right hi]
    exact FiniteCube.puncturedOneEmpty.2

/-- Regard a proper representative-cube vertex as a punctured degree-marked input. -/
def representativePuncturedVertex {n : ℕ} (s : ProfileClass W n)
    (S : RepresentativePunctured s) : PuncturedMarkedInputs W n :=
  ⟨representativeVertex s S.1, (representativeVertex_punctured s S.1).mpr S.2⟩

/-- The full original punctured fixed-profile category embeds by its
actual original marked morphisms, retaining all faces and permutations. -/
def puncturedRepresentativeInclusion {n : ℕ} (s : ProfileClass W n) :
    RepresentativePunctured s ⥤ PuncturedMarkedInputs W n where
  obj := representativePuncturedVertex s
  map f := InducedCategory.homMk f.hom.hom
  map_id _ := InducedCategory.hom_ext rfl
  map_comp _ _ := InducedCategory.hom_ext rfl

/-- The coproduct of punctured representative cubes over degree-`n` profile classes. -/
abbrev PuncturedIndex (W : Type uc) (n : ℕ) :=
  Σ s : ProfileClass W n, RepresentativePunctured s

/-- Include the coproduct of punctured representative cubes into punctured marked inputs. -/
def puncturedInclusion (n : ℕ) : PuncturedIndex W n ⥤ PuncturedMarkedInputs W n :=
  Sigma.desc (fun s => puncturedRepresentativeInclusion s)

instance puncturedInclusionFull (n : ℕ) : (puncturedInclusion (W := W) n).Full where
  map_surjective := by
    rintro ⟨s, S⟩ ⟨t, T⟩ f
    have h : s = t := (representativeVertex_class s S.1).symm.trans
      ((degreeClass_map ((puncturedMarkedInclusion (W := W) n).map f)).trans
        (representativeVertex_class t T.1))
    subst t
    exact ⟨Sigma.SigmaHom.mk (InducedCategory.homMk (InducedCategory.homMk f.hom)), rfl⟩

instance puncturedInclusionFaithful (n : ℕ) : (puncturedInclusion (W := W) n).Faithful where
  map_injective := by
    rintro ⟨s, S⟩ ⟨t, T⟩ ⟨f⟩ ⟨g⟩ h
    have h' : f.hom.hom = g.hom.hom := congrArg (fun k => k.hom) h
    exact congrArg Sigma.SigmaHom.mk (InducedCategory.hom_ext (InducedCategory.hom_ext h'))

/-- Identify a punctured marked word with its normalized representative vertex. -/
def puncturedNormalizationIso {n : ℕ} (q : PuncturedMarkedInputs W n) :
    representativePuncturedVertex (degreeClass q.1)
        ⟨normalizationSubset q.1, normalizationSubset_punctured q⟩ ≅ q :=
  InducedCategory.isoMk (normalizationIso q.1)

instance puncturedInclusionEssSurj (n : ℕ) : (puncturedInclusion (W := W) n).EssSurj where
  mem_essImage q := ⟨⟨degreeClass q.1,
    ⟨normalizationSubset q.1, normalizationSubset_punctured q⟩⟩,
    ⟨puncturedNormalizationIso q⟩⟩

instance puncturedInclusionIsEquivalence (n : ℕ) :
    (puncturedInclusion (W := W) n).IsEquivalence where

/-- The original degree boundary category is the genuine disjoint union
of the actual proper-face categories of its original profile classes. -/
def puncturedEquivalence (n : ℕ) : PuncturedIndex W n ≌ PuncturedMarkedInputs W n :=
  (puncturedInclusion (W := W) n).asEquivalence

/-- Degree zero has its original empty color profile, even when W is empty. -/
def zeroClass (W : Type uc) : ProfileClass W 0 :=
  toSkeleton (show PureDegreeInputs W 0 from Fin.elim0)

instance zeroClassSubsingleton : Subsingleton (ProfileClass W 0) where
  allEq s t := (representativeWord_class s).symm.trans
    ((congrArg (fun q : PureDegreeInputs W 0 => toSkeleton q)
      (funext (fun i => Fin.elim0 i))).trans (representativeWord_class t))

instance zeroRepresentativePuncturedEmpty (s : ProfileClass W 0) :
    IsEmpty (RepresentativePunctured s) where
  false S := S.2 (Finset.ext (fun i => Fin.elim0 i))

/-- The actual degree-zero representative is the original nullary profile. -/
def zeroRepresentativeProfileIso (d : W) (s : ProfileClass W 0) :
    representativeProfile d s ≅ ColoredProfile.nullary d :=
  asIso (show representativeProfile d s ⟶ ColoredProfile.nullary d from
    { inputEquiv := Equiv.refl (Fin 0)
      inputColor_eq i := Fin.elim0 i
      outputColor_eq := rfl })


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
