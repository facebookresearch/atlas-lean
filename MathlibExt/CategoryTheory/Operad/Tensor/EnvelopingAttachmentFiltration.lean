/-!
## The actual original attachment endpoint carrier coequalizer
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance carrierCoequalizerFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance carrierCoequalizerTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance carrierCoequalizerProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance carrierCoequalizerParallelColimits : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- The literal original reflexive free presentation at one original color,
with the unchanged actual original endpoint projection. -/
def endpointCarrierCofork (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Cofork ((relationLeft E (Xprime := Xprime) a).hom d) ((relationRight E x).hom d) := by
  letI : HasCoequalizer (relationLeft E (Xprime := Xprime) a) (relationRight E x) :=
    attachmentHasCoequalizer E x a
  exact Cofork.ofπ ((endpointNewMap E x a).hom d)
    (congrArg (fun z => z.hom d)
      (coequalizer.condition (relationLeft E (Xprime := Xprime) a) (relationRight E x)))

/-- A1 creates this actual original reflexive coequalizer; original color
evaluation preserves that same actual colimit. Hence the endpoint carrier has
the full original coequalizer universal property, for arbitrary C-maps. -/
def endpointCarrierIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    IsColimit (endpointCarrierCofork E x a d) := by
  let l := relationLeft E (Xprime := Xprime) a
  let r := relationRight E x
  let U := Algebra.forget E
  let G := U ⋙ Pi.eval (fun _ : W => C) d
  letI : IsReflexivePair l r := relationIsReflexive E x a
  letI : HasCoequalizer l r := attachmentHasCoequalizer E x a
  letI : CreatesColimit (parallelPair l r) U := tensorAlgebraForgetCreatesReflexiveCoequalizer E l r
  letI : PreservesColimit (parallelPair l r) U := inferInstance
  letI : PreservesColimit (parallelPair l r) G := inferInstance
  exact isColimitOfHasCoequalizerOfPreservesColimit G l r

/-- The original underlying relation has its actual C-map descendant,
constructed at that same actual original endpoint carrier. -/
def endpointCarrierDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) {Z : C}
    (f : (freeAlgebra E Xprime).carrier d ⟶ Z)
    (h : (relationLeft E (Xprime := Xprime) a).hom d ≫ f = (relationRight E x).hom d ≫ f) :
    (attachmentEndpoint E x a).carrier d ⟶ Z :=
  (endpointCarrierIsColimit E x a d).desc (Cofork.ofπ f h)

/-- The actual endpoint projection followed by the constructed descendant is
exactly the original arbitrary target map. -/
theorem endpointCarrierMap_desc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) {Z : C}
    (f : (freeAlgebra E Xprime).carrier d ⟶ Z)
    (h : (relationLeft E (Xprime := Xprime) a).hom d ≫ f = (relationRight E x).hom d ≫ f) :
    (endpointNewMap E x a).hom d ≫ endpointCarrierDesc E x a d f h = f :=
  (endpointCarrierIsColimit E x a d).fac (Cofork.ofπ f h) WalkingParallelPair.one

/-- Original endpoint projection cofactors determine every whole original
C-map out of the actual endpoint carrier. -/
theorem endpointCarrier_hom_ext (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) {Z : C}
    {f g : (attachmentEndpoint E x a).carrier d ⟶ Z}
    (h : (endpointNewMap E x a).hom d ≫ f = (endpointNewMap E x a).hom d ≫ g) : f = g :=
  Cofork.IsColimit.hom_ext (endpointCarrierIsColimit E x a d) h

/-- The actual original endpoint projection is epimorphic at every original
color, derived from the created original carrier coequalizer. -/
instance endpointCarrierMap_epi (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    Epi ((endpointNewMap E x a).hom d) where
  left_cancellation f g h := endpointCarrier_hom_ext E x a d (f := f) (g := g) h

/-- The original carrier descendant has full same-endpoint uniqueness. -/
theorem endpointCarrierDesc_unique (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) {Z : C}
    (f : (freeAlgebra E Xprime).carrier d ⟶ Z)
    (h : (relationLeft E (Xprime := Xprime) a).hom d ≫ f = (relationRight E x).hom d ≫ f)
    (g : (attachmentEndpoint E x a).carrier d ⟶ Z) (hg : (endpointNewMap E x a).hom d ≫ g = f) :
    g = endpointCarrierDesc E x a d f h :=
  endpointCarrier_hom_ext E x a d (hg.trans (endpointCarrierMap_desc E x a d f h).symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource138


section AttachmentSource139


/-!
## Original marked face relations and original profile cofactors at the actual endpoint
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Limits Enveloping Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance endpointFacesFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance endpointFacesTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance endpointFacesProfileColimits (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original marked proper or top face satisfies its actual original
contraction/top equation at the actual endpoint. The equation is derived
from the original reflexive presentation and both literal original relation
betas; no compatibility or endpoint relation is supplied as an input. -/
theorem endpoint_original_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : MarkedInputs W) :
    (normalizedMarkedFaceContraction E x a d P ≫
        profileι E.toCollection Xprime (profileInputs (survivingProfile d P))) ≫
          (endpointNewMap E x a).hom d =
      ((markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P) ≫
        (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
          profileι E.toCollection Xprime (profileInputs ((markedProfileFunctor d).obj P))) ≫
            (endpointNewMap E x a).hom d := by
  let m := mixedCofan E x d P
  let l := (relationLeft E (Xprime := Xprime) a).hom d
  let r := (relationRight E x).hom d
  let q := (endpointNewMap E x a).hom d
  have h : l ≫ q = r ≫ q := (endpointCarrierCofork E x a d).condition
  exact (congrArg (· ≫ q) (mixedCofan_relationLeft E x a d P)).symm.trans
    ((Category.assoc m l q).trans
      ((congrArg (m ≫ ·) h).trans
        ((Category.assoc m r q).symm.trans (congrArg (· ≫ q) (mixedCofan_relationRight E x d P)))))

/-- The unchanged original new free profile cofan enters the actual original
attachment endpoint through its unchanged original endpoint projection. -/
def endpointProfileLeg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E)
    {d : W} (P : AnalyticIndex W d) :
    (analyticSummand E.toCollection Xprime).obj P ⟶ (attachmentEndpoint E x a).carrier d :=
  profileι E.toCollection Xprime P ≫ (endpointNewMap E x a).hom d

/-- All original profile cofactors jointly determine every original whole
C-map out of the actual same endpoint carrier, including nullary profiles. -/
theorem endpointProfiles_hom_ext (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) {Z : C}
    {f g : (attachmentEndpoint E x a).carrier d ⟶ Z}
    (h : ∀ P : AnalyticIndex W d, endpointProfileLeg E x a P ≫ f = endpointProfileLeg E x a P ≫ g) :
    f = g := by
  apply endpointCarrier_hom_ext E x a d
  apply colimit.hom_ext
  intro P
  let i := profileι E.toCollection Xprime P
  let q := (endpointNewMap E x a).hom d
  exact (Category.assoc i q f).symm.trans ((h P).trans (Category.assoc i q g))

/-- The original nil coefficient followed by the original old-algebra leg is
exactly its original nullary free cofan at this same original endpoint. -/
theorem endpoint_original_nullary (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    nullaryToInitial E d ≫ (endpointOldMap E x a).hom d =
      (nullarySummandIso E.toCollection Xprime d).inv ≫
        endpointProfileLeg E x a (AnalyticIndex.nullary (d := d)) := by
  let M := attachmentEndpoint E x a
  have ho : (endpointOldMap E x a).hom d = (initialMap E M).hom d :=
    congrArg (fun z => z.hom d) (endpointOldMap_initial E x a)
  have hl : nullaryToInitial E d ≫ (endpointOldMap E x a).hom d = FrozenAlgebra.nullaryEvaluation M d :=
    (congrArg (nullaryToInitial E d ≫ ·) ho).trans (nullaryToInitial_map E M d)
  have hr : (nullarySummandIso E.toCollection Xprime d).inv ≫
      endpointProfileLeg E x a (AnalyticIndex.nullary (d := d)) = FrozenAlgebra.nullaryEvaluation M d :=
    nullary_freeHom E Xprime M (endpointNewMap E x a) d
  exact hl.trans hr.symm


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
end AttachmentSource139


section AttachmentSource140


/-!
## The constructed countable stages identify the genuine original algebra endpoint
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping EndpointRelations

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationEndpointComparisonFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationEndpointComparisonSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationEndpointComparisonProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationEndpointComparisonFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The map from the stage colimit to the algebra endpoint, using its carrier cofork. -/
def omegaToEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    stageEndpoint E x a d ⟶ (attachmentEndpoint E x a).carrier d :=
  omegaCoforkDesc E x a d (endpointCarrierCofork E x a d)

/-- The map from the algebra endpoint to the stage colimit, using its relation equation. -/
def endpointToOmega (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (attachmentEndpoint E x a).carrier d ⟶ stageEndpoint E x a d :=
  endpointCarrierDesc E x a d (omegaFreeMap E x a d) (omegaFreeMap_relation E x a d)

@[reassoc (attr := simp)]
theorem omegaFreeMap_toEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    omegaFreeMap E x a d ≫ omegaToEndpoint E x a d = (endpointNewMap E x a).hom d :=
  omegaFreeMap_desc E x a d (endpointCarrierCofork E x a d)

@[reassoc (attr := simp)]
theorem endpointNewMap_toOmega (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (endpointNewMap E x a).hom d ≫ endpointToOmega E x a d = omegaFreeMap E x a d :=
  endpointCarrierMap_desc E x a d (omegaFreeMap E x a d) (omegaFreeMap_relation E x a d)

theorem omegaToEndpoint_endpointToOmega (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    omegaToEndpoint E x a d ≫ endpointToOmega E x a d = 𝟙 (stageEndpoint E x a d) := by
  let q := omegaFreeMap E x a d
  let f := omegaToEndpoint E x a d
  let g := endpointToOmega E x a d
  apply (cancel_epi q).1
  exact (Category.assoc q f g).symm.trans
    ((congrArg (· ≫ g) (omegaFreeMap_toEndpoint E x a d)).trans
      ((endpointNewMap_toOmega E x a d).trans (Category.comp_id q).symm))

theorem endpointToOmega_omegaToEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    endpointToOmega E x a d ≫ omegaToEndpoint E x a d = 𝟙 ((attachmentEndpoint E x a).carrier d) := by
  let q := (endpointNewMap E x a).hom d
  let f := endpointToOmega E x a d
  let g := omegaToEndpoint E x a d
  apply (cancel_epi q).1
  exact (Category.assoc q f g).symm.trans
    ((congrArg (· ≫ g) (endpointNewMap_toOmega E x a d)).trans
      ((omegaFreeMap_toEndpoint E x a d).trans (Category.comp_id q).symm))

/-- Both complete universal properties are constructed from the original
free-sum presentation and every original bounded stage relation. -/
def omegaEndpointIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    stageEndpoint E x a d ≅ (attachmentEndpoint E x a).carrier d where
  hom := omegaToEndpoint E x a d
  inv := endpointToOmega E x a d
  hom_inv_id := omegaToEndpoint_endpointToOmega E x a d
  inv_hom_id := endpointToOmega_omegaToEndpoint E x a d

/-- The actual colimit of literal recursive pushouts is the carrier of the
already constructed genuine original E-algebra attachment endpoint. -/
def recursiveAttachmentEndpointIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    recursiveStageEndpoint E x a d ≅ (attachmentEndpoint E x a).carrier d :=
  recursiveStageEndpointIso E x a d ≪≫ omegaEndpointIso E x a d

@[reassoc (attr := simp)]
theorem omegaEndpointIso_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : AnalyticIndex W d) :
    omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) ≫ (omegaEndpointIso E x a d).hom =
      endpointProfileLeg E x a P :=
  omegaCoforkDesc_profile E x a d (endpointCarrierCofork E x a d) P

@[reassoc (attr := simp)]
theorem omegaEndpointIso_inv_profile (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (P : AnalyticIndex W d) :
    endpointProfileLeg E x a P ≫ (omegaEndpointIso E x a d).inv =
      omegaProfileCofan E x a ((analyticToProfileFunctor W d).obj P) := by
  let i := profileι E.toCollection Xprime P
  let q := (endpointNewMap E x a).hom d
  let g := endpointToOmega E x a d
  exact (Category.assoc i q g).trans
    ((congrArg (i ≫ ·) (endpointNewMap_toOmega E x a d)).trans (omegaFreeMap_profile E x a d P))

@[reassoc (attr := simp)]
theorem stageι_toEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    stageι E x a d N ≫ (omegaEndpointIso E x a d).hom =
      stageCoforkDesc E x a d N (endpointCarrierCofork E x a d) :=
  omegaCoforkDesc_ι E x a d N (endpointCarrierCofork E x a d)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource140


section AttachmentSource141


/-!
## The actual original algebra attachment's recursive carrier family diagram
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits InitialAttachment.Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance actualDiagramFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance actualDiagramTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance actualDiagramProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance actualDiagramFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The original O,A,y,x construct one actual family of literal recursive
pushout stages, retaining every original output color. -/
def stageFamily (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) : W → C :=
  fun d => recursiveStage (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d N

/-- The entire original color-indexed stage diagram consists of those actual
literal pushout stages and their original recursive connecting maps. -/
def diagram (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : ℕ ⥤ (W → C) :=
  Functor.pi' (fun d => recursiveStageDiagram (envelopingOperad O A) x
    (OriginalAttachment.envAttachingMap O A y) d)

theorem diagram_obj (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    (diagram O A x y).obj N = stageFamily O A x y N := rfl

/-- The original zero-stage source is the original A carrier through the
already constructed full nullary/initial Env comparison. -/
def zeroIso (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : A.carrier ≅ (diagram O A x y).obj 0 :=
  originalInitialEnvelopingCarrierIso O A

/-- The actual recursive endpoint colimit cocone at one original color. -/
def colorEndpointCocone (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) :
    Cocone (recursiveStageDiagram (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d) :=
  (colimit.cocone _).extend
    (recursiveAttachmentEndpointIso (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d).hom

/-- The actual endpoint is colimiting, by the constructed recursive-stage
cofans and the genuine original algebra endpoint comparison. -/
def colorEndpointIsColimit (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (d : W) : IsColimit (colorEndpointCocone O A x y d) :=
  (colimit.isColimit _).ofIsoColimit
    (Cocone.ext (recursiveAttachmentEndpointIso (envelopingOperad O A) x
      (OriginalAttachment.envAttachingMap O A y) d) (fun _ => rfl))

/-- All original colorwise recursive cofactors form the actual original
carrier-family endpoint cocone, at the original O-algebra pushout carrier. -/
def endpointCocone (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : Cocone (diagram O A x y) where
  pt := (OriginalAttachment.endpoint O A x y).carrier
  ι.app N d := (colorEndpointCocone O A x y d).ι.app N
  ι.naturality _N _M f := by
    funext d
    exact (colorEndpointCocone O A x y d).ι.naturality f

/-- Evaluate any original family cocone at the same original output color,
without collapsing color, object or Hom universes. -/
def coconeAt (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (s : Cocone (diagram O A x y)) (d : W) :
    Cocone (recursiveStageDiagram (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d) where
  pt := s.pt d
  ι.app N := s.ι.app N d
  ι.naturality _N _M f := congrFun (s.ι.naturality f) d

/-- The whole original carrier-family endpoint cocone is colimiting. Its
full descendants and uniqueness are derived colorwise from actual original
recursive colimit UPs, with every original family map retained. -/
def endpointIsColimit (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : IsColimit (endpointCocone O A x y) where
  desc s d := (colorEndpointIsColimit O A x y d).desc (coconeAt O A x y s d)
  fac s N := by
    funext d
    exact (colorEndpointIsColimit O A x y d).fac (coconeAt O A x y s d) N
  uniq s f h := by
    funext d
    exact (colorEndpointIsColimit O A x y d).uniq (coconeAt O A x y s d) (f d)
      (fun N => congrFun (h N) d)

/-- The original A carrier enters the genuine original O-algebra endpoint
through the actual zero-stage comparison and original recursive colimit leg. -/
def rootMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : A.carrier ⟶ (OriginalAttachment.endpoint O A x y).carrier :=
  (zeroIso O A x y).hom ≫ (endpointCocone O A x y).ι.app 0

/-- The constructed original carrier-family diagram is genuinely continuous
at its well-order limits; all its actual original successor maps are retained. -/
theorem diagramContinuous (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : (diagram O A x y).IsWellOrderContinuous := inferInstance

/-- The constructed whole original carrier arrow has its actual original
countable history, including the literal recursive pushouts, actual original
A/nil source and full original endpoint colimit. -/
def history (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) : TransfiniteCompositionOfShape ℕ (rootMap O A x y) where
  F := diagram O A x y
  isoBot := (zeroIso O A x y).symm
  isWellOrderContinuous := diagramContinuous O A x y
  incl := (endpointCocone O A x y).ι
  isColimit := endpointIsColimit O A x y
  fac := rfl

/-- Every actual successor of the whole original family diagram is the
literal original recursive pushout's old leg at every original output color. -/
theorem diagram_succ (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    (diagram O A x y).map (homOfLE (Nat.le_succ N)) =
      (fun d => recursiveConnectingMap (envelopingOperad O A) x
        (OriginalAttachment.envAttachingMap O A y) d N) := by
  funext d
  exact recursiveStageMap_succ (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d N


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
end AttachmentSource141


section AttachmentSource142


/-!
## Actual original recursive pushouts in the whole carrier-family category
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping.Filtration

open CategoryTheory Limits InitialAttachment InitialAttachment.Continuation

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance familySuccFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance familySuccSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance familySuccProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance familySuccFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- Both original degree boundary and top are retained at every output color. -/
def degreeSource (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : W → C :=
  fun d => (degreeBalancedArrow (envelopingOperad O A) x d (N + 1)).left

/-- The colorwise balanced top objects for degree `N + 1` of the enveloping attachment. -/
def degreeTarget (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : W → C :=
  fun d => (degreeBalancedArrow (envelopingOperad O A) x d (N + 1)).right

/-- The actual original balanced degree boundary-to-top arrow as a whole
color-indexed carrier map, with every original profile/cube cofan retained. -/
def degreeMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (N : ℕ) : degreeSource O A x N ⟶ degreeTarget O A x N :=
  fun d => (degreeBalancedArrow (envelopingOperad O A) x d (N + 1)).hom

/-- The whole original degree boundary attaches through the original proper
face cocone and the actual original recursive-stage comparison. -/
def attachingFamilyMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    degreeSource O A x N ⟶ stageFamily O A x y N :=
  fun d => recursiveAttachingMap (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d N

/-- The literal old pushout legs are the actual family successor maps. -/
def successorOldMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    stageFamily O A x y N ⟶ stageFamily O A x y (N + 1) :=
  fun d => recursiveConnectingMap (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d N

/-- The literal new pushout legs retain the original full degree top cofans. -/
def successorNewMap (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    degreeTarget O A x N ⟶ stageFamily O A x y (N + 1) :=
  fun d => recursiveNewDegreeCofan (envelopingOperad O A) x (OriginalAttachment.envAttachingMap O A y) d N

theorem successorOriginalSquare (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    attachingFamilyMap O A x y N ≫ successorOldMap O A x y N =
      degreeMap O A x N ≫ successorNewMap O A x y N := by
  funext d
  exact (recursiveSuccessorIsPushout (envelopingOperad O A) x
    (OriginalAttachment.envAttachingMap O A y) d N).w

/-- The whole original recursive successor is its actual original pushout
cocone in the color-indexed carrier category. -/
def successorCocone (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    PushoutCocone (attachingFamilyMap O A x y N) (degreeMap O A x N) :=
  PushoutCocone.mk (successorOldMap O A x y N) (successorNewMap O A x y N)
    (successorOriginalSquare O A x y N)

/-- Full family descendants, both original legs, and whole family uniqueness
are constructed from the actual original literal recursive pushout objects. -/
def successorIsColimit (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) : IsColimit (successorCocone O A x y N) :=
  PushoutCocone.IsColimit.mk _
    (fun s d => pushout.desc (s.inl d) (s.inr d) (congrFun s.condition d))
    (fun s => by
      funext d
      exact pushout.inl_desc _ _ _)
    (fun s => by
      funext d
      exact pushout.inr_desc _ _ _)
    (fun s f hl hr => by
      funext d
      apply pushout.hom_ext
      · exact (congrFun hl d).trans (pushout.inl_desc _ _ _).symm
      · exact (congrFun hr d).trans (pushout.inr_desc _ _ _).symm)

/-- Every whole original successor is a genuine cobase change of its actual
whole original balanced degree arrow. No successor pushout is a source input. -/
theorem successorIsPushout (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    IsPushout (attachingFamilyMap O A x y N) (degreeMap O A x N)
      (successorOldMap O A x y N) (successorNewMap O A x y N) :=
  IsPushout.of_isColimit (successorIsColimit O A x y N)

/-- The original whole history's successor is literally that old pushout leg. -/
theorem historySuccessorIsPushout (O : ColoredOperadObj W C) (A : Algebra O) {X Xprime : W → C}
    (x : X ⟶ Xprime) (y : freeAlgebra O X ⟶ A) (N : ℕ) :
    IsPushout (attachingFamilyMap O A x y N) (degreeMap O A x N)
      ((history O A x y).F.map (homOfLE (Nat.le_succ N))) (successorNewMap O A x y N) := by
  have h : (history O A x y).F.map (homOfLE (Nat.le_succ N)) = successorOldMap O A x y N :=
    diagram_succ O A x y N
  exact h.symm ▸ successorIsPushout O A x y N


end CategoryTheory.Operad.Tensor.Enveloping.Filtration

end
end AttachmentSource142


section AttachmentSource143


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource143_threeIsoHom {V : Type*} [Category* V] {A B K Z : V}
    (e : A ≅ B) (f : B ≅ K) (g : K ≅ Z) :
    (e ≪≫ f ≪≫ g).hom = (e.hom ≫ f.hom) ≫ g.hom :=
  (Category.assoc e.hom f.hom g.hom).symm

private theorem AttachmentSource143_fourIsoHom {V : Type*} [Category* V] {A B K Y Z : V}
    (e : A ≅ B) (f : B ≅ K) (g : K ≅ Y) (h : Y ≅ Z) :
    (e ≪≫ f ≪≫ g ≪≫ h).hom = ((e.hom ≫ f.hom) ≫ g.hom) ≫ h.hom :=
  (Category.assoc e.hom f.hom (g.hom ≫ h.hom)).symm.trans
    (Category.assoc (e.hom ≫ f.hom) g.hom h.hom).symm

private theorem AttachmentSource143_cyclePost {V : Type*} [Category* V] {A B K Y Z : V}
    (a : A ⟶ B) (b : B ⟶ K) (c : K ⟶ A) (r : A ⟶ Y) (n : Y ⟶ Z)
    (h : a ≫ b ≫ c = 𝟙 A) : a ≫ (((b ≫ c) ≫ r) ≫ n) = r ≫ n := by
  have hh := congrArg (fun z => z ≫ r ≫ n) h
  simpa only [Category.assoc, Category.id_comp] using hh

private theorem AttachmentSource143_projectionCofan {V : Type*} [Category* V] {A B K Z : V}
    (j : A ⟶ B) (e : B ≅ K) (k : B ⟶ A) (d : A ⟶ Z)
    (h : j ≫ k = 𝟙 A) : (j ≫ e.hom) ≫ ((e.inv ≫ k) ≫ d) = d := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  exact (Category.assoc j k d).symm.trans ((congrArg (· ≫ d) h).trans (Category.id_comp d))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationZeroColimitFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationZeroColimitSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationZeroColimitProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationZeroColimitFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationZeroColimitDegree : HasColimitsOfShape (DegreeMarkedInputs W 0) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The original zero-word cofan reads back through the entire original
terminal colimit, singleton normalizer and initial nil comparison. -/
theorem zeroBalancedInitialIso_ι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) :
    colimit.ι (degreeTopTensorDiagram E x d 0) zeroMarkedWord ≫ (zeroBalancedInitialIso E x d).hom =
      (zeroMarkedTensorIso E x d).hom ≫ nullaryToInitial E d := by
  let H := zeroMarkedIsTerminal (W := W)
  let : HasTerminal (DegreeMarkedInputs W 0) := H.hasTerminal
  let T := degreeTopTensorDiagram E x d 0
  let z := zeroMarkedWord (W := W)
  let q := colimitOfTerminal T
  let e := terminalIsTerminal.uniqueUpToIso H
  let i := colimit.ι T z
  let m := T.map e.hom
  let r := (zeroMarkedTensorIso E x d).hom
  let n := nullaryToInitial E d
  have hi : i ≫ q.hom = T.map (terminal.from z) :=
    IsColimit.comp_coconePointUniqueUpToIso_hom (colimit.isColimit T)
      (colimitOfDiagramTerminal terminalIsTerminal T) z
  have he : terminal.from z ≫ e.hom = 𝟙 z := H.hom_ext _ _
  have hm : T.map (terminal.from z) ≫ m = 𝟙 (T.obj z) :=
    (T.map_comp (terminal.from z) e.hom).symm.trans ((congrArg T.map he).trans (T.map_id z))
  have h : i ≫ q.hom ≫ m = 𝟙 (T.obj z) :=
    (Category.assoc i q.hom m).symm.trans ((congrArg (· ≫ m) hi).trans hm)
  have hIso : zeroBalancedInitialIso E x d =
      q ≪≫ T.mapIso e ≪≫ zeroMarkedTensorIso E x d ≪≫ nullaryInitialIso E d := rfl
  have hmap : (T.mapIso e).hom = m := Functor.mapIso_hom T e
  have hδ : (zeroBalancedInitialIso E x d).hom = ((q.hom ≫ m) ≫ r) ≫ n :=
    (congrArg (fun k => k.hom) hIso).trans
      ((AttachmentSource143_fourIsoHom q (T.mapIso e) (zeroMarkedTensorIso E x d) (nullaryInitialIso E d)).trans
        (congrArg (fun k => ((q.hom ≫ k) ≫ r) ≫ n) hmap))
  rw [hδ]
  exact AttachmentSource143_cyclePost i q.hom m r n h

/-- The original degree-zero stage cofan has precisely its original
degree-zero-to-initial comparison, through the actual empty coequalizer. -/
theorem stageZeroIso_degree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    stageDegreeLeg E x a d 0 0 (Nat.le_refl _) ≫ (stageZeroIso E x a d).hom =
      (zeroBalancedInitialIso E x d).hom := by
  let q := coequalizer.π (stageRelationLeft E x a d 0) (stageRelationRight E x d 0)
  let : IsIso q := coequalizer.π_of_eq (stage_zero_relations E x a d)
  let e := asIso q
  let A := fun i : Fin 1 => degreeBalancedTop E x d i.val
  let j := stageDegreeι E x d 0 0 (Nat.le_refl _)
  let k := (coproductUniqueIso A).hom
  let t := (zeroBalancedInitialIso E x d).hom
  have hj : j ≫ k = 𝟙 (degreeBalancedTop E x d 0) := by
    simpa only [eqToHom_refl] using! ι_coproductUniqueIso_hom A (⟨0, by decide⟩ : Fin 1)
  have hIso : stageZeroIso E x a d = e.symm ≪≫ coproductUniqueIso A ≪≫ zeroBalancedInitialIso E x d := rfl
  have hs : (stageZeroIso E x a d).hom = (e.inv ≫ k) ≫ t :=
    (congrArg (fun k => k.hom) hIso).trans (AttachmentSource143_threeIsoHom e.symm (coproductUniqueIso A)
      (zeroBalancedInitialIso E x d))
  have hleg : stageDegreeLeg E x a d 0 0 (Nat.le_refl _) = j ≫ e.hom := rfl
  rw [hleg, hs]
  exact AttachmentSource143_projectionCofan j e k t hj


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource143


section AttachmentSource144


/-!
## The exact original degree-zero tensor factor normalization
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationZeroSourceFactorsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The original marked top, original nullary profile reindex and original
nullary singleton comparison form this exact finite-family square. -/
theorem zeroMarkedFactors_square (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) :
    (topOperationFactorsIso E.toCollection x (zeroMarkedProfile d)).hom ≫
        (operationFactorsFunctor E.toCollection Xprime).map (zeroMarkedProfileHom d) ≫
          (nullaryFactorsIso E.toCollection Xprime d).hom =
      (zeroMarkedFactorsIso E x d).hom ≫
        (FiniteFamily.singleton (C := C)).map (E.toCollection.map (zeroMarkedProfileHom d)) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i => exact Fin.elim0 i
  · intro i
    cases i with
    | none =>
        change HEq
          (𝟙 (E.toCollection.obj (zeroMarkedProfile d)) ≫ E.toCollection.map (zeroMarkedProfileHom d) ≫
            𝟙 (E.toCollection.obj (ColoredProfile.nullary d)))
          (𝟙 (E.toCollection.obj (zeroMarkedProfile d)) ≫ E.toCollection.map (zeroMarkedProfileHom d))
        exact heq_of_eq ((Category.id_comp _).trans
          ((Category.comp_id _).trans (Category.id_comp _).symm))
    | some i => exact Fin.elim0 i


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource144


section AttachmentSource145


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource145_threeIsoHom {V : Type*} [Category* V] {A B K Z : V}
    (e : A ≅ B) (f : B ≅ K) (g : K ≅ Z) :
    (e ≪≫ f ≪≫ g).hom = (e.hom ≫ f.hom) ≫ g.hom :=
  (Category.assoc e.hom f.hom g.hom).symm

private theorem AttachmentSource145_normalizerPost {V : Type*} [Category* V] {A B K D Y U Z : V}
    (l : A ⟶ B) (m : B ⟶ K) (n : K ⟶ D) (r : A ⟶ Y) (s : Y ⟶ D)
    (u : D ⟶ Z) (u' : Y ⟶ U) (f : U ⟶ Z)
    (h : l ≫ m ≫ n = r ≫ s) (hu : s ≫ u = u' ≫ f) :
    l ≫ m ≫ n ≫ u = (r ≫ u') ≫ f := by
  have h' : l ≫ m ≫ n ≫ u = (l ≫ m ≫ n) ≫ u :=
    ((Category.assoc l (m ≫ n) u).trans (congrArg (l ≫ ·) (Category.assoc m n u))).symm
  exact h'.trans ((congrArg (· ≫ u) h).trans
    ((Category.assoc r s u).trans ((congrArg (r ≫ ·) hu).trans (Category.assoc r u' f).symm)))

private theorem AttachmentSource145_normalizerRoute {V : Type*} [Category* V] {A B K D Z : V}
    (l : A ⟶ B) (m : B ⟶ K) (e : K ≅ D) (r : A ⟶ D) (q : K ⟶ Z) (j : B ⟶ Z)
    (h : l ≫ m ≫ e.hom = r) (hm : m ≫ q = j) : r ≫ e.inv ≫ q = l ≫ j := by
  rw [← h]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  exact congrArg (l ≫ ·) hm

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationZeroSourceTensorFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

/-- The original marked degree-zero normalizer is exactly the original top
operation map followed by its original nullary tensor normalizer. -/
theorem zeroMarkedTensor_square (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) :
    (topOperationTensorIso E x (zeroMarkedProfile d)).hom ≫
        (operationSummandFunctor E.toCollection Xprime).map (zeroMarkedProfileHom d) ≫
          (nullarySummandIso E.toCollection Xprime d).hom = (zeroMarkedTensorIso E x d).hom := by
  let T := FiniteTensor.tensor (V := C)
  let l := (topOperationFactorsIso E.toCollection x (zeroMarkedProfile d)).hom
  let m := (operationFactorsFunctor E.toCollection Xprime).map (zeroMarkedProfileHom d)
  let n := (nullaryFactorsIso E.toCollection Xprime d).hom
  let r := (zeroMarkedFactorsIso E x d).hom
  let s := (FiniteFamily.singleton (C := C)).map (E.toCollection.map (zeroMarkedProfileHom d))
  let u := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (ColoredProfile.nullary d))
  let u' := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (zeroMarkedProfile d))
  let f := E.toCollection.map (zeroMarkedProfileHom d)
  have ht : T.map l ≫ T.map m ≫ T.map n = T.map r ≫ T.map s :=
    (congrArg (T.map l ≫ ·) (T.map_comp m n).symm).trans
      ((T.map_comp l (m ≫ n)).symm.trans
        ((congrArg T.map (zeroMarkedFactors_square E x d)).trans (T.map_comp r s)))
  have hu : T.map s ≫ u = u' ≫ f := (FiniteTensor.singletonIso (V := C)).hom.naturality f
  have h := AttachmentSource145_normalizerPost (T.map l) (T.map m) (T.map n) (T.map r) (T.map s) u u' f ht hu
  have hp : (topOperationTensorIso E x (zeroMarkedProfile d)).hom = T.map l := rfl
  have hm : (operationSummandFunctor E.toCollection Xprime).map (zeroMarkedProfileHom d) = T.map m := rfl
  have hn : (nullarySummandIso E.toCollection Xprime d).hom = T.map n ≫ u := rfl
  have hr : (zeroMarkedTensorIso E x d).hom = (T.map r ≫ u') ≫ f := by
    let a := T.mapIso (zeroMarkedFactorsIso E x d)
    let b := (FiniteTensor.singletonIso (V := C)).app (E.toCollection.obj (zeroMarkedProfile d))
    let c := E.toCollection.mapIso (asIso (zeroMarkedProfileHom d))
    have he : zeroMarkedTensorIso E x d = a ≪≫ b ≪≫ c := rfl
    have hc : c.hom = f := (Functor.mapIso_hom E.toCollection (asIso (zeroMarkedProfileHom d))).trans
      (congrArg E.toCollection.map (asIso_hom (zeroMarkedProfileHom d)))
    exact (congrArg (fun z => z.hom) he).trans
      ((AttachmentSource145_threeIsoHom a b c).trans (congrArg ((T.map r ≫ u') ≫ ·) hc))
  rw [hp, hm, hn]
  exact h.trans hr.symm

variable [MonoidalClosed C] [Small.{us} W] [HasColimitsOfSize.{us, us} C]

local instance continuationZeroSourceTensorSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationZeroSourceTensorProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

omit [MonoidalClosed C] in
/-- The whole original zero-word free cofan is its original nullary
coefficient insertion through the unchanged original zero normalizer. -/
theorem zeroMarkedTensor_freeCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) :
    (zeroMarkedTensorIso E x d).hom ≫ (nullarySummandIso E.toCollection Xprime d).inv ≫
        profileι E.toCollection Xprime (AnalyticIndex.nullary (d := d)) =
      (topOperationTensorIso E x (zeroMarkedProfile d)).hom ≫
        profileι E.toCollection Xprime (profileInputs (zeroMarkedProfile d)) := by
  let l := (topOperationTensorIso E x (zeroMarkedProfile d)).hom
  let m := (operationSummandFunctor E.toCollection Xprime).map (zeroMarkedProfileHom d)
  let e := nullarySummandIso E.toCollection Xprime d
  let r := (zeroMarkedTensorIso E x d).hom
  let q := profileι E.toCollection Xprime (AnalyticIndex.nullary (d := d))
  let j := profileι E.toCollection Xprime (profileInputs (zeroMarkedProfile d))
  have hm : m ≫ q = j :=
    (profileι_full_relabel E.toCollection Xprime (zeroMarkedProfileHom d)).trans (Category.comp_id j)
  exact AttachmentSource145_normalizerRoute l m e r q j (zeroMarkedTensor_square E x d) hm


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

