/-!
## Construct the full original profile boundary quotient universal property
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc} {C : Type u} [Category.{v} C] [HasColimitsOfSize.{us, us} C]

local instance boundaryUniversalSmallColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

local instance boundaryUniversalAutColimits (P : ColoredProfile W) :
    HasColimitsOfShape (SingleObj (Aut P)) C := HasColimitsOfShape.of_essentiallySmall C _

/-- Restrict an actual target cocone to all original proper coordinate faces. -/
def boundaryRestrictedCocone (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) : Cocone (geometryPuncturedTensor D P) where
  pt := c.pt
  ι.app S := c.ι.app S
  ι.naturality _ _ f := (c.w ((fullProfilePuncturedFaces P).map f)).trans (Category.comp_id _).symm

/-- Descend the ordinary proper-face boundary to a cocone on the full punctured cube. -/
def boundaryRestrictedDesc (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) : geometryInputBoundary D P ⟶ c.pt :=
  colimit.desc _ (boundaryRestrictedCocone D P c)

theorem boundaryRestrictedDesc_face (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) (S : ProfilePuncturedInputSets P) :
    colimit.ι (geometryPuncturedTensor D P) S ≫ boundaryRestrictedDesc D P c = c.ι.app S :=
  colimit.ι_desc (boundaryRestrictedCocone D P c) S

/-- The original full target cocone itself proves invariance of its
original proper-face descent under every original full profile automorphism. -/
theorem boundaryRestrictedDesc_balanced (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) (g : Aut P) :
    geometryAutMap D P g ≫ boundaryRestrictedDesc D P c = boundaryRestrictedDesc D P c := by
  let B := geometryPuncturedTensor D P
  let b := boundaryRestrictedDesc D P c
  apply colimit.hom_ext
  intro S
  let Sg := (profileAutPunctured P g).obj S
  let f : (show FullProfilePunctured P from S) ⟶ Sg :=
    InducedCategory.homMk (InducedCategory.homMk (profileAutInputVertexIso P g S.1).hom)
  exact (Category.assoc (colimit.ι B S) (geometryAutMap D P g) b).symm.trans
    ((congrArg (· ≫ b) (geometryAutMap_face D P g S)).trans
      ((Category.assoc _ (colimit.ι B Sg) b).trans
        ((congrArg (D.map (profileAutInputVertexIso P g S.1).hom ≫ ·)
          (boundaryRestrictedDesc_face D P c Sg)).trans
          ((c.w f).trans (boundaryRestrictedDesc_face D P c S).symm))))

/-- The boundary-orbit cocone induced by a cocone on the full punctured profile cube. -/
def boundaryOrbitTargetCocone (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) : Cocone (geometryBoundaryActionFunctor D P) where
  pt := c.pt
  ι.app _ := boundaryRestrictedDesc D P c
  ι.naturality _ _ g := (boundaryRestrictedDesc_balanced D P c g).trans (Category.comp_id _).symm

/-- Descend through the actual original Aut(P) quotient, after descending
all original proper faces. Neither output map is a premise. -/
def fullProfileBoundaryDesc (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) :
    (fullProfileBoundaryCocone D P).pt ⟶ c.pt :=
  colimit.desc _ (boundaryOrbitTargetCocone D P c)

theorem fullProfileBoundaryDesc_face (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P)) (S : FullProfilePunctured P) :
    (fullProfileBoundaryCocone D P).ι.app S ≫ fullProfileBoundaryDesc D P c = c.ι.app S := by
  let B := geometryPuncturedTensor D P
  let A := geometryBoundaryActionFunctor D P
  let j := colimit.ι A (SingleObj.star (Aut P))
  exact (Category.assoc (colimit.ι B S) j (fullProfileBoundaryDesc D P c)).trans
    ((congrArg (colimit.ι B S ≫ ·) (colimit.ι_desc (F := A) (boundaryOrbitTargetCocone D P c) _)).trans
      (boundaryRestrictedDesc_face D P c S))

theorem fullProfileBoundaryDesc_unique (D : MarkedInputs W ⥤ C) (P : ColoredProfile W)
    (c : Cocone (fullPuncturedTensor D P))
    (m : (fullProfileBoundaryCocone D P).pt ⟶ c.pt)
    (w : ∀ S, (fullProfileBoundaryCocone D P).ι.app S ≫ m = c.ι.app S) :
    m = fullProfileBoundaryDesc D P c := by
  let A := geometryBoundaryActionFunctor D P
  let B := geometryPuncturedTensor D P
  apply colimit.hom_ext (F := A)
  intro j
  cases j
  apply colimit.hom_ext (F := B)
  intro S
  exact (Category.assoc (colimit.ι B S) (colimit.ι A (SingleObj.star (Aut P))) m).symm.trans
    ((w S).trans ((fullProfileBoundaryDesc_face D P c S).symm.trans
      (Category.assoc (colimit.ι B S) (colimit.ι A (SingleObj.star (Aut P))) (fullProfileBoundaryDesc D P c))))

/-- The actual original profile boundary quotient is the genuine colimit
of every original full fixed-profile proper face and profile permutation. -/
def fullProfileBoundaryIsColimit (D : MarkedInputs W ⥤ C) (P : ColoredProfile W) :
    IsColimit (fullProfileBoundaryCocone D P) where
  desc := fullProfileBoundaryDesc D P
  fac := fullProfileBoundaryDesc_face D P
  uniq := fullProfileBoundaryDesc_unique D P


end CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

end
