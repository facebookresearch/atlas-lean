section AttachmentSource054


/-!
## The actual original successive-contraction source triangle
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

open CategoryTheory Enveloping Continuation

attribute [local instance] FintypeCat.fintype

private theorem AttachmentSource054_iterationSourceDependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

private theorem AttachmentSource054_iterationIdentityHEq {D : Type*} [Category* D] {A B T : D} {f : A ⟶ B}
    (hf : ∃ h : A = B, f = eqToHom h) (q : A = T) : HEq f (eqToHom q) := by
  obtain ⟨h, hh⟩ := hf
  exact (heq_of_eq hh).trans
    ((eqToHom_heq_id_dom _ _ h).trans (eqToHom_heq_id_dom _ _ q).symm)

private theorem AttachmentSource054_iterationMapFour {D : Type*} [Category* D] {E : Type*} [Category* E]
    (F : D ⥤ E) {A B C T U : D} (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ T) (k : T ⟶ U) :
    (F.map f ≫ F.map g) ≫ (F.map h ≫ F.map k) = F.map ((f ≫ g ≫ h) ≫ k) := by
  simp only [Functor.map_comp, Category.assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The literal original partial-contraction source and its original residual
normalization/fusion are precisely the original simultaneous contraction
source followed by the actual survivor and old-input maps. No contraction,
compatibility, tensor, stage or operad law is supplied as a premise. -/
theorem iterationSource_triangle (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {P Q : MarkedInputs W} (g : P ⟶ Q) :
    iteratedSourceFactors O x d g = simultaneousSourceFactors O x d g := by
  let K := markedInputCarrier x
  let R := residualMarkedInputs g
  let a := (partialMarkedFactorsIso O x d g).hom
  let n := iterationNormalizationMap O x d g
  let c := simultaneousFusionMap O X (iterationProfile d g) (iterationOldInputs g) (iterationRemainingInputs g)
    (iterationSurvivorLeaves Xprime d R)
  let r := (markedContractionFactorsIso O x d P).hom
  let s := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (contractionInputMap O X (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom)
    (profileLeafIso Xprime (residualSurvivorProfileHom d g)).hom)
  let B := partialMarkedFactors O x d g
  let N := (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
    (iterationCoefficientInputs O X d g)
    (LeafFusion.leafSum (iterationOldLeaves X R) (iterationSurvivorLeaves Xprime d R)))
  let T := (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested
    (constantInputFamily O X (iterationProfile d g)
      (DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g)))
    (iterationSurvivorLeaves Xprime d R))
  let V₀ := markedContractionFactors O X Xprime d P
  let u := (addedAlgebraInputs X).map (iterationContractedInputsIso g).hom
  have hu : u.HasIdentityComponents :=
    (FiniteFamily.isoOfComponents_eqToIso_identityComponents
      (X := contractedInputs P)
      (Y := DisjointNullary.inputSum (iterationOldInputs g) (iterationRemainingInputs g))
      (iterationContractedEquiv g)
      (fun i => congrArg Discrete.mk (iterationContractedEquiv_color g i))).map (Discrete.functor X)
  let p := (profileLeafIso Xprime (residualSurvivorProfileHom d g)).hom
  have hp : p.HasIdentityComponents :=
    FiniteFamily.isoOfReindex_identityComponents
      (X := profileLeafFamily Xprime (survivingProfile d P))
      (Y := profileLeafFamily Xprime (survivingProfile d R))
      (residualSurvivorProfileHom d g).inputEquiv
      (fun i => congrArg Xprime ((residualSurvivorProfileHom d g).inputColor_eq i))
  have he := iterationSource_equiv O x d g
  apply FiniteFamily.Hom_ext
  · exact he
  · intro i
    cases i with
    | none =>
        let f₀ := (markedProfileFunctor d).map g
        let f₁ := (asIso (selectionRootHom d Q)).inv
        let f₂ := extendProfileMap (iterationRootHom d g) (𝟙 (iterationRemainingInputs g))
        let f₃ := DisjointNullary.rootSumAssocHom (iterationProfile d g) (iterationOldInputs g)
          (iterationRemainingInputs g)
        let r₀ := (asIso (selectionRootHom d P)).inv
        let r₁ := extendProfileMap (residualSurvivorProfileHom d g) (iterationContractedInputsIso g).hom
        have hl : (O.map f₀ ≫ O.map f₁) ≫ (O.map f₂ ≫ O.map f₃) =
            O.map (iterationWholeRootHom d g ≫ f₃) := AttachmentSource054_iterationMapFour O f₀ f₁ f₂ f₃
        have ht : O.map (iterationWholeRootHom d g ≫ f₃) = O.map (r₀ ≫ r₁) :=
          congrArg O.map (iterationWholeRoot_triangle d g)
        have hr : O.map (r₀ ≫ r₁) = O.map r₀ ≫ O.map r₁ := O.map_comp _ _
        change HEq ((O.map f₀ ≫ O.map f₁) ≫ (O.map f₂ ≫ O.map f₃)) (O.map r₀ ≫ O.map r₁)
        exact heq_of_eq (hl.trans (ht.trans hr))
    | some i =>
        by_cases hP : SelectedInput P i
        · have hQ : SelectedInput Q (g.equiv i) := markedHom_selected g i hP
          let j : R.index := ⟨g.equiv i, hQ⟩
          have hR : SelectedInput R j := by
            change SelectedInput P (g.equiv.symm (g.equiv i))
            exact (congrArg (SelectedInput P) (g.equiv.symm_apply_apply i)).symm.mp hP
          let V := Xprime (Q.obj (g.equiv i)).2.as
          have ha : a.equiv (some i) = ⟨some j, PUnit.unit⟩ := partialMarked_position_retained O x d g i hQ
          have hn : n.equiv ⟨some j, PUnit.unit⟩ =
              ⟨some ((iterationLeafIso x d R).hom.equiv j), PUnit.unit⟩ :=
            iterationNormalization_position_retained O x d g j
          have hl : (iterationLeafIso x d R).hom.equiv j = Sum.inr ⟨j, hR⟩ :=
            iterationLeaf_position_top x d R j hR
          have hni : n.equiv (a.equiv (some i)) =
              (⟨some (Sum.inr ⟨j, hR⟩), PUnit.unit⟩ : N.index) :=
            (congrArg n.equiv ha).trans
              (hn.trans (congrArg (fun k => (⟨some k, PUnit.unit⟩ : N.index)) hl))
          have hb : B.obj (a.equiv (some i)) = K.obj (R.obj j) := congrArg B.obj ha
          have hd : N.obj (n.equiv (a.equiv (some i))) = V := (congrArg N.obj hni).trans rfl
          have ht : T.obj (c.equiv (n.equiv (a.equiv (some i)))) = V :=
            (congrArg (fun k => T.obj (c.equiv k)) hni).trans rfl
          have ht' : T.obj (s.equiv (r.equiv (some i))) = V :=
            (congrArg (fun e => T.obj (e (some i))) he).symm.trans ht
          let e₁ := congrArg K.obj (retainedMarkEq g i hQ)
          let e₂ : K.obj (R.obj j) = V := markedTopCarrierEq x R j hR
          let e₃ := markedTopCarrierEq x P i hP
          let e₄ : Xprime (P.obj i).2.as = V := congrArg Xprime (Discrete.eq_of_hom (g.hom i).2)
          have hA : HEq (a.hom (some i)) (K.map (eqToHom (retainedMarkEq g i hQ))) :=
            partialMarked_component_retained O x d g i hQ
          have hN : HEq (n.hom (a.equiv (some i))) (eqToHom e₂) :=
            (AttachmentSource054_iterationSourceDependentApply n.hom ha).trans
              ((heq_of_eq (iterationNormalization_component_retained O x d g j)).trans
                (iterationLeaf_component_top x d R j hR))
          have hC : HEq (c.hom (n.equiv (a.equiv (some i)))) (𝟙 V) :=
            (AttachmentSource054_iterationSourceDependentApply c.hom hni).trans HEq.rfl
          have hNC := heq_comp hb hd ht hN hC
          have hleft : HEq ((iteratedSourceFactors O x d g).hom (some i))
              (K.map (eqToHom (retainedMarkEq g i hQ)) ≫ eqToHom e₂) :=
            (heq_comp rfl hb ht hA hNC).trans
              (heq_of_eq (congrArg (K.map (eqToHom (retainedMarkEq g i hQ)) ≫ ·) (Category.comp_id _)))
          have hrp : r.equiv (some i) = ⟨some ⟨i, hP⟩, PUnit.unit⟩ :=
            markedContraction_position_top O x d P i hP
          have hbr : V₀.obj (r.equiv (some i)) = Xprime (P.obj i).2.as := congrArg V₀.obj hrp
          have hR₀ : HEq (r.hom (some i)) (eqToHom e₃) := markedContraction_component_top O x d P i hP
          have hS₀ : HEq (s.hom (r.equiv (some i))) (eqToHom e₄) :=
            (AttachmentSource054_iterationSourceDependentApply s.hom hrp).trans
              (HEq.rfl.trans (AttachmentSource054_iterationIdentityHEq (hp ⟨i, hP⟩) e₄))
          have hright : HEq ((simultaneousSourceFactors O x d g).hom (some i))
              (eqToHom e₃ ≫ eqToHom e₄) := heq_comp rfl hbr ht' hR₀ hS₀
          have hmap : K.map (eqToHom (retainedMarkEq g i hQ)) = eqToHom e₁ :=
            eqToHom_map K (retainedMarkEq g i hQ)
          have href : K.map (eqToHom (retainedMarkEq g i hQ)) ≫ eqToHom e₂ =
              eqToHom e₃ ≫ eqToHom e₄ :=
            (congrArg (· ≫ eqToHom e₂) hmap).trans
              ((eqToHom_trans e₁ e₂).trans (eqToHom_trans e₃ e₄).symm)
          exact hleft.trans ((heq_of_eq href).trans hright.symm)
        · by_cases hQ : SelectedInput Q (g.equiv i)
          · let j : R.index := ⟨g.equiv i, hQ⟩
            have hR : ¬ SelectedInput R j := by
              intro h
              change SelectedInput P (g.equiv.symm (g.equiv i)) at h
              exact hP ((congrArg (SelectedInput P) (g.equiv.symm_apply_apply i)).mp h)
            let V := X (Q.obj (g.equiv i)).2.as
            have ha : a.equiv (some i) = ⟨some j, PUnit.unit⟩ := partialMarked_position_retained O x d g i hQ
            have hn : n.equiv ⟨some j, PUnit.unit⟩ =
                ⟨some ((iterationLeafIso x d R).hom.equiv j), PUnit.unit⟩ :=
              iterationNormalization_position_retained O x d g j
            have hl : (iterationLeafIso x d R).hom.equiv j = Sum.inl ⟨j, hR⟩ :=
              iterationLeaf_position_old x d R j hR
            have hni : n.equiv (a.equiv (some i)) =
                (⟨some (Sum.inl ⟨j, hR⟩), PUnit.unit⟩ : N.index) :=
              (congrArg n.equiv ha).trans
                (hn.trans (congrArg (fun k => (⟨some k, PUnit.unit⟩ : N.index)) hl))
            have hb : B.obj (a.equiv (some i)) = K.obj (R.obj j) := congrArg B.obj ha
            have hd : N.obj (n.equiv (a.equiv (some i))) = V := (congrArg N.obj hni).trans rfl
            have ht : T.obj (c.equiv (n.equiv (a.equiv (some i)))) = V :=
              (congrArg (fun k => T.obj (c.equiv k)) hni).trans rfl
            have ht' : T.obj (s.equiv (r.equiv (some i))) = V :=
              (congrArg (fun e => T.obj (e (some i))) he).symm.trans ht
            let e₁ := congrArg K.obj (retainedMarkEq g i hQ)
            let e₂ : K.obj (R.obj j) = V := markedCarrier_old x (R.obj j).1 hR (R.obj j).2.as
            let e₃ := markedCarrier_old x (P.obj i).1 hP (P.obj i).2.as
            let e₄ : X (P.obj i).2.as = V := congrArg X (Discrete.eq_of_hom (g.hom i).2)
            have hA : HEq (a.hom (some i)) (K.map (eqToHom (retainedMarkEq g i hQ))) :=
              partialMarked_component_retained O x d g i hQ
            have hN : HEq (n.hom (a.equiv (some i))) (eqToHom e₂) :=
              (AttachmentSource054_iterationSourceDependentApply n.hom ha).trans
                ((heq_of_eq (iterationNormalization_component_retained O x d g j)).trans
                  (iterationLeaf_component_old x d R j hR))
            have hC : HEq (c.hom (n.equiv (a.equiv (some i)))) (𝟙 V) :=
              (AttachmentSource054_iterationSourceDependentApply c.hom hni).trans HEq.rfl
            have hNC := heq_comp hb hd ht hN hC
            have hleft : HEq ((iteratedSourceFactors O x d g).hom (some i))
                (K.map (eqToHom (retainedMarkEq g i hQ)) ≫ eqToHom e₂) :=
              (heq_comp rfl hb ht hA hNC).trans
                (heq_of_eq (congrArg (K.map (eqToHom (retainedMarkEq g i hQ)) ≫ ·) (Category.comp_id _)))
            have hrp : r.equiv (some i) = ⟨none, some ⟨i, hP⟩⟩ :=
              markedContraction_position_old O x d P i hP
            have hbr : V₀.obj (r.equiv (some i)) = X (P.obj i).2.as := congrArg V₀.obj hrp
            have hR₀ : HEq (r.hom (some i)) (eqToHom e₃) := markedContraction_component_old O x d P i hP
            have hS₀ : HEq (s.hom (r.equiv (some i))) (eqToHom e₄) :=
              (AttachmentSource054_iterationSourceDependentApply s.hom hrp).trans
                (HEq.rfl.trans (AttachmentSource054_iterationIdentityHEq (hu ⟨i, hP⟩) e₄))
            have hright : HEq ((simultaneousSourceFactors O x d g).hom (some i))
                (eqToHom e₃ ≫ eqToHom e₄) := heq_comp rfl hbr ht' hR₀ hS₀
            have hmap : K.map (eqToHom (retainedMarkEq g i hQ)) = eqToHom e₁ :=
              eqToHom_map K (retainedMarkEq g i hQ)
            have href : K.map (eqToHom (retainedMarkEq g i hQ)) ≫ eqToHom e₂ =
                eqToHom e₃ ≫ eqToHom e₄ :=
              (congrArg (· ≫ eqToHom e₂) hmap).trans
                ((eqToHom_trans e₁ e₂).trans (eqToHom_trans e₃ e₄).symm)
            exact hleft.trans ((heq_of_eq href).trans hright.symm)
          · let j : (iterationRemainingInputs g).index := ⟨g.equiv i, hQ⟩
            let V := X (Q.obj (g.equiv i)).2.as
            have ha : a.equiv (some i) = ⟨none, some j⟩ := partialMarked_position_old O x d g i hQ
            have hni : n.equiv (a.equiv (some i)) = (⟨none, some j⟩ : N.index) :=
              (congrArg n.equiv ha).trans (iterationNormalization_position_remaining O x d g j)
            have hb : B.obj (a.equiv (some i)) = V := congrArg B.obj ha
            have hd : N.obj (n.equiv (a.equiv (some i))) = V := congrArg N.obj hni
            have ht : T.obj (c.equiv (n.equiv (a.equiv (some i)))) = V :=
              (congrArg (fun k => T.obj (c.equiv k)) hni).trans rfl
            have ht' : T.obj (s.equiv (r.equiv (some i))) = V :=
              (congrArg (fun e => T.obj (e (some i))) he).symm.trans ht
            let e₁ : K.obj (P.obj i) = V := partialOldCarrierEq x g i hQ
            let e₃ := markedCarrier_old x (P.obj i).1 hP (P.obj i).2.as
            let e₄ : X (P.obj i).2.as = V := congrArg X (Discrete.eq_of_hom (g.hom i).2)
            have hA : HEq (a.hom (some i)) (eqToHom e₁) := partialMarked_component_old O x d g i hQ
            have hN : HEq (n.hom (a.equiv (some i))) (𝟙 V) :=
              (AttachmentSource054_iterationSourceDependentApply n.hom ha).trans
                (heq_of_eq (iterationNormalization_component_remaining O x d g j))
            have hC : HEq (c.hom (n.equiv (a.equiv (some i)))) (𝟙 V) :=
              (AttachmentSource054_iterationSourceDependentApply c.hom hni).trans HEq.rfl
            have hNC := heq_comp hb hd ht hN hC
            have hleft : HEq ((iteratedSourceFactors O x d g).hom (some i)) (eqToHom e₁) :=
              (heq_comp rfl hb ht hA hNC).trans
                (heq_of_eq ((congrArg (eqToHom e₁ ≫ ·) (Category.id_comp (𝟙 V))).trans (Category.comp_id _)))
            have hrp : r.equiv (some i) = ⟨none, some ⟨i, hP⟩⟩ :=
              markedContraction_position_old O x d P i hP
            have hbr : V₀.obj (r.equiv (some i)) = X (P.obj i).2.as := congrArg V₀.obj hrp
            have hR₀ : HEq (r.hom (some i)) (eqToHom e₃) := markedContraction_component_old O x d P i hP
            have hS₀ : HEq (s.hom (r.equiv (some i))) (eqToHom e₄) :=
              (AttachmentSource054_iterationSourceDependentApply s.hom hrp).trans
                (HEq.rfl.trans (AttachmentSource054_iterationIdentityHEq (hu ⟨i, hP⟩) e₄))
            have hright : HEq ((simultaneousSourceFactors O x d g).hom (some i))
                (eqToHom e₃ ≫ eqToHom e₄) := heq_comp rfl hbr ht' hR₀ hS₀
            exact hleft.trans ((heq_of_eq (eqToHom_trans e₃ e₄).symm).trans hright.symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.EndpointRelations

end
