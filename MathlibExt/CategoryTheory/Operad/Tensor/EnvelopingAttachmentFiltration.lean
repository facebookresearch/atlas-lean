section AttachmentSource094


/-!
## Original profile cofans are independent of their displayed finite enumeration
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource094_inverseSquare {D : Type*} [Category* D] {X X' A A' : D}
    (s : X ≅ A) (s' : X' ≅ A') (r : X ⟶ X') (f : A ⟶ A')
    (h : r ≫ s'.hom = s.hom ≫ f) : f ≫ s'.inv = s.inv ≫ r := by
  apply (cancel_epi s.hom).1
  have hb : (s.hom ≫ f) ≫ s'.inv = r :=
    (congrArg (· ≫ s'.inv) h.symm).trans
      ((Category.assoc r s'.hom s'.inv).trans
        ((congrArg (r ≫ ·) s'.hom_inv_id).trans (Category.comp_id r)))
  exact ((Category.assoc s.hom f s'.inv).symm.trans hb).trans
    (Iso.hom_inv_id_assoc s r).symm

private theorem AttachmentSource094_isoCofanSquare {D : Type*} [Category* D] {X X' A A' Z : D}
    (s : X ≅ A) (s' : X' ≅ A') (r : X ⟶ X') (f : A ⟶ A')
    (j : X ⟶ Z) (j' : X' ⟶ Z)
    (h : r ≫ s'.hom = s.hom ≫ f) (hj : r ≫ j' = j) :
    f ≫ (s'.inv ≫ j') = s.inv ≫ j :=
  (Category.assoc f s'.inv j').symm.trans
    ((congrArg (· ≫ j') (AttachmentSource094_inverseSquare s s' r f h)).trans
      ((Category.assoc s.inv r j').trans (congrArg (s.inv ≫ ·) hj)))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationCofanFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationCofanDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

/-- The original full profile enters its actual degree orbit object through
any displayed enumeration of that same original finite input set. -/
def profileDegreeSummandCofanWith (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {n : ℕ} (P : ColoredProfile W) (e : Fin n ≃ P.inputs) :
    (operationSummandFunctor E.toCollection Xprime).obj P ⟶ degreeBalancedTop E x P.outputColor n :=
  (topOperationTensorIso E x P).inv ≫
    rawEnumeratedCofan (markedTensorDiagram E x P.outputColor) P e

theorem profileDegreeSummandCofanWith_original (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (P : ColoredProfile W) :
    profileDegreeSummandCofanWith E x P (inputEnumeration P) = profileDegreeSummandCofan E x P := rfl

/-- The actual operation cofans commute with every original fixed-output
profile map, using the actual original coefficient/input diagram. -/
theorem profileDegreeSummandCofanWith_fixedOutput (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {d : W} {n : ℕ} {P Q : AnalyticIndex W d} (f : P ⟶ Q)
    (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) :
    (operationSummandFunctor E.toCollection Xprime).map ((analyticToProfileFunctor W d).map f) ≫
      profileDegreeSummandCofanWith E x Q.toColoredProfile e' =
        profileDegreeSummandCofanWith E x P.toColoredProfile e := by
  let f' := (analyticToProfileFunctor W d).map f
  let D := markedTensorDiagram E x d
  let T := FiniteTensor.tensor (V := C)
  let m := D.map (topProfileHom (W := W) (P := P.toColoredProfile) (Q := Q.toColoredProfile) f')
  let j := rawEnumeratedCofan D P.toColoredProfile e
  let j' := rawEnumeratedCofan D Q.toColoredProfile e'
  have hm : T.map (topFactorsMap E.toCollection x f') = m :=
    congrArg T.map (topFactorsMap_fixedOutput E.toCollection x f)
  have hi : m ≫ (topOperationTensorIso E x Q.toColoredProfile).hom =
      (topOperationTensorIso E x P.toColoredProfile).hom ≫
        (operationSummandFunctor E.toCollection Xprime).map f' :=
    (congrArg (· ≫ (topOperationTensorIso E x Q.toColoredProfile).hom) hm.symm).trans
      (topOperationTensorIso_map E x f')
  have hj : m ≫ j' = j := rawEnumeratedCofan_naturality D f' e e'
  exact AttachmentSource094_isoCofanSquare (topOperationTensorIso E x P.toColoredProfile)
    (topOperationTensorIso E x Q.toColoredProfile) m
    ((operationSummandFunctor E.toCollection Xprime).map f') j j' hi hj

/-- Every original full profile morphism and every displayed two enumerations
give the same genuine degree cofan, with the actual original output transport. -/
theorem profileDegreeSummandCofanWith_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {n : ℕ} {P Q : ColoredProfile W} (f : P ⟶ Q)
    (e : Fin n ≃ P.inputs) (e' : Fin n ≃ Q.inputs) :
    (operationSummandFunctor E.toCollection Xprime).map f ≫ profileDegreeSummandCofanWith E x Q e' =
      profileDegreeSummandCofanWith E x P e ≫
        eqToHom (congrArg (fun d => degreeBalancedTop E x d n) f.outputColor_eq) := by
  rcases P with ⟨I, c, d⟩
  rcases Q with ⟨J, c', d'⟩
  rcases f with ⟨q, hq, hd⟩
  cases hd
  let P : AnalyticIndex W d := ⟨I, c⟩
  let Q : AnalyticIndex W d := ⟨J, c'⟩
  let f : P ⟶ Q := ⟨q, hq, rfl⟩
  have he := profileDegreeSummandCofanWith_fixedOutput E x f e e'
  exact he.trans (Category.comp_id _).symm


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource094


section AttachmentSource095


/-!
## Constructed finite-degree carriers with every original proper-face relation
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource095_triplePost {D : Type*} [Category* D] {A B C E Z : D}
    (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (q : E ⟶ Z) :
    (f ≫ g ≫ h) ≫ q = f ≫ g ≫ h ≫ q :=
  (Category.assoc f (g ≫ h) q).trans (congrArg (f ≫ ·) (Category.assoc g h q))

variable {W : Type uc}

/-- An actual finite marked input word at or below the stage bound,
with at least one original X input. -/
structure BoundedFace (W : Type uc) (N : ℕ) where
  /-- The input degree of the marked face. -/
  degree : ℕ
  /-- The marked input word of the face at its recorded degree. -/
  word : DegreeMarkedInputs W degree
  bound : degree ≤ N
  proper : IsPuncturedMarked word

/-- The actual punctured representative, retaining all original marks and colors. -/
def BoundedFace.punctured {N : ℕ} (c : BoundedFace W N) :
    PuncturedMarkedInputs W c.degree := ⟨c.word, c.proper⟩

/-- The same original face occurs at every later degree bound. -/
def BoundedFace.enlarge {N M : ℕ} (h : N ≤ M) (c : BoundedFace W N) : BoundedFace W M :=
  ⟨c.degree, c.word, c.bound.trans h, c.proper⟩

instance boundedFaceZeroEmpty : IsEmpty (BoundedFace W 0) where
  false c := by
    rcases c with ⟨n, P, hn, hP⟩
    have he : n = 0 := Nat.eq_zero_of_le_zero hn
    subst n
    obtain ⟨i, _⟩ := hP
    exact Fin.elim0 i

instance boundedFaceSmall [Small.{us} W] (N : ℕ) : Small.{us} (BoundedFace W N) := by
  let m : BoundedFace W N → (Σ n : ℕ, DegreeMarkedInputs W n) := fun c => ⟨c.degree, c.word⟩
  apply small_of_injective.{us} (f := m)
  intro c c' h
  rcases c with ⟨n, P, hn, hP⟩
  rcases c' with ⟨n', P', hn', hP'⟩
  cases h
  rfl

/-- A genuine proper face contracts into its strictly earlier survivor degree. -/
theorem BoundedFace.survivor_lt {N : ℕ} (c : BoundedFace W N) (d : W) :
    inputCount (survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)) <
      c.degree :=
  survivingProfile_punctured_degree_lt c.punctured d

section Stages

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationStageFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationStageTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationStageProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationStageDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance continuationStageFacesColimits (N : ℕ) :
    HasColimitsOfShape (Discrete (BoundedFace W N)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance continuationStageFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- The actual coproduct of the original degree tensor orbit objects through N. -/
abbrev stageProfiles (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (N : ℕ) : C :=
  ∐ fun i : Fin (N + 1) => degreeBalancedTop E x d i.val

/-- The actual original degree cofan in the bounded coproduct. -/
def stageDegreeι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (N j : ℕ) (h : j ≤ N) :
    degreeBalancedTop E x d j ⟶ stageProfiles E x d N :=
  Limits.Sigma.ι (fun i : Fin (N + 1) => degreeBalancedTop E x d i.val) ⟨j, Nat.lt_succ_of_le h⟩

/-- The unchanged original tensor source of each bounded marked proper face. -/
def boundedFaceSource (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) {N : ℕ} (c : BoundedFace W N) : C :=
  (degreeMarkedTensorDiagram E x d c.degree).obj c.word

/-- The actual coproduct of all original proper-face tensor sources. -/
abbrev stageFaces (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (N : ℕ) : C :=
  ∐ fun c : BoundedFace W N => boundedFaceSource E x d c

/-- Every original contraction enters the genuine strictly earlier
survivor-degree orbit cofan; no contraction equation is supplied as data. -/
def stageRelationLeft (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    stageFaces E x d N ⟶ stageProfiles E x d N :=
  Limits.Sigma.desc (fun c : BoundedFace W N =>
    normalizedMarkedFaceContraction E x a d ((degreeMarkedInclusion (W := W) c.degree).obj c.word) ≫
      profileDegreeSummandCofan E x
        (survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)) ≫
      stageDegreeι E x d N
        (inputCount (survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)))
        ((c.survivor_lt d).le.trans c.bound))

/-- Every original proper face enters the same original top degree
through its actual x coordinate maps and original degree cofan. -/
def stageRelationRight (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (N : ℕ) : stageFaces E x d N ⟶ stageProfiles E x d N :=
  Limits.Sigma.desc (fun c : BoundedFace W N =>
    (degreeToTop E x d c.degree).app c.word ≫
      colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word ≫
      stageDegreeι E x d N c.degree c.bound)

/-- The constructed bounded-degree carrier imposes precisely the actual
original contraction versus x-face relations at those original profiles. -/
abbrev stage (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) : C :=
  coequalizer (stageRelationLeft E x a d N) (stageRelationRight E x d N)

/-- The original degree cofan in the constructed stage. -/
def stageDegreeLeg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (N j : ℕ) (h : j ≤ N) : degreeBalancedTop E x d j ⟶ stage E x a d N :=
  stageDegreeι E x d N j h ≫ coequalizer.π (stageRelationLeft E x a d N) (stageRelationRight E x d N)

/-- The actual original full operation-profile cofan at its bounded stage. -/
def stageProfileLeg (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E)
    (N : ℕ) (P : ColoredProfile W) (h : inputCount P ≤ N) :
    (operationSummandFunctor E.toCollection Xprime).obj P ⟶ stage E x a P.outputColor N :=
  profileDegreeSummandCofan E x P ≫ stageDegreeLeg E x a P.outputColor N (inputCount P) h

/-- Every original proper face has its actual original contraction/top equation
in the constructed stage; this is derived from the genuine coequalizer. -/
theorem stage_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (c : BoundedFace W N) :
    normalizedMarkedFaceContraction E x a d ((degreeMarkedInclusion (W := W) c.degree).obj c.word) ≫
        stageProfileLeg E x a N
          (survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word))
          ((c.survivor_lt d).le.trans c.bound) =
      (degreeToTop E x d c.degree).app c.word ≫
        colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word ≫
          stageDegreeLeg E x a d N c.degree c.bound := by
  let L := stageRelationLeft E x a d N
  let R := stageRelationRight E x d N
  let q := coequalizer.π L R
  let j := Limits.Sigma.ι (fun c : BoundedFace W N => boundedFaceSource E x d c) c
  let P := survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)
  let f := normalizedMarkedFaceContraction E x a d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)
  let k := profileDegreeSummandCofan E x P
  let l := stageDegreeι E x d N (inputCount P) ((c.survivor_lt d).le.trans c.bound)
  let t := (degreeToTop E x d c.degree).app c.word
  let i := colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word
  let l' := stageDegreeι E x d N c.degree c.bound
  have hL : j ≫ L = f ≫ k ≫ l := Limits.Sigma.ι_comp_desc _ _
  have hR : j ≫ R = t ≫ i ≫ l' := Limits.Sigma.ι_comp_desc _ _
  have h := congrArg (j ≫ ·) (coequalizer.condition L R)
  have he : (f ≫ k ≫ l) ≫ q = (t ≫ i ≫ l') ≫ q :=
    (congrArg (· ≫ q) hL.symm).trans
      ((Category.assoc j L q).trans
        (h.trans ((Category.assoc j R q).symm.trans (congrArg (· ≫ q) hR))))
  change f ≫ k ≫ l ≫ q = t ≫ i ≫ l' ≫ q
  exact (AttachmentSource095_triplePost f k l q).symm.trans (he.trans (AttachmentSource095_triplePost t i l' q))


end Stages

end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource095


section AttachmentSource096


/-!
## The original degree-stage maps, zero stage and actual countable colimit
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource096_triplePost {D : Type*} [Category* D] {A B C E Z : D}
    (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (q : E ⟶ Z) :
    (f ≫ g ≫ h) ≫ q = f ≫ g ≫ h ≫ q :=
  (Category.assoc f (g ≫ h) q).trans (congrArg (f ≫ ·) (Category.assoc g h q))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationStageMapsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationStageMapsTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationStageMapsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationStageMapsDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _
local instance continuationStageMapsFacesColimits (N : ℕ) :
    HasColimitsOfShape (Discrete (BoundedFace W N)) C := HasColimitsOfShape.of_essentiallySmall C _
local instance continuationStageMapsFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J

/-- No original proper face occurs at degree zero. -/
theorem stage_zero_relations (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    stageRelationLeft E x a d 0 = stageRelationRight E x d 0 := by
  apply Limits.Sigma.hom_ext
  intro c
  exact isEmptyElim c

/-- The constructed degree-zero stage is the genuine original initial
algebra carrier through the original zero-degree and nullary comparisons. -/
def stageZeroIso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    stage E x a d 0 ≅ (initialAlgebra E).carrier d := by
  let q := coequalizer.π (stageRelationLeft E x a d 0) (stageRelationRight E x d 0)
  let : IsIso q := coequalizer.π_of_eq (stage_zero_relations E x a d)
  exact (asIso q).symm ≪≫
    coproductUniqueIso (fun i : Fin 1 => degreeBalancedTop E x d i.val) ≪≫
      zeroBalancedInitialIso E x d

/-- The original degree cofans jointly determine maps out of each actual stage. -/
theorem stage_hom_ext (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    {Z : C} {g h : stage E x a d N ⟶ Z}
    (H : ∀ j (hj : j ≤ N), stageDegreeLeg E x a d N j hj ≫ g =
      stageDegreeLeg E x a d N j hj ≫ h) : g = h := by
  apply coequalizer.hom_ext
  apply Limits.Sigma.hom_ext
  intro i
  simpa only [stageDegreeLeg, stageDegreeι, Category.assoc] using! H i.val (Nat.le_of_lt_succ i.isLt)

/-- Every original bounded degree cofan enters its same original degree at a later stage. -/
def toLargerProfiles (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) : stageProfiles E x d N ⟶ stage E x a d M :=
  Limits.Sigma.desc (fun i : Fin (N + 1) =>
    stageDegreeLeg E x a d M i.val ((Nat.le_of_lt_succ i.isLt).trans h))

@[reassoc (attr := simp)]
theorem stageDegreeι_toLargerProfiles (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) (j : ℕ) (hj : j ≤ N) :
    stageDegreeι E x d N j hj ≫ toLargerProfiles E x a d h =
      stageDegreeLeg E x a d M j (hj.trans h) :=
  Limits.Sigma.ι_comp_desc _ _

/-- Every original contraction and top-face relation persists at every later stage. -/
theorem toLargerProfiles_relations (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) :
    stageRelationLeft E x a d N ≫ toLargerProfiles E x a d h =
      stageRelationRight E x d N ≫ toLargerProfiles E x a d h := by
  apply Limits.Sigma.hom_ext
  intro c
  let P := survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)
  let f := normalizedMarkedFaceContraction E x a d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)
  let k := profileDegreeSummandCofan E x P
  let t := (degreeToTop E x d c.degree).app c.word
  let i := colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word
  let l := stageDegreeι E x d N (inputCount P) ((c.survivor_lt d).le.trans c.bound)
  let l' := stageDegreeι E x d N c.degree c.bound
  let lM := stageDegreeLeg E x a d M (inputCount P) (((c.survivor_lt d).le.trans c.bound).trans h)
  let lM' := stageDegreeLeg E x a d M c.degree (c.bound.trans h)
  let j := Limits.Sigma.ι (fun c : BoundedFace W N => boundedFaceSource E x d c) c
  let L := stageRelationLeft E x a d N
  let R := stageRelationRight E x d N
  let q := toLargerProfiles E x a d h
  have hL : j ≫ L = f ≫ k ≫ l := Limits.Sigma.ι_comp_desc _ _
  have hR : j ≫ R = t ≫ i ≫ l' := Limits.Sigma.ι_comp_desc _ _
  have hl : l ≫ q = lM := stageDegreeι_toLargerProfiles E x a d h _ _
  have hl' : l' ≫ q = lM' := stageDegreeι_toLargerProfiles E x a d h _ _
  have hface := stage_face E x a d M (c.enlarge h)
  change f ≫ k ≫ lM = t ≫ i ≫ lM' at hface
  have hleft : (f ≫ k ≫ l) ≫ q = f ≫ k ≫ lM :=
    (AttachmentSource096_triplePost f k l q).trans (congrArg (f ≫ k ≫ ·) hl)
  have hright : (t ≫ i ≫ l') ≫ q = t ≫ i ≫ lM' :=
    (AttachmentSource096_triplePost t i l' q).trans (congrArg (t ≫ i ≫ ·) hl')
  exact (Category.assoc j L q).symm.trans
    ((congrArg (· ≫ q) hL).trans
      (hleft.trans (hface.trans (hright.symm.trans
        ((congrArg (· ≫ q) hR.symm).trans (Category.assoc j R q))))))

/-- The actual map between constructed stages is descended from the unchanged original cofans. -/
def stageMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) : stage E x a d N ⟶ stage E x a d M :=
  coequalizer.desc (toLargerProfiles E x a d h) (toLargerProfiles_relations E x a d h)

@[reassoc (attr := simp)]
theorem stageDegreeLeg_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) (j : ℕ) (hj : j ≤ N) :
    stageDegreeLeg E x a d N j hj ≫ stageMap E x a d h =
      stageDegreeLeg E x a d M j (hj.trans h) := by
  dsimp only [stageDegreeLeg, stageMap]
  rw [Category.assoc, coequalizer.π_desc, stageDegreeι_toLargerProfiles]
  rfl

@[reassoc (attr := simp)]
theorem stageProfileLeg_map (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E)
    {N M : ℕ} (h : N ≤ M) (P : ColoredProfile W) (hP : inputCount P ≤ N) :
    stageProfileLeg E x a N P hP ≫ stageMap E x a P.outputColor h =
      stageProfileLeg E x a M P (hP.trans h) := by
  dsimp only [stageProfileLeg]
  rw [Category.assoc, stageDegreeLeg_map]

@[simp]
theorem stageMap_id (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    stageMap E x a d (Nat.le_refl N) = 𝟙 (stage E x a d N) := by
  apply stage_hom_ext E x a d N
  intro j hj
  rw [stageDegreeLeg_map, Category.comp_id]

theorem stageMap_comp (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M K : ℕ} (h : N ≤ M) (h' : M ≤ K) :
    stageMap E x a d h ≫ stageMap E x a d h' = stageMap E x a d (h.trans h') := by
  apply stage_hom_ext E x a d N
  intro j hj
  rw [← Category.assoc, stageDegreeLeg_map, stageDegreeLeg_map, stageDegreeLeg_map]

/-- The genuine original countable diagram of the constructed bounded-degree stages. -/
def stageDiagram (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) : ℕ ⥤ C where
  obj N := stage E x a d N
  map h := stageMap E x a d (leOfHom h)
  map_id N := stageMap_id E x a d N
  map_comp h h' := (stageMap_comp E x a d (leOfHom h) (leOfHom h')).symm

/-- The actual original countable colimit of these constructed carriers. -/
abbrev stageEndpoint (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) : C :=
  colimit (stageDiagram E x a d)

/-- Include a stage into the colimit of the stage diagram. -/
def stageι (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    stage E x a d N ⟶ stageEndpoint E x a d := colimit.ι (stageDiagram E x a d) N

@[reassoc (attr := simp)]
theorem stageι_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {N M : ℕ} (h : N ≤ M) : stageMap E x a d h ≫ stageι E x a d M = stageι E x a d N :=
  colimit.w (stageDiagram E x a d) (homOfLE h)

/-- The original initial algebra carrier enters the constructed countable endpoint. -/
def stageRootMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) :
    (initialAlgebra E).carrier d ⟶ stageEndpoint E x a d :=
  (stageZeroIso E x a d).inv ≫ stageι E x a d 0


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource096


section AttachmentSource097


/-!
## Original full profile permutations and the actual constructed stage cofans
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

theorem enumerationDegree_eq {n m : ℕ} {P : ColoredProfile W}
    (e : Fin n ≃ P.inputs) (e' : Fin m ≃ P.inputs) : n = m := by
  simpa only [Fintype.card_fin] using Fintype.card_congr (e.trans e'.symm)

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationStageProfileFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationStageProfileTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationStageProfileProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationStageProfileDegreeColimits (n : ℕ) :
    HasColimitsOfShape (DegreeMarkedInputs W n) C := HasColimitsOfShape.of_essentiallySmall C _

omit [MonoidalClosed C] in
/-- Changing a displayed input enumeration keeps the exact same original
operation profile cofan in its actual degree orbit object. -/
theorem profileDegreeSummandCofanWith_eq (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) {n : ℕ} (P : ColoredProfile W) (e e' : Fin n ≃ P.inputs) :
    profileDegreeSummandCofanWith E x P e = profileDegreeSummandCofanWith E x P e' := by
  let j := profileDegreeSummandCofanWith E x P e
  let j' := profileDegreeSummandCofanWith E x P e'
  let m := (operationSummandFunctor E.toCollection Xprime).map (𝟙 P)
  have hm : m = 𝟙 _ := (operationSummandFunctor E.toCollection Xprime).map_id P
  have h : m ≫ j' = j ≫ 𝟙 _ := profileDegreeSummandCofanWith_naturality E x (𝟙 P) e e'
  exact ((Category.id_comp j').symm.trans
    ((congrArg (· ≫ j') hm.symm).trans (h.trans (Category.comp_id j)))).symm

/-- The actual stage cofan is independent of the displayed enumeration,
including different displayed Fin cardinalities of the same original profile. -/
theorem stageWithEnumeration_eq (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ) (P : ColoredProfile W)
    {n m : ℕ} (e : Fin n ≃ P.inputs) (e' : Fin m ≃ P.inputs) (hn : n ≤ N) (hm : m ≤ N) :
    profileDegreeSummandCofanWith E x P e ≫ stageDegreeLeg E x a P.outputColor N n hn =
      profileDegreeSummandCofanWith E x P e' ≫ stageDegreeLeg E x a P.outputColor N m hm := by
  have hnm : n = m := enumerationDegree_eq e e'
  subst m
  exact congrArg (· ≫ stageDegreeLeg E x a P.outputColor N n hn) (profileDegreeSummandCofanWith_eq E x P e e')

/-- The stage cofan through any displayed enumeration is literally the
unchanged original profile/degree cofan in the constructed stage. -/
theorem stageProfileLeg_withEnumeration (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ) (P : ColoredProfile W)
    {n : ℕ} (e : Fin n ≃ P.inputs) (hn : n ≤ N) (hP : inputCount P ≤ N) :
    profileDegreeSummandCofanWith E x P e ≫ stageDegreeLeg E x a P.outputColor N n hn =
      stageProfileLeg E x a N P hP :=
  (stageWithEnumeration_eq E x a N P e (inputEnumeration P) hn hP).trans
    (congrArg (· ≫ stageDegreeLeg E x a P.outputColor N (inputCount P) hP)
      (profileDegreeSummandCofanWith_original E x P))

/-- Every original coefficient/input profile morphism preserves the actual
constructed stage cofan, with its exact original output-color transport. -/
theorem stageProfileLeg_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (N : ℕ)
    {P Q : ColoredProfile W} (f : P ⟶ Q) (hP : inputCount P ≤ N) (hQ : inputCount Q ≤ N) :
    (operationSummandFunctor E.toCollection Xprime).map f ≫ stageProfileLeg E x a N Q hQ =
      stageProfileLeg E x a N P hP ≫
        eqToHom (congrArg (fun d => stage E x a d N) f.outputColor_eq) := by
  rcases P with ⟨I, c, d⟩
  rcases Q with ⟨J, c', d'⟩
  rcases f with ⟨q, hq, hd⟩
  cases hd
  let P : ColoredProfile W := ⟨I, c, d⟩
  let Q : ColoredProfile W := ⟨J, c', d⟩
  let f : P ⟶ Q := ⟨q, hq, rfl⟩
  let e := inputEnumeration P
  let e' := e.trans f.inputEquiv
  let l := stageDegreeLeg E x a d N (inputCount P) hP
  let j := profileDegreeSummandCofanWith E x P e
  let j' := profileDegreeSummandCofanWith E x Q e'
  let m := (operationSummandFunctor E.toCollection Xprime).map f
  have h : m ≫ j' = j :=
    (profileDegreeSummandCofanWith_naturality E x f e e').trans (Category.comp_id j)
  have hPLeg : j ≫ l = stageProfileLeg E x a N P hP :=
    stageProfileLeg_withEnumeration E x a N P e hP hP
  have hQLeg : j' ≫ l = stageProfileLeg E x a N Q hQ :=
    stageProfileLeg_withEnumeration E x a N Q e' hP hQ
  change m ≫ stageProfileLeg E x a N Q hQ = stageProfileLeg E x a N P hP ≫ 𝟙 _
  exact (congrArg (m ≫ ·) hQLeg.symm).trans
    ((Category.assoc m j' l).symm.trans
      ((congrArg (· ≫ l) h).trans (hPLeg.trans (Category.comp_id _).symm)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource097


section AttachmentSource098


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource098_threeCollapse {D : Type*} [Category* D] {A A' B B' C C' Z : D}
    (z : A ⟶ A') (m : A ⟶ B) (n : A' ⟶ B') (f : B ⟶ B')
    (p : B ⟶ C) (p' : B' ⟶ C') (r : C ⟶ C') (l : C ⟶ Z) (l' : C' ⟶ Z)
    (hm : z ≫ n = m ≫ f) (hp : f ≫ p' = p ≫ r) (hl : r ≫ l' = l) :
    z ≫ (n ≫ p' ≫ l') = m ≫ p ≫ l := by
  calc
    z ≫ (n ≫ p' ≫ l') = (z ≫ n) ≫ p' ≫ l' := (Category.assoc _ _ _).symm
    _ = (m ≫ f) ≫ p' ≫ l' := congrArg (· ≫ p' ≫ l') hm
    _ = m ≫ (f ≫ p') ≫ l' := by simp only [Category.assoc]
    _ = m ≫ (p ≫ r) ≫ l' := congrArg (fun f => m ≫ f ≫ l') hp
    _ = m ≫ p ≫ (r ≫ l') := by simp only [Category.assoc]
    _ = m ≫ p ≫ l := congrArg (m ≫ p ≫ ·) hl

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationTopStageFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationTopStageSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationTopStageProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original marked profile enters the stage through its actual original
coordinate-to-top map and unchanged original full operation cofan. -/
def markedTopStageCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (P : MarkedInputs W) (hP : inputCount ((markedProfileFunctor d).obj P) ≤ N) :
    (markedTensorDiagram E x d).obj P ⟶ stage E x a d N :=
  (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P) ≫
    (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
      stageProfileLeg E x a N ((markedProfileFunctor d).obj P) hP

/-- Every original input permutation and coordinate face map preserves the
actual marked top stage cofan. This follows from the original diagram/profile
maps and the genuine constructed stage cofans. -/
theorem markedTopStageCofan_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    {P Q : MarkedInputs W} (g : P ⟶ Q)
    (hP : inputCount ((markedProfileFunctor d).obj P) ≤ N)
    (hQ : inputCount ((markedProfileFunctor d).obj Q) ≤ N) :
    (markedTensorDiagram E x d).map g ≫ markedTopStageCofan E x a d N Q hQ =
      markedTopStageCofan E x a d N P hP := by
  let D := markedTensorDiagram E x d
  let z := D.map g
  let m := D.map ((toAllTopInputs (W := W)).app P)
  let n := D.map ((toAllTopInputs (W := W)).app Q)
  let f := D.map ((allTopInputs (W := W)).map g)
  let p := (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom
  let p' := (topOperationTensorIso E x ((markedProfileFunctor d).obj Q)).hom
  let r := (operationSummandFunctor E.toCollection Xprime).map ((markedProfileFunctor d).map g)
  let l := stageProfileLeg E x a N ((markedProfileFunctor d).obj P) hP
  let l' := stageProfileLeg E x a N ((markedProfileFunctor d).obj Q) hQ
  have hm : z ≫ n = m ≫ f := (D.map_comp _ _).symm.trans
    ((congrArg D.map ((toAllTopInputs (W := W)).naturality g)).trans (D.map_comp _ _))
  have hp : f ≫ p' = p ≫ r := topOperationTensorIso_marked E x d g
  have hl : r ≫ l' = l := (stageProfileLeg_naturality E x a N ((markedProfileFunctor d).map g) hP hQ).trans
    (Category.comp_id l)
  exact AttachmentSource098_threeCollapse z m n f p p' r l l' hm hp hl


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource098


section AttachmentSource099


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

theorem degreeProfile_count (d : W) (n : ℕ) (P : DegreeMarkedInputs W n) :
    inputCount ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P)) = n := by
  let Q := (markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P)
  have h := @Fintype.card_congr Q.inputs (Fin n) (inferInstanceAs (Fintype Q.inputs)) (Fin.fintype n) (Equiv.refl (Fin
    n))
  exact h.trans (Fintype.card_fin n)

variable {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationCanonicalCofanFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationCanonicalCofanSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationCanonicalCofanProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationCanonicalCofanDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The original full operation cofan of a degree word is exactly its
original degree top colimit injection, through the actual top tensor comparison. -/
theorem canonicalProfileStageCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N n : ℕ)
    (P : DegreeMarkedInputs W n) (hN : n ≤ N) :
    (topOperationTensorIso E x ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P))).hom ≫
      stageProfileLeg E x a N ((markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P))
        ((degreeProfile_count d n P).symm ▸ hN) =
    colimit.ι (degreeTopTensorDiagram E x d n) P ≫ stageDegreeLeg E x a d N n hN := by
  let F := (markedProfileFunctor d).obj ((degreeMarkedInclusion (W := W) n).obj P)
  let e : Fin n ≃ F.inputs := Equiv.refl (Fin n)
  let D := markedTensorDiagram E x d
  let V := degreeTopTensorDiagram E x d n
  let p := topOperationTensorIso E x F
  let j := profileDegreeSummandCofanWith E x F e
  let l := stageDegreeLeg E x a d N n hN
  have henum : (topEnumerationIsoWith F e).hom = 𝟙 (topMarkedProfile F) := markedHom_ext rfl
  have hmap : D.map (topEnumerationIsoWith F e).hom = 𝟙 (D.obj (topMarkedProfile F)) :=
    (congrArg D.map henum).trans (D.map_id _)
  have hj : p.hom ≫ j = colimit.ι V (topWordWith F e) := by
    let q := colimit.ι V (topWordWith F e)
    change p.hom ≫ (p.inv ≫ D.map (topEnumerationIsoWith F e).hom ≫ q) = q
    exact (Iso.hom_inv_id_assoc p _).trans
      ((congrArg (· ≫ q) hmap).trans (Category.id_comp q))
  have hreset : colimit.ι V (topWordWith F e) = colimit.ι V P := degreeTopCofan_reset E x d n P
  have hleg : j ≫ l = stageProfileLeg E x a N F ((degreeProfile_count d n P).symm ▸ hN) :=
    stageProfileLeg_withEnumeration E x a N F e hN _
  exact (congrArg (p.hom ≫ ·) hleg.symm).trans
    ((Category.assoc p.hom j l).symm.trans
      ((congrArg (· ≫ l) hj).trans (congrArg (· ≫ l) hreset)))

/-- The original canonical marked top stage cofan retains the same original
degree-to-top map and degree colimit/cofan used in the boundary cell arrow. -/
theorem canonicalMarkedTopStageCofan (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N n : ℕ)
    (P : DegreeMarkedInputs W n) (hN : n ≤ N) :
    markedTopStageCofan E x a d N ((degreeMarkedInclusion (W := W) n).obj P)
      ((degreeProfile_count d n P).symm ▸ hN) =
      (degreeToTop E x d n).app P ≫ colimit.ι (degreeTopTensorDiagram E x d n) P ≫ stageDegreeLeg E x a d N n hN :=
  congrArg ((degreeToTop E x d n).app P ≫ ·) (canonicalProfileStageCofan E x a d N n P hN)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource099


section AttachmentSource100


/-!
## Exact original empty-input coefficient maps
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc}

instance emptyColoredInputsIndexEmpty : IsEmpty (emptyColoredInputs (W := W)).index :=
  inferInstanceAs (IsEmpty Empty)

/-- Identify any colored input family with empty index type with the empty family. -/
def emptyInputsIso (Q : ColoredInputs W) [IsEmpty Q.index] : Q ≅ emptyColoredInputs :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => isEmptyElim i
      invFun := fun i => i.elim
      left_inv := fun i => isEmptyElim i
      right_inv := fun i => i.elim }
    (fun i => isEmptyElim i)

/-- The original empty-sum input deletion retains every original variable position. -/
def emptyInputProfileHom (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] :
    extendProfile P Q ⟶ P where
  inputEquiv := Equiv.sumEmpty P.inputs Q.index
  inputColor_eq i := by
    cases i with
    | inl _ => rfl
    | inr i => exact isEmptyElim i
  outputColor_eq := rfl

theorem emptyInputProfileHom_empty (P : ColoredProfile W) :
    emptyInputProfileHom P emptyColoredInputs = emptyExtensionProfileHom P := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl _ => rfl
  | inr i => exact i.elim

theorem emptyInputProfileHom_factor (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] :
    extendProfileMap (𝟙 P) (emptyInputsIso Q).hom ≫ emptyInputProfileHom P emptyColoredInputs =
      emptyInputProfileHom P Q := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl _ => rfl
  | inr i => exact isEmptyElim i

variable {C : Type u} [Category.{v} C]

/-- The original no-added-input family has its original root coefficient map
and actual singleton coefficient index comparison. -/
def emptyContractionCoefficientMap (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] :
    constantInputFamily O X P Q ⟶ (FiniteFamily.singleton (C := C)).obj (O.obj P) where
  equiv :=
    { toFun := fun _ => PUnit.unit
      invFun := fun _ => none
      left_inv := fun i => by
        cases i with
        | none => rfl
        | some i => exact isEmptyElim (show Q.index from i)
      right_inv := fun i => by cases i; rfl }
  hom i := match i with
    | none => O.map (emptyInputProfileHom P Q)
    | some i => isEmptyElim (show Q.index from i)

theorem emptyContractionCoefficientMap_factor (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] :
    contractionInputMap O X (𝟙 P) (emptyInputsIso Q).hom ≫
      emptyContractionCoefficientMap O X P emptyColoredInputs =
        emptyContractionCoefficientMap O X P Q := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i => exact isEmptyElim (show Q.index from i)
  · intro i
    cases i with
    | none => exact heq_of_eq ((O.map_comp _ _).symm.trans
        (congrArg O.map (emptyInputProfileHom_factor P Q)))
    | some i => exact isEmptyElim (show Q.index from i)

theorem emptyContractionCoefficientMap_original (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) :
    emptyContractionCoefficientMap O X P emptyColoredInputs =
      (emptyLinearFactorsIso O X P).hom ≫
        (emptyLeafFamilyIso (O.obj (extendProfile P emptyColoredInputs))).hom ≫
          (FiniteFamily.singleton (C := C)).map (O.map (emptyExtensionProfileHom P)) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i => exact i.elim
  · intro i
    cases i with
    | none =>
        let f := O.map (emptyExtensionProfileHom P)
        change HEq (O.map (emptyInputProfileHom P emptyColoredInputs)) (𝟙 _ ≫ 𝟙 _ ≫ f)
        exact heq_of_eq ((congrArg O.map (emptyInputProfileHom_empty P)).trans
          ((Category.id_comp (𝟙 _ ≫ f)).trans (Category.id_comp f)).symm)
    | some i => exact i.elim


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource100


section AttachmentSource101


set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc}

theorem allTopContractedEmpty (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i) :
    IsEmpty (contractedInputs P).index := ⟨fun i => i.2 (hP i.1)⟩

/-- The original full all-top profile maps to its actual original survivor
subtype by the identity on every original input position and color. -/
def allTopSurvivorHom (d : W) (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i) :
    (markedProfileFunctor d).obj P ⟶ survivingProfile d P where
  inputEquiv :=
    { toFun := fun i => ⟨i, hP i⟩
      invFun := fun i => i.1
      left_inv := fun _ => rfl
      right_inv := fun _ => Subtype.ext rfl }
  inputColor_eq _ := rfl
  outputColor_eq := rfl

/-- The original root selection and actual empty-input deletion keep exactly
the original full all-top operation profile. -/
theorem allTopRootProfile (d : W) (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i)
    [IsEmpty (contractedInputs P).index] :
    (asIso (C := ColoredProfile W) (selectionRootHom d P)).inv ≫
        emptyInputProfileHom (survivingProfile d P) (contractedInputs P) = allTopSurvivorHom d P hP := by
  let s := asIso (C := ColoredProfile W) (selectionRootHom d P)
  let f := allTopSurvivorHom d P hP
  let e := emptyInputProfileHom (survivingProfile d P) (contractedInputs P)
  have h : s.hom ≫ f = e := by
    apply ColoredProfile.Hom.ext
    apply Equiv.ext
    intro i
    cases i with
    | inl i => cases i; rfl
    | inr i => exact isEmptyElim i
  apply (cancel_epi s.hom).1
  exact (Iso.hom_inv_id_assoc s e).trans h.symm


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource101


section AttachmentSource102


/-!
## Original contraction at every actual empty added-input family
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource102_mapThree {D E : Type*} [Category* D] [Category* E] (T : D ⥤ E)
    {A B C F : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ F) :
    T.map (a ≫ b ≫ c) = T.map a ≫ T.map b ≫ T.map c := by
  simp only [Functor.map_comp]

private theorem AttachmentSource102_collapseRoute {D : Type*} [Category* D] {A B C X Y Z : D}
    (a : A ⟶ B) (b : B ⟶ C) (s : C ⟶ X) (f : X ⟶ Y)
    (c : C ⟶ Z) (t : Z ⟶ Y) (h : s ≫ f = c ≫ t) :
    a ≫ (b ≫ s) ≫ f = (a ≫ b ≫ c) ≫ t := by
  simp only [Category.assoc]
  exact congrArg (a ≫ b ≫ ·) h

variable {W : Type uc} {C : Type u} [Category.{v} C]

section Tensor

variable [FiniteTensor C]

/-- The original empty linear summand comparison is exactly tensoring its
original empty-input root map and the original singleton coefficient unitor. -/
theorem emptyLinearSummandIso_emptyMap (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) :
    (emptyLinearSummandIso O X P).hom =
      (FiniteTensor.tensor (V := C)).map (emptyContractionCoefficientMap O X P emptyColoredInputs) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (O.obj P) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (emptyLinearFactorsIso O X P).hom
  let b := (emptyLeafFamilyIso (O.obj (extendProfile P emptyColoredInputs))).hom
  let f := O.map (emptyExtensionProfileHom P)
  let c := (FiniteFamily.singleton (C := C)).map f
  let s := (FiniteTensor.singletonIso (V := C)).hom.app (O.obj (extendProfile P emptyColoredInputs))
  let t := (FiniteTensor.singletonIso (V := C)).hom.app (O.obj P)
  let k := emptyContractionCoefficientMap O X P emptyColoredInputs
  have hn : s ≫ f = T.map c ≫ t := ((FiniteTensor.singletonIso (V := C)).hom.naturality f).symm
  have hm : T.map a ≫ T.map b ≫ T.map c = T.map k :=
    (AttachmentSource102_mapThree T a b c).symm.trans
      (congrArg T.map (emptyContractionCoefficientMap_original O X P).symm)
  have he : T.map a ≫ (T.map b ≫ s) ≫ f = T.map k ≫ t :=
    (AttachmentSource102_collapseRoute (T.map a) (T.map b) s f (T.map c) t hn).trans (congrArg (· ≫ t) hm)
  change T.map a ≫ (T.map b ≫ s) ≫ f = T.map k ≫ t
  exact he

end Tensor

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationEmptyFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationEmptyTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationEmptyProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The unchanged original contraction at the literal empty family is the
actual original empty summand comparison, by E's original unit law. -/
theorem deletedCoefficientContraction_empty_literal (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W) :
    deletedCoefficientContraction E a P emptyColoredInputs =
      (emptyLinearSummandIso E.toCollection X P).hom := by
  let e := emptyLinearSummandIso E.toCollection X P
  have h : e.inv ≫ deletedCoefficientContraction E a P emptyColoredInputs = 𝟙 (E.toCollection.obj P) :=
    (congrArg (e.inv ≫ ·) (deletedCoefficientContraction_representative E a P emptyColoredInputs)).trans
      (Linear.Constants.representative_empty (𝟙 E) X (attachingNullaryValue E a) P)
  apply (cancel_epi e.inv).1
  exact h.trans e.inv_hom_id.symm

/-- Every actual empty contracted-input family evaluates by the original
empty profile deletion and actual singleton coefficient unitor. -/
theorem deletedCoefficientContraction_empty (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W)
    (Q : ColoredInputs W) [IsEmpty Q.index] :
    deletedCoefficientContraction E a P Q =
      (FiniteTensor.tensor (V := C)).map (emptyContractionCoefficientMap E.toCollection X P Q) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj P) := by
  let T := FiniteTensor.tensor (V := C)
  let m := contractionInputMap E.toCollection X (𝟙 P) (emptyInputsIso Q).hom
  let k := emptyContractionCoefficientMap E.toCollection X P emptyColoredInputs
  let k' := emptyContractionCoefficientMap E.toCollection X P Q
  let s := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj P)
  have hn : T.map m ≫ deletedCoefficientContraction E a P emptyColoredInputs =
      deletedCoefficientContraction E a P Q := deletedCoefficientContraction_inputs E a P (emptyInputsIso Q).hom
  have he : deletedCoefficientContraction E a P emptyColoredInputs = T.map k ≫ s :=
    (deletedCoefficientContraction_empty_literal E a P).trans (emptyLinearSummandIso_emptyMap E.toCollection X P)
  have hm : m ≫ k = k' := emptyContractionCoefficientMap_factor E.toCollection X P Q
  exact hn.symm.trans
    ((congrArg (T.map m ≫ ·) he).trans
      ((Category.assoc (T.map m) (T.map k) s).symm.trans
        ((congrArg (· ≫ s) (T.map_comp m k).symm).trans
          (congrArg (fun f => T.map f ≫ s) hm))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource102


section AttachmentSource103


/-!
## Complete original weighted normalization at actual empty contracted inputs
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The original empty coefficient/input map followed by the exact
original singleton coefficient/leaf flattening maps. -/
def emptyContractionNormalizationMap (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested (constantInputFamily O X P Q) L) ⟶
      (coefficientLeafFamilyFunctor L).obj (O.obj P) :=
  (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (emptyContractionCoefficientMap O X P Q) (𝟙 L)) ≫
    (FiniteFamily.flatten (C := C)).map (singletonCoefficientLeavesIso (O.obj P) L).hom ≫
      FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj (O.obj P))

variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationEmptyTensorFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationEmptyNormalizationSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationEmptyTensorProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- For every actual empty contracted-input family, the full original
weighted contraction is the tensor of its original source normalization map.
All retained heterogeneous inputs and the nullary corner remain explicit. -/
theorem coefficientContractionTensor_empty (E : ColoredOperadObj W C) {X : W → C}
    (a : freeAlgebra E X ⟶ initialAlgebra E) (P : ColoredProfile W)
    (Q : ColoredInputs W) [IsEmpty Q.index] (L : FiniteFamily C) :
    coefficientContractionTensor E a P Q L =
      (FiniteTensor.tensor (V := C)).map (emptyContractionNormalizationMap E.toCollection X P Q L) := by
  let T := FiniteTensor.tensor (V := C)
  let K := constantInputFamily E.toCollection X P Q
  let k := emptyContractionCoefficientMap E.toCollection X P Q
  let d := deletedCoefficientContraction E a P Q
  let s := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj P)
  let m := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap k (𝟙 L))
  let out := (FiniteFamily.flatten (C := C)).map (singletonCoefficientLeavesIso (E.toCollection.obj P) L).hom ≫
    FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj (E.toCollection.obj P))
  let U := coefficientLeafTensorFunctor L
  let c := coefficientContractionTensor E a P Q L
  have hd : T.map k ≫ s = d ≫ 𝟙 (E.toCollection.obj P) :=
    (deletedCoefficientContraction_empty E a P Q).symm.trans (Category.comp_id d).symm
  have hId : T.map (coefficientLeafMap (𝟙 (E.toCollection.obj P)) (𝟙 L)) = 𝟙 (U.obj (E.toCollection.obj P)) :=
    (congrArg T.map (coefficientLeafMap_idLeaves (𝟙 (E.toCollection.obj P)) L)).trans
      ((congrArg T.map ((coefficientLeafFamilyFunctor L).map_id (E.toCollection.obj P))).trans (T.map_id _))
  have hn : T.map m ≫
      (coefficientLeavesNormalization ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj P)) L ≫ U.map s) = c :=
    (TensorNormalization.coefficientNormalizationSquare k (𝟙 L) d s (𝟙 (E.toCollection.obj P)) hd).trans
      ((congrArg (c ≫ ·) hId).trans (Category.comp_id c))
  have hs : coefficientLeavesNormalization ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj P)) L ≫
      U.map s = T.map out := coefficientLeavesNormalization_singleton (E.toCollection.obj P) L
  have hm : T.map (emptyContractionNormalizationMap E.toCollection X P Q L) = T.map m ≫ T.map out := T.map_comp m out
  exact hn.symm.trans ((congrArg (T.map m ≫ ·) hs).trans hm.symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource103


section AttachmentSource104


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem emptyNormalization_position_root (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] (L : FiniteFamily C) :
    (emptyContractionNormalizationMap O X P Q L).equiv ⟨none, none⟩ = none := rfl

theorem emptyNormalization_position_leaf (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] (L : FiniteFamily C) (i : L.index) :
    (emptyContractionNormalizationMap O X P Q L).equiv ⟨some i, PUnit.unit⟩ = some i := rfl

theorem emptyNormalization_component_root (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] (L : FiniteFamily C) :
    (emptyContractionNormalizationMap O X P Q L).hom ⟨none, none⟩ = O.map (emptyInputProfileHom P Q) := by
  let f := O.map (emptyInputProfileHom P Q)
  let Y := O.obj P
  change f ≫ 𝟙 Y ≫ 𝟙 Y = f
  exact (congrArg (f ≫ ·) (Category.id_comp (𝟙 Y))).trans (Category.comp_id f)

theorem emptyNormalization_component_leaf (O : ColoredSymmetricCollection W C) (X : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) [IsEmpty Q.index] (L : FiniteFamily C) (i : L.index) :
    (emptyContractionNormalizationMap O X P Q L).hom ⟨some i, PUnit.unit⟩ = 𝟙 (L.obj i) := by
  let Y := L.obj i
  change 𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y = 𝟙 Y
  exact (Category.id_comp (𝟙 Y ≫ 𝟙 Y)).trans (Category.id_comp (𝟙 Y))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource104


section AttachmentSource105


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource105_dependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- Identify fully selected marked carrier factors with their surviving `Xprime` leaves. -/
def allTopLeafMap {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i) :
    (FiniteFamily.map (markedInputCarrier x)).obj P ⟶ profileLeafFamily Xprime (survivingProfile d P) where
  equiv := (allTopSurvivorHom d P hP).inputEquiv
  hom i := eqToHom (markedTopCarrierEq x P i (hP i))

/-- The unchanged original marked source normalization at an all-top profile
is the original full-to-survivor profile map with every original X′ leaf. -/
theorem allTopSource_normalization (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i)
    [IsEmpty (contractedInputs P).index] :
    (markedContractionFactorsIso O x d P).hom ≫
        emptyContractionNormalizationMap O X (survivingProfile d P) (contractedInputs P)
          (profileLeafFamily Xprime (survivingProfile d P)) =
      coefficientLeafMap (O.map (allTopSurvivorHom d P hP)) (allTopLeafMap x d P hP) := by
  let S := survivingProfile d P
  let Q := contractedInputs P
  let L := profileLeafFamily Xprime S
  let A := markedContractionFactors O X Xprime d P
  let B := (coefficientLeafFamilyFunctor L).obj (O.obj S)
  let R := (markedContractionFactorsIso O x d P).hom
  let N := emptyContractionNormalizationMap O X S Q L
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i =>
        change N.equiv (R.equiv (some i)) = some ⟨i, hP i⟩
        exact (congrArg N.equiv (markedContraction_position_top O x d P i (hP i))).trans
          (emptyNormalization_position_leaf O X S Q L ⟨i, hP i⟩)
  · intro i
    cases i with
    | none =>
        let f := O.map (asIso (C := ColoredProfile W) (selectionRootHom d P)).inv
        let g := O.map (emptyInputProfileHom S Q)
        change HEq (R.hom none ≫ N.hom ⟨none, none⟩) (O.map (allTopSurvivorHom d P hP))
        have h : R.hom none ≫ N.hom ⟨none, none⟩ = f ≫ g :=
          congrArg₂ (fun f g => f ≫ g) (markedContraction_component_root O x d P)
            (emptyNormalization_component_root O X S Q L)
        exact heq_of_eq (h.trans ((O.map_comp _ _).symm.trans (congrArg O.map (allTopRootProfile d P hP))))
    | some i =>
        let p := R.equiv (some i)
        have hp : p = ⟨some ⟨i, hP i⟩, PUnit.unit⟩ := markedContraction_position_top O x d P i (hP i)
        have ha : A.obj p = Xprime (P.obj i).2.as := congrArg A.obj hp
        have hb : B.obj (N.equiv p) = Xprime (P.obj i).2.as :=
          (congrArg (fun j => B.obj (N.equiv j)) hp).trans
            (congrArg B.obj (emptyNormalization_position_leaf O X S Q L ⟨i, hP i⟩))
        have hn : HEq (N.hom p) (𝟙 (Xprime (P.obj i).2.as)) :=
          (AttachmentSource105_dependentApply N.hom hp).trans (heq_of_eq (emptyNormalization_component_leaf O X S Q L
            ⟨i, hP i⟩))
        have h := heq_comp rfl ha hb (markedContraction_component_top O x d P i (hP i)) hn
        exact h.trans (heq_of_eq (Category.comp_id (eqToHom (markedTopCarrierEq x P i (hP i)))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource105


section AttachmentSource106


set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]

theorem markedProfile_toAllTop (d : W) (P : MarkedInputs W) :
    (markedProfileFunctor d).map ((toAllTopInputs (W := W)).app P) =
      𝟙 ((markedProfileFunctor d).obj P) := ColoredProfile.Hom.ext rfl

theorem allTopCarrier_promotion {X Xprime : W → C} (x : X ⟶ Xprime)
    (P : MarkedInputs W) (i : P.index) (hi : SelectedInput P i) :
    (markedInputCarrier x).map (((toAllTopInputs (W := W)).app P).hom i) ≫
      eqToHom (markedCarrier_top x (P.obj i).2.as) = eqToHom (markedTopCarrierEq x P i hi) := by
  let e : P.obj i = ((Finset.univ, Discrete.mk (P.obj i).2.as) : MarkedColor W) := Prod.ext hi rfl
  have h : (((toAllTopInputs (W := W)).app P).hom i) = eqToHom e := Subsingleton.elim _ _
  let F := markedInputCarrier x
  let t := eqToHom (markedCarrier_top x (P.obj i).2.as)
  have hm : F.map (((toAllTopInputs (W := W)).app P).hom i) = eqToHom (congrArg F.obj e) :=
    (congrArg F.map h).trans (eqToHom_map F e)
  have ht : eqToHom (congrArg F.obj e) ≫ t = eqToHom (markedTopCarrierEq x P i hi) :=
    eqToHom_trans (congrArg F.obj e) (markedCarrier_top x (P.obj i).2.as)
  exact (congrArg (· ≫ t) hm).trans ht

/-- The original all-top full-to-survivor source map followed by the original
operation-factor comparison is the literal marked top promotion and profile action. -/
theorem allTopEvaluation_factors (O : ColoredSymmetricCollection W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (d : W) (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i) :
    coefficientLeafMap (O.map (allTopSurvivorHom d P hP)) (allTopLeafMap x d P hP) ≫
        (profileOperationFactorsIso O Xprime (survivingProfile d P)).hom =
    (coefficientInputFactors (markedProfileFunctor d ⋙ O) (FiniteFamily.map (markedInputCarrier x))).map
        ((toAllTopInputs (W := W)).app P) ≫
      (topOperationFactorsIso O x ((markedProfileFunctor d).obj P)).hom ≫
      (operationFactorsFunctor O Xprime).map (allTopSurvivorHom d P hP) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
        let f := O.map (allTopSurvivorHom d P hP)
        let r := O.map ((markedProfileFunctor d).map ((toAllTopInputs (W := W)).app P))
        have hr : r = 𝟙 (O.obj ((markedProfileFunctor d).obj P)) :=
          (congrArg O.map (markedProfile_toAllTop d P)).trans (O.map_id _)
        change HEq (f ≫ 𝟙 _) (r ≫ 𝟙 _ ≫ f)
        have hright : r ≫ 𝟙 _ ≫ f = f :=
          (congrArg (· ≫ 𝟙 _ ≫ f) hr).trans
            ((Category.id_comp (𝟙 _ ≫ f)).trans (Category.id_comp f))
        exact heq_of_eq ((Category.comp_id f).trans hright.symm)
    | some i =>
        let m := (markedInputCarrier x).map (((toAllTopInputs (W := W)).app P).hom i)
        let t := eqToHom (markedCarrier_top x (P.obj i).2.as)
        let e := eqToHom (markedTopCarrierEq x P i (hP i))
        let Y := Xprime (P.obj i).2.as
        change HEq (e ≫ 𝟙 Y) (m ≫ t ≫ 𝟙 Y)
        exact heq_of_eq ((congrArg (· ≫ 𝟙 Y) (allTopCarrier_promotion x P i (hP i)).symm).trans
          (Category.assoc m t (𝟙 Y)))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource106


section AttachmentSource107


/-!
## Original marked contraction unit at every actual all-top profile
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource107_mapThree {D E : Type*} [Category* D] [Category* E] (T : D ⥤ E)
    {A B C F : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ F) :
    T.map (a ≫ b ≫ c) = T.map a ≫ T.map b ≫ T.map c := by simp only [Functor.map_comp]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationAllTopUnitFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationAllTopUnitSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationAllTopUnitProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The unchanged original marked contraction at an all-top profile is exactly
the original full-profile top operation source followed by its original survivor
profile map. The nullary profile and all original input positions are retained. -/
theorem normalizedMarkedFaceContraction_allTop (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i) :
    normalizedMarkedFaceContraction E x a d P =
      (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P) ≫
        (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom ≫
        (operationSummandFunctor E.toCollection Xprime).map (allTopSurvivorHom d P hP) := by
  let T := FiniteTensor.tensor (V := C)
  let S := survivingProfile d P
  let Q := contractedInputs P
  let L := profileLeafFamily Xprime S
  let : IsEmpty Q.index := allTopContractedEmpty P hP
  let r0 := (markedContractionFactorsIso E.toCollection x d P).hom
  let m0 := emptyContractionNormalizationMap E.toCollection X S Q L
  let p0 := (profileOperationFactorsIso E.toCollection Xprime S).hom
  let b0 := (coefficientInputFactors (markedProfileFunctor d ⋙ E.toCollection)
    (FiniteFamily.map (markedInputCarrier x))).map ((toAllTopInputs (W := W)).app P)
  let t0 := (topOperationFactorsIso E.toCollection x ((markedProfileFunctor d).obj P)).hom
  let v0 := (operationFactorsFunctor E.toCollection Xprime).map (allTopSurvivorHom d P hP)
  let r := T.map r0
  let m := T.map m0
  let p := T.map p0
  let c := coefficientContractionTensor E a S Q L
  have hsource : (r0 ≫ m0) ≫ p0 = b0 ≫ t0 ≫ v0 :=
    (congrArg (· ≫ p0) (allTopSource_normalization E.toCollection x d P hP)).trans
      (allTopEvaluation_factors E.toCollection x d P hP)
  have hmap : r ≫ m ≫ p = T.map b0 ≫ T.map t0 ≫ T.map v0 :=
    (AttachmentSource107_mapThree T r0 m0 p0).symm.trans
      ((congrArg T.map (Category.assoc r0 m0 p0).symm).trans
        ((congrArg T.map hsource).trans (AttachmentSource107_mapThree T b0 t0 v0)))
  have hnorm : normalizedMarkedFaceContraction E x a d P = r ≫ c ≫ p :=
    normalizedMarkedFaceContraction_deleted E x a d P
  have hempty : c = m := coefficientContractionTensor_empty E a S Q L
  exact hnorm.trans ((congrArg (r ≫ · ≫ p) hempty).trans hmap)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource107


section AttachmentSource108


set_option autoImplicit false
noncomputable section
universe uc

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- Enumerate the input type of a marked profile by its finite cardinality. -/
def markedEnumeration (d : W) (P : MarkedInputs W) :
    Fin (inputCount ((markedProfileFunctor d).obj P)) ≃ P.index :=
  inputEnumeration ((markedProfileFunctor d).obj P)

/-- Reindex a marked input family by the enumeration of its colored profile. -/
def enumeratedMarkedWord (d : W) (P : MarkedInputs W) :
    DegreeMarkedInputs W (inputCount ((markedProfileFunctor d).obj P)) :=
  fun i => P.obj (markedEnumeration d P i)

/-- The actual original marked inputs map to their canonical degree word
through their original input enumeration and all original coordinate/color values. -/
def markedEnumerationIso (d : W) (P : MarkedInputs W) :
    P ≅ (degreeMarkedInclusion (W := W) (inputCount ((markedProfileFunctor d).obj P))).obj (enumeratedMarkedWord d P) :=
  FiniteFamily.isoOfComponents (markedEnumeration d P).symm
    (fun i => eqToIso (congrArg P.obj ((markedEnumeration d P).apply_symm_apply i)).symm)

theorem enumeratedMarkedWord_punctured (d : W) (P : MarkedInputs W)
    (hP : ∃ i, ¬ SelectedInput P i) : IsPuncturedMarked (enumeratedMarkedWord d P) := by
  obtain ⟨i, hi⟩ := hP
  refine ⟨(markedEnumeration d P).symm i, ?_⟩
  exact (congrArg (fun j => ¬ SelectedInput P j) ((markedEnumeration d P).apply_symm_apply i)).symm.mp hi

/-- The actual survivor profile never has more inputs than the original full profile. -/
theorem survivingCount_le (d : W) (P : MarkedInputs W) :
    inputCount (survivingProfile d P) ≤ inputCount ((markedProfileFunctor d).obj P) := by
  exact Fintype.card_le_of_injective (fun i : (survivingInputs P).index => i.1) Subtype.val_injective


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource108


section AttachmentSource109


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource109_triplePost {D : Type*} [Category* D] {A B C E Z : D}
    (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (q : E ⟶ Z) :
    (f ≫ g ≫ h) ≫ q = f ≫ g ≫ h ≫ q :=
  (Category.assoc f (g ≫ h) q).trans (congrArg (f ≫ ·) (Category.assoc g h q))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationStageAllTopFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationStageAllTopSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationStageAllTopProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original all-top marked contraction satisfies its actual original
stage face equation, derived from E's unit and the original stage cofan action. -/
theorem stage_face_allTop (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (P : MarkedInputs W) (hP : ∀ i, SelectedInput P i)
    (hN : inputCount ((markedProfileFunctor d).obj P) ≤ N) :
    normalizedMarkedFaceContraction E x a d P ≫
      stageProfileLeg E x a N (survivingProfile d P) ((survivingCount_le d P).trans hN) =
    markedTopStageCofan E x a d N P hN := by
  let m := (markedTensorDiagram E x d).map ((toAllTopInputs (W := W)).app P)
  let p := (topOperationTensorIso E x ((markedProfileFunctor d).obj P)).hom
  let f := (operationSummandFunctor E.toCollection Xprime).map (allTopSurvivorHom d P hP)
  let l := stageProfileLeg E x a N (survivingProfile d P) ((survivingCount_le d P).trans hN)
  let l0 := stageProfileLeg E x a N ((markedProfileFunctor d).obj P) hN
  have hf : f ≫ l = l0 :=
    (stageProfileLeg_naturality E x a N (allTopSurvivorHom d P hP) hN ((survivingCount_le d P).trans hN)).trans
      (Category.comp_id l0)
  have hn : normalizedMarkedFaceContraction E x a d P = m ≫ p ≫ f := normalizedMarkedFaceContraction_allTop E x a d P hP
  exact (congrArg (· ≫ l) hn).trans ((AttachmentSource109_triplePost m p f l).trans (congrArg (m ≫ p ≫ ·) hf))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource109


section AttachmentSource110


/-!
## Original marked source isomorphisms commute with every original profile isomorphism
-/

set_option autoImplicit false
noncomputable section
universe uc u v

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Enveloping

private theorem AttachmentSource110_dependentApply {I : Type*} {F : I → Sort*} (f : ∀ i, F i)
    {i j : I} (h : i = j) : HEq (f i) (f j) := by
  cases h
  rfl

private theorem AttachmentSource110_inverseSquare {D : Type*} [Category* D] {X X' A A' : D}
    (s : X ≅ A) (s' : X' ≅ A') (r : X ⟶ X') (f : A ⟶ A')
    (h : r ≫ s'.hom = s.hom ≫ f) : f ≫ s'.inv = s.inv ≫ r := by
  apply (cancel_epi s.hom).1
  have hb : (s.hom ≫ f) ≫ s'.inv = r :=
    (congrArg (· ≫ s'.inv) h.symm).trans
      ((Category.assoc r s'.hom s'.inv).trans
        ((congrArg (r ≫ ·) s'.hom_inv_id).trans (Category.comp_id r)))
  exact ((Category.assoc s.hom f s'.inv).symm.trans hb).trans
    (Iso.hom_inv_id_assoc s r).symm

private theorem AttachmentSource110_carrierTransport {J D : Type*} [Category* J] [Category* D]
    (F : J ⥤ D) {A B : J} {X Y : D} (f : A ⟶ B) [Subsingleton (A ⟶ B)]
    (e : A = B) (hx : F.obj A = X) (hy : F.obj B = Y) (h : X = Y) :
    F.map f ≫ eqToHom hy = eqToHom hx ≫ eqToHom h := by
  have hf : f = eqToHom e := Subsingleton.elim _ _
  rw [hf, eqToHom_map F, eqToHom_trans, eqToHom_trans]

variable {W : Type uc} {C : Type u} [Category.{v} C]

/-- The original root/contracted/surviving reindexing map uses the
actual original restricted input and leaf bijections. -/
def markedContractionIsoSourceMap (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (_x : X ⟶ Xprime) (d : W)
    {P P' : MarkedInputs W} (g : P ≅ P') :
    markedContractionFactors O X Xprime d P ⟶ markedContractionFactors O X Xprime d P' :=
  (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
    (contractionInputMap O X (markedSurvivorProfileHom d g) (markedContractedInputsIso g).hom)
    (profileLeafIso Xprime (markedSurvivorProfileHom d g)).hom)

theorem markedContractionIsoSource_square (O : ColoredSymmetricCollection W C)
    {X Xprime : W → C} (x : X ⟶ Xprime) (d : W)
    {P P' : MarkedInputs W} (g : P ≅ P') :
    (coefficientInputFactors (markedProfileFunctor d ⋙ O)
        (FiniteFamily.map (markedInputCarrier x))).map g.hom ≫
      (markedContractionFactorsIso O x d P').hom =
    (markedContractionFactorsIso O x d P).hom ≫ markedContractionIsoSourceMap O x d g := by
  let M := markedContractionIsoSourceMap O x d g
  let A := markedContractionFactors O X Xprime d P
  let B := markedContractionFactors O X Xprime d P'
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | none => rfl
    | some i =>
        by_cases hi : SelectedInput P i
        · have hi' := (markedIso_selected g i).mp hi
          change (markedContractionFactorsIso O x d P').hom.equiv (some (g.hom.equiv i)) =
            M.equiv ((markedContractionFactorsIso O x d P).hom.equiv (some i))
          exact (markedContraction_position_top O x d P' _ hi').trans
            ((congrArg M.equiv (markedContraction_position_top O x d P i hi)).trans rfl).symm
        · have hi' := (not_congr (markedIso_selected g i)).mp hi
          change (markedContractionFactorsIso O x d P').hom.equiv (some (g.hom.equiv i)) =
            M.equiv ((markedContractionFactorsIso O x d P).hom.equiv (some i))
          exact (markedContraction_position_old O x d P' _ hi').trans
            ((congrArg M.equiv (markedContraction_position_old O x d P i hi)).trans rfl).symm
  · intro i
    cases i with
    | none =>
        let s := asIso (selectionRootHom d P)
        let s' := asIso (selectionRootHom d P')
        let r := extendProfileMap (markedSurvivorProfileHom d g) (markedContractedInputsIso g).hom
        let f := (markedProfileFunctor d).map g.hom
        have hp : f ≫ s'.inv = s.inv ≫ r := AttachmentSource110_inverseSquare s s' r f (selectionRootHom_iso d g)
        change HEq (O.map f ≫ O.map s'.inv) (O.map s.inv ≫ O.map r)
        exact heq_of_eq ((O.map_comp _ _).symm.trans ((congrArg O.map hp).trans (O.map_comp _ _)))
    | some i =>
        let j := g.hom.equiv i
        have e : P.obj i = P'.obj j := Prod.ext (markedIso_coordinate g i)
          (congrArg Discrete.mk (Discrete.eq_of_hom (g.hom.hom i).2))
        by_cases hi : SelectedInput P i
        · have hi' := (markedIso_selected g i).mp hi
          let p : A.index := (markedContractionFactorsIso O x d P).hom.equiv (some i)
          let p' : B.index := (markedContractionFactorsIso O x d P').hom.equiv (some j)
          have hp : p = ⟨some ⟨i, hi⟩, PUnit.unit⟩ := markedContraction_position_top O x d P i hi
          have ha : A.obj p = Xprime (P.obj i).2.as := congrArg A.obj hp
          have hb : B.obj p' = Xprime (P'.obj j).2.as :=
            congrArg B.obj (markedContraction_position_top O x d P' j hi')
          have hc : B.obj (M.equiv p) = Xprime (P'.obj j).2.as := congrArg (fun t => B.obj (M.equiv t)) hp
          let hcolor := congrArg Xprime (Discrete.eq_of_hom (g.hom.hom i).2)
          have hm : HEq (M.hom p) (eqToHom hcolor) :=
            (AttachmentSource110_dependentApply M.hom hp).trans HEq.rfl
          have hl := heq_comp rfl rfl hb (HEq.rfl : HEq ((markedInputCarrier x).map (g.hom.hom i)) _)
            (markedContraction_component_top O x d P' j hi')
          have hr := heq_comp rfl ha hc (markedContraction_component_top O x d P i hi) hm
          have hs := AttachmentSource110_carrierTransport (markedInputCarrier x) (g.hom.hom i) e
            (markedTopCarrierEq x P i hi) (markedTopCarrierEq x P' j hi') hcolor
          exact hl.trans ((heq_of_eq hs).trans hr.symm)
        · have hi' := (not_congr (markedIso_selected g i)).mp hi
          let p : A.index := (markedContractionFactorsIso O x d P).hom.equiv (some i)
          let p' : B.index := (markedContractionFactorsIso O x d P').hom.equiv (some j)
          have hp : p = ⟨none, some ⟨i, hi⟩⟩ := markedContraction_position_old O x d P i hi
          have ha : A.obj p = X (P.obj i).2.as := congrArg A.obj hp
          have hb : B.obj p' = X (P'.obj j).2.as :=
            congrArg B.obj (markedContraction_position_old O x d P' j hi')
          have hc : B.obj (M.equiv p) = X (P'.obj j).2.as := congrArg (fun t => B.obj (M.equiv t)) hp
          let hcolor := congrArg X (Discrete.eq_of_hom (g.hom.hom i).2)
          have hm : HEq (M.hom p) (eqToHom hcolor) :=
            (AttachmentSource110_dependentApply M.hom hp).trans HEq.rfl
          have hl := heq_comp rfl rfl hb (HEq.rfl : HEq ((markedInputCarrier x).map (g.hom.hom i)) _)
            (markedContraction_component_old O x d P' j hi')
          have hr := heq_comp rfl ha hc (markedContraction_component_old O x d P i hi) hm
          have hs := AttachmentSource110_carrierTransport (markedInputCarrier x) (g.hom.hom i) e
            (markedCarrier_old x (P.obj i).1 hi (P.obj i).2.as)
            (markedCarrier_old x (P'.obj j).1 hi' (P'.obj j).2.as) hcolor
          exact hl.trans ((heq_of_eq hs).trans hr.symm)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource110


section AttachmentSource111


/-!
## Full original marked contraction naturality under original profile isomorphisms
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource111_threeSquares {D : Type*} [Category* D]
    {A A' B B' K K' X X' : D} (m : A ⟶ A') (a : A ⟶ B) (a' : A' ⟶ B')
    (h : B ⟶ B') (c : B ⟶ K) (c' : B' ⟶ K') (z : K ⟶ K')
    (p : K ⟶ X) (p' : K' ⟶ X') (f : X ⟶ X')
    (ha : m ≫ a' = a ≫ h) (hc : h ≫ c' = c ≫ z) (hp : z ≫ p' = p ≫ f) :
    m ≫ (a' ≫ c' ≫ p') = (a ≫ c ≫ p) ≫ f := by
  calc
    m ≫ (a' ≫ c' ≫ p') = (m ≫ a') ≫ c' ≫ p' := (Category.assoc _ _ _).symm
    _ = (a ≫ h) ≫ c' ≫ p' := congrArg (· ≫ c' ≫ p') ha
    _ = a ≫ (h ≫ c') ≫ p' := by simp only [Category.assoc]
    _ = a ≫ (c ≫ z) ≫ p' := congrArg (fun q => a ≫ q ≫ p') hc
    _ = a ≫ c ≫ (z ≫ p') := by simp only [Category.assoc]
    _ = a ≫ c ≫ (p ≫ f) := congrArg (a ≫ c ≫ ·) hp
    _ = (a ≫ c ≫ p) ≫ f := by simp only [Category.assoc]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationMarkedNaturalFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationMarkedNaturalTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationMarkedNaturalProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every actual original marked profile isomorphism commutes with the
unchanged original normalized contraction, including all original root,
contracted, survivor and color maps. -/
theorem normalizedMarkedFaceContraction_iso (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W)
    {P P' : MarkedInputs W} (g : P ≅ P') :
    (markedTensorDiagram E x d).map g.hom ≫ normalizedMarkedFaceContraction E x a d P' =
      normalizedMarkedFaceContraction E x a d P ≫
        (operationSummandFunctor E.toCollection Xprime).map (markedSurvivorProfileHom d g) := by
  let T := FiniteTensor.tensor (V := C)
  let S := survivingProfile d P
  let S' := survivingProfile d P'
  let Q := contractedInputs P
  let Q' := contractedInputs P'
  let f := markedSurvivorProfileHom d g
  let l := (profileLeafIso Xprime f).hom
  let r := T.map (markedContractionFactorsIso E.toCollection x d P).hom
  let r' := T.map (markedContractionFactorsIso E.toCollection x d P').hom
  let h := T.map (markedContractionIsoSourceMap E.toCollection x d g)
  let c := coefficientContractionTensor E a S Q (profileLeafFamily Xprime S)
  let c' := coefficientContractionTensor E a S' Q' (profileLeafFamily Xprime S')
  let z := T.map (coefficientLeafMap (E.toCollection.map f) l)
  let p := (profileCoefficientLeafTensorIso E.toCollection Xprime S).hom
  let p' := (profileCoefficientLeafTensorIso E.toCollection Xprime S').hom
  let m := (markedTensorDiagram E x d).map g.hom
  have hr : m ≫ r' = r ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (markedContractionIsoSource_square E.toCollection x d g)).trans (T.map_comp _ _))
  have hc : h ≫ c' = c ≫ z := coefficientContractionTensor_joint E a f (markedContractedInputsIso g).hom l
  have hp : z ≫ p' = p ≫ (operationSummandFunctor E.toCollection Xprime).map f :=
    (profileCoefficientLeafTensorIso_naturality E.toCollection Xprime f).symm
  have he := AttachmentSource111_threeSquares m r r' h c c' z p p' _ hr hc hp
  simpa only [normalizedMarkedFaceContraction_deleted, coefficientContractionTensor_original,
    m, r, r', h, c, c', z, p, p', S, S', Q, Q', f, l, T, Category.assoc] using! he


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource111


section AttachmentSource112


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource112_postNorm {D : Type*} [Category* D] {A B C E Z : D}
    (f : A ⟶ B) (a : B ⟶ C) (b : A ⟶ E) (g : E ⟶ C)
    (l : C ⟶ Z) (l' : E ⟶ Z) (h : f ≫ a = b ≫ g) (hg : g ≫ l = l') :
    f ≫ (a ≫ l) = b ≫ l' :=
  (Category.assoc f a l).symm.trans
    ((congrArg (· ≫ l) h).trans
      ((Category.assoc b g l).trans (congrArg (b ≫ ·) hg)))

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationAnyMarkedFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationAnyMarkedSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationAnyMarkedProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original marked input profile has its original contraction versus
top-coordinate stage equation, including all-top and nullary profiles. It is
derived from the constructed coequalizers, original permutations and E's units. -/
theorem stage_face_anyMarked (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (P : MarkedInputs W) (hN : inputCount ((markedProfileFunctor d).obj P) ≤ N) :
    normalizedMarkedFaceContraction E x a d P ≫
      stageProfileLeg E x a N (survivingProfile d P) ((survivingCount_le d P).trans hN) =
        markedTopStageCofan E x a d N P hN := by
  classical
  by_cases ht : ∀ i, SelectedInput P i
  · exact stage_face_allTop E x a d N P ht hN
  · obtain ⟨i, hi⟩ := not_forall.mp ht
    let n := inputCount ((markedProfileFunctor d).obj P)
    let word := enumeratedMarkedWord d P
    let Q := (degreeMarkedInclusion (W := W) n).obj word
    let e := markedEnumerationIso d P
    have hw : IsPuncturedMarked word := enumeratedMarkedWord_punctured d P ⟨i, hi⟩
    let c : BoundedFace W N := ⟨n, word, hN, hw⟩
    have hQ : inputCount ((markedProfileFunctor d).obj Q) ≤ N := (degreeProfile_count d n word).symm ▸ hN
    let hS := (survivingCount_le d P).trans hN
    let hS' := (c.survivor_lt d).le.trans c.bound
    let l := stageProfileLeg E x a N (survivingProfile d P) hS
    let l' := stageProfileLeg E x a N (survivingProfile d Q) hS'
    let f := (markedTensorDiagram E x d).map e.hom
    let g := (operationSummandFunctor E.toCollection Xprime).map (markedSurvivorProfileHom d e)
    have hcanon : normalizedMarkedFaceContraction E x a d Q ≫ l' = markedTopStageCofan E x a d N Q hQ :=
      (stage_face E x a d N c).trans (canonicalMarkedTopStageCofan E x a d N n word hN).symm
    have hnorm : f ≫ normalizedMarkedFaceContraction E x a d Q =
        normalizedMarkedFaceContraction E x a d P ≫ g := normalizedMarkedFaceContraction_iso E x a d e
    have hleaf : g ≫ l' = l :=
      (stageProfileLeg_naturality E x a N (markedSurvivorProfileHom d e) hS hS').trans (Category.comp_id l)
    have heval : f ≫ (normalizedMarkedFaceContraction E x a d Q ≫ l') =
        normalizedMarkedFaceContraction E x a d P ≫ l :=
      AttachmentSource112_postNorm f _ _ g l' l hnorm hleaf
    have htop : f ≫ markedTopStageCofan E x a d N Q hQ = markedTopStageCofan E x a d N P hN :=
      markedTopStageCofan_naturality E x a d N e.hom hN hQ
    exact heval.symm.trans ((congrArg (f ≫ ·) hcanon).trans htop)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource112


section AttachmentSource113


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource113_lowerRoute {V : Type*} [Category* V] {A B R P Q S Z : V}
    (m : A ⟶ B) (nQ : B ⟶ Q) (lQ : Q ⟶ Z) (p : A ⟶ R) (t : R ⟶ Q)
    (nR : R ⟶ S) (lR : S ⟶ Z) (nP : A ⟶ P) (f : P ⟶ S) (lP : P ⟶ Z)
    (h1 : m ≫ nQ = p ≫ t) (h2 : t ≫ lQ = nR ≫ lR)
    (h3 : p ≫ nR = nP ≫ f) (h4 : f ≫ lR = lP) :
    m ≫ (nQ ≫ lQ) = nP ≫ lP := by
  calc
    m ≫ (nQ ≫ lQ) = (m ≫ nQ) ≫ lQ := (Category.assoc _ _ _).symm
    _ = (p ≫ t) ≫ lQ := congrArg (· ≫ lQ) h1
    _ = p ≫ (t ≫ lQ) := Category.assoc _ _ _
    _ = p ≫ (nR ≫ lR) := congrArg (p ≫ ·) h2
    _ = (p ≫ nR) ≫ lR := (Category.assoc _ _ _).symm
    _ = (nP ≫ f) ≫ lR := congrArg (· ≫ lR) h3
    _ = nP ≫ (f ≫ lR) := Category.assoc _ _ _
    _ = nP ≫ lP := congrArg (nP ≫ ·) h4

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationLowerFaceFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationLowerFaceSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationLowerFaceProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Each original proper degree-(N+1) face contracts into its strictly earlier
actual survivor-degree operation cofan in the constructed degree-N stage. -/
def lowerFaceValue (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (P : PuncturedMarkedInputs W (N + 1)) :
    (puncturedMarkedTensorDiagram E x d (N + 1)).obj P ⟶ stage E x a d N :=
  normalizedMarkedFaceContraction E x a d ((degreeMarkedInclusion (W := W) (N + 1)).obj P.1) ≫
    stageProfileLeg E x a N
      (survivingProfile d ((degreeMarkedInclusion (W := W) (N + 1)).obj P.1))
      (Nat.le_of_lt_succ (survivingProfile_punctured_degree_lt P d))

/-- Every actual original proper face map and input permutation preserves its
original contraction into the strictly earlier constructed stage. All residual
face equations are derived from E's association/units and genuine stage coequalizers. -/
theorem lowerFaceValue_naturality (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    {P Q : PuncturedMarkedInputs W (N + 1)} (g : P ⟶ Q) :
    (puncturedMarkedTensorDiagram E x d (N + 1)).map g ≫ lowerFaceValue E x a d N Q =
      lowerFaceValue E x a d N P := by
  let P0 := (degreeMarkedInclusion (W := W) (N + 1)).obj P.1
  let Q0 := (degreeMarkedInclusion (W := W) (N + 1)).obj Q.1
  let g0 := (degreeMarkedInclusion (W := W) (N + 1)).map
    ((puncturedMarkedInclusion (W := W) (N + 1)).map g)
  let R := residualMarkedInputs g0
  let hP := Nat.le_of_lt_succ (survivingProfile_punctured_degree_lt P d)
  let hQ := Nat.le_of_lt_succ (survivingProfile_punctured_degree_lt Q d)
  let hR : inputCount ((markedProfileFunctor d).obj R) ≤ N := hQ
  let hS := (survivingCount_le d R).trans hR
  let D := markedTensorDiagram E x d
  let m := D.map g0
  let nQ := normalizedMarkedFaceContraction E x a d Q0
  let lQ := stageProfileLeg E x a N (survivingProfile d Q0) hQ
  let p := partialMarkedContraction E x a d g0
  let u := D.map ((toAllTopInputs (W := W)).app R)
  let v := (topOperationTensorIso E x ((markedProfileFunctor d).obj R)).hom
  let t := u ≫ v
  let nR := normalizedMarkedFaceContraction E x a d R
  let lR := stageProfileLeg E x a N (survivingProfile d R) hS
  let nP := normalizedMarkedFaceContraction E x a d P0
  let f := (operationSummandFunctor E.toCollection Xprime).map (residualSurvivorProfileHom d g0)
  let lP := stageProfileLeg E x a N (survivingProfile d P0) hP
  have h1 : m ≫ nQ = p ≫ t := partialMarkedContraction_promote E x a d g0
  have h2 : t ≫ lQ = nR ≫ lR :=
    (Category.assoc u v lQ).trans (stage_face_anyMarked E x a d N R hR).symm
  have h3 : p ≫ nR = nP ≫ f := partialMarkedContraction_assoc E x a d g0
  have h4 : f ≫ lR = lP :=
    (stageProfileLeg_naturality E x a N (residualSurvivorProfileHom d g0) hP hS).trans (Category.comp_id lP)
  exact AttachmentSource113_lowerRoute m nQ lQ p t nR lR nP f lP h1 h2 h3 h4


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource113


section AttachmentSource114


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationBoundaryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationBoundarySlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationBoundaryProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationBoundaryPuncturedColimits (n : ℕ) : HasColimitsOfShape (PuncturedMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _
local instance continuationBoundaryDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The actual original proper-face contraction maps construct a genuine
boundary cocone into the strictly earlier degree-N stage. -/
def lowerBoundaryCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    Cocone (puncturedMarkedTensorDiagram E x d (N + 1)) where
  pt := stage E x a d N
  ι.app P := lowerFaceValue E x a d N P
  ι.naturality _P _Q g := (lowerFaceValue_naturality E x a d N g).trans (Category.comp_id _).symm

/-- The genuine degree boundary attaching map is descended from every
unchanged original proper-face contraction and original survivor cofan. -/
def attachingMap (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    (degreeBalancedArrow E x d (N + 1)).left ⟶ stage E x a d N :=
  colimit.desc _ (lowerBoundaryCocone E x a d N)

@[reassoc]
theorem attachingMap_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (P : PuncturedMarkedInputs W (N + 1)) :
    colimit.ι (puncturedMarkedTensorDiagram E x d (N + 1)) P ≫ attachingMap E x a d N =
      lowerFaceValue E x a d N P := colimit.ι_desc _ _

theorem lowerFaceValue_successor (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (P : PuncturedMarkedInputs W (N + 1)) :
    lowerFaceValue E x a d N P ≫ stageMap E x a d (Nat.le_succ N) =
      (degreeToTop E x d (N + 1)).app P.1 ≫ colimit.ι (degreeTopTensorDiagram E x d (N + 1)) P.1 ≫
        stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _) := by
  let Q := (degreeMarkedInclusion (W := W) (N + 1)).obj P.1
  let h := Nat.le_of_lt_succ (survivingProfile_punctured_degree_lt P d)
  let c : BoundedFace W (N + 1) := ⟨N + 1, P.1, Nat.le_refl _, P.2⟩
  have hm : lowerFaceValue E x a d N P ≫ stageMap E x a d (Nat.le_succ N) =
      normalizedMarkedFaceContraction E x a d Q ≫ stageProfileLeg E x a (N + 1)
        (survivingProfile d Q) (h.trans (Nat.le_succ N)) := by
    let n := normalizedMarkedFaceContraction E x a d Q
    let l := stageProfileLeg E x a N (survivingProfile d Q) h
    let m := stageMap E x a d (Nat.le_succ N)
    exact (Category.assoc n l m).trans (congrArg (n ≫ ·) (stageProfileLeg_map E x a (Nat.le_succ N) (survivingProfile d
      Q) h))
  exact hm.trans (stage_face E x a d (N + 1) c)

/-- The actual original attaching maps and original stage cofans form the
successor square for the genuine original balanced degree boundary arrow. -/
theorem successorSquare (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    attachingMap E x a d N ≫ stageMap E x a d (Nat.le_succ N) =
      (degreeBalancedArrow E x d (N + 1)).hom ≫
        stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _) := by
  apply colimit.hom_ext
  intro P
  let j := colimit.ι (puncturedMarkedTensorDiagram E x d (N + 1)) P
  let m := stageMap E x a d (Nat.le_succ N)
  let t := stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _)
  exact (Category.assoc j (attachingMap E x a d N) m).symm.trans
    ((congrArg (· ≫ m) (attachingMap_face E x a d N P)).trans
      ((lowerFaceValue_successor E x a d N P).trans
        ((Category.assoc ((degreeToTop E x d (N + 1)).app P.1)
            (colimit.ι (degreeTopTensorDiagram E x d (N + 1)) P.1) t).symm.trans
          ((congrArg (· ≫ t) (degreeBalancedArrow_face E x d (N + 1) P).symm).trans
            (Category.assoc j (degreeBalancedArrow E x d (N + 1)).hom t)))))

/-- The genuine original successor cocone is constructed from the actual
attaching map, original boundary arrow and original stage/degree cofans. -/
def successorCocone (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom :=
  PushoutCocone.mk (stageMap E x a d (Nat.le_succ N))
    (stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _)) (successorSquare E x a d N)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource114


section AttachmentSource115


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationSuccessorTargetFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationSuccessorTargetSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationSuccessorTargetProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationSuccessorTargetFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationSuccessorTargetDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _
local instance continuationSuccessorTargetPuncturedColimits (n : ℕ) : HasColimitsOfShape (PuncturedMarkedInputs W n) C
  :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- Every arbitrary target successor cocone evaluates each original old
degree through its original prior-stage cofan and the new degree through
its original balanced top leg. -/
def successorDegreeTarget (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (j : ℕ) (hj : j ≤ N + 1) : degreeBalancedTop E x d j ⟶ s.pt :=
  if h : j ≤ N then stageDegreeLeg E x a d N j h ≫ s.inl else
    eqToHom (congrArg (fun k => degreeBalancedTop E x d k)
      (Nat.le_antisymm hj (Nat.succ_le_of_lt (Nat.lt_of_not_ge h)))) ≫ s.inr

theorem successorDegreeTarget_old (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (j : ℕ) (hj : j ≤ N) :
    successorDegreeTarget E x a d N s j (hj.trans (Nat.le_succ N)) = stageDegreeLeg E x a d N j hj ≫ s.inl := by
  change (if h : j ≤ N then _ else _) = _
  exact dite_eq_left hj

theorem successorDegreeTarget_new (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom) :
    successorDegreeTarget E x a d N s (N + 1) (Nat.le_refl _) = s.inr := by
  have h : ¬ N + 1 ≤ N := Nat.not_succ_le_self N
  simp only [successorDegreeTarget, dite_eq_right h]
  exact Category.id_comp _

/-- Descend the degree summands of the successor stage to a compatible pushout cocone. -/
def successorProfilesDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom) :
    stageProfiles E x d (N + 1) ⟶ s.pt :=
  Limits.Sigma.desc (fun i : Fin (N + 2) => successorDegreeTarget E x a d N s i.val (Nat.le_of_lt_succ i.isLt))

@[reassoc (attr := simp)]
theorem stageDegreeι_successorProfilesDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (j : ℕ) (hj : j ≤ N + 1) :
    stageDegreeι E x d (N + 1) j hj ≫ successorProfilesDesc E x a d N s = successorDegreeTarget E x a d N s j hj :=
  Limits.Sigma.ι_comp_desc _ _

/-- Each original proper face satisfies the target cocone's original
attaching square on its unchanged original contraction and top cofan. -/
theorem successorTarget_face (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (P : PuncturedMarkedInputs W (N + 1)) :
    lowerFaceValue E x a d N P ≫ s.inl =
      (degreeToTop E x d (N + 1)).app P.1 ≫ colimit.ι (degreeTopTensorDiagram E x d (N + 1)) P.1 ≫ s.inr := by
  let j := colimit.ι (puncturedMarkedTensorDiagram E x d (N + 1)) P
  let f := attachingMap E x a d N
  let g := (degreeBalancedArrow E x d (N + 1)).hom
  have h : j ≫ f ≫ s.inl = j ≫ g ≫ s.inr := congrArg (j ≫ ·) s.condition
  exact (congrArg (· ≫ s.inl) (attachingMap_face E x a d N P).symm).trans
    ((Category.assoc j f s.inl).trans
      (h.trans ((Category.assoc j g s.inr).symm.trans
        ((congrArg (· ≫ s.inr) (degreeBalancedArrow_face E x d (N + 1) P)).trans
          (Category.assoc ((degreeToTop E x d (N + 1)).app P.1)
            (colimit.ι (degreeTopTensorDiagram E x d (N + 1)) P.1) s.inr)))))


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource115


section AttachmentSource116


set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

private theorem AttachmentSource116_triplePost {D : Type*} [Category* D] {A B C E Z : D}
    (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (q : E ⟶ Z) :
    (f ≫ g ≫ h) ≫ q = f ≫ g ≫ h ≫ q :=
  (Category.assoc f (g ≫ h) q).trans (congrArg (f ≫ ·) (Category.assoc g h q))

private theorem AttachmentSource116_postFace {D : Type*} [Category* D] {A B C E F Z : D}
    (n : A ⟶ B) (c : B ⟶ C) (k : C ⟶ E) (t : A ⟶ F) (m : F ⟶ E)
    (s : E ⟶ Z) (h : n ≫ c ≫ k = t ≫ m) :
    n ≫ c ≫ (k ≫ s) = t ≫ (m ≫ s) :=
  (AttachmentSource116_triplePost n c k s).symm.trans
    ((congrArg (· ≫ s) h).trans (Category.assoc t m s))

private theorem AttachmentSource116_relationPost {D : Type*} [Category* D] {A B C E F G Z : D}
    (j : A ⟶ B) (L R : B ⟶ C) (q : C ⟶ Z)
    (n : A ⟶ E) (c : E ⟶ F) (i : F ⟶ C) (t : A ⟶ G) (i' : G ⟶ C)
    (k : F ⟶ Z) (k' : G ⟶ Z)
    (hL : j ≫ L = n ≫ c ≫ i) (hR : j ≫ R = t ≫ i')
    (hi : i ≫ q = k) (hi' : i' ≫ q = k') (he : n ≫ c ≫ k = t ≫ k') :
    j ≫ L ≫ q = j ≫ R ≫ q := by
  calc
    j ≫ L ≫ q = (j ≫ L) ≫ q := (Category.assoc _ _ _).symm
    _ = (n ≫ c ≫ i) ≫ q := congrArg (· ≫ q) hL
    _ = n ≫ c ≫ (i ≫ q) := AttachmentSource116_triplePost n c i q
    _ = n ≫ c ≫ k := congrArg (n ≫ c ≫ ·) hi
    _ = t ≫ k' := he
    _ = t ≫ (i' ≫ q) := congrArg (t ≫ ·) hi'.symm
    _ = (t ≫ i') ≫ q := (Category.assoc _ _ _).symm
    _ = (j ≫ R) ≫ q := congrArg (· ≫ q) hR.symm
    _ = j ≫ R ≫ q := Category.assoc _ _ _

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationSuccessorRelationsFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationSuccessorRelationsSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationSuccessorRelationsProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationSuccessorRelationsFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationSuccessorRelationsFacesColimits (N : ℕ) : HasColimitsOfShape (Discrete (BoundedFace W N)) C
  :=
  HasColimitsOfShape.of_essentiallySmall C _
local instance continuationSuccessorRelationsDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- Every original bounded proper face is preserved by an arbitrary target
successor cocone; the old faces use their genuine prior-stage relation and the
new faces use the original full boundary attaching square. -/
theorem successorTarget_relation (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (c : BoundedFace W (N + 1)) :
    normalizedMarkedFaceContraction E x a d ((degreeMarkedInclusion (W := W) c.degree).obj c.word) ≫
      profileDegreeSummandCofan E x (survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)) ≫
      successorDegreeTarget E x a d N s
        (inputCount (survivingProfile d ((degreeMarkedInclusion (W := W) c.degree).obj c.word)))
        ((c.survivor_lt d).le.trans c.bound) =
    (degreeToTop E x d c.degree).app c.word ≫ colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word ≫
      successorDegreeTarget E x a d N s c.degree c.bound := by
  rcases c with ⟨m, word, hm, hp⟩
  let P := (degreeMarkedInclusion (W := W) m).obj word
  let S := survivingProfile d P
  let k := inputCount S
  have hk : k < m := survivingProfile_punctured_degree_lt (⟨word, hp⟩ : PuncturedMarkedInputs W m) d
  let n := normalizedMarkedFaceContraction E x a d P
  let c := profileDegreeSummandCofan E x S
  let a0 := (degreeToTop E x d m).app word
  let q0 := colimit.ι (degreeTopTensorDiagram E x d m) word
  let t := a0 ≫ q0
  by_cases ho : m ≤ N
  · let hko := hk.le.trans ho
    let co : BoundedFace W N := ⟨m, word, ho, hp⟩
    let l := stageDegreeLeg E x a d N k hko
    let l' := stageDegreeLeg E x a d N m ho
    have hf0 : n ≫ c ≫ l = a0 ≫ q0 ≫ l' := stage_face E x a d N co
    have hf : n ≫ c ≫ l = t ≫ l' := hf0.trans (Category.assoc a0 q0 l').symm
    have hl : successorDegreeTarget E x a d N s k (hk.le.trans hm) = l ≫ s.inl :=
      successorDegreeTarget_old E x a d N s k hko
    have hl' : successorDegreeTarget E x a d N s m hm = l' ≫ s.inl :=
      successorDegreeTarget_old E x a d N s m ho
    exact (congrArg (n ≫ c ≫ ·) hl).trans
      ((AttachmentSource116_postFace n c l t l' s.inl hf).trans
        ((congrArg (t ≫ ·) hl'.symm).trans (Category.assoc a0 q0 (successorDegreeTarget E x a d N s m hm))))
  · have he : m = N + 1 := Nat.le_antisymm hm (Nat.succ_le_of_lt (Nat.lt_of_not_ge ho))
    subst m
    let hko := Nat.le_of_lt_succ hk
    let l := stageDegreeLeg E x a d N k hko
    let q : PuncturedMarkedInputs W (N + 1) := ⟨word, hp⟩
    have hl : successorDegreeTarget E x a d N s k (hk.le.trans hm) = l ≫ s.inl :=
      successorDegreeTarget_old E x a d N s k hko
    have hl' : successorDegreeTarget E x a d N s (N + 1) hm = s.inr := successorDegreeTarget_new E x a d N s
    have hf : (n ≫ c ≫ l) ≫ s.inl = t ≫ s.inr :=
      (successorTarget_face E x a d N s q).trans
        (Category.assoc ((degreeToTop E x d (N + 1)).app word)
          (colimit.ι (degreeTopTensorDiagram E x d (N + 1)) word) s.inr).symm
    exact (congrArg (n ≫ c ≫ ·) hl).trans
      ((AttachmentSource116_triplePost n c l s.inl).symm.trans
        (hf.trans ((congrArg (t ≫ ·) hl'.symm).trans
          (Category.assoc a0 q0 (successorDegreeTarget E x a d N s (N + 1) hm)))))

/-- The full target successor extension preserves every original defining
coequalizer relation, including all profiles and actual proper faces. -/
theorem successorProfilesDesc_relations (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom) :
    stageRelationLeft E x a d (N + 1) ≫ successorProfilesDesc E x a d N s =
      stageRelationRight E x d (N + 1) ≫ successorProfilesDesc E x a d N s := by
  apply Limits.Sigma.hom_ext
  intro c
  let P := (degreeMarkedInclusion (W := W) c.degree).obj c.word
  let S := survivingProfile d P
  let k := inputCount S
  let hk := (c.survivor_lt d).le.trans c.bound
  let j := Limits.Sigma.ι (fun c : BoundedFace W (N + 1) => boundedFaceSource E x d c) c
  let L := stageRelationLeft E x a d (N + 1)
  let R := stageRelationRight E x d (N + 1)
  let q := successorProfilesDesc E x a d N s
  let n := normalizedMarkedFaceContraction E x a d P
  let f := profileDegreeSummandCofan E x S
  let i := stageDegreeι E x d (N + 1) k hk
  let a0 := (degreeToTop E x d c.degree).app c.word
  let q0 := colimit.ι (degreeTopTensorDiagram E x d c.degree) c.word
  let t := a0 ≫ q0
  let i' := stageDegreeι E x d (N + 1) c.degree c.bound
  let l := successorDegreeTarget E x a d N s k hk
  let l' := successorDegreeTarget E x a d N s c.degree c.bound
  have hL : j ≫ L = n ≫ f ≫ i := Limits.Sigma.ι_comp_desc _ _
  have hR0 : j ≫ R = a0 ≫ q0 ≫ i' := Limits.Sigma.ι_comp_desc _ _
  have hR : j ≫ R = t ≫ i' := hR0.trans (Category.assoc a0 q0 i').symm
  have hi : i ≫ q = l := stageDegreeι_successorProfilesDesc E x a d N s k hk
  have hi' : i' ≫ q = l' := stageDegreeι_successorProfilesDesc E x a d N s c.degree c.bound
  have he : n ≫ f ≫ l = t ≫ l' :=
    (successorTarget_relation E x a d N s c).trans (Category.assoc a0 q0 l').symm
  exact AttachmentSource116_relationPost j L R q n f i t i' l l' hL hR hi hi' he


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
end AttachmentSource116


section AttachmentSource117


/-!
## Genuine successor pushouts of the original balanced degree boundary arrows
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

open CategoryTheory Limits MonoidalCategory Enveloping

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance continuationSuccessorPushoutFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance continuationSuccessorPushoutSlots : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance continuationSuccessorPushoutProfiles (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance continuationSuccessorPushoutFiniteColimits : HasColimitsOfSize.{0, 0} C where
  has_colimits_of_shape J := HasColimitsOfShape.of_essentiallySmall C J
local instance continuationSuccessorPushoutDegreeColimits (n : ℕ) : HasColimitsOfShape (DegreeMarkedInputs W n) C :=
  HasColimitsOfShape.of_essentiallySmall C _

/-- The actual target successor cocone descends through every original
stage relation; the universal map is constructed from the genuine coequalizer. -/
def successorDesc (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom) :
    stage E x a d (N + 1) ⟶ s.pt :=
  coequalizer.desc (successorProfilesDesc E x a d N s) (successorProfilesDesc_relations E x a d N s)

@[reassoc (attr := simp)]
theorem successorDesc_degree (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (j : ℕ) (hj : j ≤ N + 1) :
    stageDegreeLeg E x a d (N + 1) j hj ≫ successorDesc E x a d N s =
      successorDegreeTarget E x a d N s j hj := by
  let i := stageDegreeι E x d (N + 1) j hj
  let L := stageRelationLeft E x a d (N + 1)
  let R := stageRelationRight E x d (N + 1)
  let q := successorDesc E x a d N s
  exact (Category.assoc i (coequalizer.π L R) q).trans
    ((congrArg (i ≫ ·) (coequalizer.π_desc _ _)).trans (stageDegreeι_successorProfilesDesc E x a d N s j hj))

theorem successorDesc_old (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom) :
    stageMap E x a d (Nat.le_succ N) ≫ successorDesc E x a d N s = s.inl := by
  apply stage_hom_ext E x a d N
  intro j hj
  let l := stageDegreeLeg E x a d N j hj
  let m := stageMap E x a d (Nat.le_succ N)
  let q := successorDesc E x a d N s
  exact (Category.assoc l m q).symm.trans
    ((congrArg (· ≫ q) (stageDegreeLeg_map E x a d (Nat.le_succ N) j hj)).trans
      ((successorDesc_degree E x a d N s j (hj.trans (Nat.le_succ N))).trans
        (successorDegreeTarget_old E x a d N s j hj)))

theorem successorDesc_new (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom) :
    stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _) ≫ successorDesc E x a d N s = s.inr :=
  (successorDesc_degree E x a d N s (N + 1) (Nat.le_refl _)).trans (successorDegreeTarget_new E x a d N s)

theorem successorDesc_unique (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ)
    (s : PushoutCocone (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom)
    (p : stage E x a d (N + 1) ⟶ s.pt)
    (ho : stageMap E x a d (Nat.le_succ N) ≫ p = s.inl)
    (hn : stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _) ≫ p = s.inr) :
    p = successorDesc E x a d N s := by
  apply stage_hom_ext E x a d (N + 1)
  intro j hj
  by_cases h : j ≤ N
  · let l := stageDegreeLeg E x a d N j h
    let m := stageMap E x a d (Nat.le_succ N)
    have hp : stageDegreeLeg E x a d (N + 1) j hj ≫ p = l ≫ s.inl :=
      (congrArg (· ≫ p) (stageDegreeLeg_map E x a d (Nat.le_succ N) j h).symm).trans
        ((Category.assoc l m p).trans (congrArg (l ≫ ·) ho))
    have hq : stageDegreeLeg E x a d (N + 1) j hj ≫ successorDesc E x a d N s = l ≫ s.inl :=
      (successorDesc_degree E x a d N s j hj).trans (successorDegreeTarget_old E x a d N s j h)
    exact hp.trans hq.symm
  · have he : j = N + 1 := Nat.le_antisymm hj (Nat.succ_le_of_lt (Nat.lt_of_not_ge h))
    subst j
    exact hn.trans (successorDesc_new E x a d N s).symm

/-- The entire original balanced degree boundary has the genuine successor
pushout universal property at the constructed original stage/cofan square. -/
def successorCoconeIsColimit (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    IsColimit (successorCocone E x a d N) :=
  PushoutCocone.IsColimit.mk (successorSquare E x a d N) (successorDesc E x a d N)
    (successorDesc_old E x a d N) (successorDesc_new E x a d N) (successorDesc_unique E x a d N)

theorem successorIsPushout (E : ColoredOperadObj W C) {X Xprime : W → C}
    (x : X ⟶ Xprime) (a : freeAlgebra E X ⟶ initialAlgebra E) (d : W) (N : ℕ) :
    IsPushout (attachingMap E x a d N) (degreeBalancedArrow E x d (N + 1)).hom
      (stageMap E x a d (Nat.le_succ N))
      (stageDegreeLeg E x a d (N + 1) (N + 1) (Nat.le_refl _)) :=
  IsPushout.of_isColimit (successorCoconeIsColimit E x a d N)


end CategoryTheory.Operad.Tensor.InitialAttachment.Continuation

end
