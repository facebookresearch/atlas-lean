namespace CategoryTheory.Operad.Tensor.InitialAttachment.ProfileCells

open CategoryTheory Limits MonoidalCategory
attribute [local instance] FintypeCat.fintype

variable {W : Type uc}

/-- The original profile input-set top uses the original FintypeCat
finite enumeration; its equality with the degree Fin-set top is proved. -/
def canonicalInputUniv (n : ℕ) : Finset (Fin n) :=
  @Finset.univ (Fin n) (@FintypeCat.fintype (FintypeCat.of (Fin n)))

theorem canonicalInputUniv_eq (n : ℕ) : canonicalInputUniv n = Finset.univ := by
  classical
  apply Finset.ext
  intro i
  simp only [canonicalInputUniv, Finset.mem_univ]

/-- The representative full category map uses the literal original marked
morphism on each original input and coordinate. -/
def representativeFullCubeFunctor (d : W) {n : ℕ} (s : ProfileClass W n) :
    RepresentativeCube s ⥤ FullProfileCube (representativeProfile d s) where
  obj S := S
  map f := InducedCategory.homMk f.hom.hom
  map_id _ := InducedCategory.hom_ext rfl
  map_comp _ _ := InducedCategory.hom_ext rfl

instance representativeFullCubeFull (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullCubeFunctor d s).Full where
  map_surjective f := ⟨InducedCategory.homMk (InducedCategory.homMk f.hom), rfl⟩

instance representativeFullCubeFaithful (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullCubeFunctor d s).Faithful where
  map_injective h := InducedCategory.hom_ext
    (InducedCategory.hom_ext (congrArg (fun k => k.hom) h))

instance representativeFullCubeEssSurj (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullCubeFunctor d s).EssSurj where
  mem_essImage S := ⟨S, ⟨Iso.refl S⟩⟩

instance representativeFullCubeIsEquivalence (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullCubeFunctor d s).IsEquivalence where

/-- The proper original input set has the proved original top correction. -/
def toOriginalProperSet {n : ℕ} (s : ProfileClass W n) (d : W)
    (S : RepresentativePunctured s) : ProfilePuncturedInputSets (representativeProfile d s) :=
  ⟨S.1, fun h => S.2 (h.trans (canonicalInputUniv_eq n))⟩

/-- Regard a proper actual-input subset of a representative profile as a punctured cube vertex. -/
def fromOriginalProperSet {n : ℕ} (s : ProfileClass W n) (d : W)
    (S : ProfilePuncturedInputSets (representativeProfile d s)) : RepresentativePunctured s :=
  ⟨S.1, fun h => S.2 (h.trans (canonicalInputUniv_eq n).symm)⟩

/-- Both original proper-face categories retain exactly the same actual
marked maps after the genuine finite input-top correction. -/
def representativeFullPuncturedFunctor (d : W) {n : ℕ} (s : ProfileClass W n) :
    RepresentativePunctured s ⥤ FullProfilePunctured (representativeProfile d s) where
  obj := toOriginalProperSet s d
  map f := InducedCategory.homMk (InducedCategory.homMk f.hom.hom.hom)
  map_id _ := InducedCategory.hom_ext (InducedCategory.hom_ext rfl)
  map_comp _ _ := InducedCategory.hom_ext (InducedCategory.hom_ext rfl)

instance representativeFullPuncturedFull (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullPuncturedFunctor d s).Full where
  map_surjective f := ⟨InducedCategory.homMk (InducedCategory.homMk
    (InducedCategory.homMk f.hom.hom)), rfl⟩

instance representativeFullPuncturedFaithful (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullPuncturedFunctor d s).Faithful where
  map_injective h := InducedCategory.hom_ext (InducedCategory.hom_ext
    (InducedCategory.hom_ext (congrArg (fun k => k.hom.hom) h)))

instance representativeFullPuncturedEssSurj (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullPuncturedFunctor d s).EssSurj where
  mem_essImage S := ⟨fromOriginalProperSet s d S, ⟨Iso.refl S⟩⟩

instance representativeFullPuncturedIsEquivalence (d : W) {n : ℕ} (s : ProfileClass W n) :
    (representativeFullPuncturedFunctor d s).IsEquivalence where


