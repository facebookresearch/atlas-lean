namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem mapThreeBranchB {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem prefixRelabelBranch {D : Type*} [Category* D] {A B C E F G H : D}
    (p : A ⟶ B) (b : B ⟶ C) (c : C ⟶ H) (r : B ⟶ E)
    (a : A ⟶ F) (p' : F ⟶ E) (g : E ⟶ G) (h : G ⟶ H)
    (hs : b ≫ c = r ≫ g ≫ h) (hp : p ≫ r = a ≫ p') :
    (p ≫ b) ≫ c = a ≫ p' ≫ g ≫ h := by
  calc
    (p ≫ b) ≫ c = p ≫ (b ≫ c) := Category.assoc p b c
    _ = p ≫ (r ≫ g ≫ h) := congrArg (p ≫ ·) hs
    _ = (p ≫ r) ≫ g ≫ h := by simp only [Category.assoc]
    _ = (a ≫ p') ≫ g ≫ h := congrArg (· ≫ g ≫ h) hp
    _ = a ≫ p' ≫ g ≫ h := by simp only [Category.assoc]

private theorem groupingBranchB {D : Type*} [Category* D] {K A B C E F G H : D}
    (a : K ⟶ A) (p : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (z : E ⟶ F)
    (u : C ⟶ G) (m : G ⟶ F) (n : A ⟶ H) (l : H ⟶ G)
    (hd : p ≫ g ≫ u = n ≫ l) (hi : h ≫ z = u ≫ m) :
    (a ≫ p ≫ g ≫ h) ≫ z = a ≫ n ≫ l ≫ m := by
  calc
    (a ≫ p ≫ g ≫ h) ≫ z = a ≫ p ≫ g ≫ (h ≫ z) := by simp only [Category.assoc]
    _ = a ≫ p ≫ g ≫ (u ≫ m) := congrArg (a ≫ p ≫ g ≫ ·) hi
    _ = a ≫ (p ≫ g ≫ u) ≫ m := by simp only [Category.assoc]
    _ = a ≫ (n ≫ l) ≫ m := congrArg (fun h => a ≫ h ≫ m) hd
    _ = a ≫ n ≫ l ≫ m := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original E-association permutation retains the exact original
total variables, root constants, branch constants and global unit maps. -/
theorem expandedSource_afterRelabel (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    expandedSource E s Q ≫ (FiniteTensor.tensor (V := C)).map
      (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData s Q)) =
    (FiniteTensor.tensor (V := C)).map (rawSourceIsoB E.toCollection s Q).hom ≫
      (frozenVariableTensorUnitIso (unitIndex s Q) ((FiniteFamily.flatten (C :=
        C)).obj (rawGroupsB E.toCollection s
        Q))).hom ≫
      (FiniteTensor.tensor (V := C)).map (globalUnitMapB E s Q) ≫
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C :=
          C)).map (groupingIsoB E.toCollection s Q).hom)
          := by
  let T := FiniteTensor.tensor (V := C)
  let p := (frozenVariableTensorUnitIso (unitIndex s Q) (rawFactors E.toCollection s Q)).hom
  let b := T.map (globalUnitMapA E s Q)
  let c := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection
    (assocData s Q))
  let r := T.map (Variable.unitFamilyMap (Equiv.refl (unitIndex s Q)) (rawSourceIsoB
    E.toCollection s Q).hom)
  let a := T.map (rawSourceIsoB E.toCollection s Q).hom
  let p' := (frozenVariableTensorUnitIso (unitIndex s Q) ((FiniteFamily.flatten (C :=
    C)).obj (rawGroupsB E.toCollection
    s Q))).hom
  let g := T.map (globalUnitMapB E s Q)
  let h := T.map ((FiniteFamily.flatten (C := C)).map (groupingIsoB E.toCollection s Q).hom)
  have hs : b ≫ c = r ≫ g ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (globalUnitMap_relabel E s Q).symm).trans (mapThreeBranchB T _ _ _))
  have hp : p ≫ r = a ≫ p' :=
    (Variable.tensorUnitIso_naturality (Equiv.refl (unitIndex s Q)) (rawSourceIsoB
      E.toCollection s Q).hom).symm
  exact prefixRelabelBranch p b c r a p' g h hs hp

/-- Genuine tensor block distribution gives precisely the original root
prefix, each surviving variable unit, and every unchanged constant block. -/
theorem expandedSource_groupedB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    expandedSource E s Q ≫ (FiniteTensor.tensor (V := C)).map
      (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData s Q)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (ColoredOperadObj.AssocInsertion.groupingB
        E.toCollection (assocData s
        Q)) =
    (FiniteTensor.tensor (V := C)).map (rawSourceIsoB E.toCollection s Q).hom ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q) ≫
      (FiniteTensor.tensor (V := C)).map (appliedMapB E s Q) ≫
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.map (FiniteTensor.tensor (V :=
          C))).map (groupingIsoB
          E.toCollection s Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (rawSourceIsoB E.toCollection s Q).hom
  let p := (frozenVariableTensorUnitIso (unitIndex s Q) ((FiniteFamily.flatten (C :=
    C)).obj (rawGroupsB E.toCollection
    s Q))).hom
  let g := T.map (globalUnitMapB E s Q)
  let h := T.map ((FiniteFamily.flatten (C := C)).map (groupingIsoB E.toCollection s Q).hom)
  let z := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection
    (assocData s Q))
  let u := (FiniteTensor.flattenIso (V := C)).hom.app (correctedGroupsB E.toCollection s Q)
  let m := T.map ((FiniteFamily.map T).map (groupingIsoB E.toCollection s Q).hom)
  let n := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q)
  let l := T.map (appliedMapB E s Q)
  have hd : p ≫ g ≫ u = n ≫ l := Root.semanticUnitBlock_applied (unitIndex s Q)
    (rawGroupsB E.toCollection s Q)
    (unitPositionsB E.toCollection s Q) (correctedGroupsB E.toCollection s Q).obj
      (localUnitMapB E s Q)
      (unitPositionEquivB E.toCollection s Q)
  have hi : h ≫ z = u ≫ m := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (groupingIsoB E.toCollection s Q).hom
  exact (Category.assoc (expandedSource E s Q)
    (T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData
      s Q))) z).symm.trans
      ((congrArg (· ≫ z) (expandedSource_afterRelabel E s Q)).trans (groupingBranchB a p
        g h z u m n l hd hi))


