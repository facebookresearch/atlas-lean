      p ≫ (frozenVariableTensorUnitIso (extendProfile P Q).inputs L).hom ≫ T.map (pos ≫ w) :=
    reindexFusedMap p k (T.map c) (T.map pos) (T.map w) (T.map (c ≫ pos))
      (frozenVariableTensorUnitIso (extendProfile P Q).inputs L).hom (T.map (pos ≫ w))
      (T.map_comp c pos) hk (T.map_comp pos w)
  exact h1.trans (h0.trans (h2.trans (Unit.rightUnitInsertion_normalized O (extendProfile P
    Q)).symm))

/-- The pure original right representative coefficient unit equation,
with both original total-profile maps and all P/Q inputs retained. -/
theorem rightRepresentativeCoefficient_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    rightUnitCoefficientInsertion O P Q ≫
        envelopingRepresentativeCoefficientSubstitution O (ColoredSubstitutionData.rightUnit
          P) (rightUnitChoices P Q) ≫
        O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
          (rightUnitInputsIso P Q).hom)
          =
      𝟙 (O.toCollection.obj (extendProfile P Q)) := by
  let i := rightUnitCoefficientInsertion O P Q
  let a := envelopingRepresentativeCoefficientTensorMap O (ColoredSubstitutionData.rightUnit
    P) (rightUnitChoices P Q)
  let s := O.subst.app (envelopingRepresentativeSubstitution
    (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P
    Q))
  let t := O.toCollection.map (envelopingRepresentativeTotalHom
    (ColoredSubstitutionData.rightUnit P) (rightUnitChoices
    P Q))
  let r := O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom
    P) (rightUnitInputsIso P
    Q).hom)
  let f := rightToExtendedUnit P Q
  let h := (ColoredOperadObj.substitutionSource O.toCollection).map f
  let s' := O.subst.app (ColoredSubstitutionData.rightUnit (extendProfile P Q))
  let k := O.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom (extendProfile P Q))
  let q := O.toCollection.map (ColoredSubstitutionData.totalProfileMap f)
  let j := ColoredOperadObj.rightUnitInsert O.toCollection O.unit (extendProfile P Q)
  have hi : i ≫ a ≫ h = j := rightCoefficientInsertion_unit O P Q
  have hs : s ≫ q = h ≫ s' := (O.subst.naturality f).symm
  have ht : t ≫ r = q ≫ k := (O.toCollection.map_comp _ _).symm.trans
    ((congrArg O.toCollection.map (rightToExtendedUnit_total P Q)).trans
      (O.toCollection.map_comp _ _))
  exact (evaluateInsertionSquares i a s t r h s' k q j hi hs ht).trans (O.right_unit
    (extendProfile P Q))


