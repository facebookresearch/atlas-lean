/- Exact checked source: WeightedNormalization.OriginalInclusionEmptyEvaluation. -/
section EnvelopingSource248


/-!
# Exact original operation evaluation on the all-empty linear representative
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

open CategoryTheory

private theorem normalizeEmptyEval {D : Type*} [Category* D] {A B C E F G : D}
    (w : A ⟶ B) (i : B ⟶ C) (e : C ⟶ E) (p : E ⟶ F)
    (i₀ : A ⟶ G) (n : G ⟶ C) (h : G ⟶ F)
    (hi : w ≫ i = i₀ ≫ n) (hh : n ≫ e ≫ p = h) :
    (w ≫ (i ≫ e)) ≫ p = i₀ ≫ h := by
  calc
    (w ≫ (i ≫ e)) ≫ p = (w ≫ i) ≫ e ≫ p := by simp only [Category.assoc]
    _ = (i₀ ≫ n) ≫ e ≫ p := congrArg (fun f => f ≫ e ≫ p) hi
    _ = i₀ ≫ h := by simpa only [Category.assoc] using congrArg (i₀ ≫ ·) hh

private theorem contractEmptyCoefficient {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F)
    (e : A ≅ C) (r : A ⟶ F) (hab : a ≫ b = e.hom) (hcd : c ≫ d = e.inv ≫ r) :
    (a ≫ (b ≫ c)) ≫ d = r := by
  calc
    (a ≫ (b ≫ c)) ≫ d = (a ≫ b) ≫ (c ≫ d) := by simp only [Category.assoc]
    _ = e.hom ≫ (e.inv ≫ r) := congrArg₂ (· ≫ ·) hab hcd
    _ = r := by rw [← Category.assoc, e.hom_inv_id, Category.id_comp]

private theorem reassociateEmptyLeaves {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    a ≫ b ≫ (c ≫ d) = ((a ≫ b) ≫ c) ≫ d := by simp only [Category.assoc]

private theorem insertEmptyThenMap {D : Type*} [Category* D] {A B C E F G : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F)
    (n : C ⟶ G) (e : G ⟶ A) (f : A ⟶ F)
    (hc : c ≫ d = (n ≫ e) ≫ f) (hi : a ≫ (b ≫ n) ≫ e = 𝟙 A) :
    a ≫ b ≫ c ≫ d = f := by
  calc
    a ≫ b ≫ c ≫ d = a ≫ b ≫ ((n ≫ e) ≫ f) := congrArg (a ≫ b ≫ ·) hc
    _ = (a ≫ (b ≫ n) ≫ e) ≫ f := by simp only [Category.assoc]
    _ = f := (congrArg (· ≫ f) hi).trans (Category.id_comp f)

private theorem applyNormalizedEmpty {D : Type*} [Category* D] {A B C E F G H : D}
    (a : A ⟶ B) (w : B ⟶ C) (e : C ⟶ E) (p : E ⟶ F) (u : F ⟶ G)
    (i : B ⟶ H) (f : H ⟶ F) (h : (w ≫ e) ≫ p = i ≫ f) :
    (a ≫ w) ≫ e ≫ p ≫ u = a ≫ i ≫ f ≫ u := by
  calc
    (a ≫ w) ≫ e ≫ p ≫ u = a ≫ ((w ≫ e) ≫ p) ≫ u := by simp only [Category.assoc]
    _ = a ≫ (i ≫ f) ≫ u := congrArg (fun h => a ≫ h ≫ u) h
    _ = a ≫ i ≫ f ≫ u := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The full original all-empty interchange carries an arbitrary
original coefficient evaluation to that evaluation itself. -/
theorem noLeafInterchange_map (K : FiniteFamily C) {Y : C}
    (f : (FiniteTensor.tensor (V := C)).obj K ⟶ Y) :
    (FiniteTensor.tensor (V := C)).map (emptySlotInputMap K) ≫
      (coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
        (FiniteFamily.empty : FiniteFamily C))).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap f (emptyTotalLeavesIso K.index).hom) ≫
        (emptyLeafTensorIso Y).hom = f := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (emptySlotInputMap K)
  let b := (coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
    (FiniteFamily.empty : FiniteFamily C))).hom
  let c := T.map (coefficientLeafMap f (emptyTotalLeavesIso K.index).hom)
  let d := (emptyLeafTensorIso Y).hom
  let n := T.map (coefficientLeafMap (𝟙 (T.obj K)) (emptyTotalLeavesIso K.index).hom)
  let e := (emptyLeafTensorIso (T.obj K)).hom
  exact insertEmptyThenMap a b c d n e f (collapseEmptyLeafMap f (emptyTotalLeavesIso K.index).hom)
    (noLeafInterchange_unit K)

variable {W : Type u}

/-- The actual original empty representative evaluation has the
literal original O-substitution and the exact original empty input correction. -/
theorem slotWeightedEvaluation_normalized (O : ColoredOperadObj W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    ((FiniteTensor.tensor (V := C)).map (slotWeightedMap O.toCollection B s) ≫
        envelopingRepresentativeEvaluation O B s (choices s)) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (O.toCollection.map
        (totalProfileHom s))
        ((addedAlgebraInputs B).map (totalInputsIso s).hom ≫ (emptyAddedAlgebraInputsIso B).hom)) =
      (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
        ((ColoredOperadObj.substitutionFactors O.toCollection).obj s).obj
        (fun _ => (FiniteFamily.empty : FiniteFamily C))).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (O.subst.app s)
          (emptyTotalLeavesIso (FintypeCat.of (Option s.inner.index))).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option s.inner.index)
  let K := (ColoredOperadObj.substitutionFactors O.toCollection).obj s
  let K' := coefficientBlockFamily I (fun i => O.toCollection.obj (extendProfile
    (envelopingSlotProfile s i) (choices s
    i)))
  let L := fun _ : I => (FiniteFamily.empty : FiniteFamily C)
  let L' := fun i => (addedAlgebraInputs B).obj (choices s i)
  let c := (slotCoefficientIso O.toCollection s).hom
  let ℓ := (slotLeavesIso B s).hom
  let w := T.map (slotWeightedMap O.toCollection B s)
  let i := (coefficientBlockInterchangeTensorIso I K'.obj L').hom
  let i₀ := (coefficientBlockInterchangeTensorIso I K.obj L).hom
  let leaf := (FiniteFamily.flatten (C := C)).map ℓ
  let n := T.map (coefficientLeafMap (T.map c) leaf)
  let a := (envelopingCoefficientBlockIso O.toCollection s (choices s)).hom
  let b := envelopingRepresentativeCoefficientSubstitution O s (choices s)
  let l := (envelopingAlgebraLeafIso B s (choices s)).hom
  let e := T.map (coefficientLeafMap (T.map a ≫ b) l)
  let h := O.toCollection.map (totalProfileHom s)
  let g := (addedAlgebraInputs B).map (totalInputsIso s).hom ≫ (emptyAddedAlgebraInputsIso B).hom
  let p := T.map (coefficientLeafMap h g)
  let fin := T.map (coefficientLeafMap (O.subst.app s) (emptyTotalLeavesIso I).hom)
  have hc : coefficientBlockMap I c.hom = c := rfl
  have hℓ : inputBlockMap I ℓ.hom = ℓ := rfl
  have hn : w ≫ i = i₀ ≫ n :=
    (coefficientBlockInterchangeTensorIso_naturality I c.hom ℓ.hom).trans
      (congrArg₂ (fun c l => i₀ ≫ T.map (coefficientLeafMap (T.map c)
        ((FiniteFamily.flatten (C := C)).map l))) hc hℓ)
  let z := (T.mapIso (coefficientIso O.toCollection s)).symm
  have hi : T.map c ≫ T.map a = z.hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map (slotCoefficientIso_compare O.toCollection s))
  have hb : b ≫ h = z.inv ≫ O.subst.app s :=
    (representativeCoefficient O s).trans
      (congrArg (fun a => T.map a ≫ O.subst.app s) (coefficientIso_hom O.toCollection s).symm)
  have hcoef : (T.map c ≫ (T.map a ≫ b)) ≫ h = O.subst.app s :=
    contractEmptyCoefficient (T.map c) (T.map a) b h z (O.subst.app s) hi hb
  have hleaf : (leaf ≫ l) ≫ g = (emptyTotalLeavesIso I).hom :=
    (Category.assoc leaf l g).trans ((reassociateEmptyLeaves leaf l
      ((addedAlgebraInputs B).map (totalInputsIso s).hom) (emptyAddedAlgebraInputsIso B).hom).trans
        (slotLeavesIso_compare B s))
  have hfamily : coefficientLeafMap (T.map c) leaf ≫ coefficientLeafMap (T.map a ≫ b) l ≫
      coefficientLeafMap h g = coefficientLeafMap (O.subst.app s) (emptyTotalLeavesIso I).hom :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ coefficientLeafMap h g) (coefficientLeafMap_comp _ _ _ _)).trans
        ((coefficientLeafMap_comp _ _ _ _).trans
          (congrArg₂ (fun c l => coefficientLeafMap c l) hcoef hleaf)))
  have hf : n ≫ e ≫ p = fin :=
    (congrArg (n ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans (congrArg T.map hfamily))
  exact normalizeEmptyEval w i e p i₀ n fin hn hf

/-- Insert the literal original coefficient tensor at every empty
summand, perform the literal representative substitution, and compare the
output through its actual original empty summand. The result is original substitution. -/
theorem sourceInsertion_evaluation (O : ColoredOperadObj W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    (FiniteTensor.tensor (V := C)).map (sourceInsertion O.toCollection B s) ≫
      envelopingRepresentativeEvaluation O B s (choices s) ≫
      (linearCoefficientDiagram O.toCollection B s.totalProfile).map (totalInputsIso s).hom ≫
        (emptyLinearSummandIso O.toCollection B s.totalProfile).hom = O.subst.app s := by
  let T := FiniteTensor.tensor (V := C)
  let K := (ColoredOperadObj.substitutionFactors O.toCollection).obj s
  let a := T.map (emptySlotInputMap K)
  let w := T.map (slotWeightedMap O.toCollection B s)
  let e := envelopingRepresentativeEvaluation O B s (choices s)
  let q := (linearCoefficientDiagram O.toCollection B s.totalProfile).map (totalInputsIso s).hom
  let z := (emptyLinearSummandIso O.toCollection B s.totalProfile).hom
  let p := T.map (coefficientLeafMap (O.toCollection.map (totalProfileHom s))
    ((addedAlgebraInputs B).map (totalInputsIso s).hom ≫ (emptyAddedAlgebraInputsIso B).hom))
  let u := (emptyLeafTensorIso (O.toCollection.obj s.totalProfile)).hom
  let i₀ := (coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
    (FiniteFamily.empty : FiniteFamily C))).hom
  let f := T.map (coefficientLeafMap (O.subst.app s) (emptyTotalLeavesIso K.index).hom)
  have ha : T.map (sourceInsertion O.toCollection B s) = a ≫ w :=
    (congrArg T.map (sourceInsertion_factor O.toCollection B s).symm).trans (T.map_comp _ _)
  have hp : q ≫ z = p ≫ u := outputComparison O.toCollection B s
  have hn : (w ≫ e) ≫ p = i₀ ≫ f := slotWeightedEvaluation_normalized O B s
  have h : (a ≫ w) ≫ e ≫ p ≫ u = a ≫ i₀ ≫ f ≫ u :=
    applyNormalizedEmpty a w e p u i₀ f hn
  exact (congrArg (· ≫ e ≫ q ≫ z) ha).trans
    ((congrArg ((a ≫ w) ≫ e ≫ ·) hp).trans (h.trans (noLeafInterchange_map K (O.subst.app s))))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

end
