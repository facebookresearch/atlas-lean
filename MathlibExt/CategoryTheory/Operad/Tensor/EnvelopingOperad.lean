the actual extended O-substitution, retaining each dependent input. -/
def evaluationLeafEquiv (B M : W → C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    (evaluationLeafFamily B M s Q).index ≃ (envelopingRepresentativeSubstitution s
      Q).totalProfile.inputs where
  toFun p := match p with
    | Sum.inl (Sum.inl j) => ⟨Sum.inr j, PUnit.unit⟩
    | Sum.inl (Sum.inr ⟨i, j⟩) => ⟨Sum.inl i, Sum.inr j⟩
    | Sum.inr ⟨i, j⟩ => ⟨Sum.inl i, Sum.inl j⟩
  invFun p := match p with
    | ⟨Sum.inl i, Sum.inl j⟩ => Sum.inr ⟨i, j⟩
    | ⟨Sum.inl i, Sum.inr j⟩ => Sum.inl (Sum.inr ⟨i, j⟩)
    | ⟨Sum.inr j, _⟩ => Sum.inl (Sum.inl j)
