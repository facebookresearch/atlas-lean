/- Exact checked source: ReflexiveOperad.Collection. -/
section EnvelopingSource331


/-!
# The original pointwise coequalizer collection

This construction retains the coequalizer of the two original profile
components and its original projection, including nullary profiles.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C]

local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)

/-- The actual coequalizer of the original two collection components. -/
abbrev coefficient (s : ColoredProfile W) : C :=
  coequalizer (f.toCollectionHom.app s) (g.toCollectionHom.app s)

/-- Its original coequalizer projection. -/
abbrev coefficientπ (s : ColoredProfile W) : Q.toCollection.obj s ⟶ coefficient f g s :=
  coequalizer.π (f.toCollectionHom.app s) (g.toCollectionHom.app s)

@[reassoc]
theorem coefficient_condition (s : ColoredProfile W) :
    f.toCollectionHom.app s ≫ coefficientπ f g s =
      g.toCollectionHom.app s ≫ coefficientπ f g s :=
  coequalizer.condition _ _

/-- Profile transport descends the original target collection map. -/
def coefficientMap {s r : ColoredProfile W} (k : s ⟶ r) :
    coefficient f g s ⟶ coefficient f g r :=
  coequalizer.desc (Q.toCollection.map k ≫ coefficientπ f g r) (by
    rw [← Category.assoc, ← f.toCollectionHom.naturality k,
      ← Category.assoc, ← g.toCollectionHom.naturality k]
    simp only [Category.assoc]
    rw [coefficient_condition])

@[reassoc (attr := simp)]
theorem coefficientπ_map {s r : ColoredProfile W} (k : s ⟶ r) :
    coefficientπ f g s ≫ coefficientMap f g k =
      Q.toCollection.map k ≫ coefficientπ f g r :=
  coequalizer.π_desc _ _

/-- The quotient symmetric collection with precisely the original
pointwise coequalizer coefficients. -/
def collection : ColoredSymmetricCollection W C where
  obj := coefficient f g
  map := coefficientMap f g
  map_id s := by
    apply coequalizer.hom_ext
    simp
  map_comp k l := by
    apply coequalizer.hom_ext
    simp [Category.assoc]

/-- The original coefficient projections form a natural transformation. -/
def collectionπ : Q.toCollection ⟶ collection f g where
  app := coefficientπ f g
  naturality _s _r k := (coefficientπ_map f g k).symm

@[simp]
theorem collectionπ_app (s : ColoredProfile W) :
    (collectionπ f g).app s = coefficientπ f g s := rfl

theorem collection_condition :
    f.toCollectionHom ≫ collectionπ f g = g.toCollectionHom ≫ collectionπ f g := by
  ext s
  exact coefficient_condition f g s

/-- Every coequalizing collection map has its actual pointwise descent. -/
def collectionDesc {S : ColoredSymmetricCollection W C} (h : Q.toCollection ⟶ S)
    (balance : f.toCollectionHom ≫ h = g.toCollectionHom ≫ h) : collection f g ⟶ S where
  app s := coequalizer.desc (h.app s) (congrArg (fun a => a.app s) balance)
  naturality s r k := by
    apply coequalizer.hom_ext
    change coefficientπ f g s ≫ (coefficientMap f g k ≫ coequalizer.desc (h.app r) _) =
      coefficientπ f g s ≫ (coequalizer.desc (h.app s) _ ≫ S.map k)
    rw [← Category.assoc, coefficientπ_map, Category.assoc, coequalizer.π_desc,
      ← Category.assoc, coequalizer.π_desc]
    exact h.naturality k

@[reassoc]
theorem collectionπ_desc_app {S : ColoredSymmetricCollection W C} (h : Q.toCollection ⟶ S)
    (balance : f.toCollectionHom ≫ h = g.toCollectionHom ≫ h) (s : ColoredProfile W) :
    coefficientπ f g s ≫ (collectionDesc f g h balance).app s = h.app s :=
  coequalizer.π_desc _ _

@[simp]
theorem collectionπ_desc {S : ColoredSymmetricCollection W C} (h : Q.toCollection ⟶ S)
    (balance : f.toCollectionHom ≫ h = g.toCollectionHom ≫ h) :
    collectionπ f g ≫ collectionDesc f g h balance = h := by
  ext s
  exact collectionπ_desc_app f g h balance s

theorem collection_hom_ext {S : ColoredSymmetricCollection W C}
    {h k : collection f g ⟶ S} (eq : collectionπ f g ≫ h = collectionπ f g ≫ k) : h = k := by
  ext s
  exact coequalizer.hom_ext (congrArg (fun a => a.app s) eq)

omit [HasColimitsOfSize.{us, us} C] in
/-- The original common section specializes to each original profile. -/
theorem section_left (t : Q ⟶ P) (ht : t ≫ f = 𝟙 Q) (s : ColoredProfile W) :
    t.toCollectionHom.app s ≫ f.toCollectionHom.app s = 𝟙 (Q.toCollection.obj s) :=
  congrArg (fun a => a.toCollectionHom.app s) ht

omit [HasColimitsOfSize.{us, us} C] in
/-- The second section equation retains the original second relation. -/
theorem section_right (t : Q ⟶ P) (ht : t ≫ g = 𝟙 Q) (s : ColoredProfile W) :
    t.toCollectionHom.app s ≫ g.toCollectionHom.app s = 𝟙 (Q.toCollection.obj s) :=
