section EnvelopingSource276


/-!
# Literal coefficient and leaf factorization of the supplied constants evaluator
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Map each added algebra-input object to its chosen nullary coefficient in the target operad. -/
def addedValueMap {E : ColoredOperadObj W C} (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (Q : ColoredInputs W) :
    (addedAlgebraInputs B).obj Q ⟶ (addedAlgebraInputs (Branch.nullaryCarrier
      E.toCollection)).obj Q where
  equiv := Equiv.refl Q.index
  hom i := b (Q.obj i).as

/-- Apply the operad map to the coefficient and the chosen nullary maps to its added leaves. -/
def jointFactors {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile
      W) (Q : ColoredInputs W) :
    (coefficientLeafFamilyFunctor ((addedAlgebraInputs B).obj Q)).obj (O.toCollection.obj
      (extendProfile P Q)) ⟶
      (coefficientLeafFamilyFunctor ((addedAlgebraInputs (Branch.nullaryCarrier
        E.toCollection)).obj Q)).obj
        (E.toCollection.obj (extendProfile P Q)) :=
  coefficientLeafMap (u.toCollectionHom.app (extendProfile P Q)) (addedValueMap B b Q)

/-- The literal supplied root and colorwise constant maps factor through
the target's literal identity constants evaluator at every original input. -/
theorem coefficientMap_factor {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile
      W) (Q : ColoredInputs W) :
    coefficientMap u B b P Q = jointFactors u B b P Q ≫
      coefficientMap (𝟙 E) (Branch.nullaryCarrier E.toCollection) (fun c => 𝟙 (E.toCollection.obj
        (ColoredProfile.nullary c))) P Q := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.comp_id (u.toCollectionHom.app (extendProfile P Q))).symm
    | some i => exact heq_of_eq (Category.comp_id (b (Q.obj i).as)).symm

/-- The literal constants representative preserves the actual supplied
coefficient/input maps, retaining the target's original partial substitution. -/
theorem representative_factor {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile
      W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (jointFactors u B b P Q) ≫
      representative (𝟙 E) (Branch.nullaryCarrier E.toCollection) (fun c => 𝟙 (E.toCollection.obj
        (ColoredProfile.nullary c))) P Q =
        representative u B b P Q := by
  let T := FiniteTensor.tensor (V := C)
  let p := T.map (jointFactors u B b P Q)
  let a := T.map (coefficientMap (𝟙 E) (Branch.nullaryCarrier E.toCollection) (fun c =>
    𝟙 (E.toCollection.obj
    (ColoredProfile.nullary c))) P Q)
  let u' := T.map (coefficientMap u B b P Q)
  let r := frozenPartialSubstitution E P Q (branches Q) ≫ E.toCollection.map (totalProfileHom P Q)
  have h : p ≫ a = u' := (T.map_comp _ _).symm.trans (congrArg T.map
    (coefficientMap_factor u B b P Q).symm)
  exact (Category.assoc p a r).symm.trans (congrArg (· ≫ r) h)

/-- Evaluate each weighted substitution slot using the supplied operad and nullary-input maps. -/
def representativeSlotFamily {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    envelopingWeightedRepresentativeFamily O.toCollection B s Q ⟶
      (ColoredOperadObj.substitutionFactors
      E.toCollection).obj s where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := representative u B b (envelopingSlotProfile s i) (Q i)

/-- Map all weighted coefficient and leaf blocks to the target operad with its nullary carrier. -/
def weightedValueMap {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    envelopingWeightedRepresentativeFamily O.toCollection B s Q ⟶
      envelopingWeightedRepresentativeFamily E.toCollection (Branch.nullaryCarrier
        E.toCollection) s Q :=
  weightedInputBlockMap (FintypeCat.of (Option s.inner.index))
    (K := fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (K' := fun i => E.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (L := fun i => (addedAlgebraInputs B).obj (Q i))
    (L' := fun i => (addedAlgebraInputs (Branch.nullaryCarrier E.toCollection)).obj (Q i))
    (fun i => u.toCollectionHom.app (extendProfile (envelopingSlotProfile s i) (Q i))) (fun
      i => addedValueMap B b (Q
      i))

theorem weightedValueMap_slots {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    weightedValueMap u B b s Q ≫ Branch.Slots.literalSlotFamily E s Q =
      representativeSlotFamily u B b s Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    exact heq_of_eq (representative_factor u B b (envelopingSlotProfile s i) (Q i))

/-- Apply the operad map to the extended coefficient profile at every substitution slot. -/
def slotCoefficients {O E : ColoredOperadObj W C} (u : O ⟶ E) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    coefficientBlockFamily (FintypeCat.of (Option s.inner.index))
      (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i))) ⟶
    coefficientBlockFamily (FintypeCat.of (Option s.inner.index))
      (fun i => E.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i))) :=
  coefficientBlockMap (FintypeCat.of (Option s.inner.index))
    (fun i => u.toCollectionHom.app (extendProfile (envelopingSlotProfile s i) (Q i)))

/-- Apply the chosen nullary maps to the added leaf family at every substitution slot. -/
def leafBlocks {E : ColoredOperadObj W C} (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    inputBlockFamily (FintypeCat.of (Option s.inner.index)) (fun i =>
      (addedAlgebraInputs B).obj (Q i)) ⟶
      inputBlockFamily (FintypeCat.of (Option s.inner.index)) (fun i =>
        (addedAlgebraInputs (Branch.nullaryCarrier
        E.toCollection)).obj (Q i)) :=
  inputBlockMap (FintypeCat.of (Option s.inner.index)) (fun i => addedValueMap B b (Q i))

theorem slotCoefficients_block {O E : ColoredOperadObj W C} (u : O ⟶ E) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    slotCoefficients u s Q ≫ (envelopingCoefficientBlockIso E.toCollection s Q).hom =
      (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
        OperadMap.representativeCoefficientMap u s Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let f := u.toCollectionHom.app (extendProfile s.outerProfile (Q none))
      change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)
    | some i =>
      let f := u.toCollectionHom.app (extendProfile (s.inner.obj i) (Q (some i)))
      change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)

theorem leafBlocks_total {E : ColoredOperadObj W C} (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    (FiniteFamily.flatten (C := C)).map (leafBlocks B b s Q) ≫
      (envelopingAlgebraLeafIso (Branch.nullaryCarrier
      E.toCollection) s Q).hom =
      (envelopingAlgebraLeafIso B s Q).hom ≫ addedValueMap B b
        (envelopingTotalAlgebraInputs s Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      let f := b ((Q none).obj j).as
      change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)
    | some i =>
      let f := b ((Q (some i)).obj j).as
      change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

