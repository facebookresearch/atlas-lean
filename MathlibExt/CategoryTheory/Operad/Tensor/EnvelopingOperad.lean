/- Exact checked source: WeightedNormalization.ConstantExtensionData. -/
section EnvelopingSource210


/-!
# Original tensor evaluator for extending an operad by supplied constants
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

private theorem constantReassociateSource {D : Type*} [Category* D] {A B C E F G : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) (e : F ⟶ G) :
    a ≫ (b ≫ c ≫ d) ≫ e = a ≫ b ≫ c ≫ (d ≫ e) := by simp only [Category.assoc]

variable {W : Type u}

/-- Every original added input is assigned its actual nullary profile
at its original color, with no variable input introduced. -/
def branches (Q : ColoredInputs W) : FrozenBranchTuple Q :=
  fun i => AnalyticIndex.nullary (d := (Q.obj i).as)

/-- The original total input family of the supplied nullary branches
has the exact original empty-index comparison. -/
def totalInputsIso (Q : ColoredInputs W) : frozenTotalInputs Q (branches Q) ≅
  (emptyColoredInputs : ColoredInputs W) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => Fin.elim0 p.2
      invFun := fun i => i.elim
      left_inv := fun p => Fin.elim0 p.2
      right_inv := fun i => i.elim }
    (fun p => Fin.elim0 p.2)

/-- The original variable profile survives the original nullary
total-input contraction through both original empty-profile maps. -/
def totalProfileHom (P : ColoredProfile W) (Q : ColoredInputs W) :
    extendProfile P (frozenTotalInputs Q (branches Q)) ⟶ P :=
  extendProfileMap (𝟙 P) (totalInputsIso Q).hom ≫ emptyExtensionProfileHom P

/-- The complete original nullary substitution shape has exactly
the original variable profile as its total after the actual contraction. -/
def substitutionTotalHom (P : ColoredProfile W) (Q : ColoredInputs W) :
    (frozenSubstitution P Q (branches Q)).totalProfile ⟶ P :=
  frozenTotalProfileHom P Q (branches Q) ≫ totalProfileHom P Q

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root O coefficient uses the actual supplied O→E
map and every original added B input uses its actual supplied nullary
E coefficient map at the same original color and position. -/
def coefficientMap {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientLeafFamilyFunctor ((addedAlgebraInputs B).obj Q)).obj
        (O.toCollection.obj (extendProfile P Q)) ⟶
      frozenCoefficientFamily E.toCollection P Q (branches Q) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => u.toCollectionHom.app (extendProfile P Q)
    | some i => b (Q.obj i).as

/-- The actual original coefficient/input representative is evaluated
by the target operad's original nullary partial substitution, retaining
all original variable units, original tensors and original profile maps. -/
def representative {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientDiagram O.toCollection B P).obj Q ⟶ E.toCollection.obj P :=
  (FiniteTensor.tensor (V := C)).map (coefficientMap u B b P Q) ≫
    frozenPartialSubstitution E P Q (branches Q) ≫ E.toCollection.map (totalProfileHom P Q)

theorem representative_source (O E : ColoredOperadObj W C) (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    representative u B b P Q =
      (FiniteTensor.tensor (V := C)).map (coefficientMap u B b P Q) ≫
        frozenSubstitutionCoefficientTensorMap E P Q (branches Q) ≫
        E.subst.app (frozenSubstitution P Q (branches Q)) ≫
        E.toCollection.map (substitutionTotalHom P Q) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (coefficientMap u B b P Q)
  let i := frozenSubstitutionCoefficientTensorMap E P Q (branches Q)
  let s := E.subst.app (frozenSubstitution P Q (branches Q))
  let t := E.toCollection.map (frozenTotalProfileHom P Q (branches Q))
  let r := E.toCollection.map (totalProfileHom P Q)
  have h : t ≫ r = E.toCollection.map (substitutionTotalHom P Q) :=
    (E.toCollection.map_comp _ _).symm
  have h₀ : representative u B b P Q = a ≫ i ≫ s ≫ (t ≫ r) :=
    constantReassociateSource a i s t r
  exact h₀.trans (congrArg (fun f => a ≫ i ≫ s ≫ f) h)


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource210

/- Exact checked source: ReflexiveOperad.FrozenAlgebraUnit. -/
section EnvelopingSource211


/-!
# Original unary and nullary algebra operations in the actual frozen coefficient frame
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original nullary algebra operation receives its original coefficient
through the actual nullary factor bijection and original tensor singleton inverse. -/
def nullaryEvaluation {E : ColoredOperadObj W C} (M : Algebra E) (c : W) :
    E.toCollection.obj (ColoredProfile.nullary c) ⟶ M.carrier c :=
  (nullarySummandIso E.toCollection M.carrier c).inv ≫ M.operations.app c AnalyticIndex.nullary

/-- Original variable-unit and variable positions in the genuine unary algebra operation. -/
def unaryUnitPositionEquiv : PUnit ⊕ PUnit ≃ Option PUnit where
  toFun i := match i with | Sum.inl _ => none | Sum.inr _ => some PUnit.unit
  invFun i := match i with | none => Sum.inl PUnit.unit | some _ => Sum.inr PUnit.unit
  left_inv i := by cases i with
    | inl i => cases i; rfl
    | inr i => cases i; rfl
  right_inv i := by cases i with
    | none => rfl
    | some i => cases i; rfl

/-- The actual original E unit is the coefficient factor and the
actual original algebra variable remains unchanged in its own unary input slot. -/
def unaryUnitFactor (E : ColoredOperadObj W C) (A : W → C) (c : W) :
    frozenVariableUnitFamily (FintypeCat.of PUnit) ((FiniteFamily.singleton (C := C)).obj (A c)) ⟶
      (analyticFactors (d := c) E.toCollection A).obj (AnalyticIndex.unary (d := c) c) where
  equiv := unaryUnitPositionEquiv
  hom i := match i with
    | Sum.inl _ => E.unit c
    | Sum.inr _ => 𝟙 (A c)

/-- The original right-normalized factor before the original left/right swap. -/
def unaryBareFactor (E : ColoredOperadObj W C) (A : W → C) (c : W) :
    Unit.unitRootFamily (A c) (FintypeCat.of PUnit) ⟶
      (analyticFactors (d := c) E.toCollection A).obj (AnalyticIndex.unary (d := c) c) where
  equiv := Linear.UnitGeometry.unitFlipEquiv
  hom i := match i with
    | none => 𝟙 (A c)
    | some _ => E.unit c

/-- The exact original prefix swap and singleton normalization give
the same original operadic-unit and variable factor maps. -/
theorem unaryBareFactor_compare (E : ColoredOperadObj W C) (A : W → C) (c : W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (Linear.UnitGeometry.leftBlocksIso
      (A c)).hom ≫
      unitFactors E A c =
    Unit.rightRootNormalizer (A c) (FintypeCat.of PUnit) ≫ unaryBareFactor E A c := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let X := A c
        let T := FiniteTensor.tensor (V := C)
        let s := (FiniteTensor.singletonIso (V := C)).hom.app X
        change HEq (T.map (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) ≫ s) (s ≫ 𝟙 X)
        exact heq_of_eq ((congrArg (· ≫ s) (T.map_id _)).trans
          ((Category.id_comp s).trans (Category.comp_id s).symm))
    | some i =>
        let T := FiniteTensor.tensor (V := C)
        let U := T.obj (FiniteFamily.empty : FiniteFamily C)
        change HEq (T.map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ E.unit c) (𝟙 U ≫ E.unit c)
        exact heq_of_eq (congrArg (· ≫ E.unit c) (T.map_id _))

/-- The original option/sum position map keeps precisely the original unary coefficient and
input. -/
theorem unaryPosition_compare (E : ColoredOperadObj W C) (A : W → C) (c : W) :
    (Unit.rightUnitPositionIso (A c) (FintypeCat.of PUnit)).hom ≫ unaryBareFactor E A c =
      unaryUnitFactor E A c := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | inl _ => exact heq_of_eq (Category.id_comp (E.unit c))
    | inr _ => exact heq_of_eq (Category.id_comp (𝟙 (A c)))

/-- The actual genuine unary algebra input is its original singleton
inverse followed by the original frozen unit prefix and original factor map. -/
theorem unitInsertion_normalized (E : ColoredOperadObj W C) (A : W → C) (c : W) :
    unitInsertion E A c =
      (FiniteTensor.singletonIso (V := C)).inv.app (A c) ≫
        (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
          C)).obj (A c))).hom ≫
        (FiniteTensor.tensor (V := C)).map (unaryUnitFactor E A c) := by
  let T := FiniteTensor.tensor (V := C)
  let X := A c
  let p := UnitInsertion.rightInsertPrefix X (FintypeCat.of PUnit)
  let q := UnitInsertion.leftInsertPrefix X
  let n := T.map ((FiniteFamily.map T).map (Linear.UnitGeometry.leftBlocksIso X).hom)
  let f := T.map (unitFactors E A c)
  let g := T.map (Unit.rightRootNormalizer X (FintypeCat.of PUnit) ≫ unaryBareFactor E A c)
  have hp : p ≫ n = q := Linear.UnitGeometry.leftPrefix_fromRight X
  have hf : n ≫ f = g := (T.map_comp _ _).symm.trans (congrArg T.map
    (unaryBareFactor_compare E A c))
  have h : unitInsertion E A c = UnitInsertion.rightInsertFromFactor X (FintypeCat.of PUnit)
      (Unit.rightRootNormalizer X (FintypeCat.of PUnit) ≫ unaryBareFactor E A c) :=
    (congrArg (· ≫ f) hp.symm).trans ((Category.assoc p n f).trans (congrArg (p ≫ ·) hf))
  let s := (FiniteTensor.singletonIso (V := C)).inv.app X
  let z := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
    C)).obj X)).hom
  exact h.trans ((Unit.rightInsertFromNormalizedFactor X (FintypeCat.of PUnit)
    (unaryBareFactor E A c)).trans
    (congrArg (fun k => s ≫ z ≫ T.map k) (unaryPosition_compare E A c)))

/-- The original algebra unit law evaluates the original inserted
unary coefficient to the original singleton unitor, with the variable retained. -/
theorem unaryUnit_evaluation (E : ColoredOperadObj W C) (M : Algebra E) (c : W) :
    (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
      C)).obj (M.carrier c))).hom ≫
      (FiniteTensor.tensor (V := C)).map (unaryUnitFactor E M.carrier c) ≫
        M.operations.app c (AnalyticIndex.unary c) =
    (FiniteTensor.singletonIso (V := C)).hom.app (M.carrier c) := by
  let s := (FiniteTensor.singletonIso (V := C)).app (M.carrier c)
  let z := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
    C)).obj (M.carrier c))).hom
    ≫
    (FiniteTensor.tensor (V := C)).map (unaryUnitFactor E M.carrier c)
  let o := M.operations.app c (AnalyticIndex.unary c)
  have hi : s.inv ≫ z = unitInsertion E M.carrier c := (unitInsertion_normalized E M.carrier c).symm
  have h : z ≫ o = s.hom := by
    apply (cancel_epi s.inv).1
    exact (Category.assoc s.inv z o).symm.trans
      ((congrArg (· ≫ o) hi).trans ((M.unit c).trans s.inv_hom_id.symm))
  exact (Category.assoc _ _ o).symm.trans h

/-- Every original nullary input coefficient evaluates through the
original factor inverse and genuine nullary operation, retaining its singleton unitor. -/
theorem nullaryFactor_evaluation (E : ColoredOperadObj W C) (M : Algebra E) (c : W) :
    (FiniteTensor.tensor (V := C)).map (nullaryFactorsIso E.toCollection M.carrier c).inv ≫
      M.operations.app c AnalyticIndex.nullary =
    (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (ColoredProfile.nullary c)) ≫
      nullaryEvaluation M c := by
  let s := (FiniteTensor.singletonIso (V := C)).app (E.toCollection.obj (ColoredProfile.nullary c))
  let e := (FiniteTensor.tensor (V := C)).mapIso (nullaryFactorsIso E.toCollection M.carrier c)
  let o := M.operations.app c AnalyticIndex.nullary
  change e.inv ≫ o = s.hom ≫ ((s.inv ≫ e.inv) ≫ o)
  exact ((Category.assoc s.hom (s.inv ≫ e.inv) o).symm.trans
    ((congrArg (· ≫ o) (Category.assoc s.hom s.inv e.inv).symm).trans
      ((Category.assoc (s.hom ≫ s.inv) e.inv o).trans
        ((congrArg (fun z => z ≫ e.inv ≫ o) s.hom_inv_id).trans (Category.id_comp (e.inv
          ≫ o)))))).symm


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

end
end EnvelopingSource211

/- Exact checked source: LinearAlgebra.CoefficientPrefix. -/
section EnvelopingSource212


/-!
# Tensor-unit insertion in the original coefficient block with all leaves
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem prefixNormalizationFiring {D : Type*} [Category* D]
    {X A A' B E G Y : D} (p : X ⟶ A) (r : A ⟶ B) (c : B ⟶ E) (z : E ⟶ Y)
    (p' : X ⟶ A') (a : A' ⟶ B) (f : X ⟶ G) (b : G ⟶ E) (y : G ⟶ Y)
    (h1 : p ≫ r = p' ≫ a) (h2 : p' ≫ a ≫ c = f ≫ b) (h3 : b ≫ z = y) :
    p ≫ r ≫ (c ≫ z) = f ≫ y := by
  rw [← Category.assoc p r, h1]
  simp only [Category.assoc]
  rw [← Category.assoc p' a, ← Category.assoc (p' ≫ a) c]
  rw [show (p' ≫ a) ≫ c = f ≫ b from (Category.assoc _ _ _).trans h2]
  rw [Category.assoc f b, h3]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Units occur at precisely the original coefficient block. Every
original leaf block has no unit position. -/
def coefficientPrefixPositions (I : FintypeCat.{0}) (K L : FiniteFamily C) :
    (coefficientLeavesNested K L).index → FintypeCat.{0}
  | none => I
  | some _ => FintypeCat.of (Fin 0)

/-- The original coefficient unit positions are exactly the dependent
block unit positions, including when I or L is empty. -/
def coefficientPrefixPositionEquiv (I : FintypeCat.{0}) (K L : FiniteFamily C) :
    I ≃ blockUnitIndex (coefficientLeavesNested K L) (coefficientPrefixPositions I K L) where
  toFun i := ⟨none, i⟩
  invFun p := match p with
    | ⟨none, i⟩ => i
    | ⟨some _, i⟩ => Fin.elim0 i
  left_inv _ := rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some _ => exact Fin.elim0 j

/-- Every coefficient unit is inserted before the actual original
coefficient factors; all original leaf factors retain their positions. -/
def coefficientPrefixRawMap (I : FintypeCat.{0}) (K L : FiniteFamily C) :
    frozenVariableUnitFamily I ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K L)) ⟶
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (frozenVariableUnitFamily I K) L) where
  equiv :=
    { toFun p := match p with
        | Sum.inl i => ⟨none, Sum.inl i⟩
        | Sum.inr ⟨none, k⟩ => ⟨none, Sum.inr k⟩
        | Sum.inr ⟨some l, _⟩ => ⟨some l, PUnit.unit⟩
      invFun p := match p with
        | ⟨none, Sum.inl i⟩ => Sum.inl i
        | ⟨none, Sum.inr k⟩ => Sum.inr ⟨none, k⟩
        | ⟨some l, _⟩ => Sum.inr ⟨some l, PUnit.unit⟩
      left_inv p := by
        cases p with
        | inl _ => rfl
        | inr p => rcases p with ⟨i, j⟩; cases i with
          | none => rfl
          | some _ => cases j; rfl
      right_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some _ => cases j; rfl }
  hom p := match p with
    | Sum.inl _ => 𝟙 _
    | Sum.inr ⟨none, _⟩ => 𝟙 _
    | Sum.inr ⟨some _, _⟩ => 𝟙 _

/-- The actual unit-family map in each original nested block. -/
def coefficientPrefixBlockMap (I : FintypeCat.{0}) (K L : FiniteFamily C)
    (i : (coefficientLeavesNested K L).index) :
    frozenVariableUnitFamily (coefficientPrefixPositions I K L i)
        ((coefficientLeavesNested K L).obj i) ⟶
      (coefficientLeavesNested (frozenVariableUnitFamily I K) L).obj i :=
  match i with
  | none => 𝟙 _
  | some l => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      ((FiniteFamily.singleton (C := C)).obj (L.obj l))).hom

/-- The blockwise unit distribution uses precisely the displayed
original global coefficient-prefix map. -/
theorem coefficientPrefixRawMap_factor (I : FintypeCat.{0}) (K L : FiniteFamily C) :
    Variable.unitFamilyMap (coefficientPrefixPositionEquiv I K L)
        (𝟙 ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K L))) ≫
      blockUnitGlobalMap (coefficientLeavesNested K L) (coefficientPrefixPositions I K L)
        (coefficientLeavesNested (frozenVariableUnitFamily I K) L).obj
        (coefficientPrefixBlockMap I K L) = coefficientPrefixRawMap I K L := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl _ => rfl
    | inr p => rcases p with ⟨i, j⟩; cases i <;> rfl
  · intro p
    cases p with
    | inl i =>
      let X := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
      change HEq (𝟙 X ≫ (𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with
      | none =>
        let X := K.obj j
        change HEq (𝟙 X ≫ (𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])
      | some i =>
        cases j
        let X := L.obj i
        change HEq (𝟙 X ≫ (𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

/-- Applying the genuine blockwise insertion and original leaf unitors
is the original coefficient-only insertion and original leaf unitors. -/
theorem coefficientPrefixApplied_collapse (I : FintypeCat.{0}) (K L : FiniteFamily C) :
    blockUnitAppliedMap (coefficientLeavesNested K L) (coefficientPrefixPositions I K L)
        (coefficientLeavesNested (frozenVariableUnitFamily I K) L).obj
        (coefficientPrefixBlockMap I K L) ≫
      coefficientLeavesCollapse (frozenVariableUnitFamily I K) L =
    coefficientLeavesCollapse K L ≫
      (coefficientLeafFamilyFunctor L).map (frozenVariableTensorUnitIso I K).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq (((frozenVariableTensorUnitIso I K).hom ≫
        (FiniteTensor.tensor (V := C)).map (𝟙 _)) ≫ 𝟙 _)
        (𝟙 _ ≫ (frozenVariableTensorUnitIso I K).hom)
      exact heq_of_eq (by simp only [Functor.map_id, Category.comp_id, Category.id_comp])
    | some i =>
      let S := (FiniteFamily.singleton (C := C)).obj (L.obj i)
      let e := (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) S).hom
      let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) S).hom
      let z := (FiniteTensor.singletonIso (V := C)).hom.app (L.obj i)
      change HEq ((p ≫ (FiniteTensor.tensor (V := C)).map e) ≫ z) (z ≫ 𝟙 _)
      exact heq_of_eq ((congrArg (· ≫ z) (ZeroVariable.emptyPrefix_unit
        (FintypeCat.of (Fin 0)) S)).trans ((Category.id_comp z).trans (Category.comp_id z).symm))

/-- Actual original finite tensor coherence inserts units in the
coefficient block before or after collecting every original leaf. -/
theorem coefficientPrefix_normalization (I : FintypeCat.{0}) (K L : FiniteFamily C) :
    (frozenVariableTensorUnitIso I
        ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K L))).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientPrefixRawMap I K L) ≫
        coefficientLeavesNormalization (frozenVariableUnitFamily I K) L =
    coefficientLeavesNormalization K L ≫
      (coefficientLeafTensorFunctor L).map (frozenVariableTensorUnitIso I K).hom := by
  let T := FiniteTensor.tensor (V := C)
  let N := coefficientLeavesNested K L
  let M : N.index → FiniteFamily C :=
    (coefficientLeavesNested (frozenVariableUnitFamily I K) L).obj
  let N' : FiniteFamily (FiniteFamily C) := ⟨N.index, M⟩
  let J := coefficientPrefixPositions I K L
  let e := coefficientPrefixPositionEquiv I K L
  let r := Variable.unitFamilyMap e (𝟙 ((FiniteFamily.flatten (C := C)).obj N))
  let a := blockUnitGlobalMap N J M (coefficientPrefixBlockMap I K L)
  let b := blockUnitAppliedMap N J M (coefficientPrefixBlockMap I K L)
  let p := (frozenVariableTensorUnitIso I ((FiniteFamily.flatten (C := C)).obj N)).hom
  let p' := (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C :=
    C)).obj N)).hom
  have hr : p ≫ T.map r = p' := by
    have h := Variable.tensorUnitIso_naturality e
      (𝟙 ((FiniteFamily.flatten (C := C)).obj N))
    change T.map (𝟙 _) ≫ p' = p ≫ T.map r at h
    exact h.symm.trans ((congrArg (· ≫ p') (T.map_id _)).trans (Category.id_comp p'))
  have hraw : T.map r ≫ T.map a = T.map (coefficientPrefixRawMap I K L) :=
    (T.map_comp r a).symm.trans (congrArg T.map (coefficientPrefixRawMap_factor I K L))
  have hdist : p' ≫ T.map a ≫ (FiniteTensor.flattenIso (V := C)).hom.app N' =
      (FiniteTensor.flattenIso (V := C)).hom.app N ≫ T.map b :=
    tensorUnitBlock_applied N J M (coefficientPrefixBlockMap I K L)
  have hcollapse : T.map b ≫ T.map (coefficientLeavesCollapse (frozenVariableUnitFamily I K) L) =
      T.map (coefficientLeavesCollapse K L) ≫
        (coefficientLeafTensorFunctor L).map (frozenVariableTensorUnitIso I K).hom :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (coefficientPrefixApplied_collapse I K L)).trans (T.map_comp _ _))
  have h1 : p ≫ T.map (coefficientPrefixRawMap I K L) = p' ≫ T.map a := by
    exact (congrArg (p ≫ ·) hraw.symm).trans
      ((Category.assoc p (T.map r) (T.map a)).symm.trans (congrArg (· ≫ T.map a) hr))
  change p ≫ T.map (coefficientPrefixRawMap I K L) ≫
      ((FiniteTensor.flattenIso (V := C)).hom.app N' ≫
        T.map (coefficientLeavesCollapse (frozenVariableUnitFamily I K) L)) =
    ((FiniteTensor.flattenIso (V := C)).hom.app N ≫ T.map (coefficientLeavesCollapse K L)) ≫
      (coefficientLeafTensorFunctor L).map (frozenVariableTensorUnitIso I K).hom
  exact (prefixNormalizationFiring p (T.map (coefficientPrefixRawMap I K L))
    ((FiniteTensor.flattenIso (V := C)).hom.app N')
    (T.map (coefficientLeavesCollapse (frozenVariableUnitFamily I K) L)) p' (T.map a)
    ((FiniteTensor.flattenIso (V := C)).hom.app N) (T.map b)
    (T.map (coefficientLeavesCollapse K L) ≫
      (coefficientLeafTensorFunctor L).map (frozenVariableTensorUnitIso I K).hom)
    h1 hdist hcollapse).trans (Category.assoc _ _ _).symm


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
