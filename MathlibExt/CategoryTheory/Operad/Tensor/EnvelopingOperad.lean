/-!
# Complete association of the original weighted representatives
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The exact original weighted inner-first and root-first operation
routes agree, by original coefficient association and equality of their
complete original weighted source normalizers. -/
theorem envelopingAssocWeightedRepresentative_assoc (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRepresentativeRouteA O B d Q =
      envelopingAssocWeightedRepresentativeRouteB O B d Q := by
  let U := coefficientLeafTensorFunctor
    ((addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q))
  have h : envelopingAssocWeightedCommonEvaluationB O B d Q =
      envelopingAssocWeightedRootFirstCommonEvaluation O B d Q :=
    congrArg (· ≫ U.map (envelopingAssocRepresentativeRouteB O d Q))
      (envelopingAssocWeightedCommonSourceIso_hom_eq_rootFirst O.toCollection B d Q)
  exact (envelopingAssocWeightedRouteA_common O B d Q).trans
    ((envelopingAssocWeightedCommonEvaluations O B d Q).trans
      (h.trans (envelopingAssocWeightedRouteB_rootFirstCommon O B d Q).symm))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The original complete weighted association equality is retained
under the actual original total coefficient colimit injection. -/
theorem envelopingAssocWeightedRepresentativeColimit_assoc (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRepresentativeRouteA O B d Q ≫
        linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
          (envelopingAssocTotalAlgebraInputs d Q) =
      envelopingAssocWeightedRepresentativeRouteB O B d Q ≫
        linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
          (envelopingAssocTotalAlgebraInputs d Q) :=
  congrArg (· ≫ linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
    (envelopingAssocTotalAlgebraInputs d Q)) (envelopingAssocWeightedRepresentative_assoc O B d Q)


end CategoryTheory.Operad.Tensor.Enveloping

