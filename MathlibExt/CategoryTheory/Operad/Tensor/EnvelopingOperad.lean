namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem combineRightMiddle {D : Type*} [Category* D] {A B C E F G : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) (e : F ⟶ G) :
    a ≫ b ≫ c ≫ d ≫ e = a ≫ (b ≫ c) ≫ d ≫ e := by simp only [Category.assoc]

private theorem appendRightFactor {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    a ≫ b ≫ c ≫ d = (a ≫ b ≫ c) ≫ d := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The genuine grouped normalization of the original empty/singleton
right prefix transports any whole original coefficient map through the
original coefficient/leaf tensor functor. -/
theorem rightGroupedNormalization_post (X : C) (L : FiniteFamily C) (I : FintypeCat.{0})
    {Y : C} (k : (FiniteTensor.tensor (V := C)).obj
      ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (UnitInsertion.rightNestedFamily X I)) ⟶ Y) :
    (FiniteTensor.singletonIso (V := C)).inv.app ((coefficientLeafTensorFunctor L).obj X) ≫
      (FiniteTensor.tensor (V := C)).map
        (UnitInsertion.rightSingletonToFlatten ((coefficientLeafTensorFunctor L).obj X) I ≫
          (FiniteFamily.flatten (C := C)).map (rightWeightedBlocksIso X L I).hom) ≫
      groupedCoefficientInputNormalization (UnitInsertion.rightNestedFamily X I)
        (rightAtomicInputs X L I) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap k (rightGroupedLeavesIso X L I).hom) =
    (coefficientLeafTensorFunctor L).map
      ((FiniteTensor.singletonIso (V := C)).inv.app X ≫
        (FiniteTensor.tensor (V := C)).map (rightCoefficientEmbeddingIso X I).hom ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.rightNestedFamily X I) ≫ k) := by
  let T := FiniteTensor.tensor (V := C)
  let U := coefficientLeafTensorFunctor L
  let N := UnitInsertion.rightNestedFamily X I
  let A := rightAtomicInputs X L I
  let K := (FiniteFamily.flatten (C := C)).obj N
  let e := rightCoefficientEmbeddingIso X I
  let source := UnitInsertion.rightSingletonToFlatten (U.obj X) I ≫
    (FiniteFamily.flatten (C := C)).map (rightWeightedBlocksIso X L I).hom
  let a := (FiniteTensor.singletonIso (V := C)).inv.app (U.obj X)
  let b := T.map source
  let c := T.map (Grouping.atomicWeightedIso N A).hom
  let d := (FiniteTensor.flattenIso (V := C)).hom.app N ≫ k
  let i := (coefficientBlockInterchangeTensorIso K.index K.obj A).hom
  let p := T.map (coefficientLeafMap d (rightAtomicLeavesIso X L I).hom)
  let r := T.map (weightedInputBlockRelabelMap (L := fun _ : PUnit => L) (L' := A)
    e.hom.equiv e.hom.hom (fun _ => 𝟙 L))
  let j := (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _
    => L)).hom
  let leaf := (FiniteFamily.flatten (C := C)).map
    (inputBlockRelabelMap (L := fun _ : PUnit => L) (L' := A) e.hom.equiv (fun _ => 𝟙 L))
  let q := T.map (coefficientLeafMap (T.map e.hom) leaf)
  let f := T.map e.hom ≫ d
  let t := T.map (coefficientLeafMap f (singletonCoefficientInputLeafIso L).hom)
  have hsource : source ≫ (Grouping.atomicWeightedIso N A).hom =
      weightedInputBlockRelabelMap (L := fun _ : PUnit => L) (L' := A)
        e.hom.equiv e.hom.hom (fun _ => 𝟙 L) :=
    (congrArg (source ≫ ·) (WeightedNormalization.atomicWeightedIso_hom N A)).trans
      ((Category.comp_id source).trans (rightWeightedSource_relabel X L I))
  have hs : b ≫ c = r := (T.map_comp _ _).symm.trans (congrArg T.map hsource)
  have hn : r ≫ i = j ≫ q := coefficientBlockInterchangeTensorIso_relabel
    (K := (FiniteFamily.singleton (C := C)).obj X |>.obj) (K' := K.obj)
    (L := fun _ : PUnit => L) (L' := A) e.hom.equiv e.hom.hom (fun _ => 𝟙 L)
  have hleaf : leaf ≫ (rightAtomicLeavesIso X L I).hom =
      (singletonCoefficientInputLeafIso L).hom := rightAtomicLeaves_relabel X L I
  have hfamily : coefficientLeafMap (T.map e.hom) leaf ≫
      coefficientLeafMap d (rightAtomicLeavesIso X L I).hom =
      coefficientLeafMap f (singletonCoefficientInputLeafIso L).hom :=
    (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg (fun l => coefficientLeafMap f l) hleaf)
  have ht : q ≫ p = t := (T.map_comp _ _).symm.trans (congrArg T.map hfamily)
  have hr : r ≫ i ≫ p = j ≫ t := (Category.assoc r i p).symm.trans
    ((congrArg (· ≫ p) hn).trans ((Category.assoc j q p).trans (congrArg (j ≫ ·) ht)))
  have hp := normalizeGroupedPostMap N A k (rightGroupedLeavesIso X L I).hom
  have hf := WeightedNormalization.flatAtomicAfterCoefficientMap N A d
    (rightGroupedLeavesIso X L I).hom
  have h₀ := (congrArg (fun h => a ≫ b ≫ h) hp).trans (congrArg (fun h => a ≫ b ≫ h) hf)
  have h₁ : a ≫ b ≫ c ≫ i ≫ p = a ≫ r ≫ i ≫ p :=
    (combineRightMiddle a b c i p).trans (congrArg (fun h => a ≫ h ≫ i ≫ p) hs)
  have h₂ : a ≫ r ≫ i ≫ p = a ≫ j ≫ t := congrArg (a ≫ ·) hr
  have h₃ : j ≫ t = (FiniteTensor.singletonIso (V := C)).hom.app (U.obj X) ≫
      U.map ((FiniteTensor.singletonIso (V := C)).inv.app X ≫ f) := singletonInterchangePost X L f
  have h₄ : a ≫ ((FiniteTensor.singletonIso (V := C)).hom.app (U.obj X) ≫
      U.map ((FiniteTensor.singletonIso (V := C)).inv.app X ≫ f)) =
      U.map ((FiniteTensor.singletonIso (V := C)).inv.app X ≫ f) :=
    (Category.assoc a ((FiniteTensor.singletonIso (V := C)).hom.app (U.obj X)) _).symm.trans
      ((congrArg (· ≫ U.map ((FiniteTensor.singletonIso (V := C)).inv.app X ≫ f))
        ((FiniteTensor.singletonIso (V := C)).inv_hom_id_app (U.obj X))).trans (Category.id_comp _))
  exact h₀.trans (h₁.trans (h₂.trans ((congrArg (a ≫ ·) h₃).trans h₄)))

/-- The exact original weighted right-unit insertion and coefficient
interchange is the original coefficient right-unit insertion tensored
with the complete original heterogeneous root leaf family. Every empty
unit block is retained; no coefficient or leaf unit outcome is supplied. -/
theorem rightWeightedPrefix_coherence (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) (Y : I → C)
    (η : ∀ i, (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y i) :
    (UnitInsertion.rightInsertFromFactor ((coefficientLeafTensorFunctor L).obj X) I
        (rightWeightedFactor X L I Y η) ≫
      (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option I))
        (rightCoefficientFamily X I Y).obj (rightLeaves L I)).hom) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (𝟙 ((FiniteTensor.tensor (V := C)).obj (rightCoefficientFamily X I Y)))
        (rightLeavesIso L I).hom) =
    (coefficientLeafTensorFunctor L).map
      (UnitInsertion.rightInsertFromFactor X I (rightCoefficientFactor X I Y η)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.singletonIso (V := C)).inv.app X
  let b := T.map (rightCoefficientEmbeddingIso X I).hom
  let c := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.rightNestedFamily X I)
  let d := T.map (rightCoefficientFactor X I Y η)
  have h : a ≫ b ≫ c ≫ d = UnitInsertion.rightInsertFromFactor X I
    (rightCoefficientFactor X I Y η) :=
    appendRightFactor a b c d
  exact (rightWeightedPrefix_grouped X L I Y η).trans
    ((rightGroupedNormalization_post X L I d).trans (congrArg (coefficientLeafTensorFunctor
      L).map h))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
end EnvelopingSource167

/- Exact checked source: WeightedNormalization.LeftPrefixData. -/
section EnvelopingSource168


/-!
# The original empty/singleton left unit-prefix permutation
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

/-- The permutation exchanging the root and sole branch positions of a unit prefix. -/
def unitFlipEquiv : Option PUnit ≃ Option PUnit where
  toFun i := match i with | none => some PUnit.unit | some _ => none
  invFun i := match i with | none => some PUnit.unit | some _ => none
  left_inv i := by cases i with
    | none => rfl
    | some i => cases i; rfl
  right_inv i := by cases i with
    | none => rfl
    | some i => cases i; rfl

variable {C : Type w} [Category.{v} C]

/-- The original right and left empty/singleton insertion blocks
are related by their exact original two-position permutation. -/
def leftBlocksIso (X : C) :
    UnitInsertion.rightNestedFamily X (FintypeCat.of PUnit) ≅ UnitInsertion.leftNestedFamily X :=
  FiniteFamily.isoOfComponents unitFlipEquiv (fun i => by
    cases i with
    | none => exact Iso.refl _
    | some i => exact Iso.refl _)

/-- The actual coefficient block permutation retains the supplied
unit coefficient and the original retained coefficient. -/
def leftCoefficientIso (X Y : C) :
    rightCoefficientFamily X (FintypeCat.of PUnit) (fun _ => Y) ≅ sparseUnitScalarFamily Y X :=
  FiniteFamily.isoOfComponents unitFlipEquiv (fun i => by
    cases i with
    | none => exact Iso.refl _
    | some i => exact Iso.refl _)

/-- The left unit leaf blocks: an empty root block and the original leaves in the sole branch. -/
def leftLeaves (L : FiniteFamily C) : Option PUnit → FiniteFamily C
  | none => FiniteFamily.empty
  | some _ => L

/-- The unit-prefix flip identifies each right leaf block with its corresponding left leaf
block. -/
def leftLeafIsoAt (L : FiniteFamily C) (i : Option PUnit) :
    rightLeaves L (FintypeCat.of PUnit) i ≅ leftLeaves L (unitFlipEquiv i) := by
  cases i <;> exact Iso.refl _

/-- The original left-prefix total leaf map discards only the
original empty root block and retains every original input position. -/
def leftLeavesIso (L : FiniteFamily C) :
    totalBlockInputs (FintypeCat.of (Option PUnit)) (leftLeaves L) ≅ L :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | ⟨none, i⟩ => i.elim | ⟨some _, i⟩ => i
      invFun := fun i => ⟨some PUnit.unit, i⟩
      left_inv := fun p => by rcases p with ⟨i, j⟩; cases i with
        | none => cases j
        | some i => cases i; rfl
      right_inv := fun _ => rfl }
    (fun p => by rcases p with ⟨i, j⟩; cases i with
      | none => cases j
      | some i => exact Iso.refl _)

/-- The exact original input permutation commutes with both
original total leaf bijections, including every empty leaf family. -/
theorem leftLeaves_relabel (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
        (inputBlockRelabelMap unitFlipEquiv (fun i => (leftLeafIsoAt L i).hom)) ≫
      (leftLeavesIso L).hom = (rightLeavesIso L (FintypeCat.of PUnit)).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some i => cases j

variable [FiniteTensor C]

/-- The original left coefficient factor inserts the supplied
coefficient through the tensor unit and retains the original singleton collapse. -/
def leftCoefficientFactor (X Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    UnitInsertion.leftTensorFamily X ⟶ sparseUnitScalarFamily Y X where
  equiv := Equiv.refl (Option PUnit)
  hom i := match i with
    | none => η
    | some _ => (FiniteTensor.singletonIso (V := C)).hom.app X

/-- The original weighted left coefficient factor uses the actual
empty-leaf unitor inverse at the supplied coefficient and retains the
original complete weighted-input singleton collapse. -/
def leftWeightedFactor (X : C) (L : FiniteFamily C) (Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    UnitInsertion.leftTensorFamily ((coefficientLeafTensorFunctor L).obj X) ⟶
      weightedInputBlockFamily (FintypeCat.of (Option PUnit)) (sparseUnitScalarFamily Y
        X).obj (leftLeaves L) where
  equiv := Equiv.refl (Option PUnit)
  hom i := match i with
    | none => η ≫ (emptyLeafTensorIso Y).inv
    | some _ => (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor
      L).obj X)

/-- The actual full weighted block map retains both original
coefficient maps and all original input families through their exact swap. -/
def leftWeightedRelabelMap (X : C) (L : FiniteFamily C) (Y : C) :
    weightedInputBlockFamily (FintypeCat.of (Option PUnit))
        (rightCoefficientFamily X (FintypeCat.of PUnit) (fun _ => Y)).obj
        (rightLeaves L (FintypeCat.of PUnit)) ⟶
      weightedInputBlockFamily (FintypeCat.of (Option PUnit))
        (sparseUnitScalarFamily Y X).obj (leftLeaves L) :=
  weightedInputBlockRelabelMap
    (K := (rightCoefficientFamily X (FintypeCat.of PUnit) (fun _ => Y)).obj)
    (K' := (sparseUnitScalarFamily Y X).obj)
    (L := rightLeaves L (FintypeCat.of PUnit)) (L' := leftLeaves L)
    unitFlipEquiv (leftCoefficientIso X Y).hom.hom (fun i => (leftLeafIsoAt L i).hom)


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
end EnvelopingSource168

/- Exact checked source: WeightedNormalization.LeftPrefixFlip. -/
section EnvelopingSource169


/-!
# The actual original left prefixes and factor maps follow the original swap
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem prefixFromTwoSquares {D : Type*} [Category* D] {X A B C E F : D}
    (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ C) (d : C ⟶ F)
    (f : B ⟶ E) (b' : A ⟶ E) (c' : E ⟶ F)
    (hc : c ≫ d = f ≫ c') (hb : b ≫ f = b') :
    (a ≫ b ≫ c) ≫ d = a ≫ b' ≫ c' := by
  calc
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]
    _ = a ≫ b ≫ (f ≫ c') := congrArg (fun c => a ≫ b ≫ c) hc
    _ = a ≫ (b ≫ f) ≫ c' := by simp only [Category.assoc]
    _ = a ≫ b' ≫ c' := congrArg (fun c => a ≫ c ≫ c') hb

private theorem insertionRelabel {D : Type*} [Category* D] {A B C E F : D}
    (p : A ⟶ B) (q : A ⟶ C) (n : B ⟶ C) (f : B ⟶ E) (g : C ⟶ F) (h : E ⟶ F)
    (hp : p ≫ n = q) (hf : n ≫ g = f ≫ h) :
    (p ≫ f) ≫ h = q ≫ g :=
  (Category.assoc p f h).trans ((congrArg (p ≫ ·) hf.symm).trans
    ((Category.assoc p n g).symm.trans (congrArg (· ≫ g) hp)))

variable {C : Type w} [Category.{v} C]

/-- The two original singleton embeddings are related by the
actual empty/singleton left-block permutation. -/
theorem leftBlocks_embedding (X : C) :
    UnitInsertion.rightSingletonToFlatten X (FintypeCat.of PUnit) ≫
      (FiniteFamily.flatten (C := C)).map (leftBlocksIso X).hom =
        UnitInsertion.leftSingletonToFlatten X := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i
    rfl
  · intro i
    cases i
    exact heq_of_eq (Category.id_comp _)

variable [FiniteTensor C]

private theorem tensorLeafIdentity (X : C) (L : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 X) (𝟙 L)) =
      𝟙 ((coefficientLeafTensorFunctor L).obj X) :=
  (congrArg (FiniteTensor.tensor (V := C)).map (coefficientLeafMap_idLeaves (𝟙 X) L)).trans
    ((congrArg (FiniteTensor.tensor (V := C)).map ((coefficientLeafFamilyFunctor L).map_id X)).trans
      ((FiniteTensor.tensor (V := C)).map_id _))

/-- Actual finite tensor flattening naturality identifies the
original right prefix followed by the original swap with the original
left prefix, on the same complete original coefficient object. -/
theorem leftPrefix_fromRight (X : C) :
    UnitInsertion.rightInsertPrefix X (FintypeCat.of PUnit) ≫
      (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.map (FiniteTensor.tensor (V := C))).map (leftBlocksIso X).hom) =
      UnitInsertion.leftInsertPrefix X := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.singletonIso (V := C)).inv.app X
  let b := T.map (UnitInsertion.rightSingletonToFlatten X (FintypeCat.of PUnit))
  let c := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.rightNestedFamily X
    (FintypeCat.of PUnit))
  let d := T.map ((FiniteFamily.map T).map (leftBlocksIso X).hom)
  let f := T.map ((FiniteFamily.flatten (C := C)).map (leftBlocksIso X).hom)
  let b' := T.map (UnitInsertion.leftSingletonToFlatten X)
  let c' := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.leftNestedFamily X)
  have hc : c ≫ d = f ≫ c' := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (leftBlocksIso X).hom |>.symm
  have hb : b ≫ f = b' := (T.map_comp _ _).symm.trans (congrArg T.map (leftBlocks_embedding X))
  exact prefixFromTwoSquares a b c d f b' c' hc hb

/-- The original coefficient factor maps commute with the exact
two-position coefficient permutation and original tensor singleton maps. -/
theorem leftCoefficientFactor_relabel (X Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (leftBlocksIso X).hom ≫
      leftCoefficientFactor X Y η =
      rightCoefficientFactor X (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η) ≫
        (leftCoefficientIso X Y).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let T := FiniteTensor.tensor (V := C)
      let s := (FiniteTensor.singletonIso (V := C)).hom.app X
      exact heq_of_eq (((congrArg (· ≫ s) (T.map_id ((FiniteFamily.singleton (C :=
        C)).obj X))).trans
        (Category.id_comp s)).trans (Category.comp_id s).symm)
    | some i =>
      let T := FiniteTensor.tensor (V := C)
      exact heq_of_eq (((congrArg (· ≫ η) (T.map_id (FiniteFamily.empty : FiniteFamily C))).trans
        (Category.id_comp η)).trans (Category.comp_id η).symm)

/-- The complete original weighted factor maps commute with the
actual swap, retaining every original coefficient map, empty input
family, heterogeneous root input, and original singleton tensor map. -/
theorem leftWeightedFactor_relabel (X : C) (L : FiniteFamily C) (Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map
        (leftBlocksIso ((coefficientLeafTensorFunctor L).obj X)).hom ≫ leftWeightedFactor X L Y η =
      rightWeightedFactor X L (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η) ≫
        leftWeightedRelabelMap X L Y := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let T := FiniteTensor.tensor (V := C)
      let Z := (coefficientLeafTensorFunctor L).obj X
      let s := (FiniteTensor.singletonIso (V := C)).hom.app Z
      have hl : T.map (𝟙 ((FiniteFamily.singleton (C := C)).obj Z)) ≫ s = s :=
        (congrArg (· ≫ s) (T.map_id _)).trans (Category.id_comp s)
      have hr : s ≫ T.map (coefficientLeafMap (𝟙 X) (𝟙 L)) = s :=
        (congrArg (s ≫ ·) (tensorLeafIdentity X L)).trans (Category.comp_id s)
      exact heq_of_eq (hl.trans hr.symm)
    | some i =>
      let T := FiniteTensor.tensor (V := C)
      let s := η ≫ (emptyLeafTensorIso Y).inv
      have hl : T.map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ s = s :=
        (congrArg (· ≫ s) (T.map_id _)).trans (Category.id_comp s)
      have hr : s ≫ T.map (coefficientLeafMap (𝟙 Y) (𝟙 (FiniteFamily.empty :
        FiniteFamily C))) = s :=
        (congrArg (s ≫ ·) (tensorLeafIdentity Y FiniteFamily.empty)).trans (Category.comp_id s)
      exact heq_of_eq (hl.trans hr.symm)

/-- The original coefficient right insertion followed by the actual
coefficient swap is precisely the original coefficient left insertion. -/
theorem leftCoefficientInsertion_relabel (X Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    UnitInsertion.rightInsertFromFactor X (FintypeCat.of PUnit)
        (rightCoefficientFactor X (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η)) ≫
      (FiniteTensor.tensor (V := C)).map (leftCoefficientIso X Y).hom =
      UnitInsertion.leftInsertFromFactor X (leftCoefficientFactor X Y η) := by
  let T := FiniteTensor.tensor (V := C)
  let p := UnitInsertion.rightInsertPrefix X (FintypeCat.of PUnit)
  let q := UnitInsertion.leftInsertPrefix X
  let n := T.map ((FiniteFamily.map T).map (leftBlocksIso X).hom)
  let f := T.map (rightCoefficientFactor X (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η))
  let g := T.map (leftCoefficientFactor X Y η)
  let h := T.map (leftCoefficientIso X Y).hom
  have hf : n ≫ g = f ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (leftCoefficientFactor_relabel X Y η)).trans (T.map_comp _ _))
  exact insertionRelabel p q n f g h (leftPrefix_fromRight X) hf

/-- The original weighted right insertion followed by its complete
original coefficient/input swap is precisely the original weighted
left insertion, with every source tensor comparison retained. -/
theorem leftWeightedInsertion_relabel (X : C) (L : FiniteFamily C) (Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    UnitInsertion.rightInsertFromFactor ((coefficientLeafTensorFunctor L).obj X)
      (FintypeCat.of PUnit)
        (rightWeightedFactor X L (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η)) ≫
      (FiniteTensor.tensor (V := C)).map (leftWeightedRelabelMap X L Y) =
      UnitInsertion.leftInsertFromFactor ((coefficientLeafTensorFunctor L).obj X)
        (leftWeightedFactor X L Y η) := by
  let T := FiniteTensor.tensor (V := C)
  let Z := (coefficientLeafTensorFunctor L).obj X
  let p := UnitInsertion.rightInsertPrefix Z (FintypeCat.of PUnit)
  let q := UnitInsertion.leftInsertPrefix Z
  let n := T.map ((FiniteFamily.map T).map (leftBlocksIso Z).hom)
  let f := T.map (rightWeightedFactor X L (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η))
  let g := T.map (leftWeightedFactor X L Y η)
  let h := T.map (leftWeightedRelabelMap X L Y)
  have hf : n ≫ g = f ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (leftWeightedFactor_relabel X L Y η)).trans (T.map_comp _ _))
  exact insertionRelabel p q n f g h (leftPrefix_fromRight Z) hf


