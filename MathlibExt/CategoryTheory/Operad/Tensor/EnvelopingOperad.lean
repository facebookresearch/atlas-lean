section EnvelopingSource319


/-!
# Original grouped unit/root/branch block evaluations
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem blockSourceFiring {D : Type*} [Category* D]
    {X A B E Y : D} (a : X ⟶ A) (n : A ⟶ B) (q : B ⟶ Y)
    (p : A ⟶ E) (r : E ⟶ Y) (s : X ⟶ E) (hn : n ≫ q = p ≫ r) (hp : a ≫ p = s) :
    a ≫ n ≫ q = s ≫ r := by
  rw [hn, ← Category.assoc a p, hp]

private theorem blockNaturalReplacement {D : Type*} [Category* D]
    {X A B E Y : D} (p : X ⟶ A) (u : A ⟶ B) (d : X ⟶ E) (e : E ⟶ B) (f : B ⟶ Y)
    (r : X ⟶ Y) (hn : p ≫ u = d ≫ e) (hr : p ≫ u ≫ f = r) : d ≫ e ≫ f = r := by
  exact (Category.assoc d e f).symm.trans
    ((congrArg (· ≫ f) hn.symm).trans ((Category.assoc p u f).trans hr))

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- A real source map into a singleton coefficient/input block
commutes with the original singleton interchange and retained leaves. -/
theorem singletonWeightedSource_normalization (X Z : C) (L : FiniteFamily C)
    (h : Z ⟶ (coefficientLeafTensorFunctor L).obj X) {Y : C} (c : X ⟶ Y)
    {M : FiniteFamily C} (g : L ⟶ M) :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map h) ≫
      (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _ => L)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.singletonIso (V := C)).hom.app X ≫ c)
          ((singletonCoefficientInputLeafIso L).hom ≫ g)) =
    (FiniteTensor.singletonIso (V := C)).hom.app Z ≫ h ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap c g) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map ((FiniteFamily.singleton (C := C)).map h)
  let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _
    => L)).hom
  let q := T.map (coefficientLeafMap ((FiniteTensor.singletonIso (V := C)).hom.app X ≫ c)
    ((singletonCoefficientInputLeafIso L).hom ≫ g))
  let p := (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X)
  let r := T.map (coefficientLeafMap c g)
  let s := (FiniteTensor.singletonIso (V := C)).hom.app Z ≫ h
  have hc : (FiniteTensor.singletonIso (V := C)).inv.app X ≫
      ((FiniteTensor.singletonIso (V := C)).hom.app X ≫ c) = c :=
    ((FiniteTensor.singletonIso (V := C)).app X).inv_hom_id_assoc c
  have hn : n ≫ q = p ≫ r :=
    (singletonInterchange_leafMap X L ((FiniteTensor.singletonIso (V := C)).hom.app X ≫ c) g).trans
      (congrArg (fun c => p ≫ T.map (coefficientLeafMap c g)) hc)
  have hp : a ≫ p = s := (FiniteTensor.singletonIso (V := C)).hom.naturality h
  exact (blockSourceFiring a n q p r s hn hp).trans (Category.assoc _ _ _)

variable {W : Type u}

/-- Original empty-input scalar evaluation enters precisely the
original empty linear coefficient summand with every original input map. -/
theorem emptyScalarSourceInsertion (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {X : C} (c : X ⟶ O.obj P) :
    (emptyLeafTensorIso X).inv ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (c ≫ (O.mapIso (emptyExtensionProfileIso P)).inv)
          (emptyAddedAlgebraInputsIso B).inv) =
      c ≫ (emptyLinearSummandIso O B P).inv := by
  let T := FiniteTensor.tensor (V := C)
  let a := c ≫ (O.mapIso (emptyExtensionProfileIso P)).inv
  let g := (emptyAddedAlgebraInputsIso B).inv
  have hr : T.map (coefficientLeafMap a g) =
      (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map a ≫
        T.map (coefficientLeafMap (𝟙 _) g) :=
    (congrArg T.map ((coefficientLeafMap_pre a (𝟙 _) g).trans
      (congrArg (fun a => coefficientLeafMap a g) (Category.comp_id a))).symm).trans
        (T.map_comp _ _)
  exact (congrArg ((emptyLeafTensorIso X).inv ≫ ·) hr).trans (emptyLinearInsertion O B P c)

/-- The original coefficient/unit map after empty-leaf insertion is
the actual original empty linear summand inverse. -/
theorem emptyScalarTargetInsertion (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {X : C} (c : X ⟶ O.obj P) :
    (c ≫ (O.mapIso (emptyExtensionProfileIso P)).inv) ≫
      (emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs))).inv ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
          (emptyAddedAlgebraInputsIso B).inv) =
      c ≫ (emptyLinearSummandIso O B P).inv := by
  let a := c ≫ (O.mapIso (emptyExtensionProfileIso P)).inv
  let p := (emptyLeafTensorIso X).inv
  let u := (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map a
  let e := (emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs))).inv
  let f := (FiniteTensor.tensor (V := C)).map
    (coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
      (emptyAddedAlgebraInputsIso B).inv)
  have hn : p ≫ u = a ≫ e := (emptyLeafTensorNatIso.inv.naturality a).symm
  exact blockNaturalReplacement p u a e f (c ≫ (emptyLinearSummandIso O B P).inv) hn
    (emptyLinearInsertion O B P c)

/-- The original branch coefficient/profile inverse and all its
actual B inputs are precisely the original nullary linear summand map. -/
theorem branchScalarSourceInsertion (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (R : AnalyticIndex W d) :
    (profileCoefficientLeafTensorIso O B R.toColoredProfile).inv ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.mapIso (nullaryVariableProfileComponentIso d (branchInputs R))).inv
          (branchInputLeafIso B R).hom) =
      (nullaryLinearDiagramIso O B d).inv.app (branchInputs R) :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
    (congrArg (FiniteTensor.tensor (V := C)).map (nullaryLinearFactorsIso_inv O B R))

/-- Every original coefficient group is evaluated by its original
empty/singleton block unitor and original actual coefficient insertion. -/
theorem groupedCoefficientFactor_split (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) (i : (coefficientGrouping O.toCollection
      P Q R).index) :
    groupedCoefficientFactor O P Q R i =
      (frozenVariableBlockIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom.hom i ≫
        (coefficientInsertion O P Q R).hom i := by
  cases i with
  | inl _ => exact (Category.id_comp _).symm
  | inr i => cases i <;> rfl


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
