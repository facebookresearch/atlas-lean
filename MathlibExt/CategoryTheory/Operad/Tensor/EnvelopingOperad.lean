/- Exact checked source: EnvelopingAssociativityNestedRouteA. -/
section EnvelopingSource116


/-!
# Original inner-first association route on the actual nested coefficient source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalNestedRouteAComparison {V : Type*} [Category* V]
    {X A B D E F G H Y : V}
    (p : X ⟶ A) (f : A ⟶ B) (e : D ≅ B) (g : B ⟶ E)
    (s : E ⟶ F) (t : F ⟶ Y) (k : E ⟶ G) (s' : G ⟶ H) (t' : H ⟶ Y) (q : A ⟶ G)
    (hs : s ≫ t = k ≫ s' ≫ t') (hf : f ≫ g ≫ k = q) :
    (p ≫ f ≫ e.inv) ≫ (e.hom ≫ g ≫ s) ≫ t = p ≫ q ≫ s' ≫ t' := by
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  rw [hs]
  rw [← Category.assoc g k, ← Category.assoc f (g ≫ k), hf]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original nested common source contracts along
the original association route A; the exact original outer map
then gives the actual original representative outer substitution. -/
theorem envelopingAssocNestedRouteA_factorization (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedCommonSource O d Q ≫
        ColoredOperadObj.associativityRouteA O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q) ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) =
      envelopingAssocNestedUnitSource O.toCollection d Q ≫
        (FiniteTensor.tensor (V := C)).map (envelopingAssocNestedContractionMap O d Q) ≫
        O.subst.app (envelopingRepresentativeSubstitution d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q)) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q))
          := by
  let T := FiniteTensor.tensor (V := C)
  let p := envelopingAssocNestedUnitSource O.toCollection d Q
  let f := T.map (envelopingAssocNestedFactorsMap O d Q)
  let e := (FiniteTensor.flattenIso (V := C)).app
    (ColoredOperadObj.AssocInsertion.groupingA O.toCollection (envelopingRepresentativeAssoc d Q))
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingAToFactorsHom O.toCollection O.subst
    (envelopingRepresentativeAssoc d Q))
  let k := (ColoredOperadObj.substitutionSource O.toCollection).map
    (envelopingAssocOuterComparison d Q)
  let s := O.subst.app (envelopingRepresentativeAssoc d Q).outerAfterInnerData
  let t := O.toCollection.map (envelopingAssocTotalHom d Q)
  let s' := O.subst.app (envelopingRepresentativeSubstitution d.outerAfterInnerData
    (envelopingAssocOuterChoices d Q))
  let t' := O.toCollection.map (envelopingRepresentativeTotalHom d.outerAfterInnerData
    (envelopingAssocOuterChoices d
    Q))
  have houter : s ≫ t = k ≫ s' ≫ t' := (envelopingAssocOuterSubstitution_naturality O d Q).symm
  have hf : f ≫ g ≫ k = T.map (envelopingAssocNestedContractionMap O d Q) := by
    exact (congrArg (f ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans (congrArg T.map (envelopingAssocNestedFactors_contraction
        O d Q)))
  exact originalNestedRouteAComparison p f e g s t k s' t'
    (T.map (envelopingAssocNestedContractionMap O d Q)) houter hf


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource116

/- Exact checked source: EnvelopingAssociativityRepresentativeRouteA. -/
section EnvelopingSource117


/-!
# The original nested inner-first route is the actual representative substitution route
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalRouteASourceFiring {V : Type*} [Category* V]
    {X A B D E P Q : V} (a : X ⟶ A) (i : A ⟶ B) (m : B ⟶ D) (c : D ⟶ E)
    (k : A ⟶ P) (j : P ⟶ Q) (u : Q ⟶ E) (f : B ⟶ E) (r : B ⟶ Q)
    (h1 : m ≫ c = f) (h2 : f = r ≫ u) (h3 : k ≫ j = i ≫ r) :
    a ≫ i ≫ m ≫ c = a ≫ k ≫ j ≫ u := by
  rw [h1, h2, ← Category.assoc i r, ← h3]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Actual branch contractions and original root-unit tensor
sources give exactly the constructed representative inner-first
coefficient tensor map, with all original unit/profile maps retained. -/
theorem envelopingAssocNestedSource_contraction (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedUnitSource O.toCollection d Q ≫
        (FiniteTensor.tensor (V := C)).map (envelopingAssocNestedContractionMap O d Q) =
      envelopingAssocInnerContraction O d Q ≫
        envelopingRepresentativeCoefficientTensorMap O d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocCoefficientBlocks
    O.toCollection d Q)
  let i := (frozenVariableTensorUnitIso Q.root.index
    ((FiniteFamily.map T).obj (envelopingAssocCoefficientBlocks O.toCollection d Q))).hom
  let m := T.map (envelopingAssocNestedUnitInputMap O.toCollection d Q)
  let c := T.map (envelopingAssocNestedContractionMap O d Q)
  let k := T.map (envelopingAssocInnerContractionMap O d Q)
  let j := (frozenVariableTensorUnitIso Q.root.index
    (envelopingRepresentativeCoefficients O.toCollection d.outerAfterInnerData
      (envelopingAssocOuterChoices d Q))).hom
  let u := T.map (envelopingRepresentativeUnitMap O d.outerAfterInnerData
    (envelopingAssocOuterChoices d Q))
  let f := T.map (envelopingAssocFrozenContractionMap O d Q)
  let r := T.map (Variable.unitFamilyMap (Equiv.refl Q.root.index)
    (envelopingAssocInnerContractionMap O d Q))
  have h1 : m ≫ c = f := (T.map_comp _ _).symm.trans (congrArg T.map
    (envelopingAssocNestedInput_contraction O d Q))
  have h2 : f = r ≫ u :=
    (congrArg T.map (envelopingAssocFrozenContraction_factorization O d Q).symm).trans
      (T.map_comp _ _)
  have h3 : k ≫ j = i ≫ r := Variable.tensorUnitIso_naturality (Equiv.refl Q.root.index)
    (envelopingAssocInnerContractionMap O d Q)
  have h := originalRouteASourceFiring a i m c k j u f r h1 h2 h3
  have hl : envelopingAssocNestedUnitSource O.toCollection d Q ≫ c = (a ≫ i ≫ m) ≫ c := rfl
  have hr : envelopingAssocInnerContraction O d Q ≫
      envelopingRepresentativeCoefficientTensorMap O d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q) =
      (a ≫ k) ≫ (j ≫ u) := rfl
  exact hl.trans ((Category.assoc a (i ≫ m) c).trans
    ((congrArg (a ≫ ·) (Category.assoc i m c)).trans
      (h.trans ((Category.assoc a k (j ≫ u)).symm.trans hr.symm))))

private theorem originalRouteATotalFiring {V : Type*} [Category* V]
    {X A B D Y : V} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ D) (d : D ⟶ Y)
    (r : X ⟶ B) (h : a ≫ b = r) : a ≫ b ≫ c ≫ d = r ≫ c ≫ d := by
  rw [← Category.assoc a b, h]

/-- The original actual operad association route A, on its
constructed nested coefficient/unit source, is exactly the
actual original representative inner-first substitution route. -/
theorem envelopingAssocNestedRouteA_isRepresentative (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedCommonSource O d Q ≫
        ColoredOperadObj.associativityRouteA O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q) ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) =
      envelopingAssocRepresentativeRouteA O d Q := by
  have h := originalRouteATotalFiring
      (envelopingAssocNestedUnitSource O.toCollection d Q)
      ((FiniteTensor.tensor (V := C)).map (envelopingAssocNestedContractionMap O d Q))
      (O.subst.app (envelopingRepresentativeSubstitution d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q)))
      (O.toCollection.map (envelopingRepresentativeTotalHom d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q)))
      (envelopingAssocInnerContraction O d Q ≫
        envelopingRepresentativeCoefficientTensorMap O d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q))
      (envelopingAssocNestedSource_contraction O d Q)
  have hr : envelopingAssocRepresentativeRouteA O d Q = envelopingAssocInnerContraction O d Q ≫
      (envelopingRepresentativeCoefficientTensorMap O d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q) ≫
        O.subst.app (envelopingRepresentativeSubstitution d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q)) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q)))
          := rfl
  exact (envelopingAssocNestedRouteA_factorization O d Q).trans
    (h.trans ((Category.assoc _ _ _).trans hr.symm))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource117

