  have hs : σ ≫ q = h ≫ σ' := (E.subst.naturality a).symm
  have ht : E.toCollection.map (ColoredSubstitutionData.totalProfileMap a ≫
    generalTotalHom s (Q none)) = q ≫ k :=
    E.toCollection.map_comp _ _
  exact (congrArg (fun q => x ≫ ColoredOperadObj.associativityRouteA E.toCollection
    E.subst d ≫ q) ht).trans
    ((branchRouteFiring x f g σ q k h σ' n hs hn).trans (Category.assoc p m (σ' ≫ k)))

theorem insideRoute_rootContract (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    insideRoute E s Q =
      ((FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q) ≫
        (FiniteTensor.tensor (V := C)).map (branchEvaluationFactorMap E s Q)) ≫
          Root.sequentialRoute E s (Q none) := by
  let T := FiniteTensor.tensor (V := C)
  let p := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q)
  let f := T.map (branchEvaluationFactorMap E s Q)
  let g := T.map (Root.generalFactorMap E.toCollection s (Q none))
  let σ := E.subst.app (generalSubstitution s (Q none))
  let h := E.toCollection.map (generalTotalHom s (Q none))
  have hm : T.map (collapsedFactorsA E s Q) = f ≫ g := T.map_comp _ _
  exact (congrArg (p ≫ · ≫ σ ≫ h) hm).trans
    ((factorIntoRoot p f g σ h).trans
      (congrArg ((p ≫ f) ≫ ·) (Root.generalRoute_eq_sequential E s (Q none))))


