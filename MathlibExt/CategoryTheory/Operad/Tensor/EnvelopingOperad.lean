theorem restrictionMapTriangle_hom {O P Q : ColoredOperadObj W C}
    (u : O ⟶ P) (v : P ⟶ Q) (w : O ⟶ Q) (h : u ≫ v = w)
    {M : Algebra P} {N : Algebra Q} (f : M ⟶ Algebra.restrict v N) :
    (restrictionMapTriangle u v w h f).hom = f.hom := rfl


