map at its original nullary coefficient, color by color. -/
def operadNullaryCarrierFunctor : ColoredOperadObj W C ⥤ (W → C) where
  obj E d := E.toCollection.obj (ColoredProfile.nullary d)
  map f d := f.toCollectionHom.app (ColoredProfile.nullary d)
