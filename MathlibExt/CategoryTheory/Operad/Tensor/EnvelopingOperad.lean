section EnvelopingSource180


/-!
# Original representative injections detect linear coefficient substitution maps
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

private theorem originalIsoCofanExt {V : Type*} [Category* V]
    {J : Type*} [Category* J] {F : J ⥤ V} (c : Cocone F) (hc : IsColimit c)
    {X Y : V} (e : c.pt ≅ X) {f g : X ⟶ Y}
    (h : ∀ j, (c.ι.app j ≫ e.hom) ≫ f = (c.ι.app j ≫ e.hom) ≫ g) : f = g := by
  have hp : e.hom ≫ f = e.hom ≫ g := hc.hom_ext (by
    intro j
    exact (Category.assoc _ _ _).symm.trans ((h j).trans (Category.assoc _ _ _)))
  exact (cancel_epi e.hom).1 hp

/-- Full original morphism extensionality follows from the actual
finite coefficient colimit and exact original root/branch injections. -/
theorem envelopingLinearSubstitution_hom_ext (O : ColoredSymmetricCollection W C)
    (A : W → C) (s : ColoredSubstitutionData W) {Y : C}
    {f g : (ColoredOperadObj.substitutionSource (linearCoefficientCollection O A)).obj s ⟶ Y}
    (h : ∀ Q : EnvelopingInputChoices s,
      envelopingLinearSubstitutionInjection O A s Q ≫ f =
        envelopingLinearSubstitutionInjection O A s Q ≫ g) : f = g :=
  originalIsoCofanExt (envelopingLinearTensorCocone O A s) (envelopingLinearTensorIsColimit O A s)
    (envelopingLinearTensorPointIso O A s) h

/-- The actual tensor of original coefficient quotient maps is
the map that will define quotient substitution; no descended
substitution or compatibility outcome is supplied as input. -/
def envelopingSubstitutionProjection (O : ColoredOperadObj W C) (A : Algebra O)
    (s : ColoredSubstitutionData W) :
    (ColoredOperadObj.substitutionSource (linearCoefficientCollection O.toCollection
      A.carrier)).obj s ⟶
      (ColoredOperadObj.substitutionSource (Variable.envelopingCoefficientCollection O A)).obj s :=
  (FiniteTensor.tensor (V := C)).map
    { equiv := Equiv.refl (Option s.inner.index)
      hom i := match i with
        | none => envelopingCoefficientπ O A s.outerProfile
        | some i => envelopingCoefficientπ O A (s.inner.obj i) }

/-- Original linear substitution followed by the original total
coefficient quotient, before descent through each source quotient. -/
def envelopingSubstitutionBeforeQuotient (O : ColoredOperadObj W C) (A : Algebra O)
    (s : ColoredSubstitutionData W) :
    (ColoredOperadObj.substitutionSource (linearCoefficientCollection O.toCollection
      A.carrier)).obj s ⟶
      envelopingCoefficientObj O A s.totalProfile :=
  envelopingLinearSubstitution O A.carrier s ≫ envelopingCoefficientπ O A s.totalProfile

/-- The actual representative beta rule keeps the total quotient
and every original root/inner tensor and profile map. -/
theorem envelopingSubstitutionBeforeQuotient_β (O : ColoredOperadObj W C) (A : Algebra O)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingLinearSubstitutionInjection O.toCollection A.carrier s Q ≫
        envelopingSubstitutionBeforeQuotient O A s =
      (FiniteTensor.tensor (V := C)).map (envelopingLinearWeightedFamilyIso O.toCollection
        A.carrier s Q).hom ≫
        envelopingRepresentativeColimitEvaluation O A.carrier s Q ≫
          envelopingCoefficientπ O A s.totalProfile := by
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ envelopingCoefficientπ O A s.totalProfile)
      (envelopingLinearSubstitution_β O A.carrier s Q)).trans (Category.assoc _ _ _))


end CategoryTheory.Operad.Tensor.Enveloping

end
