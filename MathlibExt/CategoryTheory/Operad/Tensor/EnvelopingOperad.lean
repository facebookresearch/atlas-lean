      T.map (coefficientLeafMap (T.map k ≫ envelopingAssocMiddleCoefficientSubstitution O d Q)
        (envelopingAssocMiddleLeafIso B d Q).hom) := by
    exact (Category.assoc _ _ _).trans (congrArg (n.hom ≫ ·) hcompT)
