/-!
# The original weighted constant-input route on its exact grouped atomic source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem groupedAssociateFour {D : Type*} [Category* D]
    {X A B E Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ E) (d : E ⟶ Y) :
    a ≫ b ≫ c ≫ d = (a ≫ b ≫ c) ≫ d := by simp only [Category.assoc]

private theorem wholeGroupedRouteFiring {D : Type*} [Category* D]
    {X A B C E F G H J K Y : D}
    (p : X ⟶ A) (b : A ⟶ B) (c : B ⟶ C) (d : C ⟶ E) (r : E ⟶ F) (q : F ⟶ Y)
    (e : B ⟶ G) (f : G ⟶ E) (i : G ⟶ H) (j : H ⟶ Y)
    (a : A ⟶ J) (n : J ⟶ K) (s : K ⟶ H) (t : K ⟶ Y)
    (hs : c ≫ d = e ≫ f) (ht : f ≫ r ≫ q = i ≫ j)
    (hg : b ≫ e ≫ i = a ≫ n ≫ s) (hp : s ≫ j = t) :
    (p ≫ b ≫ c) ≫ d ≫ r ≫ q = p ≫ a ≫ n ≫ t := by
  simp only [Category.assoc]
  rw [← Category.assoc c d, hs]
  simp only [Category.assoc]
  rw [ht]
  have htail : b ≫ e ≫ i ≫ j = a ≫ n ≫ s ≫ j := by
    simpa only [Category.assoc] using congrArg (· ≫ j) hg
  rw [htail, hp]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The literal original weighted constant-input representative
route is its original grouped atomic normalizer, exact original
coefficient flattening and original frozen partial substitution,
with the full original total B-leaf map retained. -/
theorem weightedRepresentative_groupedNormalization (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenVariableTensorUnitIso P.inputs (frozenWeightedBranchFamily O.toCollection B P Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map (weightedInsertion O B P Q R) ≫
      envelopingRepresentativeEvaluation O B (shape P Q) (choices P Q R) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
          ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom)) =
    (FiniteTensor.tensor (V := C)).map
      (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily O.toCollection B P Q R)).inv ≫
      (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso O.toCollection B P Q
          R).hom) ≫
      Grouping.flatAtomicNormalization (coefficientGrouping O.toCollection P Q R)
        (atomicLeaves O.toCollection B P Q R)
        ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map
            (frozenVariableFlattenIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom ≫
            frozenPartialSubstitution O P Q R)
          (groupedTotalLeafMap O B P Q R)) := by
  let T := FiniteTensor.tensor (V := C)
  let N := coefficientGrouping O.toCollection P Q R
  let L := atomicLeaves O.toCollection B P Q R
  let V := weightedSourceBlocks O.toCollection B P Q R
  let S := shape P Q
  let Q' := choices P Q R
  let κ := groupedCoefficientFactor O P Q R
  let ℓ := fun i => (groupedLeafBlockIso O B P Q R i).hom
  let u₀ := (FiniteFamily.map T).map (groupedWeightedSourceIso O.toCollection B P Q R).hom
  let u₁ := groupedCoefficientInputNormalizationMap N L
  let u₂ := weightedInputBlockMap N.index κ ℓ
  let e₀ := u₀ ≫ u₁ ≫ u₂
  let w₀ := (groupedTargetWeightedIso O B P Q R).hom
  let p := T.map (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily
    O.toCollection B P Q R)).inv
  let b := (FiniteTensor.flattenIso (V := C)).hom.app V
  let c₀ := (frozenVariableBlockIso P.inputs (frozenWeightedBranchFamily O.toCollection B
    P Q R)).hom
  let c := T.map c₀
  let d₀ := weightedInsertion O B P Q R
  let d := T.map d₀
  let r := envelopingRepresentativeEvaluation O B S Q'
  let q := T.map (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
    ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom))
  let e := T.map e₀
  let f := T.map w₀
  let i := (coefficientBlockInterchangeTensorIso N.index (targetCoefficients O P Q R)
    (targetLeaves O B P Q R)).hom
  let kFull := T.map (groupedTargetCoefficientIso O P Q R).hom ≫
    envelopingRepresentativeCoefficientSubstitution O S Q' ≫
      O.toCollection.map (totalProfileHom P Q R)
  let targetLeaf := (groupedTargetLeavesIso O B P Q R).hom
  let j := T.map (coefficientLeafMap kFull targetLeaf)
  let a := T.map ((FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso
    O.toCollection B P Q R).hom)
  let n := groupedCoefficientInputNormalization N L
  let κTensor := T.map (coefficientBlockMap N.index κ)
  let ℓTotal := (FiniteFamily.flatten (C := C)).map (inputBlockMap N.index ℓ)
  let s := T.map (coefficientLeafMap κTensor ℓTotal)
  let kGroup := κTensor ≫ kFull
  let leaf := groupedTotalLeafMap O B P Q R
  let t := T.map (coefficientLeafMap kGroup leaf)
  have hPrefix : (frozenVariableTensorUnitIso P.inputs (frozenWeightedBranchFamily
    O.toCollection B P Q R)).hom = p ≫ b
    ≫ c := rfl
  have hsource : c₀ ≫ d₀ = e₀ ≫ w₀ :=
    (groupedWeightedBlocks_factor O B P Q R).symm.trans (groupedAssociateFour u₀ u₁ u₂ w₀)
  have hs : c ≫ d = e ≫ f := (T.map_comp _ _).symm.trans
    ((congrArg T.map hsource).trans (T.map_comp _ _))
  have ht : f ≫ r ≫ q = i ≫ j := groupedTarget_normalization O B P Q R
  have hg : b ≫ e ≫ i = a ≫ n ≫ s :=
    Linear.UnitGeometry.groupedBlocksCoefficientInputs N L (groupedWeightedSourceIso
      O.toCollection B P Q R)
      (targetCoefficients O P Q R) (targetLeaves O B P Q R) κ ℓ
  have hp : s ≫ j = t := (T.map_comp _ _).symm.trans
    (congrArg T.map (coefficientLeafMap_comp κTensor kFull ℓTotal targetLeaf))
  have hWhole : (p ≫ b ≫ c) ≫ d ≫ r ≫ q = p ≫ a ≫ n ≫ t :=
    wholeGroupedRouteFiring p b c d r q e f i j a n s t hs ht hg hp
  let flat := Grouping.flatAtomicNormalization N L
  let coef := T.map (frozenVariableFlattenIso P.inputs (frozenCoefficientFamily
    O.toCollection P Q R)).hom ≫
    frozenPartialSubstitution O P Q R
  have hcoef : (FiniteTensor.flattenIso (V := C)).hom.app N ≫ kGroup = coef :=
    groupedCoefficient_normalization O P Q R
  have hNorm : n ≫ t = flat ≫ T.map (coefficientLeafMap coef leaf) :=
    (Linear.UnitGeometry.normalizeGroupedPostMap N L kGroup leaf).trans
      (congrArg (fun c => flat ≫ T.map (coefficientLeafMap c leaf)) hcoef)
  exact (congrArg (fun p => p ≫ d ≫ r ≫ q) hPrefix).trans
    (hWhole.trans (congrArg (p ≫ a ≫ ·) hNorm))


