namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original tensor blocks retain root, middle and inner
coefficients, together with two original unit factors at each retained root algebra position. -/
def envelopingAssocNestedUnitBlocks (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option (d.branches.index ⊕ Q.root.index))
  obj i := match i with
    | none => (FiniteFamily.singleton (C := C)).obj (O.obj (extendProfile
      d.middleData.outerProfile Q.root))
    | some (Sum.inl i) => envelopingRepresentativeCoefficients O (d.localData i) (Q.branch i)
    | some (Sum.inr _) => retainedRootUnitFamily (C := C)

/-- The actual original root singleton, branch unit insertion,
and identity retained-root-unit family give the original association grouping. -/
def envelopingAssocNestedFactorsMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (envelopingAssocNestedUnitBlocks
      O.toCollection d Q) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (ColoredOperadObj.AssocInsertion.groupingA O.toCollection
          (envelopingRepresentativeAssoc d Q)) where
  equiv := Equiv.refl (Option (d.branches.index ⊕ Q.root.index))
  hom i := match i with
    | none => (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.singleton (C := C)).map (O.toCollection.map (envelopingAssocRootHom d Q)))
    | some (Sum.inl i) => envelopingRepresentativeCoefficientTensorMap O (d.localData i)
      (Q.branch i)
    | some (Sum.inr j) => (FiniteTensor.tensor (V := C)).map (retainedRootUnitFamilyMap O
      (Q.root.obj j).as)

/-- The original root algebra tensor units are distributed as actual
two-unit branch tensors alongside the actual original coefficient blocks. -/
def envelopingAssocNestedUnitInputFamily (O : ColoredSymmetricCollection W C) (d :
  ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily C :=
  frozenVariableUnitFamily Q.root.index
    ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (envelopingAssocCoefficientBlocks O d Q))

/-- The exact original root-unit/retained coefficient-block bijection. -/
def envelopingAssocNestedUnitInputEquiv (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    Q.root.index ⊕ Option d.branches.index ≃ Option (d.branches.index ⊕ Q.root.index) where
  toFun p := match p with
    | Sum.inl j => some (Sum.inr j)
    | Sum.inr none => none
    | Sum.inr (some i) => some (Sum.inl i)
  invFun p := match p with
    | none => Sum.inr none
    | some (Sum.inl i) => Sum.inr (some i)
    | some (Sum.inr j) => Sum.inl j
  left_inv p := by cases p with
    | inl j => rfl
    | inr i => cases i <;> rfl
  right_inv p := by cases p with
    | none => rfl
    | some i => cases i <;> rfl

/-- The actual original two-unit source for each retained root
algebra branch, with every original retained coefficient block unchanged. -/
def envelopingAssocNestedUnitInputMap (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedUnitInputFamily O d Q ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (envelopingAssocNestedUnitBlocks
        O d Q) where
  equiv := envelopingAssocNestedUnitInputEquiv d Q
  hom p := match p with
    | Sum.inl _ => retainedRootUnitTensorSource (C := C)
    | Sum.inr none => 𝟙 _
    | Sum.inr (some _) => 𝟙 _

/-- The actual original coefficient tensor enters the nested
unit/branch source by its original flattening and root unit insertion. -/
def envelopingAssocNestedUnitSource (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O d Q) ⟶
      (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
          (envelopingAssocNestedUnitBlocks O d Q)) :=
  (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocCoefficientBlocks O d Q) ≫
    (frozenVariableTensorUnitIso Q.root.index
      ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (envelopingAssocCoefficientBlocks O d Q))).hom ≫
    (FiniteTensor.tensor (V := C)).map (envelopingAssocNestedUnitInputMap O d Q)

/-- The actual nested source map to the common source of
the original operad associativity law, retaining every original map. -/
def envelopingAssocNestedCommonSource (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      ColoredOperadObj.associativityCommonSource O.toCollection
        (envelopingRepresentativeAssoc d Q) :=
  envelopingAssocNestedUnitSource O.toCollection d Q ≫
    (FiniteTensor.tensor (V := C)).map (envelopingAssocNestedFactorsMap O d Q) ≫
    (FiniteTensor.flattenIso (V := C)).inv.app
      (ColoredOperadObj.AssocInsertion.groupingA O.toCollection (envelopingRepresentativeAssoc d Q))


