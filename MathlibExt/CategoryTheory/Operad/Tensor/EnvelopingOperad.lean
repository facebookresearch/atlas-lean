/- Exact checked source: WeightedNormalization.ConstantExtensionOperad. -/
section EnvelopingSource278


/-!
# The actual constants colimit descent is a full map of the actual linear operad
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

private theorem extensionCofanFiring {D : Type*} [Category* D] {A B C E F G : D}
    (q : A ⟶ B) (l : B ⟶ C) (ext : C ⟶ E) (h : B ⟶ F) (s : F ⟶ E)
    (r : A ⟶ G) (i : G ⟶ C) (eval : G ⟶ E) (p : A ⟶ F)
    (hb : q ≫ l = r ≫ i) (hi : i ≫ ext = eval) (hr : r ≫ eval = p ≫ s) (hs : q ≫ h = p) :
    q ≫ (l ≫ ext) = q ≫ (h ≫ s) := by
  calc
    q ≫ (l ≫ ext) = (q ≫ l) ≫ ext := (Category.assoc q l ext).symm
    _ = (r ≫ i) ≫ ext := congrArg (· ≫ ext) hb
    _ = r ≫ eval := (Category.assoc r i ext).trans (congrArg (r ≫ ·) hi)
    _ = p ≫ s := hr
    _ = q ≫ (h ≫ s) := (congrArg (· ≫ s) hs.symm).trans (Category.assoc q h s)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The actual original coefficient cofans followed by the actual constants
colimit descent are exactly the tensor factors of the original representatives. -/
theorem representativeCofan_extension {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    Linear.representativeCofanMap O.toCollection B s Q ≫
      ColoredOperadObj.HomData.factorHom (collectionMap u B b) s =
      representativeSlotFamily u B b s Q := by
  refine (congrArg (· ≫ ColoredOperadObj.HomData.factorHom (collectionMap u B b) s)
    (Linear.representativeCofanMap_eq O.toCollection B s Q)).trans ?_
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (extension_β u B b s.outerProfile (Q none))
    | some i => exact heq_of_eq (extension_β u B b (s.inner.obj i) (Q (some i)))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Actual joint coefficient-colimit extensionality proves simultaneous
substitution preservation for the literal original constants colimit descent. -/
theorem extension_substitution {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s : ColoredSubstitutionData W) :
    envelopingLinearSubstitution O B s ≫ extension u B b s.totalProfile =
      ColoredOperadObj.HomData.sourceHom (collectionMap u B b) s ≫ E.subst.app s := by
  apply envelopingLinearSubstitution_hom_ext O.toCollection B s
  intro Q
  let T := FiniteTensor.tensor (V := C)
  let q := T.map (Linear.representativeCofanMap O.toCollection B s Q)
  let l := envelopingLinearSubstitution O B s
  let ext := extension u B b s.totalProfile
  let h := ColoredOperadObj.HomData.sourceHom (collectionMap u B b) s
  let σ := E.subst.app s
  let r := envelopingRepresentativeEvaluation O B s Q
  let i := linearCoefficientι O.toCollection B s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let eval := representative u B b s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let p := T.map (representativeSlotFamily u B b s Q)
  have hb : q ≫ l = r ≫ i := Linear.representativeCofanMap_β O B s Q
  have hi : i ≫ ext = eval := extension_β u B b s.totalProfile (envelopingTotalAlgebraInputs s Q)
  have hr : r ≫ eval = p ≫ σ := representative_substitution u B b s Q
  have hs : q ≫ h = p := (T.map_comp _ _).symm.trans (congrArg T.map
    (representativeCofan_extension u B b s Q))
  have hι : envelopingLinearSubstitutionInjection O.toCollection B s Q = q :=
    (envelopingLinearSubstitutionInjection_readback O.toCollection B s Q).trans
      (congrArg T.map (Linear.representativeCofanMap_eq O.toCollection B s Q).symm)
  exact (congrArg (· ≫ (l ≫ ext)) hι).trans
    ((extensionCofanFiring q l ext h σ r i eval p hb hi hr hs).trans (congrArg (· ≫ (h
      ≫ σ)) hι.symm))

/-- The actual constants extension uses the original nullary partial
substitution and original coefficient colimit descent. Its complete unit
and simultaneous substitution laws are derived from the target's laws. -/
def operadMap {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) :
      envelopingLinearOperad O B ⟶ E where
  toCollectionHom := collectionMap u B b
  map_unit := extension_unit u B b
  map_subst := extension_substitution u B b

theorem operadMap_collection {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) :
    (operadMap u B b).toCollectionHom = collectionMap u B b := rfl

theorem operadMap_app {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    (operadMap u B b).toCollectionHom.app P = extension u B b P := rfl

theorem operadMap_β {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile
      W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫ (operadMap u B b).toCollectionHom.app P =
      representative u B b P Q :=
  extension_β u B b P Q

/-- The full original O-operation inclusion followed by the actual
constants extension is exactly the originally supplied full operad map. -/
theorem operadMap_original {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) :
    originalOperationToLinearOperadMap O B ≫ operadMap u B b = u := by
  apply ColoredOperadObj.Hom.ext
  apply NatTrans.ext
  funext P
  exact extension_original u B b P


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource278

/- Exact checked source: ReflexiveOperad.ConstantAlgebraRestriction. -/
section EnvelopingSource279


/-!
# Genuine restriction along the constructed constants operad map and original cofan beta
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory Limits

private theorem cofanFold {V : Type*} [Category* V] {X A B D F Y : V}
    (i : X ⟶ A) (p : A ⟶ B) (o : B ⟶ Y) (ext : A ⟶ D) (q : D ⟶ F) (o' : F ⟶ Y)
    (rep : X ⟶ D) (ev : X ⟶ Y)
    (hr : p ≫ o = ext ≫ q ≫ o') (hc : i ≫ ext = rep) (he : rep ≫ q ≫ o' = ev) :
    i ≫ p ≫ o = ev := by
  have h1 : i ≫ p ≫ o = i ≫ ext ≫ q ≫ o' := congrArg (i ≫ ·) hr
  have h2 : i ≫ ext ≫ q ≫ o' = rep ≫ q ≫ o' := by
    simpa only [Category.assoc] using congrArg (fun z => z ≫ q ≫ o') hc
  exact h1.trans (h2.trans he)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original full operad map preserves the exact original
coefficient/variable profile comparison at every original profile. -/
theorem restriction_profile_square {O E : ColoredOperadObj W C} (u : O ⟶ E) (M : Algebra
  E) (P : ColoredProfile W) :
    (profileOperationFactorsIso O.toCollection M.carrier P).hom ≫
      (analyticFactorsCollectionMap M.carrier u.toCollectionHom).app (profileInputs P) =
    (coefficientLeafFamilyFunctor (profileLeafFamily M.carrier P)).map (u.toCollectionHom.app P) ≫
      (profileOperationFactorsIso E.toCollection M.carrier P).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let a := u.toCollectionHom.app P
        change HEq (𝟙 _ ≫ a) (a ≫ 𝟙 _)
        exact heq_of_eq ((Category.id_comp a).trans (Category.comp_id a).symm)
    | some i => exact HEq.rfl

/-- The genuine restricted operation retains its original coefficient
map, original unchanged variable family and both original profile tensor comparisons. -/
theorem restriction_profile {O E : ColoredOperadObj W C} (u : O ⟶ E) (M : Algebra E) (P :
  ColoredProfile W) :
    (profileCoefficientLeafTensorIso O.toCollection M.carrier P).hom ≫
      (Algebra.restrict u M).operations.app P.outputColor (profileInputs P) =
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map (u.toCollectionHom.app P) ≫
      (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
        M.operations.app P.outputColor (profileInputs P) := by
  let T := FiniteTensor.tensor (V := C)
  let p := (profileCoefficientLeafTensorIso O.toCollection M.carrier P).hom
  let m := (analyticSummandCollectionMap M.carrier u.toCollectionHom).app (profileInputs P)
  let f := (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
    (u.toCollectionHom.app P)
  let q := (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom
  let o := M.operations.app P.outputColor (profileInputs P)
  have h : p ≫ m = f ≫ q := (T.map_comp _ _).symm.trans
    ((congrArg T.map (restriction_profile_square u M P)).trans (T.map_comp _ _))
  exact (Category.assoc p m o).symm.trans ((congrArg (· ≫ o) h).trans (Category.assoc f q o))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Restriction uses the constructed original full constants operad map,
so every algebra law and whole Hom map is the genuine canonical restriction. -/
def constantRestrictionFunctor {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) :
    Algebra E ⥤ Algebra (envelopingLinearOperad O B) :=
  restrictionFunctor (Linear.Constants.operadMap u B b)

@[simp]
theorem constantRestriction_carrier {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E) :
    ((constantRestrictionFunctor u B b).obj M).carrier = M.carrier := rfl

@[simp]
theorem constantRestriction_map_hom {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) {M N : Algebra E} (h : M ⟶ N) :
    ((constantRestrictionFunctor u B b).map h).hom = h.hom := rfl

/-- Every original coefficient cofan of the genuine restricted algebra
is exactly the original representative evaluation in the original O restriction,
with each supplied constant b evaluated by the genuine original M nullary operation. -/
theorem restriction_cofan_beta {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map (linearCoefficientι
      O.toCollection B P Q) ≫
      (profileCoefficientLeafTensorIso (linearCoefficientCollection O.toCollection B)
        M.carrier P).hom ≫
        ((constantRestrictionFunctor u B b).obj M).operations.app P.outputColor (profileInputs P) =
    LinearAlgebra.representativeEvaluation O B (Algebra.restrict u M) (constantValueMap B b
      M) P Q := by
  let U := coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)
  let f := Linear.Constants.operadMap u B b
  let i := U.map (linearCoefficientι O.toCollection B P Q)
  let p := (profileCoefficientLeafTensorIso (linearCoefficientCollection O.toCollection B)
    M.carrier P).hom
  let o := ((constantRestrictionFunctor u B b).obj M).operations.app P.outputColor (profileInputs P)
  let ext := U.map (f.toCollectionHom.app P)
  let q := (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom
  let o' := M.operations.app P.outputColor (profileInputs P)
  let rep := U.map (Linear.Constants.representative u B b P Q)
  let ev := LinearAlgebra.representativeEvaluation O B (Algebra.restrict u M)
    (constantValueMap B b M) P Q
  have hr : p ≫ o = ext ≫ q ≫ o' := restriction_profile f M P
  have hc : i ≫ ext = rep := (U.map_comp _ _).symm.trans
    (congrArg U.map (Linear.Constants.operadMap_β u B b P Q))
  have he : rep ≫ q ≫ o' = ev := representative_evaluation u B b M P Q
  exact cofanFold i p o ext q o' rep ev hr hc he

omit [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- The actual original operation injection contains precisely its
original coefficient cofan and original full profile tensor comparison. -/
theorem operationInjection_readback (O : ColoredSymmetricCollection W C) (B A : W → C)
    {d : W} (P : AnalyticIndex W d) (Q : ColoredInputs W) :
    LinearAlgebra.operationInjection O B A P Q =
      (coefficientLeafTensorFunctor (profileLeafFamily A P.toColoredProfile)).map
        (linearCoefficientι O B P.toColoredProfile Q) ≫
        (profileCoefficientLeafTensorIso (linearCoefficientCollection O B) A
          P.toColoredProfile).hom := rfl

/-- The canonical original operation injection has the complete
genuine restricted operation beta, retaining its original coefficient cofan. -/
theorem restriction_operationInjection_beta {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E)
    (d : W) (P : AnalyticIndex W d) (Q : ColoredInputs W) :
    LinearAlgebra.operationInjection O.toCollection B M.carrier P Q ≫
      ((constantRestrictionFunctor u B b).obj M).operations.app d P =
    LinearAlgebra.representativeEvaluation O B (Algebra.restrict u M) (constantValueMap B b
      M) P.toColoredProfile Q :=
  (congrArg (· ≫ ((constantRestrictionFunctor u B b).obj M).operations.app d P)
    (operationInjection_readback O.toCollection B M.carrier P Q)).trans
    ((Category.assoc _ _ _).trans (restriction_cofan_beta u B b M P.toColoredProfile Q))

/-- The original coefficient cofans determine every operation of the
genuine constants restriction; all original nullary and heterogeneous profiles remain. -/
theorem constantRestriction_operations {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E) :
    ((constantRestrictionFunctor u B b).obj M).operations =
      LinearAlgebra.linearOperations O B (Algebra.restrict u M) (constantValueMap B b M) := by
  apply Operations.ext
  funext d P
  apply LinearAlgebra.operation_hom_ext O.toCollection B M.carrier P
  intro Q
  exact (restriction_operationInjection_beta u B b M d P Q).trans
    (LinearAlgebra.linearOperations_beta O B (Algebra.restrict u M) (constantValueMap B b M)
      d P Q).symm


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

end
