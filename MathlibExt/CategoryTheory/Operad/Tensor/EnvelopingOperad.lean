the original operation-weighted analytic tensor diagram, including
every empty algebra-input summand and original permutation. -/
def nullaryLinearDiagramIso (O : ColoredSymmetricCollection W C) (B : W → C) (d : W) :
    linearCoefficientDiagram O B (ColoredProfile.nullary d) ≅
      inputsToProfile d ⋙ analyticSummand O B :=
  Functor.isoWhiskerRight (nullaryLinearFactorsIso O B d) FiniteTensor.tensor


end CategoryTheory.Operad.Tensor.Enveloping

