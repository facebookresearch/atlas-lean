/- Exact checked source: WeightedNormalization.LinearLeftUnit. -/
section EnvelopingSource205


/-!
# Left unit law of the exact original linear coefficient substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory Limits

private theorem weightLeftNormalization {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    ((a ≫ b) ≫ c) ≫ d = a ≫ ((b ≫ c) ≫ d) := by simp only [Category.assoc]

private theorem descendLeftUnit {D : Type*} [Category* D] {A B C E F : D}
    (ι : A ⟶ B) (u : B ⟶ C) (s : C ⟶ E) (f : E ⟶ B)
    (w : A ⟶ F) (k : F ⟶ C) {G : D} (e : F ⟶ G) (j : G ⟶ E) (p : G ⟶ A)
    (hi : ι ≫ u = w ≫ k) (hs : k ≫ s = e ≫ j) (hf : j ≫ f = p ≫ ι)
    (hu : (w ≫ e) ≫ p = 𝟙 A) : ι ≫ u ≫ s ≫ f = ι := by
  calc
    ι ≫ u ≫ s ≫ f = (ι ≫ u) ≫ s ≫ f := by simp only [Category.assoc]
    _ = (w ≫ k) ≫ s ≫ f := congrArg (fun i => i ≫ s ≫ f) hi
    _ = (w ≫ e) ≫ j ≫ f := by
      simpa only [Category.assoc] using congrArg (fun i => w ≫ i ≫ f) hs
    _ = (w ≫ e) ≫ (p ≫ ι) := congrArg ((w ≫ e) ≫ ·) hf
    _ = ((w ≫ e) ≫ p) ≫ ι := by simp only [Category.assoc]
    _ = ι := (congrArg (· ≫ ι) hu).trans (Category.id_comp ι)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Complete original weighted left-unit evaluation is the identity
on its original coefficient and every original heterogeneous input,
including empty inputs, after the exact original total-profile maps. -/
theorem leftUnitWeightedEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (leftUnitWeightedInsertion O B P Q ≫
        envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.leftUnit P)
          (leftUnitChoices P Q)) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
          (leftUnitInputsIso P Q).hom))
        ((addedAlgebraInputs B).map (leftUnitInputsIso P Q).hom)) =
    𝟙 ((linearCoefficientDiagram O.toCollection B P).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let L := (addedAlgebraInputs B).obj Q
  let U := coefficientLeafTensorFunctor L
  let Y := O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
    P.outputColor) emptyColoredInputs)
  let K := sparseUnitScalarFamily Y X
  let w := UnitInsertion.leftInsertFromFactor (U.obj X) (UnitGeometry.leftWeightedFactor X L
    Y (leftUnitCoefficient O
    P))
  let b := T.map (leftUnitWeightedFamilyIso O.toCollection B P Q).hom
  let e := envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.leftUnit P)
    (leftUnitChoices P Q)
  let p := T.map (coefficientLeafMap
    (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
      (leftUnitInputsIso P Q).hom))
    ((addedAlgebraInputs B).map (leftUnitInputsIso P Q).hom))
  let i := (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option PUnit)) K.obj
    (UnitGeometry.leftLeaves L)).hom
  let a := UnitInsertion.leftInsertFromFactor X (UnitGeometry.leftCoefficientFactor X Y
    (leftUnitCoefficient O P))
  let c := T.map (leftUnitCoefficientFamilyIso O.toCollection P Q).hom ≫
    envelopingRepresentativeCoefficientSubstitution O (ColoredSubstitutionData.leftUnit P)
      (leftUnitChoices P Q) ≫
    O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
      (leftUnitInputsIso P Q).hom)
  let q := T.map (coefficientLeafMap (𝟙 (T.obj K)) (UnitGeometry.leftLeavesIso L).hom)
  let d := T.map (coefficientLeafMap c (UnitGeometry.leftLeavesIso L).hom)
  have hn : (b ≫ e) ≫ p = i ≫ d := leftUnitEvaluation_normalized O B P Q
  have hp : w ≫ i ≫ d = (w ≫ i ≫ q) ≫ U.map c :=
    UnitGeometry.interchangeSourcePostCoefficient (FintypeCat.of (Option PUnit)) K.obj
      (UnitGeometry.leftLeaves L) w c (UnitGeometry.leftLeavesIso L).hom
  have hq : (w ≫ i) ≫ q = U.map a := UnitGeometry.leftWeightedPrefix_coherence X L Y
    (leftUnitCoefficient O P)
  have hc : a ≫ c = 𝟙 X := (Category.assoc a (T.map (leftUnitCoefficientFamilyIso
    O.toCollection P Q).hom)
    (envelopingRepresentativeCoefficientSubstitution O (ColoredSubstitutionData.leftUnit P)
      (leftUnitChoices P Q) ≫
      O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
        (leftUnitInputsIso P
        Q).hom))).symm.trans
        (leftRepresentativeCoefficient_unit O P Q)
  exact (weightLeftNormalization w b e p).trans
    ((congrArg (w ≫ ·) hn).trans
      (hp.trans ((congrArg (· ≫ U.map c) (Category.assoc w i q).symm).trans
        ((congrArg (· ≫ U.map c) hq).trans
          ((U.map_comp a c).symm.trans ((congrArg U.map hc).trans (U.map_id X)))))))

end CategoryTheory.Operad.Tensor.Enveloping.Linear

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The original no-added-input O-unit is a genuine left unit for
the literal original linear coefficient natural substitution, proved
on every original coefficient colimit leg with all original maps retained. -/
theorem envelopingLinearSubstitution_left_unit (O : ColoredOperadObj W C) (B : W → C) :
    ColoredOperadObj.IsLeftUnit (linearCoefficientCollection O.toCollection B)
      (envelopingLinearUnit O B)
      (envelopingLinearSubstitutionMap O B) := by
  intro P
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  let T := FiniteTensor.tensor (V := C)
  let L := linearCoefficientCollection O.toCollection B
  let q := Linear.leftUnitChoices P Q
  let ι := linearCoefficientι O.toCollection B P Q
  let u := ColoredOperadObj.leftUnitInsert L (envelopingLinearUnit O B) P
  let s := envelopingLinearSubstitution O B (ColoredSubstitutionData.leftUnit P)
  let f := L.map (ColoredSubstitutionData.leftUnitTotalHom P)
  let w := Linear.leftUnitWeightedInsertion O B P Q
  let k := T.map (Linear.representativeCofanMap O.toCollection B
    (ColoredSubstitutionData.leftUnit P) q)
  let e := envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.leftUnit P) q
  let j := linearCoefficientι O.toCollection B (ColoredSubstitutionData.leftUnit P).totalProfile
    (envelopingTotalAlgebraInputs (ColoredSubstitutionData.leftUnit P) q)
  let p := T.map (coefficientLeafMap
    (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
      (Linear.leftUnitInputsIso P
      Q).hom))
    ((addedAlgebraInputs B).map (Linear.leftUnitInputsIso P Q).hom))
  have hi : ι ≫ u = w ≫ k := Linear.leftUnitWeightedInsertion_ι O B P Q
  have hs : k ≫ s = e ≫ j := Linear.representativeCofanMap_β O B
    (ColoredSubstitutionData.leftUnit P) q
  have hf : j ≫ f = p ≫ ι := (linearCoefficientι_joint O.toCollection B
    (ColoredSubstitutionData.leftUnitTotalHom P)
    (Linear.leftUnitInputsIso P Q).hom).symm
  have hu : (w ≫ e) ≫ p = 𝟙 _ := Linear.leftUnitWeightedEvaluation O B P Q
  exact (Linear.descendLeftUnit ι u s f w k e j p hi hs hf hu).trans (Category.comp_id ι).symm


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource205

/- Exact checked source: ReflexiveOperad.LinearRightCoefficientUnit. -/
section EnvelopingSource206


/-!
# The exact original right representative coefficient unit law
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory

private theorem EnvelopingSource206_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem fuseInsertionSquares {V : Type*} [Category* V]
    {X A B D E F G H K R : V} (p : X ⟶ A) (a : A ⟶ B) (l : B ⟶ D)
    (b : D ⟶ E) (g : E ⟶ F) (h : F ⟶ G) (b' : B ⟶ H) (u : H ⟶ E)
    (r : H ⟶ K) (k : A ⟶ K) (v : K ⟶ R) (w : R ⟶ G)
    (hn : l ≫ b = b' ≫ u) (hf : a ≫ b' ≫ r = k) (hu : u ≫ g ≫ h = r ≫ v ≫ w) :
    (p ≫ a ≫ l) ≫ (b ≫ g) ≫ h = p ≫ k ≫ v ≫ w := by
  simp only [Category.assoc]
  rw [← Category.assoc l b, hn]
  simp only [Category.assoc]
  rw [hu]
  simpa only [Category.assoc] using congrArg (fun t => p ≫ t ≫ v ≫ w) hf

private theorem evaluateInsertionSquares {V : Type*} [Category* V]
    {X A B D E F G H : V} (i : X ⟶ A) (a : A ⟶ B) (s : B ⟶ D)
    (t : D ⟶ E) (r : E ⟶ F) (h : B ⟶ G) (s' : G ⟶ H) (k : H ⟶ F)
    (q : D ⟶ H) (j : X ⟶ G) (hi : i ≫ a ≫ h = j)
    (hs : s ≫ q = h ≫ s') (ht : t ≫ r = q ≫ k) :
    i ≫ (a ≫ s ≫ t) ≫ r = j ≫ s' ≫ k := by
  simp only [Category.assoc]
  rw [ht, ← Category.assoc s q, hs]
  simpa only [Category.assoc] using congrArg (fun z => z ≫ s' ≫ k) hi

private theorem reindexFusedMap {V : Type*} [Category* V] {X A B C D E : V}
    (p : X ⟶ A) (k : A ⟶ B) (c : B ⟶ C) (pos : C ⟶ D) (w : D ⟶ E)
    (v : B ⟶ D) (q : A ⟶ C) (t : C ⟶ E)
    (hv : v = c ≫ pos) (hq : k ≫ c = q) (ht : t = pos ≫ w) :
    p ≫ k ≫ v ≫ w = p ≫ q ≫ t := by
  rw [hv, ht]
  simp only [Category.assoc]
  rw [← Category.assoc k c (pos ≫ w), hq]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The literal right representative coefficient map on normalized
root and P-unit slots, with its original extended outer-profile map. -/
def rightRepresentativeBareMap (O : ColoredOperadObj W C) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    Unit.unitRootFamily (O.toCollection.obj (extendProfile P Q)) P.inputs ⟶
      envelopingRepresentativeCoefficients O.toCollection (ColoredSubstitutionData.rightUnit
        P) (rightUnitChoices P
        Q) where
  equiv := Equiv.refl (Option P.inputs)
  hom i := match i with
    | none => O.toCollection.map (extendProfileMap
      (ColoredSubstitutionData.rightUnitOuterHom P) (𝟙 Q))
    | some i => rightUnitCoefficient O P i

/-- The exact original supplied coefficients normalize only the root
singleton and retain every empty-extension unit coefficient. -/
theorem rightRepresentativeFactor_normalized (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    UnitGeometry.rightCoefficientFactor (O.toCollection.obj (extendProfile P Q)) P.inputs
        (fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
          (P.inputColor i))
          emptyColoredInputs))
        (rightUnitCoefficient O P) ≫ (rightUnitCoefficientFamilyIso O.toCollection P Q).hom =
      Unit.rightRootNormalizer (O.toCollection.obj (extendProfile P Q)) P.inputs ≫
        rightRepresentativeBareMap O P Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact HEq.rfl
    | some i => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- The actual right representative insertion is the original P-unit
prefix followed by its literal original bare coefficient map. -/
theorem rightCoefficientInsertion_normalized (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    rightUnitCoefficientInsertion O P Q =
      (FiniteTensor.singletonIso (V := C)).inv.app (O.toCollection.obj (extendProfile P Q)) ≫
        (frozenVariableTensorUnitIso P.inputs
          ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile P Q)))).hom ≫
        (FiniteTensor.tensor (V := C)).map
          ((Unit.rightUnitPositionIso (O.toCollection.obj (extendProfile P Q)) P.inputs).hom ≫
            rightRepresentativeBareMap O P Q) := by
  let X := O.toCollection.obj (extendProfile P Q)
  let f := UnitGeometry.rightCoefficientFactor X P.inputs
    (fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
      (P.inputColor i))
      emptyColoredInputs))
    (rightUnitCoefficient O P)
  let e := (rightUnitCoefficientFamilyIso O.toCollection P Q).hom
  exact (UnitInsertion.rightInsertFromFactor_comp X P.inputs f e).trans
    ((congrArg (UnitInsertion.rightInsertFromFactor X P.inputs)
      (rightRepresentativeFactor_normalized O P Q)).trans
      (Unit.rightInsertFromNormalizedFactor X P.inputs (rightRepresentativeBareMap O P Q)))

/-- The P unit coefficients, followed by Q frozen-variable units,
retain the exact original P⊔Q order through the actual sum-commutation map. -/
theorem fusedRightRepresentativeFactors (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    frozenVariableUnitFamilyMap Q.index
        ((Unit.rightUnitPositionIso (O.toCollection.obj (extendProfile P Q)) P.inputs).hom ≫
          rightRepresentativeBareMap O P Q) ≫
        envelopingRepresentativeUnitMap O (ColoredSubstitutionData.rightUnit P)
          (rightUnitChoices P Q) ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map (rightToExtendedUnit P Q) =
      (Unit.prefixUnitReindexIso Q.index P.inputs
        ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile P Q)))).hom ≫
        RightUnitGeometry.unitsReindex
          (I := FintypeCat.of (Q.index ⊕ P.inputs)) (J := FintypeCat.of (P.inputs ⊕ Q.index))
          (Equiv.sumComm Q.index P.inputs)
          ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile P Q))) ≫
        (Unit.rightUnitPositionIso (O.toCollection.obj (extendProfile P Q)) (extendProfile P
          Q).inputs).hom ≫
        Unit.rightCoefficientBareMap O (extendProfile P Q) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl j =>
        let c := (Q.obj j).as
        change HEq (𝟙 _ ≫ O.unit c ≫ O.toCollection.map (𝟙 (ColoredSubstitutionData.unitProfile c)))
          (𝟙 _ ≫ 𝟙 _ ≫ 𝟙 _ ≫ O.unit c)
        exact heq_of_eq ((congrArg (fun k => 𝟙 _ ≫ O.unit c ≫ k)
          (O.toCollection.map_id (ColoredSubstitutionData.unitProfile c))).trans
            (by simp only [Category.id_comp, Category.comp_id]))
    | inr i =>
        cases i with
        | inl i =>
            let c := P.inputColor i
            let e := emptyExtensionProfileIso (ColoredSubstitutionData.unitProfile c)
            let u := O.unit c
            let f := O.toCollection.map e.inv
            let g := O.toCollection.map e.hom
            have hfg : f ≫ g = 𝟙 _ := (O.toCollection.map_comp _ _).symm.trans
              ((congrArg O.toCollection.map e.inv_hom_id).trans (O.toCollection.map_id _))
            change HEq ((𝟙 _ ≫ (u ≫ f)) ≫ (𝟙 _ ≫ g)) (𝟙 _ ≫ 𝟙 _ ≫ 𝟙 _ ≫ u)
            exact heq_of_eq (by
              simp only [Category.id_comp]
              exact (Category.assoc _ _ _).trans ((congrArg (u ≫
                ·) hfg).trans (Category.comp_id u)))
        | inr j =>
            cases j
            let X := O.toCollection.obj (extendProfile P Q)
            let a := O.toCollection.map (extendProfileMap
              (ColoredSubstitutionData.rightUnitOuterHom P) (𝟙 Q))
            let b := O.toCollection.map (envelopingRepresentativeOuterHom
              (ColoredSubstitutionData.rightUnit P)
              (rightUnitChoices P Q))
            let c := O.toCollection.map (ColoredSubstitutionData.outerProfileMap
              (rightToExtendedUnit P Q))
            let d := O.toCollection.map (ColoredSubstitutionData.rightUnitOuterHom
              (extendProfile P Q))
            change HEq ((𝟙 X ≫ a) ≫ b ≫ c) (𝟙 X ≫ 𝟙 X ≫ 𝟙 X ≫ d)
            have h : a ≫ b ≫ c = d :=
              (EnvelopingSource206_mapThree O.toCollection _ _ _).symm.trans
                (congrArg O.toCollection.map (rightToExtendedUnit_outer P Q))
            exact heq_of_eq (by simpa only [Category.id_comp] using h)

/-- The original two actual unit prefixes fuse to the original full
right-unit insertion at the exact extended profile P⊔Q. -/
theorem rightCoefficientInsertion_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    rightUnitCoefficientInsertion O P Q ≫
        envelopingRepresentativeCoefficientTensorMap O (ColoredSubstitutionData.rightUnit P)
          (rightUnitChoices P Q) ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (rightToExtendedUnit P Q) =
      ColoredOperadObj.rightUnitInsert O.toCollection O.unit (extendProfile P Q) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let L := (FiniteFamily.singleton (C := C)).obj X
  let R := envelopingRepresentativeCoefficients O.toCollection
    (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P
    Q)
  let p := (FiniteTensor.singletonIso (V := C)).inv.app X
  let a := (frozenVariableTensorUnitIso P.inputs L).hom
  let l := (Unit.rightUnitPositionIso X P.inputs).hom ≫ rightRepresentativeBareMap O P Q
  let b := (frozenVariableTensorUnitIso Q.index R).hom
  let b' := (frozenVariableTensorUnitIso Q.index (frozenVariableUnitFamily P.inputs L)).hom
  let um := frozenVariableUnitFamilyMap Q.index l
  let g := envelopingRepresentativeUnitMap O (ColoredSubstitutionData.rightUnit P)
    (rightUnitChoices P Q)
  let h := (ColoredOperadObj.substitutionFactors O.toCollection).map (rightToExtendedUnit P Q)
  let r := (Unit.prefixUnitReindexIso Q.index P.inputs L).hom
  let k := (frozenVariableTensorUnitIso (FintypeCat.of (Q.index ⊕ P.inputs)) L).hom
  let c := RightUnitGeometry.unitsReindex
    (I := FintypeCat.of (Q.index ⊕ P.inputs)) (J := FintypeCat.of (P.inputs ⊕ Q.index))
    (Equiv.sumComm Q.index P.inputs) L
  let pos := (Unit.rightUnitPositionIso X (extendProfile P Q).inputs).hom
  let w := Unit.rightCoefficientBareMap O (extendProfile P Q)
  have hn : T.map l ≫ b = b' ≫ T.map um := frozenVariableTensorUnitIso_naturality Q.index l
  have hf : a ≫ b' ≫ T.map r = k := Unit.tensorUnitPrefix_fusion Q.index P.inputs L
  have hu : T.map um ≫ T.map g ≫ T.map h = T.map r ≫ T.map (c ≫ pos) ≫ T.map w :=
    (EnvelopingSource206_mapThree T um g h).symm.trans
      ((congrArg T.map ((fusedRightRepresentativeFactors O P Q).trans
        (congrArg (r ≫ ·) (Category.assoc c pos w).symm))).trans
          (EnvelopingSource206_mapThree T r (c ≫ pos) w))
  have h0 := fuseInsertionSquares p a (T.map l) b (T.map g) (T.map h) b' (T.map um)
    (T.map r) k (T.map (c ≫ pos)) (T.map w) hn hf hu
  have h1 := congrArg (fun i => i ≫
    envelopingRepresentativeCoefficientTensorMap O (ColoredSubstitutionData.rightUnit P)
      (rightUnitChoices P Q) ≫
    (ColoredOperadObj.substitutionSource O.toCollection).map (rightToExtendedUnit P Q))
    (rightCoefficientInsertion_normalized O P Q)
  have hk : k ≫ T.map c = (frozenVariableTensorUnitIso (extendProfile P Q).inputs L).hom :=
    RightUnitGeometry.tensorPrefixReindex
      (I := FintypeCat.of (Q.index ⊕ P.inputs)) (J := FintypeCat.of (P.inputs ⊕ Q.index))
      (Equiv.sumComm Q.index P.inputs) L
