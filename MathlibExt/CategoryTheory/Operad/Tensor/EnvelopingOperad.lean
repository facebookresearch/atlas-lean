  have hg := congrArg T.map (groupingB_subst_naturality α hγ d)
  rw [T.map_comp, T.map_comp] at hg
  have hs : T.map (HomData.factorHom α d.innerData) ≫ γB.app d.innerData =
      γA.app d.innerData ≫ α.app d.innerData.totalProfile := (hγ d.innerData).symm
  have h := EnvelopingSource334_compose_squares (EnvelopingSource334_compose_squares
    (EnvelopingSource334_compose_squares (EnvelopingSource334_compose_squares hr hf) hg) hs)
    (α.naturality d.totalHom).symm
