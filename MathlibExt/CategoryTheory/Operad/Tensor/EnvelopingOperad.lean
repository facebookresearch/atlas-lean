/- Exact checked source: EnvelopingLinearSubstitutionColimit. -/
section EnvelopingSource173


/-!
# Actual substitution on the unquotiented linear coefficient collection

Separate finite tensor-slot preservation constructs the full original
root/inner input-choice tensor colimit. Representative substitution
then descends through this actual colimit, before imposing algebra relations.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem originalLinearEvaluationSquare {V : Type*} [Category* V]
    {X X' Y Y' Z : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (b : Y ⟶ Z) (b' : Y' ⟶ Z) (ha : k ≫ a' = a ≫ f) (hb : f ≫ b' = b) :
    k ≫ (a' ≫ b') = (a ≫ b) ≫ 𝟙 Z := by
  rw [← Category.assoc k a', ha, Category.assoc a f, hb, Category.comp_id]

private theorem originalLinearIsoCancel {V : Type*} [Category* V]
    {X Y Z D : V} (f : X ⟶ Y) (e : Y ≅ Z) (g : Y ⟶ D) :
    (f ≫ e.hom) ≫ (e.inv ≫ g) = f ≫ g := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original coefficient slot has its actual linear input diagram. -/
def envelopingLinearSlotDiagram (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (i : Option s.inner.index) : ColoredInputs W ⥤ C :=
  linearCoefficientDiagram O A (envelopingSlotProfile s i)

/-- The full tensor diagram uses the original root and inner slots. -/
def envelopingLinearTensorDiagram (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) : EnvelopingInputChoices s ⥤ C :=
  FiniteMultifunctor.finiteIndexDiagram
    (fixedIndexTensorFunctor (FintypeCat.of (Option s.inner.index)))
    (envelopingLinearSlotDiagram O A s)

/-- The finite-index diagram retains exactly the original named
weighted representative, by identities at each original slot. -/
def envelopingLinearWeightedFamilyIso (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    ((FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option s.inner.index))).obj
      (fun i => (envelopingLinearSlotDiagram O A s i).obj (Q i))) ≅
        envelopingWeightedRepresentativeFamily O A s Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun _ => Iso.refl _)

/-- The exact original finite-slot comparison respects all original
coefficient and algebra-input maps, with no change of strand enumeration. -/
theorem envelopingLinearWeightedFamilyIso_naturality (O : ColoredSymmetricCollection W C)
    (A : W → C) (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option s.inner.index))).map
        (fun i => (envelopingLinearSlotDiagram O A s i).map (g i)) ≫
        (envelopingLinearWeightedFamilyIso O A s Q').hom =
      (envelopingLinearWeightedFamilyIso O A s Q).hom ≫
        envelopingWeightedRepresentativeMap O A s g := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    change HEq ((envelopingLinearSlotDiagram O A s i).map (g i) ≫ 𝟙 _)
      (𝟙 _ ≫ (envelopingLinearSlotDiagram O A s i).map (g i))
    exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Each original coefficient slot has its actual original colimit cocone. -/
def envelopingLinearSlotCocone (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (i : Option s.inner.index) :
    Cocone (envelopingLinearSlotDiagram O A s i) := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits s.outputColor
  exact colimit.cocone (envelopingLinearSlotDiagram O A s i)

/-- These are genuine colimit cocones of the original input diagrams. -/
def envelopingLinearSlotIsColimit (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (i : Option s.inner.index) :
    IsColimit (envelopingLinearSlotCocone O A s i) := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits s.outputColor
  exact colimit.isColimit (envelopingLinearSlotDiagram O A s i)

/-- The original root/inner coefficient colimits form the actual tensor cocone. -/
def envelopingLinearTensorCocone (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) : Cocone (envelopingLinearTensorDiagram O A s) :=
  FiniteMultifunctor.finiteIndexCocone
    (fixedIndexTensorFunctor (FintypeCat.of (Option s.inner.index)))
    (envelopingLinearSlotCocone O A s)

/-- The tensor cocone point keeps the original full coefficient family. -/
def envelopingLinearTensorPointIso (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) :
    (envelopingLinearTensorCocone O A s).pt ≅
      (ColoredOperadObj.substitutionSource (linearCoefficientCollection O A)).obj s :=
  (FiniteTensor.tensor (V := C)).mapIso
    (FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i => match i with
      | none => Iso.refl _
      | some _ => Iso.refl _))

/-- Actual representative substitution gives the original cocone
on the complete root/inner input-choice tensor diagram. -/
def envelopingLinearEvaluationCocone (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) : Cocone (envelopingLinearTensorDiagram O.toCollection A
      s) where
  pt := linearCoefficient O.toCollection A s.totalProfile
  ι :=
    { app Q := (FiniteTensor.tensor (V := C)).map (envelopingLinearWeightedFamilyIso
      O.toCollection A s Q).hom ≫
        envelopingRepresentativeColimitEvaluation O A s Q
      naturality Q Q' g := by
        let T := FiniteTensor.tensor (V := C)
        have h : T.map ((FiniteFamily.fixedIndexFunctor (C :=
          C) (FintypeCat.of (Option s.inner.index))).map
              (fun i => (envelopingLinearSlotDiagram O.toCollection A s i).map (g i))) ≫
              T.map (envelopingLinearWeightedFamilyIso O.toCollection A s Q').hom =
            T.map (envelopingLinearWeightedFamilyIso O.toCollection A s Q).hom ≫
              T.map (envelopingWeightedRepresentativeMap O.toCollection A s g) :=
          (T.map_comp _ _).symm.trans
            ((congrArg T.map (envelopingLinearWeightedFamilyIso_naturality O.toCollection A
              s g)).trans (T.map_comp _
              _))
        exact originalLinearEvaluationSquare
          ((envelopingLinearTensorDiagram O.toCollection A s).map g)
          (T.map (envelopingLinearWeightedFamilyIso O.toCollection A s Q).hom)
          (T.map (envelopingLinearWeightedFamilyIso O.toCollection A s Q').hom)
          (T.map (envelopingWeightedRepresentativeMap O.toCollection A s g))
          (envelopingRepresentativeColimitEvaluation O A s Q)
          (envelopingRepresentativeColimitEvaluation O A s Q') h
          (envelopingRepresentativeColimitEvaluation_relation O A s g) }

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Actual source tensor-slot preservation constructs the entire
root/inner coefficient colimit, including nullary original branches. -/
def envelopingLinearTensorIsColimit (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) : IsColimit (envelopingLinearTensorCocone O A s) := by
  let : DecidableEq (FintypeCat.of (Option s.inner.index)) := Classical.decEq _
  let : ∀ _ : FintypeCat.of (Option s.inner.index), EssentiallySmall.{us} (ColoredInputs W) :=
    fun _ => coloredInputsEssentiallySmall s.outputColor
  let : Functor.PreservesColimitsInEachSlot.{0, w, v, w, v, us}
      (fixedIndexTensorFunctor (C := C) (FintypeCat.of (Option s.inner.index))) :=
    FiniteTensorPreservesColimitsInEachSlot.preserves (C :=
      C) (FintypeCat.of (Option s.inner.index))
  exact @FiniteMultifunctor.isColimitFiniteIndexCocone.{0, u, max 1 u, v, w, v, w, us}
    (FintypeCat.of (Option s.inner.index)) C _ C _ inferInstance (Classical.decEq _)
    (fun _ => ColoredInputs W) (fun _ => inferInstance)
    (fun _ => coloredInputsEssentiallySmall s.outputColor)
    (fixedIndexTensorFunctor (FintypeCat.of (Option s.inner.index)))
    (FiniteTensorPreservesColimitsInEachSlot.preserves (C :=
      C) (FintypeCat.of (Option s.inner.index)))
    (envelopingLinearSlotDiagram O A s) (envelopingLinearSlotCocone O A s)
    (envelopingLinearSlotIsColimit O A s)

/-- Actual original operadic substitution descends through all
original root/inner input-choice colimits. Algebra relations will
be imposed on these actual maps in each coefficient slot. -/
def envelopingLinearSubstitution (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) :
    (ColoredOperadObj.substitutionSource (linearCoefficientCollection O.toCollection A)).obj s ⟶
      linearCoefficient O.toCollection A s.totalProfile :=
  (envelopingLinearTensorPointIso O.toCollection A s).inv ≫
    (envelopingLinearTensorIsColimit O.toCollection A s).desc
      (envelopingLinearEvaluationCocone O A s)

/-- The actual original root/inner cofan leg into the source of
linear coefficient substitution retains its exact slot comparison. -/
def envelopingLinearSubstitutionInjection (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (envelopingLinearTensorDiagram O A s).obj Q ⟶
      (ColoredOperadObj.substitutionSource (linearCoefficientCollection O A)).obj s :=
  (envelopingLinearTensorCocone O A s).ι.app Q ≫ (envelopingLinearTensorPointIso O A s).hom

/-- Every actual original root/branch representative is evaluated
by its original substitution, tensor block comparison and total profile injection. -/
theorem envelopingLinearSubstitution_β (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingLinearSubstitutionInjection O.toCollection A s Q ≫
      envelopingLinearSubstitution O A s =
      (FiniteTensor.tensor (V := C)).map (envelopingLinearWeightedFamilyIso O.toCollection A
        s Q).hom ≫
        envelopingRepresentativeColimitEvaluation O A s Q := by
  exact (originalLinearIsoCancel ((envelopingLinearTensorCocone O.toCollection A s).ι.app Q)
    (envelopingLinearTensorPointIso O.toCollection A s)
    ((envelopingLinearTensorIsColimit O.toCollection A s).desc
      (envelopingLinearEvaluationCocone O A s))).trans
      ((envelopingLinearTensorIsColimit O.toCollection A s).fac
        (envelopingLinearEvaluationCocone O A s) Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
