namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem extendedMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by
  simp only [Functor.map_comp]

private theorem extendedRawFiring {D : Type*} [Category* D]
    {X A B E F G H Y : D} (p : X ⟶ A) (i : A ⟶ B) (t : B ⟶ E) (n : E ⟶ Y)
    (e : X ⟶ F) (p' : F ⟶ G) (a : A ⟶ G) (r : G ⟶ H) (j : H ⟶ E)
    (h1 : p ≫ a = e ≫ p') (h2 : i ≫ t = a ≫ r ≫ j) :
    p ≫ i ≫ t ≫ n = e ≫ p' ≫ r ≫ j ≫ n := by
  rw [← Category.assoc i t, h2]
  simp only [Category.assoc]
  rw [← Category.assoc p a, h1]
  simp only [Category.assoc]

private theorem extendedNormalizationFiring {D : Type*} [Category* D]
    {F G H E V Z Y : D} (p : F ⟶ G) (r : G ⟶ H) (j : H ⟶ E) (n : E ⟶ Y)
    (n' : H ⟶ Z) (k : Z ⟶ Y) (m : F ⟶ V) (s : V ⟶ Z) (c : V ⟶ Y)
    (h1 : j ≫ n = n' ≫ k) (h2 : p ≫ r ≫ n' = m ≫ s) (h3 : s ≫ k = c) :
    p ≫ r ≫ j ≫ n = m ≫ c := by
  rw [h1]
  have h2' : (p ≫ r) ≫ n' = m ≫ s := (Category.assoc _ _ _).trans h2
  rw [← Category.assoc p r, ← Category.assoc (p ≫ r) n', h2', Category.assoc, h3]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original extended substitution source retains exactly the
original coefficient unit map and the full original constant/variable
leaf map under the original source-factor permutation. -/
theorem extendedInput_coefficientLeafSquare (O : ColoredOperadObj W C) (B M : W → C)
    (g : B ⟶ M) (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    extendedInputFactors O B M g s Q ≫
      (substitutionToLeavesIso O.toCollection M (envelopingRepresentativeSubstitution s Q)).hom =
    Variable.unitFamilyMap (Equiv.refl (Q none).index)
        (evaluationRawSourceIso O.toCollection B M s Q).hom ≫
      coefficientPrefixRawMap (Q none).index
        (envelopingRepresentativeCoefficients O.toCollection s Q) (evaluationLeafFamily B M s Q) ≫
      (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (envelopingRepresentativeUnitMap O s Q)
          (evaluationLeafMap B M g s Q)) := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl _ => rfl
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with
      | none => rcases j with ⟨i, j⟩; cases i <;> cases j <;> rfl
      | some i => cases j; rfl
  · intro p
    cases p with
    | inl j =>
      let X := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
      let Y := O.toCollection.obj (ColoredProfile.unary ((Q none).obj j).as ((Q none).obj j).as)
      let f : X ⟶ Y := O.unit ((Q none).obj j).as
      change HEq (f ≫ 𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 X ≫ 𝟙 X ≫ f)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with
      | none =>
        rcases j with ⟨i, j⟩
        cases i with
        | none => cases j with
          | none =>
            let X := O.toCollection.obj (extendProfile s.outerProfile (Q none))
            let Y := O.toCollection.obj (envelopingRepresentativeSubstitution s Q).outerProfile
            let f : X ⟶ Y := O.toCollection.map (envelopingRepresentativeOuterHom s Q)
            change HEq (f ≫ 𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 X ≫ 𝟙 X ≫ f)
            exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
          | some j =>
            let X := B ((Q none).obj j).as
            let Y := M ((Q none).obj j).as
            let f : X ⟶ Y := g ((Q none).obj j).as
            change HEq (f ≫ 𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 X ≫ 𝟙 X ≫ f)
            exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
        | some i => cases j with
          | none =>
            let X := O.toCollection.obj (extendProfile (s.inner.obj i) (Q (some i)))
            change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X ≫ 𝟙 X)
            exact heq_of_eq (by simp only [Category.id_comp])
          | some j =>
            let X := B ((Q (some i)).obj j).as
            let Y := M ((Q (some i)).obj j).as
            let f : X ⟶ Y := g ((Q (some i)).obj j).as
            change HEq (f ≫ 𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 X ≫ 𝟙 X ≫ f)
            exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
      | some i =>
        cases j
        let X := M (s.totalProfile.inputColor i)
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X ≫ 𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

/-- The complete original extended algebra input, with its actual
unit insertion and original source-factor permutation, is exactly
the original coefficient tensor map with all original leaves. -/
theorem extendedInput_normalization (O : ColoredOperadObj W C) (B M : W → C)
    (g : B ⟶ M) (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (frozenVariableTensorUnitIso (Q none).index (substitutionExpandedFamily O.toCollection B
      M s Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map (extendedInputFactors O B M g s Q) ≫
      (FiniteTensor.tensor (V := C)).map
        (substitutionToLeavesIso O.toCollection M (envelopingRepresentativeSubstitution s Q)).hom ≫
      coefficientLeavesNormalization
        ((ColoredOperadObj.substitutionFactors O.toCollection).obj
          (envelopingRepresentativeSubstitution s Q))
        (profileLeafFamily M (envelopingRepresentativeSubstitution s Q).totalProfile) =
    (FiniteTensor.tensor (V := C)).map (evaluationRawSourceIso O.toCollection B M s Q).hom ≫
      coefficientLeavesNormalization (envelopingRepresentativeCoefficients O.toCollection s Q)
        (evaluationLeafFamily B M s Q) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (envelopingRepresentativeCoefficientTensorMap O s Q)
          (evaluationLeafMap B M g s Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let D := substitutionExpandedFamily O.toCollection B M s Q
  let K := envelopingRepresentativeCoefficients O.toCollection s Q
  let L := evaluationLeafFamily B M s Q
  let I := (Q none).index
  let K' := (ColoredOperadObj.substitutionFactors O.toCollection).obj
    (envelopingRepresentativeSubstitution s Q)
  let L' := profileLeafFamily M (envelopingRepresentativeSubstitution s Q).totalProfile
  let e := (evaluationRawSourceIso O.toCollection B M s Q).hom
  let p := (frozenVariableTensorUnitIso I D).hom
  let p' := (frozenVariableTensorUnitIso I (F.obj (coefficientLeavesNested K L))).hom
  let a := Variable.unitFamilyMap (Equiv.refl I) e
  let r := coefficientPrefixRawMap I K L
  let k := envelopingRepresentativeUnitMap O s Q
  let ell := evaluationLeafMap B M g s Q
  let j := F.map (coefficientLeavesNestedMap k ell)
  let n := coefficientLeavesNormalization K' L'
  let n' := coefficientLeavesNormalization (frozenVariableUnitFamily I K) L
  let m := coefficientLeavesNormalization K L
  let u := (frozenVariableTensorUnitIso I K).hom
  let b := T.map (coefficientLeafMap (T.map k) ell)
  let c := T.map (coefficientLeafMap (envelopingRepresentativeCoefficientTensorMap O s Q) ell)
  let input := T.map (extendedInputFactors O B M g s Q)
  let perm := T.map (substitutionToLeavesIso O.toCollection M
    (envelopingRepresentativeSubstitution s Q)).hom
  have hp : p ≫ T.map a = T.map e ≫ p' :=
    (Variable.tensorUnitIso_naturality (Equiv.refl I) e).symm
  have hi : input ≫ perm = T.map a ≫ T.map r ≫ T.map j :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (extendedInput_coefficientLeafSquare O B M g s Q)).trans
        (extendedMapThree T a r j))
  have hn : T.map j ≫ n = n' ≫ b := coefficientLeavesNormalization_naturality k ell
  have hu : p' ≫ T.map r ≫ n' = m ≫ (coefficientLeafTensorFunctor L).map u :=
    coefficientPrefix_normalization I K L
  have hc : (coefficientLeafTensorFunctor L).map u ≫ b = c :=
    (T.map_comp _ _).symm.trans
      (congrArg T.map (coefficientLeafMap_pre u (T.map k) ell))
  have hraw := extendedRawFiring p input perm n (T.map e) p' (T.map a) (T.map r) (T.map j) hp hi
  have hnorm := extendedNormalizationFiring p' (T.map r) (T.map j) n n' b m
    ((coefficientLeafTensorFunctor L).map u) c hn hu hc
  exact hraw.trans (congrArg (T.map e ≫ ·) hnorm)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

