  let q := envelopingAssocMiddleChoices d Q
  let K := coefficientBlockFamily (FintypeCat.of (Option d.branches.index))
    (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile d.middleData i) (q i)))
