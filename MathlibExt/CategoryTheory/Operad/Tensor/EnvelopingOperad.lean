section EnvelopingSource118


/-!
# Actual original operad association law on the nested retained source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original association routes remain equal after
the constructed nested coefficient/unit source and the exact
original total variable/algebra profile comparison. -/
theorem envelopingAssocNestedOriginalLaw (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedCommonSource O d Q ≫
        ColoredOperadObj.associativityRouteA O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q) ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) =
      envelopingAssocNestedCommonSource O d Q ≫
        ColoredOperadObj.associativityRouteB O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q) ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) :=
  congrArg (fun f => envelopingAssocNestedCommonSource O d Q ≫ f ≫
    O.toCollection.map (envelopingAssocTotalHom d Q)) (O.assoc (envelopingRepresentativeAssoc d Q))


end CategoryTheory.Operad.Tensor.Enveloping

