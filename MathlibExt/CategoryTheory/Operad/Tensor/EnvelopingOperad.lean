  let o := M.operations.app P.outputColor (profileInputs (datum P Q).totalProfile)
  let r := T.map (substitutionToLeavesIso E.toCollection M.carrier (datum P Q)).hom
  let n := coefficientLeavesNormalization ((ColoredOperadObj.substitutionFactors
    E.toCollection).obj (datum P Q))
    (profileLeafFamily M.carrier (datum P Q).totalProfile)
  let c0 := E.subst.app (datum P Q)
  let c := (coefficientLeafTensorFunctor (profileLeafFamily M.carrier (datum P
    Q).totalProfile)).map c0
  let p := (profileCoefficientLeafTensorIso E.toCollection M.carrier (datum P Q).totalProfile).hom
