/- Exact checked source: ReflexiveOperad.FrozenAlgebraBlocks. -/
section EnvelopingSource239


/-!
# Original algebra frozen-variable units distributed through their original input blocks
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

private theorem distributionFold {V : Type*} [Category* V]
    {X A B D H J Y : V} (p : X ⟶ A) (i : A ⟶ D) (f : D ⟶ Y)
    (r : A ⟶ B) (g : B ⟶ D) (e : X ⟶ H) (q : H ⟶ B) (n : H ⟶ J) (b : J ⟶ Y)
    (hi : r ≫ g = i) (hp : e ≫ q = p ≫ r) (hd : q ≫ g ≫ f = n ≫ b) :
    p ≫ i ≫ f = e ≫ n ≫ b := by
  have h1 : p ≫ i ≫ f = p ≫ r ≫ g ≫ f := by
    simpa only [Category.assoc] using congrArg (fun z => p ≫ z ≫ f) hi.symm
  have h2 : p ≫ r ≫ g ≫ f = e ≫ q ≫ g ≫ f := by
    simpa only [Category.assoc] using congrArg (fun z => z ≫ g ≫ f) hp.symm
  exact h1.trans (h2.trans (congrArg (e ≫ ·) hd))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original retained singleton enters its actual original nested
operation block. P blocks insert E units; root and Q blocks have no unit slot. -/
def localUnitMap (E : ColoredOperadObj W C) (A : W → C) (P : ColoredProfile W) (Q : ColoredInputs W)
    (i : (groups E.toCollection A P Q).index) :
    frozenVariableUnitFamily (localUnitIndices E.toCollection A P Q i) ((groups
      E.toCollection A P Q).obj i) ⟶
      (nestedOperationFactors E.toCollection A (datum P Q)).obj i :=
  match i with
  | none => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (extendProfile P Q)))).hom ≫
        (FiniteFamily.singleton (C := C)).map (E.toCollection.map (frozenOuterProfileHom P Q
          (Linear.Constants.branches
          Q)))
  | some (Sum.inl i) => unaryUnitFactor E A (P.inputColor i)
  | some (Sum.inr j) => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (ColoredProfile.nullary
        (Q.obj j).as)))).hom ≫
        (nullaryFactorsIso E.toCollection A (Q.obj j).as).inv

/-- The actual shared global unit map has exactly the literal original
P units, root profile map, Q nullary coefficients and P variables. -/
theorem inputFactor_blocks (E : ColoredOperadObj W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    Variable.unitFamilyMap (localUnitsEquiv E.toCollection A P Q) (rawGroupsIso
      E.toCollection A P Q).hom ≫
      blockUnitGlobalMap (groups E.toCollection A P Q) (localUnitIndices E.toCollection A P Q)
        (nestedOperationFactors E.toCollection A (datum P Q)).obj (localUnitMap E A P Q) =
    inputFactor E A P Q := by
  let N := groups E.toCollection A P Q
  let J := localUnitIndices E.toCollection A P Q
  let M := nestedOperationFactors E.toCollection A (datum P Q)
  let f := localUnitMap E A P Q
  let e := localUnitsEquiv E.toCollection A P Q
  let z := (rawGroupsIso E.toCollection A P Q).hom
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | inl _ => rfl
    | inr i => rcases i with ⟨i, j⟩; cases i with
        | none => cases j <;> rfl
        | some _ => rfl
  · intro i
    cases i with
    | inl i =>
        have h := DisjointNullary.UnitBlocks.relabeledGlobal_unit_hom N J M.obj f e z i
        exact heq_of_eq h
    | inr i =>
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j with
          | none =>
              have h := DisjointNullary.UnitBlocks.relabeledGlobal_coefficient_hom N J M.obj
                f e z ⟨none, none⟩
              let X := E.toCollection.obj (extendProfile P Q)
              let a := E.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q))
              have hc : z.hom ⟨none, none⟩ ≫ (f none).hom (Sum.inr PUnit.unit) = a := by
                change (𝟙 X ≫ 𝟙 X) ≫ (𝟙 X ≫ a) = a
                simp only [Category.id_comp]
              exact heq_of_eq (h.trans hc)
          | some j =>
              have h := DisjointNullary.UnitBlocks.relabeledGlobal_coefficient_hom N J M.obj
                f e z ⟨none, some j⟩
              let X := E.toCollection.obj (ColoredProfile.nullary (Q.obj j).as)
              have hc : z.hom ⟨none, some j⟩ ≫ (f (some (Sum.inr j))).hom (Sum.inr
                PUnit.unit) = 𝟙 X := by
                change (𝟙 X ≫ 𝟙 X) ≫ (𝟙 X ≫ (𝟙 X ≫ 𝟙 X)) = 𝟙 X
                simp only [Category.id_comp]
              exact heq_of_eq (h.trans hc)
        | some i =>
            have h := DisjointNullary.UnitBlocks.relabeledGlobal_coefficient_hom N J M.obj f
              e z ⟨some i, PUnit.unit⟩
            let X := A (P.inputColor i)
            have hc : z.hom ⟨some i, PUnit.unit⟩ ≫ (f (some (Sum.inl i))).hom (Sum.inr
              PUnit.unit) = 𝟙 X := by
              change (𝟙 X ≫ 𝟙 X) ≫ 𝟙 X = 𝟙 X
              simp only [Category.id_comp]
            exact heq_of_eq (h.trans hc)

/-- Original finite tensor block coherence distributes every P unit
into exactly its original unary algebra block, retaining all original root/Q coefficients. -/
theorem inputDistribution (E : ColoredOperadObj W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (frozenVariableTensorUnitIso P.inputs (raw E.toCollection A P Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map (inputFactor E A P Q) ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (nestedOperationFactors E.toCollection A
          (datum P Q)) =
    (FiniteTensor.tensor (V := C)).map (rawGroupsIso E.toCollection A P Q).hom ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (groups E.toCollection A P Q) ≫
        (FiniteTensor.tensor (V := C)).map
          (blockUnitAppliedMap (groups E.toCollection A P Q) (localUnitIndices E.toCollection A P Q)
            (nestedOperationFactors E.toCollection A (datum P Q)).obj (localUnitMap E A P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let N := groups E.toCollection A P Q
  let J := localUnitIndices E.toCollection A P Q
  let M := nestedOperationFactors E.toCollection A (datum P Q)
  let e0 := localUnitsEquiv E.toCollection A P Q
  let z := (rawGroupsIso E.toCollection A P Q).hom
  let p := (frozenVariableTensorUnitIso P.inputs (raw E.toCollection A P Q)).hom
  let i := T.map (inputFactor E A P Q)
  let f := (FiniteTensor.flattenIso (V := C)).hom.app M
  let r := T.map (Variable.unitFamilyMap e0 z)
  let g := T.map (blockUnitGlobalMap N J M.obj (localUnitMap E A P Q))
  let e := T.map z
  let q := (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C :=
    C)).obj N)).hom
  let n := (FiniteTensor.flattenIso (V := C)).hom.app N
  let b := T.map (blockUnitAppliedMap N J M.obj (localUnitMap E A P Q))
  have hi : r ≫ g = i := (T.map_comp _ _).symm.trans (congrArg T.map (inputFactor_blocks E A P Q))
  have hp : e ≫ q = p ≫ r := Variable.tensorUnitIso_naturality e0 z
  have hd : q ≫ g ≫ f = n ≫ b := tensorUnitBlock_applied N J M.obj (localUnitMap E A P Q)
  exact distributionFold p i f r g e q n b hi hp hd


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

end
end EnvelopingSource239

/- Exact checked source: ReflexiveOperad.FrozenAlgebraInnerRoute. -/
section EnvelopingSource240


/-!
# The original algebra inner route evaluates the actual P units and Q nullary constants
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

private theorem EnvelopingSource240_mapThree {V U : Type*} [Category* V] [Category* U]
    (T : V ⥤ U) {X Y Z D : V} (f : X ⟶ Y) (g : Y ⟶ Z) (h : Z ⟶ D) :
    T.map (f ≫ g ≫ h) = T.map f ≫ T.map g ≫ T.map h := by rw [T.map_comp, T.map_comp]

private theorem prefixPost {V : Type*} [Category* V] {X A B Y : V}
    (p : X ⟶ A) (e : A ⟶ X) (k : X ⟶ B) (whole : A ⟶ B) (o : B ⟶ Y)
    (hm : whole = e ≫ k) (hp : p ≫ e = 𝟙 X) : (p ≫ whole) ≫ o = k ≫ o := by
  rw [hm]
  simp only [Category.assoc]
  rw [← Category.assoc p e, hp, Category.id_comp]

private theorem innerFold {V : Type*} [Category* V]
    {X A B D H J K L Y : V}
    (r : X ⟶ A) (f : A ⟶ B) (i : B ⟶ D) (o : D ⟶ Y)
    (d : X ⟶ H) (n : H ⟶ J) (b : J ⟶ B) (c : J ⟶ K) (e : K ⟶ D)
    (s : H ⟶ K) (g : X ⟶ L) (q : L ⟶ D) (out : L ⟶ Y)
    (hd : r ≫ f = d ≫ n ≫ b) (hc : b ≫ i = c ≫ e) (hs : n ≫ c = s)
    (hr : d ≫ s ≫ e = g ≫ q) (ho : q ≫ o = out) :
    r ≫ f ≫ i ≫ o = g ≫ out := by
  have h1 : r ≫ f ≫ i ≫ o = d ≫ n ≫ b ≫ i ≫ o := by
    simpa only [Category.assoc] using congrArg (fun z => z ≫ i ≫ o) hd
  have h2 : d ≫ n ≫ b ≫ i ≫ o = d ≫ n ≫ c ≫ e ≫ o := by
    simpa only [Category.assoc] using congrArg (fun z => d ≫ n ≫ z ≫ o) hc
  have h3 : d ≫ n ≫ c ≫ e ≫ o = d ≫ s ≫ e ≫ o := by
    simpa only [Category.assoc] using congrArg (fun z => d ≫ z ≫ e ≫ o) hs
  have h4 : d ≫ s ≫ e ≫ o = g ≫ q ≫ o := by
    simpa only [Category.assoc] using congrArg (· ≫ o) hr
  exact h1.trans (h2.trans (h3.trans (h4.trans (congrArg (g ≫ ·) ho))))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Original root, variable and nullary values evaluate at the original
outer substitution profile, with its original coefficient-profile correction. -/
def collapsedMap (E : ColoredOperadObj W C) (M : Algebra E) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    values E.toCollection M.carrier P Q ⟶
      (analyticFactors E.toCollection M.carrier).obj (profileInputs (datum P Q).outerProfile) where
  equiv := Equiv.refl (Option (P.inputs ⊕ Q.index))
  hom i := match i with
    | none => E.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q))
    | some (Sum.inl i) => 𝟙 (M.carrier (P.inputColor i))
    | some (Sum.inr j) => nullaryEvaluation M (Q.obj j).as

/-- The original coefficient and variables remain in their original
P⊔Q slots; every original Q coefficient uses the genuine original M nullary operation. -/
def evaluatedFactors (E : ColoredOperadObj W C) (M : Algebra E) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    raw E.toCollection M.carrier P Q ⟶
      (analyticFactors E.toCollection M.carrier).obj (profileInputs (extendProfile P Q)) where
  equiv := rawValuesEquiv E.toCollection M.carrier P Q
  hom i := match i with
    | ⟨none, none⟩ => 𝟙 (E.toCollection.obj (extendProfile P Q))
    | ⟨none, some j⟩ => nullaryEvaluation M (Q.obj j).as
    | ⟨some i, _⟩ => 𝟙 (M.carrier (P.inputColor i))

/-- The original local inner algebra evaluations are the original singleton
unitors, P identities derived from M.unit, and the genuine Q nullary operations. -/
theorem localEvaluation (E : ColoredOperadObj W C) (M : Algebra E) (P : ColoredProfile W) (Q
  : ColoredInputs W) :
    blockUnitAppliedMap (groups E.toCollection M.carrier P Q) (localUnitIndices
      E.toCollection M.carrier P Q)
      (nestedOperationFactors E.toCollection M.carrier (datum P Q)).obj (localUnitMap E
        M.carrier P Q) ≫
      innerOperationMap M.operations (datum P Q) =
    (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app (values
      E.toCollection M.carrier P Q) ≫
      collapsedMap E M P Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let T := FiniteTensor.tensor (V := C)
        let X := E.toCollection.obj (extendProfile P Q)
        let S := (FiniteFamily.singleton (C := C)).obj X
        let a := E.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q))
        let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) S).hom
        let e := T.map (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) S).hom
        let k := T.map ((FiniteFamily.singleton (C := C)).map a)
        let whole := T.map (localUnitMap E M.carrier P Q none)
        let o := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (datum P
          Q).outerProfile)
        have hm : whole = e ≫ k := T.map_comp _ _
        have hp : p ≫ e = 𝟙 (T.obj S) := ZeroVariable.emptyPrefix_unit (FintypeCat.of (Fin 0)) S
        exact heq_of_eq ((prefixPost p e k whole o hm hp).trans ((FiniteTensor.singletonIso
          (V := C)).hom.naturality a))
    | some i => cases i with
      | inl i =>
          let X := M.carrier (P.inputColor i)
          let p := (frozenVariableTensorUnitIso (FintypeCat.of PUnit)
            ((FiniteFamily.singleton (C := C)).obj X)).hom
          let f := (FiniteTensor.tensor (V := C)).map (unaryUnitFactor E M.carrier (P.inputColor i))
          let o := M.operations.app (P.inputColor i) (AnalyticIndex.unary (P.inputColor i))
          let s := (FiniteTensor.singletonIso (V := C)).hom.app X
          change HEq ((p ≫ f) ≫ o) (s ≫ 𝟙 X)
          exact heq_of_eq ((Category.assoc p f o).trans ((unaryUnit_evaluation E M
            (P.inputColor i)).trans
            (Category.comp_id s).symm))
      | inr j =>
          let T := FiniteTensor.tensor (V := C)
          let X := E.toCollection.obj (ColoredProfile.nullary (Q.obj j).as)
          let S := (FiniteFamily.singleton (C := C)).obj X
          let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) S).hom
          let e := T.map (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) S).hom
          let k := T.map (nullaryFactorsIso E.toCollection M.carrier (Q.obj j).as).inv
          let whole := T.map (localUnitMap E M.carrier P Q (some (Sum.inr j)))
          let o := M.operations.app (Q.obj j).as AnalyticIndex.nullary
          have hm : whole = e ≫ k := T.map_comp _ _
          have hp : p ≫ e = 𝟙 (T.obj S) := ZeroVariable.emptyPrefix_unit (FintypeCat.of (Fin 0)) S
          exact heq_of_eq ((prefixPost p e k whole o hm hp).trans (nullaryFactor_evaluation
            E M (Q.obj j).as))

/-- The original raw source permutation, singleton block collapse and
local evaluations give precisely the original P⊔Q operation input map. -/
theorem rawEvaluation_outer (E : ColoredOperadObj W C) (M : Algebra E) (P : ColoredProfile
  W) (Q : ColoredInputs W) :
    (rawGroupsIso E.toCollection M.carrier P Q).hom ≫
      FiniteFamily.mapSingletonFlattenIso.hom.app (values E.toCollection M.carrier P Q) ≫
        collapsedMap E M P Q =
    evaluatedFactors E M P Q ≫
      (operationFactorsFunctor E.toCollection M.carrier).map (frozenOuterProfileHom P Q
        (Linear.Constants.branches Q))
        := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    rcases i with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some _ => rfl
  · intro i
    rcases i with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
          let X := E.toCollection.obj (extendProfile P Q)
          let a := E.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q))
          change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ a) (𝟙 X ≫ a)
          exact heq_of_eq (by simp only [Category.id_comp])
      | some j =>
          let X := E.toCollection.obj (ColoredProfile.nullary (Q.obj j).as)
          let Y := M.carrier (Q.obj j).as
          let a := nullaryEvaluation M (Q.obj j).as
          change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ a) (a ≫ 𝟙 Y)
          exact heq_of_eq ((congrArg (fun z : X ⟶ X => z ≫ 𝟙 X ≫ a) (Category.id_comp (𝟙 X))).trans
            ((Category.id_comp (𝟙 X ≫ a)).trans ((Category.id_comp a).trans
              (Category.comp_id a).symm)))
    | some i =>
        let X := M.carrier (P.inputColor i)
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

/-- The actual algebra inner-first route evaluates every retained P
unit by M.unit and every original Q nullary coefficient by M's nullary operation,
then applies the original operation at the original extended profile. -/
theorem innerRoute (E : ColoredOperadObj W C) (M : Algebra E) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    (frozenVariableTensorUnitIso P.inputs (raw E.toCollection M.carrier P Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map (inputFactor E M.carrier P Q) ≫
        algebraSubstitutionInner M.operations (datum P Q) =
    (FiniteTensor.tensor (V := C)).map (evaluatedFactors E M P Q) ≫
      M.operations.app P.outputColor (profileInputs (extendProfile P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let N := groups E.toCollection M.carrier P Q
  let V := values E.toCollection M.carrier P Q
  let a := (frozenVariableTensorUnitIso P.inputs (raw E.toCollection M.carrier P Q)).hom
  let input := T.map (inputFactor E M.carrier P Q)
  let r := a ≫ input
  let f := (FiniteTensor.flattenIso (V := C)).hom.app (nestedOperationFactors E.toCollection
    M.carrier (datum P Q))
  let i := T.map (innerOperationMap M.operations (datum P Q))
  let o := M.operations.app P.outputColor (profileInputs (datum P Q).outerProfile)
  let d := T.map (rawGroupsIso E.toCollection M.carrier P Q).hom
  let n := (FiniteTensor.flattenIso (V := C)).hom.app N
  let b := T.map (blockUnitAppliedMap N (localUnitIndices E.toCollection M.carrier P Q)
    (nestedOperationFactors E.toCollection M.carrier (datum P Q)).obj (localUnitMap E
      M.carrier P Q))
  let c := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app V)
  let e := T.map (collapsedMap E M P Q)
  let s := T.map (FiniteFamily.mapSingletonFlattenIso.hom.app V)
  let g := T.map (evaluatedFactors E M P Q)
  let q := (operationSummandFunctor E.toCollection M.carrier).map (frozenOuterProfileHom P Q
    (Linear.Constants.branches
    Q))
  let out := M.operations.app P.outputColor (profileInputs (extendProfile P Q))
  have hd : r ≫ f = d ≫ n ≫ b := (Category.assoc a input f).trans (inputDistribution E
    M.carrier P Q)
  have hc : b ≫ i = c ≫ e := (T.map_comp _ _).symm.trans
    ((congrArg T.map (localEvaluation E M P Q)).trans (T.map_comp _ _))
  have hs : n ≫ c = s := (mapSingletonFlattenLaw_app V).symm
  have hr : d ≫ s ≫ e = g ≫ q := (EnvelopingSource240_mapThree T _ _ _).symm.trans
    ((congrArg T.map (rawEvaluation_outer E M P Q)).trans (T.map_comp _ _))
  have ho : q ≫ o = out := (M.operations.profile_equivariance (frozenOuterProfileHom P Q
    (Linear.Constants.branches
    Q))).trans (Category.comp_id _)
  exact (Category.assoc a input (f ≫ i ≫ o)).symm.trans (innerFold r f i o d n b c e s g
    q out hd hc hs hr ho)


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

