namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary.UnitSource

open CategoryTheory

private theorem EnvelopingSource262_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem sourceFold {V : Type*} [Category* V]
    {U X SX TX R Y SU TU J IJ OPT : V}
    (η : U ⟶ X) (sx : X ⟶ SX) (ax : SX ⟶ TX) (bx : TX ⟶ R) (f : R ⟶ Y)
    (su : U ⟶ SU) (y : SU ⟶ SX) (au : SU ⟶ TU) (fy : TU ⟶ TX)
    (pj : U ⟶ J) (l : J ⟶ SU) (aj : J ⟶ IJ) (fl : IJ ⟶ TU)
    (κ : IJ ⟶ OPT) (β : OPT ⟶ R) (popt : U ⟶ OPT)
    (hη : η ≫ sx = su ≫ y) (hy : y ≫ ax = au ≫ fy) (hone : pj ≫ l = su)
    (hl : l ≫ au = aj ≫ fl) (hz : fl ≫ fy ≫ bx = κ ≫ β) (hopt : pj ≫ aj ≫ κ = popt) :
    η ≫ sx ≫ ax ≫ bx ≫ f = popt ≫ β ≫ f := by
  have hz' : fl ≫ fy ≫ bx ≫ f = κ ≫ β ≫ f := by
    simpa only [Category.assoc] using congrArg (· ≫ f) hz
  rw [← Category.assoc η sx (ax ≫ bx ≫ f), hη]
  simp only [Category.assoc]
  rw [← Category.assoc y ax (bx ≫ f), hy]
  simp only [Category.assoc]
  rw [← hone]
  simp only [Category.assoc]
  rw [← Category.assoc l au (fy ≫ bx ≫ f), hl]
  simp only [Category.assoc]
  rw [hz']
  simpa only [Category.assoc] using congrArg (fun p => p ≫ β ≫ f) hopt

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The single actual inserted tensor unit maps to its original singleton position. -/
def oneSingletonMap :
    frozenVariableUnitFamily (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C) ⟶
      (FiniteFamily.singleton (C := C)).obj ((FiniteTensor.tensor (V :=
        C)).obj FiniteFamily.empty) where
  equiv := Equiv.sumEmpty PUnit Empty
  hom i := match i with | Sum.inl _ => 𝟙 _ | Sum.inr i => i.elim

/-- The actual one-unit prefix is precisely the original singleton unitor inverse. -/
theorem onePrefix_singleton :
    (frozenVariableTensorUnitIso (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C)).hom ≫
        (FiniteTensor.tensor (V := C)).map (oneSingletonMap (C := C)) =
      (FiniteTensor.singletonIso (V := C)).inv.app ((FiniteTensor.tensor (V :=
        C)).obj FiniteFamily.empty) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of PUnit
  let a := tensorAllUnitInsertion (C := C) I
  let e := allUnitFrozenIso (C := C) I
  let s := allUnitSingletonIso (C := C)
  have hf : e.hom ≫ oneSingletonMap = s.hom := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      exact heq_of_eq (Category.id_comp _)
  have ht : T.map e.hom ≫ T.map oneSingletonMap = T.map s.hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map hf)
  exact (congrArg (· ≫ T.map oneSingletonMap) (tensorAllUnitInsertion_frozen I).symm).trans
    ((Category.assoc _ _ _).trans ((congrArg (a ≫ ·) ht).trans tensorAllUnitInsertion_singleton))

/-- The original all-unit option family maps its root through η and retains each other unit. -/
def bareMap (X : C) (I : FintypeCat.{0}) (η : (FiniteTensor.tensor (V :=
  C)).obj FiniteFamily.empty ⟶ X) :
    frozenVariableUnitFamily (FintypeCat.of (Option I)) (FiniteFamily.empty : FiniteFamily
      C) ⟶ Unit.unitRootFamily X
      I where
  equiv := Equiv.sumEmpty (Option I) Empty
  hom i := match i with
    | Sum.inl none => η
    | Sum.inl (some _) => 𝟙 _
    | Sum.inr i => i.elim

/-- The original two-prefix option bijection, retaining every original unit position. -/
def optionPrefixMap (I : FintypeCat.{0}) :
    frozenVariableUnitFamily I
        (frozenVariableUnitFamily (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C)) ⟶
      frozenVariableUnitFamily (FintypeCat.of (Option I)) (FiniteFamily.empty : FiniteFamily C) :=
  (Unit.prefixUnitReindexIso I (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C)).hom ≫
    Linear.RightUnitGeometry.unitsReindex
      (I := FintypeCat.of (I ⊕ PUnit)) (J := FintypeCat.of (Option I))
      (Unit.rightPositionEquiv I).symm (FiniteFamily.empty : FiniteFamily C)

/-- The actual two original prefixes fuse to the original all-unit option prefix. -/
theorem optionPrefix_fusion (I : FintypeCat.{0}) :
    (frozenVariableTensorUnitIso (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C)).hom ≫
        (frozenVariableTensorUnitIso I
          (frozenVariableUnitFamily (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily
            C))).hom ≫
        (FiniteTensor.tensor (V := C)).map (optionPrefixMap I) =
      (frozenVariableTensorUnitIso (FintypeCat.of (Option I)) (FiniteFamily.empty :
        FiniteFamily C)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let E := (FiniteFamily.empty : FiniteFamily C)
  let p := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) E).hom
  let a := (frozenVariableTensorUnitIso I (frozenVariableUnitFamily (FintypeCat.of PUnit) E)).hom
  let r := (Unit.prefixUnitReindexIso I (FintypeCat.of PUnit) E).hom
  let q := Linear.RightUnitGeometry.unitsReindex
    (I := FintypeCat.of (I ⊕ PUnit)) (J := FintypeCat.of (Option I))
      (Unit.rightPositionEquiv I).symm E
  exact (congrArg (p ≫ a ≫ ·) (T.map_comp r q)).trans
    ((Category.assoc p a (T.map r ≫ T.map q)).symm.trans
      ((Category.assoc (p ≫ a) (T.map r) (T.map q)).symm.trans
        ((congrArg (· ≫ T.map q) ((Category.assoc p a (T.map r)).trans
          (Unit.tensorUnitPrefix_fusion I (FintypeCat.of PUnit) E))).trans
          (Linear.RightUnitGeometry.tensorPrefixReindex
            (I := FintypeCat.of (I ⊕ PUnit)) (J := FintypeCat.of (Option I))
              (Unit.rightPositionEquiv I).symm E))))

/-- Original retained singleton and unit-root normalization maps agree
with the actual all-unit option map, on each original unit position. -/
theorem sourceFactor_readback (X : C) (I : FintypeCat.{0})
    (η : (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty ⟶ X) :
    frozenVariableUnitFamilyMap I (oneSingletonMap (C := C)) ≫
        frozenVariableUnitFamilyMap I ((FiniteFamily.singleton (C := C)).map η) ≫
        (Unit.rightUnitPositionIso X I).hom = optionPrefixMap I ≫ bareMap X I η := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | inl i => rfl
    | inr i => cases i with
        | inl i => cases i; rfl
        | inr i => cases i
  · intro i
    cases i with
    | inl i =>
        let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
        change HEq (𝟙 U ≫ 𝟙 U ≫ 𝟙 U) ((𝟙 U ≫ 𝟙 U) ≫ 𝟙 U)
        exact heq_of_eq (by simp only [Category.id_comp])
    | inr i =>
        cases i with
        | inl i =>
            cases i
            let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
            change HEq (𝟙 U ≫ η ≫ 𝟙 X) ((𝟙 U ≫ 𝟙 U) ≫ η)
            exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
        | inr i => cases i

/-- An original coefficient map from the tensor unit followed by
actual right insertion is the original all-unit prefix and its original
root/unit factor map, with no additional tensor or operation-law input. -/
theorem rightInsert_fromUnit (X : C) (I : FintypeCat.{0})
    (η : (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty ⟶ X)
    {F : FiniteFamily C} (f : Unit.unitRootFamily X I ⟶ F) :
    η ≫ UnitInsertion.rightInsertFromFactor X I (Unit.rightRootNormalizer X I ≫ f) =
      (frozenVariableTensorUnitIso (FintypeCat.of (Option I)) (FiniteFamily.empty :
        FiniteFamily C)).hom ≫
        (FiniteTensor.tensor (V := C)).map (bareMap X I η ≫ f) := by
  let T := FiniteTensor.tensor (V := C)
  let U := T.obj (FiniteFamily.empty : FiniteFamily C)
  let sx := (FiniteTensor.singletonIso (V := C)).inv.app X
  let ax := (frozenVariableTensorUnitIso I ((FiniteFamily.singleton (C := C)).obj X)).hom
  let bx := T.map (Unit.rightUnitPositionIso X I).hom
  let su := (FiniteTensor.singletonIso (V := C)).inv.app U
  let y := T.map ((FiniteFamily.singleton (C := C)).map η)
  let au := (frozenVariableTensorUnitIso I ((FiniteFamily.singleton (C := C)).obj U)).hom
  let fy := T.map (frozenVariableUnitFamilyMap I ((FiniteFamily.singleton (C := C)).map η))
  let pj := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) (FiniteFamily.empty :
    FiniteFamily C)).hom
  let l := T.map (oneSingletonMap (C := C))
  let aj := (frozenVariableTensorUnitIso I
    (frozenVariableUnitFamily (FintypeCat.of PUnit) (FiniteFamily.empty : FiniteFamily C))).hom
  let fl := T.map (frozenVariableUnitFamilyMap I (oneSingletonMap (C := C)))
  let κ := T.map (optionPrefixMap I)
  let β := T.map (bareMap X I η)
  let popt := (frozenVariableTensorUnitIso (FintypeCat.of (Option I)) (FiniteFamily.empty :
    FiniteFamily C)).hom
  have hη : η ≫ sx = su ≫ y := (FiniteTensor.singletonIso (V := C)).inv.naturality η
  have hy : y ≫ ax = au ≫ fy := frozenVariableTensorUnitIso_naturality I
    ((FiniteFamily.singleton (C := C)).map η)
  have hone : pj ≫ l = su := onePrefix_singleton
  have hl : l ≫ au = aj ≫ fl := frozenVariableTensorUnitIso_naturality I (oneSingletonMap (C := C))
  have hz : fl ≫ fy ≫ bx = κ ≫ β :=
    (EnvelopingSource262_mapThree T _ _ _).symm.trans ((congrArg T.map
      (sourceFactor_readback X I η)).trans (T.map_comp
      _ _))
  have hopt : pj ≫ aj ≫ κ = popt := optionPrefix_fusion I
  exact (congrArg (η ≫ ·) (Unit.rightInsertFromNormalizedFactor X I f)).trans
    ((congrArg (η ≫ sx ≫ ax ≫ ·) (T.map_comp (Unit.rightUnitPositionIso X I).hom f)).trans
      ((sourceFold η sx ax bx (T.map f) su y au fy pj l aj fl κ β popt hη hy hone hl hz hopt).trans
        (congrArg (popt ≫ ·) (T.map_comp (bareMap X I η) f).symm)))


