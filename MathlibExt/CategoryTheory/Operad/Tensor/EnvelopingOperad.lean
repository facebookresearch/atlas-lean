namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual original linear coefficient natural substitution
satisfies the full original colored association law. Its complete
source is the actual original joint coefficient tensor colimit, and its
representative routes are the original weighted operation routes. -/
theorem envelopingLinearSubstitution_assoc (O : ColoredOperadObj W C) (B : W → C) :
    ColoredOperadObj.IsAssociative (linearCoefficientCollection O.toCollection B)
      (envelopingLinearSubstitutionMap O B) := by
  intro d
  apply Linear.assoc_hom_ext O.toCollection B d
  intro Q
  let a := (FiniteTensor.tensor (V := C)).map (Linear.assocWeightedFamilyIso O.toCollection
    B d Q).hom
  exact (Linear.assocRouteA_β O B d Q).trans
    ((congrArg (a ≫ ·)
      (envelopingAssocWeightedRepresentativeColimit_assoc O B d (Linear.assocChoices
        O.toCollection B d Q))).trans
        (Linear.assocRouteB_β O B d Q).symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
