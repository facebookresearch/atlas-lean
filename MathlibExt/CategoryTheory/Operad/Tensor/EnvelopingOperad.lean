      (envelopingAssocWeightedRootFirstBlockTensorIso O B d Q).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let T := FiniteTensor.tensor (V := C)
