open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The generic tensor coefficient family retains the exact
original root-first coefficient blocks, with identity components. -/
def envelopingAssocRootFirstTensorCoefficientBlocksIso (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    coefficientBlockFamily (FintypeCat.of (Option d.middleData.totalProfile.inputs))
        (envelopingAssocRootFirstCoefficientBlockTensors O d Q) ≅
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (envelopingAssocRootFirstCoefficientBlocks O d Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.middleData.totalProfile.inputs))
    (fun _ => Iso.refl _)

/-- The actual original root-first coefficient tensors collapse
to the original complete coefficient tensor through their exact original regrouping inverse. -/
def envelopingAssocRootFirstFullCoefficientTensorIso (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj
        (coefficientBlockFamily (FintypeCat.of (Option d.middleData.totalProfile.inputs))
          (envelopingAssocRootFirstCoefficientBlockTensors O d Q)) ≅
      (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O d Q) :=
  (FiniteTensor.tensor (V := C)).mapIso (envelopingAssocRootFirstTensorCoefficientBlocksIso
    O d Q) ≪≫
    ((FiniteTensor.flattenIso (V := C)).app (envelopingAssocRootFirstCoefficientBlocks O d
      Q)).symm ≪≫
    ((FiniteTensor.tensor (V := C)).mapIso (envelopingAssocRootFirstCoefficientIso O d Q)).symm

/-- The original weighted root-first source normalizes to its
original root-first coefficient tensors and all original root/middle/inner leaves. -/
def envelopingAssocWeightedRootFirstBlockNormalizationIso (O : ColoredSymmetricCollection W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocWeightedFamily O B d Q) ≅
      (coefficientLeafTensorFunctor (envelopingAssocRootFirstAlgebraLeaves B d Q)).obj
        ((FiniteTensor.tensor (V := C)).obj
          (coefficientBlockFamily (FintypeCat.of (Option d.middleData.totalProfile.inputs))
            (envelopingAssocRootFirstCoefficientBlockTensors O d Q))) :=
  (FiniteTensor.tensor (V := C)).mapIso (envelopingAssocWeightedRootFirstIso O B d Q) ≪≫
    (FiniteTensor.flattenIso (V := C)).app (envelopingAssocWeightedRootFirstBlocks O B d Q) ≪≫
    (FiniteTensor.tensor (V := C)).mapIso (envelopingAssocWeightedRootFirstBlockTensorIso O
      B d Q) ≪≫
    coefficientBlockInterchangeTensorIso (FintypeCat.of (Option d.middleData.totalProfile.inputs))
      (envelopingAssocRootFirstCoefficientBlockTensors O d Q)
      (fun i => (envelopingAssocRootFirstLeafBlocks B d Q).obj i)

/-- Normalize the actual original root-first weighted source to
the original complete coefficient tensor and original total algebra-input family. -/
def envelopingAssocWeightedRootFirstCommonSourceIso (O : ColoredSymmetricCollection W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocWeightedFamily O B d Q) ≅
      (coefficientLeafTensorFunctor
        ((addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q))).obj
        ((FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O d Q)) :=
  envelopingAssocWeightedRootFirstBlockNormalizationIso O B d Q ≪≫
    (FiniteTensor.tensor (V := C)).mapIso (coefficientLeafIso
      (envelopingAssocRootFirstFullCoefficientTensorIso O d Q)
      (envelopingAssocRootFirstLeafIso B d Q))

/-- Evaluate the original coefficient route B with its actual
root-first source normalization and exact original total algebra inputs. -/
def envelopingAssocWeightedRootFirstCommonEvaluation (O : ColoredOperadObj W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocWeightedFamily O.toCollection B d Q) ⟶
      (linearCoefficientDiagram O.toCollection B d.outerAfterInnerData.totalProfile).obj
        (envelopingAssocTotalAlgebraInputs d Q) :=
  (envelopingAssocWeightedRootFirstCommonSourceIso O.toCollection B d Q).hom ≫
    (coefficientLeafTensorFunctor
      ((addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q))).map
      (envelopingAssocRepresentativeRouteB O d Q)


