    {L M N : FiniteFamily C} (ell : L ⟶ M) (t : M ⟶ N) :
    coefficientLeafMap a ell ≫ (coefficientLeafFamilyFunctor M).map b ≫ coefficientLeafMap c t =
      coefficientLeafMap (a ≫ b ≫ c) (ell ≫ t) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none => rfl
    | some i =>
      change HEq (ell.hom i ≫ 𝟙 (M.obj (ell.equiv i)) ≫ t.hom (ell.equiv i))
