  exact epi_of_epi_fac (coefficientAnalyticIso_naturality (collectionπ f g) M q).symm

omit [HasColimitsOfSize.{us, us} C] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- The balance condition is the original P-operation equality after the
original coefficient/analytic comparison, with all leaf objects unchanged. -/
theorem rawOperation_balance (A : Tensor.Algebra Q) (balance : Balanced f g A)
    (d : W) (q : AnalyticIndex W d) :
    (coefficientLeafTensorFunctor ((analyticInputFamily A.carrier).obj q)).map
      (f.toCollectionHom.app
      q.toColoredProfile) ≫
        ((coefficientAnalyticIso Q.toCollection A.carrier q).hom ≫ A.operations.app d q) =
      (coefficientLeafTensorFunctor ((analyticInputFamily A.carrier).obj q)).map
        (g.toCollectionHom.app
        q.toColoredProfile) ≫
        ((coefficientAnalyticIso Q.toCollection A.carrier q).hom ≫ A.operations.app d q) :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ A.operations.app d q) (coefficientAnalyticIso_naturality
      f.toCollectionHom A.carrier q)).trans
