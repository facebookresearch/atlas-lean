/- Exact checked source: EnvelopingAssociativityBlockInsertion. -/
section EnvelopingSource050


/-!
# Actual blockwise unit/coefficient insertion into original operad association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Each original root/middle coefficient block has precisely
its own original algebra-input unit positions. -/
def envelopingAssocBlockUnits (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    Option d.branches.index → FintypeCat.{0}
  | none => FintypeCat.of Empty
  | some i => (Q.branch i none).index

/-- The actual original root/branch coefficient target family
before the root algebra-input unary branches are added. -/
def envelopingAssocBlockTargets (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : Option d.branches.index → FiniteFamily C
  | none => (FiniteFamily.singleton (C := C)).obj (O.obj (extendProfile
    d.middleData.outerProfile Q.root))
  | some i => (ColoredOperadObj.substitutionFactors O).obj
      (envelopingRepresentativeSubstitution (d.localData i) (Q.branch i))

/-- The root block with no inserted units is retained through
the original empty-prefix inverse; branch units are the actual
original operad unit maps at every original middle algebra input. -/
def envelopingAssocBlockTargetMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) (i : Option d.branches.index) :
    frozenVariableUnitFamily (envelopingAssocBlockUnits d Q i)
      ((envelopingAssocCoefficientBlocks O.toCollection d Q).obj i) ⟶
        envelopingAssocBlockTargets O.toCollection d Q i :=
  match i with
  | none =>
    { equiv := Equiv.emptySum Empty PUnit
      hom p := match p with
        | Sum.inl p => p.elim
        | Sum.inr _ => 𝟙 _ }
  | some i => envelopingRepresentativeUnitMap O (d.localData i) (Q.branch i)

/-- The actual original blockwise coefficient tensor insertion,
including root singleton and every original middle algebra-input unit. -/
def envelopingAssocBlockAppliedMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :=
  blockUnitAppliedMap (envelopingAssocCoefficientBlocks O.toCollection d Q)
    (envelopingAssocBlockUnits d Q) (envelopingAssocBlockTargets O.toCollection d Q)
    (envelopingAssocBlockTargetMap O d Q)

/-- The actual original blockwise tensor insertions are obtained
from their genuine global finite unit insertion by the exact
original dependent unit-position bijection. -/
theorem envelopingAssocBlockDistribution (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (frozenVariableTensorUnitIso
        (blockUnitIndex (envelopingAssocCoefficientBlocks O.toCollection d Q)
          (envelopingAssocBlockUnits d Q))
        (envelopingAssocCoefficients O.toCollection d Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (blockUnitGlobalMap (envelopingAssocCoefficientBlocks O.toCollection d Q)
          (envelopingAssocBlockUnits d Q) (envelopingAssocBlockTargets O.toCollection d Q)
          (envelopingAssocBlockTargetMap O d Q)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app
        ⟨(envelopingAssocCoefficientBlocks O.toCollection d Q).index,
          envelopingAssocBlockTargets O.toCollection d Q⟩ =
    (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocCoefficientBlocks
      O.toCollection d Q) ≫
      (FiniteTensor.tensor (V := C)).map (envelopingAssocBlockAppliedMap O d Q) :=
  tensorUnitBlock_applied (envelopingAssocCoefficientBlocks O.toCollection d Q)
    (envelopingAssocBlockUnits d Q) (envelopingAssocBlockTargets O.toCollection d Q)
    (envelopingAssocBlockTargetMap O d Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource050

/- Exact checked source: TensorUnitEmptyPrefix. -/
section EnvelopingSource051


/-!
# Empty tensor-unit prefixes retain the original finite coefficient tensor
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem emptyPrefixFold {V : Type*} [Category* V]
    {X A B D E Y : V} (r : X ≅ A) (a : X ⟶ B) (b : B ⟶ D) (j : D ⟶ A)
    (p : X ⟶ E) (c : E ⟶ Y) (d : Y ⟶ A) (f : B ⟶ Y)
    (h1 : p ≫ c = a ≫ f) (h2 : f ≫ d = b ≫ j) (h3 : p ≫ c ≫ d = r.hom) :
    r.inv ≫ a ≫ b ≫ j = 𝟙 A := by
  have h : a ≫ b ≫ j = r.hom := by
    rw [← h2, ← Category.assoc a f, ← h1]
    exact (Category.assoc p c d).trans h3
  rw [h]
  exact r.inv_hom_id

private theorem emptyPrefixMapTriple {V : Type*} [Category* V] {D : Type*} [Category* D] (T : V ⥤ D)
    {X Y Z : V} (a : X ⟶ Y) (b : Y ⟶ Z) (f : X ⟶ Z) (h : a ≫ b = f) :
    T.map a ≫ T.map b = T.map f :=
  (T.map_comp _ _).symm.trans (congrArg T.map h)


variable {C : Type u} [Category.{v} C]

/-- No original tensor-unit position leaves precisely the
original retained coefficient family and its original input bijection. -/
def tensorEmptyPrefixFamilyIso (L : FiniteFamily C) :
    frozenVariableBlocks (FintypeCat.of Empty) L ≅
      (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj L :=
  FiniteFamily.isoOfComponents (Equiv.emptySum Empty L.index) (fun p => match p with
    | Sum.inl p => p.elim
    | Sum.inr _ => Iso.refl _)

variable [FiniteTensor C]

/-- The actual empty-prefix unit/retained family is the original
retained family by the exact original empty-sum position bijection. -/
def tensorEmptyPrefixUnitIso (L : FiniteFamily C) :
    frozenVariableUnitFamily (FintypeCat.of Empty) L ≅ L :=
  FiniteFamily.isoOfComponents (Equiv.emptySum Empty L.index) (fun p => match p with
    | Sum.inl p => p.elim
    | Sum.inr _ => Iso.refl _)

omit [FiniteTensor C] in
/-- The original flattened empty-prefix positions are exactly
the original map-singleton-flatten comparison. -/
theorem tensorEmptyPrefix_flatten (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map (tensorEmptyPrefixFamilyIso L).hom ≫
        FiniteFamily.mapSingletonFlattenIso.hom.app L =
      (frozenVariableFlattenIso (FintypeCat.of Empty) L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact i.elim
    | inr i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact i.elim
    | inr i => cases j; exact heq_of_eq (Category.comp_id _)

/-- The actual empty-prefix singleton tensor maps are the
original map-singleton tensor unitor, with every original retained map. -/
theorem tensorEmptyPrefix_tensor (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (tensorEmptyPrefixFamilyIso L).hom ≫
        (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app L =
      (frozenVariableBlockIso (FintypeCat.of Empty) L).hom ≫ (tensorEmptyPrefixUnitIso L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl p => exact p.elim
    | inr p => rfl
  · intro p
    cases p with
    | inl p => exact p.elim
    | inr p =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C :=
        C)).obj (L.obj p))) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (L.obj p))
        ((FiniteTensor.singletonIso (V := C)).hom.app (L.obj p) ≫ 𝟙 _)
      exact heq_of_eq (by rw [Functor.map_id, Category.id_comp, Category.comp_id])

/-- The actual no-position tensor-unit prefix is the original
identity tensor map under its exact empty-sum position comparison. -/
theorem tensorEmptyPrefix_unit (L : FiniteFamily C) :
    (frozenVariableTensorUnitIso (FintypeCat.of Empty) L).hom ≫
        (FiniteTensor.tensor (V := C)).map (tensorEmptyPrefixUnitIso L).hom =
      𝟙 ((FiniteTensor.tensor (V := C)).obj L) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := frozenVariableBlocks (FintypeCat.of Empty) L
  let M := (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj L
  let r := T.mapIso (frozenVariableFlattenIso (FintypeCat.of Empty) L)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let b := T.map (frozenVariableBlockIso (FintypeCat.of Empty) L).hom
  let j := T.map (tensorEmptyPrefixUnitIso L).hom
  let p := T.map (F.map (tensorEmptyPrefixFamilyIso L).hom)
  let c := (FiniteTensor.flattenIso (V := C)).hom.app M
  let d := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app L)
  let f := T.map ((FiniteFamily.map T).map (tensorEmptyPrefixFamilyIso L).hom)
  have h1 : p ≫ c = a ≫ f := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (tensorEmptyPrefixFamilyIso L).hom
  have h2 : f ≫ d = b ≫ j :=
    (emptyPrefixMapTriple T _ _ _ (tensorEmptyPrefix_tensor L)).trans (T.map_comp _ _)
  have h3 : p ≫ c ≫ d = r.hom := by
    have hlaw : c ≫ d = T.map (FiniteFamily.mapSingletonFlattenIso.hom.app L) :=
      (mapSingletonFlattenLaw_app L).symm
    exact (congrArg (p ≫ ·) hlaw).trans (emptyPrefixMapTriple T _ _ _ (tensorEmptyPrefix_flatten L))
  have h := emptyPrefixFold r a b j p c d f h1 h2 h3
  have hread : (frozenVariableTensorUnitIso (FintypeCat.of Empty) L).hom = r.inv ≫ (a ≫ b) := rfl
  exact (congrArg (· ≫ j) hread).trans ((Category.assoc r.inv (a ≫ b) j).trans
    ((congrArg (r.inv ≫ ·) (Category.assoc a b j)).trans h))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource051

/- Exact checked source: EnvelopingAssociativityBlockReadbacks. -/
section EnvelopingSource052


/-!
# Exact original root and branch block insertion readbacks
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original root block receives no unit position,
so the constructed tensor insertion retains its original identity. -/
theorem envelopingAssocBlockAppliedMap_root (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (envelopingAssocBlockAppliedMap O d Q).hom none =
      𝟙 ((FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile
          d.middleData.outerProfile Q.root))))
          := by
  let L := (FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile
    d.middleData.outerProfile Q.root))
  have hm : envelopingAssocBlockTargetMap O d Q none = (tensorEmptyPrefixUnitIso L).hom := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | inl i => exact i.elim
      | inr i => exact HEq.rfl
  exact (congrArg (fun m => (frozenVariableTensorUnitIso (FintypeCat.of Empty) L).hom ≫
    (FiniteTensor.tensor (V := C)).map m) hm).trans (tensorEmptyPrefix_unit L)

/-- Every original middle branch receives exactly its actual
representative coefficient tensor insertion and original profile map. -/
theorem envelopingAssocBlockAppliedMap_branch (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) (i : d.branches.index) :
    (envelopingAssocBlockAppliedMap O d Q).hom (some i) =
      envelopingRepresentativeCoefficientTensorMap O (d.localData i) (Q.branch i) := rfl

/-- Actual source branch substitutions, preceded by the actual
original coefficient insertion maps, contract every original
branch into its original extended total-profile coefficient. -/
def envelopingAssocBlockContractionMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
      ⟨(envelopingAssocCoefficientBlocks O.toCollection d Q).index,
        envelopingAssocBlockTargets O.toCollection d Q⟩ ⟶
      envelopingRepresentativeCoefficients O.toCollection d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q) where
  equiv := Equiv.refl (Option d.branches.index)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile d.middleData.outerProfile Q.root))
    | some i => O.subst.app (envelopingRepresentativeSubstitution (d.localData i) (Q.branch i)) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom (d.localData i) (Q.branch i))

/-- The actual original blockwise operad insertions and
substitutions give the original representative branch contraction map. -/
theorem envelopingAssocBlockContraction_factorization (O : ColoredOperadObj W C) (d :
  ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocBlockAppliedMap O d Q ≫ envelopingAssocBlockContractionMap O d Q =
      envelopingAssocInnerContractionMap O d Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      exact heq_of_eq ((congrArg (· ≫ (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile d.middleData.outerProfile Q.root)))
        (envelopingAssocBlockAppliedMap_root O d Q)).trans (Category.id_comp _))
    | some i => exact HEq.rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource052

/- Exact checked source: EnvelopingAssociativityInnerFactorization. -/
section EnvelopingSource053


/-!
# Actual inner coefficient contraction from original global unit insertion
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

private theorem originalInnerFactorSquares {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (q : A ⟶ B) (n : B ⟶ D) (c : D ⟶ Y)
    (a : X ⟶ E) (b : E ⟶ D) (f : E ⟶ Y)
    (h : p ≫ q ≫ n = a ≫ b) (hf : b ≫ c = f) :
    p ≫ q ≫ n ≫ c = a ≫ f := by
  rw [← Category.assoc q n, ← Category.assoc p (q ≫ n), h, Category.assoc, hf]

/-- The actual original inner-first coefficient contraction
factors through the genuine global unit insertion, original block
flattening and original O substitutions at every original branch. -/
theorem envelopingAssocInnerContraction_factorization (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (frozenVariableTensorUnitIso
        (blockUnitIndex (envelopingAssocCoefficientBlocks O.toCollection d Q)
          (envelopingAssocBlockUnits d Q))
        (envelopingAssocCoefficients O.toCollection d Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (blockUnitGlobalMap (envelopingAssocCoefficientBlocks O.toCollection d Q)
          (envelopingAssocBlockUnits d Q) (envelopingAssocBlockTargets O.toCollection d Q)
          (envelopingAssocBlockTargetMap O d Q)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app
        ⟨(envelopingAssocCoefficientBlocks O.toCollection d Q).index,
          envelopingAssocBlockTargets O.toCollection d Q⟩ ≫
      (FiniteTensor.tensor (V := C)).map (envelopingAssocBlockContractionMap O d Q) =
    envelopingAssocInnerContraction O d Q := by
  let T := FiniteTensor.tensor (V := C)
  have h : T.map (envelopingAssocBlockAppliedMap O d Q) ≫
      T.map (envelopingAssocBlockContractionMap O d Q) = T.map
        (envelopingAssocInnerContractionMap O d Q) :=
    (T.map_comp _ _).symm.trans (congrArg T.map
      (envelopingAssocBlockContraction_factorization O d Q))
  let p := (frozenVariableTensorUnitIso
    (blockUnitIndex (envelopingAssocCoefficientBlocks O.toCollection d Q)
      (envelopingAssocBlockUnits d Q))
    (envelopingAssocCoefficients O.toCollection d Q)).hom
  let q := T.map (blockUnitGlobalMap (envelopingAssocCoefficientBlocks O.toCollection d Q)
    (envelopingAssocBlockUnits d Q) (envelopingAssocBlockTargets O.toCollection d Q)
    (envelopingAssocBlockTargetMap O d Q))
  let n := (FiniteTensor.flattenIso (V := C)).hom.app
    ⟨(envelopingAssocCoefficientBlocks O.toCollection d Q).index,
      envelopingAssocBlockTargets O.toCollection d Q⟩
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocCoefficientBlocks
    O.toCollection d Q)
  let b := T.map (envelopingAssocBlockAppliedMap O d Q)
  let c := T.map (envelopingAssocBlockContractionMap O d Q)
  exact originalInnerFactorSquares p q n c a b (T.map (envelopingAssocInnerContractionMap O d Q))
    (envelopingAssocBlockDistribution O d Q) h


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource053

