/- Exact checked source: FrozenBranchTensorNormalization. -/
section EnvelopingSource015


/-!
# Original root/branch tensors normalize to retained coefficients and algebra leaves
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root coefficient and actual weighted inner
profile tensors, with the original coefficient/branch positions. -/
def frozenWeightedBranchFamily (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) : FiniteFamily C where
  index := FintypeCat.of (Option Q.index)
  obj i := match i with
    | none => O.obj (extendProfile P Q)
    | some j => (analyticSummand O B).obj (R j)

/-- Expand only the original root singleton and original inner
profile coefficient/algebra-input families. -/
def frozenWeightedNestedFamily (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option Q.index)
  obj i := match i with
    | none => (FiniteFamily.singleton (C := C)).obj (O.obj (extendProfile P Q))
    | some j => (analyticFactors O B).obj (R j)

/-- The actual root singleton unitor compares the weighted
family with the original tensor of its expanded finite blocks. -/
def frozenWeightedRootIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O B P Q R ≅
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (frozenWeightedNestedFamily O B
        P Q R) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => ((FiniteTensor.singletonIso (V := C)).app (O.obj (extendProfile P Q))).symm
    | some _j => Iso.refl _)

/-- The original total family of retained algebra-leaf objects,
with every original branch/input color position unchanged. -/
def frozenAlgebraLeaves (B : W → C) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
  FiniteFamily C :=
  (addedAlgebraInputs B).obj (frozenTotalInputs Q R)

/-- Move the original root/inner coefficients into their
retained coefficient block and leave each original algebra input
at its displayed dependent-sum position. -/
def frozenBranchLeafEquiv (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    ((FiniteFamily.flatten (C := C)).obj (frozenWeightedNestedFamily O B P Q R)).index ≃
      ((FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (frozenCoefficientFamily O P Q R) (frozenAlgebraLeaves B Q
          R))).index where
  toFun p := match p with
    | ⟨none, _⟩ => ⟨none, none⟩
    | ⟨some j, none⟩ => ⟨none, some j⟩
    | ⟨some j, some k⟩ => ⟨some ⟨j, k⟩, PUnit.unit⟩
  invFun p := match p with
    | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
    | ⟨none, some j⟩ => ⟨some j, none⟩
    | ⟨some ⟨j, k⟩, _⟩ => ⟨some j, some k⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => rcases i with ⟨i, k⟩; cases j; rfl

/-- The displayed coefficient/leaf bijection preserves the
actual original coefficient and every actual algebra-leaf object. -/
def frozenBranchLeafIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).obj (frozenWeightedNestedFamily O B P Q R) ≅
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (frozenCoefficientFamily O P Q R) (frozenAlgebraLeaves B Q R)) :=
  FiniteFamily.isoOfReindex (frozenBranchLeafEquiv O B P Q R) (by
    intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j <;> rfl)

/-- The actual weighted root/inner tensor is the original
retained coefficient tensor with all original algebra leaves,
by source finite flattening/singleton coherence. -/
def frozenBranchTensorNormalizationIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).obj (frozenWeightedBranchFamily O B P Q R) ≅
      (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).obj
        ((FiniteTensor.tensor (V := C)).obj (frozenCoefficientFamily O P Q R)) :=
  (FiniteTensor.tensor (V := C)).mapIso (frozenWeightedRootIso O B P Q R) ≪≫
    ((FiniteTensor.flattenIso (V := C)).app (frozenWeightedNestedFamily O B P Q R)).symm ≪≫
      (FiniteTensor.tensor (V := C)).mapIso (frozenBranchLeafIso O B P Q R) ≪≫
        coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q R)
          (frozenAlgebraLeaves B Q R)

/-- Actual partial operadic substitution evaluates every
original weighted branch tensor into the original linear
coefficient diagram, retaining all its algebra-leaf maps. -/
def frozenWeightedBranchEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).obj (frozenWeightedBranchFamily O.toCollection B P Q R) ⟶
      (linearCoefficientDiagram O.toCollection B P).obj (frozenTotalInputs Q R) :=
  (frozenBranchTensorNormalizationIso O.toCollection B P Q R).hom ≫
    (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).map
      (frozenPartialSubstitution O P Q R)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource015

/- Exact checked source: FrozenBranchTensorMaps. -/
section EnvelopingSource016


/-!
# Original branch maps commute with coefficient/algebra-leaf normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original weighted branch maps retain the root coefficient
and every original analytic inner-profile tensor map. -/
def frozenWeightedBranchMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenWeightedBranchFamily O B P Q R ⟶ frozenWeightedBranchFamily O B P Q S where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 (O.obj (extendProfile P Q))
    | some j => (analyticSummand O B).map (f j)

/-- Expand the same original root and branch maps on the
displayed singleton/analytic-factor blocks. -/
def frozenWeightedNestedMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenWeightedNestedFamily O B P Q R ⟶ frozenWeightedNestedFamily O B P Q S where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 ((FiniteFamily.singleton (C := C)).obj (O.obj (extendProfile P Q)))
    | some j => (analyticFactors O B).map (f j)

/-- The original algebra-leaf map induced by all the supplied
inner-profile bijections and their actual color transports. -/
def frozenAlgebraLeavesMap (B : W → C) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q}
    (f : R ⟶ S) : frozenAlgebraLeaves B Q R ⟶ frozenAlgebraLeaves B Q S :=
  (addedAlgebraInputs B).map (frozenTotalInputsMap Q f)

/-- The root singleton comparison commutes with the original
root identity and every original branch tensor map. -/
theorem frozenWeightedRootIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (frozenWeightedRootIso O B P Q R).hom ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (frozenWeightedNestedMap O B P Q f) =
      frozenWeightedBranchMap O B P Q f ≫ (frozenWeightedRootIso O B P Q S).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq ((FiniteTensor.singletonIso (V := C)).inv.app (O.obj (extendProfile P Q)) ≫
        (FiniteTensor.tensor (V := C)).map (𝟙 _))
        (𝟙 _ ≫ (FiniteTensor.singletonIso (V := C)).inv.app (O.obj (extendProfile P Q)))
      exact heq_of_eq ((congrArg ((FiniteTensor.singletonIso (V := C)).inv.app
        (O.obj (extendProfile P Q)) ≫ ·) ((FiniteTensor.tensor (V := C)).map_id _)).trans
          ((Category.comp_id _).trans (Category.id_comp _).symm))
    | some j =>
      change HEq (𝟙 _ ≫ (analyticSummand O B).map (f j)) ((analyticSummand O B).map (f j) ≫ 𝟙 _)
      exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

omit [FiniteTensor C] in
/-- The exact original coefficient/algebra-leaf bijection is
natural in every original branch map, retaining both coefficient
maps and all dependent-sum input color transports. -/
theorem frozenBranchLeafIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteFamily.flatten (C := C)).map (frozenWeightedNestedMap O B P Q f) ≫
        (frozenBranchLeafIso O B P Q S).hom =
      (frozenBranchLeafIso O B P Q R).hom ≫ (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap ((frozenCoefficientFunctor O P Q).map f)
          (frozenAlgebraLeavesMap B Q f)) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i =>
      cases j with
      | none =>
        change HEq (O.map (f i) ≫ 𝟙 _) (𝟙 _ ≫ O.map (f i))
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
      | some j =>
        change HEq (eqToHom (congrArg B ((f i).inputColor_eq j)) ≫ 𝟙 _)
          (𝟙 _ ≫ eqToHom (congrArg B ((f i).inputColor_eq j)))
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
