private theorem twoOriginalColimitInjections {V : Type*} [Category* V]
    {A B D S T : V} (i : S ⟶ A) (a : A ⟶ B) (b : B ⟶ D)
    (u : S ⟶ T) (j : T ⟶ B) (k : T ⟶ D)
    (h1 : i ≫ a = u ≫ j) (h2 : j ≫ b = k) : i ≫ (a ≫ b) = u ≫ k := by
  rw [← Category.assoc i a, h1, Category.assoc u j, h2]

/-- Empty variable inputs give precisely the actual original
profile coinvariants O circle B, through the original empty-sum
comparison and the full original input-profile equivalence. -/
def nullaryLinearCoefficientIso (O : ColoredSymmetricCollection W C) (B : W → C) (d : W) :
    linearCoefficient O B (ColoredProfile.nullary d) ≅ profileCoinvariants O B d := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits d
  letI : (inputsToProfile d).IsEquivalence := (coloredInputsProfileEquivalence
    d).isEquivalence_functor
  exact HasColimit.isoOfNatIso (nullaryLinearDiagramIso O B d) ≪≫
    Functor.Final.colimitIso (inputsToProfile d) (analyticSummand O B)

/-- Every original nullary-variable coefficient/input injection
is the original free-algebra profile injection after its actual
retained tensor/profile comparison. -/
theorem nullaryLinearCoefficientIso_ι (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (Q : ColoredInputs W) :
    linearCoefficientι O B (ColoredProfile.nullary d) Q ≫ (nullaryLinearCoefficientIso O B d).hom =
      (nullaryLinearDiagramIso O B d).hom.app Q ≫ profileι O B ((inputsToProfile d).obj Q) := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits d
  let : (inputsToProfile d).IsEquivalence := (coloredInputsProfileEquivalence
    d).isEquivalence_functor
  let e := nullaryLinearDiagramIso O B d
  let a := (HasColimit.isoOfNatIso e).hom
  let b := (Functor.Final.colimitIso (inputsToProfile d) (analyticSummand O B)).hom
  exact twoOriginalColimitInjections (colimit.ι (linearCoefficientDiagram O B
    (ColoredProfile.nullary d)) Q)
    a b (e.hom.app Q) (colimit.ι (inputsToProfile d ⋙ analyticSummand O B) Q)
    (profileι O B ((inputsToProfile d).obj Q))
    (HasColimit.ι_isoOfNatIso_hom e Q)
    (Functor.Final.ι_colimitIso_hom (inputsToProfile d) (analyticSummand O B) Q)


end CategoryTheory.Operad.Tensor.Enveloping

