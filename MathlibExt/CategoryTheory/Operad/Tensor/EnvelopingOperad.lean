/- Exact checked source: EnvelopingConstantInputReadback. -/
section EnvelopingSource330


/-!
# The genuine operadic face is the full original weighted constant-input action
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem originalRootedNormalization {D : Type*} [Category* D]
    {X A B C E F Y : D} (p : X ⟶ A) (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E)
    (d : E ⟶ F) (i : F ⟶ Y) (f : A ⟶ F) (h : a ≫ b ≫ c ≫ d = f) :
    p ≫ a ≫ b ≫ c ≫ d ≫ i = p ≫ f ≫ i := by
  simpa only [Category.assoc] using congrArg (fun f => p ≫ f ≫ i) h

private theorem originalRootedCofanAssociativity {D : Type*} [Category* D]
    {X A B Y : D} (i : X ⟶ A) (e : A ⟶ B) (f g : B ⟶ Y)
    (h : (i ≫ e) ≫ f = (i ≫ e) ≫ g) : i ≫ (e ≫ f) = i ≫ (e ≫ g) :=
  (Category.assoc i e f).symm.trans (h.trans (Category.assoc i e g))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

namespace ConstantActionExtension

/-- Every original rooted free-input cofan evaluates the genuine
extension by its literal original O rooted substitution and cofan. -/
theorem rootedRepresentative_original (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫
      Linear.Constants.representative (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
          O.toCollection B d).inv) P Q =
      rootedFrozenEvaluation O B P Q R := by
  let T := FiniteTensor.tensor (V := C)
  let S := rootedFrozenBranches P Q R
  let p := T.map (rootedFrozenFamilyIso O.toCollection B P Q R).hom
  let a := (frozenVariableTensorUnitIso P.inputs (frozenWeightedBranchFamily O.toCollection
    B P Q S)).hom
  let b := T.map (weightedInsertion O B P Q S)
  let c := envelopingRepresentativeEvaluation O B (shape P Q) (choices P Q S)
  let d := T.map (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q S))
    ((addedAlgebraInputs B).map (totalInputsIso P Q S).hom))
  let i := linearCoefficientι O.toCollection B P (frozenTotalInputs Q S)
  let f := frozenWeightedBranchEvaluation O B P Q S
  have h : a ≫ b ≫ c ≫ d = f := weightedRepresentative_normalization O B P Q S
  exact (rootedRepresentative_linear_cofan O B P Q R).trans
    (originalRootedNormalization p a b c d i f h)

/-- Full original finite tensor/profile cofan density identifies
the genuine constants evaluator with the literal original partial
constant-input substitution for every original variable/input profile. -/
theorem representative_original (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    Linear.Constants.representative (originalOperationToLinearOperadMap O B)
      (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
        O.toCollection B d).inv) P Q =
      constantInputSubstitution O B P Q := by
  let e := rootedFrozenPointIso O.toCollection B P Q
  apply (cancel_epi e.hom).1
  apply (rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile P Q)) O.toCollection B
    ((inputsToProfile P.outputColor).obj Q)).hom_ext
  intro R
  let i := (rootedSlotTensorCocone (O.toCollection.obj (extendProfile P Q)) O.toCollection B
    ((inputsToProfile P.outputColor).obj Q)).ι.app R
  let f := Linear.Constants.representative (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv) P Q
  let g := constantInputSubstitution O B P Q
  have h : (i ≫ e.hom) ≫ f = (i ≫ e.hom) ≫ g :=
    (rootedRepresentative_original O B P Q R).trans (constantInputSubstitution_β O B P Q R).symm
  exact originalRootedCofanAssociativity i e.hom f g h

/-- The full original coefficient colimit identifies every genuine
operadic constant-input face with its literal original action map. -/
theorem collectionMap_original (O : ColoredOperadObj W C) (B : W → C) :
    collectionMap O B = Variable.constantInputActionMap O B := by
  ext P
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  exact (Linear.Constants.extension_β (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv) P Q).trans
      ((representative_original O B P Q).trans (constantInputAction_β O B P Q).symm)

end ConstantActionExtension

/-- The genuine full operad face has precisely the original full
symmetric collection map of weighted constant-input substitutions. -/
theorem constantInputOperadMap_collection_original (O : ColoredOperadObj W C) (B : W → C) :
    (constantInputOperadMap O B).toCollectionHom = Variable.constantInputActionMap O B :=
  (constantInputOperadMap_collection O B).trans (ConstantActionExtension.collectionMap_original O B)

/-- Every genuine full operadic face entry is exactly its actual
original weighted constant-input action on that original profile. -/
theorem constantInputOperadMap_app_original (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) :
    (constantInputOperadMap O B).toCollectionHom.app P = constantInputAction O B P :=
  congrArg (fun f => f.app P) (constantInputOperadMap_collection_original O B)

/-- The original weighted constant-input symmetric collection
map is a full genuine operad map, with its laws derived from the
actual original free-input constants extension construction. -/
def constantRelationOperadFace (O : ColoredOperadObj W C) (B : W → C) :
    envelopingLinearOperad O (profileCoinvariants O.toCollection B) ⟶
      envelopingLinearOperad O B where
  toCollectionHom := Variable.constantInputActionMap O B
  map_unit := constantInputAction_preserves_linearUnit O B
  map_subst s := by
    have h := (constantInputOperadMap O B).map_subst s
    rw [constantInputOperadMap_collection_original O B] at h
    exact h

/-- The full operadic relation face retains the literal original action at every profile. -/
theorem constantRelationOperadFace_app (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) : (constantRelationOperadFace O B).toCollectionHom.app P =
      constantInputAction O B P := rfl

/-- The original face is the constructed constants-extension full operad map. -/
theorem constantRelationOperadFace_eq (O : ColoredOperadObj W C) (B : W → C) :
    constantRelationOperadFace O B = constantInputOperadMap O B := by
  apply ColoredOperadObj.Hom.ext
  exact (constantInputOperadMap_collection_original O B).symm

/-- The original generator section and original weighted substitution
face form a full operadic reflexive relation, proved at every original profile. -/
theorem constantRelationOperadGenerator_face (O : ColoredOperadObj W C) (B : W → C) :
    constantRelationOperadGenerator O B ≫ constantRelationOperadFace O B =
      𝟙 (envelopingLinearOperad O B) := by
  apply ColoredOperadObj.Hom.ext
  exact constantRelationOperadGenerator_collection O B

/-- The genuine algebra relation section also sections the original
full operadic substitution face of the original O-algebra. -/
theorem algebraRelationOperadSection_substitution (O : ColoredOperadObj W C) (A : Algebra O) :
    algebraRelationOperadSection O A ≫ constantRelationOperadFace O A.carrier =
      𝟙 (envelopingLinearOperad O A.carrier)
      :=
  constantRelationOperadGenerator_face O A.carrier


end CategoryTheory.Operad.Tensor.Enveloping

end
