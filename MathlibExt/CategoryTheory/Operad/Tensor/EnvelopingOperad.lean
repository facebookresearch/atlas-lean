/-!
# Actual retained tensor-block insertion agrees with the original frozen prefix
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem retainedIsoMapAfter {V : Type*} [Category* V]
    {X A B : V} (e : X ≅ A) (f : X ⟶ B) (g : A ⟶ B)
    (h : f = e.hom ≫ g) : e.inv ≫ f = g := by
  rw [h]
  simp only [Iso.inv_hom_id_assoc]

private theorem retainedFoldSquares {V : Type*} [Category* V]
    {X A B D E F G H Y : V} (p : X ⟶ A) (k : A ⟶ B) (l : B ⟶ Y)
    (a : X ⟶ D) (q : D ⟶ B) (b : D ⟶ E) (j : E ⟶ Y)
    (z : X ⟶ F) (c : F ⟶ G) (w : G ⟶ H) (d : H ⟶ E)
    (hn : p ≫ k = a ≫ q) (hc : b ≫ j = q ≫ l) (hp : a ≫ b = z ≫ c ≫ w ≫ d) :
    p ≫ k ≫ l = z ≫ c ≫ w ≫ d ≫ j := by
  rw [← Category.assoc p k, hn, Category.assoc a q, ← hc, ← Category.assoc a b, hp]
  simp only [Category.assoc]

private theorem retainedMapTwo {V : Type*} [Category* V] {D : Type*} [Category* D] (T : V ⥤ D)
    {X Y Z : V} (a : X ⟶ Y) (b : Y ⟶ Z) (f : X ⟶ Z) (h : a ≫ b = f) :
    T.map a ≫ T.map b = T.map f := (T.map_comp _ _).symm.trans (congrArg T.map h)

private theorem retainedReindexInverse {V : Type*} [Category* V]
    {X A B : V} (e : A ≅ B) (x : X ⟶ A) (y : X ⟶ B)
    (h : x ≫ e.hom = y) : x = y ≫ e.inv := by
  apply (cancel_mono e.hom).1
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact h

private theorem retainedTensorRouteFold {V : Type*} [Category* V]
    {X A B D E F G H P Y : V}
    (z : X ⟶ A) (c : A ⟶ B) (w : B ⟶ D) (d : D ⟶ E) (j : E ⟶ Y)
    (q : D ⟶ F) (a : F ⟶ G) (b : G ⟶ Y) (r : B ⟶ H) (f : H ⟶ F)
    (n : A ⟶ P) (aN : P ⟶ H) (k : H ⟶ Y)
    (hd : d ≫ j = q ≫ a ≫ b) (hw : w ≫ q = r ≫ f) (hr : c ≫ r = n ≫ aN)
    (hk : k = f ≫ a ≫ b) : z ≫ c ≫ w ≫ d ≫ j = (z ≫ n) ≫ (aN ≫ k) := by
  rw [hd, ← Category.assoc w q, hw]
  simp only [Category.assoc]
  rw [← Category.assoc c r, hr, ← hk, Category.assoc]

private theorem retainedTripleCancel {V : Type*} [Category* V]
    {X A B Y : V} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ X) (f : X ⟶ Y)
    (h : a ≫ b ≫ c = 𝟙 X) : a ≫ ((b ≫ c) ≫ f) = f := by
  rw [← Category.assoc a (b ≫ c), h, Category.id_comp]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The actual retained-block unit insertion equals flattening
the original retained coefficient blocks and inserting exactly
the original frozen tensor-unit factors. -/
theorem emptyAndRetainedInsertion_eq (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    emptyAndRetainedInsertion I N =
      (FiniteTensor.flattenIso (V := C)).hom.app N ≫
        (frozenVariableTensorUnitIso I ((FiniteFamily.map (FiniteTensor.tensor (V :=
          C))).obj N)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let M := emptyAndRetainedTriple I N
  let K := emptyAndRetainedBlocks I N
  let A := (FiniteFamily.map F).obj M
  let B := (FiniteFamily.flatten (C := FiniteFamily C)).obj M
  let V := (FiniteFamily.map (FiniteFamily.map T)).obj M
  let U := frozenVariableBlocks I ((FiniteFamily.map T).obj N)
  let n := emptyAndRetainedTripleMap I N
  let r := emptyAndRetainedTripleFlattenIso I N
  let e := emptyAndRetainedFlattenIso I N
  let t := emptyAndRetainedTensorTripleIso I N
  let f := frozenVariableFlattenIso I ((FiniteFamily.map T).obj N)
  let p := T.map (F.map n)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app A
  let b := T.map ((FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app M)
  let z := T.map (FiniteFamily.flattenAssocIso.hom.app M)
  let c := (FiniteTensor.flattenIso (V := C)).hom.app B
  let w := T.map ((FiniteFamily.flattenMapIso T).hom.app M)
  let d := (FiniteTensor.flattenIso (V := C)).hom.app V
  let j := T.map (emptyAndRetainedTripleTensorMap I N)
  let q := T.map ((FiniteFamily.map T).map n)
  let k := (FiniteTensor.flattenIso (V := C)).hom.app K
  let l := T.map (emptyAndRetainedTensorIso I N).hom
  have hpent : a ≫ b = z ≫ c ≫ w ≫ d := FiniteTensor.flattenAssocLaw_app_unfold M
  have hn : p ≫ k = a ≫ q := (FiniteTensor.flattenIso (V := C)).hom.naturality n
  have hcomp : b ≫ j = q ≫ l := (T.map_comp _ _).symm.trans
    ((congrArg T.map (emptyAndRetainedTriple_tensor I N)).trans (T.map_comp _ _))
  have hraw : p ≫ k ≫ l = z ≫ c ≫ w ≫ d ≫ j :=
    retainedFoldSquares p k l a q b j z c w d hn hcomp hpent
  have hflat := emptyAndRetainedTriple_flatten I N
  have ht := emptyAndRetainedTensorTriple_flatten I N
  have hmap := emptyAndRetainedTensorTriple_tensor I N
  have hr := (FiniteTensor.flattenIso (V := C)).hom.naturality r.hom
  have htn := (FiniteTensor.flattenIso (V := C)).hom.naturality t.hom
  let nIso : A ≅ K :=
    FiniteFamily.isoOfComponents (Equiv.refl (I ⊕ N.index)) (fun i => match i with
      | Sum.inl _ => flattenEmptyFamilyIso (C := C)
      | Sum.inr i => FiniteFamily.singletonFlattenIso.app (N.obj i))
  let E := (FiniteFamily.flatten (C := C)).mapIso nIso ≪≫ e
  have hnIso : nIso.hom = n := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i <;> exact HEq.rfl
  have hE : E.hom = F.map n ≫ e.hom :=
    congrArg (fun f => F.map f ≫ e.hom) hnIso
  have hE' : E.hom = FiniteFamily.flattenAssocIso.hom.app M ≫ F.map r.hom := hE.trans hflat
  let ET := T.mapIso E
  have he : T.map E.inv ≫ p = T.map e.inv := by
    have h0 : E.inv ≫ F.map n = e.inv := by
      apply (cancel_mono e.hom).1
      rw [Category.assoc, ← hE, E.inv_hom_id, e.inv_hom_id]
    exact retainedMapTwo T _ _ _ h0
  have heR : T.map E.inv ≫ z ≫ T.map (F.map r.hom) = 𝟙 (T.obj (F.obj N)) := by
    have h0 : E.inv ≫ FiniteFamily.flattenAssocIso.hom.app M ≫ F.map r.hom = 𝟙 (F.obj N) := by
      exact (congrArg (E.inv ≫ ·) hE'.symm).trans E.inv_hom_id
    exact (congrArg (T.map E.inv ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans ((congrArg T.map h0).trans (T.map_id _)))
  have hf : (FiniteFamily.flattenMapIso T).hom.app M ≫ F.map t.hom =
      (FiniteFamily.map T).map r.hom ≫ f.inv :=
    retainedReindexInverse f ((FiniteFamily.flattenMapIso T).hom.app M ≫ F.map t.hom)
      ((FiniteFamily.map T).map r.hom) (Category.assoc _ _ _ |>.trans ht)
  have hfT : w ≫ T.map (F.map t.hom) = T.map ((FiniteFamily.map T).map r.hom) ≫ T.map f.inv :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hf).trans (T.map_comp _ _))
  have hj : T.map ((FiniteFamily.map T).map t.hom) ≫ T.map (frozenVariableBlockIso I
    ((FiniteFamily.map T).obj N)).hom =
    j :=
    retainedMapTwo T _ _ _ hmap
  have hdt : d ≫ j = T.map (F.map t.hom) ≫ (FiniteTensor.flattenIso (V := C)).hom.app U ≫
      T.map (frozenVariableBlockIso I ((FiniteFamily.map T).obj N)).hom := by
    exact (congrArg (d ≫ ·) hj.symm).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ T.map (frozenVariableBlockIso I ((FiniteFamily.map T).obj
          N)).hom) htn.symm).trans
          (Category.assoc _ _ _)))
  have hright : z ≫ c ≫ w ≫ d ≫ j = (z ≫ T.map (F.map r.hom)) ≫
      ((FiniteTensor.flattenIso (V := C)).hom.app N ≫
        (frozenVariableTensorUnitIso I ((FiniteFamily.map T).obj N)).hom) := by
