/-!
# Original added-input maps preserve linear-algebra representative evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem originalInverseSquare {V : Type*} [Category* V]
    {A A' B B' : V} (e : A ≅ B) (e' : A' ≅ B') (f : A ⟶ A') (g : B ⟶ B')
    (h : f ≫ e'.hom = e.hom ≫ g) : g ≫ e'.inv = e.inv ≫ f := by
  apply (cancel_epi e.hom).1
  calc
    e.hom ≫ (g ≫ e'.inv) = (e.hom ≫ g) ≫ e'.inv := (Category.assoc _ _ _).symm
    _ = (f ≫ e'.hom) ≫ e'.inv := congrArg (· ≫ e'.inv) h.symm
    _ = f := by simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
    _ = e.hom ≫ (e.inv ≫ f) := by simp only [Iso.hom_inv_id_assoc]

private theorem originalEvaluationThreeSquares {V : Type*} [Category* V]
    {X X' A A' B B' Y : V} (l : X ⟶ X') (p : X ⟶ A) (p' : X' ⟶ A') (f : A ⟶ A')
    (q : A ⟶ B) (q' : A' ⟶ B') (g : B ⟶ B') (r : B ⟶ Y) (r' : B' ⟶ Y)
    (h1 : l ≫ p' = p ≫ f) (h2 : f ≫ q' = q ≫ g) (h3 : g ≫ r' = r) :
    l ≫ p' ≫ q' ≫ r' = p ≫ q ≫ r := by
  rw [← Category.assoc l p', h1]
  simp only [Category.assoc]
  rw [← Category.assoc f q', h2]
  simp only [Category.assoc]
  rw [h3]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- Every original added-input permutation/color transport
commutes with the original constant-input map and variable inputs. -/
theorem representativeFactors_naturality (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) (P : ColoredProfile W) {Q Q' : ColoredInputs W} (f : Q ⟶ Q') :
    (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap
          ((coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).map f)
          (𝟙 (profileLeafFamily M P))) ≫ representativeFactors O B M g P Q' =
      representativeFactors O B M g P Q ≫
        (analyticFactors O M).map (extendProfileMap (𝟙 P) f) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j with
      | none =>
        let h := O.map (extendProfileMap (𝟙 P) f)
        change HEq (h ≫ 𝟙 _) (𝟙 _ ≫ h)
        exact heq_of_eq ((Category.comp_id h).trans (Category.id_comp h).symm)
      | some j =>
        change HEq
          ((Discrete.functor B).map (f.hom j) ≫ g (Q'.obj (f.equiv j)).as)
          (g (Q.obj j).as ≫ (Discrete.functor M).map (f.hom j))
        let alpha : Discrete.functor B ⟶ Discrete.functor M :=
          Discrete.natTrans (fun w : Discrete W => g w.as)
        exact heq_of_eq (alpha.naturality (f.hom j))
    | some i =>
      cases j
      let X := M (P.inputColor i)
      change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
      rfl

/-- The actual original inverse tensor normalizer preserves each
original coefficient map and the unchanged variable-input family. -/
theorem inverseNormalization_naturality {K K' L : FiniteFamily C} (k : K ⟶ K') :
    (coefficientLeafTensorFunctor L).map ((FiniteTensor.tensor (V := C)).map k) ≫
        (coefficientLeavesNormalizationIso K' L).inv =
      (coefficientLeavesNormalizationIso K L).inv ≫
        (FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap k (𝟙 L))) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let f := T.map (F.map (coefficientLeavesNestedMap k (𝟙 L)))
  let g := (coefficientLeafTensorFunctor L).map (T.map k)
  let e := coefficientLeavesNormalizationIso K L
  let e' := coefficientLeavesNormalizationIso K' L
  have h0 : f ≫ coefficientLeavesNormalization K' L =
      coefficientLeavesNormalization K L ≫ T.map (coefficientLeafMap (T.map k) (𝟙 L)) :=
    coefficientLeavesNormalization_naturality k (𝟙 L)
  have hg : T.map (coefficientLeafMap (T.map k) (𝟙 L)) = g :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map k) L)
  have h : f ≫ e'.hom = e.hom ≫ g :=
    (congrArg (f ≫ ·) (coefficientLeavesNormalizationIso_hom K' L)).trans
      (h0.trans ((congrArg (coefficientLeavesNormalization K L ≫ ·) hg).trans
        (congrArg (· ≫ g) (coefficientLeavesNormalizationIso_hom K L)).symm))
  exact originalInverseSquare e e' f g h

/-- Original added-input maps commute with the complete actual
representative evaluation in M, by the original O-algebra
equivariance and the actual coefficient/input tensor maps. -/
theorem representativeEvaluation_naturality (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (f : Q ⟶ Q') :
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
        ((linearCoefficientDiagram O.toCollection B P).map f) ≫
        representativeEvaluation O B M g P Q' = representativeEvaluation O B M g P Q := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let L := profileLeafFamily M.carrier P
  let K := (coefficientInputFactors (extendedCoefficient O.toCollection P)
    (addedAlgebraInputs B)).obj Q
  let K' := (coefficientInputFactors (extendedCoefficient O.toCollection P)
    (addedAlgebraInputs B)).obj Q'
  let k := (coefficientInputFactors (extendedCoefficient O.toCollection P)
    (addedAlgebraInputs B)).map f
  let l := (coefficientLeafTensorFunctor L).map (T.map k)
  let p := (coefficientLeavesNormalizationIso K L).inv
  let p' := (coefficientLeavesNormalizationIso K' L).inv
  let a := T.map (F.map (coefficientLeavesNestedMap k (𝟙 L)))
  let q := T.map (representativeFactors O.toCollection B M.carrier g P Q)
  let q' := T.map (representativeFactors O.toCollection B M.carrier g P Q')
  let b := (analyticSummand (d := P.outputColor) O.toCollection M.carrier).map
    (show profileInputs (extendProfile P Q) ⟶ profileInputs (extendProfile P Q') from
      extendProfileMap (𝟙 P) f)
  let r := M.operations.app P.outputColor (profileInputs (extendProfile P Q))
  let r' := M.operations.app P.outputColor (profileInputs (extendProfile P Q'))
  have h1 : l ≫ p' = p ≫ a := inverseNormalization_naturality k
  have h2 : a ≫ q' = q ≫ b := (T.map_comp _ _).symm.trans
    ((congrArg T.map (representativeFactors_naturality O.toCollection B M.carrier g P f)).trans
      (T.map_comp _ _))
  have h3 : b ≫ r' = r := M.operations.equivariance P.outputColor
    (show profileInputs (extendProfile P Q) ⟶ profileInputs (extendProfile P Q') from
      extendProfileMap (𝟙 P) f)
  exact originalEvaluationThreeSquares l p p' a q q' b r r' h1 h2 h3


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

