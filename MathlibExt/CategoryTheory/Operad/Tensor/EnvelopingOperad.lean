def substitution : ColoredOperadSubstitution (collection f g) where
  app := substitutionApp f g t hf hg
  naturality _s _r k := substitution_naturality f g t hf hg k

@[reassoc]
theorem projection_map_subst (s : ColoredSubstitutionData W) :
