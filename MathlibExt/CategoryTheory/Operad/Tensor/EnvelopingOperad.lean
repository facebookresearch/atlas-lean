section EnvelopingSource086


/-!
# Original root-first coefficient operations after actual block unit insertion
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem rootFirstAppliedPostcompose {V : Type*} [Category* V]
    {X A B D E F Y : V} (u : X ⟶ A) (e : A ⟶ B) (m : B ⟶ D) (s : D ⟶ E) (t : E ⟶ F)
    (f : F ⟶ Y) (a : X ⟶ F) (h : u ≫ e ≫ m ≫ s ≫ t = a) :
    (u ≫ e) ≫ (m ≫ s ≫ t ≫ f) = a ≫ f := by
  have ha : (u ≫ e) ≫ (m ≫ s ≫ t ≫ f) = (u ≫ e ≫ m ≫ s ≫ t) ≫ f := by
    simp only [Category.assoc]
  exact ha.trans (congrArg (· ≫ f) h)

private theorem rootFirstAppliedIdentityCoefficient {V : Type*} [Category* V]
    {X A B Y : V} (u : X ⟶ A) (e : A ⟶ X) (f : X ⟶ B) (g : B ⟶ Y)
    (h : u ≫ e = 𝟙 X) : (u ≫ e) ≫ (f ≫ 𝟙 B ≫ g) = f ≫ g := by
  rw [h, Category.id_comp, Category.id_comp]

private theorem rootFirstAppliedSingletonPrefix {V : Type*} [Category* V]
    {X A B D Y : V} (u : X ⟶ A) (e : A ⟶ B) (s : B ≅ X) (f : X ⟶ D) (g : D ⟶ Y)
    (h : u ≫ e = s.inv) : (u ≫ e) ≫ (s.hom ≫ f ≫ g) = f ≫ g := by
  rw [h]
  simp only [Iso.inv_hom_id_assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original blockwise root-first coefficient route
contracts the original middle coefficients and retains all original
innermost coefficient/unit singleton maps and original profile maps. -/
def envelopingAssocRootFirstAppliedContraction (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
      (envelopingAssocRootFirstRetainedBlocks O.toCollection d Q) ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj
        (envelopingRepresentativeSubstitution d.innerData (envelopingAssocInnerChoices d Q)) where
  equiv := Equiv.optionCongr (envelopingAssocFlatInnerEquiv d Q)
  hom i := match i with
    | none => envelopingAssocMiddleCoefficientSubstitution O d Q ≫
        O.toCollection.map (envelopingRepresentativeOuterHom d.innerData
          (envelopingAssocInnerChoices d Q))
    | some ⟨Sum.inl i, Sum.inl j⟩ => (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile ((d.localData i).inner.obj j) (Q.branch i (some j)))) ≫
        O.toCollection.map ((envelopingAssocFlatInnerFamilyMap d Q).hom ⟨Sum.inl i, Sum.inl j⟩)
    | some ⟨Sum.inl i, Sum.inr j⟩ => O.unit ((Q.branch i none).obj j).as ≫
        O.toCollection.map ((envelopingAssocFlatInnerFamilyMap d Q).hom ⟨Sum.inl i, Sum.inr j⟩)
