section EnvelopingSource078


/-!
# Actual triple-family comparison for retained tensor blocks and empty unit positions
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- Flattening the actual empty nested family is the original empty family. -/
def flattenEmptyFamilyIso :
    (FiniteFamily.flatten (C := C)).obj (FiniteFamily.empty : FiniteFamily (FiniteFamily C)) ≅
      (FiniteFamily.empty : FiniteFamily C) :=
  FiniteFamily.isoOfComponents
    { toFun p := p.1.elim
      invFun p := p.elim
      left_inv p := p.1.elim
      right_inv p := p.elim } (fun p => p.1.elim)

/-- Mapping a functor over the actual empty finite family is
the original empty family with its original empty input bijection. -/
def mapEmptyFamilyIso {D : Type*} [Category* D] (F : C ⥤ D) :
    (FiniteFamily.map F).obj (FiniteFamily.empty : FiniteFamily C) ≅ (FiniteFamily.empty :
      FiniteFamily D) :=
  FiniteFamily.isoOfComponents (Equiv.refl Empty) (fun i => i.elim)

/-- Every original unit position is an empty outer block;
every retained nested block is an actual singleton of its original block. -/
def emptyAndRetainedTriple (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    FiniteFamily (FiniteFamily (FiniteFamily C)) where
  index := FintypeCat.of (I ⊕ N.index)
  obj p := match p with
    | Sum.inl _ => FiniteFamily.empty
    | Sum.inr i => (FiniteFamily.singleton (C := FiniteFamily C)).obj (N.obj i)

/-- The actual map-flatten triple compares with the original
empty/retained block family through the original singleton-flatten maps. -/
def emptyAndRetainedTripleMap (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (emptyAndRetainedTriple I N) ⟶
      emptyAndRetainedBlocks I N where
  equiv := Equiv.refl (I ⊕ N.index)
  hom p := match p with
    | Sum.inl _ => (flattenEmptyFamilyIso (C := C)).hom
    | Sum.inr i => FiniteFamily.singletonFlattenIso.hom.app (N.obj i)

/-- Actual flattening of the triple removes only the original
empty unit blocks and keeps every original retained nested block. -/
def emptyAndRetainedTripleFlattenIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flatten (C := FiniteFamily C)).obj (emptyAndRetainedTriple I N) ≅ N :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨Sum.inl _, j⟩ => j.elim
        | ⟨Sum.inr i, _⟩ => i
      invFun i := ⟨Sum.inr i, PUnit.unit⟩
      left_inv p := by rcases p with ⟨i, j⟩; cases i with
        | inl i => exact j.elim
        | inr i => cases j; rfl
      right_inv _ := rfl }
    (fun p => match p with
      | ⟨Sum.inl _, j⟩ => j.elim
      | ⟨Sum.inr _, _⟩ => Iso.refl _)

/-- The actual original flatten/reindex routes retain the same
original coefficient position after both empty-block removals. -/
theorem emptyAndRetainedTriple_flatten (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flatten (C := C)).map (emptyAndRetainedTripleMap I N) ≫
        (emptyAndRetainedFlattenIso I N).hom =
      FiniteFamily.flattenAssocIso.hom.app (emptyAndRetainedTriple I N) ≫
        (FiniteFamily.flatten (C := C)).map (emptyAndRetainedTripleFlattenIso I N).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, ⟨j, k⟩⟩
    cases i with
    | inl i => exact j.elim
    | inr i => cases j; rfl
  · intro p
    rcases p with ⟨i, ⟨j, k⟩⟩
    cases i with
    | inl i => exact j.elim
    | inr i =>
      cases j
      change HEq (𝟙 _ ≫ 𝟙 _) (𝟙 _ ≫ 𝟙 _)
      exact HEq.rfl

variable [FiniteTensor C]

/-- The actual original triple tensor collapse retains all
original empty unit blocks and every original tensor of retained block. -/
def emptyAndRetainedTripleTensorMap (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
      ((FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V :=
        C)))).obj (emptyAndRetainedTriple I N)) ⟶
        frozenVariableUnitFamily I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N) where
  equiv := Equiv.refl (I ⊕ N.index)
  hom p := match p with
    | Sum.inl _ => (FiniteTensor.tensor (V := C)).map
        (mapEmptyFamilyIso (FiniteTensor.tensor (V := C))).hom
    | Sum.inr i => (FiniteTensor.singletonIso (V := C)).hom.app ((FiniteTensor.tensor (V :=
      C)).obj (N.obj i))


end CategoryTheory.Operad.Tensor.Enveloping

end
