/-!
# Genuine original O and constant maps of the two original operadic algebra-relation restrictions
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraRelation

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original O restriction of a genuine restricted linear
algebra is restriction along the actual original full O inclusion composite. -/
theorem linearUnderlying_restrict (O : ColoredOperadObj W C) (B : W → C) {E : ColoredOperadObj W C}
    (h : envelopingLinearOperad O B ⟶ E) (M : Algebra E) :
    linearAlgebraUnderlying O B (Algebra.restrict h M) =
      Algebra.restrict (originalOperationToLinearOperadMap O B ≫ h) M :=
  restriction_comp (originalOperationToLinearOperadMap O B) h M

/-- The actual original constants of a genuine restricted linear
algebra retain exactly the original generator, full coefficient map and M nullary operation. -/
theorem linearConstants_restrict (O : ColoredOperadObj W C) (B : W → C) {E : ColoredOperadObj W C}
    (h : envelopingLinearOperad O B ⟶ E) (M : Algebra E) :
    linearAlgebraConstants O B (Algebra.restrict h M) =
      (fun d => linearConstantGenerator O B d ≫ h.toCollectionHom.app (ColoredProfile.nullary d) ≫
        FrozenAlgebra.nullaryEvaluation M d) := by
  funext d
  exact congrArg (linearConstantGenerator O B d ≫ ·) (restriction_nullaryEvaluation h M d)

/-- The genuine O restriction along the constructed constants extension
is precisely the original restriction along the original u, as a whole algebra. -/
theorem linearUnderlying_constantsExtension {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ d, B d ⟶ E.toCollection.obj (ColoredProfile.nullary d)) (M : Algebra E) :
    linearAlgebraUnderlying O B (Algebra.restrict (Linear.Constants.operadMap u B b) M) =
      Algebra.restrict u M :=
  (linearUnderlying_restrict O B (Linear.Constants.operadMap u B b) M).trans
    (congrArg (fun h : O ⟶ E => Algebra.restrict h M) (Linear.Constants.operadMap_original u B b))

/-- The actual original constants of the genuine constants extension
restriction are the literal supplied b evaluated by the original M nullary operation. -/
theorem linearConstants_constantsExtension {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ d, B d ⟶ E.toCollection.obj (ColoredProfile.nullary d)) (M : Algebra E) :
    linearAlgebraConstants O B (Algebra.restrict (Linear.Constants.operadMap u B b) M) =
      (fun d => b d ≫ FrozenAlgebra.nullaryEvaluation M d) := by
  funext d
  have h := congrFun (linearConstants_restrict O B (Linear.Constants.operadMap u B b) M) d
  exact h.trans ((Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ FrozenAlgebra.nullaryEvaluation M d)
      (Linear.Constants.operadMap_generator u B b d)))

/-- A genuine full original linear carrier map preserves the original
O restriction as a whole algebra, because it preserves the full original O inclusion. -/
theorem linearUnderlying_carrier (O : ColoredOperadObj W C) {B B' : W → C} (f : B ⟶ B')
    (M : Algebra (envelopingLinearOperad O B')) :
    linearAlgebraUnderlying O B (Algebra.restrict (linearCarrierOperadMap O f) M) =
      linearAlgebraUnderlying O B' M :=
  (linearUnderlying_restrict O B (linearCarrierOperadMap O f) M).trans
    (congrArg (fun h : O ⟶ envelopingLinearOperad O B' => Algebra.restrict h M)
      (originalOperationToLinearOperadMap_carrier O f))

/-- The genuine full linear carrier restriction retains exactly the
original carrier arrow before the actual original reconstructed constant map. -/
theorem linearConstants_carrier (O : ColoredOperadObj W C) {B B' : W → C} (f : B ⟶ B')
    (M : Algebra (envelopingLinearOperad O B')) :
    linearAlgebraConstants O B (Algebra.restrict (linearCarrierOperadMap O f) M) = f ≫
      linearAlgebraConstants O B' M
      := by
  funext d
  have h := congrFun (linearConstants_restrict O B (linearCarrierOperadMap O f) M) d
  exact h.trans ((Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ FrozenAlgebra.nullaryEvaluation M d)
      (Linear.Constants.linearConstantGenerator_operadMap_carrier O f
      d)).trans
      (Category.assoc _ _ _)))

/-- The original substitution relation face has precisely its actual
constructed full constants-extension map with the original nullary-linear comparison inverse. -/
theorem substitutionFace_constantsMap (O : ColoredOperadObj W C) (B : W → C) :
    constantRelationOperadFace O B =
      Linear.Constants.operadMap (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection B)
        (fun d => (nullaryLinearCoefficientIso O.toCollection B d).inv) :=
          constantRelationOperadFace_eq O B

/-- The actual original substitution-face O restriction is the actual
original reconstructed O algebra, with exact whole carrier and operations. -/
theorem substitutionRestriction_underlying (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) :
    linearAlgebraUnderlying O (profileCoinvariants O.toCollection B) (Algebra.restrict
      (constantRelationOperadFace O B)
      M) =
      linearAlgebraUnderlying O B M :=
  (congrArg (fun h => linearAlgebraUnderlying O (profileCoinvariants O.toCollection B)
    (Algebra.restrict h M))
    (substitutionFace_constantsMap O B)).trans
      (linearUnderlying_constantsExtension (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection
        B)
        (fun d => (nullaryLinearCoefficientIso O.toCollection B d).inv) M)

/-- Actual original substitution-face constants are the original O
action on the actual original computed constants, derived from original nullary cofams. -/
theorem substitutionRestriction_constants (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) :
    linearAlgebraConstants O (profileCoinvariants O.toCollection B) (Algebra.restrict
      (constantRelationOperadFace O B)
      M) =
      profileMap O.toCollection (linearAlgebraConstants O B M) ≫
        (linearAlgebraUnderlying O B M).action := by
  let L := envelopingLinearOperad O B
  let TB := profileCoinvariants O.toCollection B
  let u := originalOperationToLinearOperadMap O B
  let b : ∀ d, TB d ⟶ L.toCollection.obj (ColoredProfile.nullary d) :=
    fun d => (nullaryLinearCoefficientIso O.toCollection B d).inv
  let f : envelopingLinearOperad O TB ⟶ L := Linear.Constants.operadMap u TB b
  have hf : constantRelationOperadFace O B = f := substitutionFace_constantsMap O B
  funext d
  let gen := linearConstantGenerator O TB d
  let sigma := (constantRelationOperadFace O B).toCollectionHom.app (ColoredProfile.nullary d)
  let delta := FrozenAlgebra.nullaryEvaluation M d
  have hg : gen ≫ sigma = b d :=
    (congrArg (fun h : envelopingLinearOperad O TB ⟶ L =>
      gen ≫ h.toCollectionHom.app (ColoredProfile.nullary d)) hf).trans
        (Linear.Constants.operadMap_generator u TB b d)
  have hr := congrFun (linearConstants_restrict O TB (constantRelationOperadFace O B) M) d
  exact hr.trans ((Category.assoc gen sigma delta).symm.trans
    ((congrArg (· ≫ delta) hg).trans (linearAlgebra_nullary_action O B M d)))

/-- The actual original algebra-action face gives the same whole
original O restriction, using the original full carrier operad map of A.action. -/
theorem actionRestriction_underlying (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingLinearOperad O A.carrier)) :
    linearAlgebraUnderlying O (profileCoinvariants O.toCollection A.carrier) (Algebra.restrict
      (algebraRelationOperadFace O A) M) =
      linearAlgebraUnderlying O A.carrier M := linearUnderlying_carrier O A.action M

/-- The original action-face constants retain A.action followed by
the original computed constant map, as the actual whole carrier arrow. -/
theorem actionRestriction_constants (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingLinearOperad O A.carrier)) :
    linearAlgebraConstants O (profileCoinvariants O.toCollection A.carrier)
      (Algebra.restrict (algebraRelationOperadFace
      O A) M) =
      A.action ≫ linearAlgebraConstants O A.carrier M := linearConstants_carrier O A.action M


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraRelation

end
