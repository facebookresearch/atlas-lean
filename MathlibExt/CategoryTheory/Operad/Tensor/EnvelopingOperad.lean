/- Exact checked source: WeightedNormalization.ConstantRootRouteB. -/
section EnvelopingSource261


/-!
# Actual original root contraction followed by variable substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

private theorem partialReadbackAssoc {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (s : B ⟶ C) (t : C ⟶ E) (r : E ⟶ F) (h : C ⟶ F)
    (hh : t ≫ r = h) : (a ≫ s ≫ t) ≫ r = a ≫ s ≫ h := by
  exact (show (a ≫ s ≫ t) ≫ r = a ≫ s ≫ (t ≫ r) by simp only [Category.assoc]).trans
    (congrArg (a ≫ s ≫ ·) hh)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The literal original nullary partial operation retains its complete original
total-profile map. -/
theorem nullaryPartial_normalized (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    frozenPartialSubstitution E P Q (branches Q) ≫ E.toCollection.map (totalProfileHom P Q) =
      frozenSubstitutionCoefficientTensorMap E P Q (branches Q) ≫
        E.subst.app (frozenSubstitution P Q (branches Q)) ≫
        E.toCollection.map (substitutionTotalHom P Q) :=
  partialReadbackAssoc _ _ _ _ _ (E.toCollection.map_comp _ _).symm

namespace Root

private theorem rootBCoefficientFiring {D : Type*} [Category* D] {A B C E F G H : D}
    (p : A ⟶ B) (u : B ⟶ C) (f : C ⟶ E) (i : E ⟶ E) (b : E ⟶ F) (c : F ⟶ G)
    (s : C ⟶ H) (q : H ⟶ F) (h : H ⟶ G)
    (hi : i = 𝟙 E) (hf : f ≫ b = s ≫ q) (hq : q ≫ c = h) :
    (p ≫ (u ≫ f)) ≫ i ≫ b ≫ c = p ≫ u ≫ s ≫ h := by
  calc
    (p ≫ (u ≫ f)) ≫ i ≫ b ≫ c = p ≫ u ≫ f ≫ (i ≫ b) ≫ c := by simp only [Category.assoc]
    _ = p ≫ u ≫ f ≫ b ≫ c := by rw [hi, Category.id_comp]
    _ = p ≫ u ≫ (f ≫ b) ≫ c := by simp only [Category.assoc]
    _ = p ≫ u ≫ (s ≫ q) ≫ c := congrArg (p ≫ u ≫ · ≫ c) hf
    _ = p ≫ u ≫ s ≫ h := by simpa only [Category.assoc] using congrArg (p ≫ u ≫ s ≫ ·) hq

private theorem mapFourRootB {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) :
    F.map (a ≫ b ≫ c ≫ d) = F.map a ≫ F.map b ≫ F.map c ≫ F.map d := by simp only [Functor.map_comp]

private theorem rootSourceBFiring {D : Type*} [Category* D] {A B C E F G H J K : D}
    (x : A ⟶ B) (p : B ⟶ C) (f : C ⟶ E) (g : E ⟶ F) (h : F ⟶ G)
    (a : A ⟶ H) (n : H ⟶ J) (l : J ⟶ K) (m : K ⟶ E) (r : J ⟶ G)
    (hd : x ≫ p ≫ f = a ≫ n ≫ l ≫ m) (hl : l ≫ m ≫ g ≫ h = r) :
    x ≫ p ≫ f ≫ g ≫ h = a ≫ n ≫ r := by
  calc
    x ≫ p ≫ f ≫ g ≫ h = (x ≫ p ≫ f) ≫ g ≫ h := by simp only [Category.assoc]
    _ = (a ≫ n ≫ l ≫ m) ≫ g ≫ h := congrArg (· ≫ g ≫ h) hd
    _ = a ≫ n ≫ (l ≫ m ≫ g ≫ h) := by simp only [Category.assoc]
    _ = a ≫ n ≫ r := congrArg (a ≫ n ≫ ·) hl

private theorem rootBRouteFiring {D : Type*} [Category* D] {A B C E F G H J K : D}
    (x : A ⟶ B) (p : B ⟶ C) (f : C ⟶ E) (g : E ⟶ F) (s : F ⟶ G)
    (t : G ⟶ H) (r : H ⟶ J) (q : G ⟶ J) (h : F ⟶ K) (s' : K ⟶ J) (z : A ⟶ K)
    (ht : t ≫ r = q) (hs : s ≫ q = h ≫ s') (hz : x ≫ p ≫ f ≫ g ≫ h = z) :
    x ≫ (p ≫ f ≫ g ≫ s ≫ t) ≫ r = z ≫ s' := by
  calc
    x ≫ (p ≫ f ≫ g ≫ s ≫ t) ≫ r = x ≫ p ≫ f ≫ g ≫ s ≫ (t ≫ r) := by simp only [Category.assoc]
    _ = x ≫ p ≫ f ≫ g ≫ s ≫ q := congrArg (x ≫ p ≫ f ≫ g ≫ s ≫ ·) ht
    _ = x ≫ p ≫ f ≫ g ≫ (h ≫ s') := congrArg (x ≫ p ≫ f ≫ g ≫ ·) hs
    _ = (x ≫ p ≫ f ≫ g ≫ h) ≫ s' := by simp only [Category.assoc]
    _ = z ≫ s' := congrArg (· ≫ s') hz

private theorem ungroupThreeRootB {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ c ≫ d := by simp only [Category.assoc]

/-- Original substitution naturality identifies the root-first applied
coefficient maps with the literal root nullary partial operation and retained variable
operations. -/
theorem appliedMapB_collapse (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    appliedMapB E s Q ≫ (FiniteFamily.map (FiniteTensor.tensor (V :=
      C))).map (groupingIsoB E.toCollection s Q).hom ≫
      ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst (assocData s Q) ≫
        (ColoredOperadObj.substitutionFactors E.toCollection).map (innerCompare s Q) =
          firstFactorMap E s Q := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      let d := assocData s Q
      let R := frozenCoefficientFamily E.toCollection s.outerProfile Q (Constants.branches Q)
      let p := (frozenVariableTensorUnitIso s.inner.index R).hom
      let u := frozenUnitCoefficientMap E s.outerProfile Q (Constants.branches Q)
      let f := (ColoredOperadObj.substitutionFactors E.toCollection).map (middleCompare s Q)
      let i := T.map (𝟙 ((ColoredOperadObj.substitutionFactors E.toCollection).obj d.middleData))
      let b := E.subst.app d.middleData
      let c := E.toCollection.map (ColoredSubstitutionData.outerProfileMap (innerCompare s Q))
      let σ := E.subst.app (frozenSubstitution s.outerProfile Q (Constants.branches Q))
      let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (middleCompare s Q))
      let h := E.toCollection.map (Constants.substitutionTotalHom s.outerProfile Q)
      let r := frozenPartialSubstitution E s.outerProfile Q (Constants.branches Q) ≫
        E.toCollection.map
        (Constants.totalProfileHom s.outerProfile Q)
      have hm : T.map (localUnitMapB E s Q none) = T.map u ≫ T.map f := T.map_comp _ _
      have hi : i = 𝟙 _ := T.map_id _
      have hf : T.map f ≫ b = σ ≫ q := E.subst.naturality (middleCompare s Q)
      have hq : q ≫ c = h := (E.toCollection.map_comp _ _).symm.trans
        (congrArg E.toCollection.map (middleTotal_readback s Q))
      change HEq ((p ≫ T.map (localUnitMapB E s Q none)) ≫ i ≫ b ≫ c) r
      exact heq_of_eq ((congrArg (fun u => (p ≫ u) ≫ i ≫ b ≫ c) hm).trans
        ((rootBCoefficientFiring p (T.map u) (T.map f) i b c σ q h hi hf hq).trans
          ((Category.assoc p (T.map u) (σ ≫ h)).symm.trans
            (Constants.nullaryPartial_normalized E s.outerProfile
            Q).symm)))
    | some i =>
      let P := s.inner.obj i
      let X := E.toCollection.obj P
