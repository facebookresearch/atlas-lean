/-!
# Original operations inject naturally into the actual enveloping coefficients
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The exact empty algebra-input coefficient family comparison
retains the original variable-profile coefficient map. -/
theorem emptyLinearFactorsIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    (coefficientInputFactorsMap (Functor.whiskerRight (fixedProfileExtensionMap f) O)
        (𝟙 (addedAlgebraInputs B))).app emptyColoredInputs ≫ (emptyLinearFactorsIso O B P').hom =
      (emptyLinearFactorsIso O B P).hom ≫
        (coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).map
          (O.map (extendProfileMap f (𝟙 emptyColoredInputs))) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | none => rfl
    | some i => exact i.elim
  · intro i
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap f (𝟙 emptyColoredInputs)) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap f (𝟙 emptyColoredInputs)))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i => exact i.elim

private theorem originalEmptyThreeSquares {V : Type*} [Category* V]
    {X X' Y Y' Z Z' D D' : V} (k : X ⟶ X')
    (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (b : Y ⟶ Z) (b' : Y' ⟶ Z') (g : Z ⟶ Z')
    (c : Z ⟶ D) (c' : Z' ⟶ D') (h : D ⟶ D')
    (ha : k ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) (hc : g ≫ c' = c ≫ h) :
    k ≫ (a' ≫ b' ≫ c') = (a ≫ b ≫ c) ≫ h := by
  rw [← Category.assoc k a', ha, Category.assoc a f, ← Category.assoc f b', hb,
    Category.assoc b g, hc]
  simp only [Category.assoc]

private theorem originalEmptyIsoInverseSquare {V : Type*} [Category* V]
    {X X' Y Y' : V} (e : X ≅ Y) (e' : X' ≅ Y') (f : X ⟶ X') (g : Y ⟶ Y')
    (h : f ≫ e'.hom = e.hom ≫ g) : g ≫ e'.inv = e.inv ≫ f := by
  apply (cancel_mono e'.hom).1
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  rw [h]
  simp only [Iso.inv_hom_id_assoc]

variable [FiniteTensor C]

/-- The actual empty-input tensor comparison respects the
original coefficient-profile map and the original empty-leaf unitor. -/
theorem emptyLinearSummandIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    (linearCoefficientProfileMap O B f).app emptyColoredInputs ≫
      (emptyLinearSummandIso O B P').hom =
      (emptyLinearSummandIso O B P).hom ≫ O.map f := by
  let T := FiniteTensor.tensor (V := C)
  let k := O.map (extendProfileMap f (𝟙 emptyColoredInputs))
  have h1 : (linearCoefficientProfileMap O B f).app emptyColoredInputs ≫
        T.map (emptyLinearFactorsIso O B P').hom =
      T.map (emptyLinearFactorsIso O B P).hom ≫ (coefficientLeafTensorFunctor
        (FiniteFamily.empty : FiniteFamily C)).map
        k :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (emptyLinearFactorsIso_naturality O B f)).trans (T.map_comp _ _))
  have h2 := emptyLeafTensorNatIso.hom.naturality k
  have h3 : k ≫ O.map (emptyExtensionProfileHom P') = O.map (emptyExtensionProfileHom P)
    ≫ O.map f :=
    (O.map_comp _ _).symm.trans ((congrArg O.map (emptyExtensionProfileHom_naturality
      f)).trans (O.map_comp _ _))
  exact originalEmptyThreeSquares _ _ _ _ _ _ _ _ _ _ h1 h2 h3

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Every original operation profile map retains the actual
empty-input inclusion into the complete linear coefficient colimit. -/
theorem originalOperationToLinear_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    O.map f ≫ originalOperationToLinear O B P' = originalOperationToLinear O B P ≫
      linearCoefficientMap O B f := by
  have h := originalEmptyIsoInverseSquare (emptyLinearSummandIso O B P)
    (emptyLinearSummandIso O B P')
    ((linearCoefficientProfileMap O B f).app emptyColoredInputs) (O.map f)
      (emptyLinearSummandIso_naturality O B f)
  change _ ≫ (_ ≫ _) = (_ ≫ _) ≫ _
  rw [← Category.assoc, h, Category.assoc, ← linearCoefficientι_profileMap, Category.assoc]

/-- The original no-added-input operation inclusions are a genuine
full colored symmetric-collection morphism. -/
def originalOperationToLinearMap (O : ColoredSymmetricCollection W C) (B : W → C) :
    O ⟶ linearCoefficientCollection O B where
  app P := originalOperationToLinear O B P
  naturality {_P _P'} f := originalOperationToLinear_naturality O B f

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual no-added-input operation inclusion into the
enveloping quotient is the composite of the two actual collection maps. -/
def originalOperationToEnvelopingMap (O : ColoredOperadObj W C) (A : Algebra O) :
    O.toCollection ⟶ Variable.envelopingCoefficientCollection O A :=
  originalOperationToLinearMap O.toCollection A.carrier ≫
    Variable.envelopingCoefficientProjection O A


end CategoryTheory.Operad.Tensor.Enveloping

end
