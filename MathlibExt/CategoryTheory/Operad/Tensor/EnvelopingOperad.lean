/- Exact checked source: WeightedNormalization.OriginalInclusionEmptyTensorData. -/
section EnvelopingSource247


/-!
# Original tensor input and output corrections for empty representatives
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

open CategoryTheory

private theorem reassociateEmptyTensor {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    a ≫ b ≫ c ≫ d = ((a ≫ b) ≫ c) ≫ d := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Any actual coefficient map commutes with collapse of the original empty leaf tensor. -/
theorem collapseEmptyLeafMap {X Y : C} (f : X ⟶ Y) {L : FiniteFamily C}
    (l : L ⟶ (FiniteFamily.empty : FiniteFamily C)) :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap f l) ≫ (emptyLeafTensorIso Y).hom =
      ((FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 X) l) ≫
        (emptyLeafTensorIso X).hom) ≫ f := by
  let T := FiniteTensor.tensor (V := C)
  let a := coefficientLeafMap (𝟙 X) l
  let b := (coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).map f
  have hab : a ≫ b = coefficientLeafMap f l :=
    (coefficientLeafMap_post (𝟙 X) f l).trans (congrArg (fun f =>
      coefficientLeafMap f l) (Category.id_comp f))
  have hn : T.map b ≫ (emptyLeafTensorIso Y).hom = (emptyLeafTensorIso X).hom ≫ f :=
    emptyLeafTensorNatIso.hom.naturality f
  exact (congrArg (fun g => T.map g ≫ (emptyLeafTensorIso Y).hom) hab.symm).trans
    ((congrArg (· ≫ (emptyLeafTensorIso Y).hom) (T.map_comp a b)).trans
      ((Category.assoc _ _ _).trans ((congrArg (T.map a ≫
        ·) hn).trans (Category.assoc _ _ _).symm)))

variable {W : Type u}

/-- Identify the original substitution factors with the slot coefficients having empty added
inputs. -/
def slotCoefficientIso (O : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) :
    (ColoredOperadObj.substitutionFactors O).obj s ≅
      coefficientBlockFamily (FintypeCat.of (Option s.inner.index))
        (fun i => O.obj (extendProfile (envelopingSlotProfile s i) (choices s i))) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i => match i with
    | none => (O.mapIso (emptyExtensionProfileIso s.outerProfile)).symm
    | some i => (O.mapIso (emptyExtensionProfileIso (s.inner.obj i))).symm)

/-- Identify empty leaf blocks with the algebra-input blocks of the empty slot choices. -/
def slotLeavesIso (B : W → C) (s : ColoredSubstitutionData W) :
    inputBlockFamily (FintypeCat.of (Option s.inner.index)) (fun _ =>
      (FiniteFamily.empty : FiniteFamily C)) ≅
      inputBlockFamily (FintypeCat.of (Option s.inner.index)) (fun i =>
        (addedAlgebraInputs B).obj (choices s i)) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun _ =>
    (emptyAddedAlgebraInputsIso B).symm)

/-- Transport empty weighted blocks to the representative family using the slot coefficient and
leaf isomorphisms. -/
def slotWeightedMap (O : ColoredSymmetricCollection W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    weightedInputBlockFamily (FintypeCat.of (Option s.inner.index))
        ((ColoredOperadObj.substitutionFactors O).obj s).obj (fun _ =>
          (FiniteFamily.empty : FiniteFamily C)) ⟶
      envelopingWeightedRepresentativeFamily O B s (choices s) :=
  weightedInputBlockMap (FintypeCat.of (Option s.inner.index))
    (K := ((ColoredOperadObj.substitutionFactors O).obj s).obj)
    (K' := fun i => O.obj (extendProfile (envelopingSlotProfile s i) (choices s i)))
    (L := fun _ => (FiniteFamily.empty : FiniteFamily C))
    (L' := fun i => (addedAlgebraInputs B).obj (choices s i))
    (slotCoefficientIso O s).hom.hom (slotLeavesIso B s).hom.hom

/-- Insert each original substitution factor into the linear summand with empty added inputs. -/
def sourceInsertion (O : ColoredSymmetricCollection W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    (ColoredOperadObj.substitutionFactors O).obj s ⟶
      envelopingWeightedRepresentativeFamily O B s (choices s) where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := (emptyLinearSummandIso O B (envelopingSlotProfile s i)).inv

omit [FiniteTensor C] in
theorem slotCoefficientIso_compare (O : ColoredSymmetricCollection W C) (s :
  ColoredSubstitutionData W) :
    (slotCoefficientIso O s).hom ≫ (envelopingCoefficientBlockIso O s (choices s)).hom =
      (coefficientIso O s).inv := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let f := O.map (emptyExtensionProfileIso s.outerProfile).inv
      change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)
    | some i =>
      let f := O.map (emptyExtensionProfileIso (s.inner.obj i)).inv
      change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)

omit [FiniteTensor C] in
theorem slotLeavesIso_compare (B : W → C) (s : ColoredSubstitutionData W) :
    (((FiniteFamily.flatten (C := C)).map (slotLeavesIso B s).hom ≫
      (envelopingAlgebraLeafIso B s (choices s)).hom) ≫
      (addedAlgebraInputs B).map (totalInputsIso s).hom) ≫ (emptyAddedAlgebraInputsIso B).hom =
        (emptyTotalLeavesIso (FintypeCat.of (Option s.inner.index))).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    exact p.2.elim
  · intro p
    exact p.2.elim

theorem sourceInsertion_factor (O : ColoredSymmetricCollection W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    emptySlotInputMap ((ColoredOperadObj.substitutionFactors O).obj s) ≫
      slotWeightedMap O B s = sourceInsertion O B s
      := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let P := s.outerProfile
      let X := O.obj P
      let Y := O.obj (extendProfile P emptyColoredInputs)
      let f := O.map (emptyExtensionProfileIso P).inv
      let l := (emptyAddedAlgebraInputsIso B).inv
      let T := FiniteTensor.tensor (V := C)
      have hm : T.map (coefficientLeafMap f l) =
          (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map f ≫
            T.map (coefficientLeafMap (𝟙 Y)
            l) :=
        (congrArg T.map ((coefficientLeafMap_pre f (𝟙 Y) l).trans
          (congrArg (fun g => coefficientLeafMap g l) (Category.comp_id f))).symm).trans
            (T.map_comp _ _)
      have hn : (emptyLeafTensorIso X).inv ≫ (coefficientLeafTensorFunctor
        (FiniteFamily.empty : FiniteFamily C)).map f
        =
          f ≫ (emptyLeafTensorIso Y).inv := (emptyLeafTensorNatIso.inv.naturality f).symm
      exact heq_of_eq ((congrArg ((emptyLeafTensorIso X).inv ≫ ·) hm).trans
        ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫
          T.map (coefficientLeafMap (𝟙 Y) l)) hn).trans
          ((Category.assoc _ _ _).trans (emptyLinearSummandIso_inv O B P).symm))))
    | some i =>
      let P := s.inner.obj i
      let X := O.obj P
      let Y := O.obj (extendProfile P emptyColoredInputs)
      let f := O.map (emptyExtensionProfileIso P).inv
      let l := (emptyAddedAlgebraInputsIso B).inv
      let T := FiniteTensor.tensor (V := C)
      have hm : T.map (coefficientLeafMap f l) =
          (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map f ≫
            T.map (coefficientLeafMap (𝟙 Y)
            l) :=
        (congrArg T.map ((coefficientLeafMap_pre f (𝟙 Y) l).trans
          (congrArg (fun g => coefficientLeafMap g l) (Category.comp_id f))).symm).trans
            (T.map_comp _ _)
      have hn : (emptyLeafTensorIso X).inv ≫ (coefficientLeafTensorFunctor
        (FiniteFamily.empty : FiniteFamily C)).map f
        =
          f ≫ (emptyLeafTensorIso Y).inv := (emptyLeafTensorNatIso.inv.naturality f).symm
      exact heq_of_eq ((congrArg ((emptyLeafTensorIso X).inv ≫ ·) hm).trans
        ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫
          T.map (coefficientLeafMap (𝟙 Y) l)) hn).trans
          ((Category.assoc _ _ _).trans (emptyLinearSummandIso_inv O B P).symm))))

omit [FiniteTensor C] in
theorem emptyLinearFactorsIso_hom (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) :
    (emptyLinearFactorsIso O B P).hom =
      coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
        (emptyAddedAlgebraInputsIso B).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with | none => rfl | some i => cases i

/-- The actual output comparison is precisely the original joint profile/leaf
map followed by the original empty-leaf unitor. -/
theorem outputComparison (O : ColoredSymmetricCollection W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    (linearCoefficientDiagram O B s.totalProfile).map (totalInputsIso s).hom ≫
        (emptyLinearSummandIso O B s.totalProfile).hom =
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (O.map (totalProfileHom s))
        ((addedAlgebraInputs B).map (totalInputsIso s).hom ≫ (emptyAddedAlgebraInputsIso B).hom)) ≫
          (emptyLeafTensorIso (O.obj s.totalProfile)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.obj (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s (choices s)))
  let Y := O.obj (extendProfile s.totalProfile emptyColoredInputs)
  let f := O.map (extendProfileMap (𝟙 s.totalProfile) (totalInputsIso s).hom)
  let g := O.map (emptyExtensionProfileHom s.totalProfile)
  let l := (addedAlgebraInputs B).map (totalInputsIso s).hom
  let m := (emptyAddedAlgebraInputsIso B).hom
  let a := T.map (coefficientLeafMap f l)
  let b := T.map (coefficientLeafMap (𝟙 Y) m)
  have hab : a ≫ b = T.map (coefficientLeafMap f (l ≫ m)) :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (coefficientLeafMap_comp _ _ _ _)).trans
      (congrArg (fun h => T.map (coefficientLeafMap h (l ≫ m))) (Category.comp_id f)))
  have hfg : f ≫ g = O.map (totalProfileHom s) := (O.map_comp _ _).symm
  have hc : (T.map (coefficientLeafMap f (l ≫ m)) ≫ (emptyLeafTensorIso Y).hom) ≫ g =
      T.map (coefficientLeafMap (O.map (totalProfileHom s)) (l ≫ m)) ≫
        (emptyLeafTensorIso (O.obj s.totalProfile)).hom
        := by
    have h₁ := collapseEmptyLeafMap f (l ≫ m)
    have h₂ := collapseEmptyLeafMap (f ≫ g) (l ≫ m)
    exact (congrArg (· ≫ g) h₁).trans ((Category.assoc _ _ _).trans
      (h₂.symm.trans (congrArg (fun h => T.map (coefficientLeafMap h (l ≫ m)) ≫
        (emptyLeafTensorIso (O.obj s.totalProfile)).hom) hfg)))
  have he : (emptyLinearSummandIso O B s.totalProfile).hom = b ≫ (emptyLeafTensorIso Y).hom ≫ g :=
    congrArg (fun h => T.map h ≫ (emptyLeafTensorIso Y).hom ≫
      g) (emptyLinearFactorsIso_hom O B s.totalProfile)
  exact (congrArg (a ≫ ·) he).trans ((reassociateEmptyTensor a b (emptyLeafTensorIso Y).hom g).trans
    ((congrArg (fun h => (h ≫ (emptyLeafTensorIso Y).hom) ≫ g) hab).trans hc))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

end
