/- Exact checked source: UnitRightPrefixGeometry. -/
section EnvelopingSource031


/-!
# Original generic right prefixes and frozen-variable unit insertion

The original option-indexed right prefix and frozen empty/singleton blocks
have their exact original finite-family bijection. Naturality of tensor
flattening identifies their actual insertion maps for arbitrary coefficients.
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

private theorem normalizeRightPrefix {V : Type*} [Category* V]
    {X A B D E F G H : V} (p : X ⟶ A) (i : A ⟶ B) (a : B ⟶ D)
    (h : D ⟶ E) (v : E ⟶ F) (g : F ⟶ G) (f : B ⟶ H) (b : H ⟶ E)
    (k : A ⟶ H) (m : D ⟶ G) (hm : m = h ≫ v ≫ g)
    (ha : a ≫ h = f ≫ b) (hi : i ≫ f = k) :
    (p ≫ i ≫ a) ≫ m = p ≫ (k ≫ b ≫ v) ≫ g := by
  rw [hm]
  simp only [Category.assoc]
  rw [← Category.assoc a h, ha]
  simp only [Category.assoc]
  rw [← Category.assoc i f, hi]

private theorem EnvelopingSource031_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by
  simp only [Functor.map_comp]

variable {C : Type w} [Category.{v} C]

/-- The exact original option-to-variable/singleton bijection. -/
def rightPositionEquiv (I : FintypeCat.{0}) : Option I ≃ I ⊕ PUnit where
  toFun i := match i with
    | none => Sum.inr PUnit.unit
    | some i => Sum.inl i
  invFun i := match i with
    | Sum.inl i => some i
    | Sum.inr _ => none
  left_inv i := by cases i <;> rfl
  right_inv i := by
    cases i with
    | inl i => rfl
    | inr i => cases i; rfl

/-- The original right nested prefix and frozen empty/singleton
blocks retain exactly the same original root coefficient. -/
def rightNestedBlocksIso (X : C) (I : FintypeCat.{0}) :
    UnitInsertion.rightNestedFamily X I ≅
      frozenVariableBlocks I ((FiniteFamily.singleton (C := C)).obj X) :=
  FiniteFamily.isoOfComponents (rightPositionEquiv I) (fun i => match i with
    | none => Iso.refl _
    | some _ => Iso.refl _)

/-- Both original flattened prefix maps retain the original root
singleton and its actual object map. -/
theorem right_flatten_root (X : C) (I : FintypeCat.{0}) :
    UnitInsertion.rightSingletonToFlatten X I ≫
        (FiniteFamily.flatten (C := C)).map (rightNestedBlocksIso X I).hom ≫
        (frozenVariableFlattenIso I ((FiniteFamily.singleton (C := C)).obj X)).hom =
      𝟙 ((FiniteFamily.singleton (C := C)).obj X) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i
    rfl
  · intro i
    change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
    exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _))

variable [FiniteTensor C]

/-- The original root coefficient and one actual tensor unit at
each original variable position, with the original option index. -/
def unitRootFamily (X : C) (I : FintypeCat.{0}) : FiniteFamily C where
  index := FintypeCat.of (Option I)
  obj i := match i with
    | none => X
    | some _ => (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty

/-- Normalize only the original root singleton in the actual right
prefix; all original inserted tensor units remain unchanged. -/
def rightRootNormalizer (X : C) (I : FintypeCat.{0}) :
    UnitInsertion.rightTensorFamily X I ⟶ unitRootFamily X I where
  equiv := Equiv.refl (Option I)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app X
    | some _ => 𝟙 _

/-- The actual frozen-variable/root family has the original option
bijection and precisely the same coefficient and tensor-unit objects. -/
def rightUnitPositionIso (X : C) (I : FintypeCat.{0}) :
    frozenVariableUnitFamily I ((FiniteFamily.singleton (C := C)).obj X) ≅ unitRootFamily X I :=
  FiniteFamily.isoOfReindex (rightPositionEquiv I).symm (by
    intro i
    cases i <;> rfl)

/-- The original nested bijection and singleton unitor retain
exactly the actual right root-normalization map. -/
theorem right_tensor_root (X : C) (I : FintypeCat.{0}) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rightNestedBlocksIso X I).hom ≫
        (frozenVariableBlockIso I ((FiniteFamily.singleton (C := C)).obj X)).hom ≫
        (rightUnitPositionIso X I).hom = rightRootNormalizer X I := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app X ≫ 𝟙 X)
        ((FiniteTensor.singletonIso (V := C)).hom.app X)
      exact heq_of_eq (by
        have h := congrArg (fun k => k ≫ (FiniteTensor.singletonIso (V := C)).hom.app X ≫ 𝟙 X)
          ((FiniteTensor.tensor (V := C)).map_id ((FiniteFamily.singleton (C := C)).obj X))
        exact h.trans ((Category.id_comp _).trans (Category.comp_id _)))
    | some i =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫
        𝟙 _ ≫ 𝟙 _) (𝟙 _)
      exact heq_of_eq (by
        have h := congrArg (fun k => k ≫ 𝟙 _ ≫ 𝟙 _)
          ((FiniteTensor.tensor (V := C)).map_id (FiniteFamily.empty : FiniteFamily C))
        exact h.trans ((Category.id_comp _).trans (Category.id_comp _)))

/-- The actual generic right prefix, after root normalization, is
the original frozen-variable unit insertion through its exact option
bijection, for every original finite variable family and coefficient. -/
theorem rightInsertPrefix_normalized (X : C) (I : FintypeCat.{0}) :
    UnitInsertion.rightInsertPrefix X I ≫
        (FiniteTensor.tensor (V := C)).map (rightRootNormalizer X I) =
      (FiniteTensor.singletonIso (V := C)).inv.app X ≫
        (frozenVariableTensorUnitIso I ((FiniteFamily.singleton (C := C)).obj X)).hom ≫
          (FiniteTensor.tensor (V := C)).map (rightUnitPositionIso X I).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let K := (FiniteFamily.singleton (C := C)).obj X
  let N := UnitInsertion.rightNestedFamily X I
  let M := frozenVariableBlocks I K
  let n := (rightNestedBlocksIso X I).hom
  let r := UnitInsertion.rightSingletonToFlatten X I
  let e := frozenVariableFlattenIso I K
  let b := (frozenVariableBlockIso I K).hom
  let j := (rightUnitPositionIso X I).hom
  let p := (FiniteTensor.singletonIso (V := C)).inv.app X
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let a' := (FiniteTensor.flattenIso (V := C)).hom.app M
  have hr : r ≫ F.map n = e.inv := by
    apply (cancel_mono e.hom).1
    exact (Category.assoc r (F.map n) e.hom).trans
      ((right_flatten_root X I).trans e.inv_hom_id.symm)
  have hi : T.map r ≫ T.map (F.map n) = T.map e.inv :=
    (T.map_comp _ _).symm.trans (congrArg T.map hr)
  have hn : a ≫ T.map ((FiniteFamily.map T).map n) = T.map (F.map n) ≫ a' :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality n |>.symm
  have hm : T.map (rightRootNormalizer X I) =
      T.map ((FiniteFamily.map T).map n) ≫ T.map b ≫ T.map j :=
    (congrArg T.map (right_tensor_root X I).symm).trans
      (EnvelopingSource031_mapThree T ((FiniteFamily.map T).map n) b j)
  exact normalizeRightPrefix p (T.map r) a (T.map ((FiniteFamily.map T).map n))
    (T.map b) (T.map j) (T.map (F.map n)) a' (T.map e.inv)
    (T.map (rightRootNormalizer X I)) hm hn hi


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
end EnvelopingSource031

/- Exact checked source: UnitWeightedData. -/
section EnvelopingSource032


/-!
# Original coefficient units and leaf partitions for weighted prefix fusion

The retained root coefficient is arbitrary in the generic prefix. At the
original operadic profile it is exactly O(P ⊔ Q). Every original Q input
receives its own original operadic unit and singleton algebra-leaf block.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original empty root-leaf block and singleton algebra-leaf
block at every original added input. -/
def prefixLeaves (B : W → C) (Q : ColoredInputs W) : Option Q.index → FiniteFamily C
  | none => FiniteFamily.empty
  | some j => (FiniteFamily.singleton (C := C)).obj (B (Q.obj j).as)

/-- The original partitioned algebra leaves retain exactly the
original Q inputs through the displayed empty/singleton bijection. -/
def prefixLeafIso (X : C) (B : W → C) (Q : ColoredInputs W) :
    partitionedLeafFamily (UnitInsertion.rightNestedFamily X Q.index) (prefixLeaves B Q) ≅
      (addedAlgebraInputs B).obj Q :=
  FiniteFamily.isoOfReindex
    { toFun := fun p => match p with
        | ⟨none, e⟩ => e.elim
        | ⟨some j, _⟩ => j
      invFun := fun j => ⟨some j, PUnit.unit⟩
      left_inv := by
        intro p
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j
        | some i => cases j; rfl
      right_inv := fun _ => rfl }
    (by intro p; rcases p with ⟨i, j⟩; cases i with
        | none => cases j
        | some i => rfl)

/-- The original Q-unit factor map retains the root coefficient,
uses its actual singleton unitor, and inserts every original colored unit. -/
def unaryCoefficientUnitFactorMap (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    UnitInsertion.rightTensorFamily (O.toCollection.obj (extendProfile P Q)) Q.index ⟶
      frozenCoefficientFamily O.toCollection P Q (unaryBranches Q) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj (extendProfile P Q))
    | some j => O.unit (Q.obj j).as

/-- Insert only the original Q-unit coefficients through the actual
generic finite right prefix, retaining the original O(P ⊔ Q) root. -/
def unaryCoefficientUnitInsertion (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    O.toCollection.obj (extendProfile P Q) ⟶
      (FiniteTensor.tensor (V := C)).obj (frozenCoefficientFamily O.toCollection P Q
        (unaryBranches Q)) :=
  UnitInsertion.rightInsertFromFactor (O.toCollection.obj (extendProfile P Q)) Q.index
    (unaryCoefficientUnitFactorMap O P Q)


end CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

end
end EnvelopingSource032

/- Exact checked source: UnitCoefficientGeometry. -/
section EnvelopingSource033


/-!
# Original unary substitution profiles and colored unit coefficients

Every original variable and added input has its original unary profile.
The actual frozen substitution is compared with the original right-unit
substitution on the complete original profile P ⊔ Q.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

variable {W : Type u}

/-- The actual original full unary substitution map from the frozen
variable/algebra branches to the right-unit substitution of P ⊔ Q. -/
def unaryToRightSubstitutionMap (P : ColoredProfile W) (Q : ColoredInputs W) :
    frozenSubstitution P Q (unaryBranches Q) ⟶ ColoredSubstitutionData.rightUnit
      (extendProfile P Q) where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl (P.inputs ⊕ Q.index)
      hom i := match i with
        | Sum.inl i => 𝟙 (ColoredProfile.unary (P.inputColor i) (P.inputColor i))
        | Sum.inr j => 𝟙 (ColoredProfile.unary (Q.obj j).as (Q.obj j).as) }

/-- The original root comparison is precisely the original complete
right-unit outer-profile map, with every original color retained. -/
theorem unaryToRight_outer (P : ColoredProfile W) (Q : ColoredInputs W) :
    frozenOuterProfileHom P Q (unaryBranches Q) ≫
        ColoredSubstitutionData.outerProfileMap (unaryToRightSubstitutionMap P Q) =
      ColoredSubstitutionData.rightUnitOuterHom (extendProfile P Q) := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The actual variable and sigma-unit algebra-input bijections
retain exactly the original complete right-unit total-profile map. -/
theorem unaryToRight_total (P : ColoredProfile W) (Q : ColoredInputs W) :
    frozenTotalProfileHom P Q (unaryBranches Q) ≫ extendProfileMap (𝟙 P)
      (unaryTotalInputsIso Q).hom =
      ColoredSubstitutionData.totalProfileMap (unaryToRightSubstitutionMap P Q) ≫
        ColoredSubstitutionData.rightUnitTotalHom (extendProfile P Q) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
  cases i <;> rfl

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Insert the original colored unit at every original Q coefficient
position, retaining precisely the original O(P ⊔ Q) root coefficient. -/
def unaryCoefficientBareMap (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    unitRootFamily (O.toCollection.obj (extendProfile P Q)) Q.index ⟶
      frozenCoefficientFamily O.toCollection P Q (unaryBranches Q) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 (O.toCollection.obj (extendProfile P Q))
    | some j => O.unit (Q.obj j).as

/-- The original complete right-unit factor map from normalized root
and unit coefficients, retaining the original outer-profile comparison. -/
def rightCoefficientBareMap (O : ColoredOperadObj W C) (E : ColoredProfile W) :
    unitRootFamily (O.toCollection.obj E) E.inputs ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj
        (ColoredSubstitutionData.rightUnit E) where
  equiv := Equiv.refl (Option E.inputs)
  hom i := match i with
    | none => O.toCollection.map (ColoredSubstitutionData.rightUnitOuterHom E)
    | some j => O.unit (E.inputColor j)

/-- The actual Q-unit factors are their original root normalization
and original colored-unit maps, with the complete original option index. -/
theorem unaryCoefficientFactor_normalized (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    Weighted.unaryCoefficientUnitFactorMap O P Q =
      rightRootNormalizer (O.toCollection.obj (extendProfile P Q)) Q.index ≫
        unaryCoefficientBareMap O P Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq ((FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj
        (extendProfile P Q)))
        ((FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj (extendProfile P
          Q)) ≫ 𝟙 _)
      exact heq_of_eq (Category.comp_id _).symm
    | some j =>
      change HEq (O.unit (Q.obj j).as) (𝟙 _ ≫ O.unit (Q.obj j).as)
      exact heq_of_eq (Category.id_comp _).symm

/-- The original full right-unit factor map is precisely its
actual root singleton normalization followed by its original colored units. -/
theorem rightCoefficientFactor_normalized (O : ColoredOperadObj W C) (E : ColoredProfile W) :
    ColoredOperadObj.UnitInsertion.rightFactorHom O.toCollection O.unit E =
      rightRootNormalizer (O.toCollection.obj E) E.inputs ≫ rightCoefficientBareMap O E := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => rfl
    | some j =>
      change HEq (O.unit (E.inputColor j)) (𝟙 _ ≫ O.unit (E.inputColor j))
      exact heq_of_eq (Category.id_comp _).symm

/-- The original coefficient map from frozen Q-unit sources, through
all variable units, is exactly the full original right-unit coefficient
map after the original prefix sum and option bijections. -/
theorem fusedUnitCoefficientFactors (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    frozenVariableUnitFamilyMap P.inputs
        ((rightUnitPositionIso (O.toCollection.obj (extendProfile P Q)) Q.index).hom ≫
          unaryCoefficientBareMap O P Q) ≫
        frozenUnitCoefficientMap O P Q (unaryBranches Q) ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (unaryToRightSubstitutionMap P Q) =
      (prefixUnitReindexIso P.inputs Q.index
        ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile P Q)))).hom ≫
        (rightUnitPositionIso (O.toCollection.obj (extendProfile P Q)) (extendProfile P
          Q).inputs).hom ≫
        rightCoefficientBareMap O (extendProfile P Q) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      let c := P.inputColor i
      change HEq (𝟙 _ ≫ O.unit c ≫ O.toCollection.map (𝟙 (ColoredProfile.unary c c)))
        (𝟙 _ ≫ 𝟙 _ ≫ O.unit c)
      exact heq_of_eq (by
        have h := congrArg (fun k => 𝟙 _ ≫ O.unit c ≫ k)
          (O.toCollection.map_id (ColoredSubstitutionData.unitProfile c))
        exact h.trans (by simp only [Category.id_comp, Category.comp_id]))
    | inr i =>
      cases i with
      | inl j =>
        let c := (Q.obj j).as
        change HEq ((𝟙 _ ≫ O.unit c) ≫ 𝟙 _ ≫ O.toCollection.map (𝟙 (ColoredProfile.unary c c)))
          (𝟙 _ ≫ 𝟙 _ ≫ O.unit c)
        exact heq_of_eq (by
          have h := congrArg (fun k => (𝟙 _ ≫ O.unit c) ≫ 𝟙 _ ≫ k)
            (O.toCollection.map_id (ColoredSubstitutionData.unitProfile c))
          exact h.trans (by simp only [Category.id_comp, Category.comp_id]))
      | inr j =>
        let X := O.toCollection.obj (extendProfile P Q)
        let a := O.toCollection.map (frozenOuterProfileHom P Q (unaryBranches Q))
        let b := O.toCollection.map (ColoredSubstitutionData.outerProfileMap
          (unaryToRightSubstitutionMap P Q))
        let c := O.toCollection.map (ColoredSubstitutionData.rightUnitOuterHom (extendProfile P Q))
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ a ≫ b) (𝟙 X ≫ 𝟙 X ≫ c)
        have h : a ≫ b = c := (O.toCollection.map_comp _ _).symm.trans
          (congrArg O.toCollection.map (unaryToRight_outer P Q))
        exact heq_of_eq (by simpa only [Category.id_comp] using h)


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
