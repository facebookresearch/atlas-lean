private theorem weightedOuterFinish {D : Type*} [Category* D]
    {X A B E F Y : D} (p : X ⟶ A) (n : A ⟶ B) (r : B ⟶ E) (m : E ⟶ Y)
    (u : A ⟶ F) (j : F ⟶ Y) (f : X ⟶ F)
    (hn : n ≫ r ≫ m = u ≫ j) (hf : f = p ≫ u) :
    (p ≫ n) ≫ r ≫ m = f ≫ j := by
  simp only [Category.assoc]
  rw [hn, hf]
  exact (Category.assoc _ _ _).symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- The original joined constant/variable leaf family retains exactly
the original named root and dependent inner constant positions. -/
def evaluationLeafJoinIso (B M : W → C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    leafJoin ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q))
      (profileLeafFamily M s.totalProfile) ≅ evaluationLeafFamily B M s Q :=
  FiniteFamily.isoOfComponents
    (Equiv.refl ((envelopingTotalAlgebraInputs s Q).index ⊕ s.totalProfile.inputs))
    (fun p => match p with
      | Sum.inl (Sum.inl j) => Iso.refl (B ((Q none).obj j).as)
      | Sum.inl (Sum.inr ⟨i, j⟩) => Iso.refl (B ((Q (some i)).obj j).as)
      | Sum.inr i => Iso.refl (M (s.totalProfile.inputColor i)))

/-- The actual original weighted slot comparison is the identity
on its unchanged original finite tensor blocks. -/
theorem substitutionWeightedBlocks_tensor_inv (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (substitutionWeightedBlocksIso O B s Q).inv =
      𝟙 ((FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily O B s Q)) := by
  have h : (substitutionWeightedBlocksIso O B s Q).hom =
      𝟙 (envelopingWeightedRepresentativeFamily O B s Q) := rfl
  exact (congrArg (FiniteTensor.tensor (V := C)).map
    (weightedInverseIdentity (substitutionWeightedBlocksIso O B s Q) h)).trans
      ((FiniteTensor.tensor (V := C)).map_id _)

/-- The original complete source expansion retains its original
block flattening inverse and coefficient/variable normalizer inverse. -/
theorem substitutionExpandedSourceIso_hom (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (substitutionExpandedSourceIso O B M s Q).hom =
      (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).map
        ((FiniteTensor.flattenIso (V := C)).inv.app (substitutionInputBlocks O B s Q)) ≫
      (coefficientLeavesNormalizationIso (substitutionCoefficientInputs O B s Q)
        (profileLeafFamily M s.totalProfile)).inv := by
  let U := coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)
  have hi : U.map ((FiniteTensor.tensor (V := C)).map (substitutionWeightedBlocksIso O B s Q).inv) =
      𝟙 (U.obj ((FiniteTensor.tensor (V := C)).obj
        (envelopingWeightedRepresentativeFamily O B s Q))) :=
    (congrArg U.map (substitutionWeightedBlocks_tensor_inv O B s Q)).trans (U.map_id _)
  change U.map ((FiniteTensor.tensor (V := C)).map (substitutionWeightedBlocksIso O B s
    Q).inv) ≫ _ = _
  exact (congrArg (· ≫ _) hi).trans (Category.id_comp _)

omit [FiniteTensor C] in
/-- The original weighted coefficient/constant raw map followed by
joining the original variable leaves is the original expanded full
coefficient/constant/variable input map, with every position retained. -/
theorem weightedExpandedRaw_factor (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (weightedCoefficientLeafRawIso O B s Q).hom
        (𝟙 (profileLeafFamily M s.totalProfile))) ≫
      (leafJoinRawIso (envelopingRepresentativeCoefficients O s Q)
        ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q))
        (profileLeafFamily M s.totalProfile)).hom ≫
      (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (𝟙 (envelopingRepresentativeCoefficients O s Q))
          (evaluationLeafJoinIso B M s Q).hom) =
    (evaluationRawSourceIso O B M s Q).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rcases j with ⟨i, j⟩; cases i <;> cases j <;> rfl
    | some _ => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      rcases j with ⟨i, j⟩
      cases i with
      | none => cases j with
        | none =>
          let X := O.obj (extendProfile s.outerProfile (Q none))
          change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
        | some j =>
          let X := B ((Q none).obj j).as
          change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
      | some i => cases j with
        | none =>
          let X := O.obj (extendProfile (s.inner.obj i) (Q (some i)))
          change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
        | some j =>
          let X := B ((Q (some i)).obj j).as
          change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
    | some i =>
      cases j
      let X := M (s.totalProfile.inputColor i)
      change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])

/-- The full original weighted source normalizes to all original
coefficients with all original constant and variable leaves. The
same original source is obtained by first normalizing its actual
weighted coefficient/constant tensor and then collecting its variables. -/
theorem weightedLeaf_normalization (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (substitutionExpandedSourceIso O B M s Q).hom ≫
      (FiniteTensor.tensor (V := C)).map (evaluationRawSourceIso O B M s Q).hom ≫
      coefficientLeavesNormalization (envelopingRepresentativeCoefficients O s Q)
        (evaluationLeafFamily B M s Q) =
    (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).map
      (weightedCoefficientLeafNormalization O B s Q) ≫
      (leafJoinTensorIso ((FiniteTensor.tensor (V := C)).obj
        (envelopingRepresentativeCoefficients O s Q))
        ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q))
        (profileLeafFamily M s.totalProfile)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
          C)).obj (envelopingRepresentativeCoefficients O s Q)))
          (evaluationLeafJoinIso B M s Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let D := substitutionCoefficientInputs O B s Q
  let K := envelopingRepresentativeCoefficients O s Q
  let A := (addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q)
  let L := profileLeafFamily M s.totalProfile
  let U := coefficientLeafTensorFunctor L
  let a := (weightedCoefficientLeafRawIso O B s Q).hom
  let f := U.map (T.map a ≫ coefficientLeavesNormalization K A)
  let j₀ := (leafJoinTensorIso (T.obj K) A L).hom
  let ell := (evaluationLeafJoinIso B M s Q).hom
  let l := T.map (coefficientLeafMap (𝟙 (T.obj K)) ell)
  let j := j₀ ≫ l
  let n := coefficientLeavesNormalizationIso D L
  let r := T.map (evaluationRawSourceIso O B M s Q).hom
  let m := coefficientLeavesNormalization K (evaluationLeafFamily B M s Q)
  let raw₀ := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap a (𝟙 L)) ≫
    (leafJoinRawIso K A L).hom
  let raw₁ := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (𝟙 K) ell)
  let mj := coefficientLeavesNormalization K (leafJoin A L)
  have hbase : n.hom ≫ f ≫ j₀ = T.map raw₀ ≫ mj :=
    (congrArg (fun k => k ≫ f ≫ j₀) (coefficientLeavesNormalizationIso_hom D L)).trans
      (leafJoinOuter_normalization D K A L a)
  have hnLeaf : mj ≫ l = T.map raw₁ ≫ m :=
    (congrArg (mj ≫ ·) (congrArg (fun k => T.map (coefficientLeafMap k ell)) (T.map_id
      K))).symm.trans
      (coefficientLeavesNormalization_naturality (𝟙 K) ell).symm
  have hmap : T.map raw₀ ≫ T.map raw₁ = r :=
    (T.map_comp _ _).symm.trans
      (congrArg T.map ((Category.assoc _ _ _).trans (weightedExpandedRaw_factor O B M s Q)))
  have hraw : n.hom ≫ f ≫ j = r ≫ m :=
    (weightedJoinRawFinish n.hom f j₀ l (T.map raw₀) mj (T.map raw₁) m hbase hnLeaf).trans
      (congrArg (· ≫ m) hmap)
  have hn : n.inv ≫ r ≫ m = f ≫ j :=
    weightedInversePrefix n f j (r ≫ m) hraw
  let p := U.map ((FiniteTensor.flattenIso (V := C)).inv.app (substitutionInputBlocks O B s Q))
  let h := U.map (weightedCoefficientLeafNormalization O B s Q)
  have hh : h = p ≫ f :=
    (congrArg U.map (weightedCoefficientLeafNormalization_raw O B s Q)).trans (U.map_comp _ _)
  have he : (substitutionExpandedSourceIso O B M s Q).hom = p ≫ n.inv :=
    substitutionExpandedSourceIso_hom O B M s Q
  exact (congrArg (fun k => k ≫ r ≫ m) he).trans
    (weightedOuterFinish p n.inv r m f j h hn hh)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

