/- Exact checked source: ReflexiveOperad.EmptyOuterTensorBlocks. -/
section EnvelopingSource256


/-!
# Actual empty outer blocks before and after collecting arbitrary retained tensors
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary.EmptyOuter

open CategoryTheory

private theorem foldLayers {V : Type*} [Category* V]
    {X A B C D E F G H J K L M : V}
    (p : X ⟶ A) (r : A ⟶ B) (c : B ⟶ C) (f : A ⟶ D) (v : D ⟶ C)
    (eA : X ⟶ E) (q : E ⟶ D) (z : X ⟶ F) (s : F ⟶ G) (w : G ⟶ H)
    (d : H ⟶ B) (u : B ⟶ K) (b : K ⟶ C) (t : H ⟶ L) (d' : L ⟶ K)
    (ret : G ⟶ J) (eInv : J ⟶ L) (er : F ⟶ M) (pn : M ⟶ J) (erase : E ⟶ M)
    (hn : p ≫ f = eA ≫ q) (hl : r ≫ c = f ≫ v) (hp : p ≫ r = z ≫ s ≫ w ≫ d)
    (hc : c = u ≫ b) (ht : d ≫ u = t ≫ d') (hw : w ≫ t = ret ≫ eInv)
    (hr : s ≫ ret = er ≫ pn) (hz : z ≫ er = eA ≫ erase) :
    eA ≫ q ≫ v = eA ≫ erase ≫ pn ≫ (eInv ≫ d' ≫ b) := by
  calc
    eA ≫ q ≫ v = (eA ≫ q) ≫ v := (Category.assoc _ _ _).symm
    _ = (p ≫ f) ≫ v := congrArg (· ≫ v) hn.symm
    _ = p ≫ (r ≫ c) := (Category.assoc _ _ _).trans (congrArg (p ≫ ·) hl.symm)
    _ = (z ≫ s ≫ w ≫ d) ≫ c := (Category.assoc _ _ _).symm.trans (congrArg (· ≫ c) hp)
    _ = eA ≫ erase ≫ pn ≫ (eInv ≫ d' ≫ b) := by
      rw [hc]
      simp only [Category.assoc]
      rw [← Category.assoc d u b, ht]
      simp only [Category.assoc]
      rw [← Category.assoc w t (d' ≫ b), hw]
      simp only [Category.assoc]
      rw [← Category.assoc s ret (eInv ≫ d' ≫ b), hr]
      simp only [Category.assoc]
      rw [← Category.assoc z er (pn ≫ eInv ≫ d' ≫ b), hz]
      simp only [Category.assoc]

variable {C : Type w} [Category.{v} C]

/-- Actual empty blocks at the original added outer positions and
the unchanged original retained coefficient blocks. -/
def blocks (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) : FiniteFamily
  (FiniteFamily C) where
  index := FintypeCat.of (I ⊕ N.index)
  obj i := match i with | Sum.inl _ => FiniteFamily.empty | Sum.inr i => N.obj i

/-- Erase exactly the original empty blocks, retaining every actual atomic coefficient. -/
def eraseIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flatten (C := C)).obj (blocks I N) ≅ (FiniteFamily.flatten (C := C)).obj N :=
  FiniteFamily.isoOfComponents
    { toFun := fun x => match x with | ⟨Sum.inl _, j⟩ => j.elim | ⟨Sum.inr i, j⟩ => ⟨i, j⟩
      invFun := fun x => ⟨Sum.inr x.1, x.2⟩
      left_inv := fun x => by
        rcases x with ⟨i, j⟩
        cases i with
        | inl i => cases j
        | inr i => rfl
      right_inv := fun x => by cases x; rfl }
    (fun x => match x with | ⟨Sum.inl _, j⟩ => j.elim | ⟨Sum.inr _, _⟩ => Iso.refl _)

/-- Flattening the empty family of coefficient blocks gives the empty coefficient family. -/
def emptyFlattenIso :
    (FiniteFamily.flatten (C := C)).obj (FiniteFamily.empty : FiniteFamily (FiniteFamily C)) ≅
      (FiniteFamily.empty : FiniteFamily C) :=
  FiniteFamily.isoOfComponents
    { toFun := fun x => x.1.elim
      invFun := fun x => x.elim
      left_inv := fun x => x.1.elim
      right_inv := fun x => x.elim }
    (fun x => x.1.elim)

/-- The pure original three-level empty/singleton block family. -/
def triple (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    FiniteFamily (FiniteFamily (FiniteFamily C)) := frozenVariableBlocks (C := FiniteFamily C) I N

/-- Flattening each inner raw block is the actual empty/retained outer block family. -/
def rawBlocksIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (triple I N) ≅ blocks I N :=
  FiniteFamily.isoOfComponents (Equiv.refl (I ⊕ N.index)) (fun i => match i with
    | Sum.inl _ => emptyFlattenIso
    | Sum.inr i => FiniteFamily.singletonFlattenIso.app (N.obj i))

/-- The actual original retained-block bijection in the three-level family. -/
def retainedIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flatten (C := FiniteFamily C)).obj (triple I N) ≅ N :=
  frozenVariableFlattenIso (C := FiniteFamily C) I N

/-- Both raw atomic source maps retain exactly the same original coefficients. -/
theorem rawFlatten_readback (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flatten (C := C)).map (rawBlocksIso I N).hom ≫ (eraseIso I N).hom =
      FiniteFamily.flattenAssocIso.hom.app (triple I N) ≫
        (FiniteFamily.flatten (C := C)).map (retainedIso I N).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro x
    rcases x with ⟨i, j⟩
    cases i with
    | inl i => exact j.1.elim
    | inr i => cases j with | mk j k => cases j; rfl
  · intro x
    rcases x with ⟨i, j⟩
    cases i with
    | inl i => exact j.1.elim
    | inr i =>
        rcases j with ⟨j, k⟩
        cases j
        change HEq (𝟙 _ ≫ 𝟙 _) (𝟙 _ ≫ 𝟙 _)
        exact HEq.rfl

variable [FiniteTensor C]

/-- Tensoring the actual empty/retained blocks preserves their original outer positions. -/
def pointIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (blocks I N) ≅
      frozenVariableUnitFamily I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N) :=
  FiniteFamily.isoOfComponents (Equiv.refl (I ⊕ N.index)) (fun i => match i with
    | Sum.inl _ => Iso.refl _ | Sum.inr _ => Iso.refl _)

/-- The original mapped empty/singleton raw blocks have exactly the frozen prefix blocks. -/
def mappedBlocksIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V := C)))).obj (triple I N) ≅
      frozenVariableBlocks I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N) :=
  FiniteFamily.isoOfComponents (Equiv.refl (I ⊕ N.index)) (fun i => match i with
    | Sum.inl _ => FiniteFamily.mapEmptyIso (FiniteTensor.tensor (V := C))
    | Sum.inr _ => Iso.refl _)

/-- The actual singleton/empty outer collapse map. -/
def collapseMap (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        ((FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V := C)))).obj (triple I N)) ⟶
      frozenVariableUnitFamily I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N) :=
  (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (mappedBlocksIso I N).hom ≫
    (frozenVariableBlockIso I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N)).hom

/-- Every original empty block and every original singleton retained block
uses its genuine tensor empty/singleton coherence. -/
theorem localTensor_readback (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app (triple I N) ≫
      collapseMap I N =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rawBlocksIso I N).hom ≫
        (pointIso I N).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | inl i =>
        let M := (FiniteFamily.empty : FiniteFamily (FiniteFamily C))
        let : IsEmpty M.index := inferInstanceAs (IsEmpty Empty)
        let : IsEmpty ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj M).index :=
          inferInstanceAs (IsEmpty Empty)
        let : IsEmpty ((FiniteFamily.flatten (C := C)).obj M).index :=
          { false := fun x => x.1.elim }
        have he : (FiniteFamily.mapEmptyIso (FiniteTensor.tensor (V := C))).hom =
            Unit.emptyFamilyHom ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj M) := by
          apply FiniteFamily.Hom_ext
          · apply Equiv.ext
            intro j
            exact j.elim
          · intro j
            exact j.elim
        have hf : (emptyFlattenIso (C := C)).hom = Unit.emptyFamilyHom
          ((FiniteFamily.flatten (C := C)).obj M) := by
          apply FiniteFamily.Hom_ext
          · apply Equiv.ext
            intro j
            exact j.1.elim
          · intro j
            exact j.1.elim
        have h := Unit.flatten_empty_tensor M
        rw [← he, ← hf] at h
        exact heq_of_eq ((Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ 𝟙 _) h))
    | inr i =>
        let M := (FiniteFamily.singleton (C := FiniteFamily C)).obj (N.obj i)
        let s := (FiniteTensor.singletonIso (V := C)).hom.app ((FiniteTensor.tensor (V :=
          C)).obj (N.obj i))
        change HEq ((FiniteTensor.flattenIso (V := C)).hom.app M ≫
          (FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C :=
            C)).obj ((FiniteTensor.tensor (V :=
            C)).obj (N.obj i)))) ≫ s)
          ((FiniteTensor.tensor (V := C)).map (FiniteFamily.singletonFlattenIso.hom.app
            (N.obj i)) ≫ 𝟙 _)
        exact heq_of_eq ((congrArg (fun x => (FiniteTensor.flattenIso (V := C)).hom.app M ≫ x ≫ s)
          ((FiniteTensor.tensor (V := C)).map_id _)).trans
          ((congrArg ((FiniteTensor.flattenIso (V := C)).hom.app M ≫ ·) (Category.id_comp s)).trans
            ((singletonFlattenLaw_app (N.obj i)).symm.trans (Category.comp_id _).symm)))

/-- The mapped retained-block source and frozen retained-object source
are the same original finite-family map. -/
theorem mappedRetained_readback (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flattenMapIso (FiniteTensor.tensor (V := C))).hom.app (triple I N) ≫
      (FiniteFamily.flatten (C := C)).map (mappedBlocksIso I N).hom ≫
      (frozenVariableFlattenIso I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N)).hom =
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (retainedIso I N).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro x
    rcases x with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => cases j; rfl
  · intro x
    rcases x with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i =>
        cases j
        let X := (FiniteTensor.tensor (V := C)).obj (N.obj i)
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) ((FiniteTensor.tensor (V := C)).map (𝟙 (N.obj i)))
        exact heq_of_eq (((Category.id_comp _).trans (Category.id_comp _)).trans
          ((FiniteTensor.tensor (V := C)).map_id _).symm)

/-- Actual empty outer blocks can be inserted before or after tensoring
all arbitrary original retained blocks; every original coefficient and
the original finite tensor comparisons remain in the equality. -/
theorem normalization (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteTensor.tensor (V := C)).map (eraseIso I N).inv ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (blocks I N) ≫
        (FiniteTensor.tensor (V := C)).map (pointIso I N).hom =
      (FiniteTensor.flattenIso (V := C)).hom.app N ≫
        (frozenVariableTensorUnitIso I ((FiniteFamily.map (FiniteTensor.tensor (V :=
          C))).obj N)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let M := triple I N
  let A := (FiniteFamily.map F).obj M
  let R := blocks I N
  let bA := rawBlocksIso I N
  let bT := mappedBlocksIso I N
  let eR := retainedIso I N
  let eC := frozenVariableFlattenIso I ((FiniteFamily.map T).obj N)
  let ea := T.mapIso (F.mapIso bA)
  let ee := T.mapIso (eraseIso I N)
  let p := (FiniteTensor.flattenIso (V := C)).hom.app A
  let r := T.map ((FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app M)
  let c := T.map (collapseMap I N)
  let f := T.map ((FiniteFamily.map T).map bA.hom)
  let v := T.map (pointIso I N).hom
  let q := (FiniteTensor.flattenIso (V := C)).hom.app R
  let z := T.map (FiniteFamily.flattenAssocIso.hom.app M)
  let s := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.flatten (C :=
    FiniteFamily C)).obj M)
  let w := T.map ((FiniteFamily.flattenMapIso T).hom.app M)
  let d := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.map (FiniteFamily.map
    T)).obj M)
  let u := T.map ((FiniteFamily.map T).map bT.hom)
  let b := T.map (frozenVariableBlockIso I ((FiniteFamily.map T).obj N)).hom
  let t := T.map (F.map bT.hom)
  let d' := (FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I
    ((FiniteFamily.map T).obj N))
  let ret := T.map ((FiniteFamily.map T).map eR.hom)
  let eInv := T.map eC.inv
  let er := T.map (F.map eR.hom)
  let pn := (FiniteTensor.flattenIso (V := C)).hom.app N
  have hn : p ≫ f = ea.hom ≫ q := (FiniteTensor.flattenIso (V := C)).hom.naturality bA.hom |>.symm
  have hl : r ≫ c = f ≫ v :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (localTensor_readback I N)).trans (T.map_comp _ _))
  have hp : p ≫ r = z ≫ s ≫ w ≫ d := FiniteTensor.flattenAssocLaw_app_unfold M
  have hc : c = u ≫ b := T.map_comp _ _
  have ht : d ≫ u = t ≫ d' := (FiniteTensor.flattenIso (V := C)).hom.naturality bT.hom |>.symm
  have he : (((FiniteFamily.flattenMapIso T).hom.app M) ≫ F.map bT.hom) ≫ eC.hom =
      (FiniteFamily.map T).map eR.hom :=
    (Category.assoc _ _ _).trans (mappedRetained_readback I N)
  have hInv : ((FiniteFamily.flattenMapIso T).hom.app M) ≫ F.map bT.hom =
      (FiniteFamily.map T).map eR.hom ≫ eC.inv := (eC.eq_comp_inv).2 he
  have hw : w ≫ t = ret ≫ eInv :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hInv).trans (T.map_comp _ _))
  have hr : s ≫ ret = er ≫ pn := (FiniteTensor.flattenIso (V := C)).hom.naturality eR.hom |>.symm
  have hz : z ≫ er = ea.hom ≫ ee.hom :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (rawFlatten_readback I N).symm).trans
      (T.map_comp _ _))
  have h := foldLayers p r c f v ea.hom q z s w d u b t d' ret eInv er pn ee.hom hn hl hp hc
    ht hw hr hz
  have hq : q ≫ v = ee.hom ≫ pn ≫ (eInv ≫ d' ≫ b) := (cancel_epi ea.hom).1 h
  exact (congrArg (ee.inv ≫ ·) hq).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ (pn ≫ (eInv ≫ d' ≫ b))) ee.inv_hom_id).trans (Category.id_comp _)))


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary.EmptyOuter

end
end EnvelopingSource256

/- Exact checked source: WeightedNormalization.ConstantRootSource. -/
section EnvelopingSource257


/-!
# The original coefficient tensor and unit positions for root constants
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Root

open CategoryTheory

private theorem groupedRootPrefix {D : Type*} [Category* D] {A B C E F G : D}
    (a : A ⟶ B) (p : B ⟶ C) (r : C ⟶ E) (g : E ⟶ F) (z : F ⟶ G)
    (p' : B ⟶ E) (b : B ⟶ G)
    (hp : p ≫ r = p') (h : p' ≫ g ≫ z = b) :
    (a ≫ p ≫ (r ≫ g)) ≫ z = a ≫ b := by
  calc
    (a ≫ p ≫ (r ≫ g)) ≫ z = a ≫ (p ≫ r) ≫ g ≫ z := by simp only [Category.assoc]
    _ = a ≫ p' ≫ g ≫ z := congrArg (a ≫ · ≫ g ≫ z) hp
    _ = a ≫ b := congrArg (a ≫ ·) h

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original root coefficient, every original variable-branch operation,
and each original root-added nullary operation. -/
def rawFactors (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) : FiniteFamily
  C where
  index := FintypeCat.of (Option (s.inner.index ⊕ Q.index))
  obj i := match i with
    | none => E.obj (extendProfile s.outerProfile Q)
    | some (Sum.inl i) => E.obj (s.inner.obj i)
    | some (Sum.inr i) => E.obj (ColoredProfile.nullary (Q.obj i).as)

/-- Place each raw root, variable, and nullary coefficient in a singleton block. -/
def rawGroupsA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    FiniteFamily (FiniteFamily C) := (FiniteFamily.map (FiniteFamily.singleton (C :=
      C))).obj (rawFactors E s Q)

/-- The original variable branches receive their single outer units.
The actual root and actual root-added nullary branches have empty prefix indices. -/
def unitPositionsA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (rawGroupsA E s Q).index → FintypeCat.{0}
  | none => FintypeCat.of (Fin 0)
  | some (Sum.inl _) => FintypeCat.of PUnit
  | some (Sum.inr _) => FintypeCat.of (Fin 0)

/-- Identify each variable branch with its single unit position in the singleton raw blocks. -/
def unitPositionEquivA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W)
  (Q : ColoredInputs W) :
    s.inner.index ≃ blockUnitIndex (rawGroupsA E s Q) (unitPositionsA E s Q) where
  toFun i := ⟨some (Sum.inl i), PUnit.unit⟩
  invFun p := match p with
    | ⟨none, j⟩ => Fin.elim0 j
    | ⟨some (Sum.inl i), _⟩ => i
    | ⟨some (Sum.inr _), j⟩ => Fin.elim0 j
  left_inv _ := rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => exact Fin.elim0 j
    | some i =>
      cases i with
      | inl i => cases j; rfl
      | inr i => exact Fin.elim0 j

/-- Group the frozen root coefficients together and retain each variable coefficient in a
singleton block. -/
def rawGroupsB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option s.inner.index)
  obj i := match i with
    | none => frozenCoefficientFamily E s.outerProfile Q (Constants.branches Q)
    | some i => (FiniteFamily.singleton (C := C)).obj (E.obj (s.inner.obj i))

/-- Regroup the raw coefficients into the frozen root block and singleton variable blocks. -/
def rawSourceIsoB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    rawFactors E s Q ≅ (FiniteFamily.flatten (C := C)).obj (rawGroupsB E s Q) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | none => ⟨none, none⟩
        | some (Sum.inl i) => ⟨some i, PUnit.unit⟩
        | some (Sum.inr i) => ⟨none, some i⟩
      invFun := fun p => match p with
        | ⟨none, none⟩ => none
        | ⟨none, some i⟩ => some (Sum.inr i)
        | ⟨some i, _⟩ => some (Sum.inl i)
      left_inv := fun i => by cases i with | none => rfl | some i => cases i <;> rfl
      right_inv := fun p =>
        by rcases p with ⟨i, j⟩; cases i with | none => cases j <;> rfl | some i => cases j; rfl }
    (fun i => by cases i with | none => exact Iso.refl _ | some i => cases i <;> exact Iso.refl _)

/-- Map the extended root profile to the general substitution factors while fixing all branch
coefficients. -/
def generalFactorMap (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q
  : ColoredInputs W) :
    rawFactors E s Q ⟶ (ColoredOperadObj.substitutionFactors E).obj
      (Branch.generalSubstitution s Q) where
  equiv := Equiv.refl (Option (s.inner.index ⊕ Q.index))
  hom i := match i with
    | none => E.map (Branch.generalOuterHom s Q)
    | some (Sum.inl _) => 𝟙 _
    | some (Sum.inr _) => 𝟙 _

variable [FiniteTensor C]

/-- The displayed original local unit/coefficient maps into the exact E-association factors. -/
def localUnitMapA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q : ColoredInputs W)
    (i : (rawGroupsA E.toCollection s Q).index) :
    frozenVariableUnitFamily (unitPositionsA E.toCollection s Q i) ((rawGroupsA
      E.toCollection s Q).obj i) ⟶
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj i :=
  match i with
  | none =>
      (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
        ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (extendProfile
          s.outerProfile Q)))).hom ≫
          (FiniteFamily.singleton (C := C)).map (E.toCollection.map
            (frozenOuterProfileHom s.outerProfile Q (Constants.branches Q) ≫
              ColoredSubstitutionData.outerProfileMap
              (middleCompare s Q)))
  | some (Sum.inl i) => Constants.leftFrozenUnitMap E (s.inner.obj i)
  | some (Sum.inr i) =>
      (Unit.rightUnitPositionIso (E.toCollection.obj (ColoredProfile.nullary (Q.obj i).as))
        (FintypeCat.of (Fin 0))).hom
        ≫
        Unit.rightCoefficientBareMap E (ColoredProfile.nullary (Q.obj i).as)

/-- Assemble the local unit insertions into the flattened associativity grouping for root
constants. -/
def globalUnitMapA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    frozenVariableUnitFamily s.inner.index ((FiniteFamily.flatten (C :=
      C)).obj (rawGroupsA E.toCollection s Q)) ⟶
      ColoredOperadObj.AssocInsertion.flattenedGroupingA E.toCollection (assocData s Q) :=
  Variable.unitFamilyMap (unitPositionEquivA E.toCollection s Q)
    (𝟙 ((FiniteFamily.flatten (C := C)).obj (rawGroupsA E.toCollection s Q))) ≫
      blockUnitGlobalMap (rawGroupsA E.toCollection s Q) (unitPositionsA E.toCollection s Q)
        (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj
          (localUnitMapA E s Q)

/-- Insert the actual units at their original positions on the original complete coefficient
tensor. -/
def expandedSource (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      ColoredOperadObj.associativityCommonSource E.toCollection (assocData s Q) :=
  (FiniteTensor.tensor (V := C)).map (FiniteFamily.mapSingletonFlattenIso.inv.app
    (rawFactors E.toCollection s Q)) ≫
    (frozenVariableTensorUnitIso s.inner.index ((FiniteFamily.flatten (C :=
      C)).obj (rawGroupsA E.toCollection s
      Q))).hom ≫
      (FiniteTensor.tensor (V := C)).map (globalUnitMapA E s Q)

/-- Apply the local unit insertions to the tensors of the singleton raw blocks. -/
def appliedMapA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsA E.toCollection s Q) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (ColoredOperadObj.AssocInsertion.groupingA E.toCollection
        (assocData s Q)) :=
  blockUnitAppliedMap (rawGroupsA E.toCollection s Q) (unitPositionsA E.toCollection s Q)
    (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj
      (localUnitMapA E s Q)

/-- Original block distribution identifies the actual global source
with the tensor of the actual local insertions. -/
theorem expandedSource_grouped (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q
  : ColoredInputs W) :
    expandedSource E s Q ≫ (FiniteTensor.flattenIso (V := C)).hom.app
        (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)) =
      (FiniteTensor.tensor (V := C)).map (FiniteFamily.mapSingletonFlattenIso.inv.app
        (rawFactors E.toCollection s Q)) ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q) ≫
          (FiniteTensor.tensor (V := C)).map (appliedMapA E s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let N := rawGroupsA E.toCollection s Q
  let J := unitPositionsA E.toCollection s Q
  let M := (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj
  let e := unitPositionEquivA E.toCollection s Q
  let a := T.map (FiniteFamily.mapSingletonFlattenIso.inv.app (rawFactors E.toCollection s Q))
  let p := (frozenVariableTensorUnitIso s.inner.index ((FiniteFamily.flatten (C := C)).obj N)).hom
  let p' := (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C :=
    C)).obj N)).hom
  let r := T.map (Variable.unitFamilyMap e (𝟙 ((FiniteFamily.flatten (C := C)).obj N)))
  let g := T.map (blockUnitGlobalMap N J M (localUnitMapA E s Q))
  let z := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingA E.toCollection
    (assocData s Q))
  let b := (FiniteTensor.flattenIso (V := C)).hom.app N ≫ T.map (appliedMapA E s Q)
  have hp : p ≫ r = p' :=
    (Variable.tensorUnitIso_naturality e (𝟙 ((FiniteFamily.flatten (C := C)).obj N))).symm.trans
      ((congrArg (· ≫ p') (T.map_id _)).trans (Category.id_comp p'))
  have hg : T.map (globalUnitMapA E s Q) = r ≫ g := T.map_comp _ _
  have hd : p' ≫ g ≫ z = b := tensorUnitBlock_applied N J M (localUnitMapA E s Q)
  exact (congrArg (fun g => (a ≫ p ≫ g) ≫ z) hg).trans (groupedRootPrefix a p r g z p' b hp hd)

/-- Collapse the singleton block tensors to the factors of the variable and nullary-constant
substitution. -/
def collapsedFactorsA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsA E.toCollection s Q) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj (Branch.generalSubstitution s Q) :=
  (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app (rawFactors
    E.toCollection s Q) ≫
    generalFactorMap E.toCollection s Q

/-- Evaluate variable and root-nullary coefficients in one simultaneous substitution. -/
def generalRoute (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      E.toCollection.obj s.totalProfile :=
  (FiniteTensor.tensor (V := C)).map (generalFactorMap E.toCollection s Q) ≫
    E.subst.app (Branch.generalSubstitution s Q) ≫ E.toCollection.map (Branch.generalTotalHom s Q)

/-- Evaluate the frozen root constants and collapse singleton variable tensors to obtain the
original substitution factors. -/
def firstFactorMap (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsB E.toCollection s Q) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj s where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := match i with
    | none => frozenPartialSubstitution E s.outerProfile Q (Constants.branches Q) ≫
      E.toCollection.map
      (Constants.totalProfileHom s.outerProfile Q)
    | some i => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (s.inner.obj i))

/-- Evaluate the root constants first, then perform the original variable substitution. -/
def sequentialRoute (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      E.toCollection.obj s.totalProfile :=
  (FiniteTensor.tensor (V := C)).map (rawSourceIsoB E.toCollection s Q).hom ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q) ≫
      (FiniteTensor.tensor (V := C)).map (firstFactorMap E s Q) ≫ E.subst.app s


