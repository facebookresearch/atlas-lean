      change HEq ((p ≫ T.map e) ≫ T.map (𝟙 S) ≫ z ≫ E.toCollection.map (𝟙 P)) z
      exact heq_of_eq ((congrArg (· ≫ T.map (𝟙 S) ≫ z ≫ E.toCollection.map (𝟙 P)) hp).trans
        ((congrArg (𝟙 (T.obj S) ≫ · ≫ z ≫ E.toCollection.map (𝟙 P)) (T.map_id S)).trans
          ((congrArg (𝟙 (T.obj S) ≫ 𝟙 (T.obj S) ≫ z ≫ ·) (E.toCollection.map_id P)).trans
            (by simp only [Category.id_comp]; exact Category.comp_id z))))

theorem collapsedSourceB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    expandedSource E s Q ≫ (FiniteTensor.tensor (V := C)).map
        (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData s Q)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (ColoredOperadObj.AssocInsertion.groupingB
        E.toCollection (assocData s
        Q)) ≫
      (FiniteTensor.tensor (V := C)).map
        (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst
        (assocData s Q)) ≫
        (ColoredOperadObj.substitutionSource E.toCollection).map (innerCompare s Q) =
      (FiniteTensor.tensor (V := C)).map (rawSourceIsoB E.toCollection s Q).hom ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q) ≫
          (FiniteTensor.tensor (V := C)).map (firstFactorMap E s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData s Q
  let x := expandedSource E s Q
  let p := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection d)
  let f := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst d)
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map (innerCompare s Q)
  let a := T.map (rawSourceIsoB E.toCollection s Q).hom
  let n := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q)
  let l := T.map (appliedMapB E s Q)
  let m := T.map ((FiniteFamily.map T).map (groupingIsoB E.toCollection s Q).hom)
  let r := T.map (firstFactorMap E s Q)
  have hl : l ≫ m ≫ g ≫ h = r :=
    (mapFourRootB T _ _ _ _).symm.trans (congrArg T.map (appliedMapB_collapse E s Q))
  exact rootSourceBFiring x p f g h a n l m r (expandedSource_groupedB E s Q) hl

/-- The literal root-first E-association route is the literal original
root constant contraction followed by original variable substitution. -/
theorem associationRouteB_isSequential (E : ColoredOperadObj W C) (s :
  ColoredSubstitutionData W) (Q : ColoredInputs W)
  :
    expandedSource E s Q ≫ ColoredOperadObj.associativityRouteB E.toCollection E.subst
      (assocData s Q) ≫
      E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s Q)
        ≫ Branch.generalTotalHom s Q)
        =
        sequentialRoute E s Q := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData s Q
  let x := expandedSource E s Q
  let p := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection d)
  let f := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst d)
  let σ := E.subst.app d.innerData
  let t := E.toCollection.map d.totalHom
  let r := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s
    Q) ≫ Branch.generalTotalHom
    s Q)
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (innerCompare s Q))
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map (innerCompare s Q)
  let a := T.map (rawSourceIsoB E.toCollection s Q).hom
  let b := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q)
  let c := T.map (firstFactorMap E s Q)
  let z := a ≫ b ≫ c
  have ht : t ≫ r = q := (E.toCollection.map_comp _ _).symm.trans (congrArg
    E.toCollection.map (totalProfile_readback s
    Q))
  have hs : σ ≫ q = h ≫ E.subst.app s := (E.subst.naturality (innerCompare s Q)).symm
  have hz : x ≫ p ≫ f ≫ g ≫ h = z := collapsedSourceB E s Q
  exact (rootBRouteFiring x p f g σ t r q h (E.subst.app s) z ht hs hz).trans
    (ungroupThreeRootB a b c (E.subst.app s))

/-- Actual E-associativity proves that the literal root constants contract
before or after the literal original variable substitution on the full original coefficient
tensor. -/
theorem generalRoute_eq_sequential (E : ColoredOperadObj W C) (s : ColoredSubstitutionData
  W) (Q : ColoredInputs W) :
    generalRoute E s Q = sequentialRoute E s Q :=
  (associationRouteA_isGeneral E s Q).symm.trans
    ((congrArg (fun a => expandedSource E s Q ≫ a ≫
      E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s Q)
        ≫ Branch.generalTotalHom s Q))
      (E.assoc (assocData s Q))).trans (associationRouteB_isSequential E s Q))


