private theorem injectionTransport {V : Type*} [Category* V]
    {X A B C D Y : V} (u : X ⟶ A) (e : A ⟶ B) (a : B ⟶ C)
    (k : A ⟶ D) (e' : D ⟶ C) (d : X ⟶ Y) (u' : Y ⟶ D)
