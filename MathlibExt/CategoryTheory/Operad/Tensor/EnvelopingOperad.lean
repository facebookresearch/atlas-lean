  have hop : LinearAlgebra.linearOperations O B MO (linearAlgebraConstants O B MS) =
      LinearAlgebra.linearOperations O B MO (linearAlgebraConstants O B MK) :=
    congrArg (LinearAlgebra.linearOperations O B MO) hc
