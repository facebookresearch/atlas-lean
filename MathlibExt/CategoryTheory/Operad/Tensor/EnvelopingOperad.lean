/-!
# The actual original one-unit tensor source is its singleton tensor inverse
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem singletonUnitTensorSquare {V : Type*} [Category* V]
    {X A B D Y : V} (a : X ⟶ A) (b : A ⟶ Y) (r : X ⟶ B) (c : B ⟶ Y)
    (s : Y ⟶ D) (q : B ⟶ D) (f : X ⟶ D)
    (hn : r ≫ c = a ≫ b) (hs : q = c ≫ s) (hf : r ≫ q = f) :
    a ≫ b ≫ s = f := by
  exact (Category.assoc a b s).symm.trans
    ((congrArg (· ≫ s) hn.symm).trans ((Category.assoc r c s).trans ((congrArg (r ≫
      ·) hs.symm).trans hf)))

private theorem singletonUnitSourceInverse {V : Type*} [Category* V]
    {X A B : V} (e : X ≅ A) (s : B ≅ A) (a : X ⟶ B) (h : a ≫ s.hom = e.hom) :
    e.inv ≫ a = s.inv := by
  apply (cancel_mono s.hom).1
  rw [Category.assoc, h, e.inv_hom_id, s.inv_hom_id]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The actual original all-empty singleton tensor insertion
followed by its original singleton-unit comparison is the actual
inverse singleton unitor on the original tensor unit. -/
theorem tensorAllUnitInsertion_singleton :
    tensorAllUnitInsertion (C := C) (FintypeCat.of PUnit) ≫
        (FiniteTensor.tensor (V := C)).map (allUnitSingletonIso (C := C)).hom =
      (FiniteTensor.singletonIso (V := C)).inv.app ((FiniteTensor.tensor (V :=
        C)).obj FiniteFamily.empty) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := allEmptyTensorBlocks (C := C) (FintypeCat.of PUnit)
  let M := (FiniteFamily.singleton (C := FiniteFamily C)).obj (FiniteFamily.empty : FiniteFamily C)
  let e := T.mapIso (allEmptyFlattenIso (C := C) (FintypeCat.of PUnit))
  let r := T.map (F.map (allEmptySingletonIso (C := C)).hom)
  let q := T.map (FiniteFamily.singletonFlattenIso.hom.app (FiniteFamily.empty : FiniteFamily C))
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let b := T.map (allUnitSingletonIso (C := C)).hom
  let c := (FiniteTensor.flattenIso (V := C)).hom.app M
  let s := (FiniteTensor.singletonIso (V := C)).app (T.obj FiniteFamily.empty)
  have hflat : r ≫ q = e.hom := (T.map_comp _ _).symm.trans (congrArg T.map
    (allEmptySingleton_flatten (C := C)))
  have ht : T.map ((FiniteFamily.map T).map (allEmptySingletonIso (C := C)).hom) = b :=
    congrArg T.map (allEmptySingleton_tensor (C := C))
  have hn : r ≫ c = a ≫ b := by
    exact ((FiniteTensor.flattenIso (V := C)).hom.naturality (allEmptySingletonIso (C :=
      C)).hom).trans
      (congrArg (a ≫ ·) ht)
  have hs : q = c ≫ s.hom := singletonFlattenLaw_app (FiniteFamily.empty : FiniteFamily C)
  have h : a ≫ b ≫ s.hom = e.hom := singletonUnitTensorSquare a b r c s.hom q e.hom hn hs hflat
  have hread : tensorAllUnitInsertion (C := C) (FintypeCat.of PUnit) ≫
    T.map (allUnitSingletonIso (C := C)).hom =
      (e.inv ≫ a) ≫ b := rfl
  exact hread.trans ((Category.assoc e.inv a b).trans
    (singletonUnitSourceInverse e s (a ≫ b) ((Category.assoc a b s.hom).trans h)))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource082

