/- Exact checked source: EnvelopingShapeCoefficientNaturality. -/
section EnvelopingSource188


/-!
# Actual original coefficient substitution respects all shape and choice maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalShapeTwoSquares {V : Type*} [Category* V]
    {X X' Y Y' Z Z' : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (b : Y ⟶ Z) (b' : Y' ⟶ Z') (g : Z ⟶ Z')
    (ha : k ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) :
    k ≫ (a' ≫ b') = (a ≫ b) ≫ g := by
  rw [← Category.assoc k a', ha, Category.assoc a f, hb, Category.assoc]

private theorem originalShapeThreeSquares {V : Type*} [Category* V]
    {X X' Y Y' Z Z' D D' : V} (k : X ⟶ X')
    (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (b : Y ⟶ Z) (b' : Y' ⟶ Z') (g : Z ⟶ Z')
    (c : Z ⟶ D) (c' : Z' ⟶ D') (h : D ⟶ D')
    (ha : k ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) (hc : g ≫ c' = c ≫ h) :
    k ≫ (a' ≫ b' ≫ c') = (a ≫ b ≫ c) ≫ h := by
  rw [← Category.assoc k a', ha, Category.assoc a f, ← Category.assoc f b', hb,
    Category.assoc b g, hc]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] {s t : ColoredSubstitutionData W}

/-- The actual root and every original branch coefficient map
retain the original shape and input-choice bijections. -/
def envelopingShapeCoefficientMap (O : ColoredSymmetricCollection W C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingRepresentativeCoefficients O s Q ⟶ envelopingRepresentativeCoefficients O t Q' where
  equiv := envelopingShapeSlotEquiv f
  hom i := match i with
    | none => O.map (extendProfileMap (ColoredSubstitutionData.outerProfileMap f) (g none))
    | some i => O.map (extendProfileMap (f.innerHom.hom i) (g (some i)))

variable [FiniteTensor C]

/-- The actual original units and root/branch coefficients obey
the whole full-shape substitution-factor square. -/
theorem envelopingShapeUnitMap_naturality (O : ColoredOperadObj W C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingRepresentativeUnitMap O s Q ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (envelopingShapeRepresentativeMap f g) =
      Variable.unitFamilyMap (g none).equiv (envelopingShapeCoefficientMap O.toCollection f g) ≫
        envelopingRepresentativeUnitMap O t Q' := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl j => rfl
    | inr p => cases p <;> rfl
  · intro p
    cases p with
    | inl j =>
      change HEq (O.unit ((Q none).obj j).as ≫ O.toCollection.map
        (unaryColorHom (Discrete.eq_of_hom ((g none).hom j))))
        (𝟙 _ ≫ O.unit ((Q' none).obj ((g none).equiv j)).as)
      exact heq_of_eq ((Variable.unaryUnit_naturality O
        (Discrete.eq_of_hom ((g none).hom j))).trans (Category.id_comp _).symm)
    | inr p =>
      cases p with
      | none =>
        change HEq (O.toCollection.map (envelopingRepresentativeOuterHom s Q) ≫
          O.toCollection.map (ColoredSubstitutionData.outerProfileMap
            (envelopingShapeRepresentativeMap f g)))
          (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.outerProfileMap f)
            (g none)) ≫
            O.toCollection.map (envelopingRepresentativeOuterHom t Q'))
        exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
          ((congrArg O.toCollection.map (envelopingShapeOuterHom_naturality f g).symm).trans
            (O.toCollection.map_comp _ _)))
      | some i =>
        change HEq (𝟙 _ ≫ O.toCollection.map (extendProfileMap (f.innerHom.hom i) (g (some i))))
          (O.toCollection.map (extendProfileMap (f.innerHom.hom i) (g (some i))) ≫ 𝟙 _)
        exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- The actual representative tensor insertion respects the
original full shape map, by proved unit-family naturality. -/
theorem envelopingShapeCoefficientTensorMap_naturality (O : ColoredOperadObj W C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingShapeCoefficientMap O.toCollection f g) ≫
        envelopingRepresentativeCoefficientTensorMap O t Q' =
      envelopingRepresentativeCoefficientTensorMap O s Q ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map
          (envelopingShapeRepresentativeMap f g) := by
  let T := FiniteTensor.tensor (V := C)
  let k := envelopingShapeCoefficientMap O.toCollection f g
  let h := (ColoredOperadObj.substitutionFactors O.toCollection).map
    (envelopingShapeRepresentativeMap f g)
  have hu : T.map (Variable.unitFamilyMap (g none).equiv k) ≫
    T.map (envelopingRepresentativeUnitMap O t Q') =
      T.map (envelopingRepresentativeUnitMap O s Q) ≫ T.map h :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (envelopingShapeUnitMap_naturality O f g).symm).trans (T.map_comp _ _))
  exact originalShapeTwoSquares (T.map k)
    (frozenVariableTensorUnitIso (Q none).index (envelopingRepresentativeCoefficients
      O.toCollection s Q)).hom
    (frozenVariableTensorUnitIso (Q' none).index (envelopingRepresentativeCoefficients
      O.toCollection t Q')).hom
    (T.map (Variable.unitFamilyMap (g none).equiv k))
    (T.map (envelopingRepresentativeUnitMap O s Q)) (T.map (envelopingRepresentativeUnitMap O t Q'))
    (T.map h) (Variable.tensorUnitIso_naturality (g none).equiv k) hu

/-- The actual whole coefficient substitution square is derived
from original operad substitution naturality and exact total-profile transport. -/
theorem envelopingShapeCoefficientSubstitution_naturality (O : ColoredOperadObj W C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingShapeCoefficientMap O.toCollection f g) ≫
        envelopingRepresentativeCoefficientSubstitution O t Q' =
      envelopingRepresentativeCoefficientSubstitution O s Q ≫ O.toCollection.map
        (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
          (envelopingShapeTotalAlgebraInputsMap f g)) := by
  let m := envelopingShapeRepresentativeMap f g
  have ht : O.toCollection.map (ColoredSubstitutionData.totalProfileMap m) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom t Q') =
      O.toCollection.map (envelopingRepresentativeTotalHom s Q) ≫ O.toCollection.map
        (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
          (envelopingShapeTotalAlgebraInputsMap f g)) :=
    (O.toCollection.map_comp _ _).symm.trans
      ((congrArg O.toCollection.map (envelopingShapeTotalHom_naturality f g)).trans
        (O.toCollection.map_comp _ _))
  exact originalShapeThreeSquares ((FiniteTensor.tensor (V :=
    C)).map (envelopingShapeCoefficientMap O.toCollection f
    g))
    (envelopingRepresentativeCoefficientTensorMap O s Q)
      (envelopingRepresentativeCoefficientTensorMap O t Q')
    ((ColoredOperadObj.substitutionSource O.toCollection).map m)
    (O.subst.app (envelopingRepresentativeSubstitution s Q)) (O.subst.app
      (envelopingRepresentativeSubstitution t Q'))
    (O.toCollection.map (ColoredSubstitutionData.totalProfileMap m))
    (O.toCollection.map (envelopingRepresentativeTotalHom s Q)) (O.toCollection.map
      (envelopingRepresentativeTotalHom t
      Q'))
    (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
      (envelopingShapeTotalAlgebraInputsMap f g)))
    (envelopingShapeCoefficientTensorMap_naturality O f g) (O.subst.naturality m) ht


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource188

/- Exact checked source: EnvelopingShapeWeightedNaturality. -/
section EnvelopingSource189


/-!
# Original weighted representative substitution commutes with every shape map
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] {s t : ColoredSubstitutionData W}

/-- Each root/branch coefficient uses its actual full shape/input profile map. -/
def envelopingShapeSlotCoefficientMap (O : ColoredSymmetricCollection W C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') (i : Option s.inner.index) :
    O.obj (extendProfile (envelopingSlotProfile s i) (Q i)) ⟶
      O.obj (extendProfile (envelopingSlotProfile t (envelopingShapeSlotEquiv f i))
        (Q' (envelopingShapeSlotEquiv f i))) :=
  O.map (extendProfileMap (envelopingShapeSlotProfileMap f i) (g i))

/-- All root/dependent-inner algebra maps retain their original input arrows. -/
def envelopingShapeSlotAlgebraMap (A : W → C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') (i : Option s.inner.index) :
    (addedAlgebraInputs A).obj (Q i) ⟶
      (addedAlgebraInputs A).obj (Q' (envelopingShapeSlotEquiv f i)) :=
  (addedAlgebraInputs A).map (g i)

/-- The original full leaf-family map retains the original shape-slot bijection. -/
def envelopingShapeBlockAlgebraMap (A : W → C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingBlockAlgebraLeaves A s Q ⟶ envelopingBlockAlgebraLeaves A t Q' :=
  (FiniteFamily.flatten (C := C)).map
    (inputBlockRelabelMap (envelopingShapeSlotEquiv f) (envelopingShapeSlotAlgebraMap A f g))

/-- The actual root/dependent-inner leaf normalization respects
every original shape-slot permutation and input color equality. -/
theorem envelopingShapeAlgebraLeafIso_naturality (A : W → C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingShapeBlockAlgebraMap A f g ≫ (envelopingAlgebraLeafIso A t Q').hom =
      (envelopingAlgebraLeafIso A s Q).hom ≫
        (addedAlgebraInputs A).map (envelopingShapeTotalAlgebraInputsMap f g) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      change HEq ((Discrete.functor A).map ((g none).hom j) ≫ 𝟙 _)
        (𝟙 _ ≫ (Discrete.functor A).map ((g none).hom j))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      change HEq ((Discrete.functor A).map ((g (some i)).hom j) ≫ 𝟙 _)
        (𝟙 _ ≫ (Discrete.functor A).map ((g (some i)).hom j))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- The exact original named coefficient family comparison is
natural in every original full shape and input-choice map. -/
theorem envelopingShapeCoefficientBlockIso_naturality (O : ColoredSymmetricCollection W C)
  (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    coefficientBlockRelabelMap (envelopingShapeSlotEquiv f)
      (envelopingShapeSlotCoefficientMap O f g) ≫
        (envelopingCoefficientBlockIso O t Q').hom =
      (envelopingCoefficientBlockIso O s Q).hom ≫ envelopingShapeCoefficientMap O f g := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap (ColoredSubstitutionData.outerProfileMap f) (g
        none)) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap (ColoredSubstitutionData.outerProfileMap f) (g none)))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      change HEq (O.map (extendProfileMap (f.innerHom.hom i) (g (some i))) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap (f.innerHom.hom i) (g (some i))))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

private theorem originalWeightedShapeSquares {V : Type*} [Category* V]
    {X X' Y Y' Z Z' : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (b : Y ⟶ Z) (b' : Y' ⟶ Z') (g : Z ⟶ Z')
    (ha : k ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) :
    k ≫ (a' ≫ b') = (a ≫ b) ≫ g := by
  rw [← Category.assoc k a', ha, Category.assoc a f, hb, Category.assoc]

private theorem originalWeightedJointShapeSquare {V : Type*} [Category* V]
    {X X' Y Y' : V} {L L' M M' : FiniteFamily V}
    (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (l : L ⟶ L') (b : L ⟶ M) (b' : L' ⟶ M') (g : M ⟶ M')
    (ha : k ≫ a' = a ≫ f) (hb : l ≫ b' = b ≫ g) :
    coefficientLeafMap k l ≫ coefficientLeafMap a' b' =
      coefficientLeafMap a b ≫ coefficientLeafMap f g := by
  rw [coefficientLeafMap_comp, ha, hb, coefficientLeafMap_comp]

variable [FiniteTensor C]

/-- The actual tensor-block map retains the original coefficient-slot bijection. -/
def envelopingShapeWeightedRepresentativeMap (O : ColoredSymmetricCollection W C) (A : W →
  C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingWeightedRepresentativeFamily O A s Q ⟶
      envelopingWeightedRepresentativeFamily O A t Q' :=
  weightedInputBlockRelabelMap (envelopingShapeSlotEquiv f)
    (envelopingShapeSlotCoefficientMap O f g) (envelopingShapeSlotAlgebraMap A f g)

/-- Original normalized coefficient substitution respects the
actual full shape/output equality and every original input map. -/
theorem envelopingShapeNormalizedCoefficient_naturality (O : ColoredOperadObj W C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map
        (coefficientBlockRelabelMap (envelopingShapeSlotEquiv f)
          (envelopingShapeSlotCoefficientMap O.toCollection f g)) ≫
        ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection t
          Q').hom ≫
          envelopingRepresentativeCoefficientSubstitution O t Q') =
      ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
        envelopingRepresentativeCoefficientSubstitution O s Q) ≫ O.toCollection.map
          (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
            (envelopingShapeTotalAlgebraInputsMap f g))
            := by
  let T := FiniteTensor.tensor (V := C)
  have h : T.map (coefficientBlockRelabelMap (envelopingShapeSlotEquiv f)
        (envelopingShapeSlotCoefficientMap O.toCollection f g)) ≫
        T.map (envelopingCoefficientBlockIso O.toCollection t Q').hom =
      T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
        T.map (envelopingShapeCoefficientMap O.toCollection
        f g) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (envelopingShapeCoefficientBlockIso_naturality O.toCollection f
        g)).trans (T.map_comp _ _))
  exact originalWeightedShapeSquares _ _ _ _ _ _ _ h
    (envelopingShapeCoefficientSubstitution_naturality O f g)

/-- The actual normalized whole tensor evaluation square retains
the original variable-profile and total algebra-input maps. -/
theorem envelopingShapeNormalizedEvaluation_naturality (O : ColoredOperadObj W C) (A : W →
  C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map
          (coefficientBlockRelabelMap (envelopingShapeSlotEquiv f)
            (envelopingShapeSlotCoefficientMap O.toCollection f g)))
              (envelopingShapeBlockAlgebraMap A f g)) ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection
            t Q').hom ≫
            envelopingRepresentativeCoefficientSubstitution O t Q')
              (envelopingAlgebraLeafIso A t Q').hom) =
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
          envelopingRepresentativeCoefficientSubstitution O s Q) (envelopingAlgebraLeafIso A
            s Q).hom) ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
            (envelopingShapeTotalAlgebraInputsMap f g)))
          ((addedAlgebraInputs A).map (envelopingShapeTotalAlgebraInputsMap f g))) := by
  let T := FiniteTensor.tensor (V := C)
  have h := originalWeightedJointShapeSquare
    (T.map (coefficientBlockRelabelMap (envelopingShapeSlotEquiv f)
      (envelopingShapeSlotCoefficientMap O.toCollection f
      g)))
    (T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
      envelopingRepresentativeCoefficientSubstitution O s
      Q)
    (T.map (envelopingCoefficientBlockIso O.toCollection t Q').hom ≫
      envelopingRepresentativeCoefficientSubstitution O t
      Q')
    (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
      (envelopingShapeTotalAlgebraInputsMap f g)))
    (envelopingShapeBlockAlgebraMap A f g) (envelopingAlgebraLeafIso A s Q).hom
    (envelopingAlgebraLeafIso A t Q').hom ((addedAlgebraInputs A).map
      (envelopingShapeTotalAlgebraInputsMap f g))
    (envelopingShapeNormalizedCoefficient_naturality O f g)
      (envelopingShapeAlgebraLeafIso_naturality A f g)
  exact (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))

/-- Full actual representative substitution is equivariant in
every original shape map, input bijection and output-color equality. -/
theorem envelopingShapeRepresentativeEvaluation_naturality (O : ColoredOperadObj W C) (A : W
  → C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingShapeWeightedRepresentativeMap
      O.toCollection A f g) ≫
        envelopingRepresentativeEvaluation O A t Q' =
      envelopingRepresentativeEvaluation O A s Q ≫ (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.toCollection.map
          (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
            (envelopingShapeTotalAlgebraInputsMap f g)))
          ((addedAlgebraInputs A).map (envelopingShapeTotalAlgebraInputsMap f g))) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option s.inner.index)
  let J := FintypeCat.of (Option t.inner.index)
  have h1 := coefficientBlockInterchangeTensorIso_relabel
      (I := I) (J := J) (envelopingShapeSlotEquiv f)
      (K := fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
      (K' := fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile t i) (Q' i)))
      (L := fun i => (addedAlgebraInputs A).obj (Q i))
      (L' := fun i => (addedAlgebraInputs A).obj (Q' i))
      (envelopingShapeSlotCoefficientMap O.toCollection f g) (envelopingShapeSlotAlgebraMap A f g)
  exact originalWeightedShapeSquares (T.map (envelopingShapeWeightedRepresentativeMap
    O.toCollection A f g))
    (coefficientBlockInterchangeTensorIso I
      (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
      (fun i => (addedAlgebraInputs A).obj (Q i))).hom
    (coefficientBlockInterchangeTensorIso J
      (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile t i) (Q' i)))
      (fun i => (addedAlgebraInputs A).obj (Q' i))).hom
    (T.map (coefficientLeafMap
      (T.map (coefficientBlockRelabelMap (I := I) (J := J) (envelopingShapeSlotEquiv f)
        (K := fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
        (K' := fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile t i) (Q' i)))
        (envelopingShapeSlotCoefficientMap O.toCollection f g)))
      (envelopingShapeBlockAlgebraMap A f g)))
    (T.map (coefficientLeafMap
      (T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
        envelopingRepresentativeCoefficientSubstitution O
        s Q)
      (envelopingAlgebraLeafIso A s Q).hom))
    (T.map (coefficientLeafMap
      (T.map (envelopingCoefficientBlockIso O.toCollection t Q').hom ≫
        envelopingRepresentativeCoefficientSubstitution O
        t Q')
      (envelopingAlgebraLeafIso A t Q').hom))
    (T.map (coefficientLeafMap
      (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
        (envelopingShapeTotalAlgebraInputsMap f g)))
      ((addedAlgebraInputs A).map (envelopingShapeTotalAlgebraInputsMap f g)))) h1
    (envelopingShapeNormalizedEvaluation_naturality O A f g)


end CategoryTheory.Operad.Tensor.Enveloping

end
