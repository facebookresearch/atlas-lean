/-- A derived equality of original carriers and complete operations
gives an actual isomorphism of genuine tensor algebras. -/
def algebraIsoOfCarrierOperations {O : ColoredOperadObj W C} (M N : Algebra O)
    (hc : M.carrier = N.carrier) (ho : HEq M.operations N.operations) : M ≅ N :=
  eqToIso (Algebra.ext_carrier_operations hc ho)

/-- The forward full algebra isomorphism retains precisely the
original carrier equality arrow, independently of operation proofs. -/
theorem algebraIsoOfCarrierOperations_hom {O : ColoredOperadObj W C} (M N : Algebra O)
    (hc : M.carrier = N.carrier) (ho : HEq M.operations N.operations) :
    (algebraIsoOfCarrierOperations M N hc ho).hom.hom = eqToHom hc := by
  cases M with
  | mk M a hu hs =>
    cases N with
    | mk N b ku ks =>
      cases hc
      have h : a = b := eq_of_heq ho
      cases h
      rfl

/-- The inverse full algebra isomorphism retains precisely the
inverse original carrier equality arrow. -/
theorem algebraIsoOfCarrierOperations_inv {O : ColoredOperadObj W C} (M N : Algebra O)
    (hc : M.carrier = N.carrier) (ho : HEq M.operations N.operations) :
    (algebraIsoOfCarrierOperations M N hc ho).inv.hom = eqToHom hc.symm := by
  cases M with
  | mk M a hu hs =>
    cases N with
    | mk N b ku ks =>
      cases hc
      have h : a = b := eq_of_heq ho
      cases h
      rfl

/-- A genuine original operad triangle identifies the whole actual
nested restricted algebra with the direct restricted algebra. -/
theorem restrictionAlgebraTriangle {O P Q : ColoredOperadObj W C}
    (u : O ⟶ P) (v : P ⟶ Q) (w : O ⟶ Q) (h : u ≫ v = w) (M : Algebra Q) :
    Algebra.restrict u (Algebra.restrict v M) = Algebra.restrict w M :=
  Algebra.ext_carrier_operations rfl
    (heq_of_eq (restrictionOperations_triangle u v w h M.operations))


end CategoryTheory.Operad.Tensor.Enveloping

