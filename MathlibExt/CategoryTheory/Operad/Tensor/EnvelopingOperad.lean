/- Exact checked source: WeightedNormalization.EnvelopingNullaryNaturality. -/
section EnvelopingSource364


/-!
# Original genuine algebra carrier maps under the actual enveloping nullary isomorphism
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem nullaryProjectionSquare {D : Type*} [Category* D] {X Y E E' T T' A B : D}
    (πA : X ⟶ E) (πB : Y ⟶ E') (env : E ⟶ E') (linear : X ⟶ Y)
    (eA : E ⟶ A) (eB : E' ⟶ B) (lA : X ⟶ T) (lB : Y ⟶ T')
    (actA : T ⟶ A) (actB : T' ⟶ B) (t : T ⟶ T') (f : A ⟶ B)
    (hπ : πA ≫ env = linear ≫ πB) (hA : πA ≫ eA = lA ≫ actA) (hB : πB ≫ eB = lB ≫ actB)
    (hl : linear ≫ lB = lA ≫ t) (ha : actA ≫ f = t ≫ actB) :
    (πA ≫ env) ≫ eB = (πA ≫ eA) ≫ f := by
  calc
    (πA ≫ env) ≫ eB = (linear ≫ πB) ≫ eB := congrArg (· ≫ eB) hπ
    _ = linear ≫ (lB ≫ actB) := (Category.assoc linear πB eB).trans (congrArg (linear ≫ ·) hB)
    _ = (lA ≫ t) ≫ actB := (Category.assoc linear lB actB).symm.trans (congrArg (· ≫ actB) hl)
    _ = lA ≫ (actA ≫ f) := (Category.assoc lA t actB).trans (congrArg (lA ≫ ·) ha.symm)
    _ = (πA ≫ eA) ≫ f := (Category.assoc lA actA f).symm.trans (congrArg (· ≫ f) hA.symm)

private theorem inverseNullarySquare {D : Type*} [Category* D] {A B X Y : D}
    (e : A ≅ X) (e' : B ≅ Y) (h : A ⟶ B) (g : X ⟶ Y)
    (hn : h ≫ e'.hom = e.hom ≫ g) : e.inv ≫ h = g ≫ e'.inv := by
  apply (cancel_mono e'.hom).1
  rw [Category.assoc, hn, ← Category.assoc e.inv e.hom, e.inv_hom_id, Category.id_comp]
  rw [Category.assoc, e'.inv_hom_id, Category.comp_id]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original nullary isomorphism identifies the actual
enveloping functor map with the original f.hom on genuine algebra carriers. -/
theorem envelopingOperadNullaryIso_naturality (O : ColoredOperadObj W C) {A B : Algebra O}
  (f : A ⟶ B) (d : W) :
    (envelopingOperadMap O f).toCollectionHom.app (ColoredProfile.nullary d) ≫
      (envelopingOperadNullaryIso O B d).hom =
      (envelopingOperadNullaryIso O A d).hom ≫ f.hom d := by
  apply envelopingCoefficient_hom_ext O A (ColoredProfile.nullary d)
  let πA := envelopingCoefficientπ O A (ColoredProfile.nullary d)
  let πB := envelopingCoefficientπ O B (ColoredProfile.nullary d)
  let env := (envelopingOperadMap O f).toCollectionHom.app (ColoredProfile.nullary d)
  let linear := linearCoefficientCarrierLift O.toCollection f.hom (ColoredProfile.nullary d)
  let eA := (envelopingOperadNullaryIso O A d).hom
  let eB := (envelopingOperadNullaryIso O B d).hom
  let lA := (nullaryLinearCoefficientIso O.toCollection A.carrier d).hom
  let lB := (nullaryLinearCoefficientIso O.toCollection B.carrier d).hom
  let t := profileMap O.toCollection f.hom d
  have hπ : πA ≫ env = linear ≫ πB := envelopingOperadMap_projection_app O f
    (ColoredProfile.nullary d)
  have hA : πA ≫ eA = lA ≫ A.action d := envelopingOperadNullaryIso_projection O A d
  have hB : πB ≫ eB = lB ≫ B.action d := envelopingOperadNullaryIso_projection O B d
  have hl : linear ≫ lB = lA ≫ t := nullaryLinearCoefficientIso_carrier O.toCollection f.hom d
  have ha : A.action d ≫ f.hom d = t ≫ B.action d := congrFun (Algebra.action_naturality f) d
  exact (Category.assoc πA env eB).symm.trans
    ((nullaryProjectionSquare πA πB env linear eA eB lA lB (A.action d) (B.action d) t
      (f.hom d) hπ hA hB hl ha).trans
      (Category.assoc πA eA (f.hom d)))

/-- The original genuine algebra carrier map also retains the actual
inverse of the original enveloping nullary isomorphism. -/
theorem envelopingOperadNullaryIso_inv_naturality (O : ColoredOperadObj W C) {A B : Algebra
  O} (f : A ⟶ B) (d : W) :
    (envelopingOperadNullaryIso O A d).inv ≫ (envelopingOperadMap O f).toCollectionHom.app
      (ColoredProfile.nullary d) =
      f.hom d ≫ (envelopingOperadNullaryIso O B d).inv :=
  inverseNullarySquare _ _ _ _ (envelopingOperadNullaryIso_naturality O f d)


end CategoryTheory.Operad.Tensor.Enveloping

end
