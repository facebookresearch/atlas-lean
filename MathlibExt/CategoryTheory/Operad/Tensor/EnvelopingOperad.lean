    combinedInputBlocks I K L ⟶ combinedInputBlocks I K' L' where
  equiv := Equiv.refl I
  hom i := coefficientLeafMap (k i) (l i)

/-- The original coefficient/input block bijection commutes with
each original coefficient map and each original retained input map. -/
theorem coefficientBlockInterchangeFamilyIso_naturality (I : FintypeCat.{0})
    {K K' : I → C} {L L' : I → FiniteFamily C} (k : ∀ i, K i ⟶ K' i) (l : ∀ i, L i ⟶ L' i) :
    (FiniteFamily.flatten (C := C)).map (combinedInputBlockMap I k l) ≫
        (coefficientBlockInterchangeFamilyIso I K' L').hom =
      (coefficientBlockInterchangeFamilyIso I K L).hom ≫ (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (coefficientBlockMap I k)
          ((FiniteFamily.flatten (C := C)).map (inputBlockMap I l))) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases j with
    | none =>
      change HEq (k i ≫ 𝟙 _) (𝟙 _ ≫ k i)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some j =>
      change HEq ((l i).hom j ≫ 𝟙 _) (𝟙 _ ≫ (l i).hom j)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

private theorem originalThreeInterchangeSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable [FiniteTensor C]

/-- The map of weighted input blocks obtained by tensoring the combined coefficient and leaf
maps. -/
def weightedInputBlockMap (I : FintypeCat.{0}) {K K' : I → C} {L L' : I → FiniteFamily C}
    (k : ∀ i, K i ⟶ K' i) (l : ∀ i, L i ⟶ L' i) :
    weightedInputBlockFamily I K L ⟶ weightedInputBlockFamily I K' L' :=
  (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (combinedInputBlockMap I k l)

/-- Original tensor block interchange is natural in all original
coefficient/input morphisms, including empty blocks and all original
permutations internal to the finite input families. -/
theorem coefficientBlockInterchangeTensorIso_naturality (I : FintypeCat.{0})
    {K K' : I → C} {L L' : I → FiniteFamily C} (k : ∀ i, K i ⟶ K' i) (l : ∀ i, L i ⟶ L' i) :
    (FiniteTensor.tensor (V := C)).map (weightedInputBlockMap I k l) ≫
        (coefficientBlockInterchangeTensorIso I K' L').hom =
      (coefficientBlockInterchangeTensorIso I K L).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (coefficientBlockMap I k))
            ((FiniteFamily.flatten (C := C)).map (inputBlockMap I l))) := by
  let T := FiniteTensor.tensor (V := C)
  let c := combinedInputBlockMap I k l
  let g := (FiniteFamily.flatten (C := C)).map (inputBlockMap I l)
  let f := coefficientBlockMap I k
  let n := coefficientLeavesNestedMap f g
  have h1 := (FiniteTensor.flattenIso (V := C)).inv.naturality c
  have h2 : T.map ((FiniteFamily.flatten (C := C)).map c) ≫
    T.map (coefficientBlockInterchangeFamilyIso I K' L').hom =
      T.map (coefficientBlockInterchangeFamilyIso I K L).hom ≫
        T.map ((FiniteFamily.flatten (C := C)).map n) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (coefficientBlockInterchangeFamilyIso_naturality I k l)).trans
        (T.map_comp _ _))
  have h3 : T.map ((FiniteFamily.flatten (C := C)).map n) ≫
        (coefficientLeavesNormalizationIso (coefficientBlockFamily I K') (totalBlockInputs I
          L')).hom =
      (coefficientLeavesNormalizationIso (coefficientBlockFamily I K) (totalBlockInputs I L)).hom ≫
        T.map (coefficientLeafMap (T.map f) g) := by
    rw [coefficientLeavesNormalizationIso_hom, coefficientLeavesNormalizationIso_hom]
    exact coefficientLeavesNormalization_naturality f g
  exact originalThreeInterchangeSquares (T.map (weightedInputBlockMap I k l))
    ((FiniteTensor.flattenIso (V := C)).inv.app (combinedInputBlocks I K L))
    ((FiniteTensor.flattenIso (V := C)).inv.app (combinedInputBlocks I K' L'))
    (T.map ((FiniteFamily.flatten (C := C)).map c))
    (T.map (coefficientBlockInterchangeFamilyIso I K L).hom)
    (T.map (coefficientBlockInterchangeFamilyIso I K' L').hom)
    (T.map ((FiniteFamily.flatten (C := C)).map n))
    ((coefficientLeavesNormalizationIso (coefficientBlockFamily I K) (totalBlockInputs I L)).hom)
    ((coefficientLeavesNormalizationIso (coefficientBlockFamily I K') (totalBlockInputs I L')).hom)
    (T.map (coefficientLeafMap (T.map f) g)) h1 h2 h3


