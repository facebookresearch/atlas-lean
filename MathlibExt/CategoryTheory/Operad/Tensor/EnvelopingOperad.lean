/-!
# Genuine tensor operations descended through the original coefficient quotients
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive.AlgebraDescent

open CategoryTheory Limits Tensor

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)

/-- A genuine Q-algebra is balanced when its two original restricted
P-operation families are identical, on its unchanged carrier. -/
def Balanced (A : Tensor.Algebra Q) : Prop :=
  Restriction.operations f A.operations = Restriction.operations g A.operations

variable [HasColimitsOfSize.{us, us} C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]
variable (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)

/-- Tensor the actual original coefficient reflexive coequalizer
with an unchanged finite family of actual carrier input objects. -/
def coefficientTensorIsColimit (L : FiniteFamily C) (s : ColoredProfile W) :
    IsColimit ((coefficientLeafTensorFunctor L).mapCocone (coefficientCocone f g t hf hg s)) := by
  letI : PreservesColimitsOfSize.{0, 0} (coefficientLeafTensorFunctor L) :=
    preservesSmallestColimits_of_preservesColimits (coefficientLeafTensorFunctor L)
  exact isColimitOfPreserves (coefficientLeafTensorFunctor L) (coefficientIsColimit f g t hf hg s)

include t hf hg in
/-- The original coefficient projection remains epic with the original leaves retained. -/
theorem coefficientTensorEpi (L : FiniteFamily C) (s : ColoredProfile W) :
    Epi ((coefficientLeafTensorFunctor L).map (coefficientπ f g s)) := by
  let F := coefficientLeafTensorFunctor L
  let c := F.mapCocone (coefficientCocone f g t hf hg s)
  have hc := (ReflexiveCofork.isColimitEquiv (coefficientDiagram f g t hf hg s ⋙ F) c).symm
    (coefficientTensorIsColimit f g t hf hg L s)
  exact Cofork.IsColimit.epi hc

/-- Descend an original tensor operation through its actual coefficient quotient. -/
def coefficientTensorDesc (L : FiniteFamily C) (s : ColoredProfile W) {Y : C}
    (a : (coefficientLeafTensorFunctor L).obj (Q.toCollection.obj s) ⟶ Y)
    (balance : (coefficientLeafTensorFunctor L).map (f.toCollectionHom.app s) ≫ a =
      (coefficientLeafTensorFunctor L).map (g.toCollectionHom.app s) ≫ a) :
    (coefficientLeafTensorFunctor L).obj (coefficient f g s) ⟶ Y :=
  (coefficientTensorIsColimit f g t hf hg L s).desc (ReflexiveCofork.mk a balance)

@[reassoc (attr := simp)]
theorem coefficientTensorDesc_beta (L : FiniteFamily C) (s : ColoredProfile W) {Y : C}
    (a : (coefficientLeafTensorFunctor L).obj (Q.toCollection.obj s) ⟶ Y)
    (balance : (coefficientLeafTensorFunctor L).map (f.toCollectionHom.app s) ≫ a =
      (coefficientLeafTensorFunctor L).map (g.toCollectionHom.app s) ≫ a) :
    (coefficientLeafTensorFunctor L).map (coefficientπ f g s) ≫
      coefficientTensorDesc f g t hf hg L s a balance = a :=
  (coefficientTensorIsColimit f g t hf hg L s).fac (ReflexiveCofork.mk a balance)
    WalkingReflexivePair.zero

/-- The original coefficient-and-leaf tensor identifies with the actual
analytic summand by identity maps in each original coefficient/input slot. -/
def coefficientAnalyticIso (O : ColoredSymmetricCollection W C) (M : W → C)
    {d : W} (q : AnalyticIndex W d) :
    (coefficientLeafTensorFunctor ((analyticInputFamily M).obj q)).obj (O.obj q.toColoredProfile) ≅
      (analyticSummand O M).obj q :=
  (FiniteTensor.tensor (V := C)).mapIso
    (FiniteFamily.isoOfComponents (Equiv.refl (Option q.inputs))
      (fun i => match i with | none => Iso.refl _ | some _ => Iso.refl _))

omit [HasColimitsOfSize.{us, us} C] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- The analytic comparison retains the original coefficient map and unchanged inputs. -/
theorem coefficientAnalyticIso_naturality {O O' : ColoredSymmetricCollection W C} (h : O ⟶ O')
    (M : W → C) {d : W} (q : AnalyticIndex W d) :
    (coefficientLeafTensorFunctor ((analyticInputFamily M).obj q)).map (h.app q.toColoredProfile) ≫
        (coefficientAnalyticIso O' M q).hom =
      (coefficientAnalyticIso O M q).hom ≫ (analyticSummandCollectionMap M h).app q := by
  let T := FiniteTensor.tensor (V := C)
  apply (T.map_comp _ _).symm.trans
  apply (congrArg T.map ?_).trans (T.map_comp _ _)
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

