/- Exact checked source: ReflexiveOperad.UnitBlockReadback. -/
section EnvelopingSource238


/-!
# Literal unit and retained-coefficient readbacks of the original block unit map
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary.UnitBlocks

open CategoryTheory

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original global unit index goes to its original block and unit position. -/
theorem globalMap_unit_equiv (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i)
    (i : N.index) (j : J i) :
    (blockUnitGlobalMap N J M f).equiv (Sum.inl ⟨i, j⟩) = ⟨i, (f i).equiv (Sum.inl j)⟩ := rfl

/-- The original retained coefficient index goes to its original block and coefficient position. -/
theorem globalMap_coefficient_equiv (N : FiniteFamily (FiniteFamily C)) (J : N.index →
  FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i)
    (i : N.index) (j : (N.obj i).index) :
    (blockUnitGlobalMap N J M f).equiv (Sum.inr ⟨i, j⟩) = ⟨i, (f i).equiv (Sum.inr j)⟩ := rfl

/-- The actual global unit map uses precisely its original supplied local unit map. -/
theorem globalMap_unit_hom (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i)
    (i : N.index) (j : J i) :
    (blockUnitGlobalMap N J M f).hom (Sum.inl ⟨i, j⟩) = (f i).hom (Sum.inl j) := by
  let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
  exact (congrArg (fun k : U ⟶ U => k ≫ (f i).hom (Sum.inl j)) (Category.id_comp (𝟙 U))).trans
    (Category.id_comp ((f i).hom (Sum.inl j)))

/-- The actual global retained coefficient map uses precisely its original local map. -/
theorem globalMap_coefficient_hom (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i)
    (i : N.index) (j : (N.obj i).index) :
    (blockUnitGlobalMap N J M f).hom (Sum.inr ⟨i, j⟩) = (f i).hom (Sum.inr j) := by
  let X := (N.obj i).obj j
  exact (congrArg (fun k : X ⟶ X => k ≫ (f i).hom (Sum.inr j)) (Category.id_comp (𝟙 X))).trans
    (Category.id_comp ((f i).hom (Sum.inr j)))

/-- Original unit-position relabeling before the global block map
retains precisely the original local unit coefficient map. -/
theorem relabeledGlobal_unit_hom {I : FintypeCat.{0}} {L : FiniteFamily C}
    (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i)
    (e : I ≃ blockUnitIndex N J) (z : L ⟶ (FiniteFamily.flatten (C := C)).obj N) (i : I) :
    (Variable.unitFamilyMap e z ≫ blockUnitGlobalMap N J M f).hom (Sum.inl i) =
      (f (e i).1).hom (Sum.inl (e i).2) := by
  let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
  change 𝟙 U ≫ (blockUnitGlobalMap N J M f).hom (Sum.inl (e i)) = _
  exact (Category.id_comp _).trans (globalMap_unit_hom N J M f (e i).1 (e i).2)

/-- Original retained coefficient relabeling before the global block
map uses its whole original coefficient map and original local map. -/
theorem relabeledGlobal_coefficient_hom {I : FintypeCat.{0}} {L : FiniteFamily C}
    (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i)
    (e : I ≃ blockUnitIndex N J) (z : L ⟶ (FiniteFamily.flatten (C := C)).obj N) (i : L.index) :
    (Variable.unitFamilyMap e z ≫ blockUnitGlobalMap N J M f).hom (Sum.inr i) =
      z.hom i ≫ (f (z.equiv i).1).hom (Sum.inr (z.equiv i).2) := by
  change z.hom i ≫ (blockUnitGlobalMap N J M f).hom (Sum.inr (z.equiv i)) = _
  exact congrArg (z.hom i ≫ ·) (globalMap_coefficient_hom N J M f (z.equiv i).1 (z.equiv i).2)


end CategoryTheory.Operad.Tensor.Enveloping.DisjointNullary.UnitBlocks

end
