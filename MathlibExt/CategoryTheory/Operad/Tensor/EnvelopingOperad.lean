        (envelopingRepresentativeCoefficients O (d.localData i) (Q.branch i)).obj L).hom
      let p := T.map (coefficientLeafMap
        (𝟙 (T.obj (envelopingRepresentativeCoefficients O (d.localData i) (Q.branch i)))) m)
      let n₀ := (coefficientBlockInterchangeTensorIso I
        (fun j => O.obj (extendProfile (envelopingSlotProfile (d.localData i) j) (Q.branch i
          j))) L).hom
