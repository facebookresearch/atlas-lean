  index := FintypeCat.of (Option d.branches.index)
  obj
    | none => (FiniteFamily.singleton (C := ColoredProfile W)).obj d.middleData.outerProfile
    | some i => (d.localData i).factorFamily

/-- The same original factors arranged in grouping B. -/
def groupingBProfiles (d : ColoredAssocData W) : FiniteFamily (FiniteFamily (ColoredProfile
  W)) where
  index := FintypeCat.of (Option d.middleData.totalProfile.inputs)
  obj
    | none => d.middleData.factorFamily
    | some p => (FiniteFamily.singleton (C := ColoredProfile W)).obj (d.innerData.inner.obj p)

variable {A B : ColoredSymmetricCollection W C} (α : A ⟶ B)

/-- Apply a collection map in every original grouping-A factor. -/
def groupingAHom (d : ColoredAssocData W) : AssocInsertion.groupingA A d ⟶
  AssocInsertion.groupingA B d :=
  { equiv := Equiv.refl _
    hom := fun o => match o with
      | none => (FiniteFamily.singleton (C := C)).map (α.app d.middleData.outerProfile)
      | some i => HomData.factorHom α (d.localData i) }

/-- Apply a collection map in every original grouping-B factor. -/
def groupingBHom (d : ColoredAssocData W) : AssocInsertion.groupingB A d ⟶
  AssocInsertion.groupingB B d :=
  { equiv := Equiv.refl _
    hom := fun o => match o with
      | none => HomData.factorHom α d.middleData
      | some p => (FiniteFamily.singleton (C := C)).map (α.app (d.innerData.inner.obj p)) }

/-- The original flattened grouping-A factor map. -/
def flattenedAHom (d : ColoredAssocData W) :
    AssocInsertion.flattenedGroupingA A d ⟶ AssocInsertion.flattenedGroupingA B d :=
  (FiniteFamily.flatten (C := C)).map (groupingAHom α d)

/-- The original flattened grouping-B factor map. -/
def flattenedBHom (d : ColoredAssocData W) :
    AssocInsertion.flattenedGroupingB A d ⟶ AssocInsertion.flattenedGroupingB B d :=
  (FiniteFamily.flatten (C := C)).map (groupingBHom α d)

/-- Identify the original flattened profile family evaluation by
the identity in each original coefficient slot. -/
def flattenedAComparison (A : ColoredSymmetricCollection W C) (d : ColoredAssocData W) :
    (FiniteFamily.map A).obj ((FiniteFamily.flatten (C := ColoredProfile W)).obj
      (groupingAProfiles d)) ≅
      AssocInsertion.flattenedGroupingA A d :=
  FiniteFamily.isoOfComponents
    { toFun := fun x => match x with
        | ⟨none, j⟩ => ⟨none, j⟩
        | ⟨some i, none⟩ => ⟨some i, none⟩
        | ⟨some i, some j⟩ => ⟨some i, some j⟩
      invFun := fun x => match x with
        | ⟨none, j⟩ => ⟨none, j⟩
        | ⟨some i, none⟩ => ⟨some i, none⟩
        | ⟨some i, some j⟩ => ⟨some i, some j⟩
      left_inv := fun x => by
        rcases x with ⟨o, j⟩
        cases o with
        | none => cases j; rfl
        | some i => cases j <;> rfl
      right_inv := fun x => by
        rcases x with ⟨o, j⟩
        cases o with
        | none => cases j; rfl
        | some i => cases j <;> rfl }
    (fun x => match x with
      | ⟨none, _⟩ => Iso.refl _
      | ⟨some _, none⟩ => Iso.refl _
      | ⟨some _, some _⟩ => Iso.refl _)

/-- The comparison retains every original collection component. -/
theorem flattenedAHom_readback (d : ColoredAssocData W) :
