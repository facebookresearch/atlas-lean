/- Exact checked source: EnvelopingAssociativityExpandedGrouping. -/
section EnvelopingSource068


/-!
# Actual expanded coefficient grouping for original root-first association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original middle coefficient family with the actual
outer unary unit at each retained root algebra input. -/
def envelopingAssocExpandedMiddleFamily (O : ColoredSymmetricCollection W C) (d :
  ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily C where
  index := FintypeCat.of (Option (d.branches.index ⊕ Q.root.index))
  obj i := match i with
    | none => O.obj (extendProfile d.middleData.outerProfile Q.root)
    | some (Sum.inl i) => O.obj (extendProfile (d.localData i).outerProfile (Q.branch i none))
    | some (Sum.inr _) => (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty

/-- The original innermost coefficient at its actual flat
middle-profile position, including retained middle and root units. -/
def envelopingAssocExpandedInnerCoefficient (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (p : (envelopingRepresentativeAssoc d Q).middleData.totalProfile.inputs) : C :=
  match p with
  | ⟨Sum.inl i, Sum.inl j⟩ => O.obj (extendProfile ((d.localData i).inner.obj j)
    (Q.branch i (some j)))
  | ⟨Sum.inl _, Sum.inr _⟩ => (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty
  | ⟨Sum.inr _, _⟩ => (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty

/-- The actual expanded original grouping B has the root/middle
coefficient block first and the original innermost/unit singleton
blocks at every original flat middle input. -/
def envelopingAssocExpandedGroupingB (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option (envelopingRepresentativeAssoc d Q).middleData.totalProfile.inputs)
  obj i := match i with
    | none => envelopingAssocExpandedMiddleFamily O d Q
    | some p => (FiniteFamily.singleton (C := C)).obj
      (envelopingAssocExpandedInnerCoefficient O d Q p)

/-- The actual expanded grouping A retains each branch's
original middle-algebra unit factors alongside its original coefficients. -/
def envelopingAssocExpandedGroupingA (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := (envelopingAssocNestedUnitBlocks O d Q).index
  obj i := match i with
    | none => (envelopingAssocNestedUnitBlocks O d Q).obj none
    | some (Sum.inl i) => frozenVariableUnitFamily (Q.branch i none).index
        (envelopingRepresentativeCoefficients O (d.localData i) (Q.branch i))
    | some (Sum.inr _) => retainedRootUnitFamily (C := C)

/-- The exact original expanded coefficient positions map from
root/branch grouping A to actual root/middle/inner grouping B,
retaining both original root unary-unit coefficients. -/
def envelopingAssocExpandedGroupingEquiv (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ((FiniteFamily.flatten (C := C)).obj (envelopingAssocExpandedGroupingA O d Q)).index ≃
      ((FiniteFamily.flatten (C := C)).obj (envelopingAssocExpandedGroupingB O d Q)).index where
  toFun p := match p with
    | ⟨none, _⟩ => ⟨none, none⟩
    | ⟨some (Sum.inl i), Sum.inl j⟩ => ⟨some ⟨Sum.inl i, Sum.inr j⟩, PUnit.unit⟩
    | ⟨some (Sum.inl i), Sum.inr none⟩ => ⟨none, some (Sum.inl i)⟩
    | ⟨some (Sum.inl i), Sum.inr (some j)⟩ => ⟨some ⟨Sum.inl i, Sum.inl j⟩, PUnit.unit⟩
    | ⟨some (Sum.inr j), none⟩ => ⟨none, some (Sum.inr j)⟩
    | ⟨some (Sum.inr j), some _⟩ => ⟨some ⟨Sum.inr j, PUnit.unit⟩, PUnit.unit⟩
  invFun p := match p with
    | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
    | ⟨none, some (Sum.inl i)⟩ => ⟨some (Sum.inl i), Sum.inr none⟩
    | ⟨none, some (Sum.inr j)⟩ => ⟨some (Sum.inr j), none⟩
    | ⟨some ⟨Sum.inl i, Sum.inl j⟩, _⟩ => ⟨some (Sum.inl i), Sum.inr (some j)⟩
    | ⟨some ⟨Sum.inl i, Sum.inr j⟩, _⟩ => ⟨some (Sum.inl i), Sum.inl j⟩
    | ⟨some ⟨Sum.inr j, _⟩, _⟩ => ⟨some (Sum.inr j), some PUnit.unit⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i => cases i with
      | inl i => cases j with
        | inl j => rfl
        | inr j => cases j <;> rfl
      | inr i => cases j with
        | none => rfl
        | some j => cases j; rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none => rfl
      | some j => cases j <;> rfl
    | some p =>
      rcases p with ⟨i, k⟩
      cases i with
      | inl i => cases k with
        | inl k => cases j; rfl
        | inr k => cases j; rfl
      | inr i => cases k; cases j; rfl

/-- The exact original expanded A-to-B coefficient bijection
retains every original operation object and every original tensor unit. -/
def envelopingAssocExpandedGroupingIso (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).obj (envelopingAssocExpandedGroupingA O d Q) ≅
      (FiniteFamily.flatten (C := C)).obj (envelopingAssocExpandedGroupingB O d Q) :=
  FiniteFamily.isoOfComponents (envelopingAssocExpandedGroupingEquiv O d Q) (fun p => match p with
    | ⟨none, _⟩ => Iso.refl _
    | ⟨some (Sum.inl _), Sum.inl _⟩ => Iso.refl _
    | ⟨some (Sum.inl _), Sum.inr none⟩ => Iso.refl _
    | ⟨some (Sum.inl _), Sum.inr (some _)⟩ => Iso.refl _
    | ⟨some (Sum.inr _), none⟩ => Iso.refl _
    | ⟨some (Sum.inr _), some _⟩ => Iso.refl _)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource068

/- Exact checked source: EnvelopingAssociativityExpandedCoefficientMaps. -/
section EnvelopingSource069


/-!
# Actual original unit/coefficient maps respect expanded association grouping
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The expanded grouping A maps to the original operad
association grouping by actual root/profile maps and actual
operadic units at every retained original algebra input. -/
def envelopingAssocExpandedMapA (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocExpandedGroupingA O.toCollection d Q ⟶
      ColoredOperadObj.AssocInsertion.groupingA O.toCollection
        (envelopingRepresentativeAssoc d Q) where
  equiv := Equiv.refl (Option (d.branches.index ⊕ Q.root.index))
  hom i := match i with
    | none => (FiniteFamily.singleton (C := C)).map (O.toCollection.map
      (envelopingAssocRootHom d Q))
    | some (Sum.inl i) => envelopingRepresentativeUnitMap O (d.localData i) (Q.branch i)
    | some (Sum.inr j) => retainedRootUnitFamilyMap O (Q.root.obj j).as

/-- The actual expanded middle coefficient block maps to the
original full middle substitution factor family. -/
def envelopingAssocExpandedMiddleMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocExpandedMiddleFamily O.toCollection d Q ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj
        (envelopingRepresentativeAssoc d Q).middleData where
  equiv := Equiv.refl (Option (d.branches.index ⊕ Q.root.index))
  hom i := match i with
    | none => O.toCollection.map (envelopingAssocRootHom d Q)
    | some (Sum.inl i) => O.toCollection.map (envelopingRepresentativeOuterHom (d.localData
      i) (Q.branch i))
    | some (Sum.inr j) => O.unit (Q.root.obj j).as

/-- Every actual expanded innermost coefficient maps to its
original profile; retained root/middle algebra coefficients use
their actual original operadic units. -/
def envelopingAssocExpandedInnerMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) (p : (envelopingRepresentativeAssoc d
      Q).middleData.totalProfile.inputs) :
    envelopingAssocExpandedInnerCoefficient O.toCollection d Q p ⟶
      O.toCollection.obj ((envelopingRepresentativeAssoc d Q).innerData.inner.obj p) :=
  match p with
  | ⟨Sum.inl _, Sum.inl _⟩ => 𝟙 _
  | ⟨Sum.inl i, Sum.inr j⟩ => O.unit ((Q.branch i none).obj j).as
  | ⟨Sum.inr j, _⟩ => O.unit (Q.root.obj j).as

/-- The expanded grouping B maps to the original operad
association grouping with all original coefficient/unit maps. -/
def envelopingAssocExpandedMapB (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocExpandedGroupingB O.toCollection d Q ⟶
      ColoredOperadObj.AssocInsertion.groupingB O.toCollection
        (envelopingRepresentativeAssoc d Q) where
  equiv := Equiv.refl (Option (envelopingRepresentativeAssoc d Q).middleData.totalProfile.inputs)
  hom i := match i with
    | none => envelopingAssocExpandedMiddleMap O d Q
    | some p => (FiniteFamily.singleton (C := C)).map (envelopingAssocExpandedInnerMap O d Q p)

/-- The exact original expanded A-to-B position bijection
commutes with every original operation coefficient, unary unit,
root profile comparison and original dependent input position. -/
theorem envelopingAssocExpandedCoefficient_square (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).map (envelopingAssocExpandedMapA O d Q) ≫
        ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom O.toCollection
          (envelopingRepresentativeAssoc d Q) =
      (envelopingAssocExpandedGroupingIso O.toCollection d Q).hom ≫
        (FiniteFamily.flatten (C := C)).map (envelopingAssocExpandedMapB O d Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases i with
      | inl i => cases j with
        | inl j => rfl
        | inr j => cases j <;> rfl
      | inr i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i => cases i with
      | inl i => cases j with
        | inl j => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
        | inr j => cases j with
          | none => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
          | some j => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
      | inr i => cases j with
        | none => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
        | some j => exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource069

/- Exact checked source: EnvelopingAssociativityExpandedInput. -/
section EnvelopingSource070


/-!
# Actual source tensor insertion into the expanded association coefficient family
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original branch receives exactly its middle-algebra
tensor-unit factors before original operadic unit maps are applied. -/
def envelopingAssocExpandBranchTensorMap (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (envelopingAssocNestedUnitBlocks O d Q) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (envelopingAssocExpandedGroupingA O d Q) where
  equiv := Equiv.refl (Option (d.branches.index ⊕ Q.root.index))
  hom i := match i with
    | none => 𝟙 _
    | some (Sum.inl i) => (frozenVariableTensorUnitIso (Q.branch i none).index
        (envelopingRepresentativeCoefficients O (d.localData i) (Q.branch i))).hom
    | some (Sum.inr _) => 𝟙 _

/-- Original tensor-unit insertion followed by the original
unit/profile coefficient maps gives the actual original nested factors. -/
theorem envelopingAssocExpandBranchTensorMap_factors (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocExpandBranchTensorMap O.toCollection d Q ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (envelopingAssocExpandedMapA O d Q) =
      envelopingAssocNestedFactorsMap O d Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some i => cases i with
      | inl i => exact HEq.rfl
      | inr j => exact heq_of_eq (Category.id_comp _)

/-- The actual original nested coefficient and root-unit source
maps to the complete expanded coefficient family before any
original operadic associativity contraction. -/
def envelopingAssocExpandedInput (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O d Q) ⟶
      (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.flatten (C := C)).obj (envelopingAssocExpandedGroupingA O d Q)) :=
  envelopingAssocNestedUnitSource O d Q ≫
    (FiniteTensor.tensor (V := C)).map (envelopingAssocExpandBranchTensorMap O d Q) ≫
    (FiniteTensor.flattenIso (V := C)).inv.app (envelopingAssocExpandedGroupingA O d Q)

private theorem originalExpandedSourceComparison {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (a : A ⟶ B) (e : D ≅ B) (f : D ⟶ E)
    (q : B ⟶ Y) (h : E ≅ Y) (b : A ⟶ Y)
    (hn : f ≫ h.hom = e.hom ≫ q) (hb : a ≫ q = b) :
    (p ≫ a ≫ e.inv) ≫ f = (p ≫ b) ≫ h.inv := by
  apply (cancel_mono h.hom).1
  simp only [Category.assoc]
  rw [hn]
  simp only [Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
  rw [hb]

/-- The actual expanded source followed by the original unit
and profile coefficient map is exactly the original nested common source. -/
theorem envelopingAssocExpandedInput_commonSource (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocExpandedInput O.toCollection d Q ≫
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C :=
          C)).map (envelopingAssocExpandedMapA O d Q)) =
      envelopingAssocNestedCommonSource O d Q := by
  let T := FiniteTensor.tensor (V := C)
  let p := envelopingAssocNestedUnitSource O.toCollection d Q
  let a := T.map (envelopingAssocExpandBranchTensorMap O.toCollection d Q)
  let e := (FiniteTensor.flattenIso (V := C)).app (envelopingAssocExpandedGroupingA
    O.toCollection d Q)
  let f := T.map ((FiniteFamily.flatten (C := C)).map (envelopingAssocExpandedMapA O d Q))
  let q := T.map ((FiniteFamily.map T).map (envelopingAssocExpandedMapA O d Q))
  let h := (FiniteTensor.flattenIso (V := C)).app
    (ColoredOperadObj.AssocInsertion.groupingA O.toCollection (envelopingRepresentativeAssoc d Q))
  let b := T.map (envelopingAssocNestedFactorsMap O d Q)
  have hn : f ≫ h.hom = e.hom ≫ q := (FiniteTensor.flattenIso (V := C)).hom.naturality
    (envelopingAssocExpandedMapA O d Q)
  have hb : a ≫ q = b := (T.map_comp _ _).symm.trans
    (congrArg T.map (envelopingAssocExpandBranchTensorMap_factors O d Q))
  have hr : envelopingAssocNestedCommonSource O d Q = p ≫ (b ≫ h.inv) := rfl
  exact (originalExpandedSourceComparison p a e f q h b hn hb).trans
    ((Category.assoc p b h.inv).trans hr.symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource070

