/-!
# Exact original profile comparison for inner-first enveloping association
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- Original contracted branch totals map to their actual
extended branch profiles; original retained root algebra inputs
use the exact original unary dependent-product collapse. -/
def envelopingAssocOuterComparisonInner (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).outerAfterInnerData.inner ⟶
      (envelopingRepresentativeSubstitution d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q)).inner where
  equiv := Equiv.refl (d.branches.index ⊕ Q.root.index)
  hom i := match i with
    | Sum.inl i => envelopingRepresentativeTotalHom (d.localData i) (Q.branch i)
    | Sum.inr _j =>
      { inputEquiv := Equiv.sigmaPUnit PUnit
        inputColor_eq _ := rfl
        outputColor_eq := rfl }

/-- The original inner-first contraction and the actual outer
representative substitution are related by their original complete profile map. -/
def envelopingAssocOuterComparison (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).outerAfterInnerData ⟶
      envelopingRepresentativeSubstitution d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q) where
  outputColor_eq := rfl
  innerHom := envelopingAssocOuterComparisonInner d Q

/-- The exact original outer profile comparison keeps the
original root algebra inputs and actual contracted branch output colors. -/
theorem envelopingAssocOuterComparison_outer (d : ColoredAssocData W) (Q :
  EnvelopingAssocChoices d) :
    ColoredSubstitutionData.outerProfileMap (envelopingAssocOuterComparison d Q) =
      (ColoredProfile.Hom.symm (envelopingAssocRootHom d Q)) ≫
        envelopingRepresentativeOuterHom d.outerAfterInnerData (envelopingAssocOuterChoices
          d Q) := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The actual outer route's total profile map is the original
full three-level variable/algebra-input bijection, preserving every original strand. -/
theorem envelopingAssocOuterComparison_total (d : ColoredAssocData W) (Q :
  EnvelopingAssocChoices d) :
    ColoredSubstitutionData.totalProfileMap (envelopingAssocOuterComparison d Q) ≫
        envelopingRepresentativeTotalHom d.outerAfterInnerData (envelopingAssocOuterChoices d Q) =
      envelopingAssocTotalHom d Q := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i =>
    rcases j with ⟨j, k⟩
    cases j with
    | inl j => cases k <;> rfl
    | inr j => rfl
  | inr i => rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
