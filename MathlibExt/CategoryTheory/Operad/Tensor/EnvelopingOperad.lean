/- Exact checked source: EnvelopingAssociativityRootFirstCoreSource. -/
section EnvelopingSource091


/-!
# Original retained root-first tensor blocks and final coefficient/unit source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem coreTensorIdentitySquare {V : Type*} [Category* V] {D : Type*} [Category* D]
    (T : V ⥤ D) (X : V) {Y : D} (f : T.obj X ⟶ Y) :
    T.map (𝟙 X) ≫ f = 𝟙 (T.obj X) ≫ f := congrArg (· ≫ f) (T.map_id X)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Original empty algebra-unit blocks and actual retained
root-first coefficient blocks, in the same displayed finite positions. -/
def envelopingAssocRootFirstCoreBlocksIso (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    emptyAndRetainedBlocks (envelopingAssocInnerRootInputs d Q).index
        (envelopingAssocRootFirstCoefficientBlocks O d Q) ≅
      envelopingAssocRootFirstRetainedBlocks O d Q :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | Sum.inl (Sum.inl j) => some ⟨Sum.inr j, PUnit.unit⟩
        | Sum.inl (Sum.inr ⟨i, j⟩) => some ⟨Sum.inl i, Sum.inr j⟩
        | Sum.inr none => none
        | Sum.inr (some ⟨i, j⟩) => some ⟨Sum.inl i, Sum.inl j⟩
      invFun p := match p with
        | none => Sum.inr none
        | some ⟨Sum.inl i, Sum.inl j⟩ => Sum.inr (some ⟨i, j⟩)
        | some ⟨Sum.inl i, Sum.inr j⟩ => Sum.inl (Sum.inr ⟨i, j⟩)
        | some ⟨Sum.inr j, _⟩ => Sum.inl (Sum.inl j)
      left_inv p := by cases p with
        | inl p => cases p <;> rfl
        | inr p => cases p <;> rfl
      right_inv p := by cases p with
        | none => rfl
        | some p => rcases p with ⟨i, j⟩; cases i with
          | inl i => cases j <;> rfl
          | inr i => cases j; rfl }
    (fun p => match p with
      | Sum.inl (Sum.inl _) => Iso.refl _
      | Sum.inl (Sum.inr _) => Iso.refl _
      | Sum.inr none => Iso.refl _
      | Sum.inr (some _) => Iso.refl _)

/-- Original root-first coefficient-block flattening retains
the exact original coefficient positions through its actual
empty algebra-block bijection. -/
def envelopingAssocRootFirstCoreFlattenIso (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstRetainedBlocks O d Q) ≅
      (FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstCoefficientBlocks O d Q) :=
  (FiniteFamily.flatten (C := C)).mapIso (envelopingAssocRootFirstCoreBlocksIso O d Q).symm ≪≫
    emptyAndRetainedFlattenIso (envelopingAssocInnerRootInputs d Q).index
      (envelopingAssocRootFirstCoefficientBlocks O d
      Q)

/-- The actual tensor-family map of empty algebra blocks and
original retained coefficient blocks is the actual final source
unit/coefficient factor map through its exact original position bijection. -/
theorem envelopingAssocRootFirstCoreTensorMap (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map
      (envelopingAssocRootFirstCoreBlocksIso O.toCollection d Q).hom
      ≫
      envelopingAssocRootFirstFinalFactorsMap O d Q =
    (emptyAndRetainedTensorIso (envelopingAssocInnerRootInputs d Q).index
      (envelopingAssocRootFirstCoefficientBlocks O.toCollection d Q)).hom ≫
      Variable.unitFamilyMap (Equiv.refl (envelopingAssocInnerRootInputs d Q).index)
        (envelopingAssocRootFirstContractionMap O d Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl p => cases p <;> rfl
    | inr p => cases p <;> rfl
  · intro p
    cases p with
    | inl p =>
      cases p with
      | inl p =>
        exact heq_of_eq (coreTensorIdentitySquare (FiniteTensor.tensor (V :=
        C)) (FiniteFamily.empty :
        FiniteFamily C) (𝟙 _))
      | inr p =>
        exact heq_of_eq (coreTensorIdentitySquare (FiniteTensor.tensor (V :=
        C)) (FiniteFamily.empty :
        FiniteFamily C) (𝟙 _))
    | inr p =>
      cases p with
      | none => exact heq_of_eq (coreTensorIdentitySquare (FiniteTensor.tensor (V := C))
          (envelopingRepresentativeCoefficients O.toCollection d.middleData
            (envelopingAssocMiddleChoices d Q))
          (envelopingAssocMiddleCoefficientSubstitution O d Q))
      | some p => exact heq_of_eq (coreTensorIdentitySquare (FiniteTensor.tensor (V := C))
          ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj
            (extendProfile ((d.localData p.1).inner.obj p.2) (Q.branch p.1 (some p.2)))))
          ((FiniteTensor.singletonIso (V := C)).hom.app _))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource091

/- Exact checked source: EnvelopingAssociativityRootFirstCoreLaw. -/
section EnvelopingSource092


/-!
# Actual original core tensor source of root-first representative substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalCoreSourceFiring {V : Type*} [Category* V]
    {X A B D E F G H Y : V} (p : X ⟶ A) (a : A ⟶ B) (k : B ⟶ Y)
    (q : X ⟶ D) (n : D ⟶ A) (b : D ⟶ E) (t : E ⟶ B) (j : E ⟶ F) (v : F ⟶ Y)
    (r : X ⟶ G) (u : G ⟶ F) (c : G ⟶ H) (z : H ⟶ Y)
    (hp : p = q ≫ n) (hn : n ≫ a = b ≫ t) (hk : t ≫ k = j ≫ v)
    (hs : q ≫ b ≫ j = r ≫ u) (hu : c ≫ z = u ≫ v) :
    p ≫ a ≫ k = r ≫ c ≫ z := by
  rw [hp]
  simp only [Category.assoc]
  rw [← Category.assoc n a, hn]
  simp only [Category.assoc]
  rw [hk, ← Category.assoc b j, ← Category.assoc q (b ≫ j), hs, Category.assoc, ← hu]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual retained root-first coefficient tensor source,
after original coefficient contractions, is the original core
coefficient tensor contraction followed by its actual final unit prefix. -/
theorem envelopingAssocRootFirstCoreSource_eq (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstCoreFlattenIso
      O.toCollection d Q).inv ≫
        (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocRootFirstRetainedBlocks
          O.toCollection d Q) ≫
        (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstFinalFactorsMap O d Q) =
      (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocRootFirstCoefficientBlocks
        O.toCollection d Q) ≫
        (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstContractionMap O d Q) ≫
        (frozenVariableTensorUnitIso (envelopingAssocInnerRootInputs d Q).index
          (envelopingRepresentativeCoefficients O.toCollection d.innerData
            (envelopingAssocInnerChoices d Q))).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let I := (envelopingAssocInnerRootInputs d Q).index
  let N := envelopingAssocRootFirstCoefficientBlocks O.toCollection d Q
  let K := emptyAndRetainedBlocks I N
  let M := envelopingAssocRootFirstRetainedBlocks O.toCollection d Q
  let r := envelopingAssocRootFirstCoreBlocksIso O.toCollection d Q
  let e := emptyAndRetainedFlattenIso I N
  let f := envelopingAssocRootFirstCoreFlattenIso O.toCollection d Q
  let p := T.map f.inv
  let a := (FiniteTensor.flattenIso (V := C)).hom.app M
  let k := T.map (envelopingAssocRootFirstFinalFactorsMap O d Q)
  let n := T.map (F.map r.hom)
  let b := (FiniteTensor.flattenIso (V := C)).hom.app K
  let j := T.map (emptyAndRetainedTensorIso I N).hom
  let v := T.map (Variable.unitFamilyMap (Equiv.refl I)
    (envelopingAssocRootFirstContractionMap O d Q))
  have he : f.inv = e.inv ≫ F.map r.hom := by
    rfl
  have hp : p = T.map e.inv ≫ n := (congrArg T.map he).trans (T.map_comp _ _)
  have hn : n ≫ a = b ≫ T.map ((FiniteFamily.map T).map r.hom) :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality r.hom
  have hk : T.map ((FiniteFamily.map T).map r.hom) ≫ k = j ≫ v :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (envelopingAssocRootFirstCoreTensorMap O d
      Q)).trans (T.map_comp _ _))
  have hsource := emptyAndRetainedInsertion_eq I N
  have hunit := Variable.tensorUnitIso_naturality (Equiv.refl I)
    (envelopingAssocRootFirstContractionMap O d Q)
  exact originalCoreSourceFiring p a k (T.map e.inv) n b
    (T.map ((FiniteFamily.map T).map r.hom)) j v
    ((FiniteTensor.flattenIso (V := C)).hom.app N)
    (frozenVariableTensorUnitIso I ((FiniteFamily.map T).obj N)).hom
    (T.map (envelopingAssocRootFirstContractionMap O d Q))
    (frozenVariableTensorUnitIso I
      (envelopingRepresentativeCoefficients O.toCollection d.innerData
        (envelopingAssocInnerChoices d Q))).hom
    hp hn hk hsource hunit


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource092

