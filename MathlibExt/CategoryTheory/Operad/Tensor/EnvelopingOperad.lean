      change HEq (f ≫ 𝟙 _) (T.map (𝟙 L) ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans ((congrArg (· ≫
        f) (T.map_id L)).trans (Category.id_comp f)).symm)
    | some i =>
      let S := (FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (s.inner.obj i))
      let f := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (s.inner.obj i))
      change HEq (f ≫ 𝟙 _) (T.map (𝟙 S) ≫ f)
      exact heq_of_eq ((Category.comp_id f).trans ((congrArg (· ≫
        f) (T.map_id S)).trans (Category.id_comp f)).symm)

theorem sourceToRaw_tensor (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (Branch.weightedSourceToRawIso E s Q).hom =
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.map (FiniteTensor.tensor (V :=
        C))).map (weightedIso E s Q).hom)
        ≫
      (FiniteTensor.flattenIso (V := C)).inv.app (groups E s Q) ≫
      (FiniteTensor.tensor (V := C)).map (RootTensor.sourceToSplitIso s.inner.index
        (rootFamily E s Q) (branchFamily E s
        Q)).hom ≫
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C :=
          C)).map (splitIso E s Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let u := T.map ((FiniteFamily.map T).map (weightedIso E s Q).hom)
  let e := (FiniteTensor.flattenIso (V := C)).inv.app (groups E s Q)
  let p := (FiniteTensor.flattenIso (V := C)).inv.app (Branch.weightedBlocks E s Q)
  let a := T.map ((FiniteFamily.flatten (C := C)).map (weightedIso E s Q).hom)
  let b := T.map (RootTensor.sourceToSplitIso s.inner.index (rootFamily E s Q) (branchFamily
    E s Q)).hom
  let c := T.map ((FiniteFamily.flatten (C := C)).map (splitIso E s Q).hom)
  let t := T.map (Branch.weightedRawIsoA E s Q).hom
  have hu : u ≫ e = p ≫ a := (FiniteTensor.flattenIso (V :=
    C)).inv.naturality (weightedIso E s Q).hom
  have ha : a ≫ b ≫ c = t := (mapThreeSlots T _ _ _).symm.trans (congrArg T.map
    (sourceRaw_triangle E s Q))
