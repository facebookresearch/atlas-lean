/- Exact checked source: EnvelopingUnderAEquivalence. -/
section EnvelopingSource388


/-!
# The full genuine equivalence between enveloping algebras and original O-algebras under A
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance envelopingEquivalenceFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The full genuine enveloping algebra round trips form a natural
isomorphism, retaining every original whole carrier morphism. -/
def envelopingUnderAUnitIso (O : ColoredOperadObj W C) (A : Algebra O) :
    𝟭 (Algebra (envelopingOperad O A)) ≅ envelopingUnderAFunctor O A ⋙
      underAEnvelopingFunctor O A :=
  NatIso.ofComponents (fun M => (envelopingUnderARoundTripIso O A M).symm) (by
    intro M N f
    apply Algebra.Hom.ext
    change f.hom ≫ (envelopingUnderARoundTripIso O A N).inv.hom =
      (envelopingUnderARoundTripIso O A M).inv.hom ≫ f.hom
    rw [envelopingUnderA_roundTripIso_inv, envelopingUnderA_roundTripIso_inv]
    exact (Category.comp_id f.hom).trans (Category.id_comp f.hom).symm)

/-- The full genuine original under-A round trips form a natural
isomorphism, retaining the original O-algebra arrows and A-triangles. -/
def envelopingUnderACounitIso (O : ColoredOperadObj W C) (A : Algebra O) :
    underAEnvelopingFunctor O A ⋙ envelopingUnderAFunctor O A ≅ 𝟭 (Under A) :=
  NatIso.ofComponents (fun B => underAEnvelopingRoundTripIso O A B) (by
    intro B D f
    apply Under.UnderMorphism.ext
    apply Algebra.Hom.ext
    exact (Category.comp_id f.right.hom).trans (Category.id_comp f.right.hom).symm)

/-- The actual original O-algebra constructs a full genuine
equivalence between algebras over its actual enveloping operad and
the actual category of original O-algebras under A. All operation laws,
both functors, both original carrier round trips and A-map triangles
are proved from O and A; no equivalence or enveloping outcome is an input. -/
def envelopingUnderAEquivalence (O : ColoredOperadObj W C) (A : Algebra O) :
    Algebra (envelopingOperad O A) ≌ Under A where
  functor := envelopingUnderAFunctor O A
  inverse := underAEnvelopingFunctor O A
  unitIso := envelopingUnderAUnitIso O A
  counitIso := envelopingUnderACounitIso O A
  functor_unitIso_comp M := by
    apply Under.UnderMorphism.ext
    apply Algebra.Hom.ext
    change (envelopingUnderARoundTripIso O A M).inv.hom ≫ 𝟙 M.carrier = 𝟙 M.carrier
    rw [envelopingUnderA_roundTripIso_inv]
    exact Category.id_comp (𝟙 M.carrier)

/-- The equivalence retains the entire original O restriction of
every genuine enveloping algebra, with all original operations. -/
theorem envelopingUnderAEquivalence_original (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    ((envelopingUnderAEquivalence O A).functor.obj M).right =
      Algebra.restrict (originalOperadToEnveloping O A) M :=
  LinearAlgebraRelation.linearUnderlying_restrict O A.carrier (envelopingOperadProjection O A) M

/-- The actual A-arrow in the full equivalence is precisely the
original nullary coefficient comparison inverse followed by the
genuine original M nullary operation. -/
theorem envelopingUnderAEquivalence_A_map (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) (d : W) :
    ((envelopingUnderAEquivalence O A).functor.obj M).hom.hom d =
      (envelopingOperadNullaryIso O A d).inv ≫ FrozenAlgebra.nullaryEvaluation M d := by
  have h := congrFun (LinearAlgebraRelation.linearConstants_restrict O A.carrier
    (envelopingOperadProjection O A) M) d
  have hg : linearConstantGenerator O A.carrier d ≫
      (envelopingOperadProjection O A).toCollectionHom.app (ColoredProfile.nullary d) =
        (envelopingOperadNullaryIso O A d).inv := envelopingConstantGenerator_eq_inverse O A d
  exact h.trans ((Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ FrozenAlgebra.nullaryEvaluation M d) hg))

/-- The full equivalence retains the exact complete original carrier
functor and every original carrier morphism. -/
theorem envelopingUnderAEquivalence_forward_forget (O : ColoredOperadObj W C) (A : Algebra O) :
    (envelopingUnderAEquivalence O A).functor ⋙ Under.forget A ⋙ Algebra.forget O =
      Algebra.forget (envelopingOperad O A) := rfl

/-- The inverse full equivalence retains the exact complete original
under-A carrier functor and every original carrier morphism. -/
theorem envelopingUnderAEquivalence_inverse_forget (O : ColoredOperadObj W C) (A : Algebra O) :
    (envelopingUnderAEquivalence O A).inverse ⋙ Algebra.forget (envelopingOperad O A) =
      Under.forget A ⋙ Algebra.forget O := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource388
