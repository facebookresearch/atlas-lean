/- Exact checked source: VariableActionNaturality. -/
section EnvelopingSource177


/-!
# Complete variable-profile naturality of the actual constant-input action

The original root/branch injections retain the full variable-profile map.
The actual rooted tensor beta rule and IsColimit prove the complete summand
equality; the actual outer coefficient colimit then proves action naturality.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Variable

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used to compare variable-profile branch injections. -/
local instance {d : W} (Q : AnalyticIndex W d) (i : analyticFactorsIndex Q) :
    Category.{0} (profileSlotIndex Q i) := profileSlotCategory Q i

/-- The actual original root/branch injection factors commute with
every original variable-profile map, retaining every branch injection. -/
theorem branchInjection_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    weightedBranchMap O B f Q R ≫ Outer.branchInjection O B P' Q R =
      Outer.branchInjection O B P Q R ≫
        (coefficientInputFactorsMap (Functor.whiskerRight (fixedProfileExtensionMap f) O)
          (𝟙 (addedAlgebraInputs (profileCoinvariants O B)))).app Q := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap f (𝟙 Q)) ≫ 𝟙 _) (𝟙 _ ≫ O.map (extendProfileMap f (𝟙 Q)))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some j =>
      change HEq (𝟙 _ ≫ profileι O B (R j)) (profileι O B (R j) ≫ 𝟙 _)
      exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- The complete original tensor injection square retains the actual
coefficient-diagram variable-profile map. -/
theorem branchTensorInjection_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (weightedBranchMap O B f Q R) ≫
        (FiniteTensor.tensor (V := C)).map (Outer.branchInjection O B P' Q R) =
      (FiniteTensor.tensor (V := C)).map (Outer.branchInjection O B P Q R) ≫
        (linearCoefficientProfileMap O (profileCoinvariants O B) f).app Q :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
    ((congrArg (FiniteTensor.tensor (V := C)).map (branchInjection_naturality O B f Q R)).trans
      ((FiniteTensor.tensor (V := C)).map_comp _ _))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Variable-profile naturality holds on every genuine original
root/branch tensor injection by actual beta and evaluation naturality. -/
theorem constantInputSubstitution_on_injection (O : ColoredOperadObj W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫
        ((linearCoefficientProfileMap O.toCollection (profileCoinvariants O.toCollection B)
          f).app Q ≫
          constantInputSubstitution O B P' Q) =
      (rootedFrozenSummandInjection O.toCollection B P Q R ≫ constantInputSubstitution O B P Q) ≫
        linearCoefficientMap O.toCollection B f := by
  let r := rootedFrozenBranches P Q R
  let R' : ProfileSlotTuple ((inputsToProfile P'.outputColor).obj Q) := fun i => match i with
    | none => R none
    | some j => R (some j)
  let T := FiniteTensor.tensor (V := C)
  let e := T.map (rootedFrozenFamilyIso O.toCollection B P Q R).hom
  let a := T.map (Outer.branchInjection O.toCollection B P Q r)
  let a' := T.map (Outer.branchInjection O.toCollection B P' Q r)
  let k := T.map (weightedBranchMap O.toCollection B f Q r)
  let m := (linearCoefficientProfileMap O.toCollection (profileCoinvariants O.toCollection
    B) f).app Q
  let b := constantInputSubstitution O B P Q
  let b' := constantInputSubstitution O B P' Q
  let t := linearCoefficientMap O.toCollection B f
  let v := frozenWeightedBranchEvaluation O B P Q r ≫
    linearCoefficientι O.toCollection B P (frozenTotalInputs Q r)
  let v' := frozenWeightedBranchEvaluation O B P' Q r ≫
    linearCoefficientι O.toCollection B P' (frozenTotalInputs Q r)
  have he : rootedFrozenSummandInjection O.toCollection B P Q R = e ≫ a :=
    Outer.rootedFrozenSummandInjection_eq O.toCollection B P Q R
  have hi : a ≫ m = k ≫ a' := (branchTensorInjection_naturality O.toCollection B f Q r).symm
  have hβ : a' ≫ b' = v' := Outer.weightedBranchInjection_β O B P' Q R'
  have hv : k ≫ v' = v ≫ t := weightedBranchEvaluation_colimit_naturality O B f Q r
  have hr : e ≫ v = rootedFrozenSummandInjection O.toCollection B P Q R ≫ b :=
    (constantInputSubstitution_β O B P Q R).symm
  have h1 := congrArg (fun z => z ≫ (m ≫ b')) he
  have h2 := (Category.assoc e a (m ≫ b')).trans
    (congrArg (e ≫ ·) (Category.assoc a m b').symm)
  have h3 := congrArg (fun z => e ≫ (z ≫ b')) hi
  have h4 := congrArg (e ≫ ·) (Category.assoc k a' b')
  have h5 := congrArg (fun z => e ≫ (k ≫ z)) hβ
  have h6 := congrArg (e ≫ ·) hv
  have h7 := (Category.assoc e v t).symm
  have h8 := congrArg (· ≫ t) hr
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans (h6.trans (h7.trans h8))))))

/-- The actual original summand substitution is natural under every
variable-profile map, derived from its genuine rooted tensor colimit. -/
theorem constantInputSubstitution_naturality (O : ColoredOperadObj W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) :
    (linearCoefficientProfileMap O.toCollection (profileCoinvariants O.toCollection B) f).app Q ≫
        constantInputSubstitution O B P' Q =
      constantInputSubstitution O B P Q ≫ linearCoefficientMap O.toCollection B f := by
  let e := rootedFrozenPointIso O.toCollection B P Q
  let H := rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile P Q)) O.toCollection B
    ((inputsToProfile P.outputColor).obj Q)
  apply (cancel_epi e.hom).1
  apply H.hom_ext
  intro R
  let i := (rootedSlotTensorCocone (O.toCollection.obj (extendProfile P Q)) O.toCollection B
    ((inputsToProfile P.outputColor).obj Q)).ι.app R
  let m := (linearCoefficientProfileMap O.toCollection (profileCoinvariants O.toCollection
    B) f).app Q
  let b := constantInputSubstitution O B P Q
  let b' := constantInputSubstitution O B P' Q
  let t := linearCoefficientMap O.toCollection B f
  exact (Category.assoc i e.hom (m ≫ b')).symm.trans
    ((constantInputSubstitution_on_injection O B f Q R).trans
      ((Category.assoc (i ≫ e.hom) b t).trans (Category.assoc i e.hom (b ≫ t))))

/-- The complete original constant-input action is natural in every
original variable-profile map, with all input permutations and output
equalities retained by the actual outer colimit descent and beta rule. -/
theorem constantInputAction_naturality (O : ColoredOperadObj W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    linearCoefficientMap O.toCollection (profileCoinvariants O.toCollection B) f ≫
        constantInputAction O B P' =
      constantInputAction O B P ≫ linearCoefficientMap O.toCollection B f := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  let i := linearCoefficientι O.toCollection (profileCoinvariants O.toCollection B) P Q
  let i' := linearCoefficientι O.toCollection (profileCoinvariants O.toCollection B) P' Q
  let m := (linearCoefficientProfileMap O.toCollection (profileCoinvariants O.toCollection
    B) f).app Q
  let t := linearCoefficientMap O.toCollection (profileCoinvariants O.toCollection B) f
  let a := constantInputAction O B P
  let a' := constantInputAction O B P'
  let b := constantInputSubstitution O B P Q
  let b' := constantInputSubstitution O B P' Q
  let k := linearCoefficientMap O.toCollection B f
  have h1 : i ≫ t = m ≫ i' := linearCoefficientι_profileMap O.toCollection
    (profileCoinvariants O.toCollection B) f Q
  have h2 : i' ≫ a' = b' := constantInputAction_β O B P' Q
  have h3 : m ≫ b' = b ≫ k := constantInputSubstitution_naturality O B f Q
  have h4 : i ≫ a = b := constantInputAction_β O B P Q
  have s1 := (Category.assoc i t a').symm
  have s2 := congrArg (· ≫ a') h1
  have s3 := Category.assoc m i' a'
  have s4 := congrArg (m ≫ ·) h2
  have s5 := congrArg (· ≫ k) h4.symm
  have s6 := Category.assoc i a k
  exact s1.trans (s2.trans (s3.trans (s4.trans (h3.trans (s5.trans s6)))))


end CategoryTheory.Operad.Tensor.Enveloping.Variable

end
end EnvelopingSource177

/- Exact checked source: VariableCarrierNaturality. -/
section EnvelopingSource178


/-!
# Original variable-profile naturality of the actual carrier action face

The actual profile map and actual colorwise carrier map commute on the
original coefficient/input tensor diagrams. Their original colimit maps
therefore commute, including the original O-algebra action second face.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Variable

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual variable-profile tensor map commutes with every
original colorwise carrier tensor map on every added-input diagram. -/
theorem linearCoefficientDiagram_mixed (O : ColoredSymmetricCollection W C)
    {A B : W → C} (a : A ⟶ B) {P P' : ColoredProfile W} (f : P ⟶ P') :
    linearCoefficientProfileMap O A f ≫ linearCoefficientCarrierMap O a P' =
      linearCoefficientCarrierMap O a P ≫ linearCoefficientProfileMap O B f := by
  ext Q
  let T := FiniteTensor.tensor (V := C)
  let x := O.map (extendProfileMap f (𝟙 Q))
  let b := (addedAlgebraInputMap a).app Q
  let L := (addedAlgebraInputs A).obj Q
  let M := (addedAlgebraInputs B).obj Q
  have hs : coefficientLeafMap x (𝟙 L) ≫ coefficientLeafMap (𝟙 _) b =
      coefficientLeafMap (𝟙 _) b ≫ coefficientLeafMap x (𝟙 M) := by
    rw [coefficientLeafMap_comp, coefficientLeafMap_comp, Category.comp_id, Category.id_comp,
      Category.id_comp, Category.comp_id]
  exact (T.map_comp _ _).symm.trans ((congrArg T.map hs).trans (T.map_comp _ _))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Actual colorwise carrier maps on the original coefficient
colimits preserve every original variable-profile map. -/
theorem linearCoefficientCarrierLift_naturality (O : ColoredSymmetricCollection W C)
    {A B : W → C} (a : A ⟶ B) {P P' : ColoredProfile W} (f : P ⟶ P') :
    linearCoefficientMap O A f ≫ linearCoefficientCarrierLift O a P' =
      linearCoefficientCarrierLift O a P ≫ linearCoefficientMap O B f := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  change colim.map (linearCoefficientProfileMap O A f) ≫
    colim.map (linearCoefficientCarrierMap O a P') =
    colim.map (linearCoefficientCarrierMap O a P) ≫ colim.map (linearCoefficientProfileMap O B f)
  exact (colim.map_comp _ _).symm.trans
    ((congrArg colim.map (linearCoefficientDiagram_mixed O a f)).trans (colim.map_comp _ _))

/-- The actual original algebra-action relation is natural under
every original variable-profile input permutation and output-color
equality, through the actual carrier action and coefficient colimit maps. -/
theorem algebraInputRelation_naturality (O : ColoredOperadObj W C) (A : Algebra O)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    linearCoefficientMap O.toCollection (profileCoinvariants O.toCollection A.carrier) f ≫
        algebraInputRelation O A P' =
      algebraInputRelation O A P ≫ linearCoefficientMap O.toCollection A.carrier f :=
  linearCoefficientCarrierLift_naturality O.toCollection A.action f


end CategoryTheory.Operad.Tensor.Enveloping.Variable

end
