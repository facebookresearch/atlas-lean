empty-sum profile map, including all original input colors. -/
theorem shapeHom_outer (d : W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenOuterProfileHom (ColoredProfile.nullary d) Q R ≫
        ColoredSubstitutionData.outerProfileMap (shapeHom d Q R) =
      nullaryVariableProfileHom d Q := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  cases p with
  | inl p => exact Fin.elim0 p
  | inr _ => rfl

