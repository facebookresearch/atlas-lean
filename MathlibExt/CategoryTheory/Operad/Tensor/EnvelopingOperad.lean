    let r₂ := (FiniteTensor.flattenIso (V := C)).inv.app ((FiniteFamily.flatten (C :=
      FiniteFamily C)).obj R)
    let r₃ := T.map (FiniteFamily.flattenAssocIso.inv.app R)
    let r₄ := T.map (F.map (groupedCoefficientInputRawIso N L).hom)
    let r₅ := T.map (partitionedCoefficientLeavesSourceIso N (groupedCoefficientInputs N L)).hom
