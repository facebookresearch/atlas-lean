private theorem EnvelopingSource344_mapThree {V U : Type*} [Category* V] [Category* U]
    (T : V ⥤ U) {X Y Z D : V} (f : X ⟶ Y) (g : Y ⟶ Z) (h : Z ⟶ D) :
    T.map (f ≫ g ≫ h) = T.map f ≫ T.map g ≫ T.map h := by
  rw [T.map_comp, T.map_comp]

private theorem freeBetaFold {V : Type*} [Category* V]
    {X K A B S T D : V} (f : X ⟶ K) (z : K ⟶ A) (j : A ⟶ B) (u : X ⟶ B)
    (v : B ⟶ D) (a : A ⟶ S) (b : S ⟶ T) (p : T ⟶ D) (r : K ⟶ S)
    (hi : f ≫ z ≫ j = u) (hf : j ≫ v = a ≫ b ≫ p) (hs : z ≫ a = r) :
    u ≫ v = f ≫ r ≫ b ≫ p := by
  have h1 : u ≫ v = f ≫ z ≫ j ≫ v := by
    simpa only [Category.assoc] using congrArg (· ≫ v) hi.symm
  have h2 : f ≫ z ≫ j ≫ v = f ≫ z ≫ a ≫ b ≫ p := by
    simpa only [Category.assoc] using congrArg (f ≫ z ≫ ·) hf
  have h3 : f ≫ z ≫ a ≫ b ≫ p = f ≫ r ≫ b ≫ p := by
    simpa only [Category.assoc] using congrArg (fun q => f ≫ q ≫ b ≫ p) hs
  exact h1.trans (h2.trans h3)

private theorem outputFold {V : Type*} [Category* V]
    {X I J N K S T : V} (u : X ⟶ I) (v : I ⟶ J) (w : J ⟶ N)
    (f : X ⟶ K) (r : K ⟶ S) (b : S ⟶ T) (p : T ⟶ J)
    (out : T ⟶ N) (gamma : K ⟶ N)
    (hb : u ≫ v = f ≫ r ≫ b ≫ p) (ho : p ≫ w = out) (he : r ≫ b ≫ out = gamma) :
    u ≫ v ≫ w = f ≫ gamma := by
  have h1 : u ≫ v ≫ w = f ≫ r ≫ b ≫ p ≫ w := by
    simpa only [Category.assoc] using congrArg (· ≫ w) hb
  have h2 : f ≫ r ≫ b ≫ p ≫ w = f ≫ r ≫ b ≫ out :=
    congrArg (f ≫ r ≫ b ≫ ·) ho
  exact h1.trans (h2.trans (congrArg (f ≫ ·) he))

