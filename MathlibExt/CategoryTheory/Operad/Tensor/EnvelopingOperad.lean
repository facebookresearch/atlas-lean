      (addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q) :=
  FiniteFamily.isoOfComponents (envelopingAssocRootFirstLeafEquiv B d Q) (fun p => match p with
    | ⟨none, Sum.inl _⟩ => Iso.refl _
    | ⟨none, Sum.inr _⟩ => Iso.refl _
    | ⟨some _, _⟩ => Iso.refl _)


