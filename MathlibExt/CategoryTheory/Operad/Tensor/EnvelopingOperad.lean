/- Exact checked source: ReflexiveOperad.ConstantsMapNaturality. -/
section EnvelopingSource355


/-!
# Actual original constants operad maps commute with full target and carrier maps
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

private theorem postRepresentativeFold {V : Type*} [Category* V]
    {X A B D D' Y Y' : V} (a : X ⟶ A) (l : A ⟶ B) (p : A ⟶ D) (p' : B ⟶ D')
    (r : D ⟶ Y) (r' : D' ⟶ Y') (hD : D ⟶ D') (hY : Y ⟶ Y') (a' : X ⟶ B)
    (ha : a ≫ l = a') (hp : l ≫ p' = p ≫ hD) (hr : hD ≫ r' = r ≫ hY) :
    (a ≫ p ≫ r) ≫ hY = a' ≫ p' ≫ r' := by
  have h1 : (a ≫ p ≫ r) ≫ hY = a ≫ p ≫ hD ≫ r' := by
    simpa only [Category.assoc] using congrArg (a ≫ p ≫ ·) hr.symm
  have h2 : a ≫ p ≫ hD ≫ r' = a ≫ l ≫ p' ≫ r' := by
    simpa only [Category.assoc] using congrArg (fun z => a ≫ z ≫ r') hp.symm
  have h3 : a ≫ l ≫ p' ≫ r' = a' ≫ p' ≫ r' := by
    simpa only [Category.assoc] using congrArg (· ≫ p' ≫ r') ha
  exact h1.trans (h2.trans h3)

private theorem carrierCofanFold {V : Type*} [Category* V]
    {X X' A A' Y : V} (i : X ⟶ A) (c : A ⟶ A') (f : A' ⟶ Y)
    (a : X ⟶ X') (j : X' ⟶ A') (rep : X' ⟶ Y) (rep' : X ⟶ Y)
    (hc : i ≫ c = a ≫ j) (hf : j ≫ f = rep) (hr : a ≫ rep = rep') :
    i ≫ (c ≫ f) = rep' := by
  rw [← Category.assoc i c, hc, Category.assoc a j, hf]
  exact hr

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root and every original nullary coefficient use exactly
their original full target-map components after postcomposition. -/
theorem coefficientMap_post {O E E' : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (h : E ⟶ E')
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    coefficientMap u B b P Q ≫ OperadMap.frozenCoefficientMap h P Q (branches Q) =
      coefficientMap (u ≫ h) B (fun c => b c ≫ h.toCollectionHom.app
        (ColoredProfile.nullary c)) P Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i <;> exact HEq.rfl

/-- Actual original frozen partial substitution and total-profile
naturality prove postcomposition on each original coefficient representative. -/
theorem representative_post {O E E' : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (h : E ⟶ E')
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    representative u B b P Q ≫ h.toCollectionHom.app P =
      representative (u ≫ h) B (fun c => b c ≫ h.toCollectionHom.app
        (ColoredProfile.nullary c)) P Q := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (coefficientMap u B b P Q)
  let l := T.map (OperadMap.frozenCoefficientMap h P Q (branches Q))
  let p := frozenPartialSubstitution E P Q (branches Q)
  let p' := frozenPartialSubstitution E' P Q (branches Q)
  let r := E.toCollection.map (totalProfileHom P Q)
  let r' := E'.toCollection.map (totalProfileHom P Q)
  let hD := h.toCollectionHom.app (extendProfile P (frozenTotalInputs Q (branches Q)))
  let hY := h.toCollectionHom.app P
  let a' := T.map (coefficientMap (u ≫ h) B (fun c => b c ≫
    h.toCollectionHom.app (ColoredProfile.nullary c)) P Q)
  have ha : a ≫ l = a' := (T.map_comp _ _).symm.trans (congrArg T.map (coefficientMap_post
    u B b h P Q))
  have hp : l ≫ p' = p ≫ hD := OperadMap.frozenPartial_map h P Q (branches Q)
  have hr : hD ≫ r' = r ≫ hY := (h.toCollectionHom.naturality (totalProfileHom P Q)).symm
  exact postRepresentativeFold a l p p' r r' hD hY a' ha hp hr

/-- Every original carrier slot uses the actual original g component
before b, with the original coefficient and all original positions retained. -/
theorem coefficientMap_pre {O E : ColoredOperadObj W C} (u : O ⟶ E) {B B' : W → C}
    (g : B ⟶ B') (b : ∀ c, B' c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    coefficientLeafMap (𝟙 (O.toCollection.obj (extendProfile P Q)))
      ((addedAlgebraInputMap g).app Q) ≫
      coefficientMap u B' b P Q = coefficientMap u B (fun c => g c ≫ b c) P Q := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp (u.toCollectionHom.app (extendProfile P Q)))
    | some i => exact HEq.rfl

/-- The actual original carrier tensor map followed by the original
constants representative is precisely the representative with literal g≫b constants. -/
theorem representative_pre {O E : ColoredOperadObj W C} (u : O ⟶ E) {B B' : W → C}
    (g : B ⟶ B') (b : ∀ c, B' c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientCarrierMap O.toCollection g P).app Q ≫ representative u B' b P Q =
      representative u B (fun c => g c ≫ b c) P Q := by
  let T := FiniteTensor.tensor (V := C)
  let a := (linearCoefficientCarrierMap O.toCollection g P).app Q
  let c := T.map (coefficientMap u B' b P Q)
  let c' := T.map (coefficientMap u B (fun c => g c ≫ b c) P Q)
  let tail := frozenPartialSubstitution E P Q (branches Q) ≫
    E.toCollection.map (totalProfileHom P Q)
  have h : a ≫ c = c' := (T.map_comp _ _).symm.trans (congrArg T.map (coefficientMap_pre u g b P Q))
  exact (Category.assoc a c tail).symm.trans (congrArg (· ≫ tail) h)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Every original coefficient cofan records the literal postcomposed
constants and original full target-map component. -/
theorem operadMap_post_cofan {O E E' : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (h : E ⟶ E')
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫ (operadMap u B b ≫ h).toCollectionHom.app P =
      representative (u ≫ h) B (fun c => b c ≫ h.toCollectionHom.app
        (ColoredProfile.nullary c)) P Q :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ h.toCollectionHom.app P) (operadMap_β u B b P Q)).trans
      (representative_post u B b h P Q))

/-- The actual full constants extension commutes with every actual
full target operad map; the new b is the literal original postcomposition. -/
theorem operadMap_post {O E E' : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (h : E ⟶ E') :
    operadMap u B b ≫ h =
      operadMap (u ≫ h) B (fun c => b c ≫ h.toCollectionHom.app (ColoredProfile.nullary c)) := by
  apply ColoredOperadObj.Hom.ext
  apply NatTrans.ext
  funext P
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  exact (operadMap_post_cofan u B b h P Q).trans (operadMap_β (u ≫ h) B
    (fun c => b c ≫ h.toCollectionHom.app (ColoredProfile.nullary c)) P Q).symm

/-- Every original coefficient cofan records the original carrier map
before the constants map, with the composed constants chosen literally. -/
theorem operadMap_pre_cofan {O E : ColoredOperadObj W C} (u : O ⟶ E) {B B' : W → C}
    (g : B ⟶ B') (b : ∀ c, B' c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫ (linearCarrierOperadMap O g ≫
      operadMap u B' b).toCollectionHom.app P =
      representative u B (fun c => g c ≫ b c) P Q :=
  carrierCofanFold (linearCoefficientι O.toCollection B P Q)
    (linearCoefficientCarrierLift O.toCollection g P) ((operadMap u B' b).toCollectionHom.app P)
    ((linearCoefficientCarrierMap O.toCollection g P).app Q) (linearCoefficientι
      O.toCollection B' P Q)
    (representative u B' b P Q) (representative u B (fun c => g c ≫ b c) P Q)
    (linearCoefficientι_carrier O.toCollection g P Q) (operadMap_β u B' b P Q)
      (representative_pre u g b P Q)

/-- The actual full linear carrier map followed by the actual full
constants extension is the original extension with literal g≫b constants. -/
theorem operadMap_pre {O E : ColoredOperadObj W C} (u : O ⟶ E) {B B' : W → C}
    (g : B ⟶ B') (b : ∀ c, B' c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) :
    linearCarrierOperadMap O g ≫ operadMap u B' b = operadMap u B (fun c => g c ≫ b c) := by
  apply ColoredOperadObj.Hom.ext
  apply NatTrans.ext
  funext P
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  exact (operadMap_pre_cofan u g b P Q).trans (operadMap_β u B (fun c => g c ≫ b c) P Q).symm


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource355

