local instance canonicalAlgebraMapFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original O-algebra morphism induces a genuine full
canonical enveloping algebra map, by the constructed initial
source algebra and the actual original enveloping operad map. -/
def canonicalEnvelopingAlgebraMap (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B) :
    canonicalEnvelopingAlgebra O A ⟶
      Algebra.restrict (envelopingOperadMap O f) (canonicalEnvelopingAlgebra O B) :=
  (canonicalEnvelopingAlgebraIsInitial O A).to _

/-- The canonical full enveloping algebra map has precisely the
original complete colorwise O-algebra carrier arrow. -/
theorem canonicalEnvelopingAlgebraMap_hom (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B) :
    (canonicalEnvelopingAlgebraMap O f).hom = f.hom := by
  funext d
  let M := canonicalEnvelopingAlgebra O A
  let N := Algebra.restrict (envelopingOperadMap O f) (canonicalEnvelopingAlgebra O B)
  let h := canonicalEnvelopingAlgebraMap O f
  let e := (envelopingOperadNullaryIso O A d).hom
  have hN : FrozenAlgebra.nullaryEvaluation N d = e ≫ f.hom d :=
    (LinearAlgebraRelation.restriction_nullaryEvaluation (envelopingOperadMap O f)
      (canonicalEnvelopingAlgebra O B)
      d).trans
      ((congrArg ((envelopingOperadMap O f).toCollectionHom.app (ColoredProfile.nullary d) ≫ ·)
        (canonicalEnvelopingAlgebra_nullaryEvaluation O B d)).trans
          (envelopingOperadNullaryIso_naturality O f d))
  have hc : e ≫ h.hom d = e ≫ f.hom d :=
    (congrArg (· ≫ h.hom d) (canonicalEnvelopingAlgebra_nullaryEvaluation O A d).symm).trans
      ((algebraNullaryEvaluation_naturality (envelopingOperad O A) h d).trans hN)
  exact (cancel_epi e).1 hc

