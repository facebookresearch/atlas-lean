namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

private theorem coefficientMapFiring {D : Type*} [Category* D] {A B C E F G : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : A ⟶ F) (f : F ⟶ C) (g : F ⟶ G) (h : G ⟶ E)
    (ha : a ≫ b = d ≫ f) (hf : f ≫ c = g ≫ h) : a ≫ (b ≫ c) = (d ≫ g) ≫ h := by
  exact (Category.assoc a b c).symm.trans ((congrArg (· ≫ c) ha).trans
    ((Category.assoc d f c).trans ((congrArg (d ≫ ·) hf).trans (Category.assoc d g h).symm)))

private theorem jointInterchangeFiring {D : Type*} [Category* D] {A B C E F G : D}
    (w : A ⟶ B) (i' : B ⟶ C) (i : A ⟶ E) (n : E ⟶ C) (e' : C ⟶ F) (e : E ⟶ G) (j : G ⟶ F)
    (hi : w ≫ i' = i ≫ n) (hn : n ≫ e' = e ≫ j) : w ≫ (i' ≫ e') = (i ≫ e) ≫ j := by
  exact (Category.assoc w i' e').symm.trans ((congrArg (· ≫ e') hi).trans
    ((Category.assoc i n e').trans ((congrArg (i ≫ ·) hn).trans (Category.assoc i e j).symm)))

private theorem constantsTransferFiring {V : Type*} [Category* V] {A B C D E F : V}
    (a : A ⟶ B) (j : B ⟶ C) (w : A ⟶ D) (e : D ⟶ C) (α : C ⟶ E) (β : B ⟶ E)
    (t : D ⟶ F) (σ : F ⟶ E) (p : A ⟶ F)
    (hj : j ≫ α = β) (ha : a ≫ j = w ≫ e) (ht : e ≫ α = t ≫ σ) (hp : w ≫ t =
      p) : a ≫ β = p ≫ σ := by
  calc
    a ≫ β = a ≫ (j ≫ α) := congrArg (a ≫ ·) hj.symm
    _ = (a ≫ j) ≫ α := (Category.assoc a j α).symm
    _ = (w ≫ e) ≫ α := congrArg (· ≫ α) ha
    _ = w ≫ (e ≫ α) := Category.assoc w e α
    _ = w ≫ (t ≫ σ) := congrArg (w ≫ ·) ht
    _ = (w ≫ t) ≫ σ := (Category.assoc w t σ).symm
    _ = p ≫ σ := congrArg (· ≫ σ) hp

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Actual full operad maps preserve the original coefficient tensor
normalization, original representative substitution and original total coefficient. -/
theorem coefficients_tensor_square {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (slotCoefficients u s Q) ≫
      ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso E.toCollection s Q).hom ≫
        envelopingRepresentativeCoefficientSubstitution E s Q) =
    ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
      envelopingRepresentativeCoefficientSubstitution O s Q) ≫
      u.toCollectionHom.app (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (slotCoefficients u s Q)
  let b := T.map (envelopingCoefficientBlockIso E.toCollection s Q).hom
  let c := envelopingRepresentativeCoefficientSubstitution E s Q
  let d := T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom
  let f := T.map (OperadMap.representativeCoefficientMap u s Q)
  let g := envelopingRepresentativeCoefficientSubstitution O s Q
  let h := u.toCollectionHom.app (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))
  have ha : a ≫ b = d ≫ f := (T.map_comp _ _).symm.trans
    ((congrArg T.map (slotCoefficients_block u s Q)).trans (T.map_comp _ _))
  have hf : f ≫ c = g ≫ h := OperadMap.representativeCoefficient_map u s Q
  exact coefficientMapFiring a b c d f g h ha hf

/-- The actual original weighted representative evaluation is natural
in the supplied original O→E map and every supplied original B→E-nullary value. -/
theorem weightedRepresentative_square {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (weightedValueMap u B b s Q) ≫
      envelopingRepresentativeEvaluation E (Branch.nullaryCarrier E.toCollection) s Q =
    envelopingRepresentativeEvaluation O B s Q ≫
      (FiniteTensor.tensor (V := C)).map (jointFactors u B b s.totalProfile
        (envelopingTotalAlgebraInputs s Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option s.inner.index)
  let K := fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i))
  let K' := fun i => E.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i))
  let L := fun i => (addedAlgebraInputs B).obj (Q i)
  let L' := fun i => (addedAlgebraInputs (Branch.nullaryCarrier E.toCollection)).obj (Q i)
  let c := slotCoefficients u s Q
  let ℓ := leafBlocks B b s Q
  let w := T.map (weightedValueMap u B b s Q)
  let i := (coefficientBlockInterchangeTensorIso I K L).hom
  let i' := (coefficientBlockInterchangeTensorIso I K' L').hom
  let leaf := (FiniteFamily.flatten (C := C)).map ℓ
  let nFam := coefficientLeafMap (T.map c) leaf
  let n := T.map nFam
  let g := T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
    envelopingRepresentativeCoefficientSubstitution O s Q
  let g' := T.map (envelopingCoefficientBlockIso E.toCollection s Q).hom ≫
    envelopingRepresentativeCoefficientSubstitution E s Q
  let l := (envelopingAlgebraLeafIso B s Q).hom
  let l' := (envelopingAlgebraLeafIso (Branch.nullaryCarrier E.toCollection) s Q).hom
  let eFam := coefficientLeafMap g l
  let eFam' := coefficientLeafMap g' l'
  let e := T.map eFam
  let e' := T.map eFam'
  let h := u.toCollectionHom.app (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))
  let value := addedValueMap B b (envelopingTotalAlgebraInputs s Q)
  let jFam := jointFactors u B b s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let j := T.map jFam
  have hc : coefficientBlockMap I c.hom = c := rfl
  have hℓ : inputBlockMap I ℓ.hom = ℓ := rfl
  have hi : w ≫ i' = i ≫ n := (coefficientBlockInterchangeTensorIso_naturality I c.hom ℓ.hom).trans
    (congrArg₂ (fun c l => i ≫ T.map (coefficientLeafMap (T.map c)
      ((FiniteFamily.flatten (C := C)).map l))) hc hℓ)
  have hcoef : T.map c ≫ g' = g ≫ h := coefficients_tensor_square u s Q
  have hleaf : leaf ≫ l' = l ≫ value := leafBlocks_total B b s Q
  have hFam : nFam ≫ eFam' = eFam ≫ jFam := (coefficientLeafMap_comp (T.map c) g' leaf l').trans
    ((congrArg₂ (fun c l => coefficientLeafMap c l) hcoef hleaf).trans
      (coefficientLeafMap_comp g h l value).symm)
  have hn : n ≫ e' = e ≫ j := (T.map_comp _ _).symm.trans ((congrArg T.map hFam).trans
    (T.map_comp _ _))
  exact jointInterchangeFiring w i' i n e' e j hi hn

/-- Original target operad units/associativity prove the full substitution
law for the literal supplied constants evaluator on every original weighted source. -/
theorem representative_substitution {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (s :
      ColoredSubstitutionData W) (Q :
      EnvelopingInputChoices s) :
    envelopingRepresentativeEvaluation O B s Q ≫ representative u B b s.totalProfile
      (envelopingTotalAlgebraInputs s Q)
      =
      (FiniteTensor.tensor (V := C)).map (representativeSlotFamily u B b s Q) ≫ E.subst.app s := by
  let T := FiniteTensor.tensor (V := C)
  let a := envelopingRepresentativeEvaluation O B s Q
  let j := T.map (jointFactors u B b s.totalProfile (envelopingTotalAlgebraInputs s Q))
  let w := T.map (weightedValueMap u B b s Q)
  let e := envelopingRepresentativeEvaluation E (Branch.nullaryCarrier E.toCollection) s Q
  let α := representative (𝟙 E) (Branch.nullaryCarrier E.toCollection)
    (fun c => 𝟙 (E.toCollection.obj (ColoredProfile.nullary c))) s.totalProfile
      (envelopingTotalAlgebraInputs s Q)
  let β := representative u B b s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let t := T.map (Branch.Slots.literalSlotFamily E s Q)
  let σ := E.subst.app s
  let p := T.map (representativeSlotFamily u B b s Q)
  have hj : j ≫ α = β := representative_factor u B b s.totalProfile
    (envelopingTotalAlgebraInputs s Q)
  have ha : a ≫ j = w ≫ e := (weightedRepresentative_square u B b s Q).symm
  have ht : e ≫ α = t ≫ σ := Branch.representative_constant_substitution E s Q
  have hp : w ≫ t = p := (T.map_comp _ _).symm.trans (congrArg T.map
    (weightedValueMap_slots u B b s Q))
  exact constantsTransferFiring a j w e α β t σ p hj ha ht hp


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
