    operationπ f g A.carrier q ≫ operationApp f g t hf hg A balance d q = A.operations.app d q := by
  let eQ := coefficientAnalyticIso Q.toCollection A.carrier q
  let eE := coefficientAnalyticIso (collection f g) A.carrier q
  let δ := coefficientTensorDesc f g t hf hg ((analyticInputFamily A.carrier).obj q)
