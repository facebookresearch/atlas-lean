      U.map ((FiniteTensor.flattenIso (V := C)).inv.app N) = 𝟙 _ :=
    (U.map_comp _ _).symm.trans
      ((congrArg U.map ((FiniteTensor.flattenIso (V := C)).hom_inv_id_app N)).trans (U.map_id _))
  exact (congrArg (· ≫ U.map ((FiniteTensor.flattenIso (V := C)).inv.app N)) hp).trans
    ((Category.assoc _ _ _).trans ((congrArg (a ≫ ·) hu).trans (Category.comp_id a)))


