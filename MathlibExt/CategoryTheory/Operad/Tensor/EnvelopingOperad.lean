set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem weightedRouteAFourAssoc {V : Type*} [Category* V]
    {X A B D Y : V} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ D) (g : D ⟶ Y) :
    (a ≫ b ≫ c) ≫ g = a ≫ b ≫ c ≫ g := by simp only [Category.assoc]

private theorem weightedRouteAFiring {V : Type*} [Category* V]
    {X A B D E F Y : V} (a : X ⟶ A) (r : A ⟶ B) (n : B ⟶ D) (f : D ⟶ Y)
    (b : A ⟶ E) (c : E ⟶ B) (s : E ⟶ F) (q : F ⟶ D) (g : F ⟶ Y)
    (h1 : b ≫ c = r) (h2 : c ≫ n = s ≫ q) (h3 : q ≫ f = g) :
    a ≫ r ≫ n ≫ f = a ≫ b ≫ s ≫ g := by
  rw [← h1]
  simp only [Category.assoc]
  rw [← Category.assoc c n, h2]
  simp only [Category.assoc]
  rw [h3]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original inner-first weighted representative
operation factors through the common original coefficient tensor
route and the complete original total algebra-input tensor map. -/
theorem envelopingAssocWeightedRouteA_common (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRepresentativeRouteA O B d Q =
      envelopingAssocWeightedCommonEvaluationA O B d Q := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option d.branches.index)
  let K : I → C := envelopingAssocCoefficientBlockTensors O.toCollection d Q
  let K' : I → C := fun i => O.toCollection.obj
    (extendProfile (envelopingSlotProfile d.outerAfterInnerData i)
      (envelopingAssocOuterChoices d Q i))
  let L : I → FiniteFamily C := fun i => (envelopingAssocLeafBlocks B d Q).obj i
  let L' : I → FiniteFamily C := fun i => (addedAlgebraInputs B).obj
    (envelopingAssocOuterChoices d Q i)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocWeightedBlocks
    O.toCollection B d Q)
  let r := T.map (envelopingAssocWeightedContractionMapA O B d Q)
  let b := T.map (envelopingAssocWeightedBlockTensorIso O.toCollection B d Q).hom
  let c := T.map (envelopingAssocWeightedNormalizedContractionMap O B d Q)
  let n := (coefficientBlockInterchangeTensorIso I K' L').hom
  let s := (coefficientBlockInterchangeTensorIso I K L).hom
  let q := T.map (coefficientLeafMap
    (T.map (coefficientBlockMap I (envelopingAssocCoefficientContractionA O d Q)))
    (envelopingAssocContractedLeafFamilyIso B d Q).hom)
  let f := T.map (coefficientLeafMap
    (T.map (envelopingAssocContractedCoefficientFamilyIso O.toCollection d Q).hom ≫
      envelopingRepresentativeCoefficientSubstitution O d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q))
    (envelopingAlgebraLeafIso B d.outerAfterInnerData (envelopingAssocOuterChoices d Q)).hom)
  let g := T.map (coefficientLeafMap
    ((envelopingAssocFullCoefficientTensorIso O.toCollection d Q).hom ≫
      envelopingAssocRepresentativeRouteA O d Q)
    (envelopingAssocAlgebraLeafIso B d Q).hom)
  have h1 : b ≫ c = r := (T.map_comp _ _).symm.trans
    (congrArg T.map (envelopingAssocWeightedBlockTensorIso_contraction O B d Q))
  have h2 : c ≫ n = s ≫ q := envelopingAssocWeightedRouteAInterchange O B d Q
  have h3 : q ≫ f = g := (T.map_comp _ _).symm.trans
    (congrArg T.map (envelopingAssocWeightedLeafCoefficient_comp O B d Q))
  have h := weightedRouteAFiring a r n f b c s q g h1 h2 h3
  have hleft : envelopingAssocWeightedRepresentativeRouteA O B d Q = a ≫ r ≫ n ≫ f := rfl
  have hright : envelopingAssocWeightedCommonEvaluationA O B d Q = a ≫ b ≫ s ≫ g := by
    have hread : (envelopingAssocWeightedBlockNormalizationIso O.toCollection B d Q).hom = a
      ≫ b ≫ s := rfl
    exact (envelopingAssocWeightedCommonEvaluationA_readback O B d Q).trans
      ((congrArg (· ≫ g) hread).trans (weightedRouteAFourAssoc a b s g))
  exact hleft.trans (h.trans hright.symm)


end CategoryTheory.Operad.Tensor.Enveloping


end
