/- Exact checked source: ReflexiveOperad.Tensor. -/
section EnvelopingSource332


/-!
# The actual finite tensor of the original reflexive coequalizers

Separate preservation and finite diagonal finality prove that simultaneous
original projections form the coequalizer of the simultaneous original
relation maps. The common section is the original full operad map.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C]
variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)
variable (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)

/-- The original heterogeneous finite tensor of target coefficients. -/
abbrev tensorSource (S : FiniteFamily (ColoredProfile W)) : C :=
  (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.map Q.toCollection).obj S)

/-- The original heterogeneous finite tensor of quotient coefficients. -/
abbrev tensorPoint (S : FiniteFamily (ColoredProfile W)) : C :=
  (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.map (collection f g)).obj S)

/-- The tensor of the original, unchanged coefficient projections. -/
def tensorπ (S : FiniteFamily (ColoredProfile W)) : tensorSource (Q := Q) S ⟶ tensorPoint f g S :=
  (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans (collectionπ f g)).app S)

/-- The diagonal reflexive coefficient relation tensor diagram. -/
def tensorDiagram (S : FiniteFamily (ColoredProfile W)) : WalkingReflexivePair ⥤ C :=
  FiniteMultifunctor.finiteSiftedDiagram (fixedIndexTensorFunctor S.index)
    (fun i => coefficientDiagram f g t hf hg (S.obj i))

/-- Its actual cocone tensors all the original pointwise quotient maps. -/
def tensorCocone (S : FiniteFamily (ColoredProfile W)) : Cocone (tensorDiagram f g t hf hg S) :=
  FiniteMultifunctor.finiteSiftedCocone (fixedIndexTensorFunctor S.index)
    (fun i => coefficientCocone f g t hf hg (S.obj i))

/-- The cocone point is the literal tensor of the pointwise coequalizers. -/
theorem tensorCocone_point (S : FiniteFamily (ColoredProfile W)) :
    (tensorCocone f g t hf hg S).pt = tensorPoint f g S := rfl

omit [HasColimitsOfSize.{us, us} C] in
/-- The target vertex is the literal original target coefficient tensor. -/
theorem tensorDiagram_zero (S : FiniteFamily (ColoredProfile W)) :
    (tensorDiagram f g t hf hg S).obj WalkingReflexivePair.zero =
      tensorSource (Q := Q) S := rfl

/-- The target leg is precisely the original tensor quotient projection. -/
@[simp]
theorem tensorCocone_π (S : FiniteFamily (ColoredProfile W)) :
    (tensorCocone f g t hf hg S).ι.app WalkingReflexivePair.zero = tensorπ f g S := rfl

omit [HasColimitsOfSize.{us, us} C] in
/-- The first simultaneous relation face is the original tensor of f. -/
@[simp]
theorem tensorDiagram_left (S : FiniteFamily (ColoredProfile W)) :
    (tensorDiagram f g t hf hg S).map WalkingReflexivePair.Hom.left =
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans f.toCollectionHom).app S) := rfl

omit [HasColimitsOfSize.{us, us} C] in
/-- The second simultaneous relation face is the original tensor of g. -/
@[simp]
theorem tensorDiagram_right (S : FiniteFamily (ColoredProfile W)) :
    (tensorDiagram f g t hf hg S).map WalkingReflexivePair.Hom.right =
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans g.toCollectionHom).app S) := rfl

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Source slot preservation and actual reflexive diagonal finality produce
the full tensor coequalizer, with no descended-operation premise. -/
def tensorIsColimit (S : FiniteFamily (ColoredProfile W)) :
    IsColimit (tensorCocone f g t hf hg S) := by
  letI : DecidableEq S.index := Classical.decEq _
  letI : EssentiallySmall.{us} WalkingReflexivePair := essentiallySmallSelf WalkingReflexivePair
  letI := FiniteTensorPreservesColimitsInEachSlot.preserves (C := C) S.index
  exact FiniteMultifunctor.isColimitFiniteSiftedCocone (fixedIndexTensorFunctor S.index)
    (fun i => coefficientIsColimit f g t hf hg (S.obj i))

include t hf hg in
/-- The original tensor projection detects every map from the quotient tensor. -/
theorem tensor_hom_ext (S : FiniteFamily (ColoredProfile W)) {Y : C}
    {h k : tensorPoint f g S ⟶ Y} (eq : tensorπ f g S ≫ h = tensorπ f g S ≫ k) : h = k :=
  Cofork.IsColimit.hom_ext
    ((ReflexiveCofork.isColimitEquiv (tensorDiagram f g t hf hg S)
      (tensorCocone f g t hf hg S)).symm (tensorIsColimit f g t hf hg S)) eq

include t hf hg in
/-- The tensor of all original pointwise coequalizer projections is epic. -/
theorem tensorπ_epi (S : FiniteFamily (ColoredProfile W)) : Epi (tensorπ f g S) :=
  ⟨fun _ _ eq => tensor_hom_ext f g t hf hg S eq⟩

/-- The complete descent of a map balanced against the original
simultaneous relation tensor faces. -/
def tensorDesc (S : FiniteFamily (ColoredProfile W)) {Y : C}
    (h : tensorSource (Q := Q) S ⟶ Y)
    (balance :
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans f.toCollectionHom).app S) ≫ h =
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans g.toCollectionHom).app
          S) ≫ h) :
    tensorPoint f g S ⟶ Y :=
  (tensorIsColimit f g t hf hg S).desc (ReflexiveCofork.mk h balance)

@[reassoc (attr := simp)]
theorem tensorπ_desc (S : FiniteFamily (ColoredProfile W)) {Y : C}
    (h : tensorSource (Q := Q) S ⟶ Y)
    (balance :
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans f.toCollectionHom).app S) ≫ h =
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapNatTrans g.toCollectionHom).app
          S) ≫ h) :
    tensorπ f g S ≫ tensorDesc f g t hf hg S h balance = h :=
  (tensorIsColimit f g t hf hg S).fac (ReflexiveCofork.mk h balance) WalkingReflexivePair.zero


end CategoryTheory.Operad.ColoredOperadObj.Reflexive

end
