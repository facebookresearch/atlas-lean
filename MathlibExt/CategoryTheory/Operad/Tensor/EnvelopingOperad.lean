/- Exact checked source: WeightedNormalization.ConstantBranchRouteA. -/
section EnvelopingSource269


/-!
# Literal local frozen contractions identify the inside-first branching route
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem scalarRootFiring {D : Type*} [Category* D] {A B C E F : D}
    (p : A ⟶ B) (e : B ⟶ A) (q : A ⟶ C) (c : C ⟶ E) (h : E ⟶ F)
    (s : A ⟶ E) (k : A ⟶ F) (hp : p ≫ e = 𝟙 A) (hq : q ≫ c = s) (hh : s ≫ h = k) :
    (p ≫ (e ≫ q)) ≫ c ≫ h = k := by
  calc
    (p ≫ (e ≫ q)) ≫ c ≫ h = (p ≫ e) ≫ (q ≫ c) ≫ h := by simp only [Category.assoc]
    _ = k := by rw [hp, hq, Category.id_comp, hh]

private theorem singletonUnitFiring {D : Type*} [Category* D] {A B C E : D}
    (e : A ≅ B) (n : A ⟶ C) (q : B ⟶ C) (r : C ⟶ E) (t : E ⟶ B)
    (hn : q = e.inv ≫ n) (hu : q ≫ r ≫ t = 𝟙 B) : n ≫ r ≫ t = e.hom := by
  apply (cancel_epi e.inv).1
  exact (Category.assoc e.inv n (r ≫ t)).symm.trans
    ((congrArg (· ≫ r ≫ t) hn.symm).trans (hu.trans e.inv_hom_id.symm))

private theorem mapThreeBranchA {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem branchSourceFiring {D : Type*} [Category* D] {A B C E F G : D}
    (x : A ⟶ B) (f : B ⟶ C) (g : C ⟶ E) (h : E ⟶ F) (p : A ⟶ G) (l : G ⟶ C) (m : G ⟶ F)
    (hp : x ≫ f = p ≫ l) (hl : l ≫ g ≫ h = m) : x ≫ f ≫ g ≫ h = p ≫ m := by
  exact (Category.assoc x f (g ≫ h)).symm.trans ((congrArg (· ≫ g ≫ h) hp).trans
    ((Category.assoc p l (g ≫ h)).trans (congrArg (p ≫ ·) hl)))

private theorem branchRouteFiring {D : Type*} [Category* D] {A B C E F G H J : D}
    (x : A ⟶ B) (f : B ⟶ C) (g : C ⟶ E) (s : E ⟶ F) (q : F ⟶ G) (k : G ⟶ H)
    (h : E ⟶ J) (s' : J ⟶ G) (n : A ⟶ J)
    (hs : s ≫ q = h ≫ s') (hn : x ≫ f ≫ g ≫ h = n) :
    x ≫ (f ≫ g ≫ s) ≫ (q ≫ k) = n ≫ s' ≫ k := by
  calc
    x ≫ (f ≫ g ≫ s) ≫ (q ≫ k) = x ≫ f ≫ g ≫ (s ≫ q) ≫ k := by simp only [Category.assoc]
    _ = x ≫ f ≫ g ≫ (h ≫ s') ≫ k := congrArg (fun z => x ≫ f ≫ g ≫ z ≫ k) hs
    _ = (x ≫ f ≫ g ≫ h) ≫ s' ≫ k := by simp only [Category.assoc]
    _ = n ≫ s' ≫ k := congrArg (· ≫ s' ≫ k) hn

private theorem factorIntoRoot {D : Type*} [Category* D] {A B C E F G : D}
    (p : A ⟶ B) (f : B ⟶ C) (g : C ⟶ E) (s : E ⟶ F) (h : F ⟶ G) :
    p ≫ (f ≫ g) ≫ s ≫ h = (p ≫ f) ≫ (g ≫ s ≫ h) := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual branch frozen partial operation and original root-constant
left unit give precisely the displayed original inside-first factors. -/
theorem appliedMapA_collapse (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    appliedMapA E s Q ≫ ColoredOperadObj.AssocInsertion.groupingAToFactorsHom
      E.toCollection E.subst (assocData s Q) ≫
      (ColoredOperadObj.substitutionFactors E.toCollection).map (afterInnerCompare s Q) =
        collapsedFactorsA E s Q := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with | none => rfl | some i => cases i <;> rfl
  · intro i
    cases i with
    | none =>
      let X := E.toCollection.obj (extendProfile s.outerProfile (Q none))
      let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) ((FiniteFamily.singleton
        (C := C)).obj X)).hom
      let e := T.map (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
        ((FiniteFamily.singleton (C := C)).obj X)).hom
      let f := envelopingRepresentativeOuterHom s Q ≫
        ColoredSubstitutionData.outerProfileMap (middleCompare s Q)
      let q := T.map ((FiniteFamily.singleton (C := C)).map (E.toCollection.map f))
      let c := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (assocData s
        Q).middleData.outerProfile)
      let h := E.toCollection.map (ColoredSubstitutionData.outerProfileMap (d :=
        (assocData s Q).outerAfterInnerData)
        (afterInnerCompare s Q))
      let v := (FiniteTensor.singletonIso (V := C)).hom.app X
      let k := E.toCollection.map (generalOuterHom s (Q none))
      have hp : p ≫ e = 𝟙 _ := ZeroVariable.emptyPrefix_unit (FintypeCat.of (Fin 0))
        ((FiniteFamily.singleton (C :=
        C)).obj X)
      have hq : q ≫ c = v ≫ E.toCollection.map f := (FiniteTensor.singletonIso (V :=
        C)).hom.naturality
        (E.toCollection.map f)
      have hf : E.toCollection.map f ≫ h = k := (E.toCollection.map_comp _ _).symm.trans
        (congrArg E.toCollection.map ((Category.assoc _ _ _).trans (rootProfile_readback s Q)))
      have hh : (v ≫ E.toCollection.map f) ≫ h = v ≫ k :=
        (Category.assoc _ _ _).trans (congrArg (v ≫ ·) hf)
      have hm : T.map (localUnitMapA E s Q none) = e ≫ q := T.map_comp _ _
      change HEq ((p ≫ T.map (localUnitMapA E s Q none)) ≫ c ≫ h) (v ≫ k)
      exact heq_of_eq ((congrArg (fun n => (p ≫ n) ≫ c ≫ h) hm).trans
        (scalarRootFiring p e q c h (v ≫ E.toCollection.map f) (v ≫ k) hp hq hh))
    | some i =>
      cases i with
      | inl i =>
        let P := s.inner.obj i
        let Q' := Q (some i)
        let a := frozenSubstitutionCoefficientTensorMap E P Q' (Constants.branches Q')
        let σ := E.subst.app (frozenSubstitution P Q' (Constants.branches Q'))
        let h := E.toCollection.map (Constants.substitutionTotalHom P Q')
        let r := frozenPartialSubstitution E P Q' (Constants.branches Q') ≫ E.toCollection.map
          (Constants.totalProfileHom P Q')
        change HEq (a ≫ σ ≫ h) (r ≫ 𝟙 _)
        exact heq_of_eq ((Constants.nullaryPartial_normalized E P Q').symm.trans
          (Category.comp_id r).symm)
      | inr i =>
        let P := ColoredProfile.nullary ((Q none).obj i).as
        let X := E.toCollection.obj P
        let e := (FiniteTensor.singletonIso (V := C)).app X
        let n := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton
          (C := C)).obj X)).hom ≫
          T.map (Constants.leftFrozenUnitMap E P)
        let q := ColoredOperadObj.leftUnitInsert E.toCollection E.unit P
        let r := E.subst.app (ColoredSubstitutionData.leftUnit P)
        let t := E.toCollection.map (ColoredSubstitutionData.leftUnitTotalHom P)
        change HEq (n ≫ r ≫ t) (e.hom ≫ 𝟙 X)
        exact heq_of_eq ((singletonUnitFiring e n q r t (Constants.leftUnitInsert_normalized
          E P) (E.left_unit P)).trans
          (Category.comp_id e.hom).symm)

/-- The literal inside-first E-association route is the literal original
branch contractions followed by the generalized root substitution. -/
theorem associationRouteA_isInside (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    expandedSource E s Q ≫ ColoredOperadObj.associativityRouteA E.toCollection E.subst
      (assocData s Q) ≫
      E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s Q)
        ≫ generalTotalHom s (Q none))
        = insideRoute E s Q := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData s Q
  let a := afterInnerCompare s Q
  let x := expandedSource E s Q
  let f := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingA E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingAToFactorsHom E.toCollection E.subst d)
  let σ := E.subst.app d.outerAfterInnerData
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap a)
  let k := E.toCollection.map (generalTotalHom s (Q none))
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map a
  let σ' := E.subst.app (generalSubstitution s (Q none))
  let p := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q)
  let l := T.map (appliedMapA E s Q)
  let m := T.map (collapsedFactorsA E s Q)
  let n := p ≫ m
