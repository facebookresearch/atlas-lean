/- Exact checked source: CoefficientBlockInterchangeRelabeling. -/
section EnvelopingSource152


/-!
# Finite coefficient/input interchange respects every original block bijection
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- Every original coefficient map is retained over the original block bijection. -/
def coefficientBlockRelabelMap {I J : FintypeCat.{0}} (e : I ≃ J) {K : I → C} {K' : J → C}
    (k : ∀ i, K i ⟶ K' (e i)) : coefficientBlockFamily I K ⟶ coefficientBlockFamily J K' where
  equiv := e
  hom := k

/-- Every original input family map is retained over the original block bijection. -/
def inputBlockRelabelMap {I J : FintypeCat.{0}} (e : I ≃ J) {L : I →
  FiniteFamily C} {L' : J → FiniteFamily C}
    (l : ∀ i, L i ⟶ L' (e i)) : inputBlockFamily I L ⟶ inputBlockFamily J L' where
  equiv := e
  hom := l

/-- The actual coefficient/input block map retains the complete original bijection. -/
def combinedInputBlockRelabelMap {I J : FintypeCat.{0}} (e : I ≃ J)
    {K : I → C} {K' : J → C} {L : I → FiniteFamily C} {L' : J → FiniteFamily C}
    (k : ∀ i, K i ⟶ K' (e i)) (l : ∀ i, L i ⟶ L' (e i)) :
    combinedInputBlocks I K L ⟶ combinedInputBlocks J K' L' where
  equiv := e
  hom i := coefficientLeafMap (k i) (l i)

/-- Actual coefficient/input block interchange is natural for an
arbitrary original block permutation and every original internal input map. -/
theorem coefficientBlockInterchangeFamilyIso_relabel {I J : FintypeCat.{0}} (e : I ≃ J)
    {K : I → C} {K' : J → C} {L : I → FiniteFamily C} {L' : J → FiniteFamily C}
    (k : ∀ i, K i ⟶ K' (e i)) (l : ∀ i, L i ⟶ L' (e i)) :
    (FiniteFamily.flatten (C := C)).map (combinedInputBlockRelabelMap e k l) ≫
        (coefficientBlockInterchangeFamilyIso J K' L').hom =
      (coefficientBlockInterchangeFamilyIso I K L).hom ≫ (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (coefficientBlockRelabelMap e k)
          ((FiniteFamily.flatten (C := C)).map (inputBlockRelabelMap e l))) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases j with
    | none =>
      change HEq (k i ≫ 𝟙 _) (𝟙 _ ≫ k i)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some j =>
      change HEq ((l i).hom j ≫ 𝟙 _) (𝟙 _ ≫ (l i).hom j)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

private theorem originalThreeRelabelSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable [FiniteTensor C]

/-- The actual weighted block map retains the original block permutation. -/
def weightedInputBlockRelabelMap {I J : FintypeCat.{0}} (e : I ≃ J)
    {K : I → C} {K' : J → C} {L : I → FiniteFamily C} {L' : J → FiniteFamily C}
    (k : ∀ i, K i ⟶ K' (e i)) (l : ∀ i, L i ⟶ L' (e i)) :
    weightedInputBlockFamily I K L ⟶ weightedInputBlockFamily J K' L' :=
  (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (combinedInputBlockRelabelMap e k l)

/-- The actual full tensor interchange square preserves every
original outer block bijection, coefficient map and internal input map. -/
theorem coefficientBlockInterchangeTensorIso_relabel {I J : FintypeCat.{0}} (e : I ≃ J)
    {K : I → C} {K' : J → C} {L : I → FiniteFamily C} {L' : J → FiniteFamily C}
    (k : ∀ i, K i ⟶ K' (e i)) (l : ∀ i, L i ⟶ L' (e i)) :
    (FiniteTensor.tensor (V := C)).map (weightedInputBlockRelabelMap e k l) ≫
        (coefficientBlockInterchangeTensorIso J K' L').hom =
      (coefficientBlockInterchangeTensorIso I K L).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (coefficientBlockRelabelMap e k))
            ((FiniteFamily.flatten (C := C)).map (inputBlockRelabelMap e l))) := by
  let T := FiniteTensor.tensor (V := C)
  let c := combinedInputBlockRelabelMap e k l
  let g := (FiniteFamily.flatten (C := C)).map (inputBlockRelabelMap e l)
  let f := coefficientBlockRelabelMap e k
  let n := coefficientLeavesNestedMap f g
  have h1 := (FiniteTensor.flattenIso (V := C)).inv.naturality c
  have h2 : T.map ((FiniteFamily.flatten (C := C)).map c) ≫
    T.map (coefficientBlockInterchangeFamilyIso J K' L').hom =
      T.map (coefficientBlockInterchangeFamilyIso I K L).hom ≫
        T.map ((FiniteFamily.flatten (C := C)).map n) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (coefficientBlockInterchangeFamilyIso_relabel e k l)).trans (T.map_comp _ _))
  have h3 : T.map ((FiniteFamily.flatten (C := C)).map n) ≫
        (coefficientLeavesNormalizationIso (coefficientBlockFamily J K') (totalBlockInputs J
          L')).hom =
      (coefficientLeavesNormalizationIso (coefficientBlockFamily I K) (totalBlockInputs I L)).hom ≫
        T.map (coefficientLeafMap (T.map f) g) := by
    rw [coefficientLeavesNormalizationIso_hom, coefficientLeavesNormalizationIso_hom]
    exact coefficientLeavesNormalization_naturality f g
  exact originalThreeRelabelSquares (T.map (weightedInputBlockRelabelMap e k l))
    ((FiniteTensor.flattenIso (V := C)).inv.app (combinedInputBlocks I K L))
    ((FiniteTensor.flattenIso (V := C)).inv.app (combinedInputBlocks J K' L'))
    (T.map ((FiniteFamily.flatten (C := C)).map c))
    (T.map (coefficientBlockInterchangeFamilyIso I K L).hom)
    (T.map (coefficientBlockInterchangeFamilyIso J K' L').hom)
    (T.map ((FiniteFamily.flatten (C := C)).map n))
    ((coefficientLeavesNormalizationIso (coefficientBlockFamily I K) (totalBlockInputs I L)).hom)
    ((coefficientLeavesNormalizationIso (coefficientBlockFamily J K') (totalBlockInputs J L')).hom)
    (T.map (coefficientLeafMap (T.map f) g)) h1 h2 h3


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource152

