  let f := T.map (frozenUnitCoefficientMap E (ColoredProfile.nullary c) (generatorInputs c)
    (branches (generatorInputs
    c)))
  let g := T.map ((ColoredOperadObj.substitutionFactors E.toCollection).map (generatorShapeMap c))
  let e := T.map (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) K).hom
  let k := T.map (generatorLeftCoefficient E c)
