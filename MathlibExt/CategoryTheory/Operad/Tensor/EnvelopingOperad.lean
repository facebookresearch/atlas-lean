/- Exact checked source: LinearAlgebra.ExtendedInput. -/
section EnvelopingSource226


/-!
# The original algebra input map into the extended O-substitution source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root B-unit positions, all original coefficient
and B-input positions, and every original M-variable leaf are the
literal input positions of the extended O-substitution. -/
def extendedInputEquiv (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (frozenVariableUnitFamily (Q none).index (substitutionExpandedFamily O B M s Q)).index ≃
      ((FiniteFamily.flatten (C := C)).obj
        (nestedOperationFactors O M (envelopingRepresentativeSubstitution s Q))).index where
  toFun p := match p with
    | Sum.inl j => ⟨some (Sum.inr j), none⟩
    | Sum.inr ⟨none, ⟨none, none⟩⟩ => ⟨none, PUnit.unit⟩
    | Sum.inr ⟨none, ⟨none, some j⟩⟩ => ⟨some (Sum.inr j), some PUnit.unit⟩
    | Sum.inr ⟨none, ⟨some i, none⟩⟩ => ⟨some (Sum.inl i), none⟩
    | Sum.inr ⟨none, ⟨some i, some j⟩⟩ => ⟨some (Sum.inl i), some (Sum.inr j)⟩
    | Sum.inr ⟨some ⟨i, j⟩, _⟩ => ⟨some (Sum.inl i), some (Sum.inl j)⟩
  invFun p := match p with
    | ⟨none, _⟩ => Sum.inr ⟨none, ⟨none, none⟩⟩
    | ⟨some (Sum.inl i), none⟩ => Sum.inr ⟨none, ⟨some i, none⟩⟩
    | ⟨some (Sum.inl i), some (Sum.inl j)⟩ => Sum.inr ⟨some ⟨i, j⟩, PUnit.unit⟩
    | ⟨some (Sum.inl i), some (Sum.inr j)⟩ => Sum.inr ⟨none, ⟨some i, some j⟩⟩
    | ⟨some (Sum.inr j), none⟩ => Sum.inl j
    | ⟨some (Sum.inr j), some _⟩ => Sum.inr ⟨none, ⟨none, some j⟩⟩
  left_inv p := by
    cases p with
    | inl p => rfl
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with
      | none =>
        rcases j with ⟨i, j⟩
        cases i <;> cases j <;> rfl
      | some i => cases j; rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i =>
      cases i with
      | inl i => cases j with
        | none => rfl
        | some j => cases j <;> rfl
      | inr i => cases j with
        | none => rfl
        | some j => cases j; rfl

/-- Every original B input uses the given original map g; every
M-variable uses its original identity; the original root coefficient
uses its exact original profile map and every retained root B position
uses the original O-unit. -/
def extendedInputFactors (O : ColoredOperadObj W C) (B M : W → C) (g : B ⟶ M)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    frozenVariableUnitFamily (Q none).index (substitutionExpandedFamily O.toCollection B M s Q) ⟶
      (FiniteFamily.flatten (C := C)).obj
        (nestedOperationFactors O.toCollection M (envelopingRepresentativeSubstitution s Q)) where
  equiv := extendedInputEquiv O.toCollection B M s Q
  hom p := match p with
    | Sum.inl j => O.unit ((Q none).obj j).as
    | Sum.inr ⟨none, ⟨none, none⟩⟩ => O.toCollection.map (envelopingRepresentativeOuterHom s Q)
    | Sum.inr ⟨none, ⟨none, some j⟩⟩ => g ((Q none).obj j).as
    | Sum.inr ⟨none, ⟨some _i, none⟩⟩ => 𝟙 _
    | Sum.inr ⟨none, ⟨some i, some j⟩⟩ => g ((Q (some i)).obj j).as
    | Sum.inr ⟨some ⟨i, j⟩, _⟩ => 𝟙 (M ((s.inner.obj i).inputColor j))

/-- The complete original coefficient/B/variable input tensor maps
to the actual original extended O-algebra substitution source by
original expansion, unit insertion and the above exact finite map. -/
def extendedEvaluationInput (O : ColoredOperadObj W C) (B M : W → C) (g : B ⟶ M)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).obj
        ((FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily
          O.toCollection B s Q)) ⟶
      algebraSubstitutionSource O.toCollection M (envelopingRepresentativeSubstitution s Q) :=
  (substitutionExpandedSourceIso O.toCollection B M s Q).hom ≫
    (frozenVariableTensorUnitIso (Q none).index (substitutionExpandedFamily O.toCollection B
      M s Q)).hom ≫
    (FiniteTensor.tensor (V := C)).map (extendedInputFactors O B M g s Q)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
