      coefficientLeafMap (T.map k ≫ envelopingAssocMiddleCoefficientSubstitution O d Q)
        (envelopingAssocMiddleLeafIso B d Q).hom := by
    exact (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg₂ (fun coeff leaf => coefficientLeafMap coeff leaf)
        (Category.assoc (T.map k) a (O.toCollection.map f)) hleaf)
  let n := coefficientBlockInterchangeTensorIso (FintypeCat.of (Option d.branches.index))
    (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile d.middleData i) (q i)))
    (fun i => (addedAlgebraInputs B).obj (q i))
