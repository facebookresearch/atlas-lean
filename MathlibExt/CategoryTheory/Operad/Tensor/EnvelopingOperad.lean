/-!
# Original root and unary branch prefixes after coefficient normalization

The original empty-leaf normalization gives the root singleton inverse.
At each original added input, the empty-coefficient normalization and
original colored unit map give exactly the actual unary generator.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

open CategoryTheory

private theorem rootPrefixFromNormalization {C : Type*} [Category* C]
    {X A B D E : C} (u : X ⟶ A) (r : A ⟶ B) (n : B ⟶ D) (g : D ⟶ E)
    (e : E ≅ X) (v : B ⟶ A) (s : A ⟶ X)
    (hr : r ≫ v = 𝟙 A) (hs : u ≫ s = 𝟙 X) (hn : n ≫ g ≫ e.hom = v ≫ s) :
    (u ≫ r) ≫ (n ≫ g) = e.inv := by
  apply (cancel_mono e.hom).1
  simp only [Category.assoc]
  rw [hn, ← Category.assoc r v, hr, Category.id_comp, hs, e.inv_hom_id]

private theorem unaryPrefixFromSquares {C : Type*} [Category* C]
    {X A B D E E0 F G G0 : C}
    (u : X ⟶ A) (h : A ⟶ D) (a : D ⟶ E) (b : E ⟶ F) (g : F ⟶ G)
    (v : A ⟶ B) (p : B ⟶ D) (a0 : B ⟶ E0) (q : E0 ⟶ E)
    (f : E0 ⟶ G0) (z : G0 ⟶ G)
    (he : h = v ≫ p) (hn : p ≫ a = a0 ≫ q) (hf : q ≫ b ≫ g = f ≫ z) :
    (u ≫ h) ≫ ((a ≫ b) ≫ g) = ((u ≫ v ≫ a0) ≫ f) ≫ z := by
  simp only [Category.assoc]
  rw [he]
  simp only [Category.assoc]
  rw [← Category.assoc p a, hn]
  simp only [Category.assoc]
  rw [hf]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual raw root prefix and its actual singleton coefficient
normalization are the original empty-leaf tensor inverse. -/
theorem rootRaw_tensor_prefix (X : C) :
    ((FiniteTensor.singletonIso (V := C)).inv.app X ≫
      (FiniteTensor.tensor (V := C)).map (emptyLeafRawIso ((FiniteFamily.singleton (C :=
        C)).obj X)).inv) ≫
      (coefficientLeavesNormalization ((FiniteFamily.singleton (C :=
        C)).obj X) (FiniteFamily.empty : FiniteFamily C) ≫
        (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map
          ((FiniteTensor.singletonIso (V := C)).hom.app X)) = (emptyLeafTensorIso X).inv := by
  let T := FiniteTensor.tensor (V := C)
  let K := (FiniteFamily.singleton (C := C)).obj X
  let e := emptyLeafRawIso K
  have hr : T.map e.inv ≫ T.map e.hom = 𝟙 _ :=
    (T.map_comp _ _).symm.trans ((congrArg T.map e.inv_hom_id).trans (T.map_id _))
  exact rootPrefixFromNormalization ((FiniteTensor.singletonIso (V := C)).inv.app X)
    (T.map e.inv) (coefficientLeavesNormalization K (FiniteFamily.empty : FiniteFamily C))
    ((coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map
      ((FiniteTensor.singletonIso (V := C)).hom.app X))
    (emptyLeafTensorIso X) (T.map e.hom) ((FiniteTensor.singletonIso (V := C)).hom.app X)
    hr ((FiniteTensor.singletonIso (V := C)).inv_hom_id_app X)
    (coefficientLeavesNormalization_empty_map K ((FiniteTensor.singletonIso (V := C)).hom.app X))

omit [FiniteTensor C] in
/-- Compare the original left-prefix empty/singleton blocks with
the original empty-coefficient singleton-leaf blocks at every position. -/
def unaryNestedIso (X : C) :
    UnitInsertion.leftNestedFamily X ≅
      coefficientLeavesNested (FiniteFamily.empty : FiniteFamily C) ((FiniteFamily.singleton
        (C := C)).obj X) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option PUnit)) (fun i => match i with
    | none => Iso.refl FiniteFamily.empty
    | some _ => Iso.refl ((FiniteFamily.singleton (C := C)).obj X))

/-- The original unary analytic factors and their original scalar
coefficient/singleton-leaf presentation retain every coefficient and input. -/
def unaryFactorIso (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    (analyticFactors O.toCollection B).obj (AnalyticIndex.unary (d := c) c) ≅
      (coefficientLeafFamilyFunctor ((FiniteFamily.singleton (C := C)).obj (B c))).obj
        (O.toCollection.obj (ColoredSubstitutionData.unitProfile c)) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option PUnit)) (fun i => match i with
    | none => Iso.refl (O.toCollection.obj (ColoredSubstitutionData.unitProfile c))
    | some _ => Iso.refl (B c))

omit [FiniteTensor C] in
/-- The exact original singleton source map commutes with the
original empty/singleton nested-family comparison. -/
theorem unaryCoefficient_source_map (X : C) :
    (unitCoefficientFlattenIso ((FiniteFamily.singleton (C := C)).obj X)).hom =
      UnitInsertion.leftSingletonToFlatten X ≫
        (FiniteFamily.flatten (C := C)).map (unaryNestedIso X).hom := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i
    rfl
  · intro i
    cases i
    change HEq (𝟙 X) (𝟙 X ≫ 𝟙 X)
    exact heq_of_eq (Category.id_comp _).symm

/-- The original colored unit factor map commutes with the actual
nested comparison and original scalar coefficient/leaf presentation. -/
theorem unaryCoefficient_factor_map (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (unaryNestedIso (B c)).hom ≫
      coefficientLeavesCollapse (FiniteFamily.empty : FiniteFamily C)
        ((FiniteFamily.singleton (C := C)).obj (B c)) ≫
        (coefficientLeafFamilyFunctor ((FiniteFamily.singleton (C :=
          C)).obj (B c))).map (O.unit c) =
      unitFactors O B c ≫ (unaryFactorIso O B c).hom := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 FiniteFamily.empty) ≫ 𝟙 _ ≫ O.unit c)
        (O.unit c ≫ 𝟙 _)
      exact heq_of_eq ((congrArg (fun f => f ≫ 𝟙 _ ≫ O.unit c)
        ((FiniteTensor.tensor (V := C)).map_id FiniteFamily.empty)).trans
          ((Category.id_comp _).trans ((Category.id_comp (O.unit c)).trans (Category.comp_id
            _).symm)))
    | some i =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C :=
        C)).obj (B c))) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (B c) ≫ 𝟙 _)
        ((FiniteTensor.singletonIso (V := C)).hom.app (B c) ≫ 𝟙 _)
      exact heq_of_eq ((congrArg (fun f => f ≫ (FiniteTensor.singletonIso (V :=
        C)).hom.app (B c) ≫ 𝟙 _)
        ((FiniteTensor.tensor (V := C)).map_id _)).trans (Category.id_comp _))

/-- Actual raw singleton-input normalization and the original colored
unit retain the original unary generator and its exact factor comparison. -/
theorem unaryRaw_tensor_prefix (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    ((FiniteTensor.singletonIso (V := C)).inv.app (B c) ≫
      (FiniteTensor.tensor (V := C)).map
        (unitCoefficientFlattenIso ((FiniteFamily.singleton (C := C)).obj (B c))).hom) ≫
      (coefficientLeavesNormalization (FiniteFamily.empty : FiniteFamily C)
          ((FiniteFamily.singleton (C := C)).obj (B c)) ≫
        (coefficientLeafTensorFunctor ((FiniteFamily.singleton (C :=
          C)).obj (B c))).map (O.unit c)) =
      unitInsertion O B c ≫ (FiniteTensor.tensor (V := C)).map (unaryFactorIso O B c).hom := by
  let T := FiniteTensor.tensor (V := C)
  let X := B c
  let N := coefficientLeavesNested (FiniteFamily.empty : FiniteFamily C)
    ((FiniteFamily.singleton (C := C)).obj X)
  let u := (FiniteTensor.singletonIso (V := C)).inv.app X
  let h := T.map (unitCoefficientFlattenIso ((FiniteFamily.singleton (C := C)).obj X)).hom
  let v := T.map (UnitInsertion.leftSingletonToFlatten X)
  let p := T.map ((FiniteFamily.flatten (C := C)).map (unaryNestedIso X).hom)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let a0 := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.leftNestedFamily X)
  let q := T.map ((FiniteFamily.map T).map (unaryNestedIso X).hom)
  let b := T.map (coefficientLeavesCollapse (FiniteFamily.empty : FiniteFamily C)
    ((FiniteFamily.singleton (C := C)).obj
    X))
  let g := T.map ((coefficientLeafFamilyFunctor ((FiniteFamily.singleton (C :=
    C)).obj X)).map (O.unit c))
  let f := T.map (unitFactors O B c)
  let z := T.map (unaryFactorIso O B c).hom
  have he : h = v ≫ p := (congrArg T.map (unaryCoefficient_source_map X)).trans (T.map_comp _ _)
  have hn : p ≫ a = a0 ≫ q := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (unaryNestedIso X).hom
  let q0 := (FiniteFamily.map T).map (unaryNestedIso X).hom
  let b0 := coefficientLeavesCollapse (FiniteFamily.empty : FiniteFamily C)
    ((FiniteFamily.singleton (C := C)).obj X)
  let g0 := (coefficientLeafFamilyFunctor ((FiniteFamily.singleton (C := C)).obj X)).map (O.unit c)
  have hm : q ≫ b ≫ g = T.map (q0 ≫ b0 ≫ g0) :=
    (congrArg (q ≫ ·) (T.map_comp b0 g0).symm).trans (T.map_comp q0 (b0 ≫ g0)).symm
  have hf : q ≫ b ≫ g = f ≫ z :=
    hm.trans ((congrArg T.map (unaryCoefficient_factor_map O B c)).trans (T.map_comp _ _))
  exact unaryPrefixFromSquares u h a b g v p a0 q f z he hn hf

/-- The original resulting coefficient in every original branch. -/
def scalarCoefficients (O : ColoredOperadObj W C) (P : ColoredProfile W) (Q : ColoredInputs
  W) : Option Q.index → C :=
  (frozenCoefficientFamily O.toCollection P Q (unaryBranches Q)).obj

/-- The actual root empty-leaf inverse and original weighted unary
branches form the original scalar-leaf family comparison. -/
def scalarFrameFamilyMap (O : ColoredOperadObj W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    frozenWeightedBranchFamily O.toCollection B P Q (unaryBranches Q) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (partitionedScalarLeaves (UnitInsertion.rightNestedFamily (O.toCollection.obj
          (extendProfile P Q)) Q.index)
          (prefixLeaves B Q) (scalarCoefficients O P Q)) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => (emptyLeafTensorIso (O.toCollection.obj (extendProfile P Q))).inv
    | some j => (FiniteTensor.tensor (V := C)).map (unaryFactorIso O B (Q.obj j).as).hom

/-- Original raw branch normalization and every original coefficient
unit map are the original unary generator maps and root comparison. -/
theorem rawPrefix_scalar_frame (O : ColoredOperadObj W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    rawPrefixTensorFamilyMap (O.toCollection.obj (extendProfile P Q)) B Q ≫
      partitionedCoefficientLeavesActionMap
        (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index)
        (prefixLeaves B Q) (scalarCoefficients O P Q)
        (unaryCoefficientUnitFactorMap O P Q).hom =
    unaryWeightedInputMap O B P Q ≫ scalarFrameFamilyMap O B P Q := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      exact heq_of_eq ((rootRaw_tensor_prefix (O.toCollection.obj (extendProfile P Q))).trans
        (Category.id_comp _).symm)
    | some j =>
      exact heq_of_eq (unaryRaw_tensor_prefix O B (Q.obj j).as)


end CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

