namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- The original flat-inner variable/middle/root-algebra positions
map by the exact original dependent-sum and disjoint-sum bijection. -/
def envelopingAssocFlatInnerEquiv (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).innerData.inner.index ≃
      (envelopingRepresentativeSubstitution d.innerData (envelopingAssocInnerChoices d
        Q)).inner.index where
  toFun p := match p with
    | ⟨Sum.inl i, Sum.inl j⟩ => Sum.inl ⟨i, j⟩
    | ⟨Sum.inl i, Sum.inr j⟩ => Sum.inr (Sum.inr ⟨i, j⟩)
    | ⟨Sum.inr j, _⟩ => Sum.inr (Sum.inl j)
  invFun p := match p with
    | Sum.inl ⟨i, j⟩ => ⟨Sum.inl i, Sum.inl j⟩
    | Sum.inr (Sum.inl j) => ⟨Sum.inr j, PUnit.unit⟩
    | Sum.inr (Sum.inr ⟨i, j⟩) => ⟨Sum.inl i, Sum.inr j⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j <;> rfl
    | inr i => cases j; rfl
  right_inv p := by
    cases p with
    | inl p => rfl
    | inr p => cases p <;> rfl

/-- Each actual original innermost profile is retained, and
each original root/middle algebra input keeps its actual unary unit profile. -/
def envelopingAssocFlatInnerFamilyMap (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).innerData.inner ⟶
      (envelopingRepresentativeSubstitution d.innerData (envelopingAssocInnerChoices d
        Q)).inner where
  equiv := envelopingAssocFlatInnerEquiv d Q
  hom p := match p with
    | ⟨Sum.inl _, Sum.inl _⟩ => 𝟙 _
    | ⟨Sum.inl _, Sum.inr _⟩ => 𝟙 _
    | ⟨Sum.inr _, _⟩ => 𝟙 _

/-- The actual original flat-inner substitution shape map
retains every original input and root output color. -/
def envelopingAssocFlatInnerMap (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).innerData ⟶
      envelopingRepresentativeSubstitution d.innerData (envelopingAssocInnerChoices d Q) where
  outputColor_eq := rfl
  innerHom := envelopingAssocFlatInnerFamilyMap d Q

/-- The original flat-inner outer profile comparison is exactly
the actual middle total-variable/algebra-input profile bijection. -/
theorem envelopingAssocFlatInnerMap_outer (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ColoredSubstitutionData.outerProfileMap (envelopingAssocFlatInnerMap d Q) =
      envelopingAssocMiddleTotalHom d Q ≫
        envelopingRepresentativeOuterHom d.innerData (envelopingAssocInnerChoices d Q) := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The exact original algebra-input regrouping for root-first
association retains root/middle inputs before original innermost inputs. -/
def envelopingAssocFlatAlgebraInputsMap (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingTotalAlgebraInputs d.innerData (envelopingAssocInnerChoices d Q) ⟶
      envelopingAssocTotalAlgebraInputs d Q where
  equiv :=
    { toFun p := match p with
        | Sum.inl (Sum.inl j) => Sum.inl j
        | Sum.inl (Sum.inr ⟨i, j⟩) => Sum.inr ⟨i, Sum.inl j⟩
        | Sum.inr ⟨⟨i, j⟩, k⟩ => Sum.inr ⟨i, Sum.inr ⟨j, k⟩⟩
      invFun p := match p with
        | Sum.inl j => Sum.inl (Sum.inl j)
        | Sum.inr ⟨i, Sum.inl j⟩ => Sum.inl (Sum.inr ⟨i, j⟩)
        | Sum.inr ⟨i, Sum.inr ⟨j, k⟩⟩ => Sum.inr ⟨⟨i, j⟩, k⟩
      left_inv p := by cases p with
        | inl p => cases p <;> rfl
        | inr p => rfl
      right_inv p := by cases p with
        | inl p => rfl
        | inr p => rcases p with ⟨i, j⟩; cases j <;> rfl }
  hom p := match p with
    | Sum.inl (Sum.inl _) => 𝟙 _
    | Sum.inl (Sum.inr _) => 𝟙 _
    | Sum.inr _ => 𝟙 _

/-- The original flat-inner dependent-sum associator and actual
original algebra-input regrouping are precisely the full original
extended three-level total profile map. -/
theorem envelopingAssocFlatInnerMap_total (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ColoredSubstitutionData.totalProfileMap (envelopingAssocFlatInnerMap d Q) ≫
        envelopingRepresentativeTotalHom d.innerData (envelopingAssocInnerChoices d Q) ≫
        extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q) =
      (envelopingRepresentativeAssoc d Q).totalHom ≫ envelopingAssocTotalHom d Q := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨⟨i, j⟩, k⟩
  cases i with
  | inl i =>
    cases j with
    | inl j => cases k <;> rfl
    | inr j => rfl
  | inr i => rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
