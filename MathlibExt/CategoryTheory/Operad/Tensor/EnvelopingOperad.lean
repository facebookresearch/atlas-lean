/-!
# The original σ/κ algebra balance is exactly the original genuine A-map action equation
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraRelation

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

private theorem reconstructedOperations_heq (O : ColoredOperadObj W C) (B : W → C)
    (M N : Algebra O) (h : M = N) (g : B ⟶ M.carrier) (g' : B ⟶ N.carrier) (hg : HEq g g') :
    HEq (LinearAlgebra.linearOperations O B M g) (LinearAlgebra.linearOperations O B N g') := by
  cases h
  cases hg
  rfl

/-- Original full σ/κ operation balance reads back on the actual
original nullary generators as equality of the two actual reconstructed constant maps. -/
theorem balanced_constants (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingLinearOperad O A.carrier))
    (balance : ColoredOperadObj.Reflexive.AlgebraDescent.Balanced
      (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A) M) :
    linearAlgebraConstants O (profileCoinvariants O.toCollection A.carrier)
      (Algebra.restrict (constantRelationOperadFace O A.carrier) M) =
    linearAlgebraConstants O (profileCoinvariants O.toCollection A.carrier)
      (Algebra.restrict (algebraRelationOperadFace O A) M) := by
  let B := profileCoinvariants O.toCollection A.carrier
  let P := envelopingLinearOperad O B
  let MS := Algebra.restrict (constantRelationOperadFace O A.carrier) M
  let MK := Algebra.restrict (algebraRelationOperadFace O A) M
  have h : MS.operations = MK.operations := balance
  funext d
  let g := linearConstantGenerator O B d
  let n := (nullarySummandIso P.toCollection M.carrier d).inv
  exact congrArg (fun ops : Operations P.toCollection M.carrier M.carrier => g ≫ n ≫
    ops.app d AnalyticIndex.nullary) h

/-- The actual original nullary generator readbacks turn original
σ/κ balance into the whole original A-action equation with computed g_A and M_O. -/
theorem balanced_action (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingLinearOperad O A.carrier))
    (balance : ColoredOperadObj.Reflexive.AlgebraDescent.Balanced
