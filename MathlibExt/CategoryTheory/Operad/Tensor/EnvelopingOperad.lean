/-!
# Exact original constant generator and full-map naturality readbacks
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (c : W) : HasColimitsOfShape (AnalyticIndex W c) C :=
  hasProfileColimitsOfSmallColors C c

/-- The actual parent original free constant generator followed by the
constructed actual full constants operad map is precisely the originally supplied b. -/
theorem operadMap_generator {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (c : W) :
    linearConstantGenerator O B c ≫ (operadMap u B b).toCollectionHom.app
      (ColoredProfile.nullary c) = b c :=
  operadMap_generator_formula u B b c

/-- Every full original linear carrier map retains the actual original
free constant generator and its whole original carrier component. -/
theorem linearConstantGenerator_operadMap_carrier (O : ColoredOperadObj W C) {B B' : W → C}
    (g : B ⟶ B') (c : W) :
    linearConstantGenerator O B c ≫ (linearCarrierOperadMap O g).toCollectionHom.app
      (ColoredProfile.nullary c) =
      g c ≫ linearConstantGenerator O B' c := linearConstantGenerator_naturality O g c

/-- Original generator evaluation retains the literal original full target
map component after the actual original constants operad extension. -/
theorem operadMap_generator_post {O E E' : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (h : E ⟶ E') (c : W) :
    linearConstantGenerator O B c ≫ (operadMap u B b ≫
      h).toCollectionHom.app (ColoredProfile.nullary c) =
      b c ≫ h.toCollectionHom.app (ColoredProfile.nullary c) :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ h.toCollectionHom.app (ColoredProfile.nullary c)) (operadMap_generator u B b c))

/-- Original generator evaluation retains the literal original carrier
component before b through the actual full linear carrier operad map. -/
theorem operadMap_generator_pre {O E : ColoredOperadObj W C} (u : O ⟶ E) {B B' : W → C}
    (g : B ⟶ B') (b : ∀ c, B' c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (c : W) :
    linearConstantGenerator O B c ≫ (linearCarrierOperadMap O g ≫
      operadMap u B' b).toCollectionHom.app
      (ColoredProfile.nullary c) =
      g c ≫ b c :=
  (congrArg (fun f : envelopingLinearOperad O B ⟶ E =>
    linearConstantGenerator O B c ≫ f.toCollectionHom.app (ColoredProfile.nullary c))
      (operadMap_pre u g b)).trans
      (operadMap_generator u B (fun c => g c ≫ b c) c)


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
