original A→M_O action equation, with g_A and M_O computed from the genuine linear algebra. -/
theorem balanced_iff_action (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingLinearOperad O A.carrier)) :
    ColoredOperadObj.Reflexive.AlgebraDescent.Balanced
      (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A) M ↔
    A.action ≫ linearAlgebraConstants O A.carrier M =
      profileMap O.toCollection (linearAlgebraConstants O A.carrier M) ≫
        (linearAlgebraUnderlying O A.carrier M).action
