theorem envelopingOperadNullaryFunctor_map (O : ColoredOperadObj W C) {A B : Algebra O} (f :
  A ⟶ B) (d : W) :
    ((envelopingOperadFunctor O ⋙ operadNullaryCarrierFunctor).map f) d =
      (envelopingOperadMap O f).toCollectionHom.app (ColoredProfile.nullary d) := rfl

/-- The natural comparison retains the unchanged original nullary Iso hom. -/
theorem envelopingOperadNullaryNaturalIso_hom (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    ((envelopingOperadNullaryNaturalIso O).hom.app A) d = (envelopingOperadNullaryIso O A
      d).hom := rfl

/-- The natural comparison retains the unchanged original nullary Iso inverse. -/
theorem envelopingOperadNullaryNaturalIso_inv (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    ((envelopingOperadNullaryNaturalIso O).inv.app A) d = (envelopingOperadNullaryIso O A
      d).inv := rfl

