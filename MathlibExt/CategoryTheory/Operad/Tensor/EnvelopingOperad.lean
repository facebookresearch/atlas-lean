section EnvelopingSource320


/-!
# The actual grouped weighted source map retains every original unit/root/branch block
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem groupedCongrThree {α β γ δ : Sort*} (f : α → β → γ → δ)
    {a a' : α} {b b' : β} {c c' : γ} (ha : a = a') (hb : b = b') (hc : c = c') :
    f a b c = f a' b' c' := by
  cases ha
  cases hb
  cases hc
  rfl

private theorem groupedTailIdentity {D : Type*} [Category* D]
    {X A B Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ Y) (r : X ⟶ Y)
    (h : a ≫ b ≫ c = r) : a ≫ b ≫ c ≫ 𝟙 Y = r := by
  simp only [Category.comp_id]
  exact h

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual grouped empty/singleton source normalization,
original coefficient and original B-leaf maps produce precisely
the original weighted unit/root/branch insertion map. -/
theorem groupedWeightedBlocks_factor (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (groupedWeightedSourceIso
      O.toCollection B P Q R).hom ≫
      groupedCoefficientInputNormalizationMap (coefficientGrouping O.toCollection P Q R)
        (atomicLeaves O.toCollection B P Q R) ≫
      weightedInputBlockMap (coefficientGrouping O.toCollection P Q R).index
        (groupedCoefficientFactor O P Q R) (fun i => (groupedLeafBlockIso O B P Q R i).hom) ≫
      (groupedTargetWeightedIso O B P Q R).hom =
    (frozenVariableBlockIso P.inputs (frozenWeightedBranchFamily O.toCollection B P Q R)).hom ≫
      weightedInsertion O B P Q R := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl _ => rfl
    | inr i => cases i <;> rfl
  · intro i
    let T := FiniteTensor.tensor (V := C)
    cases i with
    | inl i =>
      let A := fun j : Empty => atomicLeaves O.toCollection B P Q R ⟨Sum.inl i, j⟩
      let e := (groupedWeightedSourceIso O.toCollection B P Q R).hom.hom (Sum.inl i)
      let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty)
        (FiniteFamily.empty (C := C)).obj A).hom
      let c := groupedCoefficientFactor O P Q R (Sum.inl i)
      let ell := (groupedLeafBlockIso O B P Q R (Sum.inl i)).hom
      let g := (simpleGroupedLeafIso O B P Q R (Sum.inl i)).hom
      let Pi := ColoredProfile.unary (P.inputColor i) (P.inputColor i)
      let w := O.unit (P.inputColor i) ≫ (emptyLinearSummandIso O.toCollection B Pi).inv
      have he : e = (Linear.UnitGeometry.emptyWeightedIso A).hom := by
        apply FiniteFamily.Hom_ext
        · ext j
          exact j.elim
        · intro j
          exact j.elim
      have hell : ell = (Linear.UnitGeometry.emptyLeavesIso A).hom ≫ g :=
        groupedLeafBlockIso_factor O B P Q R (Sum.inl i)
      have hcore : T.map e ≫ n ≫ T.map (coefficientLeafMap c ell) = w :=
        (congrArg₂ (fun e ell => T.map e ≫ n ≫ T.map (coefficientLeafMap c ell)) he hell).trans
          ((emptyInterchange_leafMap A c g).trans
            (emptyScalarTargetInsertion O.toCollection B Pi (O.unit (P.inputColor i))))
      change HEq (T.map e ≫ n ≫ T.map (coefficientLeafMap c ell) ≫ 𝟙 _) (𝟙 _ ≫ w)
      exact heq_of_eq ((groupedTailIdentity (T.map e) n (T.map (coefficientLeafMap c ell)) w
        hcore).trans
        (Category.id_comp w).symm)
    | inr i => cases i with
      | none =>
        let X := O.toCollection.obj (extendProfile P Q)
        let L : FiniteFamily C := FiniteFamily.empty
        let h := (emptyLeafTensorIso X).inv
        let e := (groupedWeightedSourceIso O.toCollection B P Q R).hom.hom (Sum.inr none)
        let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ =>
          X) (fun _ => L)).hom
        let a := O.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q))
        let c := a ≫ (O.toCollection.mapIso (emptyExtensionProfileIso (shape P Q).outerProfile)).inv
        let f := groupedCoefficientFactor O P Q R (Sum.inr none)
        let ell := (groupedLeafBlockIso O B P Q R (Sum.inr none)).hom
        let g := (simpleGroupedLeafIso O B P Q R (Sum.inr none)).hom
        let s := (FiniteTensor.singletonIso (V := C)).hom.app X
        let w := a ≫ (emptyLinearSummandIso O.toCollection B (shape P Q).outerProfile).inv
        have he : e = (FiniteFamily.singleton (C := C)).map h := by
          apply FiniteFamily.Hom_ext
          · rfl
          · intro j
            cases j
            rfl
        have hf : f = (FiniteTensor.singletonIso (V := C)).hom.app X ≫ c := rfl
        have hell : ell = (singletonCoefficientInputLeafIso L).hom ≫ g :=
          groupedLeafBlockIso_factor O B P Q R (Sum.inr none)
        have hcore : T.map e ≫ n ≫ T.map (coefficientLeafMap f ell) = s ≫ w :=
          (groupedCongrThree (fun e f ell => T.map e ≫ n ≫
            T.map (coefficientLeafMap f ell)) he hf hell).trans
            ((singletonWeightedSource_normalization X X L h c g).trans
              (congrArg (s ≫ ·) (emptyScalarSourceInsertion O.toCollection B (shape P
                Q).outerProfile a)))
        change HEq (T.map e ≫ n ≫ T.map (coefficientLeafMap f ell) ≫ 𝟙 _) (s ≫ w)
        exact heq_of_eq (groupedTailIdentity (T.map e) n (T.map (coefficientLeafMap f ell))
          (s ≫ w) hcore)
      | some j =>
        let X := O.toCollection.obj (R j).toColoredProfile
        let Z := (analyticSummand O.toCollection B).obj (R j)
        let L := profileLeafFamily B (R j).toColoredProfile
        let h := (profileCoefficientLeafTensorIso O.toCollection B (R j).toColoredProfile).inv
        let e := (groupedWeightedSourceIso O.toCollection B P Q R).hom.hom (Sum.inr (some j))
        let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ =>
          X) (fun _ => L)).hom
        let c := (O.toCollection.mapIso (nullaryVariableProfileComponentIso (Q.obj j).as
          (branchInputs (R j)))).inv
        let f := groupedCoefficientFactor O P Q R (Sum.inr (some j))
        let ell := (groupedLeafBlockIso O B P Q R (Sum.inr (some j))).hom
        let g := (simpleGroupedLeafIso O B P Q R (Sum.inr (some j))).hom
        let s := (FiniteTensor.singletonIso (V := C)).hom.app Z
        let w := (nullaryLinearDiagramIso O.toCollection B (Q.obj j).as).inv.app
          (branchInputs (R j))
        have he : e = (FiniteFamily.singleton (C := C)).map h := by
          apply FiniteFamily.Hom_ext
          · rfl
          · intro i
            cases i
            rfl
        have hf : f = (FiniteTensor.singletonIso (V := C)).hom.app X ≫ c := rfl
        have hell : ell = (singletonCoefficientInputLeafIso L).hom ≫ g :=
          groupedLeafBlockIso_factor O B P Q R (Sum.inr (some j))
        have hcore : T.map e ≫ n ≫ T.map (coefficientLeafMap f ell) = s ≫ w :=
          (groupedCongrThree (fun e f ell => T.map e ≫ n ≫
            T.map (coefficientLeafMap f ell)) he hf hell).trans
            ((singletonWeightedSource_normalization X Z L h c g).trans
              (congrArg (s ≫ ·) (branchScalarSourceInsertion O.toCollection B (R j))))
        change HEq (T.map e ≫ n ≫ T.map (coefficientLeafMap f ell) ≫ 𝟙 _) (s ≫ w)
        exact heq_of_eq (groupedTailIdentity (T.map e) n (T.map (coefficientLeafMap f ell))
          (s ≫ w) hcore)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
