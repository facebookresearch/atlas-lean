    (Q : EnvelopingAssocChoices d) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstLeafBlocks B d Q)

/-- The exact original root-first algebra leaf bijection maps
to the displayed original total algebra-input family. -/
def envelopingAssocRootFirstLeafEquiv (B : W → C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (envelopingAssocRootFirstAlgebraLeaves B d Q).index ≃
      (envelopingAssocTotalAlgebraInputs d Q).index where
  toFun p := match p with
    | ⟨none, Sum.inl j⟩ => Sum.inl j
    | ⟨none, Sum.inr ⟨i, j⟩⟩ => Sum.inr ⟨i, Sum.inl j⟩
    | ⟨some ⟨i, j⟩, k⟩ => Sum.inr ⟨i, Sum.inr ⟨j, k⟩⟩
