/- Exact checked source: ReflexiveOperad.ConstantAlgebraRepresentative. -/
section EnvelopingSource242


/-!
# Original supplied constants evaluated in a genuine target algebra
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

private theorem EnvelopingSource242_mapThree {V U : Type*} [Category* V] [Category* U]
    (T : V ⥤ U) {X Y Z D : V} (f : X ⟶ Y) (g : Y ⟶ Z) (h : Z ⟶ D) :
    T.map (f ≫ g ≫ h) = T.map f ≫ T.map g ≫ T.map h := by rw [T.map_comp, T.map_comp]

private theorem representativeFold {V : Type*} [Category* V]
    {X S K R D Y O : V} (n0 : X ⟶ S) [Epi n0]
    (psi : S ⟶ K) (f : S ⟶ R) (g : R ⟶ K) (o : K ⟶ Y)
    (a : X ⟶ D) (n1 : D ⟶ R) (e : D ⟶ O) (out : O ⟶ Y)
    (h : X ⟶ O) (ev : S ⟶ Y)
    (hp : psi = f ≫ g) (hn : n0 ≫ f = a ≫ n1)
    (he : n1 ≫ g ≫ o = e ≫ out) (hr : a ≫ e = h) (hv : n0 ≫ ev = h ≫ out) :
    psi ≫ o = ev := by
  apply (cancel_epi n0).1
  have h0 : n0 ≫ psi ≫ o = n0 ≫ f ≫ g ≫ o := by
    simpa only [Category.assoc] using congrArg (fun z => n0 ≫ z ≫ o) hp
  have h1 : n0 ≫ f ≫ g ≫ o = a ≫ n1 ≫ g ≫ o := by
    simpa only [Category.assoc] using congrArg (fun z => z ≫ g ≫ o) hn
  have h2 : a ≫ n1 ≫ g ≫ o = a ≫ e ≫ out := congrArg (a ≫ ·) he
  have h3 : a ≫ e ≫ out = h ≫ out := by
    simpa only [Category.assoc] using congrArg (· ≫ out) hr
  exact h0.trans (h1.trans (h2.trans (h3.trans hv.symm)))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every originally supplied nullary coefficient is evaluated by
the genuine original M nullary operation with its original tensor factor inverse. -/
def constantValueMap {E : ColoredOperadObj W C} (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E) : B
      ⟶ M.carrier :=
  fun c => b c ≫ nullaryEvaluation M c

/-- The original supplied root and nullary coefficient maps commute
through the original complete coefficient/variable tensor normalization. -/
theorem coefficientInput_normalization {O E : ColoredOperadObj W C} (u : O ⟶ E) (B A : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile
      W) (Q : ColoredInputs W) :
    coefficientLeavesNormalization
      ((coefficientInputFactors (extendedCoefficient O.toCollection P) (addedAlgebraInputs
        B)).obj Q) (profileLeafFamily
        A P) ≫
      (coefficientLeafTensorFunctor (profileLeafFamily A P)).map
        ((FiniteTensor.tensor (V := C)).map (Linear.Constants.coefficientMap u B b P Q)) =
    (FiniteTensor.tensor (V := C)).map
      ((FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (Linear.Constants.coefficientMap u B b P Q) (𝟙
          (profileLeafFamily A P)))) ≫
      coefficientLeavesNormalization (coefficients E.toCollection P Q) (profileLeafFamily A P) := by
  let T := FiniteTensor.tensor (V := C)
  let K := ((coefficientInputFactors (extendedCoefficient O.toCollection P)
    (addedAlgebraInputs B)).obj Q)
  let L := profileLeafFamily A P
  let f := Linear.Constants.coefficientMap u B b P Q
  have hn := coefficientLeavesNormalization_naturality f (𝟙 L)
  have hmap : T.map (coefficientLeafMap (T.map f) (𝟙 L)) =
    (coefficientLeafTensorFunctor L).map (T.map f) :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map f) L)
  exact (congrArg (coefficientLeavesNormalization K L ≫ ·) hmap).symm.trans hn.symm

/-- Each actual source coefficient and input map is retained: root u,
Q constants b followed by M's genuine nullary operation, and all P variables unchanged. -/
theorem mappedFactors_evaluation {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (Linear.Constants.coefficientMap u B b P Q) (𝟙
        (profileLeafFamily M.carrier P))) ≫
        evaluatedFactors E M P Q =
    LinearAlgebra.representativeFactors O.toCollection B M.carrier (constantValueMap B b M) P Q ≫
      (analyticFactorsCollectionMap M.carrier u.toCollectionHom).app (profileInputs
        (extendProfile P Q)) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    rcases i with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some _ => rfl
  · intro i
    rcases i with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
          let a := u.toCollectionHom.app (extendProfile P Q)
          change HEq (a ≫ 𝟙 _) (𝟙 _ ≫ a)
          exact heq_of_eq ((Category.comp_id a).trans (Category.id_comp a).symm)
      | some j =>
          let a := (constantValueMap B b M) (Q.obj j).as
          change HEq a (a ≫ 𝟙 _)
          exact heq_of_eq (Category.comp_id a).symm
    | some i => exact HEq.rfl

/-- The actual constants representative followed by the genuine target
algebra operation is precisely the parent's original representative evaluation
in the genuine original O restriction, with the original evaluated constant map. -/
theorem representative_evaluation {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (M : Algebra E)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
      (Linear.Constants.representative u B b P Q) ≫
      (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
        M.operations.app P.outputColor (profileInputs
        P) =
    LinearAlgebra.representativeEvaluation O B (Algebra.restrict u M) (constantValueMap B b
      M) P Q := by
  let T := FiniteTensor.tensor (V := C)
  let L := profileLeafFamily M.carrier P
  let U := coefficientLeafTensorFunctor L
  let K := ((coefficientInputFactors (extendedCoefficient O.toCollection P)
    (addedAlgebraInputs B)).obj Q)
  let n := coefficientLeavesNormalizationIso K L
  let n0 := n.hom
  let psi := U.map (Linear.Constants.representative u B b P Q)
  let coef := Linear.Constants.coefficientMap u B b P Q
  let f := U.map (T.map coef)
  let gamma := frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫ E.toCollection.map
    (Linear.Constants.totalProfileHom P Q)
  let g := U.map gamma
  let o := (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
    M.operations.app P.outputColor
    (profileInputs P)
  let a := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap coef (𝟙 L)))
  let n1 := coefficientLeavesNormalization (coefficients E.toCollection P Q) L
  let e := T.map (evaluatedFactors E M P Q)
  let out := M.operations.app P.outputColor (profileInputs (extendProfile P Q))
  let rho := T.map (LinearAlgebra.representativeFactors O.toCollection B M.carrier
    (constantValueMap B b M) P Q)
  let umap := (analyticSummandCollectionMap M.carrier u.toCollectionHom).app (profileInputs
    (extendProfile P Q))
  let h := rho ≫ umap
  let ev := LinearAlgebra.representativeEvaluation O B (Algebra.restrict u M)
    (constantValueMap B b M) P Q
  have hp : psi = f ≫ g := U.map_comp _ _
  have hn : n0 ≫ f = a ≫ n1 :=
    (congrArg (· ≫ f) (coefficientLeavesNormalizationIso_hom K L)).trans
      (coefficientInput_normalization u B M.carrier b P Q)
  have he : n1 ≫ g ≫ o = e ≫ out := partial_evaluation E M P Q
  have hr : a ≫ e = h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (mappedFactors_evaluation u B b M P Q)).trans (T.map_comp _ _))
  have hv : n0 ≫ ev = h ≫ out :=
    (LinearAlgebra.representativeEvaluation_normalized O B (Algebra.restrict u M)
      (constantValueMap B b M) P Q).trans
      (Category.assoc rho umap out).symm
  exact representativeFold n0 psi f g o a n1 e out h ev hp hn he hr hv


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

end
end EnvelopingSource242

/- Exact checked source: WeightedNormalization.ConstantExtensionNaturality. -/
section EnvelopingSource243


/-!
# Original input and variable-profile naturality of constants evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

private theorem constantTwoSquares {D : Type*} [Category* D] {X X' A A' B B' : D}
    (l : X ⟶ X') (a : X ⟶ A) (a' : X' ⟶ A') (f : A ⟶ A')
    (b : A ⟶ B) (b' : A' ⟶ B') (g : B ⟶ B')
    (ha : l ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) :
    l ≫ (a' ≫ b') = (a ≫ b) ≫ g := by
  rw [← Category.assoc l a', ha, Category.assoc a f, hb, Category.assoc]

variable {W : Type u}

/-- The map between nullary profiles induced by an equality of output colors. -/
def nullaryColorHom {c d : W} (h : c = d) : ColoredProfile.nullary c ⟶
  ColoredProfile.nullary d where
  inputEquiv := Equiv.refl _
  inputColor_eq i := Fin.elim0 i
  outputColor_eq := h

/-- The nullary branch maps induced by a color-preserving map of added input families. -/
def branchArrows {Q Q' : ColoredInputs W} (g : Q ⟶ Q') : Outer.BranchArrows g (branches Q)
  (branches Q') :=
  fun i => nullaryColorHom (Discrete.eq_of_hom (g.hom i))

theorem totalProfileHom_inputs (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    extendProfileMap (𝟙 P) (Outer.totalInputsMap g (branchArrows g)) ≫
      totalProfileHom P Q' = totalProfileHom P Q := by
  apply ColoredProfile.Hom.ext
  ext p
  cases p with
  | inl p => rfl
  | inr p => exact Fin.elim0 p.2

theorem totalProfileHom_variables {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) :
    extendProfileMap f (𝟙 (frozenTotalInputs Q (branches Q))) ≫ totalProfileHom P' Q =
      totalProfileHom P Q ≫ f := by
  apply ColoredProfile.Hom.ext
  ext p
  cases p with
  | inl p => rfl
  | inr p => exact Fin.elim0 p.2

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

private theorem constantValue_transport (E : ColoredOperadObj W C) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    {x y : Discrete W} (g : x ⟶ y) :
    (Discrete.functor B).map g ≫ b y.as = b x.as ≫ E.toCollection.map (nullaryColorHom
      (Discrete.eq_of_hom g)) := by
  rcases x with ⟨x⟩
  rcases y with ⟨y⟩
  have h : x = y := Discrete.eq_of_hom g
  cases h
  have hg : g = 𝟙 (Discrete.mk x) := Subsingleton.elim _ _
  have hp : nullaryColorHom (Discrete.eq_of_hom g) = 𝟙 (ColoredProfile.nullary x) := by
    apply ColoredProfile.Hom.ext
    rfl
  rw [hg, hp, Functor.map_id, Functor.map_id, Category.id_comp, Category.comp_id]

theorem coefficientMap_inputs {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    coefficientLeafMap (O.toCollection.map (extendProfileMap (𝟙 P) g))
      ((addedAlgebraInputs B).map g) ≫
      coefficientMap u B b P Q' = coefficientMap u B b P Q ≫
        Outer.coefficientMap E.toCollection P g (branchArrows g) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (u.toCollectionHom.naturality (extendProfileMap (𝟙 P) g))
    | some i => exact heq_of_eq (constantValue_transport E B b (g.hom i))

theorem representative_inputs {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (linearCoefficientDiagram O.toCollection B P).map g ≫ representative u B b P Q' =
      representative u B b P Q := by
  let T := FiniteTensor.tensor (V := C)
  let c := coefficientLeafMap (O.toCollection.map (extendProfileMap (𝟙 P) g))
    ((addedAlgebraInputs B).map g)
  let a := T.map (coefficientMap u B b P Q)
  let a' := T.map (coefficientMap u B b P Q')
  let f := T.map (Outer.coefficientMap E.toCollection P g (branchArrows g))
  let s := frozenPartialSubstitution E P Q (branches Q)
  let s' := frozenPartialSubstitution E P Q' (branches Q')
  let h := E.toCollection.map (extendProfileMap (𝟙 P) (Outer.totalInputsMap g (branchArrows g)))
  let t := E.toCollection.map (totalProfileHom P Q)
  let t' := E.toCollection.map (totalProfileHom P Q')
  have ha : T.map c ≫ a' = a ≫ f := (T.map_comp _ _).symm.trans
    ((congrArg T.map (coefficientMap_inputs u B b P g)).trans (T.map_comp _ _))
  have hs : f ≫ s' = s ≫ h := Outer.partialSubstitution_naturality E P g (branchArrows g)
  have ht : h ≫ t' = t := (E.toCollection.map_comp _ _).symm.trans
    (congrArg E.toCollection.map (totalProfileHom_inputs P g))
  have hst : f ≫ (s' ≫ t') = s ≫ t := (Category.assoc f s' t').symm.trans
    ((congrArg (· ≫ t') hs).trans ((Category.assoc s h t').trans (congrArg (s ≫ ·) ht)))
  exact (Category.assoc (T.map c) a' (s' ≫ t')).symm.trans
    ((congrArg (· ≫ (s' ≫ t')) ha).trans ((Category.assoc a f (s' ≫
      t')).trans (congrArg (a ≫ ·) hst)))

theorem coefficientMap_variables {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) :
    coefficientLeafMap (O.toCollection.map (extendProfileMap f (𝟙 Q))) (𝟙
      ((addedAlgebraInputs B).obj Q)) ≫
      coefficientMap u B b P' Q = coefficientMap u B b P Q ≫
        Variable.coefficientMap E.toCollection f Q (branches Q)
        := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (u.toCollectionHom.naturality (extendProfileMap f (𝟙 Q)))
    | some i => exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

theorem representative_variables {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) :
    (linearCoefficientProfileMap O.toCollection B f).app Q ≫ representative u B b P' Q =
      representative u B b P Q ≫ E.toCollection.map f := by
  let T := FiniteTensor.tensor (V := C)
  let c := coefficientLeafMap (O.toCollection.map (extendProfileMap f (𝟙 Q))) (𝟙
    ((addedAlgebraInputs B).obj Q))
  let a := T.map (coefficientMap u B b P Q)
  let a' := T.map (coefficientMap u B b P' Q)
  let k := T.map (Variable.coefficientMap E.toCollection f Q (branches Q))
  let s := frozenPartialSubstitution E P Q (branches Q)
  let s' := frozenPartialSubstitution E P' Q (branches Q)
  let h := E.toCollection.map (extendProfileMap f (𝟙 (frozenTotalInputs Q (branches Q))))
  let t := E.toCollection.map (totalProfileHom P Q)
  let t' := E.toCollection.map (totalProfileHom P' Q)
  let g := E.toCollection.map f
  have ha : T.map c ≫ a' = a ≫ k := (T.map_comp _ _).symm.trans
    ((congrArg T.map (coefficientMap_variables u B b f Q)).trans (T.map_comp _ _))
  have hs : k ≫ s' = s ≫ h := Variable.partialSubstitution_naturality E f Q (branches Q)
  have ht : h ≫ t' = t ≫ g := (E.toCollection.map_comp _ _).symm.trans
    ((congrArg E.toCollection.map (totalProfileHom_variables f Q)).trans
      (E.toCollection.map_comp _ _))
  have hst : k ≫ (s' ≫ t') = (s ≫ t) ≫ g := constantTwoSquares k s s' h t t' g hs ht
  exact (Category.assoc (T.map c) a' (s' ≫ t')).symm.trans
    ((congrArg (· ≫ (s' ≫ t')) ha).trans
      ((Category.assoc a k (s' ≫ t')).trans
        ((congrArg (a ≫ ·) hst).trans (Category.assoc a (s ≫ t) g).symm)))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource243

/- Exact checked source: WeightedNormalization.ConstantExtensionCollection. -/
section EnvelopingSource244


/-!
# The actual constants evaluator descends through original coefficient colimits
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The coefficient-diagram cocone that evaluates added inputs through the chosen nullary maps
in `E`. -/
def evaluationCocone {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    Cocone (linearCoefficientDiagram O.toCollection B P) where
  pt := E.toCollection.obj P
  ι :=
    { app Q := representative u B b P Q
      naturality _Q _Q' g := (representative_inputs u B b P g).trans (Category.comp_id _).symm }

/-- The original coefficient colimit descent of the target's original
nullary partial-substitution evaluator. -/
def extension {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    linearCoefficient O.toCollection B P ⟶ E.toCollection.obj P := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.desc (linearCoefficientDiagram O.toCollection B P) (evaluationCocone u B b P)

/-- Every original coefficient/input colimit leg is evaluated by the
actual target nullary partial substitution at those same original inputs. -/
theorem extension_β {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile
      W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫ extension u B b P = representative u B b P Q := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.ι_desc (evaluationCocone u B b P) Q

/-- The actual constants colimit descent is natural in every
original variable-profile map, retaining full input permutations and outputs. -/
theorem extension_naturality {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c))
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    linearCoefficientMap O.toCollection B f ≫ extension u B b P' = extension u B b P ≫
      E.toCollection.map f := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  let i := linearCoefficientι O.toCollection B P Q
  let j := linearCoefficientι O.toCollection B P' Q
  let a := (linearCoefficientProfileMap O.toCollection B f).app Q
  let p := extension u B b P
  let q := extension u B b P'
  have hi : i ≫ linearCoefficientMap O.toCollection B f = a ≫ j :=
    linearCoefficientι_profileMap O.toCollection B f Q
  have hj : j ≫ q = representative u B b P' Q := extension_β u B b P' Q
  have hk : i ≫ p = representative u B b P Q := extension_β u B b P Q
  exact (Category.assoc i (linearCoefficientMap O.toCollection B f) q).symm.trans
    ((congrArg (· ≫ q) hi).trans
      ((Category.assoc a j q).trans
        ((congrArg (a ≫ ·) hj).trans
          ((representative_variables u B b f Q).trans
            ((congrArg (· ≫ E.toCollection.map f) hk).symm.trans (Category.assoc i p
              (E.toCollection.map f)))))))

/-- The original constants extension is a genuine morphism of the
literal colored symmetric collections, constructed from original colimit legs. -/
def collectionMap {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) :
    linearCoefficientCollection O.toCollection B ⟶ E.toCollection where
  app P := extension u B b P
  naturality {_P _P'} f := extension_naturality u B b f


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource244

/- Exact checked source: WeightedNormalization.NoLeafInterchange. -/
section EnvelopingSource245


/-!
# Exact original coefficient/input interchange when every input family is empty
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

open CategoryTheory

private theorem mapThreeNoLeaves {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map a ≫ F.map b ≫ F.map c = F.map (a ≫ b ≫ c) := by simp only [Functor.map_comp]

private theorem reassociateNoLeaves {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]

private theorem normalizeNoLeafsFromSquares {D : Type*} [Category* D] {A B C E F G H J : D}
    (a : A ⟶ B) (b : B ⟶ C) (n : C ⟶ E) (c : E ⟶ F) (e : F ⟶ G)
    (g : C ⟶ H) (n₀ : H ⟶ F) (z : H ⟶ G) (r : B ⟶ J) (u : J ⟶ G)
    {K : D} (p : A ⟶ K) (q : K ⟶ J) (m : K ⟶ G)
    (hc : n ≫ c = g ≫ n₀) (he : n₀ ≫ e = z) (hf : b ≫ g ≫ z = r ≫ u)
    (hp : a ≫ r = p ≫ q) (hq : q ≫ u = m) :
    ((a ≫ b ≫ n) ≫ c) ≫ e = p ≫ m := by
  calc
    ((a ≫ b ≫ n) ≫ c) ≫ e = a ≫ b ≫ (n ≫ c) ≫ e := by simp only [Category.assoc]
    _ = a ≫ b ≫ (g ≫ n₀) ≫ e := congrArg (fun f => a ≫ b ≫ f ≫ e) hc
    _ = a ≫ b ≫ g ≫ z := by simpa only [Category.assoc] using congrArg (a ≫ b ≫ g ≫ ·) he
    _ = a ≫ r ≫ u := congrArg (a ≫ ·) hf
    _ = (a ≫ r) ≫ u := (Category.assoc a r u).symm
    _ = (p ≫ q) ≫ u := congrArg (· ≫ u) hp
    _ = p ≫ m := (Category.assoc p q u).trans (congrArg (p ≫ ·) hq)

variable {C : Type w} [Category.{v} C]

/-- Flattening a family of empty input blocks yields the empty leaf family. -/
def emptyTotalLeavesIso (I : FintypeCat.{0}) :
    totalBlockInputs I (fun _ => (FiniteFamily.empty : FiniteFamily C)) ≅
      (FiniteFamily.empty : FiniteFamily C) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => p.2
      invFun := fun p => p.elim
      left_inv := fun p => p.2.elim
      right_inv := fun p => p.elim }
    (fun p => p.2.elim)

/-- Identify coefficient blocks with empty leaves as singleton coefficient families. -/
def emptySlotBlocksIso (K : FiniteFamily C) :
    combinedInputBlocks K.index K.obj (fun _ => (FiniteFamily.empty : FiniteFamily C)) ≅
      (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj K :=
  FiniteFamily.isoOfComponents (Equiv.refl K.index) (fun i => emptyLeafFamilyIso (K.obj i))

variable [FiniteTensor C]

/-- Insert each coefficient into its weighted block using the empty-leaf tensor isomorphism. -/
def emptySlotInputMap (K : FiniteFamily C) : K ⟶
    weightedInputBlockFamily K.index K.obj (fun _ => (FiniteFamily.empty : FiniteFamily C)) where
  equiv := Equiv.refl K.index
  hom i := (emptyLeafTensorIso (K.obj i)).inv

theorem emptySlotInputMap_cancel (K : FiniteFamily C) :
    emptySlotInputMap K ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (emptySlotBlocksIso K).hom ≫
        (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app K = 𝟙 K := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    let e := emptyLeafTensorIso (K.obj i)
    change HEq (e.inv ≫ ((FiniteTensor.tensor (V := C)).map (emptyLeafFamilyIso (K.obj i)).hom ≫
      (FiniteTensor.singletonIso (V := C)).hom.app (K.obj i))) (𝟙 (K.obj i))
    exact heq_of_eq e.inv_hom_id

omit [FiniteTensor C] in
theorem emptySlotFactorComparison (K : FiniteFamily C) :
    (coefficientBlockInterchangeFamilyIso K.index K.obj (fun _ =>
      (FiniteFamily.empty : FiniteFamily C))).hom ≫
        (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (𝟙 K)
          (emptyTotalLeavesIso K.index).hom) ≫
        (emptyLeafRawIso K).hom =
      (FiniteFamily.flatten (C := C)).map (emptySlotBlocksIso K).hom ≫
        FiniteFamily.mapSingletonFlattenIso.hom.app K := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases j with
    | none => rfl
    | some j => cases j
  · intro p
    rcases p with ⟨i, j⟩
    cases j with
    | none =>
      let X := K.obj i
      change HEq (𝟙 X ≫ (𝟙 X ≫ (𝟙 X ≫ 𝟙 X))) (𝟙 X ≫ 𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some j => cases j

/-- The actual empty-input block interchange, its exact dependent
empty-leaf correction, and original empty-leaf unitor are the original
tensor of singleton collapses, at every original coefficient position. -/
theorem noLeafInterchange_collapse (K : FiniteFamily C) :
    ((coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
      (FiniteFamily.empty : FiniteFamily C))).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 ((FiniteTensor.tensor
          (V := C)).obj K))
          (emptyTotalLeavesIso K.index).hom)) ≫ (emptyLeafTensorIso ((FiniteTensor.tensor
            (V := C)).obj K)).hom =
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.map (FiniteTensor.tensor (V :=
        C))).map (emptySlotBlocksIso
        K).hom) ≫
        (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapIso (FiniteTensor.singletonIso
          (V := C))).hom.app K) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let R := combinedInputBlocks K.index K.obj (fun _ => (FiniteFamily.empty : FiniteFamily C))
  let M := (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj K
  let a := (FiniteTensor.flattenIso (V := C)).inv.app R
  let b := T.map (coefficientBlockInterchangeFamilyIso K.index K.obj (fun _ =>
    (FiniteFamily.empty : FiniteFamily
    C))).hom
  let n := coefficientLeavesNormalization K (totalBlockInputs K.index (fun _ =>
    (FiniteFamily.empty : FiniteFamily C)))
  let c := T.map (coefficientLeafMap (𝟙 (T.obj K)) (emptyTotalLeavesIso K.index).hom)
  let e := (emptyLeafTensorIso (T.obj K)).hom
  let g := T.map (F.map (coefficientLeavesNestedMap (𝟙 K) (emptyTotalLeavesIso K.index).hom))
  let n₀ := coefficientLeavesNormalization K (FiniteFamily.empty : FiniteFamily C)
  let z := T.map (emptyLeafRawIso K).hom
  let r := T.map (F.map (emptySlotBlocksIso K).hom)
  let u := T.map (FiniteFamily.mapSingletonFlattenIso.hom.app K)
  let m := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app K)
  let p := T.map ((FiniteFamily.map T).map (emptySlotBlocksIso K).hom)
  let q := (FiniteTensor.flattenIso (V := C)).inv.app M
  have hc : n ≫ c = g ≫ n₀ :=
    (congrArg (fun f => n ≫ T.map (coefficientLeafMap f (emptyTotalLeavesIso
      K.index).hom)) (T.map_id K)).symm.trans
      (coefficientLeavesNormalization_naturality (𝟙 K) (emptyTotalLeavesIso K.index).hom).symm
  have he : n₀ ≫ e = z := coefficientLeavesNormalization_empty K
  have hf : b ≫ g ≫ z = r ≫ u := (mapThreeNoLeaves T _ _ _).trans
    ((congrArg T.map (emptySlotFactorComparison K)).trans (T.map_comp _ _))
  have hp : a ≫ r = p ≫ q := (FiniteTensor.flattenIso (V :=
    C)).inv.naturality (emptySlotBlocksIso K).hom |>.symm
  have hq : q ≫ u = m :=
    (congrArg (q ≫ ·) (mapSingletonFlattenLaw_app K)).trans
      ((Category.assoc q ((FiniteTensor.flattenIso (V := C)).hom.app M) m).symm.trans
        ((congrArg (· ≫ m) ((FiniteTensor.flattenIso (V :=
          C)).inv_hom_id_app M)).trans (Category.id_comp m)))
  have hnorm : (coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
    (FiniteFamily.empty : FiniteFamily C))).hom
    =
      a ≫ b ≫ n := congrArg (fun f => a ≫ b ≫ f)
    (coefficientLeavesNormalizationIso_hom K (totalBlockInputs K.index (fun _ =>
      (FiniteFamily.empty : FiniteFamily
      C))))
  have h : ((a ≫ b ≫ n) ≫ c) ≫ e = p ≫ m :=
    normalizeNoLeafsFromSquares a b n c e g n₀ z r u p q m hc he hf hp hq
  exact (congrArg (fun f => (f ≫ c) ≫ e) hnorm).trans h

/-- Inserting each original coefficient through its actual empty
leaf inverse and then normalizing the complete empty-input blocks is
the identity of the original full finite coefficient tensor. -/
theorem noLeafInterchange_unit (K : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).map (emptySlotInputMap K) ≫
      ((coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
        (FiniteFamily.empty : FiniteFamily C))).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 ((FiniteTensor.tensor
          (V := C)).obj K))
          (emptyTotalLeavesIso K.index).hom)) ≫ (emptyLeafTensorIso ((FiniteTensor.tensor
            (V := C)).obj K)).hom =
    𝟙 ((FiniteTensor.tensor (V := C)).obj K) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (emptySlotInputMap K)
  let b := (coefficientBlockInterchangeTensorIso K.index K.obj (fun _ =>
    (FiniteFamily.empty : FiniteFamily C))).hom ≫
    T.map (coefficientLeafMap (𝟙 (T.obj K)) (emptyTotalLeavesIso K.index).hom)
  let e := (emptyLeafTensorIso (T.obj K)).hom
  have h := noLeafInterchange_collapse K
  have hf : a ≫ T.map ((FiniteFamily.map T).map (emptySlotBlocksIso K).hom) ≫
      T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app K) = 𝟙 (T.obj K) :=
    (mapThreeNoLeaves T _ _ _).trans ((congrArg T.map (emptySlotInputMap_cancel K)).trans
      (T.map_id K))
  exact (congrArg (a ≫ ·) h).trans hf


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

end
end EnvelopingSource245

/- Exact checked source: WeightedNormalization.OriginalInclusionEmptyData. -/
section EnvelopingSource246


/-!
# Original operation profiles and source maps in the all-empty linear representatives
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

open CategoryTheory

private theorem eraseInclusionPrefix {D : Type*} [Category* D] {A B C E : D}
    (p : A ⟶ B) (r : B ⟶ C) (f : C ⟶ E) (e : B ⟶ A) (g : A ⟶ E)
    (hr : r ≫ f = e ≫ g) (hp : p ≫ e = 𝟙 A) : (p ≫ r) ≫ f = g :=
  (Category.assoc p r f).trans ((congrArg (p ≫ ·) hr).trans
    ((Category.assoc p e g).symm.trans ((congrArg (· ≫ g) hp).trans (Category.id_comp g))))

private theorem reassociateInclusion {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]

variable {W : Type u}

/-- Choose empty added algebra-input families at every substitution slot. -/
def choices (s : ColoredSubstitutionData W) : EnvelopingInputChoices s := fun _ =>
  emptyColoredInputs

/-- The total algebra-input family is empty when every slot uses empty added inputs. -/
def totalInputsIso (s : ColoredSubstitutionData W) :
    envelopingTotalAlgebraInputs s (choices s) ≅ (emptyColoredInputs : ColoredInputs W) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | Sum.inl p => p | Sum.inr p => p.2
      invFun := fun p => p.elim
      left_inv := fun p => by cases p with | inl p => cases p | inr p => cases p.2
      right_inv := fun p => p.elim }
    (fun p => match p with | Sum.inl p => p.elim | Sum.inr p => p.2.elim)

/-- Remove the empty profile extensions to recover the original substitution datum. -/
def toOriginalSubstitution (s : ColoredSubstitutionData W) :
    envelopingRepresentativeSubstitution s (choices s) ⟶ s where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.sumEmpty s.inner.index Empty
      hom p := match p with
        | Sum.inl p => emptyExtensionProfileHom (s.inner.obj p)
        | Sum.inr p => p.elim }

theorem toOriginalSubstitution_outer (s : ColoredSubstitutionData W) :
    envelopingRepresentativeOuterHom s (choices s) ≫
      ColoredSubstitutionData.outerProfileMap (toOriginalSubstitution s)
      =
      emptyExtensionProfileHom s.outerProfile := by
  apply ColoredProfile.Hom.ext
  ext p
  cases p with | inl p => rfl | inr p => cases p

/-- Remove the empty total algebra-input extension from the substitution profile. -/
def totalProfileHom (s : ColoredSubstitutionData W) :
    extendProfile s.totalProfile (envelopingTotalAlgebraInputs s (choices s)) ⟶ s.totalProfile :=
  extendProfileMap (𝟙 s.totalProfile) (totalInputsIso s).hom ≫
    emptyExtensionProfileHom s.totalProfile

theorem toOriginalSubstitution_total (s : ColoredSubstitutionData W) :
    envelopingRepresentativeTotalHom s (choices s) ≫ totalProfileHom s =
      ColoredSubstitutionData.totalProfileMap (toOriginalSubstitution s) := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases j with | inl j => rfl | inr j => cases j
  | inr i => cases i

variable {C : Type w} [Category.{v} C]

/-- Identify the representative coefficients with the original substitution factors when added
inputs are empty. -/
def coefficientIso (O : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) :
    envelopingRepresentativeCoefficients O s (choices s) ≅
      (ColoredOperadObj.substitutionFactors O).obj s :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i => match i with
    | none => O.mapIso (emptyExtensionProfileIso s.outerProfile)
    | some i => O.mapIso (emptyExtensionProfileIso (s.inner.obj i)))

/-- Map the representative coefficients to the original substitution factors by removing empty
extensions. -/
def coefficientMap (O : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) :
    envelopingRepresentativeCoefficients O s (choices s) ⟶
      (ColoredOperadObj.substitutionFactors O).obj s where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := match i with
    | none => O.map (emptyExtensionProfileHom s.outerProfile)
    | some i => O.map (emptyExtensionProfileHom (s.inner.obj i))

theorem coefficientIso_hom (O : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) :
    (coefficientIso O s).hom = coefficientMap O s := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i <;> rfl

variable [FiniteTensor C]

/-- The genuine original all-empty unit prefix and actual profile maps
compare precisely with the original simultaneous-substitution source. -/
theorem coefficientTensorMap (O : ColoredOperadObj W C) (s : ColoredSubstitutionData W) :
    envelopingRepresentativeCoefficientTensorMap O s (choices s) ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (toOriginalSubstitution s) =
      (FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection s) := by
  let T := FiniteTensor.tensor (V := C)
  let R := envelopingRepresentativeCoefficients O.toCollection s (choices s)
  let u := envelopingRepresentativeUnitMap O s (choices s)
  let f := (ColoredOperadObj.substitutionFactors O.toCollection).map (toOriginalSubstitution s)
  let e := (ZeroVariable.emptyUnitIso (FintypeCat.of Empty) R).hom
  let g := coefficientMap O.toCollection s
  let p := (frozenVariableTensorUnitIso (FintypeCat.of Empty) R).hom
  have h : u ≫ f = e ≫ g := by
    apply FiniteFamily.Hom_ext
    · ext i
      cases i with | inl i => cases i | inr i => cases i <;> rfl
    · intro i
      cases i with
      | inl i => cases i
      | inr i =>
        cases i with
        | none => exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
            ((congrArg O.toCollection.map (toOriginalSubstitution_outer s)).trans
              (Category.id_comp _).symm))
        | some i => exact heq_of_eq ((Category.id_comp _).trans (Category.id_comp _).symm)
  have hm : T.map u ≫ T.map f = T.map e ≫ T.map g :=
    (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))
  have hp : p ≫ T.map e = 𝟙 (T.obj R) := ZeroVariable.emptyPrefix_unit (FintypeCat.of Empty) R
  exact eraseInclusionPrefix p (T.map u) (T.map f) (T.map e) (T.map g) hm hp

/-- The original O-substitution evaluates the original all-empty
representative coefficients after their exact original profile comparison. -/
theorem representativeCoefficient (O : ColoredOperadObj W C) (s : ColoredSubstitutionData W) :
    envelopingRepresentativeCoefficientSubstitution O s (choices s) ≫
      O.toCollection.map (totalProfileHom s) =
      (FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection s) ≫ O.subst.app s := by
  let T := FiniteTensor.tensor (V := C)
  let a := envelopingRepresentativeCoefficientTensorMap O s (choices s)
  let b := O.subst.app (envelopingRepresentativeSubstitution s (choices s))
  let c := O.toCollection.map (envelopingRepresentativeTotalHom s (choices s))
  let d := O.toCollection.map (totalProfileHom s)
  let f := (ColoredOperadObj.substitutionSource O.toCollection).map (toOriginalSubstitution s)
  let g := O.toCollection.map (ColoredSubstitutionData.totalProfileMap (toOriginalSubstitution s))
  have hc : c ≫ d = g := (O.toCollection.map_comp _ _).symm.trans
    (congrArg O.toCollection.map (toOriginalSubstitution_total s))
  have hb : b ≫ g = f ≫ O.subst.app s := (O.subst.naturality (toOriginalSubstitution s)).symm
  have h : (a ≫ b ≫ c) ≫ d = (a ≫ f) ≫ O.subst.app s := by
    have h₁ := (reassociateInclusion a b c d).trans (congrArg (a ≫ b ≫ ·) hc)
    exact h₁.trans ((congrArg (a ≫ ·) hb).trans (Category.assoc a f (O.subst.app s)).symm)
  exact h.trans (congrArg (· ≫ O.subst.app s) (coefficientTensorMap O s))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Inclusion

end
