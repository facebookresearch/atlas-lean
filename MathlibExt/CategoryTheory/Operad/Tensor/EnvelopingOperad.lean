/- Exact checked source: ReflexiveOperad.AlgebraEquivalence. -/
section EnvelopingSource374


/-!
# Full genuine tensor algebra equivalence for the constructed operad quotient
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive.AlgebraDescent

open CategoryTheory Limits Tensor

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)

/-- The original relation property on genuine Q-algebras. -/
def balancedProperty : ObjectProperty (Tensor.Algebra Q) := Balanced f g

/-- The full subcategory retains every genuine Q-algebra morphism. -/
abbrev BalancedAlgebras := (balancedProperty f g).FullSubcategory

/-- Forget the relation property and retain the exact original carrier maps. -/
def balancedForget : BalancedAlgebras f g ⥤ (W → C) :=
  (balancedProperty f g).ι ⋙ Tensor.Algebra.forget Q

/-- An equality of whole operation families gives the full operation
square for the identity on the unchanged original carrier. -/
theorem identityOperationComm {O : ColoredSymmetricCollection W C} {M : W → C}
    {a b : Operations O M M} (h : a = b) (d : W) (q : AnalyticIndex W d) :
    a.app d q ≫ 𝟙 (M d) = (analyticSummandCarrierMap O (𝟙 M)).app q ≫ b.app d q :=
  (Category.comp_id _).trans
    ((congrArg (fun a => a.app d q) h).trans
      ((Category.id_comp _).symm.trans
        (congrArg (· ≫ b.app d q)
          (congrArg (fun a => a.app q) (analyticSummandCarrierMap_id (d := d) O (A := M)))).symm))

variable [HasColimitsOfSize.{us, us} C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]
variable (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)

/-- The actual full restriction along the constructed quotient projection. -/
def forward : Tensor.Algebra (operad f g t hf hg) ⥤ BalancedAlgebras f g :=
  (balancedProperty f g).lift (restrictionFunctor (projection f g t hf hg))
    (restrictionBalanced f g t hf hg)

/-- Full coefficient descent on objects and every original algebra morphism. -/
def backward : BalancedAlgebras f g ⥤ Tensor.Algebra (operad f g t hf hg) where
  obj A := descendedAlgebra f g t hf hg A.obj A.property
  map {A B} h := descendedHom f g t hf hg A.property B.property h.hom
  map_id _A := Tensor.Algebra.Hom.ext rfl
  map_comp _h _k := Tensor.Algebra.Hom.ext rfl

/-- Restriction after descent has every original Q-operation. -/
def roundTripQIso (A : Tensor.Algebra Q) (balance : Balanced f g A) :
    Tensor.Algebra.restrict (projection f g t hf hg) (descendedAlgebra f g t hf hg A
      balance) ≅ A where
  hom :=
    { hom := 𝟙 A.carrier
      comm d q := identityOperationComm (descendedOperations_restrict f g t hf hg A balance) d q }
  inv :=
    { hom := 𝟙 A.carrier
      comm d q := identityOperationComm (descendedOperations_restrict f g t hf hg A
        balance).symm d q }
  hom_inv_id := Tensor.Algebra.Hom.ext (Category.id_comp _)
  inv_hom_id := Tensor.Algebra.Hom.ext (Category.id_comp _)

/-- Descent of restriction recovers every original quotient operation
by its actual coefficient projection, without any additional operation-law hypothesis. -/
theorem roundTripE_operations (A : Tensor.Algebra (operad f g t hf hg)) :
    (descendedAlgebra f g t hf hg (Tensor.Algebra.restrict (projection f g t hf hg) A)
      (restrictionBalanced f g t hf hg A)).operations = A.operations := by
  apply Operations.ext
  funext d q
  have := operationπ_epi f g t hf hg A.carrier q
  apply (cancel_epi (operationπ f g A.carrier q)).1
  exact operationApp_beta f g t hf hg (Tensor.Algebra.restrict (projection f g t hf hg) A)
    (restrictionBalanced f g t hf hg A) d q

/-- The quotient-algebra round trip is an isomorphism with identity carrier maps. -/
def roundTripEIso (A : Tensor.Algebra (operad f g t hf hg)) :
    descendedAlgebra f g t hf hg (Tensor.Algebra.restrict (projection f g t hf hg) A)
      (restrictionBalanced f g t hf hg A) ≅ A where
  hom :=
    { hom := 𝟙 A.carrier
      comm d q := identityOperationComm (roundTripE_operations f g t hf hg A) d q }
  inv :=
    { hom := 𝟙 A.carrier
      comm d q := identityOperationComm (roundTripE_operations f g t hf hg A).symm d q }
  hom_inv_id := Tensor.Algebra.Hom.ext (Category.id_comp _)
  inv_hom_id := Tensor.Algebra.Hom.ext (Category.id_comp _)

/-- The E-algebra round-trip isomorphisms are natural on whole algebra morphisms. -/
def unitIso : 𝟭 (Tensor.Algebra (operad f g t hf hg)) ≅ forward f g t hf hg ⋙
  backward f g t hf hg :=
  NatIso.ofComponents (fun A => (roundTripEIso f g t hf hg A).symm) (by
    intro A B h
    apply Tensor.Algebra.Hom.ext
    exact (Category.comp_id h.hom).trans (Category.id_comp h.hom).symm)

/-- The balanced Q-algebra round-trip isomorphisms are natural and retain identity carriers. -/
def counitIso : backward f g t hf hg ⋙ forward f g t hf hg ≅ 𝟭 (BalancedAlgebras f g) :=
  NatIso.ofComponents
    (fun A => (balancedProperty f g).isoMk (roundTripQIso f g t hf hg A.obj A.property)) (by
      intro A B h
      apply ObjectProperty.hom_ext
      apply Tensor.Algebra.Hom.ext
      exact (Category.comp_id h.hom.hom).trans (Category.id_comp h.hom.hom).symm)

/-- Genuine tensor algebras over the constructed operad quotient are
equivalent to balanced genuine Q-algebras, with explicit inverse functors. -/
def algebraEquivalence : Tensor.Algebra (operad f g t hf hg) ≌ BalancedAlgebras f g where
  functor := forward f g t hf hg
  inverse := backward f g t hf hg
  unitIso := unitIso f g t hf hg
  counitIso := counitIso f g t hf hg
  functor_unitIso_comp A := by
    apply ObjectProperty.hom_ext
    apply Tensor.Algebra.Hom.ext
    exact Category.id_comp (𝟙 A.carrier)

/-- The forward equivalence preserves the exact carrier functor and every whole carrier map. -/
theorem algebraEquivalence_forward_forget :
    (algebraEquivalence f g t hf hg).functor ⋙ balancedForget f g =
      Tensor.Algebra.forget (operad f g t hf hg) := rfl

/-- The inverse equivalence preserves the exact carrier functor and every whole carrier map. -/
theorem algebraEquivalence_backward_forget :
    (algebraEquivalence f g t hf hg).inverse ⋙ Tensor.Algebra.forget (operad f g t hf hg) =
      balancedForget f g := rfl


end CategoryTheory.Operad.ColoredOperadObj.Reflexive.AlgebraDescent

end
