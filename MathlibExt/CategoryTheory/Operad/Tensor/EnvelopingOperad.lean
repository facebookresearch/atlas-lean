section EnvelopingSource154


/-!
# Exact singleton coefficient/input block indices
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- The original input family in a singleton coefficient block
retains all its original input positions and objects. -/
def singletonCoefficientInputLeafIso (L : FiniteFamily C) :
    totalBlockInputs (FintypeCat.of PUnit) (fun _ => L) ≅ L :=
  FiniteFamily.isoOfComponents
    { toFun p := p.2
      invFun j := ⟨PUnit.unit, j⟩
      left_inv p := by rcases p with ⟨i, j⟩; cases i; rfl
      right_inv _ := rfl }
    (fun _ => Iso.refl _)

/-- The actual singleton block coefficient/input permutation,
leaf-index correction, and original singleton normalization
retain exactly the original complete coefficient/input family. -/
theorem singletonCoefficientInputRawMap (X : C) (L : FiniteFamily C) :
    (coefficientBlockInterchangeFamilyIso (FintypeCat.of PUnit) (fun _ => X) (fun _ => L)).hom ≫
        (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
          (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) (singletonCoefficientInputLeafIso L).hom) ≫
        (FiniteFamily.flatten (C := C)).map (singletonCoefficientLeavesIso X L).hom ≫
        FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj X) =
      FiniteFamily.singletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj X) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i
    cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i
    cases j with
    | none =>
      change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some j =>
      let Y := L.obj j
      change HEq (𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 Y)
      exact heq_of_eq (by simp only [Category.id_comp])


end CategoryTheory.Operad.Tensor.Enveloping

end
