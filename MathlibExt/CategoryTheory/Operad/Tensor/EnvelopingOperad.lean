/-!
# Enveloping operads of arbitrary colored tensor algebras

The original colored tensor operad and genuine algebra construct the full
enveloping operad through the actual weighted constant-input and algebra-action
relation. Its original coefficient coequalizers, every profile permutation,
units, simultaneous substitution and nullary algebra carrier are retained.

Both genuine inverse functors between enveloping algebras and original
algebras under the given algebra are constructed with their original full
carrier, operation, algebra-arrow and natural round-trip maps.
-/

@[expose] public section

/- Exact checked source: ColoredInputProfiles. -/
section EnvelopingSource000


/-!
# Original finite colored input families and fixed-output profiles

This output-free indexing category retains every finite input family,
including the empty family, and every original color-preserving
permutation. It is used for the added algebra inputs of the
enveloping-operad coefficient construction.
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

/-- Finite input families with the original color at every position,
with no extra output color and no chosen input ordering. -/
abbrev ColoredInputs (W : Type u) := FiniteFamily (Discrete W)

/-- Give the original input family a supplied output color. -/
def inputsToProfile {W : Type u} (d : W) : ColoredInputs W ⥤ AnalyticIndex W d where
  obj X := ⟨X.index, fun i => (X.obj i).as⟩
  map f :=
    { inputEquiv := f.equiv
      inputColor_eq := fun i => Discrete.eq_of_hom (f.hom i)
      outputColor_eq := rfl }
  map_id _X := rfl
  map_comp _f _g := rfl

/-- Forget only the fixed output, retaining every original input
color and permutation. -/
def profileToInputs {W : Type u} (d : W) : AnalyticIndex W d ⥤ ColoredInputs W where
  obj P := ⟨P.inputs, fun i => Discrete.mk (P.inputColor i)⟩
  map f :=
    { equiv := f.inputEquiv
      hom := fun i => Discrete.eqToHom (f.inputColor_eq i) }
  map_id P := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      exact heq_of_eq (Subsingleton.elim _ _)
  map_comp f g := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      exact heq_of_eq (Subsingleton.elim _ _)

/-- The two input presentations have exactly the same original
objects and all original color-preserving morphisms. -/
def coloredInputsProfileEquivalence {W : Type u} (d : W) :
    ColoredInputs W ≌ AnalyticIndex W d :=
  Equivalence.mk (inputsToProfile d) (profileToInputs d)
    (NatIso.ofComponents (fun X => Iso.refl X) (by
      intro X Y f
      apply FiniteFamily.Hom_ext
      · rfl
      · intro i
        exact heq_of_eq (Subsingleton.elim _ _)))
    (NatIso.ofComponents (fun P => Iso.refl P) (by
      intro P Q f
      rfl))

@[simp]
theorem inputsToProfile_inputs {W : Type u} (d : W) (X : ColoredInputs W) :
    ((inputsToProfile d).obj X).inputs = X.index := rfl

@[simp]
theorem inputsToProfile_inputColor {W : Type u} (d : W) (X : ColoredInputs W)
    (i : X.index) : ((inputsToProfile d).obj X).inputColor i = (X.obj i).as := rfl

@[simp]
theorem inputsToProfile_map_inputEquiv {W : Type u} (d : W) {X Y : ColoredInputs W}
    (f : X ⟶ Y) : ((inputsToProfile d).map f).inputEquiv = f.equiv := rfl

@[simp]
theorem profileToInputs_map_equiv {W : Type u} (d : W) {P Q : AnalyticIndex W d}
    (f : P ⟶ Q) : ((profileToInputs d).map f).equiv = f.inputEquiv := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource000

/- Exact checked source: ProfileExtension. -/
section EnvelopingSource001


/-!
# Original variable profiles with added algebra inputs
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

/-- Add the original algebra input family after the original
variable inputs, retaining their colors and the original output. -/
def extendProfile {W : Type u} (P : ColoredProfile W) (Q : ColoredInputs W) :
    ColoredProfile W where
  inputs := FintypeCat.of (P.inputs ⊕ Q.index)
  inputColor := Sum.elim P.inputColor (fun i => (Q.obj i).as)
  outputColor := P.outputColor

/-- The actual original variable and algebra-input permutations
act through their disjoint-sum bijection, preserving every color. -/
def extendProfileMap {W : Type u} {P P' : ColoredProfile W} {Q Q' : ColoredInputs W}
    (f : P ⟶ P') (g : Q ⟶ Q') : extendProfile P Q ⟶ extendProfile P' Q' where
  inputEquiv := Equiv.sumCongr f.inputEquiv g.equiv
  inputColor_eq i := by
    cases i with
    | inl i => exact f.inputColor_eq i
    | inr i => exact Discrete.eq_of_hom (g.hom i)
  outputColor_eq := f.outputColor_eq

@[simp]
theorem extendProfileMap_id {W : Type u} (P : ColoredProfile W) (Q : ColoredInputs W) :
    extendProfileMap (𝟙 P) (𝟙 Q) = 𝟙 (extendProfile P Q) := by
  apply ColoredProfile.Hom.ext
  exact Equiv.sumCongr_refl

theorem extendProfileMap_comp {W : Type u} {P P' P'' : ColoredProfile W}
    {Q Q' Q'' : ColoredInputs W} (f : P ⟶ P') (f' : P' ⟶ P'')
    (g : Q ⟶ Q') (g' : Q' ⟶ Q'') :
    extendProfileMap (f ≫ f') (g ≫ g') = extendProfileMap f g ≫ extendProfileMap f' g' := by
  apply ColoredProfile.Hom.ext
  exact (Equiv.sumCongr_trans f.inputEquiv g.equiv f'.inputEquiv g'.equiv).symm

/-- The original profile extension is a bifunctor, including all
empty input families and arbitrary original profile permutations. -/
def profileExtension {W : Type u} : ColoredProfile W × ColoredInputs W ⥤ ColoredProfile W where
  obj X := extendProfile X.1 X.2
  map f := extendProfileMap f.1 f.2
  map_id X := by exact extendProfileMap_id X.1 X.2
  map_comp f g := by exact extendProfileMap_comp f.1 g.1 f.2 g.2

/-- Hold the original variable profile fixed and vary only the
added algebra inputs and their original color-preserving maps. -/
def fixedProfileExtension {W : Type u} (P : ColoredProfile W) :
    ColoredInputs W ⥤ ColoredProfile W where
  obj Q := extendProfile P Q
  map g := extendProfileMap (𝟙 P) g
  map_id Q := by exact extendProfileMap_id P Q
  map_comp g h := by
    have e := extendProfileMap_comp (𝟙 P) (𝟙 P) g h
    simpa only [Category.id_comp] using e

/-- Every original variable-profile map induces the actual
natural map on the added-input coefficient diagrams. -/
def fixedProfileExtensionMap {W : Type u} {P P' : ColoredProfile W} (f : P ⟶ P') :
    fixedProfileExtension P ⟶ fixedProfileExtension P' where
  app Q := extendProfileMap f (𝟙 Q)
  naturality {Q Q'} g := by
    have h1 : extendProfileMap (𝟙 P) g ≫ extendProfileMap f (𝟙 Q') =
        extendProfileMap f g := by
      simpa only [Category.id_comp, Category.comp_id] using
        (extendProfileMap_comp (𝟙 P) f g (𝟙 Q')).symm
    have h2 : extendProfileMap f (𝟙 Q) ≫ extendProfileMap (𝟙 P') g =
        extendProfileMap f g := by
      simpa only [Category.id_comp, Category.comp_id] using
        (extendProfileMap_comp f (𝟙 P') (𝟙 Q) g).symm
    exact h1.trans h2.symm

@[simp]
theorem extendProfile_variableColor {W : Type u} (P : ColoredProfile W) (Q : ColoredInputs W)
    (i : P.inputs) : (extendProfile P Q).inputColor (Sum.inl i) = P.inputColor i := rfl

@[simp]
theorem extendProfile_algebraColor {W : Type u} (P : ColoredProfile W) (Q : ColoredInputs W)
    (i : Q.index) : (extendProfile P Q).inputColor (Sum.inr i) = (Q.obj i).as := rfl

@[simp]
theorem extendProfile_outputColor {W : Type u} (P : ColoredProfile W) (Q : ColoredInputs W) :
    (extendProfile P Q).outputColor = P.outputColor := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource001

/- Exact checked source: LinearCoefficientDiagrams. -/
section EnvelopingSource002


/-!
# Actual operation coefficients with finite algebra-labelled input families
-/

set_option autoImplicit false
noncomputable section
universe u v w us uJ vJ

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {C : Type w} [Category.{v} C]

/-- Combine an actual varying operation coefficient and its
actual varying finite input family, keeping both original maps. -/
def coefficientInputFactors {J : Type uJ} [Category.{vJ} J]
    (F : J ⥤ C) (L : J ⥤ FiniteFamily C) : J ⥤ FiniteFamily C where
  obj j := (coefficientLeafFamilyFunctor (L.obj j)).obj (F.obj j)
  map f := coefficientLeafMap (F.map f) (L.map f)
  map_id j := by
    rw [F.map_id, L.map_id, coefficientLeafMap_idLeaves,
      (coefficientLeafFamilyFunctor (L.obj j)).map_id]
  map_comp f g := by
    rw [F.map_comp, L.map_comp, ← coefficientLeafMap_comp]

/-- Tensor the original coefficient and every original input
object, with no Cartesian product or quotient outcome as input. -/
def coefficientInputTensorDiagram [FiniteTensor C] {J : Type uJ} [Category.{vJ} J]
    (F : J ⥤ C) (L : J ⥤ FiniteFamily C) : J ⥤ C :=
  coefficientInputFactors F L ⋙ FiniteTensor.tensor

variable {W : Type u}

/-- The original finite family of algebra inputs, functorial in
every color-preserving original input bijection. -/
def addedAlgebraInputs (B : W → C) : ColoredInputs W ⥤ FiniteFamily C :=
  FiniteFamily.map (Discrete.functor B)

/-- The original operation coefficient with the displayed
variable profile and all displayed added algebra inputs. -/
def extendedCoefficient (O : ColoredSymmetricCollection W C) (P : ColoredProfile W) :
    ColoredInputs W ⥤ C := fixedProfileExtension P ⋙ O

/-- The actual added-input coefficient diagram before the
enveloping algebra relations: O(P⊔Q) tensor B at every original
input of Q, with all original permutations retained. -/
def linearCoefficientDiagram [FiniteTensor C] (O : ColoredSymmetricCollection W C)
    (B : W → C) (P : ColoredProfile W) : ColoredInputs W ⥤ C :=
  coefficientInputTensorDiagram (extendedCoefficient O P) (addedAlgebraInputs B)

/-- Actual source-small colors suffice for the whole original
added-input category, through its proved profile equivalence at
the supplied output color. No output colimit is assumed. -/
theorem coloredInputsEssentiallySmall [Small.{us} W] (d : W) :
    EssentiallySmall.{us} (ColoredInputs W) :=
  (essentiallySmall_congr (coloredInputsProfileEquivalence d)).mpr
    (analyticIndexEssentiallySmallOfSmallColors d)

/-- The original source-sized colimits provide the actual
added-input coefficient colimits at each original profile. -/
theorem hasColoredInputColimits [HasColimitsOfSize.{us, us} C] [Small.{us} W] (d : W) :
    HasColimitsOfShape (ColoredInputs W) C := by
  have : EssentiallySmall.{us} (ColoredInputs W) := coloredInputsEssentiallySmall d
  exact HasColimitsOfShape.of_essentiallySmall C (ColoredInputs W)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource002

/- Exact checked source: LinearCoefficientMaps. -/
section EnvelopingSource003


/-!
# Actual natural maps of the variable-profile coefficient diagrams
-/

set_option autoImplicit false
noncomputable section
universe u v w uJ vJ

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type w} [Category.{v} C]

/-- The original coefficient and input natural transformations
induce the actual pointwise coefficient/input maps. -/
def coefficientInputFactorsMap {J : Type uJ} [Category.{vJ} J]
    {F F' : J ⥤ C} {L L' : J ⥤ FiniteFamily C} (a : F ⟶ F') (b : L ⟶ L') :
    coefficientInputFactors F L ⟶ coefficientInputFactors F' L' where
  app j := coefficientLeafMap (a.app j) (b.app j)
  naturality {i j} f := by
    change coefficientLeafMap (F.map f) (L.map f) ≫ coefficientLeafMap (a.app j) (b.app j) =
      coefficientLeafMap (a.app i) (b.app i) ≫ coefficientLeafMap (F'.map f) (L'.map f)
    rw [coefficientLeafMap_comp, coefficientLeafMap_comp, a.naturality f, b.naturality f]

theorem coefficientInputFactorsMap_id {J : Type uJ} [Category.{vJ} J]
    (F : J ⥤ C) (L : J ⥤ FiniteFamily C) :
    coefficientInputFactorsMap (𝟙 F) (𝟙 L) = 𝟙 (coefficientInputFactors F L) := by
  ext j
  change coefficientLeafMap (𝟙 (F.obj j)) (𝟙 (L.obj j)) = 𝟙 _
  rw [coefficientLeafMap_idLeaves, (coefficientLeafFamilyFunctor (L.obj j)).map_id]

theorem coefficientInputFactorsMap_comp {J : Type uJ} [Category.{vJ} J]
    {F F' F'' : J ⥤ C} {L L' L'' : J ⥤ FiniteFamily C}
    (a : F ⟶ F') (a' : F' ⟶ F'') (b : L ⟶ L') (b' : L' ⟶ L'') :
    coefficientInputFactorsMap (a ≫ a') (b ≫ b') =
      coefficientInputFactorsMap a b ≫ coefficientInputFactorsMap a' b' := by
  ext j
  exact (coefficientLeafMap_comp (a.app j) (a'.app j) (b.app j) (b'.app j)).symm

/-- The original tensor map on both coefficient and inputs. -/
def coefficientInputTensorMap [FiniteTensor C] {J : Type uJ} [Category.{vJ} J]
    {F F' : J ⥤ C} {L L' : J ⥤ FiniteFamily C} (a : F ⟶ F') (b : L ⟶ L') :
    coefficientInputTensorDiagram F L ⟶ coefficientInputTensorDiagram F' L' :=
  Functor.whiskerRight (coefficientInputFactorsMap a b) FiniteTensor.tensor

variable {W : Type u}

theorem fixedProfileExtensionMap_id (P : ColoredProfile W) :
    fixedProfileExtensionMap (𝟙 P) = 𝟙 (fixedProfileExtension P) := by
  ext Q
  exact extendProfileMap_id P Q

theorem fixedProfileExtensionMap_comp {P P' P'' : ColoredProfile W}
    (f : P ⟶ P') (g : P' ⟶ P'') :
    fixedProfileExtensionMap (f ≫ g) = fixedProfileExtensionMap f ≫ fixedProfileExtensionMap g := by
  ext Q
  change extendProfileMap (f ≫ g) (𝟙 Q) = extendProfileMap f (𝟙 Q) ≫ extendProfileMap g (𝟙 Q)
  simpa only [Category.id_comp] using extendProfileMap_comp f g (𝟙 Q) (𝟙 Q)

/-- Original variable-profile maps act on the original operation
coefficient, leaving all added algebra inputs unchanged. -/
def linearCoefficientProfileMap [FiniteTensor C] (O : ColoredSymmetricCollection W C)
    (B : W → C) {P P' : ColoredProfile W} (f : P ⟶ P') :
    linearCoefficientDiagram O B P ⟶ linearCoefficientDiagram O B P' :=
  coefficientInputTensorMap (Functor.whiskerRight (fixedProfileExtensionMap f) O)
    (𝟙 (addedAlgebraInputs B))

/-- Original colorwise algebra-carrier maps act on every added
input while retaining the original variable profile/coefficient. -/
def addedAlgebraInputMap {A B : W → C} (f : A ⟶ B) :
    addedAlgebraInputs A ⟶ addedAlgebraInputs B :=
  FiniteFamily.mapNatTrans (Discrete.natTrans (fun w => f w.as))

/-- The map of coefficient diagrams induced by a pointwise map of algebra input objects. -/
def linearCoefficientCarrierMap [FiniteTensor C] (O : ColoredSymmetricCollection W C)
    {A B : W → C} (f : A ⟶ B) (P : ColoredProfile W) :
    linearCoefficientDiagram O A P ⟶ linearCoefficientDiagram O B P :=
  coefficientInputTensorMap (𝟙 (extendedCoefficient O P)) (addedAlgebraInputMap f)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource003

/- Exact checked source: LinearCoefficientColimit. -/
section EnvelopingSource004


/-!
# Actual linear operation coefficient colimits
-/

set_option autoImplicit false
noncomputable section
universe u v w us uJ vJ

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {C : Type w} [Category.{v} C]

/-- The original joint coefficient/input diagrams and their
actual natural transformations form a functor. -/
def coefficientInputFactorsFunctor {J : Type uJ} [Category.{vJ} J] :
    (J ⥤ C) × (J ⥤ FiniteFamily C) ⥤ (J ⥤ FiniteFamily C) where
  obj X := coefficientInputFactors X.1 X.2
  map f := coefficientInputFactorsMap f.1 f.2
  map_id X := by exact coefficientInputFactorsMap_id X.1 X.2
  map_comp f g := by exact coefficientInputFactorsMap_comp f.1 g.1 f.2 g.2

/-- The actual tensor coefficient diagrams form a functor on
the original coefficient/input data. -/
def coefficientInputTensorFunctor [FiniteTensor C] {J : Type uJ} [Category.{vJ} J] :
    (J ⥤ C) × (J ⥤ FiniteFamily C) ⥤ (J ⥤ C) :=
  coefficientInputFactorsFunctor ⋙
    (Functor.whiskeringRight J (FiniteFamily C) C).obj FiniteTensor.tensor

variable {W : Type u}

/-- The added-input diagrams vary naturally over every original
variable profile and every original profile permutation. -/
def linearCoefficientDiagramFunctor [FiniteTensor C] (O : ColoredSymmetricCollection W C)
    (B : W → C) : ColoredProfile W ⥤ (ColoredInputs W ⥤ C) :=
  ((Functor.curry.obj (profileExtension ⋙ O)).prod'
    ((Functor.const (ColoredProfile W)).obj (addedAlgebraInputs B))) ⋙
      coefficientInputTensorFunctor

@[simp]
theorem linearCoefficientDiagramFunctor_obj [FiniteTensor C]
    (O : ColoredSymmetricCollection W C) (B : W → C) (P : ColoredProfile W) :
    (linearCoefficientDiagramFunctor O B).obj P = linearCoefficientDiagram O B P := rfl

@[simp]
theorem linearCoefficientDiagramFunctor_map [FiniteTensor C]
    (O : ColoredSymmetricCollection W C) (B : W → C) {P P' : ColoredProfile W} (f : P ⟶ P') :
    (linearCoefficientDiagramFunctor O B).map f = linearCoefficientProfileMap O B f := rfl

variable [FiniteTensor C] [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The actual original coefficient colimit before imposing the
algebra relations, at each original variable profile. Source
smallness provides the colimit; an enveloping object is not input. -/
def linearCoefficient (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) : C := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit (linearCoefficientDiagram O B P)

/-- Original variable-profile maps descend through the actual
added-input coefficient colimit. -/
def linearCoefficientMap (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') : linearCoefficient O B P ⟶ linearCoefficient
      O B P' := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colim.map ((linearCoefficientDiagramFunctor O B).map f)

/-- The actual coefficient colimits retain the original full
colored symmetric-collection functor, including its empty profiles. -/
def linearCoefficientCollection (O : ColoredSymmetricCollection W C) (B : W → C) :
    ColoredSymmetricCollection W C where
  obj := linearCoefficient O B
  map f := linearCoefficientMap O B f
  map_id P := by
    let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
    change colim.map ((linearCoefficientDiagramFunctor O B).map (𝟙 P)) = 𝟙 _
    rw [(linearCoefficientDiagramFunctor O B).map_id, colim.map_id]
  map_comp {P P' P''} f g := by
    let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
    change colim.map ((linearCoefficientDiagramFunctor O B).map (f ≫ g)) =
      colim.map ((linearCoefficientDiagramFunctor O B).map f) ≫
        colim.map ((linearCoefficientDiagramFunctor O B).map g)
    rw [(linearCoefficientDiagramFunctor O B).map_comp, colim.map_comp]

/-- Each original coefficient/input family has its actual
injection into the original linear coefficient object. -/
def linearCoefficientι (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientDiagram O B P).obj Q ⟶ linearCoefficient O B P := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.ι (linearCoefficientDiagram O B P) Q

/-- The actual original input permutation is the actual quotient
relation at the linear coefficient colimit. -/
theorem linearCoefficient_relabel (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (linearCoefficientDiagram O B P).map g ≫ linearCoefficientι O B P Q' =
      linearCoefficientι O B P Q := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.w (linearCoefficientDiagram O B P) g

/-- Every original variable-profile map retains each original
coefficient/input injection and the actual tensor map. -/
theorem linearCoefficientι_profileMap (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) :
    linearCoefficientι O B P Q ≫ linearCoefficientMap O B f =
      (linearCoefficientProfileMap O B f).app Q ≫ linearCoefficientι O B P' Q := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.ι_map ((linearCoefficientDiagramFunctor O B).map f) Q


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource004

/- Exact checked source: LinearCoefficientCarrierFunctor. -/
section EnvelopingSource005


/-!
# Original colorwise maps on linear operation coefficient colimits
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The actual colorwise carrier diagrams map every original
finite input family through Mathlib's discrete-family equivalence
and the existing finite-family functor. -/
def addedAlgebraInputsFunctor : (W → C) ⥤ (ColoredInputs W ⥤ FiniteFamily C) :=
  (piEquivalenceFunctorDiscrete W C).functor ⋙ FiniteFamily.mapFunctor

@[simp]
theorem addedAlgebraInputsFunctor_obj (B : W → C) :
    (addedAlgebraInputsFunctor (W := W) (C := C)).obj B = addedAlgebraInputs B := rfl

@[simp]
theorem addedAlgebraInputsFunctor_map {A B : W → C} (f : A ⟶ B) :
    (addedAlgebraInputsFunctor (W := W) (C := C)).map f = addedAlgebraInputMap f := rfl

variable [FiniteTensor C]

/-- Each fixed original variable profile yields the actual
functor of added-input coefficient diagrams in the colorwise carrier. -/
def linearCoefficientCarrierDiagramFunctor (O : ColoredSymmetricCollection W C) (P :
  ColoredProfile W) :
    (W → C) ⥤ (ColoredInputs W ⥤ C) :=
  (((Functor.const (W → C)).obj (extendedCoefficient O P)).prod' addedAlgebraInputsFunctor) ⋙
    coefficientInputTensorFunctor

@[simp]
theorem linearCoefficientCarrierDiagramFunctor_obj (O : ColoredSymmetricCollection W C)
    (P : ColoredProfile W) (B : W → C) :
    (linearCoefficientCarrierDiagramFunctor O P).obj B = linearCoefficientDiagram O B P := rfl

@[simp]
theorem linearCoefficientCarrierDiagramFunctor_map (O : ColoredSymmetricCollection W C)
    (P : ColoredProfile W) {A B : W → C} (f : A ⟶ B) :
    (linearCoefficientCarrierDiagramFunctor O P).map f = linearCoefficientCarrierMap O f P := rfl

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Source colimits give the actual original carrier functor on
linear operation coefficients. The algebra-relation map is its
map of the actual O-algebra action. -/
def linearCoefficientCarrierFunctor (O : ColoredSymmetricCollection W C) (P : ColoredProfile W) :
    (W → C) ⥤ C := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact linearCoefficientCarrierDiagramFunctor O P ⋙ colim

@[simp]
theorem linearCoefficientCarrierFunctor_obj (O : ColoredSymmetricCollection W C)
    (P : ColoredProfile W) (B : W → C) :
    (linearCoefficientCarrierFunctor O P).obj B = linearCoefficient O B P := rfl

/-- The original colorwise carrier map descends through the
actual original coefficient/input colimit. -/
def linearCoefficientCarrierLift (O : ColoredSymmetricCollection W C)
    {A B : W → C} (f : A ⟶ B) (P : ColoredProfile W) :
    linearCoefficient O A P ⟶ linearCoefficient O B P :=
  (linearCoefficientCarrierFunctor O P).map f

/-- Every original added-input injection retains its actual
carrier tensor map in the descended carrier action. -/
theorem linearCoefficientι_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O A P Q ≫ linearCoefficientCarrierLift O f P =
      (linearCoefficientCarrierMap O f P).app Q ≫ linearCoefficientι O B P Q := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.ι_map ((linearCoefficientCarrierDiagramFunctor O P).map f) Q


end CategoryTheory.Operad.Tensor.Enveloping

end
