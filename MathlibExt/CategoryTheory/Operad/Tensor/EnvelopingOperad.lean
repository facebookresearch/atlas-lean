/- Exact checked source: WeightedNormalization.ConstantRootGroupedB. -/
section EnvelopingSource259


/-!
# Actual global prefix distribution in the root-first coefficient grouping
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Root

open CategoryTheory

private theorem mapThreeRootB {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem moveRootBPrefix {D : Type*} [Category* D] {K A B C E F G H : D}
    (a : K ⟶ A) (p : A ⟶ B) (b : B ⟶ C) (c : C ⟶ H)
    (r : B ⟶ E) (q : A ⟶ F) (p' : F ⟶ E) (g : E ⟶ G) (h : G ⟶ H) (a' : K ⟶ F)
    (hs : b ≫ c = r ≫ g ≫ h) (hp : p ≫ r = q ≫ p') (ha : a ≫ q = a') :
    (a ≫ p ≫ b) ≫ c = a' ≫ p' ≫ g ≫ h := by
  calc
    (a ≫ p ≫ b) ≫ c = a ≫ p ≫ (b ≫ c) := by simp only [Category.assoc]
    _ = a ≫ p ≫ (r ≫ g ≫ h) := congrArg (a ≫ p ≫ ·) hs
    _ = a ≫ (p ≫ r) ≫ g ≫ h := by simp only [Category.assoc]
    _ = a ≫ (q ≫ p') ≫ g ≫ h := congrArg (a ≫ · ≫ g ≫ h) hp
    _ = a' ≫ p' ≫ g ≫ h := by simpa only [Category.assoc] using congrArg (· ≫ p' ≫ g ≫ h) ha

private theorem groupedRootB {D : Type*} [Category* D] {K A B C E F G H : D}
    (a : K ⟶ A) (p : A ⟶ B) (g : B ⟶ C) (h : C ⟶ E) (z : E ⟶ F)
    (u : C ⟶ G) (m : G ⟶ F) (n : A ⟶ H) (l : H ⟶ G)
    (hd : p ≫ g ≫ u = n ≫ l) (hi : h ≫ z = u ≫ m) :
    (a ≫ p ≫ g ≫ h) ≫ z = a ≫ n ≫ l ≫ m := by
  calc
    (a ≫ p ≫ g ≫ h) ≫ z = a ≫ p ≫ g ≫ (h ≫ z) := by simp only [Category.assoc]
    _ = a ≫ p ≫ g ≫ (u ≫ m) := congrArg (a ≫ p ≫ g ≫ ·) hi
    _ = a ≫ (p ≫ g ≫ u) ≫ m := by simp only [Category.assoc]
    _ = a ≫ (n ≫ l) ≫ m := congrArg (fun h => a ≫ h ≫ m) hd
    _ = a ≫ n ≫ l ≫ m := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original block distribution also holds under any displayed exact
semantic unit-position equivalence, using its actual original unit-family map. -/
theorem semanticUnitBlock_applied (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C))
    (J : N.index → FintypeCat.{0}) (M : N.index → FiniteFamily C)
    (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i) (e : I ≃ blockUnitIndex N J) :
    (frozenVariableTensorUnitIso I ((FiniteFamily.flatten (C := C)).obj N)).hom ≫
      (FiniteTensor.tensor (V := C)).map (Variable.unitFamilyMap e (𝟙
        ((FiniteFamily.flatten (C := C)).obj N)) ≫
        blockUnitGlobalMap N J M f) ≫ (FiniteTensor.flattenIso (V := C)).hom.app ⟨N.index, M⟩ =
      (FiniteTensor.flattenIso (V := C)).hom.app N ≫ (FiniteTensor.tensor (V :=
        C)).map (blockUnitAppliedMap N J M f)
        := by
  let T := FiniteTensor.tensor (V := C)
  let p := (frozenVariableTensorUnitIso I ((FiniteFamily.flatten (C := C)).obj N)).hom
  let p' := (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C :=
    C)).obj N)).hom
  let r := T.map (Variable.unitFamilyMap e (𝟙 ((FiniteFamily.flatten (C := C)).obj N)))
  let a := T.map (blockUnitGlobalMap N J M f)
  let z := (FiniteTensor.flattenIso (V := C)).hom.app (⟨N.index, M⟩ : FiniteFamily (FiniteFamily C))
