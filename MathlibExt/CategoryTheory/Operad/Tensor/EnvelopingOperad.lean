/- Exact checked source: WeightedNormalization.CommonSourceEquality. -/
section EnvelopingSource193


/-!
# Equality of the exact original weighted common-source normalizers

Both original normalizers retain the same root, middle, and inner
coefficient/input factors. The genuine grouped-to-flat normalization,
the original coefficient permutation and its actual inverse, and the
exact original dependent leaf maps identify their complete hom maps.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory WeightedNormalization

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The two exact original weighted source isomorphisms have equal
complete hom maps, for arbitrary finite tensor coefficients and all
heterogeneous supplied algebra inputs, including empty input families. -/
theorem envelopingAssocWeightedCommonSourceIso_hom_eq_rootFirst
    (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedCommonSourceIso O B d Q).hom =
      (envelopingAssocWeightedRootFirstCommonSourceIso O B d Q).hom := by
  let T := FiniteTensor.tensor (V := C)
  let K := envelopingAssocCoefficients O d Q
  let K' := (FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstCoefficientBlocks O d Q)
  let e := envelopingAssocRootFirstCoefficientIso O d Q
  let L := coefficientInputsA O B d Q
  let L' := coefficientInputsB O B d Q
  let l := fun p => (coefficientInputsRelabelIso O B d Q p).hom
  let a := T.map (atomicSourceIsoA O B d Q).hom
  let b := T.map (atomicSourceIsoB O B d Q).hom
  let r := T.map (weightedInputBlockRelabelMap e.hom.equiv e.hom.hom l)
  let i := (coefficientBlockInterchangeTensorIso K.index K.obj L).hom
  let i' := (coefficientBlockInterchangeTensorIso K'.index K'.obj L').hom
  let p := T.map (coefficientLeafMap (𝟙 (T.obj K)) (atomicLeavesIsoA O B d Q).hom)
  let q := T.map (coefficientLeafMap (T.map e.inv) (atomicLeavesIsoB O B d Q).hom)
  have hleaf : (FiniteFamily.flatten (C := C)).map
      (inputBlockRelabelMap e.hom.equiv l) ≫ (atomicLeavesIsoB O B d Q).hom =
      (atomicLeavesIsoA O B d Q).hom := atomicLeaves_relabel O B d Q
  have hr : r ≫ i' ≫ q = i ≫ p :=
    (interchangeAfterCoefficientIso e L L' l (atomicLeavesIsoB O B d Q).hom).trans
      (congrArg (fun f => i ≫ T.map (coefficientLeafMap (𝟙 (T.obj K)) f)) hleaf)
  have hs : a ≫ r = b :=
    (T.map_comp _ _).symm.trans (congrArg T.map (atomicSource_relabel O B d Q))
  have h : a ≫ i ≫ p = b ≫ i' ≫ q :=
    (congrArg (a ≫ ·) hr).symm.trans
      ((Category.assoc a r (i' ≫ q)).symm.trans
        (congrArg (fun c => c ≫ i' ≫ q) hs))
  exact (commonSourceA_atomic O B d Q).trans
    (h.trans (commonSourceB_atomic O B d Q).symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource193

/- Exact checked source: EnvelopingAssociativityWeightedRootFirstContraction. -/
section EnvelopingSource194


/-!
# Original root-first coefficient contraction and complete algebra leaf maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem rootFirstTensorInverseCancellation {V : Type*} [Category* V]
    {X A B D Y : V} (x : X ⟶ A) (e : B ≅ A) (i : D ≅ B) (m : A ⟶ Y) :
    (x ≫ e.inv ≫ i.inv) ≫ (i.hom ≫ e.hom ≫ m) = x ≫ m := by
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

private theorem rootFirstCoefficientPostSquare {V : Type*} [Category* V]
    {X A D E P Y : V} (c : X ⟶ A) (k : A ⟶ D) (a : D ⟶ E) (f : E ⟶ Y)
    (b : X ⟶ P) (g : P ⟶ D) (n : P ⟶ Y)
    (hc : c ≫ k = b ≫ g) (hn : n = g ≫ a ≫ f) :
    c ≫ (k ≫ a) ≫ f = b ≫ n := by
  rw [hn]
  simpa only [Category.assoc] using congrArg (fun x => x ≫ a ≫ f) hc

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual generic root-first coefficient contractions keep
the original middle and innermost coefficient maps under their named family comparison. -/
theorem envelopingAssocRootFirstCoefficientContraction_readback (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    coefficientBlockMap (FintypeCat.of (Option d.middleData.totalProfile.inputs))
        (envelopingAssocRootFirstCoefficientContraction O d Q) ≫
      (envelopingCoefficientBlockIso O.toCollection d.innerData (envelopingAssocInnerChoices
        d Q)).hom =
    (envelopingAssocRootFirstTensorCoefficientBlocksIso O.toCollection d Q).hom ≫
      envelopingAssocRootFirstContractionMap O d Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i <;> exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- The actual root-first coefficient tensors contract through
the original complete coefficient tensor and original root-first contraction. -/
theorem envelopingAssocRootFirstCoefficientTensorContraction (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).map
        (coefficientBlockMap (FintypeCat.of (Option d.middleData.totalProfile.inputs))
          (envelopingAssocRootFirstCoefficientContraction O d Q)) ≫
      (FiniteTensor.tensor (V := C)).map
        (envelopingCoefficientBlockIso O.toCollection d.innerData
          (envelopingAssocInnerChoices d Q)).hom =
    (envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom ≫
      envelopingAssocRootFirstContraction O d Q := by
  let T := FiniteTensor.tensor (V := C)
  have h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (envelopingAssocRootFirstCoefficientContraction_readback O d Q)).trans
      (T.map_comp _ _))
  let e := (FiniteTensor.flattenIso (V := C)).app
    (envelopingAssocRootFirstCoefficientBlocks O.toCollection d Q)
  let i := T.mapIso (envelopingAssocRootFirstCoefficientIso O.toCollection d Q)
  let x := T.map (envelopingAssocRootFirstTensorCoefficientBlocksIso O.toCollection d Q).hom
  let m := T.map (envelopingAssocRootFirstContractionMap O d Q)
  have hright : (envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom ≫
      envelopingAssocRootFirstContraction O d Q = x ≫ m :=
    rootFirstTensorInverseCancellation x e i m
  exact h.trans hright.symm

omit [FiniteTensor C] in
/-- The actual root-first input-block comparison, original
flat-inner leaf bijection, and original total algebra-input map
are precisely the original root/middle/innermost leaf bijection. -/
theorem envelopingAssocRootFirstAlgebraLeaf_comp (B : W → C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (envelopingAssocRootFirstLeafComparisonIso B d Q).hom ≫
        (envelopingAlgebraLeafIso B d.innerData (envelopingAssocInnerChoices d Q)).hom ≫
        (addedAlgebraInputs B).map (envelopingAssocFlatAlgebraInputsMap d Q) =
      (envelopingAssocRootFirstLeafIso B d Q).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some p => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j with
      | inl j =>
        let X := Q.root.obj j
        change HEq (𝟙 (B X.as) ≫ 𝟙 (B X.as) ≫ (Discrete.functor B).map (𝟙 X))
          (𝟙 (B X.as))
        exact heq_of_eq ((Category.id_comp _).trans
          ((Category.id_comp _).trans ((Discrete.functor B).map_id X)))
      | inr p =>
        let X := (Q.branch p.1 none).obj p.2
        change HEq (𝟙 (B X.as) ≫ 𝟙 (B X.as) ≫ (Discrete.functor B).map (𝟙 X))
          (𝟙 (B X.as))
        exact heq_of_eq ((Category.id_comp _).trans
          ((Category.id_comp _).trans ((Discrete.functor B).map_id X)))
    | some p =>
      let X := (Q.branch p.1 (some p.2)).obj j
      change HEq (𝟙 (B X.as) ≫ 𝟙 (B X.as) ≫ (Discrete.functor B).map (𝟙 X))
        (𝟙 (B X.as))
      exact heq_of_eq ((Category.id_comp _).trans
        ((Category.id_comp _).trans ((Discrete.functor B).map_id X)))

/-- The original root-first tensor contraction and all original
total profile and algebra-input corrections give exactly the
original coefficient route B and its complete original leaf map. -/
theorem envelopingAssocRootFirstWeightedLeafCoefficient_comp (O : ColoredOperadObj W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map
          (coefficientBlockMap (FintypeCat.of (Option d.middleData.totalProfile.inputs))
            (envelopingAssocRootFirstCoefficientContraction O d Q)))
        (envelopingAssocRootFirstLeafComparisonIso B d Q).hom ≫
      coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map
          (envelopingCoefficientBlockIso O.toCollection d.innerData
            (envelopingAssocInnerChoices d Q)).hom ≫
          envelopingRepresentativeCoefficientSubstitution O d.innerData
            (envelopingAssocInnerChoices d Q))
        (envelopingAlgebraLeafIso B d.innerData (envelopingAssocInnerChoices d Q)).hom ≫
      coefficientLeafMap
        (O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q)))
        ((addedAlgebraInputs B).map (envelopingAssocFlatAlgebraInputsMap d Q)) =
    coefficientLeafMap
      ((envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom ≫
        envelopingAssocRepresentativeRouteB O d Q)
      (envelopingAssocRootFirstLeafIso B d Q).hom := by
  let T := FiniteTensor.tensor (V := C)
  let c := T.map (coefficientBlockMap (FintypeCat.of (Option d.middleData.totalProfile.inputs))
    (envelopingAssocRootFirstCoefficientContraction O d Q))
  let k := T.map
    (envelopingCoefficientBlockIso O.toCollection d.innerData (envelopingAssocInnerChoices d Q)).hom
  let a := envelopingRepresentativeCoefficientSubstitution O d.innerData
    (envelopingAssocInnerChoices d Q)
  let f := O.toCollection.map (extendProfileMap d.totalHom
    (envelopingAssocFlatAlgebraInputsMap d Q))
  have hc := envelopingAssocRootFirstCoefficientTensorContraction O d Q
  have hcoeff : c ≫ (k ≫ a) ≫ f =
      (envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom ≫
        envelopingAssocRepresentativeRouteB O d Q := by
    have hread : envelopingAssocRepresentativeRouteB O d Q =
        envelopingAssocRootFirstContraction O d Q ≫ a ≫ f := rfl
    exact rootFirstCoefficientPostSquare c k a f
      (envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom
      (envelopingAssocRootFirstContraction O d Q)
      (envelopingAssocRepresentativeRouteB O d Q) hc hread
  let l := (envelopingAssocRootFirstLeafComparisonIso B d Q).hom
  let m := (envelopingAlgebraLeafIso B d.innerData (envelopingAssocInnerChoices d Q)).hom
  let n := (addedAlgebraInputs B).map (envelopingAssocFlatAlgebraInputsMap d Q)
  have hmaps : coefficientLeafMap c l ≫ coefficientLeafMap (k ≫ a) m ≫
      coefficientLeafMap f n = coefficientLeafMap (c ≫ (k ≫ a) ≫ f) (l ≫ m ≫ n) :=
    (congrArg (coefficientLeafMap c l ≫ ·)
      (coefficientLeafMap_comp (k ≫ a) f m n)).trans
      (coefficientLeafMap_comp c ((k ≫ a) ≫ f) l (m ≫ n))
  exact hmaps.trans (congrArg₂ (fun coeff leaf => coefficientLeafMap coeff leaf)
    hcoeff (envelopingAssocRootFirstAlgebraLeaf_comp B d Q))


end CategoryTheory.Operad.Tensor.Enveloping

end
