def nullaryVariableProfileHom (d : W) (Q : ColoredInputs W) :
    extendProfile (ColoredProfile.nullary d) Q ⟶ ((inputsToProfile d).obj Q).toColoredProfile where
  inputEquiv := Equiv.emptySum (Fin 0) Q.index
  inputColor_eq i := by
    cases i with
    | inl i => exact Fin.elim0 i
    | inr i => rfl
  outputColor_eq := rfl

/-- The displayed original empty-sum profile bijection and its
actual inverse, with both original inverse equations. -/
def nullaryVariableProfileComponentIso (d : W) (Q : ColoredInputs W) :
    extendProfile (ColoredProfile.nullary d) Q ≅ ((inputsToProfile d).obj Q).toColoredProfile where
  hom := nullaryVariableProfileHom d Q
  inv := ColoredProfile.Hom.symm (nullaryVariableProfileHom d Q)
  hom_inv_id := by
    apply ColoredProfile.Hom.ext
    exact (Equiv.emptySum (Fin 0) Q.index).self_trans_symm
  inv_hom_id := by
    apply ColoredProfile.Hom.ext
    exact (Equiv.emptySum (Fin 0) Q.index).symm_trans_self

