/- Exact checked source: WeightedNormalization.SigmaOriginalNormalization. -/
section EnvelopingSource327


/-!
# The exact original frozen branch normalizer in its original coefficient/input frame
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension.AtomicNormalization

open CategoryTheory

private theorem mapThreeOriginal {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem normalizationFold {D : Type*} [Category* D] {A B C E F G H J K : D}
    (u : A ⟶ C) (f : A ⟶ B) (m : B ⟶ C) (i : C ⟶ E) (p : C ⟶ F) (b : F ⟶ G)
    (n₀ : G ⟶ E) (leaf : E ⟶ H) (r : B ⟶ J) (e : J ⟶ F) (g : G ⟶ K) (n₁ : K ⟶ H) (z : J ⟶ K)
    (hu : u = f ≫ m) (hi : i = p ≫ b ≫ n₀) (hm : m ≫ p = r ≫ e)
    (hl : n₀ ≫ leaf = g ≫ n₁) (hf : e ≫ b ≫ g = z) : u ≫ i ≫ leaf = f ≫ r ≫ z ≫ n₁ := by
  calc
    u ≫ i ≫ leaf = f ≫ m ≫ p ≫ b ≫ n₀ ≫ leaf := by rw [hu, hi]; simp only [Category.assoc]
    _ = f ≫ (m ≫ p) ≫ b ≫ (n₀ ≫ leaf) := by simp only [Category.assoc]
    _ = f ≫ (r ≫ e) ≫ b ≫ (g ≫ n₁) := congrArg₂ (fun x y => f ≫ x ≫ b ≫ y) hm hl
    _ = f ≫ r ≫ (e ≫ b ≫ g) ≫ n₁ := by simp only [Category.assoc]
    _ = f ≫ r ≫ z ≫ n₁ := congrArg (f ≫ r ≫ · ≫ n₁) hf

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Identify the weighted frozen frame with the empty-root and branch coefficient and leaf
blocks. -/
def nestedFrameIso (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    frozenWeightedNestedFamily O B P Q R ≅
      combinedInputBlocks (frozenCoefficientFamily O P Q R).index (frozenCoefficientFamily O
        P Q R).obj (oldLeafBlocks B
        Q R) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => (emptyLeafFamilyIso (O.obj (extendProfile P Q))).symm
    | some j => (profileOperationFactorsIso O B (R j).toColoredProfile).symm)

theorem weightedFrame_factor (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs
  W) (R : FrozenBranchTuple Q) :
    (oldWeightedFrameIso O B P Q R).hom = (frozenWeightedRootIso O B P Q R).hom ≫
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (nestedFrameIso O B P Q R).hom := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => rfl
    | some j =>
      let f := (profileOperationFactorsIso O B (R j).toColoredProfile).inv
      change HEq (T.map f) (𝟙 _ ≫ T.map f)
      exact heq_of_eq (Category.id_comp (T.map f)).symm

omit [FiniteTensor C] in
/-- The original singleton/profile comparison, original interchange and
entire original leaf correction are exactly the original frozen raw leaf map. -/
theorem nestedFrame_leaf_square (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q :
  ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).map (nestedFrameIso O B P Q R).hom ≫
      (coefficientBlockInterchangeFamilyIso (frozenCoefficientFamily O P Q R).index
        (frozenCoefficientFamily O P Q
        R).obj (oldLeafBlocks B Q R)).hom ≫
      (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (𝟙
        (frozenCoefficientFamily O P Q R))
        (oldLeavesIso B Q R).hom) =
        (frozenBranchLeafIso O B P Q R).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with | none => cases j; rfl | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j
      let X := O.obj (extendProfile P Q)
      change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some i =>
      cases j with
      | none =>
        let X := O.obj (R i).toColoredProfile
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])
      | some j =>
        let X := B ((R i).inputColor j)
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

/-- The complete original frozen branch normalizer is the original
coefficient/input interchange in its original empty/profile leaf frame. -/
theorem originalNormalizer_frame (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q :
  ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (oldWeightedFrameIso O B P Q R).hom ≫
      (coefficientBlockInterchangeTensorIso (frozenCoefficientFamily O P Q R).index
        (frozenCoefficientFamily O P Q
        R).obj (oldLeafBlocks B Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V := C)).obj
        (frozenCoefficientFamily O P Q R))) (oldLeavesIso B Q R).hom) =
        (frozenBranchTensorNormalizationIso O B P Q R).hom := by
  let T := FiniteTensor.tensor (V := C)
  let K := frozenCoefficientFamily O P Q R
  let L := oldLeafBlocks B Q R
  let M := combinedInputBlocks K.index K.obj L
  let N := frozenWeightedNestedFamily O B P Q R
  let u := T.map (oldWeightedFrameIso O B P Q R).hom
  let f := T.map (frozenWeightedRootIso O B P Q R).hom
  let m := T.map ((FiniteFamily.map T).map (nestedFrameIso O B P Q R).hom)
  let i := (coefficientBlockInterchangeTensorIso K.index K.obj L).hom
  let p := (FiniteTensor.flattenIso (V := C)).inv.app M
  let b := T.map (coefficientBlockInterchangeFamilyIso K.index K.obj L).hom
  let n₀ := coefficientLeavesNormalization K (totalBlockInputs K.index L)
  let leaf := T.map (coefficientLeafMap (𝟙 (T.obj K)) (oldLeavesIso B Q R).hom)
  let r := (FiniteTensor.flattenIso (V := C)).inv.app N
  let e := T.map ((FiniteFamily.flatten (C := C)).map (nestedFrameIso O B P Q R).hom)
  let g := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (𝟙 K)
    (oldLeavesIso B Q R).hom))
  let n₁ := coefficientLeavesNormalization K (frozenAlgebraLeaves B Q R)
  let z := T.map (frozenBranchLeafIso O B P Q R).hom
  have hu : u = f ≫ m := (congrArg T.map (weightedFrame_factor O B P Q R)).trans (T.map_comp _ _)
  have hi : i = p ≫ b ≫ n₀ := congrArg (fun n => p ≫ b ≫
    n) (coefficientLeavesNormalizationIso_hom K (totalBlockInputs
    K.index L))
  have hm : m ≫ p = r ≫ e := (FiniteTensor.flattenIso (V :=
    C)).inv.naturality (nestedFrameIso O B P Q R).hom
  have hleaf : g ≫ n₁ = n₀ ≫ leaf := (coefficientLeavesNormalization_naturality
    (𝟙 K) (oldLeavesIso B Q R).hom).trans
    (congrArg (fun f => n₀ ≫ T.map (coefficientLeafMap f (oldLeavesIso B Q R).hom)) (T.map_id K))
  have hf : e ≫ b ≫ g = z := (mapThreeOriginal T _ _ _).symm.trans (congrArg T.map
    (nestedFrame_leaf_square O B P Q R))
  have hread : (frozenBranchTensorNormalizationIso O B P Q R).hom = f ≫ r ≫ z ≫ n₁ :=
    congrArg (fun n => f ≫ r ≫ z ≫ n) (coefficientLeavesNormalizationIso_hom K
      (frozenAlgebraLeaves B Q R))
  exact (normalizationFold u f m i p b n₀ leaf r e g n₁ z hu hi hm hleaf.symm hf).trans hread.symm


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension.AtomicNormalization

end
