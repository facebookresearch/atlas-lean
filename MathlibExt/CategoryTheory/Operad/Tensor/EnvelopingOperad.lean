namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original root algebra unit and every original
inner branch coefficient contraction act on their original input positions. -/
def envelopingAssocFrozenContractionMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedUnitInputFamily O.toCollection d Q ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj
