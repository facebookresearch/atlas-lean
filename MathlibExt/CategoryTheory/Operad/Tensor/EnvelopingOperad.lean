theorem balancedAlgebraMap_operation (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingLinearOperad O A.carrier))
    (balance : ColoredOperadObj.Reflexive.AlgebraDescent.Balanced
