namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

private theorem routeFromTwoSquares {D : Type*} [Category* D]
    {A B C E F G H K : D}
    (p : A ⟶ B) (r : B ⟶ C) (q : C ⟶ E) (s : E ⟶ F) (o : F ⟶ G)
    (a : A ⟶ H) (p' : H ⟶ C) (o' : E ⟶ K) (l : K ⟶ G)
    (hp : p ≫ r = a ≫ p') (ho : s ≫ o = o' ≫ l) :
    p ≫ (r ≫ q ≫ s) ≫ o = a ≫ (p' ≫ q ≫ o') ≫ l := by
  calc
    p ≫ (r ≫ q ≫ s) ≫ o = (p ≫ r) ≫ q ≫ (s ≫ o) := by simp only [Category.assoc]
    _ = (a ≫ p') ≫ q ≫ (o' ≫ l) := congrArg₂ (fun x y => x ≫ q ≫ y) hp ho
    _ = a ≫ (p' ≫ q ≫ o') ≫ l := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Original finite block distribution is natural under every
complete original input-block map, while the actual coefficient tensors
and their original block indices are retained unchanged. -/
theorem distributionAfterInputMap (N : FiniteFamily (FiniteFamily C))
    (L M : N.index → FiniteFamily C) (l : ∀ i, L i ⟶ M i) :
    (FiniteTensor.tensor (V := C)).map
        (weightedInputBlockMap N.index (fun i => 𝟙 ((FiniteTensor.tensor (V :=
          C)).obj (N.obj i))) l) ≫
      (coefficientBlockInterchangeTensorIso N.index
        (fun i => (FiniteTensor.tensor (V := C)).obj (N.obj i)) M).hom =
    (partitionedScalarLeavesDistributionIso N L
        (fun i => (FiniteTensor.tensor (V := C)).obj (N.obj i))).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          (𝟙 ((FiniteTensor.tensor (V := C)).obj
            ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N)))
          ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l))) := by
  let T := FiniteTensor.tensor (V := C)
  let f := (FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l)
  let o := (coefficientBlockInterchangeTensorIso N.index (fun i => T.obj (N.obj i)) L).hom
  let d := (partitionedScalarLeavesDistributionIso N L (fun i => T.obj (N.obj i))).hom
  have hk : coefficientBlockMap N.index (fun i => 𝟙 (T.obj (N.obj i))) =
      𝟙 ((FiniteFamily.map T).obj N) := rfl
  have ht : T.map (coefficientBlockMap N.index (fun i => 𝟙 (T.obj (N.obj i)))) =
      𝟙 (T.obj ((FiniteFamily.map T).obj N)) :=
    (congrArg T.map hk).trans (T.map_id _)
  have hf : (partitionedScalarLeavesIso N L (fun i => T.obj (N.obj i))).hom =
      (coefficientBlockInterchangeFamilyIso N.index (fun i => T.obj (N.obj i)) L).hom := by
    apply FiniteFamily.Hom_ext
    · ext p
      rcases p with ⟨i, j⟩
      cases j <;> rfl
    · intro p
      rcases p with ⟨i, j⟩
      cases j <;> rfl
  have hd : d = o := congrArg
    (fun f => (FiniteTensor.flattenIso (V := C)).inv.app
      (combinedInputBlocks N.index (fun i => T.obj (N.obj i)) L) ≫ T.map f ≫
      (coefficientLeavesNormalizationIso ((FiniteFamily.map T).obj N)
        (totalBlockInputs N.index L)).hom) hf
  have hn := coefficientBlockInterchangeTensorIso_naturality N.index
    (fun i => 𝟙 (T.obj (N.obj i))) l
  exact hn.trans ((congrArg (fun c => o ≫ T.map (coefficientLeafMap c f)) ht).trans
    (congrArg (· ≫ T.map (coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N))) f)) hd.symm))

/-- Any original weighted source presentation is moved through its
genuine tensor flattening, original grouped normalization, and complete
input correction. This uses the actual finite tensor naturality laws. -/
theorem groupedNormalizationFromWeightedBlocks (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C)
    {P : FiniteFamily (FiniteFamily C)} (e : P ≅ groupedCoefficientInputWeightedBlocks N L)
    (M : N.index → FiniteFamily C)
    (l : ∀ i, groupedCoefficientInputs N L i ⟶ M i) :
    (FiniteTensor.flattenIso (V := C)).hom.app P ≫
      (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.map (FiniteTensor.tensor (V := C))).map e.hom ≫
          groupedCoefficientInputNormalizationMap N L ≫
          weightedInputBlockMap N.index
            (fun i => 𝟙 ((FiniteTensor.tensor (V := C)).obj (N.obj i))) l) ≫
      (coefficientBlockInterchangeTensorIso N.index
        (fun i => (FiniteTensor.tensor (V := C)).obj (N.obj i)) M).hom =
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map e.hom) ≫
      groupedCoefficientInputNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          (𝟙 ((FiniteTensor.tensor (V := C)).obj
            ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N)))
          ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l))) := by
  let T := FiniteTensor.tensor (V := C)
  let f := (FiniteFamily.map T).map e.hom
  let g := groupedCoefficientInputNormalizationMap N L
  let s := weightedInputBlockMap N.index (fun i => 𝟙 (T.obj (N.obj i))) l
  let p := (FiniteTensor.flattenIso (V := C)).hom.app P
  let a := T.map ((FiniteFamily.flatten (C := C)).map e.hom)
  let p' := (FiniteTensor.flattenIso (V := C)).hom.app (groupedCoefficientInputWeightedBlocks N L)
  let o := (coefficientBlockInterchangeTensorIso N.index (fun i => T.obj (N.obj i)) M).hom
  let o' := (partitionedScalarLeavesDistributionIso N (groupedCoefficientInputs N L)
    (fun i => T.obj (N.obj i))).hom
  let h := T.map (coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N)))
    ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l)))
  have hm : T.map (f ≫ g ≫ s) = T.map f ≫ T.map g ≫ T.map s :=
    (T.map_comp f (g ≫ s)).trans (congrArg (T.map f ≫ ·) (T.map_comp g s))
  have hp : p ≫ T.map f = a ≫ p' := (FiniteTensor.flattenIso (V := C)).hom.naturality e.hom |>.symm
  have ho : T.map s ≫ o = o' ≫ h :=
    distributionAfterInputMap N (groupedCoefficientInputs N L) M l
  exact (congrArg (fun c => p ≫ c ≫ o) hm).trans
    (routeFromTwoSquares p (T.map f) (T.map g) (T.map s) o a p' o' h hp ho)

variable {W : Type u}

/-- The exact original branch-first whole block normalizer is the
actual grouped normalizer followed by all its original leaf corrections. -/
theorem weightedBlockNormalizerA_grouped (O : ColoredSymmetricCollection W C) (B : W → C)
