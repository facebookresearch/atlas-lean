namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

private theorem generatorEvaluationFold {V : Type*} [Category* V]
    {X A K S T Y L T' : V}
    (g : X ⟶ A) (a : A ⟶ K) (i : K ⟶ S) (s : S ⟶ T) (t : T ⟶ Y)
    (q : T ⟶ T') (j : S ⟶ L) (s' : L ⟶ T') (t' : T' ⟶ Y) (k : K ⟶ L)
    (b : X ⟶ Y) (ins : Y ⟶ L)
    (ht : t = q ≫ t') (hs : s ≫ q = j ≫ s') (hi : i ≫ j = k)
    (hin : g ≫ a ≫ k = b ≫ ins) (hu : ins ≫ s' ≫ t' = 𝟙 Y) :
    g ≫ a ≫ i ≫ s ≫ t = b := by
  have h1 : g ≫ a ≫ i ≫ s ≫ t = g ≫ a ≫ i ≫ j ≫ s' ≫ t' := by
    have htotal : g ≫ a ≫ i ≫ s ≫ t = g ≫ a ≫ i ≫ s ≫ q ≫ t' :=
      congrArg (g ≫ a ≫ i ≫ s ≫ ·) ht
    have hsubst : g ≫ a ≫ i ≫ s ≫ q ≫ t' = g ≫ a ≫ i ≫ j ≫ s' ≫ t' := by
      simpa only [Category.assoc] using congrArg (fun z => g ≫ a ≫ i ≫ z ≫ t') hs
    exact htotal.trans hsubst
  have h2 : g ≫ a ≫ i ≫ j ≫ s' ≫ t' = g ≫ a ≫ k ≫ s' ≫ t' := by
    simpa only [Category.assoc] using congrArg (fun z => g ≫ a ≫ z ≫ s' ≫ t') hi
  have h3 : g ≫ a ≫ k ≫ s' ≫ t' = b ≫ ins ≫ s' ≫ t' := by
    simpa only [Category.assoc] using congrArg (· ≫ s' ≫ t') hin
  have h4 : b ≫ ins ≫ s' ≫ t' = b := (congrArg (b ≫ ·) hu).trans (Category.comp_id b)
  exact h1.trans (h2.trans (h3.trans h4))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original one-constant representative evaluates its original O
unit by u.map_unit and the actual target nullary left-unit law to precisely b. -/
theorem generatorRepresentative_evaluation {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (c : W) :
    generatorInsertion O B c ≫ representative u B b (ColoredProfile.nullary c)
      (generatorInputs c) = b c := by
  let T := FiniteTensor.tensor (V := C)
  let P := ColoredProfile.nullary c
  let Q := generatorInputs c
  let R := branches Q
  let S := frozenSubstitution P Q R
  let L := ColoredSubstitutionData.leftUnit P
  let g := generatorInsertion O B c
  let a := T.map (coefficientMap u B b P Q)
  let i := frozenSubstitutionCoefficientTensorMap E P Q R
  let s := E.subst.app S
  let t := E.toCollection.map (substitutionTotalHom P Q)
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (generatorShapeMap c))
  let j := T.map ((ColoredOperadObj.substitutionFactors E.toCollection).map (generatorShapeMap c))
  let s' := E.subst.app L
  let t' := E.toCollection.map (ColoredSubstitutionData.leftUnitTotalHom P)
  let k := T.map (generatorLeftCoefficient E c)
  let ins := ColoredOperadObj.leftUnitInsert E.toCollection E.unit P
  have ht : t = q ≫ t' := (congrArg E.toCollection.map (generatorShapeMap_total c)).trans
    (E.toCollection.map_comp _ _)
  have hs : s ≫ q = j ≫ s' := (E.subst.naturality (generatorShapeMap c)).symm
  have hi : i ≫ j = k := generatorFrozenTensor_compare E c
  have hin : g ≫ a ≫ k = b c ≫ ins := generatorInsertion_leftUnit u B b c
  have hu : ins ≫ s' ≫ t' = 𝟙 (E.toCollection.obj P) := E.left_unit P
  exact (congrArg (g ≫ ·) (representative_source O E u B b P Q)).trans
    (generatorEvaluationFold g a i s t q j s' t' k (b c) ins ht hs hi hin hu)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (c : W) : HasColimitsOfShape (AnalyticIndex W c) C :=
  hasProfileColimitsOfSmallColors C c

/-- The literal original free-generator/nullary-linear coefficient
formula followed by the constructed actual constants operad map reads back to b. -/
theorem operadMap_generator_formula {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (c : W) :
    ((profileUnit O).app B c ≫ (nullaryLinearCoefficientIso O.toCollection B c).inv) ≫
      (operadMap u B b).toCollectionHom.app (ColoredProfile.nullary c) = b c := by
  let g := generatorInsertion O B c
  let i := linearCoefficientι O.toCollection B (ColoredProfile.nullary c) (generatorInputs c)
  let f := (operadMap u B b).toCollectionHom.app (ColoredProfile.nullary c)
  exact (congrArg (· ≫ f) (generator_cofan_formula O B c)).trans
    ((Category.assoc g i f).trans
      ((congrArg (g ≫ ·) (operadMap_β u B b (ColoredProfile.nullary c) (generatorInputs c))).trans
        (generatorRepresentative_evaluation u B b c)))


