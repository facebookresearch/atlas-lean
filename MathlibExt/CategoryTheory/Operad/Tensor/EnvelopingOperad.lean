/- Exact checked source: ReflexiveOperad.Laws. -/
section EnvelopingSource335


/-!
# The full operad laws of the original pointwise reflexive quotient

Each law is proved after an original coefficient or finite heterogeneous
tensor quotient projection. No quotient unit, equivariance, substitution
or associativity law is assumed.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]
variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)
variable (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)

local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

omit [FiniteTensor C] [HasColimitsOfSize.{us, us} C]
  [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
private theorem EnvelopingSource335_compose_squares {X₀ X₁ X₂ Y₀ Y₁ Y₂ : C}
    {a : X₀ ⟶ X₁} {b : X₁ ⟶ X₂} {c : Y₀ ⟶ Y₁} {d : Y₁ ⟶ Y₂}
    {p : X₀ ⟶ Y₀} {q : X₁ ⟶ Y₁} {r : X₂ ⟶ Y₂}
    (hp : p ≫ c = a ≫ q) (hq : q ≫ d = b ≫ r) :
    p ≫ (c ≫ d) = (a ≫ b) ≫ r :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ d) hp).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (a ≫ ·) hq).trans (Category.assoc _ _ _).symm)))

/-- The actual pointwise quotient satisfies the full right unit law. -/
theorem right_unit : IsRightUnit (collection f g) (unit f g) (substitution f g t hf hg) := by
  intro s
  apply coequalizer.hom_ext
  have hi := rightUnitInsert_naturality (ηO := Q.unit) (ηP := unit f g) (collectionπ f g)
    (fun _c => rfl) s
  have h := EnvelopingSource335_compose_squares (EnvelopingSource335_compose_squares hi
    (substitution_readback f g t hf hg (ColoredSubstitutionData.rightUnit s)))
    (coefficientπ_map f g (ColoredSubstitutionData.rightUnitTotalHom s))
  exact (congrArg (coefficientπ f g s ≫ ·)
    (Category.assoc (rightUnitInsert (collection f g) (unit f g) s)
      (substitutionApp f g t hf hg (ColoredSubstitutionData.rightUnit s))
      (coefficientMap f g (ColoredSubstitutionData.rightUnitTotalHom s))).symm).trans
    (h.trans
      ((congrArg (· ≫ coefficientπ f g s)
        ((Category.assoc _ _ _).trans (Q.right_unit s))).trans
          ((Category.id_comp _).trans (Category.comp_id _).symm)))

/-- The actual pointwise quotient satisfies the full left unit law. -/
theorem left_unit : IsLeftUnit (collection f g) (unit f g) (substitution f g t hf hg) := by
  intro s
  apply coequalizer.hom_ext
  have hi := leftUnitInsert_naturality (ηO := Q.unit) (ηP := unit f g) (collectionπ f g)
    (fun _c => rfl) s
  have h := EnvelopingSource335_compose_squares (EnvelopingSource335_compose_squares hi
    (substitution_readback f g t hf hg (ColoredSubstitutionData.leftUnit s)))
    (coefficientπ_map f g (ColoredSubstitutionData.leftUnitTotalHom s))
  exact (congrArg (coefficientπ f g s ≫ ·)
    (Category.assoc (leftUnitInsert (collection f g) (unit f g) s)
      (substitutionApp f g t hf hg (ColoredSubstitutionData.leftUnit s))
      (coefficientMap f g (ColoredSubstitutionData.leftUnitTotalHom s))).symm).trans
    (h.trans
      ((congrArg (· ≫ coefficientπ f g s)
        ((Category.assoc _ _ _).trans (Q.left_unit s))).trans
          ((Category.id_comp _).trans (Category.comp_id _).symm)))

/-- The complete three-level associativity law follows from Q's original
law after the actual tensor of all original coefficient projections. -/
theorem associative : IsAssociative (collection f g) (substitution f g t hf hg) := by
  intro d
  let S := (FiniteFamily.flatten (C := ColoredProfile W)).obj (Routing.groupingAProfiles d)
  let eQ := (FiniteTensor.tensor (V := C)).mapIso (Routing.flattenedAComparison Q.toCollection d)
  let eR := (FiniteTensor.tensor (V := C)).mapIso (Routing.flattenedAComparison (collection f g) d)
  have hp : tensorπ f g S ≫ eR.hom = eQ.hom ≫ Routing.commonSourceHom (collectionπ f g) d := by
    exact ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
      ((congrArg (FiniteTensor.tensor (V := C)).map
        (Routing.flattenedAHom_readback (collectionπ f g) d)).trans
          ((FiniteTensor.tensor (V := C)).map_comp _ _))
  apply (cancel_epi eR.hom).1
  apply tensor_hom_ext f g t hf hg S
  have ha := EnvelopingSource335_compose_squares hp
    (Routing.routeA_naturality (collectionπ f g) (projection_map_subst f g t hf hg) d)
  have hb := EnvelopingSource335_compose_squares hp
    (Routing.routeB_naturality (collectionπ f g) (projection_map_subst f g t hf hg) d)
  exact ha.trans
    ((congrArg (fun a => (eQ.hom ≫ a) ≫ (collectionπ f g).app d.outerAfterInnerData.totalProfile)
      (Q.assoc d)).trans hb.symm)

/-- The actual full colored operad produced from the pointwise reflexive coequalizers. -/
def operad : ColoredOperadObj W C where
  toCollection := collection f g
  unit := unit f g
  subst := substitution f g t hf hg
  right_unit := right_unit f g t hf hg
  left_unit := left_unit f g t hf hg
  assoc := associative f g t hf hg


end CategoryTheory.Operad.ColoredOperadObj.Reflexive

end
end EnvelopingSource335

/- Exact checked source: ReflexiveOperad.Coequalizer. -/
section EnvelopingSource336


/-!
# Actual pointwise reflexive coequalizers of full colored tensor operads

The quotient, its full projection, every full coequalizing-map descent and
the complete cofork universal property are constructed from the original
P/Q/f/g/t alone. In particular, no output operad or quotient law is an input.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]
variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)
variable (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)

local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- The original coefficient quotient maps give a full operad projection. -/
def projection : Q ⟶ operad f g t hf hg where
  toCollectionHom := collectionπ f g
  map_unit _c := rfl
  map_subst := projection_map_subst f g t hf hg

@[simp]
theorem projection_app (s : ColoredProfile W) :
    (projection f g t hf hg).toCollectionHom.app s =
      coequalizer.π (f.toCollectionHom.app s) (g.toCollectionHom.app s) := rfl

/-- The original full operad maps are coequalized by the full projection. -/
theorem projection_condition : f ≫ projection f g t hf hg = g ≫ projection f g t hf hg :=
  Hom.ext (collection_condition f g)

omit [HasColimitsOfSize.{us, us} C] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- A full operad-map cofork gives exactly the original collection balance. -/
theorem originalCollectionBalance {S : ColoredOperadObj W C} (h : Q ⟶ S)
    (balance : f ≫ h = g ≫ h) :
    f.toCollectionHom ≫ h.toCollectionHom = g.toCollectionHom ≫ h.toCollectionHom :=
  congrArg (forget (Color := W) (V := C)).map balance

/-- Every full operad-map cofork descends to a full operad map. -/
def desc {S : ColoredOperadObj W C} (h : Q ⟶ S) (balance : f ≫ h = g ≫ h) :
    operad f g t hf hg ⟶ S where
  toCollectionHom := collectionDesc f g h.toCollectionHom (originalCollectionBalance f g h balance)
  map_unit c := by
    change (Q.unit c ≫ coefficientπ f g (ColoredSubstitutionData.unitProfile c)) ≫
      (collectionDesc f g h.toCollectionHom (originalCollectionBalance f g h balance)).app
        (ColoredSubstitutionData.unitProfile c) = S.unit c
    exact (Category.assoc _ _ _).trans
      ((congrArg (Q.unit c ≫ ·)
        (collectionπ_desc_app f g h.toCollectionHom (originalCollectionBalance f g h balance)
          (ColoredSubstitutionData.unitProfile c))).trans (h.map_unit c))
  map_subst s := by
    let δ := collectionDesc f g h.toCollectionHom (originalCollectionBalance f g h balance)
    apply tensor_hom_ext f g t hf hg s.factorFamily
    change HomData.sourceHom (collectionπ f g) s ≫
        (substitutionApp f g t hf hg s ≫ δ.app s.totalProfile) =
      HomData.sourceHom (collectionπ f g) s ≫
        (HomData.sourceHom δ s ≫ S.subst.app s)
    have hs : HomData.sourceHom (collectionπ f g) s ≫ HomData.sourceHom δ s =
        HomData.sourceHom h.toCollectionHom s :=
      (HomData.sourceHom_comp (collectionπ f g) δ s).symm.trans
        (congrArg (fun a => HomData.sourceHom a s)
          (collectionπ_desc f g h.toCollectionHom (originalCollectionBalance f g h balance)))
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ δ.app s.totalProfile) (substitution_readback f g t hf hg s)).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (Q.subst.app s ≫ ·)
            (collectionπ_desc_app f g h.toCollectionHom (originalCollectionBalance f g h balance)
              s.totalProfile)).trans
            ((h.map_subst s).trans
              ((congrArg (· ≫ S.subst.app s) hs.symm).trans (Category.assoc _ _ _))))))

@[simp]
theorem projection_desc {S : ColoredOperadObj W C} (h : Q ⟶ S) (balance : f ≫ h = g ≫ h) :
    projection f g t hf hg ≫ desc f g t hf hg h balance = h :=
  Hom.ext (collectionπ_desc f g h.toCollectionHom (originalCollectionBalance f g h balance))

theorem hom_ext {S : ColoredOperadObj W C} {h k : operad f g t hf hg ⟶ S}
    (eq : projection f g t hf hg ≫ h = projection f g t hf hg ≫ k) : h = k :=
  Hom.ext (collection_hom_ext f g (congrArg (forget (Color := W) (V := C)).map eq))

/-- Full unique factorization of every original operad-map cofork. -/
theorem existsUnique_desc {S : ColoredOperadObj W C} (h : Q ⟶ S) (balance : f ≫ h = g ≫ h) :
    ∃! k : operad f g t hf hg ⟶ S, projection f g t hf hg ≫ k = h :=
  ⟨desc f g t hf hg h balance, projection_desc f g t hf hg h balance,
    fun _k hk => hom_ext f g t hf hg (hk.trans (projection_desc f g t hf hg h balance).symm)⟩

/-- The actual operad cofork with the original full projection. -/
def cofork : Cofork f g :=
  Cofork.ofπ (projection f g t hf hg) (projection_condition f g t hf hg)

/-- The full operad cofork is colimiting. -/
def isColimit : IsColimit (cofork f g t hf hg) :=
  Cofork.IsColimit.mk (cofork f g t hf hg)
    (fun s => desc f g t hf hg s.π s.condition)
    (fun s => projection_desc f g t hf hg s.π s.condition)
    (fun s _m hm => hom_ext f g t hf hg
      (hm.trans (projection_desc f g t hf hg s.π s.condition).symm))

/-- The complete Hom universal property retains the actual original source map. -/
def homEquiv (S : ColoredOperadObj W C) :
    (operad f g t hf hg ⟶ S) ≃ {h : Q ⟶ S // f ≫ h = g ≫ h} :=
  Cofork.IsColimit.homIso (isColimit f g t hf hg) S

@[simp]
theorem homEquiv_apply (S : ColoredOperadObj W C) (h : operad f g t hf hg ⟶ S) :
    (homEquiv f g t hf hg S h).val = projection f g t hf hg ≫ h := rfl

/-- The full Hom equivalence is natural under every full target operad map. -/
theorem homEquiv_naturality {S T : ColoredOperadObj W C} (h : operad f g t hf hg ⟶ S) (k : S ⟶ T) :
    (homEquiv f g t hf hg T (h ≫ k)).val = (homEquiv f g t hf hg S h).val ≫ k :=
  (Category.assoc _ _ _).symm

/-- Every profile of the full operad cofork is the actual original pointwise coequalizer. -/
theorem cofork_profile (s : ColoredProfile W) :
    (cofork f g t hf hg).pt.toCollection.obj s =
      coequalizer (f.toCollectionHom.app s) (g.toCollectionHom.app s) := rfl

/-- Its profile projection is the unchanged original pointwise coequalizer projection. -/
theorem cofork_profile_π (s : ColoredProfile W) :
    (cofork f g t hf hg).π.toCollectionHom.app s =
      coequalizer.π (f.toCollectionHom.app s) (g.toCollectionHom.app s) := rfl

/-- At every original profile the projection has its full reflexive coequalizer universal
property. -/
def coforkProfileIsColimit (s : ColoredProfile W) :
    IsColimit (Cofork.ofπ ((cofork f g t hf hg).π.toCollectionHom.app s)
      (coefficient_condition f g s)) := coequalizerIsCoequalizer _ _

/-- Compare the chosen original reflexive colimit to the actual operad coefficient. -/
def profileReflexiveColimitIso (s : ColoredProfile W) :
    colimit (coefficientDiagram f g t hf hg s) ≅ (operad f g t hf hg).toCollection.obj s :=
  reflexiveCoequalizerIsoCoequalizer (coefficientDiagram f g t hf hg s)

/-- The original reflexive colimit projection compares to the unchanged original operad
projection. -/
@[reassoc]
theorem profileReflexiveColimitIso_ι (s : ColoredProfile W) :
    colimit.ι (coefficientDiagram f g t hf hg s) WalkingReflexivePair.zero ≫
        (profileReflexiveColimitIso f g t hf hg s).hom =
      (projection f g t hf hg).toCollectionHom.app s :=
  ι_reflexiveCoequalizerIsoCoequalizer_hom (coefficientDiagram f g t hf hg s)


end CategoryTheory.Operad.ColoredOperadObj.Reflexive

end
end EnvelopingSource336

/- Exact checked source: EnvelopingOperadConstruction. -/
section EnvelopingSource337


/-!
# The genuine original enveloping operad and its full quotient universal property
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original O-algebra constructs its enveloping operad
as the full reflexive quotient of the original operadic constant-input
face and original algebra-action face. No enveloping output is an input. -/
def envelopingOperad (O : ColoredOperadObj W C) (A : Algebra O) : ColoredOperadObj W C :=
  ColoredOperadObj.Reflexive.operad (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A)

/-- Every enveloping coefficient is exactly its original weighted
constant-input/algebra-action coequalizer at that original profile. -/
theorem envelopingOperad_coefficient (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    (envelopingOperad O A).toCollection.obj P = envelopingCoefficientObj O A P := rfl

/-- The constructed full operad retains the original symmetric
coefficient collection, every profile map and all original nullary data. -/
theorem envelopingOperad_collection (O : ColoredOperadObj W C) (A : Algebra O) :
    (envelopingOperad O A).toCollection = Variable.envelopingCoefficientCollection O A := rfl

/-- The actual coefficient quotient maps give the genuine full
linear-to-enveloping operad projection. -/
def envelopingOperadProjection (O : ColoredOperadObj W C) (A : Algebra O) :
    envelopingLinearOperad O A.carrier ⟶ envelopingOperad O A :=
  ColoredOperadObj.Reflexive.projection (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A)

/-- Every original profile projection is literally its original
weighted coefficient coequalizer leg. -/
theorem envelopingOperadProjection_app (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    (envelopingOperadProjection O A).toCollectionHom.app P = envelopingCoefficientπ O A P := rfl

/-- The full operad projection retains the entire original coefficient
projection natural transformation and every original profile permutation. -/
theorem envelopingOperadProjection_collection (O : ColoredOperadObj W C) (A : Algebra O) :
    (envelopingOperadProjection O A).toCollectionHom =
      Variable.envelopingCoefficientProjection O A := rfl

/-- Original O-operations enter the genuine enveloping operad
through their original no-added-input summand and original quotient. -/
def originalOperadToEnveloping (O : ColoredOperadObj W C) (A : Algebra O) : O ⟶
  envelopingOperad O A :=
  originalOperationToLinearOperadMap O A.carrier ≫ envelopingOperadProjection O A

/-- Every original O-operation map is literally the original
empty-summand coefficient inclusion followed by the original quotient. -/
theorem originalOperadToEnveloping_app (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    (originalOperadToEnveloping O A).toCollectionHom.app P =
      originalOperationToEnveloping O A P := rfl

/-- The enveloping unit is the actual original linear operad unit
followed by its original coefficient quotient leg. -/
theorem envelopingOperad_unit (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (envelopingOperad O A).unit d = envelopingLinearUnit O A.carrier d ≫
      envelopingCoefficientπ O A (ColoredSubstitutionData.unitProfile d) := rfl

/-- The same unit retains the original O-unit and original
O-operation inclusion in the actual enveloping coefficient. -/
theorem envelopingOperad_unit_original (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (envelopingOperad O A).unit d =
      O.unit d ≫ originalOperationToEnveloping O A (ColoredSubstitutionData.unitProfile d) :=
  Category.assoc _ _ _

/-- The genuine projection preserves the full actual original
simultaneous substitution, with every quotient tensor map retained. -/
theorem envelopingOperad_substitution_projection (O : ColoredOperadObj W C) (A : Algebra O)
    (s : ColoredSubstitutionData W) :
    ColoredOperadObj.HomData.sourceHom (envelopingOperadProjection O A).toCollectionHom s ≫
      (envelopingOperad O A).subst.app s =
    envelopingLinearSubstitution O A.carrier s ≫ envelopingCoefficientπ O A s.totalProfile :=
  ((envelopingOperadProjection O A).map_subst s).symm

/-- The original action and operadic constant-input faces agree
as full operad arrows after the actual enveloping projection. -/
theorem envelopingOperadProjection_condition (O : ColoredOperadObj W C) (A : Algebra O) :
    constantRelationOperadFace O A.carrier ≫ envelopingOperadProjection O A =
      algebraRelationOperadFace O A ≫ envelopingOperadProjection O A :=
  ColoredOperadObj.Reflexive.projection_condition (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O
    A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A)

/-- Every genuine full operad map balancing the original two faces
descends uniquely through the actual enveloping operad quotient. -/
def envelopingOperadDesc (O : ColoredOperadObj W C) (A : Algebra O) {E : ColoredOperadObj W C}
    (h : envelopingLinearOperad O A.carrier ⟶ E)
    (balance : constantRelationOperadFace O A.carrier ≫ h = algebraRelationOperadFace O A ≫ h) :
    envelopingOperad O A ⟶ E :=
  ColoredOperadObj.Reflexive.desc (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A) h balance

/-- The descended full map retains precisely its original map
before the original enveloping coefficient projection. -/
theorem envelopingOperadProjection_desc (O : ColoredOperadObj W C) (A : Algebra O) {E :
  ColoredOperadObj W C}
    (h : envelopingLinearOperad O A.carrier ⟶ E)
    (balance : constantRelationOperadFace O A.carrier ≫ h = algebraRelationOperadFace O A ≫ h) :
    envelopingOperadProjection O A ≫ envelopingOperadDesc O A h balance = h :=
  ColoredOperadObj.Reflexive.projection_desc (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A) h balance

/-- The actual full quotient projection determines every full
map out of the constructed enveloping operad. -/
theorem envelopingOperad_hom_ext (O : ColoredOperadObj W C) (A : Algebra O) {E :
  ColoredOperadObj W C}
    {f g : envelopingOperad O A ⟶ E}
    (h : envelopingOperadProjection O A ≫ f = envelopingOperadProjection O A ≫ g) : f = g :=
  ColoredOperadObj.Reflexive.hom_ext (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A) h

/-- The actual original operad relation cofork is colimiting. -/
def envelopingOperadCofork (O : ColoredOperadObj W C) (A : Algebra O) :
    Cofork (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A) :=
  Cofork.ofπ (envelopingOperadProjection O A) (envelopingOperadProjection_condition O A)

/-- Full coequalizer universality follows from the actual original
reflexive operad construction and original section, not an output premise. -/
def envelopingOperadIsColimit (O : ColoredOperadObj W C) (A : Algebra O) : IsColimit
  (envelopingOperadCofork O A) :=
  ColoredOperadObj.Reflexive.isColimit (constantRelationOperadFace O A.carrier)
    (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A)

/-- The constructed nullary enveloping coefficient is the original
genuine algebra carrier by its actual original coequalizer comparison. -/
def envelopingOperadNullaryIso (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (envelopingOperad O A).toCollection.obj (ColoredProfile.nullary d) ≅ A.carrier d :=
  Nullary.envelopingNullaryCoefficientIso O A d

/-- The actual nullary projection under that comparison is the
original nullary linear coefficient/algebra-action evaluation. -/
theorem envelopingOperadNullaryIso_projection (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (envelopingOperadProjection O A).toCollectionHom.app (ColoredProfile.nullary d) ≫
      (envelopingOperadNullaryIso O A d).hom = nullaryLinearAlgebraEvaluation O A d :=
  Nullary.envelopingNullaryCoefficientIso_π O A d

/-- Every original nullary coefficient cofan reads back to the
original O-algebra operation with its original tensor/profile map. -/
theorem envelopingOperadNullaryIso_cofan (O : ColoredOperadObj W C) (A : Algebra O)
    (d : W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection A.carrier (ColoredProfile.nullary d) Q ≫
      (envelopingOperadProjection O A).toCollectionHom.app (ColoredProfile.nullary d) ≫
      (envelopingOperadNullaryIso O A d).hom =
    (nullaryLinearDiagramIso O.toCollection A.carrier d).hom.app Q ≫
      A.operations.app d ((inputsToProfile d).obj Q) :=
  Nullary.envelopingNullaryCoefficientIso_ι O A d Q


end CategoryTheory.Operad.Tensor.Enveloping

