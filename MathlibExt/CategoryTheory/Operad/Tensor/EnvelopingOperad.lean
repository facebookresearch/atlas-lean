      T.map eJ.inv ≫ n ≫ T.map eI.inv ≫ d ≫ v := by
    have h := precomposeFold (T.map E.inv) (T.map (F.map p)) c (T.map bC)
      (z ≫ rF) n (T.map eI.inv ≫ d ≫ v) (T.map eC.inv) (T.map eJ.inv) hfold heC heJ
    simpa only [Category.assoc] using h
