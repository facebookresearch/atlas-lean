section EnvelopingSource190


/-!
# Actual joint variable-profile and algebra-input maps of linear coefficients
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original extension map factors through the original
algebra-input map and original variable-profile map. -/
theorem extendProfileMap_joint {P P' : ColoredProfile W} (f : P ⟶ P')
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    extendProfileMap (𝟙 P) g ≫ extendProfileMap f (𝟙 Q') = extendProfileMap f g := by
  apply ColoredProfile.Hom.ext
  ext i
  cases i <;> rfl

/-- The actual coefficient/input factor map retains the original
joint variable and algebra-input profile map. -/
theorem linearCoefficientFactors_joint (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).map g ≫
        (coefficientInputFactorsMap (Functor.whiskerRight (fixedProfileExtensionMap f) O)
          (𝟙 (addedAlgebraInputs B))).app Q' =
      coefficientLeafMap (O.map (extendProfileMap f g)) ((addedAlgebraInputs B).map g) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap (𝟙 P) g) ≫ O.map (extendProfileMap f (𝟙 Q')))
        (O.map (extendProfileMap f g))
      exact heq_of_eq ((O.map_comp _ _).symm.trans (congrArg O.map (extendProfileMap_joint f g)))
    | some i =>
      change HEq ((Discrete.functor B).map (g.hom i) ≫ 𝟙 _)
        ((Discrete.functor B).map (g.hom i))
      exact heq_of_eq (Category.comp_id _)

variable [FiniteTensor C]

/-- The actual joint tensor map factors through the original
input diagram map and original variable-profile natural transformation. -/
theorem linearCoefficientTensor_joint (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (linearCoefficientDiagram O B P).map g ≫ (linearCoefficientProfileMap O B f).app Q' =
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.map (extendProfileMap f g)) ((addedAlgebraInputs B).map g)) := by
  let T := FiniteTensor.tensor (V := C)
  exact (T.map_comp _ _).symm.trans (congrArg T.map (linearCoefficientFactors_joint O B f g))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

private theorem originalJointInjectionSquare {V : Type*} [Category* V]
    {X Y Z U D : V} (f : X ⟶ Y) (a : Y ⟶ Z) (b : X ⟶ Z)
    (i : Y ⟶ U) (j : Z ⟶ D) (k : X ⟶ U) (h : U ⟶ D)
    (hab : f ≫ a = b) (hij : a ≫ j = i ≫ h) (hfi : f ≫ i = k) :
    b ≫ j = k ≫ h := by
  rw [← hab, Category.assoc, hij, ← Category.assoc, hfi]

/-- The actual joint profile/input map retains the original
linear colimit injection and full original variable-profile map. -/
theorem linearCoefficientι_joint (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.map (extendProfileMap f g)) ((addedAlgebraInputs B).map g)) ≫
        linearCoefficientι O B P' Q' =
      linearCoefficientι O B P Q ≫ linearCoefficientMap O B f := by
  exact originalJointInjectionSquare
    ((linearCoefficientDiagram O B P).map g) ((linearCoefficientProfileMap O B f).app Q')
    ((FiniteTensor.tensor (V := C)).map
      (coefficientLeafMap (O.map (extendProfileMap f g)) ((addedAlgebraInputs B).map g)))
    (linearCoefficientι O B P Q') (linearCoefficientι O B P' Q') (linearCoefficientι O B P Q)
    (linearCoefficientMap O B f) (linearCoefficientTensor_joint O B f g)
    (linearCoefficientι_profileMap O B f Q').symm (linearCoefficient_relabel O B P g)


end CategoryTheory.Operad.Tensor.Enveloping

end
