private theorem operationDescentFiring {V : Type*} [Category* V]
    {X A B C Y : V} (i : X ⟶ A) (a : A ⟶ B) (op' : B ⟶ Y)
    (d : X ⟶ C) (i' : C ⟶ B) (ev' : C ⟶ Y) (op : A ⟶ Y) (ev : X ⟶ Y)
    (ha : i ≫ a = d ≫ i') (hb : i' ≫ op' = ev') (he : d ≫ ev' = ev) (h0 : i ≫ op = ev) :
    i ≫ (a ≫ op') = i ≫ op := by
  calc
    i ≫ (a ≫ op') = (i ≫ a) ≫ op' := (Category.assoc _ _ _).symm
    _ = (d ≫ i') ≫ op' := congrArg (· ≫ op') ha
    _ = d ≫ (i' ≫ op') := Category.assoc _ _ _
    _ = d ≫ ev' := congrArg (d ≫ ·) hb
    _ = ev := he
    _ = i ≫ op := h0.symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The complete original operation cofan is natural under every
original variable profile map and its actual tensor input map. -/
theorem operationInjection_variable (O : ColoredSymmetricCollection W C) (B M : W → C)
    {d : W} {P P' : AnalyticIndex W d} (f : P ⟶ P') (Q : ColoredInputs W) :
    operationInjection O B M P Q ≫
        (analyticSummand (d := d) (linearCoefficientCollection O B) M).map f =
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((linearCoefficientProfileMap O B f).app Q) (profileLeafIso M f).hom) ≫
        operationInjection O B M P' Q := by
  let T := FiniteTensor.tensor (V := C)
  let E := linearCoefficientCollection O B
  let L := profileLeafFamily M P.toColoredProfile
  let L' := profileLeafFamily M P'.toColoredProfile
  let i := linearCoefficientι O B P.toColoredProfile Q
  let i' := linearCoefficientι O B P'.toColoredProfile Q
  let c := E.map f
  let b := (linearCoefficientProfileMap O B f).app Q
  let ell := (profileLeafIso M f).hom
  let u := (coefficientLeafTensorFunctor L).map i
  let u' := (coefficientLeafTensorFunctor L').map i'
  let k := T.map (coefficientLeafMap c ell)
  let r := T.map (coefficientLeafMap b ell)
  let e := (operationProfileIso O B M P).hom
  let e' := (operationProfileIso O B M P').hom
  let a := (analyticSummand (d := d) E M).map f
  have hc : i ≫ c = b ≫ i' := linearCoefficientι_profileMap O B f Q
  have hfamily : (coefficientLeafFamilyFunctor L).map i ≫ coefficientLeafMap c ell =
      coefficientLeafMap b ell ≫ (coefficientLeafFamilyFunctor L').map i' :=
    (coefficientLeafMap_pre i c ell).trans
      ((congrArg (fun c => coefficientLeafMap c ell) hc).trans (coefficientLeafMap_post b i'
        ell).symm)
  have h2 : u ≫ k = r ≫ u' := (T.map_comp _ _).symm.trans
    ((congrArg T.map hfamily).trans (T.map_comp _ _))
  have hm : (operationSummandFunctor E M).map f = a :=
    congrArg T.map (operationFactorsFunctor_map_restrict E M f)
  have h1 : e ≫ a = k ≫ e' :=
    (congrArg (e ≫ ·) hm).symm.trans (profileCoefficientLeafTensorIso_naturality E M f)
  exact injectionTransport u e a k e' r u' h1 h2

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Every original variable-profile permutation commutes with the
complete coefficient-colimit operation, proved on its actual cofan. -/
theorem operationApp_equivariance (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) {d : W} {P P' : AnalyticIndex W d} (f : P ⟶ P') :
    (analyticSummand (d := d) (linearCoefficientCollection O.toCollection B) M.carrier).map f ≫
      operationApp O B M g d P' = operationApp O B M g d P := by
  apply operation_hom_ext O.toCollection B M.carrier P
  intro Q
  let i := operationInjection O.toCollection B M.carrier P Q
  let a := (analyticSummand (d := d) (linearCoefficientCollection O.toCollection B) M.carrier).map f
  let op' := operationApp O B M g d P'
  let r := (FiniteTensor.tensor (V := C)).map
    (coefficientLeafMap ((linearCoefficientProfileMap O.toCollection B f).app Q)
      (profileLeafIso M.carrier f).hom)
  let i' := operationInjection O.toCollection B M.carrier P' Q
  let ev' := representativeEvaluation O B M g P'.toColoredProfile Q
  let op := operationApp O B M g d P
  let ev := representativeEvaluation O B M g P.toColoredProfile Q
  have ha : i ≫ a = r ≫ i' := operationInjection_variable O.toCollection B M.carrier f Q
  have hb : i' ≫ op' = ev' := operationApp_beta O B M g d P' Q
  have he : r ≫ ev' = ev := representativeEvaluation_variable O B M g f Q
  have h0 : i ≫ op = ev := operationApp_beta O B M g d P Q
  exact operationDescentFiring i a op' r i' ev' op ev ha hb he h0

/-- Actual original O-algebras with an original map from B carry
the full equivariant tensor operation family on the constructed
linear coefficient collection, including every nullary profile. -/
def linearOperations (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) :
    Operations (linearCoefficientCollection O.toCollection B) M.carrier M.carrier where
  app := operationApp O B M g
  equivariance _d _P _P' f := operationApp_equivariance O B M g f

/-- Every operation of the full linear family retains the original
coefficient cofan and its exact original constant-input evaluation. -/
theorem linearOperations_beta (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (d : W) (P : AnalyticIndex W d) (Q : ColoredInputs W) :
    operationInjection O.toCollection B M.carrier P Q ≫ (linearOperations O B M g).app d P =
      representativeEvaluation O B M g P.toColoredProfile Q := operationApp_beta O B M g d P Q


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
