/- Exact checked source: WeightedNormalization.RootTensorData. -/
section EnvelopingSource271


/-!
# Original root coefficient splitting and finite tensor refinements
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.RootTensor

open CategoryTheory

variable {C : Type w} [Category.{v} C]

/-- Group the root leaf family and each branch leaf family at separate slots. -/
def sourceGroups (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I →
  FiniteFamily C) : FiniteFamily (FiniteFamily
  C) where
  index := FintypeCat.of (Option I)
  obj i := match i with | none => L | some i => M i

/-- Refine the root family into singleton leaves and each branch family into a single block. -/
def refinedGroups (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) :
    FiniteFamily (FiniteFamily (FiniteFamily C)) where
  index := FintypeCat.of (Option I)
  obj i := match i with
    | none => (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj L
    | some i => (FiniteFamily.singleton (C := FiniteFamily C)).obj (M i)

/-- Split the root into singleton leaf blocks while retaining the original branch blocks. -/
def splitGroups (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I →
  FiniteFamily C) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (L.index ⊕ I)
  obj i := match i with
    | Sum.inl i => (FiniteFamily.singleton (C := C)).obj (L.obj i)
    | Sum.inr i => M i

/-- Identify the flattened original groups with the flattened grouping having split root leaves. -/
def sourceToSplitIso (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (sourceGroups I L M) ≅ (FiniteFamily.flatten (C :=
      C)).obj (splitGroups I L M)
      :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with
      | ⟨none, i⟩ => ⟨Sum.inl i, PUnit.unit⟩
      | ⟨some i, j⟩ => ⟨Sum.inr i, j⟩
      invFun := fun p => match p with | ⟨Sum.inl i, _⟩ => ⟨none, i⟩ | ⟨Sum.inr i, j⟩ => ⟨some i, j⟩
      left_inv := fun p => by rcases p with ⟨i, j⟩; cases i <;> rfl
      right_inv := fun p =>
        by rcases p with ⟨i, j⟩; cases i with | inl i => cases j; rfl | inr i => rfl }
    (fun p => by rcases p with ⟨i, j⟩; cases i <;> exact Iso.refl _)

/-- Flatten each refined slot to recover the original root and branch families. -/
def localFlattenIso (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (refinedGroups I L M) ≅
      sourceGroups I L M :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option I)) (fun i => match i with
    | none => FiniteFamily.mapSingletonFlattenIso.app L
    | some i => FiniteFamily.singletonFlattenIso.app (M i))

/-- Flatten the outer refinement to obtain split root leaves and retained branch blocks. -/
def fineFlattenIso (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) :
    (FiniteFamily.flatten (C := FiniteFamily C)).obj (refinedGroups I L M) ≅ splitGroups I L M :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | ⟨none, i⟩ => Sum.inl i | ⟨some i, _⟩ => Sum.inr i
      invFun := fun p => match p with | Sum.inl i => ⟨none, i⟩ | Sum.inr i => ⟨some i, PUnit.unit⟩
      left_inv := fun p =>
        by rcases p with ⟨i, j⟩; cases i with | none => rfl | some i => cases j; rfl
      right_inv := fun p => by cases p <;> rfl }
    (fun p => by rcases p with ⟨i, j⟩; cases i <;> exact Iso.refl _)

theorem rawTriangle (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map (localFlattenIso I L M).hom ≫ (sourceToSplitIso I L M).hom =
      FiniteFamily.flattenAssocIso.hom.app (refinedGroups I L M) ≫
        (FiniteFamily.flatten (C := C)).map (fineFlattenIso I
        L M).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, ⟨j, k⟩⟩
    cases i with | none => cases k; rfl | some i => cases j; rfl
  · intro p
    rcases p with ⟨i, ⟨j, k⟩⟩
    cases i with | none => cases k; rfl | some i => cases j; rfl

/-- The family consisting of a root output and one output at each branch position. -/
def targetFamily (I : FintypeCat.{0}) (X : C) (Y : I → C) : FiniteFamily C where
  index := FintypeCat.of (Option I)
  obj i := match i with | none => X | some i => Y i

/-- Group the root leaves together with singleton branch outputs. -/
def rootOutputGroups (I : FintypeCat.{0}) (L : FiniteFamily C) (Y : I →
  C) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option I)
  obj i := match i with | none => L | some i => (FiniteFamily.singleton (C := C)).obj (Y i)

/-- The atomic family of root leaves followed by branch outputs. -/
def atomicOutputs (I : FintypeCat.{0}) (L : FiniteFamily C) (Y : I → C) : FiniteFamily C where
  index := FintypeCat.of (L.index ⊕ I)
  obj i := match i with | Sum.inl i => L.obj i | Sum.inr i => Y i

/-- Regroup atomic root leaves and branch outputs into a root block and singleton output blocks. -/
def regroupOutputIso (I : FintypeCat.{0}) (L : FiniteFamily C) (Y : I → C) :
    atomicOutputs I L Y ≅ (FiniteFamily.flatten (C := C)).obj (rootOutputGroups I L Y) :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with | Sum.inl i => ⟨none, i⟩ | Sum.inr i => ⟨some i, PUnit.unit⟩
      invFun := fun p => match p with | ⟨none, i⟩ => Sum.inl i | ⟨some i, _⟩ => Sum.inr i
      left_inv := fun i => by cases i <;> rfl
      right_inv := fun p =>
        by rcases p with ⟨i, j⟩; cases i with | none => rfl | some i => cases j; rfl }
    (fun i => by cases i <;> exact Iso.refl _)


end CategoryTheory.Operad.Tensor.Enveloping.RootTensor

end
