    C)).obj FiniteFamily.empty) (FintypeCat.of PUnit) ≫
    (FiniteTensor.tensor (V := C)).map (retainedRootPrefixNormalizer (C := C))

/-- The actual original two-unit tensor source map retains the
original right-prefix morphism and both actual original unit operations. -/
theorem retainedRootUnitTensorSource_factors (O : ColoredOperadObj W C) (c : W) :
    retainedRootUnitTensorSource (C := C) ≫ (FiniteTensor.tensor (V :=
      C)).map (retainedRootUnitFamilyMap O c) =
