        ((congrArg ((coefficientAnalyticIso P.toCollection A.carrier q).hom ≫ ·)
          (congrArg (fun a => a.app d q) balance)).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ A.operations.app d q)
              (coefficientAnalyticIso_naturality g.toCollectionHom A.carrier q).symm).trans
                (Category.assoc _ _ _))))))

/-- The raw operation descends solely from the original P-relation balance. -/
def operationApp (A : Tensor.Algebra Q) (balance : Balanced f g A) (d : W) (q : AnalyticIndex W d) :
