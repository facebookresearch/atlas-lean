/- Exact checked source: VariableCoefficientCollection. -/
section EnvelopingSource179


/-!
# The actual enveloping coefficient quotients form a symmetric collection

Every original variable-profile map descends through the actual coefficient
coequalizer. The two original faces are genuine symmetric-collection maps,
and the actual coefficient projection is a natural collection morphism.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Variable

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- The actual full constant-input action is a genuine original
variable-profile symmetric-collection morphism. -/
def constantInputActionMap (O : ColoredOperadObj W C) (B : W → C) :
    linearCoefficientCollection O.toCollection (profileCoinvariants O.toCollection B) ⟶
      linearCoefficientCollection O.toCollection B where
  app P := constantInputAction O B P
  naturality {P P'} f := constantInputAction_naturality O B (P := P) (P' := P') f

/-- The actual original O-algebra action second face is a genuine
variable-profile symmetric-collection morphism. -/
def algebraInputRelationMap (O : ColoredOperadObj W C) (A : Algebra O) :
    linearCoefficientCollection O.toCollection (profileCoinvariants O.toCollection A.carrier) ⟶
      linearCoefficientCollection O.toCollection A.carrier where
  app P := algebraInputRelation O A P
  naturality {P P'} f := algebraInputRelation_naturality O A (P := P) (P' := P') f

/-- Every original profile map descends through the actual original
coequalizer using the proved naturality of both original relation faces. -/
def envelopingCoefficientMap (O : ColoredOperadObj W C) (A : Algebra O)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    envelopingCoefficientObj O A P ⟶ envelopingCoefficientObj O A P' :=
  coequalizer.desc (linearCoefficientMap O.toCollection A.carrier f ≫
    envelopingCoefficientπ O A P') (by
    rw [← Category.assoc, ← constantInputAction_naturality, Category.assoc,
      envelopingCoefficient_condition, ← Category.assoc, algebraInputRelation_naturality,
        Category.assoc])

/-- The actual quotient-map beta rule retains the original
variable-profile coefficient map on every genuine coefficient quotient. -/
theorem envelopingCoefficientπ_map (O : ColoredOperadObj W C) (A : Algebra O)
    {P P' : ColoredProfile W} (f : P ⟶ P') :
    envelopingCoefficientπ O A P ≫ envelopingCoefficientMap O A f =
      linearCoefficientMap O.toCollection A.carrier f ≫ envelopingCoefficientπ O A P' :=
  coequalizer.π_desc _ _

/-- Original identity profile maps remain identities after the actual
coequalizer descent, proved by the genuine quotient hom_ext. -/
theorem envelopingCoefficientMap_id (O : ColoredOperadObj W C) (A : Algebra O)
    (P : ColoredProfile W) :
    envelopingCoefficientMap O A (𝟙 P) = 𝟙 (envelopingCoefficientObj O A P) := by
  apply envelopingCoefficient_hom_ext O A P
  have hi : linearCoefficientMap O.toCollection A.carrier (𝟙 P) =
      𝟙 (linearCoefficient O.toCollection A.carrier P) :=
    (linearCoefficientCollection O.toCollection A.carrier).map_id P
  exact (envelopingCoefficientπ_map O A (𝟙 P)).trans
    ((congrArg (· ≫ envelopingCoefficientπ O A P) hi).trans
      ((Category.id_comp _).trans (Category.comp_id _).symm))

/-- Original composition of every colored variable-profile map is
preserved by actual coequalizer descent and original quotient hom_ext. -/
theorem envelopingCoefficientMap_comp (O : ColoredOperadObj W C) (A : Algebra O)
    {P P' P'' : ColoredProfile W} (f : P ⟶ P') (g : P' ⟶ P'') :
    envelopingCoefficientMap O A (f ≫ g) = envelopingCoefficientMap O A f ≫
      envelopingCoefficientMap O A g := by
  apply envelopingCoefficient_hom_ext O A P
  let p := envelopingCoefficientπ O A P
  let p' := envelopingCoefficientπ O A P'
  let p'' := envelopingCoefficientπ O A P''
  let m := linearCoefficientMap O.toCollection A.carrier f
  let n := linearCoefficientMap O.toCollection A.carrier g
  let a := envelopingCoefficientMap O A f
  let b := envelopingCoefficientMap O A g
  have hc : linearCoefficientMap O.toCollection A.carrier (f ≫ g) = m ≫ n :=
    (linearCoefficientCollection O.toCollection A.carrier).map_comp f g
  have h1 := envelopingCoefficientπ_map O A (f ≫ g)
  have h2 := congrArg (· ≫ p'') hc
  have h3 := Category.assoc m n p''
  have h4 := congrArg (m ≫ ·) (envelopingCoefficientπ_map O A g).symm
  have h5 := (Category.assoc m p' b).symm
  have h6 := congrArg (· ≫ b) (envelopingCoefficientπ_map O A f).symm
  have h7 := Category.assoc p a b
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans (h6.trans h7)))))

/-- The actual coefficient quotients carry the complete original
colored symmetric-collection functor, including every empty profile,
original input permutation and original output-color equality. -/
def envelopingCoefficientCollection (O : ColoredOperadObj W C) (A : Algebra O) :
    ColoredSymmetricCollection W C where
  obj := envelopingCoefficientObj O A
  map f := envelopingCoefficientMap O A f
  map_id P := envelopingCoefficientMap_id O A P
  map_comp f g := envelopingCoefficientMap_comp O A f g

/-- The actual coefficient quotient maps assemble into a genuine
original colored symmetric-collection morphism. -/
def envelopingCoefficientProjection (O : ColoredOperadObj W C) (A : Algebra O) :
    linearCoefficientCollection O.toCollection A.carrier ⟶ envelopingCoefficientCollection O A where
  app P := envelopingCoefficientπ O A P
  naturality {P P'} f := (envelopingCoefficientπ_map O A (P := P) (P' := P') f).symm

/-- The genuine collection projection imposes precisely the two
original operadic-substitution and O-algebra action relation maps. -/
theorem envelopingCoefficientProjection_condition (O : ColoredOperadObj W C) (A : Algebra O) :
    constantInputActionMap O A.carrier ≫ envelopingCoefficientProjection O A =
      algebraInputRelationMap O A ≫ envelopingCoefficientProjection O A := by
  ext P
  exact envelopingCoefficient_condition O A P


end CategoryTheory.Operad.Tensor.Enveloping.Variable

end
