theorem generatorUnit_coefficient {O E : ColoredOperadObj W C} (u : O ⟶ E) (c : W) :
    (O.unit c ≫ (O.toCollection.mapIso (generatorProfileIso c)).inv) ≫
      u.toCollectionHom.app (extendProfile (ColoredProfile.nullary c) (generatorInputs c)) =
    E.unit c ≫ (E.toCollection.mapIso (generatorProfileIso c)).inv := by
  let i := (O.toCollection.mapIso (generatorProfileIso c)).inv
  let j := (E.toCollection.mapIso (generatorProfileIso c)).inv
  let a := u.toCollectionHom.app (extendProfile (ColoredProfile.nullary c) (generatorInputs c))
  let b := u.toCollectionHom.app (ColoredSubstitutionData.unitProfile c)
  have h : i ≫ a = b ≫ j := u.toCollectionHom.naturality (generatorProfileIso c).inv
  exact (Category.assoc (O.unit c) i a).trans
    ((congrArg (O.unit c ≫ ·) h).trans ((Category.assoc (O.unit c) b j).symm.trans
      (congrArg (· ≫ j) (u.map_unit c))))

/-- The original supplied constant coefficient map enters the actual
target left-unit source with precisely the original b singleton input map. -/
theorem generatorFactor_leftUnit {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (c : W) :
    generatorFactor O B c ≫ coefficientMap u B b (ColoredProfile.nullary c) (generatorInputs c) ≫
      generatorLeftCoefficient E c =
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (UnitInsertion.leftNestedFamilyMap
      (b c)) ≫
      ColoredOperadObj.UnitInsertion.leftFactorHom E.toCollection E.unit
        (ColoredProfile.nullary c) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let T := FiniteTensor.tensor (V := C)
        let a := O.unit c
        let i := (O.toCollection.mapIso (generatorProfileIso c)).inv
        let f := u.toCollectionHom.app (extendProfile (ColoredProfile.nullary c)
          (generatorInputs c))
