    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).map (envelopingAssocWeightedNormalizedContractionMap O B d Q) ≫
        (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option d.branches.index))
          (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile
            d.outerAfterInnerData i)
            (envelopingAssocOuterChoices d Q i)))
          (fun i => (addedAlgebraInputs B).obj (envelopingAssocOuterChoices d Q i))).hom =
