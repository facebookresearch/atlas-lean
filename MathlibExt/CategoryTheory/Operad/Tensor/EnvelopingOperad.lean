          ((congrArg O.toCollection.map (shapeHom_outer d Q R)).trans
            (Category.id_comp _).symm))
      | some j =>
        change HEq (𝟙 _ ≫ O.toCollection.map (𝟙 (R j).toColoredProfile)) (𝟙 _ ≫ 𝟙 _)
        exact heq_of_eq (congrArg (𝟙 _ ≫ ·) (O.toCollection.map_id _))


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
