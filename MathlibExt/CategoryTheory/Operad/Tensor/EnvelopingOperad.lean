/- Exact checked source: WeightedNormalization.OriginalInclusionOperad. -/
section EnvelopingSource249


/-!
# The literal original operad inclusion into the actual linear coefficient operad
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem descendEmptyOutput {D : Type*} [Category* D] {A B C E F : D}
    (r : A ⟶ B) (q : B ⟶ C) (z : C ≅ E) (t : C ⟶ F) (tB : B ⟶ F) (g : A ⟶ E)
    (hr : r ≫ q ≫ z.hom = g) (hq : q ≫ t = tB) :
    r ≫ tB = g ≫ z.inv ≫ t := by
  have hh : (r ≫ q) ≫ z.hom = g := (Category.assoc r q z.hom).trans hr
  have hg : r ≫ q = g ≫ z.inv := by
    calc
      r ≫ q = ((r ≫ q) ≫ z.hom) ≫ z.inv := by rw [Category.assoc, z.hom_inv_id, Category.comp_id]
      _ = g ≫ z.inv := congrArg (· ≫ z.inv) hh
  exact (congrArg (r ≫ ·) hq.symm).trans
    ((Category.assoc r q t).symm.trans ((congrArg (· ≫ t) hg).trans (Category.assoc _ _ _)))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

namespace Linear.Inclusion

/-- Every original operation factor is inserted at its literal empty coefficient cofan. -/
theorem sourceInsertion_cofan (O : ColoredSymmetricCollection W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    sourceInsertion O B s ≫ representativeCofanMap O B s (choices s) =
      ColoredOperadObj.HomData.factorHom (originalOperationToLinearMap O B) s := by
  refine (congrArg (sourceInsertion O B s ≫ ·) (representativeCofanMap_eq O B s (choices
    s))).trans ?_
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i <;> rfl

/-- The original all-empty representative cofan evaluates to original substitution
followed by the original operation inclusion, with no replacement source map. -/
theorem sourceInsertion_colimitEvaluation (O : ColoredOperadObj W C) (B : W →
  C) (s : ColoredSubstitutionData W) :
    (FiniteTensor.tensor (V := C)).map (sourceInsertion O.toCollection B s) ≫
      envelopingRepresentativeColimitEvaluation O B s (choices s) =
        O.subst.app s ≫ originalOperationToLinear O.toCollection B s.totalProfile := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (sourceInsertion O.toCollection B s)
  let b := envelopingRepresentativeEvaluation O B s (choices s)
  let q := (linearCoefficientDiagram O.toCollection B s.totalProfile).map (totalInputsIso s).hom
  let z := emptyLinearSummandIso O.toCollection B s.totalProfile
  let t := linearCoefficientι O.toCollection B s.totalProfile emptyColoredInputs
  let tB := linearCoefficientι O.toCollection B s.totalProfile
    (envelopingTotalAlgebraInputs s (choices s))
  have hr : (a ≫ b) ≫ q ≫ z.hom = O.subst.app s :=
    (Category.assoc a b (q ≫ z.hom)).trans (sourceInsertion_evaluation O B s)
  have hq : q ≫ t = tB := linearCoefficient_relabel O.toCollection B s.totalProfile
    (totalInputsIso s).hom
  exact (Category.assoc a b tB).symm.trans
    (descendEmptyOutput (a ≫ b) q z t tB (O.subst.app s) hr hq)

end Linear.Inclusion

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The literal original operation map preserves literal linear substitution. -/
theorem originalOperationToLinear_preserves_substitution (O : ColoredOperadObj W C) (B : W → C)
    (s : ColoredSubstitutionData W) :
    O.subst.app s ≫ originalOperationToLinear O.toCollection B s.totalProfile =
      ColoredOperadObj.HomData.sourceHom (originalOperationToLinearMap O.toCollection B) s ≫
        envelopingLinearSubstitution O B s := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (Linear.Inclusion.sourceInsertion O.toCollection B s)
  let c := T.map (Linear.representativeCofanMap O.toCollection B s (Linear.Inclusion.choices s))
  let b := envelopingLinearSubstitution O B s
  let e := envelopingRepresentativeColimitEvaluation O B s (Linear.Inclusion.choices s)
  have hf : ColoredOperadObj.HomData.sourceHom (originalOperationToLinearMap O.toCollection
    B) s = a ≫ c :=
    (congrArg T.map (Linear.Inclusion.sourceInsertion_cofan O.toCollection B s).symm).trans
      (T.map_comp _ _)
  have hb : c ≫ b = e := Linear.representativeCofanMap_β O B s (Linear.Inclusion.choices s)
  exact ((congrArg (· ≫ b) hf).trans ((Category.assoc a c b).trans
    ((congrArg (a ≫ ·) hb).trans (Linear.Inclusion.sourceInsertion_colimitEvaluation O B s)))).symm

/-- The actual original O-operation inclusion is a full map of the actual linear coefficient
operad. -/
def originalOperationToLinearOperadMap (O : ColoredOperadObj W C) (B : W →
  C) : O ⟶ envelopingLinearOperad O B where
  toCollectionHom := originalOperationToLinearMap O.toCollection B
  map_unit _ := rfl
  map_subst := originalOperationToLinear_preserves_substitution O B

theorem originalOperationToLinearOperadMap_collection (O : ColoredOperadObj W C) (B : W → C) :
    (originalOperationToLinearOperadMap O B).toCollectionHom =
      originalOperationToLinearMap O.toCollection B := rfl

theorem originalOperationToLinearOperadMap_app (O : ColoredOperadObj W C) (B : W →
  C) (P : ColoredProfile W) :
    (originalOperationToLinearOperadMap O B).toCollectionHom.app P =
      originalOperationToLinear O.toCollection B P := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource249

/- Exact checked source: WeightedNormalization.EmptyFrozenUnit. -/
section EnvelopingSource250


/-!
# Original frozen substitution with an empty added-input family
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

private theorem cancelEmptyFrozenPrefix {D : Type*} [Category* D] {A B C E : D}
    (a : A ⟶ B) (p : B ⟶ C) (z : C ⟶ B) (h : C ⟶ E) (g : B ⟶ E)
    (hh : h = z ≫ g) (hp : p ≫ z = 𝟙 B) : a ≫ p ≫ h = a ≫ g := by
  rw [hh]
  simp only [← Category.assoc]
  rw [Category.assoc a p z, hp, Category.comp_id]

private theorem emptyFrozenUnitTail {D : Type*} [Category* D] {A B C E : D}
    (i : A ⟶ B) (s : B ⟶ C) (q : C ⟶ A) (r : A ⟶ E) (h : C ⟶ E)
    (hu : i ≫ s ≫ q = 𝟙 A) (hh : h = q ≫ r) : i ≫ s ≫ h = r := by
  rw [hh]
  exact (Category.assoc i s (q ≫ r)).symm.trans
    ((Category.assoc (i ≫ s) q r).symm.trans
      ((congrArg (· ≫ r) ((Category.assoc i s q).trans hu)).trans (Category.id_comp r)))

variable {W : Type u}

/-- The total input family of a frozen tuple indexed by an empty family is empty. -/
def emptyFrozenTotalInputsIso (R : FrozenBranchTuple (emptyColoredInputs : ColoredInputs W)) :
    frozenTotalInputs emptyColoredInputs R ≅ (emptyColoredInputs : ColoredInputs W) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => p.1.elim
      invFun := fun i => i.elim
      left_inv := fun p => p.1.elim
      right_inv := fun i => i.elim }
    (fun p => p.1.elim)

/-- Remove the empty total-input extension of a frozen substitution profile. -/
def emptyFrozenTotalProfileHom (P : ColoredProfile W) (R : FrozenBranchTuple
  (emptyColoredInputs : ColoredInputs W)) :
    extendProfile P (frozenTotalInputs emptyColoredInputs R) ⟶ P :=
  extendProfileMap (𝟙 P) (emptyFrozenTotalInputsIso R).hom ≫ emptyExtensionProfileHom P

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Identify the singleton root coefficient with the frozen coefficient family having no
branches. -/
def emptyFrozenCoefficientMap (E : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    (R : FrozenBranchTuple (emptyColoredInputs : ColoredInputs W)) :
    (FiniteFamily.singleton (C := C)).obj (E.obj (extendProfile P emptyColoredInputs)) ⟶
      frozenCoefficientFamily E P emptyColoredInputs R where
  equiv :=
    { toFun := fun _ => none
      invFun := fun _ => PUnit.unit
      left_inv := fun i => by cases i; rfl
      right_inv := fun i => by cases i with | none => rfl | some i => cases i }
  hom _ := 𝟙 _

/-- The actual Q-unit insertion at the empty Q is exactly original
singleton insertion into the original frozen coefficient family. -/
theorem emptyUnaryCoefficientInsertion (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    Unit.Weighted.unaryCoefficientUnitInsertion E P emptyColoredInputs =
      (FiniteTensor.singletonIso (V := C)).inv.app (E.toCollection.obj (extendProfile P
        emptyColoredInputs)) ≫
        (FiniteTensor.tensor (V := C)).map (emptyFrozenCoefficientMap E.toCollection P
          (Unit.unaryBranches
          emptyColoredInputs)) := by
  let T := FiniteTensor.tensor (V := C)
  let X := E.toCollection.obj (extendProfile P emptyColoredInputs)
  let L := (FiniteFamily.singleton (C := C)).obj X
  let p := (frozenVariableTensorUnitIso (FintypeCat.of Empty) L).hom
  let z := (ZeroVariable.emptyUnitIso (FintypeCat.of Empty) L).hom
  let h := (Unit.rightUnitPositionIso X (FintypeCat.of Empty)).hom ≫
    Unit.unaryCoefficientBareMap E P emptyColoredInputs
  let g := emptyFrozenCoefficientMap E.toCollection P (Unit.unaryBranches emptyColoredInputs)
  have hh : h = z ≫ g := by
    apply FiniteFamily.Hom_ext
    · ext i
      cases i with | inl i => cases i | inr i => cases i; rfl
    · intro i
      cases i with
      | inl i => cases i
      | inr i =>
        cases i
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        rfl
  have hm : T.map h = T.map z ≫ T.map g := (congrArg T.map hh).trans (T.map_comp _ _)
  have hp : p ≫ T.map z = 𝟙 (T.obj L) := ZeroVariable.emptyPrefix_unit (FintypeCat.of Empty) L
  have hn := Unit.unaryCoefficientInsertion_normalized E P emptyColoredInputs
  have he : (FiniteTensor.singletonIso (V := C)).inv.app X ≫ p ≫ T.map h =
      (FiniteTensor.singletonIso (V := C)).inv.app X ≫ T.map g :=
    cancelEmptyFrozenPrefix _ p (T.map z) (T.map h) (T.map g) hm hp
  exact hn.trans he

/-- At any actual empty branch tuple, original frozen partial
substitution is the target's original right-unit law with the actual empty-profile correction. -/
theorem emptyFrozenPartial_unit (E : ColoredOperadObj W C) (P : ColoredProfile W)
    (R : FrozenBranchTuple (emptyColoredInputs : ColoredInputs W)) :
    (FiniteTensor.singletonIso (V := C)).inv.app (E.toCollection.obj (extendProfile P
      emptyColoredInputs)) ≫
      (FiniteTensor.tensor (V := C)).map (emptyFrozenCoefficientMap E.toCollection P R) ≫
      frozenPartialSubstitution E P emptyColoredInputs R ≫
        E.toCollection.map (emptyFrozenTotalProfileHom P R) =
        E.toCollection.map (emptyExtensionProfileHom P) := by
  have hR : R = Unit.unaryBranches emptyColoredInputs := funext (fun i => i.elim)
  subst R
  let i := Unit.Weighted.unaryCoefficientUnitInsertion E P emptyColoredInputs
  let s := frozenPartialSubstitution E P emptyColoredInputs (Unit.unaryBranches emptyColoredInputs)
  let q := E.toCollection.map (extendProfileMap (𝟙 P) (Unit.unaryTotalInputsIso
    emptyColoredInputs).hom)
  let r := E.toCollection.map (emptyExtensionProfileHom P)
  let h := E.toCollection.map (emptyFrozenTotalProfileHom P (Unit.unaryBranches emptyColoredInputs))
  have hm : h = q ≫ r :=
    (congrArg E.toCollection.map (by
      apply ColoredProfile.Hom.ext
      ext p
      cases p with | inl p => rfl | inr p => exact p.1.elim)).trans (E.toCollection.map_comp _ _)
  have hu : i ≫ s ≫ q = 𝟙 _ := Unit.unaryPartialSubstitution_unit E P emptyColoredInputs
  exact (Category.assoc ((FiniteTensor.singletonIso (V := C)).inv.app _)
    ((FiniteTensor.tensor (V := C)).map (emptyFrozenCoefficientMap E.toCollection P
      (Unit.unaryBranches
      emptyColoredInputs)))
    (s ≫ h)).symm.trans ((congrArg (· ≫ s ≫ h) (emptyUnaryCoefficientInsertion E P).symm).trans
      (emptyFrozenUnitTail i s q r h hu hm))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource250

/- Exact checked source: WeightedNormalization.ConstantExtensionUnit. -/
section EnvelopingSource251


/-!
# Original operation restriction and unit law of the actual constants extension
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

private theorem mapFourConstantEmpty {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) :
    F.map (a ≫ b ≫ c ≫ d) = F.map a ≫ F.map b ≫ F.map c ≫ F.map d := by
  simp only [Functor.map_comp]

private theorem constantEmptyInputCorrection {D : Type*} [Category* D] {A B C E F G H J K : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ C) (e : C ⟶ F)
    (f : F ⟶ G) (g : G ⟶ H) (s : B ⟶ F) (t : B ⟶ J) (s' : J ⟶ G)
    (u : A ⟶ K) (v : K ⟶ J)
    (hc : c ≫ d = 𝟙 C) (hb : b ≫ e = s) (hf : s ≫ f = t ≫ s') (ha : a ≫ t = u ≫ v) :
    (a ≫ b ≫ c) ≫ (d ≫ e ≫ f ≫ g) = u ≫ v ≫ s' ≫ g := by
  calc
    (a ≫ b ≫ c) ≫ (d ≫ e ≫ f ≫ g) = a ≫ b ≫ (c ≫ d) ≫ e ≫ f ≫ g := by simp only [Category.assoc]
    _ = a ≫ b ≫ e ≫ f ≫ g := by rw [hc, Category.id_comp]
    _ = a ≫ s ≫ f ≫ g := by simpa only [Category.assoc] using congrArg (a ≫ · ≫ f ≫ g) hb
    _ = a ≫ t ≫ s' ≫ g := by simpa only [Category.assoc] using congrArg (a ≫ · ≫ g) hf
    _ = u ≫ v ≫ s' ≫ g := by simpa only [Category.assoc] using congrArg (· ≫ s' ≫ g) ha

private theorem constantEmptyPartialCorrection {D : Type*} [Category* D] {A B C E F G : D}
    (a : A ⟶ B) (i : B ⟶ C) (k : C ⟶ E) (u : A ⟶ E) (v : E ⟶ F)
    (s : F ⟶ G) (g : G ⟶ C) (w : F ⟶ E)
    (hi : a ≫ i = u ≫ v ≫ s ≫ g) (hk : s ≫ g ≫ k = w) (hv : v ≫ w = 𝟙 E) :
    a ≫ i ≫ k = u := by
  calc
    a ≫ i ≫ k = (a ≫ i) ≫ k := (Category.assoc a i k).symm
    _ = (u ≫ v ≫ s ≫ g) ≫ k := congrArg (· ≫ k) hi
    _ = u ≫ v ≫ (s ≫ g ≫ k) := by simp only [Category.assoc]
    _ = u ≫ v ≫ w := congrArg (u ≫ v ≫ ·) hk
    _ = u := (congrArg (u ≫ ·) hv).trans (Category.comp_id u)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

theorem emptyCoefficientMap_factor {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    coefficientMap u B b P emptyColoredInputs =
      (emptyLinearFactorsIso O.toCollection B P).hom ≫
        (emptyLeafFamilyIso (O.toCollection.obj (extendProfile P emptyColoredInputs))).hom ≫
        (FiniteFamily.singleton (C := C)).map (u.toCollectionHom.app (extendProfile P
          emptyColoredInputs)) ≫
          emptyFrozenCoefficientMap E.toCollection P (branches emptyColoredInputs) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with | none => rfl | some i => cases i
  · intro i
    cases i with
    | none =>
      let f := u.toCollectionHom.app (extendProfile P emptyColoredInputs)
      change HEq f (𝟙 _ ≫ 𝟙 _ ≫ f ≫ 𝟙 _)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | some i => cases i

/-- The literal original empty summand and actual coefficient evaluator
retain exactly the original O→E map and both original profile inverses. -/
theorem emptyRepresentativeInput {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    (emptyLinearSummandIso O.toCollection B P).inv ≫
        (FiniteTensor.tensor (V := C)).map (coefficientMap u B b P emptyColoredInputs) =
      u.toCollectionHom.app P ≫ E.toCollection.map (emptyExtensionProfileIso P).inv ≫
        (FiniteTensor.singletonIso (V := C)).inv.app (E.toCollection.obj (extendProfile P
          emptyColoredInputs)) ≫
          (FiniteTensor.tensor (V := C)).map (emptyFrozenCoefficientMap E.toCollection P
            (branches emptyColoredInputs))
            := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P emptyColoredInputs)
  let Y := E.toCollection.obj (extendProfile P emptyColoredInputs)
  let a := O.toCollection.map (emptyExtensionProfileIso P).inv
  let b₀ := (emptyLeafTensorIso X).inv
  let c := T.map (emptyLinearFactorsIso O.toCollection B P).inv
  let d := T.map (emptyLinearFactorsIso O.toCollection B P).hom
  let e := T.map (emptyLeafFamilyIso X).hom
  let f := T.map ((FiniteFamily.singleton (C := C)).map (u.toCollectionHom.app
    (extendProfile P emptyColoredInputs)))
  let g := T.map (emptyFrozenCoefficientMap E.toCollection P (branches emptyColoredInputs))
  let s := (FiniteTensor.singletonIso (V := C)).inv.app X
  let t := u.toCollectionHom.app (extendProfile P emptyColoredInputs)
  let s' := (FiniteTensor.singletonIso (V := C)).inv.app Y
  let v := E.toCollection.map (emptyExtensionProfileIso P).inv
  have hc : c ≫ d = 𝟙 _ := (T.mapIso (emptyLinearFactorsIso O.toCollection B P)).inv_hom_id
  have hb : b₀ ≫ e = s :=
    (Category.assoc s (T.mapIso (emptyLeafFamilyIso X)).inv (T.mapIso (emptyLeafFamilyIso
      X)).hom).trans
      ((congrArg (s ≫ ·) (T.mapIso (emptyLeafFamilyIso X)).inv_hom_id).trans (Category.comp_id s))
  have hf : s ≫ f = t ≫ s' := (FiniteTensor.singletonIso (V := C)).inv.naturality t |>.symm
  have ha : a ≫ t = u.toCollectionHom.app P ≫ v := u.toCollectionHom.naturality
    (emptyExtensionProfileIso P).inv
  have hsource : (emptyLinearSummandIso O.toCollection B P).inv = a ≫ b₀ ≫ c :=
    Category.assoc a b₀ c
  have hfactor : T.map (coefficientMap u B b P emptyColoredInputs) = d ≫ e ≫ f ≫ g :=
    (congrArg T.map (emptyCoefficientMap_factor u B b P)).trans (mapFourConstantEmpty T _ _ _ _)
  exact (congrArg₂ (· ≫ ·) hsource hfactor).trans
    (constantEmptyInputCorrection a b₀ c d e f g s t s' (u.toCollectionHom.app P) v hc hb hf ha)

omit [FiniteTensor C] in
theorem emptyFrozenTotalProfileHom_constants (P : ColoredProfile W) :
    emptyFrozenTotalProfileHom P (branches emptyColoredInputs) =
      totalProfileHom P emptyColoredInputs := by
  apply ColoredProfile.Hom.ext
  ext p
  cases p with | inl p => rfl | inr p => exact p.1.elim

/-- The original empty representative evaluates to the original O→E operation. -/
theorem representative_empty {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    (emptyLinearSummandIso O.toCollection B P).inv ≫ representative u B b P
      emptyColoredInputs = u.toCollectionHom.app P
      := by
  let T := FiniteTensor.tensor (V := C)
  let a := (emptyLinearSummandIso O.toCollection B P).inv
  let i := T.map (coefficientMap u B b P emptyColoredInputs)
  let k := frozenPartialSubstitution E P emptyColoredInputs (branches emptyColoredInputs)
    ≫ E.toCollection.map
    (totalProfileHom P emptyColoredInputs)
  let v := E.toCollection.map (emptyExtensionProfileIso P).inv
  let s := (FiniteTensor.singletonIso (V := C)).inv.app (E.toCollection.obj (extendProfile P
    emptyColoredInputs))
  let g := T.map (emptyFrozenCoefficientMap E.toCollection P (branches emptyColoredInputs))
  let w := E.toCollection.map (emptyExtensionProfileHom P)
  have hi : a ≫ i = u.toCollectionHom.app P ≫ v ≫ s ≫ g := emptyRepresentativeInput u B b P
  have hk : s ≫ g ≫ k = w :=
    (congrArg (fun f => s ≫ g ≫ frozenPartialSubstitution E P emptyColoredInputs
      (branches emptyColoredInputs) ≫
      E.toCollection.map f)
      (emptyFrozenTotalProfileHom_constants P)).symm.trans
        (emptyFrozenPartial_unit E P (branches emptyColoredInputs))
  have hv : v ≫ w = 𝟙 _ := (E.toCollection.mapIso (emptyExtensionProfileIso P)).inv_hom_id
  exact constantEmptyPartialCorrection a i k (u.toCollectionHom.app P) v s g w hi hk hv

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The actual constants extension restricts to the literal supplied original operad map. -/
theorem extension_original {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (P : ColoredProfile W) :
    originalOperationToLinear O.toCollection B P ≫ extension u B b P = u.toCollectionHom.app P := by
  let a := (emptyLinearSummandIso O.toCollection B P).inv
  let i := linearCoefficientι O.toCollection B P emptyColoredInputs
  exact (Category.assoc a i (extension u B b P)).trans
    ((congrArg (a ≫ ·) (extension_β u B b P emptyColoredInputs)).trans
      (representative_empty u B b P))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The target's original unit law proves the actual constants extension unit law. -/
theorem extension_unit {O E : ColoredOperadObj W C} (u : O ⟶ E) (B : W → C)
    (b : ∀ c, B c ⟶ E.toCollection.obj (ColoredProfile.nullary c)) (c : W) :
    (envelopingLinearOperad O B).unit c ≫ extension u B b
      (ColoredSubstitutionData.unitProfile c) = E.unit c := by
  exact (Category.assoc (O.unit c) (originalOperationToLinear O.toCollection B
    (ColoredSubstitutionData.unitProfile c))
    (extension u B b (ColoredSubstitutionData.unitProfile c))).trans
      ((congrArg (O.unit c ≫ ·) (extension_original u B b
        (ColoredSubstitutionData.unitProfile c))).trans (u.map_unit
        c))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource251

/- Exact checked source: WeightedNormalization.OperadMapFrozen. -/
section EnvelopingSource252


/-!
# Original frozen and representative coefficient substitutions respect full operad maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.OperadMap

open CategoryTheory

private theorem prefixOperadSquare {D : Type*} [Category* D] {A A' B B' C C' : D}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (m : B ⟶ B')
    (q : B ⟶ C) (q' : B' ⟶ C') (f : C ⟶ C')
    (hp : l ≫ p' = p ≫ m) (hq : m ≫ q' = q ≫ f) :
    l ≫ (p' ≫ q') = (p ≫ q) ≫ f := by
  exact (Category.assoc l p' q').symm.trans ((congrArg (· ≫ q') hp).trans
    ((Category.assoc p m q').trans ((congrArg (p ≫ ·) hq).trans (Category.assoc p q f).symm)))

private theorem evaluateOperadSquare {D : Type*} [Category* D] {A A' B B' C C' E E' : D}
    (l : A ⟶ A') (a : A ⟶ B) (a' : A' ⟶ B') (f : B ⟶ B')
    (s : B ⟶ C) (s' : B' ⟶ C') (g : C ⟶ C')
    (t : C ⟶ E) (t' : C' ⟶ E') (h : E ⟶ E')
    (ha : l ≫ a' = a ≫ f) (hs : f ≫ s' = s ≫ g) (ht : g ≫ t' = t ≫ h) :
    l ≫ (a' ≫ s' ≫ t') = (a ≫ s ≫ t) ≫ h := by
  calc
    l ≫ (a' ≫ s' ≫ t') = (l ≫ a') ≫ s' ≫ t' := by simp only [Category.assoc]
    _ = (a ≫ f) ≫ s' ≫ t' := congrArg (· ≫ s' ≫ t') ha
    _ = a ≫ (f ≫ s') ≫ t' := by simp only [Category.assoc]
    _ = a ≫ (s ≫ g) ≫ t' := congrArg (fun h => a ≫ h ≫ t') hs
    _ = a ≫ s ≫ (g ≫ t') := by simp only [Category.assoc]
    _ = a ≫ s ≫ (t ≫ h) := congrArg (a ≫ s ≫ ·) ht
    _ = (a ≫ s ≫ t) ≫ h := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Apply an operad map to the root and every branch coefficient of a frozen family. -/
def frozenCoefficientMap {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenCoefficientFamily O.toCollection P Q R ⟶ frozenCoefficientFamily E.toCollection
      P Q R where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => u.toCollectionHom.app (extendProfile P Q)
    | some i => u.toCollectionHom.app (R i).toColoredProfile

theorem frozenUnitMap_square {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenVariableUnitFamilyMap P.inputs (frozenCoefficientMap u P Q R) ≫
      frozenUnitCoefficientMap E P Q R =
      frozenUnitCoefficientMap O P Q R ≫ ColoredOperadObj.HomData.factorHom
        u.toCollectionHom (frozenSubstitution P Q R)
        := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with | inl i => rfl | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      let c := P.inputColor i
      change HEq (𝟙 _ ≫ E.unit c) (O.unit c ≫ u.toCollectionHom.app
        (ColoredSubstitutionData.unitProfile c))
      exact heq_of_eq ((Category.id_comp _).trans (u.map_unit c).symm)
    | inr i =>
      cases i with
      | none => exact heq_of_eq (u.toCollectionHom.naturality (frozenOuterProfileHom P Q R)).symm
      | some i =>
        let f := u.toCollectionHom.app (R i).toColoredProfile
        change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
        exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)

/-- The literal frozen-variable tensor prefix and coefficient maps preserve actual operad maps. -/
theorem frozenTensorMap_square {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (frozenCoefficientMap u P Q R) ≫
      frozenSubstitutionCoefficientTensorMap E P Q R =
      frozenSubstitutionCoefficientTensorMap O P Q R ≫ ColoredOperadObj.HomData.sourceHom
        u.toCollectionHom
        (frozenSubstitution P Q R) := by
  let T := FiniteTensor.tensor (V := C)
  let l := T.map (frozenCoefficientMap u P Q R)
  let p := (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom
  let p' := (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily E.toCollection P
    Q R)).hom
  let m := T.map (frozenVariableUnitFamilyMap P.inputs (frozenCoefficientMap u P Q R))
  let q := T.map (frozenUnitCoefficientMap O P Q R)
  let q' := T.map (frozenUnitCoefficientMap E P Q R)
  let f := ColoredOperadObj.HomData.sourceHom u.toCollectionHom (frozenSubstitution P Q R)
  have hp : l ≫ p' = p ≫ m := frozenVariableTensorUnitIso_naturality P.inputs
    (frozenCoefficientMap u P Q R)
  have hq : m ≫ q' = q ≫ f :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (frozenUnitMap_square u P Q R)).trans
      (T.map_comp _ _))
  exact prefixOperadSquare l p p' m q q' f hp hq

/-- Every original frozen partial substitution is natural in a full supplied operad map. -/
theorem frozenPartial_map {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (frozenCoefficientMap u P Q R) ≫
      frozenPartialSubstitution E P Q R =
      frozenPartialSubstitution O P Q R ≫ u.toCollectionHom.app (extendProfile P
        (frozenTotalInputs Q R)) :=
  evaluateOperadSquare _ _ _ _ _ _ _ _ _ _ (frozenTensorMap_square u P Q R)
    (u.map_subst (frozenSubstitution P Q R)).symm (u.toCollectionHom.naturality
      (frozenTotalProfileHom P Q R)).symm

/-- Apply an operad map to every extended profile in the representative coefficient family. -/
def representativeCoefficientMap {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingRepresentativeCoefficients O.toCollection s Q ⟶
      envelopingRepresentativeCoefficients E.toCollection s
      Q where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := match i with
    | none => u.toCollectionHom.app (extendProfile s.outerProfile (Q none))
    | some i => u.toCollectionHom.app (extendProfile (s.inner.obj i) (Q (some i)))

theorem representativeUnitMap_square {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    frozenVariableUnitFamilyMap (Q none).index (representativeCoefficientMap u s Q) ≫
      envelopingRepresentativeUnitMap E
      s Q =
      envelopingRepresentativeUnitMap O s Q ≫ ColoredOperadObj.HomData.factorHom u.toCollectionHom
        (envelopingRepresentativeSubstitution s Q) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with | inl i => rfl | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      let c := ((Q none).obj i).as
      change HEq (𝟙 _ ≫ E.unit c) (O.unit c ≫ u.toCollectionHom.app
        (ColoredSubstitutionData.unitProfile c))
      exact heq_of_eq ((Category.id_comp _).trans (u.map_unit c).symm)
    | inr i =>
      cases i with
      | none =>
        exact heq_of_eq (u.toCollectionHom.naturality (envelopingRepresentativeOuterHom s
        Q)).symm
      | some i =>
        let f := u.toCollectionHom.app (extendProfile (s.inner.obj i) (Q (some i)))
        change HEq (f ≫ 𝟙 _) (𝟙 _ ≫ f)
        exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)

theorem representativeTensorMap_square {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (representativeCoefficientMap u s Q) ≫
      envelopingRepresentativeCoefficientTensorMap E s Q =
      envelopingRepresentativeCoefficientTensorMap O s Q ≫
        ColoredOperadObj.HomData.sourceHom u.toCollectionHom
        (envelopingRepresentativeSubstitution s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let l := T.map (representativeCoefficientMap u s Q)
  let p := (frozenVariableTensorUnitIso (Q none).index (envelopingRepresentativeCoefficients
    O.toCollection s Q)).hom
  let p' := (frozenVariableTensorUnitIso (Q none).index
    (envelopingRepresentativeCoefficients E.toCollection s Q)).hom
  let m := T.map (frozenVariableUnitFamilyMap (Q none).index (representativeCoefficientMap u s Q))
  let q := T.map (envelopingRepresentativeUnitMap O s Q)
  let q' := T.map (envelopingRepresentativeUnitMap E s Q)
  let f := ColoredOperadObj.HomData.sourceHom u.toCollectionHom
    (envelopingRepresentativeSubstitution s Q)
  have hp : l ≫ p' = p ≫ m := frozenVariableTensorUnitIso_naturality (Q none).index
    (representativeCoefficientMap u s Q)
  have hq : m ≫ q' = q ≫ f :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (representativeUnitMap_square u s Q)).trans
      (T.map_comp _ _))
  exact prefixOperadSquare l p p' m q q' f hp hq

/-- The actual original representative coefficient substitution preserves full operad maps. -/
theorem representativeCoefficient_map {O E : ColoredOperadObj W C} (u : O ⟶ E)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (representativeCoefficientMap u s Q) ≫
      envelopingRepresentativeCoefficientSubstitution E s Q =
      envelopingRepresentativeCoefficientSubstitution O s Q ≫
        u.toCollectionHom.app (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q)) :=
  evaluateOperadSquare _ _ _ _ _ _ _ _ _ _ (representativeTensorMap_square u s Q)
    (u.map_subst (envelopingRepresentativeSubstitution s Q)).symm
      (u.toCollectionHom.naturality (envelopingRepresentativeTotalHom s Q)).symm


end CategoryTheory.Operad.Tensor.Enveloping.Linear.OperadMap

end
end EnvelopingSource252

/- Exact checked source: WeightedNormalization.LeftFrozenUnit. -/
section EnvelopingSource253


/-!
# The original left-unit insertion as an actual frozen singleton prefix
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Insert the output-color unit into the root factor family of the left unit substitution. -/
def leftRootFactor (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    Unit.unitRootFamily (E.toCollection.obj P) (FintypeCat.of PUnit) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj
        (ColoredSubstitutionData.leftUnit P) where
  equiv := UnitGeometry.unitFlipEquiv
  hom i := match i with
    | none => 𝟙 _
    | some _ => E.unit P.outputColor ≫ E.toCollection.map
      (ColoredSubstitutionData.leftUnitOuterHom P)

/-- The actual singleton variable prefix puts the original outer unit first
and the original retained coefficient in the original inner position. -/
def leftFrozenUnitMap (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    frozenVariableUnitFamily (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
      C)).obj (E.toCollection.obj P)) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj
        (ColoredSubstitutionData.leftUnit P) where
  equiv :=
    { toFun := fun i => match i with | Sum.inl _ => none | Sum.inr _ => some PUnit.unit
      invFun := fun i => match i with | none => Sum.inl PUnit.unit | some _ => Sum.inr PUnit.unit
      left_inv := fun i => by cases i <;> rename_i i <;> cases i <;> rfl
      right_inv := fun i => by cases i with | none => rfl | some i => cases i; rfl }
  hom i := match i with
    | Sum.inl _ => E.unit P.outputColor ≫ E.toCollection.map
      (ColoredSubstitutionData.leftUnitOuterHom P)
    | Sum.inr _ => 𝟙 _

theorem leftRootFactor_compare (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (UnitGeometry.leftBlocksIso
      (E.toCollection.obj P)).hom ≫
        ColoredOperadObj.UnitInsertion.leftFactorHom E.toCollection E.unit P =
      Unit.rightRootNormalizer (E.toCollection.obj P) (FintypeCat.of PUnit) ≫
        leftRootFactor E P := by
  let T := FiniteTensor.tensor (V := C)
  let X := E.toCollection.obj P
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with | none => rfl | some i => cases i; rfl
  · intro i
    cases i with
    | none =>
      let s := (FiniteTensor.singletonIso (V := C)).hom.app X
      change HEq (T.map (𝟙 ((FiniteFamily.singleton (C := C)).obj X)) ≫ s) (s ≫ 𝟙 X)
      exact heq_of_eq ((congrArg (· ≫ s) (T.map_id _)).trans ((Category.id_comp s).trans
        (Category.comp_id s).symm))
    | some i =>
      cases i
      let f := E.unit P.outputColor ≫ E.toCollection.map
        (ColoredSubstitutionData.leftUnitOuterHom P)
      change HEq (T.map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ f) (𝟙 _ ≫ f)
      exact heq_of_eq (congrArg (· ≫ f) (T.map_id _))

theorem leftFrozenUnitMap_compare (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    (Unit.rightUnitPositionIso (E.toCollection.obj P) (FintypeCat.of PUnit)).hom ≫
      leftRootFactor E P =
      leftFrozenUnitMap E P := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rename_i i <;> cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      cases i
      let f := E.unit P.outputColor ≫ E.toCollection.map
        (ColoredSubstitutionData.leftUnitOuterHom P)
      change HEq (𝟙 _ ≫ f) f
      exact heq_of_eq (Category.id_comp f)
    | inr i =>
      cases i
      let X := E.toCollection.obj P
      change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (Category.id_comp _)

/-- Genuine finite tensor coherence identifies the literal original left-unit
insertion with its original singleton frozen prefix, at arbitrary profiles. -/
theorem leftUnitInsert_normalized (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    ColoredOperadObj.leftUnitInsert E.toCollection E.unit P =
      (FiniteTensor.singletonIso (V := C)).inv.app (E.toCollection.obj P) ≫
        (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
          C)).obj (E.toCollection.obj
          P))).hom ≫
          (FiniteTensor.tensor (V := C)).map (leftFrozenUnitMap E P) := by
  let T := FiniteTensor.tensor (V := C)
  let X := E.toCollection.obj P
  let pR := UnitInsertion.rightInsertPrefix X (FintypeCat.of PUnit)
  let pL := UnitInsertion.leftInsertPrefix X
  let m := (FiniteFamily.map T).map (UnitGeometry.leftBlocksIso X).hom
  let n := Unit.rightRootNormalizer X (FintypeCat.of PUnit)
  let fL := ColoredOperadObj.UnitInsertion.leftFactorHom E.toCollection E.unit P
  let f := leftRootFactor E P
  have hp : pR ≫ T.map m = pL := UnitGeometry.leftPrefix_fromRight X
  have hf : T.map m ≫ T.map fL = T.map (n ≫ f) :=
    (T.map_comp _ _).symm.trans (congrArg T.map (leftRootFactor_compare E P))
  have he : pL ≫ T.map fL = pR ≫ T.map (n ≫ f) :=
    (congrArg (· ≫ T.map fL) hp.symm).trans ((Category.assoc pR (T.map m) (T.map
      fL)).trans (congrArg (pR ≫ ·) hf))
  exact he.trans ((Unit.rightInsertFromNormalizedFactor X (FintypeCat.of PUnit) f).trans
    (congrArg (fun f => (FiniteTensor.singletonIso (V := C)).inv.app X ≫
      (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton (C :=
        C)).obj X)).hom ≫ T.map f)
      (leftFrozenUnitMap_compare E P)))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
end EnvelopingSource253

/- Exact checked source: WeightedNormalization.ConstantBranchProfiles. -/
section EnvelopingSource254


/-!
# Original profiles for simultaneous variable substitution and nullary constants
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

variable {W : Type u}

/-- The actual original variable branches and actual root-added nullary branches. -/
def generalSubstitution (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
  ColoredSubstitutionData W where
  outputColor := s.outputColor
  inner :=
    { index := FintypeCat.of (s.inner.index ⊕ Q.index)
      obj i := match i with
        | Sum.inl i => s.inner.obj i
        | Sum.inr i => ColoredProfile.nullary (Q.obj i).as }

/-- Identify the extended outer profile with the outer profile of the variable and
nullary-constant substitution. -/
def generalOuterHom (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    extendProfile s.outerProfile Q ⟶ (generalSubstitution s Q).outerProfile where
  inputEquiv := Equiv.refl (s.inner.index ⊕ Q.index)
  inputColor_eq i := by cases i <;> rfl
  outputColor_eq := rfl

/-- Remove the empty leaves of the added nullary branches to recover the original total profile. -/
def generalTotalHom (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    (generalSubstitution s Q).totalProfile ⟶ s.totalProfile where
  inputEquiv :=
    { toFun := fun p => match p with | ⟨Sum.inl i, j⟩ => ⟨i, j⟩ | ⟨Sum.inr _, j⟩ => Fin.elim0 j
      invFun := fun p => ⟨Sum.inl p.1, p.2⟩
      left_inv := fun p =>
        by rcases p with ⟨i, j⟩; cases i with | inl i => rfl | inr i => exact Fin.elim0 j
      right_inv := fun _ => rfl }
  inputColor_eq p :=
    by rcases p with ⟨i, j⟩; cases i with | inl i => rfl | inr i => exact Fin.elim0 j
  outputColor_eq := rfl

/-- Original variable branches perform their displayed frozen nullary substitutions.
Every original root-added constant is inserted into its original left unit. -/
def assocData (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
  ColoredAssocData W where
  outputColor := s.outputColor
  branches :=
    { index := FintypeCat.of (s.inner.index ⊕ (Q none).index)
      obj i := match i with
        | Sum.inl i => frozenSubstitution (s.inner.obj i) (Q (some i)) (Constants.branches
          (Q (some i)))
        | Sum.inr i => ColoredSubstitutionData.leftUnit (ColoredProfile.nullary ((Q
          none).obj i).as) }

/-- Map representative branches to the middle profiles of the associativity datum for branch
constants. -/
def middleCompare (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingRepresentativeSubstitution s Q ⟶ (assocData s Q).middleData where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl (s.inner.index ⊕ (Q none).index)
      hom i := match i with
        | Sum.inl i => frozenOuterProfileHom (s.inner.obj i) (Q (some i))
          (Constants.branches (Q (some i)))
        | Sum.inr i => ColoredSubstitutionData.leftUnitOuterHom (ColoredProfile.nullary ((Q
          none).obj i).as) }

/-- Collapse the inner constant substitutions to the variable and root-nullary branches. -/
def afterInnerCompare (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (assocData s Q).outerAfterInnerData ⟶ generalSubstitution s (Q none) where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl (s.inner.index ⊕ (Q none).index)
      hom i := match i with
        | Sum.inl i => Constants.substitutionTotalHom (s.inner.obj i) (Q (some i))
        | Sum.inr i => ColoredSubstitutionData.leftUnitTotalHom (ColoredProfile.nullary ((Q
          none).obj i).as) }

/-- Regroup the inner profiles into the frozen substitution on the total algebra-input family. -/
def innerCompare (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (assocData s Q).innerData ⟶
      frozenSubstitution s.totalProfile (envelopingTotalAlgebraInputs s Q)
        (Constants.branches (envelopingTotalAlgebraInputs s Q)) where
  outputColor_eq := rfl
  innerHom :=
    { equiv :=
        { toFun := fun p => match p with
            | ⟨Sum.inl i, Sum.inl j⟩ => Sum.inl ⟨i, j⟩
            | ⟨Sum.inl i, Sum.inr j⟩ => Sum.inr (Sum.inr ⟨i, j⟩)
            | ⟨Sum.inr i, _⟩ => Sum.inr (Sum.inl i)
          invFun := fun p => match p with
            | Sum.inl ⟨i, j⟩ => ⟨Sum.inl i, Sum.inl j⟩
            | Sum.inr (Sum.inl i) => ⟨Sum.inr i, PUnit.unit⟩
            | Sum.inr (Sum.inr ⟨i, j⟩) => ⟨Sum.inl i, Sum.inr j⟩
          left_inv := fun p => by
            rcases p with ⟨i, j⟩
            cases i with | inl i => cases j <;> rfl | inr i => cases j; rfl
          right_inv := fun p => by
            cases p with | inl p => rfl | inr p => cases p <;> rfl }
      hom p := match p with
        | ⟨Sum.inl _, Sum.inl _⟩ => 𝟙 _
        | ⟨Sum.inl _, Sum.inr _⟩ => 𝟙 _
        | ⟨Sum.inr _, _⟩ => 𝟙 _ }

theorem rootProfile_readback (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingRepresentativeOuterHom s Q ≫ ColoredSubstitutionData.outerProfileMap
      (middleCompare s Q) ≫
      ColoredSubstitutionData.outerProfileMap (d := (assocData s Q).outerAfterInnerData)
        (afterInnerCompare s Q) =
        generalOuterHom s (Q none) := by
  apply ColoredProfile.Hom.ext
  ext i
  cases i <;> rfl

theorem middleTotal_readback (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    ColoredSubstitutionData.totalProfileMap (middleCompare s Q) ≫
      ColoredSubstitutionData.outerProfileMap (innerCompare
      s Q) =
      envelopingRepresentativeTotalHom s Q ≫ frozenOuterProfileHom s.totalProfile
        (envelopingTotalAlgebraInputs s Q)
        (Constants.branches (envelopingTotalAlgebraInputs s Q)) := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with | inl i => cases j <;> rfl | inr i => cases j; rfl

theorem totalProfile_readback (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (assocData s Q).totalHom ≫ ColoredSubstitutionData.totalProfileMap (afterInnerCompare
      s Q) ≫ generalTotalHom s (Q
      none) =
      ColoredSubstitutionData.totalProfileMap (innerCompare s Q) ≫
        Constants.substitutionTotalHom s.totalProfile (envelopingTotalAlgebraInputs s Q) := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨⟨i, j⟩, k⟩
  cases i with
  | inl i => cases j with | inl j => cases k; rfl | inr j => exact Fin.elim0 k
  | inr i => exact Fin.elim0 k


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

