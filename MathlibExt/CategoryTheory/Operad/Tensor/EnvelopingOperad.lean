/-!
# Genuine enveloping algebras and the original linear-algebra relation quotient
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original relation on genuine linear algebras uses
the full original operadic substitution face and original A-action face. -/
abbrev EnvelopingBalancedAlgebras (O : ColoredOperadObj W C) (A : Algebra O) :=
  ColoredOperadObj.Reflexive.AlgebraDescent.BalancedAlgebras
    (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A)

/-- Genuine algebras over the constructed enveloping operad are
equivalent to genuine original linear algebras balancing exactly the
original two operadic faces. Both full inverse functors are constructed. -/
def envelopingAlgebraQuotientEquivalence (O : ColoredOperadObj W C) (A : Algebra O) :
    Algebra (envelopingOperad O A) ≌ EnvelopingBalancedAlgebras O A :=
  ColoredOperadObj.Reflexive.AlgebraDescent.algebraEquivalence
    (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A)
    (algebraRelationOperadSection O A) (algebraRelationOperadSection_substitution O A)
      (algebraRelationOperadSection_action O A)

/-- Forward passage is the actual original restriction along the
genuine original coefficient quotient projection, on entire algebras. -/
theorem envelopingAlgebraQuotientEquivalence_forward_obj (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    ((envelopingAlgebraQuotientEquivalence O A).functor.obj M).obj =
      Algebra.restrict (envelopingOperadProjection O A) M := rfl

/-- Every original carrier is retained literally by the full
forward enveloping algebra equivalence. -/
theorem envelopingAlgebraQuotientEquivalence_forward_carrier (O : ColoredOperadObj W C) (A :
  Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    ((envelopingAlgebraQuotientEquivalence O A).functor.obj M).obj.carrier = M.carrier := rfl

/-- Every full original carrier arrow is retained by forward restriction. -/
theorem envelopingAlgebraQuotientEquivalence_forward_hom (O : ColoredOperadObj W C) (A : Algebra O)
    {M N : Algebra (envelopingOperad O A)} (f : M ⟶ N) :
    ((envelopingAlgebraQuotientEquivalence O A).functor.map f).hom.hom = f.hom := rfl

/-- The inverse full coefficient descent retains the original carrier. -/
theorem envelopingAlgebraQuotientEquivalence_inverse_carrier (O : ColoredOperadObj W C) (A :
  Algebra O)
    (M : EnvelopingBalancedAlgebras O A) :
    ((envelopingAlgebraQuotientEquivalence O A).inverse.obj M).carrier = M.obj.carrier := rfl

/-- The inverse descent retains every full original algebra carrier arrow. -/
theorem envelopingAlgebraQuotientEquivalence_inverse_hom (O : ColoredOperadObj W C) (A : Algebra O)
    {M N : EnvelopingBalancedAlgebras O A} (f : M ⟶ N) :
    ((envelopingAlgebraQuotientEquivalence O A).inverse.map f).hom = f.hom.hom := rfl

/-- The full forward equivalence retains the complete original
forgetful carrier functor, including all original Hom maps. -/
theorem envelopingAlgebraQuotientEquivalence_forward_forget (O : ColoredOperadObj W C) (A :
  Algebra O) :
    (envelopingAlgebraQuotientEquivalence O A).functor ⋙
      ColoredOperadObj.Reflexive.AlgebraDescent.balancedForget
        (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A) =
      Algebra.forget (envelopingOperad O A) := rfl


