-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- Every original finite position is an actual empty tensor-input block. -/
def allEmptyTensorBlocks (I : FintypeCat.{0}) : FiniteFamily (FiniteFamily C) where
  index := I
  obj _ := FiniteFamily.empty

/-- Every original finite position is the original tensor unit. -/
def allTensorUnitFamily (I : FintypeCat.{0}) : FiniteFamily C :=
  (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (allEmptyTensorBlocks (C := C) I)

/-- The original flattening of all actual empty blocks is the
original empty family by its exact empty dependent-sum bijection. -/
def allEmptyFlattenIso (I : FintypeCat.{0}) :
    (FiniteFamily.flatten (C := C)).obj (allEmptyTensorBlocks (C := C) I) ≅
      (FiniteFamily.empty : FiniteFamily C) :=
  FiniteFamily.isoOfComponents
    { toFun p := p.2.elim
      invFun p := p.elim
      left_inv p := p.2.elim
      right_inv p := p.elim }
    (fun p => p.2.elim)

/-- The actual original unit tensor maps into any finite number
of original unit factors through genuine empty-block flattening. -/
def tensorAllUnitInsertion (I : FintypeCat.{0}) :
    (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty ⟶
      (FiniteTensor.tensor (V := C)).obj (allTensorUnitFamily (C := C) I) :=
  (FiniteTensor.tensor (V := C)).map (allEmptyFlattenIso (C := C) I).inv ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (allEmptyTensorBlocks (C := C) I)


end CategoryTheory.Operad.Tensor.Enveloping

