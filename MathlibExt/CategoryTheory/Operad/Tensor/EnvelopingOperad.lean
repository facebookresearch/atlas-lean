/-- The actual original retained source is the original
coefficient family by its exact original empty-block bijection. -/
def envelopingAssocRetainedFlattenIso (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).obj (envelopingAssocRetainedInputBlocks O d Q) ≅
      envelopingAssocCoefficients O d Q :=
  FiniteFamily.isoOfComponents (envelopingAssocRetainedFlattenEquiv O d Q) (fun p => match p with
    | ⟨none, _⟩ => Iso.refl _
    | ⟨some (Sum.inl _), _⟩ => Iso.refl _
    | ⟨some (Sum.inr _), j⟩ => j.elim)


