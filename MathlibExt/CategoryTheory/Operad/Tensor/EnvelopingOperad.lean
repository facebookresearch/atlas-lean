set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive.Routing

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original three-level factor family in grouping A. -/
def groupingAProfiles (d : ColoredAssocData W) : FiniteFamily (FiniteFamily (ColoredProfile
