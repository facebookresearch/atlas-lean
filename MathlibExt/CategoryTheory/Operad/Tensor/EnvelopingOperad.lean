open CategoryTheory

private theorem mapThreeSlots {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem factorRootRaw {D : Type*} [Category* D] {X A B C E F : D}
    (u : X ⟶ A) (e : A ⟶ B) (p : X ⟶ C) (a : C ⟶ B) (b : B ⟶ E) (c : E ⟶ F) (t : C ⟶ F)
    (hu : u ≫ e = p ≫ a) (ha : a ≫ b ≫ c = t) : u ≫ e ≫ b ≫ c = p ≫ t := by
  calc
    u ≫ e ≫ b ≫ c = (u ≫ e) ≫ b ≫ c := by simp only [Category.assoc]
    _ = (p ≫ a) ≫ b ≫ c := congrArg (· ≫ b ≫ c) hu
    _ = p ≫ t := (Category.assoc p a (b ≫ c)).trans (congrArg (p ≫ ·) ha)

private theorem identityPostTwice {D : Type*} [Category* D] {A B : D} (z : A ⟶ B) :
    𝟙 A ≫ z ≫ 𝟙 B = z ≫ 𝟙 B ≫ 𝟙 B := by simp only [Category.id_comp, Category.comp_id]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The frozen coefficient family for constants added at the outer profile. -/
def rootFamily (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
  FiniteFamily C :=
  frozenCoefficientFamily E s.outerProfile (Q none) (Constants.branches (Q none))

/-- The frozen coefficient family for constants added at a chosen variable branch. -/
def branchFamily (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) (i
  : s.inner.index) : FiniteFamily C :=
  frozenCoefficientFamily E (s.inner.obj i) (Q (some i)) (Constants.branches (Q (some i)))

/-- Group the frozen root and branch coefficient families by substitution slots. -/
def groups (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
  FiniteFamily (FiniteFamily C) :=
  RootTensor.sourceGroups s.inner.index (rootFamily E s Q) (branchFamily E s Q)

/-- Identify each weighted coefficient and nullary-leaf block with its frozen coefficient
family. -/
def weightedIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    Branch.weightedBlocks E s Q ≅ groups E s Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i => match i with
    | none => nullaryInputCoefficientIso E s.outerProfile (Q none)
    | some i => nullaryInputCoefficientIso E (s.inner.obj i) (Q (some i)))

/-- Permute the split root and retained branch blocks into the first raw coefficient grouping. -/
def splitIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    RootTensor.splitGroups s.inner.index (rootFamily E s Q) (branchFamily E s Q) ≅
      Branch.rawGroupsA E s Q :=
  FiniteFamily.isoOfComponents
    { toFun := fun i => match i with
        | Sum.inl none => none
        | Sum.inl (some i) => some (Sum.inr i)
        | Sum.inr i => some (Sum.inl i)
      invFun := fun i => match i with
        | none => Sum.inl none
        | some (Sum.inl i) => Sum.inr i
        | some (Sum.inr i) => Sum.inl (some i)
      left_inv := fun i => by cases i with | inl i => cases i <;> rfl | inr i => rfl
      right_inv := fun i => by cases i with | none => rfl | some i => cases i <;> rfl }
    (fun i => by cases i with | inl i => cases i <;> exact Iso.refl _ | inr i => exact Iso.refl _)

/-- Identify the root and branch output family with the original substitution factors. -/
def targetIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) :
    RootTensor.targetFamily s.inner.index (E.obj s.outerProfile) (fun i => E.obj (s.inner.obj i)) ≅
      (ColoredOperadObj.substitutionFactors E).obj s :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i =>
    by cases i <;> exact Iso.refl _)

/-- Identify the frozen root and singleton branch outputs with the second root-constant
grouping. -/
def outputGroupsIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q
  : EnvelopingInputChoices s)
  :
    RootTensor.rootOutputGroups s.inner.index (rootFamily E s Q) (fun i => E.obj (s.inner.obj i)) ≅
      Root.rawGroupsB E s (Q none) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i =>
    by cases i <;> exact Iso.refl _)

theorem sourceRaw_triangle (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
