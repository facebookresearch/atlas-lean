namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original coefficient summand evaluates in M through the
actual original constant map g and M's original O operation. -/
def evaluationCocone (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (P : ColoredProfile W) :
    Cocone (linearCoefficientDiagram O.toCollection B P ⋙
      coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)) where
  pt := M.carrier P.outputColor
  ι :=
    { app Q := representativeEvaluation O B M g P Q
      naturality _Q _Q' f :=
        (representativeEvaluation_naturality O B M g P f).trans (Category.comp_id _).symm }

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual operation-domain cocone is the original linear
coefficient colimit, tensored with every unchanged variable input. -/
def operationDomainCocone (O : ColoredSymmetricCollection W C) (B M : W → C)
    (P : ColoredProfile W) :
    Cocone (linearCoefficientDiagram O B P ⋙ coefficientLeafTensorFunctor
      (profileLeafFamily M P)) := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact (coefficientLeafTensorFunctor (profileLeafFamily M P)).mapCocone
    (colimit.cocone (linearCoefficientDiagram O B P))

/-- Source coefficient-slot colimit preservation constructs the
full original coefficient/input operation-domain colimit. -/
def operationDomainIsColimit (O : ColoredSymmetricCollection W C) (B M : W → C)
    (P : ColoredProfile W) : IsColimit (operationDomainCocone O B M P) := by
  letI : EssentiallySmall.{us} (ColoredInputs W) := coloredInputsEssentiallySmall P.outputColor
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  let U := coefficientLeafTensorFunctor (profileLeafFamily M P)
  letI : PreservesColimitsOfSize.{us, us} U := inferInstance
  letI : PreservesColimitsOfShape (ColoredInputs W) U :=
    MonoidalCategory.OrderedTensor.preservesColimitsOfEssentiallySmall U (ColoredInputs W)
  exact isColimitOfPreserves U (colimit.isColimit (linearCoefficientDiagram O B P))

/-- The original coefficient tensor and variable input family
are exactly the original analytic operation factors. -/
def operationProfileIso (O : ColoredSymmetricCollection W C) (B M : W → C)
    {d : W} (P : AnalyticIndex W d) :
    (operationDomainCocone O B M P.toColoredProfile).pt ≅
      (analyticSummand (d := d) (linearCoefficientCollection O B) M).obj P :=
  profileCoefficientLeafTensorIso (linearCoefficientCollection O B) M P.toColoredProfile

/-- The actual coefficient-colimit operation in M is the unique
descent of every original representative evaluation, with no algebra
operation or equivalence outcome supplied by the caller. -/
def operationApp (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (d : W) (P : AnalyticIndex W d) :
    (analyticSummand (d := d) (linearCoefficientCollection O.toCollection B) M.carrier).obj
      P ⟶ M.carrier d :=
  (operationProfileIso O.toCollection B M.carrier P).inv ≫
    (operationDomainIsColimit O.toCollection B M.carrier P.toColoredProfile).desc
      (evaluationCocone O B M g P.toColoredProfile)

/-- The actual original cofan leg into the linear operation
domain retains its original coefficient-colimit injection and
the exact original analytic-factor comparison. -/
def operationInjection (O : ColoredSymmetricCollection W C) (B M : W → C)
    {d : W} (P : AnalyticIndex W d) (Q : ColoredInputs W) :
    (coefficientLeafTensorFunctor (profileLeafFamily M P.toColoredProfile)).obj
        ((linearCoefficientDiagram O B P.toColoredProfile).obj Q) ⟶
      (analyticSummand (d := d) (linearCoefficientCollection O B) M).obj P :=
  (operationDomainCocone O B M P.toColoredProfile).ι.app Q ≫ (operationProfileIso O B M P).hom

/-- Each actual original coefficient cofan leg evaluates by the
original O-algebra operation and original constant map, with the
original tensor and leaf position maps retained literally. -/
theorem operationApp_beta (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (d : W) (P : AnalyticIndex W d) (Q : ColoredInputs W) :
    operationInjection O.toCollection B M.carrier P Q ≫ operationApp O B M g d P =
      representativeEvaluation O B M g P.toColoredProfile Q := by
  let e := operationProfileIso O.toCollection B M.carrier P
  let i := (operationDomainCocone O.toCollection B M.carrier P.toColoredProfile).ι.app Q
  let l := operationDomainIsColimit O.toCollection B M.carrier P.toColoredProfile
  let c := evaluationCocone O B M g P.toColoredProfile
  have h : (i ≫ e.hom) ≫ (e.inv ≫ l.desc c) = i ≫ l.desc c := by
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  exact h.trans (l.fac c Q)

/-- The complete original coefficient cofan determines every
operation-domain morphism, including every nullary profile. -/
theorem operation_hom_ext (O : ColoredSymmetricCollection W C) (B M : W → C)
    {d : W} (P : AnalyticIndex W d) {Y : C}
    {f g : (analyticSummand (d := d) (linearCoefficientCollection O B) M).obj P ⟶ Y}
    (h : ∀ Q : ColoredInputs W, operationInjection O B M P Q ≫ f =
      operationInjection O B M P Q ≫ g) :
    f = g := by
  apply (cancel_epi (operationProfileIso O B M P).hom).1
  apply (operationDomainIsColimit O B M P.toColoredProfile).hom_ext
  intro Q
  exact (Category.assoc _ _ _).symm.trans ((h Q).trans (Category.assoc _ _ _))


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
