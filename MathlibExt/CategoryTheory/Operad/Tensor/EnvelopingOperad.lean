/- Exact checked source: AlgebraNullaryEvaluation. -/
section EnvelopingSource280


/-!
# Original nullary evaluations on genuine algebra maps and free extensions
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem nullaryMapSuffix {D : Type*} [Category* D] {X A B Y : D}
    (f : X ⟶ A) (a : A ⟶ B) (b : B ⟶ Y) (c : X ⟶ B) (h : f ≫ a = c) :
    f ≫ (a ≫ b) = c ≫ b := by rw [← Category.assoc f a, h]

private theorem nullaryInverseSquare {D : Type*} [Category* D] {X Y E : D}
    (e : X ≅ E) (e' : Y ≅ E) (f : X ⟶ Y) (h : f ≫ e'.hom = e.hom) : e.inv ≫ f = e'.inv := by
  apply (cancel_mono e'.hom).1
  rw [Category.assoc, h, e.inv_hom_id, e'.inv_hom_id]

private theorem nullaryHomFiring {D : Type*} [Category* D] {X A A' B B' : D}
    (i : X ⟶ A) (op : A ⟶ B) (f : B ⟶ B') (g : A ⟶ A') (op' : A' ⟶ B') (i' : X ⟶ A')
    (h : op ≫ f = g ≫ op') (hi : i ≫ g = i') : (i ≫ op) ≫ f = i' ≫ op' := by
  rw [Category.assoc i op, h, ← Category.assoc i g, hi]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- Every original carrier arrow leaves the nullary coefficient
unchanged under its original singleton factor comparison. -/
theorem nullaryFactorsIso_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (analyticFactorsCarrierMap (d := d) O f).app AnalyticIndex.nullary ≫
      (nullaryFactorsIso O B d).hom =
      (nullaryFactorsIso O A d).hom := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | none => rfl
    | some i => exact Fin.elim0 i
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some i => exact Fin.elim0 i

/-- Original carrier maps preserve exactly the actual nullary
singleton tensor unitor and original operation coefficient. -/
theorem nullarySummandIso_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (analyticSummandCarrierMap (d := d) O f).app AnalyticIndex.nullary ≫
      (nullarySummandIso O B d).hom =
      (nullarySummandIso O A d).hom := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map ((analyticFactorsCarrierMap (d := d) O f).app AnalyticIndex.nullary)
  let b := T.map (nullaryFactorsIso O B d).hom
  let c := T.map (nullaryFactorsIso O A d).hom
  let u := (FiniteTensor.singletonIso (V := C)).hom.app (O.obj (ColoredProfile.nullary d))
  have h : a ≫ b = c := (T.map_comp _ _).symm.trans (congrArg T.map
    (nullaryFactorsIso_carrier O f d))
  exact nullaryMapSuffix a b u c h

/-- The inverse original nullary coefficient comparison also
retains every original carrier arrow and the same coefficient map. -/
theorem nullarySummandIso_inverse_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (nullarySummandIso O A d).inv ≫ (analyticSummandCarrierMap (d :=
      d) O f).app AnalyticIndex.nullary =
      (nullarySummandIso O B d).inv :=
  nullaryInverseSquare (nullarySummandIso O A d) (nullarySummandIso O B d)
    ((analyticSummandCarrierMap (d := d) O f).app AnalyticIndex.nullary)
      (nullarySummandIso_carrier O f d)

/-- Every genuine original algebra Hom retains exactly the
original nullary coefficient evaluation at every color. -/
theorem algebraNullaryEvaluation_naturality (E : ColoredOperadObj W C) {M N : Algebra E}
    (f : M ⟶ N) (d : W) :
    FrozenAlgebra.nullaryEvaluation M d ≫ f.hom d = FrozenAlgebra.nullaryEvaluation N d :=
  nullaryHomFiring (nullarySummandIso E.toCollection M.carrier d).inv
    (M.operations.app d AnalyticIndex.nullary) (f.hom d)
    ((analyticSummandCarrierMap (d := d) E.toCollection f.hom).app AnalyticIndex.nullary)
    (N.operations.app d AnalyticIndex.nullary) (nullarySummandIso E.toCollection N.carrier d).inv
    (f.comm d AnalyticIndex.nullary) (nullarySummandIso_inverse_carrier E.toCollection f.hom d)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original nullary coefficient cofan is natural under every
original colorwise carrier arrow into the actual profile colimit. -/
theorem nullaryι_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) : nullaryι O A d ≫ profileMap O f d = nullaryι O B d := by
  let i := (nullarySummandIso O A d).inv
  let j := profileι O A (AnalyticIndex.nullary (d := d))
  let k := profileMap O f d
  let a := (analyticSummandCarrierMap (d := d) O f).app AnalyticIndex.nullary
  let j' := profileι O B (AnalyticIndex.nullary (d := d))
  exact (Category.assoc i j k).trans
    ((congrArg (i ≫ ·) (profileι_map O f (AnalyticIndex.nullary (d := d)))).trans
      ((Category.assoc i a j').symm.trans
        (congrArg (· ≫ j') (nullarySummandIso_inverse_carrier O f d))))

/-- The original nullary coefficient evaluation is exactly its
actual profile injection followed by the genuine original algebra action. -/
theorem algebraNullaryEvaluation_action (E : ColoredOperadObj W C) (M : Algebra E) (d : W) :
    FrozenAlgebra.nullaryEvaluation M d = nullaryι E.toCollection M.carrier d ≫ M.action d :=
  (nullaryι_desc M.operations d).symm

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual original free extension maps every original nullary
coefficient to its genuine target algebra's original nullary evaluation. -/
theorem freeAlgebraLift_nullary (E : ColoredOperadObj W C) (A : W → C) (M : Algebra E)
    (f : A ⟶ M.carrier) (d : W) :
    nullaryι E.toCollection A d ≫ (freeAlgebraLift E M f).hom d =
      FrozenAlgebra.nullaryEvaluation M d :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ M.action d) (nullaryι_carrier E.toCollection f d)).trans
      (algebraNullaryEvaluation_action E M d).symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource280

/- Exact checked source: LinearCarrierCollection. -/
section EnvelopingSource281


/-!
# Full original linear coefficient collection maps in the colorwise carrier
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem carrierCofanSquare {D : Type*} [Category* D]
    {X A A' B B' Y : D} (i : X ⟶ A) (f : A ⟶ B) (g : B ⟶ Y)
    (a : X ⟶ A') (i' : A' ⟶ B) (b : A' ⟶ B') (j : B' ⟶ Y)
    (c : X ⟶ B') (h : X ⟶ Y)
    (hf : i ≫ f = a ≫ i') (hg : i' ≫ g = b ≫ j)
    (hs : a ≫ b = c) (hh : h = c ≫ j) : i ≫ f ≫ g = h := by
  rw [← Category.assoc i f, hf, Category.assoc a i', hg, ← Category.assoc a b, hs, hh]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original colorwise input map commutes with every original
variable profile map before any input coefficient colimit. -/
theorem linearCoefficientCarrier_profile (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) {P P' : ColoredProfile W} (h : P ⟶ P')
    (Q : ColoredInputs W) :
    (linearCoefficientCarrierMap O f P).app Q ≫ (linearCoefficientProfileMap O D h).app Q =
      (linearCoefficientProfileMap O B h).app Q ≫ (linearCoefficientCarrierMap O f P').app Q := by
  let T := FiniteTensor.tensor (V := C)
  let c := O.map (extendProfileMap h (𝟙 Q))
  let ell := (addedAlgebraInputMap f).app Q
  have hs : coefficientLeafMap (𝟙 (O.obj (extendProfile P Q))) ell ≫
        coefficientLeafMap c (𝟙 ((addedAlgebraInputs D).obj Q)) =
      coefficientLeafMap c (𝟙 ((addedAlgebraInputs B).obj Q)) ≫
        coefficientLeafMap (𝟙 (O.obj (extendProfile P' Q))) ell := by
    simp only [coefficientLeafMap_comp, Category.id_comp, Category.comp_id]
  exact (T.map_comp _ _).symm.trans ((congrArg T.map hs).trans (T.map_comp _ _))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Every actual original profile permutation commutes with the
actual colorwise map on the constructed linear coefficient objects. -/
theorem linearCoefficientCarrierLift_naturality (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) {P P' : ColoredProfile W} (h : P ⟶ P') :
    (linearCoefficientCollection O B).map h ≫ linearCoefficientCarrierLift O f P' =
      linearCoefficientCarrierLift O f P ≫ (linearCoefficientCollection O D).map h := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  let i := linearCoefficientι O B P Q
  let a := (linearCoefficientProfileMap O B h).app Q
  let i' := linearCoefficientι O B P' Q
  let b := (linearCoefficientCarrierMap O f P').app Q
  let j := linearCoefficientι O D P' Q
  let c := (linearCoefficientCarrierMap O f P).app Q ≫ (linearCoefficientProfileMap O D h).app Q
  let z := linearCoefficientCarrierLift O f P ≫ (linearCoefficientCollection O D).map h
  have hleft : i ≫ (linearCoefficientCollection O B).map h ≫
    linearCoefficientCarrierLift O f P' = c ≫ j :=
    carrierCofanSquare i ((linearCoefficientCollection O B).map h)
      (linearCoefficientCarrierLift O f P')
      a i' b j c (c ≫ j) (linearCoefficientι_profileMap O B h Q)
      (linearCoefficientι_carrier O f P' Q) (linearCoefficientCarrier_profile O f h Q).symm rfl
  let a' := (linearCoefficientCarrierMap O f P).app Q
  let i'' := linearCoefficientι O D P Q
  let b' := (linearCoefficientProfileMap O D h).app Q
  have hright : i ≫ z = c ≫ j :=
    carrierCofanSquare i (linearCoefficientCarrierLift O f P) ((linearCoefficientCollection
      O D).map h)
      a' i'' b' j c (c ≫ j) (linearCoefficientι_carrier O f P Q)
      (linearCoefficientι_profileMap O D h Q) rfl rfl
  exact hleft.trans hright.symm

/-- The original colorwise carrier arrow defines a full symmetric
collection map, including all original heterogeneous and nullary profiles. -/
def linearCarrierCollectionMap (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) : linearCoefficientCollection O B ⟶
      linearCoefficientCollection O D where
  app P := linearCoefficientCarrierLift O f P
  naturality {_P _P'} h := linearCoefficientCarrierLift_naturality O f h

/-- Identity colorwise maps give the original identity collection map. -/
theorem linearCarrierCollectionMap_id (O : ColoredSymmetricCollection W C) (B : W → C) :
    linearCarrierCollectionMap O (𝟙 B) = 𝟙 (linearCoefficientCollection O B) := by
  ext P
  exact (linearCoefficientCarrierFunctor O P).map_id B

/-- Composition is the original composition of every full collection arrow. -/
theorem linearCarrierCollectionMap_comp (O : ColoredSymmetricCollection W C)
    {B D E : W → C} (f : B ⟶ D) (g : D ⟶ E) :
    linearCarrierCollectionMap O (f ≫ g) = linearCarrierCollectionMap O f ≫
      linearCarrierCollectionMap O g := by
  ext P
  exact (linearCoefficientCarrierFunctor O P).map_comp f g

/-- The constructed full collection is functorial in the original
color-indexed carrier, with all original coefficient colimit maps. -/
def linearCarrierCollectionFunctor (O : ColoredSymmetricCollection W C) :
    (W → C) ⥤ (ColoredProfile W ⥤ C) where
  obj := linearCoefficientCollection O
  map := linearCarrierCollectionMap O
  map_id := linearCarrierCollectionMap_id O
  map_comp := linearCarrierCollectionMap_comp O


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource281

/- Exact checked source: LinearCarrierUnit. -/
section EnvelopingSource282


/-!
# Original operation inclusions and operadic units under colorwise carrier maps
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem carrierEmptySuffix {D : Type*} [Category* D]
    {X X' A B Y : D} (f : X ⟶ X') (a : X' ⟶ A) (b : A ⟶ B) (c : B ⟶ Y)
    (a' : X ⟶ A) (h : f ≫ a = a') : f ≫ (a ≫ b ≫ c) = a' ≫ b ≫ c := by
  rw [← Category.assoc f a, h]

private theorem carrierEmptyInverse {D : Type*} [Category* D]
    {X X' Y : D} (e : X ≅ Y) (e' : X' ≅ Y) (f : X ⟶ X')
    (h : f ≫ e'.hom = e.hom) : e.inv ≫ f = e'.inv := by
  apply (cancel_mono e'.hom).1
  rw [Category.assoc, h, e.inv_hom_id, e'.inv_hom_id]

private theorem carrierOriginalCofan {D : Type*} [Category* D]
    {X A B Y Y' : D} (p : X ⟶ A) (i : A ⟶ Y) (f : Y ⟶ Y') (b : A ⟶ B)
    (i' : B ⟶ Y') (p' : X ⟶ B) (hi : i ≫ f = b ≫ i') (hp : p ≫ b = p') :
    (p ≫ i) ≫ f = p' ≫ i' := by
  rw [Category.assoc p i, hi, ← Category.assoc p b, hp]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- The actual original no-added-input factor map retains exactly
the original coefficient and original empty leaf comparison. -/
theorem linearCarrier_emptyFactors (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) (P : ColoredProfile W) :
    coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
        ((addedAlgebraInputMap f).app emptyColoredInputs) ≫
      (emptyLinearFactorsIso O D P).hom = (emptyLinearFactorsIso O B P).hom := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | none => rfl
    | some i => exact i.elim
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some i => exact i.elim

/-- The original coefficient/input carrier map on the empty summand
commutes with its actual original operation-object comparison. -/
theorem linearCarrier_emptySummand (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) (P : ColoredProfile W) :
    (linearCoefficientCarrierMap O f P).app emptyColoredInputs ≫ (emptyLinearSummandIso O D P).hom =
      (emptyLinearSummandIso O B P).hom := by
  let T := FiniteTensor.tensor (V := C)
  let c := (linearCoefficientCarrierMap O f P).app emptyColoredInputs
  let a := T.map (emptyLinearFactorsIso O D P).hom
  let a' := T.map (emptyLinearFactorsIso O B P).hom
  let b := (emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs))).hom
  let d := O.map (emptyExtensionProfileHom P)
  have h : c ≫ a = a' := (T.map_comp _ _).symm.trans
    (congrArg T.map (linearCarrier_emptyFactors O f P))
  exact carrierEmptySuffix c a b d a' h

variable [Limits.HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Every original O-operation inclusion commutes with the actual
full colorwise carrier map on all original linear coefficients. -/
theorem originalOperationToLinear_carrier (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) (P : ColoredProfile W) :
    originalOperationToLinear O B P ≫ linearCoefficientCarrierLift O f P =
      originalOperationToLinear O D P := by
  let e := emptyLinearSummandIso O B P
  let e' := emptyLinearSummandIso O D P
  let p := e.inv
  let p' := e'.inv
  let i := linearCoefficientι O B P emptyColoredInputs
  let i' := linearCoefficientι O D P emptyColoredInputs
  let c := (linearCoefficientCarrierMap O f P).app emptyColoredInputs
  let h := linearCoefficientCarrierLift O f P
  have hi : i ≫ h = c ≫ i' := linearCoefficientι_carrier O f P emptyColoredInputs
  have hp : p ≫ c = p' := carrierEmptyInverse e e' c (linearCarrier_emptySummand O f P)
  exact carrierOriginalCofan p i h c i' p' hi hp

/-- The actual original colorwise carrier map preserves the literal
original linear-operad unit at every original color. -/
theorem linearCarrier_unit (O : ColoredOperadObj W C) {B D : W → C}
    (f : B ⟶ D) (d : W) :
    envelopingLinearUnit O B d ≫ (linearCarrierCollectionMap O.toCollection f).app
      (ColoredSubstitutionData.unitProfile d) = envelopingLinearUnit O D d := by
  exact (Category.assoc _ _ _).trans
    (congrArg (O.unit d ≫ ·) (originalOperationToLinear_carrier O.toCollection f
      (ColoredSubstitutionData.unitProfile d)))


end CategoryTheory.Operad.Tensor.Enveloping

end
