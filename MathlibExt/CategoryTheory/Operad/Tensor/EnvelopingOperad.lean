    fixedProfileExtension (ColoredProfile.nullary d) ≅ inputsToProfile d ⋙
      analyticToProfileFunctor W d :=
  NatIso.ofComponents (fun Q => nullaryVariableProfileComponentIso d Q) (by
    intro Q Q' g
    exact nullaryVariableProfileHom_naturality d g)

variable {C : Type w} [Category.{v} C]

