section EnvelopingSource120


/-!
# Actual original weighted root/middle/inner coefficient tensor source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root coefficient/input tensor, and every
original middle/inner coefficient/input tensor, in their original nested blocks. -/
def envelopingAssocWeightedBlocks (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option d.branches.index)
  obj i := match i with
    | none => (FiniteFamily.singleton (C := C)).obj
        ((linearCoefficientDiagram O B d.middleData.outerProfile).obj Q.root)
    | some i => envelopingWeightedRepresentativeFamily O B (d.localData i) (Q.branch i)

/-- The actual common root/middle/inner weighted tensor
retains each original coefficient/input factor at its original position. -/
def envelopingAssocWeightedFamily (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (envelopingAssocWeightedBlocks O B d Q)

/-- The root algebra input family and each original branch's
middle/inner algebra input families retain their original slots. -/
