      ((FiniteTensor.flattenIso (V := C)).hom.app (AssocInsertion.groupingB B d))
      (T.map (AssocInsertion.groupingBToFactorsHom B γB d))
      (γB.app d.innerData) (B.map d.totalHom)).symm).trans
