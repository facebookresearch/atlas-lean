nullary profile comparison, and every original branch coefficient
is retained by its original identity map. -/
def coefficientHom (O : ColoredSymmetricCollection W C) (d : W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenCoefficientFamily O (ColoredProfile.nullary d) Q R ⟶
      (ColoredOperadObj.substitutionFactors O).obj
        (tupleSubstitutionShape ((inputsToProfile d).obj Q) R) where
  equiv := Equiv.refl (Option Q.index)
  hom p := match p with
    | none => O.map (nullaryVariableProfileHom d Q)
    | some j => 𝟙 (O.obj (R j).toColoredProfile)

variable [FiniteTensor C]

/-- Removing the original empty unit block commutes with every
original coefficient map into the actual substitution source. -/
theorem coefficientHom_inserted (O : ColoredOperadObj W C) (d : W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenUnitCoefficientMap O (ColoredProfile.nullary d) Q R ≫
