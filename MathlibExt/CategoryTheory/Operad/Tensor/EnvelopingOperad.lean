/- Exact checked source: WeightedNormalization.ConstantBranchNormalizationB. -/
section EnvelopingSource268


/-!
# Exact original root-first branch source normalizes through its original coefficient tensor
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem mapFourNormalizeB {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) :
    F.map (a ≫ b ≫ c ≫ d) = F.map a ≫ F.map b ≫ F.map c ≫ F.map d := by simp only [Functor.map_comp]

private theorem sourceFoldNormalizeB {D : Type*} [Category* D] {X A B C E F G H : D}
    (p : X ⟶ A) (a : A ⟶ B) (f : B ⟶ H) (n : B ⟶ C) (b : C ⟶ E) (c : E ⟶ H)
    (r : A ⟶ F) (a' : F ⟶ C) (p' : X ⟶ G) (e : G ⟶ F)
    (hf : f = n ≫ b ≫ c) (hn : a ≫ n = r ≫ a') (hp : p ≫ r = p' ≫ e) :
    p ≫ a ≫ f = p' ≫ (e ≫ a' ≫ b) ≫ c := by
  rw [hf]
  simp only [Category.assoc]
  rw [← Category.assoc a n (b ≫ c), hn]
  simp only [Category.assoc]
  rw [← Category.assoc p r (a' ≫ b ≫ c), hp]
  simp only [Category.assoc]

private theorem emptyFactorNormalizeB {D : Type*} [Category* D] {X A B C E F G H J : D}
    (p : X ⟶ A) (e : A ⟶ B) (a : B ⟶ C) (b : C ⟶ E) (j : E ⟶ F) (h : F ⟶ G)
    (flat : A ⟶ H) (unitPrefix : H ⟶ E) (input : H ⟶ J) (unitPrefix' : J ⟶ F)
    (he : e ≫ a ≫ b = flat ≫ unitPrefix) (hp : unitPrefix ≫ j = input ≫ unitPrefix') :
    p ≫ (e ≫ a ≫ b) ≫ (j ≫ h) = p ≫ flat ≫ input ≫ unitPrefix' ≫ h := by
  calc
    p ≫ (e ≫ a ≫ b) ≫ (j ≫ h) = p ≫ (flat ≫ unitPrefix) ≫ (j ≫ h) :=
      congrArg (fun e => p ≫ e ≫ (j ≫ h)) he
    _ = p ≫ flat ≫ (unitPrefix ≫ j) ≫ h := by simp only [Category.assoc]
    _ = p ≫ flat ≫ (input ≫ unitPrefix') ≫ h := congrArg (fun e => p ≫ flat ≫ e ≫ h) hp
    _ = p ≫ flat ≫ input ≫ unitPrefix' ≫ h := by simp only [Category.assoc]

private theorem coefficientSourceNormalizeB {D : Type*} [Category* D] {X A B C E F G H : D}
    (p : X ⟶ A) (flat : A ⟶ B) (c : B ⟶ C) (u : C ⟶ E) (i : E ⟶ F) (a : F ⟶ G) (g : G ⟶ H) :
    p ≫ flat ≫ (c ≫ u ≫ i) ≫ a ≫ g = p ≫ (flat ≫ c) ≫ u ≫ i ≫ (a ≫
      g) := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original coefficient and constant normalization followed by
the actual original representative coefficient operation and final frozen source. -/
def normalizedCoefficientSource (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      (ColoredOperadObj.substitutionSource E.toCollection).obj
        (frozenSubstitution s.totalProfile (envelopingTotalAlgebraInputs s Q) (Constants.branches
          (envelopingTotalAlgebraInputs s Q))) :=
  (FiniteTensor.tensor (V := C)).map (rawInputIso E.toCollection s Q).hom ≫
    coefficientLeavesNormalization (envelopingRepresentativeCoefficients E.toCollection s Q)
      (totalLeaves E.toCollection
      s Q) ≫
    (coefficientLeafTensorFunctor (totalLeaves E.toCollection s Q)).map
      (envelopingRepresentativeCoefficientSubstitution
      E s Q) ≫
    (FiniteTensor.tensor (V := C)).map (nullaryInputCoefficientIso E.toCollection s.totalProfile
      (envelopingTotalAlgebraInputs s Q)).hom ≫
      frozenSubstitutionCoefficientTensorMap E s.totalProfile (envelopingTotalAlgebraInputs
        s Q) (Constants.branches
        (envelopingTotalAlgebraInputs s Q))

/-- Genuine empty-block coherence and original unitPrefix naturality identify
the complete actual root-first source with its original coefficient normalization. -/
theorem collapsedSourceB_normalized (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (rawSourceIsoB E.toCollection s Q).hom ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q) ≫
        (FiniteTensor.tensor (V := C)).map (collapsedFactorsB E s Q) =
          normalizedCoefficientSource E s Q := by
  let T := FiniteTensor.tensor (V := C)
  let I := s.totalProfile.inputs
  let N := retainedGroups E.toCollection s Q
  let U := DisjointNullary.EmptyOuter.blocks I N
  let R := envelopingRepresentativeCoefficients E.toCollection s Q
  let L := totalLeaves E.toCollection s Q
  let D := frozenCoefficientFamily E.toCollection s.totalProfile (envelopingTotalAlgebraInputs s Q)
    (Constants.branches (envelopingTotalAlgebraInputs s Q))
  let p := T.map (rawSourceIsoB E.toCollection s Q).hom
  let a := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q)
  let f := T.map (collapsedFactorsB E s Q)
  let n := T.map ((FiniteFamily.map T).map (groupsToEmptyOuterIso E.toCollection s Q).hom)
  let b := T.map (DisjointNullary.EmptyOuter.pointIso I N).hom
  let j := T.map (frozenVariableUnitFamilyMap I (inputCoefficientMap E s Q))
  let unit := T.map (frozenUnitCoefficientMap E s.totalProfile (envelopingTotalAlgebraInputs s Q)
    (Constants.branches (envelopingTotalAlgebraInputs s Q)))
  let r := T.map ((FiniteFamily.flatten (C := C)).map (groupsToEmptyOuterIso E.toCollection
    s Q).hom)
  let a' := (FiniteTensor.flattenIso (V := C)).hom.app U
  let p' := T.map (rawInputIso E.toCollection s Q).hom
  let e := T.map (DisjointNullary.EmptyOuter.eraseIso I N).inv
  let flat := (FiniteTensor.flattenIso (V := C)).hom.app N
  let unitPrefix := (frozenVariableTensorUnitIso I ((FiniteFamily.map T).obj N)).hom
  let input := T.map (inputCoefficientMap E s Q)
  let unitPrefix' := (frozenVariableTensorUnitIso I D).hom
  let collapse := T.map (coefficientLeavesCollapse R L)
  let eval := (coefficientLeafTensorFunctor L).map
    (envelopingRepresentativeCoefficientSubstitution E s Q)
  let iso := T.map (nullaryInputCoefficientIso E.toCollection s.totalProfile
    (envelopingTotalAlgebraInputs s Q)).hom
  have hf : f = n ≫ b ≫ (j ≫ unit) :=
    (congrArg T.map (collapsedFactorsB_factor E s Q).symm).trans (mapFourNormalizeB T _ _ _ _)
  have hn : a ≫ n = r ≫ a' := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (groupsToEmptyOuterIso E.toCollection s
    Q).hom |>.symm
  have hp : p ≫ r = p' ≫ e := (T.map_comp _ _).symm.trans
    ((congrArg T.map (rawSourceToEmptyOuter E.toCollection s Q)).trans (T.map_comp _ _))
  have he : e ≫ a' ≫ b = flat ≫ unitPrefix := DisjointNullary.EmptyOuter.normalization I N
  have hprefix : unitPrefix ≫ j = input ≫ unitPrefix' :=
    (frozenVariableTensorUnitIso_naturality I (inputCoefficientMap
    E s Q)).symm
  have hinput : input = collapse ≫ eval ≫ iso := inputCoefficientMap_tensor E s Q
  exact (sourceFoldNormalizeB p a f n b (j ≫ unit) r a' p' e hf hn hp).trans
    ((emptyFactorNormalizeB p' e a' b j unit flat unitPrefix input unitPrefix' he hprefix).trans
      ((congrArg (p' ≫ flat ≫ · ≫ unitPrefix' ≫ unit) hinput).trans
        (coefficientSourceNormalizeB p' flat collapse eval iso unitPrefix' unit)))

/-- The actual original coefficient substitution followed by the original
target nullary contraction, on the exact raw coefficient source. -/
def outsideRoute (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      E.toCollection.obj s.totalProfile :=
  normalizedCoefficientSource E s Q ≫ E.subst.app
    (frozenSubstitution s.totalProfile (envelopingTotalAlgebraInputs s Q) (Constants.branches
      (envelopingTotalAlgebraInputs s Q))) ≫
      E.toCollection.map (Constants.substitutionTotalHom s.totalProfile
        (envelopingTotalAlgebraInputs s Q))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

end
