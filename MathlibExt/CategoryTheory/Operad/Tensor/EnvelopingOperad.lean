        (coefficientBlockInterchangeTensorIso
          (FintypeCat.of (Option d.middleData.totalProfile.inputs))
          (fun i => O.toCollection.obj
            (extendProfile (envelopingSlotProfile d.innerData i)
              (envelopingAssocInnerChoices d Q i)))
          (fun i => (addedAlgebraInputs B).obj (envelopingAssocInnerChoices d Q i))).hom =
      (coefficientBlockInterchangeTensorIso
        (FintypeCat.of (Option d.middleData.totalProfile.inputs))
        (envelopingAssocRootFirstCoefficientBlockTensors O.toCollection d Q)
        (fun i => (envelopingAssocRootFirstLeafBlocks B d Q).obj i)).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map
            (coefficientBlockMap (FintypeCat.of (Option d.middleData.totalProfile.inputs))
              (envelopingAssocRootFirstCoefficientContraction O d Q)))
          (envelopingAssocRootFirstLeafComparisonIso B d Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option d.middleData.totalProfile.inputs)
