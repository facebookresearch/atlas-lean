-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem weightedNormalizationFiring {D : Type*} [Category* D]
    {X A B E F Y : D} (p : X ⟶ A) (a : A ⟶ B) (n : B ⟶ E) (l : E ⟶ Y)
    (b : B ⟶ F) (n' : F ⟶ Y) (r : A ⟶ F)
    (hn : n ≫ l = b ≫ n') (hr : a ≫ b = r) :
    (p ≫ a ≫ n) ≫ l = p ≫ r ≫ n' := by
  simp only [Category.assoc]
  rw [hn, ← Category.assoc a b, hr]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original slot coefficients and all original root/inner
constant leaves retain their exact original coefficient/leaf positions. -/
def weightedCoefficientLeafRawIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    substitutionCoefficientInputs O B s Q ≅
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (envelopingRepresentativeCoefficients O s Q)
          ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q))) :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨none, none⟩ => ⟨none, none⟩
        | ⟨some i, none⟩ => ⟨none, some i⟩
        | ⟨none, some j⟩ => ⟨some (Sum.inl j), PUnit.unit⟩
        | ⟨some i, some j⟩ => ⟨some (Sum.inr ⟨i, j⟩), PUnit.unit⟩
      invFun p := match p with
        | ⟨none, none⟩ => ⟨none, none⟩
        | ⟨none, some i⟩ => ⟨some i, none⟩
        | ⟨some (Sum.inl j), _⟩ => ⟨none, some j⟩
        | ⟨some (Sum.inr ⟨i, j⟩), _⟩ => ⟨some i, some j⟩
      left_inv p := by rcases p with ⟨i, j⟩; cases i <;> cases j <;> rfl
      right_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i => cases j; cases i <;> rfl }
    (fun p => match p with
      | ⟨none, none⟩ => Iso.refl (O.obj (extendProfile s.outerProfile (Q none)))
      | ⟨some i, none⟩ => Iso.refl (O.obj (extendProfile (s.inner.obj i) (Q (some i))))
      | ⟨none, some j⟩ => Iso.refl (B ((Q none).obj j).as)
      | ⟨some i, some j⟩ => Iso.refl (B ((Q (some i)).obj j).as))

/-- The original interchange and original coefficient/leaf comparisons
are precisely the displayed weighted raw source bijection. -/
theorem weightedCoefficientLeafRaw_factor (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (coefficientBlockInterchangeFamilyIso (FintypeCat.of (Option s.inner.index))
      (fun i => O.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
      (fun i => (addedAlgebraInputs B).obj (Q i))).hom ≫
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (envelopingCoefficientBlockIso O s Q).hom
        (envelopingAlgebraLeafIso B s Q).hom) =
    (weightedCoefficientLeafRawIso O B s Q).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i <;> cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
        let X := O.obj (extendProfile s.outerProfile (Q none))
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (Category.id_comp _)
      | some j =>
        let X := B ((Q none).obj j).as
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (Category.id_comp _)
    | some i => cases j with
      | none =>
        let X := O.obj (extendProfile (s.inner.obj i) (Q (some i)))
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (Category.id_comp _)
      | some j =>
        let X := B ((Q (some i)).obj j).as
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (Category.id_comp _)

variable [FiniteTensor C]

/-- The original weighted coefficient tensor and every original
constant leaf are normalized before any coefficient substitution. -/
def weightedCoefficientLeafNormalization (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily O B s Q) ⟶
      (coefficientLeafTensorFunctor ((addedAlgebraInputs B).obj
        (envelopingTotalAlgebraInputs s Q))).obj
        ((FiniteTensor.tensor (V := C)).obj (envelopingRepresentativeCoefficients O s Q)) :=
  (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
    (fun i => O.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (fun i => (addedAlgebraInputs B).obj (Q i))).hom ≫
    (FiniteTensor.tensor (V := C)).map
      (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso
        O s Q).hom)
        (envelopingAlgebraLeafIso B s Q).hom)

/-- The literal original weighted normalization retains original
finite block flattening, its full raw source map and every original leaf. -/
theorem weightedCoefficientLeafNormalization_raw (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    weightedCoefficientLeafNormalization O B s Q =
      (FiniteTensor.flattenIso (V := C)).inv.app (substitutionInputBlocks O B s Q) ≫
        (FiniteTensor.tensor (V := C)).map (weightedCoefficientLeafRawIso O B s Q).hom ≫
        coefficientLeavesNormalization (envelopingRepresentativeCoefficients O s Q)
          ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option s.inner.index)
  let K := fun i : I => O.obj (extendProfile (envelopingSlotProfile s i) (Q i))
  let A := fun i : I => (addedAlgebraInputs B).obj (Q i)
  let k := (envelopingCoefficientBlockIso O s Q).hom
  let ell := (envelopingAlgebraLeafIso B s Q).hom
  let p := (FiniteTensor.flattenIso (V := C)).inv.app (substitutionInputBlocks O B s Q)
  let a₀ := (coefficientBlockInterchangeFamilyIso I K A).hom
  let a := T.map a₀
  let n := coefficientLeavesNormalization (coefficientBlockFamily I K) (totalBlockInputs I A)
  let l := T.map (coefficientLeafMap (T.map k) ell)
  let b₀ := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap k ell)
  let b := T.map b₀
  let n' := coefficientLeavesNormalization (envelopingRepresentativeCoefficients O s Q)
    ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q))
  let r := T.map (weightedCoefficientLeafRawIso O B s Q).hom
  have hn : n ≫ l = b ≫ n' := (coefficientLeavesNormalization_naturality k ell).symm
  have hr : a ≫ b = r := (T.map_comp _ _).symm.trans
    (congrArg T.map (weightedCoefficientLeafRaw_factor O B s Q))
  have hread : weightedCoefficientLeafNormalization O B s Q = (p ≫ a ≫ n) ≫ l :=
    congrArg (fun m => (p ≫ a ≫ m) ≫ l)
      (coefficientLeavesNormalizationIso_hom (coefficientBlockFamily I K) (totalBlockInputs I A))
  exact hread.trans (weightedNormalizationFiring p a n l b n' r hn hr)

/-- Original representative substitution acts on exactly the original
weighted coefficient normalization and leaves every original constant intact. -/
theorem envelopingRepresentativeEvaluation_normalization (O : ColoredOperadObj W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingRepresentativeEvaluation O B s Q =
      weightedCoefficientLeafNormalization O.toCollection B s Q ≫
        (coefficientLeafTensorFunctor ((addedAlgebraInputs B).obj
          (envelopingTotalAlgebraInputs s Q))).map
          (envelopingRepresentativeCoefficientSubstitution O s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let ell := (envelopingAlgebraLeafIso B s Q).hom
  let k := T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom
  let c := envelopingRepresentativeCoefficientSubstitution O s Q
  let i := (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
    (fun j => O.toCollection.obj (extendProfile (envelopingSlotProfile s j) (Q j)))
    (fun j => (addedAlgebraInputs B).obj (Q j))).hom
  have h : T.map (coefficientLeafMap (k ≫ c) ell) =
      T.map (coefficientLeafMap k ell) ≫
        (coefficientLeafTensorFunctor ((addedAlgebraInputs B).obj
          (envelopingTotalAlgebraInputs s Q))).map c :=
    (congrArg T.map (coefficientLeafMap_post k c ell).symm).trans (T.map_comp _ _)
  exact (congrArg (i ≫ ·) h).trans (Category.assoc _ _ _).symm


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

