/- Exact checked source: LinearAlgebra.LeafGrouping. -/
section EnvelopingSource229


/-!
# The original two successive leaf groups and their full tensor factor maps
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem joinCollapseUnit {D : Type*} [Category* D] {X Y : D}
    (f : X ⟶ Y) (g : X ⟶ X) (hg : g = 𝟙 X) :
    𝟙 X ≫ f ≫ 𝟙 Y = g ≫ f := by
  simp only [hg, Category.id_comp, Category.comp_id]

private theorem joinCollapseTwice {D : Type*} [Category* D] {X Y : D}
    (f : X ⟶ Y) (g : X ⟶ X) (hg : g = 𝟙 X) :
    f ≫ 𝟙 Y ≫ 𝟙 Y = g ≫ f := by
  simp only [hg, Category.id_comp, Category.comp_id]

variable {C : Type w} [Category.{v} C]

/-- Join two original heterogeneous leaf families in their displayed
order, without changing either original dependent index or object. -/
def leafJoin (B L : FiniteFamily C) : FiniteFamily C where
  index := FintypeCat.of (B.index ⊕ L.index)
  obj p := match p with
    | Sum.inl b => B.obj b
    | Sum.inr l => L.obj l

/-- The original two-level raw coefficient/leaf tensor is its single
coefficient block and the actual original disjoint leaf family. -/
def leafJoinRawIso (K B L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested
        ((FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K B)) L) ≅
    (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K (leafJoin B L)) :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨none, ⟨none, k⟩⟩ => ⟨none, k⟩
        | ⟨none, ⟨some b, _⟩⟩ => ⟨some (Sum.inl b), PUnit.unit⟩
        | ⟨some l, _⟩ => ⟨some (Sum.inr l), PUnit.unit⟩
      invFun p := match p with
        | ⟨none, k⟩ => ⟨none, ⟨none, k⟩⟩
        | ⟨some (Sum.inl b), _⟩ => ⟨none, ⟨some b, PUnit.unit⟩⟩
        | ⟨some (Sum.inr l), _⟩ => ⟨some l, PUnit.unit⟩
      left_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => rcases j with ⟨i, j⟩; cases i with
          | none => rfl
          | some _ => cases j; rfl
        | some _ => cases j; rfl
      right_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => rfl
        | some i => cases j; cases i <;> rfl }
    (fun p => match p with
      | ⟨none, ⟨none, k⟩⟩ => Iso.refl (K.obj k)
      | ⟨none, ⟨some b, _⟩⟩ => Iso.refl (B.obj b)
      | ⟨some l, _⟩ => Iso.refl (L.obj l))

/-- The original grouped coefficient and all original singleton leaf
blocks are the joined coefficient/leaf blocks by their exact bijection. -/
def leafJoinBlocksIso (K B L : FiniteFamily C) :
    (FiniteFamily.flatten (C := FiniteFamily C)).obj
      (coefficientLeavesTriple (coefficientLeavesNested K B) L) ≅
    coefficientLeavesNested K (leafJoin B L) :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨none, none⟩ => none
        | ⟨none, some b⟩ => some (Sum.inl b)
        | ⟨some l, _⟩ => some (Sum.inr l)
      invFun p := match p with
        | none => ⟨none, none⟩
        | some (Sum.inl b) => ⟨none, some b⟩
        | some (Sum.inr l) => ⟨some l, PUnit.unit⟩
      left_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some _ => cases j; rfl
      right_inv p := by cases p with
        | none => rfl
        | some p => cases p <;> rfl }
    (fun p => match p with
      | ⟨none, none⟩ => Iso.refl K
      | ⟨none, some b⟩ => Iso.refl ((FiniteFamily.singleton (C := C)).obj (B.obj b))
      | ⟨some l, _⟩ => Iso.refl ((FiniteFamily.singleton (C := C)).obj (L.obj l)))

/-- Both complete original raw source regroupings retain the same
coefficient and original leaves, including every empty input family. -/
theorem leafJoinRawSquare (K B L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesTripleFlattenIso (coefficientLeavesNested K B) L).hom ≫
      (leafJoinRawIso K B L).hom =
    FiniteFamily.flattenAssocIso.hom.app
      (coefficientLeavesTriple (coefficientLeavesNested K B) L) ≫
      (FiniteFamily.flatten (C := C)).map (leafJoinBlocksIso K B L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rcases j with ⟨i, j⟩; cases i <;> rfl
    | some _ => rcases j with ⟨i, j⟩; cases i; cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      rcases j with ⟨i, j⟩
      cases i with
      | none =>
        let X := K.obj j
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        rfl
      | some i =>
        cases j
        let X := B.obj i
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        rfl
    | some i =>
      rcases j with ⟨j, k⟩
      cases j
      cases k
      let X := L.obj i
      change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
      rfl

/-- A scalar coefficient with two successive original leaf groups
has the exact original joined coefficient/leaf finite family. -/
def leafJoinScalarRawIso (X : C) (B L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested ((coefficientLeafFamilyFunctor B).obj X) L) ≅
    (coefficientLeafFamilyFunctor (leafJoin B L)).obj X :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨none, none⟩ => none
        | ⟨none, some b⟩ => some (Sum.inl b)
        | ⟨some l, _⟩ => some (Sum.inr l)
      invFun p := match p with
        | none => ⟨none, none⟩
        | some (Sum.inl b) => ⟨none, some b⟩
        | some (Sum.inr l) => ⟨some l, PUnit.unit⟩
      left_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some _ => cases j; rfl
      right_inv p := by cases p with
        | none => rfl
        | some p => cases p <;> rfl }
    (fun p => match p with
      | ⟨none, none⟩ => Iso.refl X
      | ⟨none, some b⟩ => Iso.refl (B.obj b)
      | ⟨some l, _⟩ => Iso.refl (L.obj l))

variable [FiniteTensor C]

/-- The actual two-stage original leaf tensor is the original joined
leaf tensor by genuine flattening and original singleton unitors. -/
def leafJoinTensorIso (X : C) (B L : FiniteFamily C) :
    (coefficientLeafTensorFunctor L).obj ((coefficientLeafTensorFunctor B).obj X) ≅
    (coefficientLeafTensorFunctor (leafJoin B L)).obj X :=
  (coefficientLeavesNormalizationIso ((coefficientLeafFamilyFunctor B).obj X) L).symm ≪≫
    (FiniteTensor.tensor (V := C)).mapIso (leafJoinScalarRawIso X B L)

/-- The original block coefficient collapse and scalar leaf comparison
retain precisely the original joined leaf singleton unitors. -/
theorem leafJoinCollapseSquare (K B L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesTripleTensorMap (coefficientLeavesNested K B) L) ≫
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (coefficientLeavesCollapse K B) (𝟙 L)) ≫
    (leafJoinScalarRawIso ((FiniteTensor.tensor (V := C)).obj K) B L).hom =
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (leafJoinBlocksIso K B L).hom ≫
      coefficientLeavesCollapse K (leafJoin B L) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some _ => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
        let X := (FiniteTensor.tensor (V := C)).obj K
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X)
          ((FiniteTensor.tensor (V := C)).map (𝟙 K) ≫ 𝟙 X)
        exact heq_of_eq (by simp only [Functor.map_id, Category.id_comp])
      | some j =>
        let X := B.obj j
        let S := (FiniteFamily.singleton (C := C)).obj X
        let f := (FiniteTensor.singletonIso (V := C)).hom.app X
        change HEq (𝟙 ((FiniteTensor.tensor (V := C)).obj S) ≫ f ≫ 𝟙 X)
          ((FiniteTensor.tensor (V := C)).map (𝟙 S) ≫ f)
        exact heq_of_eq (joinCollapseUnit f ((FiniteTensor.tensor (V := C)).map (𝟙 S))
          ((FiniteTensor.tensor (V := C)).map_id S))
    | some i =>
      cases j
      let X := L.obj i
      let S := (FiniteFamily.singleton (C := C)).obj X
      let f := (FiniteTensor.singletonIso (V := C)).hom.app X
      change HEq (f ≫ 𝟙 X ≫ 𝟙 X)
        ((FiniteTensor.tensor (V := C)).map (𝟙 S) ≫ f)
      exact heq_of_eq (joinCollapseTwice f ((FiniteTensor.tensor (V := C)).map (𝟙 S))
        ((FiniteTensor.tensor (V := C)).map_id S))


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
end EnvelopingSource229

