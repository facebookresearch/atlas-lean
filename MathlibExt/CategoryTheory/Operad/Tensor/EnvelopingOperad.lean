        (canonicalEnvelopingAlgebraMap O f.right)).trans
        (canonicalEnvelopingAlgebraMap_hom O f.right))

/-- The entire original colorwise carrier map is retained literally
by the genuine enveloping map of every original under-A arrow. -/
theorem underAEnvelopingMap_hom (O : ColoredOperadObj W C) (A : Algebra O) {B D : Under A}
  (f : B ⟶ D) :
    (underAEnvelopingMap O A f).hom = f.right.hom := rfl

/-- The original O-algebras under A map functorially to genuine
algebras over the constructed actual enveloping operad, with
identity/composition proved on complete original carrier arrows. -/
def underAEnvelopingFunctor (O : ColoredOperadObj W C) (A : Algebra O) :
    Under A ⥤ Algebra (envelopingOperad O A) where
  obj := underAEnvelopingObject O A
  map := underAEnvelopingMap O A
  map_id B := by
    apply Algebra.Hom.ext
    exact underAEnvelopingMap_hom O A (𝟙 B)
  map_comp f g := by
    apply Algebra.Hom.ext
    exact (underAEnvelopingMap_hom O A (f ≫ g)).trans
      (congrArg₂ (fun f g => f ≫ g) (underAEnvelopingMap_hom O A f).symm
        (underAEnvelopingMap_hom O A g).symm)


end CategoryTheory.Operad.Tensor.Enveloping

