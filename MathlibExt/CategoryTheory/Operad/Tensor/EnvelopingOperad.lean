/-- Identify the root-only index `Option (Fin 0)` with the singleton index. -/
def nilOptionEquiv : Option (Fin 0) ≃ PUnit.{1} where
  toFun _ := PUnit.unit
  invFun _ := none
  left_inv i := by cases i with | none => rfl | some i => exact Fin.elim0 i
  right_inv i := by cases i; rfl

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original nullary coefficient/leaf frame keeps its original root
and deletes precisely its original Fin-0 leaf positions. -/
def nilLeafFactorsIso (A : W → C) (d : W) (X : C) :
    (coefficientLeafFamilyFunctor (profileLeafFamily A (ColoredProfile.nullary d))).obj X ≅
      (FiniteFamily.singleton (C := C)).obj X where
  hom :=
    { equiv := nilOptionEquiv
