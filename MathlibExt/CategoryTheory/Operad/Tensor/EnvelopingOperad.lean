namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance underAEnvelopingFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- An original O-algebra map from A produces a genuine Env(O,A)
algebra by actual restriction from the canonical Env algebra of its target. -/
def underAEnvelopingObject (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    Algebra (envelopingOperad O A) :=
  Algebra.restrict (envelopingOperadMap O B.hom) (canonicalEnvelopingAlgebra O B.right)

/-- Every original under-A target retains its literal original colorwise carrier. -/
theorem underAEnvelopingObject_carrier (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    (underAEnvelopingObject O A B).carrier = B.right.carrier := rfl

/-- Every genuine original under-A arrow supplies precisely its actual
full enveloping-operad triangle. -/
theorem underAEnvelopingTriangle (O : ColoredOperadObj W C) (A : Algebra O) {B D : Under A}
  (f : B ⟶ D) :
    envelopingOperadMap O B.hom ≫ envelopingOperadMap O f.right = envelopingOperadMap O D.hom :=
  ((envelopingOperadFunctor O).map_comp B.hom f.right).symm.trans
    (congrArg (envelopingOperadMap O) (Under.w f))

/-- Every genuine original under-A algebra arrow produces a genuine
full enveloping algebra arrow through its actual full operad triangle,
with the literal original complete carrier arrow. -/
def underAEnvelopingMap (O : ColoredOperadObj W C) (A : Algebra O) {B D : Under A} (f : B ⟶ D) :
    underAEnvelopingObject O A B ⟶ underAEnvelopingObject O A D :=
  let h := restrictionMapTriangle (envelopingOperadMap O B.hom) (envelopingOperadMap O f.right)
    (envelopingOperadMap O D.hom) (underAEnvelopingTriangle O A f)
      (canonicalEnvelopingAlgebraMap O f.right)
