/- Exact checked source: FrozenVariableTensorUnits. -/
section EnvelopingSource006


/-!
# Actual tensor-unit insertion at the frozen variable positions

The unit comparisons are constructed from the original finite
flattening and singleton isomorphisms. They are not extra source
tensor-preservation or unit-cofibrancy assumptions.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- Empty original blocks at frozen variable positions and the
original singleton blocks at retained coefficient/input positions. -/
def frozenVariableBlocks (I : FintypeCat.{0}) (L : FiniteFamily C) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (I ⊕ L.index)
  obj i := match i with
    | Sum.inl _ => FiniteFamily.empty
    | Sum.inr j => (FiniteFamily.singleton (C := C)).obj (L.obj j)

/-- The displayed original flattening has precisely the original
retained positions; no variable order or retained strand is discarded. -/
def frozenVariableFlattenEquiv (I : FintypeCat.{0}) (L : FiniteFamily C) :
    ((FiniteFamily.flatten (C := C)).obj (frozenVariableBlocks I L)).index ≃ L.index where
  toFun p := match p with
    | ⟨Sum.inl _, e⟩ => e.elim
    | ⟨Sum.inr j, _⟩ => j
  invFun j := ⟨Sum.inr j, PUnit.unit⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => cases j; rfl
  right_inv _ := rfl

/-- The original flattened empty/singleton blocks retain the
actual original objects at every surviving position. -/
def frozenVariableFlattenIso (I : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (frozenVariableBlocks I L) ≅ L :=
  FiniteFamily.isoOfReindex (frozenVariableFlattenEquiv I L) (by
    intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => rfl)

variable [FiniteTensor C]

/-- The actual tensor unit is placed at the original frozen
variable positions; every original retained object stays unchanged. -/
def frozenVariableUnitFamily (I : FintypeCat.{0}) (L : FiniteFamily C) : FiniteFamily C where
  index := FintypeCat.of (I ⊕ L.index)
  obj i := match i with
    | Sum.inl _ => (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty
    | Sum.inr j => L.obj j

/-- The tensor of each original singleton block is its original
retained object; the empty blocks are the original tensor units. -/
def frozenVariableBlockIso (I : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (frozenVariableBlocks I L) ≅
      frozenVariableUnitFamily I L :=
  FiniteFamily.isoOfComponents (Equiv.refl (I ⊕ L.index)) (fun i => match i with
    | Sum.inl _ => Iso.refl _
    | Sum.inr j => (FiniteTensor.singletonIso (V := C)).app (L.obj j))

/-- Insert precisely the original tensor-unit factors at every
frozen variable position, retaining the original coefficient/input
tensor. This is built from actual flattening and singleton coherence. -/
def frozenVariableTensorUnitIso (I : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).obj L ≅
      (FiniteTensor.tensor (V := C)).obj (frozenVariableUnitFamily I L) :=
  (FiniteTensor.tensor (V := C)).mapIso (frozenVariableFlattenIso I L).symm ≪≫
    (FiniteTensor.flattenIso (V := C)).app (frozenVariableBlocks I L) ≪≫
      (FiniteTensor.tensor (V := C)).mapIso (frozenVariableBlockIso I L)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource006

/- Exact checked source: FrozenSubstitutionProfiles. -/
section EnvelopingSource007


/-!
# Original color-matched substitution at the added algebra inputs

The variable positions use their original unary units. Each added
algebra input is replaced by an original profile with precisely the
required output color. The total original variable/input bijection
is displayed rather than assumed to be an identity.
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- Original inner profiles at each added algebra input, with
the original output color matched definitionally. -/
abbrev FrozenBranchTuple (Q : ColoredInputs W) := ∀ j : Q.index, AnalyticIndex W (Q.obj j).as

/-- Retain the variable positions as unary profiles and use the
actual supplied inner profiles at the algebra positions. -/
def frozenInnerProfiles (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    FiniteFamily (ColoredProfile W) where
  index := FintypeCat.of (P.inputs ⊕ Q.index)
  obj i := match i with
    | Sum.inl i => ColoredProfile.unary (P.inputColor i) (P.inputColor i)
    | Sum.inr j => (R j).toColoredProfile

/-- The actual original simultaneous substitution datum, with
unary units at variables and original operations at algebra inputs. -/
def frozenSubstitution (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    ColoredSubstitutionData W where
  outputColor := P.outputColor
  inner := frozenInnerProfiles P Q R

/-- The outer coefficient profile is exactly the original
variable profile plus original added algebra input family. -/
theorem frozenSubstitution_outerProfile (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : FrozenBranchTuple Q) : (frozenSubstitution P Q R).outerProfile = extendProfile P Q := by
  have h : (fun i : P.inputs ⊕ Q.index => ((frozenInnerProfiles P Q R).obj i).outputColor) =
      Sum.elim P.inputColor (fun i => (Q.obj i).as) := by
    funext i
    cases i <;> rfl
  exact congrArg (fun c : P.inputs ⊕ Q.index → W =>
    (⟨FintypeCat.of (P.inputs ⊕ Q.index), c, P.outputColor⟩ : ColoredProfile W)) h

/-- The original outer coefficient profile is compared with the
original substitution profile by the identity on every displayed
input position and the actual pointwise color equalities. -/
def frozenOuterProfileHom (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    extendProfile P Q ⟶ (frozenSubstitution P Q R).outerProfile where
  inputEquiv := Equiv.refl (P.inputs ⊕ Q.index)
  inputColor_eq i := by cases i <;> rfl
  outputColor_eq := rfl

/-- The original total family of algebra leaves of the supplied
inner profiles, retaining every original dependent-sum input. -/
def frozenTotalInputs (Q : ColoredInputs W) (R : FrozenBranchTuple Q) : ColoredInputs W where
  index := FintypeCat.of (Σ j : Q.index, (R j).inputs)
  obj p := Discrete.mk ((R p.1).inputColor p.2)

/-- Flatten the original unary-variable and algebra branches
to the displayed original variable block and dependent algebra inputs. -/
def frozenTotalInputEquiv (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenSubstitution P Q R).totalProfile.inputs ≃ P.inputs ⊕ (frozenTotalInputs Q R).index where
  toFun p := match p with
    | ⟨Sum.inl i, _⟩ => Sum.inl i
    | ⟨Sum.inr j, k⟩ => Sum.inr ⟨j, k⟩
  invFun p := match p with
    | Sum.inl i => ⟨Sum.inl i, PUnit.unit⟩
    | Sum.inr p => ⟨Sum.inr p.1, p.2⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j; rfl
    | inr i => rfl
  right_inv p := by cases p <;> rfl

/-- The actual original total profile map retains every input
color and root output while separating the variable and algebra blocks. -/
def frozenTotalProfileHom (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenSubstitution P Q R).totalProfile ⟶ extendProfile P (frozenTotalInputs Q R) where
  inputEquiv := frozenTotalInputEquiv P Q R
  inputColor_eq p := by
    rcases p with ⟨i, j⟩
    cases i <;> rfl
  outputColor_eq := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource007

/- Exact checked source: FrozenSubstitutionCoefficients. -/
section EnvelopingSource008


/-!
# Actual partial substitution on the original operation coefficients

Substitution occurs only at the displayed added algebra inputs.
Every variable position receives its original unary operadic unit,
through the constructed finite tensor-unit insertion comparison.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original root coefficient and original supplied inner
operation coefficients at added algebra input positions. -/
def frozenCoefficientFamily (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) : FiniteFamily C where
  index := FintypeCat.of (Option Q.index)
  obj i := match i with
    | none => O.obj (extendProfile P Q)
    | some j => O.obj ((R j).toColoredProfile)

/-- Place every original frozen variable before the retained
root/branch coefficients, with the exact original option/sum bijection. -/
def frozenCoefficientPositionEquiv (P : ColoredProfile W) (Q : ColoredInputs W) :
    P.inputs ⊕ Option Q.index ≃ Option (P.inputs ⊕ Q.index) where
  toFun p := match p with
    | Sum.inl i => some (Sum.inl i)
    | Sum.inr none => none
    | Sum.inr (some j) => some (Sum.inr j)
  invFun p := match p with
    | none => Sum.inr none
    | some (Sum.inl i) => Sum.inl i
    | some (Sum.inr j) => Sum.inr (some j)
  left_inv p := by
    cases p with
    | inl i => rfl
    | inr p => cases p <;> rfl
  right_inv p := by
    cases p with
    | none => rfl
    | some p => cases p <;> rfl

variable [FiniteTensor C]

/-- The actual original unit and retained coefficient maps into
the original simultaneous-substitution factors. -/
def frozenUnitCoefficientMap (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenVariableUnitFamily P.inputs (frozenCoefficientFamily O.toCollection P Q R) ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj (frozenSubstitution P Q R) where
  equiv := frozenCoefficientPositionEquiv P Q
  hom i := match i with
    | Sum.inl i => O.unit (P.inputColor i)
    | Sum.inr none => O.toCollection.map (frozenOuterProfileHom P Q R)
    | Sum.inr (some j) => 𝟙 (O.toCollection.obj ((R j).toColoredProfile))

/-- Insert the actual variable unit factors and map to the
original operation-substitution tensor, preserving every retained
root/branch coefficient and its original tensor position. -/
def frozenSubstitutionCoefficientTensorMap (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).obj (frozenCoefficientFamily O.toCollection P Q R) ⟶
      (ColoredOperadObj.substitutionSource O.toCollection).obj (frozenSubstitution P Q R) :=
  (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom ≫
    (FiniteTensor.tensor (V := C)).map (frozenUnitCoefficientMap O P Q R)

/-- Actual operadic substitution at all the original added
algebra inputs, with the variable inputs preserved by the original
units and the exact displayed total-profile color bijection. -/
def frozenPartialSubstitution (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).obj (frozenCoefficientFamily O.toCollection P Q R) ⟶
      O.toCollection.obj (extendProfile P (frozenTotalInputs Q R)) :=
  frozenSubstitutionCoefficientTensorMap O P Q R ≫
    O.subst.app (frozenSubstitution P Q R) ≫ O.toCollection.map (frozenTotalProfileHom P Q R)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource008

/- Exact checked source: FrozenVariableUnitNaturality. -/
section EnvelopingSource009


/-!
# Naturality of actual frozen-variable tensor-unit insertion
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem inverseOriginalSquare {V : Type*} [Category* V]
    {A B X Y : V} (e : A ≅ X) (d : B ≅ Y) (k : A ⟶ B) (l : X ⟶ Y)
    (h : k ≫ d.hom = e.hom ≫ l) : l ≫ d.inv = e.inv ≫ k := by
  apply (cancel_epi e.hom).1
  rw [← Category.assoc, ← h, Category.assoc, d.hom_inv_id, Category.comp_id,
    ← Category.assoc e.hom e.inv, e.hom_inv_id, Category.id_comp]

private theorem threeOriginalTensorSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable {C : Type u} [Category.{v} C]

/-- The original variable positions remain fixed; every retained
block uses the original finite-family map and singleton map. -/
def frozenVariableBlocksMap (I : FintypeCat.{0}) {L M : FiniteFamily C} (l : L ⟶ M) :
    frozenVariableBlocks I L ⟶ frozenVariableBlocks I M where
  equiv := Equiv.sumCongr (Equiv.refl I) l.equiv
  hom i := match i with
    | Sum.inl _ => 𝟙 FiniteFamily.empty
    | Sum.inr j => (FiniteFamily.singleton (C := C)).map (l.hom j)

/-- Original retained maps commute with the exact displayed
empty/singleton flattening bijection, including all empty cases. -/
theorem frozenVariableFlattenIso_naturality (I : FintypeCat.{0})
    {L M : FiniteFamily C} (l : L ⟶ M) :
    (FiniteFamily.flatten (C := C)).map (frozenVariableBlocksMap I l) ≫
        (frozenVariableFlattenIso I M).hom =
      (frozenVariableFlattenIso I L).hom ≫ l := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i =>
      change HEq (l.hom i ≫ 𝟙 _) (𝟙 _ ≫ l.hom i)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

theorem frozenVariableFlattenIso_inv_naturality (I : FintypeCat.{0})
    {L M : FiniteFamily C} (l : L ⟶ M) :
    l ≫ (frozenVariableFlattenIso I M).inv =
      (frozenVariableFlattenIso I L).inv ≫
        (FiniteFamily.flatten (C := C)).map (frozenVariableBlocksMap I l) :=
  inverseOriginalSquare (frozenVariableFlattenIso I L) (frozenVariableFlattenIso I M)
    ((FiniteFamily.flatten (C := C)).map (frozenVariableBlocksMap I l)) l
    (frozenVariableFlattenIso_naturality I l)

variable [FiniteTensor C]

/-- Every inserted tensor unit is unchanged and each retained
original object uses its original finite-family map. -/
def frozenVariableUnitFamilyMap (I : FintypeCat.{0}) {L M : FiniteFamily C} (l : L ⟶ M) :
    frozenVariableUnitFamily I L ⟶ frozenVariableUnitFamily I M where
  equiv := Equiv.sumCongr (Equiv.refl I) l.equiv
  hom i := match i with
    | Sum.inl _ => 𝟙 _
    | Sum.inr j => l.hom j

/-- The original singleton unitors commute with every retained
input map; the frozen variable unit factors remain the identity. -/
theorem frozenVariableBlockIso_naturality (I : FintypeCat.{0}) {L M : FiniteFamily C}
    (l : L ⟶ M) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (frozenVariableBlocksMap I l) ≫
        (frozenVariableBlockIso I M).hom =
      (frozenVariableBlockIso I L).hom ≫ frozenVariableUnitFamilyMap I l := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 FiniteFamily.empty) ≫ 𝟙 _) (𝟙 _ ≫ 𝟙 _)
      exact heq_of_eq (congrArg (· ≫ 𝟙 _) ((FiniteTensor.tensor (V :=
        C)).map_id FiniteFamily.empty))
    | inr i =>
      change HEq ((FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C :=
        C)).map (l.hom i)) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (M.obj (l.equiv i)))
        ((FiniteTensor.singletonIso (V := C)).hom.app (L.obj i) ≫ l.hom i)
      exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).hom.naturality (l.hom i))

/-- The actual finite tensor-unit insertion is natural in every
original retained object map and retained permutation. -/
theorem frozenVariableTensorUnitIso_naturality (I : FintypeCat.{0})
    {L M : FiniteFamily C} (l : L ⟶ M) :
    (FiniteTensor.tensor (V := C)).map l ≫ (frozenVariableTensorUnitIso I M).hom =
      (frozenVariableTensorUnitIso I L).hom ≫
        (FiniteTensor.tensor (V := C)).map (frozenVariableUnitFamilyMap I l) := by
  let T := FiniteTensor.tensor (V := C)
  let b := frozenVariableBlocksMap I l
  let k := (FiniteFamily.flatten (C := C)).map b
  let g := (FiniteFamily.map T).map b
  have hp : T.map l ≫ T.map (frozenVariableFlattenIso I M).inv =
      T.map (frozenVariableFlattenIso I L).inv ≫ T.map k :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (frozenVariableFlattenIso_inv_naturality I l)).trans (T.map_comp _ _))
  have hq : T.map k ≫ (FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I M) =
      (FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I L) ≫ T.map g :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality b
  have hr : T.map g ≫ T.map (frozenVariableBlockIso I M).hom =
      T.map (frozenVariableBlockIso I L).hom ≫ T.map (frozenVariableUnitFamilyMap I l) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (frozenVariableBlockIso_naturality I l)).trans (T.map_comp _ _))
  exact threeOriginalTensorSquares (T.map l) (T.map (frozenVariableFlattenIso I L).inv)
    (T.map (frozenVariableFlattenIso I M).inv) (T.map k)
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I L))
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I M)) (T.map g)
    (T.map (frozenVariableBlockIso I L).hom) (T.map (frozenVariableBlockIso I M).hom)
    (T.map (frozenVariableUnitFamilyMap I l)) hp hq hr


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource009

/- Exact checked source: FrozenSubstitutionBranchMaps. -/
section EnvelopingSource010


/-!
# Original inner-profile maps for partial substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- The original branch maps leave variable profiles unchanged
and retain the actual supplied algebra-profile maps. -/
def frozenInnerProfilesMap (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenInnerProfiles P Q R ⟶ frozenInnerProfiles P Q S where
  equiv := Equiv.refl (P.inputs ⊕ Q.index)
  hom i := match i with
    | Sum.inl i => 𝟙 (ColoredProfile.unary (P.inputColor i) (P.inputColor i))
    | Sum.inr j => f j

/-- The actual original color-matched substitution morphism. -/
def frozenSubstitutionMap (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenSubstitution P Q R ⟶ frozenSubstitution P Q S where
  outputColor_eq := rfl
  innerHom := frozenInnerProfilesMap P Q f

/-- All original branch-profile data form the actual
substitution functor, retaining every nullary branch. -/
def frozenSubstitutionFunctor (P : ColoredProfile W) (Q : ColoredInputs W) :
    FrozenBranchTuple Q ⥤ ColoredSubstitutionData W where
  obj R := frozenSubstitution P Q R
  map f := frozenSubstitutionMap P Q f
  map_id R := by
    apply ColoredSubstitutionData.Hom.ext
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i <;> rfl
  map_comp f g := by
    apply ColoredSubstitutionData.Hom.ext
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | inl i => exact heq_of_eq (Category.id_comp _).symm
      | inr i => rfl

/-- The outer profile is independent of all original branch
maps: only their original matched output colors occur there. -/
theorem frozenSubstitution_outerMap (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenOuterProfileHom P Q R ≫
      ColoredSubstitutionData.outerProfileMap (frozenSubstitutionMap P Q f) =
      frozenOuterProfileHom P Q S := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The original total algebra input maps are the original
dependent sum of each supplied branch input bijection. -/
def frozenTotalInputsMap (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenTotalInputs Q R ⟶ frozenTotalInputs Q S where
  equiv := Equiv.sigmaCongrRight (fun j => (f j).inputEquiv)
  hom p := Discrete.eqToHom ((f p.1).inputColor_eq p.2)

/-- The exact displayed original total-profile comparison is
natural in every supplied branch map and every retained input color. -/
theorem frozenTotalProfileHom_naturality (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    ColoredSubstitutionData.totalProfileMap (frozenSubstitutionMap P Q f) ≫
        frozenTotalProfileHom P Q S =
      frozenTotalProfileHom P Q R ≫ extendProfileMap (𝟙 P) (frozenTotalInputsMap Q f) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
  cases i <;> rfl

variable {C : Type w} [Category.{v} C]

/-- The actual root/inner coefficient family is functorial in
all the original branch maps, with the original root coefficient fixed. -/
def frozenCoefficientFunctor (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) : FrozenBranchTuple Q ⥤ FiniteFamily C where
  obj R := frozenCoefficientFamily O P Q R
  map f :=
    { equiv := Equiv.refl (Option Q.index)
      hom i := match i with
        | none => 𝟙 (O.obj (extendProfile P Q))
        | some j => O.map (f j) }
  map_id R := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none => rfl
      | some j => exact heq_of_eq (O.map_id ((R j).toColoredProfile))
  map_comp f g := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none => exact heq_of_eq (Category.id_comp _).symm
      | some j => exact heq_of_eq (O.map_comp (f j) (g j))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource010

/- Exact checked source: OuterProfiles. -/
section EnvelopingSource011


/-!
# Outer added-input bijections with all original branch maps

Every added-input color-preserving bijection acts together with the supplied
full colored-profile arrows on its branches. These arrows may transport
outputs between equal colors that are not definitionally the same. The
variable positions retain their actual unary profiles, including empty cases.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Outer

open CategoryTheory

variable {W : Type u}

/-- The original branch arrows over an original added-input bijection. -/
abbrev BranchArrows {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    (R : FrozenBranchTuple Q) (S : FrozenBranchTuple Q') :=
  ∀ j : Q.index, (R j).toColoredProfile ⟶ (S (g.equiv j)).toColoredProfile

/-- The variable positions are fixed, while both the added-input bijection
and every supplied original branch arrow act on the inner profile family. -/
def innerProfilesMap (P : ColoredProfile W) {Q Q' : ColoredInputs W}
    (g : Q ⟶ Q') {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'}
    (h : BranchArrows g R S) : frozenInnerProfiles P Q R ⟶ frozenInnerProfiles P Q' S where
  equiv := Equiv.sumCongr (Equiv.refl P.inputs) g.equiv
  hom i := match i with
    | Sum.inl i => 𝟙 (ColoredProfile.unary (P.inputColor i) (P.inputColor i))
    | Sum.inr j => h j

/-- The actual complete substitution morphism induced by the outer
bijection and all original branch-profile arrows. -/
def substitutionMap (P : ColoredProfile W) {Q Q' : ColoredInputs W}
    (g : Q ⟶ Q') {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'}
    (h : BranchArrows g R S) : frozenSubstitution P Q R ⟶ frozenSubstitution P Q' S where
  outputColor_eq := rfl
  innerHom := innerProfilesMap P g h

/-- The actual dependent-sum bijection of the original total algebra
inputs, retaining every supplied branch input-color map. -/
def totalInputsMap {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    frozenTotalInputs Q R ⟶ frozenTotalInputs Q' S where
  equiv := Equiv.sigmaCongr g.equiv (fun j => (h j).inputEquiv)
  hom p := Discrete.eqToHom ((h p.1).inputColor_eq p.2)

/-- The exact original outer profile comparison commutes with the
original added-input color-preserving permutation. -/
theorem outerProfileHom_naturality (P : ColoredProfile W) {Q Q' : ColoredInputs W}
    (g : Q ⟶ Q') {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'}
    (h : BranchArrows g R S) :
    frozenOuterProfileHom P Q R ≫ ColoredSubstitutionData.outerProfileMap (substitutionMap P g h) =
      extendProfileMap (𝟙 P) g ≫ frozenOuterProfileHom P Q' S := by
  apply ColoredProfile.Hom.ext
  rfl

/-- Flattening the original total profile commutes with the actual
outer and branch bijections, with the variable inputs fixed. -/
theorem totalProfileHom_naturality (P : ColoredProfile W) {Q Q' : ColoredInputs W}
    (g : Q ⟶ Q') {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'}
    (h : BranchArrows g R S) :
    ColoredSubstitutionData.totalProfileMap (substitutionMap P g h) ≫ frozenTotalProfileHom P Q' S =
      frozenTotalProfileHom P Q R ≫ extendProfileMap (𝟙 P) (totalInputsMap g h) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
  cases i <;> rfl

variable {C : Type w} [Category.{v} C]

/-- The original root and branch coefficient maps, with the actual
option bijection on every retained coefficient position. -/
def coefficientMap (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    frozenCoefficientFamily O P Q R ⟶ frozenCoefficientFamily O P Q' S where
  equiv := Equiv.optionCongr g.equiv
  hom i := match i with
    | none => O.map (extendProfileMap (𝟙 P) g)
    | some j => O.map (h j)


end CategoryTheory.Operad.Tensor.Enveloping.Outer

end
end EnvelopingSource011

/- Exact checked source: FrozenCoefficientNaturality. -/
section EnvelopingSource012


/-!
# Original coefficient-substitution naturality with preserved variables
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalTwoStageSquare {V : Type*} [Category* V]
    {A A' B B' D D' : V} (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B')
    (f : B ⟶ B') (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) :
    l ≫ (p' ≫ q') = (p ≫ q) ≫ g := by
  rw [← Category.assoc l p', hp, Category.assoc p f, hq, Category.assoc]

private theorem originalThreeStageSquare {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original variable unit and retained root/branch
coefficient commutes with the original supplied branch maps. -/
theorem frozenUnitCoefficientMap_naturality (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    frozenUnitCoefficientMap O P Q R ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map (frozenSubstitutionMap P Q f) =
      frozenVariableUnitFamilyMap P.inputs ((frozenCoefficientFunctor O.toCollection P Q).map f) ≫
        frozenUnitCoefficientMap O P Q S := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      change HEq (O.unit (P.inputColor i) ≫
        O.toCollection.map (𝟙 (ColoredProfile.unary (P.inputColor i) (P.inputColor i))))
        (𝟙 _ ≫ O.unit (P.inputColor i))
      exact heq_of_eq ((congrArg (O.unit (P.inputColor i) ≫ ·) (O.toCollection.map_id _)).trans
        ((Category.comp_id _).trans (Category.id_comp _).symm))
    | inr i =>
      cases i with
      | none =>
        change HEq (O.toCollection.map (frozenOuterProfileHom P Q R) ≫
          O.toCollection.map (ColoredSubstitutionData.outerProfileMap (frozenSubstitutionMap
            P Q f)))
          (𝟙 _ ≫ O.toCollection.map (frozenOuterProfileHom P Q S))
        exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
          ((congrArg O.toCollection.map (frozenSubstitution_outerMap P Q f)).trans
            (Category.id_comp _).symm))
      | some j =>
        change HEq (𝟙 _ ≫ O.toCollection.map (f j)) (O.toCollection.map (f j) ≫ 𝟙 _)
        exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- Actual tensor-unit insertion and retained coefficient maps
commute with every original branch substitution morphism. -/
theorem frozenSubstitutionCoefficientTensorMap_naturality (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteTensor.tensor (V := C)).map ((frozenCoefficientFunctor O.toCollection P Q).map f) ≫
        frozenSubstitutionCoefficientTensorMap O P Q S =
      frozenSubstitutionCoefficientTensorMap O P Q R ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (frozenSubstitutionMap P Q f) := by
  let T := FiniteTensor.tensor (V := C)
  let l := (frozenCoefficientFunctor O.toCollection P Q).map f
  let k := frozenVariableUnitFamilyMap P.inputs l
  let m := (ColoredOperadObj.substitutionFactors O.toCollection).map (frozenSubstitutionMap P Q f)
  have h : T.map k ≫ T.map (frozenUnitCoefficientMap O P Q S) =
      T.map (frozenUnitCoefficientMap O P Q R) ≫ T.map m :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (frozenUnitCoefficientMap_naturality O P Q f).symm).trans (T.map_comp _ _))
  exact originalTwoStageSquare (T.map l)
    (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom
    (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q S)).hom
    (T.map k) (T.map (frozenUnitCoefficientMap O P Q R)) (T.map (frozenUnitCoefficientMap O P Q S))
    (T.map m) (frozenVariableTensorUnitIso_naturality P.inputs l) h

/-- The actual original partial substitution is natural in
every supplied branch profile, retaining original variable colors,
unit maps and the exact total-profile input bijection. -/
theorem frozenPartialSubstitution_naturality (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteTensor.tensor (V := C)).map ((frozenCoefficientFunctor O.toCollection P Q).map f) ≫
        frozenPartialSubstitution O P Q S =
      frozenPartialSubstitution O P Q R ≫
        O.toCollection.map (extendProfileMap (𝟙 P) (frozenTotalInputsMap Q f)) := by
  let m := frozenSubstitutionMap P Q f
  have h3 : O.toCollection.map (ColoredSubstitutionData.totalProfileMap m) ≫
        O.toCollection.map (frozenTotalProfileHom P Q S) =
      O.toCollection.map (frozenTotalProfileHom P Q R) ≫
        O.toCollection.map (extendProfileMap (𝟙 P) (frozenTotalInputsMap Q f)) :=
    (O.toCollection.map_comp _ _).symm.trans
      ((congrArg O.toCollection.map (frozenTotalProfileHom_naturality P Q f)).trans
        (O.toCollection.map_comp _ _))
  exact originalThreeStageSquare
    ((FiniteTensor.tensor (V := C)).map ((frozenCoefficientFunctor O.toCollection P Q).map f))
    (frozenSubstitutionCoefficientTensorMap O P Q R) (frozenSubstitutionCoefficientTensorMap
      O P Q S)
    ((ColoredOperadObj.substitutionSource O.toCollection).map m)
    (O.subst.app (frozenSubstitution P Q R)) (O.subst.app (frozenSubstitution P Q S))
    (O.toCollection.map (ColoredSubstitutionData.totalProfileMap m))
    (O.toCollection.map (frozenTotalProfileHom P Q R)) (O.toCollection.map
      (frozenTotalProfileHom P Q S))
    (O.toCollection.map (extendProfileMap (𝟙 P) (frozenTotalInputsMap Q f)))
    (frozenSubstitutionCoefficientTensorMap_naturality O P Q f) (O.subst.naturality m) h3


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource012

/- Exact checked source: OuterCoefficientNaturality. -/
section EnvelopingSource013


/-!
# Outer naturality of actual unit insertion and partial substitution

The actual original operadic natural transformation proves the coefficient
square. Every variable receives its original unary unit, and the retained
coefficients use the original outer and full branch-profile maps.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Outer

open CategoryTheory

private theorem composeTwoSquares {V : Type*} [Category* V]
    {A A' B B' D D' : V} (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B')
    (f : B ⟶ B') (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) :
    l ≫ (p' ≫ q') = (p ≫ q) ≫ g := by
  rw [← Category.assoc l p', hp, Category.assoc p f, hq, Category.assoc]

private theorem EnvelopingSource013_composeThreeSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every actual variable unit and retained coefficient commutes with
the actual added-input bijection and all original branch-profile arrows. -/
theorem unitCoefficientMap_naturality (O : ColoredOperadObj W C) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    frozenUnitCoefficientMap O P Q R ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map (substitutionMap P g h) =
      frozenVariableUnitFamilyMap P.inputs (coefficientMap O.toCollection P g h) ≫
        frozenUnitCoefficientMap O P Q' S := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      change HEq (O.unit (P.inputColor i) ≫
        O.toCollection.map (𝟙 (ColoredProfile.unary (P.inputColor i) (P.inputColor i))))
        (𝟙 _ ≫ O.unit (P.inputColor i))
      exact heq_of_eq ((congrArg (O.unit (P.inputColor i) ≫ ·) (O.toCollection.map_id _)).trans
        ((Category.comp_id _).trans (Category.id_comp _).symm))
    | inr i =>
      cases i with
      | none =>
        change HEq (O.toCollection.map (frozenOuterProfileHom P Q R) ≫
          O.toCollection.map (ColoredSubstitutionData.outerProfileMap (substitutionMap P g h)))
          (O.toCollection.map (extendProfileMap (𝟙 P) g) ≫
            O.toCollection.map (frozenOuterProfileHom P Q' S))
        exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
          ((congrArg O.toCollection.map (outerProfileHom_naturality P g h)).trans
            (O.toCollection.map_comp _ _)))
      | some j =>
        change HEq (𝟙 _ ≫ O.toCollection.map (h j)) (O.toCollection.map (h j) ≫ 𝟙 _)
        exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- Actual unit insertion is natural under all retained coefficient
maps and their original option/sum permutations. -/
theorem substitutionCoefficientTensorMap_naturality (O : ColoredOperadObj W C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection P g h) ≫
        frozenSubstitutionCoefficientTensorMap O P Q' S =
      frozenSubstitutionCoefficientTensorMap O P Q R ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (substitutionMap P g h) := by
  let T := FiniteTensor.tensor (V := C)
  let l := coefficientMap O.toCollection P g h
  let k := frozenVariableUnitFamilyMap P.inputs l
  let m := (ColoredOperadObj.substitutionFactors O.toCollection).map (substitutionMap P g h)
  have hs : T.map k ≫ T.map (frozenUnitCoefficientMap O P Q' S) =
      T.map (frozenUnitCoefficientMap O P Q R) ≫ T.map m :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (unitCoefficientMap_naturality O P g h).symm).trans (T.map_comp _ _))
  exact composeTwoSquares (T.map l)
    (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom
    (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q' S)).hom
    (T.map k) (T.map (frozenUnitCoefficientMap O P Q R)) (T.map (frozenUnitCoefficientMap O P Q' S))
    (T.map m) (frozenVariableTensorUnitIso_naturality P.inputs l) hs

/-- The actual partial substitution commutes with the original outer
bijection and every supplied branch arrow, retaining all variables,
heterogeneous unit maps, colors, and the full total-input bijection. -/
theorem partialSubstitution_naturality (O : ColoredOperadObj W C) (P : ColoredProfile W)
    {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection P g h) ≫
        frozenPartialSubstitution O P Q' S =
      frozenPartialSubstitution O P Q R ≫
        O.toCollection.map (extendProfileMap (𝟙 P) (totalInputsMap g h)) := by
  let m := substitutionMap P g h
  have ht : O.toCollection.map (ColoredSubstitutionData.totalProfileMap m) ≫
        O.toCollection.map (frozenTotalProfileHom P Q' S) =
      O.toCollection.map (frozenTotalProfileHom P Q R) ≫
        O.toCollection.map (extendProfileMap (𝟙 P) (totalInputsMap g h)) :=
    (O.toCollection.map_comp _ _).symm.trans
      ((congrArg O.toCollection.map (totalProfileHom_naturality P g h)).trans
        (O.toCollection.map_comp _ _))
  exact EnvelopingSource013_composeThreeSquares
    ((FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection P g h))
    (frozenSubstitutionCoefficientTensorMap O P Q R) (frozenSubstitutionCoefficientTensorMap
      O P Q' S)
    ((ColoredOperadObj.substitutionSource O.toCollection).map m)
    (O.subst.app (frozenSubstitution P Q R)) (O.subst.app (frozenSubstitution P Q' S))
    (O.toCollection.map (ColoredSubstitutionData.totalProfileMap m))
    (O.toCollection.map (frozenTotalProfileHom P Q R)) (O.toCollection.map
      (frozenTotalProfileHom P Q' S))
    (O.toCollection.map (extendProfileMap (𝟙 P) (totalInputsMap g h)))
    (substitutionCoefficientTensorMap_naturality O P g h) (O.subst.naturality m) ht


end CategoryTheory.Operad.Tensor.Enveloping.Outer

end
end EnvelopingSource013

/- Exact checked source: RootedProfileTensorColimit. -/
section EnvelopingSource014


/-!
# Actual tensor colimits with a retained original root coefficient

The original root coefficient is fixed independently of the inner
operad profiles. Separate tensor-slot preservation constructs the
complete original finite product-profile colimit.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Retain the actual root coefficient and original inner
operation-tensor-input diagrams at every original finite slot. -/
def rootedSlotDiagram (X : C) (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (Q : AnalyticIndex W d) :
    (i : Option Q.inputs) → profileSlotIndex Q i ⥤ C
  | none => (Functor.const CoefficientIndex).obj X
  | some j => analyticSummand (d := Q.inputColor j) O B

variable [∀ d : W, HasColimitsOfShape (AnalyticIndex W d) C]

/-- The actual source root/inner slot cocones, with the fixed
root coefficient and each original profile coinvariant carrier. -/
def rootedSlotCocone (X : C) (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (Q : AnalyticIndex W d) :
    (i : Option Q.inputs) → Cocone (rootedSlotDiagram X O B Q i)
  | none => constCocone CoefficientIndex X
  | some j => colimit.cocone (analyticSummand (d := Q.inputColor j) O B)

/-- The fixed root cocone and each analytic slot cocone are colimits. -/
def rootedSlotIsColimit (X : C) (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (Q : AnalyticIndex W d) :
    (i : Option Q.inputs) → IsColimit (rootedSlotCocone X O B Q i)
  | none => isColimitConstCocone CoefficientIndex X
  | some j => colimit.isColimit (analyticSummand (d := Q.inputColor j) O B)

/-- The original full product-profile tensor diagram, including
the original unique root coefficient index and all inner profiles. -/
def rootedSlotTensorDiagram (X : C) (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (Q : AnalyticIndex W d) : ProfileSlotTuple Q ⥤ C :=
  FiniteMultifunctor.finiteIndexDiagram (fixedIndexTensorFunctor (analyticFactorsIndex Q))
    (rootedSlotDiagram X O B Q)

/-- Its actual finite tensor cocone keeps all original component
injections, including the empty family of inner profiles. -/
def rootedSlotTensorCocone (X : C) (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (Q : AnalyticIndex W d) : Cocone (rootedSlotTensorDiagram X O B Q) := by
  letI : ∀ i : analyticFactorsIndex Q, Category.{0} (profileSlotIndex Q i) :=
    fun i => profileSlotCategory Q i
  exact FiniteMultifunctor.finiteIndexCocone (fixedIndexTensorFunctor (analyticFactorsIndex Q))
    (rootedSlotCocone X O B Q)

variable [Small.{us} W] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The original separate-slot tensor preservation constructs
the complete actual root/inner profile colimit; no joint-colimit
or enveloping-map conclusion is supplied as an input. -/
def rootedSlotTensorIsColimit (X : C) (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (Q : AnalyticIndex W d) : IsColimit (rootedSlotTensorCocone X O B Q) := by
  let : DecidableEq (analyticFactorsIndex Q) := Classical.decEq (analyticFactorsIndex Q)
  let : ∀ i : analyticFactorsIndex Q, Category.{0} (profileSlotIndex Q i) :=
    fun i => profileSlotCategory Q i
  let : ∀ i : analyticFactorsIndex Q, EssentiallySmall.{us} (profileSlotIndex Q i) :=
    fun i => profileSlotEssentiallySmall Q i
  let : Functor.PreservesColimitsInEachSlot.{0, w, v, w, v, us}
      (fixedIndexTensorFunctor (C := C) (analyticFactorsIndex Q)) :=
    FiniteTensorPreservesColimitsInEachSlot.preserves (C := C) (analyticFactorsIndex Q)
  exact FiniteMultifunctor.isColimitFiniteIndexCocone
    (fixedIndexTensorFunctor (analyticFactorsIndex Q)) (rootedSlotIsColimit X O B Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
