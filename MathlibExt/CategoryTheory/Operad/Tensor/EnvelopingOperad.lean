section EnvelopingSource077


/-!
# Empty tensor blocks at original unit positions and retained nested coefficient blocks
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- Original unit positions are actual empty blocks and every
original retained nested tensor block is unchanged. -/
def emptyAndRetainedBlocks (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (I ⊕ N.index)
  obj p := match p with
    | Sum.inl _ => FiniteFamily.empty
    | Sum.inr i => N.obj i

/-- Only the original empty unit blocks disappear when the
source is flattened; every retained original dependent coefficient remains. -/
def emptyAndRetainedFlattenEquiv (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    ((FiniteFamily.flatten (C := C)).obj (emptyAndRetainedBlocks I N)).index ≃
      ((FiniteFamily.flatten (C := C)).obj N).index where
  toFun p := match p with
    | ⟨Sum.inl _, j⟩ => j.elim
    | ⟨Sum.inr i, j⟩ => ⟨i, j⟩
  invFun p := ⟨Sum.inr p.1, p.2⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact j.elim
    | inr i => rfl
  right_inv p := rfl

/-- The actual original flattened family has precisely the
retained coefficient positions and original objects. -/
def emptyAndRetainedFlattenIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.flatten (C := C)).obj (emptyAndRetainedBlocks I N) ≅
      (FiniteFamily.flatten (C := C)).obj N :=
  FiniteFamily.isoOfComponents (emptyAndRetainedFlattenEquiv I N) (fun p => match p with
    | ⟨Sum.inl _, j⟩ => j.elim
    | ⟨Sum.inr _, _⟩ => Iso.refl _)

variable [FiniteTensor C]

/-- The actual empty/retained block tensor family is precisely
the original unit/retained tensor-factor family. -/
def emptyAndRetainedTensorIso (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (emptyAndRetainedBlocks I N) ≅
      frozenVariableUnitFamily I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N) :=
  FiniteFamily.isoOfComponents (Equiv.refl (I ⊕ N.index)) (fun p => match p with
    | Sum.inl _ => Iso.refl _
    | Sum.inr _ => Iso.refl _)

/-- The actual original source tensor retains all original
empty-block unit insertions and all original coefficient block maps. -/
def emptyAndRetainedInsertion (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj N) ⟶
      (FiniteTensor.tensor (V := C)).obj
        (frozenVariableUnitFamily I ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N)) :=
  (FiniteTensor.tensor (V := C)).map (emptyAndRetainedFlattenIso I N).inv ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (emptyAndRetainedBlocks I N) ≫
    (FiniteTensor.tensor (V := C)).map (emptyAndRetainedTensorIso I N).hom


end CategoryTheory.Operad.Tensor.Enveloping

end
