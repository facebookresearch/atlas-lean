private theorem coefficientContractionFiring {D : Type*} [Category* D] {A B C E F G H : D}
    (p : A ⟶ B) (u : B ⟶ C) (f : C ⟶ E) (i : E ⟶ E) (b : E ⟶ F) (c : F ⟶ G)
    (s : C ⟶ H) (q : H ⟶ F) (h : H ⟶ G)
    (hi : i = 𝟙 E) (hf : f ≫ b = s ≫ q) (hq : q ≫ c = h) :
    (p ≫ (u ≫ f)) ≫ i ≫ b ≫ c = p ≫ u ≫ s ≫ h := by
  calc
    (p ≫ (u ≫ f)) ≫ i ≫ b ≫ c = p ≫ u ≫ f ≫ (i ≫ b) ≫ c := by simp only [Category.assoc]
    _ = p ≫ u ≫ f ≫ b ≫ c := by rw [hi, Category.id_comp]
    _ = p ≫ u ≫ (f ≫ b) ≫ c := by simp only [Category.assoc]
    _ = p ≫ u ≫ (s ≫ q) ≫ c := congrArg (p ≫ u ≫ · ≫ c) hf
    _ = p ≫ u ≫ s ≫ h := by simpa only [Category.assoc] using congrArg (p ≫ u ≫ s ≫ ·) hq

private theorem rootContractionAssoc {D : Type*} [Category* D] {A B C E F G : D}
    (p : A ⟶ B) (u : B ⟶ C) (s : C ⟶ E) (t : E ⟶ F) (h : F ⟶ G) :
    p ≫ u ≫ s ≫ (t ≫ h) = ((p ≫ u) ≫ s ≫ t) ≫ h := by simp only [Category.assoc]

private theorem oneUnitContraction {D : Type*} [Category* D] {U A X : D}
    (e : A ≅ X) (q : U ⟶ A) (f : U ⟶ X) (i : A ⟶ A) (h : X ⟶ X)
    (hq : q = f ≫ e.inv) (hi : i = 𝟙 A) (hh : h = 𝟙 X) : q ≫ i ≫ e.hom ≫ h = f := by
  rw [hq, hi, hh]
  simp only [Category.assoc, Category.id_comp, Category.comp_id, Iso.inv_hom_id]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

private theorem emptySingleton_point (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) :
