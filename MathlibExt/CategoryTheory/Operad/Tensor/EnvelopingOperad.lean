section EnvelopingSource153


/-!
# Original weighted coefficient positions and their exact algebra inputs

These comparisons retain the original two weighted source families. They
only display each original coefficient together with its supplied finite
family of algebra inputs, before applying grouped normalization.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The exact supplied algebra-input family at each original root,
middle, or inner coefficient position in the branch-first grouping. -/
def coefficientInputsA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocCoefficients O d Q).index → FiniteFamily C
  | ⟨none, _⟩ => (addedAlgebraInputs B).obj Q.root
  | ⟨some i, j⟩ => (addedAlgebraInputs B).obj (Q.branch i j)

/-- The same supplied input families at their original root-first
coefficient positions; no coefficient or input is contracted. -/
def coefficientInputsB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ((FiniteFamily.flatten (C := C)).obj
      (envelopingAssocRootFirstCoefficientBlocks O d Q)).index → FiniteFamily C
  | ⟨none, j⟩ => (addedAlgebraInputs B).obj (envelopingAssocMiddleChoices d Q j)
  | ⟨some p, _⟩ => (addedAlgebraInputs B).obj (Q.branch p.1 (some p.2))

/-- The actual original coefficient permutation preserves each
whole supplied heterogeneous input family by its identity map. -/
def coefficientInputsRelabelIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (p : (envelopingAssocCoefficients O d Q).index) :
    coefficientInputsA O B d Q p ≅ coefficientInputsB O B d Q
      ((envelopingAssocRootFirstCoefficientIso O d Q).hom.equiv p) := by
  rcases p with ⟨i, j⟩
  cases i with
  | none => exact Iso.refl _
  | some i => cases j <;> exact Iso.refl _

variable [FiniteTensor C]

/-- At every original branch-first weighted block, only the
presentation of the same original coefficient object is changed. -/
def weightedBlocksIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedBlocks O B d Q ≅
      groupedCoefficientInputWeightedBlocks (envelopingAssocCoefficientBlocks O d Q)
        (coefficientInputsA O B d Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.branches.index)) (fun i => by
    cases i with
    | none => exact Iso.refl _
    | some i =>
      exact FiniteFamily.isoOfComponents
        (Equiv.refl (Option (d.localData i).inner.index)) (fun j => by
          cases j <;> exact Iso.refl _))

/-- At every original root-first weighted block, the complete
original weighted coefficient/input object is retained. -/
def weightedBlocksIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRootFirstBlocks O B d Q ≅
      groupedCoefficientInputWeightedBlocks (envelopingAssocRootFirstCoefficientBlocks O d Q)
        (coefficientInputsB O B d Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.middleData.totalProfile.inputs))
    (fun i => by
      cases i with
      | none =>
        exact FiniteFamily.isoOfComponents (Equiv.refl (Option d.branches.index))
          (fun j => by cases j <;> exact Iso.refl _)
      | some p => exact Iso.refl _)

/-- The branch-first grouped source is the original weighted
source with the same original coefficient and input objects. -/
def weightedSourceIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedFamily O B d Q ≅
      (FiniteFamily.flatten (C := C)).obj
        (groupedCoefficientInputWeightedBlocks (envelopingAssocCoefficientBlocks O d Q)
          (coefficientInputsA O B d Q)) :=
  (FiniteFamily.flatten (C := C)).mapIso (weightedBlocksIsoA O B d Q)

/-- The root-first grouped source uses the original weighted
regrouping, retaining every original root, middle, and inner factor. -/
def weightedSourceIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedFamily O B d Q ≅
      (FiniteFamily.flatten (C := C)).obj
        (groupedCoefficientInputWeightedBlocks (envelopingAssocRootFirstCoefficientBlocks O d Q)
          (coefficientInputsB O B d Q)) :=
  envelopingAssocWeightedRootFirstIso O B d Q ≪≫
    (FiniteFamily.flatten (C := C)).mapIso (weightedBlocksIsoB O B d Q)

/-- Display the original branch-first weighted source at its
original flat atomic coefficient positions, with all supplied inputs. -/
def atomicSourceIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedFamily O B d Q ≅
      weightedInputBlockFamily (envelopingAssocCoefficients O d Q).index
        (envelopingAssocCoefficients O d Q).obj (coefficientInputsA O B d Q) :=
  weightedSourceIsoA O B d Q ≪≫
    Grouping.atomicWeightedIso (envelopingAssocCoefficientBlocks O d Q)
      (coefficientInputsA O B d Q)

/-- Display the same original weighted source at its original
root-first flat atomic positions, retaining the original regrouping. -/
def atomicSourceIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedFamily O B d Q ≅
      weightedInputBlockFamily
        ((FiniteFamily.flatten (C := C)).obj
          (envelopingAssocRootFirstCoefficientBlocks O d Q)).index
        ((FiniteFamily.flatten (C := C)).obj
          (envelopingAssocRootFirstCoefficientBlocks O d Q)).obj
        (coefficientInputsB O B d Q) :=
  weightedSourceIsoB O B d Q ≪≫
    Grouping.atomicWeightedIso (envelopingAssocRootFirstCoefficientBlocks O d Q)
      (coefficientInputsB O B d Q)

/-- The original block-tensor family comparison has identity
components and the identity original block permutation. -/
theorem tensorCoefficientBlocksIsoA_hom (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocTensorCoefficientBlocksIso O d Q).hom = 𝟙 _ := rfl

/-- The original root-first block-tensor family comparison also
retains its identity components and original block indices. -/
theorem tensorCoefficientBlocksIsoB_hom (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocRootFirstTensorCoefficientBlocksIso O d Q).hom = 𝟙 _ := rfl

/-- The actual branch-first complete coefficient tensor map is
the genuine finite coefficient-flattening inverse. -/
theorem fullCoefficientTensorIsoA_hom (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocFullCoefficientTensorIso O d Q).hom =
      (FiniteTensor.flattenIso (V := C)).inv.app (envelopingAssocCoefficientBlocks O d Q) := by
  let T := FiniteTensor.tensor (V := C)
  let N := envelopingAssocCoefficientBlocks O d Q
  have hf : (envelopingAssocTensorCoefficientBlocksIso O d Q).hom =
      𝟙 ((FiniteFamily.map T).obj N) := rfl
  have ht : T.map (envelopingAssocTensorCoefficientBlocksIso O d Q).hom =
      𝟙 (T.obj ((FiniteFamily.map T).obj N)) :=
    (congrArg T.map hf).trans (T.map_id _)
  exact (congrArg (· ≫ (FiniteTensor.flattenIso (V := C)).inv.app N) ht).trans
    (Category.id_comp _)

/-- The actual root-first complete coefficient tensor map uses
the genuine flattening inverse and the original coefficient regrouping inverse. -/
theorem fullCoefficientTensorIsoB_hom (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocRootFirstFullCoefficientTensorIso O d Q).hom =
      (FiniteTensor.flattenIso (V := C)).inv.app
        (envelopingAssocRootFirstCoefficientBlocks O d Q) ≫
      (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstCoefficientIso O d Q).inv := by
  let T := FiniteTensor.tensor (V := C)
  let N := envelopingAssocRootFirstCoefficientBlocks O d Q
  have hf : (envelopingAssocRootFirstTensorCoefficientBlocksIso O d Q).hom =
      𝟙 ((FiniteFamily.map T).obj N) := rfl
  have ht : T.map (envelopingAssocRootFirstTensorCoefficientBlocksIso O d Q).hom =
      𝟙 (T.obj ((FiniteFamily.map T).obj N)) :=
    (congrArg T.map hf).trans (T.map_id _)
  exact (congrArg (· ≫ ((FiniteTensor.flattenIso (V := C)).inv.app N ≫
    T.map (envelopingAssocRootFirstCoefficientIso O d Q).inv)) ht).trans
      (Category.id_comp _)


end CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

end
