        (coefficientLeavesNestedMap
          ((coefficientInputFactorsMap
            (Functor.whiskerRight (fixedProfileExtensionMap f) O)
            (𝟙 (addedAlgebraInputs B))).app Q)
          (profileLeafIso M f).hom) ≫ representativeFactors O B M g P'.toColoredProfile Q =
      representativeFactors O B M g P.toColoredProfile Q ≫
        (analyticFactors (d := d) O M).map
          (show profileInputs (extendProfile P.toColoredProfile Q) ⟶
            profileInputs (extendProfile P'.toColoredProfile Q) from extendProfileMap f (𝟙 Q)) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
