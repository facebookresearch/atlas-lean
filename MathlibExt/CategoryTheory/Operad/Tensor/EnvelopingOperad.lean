/- Exact checked source: ConstantActionExtensionGroupingData. -/
section EnvelopingSource316


/-!
# Original empty/singleton grouping of the weighted constant-input face
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original variable positions retain their empty coefficient
blocks and every original root/branch coefficient retains its singleton. -/
def coefficientGrouping (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) : FiniteFamily (FiniteFamily C) :=
  frozenVariableBlocks P.inputs (frozenCoefficientFamily O P Q R)

/-- The original root has no B input, and each original coefficient
branch has exactly its original heterogeneous B input family. -/
def atomicLeaves (O : ColoredSymmetricCollection W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    ((FiniteFamily.flatten (C := C)).obj (coefficientGrouping O P Q R)).index → FiniteFamily C
  | ⟨Sum.inl _, j⟩ => j.elim
  | ⟨Sum.inr none, _⟩ => FiniteFamily.empty
  | ⟨Sum.inr (some j), _⟩ => profileLeafFamily B (R j).toColoredProfile

variable [FiniteTensor C]

/-- The original weighted source has exactly the original variable
empty blocks and original singleton weighted root/branch blocks. -/
def weightedSourceBlocks (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) : FiniteFamily
      (FiniteFamily C) :=
  frozenVariableBlocks P.inputs (frozenWeightedBranchFamily O B P Q R)

/-- The actual original weighted blocks are the original grouped
coefficient/input weighted blocks, by original empty/profile unitors. -/
def groupedWeightedSourceIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    weightedSourceBlocks O B P Q R ≅
      groupedCoefficientInputWeightedBlocks (coefficientGrouping O P Q R) (atomicLeaves O B
        P Q R) :=
  FiniteFamily.isoOfComponents (Equiv.refl (P.inputs ⊕ Option Q.index)) (fun i => match i with
    | Sum.inl _ => FiniteFamily.isoOfComponents (Equiv.refl Empty) (fun j => j.elim)
    | Sum.inr none => FiniteFamily.isoOfComponents (Equiv.refl PUnit) (fun _ =>
        (emptyLeafTensorIso (O.obj (extendProfile P Q))).symm)
    | Sum.inr (some j) => FiniteFamily.isoOfComponents (Equiv.refl PUnit) (fun _ =>
        (profileCoefficientLeafTensorIso O B (R j).toColoredProfile).symm))

/-- Each original grouped coefficient block uses the original
representative coefficient at its actual displayed target slot. -/
def targetCoefficients (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (coefficientGrouping O.toCollection P Q R).index → C :=
  fun i => (envelopingRepresentativeCoefficients O.toCollection (shape P Q) (choices P Q R)).obj
    ((coefficientInsertion O P Q R).equiv i)

/-- Every original grouped target input block retains the original
actual added B inputs at its displayed target representative slot. -/
def targetLeaves (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (coefficientGrouping O.toCollection P Q R).index → FiniteFamily C :=
  fun i => (addedAlgebraInputs B).obj ((choices P Q R) ((coefficientInsertion O P Q R).equiv i))

/-- Each original coefficient group is evaluated by its original
unit or singleton unitor followed by its exact original profile map. -/
def groupedCoefficientFactor (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q)
    (i : (coefficientGrouping O.toCollection P Q R).index) :
    (FiniteTensor.tensor (V := C)).obj ((coefficientGrouping O.toCollection P Q R).obj i) ⟶
      targetCoefficients O P Q R i :=
  match i with
  | Sum.inl i => O.unit (P.inputColor i) ≫
      (O.toCollection.mapIso (emptyExtensionProfileIso
        (ColoredProfile.unary (P.inputColor i) (P.inputColor i)))).inv
  | Sum.inr none => (FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj
    (extendProfile P Q)) ≫
      O.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q)) ≫
      (O.toCollection.mapIso (emptyExtensionProfileIso (shape P Q).outerProfile)).inv
  | Sum.inr (some j) => (FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj (R
    j).toColoredProfile) ≫
      (O.toCollection.mapIso (nullaryVariableProfileComponentIso (Q.obj j).as (branchInputs
        (R j)))).inv

/-- Original grouped leaf inputs retain exactly their original
empty/singleton index correction into the actual added B input block. -/
def groupedLeafBlockIso (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q)
    (i : (coefficientGrouping O.toCollection P Q R).index) :
    groupedCoefficientInputs (coefficientGrouping O.toCollection P Q R) (atomicLeaves
      O.toCollection B P Q R) i ≅
      targetLeaves O B P Q R i :=
  match i with
  | Sum.inl _ => FiniteFamily.isoOfComponents
      { toFun p := p.1.elim
        invFun p := p.elim
        left_inv p := p.1.elim
        right_inv p := p.elim }
      (fun p => p.1.elim)
  | Sum.inr none => FiniteFamily.isoOfComponents
      { toFun p := p.2.elim
        invFun p := p.elim
        left_inv p := p.2.elim
        right_inv p := p.elim }
      (fun p => p.2.elim)
  | Sum.inr (some j) => FiniteFamily.isoOfComponents
      { toFun p := p.2
        invFun p := ⟨PUnit.unit, p⟩
        left_inv p := by rcases p with ⟨i, p⟩; cases i; rfl
        right_inv _ := rfl }
      (fun p => Iso.refl (B ((R j).inputColor p.2)))

/-- The original target coefficients retain the exact original
variable/root/branch slot bijection into representative coefficients. -/
def groupedTargetCoefficientIso (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    coefficientBlockFamily (coefficientGrouping O.toCollection P Q R).index
      (targetCoefficients O P Q R) ≅
      envelopingRepresentativeCoefficients O.toCollection (shape P Q) (choices P Q R) :=
  FiniteFamily.isoOfComponents (coefficientInsertion O P Q R).equiv (fun _ => Iso.refl _)

/-- The original grouped weighted targets retain exactly the original
representative weighted root/variable/branch tensor objects and slots. -/
def groupedTargetWeightedIso (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    weightedInputBlockFamily (coefficientGrouping O.toCollection P Q R).index
      (targetCoefficients O P Q R) (targetLeaves O B P Q R) ≅
    envelopingWeightedRepresentativeFamily O.toCollection B (shape P Q) (choices P Q R) :=
  FiniteFamily.isoOfComponents (coefficientInsertion O P Q R).equiv (fun i => match i with
    | Sum.inl _ => Iso.refl _
    | Sum.inr none => Iso.refl _
    | Sum.inr (some _) => Iso.refl _)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
end EnvelopingSource316

/- Exact checked source: ConstantActionExtensionLeafComparisons. -/
section EnvelopingSource317


/-!
# Original empty and branch input comparisons for grouped constant-input normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original full branch input colors are retained in the actual
added B input family, with their original finite input index. -/
def branchInputLeafIso (B : W → C) {d : W} (R : AnalyticIndex W d) :
    profileLeafFamily B R.toColoredProfile ≅ (addedAlgebraInputs B).obj (branchInputs R) :=
  FiniteFamily.isoOfComponents (Equiv.refl R.inputs) (fun i => Iso.refl (B (R.inputColor i)))

/-- The inverse empty original linear-factor comparison is exactly
the original coefficient identity and inverse empty B-input comparison. -/
theorem emptyLinearFactorsIso_inv (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) :
    (emptyLinearFactorsIso O B P).inv =
      coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
        (emptyAddedAlgebraInputsIso B).inv := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | none => rfl
    | some i => exact i.elim
  · intro i
    cases i with
    | none =>
      let X := O.obj (extendProfile P emptyColoredInputs)
      change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (Category.id_comp _)
    | some i => exact i.elim

/-- The original nullary linear-factor inverse uses precisely its
original O-profile inverse and full original B-input identity. -/
theorem nullaryLinearFactorsIso_inv (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (R : AnalyticIndex W d) :
    (profileOperationFactorsIso O B R.toColoredProfile).inv ≫
      coefficientLeafMap (O.mapIso (nullaryVariableProfileComponentIso d (branchInputs R))).inv
        (branchInputLeafIso B R).hom =
      (nullaryLinearFactorsIso O B d).inv.app (branchInputs R) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      let X := O.obj R.toColoredProfile
      let f := (O.mapIso (nullaryVariableProfileComponentIso d (branchInputs R))).inv
      change HEq ((𝟙 X ≫ 𝟙 X) ≫ f) (𝟙 X ≫ f)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some i =>
      let X := B (R.inputColor i)
      change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])

/-- All inserted variable leaf blocks and the original root leaf
block are empty; every branch retains precisely its original B inputs. -/
def simpleGroupedLeaves (B : W → C) (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : FrozenBranchTuple Q) : P.inputs ⊕ Option Q.index → FiniteFamily C
  | Sum.inl _ => FiniteFamily.empty
  | Sum.inr none => FiniteFamily.empty
  | Sum.inr (some j) => profileLeafFamily B (R j).toColoredProfile

variable [FiniteTensor C]

/-- The original simple leaf blocks enter exactly the original
actual added-input target blocks at every retained original slot. -/
def simpleGroupedLeafIso (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) (i : (coefficientGrouping O.toCollection
      P Q R).index) :
    simpleGroupedLeaves B P Q R i ≅ targetLeaves O B P Q R i :=
  match i with
  | Sum.inl _ => (emptyAddedAlgebraInputsIso B).symm
  | Sum.inr none => (emptyAddedAlgebraInputsIso B).symm
  | Sum.inr (some j) => branchInputLeafIso B (R j)

/-- The actual original grouped leaf families have only their original
empty or singleton group-index correction before the original simple leaves. -/
def groupedLeafUnitorIso (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) (i : (coefficientGrouping O.toCollection
      P Q R).index) :
    groupedCoefficientInputs (coefficientGrouping O.toCollection P Q R) (atomicLeaves
      O.toCollection B P Q R) i ≅
      simpleGroupedLeaves B P Q R i :=
  match i with
  | Sum.inl i => Linear.UnitGeometry.emptyLeavesIso
      (fun j : Empty => atomicLeaves O.toCollection B P Q R ⟨Sum.inl i, j⟩)
  | Sum.inr none => singletonCoefficientInputLeafIso (FiniteFamily.empty : FiniteFamily C)
  | Sum.inr (some j) => singletonCoefficientInputLeafIso (profileLeafFamily B (R
    j).toColoredProfile)

/-- The actual original grouped leaf correction is the original
empty/singleton unitor followed by its original input-family identity. -/
theorem groupedLeafBlockIso_factor (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) (i : (coefficientGrouping O.toCollection
      P Q R).index) :
    (groupedLeafBlockIso O B P Q R i).hom =
      (groupedLeafUnitorIso O B P Q R i).hom ≫ (simpleGroupedLeafIso O B P Q R i).hom := by
  cases i with
  | inl i =>
    apply FiniteFamily.Hom_ext
    · ext p
      exact p.1.elim
    · intro p
      exact p.1.elim
  | inr i => cases i with
    | none =>
      apply FiniteFamily.Hom_ext
      · ext p
        exact p.2.elim
      · intro p
        exact p.2.elim
    | some j =>
      apply FiniteFamily.Hom_ext
      · ext p
        cases p.1
        rfl
      · intro p
        let X := B ((R j).inputColor p.2)
        change HEq (𝟙 X) (𝟙 X ≫ 𝟙 X)
        exact heq_of_eq (Category.id_comp _).symm


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
end EnvelopingSource317

/- Exact checked source: ConstantActionExtensionScalarNormalization. -/
section EnvelopingSource318


/-!
# Original scalar empty/singleton maps in the grouped weighted normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem scalarLeafFiring {D : Type*} [Category* D]
    {X A B C Y : D} (n : X ⟶ A) (p : A ⟶ B) (q : B ⟶ Y)
    (a : X ⟶ C) (b : C ⟶ B) (c : C ⟶ Y)
    (hn : n ≫ p = a ≫ b) (hq : b ≫ q = c) : n ≫ (p ≫ q) = a ≫ c := by
  rw [← Category.assoc n p, hn, Category.assoc a b, hq]

private theorem scalarEmptyFiring {D : Type*} [Category* D]
    {X A B C E F Y : D} (s : X ⟶ A) (n : A ⟶ B) (p : B ⟶ C) (v : C ⟶ E)
    (q : E ⟶ Y) (k : B ⟶ Y) (e : X ⟶ C) (c : X ⟶ F) (e' : F ⟶ E)
    (hk : k = p ≫ v ≫ q) (hp : s ≫ n ≫ p = e) (hv : e ≫ v = c ≫ e') :
    s ≫ n ≫ k = c ≫ e' ≫ q := by
  rw [hk]
  have h := congrArg (fun p => p ≫ v ≫ q) hp
  simp only [Category.assoc] at h ⊢
  rw [h, ← Category.assoc e v, hv]
  exact Category.assoc _ _ _

private theorem scalarEmptyFinish {D : Type*} [Category* D]
    {X A B E Y : D} (c : X ⟶ A) (a : A ⟶ B) (n : B ⟶ E) (f : E ⟶ Y) (r : A ⟶ Y)
    (h : r = a ≫ n ≫ f) : (c ≫ a) ≫ n ≫ f = c ≫ r := by
  rw [h]
  simp only [Category.assoc]

private theorem scalarMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem scalarIsoInverseThree {D : Type*} [Category* D]
    {X A B Y : D} (a : X ≅ A) (b : A ≅ B) (c : B ≅ Y) :
    (a ≪≫ b ≪≫ c).inv = c.inv ≫ b.inv ≫ a.inv := Category.assoc _ _ _

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original singleton coefficient/input interchange retains
an arbitrary original coefficient map and arbitrary original leaf map. -/
theorem singletonInterchange_leafMap (X : C) (L : FiniteFamily C) {Y : C}
    (f : (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.singleton (C := C)).obj X) ⟶ Y)
    {M : FiniteFamily C} (g : L ⟶ M) :
    (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _ => L)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap f ((singletonCoefficientInputLeafIso L).hom ≫ g)) =
    (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.singletonIso (V := C)).inv.app X ≫ f) g) := by
  let T := FiniteTensor.tensor (V := C)
  let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _
    => L)).hom
  let ell := (singletonCoefficientInputLeafIso L).hom
  let p := T.map (coefficientLeafMap f ell)
  let q := T.map (coefficientLeafMap (𝟙 Y) g)
  let a := (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X)
  let c := (FiniteTensor.singletonIso (V := C)).inv.app X ≫ f
  let b := (coefficientLeafTensorFunctor L).map c
  let r := T.map (coefficientLeafMap c g)
  have hraw : coefficientLeafMap f ell ≫ coefficientLeafMap (𝟙 Y) g =
    coefficientLeafMap f (ell ≫ g) :=
    (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg (fun f => coefficientLeafMap f (ell ≫ g)) (Category.comp_id f))
  have hmap : T.map (coefficientLeafMap f (ell ≫ g)) = p ≫ q :=
    (congrArg T.map hraw.symm).trans (T.map_comp _ _)
  have hn : n ≫ p = a ≫ b := Linear.UnitGeometry.singletonInterchangePost X L f
  have hq : b ≫ q = r := (T.map_comp _ _).symm.trans
    (congrArg T.map ((coefficientLeafMap_pre c (𝟙 Y) g).trans
      (congrArg (fun c => coefficientLeafMap c g) (Category.comp_id c))))
  exact (congrArg (n ≫ ·) hmap).trans (scalarLeafFiring n p q a b r hn hq)

/-- Actual original empty coefficient/input interchange retains any
original unit coefficient map and its original empty input correction. -/
theorem emptyInterchange_leafMap (L : Empty → FiniteFamily C) {Y : C}
    (c : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y)
    {M : FiniteFamily C} (g : (FiniteFamily.empty : FiniteFamily C) ⟶ M) :
    (FiniteTensor.tensor (V := C)).map (Linear.UnitGeometry.emptyWeightedIso L).hom ≫
      (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty) (FiniteFamily.empty (C :=
        C)).obj L).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap c ((Linear.UnitGeometry.emptyLeavesIso L).hom ≫ g)) =
    c ≫ (emptyLeafTensorIso Y).inv ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 Y) g) := by
  let T := FiniteTensor.tensor (V := C)
  let X := T.obj (FiniteFamily.empty : FiniteFamily C)
  let ell := (Linear.UnitGeometry.emptyLeavesIso L).hom
  let s := T.map (Linear.UnitGeometry.emptyWeightedIso L).hom
  let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty) (FiniteFamily.empty
    (C := C)).obj L).hom
  let p := T.map (coefficientLeafMap (𝟙 X) ell)
  let v := (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map c
  let q := T.map (coefficientLeafMap (𝟙 Y) g)
  let k := T.map (coefficientLeafMap c (ell ≫ g))
  have hraw : coefficientLeafMap (𝟙 X) ell ≫
      (coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).map c ≫
        coefficientLeafMap (𝟙 Y) g = coefficientLeafMap c (ell ≫ g) := by
    rw [← coefficientLeafMap_idLeaves c (FiniteFamily.empty : FiniteFamily C)]
    simp only [coefficientLeafMap_comp, Category.id_comp, Category.comp_id]
  have hk : k = p ≫ v ≫ q := (congrArg T.map hraw.symm).trans
    (scalarMapThree T (coefficientLeafMap (𝟙 X) ell)
      ((coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).map c)
        (coefficientLeafMap (𝟙 Y) g))
  have hp : s ≫ n ≫ p = (emptyLeafTensorIso X).inv := Linear.UnitGeometry.emptyInterchange_hom L
  have hv : (emptyLeafTensorIso X).inv ≫ v = c ≫ (emptyLeafTensorIso Y).inv :=
    (emptyLeafTensorNatIso.inv.naturality c).symm
  exact scalarEmptyFiring s n p v q k (emptyLeafTensorIso X).inv c (emptyLeafTensorIso
    Y).inv hk hp hv

variable {W : Type u}

/-- An actual coefficient arrow into an original profile's empty
summand is its original coefficient arrow followed by the original
empty linear summand inverse, with every original leaf map retained. -/
theorem emptyLinearInsertion (O : ColoredSymmetricCollection W C) (B : W → C) (P : ColoredProfile W)
    {X : C} (c : X ⟶ O.obj P) :
    (emptyLeafTensorIso X).inv ≫
      (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map
        (c ≫ (O.mapIso (emptyExtensionProfileIso P)).inv) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
          (emptyAddedAlgebraInputsIso B).inv) =
    c ≫ (emptyLinearSummandIso O B P).inv := by
  let T := FiniteTensor.tensor (V := C)
  let a := (O.mapIso (emptyExtensionProfileIso P)).inv
  let Y := O.obj (extendProfile P emptyColoredInputs)
  let d := c ≫ a
  let e := (emptyLeafTensorIso Y).inv
  let f := T.map (emptyLinearFactorsIso O B P).inv
  let g := T.map (coefficientLeafMap (𝟙 Y) (emptyAddedAlgebraInputsIso B).inv)
  have hn : (emptyLeafTensorIso X).inv ≫
      (coefficientLeafTensorFunctor (FiniteFamily.empty : FiniteFamily C)).map d = d ≫ e :=
    (emptyLeafTensorNatIso.inv.naturality d).symm
  have hf : g = f := congrArg T.map (emptyLinearFactorsIso_inv O B P).symm
  have hr : (emptyLinearSummandIso O B P).inv = a ≫ e ≫ f :=
    scalarIsoInverseThree (T.mapIso (emptyLinearFactorsIso O B P)) (emptyLeafTensorIso Y)
      (O.mapIso (emptyExtensionProfileIso P))
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ g) hn).trans
      ((Category.assoc d e g).trans
        ((congrArg (d ≫ e ≫ ·) hf).trans (scalarEmptyFinish c a e f
          (emptyLinearSummandIso O B P).inv hr))))

/-- The original branch nullary inverse is the original coefficient
inverse tensor map with every original branch B-input map retained. -/
theorem branchLinearInsertion (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (R : AnalyticIndex W d) :
    (profileCoefficientLeafTensorIso O B R.toColoredProfile).inv ≫
      (coefficientLeafTensorFunctor (profileLeafFamily B R.toColoredProfile)).map
        (O.mapIso (nullaryVariableProfileComponentIso d (branchInputs R))).inv ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (O.obj (extendProfile (ColoredProfile.nullary d) (branchInputs R))))
          (branchInputLeafIso B R).hom) =
    (nullaryLinearDiagramIso O B d).inv.app (branchInputs R) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (profileOperationFactorsIso O B R.toColoredProfile).inv
  let c := (O.mapIso (nullaryVariableProfileComponentIso d (branchInputs R))).inv
  let g := (branchInputLeafIso B R).hom
  let b := (coefficientLeafTensorFunctor (profileLeafFamily B R.toColoredProfile)).map c
  let q := T.map (coefficientLeafMap (𝟙 (O.obj (extendProfile (ColoredProfile.nullary d)
    (branchInputs R)))) g)
  have hb : b ≫ q = T.map (coefficientLeafMap c g) := (T.map_comp _ _).symm.trans
    (congrArg T.map ((coefficientLeafMap_pre c (𝟙 _) g).trans
      (congrArg (fun c => coefficientLeafMap c g) (Category.comp_id c))))
  exact (congrArg (T.map a ≫ ·) hb).trans
    ((T.map_comp _ _).symm.trans (congrArg T.map (nullaryLinearFactorsIso_inv O B R)))


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
