literal dependent position under the actual empty-profile map. -/
theorem shapeHom_total (d : W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenTotalProfileHom (ColoredProfile.nullary d) Q R ≫
        nullaryVariableProfileHom d (frozenTotalInputs Q R) =
      ColoredSubstitutionData.totalProfileMap (shapeHom d Q R) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
