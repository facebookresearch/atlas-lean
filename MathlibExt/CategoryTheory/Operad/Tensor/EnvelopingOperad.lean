        (FiniteTensor.tensor (V := C)).map (retainedRootUnitFamilyIso (C := C)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let p := UnitInsertion.rightInsertPrefix (T.obj FiniteFamily.empty) (FintypeCat.of PUnit)
  let f := Unit.rightRootNormalizer (T.obj FiniteFamily.empty) (FintypeCat.of PUnit)
  let e := (retainedRootUnitFamilyIso (C := C)).hom
  have h : T.map f ≫ T.map e = T.map (retainedRootPrefixNormalizer (C := C)) :=
    (T.map_comp _ _).symm.trans (congrArg T.map (retainedRootPrefixNormalizer_readback (C := C)))
  have h1 : retainedRootUnitTensorSource (C := C) = (p ≫ T.map f) ≫ T.map e :=
    (congrArg (p ≫ ·) h.symm).trans (Category.assoc _ _ _).symm
  exact h1.trans (congrArg (· ≫ T.map e)
    (Unit.rightInsertPrefix_normalized (T.obj FiniteFamily.empty) (FintypeCat.of PUnit)) |>.trans
      (originalRootFourAssoc _ _ _ _))


