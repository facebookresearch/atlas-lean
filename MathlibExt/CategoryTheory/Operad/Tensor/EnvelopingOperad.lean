/-!
# Normalize the original weighted right unit insertion as one grouped route
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem rightPrefixFold {D : Type*} [Category* D]
    {Z A B C E F Y G H : D}
    (a : Z ⟶ A) (b : A ⟶ B) (p : B ⟶ C) (f : C ⟶ E) (n : E ⟶ F) (l : F ⟶ Y)
    (r : B ⟶ G) (s : G ⟶ H) (t : H ⟶ F) (u : H ⟶ Y) (m : A ⟶ G)
    (hp : p ≫ f ≫ n = r ≫ s ≫ t) (hl : t ≫ l = u) (hm : b ≫ r = m) :
    ((a ≫ b ≫ p) ≫ f) ≫ n ≫ l = a ≫ m ≫ s ≫ u := by
  calc
    ((a ≫ b ≫ p) ≫ f) ≫ n ≫ l = a ≫ b ≫ ((p ≫ f ≫ n) ≫ l) := by simp only [Category.assoc]
    _ = a ≫ b ≫ ((r ≫ s ≫ t) ≫ l) := congrArg (fun c => a ≫ b ≫ (c ≫ l)) hp
    _ = a ≫ b ≫ r ≫ s ≫ (t ≫ l) := by simp only [Category.assoc]
    _ = a ≫ b ≫ r ≫ s ≫ u := congrArg (fun c => a ≫ b ≫ r ≫ s ≫ c) hl
    _ = a ≫ (b ≫ r) ≫ s ≫ u := by simp only [Category.assoc]
    _ = a ≫ m ≫ s ≫ u := congrArg (fun c => a ≫ c ≫ s ≫ u) hm

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original weighted right unit-prefix route is its actual
grouped coefficient/input normalizer, retaining the original supplied
unit coefficients, every empty block, and the complete root leaf map. -/
theorem rightWeightedPrefix_grouped (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) (Y : I → C)
    (η : ∀ i, (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y i) :
    (UnitInsertion.rightInsertFromFactor ((coefficientLeafTensorFunctor L).obj X) I
        (rightWeightedFactor X L I Y η) ≫
      (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option I))
        (rightCoefficientFamily X I Y).obj (rightLeaves L I)).hom) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (𝟙 ((FiniteTensor.tensor (V := C)).obj (rightCoefficientFamily X I Y)))
        (rightLeavesIso L I).hom) =
    (FiniteTensor.singletonIso (V := C)).inv.app ((coefficientLeafTensorFunctor L).obj X) ≫
      (FiniteTensor.tensor (V := C)).map
        (UnitInsertion.rightSingletonToFlatten ((coefficientLeafTensorFunctor L).obj X) I ≫
          (FiniteFamily.flatten (C := C)).map (rightWeightedBlocksIso X L I).hom) ≫
      groupedCoefficientInputNormalization (UnitInsertion.rightNestedFamily X I)
        (rightAtomicInputs X L I) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (rightCoefficientFactor X I Y η))
        (rightGroupedLeavesIso X L I).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let N := UnitInsertion.rightNestedFamily X I
  let A := rightAtomicInputs X L I
  let Z := (coefficientLeafTensorFunctor L).obj X
  let P := UnitInsertion.rightNestedFamily Z I
  let K := rightCoefficientFamily X I Y
  let M := rightLeaves L I
  let e := rightWeightedBlocksIso X L I
  let k := (rightCoefficientFactor X I Y η).hom
  let ℓ := fun i => (rightBlockLeavesIso X L I i).hom
  let a := (FiniteTensor.singletonIso (V := C)).inv.app Z
  let b := T.map (UnitInsertion.rightSingletonToFlatten Z I)
  let p := (FiniteTensor.flattenIso (V := C)).hom.app P
  let f := T.map (rightWeightedFactor X L I Y η)
  let n := (coefficientBlockInterchangeTensorIso N.index K.obj M).hom
  let l := T.map (coefficientLeafMap (𝟙 (T.obj K)) (rightLeavesIso L I).hom)
  let r := T.map ((FiniteFamily.flatten (C := C)).map e.hom)
  let s := groupedCoefficientInputNormalization N A
  let c := T.map (rightCoefficientFactor X I Y η)
  let leaf := (FiniteFamily.flatten (C := C)).map (rightInputBlocksIso X L I).hom
  let t := T.map (coefficientLeafMap c leaf)
  let u := T.map (coefficientLeafMap c (rightGroupedLeavesIso X L I).hom)
  let m := T.map (UnitInsertion.rightSingletonToFlatten Z I ≫
    (FiniteFamily.flatten (C := C)).map e.hom)
  have hblock : (FiniteFamily.map T).map e.hom ≫ groupedCoefficientInputNormalizationMap N A ≫
      weightedInputBlockMap N.index k ℓ = rightWeightedFactor X L I Y η :=
        rightWeightedFactor_grouped X L I Y η
