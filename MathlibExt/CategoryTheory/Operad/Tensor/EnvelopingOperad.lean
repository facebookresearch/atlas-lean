/-!
# Complete original coefficient-prefix normalization

The exact raw-source comparison and original singleton normalization
identify the coefficient singleton prefix before the original branch fold.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual complete coefficient/leaf raw source retains the
original coefficient singleton prefix and original leaf-partition map. -/
theorem rawPrefix_coefficient_normalization (X : C) (B : W → C) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (rawPrefixSourceMap X B Q) ≫
        (FiniteTensor.tensor (V := C)).map
          (partitionedCoefficientLeavesSourceIso (UnitInsertion.rightNestedFamily X Q.index)
            (prefixLeaves B Q)).hom ≫
        coefficientLeavesNormalization
          ((FiniteFamily.flatten (C := C)).obj (UnitInsertion.rightNestedFamily X Q.index))
          (partitionedLeafFamily (UnitInsertion.rightNestedFamily X Q.index) (prefixLeaves B Q)) =
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          ((FiniteTensor.singletonIso (V := C)).inv.app X ≫
            (FiniteTensor.tensor (V := C)).map (UnitInsertion.rightSingletonToFlatten X Q.index))
          (prefixLeafIso X B Q).inv) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let L := (addedAlgebraInputs B).obj Q
  let N := UnitInsertion.rightNestedFamily X Q.index
  let V := partitionedLeafFamily N (prefixLeaves B Q)
  let h := UnitInsertion.rightSingletonToFlatten X Q.index
  let l := (prefixLeafIso X B Q).inv
  let p := rawPrefixSourceMap X B Q
  let q := (partitionedCoefficientLeavesSourceIso N (prefixLeaves B Q)).hom
  let d := FiniteFamily.mapSingletonFlattenIso.inv.app (prefixInputFamily X B Q) ≫
    F.map (singletonCoefficientLeavesIso X L).inv
  let m := F.map (coefficientLeavesNestedMap h l)
  let n := coefficientLeavesNormalization (F.obj N) V
  let n0 := coefficientLeavesNormalization ((FiniteFamily.singleton (C := C)).obj X) L
  let k := T.map (coefficientLeafMap (T.map h) l)
  have hp : p ≫ q = d ≫ m := (rawPrefixSource_comparison X B Q).trans
    (Category.assoc
      (FiniteFamily.mapSingletonFlattenIso.inv.app (prefixInputFamily X B Q))
      (F.map (singletonCoefficientLeavesIso X L).inv) m).symm
  have hn : T.map m ≫ n = n0 ≫ k := coefficientLeavesNormalization_naturality h l
  have hs : T.map d ≫ n0 = (coefficientLeafTensorFunctor L).map
    ((FiniteTensor.singletonIso (V := C)).inv.app X) :=
    singletonCoefficient_tensor_prefix X L
  have h1 : T.map p ≫ T.map q = T.map d ≫ T.map m :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hp).trans (T.map_comp _ _))
  have h2 : T.map p ≫ (T.map q ≫ n) = (T.map d ≫ n0) ≫ k :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ n) h1).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (T.map d ≫ ·) hn).trans (Category.assoc _ _ _).symm)))
  have h3 : (coefficientLeafTensorFunctor L).map ((FiniteTensor.singletonIso (V :=
    C)).inv.app X) ≫ k =
      T.map (coefficientLeafMap
        ((FiniteTensor.singletonIso (V := C)).inv.app X ≫ T.map h) l) :=
    (T.map_comp _ _).symm.trans
      (congrArg T.map (coefficientLeafMap_pre ((FiniteTensor.singletonIso (V :=
        C)).inv.app X) (T.map h) l))
  exact h2.trans ((congrArg (· ≫ k) hs).trans h3)

/-- Appending the actual right prefix and original retained coefficient
factor map gives the whole original coefficient insertion with unchanged
original partitioned leaves. -/
theorem rawPrefix_full_coefficient_normalization (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (rawPrefixSourceMap (O.toCollection.obj
      (extendProfile P Q)) B Q) ≫
      (FiniteTensor.tensor (V := C)).map
        (partitionedCoefficientLeavesSourceIso
          (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index)
          (prefixLeaves B Q)).hom ≫
      coefficientLeavesNormalization
        ((FiniteFamily.flatten (C := C)).obj
          (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index))
        (partitionedLeafFamily (UnitInsertion.rightNestedFamily (O.toCollection.obj
          (extendProfile P Q)) Q.index)
          (prefixLeaves B Q)) ≫
      (coefficientLeafTensorFunctor
        (partitionedLeafFamily (UnitInsertion.rightNestedFamily (O.toCollection.obj
          (extendProfile P Q)) Q.index)
          (prefixLeaves B Q))).map
        ((FiniteTensor.flattenIso (V := C)).hom.app
            (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index) ≫
          (FiniteTensor.tensor (V := C)).map (unaryCoefficientUnitFactorMap O P Q)) =
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (unaryCoefficientUnitInsertion O P Q)
          (prefixLeafIso (O.toCollection.obj (extendProfile P Q)) B Q).inv) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let N := UnitInsertion.rightNestedFamily X Q.index
  let V := partitionedLeafFamily N (prefixLeaves B Q)
  let a := (FiniteTensor.singletonIso (V := C)).inv.app X ≫
    T.map (UnitInsertion.rightSingletonToFlatten X Q.index)
  let b := (FiniteTensor.flattenIso (V := C)).hom.app N ≫
    T.map (unaryCoefficientUnitFactorMap O P Q)
  let l := (prefixLeafIso X B Q).inv
  let p := T.map (rawPrefixSourceMap X B Q)
  let q := T.map (partitionedCoefficientLeavesSourceIso N (prefixLeaves B Q)).hom
  let n := coefficientLeavesNormalization ((FiniteFamily.flatten (C := C)).obj N) V
  let k := (coefficientLeafTensorFunctor V).map b
  have hp := rawPrefix_coefficient_normalization X B Q
  have hq : T.map (coefficientLeafMap a l) ≫ (coefficientLeafTensorFunctor V).map b =
      T.map (coefficientLeafMap (a ≫ b) l) :=
    (T.map_comp _ _).symm.trans (congrArg T.map (coefficientLeafMap_post a b l))
  have hu : a ≫ b = unaryCoefficientUnitInsertion O P Q := by
    let u := (FiniteTensor.singletonIso (V := C)).inv.app X
    let v := T.map (UnitInsertion.rightSingletonToFlatten X Q.index)
    let w := (FiniteTensor.flattenIso (V := C)).hom.app N
    let z := T.map (unaryCoefficientUnitFactorMap O P Q)
    exact (Category.assoc (u ≫ v) w z).symm.trans (congrArg (· ≫ z) (Category.assoc u v w))
  have ha : p ≫ q ≫ n ≫ k = (p ≫ q ≫ n) ≫ k :=
    (congrArg (p ≫ ·) (Category.assoc q n k).symm).trans (Category.assoc p (q ≫ n) k).symm
  exact ha.trans
    ((congrArg (· ≫ k) hp).trans
      (hq.trans (congrArg (fun x => T.map (coefficientLeafMap x l)) hu)))


end CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

end
end EnvelopingSource287

