set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory

variable {W : Type u}

local instance (d : W) : IsEmpty (ColoredProfile.nullary d).inputs :=
  inferInstanceAs (IsEmpty (Fin 0))

/-- Delete the actual empty variable block, retaining every
original inner operation at its original added-algebra input. -/
def shapeHom (d : W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenSubstitution (ColoredProfile.nullary d) Q R ⟶
      tupleSubstitutionShape ((inputsToProfile d).obj Q) R where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.emptySum (Fin 0) Q.index
      hom p := match p with
        | Sum.inl p => Fin.elim0 p
        | Sum.inr j => 𝟙 ((R j).toColoredProfile) }

