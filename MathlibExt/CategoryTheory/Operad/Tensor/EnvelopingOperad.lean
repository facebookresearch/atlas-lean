namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem normalizeRawWeighted {D : Type*} [Category* D] {A B C E F G H : D}
    (p : A ⟶ B) (a : B ⟶ C) (b : C ⟶ E) (i : B ⟶ F) (c : F ⟶ E)
    (n' : E ⟶ G) (n : F ⟶ H) (k : H ⟶ G)
    (ha : a ≫ b = i ≫ c) (hn : c ≫ n' = n ≫ k) :
    (p ≫ a) ≫ b ≫ n' = (p ≫ i ≫ n) ≫ k := by
  calc
    (p ≫ a) ≫ b ≫ n' = p ≫ (a ≫ b) ≫ n' := by simp only [Category.assoc]
    _ = p ≫ (i ≫ c) ≫ n' := congrArg (fun e => p ≫ e ≫ n') ha
    _ = p ≫ i ≫ (c ≫ n') := by simp only [Category.assoc]
    _ = p ≫ i ≫ (n ≫ k) := congrArg (p ≫ i ≫ ·) hn
    _ = (p ≫ i ≫ n) ≫ k := by simp only [Category.assoc]

private theorem postInputNormalization {D : Type*} [Category* D] {X A B C E F : D}
    (w : X ⟶ A) (r : A ⟶ B) (n : B ⟶ C) (e : C ⟶ E) (i : X ⟶ F) (k : F ⟶ C) (a : F ⟶ E)
    (hp : w ≫ r ≫ n = i ≫ k) (he : k ≫ e = a) : w ≫ (r ≫ n ≫ e) = i ≫ a := by
  calc
    w ≫ (r ≫ n ≫ e) = (w ≫ r ≫ n) ≫ e := by simp only [Category.assoc]
    _ = (i ≫ k) ≫ e := congrArg (· ≫ e) hp
    _ = i ≫ a := (Category.assoc i k e).trans (congrArg (i ≫ ·) he)

private theorem separateOutside {D : Type*} [Category* D] {X A B C E F G H J : D}
    (w : X ⟶ A) (r : A ⟶ B) (n : B ⟶ C) (e : C ⟶ E) (i : E ⟶ F) (a : F ⟶ G) (s :
      G ⟶ H) (t : H ⟶ J) :
    w ≫ ((r ≫ n ≫ e ≫ i ≫ a) ≫ s ≫ t) = (w ≫ (r ≫ n ≫ e)) ≫ (i ≫ a
      ≫ s ≫ t) := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual weighted coefficient source, raw coefficient permutation
and original normalization retain exactly the original block interchange and original
dependent leaf maps. -/
theorem weightedCoefficientNormalization (E : ColoredSymmetricCollection W C) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (weightedSourceToRawIso E s Q).hom ≫ (FiniteTensor.tensor (V :=
      C)).map (rawInputIso E s Q).hom ≫
      coefficientLeavesNormalization (envelopingRepresentativeCoefficients E s Q)
        (totalLeaves E s Q) =
    (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
      (fun i => E.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
      (fun i => (addedAlgebraInputs (nullaryCarrier E)).obj (Q i))).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso E s Q).hom)
        (envelopingAlgebraLeafIso (nullaryCarrier E) s Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option s.inner.index)
  let K := fun i => E.obj (extendProfile (envelopingSlotProfile s i) (Q i))
  let L := fun i => (addedAlgebraInputs (nullaryCarrier E)).obj (Q i)
  let p := (FiniteTensor.flattenIso (V := C)).inv.app (weightedBlocks E s Q)
  let a := T.map (weightedRawIsoA E s Q).hom
  let b := T.map (rawInputIso E s Q).hom
  let i := T.map (coefficientBlockInterchangeFamilyIso I K L).hom
  let f := (envelopingCoefficientBlockIso E s Q).hom
  let ℓ := (envelopingAlgebraLeafIso (nullaryCarrier E) s Q).hom
  let c := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap f ℓ))
  let n' := coefficientLeavesNormalization (envelopingRepresentativeCoefficients E s Q)
    (totalLeaves E s Q)
  let n := coefficientLeavesNormalization (coefficientBlockFamily I K) (totalBlockInputs I L)
  let k := T.map (coefficientLeafMap (T.map f) ℓ)
  let i₀ := (coefficientBlockInterchangeTensorIso I K L).hom
  have ha : a ≫ b = i ≫ c := (T.map_comp _ _).symm.trans
    ((congrArg T.map (rawInputIso_original E s Q)).trans (T.map_comp _ _))
  have hn : c ≫ n' = n ≫ k := coefficientLeavesNormalization_naturality f ℓ
  have hi : i₀ = p ≫ i ≫ n := congrArg (fun f => p ≫ i ≫ f)
    (coefficientLeavesNormalizationIso_hom (coefficientBlockFamily I K) (totalBlockInputs I L))
  exact (normalizeRawWeighted p a b i c n' n k ha hn).trans (congrArg (· ≫ k) hi.symm)

/-- The original weighted evaluation is exactly the original raw
coefficient normalization followed by the original coefficient substitution. -/
theorem weightedCoefficientNormalization_evaluation (E : ColoredOperadObj W C) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (weightedSourceToRawIso E.toCollection s Q).hom ≫
      ((FiniteTensor.tensor (V := C)).map (rawInputIso E.toCollection s Q).hom ≫
        coefficientLeavesNormalization (envelopingRepresentativeCoefficients E.toCollection
          s Q) (totalLeaves
          E.toCollection s Q) ≫
        (coefficientLeafTensorFunctor (totalLeaves E.toCollection s Q)).map
          (envelopingRepresentativeCoefficientSubstitution E s Q)) =
      envelopingRepresentativeEvaluation E (nullaryCarrier E.toCollection) s Q := by
  let T := FiniteTensor.tensor (V := C)
  let L := totalLeaves E.toCollection s Q
  let w := (weightedSourceToRawIso E.toCollection s Q).hom
  let r := T.map (rawInputIso E.toCollection s Q).hom
  let n := coefficientLeavesNormalization (envelopingRepresentativeCoefficients
    E.toCollection s Q) L
  let e := (coefficientLeafTensorFunctor L).map
    (envelopingRepresentativeCoefficientSubstitution E s Q)
  let i := (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
    (fun i => E.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (fun i => (addedAlgebraInputs (nullaryCarrier E.toCollection)).obj (Q i))).hom
  let f := T.map (envelopingCoefficientBlockIso E.toCollection s Q).hom
  let ℓ := (envelopingAlgebraLeafIso (nullaryCarrier E.toCollection) s Q).hom
  let k := T.map (coefficientLeafMap f ℓ)
  let a := T.map (coefficientLeafMap (f ≫ envelopingRepresentativeCoefficientSubstitution E s Q) ℓ)
  have he : k ≫ e = a := (T.map_comp _ _).symm.trans
    (congrArg T.map (coefficientLeafMap_post f
      (envelopingRepresentativeCoefficientSubstitution E s Q) ℓ))
  exact postInputNormalization w r n e i k a (weightedCoefficientNormalization
    E.toCollection s Q) he

/-- The root-first raw branch route is literally the original weighted
representative evaluation followed by the original constants evaluator. -/
theorem weightedOutsideRoute_original (E : ColoredOperadObj W C) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (weightedSourceToRawIso E.toCollection s Q).hom ≫ outsideRoute E s Q =
      envelopingRepresentativeEvaluation E (nullaryCarrier E.toCollection) s Q ≫
        Constants.representative (𝟙 E) (nullaryCarrier E.toCollection)
          (fun c => 𝟙 (E.toCollection.obj (ColoredProfile.nullary c))) s.totalProfile
            (envelopingTotalAlgebraInputs s Q)
            := by
  let T := FiniteTensor.tensor (V := C)
  let P := s.totalProfile
  let Q' := envelopingTotalAlgebraInputs s Q
  let w := (weightedSourceToRawIso E.toCollection s Q).hom
  let r := T.map (rawInputIso E.toCollection s Q).hom
  let n := coefficientLeavesNormalization (envelopingRepresentativeCoefficients
    E.toCollection s Q) (totalLeaves
    E.toCollection s Q)
  let e := (coefficientLeafTensorFunctor (totalLeaves E.toCollection s Q)).map
    (envelopingRepresentativeCoefficientSubstitution E s Q)
  let i := T.map (nullaryInputCoefficientIso E.toCollection P Q').hom
  let a := frozenSubstitutionCoefficientTensorMap E P Q' (Constants.branches Q')
  let σ := E.subst.app (frozenSubstitution P Q' (Constants.branches Q'))
  let t := E.toCollection.map (Constants.substitutionTotalHom P Q')
  have htail : i ≫ a ≫ σ ≫ t = Constants.representative (𝟙 E) (nullaryCarrier E.toCollection)
      (fun c => 𝟙 (E.toCollection.obj (ColoredProfile.nullary c))) P Q' :=
    (congrArg (fun f => T.map f ≫ a ≫ σ ≫ t) (nullaryInputCoefficientIso_hom E P Q')).trans
      (Constants.representative_source E E (𝟙 E) (nullaryCarrier E.toCollection)
        (fun c => 𝟙 (E.toCollection.obj (ColoredProfile.nullary c))) P Q').symm
  exact (separateOutside w r n e i a σ t).trans
    (congrArg₂ (· ≫ ·) (weightedCoefficientNormalization_evaluation E s Q) htail)


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

