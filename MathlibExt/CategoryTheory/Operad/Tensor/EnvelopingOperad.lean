arrows give a genuine functor to original O-algebras under A. -/
def envelopingUnderAFunctor (O : ColoredOperadObj W C) (A : Algebra O) :
    Algebra (envelopingOperad O A) ⥤ Under A where
  obj := envelopingUnderAObject O A
  map := envelopingUnderAMap O A
  map_id M := by
    apply Under.UnderMorphism.ext
    apply Algebra.Hom.ext
    rfl
  map_comp f g := by
    apply Under.UnderMorphism.ext
    apply Algebra.Hom.ext
    rfl


