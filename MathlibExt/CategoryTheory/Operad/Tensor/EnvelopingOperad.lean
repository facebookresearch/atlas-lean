  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option d.branches.index)
  let K : I → C := envelopingAssocCoefficientBlockTensors O.toCollection d Q
  let K' : I → C := fun i => O.toCollection.obj
    (extendProfile (envelopingSlotProfile d.outerAfterInnerData i)
      (envelopingAssocOuterChoices d Q i))
  let L : I → FiniteFamily C := fun i => (envelopingAssocLeafBlocks B d Q).obj i
  let L' : I → FiniteFamily C := fun i => (addedAlgebraInputs B).obj
    (envelopingAssocOuterChoices d Q i)
