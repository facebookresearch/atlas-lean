    (h : A.action ≫ linearAlgebraConstants O A.carrier M =
      profileMap O.toCollection (linearAlgebraConstants O A.carrier M) ≫
        (linearAlgebraUnderlying O A.carrier M).action)
        :
    ColoredOperadObj.Reflexive.AlgebraDescent.Balanced
      (constantRelationOperadFace O A.carrier) (algebraRelationOperadFace O A) M := by
  let B := profileCoinvariants O.toCollection A.carrier
  let MS := Algebra.restrict (constantRelationOperadFace O A.carrier) M
  let MK := Algebra.restrict (algebraRelationOperadFace O A) M
  let MO := linearAlgebraUnderlying O A.carrier M
  have hc : linearAlgebraConstants O B MS = linearAlgebraConstants O B MK :=
    (substitutionRestriction_constants O A.carrier M).trans (h.symm.trans
      (actionRestriction_constants O A M).symm)
  have hs := linearAlgebra_operations O B MS
  have hk := linearAlgebra_operations O B MK
  have hus : linearAlgebraUnderlying O B MS = MO := substitutionRestriction_underlying O A.carrier M
  have huk : linearAlgebraUnderlying O B MK = MO := actionRestriction_underlying O A M
  have hos := eq_of_heq (reconstructedOperations_heq O B (linearAlgebraUnderlying O B MS) MO hus
