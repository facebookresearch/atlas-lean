    · intro i
      cases i with
      | none => exact heq_of_eq (Category.id_comp (𝟙 X))
      | some i => exact Fin.elim0 i
  inv_hom_id := by
    apply FiniteFamily.Hom_ext
    · exact nilOptionEquiv.symm_trans_self
    · intro i
      cases i
      exact heq_of_eq (Category.id_comp (𝟙 X))

