/-!
# Variable-profile maps on original weighted root and leaf families

The root coefficient uses the full original extended-profile map. Every
original supplied algebra branch and every algebra leaf remains present.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Variable

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original variable-profile map on the weighted root coefficient
and all retained original weighted branch tensors. -/
def weightedBranchMap (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O B P Q R ⟶ frozenWeightedBranchFamily O B P' Q R where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => O.map (extendProfileMap f (𝟙 Q))
    | some j => 𝟙 ((analyticSummand O B).obj (R j))

/-- Expand the original root through its actual singleton map, while
retaining every supplied original branch factor and input object. -/
def weightedNestedMap (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedNestedFamily O B P Q R ⟶ frozenWeightedNestedFamily O B P' Q R where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => (FiniteFamily.singleton (C := C)).map (O.map (extendProfileMap f (𝟙 Q)))
    | some j => 𝟙 ((analyticFactors O B).obj (R j))

/-- The actual singleton root comparison commutes with every
original variable-profile coefficient map and retained branch tensor. -/
theorem weightedRootIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenWeightedRootIso O B P Q R).hom ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (weightedNestedMap O B f Q R) =
      weightedBranchMap O B f Q R ≫ (frozenWeightedRootIso O B P' Q R).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq ((FiniteTensor.singletonIso (V := C)).inv.app (O.obj (extendProfile P Q)) ≫
        (FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.singleton (C := C)).map (O.map (extendProfileMap f (𝟙 Q)))))
        (O.map (extendProfileMap f (𝟙 Q)) ≫
          (FiniteTensor.singletonIso (V := C)).inv.app (O.obj (extendProfile P' Q)))
      exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).inv.naturality
        (O.map (extendProfileMap f (𝟙 Q)))).symm
    | some j =>
      change HEq (𝟙 _ ≫ (FiniteTensor.tensor (V := C)).map (𝟙 ((analyticFactors O B).obj (R j))))
        (𝟙 _ ≫ 𝟙 _)
      exact heq_of_eq (congrArg (𝟙 _ ≫ ·) ((FiniteTensor.tensor (V := C)).map_id _))

omit [FiniteTensor C] in
/-- The exact original coefficient/leaf bijection commutes with the
original variable-profile map on the retained root coefficient, while
all original branch coefficients and algebra-leaf objects are retained. -/
theorem branchLeafIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).map (weightedNestedMap O B f Q R) ≫
        (frozenBranchLeafIso O B P' Q R).hom =
      (frozenBranchLeafIso O B P Q R).hom ≫ (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (coefficientMap O f Q R) (𝟙 (frozenAlgebraLeaves B Q R))) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap f (𝟙 Q)) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap f (𝟙 Q)))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      cases j with
      | none => rfl
      | some j => rfl


