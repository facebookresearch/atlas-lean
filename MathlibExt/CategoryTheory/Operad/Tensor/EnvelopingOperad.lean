/-!
# The actual grouped normalizer with its complete coefficient and leaf maps
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

private theorem associateTail {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual grouped-to-flat bridge retains any complete coefficient
map and any whole heterogeneous leaf map after genuine coefficient unflattening. -/
theorem normalizeGroupedAfterCoefficientMap (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C)
    {Y : C} (k : (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj N) ⟶ Y)
    {M : FiniteFamily C} (f : groupedCoefficientInputLeaves N L ⟶ M) :
    groupedCoefficientInputNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.flattenIso (V := C)).inv.app N ≫ k) f) =
    Grouping.flatAtomicNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap k f) := by
  let T := FiniteTensor.tensor (V := C)
  let G := groupedCoefficientInputLeaves N L
  let c := (FiniteTensor.flattenIso (V := C)).inv.app N
  let p := (coefficientLeafTensorFunctor G).map c
  let q := T.map (coefficientLeafMap k f)
  have hf : (coefficientLeafFamilyFunctor G).map c ≫ coefficientLeafMap k f =
      coefficientLeafMap (c ≫ k) f := coefficientLeafMap_pre c k f
  have ht : T.map (coefficientLeafMap (c ≫ k) f) = p ≫ q :=
    (congrArg T.map hf.symm).trans (T.map_comp _ _)
  have hn := Grouping.normalize_grouped_inputs N L
  exact (congrArg (groupedCoefficientInputNormalization N L ≫ ·) ht).trans
    ((Category.assoc (groupedCoefficientInputNormalization N L) p q).symm.trans
      (congrArg (· ≫ q) hn))

/-- The complete original leaf correction commutes with genuine
coefficient unflattening and the actual flat atomic normalizer. -/
theorem normalizeGroupedAfterLeafMap (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C)
    {M : FiniteFamily C} (f : groupedCoefficientInputLeaves N L ⟶ M) :
    groupedCoefficientInputNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.flattenIso (V := C)).inv.app N) f) =
    Grouping.flatAtomicNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          (𝟙 ((FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj N))) f) := by
  let T := FiniteTensor.tensor (V := C)
  let c := (FiniteTensor.flattenIso (V := C)).inv.app N
  have h := normalizeGroupedAfterCoefficientMap N L
    (𝟙 (T.obj ((FiniteFamily.flatten (C := C)).obj N))) f
  have hc := congrArg
    (fun k => groupedCoefficientInputNormalization N L ≫ T.map (coefficientLeafMap k f))
    (Category.comp_id c)
  exact hc.symm.trans h

/-- The actual flat atomic route followed by complete original
coefficient and leaf maps retains the literal atomic source comparison
and its original dependent leaf correction. -/
theorem flatAtomicAfterCoefficientMap (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C)
    {Y : C} (k : (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj N) ⟶ Y)
    {M : FiniteFamily C} (f : groupedCoefficientInputLeaves N L ⟶ M) :
    Grouping.flatAtomicNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap k f) =
    (FiniteTensor.tensor (V := C)).map (Grouping.atomicWeightedIso N L).hom ≫
      (coefficientBlockInterchangeTensorIso ((FiniteFamily.flatten (C := C)).obj N).index
        ((FiniteFamily.flatten (C := C)).obj N).obj L).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap k ((Grouping.atomicLeafIso N L).hom ≫ f)) := by
  let T := FiniteTensor.tensor (V := C)
  let K := (FiniteFamily.flatten (C := C)).obj N
  let a := T.map (Grouping.atomicWeightedIso N L).hom
  let b := (coefficientBlockInterchangeTensorIso K.index K.obj L).hom
  let j := (Grouping.atomicLeafIso N L).hom
  let c := T.map (coefficientLeafMap (𝟙 (T.obj K)) j)
  let d := T.map (coefficientLeafMap k f)
  have hf : coefficientLeafMap (𝟙 (T.obj K)) j ≫ coefficientLeafMap k f =
      coefficientLeafMap k (j ≫ f) :=
    (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg (fun c => coefficientLeafMap c (j ≫ f)) (Category.id_comp k))
  have ht : c ≫ d = T.map (coefficientLeafMap k (j ≫ f)) :=
    (T.map_comp _ _).symm.trans (congrArg T.map hf)
  exact (associateTail a b c d).trans (congrArg (fun h => a ≫ b ≫ h) ht)


