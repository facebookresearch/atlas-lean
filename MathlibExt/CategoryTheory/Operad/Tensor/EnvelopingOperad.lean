        (hn.trans (congrArg (fun f => n₀ ≫ T.map f) hf)))

/-- Every original root-first weighted block normalizes by the
actual grouped normalization with its original middle or inner leaf map.
Each original innermost singleton uses the genuine weighted singleton law. -/
theorem weightedBlockNormalizationMapB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
