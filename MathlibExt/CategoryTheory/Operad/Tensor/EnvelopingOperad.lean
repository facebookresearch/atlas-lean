  have hblock : inputBlockMap I l = (envelopingAssocRootFirstInputBlockIso B d Q).hom := rfl
  have hleaf : (FiniteFamily.flatten (C := C)).map (inputBlockMap I l) =
      (envelopingAssocRootFirstLeafComparisonIso B d Q).hom := congrArg
    (FiniteFamily.flatten (C := C)).map hblock
