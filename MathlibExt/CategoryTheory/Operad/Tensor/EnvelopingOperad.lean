and every surviving variable leaf uses its original identity map. -/
def evaluationLeafMap (B M : W → C) (g : B ⟶ M) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    evaluationLeafFamily B M s Q ⟶ profileLeafFamily M
      (envelopingRepresentativeSubstitution s Q).totalProfile where
  equiv := evaluationLeafEquiv B M s Q
  hom p := match p with
    | Sum.inl (Sum.inl j) => g ((Q none).obj j).as
    | Sum.inl (Sum.inr ⟨i, j⟩) => g ((Q (some i)).obj j).as
    | Sum.inr ⟨i, j⟩ => 𝟙 (M ((s.inner.obj i).inputColor j))

/-- The actual original coefficient/B/variable source positions
are the full original O-coefficient block with all original leaves. -/
def evaluationRawSourceEquiv (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (substitutionExpandedFamily O B M s Q).index ≃
      ((FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (envelopingRepresentativeCoefficients O s Q)
          (evaluationLeafFamily B M s Q))).index where
  toFun p := match p with
    | ⟨none, ⟨i, none⟩⟩ => ⟨none, i⟩
    | ⟨none, ⟨none, some j⟩⟩ => ⟨some (Sum.inl (Sum.inl j)), PUnit.unit⟩
    | ⟨none, ⟨some i, some j⟩⟩ => ⟨some (Sum.inl (Sum.inr ⟨i, j⟩)), PUnit.unit⟩
    | ⟨some p, _⟩ => ⟨some (Sum.inr p), PUnit.unit⟩
  invFun p := match p with
    | ⟨none, i⟩ => ⟨none, ⟨i, none⟩⟩
    | ⟨some (Sum.inl (Sum.inl j)), _⟩ => ⟨none, ⟨none, some j⟩⟩
    | ⟨some (Sum.inl (Sum.inr ⟨i, j⟩)), _⟩ => ⟨none, ⟨some i, some j⟩⟩
    | ⟨some (Sum.inr p), _⟩ => ⟨some p, PUnit.unit⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => rcases j with ⟨i, j⟩; cases i <;> cases j <;> rfl
    | some i => cases j; rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j; cases i with
      | inl i => cases i <;> rfl
      | inr i => rfl

/-- Every original coefficient and original leaf object is retained
under the exact common-source coefficient/leaf bijection. -/
def evaluationRawSourceIso (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    substitutionExpandedFamily O B M s Q ≅
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (envelopingRepresentativeCoefficients O s Q)
          (evaluationLeafFamily B M s Q)) :=
  FiniteFamily.isoOfComponents (evaluationRawSourceEquiv O B M s Q)
    (fun p => match p with
      | ⟨none, ⟨none, none⟩⟩ => Iso.refl (O.obj (extendProfile s.outerProfile (Q none)))
      | ⟨none, ⟨some i, none⟩⟩ => Iso.refl (O.obj (extendProfile (s.inner.obj i) (Q (some i))))
      | ⟨none, ⟨none, some j⟩⟩ => Iso.refl (B ((Q none).obj j).as)
      | ⟨none, ⟨some i, some j⟩⟩ => Iso.refl (B ((Q (some i)).obj j).as)
      | ⟨some p, _⟩ => Iso.refl (M (s.totalProfile.inputColor p)))


