/-- The original variable-profile permutation and every original
input-color transport commute with the actual constant-input map g. -/
theorem representativeFactors_variable (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) {d : W} {P P' : AnalyticIndex W d} (f : P ⟶ P') (Q : ColoredInputs W) :
