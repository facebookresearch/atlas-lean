      exact heq_of_eq (tensorLeafMap_id
        (O.obj (extendProfile ((d.middleData).inner.obj i) (Q.branch i none)))
        ((addedAlgebraInputs B).obj (Q.branch i none))).symm

/-- Every original branch-first weighted block normalizes by the
actual grouped coefficient/input normalization and its original leaf map.
The root uses the genuine original weighted singleton tensor law. -/
theorem weightedBlockNormalizationMapA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (weightedBlocksIsoA O B d Q).hom ≫
      groupedCoefficientInputNormalizationMap (envelopingAssocCoefficientBlocks O d Q)
        (coefficientInputsA O B d Q) ≫
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (evaluatedBlocksIsoA O B d Q).hom =
      (envelopingAssocWeightedBlockTensorIso O B d Q).hom := by
