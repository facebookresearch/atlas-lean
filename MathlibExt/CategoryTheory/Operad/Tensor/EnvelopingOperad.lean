      (FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C := C)).obj (E.obj P))) ≫
      (FiniteTensor.singletonIso (V := C)).hom.app (E.obj P) ≫ E.map (𝟙 P) =
        (FiniteTensor.singletonIso (V := C)).hom.app (E.obj P) := by
