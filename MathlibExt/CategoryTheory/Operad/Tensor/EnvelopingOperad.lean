/- Exact checked source: LinearAlgebra.ExpandedSource. -/
section EnvelopingSource225


/-!
# The original coefficient, constant, and variable tensor source for algebra substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original coefficient and all original B-inputs at every
root/inner slot, before applying their original finite tensor. -/
def substitutionInputBlocks (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) : FiniteFamily
      (FiniteFamily C) where
  index := FintypeCat.of (Option s.inner.index)
  obj i := (coefficientInputFactors (extendedCoefficient O (envelopingSlotProfile s i))
    (addedAlgebraInputs B)).obj (Q i)

/-- Each original slot tensor is exactly the original weighted
representative coefficient/B-input object, with identity components. -/
def substitutionWeightedBlocksIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (substitutionInputBlocks O B s Q) ≅
      envelopingWeightedRepresentativeFamily O B s Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun _ => Iso.refl _)

/-- The actual flattened coefficient and B-input tensor retains
every original root/inner/constant input position. -/
def substitutionCoefficientInputs (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (substitutionInputBlocks O B s Q)

/-- The complete original coefficient/B-input blocks and original
M-variable singleton blocks, with their actual dependent positions. -/
def substitutionExpandedFamily (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj
    (coefficientLeavesNested (substitutionCoefficientInputs O B s Q) (profileLeafFamily M
      s.totalProfile))

/-- The exact original joint representative tensor, including every
unchanged variable leaf, expands by original finite flattening and
coefficient/leaf normalization only. -/
def substitutionExpandedSourceIso (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).obj
        ((FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily O B s Q)) ≅
      (FiniteTensor.tensor (V := C)).obj (substitutionExpandedFamily O B M s Q) :=
  (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).mapIso
    ((FiniteTensor.tensor (V := C)).mapIso (substitutionWeightedBlocksIso O B s Q)).symm ≪≫
  (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).mapIso
    ((FiniteTensor.flattenIso (V := C)).app (substitutionInputBlocks O B s Q)).symm ≪≫
  (coefficientLeavesNormalizationIso (substitutionCoefficientInputs O B s Q)
    (profileLeafFamily M s.totalProfile)).symm


