  · ext i
    exact isEmptyElim i
  · intro i
    exact isEmptyElim i

/-- The actual tensor of the original empty/singleton triple
is exactly the original tensor of the retained block map,
by the genuine singleton-flatten law and actual empty tensor coherence. -/
theorem emptyAndRetainedTriple_tensor (I : FintypeCat.{0}) (N : FiniteFamily (FiniteFamily C)) :
    (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app (emptyAndRetainedTriple I N) ≫
        emptyAndRetainedTripleTensorMap I N =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (emptyAndRetainedTripleMap I N) ≫
        (emptyAndRetainedTensorIso I N).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro p
    cases p with
    | inl i =>
      let E := (FiniteFamily.empty : FiniteFamily (FiniteFamily C))
      have : IsEmpty E.index := inferInstanceAs (IsEmpty Empty)
      have : IsEmpty ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj E).index :=
        inferInstanceAs (IsEmpty Empty)
      have : IsEmpty ((FiniteFamily.flatten (C := C)).obj E).index :=
        { false p := p.1.elim }
      have hl : (mapEmptyFamilyIso (FiniteTensor.tensor (V := C))).hom =
          Unit.emptyFamilyHom ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj E) :=
        retainedEmptyMapUnique _ _ _
      have hr : (flattenEmptyFamilyIso (C := C)).hom =
          Unit.emptyFamilyHom ((FiniteFamily.flatten (C := C)).obj E) :=
        retainedEmptyMapUnique _ _ _
      exact heq_of_eq (by
        have h := Unit.flatten_empty_tensor E
        have h1 := congrArg (fun f => (FiniteTensor.flattenIso (V := C)).hom.app E ≫
          (FiniteTensor.tensor (V := C)).map f) hl
        have h2 := congrArg (FiniteTensor.tensor (V := C)).map hr
