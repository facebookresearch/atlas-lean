          change HEq (𝟙 X ≫ E.toCollection.map (𝟙 (ColoredProfile.nullary c))) (𝟙 X ≫ 𝟙 X)
          exact heq_of_eq (congrArg (𝟙 X ≫ ·) (E.toCollection.map_id (ColoredProfile.nullary c)))

/-- Original finite tensor coherence erases precisely the original empty
P-prefix and keeps the original root/constant map into the original left-unit source. -/
theorem generatorFrozenTensor_compare (E : ColoredOperadObj W C) (c : W) :
    frozenSubstitutionCoefficientTensorMap E (ColoredProfile.nullary c) (generatorInputs c)
      (branches (generatorInputs
      c)) ≫
      (FiniteTensor.tensor (V := C)).map ((ColoredOperadObj.substitutionFactors
        E.toCollection).map (generatorShapeMap
        c)) =
    (FiniteTensor.tensor (V := C)).map (generatorLeftCoefficient E c) := by
