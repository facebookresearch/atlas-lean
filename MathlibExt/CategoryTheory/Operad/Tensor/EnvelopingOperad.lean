/-!
# The actual original unquotiented linear coefficient operad
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The genuine original linear coefficient operad before imposing
algebra relations. Its literal original collection, unit and natural
substitution maps satisfy both unit laws and full colored association. -/
def envelopingLinearOperad (O : ColoredOperadObj W C) (B : W → C) : ColoredOperadObj W C where
  toCollection := linearCoefficientCollection O.toCollection B
  unit := envelopingLinearUnit O B
  subst := envelopingLinearSubstitutionMap O B
  right_unit := envelopingLinearSubstitution_right_unit O B
  left_unit := envelopingLinearSubstitution_left_unit O B
  assoc := envelopingLinearSubstitution_assoc O B

theorem envelopingLinearOperad_collection (O : ColoredOperadObj W C) (B : W → C) :
    (envelopingLinearOperad O B).toCollection = linearCoefficientCollection O.toCollection B := rfl

theorem envelopingLinearOperad_subst (O : ColoredOperadObj W C) (B : W → C) :
    (envelopingLinearOperad O B).subst = envelopingLinearSubstitutionMap O B := rfl

theorem envelopingLinearOperad_subst_app (O : ColoredOperadObj W C) (B : W → C)
    (s : ColoredSubstitutionData W) :
    (envelopingLinearOperad O B).subst.app s = envelopingLinearSubstitution O B s := rfl

theorem envelopingLinearOperad_unit (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    (envelopingLinearOperad O B).unit c =
      O.unit c ≫ originalOperationToLinear O.toCollection B
        (ColoredSubstitutionData.unitProfile c) := rfl

theorem envelopingLinearOperad_unit_empty_summand (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    (envelopingLinearOperad O B).unit c =
      O.unit c ≫ ((emptyLinearSummandIso O.toCollection B
        (ColoredSubstitutionData.unitProfile c)).inv ≫
        linearCoefficientι O.toCollection B (ColoredSubstitutionData.unitProfile c)
          emptyColoredInputs) := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
