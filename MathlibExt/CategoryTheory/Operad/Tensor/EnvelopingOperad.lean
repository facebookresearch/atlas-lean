  (FiniteTensor.tensor (V := C)).mapIso (nilLeafFactorsIso A d X) ≪≫
    (FiniteTensor.singletonIso (V := C)).app X

omit [FiniteTensor C] in
/-- Original coefficient maps commute with the original Fin-0 factor bijection. -/
theorem nilLeafFactors_naturality (A : W → C) (d : W) {X Y : C} (f : X ⟶ Y) :
