/-!
# Exact original empty coefficient/input block interchange
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem mapFour {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) :
    F.map a ≫ F.map b ≫ F.map c ≫ F.map d = F.map (a ≫ b ≫ c ≫ d) := by
  simp only [Functor.map_comp]

private theorem normalizeEmptyBlock {D : Type*} [Category* D]
    {U A B C E F G H J : D}
    (w : U ⟶ A) (b : A ⟶ B) (q : B ⟶ C) (i : C ⟶ E) (n : E ⟶ F)
    (j : F ⟶ G) (e : G ⟶ U) (a : A ⟶ H) (f : H ⟶ C)
    (c : E ⟶ J) (n₀ : J ⟶ G) (z : J ⟶ U) (h : H ⟶ U) (u : A ⟶ U)
    (hb : b ≫ q = a ≫ f) (hc : n ≫ j = c ≫ n₀) (hn : n₀ ≫ e = z)
    (hf : f ≫ i ≫ c ≫ z = h) (ha : a ≫ h = u) (hu : w ≫ u = 𝟙 U) :
    ((w ≫ b) ≫ (q ≫ i ≫ n)) ≫ j ≫ e = 𝟙 U := by
  simp only [Category.assoc]
  rw [← Category.assoc b q, hb]
  simp only [Category.assoc]
  rw [← Category.assoc n j, hc]
  simp only [Category.assoc]
  rw [hn, hf, ha]
  exact hu

variable {C : Type w} [Category.{v} C]

/-- The original empty family of input blocks has its actual empty
index comparison, even when the empty input function is heterogeneous. -/
def emptyBlocksIso (L : Empty → FiniteFamily C) :
    (FiniteFamily.empty : FiniteFamily (FiniteFamily C)) ≅
      combinedInputBlocks (FintypeCat.of Empty) (FiniteFamily.empty (C := C)).obj L :=
  FiniteFamily.isoOfComponents (Equiv.refl Empty) (fun i => i.elim)

/-- The complete original dependent input family of an empty block
is the original empty leaf family through its actual empty index map. -/
def emptyLeavesIso (L : Empty → FiniteFamily C) :
    totalBlockInputs (FintypeCat.of Empty) L ≅ (FiniteFamily.empty : FiniteFamily C) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => p.1
      invFun := fun i => i.elim
      left_inv := fun p => p.1.elim
      right_inv := fun i => i.elim }
    (fun p => p.1.elim)

variable [FiniteTensor C]

/-- Actual map-empty tensor comparison retains the original empty
weighted source, with every original empty-family map accounted for. -/
def emptyWeightedIso (L : Empty → FiniteFamily C) :
    (FiniteFamily.empty : FiniteFamily C) ≅
      weightedInputBlockFamily (FintypeCat.of Empty) (FiniteFamily.empty (C := C)).obj L :=
  (FiniteFamily.mapEmptyIso (FiniteTensor.tensor (V := C))).symm ≪≫
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).mapIso (emptyBlocksIso L)

/-- Empty block interchange followed by the exact original empty
leaf correction and original empty-leaf unitor is the actual tensor-unit
identity. This is a full map equation derived from finite tensor laws. -/
theorem emptyInterchange_projection (L : Empty → FiniteFamily C) :
    ((FiniteTensor.tensor (V := C)).map (emptyWeightedIso L).hom ≫
        (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty)
          (FiniteFamily.empty (C := C)).obj L).hom) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
          C)).obj (FiniteFamily.empty : FiniteFamily C)))
          (emptyLeavesIso L).hom) ≫
      (emptyLeafTensorIso ((FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty :
        FiniteFamily C))).hom =
      𝟙 ((FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let K := (FiniteFamily.empty : FiniteFamily C)
  let N := (FiniteFamily.empty : FiniteFamily (FiniteFamily C))
  let R := combinedInputBlocks (FintypeCat.of Empty) K.obj L
  let w := T.map (FiniteFamily.mapEmptyIso T).inv
  let b := T.map ((FiniteFamily.map T).map (emptyBlocksIso L).hom)
  let q := (FiniteTensor.flattenIso (V := C)).inv.app R
  let i := T.map (coefficientBlockInterchangeFamilyIso (FintypeCat.of Empty) K.obj L).hom
  let n := coefficientLeavesNormalization K (totalBlockInputs (FintypeCat.of Empty) L)
  let j := T.map (coefficientLeafMap (𝟙 (T.obj K)) (emptyLeavesIso L).hom)
  let e := (emptyLeafTensorIso (T.obj K)).hom
  let a := (FiniteTensor.flattenIso (V := C)).inv.app N
  let f := T.map (F.map (emptyBlocksIso L).hom)
  let c := T.map (F.map (coefficientLeavesNestedMap (𝟙 K) (emptyLeavesIso L).hom))
  let n₀ := coefficientLeavesNormalization K (FiniteFamily.empty : FiniteFamily C)
  let z := T.map (emptyLeafRawIso K).hom
  let h := T.map (emptyNestedFlattenIso (C := C)).hom
  let u := T.map (FiniteFamily.mapEmptyIso T).hom
  have hb : b ≫ q = a ≫ f :=
    (FiniteTensor.flattenIso (V := C)).inv.naturality (emptyBlocksIso L).hom
  have hc : n ≫ j = c ≫ n₀ :=
    (congrArg (fun k => n ≫ T.map (coefficientLeafMap k (emptyLeavesIso L).hom)) (T.map_id
      K)).symm.trans
      (coefficientLeavesNormalization_naturality (𝟙 K) (emptyLeavesIso L).hom).symm
  have hn : n₀ ≫ e = z := coefficientLeavesNormalization_empty K
  have hf : F.map (emptyBlocksIso L).hom ≫
      (coefficientBlockInterchangeFamilyIso (FintypeCat.of Empty) K.obj L).hom ≫
      F.map (coefficientLeavesNestedMap (𝟙 K) (emptyLeavesIso L).hom) ≫
      (emptyLeafRawIso K).hom = (emptyNestedFlattenIso (C := C)).hom := by
    apply FiniteFamily.Hom_ext
    · ext p
      exact p.1.elim
    · intro p
      exact p.1.elim
  have hfT : f ≫ i ≫ c ≫ z = h :=
    (mapFour T _ _ _ _).trans (congrArg T.map hf)
  have ha : a ≫ h = u :=
    (congrArg (a ≫ ·) (flattenIso_empty_collapse (C := C)).symm).trans
      ((Category.assoc a ((FiniteTensor.flattenIso (V := C)).hom.app N) u).symm.trans
        ((congrArg (· ≫ u) ((FiniteTensor.flattenIso (V :=
          C)).inv_hom_id_app N)).trans (Category.id_comp u)))
  have hu : w ≫ u = 𝟙 (T.obj K) := (T.map_comp _ _).symm.trans
    ((congrArg T.map (FiniteFamily.mapEmptyIso T).inv_hom_id).trans (T.map_id K))
  have hw : T.map (emptyWeightedIso L).hom = w ≫ b := T.map_comp _ _
  have hi : (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty) K.obj L).hom = q ≫ i ≫ n :=
    congrArg (fun t => q ≫ i ≫ t)
      (coefficientLeavesNormalizationIso_hom K (totalBlockInputs (FintypeCat.of Empty) L))
  exact (congrArg (fun w => (w ≫ (coefficientBlockInterchangeTensorIso (FintypeCat.of
    Empty) K.obj L).hom) ≫ j ≫ e)
    hw).trans
    ((congrArg (fun i => ((w ≫ b) ≫ i) ≫ j ≫ e) hi).trans
      (normalizeEmptyBlock w b q i n j e a f c n₀ z h u hb hc hn hfT ha hu))

/-- The actual empty weighted block normalizer is the original
empty-leaf unitor inverse, with the exact original empty leaf map. -/
theorem emptyInterchange_hom (L : Empty → FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).map (emptyWeightedIso L).hom ≫
        (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty)
          (FiniteFamily.empty (C := C)).obj L).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
            C)).obj (FiniteFamily.empty : FiniteFamily C)))
            (emptyLeavesIso L).hom) =
      (emptyLeafTensorIso ((FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty :
        FiniteFamily C))).inv := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (emptyWeightedIso L).hom ≫
    (coefficientBlockInterchangeTensorIso (FintypeCat.of Empty) (FiniteFamily.empty (C :=
      C)).obj L).hom
  let b := T.map (coefficientLeafMap (𝟙 (T.obj (FiniteFamily.empty : FiniteFamily C)))
    (emptyLeavesIso L).hom)
  let e := emptyLeafTensorIso (T.obj (FiniteFamily.empty : FiniteFamily C))
  have hp : (a ≫ b) ≫ e.hom = 𝟙 _ :=
    (Category.assoc a b e.hom).trans (emptyInterchange_projection L)
  have h : a ≫ b = e.inv := (cancel_mono e.hom).1 (hp.trans e.inv_hom_id.symm)
  exact (Category.assoc _ _ _).symm.trans h


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
