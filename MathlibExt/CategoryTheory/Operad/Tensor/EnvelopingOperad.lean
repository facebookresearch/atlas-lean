  equiv := Equiv.refl (Option (d.branches.index ⊕ Q.root.index))
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile d.middleData.outerProfile Q.root)) ≫
        O.toCollection.map (envelopingRepresentativeOuterHom d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q))
    | some (Sum.inl i) => envelopingRepresentativeCoefficientSubstitution O (d.localData i)
      (Q.branch i)
    | some (Sum.inr j) => (FiniteTensor.tensor (V := C)).map (retainedRootUnitFamilyMap O
      (Q.root.obj j).as) ≫
        O.subst.app (retainedRootAlgebraDatum (Q.root.obj j).as) ≫
        O.toCollection.map (retainedRootAlgebraTotalHom (Q.root.obj j).as)

/-- Actual original association grouping factors and the full
outer profile map give exactly the retained root/branch contraction. -/
theorem envelopingAssocNestedFactors_contraction (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedFactorsMap O d Q ≫
        ColoredOperadObj.AssocInsertion.groupingAToFactorsHom O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q)
          ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (envelopingAssocOuterComparison d Q) =
      envelopingAssocNestedContractionMap O d Q := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | none => rfl
    | some i => cases i <;> rfl
  · intro i
    cases i with
    | none =>
      exact heq_of_eq (by
        have hn := (FiniteTensor.singletonIso (V := C)).hom.naturality (O.toCollection.map
          (envelopingAssocRootHom d Q))
        have hp : envelopingAssocRootHom d Q ≫
            (envelopingAssocRootHom d Q).symm ≫
            envelopingRepresentativeOuterHom d.outerAfterInnerData
              (envelopingAssocOuterChoices d Q) =
            envelopingRepresentativeOuterHom d.outerAfterInnerData
              (envelopingAssocOuterChoices d Q) := by
          apply ColoredProfile.Hom.ext
          rfl
        have hm : O.toCollection.map (envelopingAssocRootHom d Q) ≫
            O.toCollection.map ((envelopingAssocRootHom d Q).symm ≫
              envelopingRepresentativeOuterHom d.outerAfterInnerData
                (envelopingAssocOuterChoices d Q)) =
          O.toCollection.map (envelopingRepresentativeOuterHom d.outerAfterInnerData
            (envelopingAssocOuterChoices d Q))
            :=
          (O.toCollection.map_comp _ _).symm.trans (congrArg O.toCollection.map hp)
        have ho := envelopingAssocOuterComparison_outer d Q
        have h := (congrArg (fun f => ((FiniteTensor.tensor (V :=
          C)).map ((FiniteFamily.singleton (C := C)).map
          (O.toCollection.map (envelopingAssocRootHom d Q))) ≫
            (FiniteTensor.singletonIso (V := C)).hom.app
            (O.toCollection.obj (envelopingRepresentativeAssoc d
              Q).middleData.outerProfile)) ≫ O.toCollection.map f)
              ho).trans
          ((congrArg (· ≫ O.toCollection.map ((envelopingAssocRootHom d Q).symm ≫
            envelopingRepresentativeOuterHom d.outerAfterInnerData
              (envelopingAssocOuterChoices d Q))) hn).trans
            ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·) hm)))
        exact (Category.assoc _ _ _).symm.trans h)
    | some i =>
      cases i with
      | inl i => exact HEq.rfl
      | inr j => exact HEq.rfl


end CategoryTheory.Operad.Tensor.Enveloping

