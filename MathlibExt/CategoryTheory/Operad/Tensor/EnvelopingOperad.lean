/-!
# Actual original operations and units inside the enveloping coefficients
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u}

/-- The empty added algebra-input family retains no extra position. -/
def emptyColoredInputs : ColoredInputs W := FiniteFamily.empty

/-- The original variable profile is the extended empty-input
profile by its actual original empty-sum bijection. -/
def emptyExtensionProfileHom (P : ColoredProfile W) :
    extendProfile P emptyColoredInputs ⟶ P where
  inputEquiv := Equiv.sumEmpty P.inputs Empty
  inputColor_eq i := by
    cases i with
    | inl i => rfl
    | inr i => exact i.elim
  outputColor_eq := rfl

/-- The actual empty-input profile comparison and its original inverse. -/
def emptyExtensionProfileIso (P : ColoredProfile W) :
    extendProfile P emptyColoredInputs ≅ P where
  hom := emptyExtensionProfileHom P
  inv := ColoredProfile.Hom.symm (emptyExtensionProfileHom P)
  hom_inv_id := by
    apply ColoredProfile.Hom.ext
    exact (Equiv.sumEmpty P.inputs Empty).self_trans_symm
  inv_hom_id := by
    apply ColoredProfile.Hom.ext
    exact (Equiv.sumEmpty P.inputs Empty).symm_trans_self

/-- The actual original variable-profile map respects the exact
empty algebra-input comparison. -/
theorem emptyExtensionProfileHom_naturality {P P' : ColoredProfile W} (f : P ⟶ P') :
    extendProfileMap f (𝟙 emptyColoredInputs) ≫ emptyExtensionProfileHom P' =
      emptyExtensionProfileHom P ≫ f := by
  apply ColoredProfile.Hom.ext
  ext i
  cases i with
  | inl i => rfl
  | inr i => exact i.elim

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual mapped empty colored input family is the original
empty tensor-input family through its empty index bijection. -/
def emptyAddedAlgebraInputsIso (B : W → C) :
    (addedAlgebraInputs B).obj emptyColoredInputs ≅ (FiniteFamily.empty : FiniteFamily C) :=
  FiniteFamily.isoOfComponents (Equiv.refl Empty) (fun i => i.elim)

/-- The actual no-added-input coefficient factors retain the
original coefficient and the exact empty leaf-family comparison. -/
def emptyLinearFactorsIso (O : ColoredSymmetricCollection W C) (B : W → C) (P : ColoredProfile W) :
    (coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).obj
      emptyColoredInputs ≅
      (coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).obj
        (O.obj (extendProfile P emptyColoredInputs)) :=
  FiniteFamily.isoOfComponents
    (Equiv.optionCongr (emptyAddedAlgebraInputsIso B).hom.equiv)
    (fun i => match i with
      | none => Iso.refl (O.obj (extendProfile P emptyColoredInputs))
      | some i => i.elim)

/-- The empty added-input coefficient tensor is the actual
original operation object by the original empty-leaf unitor. -/
def emptyLinearSummandIso (O : ColoredSymmetricCollection W C) (B : W → C) (P : ColoredProfile W) :
    (linearCoefficientDiagram O B P).obj emptyColoredInputs ≅ O.obj P :=
  (FiniteTensor.tensor (V := C)).mapIso
    (emptyLinearFactorsIso O B P) ≪≫
    emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs)) ≪≫
      O.mapIso (emptyExtensionProfileIso P)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Every original operation injects through its actual no-added-input
summand into the full original linear coefficient colimit. -/
def originalOperationToLinear (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) :
    O.obj P ⟶ linearCoefficient O B P :=
  (emptyLinearSummandIso O B P).inv ≫ linearCoefficientι O B P emptyColoredInputs

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual original operation map into the enveloping
coefficient quotient imposes precisely the original algebra relations. -/
def originalOperationToEnveloping (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    O.toCollection.obj P ⟶ envelopingCoefficientObj O A P :=
  originalOperationToLinear O.toCollection A.carrier P ≫ envelopingCoefficientπ O A P

/-- Actual linear units are the original operad units at each color,
inserted through the original empty added-input summand. -/
def envelopingLinearUnit (O : ColoredOperadObj W C) (B : W → C) :
    ColoredOperadUnit (linearCoefficientCollection O.toCollection B) :=
  fun d => O.unit d ≫ originalOperationToLinear O.toCollection B
    (ColoredSubstitutionData.unitProfile d)

/-- Actual enveloping units are the original operad units followed
by the actual no-added-input coefficient quotient injection. -/
def envelopingCoefficientUnit (O : ColoredOperadObj W C) (A : Algebra O) :
    ColoredOperadUnit (Variable.envelopingCoefficientCollection O A) :=
  fun d => O.unit d ≫ originalOperationToEnveloping O A (ColoredSubstitutionData.unitProfile d)


end CategoryTheory.Operad.Tensor.Enveloping

end
