namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The complete original algebra substitution source is its
actual coefficient tensor with the unchanged original variable
leaf family, through the original factor permutation and normalizer. -/
def substitutionSourceIso (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) :
    algebraSubstitutionSource (linearCoefficientCollection O B) M s ≅
      (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).obj
        ((ColoredOperadObj.substitutionSource (linearCoefficientCollection O B)).obj s) :=
  (FiniteTensor.tensor (V := C)).mapIso (substitutionToLeavesIso
    (linearCoefficientCollection O B) M s) ≪≫
    coefficientLeavesNormalizationIso
      ((ColoredOperadObj.substitutionFactors (linearCoefficientCollection O B)).obj s)
      (profileLeafFamily M s.totalProfile)

/-- The actual original added-input choices at all root and inner
coefficient positions form a source-sized category. -/
theorem substitutionChoicesEssentiallySmall (s : ColoredSubstitutionData W) :
    EssentiallySmall.{us} (EnvelopingInputChoices s) := by
  let : Small.{us} (Option s.inner.index) := inferInstance
  exact @piEssentiallySmall.{0, max 1 u, u, us}
    (Option s.inner.index) inferInstance (fun _ => ColoredInputs W)
    (fun _ => inferInstance) (fun _ => coloredInputsEssentiallySmall s.outputColor)

/-- The original joint coefficient tensor cofan, with every
unchanged variable leaf retained, is the actual substitution cofan. -/
def substitutionTensorCocone (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) :
    Cocone (envelopingLinearTensorDiagram O B s ⋙
      coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)) :=
  (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).mapCocone
    (envelopingLinearTensorCocone O B s)

/-- Original finite coefficient colimits and coefficient-slot
preservation construct the complete variable-weighted joint
substitution source colimit. -/
def substitutionTensorIsColimit (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) : IsColimit (substitutionTensorCocone O B M s) := by
  letI : EssentiallySmall.{us} (EnvelopingInputChoices s) := substitutionChoicesEssentiallySmall s
  let U := coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)
  letI : PreservesColimitsOfSize.{us, us} U := inferInstance
  letI : PreservesColimitsOfShape (EnvelopingInputChoices s) U :=
    MonoidalCategory.OrderedTensor.preservesColimitsOfEssentiallySmall U (EnvelopingInputChoices s)
  exact isColimitOfPreserves U (envelopingLinearTensorIsColimit O B s)

/-- The actual tensor coefficient cofan point maps to the
original full algebra substitution source, retaining the complete
root/inner coefficient point comparison and original leaf maps. -/
def substitutionTensorPointIso (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) :
    (substitutionTensorCocone O B M s).pt ≅ algebraSubstitutionSource
      (linearCoefficientCollection O B) M s :=
  (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).mapIso
    (envelopingLinearTensorPointIso O B s) ≪≫ (substitutionSourceIso O B M s).symm

/-- Every original joint coefficient choice has its actual cofan
leg into the complete original algebra substitution source. -/
def substitutionInjection (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (coefficientLeafTensorFunctor (profileLeafFamily M s.totalProfile)).obj
        ((envelopingLinearTensorDiagram O B s).obj Q) ⟶
      algebraSubstitutionSource (linearCoefficientCollection O B) M s :=
  (substitutionTensorCocone O B M s).ι.app Q ≫ (substitutionTensorPointIso O B M s).hom

/-- The actual coefficient/variable cofan determines every
original algebra substitution-source arrow, with all heterogeneous
and nullary profiles retained. -/
theorem substitution_hom_ext (O : ColoredSymmetricCollection W C) (B M : W → C)
    (s : ColoredSubstitutionData W) {Y : C}
    {f g : algebraSubstitutionSource (linearCoefficientCollection O B) M s ⟶ Y}
    (h : ∀ Q : EnvelopingInputChoices s,
      substitutionInjection O B M s Q ≫ f = substitutionInjection O B M s Q ≫ g) : f = g := by
  apply (cancel_epi (substitutionTensorPointIso O B M s).hom).1
  apply (substitutionTensorIsColimit O B M s).hom_ext
  intro Q
  exact (Category.assoc _ _ _).symm.trans ((h Q).trans (Category.assoc _ _ _))


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
