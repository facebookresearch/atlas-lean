/- Exact checked source: WeightedNormalization.LeftCoefficientUnit. -/
section EnvelopingSource185


/-!
# The exact original left representative coefficient unit law
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory

private theorem eraseLeftPrefix {D : Type*} [Category* D] {A B C E : D}
    (p : A ⟶ B) (r : B ⟶ C) (f : C ⟶ E) (e : B ⟶ A) (g : A ⟶ E)
    (hr : r ≫ f = e ≫ g) (hp : p ≫ e = 𝟙 A) :
    (p ≫ r) ≫ f = g :=
  (Category.assoc p r f).trans ((congrArg (p ≫ ·) hr).trans
    ((Category.assoc p e g).symm.trans ((congrArg (· ≫ g) hp).trans (Category.id_comp g))))

private theorem evaluateLeftCoefficientUnit {D : Type*} [Category* D]
    {X A B C E F G H : D}
    (i : X ⟶ A) (a : A ⟶ B) (s : B ⟶ C) (t : C ⟶ E) (r : E ⟶ F)
    (h : B ⟶ G) (s' : G ⟶ H) (k : H ⟶ F) (q : C ⟶ H) (j : X ⟶ G)
    (hi : i ≫ a ≫ h = j) (hs : s ≫ q = h ≫ s') (ht : t ≫ r = q ≫ k) :
    i ≫ (a ≫ s ≫ t) ≫ r = j ≫ s' ≫ k := by
  simp only [Category.assoc]
  rw [ht, ← Category.assoc s q, hs]
  simpa only [Category.assoc] using congrArg (fun z => z ≫ s' ≫ k) hi

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The exact original empty-root coefficient comparison maps to
the original full left-unit coefficient source at P⊔Q. -/
def leftCoefficientToUnitFactors (O : ColoredSymmetricCollection W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeCoefficients O (ColoredSubstitutionData.leftUnit P)
      (leftUnitChoices P Q) ⟶
      (ColoredOperadObj.substitutionFactors O).obj (ColoredSubstitutionData.leftUnit
        (extendProfile P Q)) where
  equiv := Equiv.refl (Option PUnit)
  hom i := match i with
    | none => O.map (emptyExtensionProfileHom (ColoredSubstitutionData.unitProfile P.outputColor))
    | some _ => 𝟙 (O.obj (extendProfile P Q))

/-- Original empty-root unit insertion followed by the original
shape map is precisely the actual coefficient-family map, with the
genuine arbitrary-empty-index unit-prefix identity. -/
theorem leftRepresentativeTensorMap_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeCoefficientTensorMap O (ColoredSubstitutionData.leftUnit P)
      (leftUnitChoices P Q) ≫
      (ColoredOperadObj.substitutionSource O.toCollection).map (leftToExtendedUnit P Q) =
    (FiniteTensor.tensor (V := C)).map (leftCoefficientToUnitFactors O.toCollection P Q) := by
  let T := FiniteTensor.tensor (V := C)
  let s := ColoredSubstitutionData.leftUnit P
  let q := leftUnitChoices P Q
  let R := envelopingRepresentativeCoefficients O.toCollection s q
  let u := envelopingRepresentativeUnitMap O s q
  let f := (ColoredOperadObj.substitutionFactors O.toCollection).map (leftToExtendedUnit P Q)
  let e := (ZeroVariable.emptyUnitIso (FintypeCat.of Empty) R).hom
  let g := leftCoefficientToUnitFactors O.toCollection P Q
  let p := (frozenVariableTensorUnitIso (FintypeCat.of Empty) R).hom
  have h : u ≫ f = e ≫ g := by
    apply FiniteFamily.Hom_ext
    · ext i
      cases i with
      | inl i => cases i
      | inr i => cases i <;> rfl
    · intro i
      cases i with
      | inl i => cases i
      | inr i =>
        cases i with
        | none =>
          exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
            ((congrArg O.toCollection.map (leftToExtendedUnit_outer P Q)).trans
              (Category.id_comp _).symm))
        | some i =>
          let X := O.toCollection.obj (extendProfile P Q)
          change HEq (𝟙 X ≫ O.toCollection.map (𝟙 (extendProfile P Q))) (𝟙 X ≫ 𝟙 X)
          exact heq_of_eq (congrArg (𝟙 X ≫ ·) (O.toCollection.map_id _))
  have hm : T.map u ≫ T.map f = T.map e ≫ T.map g :=
    (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))
  have hp : p ≫ T.map e = 𝟙 (T.obj R) := ZeroVariable.emptyPrefix_unit (FintypeCat.of Empty) R
  exact eraseLeftPrefix p (T.map u) (T.map f) (T.map e) (T.map g) hm hp

/-- The actual original unit coefficient and its empty-extension
comparison cancel to the original complete left factor map at P⊔Q. -/
theorem leftCoefficientFactors_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    UnitGeometry.leftCoefficientFactor (O.toCollection.obj (extendProfile P Q))
        (O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
          P.outputColor) emptyColoredInputs))
        (leftUnitCoefficient O P) ≫
      (leftUnitCoefficientFamilyIso O.toCollection P Q).hom ≫
      leftCoefficientToUnitFactors O.toCollection P Q =
    ColoredOperadObj.UnitInsertion.leftFactorHom O.toCollection O.unit (extendProfile P Q) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let E := extendProfile P Q
      let e := emptyExtensionProfileIso (ColoredSubstitutionData.unitProfile P.outputColor)
      let u := O.unit P.outputColor
      let f := O.toCollection.map e.inv
      let g := O.toCollection.map e.hom
      have hfg : f ≫ g = 𝟙 _ := (O.toCollection.map_comp _ _).symm.trans
        ((congrArg O.toCollection.map e.inv_hom_id).trans (O.toCollection.map_id _))
      have hl : (u ≫ f) ≫ (𝟙 _ ≫ g) = u :=
        (congrArg ((u ≫ f) ≫ ·) (Category.id_comp g)).trans
          ((Category.assoc u f g).trans ((congrArg (u ≫ ·) hfg).trans (Category.comp_id u)))
      have hr : u ≫ O.toCollection.map (ColoredSubstitutionData.leftUnitOuterHom E) = u :=
        (congrArg (u ≫ ·) (congrArg O.toCollection.map
          (ColoredSubstitutionData.leftUnitOuterHom_eq_id E))).trans
          ((congrArg (u ≫ ·) (O.toCollection.map_id _)).trans (Category.comp_id u))
      exact heq_of_eq (hl.trans hr.symm)
    | some i =>
      cases i
      let X := O.toCollection.obj (extendProfile P Q)
      let s := (FiniteTensor.singletonIso (V := C)).hom.app X
      change HEq (s ≫ (𝟙 X ≫ 𝟙 X)) s
      exact heq_of_eq ((congrArg (s ≫ ·) (Category.id_comp (𝟙 X))).trans (Category.comp_id s))

/-- The original representative coefficient insertion transports to
the original O-left-unit insertion, with all empty-prefix and profile
corrections retained on the original maps. -/
theorem leftCoefficientInsertion_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    leftUnitCoefficientInsertion O P Q ≫
      envelopingRepresentativeCoefficientTensorMap O (ColoredSubstitutionData.leftUnit P)
        (leftUnitChoices P Q) ≫
      (ColoredOperadObj.substitutionSource O.toCollection).map (leftToExtendedUnit P Q) =
    ColoredOperadObj.leftUnitInsert O.toCollection O.unit (extendProfile P Q) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let f := UnitGeometry.leftCoefficientFactor X
    (O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
      emptyColoredInputs))
    (leftUnitCoefficient O P)
  let e := (leftUnitCoefficientFamilyIso O.toCollection P Q).hom
  let g := leftCoefficientToUnitFactors O.toCollection P Q
  have hf : (f ≫ e) ≫ g =
      ColoredOperadObj.UnitInsertion.leftFactorHom O.toCollection O.unit (extendProfile P Q) :=
    (Category.assoc f e g).trans (leftCoefficientFactors_unit O P Q)
  have h : leftUnitCoefficientInsertion O P Q ≫ T.map g =
      ColoredOperadObj.leftUnitInsert O.toCollection O.unit (extendProfile P Q) :=
    (congrArg (· ≫ T.map g) (UnitInsertion.leftInsertFromFactor_comp X f e)).trans
      ((UnitInsertion.leftInsertFromFactor_comp X (f ≫ e) g).trans
        (congrArg (UnitInsertion.leftInsertFromFactor X) hf))
  exact (congrArg (leftUnitCoefficientInsertion O P Q ≫ ·)
    (leftRepresentativeTensorMap_unit O P Q)).trans h

/-- The exact original left representative coefficient operation has
the actual original O-unit law after both original total-profile maps. -/
theorem leftRepresentativeCoefficient_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    leftUnitCoefficientInsertion O P Q ≫
      envelopingRepresentativeCoefficientSubstitution O (ColoredSubstitutionData.leftUnit P)
        (leftUnitChoices P Q) ≫
      O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
        (leftUnitInputsIso P Q).hom) =
    𝟙 (O.toCollection.obj (extendProfile P Q)) := by
  let i := leftUnitCoefficientInsertion O P Q
  let a := envelopingRepresentativeCoefficientTensorMap O (ColoredSubstitutionData.leftUnit
    P) (leftUnitChoices P Q)
  let s := O.subst.app (envelopingRepresentativeSubstitution
    (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P Q))
  let t := O.toCollection.map (envelopingRepresentativeTotalHom
    (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P
    Q))
  let r := O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
    (leftUnitInputsIso P
    Q).hom)
  let f := leftToExtendedUnit P Q
  let h := (ColoredOperadObj.substitutionSource O.toCollection).map f
  let s' := O.subst.app (ColoredSubstitutionData.leftUnit (extendProfile P Q))
  let k := O.toCollection.map (ColoredSubstitutionData.leftUnitTotalHom (extendProfile P Q))
  let q := O.toCollection.map (ColoredSubstitutionData.totalProfileMap f)
  let j := ColoredOperadObj.leftUnitInsert O.toCollection O.unit (extendProfile P Q)
  have hi : i ≫ a ≫ h = j := leftCoefficientInsertion_unit O P Q
  have hs : s ≫ q = h ≫ s' := (O.subst.naturality f).symm
  have ht : t ≫ r = q ≫ k := (O.toCollection.map_comp _ _).symm.trans
    ((congrArg O.toCollection.map (leftToExtendedUnit_total P Q)).trans
      (O.toCollection.map_comp _ _))
  exact (evaluateLeftCoefficientUnit i a s t r h s' k q j hi hs ht).trans (O.left_unit
    (extendProfile P Q))


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
