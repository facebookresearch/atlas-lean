/-!
# The original root-first coefficient grouping for constants and variable operations
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Root

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- Identify the flattened singleton grouping with the flattened frozen-root grouping. -/
def rawFlattenIsoAToB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W)
  (Q : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).obj (rawGroupsA E s Q) ≅
      (FiniteFamily.flatten (C := C)).obj (rawGroupsB E s Q) :=
  FiniteFamily.mapSingletonFlattenIso.app (rawFactors E s Q) ≪≫ rawSourceIsoB E s Q

/-- Group the middle substitution factors at the root and keep the original variable
coefficients in singleton blocks. -/
def correctedGroupsB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q
  : ColoredInputs W) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option s.inner.index)
  obj i := match i with
    | none => (ColoredOperadObj.substitutionFactors E).obj (assocData s Q).middleData
    | some i => (FiniteFamily.singleton (C := C)).obj (E.obj (s.inner.obj i))

/-- Identify the corrected root grouping with the second associativity grouping by its
inner-profile permutation. -/
def groupingIsoB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    correctedGroupsB E s Q ≅ ColoredOperadObj.AssocInsertion.groupingB E (assocData s Q) :=
  FiniteFamily.isoOfComponents (Equiv.optionCongr (innerCompare s Q).innerHom.equiv.symm)
    (fun i => match i with | none => Iso.refl _ | some _ => Iso.refl _)

variable [FiniteTensor C]

/-- Place every variable unit in the frozen root block and no units in the singleton variable
blocks. -/
def unitPositionsB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (rawGroupsB E s Q).index → FintypeCat.{0}
  | none => s.inner.index
  | some _ => FintypeCat.of (Fin 0)

/-- Identify variable branches with their unit positions inside the frozen root block. -/
def unitPositionEquivB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W)
  (Q : ColoredInputs W) :
    s.inner.index ≃ blockUnitIndex (rawGroupsB E s Q) (unitPositionsB E s Q) where
  toFun i := ⟨none, i⟩
  invFun p := match p with | ⟨none, i⟩ => i | ⟨some _, i⟩ => Fin.elim0 i
  left_inv _ := rfl
  right_inv p := by rcases p with ⟨i, j⟩; cases i with | none => rfl | some i => exact Fin.elim0 j

/-- Insert the root unit coefficients and transport the middle factors, leaving the variable
singleton blocks unchanged. -/
def localUnitMapB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q : ColoredInputs W)
    (i : (rawGroupsB E.toCollection s Q).index) :
    frozenVariableUnitFamily (unitPositionsB E.toCollection s Q i) ((rawGroupsB
      E.toCollection s Q).obj i) ⟶
      (correctedGroupsB E.toCollection s Q).obj i :=
  match i with
  | none => frozenUnitCoefficientMap E s.outerProfile Q (Constants.branches Q) ≫
      (ColoredOperadObj.substitutionFactors E.toCollection).map (middleCompare s Q)
  | some i => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0)) ((FiniteFamily.singleton (C
    := C)).obj
    (E.toCollection.obj (s.inner.obj i)))).hom

/-- Assemble the unit insertions on the frozen-root grouping into the flattened corrected
grouping. -/
def globalUnitMapB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    frozenVariableUnitFamily s.inner.index ((FiniteFamily.flatten (C :=
      C)).obj (rawGroupsB E.toCollection s Q)) ⟶
      (FiniteFamily.flatten (C := C)).obj (correctedGroupsB E.toCollection s Q) :=
  Variable.unitFamilyMap (unitPositionEquivB E.toCollection s Q)
    (𝟙 ((FiniteFamily.flatten (C := C)).obj (rawGroupsB E.toCollection s Q))) ≫
      blockUnitGlobalMap (rawGroupsB E.toCollection s Q) (unitPositionsB E.toCollection s Q)
        (correctedGroupsB E.toCollection s Q).obj (localUnitMapB E s Q)

/-- Apply the local unit insertions to the tensors of the frozen-root grouping. -/
def appliedMapB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsB E.toCollection s Q) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (correctedGroupsB E.toCollection s Q) :=
  blockUnitAppliedMap (rawGroupsB E.toCollection s Q) (unitPositionsB E.toCollection s Q)
    (correctedGroupsB E.toCollection s Q).obj (localUnitMapB E s Q)

/-- The actual global variable units and every actual coefficient have the
same original positions and maps in the two actual E-association groupings. -/
theorem globalUnitMap_relabel (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q
  : ColoredInputs W) :
    Variable.unitFamilyMap (Equiv.refl s.inner.index) (rawFlattenIsoAToB E.toCollection s Q).hom ≫
      globalUnitMapB E s Q ≫ (FiniteFamily.flatten (C :=
        C)).map (groupingIsoB E.toCollection s Q).hom =
    globalUnitMapA E s Q ≫ ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom
      E.toCollection (assocData s Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl i => rfl
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with | none => cases j; rfl | some i => cases i <;> cases j <;> rfl
  · intro p
    cases p with
    | inl i =>
      let U := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
      let f := E.unit (s.inner.obj i).outputColor
      let g := E.toCollection.map (ColoredSubstitutionData.leftUnitOuterHom (s.inner.obj i))
      change HEq (𝟙 U ≫ ((𝟙 U ≫ ((𝟙 U ≫ 𝟙 U) ≫ (f ≫ g))) ≫ 𝟙 _))
        ((𝟙 U ≫ ((𝟙 U ≫ 𝟙 U) ≫ (f ≫ g))) ≫ 𝟙 _)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with
      | none =>
        cases j
        let X := E.toCollection.obj (extendProfile s.outerProfile Q)
        let f := E.toCollection.map (frozenOuterProfileHom s.outerProfile Q (Constants.branches Q))
        let g := E.toCollection.map (ColoredSubstitutionData.outerProfileMap (middleCompare s Q))
        let r := E.toCollection.map (frozenOuterProfileHom s.outerProfile Q (Constants.branches Q) ≫
          ColoredSubstitutionData.outerProfileMap (middleCompare s Q))
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ ((𝟙 X ≫ ((𝟙 X ≫ 𝟙 X) ≫ (f ≫ g))) ≫ 𝟙 _))
          ((𝟙 X ≫ ((𝟙 X ≫ 𝟙 X) ≫ (𝟙 X ≫ r))) ≫ 𝟙 _)
        exact heq_of_eq (by
          simp only [Category.id_comp, Category.comp_id]
          exact (E.toCollection.map_comp _ _).symm)
      | some i =>
        cases j
        cases i with
        | inl i =>
          let X := E.toCollection.obj (s.inner.obj i)
          change HEq ((𝟙 X ≫ 𝟙 X) ≫ ((𝟙 X ≫ ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X)) ≫ 𝟙 X))
            ((𝟙 X ≫ ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X)) ≫ 𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
        | inr i =>
          let X := E.toCollection.obj (ColoredProfile.nullary (Q.obj i).as)
          let f := E.toCollection.map (ColoredSubstitutionData.rightUnitOuterHom
            (ColoredProfile.nullary (Q.obj i).as))
          change HEq ((𝟙 X ≫ 𝟙 X) ≫ ((𝟙 X ≫ ((𝟙 X ≫ 𝟙 X) ≫ (𝟙 X ≫ f))) ≫ 𝟙 _))
            ((𝟙 X ≫ ((𝟙 X ≫ 𝟙 X) ≫ (𝟙 X ≫ f))) ≫ 𝟙 _)
          exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])


