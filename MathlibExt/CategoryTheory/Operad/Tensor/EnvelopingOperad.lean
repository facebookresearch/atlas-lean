    (M : Algebra (envelopingOperad O A)) :
    (envelopingUnderAObject O A M).right.carrier = M.carrier := rfl

/-- The actual original A arrow has precisely the original computed
linear constant map as its whole colorwise carrier arrow. -/
theorem envelopingUnderAObject_hom (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
