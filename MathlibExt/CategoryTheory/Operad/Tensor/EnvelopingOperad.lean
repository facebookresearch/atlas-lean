/- Exact checked source: ConstantActionExtensionTargetData. -/
section EnvelopingSource321


/-!
# All original target coefficient and leaf maps of grouped representative normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original variable/root/branch coefficient slot
bijection enters the original block coefficient family. -/
def coefficientTargetRelabel (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    coefficientBlockFamily (coefficientGrouping O.toCollection P Q R).index
      (targetCoefficients O P Q R) ⟶
    coefficientBlockFamily (FintypeCat.of (Option (shape P Q).inner.index))
      (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile (shape P Q) i)
        ((choices P Q R) i))) where
  equiv := (coefficientInsertion O P Q R).equiv
  hom i := match i with
    | Sum.inl i => 𝟙 (O.toCollection.obj (extendProfile
        (ColoredProfile.unary (P.inputColor i) (P.inputColor i)) emptyColoredInputs))
    | Sum.inr none => 𝟙 (O.toCollection.obj (extendProfile (shape P Q).outerProfile
      emptyColoredInputs))
    | Sum.inr (some j) => 𝟙 (O.toCollection.obj (extendProfile (ColoredProfile.nullary
      (Q.obj j).as) (branchInputs (R
      j))))

/-- The original input block slot bijection retains the original
actual B-input object and identity at every original input position. -/
def inputTargetRelabel (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    inputBlockFamily (coefficientGrouping O.toCollection P Q R).index (targetLeaves O B P Q R) ⟶
      inputBlockFamily (FintypeCat.of (Option (shape P Q).inner.index))
        (fun i => (addedAlgebraInputs B).obj ((choices P Q R) i)) where
  equiv := (coefficientInsertion O P Q R).equiv
  hom i := 𝟙 (targetLeaves O B P Q R i)

/-- The original coefficient slot comparison retains precisely
the original representative coefficient block comparison. -/
theorem coefficientTargetRelabel_comparison (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    coefficientTargetRelabel O P Q R ≫ (envelopingCoefficientBlockIso O.toCollection
      (shape P Q) (choices P Q R)).hom =
      (groupedTargetCoefficientIso O P Q R).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | inl _ => exact heq_of_eq (Category.id_comp _)
    | inr i => cases i <;> exact heq_of_eq (Category.id_comp _)

/-- The actual original total B leaves retain precisely each
original branch/input pair; original unit and root blocks are empty. -/
def groupedTargetLeavesIso (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    totalBlockInputs (coefficientGrouping O.toCollection P Q R).index (targetLeaves O B P Q R) ≅
      frozenAlgebraLeaves B Q R :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨Sum.inl _, j⟩ => j.elim
        | ⟨Sum.inr none, j⟩ => j.elim
        | ⟨Sum.inr (some i), j⟩ => ⟨i, j⟩
      invFun p := ⟨Sum.inr (some p.1), p.2⟩
      left_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | inl _ => exact j.elim
        | inr i => cases i with
          | none => exact j.elim
          | some _ => rfl
      right_inv _ := rfl }
    (fun p => match p with
      | ⟨Sum.inl _, j⟩ => j.elim
      | ⟨Sum.inr none, j⟩ => j.elim
      | ⟨Sum.inr (some i), j⟩ => Iso.refl (B ((R i).inputColor j)))

/-- All original block, root/inner and total-input maps combine
to exactly the original full dependent B-leaf bijection. -/
theorem inputTargetRelabel_comparison (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).map (inputTargetRelabel O B P Q R) ≫
      (envelopingAlgebraLeafIso B (shape P Q) (choices P Q R)).hom ≫
      (addedAlgebraInputs B).map (totalInputsIso P Q R).hom =
    (groupedTargetLeavesIso O B P Q R).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl _ => exact j.elim
    | inr i => cases i with
      | none => exact j.elim
      | some _ => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl _ => exact j.elim
    | inr i => cases i with
      | none => exact j.elim
      | some i =>
        let X := B ((R i).inputColor j)
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

/-- The actual original grouped-leaf correction uses every original
input map and the proved original total branch/input bijection. -/
def groupedTotalLeafMap (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    groupedCoefficientInputLeaves (coefficientGrouping O.toCollection P Q R) (atomicLeaves
      O.toCollection B P Q R) ⟶
      frozenAlgebraLeaves B Q R :=
  (FiniteFamily.flatten (C := C)).map
    (inputBlockMap (coefficientGrouping O.toCollection P Q R).index
      (fun i => (groupedLeafBlockIso O B P Q R i).hom)) ≫
    (groupedTargetLeavesIso O B P Q R).hom

private theorem targetWeightedIdentity (X : C) (L : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 X) (𝟙 L)) =
      𝟙 ((coefficientLeafTensorFunctor L).obj X) :=
  (congrArg (FiniteTensor.tensor (V := C)).map (coefficientLeafMap_idLeaves (𝟙 X) L)).trans
    ((congrArg (FiniteTensor.tensor (V := C)).map ((coefficientLeafFamilyFunctor L).map_id X)).trans
      ((FiniteTensor.tensor (V := C)).map_id _))

/-- The original weighted slot map retains exactly the original
coefficient and input maps used by block interchange relabelling. -/
theorem groupedTargetWeightedIso_relabel (O : ColoredOperadObj W C) (B : W →
  C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    weightedInputBlockRelabelMap (coefficientInsertion O P Q R).equiv
      (coefficientTargetRelabel O P Q R).hom (inputTargetRelabel O B P Q R).hom =
      (groupedTargetWeightedIso O B P Q R).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | inl i => exact heq_of_eq (targetWeightedIdentity
        (O.toCollection.obj (extendProfile (ColoredProfile.unary (P.inputColor i)
          (P.inputColor i)) emptyColoredInputs))
        ((addedAlgebraInputs B).obj emptyColoredInputs))
    | inr i => cases i with
      | none => exact heq_of_eq (targetWeightedIdentity
          (O.toCollection.obj (extendProfile (shape P Q).outerProfile emptyColoredInputs))
          ((addedAlgebraInputs B).obj emptyColoredInputs))
      | some j => exact heq_of_eq (targetWeightedIdentity
          (O.toCollection.obj (extendProfile (ColoredProfile.nullary (Q.obj j).as)
            (branchInputs (R j))))
          ((addedAlgebraInputs B).obj (branchInputs (R j))))


