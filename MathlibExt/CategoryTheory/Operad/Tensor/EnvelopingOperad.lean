/- Exact checked source: EnvelopingConstantInputOperadMap. -/
section EnvelopingSource325


/-!
# The genuine operadic constant-input face constructed from original free inputs
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual free-input/nullary-coefficient comparison constructs
a genuine full operad map on the original linear coefficient operads. -/
def constantInputOperadMap (O : ColoredOperadObj W C) (B : W → C) :
    envelopingLinearOperad O (profileCoinvariants O.toCollection B) ⟶ envelopingLinearOperad O B :=
  Linear.Constants.operadMap (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv)

/-- The full operad face retains literally its original constants
colimit map and every original free-input coefficient evaluator. -/
theorem constantInputOperadMap_collection (O : ColoredOperadObj W C) (B : W → C) :
    (constantInputOperadMap O B).toCollectionHom = ConstantActionExtension.collectionMap O B := rfl

/-- Every original free-input coefficient cofan evaluates by the
target's original nullary partial substitution and original profile map. -/
theorem constantInputOperadMap_β (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection (profileCoinvariants O.toCollection B) P Q ≫
      (constantInputOperadMap O B).toCollectionHom.app P =
    Linear.Constants.representative (originalOperationToLinearOperadMap O B)
      (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
        O.toCollection B d).inv) P Q :=
  Linear.Constants.operadMap_β (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv) P Q

/-- The full operad face preserves the original O-operation
inclusion as an actual equality of full operad arrows. -/
theorem constantInputOperadMap_original (O : ColoredOperadObj W C) (B : W → C) :
    originalOperationToLinearOperadMap O (profileCoinvariants O.toCollection B) ≫
      constantInputOperadMap O B =
      originalOperationToLinearOperadMap O B :=
  Linear.Constants.operadMap_original (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv)

/-- The full operadic constant-input face has the actual original
linear operad unit equation at every original color. -/
theorem constantInputOperadMap_unit (O : ColoredOperadObj W C) (B : W → C) (d : W) :
    (envelopingLinearOperad O (profileCoinvariants O.toCollection B)).unit d ≫
      (constantInputOperadMap O B).toCollectionHom.app (ColoredSubstitutionData.unitProfile d) =
    (envelopingLinearOperad O B).unit d := (constantInputOperadMap O B).map_unit d


