/- Exact checked source: EnvelopingWeightedRouteBFactorization. -/
section EnvelopingSource195


/-!
# The actual original weighted root-first operation is its complete coefficient evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem weightedRouteBFiring {V : Type*} [Category* V]
    {X A B D E F Y : V} (a : X ⟶ A) (r : A ⟶ B) (n : B ⟶ D)
    (f : D ⟶ E) (z : E ⟶ Y) (b : A ⟶ F) (c : F ⟶ B)
    {G : V} (s : F ⟶ G) (q : G ⟶ D) (g : G ⟶ Y)
    (h1 : b ≫ c = r) (h2 : c ≫ n = s ≫ q) (h3 : q ≫ f ≫ z = g) :
    a ≫ r ≫ n ≫ f ≫ z = a ≫ b ≫ s ≫ g := by
  rw [← h1]
  simp only [Category.assoc]
  rw [← Category.assoc c n, h2]
  simp only [Category.assoc]
  rw [h3]

private theorem weightedRouteBMapThree {V D : Type*} [Category* V] [Category* D]
    (T : V ⥤ D) {A B C E : V} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) :
    T.map a ≫ T.map b ≫ T.map c = T.map (a ≫ b ≫ c) := by
  rw [← T.map_comp b c, ← T.map_comp a (b ≫ c)]

private theorem weightedRouteBFourAssoc {V : Type*} [Category* V]
    {X A B D Y : V} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ D) (g : D ⟶ Y) :
    (a ≫ b ≫ c) ≫ g = a ≫ b ≫ c ≫ g := by simp only [Category.assoc]

private theorem weightedRouteBRegroup {V : Type*} [Category* V]
    {X A B D E F Y : V} (x : X ⟶ A) (y : A ⟶ B) (r : B ⟶ D)
    (n : D ⟶ E) (f : E ⟶ F) (z : F ⟶ Y) :
    x ≫ y ≫ r ≫ (n ≫ f) ≫ z = (x ≫ y) ≫ r ≫ n ≫ f ≫ z := by
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual root-first common evaluation is the original
block normalization followed by the exact joint full coefficient and leaf map. -/
theorem envelopingAssocWeightedRootFirstCommonEvaluation_readback (O : ColoredOperadObj W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRootFirstCommonEvaluation O B d Q =
      (envelopingAssocWeightedRootFirstBlockNormalizationIso O.toCollection B d Q).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          ((envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom ≫
            envelopingAssocRepresentativeRouteB O d Q)
          (envelopingAssocRootFirstLeafIso B d Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let k := (envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom
  let l := (envelopingAssocRootFirstLeafIso B d Q).hom
  let g := envelopingAssocRepresentativeRouteB O d Q
  have h : coefficientLeafMap k l ≫ (coefficientLeafFamilyFunctor
      ((addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q))).map g =
      coefficientLeafMap (k ≫ g) l := coefficientLeafMap_post k g l
  have ht := (T.map_comp _ _).symm.trans (congrArg T.map h)
  exact (Category.assoc _ _ _).trans (congrArg (_ ≫ ·) ht)

/-- The actual original root-first weighted operation factors
through its original coefficient route B and its original full
algebra-input family, preserving every original dependent input correction. -/
theorem envelopingAssocWeightedRouteB_rootFirstCommon (O : ColoredOperadObj W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRepresentativeRouteB O B d Q =
      envelopingAssocWeightedRootFirstCommonEvaluation O B d Q := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option d.middleData.totalProfile.inputs)
  let K : I → C := envelopingAssocRootFirstCoefficientBlockTensors O.toCollection d Q
  let K' : I → C := fun i => O.toCollection.obj
    (extendProfile (envelopingSlotProfile d.innerData i) (envelopingAssocInnerChoices d Q i))
  let L : I → FiniteFamily C := fun i => (envelopingAssocRootFirstLeafBlocks B d Q).obj i
  let L' : I → FiniteFamily C := fun i => (addedAlgebraInputs B).obj
    (envelopingAssocInnerChoices d Q i)
  let a := T.map (envelopingAssocWeightedRootFirstIso O.toCollection B d Q).hom ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocWeightedRootFirstBlocks
      O.toCollection B d Q)
  let r := T.map (envelopingAssocWeightedContractionMapB O B d Q)
  let b := T.map (envelopingAssocWeightedRootFirstBlockTensorIso O.toCollection B d Q).hom
  let c := T.map (envelopingAssocWeightedRootFirstNormalizedContractionMap O B d Q)
  let n := (coefficientBlockInterchangeTensorIso I K' L').hom
  let s := (coefficientBlockInterchangeTensorIso I K L).hom
  let qf := coefficientLeafMap (T.map (coefficientBlockMap I
    (envelopingAssocRootFirstCoefficientContraction O d Q)))
    (envelopingAssocRootFirstLeafComparisonIso B d Q).hom
  let ff := coefficientLeafMap
    (T.map (envelopingCoefficientBlockIso O.toCollection d.innerData
      (envelopingAssocInnerChoices d Q)).hom ≫
      envelopingRepresentativeCoefficientSubstitution O d.innerData
        (envelopingAssocInnerChoices d Q))
    (envelopingAlgebraLeafIso B d.innerData (envelopingAssocInnerChoices d Q)).hom
  let zf := coefficientLeafMap
    (O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q)))
    ((addedAlgebraInputs B).map (envelopingAssocFlatAlgebraInputsMap d Q))
  let gf := coefficientLeafMap
    ((envelopingAssocRootFirstFullCoefficientTensorIso O.toCollection d Q).hom ≫
      envelopingAssocRepresentativeRouteB O d Q)
    (envelopingAssocRootFirstLeafIso B d Q).hom
  have h1 : b ≫ c = r := (T.map_comp _ _).symm.trans
    (congrArg T.map (envelopingAssocWeightedRootFirstBlockTensorIso_contraction O B d Q))
  have h2 : c ≫ n = s ≫ T.map qf := envelopingAssocWeightedRootFirstInterchange O B d Q
  have h3 : T.map qf ≫ T.map ff ≫ T.map zf = T.map gf :=
    (weightedRouteBMapThree T qf ff zf).trans
      (congrArg T.map (envelopingAssocRootFirstWeightedLeafCoefficient_comp O B d Q))
  have h := weightedRouteBFiring a r n (T.map ff) (T.map zf) b c s (T.map qf) (T.map gf) h1 h2 h3
  have hleft : envelopingAssocWeightedRepresentativeRouteB O B d Q = a ≫ r ≫ n ≫
    T.map ff ≫ T.map zf := by
    have hread : envelopingAssocWeightedRepresentativeRouteB O B d Q =
        T.map (envelopingAssocWeightedRootFirstIso O.toCollection B d Q).hom ≫
        (FiniteTensor.flattenIso (V := C)).hom.app
          (envelopingAssocWeightedRootFirstBlocks O.toCollection B d Q) ≫
        r ≫ (n ≫ T.map ff) ≫ T.map zf := rfl
    exact hread.trans (weightedRouteBRegroup (V := C)
      (T.map (envelopingAssocWeightedRootFirstIso O.toCollection B d Q).hom)
      ((FiniteTensor.flattenIso (V := C)).hom.app
        (envelopingAssocWeightedRootFirstBlocks O.toCollection B d Q)) r n (T.map ff) (T.map zf))
  have hright : envelopingAssocWeightedRootFirstCommonEvaluation O B d Q = a ≫ b ≫ s ≫
    T.map gf := by
    have hread : (envelopingAssocWeightedRootFirstBlockNormalizationIso O.toCollection B d Q).hom =
        a ≫ b ≫ s := by
      let x := T.map (envelopingAssocWeightedRootFirstIso O.toCollection B d Q).hom
      let y := (FiniteTensor.flattenIso (V := C)).hom.app
        (envelopingAssocWeightedRootFirstBlocks O.toCollection B d Q)
      have hread0 : (envelopingAssocWeightedRootFirstBlockNormalizationIso O.toCollection B
        d Q).hom =
          x ≫ y ≫ b ≫ s := rfl
      exact hread0.trans (Category.assoc x y (b ≫ s)).symm
    exact (envelopingAssocWeightedRootFirstCommonEvaluation_readback O B d Q).trans
      ((congrArg (· ≫ T.map gf) hread).trans (weightedRouteBFourAssoc a b s (T.map gf)))
  exact hleft.trans (h.trans hright.symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource195

