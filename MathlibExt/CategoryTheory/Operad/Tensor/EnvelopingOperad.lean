section EnvelopingSource357


/-!
# Original operations of a genuine linear-operad algebra are determined by constants
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

private theorem restriction_operations_congr {O E : ColoredOperadObj W C} {f g : O ⟶ E}
    (h : f = g) (M : Algebra E) : (Algebra.restrict f M).operations =
      (Algebra.restrict g M).operations := by
  cases h
  rfl

/-- Actual restriction along the identity full operad arrow retains
the entire original tensor operation family. -/
theorem restriction_operations_identity (E : ColoredOperadObj W C) (M : Algebra E) :
    (Algebra.restrict (𝟙 E) M).operations = M.operations := by
  apply Operations.ext
  funext d P
  change (analyticSummandCollectionMap (d := d) M.carrier (𝟙 E.toCollection)).app P ≫
    M.operations.app d P = M.operations.app d P
  rw [analyticSummandCollectionMap_id, NatTrans.id_app, Category.id_comp]

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Original B-generators with the original O-operation inclusion
give the identity map of the genuine constructed linear operad. -/
theorem linearConstantExtension_identity (O : ColoredOperadObj W C) (B : W → C) :
    Linear.Constants.operadMap (originalOperationToLinearOperadMap O B) B
      (linearConstantGenerator O B) = 𝟙 (envelopingLinearOperad O B) := by
  let u := originalOperationToLinearOperadMap O B
  let g := (profileUnit O).app B
  let b := fun d => (nullaryLinearCoefficientIso O.toCollection B d).inv
  have h : constantRelationOperadGenerator O B ≫ constantInputOperadMap O B =
      Linear.Constants.operadMap u B (linearConstantGenerator O B) :=
    Linear.Constants.operadMap_pre u g b
  exact h.symm.trans
    ((congrArg (constantRelationOperadGenerator O B ≫ ·) (constantRelationOperadFace_eq O
      B).symm).trans
      (constantRelationOperadGenerator_face O B))

/-- Every genuine linear-operad algebra retains its original
O-algebra by actual restriction along the original full inclusion. -/
def linearAlgebraUnderlying (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) : Algebra O :=
  Algebra.restrict (originalOperationToLinearOperadMap O B) M

/-- Every original B-constant is its original linear generator
evaluated by the genuine original algebra's nullary operation. -/
def linearAlgebraConstants (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) : B ⟶ (linearAlgebraUnderlying O B M).carrier :=
  fun d => linearConstantGenerator O B d ≫ FrozenAlgebra.nullaryEvaluation M d

/-- The full original operation family of any genuine linear
algebra is exactly the original O-operation/constant evaluation
family, determined on every actual original coefficient cofan. -/
theorem linearAlgebra_operations (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) :
    M.operations = LinearAlgebra.linearOperations O B (linearAlgebraUnderlying O B M)
      (linearAlgebraConstants O B M)
      := by
  let u := originalOperationToLinearOperadMap O B
  let b := linearConstantGenerator O B
  have h : ((FrozenAlgebra.constantRestrictionFunctor u B b).obj M).operations = M.operations :=
    (restriction_operations_congr (linearConstantExtension_identity O B) M).trans
        (restriction_operations_identity (envelopingLinearOperad O B) M)
  exact h.symm.trans (FrozenAlgebra.constantRestriction_operations u B b M)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource357

