namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root/middle weighted coefficient factors form
the first block; every original innermost weighted coefficient/input
factor remains its original singleton block. -/
def envelopingAssocWeightedRootFirstBlocks (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option d.middleData.totalProfile.inputs)
  obj i := match i with
    | none => envelopingWeightedRepresentativeFamily O B d.middleData
      (envelopingAssocMiddleChoices d Q)
    | some p => (FiniteFamily.singleton (C := C)).obj
        ((linearCoefficientDiagram O B ((d.localData p.1).inner.obj p.2)).obj (Q.branch p.1
          (some p.2)))

/-- The exact original weighted root/middle/inner factor position
bijecton reorders tensor grouping only and retains every original
operation coefficient/input object and unit summand. -/
def envelopingAssocWeightedRootFirstEquiv (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedFamily O B d Q).index ≃
      ((FiniteFamily.flatten (C := C)).obj (envelopingAssocWeightedRootFirstBlocks O B d
        Q)).index where
  toFun p := match p with
    | ⟨none, _⟩ => ⟨none, none⟩
    | ⟨some i, none⟩ => ⟨none, some i⟩
    | ⟨some i, some j⟩ => ⟨some ⟨i, j⟩, PUnit.unit⟩
  invFun p := match p with
    | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
    | ⟨none, some i⟩ => ⟨some i, none⟩
    | ⟨some ⟨i, j⟩, _⟩ => ⟨some i, some j⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  right_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl

/-- The exact original root-first weighted grouping map keeps
every original tensor operation coefficient/input object. -/
def envelopingAssocWeightedRootFirstIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedFamily O B d Q ≅
      (FiniteFamily.flatten (C := C)).obj (envelopingAssocWeightedRootFirstBlocks O B d Q) :=
  FiniteFamily.isoOfComponents (envelopingAssocWeightedRootFirstEquiv O B d Q) (fun p =>
    match p with
    | ⟨none, _⟩ => Iso.refl _
    | ⟨some _, none⟩ => Iso.refl _
    | ⟨some _, some _⟩ => Iso.refl _)


end CategoryTheory.Operad.Tensor.Enveloping

