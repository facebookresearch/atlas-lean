/- Exact checked source: ConstantActionExtensionCoefficients. -/
section EnvelopingSource310


/-!
# Exact original coefficient maps for the constant-input extension representatives
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem eraseRootPrefix {D : Type*} [Category* D]
    {X A B Y : D} (p : X ⟶ A) (u : A ⟶ B) (f : B ⟶ Y) (e : A ⟶ X) (g : X ⟶ Y)
    (h : u ≫ f = e ≫ g) (hp : p ≫ e = 𝟙 X) : p ≫ u ≫ f = g := by
  rw [h, ← Category.assoc p e, hp, Category.id_comp]

private theorem compareRepresentativeCoefficient {D : Type*} [Category* D]
    {X A B C E F Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ C) (d : C ⟶ Y)
    (f : A ⟶ E) (g : B ⟶ F) (h : F ⟶ Y) (s : E ⟶ F) (k : X ⟶ E)
    (hc : c ≫ d = g ≫ h) (hb : b ≫ g = f ≫ s) (ha : a ≫ f = k) :
    (a ≫ b ≫ c) ≫ d = k ≫ s ≫ h := by
  simp only [Category.assoc]
  rw [hc, ← Category.assoc b g, hb]
  simp only [Category.assoc]
  rw [← Category.assoc a f, ha]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original empty root and each original extended unit/nullary
coefficient compare to the actual original frozen-substitution factors. -/
def coefficientComparison (O : ColoredSymmetricCollection W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    envelopingRepresentativeCoefficients O (shape P Q) (choices P Q R) ⟶
      (ColoredOperadObj.substitutionFactors O).obj (frozenSubstitution P Q R) where
  equiv := Equiv.refl (Option (P.inputs ⊕ Q.index))
  hom i := match i with
    | none => O.map (emptyExtensionProfileHom (shape P Q).outerProfile ≫ outerFrozenHom P Q R)
    | some (Sum.inl i) => O.map (emptyExtensionProfileHom
        (ColoredProfile.unary (P.inputColor i) (P.inputColor i)))
    | some (Sum.inr j) => O.map (branchExtensionHom (R j))

variable [FiniteTensor C]

/-- The literal original representative unit/source map and original
shape map erase only the original empty root unit positions. -/
theorem coefficientComparison_inserted (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    envelopingRepresentativeUnitMap O (shape P Q) (choices P Q R) ≫
      (ColoredOperadObj.substitutionFactors O.toCollection).map (representativeShapeHom P Q R) =
    (ZeroVariable.emptyUnitIso (FintypeCat.of Empty)
      (envelopingRepresentativeCoefficients O.toCollection (shape P Q) (choices P Q R))).hom ≫
      coefficientComparison O.toCollection P Q R := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl i => exact i.elim
    | inr i => cases i with
      | none => rfl
      | some i => cases i <;> rfl
  · intro i
    cases i with
    | inl i => exact i.elim
    | inr i => cases i with
      | none =>
        let a := envelopingRepresentativeOuterHom (shape P Q) (choices P Q R)
        let b := ColoredSubstitutionData.outerProfileMap (representativeShapeHom P Q R)
        let c := emptyExtensionProfileHom (shape P Q).outerProfile ≫ outerFrozenHom P Q R
        change HEq (O.toCollection.map a ≫ O.toCollection.map b) (𝟙 _ ≫ O.toCollection.map c)
        exact heq_of_eq ((O.toCollection.map_comp a b).symm.trans
          ((congrArg O.toCollection.map (representativeShapeHom_outer P Q R)).trans
            (Category.id_comp _).symm))
      | some i => cases i with
        | inl _ => rfl
        | inr _ => rfl

/-- Actual original tensor coherence compares the full coefficient
tensor map with the original frozen substitution source, using the
proved original empty-root prefix identity. -/
theorem coefficientComparison_tensor (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    envelopingRepresentativeCoefficientTensorMap O (shape P Q) (choices P Q R) ≫
      (ColoredOperadObj.substitutionSource O.toCollection).map (representativeShapeHom P Q R) =
    (FiniteTensor.tensor (V := C)).map (coefficientComparison O.toCollection P Q R) := by
  let T := FiniteTensor.tensor (V := C)
  let K := envelopingRepresentativeCoefficients O.toCollection (shape P Q) (choices P Q R)
  let p := (frozenVariableTensorUnitIso (FintypeCat.of Empty) K).hom
  let u := T.map (envelopingRepresentativeUnitMap O (shape P Q) (choices P Q R))
  let f := T.map ((ColoredOperadObj.substitutionFactors O.toCollection).map
    (representativeShapeHom P Q R))
  let e := T.map (ZeroVariable.emptyUnitIso (FintypeCat.of Empty) K).hom
  let g := T.map (coefficientComparison O.toCollection P Q R)
  have h : u ≫ f = e ≫ g := (T.map_comp _ _).symm.trans
    ((congrArg T.map (coefficientComparison_inserted O P Q R)).trans (T.map_comp _ _))
  have hp : p ≫ e = 𝟙 (T.obj K) := ZeroVariable.emptyPrefix_unit (FintypeCat.of Empty) K
  exact (Category.assoc p u f).trans (eraseRootPrefix p u f e g h hp)

/-- The actual original representative coefficient substitution is
the original O frozen substitution after the exact coefficient/total
profile comparisons. No compatible-operation law is an input. -/
theorem representativeCoefficient_comparison (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    envelopingRepresentativeCoefficientSubstitution O (shape P Q) (choices P Q R) ≫
      O.toCollection.map (totalProfileHom P Q R) =
    (FiniteTensor.tensor (V := C)).map (coefficientComparison O.toCollection P Q R) ≫
      O.subst.app (frozenSubstitution P Q R) ≫ O.toCollection.map (frozenTotalProfileHom P
        Q R) := by
  let S := envelopingRepresentativeSubstitution (shape P Q) (choices P Q R)
  let a := envelopingRepresentativeCoefficientTensorMap O (shape P Q) (choices P Q R)
  let b := O.subst.app S
  let c := O.toCollection.map (envelopingRepresentativeTotalHom (shape P Q) (choices P Q R))
  let d := O.toCollection.map (totalProfileHom P Q R)
  let f := (ColoredOperadObj.substitutionSource O.toCollection).map (representativeShapeHom P Q R)
  let g := O.toCollection.map (ColoredSubstitutionData.totalProfileMap
    (representativeShapeHom P Q R))
  let h := O.toCollection.map (frozenTotalProfileHom P Q R)
  let s := O.subst.app (frozenSubstitution P Q R)
  let k := (FiniteTensor.tensor (V := C)).map (coefficientComparison O.toCollection P Q R)
  have hc : c ≫ d = g ≫ h := (O.toCollection.map_comp _ _).symm.trans
    ((congrArg O.toCollection.map (representativeShapeHom_total P Q R)).trans
      (O.toCollection.map_comp _ _))
  have hb : b ≫ g = f ≫ s := (O.subst.naturality (representativeShapeHom P Q R)).symm
  have ha : a ≫ f = k := coefficientComparison_tensor O P Q R
  exact compareRepresentativeCoefficient a b c d f g h s k hc hb ha


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
end EnvelopingSource310

/- Exact checked source: ConstantActionExtensionInsertion. -/
section EnvelopingSource311


/-!
# Literal original unit and coefficient insertion for the constant-input face
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem insertionRootCancel {D : Type*} [Category* D]
    {X A B Y : D} (a : X ⟶ B) (e : A ≅ B) (b : B ⟶ Y) (c : A ⟶ Y) (r : X ⟶ Y)
    (hc : c = e.hom ≫ b) (hr : a ≫ b = r) : (a ≫ e.inv) ≫ c = r := by
  rw [hc]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  exact hr

private theorem insertionUnitCancel {D : Type*} [Category* D]
    {X A B : D} (a : X ⟶ B) (e : A ≅ B) : (a ≫ e.inv) ≫ e.hom = a := by
  rw [Category.assoc, e.inv_hom_id, Category.comp_id]

private theorem insertionCoefficientFiring {D : Type*} [Category* D]
    {X A B C E F Y : D} (p : X ⟶ A) (t : A ⟶ B) (c : B ⟶ C) (d : C ⟶ Y)
    (r : B ⟶ E) (k : A ⟶ E) (s : E ⟶ F) (f : F ⟶ Y)
    (hc : c ≫ d = r ≫ s ≫ f) (ht : t ≫ r = k) :
    p ≫ t ≫ c ≫ d = (p ≫ k) ≫ s ≫ f := by
  rw [hc]
  simp only [Category.assoc]
  rw [← Category.assoc t r, ht]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original surviving variable units, root coefficient and
each original branch coefficient enter the target linear representative
through precisely their actual original empty/nullary profile comparisons. -/
def coefficientInsertion (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenVariableUnitFamily P.inputs (frozenCoefficientFamily O.toCollection P Q R) ⟶
      envelopingRepresentativeCoefficients O.toCollection (shape P Q) (choices P Q R) where
  equiv :=
    { toFun i := match i with
        | Sum.inl i => some (Sum.inl i)
        | Sum.inr none => none
        | Sum.inr (some j) => some (Sum.inr j)
      invFun i := match i with
        | none => Sum.inr none
        | some (Sum.inl i) => Sum.inl i
        | some (Sum.inr j) => Sum.inr (some j)
      left_inv i := by cases i with
        | inl _ => rfl
        | inr i => cases i <;> rfl
      right_inv i := by cases i with
        | none => rfl
        | some i => cases i <;> rfl }
  hom i := match i with
    | Sum.inl i => O.unit (P.inputColor i) ≫
        (O.toCollection.mapIso (emptyExtensionProfileIso
          (ColoredProfile.unary (P.inputColor i) (P.inputColor i)))).inv
    | Sum.inr none => O.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q)) ≫
        (O.toCollection.mapIso (emptyExtensionProfileIso (shape P Q).outerProfile)).inv
    | Sum.inr (some j) => (O.toCollection.mapIso
        (nullaryVariableProfileComponentIso (Q.obj j).as (branchInputs (R j)))).inv

/-- Actual original coefficient insertion followed by its original
shape comparison is exactly the original frozen unit/coefficient map. -/
theorem coefficientInsertion_comparison (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    coefficientInsertion O P Q R ≫ coefficientComparison O.toCollection P Q R =
      frozenUnitCoefficientMap O P Q R := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl _ => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      let e := O.toCollection.mapIso (emptyExtensionProfileIso
        (ColoredProfile.unary (P.inputColor i) (P.inputColor i)))
      change HEq ((O.unit (P.inputColor i) ≫ e.inv) ≫ e.hom) (O.unit (P.inputColor i))
      exact heq_of_eq (insertionUnitCancel (O.unit (P.inputColor i)) e)
    | inr i => cases i with
      | none =>
        let a := O.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q))
        let e := O.toCollection.mapIso (emptyExtensionProfileIso (shape P Q).outerProfile)
        let b := O.toCollection.map (outerFrozenHom P Q R)
        let c := O.toCollection.map (emptyExtensionProfileHom (shape P Q).outerProfile ≫
          outerFrozenHom P Q R)
        let r := O.toCollection.map (frozenOuterProfileHom P Q R)
        have hc : c = e.hom ≫ b := O.toCollection.map_comp _ _
        have hr : a ≫ b = r := (O.toCollection.map_comp _ _).symm.trans
          (congrArg O.toCollection.map (outerFrozenHom_source P Q R))
        exact heq_of_eq (insertionRootCancel a e b c r hc hr)
      | some j =>
        let e := O.toCollection.mapIso
          (nullaryVariableProfileComponentIso (Q.obj j).as (branchInputs (R j)))
        change HEq (e.inv ≫ e.hom) (𝟙 (O.toCollection.obj (R j).toColoredProfile))
        exact heq_of_eq e.inv_hom_id

/-- The actual original variable-unit insertion and representative
coefficient substitution are the literal original frozen partial
substitution after all original profile and coefficient maps. -/
theorem insertedCoefficient_partialSubstitution (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientInsertion O P Q R) ≫
      envelopingRepresentativeCoefficientSubstitution O (shape P Q) (choices P Q R) ≫
      O.toCollection.map (totalProfileHom P Q R) = frozenPartialSubstitution O P Q R := by
  let T := FiniteTensor.tensor (V := C)
  let p := (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom
  let t := T.map (coefficientInsertion O P Q R)
  let c := envelopingRepresentativeCoefficientSubstitution O (shape P Q) (choices P Q R)
  let d := O.toCollection.map (totalProfileHom P Q R)
  let r := T.map (coefficientComparison O.toCollection P Q R)
  let k := T.map (frozenUnitCoefficientMap O P Q R)
  let s := O.subst.app (frozenSubstitution P Q R)
  let f := O.toCollection.map (frozenTotalProfileHom P Q R)
  have hc : c ≫ d = r ≫ s ≫ f := representativeCoefficient_comparison O P Q R
  have ht : t ≫ r = k := (T.map_comp _ _).symm.trans
    (congrArg T.map (coefficientInsertion_comparison O P Q R))
  exact insertionCoefficientFiring p t c d r k s f hc ht


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
end EnvelopingSource311

/- Exact checked source: ConstantActionExtensionCofans. -/
section EnvelopingSource312


/-!
# The original rooted branch cofans inside the constant-input operad extension
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory Limits

private theorem inverseOriginalCofan {D : Type*} [Category* D]
    {X X' Y Y' : D} (e : X ≅ X') (e' : Y ≅ Y') (i : X ⟶ Y) (j : X' ⟶ Y')
    (h : i ≫ e'.hom = e.hom ≫ j) : e.inv ≫ i = j ≫ e'.inv := by
  apply (cancel_mono e'.hom).1
  rw [Category.assoc, h, ← Category.assoc e.inv e.hom, e.inv_hom_id, Category.id_comp]
  rw [Category.assoc, e'.inv_hom_id, Category.comp_id]

private theorem insertUnitCofan {D : Type*} [Category* D]
    {X A B Y : D} (u : X ⟶ A) (i : A ⟶ B) (j : B ⟶ Y) :
    (u ≫ i) ≫ j = 𝟙 X ≫ (u ≫ (i ≫ j)) := by simp only [Category.assoc, Category.id_comp]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original free O-profile cofan is the actual nullary linear
coefficient cofan under its original tensor/profile comparison. -/
theorem originalProfile_nullaryCofan (O : ColoredSymmetricCollection W C) (B : W → C)
    {d : W} (R : AnalyticIndex W d) :
    (nullaryLinearDiagramIso O B d).inv.app (branchInputs R) ≫
      linearCoefficientι O B (ColoredProfile.nullary d) (branchInputs R) =
    profileι O B R ≫ (nullaryLinearCoefficientIso O B d).inv := by
  let e := (nullaryLinearDiagramIso O B d).app (branchInputs R)
  let e' := nullaryLinearCoefficientIso O B d
  let i := linearCoefficientι O B (ColoredProfile.nullary d) (branchInputs R)
  let j := profileι O B R
  have h : i ≫ e'.hom = e.hom ≫ j := nullaryLinearCoefficientIso_ι O B d (branchInputs R)
  exact inverseOriginalCofan e e' i j h

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual constants extension map whose inputs are the original
free O-algebra carrier and whose constant coefficient is its original
nullary linear inverse comparison. -/
def collectionMap (O : ColoredOperadObj W C) (B : W → C) :
    linearCoefficientCollection O.toCollection (profileCoinvariants O.toCollection B) ⟶
      linearCoefficientCollection O.toCollection B :=
  Linear.Constants.collectionMap (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv)

/-- The original root operation uses its original inclusion and each
original free branch uses its original nullary coefficient cofan. -/
def weightedToFrozenCoefficients (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O.toCollection B P Q R ⟶
      frozenCoefficientFamily (envelopingLinearOperad O B).toCollection P Q
        (Linear.Constants.branches Q) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => originalOperationToLinear O.toCollection B (extendProfile P Q)
    | some j => profileι O.toCollection B (R j) ≫ (nullaryLinearCoefficientIso
      O.toCollection B (Q.obj j).as).inv

/-- The original variables use their actual O-units through original
empty summands, the root uses its original outer-profile map, and
every original branch uses its exact nullary tensor comparison. -/
def weightedInsertion (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenVariableUnitFamily P.inputs (frozenWeightedBranchFamily O.toCollection B P Q R) ⟶
      envelopingWeightedRepresentativeFamily O.toCollection B (shape P Q) (choices P Q R) where
  equiv := (coefficientInsertion O P Q R).equiv
  hom i := match i with
    | Sum.inl i => O.unit (P.inputColor i) ≫
        (emptyLinearSummandIso O.toCollection B (ColoredProfile.unary (P.inputColor i)
          (P.inputColor i))).inv
    | Sum.inr none => O.toCollection.map (frozenOuterProfileHom P Q (Linear.Constants.branches Q)) ≫
        (emptyLinearSummandIso O.toCollection B (shape P Q).outerProfile).inv
    | Sum.inr (some j) => (nullaryLinearDiagramIso O.toCollection B (Q.obj j).as).inv.app
      (branchInputs (R j))

/-- The original target substitution cofan is exactly the original
variable unit and original root/branch coefficient input map. -/
theorem weightedInsertion_cofan (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    weightedInsertion O B P Q R ≫ Linear.representativeCofanMap O.toCollection B (shape P
      Q) (choices P Q R) =
    Variable.unitFamilyMap (Equiv.refl P.inputs) (weightedToFrozenCoefficients O B P Q R) ≫
      frozenUnitCoefficientMap (envelopingLinearOperad O B) P Q (Linear.Constants.branches Q) := by
  simp only [Linear.representativeCofanMap_eq]
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl _ => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      exact heq_of_eq (insertUnitCofan (O.unit (P.inputColor i))
        (emptyLinearSummandIso O.toCollection B (ColoredProfile.unary (P.inputColor i)
          (P.inputColor i))).inv
        (linearCoefficientι O.toCollection B (ColoredProfile.unary (P.inputColor i)
          (P.inputColor i))
          emptyColoredInputs))
    | inr i => cases i with
      | none =>
        let f := frozenOuterProfileHom P Q (Linear.Constants.branches Q)
        let a := O.toCollection.map f
        let b := (emptyLinearSummandIso O.toCollection B (shape P Q).outerProfile).inv
        let c := linearCoefficientι O.toCollection B (shape P Q).outerProfile emptyColoredInputs
        exact heq_of_eq ((Category.assoc a b c).trans
          ((originalOperationToLinearOperadMap O B).toCollectionHom.naturality f))
      | some j =>
        exact heq_of_eq ((originalProfile_nullaryCofan O.toCollection B (R j)).trans
          (Category.comp_id _).symm)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
