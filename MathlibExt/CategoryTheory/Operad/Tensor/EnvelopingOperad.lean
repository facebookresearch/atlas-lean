section EnvelopingSource220


/-!
# Exact original empty-constant coefficient normalization
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- The actual empty constant coefficient block and every original
variable singleton are the original coefficient/variable family. -/
def emptyConstantRawIso (X : C) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested ((coefficientLeafFamilyFunctor (FiniteFamily.empty :
          FiniteFamily C)).obj X) L) ≅
      (coefficientLeafFamilyFunctor L).obj X :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨none, none⟩ => none
        | ⟨none, some e⟩ => e.elim
        | ⟨some i, _⟩ => some i
      invFun p := match p with
        | none => ⟨none, none⟩
        | some i => ⟨some i, PUnit.unit⟩
      left_inv p := by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j with
          | none => rfl
          | some j => cases j
        | some i => cases j; rfl
      right_inv p := by cases p <;> rfl }
    (fun p => match p with
      | ⟨none, none⟩ => Iso.refl X
      | ⟨none, some e⟩ => e.elim
      | ⟨some i, _⟩ => Iso.refl (L.obj i))

/-- The original empty coefficient comparison and original
singleton normalization retain exactly the original raw inputs. -/
theorem emptyConstantRawIso_factor (X : C) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (emptyLeafFamilyIso X).hom (𝟙 L)) ≫
        (FiniteFamily.flatten (C := C)).map (singletonCoefficientLeavesIso X L).hom ≫
        FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj X) =
      (emptyConstantRawIso X L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none => rfl
      | some j => cases j
    | some i => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])
      | some j => cases j
    | some i =>
      cases j
      let Y := L.obj i
      change HEq (𝟙 Y ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 Y)
      exact heq_of_eq (by simp only [Category.id_comp])

private theorem originalEmptyNormalizationFiring {V : Type*} [Category* V]
    {X A B D E Y : V} (n : X ⟶ A) (a : A ⟶ B) (b : B ⟶ Y)
    (r : X ⟶ D) (m : D ⟶ B) (s : D ⟶ E) (t : E ⟶ Y)
    (ha : n ≫ a = r ≫ m) (hb : m ≫ b = s ≫ t) :
    n ≫ (a ≫ b) = r ≫ s ≫ t := by
  rw [← Category.assoc n a, ha, Category.assoc r m, hb]

variable [FiniteTensor C]

/-- Normalizing an actual empty constant coefficient block is
precisely the original coefficient/variable tensor map, with the
actual empty-leaf tensor unitor and all original leaf positions. -/
theorem emptyConstantNormalization (X : C) (L : FiniteFamily C) :
    (coefficientLeavesNormalizationIso
      ((coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).obj X) L).hom ≫
        (coefficientLeafTensorFunctor L).map (emptyLeafTensorIso X).hom =
      (FiniteTensor.tensor (V := C)).map (emptyConstantRawIso X L).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let K := (coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).obj X
  let S := (FiniteFamily.singleton (C := C)).obj X
  let k := (emptyLeafFamilyIso X).hom
  let n := coefficientLeavesNormalization K L
  let a := (coefficientLeafTensorFunctor L).map (T.map k)
  let b := (coefficientLeafTensorFunctor L).map ((FiniteTensor.singletonIso (V := C)).hom.app X)
  let r := T.map (F.map (coefficientLeavesNestedMap k (𝟙 L)))
  let m := coefficientLeavesNormalization S L
  let s := T.map (F.map (singletonCoefficientLeavesIso X L).hom)
  let t := T.map (FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor
    L).obj X))
  have hid : T.map (coefficientLeafMap (T.map k) (𝟙 L)) = a :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map k) L)
  have ha : n ≫ a = r ≫ m :=
    ((congrArg (n ≫ ·) hid).symm.trans (coefficientLeavesNormalization_naturality k (𝟙 L)).symm)
  have hb : m ≫ b = s ≫ t :=
    (coefficientLeavesNormalization_singleton X L).trans (T.map_comp _ _)
  have h := originalEmptyNormalizationFiring n a b r m s t ha hb
  have hu : (coefficientLeafTensorFunctor L).map (emptyLeafTensorIso X).hom = a ≫ b :=
    (congrArg (coefficientLeafTensorFunctor L).map (emptyLeafTensorIso_hom X)).trans
      ((coefficientLeafTensorFunctor L).map_comp _ _)
  let r₀ := F.map (coefficientLeavesNestedMap k (𝟙 L))
  let s₀ := F.map (singletonCoefficientLeavesIso X L).hom
  let t₀ := FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj X)
  have hm : r ≫ s ≫ t = T.map (r₀ ≫ s₀ ≫ t₀) :=
    (congrArg (T.map r₀ ≫ ·) (T.map_comp s₀ t₀).symm).trans
      (T.map_comp r₀ (s₀ ≫ t₀)).symm
  have hraw : r ≫ s ≫ t = T.map (emptyConstantRawIso X L).hom :=
    hm.trans (congrArg T.map (emptyConstantRawIso_factor X L))
  exact (congrArg (· ≫ (coefficientLeafTensorFunctor L).map (emptyLeafTensorIso X).hom)
    (coefficientLeavesNormalizationIso_hom K L)).trans
      ((congrArg (n ≫ ·) hu).trans (h.trans hraw))


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
