/- Exact checked source: ConstantActionExtensionInputs. -/
section EnvelopingSource313


/-!
# Exact original rooted free-profile input maps for the constant-input extension
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory Limits

private theorem inputMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem rootedInputFinish {D : Type*} [Category* D]
    {X A B C E Y : D} (i : X ⟶ A) (c : A ⟶ B) (s : B ⟶ C) (t : C ⟶ Y)
    (a : X ⟶ E) (b : E ⟶ B) (h : i ≫ c = a ≫ b) :
    i ≫ (c ≫ s ≫ t) = a ≫ b ≫ s ≫ t := by
  rw [← Category.assoc i c, h]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used by the rooted free-profile maps for constant-input extension. -/
local instance {d : W} (P : AnalyticIndex W d) (i : analyticFactorsIndex P) :
    Category.{0} (profileSlotIndex P i) := profileSlotCategory P i

/-- The original coefficient is fixed, and every original branch
input uses exactly its original free O-algebra profile injection. -/
def originalWeightedInputMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O B P Q R ⟶
      (coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs
        (profileCoinvariants O B))).obj Q where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 (O.obj (extendProfile P Q))
    | some j => profileι O B (R j)

/-- The original rooted-slot cocone is the original weighted family
followed by all original profile injections into its original free inputs. -/
theorem rootedFrozenSummandInjection_weighted (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O B P Q R =
      (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O B P Q R).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (originalWeightedInputMap O B P Q (rootedFrozenBranches P Q R)) := by
  let T := FiniteTensor.tensor (V := C)
  let I := analyticFactorsIndex ((inputsToProfile P.outputColor).obj Q)
  let f := (FiniteFamily.fixedIndexFunctor I).map
    (fun i => (rootedSlotCocone (O.obj (extendProfile P Q)) O B ((inputsToProfile
      P.outputColor).obj Q) i).ι.app (R i))
  let e := (rootedFrozenPointFamilyIso O B P Q).hom
  let a := (rootedFrozenFamilyIso O B P Q R).hom
  let b := originalWeightedInputMap O B P Q (rootedFrozenBranches P Q R)
  have h : f ≫ e = a ≫ b := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none =>
        let X := O.obj (extendProfile P Q)
        change HEq (𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        rfl
      | some j =>
        let c := profileι O B (R (some j))
        change HEq (c ≫ 𝟙 _) (𝟙 _ ≫ c)
        exact heq_of_eq ((Category.comp_id c).trans (Category.id_comp c).symm)
  exact (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Every original free input cofan under the candidate constants
map is precisely the original root/branch map into target coefficients. -/
theorem originalWeightedInputMap_coefficients (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    originalWeightedInputMap O.toCollection B P Q R ≫
      Linear.Constants.coefficientMap (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
          O.toCollection B d).inv) P Q =
    weightedToFrozenCoefficients O B P Q R := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some _ => rfl

/-- The actual original rooted free-input tensor cofan feeds the
candidate constants map through exactly its original weighted
root/branch coefficient map, including every nullary branch. -/
theorem rootedFrozenSummandInjection_coefficients (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫
      (FiniteTensor.tensor (V := C)).map
        (Linear.Constants.coefficientMap (originalOperationToLinearOperadMap O B)
          (profileCoinvariants O.toCollection B) (fun d =>
            (nullaryLinearCoefficientIso O.toCollection B d).inv) P Q) =
    (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (weightedToFrozenCoefficients O B P Q (rootedFrozenBranches P Q R)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (rootedFrozenFamilyIso O.toCollection B P Q R).hom
  let b := T.map (originalWeightedInputMap O.toCollection B P Q (rootedFrozenBranches P Q R))
  let c := T.map (Linear.Constants.coefficientMap (originalOperationToLinearOperadMap O B)
    (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
      O.toCollection B d).inv) P Q)
  have hmap : b ≫ c = T.map (weightedToFrozenCoefficients O B P Q (rootedFrozenBranches P Q R)) :=
    (T.map_comp _ _).symm.trans
      (congrArg T.map (originalWeightedInputMap_coefficients O B P Q (rootedFrozenBranches P Q R)))
  exact (congrArg (· ≫ c) (rootedFrozenSummandInjection_weighted O.toCollection B P Q R)).trans
    ((Category.assoc a b c).trans (congrArg (a ≫ ·) hmap))

/-- Every original rooted input cofan evaluates the candidate
extension by the target's actual nullary partial substitution on
the exact original root/branch coefficient tensor map. -/
theorem rootedRepresentative_coefficients (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫
      Linear.Constants.representative (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
          O.toCollection B d).inv) P Q =
    (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (weightedToFrozenCoefficients O B P Q (rootedFrozenBranches P Q R)) ≫
      frozenPartialSubstitution (envelopingLinearOperad O B) P Q (Linear.Constants.branches Q) ≫
      (envelopingLinearOperad O B).toCollection.map (Linear.Constants.totalProfileHom P Q) := by
  exact rootedInputFinish (rootedFrozenSummandInjection O.toCollection B P Q R)
    ((FiniteTensor.tensor (V := C)).map
      (Linear.Constants.coefficientMap (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
          O.toCollection B d).inv) P Q))
    (frozenPartialSubstitution (envelopingLinearOperad O B) P Q (Linear.Constants.branches Q))
    ((envelopingLinearOperad O B).toCollection.map (Linear.Constants.totalProfileHom P Q))
    ((FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom)
    ((FiniteTensor.tensor (V := C)).map (weightedToFrozenCoefficients O B P Q
      (rootedFrozenBranches P Q R)))
    (rootedFrozenSummandInjection_coefficients O B P Q R)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
end EnvelopingSource313

/- Exact checked source: ConstantActionExtensionEvaluation. -/
section EnvelopingSource314


/-!
# The literal linear substitution cofan of the constant-input extension
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory Limits

private theorem prefixCofanFiring {D : Type*} [Category* D]
    {X A B C E F G H J Y : D}
    (c : X ⟶ A) (p : A ⟶ B) (u : B ⟶ C) (s : C ⟶ E) (m : E ⟶ Y)
    (p' : X ⟶ F) (v : F ⟶ B) (w : F ⟶ G) (i : G ⟶ C)
    (e : G ⟶ H) (j : H ⟶ E) (r : H ⟶ J) (j' : J ⟶ Y)
    (hp : c ≫ p = p' ≫ v) (hu : v ≫ u = w ≫ i) (hs : i ≫ s = e ≫ j)
    (hm : j ≫ m = r ≫ j') :
    c ≫ p ≫ u ≫ s ≫ m = p' ≫ w ≫ e ≫ r ≫ j' := by
  rw [← Category.assoc c p, hp]
  simp only [Category.assoc]
  rw [← Category.assoc v u, hu]
  simp only [Category.assoc]
  rw [← Category.assoc i s, hs]
  simp only [Category.assoc]
  rw [hm]

private theorem prefixTailFiring {D : Type*} [Category* D]
    {X A B C E F Y : D} (c : X ⟶ A) (p : A ⟶ B) (u : B ⟶ C) (s : C ⟶ E)
    (t : E ⟶ F) (r : F ⟶ Y) (m : E ⟶ Y) (h : t ≫ r = m) :
    c ≫ ((p ≫ u) ≫ s ≫ t) ≫ r = c ≫ p ≫ u ≫ s ≫ m := by
  simp only [Category.assoc]
  rw [h]

private theorem mapPrefixCofanSquare {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B B' C : D} (a : A ⟶ B) (b : B ⟶ C) (a' : A ⟶ B') (b' : B' ⟶ C)
    (h : a ≫ b = a' ≫ b') : F.map a ≫ F.map b = F.map a' ≫ F.map b' :=
  (F.map_comp _ _).symm.trans ((congrArg F.map h).trans (F.map_comp _ _))

private theorem appendPrefixCofan {D : Type*} [Category* D]
    {X A B C E F Y : D} (p : X ⟶ A) (c : A ⟶ B) (s : B ⟶ Y)
    (a : A ⟶ C) (b : C ⟶ E) (d : E ⟶ F) (j : F ⟶ Y)
    (h : c ≫ s = a ≫ b ≫ d ≫ j) : p ≫ c ≫ s = p ≫ a ≫ b ≫ d ≫ j :=
  congrArg (p ≫ ·) h

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The target linear operad's actual nullary partial substitution
on original rooted coefficients is the original representative
substitution cofan, with all original variable/constant profile maps. -/
theorem weightedRepresentative_linear_cofan (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (weightedToFrozenCoefficients O B P Q R) ≫
      frozenPartialSubstitution (envelopingLinearOperad O B) P Q (Linear.Constants.branches Q) ≫
      (envelopingLinearOperad O B).toCollection.map (Linear.Constants.totalProfileHom P Q) =
    (frozenVariableTensorUnitIso P.inputs (frozenWeightedBranchFamily O.toCollection B P Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map (weightedInsertion O B P Q R) ≫
      envelopingRepresentativeEvaluation O B (shape P Q) (choices P Q R) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
          ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom)) ≫
      linearCoefficientι O.toCollection B P (frozenTotalInputs Q R) := by
  let T := FiniteTensor.tensor (V := C)
  let E := envelopingLinearOperad O B
  let R₀ := Linear.Constants.branches Q
  let S := shape P Q
  let c := T.map (weightedToFrozenCoefficients O B P Q R)
  let p := (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily E.toCollection P Q
    R₀)).hom
  let u := T.map (frozenUnitCoefficientMap E P Q R₀)
  let s := E.subst.app S
  let t := E.toCollection.map (frozenTotalProfileHom P Q R₀)
  let a := E.toCollection.map (Linear.Constants.totalProfileHom P Q)
  let m := E.toCollection.map (Linear.Constants.substitutionTotalHom P Q)
  let p' := (frozenVariableTensorUnitIso P.inputs (frozenWeightedBranchFamily O.toCollection
    B P Q R)).hom
  let v := T.map (Variable.unitFamilyMap (Equiv.refl P.inputs) (weightedToFrozenCoefficients
    O B P Q R))
  let w := T.map (weightedInsertion O B P Q R)
  let i := T.map (Linear.representativeCofanMap O.toCollection B S (choices P Q R))
  let e := envelopingRepresentativeEvaluation O B S (choices P Q R)
  let j := linearCoefficientι O.toCollection B S.totalProfile (envelopingTotalAlgebraInputs
    S (choices P Q R))
  let r := T.map (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
    ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom))
  let j' := linearCoefficientι O.toCollection B P (frozenTotalInputs Q R)
  have ht : t ≫ a = m := (E.toCollection.map_comp _ _).symm
  have hp : c ≫ p = p' ≫ v :=
    Variable.tensorUnitIso_naturality (Equiv.refl P.inputs) (weightedToFrozenCoefficients O B P Q R)
  have hu : v ≫ u = w ≫ i :=
    mapPrefixCofanSquare T (weightedInsertion O B P Q R)
      (Linear.representativeCofanMap O.toCollection B S (choices P Q R))
      (Variable.unitFamilyMap (Equiv.refl P.inputs) (weightedToFrozenCoefficients O B P Q R))
      (frozenUnitCoefficientMap E P Q R₀) (weightedInsertion_cofan O B P Q R) |>.symm
  have hs : i ≫ s = e ≫ j := Linear.representativeCofanMap_β O B S (choices P Q R)
  have hm : j ≫ m = r ≫ j' :=
    (linearCoefficientι_joint O.toCollection B (Linear.Constants.substitutionTotalHom P Q)
      (totalInputsIso P Q R).hom).symm
  have hread : c ≫ frozenPartialSubstitution E P Q R₀ ≫ a = c ≫ p ≫ u ≫ s ≫ m :=
    prefixTailFiring c p u s t a m ht
  exact hread.trans (prefixCofanFiring c p u s m p' v w i e j r j' hp hu hs hm)

/-- Every original rooted-slot cofan reads the candidate constants
extension as its literal linear substitution cofan with the original
root/variable units, every original branch and total input maps. -/
theorem rootedRepresentative_linear_cofan (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫
      Linear.Constants.representative (originalOperationToLinearOperadMap O B)
        (profileCoinvariants O.toCollection B) (fun d => (nullaryLinearCoefficientIso
          O.toCollection B d).inv) P Q =
    (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom ≫
      (frozenVariableTensorUnitIso P.inputs
        (frozenWeightedBranchFamily O.toCollection B P Q (rootedFrozenBranches P Q R))).hom ≫
      (FiniteTensor.tensor (V := C)).map (weightedInsertion O B P Q (rootedFrozenBranches P Q R)) ≫
      envelopingRepresentativeEvaluation O B (shape P Q) (choices P Q (rootedFrozenBranches
        P Q R)) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q (rootedFrozenBranches P Q R)))
          ((addedAlgebraInputs B).map (totalInputsIso P Q (rootedFrozenBranches P Q R)).hom)) ≫
      linearCoefficientι O.toCollection B P (frozenTotalInputs Q (rootedFrozenBranches P Q R)) := by
  let p := (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom
  let h := weightedRepresentative_linear_cofan O B P Q (rootedFrozenBranches P Q R)
  exact (rootedRepresentative_coefficients O B P Q R).trans (congrArg (p ≫ ·) h)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
end EnvelopingSource314

/- Exact checked source: ConstantActionExtensionRootedNormalization. -/
section EnvelopingSource315


/-!
# Original rooted weighted normalization as full coefficient/input interchange
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem rootedNormalizationFiring {D : Type*} [Category* D]
    {X A B C E F G Y : D}
    (r : X ⟶ A) (f : A ⟶ B) (n : B ⟶ C) (i : C ⟶ E) (v : E ⟶ F) (l : F ⟶ Y)
    (n' : A ⟶ G) (g : G ⟶ C) (j : G ⟶ Y) (t : E ⟶ Y)
    (hn : f ≫ n = n' ≫ g) (hv : v ≫ l = t) (hi : g ≫ i ≫ t = j) :
    (r ≫ f) ≫ (n ≫ i ≫ v) ≫ l = r ≫ n' ≫ j := by
  simp only [Category.assoc]
  rw [hv, ← Category.assoc f n, hn]
  simp only [Category.assoc]
  rw [hi]

private theorem rootedAppendNorm {D : Type*} [Category* D]
    {X A B C Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ C) (n : C ⟶ Y) :
    a ≫ b ≫ (c ≫ n) = (a ≫ b ≫ c) ≫ n := by simp only [Category.assoc]

private theorem rootedFinishNorm {D : Type*} [Category* D]
    {X A B C Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ C) (n n' : C ⟶ Y)
    (h : n = n') : a ≫ b ≫ (c ≫ n) = ((a ≫ b) ≫ c) ≫ n' := by
  rw [h]
  simp only [Category.assoc]

private theorem rootedMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original root has no B leaf and each original branch has
precisely the original B inputs of its original full profile. -/
def rootedLeafBlocks (B : W → C) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    Option Q.index → FiniteFamily C
  | none => FiniteFamily.empty
  | some j => profileLeafFamily B (R j).toColoredProfile

/-- The original root singleton and branch operation factors become
their original coefficient/input blocks through actual empty/profile isos. -/
def rootedCombinedIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedNestedFamily O B P Q R ≅
      combinedInputBlocks (FintypeCat.of (Option Q.index)) (frozenCoefficientFamily O P Q R).obj
        (rootedLeafBlocks B Q R) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => (emptyLeafFamilyIso (O.obj (extendProfile P Q))).symm
    | some j => (profileOperationFactorsIso O B (R j).toColoredProfile).symm)

/-- The original dependent leaf family removes only the empty root
input block and keeps every original branch/input position and object. -/
def rootedLeavesIso (B : W → C) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    totalBlockInputs (FintypeCat.of (Option Q.index)) (rootedLeafBlocks B Q R) ≅
      frozenAlgebraLeaves B Q R :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | ⟨none, j⟩ => j.elim
        | ⟨some i, j⟩ => ⟨i, j⟩
      invFun p := ⟨some p.1, p.2⟩
      left_inv p := by rcases p with ⟨i, j⟩; cases i with
        | none => exact j.elim
        | some _ => rfl
      right_inv _ := rfl }
    (fun p => match p with
      | ⟨none, j⟩ => j.elim
      | ⟨some i, j⟩ => Iso.refl (B ((R i).inputColor j)))

/-- The actual original full source coefficient/leaf maps are the
original rooted normalization bijection, including every empty branch. -/
theorem rootedCombined_rawSquare (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).map (rootedCombinedIso O B P Q R).hom ≫
      (coefficientBlockInterchangeFamilyIso (FintypeCat.of (Option Q.index))
        (frozenCoefficientFamily O P Q R).obj (rootedLeafBlocks B Q R)).hom ≫
      (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (𝟙 (frozenCoefficientFamily O P Q R))
          (rootedLeavesIso B Q R).hom) =
    (frozenBranchLeafIso O B P Q R).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some _ => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j
      let X := O.obj (extendProfile P Q)
      change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some i => cases j with
      | none =>
        let X := O.obj (R i).toColoredProfile
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])
      | some j =>
        let X := B ((R i).inputColor j)
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

variable [FiniteTensor C]

/-- The actual rooted coefficient and branch tensor values enter
their original coefficient/input blocks through original unitors only. -/
def rootedWeightedToCombined (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O B P Q R ⟶
      weightedInputBlockFamily (FintypeCat.of (Option Q.index)) (frozenCoefficientFamily O P
        Q R).obj
        (rootedLeafBlocks B Q R) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => (emptyLeafTensorIso (O.obj (extendProfile P Q))).inv
    | some j => (FiniteTensor.tensor (V := C)).map (profileOperationFactorsIso O B (R
      j).toColoredProfile).inv

/-- The original rooted tensor singleton comparison and original
coefficient/profile maps are precisely the displayed weighted input map. -/
theorem rootedWeightedToCombined_factor (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenWeightedRootIso O B P Q R).hom ≫
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rootedCombinedIso O B P Q R).hom =
    rootedWeightedToCombined O B P Q R := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => rfl
    | some j => exact heq_of_eq (Category.id_comp _)

/-- The original rooted weighted normalizer is exactly the original
coefficient/input block interchange and original full leaf comparison. -/
theorem rootedInterchange_normalization (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (rootedWeightedToCombined O B P Q R) ≫
      (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option Q.index))
        (frozenCoefficientFamily O P Q R).obj (rootedLeafBlocks B Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
          C)).obj (frozenCoefficientFamily O P Q R)))
          (rootedLeavesIso B Q R).hom) =
    (frozenBranchTensorNormalizationIso O B P Q R).hom := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option Q.index)
  let K := frozenCoefficientFamily O P Q R
  let L := rootedLeafBlocks B Q R
  let N := frozenWeightedNestedFamily O B P Q R
  let M := combinedInputBlocks I K.obj L
  let a := (rootedCombinedIso O B P Q R).hom
  let r := T.map (frozenWeightedRootIso O B P Q R).hom
  let f := T.map ((FiniteFamily.map T).map a)
  let n := (FiniteTensor.flattenIso (V := C)).inv.app M
  let i₀ := (coefficientBlockInterchangeFamilyIso I K.obj L).hom
  let i := T.map i₀
  let v := coefficientLeavesNormalization K (totalBlockInputs I L)
  let ell := (rootedLeavesIso B Q R).hom
  let l := T.map (coefficientLeafMap (𝟙 (T.obj K)) ell)
  let n' := (FiniteTensor.flattenIso (V := C)).inv.app N
  let g₀ := (FiniteFamily.flatten (C := C)).map a
  let g := T.map g₀
  let t₀ := (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap (𝟙 K) ell)
  let t := T.map t₀
  let ν := coefficientLeavesNormalization K (frozenAlgebraLeaves B Q R)
  let j := T.map (frozenBranchLeafIso O B P Q R).hom ≫ ν
  have hn : f ≫ n = n' ≫ g := (FiniteTensor.flattenIso (V := C)).inv.naturality a
  have hl : v ≫ l = t ≫ ν :=
    (congrArg (v ≫ ·) (congrArg (fun k => T.map (coefficientLeafMap k ell)) (T.map_id
      K))).symm.trans
      (coefficientLeavesNormalization_naturality (𝟙 K) ell).symm
  have hi : g ≫ i ≫ (t ≫ ν) = j :=
    (rootedAppendNorm g i t ν).trans
      (congrArg (· ≫ ν) ((rootedMapThree T g₀ i₀ t₀).symm.trans
        (congrArg T.map (rootedCombined_rawSquare O B P Q R))))
  have hmap : T.map (rootedWeightedToCombined O B P Q R) = r ≫ f :=
    (congrArg T.map (rootedWeightedToCombined_factor O B P Q R).symm).trans (T.map_comp _ _)
  have hread : (coefficientBlockInterchangeTensorIso I K.obj L).hom = n ≫ i ≫ v :=
    congrArg (fun v => n ≫ i ≫ v) (coefficientLeavesNormalizationIso_hom K (totalBlockInputs I L))
  have hroute : (r ≫ f) ≫ (n ≫ i ≫ v) ≫ l = r ≫ n' ≫ j :=
    rootedNormalizationFiring r f n i v l n' g j (t ≫ ν) hn hl hi
  have hfinish : r ≫ n' ≫ j = (frozenBranchTensorNormalizationIso O B P Q R).hom :=
    (by
      have hreadOld : (frozenBranchTensorNormalizationIso O B P Q R).hom =
          ((r ≫ n') ≫ T.map (frozenBranchLeafIso O B P Q R).hom) ≫
            (coefficientLeavesNormalizationIso K (frozenAlgebraLeaves B Q R)).hom := by
        dsimp only [frozenBranchTensorNormalizationIso, Iso.trans_hom, Iso.symm_hom,
          Functor.mapIso_hom]
        simp only [Category.assoc, r, n', T, K, N, Iso.app_inv]
      exact (rootedFinishNorm r n' (T.map (frozenBranchLeafIso O B P Q R).hom) ν
        (coefficientLeavesNormalizationIso K (frozenAlgebraLeaves B Q R)).hom
        (coefficientLeavesNormalizationIso_hom K (frozenAlgebraLeaves B Q R)).symm).trans
          hreadOld.symm)
  exact (congrArg₂ (fun w i => w ≫ i ≫ l) hmap hread).trans (hroute.trans hfinish)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
