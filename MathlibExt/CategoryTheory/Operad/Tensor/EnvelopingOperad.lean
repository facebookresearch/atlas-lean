/- Exact checked source: WeightedNormalization.CommonSourceFactorization. -/
section EnvelopingSource192


/-!
# Factor both exact original weighted common-source maps to atomic normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

private theorem combineFinalMaps {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The exact original branch-first common source uses the genuine
grouped coefficient normalizer, coefficient flattening inverse, and every
original displayed algebra-input correction. -/
theorem commonSourceA_grouped (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedCommonSourceIso O B d Q).hom =
      (FiniteTensor.tensor (V := C)).map (weightedSourceIsoA O B d Q).hom ≫
        groupedCoefficientInputNormalization (envelopingAssocCoefficientBlocks O d Q)
          (coefficientInputsA O B d Q) ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap
            ((FiniteTensor.flattenIso (V := C)).inv.app (envelopingAssocCoefficientBlocks O d Q))
            (leavesIsoA O B d Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let N := envelopingAssocCoefficientBlocks O d Q
  let a := T.map (weightedSourceIsoA O B d Q).hom
  let n := groupedCoefficientInputNormalization N (coefficientInputsA O B d Q)
  let l := (FiniteFamily.flatten (C := C)).map (inputBlocksIsoA O B d Q).hom
  let c := (envelopingAssocFullCoefficientTensorIso O d Q).hom
  let f := (envelopingAssocAlgebraLeafIso B d Q).hom
  let e := (envelopingAssocWeightedCommonFactorsIso O B d Q).hom
  let p := T.map (coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N))) l)
  let q := T.map e
  let h := T.map (coefficientLeafMap ((FiniteTensor.flattenIso (V := C)).inv.app N)
    (leavesIsoA O B d Q).hom)
  have hc : 𝟙 (T.obj ((FiniteFamily.map T).obj N)) ≫ c =
      (FiniteTensor.flattenIso (V := C)).inv.app N :=
    (Category.id_comp c).trans (fullCoefficientTensorIsoA_hom O d Q)
  have hl : l ≫ f = (leavesIsoA O B d Q).hom := rfl
  have he : coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N))) l ≫ e =
      coefficientLeafMap ((FiniteTensor.flattenIso (V := C)).inv.app N)
        (leavesIsoA O B d Q).hom :=
    (congrArg (coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N))) l ≫ ·)
      (commonFactorsIsoA_hom O B d Q)).trans
        ((coefficientLeafMap_comp _ _ _ _).trans
          (congrArg₂ (fun coeff leaf => coefficientLeafMap coeff leaf) hc hl))
  have ht : p ≫ q = h := (T.map_comp _ _).symm.trans (congrArg T.map he)
  have hb := weightedBlockNormalizerA_grouped O B d Q
  exact (congrArg (· ≫ q) hb).trans
    ((combineFinalMaps a n p q).trans (congrArg (fun k => a ≫ n ≫ k) ht))

/-- The exact original root-first common source retains its original
weighted permutation, genuine grouped coefficient unflattening, original
coefficient regrouping inverse, and complete original total-input map. -/
theorem commonSourceB_grouped (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedRootFirstCommonSourceIso O B d Q).hom =
      (FiniteTensor.tensor (V := C)).map (weightedSourceIsoB O B d Q).hom ≫
        groupedCoefficientInputNormalization (envelopingAssocRootFirstCoefficientBlocks O d Q)
          (coefficientInputsB O B d Q) ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap
            ((FiniteTensor.flattenIso (V := C)).inv.app
                (envelopingAssocRootFirstCoefficientBlocks O d Q) ≫
              (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstCoefficientIso O d Q).inv)
            (leavesIsoB O B d Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let N := envelopingAssocRootFirstCoefficientBlocks O d Q
  let a := T.map (weightedSourceIsoB O B d Q).hom
  let n := groupedCoefficientInputNormalization N (coefficientInputsB O B d Q)
  let l := (FiniteFamily.flatten (C := C)).map (inputBlocksIsoB O B d Q).hom
  let c := (envelopingAssocRootFirstFullCoefficientTensorIso O d Q).hom
  let f := (envelopingAssocRootFirstLeafIso B d Q).hom
  let e := (coefficientLeafIso (envelopingAssocRootFirstFullCoefficientTensorIso O d Q)
    (envelopingAssocRootFirstLeafIso B d Q)).hom
  let p := T.map (coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N))) l)
  let q := T.map e
  let k := (FiniteTensor.flattenIso (V := C)).inv.app N ≫
    T.map (envelopingAssocRootFirstCoefficientIso O d Q).inv
  let h := T.map (coefficientLeafMap k (leavesIsoB O B d Q).hom)
  have hc : 𝟙 (T.obj ((FiniteFamily.map T).obj N)) ≫ c = k :=
    (Category.id_comp c).trans (fullCoefficientTensorIsoB_hom O d Q)
  have hl : l ≫ f = (leavesIsoB O B d Q).hom := rfl
  have he : coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.map T).obj N))) l ≫ e =
      coefficientLeafMap k (leavesIsoB O B d Q).hom :=
    (coefficientLeafMap_comp (𝟙 (T.obj ((FiniteFamily.map T).obj N))) c l f).trans
      (congrArg₂ (fun coeff leaf => coefficientLeafMap coeff leaf) hc hl)
  have ht : p ≫ q = h := (T.map_comp _ _).symm.trans (congrArg T.map he)
  have hb := weightedBlockNormalizerB_grouped O B d Q
  exact (congrArg (· ≫ q) hb).trans
    ((combineFinalMaps a n p q).trans (congrArg (fun k => a ≫ n ≫ k) ht))

/-- The exact original branch-first weighted common-source hom is
its original flat atomic source, actual tensor interchange, original
complete coefficient tensor, and exact original dependent leaf map. -/
theorem commonSourceA_atomic (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedCommonSourceIso O B d Q).hom =
      (FiniteTensor.tensor (V := C)).map (atomicSourceIsoA O B d Q).hom ≫
        (coefficientBlockInterchangeTensorIso (envelopingAssocCoefficients O d Q).index
          (envelopingAssocCoefficients O d Q).obj (coefficientInputsA O B d Q)).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
            C)).obj (envelopingAssocCoefficients O d Q)))
            (atomicLeavesIsoA O B d Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let N := envelopingAssocCoefficientBlocks O d Q
  let L := coefficientInputsA O B d Q
  let K := envelopingAssocCoefficients O d Q
  let a := T.map (weightedSourceIsoA O B d Q).hom
  let b := T.map (Grouping.atomicWeightedIso N L).hom
  let i := (coefficientBlockInterchangeTensorIso K.index K.obj L).hom
  let q := T.map (coefficientLeafMap (𝟙 (T.obj K)) (atomicLeavesIsoA O B d Q).hom)
  have hg := commonSourceA_grouped O B d Q
  have hf := normalizeGroupedAfterLeafMap N L (leavesIsoA O B d Q).hom
  have ha := flatAtomicAfterCoefficientMap N L (𝟙 (T.obj K)) (leavesIsoA O B d Q).hom
  have hm : T.map (atomicSourceIsoA O B d Q).hom = a ≫ b := T.map_comp _ _
  exact hg.trans ((congrArg (a ≫ ·) hf).trans
    ((congrArg (a ≫ ·) ha).trans
      ((Category.assoc a b (i ≫ q)).symm.trans
        (congrArg (fun c => c ≫ i ≫ q) hm.symm))))

/-- The exact original root-first weighted common-source hom uses
its original atomic source, actual interchange, original coefficient
regrouping inverse, and complete original dependent algebra-leaf map. -/
theorem commonSourceB_atomic (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedRootFirstCommonSourceIso O B d Q).hom =
      (FiniteTensor.tensor (V := C)).map (atomicSourceIsoB O B d Q).hom ≫
        (coefficientBlockInterchangeTensorIso
          ((FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstCoefficientBlocks O
            d Q)).index
          ((FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstCoefficientBlocks O
            d Q)).obj
          (coefficientInputsB O B d Q)).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map
              (envelopingAssocRootFirstCoefficientIso O d Q).inv)
            (atomicLeavesIsoB O B d Q).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let N := envelopingAssocRootFirstCoefficientBlocks O d Q
  let L := coefficientInputsB O B d Q
  let K := (FiniteFamily.flatten (C := C)).obj N
  let a := T.map (weightedSourceIsoB O B d Q).hom
  let b := T.map (Grouping.atomicWeightedIso N L).hom
  let i := (coefficientBlockInterchangeTensorIso K.index K.obj L).hom
  let k := T.map (envelopingAssocRootFirstCoefficientIso O d Q).inv
  let q := T.map (coefficientLeafMap k (atomicLeavesIsoB O B d Q).hom)
  have hg := commonSourceB_grouped O B d Q
  have hf := normalizeGroupedAfterCoefficientMap N L k (leavesIsoB O B d Q).hom
  have ha := flatAtomicAfterCoefficientMap N L k (leavesIsoB O B d Q).hom
  have hm : T.map (atomicSourceIsoB O B d Q).hom = a ≫ b := T.map_comp _ _
  exact hg.trans ((congrArg (a ≫ ·) hf).trans
    ((congrArg (a ≫ ·) ha).trans
      ((Category.assoc a b (i ≫ q)).symm.trans
        (congrArg (fun c => c ≫ i ≫ q) hm.symm))))


end CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

end
