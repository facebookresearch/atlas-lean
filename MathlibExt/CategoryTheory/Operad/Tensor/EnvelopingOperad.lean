    (T.map_comp _ _).symm.trans (congrArg T.map heC0)
  have heJ : T.map E.inv ≫ (z ≫ rF) = T.map eJ.inv :=
    (congrArg (T.map E.inv ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans (congrArg T.map heJ0))
