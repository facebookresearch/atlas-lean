/-!
# Full genuine enveloping and original under-A algebra round trips
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance roundTripIsoFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

private theorem carrierEqualityArrowId {D : Type*} [Category* D] {X : D} (h : X = X) :
    eqToHom h = 𝟙 X := rfl

/-- Reconstructing the actual enveloping algebra recovers every
original heterogeneous and nullary operation on the original carrier. -/
theorem envelopingUnderA_roundTrip_operations (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    HEq (underAEnvelopingObject O A (envelopingUnderAObject O A M)).operations M.operations :=
  algebraOperations_heq_of_eq
    (M := underAEnvelopingObject O A (envelopingUnderAObject O A M)) (N := M)
    (envelopingUnderA_roundTrip_algebra O A M)

/-- The complete enveloping algebra round trip is a genuine algebra
isomorphism retaining the original entire carrier equality arrows. -/
def envelopingUnderARoundTripIso (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    underAEnvelopingObject O A (envelopingUnderAObject O A M) ≅ M :=
  @envelopingAlgebraDataIso.{uc, u, v, us} W C inferInstance (FiniteTensor.ofSymmetric C)
    inferInstance inferInstance (FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C)
    O A (underAEnvelopingObject O A (envelopingUnderAObject O A M)) M
    (envelopingUnderA_roundTrip_carrier O A M) (envelopingUnderA_roundTrip_original O A M)
    (heq_of_eq (envelopingUnderA_roundTrip_constants O A M))

/-- The entire original carrier is retained by the full forward round-trip isomorphism. -/
theorem envelopingUnderA_roundTripIso_hom (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    (envelopingUnderARoundTripIso O A M).hom.hom = 𝟙 M.carrier := by
  have h := @envelopingAlgebraDataIso_hom.{uc, u, v, us} W C inferInstance
    (FiniteTensor.ofSymmetric C)
    inferInstance inferInstance (FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C)
    O A (underAEnvelopingObject O A (envelopingUnderAObject O A M)) M
    (envelopingUnderA_roundTrip_carrier O A M) (envelopingUnderA_roundTrip_original O A M)
    (heq_of_eq (envelopingUnderA_roundTrip_constants O A M))
  exact h.trans (carrierEqualityArrowId (envelopingUnderA_roundTrip_carrier O A M))

/-- The entire original carrier is retained by the full inverse round-trip isomorphism. -/
theorem envelopingUnderA_roundTripIso_inv (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    (envelopingUnderARoundTripIso O A M).inv.hom = 𝟙 M.carrier := by
  have h := @envelopingAlgebraDataIso_inv.{uc, u, v, us} W C inferInstance
    (FiniteTensor.ofSymmetric C)
    inferInstance inferInstance (FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C)
    O A (underAEnvelopingObject O A (envelopingUnderAObject O A M)) M
    (envelopingUnderA_roundTrip_carrier O A M) (envelopingUnderA_roundTrip_original O A M)
    (heq_of_eq (envelopingUnderA_roundTrip_constants O A M))
  exact h.trans (carrierEqualityArrowId (envelopingUnderA_roundTrip_carrier O A M).symm)

/-- The actual original O-algebra round trip retains every original
heterogeneous and nullary operation on the unchanged original carrier. -/
theorem underAEnveloping_roundTrip_operations (O : ColoredOperadObj W C) (A : Algebra O) (B
  : Under A) :
    (envelopingUnderAObject O A (underAEnvelopingObject O A B)).right.operations =
      B.right.operations :=
  eq_of_heq (algebraOperations_heq_of_eq
    (M := (envelopingUnderAObject O A (underAEnvelopingObject O A B)).right) (N := B.right)
    (underAEnvelopingObject_underlying O A B))

/-- The original O-algebra round trip is a genuine full algebra
isomorphism with literal original carrier identity arrows. -/
def underAEnvelopingRoundTripAlgebraIso (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    (envelopingUnderAObject O A (underAEnvelopingObject O A B)).right ≅ B.right where
  hom :=
    { hom := 𝟙 B.right.carrier
      comm d P := ColoredOperadObj.Reflexive.AlgebraDescent.identityOperationComm
        (underAEnveloping_roundTrip_operations O A B) d P }
  inv :=
    { hom := 𝟙 B.right.carrier
      comm d P := ColoredOperadObj.Reflexive.AlgebraDescent.identityOperationComm
        (underAEnveloping_roundTrip_operations O A B).symm d P }
  hom_inv_id := Algebra.Hom.ext (Category.id_comp _)
  inv_hom_id := Algebra.Hom.ext (Category.id_comp _)

/-- The genuine original under-A round trip preserves the original
whole A-arrow, by the derived exact original constant readback. -/
def underAEnvelopingRoundTripIso (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    envelopingUnderAObject O A (underAEnvelopingObject O A B) ≅ B :=
  Under.isoMk (underAEnvelopingRoundTripAlgebraIso O A B)
    (Algebra.Hom.ext ((Category.comp_id _).trans (underAEnvelopingObject_underA_hom O A B)))

/-- The whole original carrier identity is retained by the under-A round-trip isomorphism. -/
theorem underAEnveloping_roundTripIso_hom (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    (underAEnvelopingRoundTripIso O A B).hom.right.hom = 𝟙 B.right.carrier := rfl

/-- The inverse under-A round-trip isomorphism retains the whole original carrier identity. -/
theorem underAEnveloping_roundTripIso_inv (O : ColoredOperadObj W C) (A : Algebra O) (B : Under A) :
    (underAEnvelopingRoundTripIso O A B).inv.right.hom = 𝟙 B.right.carrier := rfl


end CategoryTheory.Operad.Tensor.Enveloping

