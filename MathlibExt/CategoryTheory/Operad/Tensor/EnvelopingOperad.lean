/- Exact checked source: UnitCoefficientLaw. -/
section EnvelopingSource034


/-!
# Original coefficient unit law from finite prefix fusion and O.right_unit

The actual Q-unit coefficient insertion, followed by the original frozen
variable units, is the original complete right-unit insertion at P ⊔ Q.
The original operad right-unit axiom then proves the coefficient equation.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

private theorem normalizeFactorPrefix {V : Type*} [Category* V]
    {X A B D E F : V} (p : X ⟶ A) (u : A ⟶ B) (g : B ⟶ D)
    (f : X ⟶ E) (n : E ⟶ D) (b : D ⟶ F) (m : E ⟶ F)
    (hm : m = n ≫ b) (h : f ≫ n = p ≫ u ≫ g) :
    f ≫ m = p ≫ u ≫ (g ≫ b) := by
  rw [hm, ← Category.assoc f n, h]
  simp only [Category.assoc]

private theorem fuseInsertionSquares {V : Type*} [Category* V]
    {X A B D E F G H K R : V} (p : X ⟶ A) (a : A ⟶ B) (l : B ⟶ D)
    (b : D ⟶ E) (g : E ⟶ F) (h : F ⟶ G) (b' : B ⟶ H) (u : H ⟶ E)
    (r : H ⟶ K) (k : A ⟶ K) (v : K ⟶ R) (w : R ⟶ G)
    (hn : l ≫ b = b' ≫ u) (hf : a ≫ b' ≫ r = k) (hu : u ≫ g ≫ h = r ≫ v ≫ w) :
    (p ≫ a ≫ l) ≫ (b ≫ g) ≫ h = p ≫ k ≫ v ≫ w := by
  simp only [Category.assoc]
  rw [← Category.assoc l b, hn]
  simp only [Category.assoc]
  rw [hu]
  have hc := congrArg (fun t => p ≫ t ≫ v ≫ w) hf
  simpa only [Category.assoc] using hc

private theorem evaluateInsertionSquares {V : Type*} [Category* V]
    {X A B D E F G H : V} (i : X ⟶ A) (a : A ⟶ B) (s : B ⟶ D)
    (t : D ⟶ E) (r : E ⟶ F) (h : B ⟶ G) (s' : G ⟶ H) (k : H ⟶ F)
    (q : D ⟶ H) (j : X ⟶ G) (hi : i ≫ a ≫ h = j)
    (hs : s ≫ q = h ≫ s') (ht : t ≫ r = q ≫ k) :
    i ≫ (a ≫ s ≫ t) ≫ r = j ≫ s' ≫ k := by
  simp only [Category.assoc]
  rw [ht, ← Category.assoc s q, hs]
  have hc := congrArg (fun z => z ≫ s' ≫ k) hi
  simpa only [Category.assoc] using hc

private theorem EnvelopingSource034_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by
  simp only [Functor.map_comp]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- An actual normalized right factor preserves the original frozen
unit prefix and its exact option bijection, for every coefficient map. -/
theorem rightInsertFromNormalizedFactor (X : C) (I : FintypeCat.{0})
    {F : FiniteFamily C} (f : unitRootFamily X I ⟶ F) :
    UnitInsertion.rightInsertFromFactor X I (rightRootNormalizer X I ≫ f) =
      (FiniteTensor.singletonIso (V := C)).inv.app X ≫
        (frozenVariableTensorUnitIso I ((FiniteFamily.singleton (C := C)).obj X)).hom ≫
        (FiniteTensor.tensor (V := C)).map ((rightUnitPositionIso X I).hom ≫ f) := by
  let T := FiniteTensor.tensor (V := C)
  let p := (FiniteTensor.singletonIso (V := C)).inv.app X
  let u := (frozenVariableTensorUnitIso I ((FiniteFamily.singleton (C := C)).obj X)).hom
  let g := T.map (rightUnitPositionIso X I).hom
  let a := UnitInsertion.rightInsertPrefix X I
  let n := T.map (rightRootNormalizer X I)
  let b := T.map f
  have hm : T.map (rightRootNormalizer X I ≫ f) = n ≫ b := T.map_comp _ _
  have h := normalizeFactorPrefix p u g a n b (T.map (rightRootNormalizer X I ≫ f)) hm
    (rightInsertPrefix_normalized X I)
  exact h.trans (congrArg (fun k => p ≫ u ≫ k) (T.map_comp (rightUnitPositionIso X I).hom f).symm)

variable {W : Type u}

/-- The actual original Q-unit coefficient insertion is its original
frozen Q-unit prefix followed by its actual colored coefficient map. -/
theorem unaryCoefficientInsertion_normalized (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    Weighted.unaryCoefficientUnitInsertion O P Q =
      (FiniteTensor.singletonIso (V := C)).inv.app (O.toCollection.obj (extendProfile P Q)) ≫
        (frozenVariableTensorUnitIso Q.index
          ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj (extendProfile P Q)))).hom ≫
        (FiniteTensor.tensor (V := C)).map
          ((rightUnitPositionIso (O.toCollection.obj (extendProfile P Q)) Q.index).hom ≫
            unaryCoefficientBareMap O P Q) :=
  (congrArg (UnitInsertion.rightInsertFromFactor (O.toCollection.obj (extendProfile P Q)) Q.index)
    (unaryCoefficientFactor_normalized O P Q)).trans
      (rightInsertFromNormalizedFactor _ _ (unaryCoefficientBareMap O P Q))

/-- The actual original complete right-unit insertion has its
original frozen unit prefix and original colored right factor map. -/
theorem rightUnitInsertion_normalized (O : ColoredOperadObj W C) (E : ColoredProfile W) :
    ColoredOperadObj.rightUnitInsert O.toCollection O.unit E =
      (FiniteTensor.singletonIso (V := C)).inv.app (O.toCollection.obj E) ≫
        (frozenVariableTensorUnitIso E.inputs
          ((FiniteFamily.singleton (C := C)).obj (O.toCollection.obj E))).hom ≫
        (FiniteTensor.tensor (V := C)).map
          ((rightUnitPositionIso (O.toCollection.obj E) E.inputs).hom ≫
            rightCoefficientBareMap O E) :=
  (congrArg (UnitInsertion.rightInsertFromFactor (O.toCollection.obj E) E.inputs)
    (rightCoefficientFactor_normalized O E)).trans
      (rightInsertFromNormalizedFactor _ _ (rightCoefficientBareMap O E))

/-- The actual original constant and variable unit insertions fuse
to the complete original operad right-unit insertion at P ⊔ Q. -/
theorem unaryCoefficient_unitInsert_fusion (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    Weighted.unaryCoefficientUnitInsertion O P Q ≫
        frozenSubstitutionCoefficientTensorMap O P Q (unaryBranches Q) ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (unaryToRightSubstitutionMap P Q) =
      ColoredOperadObj.rightUnitInsert O.toCollection O.unit (extendProfile P Q) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let L := (FiniteFamily.singleton (C := C)).obj X
  let R := frozenCoefficientFamily O.toCollection P Q (unaryBranches Q)
  let p := (FiniteTensor.singletonIso (V := C)).inv.app X
  let a := (frozenVariableTensorUnitIso Q.index L).hom
  let l := (rightUnitPositionIso X Q.index).hom ≫ unaryCoefficientBareMap O P Q
  let b := (frozenVariableTensorUnitIso P.inputs R).hom
  let b' := (frozenVariableTensorUnitIso P.inputs (frozenVariableUnitFamily Q.index L)).hom
  let um := frozenVariableUnitFamilyMap P.inputs l
  let g := frozenUnitCoefficientMap O P Q (unaryBranches Q)
  let h := (ColoredOperadObj.substitutionFactors O.toCollection).map
    (unaryToRightSubstitutionMap P Q)
  let r := (prefixUnitReindexIso P.inputs Q.index L).hom
  let k := (frozenVariableTensorUnitIso (extendProfile P Q).inputs L).hom
  let v := (rightUnitPositionIso X (extendProfile P Q).inputs).hom
  let w := rightCoefficientBareMap O (extendProfile P Q)
  have hn : T.map l ≫ b = b' ≫ T.map um := frozenVariableTensorUnitIso_naturality P.inputs l
  have hf : a ≫ b' ≫ T.map r = k := tensorUnitPrefix_fusion P.inputs Q.index L
  have hu : T.map um ≫ T.map g ≫ T.map h = T.map r ≫ T.map v ≫ T.map w :=
    (EnvelopingSource034_mapThree T um g h).symm.trans
      ((congrArg T.map (fusedUnitCoefficientFactors O P Q)).trans
        (EnvelopingSource034_mapThree T r v w))
  have h0 := fuseInsertionSquares p a (T.map l) b (T.map g) (T.map h) b' (T.map um)
    (T.map r) k (T.map v) (T.map w) hn hf hu
  have h1 := congrArg (fun z => z ≫ frozenSubstitutionCoefficientTensorMap O P Q (unaryBranches Q) ≫
    (ColoredOperadObj.substitutionSource O.toCollection).map (unaryToRightSubstitutionMap P Q))
      (unaryCoefficientInsertion_normalized O P Q)
  have h2 : p ≫ k ≫ T.map v ≫ T.map w = p ≫ k ≫ T.map (v ≫ w) :=
    congrArg (fun z => p ≫ k ≫ z) (T.map_comp v w).symm
  exact h1.trans (h0.trans (h2.trans (rightUnitInsertion_normalized O (extendProfile P Q)).symm))

/-- The original operad right-unit law proves the actual original
partial coefficient substitution preserves its original root after
the exact total algebra-input sigma-unit bijection. -/
theorem unaryPartialSubstitution_unit (O : ColoredOperadObj W C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    Weighted.unaryCoefficientUnitInsertion O P Q ≫
        frozenPartialSubstitution O P Q (unaryBranches Q) ≫
        O.toCollection.map (extendProfileMap (𝟙 P) (unaryTotalInputsIso Q).hom) =
      𝟙 (O.toCollection.obj (extendProfile P Q)) := by
  let i := Weighted.unaryCoefficientUnitInsertion O P Q
  let a := frozenSubstitutionCoefficientTensorMap O P Q (unaryBranches Q)
  let s := O.subst.app (frozenSubstitution P Q (unaryBranches Q))
  let t := O.toCollection.map (frozenTotalProfileHom P Q (unaryBranches Q))
  let r := O.toCollection.map (extendProfileMap (𝟙 P) (unaryTotalInputsIso Q).hom)
  let f := unaryToRightSubstitutionMap P Q
  let h := (ColoredOperadObj.substitutionSource O.toCollection).map f
  let s' := O.subst.app (ColoredSubstitutionData.rightUnit (extendProfile P Q))
  let k := O.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom (extendProfile P Q))
  let q := O.toCollection.map (ColoredSubstitutionData.totalProfileMap f)
  let j := ColoredOperadObj.rightUnitInsert O.toCollection O.unit (extendProfile P Q)
  have hi : i ≫ a ≫ h = j := unaryCoefficient_unitInsert_fusion O P Q
  have hs : s ≫ q = h ≫ s' := (O.subst.naturality f).symm
  have ht : t ≫ r = q ≫ k := (O.toCollection.map_comp _ _).symm.trans
    ((congrArg O.toCollection.map (unaryToRight_total P Q)).trans (O.toCollection.map_comp _ _))
  exact (evaluateInsertionSquares i a s t r h s' k q j hi hs ht).trans (O.right_unit
    (extendProfile P Q))


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
end EnvelopingSource034

/- Exact checked source: ReflexiveOperad.FrozenPrefixReindex. -/
section EnvelopingSource035


/-!
# The original frozen unit prefix under its actual finite-index bijection
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.RightUnitGeometry

open CategoryTheory

variable {C : Type w} [Category.{v} C]

/-- Relabel only the original empty blocks; all retained singleton blocks remain unchanged. -/
def blocksReindex {I J : FintypeCat.{0}} (e : I ≃ J) (L : FiniteFamily C) :
    frozenVariableBlocks I L ⟶ frozenVariableBlocks J L where
  equiv := Equiv.sumCongr e (Equiv.refl L.index)
  hom i := match i with | Sum.inl _ => 𝟙 _ | Sum.inr _ => 𝟙 _

/-- Flattening the relabelled empty blocks preserves the original retained family map. -/
theorem flattenReindex {I J : FintypeCat.{0}} (e : I ≃ J) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map (blocksReindex e L) ≫ (frozenVariableFlattenIso J L).hom =
      (frozenVariableFlattenIso I L).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro x
    rcases x with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => cases j; rfl
  · intro x
    rcases x with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => cases j; exact heq_of_eq (Category.id_comp _)

variable [FiniteTensor C]

/-- Relabel exactly the original unit positions and retain all original coefficients. -/
def unitsReindex {I J : FintypeCat.{0}} (e : I ≃ J) (L : FiniteFamily C) :
    frozenVariableUnitFamily I L ⟶ frozenVariableUnitFamily J L where
  equiv := Equiv.sumCongr e (Equiv.refl L.index)
  hom i := match i with | Sum.inl _ => 𝟙 _ | Sum.inr _ => 𝟙 _

/-- The original block unitors commute with the actual unit-position bijection. -/
theorem blockReindex {I J : FintypeCat.{0}} (e : I ≃ J) (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (blocksReindex e L) ≫
        (frozenVariableBlockIso J L).hom =
      (frozenVariableBlockIso I L).hom ≫ unitsReindex e L := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | inl i =>
        exact heq_of_eq ((congrArg (· ≫ 𝟙 _) ((FiniteTensor.tensor (V := C)).map_id
          (FiniteFamily.empty : FiniteFamily C))))
    | inr i =>
        exact heq_of_eq ((congrArg (· ≫ (FiniteTensor.singletonIso (V := C)).hom.app (L.obj i))
          ((FiniteTensor.tensor (V := C)).map_id ((FiniteFamily.singleton (C :=
            C)).obj (L.obj i)))).trans
          ((Category.id_comp _).trans (Category.comp_id _).symm))

omit [FiniteTensor C] in
private theorem reindexPrefixFold {X A B D E F H : C}
    (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ D) (r : D ⟶ H)
    (m : A ⟶ E) (d : X ⟶ E) (e : E ⟶ F) (n : B ⟶ F) (f : F ⟶ H)
    (ha : a ≫ m = d) (hb : m ≫ e = b ≫ n) (hc : n ≫ f = c ≫ r) :
    (a ≫ b ≫ c) ≫ r = d ≫ e ≫ f := by
  simp only [Category.assoc]
  rw [← hc, ← Category.assoc b n, ← hb]
  simpa only [Category.assoc] using congrArg (fun k => k ≫ e ≫ f) ha

/-- The actual frozen tensor-unit insertion commutes with every actual
finite unit-position bijection, with all retained strands unchanged. -/
theorem tensorPrefixReindex {I J : FintypeCat.{0}} (e : I ≃ J) (L : FiniteFamily C) :
    (frozenVariableTensorUnitIso I L).hom ≫ (FiniteTensor.tensor (V := C)).map (unitsReindex e L) =
      (frozenVariableTensorUnitIso J L).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let m := blocksReindex e L
  let eI := frozenVariableFlattenIso I L
  let eJ := frozenVariableFlattenIso J L
  have hi : eI.inv ≫ F.map m = eJ.inv := by
    apply (cancel_mono eJ.hom).1
    exact (Category.assoc _ _ _).trans
      ((congrArg (eI.inv ≫ ·) (flattenReindex e L)).trans
        (eI.inv_hom_id.trans eJ.inv_hom_id.symm))
  have ha : T.map eI.inv ≫ T.map (F.map m) = T.map eJ.inv :=
    (T.map_comp _ _).symm.trans (congrArg T.map hi)
  have hb := (FiniteTensor.flattenIso (V := C)).hom.naturality m
  have hc := congrArg T.map (blockReindex e L)
  rw [T.map_comp, T.map_comp] at hc
  exact reindexPrefixFold (T.map eI.inv)
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I L))
    (T.map (frozenVariableBlockIso I L).hom) (T.map (unitsReindex e L))
    (T.map (F.map m)) (T.map eJ.inv)
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks J L))
    (T.map ((FiniteFamily.map T).map m)) (T.map (frozenVariableBlockIso J L).hom) ha hb hc


end CategoryTheory.Operad.Tensor.Enveloping.Linear.RightUnitGeometry

end
end EnvelopingSource035

/- Exact checked source: EnvelopingSubstitutionProfiles. -/
section EnvelopingSource036


/-!
# Original representative profiles for enveloping-operad substitution

Each original variable branch carries its original added algebra
inputs. Root algebra inputs are retained as original nullary
parameters by inserting their original unary units.
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- One original algebra-input choice for the root coefficient
and every original variable branch coefficient. -/
abbrev EnvelopingInputChoices (s : ColoredSubstitutionData W) :=
  Option s.inner.index → ColoredInputs W

/-- The original root/inner operation substitution profiles,
with original unary profiles at retained root algebra positions. -/
def envelopingInnerProfiles (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    FiniteFamily (ColoredProfile W) where
  index := FintypeCat.of (s.inner.index ⊕ (Q none).index)
  obj i := match i with
    | Sum.inl i => extendProfile (s.inner.obj i) (Q (some i))
    | Sum.inr j => ColoredProfile.unary ((Q none).obj j).as ((Q none).obj j).as

/-- The representative substitution with extended variable branches and unary profiles for root
algebra inputs. -/
def envelopingRepresentativeSubstitution (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    ColoredSubstitutionData W where
  outputColor := s.outputColor
  inner := envelopingInnerProfiles s Q

/-- The original outer coefficient profile is compared with the
original substitution root by the identity on every displayed
variable/root-algebra position and actual pointwise colors. -/
def envelopingRepresentativeOuterHom (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    extendProfile s.outerProfile (Q none) ⟶ (envelopingRepresentativeSubstitution s
      Q).outerProfile where
  inputEquiv := Equiv.refl (s.inner.index ⊕ (Q none).index)
  inputColor_eq i := by cases i <;> rfl
  outputColor_eq := rfl

/-- The original total algebra inputs retain the root input
block and every original dependent inner-branch algebra input. -/
def envelopingTotalAlgebraInputs (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    ColoredInputs W where
  index := FintypeCat.of ((Q none).index ⊕ (Σ i : s.inner.index, (Q (some i)).index))
  obj j := match j with
    | Sum.inl j => (Q none).obj j
    | Sum.inr j => (Q (some j.1)).obj j.2

/-- The original total variable/root-algebra/inner-algebra
profile positions, through their actual displayed input bijection. -/
def envelopingRepresentativeTotalEquiv (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (envelopingRepresentativeSubstitution s Q).totalProfile.inputs ≃
      s.totalProfile.inputs ⊕ (envelopingTotalAlgebraInputs s Q).index where
  toFun p := match p with
    | ⟨Sum.inl i, Sum.inl j⟩ => Sum.inl ⟨i, j⟩
    | ⟨Sum.inl i, Sum.inr j⟩ => Sum.inr (Sum.inr ⟨i, j⟩)
    | ⟨Sum.inr j, _⟩ => Sum.inr (Sum.inl j)
  invFun p := match p with
    | Sum.inl p => ⟨Sum.inl p.1, Sum.inl p.2⟩
    | Sum.inr (Sum.inl j) => ⟨Sum.inr j, PUnit.unit⟩
    | Sum.inr (Sum.inr p) => ⟨Sum.inl p.1, Sum.inr p.2⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j <;> rfl
    | inr i => cases j; rfl
  right_inv p := by
    cases p with
    | inl p => rfl
    | inr p => cases p <;> rfl

/-- The actual original total profile comparison keeps every
original variable/algebra color and the original root output. -/
def envelopingRepresentativeTotalHom (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (envelopingRepresentativeSubstitution s Q).totalProfile ⟶
      extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q) where
  inputEquiv := envelopingRepresentativeTotalEquiv s Q
  inputColor_eq p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j <;> rfl
    | inr i => rfl
  outputColor_eq := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource036

/- Exact checked source: EnvelopingSubstitutionCoefficients. -/
section EnvelopingSource037


/-!
# Actual original coefficient maps for enveloping substitution representatives
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The actual original root and variable-branch operation
coefficients, before tensoring their retained algebra inputs. -/
def envelopingRepresentativeCoefficients (O : ColoredSymmetricCollection W C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) : FiniteFamily C where
  index := FintypeCat.of (Option s.inner.index)
  obj i := match i with
    | none => O.obj (extendProfile s.outerProfile (Q none))
    | some i => O.obj (extendProfile (s.inner.obj i) (Q (some i)))

/-- The exact original frozen root-algebra unit positions and
retained root/variable-branch coefficient positions. -/
def envelopingRepresentativeCoefficientEquiv (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    (Q none).index ⊕ Option s.inner.index ≃ Option (s.inner.index ⊕ (Q none).index) where
  toFun p := match p with
    | Sum.inl j => some (Sum.inr j)
    | Sum.inr none => none
    | Sum.inr (some i) => some (Sum.inl i)
  invFun p := match p with
    | none => Sum.inr none
    | some (Sum.inl i) => Sum.inr (some i)
    | some (Sum.inr j) => Sum.inl j
  left_inv p := by
    cases p with
    | inl j => rfl
    | inr p => cases p <;> rfl
  right_inv p := by
    cases p with
    | none => rfl
    | some p => cases p <;> rfl

variable [FiniteTensor C]

/-- Actual original operadic units at retained root-algebra
inputs, the original outer coefficient comparison, and identities
on each original variable-branch coefficient. -/
def envelopingRepresentativeUnitMap (O : ColoredOperadObj W C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    frozenVariableUnitFamily (Q none).index (envelopingRepresentativeCoefficients
      O.toCollection s Q) ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj
        (envelopingRepresentativeSubstitution s Q) where
  equiv := envelopingRepresentativeCoefficientEquiv s Q
  hom p := match p with
    | Sum.inl j => O.unit ((Q none).obj j).as
    | Sum.inr none => O.toCollection.map (envelopingRepresentativeOuterHom s Q)
    | Sum.inr (some i) => 𝟙 (O.toCollection.obj (extendProfile (s.inner.obj i) (Q (some i))))

/-- The constructed tensor-unit insertion and original
coefficient maps give the actual original substitution source. -/
def envelopingRepresentativeCoefficientTensorMap (O : ColoredOperadObj W C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (envelopingRepresentativeCoefficients O.toCollection s Q) ⟶
      (ColoredOperadObj.substitutionSource O.toCollection).obj
        (envelopingRepresentativeSubstitution s Q) :=
  (frozenVariableTensorUnitIso (Q none).index (envelopingRepresentativeCoefficients
    O.toCollection s Q)).hom ≫
    (FiniteTensor.tensor (V := C)).map (envelopingRepresentativeUnitMap O s Q)

/-- Actual original operadic substitution on root and branch
coefficients, with all root/inner algebra input positions retained
through the exact original total-profile comparison. -/
def envelopingRepresentativeCoefficientSubstitution (O : ColoredOperadObj W C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (envelopingRepresentativeCoefficients O.toCollection s Q) ⟶
      O.toCollection.obj (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q)) :=
  envelopingRepresentativeCoefficientTensorMap O s Q ≫
    O.subst.app (envelopingRepresentativeSubstitution s Q) ≫
      O.toCollection.map (envelopingRepresentativeTotalHom s Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource037

/- Exact checked source: CoefficientBlockInterchange. -/
section EnvelopingSource038


/-!
# Original finite coefficient/input block tensor interchange

All original coefficient factors are grouped together and all
original input factors retain their dependent-sum positions. This
is constructed from source finite tensor flattening and explicit
original finite-family bijections.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- The finite family of coefficient factors indexed by `I`. -/
def coefficientBlockFamily (I : FintypeCat.{0}) (K : I → C) : FiniteFamily C := ⟨I, K⟩

/-- The family of input blocks indexed by the coefficient positions. -/
def inputBlockFamily (I : FintypeCat.{0}) (L : I → FiniteFamily C) : FiniteFamily
  (FiniteFamily C) := ⟨I, L⟩

/-- The original total finite input family, retaining the exact
dependent-sum positions and original objects in every block. -/
def totalBlockInputs (I : FintypeCat.{0}) (L : I → FiniteFamily C) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (inputBlockFamily I L)

/-- The original coefficient/input factors in every block. -/
def combinedInputBlocks (I : FintypeCat.{0}) (K : I → C) (L : I → FiniteFamily C) :
    FiniteFamily (FiniteFamily C) where
  index := I
  obj i := (coefficientLeafFamilyFunctor (L i)).obj (K i)

/-- The exact coefficient/input block interchange bijection:
every coefficient goes to its original coefficient position and
every original input keeps its original dependent-sum index. -/
def coefficientBlockInterchangeEquiv (I : FintypeCat.{0}) (K : I → C) (L : I → FiniteFamily C) :
    ((FiniteFamily.flatten (C := C)).obj (combinedInputBlocks I K L)).index ≃
      ((FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (coefficientBlockFamily I K) (totalBlockInputs I L))).index where
  toFun p := match p with
    | ⟨i, none⟩ => ⟨none, i⟩
    | ⟨i, some j⟩ => ⟨some ⟨i, j⟩, PUnit.unit⟩
  invFun p := match p with
    | ⟨none, i⟩ => ⟨i, none⟩
    | ⟨some ⟨i, j⟩, _⟩ => ⟨i, some j⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases j <;> rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => rcases i with ⟨i, k⟩; cases j; rfl

/-- The displayed original block interchange preserves every
actual original coefficient and every actual retained input object. -/
def coefficientBlockInterchangeFamilyIso (I : FintypeCat.{0}) (K : I → C) (L : I → FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (combinedInputBlocks I K L) ≅
      (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested (coefficientBlockFamily I K) (totalBlockInputs I L)) :=
  FiniteFamily.isoOfReindex (coefficientBlockInterchangeEquiv I K L) (by
    intro p
    rcases p with ⟨i, j⟩
    cases j <;> rfl)

variable [FiniteTensor C]

/-- The original tensor of coefficient/input blocks, before
grouping any coefficient or any retained input factor. -/
def weightedInputBlockFamily (I : FintypeCat.{0}) (K : I → C) (L : I →
  FiniteFamily C) : FiniteFamily C :=
  (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (combinedInputBlocks I K L)

/-- Group the actual finite coefficient tensor and the original
total input family by original finite flattening/singleton coherence.
All arities, including empty coefficient and empty input blocks, are covered. -/
def coefficientBlockInterchangeTensorIso (I : FintypeCat.{0}) (K : I → C) (L : I → FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).obj (weightedInputBlockFamily I K L) ≅
      (coefficientLeafTensorFunctor (totalBlockInputs I L)).obj
        ((FiniteTensor.tensor (V := C)).obj (coefficientBlockFamily I K)) :=
  ((FiniteTensor.flattenIso (V := C)).app (combinedInputBlocks I K L)).symm ≪≫
    (FiniteTensor.tensor (V := C)).mapIso (coefficientBlockInterchangeFamilyIso I K L) ≪≫
      coefficientLeavesNormalizationIso (coefficientBlockFamily I K) (totalBlockInputs I L)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource038

/- Exact checked source: EnvelopingRepresentativeEvaluation. -/
section EnvelopingSource039


/-!
# Actual substitution evaluation on original enveloping coefficient representatives
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original variable profile of every coefficient slot,
including the original root profile at the coefficient position. -/
def envelopingSlotProfile (s : ColoredSubstitutionData W) : Option s.inner.index → ColoredProfile W
  | none => s.outerProfile
  | some i => s.inner.obj i

/-- The original coefficient/input tensor for each root or
variable-branch representative, retaining each supplied input family. -/
def envelopingWeightedRepresentativeFamily (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) : FiniteFamily C :=
  weightedInputBlockFamily (FintypeCat.of (Option s.inner.index))
    (fun i => O.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (fun i => (addedAlgebraInputs A).obj (Q i))

/-- The original total root/inner algebra-leaf family before
the displayed root-plus-inner ordering comparison. -/
def envelopingBlockAlgebraLeaves (A : W → C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) : FiniteFamily C :=
  totalBlockInputs (FintypeCat.of (Option s.inner.index)) (fun i =>
    (addedAlgebraInputs A).obj (Q i))

/-- The exact original root/inner algebra position bijection. -/
def envelopingAlgebraLeafEquiv (A : W → C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    (envelopingBlockAlgebraLeaves A s Q).index ≃ (envelopingTotalAlgebraInputs s Q).index where
  toFun p := match p with
    | ⟨none, j⟩ => Sum.inl j
    | ⟨some i, j⟩ => Sum.inr ⟨i, j⟩
  invFun p := match p with
    | Sum.inl j => ⟨none, j⟩
    | Sum.inr p => ⟨some p.1, p.2⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases i <;> rfl
  right_inv p := by cases p <;> rfl

/-- The actual original algebra-leaf bijection preserves every
original algebra object at its root or dependent inner position. -/
def envelopingAlgebraLeafIso (A : W → C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    envelopingBlockAlgebraLeaves A s Q ≅
      (addedAlgebraInputs A).obj (envelopingTotalAlgebraInputs s Q) :=
  FiniteFamily.isoOfReindex (envelopingAlgebraLeafEquiv A s Q) (by
    intro p
    rcases p with ⟨i, j⟩
    cases i <;> rfl)

/-- The generic coefficient block retains exactly the original
named root/inner coefficient family, through identities at every
original coefficient position. -/
def envelopingCoefficientBlockIso (O : ColoredSymmetricCollection W C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    coefficientBlockFamily (FintypeCat.of (Option s.inner.index))
      (fun i => O.obj (extendProfile (envelopingSlotProfile s i) (Q i))) ≅
        envelopingRepresentativeCoefficients O s Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index)) (fun i => match i with
    | none => Iso.refl _
    | some _ => Iso.refl _)

/-- Original operadic substitution evaluates the normalized
coefficient tensor while retaining each original root/inner algebra
input object and its displayed actual total input map. -/
def envelopingRepresentativeEvaluation (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily
      O.toCollection A s Q) ⟶
      (linearCoefficientDiagram O.toCollection A s.totalProfile).obj
        (envelopingTotalAlgebraInputs s Q) :=
  (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
    (fun i => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (fun i => (addedAlgebraInputs A).obj (Q i))).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection
            s Q).hom ≫
            envelopingRepresentativeCoefficientSubstitution O s Q)
          (envelopingAlgebraLeafIso A s Q).hom)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The actual original root/branch representative substitution
lands in the original total linear coefficient colimit. This is
before descent through the algebra-relation quotients. -/
def envelopingRepresentativeColimitEvaluation (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily
      O.toCollection A s Q) ⟶
      linearCoefficient O.toCollection A s.totalProfile :=
  envelopingRepresentativeEvaluation O A s Q ≫
    linearCoefficientι O.toCollection A s.totalProfile (envelopingTotalAlgebraInputs s Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource039

/- Exact checked source: VariableTensorUnits. -/
section EnvelopingSource040


/-!
# Actual tensor unit insertion under variable-position bijections

Both the frozen variable positions and the retained coefficient positions
may be permuted. The comparison is built from the original empty/singleton
flattening and singleton tensor isomorphisms, including empty families.
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Variable

open CategoryTheory

private theorem inverseSquare {V : Type*} [Category* V]
    {A B X Y : V} (e : A ≅ X) (d : B ≅ Y) (k : A ⟶ B) (l : X ⟶ Y)
    (h : k ≫ d.hom = e.hom ≫ l) : l ≫ d.inv = e.inv ≫ k := by
  apply (cancel_epi e.hom).1
  rw [← Category.assoc, ← h, Category.assoc, d.hom_inv_id, Category.comp_id,
    ← Category.assoc e.hom e.inv, e.hom_inv_id, Category.id_comp]

private theorem EnvelopingSource040_composeThreeSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable {C : Type w} [Category.{v} C]

/-- The actual variable-position bijection acts on the empty blocks,
and every retained position uses its original singleton map. -/
def blocksMap {I J : FintypeCat.{0}} (e : I ≃ J) {L M : FiniteFamily C} (l : L ⟶ M) :
    frozenVariableBlocks I L ⟶ frozenVariableBlocks J M where
  equiv := Equiv.sumCongr e l.equiv
  hom i := match i with
    | Sum.inl _ => 𝟙 FiniteFamily.empty
    | Sum.inr j => (FiniteFamily.singleton (C := C)).map (l.hom j)

/-- The exact original empty/singleton flattening commutes with both
the variable bijection and every original retained-family map. -/
theorem flattenIso_naturality {I J : FintypeCat.{0}} (e : I ≃ J)
    {L M : FiniteFamily C} (l : L ⟶ M) :
    (FiniteFamily.flatten (C := C)).map (blocksMap e l) ≫ (frozenVariableFlattenIso J M).hom =
      (frozenVariableFlattenIso I L).hom ≫ l := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j
    | inr i =>
      change HEq (l.hom i ≫ 𝟙 _) (𝟙 _ ≫ l.hom i)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- The original inverse flattening comparison retains the same
variable bijection and retained object maps. -/
theorem flattenIso_inv_naturality {I J : FintypeCat.{0}} (e : I ≃ J)
    {L M : FiniteFamily C} (l : L ⟶ M) :
    l ≫ (frozenVariableFlattenIso J M).inv =
      (frozenVariableFlattenIso I L).inv ≫ (FiniteFamily.flatten (C := C)).map (blocksMap e l) :=
  inverseSquare (frozenVariableFlattenIso I L) (frozenVariableFlattenIso J M)
    ((FiniteFamily.flatten (C := C)).map (blocksMap e l)) l (flattenIso_naturality e l)

variable [FiniteTensor C]

/-- Each original tensor unit moves along the actual variable
bijection, while every retained coefficient keeps its original map. -/
def unitFamilyMap {I J : FintypeCat.{0}} (e : I ≃ J) {L M : FiniteFamily C} (l : L ⟶ M) :
    frozenVariableUnitFamily I L ⟶ frozenVariableUnitFamily J M where
  equiv := Equiv.sumCongr e l.equiv
  hom i := match i with
    | Sum.inl _ => 𝟙 _
    | Sum.inr j => l.hom j

/-- The original singleton unitors and actual tensor units commute
with both the variable bijection and every retained object map. -/
theorem blockIso_naturality {I J : FintypeCat.{0}} (e : I ≃ J)
    {L M : FiniteFamily C} (l : L ⟶ M) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (blocksMap e l) ≫
        (frozenVariableBlockIso J M).hom =
      (frozenVariableBlockIso I L).hom ≫ unitFamilyMap e l := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 FiniteFamily.empty) ≫ 𝟙 _) (𝟙 _ ≫ 𝟙 _)
      exact heq_of_eq (congrArg (· ≫ 𝟙 _) ((FiniteTensor.tensor (V :=
        C)).map_id FiniteFamily.empty))
    | inr i =>
      change HEq ((FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C :=
        C)).map (l.hom i)) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (M.obj (l.equiv i)))
        ((FiniteTensor.singletonIso (V := C)).hom.app (L.obj i) ≫ l.hom i)
      exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).hom.naturality (l.hom i))

/-- Actual finite tensor unit insertion is natural under every
variable-position bijection and every retained coefficient-family map. -/
theorem tensorUnitIso_naturality {I J : FintypeCat.{0}} (e : I ≃ J)
    {L M : FiniteFamily C} (l : L ⟶ M) :
    (FiniteTensor.tensor (V := C)).map l ≫ (frozenVariableTensorUnitIso J M).hom =
      (frozenVariableTensorUnitIso I L).hom ≫ (FiniteTensor.tensor (V :=
        C)).map (unitFamilyMap e l) := by
  let T := FiniteTensor.tensor (V := C)
  let b := blocksMap e l
  let k := (FiniteFamily.flatten (C := C)).map b
  let g := (FiniteFamily.map T).map b
  have hp : T.map l ≫ T.map (frozenVariableFlattenIso J M).inv =
      T.map (frozenVariableFlattenIso I L).inv ≫ T.map k :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (flattenIso_inv_naturality e l)).trans (T.map_comp _ _))
  have hq : T.map k ≫ (FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks J M) =
      (FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I L) ≫ T.map g :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality b
  have hr : T.map g ≫ T.map (frozenVariableBlockIso J M).hom =
      T.map (frozenVariableBlockIso I L).hom ≫ T.map (unitFamilyMap e l) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (blockIso_naturality e l)).trans (T.map_comp _ _))
  exact EnvelopingSource040_composeThreeSquares (T.map l) (T.map (frozenVariableFlattenIso I L).inv)
    (T.map (frozenVariableFlattenIso J M).inv) (T.map k)
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks I L))
    ((FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks J M)) (T.map g)
    (T.map (frozenVariableBlockIso I L).hom) (T.map (frozenVariableBlockIso J M).hom)
    (T.map (unitFamilyMap e l)) hp hq hr


end CategoryTheory.Operad.Tensor.Enveloping.Variable

end
end EnvelopingSource040

/- Exact checked source: EnvelopingChoiceProfileMaps. -/
section EnvelopingSource041


/-!
# Original input-choice maps in enveloping substitution representatives
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- The original unary profile map for an actual color equality. -/
def unaryColorHom {c c' : W} (h : c = c') : ColoredProfile.unary c c ⟶
  ColoredProfile.unary c' c' where
  inputEquiv := Equiv.refl PUnit
  inputColor_eq _ := h
  outputColor_eq := h

/-- Original independent root/inner algebra-input maps induce
the actual original substitution-profile family map. -/
def envelopingInnerProfilesMap (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingInnerProfiles s Q ⟶ envelopingInnerProfiles s Q' where
  equiv := Equiv.sumCongr (Equiv.refl s.inner.index) (g none).equiv
  hom i := match i with
    | Sum.inl i => extendProfileMap (𝟙 (s.inner.obj i)) (g (some i))
    | Sum.inr j => unaryColorHom (Discrete.eq_of_hom ((g none).hom j))

/-- The actual original representative substitution morphism,
retaining all root/inner input bijections and root output. -/
def envelopingRepresentativeSubstitutionMap (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingRepresentativeSubstitution s Q ⟶ envelopingRepresentativeSubstitution s Q' where
  outputColor_eq := rfl
  innerHom := envelopingInnerProfilesMap s g

/-- The original outer coefficient comparison commutes with
every original root algebra-input bijection. -/
theorem envelopingRepresentativeOuterHom_naturality (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    extendProfileMap (𝟙 s.outerProfile) (g none) ≫ envelopingRepresentativeOuterHom s Q' =
      envelopingRepresentativeOuterHom s Q ≫
        ColoredSubstitutionData.outerProfileMap (envelopingRepresentativeSubstitutionMap s g) := by
  apply ColoredProfile.Hom.ext
  rfl

/-- All original root and inner algebra input maps retain their
root or dependent inner positions in the original total input family. -/
def envelopingTotalAlgebraInputsMap (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingTotalAlgebraInputs s Q ⟶ envelopingTotalAlgebraInputs s Q' where
  equiv := Equiv.sumCongr (g none).equiv (Equiv.sigmaCongrRight (fun i => (g (some i)).equiv))
  hom p := match p with
    | Sum.inl j => (g none).hom j
    | Sum.inr p => (g (some p.1)).hom p.2

/-- The actual original total variable/root-algebra/inner-algebra
profile bijection commutes with every original independent choice map. -/
theorem envelopingRepresentativeTotalHom_naturality (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    ColoredSubstitutionData.totalProfileMap (envelopingRepresentativeSubstitutionMap s g) ≫
        envelopingRepresentativeTotalHom s Q' =
      envelopingRepresentativeTotalHom s Q ≫
        extendProfileMap (𝟙 s.totalProfile) (envelopingTotalAlgebraInputsMap s g) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases j <;> rfl
  | inr i => rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource041

/- Exact checked source: EnvelopingShapeProfileMaps. -/
section EnvelopingSource042


/-!
# Full original shape and input-choice maps of enveloping representatives
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {s t : ColoredSubstitutionData W}

/-- The actual root/branch coefficient-slot bijection of the original shape map. -/
def envelopingShapeSlotEquiv (f : s ⟶ t) : Option s.inner.index ≃ Option t.inner.index :=
  Equiv.optionCongr f.innerHom.equiv

/-- Every original shape-profile map at its original root or branch slot. -/
def envelopingShapeSlotProfileMap (f : s ⟶ t) (i : Option s.inner.index) :
    envelopingSlotProfile s i ⟶ envelopingSlotProfile t (envelopingShapeSlotEquiv f i) :=
  match i with
  | none => ColoredSubstitutionData.outerProfileMap f
  | some i => f.innerHom.hom i

/-- The original arbitrary algebra-input arrows over an original shape map. -/
abbrev EnvelopingShapeChoiceArrows (f : s ⟶ t)
    (Q : EnvelopingInputChoices s) (Q' : EnvelopingInputChoices t) :=
  ∀ i, Q i ⟶ Q' (envelopingShapeSlotEquiv f i)

/-- Actual shape/profile and input maps act together on all
variable branches and original root algebra-input unary profiles. -/
def envelopingShapeInnerProfilesMap (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingInnerProfiles s Q ⟶ envelopingInnerProfiles t Q' where
  equiv := Equiv.sumCongr f.innerHom.equiv (g none).equiv
  hom i := match i with
    | Sum.inl i => extendProfileMap (f.innerHom.hom i) (g (some i))
    | Sum.inr j => unaryColorHom (Discrete.eq_of_hom ((g none).hom j))

/-- The actual full representative substitution morphism retains
the original root output equality and every original branch/input map. -/
def envelopingShapeRepresentativeMap (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingRepresentativeSubstitution s Q ⟶ envelopingRepresentativeSubstitution t Q' where
  outputColor_eq := f.outputColor_eq
  innerHom := envelopingShapeInnerProfilesMap f g

/-- The actual outer coefficient map respects the original
shape and input bijections and their original color equalities. -/
theorem envelopingShapeOuterHom_naturality (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    extendProfileMap (ColoredSubstitutionData.outerProfileMap f) (g none) ≫
        envelopingRepresentativeOuterHom t Q' =
      envelopingRepresentativeOuterHom s Q ≫
        ColoredSubstitutionData.outerProfileMap (envelopingShapeRepresentativeMap f g) := by
  apply ColoredProfile.Hom.ext
  rfl

/-- Actual root/dependent-inner algebra input maps retain their
original positions under the full original shape-map permutation. -/
def envelopingShapeTotalAlgebraInputsMap (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingTotalAlgebraInputs s Q ⟶ envelopingTotalAlgebraInputs t Q' where
  equiv := Equiv.sumCongr (g none).equiv
    (Equiv.sigmaCongr f.innerHom.equiv (fun i => (g (some i)).equiv))
  hom p := match p with
    | Sum.inl j => (g none).hom j
    | Sum.inr p => (g (some p.1)).hom p.2

/-- The actual total-profile comparison respects all original
root, variable and dependent algebra-input colors and bijections. -/
theorem envelopingShapeTotalHom_naturality (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    ColoredSubstitutionData.totalProfileMap (envelopingShapeRepresentativeMap f g) ≫
        envelopingRepresentativeTotalHom t Q' =
      envelopingRepresentativeTotalHom s Q ≫
        extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
          (envelopingShapeTotalAlgebraInputsMap f g) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases j <;> rfl
  | inr i => rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource042

/- Exact checked source: EnvelopingAssociativityProfiles. -/
section EnvelopingSource043


/-!
# Original three-level profiles with retained enveloping algebra inputs

The root, every middle vertex and every innermost vertex keeps its
own original finite algebra-input family. Retained middle/root
algebra positions receive genuine original unary profiles.
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- Original root algebra inputs and each original branch's
middle/inner input choices, with no arity restriction. -/
structure EnvelopingAssocChoices (d : ColoredAssocData W) where
  /-- The algebra-input family retained at the root of the three-level substitution. -/
  root : ColoredInputs W
  /-- The middle and inner algebra-input choices for each original branch. -/
  branch : ∀ i : d.branches.index, EnvelopingInputChoices (d.localData i)

/-- The original unary substitution datum for a retained root algebra input. -/
def retainedRootAlgebraDatum (c : W) : ColoredSubstitutionData W where
  outputColor := c
  inner := (FiniteFamily.singleton (C := ColoredProfile W)).obj (ColoredProfile.unary c c)

/-- Every original middle branch is replaced by its actual
extended representative; root algebra inputs retain unary branches. -/
def envelopingAssocBranches (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    FiniteFamily (ColoredSubstitutionData W) where
  index := FintypeCat.of (d.branches.index ⊕ Q.root.index)
  obj i := match i with
    | Sum.inl i => envelopingRepresentativeSubstitution (d.localData i) (Q.branch i)
    | Sum.inr j => retainedRootAlgebraDatum (Q.root.obj j).as

/-- The genuine original three-level colored operadic datum,
retaining the original root output and all original algebra-input positions. -/
def envelopingRepresentativeAssoc (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ColoredAssocData W where
  outputColor := d.outputColor
  branches := envelopingAssocBranches d Q

/-- The original middle-level algebra inputs are each branch's
original root algebra-input family. -/
def envelopingAssocMiddleChoices (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    EnvelopingInputChoices d.middleData
  | none => Q.root
  | some i => Q.branch i none

/-- The root and every fully contracted original branch retain
their actual total algebra inputs for the outer-after-inner route. -/
def envelopingAssocOuterChoices (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    EnvelopingInputChoices d.outerAfterInnerData
  | none => Q.root
  | some i => envelopingTotalAlgebraInputs (d.localData i) (Q.branch i)

/-- The original inner-route root algebra input family collects
the original root and every original middle-vertex algebra input. -/
def envelopingAssocInnerRootInputs (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ColoredInputs W where
  index := FintypeCat.of (Q.root.index ⊕ (Σ i : d.branches.index, (Q.branch i none).index))
  obj p := match p with
    | Sum.inl j => Q.root.obj j
    | Sum.inr p => (Q.branch p.1 none).obj p.2

/-- The flat inner route retains every original innermost
vertex's original algebra-input choice at its dependent position. -/
def envelopingAssocInnerChoices (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    EnvelopingInputChoices d.innerData
  | none => envelopingAssocInnerRootInputs d Q
  | some p => Q.branch p.1 (some p.2)

/-- The actual root coefficient extended by its original algebra
inputs maps to the original three-level middle root profile. -/
def envelopingAssocRootHom (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    extendProfile d.middleData.outerProfile Q.root ⟶ (envelopingRepresentativeAssoc d
      Q).middleData.outerProfile where
  inputEquiv := Equiv.refl (d.branches.index ⊕ Q.root.index)
  inputColor_eq p := by cases p <;> rfl
  outputColor_eq := rfl

/-- The original extended middle profile maps to the actual
middle branch profile through its exact original empty/root-input placement. -/
def envelopingAssocMiddleBranchHom (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (i : d.branches.index) :
    extendProfile (d.localData i).outerProfile (Q.branch i none) ⟶
      (envelopingRepresentativeAssoc d Q).middleData.inner.obj (Sum.inl i) :=
  envelopingRepresentativeOuterHom (d.localData i) (Q.branch i)

/-- The original inner-vertex profile extended by its own
algebra inputs is the actual original innermost profile. -/
theorem envelopingAssocInnerBranch_readback (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (i : d.branches.index) (j : (d.localData i).inner.index) :
    ((envelopingRepresentativeAssoc d Q).localData (Sum.inl i)).inner.obj (Sum.inl j) =
      extendProfile ((d.localData i).inner.obj j) (Q.branch i (some j)) := rfl

/-- The full three-level representative datum retains each
original root algebra input as an actual unary profile. -/
theorem envelopingAssocRootAlgebra_readback (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (j : Q.root.index) :
    (envelopingRepresentativeAssoc d Q).localData (Sum.inr j) =
      retainedRootAlgebraDatum (Q.root.obj j).as := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource043

/- Exact checked source: EnvelopingAssociativityCoefficients. -/
section EnvelopingSource044


/-!
# Actual original operad associativity with all enveloping coefficients
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- Each actual middle branch retains its original middle and
innermost coefficient family; the root retains its original coefficient. -/
def envelopingAssocCoefficientBlocks (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option d.branches.index)
  obj i := match i with
    | none => (FiniteFamily.singleton (C := C)).obj (O.obj (extendProfile
      d.middleData.outerProfile Q.root))
    | some i => envelopingRepresentativeCoefficients O (d.localData i) (Q.branch i)

/-- The full original root/middle/inner operation coefficients
retain their exact original nested finite positions. -/
def envelopingAssocCoefficients (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily C :=
  (FiniteFamily.flatten (C := C)).obj (envelopingAssocCoefficientBlocks O d Q)

/-- The complete finite family of original retained root and
middle algebra positions needing unary operadic units. -/
def envelopingAssocUnitPositions (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
  FintypeCat.{0} :=
  FintypeCat.of (Q.root.index ⊕ Q.root.index ⊕ (Σ i : d.branches.index, (Q.branch i none).index))

/-- The exact original unit/root/middle/inner coefficient bijection
to the source family of the actual three-level operad associativity law. -/
def envelopingAssocCoefficientEquiv (O : ColoredSymmetricCollection W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocUnitPositions d Q ⊕ (envelopingAssocCoefficients O d Q).index ≃
      (ColoredOperadObj.AssocInsertion.flattenedGroupingA O (envelopingRepresentativeAssoc d
        Q)).index where
  toFun p := match p with
    | Sum.inl (Sum.inl j) => ⟨some (Sum.inr j), none⟩
    | Sum.inl (Sum.inr (Sum.inl j)) => ⟨some (Sum.inr j), some PUnit.unit⟩
    | Sum.inl (Sum.inr (Sum.inr ⟨i, j⟩)) => ⟨some (Sum.inl i), some (Sum.inr j)⟩
    | Sum.inr ⟨none, _⟩ => ⟨none, PUnit.unit⟩
    | Sum.inr ⟨some i, none⟩ => ⟨some (Sum.inl i), none⟩
    | Sum.inr ⟨some i, some j⟩ => ⟨some (Sum.inl i), some (Sum.inl j)⟩
  invFun p := match p with
    | ⟨none, _⟩ => Sum.inr ⟨none, PUnit.unit⟩
    | ⟨some (Sum.inl i), none⟩ => Sum.inr ⟨some i, none⟩
    | ⟨some (Sum.inl i), some (Sum.inl j)⟩ => Sum.inr ⟨some i, some j⟩
    | ⟨some (Sum.inl i), some (Sum.inr j)⟩ => Sum.inl (Sum.inr (Sum.inr ⟨i, j⟩))
    | ⟨some (Sum.inr j), none⟩ => Sum.inl (Sum.inl j)
    | ⟨some (Sum.inr j), some _⟩ => Sum.inl (Sum.inr (Sum.inl j))
  left_inv p := by
    cases p with
    | inl p =>
      cases p with
      | inl j => rfl
      | inr p => cases p <;> rfl
    | inr p =>
      rcases p with ⟨i, j⟩
      cases i with
      | none => cases j; rfl
      | some i => cases j <;> rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i =>
      cases i with
      | inl i => cases j with
        | none => rfl
        | some j => cases j <;> rfl
      | inr i => cases j with
        | none => rfl
        | some j => cases j; rfl

variable [FiniteTensor C]

/-- The actual original O-units at retained root/middle algebra
inputs and the actual original coefficient profile comparisons. -/
def envelopingAssocCoefficientInsertion (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    frozenVariableUnitFamily (envelopingAssocUnitPositions d Q) (envelopingAssocCoefficients
      O.toCollection d Q) ⟶
      ColoredOperadObj.AssocInsertion.flattenedGroupingA O.toCollection
        (envelopingRepresentativeAssoc d Q) where
  equiv := envelopingAssocCoefficientEquiv O.toCollection d Q
  hom p := match p with
    | Sum.inl (Sum.inl j) => O.unit (Q.root.obj j).as
    | Sum.inl (Sum.inr (Sum.inl j)) => O.unit (Q.root.obj j).as
    | Sum.inl (Sum.inr (Sum.inr ⟨i, j⟩)) => O.unit ((Q.branch i none).obj j).as
    | Sum.inr ⟨none, _⟩ => O.toCollection.map (envelopingAssocRootHom d Q)
    | Sum.inr ⟨some i, none⟩ => O.toCollection.map (envelopingRepresentativeOuterHom
      (d.localData i) (Q.branch i))
    | Sum.inr ⟨some _i, some _j⟩ => 𝟙 _

/-- Original tensor coherence and actual unit maps construct the
source morphism into the actual original operad association law. -/
def envelopingAssocCommonSourceMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      ColoredOperadObj.associativityCommonSource O.toCollection
        (envelopingRepresentativeAssoc d Q) :=
  (frozenVariableTensorUnitIso (envelopingAssocUnitPositions d Q)
    (envelopingAssocCoefficients O.toCollection d Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map (envelopingAssocCoefficientInsertion O d Q)

/-- First run the actual original branch substitutions and then
the original root substitution on the complete retained coefficient source. -/
def envelopingAssocOriginalRouteA (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      O.toCollection.obj (envelopingRepresentativeAssoc d Q).outerAfterInnerData.totalProfile :=
  envelopingAssocCommonSourceMap O d Q ≫
    ColoredOperadObj.associativityRouteA O.toCollection O.subst (envelopingRepresentativeAssoc d Q)

/-- First run the actual original root substitution and then
all original innermost substitutions with the original dependent-sum associator. -/
def envelopingAssocOriginalRouteB (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      O.toCollection.obj (envelopingRepresentativeAssoc d Q).outerAfterInnerData.totalProfile :=
  envelopingAssocCommonSourceMap O d Q ≫
    ColoredOperadObj.associativityRouteB O.toCollection O.subst (envelopingRepresentativeAssoc d Q)

/-- The actual original operad law identifies the complete
extended root/middle/inner coefficient routes. The further exact
linear-substitution route comparisons are proved separately. -/
theorem envelopingAssocOriginalRoutes (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocOriginalRouteA O d Q = envelopingAssocOriginalRouteB O d Q :=
  congrArg (envelopingAssocCommonSourceMap O d Q ≫ ·) (O.assoc (envelopingRepresentativeAssoc d Q))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource044

/- Exact checked source: EnvelopingAssociativityTotalProfiles. -/
section EnvelopingSource045


/-!
# Exact original total variable and algebra-input profiles for association
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- The original retained root, middle and innermost algebra
inputs, in their displayed original nested dependent-sum positions. -/
def envelopingAssocTotalAlgebraInputs (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ColoredInputs W :=
  envelopingTotalAlgebraInputs d.outerAfterInnerData (envelopingAssocOuterChoices d Q)

/-- The exact original three-level total-variable/algebra-input
bijection, retaining every original nested branch and leaf position. -/
def envelopingAssocTotalEquiv (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).outerAfterInnerData.totalProfile.inputs ≃
      d.outerAfterInnerData.totalProfile.inputs ⊕ (envelopingAssocTotalAlgebraInputs d
        Q).index where
  toFun p := match p with
    | ⟨Sum.inl i, ⟨Sum.inl j, Sum.inl k⟩⟩ => Sum.inl ⟨i, ⟨j, k⟩⟩
    | ⟨Sum.inl i, ⟨Sum.inl j, Sum.inr k⟩⟩ => Sum.inr (Sum.inr ⟨i, Sum.inr ⟨j, k⟩⟩)
    | ⟨Sum.inl i, ⟨Sum.inr j, _⟩⟩ => Sum.inr (Sum.inr ⟨i, Sum.inl j⟩)
    | ⟨Sum.inr j, _⟩ => Sum.inr (Sum.inl j)
  invFun p := match p with
    | Sum.inl ⟨i, ⟨j, k⟩⟩ => ⟨Sum.inl i, ⟨Sum.inl j, Sum.inl k⟩⟩
    | Sum.inr (Sum.inl j) => ⟨Sum.inr j, ⟨PUnit.unit, PUnit.unit⟩⟩
    | Sum.inr (Sum.inr ⟨i, Sum.inl j⟩) => ⟨Sum.inl i, ⟨Sum.inr j, PUnit.unit⟩⟩
    | Sum.inr (Sum.inr ⟨i, Sum.inr ⟨j, k⟩⟩) => ⟨Sum.inl i, ⟨Sum.inl j, Sum.inr k⟩⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i =>
      rcases j with ⟨j, k⟩
      cases j with
      | inl j => cases k <;> rfl
      | inr j => cases k; rfl
    | inr i =>
      rcases j with ⟨j, k⟩
      cases j
      cases k
      rfl
  right_inv p := by
    cases p with
    | inl p => rcases p with ⟨i, ⟨j, k⟩⟩; rfl
    | inr p =>
      cases p with
      | inl j => rfl
      | inr p => rcases p with ⟨i, j⟩; cases j <;> rfl

/-- The actual original total profile comparison retains the
root output and every original variable/algebra color. -/
def envelopingAssocTotalHom (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).outerAfterInnerData.totalProfile ⟶
      extendProfile d.outerAfterInnerData.totalProfile (envelopingAssocTotalAlgebraInputs d Q) where
  inputEquiv := envelopingAssocTotalEquiv d Q
  inputColor_eq p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i =>
      rcases j with ⟨j, k⟩
      cases j with
      | inl j => cases k <;> rfl
      | inr j => rfl
    | inr i => rfl
  outputColor_eq := rfl

/-- The inner-first coefficient route ends at the actual
original total extended variable/algebra profile. -/
def envelopingAssocTotalRouteA {C : Type*} [Category* C] [FiniteTensor C]
    (O : ColoredOperadObj W C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      O.toCollection.obj (extendProfile d.outerAfterInnerData.totalProfile
        (envelopingAssocTotalAlgebraInputs d Q)) :=
  envelopingAssocOriginalRouteA O d Q ≫ O.toCollection.map (envelopingAssocTotalHom d Q)

/-- The root-first coefficient route retains the original
dependent-sum associator and the same actual total-profile map. -/
def envelopingAssocTotalRouteB {C : Type*} [Category* C] [FiniteTensor C]
    (O : ColoredOperadObj W C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      O.toCollection.obj (extendProfile d.outerAfterInnerData.totalProfile
        (envelopingAssocTotalAlgebraInputs d Q)) :=
  envelopingAssocOriginalRouteB O d Q ≫ O.toCollection.map (envelopingAssocTotalHom d Q)

/-- The actual original operad law gives the complete coefficient
route equality at the exact same original extended total profile. -/
theorem envelopingAssocTotalRoutes {C : Type*} [Category* C] [FiniteTensor C]
    (O : ColoredOperadObj W C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocTotalRouteA O d Q = envelopingAssocTotalRouteB O d Q :=
  congrArg (· ≫ O.toCollection.map (envelopingAssocTotalHom d Q))
    (envelopingAssocOriginalRoutes O d Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource045

/- Exact checked source: EnvelopingAssociativityContractionMaps. -/
section EnvelopingSource046


/-!
# Actual original inner-first coefficient contraction for enveloping association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original branch coefficient performs its actual
representative substitution; the original root is retained through
its genuine singleton tensor unitor. -/
def envelopingAssocInnerContractionMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (envelopingAssocCoefficientBlocks
      O.toCollection d Q) ⟶
      envelopingRepresentativeCoefficients O.toCollection d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q) where
  equiv := Equiv.refl (Option d.branches.index)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile d.middleData.outerProfile Q.root))
    | some i => envelopingRepresentativeCoefficientSubstitution O (d.localData i) (Q.branch i)

/-- The actual flattened original coefficient source contracts
every original inner branch before the actual outer substitution. -/
def envelopingAssocInnerContraction (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      (FiniteTensor.tensor (V := C)).obj
        (envelopingRepresentativeCoefficients O.toCollection d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q)) :=
  (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocCoefficientBlocks O.toCollection d Q) ≫
    (FiniteTensor.tensor (V := C)).map (envelopingAssocInnerContractionMap O d Q)

/-- The complete actual inner-first Env representative coefficient
route, keeping the original root and every actual inner substitution. -/
def envelopingAssocRepresentativeRouteA (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      O.toCollection.obj (extendProfile d.outerAfterInnerData.totalProfile
        (envelopingAssocTotalAlgebraInputs d Q)) :=
  envelopingAssocInnerContraction O d Q ≫
    envelopingRepresentativeCoefficientSubstitution O d.outerAfterInnerData
      (envelopingAssocOuterChoices d Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource046

/- Exact checked source: TensorUnitBlockDistributionData. -/
section EnvelopingSource047


/-!
# Original finite-family data for distributing tensor units among nested blocks
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- All actual unit positions retain their original dependent block index. -/
def blockUnitIndex (N : FiniteFamily (FiniteFamily C)) (J : N.index →
  FintypeCat.{0}) : FintypeCat.{0} :=
  FintypeCat.of (Σ i : N.index, J i)

/-- Every original block has its own actual empty/unit positions. -/
def blockUnitTriple (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    FiniteFamily (FiniteFamily (FiniteFamily C)) where
  index := N.index
  obj i := frozenVariableBlocks (J i) (N.obj i)

/-- The original blockwise flattened empty/singleton family map. -/
def blockUnitFlattenMap (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (blockUnitTriple N J) ⟶ N where
  equiv := Equiv.refl N.index
  hom i := (frozenVariableFlattenIso (J i) (N.obj i)).hom

/-- The exact original blockwise unit/retained-index bijection
groups all unit positions and retains every original dependent coefficient position. -/
def blockUnitReindexEquiv (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    ((FiniteFamily.flatten (C := FiniteFamily C)).obj (blockUnitTriple N J)).index ≃
      blockUnitIndex N J ⊕ ((FiniteFamily.flatten (C := C)).obj N).index where
  toFun p := match p with
    | ⟨i, Sum.inl j⟩ => Sum.inl ⟨i, j⟩
    | ⟨i, Sum.inr j⟩ => Sum.inr ⟨i, j⟩
  invFun p := match p with
    | Sum.inl ⟨i, j⟩ => ⟨i, Sum.inl j⟩
    | Sum.inr ⟨i, j⟩ => ⟨i, Sum.inr j⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases j <;> rfl
  right_inv p := by cases p <;> rfl

/-- The original flattened block triple is the original single
combined empty/singleton family by the actual unit-position bijection. -/
def blockUnitTripleReindexIso (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    (FiniteFamily.flatten (C := FiniteFamily C)).obj (blockUnitTriple N J) ≅
      frozenVariableBlocks (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N) :=
  FiniteFamily.isoOfComponents (blockUnitReindexEquiv N J) (fun p => by
    rcases p with ⟨i, j⟩
    cases j <;> exact Iso.refl _)

/-- The exact original nested block reindexing gives the actual
global retained-family map, with every original coefficient position unchanged. -/
theorem blockUnit_flatten_reindex (N : FiniteFamily (FiniteFamily C)) (J : N.index →
  FintypeCat.{0}) :
    (FiniteFamily.flatten (C := C)).map (blockUnitTripleReindexIso N J).hom ≫
        (frozenVariableFlattenIso (blockUnitIndex N J) ((FiniteFamily.flatten (C :=
          C)).obj N)).hom =
      FiniteFamily.flattenAssocIso.inv.app (blockUnitTriple N J) ≫
        (FiniteFamily.flatten (C := C)).map (blockUnitFlattenMap N J) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨⟨i, j⟩, k⟩
    cases j with
    | inl j => exact k.elim
    | inr j => rfl
  · intro p
    rcases p with ⟨⟨i, j⟩, k⟩
    cases j with
    | inl j => exact k.elim
    | inr j => cases k; exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

variable [FiniteTensor C]

/-- The genuine blockwise unit family retains each original coefficient block. -/
def blockUnitFamilies (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    FiniteFamily (FiniteFamily C) where
  index := N.index
  obj i := frozenVariableUnitFamily (J i) (N.obj i)

/-- The original tensor of each empty/singleton block maps through
its actual singleton unitor to the blockwise unit family. -/
def blockUnitTensorMap (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    (FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V := C)))).obj (blockUnitTriple N J) ⟶
      blockUnitFamilies N J where
  equiv := Equiv.refl N.index
  hom i := (frozenVariableBlockIso (J i) (N.obj i)).hom

/-- Every original nested coefficient block receives its actual
unit insertion, constructed by its original flatten/singleton comparisons. -/
def blockUnitInsertionMap (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (blockUnitFamilies N J) where
  equiv := Equiv.refl N.index
  hom i := (frozenVariableTensorUnitIso (J i) (N.obj i)).hom

/-- The actual source maps of the blockwise unit insertion are
the original flattened empty/singleton block comparisons. -/
theorem blockUnitInsertion_decomposition (N : FiniteFamily (FiniteFamily C)) (J : N.index
  → FintypeCat.{0}) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (blockUnitFlattenMap N J) ≫
        blockUnitInsertionMap N J =
      (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app (blockUnitTriple N J) ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (blockUnitTensorMap N J) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    exact heq_of_eq (by
      change (FiniteTensor.tensor (V := C)).map (frozenVariableFlattenIso (J i) (N.obj i)).hom ≫
        ((FiniteTensor.tensor (V := C)).map (frozenVariableFlattenIso (J i) (N.obj i)).inv ≫
          (FiniteTensor.flattenIso (V := C)).hom.app (frozenVariableBlocks (J i) (N.obj i)) ≫
          (FiniteTensor.tensor (V := C)).map (frozenVariableBlockIso (J i) (N.obj i)).hom) = _
      rw [← Category.assoc, ← (FiniteTensor.tensor (V := C)).map_comp,
        Iso.hom_inv_id, (FiniteTensor.tensor (V := C)).map_id, Category.id_comp]
      rfl)

/-- The actual flattened blockwise unit family is the global
unit family by its exact original dependent block-index bijection. -/
def blockUnitFamilyReindexIso (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    (FiniteFamily.flatten (C := C)).obj (blockUnitFamilies N J) ≅
      frozenVariableUnitFamily (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N) :=
  FiniteFamily.isoOfComponents (blockUnitReindexEquiv N J) (fun p => by
    rcases p with ⟨i, j⟩
    cases j <;> exact Iso.refl _)


end CategoryTheory.Operad.Tensor.Enveloping

end
