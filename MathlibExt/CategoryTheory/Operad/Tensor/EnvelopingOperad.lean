variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original branch representative evaluation factors
through its original coefficient tensor normalization and original
coefficient substitution, retaining every original branch algebra leaf. -/
theorem envelopingAssocBranchWeightedIso_evaluation (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) (i : d.branches.index) :
    (envelopingAssocBranchWeightedIso O.toCollection B d Q i).hom ≫
        (coefficientLeafTensorFunctor ((envelopingAssocLeafBlocks B d Q).obj (some i))).map
          (envelopingRepresentativeCoefficientSubstitution O (d.localData i) (Q.branch i)) =
      envelopingRepresentativeEvaluation O B (d.localData i) (Q.branch i) := by
  let T := FiniteTensor.tensor (V := C)
  let s := d.localData i
  let q := Q.branch i
  let a := coefficientBlockInterchangeTensorIso (FintypeCat.of (Option s.inner.index))
    (fun j => O.toCollection.obj (extendProfile (envelopingSlotProfile s j) (q j)))
    (fun j => (addedAlgebraInputs B).obj (q j))
  let k := (envelopingCoefficientBlockIso O.toCollection s q).hom
  let l := (envelopingAlgebraLeafIso B s q).hom
  let g := envelopingRepresentativeCoefficientSubstitution O s q
  have he : (envelopingAssocBranchNormalizedFactorsIso O.toCollection B d Q i).hom =
      coefficientLeafMap (T.map k) l := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro p
      cases p with
      | none => exact HEq.rfl
      | some p =>
        rcases p with ⟨j, k⟩
        cases j <;> exact HEq.rfl
  have hf : (envelopingAssocBranchNormalizedFactorsIso O.toCollection B d Q i).hom ≫
      (coefficientLeafFamilyFunctor ((envelopingAssocLeafBlocks B d Q).obj (some i))).map g =
      coefficientLeafMap (T.map k ≫ g) l := by
    rw [he]
    exact coefficientLeafMap_post (T.map k) g l
  have h := (T.map_comp _ _).symm.trans (congrArg T.map hf)
  exact (Category.assoc a.hom _ _).trans (congrArg (a.hom ≫ ·) h)


end CategoryTheory.Operad.Tensor.Enveloping

end
