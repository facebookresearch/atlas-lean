/- Exact checked source: NullaryConstantAction. -/
section EnvelopingSource306


/-!
# The actual original nullary constant-input action is monad multiplication
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory Limits

private theorem originalSlotDensityFiring {V : Type*} [Category* V]
    {X A B L S T : V} (i : X ⟶ A) (a : A ⟶ B) (b : B ⟶ L) (c : L ⟶ T)
    (d : B ⟶ S) (e : S ⟶ T) (u : X ⟶ L) (v : X ⟶ S) (g : X ⟶ T)
    (h1 : (i ≫ a) ≫ b = u) (h2 : u ≫ c = g)
    (h3 : (i ≫ a) ≫ d = v) (h4 : v ≫ e = g) :
    i ≫ (a ≫ (b ≫ c)) = i ≫ (a ≫ (d ≫ e)) := by
  have hl : i ≫ (a ≫ (b ≫ c)) = g := by
    calc
      _ = ((i ≫ a) ≫ b) ≫ c := by simp only [Category.assoc]
      _ = u ≫ c := congrArg (· ≫ c) h1
      _ = g := h2
  have hr : i ≫ (a ≫ (d ≫ e)) = g := by
    calc
      _ = ((i ≫ a) ≫ d) ≫ e := by simp only [Category.assoc]
      _ = v ≫ e := congrArg (· ≫ e) h3
      _ = g := h4
  exact hl.trans hr.symm

private theorem originalPostSlotBeta {V : Type*} [Category* V]
    {X A B D Y : V} (r : X ⟶ A) (w : A ⟶ B) (i : B ⟶ D) (e : D ⟶ Y)
    (h : B ⟶ Y) (hi : i ≫ e = h) :
    (r ≫ w ≫ i) ≫ e = r ≫ w ≫ h := by
  simp only [Category.assoc]
  rw [hi]

private theorem originalNullaryOuterFiring {V : Type*} [Category* V]
    {X T L D S F : V} (i : X ⟶ T) (sigma : T ⟶ L) (e : L ⟶ F)
    (n : T ⟶ D) (mu : D ⟶ F) (c : X ⟶ L) (a : X ⟶ S) (j : S ⟶ D) (f : S ⟶ F)
    (hs : i ≫ sigma = c) (hc : c ≫ e = a ≫ f)
    (hn : i ≫ n = a ≫ j) (hm : j ≫ mu = f) :
    i ≫ (sigma ≫ e) = i ≫ (n ≫ mu) := by
  have hl : i ≫ (sigma ≫ e) = a ≫ f :=
    (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ e) hs).trans hc)
  have hr : i ≫ (n ≫ mu) = a ≫ f :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ mu) hn).trans ((Category.assoc _ _ _).trans (congrArg (a ≫ ·) hm)))
  exact hl.trans hr.symm

private theorem originalNullaryCancelPost {V : Type*} [Category* V]
    {X A B : V} (f : X ⟶ A) (g : X ⟶ B) (e : A ≅ B) (h : f ≫ e.hom = g) :
    f = g ≫ e.inv := by
  have hh := congrArg (· ≫ e.inv) h
  simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id] using hh

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original nullary constant-input summand evaluates
the same original free operation through its original coefficient
comparison, proved on every original rooted cofan leg. -/
theorem constantSubstitutionComparison (O : ColoredOperadObj W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) :
    constantInputSubstitution O B (ColoredProfile.nullary d) Q ≫
        (nullaryLinearCoefficientIso O.toCollection B d).hom =
      (nullaryLinearDiagramIso O.toCollection (profileCoinvariants O.toCollection B) d).hom.app Q ≫
        freeOperation O B ((inputsToProfile d).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  let P := (inputsToProfile d).obj Q
  let e₀ := rootedFrozenPointIso O.toCollection B (ColoredProfile.nullary d) Q
  apply (cancel_epi e₀.hom).1
  apply (rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile (ColoredProfile.nullary d) Q))
    O.toCollection B P).hom_ext
  intro R
  let i := (rootedSlotTensorCocone (O.toCollection.obj (extendProfile (ColoredProfile.nullary d) Q))
    O.toCollection B P).ι.app R
  let a := e₀.hom
  let b := constantInputSubstitution O B (ColoredProfile.nullary d) Q
  let c := (nullaryLinearCoefficientIso O.toCollection B d).hom
  let delta := (nullaryLinearDiagramIso O.toCollection (profileCoinvariants O.toCollection
    B) d).hom.app Q
  let free := freeOperation O B P
  let u := rootedFrozenEvaluation O B (ColoredProfile.nullary d) Q R
  let r := T.map (rootedFrozenFamilyIso O.toCollection B (ColoredProfile.nullary d) Q R).hom
  let w := T.map (weightedMap O.toCollection B d Q R)
  let ordinary := (profileSlotTensorCocone O.toCollection B P).ι.app R
  let assembled := (assembledProfileSubstitutionCocone O B P).ι.app R
  let v := r ≫ w ≫ ordinary
  let g := r ≫ w ≫ assembled
  have h1 : (i ≫ a) ≫ b = u := constantInputSubstitution_β O B (ColoredProfile.nullary d) Q R
  have h2 : u ≫ c = g := rootedEvaluation O B d Q R
  have h3 : (i ≫ a) ≫ delta = v := slotInjection O.toCollection B d Q R
  have h4 : v ≫ free = g := originalPostSlotBeta r w ordinary free assembled
    (freeOperation_ι O B P R)
  exact originalSlotDensityFiring i a b c delta free u v g h1 h2 h3 h4

/-- The actual original nullary constant-input action is the
actual tensor-profile monad multiplication under the original
empty-profile coefficient colimit comparisons. -/
theorem constantActionComparison (O : ColoredOperadObj W C) (B : W → C) (d : W) :
    constantInputAction O B (ColoredProfile.nullary d) ≫
        (nullaryLinearCoefficientIso O.toCollection B d).hom =
      (nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection B) d).hom ≫
        profileMultiplication O B d := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits d
  apply colimit.hom_ext
  intro Q
  exact originalNullaryOuterFiring
    (linearCoefficientι O.toCollection (profileCoinvariants O.toCollection B)
      (ColoredProfile.nullary d) Q)
    (constantInputAction O B (ColoredProfile.nullary d)) (nullaryLinearCoefficientIso
      O.toCollection B d).hom
    (nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection B) d).hom
    (profileMultiplication O B d) (constantInputSubstitution O B (ColoredProfile.nullary d) Q)
    ((nullaryLinearDiagramIso O.toCollection (profileCoinvariants O.toCollection B) d).hom.app Q)
    (profileι O.toCollection (profileCoinvariants O.toCollection B) ((inputsToProfile d).obj Q))
    (freeOperation O B ((inputsToProfile d).obj Q))
    (constantInputAction_β O B (ColoredProfile.nullary d) Q)
      (constantSubstitutionComparison O B d Q)
    (nullaryLinearCoefficientIso_ι O.toCollection (profileCoinvariants O.toCollection B) d Q)
    (profileMultiplication_profile O B ((inputsToProfile d).obj Q))

/-- The original nullary coefficient substitution face is
literally the original multiplication face in its original linear
frame, without assuming a desired relation-map identification. -/
theorem constantActionFace (O : ColoredOperadObj W C) (B : W → C) (d : W) :
    constantInputAction O B (ColoredProfile.nullary d) = nullaryLinearMultiplicationFace O B d := by
  have h := originalNullaryCancelPost (constantInputAction O B (ColoredProfile.nullary d))
    ((nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection B) d).hom ≫
      profileMultiplication O B d) (nullaryLinearCoefficientIso O.toCollection B d)
    (constantActionComparison O B d)
  exact h.trans (Category.assoc _ _ _)


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource306

/- Exact checked source: EnvelopingNullaryCoefficient. -/
section EnvelopingSource307


/-!
# The actual nullary enveloping coefficient is the original algebra carrier
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory Limits

/-- Reverse the parallel pair of a cofork without changing its projection. -/
def reverseOriginalCofork {V : Type*} [Category* V]
    {X Y : V} {f g : X ⟶ Y} (c : Cofork f g) : Cofork g f :=
  Cofork.ofπ c.π c.condition.symm

/-- Reversing the parallel pair preserves the colimit universal property of the cofork. -/
def reverseOriginalCoforkIsColimit {V : Type*} [Category* V]
    {X Y : V} {f g : X ⟶ Y} (c : Cofork f g) (hc : IsColimit c) :
    IsColimit (reverseOriginalCofork c) :=
  Cofork.IsColimit.mk' _ (fun s => by
    let original : Cofork f g := Cofork.ofπ s.π s.condition.symm
    refine ⟨hc.desc original, hc.fac original WalkingParallelPair.one, ?_⟩
    intro m hm
    apply Cofork.IsColimit.hom_ext hc
    exact hm.trans (hc.fac original WalkingParallelPair.one).symm)

private theorem originalNullaryQuotientCofanFiring {V : Type*} [Category* V]
    {X L E T S A : V} (i : X ⟶ L) (p : L ⟶ E) (e : E ⟶ A)
    (n : L ⟶ T) (a : T ⟶ A) (d : X ⟶ S) (j : S ⟶ T) (o : S ⟶ A)
    (hp : p ≫ e = n ≫ a) (hi : i ≫ n = d ≫ j) (hj : j ≫ a = o) :
    i ≫ p ≫ e = d ≫ o := by
  rw [hp, ← Category.assoc i n, hi, Category.assoc d j, hj]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- The actual original nullary enveloping relation is
coequalized by the original algebra evaluation, using the proved
original substitution/multiplication identification. -/
theorem originalNullaryCondition (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    constantInputAction O A.carrier (ColoredProfile.nullary d) ≫
      nullaryLinearAlgebraEvaluation O A d =
      algebraInputRelation O A (ColoredProfile.nullary d) ≫ nullaryLinearAlgebraEvaluation O A d :=
  (congrArg (· ≫ nullaryLinearAlgebraEvaluation O A d) (constantActionFace O A.carrier d)).trans
    (nullaryLinearAlgebraEvaluation_condition O A d).symm

/-- The original algebra carrier with its original coefficient
evaluation is a cofork for the actual original enveloping faces. -/
def originalNullaryCofork (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    Cofork (constantInputAction O A.carrier (ColoredProfile.nullary d))
      (algebraInputRelation O A (ColoredProfile.nullary d)) :=
  Cofork.ofπ (nullaryLinearAlgebraEvaluation O A d) (originalNullaryCondition O A d)

/-- The actual original enveloping relation cofork has its full
universal property at the original A carrier, obtained from the
original linear-frame Beck cofork without a desired outcome premise. -/
def originalNullaryIsColimit (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    IsColimit (originalNullaryCofork O A d) := by
  let c := reverseOriginalCofork (nullaryLinearBeckCocone O A d)
  let hc := reverseOriginalCoforkIsColimit (nullaryLinearBeckCocone O A d)
    (nullaryLinearBeckIsColimit O A d)
  let f := constantInputAction O A.carrier (ColoredProfile.nullary d)
  let f₀ := nullaryLinearMultiplicationFace O A.carrier d
  let g := algebraInputRelation O A (ColoredProfile.nullary d)
  have h1 : (𝟙 _ : _ ⟶ _) ≫ f = f₀ ≫ 𝟙 _ :=
    (Category.id_comp f).trans ((constantActionFace O A.carrier d).trans (Category.comp_id f₀).symm)
  have h2 : (𝟙 _ : _ ⟶ _) ≫ g = g ≫ 𝟙 _ :=
    (Category.id_comp g).trans (Category.comp_id g).symm
  have h3 : (𝟙 _ : _ ⟶ _) ≫ c.π ≫ (𝟙 _ : _ ⟶ _) = (originalNullaryCofork O A d).π := by
    change 𝟙 _ ≫ nullaryLinearAlgebraEvaluation O A d ≫ 𝟙 _ = nullaryLinearAlgebraEvaluation O A d
    simp only [Category.id_comp, Category.comp_id]
  exact Cofork.isColimitOfIsos c hc (originalNullaryCofork O A d)
    (Iso.refl _) (Iso.refl _) (Iso.refl _) h1 h2 h3

/-- The actual original enveloping coefficient at the actual
nullary profile is the original algebra carrier, with both genuine
universal comparison maps and their original inverse laws. -/
def envelopingNullaryCoefficientIso (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    envelopingCoefficientObj O A (ColoredProfile.nullary d) ≅ A.carrier d :=
  (colimit.isColimit _).coconePointUniqueUpToIso (originalNullaryIsColimit O A d)

/-- The actual original enveloping quotient projection maps to
the original linear coefficient/algebra evaluation at the same color. -/
theorem envelopingNullaryCoefficientIso_π (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    envelopingCoefficientπ O A (ColoredProfile.nullary d) ≫
        (envelopingNullaryCoefficientIso O A d).hom = nullaryLinearAlgebraEvaluation O A d :=
  (colimit.isColimit _).comp_coconePointUniqueUpToIso_hom
    (originalNullaryIsColimit O A d) WalkingParallelPair.one

/-- Every actual original coefficient summand is evaluated by
the original O-algebra operation after the original empty-profile
map, retaining both the original cofan and quotient projection. -/
theorem envelopingNullaryCoefficientIso_ι (O : ColoredOperadObj W C) (A : Algebra O)
    (d : W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection A.carrier (ColoredProfile.nullary d) Q ≫
        envelopingCoefficientπ O A (ColoredProfile.nullary d) ≫
        (envelopingNullaryCoefficientIso O A d).hom =
      (nullaryLinearDiagramIso O.toCollection A.carrier d).hom.app Q ≫
        A.operations.app d ((inputsToProfile d).obj Q) :=
  originalNullaryQuotientCofanFiring
    (linearCoefficientι O.toCollection A.carrier (ColoredProfile.nullary d) Q)
    (envelopingCoefficientπ O A (ColoredProfile.nullary d))
      (envelopingNullaryCoefficientIso O A d).hom
    (nullaryLinearCoefficientIso O.toCollection A.carrier d).hom (A.action d)
    ((nullaryLinearDiagramIso O.toCollection A.carrier d).hom.app Q)
    (profileι O.toCollection A.carrier ((inputsToProfile d).obj Q))
    (A.operations.app d ((inputsToProfile d).obj Q))
    (envelopingNullaryCoefficientIso_π O A d)
    (nullaryLinearCoefficientIso_ι O.toCollection A.carrier d Q) (A.action_operation d
      ((inputsToProfile d).obj Q))


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource307

/- Exact checked source: LinearConstantGenerators. -/
section EnvelopingSource308


/-!
# Original constant generators in linear and enveloping nullary coefficients
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem generatorInverseSquare {D : Type*} [Category* D]
    {A A' B B' : D} (e : A ≅ B) (e' : A' ≅ B') (f : A ⟶ A') (g : B ⟶ B')
    (h : f ≫ e'.hom = e.hom ≫ g) : e.inv ≫ f = g ≫ e'.inv := by
  apply (cancel_mono e'.hom).1
  rw [Category.assoc, h, ← Category.assoc e.inv e.hom, e.inv_hom_id, Category.id_comp]
  rw [Category.assoc, e'.inv_hom_id, Category.comp_id]

private theorem generatorCarrierFiring {D : Type*} [Category* D]
    {X X' A A' B B' : D} (u : X ⟶ B) (v : X' ⟶ B') (f : X ⟶ X')
    (i : B ⟶ A) (i' : B' ⟶ A') (l : A ⟶ A') (g : B ⟶ B')
    (hi : i ≫ l = g ≫ i') (hu : u ≫ g = f ≫ v) :
    (u ≫ i) ≫ l = f ≫ (v ≫ i') := by
  rw [Category.assoc u i, hi, ← Category.assoc u g, hu, Category.assoc]

private theorem generatorEvaluationFiring {D : Type*} [Category* D]
    {X L T E : D} (u : X ⟶ T) (e : L ≅ T) (q : L ⟶ E) (p : E ⟶ X) (a : T ⟶ X)
    (hq : q ≫ p = e.hom ≫ a) (hu : u ≫ a = 𝟙 X) :
    ((u ≫ e.inv) ≫ q) ≫ p = 𝟙 X := by
  simp only [Category.assoc]
  rw [hq]
  simp only [Iso.inv_hom_id_assoc]
  exact hu

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original B-input is inserted as its actual original free
O-generator in the constructed linear nullary coefficient. -/
def linearConstantGenerator (O : ColoredOperadObj W C) (B : W → C) (d : W) :
    B d ⟶ linearCoefficient O.toCollection B (ColoredProfile.nullary d) :=
  (profileUnit O).app B d ≫ (nullaryLinearCoefficientIso O.toCollection B d).inv

/-- The actual original constants retain every original colorwise
carrier arrow and its full nullary coefficient map. -/
theorem linearConstantGenerator_naturality (O : ColoredOperadObj W C)
    {B D : W → C} (f : B ⟶ D) (d : W) :
    linearConstantGenerator O B d ≫ linearCoefficientCarrierLift O.toCollection f
      (ColoredProfile.nullary d) =
      f d ≫ linearConstantGenerator O D d := by
  let e := nullaryLinearCoefficientIso O.toCollection B d
  let e' := nullaryLinearCoefficientIso O.toCollection D d
  let l := linearCoefficientCarrierLift O.toCollection f (ColoredProfile.nullary d)
  let g := profileMap O.toCollection f d
  have hi : e.inv ≫ l = g ≫ e'.inv :=
    generatorInverseSquare e e' l g (nullaryLinearCoefficientIso_carrier O.toCollection f d)
  have hu : (profileUnit O).app B d ≫ g = f d ≫ (profileUnit O).app D d :=
    (congrFun ((profileUnit O).naturality f) d).symm
  exact generatorCarrierFiring ((profileUnit O).app B d) ((profileUnit O).app D d) (f d)
    e.inv e'.inv l g hi hu

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Every original A-input is the actual original constant generator
followed by the original algebra-relation nullary coefficient quotient. -/
def envelopingConstantGenerator (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    A.carrier d ⟶ envelopingCoefficientObj O A (ColoredProfile.nullary d) :=
  linearConstantGenerator O A.carrier d ≫ envelopingCoefficientπ O A (ColoredProfile.nullary d)

/-- Original constant generators read back to the identity of the
original genuine algebra under the proved actual nullary coefficient iso. -/
theorem envelopingConstantGenerator_evaluation (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    envelopingConstantGenerator O A d ≫ (Nullary.envelopingNullaryCoefficientIso O A d).hom =
      𝟙 (A.carrier d) := by
  let e := nullaryLinearCoefficientIso O.toCollection A.carrier d
  let q := envelopingCoefficientπ O A (ColoredProfile.nullary d)
  let p := (Nullary.envelopingNullaryCoefficientIso O A d).hom
  have hq : q ≫ p = e.hom ≫ A.action d := Nullary.envelopingNullaryCoefficientIso_π O A d
  exact generatorEvaluationFiring ((profileUnit O).app A.carrier d) e q p (A.action d) hq
    (congrFun A.action_unit d)

/-- The original constant inclusion is exactly the inverse of the
constructed nullary coefficient/algebra comparison, at every color. -/
theorem envelopingConstantGenerator_eq_inverse (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    envelopingConstantGenerator O A d = (Nullary.envelopingNullaryCoefficientIso O A d).inv := by
  let e := Nullary.envelopingNullaryCoefficientIso O A d
  exact (cancel_mono e.hom).1
    ((envelopingConstantGenerator_evaluation O A d).trans e.inv_hom_id.symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource308

/- Exact checked source: ConstantActionExtensionData. -/
section EnvelopingSource309


/-!
# Original profile maps for the constant-input face as a constants extension
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

variable {W : Type u}

/-- The original input set and original input colors of an actual
fixed-output profile, retained as the original colored input family. -/
def branchInputs {d : W} (R : AnalyticIndex W d) : ColoredInputs W where
  index := R.inputs
  obj i := Discrete.mk (R.inputColor i)

/-- The original input family has exactly its original analytic profile. -/
theorem branchInputs_profile {d : W} (R : AnalyticIndex W d) :
    (inputsToProfile d).obj (branchInputs R) = R := rfl

/-- The actual original empty-variable extension is the original
branch profile by the original empty-sum input comparison. -/
def branchExtensionHom {d : W} (R : AnalyticIndex W d) :
    extendProfile (ColoredProfile.nullary d) (branchInputs R) ⟶ R.toColoredProfile :=
  nullaryVariableProfileHom d (branchInputs R)

/-- The target linear-operad substitution keeps the original variables
and inserts the original nullary coefficient at every original added input. -/
def shape (P : ColoredProfile W) (Q : ColoredInputs W) : ColoredSubstitutionData W :=
  frozenSubstitution P Q (Linear.Constants.branches Q)

/-- Root and variable coefficients use their original empty summands;
each added nullary branch carries the original input family of R. -/
def choices (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    EnvelopingInputChoices (shape P Q)
  | none => emptyColoredInputs
  | some (Sum.inl _) => emptyColoredInputs
  | some (Sum.inr j) => branchInputs (R j)

/-- The original nullary representative profile expands back to the
original frozen inner profile, using the original unit/empty maps. -/
def representativeShapeHom (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    envelopingRepresentativeSubstitution (shape P Q) (choices P Q R) ⟶ frozenSubstitution
      P Q R where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.sumEmpty (P.inputs ⊕ Q.index) Empty
      hom i := match i with
        | Sum.inl (Sum.inl i) => emptyExtensionProfileHom
            (ColoredProfile.unary (P.inputColor i) (P.inputColor i))
        | Sum.inl (Sum.inr j) => branchExtensionHom (R j)
        | Sum.inr i => i.elim }

/-- The two original frozen outer profiles have their original
identity input bijection and identical original input/output colors. -/
def outerFrozenHom (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (shape P Q).outerProfile ⟶ (frozenSubstitution P Q R).outerProfile where
  inputEquiv := Equiv.refl (P.inputs ⊕ Q.index)
  inputColor_eq i := by cases i <;> rfl
  outputColor_eq := rfl

/-- The original root coefficient passes through exactly its original
empty summand and the original frozen outer-profile comparison. -/
theorem representativeShapeHom_outer (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    envelopingRepresentativeOuterHom (shape P Q) (choices P Q R) ≫
      ColoredSubstitutionData.outerProfileMap (representativeShapeHom P Q R) =
    emptyExtensionProfileHom (shape P Q).outerProfile ≫ outerFrozenHom P Q R := by
  apply ColoredProfile.Hom.ext
  ext i
  cases i with
  | inl i => cases i <;> rfl
  | inr i => exact i.elim

/-- Original outer colors and variable positions commute through the
actual nullary frozen shape and the actual original branch shape. -/
theorem outerFrozenHom_source (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    frozenOuterProfileHom P Q (Linear.Constants.branches Q) ≫ outerFrozenHom P Q R =
      frozenOuterProfileHom P Q R := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The original total constants of the representative retain exactly
every original dependent input of every original branch R. -/
def totalInputsIso (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    envelopingTotalAlgebraInputs (shape P Q) (choices P Q R) ≅ frozenTotalInputs Q R :=
  FiniteFamily.isoOfComponents
    { toFun p := match p with
        | Sum.inl i => i.elim
        | Sum.inr ⟨Sum.inl _, i⟩ => i.elim
        | Sum.inr ⟨Sum.inr j, i⟩ => ⟨j, i⟩
      invFun p := Sum.inr ⟨Sum.inr p.1, p.2⟩
      left_inv p := by
        cases p with
        | inl i => exact i.elim
        | inr p => rcases p with ⟨i, j⟩; cases i with
          | inl _ => exact j.elim
          | inr _ => rfl
      right_inv _ := rfl }
    (fun p => match p with
      | Sum.inl i => i.elim
      | Sum.inr ⟨Sum.inl _, i⟩ => i.elim
      | Sum.inr ⟨Sum.inr j, i⟩ => Iso.refl (Discrete.mk ((R j).inputColor i)))

/-- The original surviving variables and original total constant
leaves retain their displayed original profile maps. -/
def totalProfileHom (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    extendProfile (shape P Q).totalProfile
      (envelopingTotalAlgebraInputs (shape P Q) (choices P Q R)) ⟶ extendProfile P
        (frozenTotalInputs Q R) :=
  extendProfileMap (Linear.Constants.substitutionTotalHom P Q) (totalInputsIso P Q R).hom

/-- Both original total-profile routes retain exactly every original
variable and branch input, including every nullary branch. -/
theorem representativeShapeHom_total (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    envelopingRepresentativeTotalHom (shape P Q) (choices P Q R) ≫ totalProfileHom P Q R =
      ColoredSubstitutionData.totalProfileMap (representativeShapeHom P Q R) ≫
        frozenTotalProfileHom P Q R := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases i with
    | inl i => cases j with
      | inl j => cases j; rfl
      | inr j => exact j.elim
    | inr i => cases j with
      | inl j => exact Fin.elim0 j
      | inr j => rfl
  | inr i => exact i.elim


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
