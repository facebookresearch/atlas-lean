/-!
# Actual original unit-unit branch contraction in enveloping association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem rootUnitFinalSquare {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (f : A ⟶ B) (a : A ⟶ D) (b : B ⟶ E)
    (c : E ⟶ Y) (d : D ⟶ Y) (u : X ⟶ Y) (q : X ⟶ B)
    (h1 : f ≫ b ≫ c = a ≫ d) (h2 : p ≫ f = q) (h3 : q ≫ b ≫ c = u) :
    p ≫ a ≫ d = u := by
  rw [← h1, ← Category.assoc p f, h2]
  exact h3

private theorem rootUnitSourceSquare {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (q : A ⟶ B) (f : B ⟶ D)
    (u : X ⟶ E) (a : E ⟶ D) (r : A ⟶ Y) (s : Y ⟶ D)
    (h : q ≫ f = r ≫ s) (hp : u ≫ a = p ≫ r ≫ s) :
    (p ≫ q) ≫ f = u ≫ a := by
  rw [Category.assoc p q, h]
  exact hp.symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original source of the two-unit unary branch is
the original unary unit followed by its actual right-unit insertion. -/
theorem retainedRootUnitSource_right (O : ColoredOperadObj W C) (c : W) :
    retainedRootUnitSource O c ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map
          (retainedRootAlgebraToRightUnit c) =
      O.unit c ≫ ColoredOperadObj.rightUnitInsert O.toCollection O.unit
        (ColoredSubstitutionData.unitProfile c) := by
  let T := FiniteTensor.tensor (V := C)
  let u := (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty
  let p := UnitInsertion.rightInsertPrefix u (FintypeCat.of PUnit)
  let q := T.map (retainedRootUnitFactors O c)
  let f := (ColoredOperadObj.substitutionSource O.toCollection).map
    (retainedRootAlgebraToRightUnit c)
  let r := T.map ((FiniteFamily.map T).map (UnitInsertion.rightNestedFamilyMap (O.unit c)
    (FintypeCat.of PUnit)))
  let s := T.map (ColoredOperadObj.UnitInsertion.rightFactorHom O.toCollection O.unit
    (ColoredSubstitutionData.unitProfile c))
  have h : q ≫ f = r ≫ s :=
    (T.map_comp _ _).symm.trans ((congrArg T.map (retainedRootUnitFactors_right O c)).trans
      (T.map_comp _ _))
  have hp : O.unit c ≫ ColoredOperadObj.rightUnitInsert O.toCollection O.unit
    (ColoredSubstitutionData.unitProfile c) =
    p ≫ r ≫ s :=
    (Category.assoc (O.unit c)
      (UnitInsertion.rightInsertPrefix (O.toCollection.obj
        (ColoredSubstitutionData.unitProfile c)) (FintypeCat.of
        PUnit)) s).symm.trans
      ((congrArg (· ≫ s) (UnitInsertion.rightInsertPrefix_natural (O.unit c)
        (FintypeCat.of PUnit))).trans
        (Category.assoc p r s))
  exact rootUnitSourceSquare p q f (O.unit c)
    (ColoredOperadObj.rightUnitInsert O.toCollection O.unit
      (ColoredSubstitutionData.unitProfile c)) r s h hp

/-- The actual original unit-unit branch tensor contracts to the
original unary unit, by the original operad right-unit law. -/
theorem retainedRootUnitSource_substitution (O : ColoredOperadObj W C) (c : W) :
    retainedRootUnitSource O c ≫ O.subst.app (retainedRootAlgebraDatum c) ≫
        O.toCollection.map (retainedRootAlgebraTotalHom c) = O.unit c := by
  exact rootUnitFinalSquare (retainedRootUnitSource O c)
    ((ColoredOperadObj.substitutionSource O.toCollection).map (retainedRootAlgebraToRightUnit c))
    (O.subst.app (retainedRootAlgebraDatum c))
    (O.subst.app (ColoredSubstitutionData.rightUnit (ColoredSubstitutionData.unitProfile c)))
    (O.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom
      (ColoredSubstitutionData.unitProfile c)))
    (O.toCollection.map (retainedRootAlgebraTotalHom c)) (O.unit c)
    (O.unit c ≫ ColoredOperadObj.rightUnitInsert O.toCollection O.unit
      (ColoredSubstitutionData.unitProfile c))
    (retainedRootAlgebraSubstitution_rightUnit O c) (retainedRootUnitSource_right O c)
    ((Category.assoc (O.unit c)
      (ColoredOperadObj.rightUnitInsert O.toCollection O.unit
        (ColoredSubstitutionData.unitProfile c))
      (O.subst.app (ColoredSubstitutionData.rightUnit (ColoredSubstitutionData.unitProfile c)) ≫
        O.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom
          (ColoredSubstitutionData.unitProfile c)))).trans
      (originalUnaryUnit_rightComposition O c))


end CategoryTheory.Operad.Tensor.Enveloping

end
