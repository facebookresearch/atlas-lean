section EnvelopingSource093


/-!
# Exact original unit/retained coefficient indices of both association groupings
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original unit positions in expanded grouping A map to
the original root-first unit positions, keeping both root units
and every original middle algebra input unit. -/
def envelopingAssocUnitIndexEquiv (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    blockUnitIndex (envelopingAssocRetainedInputBlocks O d Q)
      (envelopingAssocInputUnitPositions d Q) ≃
      blockUnitIndex (envelopingAssocRootFirstRetainedBlocks O d Q)
        (envelopingAssocRootFirstUnitPosition d Q) where
  toFun p := match p with
    | ⟨none, j⟩ => j.elim
    | ⟨some (Sum.inl i), j⟩ => ⟨some ⟨Sum.inl i, Sum.inr j⟩, PUnit.unit⟩
    | ⟨some (Sum.inr j), none⟩ => ⟨none, j⟩
    | ⟨some (Sum.inr j), some _⟩ => ⟨some ⟨Sum.inr j, PUnit.unit⟩, PUnit.unit⟩
  invFun p := match p with
    | ⟨none, j⟩ => ⟨some (Sum.inr j), none⟩
    | ⟨some ⟨Sum.inl _, Sum.inl _⟩, j⟩ => j.elim
    | ⟨some ⟨Sum.inl i, Sum.inr j⟩, _⟩ => ⟨some (Sum.inl i), j⟩
    | ⟨some ⟨Sum.inr j, _⟩, _⟩ => ⟨some (Sum.inr j), some PUnit.unit⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => exact j.elim
    | some i => cases i with
      | inl i => rfl
      | inr i => cases j with
        | none => rfl
        | some j => cases j; rfl
  right_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => rfl
    | some p => rcases p with ⟨i, k⟩; cases i with
      | inl i => cases k with
        | inl k => exact j.elim
        | inr k => cases j; rfl
      | inr i => cases k; cases j; rfl

/-- The actual original retained coefficient positions map
from root/branch grouping to root-first grouping, with empty
root algebra and middle algebra unit blocks removed exactly. -/
def envelopingAssocRetainedIndexEquiv (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ((FiniteFamily.flatten (C := C)).obj (envelopingAssocRetainedInputBlocks O d Q)).index ≃
      ((FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstRetainedBlocks O d
        Q)).index where
  toFun p := match p with
    | ⟨none, _⟩ => ⟨none, none⟩
    | ⟨some (Sum.inl i), none⟩ => ⟨none, some i⟩
    | ⟨some (Sum.inl i), some j⟩ => ⟨some ⟨Sum.inl i, Sum.inl j⟩, PUnit.unit⟩
    | ⟨some (Sum.inr _), j⟩ => j.elim
  invFun p := match p with
    | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
    | ⟨none, some i⟩ => ⟨some (Sum.inl i), none⟩
    | ⟨some ⟨Sum.inl i, Sum.inl j⟩, _⟩ => ⟨some (Sum.inl i), some j⟩
    | ⟨some ⟨Sum.inl _, Sum.inr _⟩, j⟩ => j.elim
    | ⟨some ⟨Sum.inr _, _⟩, j⟩ => j.elim
  left_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j; rfl
    | some i => cases i with
      | inl i => cases j <;> rfl
      | inr i => exact j.elim
  right_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j <;> rfl
    | some p => rcases p with ⟨i, k⟩; cases i with
      | inl i => cases k with
        | inl k => cases j; rfl
        | inr k => exact j.elim
      | inr i => exact j.elim

/-- The exact original retained index map keeps every actual
operation coefficient object and original root/branch strand. -/
def envelopingAssocRetainedCoefficientIso (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).obj (envelopingAssocRetainedInputBlocks O d Q) ≅
      (FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstRetainedBlocks O d Q) :=
  FiniteFamily.isoOfComponents (envelopingAssocRetainedIndexEquiv O d Q) (fun p => match p with
    | ⟨none, _⟩ => Iso.refl _
    | ⟨some (Sum.inl _), none⟩ => Iso.refl _
    | ⟨some (Sum.inl _), some _⟩ => Iso.refl _
    | ⟨some (Sum.inr _), j⟩ => j.elim)


end CategoryTheory.Operad.Tensor.Enveloping

end
