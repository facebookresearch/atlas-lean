/- Exact checked source: TensorUnitBlockDistribution. -/
section EnvelopingSource048


/-!
# Genuine unit insertion distributes over every original finite tensor block
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem blockInversePost {V : Type*} [Category* V]
    {X Y Z : V} (e : Y ≅ Z) (a : X ⟶ Y) (b : X ⟶ Z) (h : a ≫ e.hom = b) :
    b ≫ e.inv = a := by
  rw [← h]
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]

private theorem blockPentagonFiring {V : Type*} [Category* V]
    {X A B D E P Q R Y : V}
    (a : X ⟶ A) (b : A ⟶ B) (t : B ⟶ D) (h : D ⟶ E) (j : E ⟶ Y)
    (z : X ⟶ P) (c : P ⟶ Q) (w : Q ⟶ R) (d : R ⟶ B) (k : R ⟶ E)
    (hp : a ≫ b = z ≫ c ≫ w ≫ d) (hn : d ≫ t ≫ h = k) :
    a ≫ b ≫ t ≫ h ≫ j = z ≫ c ≫ w ≫ k ≫ j := by
  rw [← Category.assoc a b, hp]
  simp only [Category.assoc]
  have hn' : (d ≫ t) ≫ h = k := (Category.assoc d t h).trans hn
  rw [← Category.assoc d t, ← Category.assoc (d ≫ t) h, hn']

private theorem blockPrecomposeFactors {V : Type*} [Category* V]
    {X P A B D E H Y : V}
    (p : X ⟶ P) (a : P ⟶ A) (q : A ⟶ B) (h : B ⟶ D) (j : D ⟶ Y)
    (r : X ⟶ E) (s : E ⟶ A) (b : E ⟶ H) (t : H ⟶ B)
    (hp : p ≫ a = r ≫ s) (hb : s ≫ q = b ≫ t) :
    p ≫ (a ≫ q ≫ h ≫ j) = r ≫ b ≫ t ≫ h ≫ j := by
  rw [← Category.assoc p a, hp]
  simp only [Category.assoc]
  rw [← Category.assoc s q, hb]
  simp only [Category.assoc]

private theorem blockIsoReindexInverse {V : Type*} [Category* V]
    {X Y Z D : V} (a : X ≅ Y) (e : Z ≅ D) (r : Y ⟶ Z) (n : X ⟶ D)
    (h : r ≫ e.hom = a.inv ≫ n) : a.hom ≫ r = n ≫ e.inv := by
  apply (cancel_mono e.hom).1
  rw [Category.assoc, h]
  rw [← Category.assoc a.hom a.inv, Iso.hom_inv_id, Category.id_comp,
    Category.assoc n e.inv, Iso.inv_hom_id, Category.comp_id]

private theorem blockMapThree {V : Type*} [Category* V] {D : Type*} [Category* D] (T : V ⥤ D)
    {X Y Z E : V} (a : X ⟶ Y) (b : Y ⟶ Z) (c : Z ⟶ E) :
    T.map a ≫ T.map b ≫ T.map c = T.map (a ≫ b ≫ c) := by
  rw [← T.map_comp, ← T.map_comp]

private theorem blockLeftAssembly {V : Type*} [Category* V]
    {X P A B D E H K Y : V}
    (p : X ⟶ P) (ei : P ⟶ A) (cK : A ⟶ B) (bK : B ⟶ Y)
    (z : X ⟶ D) (r : D ⟶ A) (c : D ⟶ E) (rt : E ⟶ B)
    (w : E ⟶ H) (k : H ⟶ K) (j : K ⟶ Y)
    (he : z ≫ r = p ≫ ei) (hr : r ≫ cK = c ≫ rt) (hb : w ≫ k ≫ j = rt ≫ bK) :
    p ≫ (ei ≫ cK ≫ bK) = z ≫ c ≫ w ≫ k ≫ j := by
  rw [← Category.assoc p ei, ← he]
  simp only [Category.assoc]
  rw [← Category.assoc r cK, hr]
  simp only [Category.assoc]
  rw [← hb]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The actual blockwise singleton/empty tensor maps commute
with the exact original combined unit-family reindexing. -/
theorem blockUnit_tensor_reindex (N : FiniteFamily (FiniteFamily C)) (J : N.index →
  FintypeCat.{0}) :
    (FiniteFamily.flattenMapIso (FiniteTensor.tensor (V := C))).hom.app (blockUnitTriple N J) ≫
        (FiniteFamily.flatten (C := C)).map (blockUnitTensorMap N J) ≫
        (blockUnitFamilyReindexIso N J).hom =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (blockUnitTripleReindexIso N J).hom ≫
        (frozenVariableBlockIso (blockUnitIndex N J) ((FiniteFamily.flatten (C :=
          C)).obj N)).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases j with
    | inl j =>
      change HEq (𝟙 ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty) ≫
        𝟙 ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty) ≫
        𝟙 ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty))
        ((FiniteTensor.tensor (V := C)).map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫
          𝟙 ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty))
      exact heq_of_eq (by simp only [Category.id_comp, Functor.map_id])
    | inr j =>
      change HEq (𝟙 _ ≫ (FiniteTensor.singletonIso (V := C)).hom.app ((N.obj i).obj j) ≫ 𝟙 _)
        ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C :=
          C)).obj ((N.obj i).obj j))) ≫
          (FiniteTensor.singletonIso (V := C)).hom.app ((N.obj i).obj j))
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id, Functor.map_id])

/-- Each actual blockwise flattening comparison is invertible. -/
def blockUnitFlattenIso (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0}) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (blockUnitTriple N J) ≅ N :=
  FiniteFamily.isoOfComponents (Equiv.refl N.index) (fun i =>
    frozenVariableFlattenIso (J i) (N.obj i))

/-- Genuine finite tensor coherence distributes the original
global tensor-unit insertion over every original nested tensor block,
retaining the actual original unit/retained-position bijection. -/
theorem tensorUnitBlock_distribution (N : FiniteFamily (FiniteFamily C)) (J : N.index →
  FintypeCat.{0}) :
    (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N)).hom =
      (FiniteTensor.flattenIso (V := C)).hom.app N ≫
        (FiniteTensor.tensor (V := C)).map (blockUnitInsertionMap N J) ≫
        (FiniteTensor.flattenIso (V := C)).inv.app (blockUnitFamilies N J) ≫
        (FiniteTensor.tensor (V := C)).map (blockUnitFamilyReindexIso N J).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let M := blockUnitTriple N J
  let K := frozenVariableBlocks (blockUnitIndex N J) (F.obj N)
  let U := blockUnitFamilies N J
  let r := blockUnitTripleReindexIso N J
  let e := frozenVariableFlattenIso (blockUnitIndex N J) (F.obj N)
  let n := blockUnitFlattenIso N J
  let p := T.map (F.map n.hom)
  have hn : n.hom = blockUnitFlattenMap N J := rfl
  let z := T.map (FiniteFamily.flattenAssocIso.hom.app M)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.map F).obj M)
  let b := T.map ((FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app M)
  let c := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.flatten (C :=
    FiniteFamily C)).obj M)
  let w := T.map ((FiniteFamily.flattenMapIso T).hom.app M)
  let d := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.map (FiniteFamily.map
    T)).obj M)
  let t := T.map ((FiniteFamily.map T).map (blockUnitTensorMap N J))
  let h := (FiniteTensor.flattenIso (V := C)).inv.app U
  let j := T.map (blockUnitFamilyReindexIso N J).hom
  let k := T.map (F.map (blockUnitTensorMap N J))
  have hpent : a ≫ b = z ≫ c ≫ w ≫ d := FiniteTensor.flattenAssocLaw_app_unfold M
  have hnat : d ≫ t ≫ h = k := by
    have he := (FiniteTensor.flattenIso (V := C)).hom.naturality (blockUnitTensorMap N J)
    change k ≫ (FiniteTensor.flattenIso (V := C)).hom.app U = d ≫ t at he
    exact (Category.assoc d t h).symm.trans
      (blockInversePost ((FiniteTensor.flattenIso (V := C)).app U) k (d ≫ t) he)
  have hraw : a ≫ b ≫ t ≫ h ≫ j = z ≫ c ≫ w ≫ k ≫ j :=
    blockPentagonFiring a b t h j z c w d k hpent hnat
  have hcomp : T.map ((FiniteFamily.map T).map n.hom) ≫ T.map (blockUnitInsertionMap N J)
    = b ≫ t := by
    rw [hn]
    exact (T.map_comp _ _).symm.trans
      ((congrArg T.map (blockUnitInsertion_decomposition N J)).trans (T.map_comp _ _))
  have hpnat : p ≫ (FiniteTensor.flattenIso (V := C)).hom.app N = a ≫
    T.map ((FiniteFamily.map T).map n.hom) :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality n.hom
  have hright : p ≫ ((FiniteTensor.flattenIso (V := C)).hom.app N ≫
      T.map (blockUnitInsertionMap N J) ≫ h ≫ j) = z ≫ c ≫ w ≫ k ≫ j :=
    (blockPrecomposeFactors p ((FiniteTensor.flattenIso (V := C)).hom.app N)
      (T.map (blockUnitInsertionMap N J)) h j a (T.map ((FiniteFamily.map T).map n.hom)) b t
        hpnat hcomp).trans hraw
  have hflat : F.map r.hom ≫ e.hom = FiniteFamily.flattenAssocIso.inv.app M ≫ F.map n.hom := by
    rw [hn]
    exact blockUnit_flatten_reindex N J
  have he : FiniteFamily.flattenAssocIso.hom.app M ≫ F.map r.hom = F.map n.hom ≫ e.inv :=
    blockIsoReindexInverse (FiniteFamily.flattenAssocIso.app M) e (F.map r.hom) (F.map n.hom) hflat
  have heT : z ≫ T.map (F.map r.hom) = p ≫ T.map e.inv :=
    (T.map_comp _ _).symm.trans ((congrArg T.map he).trans (T.map_comp _ _))
  have hr : T.map (F.map r.hom) ≫ (FiniteTensor.flattenIso (V := C)).hom.app K =
      c ≫ T.map ((FiniteFamily.map T).map r.hom) :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality r.hom
  have hlast : w ≫ k ≫ j = T.map ((FiniteFamily.map T).map r.hom) ≫
      T.map (frozenVariableBlockIso (blockUnitIndex N J) (F.obj N)).hom :=
    (blockMapThree T ((FiniteFamily.flattenMapIso T).hom.app M) (F.map (blockUnitTensorMap N J))
      (blockUnitFamilyReindexIso N J).hom).trans
        ((congrArg T.map (blockUnit_tensor_reindex N J)).trans (T.map_comp _ _))
  have hleft : p ≫ (frozenVariableTensorUnitIso (blockUnitIndex N J) (F.obj N)).hom =
      z ≫ c ≫ w ≫ k ≫ j := by
    change p ≫ (T.map e.inv ≫ (FiniteTensor.flattenIso (V := C)).hom.app K ≫
      T.map (frozenVariableBlockIso (blockUnitIndex N J) (F.obj N)).hom) = _
    exact blockLeftAssembly p (T.map e.inv) ((FiniteTensor.flattenIso (V := C)).hom.app K)
      (T.map (frozenVariableBlockIso (blockUnitIndex N J) (F.obj N)).hom)
      z (T.map (F.map r.hom)) c (T.map ((FiniteFamily.map T).map r.hom)) w k j heT hr hlast
  have : IsIso p := by dsimp only [p]; infer_instance
  exact (cancel_epi p).1 (hleft.trans hright.symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource048

/- Exact checked source: TensorUnitBlockMapDistribution. -/
section EnvelopingSource049


/-!
# Original blockwise coefficient maps after genuine tensor-unit insertion
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalBlockAppliedSquare {V : Type*} [Category* V]
    {X A B D E Y : V} (a : X ⟶ A) (u : A ⟶ B) (h : D ≅ B) (j : D ≅ E)
    (f : D ⟶ Y) (g : B ⟶ Y) (hg : h.hom ≫ g = f) :
    (a ≫ u ≫ h.inv ≫ j.hom) ≫ (j.inv ≫ f) = a ≫ (u ≫ g) := by
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  rw [← hg]
  simp only [Iso.inv_hom_id_assoc]

private theorem originalAppliedMapFiring {V : Type*} [Category* V]
    {X A B Y : V} (a : X ⟶ A) (u : A ⟶ B) (g : B ⟶ Y) (f : A ⟶ Y)
    (h : u ≫ g = f) : a ≫ (u ≫ g) = a ≫ f := congrArg (a ≫ ·) h

private theorem mapBlockInverseComposite {V : Type*} [Category* V] {D : Type*} [Category* D]
  (T : V ⥤ D)
    {X Y Z : V} (e : X ≅ Y) (f : X ⟶ Z) :
    T.map (e.inv ≫ f) = (T.mapIso e).inv ≫ T.map f := T.map_comp _ _

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- Every original block's unit/coefficient map retains its original block index. -/
def blockUnitTargetMap (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i) :
    blockUnitFamilies N J ⟶ ⟨N.index, M⟩ where
  equiv := Equiv.refl N.index
  hom := f

/-- The actual unit insertion followed by the original unit and
coefficient maps in every original finite block. -/
def blockUnitAppliedMap (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj N ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj ⟨N.index, M⟩ where
  equiv := Equiv.refl N.index
  hom i := (frozenVariableTensorUnitIso (J i) (N.obj i)).hom ≫ (FiniteTensor.tensor (V :=
    C)).map (f i)

/-- The actual combined global unit/coefficient map keeps the
original unit-position grouping and each actual original block map. -/
def blockUnitGlobalMap (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i) :
    frozenVariableUnitFamily (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N) ⟶
      (FiniteFamily.flatten (C := C)).obj ⟨N.index, M⟩ :=
  (blockUnitFamilyReindexIso N J).inv ≫ (FiniteFamily.flatten (C :=
    C)).map (blockUnitTargetMap N J M f)

/-- The actual source unit insertions and original block maps
form the original applied-map composite at every retained block. -/
theorem blockUnitAppliedMap_factorization (N : FiniteFamily (FiniteFamily C)) (J : N.index
  → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i) :
    blockUnitInsertionMap N J ≫ (FiniteFamily.map (FiniteTensor.tensor (V := C))).map
        (blockUnitTargetMap N J M f) = blockUnitAppliedMap N J M f := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    exact HEq.rfl

/-- The actual global original unit/coefficient map and original
blockwise unit/coefficient maps agree by genuine tensor coherence. -/
theorem tensorUnitBlock_applied (N : FiniteFamily (FiniteFamily C)) (J : N.index → FintypeCat.{0})
    (M : N.index → FiniteFamily C) (f : ∀ i, frozenVariableUnitFamily (J i) (N.obj i) ⟶ M i) :
    (frozenVariableTensorUnitIso (blockUnitIndex N J) ((FiniteFamily.flatten (C := C)).obj N)).hom ≫
        (FiniteTensor.tensor (V := C)).map (blockUnitGlobalMap N J M f) ≫
        (FiniteTensor.flattenIso (V := C)).hom.app ⟨N.index, M⟩ =
      (FiniteTensor.flattenIso (V := C)).hom.app N ≫
        (FiniteTensor.tensor (V := C)).map (blockUnitAppliedMap N J M f) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let U := blockUnitFamilies N J
  let V : FiniteFamily (FiniteFamily C) := ⟨N.index, M⟩
  let e := T.mapIso (blockUnitFamilyReindexIso N J)
  let h := (FiniteTensor.flattenIso (V := C)).app U
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let u := T.map (blockUnitInsertionMap N J)
  let q := T.map (F.map (blockUnitTargetMap N J M f))
  let b := (FiniteTensor.flattenIso (V := C)).hom.app V
  let g := T.map ((FiniteFamily.map T).map (blockUnitTargetMap N J M f))
  have hn : h.hom ≫ g = q ≫ b := (FiniteTensor.flattenIso (V := C)).hom.naturality
    (blockUnitTargetMap N J M f) |>.symm
  have hm : T.map (blockUnitGlobalMap N J M f) ≫ b = e.inv ≫ (q ≫ b) := by
    exact (congrArg (· ≫ b) (mapBlockInverseComposite T (blockUnitFamilyReindexIso N J)
      (F.map (blockUnitTargetMap N J M f)))).trans (Category.assoc _ _ _)
  have hu : u ≫ g = T.map (blockUnitAppliedMap N J M f) :=
    (T.map_comp _ _).symm.trans (congrArg T.map (blockUnitAppliedMap_factorization N J M f))
  have hh : (frozenVariableTensorUnitIso (blockUnitIndex N J) (F.obj N)).hom = a ≫ u ≫
    h.inv ≫ e.hom :=
    tensorUnitBlock_distribution N J
  have hstart : (frozenVariableTensorUnitIso (blockUnitIndex N J) (F.obj N)).hom ≫
      (T.map (blockUnitGlobalMap N J M f) ≫ b) = (a ≫ u ≫ h.inv ≫ e.hom) ≫ (e.inv ≫ (q ≫ b)) :=
    congrArg₂ (fun x y => x ≫ y) hh hm
  exact hstart.trans ((originalBlockAppliedSquare a u h e (q ≫ b) g hn).trans
    (originalAppliedMapFiring a u g (T.map (blockUnitAppliedMap N J M f)) hu))


end CategoryTheory.Operad.Tensor.Enveloping

end
