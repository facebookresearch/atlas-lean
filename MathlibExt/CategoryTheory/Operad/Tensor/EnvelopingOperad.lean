universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem relationTriangle {D : Type*} [Category* D]
    {X A B : D} (u : X ⟶ A) (v : X ⟶ B) (s : A ⟶ B) (c : B ⟶ A)
    (hu : u ≫ s = v) (hs : s ≫ c = 𝟙 A) : v ≫ c = u := by
  rw [← hu, Category.assoc, hs, Category.comp_id]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original generator at every color produces the actual full
linear-operad section before an algebra action is chosen. -/
def constantRelationOperadGenerator (O : ColoredOperadObj W C) (B : W → C) :
    envelopingLinearOperad O B ⟶ envelopingLinearOperad O (profileCoinvariants O.toCollection B) :=
  linearCarrierOperadMap O ((profileUnit O).app B)

/-- The full original constant-input collection face is sectioned by
the actual original operadic generator map at every original profile. -/
theorem constantRelationOperadGenerator_collection (O : ColoredOperadObj W C) (B : W → C) :
    (constantRelationOperadGenerator O B).toCollectionHom ≫ Variable.constantInputActionMap O B =
      𝟙 (linearCoefficientCollection O.toCollection B) := by
  ext P
  exact Unit.constantInputAction_unit O B P

/-- The original constant-input relation face retains every original
O-operation through its actual original empty coefficient summand. -/
theorem constantInputAction_original (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) :
    originalOperationToLinear O.toCollection (profileCoinvariants O.toCollection B) P ≫
      constantInputAction O B P = originalOperationToLinear O.toCollection B P :=
  relationTriangle (originalOperationToLinear O.toCollection B P)
    (originalOperationToLinear O.toCollection (profileCoinvariants O.toCollection B) P)
    (linearCoefficientCarrierLift O.toCollection ((profileUnit O).app B) P)
    (constantInputAction O B P)
    (originalOperationToLinear_carrier O.toCollection ((profileUnit O).app B) P)
    (Unit.constantInputAction_unit O B P)

/-- The actual original constant-input relation face preserves the
literal original linear operad unit, by its proved generator section. -/
theorem constantInputAction_preserves_linearUnit (O : ColoredOperadObj W C) (B : W → C)
    (d : W) :
    envelopingLinearUnit O (profileCoinvariants O.toCollection B) d ≫
      constantInputAction O B (ColoredSubstitutionData.unitProfile d) =
        envelopingLinearUnit O B d :=
  relationTriangle (envelopingLinearUnit O B d)
    (envelopingLinearUnit O (profileCoinvariants O.toCollection B) d)
    (linearCoefficientCarrierLift O.toCollection ((profileUnit O).app B)
      (ColoredSubstitutionData.unitProfile d))
    (constantInputAction O B (ColoredSubstitutionData.unitProfile d))
    (linearCarrier_unit O ((profileUnit O).app B) d)
    (Unit.constantInputAction_unit O B (ColoredSubstitutionData.unitProfile d))


end CategoryTheory.Operad.Tensor.Enveloping

