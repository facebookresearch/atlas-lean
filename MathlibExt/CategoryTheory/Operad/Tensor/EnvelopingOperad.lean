/- Exact checked source: EnvelopingAssociativityRootFirstSquares. -/
section EnvelopingSource067


/-!
# Original middle and flat-inner substitution squares for root-first association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalRootFirstTwoSquares {V : Type*} [Category* V]
    {X X' Y Y' Z : V} (f : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (g : Y ⟶ Y')
    (b : Y' ⟶ Z) (c : Y ⟶ Z) (h : f ≫ a' = a ≫ g) (hb : g ≫ b = c) :
    f ≫ a' ≫ b = a ≫ c := by
  rw [← Category.assoc f a', h, Category.assoc, hb]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Actual original middle substitution is transported through
the original middle representative profile map and exact original
middle algebra-input regrouping. -/
theorem envelopingAssocMiddleSubstitution_naturality (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (ColoredOperadObj.substitutionSource O.toCollection).map (envelopingAssocMiddleProfileMap d Q) ≫
        O.subst.app (envelopingAssocMiddleRepresentative d Q) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom d.middleData
          (envelopingAssocMiddleChoices d Q)) ≫
        O.toCollection.map (extendProfileMap (𝟙 d.middleData.totalProfile)
          (envelopingAssocMiddleAlgebraMap d Q)) =
      O.subst.app (envelopingRepresentativeAssoc d Q).middleData ≫
        O.toCollection.map (envelopingAssocMiddleTotalHom d Q) := by
  have hm : O.toCollection.map (ColoredSubstitutionData.totalProfileMap
    (envelopingAssocMiddleProfileMap d Q)) ≫
      O.toCollection.map (envelopingRepresentativeTotalHom d.middleData
        (envelopingAssocMiddleChoices d Q)) ≫
      O.toCollection.map (extendProfileMap (𝟙 d.middleData.totalProfile)
        (envelopingAssocMiddleAlgebraMap d Q)) =
      O.toCollection.map (envelopingAssocMiddleTotalHom d Q) :=
    (congrArg (O.toCollection.map (ColoredSubstitutionData.totalProfileMap
      (envelopingAssocMiddleProfileMap d Q)) ≫ ·)
      (O.toCollection.map_comp _ _).symm).trans
        ((O.toCollection.map_comp _ _).symm.trans (congrArg O.toCollection.map
          (envelopingAssocMiddleProfileMap_total d
          Q)))
  exact originalRootFirstTwoSquares _ _ _ _ _ _
    (O.subst.naturality (envelopingAssocMiddleProfileMap d Q)) hm

/-- Actual original flat-inner substitution and the original
dependent-sum associator retain exactly the original total
variable and root/middle/innermost algebra-input maps. -/
theorem envelopingAssocFlatInnerSubstitution_naturality (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (ColoredOperadObj.substitutionSource O.toCollection).map (envelopingAssocFlatInnerMap d Q) ≫
        O.subst.app (envelopingRepresentativeSubstitution d.innerData
          (envelopingAssocInnerChoices d Q)) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom d.innerData
          (envelopingAssocInnerChoices d Q)) ≫
        O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q)) =
      O.subst.app (envelopingRepresentativeAssoc d Q).innerData ≫
        O.toCollection.map ((envelopingRepresentativeAssoc d Q).totalHom) ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) := by
  have hm : O.toCollection.map (ColoredSubstitutionData.totalProfileMap
    (envelopingAssocFlatInnerMap d Q)) ≫
      O.toCollection.map (envelopingRepresentativeTotalHom d.innerData
        (envelopingAssocInnerChoices d Q)) ≫
      O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q)) =
      O.toCollection.map ((envelopingRepresentativeAssoc d Q).totalHom) ≫
        O.toCollection.map (envelopingAssocTotalHom d
        Q) :=
    (congrArg (O.toCollection.map (ColoredSubstitutionData.totalProfileMap
      (envelopingAssocFlatInnerMap d Q)) ≫ ·)
      (O.toCollection.map_comp _ _).symm).trans
