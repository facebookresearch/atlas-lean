/- Exact checked source: LinearAlgebra.CoefficientEvaluation. -/
section EnvelopingSource235


/-!
# Actual weighted representative algebra evaluation on its common coefficient source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem routeEvaluationFiring {D : Type*} [Category* D]
    {X A B C C' E E' F G Y : D}
    (h : X ⟶ A) (u : A ⟶ B) (j : B ⟶ C) (ell : C ⟶ E) (t : E ⟶ F)
    (p : F ⟶ G) (o : G ⟶ Y) (j' : A ⟶ C') (v : C' ⟶ C)
    (ell' : C' ⟶ E') (t' : E' ⟶ F) (n : X ⟶ E') (r : X ⟶ B) (ev : B ⟶ Y)
    (hr : r = h ≫ u) (he : ev = j ≫ ell ≫ t ≫ p ≫ o)
    (hj : u ≫ j = j' ≫ v) (hl : v ≫ ell ≫ t = ell' ≫ t') (hn : n = h ≫ j' ≫ ell') :
    r ≫ ev = n ≫ t' ≫ p ≫ o := by
  rw [hr, he]
  simp only [Category.assoc]
  rw [← Category.assoc u j, hj]
  simp only [Category.assoc]
  have htail : v ≫ ell ≫ t ≫ p ≫ o = ell' ≫ t' ≫ p ≫ o := by
    simpa only [Category.assoc] using congrArg (fun k => k ≫ p ≫ o) hl
  rw [htail]
  simpa only [Category.assoc] using congrArg (fun k => k ≫ t' ≫ p ≫ o) hn.symm

private theorem evaluationMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

variable {C : Type w} [Category.{v} C]

/-- The actual coefficient arrow passes through both original leaf
maps with all original input bijections and component arrows retained. -/
theorem coefficientLeafMap_twoLeaves {X Y : C} (c : X ⟶ Y)
    {L M N : FiniteFamily C} (ell : L ⟶ M) (t : M ⟶ N) :
    (coefficientLeafFamilyFunctor L).map c ≫ coefficientLeafMap (𝟙 Y) ell ≫
      coefficientLeafMap (𝟙 Y) t =
    coefficientLeafMap (𝟙 X) ell ≫ coefficientLeafMap c t := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq (c ≫ 𝟙 Y ≫ 𝟙 Y) (𝟙 X ≫ c)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | some i =>
      change HEq (𝟙 (L.obj i) ≫ ell.hom i ≫ t.hom (ell.equiv i))
        (ell.hom i ≫ t.hom (ell.equiv i))
      exact heq_of_eq (Category.id_comp _)

variable {W : Type u} [FiniteTensor C]

/-- The complete weighted representative O-algebra evaluation is
