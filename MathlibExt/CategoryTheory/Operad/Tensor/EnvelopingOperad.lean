      apply finiteFamilyIso_identityComponents
      intro p
      rcases p with ⟨i, j⟩
      cases i with
      | none => exact ⟨rfl, rfl⟩
      | some i => cases i with
        | inl i => exact ⟨rfl, rfl⟩
        | inr i => exact j.elim
    have h2 : (envelopingAssocRetainedCoefficientIso O d Q).hom.HasIdentityComponents := by
      apply finiteFamilyIso_identityComponents
      intro p
      rcases p with ⟨i, j⟩
      cases i with
      | none => exact ⟨rfl, rfl⟩
      | some i => cases i with
        | inl i => cases j <;> exact ⟨rfl, rfl⟩
        | inr i => exact j.elim
    have h3 : (envelopingAssocRootFirstCoreFlattenIso O d Q).hom.HasIdentityComponents := by
      have hr : (envelopingAssocRootFirstCoreBlocksIso O d Q).hom.HasIdentityComponents := by
        apply finiteFamilyIso_identityComponents
        intro p
