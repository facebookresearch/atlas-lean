namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalRootSingletonSquare {V : Type*} [Category* V]
    {X A B Y D : V} (a : X ⟶ A) (u : A ⟶ B) (k : X ⟶ Y) (b : Y ⟶ B) (f : B ⟶ D)
    (h : k ≫ b = a ≫ u) : (a ≫ u) ≫ f = k ≫ (b ≫ f) := by
  rw [← h, Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original two unary unit coefficients of a retained
root algebra branch, in the original outer/inner factor order. -/
def retainedRootUnitFactors (O : ColoredOperadObj W C) (c : W) :
    UnitInsertion.rightTensorFamily ((FiniteTensor.tensor (V :=
      C)).obj FiniteFamily.empty) (FintypeCat.of PUnit) ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj (retainedRootAlgebraDatum c) where
  equiv := Equiv.refl (Option PUnit)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app
        ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty) ≫ O.unit c
    | some _ => O.unit c

/-- The actual source coefficient map from the original right
prefix into the original unary-unit operad substitution factors. -/
def retainedRootUnitSource (O : ColoredOperadObj W C) (c : W) :
    (FiniteTensor.tensor (V := C)).obj FiniteFamily.empty ⟶
      (ColoredOperadObj.substitutionSource O.toCollection).obj (retainedRootAlgebraDatum c) :=
  UnitInsertion.rightInsertPrefix ((FiniteTensor.tensor (V :=
    C)).obj FiniteFamily.empty) (FintypeCat.of PUnit) ≫
    (FiniteTensor.tensor (V := C)).map (retainedRootUnitFactors O c)

/-- The actual root-unit factor map into the original right-unit
shape is the original colored right-unit factor after root unit naturality. -/
theorem retainedRootUnitFactors_right (O : ColoredOperadObj W C) (c : W) :
    retainedRootUnitFactors O c ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (retainedRootAlgebraToRightUnit c) =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map
          (UnitInsertion.rightNestedFamilyMap (O.unit c) (FintypeCat.of PUnit)) ≫
        ColoredOperadObj.UnitInsertion.rightFactorHom O.toCollection O.unit
          (ColoredSubstitutionData.unitProfile c)
          := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq (((FiniteTensor.singletonIso (V := C)).hom.app
        ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty) ≫ O.unit c) ≫ O.toCollection.map
          (ColoredSubstitutionData.outerProfileMap (retainedRootAlgebraToRightUnit c)))
        ((FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map (O.unit c)) ≫
          ((FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj
            (ColoredSubstitutionData.unitProfile c)) ≫
            O.toCollection.map (ColoredSubstitutionData.rightUnitOuterHom
              (ColoredSubstitutionData.unitProfile c))))
      exact heq_of_eq (by
        have hroot : ColoredSubstitutionData.outerProfileMap (retainedRootAlgebraToRightUnit c) =
            ColoredSubstitutionData.rightUnitOuterHom (ColoredSubstitutionData.unitProfile c) := by
          apply ColoredProfile.Hom.ext
          rfl
        have hnat := (FiniteTensor.singletonIso (V := C)).hom.naturality (O.unit c)
        have hcoef := originalRootSingletonSquare
          ((FiniteTensor.singletonIso (V := C)).hom.app ((FiniteTensor.tensor (V :=
            C)).obj FiniteFamily.empty))
          (O.unit c) ((FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C :=
            C)).map (O.unit c)))
          ((FiniteTensor.singletonIso (V := C)).hom.app (O.toCollection.obj
            (ColoredSubstitutionData.unitProfile c)))
          (O.toCollection.map (ColoredSubstitutionData.rightUnitOuterHom
            (ColoredSubstitutionData.unitProfile c))) hnat
        exact (congrArg (fun f => ((FiniteTensor.singletonIso (V := C)).hom.app
          ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty) ≫ O.unit c) ≫
            O.toCollection.map f) hroot).trans
            hcoef)
    | some i =>
      change HEq (O.unit c ≫ O.toCollection.map (𝟙 (ColoredSubstitutionData.unitProfile c)))
        ((FiniteTensor.tensor (V := C)).map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ O.unit c)
      exact heq_of_eq (by
        have ho := O.toCollection.map_id (ColoredSubstitutionData.unitProfile c)
        have ht := (FiniteTensor.tensor (V := C)).map_id (FiniteFamily.empty : FiniteFamily C)
        exact (congrArg (O.unit c ≫ ·) ho).trans ((Category.comp_id _).trans
          ((Category.id_comp (O.unit c)).symm.trans (congrArg (· ≫ O.unit c) ht).symm)))


end CategoryTheory.Operad.Tensor.Enveloping

end
