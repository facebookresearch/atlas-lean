/-- The actual branch coefficient presentation and actual branch
leaf comparison are exactly the joint original coefficient/leaf map. -/
theorem branchNormalizedFactors_hom (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) (i : d.branches.index) :
    (envelopingAssocBranchNormalizedFactorsIso O B d Q i).hom =
      coefficientLeafMap ((FiniteTensor.tensor (V := C)).map
        (envelopingCoefficientBlockIso O (d.localData i) (Q.branch i)).hom)
        (envelopingAlgebraLeafIso B (d.localData i) (Q.branch i)).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro p
    cases p with
    | none => rfl
    | some p => rcases p with ⟨j, k⟩; cases j <;> rfl

/-- The original middle coefficient and leaf map are retained by
the original root-first middle normalized factors. -/
theorem middleNormalizedFactors_hom (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocMiddleNormalizedFactorsIso O B d Q).hom =
      coefficientLeafMap ((FiniteTensor.tensor (V := C)).map
        (envelopingCoefficientBlockIso O d.middleData (envelopingAssocMiddleChoices d Q)).hom)
        (envelopingAssocMiddleLeafIso B d Q).hom := rfl

/-- The original branch weighted presentation comparison is the
weighted map of its original coefficient comparison and input identities. -/
theorem weightedBranchSource_hom (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) (i : d.branches.index) :
    (weightedBlocksIsoA O B d Q).hom.hom (some i) =
      weightedInputBlockMap (FintypeCat.of (Option (d.localData i).inner.index))
        (envelopingCoefficientBlockIso O (d.localData i) (Q.branch i)).hom.hom
        (fun j => 𝟙 ((addedAlgebraInputs B).obj (Q.branch i j))) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro j
    cases j with
    | none =>
      exact heq_of_eq (tensorLeafMap_id
        (O.obj (extendProfile (d.localData i).outerProfile (Q.branch i none)))
