restricts to a genuine algebra map over its other two legs, retaining
the literal original complete colorwise carrier arrow. -/
def restrictionMapTriangle {O P Q : ColoredOperadObj W C}
    (u : O ⟶ P) (v : P ⟶ Q) (w : O ⟶ Q) (h : u ≫ v = w)
    {M : Algebra P} {N : Algebra Q} (f : M ⟶ Algebra.restrict v N) :
    Algebra.restrict u M ⟶ Algebra.restrict w N where
  hom := f.hom
  comm d R := by
    let g := (restrictionFunctor u).map f
    have hg := g.comm d R
    change (Restriction.operations u M.operations).app d R ≫ f.hom d =
      (analyticSummandCarrierMap O.toCollection f.hom).app R ≫
        (Restriction.operations u (Restriction.operations v N.operations)).app d R at hg
    exact hg.trans
      (congrArg ((analyticSummandCarrierMap O.toCollection f.hom).app R ≫ ·)
        (congrArg (fun a : Operations O.toCollection N.carrier N.carrier => a.app d R)
          (restrictionOperations_triangle u v w h N.operations)))

