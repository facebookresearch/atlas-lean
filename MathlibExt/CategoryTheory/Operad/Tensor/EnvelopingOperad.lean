/-!
# Actual original unary unit branches in enveloping association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- The original unary branch total collapses by the exact
original dependent-unit input bijection. -/
def retainedRootAlgebraTotalHom (c : W) :
    (retainedRootAlgebraDatum c).totalProfile ⟶ ColoredSubstitutionData.unitProfile c where
