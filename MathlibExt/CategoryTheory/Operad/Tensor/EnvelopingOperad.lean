/- Exact checked source: WeightedNormalization.SigmaAtomicData. -/
section EnvelopingSource326


/-!
# Exact original coefficient and leaf embeddings for the constant-input atomic source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension.AtomicNormalization

open CategoryTheory

private theorem paddedInput {D : Type*} [Category* D] {A B : D} (f : A ⟶ B) (g : B ⟶ B)
  (hg : g = 𝟙 B) :
    (𝟙 A ≫ 𝟙 A) ≫ f = f ≫ g := by
  rw [hg]
  exact ((congrArg (· ≫ f) (Category.id_comp (𝟙 A))).trans (Category.id_comp f)).trans
    (Category.comp_id f).symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original leaf blocks consist of an empty root block and each frozen branch profile leaf
family. -/
def oldLeafBlocks (B : W → C) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) : Option
  Q.index → FiniteFamily C
  | none => FiniteFamily.empty
  | some j => profileLeafFamily B (R j).toColoredProfile

/-- Embed the frozen coefficient family into its flattened atomic grouping with empty
variable-unit blocks. -/
def coefficientEmbedding (O : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q :
  ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    frozenCoefficientFamily O P Q R ≅ (FiniteFamily.flatten (C :=
      C)).obj (coefficientGrouping O P Q R) :=
  (frozenVariableFlattenIso P.inputs (frozenCoefficientFamily O P Q R)).symm

/-- Map each original leaf block by identity to its position in the atomic coefficient grouping. -/
def leafIdentity (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q)
    (i : (frozenCoefficientFamily O P Q R).index) :
    oldLeafBlocks B Q R i ⟶ atomicLeaves O B P Q R ((coefficientEmbedding O P Q
      R).hom.equiv i) := by
  cases i <;> exact 𝟙 _

/-- Original weighted roots and branches enter precisely their original
coefficient/leaf tensor frames, through original empty/profile comparisons. -/
def oldWeightedFrameIso (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) (R
  : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O B P Q R ≅
      weightedInputBlockFamily (frozenCoefficientFamily O P Q R).index
        (frozenCoefficientFamily O P Q R).obj
        (oldLeafBlocks B Q R) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => (emptyLeafTensorIso (O.obj (extendProfile P Q))).symm
    | some j => (profileCoefficientLeafTensorIso O B (R j).toColoredProfile).symm)

/-- Empty variable/root groups and singleton coefficient-group indices
drop exactly their empty or singleton bookkeeping. Every actual ⟨Qj,Rj-input⟩ remains. -/
def groupedLeavesIso (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    groupedCoefficientInputLeaves (coefficientGrouping O P Q R) (atomicLeaves O B P Q R) ≅
      frozenAlgebraLeaves B Q R :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with
        | ⟨Sum.inl _, ⟨j, _⟩⟩ => j.elim
        | ⟨Sum.inr none, ⟨_, j⟩⟩ => j.elim
        | ⟨Sum.inr (some i), ⟨_, j⟩⟩ => ⟨i, j⟩
      invFun := fun p => ⟨Sum.inr (some p.1), ⟨PUnit.unit, p.2⟩⟩
      left_inv := fun p => by
        rcases p with ⟨i, ⟨j, k⟩⟩
        cases i with
          | inl i => cases j
          | inr i => cases i with
          | none => cases k
          | some i => cases j; rfl
      right_inv := fun p => by cases p; rfl }
    (fun p => match p with
      | ⟨Sum.inl _, ⟨j, _⟩⟩ => j.elim
      | ⟨Sum.inr none, ⟨_, j⟩⟩ => j.elim
      | ⟨Sum.inr (some i), ⟨_, j⟩⟩ => Iso.refl (B ((R i).inputColor j)))

/-- Flatten the original branch leaf blocks to recover the frozen algebra leaves. -/
def oldLeavesIso (B : W → C) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    totalBlockInputs (FintypeCat.of (Option Q.index)) (oldLeafBlocks B Q R) ≅
      frozenAlgebraLeaves B Q R :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | ⟨none, j⟩ => j.elim | ⟨some i, j⟩ => ⟨i, j⟩
      invFun := fun p => ⟨some p.1, p.2⟩
      left_inv := fun p => by rcases p with ⟨i, j⟩; cases i with | none => cases j | some i => rfl
      right_inv := fun p => by cases p; rfl }
    (fun p => match p with | ⟨none, j⟩ => j.elim | ⟨some i, j⟩ => Iso.refl (B ((R i).inputColor j)))

omit [FiniteTensor C] in
/-- The complete original dependent leaf correction commutes with the
original coefficient embedding; no heterogeneous or nullary strand is omitted. -/
theorem leafRelabel_square (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W)
  (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).map (inputBlockRelabelMap (coefficientEmbedding O P Q
      R).hom.equiv (leafIdentity O B
      P Q R)) ≫
      (Grouping.atomicLeafIso (coefficientGrouping O P Q R) (atomicLeaves O B P Q R)).hom ≫
        (groupedLeavesIso O B P Q R).hom = (oldLeavesIso B Q R).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with | none => cases j | some i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j
    | some i =>
      let X := B ((R i).inputColor j)
      change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])

private theorem doubleCoefficientIdentity (X : C) (L : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 X ≫ 𝟙 X) (𝟙 L)) =
      𝟙 ((coefficientLeafTensorFunctor L).obj X) := by
  let T := FiniteTensor.tensor (V := C)
  exact (congrArg (fun f => T.map (coefficientLeafMap f (𝟙 L))) (Category.id_comp (𝟙 X))).trans
    ((congrArg T.map (coefficientLeafMap_idLeaves (𝟙 X) L)).trans
      ((congrArg T.map ((coefficientLeafFamilyFunctor L).map_id X)).trans (T.map_id _)))

/-- The original weighted source embedding is the actual original
coefficient embedding and complete original leaf identity map. -/
theorem weightedSource_relabel (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q :
  ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily O B P Q R)).inv ≫
      (FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso O B P Q R).hom ≫
      (Grouping.atomicWeightedIso (coefficientGrouping O P Q R) (atomicLeaves O B P Q R)).hom =
    (oldWeightedFrameIso O B P Q R).hom ≫
      weightedInputBlockRelabelMap (coefficientEmbedding O P Q R).hom.equiv
        (coefficientEmbedding O P Q R).hom.hom (leafIdentity O B P Q R) := by
  let T := FiniteTensor.tensor (V := C)
  let N := coefficientGrouping O P Q R
  let L := atomicLeaves O B P Q R
  let a := (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily O B P Q R)).inv
  let b := (FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso O B P Q R).hom
  let c := (Grouping.atomicWeightedIso N L).hom
  have hc : c = 𝟙 _ := WeightedNormalization.atomicWeightedIso_hom N L
  have h : a ≫ b = (oldWeightedFrameIso O B P Q R).hom ≫
      weightedInputBlockRelabelMap (coefficientEmbedding O P Q R).hom.equiv
        (coefficientEmbedding O P Q R).hom.hom (leafIdentity O B P Q R) := by
    apply FiniteFamily.Hom_ext
    · ext i
      cases i <;> rfl
    · intro i
      cases i with
      | none =>
        let X := O.obj (extendProfile P Q)
        let M := (FiniteFamily.empty : FiniteFamily C)
        let f := (emptyLeafTensorIso X).inv
        let g := T.map (coefficientLeafMap (𝟙 X ≫ 𝟙 X) (𝟙 M))
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ f) (f ≫ g)
        exact heq_of_eq (paddedInput f g (doubleCoefficientIdentity X M))
      | some j =>
        let X := O.obj (R j).toColoredProfile
        let M := profileLeafFamily B (R j).toColoredProfile
        let Y := (analyticSummand O B).obj (R j)
        let f := (profileCoefficientLeafTensorIso O B (R j).toColoredProfile).inv
        let g := T.map (coefficientLeafMap (𝟙 X ≫ 𝟙 X) (𝟙 M))
        change HEq ((𝟙 Y ≫ 𝟙 Y) ≫ f) (f ≫ g)
        exact heq_of_eq (paddedInput f g (doubleCoefficientIdentity X M))
  exact (Category.assoc a b c).symm.trans
    ((congrArg ((a ≫ b) ≫ ·) hc).trans ((Category.comp_id (a ≫ b)).trans h))


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension.AtomicNormalization

end
