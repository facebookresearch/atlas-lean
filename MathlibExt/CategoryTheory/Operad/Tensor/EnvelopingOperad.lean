/-!
# The original free-generator and nullary-linear cofan formula
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (c : W) : HasColimitsOfShape (AnalyticIndex W c) C :=
  hasProfileColimitsOfSmallColors C c

/-- The parent original constant generator is exactly its original
unary input cofan, through the actual original unit and nullary-linear comparisons. -/
theorem generator_cofan_formula (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    ((profileUnit O).app B c ≫ (nullaryLinearCoefficientIso O.toCollection B c).inv) =
      generatorInsertion O B c ≫ linearCoefficientι O.toCollection B
        (ColoredProfile.nullary c) (generatorInputs c)
        := by
  let e := nullaryLinearCoefficientIso O.toCollection B c
  let a := generatorInsertion O B c
  let i := linearCoefficientι O.toCollection B (ColoredProfile.nullary c) (generatorInputs c)
  let n := (nullaryLinearDiagramIso O.toCollection B c).hom.app (generatorInputs c)
  let j := profileι O.toCollection B (AnalyticIndex.unary (d := c) c)
  let eta := unitInsertion O B c
  have hi : i ≫ e.hom = n ≫ j := nullaryLinearCoefficientIso_ι O.toCollection B c
    (generatorInputs c)
  have ha : a ≫ n = eta := generatorInsertion_compare O B c
  have hr : (a ≫ i) ≫ e.hom = eta ≫ j := (Category.assoc a i e.hom).trans
    ((congrArg (a ≫ ·) hi).trans ((Category.assoc a n j).symm.trans (congrArg (· ≫ j) ha)))
  have hl : ((profileUnit O).app B c ≫ (nullaryLinearCoefficientIso O.toCollection B
    c).inv) ≫ e.hom = eta ≫ j :=
    (Category.assoc ((profileUnit O).app B c) e.inv e.hom).trans
      ((congrArg ((profileUnit O).app B c ≫ ·) e.inv_hom_id).trans (Category.comp_id
        ((profileUnit O).app B c)))
  exact (cancel_mono e.hom).1 (hl.trans hr.symm)


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

end
