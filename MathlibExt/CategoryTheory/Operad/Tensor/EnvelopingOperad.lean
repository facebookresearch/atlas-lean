/- Exact checked source: ReflexiveOperad.LinearAlgebraNullaryNormalization. -/
section EnvelopingSource348


/-!
# Original coefficient normalization with the original Fin-0 variable frame
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraNullary

open CategoryTheory

private theorem normUnitorFold {V : Type*} [Category* V] {X A B D H Y : V}
    (p : X ⟶ A) (c : A ⟶ B) (v : B ⟶ D) (s : D ⟶ Y)
    (r : X ⟶ H) (b : H ⟶ D) (m : A ⟶ D) (f : H ⟶ Y) (k : X ⟶ Y)
    (hc : c ≫ v = m) (hn : r ≫ b = p ≫ m) (hs : b ≫ s = f) (hr : r ≫ f = k) :
    (p ≫ c) ≫ (v ≫ s) = k := by
  have h1 : (p ≫ c) ≫ (v ≫ s) = p ≫ m ≫ s := by
    simpa only [Category.assoc] using congrArg (fun z => p ≫ z ≫ s) hc
  have h2 : p ≫ m ≫ s = r ≫ b ≫ s := by
    simpa only [Category.assoc] using congrArg (· ≫ s) hn.symm
  exact h1.trans (h2.trans ((congrArg (r ≫ ·) hs).trans hr))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- Original raw nil-leaf block comparison followed by original
singleton block flattening is the actual original coefficient-family bijection. -/
theorem nilBlocks_flatten (K : FiniteFamily C) (A : W → C) (d : W) :
    (FiniteFamily.flatten (C := C)).map (nilBlocksIso K A d).hom ≫
      FiniteFamily.singletonFlattenIso.hom.app K =
      (nilCoefficientFlattenIso K A d).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro p
    rcases p with ⟨i, j⟩
    cases i with | none => rfl | some i => exact Fin.elim0 i
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
      | none => exact heq_of_eq (Category.id_comp (𝟙 (K.obj j)))
      | some i => exact Fin.elim0 i

/-- The original coefficient collapse and original Fin-0 leaf factor
map give the original tensor map of the original nil-block identity comparison. -/
theorem nilCollapse_blocks (K : FiniteFamily C) (A : W → C) (d : W) :
    coefficientLeavesCollapse K (profileLeafFamily A (ColoredProfile.nullary d)) ≫
      (nilLeafFactorsIso A d ((FiniteTensor.tensor (V := C)).obj K)).hom =
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (nilBlocksIso K A d).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
        let T := FiniteTensor.tensor (V := C)
        change HEq (𝟙 (T.obj K) ≫ 𝟙 (T.obj K)) (T.map (𝟙 K))
        exact heq_of_eq ((Category.id_comp (𝟙 (T.obj K))).trans (T.map_id K).symm)
    | some i => exact Fin.elim0 i

/-- Original finite tensor flattening and singleton laws identify the
whole actual nil-leaf normalizer with its original coefficient-family bijection. -/
theorem nilNormalization_unitor (K : FiniteFamily C) (A : W → C) (d : W) :
    (coefficientLeavesNormalizationIso K (profileLeafFamily A (ColoredProfile.nullary d))).hom ≫
      (nilLeafUnitor A d ((FiniteTensor.tensor (V := C)).obj K)).hom =
    (FiniteTensor.tensor (V := C)).map (nilCoefficientFlattenIso K A d).hom := by
  let T := FiniteTensor.tensor (V := C)
  let L := profileLeafFamily A (ColoredProfile.nullary d)
  let N := coefficientLeavesNested K L
  let p := (FiniteTensor.flattenIso (V := C)).hom.app N
  let c := T.map (coefficientLeavesCollapse K L)
  let v := T.map (nilLeafFactorsIso A d (T.obj K)).hom
  let s := (FiniteTensor.singletonIso (V := C)).hom.app (T.obj K)
  let r := T.map ((FiniteFamily.flatten (C := C)).map (nilBlocksIso K A d).hom)
  let b := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.singleton (C :=
    FiniteFamily C)).obj K)
  let m := T.map ((FiniteFamily.map T).map (nilBlocksIso K A d).hom)
  let f := T.map (FiniteFamily.singletonFlattenIso.hom.app K)
  let k := T.map (nilCoefficientFlattenIso K A d).hom
  have hc : c ≫ v = m := (T.map_comp _ _).symm.trans (congrArg T.map (nilCollapse_blocks K A d))
  have hn : r ≫ b = p ≫ m := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (nilBlocksIso K A d).hom
  have hs : b ≫ s = f := (singletonFlattenLaw_app K).symm
  have hr : r ≫ f = k := (T.map_comp _ _).symm.trans (congrArg T.map (nilBlocks_flatten K A d))
  exact (congrArg (· ≫ (v ≫ s)) (coefficientLeavesNormalizationIso_hom K L)).trans
    (normUnitorFold p c v s r b m f k hc hn hs hr)

/-- The inverse original coefficient normalizer and inverse original
empty-leaf unitor are precisely the inverse original raw coefficient-family map. -/
theorem nilNormalization_inverse (K : FiniteFamily C) (A : W → C) (d : W) :
    (nilLeafUnitor A d ((FiniteTensor.tensor (V := C)).obj K)).inv ≫
      (coefficientLeavesNormalizationIso K (profileLeafFamily A (ColoredProfile.nullary d))).inv =
    (FiniteTensor.tensor (V := C)).map (nilCoefficientFlattenIso K A d).inv := by
  let n := coefficientLeavesNormalizationIso K (profileLeafFamily A (ColoredProfile.nullary d))
  let u := nilLeafUnitor A d ((FiniteTensor.tensor (V := C)).obj K)
  let f := (FiniteTensor.tensor (V := C)).mapIso (nilCoefficientFlattenIso K A d)
  have h : (n ≪≫ u).hom = f.hom := nilNormalization_unitor K A d
  exact congrArg Iso.inv (Iso.ext h)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraNullary

end
end EnvelopingSource348

/- Exact checked source: ReflexiveOperad.LinearAlgebraNullaryEvaluation. -/
section EnvelopingSource349


/-!
# Original free-profile evaluation on the actual empty-variable representative
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraNullary

open CategoryTheory

private theorem mapFour {V U : Type*} [Category* V] [Category* U]
    (T : V ⥤ U) {X Y Z D E : V} (a : X ⟶ Y) (b : Y ⟶ Z) (c : Z ⟶ D) (d : D ⟶ E) :
    T.map (a ≫ b ≫ c ≫ d) = T.map a ≫ T.map b ≫ T.map c ≫ T.map d := by
  rw [T.map_comp, T.map_comp, T.map_comp]

private theorem evaluationFold {V : Type*} [Category* V] {X A B D E F Y : V}
    (a : X ⟶ A) (u : A ⟶ B) (ev : B ⟶ Y) (z : A ⟶ D) (r : D ⟶ E) (o : E ⟶ Y)
    (p : E ⟶ F) (o' : F ⟶ Y) (c : X ⟶ F)
    (he : u ≫ ev = z ≫ r ≫ o) (ho : p ≫ o' = o) (hc : a ≫ z ≫ r ≫ p = c) :
    a ≫ u ≫ ev = c ≫ o' := by
  have h1 : a ≫ u ≫ ev = a ≫ z ≫ r ≫ o := congrArg (a ≫ ·) he
  have h2 : a ≫ z ≫ r ≫ o = a ≫ z ≫ r ≫ p ≫ o' := congrArg (a ≫ z ≫ r ≫ ·) ho.symm
  have h3 : a ≫ z ≫ r ≫ p ≫ o' = c ≫ o' := by
    simpa only [Category.assoc] using congrArg (· ≫ o') hc
  exact h1.trans (h2.trans h3)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original empty-variable coefficient, inverse normalization,
constant map and original empty-sum profile permutation retain exactly
the original free-profile coefficient and original g input components. -/
theorem nilRepresentative_factors (O : ColoredOperadObj W C) (B : W → C) (M : Algebra O)
    (g : B ⟶ M.carrier) (d : W) (Q : ColoredInputs W) :
    (nullaryLinearFactorsIso O.toCollection B d).inv.app Q ≫
      (nilCoefficientFlattenIso
        ((coefficientInputFactors (extendedCoefficient O.toCollection
          (ColoredProfile.nullary d)) (addedAlgebraInputs
          B)).obj Q)
        M.carrier d).inv ≫
      LinearAlgebra.representativeFactors O.toCollection B M.carrier g
        (ColoredProfile.nullary d) Q ≫
        (operationFactorsFunctor O.toCollection M.carrier).map (nullaryVariableProfileHom d Q) =
    (analyticFactorsCarrierMap O.toCollection g).app ((inputsToProfile d).obj Q) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
        let e := O.toCollection.mapIso (nullaryVariableProfileComponentIso d Q)
        let X := O.toCollection.obj ((inputsToProfile d).obj Q).toColoredProfile
        let Y := O.toCollection.obj (extendProfile (ColoredProfile.nullary d) Q)
        change HEq ((𝟙 X ≫ e.inv) ≫ 𝟙 Y ≫ 𝟙 Y ≫ e.hom) (𝟙 X)
        have h1 : 𝟙 Y ≫ 𝟙 Y ≫ e.hom = e.hom := (Category.id_comp (𝟙 Y ≫
          e.hom)).trans (Category.id_comp e.hom)
        exact heq_of_eq ((congrArg ((𝟙 X ≫ e.inv) ≫ ·) h1).trans
          ((Category.assoc (𝟙 X) e.inv e.hom).trans
            ((congrArg (𝟙 X ≫ ·) e.inv_hom_id).trans (Category.id_comp (𝟙 X)))))
    | some i =>
        let X := B (Q.obj i).as
        let Y := M.carrier (Q.obj i).as
        let f := g (Q.obj i).as
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ f ≫ 𝟙 Y) f
        exact heq_of_eq ((congrArg (fun z : X ⟶ X => z ≫ 𝟙 X ≫ f ≫
          𝟙 Y) (Category.id_comp (𝟙 X))).trans
          ((Category.id_comp (𝟙 X ≫ f ≫ 𝟙 Y)).trans ((Category.id_comp (f ≫
            𝟙 Y)).trans (Category.comp_id f))))

/-- The original inverse empty-variable unitor and representative
normalizer retain precisely the original coefficient-family inverse. -/
theorem nilRepresentative_unitor (O : ColoredOperadObj W C) (B : W → C) (M : Algebra O)
    (g : B ⟶ M.carrier) (d : W) (Q : ColoredInputs W) :
    (nilLeafUnitor M.carrier d ((linearCoefficientDiagram O.toCollection B
      (ColoredProfile.nullary d)).obj Q)).inv ≫
      LinearAlgebra.representativeEvaluation O B M g (ColoredProfile.nullary d) Q =
    (FiniteTensor.tensor (V := C)).map
      (nilCoefficientFlattenIso
        ((coefficientInputFactors (extendedCoefficient O.toCollection
          (ColoredProfile.nullary d)) (addedAlgebraInputs
          B)).obj Q)
        M.carrier d).inv ≫
      (FiniteTensor.tensor (V := C)).map (LinearAlgebra.representativeFactors O.toCollection
        B M.carrier g
        (ColoredProfile.nullary d) Q) ≫
        M.operations.app d (profileInputs (extendProfile (ColoredProfile.nullary d) Q)) := by
  let K := ((coefficientInputFactors (extendedCoefficient O.toCollection
    (ColoredProfile.nullary d)) (addedAlgebraInputs
    B)).obj Q)
  let n := coefficientLeavesNormalizationIso K (profileLeafFamily M.carrier
    (ColoredProfile.nullary d))
  let u := (nilLeafUnitor M.carrier d ((FiniteTensor.tensor (V := C)).obj K)).inv
  let r := (FiniteTensor.tensor (V := C)).map (LinearAlgebra.representativeFactors
    O.toCollection B M.carrier g
    (ColoredProfile.nullary d) Q)
  let o := M.operations.app d (profileInputs (extendProfile (ColoredProfile.nullary d) Q))
  exact (Category.assoc u n.inv (r ≫ o)).symm.trans
    (congrArg (· ≫ r ≫ o) (nilNormalization_inverse K M.carrier d))

/-- Every original empty-variable coefficient representative evaluates
as its original O free-profile operation with the actual original g inputs. -/
theorem representative_nullary (O : ColoredOperadObj W C) (B : W → C) (M : Algebra O)
    (g : B ⟶ M.carrier) (d : W) (Q : ColoredInputs W) :
    (nullaryLinearDiagramIso O.toCollection B d).inv.app Q ≫
      (nilLeafUnitor M.carrier d ((linearCoefficientDiagram O.toCollection B
        (ColoredProfile.nullary d)).obj Q)).inv ≫
      LinearAlgebra.representativeEvaluation O B M g (ColoredProfile.nullary d) Q =
    (analyticSummandCarrierMap O.toCollection g).app ((inputsToProfile d).obj Q) ≫
      M.operations.app d ((inputsToProfile d).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  let K := ((coefficientInputFactors (extendedCoefficient O.toCollection
    (ColoredProfile.nullary d)) (addedAlgebraInputs
    B)).obj Q)
  let a := (nullaryLinearDiagramIso O.toCollection B d).inv.app Q
  let u := (nilLeafUnitor M.carrier d (T.obj K)).inv
  let ev := LinearAlgebra.representativeEvaluation O B M g (ColoredProfile.nullary d) Q
  let z := T.map (nilCoefficientFlattenIso K M.carrier d).inv
  let r := T.map (LinearAlgebra.representativeFactors O.toCollection B M.carrier g
    (ColoredProfile.nullary d) Q)
  let o := M.operations.app d (profileInputs (extendProfile (ColoredProfile.nullary d) Q))
  let p := (operationSummandFunctor O.toCollection M.carrier).map (nullaryVariableProfileHom d Q)
  let o' := M.operations.app d ((inputsToProfile d).obj Q)
  let c := (analyticSummandCarrierMap O.toCollection g).app ((inputsToProfile d).obj Q)
  have he : u ≫ ev = z ≫ r ≫ o := nilRepresentative_unitor O B M g d Q
  have ho : p ≫ o' = o := (M.operations.profile_equivariance (nullaryVariableProfileHom d
    Q)).trans (Category.comp_id _)
  have hc : a ≫ z ≫ r ≫ p = c := (mapFour T _ _ _ _).symm.trans
    (congrArg T.map (nilRepresentative_factors O B M g d Q))
  exact evaluationFold a u ev z r o p o' c he ho hc


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraNullary

end
end EnvelopingSource349

/- Exact checked source: ReflexiveOperad.ConstantsGeneratorData. -/
section EnvelopingSource350


/-!
# The original constant generator, its original unary cofan, and its original nullary shape
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants

open CategoryTheory Limits

variable {W : Type u}

/-- The original one-input constant family at its original color. -/
def generatorInputs (c : W) : ColoredInputs W where
  index := FintypeCat.of PUnit
  obj _ := Discrete.mk c

/-- The actual one-input family is the original unary analytic profile. -/
theorem generatorInputs_profile (c : W) :
    (inputsToProfile c).obj (generatorInputs c) = AnalyticIndex.unary (d := c) c := rfl

/-- The original empty-variable profile comparison and its actual inverse. -/
abbrev generatorProfileIso (c : W) :
    extendProfile (ColoredProfile.nullary c) (generatorInputs c) ≅
      ColoredSubstitutionData.unitProfile c :=
  nullaryVariableProfileComponentIso c (generatorInputs c)

/-- The actual original all-nullary one-constant frozen shape maps to
the original left-unit shape at the original nullary coefficient. -/
def generatorShapeMap (c : W) :
    frozenSubstitution (ColoredProfile.nullary c) (generatorInputs c) (branches
      (generatorInputs c)) ⟶
      ColoredSubstitutionData.leftUnit (ColoredProfile.nullary c) where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.emptySum (Fin 0) PUnit
      hom i := match i with
        | Sum.inl i => Fin.elim0 i
        | Sum.inr _ => 𝟙 (ColoredProfile.nullary c) }

/-- The original root comparison is the original empty-sum profile map
followed by the original left-unit outer-profile map. -/
theorem generatorShapeMap_outer (c : W) :
    frozenOuterProfileHom (ColoredProfile.nullary c) (generatorInputs c) (branches
      (generatorInputs c)) ≫
      ColoredSubstitutionData.outerProfileMap (generatorShapeMap c) =
    (generatorProfileIso c).hom ≫ ColoredSubstitutionData.leftUnitOuterHom
      (ColoredProfile.nullary c) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl i => exact Fin.elim0 i
  | inr _ => rfl

