/- Exact checked source: WeightedNormalization.LinearAssocColimit. -/
section EnvelopingSource197


/-!
# The actual joint coefficient tensor colimit for linear associativity

Every original root, middle, and inner coefficient has its own original
added-input diagram. Separate finite tensor-slot preservation gives their
joint colimit on the exact original associativity source.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The literal original coefficient index of the actual linear
operadic associativity source. -/
def assocIndex (O : ColoredSymmetricCollection W C) (B : W → C) (d : ColoredAssocData W) :
    FintypeCat.{0} :=
  (ColoredOperadObj.AssocInsertion.flattenedGroupingA (linearCoefficientCollection O B) d).index

/-- The original variable profile at each original root, middle,
or inner operation position. -/
def assocSlotProfile (O : ColoredSymmetricCollection W C) (B : W → C) (d : ColoredAssocData W) :
    assocIndex O B d → ColoredProfile W
  | ⟨none, _⟩ => d.middleData.outerProfile
  | ⟨some i, j⟩ => envelopingSlotProfile (d.localData i) j

/-- Original flat input choices give the original nested root and
branch choices, without changing any supplied added-input family. -/
def assocChoices (O : ColoredSymmetricCollection W C) (B : W → C) (d : ColoredAssocData W)
    (Q : assocIndex O B d → ColoredInputs W) : EnvelopingAssocChoices d where
  root := Q ⟨none, PUnit.unit⟩
  branch i j := Q ⟨some i, j⟩

/-- Each original association coefficient has its actual original
linear added-input diagram. -/
def assocSlotDiagram (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (p : assocIndex O B d) : ColoredInputs W ⥤ C :=
  linearCoefficientDiagram O B (assocSlotProfile O B d p)

/-- The genuine finite joint tensor diagram of all original
root, middle, and inner linear coefficients. -/
def assocTensorDiagram (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) : (assocIndex O B d → ColoredInputs W) ⥤ C :=
  FiniteMultifunctor.finiteIndexDiagram (fixedIndexTensorFunctor (assocIndex O B d))
    (assocSlotDiagram O B d)

/-- Each original slot retains its actual chosen input-colimit cocone. -/
def assocSlotCocone (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (p : assocIndex O B d) : Cocone (assocSlotDiagram O B d p) := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits d.outputColor
  exact colimit.cocone (assocSlotDiagram O B d p)

/-- These are actual original slot colimits. -/
def assocSlotIsColimit (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (p : assocIndex O B d) : IsColimit (assocSlotCocone O B d p) := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits d.outputColor
  exact colimit.isColimit (assocSlotDiagram O B d p)

/-- The original joint tensor cocone, with every original coefficient
colimit and original flat coefficient position retained. -/
def assocTensorCocone (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) : Cocone (assocTensorDiagram O B d) :=
  FiniteMultifunctor.finiteIndexCocone (fixedIndexTensorFunctor (assocIndex O B d))
    (assocSlotCocone O B d)

/-- The actual joint tensor-cocone coefficient family is the original
root/middle/inner linear coefficient family, by identities at all positions. -/
def assocPointFamilyIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) :
    (FiniteFamily.fixedIndexFunctor (C := C) (assocIndex O B d)).obj
        (fun p => (assocSlotCocone O B d p).pt) ≅
      ColoredOperadObj.AssocInsertion.flattenedGroupingA (linearCoefficientCollection O B) d :=
  FiniteFamily.isoOfComponents (Equiv.refl (assocIndex O B d)) (fun p => by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; exact Iso.refl _
    | some i => cases j <;> exact Iso.refl _)

/-- The joint tensor-cocone point is the exact original associativity
source of the actual linear coefficient collection. -/
def assocTensorPointIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) : (assocTensorCocone O B d).pt ≅
      ColoredOperadObj.associativityCommonSource (linearCoefficientCollection O B) d :=
  (FiniteTensor.tensor (V := C)).mapIso (assocPointFamilyIso O B d)

/-- Each joint source object retains precisely the original weighted
root/middle/inner coefficient/input factors and original nested choices. -/
def assocWeightedFamilyIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O B d → ColoredInputs W) :
    (FiniteFamily.fixedIndexFunctor (C := C) (assocIndex O B d)).obj
        (fun p => (assocSlotDiagram O B d p).obj (Q p)) ≅
      envelopingAssocWeightedFamily O B d (assocChoices O B d Q) :=
  FiniteFamily.isoOfComponents
    (Equiv.sigmaCongrRight (fun i : Option d.branches.index => by
      cases i <;> exact Equiv.refl _)) (fun p => by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j; exact Iso.refl _
        | some i => cases j <;> exact Iso.refl _)

/-- The original joint coefficient cofan keeps every supplied input
family and original root/middle/inner coefficient colimit injection. -/
def assocCofanFamilyMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O B d → ColoredInputs W) :
    (FiniteFamily.fixedIndexFunctor (C := C) (assocIndex O B d)).obj
        (fun p => (assocSlotDiagram O B d p).obj (Q p)) ⟶
      ColoredOperadObj.AssocInsertion.flattenedGroupingA (linearCoefficientCollection O B) d where
  equiv := Equiv.refl (assocIndex O B d)
  hom p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; exact linearCoefficientι O B d.middleData.outerProfile (Q ⟨none, PUnit.unit⟩)
    | some i =>
      cases j with
      | none => exact linearCoefficientι O B (d.localData i).outerProfile (Q ⟨some i, none⟩)
      | some j => exact linearCoefficientι O B ((d.localData i).inner.obj j) (Q ⟨some i, some j⟩)

/-- The actual joint coefficient tensor-colimit leg into the exact
original linear associativity source. -/
def assocInjection (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O B d → ColoredInputs W) :
    (assocTensorDiagram O B d).obj Q ⟶
      ColoredOperadObj.associativityCommonSource (linearCoefficientCollection O B) d :=
  (assocTensorCocone O B d).ι.app Q ≫ (assocTensorPointIso O B d).hom

/-- The original joint source injection is the finite tensor of the
actual original coefficient injections at every original position. -/
theorem assocInjection_readback (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O B d → ColoredInputs W) :
    assocInjection O B d Q = (FiniteTensor.tensor (V := C)).map (assocCofanFamilyMap O B d Q) := by
  let T := FiniteTensor.tensor (V := C)
  have h : (FiniteFamily.fixedIndexFunctor (C := C) (assocIndex O B d)).map
      (fun p => (assocSlotCocone O B d p).ι.app (Q p)) ≫ (assocPointFamilyIso O B d).hom =
      assocCofanFamilyMap O B d Q := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro p
      rcases p with ⟨i, j⟩
      cases i with
      | none => cases j; exact heq_of_eq (Category.comp_id _)
      | some i => cases j <;> exact heq_of_eq (Category.comp_id _)
  exact (T.map_comp _ _).symm.trans (congrArg T.map h)

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Separate original finite tensor-slot preservation constructs the
whole actual root/middle/inner coefficient colimit, at all finite profiles. -/
def assocTensorIsColimit (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) : IsColimit (assocTensorCocone O B d) := by
  let : DecidableEq (assocIndex O B d) := Classical.decEq _
  exact @FiniteMultifunctor.isColimitFiniteIndexCocone.{0, u, max 1 u, v, w, v, w, us}
    (assocIndex O B d) C _ C _ inferInstance (Classical.decEq _)
    (fun _ => ColoredInputs W) (fun _ => inferInstance)
    (fun _ => coloredInputsEssentiallySmall d.outputColor)
    (fixedIndexTensorFunctor (assocIndex O B d))
    (FiniteTensorPreservesColimitsInEachSlot.preserves (C := C) (assocIndex O B d))
    (assocSlotDiagram O B d) (assocSlotCocone O B d) (assocSlotIsColimit O B d)

/-- Actual joint coefficient colimit legs detect whole morphisms on
the exact original linear operadic associativity source. -/
theorem assoc_hom_ext (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) {Y : C}
    {f g : ColoredOperadObj.associativityCommonSource (linearCoefficientCollection O B) d ⟶ Y}
    (h : ∀ Q : assocIndex O B d → ColoredInputs W,
      assocInjection O B d Q ≫ f = assocInjection O B d Q ≫ g) : f = g := by
  have hp : (assocTensorPointIso O B d).hom ≫ f = (assocTensorPointIso O B d).hom ≫ g :=
    (assocTensorIsColimit O B d).hom_ext (by
      intro Q
      exact (Category.assoc _ _ _).symm.trans ((h Q).trans (Category.assoc _ _ _)))
  exact (cancel_epi (assocTensorPointIso O B d).hom).1 hp


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
end EnvelopingSource197

/- Exact checked source: WeightedNormalization.LinearAssocCofans. -/
section EnvelopingSource198


/-!
# Original coefficient cofans in the two linear association groupings
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Every original weighted representative factor maps to its actual
linear coefficient colimit leg, through the original slot comparison. -/
def representativeCofanMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingWeightedRepresentativeFamily O B s Q ⟶
      (ColoredOperadObj.substitutionFactors (linearCoefficientCollection O B)).obj s :=
  (envelopingLinearWeightedFamilyIso O B s Q).inv ≫ envelopingLinearCofanFamilyMap O B s Q

/-- The original slot comparison is the identity on its literal
weighted objects and indices, so its inverse retains exactly the original cofan. -/
theorem representativeCofanMap_eq (O : ColoredSymmetricCollection W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    representativeCofanMap O B s Q = envelopingLinearCofanFamilyMap O B s Q := by
  let e := envelopingLinearWeightedFamilyIso O B s Q
  have hh : e.hom = 𝟙 _ := rfl
  have hi : e.inv = 𝟙 _ := (Category.comp_id e.inv).symm.trans
    ((congrArg (e.inv ≫ ·) hh.symm).trans e.inv_hom_id)
  exact (congrArg (· ≫ envelopingLinearCofanFamilyMap O B s Q) hi).trans (Category.id_comp _)

/-- The original branch-first block cofan uses the original root
colimit injection and the original local coefficient cofans. -/
def groupedCofanMapA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedBlocks O B d Q ⟶
      ColoredOperadObj.AssocInsertion.groupingA (linearCoefficientCollection O B) d where
  equiv := Equiv.refl (Option d.branches.index)
  hom i := match i with
    | none => (FiniteFamily.singleton (C := C)).map
        (linearCoefficientι O B d.middleData.outerProfile Q.root)
    | some i => representativeCofanMap O B (d.localData i) (Q.branch i)

/-- The original root-first block cofan uses the original middle
coefficient cofan and each original innermost colimit injection. -/
def groupedCofanMapB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocWeightedRootFirstBlocks O B d Q ⟶
      ColoredOperadObj.AssocInsertion.groupingB (linearCoefficientCollection O B) d where
  equiv := Equiv.refl (Option d.middleData.totalProfile.inputs)
  hom i := match i with
    | none => representativeCofanMap O B d.middleData (envelopingAssocMiddleChoices d Q)
    | some p => (FiniteFamily.singleton (C := C)).map
        (linearCoefficientι O B (d.innerData.inner.obj p) (Q.branch p.1 (some p.2)))

/-- The original joint flat cofan is exactly the flattening of the
original branch-first weighted cofan after its original slot comparison. -/
theorem assocCofanFamilyMap_grouped (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O B d → ColoredInputs W) :
    (assocWeightedFamilyIso O B d Q).hom ≫
      (FiniteFamily.flatten (C := C)).map (groupedCofanMapA O B d (assocChoices O B d Q)) =
      assocCofanFamilyMap O B d Q := by
  simp only [groupedCofanMapA, representativeCofanMap_eq]
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; exact heq_of_eq (Category.id_comp _)
    | some i => cases j <;> exact heq_of_eq (Category.id_comp _)

/-- The actual original linear coefficient cofans commute with the
original weighted root-first permutation and the original linear
association permutation, at every root, middle, and inner position. -/
theorem groupedCofanMap_relabel (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).map (groupedCofanMapA O B d Q) ≫
      ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom (linearCoefficientCollection O B) d =
    (envelopingAssocWeightedRootFirstIso O B d Q).hom ≫
      (FiniteFamily.flatten (C := C)).map (groupedCofanMapB O B d Q) := by
  simp only [groupedCofanMapA, groupedCofanMapB, representativeCofanMap_eq]
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      cases j with
      | none =>
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
      | some j =>
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual original linear substitution evaluates the tensor
of original weighted representative cofan legs by the original
representative substitution and its actual total coefficient injection. -/
theorem representativeCofanMap_β (O : ColoredOperadObj W C) (B : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (representativeCofanMap O.toCollection B s Q) ≫
        envelopingLinearSubstitution O B s = envelopingRepresentativeColimitEvaluation O B s Q := by
  let T := FiniteTensor.tensor (V := C)
  let e := T.mapIso (envelopingLinearWeightedFamilyIso O.toCollection B s Q)
  let i := T.map (envelopingLinearCofanFamilyMap O.toCollection B s Q)
  let b := envelopingLinearSubstitution O B s
  let r := envelopingRepresentativeColimitEvaluation O B s Q
  have hb : i ≫ b = e.hom ≫ r :=
    (congrArg (· ≫ b) (envelopingLinearSubstitutionInjection_readback O.toCollection B s
      Q)).symm.trans
      (envelopingLinearSubstitution_β O B s Q)
  have hm : T.map (representativeCofanMap O.toCollection B s Q) = e.inv ≫ i := T.map_comp _ _
  exact (congrArg (· ≫ b) hm).trans
    ((Category.assoc e.inv i b).trans
      ((congrArg (e.inv ≫ ·) hb).trans
        ((Category.assoc e.inv e.hom r).symm.trans
          ((congrArg (· ≫ r) e.inv_hom_id).trans (Category.id_comp r)))))


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
