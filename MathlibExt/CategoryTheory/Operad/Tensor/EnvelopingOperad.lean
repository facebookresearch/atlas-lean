  let a := (FiniteTensor.flattenIso (V := C)).inv.app ((FiniteFamily.flatten (C :=
    FiniteFamily C)).obj R)
  let b := (FiniteTensor.flattenIso (V := C)).inv.app (combinedInputBlocks K.index K.obj L)
  let c := coefficientLeavesNormalization K (totalBlockInputs K.index L)
  let d := coefficientLeavesNormalization K (groupedCoefficientInputLeaves N L)
