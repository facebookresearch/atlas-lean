/- Exact checked source: EnvelopingShapeColimitNaturality. -/
section EnvelopingSource201


/-!
# Full original shape transport of representative coefficient colimit maps
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem originalShapeColimitSquare {V : Type*} [Category* V]
    {X X' Y Y' Z Z' : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (i : Y ⟶ Z) (i' : Y' ⟶ Z') (h : Z ⟶ Z')
    (ha : k ≫ a' = a ≫ f) (hi : f ≫ i' = i ≫ h) :
    k ≫ (a' ≫ i') = (a ≫ i) ≫ h := by
  rw [← Category.assoc k a', ha, Category.assoc a f, hi, Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable {s t : ColoredSubstitutionData W}

/-- Actual representative substitutions retain the full original
shape/output equality and every independent root/branch input map
after the original total-profile colimit descent. -/
theorem envelopingShapeRepresentativeColimitEvaluation_naturality (O : ColoredOperadObj W C)
  (A : W → C)
    (f : s ⟶ t) {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingShapeWeightedRepresentativeMap
      O.toCollection A f g) ≫
        envelopingRepresentativeColimitEvaluation O A t Q' =
      envelopingRepresentativeColimitEvaluation O A s Q ≫
        linearCoefficientMap O.toCollection A (ColoredSubstitutionData.totalProfileMap f) :=
  originalShapeColimitSquare
    ((FiniteTensor.tensor (V := C)).map (envelopingShapeWeightedRepresentativeMap
      O.toCollection A f g))
    (envelopingRepresentativeEvaluation O A s Q) (envelopingRepresentativeEvaluation O A t Q')
    ((FiniteTensor.tensor (V := C)).map (coefficientLeafMap
      (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.totalProfileMap f)
        (envelopingShapeTotalAlgebraInputsMap f g)))
      ((addedAlgebraInputs A).map (envelopingShapeTotalAlgebraInputsMap f g))))
    (linearCoefficientι O.toCollection A s.totalProfile (envelopingTotalAlgebraInputs s Q))
    (linearCoefficientι O.toCollection A t.totalProfile (envelopingTotalAlgebraInputs t Q'))
    (linearCoefficientMap O.toCollection A (ColoredSubstitutionData.totalProfileMap f))
    (envelopingShapeRepresentativeEvaluation_naturality O A f g)
    (linearCoefficientι_joint O.toCollection A (ColoredSubstitutionData.totalProfileMap f)
      (envelopingShapeTotalAlgebraInputsMap f g))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource201

/- Exact checked source: EnvelopingLinearSubstitutionNaturality. -/
section EnvelopingSource202


/-!
# The actual linear coefficient substitution is a genuine natural operation
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable {s t : ColoredSubstitutionData W}

/-- Actual tensor source injection transport follows from the
whole original cofan-family square and source functor laws. -/
theorem envelopingShapeSubstitutionInjection_naturality (O : ColoredSymmetricCollection W C)
  (A : W → C)
    (f : s ⟶ t) {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingShapeLinearFamilyMap O A f g) ≫
        envelopingLinearSubstitutionInjection O A t Q' =
      envelopingLinearSubstitutionInjection O A s Q ≫
        (ColoredOperadObj.substitutionSource (linearCoefficientCollection O A)).map f := by
  let T := FiniteTensor.tensor (V := C)
  have h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (envelopingShapeCofanFamily_naturality O A f g)).trans (T.map_comp _ _))
  rw [envelopingLinearSubstitutionInjection_readback,
    envelopingLinearSubstitutionInjection_readback]
  exact h

private theorem originalShapeWholeSquare {V : Type*} [Category* V]
    {X X' S S' L L' Y Y' : V}
    (k : X ⟶ X') (i : X ⟶ S) (i' : X' ⟶ S') (f : S ⟶ S')
    (a : X ⟶ L) (a' : X' ⟶ L') (l : L ⟶ L')
    (b : S ⟶ Y) (b' : S' ⟶ Y') (g : Y ⟶ Y') (e : L ⟶ Y) (e' : L' ⟶ Y')
    (hi : k ≫ i' = i ≫ f) (ha : k ≫ a' = a ≫ l)
    (hb : i ≫ b = a ≫ e) (hb' : i' ≫ b' = a' ≫ e') (he : l ≫ e' = e ≫ g) :
    i ≫ (f ≫ b') = i ≫ (b ≫ g) := by
  rw [← Category.assoc i f, ← hi, Category.assoc k i', hb', ← Category.assoc k a', ha,
    Category.assoc a l, he, ← Category.assoc a e, ← hb, Category.assoc]

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual original coefficient substitution is natural in
every original substitution shape, root output equality and
branch permutation, proved by full original tensor-colimit extensionality. -/
theorem envelopingLinearSubstitution_naturality (O : ColoredOperadObj W C) (A : W → C)
    (f : s ⟶ t) :
    (ColoredOperadObj.substitutionSource (linearCoefficientCollection O.toCollection A)).map f ≫
        envelopingLinearSubstitution O A t =
      envelopingLinearSubstitution O A s ≫
        linearCoefficientMap O.toCollection A (ColoredSubstitutionData.totalProfileMap f) := by
  apply envelopingLinearSubstitution_hom_ext O.toCollection A s
  intro Q
  let Q' := (envelopingShapeChoiceFunctor f).obj Q
  let g := envelopingShapeCanonicalChoiceArrow f Q
  let T := FiniteTensor.tensor (V := C)
  have hw : T.map (envelopingShapeLinearFamilyMap O.toCollection A f g) ≫
        T.map (envelopingLinearWeightedFamilyIso O.toCollection A t Q').hom =
      T.map (envelopingLinearWeightedFamilyIso O.toCollection A s Q).hom ≫
        T.map (envelopingShapeWeightedRepresentativeMap O.toCollection A f g) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (envelopingShapeLinearWeightedFamilyIso_naturality O.toCollection A f
        g)).trans (T.map_comp _ _))
  exact originalShapeWholeSquare
    (T.map (envelopingShapeLinearFamilyMap O.toCollection A f g))
    (envelopingLinearSubstitutionInjection O.toCollection A s Q)
    (envelopingLinearSubstitutionInjection O.toCollection A t Q')
    ((ColoredOperadObj.substitutionSource (linearCoefficientCollection O.toCollection A)).map f)
    (T.map (envelopingLinearWeightedFamilyIso O.toCollection A s Q).hom)
    (T.map (envelopingLinearWeightedFamilyIso O.toCollection A t Q').hom)
    (T.map (envelopingShapeWeightedRepresentativeMap O.toCollection A f g))
    (envelopingLinearSubstitution O A s) (envelopingLinearSubstitution O A t)
    (linearCoefficientMap O.toCollection A (ColoredSubstitutionData.totalProfileMap f))
    (envelopingRepresentativeColimitEvaluation O A s Q)
      (envelopingRepresentativeColimitEvaluation O A t Q')
    (envelopingShapeSubstitutionInjection_naturality O.toCollection A f g) hw
    (envelopingLinearSubstitution_β O A s Q) (envelopingLinearSubstitution_β O A t Q')
    (envelopingShapeRepresentativeColimitEvaluation_naturality O A f g)

/-- The actual linear coefficient maps are a genuine full
colored substitution natural transformation. Unit and associativity
laws are proved separately from this original naturality construction. -/
def envelopingLinearSubstitutionMap (O : ColoredOperadObj W C) (A : W → C) :
    ColoredOperadSubstitution (linearCoefficientCollection O.toCollection A) where
  app s := envelopingLinearSubstitution O A s
  naturality {_s _t} f := envelopingLinearSubstitution_naturality O A f


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource202

/- Exact checked source: WeightedNormalization.LinearAssocBeta. -/
section EnvelopingSource203


/-!
# Exact original linear association routes on all joint coefficient legs
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory Limits

private theorem composeAssocSquares {D : Type*} [Category* D]
    {X A B E F Y G H : D}
    (a : X ⟶ A) (r : A ⟶ B) (n : B ⟶ E) (t : E ⟶ F) (s : F ⟶ Y)
    (p : A ⟶ G) (l : G ⟶ E) (u : G ⟶ H) (k : H ⟶ F) (v : H ⟶ Y)
    (hn : r ≫ n = p ≫ l) (ht : l ≫ t = u ≫ k) (hs : k ≫ s = v) :
    (a ≫ r) ≫ n ≫ t ≫ s = a ≫ p ≫ u ≫ v := by
  simp only [Category.assoc]
  rw [← Category.assoc r n, hn]
  simp only [Category.assoc]
  rw [← Category.assoc l t, ht]
  simp only [Category.assoc]
  rw [hs]

private theorem finishAssocTail {D : Type*} [Category* D] {X A B E F Y : D}
    (a : X ⟶ A) (p : A ⟶ B) (u : B ⟶ E) (e : E ⟶ F) (i : F ⟶ Y) :
    a ≫ (p ≫ u ≫ e) ≫ i = a ≫ p ≫ u ≫ (e ≫ i) := by simp only [Category.assoc]

private theorem composeRootFirstSquares {D : Type*} [Category* D]
    {X A B E F G Y H K R S T U : D}
    (a : X ⟶ A) (r : A ⟶ B) (f : B ⟶ E) (n : E ⟶ F) (t : F ⟶ G)
    (s : G ⟶ Y) (z : Y ⟶ U) (g : A ⟶ H) (r' : H ⟶ E)
    (p : H ⟶ K) (l : K ⟶ F) (u : K ⟶ R) (k : R ⟶ G)
    (e : R ⟶ S) (j : S ⟶ T) (i : T ⟶ U)
    (hf : r ≫ f = g ≫ r') (hn : r' ≫ n = p ≫ l)
    (ht : l ≫ t = u ≫ k) (hs : k ≫ s ≫ z = e ≫ j ≫ i) :
    (a ≫ r) ≫ f ≫ n ≫ t ≫ s ≫ z = a ≫ (g ≫ p ≫ u ≫ e ≫ j) ≫ i := by
  simp only [Category.assoc]
  rw [← Category.assoc r f, hf]
  simp only [Category.assoc]
  rw [← Category.assoc r' n, hn]
  simp only [Category.assoc]
  rw [← Category.assoc l t, ht]
  simp only [Category.assoc]
  rw [hs]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The original branch-first linear block substitutions evaluate
the original weighted blocks and keep the original outer cofan legs. -/
theorem groupedCofanMapA_substitution (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (groupedCofanMapA O.toCollection B d Q) ≫
      ColoredOperadObj.AssocInsertion.groupingAToFactorsHom (linearCoefficientCollection
        O.toCollection B)
        (envelopingLinearSubstitutionMap O B) d =
    envelopingAssocWeightedContractionMapA O B d Q ≫
      representativeCofanMap O.toCollection B d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q) := by
  simp only [representativeCofanMap_eq]
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).hom.naturality
        (linearCoefficientι O.toCollection B d.middleData.outerProfile Q.root))
    | some i => exact heq_of_eq (representativeCofanMap_β O B (d.localData i) (Q.branch i))

/-- The original root-first linear block substitutions evaluate
the original middle and inner weighted factors, retaining the actual
middle input map and each original flat-inner cofan leg. -/
theorem groupedCofanMapB_substitution (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (groupedCofanMapB O.toCollection B d Q) ≫
      ColoredOperadObj.AssocInsertion.groupingBToFactorsHom (linearCoefficientCollection
        O.toCollection B)
        (envelopingLinearSubstitutionMap O B) d =
    envelopingAssocWeightedContractionMapB O B d Q ≫
      representativeCofanMap O.toCollection B d.innerData (envelopingAssocInnerChoices d Q) := by
  simp only [representativeCofanMap_eq]
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let q := envelopingAssocMiddleChoices d Q
      let a := envelopingRepresentativeEvaluation O B d.middleData q
      let b := (linearCoefficientDiagram O.toCollection B d.middleData.totalProfile).map
        (envelopingAssocMiddleAlgebraMap d Q)
      let c := linearCoefficientι O.toCollection B d.innerData.outerProfile
        (envelopingAssocInnerRootInputs d Q)
      have hl : b ≫ c = linearCoefficientι O.toCollection B d.middleData.totalProfile
          (envelopingTotalAlgebraInputs d.middleData q) :=
        linearCoefficient_relabel O.toCollection B d.middleData.totalProfile
          (envelopingAssocMiddleAlgebraMap d Q)
      have hr : envelopingAssocMiddleWeightedSubstitution O B d Q ≫ c =
          envelopingRepresentativeColimitEvaluation O B d.middleData q :=
        (Category.assoc a b c).trans (congrArg (a ≫ ·) hl)
      exact heq_of_eq ((representativeCofanMap_β O B d.middleData q).trans hr.symm)
    | some p => exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).hom.naturality
        (linearCoefficientι O.toCollection B (d.innerData.inner.obj p) (Q.branch p.1 (some p.2))))

/-- Every genuine joint coefficient source leg reads the original
linear inner-first route as the complete original weighted route A. -/
theorem assocRouteA_β (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O.toCollection B d → ColoredInputs W) :
    assocInjection O.toCollection B d Q ≫
        ColoredOperadObj.associativityRouteA (linearCoefficientCollection O.toCollection B)
          (envelopingLinearSubstitutionMap O B) d =
      (FiniteTensor.tensor (V := C)).map (assocWeightedFamilyIso O.toCollection B d Q).hom ≫
        envelopingAssocWeightedRepresentativeRouteA O B d (assocChoices O.toCollection B d Q) ≫
        linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
          (envelopingAssocTotalAlgebraInputs d (assocChoices O.toCollection B d Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let q := assocChoices O.toCollection B d Q
  let L := linearCoefficientCollection O.toCollection B
  let γ := envelopingLinearSubstitutionMap O B
  let a := T.map (assocWeightedFamilyIso O.toCollection B d Q).hom
  let r := T.map ((FiniteFamily.flatten (C := C)).map (groupedCofanMapA O.toCollection B d q))
  let n := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingA L d)
  let t := T.map (ColoredOperadObj.AssocInsertion.groupingAToFactorsHom L γ d)
  let s := envelopingLinearSubstitution O B d.outerAfterInnerData
  let p := (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocWeightedBlocks
    O.toCollection B d q)
  let l := T.map ((FiniteFamily.map T).map (groupedCofanMapA O.toCollection B d q))
  let u := T.map (envelopingAssocWeightedContractionMapA O B d q)
  let k := T.map (representativeCofanMap O.toCollection B d.outerAfterInnerData
    (envelopingAssocOuterChoices d q))
  let v := envelopingRepresentativeColimitEvaluation O B d.outerAfterInnerData
    (envelopingAssocOuterChoices d q)
  have hi : assocInjection O.toCollection B d Q = a ≫ r :=
    (assocInjection_readback O.toCollection B d Q).trans
      ((congrArg T.map (assocCofanFamilyMap_grouped O.toCollection B d Q).symm).trans
        (T.map_comp _ _))
  have hn : r ≫ n = p ≫ l :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality (groupedCofanMapA O.toCollection B d q)
  have ht : l ≫ t = u ≫ k := (T.map_comp _ _).symm.trans
    ((congrArg T.map (groupedCofanMapA_substitution O B d q)).trans (T.map_comp _ _))
  have hs : k ≫ s = v := representativeCofanMap_β O B d.outerAfterInnerData
    (envelopingAssocOuterChoices d q)
  have h := composeAssocSquares a r n t s p l u k v hn ht hs
  let e := envelopingRepresentativeEvaluation O B d.outerAfterInnerData
    (envelopingAssocOuterChoices d q)
  let j := linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
    (envelopingAssocTotalAlgebraInputs d
    q)
  have hr : a ≫ envelopingAssocWeightedRepresentativeRouteA O B d q ≫ j = a ≫ p ≫ u ≫ v :=
    finishAssocTail a p u e j
  exact (congrArg (· ≫ ColoredOperadObj.associativityRouteA L γ d) hi).trans
    (h.trans hr.symm)

/-- Every genuine joint coefficient source leg reads the original
linear root-first route as complete weighted route B, including its
original variable-profile and total algebra-input dependent-sum maps. -/
theorem assocRouteB_β (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : assocIndex O.toCollection B d → ColoredInputs W) :
    assocInjection O.toCollection B d Q ≫
        ColoredOperadObj.associativityRouteB (linearCoefficientCollection O.toCollection B)
          (envelopingLinearSubstitutionMap O B) d =
      (FiniteTensor.tensor (V := C)).map (assocWeightedFamilyIso O.toCollection B d Q).hom ≫
        envelopingAssocWeightedRepresentativeRouteB O B d (assocChoices O.toCollection B d Q) ≫
        linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
          (envelopingAssocTotalAlgebraInputs d (assocChoices O.toCollection B d Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let q := assocChoices O.toCollection B d Q
  let L := linearCoefficientCollection O.toCollection B
  let γ := envelopingLinearSubstitutionMap O B
  let a := T.map (assocWeightedFamilyIso O.toCollection B d Q).hom
  let r := T.map ((FiniteFamily.flatten (C := C)).map (groupedCofanMapA O.toCollection B d q))
  let f := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom L d)
  let n := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingB L d)
  let t := T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom L γ d)
  let s := envelopingLinearSubstitution O B d.innerData
  let z := L.map d.totalHom
  let g := T.map (envelopingAssocWeightedRootFirstIso O.toCollection B d q).hom
  let r' := T.map ((FiniteFamily.flatten (C := C)).map (groupedCofanMapB O.toCollection B d q))
  let p := (FiniteTensor.flattenIso (V := C)).hom.app
    (envelopingAssocWeightedRootFirstBlocks O.toCollection B d q)
  let l := T.map ((FiniteFamily.map T).map (groupedCofanMapB O.toCollection B d q))
  let u := T.map (envelopingAssocWeightedContractionMapB O B d q)
  let k := T.map (representativeCofanMap O.toCollection B d.innerData
    (envelopingAssocInnerChoices d q))
  let e := envelopingRepresentativeEvaluation O B d.innerData (envelopingAssocInnerChoices d q)
  let j := T.map (coefficientLeafMap
    (O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d q)))
    ((addedAlgebraInputs B).map (envelopingAssocFlatAlgebraInputsMap d q)))
  let i := linearCoefficientι O.toCollection B d.outerAfterInnerData.totalProfile
    (envelopingAssocTotalAlgebraInputs d
    q)
  have hi : assocInjection O.toCollection B d Q = a ≫ r :=
    (assocInjection_readback O.toCollection B d Q).trans
      ((congrArg T.map (assocCofanFamilyMap_grouped O.toCollection B d Q).symm).trans
        (T.map_comp _ _))
  have hf : r ≫ f = g ≫ r' := (T.map_comp _ _).symm.trans
    ((congrArg T.map (groupedCofanMap_relabel O.toCollection B d q)).trans (T.map_comp _ _))
  have hn : r' ≫ n = p ≫ l :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality (groupedCofanMapB O.toCollection B d q)
  have ht : l ≫ t = u ≫ k := (T.map_comp _ _).symm.trans
    ((congrArg T.map (groupedCofanMapB_substitution O B d q)).trans (T.map_comp _ _))
  have hβ := representativeCofanMap_β O B d.innerData (envelopingAssocInnerChoices d q)
  let c := linearCoefficientι O.toCollection B d.innerData.totalProfile
    (envelopingTotalAlgebraInputs d.innerData (envelopingAssocInnerChoices d q))
  have hj : j ≫ i = c ≫ z := linearCoefficientι_joint O.toCollection B d.totalHom
    (envelopingAssocFlatAlgebraInputsMap d q)
  have hs : k ≫ s ≫ z = e ≫ j ≫ i := (Category.assoc k s z).symm.trans
    ((congrArg (· ≫ z) hβ).trans
      ((Category.assoc e c z).trans (congrArg (e ≫ ·) hj.symm)))
  have h := composeRootFirstSquares a r f n t s z g r' p l u k e j i hf hn ht hs
  exact (congrArg (· ≫ ColoredOperadObj.associativityRouteB L γ d) hi).trans
    h


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
