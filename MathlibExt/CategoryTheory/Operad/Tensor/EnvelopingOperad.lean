/-- The actual original middle weighted substitution retains
the original coefficient tensor contraction and exact original
middle algebra leaf map under the source tensor normalization. -/
theorem envelopingAssocMiddleWeightedNormalization_evaluation (O : ColoredOperadObj W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocMiddleWeightedNormalizationIso O.toCollection B d Q).hom ≫
        (coefficientLeafTensorFunctor ((addedAlgebraInputs B).obj
          (envelopingAssocInnerRootInputs d Q))).map
