        (descendedOperations f g t hf hg A balance).app s.outputColor (profileInputs
          s.totalProfile) := by
  have := substitutionπ_epi f g t hf hg A.carrier s
  apply (cancel_epi (substitutionπ f g t hf hg A.carrier s)).1
  have hi := Restriction.substitutionInner (projection f g t hf hg)
    (descendedOperations f g t hf hg A balance) s
  rw [descendedOperations_restrict] at hi
  have hc := Restriction.substitutionInputs (projection f g t hf hg) A.carrier s
  exact hi.symm.trans
    ((A.substitution s).trans
      ((congrArg (operadSubstitutionInputs Q A.carrier s ≫ ·)
        (operationApp_beta f g t hf hg A balance s.outputColor (profileInputs
          s.totalProfile)).symm).trans
        ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ operationApp f g t hf hg A balance s.outputColor (profileInputs
            s.totalProfile))
            hc.symm).trans
            (Category.assoc _ _ _)))))

/-- The constructed full E-algebra keeps the exact original carrier. -/
def descendedAlgebra (A : Tensor.Algebra Q) (balance : Balanced f g A) : Tensor.Algebra
  (operad f g t hf hg) where
  carrier := A.carrier
  operations := descendedOperations f g t hf hg A balance
  unit := descended_unit f g t hf hg A balance
  substitution := descended_substitution f g t hf hg A balance

@[simp]
theorem descendedAlgebra_carrier (A : Tensor.Algebra Q) (balance : Balanced f g A) :
    (descendedAlgebra f g t hf hg A balance).carrier = A.carrier := rfl

/-- Every actual Q-algebra morphism between balanced objects descends,
with its whole original color-indexed carrier map unchanged. -/
def descendedHom {A B : Tensor.Algebra Q} (ha : Balanced f g A) (hb : Balanced f g B) (h : A ⟶ B) :
    descendedAlgebra f g t hf hg A ha ⟶ descendedAlgebra f g t hf hg B hb where
  hom := h.hom
  comm d q := by
    have := operationπ_epi f g t hf hg A.carrier q
    apply (cancel_epi (operationπ f g A.carrier q)).1
    have hm := congrArg (fun a => a.app q)
      (analyticSummandCollectionCarrier_mixed A.carrier (collectionπ f g) h.hom)
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ h.hom d) (operationApp_beta f g t hf hg A ha d q)).trans
        ((h.comm d q).trans
          ((congrArg ((analyticSummandCarrierMap Q.toCollection h.hom).app q ≫ ·)
            (operationApp_beta f g t hf hg B hb d q).symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ operationApp f g t hf hg B hb d q) hm.symm).trans
                (Category.assoc _ _ _))))))

@[simp]
theorem descendedHom_hom {A B : Tensor.Algebra Q} (ha : Balanced f g A) (hb : Balanced f g
  B) (h : A ⟶ B) :
    (descendedHom f g t hf hg ha hb h).hom = h.hom := rfl


