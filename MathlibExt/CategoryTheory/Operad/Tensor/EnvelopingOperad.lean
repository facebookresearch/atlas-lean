        (O.toCollection.obj (extendProfile d.middleData.outerProfile Q.root)) ≫
        O.toCollection.map (envelopingRepresentativeOuterHom d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q))
    | Sum.inr (some i) => envelopingRepresentativeCoefficientSubstitution O (d.localData i)
      (Q.branch i)

/-- The actual original two-unit tensor branch contractions
reduce to the original unary units; all original coefficient
branches retain their actual representative substitutions. -/
theorem envelopingAssocNestedInput_contraction (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedUnitInputMap O.toCollection d Q ≫
      envelopingAssocNestedContractionMap O d Q =
      envelopingAssocFrozenContractionMap O d Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro p
    cases p with
    | inl j => exact heq_of_eq (retainedRootUnitTensor_substitution O (Q.root.obj j).as)
    | inr i =>
      cases i with
      | none => exact heq_of_eq (Category.id_comp _)
      | some i => exact heq_of_eq (Category.id_comp _)

/-- The frozen root/inner contraction is exactly the original
representative coefficient unit insertion after the actual branch
coefficient contraction map and no other coefficient map. -/
theorem envelopingAssocFrozenContraction_factorization (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    Variable.unitFamilyMap (Equiv.refl Q.root.index) (envelopingAssocInnerContractionMap O d Q) ≫
        envelopingRepresentativeUnitMap O d.outerAfterInnerData (envelopingAssocOuterChoices d Q) =
      envelopingAssocFrozenContractionMap O d Q := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl p => rfl
    | inr i => cases i <;> rfl
