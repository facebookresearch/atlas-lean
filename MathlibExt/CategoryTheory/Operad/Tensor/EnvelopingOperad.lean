    | some _ => 𝟙 (E.toCollection.obj (ColoredProfile.nullary c))

/-- Original frozen root/constant maps and the original shape map are
exactly the original empty-prefix deletion and original left-unit coefficient map. -/
theorem generatorFrozenFactor_compare (E : ColoredOperadObj W C) (c : W) :
    frozenUnitCoefficientMap E (ColoredProfile.nullary c) (generatorInputs c) (branches
      (generatorInputs c)) ≫
      (ColoredOperadObj.substitutionFactors E.toCollection).map (generatorShapeMap c) =
    (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      (frozenCoefficientFamily E.toCollection (ColoredProfile.nullary c) (generatorInputs c)
        (branches (generatorInputs
        c)))).hom ≫
        generatorLeftCoefficient E c := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | inl i => exact Fin.elim0 i
    | inr i => cases i <;> rfl
