/- Exact checked source: ReflexiveOperad.TensorCarrierTransport. -/
section EnvelopingSource338


/-!
# Genuine original tensor algebra transported through an actual carrier isomorphism
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.CarrierTransport

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [Small.{us} W] [∀ d : W, HasColimitsOfShape (AnalyticIndex W d) C]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]
variable (O : ColoredOperadObj W C) (A : Algebra O) (M : W → C) (e : M ≅ A.carrier)

/-- The original profile action is transported with the actual tensor
profile functor and the actual original carrier isomorphism. -/
def action : profileCoinvariants O.toCollection M ⟶ M :=
  profileMap O.toCollection e.hom ≫ A.action ≫ e.inv

omit [Small.{us} W] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- The whole original transported action square retains the actual forward carrier map. -/
theorem action_forward : action O A M e ≫ e.hom = profileMap O.toCollection e.hom ≫ A.action :=
  (Category.assoc _ _ _).trans
    ((congrArg (profileMap O.toCollection e.hom ≫ ·) (Category.assoc _ _ _)).trans
      ((congrArg (profileMap O.toCollection e.hom ≫ A.action ≫ ·) e.inv_hom_id).trans
        (congrArg (profileMap O.toCollection e.hom ≫ ·) (Category.comp_id A.action))))

omit [Small.{us} W] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- The transported action satisfies the original profile unit equation,
derived from the given genuine algebra and original unit naturality. -/
theorem action_unit : (profileUnit O).app M ≫ action O A M e = 𝟙 M := by
  apply (cancel_mono e.hom).1
  exact (Category.assoc _ _ _).trans
    ((congrArg ((profileUnit O).app M ≫ ·) (action_forward O A M e)).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ A.action) ((profileUnit O).naturality e.hom).symm).trans
          ((Category.assoc _ _ _).trans
            ((congrArg (e.hom ≫ ·) A.action_unit).trans
              ((Category.comp_id _).trans (Category.id_comp e.hom).symm))))))

/-- The transported action satisfies the actual full profile multiplication
equation, derived from original multiplication naturality and A's genuine substitution. -/
theorem action_assoc : profileMultiplication O M ≫ action O A M e =
    profileMap O.toCollection (action O A M e) ≫ action O A M e := by
  let T := profileMonad O
  have hb : (T : (W → C) ⥤ (W → C)).map (action O A M e) ≫ (T : (W → C) ⥤ (W → C)).map e.hom =
      (T : (W → C) ⥤ (W → C)).map ((T : (W → C) ⥤ (W → C)).map e.hom) ≫
        (T : (W → C) ⥤ (W → C)).map A.action :=
    (Functor.map_comp _ _ _).symm.trans
      ((congrArg (T : (W → C) ⥤ (W → C)).map (action_forward O A M e)).trans
        (Functor.map_comp _ _ _))
  have hn : T.μ.app M ≫ (T : (W → C) ⥤ (W → C)).map e.hom =
      (T : (W → C) ⥤ (W → C)).map ((T : (W → C) ⥤ (W → C)).map e.hom) ≫ T.μ.app A.carrier :=
    (T.μ.naturality e.hom).symm
  apply (cancel_mono e.hom).1
  exact (Category.assoc _ _ _).trans
    ((congrArg (T.μ.app M ≫ ·) (action_forward O A M e)).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ A.action) hn).trans
          ((Category.assoc _ _ _).trans
            ((congrArg ((T : (W → C) ⥤ (W → C)).map ((T : (W → C) ⥤ (W → C)).map e.hom) ≫ ·)
              A.action_assoc).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ A.action) hb.symm).trans
                  ((Category.assoc _ _ _).trans
                    ((congrArg ((T : (W → C) ⥤ (W → C)).map (action O A M e) ≫ ·)
                      (action_forward O A M e).symm).trans (Category.assoc _ _ _).symm)))))))))

/-- The transported carrier has its full genuine tensor algebra structure. -/
def algebra : Algebra O := Algebra.ofAction O M (action O A M e) (action_unit O A M e)
  (action_assoc O A M e)

@[simp]
theorem algebra_carrier : (algebra O A M e).carrier = M := rfl

/-- Every original profile operation has the exact carrier-isomorphism
source tensor map, original A-operation and actual inverse target map. -/
theorem operation_formula (d : W) (P : AnalyticIndex W d) :
    (algebra O A M e).operations.app d P =
      (analyticSummandCarrierMap O.toCollection e.hom).app P ≫ A.operations.app d P ≫ e.inv d :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ A.action d ≫ e.inv d) (profileι_map O.toCollection e.hom P)).trans
      ((Category.assoc _ _ _).trans
        (congrArg ((analyticSummandCarrierMap O.toCollection e.hom).app P ≫ ·)
          ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ e.inv d) (A.action_operation d P))))))

/-- The transported full algebra maps to the original one by exactly the actual forward
carrier map. -/
def forward : algebra O A M e ⟶ A := Algebra.Hom.ofActionEquation _ _ e.hom
  ((congrArg (· ≫ e.hom) (Algebra.ofAction_action O M (action O A M e)
    (action_unit O A M e) (action_assoc O A M e))).trans (action_forward O A M e)).symm

omit [Small.{us} W] [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- The whole inverse action square is derived from the actual carrier inverse. -/
theorem action_inverse : profileMap O.toCollection e.inv ≫ action O A M e = A.action ≫ e.inv := by
  have he : profileMap O.toCollection e.inv ≫ profileMap O.toCollection e.hom = 𝟙 _ :=
    (profileMap_comp O.toCollection e.inv e.hom).symm.trans
      ((congrArg (profileMap O.toCollection) e.inv_hom_id).trans (profileMap_id
        O.toCollection A.carrier))
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ A.action ≫ e.inv) he).trans (Category.id_comp _))

/-- The inverse full algebra map uses exactly the actual inverse carrier map. -/
def inverse : A ⟶ algebra O A M e := Algebra.Hom.ofActionEquation _ _ e.inv
  ((action_inverse O A M e).symm.trans
    (congrArg (profileMap O.toCollection e.inv ≫ ·)
      (Algebra.ofAction_action O M (action O A M e) (action_unit O A M e) (action_assoc O A
        M e)).symm)).symm

/-- The actual carrier iso lifts to a full tensor algebra iso, with all original operation maps. -/
def algebraIso : algebra O A M e ≅ A where
  hom := forward O A M e
  inv := inverse O A M e
  hom_inv_id := Algebra.Hom.ext e.hom_inv_id
  inv_hom_id := Algebra.Hom.ext e.inv_hom_id

@[simp]
theorem algebraIso_hom : (algebraIso O A M e).hom.hom = e.hom := rfl

@[simp]
theorem algebraIso_inv : (algebraIso O A M e).inv.hom = e.inv := rfl


end CategoryTheory.Operad.Tensor.CarrierTransport

end
end EnvelopingSource338

/- Exact checked source: ReflexiveOperad.NullaryOperationShapes. -/
section EnvelopingSource339


/-!
# Actual original all-nullary operad substitution profiles and coefficient maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.NullaryCarrier

open CategoryTheory

variable {W : Type u}

/-- The genuine original substitution whose inner profiles are the
original nullary profiles at every original input color of P. -/
def shape (P : ColoredProfile W) : ColoredSubstitutionData W where
  outputColor := P.outputColor
  inner :=
    { index := P.inputs
      obj i := ColoredProfile.nullary (P.inputColor i) }

/-- The original outer profile is identified by its actual input and color identities. -/
def outerHom (P : ColoredProfile W) : P ⟶ (shape P).outerProfile where
  inputEquiv := Equiv.refl P.inputs
  inputColor_eq _i := rfl
  outputColor_eq := rfl

theorem outerHom_eq_id (P : ColoredProfile W) : outerHom P = 𝟙 P := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The actual identity-input inverse retains the original profile colors. -/
def outerIso (P : ColoredProfile W) : P ≅ (shape P).outerProfile where
  hom := outerHom P
  inv :=
    { inputEquiv := Equiv.refl P.inputs
      inputColor_eq _i := rfl
      outputColor_eq := rfl }
  hom_inv_id := by
    apply ColoredProfile.Hom.ext
    rfl
  inv_hom_id := by
    apply ColoredProfile.Hom.ext
    rfl

instance outerHom_isIso (P : ColoredProfile W) : IsIso (outerHom P) :=
  (outerIso P).isIso_hom

/-- The actual empty total profile has its unique original map to the
original nullary output profile; each original Fin-0 fiber is retained. -/
def totalHom (P : ColoredProfile W) : (shape P).totalProfile ⟶ ColoredProfile.nullary
  P.outputColor where
  inputEquiv :=
    { toFun := fun x => Fin.elim0 x.2
      invFun := fun x => Fin.elim0 x
      left_inv := fun x => Fin.elim0 x.2
      right_inv := fun x => Fin.elim0 x }
  inputColor_eq x := Fin.elim0 x.2
  outputColor_eq := rfl

/-- The exact original slot tuple used by the genuine free operation beta law. -/
def slotTuple (P : ColoredProfile W) : ProfileSlotTuple (profileInputs P)
  | none => ULift.up (Discrete.mk PUnit.unit)
  | some i => AnalyticIndex.nullary (d := P.inputColor i)

/-- The original slot tuple is precisely the original all-nullary substitution shape. -/
theorem slotTuple_shape (P : ColoredProfile W) :
    tupleSubstitutionShape (profileInputs P) ((slotProfileTupleFunctor (profileInputs
      P)).obj (slotTuple P)) = shape P
      := rfl

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original nullary coefficient carrier. -/
def carrier (E : ColoredOperadObj W C) : W → C := fun c =>
  E.toCollection.obj (ColoredProfile.nullary c)

/-- The exact original profile operation coefficient and each original
nullary input coefficient map to their original substitution factor slots. -/
def factorsIso (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    (analyticFactors E.toCollection (carrier E)).obj (profileInputs P) ≅
      (ColoredOperadObj.substitutionFactors E.toCollection).obj (shape P) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs)) (fun i => match i with
    | none => E.toCollection.mapIso (outerIso P)
    | some _ => Iso.refl _)

/-- The literal original E-operation on its nullary coefficient carrier,
with the original factor bijection, E.subst, and empty total-profile map. -/
def operation (E : ColoredOperadObj W C) (P : ColoredProfile W) :
    (analyticSummand E.toCollection (carrier E)).obj (profileInputs P) ⟶ carrier E P.outputColor :=
  (FiniteTensor.tensor (V := C)).map (factorsIso E P).hom ≫
    E.subst.app (shape P) ≫ E.toCollection.map (totalHom P)

/-- The original no-input operation factors are their coefficient
singletons, through the actual nullary coefficient/input bijections. -/
def nestedSingletonIso (E : ColoredSymmetricCollection W C) (A : W → C) (P : ColoredProfile W) :
    nestedOperationFactors E A (shape P) ≅
      (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj
        ((ColoredOperadObj.substitutionFactors E).obj (shape P)) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs)) (fun i => match i with
    | none => Iso.refl _
    | some i => nullaryFactorsIso E A (P.inputColor i))

/-- The actual complete coefficient source identifies with the original
all-nullary nested source through its original singleton/empty input maps. -/
def coefficientRawIso (E : ColoredSymmetricCollection W C) (A : W → C) (P : ColoredProfile W) :
    (ColoredOperadObj.substitutionFactors E).obj (shape P) ≅
      (FiniteFamily.flatten (C := C)).obj (nestedOperationFactors E A (shape P)) :=
  (FiniteFamily.mapSingletonFlattenIso.app ((ColoredOperadObj.substitutionFactors E).obj
    (shape P))).symm ≪≫
    (FiniteFamily.flatten (C := C)).mapIso (nestedSingletonIso E A P).symm


end CategoryTheory.Operad.Tensor.NullaryCarrier

end
end EnvelopingSource339

/- Exact checked source: InitialAttachment.Initial. -/
section EnvelopingSource340


/-!
# The initial algebra of the original finite tensor operad

The finite tensor in this module is produced from the displayed binary symmetric
tensor. The initial algebra is the canonical tensor free algebra on the original
colorwise initial carrier. Its comparison with the original nullary coefficient
is proved using the actual profile coinvariant cocone.
-/


set_option autoImplicit false

noncomputable section

universe uc u v us

namespace CategoryTheory.Operad.Tensor.InitialAttachment

open CategoryTheory Limits

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance originalFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C

local instance originalTensorSlots :
    FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C

local instance originalProfileColimits (d : W) :
    HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

local instance originalInitialColimit : HasInitial C :=
  HasColimitsOfShape.of_essentiallySmall C (Discrete PEmpty)

local instance nullaryInputsEmpty (d : W) :
    IsEmpty (AnalyticIndex.nullary (d := d)).inputs :=
  inferInstanceAs (IsEmpty (Fin 0))

/-- The original color-indexed initial carrier. -/
def initialCarrier : W → C := fun _ => ⊥_ C

/-- The canonical initial algebra uses the original operad and its actual tensor
free algebra, including all original nullary coefficients. -/
def initialAlgebra (E : ColoredOperadObj W C) : Algebra E :=
  freeAlgebra E (initialCarrier (W := W) (C := C))

/-- The initial-algebra map into an arbitrary original E-algebra is the canonical
free extension of the unique original colorwise initial map. -/
def initialMap (E : ColoredOperadObj W C) (B : Algebra E) : initialAlgebra E ⟶ B :=
  (tensorFreeHomEquiv E (initialCarrier (W := W) (C := C)) B).symm
    (fun d => initial.to (B.carrier d))

theorem initialMap_unique (E : ColoredOperadObj W C) (B : Algebra E)
    (f : initialAlgebra E ⟶ B) : f = initialMap E B := by
  let e := tensorFreeHomEquiv E (initialCarrier (W := W) (C := C)) B
  have h : e f = (fun d => initial.to (B.carrier d)) := by
    funext d
    exact initial.hom_ext (C := C) _ _
  exact e.injective (h.trans (e.apply_symm_apply _).symm)

/-- Initiality is derived from the original free/forgetful Hom equivalence. -/
def initialAlgebraIsInitial (E : ColoredOperadObj W C) : IsInitial (initialAlgebra E) :=
  IsInitial.ofUniqueHom (initialMap E) (initialMap_unique E)

theorem initialMap_comp (E : ColoredOperadObj W C) {A B : Algebra E} (f : A ⟶ B) :
    initialMap E A ≫ f = initialMap E B :=
  initialMap_unique E B _

theorem initialMap_self (E : ColoredOperadObj W C) :
    initialMap E (initialAlgebra E) = 𝟙 (initialAlgebra E) :=
  (initialMap_unique E (initialAlgebra E) _).symm

/-- A tensor with an original initial input slot is initial. The other tensor
factors, including the original operad coefficient, are retained. -/
def tensorIsInitialOfSlot (I : FintypeCat.{0}) (A : I → C) (i : I)
    (hi : A i = ⊥_ C) : IsInitial ((fixedIndexTensorFunctor (C := C) I).obj A) := by
  letI : DecidableEq I := Classical.decEq I
  letI : Functor.PreservesColimitsInEachSlot.{0, u, v, u, v, us}
      (fixedIndexTensorFunctor (C := C) I) :=
    FiniteTensorPreservesColimitsInEachSlot.preserves I
  let F := Pi.replaceFunctor A i ⋙ fixedIndexTensorFunctor (C := C) I
  letI : PreservesColimitsOfSize.{us, us} F :=
    Functor.PreservesColimitsInEachSlot.preserves A i
  letI : PreservesColimitsOfSize.{0, 0} F :=
    preservesSmallestColimits_of_preservesColimits F
  have hinitial : IsInitial (F.obj (⊥_ C)) :=
    initialIsInitial.isInitialObj F _
  have hA : Function.update A i (⊥_ C) = A := by
    rw [← hi]
    exact Function.update_eq_self i A
  exact hinitial.ofIso (eqToIso (congrArg (fixedIndexTensorFunctor (C := C) I).obj hA))

/-- Every nonempty original profile summand on the colorwise initial carrier is
initial, since at least one of its original heterogeneous inputs is initial. -/
def nonemptyInitialSummand (E : ColoredSymmetricCollection W C) {d : W}
    (P : AnalyticIndex W d) [Nonempty P.inputs] :
    IsInitial ((analyticSummand E (initialCarrier (W := W) (C := C))).obj P) := by
  let i : P.inputs := Classical.choice inferInstance
  let A := ((analyticFactors E (initialCarrier (W := W) (C := C))).obj P).obj
  exact tensorIsInitialOfSlot (FintypeCat.of (Option P.inputs)) A (some i) rfl

/-- The actual unique color-preserving relabelling of an empty original profile
to the original nullary profile. -/
def emptyToNullary {d : W} (P : AnalyticIndex W d) [IsEmpty P.inputs] :
    P ⟶ AnalyticIndex.nullary where
  inputEquiv := Equiv.equivOfIsEmpty P.inputs (Fin 0)
  inputColor_eq i := (inferInstance : IsEmpty P.inputs).false i |>.elim
  outputColor_eq := rfl

omit [Small.{us} W] in
theorem emptyToNullary_comp {d : W} {P Q : AnalyticIndex W d}
    [IsEmpty P.inputs] [IsEmpty Q.inputs] (f : P ⟶ Q) :
    f ≫ emptyToNullary Q = emptyToNullary P := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  exact (inferInstance : IsEmpty P.inputs).false i |>.elim

omit [Small.{us} W] in
theorem emptyToNullary_self (d : W) :
    emptyToNullary (AnalyticIndex.nullary (d := d)) = 𝟙 AnalyticIndex.nullary := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  exact Fin.elim0 i

/-- The nullary coefficient receives the actual original empty summands and the
unique maps from the original nonempty initial summands. -/
def initialSummandProjection (E : ColoredSymmetricCollection W C) {d : W}
    (P : AnalyticIndex W d) :
    (analyticSummand E (initialCarrier (W := W) (C := C))).obj P ⟶
      E.obj (ColoredProfile.nullary d) := by
  classical
  by_cases h : IsEmpty P.inputs
  · letI := h
    exact (analyticSummand E (initialCarrier (W := W) (C := C))).map (emptyToNullary P) ≫
      (nullarySummandIso E (initialCarrier (W := W) (C := C)) d).hom
  · letI : Nonempty P.inputs := not_isEmpty_iff.mp h
    exact (nonemptyInitialSummand E P).to _

omit [Small.{us} W] in
theorem initialSummandProjection_empty (E : ColoredSymmetricCollection W C) {d : W}
    (P : AnalyticIndex W d) [IsEmpty P.inputs] :
    initialSummandProjection E P =
      (analyticSummand E (initialCarrier (W := W) (C := C))).map (emptyToNullary P) ≫
        (nullarySummandIso E (initialCarrier (W := W) (C := C)) d).hom := by
  simp [initialSummandProjection, dite_eq_left (inferInstance : IsEmpty P.inputs)]

omit [Small.{us} W] in
theorem initialSummandProjection_naturality (E : ColoredSymmetricCollection W C)
    {d : W} {P Q : AnalyticIndex W d} (f : P ⟶ Q) :
    (analyticSummand E (initialCarrier (W := W) (C := C))).map f ≫
        initialSummandProjection E Q = initialSummandProjection E P := by
  classical
  by_cases h : IsEmpty P.inputs
  · let := h
    let : IsEmpty Q.inputs := (f.inputEquiv.isEmpty_congr).mp h
    rw [initialSummandProjection_empty, initialSummandProjection_empty,
      ← Category.assoc, ← Functor.map_comp, emptyToNullary_comp]
  · let : Nonempty P.inputs := not_isEmpty_iff.mp h
    exact (nonemptyInitialSummand E P).hom_ext _ _

/-- The original full analytic profile cocone identifying the initial free
carrier with the original operad's nullary coefficient. -/
def nullaryCoefficientCocone (E : ColoredSymmetricCollection W C) (d : W) :
    Cocone (analyticSummand (d := d) E (initialCarrier (W := W) (C := C))) where
  pt := E.obj (ColoredProfile.nullary d)
  ι.app P := initialSummandProjection E P
  ι.naturality P Q f := by
    change _ = initialSummandProjection E P ≫ 𝟙 _
    rw [Category.comp_id]
    exact initialSummandProjection_naturality E f

/-- The map from the original nullary coefficient into the carrier of the
constructed initial algebra is its original nullary profile injection. -/
def nullaryToInitial (E : ColoredOperadObj W C) (d : W) :
    E.toCollection.obj (ColoredProfile.nullary d) ⟶ (initialAlgebra E).carrier d :=
  (nullarySummandIso E.toCollection (initialCarrier (W := W) (C := C)) d).inv ≫
    profileι E.toCollection (initialCarrier (W := W) (C := C)) AnalyticIndex.nullary

/-- The inverse comparison descends the actual original analytic profile
cocone, rather than supplying a desired carrier isomorphism. -/
def initialToNullary (E : ColoredOperadObj W C) (d : W) :
    (initialAlgebra E).carrier d ⟶ E.toCollection.obj (ColoredProfile.nullary d) :=
  colimit.desc _ (nullaryCoefficientCocone E.toCollection d)

theorem profile_initialToNullary (E : ColoredOperadObj W C) {d : W}
    (P : AnalyticIndex W d) :
    profileι E.toCollection (initialCarrier (W := W) (C := C)) P ≫ initialToNullary E d =
      initialSummandProjection E.toCollection P :=
  colimit.ι_desc _ _

theorem nullaryToInitial_initialToNullary (E : ColoredOperadObj W C) (d : W) :
    nullaryToInitial E d ≫ initialToNullary E d =
      𝟙 (E.toCollection.obj (ColoredProfile.nullary d)) := by
  let e := nullarySummandIso E.toCollection (initialCarrier (W := W) (C := C)) d
  let F := analyticSummand (d := d) E.toCollection (initialCarrier (W := W) (C := C))
  let p : F.obj AnalyticIndex.nullary ⟶ (initialAlgebra E).carrier d :=
    profileι E.toCollection (initialCarrier (W := W) (C := C)) AnalyticIndex.nullary
  have hp : p ≫ initialToNullary E d = e.hom := by
    exact (profile_initialToNullary E AnalyticIndex.nullary).trans
      ((initialSummandProjection_empty E.toCollection AnalyticIndex.nullary).trans
        ((congrArg (fun f => F.map f ≫ e.hom) (emptyToNullary_self d)).trans
          ((congrArg (· ≫ e.hom) (F.map_id _)).trans (Category.id_comp e.hom))))
  exact (Category.assoc e.inv p (initialToNullary E d)).trans
    ((congrArg (e.inv ≫ ·) hp).trans e.inv_hom_id)

theorem initialToNullary_nullaryToInitial (E : ColoredOperadObj W C) (d : W) :
    initialToNullary E d ≫ nullaryToInitial E d = 𝟙 ((initialAlgebra E).carrier d) := by
  classical
  apply colimit.hom_ext
  intro P
  let F := analyticSummand (d := d) E.toCollection (initialCarrier (W := W) (C := C))
  let p : F.obj P ⟶ (initialAlgebra E).carrier d :=
