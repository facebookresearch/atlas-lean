/- Exact checked source: EnvelopingAssociativityRootFirstCoefficients. -/
section EnvelopingSource064


/-!
# Actual root-first coefficient regrouping with original retained input maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original root and middle coefficients form the first
block; every original innermost coefficient remains a singleton. -/
def envelopingAssocRootFirstCoefficientBlocks (O : ColoredSymmetricCollection W C) (d :
  ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) : FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option d.middleData.totalProfile.inputs)
  obj i := match i with
    | none => envelopingRepresentativeCoefficients O d.middleData (envelopingAssocMiddleChoices d Q)
    | some p => (FiniteFamily.singleton (C := C)).obj
        (O.obj (extendProfile ((d.localData p.1).inner.obj p.2) (Q.branch p.1 (some p.2))))

/-- The exact original root/middle/inner coefficient position
bijection changes grouping, retaining all original coefficient strands. -/
def envelopingAssocRootFirstCoefficientEquiv (O : ColoredSymmetricCollection W C) (d :
  ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (envelopingAssocCoefficients O d Q).index ≃
      ((FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstCoefficientBlocks O d
        Q)).index where
  toFun p := match p with
    | ⟨none, _⟩ => ⟨none, none⟩
    | ⟨some i, none⟩ => ⟨none, some i⟩
    | ⟨some i, some j⟩ => ⟨some ⟨i, j⟩, PUnit.unit⟩
  invFun p := match p with
    | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
    | ⟨none, some i⟩ => ⟨some i, none⟩
    | ⟨some ⟨i, j⟩, _⟩ => ⟨some i, some j⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  right_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl

/-- The actual coefficient regrouping retains every original
operation object at its original root/middle/inner position. -/
def envelopingAssocRootFirstCoefficientIso (O : ColoredSymmetricCollection W C) (d :
  ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    envelopingAssocCoefficients O d Q ≅
      (FiniteFamily.flatten (C := C)).obj (envelopingAssocRootFirstCoefficientBlocks O d Q) :=
  FiniteFamily.isoOfComponents (envelopingAssocRootFirstCoefficientEquiv O d Q) (fun p =>
    match p with
    | ⟨none, _⟩ => Iso.refl _
    | ⟨some _, none⟩ => Iso.refl _
    | ⟨some _, some _⟩ => Iso.refl _)

variable [FiniteTensor C]

/-- The actual root/middle coefficient substitution uses its
original representative substitution and exact middle algebra-input map. -/
def envelopingAssocMiddleCoefficientSubstitution (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj
        (envelopingRepresentativeCoefficients O.toCollection d.middleData
          (envelopingAssocMiddleChoices d Q)) ⟶
      O.toCollection.obj (extendProfile d.innerData.outerProfile
        (envelopingAssocInnerRootInputs d Q)) :=
  envelopingRepresentativeCoefficientSubstitution O d.middleData
    (envelopingAssocMiddleChoices d Q) ≫
    O.toCollection.map (extendProfileMap (𝟙 d.middleData.totalProfile)
      (envelopingAssocMiddleAlgebraMap d Q))

/-- The actual root-first tensor blocks contract their original
middle substitution, while every original innermost coefficient
uses the genuine original singleton tensor unitor. -/
def envelopingAssocRootFirstContractionMap (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
      (envelopingAssocRootFirstCoefficientBlocks O.toCollection d Q)
      ⟶
      envelopingRepresentativeCoefficients O.toCollection d.innerData
        (envelopingAssocInnerChoices d Q) where
  equiv := Equiv.refl (Option d.middleData.totalProfile.inputs)
  hom i := match i with
    | none => envelopingAssocMiddleCoefficientSubstitution O d Q
    | some p => (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile ((d.localData p.1).inner.obj p.2) (Q.branch p.1
          (some p.2))))

/-- The actual original root-first coefficient tensor route,
with its exact original coefficient regrouping and middle substitution. -/
def envelopingAssocRootFirstContraction (O : ColoredOperadObj W C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj (envelopingAssocCoefficients O.toCollection d Q) ⟶
      (FiniteTensor.tensor (V := C)).obj
        (envelopingRepresentativeCoefficients O.toCollection d.innerData
          (envelopingAssocInnerChoices d Q)) :=
  (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstCoefficientIso O.toCollection
    d Q).hom ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocRootFirstCoefficientBlocks
      O.toCollection d Q) ≫
    (FiniteTensor.tensor (V := C)).map (envelopingAssocRootFirstContractionMap O d Q)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource064

