the original free generator unitInsertion, including its original singleton unitor. -/
theorem generatorInsertion_compare (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    generatorInsertion O B c ≫ (nullaryLinearDiagramIso O.toCollection B c).hom.app
      (generatorInputs c) =
      unitInsertion O B c := by
  let T := FiniteTensor.tensor (V := C)
  let p := UnitInsertion.leftInsertPrefix (B c)
  let a := T.map (generatorFactor O B c)
