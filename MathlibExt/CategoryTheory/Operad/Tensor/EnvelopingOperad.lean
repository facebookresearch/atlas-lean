/-!
# Exact original input choices and profile maps for the linear unit laws
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory

variable {W : Type u}

/-- The right unit input choices retain the algebra inputs at the root and leave every unit
branch empty. -/
def rightUnitChoices (P : ColoredProfile W) (Q : ColoredInputs W) :
    EnvelopingInputChoices (ColoredSubstitutionData.rightUnit P)
  | none => Q
  | some _ => emptyColoredInputs

/-- The left unit input choices leave the root empty and retain the algebra inputs in the sole
branch. -/
def leftUnitChoices (P : ColoredProfile W) (Q : ColoredInputs W) :
    EnvelopingInputChoices (ColoredSubstitutionData.leftUnit P)
  | none => emptyColoredInputs
  | some _ => Q

/-- The original right unit route retains exactly the original root
added inputs, with all original empty branch input positions retained. -/
def rightUnitInputsIso (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingTotalAlgebraInputs (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P Q) ≅ Q :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | Sum.inl p => p | Sum.inr ⟨_, p⟩ => p.elim
      invFun := Sum.inl
      left_inv := fun p => by cases p with
        | inl p => rfl
        | inr p => exact p.2.elim
      right_inv := fun _ => rfl }
    (fun p => match p with | Sum.inl _ => Iso.refl _ | Sum.inr p => p.2.elim)

/-- The original left unit route retains exactly the original inner
added inputs through its actual empty-root/singleton-inner input bijection. -/
def leftUnitInputsIso (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingTotalAlgebraInputs (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P Q) ≅ Q :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | Sum.inl p => p.elim | Sum.inr ⟨_, p⟩ => p
      invFun := fun p => Sum.inr ⟨PUnit.unit, p⟩
      left_inv := fun p => by cases p with
        | inl p => cases p
        | inr p => rcases p with ⟨i, j⟩; cases i; rfl
      right_inv := fun _ => rfl }
    (fun p => match p with | Sum.inl p => p.elim | Sum.inr _ => Iso.refl _)

/-- The actual right representative substitution compares with the
original complete O-right-unit datum at the extended profile P⊔Q. -/
def rightToExtendedUnit (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeSubstitution (ColoredSubstitutionData.rightUnit P)
      (rightUnitChoices P Q) ⟶
      ColoredSubstitutionData.rightUnit (extendProfile P Q) where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl (P.inputs ⊕ Q.index)
      hom p := match p with
        | Sum.inl p => emptyExtensionProfileHom (ColoredSubstitutionData.unitProfile
          (P.inputColor p))
        | Sum.inr p => 𝟙 (ColoredSubstitutionData.unitProfile (Q.obj p).as) }

/-- The actual left representative substitution compares with the
original complete O-left-unit datum at the extended profile P⊔Q. -/
def leftToExtendedUnit (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeSubstitution (ColoredSubstitutionData.leftUnit P)
      (leftUnitChoices P Q) ⟶
      ColoredSubstitutionData.leftUnit (extendProfile P Q) where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.sumEmpty PUnit Empty
      hom p := match p with | Sum.inl _ => 𝟙 (extendProfile P Q) | Sum.inr p => p.elim }

/-- The exact original right root-profile comparisons are the
original outer map at the full extended profile. -/
theorem rightToExtendedUnit_outer (P : ColoredProfile W) (Q : ColoredInputs W) :
    extendProfileMap (ColoredSubstitutionData.rightUnitOuterHom P) (𝟙 Q) ≫
      envelopingRepresentativeOuterHom (ColoredSubstitutionData.rightUnit P)
        (rightUnitChoices P Q) ≫
      ColoredSubstitutionData.outerProfileMap (rightToExtendedUnit P Q) =
    ColoredSubstitutionData.rightUnitOuterHom (extendProfile P Q) := by
  apply ColoredProfile.Hom.ext
  ext p
  cases p <;> rfl

/-- The exact original left root-profile comparisons retain the
original empty extension profile map of the O-unit. -/
theorem leftToExtendedUnit_outer (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeOuterHom (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P Q) ≫
      ColoredSubstitutionData.outerProfileMap (leftToExtendedUnit P Q) =
    emptyExtensionProfileHom (ColoredSubstitutionData.unitProfile P.outputColor) := by
  apply ColoredProfile.Hom.ext
  ext p
  cases p with
  | inl p => rfl
  | inr p => cases p

/-- The original right total-variable and total-added-input maps
are precisely the original complete extended right-unit total map. -/
theorem rightToExtendedUnit_total (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeTotalHom (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P Q) ≫
      extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P) (rightUnitInputsIso P Q).hom =
    ColoredSubstitutionData.totalProfileMap (rightToExtendedUnit P Q) ≫
      ColoredSubstitutionData.rightUnitTotalHom (extendProfile P Q) := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases j with
    | inl j => cases j; rfl
    | inr j => cases j
  | inr i => cases j; rfl

/-- The original left total-variable and total-added-input maps
are precisely the original complete extended left-unit total map. -/
theorem leftToExtendedUnit_total (P : ColoredProfile W) (Q : ColoredInputs W) :
    envelopingRepresentativeTotalHom (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P Q) ≫
      extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P) (leftUnitInputsIso P Q).hom =
    ColoredSubstitutionData.totalProfileMap (leftToExtendedUnit P Q) ≫
      ColoredSubstitutionData.leftUnitTotalHom (extendProfile P Q) := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases i; cases j <;> rfl
  | inr i => cases i

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The supplied original O-unit coefficient at each variable input
uses its original empty-extension profile inverse. -/
def rightUnitCoefficient (O : ColoredOperadObj W C) (P : ColoredProfile W) (i : P.inputs) :
    (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶
      O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile (P.inputColor
        i)) emptyColoredInputs) :=
  O.unit (P.inputColor i) ≫ O.toCollection.map (emptyExtensionProfileIso
    (ColoredSubstitutionData.unitProfile
    (P.inputColor i))).inv

/-- The output-color unit coefficient, transported to its profile with empty added inputs. -/
def leftUnitCoefficient (O : ColoredOperadObj W C) (P : ColoredProfile W) :
    (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶
      O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
        emptyColoredInputs) :=
  O.unit P.outputColor ≫ O.toCollection.map (emptyExtensionProfileIso
    (ColoredSubstitutionData.unitProfile
    P.outputColor)).inv

/-- The original right coefficient family retains the actual root
profile map and each actual empty added-input unit coefficient. -/
def rightUnitCoefficientFamilyIso (O : ColoredSymmetricCollection W C) (P : ColoredProfile
  W) (Q : ColoredInputs W) :
    UnitGeometry.rightCoefficientFamily (O.obj (extendProfile P Q)) P.inputs
        (fun i => O.obj (extendProfile (ColoredSubstitutionData.unitProfile (P.inputColor
          i)) emptyColoredInputs)) ≅
      envelopingRepresentativeCoefficients O (ColoredSubstitutionData.rightUnit P)
        (rightUnitChoices P Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs)) (fun i => match i with
    | none => O.mapIso (asIso (extendProfileMap (ColoredSubstitutionData.rightUnitOuterHom
      P) (𝟙 Q)))
    | some _ => Iso.refl _)

/-- Identify the sparse left unit coefficient family with the representative coefficient family. -/
def leftUnitCoefficientFamilyIso (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
  (Q : ColoredInputs W) :
    sparseUnitScalarFamily
        (O.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
          emptyColoredInputs))
        (O.obj (extendProfile P Q)) ≅
      envelopingRepresentativeCoefficients O (ColoredSubstitutionData.leftUnit P)
        (leftUnitChoices P Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option PUnit)) (fun i => match i with
    | none => Iso.refl _
    | some _ => Iso.refl _)

/-- Insert the input-color unit coefficients beside the original coefficient for the right unit
substitution. -/
def rightUnitCoefficientInsertion (O : ColoredOperadObj W C) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    O.toCollection.obj (extendProfile P Q) ⟶
      (FiniteTensor.tensor (V := C)).obj
        (envelopingRepresentativeCoefficients O.toCollection
          (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P
          Q)) :=
  UnitInsertion.rightInsertFromFactor (O.toCollection.obj (extendProfile P Q)) P.inputs
      (UnitGeometry.rightCoefficientFactor (O.toCollection.obj (extendProfile P Q)) P.inputs
        (fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
          (P.inputColor i))
          emptyColoredInputs))
        (rightUnitCoefficient O P)) ≫
    (FiniteTensor.tensor (V := C)).map (rightUnitCoefficientFamilyIso O.toCollection P Q).hom

/-- Insert the output-color unit coefficient before the original coefficient for the left unit
substitution. -/
def leftUnitCoefficientInsertion (O : ColoredOperadObj W C) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    O.toCollection.obj (extendProfile P Q) ⟶
      (FiniteTensor.tensor (V := C)).obj
        (envelopingRepresentativeCoefficients O.toCollection
          (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P Q))
          :=
  UnitInsertion.leftInsertFromFactor (O.toCollection.obj (extendProfile P Q))
      (UnitGeometry.leftCoefficientFactor (O.toCollection.obj (extendProfile P Q))
        (O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
          P.outputColor) emptyColoredInputs))
        (leftUnitCoefficient O P)) ≫
    (FiniteTensor.tensor (V := C)).map (leftUnitCoefficientFamilyIso O.toCollection P Q).hom


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
