section EnvelopingSource170


/-!
# Genuine left unit insertion commutes with the original coefficient/leaf tensor
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem flattenLeftChain {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    ((a ≫ b) ≫ c) ≫ d = a ≫ b ≫ c ≫ d := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The exact original weighted left unit insertion followed by
actual finite coefficient/input interchange is the original coefficient
left insertion tensored with every original heterogeneous input leaf.
The original empty root and singleton input blocks are retained. -/
theorem leftWeightedPrefix_coherence (X : C) (L : FiniteFamily C) (Y : C)
    (η : (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y) :
    (UnitInsertion.leftInsertFromFactor ((coefficientLeafTensorFunctor L).obj X)
      (leftWeightedFactor X L Y η) ≫
        (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option PUnit))
          (sparseUnitScalarFamily Y X).obj (leftLeaves L)).hom) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (𝟙 ((FiniteTensor.tensor (V := C)).obj (sparseUnitScalarFamily Y X)))
          (leftLeavesIso L).hom) =
    (coefficientLeafTensorFunctor L).map
      (UnitInsertion.leftInsertFromFactor X (leftCoefficientFactor X Y η)) := by
  let T := FiniteTensor.tensor (V := C)
  let U := coefficientLeafTensorFunctor L
  let I := FintypeCat.of (Option PUnit)
  let K := rightCoefficientFamily X (FintypeCat.of PUnit) (fun _ => Y)
  let K' := sparseUnitScalarFamily Y X
  let M := rightLeaves L (FintypeCat.of PUnit)
  let M' := leftLeaves L
  let a := UnitInsertion.rightInsertFromFactor (U.obj X) (FintypeCat.of PUnit)
    (rightWeightedFactor X L (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η))
  let a' := UnitInsertion.leftInsertFromFactor (U.obj X) (leftWeightedFactor X L Y η)
  let p := T.map (leftWeightedRelabelMap X L Y)
  let i := (coefficientBlockInterchangeTensorIso I K.obj M).hom
  let i' := (coefficientBlockInterchangeTensorIso I K'.obj M').hom
  let q := T.map (coefficientLeafMap (𝟙 (T.obj K)) (rightLeavesIso L (FintypeCat.of PUnit)).hom)
  let q' := T.map (coefficientLeafMap (𝟙 (T.obj K')) (leftLeavesIso L).hom)
  let c := T.map (leftCoefficientIso X Y).hom
  let leaf := (FiniteFamily.flatten (C := C)).map
    (inputBlockRelabelMap (I := I) (J := I) (L := M) (L' := M')
      unitFlipEquiv (fun i => (leftLeafIsoAt L i).hom))
  let r := T.map (coefficientLeafMap c leaf)
  let s := T.map (coefficientLeafMap c (rightLeavesIso L (FintypeCat.of PUnit)).hom)
  let z := U.map c
  let b := UnitInsertion.rightInsertFromFactor X (FintypeCat.of PUnit)
    (rightCoefficientFactor X (FintypeCat.of PUnit) (fun _ => Y) (fun _ => η))
  have hp : a ≫ p = a' := leftWeightedInsertion_relabel X L Y η
  have hn := coefficientBlockInterchangeTensorIso_relabel
    (I := I) (J := I) (K := K.obj) (K' := K'.obj) (L := M) (L' := M')
    unitFlipEquiv (leftCoefficientIso X Y).hom.hom (fun i => (leftLeafIsoAt L i).hom)
  have hk : coefficientBlockRelabelMap (I := I) (J := I)
      unitFlipEquiv (leftCoefficientIso X Y).hom.hom = (leftCoefficientIso X Y).hom := rfl
  have hi : p ≫ i' = i ≫ r := hn.trans
    (congrArg (fun k => i ≫ T.map (coefficientLeafMap (T.map k) leaf)) hk)
  have hfamily : coefficientLeafMap c leaf ≫ coefficientLeafMap (𝟙 (T.obj K'))
    (leftLeavesIso L).hom =
      coefficientLeafMap c (rightLeavesIso L (FintypeCat.of PUnit)).hom :=
    (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg₂ (fun coeff leaf => coefficientLeafMap coeff leaf) (Category.comp_id c)
        (leftLeaves_relabel L))
  have hq : r ≫ q' = s := (T.map_comp _ _).symm.trans (congrArg T.map hfamily)
  have hs : p ≫ i' ≫ q' = i ≫ s := (Category.assoc p i' q').symm.trans
    ((congrArg (· ≫ q') hi).trans ((Category.assoc i r q').trans (congrArg (i ≫ ·) hq)))
  have hpost : a ≫ i ≫ s = (a ≫ i ≫ q) ≫ z :=
    interchangeSourcePostCoefficient I K.obj M a c (rightLeavesIso L (FintypeCat.of PUnit)).hom
  have hright : (a ≫ i) ≫ q = U.map b := rightWeightedPrefix_coherence X L (FintypeCat.of PUnit)
    (fun _ => Y) (fun _ => η)
  have hb : b ≫ c = UnitInsertion.leftInsertFromFactor X (leftCoefficientFactor X Y η) :=
    leftCoefficientInsertion_relabel X Y η
  exact (congrArg (fun a => (a ≫ i') ≫ q') hp.symm).trans
    ((flattenLeftChain a p i' q').trans
      ((congrArg (a ≫ ·) hs).trans
        (hpost.trans
          ((congrArg (· ≫ z) (Category.assoc a i q).symm).trans
            ((congrArg (· ≫ z) hright).trans
              ((U.map_comp b c).symm.trans (congrArg U.map hb)))))))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
end EnvelopingSource170

/- Exact checked source: EnvelopingChoiceCoefficientNaturality. -/
section EnvelopingSource171


/-!
# Original representative coefficient substitution commutes with all input-choice maps
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalThreeChoiceSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- Every root and variable-branch operation coefficient uses
its actual original input-choice profile permutation. -/
def envelopingRepresentativeCoefficientMap (O : ColoredSymmetricCollection W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingRepresentativeCoefficients O s Q ⟶ envelopingRepresentativeCoefficients O s Q' where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := match i with
    | none => O.map (extendProfileMap (𝟙 s.outerProfile) (g none))
    | some i => O.map (extendProfileMap (𝟙 (s.inner.obj i)) (g (some i)))

variable [FiniteTensor C]

private theorem originalUnitColorTransport (O : ColoredOperadObj W C) {c c' : W} (h : c = c') :
    O.unit c ≫ O.toCollection.map (unaryColorHom h) = O.unit c' := by
  cases h
  have hid := O.toCollection.map_id (ColoredSubstitutionData.unitProfile c)
  change O.unit c ≫ O.toCollection.map (𝟙 (ColoredSubstitutionData.unitProfile c)) = _
  rw [hid]
  exact Category.comp_id (O.unit c)

/-- Original units at the retained root algebra positions and
all original root/variable coefficients commute with input choices. -/
theorem envelopingRepresentativeUnitMap_naturality (O : ColoredOperadObj W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingRepresentativeUnitMap O s Q ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (envelopingRepresentativeSubstitutionMap s g) =
      Variable.unitFamilyMap (g none).equiv (envelopingRepresentativeCoefficientMap
        O.toCollection s g) ≫
        envelopingRepresentativeUnitMap O s Q' := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl j => rfl
    | inr p => cases p <;> rfl
  · intro p
    cases p with
    | inl j =>
      change HEq (O.unit ((Q none).obj j).as ≫ O.toCollection.map
        (unaryColorHom (Discrete.eq_of_hom ((g none).hom j))))
        (𝟙 _ ≫ O.unit ((Q' none).obj ((g none).equiv j)).as)
      exact heq_of_eq ((originalUnitColorTransport O (Discrete.eq_of_hom ((g none).hom j))).trans
        (Category.id_comp _).symm)
    | inr p =>
      cases p with
      | none =>
        change HEq (O.toCollection.map (envelopingRepresentativeOuterHom s Q) ≫
          O.toCollection.map (ColoredSubstitutionData.outerProfileMap
            (envelopingRepresentativeSubstitutionMap s g)))
          (O.toCollection.map (extendProfileMap (𝟙 s.outerProfile) (g none)) ≫
            O.toCollection.map (envelopingRepresentativeOuterHom s Q'))
        exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
          ((congrArg O.toCollection.map (envelopingRepresentativeOuterHom_naturality s
            g).symm).trans
            (O.toCollection.map_comp _ _)))
      | some i =>
        change HEq (𝟙 _ ≫ O.toCollection.map (extendProfileMap (𝟙 (s.inner.obj i)) (g (some i))))
          (O.toCollection.map (extendProfileMap (𝟙 (s.inner.obj i)) (g (some i))) ≫ 𝟙 _)
        exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- The actual original representative substitution tensor map
commutes with every input-choice map, by original unit insertion
naturality and the exact original coefficient/profile square. -/
theorem envelopingRepresentativeCoefficientTensorMap_naturality (O : ColoredOperadObj W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingRepresentativeCoefficientMap O.toCollection s g) ≫
        envelopingRepresentativeCoefficientTensorMap O s Q' =
      envelopingRepresentativeCoefficientTensorMap O s Q ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map
          (envelopingRepresentativeSubstitutionMap s g) := by
  let T := FiniteTensor.tensor (V := C)
  let k := envelopingRepresentativeCoefficientMap O.toCollection s g
  let h := (ColoredOperadObj.substitutionFactors O.toCollection).map
    (envelopingRepresentativeSubstitutionMap s g)
  have hu : T.map (Variable.unitFamilyMap (g none).equiv k) ≫
    T.map (envelopingRepresentativeUnitMap O s Q') =
      T.map (envelopingRepresentativeUnitMap O s Q) ≫ T.map h :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (envelopingRepresentativeUnitMap_naturality O s g).symm).trans
        (T.map_comp _ _))
  exact (by
    change T.map k ≫ ((frozenVariableTensorUnitIso (Q' none).index
      (envelopingRepresentativeCoefficients O.toCollection s Q')).hom ≫
        T.map (envelopingRepresentativeUnitMap O s Q'))
        = _
    rw [← Category.assoc, Variable.tensorUnitIso_naturality, Category.assoc, hu, ← Category.assoc]
    rfl)

/-- The actual original coefficient substitution is natural in
all root/inner input choices, original colors and input permutations. -/
theorem envelopingRepresentativeCoefficientSubstitution_naturality (O : ColoredOperadObj W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingRepresentativeCoefficientMap O.toCollection s g) ≫
        envelopingRepresentativeCoefficientSubstitution O s Q' =
      envelopingRepresentativeCoefficientSubstitution O s Q ≫
        O.toCollection.map (extendProfileMap (𝟙 s.totalProfile)
          (envelopingTotalAlgebraInputsMap s g)) := by
  let f := envelopingRepresentativeSubstitutionMap s g
  have h3 : O.toCollection.map (ColoredSubstitutionData.totalProfileMap f) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom s Q') =
      O.toCollection.map (envelopingRepresentativeTotalHom s Q) ≫
        O.toCollection.map (extendProfileMap (𝟙 s.totalProfile)
          (envelopingTotalAlgebraInputsMap s g)) :=
    (O.toCollection.map_comp _ _).symm.trans
      ((congrArg O.toCollection.map (envelopingRepresentativeTotalHom_naturality s g)).trans
        (O.toCollection.map_comp _
        _))
  exact originalThreeChoiceSquares ((FiniteTensor.tensor (V :=
    C)).map (envelopingRepresentativeCoefficientMap
    O.toCollection s g))
    (envelopingRepresentativeCoefficientTensorMap O s Q)
      (envelopingRepresentativeCoefficientTensorMap O s Q')
    ((ColoredOperadObj.substitutionSource O.toCollection).map f)
    (O.subst.app (envelopingRepresentativeSubstitution s Q)) (O.subst.app
      (envelopingRepresentativeSubstitution s Q'))
    (O.toCollection.map (ColoredSubstitutionData.totalProfileMap f))
    (O.toCollection.map (envelopingRepresentativeTotalHom s Q)) (O.toCollection.map
      (envelopingRepresentativeTotalHom s
      Q'))
    (O.toCollection.map (extendProfileMap (𝟙 s.totalProfile) (envelopingTotalAlgebraInputsMap s g)))
    (envelopingRepresentativeCoefficientTensorMap_naturality O s g) (O.subst.naturality f) h3


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource171

/- Exact checked source: EnvelopingRepresentativeNaturality. -/
section EnvelopingSource172


/-!
# Actual representative evaluations respect all algebra-input choices
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every coefficient slot uses its original extended-profile map. -/
def envelopingSlotCoefficientMap (O : ColoredSymmetricCollection W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q')
    (i : Option s.inner.index) :
    O.obj (extendProfile (envelopingSlotProfile s i) (Q i)) ⟶
      O.obj (extendProfile (envelopingSlotProfile s i) (Q' i)) :=
  O.map (extendProfileMap (𝟙 (envelopingSlotProfile s i)) (g i))

/-- All retained root and inner algebra inputs use their original maps. -/
def envelopingSlotAlgebraMap (A : W → C) (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') (i : Option s.inner.index) :
    (addedAlgebraInputs A).obj (Q i) ⟶ (addedAlgebraInputs A).obj (Q' i) :=
  (addedAlgebraInputs A).map (g i)

/-- The actual map of the original coefficient/input tensor blocks. -/
def envelopingWeightedRepresentativeMap (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingWeightedRepresentativeFamily O A s Q ⟶
      envelopingWeightedRepresentativeFamily O A s Q' :=
  weightedInputBlockMap (FintypeCat.of (Option s.inner.index))
    (envelopingSlotCoefficientMap O s g) (envelopingSlotAlgebraMap A s g)

/-- The actual map retains every original algebra leaf in its slot. -/
def envelopingBlockAlgebraMap (A : W → C) (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingBlockAlgebraLeaves A s Q ⟶ envelopingBlockAlgebraLeaves A s Q' :=
  (FiniteFamily.flatten (C := C)).map
    (inputBlockMap (FintypeCat.of (Option s.inner.index)) (envelopingSlotAlgebraMap A s g))

omit [FiniteTensor C] in
/-- The exact original root/dependent-inner leaf bijection is natural. -/
theorem envelopingAlgebraLeafIso_naturality (A : W → C) (s : ColoredSubstitutionData W)
    {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    envelopingBlockAlgebraMap A s g ≫ (envelopingAlgebraLeafIso A s Q').hom =
      (envelopingAlgebraLeafIso A s Q).hom ≫
        (addedAlgebraInputs A).map (envelopingTotalAlgebraInputsMap s g) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      change HEq ((Discrete.functor A).map ((g none).hom j) ≫ 𝟙 _)
        (𝟙 _ ≫ (Discrete.functor A).map ((g none).hom j))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      change HEq ((Discrete.functor A).map ((g (some i)).hom j) ≫ 𝟙 _)
        (𝟙 _ ≫ (Discrete.functor A).map ((g (some i)).hom j))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

omit [FiniteTensor C] in
/-- The exact original coefficient block comparison is natural. -/
theorem envelopingCoefficientBlockIso_naturality (O : ColoredSymmetricCollection W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    coefficientBlockMap (FintypeCat.of (Option s.inner.index)) (envelopingSlotCoefficientMap
      O s g) ≫
        (envelopingCoefficientBlockIso O s Q').hom =
      (envelopingCoefficientBlockIso O s Q).hom ≫ envelopingRepresentativeCoefficientMap O s g := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap (𝟙 s.outerProfile) (g none)) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap (𝟙 s.outerProfile) (g none)))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      change HEq (O.map (extendProfileMap (𝟙 (s.inner.obj i)) (g (some i))) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap (𝟙 (s.inner.obj i)) (g (some i))))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

private theorem originalRepresentativeSquares {V : Type*} [Category* V]
    {X X' Y Y' Z Z' : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (b : Y ⟶ Z) (b' : Y' ⟶ Z') (g : Z ⟶ Z')
    (ha : k ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) :
    k ≫ (a' ≫ b') = (a ≫ b) ≫ g := by
  rw [← Category.assoc k a', ha, Category.assoc a f, hb, Category.assoc]

private theorem originalJointCoefficientLeafSquare {V : Type*} [Category* V]
    {X X' Y Y' : V} {L L' M M' : FiniteFamily V}
    (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (f : Y ⟶ Y')
    (l : L ⟶ L') (b : L ⟶ M) (b' : L' ⟶ M') (g : M ⟶ M')
    (ha : k ≫ a' = a ≫ f) (hb : l ≫ b' = b ≫ g) :
    coefficientLeafMap k l ≫ coefficientLeafMap a' b' =
      coefficientLeafMap a b ≫ coefficientLeafMap f g := by
  rw [coefficientLeafMap_comp, ha, hb, coefficientLeafMap_comp]

/-- The original normalized coefficient substitution uses exactly
the original root/branch coefficient maps and total-profile map. -/
theorem envelopingNormalizedCoefficient_naturality (O : ColoredOperadObj W C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map
        (coefficientBlockMap (FintypeCat.of (Option s.inner.index))
          (envelopingSlotCoefficientMap O.toCollection s g)) ≫
        ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection s
          Q').hom ≫
          envelopingRepresentativeCoefficientSubstitution O s Q') =
      ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
        envelopingRepresentativeCoefficientSubstitution O s Q) ≫
          O.toCollection.map (extendProfileMap (𝟙 s.totalProfile)
            (envelopingTotalAlgebraInputsMap s g)) := by
  let T := FiniteTensor.tensor (V := C)
  have h : T.map (coefficientBlockMap (FintypeCat.of (Option s.inner.index))
        (envelopingSlotCoefficientMap O.toCollection s g)) ≫
        T.map (envelopingCoefficientBlockIso O.toCollection s Q').hom =
      T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
        T.map (envelopingRepresentativeCoefficientMap O.toCollection s g) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (envelopingCoefficientBlockIso_naturality O.toCollection s g)).trans
        (T.map_comp _ _))
  exact originalRepresentativeSquares _ _ _ _ _ _ _ h
    (envelopingRepresentativeCoefficientSubstitution_naturality O s g)

/-- Actual coefficient and retained-leaf substitution form the
original whole input-choice square. -/
theorem envelopingNormalizedEvaluation_naturality (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map
          (coefficientBlockMap (FintypeCat.of (Option s.inner.index))
            (envelopingSlotCoefficientMap O.toCollection s g))) (envelopingBlockAlgebraMap A s g)) ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection
            s Q').hom ≫
            envelopingRepresentativeCoefficientSubstitution O s Q')
              (envelopingAlgebraLeafIso A s Q').hom) =
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
          envelopingRepresentativeCoefficientSubstitution O s Q) (envelopingAlgebraLeafIso A
            s Q).hom) ≫
        (linearCoefficientDiagram O.toCollection A s.totalProfile).map
          (envelopingTotalAlgebraInputsMap s g) := by
  let T := FiniteTensor.tensor (V := C)
  have h := originalJointCoefficientLeafSquare
    (T.map (coefficientBlockMap (FintypeCat.of (Option s.inner.index))
      (envelopingSlotCoefficientMap O.toCollection s
      g)))
    (T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
      envelopingRepresentativeCoefficientSubstitution O s
      Q)
    (T.map (envelopingCoefficientBlockIso O.toCollection s Q').hom ≫
      envelopingRepresentativeCoefficientSubstitution O s
      Q')
    (O.toCollection.map (extendProfileMap (𝟙 s.totalProfile) (envelopingTotalAlgebraInputsMap s g)))
    (envelopingBlockAlgebraMap A s g) (envelopingAlgebraLeafIso A s Q).hom
    (envelopingAlgebraLeafIso A s Q').hom
    ((addedAlgebraInputs A).map (envelopingTotalAlgebraInputsMap s g))
    (envelopingNormalizedCoefficient_naturality O s g) (envelopingAlgebraLeafIso_naturality A s g)
  exact (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))

/-- The original full weighted tensor evaluation is natural in
every independent root/inner algebra-input choice, including empty profiles. -/
theorem envelopingRepresentativeEvaluation_naturality (O : ColoredOperadObj W C) (A : W → C)
    (s : ColoredSubstitutionData W) {Q Q' : EnvelopingInputChoices s} (g : Q ⟶ Q') :
    (FiniteTensor.tensor (V := C)).map (envelopingWeightedRepresentativeMap O.toCollection A s g) ≫
        envelopingRepresentativeEvaluation O A s Q' =
