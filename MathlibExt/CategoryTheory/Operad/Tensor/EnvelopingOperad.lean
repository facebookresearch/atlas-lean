section EnvelopingSource149


/-!
# Original flat atomic coefficient/input route

The grouped atomic source retains its literal original (i,j) coefficient
positions. Algebra-input leaves retain their exact original dependent-sum
bijection ((i,j),k) ↔ (i,(j,k)), including all empty coefficient/input blocks.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping.Grouping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- The original flattened coefficient/input atomic families retain
every original coefficient position and its original input family. -/
def atomicCombinedIso (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (FiniteFamily.flatten (C := FiniteFamily C)).obj (groupedCoefficientInputTriple N L) ≅
      combinedInputBlocks ((FiniteFamily.flatten (C := C)).obj N).index
        ((FiniteFamily.flatten (C := C)).obj N).obj L :=
  FiniteFamily.isoOfReindex (Equiv.refl (Σ i : N.index, (N.obj i).index)) (fun _ => rfl)

/-- The actual dependent-sum correction retains every original
algebra-input strand at its original nested coefficient position. -/
def atomicLeafEquiv (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (totalBlockInputs ((FiniteFamily.flatten (C := C)).obj N).index L).index ≃
      (groupedCoefficientInputLeaves N L).index where
  toFun p := ⟨p.1.1, ⟨p.1.2, p.2⟩⟩
  invFun p := ⟨⟨p.1, p.2.1⟩, p.2.2⟩
  left_inv p := by rcases p with ⟨⟨i, j⟩, k⟩; rfl
  right_inv p := by rcases p with ⟨i, ⟨j, k⟩⟩; rfl

/-- The actual original dependent leaf bijection preserves every
original heterogeneous input object by its identity component. -/
def atomicLeafIso (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    totalBlockInputs ((FiniteFamily.flatten (C := C)).obj N).index L ≅
      groupedCoefficientInputLeaves N L :=
  FiniteFamily.isoOfReindex (atomicLeafEquiv N L) (fun _ => rfl)

/-- The actual coefficient-family comparison at the flat atomic
positions is the original flattened family itself. -/
def atomicCoefficientIso (N : FiniteFamily (FiniteFamily C)) :
    coefficientBlockFamily ((FiniteFamily.flatten (C := C)).obj N).index
      ((FiniteFamily.flatten (C := C)).obj N).obj ≅ (FiniteFamily.flatten (C := C)).obj N :=
  Iso.refl _

variable [FiniteTensor C]

/-- Actual flatten/map tensor commutation followed by the literal
original (i,j) atomic coefficient/input comparison. -/
def atomicWeightedIso (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).obj (groupedCoefficientInputWeightedBlocks N L) ≅
      weightedInputBlockFamily ((FiniteFamily.flatten (C := C)).obj N).index
        ((FiniteFamily.flatten (C := C)).obj N).obj L :=
  ((FiniteFamily.flattenMapIso (FiniteTensor.tensor (V := C))).app
    (groupedCoefficientInputTriple N L)).symm ≪≫
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).mapIso (atomicCombinedIso N L)

/-- The original flat atomic coefficient/input normalization,
retaining the complete coefficient tensor and actual leaf sigma correction. -/
def flatAtomicNormalization (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.flatten (C := C)).obj (groupedCoefficientInputWeightedBlocks N L)) ⟶
      (coefficientLeafTensorFunctor (groupedCoefficientInputLeaves N L)).obj
        ((FiniteTensor.tensor (V := C)).obj ((FiniteFamily.flatten (C := C)).obj N)) :=
  (FiniteTensor.tensor (V := C)).map (atomicWeightedIso N L).hom ≫
    (coefficientBlockInterchangeTensorIso ((FiniteFamily.flatten (C := C)).obj N).index
      ((FiniteFamily.flatten (C := C)).obj N).obj L).hom ≫
    (FiniteTensor.tensor (V := C)).map
      (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
        C)).obj ((FiniteFamily.flatten (C := C)).obj N)))
        (atomicLeafIso N L).hom)


end CategoryTheory.Operad.Tensor.Enveloping.Grouping

end
end EnvelopingSource149

/- Exact checked source: GroupingComparisonData. -/
section EnvelopingSource150


/-!
# Original atomic and grouped coefficient/input factor comparisons

All original coefficient and input strands are retained through the exact
triple flattening and dependent-leaf corrections. The actual grouped block
normalizer is its original inverse flattening, raw interchange and complete
partitioned coefficient/input normalization.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping.Grouping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- The complete original atomic-to-grouped coefficient/input
permutation is the original flat interchange and exact leaf sigma correction. -/
theorem atomicFactorComparison (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    FiniteFamily.flattenAssocIso.inv.app (groupedCoefficientInputTriple N L) ≫
        (FiniteFamily.flatten (C := C)).map (groupedCoefficientInputRawIso N L).hom ≫
        (partitionedCoefficientLeavesSourceIso N (groupedCoefficientInputs N L)).hom =
      (FiniteFamily.flatten (C := C)).map (atomicCombinedIso N L).hom ≫
        (coefficientBlockInterchangeFamilyIso ((FiniteFamily.flatten (C := C)).obj N).index
          ((FiniteFamily.flatten (C := C)).obj N).obj L).hom ≫
        (FiniteFamily.flatten (C := C)).map
          (coefficientLeavesNestedMap (𝟙 ((FiniteFamily.flatten (C :=
            C)).obj N)) (atomicLeafIso N L).hom) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨⟨i, j⟩, k⟩
    cases k <;> rfl
  · intro p
    rcases p with ⟨⟨i, j⟩, k⟩
    cases k with
    | none => rfl
    | some k => rfl

variable [FiniteTensor C]

/-- The actual grouped block normalization retains exactly the
original inverse block flattening, coefficient/input interchange,
and complete original coefficient-leaf normalization in every block. -/
theorem groupedNormalizationMap_factor (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    groupedCoefficientInputNormalizationMap N L =
      (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).inv.app
        (groupedCoefficientInputTriple N L) ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (groupedCoefficientInputRawIso
          N L).hom ≫
        partitionedCoefficientLeavesNormalizationMap N (groupedCoefficientInputs N L) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    let I := (N.obj i).index
    let K := (N.obj i).obj
    let M := fun j => L ⟨i, j⟩
    let a := (FiniteTensor.flattenIso (V := C)).inv.app (combinedInputBlocks I K M)
    let b := (FiniteTensor.tensor (V := C)).map (coefficientBlockInterchangeFamilyIso I K M).hom
    have h : (coefficientBlockInterchangeTensorIso I K M).hom =
        a ≫ b ≫ coefficientLeavesNormalization (N.obj i) (groupedCoefficientInputs N L i) :=
      congrArg (fun c => a ≫ b ≫ c)
        (coefficientLeavesNormalizationIso_hom (N.obj i) (groupedCoefficientInputs N L i))
    exact heq_of_eq h


end CategoryTheory.Operad.Tensor.Enveloping.Grouping

end
end EnvelopingSource150

/- Exact checked source: GroupingNormalization. -/
section EnvelopingSource151


/-!
# Normalize original grouped coefficient/input tensors to one flat coefficient

Original finite-tensor associativity moves inverse atomic block flattening
through the grouped source. Actual partitioned coefficient normalization
then gives one original flattened coefficient tensor and the original
dependent input family, with all strand maps and empty blocks retained.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping.Grouping

open CategoryTheory

private theorem EnvelopingSource151_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by
  simp only [Functor.map_comp]

private theorem invertedAssociation {V : Type*} [Category* V]
    {A B D E F G : V} (a : A ≅ B) (b : B ≅ D) (r : A ≅ E) (s : E ≅ F)
    (w : F ≅ G) (e : G ≅ D)
    (h : a.hom ≫ b.hom = r.hom ≫ s.hom ≫ w.hom ≫ e.hom) :
    e.hom ≫ b.inv = w.inv ≫ s.inv ≫ r.inv ≫ a.hom := by
  apply (cancel_epi (r ≪≫ s ≪≫ w).hom).1
  have hc := congrArg (· ≫ b.inv) h.symm
  simpa only [Iso.trans_hom, Category.assoc, Iso.hom_inv_id, Iso.hom_inv_id_assoc,
    Category.id_comp, Category.comp_id] using hc

private theorem normalizeFromAssociation {V : Type*} [Category* V]
    {X A B D E F G H K R S : V} (e : X ⟶ A) (bi : A ⟶ B) (g : B ⟶ D) (n : D ⟶ E)
    (d : E ⟶ F) (wi : X ⟶ G) (si : G ⟶ H) (ri : H ⟶ K) (a : K ⟶ B)
    (f : K ⟶ R) (ap : R ⟶ D) (p : R ⟶ S) (q : S ⟶ F)
    (h : e ≫ bi = wi ≫ si ≫ ri ≫ a) (hn : a ≫ g = f ≫ ap)
    (hp : ap ≫ n ≫ d = p ≫ q) :
    e ≫ bi ≫ g ≫ n ≫ d = wi ≫ si ≫ ri ≫ f ≫ p ≫ q := by
  rw [← Category.assoc e bi, h]
  simp only [Category.assoc]
  rw [← Category.assoc a g, hn]
  simp only [Category.assoc]
  rw [hp]

private theorem associateNestedTriple {V : Type*} [Category* V]
    {X A B D E F : V} (p : X ⟶ A) (a : A ⟶ B) (b : B ⟶ D) (c : D ⟶ E) (d : E ⟶ F) :
    p ≫ (a ≫ b ≫ c) ≫ d = p ≫ a ≫ b ≫ c ≫ d := by
  simp only [Category.assoc]

private theorem atomicFromSquares {V : Type*} [Category* V]
    {X A B C D E F G H I J : V} (q : X ⟶ B) (w : X ⟶ A) (m : A ⟶ B)
    (b : B ⟶ C) (i : C ⟶ D) (c : D ⟶ E) (h : E ⟶ F) (a : A ⟶ G) (f : G ⟶ C)
    (j : D ⟶ H) (d : H ⟶ F) (r : G ⟶ I) (u : I ⟶ J) (p : J ⟶ H)
    (hq : q = w ≫ m) (hm : m ≫ b = a ≫ f) (hc : c ≫ h = j ≫ d)
    (hf : f ≫ i ≫ j = r ≫ u ≫ p) :
    q ≫ (b ≫ i ≫ c) ≫ h = w ≫ a ≫ r ≫ u ≫ p ≫ d := by
  rw [hq]
  simp only [Category.assoc]
  rw [← Category.assoc m b, hm]
  simp only [Category.assoc]
  rw [hc]
  simpa only [Category.assoc] using congrArg (fun k => w ≫ a ≫ k ≫ d) hf

private theorem appendSix {V : Type*} [Category* V] {X A B C D E F G : V}
    (r₁ : X ⟶ A) (r₂ : A ⟶ B) (r₃ : B ⟶ C) (r₄ : C ⟶ D) (r₅ : D ⟶ E)
    (n : E ⟶ F) (m : F ⟶ G) :
    r₁ ≫ r₂ ≫ r₃ ≫ r₄ ≫ r₅ ≫ n ≫ m = (r₁ ≫ r₂ ≫ r₃ ≫ r₄ ≫ r₅ ≫ n) ≫ m := by
  simp only [Category.assoc]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The actual grouped block normalizer has the complete original
triple-source correction, one original flat coefficient tensor, and
the original dependent leaf family before its final coefficient flattening. -/
theorem groupedNormalization_raw (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    groupedCoefficientInputNormalization N L =
      (FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.flattenMapIso (FiniteTensor.tensor (V :=
            C))).inv.app (groupedCoefficientInputTriple N L)) ≫
        (FiniteTensor.flattenIso (V := C)).inv.app
          ((FiniteFamily.flatten (C := FiniteFamily C)).obj (groupedCoefficientInputTriple N L)) ≫
        (FiniteTensor.tensor (V := C)).map
          (FiniteFamily.flattenAssocIso.inv.app (groupedCoefficientInputTriple N L)) ≫
        (FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.flatten (C := C)).map (groupedCoefficientInputRawIso N L).hom) ≫
        (FiniteTensor.tensor (V := C)).map
          (partitionedCoefficientLeavesSourceIso N (groupedCoefficientInputs N L)).hom ≫
        coefficientLeavesNormalization ((FiniteFamily.flatten (C :=
          C)).obj N) (groupedCoefficientInputLeaves N L) ≫
        (coefficientLeafTensorFunctor (groupedCoefficientInputLeaves N L)).map
          ((FiniteTensor.flattenIso (V := C)).hom.app N) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let R := groupedCoefficientInputTriple N L
  let G := groupedCoefficientInputs N L
  let P := partitionedCoefficientLeavesTriple N G
  let a := (FiniteTensor.flattenIso (V := C)).app ((FiniteFamily.map F).obj R)
  let b := T.mapIso ((FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).app R)
  let r := T.mapIso (FiniteFamily.flattenAssocIso.app R)
  let s := (FiniteTensor.flattenIso (V := C)).app ((FiniteFamily.flatten (C :=
    FiniteFamily C)).obj R)
  let w := T.mapIso ((FiniteFamily.flattenMapIso T).app R)
  let e := (FiniteTensor.flattenIso (V := C)).app ((FiniteFamily.map (FiniteFamily.map T)).obj R)
  let u := (groupedCoefficientInputRawIso N L).hom
  let g := T.map ((FiniteFamily.map T).map u)
  let f := T.map (F.map u)
  let ap := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.map F).obj P)
  let n := T.map (partitionedCoefficientLeavesNormalizationMap N G)
  let d := (partitionedScalarLeavesDistributionIso N G (fun i => T.obj (N.obj i))).hom
  let p := T.map (partitionedCoefficientLeavesSourceIso N G).hom
  let q := coefficientLeavesNormalization (F.obj N) (groupedCoefficientInputLeaves N L) ≫
    (coefficientLeafTensorFunctor (groupedCoefficientInputLeaves N L)).map
      ((FiniteTensor.flattenIso (V := C)).hom.app N)
  have ha : a.hom ≫ b.hom = r.hom ≫ s.hom ≫ w.hom ≫ e.hom :=
    FiniteTensor.flattenAssocLaw_app_unfold R
  have h := invertedAssociation a b r s w e ha
  have hn : a.hom ≫ g = f ≫ ap := (FiniteTensor.flattenIso (V := C)).hom.naturality u |>.symm
  have hp : ap ≫ n ≫ d = p ≫ q := (partitionedCoefficientLeaves_normalization_distribution N G).symm
  have hm : T.map (groupedCoefficientInputNormalizationMap N L) = b.inv ≫ g ≫ n :=
    (congrArg T.map (groupedNormalizationMap_factor N L)).trans
