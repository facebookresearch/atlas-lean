/-- The actual grouped coefficient/input normalization is precisely
the original flat atomic normalization after the genuine coefficient
flattening inverse, for arbitrary grouped coefficients and heterogeneous
input families, including every empty block and original strand map. -/
theorem normalize_grouped_inputs (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    groupedCoefficientInputNormalization N L ≫
        (coefficientLeafTensorFunctor (groupedCoefficientInputLeaves N L)).map
