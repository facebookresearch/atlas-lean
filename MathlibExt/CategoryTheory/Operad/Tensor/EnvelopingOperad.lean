-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem allUnitInverseComparison {V : Type*} [Category* V]
    {X A B : V} (e : X ≅ B) (f : A ≅ B) (r : X ⟶ A) (h : r ≫ f.hom = e.hom) :
    f.inv = e.inv ≫ r := by
  apply (cancel_mono f.hom).1
  rw [Category.assoc, h, e.inv_hom_id, f.inv_hom_id]

private theorem allUnitTypedSquare {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (r : A ⟶ B) (a : B ⟶ D) (j : D ⟶ Y)
    (q : X ⟶ B) (c : A ⟶ E) (d : E ⟶ D) (b : E ⟶ Y)
    (hp : q = p ≫ r) (hn : r ≫ a = c ≫ d) (hb : d ≫ j = b) :
    q ≫ a ≫ j = p ≫ c ≫ b := by
  rw [hp]
  simp only [Category.assoc]
  rw [← Category.assoc r a, hn]
  simp only [Category.assoc]
  rw [hb]

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The actual insertion into all original tensor-unit factors
is the original frozen prefix on the empty retained coefficient
family, under the exact original unit-position bijection. -/
theorem tensorAllUnitInsertion_frozen (I : FintypeCat.{0}) :
    tensorAllUnitInsertion (C := C) I ≫ (FiniteTensor.tensor (V :=
      C)).map (allUnitFrozenIso (C := C) I).hom =
      (frozenVariableTensorUnitIso I (FiniteFamily.empty : FiniteFamily C)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := frozenVariableBlocks I (FiniteFamily.empty : FiniteFamily C)
  let M := allEmptyTensorBlocks (C := C) I
  let e := frozenVariableFlattenIso I (FiniteFamily.empty : FiniteFamily C)
  let f := allEmptyFlattenIso (C := C) I
  let r := allUnitFrozenBlocksIso (C := C) I
  have hi : f.inv = e.inv ≫ F.map r.hom := allUnitInverseComparison e f (F.map r.hom)
    (allUnitFrozenBlocks_flatten I)
  have hp : T.map f.inv = T.map e.inv ≫ T.map (F.map r.hom) :=
    (congrArg T.map hi).trans (T.map_comp _ _)
  have hn := (FiniteTensor.flattenIso (V := C)).hom.naturality r.hom
  have hb : T.map ((FiniteFamily.map T).map r.hom) ≫ T.map (allUnitFrozenIso (C := C) I).hom =
      T.map (frozenVariableBlockIso I (FiniteFamily.empty : FiniteFamily C)).hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map (allUnitFrozenBlocks_tensor I))
  have h := allUnitTypedSquare (T.map e.inv) (T.map (F.map r.hom))
    ((FiniteTensor.flattenIso (V := C)).hom.app M) (T.map (allUnitFrozenIso (C := C) I).hom)
    (T.map f.inv) ((FiniteTensor.flattenIso (V := C)).hom.app N)
    (T.map ((FiniteFamily.map T).map r.hom))
    (T.map (frozenVariableBlockIso I (FiniteFamily.empty : FiniteFamily C)).hom) hp hn hb
  exact (Category.assoc _ _ _).trans h


end CategoryTheory.Operad.Tensor.Enveloping

