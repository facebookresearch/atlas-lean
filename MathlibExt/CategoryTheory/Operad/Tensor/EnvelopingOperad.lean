profile are the original analytic factors. The coefficient map
retains the actual empty-sum profile comparison; input maps are identities. -/
def nullaryLinearFactorsIso (O : ColoredSymmetricCollection W C) (B : W → C) (d : W) :
    coefficientInputFactors (extendedCoefficient O (ColoredProfile.nullary d))
      (addedAlgebraInputs B) ≅
      inputsToProfile d ⋙ analyticFactors O B :=
  NatIso.ofComponents (fun Q =>
    FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
      | none => O.mapIso (nullaryVariableProfileComponentIso d Q)
      | some i => Iso.refl (B (Q.obj i).as))) (by
    intro Q Q' g
    apply FiniteFamily.Hom_ext
    · ext i
      cases i <;> rfl
    · intro i
      cases i with
      | none =>
        change HEq (O.map ((fixedProfileExtension (ColoredProfile.nullary d)).map g) ≫
          O.map (nullaryVariableProfileHom d Q'))
          (O.map (nullaryVariableProfileHom d Q) ≫
            O.map ((analyticToProfileFunctor W d).map ((inputsToProfile d).map g)))
        exact heq_of_eq ((O.map_comp _ _).symm.trans
