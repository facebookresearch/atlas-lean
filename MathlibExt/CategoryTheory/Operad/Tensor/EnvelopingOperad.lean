/-!
# Actual original outer substitution square for enveloping association
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

private theorem originalOuterCoefficientProfileSquare {V : Type*} [Category* V]
    {X X' Y Y' Z : V} (f : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (g : Y ⟶ Y')
    (b : Y' ⟶ Z) (c : Y ⟶ Z) (h : f ≫ a' = a ≫ g) (hb : g ≫ b = c) :
    f ≫ a' ≫ b = a ≫ c := by
  rw [← Category.assoc f a', h, Category.assoc, hb]

/-- The actual original three-level outer contraction and the
actual representative outer substitution commute through their
original full coefficient/profile map. -/
theorem envelopingAssocOuterSubstitution_naturality (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (ColoredOperadObj.substitutionSource O.toCollection).map (envelopingAssocOuterComparison d Q) ≫
        O.subst.app (envelopingRepresentativeSubstitution d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q)) ≫
        O.toCollection.map (envelopingRepresentativeTotalHom d.outerAfterInnerData
          (envelopingAssocOuterChoices d Q)) =
      O.subst.app (envelopingRepresentativeAssoc d Q).outerAfterInnerData ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) := by
  have hm : O.toCollection.map (ColoredSubstitutionData.totalProfileMap
    (envelopingAssocOuterComparison d Q)) ≫
      O.toCollection.map (envelopingRepresentativeTotalHom d.outerAfterInnerData
        (envelopingAssocOuterChoices d Q)) =
      O.toCollection.map (envelopingAssocTotalHom d Q) :=
    (O.toCollection.map_comp _ _).symm.trans (congrArg O.toCollection.map
      (envelopingAssocOuterComparison_total d Q))
  exact originalOuterCoefficientProfileSquare _ _ _ _ _ _
    (O.subst.naturality (envelopingAssocOuterComparison d Q)) hm


end CategoryTheory.Operad.Tensor.Enveloping

end
