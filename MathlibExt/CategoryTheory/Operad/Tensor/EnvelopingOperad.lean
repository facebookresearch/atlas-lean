/-!
# The actual enveloping operad functor on genuine tensor O-algebras
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem projectionComposition {D : Type*} [Category* D] {LA LB LC A B C : D}
    (πA : LA ⟶ A) (πB : LB ⟶ B) (πC : LC ⟶ C) (f : A ⟶ B) (g : B ⟶ C)
    (lf : LA ⟶ LB) (lg : LB ⟶ LC) (hf : πA ≫ f = lf ≫ πB) (hg : πB ≫ g = lg ≫ πC) :
    πA ≫ (f ≫ g) = (lf ≫ lg) ≫ πC :=
  (Category.assoc πA f g).symm.trans ((congrArg (· ≫ g) hf).trans
    ((Category.assoc lf πB g).trans ((congrArg (lf ≫ ·) hg).trans (Category.assoc lf lg πC).symm)))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original quotient determines the identity enveloping arrow. -/
theorem envelopingOperadMap_id (O : ColoredOperadObj W C) (A : Algebra O) :
    envelopingOperadMap O (𝟙 A) = 𝟙 (envelopingOperad O A) := by
  apply envelopingOperad_hom_ext O A
  let π := envelopingOperadProjection O A
  exact (envelopingOperadMap_projection O (𝟙 A)).trans
    ((congrArg (· ≫ π) (linearCarrierOperadMap_id O A.carrier)).trans
      ((Category.id_comp π).trans (Category.comp_id π).symm))

/-- The full original quotient and original L carrier composition law
determine composition of actual descended enveloping arrows. -/
theorem envelopingOperadMap_comp (O : ColoredOperadObj W C) {A B D : Algebra O} (f : A ⟶
  B) (g : B ⟶ D) :
    envelopingOperadMap O (f ≫ g) = envelopingOperadMap O f ≫ envelopingOperadMap O g := by
  apply envelopingOperad_hom_ext O A
  let πA := envelopingOperadProjection O A
  let πB := envelopingOperadProjection O B
  let πD := envelopingOperadProjection O D
  let lf := linearCarrierOperadMap O f.hom
  let lg := linearCarrierOperadMap O g.hom
  have h : πA ≫ (envelopingOperadMap O f ≫ envelopingOperadMap O g) = (lf ≫ lg) ≫ πD :=
    projectionComposition πA πB πD (envelopingOperadMap O f) (envelopingOperadMap O g) lf lg
      (envelopingOperadMap_projection O f) (envelopingOperadMap_projection O g)
  exact (envelopingOperadMap_projection O (f ≫ g)).trans
    ((congrArg (· ≫ πD) (linearCarrierOperadMap_comp O f.hom g.hom)).trans h.symm)

/-- The original O-algebra and every original O-algebra map produce
the actual original enveloping operad and actual original quotient descent. -/
def envelopingOperadFunctor (O : ColoredOperadObj W C) : Algebra O ⥤ ColoredOperadObj W C where
  obj := envelopingOperad O
  map := envelopingOperadMap O
  map_id := envelopingOperadMap_id O
  map_comp := envelopingOperadMap_comp O

theorem envelopingOperadFunctor_obj (O : ColoredOperadObj W C) (A : Algebra O) :
    (envelopingOperadFunctor O).obj A = envelopingOperad O A := rfl

/-- The actual functor map is literally the original quotient descent
of L(f.hom) followed by the original target projection and derived balance. -/
theorem envelopingOperadFunctor_map (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B) :
    (envelopingOperadFunctor O).map f =
      envelopingOperadDesc O A (linearCarrierOperadMap O f.hom ≫ envelopingOperadProjection O B)
        (envelopingOperadMap_balance O f) := rfl

/-- The full original linear-to-enveloping projection is a natural
transformation on the genuine original tensor algebra category. -/
def envelopingOperadProjectionNat (O : ColoredOperadObj W C) :
    (Algebra.forget O ⋙ linearCarrierOperadFunctor O) ⟶ envelopingOperadFunctor O where
  app := envelopingOperadProjection O
  naturality {_A _B} f := (envelopingOperadMap_projection O f).symm

theorem envelopingOperadProjectionNat_app (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    ((envelopingOperadProjectionNat O).app A).toCollectionHom.app P =
      envelopingCoefficientπ O A P := rfl

/-- Every original O-operation inclusion is a full natural transformation
into the actual enveloping operad functor, with its original full operad arrow. -/
def originalOperadToEnvelopingNat (O : ColoredOperadObj W C) :
    (Functor.const (Algebra O)).obj O ⟶ envelopingOperadFunctor O where
  app := originalOperadToEnveloping O
  naturality {_A _B} f := (Category.id_comp (originalOperadToEnveloping O _)).trans
    (originalOperadToEnveloping_naturality O f).symm

theorem originalOperadToEnvelopingNat_app (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    ((originalOperadToEnvelopingNat O).app A).toCollectionHom.app P =
      originalOperationToEnveloping O A P := rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
