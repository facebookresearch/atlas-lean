namespace CategoryTheory.Operad.Tensor.Enveloping.ZeroVariable

open CategoryTheory

private theorem emptyPrefixFold {V : Type*} [Category* V]
    {X A B D E Y : V} (r : X ≅ A) (a : X ⟶ B) (b : B ⟶ D) (j : D ⟶ A)
    (p : X ⟶ E) (c : E ⟶ Y) (d : Y ⟶ A) (f : B ⟶ Y)
    (h1 : p ≫ c = a ≫ f) (h2 : f ≫ d = b ≫ j) (h3 : p ≫ c ≫ d = r.hom) :
    r.inv ≫ a ≫ b ≫ j = 𝟙 A := by
  have h : a ≫ b ≫ j = r.hom := by
    rw [← h2, ← Category.assoc a f, ← h1]
    exact (Category.assoc p c d).trans h3
  rw [h]
  exact r.inv_hom_id

private theorem emptyPrefixMapTriple {V : Type*} [Category* V] {D : Type*} [Category* D] (T : V ⥤ D)
    {X Y Z : V} (a : X ⟶ Y) (b : Y ⟶ Z) (f : X ⟶ Z) (h : a ≫ b = f) :
    T.map a ≫ T.map b = T.map f :=
  (T.map_comp _ _).symm.trans (congrArg T.map h)


variable {C : Type u} [Category.{v} C]
variable (I : FintypeCat.{0}) [IsEmpty I]

/-- No original tensor-unit position leaves precisely the
original retained coefficient family and its original input bijection. -/
def emptyBlocksIso (L : FiniteFamily C) :
    frozenVariableBlocks I L ≅
      (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj L :=
  FiniteFamily.isoOfComponents (Equiv.emptySum I L.index) (fun p => match p with
    | Sum.inl p => isEmptyElim p
    | Sum.inr _ => Iso.refl _)

variable [FiniteTensor C]

/-- The actual empty-prefix unit/retained family is the original
retained family by the exact original empty-sum position bijection. -/
def emptyUnitIso (L : FiniteFamily C) :
    frozenVariableUnitFamily I L ≅ L :=
  FiniteFamily.isoOfComponents (Equiv.emptySum I L.index) (fun p => match p with
    | Sum.inl p => isEmptyElim p
    | Sum.inr _ => Iso.refl _)

omit [FiniteTensor C] in
/-- The original flattened empty-prefix positions are exactly
the original map-singleton-flatten comparison. -/
theorem emptyBlocks_flatten (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map (emptyBlocksIso I L).hom ≫
        FiniteFamily.mapSingletonFlattenIso.hom.app L =
      (frozenVariableFlattenIso I L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact isEmptyElim i
    | inr i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact isEmptyElim i
    | inr i => cases j; exact heq_of_eq (Category.comp_id _)

/-- The actual empty-prefix singleton tensor maps are the
original map-singleton tensor unitor, with every original retained map. -/
theorem emptyBlocks_tensor (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (emptyBlocksIso I L).hom ≫
        (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app L =
      (frozenVariableBlockIso I L).hom ≫ (emptyUnitIso I L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl p => exact isEmptyElim p
    | inr p => rfl
  · intro p
    cases p with
    | inl p => exact isEmptyElim p
    | inr p =>
      change HEq ((FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C :=
        C)).obj (L.obj p))) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app (L.obj p))
        ((FiniteTensor.singletonIso (V := C)).hom.app (L.obj p) ≫ 𝟙 _)
      exact heq_of_eq (by rw [Functor.map_id, Category.id_comp, Category.comp_id])

/-- The actual no-position tensor-unit prefix is the original
identity tensor map under its exact empty-sum position comparison. -/
theorem emptyPrefix_unit (L : FiniteFamily C) :
    (frozenVariableTensorUnitIso I L).hom ≫
        (FiniteTensor.tensor (V := C)).map (emptyUnitIso I L).hom =
      𝟙 ((FiniteTensor.tensor (V := C)).obj L) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := frozenVariableBlocks I L
  let M := (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj L
  let r := T.mapIso (frozenVariableFlattenIso I L)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let b := T.map (frozenVariableBlockIso I L).hom
  let j := T.map (emptyUnitIso I L).hom
  let p := T.map (F.map (emptyBlocksIso I L).hom)
  let c := (FiniteTensor.flattenIso (V := C)).hom.app M
  let d := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app L)
  let f := T.map ((FiniteFamily.map T).map (emptyBlocksIso I L).hom)
  have h1 : p ≫ c = a ≫ f := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (emptyBlocksIso I L).hom
  have h2 : f ≫ d = b ≫ j :=
    (emptyPrefixMapTriple T _ _ _ (emptyBlocks_tensor I L)).trans (T.map_comp _ _)
  have h3 : p ≫ c ≫ d = r.hom := by
    have hlaw : c ≫ d = T.map (FiniteFamily.mapSingletonFlattenIso.hom.app L) :=
      (mapSingletonFlattenLaw_app L).symm
    exact (congrArg (p ≫ ·) hlaw).trans (emptyPrefixMapTriple T _ _ _ (emptyBlocks_flatten I L))
  have h := emptyPrefixFold r a b j p c d f h1 h2 h3
  have hread : (frozenVariableTensorUnitIso I L).hom = r.inv ≫ (a ≫ b) := rfl
  exact (congrArg (· ≫ j) hread).trans ((Category.assoc r.inv (a ≫ b) j).trans
    ((congrArg (r.inv ≫ ·) (Category.assoc a b j)).trans h))


end CategoryTheory.Operad.Tensor.Enveloping.ZeroVariable

