/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance envelopingRecoveryFiniteTensor : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original genuine algebra is recovered through its actual
original carrier, full O-algebra and A-constant readbacks. -/
theorem envelopingUnderA_roundTrip_algebra (O : ColoredOperadObj W C) (A : Algebra O)
    (M : Algebra (envelopingOperad O A)) :
    underAEnvelopingObject O A (envelopingUnderAObject O A M) = M := by
  let F : Algebra (envelopingOperad O A) := underAEnvelopingObject O A
    (envelopingUnderAObject O A M)
  have hc : F.carrier = M.carrier := envelopingUnderA_roundTrip_carrier O A M
  have hu : linearAlgebraUnderlying O A.carrier (Algebra.restrict
    (envelopingOperadProjection O A) F) =
      linearAlgebraUnderlying O A.carrier (Algebra.restrict (envelopingOperadProjection O A) M) :=
    envelopingUnderA_roundTrip_original O A M
  have hg : HEq (linearAlgebraConstants O A.carrier (Algebra.restrict
    (envelopingOperadProjection O A) F))
      (linearAlgebraConstants O A.carrier (Algebra.restrict (envelopingOperadProjection O A) M)) :=
    heq_of_eq (envelopingUnderA_roundTrip_constants O A M)
  exact @envelopingAlgebra_eq.{uc, u, v, us} W C inferInstance (FiniteTensor.ofSymmetric C)
    inferInstance inferInstance (FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C) O A
      F M hc hu hg


end CategoryTheory.Operad.Tensor.Enveloping

