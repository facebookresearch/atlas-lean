section EnvelopingSource148


/-!
# Finite grouping of original coefficient and heterogeneous input factors
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/-- The complete coefficient/input family at every original
position in every finite block. Empty blocks are retained. -/
def groupedCoefficientInputTriple (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    FiniteFamily (FiniteFamily (FiniteFamily C)) where
  index := N.index
  obj i := combinedInputBlocks (N.obj i).index (N.obj i).obj (fun j => L ⟨i, j⟩)

/-- The original input positions in each original coefficient block. -/
def groupedCoefficientInputs (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    N.index → FiniteFamily C :=
  fun i => totalBlockInputs (N.obj i).index (fun j => L ⟨i, j⟩)

/-- The original coefficient/input blocks are moved to
coefficient-first order inside each finite block, by their exact original bijections. -/
def groupedCoefficientInputRawIso (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (groupedCoefficientInputTriple N L) ≅
      (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj
        (partitionedCoefficientLeavesTriple N (groupedCoefficientInputs N L)) :=
  FiniteFamily.isoOfComponents (Equiv.refl N.index)
    (fun i => coefficientBlockInterchangeFamilyIso
      (N.obj i).index (N.obj i).obj (fun j => L ⟨i, j⟩))

/-- The flat original input indices, with their exact nested block positions. -/
def groupedCoefficientInputLeaves (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) : FiniteFamily C :=
  partitionedLeafFamily N (groupedCoefficientInputs N L)

variable [FiniteTensor C]

/-- Evaluate every original coefficient/input tensor, retaining
the original grouping and every empty input family. -/
def groupedCoefficientInputWeightedBlocks (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    FiniteFamily (FiniteFamily C) :=
  (FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V := C)))).obj
    (groupedCoefficientInputTriple N L)

/-- The actual finite tensor interchange in every original block. -/
def groupedCoefficientInputNormalizationMap (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (groupedCoefficientInputWeightedBlocks N L) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (partitionedCoefficientLeavesEvaluated N (groupedCoefficientInputs N L)) where
  equiv := Equiv.refl N.index
  hom i := (coefficientBlockInterchangeTensorIso
    (N.obj i).index (N.obj i).obj (fun j => L ⟨i, j⟩)).hom

/-- Flatten the actual original weighted source, normalize in
each original block, and collect its original coefficient tensors and original input leaves. -/
def groupedCoefficientInputNormalization (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.flatten (C := C)).obj (groupedCoefficientInputWeightedBlocks N L)) ⟶
      (coefficientLeafTensorFunctor (groupedCoefficientInputLeaves N L)).obj
        ((FiniteTensor.tensor (V := C)).obj ((FiniteFamily.map (FiniteTensor.tensor (V :=
          C))).obj N)) :=
  (FiniteTensor.flattenIso (V := C)).hom.app (groupedCoefficientInputWeightedBlocks N L) ≫
    (FiniteTensor.tensor (V := C)).map (groupedCoefficientInputNormalizationMap N L) ≫
    (partitionedScalarLeavesDistributionIso N (groupedCoefficientInputs N L)
      (fun i => (FiniteTensor.tensor (V := C)).obj (N.obj i))).hom


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource148

