namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem expandedTensorTwoSquares {V : Type*} [Category* V]
    {X A B D E P Y : V} (f : X ⟶ A) (g : A ⟶ B) (h : B ⟶ D) (k : D ⟶ Y)
    (r : X ⟶ E) (s : E ⟶ B) (t : E ⟶ P) (p : P ⟶ D)
    (h1 : f ≫ g = r ≫ s) (h2 : s ≫ h = t ≫ p) :
    f ≫ g ≫ h ≫ k = r ≫ t ≫ p ≫ k := by
  rw [← Category.assoc f g, h1, Category.assoc, ← Category.assoc s h, h2]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual expanded coefficient grouping B contracts
through the original source map and original middle substitution,
retaining all original innermost singleton coefficients. -/
def envelopingAssocExpandedRouteBPrefix (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).obj
        ((FiniteFamily.flatten (C := C)).obj (envelopingAssocExpandedGroupingA
          O.toCollection d Q)) ⟶
      (ColoredOperadObj.substitutionSource O.toCollection).obj
        (envelopingRepresentativeAssoc d Q).innerData :=
  (FiniteTensor.tensor (V := C)).map (envelopingAssocExpandedGroupingIso O.toCollection d Q).hom ≫
    (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocExpandedGroupingB
      O.toCollection d Q) ≫
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.map (FiniteTensor.tensor (V := C))).map
      (envelopingAssocExpandedMapB O d Q)) ≫
    (FiniteTensor.tensor (V := C)).map
      (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom O.toCollection O.subst
      (envelopingRepresentativeAssoc d Q))

/-- The actual expanded coefficient source respects the
original A-to-B operad association tensor regrouping, by the
exact original coefficient square and genuine flatten naturality. -/
theorem envelopingAssocExpandedTensorRouteB (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C :=
      C)).map (envelopingAssocExpandedMapA O d Q)) ≫
        (FiniteTensor.tensor (V := C)).map
          (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom O.toCollection
          (envelopingRepresentativeAssoc d Q)) ≫
        (FiniteTensor.flattenIso (V := C)).hom.app
          (ColoredOperadObj.AssocInsertion.groupingB O.toCollection
            (envelopingRepresentativeAssoc d Q)) ≫
        (FiniteTensor.tensor (V := C)).map
          (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q)) =
      envelopingAssocExpandedRouteBPrefix O d Q := by
  let T := FiniteTensor.tensor (V := C)
  have h1 := (T.map_comp _ _).symm.trans
    ((congrArg T.map (envelopingAssocExpandedCoefficient_square O d Q)).trans (T.map_comp _ _))
  have h2 := (FiniteTensor.flattenIso (V := C)).hom.naturality (envelopingAssocExpandedMapB O d Q)
  exact expandedTensorTwoSquares
    (T.map ((FiniteFamily.flatten (C := C)).map (envelopingAssocExpandedMapA O d Q)))
    (T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom O.toCollection
      (envelopingRepresentativeAssoc d Q)))
    ((FiniteTensor.flattenIso (V := C)).hom.app
      (ColoredOperadObj.AssocInsertion.groupingB O.toCollection
        (envelopingRepresentativeAssoc d Q)))
    (T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom O.toCollection O.subst
      (envelopingRepresentativeAssoc
      d Q)))
    (T.map (envelopingAssocExpandedGroupingIso O.toCollection d Q).hom)
    (T.map ((FiniteFamily.flatten (C := C)).map (envelopingAssocExpandedMapB O d Q)))
    ((FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocExpandedGroupingB
      O.toCollection d Q))
