  let ell := evaluationLeafMap B M.carrier g s Q
  let k := T.map (coefficientLeafMap a₀ ell)
  let f₀ := O.toCollection.map (envelopingRepresentativeTotalHom s Q)
  let ell' := (profileLeafIso M.carrier (envelopingRepresentativeTotalHom s Q)).hom
  let z := T.map (coefficientLeafMap f₀ ell')
