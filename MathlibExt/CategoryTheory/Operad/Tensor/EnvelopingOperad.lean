/- Exact checked source: ReflexiveOperad.Substitution. -/
section EnvelopingSource333


/-!
# Substitution descended from the original full operad maps

The balancing equation is proved from the original f/g map-substitution
equations. The actual common section and the source separate tensor
preservation supply the quotient tensor universal property.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.ColoredOperadObj.Reflexive

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C]
variable {P Q : ColoredOperadObj W C} (f g : P ⟶ Q)

/-- Each quotient unit is the original unit followed by its original coefficient projection. -/
def unit : ColoredOperadUnit (collection f g) :=
  fun c => Q.unit c ≫ coefficientπ f g (ColoredSubstitutionData.unitProfile c)

@[simp]
theorem unit_readback (c : W) :
    unit f g c = Q.unit c ≫ coefficientπ f g (ColoredSubstitutionData.unitProfile c) := rfl

/-- The operadic source comparison is the literal original tensor quotient projection. -/
theorem sourceHom_readback (s : ColoredSubstitutionData W) :
    HomData.sourceHom (collectionπ f g) s = tensorπ f g s.factorFamily := rfl

/-- Original full map-substitution equations give the complete
simultaneous reflexive relation balance. -/
theorem substitution_balance (s : ColoredSubstitutionData W) :
    HomData.sourceHom f.toCollectionHom s ≫ (Q.subst.app s ≫ coefficientπ f g s.totalProfile) =
      HomData.sourceHom g.toCollectionHom s ≫ (Q.subst.app s ≫ coefficientπ f g s.totalProfile) :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ coefficientπ f g s.totalProfile) (f.map_subst s).symm).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (P.subst.app s ≫ ·) (coefficient_condition f g s.totalProfile)).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ coefficientπ f g s.totalProfile) (g.map_subst s)).trans
              (Category.assoc _ _ _))))))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]
variable (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)

/-- The actual quotient substitution map, descended through the original finite tensor
projections. -/
def substitutionApp (s : ColoredSubstitutionData W) :
    (substitutionSource (collection f g)).obj s ⟶ (collection f g).obj s.totalProfile :=
  tensorDesc f g t hf hg s.factorFamily (Q.subst.app s ≫ coefficientπ f g s.totalProfile)
    (substitution_balance f g s)

@[reassoc (attr := simp)]
theorem substitution_readback (s : ColoredSubstitutionData W) :
    HomData.sourceHom (collectionπ f g) s ≫ substitutionApp f g t hf hg s =
      Q.subst.app s ≫ coefficientπ f g s.totalProfile :=
  tensorπ_desc f g t hf hg s.factorFamily _ _

omit [FiniteTensor C] [HasColimitsOfSize.{us, us} C]
  [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
private theorem EnvelopingSource333_compose_squares {X₀ X₁ X₂ Y₀ Y₁ Y₂ : C}
    {a : X₀ ⟶ X₁} {b : X₁ ⟶ X₂} {c : Y₀ ⟶ Y₁} {d : Y₁ ⟶ Y₂}
    {p : X₀ ⟶ Y₀} {q : X₁ ⟶ Y₁} {r : X₂ ⟶ Y₂}
    (hp : p ≫ c = a ≫ q) (hq : q ≫ d = b ≫ r) :
    p ≫ (c ≫ d) = (a ≫ b) ≫ r :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ d) hp).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (a ≫ ·) hq).trans (Category.assoc _ _ _).symm)))

/-- Substitution naturality, including every original profile reindexing,
descends by the actual tensor quotient projection. -/
theorem substitution_naturality {s r : ColoredSubstitutionData W} (k : s ⟶ r) :
    (substitutionSource (collection f g)).map k ≫ substitutionApp f g t hf hg r =
      substitutionApp f g t hf hg s ≫ (substitutionTarget (collection f g)).map k := by
  apply tensor_hom_ext f g t hf hg s.factorFamily
  have hl := EnvelopingSource333_compose_squares (HomData.sourceHom_naturality (collectionπ
    f g) k).symm
    (substitution_readback f g t hf hg r)
  have hr := EnvelopingSource333_compose_squares (substitution_readback f g t hf hg s)
    ((collectionπ f g).naturality (ColoredSubstitutionData.totalProfileFunctor.map k)).symm
