/-!
# The actual grouped target coefficient/leaf normal form
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem groupedCoefficientFuse {D : Type*} [Category* D]
    {X A B E Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ E) (d : E ⟶ Y)
    (k : X ⟶ B) (h : a ≫ b = k) : a ≫ ((b ≫ c) ≫ d) = k ≫ c ≫ d := by
  simp only [Category.assoc]
  rw [← Category.assoc a b, h]

private theorem groupedTargetRouteFiring {D : Type*} [Category* D]
    {X A B C E Y : D} (w : X ⟶ A) (i : A ⟶ B) (e : B ⟶ C) (c : C ⟶ Y)
    (n : X ⟶ E) (a : E ⟶ B) (r : E ⟶ Y) (hi : w ≫ i = n ≫ a) (he : a ≫ e ≫ c = r) :
    w ≫ (i ≫ e) ≫ c = n ≫ r := by
  simp only [Category.assoc]
  rw [← Category.assoc w i, hi]
  simp only [Category.assoc]
  rw [he]

private theorem groupedTargetMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Actual grouped target relabelling, original representative
substitution and original total-input map have precisely their
original full coefficient map and original total B-leaf comparison. -/
theorem groupedTarget_normalization (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (groupedTargetWeightedIso O B P Q R).hom ≫
      envelopingRepresentativeEvaluation O B (shape P Q) (choices P Q R) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
          ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom)) =
    (coefficientBlockInterchangeTensorIso (coefficientGrouping O.toCollection P Q R).index
      (targetCoefficients O P Q R) (targetLeaves O B P Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map (groupedTargetCoefficientIso O P Q R).hom ≫
            envelopingRepresentativeCoefficientSubstitution O (shape P Q) (choices P Q R) ≫
            O.toCollection.map (totalProfileHom P Q R))
          (groupedTargetLeavesIso O B P Q R).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let N := coefficientGrouping O.toCollection P Q R
  let S := shape P Q
  let q := choices P Q R
  let k := coefficientTargetRelabel O P Q R
  let l := inputTargetRelabel O B P Q R
  let e := (coefficientInsertion O P Q R).equiv
  let w := T.map (groupedTargetWeightedIso O B P Q R).hom
  let i := (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option S.inner.index))
    (fun j => O.toCollection.obj (extendProfile (envelopingSlotProfile S j) (q j)))
    (fun j => (addedAlgebraInputs B).obj (q j))).hom
  let n := (coefficientBlockInterchangeTensorIso N.index (targetCoefficients O P Q R)
    (targetLeaves O B P Q R)).hom
  let a₀ := coefficientLeafMap (T.map k) ((FiniteFamily.flatten (C := C)).map l)
  let a := T.map a₀
  let b₀ := coefficientLeafMap
    (T.map (envelopingCoefficientBlockIso O.toCollection S q).hom ≫
      envelopingRepresentativeCoefficientSubstitution O S
      q)
    (envelopingAlgebraLeafIso B S q).hom
  let b := T.map b₀
  let d₀ := coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
    ((addedAlgebraInputs B).map (totalInputsIso
    P Q R).hom)
  let d := T.map d₀
  let coef := T.map (groupedTargetCoefficientIso O P Q R).hom ≫
    envelopingRepresentativeCoefficientSubstitution O S q ≫
      O.toCollection.map (totalProfileHom P Q R)
  let leaf := (groupedTargetLeavesIso O B P Q R).hom
  let r := T.map (coefficientLeafMap coef leaf)
  have hk : coefficientBlockRelabelMap e k.hom = k := rfl
  have hl : inputBlockRelabelMap e l.hom = l := rfl
  have hw : weightedInputBlockRelabelMap e k.hom l.hom = (groupedTargetWeightedIso O B P Q R).hom :=
    groupedTargetWeightedIso_relabel O B P Q R
  have hi : w ≫ i = n ≫ a :=
    (congrArg (fun w => T.map w ≫ i) hw.symm).trans
      ((coefficientBlockInterchangeTensorIso_relabel e k.hom l.hom).trans
        (congrArg₂ (fun k l => n ≫ T.map (coefficientLeafMap (T.map k)
          ((FiniteFamily.flatten (C := C)).map l))) hk hl))
  have hc : T.map k ≫ T.map (envelopingCoefficientBlockIso O.toCollection S q).hom =
      T.map (groupedTargetCoefficientIso O P Q R).hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map (coefficientTargetRelabel_comparison O P Q R))
  have hcoef : T.map k ≫
      ((T.map (envelopingCoefficientBlockIso O.toCollection S q).hom ≫
        envelopingRepresentativeCoefficientSubstitution O
        S q) ≫
        O.toCollection.map (totalProfileHom P Q R)) = coef :=
    groupedCoefficientFuse (T.map k) (T.map (envelopingCoefficientBlockIso O.toCollection S q).hom)
      (envelopingRepresentativeCoefficientSubstitution O S q) (O.toCollection.map
        (totalProfileHom P Q R))
      (T.map (groupedTargetCoefficientIso O P Q R).hom) hc
  have hleaf : (FiniteFamily.flatten (C := C)).map l ≫ (envelopingAlgebraLeafIso B S q).hom ≫
      (addedAlgebraInputs B).map (totalInputsIso P Q R).hom = leaf :=
        inputTargetRelabel_comparison O B P Q R
  have hraw : a₀ ≫ b₀ ≫ d₀ = coefficientLeafMap coef leaf := by
    have hbd : b₀ ≫ d₀ = coefficientLeafMap
        ((T.map (envelopingCoefficientBlockIso O.toCollection S q).hom ≫
          envelopingRepresentativeCoefficientSubstitution
          O S q) ≫
          O.toCollection.map (totalProfileHom P Q R))
        ((envelopingAlgebraLeafIso B S q).hom ≫ (addedAlgebraInputs B).map (totalInputsIso
          P Q R).hom) :=
      coefficientLeafMap_comp
        (T.map (envelopingCoefficientBlockIso O.toCollection S q).hom ≫
          envelopingRepresentativeCoefficientSubstitution
          O S q)
        (O.toCollection.map (totalProfileHom P Q R)) (envelopingAlgebraLeafIso B S q).hom
        ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom)
    exact (congrArg (a₀ ≫ ·) hbd).trans
      ((coefficientLeafMap_comp (T.map k)
        ((T.map (envelopingCoefficientBlockIso O.toCollection S q).hom ≫
          envelopingRepresentativeCoefficientSubstitution
          O S q) ≫
          O.toCollection.map (totalProfileHom P Q R))
        ((FiniteFamily.flatten (C := C)).map l)
        ((envelopingAlgebraLeafIso B S q).hom ≫ (addedAlgebraInputs B).map (totalInputsIso
          P Q R).hom)).trans
        (congrArg₂ (fun c l => coefficientLeafMap c l) hcoef hleaf))
  have he : a ≫ b ≫ d = r := (groupedTargetMapThree T a₀ b₀ d₀).symm.trans (congrArg T.map hraw)
  exact groupedTargetRouteFiring w i b d n a r hi he


