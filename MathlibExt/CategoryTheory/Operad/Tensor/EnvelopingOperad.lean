/- Exact checked source: WeightedNormalization.RightUnitEvaluationNormalization. -/
section EnvelopingSource207


/-!
# Normalize the exact original weighted right-unit evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory

private theorem normalizeRightEval {D : Type*} [Category* D] {A B C E F G : D}
    (w : A ⟶ B) (i : B ⟶ C) (e : C ⟶ E) (p : E ⟶ F)
    (i₀ : A ⟶ G) (n : G ⟶ C) (h : G ⟶ F)
    (hi : w ≫ i = i₀ ≫ n) (hh : n ≫ e ≫ p = h) :
    (w ≫ (i ≫ e)) ≫ p = i₀ ≫ h := by
  calc
    (w ≫ (i ≫ e)) ≫ p = (w ≫ i) ≫ e ≫ p := by simp only [Category.assoc]
    _ = (i₀ ≫ n) ≫ e ≫ p := congrArg (fun f => f ≫ e ≫ p) hi
    _ = i₀ ≫ h := by simpa only [Category.assoc] using congrArg (i₀ ≫ ·) hh

private theorem reassociateRightCoefficient {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ (b ≫ c)) ≫ d = (a ≫ b) ≫ c ≫ d := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Identify the right unit coefficient family with the coefficients indexed by substitution
slots. -/
def rightUnitSlotCoefficientIso (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
  (Q : ColoredInputs W) :
    UnitGeometry.rightCoefficientFamily (O.obj (extendProfile P Q)) P.inputs
        (fun i => O.obj (extendProfile (ColoredSubstitutionData.unitProfile (P.inputColor
          i)) emptyColoredInputs)) ≅
      coefficientBlockFamily (FintypeCat.of (Option P.inputs))
        (fun i => O.obj (extendProfile (envelopingSlotProfile
          (ColoredSubstitutionData.rightUnit P) i)
          (rightUnitChoices P Q i))) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs)) (fun i => match i with
    | none => O.mapIso (asIso (extendProfileMap (ColoredSubstitutionData.rightUnitOuterHom
      P) (𝟙 Q)))
    | some _ => Iso.refl _)

/-- Identify the original root leaves and empty branch blocks with the right unit algebra-input
blocks. -/
def rightUnitLeafBlocksIso (B : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    inputBlockFamily (FintypeCat.of (Option P.inputs)) (UnitGeometry.rightLeaves
      ((addedAlgebraInputs B).obj Q)
      P.inputs) ≅
      inputBlockFamily (FintypeCat.of (Option P.inputs)) (fun i =>
        (addedAlgebraInputs B).obj (rightUnitChoices P Q i))
        :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs)) (fun i => match i with
    | none => Iso.refl _
    | some _ => (emptyAddedAlgebraInputsIso B).symm)

omit [FiniteTensor C] in
theorem rightUnitSlotCoefficientIso_named (O : ColoredSymmetricCollection W C) (P :
  ColoredProfile W) (Q : ColoredInputs
  W) :
    (rightUnitSlotCoefficientIso O P Q).hom ≫
      (envelopingCoefficientBlockIso O (ColoredSubstitutionData.rightUnit P)
        (rightUnitChoices P Q)).hom =
    (rightUnitCoefficientFamilyIso O P Q).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.comp_id _)
    | some i => exact heq_of_eq (Category.id_comp _)

theorem rightUnitWeightedFamilyIso_map (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (rightUnitWeightedFamilyIso O B P Q).hom =
      weightedInputBlockMap (FintypeCat.of (Option P.inputs))
        (K := (UnitGeometry.rightCoefficientFamily (O.obj (extendProfile P Q)) P.inputs
          (fun i => O.obj (extendProfile (ColoredSubstitutionData.unitProfile (P.inputColor i))
            emptyColoredInputs))).obj)
        (K' := fun i => O.obj (extendProfile (envelopingSlotProfile
          (ColoredSubstitutionData.rightUnit P) i)
          (rightUnitChoices P Q i)))
        (L := UnitGeometry.rightLeaves ((addedAlgebraInputs B).obj Q) P.inputs)
        (L' := fun i => (addedAlgebraInputs B).obj (rightUnitChoices P Q i))
        (rightUnitSlotCoefficientIso O P Q).hom.hom (rightUnitLeafBlocksIso B P Q).hom.hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let T := FiniteTensor.tensor (V := C)
      let L := (addedAlgebraInputs B).obj Q
      let f := O.map (extendProfileMap (ColoredSubstitutionData.rightUnitOuterHom P) (𝟙 Q))
      exact heq_of_eq (congrArg T.map (coefficientLeafMap_idLeaves f L)).symm
    | some i => rfl

omit [FiniteTensor C] in
theorem rightUnitInputLeaf_map (B : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteFamily.flatten (C := C)).map (rightUnitLeafBlocksIso B P Q).hom ≫
        (envelopingAlgebraLeafIso B (ColoredSubstitutionData.rightUnit P) (rightUnitChoices
          P Q)).hom) ≫
      (addedAlgebraInputs B).map (rightUnitInputsIso P Q).hom =
    (UnitGeometry.rightLeavesIso ((addedAlgebraInputs B).obj Q) P.inputs).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      let Y := (Discrete.functor B).obj (Q.obj j)
      change HEq ((𝟙 Y ≫ 𝟙 Y) ≫ (Discrete.functor B).map (𝟙 (Q.obj j))) (𝟙 Y)
      exact heq_of_eq ((congrArg ((𝟙 Y ≫ 𝟙 Y) ≫ ·) ((Discrete.functor B).map_id (Q.obj j))).trans
        ((Category.comp_id (𝟙 Y ≫ 𝟙 Y)).trans (Category.id_comp (𝟙 Y))))
    | some i => cases j

/-- The original weighted right coefficient evaluation with both
original total-profile maps is precisely the original coefficient
operation followed by the exact original total root leaf bijection. -/
theorem rightUnitEvaluation_normalized (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteTensor.tensor (V := C)).map (rightUnitWeightedFamilyIso O.toCollection B P Q).hom ≫
        envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.rightUnit P)
          (rightUnitChoices P Q)) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
          (rightUnitInputsIso P
          Q).hom))
        ((addedAlgebraInputs B).map (rightUnitInputsIso P Q).hom)) =
    (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option P.inputs))
        (UnitGeometry.rightCoefficientFamily (O.toCollection.obj (extendProfile P Q)) P.inputs
          (fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
            (P.inputColor i))
            emptyColoredInputs))).obj
        (UnitGeometry.rightLeaves ((addedAlgebraInputs B).obj Q) P.inputs)).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (rightUnitCoefficientFamilyIso O.toCollection P Q).hom ≫
          envelopingRepresentativeCoefficientSubstitution O
            (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P Q)
            ≫
          O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
            (rightUnitInputsIso P
            Q).hom))
        (UnitGeometry.rightLeavesIso ((addedAlgebraInputs B).obj Q) P.inputs).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let s := ColoredSubstitutionData.rightUnit P
  let q := rightUnitChoices P Q
  let I := FintypeCat.of (Option P.inputs)
  let L := (addedAlgebraInputs B).obj Q
  let K := UnitGeometry.rightCoefficientFamily (O.toCollection.obj (extendProfile P Q)) P.inputs
    (fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
      (P.inputColor i))
      emptyColoredInputs))
  let K' := coefficientBlockFamily I (fun i => O.toCollection.obj (extendProfile
    (envelopingSlotProfile s i) (q i)))
  let M := UnitGeometry.rightLeaves L P.inputs
  let M' := fun i => (addedAlgebraInputs B).obj (q i)
  let c := (rightUnitSlotCoefficientIso O.toCollection P Q).hom
  let ℓ := (rightUnitLeafBlocksIso B P Q).hom
  let w := T.map (rightUnitWeightedFamilyIso O.toCollection B P Q).hom
  let i := (coefficientBlockInterchangeTensorIso I K'.obj M').hom
  let i₀ := (coefficientBlockInterchangeTensorIso I K.obj M).hom
  let leaf := (FiniteFamily.flatten (C := C)).map ℓ
  let n := T.map (coefficientLeafMap (T.map c) leaf)
  let a := (envelopingCoefficientBlockIso O.toCollection s q).hom
  let b := envelopingRepresentativeCoefficientSubstitution O s q
  let l := (envelopingAlgebraLeafIso B s q).hom
  let e := T.map (coefficientLeafMap (T.map a ≫ b) l)
  let h := O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom
    P) (rightUnitInputsIso P
    Q).hom)
  let g := (addedAlgebraInputs B).map (rightUnitInputsIso P Q).hom
  let p := T.map (coefficientLeafMap h g)
  let coef := T.map (rightUnitCoefficientFamilyIso O.toCollection P Q).hom ≫ b ≫ h
  let fin := T.map (coefficientLeafMap coef (UnitGeometry.rightLeavesIso L P.inputs).hom)
  have hc : coefficientBlockMap I c.hom = c := rfl
  have hℓ : inputBlockMap I ℓ.hom = ℓ := rfl
  have hn : w ≫ i = i₀ ≫ n :=
    (congrArg (· ≫ i) (congrArg T.map (rightUnitWeightedFamilyIso_map O.toCollection B P Q))).trans
      ((coefficientBlockInterchangeTensorIso_naturality I c.hom ℓ.hom).trans
        (congrArg₂ (fun c l => i₀ ≫ T.map (coefficientLeafMap (T.map c)
          ((FiniteFamily.flatten (C := C)).map l))) hc
          hℓ))
  have hi : T.map c ≫ T.map a = T.map (rightUnitCoefficientFamilyIso O.toCollection P Q).hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map (rightUnitSlotCoefficientIso_named
      O.toCollection P Q))
  have hcoef : (T.map c ≫ (T.map a ≫ b)) ≫ h = coef :=
    (reassociateRightCoefficient (T.map c) (T.map a) b h).trans (congrArg (fun c => c ≫ b ≫ h) hi)
  have hleaf : (leaf ≫ l) ≫ g = (UnitGeometry.rightLeavesIso L P.inputs).hom :=
    rightUnitInputLeaf_map B P Q
  have hfamily : coefficientLeafMap (T.map c) leaf ≫
      coefficientLeafMap (T.map a ≫ b) l ≫ coefficientLeafMap h g =
      coefficientLeafMap coef (UnitGeometry.rightLeavesIso L P.inputs).hom :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ coefficientLeafMap h g) (coefficientLeafMap_comp _ _ _ _)).trans
        ((coefficientLeafMap_comp _ _ _ _).trans
          (congrArg₂ (fun c l => coefficientLeafMap c l) hcoef hleaf)))
  have hf : n ≫ e ≫ p = fin :=
    (congrArg (n ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans (congrArg T.map hfamily))
  exact normalizeRightEval w i e p i₀ n fin hn hf


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
end EnvelopingSource207

/- Exact checked source: WeightedNormalization.LinearRightUnit. -/
section EnvelopingSource208


/-!
# Right unit law of the exact original linear coefficient substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory Limits

private theorem weightRightNormalization {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    ((a ≫ b) ≫ c) ≫ d = a ≫ ((b ≫ c) ≫ d) := by simp only [Category.assoc]

private theorem descendRightUnit {D : Type*} [Category* D] {A B C E F : D}
    (ι : A ⟶ B) (u : B ⟶ C) (s : C ⟶ E) (f : E ⟶ B)
    (w : A ⟶ F) (k : F ⟶ C) {G : D} (e : F ⟶ G) (j : G ⟶ E) (p : G ⟶ A)
    (hi : ι ≫ u = w ≫ k) (hs : k ≫ s = e ≫ j) (hf : j ≫ f = p ≫ ι)
    (hu : (w ≫ e) ≫ p = 𝟙 A) : ι ≫ u ≫ s ≫ f = ι := by
  calc
    ι ≫ u ≫ s ≫ f = (ι ≫ u) ≫ s ≫ f := by simp only [Category.assoc]
    _ = (w ≫ k) ≫ s ≫ f := congrArg (fun i => i ≫ s ≫ f) hi
    _ = (w ≫ e) ≫ j ≫ f := by
      simpa only [Category.assoc] using congrArg (fun i => w ≫ i ≫ f) hs
    _ = (w ≫ e) ≫ (p ≫ ι) := congrArg ((w ≫ e) ≫ ·) hf
    _ = ((w ≫ e) ≫ p) ≫ ι := by simp only [Category.assoc]
    _ = ι := (congrArg (· ≫ ι) hu).trans (Category.id_comp ι)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Complete original weighted right-unit evaluation is the identity
on its original coefficient and every original heterogeneous input,
including empty inputs, after the exact original total-profile maps. -/
theorem rightUnitWeightedEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (rightUnitWeightedInsertion O B P Q ≫
        envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.rightUnit P)
          (rightUnitChoices P Q)) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
          (rightUnitInputsIso P
          Q).hom))
        ((addedAlgebraInputs B).map (rightUnitInputsIso P Q).hom)) =
    𝟙 ((linearCoefficientDiagram O.toCollection B P).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let L := (addedAlgebraInputs B).obj Q
  let U := coefficientLeafTensorFunctor L
  let Y := fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
    (P.inputColor i))
    emptyColoredInputs)
  let K := UnitGeometry.rightCoefficientFamily X P.inputs Y
  let w := UnitInsertion.rightInsertFromFactor (U.obj X) P.inputs
    (UnitGeometry.rightWeightedFactor X L P.inputs Y
    (rightUnitCoefficient O P))
  let b := T.map (rightUnitWeightedFamilyIso O.toCollection B P Q).hom
  let e := envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.rightUnit P)
    (rightUnitChoices P Q)
  let p := T.map (coefficientLeafMap
    (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
      (rightUnitInputsIso P Q).hom))
    ((addedAlgebraInputs B).map (rightUnitInputsIso P Q).hom))
  let i := (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option P.inputs)) K.obj
    (UnitGeometry.rightLeaves L
    P.inputs)).hom
  let a := UnitInsertion.rightInsertFromFactor X P.inputs
    (UnitGeometry.rightCoefficientFactor X P.inputs Y
    (rightUnitCoefficient O P))
  let c := T.map (rightUnitCoefficientFamilyIso O.toCollection P Q).hom ≫
    envelopingRepresentativeCoefficientSubstitution O (ColoredSubstitutionData.rightUnit P)
      (rightUnitChoices P Q) ≫
    O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
      (rightUnitInputsIso P Q).hom)
  let q := T.map (coefficientLeafMap (𝟙 (T.obj K)) (UnitGeometry.rightLeavesIso L P.inputs).hom)
  let d := T.map (coefficientLeafMap c (UnitGeometry.rightLeavesIso L P.inputs).hom)
  have hn : (b ≫ e) ≫ p = i ≫ d := rightUnitEvaluation_normalized O B P Q
  have hp : w ≫ i ≫ d = (w ≫ i ≫ q) ≫ U.map c :=
    UnitGeometry.interchangeSourcePostCoefficient (FintypeCat.of (Option P.inputs)) K.obj
      (UnitGeometry.rightLeaves L P.inputs) w c (UnitGeometry.rightLeavesIso L P.inputs).hom
  have hq : (w ≫ i) ≫ q = U.map a := UnitGeometry.rightWeightedPrefix_coherence X L
    P.inputs Y (rightUnitCoefficient O
    P)
  have hc : a ≫ c = 𝟙 X := (Category.assoc a (T.map (rightUnitCoefficientFamilyIso
    O.toCollection P Q).hom)
    (envelopingRepresentativeCoefficientSubstitution O (ColoredSubstitutionData.rightUnit P)
      (rightUnitChoices P Q) ≫
      O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
        (rightUnitInputsIso P
        Q).hom))).symm.trans
        (rightRepresentativeCoefficient_unit O P Q)
  exact (weightRightNormalization w b e p).trans
    ((congrArg (w ≫ ·) hn).trans
      (hp.trans ((congrArg (· ≫ U.map c) (Category.assoc w i q).symm).trans
        ((congrArg (· ≫ U.map c) hq).trans
          ((U.map_comp a c).symm.trans ((congrArg U.map hc).trans (U.map_id X)))))))

end CategoryTheory.Operad.Tensor.Enveloping.Linear

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The original no-added-input O-unit is a genuine right unit for
the literal original linear coefficient natural substitution, proved
on every original coefficient colimit leg with all original maps retained. -/
theorem envelopingLinearSubstitution_right_unit (O : ColoredOperadObj W C) (B : W → C) :
    ColoredOperadObj.IsRightUnit (linearCoefficientCollection O.toCollection B)
      (envelopingLinearUnit O B)
      (envelopingLinearSubstitutionMap O B) := by
  intro P
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  apply colimit.hom_ext
  intro Q
  let T := FiniteTensor.tensor (V := C)
  let L := linearCoefficientCollection O.toCollection B
  let q := Linear.rightUnitChoices P Q
  let ι := linearCoefficientι O.toCollection B P Q
  let u := ColoredOperadObj.rightUnitInsert L (envelopingLinearUnit O B) P
  let s := envelopingLinearSubstitution O B (ColoredSubstitutionData.rightUnit P)
  let f := L.map (ColoredSubstitutionData.rightUnitTotalHom P)
  let w := Linear.rightUnitWeightedInsertion O B P Q
  let k := T.map (Linear.representativeCofanMap O.toCollection B
    (ColoredSubstitutionData.rightUnit P) q)
  let e := envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.rightUnit P) q
  let j := linearCoefficientι O.toCollection B (ColoredSubstitutionData.rightUnit P).totalProfile
    (envelopingTotalAlgebraInputs (ColoredSubstitutionData.rightUnit P) q)
  let p := T.map (coefficientLeafMap
    (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.rightUnitTotalHom P)
      (Linear.rightUnitInputsIso P
      Q).hom))
    ((addedAlgebraInputs B).map (Linear.rightUnitInputsIso P Q).hom))
  have hi : ι ≫ u = w ≫ k := Linear.rightUnitWeightedInsertion_ι O B P Q
  have hs : k ≫ s = e ≫ j := Linear.representativeCofanMap_β O B
    (ColoredSubstitutionData.rightUnit P) q
  have hf : j ≫ f = p ≫ ι := (linearCoefficientι_joint O.toCollection B
    (ColoredSubstitutionData.rightUnitTotalHom P)
    (Linear.rightUnitInputsIso P Q).hom).symm
  have hu : (w ≫ e) ≫ p = 𝟙 _ := Linear.rightUnitWeightedEvaluation O B P Q
  exact (Linear.descendRightUnit ι u s f w k e j p hi hs hf hu).trans (Category.comp_id ι).symm


end CategoryTheory.Operad.Tensor.Enveloping

end
