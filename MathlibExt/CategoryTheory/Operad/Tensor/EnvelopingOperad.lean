/- Exact checked source: WeightedNormalization.RootTensorSplitting. -/
section EnvelopingSource272


/-!
# Genuine finite tensor regrouping with an arbitrary root family and arbitrary branch evaluations
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.RootTensor

open CategoryTheory

private theorem mapThreeRootTensor {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem rootSplitSquareFiring {D : Type*} [Category* D]
    {Z A B C E F G H J K L M N P : D}
    (u : Z ⟶ A) (fInv : A ⟶ C) (a : B ⟶ C) (eInv : Z ⟶ B) (eHom : B ⟶ Z)
    (b : C ⟶ E) (r : B ⟶ F) (c : F ⟶ E) (d : E ⟶ H) (d' : F ⟶ G)
    (m : G ⟶ H) (z : H ⟶ J) (q : J ⟶ K) (x : G ⟶ L) (h : L ⟶ K)
    (eOut : K ⟶ N) (v : L ⟶ M) (hMap : M ⟶ N) (first : N ⟶ P) (jMap : Z ⟶ M) (direct : A ⟶ P)
    (hu : u ≫ fInv = eInv ≫ a) (hab : a ≫ b = r ≫ c) (hcd : c ≫ d = d' ≫ m)
    (hm : m ≫ z ≫ q = x ≫ h) (hout : h ≫ eOut = v ≫ hMap)
    (hassoc : r ≫ d' ≫ x ≫ v = eHom ≫ jMap) (he : eInv ≫ eHom = 𝟙 Z)
    (hfinal : jMap ≫ hMap ≫ first = u ≫ direct) :
    u ≫ (fInv ≫ b ≫ d ≫ z ≫ q ≫ eOut ≫ first) = u ≫ direct := by
  calc
    u ≫ (fInv ≫ b ≫ d ≫ z ≫ q ≫ eOut ≫ first) = (u ≫ fInv) ≫ b ≫ d ≫ z
      ≫ q ≫ eOut ≫ first := by simp only
      [Category.assoc]
    _ = (eInv ≫ a) ≫ b ≫ d ≫ z ≫ q ≫ eOut ≫ first := congrArg (· ≫ b ≫ d ≫ z ≫ q ≫ eOut ≫ first) hu
    _ = eInv ≫ (a ≫ b) ≫ d ≫ z ≫ q ≫ eOut ≫ first := by simp only [Category.assoc]
    _ = eInv ≫ (r ≫ c) ≫ d ≫ z ≫ q ≫ eOut ≫ first := congrArg (fun a => eInv
      ≫ a ≫ d ≫ z ≫ q ≫ eOut ≫ first) hab
    _ = eInv ≫ r ≫ (c ≫ d) ≫ z ≫ q ≫ eOut ≫ first := by simp only [Category.assoc]
    _ = eInv ≫ r ≫ (d' ≫ m) ≫ z ≫ q ≫ eOut ≫ first := congrArg (fun a => eInv
      ≫ r ≫ a ≫ z ≫ q ≫ eOut ≫ first) hcd
    _ = eInv ≫ r ≫ d' ≫ (m ≫ z ≫ q) ≫ eOut ≫ first := by simp only [Category.assoc]
    _ = eInv ≫ r ≫ d' ≫ (x ≫ h) ≫ eOut ≫ first := congrArg (fun a => eInv ≫ r
      ≫ d' ≫ a ≫ eOut ≫ first) hm
    _ = eInv ≫ r ≫ d' ≫ x ≫ (h ≫ eOut) ≫ first := by simp only [Category.assoc]
    _ = eInv ≫ r ≫ d' ≫ x ≫ (v ≫ hMap) ≫ first := congrArg (eInv ≫ r ≫ d' ≫ x ≫ · ≫ first) hout
    _ = eInv ≫ (r ≫ d' ≫ x ≫ v) ≫ hMap ≫ first := by simp only [Category.assoc]
    _ = eInv ≫ (eHom ≫ jMap) ≫ hMap ≫ first := congrArg (fun a => eInv ≫ a ≫ hMap ≫ first) hassoc
    _ = (eInv ≫ eHom) ≫ jMap ≫ hMap ≫ first := by simp only [Category.assoc]
    _ = jMap ≫ hMap ≫ first := by rw [he, Category.id_comp]
    _ = u ≫ direct := hfinal

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Collapse singleton root tensors and evaluate each retained branch tensor. -/
def splitEvaluation (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) (Y : I → C)
    (f : ∀ i, (FiniteTensor.tensor (V := C)).obj (M i) ⟶ Y i) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (splitGroups I L M) ⟶
      atomicOutputs I L Y where
  equiv := Equiv.refl (L.index ⊕ I)
  hom i := match i with
    | Sum.inl i => (FiniteTensor.singletonIso (V := C)).hom.app (L.obj i)
    | Sum.inr i => f i

/-- Evaluate the root tensor and collapse the singleton branch output tensors. -/
def rootOutputEvaluation (I : FintypeCat.{0}) (L : FiniteFamily C) (X : C) (Y : I → C)
    (f : (FiniteTensor.tensor (V := C)).obj L ⟶ X) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rootOutputGroups I L Y) ⟶
      targetFamily I X Y where
  equiv := Equiv.refl (Option I)
  hom i := match i with | none => f | some i => (FiniteTensor.singletonIso (V := C)).hom.app (Y i)

/-- Evaluate the root and branch tensors independently at their original slots. -/
def directEvaluation (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I →
  FiniteFamily C) (X : C) (Y : I → C)
    (f : (FiniteTensor.tensor (V := C)).obj L ⟶ X) (g : ∀ i, (FiniteTensor.tensor (V :=
      C)).obj (M i) ⟶ Y i) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (sourceGroups I L M) ⟶
      targetFamily I X Y where
  equiv := Equiv.refl (Option I)
  hom i := match i with | none => f | some i => g i

/-- Collapse the refined root singleton tensors and apply each branch evaluation inside its
singleton block. -/
def fineOutputMap (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I → FiniteFamily C) (Y : I → C)
    (f : ∀ i, (FiniteTensor.tensor (V := C)).obj (M i) ⟶ Y i) :
    (FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V :=
      C)))).obj (refinedGroups I L M) ⟶ rootOutputGroups I
      L Y where
  equiv := Equiv.refl (Option I)
  hom i := match i with
    | none => (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app L
    | some i => (FiniteFamily.singleton (C := C)).map (f i)

theorem fineEvaluationRaw_square (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I →
  FiniteFamily C) (Y : I → C)
    (f : ∀ i, (FiniteTensor.tensor (V := C)).obj (M i) ⟶ Y i) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (fineFlattenIso I L M).hom ≫
      splitEvaluation I L M Y f ≫
      (regroupOutputIso I L Y).hom =
    (FiniteFamily.flattenMapIso (FiniteTensor.tensor (V := C))).hom.app (refinedGroups I L M) ≫
      (FiniteFamily.flatten (C := C)).map (fineOutputMap I L M Y f) := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with | none => rfl | some i => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      let X := L.obj j
      let S := (FiniteFamily.singleton (C := C)).obj X
      let z := (FiniteTensor.singletonIso (V := C)).hom.app X
      change HEq (T.map (𝟙 S) ≫ z ≫ 𝟙 X) (𝟙 (T.obj S) ≫ z)
      exact heq_of_eq ((congrArg (· ≫ z ≫ 𝟙 X) (T.map_id S)).trans (congrArg (𝟙
        (T.obj S) ≫ ·) (Category.comp_id z)))
    | some i =>
      cases j
      change HEq (T.map (𝟙 (M i)) ≫ f i ≫ 𝟙 (Y i)) (𝟙 (T.obj (M i)) ≫ f i)
      exact heq_of_eq ((congrArg (· ≫ f i ≫ 𝟙 (Y i)) (T.map_id (M i))).trans
        (congrArg (𝟙 (T.obj (M i)) ≫ ·) (Category.comp_id (f i))))

theorem nestedFinal_square (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I →
  FiniteFamily C) (X : C) (Y : I → C)
    (f : (FiniteTensor.tensor (V := C)).obj L ⟶ X) (g : ∀ i, (FiniteTensor.tensor (V :=
      C)).obj (M i) ⟶ Y i) :
    (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app (refinedGroups I L M) ≫
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (fineOutputMap I L M Y g) ≫
        rootOutputEvaluation I L X Y f =
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (localFlattenIso I L M).hom ≫
      directEvaluation I L M X Y f g
      := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      let N := (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj L
      let a := (FiniteTensor.flattenIso (V := C)).hom.app N
      let b := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app L)
      let c := T.map (FiniteFamily.mapSingletonFlattenIso.hom.app L)
      change HEq (a ≫ b ≫ f) (c ≫ f)
      exact heq_of_eq ((Category.assoc a b f).symm.trans (congrArg (· ≫
        f) (mapSingletonFlattenLaw_app L).symm))
    | some i =>
      let N := (FiniteFamily.singleton (C := FiniteFamily C)).obj (M i)
      let a := (FiniteTensor.flattenIso (V := C)).hom.app N
      let b := T.map ((FiniteFamily.singleton (C := C)).map (g i))
      let c := (FiniteTensor.singletonIso (V := C)).hom.app (Y i)
      let s := (FiniteTensor.singletonIso (V := C)).hom.app (T.obj (M i))
      let q := T.map (FiniteFamily.singletonFlattenIso.hom.app (M i))
      have hn : b ≫ c = s ≫ g i := (FiniteTensor.singletonIso (V := C)).hom.naturality (g i)
      have hf : a ≫ s = q := (singletonFlattenLaw_app (M i)).symm
      change HEq (a ≫ b ≫ c) (q ≫ g i)
      exact heq_of_eq ((congrArg (a ≫ ·) hn).trans ((Category.assoc a s (g i)).symm.trans
        (congrArg (· ≫ g i) hf)))

/-- Splitting the root tensor into its original singleton coefficients,
evaluating arbitrary original branches, regrouping the root, and evaluating
that root is the tensor of the original block evaluations. Only actual finite tensor laws
are used. -/
theorem rootSplitTensor (I : FintypeCat.{0}) (L : FiniteFamily C) (M : I →
  FiniteFamily C) (X : C) (Y : I → C)
    (f : (FiniteTensor.tensor (V := C)).obj L ⟶ X) (g : ∀ i, (FiniteTensor.tensor (V :=
      C)).obj (M i) ⟶ Y i) :
    (FiniteTensor.flattenIso (V := C)).inv.app (sourceGroups I L M) ≫
      (FiniteTensor.tensor (V := C)).map (sourceToSplitIso I L M).hom ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (splitGroups I L M) ≫
      (FiniteTensor.tensor (V := C)).map (splitEvaluation I L M Y g) ≫
      (FiniteTensor.tensor (V := C)).map (regroupOutputIso I L Y).hom ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (rootOutputGroups I L Y) ≫
        (FiniteTensor.tensor (V := C)).map (rootOutputEvaluation I L X Y f) =
      (FiniteTensor.tensor (V := C)).map (directEvaluation I L M X Y f g) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let Q := refinedGroups I L M
  let A := (FiniteFamily.map F).obj Q
  let B := (FiniteFamily.flatten (C := FiniteFamily C)).obj Q
  let C' := (FiniteFamily.map (FiniteFamily.map T)).obj Q
  let localIso := localFlattenIso I L M
  let fineIso := fineFlattenIso I L M
  let hFam := fineOutputMap I L M Y g
  let uIso := T.mapIso ((FiniteFamily.map T).mapIso localIso)
  let e := (FiniteTensor.flattenIso (V := C)).app A
  let fInv := (FiniteTensor.flattenIso (V := C)).inv.app (sourceGroups I L M)
  let a := T.map (F.map localIso.hom)
  let b := T.map (sourceToSplitIso I L M).hom
  let r := T.map (FiniteFamily.flattenAssocIso.hom.app Q)
  let c := T.map (F.map fineIso.hom)
  let d := (FiniteTensor.flattenIso (V := C)).hom.app (splitGroups I L M)
  let d' := (FiniteTensor.flattenIso (V := C)).hom.app B
  let m := T.map ((FiniteFamily.map T).map fineIso.hom)
  let z := T.map (splitEvaluation I L M Y g)
  let q := T.map (regroupOutputIso I L Y).hom
  let x := T.map ((FiniteFamily.flattenMapIso T).hom.app Q)
  let h := T.map (F.map hFam)
  let eOut := (FiniteTensor.flattenIso (V := C)).hom.app (rootOutputGroups I L Y)
  let v := (FiniteTensor.flattenIso (V := C)).hom.app C'
  let hMap := T.map ((FiniteFamily.map T).map hFam)
  let first := T.map (rootOutputEvaluation I L X Y f)
  let jMap := T.map ((FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app Q)
  let direct := T.map (directEvaluation I L M X Y f g)
  have hu : uIso.hom ≫ fInv = e.inv ≫ a := (FiniteTensor.flattenIso (V :=
    C)).inv.naturality localIso.hom
  have hab : a ≫ b = r ≫ c := (T.map_comp _ _).symm.trans ((congrArg T.map (rawTriangle
    I L M)).trans (T.map_comp _ _))
  have hcd : c ≫ d = d' ≫ m := (FiniteTensor.flattenIso (V := C)).hom.naturality fineIso.hom
  have hm : m ≫ z ≫ q = x ≫ h := (mapThreeRootTensor T _ _ _).symm.trans
    ((congrArg T.map (fineEvaluationRaw_square I L M Y g)).trans (T.map_comp _ _))
  have hout : h ≫ eOut = v ≫ hMap := (FiniteTensor.flattenIso (V := C)).hom.naturality hFam
  have hassoc : r ≫ d' ≫ x ≫ v = e.hom ≫ jMap := (FiniteTensor.flattenAssocLaw_app_unfold Q).symm
  have hfinal : jMap ≫ hMap ≫ first = uIso.hom ≫ direct := (mapThreeRootTensor T _ _ _).symm.trans
    ((congrArg T.map (nestedFinal_square I L M X Y f g)).trans (T.map_comp _ _))
  exact (cancel_epi uIso.hom).1 (rootSplitSquareFiring uIso.hom fInv a e.inv e.hom b r c d
    d' m z q x h eOut v hMap
    first jMap direct
    hu hab hcd hm hout hassoc e.inv_hom_id hfinal)


