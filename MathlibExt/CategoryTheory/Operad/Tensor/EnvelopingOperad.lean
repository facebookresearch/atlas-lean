/- Exact checked source: UnitWeightedComparison. -/
section EnvelopingSource289


/-!
# Exact scalar-distribution comparison with frozen weighted normalization

The original scalar and analytic branch factor presentations are compared
on every original input. Their exact dependent-sum leaf bijections and the
original coefficient/leaf normalization square give the full comparison.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

open CategoryTheory

private theorem normalizationFrameFromSquares {C : Type*} [Category* C]
    {A B B0 D E F F0 H H0 : C}
    (w : A ⟶ B) (r : A ⟶ B0) (h : B0 ⟶ B) (q : B ⟶ D)
    (q0 : B0 ⟶ E) (t : E ⟶ D) (s : D ⟶ F) (m : F ⟶ F0)
    (np : F ⟶ H) (k : H ⟶ H0) (nt : F0 ⟶ H0) (z : E ⟶ F0)
    (hw : w = r ≫ h) (hq : h ≫ q = q0 ≫ t) (hn : np ≫ k = m ≫ nt)
    (hz : t ≫ s ≫ m = z) :
    (w ≫ (q ≫ s ≫ np)) ≫ k = r ≫ q0 ≫ z ≫ nt := by
  simp only [Category.assoc]
  rw [hw]
  simp only [Category.assoc]
  rw [← Category.assoc h q, hq]
  simp only [Category.assoc]
  rw [hn]
  rw [← Category.assoc s m nt, ← Category.assoc t (s ≫ m) nt, hz]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Retain the original empty-root and unary branch factor maps in
the actual scalar-leaf nested family. -/
def nestedFrameIso (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    frozenWeightedNestedFamily O.toCollection B P Q (unaryBranches Q) ≅
      partitionedScalarLeaves (UnitInsertion.rightNestedFamily (O.toCollection.obj
        (extendProfile P Q)) Q.index)
        (prefixLeaves B Q) (scalarCoefficients O P Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => (emptyLeafFamilyIso (O.toCollection.obj (extendProfile P Q))).symm
    | some j => unaryFactorIso O B (Q.obj j).as)

/-- The scalar family comparison uses exactly the original frozen
root singleton inverse and the original branch factor comparisons. -/
theorem scalarFrameFamilyMap_factor (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    scalarFrameFamilyMap O B P Q =
      (frozenWeightedRootIso O.toCollection B P Q (unaryBranches Q)).hom ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (nestedFrameIso O B P Q).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => rfl
    | some j =>
      change HEq ((FiniteTensor.tensor (V := C)).map (unaryFactorIso O B (Q.obj j).as).hom)
        (𝟙 _ ≫ (FiniteTensor.tensor (V := C)).map (unaryFactorIso O B (Q.obj j).as).hom)
      exact heq_of_eq (Category.id_comp _).symm

/-- The original partitioned leaves map through their original Q
presentation to the exact original dependent unary input family. -/
def prefixLeafToUnaryMap (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    partitionedLeafFamily (UnitInsertion.rightNestedFamily (O.toCollection.obj
      (extendProfile P Q)) Q.index)
        (prefixLeaves B Q) ⟶ frozenAlgebraLeaves B Q (unaryBranches Q) :=
  (prefixLeafIso (O.toCollection.obj (extendProfile P Q)) B Q).hom ≫
    (addedAlgebraInputs B).map (unaryTotalInputsIso Q).inv

/-- The exact original Q-to-unary-input map is retained after
the actual inverse leaf-partition comparison. -/
theorem prefixLeafToUnaryMap_factor (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (prefixLeafIso (O.toCollection.obj (extendProfile P Q)) B Q).inv ≫
        prefixLeafToUnaryMap O B P Q = (addedAlgebraInputs B).map (unaryTotalInputsIso Q).inv := by
  exact (prefixLeafIso (O.toCollection.obj (extendProfile P Q)) B Q).inv_hom_id_assoc _

/-- Every original nested frame map preserves the original objects
and exact original branch/input bijections. -/
theorem nestedFrameIso_fibers_identity (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ∀ i, ((nestedFrameIso O B P Q).hom.hom i).HasIdentityComponents := by
  intro i
  cases i with
  | none =>
    apply FiniteFamily.Hom.HasIdentityComponents.iso_inv
      (emptyLeafFamilyIso (O.toCollection.obj (extendProfile P Q)))
    intro i
    cases i with
    | none => exact ⟨rfl, rfl⟩
    | some e => cases e
  | some j =>
    intro i
    cases i <;> exact ⟨rfl, rfl⟩

/-- The actual leaf map consists solely of the original color
transports on its exact original input bijection. -/
theorem prefixLeafToUnaryMap_identity (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (prefixLeafToUnaryMap O B P Q).HasIdentityComponents := by
  have hp : (prefixLeafIso (O.toCollection.obj (extendProfile P Q)) B
    Q).hom.HasIdentityComponents :=
    FiniteFamily.isoOfReindex_identityComponents _ _
  have hq : (unaryTotalInputsIso Q).inv.HasIdentityComponents :=
    FiniteFamily.isoOfReindex_inv_identityComponents _ _
  exact hp.comp (hq.map (Discrete.functor B))

/-- The exact original root/coefficient/leaf reindexing agrees
with the original frozen branch-to-leaf bijection on every input. -/
theorem nestedFrame_leaf_square (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).map (nestedFrameIso O B P Q).hom ≫
      (partitionedScalarLeavesIso
        (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index)
        (prefixLeaves B Q) (scalarCoefficients O P Q)).hom ≫
      (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (𝟙 (frozenCoefficientFamily O.toCollection P Q
          (unaryBranches Q)))
          (prefixLeafToUnaryMap O B P Q)) =
    (frozenBranchLeafIso O.toCollection B P Q (unaryBranches Q)).hom := by
  apply FiniteFamily.Hom.ext_identityComponents
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i =>
      cases j with
      | none => rfl
      | some j => cases j; rfl
  · exact (FiniteFamily.Hom.HasIdentityComponents.flatten_fibers
      (nestedFrameIso_fibers_identity O B P Q)).comp
      ((FiniteFamily.isoOfReindex_identityComponents _ _).comp
        (FiniteFamily.Hom.HasIdentityComponents.flatten_fibers
          (coefficientLeavesNestedMap_fibers_identity (FiniteFamily.Hom.hasIdentityComponents_id _)
            (prefixLeafToUnaryMap_identity O B P Q))))
  · exact FiniteFamily.isoOfReindex_identityComponents _ _

/-- Actual scalar distribution and its original leaf map give the
existing frozen weighted tensor normalization, retaining every map. -/
theorem scalarDistribution_frozen_normalization (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteTensor.tensor (V := C)).map (scalarFrameFamilyMap O B P Q) ≫
      (partitionedScalarLeavesDistributionIso
        (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index)
        (prefixLeaves B Q) (scalarCoefficients O P Q)).hom) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V :=
          C)).obj (frozenCoefficientFamily O.toCollection P Q
          (unaryBranches Q))))
          (prefixLeafToUnaryMap O B P Q)) =
    (frozenBranchTensorNormalizationIso O.toCollection B P Q (unaryBranches Q)).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index
  let M := partitionedScalarLeaves N (prefixLeaves B Q) (scalarCoefficients O P Q)
  let M0 := frozenWeightedNestedFamily O.toCollection B P Q (unaryBranches Q)
  let K := frozenCoefficientFamily O.toCollection P Q (unaryBranches Q)
  let L := partitionedLeafFamily N (prefixLeaves B Q)
  let L0 := frozenAlgebraLeaves B Q (unaryBranches Q)
  let l := prefixLeafToUnaryMap O B P Q
  let w := T.map (scalarFrameFamilyMap O B P Q)
  let r := T.map (frozenWeightedRootIso O.toCollection B P Q (unaryBranches Q)).hom
  let h := T.map ((FiniteFamily.map T).map (nestedFrameIso O B P Q).hom)
  let q := (FiniteTensor.flattenIso (V := C)).inv.app M
  let q0 := (FiniteTensor.flattenIso (V := C)).inv.app M0
  let t := T.map (F.map (nestedFrameIso O B P Q).hom)
  let s := T.map (partitionedScalarLeavesIso N (prefixLeaves B Q) (scalarCoefficients O P Q)).hom
  let m := T.map (F.map (coefficientLeavesNestedMap (𝟙 K) l))
  let np := coefficientLeavesNormalization K L
  let nt := coefficientLeavesNormalization K L0
  let k := T.map (coefficientLeafMap (𝟙 (T.obj K)) l)
  let z := T.map (frozenBranchLeafIso O.toCollection B P Q (unaryBranches Q)).hom
  have hw : w = r ≫ h := (congrArg T.map (scalarFrameFamilyMap_factor O B P Q)).trans
    (T.map_comp _ _)
  have hq : h ≫ q = q0 ≫ t := (FiniteTensor.flattenIso (V :=
    C)).inv.naturality (nestedFrameIso O B P Q).hom
  have hn : np ≫ k = m ≫ nt :=
    (congrArg (fun a => np ≫ T.map (coefficientLeafMap a l)) (T.map_id K)).symm.trans
      (coefficientLeavesNormalization_naturality (𝟙 K) l).symm
  have hz : t ≫ s ≫ m = z :=
    (congrArg (t ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans (congrArg T.map (nestedFrame_leaf_square O B P Q)))
  have hp := normalizationFrameFromSquares w r h q q0 t s m np k nt z hw hq hn hz
  have hs : (partitionedScalarLeavesDistributionIso N (prefixLeaves B Q) (scalarCoefficients
    O P Q)).hom = q ≫ s ≫ np :=
    partitionedScalarLeavesDistributionIso_hom N (prefixLeaves B Q) (scalarCoefficients O P Q)
  have hf : (frozenBranchTensorNormalizationIso O.toCollection B P Q (unaryBranches Q)).hom
    = r ≫ q0 ≫ z ≫ nt := by
    simp only [frozenBranchTensorNormalizationIso, Iso.trans_hom, Functor.mapIso_hom, Iso.symm_hom,
      Iso.app_inv, coefficientLeavesNormalizationIso_hom]
    rfl
  exact (congrArg (fun a => (w ≫ a) ≫ k) hs).trans (hp.trans hf.symm)


end CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

end
end EnvelopingSource289

/- Exact checked source: UnitWeightedPrefixFusion. -/
section EnvelopingSource290


/-!
# Full original weighted unary-input prefix fusion

The actual branchwise empty/singleton prefixes and original unit maps
normalize to the actual original Q-unit coefficient insertion. The exact
original Q-to-dependent-unary-input leaf bijection remains in the equality.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

open CategoryTheory

private theorem prefixDistributionFromSquares {C : Type*} [Category* C]
    {X A B D E F G : C}
    (a : X ⟶ A) (p : A ⟶ B) (n : B ⟶ D) (k : D ⟶ G)
    (a0 : A ⟶ E) (b : E ⟶ F) (d : F ⟶ G) (i : X ⟶ F) (r : X ⟶ G)
    (hp : p ≫ n ≫ k = a0 ≫ b ≫ d) (ha : a ≫ p ≫ n ≫ k = r) (hb : a ≫ a0 ≫ b = i) :
    i ≫ d = r := by
  rw [← hb]
  simp only [Category.assoc]
  rw [← hp, ha]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original weighted input prefixes and exact scalar-frame
distribution give the actual original Q-unit coefficient insertion. -/
theorem unaryWeighted_scalar_prefix_fusion (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
      (FiniteTensor.tensor (V := C)).map (scalarFrameFamilyMap O B P Q)) ≫
      (partitionedScalarLeavesDistributionIso
        (UnitInsertion.rightNestedFamily (O.toCollection.obj (extendProfile P Q)) Q.index)
        (prefixLeaves B Q) (scalarCoefficients O P Q)).hom =
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (unaryCoefficientUnitInsertion O P Q)
          (prefixLeafIso (O.toCollection.obj (extendProfile P Q)) B Q).inv) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let N := UnitInsertion.rightNestedFamily X Q.index
  let L := prefixLeaves B Q
  let K := scalarCoefficients O P Q
  let g := (unaryCoefficientUnitFactorMap O P Q).hom
  let a := T.map (rawPrefixSourceMap X B Q)
  let p := T.map (partitionedCoefficientLeavesSourceIso N L).hom
  let n := coefficientLeavesNormalization ((FiniteFamily.flatten (C :=
    C)).obj N) (partitionedLeafFamily N L)
  let k := (coefficientLeafTensorFunctor (partitionedLeafFamily N L)).map
    ((FiniteTensor.flattenIso (V := C)).hom.app N ≫ T.map (unaryCoefficientUnitFactorMap O P Q))
  let a0 := (FiniteTensor.flattenIso (V := C)).hom.app (rawPrefixBlocks X B Q)
  let b := T.map (partitionedCoefficientLeavesActionMap N L K g)
  let d := (partitionedScalarLeavesDistributionIso N L K).hom
  let i := T.map (unaryWeightedInputMap O B P Q) ≫ T.map (scalarFrameFamilyMap O B P Q)
  let r := T.map (coefficientLeafMap (unaryCoefficientUnitInsertion O P Q) (prefixLeafIso X
    B Q).inv)
  have hg : partitionedCoefficientMap N K g = unaryCoefficientUnitFactorMap O P Q := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      rfl
  have hp : p ≫ n ≫ k = a0 ≫ b ≫ d := by
    have h := partitionedCoefficientLeaves_action N L K g
    rw [hg] at h
    exact h
  have ha : a ≫ p ≫ n ≫ k = r := rawPrefix_full_coefficient_normalization O B P Q
  have h0 : a ≫ a0 = T.map (rawPrefixTensorFamilyMap X B Q) := rawPrefixSource_tensor_prefix X B Q
  have h1 : T.map (rawPrefixTensorFamilyMap X B Q) ≫ b = i :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (rawPrefix_scalar_frame O B P Q)).trans (T.map_comp _ _))
  have hb : a ≫ a0 ≫ b = i :=
    (Category.assoc a a0 b).symm.trans ((congrArg (· ≫ b) h0).trans h1)
  exact prefixDistributionFromSquares a p n k a0 b d i r hp ha hb

/-- Actual weighted unary-input insertion fuses with the original
frozen tensor normalization to the actual original Q-unit coefficient
insertion and exact original dependent-unary-input algebra-leaf map.
Every original profile, color and empty input family is retained. -/
theorem unaryWeightedInputMap_prefix_fusion (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
      (frozenBranchTensorNormalizationIso O.toCollection B P Q (unaryBranches Q)).hom =
    (FiniteTensor.tensor (V := C)).map
      (coefficientLeafMap (unaryCoefficientUnitInsertion O P Q)
        ((addedAlgebraInputs B).map (unaryTotalInputsIso Q).inv)) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let K := frozenCoefficientFamily O.toCollection P Q (unaryBranches Q)
  let a := T.map (unaryWeightedInputMap O B P Q)
  let w := T.map (scalarFrameFamilyMap O B P Q)
  let d := (partitionedScalarLeavesDistributionIso (UnitInsertion.rightNestedFamily X Q.index)
    (prefixLeaves B Q) (scalarCoefficients O P Q)).hom
  let l0 := (prefixLeafIso X B Q).inv
  let l1 := prefixLeafToUnaryMap O B P Q
  let l := (addedAlgebraInputs B).map (unaryTotalInputsIso Q).inv
  let u := unaryCoefficientUnitInsertion O P Q
  let k := T.map (coefficientLeafMap (𝟙 (T.obj K)) l1)
  have hn : (w ≫ d) ≫ k = (frozenBranchTensorNormalizationIso O.toCollection B P Q
    (unaryBranches Q)).hom :=
    scalarDistribution_frozen_normalization O B P Q
  have hp : (a ≫ w) ≫ d = T.map (coefficientLeafMap u l0) :=
    unaryWeighted_scalar_prefix_fusion O B P Q
  have hl : l0 ≫ l1 = l := prefixLeafToUnaryMap_factor O B P Q
  have hmap : coefficientLeafMap u l0 ≫ coefficientLeafMap (𝟙 (T.obj K)) l1 =
    coefficientLeafMap u l :=
    (coefficientLeafMap_comp u (𝟙 (T.obj K)) l0 l1).trans
      ((congrArg (fun f => coefficientLeafMap f (l0 ≫ l1)) (Category.comp_id u)).trans
        (congrArg (fun h => coefficientLeafMap u h) hl))
  have h1 : a ≫ (frozenBranchTensorNormalizationIso O.toCollection B P Q (unaryBranches Q)).hom =
      ((a ≫ w) ≫ d) ≫ k :=
    (congrArg (a ≫ ·) hn).symm.trans
      ((Category.assoc a (w ≫ d) k).symm.trans
        (congrArg (· ≫ k) (Category.assoc a w d).symm))
  have h2 : T.map (coefficientLeafMap u l0) ≫ k = T.map (coefficientLeafMap u l) :=
    (T.map_comp _ _).symm.trans (congrArg T.map hmap)
  exact h1.trans ((congrArg (· ≫ k) hp).trans h2)


end CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

end
end EnvelopingSource290

/- Exact checked source: UnitActionLaw. -/
section EnvelopingSource291


/-!
# The full original coefficient substitution unit and reflexivity

Actual weighted prefix fusion and the original operad right-unit law prove
the complete original coefficient action unit. The established rooted and
outer colimit beta rules retain every original injection and empty profile.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original weighted unary evaluation is the complete original
coefficient/input identity after its exact total-input sigma-unit map. -/
theorem unaryWeightedEvaluation_unit (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
        frozenWeightedBranchEvaluation O B P Q (unaryBranches Q)) ≫
        (linearCoefficientDiagram O.toCollection B P).map (unaryTotalInputsIso Q).hom =
      𝟙 ((linearCoefficientDiagram O.toCollection B P).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  let i := T.map (unaryWeightedInputMap O B P Q)
  let n := (frozenBranchTensorNormalizationIso O.toCollection B P Q (unaryBranches Q)).hom
  let e := (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q (unaryBranches Q))).map
    (frozenPartialSubstitution O P Q (unaryBranches Q))
  let s := (linearCoefficientDiagram O.toCollection B P).map (unaryTotalInputsIso Q).hom
  let m := T.map (coefficientLeafMap (Weighted.unaryCoefficientUnitInsertion O P Q)
    ((addedAlgebraInputs B).map (unaryTotalInputsIso Q).inv))
  have hf : i ≫ n = m := Weighted.unaryWeightedInputMap_prefix_fusion O B P Q
  have hu : m ≫ e ≫ s = 𝟙 ((linearCoefficientDiagram O.toCollection B P).obj Q) :=
    unitCoefficientLeafEvaluation O B P Q
  exact (congrArg (· ≫ s) (Category.assoc i n e).symm).trans
    ((congrArg (fun q => (q ≫ e) ≫ s) hf).trans ((Category.assoc m e s).trans hu))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original weighted unary coefficient/input choice reads
back to precisely its original linear-coefficient injection. -/
theorem unaryWeightedEvaluation_ι (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
        frozenWeightedBranchEvaluation O B P Q (unaryBranches Q) ≫
        linearCoefficientι O.toCollection B P (frozenTotalInputs Q (unaryBranches Q)) =
      linearCoefficientι O.toCollection B P Q := by
  let a := (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q)
  let b := frozenWeightedBranchEvaluation O B P Q (unaryBranches Q)
  let k := a ≫ b
  let l := (linearCoefficientDiagram O.toCollection B P).map (unaryTotalInputsIso Q).hom
  let i := linearCoefficientι O.toCollection B P Q
