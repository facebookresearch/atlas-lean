          ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (envelopingAssocFlatInnerMap d Q) =
      envelopingAssocExpandedContractionMap O d Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      have h := congrArg (fun f => ((FiniteTensor.tensor (V :=
        C)).map (envelopingAssocExpandedMiddleMap O d Q) ≫
        O.subst.app (envelopingRepresentativeAssoc d Q).middleData) ≫ O.toCollection.map f)
        (envelopingAssocFlatInnerMap_outer d Q)
      exact heq_of_eq ((Category.assoc _ _ _).symm.trans
        (h.trans (expandedMapTwo O.toCollection
          ((FiniteTensor.tensor (V := C)).map (envelopingAssocExpandedMiddleMap O d Q) ≫
            O.subst.app (envelopingRepresentativeAssoc d Q).middleData)
          (envelopingAssocMiddleTotalHom d Q)
          (envelopingRepresentativeOuterHom d.innerData (envelopingAssocInnerChoices d Q)) |>.trans
            (expandedRootAssociate _ _ _ _))))
    | some p =>
      exact heq_of_eq (expandedSingletonAfterMap (envelopingAssocExpandedInnerMap O d Q p)
        (O.toCollection.map ((envelopingAssocFlatInnerFamilyMap d Q).hom p)))


end CategoryTheory.Operad.Tensor.Enveloping

