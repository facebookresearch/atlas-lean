/- Exact checked source: ReflexiveOperad.FrozenAlgebraEvaluation. -/
section EnvelopingSource241


/-!
# Genuine algebra substitution evaluates the actual frozen nullary coefficient contraction
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The genuine original M substitution law identifies the original
frozen coefficient contraction and original operation with all original
Q nullary evaluations inserted in their original extended-profile slots. -/
theorem partial_evaluation (E : ColoredOperadObj W C) (M : Algebra E) (P : ColoredProfile W)
  (Q : ColoredInputs W) :
    coefficientLeavesNormalization (coefficients E.toCollection P Q) (profileLeafFamily
      M.carrier P) ≫
      (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
        (frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫ E.toCollection.map
          (Linear.Constants.totalProfileHom P Q)) ≫
        (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
          M.operations.app P.outputColor (profileInputs P) =
    (FiniteTensor.tensor (V := C)).map (evaluatedFactors E M P Q) ≫
      M.operations.app P.outputColor (profileInputs (extendProfile P Q)) := by
  let a := (frozenVariableTensorUnitIso P.inputs (raw E.toCollection M.carrier P Q)).hom
  let i := (FiniteTensor.tensor (V := C)).map (inputFactor E M.carrier P Q)
  have h : a ≫ i ≫ algebraSubstitutionInner M.operations (datum P Q) =
      a ≫ i ≫ operadSubstitutionInputs E M.carrier (datum P Q) ≫
        M.operations.app P.outputColor (profileInputs (datum P Q).totalProfile) :=
    congrArg (a ≫ i ≫ ·) (M.substitution (datum P Q))
  exact (coefficientRoute E M P Q).symm.trans (h.symm.trans (innerRoute E M P Q))

/-- The literal normalized coefficient/variable source has the same
genuine original algebra evaluation, through the original tensor normalizer inverse. -/
theorem partial_evaluation_normalized (E : ColoredOperadObj W C) (M : Algebra E) (P :
  ColoredProfile W) (Q :
  ColoredInputs W) :
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
        (frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫ E.toCollection.map
          (Linear.Constants.totalProfileHom P Q)) ≫
        (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
          M.operations.app P.outputColor (profileInputs P) =
    (coefficientLeavesNormalizationIso (coefficients E.toCollection P Q) (profileLeafFamily
      M.carrier P)).inv ≫
      (FiniteTensor.tensor (V := C)).map (evaluatedFactors E M P Q) ≫
        M.operations.app P.outputColor (profileInputs (extendProfile P Q)) := by
  let n := coefficientLeavesNormalizationIso (coefficients E.toCollection P Q)
    (profileLeafFamily M.carrier P)
  let r := (FiniteTensor.tensor (V := C)).map (evaluatedFactors E M P Q) ≫
    M.operations.app P.outputColor (profileInputs (extendProfile P Q))
  apply (cancel_epi n.hom).1
  have h : n.hom ≫
      (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
        (frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫ E.toCollection.map
          (Linear.Constants.totalProfileHom P Q)) ≫
        (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
          M.operations.app P.outputColor (profileInputs
          P) = r :=
    (congrArg (fun z => z ≫
      (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
        (frozenPartialSubstitution E P Q (Linear.Constants.branches Q) ≫ E.toCollection.map
          (Linear.Constants.totalProfileHom P Q)) ≫
        (profileCoefficientLeafTensorIso E.toCollection M.carrier P).hom ≫
          M.operations.app P.outputColor (profileInputs
          P))
      (coefficientLeavesNormalizationIso_hom (coefficients E.toCollection P Q)
        (profileLeafFamily M.carrier P))).trans
        (partial_evaluation E M P Q)
  exact h.trans (n.hom_inv_id_assoc r).symm


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

end
