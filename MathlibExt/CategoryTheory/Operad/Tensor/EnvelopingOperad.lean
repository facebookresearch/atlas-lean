/- Exact checked source: EnvelopingAssociativityRootFirstProfiles. -/
section EnvelopingSource063


/-!
# Original root-first representative profiles with all retained algebra inputs
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u}

/-- The original middle substitution with each branch's actual
middle algebra inputs and the original root algebra family. -/
def envelopingAssocMiddleRepresentative (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    ColoredSubstitutionData W :=
  envelopingRepresentativeSubstitution d.middleData (envelopingAssocMiddleChoices d Q)

/-- The actual full three-level middle shape and the original
middle representative share their exact original inner-input positions. -/
def envelopingAssocMiddleProfileInnerMap (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).middleData.inner ⟶
      (envelopingAssocMiddleRepresentative d Q).inner where
  equiv := Equiv.refl (d.branches.index ⊕ Q.root.index)
  hom i := match i with
    | Sum.inl i => ColoredProfile.Hom.symm (envelopingRepresentativeOuterHom (d.localData i)
      (Q.branch i))
    | Sum.inr _ => 𝟙 _

/-- The genuine middle substitution map retains all original
root output colors and original variable/algebra input positions. -/
def envelopingAssocMiddleProfileMap (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).middleData ⟶ envelopingAssocMiddleRepresentative d Q where
  outputColor_eq := rfl
  innerHom := envelopingAssocMiddleProfileInnerMap d Q

/-- The actual middle root coefficient comparison retains the
original root algebra inputs and each original branch output. -/
theorem envelopingAssocMiddleProfileMap_outer (d : ColoredAssocData W) (Q :
  EnvelopingAssocChoices d) :
    envelopingAssocRootHom d Q ≫ ColoredSubstitutionData.outerProfileMap
      (envelopingAssocMiddleProfileMap d Q) =
      envelopingRepresentativeOuterHom d.middleData (envelopingAssocMiddleChoices d Q) := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The actual three-level middle total inputs keep each
original branch variable/middle-algebra input and root unary input. -/
def envelopingAssocMiddleTotalEquiv (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).middleData.totalProfile.inputs ≃
      d.middleData.totalProfile.inputs ⊕ (envelopingAssocInnerRootInputs d Q).index where
  toFun p := match p with
    | ⟨Sum.inl i, Sum.inl j⟩ => Sum.inl ⟨i, j⟩
    | ⟨Sum.inl i, Sum.inr j⟩ => Sum.inr (Sum.inr ⟨i, j⟩)
    | ⟨Sum.inr j, _⟩ => Sum.inr (Sum.inl j)
  invFun p := match p with
    | Sum.inl ⟨i, j⟩ => ⟨Sum.inl i, Sum.inl j⟩
    | Sum.inr (Sum.inl j) => ⟨Sum.inr j, PUnit.unit⟩
    | Sum.inr (Sum.inr ⟨i, j⟩) => ⟨Sum.inl i, Sum.inr j⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j <;> rfl
    | inr i => cases j; rfl
  right_inv p := by
    cases p with
    | inl p => rfl
    | inr p => cases p <;> rfl

/-- The actual original middle total profile comparison,
preserving every original branch/algebra color and root output. -/
def envelopingAssocMiddleTotalHom (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingRepresentativeAssoc d Q).middleData.totalProfile ⟶
      extendProfile d.middleData.totalProfile (envelopingAssocInnerRootInputs d Q) where
  inputEquiv := envelopingAssocMiddleTotalEquiv d Q
  inputColor_eq p := by
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => cases j <;> rfl
    | inr i => rfl
  outputColor_eq := rfl

/-- The actual middle representative total profile map is the
original middle variable/algebra input bijection. -/
def envelopingAssocMiddleAlgebraMap (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingTotalAlgebraInputs d.middleData (envelopingAssocMiddleChoices d Q) ⟶
      envelopingAssocInnerRootInputs d Q where
  equiv := Equiv.refl (Q.root.index ⊕ (Σ i : d.branches.index, (Q.branch i none).index))
  hom p := match p with
    | Sum.inl _ => 𝟙 _
    | Sum.inr _ => 𝟙 _

/-- The actual middle representative total profile map is the
original middle variable/algebra input bijection. -/
theorem envelopingAssocMiddleProfileMap_total (d : ColoredAssocData W) (Q :
  EnvelopingAssocChoices d) :
    ColoredSubstitutionData.totalProfileMap (envelopingAssocMiddleProfileMap d Q) ≫
        envelopingRepresentativeTotalHom d.middleData (envelopingAssocMiddleChoices d Q) ≫
        extendProfileMap (𝟙 d.middleData.totalProfile) (envelopingAssocMiddleAlgebraMap d Q) =
      envelopingAssocMiddleTotalHom d Q := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with
  | inl i => cases j <;> rfl
  | inr i => rfl


end CategoryTheory.Operad.Tensor.Enveloping

end
