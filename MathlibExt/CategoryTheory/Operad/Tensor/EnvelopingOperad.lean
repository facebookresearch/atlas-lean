/- Exact checked source: NullaryWeightedGeometry. -/
section EnvelopingSource298


/-!
# Original weighted source and leaf maps at the nullary variable profile
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root coefficient comparison on the actual
weighted branch source, with every original inner tensor retained. -/
def weightedMap (O : ColoredSymmetricCollection W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    frozenWeightedBranchFamily O B (ColoredProfile.nullary d) Q
        (rootedFrozenBranches (ColoredProfile.nullary d) Q R) ⟶
      (slotInputFactorsFunctor O B ((inputsToProfile d).obj Q)).obj R where
  equiv := Equiv.refl (Option Q.index)
  hom p := match p with
    | none => O.map (nullaryVariableProfileHom d Q)
    | some j => 𝟙 ((analyticSummand O B).obj (R (some j)))

/-- The same original root coefficient map before tensoring
the singleton root and every original inner coefficient/input block. -/
def nestedMap (O : ColoredSymmetricCollection W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedNestedFamily O B (ColoredProfile.nullary d) Q R ⟶
      nestedOperationFactors O B (tupleSubstitutionShape ((inputsToProfile d).obj Q) R) where
  equiv := Equiv.refl (Option Q.index)
  hom p := match p with
    | none => (FiniteFamily.singleton (C := C)).map (O.map (nullaryVariableProfileHom d Q))
    | some j => 𝟙 ((analyticFactors O B).obj (R j))

/-- The original complete algebra leaf family has precisely the
same retained dependent positions in ordinary substitution. -/
def leafIso (B : W → C) (d : W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenAlgebraLeaves B Q R ≅
      profileLeafFamily B (tupleSubstitutionShape ((inputsToProfile d).obj Q) R).totalProfile :=
  FiniteFamily.isoOfComponents (Equiv.refl (Σ j : Q.index, (R j).inputs)) (fun _ => Iso.refl _)

/-- The original root singleton tensor comparison commutes with
the original empty-profile coefficient map and every inner tensor. -/
theorem weightedCoefficientFrame (O : ColoredSymmetricCollection W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    weightedMap O B d Q R ≫ (coefficientTensorIso O B ((inputsToProfile d).obj Q) R).hom =
      (frozenWeightedRootIso O B (ColoredProfile.nullary d) Q
          (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).hom ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map
          (nestedMap O B d Q (rootedFrozenBranches (ColoredProfile.nullary d) Q R)) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro p
    cases p with
    | none =>
      let f := O.map (nullaryVariableProfileHom d Q)
      change HEq (f ≫ (FiniteTensor.singletonIso (V := C)).inv.app _)
        ((FiniteTensor.singletonIso (V := C)).inv.app _ ≫
          (FiniteTensor.tensor (V := C)).map ((FiniteFamily.singleton (C := C)).map f))
      exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).inv.naturality f)
    | some j =>
      change HEq (𝟙 _ ≫ 𝟙 _) (𝟙 _ ≫
        (FiniteTensor.tensor (V := C)).map (𝟙 ((analyticFactors O B).obj (R (some j)))))
      exact heq_of_eq (congrArg (𝟙 _ ≫ ·) ((FiniteTensor.tensor (V := C)).map_id _)).symm

omit [FiniteTensor C] in
/-- The actual original nested-source coefficient/leaf bijection
commutes with the original coefficient map and complete original
dependent leaf map, including every empty inner profile. -/
theorem nestedCoefficientLeafSquare (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteFamily.flatten (C := C)).map (nestedMap O B d Q R) ≫
        (substitutionToLeavesIso O B (tupleSubstitutionShape ((inputsToProfile d).obj Q) R)).hom =
      (frozenBranchLeafIso O B (ColoredProfile.nullary d) Q R).hom ≫
        (FiniteFamily.flatten (C := C)).map
          (coefficientLeavesNestedMap (coefficientHom O d Q R) (leafIso B d Q R).hom) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j
      let f := O.map (nullaryVariableProfileHom d Q)
      change HEq (f ≫ 𝟙 _ ≫ 𝟙 _ ≫ 𝟙 _) (𝟙 _ ≫ f)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | some i =>
      cases j with
      | none =>
        let X := O.obj (R i).toColoredProfile
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])
      | some j =>
        let X := B ((R i).inputColor j)
        change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

omit [FiniteTensor C] in
/-- The original nullary linear-factor comparison is the exact
original coefficient/leaf map followed by its original full-profile
factor comparison, with no change of an input object. -/
theorem targetFactors (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (nullaryLinearFactorsIso O B d).hom.app (frozenTotalInputs Q R) =
      coefficientLeafMap (O.map (nullaryVariableProfileHom d (frozenTotalInputs Q R)))
          (leafIso B d Q R).hom ≫
        (profileOperationFactorsIso O B (tupleSubstitutionShape ((inputsToProfile d).obj Q)
          R).totalProfile).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p <;> rfl
  · intro p
    cases p with
    | none => exact heq_of_eq (Category.comp_id _).symm
    | some p => exact heq_of_eq (Category.id_comp _).symm


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource298

/- Exact checked source: NullaryWeightedNormalization. -/
section EnvelopingSource299


/-!
# Exact original nullary weighted-source normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory

private theorem originalTensorFourSquares {V : Type*} [Category* V]
    {X X' A A' B B' D D' Z Z' : V}
    (l : X ⟶ X') (p : X ⟶ A) (p' : X' ⟶ A') (f : A ⟶ A')
    (q : A ⟶ B) (q' : A' ⟶ B') (g : B ⟶ B')
    (r : B ⟶ D) (r' : B' ⟶ D') (h : D ⟶ D')
    (t : D ⟶ Z) (t' : D' ⟶ Z') (k : Z ⟶ Z')
    (h1 : l ≫ p' = p ≫ f) (h2 : f ≫ q' = q ≫ g)
    (h3 : g ≫ r' = r ≫ h) (h4 : h ≫ t' = t ≫ k) :
    l ≫ p' ≫ q' ≫ r' ≫ t' = p ≫ q ≫ r ≫ t ≫ k := by
  rw [← Category.assoc l p', h1]
  simp only [Category.assoc]
  rw [← Category.assoc f q', h2]
  simp only [Category.assoc]
  rw [← Category.assoc g r', h3]
  simp only [Category.assoc]
  rw [h4]

private theorem originalAssembledFour {V : Type*} [Category* V]
    {X A B D E Y : V} (l : X ⟶ A) (p : A ⟶ B) (q : B ⟶ D)
    (r : D ⟶ E) (t : E ⟶ Y) :
    l ≫ (p ≫ q) ≫ r ≫ t = l ≫ p ≫ q ≫ r ≫ t := by simp only [Category.assoc]

private theorem originalAppendFour {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (q : A ⟶ B) (r : B ⟶ D)
    (t : D ⟶ E) (k : E ⟶ Y) :
    (p ≫ q ≫ r ≫ t) ≫ k = p ≫ q ≫ r ≫ t ≫ k := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original nullary weighted source, ordinary assembly and
ordinary complete coefficient/leaf normalization are precisely the
original frozen source normalizer followed by the actual coefficient
and leaf comparison. Every original slot and inner profile is retained. -/
theorem weightedNormalization (O : ColoredSymmetricCollection W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    (FiniteTensor.tensor (V := C)).map (weightedMap O B d Q R) ≫
        profileSubstitutionAssemblyMap O B ((inputsToProfile d).obj Q) R ≫
        (FiniteTensor.tensor (V := C)).map
          (substitutionToLeavesIso O B
            (tupleSubstitutionShape ((inputsToProfile d).obj Q)
              (rootedFrozenBranches (ColoredProfile.nullary d) Q R))).hom ≫
        coefficientLeavesNormalization
          ((ColoredOperadObj.substitutionFactors O).obj
            (tupleSubstitutionShape ((inputsToProfile d).obj Q)
              (rootedFrozenBranches (ColoredProfile.nullary d) Q R)))
          (profileLeafFamily B
            (tupleSubstitutionShape ((inputsToProfile d).obj Q)
              (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).totalProfile) =
      (frozenBranchTensorNormalizationIso O B (ColoredProfile.nullary d) Q
          (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap
            ((FiniteTensor.tensor (V := C)).map
              (coefficientHom O d Q (rootedFrozenBranches (ColoredProfile.nullary d) Q R)))
            (leafIso B d Q (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let B₀ := rootedFrozenBranches (ColoredProfile.nullary d) Q R
  let s := tupleSubstitutionShape ((inputsToProfile d).obj Q) B₀
  let N := frozenWeightedNestedFamily O B (ColoredProfile.nullary d) Q B₀
  let M := nestedOperationFactors O B s
  let K := frozenCoefficientFamily O (ColoredProfile.nullary d) Q B₀
  let L := frozenAlgebraLeaves B Q B₀
  let K' := (ColoredOperadObj.substitutionFactors O).obj s
  let L' := profileLeafFamily B s.totalProfile
  let a := nestedMap O B d Q B₀
  let gamma := coefficientHom O d Q B₀
  let ell := (leafIso B d Q B₀).hom
  let l := T.map (weightedMap O B d Q R)
  let p := T.map (frozenWeightedRootIso O B (ColoredProfile.nullary d) Q B₀).hom
  let p' := T.map (coefficientTensorIso O B ((inputsToProfile d).obj Q) R).hom
  let f := T.map ((FiniteFamily.map T).map a)
  let q := (FiniteTensor.flattenIso (V := C)).inv.app N
  let q' := (FiniteTensor.flattenIso (V := C)).inv.app M
  let g := T.map (F.map a)
  let r := T.map (frozenBranchLeafIso O B (ColoredProfile.nullary d) Q B₀).hom
  let r' := T.map (substitutionToLeavesIso O B s).hom
  let h := T.map (F.map (coefficientLeavesNestedMap gamma ell))
  let t := coefficientLeavesNormalization K L
  let t' := coefficientLeavesNormalization K' L'
  let k := T.map (coefficientLeafMap (T.map gamma) ell)
  have h1 : l ≫ p' = p ≫ f := (T.map_comp _ _).symm.trans
    ((congrArg T.map (weightedCoefficientFrame O B d Q R)).trans (T.map_comp _ _))
  have h2 : f ≫ q' = q ≫ g := (FiniteTensor.flattenIso (V := C)).inv.naturality a
  have h3 : g ≫ r' = r ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (nestedCoefficientLeafSquare O B d Q B₀)).trans (T.map_comp _ _))
  have h4 : h ≫ t' = t ≫ k := coefficientLeavesNormalization_naturality gamma ell
  have hs := originalTensorFourSquares l p p' f q q' g r r' h t t' k h1 h2 h3 h4
  have hn : (frozenBranchTensorNormalizationIso O B (ColoredProfile.nullary d) Q B₀).hom =
      p ≫ q ≫ r ≫ t := by
    change p ≫ q ≫ r ≫ (coefficientLeavesNormalizationIso K L).hom = p ≫ q ≫ r ≫ t
    rw [coefficientLeavesNormalizationIso_hom]
  have hl : l ≫ profileSubstitutionAssemblyMap O B ((inputsToProfile d).obj Q) R ≫ r' ≫ t' =
      l ≫ p' ≫ q' ≫ r' ≫ t' := originalAssembledFour l p' q' r' t'
  have hr : (frozenBranchTensorNormalizationIso O B (ColoredProfile.nullary d) Q B₀).hom ≫ k =
      p ≫ q ≫ r ≫ t ≫ k :=
    (congrArg (· ≫ k) hn).trans (originalAppendFour p q r t k)
  exact hl.trans (hs.trans hr.symm)


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource299

/- Exact checked source: NullaryWeightedEvaluation. -/
section EnvelopingSource300


/-!
# Original nullary weighted evaluation and ordinary free-operation evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory

private theorem originalNullaryTargetFiring {V : Type*} [Category* V]
    {X A B D Y : V} (n : X ⟶ A) (u : A ⟶ B) (t : B ⟶ Y)
    (v : B ⟶ D) (p : D ⟶ Y) (r : A ⟶ D)
    (ht : t = v ≫ p) (hr : u ≫ v = r) :
    (n ≫ u) ≫ t = n ≫ r ≫ p := by
  rw [ht, Category.assoc n u, ← Category.assoc u v, hr]

private theorem originalAfterCompositeCoefficient {V : Type*} [Category* V]
    {X A B D Y : V} (n : X ⟶ A) (c : A ⟶ B) (s : B ⟶ D) (p : D ⟶ Y) :
    n ≫ (c ≫ s) ≫ p = n ≫ c ≫ s ≫ p := by simp only [Category.assoc]

private theorem originalCollectedSix {V : Type*} [Category* V]
    {X A B D E F Y : V} (l : X ⟶ A) (a : A ⟶ B) (b : B ⟶ D)
    (n : D ⟶ E) (u : E ⟶ F) (p : F ⟶ Y) :
    l ≫ a ≫ b ≫ n ≫ u ≫ p = (l ≫ a ≫ b ≫ n) ≫ u ≫ p := by simp only [Category.assoc]

private theorem originalAfterTwoCoefficients {V : Type*} [Category* V]
    {X A B D Y : V} (n : X ⟶ A) (c : A ⟶ B) (s : B ⟶ D) (p : D ⟶ Y) :
    (n ≫ c) ≫ s ≫ p = n ≫ c ≫ s ≫ p := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original frozen weighted evaluation at an empty variable
profile is its original coefficient map followed by ordinary
simultaneous substitution and the original complete leaf comparison. -/
theorem frozenEvaluationFactorization (O : ColoredOperadObj W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchEvaluation O B (ColoredProfile.nullary d) Q R ≫
        (nullaryLinearDiagramIso O.toCollection B d).hom.app (frozenTotalInputs Q R) =
      (frozenBranchTensorNormalizationIso O.toCollection B (ColoredProfile.nullary d) Q R).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (coefficientHom
            O.toCollection d Q R))
            (leafIso B d Q R).hom) ≫
        (coefficientLeafTensorFunctor
          (profileLeafFamily B (tupleSubstitutionShape ((inputsToProfile d).obj Q)
            R).totalProfile)).map
          (O.subst.app (tupleSubstitutionShape ((inputsToProfile d).obj Q) R)) ≫
        (profileCoefficientLeafTensorIso O.toCollection B
          (tupleSubstitutionShape ((inputsToProfile d).obj Q) R).totalProfile).hom := by
  let T := FiniteTensor.tensor (V := C)
  let s := tupleSubstitutionShape ((inputsToProfile d).obj Q) R
  let L := frozenAlgebraLeaves B Q R
  let L' := profileLeafFamily B s.totalProfile
  let phi := frozenPartialSubstitution O (ColoredProfile.nullary d) Q R
  let delta := O.toCollection.map (nullaryVariableProfileHom d (frozenTotalInputs Q R))
  let gamma := coefficientHom O.toCollection d Q R
  let ell := (leafIso B d Q R).hom
  let sigma := O.subst.app s
  let n := (frozenBranchTensorNormalizationIso O.toCollection B (ColoredProfile.nullary d) Q R).hom
  let u := (coefficientLeafTensorFunctor L).map phi
  let t := (nullaryLinearDiagramIso O.toCollection B d).hom.app (frozenTotalInputs Q R)
  let v := T.map (coefficientLeafMap delta ell)
  let p := (profileCoefficientLeafTensorIso O.toCollection B s.totalProfile).hom
  let r := T.map (coefficientLeafMap (T.map gamma ≫ sigma) ell)
  let c := T.map (coefficientLeafMap (T.map gamma) ell)
  let z := (coefficientLeafTensorFunctor L').map sigma
  have ht : t = v ≫ p := (congrArg T.map (targetFactors O.toCollection B d Q R)).trans
    (T.map_comp _ _)
  have hr : u ≫ v = r := (T.map_comp _ _).symm.trans
    ((congrArg T.map (coefficientLeafMap_pre phi delta ell)).trans
      (congrArg (fun f => T.map (coefficientLeafMap f ell)) (partialSubstitution O d Q R)))
  have hz : c ≫ z = r := (T.map_comp _ _).symm.trans
    (congrArg T.map (coefficientLeafMap_post (T.map gamma) sigma ell))
  have h := originalNullaryTargetFiring n u t v p r ht hr
  have h' : n ≫ r ≫ p = n ≫ c ≫ z ≫ p :=
    (congrArg (fun q => n ≫ q ≫ p) hz.symm).trans (originalAfterCompositeCoefficient n c z p)
  exact h.trans h'

/-- The actual ordinary assembly and O-substitution on the same
original weighted slot source have exactly the same complete
coefficient-and-leaf factorization. -/
theorem ordinaryEvaluationFactorization (O : ColoredOperadObj W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    (FiniteTensor.tensor (V := C)).map (weightedMap O.toCollection B d Q R) ≫
        profileSubstitutionAssemblyMap O.toCollection B ((inputsToProfile d).obj Q) R ≫
        operadSubstitutionInputs O B
          (tupleSubstitutionShape ((inputsToProfile d).obj Q)
            (rootedFrozenBranches (ColoredProfile.nullary d) Q R)) =
      (frozenBranchTensorNormalizationIso O.toCollection B (ColoredProfile.nullary d) Q
          (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap
            ((FiniteTensor.tensor (V := C)).map
              (coefficientHom O.toCollection d Q (rootedFrozenBranches
                (ColoredProfile.nullary d) Q R)))
            (leafIso B d Q (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).hom) ≫
        (coefficientLeafTensorFunctor
          (profileLeafFamily B
            (tupleSubstitutionShape ((inputsToProfile d).obj Q)
              (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).totalProfile)).map
          (O.subst.app (tupleSubstitutionShape ((inputsToProfile d).obj Q)
            (rootedFrozenBranches (ColoredProfile.nullary d) Q R))) ≫
        (profileCoefficientLeafTensorIso O.toCollection B
          (tupleSubstitutionShape ((inputsToProfile d).obj Q)
            (rootedFrozenBranches (ColoredProfile.nullary d) Q R)).totalProfile).hom := by
  let T := FiniteTensor.tensor (V := C)
  let B₀ := rootedFrozenBranches (ColoredProfile.nullary d) Q R
  let s := tupleSubstitutionShape ((inputsToProfile d).obj Q) B₀
  let l := T.map (weightedMap O.toCollection B d Q R)
  let a := profileSubstitutionAssemblyMap O.toCollection B ((inputsToProfile d).obj Q) R
  let b := T.map (substitutionToLeavesIso O.toCollection B s).hom
  let n := coefficientLeavesNormalization ((ColoredOperadObj.substitutionFactors
    O.toCollection).obj s)
    (profileLeafFamily B s.totalProfile)
  let u := (coefficientLeafTensorFunctor (profileLeafFamily B s.totalProfile)).map (O.subst.app s)
  let p := (profileCoefficientLeafTensorIso O.toCollection B s.totalProfile).hom
  let c := T.map (coefficientLeafMap (T.map (coefficientHom O.toCollection d Q B₀))
    (leafIso B d Q B₀).hom)
  let N := (frozenBranchTensorNormalizationIso O.toCollection B (ColoredProfile.nullary d) Q B₀).hom
  have hp : T.map (substitutionLeavesTargetIso O.toCollection B s).hom = p :=
    congrArg T.map (substitutionLeavesTargetIso_eq_profile O.toCollection B s)
  have hop : operadSubstitutionInputs O B s = b ≫ n ≫ u ≫ p :=
    (operadSubstitutionInputs_factorization O B s).trans (congrArg (b ≫ n ≫ u ≫ ·) hp)
  have hsource : l ≫ a ≫ b ≫ n = N ≫ c := weightedNormalization O.toCollection B d Q R
  exact (congrArg (l ≫ a ≫ ·) hop).trans
    ((originalCollectedSix l a b n u p).trans
      ((congrArg (fun f => f ≫ u ≫ p) hsource).trans (originalAfterTwoCoefficients N c u p)))

/-- Every actual nullary-variable weighted branch evaluation is
the same original ordinary free-operation assembly before the final
original profile injection. All coefficient and leaf maps are literal. -/
theorem weightedEvaluation (O : ColoredOperadObj W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    frozenWeightedBranchEvaluation O B (ColoredProfile.nullary d) Q
        (rootedFrozenBranches (ColoredProfile.nullary d) Q R) ≫
        (nullaryLinearDiagramIso O.toCollection B d).hom.app
          (frozenTotalInputs Q (rootedFrozenBranches (ColoredProfile.nullary d) Q R)) =
      (FiniteTensor.tensor (V := C)).map (weightedMap O.toCollection B d Q R) ≫
        profileSubstitutionAssemblyMap O.toCollection B ((inputsToProfile d).obj Q) R ≫
        operadSubstitutionInputs O B
          (tupleSubstitutionShape ((inputsToProfile d).obj Q)
            (rootedFrozenBranches (ColoredProfile.nullary d) Q R)) :=
  (frozenEvaluationFactorization O B d Q (rootedFrozenBranches (ColoredProfile.nullary d) Q
    R)).trans
    (ordinaryEvaluationFactorization O B d Q R).symm


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource300

/- Exact checked source: NullarySlotInjections. -/
section EnvelopingSource301


/-!
# The original nullary comparison on every rooted tensor cofan leg
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory Limits

private theorem originalSlotMapThree {D E : Type*} [Category* D] [Category* E]
    (T : D ⥤ E) {A B C F : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ F) :
    T.map (a ≫ b ≫ c) = T.map a ≫ T.map b ≫ T.map c :=
  (T.map_comp a (b ≫ c)).trans (congrArg (T.map a ≫ ·) (T.map_comp b c))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used for the rooted nullary comparison. -/
local instance {d : W} (P : AnalyticIndex W d) (i : analyticFactorsIndex P) :
    Category.{0} (profileSlotIndex P i) := profileSlotCategory P i

/-- The actual original family of rooted coefficient/input cofan
injections, before applying the original finite tensor. -/
def rootedSlotFamilyInjection (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    (FiniteFamily.fixedIndexFunctor (C := C) (analyticFactorsIndex ((inputsToProfile d).obj Q))).obj
        ((Functor.pi (rootedSlotDiagram (O.obj (extendProfile (ColoredProfile.nullary d) Q)) O B
          ((inputsToProfile d).obj Q))).obj R) ⟶
      (FiniteFamily.fixedIndexFunctor (C := C) (analyticFactorsIndex ((inputsToProfile
        d).obj Q))).obj
        (fun i => (rootedSlotCocone (O.obj (extendProfile (ColoredProfile.nullary d) Q)) O B
          ((inputsToProfile d).obj Q) i).pt) :=
  (FiniteFamily.fixedIndexFunctor (C := C) (analyticFactorsIndex ((inputsToProfile d).obj Q))).map
    (fun i => (rootedSlotCocone (O.obj (extendProfile (ColoredProfile.nullary d) Q)) O B
      ((inputsToProfile d).obj Q) i).ι.app (R i))

/-- The actual original ordinary coefficient/input slot cofan
injection, with its unchanged root and every original profile leg. -/
def ordinarySlotFamilyInjection (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (P : AnalyticIndex W d) (R : ProfileSlotTuple P) :
    (slotInputFactorsFunctor O B P).obj R ⟶
      (analyticFactors O (profileCoinvariants O B)).obj P where
  equiv := Equiv.refl (Option P.inputs)
  hom i := match i with
    | none => 𝟙 (O.obj P.toColoredProfile)
    | some i => profileι O B (R (some i))

/-- The entire original rooted cofan family commutes with the
original nullary profile comparison and ordinary slot cofan family.
All original inner-profile injections are retained as actual maps. -/
theorem slotFamilySquare (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    rootedSlotFamilyInjection O B d Q R ≫
        (rootedFrozenPointFamilyIso O B (ColoredProfile.nullary d) Q).hom ≫
        (nullaryLinearFactorsIso O (profileCoinvariants O B) d).hom.app Q =
      (rootedFrozenFamilyIso O B (ColoredProfile.nullary d) Q R).hom ≫
        weightedMap O B d Q R ≫ ordinarySlotFamilyInjection O B d ((inputsToProfile d).obj
          Q) R := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      let f := O.map (nullaryVariableProfileHom d Q)
      change HEq (𝟙 _ ≫ 𝟙 _ ≫ f) (𝟙 _ ≫ f ≫ 𝟙 _)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | some i =>
      let f := profileι O B (R (some i))
      change HEq (f ≫ 𝟙 _ ≫ 𝟙 _) (𝟙 _ ≫ 𝟙 _ ≫ f)
      exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])

/-- The original rooted tensor cofan leg maps to precisely the
original ordinary slot cofan leg after its actual coefficient map,
including the original root coefficient-index choice. -/
theorem slotInjection (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : W) (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    rootedFrozenSummandInjection O B (ColoredProfile.nullary d) Q R ≫
        (nullaryLinearDiagramIso O (profileCoinvariants O B) d).hom.app Q =
      (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O B (ColoredProfile.nullary
        d) Q R).hom ≫
        (FiniteTensor.tensor (V := C)).map (weightedMap O B d Q R) ≫
        (profileSlotTensorCocone O B ((inputsToProfile d).obj Q)).ι.app R := by
  let T := FiniteTensor.tensor (V := C)
  let a := rootedSlotFamilyInjection O B d Q R
  let b := (rootedFrozenPointFamilyIso O B (ColoredProfile.nullary d) Q).hom
  let c := (nullaryLinearFactorsIso O (profileCoinvariants O B) d).hom.app Q
  let f := (rootedFrozenFamilyIso O B (ColoredProfile.nullary d) Q R).hom
  let g := weightedMap O B d Q R
  let k := ordinarySlotFamilyInjection O B d ((inputsToProfile d).obj Q) R
  have h : T.map a ≫ T.map b ≫ T.map c = T.map f ≫ T.map g ≫ T.map k :=
    (originalSlotMapThree T a b c).symm.trans
      ((congrArg T.map (slotFamilySquare O B d Q R)).trans (originalSlotMapThree T f g k))
  have hi : (rootedSlotTensorCocone (O.obj (extendProfile (ColoredProfile.nullary d) Q)) O B
      ((inputsToProfile d).obj Q)).ι.app R = T.map (rootedSlotFamilyInjection O B d Q R) := rfl
  have hj : (profileSlotTensorCocone O B ((inputsToProfile d).obj Q)).ι.app R =
      T.map (ordinarySlotFamilyInjection O B d ((inputsToProfile d).obj Q) R) := rfl
  have h0 :
      (T.map (rootedSlotFamilyInjection O B d Q R) ≫
          T.map (rootedFrozenPointFamilyIso O B (ColoredProfile.nullary d) Q).hom) ≫
          T.map ((nullaryLinearFactorsIso O (profileCoinvariants O B) d).hom.app Q) =
        T.map (rootedFrozenFamilyIso O B (ColoredProfile.nullary d) Q R).hom ≫
          T.map (weightedMap O B d Q R) ≫ T.map (ordinarySlotFamilyInjection O B d
            ((inputsToProfile d).obj Q) R) :=
    (Category.assoc _ _ _).trans h
  exact (congrArg (fun i => (i ≫ T.map (rootedFrozenPointFamilyIso O B
    (ColoredProfile.nullary d) Q).hom) ≫
      T.map ((nullaryLinearFactorsIso O (profileCoinvariants O B) d).hom.app Q)) hi).trans
    (h0.trans (congrArg (fun j => T.map (rootedFrozenFamilyIso O B (ColoredProfile.nullary
      d) Q R).hom ≫
      T.map (weightedMap O B d Q R) ≫ j) hj.symm))


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource301

/- Exact checked source: NullaryRootedEvaluation. -/
section EnvelopingSource302


/-!
# The original nullary rooted evaluation is the original ordinary assembly cofan
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory Limits

private theorem originalWeightedColimitFiring {V : Type*} [Category* V]
    {X A B D E Y : V} (a : X ⟶ A) (b : A ⟶ B) (i : B ⟶ D) (e : D ⟶ Y)
    (d : B ⟶ E) (p : E ⟶ Y) (c : A ⟶ E) (g : A ⟶ Y)
    (hi : i ≫ e = d ≫ p) (hb : b ≫ d = c) (hc : c ≫ p = g) :
    (a ≫ b ≫ i) ≫ e = a ≫ g := by
  simp only [Category.assoc]
  rw [hi, ← Category.assoc b d, hb, hc]

private theorem originalAssemblyCofanFiring {V : Type*} [Category* V]
    {X A B D Y : V} (w : X ⟶ A) (a : A ⟶ B) (o : B ⟶ D) (p : D ⟶ Y)
    (h : A ⟶ Y) (hh : h = a ≫ o ≫ p) :
    (w ≫ a ≫ o) ≫ p = w ≫ h := by
  simp only [Category.assoc]
  rw [← hh]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original rooted coefficient/input evaluation at the
actual nullary variable profile is exactly the original ordinary
operation assembly cofan leg under the original nullary colimit
comparison. All original inner profile injections remain literal. -/
theorem rootedEvaluation (O : ColoredOperadObj W C) (B : W → C) (d : W)
    (Q : ColoredInputs W) (R : ProfileSlotTuple ((inputsToProfile d).obj Q)) :
    rootedFrozenEvaluation O B (ColoredProfile.nullary d) Q R ≫
        (nullaryLinearCoefficientIso O.toCollection B d).hom =
      (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B
        (ColoredProfile.nullary d) Q R).hom ≫
        (FiniteTensor.tensor (V := C)).map (weightedMap O.toCollection B d Q R) ≫
        (assembledProfileSubstitutionCocone O B ((inputsToProfile d).obj Q)).ι.app R := by
  let T := FiniteTensor.tensor (V := C)
  let B₀ := rootedFrozenBranches (ColoredProfile.nullary d) Q R
  let P := (inputsToProfile d).obj Q
  let Q₀ := frozenTotalInputs Q B₀
  let s := tupleSubstitutionShape P B₀
  let a := T.map (rootedFrozenFamilyIso O.toCollection B (ColoredProfile.nullary d) Q R).hom
  let b := frozenWeightedBranchEvaluation O B (ColoredProfile.nullary d) Q B₀
  let i := linearCoefficientι O.toCollection B (ColoredProfile.nullary d) Q₀
  let e := (nullaryLinearCoefficientIso O.toCollection B d).hom
  let delta := (nullaryLinearDiagramIso O.toCollection B d).hom.app Q₀
  let p := profileι O.toCollection B ((inputsToProfile d).obj Q₀)
  let w := T.map (weightedMap O.toCollection B d Q R)
  let assembly := profileSubstitutionAssemblyMap O.toCollection B P R
  let op := operadSubstitutionInputs O B s
  let c := w ≫ assembly ≫ op
  let h := (assembledProfileSubstitutionCocone O B P).ι.app R
  let g := w ≫ h
  have hi : i ≫ e = delta ≫ p := nullaryLinearCoefficientIso_ι O.toCollection B d Q₀
  have hb : b ≫ delta = c := weightedEvaluation O B d Q R
  have hh : h = assembly ≫ op ≫ p := assembledProfileSubstitutionCocone_ι O B P R
  have hc : c ≫ p = g := originalAssemblyCofanFiring w assembly op p h hh
  exact originalWeightedColimitFiring a b i e delta p c g hi hb hc


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

end
end EnvelopingSource302

/- Exact checked source: NullaryBeckCofork. -/
section EnvelopingSource303


/-!
# The original tensor-algebra action is its colorwise Beck coequalizer

The two faces are the actual tensor-profile multiplication and the
actual profile map of the original algebra action. The section is the
original operadic generator map at the same color.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- The actual original action has its genuine colorwise split
Beck presentation, obtained from the original tensor-algebra/EM map. -/
def nullaryBeckSplit (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    IsSplitCoequalizer (profileMap O.toCollection A.action d)
      (profileMultiplication O A.carrier d) (A.action d) :=
  (Monad.beckSplitCoequalizer ((tensorAlgebraToEM O).obj A)).map
    (Pi.eval (fun _ : W => C) d)

/-- The section in the original Beck presentation is precisely
the original unary operadic generator at the retained color. -/
theorem nullaryBeckSplit_rightSection (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (nullaryBeckSplit O A d).rightSection = (profileUnit O).app A.carrier d := rfl

/-- The left section is the same original generator on the actual
free-algebra carrier, with all original nullary operations retained. -/
theorem nullaryBeckSplit_leftSection (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (nullaryBeckSplit O A d).leftSection =
      (profileUnit O).app (profileCoinvariants O.toCollection A.carrier) d := rfl

/-- The actual action cofork has the original algebra carrier. -/
def nullaryBeckCofork (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    Cofork (profileMap O.toCollection A.action d) (profileMultiplication O A.carrier d) :=
  (nullaryBeckSplit O A d).asCofork

/-- The original action cofork satisfies its full coequalizer
universal property at every original color. -/
def nullaryBeckIsColimit (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    IsColimit (nullaryBeckCofork O A d) := (nullaryBeckSplit O A d).isCoequalizer

/-- Every compatible map descends by precomposing with the
original generator, without changing any original algebra-action leg. -/
theorem nullaryBeckIsColimit_desc (O : ColoredOperadObj W C) (A : Algebra O) (d : W)
    (s : Cofork (profileMap O.toCollection A.action d) (profileMultiplication O A.carrier d)) :
    (nullaryBeckIsColimit O A d).desc s = (profileUnit O).app A.carrier d ≫ s.π := rfl

/-- The chosen actual Beck coequalizer is the original algebra
carrier, with both comparison maps supplied by its universal property. -/
def nullaryBeckCoequalizerIso (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    coequalizer (profileMap O.toCollection A.action d) (profileMultiplication O A.carrier d) ≅
      A.carrier d :=
  (colimit.isColimit _).coconePointUniqueUpToIso (nullaryBeckIsColimit O A d)

/-- The forward comparison preserves the exact original quotient
leg and recovers the original O-algebra action at its original color. -/
theorem nullaryBeckCoequalizerIso_π (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    coequalizer.π (profileMap O.toCollection A.action d) (profileMultiplication O A.carrier d) ≫
      (nullaryBeckCoequalizerIso O A d).hom = A.action d := by
  exact (colimit.isColimit _).comp_coconePointUniqueUpToIso_hom
    (nullaryBeckIsColimit O A d) WalkingParallelPair.one


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource303

/- Exact checked source: NullaryCarrierComparison. -/
section EnvelopingSource304


/-!
# Original carrier maps and the nullary linear coefficient comparison
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The empty-variable factor comparison retains every original
colorwise carrier map and its original analytic input position. -/
theorem nullaryLinearFactorsIso_carrier (O : ColoredSymmetricCollection W C)
    {A B : W → C} (f : A ⟶ B) (d : W) (Q : ColoredInputs W) :
    (coefficientInputFactorsMap (𝟙 (extendedCoefficient O (ColoredProfile.nullary d)))
        (addedAlgebraInputMap f)).app Q ≫ (nullaryLinearFactorsIso O B d).hom.app Q =
      (nullaryLinearFactorsIso O A d).hom.app Q ≫
        (analyticFactorsCarrierMap O f).app ((inputsToProfile d).obj Q) := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq (𝟙 _ ≫ O.map (nullaryVariableProfileHom d Q))
        (O.map (nullaryVariableProfileHom d Q) ≫ 𝟙 _)
      exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)
    | some i =>
      change HEq (f (Q.obj i).as ≫ 𝟙 _) (𝟙 _ ≫ f (Q.obj i).as)
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

variable [FiniteTensor C]

/-- The actual nullary-variable tensor comparison is natural in
every original colorwise carrier map, including all nullary summands. -/
theorem nullaryLinearDiagramIso_carrier (O : ColoredSymmetricCollection W C)
    {A B : W → C} (f : A ⟶ B) (d : W) (Q : ColoredInputs W) :
    (linearCoefficientCarrierMap O f (ColoredProfile.nullary d)).app Q ≫
        (nullaryLinearDiagramIso O B d).hom.app Q =
      (nullaryLinearDiagramIso O A d).hom.app Q ≫
        (analyticSummandCarrierMap O f).app ((inputsToProfile d).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  exact (T.map_comp _ _).symm.trans
    ((congrArg T.map (nullaryLinearFactorsIso_carrier O f d Q)).trans (T.map_comp _ _))

private theorem originalNullaryCarrierSquares {V : Type*} [Category* V]
    {S S' R R' X X' Y Y' : V}
    (i : S ⟶ X) (f : X ⟶ X') (e : X ⟶ Y) (e' : X' ⟶ Y') (h : Y ⟶ Y')
    (l : S ⟶ S') (i' : S' ⟶ X') (a : S ⟶ R) (a' : S' ⟶ R')
    (j : R ⟶ Y) (j' : R' ⟶ Y') (k : R ⟶ R')
    (hi : i ≫ f = l ≫ i') (he : i ≫ e = a ≫ j) (he' : i' ≫ e' = a' ≫ j')
    (ha : l ≫ a' = a ≫ k) (hj : j ≫ h = k ≫ j') :
    i ≫ (f ≫ e') = i ≫ (e ≫ h) := by
  rw [← Category.assoc i f, hi, Category.assoc l i', he', ← Category.assoc l a', ha,
    Category.assoc a k, ← hj, ← Category.assoc a j, ← he, Category.assoc]

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual nullary linear colimit comparison retains the
complete original carrier functor and its original quotient maps. -/
theorem nullaryLinearCoefficientIso_carrier (O : ColoredSymmetricCollection W C)
    {A B : W → C} (f : A ⟶ B) (d : W) :
    linearCoefficientCarrierLift O f (ColoredProfile.nullary d) ≫
      (nullaryLinearCoefficientIso O B d).hom =
      (nullaryLinearCoefficientIso O A d).hom ≫ profileMap O f d := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits d
  apply colimit.hom_ext
  intro Q
  exact originalNullaryCarrierSquares
    (linearCoefficientι O A (ColoredProfile.nullary d) Q)
    (linearCoefficientCarrierLift O f (ColoredProfile.nullary d))
    (nullaryLinearCoefficientIso O A d).hom (nullaryLinearCoefficientIso O B d).hom
      (profileMap O f d)
    ((linearCoefficientCarrierMap O f (ColoredProfile.nullary d)).app Q)
    (linearCoefficientι O B (ColoredProfile.nullary d) Q)
    ((nullaryLinearDiagramIso O A d).hom.app Q) ((nullaryLinearDiagramIso O B d).hom.app Q)
    (profileι O A ((inputsToProfile d).obj Q)) (profileι O B ((inputsToProfile d).obj Q))
    ((analyticSummandCarrierMap O f).app ((inputsToProfile d).obj Q))
    (linearCoefficientι_carrier O f (ColoredProfile.nullary d) Q)
    (nullaryLinearCoefficientIso_ι O A d Q) (nullaryLinearCoefficientIso_ι O B d Q)
    (nullaryLinearDiagramIso_carrier O f d Q) (profileι_map O f ((inputsToProfile d).obj Q))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

omit [FiniteTensorPreservesColimitsInEachSlot C] in
/-- The actual algebra-action relation at the nullary profile is
the original Beck carrier-action face under the original comparison. -/
theorem nullaryAlgebraInputRelation (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    algebraInputRelation O A (ColoredProfile.nullary d) ≫
      (nullaryLinearCoefficientIso O.toCollection A.carrier d).hom =
      (nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection
        A.carrier) d).hom ≫
        profileMap O.toCollection A.action d :=
  nullaryLinearCoefficientIso_carrier O.toCollection A.action d


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource304

/- Exact checked source: NullaryLinearBeckPresentation. -/
section EnvelopingSource305


/-!
# The original nullary linear coefficient frame for the Beck presentation

This frame keeps the actual algebra-input face and transports the actual
tensor-profile multiplication face through the original empty-profile
comparison. Identification with the constant-input substitution face is
a separate original-map equation.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- The actual profile multiplication in the original nullary
linear frame, with both original empty-profile comparison maps. -/
def nullaryLinearMultiplicationFace (O : ColoredOperadObj W C) (B : W → C) (d : W) :
    linearCoefficient O.toCollection (profileCoinvariants O.toCollection B)
      (ColoredProfile.nullary d) ⟶
      linearCoefficient O.toCollection B (ColoredProfile.nullary d) :=
  (nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection B) d).hom ≫
    profileMultiplication O B d ≫ (nullaryLinearCoefficientIso O.toCollection B d).inv

/-- The original nullary coefficient comparison preserves the
complete multiplication face and its original coefficient source. -/
theorem nullaryLinearMultiplicationFace_comparison (O : ColoredOperadObj W C)
    (B : W → C) (d : W) :
    nullaryLinearMultiplicationFace O B d ≫ (nullaryLinearCoefficientIso O.toCollection B d).hom =
      (nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection B) d).hom ≫
        profileMultiplication O B d := by
  simp only [nullaryLinearMultiplicationFace, Category.assoc, Iso.inv_hom_id, Category.comp_id]

/-- The full original nullary linear relation diagram is
isomorphic to the actual colorwise Beck diagram. -/
def nullaryLinearBeckDiagramIso (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    parallelPair (algebraInputRelation O A (ColoredProfile.nullary d))
        (nullaryLinearMultiplicationFace O A.carrier d) ≅
      parallelPair (profileMap O.toCollection A.action d) (profileMultiplication O A.carrier d) :=
  parallelPairIso _ _ _ _
    (nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection A.carrier) d)
    (nullaryLinearCoefficientIso O.toCollection A.carrier d)
    (nullaryAlgebraInputRelation O A d) (nullaryLinearMultiplicationFace_comparison O A.carrier d)

/-- The actual nullary linear coefficient action is the original
empty-profile comparison followed by the original O-algebra action. -/
def nullaryLinearAlgebraEvaluation (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    linearCoefficient O.toCollection A.carrier (ColoredProfile.nullary d) ⟶ A.carrier d :=
  (nullaryLinearCoefficientIso O.toCollection A.carrier d).hom ≫ A.action d

/-- The two original nullary linear Beck faces agree under the
actual algebra evaluation, by the original algebra substitution law. -/
theorem nullaryLinearAlgebraEvaluation_condition (O : ColoredOperadObj W C)
    (A : Algebra O) (d : W) :
    algebraInputRelation O A (ColoredProfile.nullary d) ≫ nullaryLinearAlgebraEvaluation O A d =
      nullaryLinearMultiplicationFace O A.carrier d ≫ nullaryLinearAlgebraEvaluation O A d := by
  let e := nullaryLinearCoefficientIso O.toCollection A.carrier d
  let t := nullaryLinearCoefficientIso O.toCollection (profileCoinvariants O.toCollection
    A.carrier) d
  have h := congrFun (A.action_assoc) d
  change profileMultiplication O A.carrier d ≫ A.action d =
    profileMap O.toCollection A.action d ≫ A.action d at h
  change algebraInputRelation O A (ColoredProfile.nullary d) ≫ (e.hom ≫ A.action d) =
    nullaryLinearMultiplicationFace O A.carrier d ≫ (e.hom ≫ A.action d)
  rw [← Category.assoc, nullaryAlgebraInputRelation, Category.assoc, ← h,
    ← Category.assoc, ← nullaryLinearMultiplicationFace_comparison, Category.assoc]

/-- The original nullary linear action cocone is obtained from
the actual Beck cocone by the original whole-diagram comparison. -/
def nullaryLinearBeckCocone (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    Cocone (parallelPair (algebraInputRelation O A (ColoredProfile.nullary d))
      (nullaryLinearMultiplicationFace O A.carrier d)) :=
  (Cocone.precompose (nullaryLinearBeckDiagramIso O A d).hom).obj (nullaryBeckCofork O A d)

/-- The cocone retains the exact original nullary coefficient
evaluation as its original target leg. -/
theorem nullaryLinearBeckCocone_π (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    (nullaryLinearBeckCocone O A d).ι.app WalkingParallelPair.one =
      nullaryLinearAlgebraEvaluation O A d := rfl

/-- The original linear action cocone has its full coequalizer
universal property, derived from the actual colorwise Beck presentation. -/
def nullaryLinearBeckIsColimit (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    IsColimit (nullaryLinearBeckCocone O A d) :=
  (IsColimit.precomposeHomEquiv (nullaryLinearBeckDiagramIso O A d)
    (nullaryBeckCofork O A d)).symm (nullaryBeckIsColimit O A d)

/-- The actual nullary linear Beck quotient is the original
algebra carrier with both original universal comparison maps. -/
def nullaryLinearBeckCoequalizerIso (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    coequalizer (algebraInputRelation O A (ColoredProfile.nullary d))
        (nullaryLinearMultiplicationFace O A.carrier d) ≅ A.carrier d :=
  (colimit.isColimit _).coconePointUniqueUpToIso (nullaryLinearBeckIsColimit O A d)

/-- The actual chosen quotient leg is carried to the original
linear coefficient/algebra evaluation at the unchanged color. -/
theorem nullaryLinearBeckCoequalizerIso_π (O : ColoredOperadObj W C) (A : Algebra O) (d : W) :
    coequalizer.π (algebraInputRelation O A (ColoredProfile.nullary d))
        (nullaryLinearMultiplicationFace O A.carrier d) ≫
      (nullaryLinearBeckCoequalizerIso O A d).hom = nullaryLinearAlgebraEvaluation O A d :=
  (colimit.isColimit _).comp_coconePointUniqueUpToIso_hom
    (nullaryLinearBeckIsColimit O A d) WalkingParallelPair.one


end CategoryTheory.Operad.Tensor.Enveloping

end
