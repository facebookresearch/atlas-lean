/- Exact checked source: WeightedNormalization.UnitGroupFactorization. -/
section EnvelopingSource162


/-!
# Grouped normalization retains the original unit coefficient maps
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem unitRouteFromSquares {D : Type*} [Category* D]
    {A B C E F G H K : D}
    (p : A ⟶ B) (r : B ⟶ C) (q : C ⟶ E) (s : E ⟶ F) (o : F ⟶ G)
    (a : A ⟶ H) (p' : H ⟶ C) (o' : E ⟶ K) (l : K ⟶ G)
    (hp : p ≫ r = a ≫ p') (ho : s ≫ o = o' ≫ l) :
    p ≫ (r ≫ q ≫ s) ≫ o = a ≫ (p' ≫ q ≫ o') ≫ l := by
  calc
    p ≫ (r ≫ q ≫ s) ≫ o = (p ≫ r) ≫ q ≫ (s ≫ o) := by simp only [Category.assoc]
    _ = (a ≫ p') ≫ q ≫ (o' ≫ l) := congrArg₂ (fun x y => x ≫ q ≫ y) hp ho
    _ = a ≫ (p' ≫ q ≫ o') ≫ l := by simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Genuine finite block distribution retains arbitrary original
coefficient maps as well as every complete original input map. -/
theorem distributionCoefficientInputs (N : FiniteFamily (FiniteFamily C))
    (L M : N.index → FiniteFamily C) (K : N.index → C)
    (k : ∀ i, (FiniteTensor.tensor (V := C)).obj (N.obj i) ⟶ K i)
    (l : ∀ i, L i ⟶ M i) :
    (FiniteTensor.tensor (V := C)).map (weightedInputBlockMap N.index k l) ≫
      (coefficientBlockInterchangeTensorIso N.index K M).hom =
    (partitionedScalarLeavesDistributionIso N L (fun i => (FiniteTensor.tensor (V :=
      C)).obj (N.obj i))).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (coefficientBlockMap N.index k))
        ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l))) := by
  let T := FiniteTensor.tensor (V := C)
  have hf : (partitionedScalarLeavesIso N L (fun i => T.obj (N.obj i))).hom =
      (coefficientBlockInterchangeFamilyIso N.index (fun i => T.obj (N.obj i)) L).hom := by
    apply FiniteFamily.Hom_ext
    · ext p
      rcases p with ⟨i, j⟩
      cases j <;> rfl
    · intro p
      rcases p with ⟨i, j⟩
      cases j <;> rfl
  have hd : (partitionedScalarLeavesDistributionIso N L (fun i => T.obj (N.obj i))).hom =
      (coefficientBlockInterchangeTensorIso N.index (fun i => T.obj (N.obj i)) L).hom :=
    congrArg (fun f => (FiniteTensor.flattenIso (V := C)).inv.app
      (combinedInputBlocks N.index (fun i => T.obj (N.obj i)) L) ≫ T.map f ≫
      (coefficientLeavesNormalizationIso ((FiniteFamily.map T).obj N) (totalBlockInputs
        N.index L)).hom) hf
  exact (coefficientBlockInterchangeTensorIso_naturality N.index k l).trans
    (congrArg (· ≫ T.map (coefficientLeafMap (T.map (coefficientBlockMap N.index k))
      ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l)))) hd.symm)

/-- Actual grouped normalization with arbitrary original coefficient
and leaf maps factors through the original weighted source comparison. -/
theorem groupedBlocksCoefficientInputs (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C)
    {P : FiniteFamily (FiniteFamily C)} (e : P ≅ groupedCoefficientInputWeightedBlocks N L)
    (K : N.index → C) (M : N.index → FiniteFamily C)
    (k : ∀ i, (FiniteTensor.tensor (V := C)).obj (N.obj i) ⟶ K i)
    (l : ∀ i, groupedCoefficientInputs N L i ⟶ M i) :
    (FiniteTensor.flattenIso (V := C)).hom.app P ≫
      (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.map (FiniteTensor.tensor (V := C))).map e.hom ≫
          groupedCoefficientInputNormalizationMap N L ≫ weightedInputBlockMap N.index k l) ≫
      (coefficientBlockInterchangeTensorIso N.index K M).hom =
    (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C := C)).map e.hom) ≫
      groupedCoefficientInputNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (coefficientBlockMap N.index k))
        ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l))) := by
  let T := FiniteTensor.tensor (V := C)
  let f := (FiniteFamily.map T).map e.hom
  let g := groupedCoefficientInputNormalizationMap N L
  let s := weightedInputBlockMap N.index k l
  let p := (FiniteTensor.flattenIso (V := C)).hom.app P
  let a := T.map ((FiniteFamily.flatten (C := C)).map e.hom)
  let p' := (FiniteTensor.flattenIso (V := C)).hom.app (groupedCoefficientInputWeightedBlocks N L)
  let o := (coefficientBlockInterchangeTensorIso N.index K M).hom
  let o' := (partitionedScalarLeavesDistributionIso N (groupedCoefficientInputs N L)
    (fun i => T.obj (N.obj i))).hom
  let h := T.map (coefficientLeafMap (T.map (coefficientBlockMap N.index k))
    ((FiniteFamily.flatten (C := C)).map (inputBlockMap N.index l)))
  have hm : T.map (f ≫ g ≫ s) = T.map f ≫ T.map g ≫ T.map s :=
    (T.map_comp f (g ≫ s)).trans (congrArg (T.map f ≫ ·) (T.map_comp g s))
  have hp : p ≫ T.map f = a ≫ p' := (FiniteTensor.flattenIso (V := C)).hom.naturality e.hom |>.symm
  have ho : T.map s ≫ o = o' ≫ h := distributionCoefficientInputs N
    (groupedCoefficientInputs N L) M K k l
  exact (congrArg (fun c => p ≫ c ≫ o) hm).trans
    (unitRouteFromSquares p (T.map f) (T.map g) (T.map s) o a p' o' h hp ho)

/-- An arbitrary original post-normalization coefficient map is
transported through the genuine coefficient flattening, retaining the
complete original flat atomic normalizer and leaf map. -/
theorem normalizeGroupedPostMap (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C)
    {Y : C} (k : (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.map (FiniteTensor.tensor
      (V := C))).obj N) ⟶ Y)
    {M : FiniteFamily C} (f : groupedCoefficientInputLeaves N L ⟶ M) :
    groupedCoefficientInputNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap k f) =
    Grouping.flatAtomicNormalization N L ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.flattenIso (V := C)).hom.app N ≫ k) f) := by
  let c := (FiniteTensor.flattenIso (V := C)).inv.app N
  let d := (FiniteTensor.flattenIso (V := C)).hom.app N
  have h : c ≫ (d ≫ k) = k := (Category.assoc c d k).symm.trans
    ((congrArg (· ≫ k) ((FiniteTensor.flattenIso (V := C)).inv_hom_id_app N)).trans
      (Category.id_comp k))
  have hn := WeightedNormalization.normalizeGroupedAfterCoefficientMap N L (d ≫ k) f
  have hc := congrArg (fun c => groupedCoefficientInputNormalization N L ≫
    (FiniteTensor.tensor (V := C)).map (coefficientLeafMap c f)) h
  exact hc.symm.trans hn


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
