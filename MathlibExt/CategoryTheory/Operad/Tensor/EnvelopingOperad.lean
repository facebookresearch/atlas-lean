/- Exact checked source: WeightedNormalization.WeightedUnitComparisons. -/
section EnvelopingSource199


/-!
# Exact original weighted unit-source comparisons
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory Limits

private theorem appendEmptyUnit {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    a ≫ b ≫ c ≫ d = (a ≫ b ≫ c) ≫ d := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original right generic weighted factors retain the actual
root-profile comparison and original mapped-empty input comparisons. -/
def rightUnitWeightedFamilyIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    weightedInputBlockFamily (FintypeCat.of (Option P.inputs))
        (UnitGeometry.rightCoefficientFamily (O.obj (extendProfile P Q)) P.inputs
          (fun i => O.obj (extendProfile (ColoredSubstitutionData.unitProfile (P.inputColor i))
            emptyColoredInputs))).obj
        (UnitGeometry.rightLeaves ((addedAlgebraInputs B).obj Q) P.inputs) ≅
      envelopingWeightedRepresentativeFamily O B (ColoredSubstitutionData.rightUnit P)
        (rightUnitChoices P Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option P.inputs)) (fun i => match i with
    | none => (coefficientLeafTensorFunctor ((addedAlgebraInputs B).obj Q)).mapIso
        (O.mapIso (asIso (extendProfileMap (ColoredSubstitutionData.rightUnitOuterHom P) (𝟙 Q))))
    | some _i => (FiniteTensor.tensor (V := C)).mapIso (coefficientLeafIso (Iso.refl _)
        (emptyAddedAlgebraInputsIso B).symm))

/-- The original left generic weighted factors retain exactly the
original mapped-empty root inputs and complete original inner input family. -/
def leftUnitWeightedFamilyIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    weightedInputBlockFamily (FintypeCat.of (Option PUnit))
        (sparseUnitScalarFamily
          (O.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
            emptyColoredInputs))
          (O.obj (extendProfile P Q))).obj
        (UnitGeometry.leftLeaves ((addedAlgebraInputs B).obj Q)) ≅
      envelopingWeightedRepresentativeFamily O B (ColoredSubstitutionData.leftUnit P)
        (leftUnitChoices P Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option PUnit)) (fun i => match i with
    | none => (FiniteTensor.tensor (V := C)).mapIso (coefficientLeafIso (Iso.refl _)
        (emptyAddedAlgebraInputsIso B).symm)
    | some _ => Iso.refl _)

/-- The actual original weighted right-unit source retains the
original right tensor prefix and all original no-added-input unit factors. -/
def rightUnitWeightedInsertion (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientDiagram O.toCollection B P).obj Q ⟶
      (FiniteTensor.tensor (V := C)).obj
        (envelopingWeightedRepresentativeFamily O.toCollection B
          (ColoredSubstitutionData.rightUnit P) (rightUnitChoices
          P Q)) :=
  UnitInsertion.rightInsertFromFactor ((linearCoefficientDiagram O.toCollection B P).obj Q) P.inputs
      (UnitGeometry.rightWeightedFactor (O.toCollection.obj (extendProfile P Q))
        ((addedAlgebraInputs B).obj Q) P.inputs
        (fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
          (P.inputColor i))
          emptyColoredInputs))
        (rightUnitCoefficient O P)) ≫
    (FiniteTensor.tensor (V := C)).map (rightUnitWeightedFamilyIso O.toCollection B P Q).hom

/-- The actual original weighted left-unit source retains the
original left tensor prefix and original empty added-input O-unit factor. -/
def leftUnitWeightedInsertion (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientDiagram O.toCollection B P).obj Q ⟶
      (FiniteTensor.tensor (V := C)).obj
        (envelopingWeightedRepresentativeFamily O.toCollection B
          (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P
          Q)) :=
  UnitInsertion.leftInsertFromFactor ((linearCoefficientDiagram O.toCollection B P).obj Q)
      (UnitGeometry.leftWeightedFactor (O.toCollection.obj (extendProfile P Q))
        ((addedAlgebraInputs B).obj Q)
        (O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
          P.outputColor) emptyColoredInputs))
        (leftUnitCoefficient O P)) ≫
    (FiniteTensor.tensor (V := C)).map (leftUnitWeightedFamilyIso O.toCollection B P Q).hom

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The genuine linear O-unit keeps its actual no-added-input
inclusion under the original identity unary profile map. -/
theorem linearUnit_leftOuter (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W) :
    envelopingLinearUnit O B P.outputColor ≫
      (linearCoefficientCollection O.toCollection B).map
        (ColoredSubstitutionData.leftUnitOuterHom P) =
    envelopingLinearUnit O B P.outputColor :=
  (congrArg (envelopingLinearUnit O B P.outputColor ≫ ·)
    (congrArg (linearCoefficientCollection O.toCollection B).map
      (ColoredSubstitutionData.leftUnitOuterHom_eq_id
      P))).trans
      ((congrArg (envelopingLinearUnit O B P.outputColor ≫ ·)
        ((linearCoefficientCollection O.toCollection B).map_id _)).trans (Category.comp_id _))

/-- Every original linear coefficient cofan reads the actual left
unit insertion as the exact original weighted left unit source followed
by its original tensor of coefficient cofan legs. -/
theorem leftUnitWeightedInsertion_ι (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫
        ColoredOperadObj.leftUnitInsert (linearCoefficientCollection O.toCollection B)
          (envelopingLinearUnit O B) P =
      leftUnitWeightedInsertion O B P Q ≫ (FiniteTensor.tensor (V := C)).map
        (representativeCofanMap O.toCollection B (ColoredSubstitutionData.leftUnit P)
          (leftUnitChoices P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let L := (addedAlgebraInputs B).obj Q
  let Y := O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
    P.outputColor) emptyColoredInputs)
  let Z := (linearCoefficientDiagram O.toCollection B P).obj Q
  let f := linearCoefficientι O.toCollection B P Q
  let a := UnitGeometry.leftWeightedFactor X L Y (leftUnitCoefficient O P)
  let b := ColoredOperadObj.UnitInsertion.leftFactorHom (linearCoefficientCollection
    O.toCollection B)
    (envelopingLinearUnit O B) P
  let e := (leftUnitWeightedFamilyIso O.toCollection B P Q).hom
  let k := envelopingLinearCofanFamilyMap O.toCollection B (ColoredSubstitutionData.leftUnit
    P) (leftUnitChoices P Q)
  let g := e ≫ k
  have ha : (FiniteFamily.map T).map (UnitGeometry.leftRootMap f) ≫ b = a ≫ g := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none =>
        let u := envelopingLinearUnit O B P.outputColor
        let v := (linearCoefficientCollection O.toCollection B).map
          (ColoredSubstitutionData.leftUnitOuterHom P)
        let j := linearCoefficientι O.toCollection B (ColoredSubstitutionData.unitProfile
          P.outputColor)
          emptyColoredInputs
        let d := (emptyLeafTensorIso Y).inv
        let h := T.map (coefficientLeafMap (𝟙 Y) (emptyAddedAlgebraInputsIso B).inv)
        have hl : T.map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ (u ≫ v) = u :=
          (congrArg (· ≫ (u ≫ v)) (T.map_id _)).trans
            ((Category.id_comp _).trans (linearUnit_leftOuter O B P))
        have hr : (leftUnitCoefficient O P ≫ d) ≫ (h ≫ j) = u :=
          (Category.assoc (leftUnitCoefficient O P) d (h ≫ j)).trans
            ((appendEmptyUnit (leftUnitCoefficient O P) d h j).trans
              ((congrArg (· ≫ j) (unitEmptySummand_tensor O B P.outputColor)).trans
                (Category.assoc _ _ _)))
        exact heq_of_eq (hl.trans hr.symm)
      | some i =>
        cases i
        let s := (FiniteTensor.singletonIso (V := C)).hom.app Z
        have h := (FiniteTensor.singletonIso (V := C)).hom.naturality f
        have hr : s ≫ (𝟙 Z ≫ f) = s ≫ f := congrArg (s ≫ ·) (Category.id_comp f)
        exact heq_of_eq (h.trans hr.symm)
  have hn := UnitGeometry.leftInsertion_naturality f a b g ha
  have hk : representativeCofanMap O.toCollection B (ColoredSubstitutionData.leftUnit P)
    (leftUnitChoices P Q) = k :=
    representativeCofanMap_eq _ _ _ _
  have hm : T.map e ≫ T.map k = T.map g := (T.map_comp _ _).symm
  have ht : (UnitInsertion.leftInsertFromFactor Z a ≫ T.map e) ≫ T.map k =
      UnitInsertion.leftInsertFromFactor Z a ≫ T.map g :=
    (Category.assoc _ _ _).trans (congrArg (UnitInsertion.leftInsertFromFactor Z a ≫ ·) hm)
  exact hn.trans (ht.symm.trans (congrArg (leftUnitWeightedInsertion O B P Q ≫
    ·) (congrArg T.map hk.symm)))

/-- Every original linear coefficient cofan reads the actual right
unit insertion as the exact original weighted right unit source followed
by its original tensor of coefficient cofan legs. -/
theorem rightUnitWeightedInsertion_ι (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫
        ColoredOperadObj.rightUnitInsert (linearCoefficientCollection O.toCollection B)
          (envelopingLinearUnit O B) P =
      rightUnitWeightedInsertion O B P Q ≫ (FiniteTensor.tensor (V := C)).map
        (representativeCofanMap O.toCollection B (ColoredSubstitutionData.rightUnit P)
          (rightUnitChoices P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let X := O.toCollection.obj (extendProfile P Q)
  let L := (addedAlgebraInputs B).obj Q
  let Y := fun i => O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
    (P.inputColor i))
    emptyColoredInputs)
  let Z := (linearCoefficientDiagram O.toCollection B P).obj Q
  let f := linearCoefficientι O.toCollection B P Q
  let a := UnitGeometry.rightWeightedFactor X L P.inputs Y (rightUnitCoefficient O P)
  let b := ColoredOperadObj.UnitInsertion.rightFactorHom (linearCoefficientCollection
    O.toCollection B)
    (envelopingLinearUnit O B) P
  let e := (rightUnitWeightedFamilyIso O.toCollection B P Q).hom
  let k := envelopingLinearCofanFamilyMap O.toCollection B
    (ColoredSubstitutionData.rightUnit P) (rightUnitChoices P Q)
  let g := e ≫ k
  have ha : (FiniteFamily.map T).map (UnitGeometry.rightRootMap f P.inputs) ≫ b = a ≫ g := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none =>
        let R := ColoredSubstitutionData.rightUnitOuterHom P
        let c := O.toCollection.map (extendProfileMap R (𝟙 Q))
        let U := coefficientLeafTensorFunctor L
        let j := linearCoefficientι O.toCollection B (ColoredSubstitutionData.rightUnit
          P).outerProfile Q
        let v := (linearCoefficientCollection O.toCollection B).map R
        let s := (FiniteTensor.singletonIso (V := C)).hom.app Z
        let t := (FiniteTensor.singletonIso (V := C)).hom.app (linearCoefficient O.toCollection B P)
        have hmap : T.map (coefficientLeafMap c ((addedAlgebraInputs B).map (𝟙 Q))) = U.map c :=
          (congrArg (fun l => T.map (coefficientLeafMap c l)) ((addedAlgebraInputs B).map_id
            Q)).trans
            (congrArg T.map (coefficientLeafMap_idLeaves c L))
        have hj : U.map c ≫ j = f ≫ v :=
          (congrArg (· ≫ j) hmap).symm.trans (linearCoefficientι_joint O.toCollection B R (𝟙 Q))
        have hs : T.map ((FiniteFamily.singleton (C := C)).map f) ≫ t = s ≫ f :=
          (FiniteTensor.singletonIso (V := C)).hom.naturality f
        have h : T.map ((FiniteFamily.singleton (C := C)).map f) ≫ (t ≫ v) = s ≫ (U.map c ≫ j) :=
          (Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ v) hs).trans ((Category.assoc s f v).trans (congrArg (s ≫ ·) hj.symm)))
        exact heq_of_eq h
      | some i =>
        let u := envelopingLinearUnit O B (P.inputColor i)
        let j := linearCoefficientι O.toCollection B (ColoredSubstitutionData.unitProfile
          (P.inputColor i))
          emptyColoredInputs
        let d := (emptyLeafTensorIso (Y i)).inv
        let h := T.map (coefficientLeafMap (𝟙 (Y i)) (emptyAddedAlgebraInputsIso B).inv)
        have hl : T.map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ u = u :=
          (congrArg (· ≫ u) (T.map_id _)).trans (Category.id_comp u)
        have hr : (rightUnitCoefficient O P i ≫ d) ≫ (h ≫ j) = u :=
          (Category.assoc (rightUnitCoefficient O P i) d (h ≫ j)).trans
            ((appendEmptyUnit (rightUnitCoefficient O P i) d h j).trans
              ((congrArg (· ≫ j) (unitEmptySummand_tensor O B (P.inputColor i))).trans
                (Category.assoc _ _ _)))
        exact heq_of_eq (hl.trans hr.symm)
  have hn := UnitGeometry.rightInsertion_naturality f P.inputs a b g ha
  have hk : representativeCofanMap O.toCollection B (ColoredSubstitutionData.rightUnit P)
    (rightUnitChoices P Q) = k :=
    representativeCofanMap_eq _ _ _ _
  have hm : T.map e ≫ T.map k = T.map g := (T.map_comp _ _).symm
  have ht : (UnitInsertion.rightInsertFromFactor Z P.inputs a ≫ T.map e) ≫ T.map k =
      UnitInsertion.rightInsertFromFactor Z P.inputs a ≫ T.map g :=
    (Category.assoc _ _ _).trans (congrArg (UnitInsertion.rightInsertFromFactor Z P.inputs a
      ≫ ·) hm)
  exact hn.trans (ht.symm.trans (congrArg (rightUnitWeightedInsertion O B P Q ≫
    ·) (congrArg T.map hk.symm)))


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
