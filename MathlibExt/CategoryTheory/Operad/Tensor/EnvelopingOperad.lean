/-!
# Original coefficient relabeling followed by the original leaf map
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- Coefficient interchange followed by any complete original leaf
map retains precisely the original coefficient maps. The input identities
here are the actual identities of the original supplied families. -/
theorem interchangeAfterCoefficientMap (I : FintypeCat.{0})
    {K K' : I → C} (k : ∀ i, K i ⟶ K' i)
    (L : I → FiniteFamily C) {M : FiniteFamily C}
    (l : totalBlockInputs I L ⟶ M) :
    (FiniteTensor.tensor (V := C)).map
        (weightedInputBlockMap I k (fun i => 𝟙 (L i))) ≫
      (coefficientBlockInterchangeTensorIso I K' L).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          (𝟙 ((FiniteTensor.tensor (V := C)).obj (coefficientBlockFamily I K'))) l) =
    (coefficientBlockInterchangeTensorIso I K L).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap
          ((FiniteTensor.tensor (V := C)).map (coefficientBlockMap I k)) l) := by
  let T := FiniteTensor.tensor (V := C)
  have hi : inputBlockMap I (fun i => 𝟙 (L i)) = 𝟙 (inputBlockFamily I L) := rfl
  have hn := coefficientBlockInterchangeTensorIso_naturality I k (fun i => 𝟙 (L i))
  rw [hi, Functor.map_id] at hn
  have hl : coefficientLeafMap (T.map (coefficientBlockMap I k))
      (𝟙 (totalBlockInputs I L)) ≫
        coefficientLeafMap (𝟙 (T.obj (coefficientBlockFamily I K'))) l =
      coefficientLeafMap (T.map (coefficientBlockMap I k)) l := by
    rw [coefficientLeafMap_comp, Category.comp_id, Category.id_comp]
  have ht := (T.map_comp _ _).symm.trans (congrArg T.map hl)
  have hp := congrArg (· ≫ T.map
    (coefficientLeafMap (𝟙 (T.obj (coefficientBlockFamily I K'))) l)) hn
  exact (Category.assoc _ _ _).symm.trans
    (hp.trans ((Category.assoc _ _ _).trans
      (congrArg ((coefficientBlockInterchangeTensorIso I K L).hom ≫ ·) ht)))

/-- The actual coefficient permutation and its actual inverse cancel
after full tensor interchange. Every input-family map and the entire final
leaf map remain in the resulting original normalization morphism. -/
theorem interchangeAfterCoefficientIso {K K' : FiniteFamily C} (k : K ≅ K')
    (L : K.index → FiniteFamily C) (L' : K'.index → FiniteFamily C)
    (l : ∀ i, L i ⟶ L' (k.hom.equiv i)) {M : FiniteFamily C}
    (m : totalBlockInputs K'.index L' ⟶ M) :
    (FiniteTensor.tensor (V := C)).map
        (weightedInputBlockRelabelMap k.hom.equiv k.hom.hom l) ≫
      (coefficientBlockInterchangeTensorIso K'.index K'.obj L').hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map k.inv) m) =
    (coefficientBlockInterchangeTensorIso K.index K.obj L).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 ((FiniteTensor.tensor (V := C)).obj K))
          ((FiniteFamily.flatten (C := C)).map
            (inputBlockRelabelMap k.hom.equiv l) ≫ m)) := by
  let T := FiniteTensor.tensor (V := C)
  let f := (FiniteFamily.flatten (C := C)).map (inputBlockRelabelMap k.hom.equiv l)
  have hn : T.map (weightedInputBlockRelabelMap k.hom.equiv k.hom.hom l) ≫
      (coefficientBlockInterchangeTensorIso K'.index K'.obj L').hom =
      (coefficientBlockInterchangeTensorIso K.index K.obj L).hom ≫
        T.map (coefficientLeafMap (T.map k.hom) f) :=
    coefficientBlockInterchangeTensorIso_relabel k.hom.equiv k.hom.hom l
  have hk : T.map k.hom ≫ T.map k.inv = 𝟙 (T.obj K) :=
    (T.map_comp _ _).symm.trans ((congrArg T.map k.hom_inv_id).trans (T.map_id K))
  have hl : coefficientLeafMap (T.map k.hom) f ≫ coefficientLeafMap (T.map k.inv) m =
      coefficientLeafMap (𝟙 (T.obj K)) (f ≫ m) :=
    (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg (fun c => coefficientLeafMap c (f ≫ m)) hk)
  have ht := (T.map_comp _ _).symm.trans (congrArg T.map hl)
  have hp := congrArg (· ≫ T.map (coefficientLeafMap (T.map k.inv) m)) hn
  exact (Category.assoc _ _ _).symm.trans
    (hp.trans ((Category.assoc _ _ _).trans
      (congrArg ((coefficientBlockInterchangeTensorIso K.index K.obj L).hom ≫ ·) ht)))


end CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

end
