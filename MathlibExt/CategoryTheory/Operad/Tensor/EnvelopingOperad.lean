      (nilLeafFactorsIso A d Y).hom =
    (nilLeafFactorsIso A d X).hom ≫ (FiniteFamily.singleton (C := C)).map f := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)
    | some i => exact Fin.elim0 i

/-- The original nullary tensor unitor is natural in the whole actual coefficient map. -/
theorem nilLeafUnitor_naturality (A : W → C) (d : W) {X Y : C} (f : X ⟶ Y) :
    (coefficientLeafTensorFunctor (profileLeafFamily A (ColoredProfile.nullary d))).map f ≫
      (nilLeafUnitor A d Y).hom = (nilLeafUnitor A d X).hom ≫ f := by
  let T := FiniteTensor.tensor (V := C)
  let c := T.map ((coefficientLeafFamilyFunctor (profileLeafFamily A (ColoredProfile.nullary
    d))).map f)
  let nX := T.map (nilLeafFactorsIso A d X).hom
  let nY := T.map (nilLeafFactorsIso A d Y).hom
  let sX := (FiniteTensor.singletonIso (V := C)).hom.app X
  let sY := (FiniteTensor.singletonIso (V := C)).hom.app Y
  let k := T.map ((FiniteFamily.singleton (C := C)).map f)
  have h : c ≫ nY = nX ≫ k := (T.map_comp _ _).symm.trans
    ((congrArg T.map (nilLeafFactors_naturality A d f)).trans (T.map_comp _ _))
  exact (Category.assoc c nY sY).symm.trans
    ((congrArg (· ≫ sY) h).trans ((Category.assoc nX k sY).trans
      ((congrArg (nX ≫ ·) ((FiniteTensor.singletonIso (V :=
        C)).hom.naturality f)).trans (Category.assoc nX sX
        f).symm)))

/-- The inverse original nullary tensor unitor retains the original coefficient map. -/
theorem nilLeafUnitor_inv_naturality (A : W → C) (d : W) {X Y : C} (f : X ⟶ Y) :
    (nilLeafUnitor A d X).inv ≫ (coefficientLeafTensorFunctor (profileLeafFamily A
      (ColoredProfile.nullary d))).map f =
      f ≫ (nilLeafUnitor A d Y).inv := by
  let e := nilLeafUnitor A d X
  let e' := nilLeafUnitor A d Y
  let k := (coefficientLeafTensorFunctor (profileLeafFamily A (ColoredProfile.nullary d))).map f
  have h : k ≫ e'.hom = e.hom ≫ f := nilLeafUnitor_naturality A d f
  apply (cancel_mono e'.hom).1
  have h1 : (e.inv ≫ k) ≫ e'.hom = f := (Category.assoc e.inv k e'.hom).trans
    ((congrArg (e.inv ≫ ·) h).trans ((Category.assoc e.inv e.hom f).symm.trans
      ((congrArg (· ≫ f) e.inv_hom_id).trans (Category.id_comp f))))
  have h2 : (f ≫ e'.inv) ≫ e'.hom = f := (Category.assoc f e'.inv e'.hom).trans
    ((congrArg (f ≫ ·) e'.inv_hom_id).trans (Category.comp_id f))
  exact h1.trans h2.symm

omit [FiniteTensor C] in
/-- The original profile tensor-factor comparison retains exactly the
original nullary coefficient and Fin-0 factor bijection. -/
theorem nilLeafFactors_profile (O : ColoredSymmetricCollection W C) (A : W → C) (d : W) :
    (profileOperationFactorsIso O A (ColoredProfile.nullary d)).hom ≫
      (nullaryFactorsIso O A d).hom =
      (nilLeafFactorsIso A d (O.obj (ColoredProfile.nullary d))).hom := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with | none => rfl | some i => exact Fin.elim0 i
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp (𝟙 (O.obj (ColoredProfile.nullary d))))
    | some i => exact Fin.elim0 i

/-- The actual inverse nullary summand is the actual original inverse
empty-leaf unitor followed by the original full profile tensor comparison. -/
theorem nilLeafUnitor_profile (O : ColoredSymmetricCollection W C) (A : W → C) (d : W) :
    (nilLeafUnitor A d (O.obj (ColoredProfile.nullary d))).inv ≫
      (profileCoefficientLeafTensorIso O A (ColoredProfile.nullary d)).hom =
        (nullarySummandIso O A d).inv := by
  let T := FiniteTensor.tensor (V := C)
  let e := nilLeafUnitor A d (O.obj (ColoredProfile.nullary d))
  let p := profileCoefficientLeafTensorIso O A (ColoredProfile.nullary d)
  let n := nullarySummandIso O A d
  let s := (FiniteTensor.singletonIso (V := C)).hom.app (O.obj (ColoredProfile.nullary d))
  have hmap : p.hom ≫ T.map (nullaryFactorsIso O A d).hom =
    T.map (nilLeafFactorsIso A d (O.obj (ColoredProfile.nullary
    d))).hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map (nilLeafFactors_profile O A d))
  have h : p.hom ≫ n.hom = e.hom := (Category.assoc p.hom (T.map (nullaryFactorsIso O A
    d).hom) s).symm.trans
    (congrArg (· ≫ s) hmap)
  apply (cancel_mono n.hom).1
  exact (Category.assoc e.inv p.hom n.hom).trans
    ((congrArg (e.inv ≫ ·) h).trans (e.inv_hom_id.trans n.inv_hom_id.symm))

/-- The actual original raw nil-leaf block has precisely its retained
coefficient block, through the actual original empty outer-index bijection. -/
def nilBlocksIso (K : FiniteFamily C) (A : W → C) (d : W) :
    coefficientLeavesNested K (profileLeafFamily A (ColoredProfile.nullary d)) ≅
      (FiniteFamily.singleton (C := FiniteFamily C)).obj K where
  hom :=
    { equiv := nilOptionEquiv
      hom i := match i with | none => 𝟙 K | some i => Fin.elim0 i }
  inv := { equiv := nilOptionEquiv.symm, hom _ := 𝟙 K }
  hom_inv_id := by
    apply FiniteFamily.Hom_ext
    · exact nilOptionEquiv.self_trans_symm
    · intro i
      cases i with | none => exact heq_of_eq (Category.id_comp (𝟙 K)) | some i => exact Fin.elim0 i
  inv_hom_id := by
    apply FiniteFamily.Hom_ext
    · exact nilOptionEquiv.symm_trans_self
    · intro i
      cases i
      exact heq_of_eq (Category.id_comp (𝟙 K))

/-- The actual original raw coefficient/Fin-0-leaf family is the original
coefficient family by deleting exactly its original empty dependent fibers. -/
def nilCoefficientFlattenIso (K : FiniteFamily C) (A : W → C) (d : W) :
    (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K (profileLeafFamily A
      (ColoredProfile.nullary d))) ≅
      K where
  hom :=
    { equiv :=
        { toFun := fun p => match p with | ⟨none, k⟩ => k | ⟨some i, _⟩ => Fin.elim0 i
          invFun := fun k => ⟨none, k⟩
          left_inv := fun p =>
            by rcases p with ⟨i, j⟩; cases i with | none => rfl | some i => exact Fin.elim0 i
          right_inv := fun _ => rfl }
      hom p := match p with | ⟨none, k⟩ => 𝟙 (K.obj k) | ⟨some i, _⟩ => Fin.elim0 i }
  inv :=
    { equiv :=
        { toFun := fun k => ⟨none, k⟩
          invFun := fun p => match p with | ⟨none, k⟩ => k | ⟨some i, _⟩ => Fin.elim0 i
          left_inv := fun _ => rfl
          right_inv := fun p =>
            by rcases p with ⟨i, j⟩; cases i with | none => rfl | some i => exact Fin.elim0 i }
      hom k := 𝟙 (K.obj k) }
  hom_inv_id := by
    apply FiniteFamily.Hom_ext
    · apply Equiv.ext
      intro p
      rcases p with ⟨i, j⟩
      cases i with | none => rfl | some i => exact Fin.elim0 i
    · intro p
      rcases p with ⟨i, j⟩
      cases i with
        | none => exact heq_of_eq (Category.id_comp (𝟙 (K.obj j)))
        | some i => exact Fin.elim0 i
  inv_hom_id := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro k
      exact heq_of_eq (Category.id_comp (𝟙 (K.obj k)))


