      (coefficientLeafMap (𝟙 Y) ell₀) (coefficientLeafMap (𝟙 Y) t₀)).symm.trans
      ((congrArg T.map (coefficientLeafMap_twoLeaves c ell₀ t₀)).trans (T.map_comp _ _))
