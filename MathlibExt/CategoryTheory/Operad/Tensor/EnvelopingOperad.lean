/- Exact checked source: FrozenBranchNormalizationNaturality. -/
section EnvelopingSource018


/-!
# Naturality of the original weighted branch tensor normalization
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem fourOriginalTensorSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' H H' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (s : E ⟶ H) (s' : E' ⟶ H') (k : H ⟶ H')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g)
    (hr : g ≫ r' = r ≫ h) (hs : h ≫ s' = s ≫ k) :
    l ≫ (p' ≫ q' ≫ r' ≫ s') = (p ≫ q ≫ r ≫ s) ≫ k := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, ← Category.assoc g r', hr, Category.assoc r h, hs]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The source normalization of the actual weighted root/branch
tensor commutes with every original branch profile map and every
retained algebra input color transport. -/
theorem frozenBranchTensorNormalizationIso_naturality (O : ColoredSymmetricCollection W C)
    (B : W → C) (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteTensor.tensor (V := C)).map (frozenWeightedBranchMap O B P Q f) ≫
        (frozenBranchTensorNormalizationIso O B P Q S).hom =
      (frozenBranchTensorNormalizationIso O B P Q R).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map ((frozenCoefficientFunctor
            O P Q).map f))
            (frozenAlgebraLeavesMap B Q f)) := by
  let T := FiniteTensor.tensor (V := C)
  let n := frozenWeightedNestedMap O B P Q f
  let k := (frozenCoefficientFunctor O P Q).map f
  let l := frozenAlgebraLeavesMap B Q f
  let m := coefficientLeavesNestedMap k l
  have h1 : T.map (frozenWeightedBranchMap O B P Q f) ≫ T.map (frozenWeightedRootIso O B P
    Q S).hom =
      T.map (frozenWeightedRootIso O B P Q R).hom ≫ T.map ((FiniteFamily.map T).map n) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (frozenWeightedRootIso_naturality O B P Q f).symm).trans (T.map_comp _ _))
  have h2 : T.map ((FiniteFamily.map T).map n) ≫
        (FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q S) =
      (FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q R) ≫
        T.map ((FiniteFamily.flatten (C := C)).map n) :=
    (FiniteTensor.flattenIso (V := C)).inv.naturality n
  have h3 : T.map ((FiniteFamily.flatten (C := C)).map n) ≫
    T.map (frozenBranchLeafIso O B P Q S).hom =
      T.map (frozenBranchLeafIso O B P Q R).hom ≫ T.map ((FiniteFamily.flatten (C := C)).map m) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (frozenBranchLeafIso_naturality O B P Q f)).trans (T.map_comp _ _))
  have h4 : T.map ((FiniteFamily.flatten (C := C)).map m) ≫
        (coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q S)
          (frozenAlgebraLeaves B Q S)).hom =
      (coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q R)
        (frozenAlgebraLeaves B Q R)).hom ≫
        T.map (coefficientLeafMap (T.map k) l) := by
    rw [coefficientLeavesNormalizationIso_hom, coefficientLeavesNormalizationIso_hom]
    exact coefficientLeavesNormalization_naturality k l
  have h := fourOriginalTensorSquares
    (T.map (frozenWeightedBranchMap O B P Q f))
    (T.map (frozenWeightedRootIso O B P Q R).hom) (T.map (frozenWeightedRootIso O B P Q S).hom)
    (T.map ((FiniteFamily.map T).map n))
    ((FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q R))
    ((FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q S))
    (T.map ((FiniteFamily.flatten (C := C)).map n))
    (T.map (frozenBranchLeafIso O B P Q R).hom) (T.map (frozenBranchLeafIso O B P Q S).hom)
    (T.map ((FiniteFamily.flatten (C := C)).map m))
    ((coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q R)
      (frozenAlgebraLeaves B Q R)).hom)
    ((coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q S)
      (frozenAlgebraLeaves B Q S)).hom)
    (T.map (coefficientLeafMap (T.map k) l)) h1 h2 h3 h4
  exact h


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource018

/- Exact checked source: FrozenWeightedEvaluationNaturality. -/
section EnvelopingSource019


/-!
# Actual weighted branch evaluations form original profile-colimit cocones
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem originalEvaluationSquares {V : Type*} [Category* V]
    {A A' B B' D D' : V} (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) :
    l ≫ (p' ≫ q') = (p ≫ q) ≫ g := by
  rw [← Category.assoc l p', hp, Category.assoc p f, hq, Category.assoc]

private theorem originalCoefficientLeafEvaluationSquare {V : Type*} [Category* V]
    {X X' Y Y' : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (g : Y ⟶ Y')
    {L M : FiniteFamily V} (l : L ⟶ M) (h : k ≫ a' = a ≫ g) :
    coefficientLeafMap k l ≫ (coefficientLeafFamilyFunctor M).map a' =
      (coefficientLeafFamilyFunctor L).map a ≫ coefficientLeafMap g l :=
  (coefficientLeafMap_post k a' l).trans
    ((congrArg (fun f => coefficientLeafMap f l) h).trans (coefficientLeafMap_pre a g l).symm)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Evaluate retained coefficients after the original joint
coefficient/leaf map, or before its actual total-profile map. -/
theorem frozenLeafEvaluation_naturality (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map ((frozenCoefficientFunctor
          O.toCollection P Q).map f))
          (frozenAlgebraLeavesMap B Q f)) ≫
        (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q S)).map
          (frozenPartialSubstitution O P Q S) =
      (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).map
        (frozenPartialSubstitution O P Q R) ≫
        (linearCoefficientDiagram O.toCollection B P).map (frozenTotalInputsMap Q f) := by
  let T := FiniteTensor.tensor (V := C)
  let k := (frozenCoefficientFunctor O.toCollection P Q).map f
  let l := frozenAlgebraLeavesMap B Q f
  let g := extendProfileMap (𝟙 P) (frozenTotalInputsMap Q f)
  have h : coefficientLeafMap (T.map k) l ≫
        (coefficientLeafFamilyFunctor (frozenAlgebraLeaves B Q S)).map
          (frozenPartialSubstitution O P Q S) =
      (coefficientLeafFamilyFunctor (frozenAlgebraLeaves B Q R)).map
        (frozenPartialSubstitution O P Q R) ≫
        coefficientLeafMap (O.toCollection.map g) l :=
    originalCoefficientLeafEvaluationSquare (T.map k) (frozenPartialSubstitution O P Q R)
      (frozenPartialSubstitution O P Q S) (O.toCollection.map g) l
      (frozenPartialSubstitution_naturality O P Q f)
  exact (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))

/-- The actual original weighted branch evaluation retains its
source tensor map and its exact original total input profile map. -/
theorem frozenWeightedBranchEvaluation_naturality (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteTensor.tensor (V := C)).map (frozenWeightedBranchMap O.toCollection B P Q f) ≫
        frozenWeightedBranchEvaluation O B P Q S =
      frozenWeightedBranchEvaluation O B P Q R ≫
        (linearCoefficientDiagram O.toCollection B P).map (frozenTotalInputsMap Q f) :=
  originalEvaluationSquares
    ((FiniteTensor.tensor (V := C)).map (frozenWeightedBranchMap O.toCollection B P Q f))
    (frozenBranchTensorNormalizationIso O.toCollection B P Q R).hom
    (frozenBranchTensorNormalizationIso O.toCollection B P Q S).hom
    ((FiniteTensor.tensor (V := C)).map
      (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map ((frozenCoefficientFunctor
        O.toCollection P Q).map f))
        (frozenAlgebraLeavesMap B Q f)))
    ((coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).map
      (frozenPartialSubstitution O P Q R))
    ((coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q S)).map
      (frozenPartialSubstitution O P Q S))
    ((linearCoefficientDiagram O.toCollection B P).map (frozenTotalInputsMap Q f))
    (frozenBranchTensorNormalizationIso_naturality O.toCollection B P Q f)
    (frozenLeafEvaluation_naturality O B P Q f)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The original weighted branch evaluations agree after the
actual original profile coinvariant relation, so they descend
through the complete original inner-profile colimit. -/
theorem frozenWeightedBranchEvaluation_colimit_relation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) {R S : FrozenBranchTuple Q} (f : R ⟶ S) :
    (FiniteTensor.tensor (V := C)).map (frozenWeightedBranchMap O.toCollection B P Q f) ≫
        (frozenWeightedBranchEvaluation O B P Q S ≫
          linearCoefficientι O.toCollection B P (frozenTotalInputs Q S)) =
      frozenWeightedBranchEvaluation O B P Q R ≫
        linearCoefficientι O.toCollection B P (frozenTotalInputs Q R) := by
  rw [← Category.assoc, frozenWeightedBranchEvaluation_naturality, Category.assoc,
    linearCoefficient_relabel]


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource019

/- Exact checked source: OuterWeightedNaturality. -/
section EnvelopingSource020


/-!
# Full outer naturality of weighted normalization and evaluation

The four displayed normalization comparisons each commute with the original
outer and branch maps. Their composite therefore gives the tensor square,
which combines with actual partial substitution and the genuine linear
coefficient colimit relation.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Outer

open CategoryTheory Limits

private theorem composeFourSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' H H' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (s : E ⟶ H) (s' : E' ⟶ H') (k : H ⟶ H')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g)
    (hr : g ≫ r' = r ≫ h) (hs : h ≫ s' = s ≫ k) :
    l ≫ (p' ≫ q' ≫ r' ≫ s') = (p ≫ q ≫ r ≫ s) ≫ k := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, ← Category.assoc g r', hr, Category.assoc r h, hs]
  simp only [Category.assoc]

private theorem composeEvaluationSquares {V : Type*} [Category* V]
    {A A' B B' D D' : V} (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) :
    l ≫ (p' ≫ q') = (p ≫ q) ≫ g := by
  rw [← Category.assoc l p', hp, Category.assoc p f, hq, Category.assoc]

private theorem coefficientLeafEvaluationSquare {V : Type*} [Category* V]
    {X X' Y Y' : V} (k : X ⟶ X') (a : X ⟶ Y) (a' : X' ⟶ Y') (g : Y ⟶ Y')
    {L M : FiniteFamily V} (l : L ⟶ M) (h : k ≫ a' = a ≫ g) :
    coefficientLeafMap k l ≫ (coefficientLeafFamilyFunctor M).map a' =
      (coefficientLeafFamilyFunctor L).map a ≫ coefficientLeafMap g l :=
  (coefficientLeafMap_post k a' l).trans
    ((congrArg (fun f => coefficientLeafMap f l) h).trans (coefficientLeafMap_pre a g l).symm)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The complete original weighted tensor normalization commutes
with all outer and original branch arrows and their actual coefficient
and dependent-sum algebra-leaf tensor maps. -/
theorem branchTensorNormalizationIso_naturality (O : ColoredSymmetricCollection W C)
    (B : W → C) (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map (weightedBranchMap O B P g h) ≫
        (frozenBranchTensorNormalizationIso O B P Q' S).hom =
      (frozenBranchTensorNormalizationIso O B P Q R).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (coefficientMap O P g h))
            (algebraLeavesMap B g h)) := by
  let T := FiniteTensor.tensor (V := C)
  let n := weightedNestedMap O B P g h
  let k := coefficientMap O P g h
  let l := algebraLeavesMap B g h
  let m := coefficientLeavesNestedMap k l
  have h1 : T.map (weightedBranchMap O B P g h) ≫ T.map (frozenWeightedRootIso O B P Q' S).hom =
      T.map (frozenWeightedRootIso O B P Q R).hom ≫ T.map ((FiniteFamily.map T).map n) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (weightedRootIso_naturality O B P g h).symm).trans (T.map_comp _ _))
  have h2 : T.map ((FiniteFamily.map T).map n) ≫
        (FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q' S) =
      (FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q R) ≫
        T.map ((FiniteFamily.flatten (C := C)).map n) :=
    (FiniteTensor.flattenIso (V := C)).inv.naturality n
  have h3 : T.map ((FiniteFamily.flatten (C := C)).map n) ≫
        T.map (frozenBranchLeafIso O B P Q' S).hom =
      T.map (frozenBranchLeafIso O B P Q R).hom ≫ T.map ((FiniteFamily.flatten (C := C)).map m) :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (branchLeafIso_naturality O B P g h)).trans (T.map_comp _ _))
  have h4 : T.map ((FiniteFamily.flatten (C := C)).map m) ≫
        (coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q' S)
          (frozenAlgebraLeaves B Q' S)).hom =
      (coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q R)
        (frozenAlgebraLeaves B Q R)).hom ≫ T.map (coefficientLeafMap (T.map k) l) := by
    rw [coefficientLeavesNormalizationIso_hom, coefficientLeavesNormalizationIso_hom]
    exact coefficientLeavesNormalization_naturality k l
  exact composeFourSquares
    (T.map (weightedBranchMap O B P g h))
    (T.map (frozenWeightedRootIso O B P Q R).hom) (T.map (frozenWeightedRootIso O B P Q' S).hom)
    (T.map ((FiniteFamily.map T).map n))
    ((FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q R))
    ((FiniteTensor.flattenIso (V := C)).inv.app (frozenWeightedNestedFamily O B P Q' S))
    (T.map ((FiniteFamily.flatten (C := C)).map n))
    (T.map (frozenBranchLeafIso O B P Q R).hom) (T.map (frozenBranchLeafIso O B P Q' S).hom)
    (T.map ((FiniteFamily.flatten (C := C)).map m))
    ((coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q R)
      (frozenAlgebraLeaves B Q R)).hom)
    ((coefficientLeavesNormalizationIso (frozenCoefficientFamily O P Q' S)
      (frozenAlgebraLeaves B Q' S)).hom)
    (T.map (coefficientLeafMap (T.map k) l)) h1 h2 h3 h4

/-- The original joint coefficient/leaf tensor map commutes with
the actual partial substitution and its total-profile operation map. -/
theorem leafEvaluation_naturality (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (coefficientMap
          O.toCollection P g h))
          (algebraLeavesMap B g h)) ≫
        (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q' S)).map
          (frozenPartialSubstitution O P Q' S) =
      (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).map
        (frozenPartialSubstitution O P Q R) ≫
        (linearCoefficientDiagram O.toCollection B P).map (totalInputsMap g h) := by
  let T := FiniteTensor.tensor (V := C)
  let k := coefficientMap O.toCollection P g h
  let l := algebraLeavesMap B g h
  let t := extendProfileMap (𝟙 P) (totalInputsMap g h)
  have hs : coefficientLeafMap (T.map k) l ≫
        (coefficientLeafFamilyFunctor (frozenAlgebraLeaves B Q' S)).map
          (frozenPartialSubstitution O P Q' S) =
      (coefficientLeafFamilyFunctor (frozenAlgebraLeaves B Q R)).map
        (frozenPartialSubstitution O P Q R) ≫
        coefficientLeafMap (O.toCollection.map t) l :=
    coefficientLeafEvaluationSquare (T.map k) (frozenPartialSubstitution O P Q R)
      (frozenPartialSubstitution O P Q' S) (O.toCollection.map t) l
      (partialSubstitution_naturality O P g h)
  exact (T.map_comp _ _).symm.trans ((congrArg T.map hs).trans (T.map_comp _ _))

/-- Actual evaluation of the complete weighted branch tensor is
natural in every outer bijection and every original full branch arrow. -/
theorem weightedBranchEvaluation_naturality (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map (weightedBranchMap O.toCollection B P g h) ≫
        frozenWeightedBranchEvaluation O B P Q' S =
      frozenWeightedBranchEvaluation O B P Q R ≫
        (linearCoefficientDiagram O.toCollection B P).map (totalInputsMap g h) :=
  composeEvaluationSquares
    ((FiniteTensor.tensor (V := C)).map (weightedBranchMap O.toCollection B P g h))
    (frozenBranchTensorNormalizationIso O.toCollection B P Q R).hom
    (frozenBranchTensorNormalizationIso O.toCollection B P Q' S).hom
    ((FiniteTensor.tensor (V := C)).map
      (coefficientLeafMap ((FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection P g h))
        (algebraLeavesMap B g h)))
    ((coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).map
      (frozenPartialSubstitution O P Q R))
    ((coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q' S)).map
      (frozenPartialSubstitution O P Q' S))
    ((linearCoefficientDiagram O.toCollection B P).map (totalInputsMap g h))
    (branchTensorNormalizationIso_naturality O.toCollection B P g h)
    (leafEvaluation_naturality O B P g h)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- The actual original coefficient colimit relation makes all outer
and branch evaluations agree after their genuine total-input injections. -/
theorem weightedBranchEvaluation_colimit_relation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map (weightedBranchMap O.toCollection B P g h) ≫
        (frozenWeightedBranchEvaluation O B P Q' S ≫
          linearCoefficientι O.toCollection B P (frozenTotalInputs Q' S)) =
      frozenWeightedBranchEvaluation O B P Q R ≫
        linearCoefficientι O.toCollection B P (frozenTotalInputs Q R) := by
  rw [← Category.assoc, weightedBranchEvaluation_naturality, Category.assoc,
    linearCoefficient_relabel]


end CategoryTheory.Operad.Tensor.Enveloping.Outer

end
end EnvelopingSource020

/- Exact checked source: RootedFrozenEvaluationCocone. -/
section EnvelopingSource021


/-!
# Actual partial-substitution cocone on the original root/inner profile tensor diagram
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [∀ d : W, HasColimitsOfShape (AnalyticIndex W d) C]

/-- Retain every original inner profile from the original slot
tuple; its unique root coefficient index changes no operation. -/
def rootedFrozenBranches (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) : FrozenBranchTuple Q :=
  fun j => R (some j)

/-- The original slot tuple maps retain every original branch
map and introduce no new input order. -/
def rootedFrozenBranchesMap (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)} (f : R ⟶ S) :
    rootedFrozenBranches P Q R ⟶ rootedFrozenBranches P Q S := fun j => f (some j)

/-- The original rooted tensor source has the same actual
coefficient/input objects as the original weighted branch family. -/
def rootedFrozenFamilyIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    (FiniteFamily.fixedIndexFunctor (analyticFactorsIndex ((inputsToProfile
      P.outputColor).obj Q))).obj
      ((Functor.pi (rootedSlotDiagram (O.obj (extendProfile P Q)) O B
        ((inputsToProfile P.outputColor).obj Q))).obj R) ≅
      frozenWeightedBranchFamily O B P Q (rootedFrozenBranches P Q R) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => Iso.refl _
    | some _ => Iso.refl _)

omit [∀ d : W, HasColimitsOfShape (AnalyticIndex W d) C] in
/-- Every original slot tuple morphism commutes with the actual
retained root/branch family comparison. -/
theorem rootedFrozenFamilyIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    {R S : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)} (f : R ⟶ S) :
    (FiniteFamily.fixedIndexFunctor (analyticFactorsIndex ((inputsToProfile
      P.outputColor).obj Q))).map
        ((Functor.pi (rootedSlotDiagram (O.obj (extendProfile P Q)) O B
          ((inputsToProfile P.outputColor).obj Q))).map f) ≫ (rootedFrozenFamilyIso O B P Q S).hom =
      (rootedFrozenFamilyIso O B P Q R).hom ≫
        frozenWeightedBranchMap O B P Q (rootedFrozenBranchesMap P Q f) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => rfl
    | some j =>
      change HEq ((analyticSummand O B).map (f (some j)) ≫ 𝟙 _)
        (𝟙 _ ≫ (analyticSummand O B).map (f (some j)))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- Actual partial substitution of every original weighted
branch choice, followed by its actual linear coefficient injection. -/
def rootedFrozenEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    (rootedSlotTensorDiagram (O.toCollection.obj (extendProfile P Q)) O.toCollection B
      ((inputsToProfile P.outputColor).obj Q)).obj R ⟶ linearCoefficient O.toCollection B P :=
  (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom ≫
    frozenWeightedBranchEvaluation O B P Q (rootedFrozenBranches P Q R) ≫
      linearCoefficientι O.toCollection B P (frozenTotalInputs Q (rootedFrozenBranches P Q R))

/-- The actual original coefficient/inner-profile tensor diagram
has a partial-substitution cocone into the original linear coefficient
object, with every original tensor and profile map retained. -/
def rootedFrozenEvaluationCocone (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    Cocone (rootedSlotTensorDiagram (O.toCollection.obj (extendProfile P Q)) O.toCollection B
      ((inputsToProfile P.outputColor).obj Q)) where
  pt := linearCoefficient O.toCollection B P
  ι :=
    { app := rootedFrozenEvaluation O B P Q
      naturality {R S} f := by
        let T := FiniteTensor.tensor (V := C)
        let a := (FiniteFamily.fixedIndexFunctor
          (analyticFactorsIndex ((inputsToProfile P.outputColor).obj Q))).map
            ((Functor.pi (rootedSlotDiagram (O.toCollection.obj (extendProfile P Q))
              O.toCollection B
              ((inputsToProfile P.outputColor).obj Q))).map f)
        let g := frozenWeightedBranchMap O.toCollection B P Q (rootedFrozenBranchesMap P Q f)
        have h : T.map a ≫ T.map (rootedFrozenFamilyIso O.toCollection B P Q S).hom =
            T.map (rootedFrozenFamilyIso O.toCollection B P Q R).hom ≫ T.map g :=
          (T.map_comp _ _).symm.trans
            ((congrArg T.map (rootedFrozenFamilyIso_naturality O.toCollection B P Q
              f)).trans (T.map_comp _ _))
        change T.map a ≫ (T.map (rootedFrozenFamilyIso O.toCollection B P Q S).hom ≫
          frozenWeightedBranchEvaluation O B P Q (rootedFrozenBranches P Q S) ≫
            linearCoefficientι O.toCollection B P (frozenTotalInputs Q
              (rootedFrozenBranches P Q S))) =
          rootedFrozenEvaluation O B P Q R ≫ 𝟙 _
        rw [← Category.assoc (T.map a) (T.map (rootedFrozenFamilyIso O.toCollection B P Q
          S).hom), h,
          Category.assoc, frozenWeightedBranchEvaluation_colimit_relation, Category.comp_id]
        rfl }


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource021

/- Exact checked source: ConstantInputSubstitution. -/
section EnvelopingSource022


/-!
# Actual partial-substitution descent at each original added-input profile
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used for rooted partial-substitution descent. -/
local instance {d : W} (Q : AnalyticIndex W d) (i : analyticFactorsIndex Q) :
    Category.{0} (profileSlotIndex Q i) := profileSlotCategory Q i

/-- The actual root/inner profile tensor colimit point is the
original added-input tensor with the original free O-algebra
carriers, through identity maps on every actual factor. -/
def rootedFrozenPointFamilyIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteFamily.fixedIndexFunctor (analyticFactorsIndex ((inputsToProfile
      P.outputColor).obj Q))).obj
      (fun i => (rootedSlotCocone (O.obj (extendProfile P Q)) O B
        ((inputsToProfile P.outputColor).obj Q) i).pt) ≅
      (coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs
        (profileCoinvariants O B))).obj Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index)) (fun i => match i with
    | none => Iso.refl _
    | some _ => Iso.refl _)

/-- The complete original tensor-profile colimit point is the
actual original linear coefficient summand on T_O(B). -/
def rootedFrozenPointIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (rootedSlotTensorCocone (O.obj (extendProfile P Q)) O B
      ((inputsToProfile P.outputColor).obj Q)).pt ≅
      (linearCoefficientDiagram O (profileCoinvariants O B) P).obj Q :=
  (FiniteTensor.tensor (V := C)).mapIso (rootedFrozenPointFamilyIso O B P Q)

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Actual original operadic partial substitution descends
through the original root/inner profile tensor colimit. It preserves
the original variable profile and lands in the actual L_P(B) object. -/
def constantInputSubstitution (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientDiagram O.toCollection (profileCoinvariants O.toCollection B) P).obj Q ⟶
      linearCoefficient O.toCollection B P :=
  (rootedFrozenPointIso O.toCollection B P Q).inv ≫
    (rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile P Q)) O.toCollection B
      ((inputsToProfile P.outputColor).obj Q)).desc (rootedFrozenEvaluationCocone O B P Q)

/-- Every original root/inner profile tensor choice has its
actual original injection into the free-carrier coefficient summand. -/
def rootedFrozenSummandInjection (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    (rootedSlotTensorDiagram (O.obj (extendProfile P Q)) O B
      ((inputsToProfile P.outputColor).obj Q)).obj R ⟶
      (linearCoefficientDiagram O (profileCoinvariants O B) P).obj Q :=
  (rootedSlotTensorCocone (O.obj (extendProfile P Q)) O B
    ((inputsToProfile P.outputColor).obj Q)).ι.app R ≫ (rootedFrozenPointIso O B P Q).hom

private theorem originalIsomorphismDescent {V : Type*} [Category* V] {A X Y Z : V}
    (i : A ⟶ X) (e : X ≅ Y) (f : X ⟶ Z) (g : A ⟶ Z) (h : i ≫ f = g) :
    (i ≫ e.hom) ≫ (e.inv ≫ f) = g := by
  rw [Category.assoc i e.hom, e.hom_inv_id_assoc]
  exact h

/-- The descended map evaluates each original coefficient/inner
profile choice by the actual original partial substitution and
original linear coefficient injection, with no map outcome as input. -/
theorem constantInputSubstitution_β (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫ constantInputSubstitution O B P Q =
      rootedFrozenEvaluation O B P Q R :=
  originalIsomorphismDescent
    ((rootedSlotTensorCocone (O.toCollection.obj (extendProfile P Q)) O.toCollection B
      ((inputsToProfile P.outputColor).obj Q)).ι.app R)
    (rootedFrozenPointIso O.toCollection B P Q)
    ((rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile P Q)) O.toCollection B
      ((inputsToProfile P.outputColor).obj Q)).desc (rootedFrozenEvaluationCocone O B P Q))
    (rootedFrozenEvaluation O B P Q R)
    ((rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile P Q)) O.toCollection B
      ((inputsToProfile P.outputColor).obj Q)).fac (rootedFrozenEvaluationCocone O B P Q) R)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource022

/- Exact checked source: OuterBranchInjection. -/
section EnvelopingSource023


/-!
# Original branch injections and the actual substitution beta rule

Full-profile equivariance of the actual coinvariant injections gives the
outer tensor injection square. The original rooted tensor cocone comparison
then converts the established substitution beta rule to these weighted
branch injections, retaining every root and inner profile choice.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Outer

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used to compare weighted branch injections with the substitution
beta rule. -/
local instance {d : W} (Q : AnalyticIndex W d) (i : analyticFactorsIndex Q) :
    Category.{0} (profileSlotIndex Q i) := profileSlotCategory Q i

/-- The actual profile coinvariant injections are natural under every
original full colored-profile map, including its output-color transport. -/
theorem profileι_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    {R S : ColoredProfile W} (h : R ⟶ S) :
    (operationSummandFunctor O B).map h ≫ profileι O B (profileInputs S) =
      profileι O B (profileInputs R) ≫ eqToHom (congrArg (profileCoinvariants O B)
        h.outputColor_eq) := by
  let a : Operations O B (profileCoinvariants O B) :=
    { app := fun _ R => profileι O B R
      equivariance := fun _ _ _ h => profile_relabel_ι O B h }
  exact a.profile_equivariance h

/-- The original root is retained and each weighted branch uses its
actual profile injection into the original free O-algebra carrier. -/
def branchInjection (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenWeightedBranchFamily O B P Q R ⟶
      (coefficientInputFactors (extendedCoefficient O P)
        (addedAlgebraInputs (profileCoinvariants O B))).obj Q where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 (O.obj (extendProfile P Q))
    | some j => profileι O B (R j)

/-- Every actual original outer and branch arrow commutes with the
original root/branch injection factors and the full coefficient map. -/
theorem branchInjection_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    weightedBranchMap O B P g h ≫ branchInjection O B P Q' S =
      branchInjection O B P Q R ≫
        (coefficientInputFactors (extendedCoefficient O P)
          (addedAlgebraInputs (profileCoinvariants O B))).map g := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap (𝟙 P) g) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap (𝟙 P) g))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some j =>
      exact heq_of_eq (profileι_naturality O B (h j))

/-- Tensoring the genuine injection-factor equality gives the full
original outer coefficient-diagram injection square. -/
theorem branchTensorInjection_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteTensor.tensor (V := C)).map (weightedBranchMap O B P g h) ≫
        (FiniteTensor.tensor (V := C)).map (branchInjection O B P Q' S) =
      (FiniteTensor.tensor (V := C)).map (branchInjection O B P Q R) ≫
        (linearCoefficientDiagram O (profileCoinvariants O B) P).map g :=
  ((FiniteTensor.tensor (V := C)).map_comp _ _).symm.trans
    ((congrArg (FiniteTensor.tensor (V := C)).map (branchInjection_naturality O B P g h)).trans
      ((FiniteTensor.tensor (V := C)).map_comp _ _))

/-- Every genuine rooted tensor injection is the tensor of its
original family comparison followed by the original branch injections. -/
theorem rootedFrozenSummandInjection_eq (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O B P Q R =
      (FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O B P Q R).hom ≫
        (FiniteTensor.tensor (V := C)).map (branchInjection O B P Q (rootedFrozenBranches P
          Q R)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteFamily.fixedIndexFunctor
    (analyticFactorsIndex ((inputsToProfile P.outputColor).obj Q))).map
      (fun i => (rootedSlotCocone (O.obj (extendProfile P Q)) O B
        ((inputsToProfile P.outputColor).obj Q) i).ι.app (R i))
  let b := (rootedFrozenPointFamilyIso O B P Q).hom
  let c := (rootedFrozenFamilyIso O B P Q R).hom
  let d := branchInjection O B P Q (rootedFrozenBranches P Q R)
  have hf : a ≫ b = c ≫ d := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none => rfl
      | some j =>
        change HEq (profileι O B (R (some j)) ≫ 𝟙 _) (𝟙 _ ≫ profileι O B (R (some j)))
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
  exact (T.map_comp a b).symm.trans ((congrArg T.map hf).trans (T.map_comp c d))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The actual rooted colimit beta rule evaluates every original
weighted branch injection by the original partial substitution and its
genuine original total-input coefficient injection. -/
theorem weightedBranchInjection_β (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W)
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    (FiniteTensor.tensor (V := C)).map
        (branchInjection O.toCollection B P Q (rootedFrozenBranches P Q R)) ≫
        constantInputSubstitution O B P Q =
      frozenWeightedBranchEvaluation O B P Q (rootedFrozenBranches P Q R) ≫
        linearCoefficientι O.toCollection B P (frozenTotalInputs Q (rootedFrozenBranches P
          Q R)) := by
  apply (cancel_epi ((FiniteTensor.tensor (V := C)).mapIso
    (rootedFrozenFamilyIso O.toCollection B P Q R)).hom).1
  exact (Category.assoc
    ((FiniteTensor.tensor (V := C)).map (rootedFrozenFamilyIso O.toCollection B P Q R).hom)
    ((FiniteTensor.tensor (V := C)).map
      (branchInjection O.toCollection B P Q (rootedFrozenBranches P Q R)))
    (constantInputSubstitution O B P Q)).symm.trans
      ((congrArg (fun k => k ≫ constantInputSubstitution O B P Q)
        (rootedFrozenSummandInjection_eq O.toCollection B P Q R).symm).trans
          (constantInputSubstitution_β O B P Q R))


end CategoryTheory.Operad.Tensor.Enveloping.Outer

end
end EnvelopingSource023

/- Exact checked source: OuterConstantInputNaturality. -/
section EnvelopingSource024


/-!
# Complete outer naturality of the actual constant-input substitution

The original outer bijection reindexes every original inner profile through
the existing slot relabelling functor. Actual injection transport and the
proved rooted colimit beta rule identify the two evaluations on every full
root/branch tensor summand. The genuine rooted tensor IsColimit then proves
equality of the complete original coefficient morphisms.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Outer

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used to relabel the outer constant-input action. -/
local instance {d : W} (Q : AnalyticIndex W d) (i : analyticFactorsIndex Q) :
    Category.{0} (profileSlotIndex Q i) := profileSlotCategory Q i

/-- Actual outer relabelling commutes with substitution on every
original rooted tensor injection, with all root and branch maps retained. -/
theorem constantInputSubstitution_on_injection (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    (R : ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q)) :
    rootedFrozenSummandInjection O.toCollection B P Q R ≫
        ((linearCoefficientDiagram O.toCollection (profileCoinvariants O.toCollection B) P).map g ≫
          constantInputSubstitution O B P Q') =
      rootedFrozenSummandInjection O.toCollection B P Q R ≫ constantInputSubstitution O B P Q := by
  let f := (inputsToProfile P.outputColor).map g
  let R' := (slotRelabelFunctor f).obj R
  let r := rootedFrozenBranches P Q R
  let s := rootedFrozenBranches P Q' R'
  let h : BranchArrows g r s := fun j => tupleRelabelInnerHom f r j
  let T := FiniteTensor.tensor (V := C)
  let e := T.map (rootedFrozenFamilyIso O.toCollection B P Q R).hom
  let a := T.map (branchInjection O.toCollection B P Q r)
  let a' := T.map (branchInjection O.toCollection B P Q' s)
  let k := T.map (weightedBranchMap O.toCollection B P g h)
  let m := (linearCoefficientDiagram O.toCollection (profileCoinvariants O.toCollection B) P).map g
  let b := constantInputSubstitution O B P Q
  let b' := constantInputSubstitution O B P Q'
  let v := frozenWeightedBranchEvaluation O B P Q r ≫
    linearCoefficientι O.toCollection B P (frozenTotalInputs Q r)
  let v' := frozenWeightedBranchEvaluation O B P Q' s ≫
    linearCoefficientι O.toCollection B P (frozenTotalInputs Q' s)
  have he : rootedFrozenSummandInjection O.toCollection B P Q R = e ≫ a :=
    rootedFrozenSummandInjection_eq O.toCollection B P Q R
  have hi : a ≫ m = k ≫ a' := (branchTensorInjection_naturality O.toCollection B P g h).symm
  have hβ : a' ≫ b' = v' := weightedBranchInjection_β O B P Q' R'
  have hv : k ≫ v' = v := weightedBranchEvaluation_colimit_relation O B P g h
  have hr : e ≫ v = rootedFrozenSummandInjection O.toCollection B P Q R ≫ b :=
    (constantInputSubstitution_β O B P Q R).symm
  have h1 := congrArg (fun t => t ≫ (m ≫ b')) he
  have h2 := (Category.assoc e a (m ≫ b')).trans
    (congrArg (e ≫ ·) (Category.assoc a m b').symm)
  have h3 := congrArg (fun t => e ≫ (t ≫ b')) hi
  have h4 := congrArg (e ≫ ·) (Category.assoc k a' b')
  have h5 := congrArg (fun t => e ≫ (k ≫ t)) hβ
  have h6 := congrArg (e ≫ ·) hv
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans (h6.trans hr)))))

/-- The complete original constant-input substitution is natural in
every original added-input color-preserving bijection. The equality is
derived using the actual rooted tensor colimit and its beta rule, with
no substitution-outcome equation supplied as an assumption. -/
theorem constantInputSubstitution_naturality (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q') :
    (linearCoefficientDiagram O.toCollection (profileCoinvariants O.toCollection B) P).map g ≫
        constantInputSubstitution O B P Q' = constantInputSubstitution O B P Q := by
  let e := rootedFrozenPointIso O.toCollection B P Q
  let H := rootedSlotTensorIsColimit (O.toCollection.obj (extendProfile P Q)) O.toCollection B
    ((inputsToProfile P.outputColor).obj Q)
  apply (cancel_epi e.hom).1
  apply H.hom_ext
  intro R
  let i := (rootedSlotTensorCocone (O.toCollection.obj (extendProfile P Q)) O.toCollection B
    ((inputsToProfile P.outputColor).obj Q)).ι.app R
  let m := (linearCoefficientDiagram O.toCollection (profileCoinvariants O.toCollection B) P).map g
  let b := constantInputSubstitution O B P Q
  let b' := constantInputSubstitution O B P Q'
  exact (Category.assoc i e.hom (m ≫ b')).symm.trans
    ((constantInputSubstitution_on_injection O B P g R).trans (Category.assoc i e.hom b))


end CategoryTheory.Operad.Tensor.Enveloping.Outer

end
end EnvelopingSource024

/- Exact checked source: EnvelopingCoefficientQuotient. -/
section EnvelopingSource025


/-!
# Actual enveloping-operation coefficient quotients

The two maps are constructed from original operadic substitution
at algebra inputs and the actual original O-algebra action. This
file constructs the coefficient quotients; it does not assume their
operadic structure or the attachment-filtration conclusion.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d
local instance : HasColimitsOfShape WalkingParallelPair C :=
  HasColimitsOfShape.of_essentiallySmall C WalkingParallelPair

/-- Actual original constant-input operadic substitutions form
the full coefficient cocone, by the proved original outer-profile
permutation square and actual root/inner colimit descent. -/
def constantInputActionCocone (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W) :
    Cocone (linearCoefficientDiagram O.toCollection (profileCoinvariants O.toCollection B) P) where
  pt := linearCoefficient O.toCollection B P
  ι :=
    { app Q := constantInputSubstitution O B P Q
      naturality {Q Q'} g := by
        exact (Outer.constantInputSubstitution_naturality O B P g).trans
          (Category.comp_id (constantInputSubstitution O B P Q)).symm }

/-- The ACTUAL original partial-substitution map on the original
linear coefficient colimit: L_P(T_O B) to L_P(B). -/
def constantInputAction (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W) :
    linearCoefficient O.toCollection (profileCoinvariants O.toCollection B) P ⟶
      linearCoefficient O.toCollection B P := by
  letI : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.desc _ (constantInputActionCocone O B P)

/-- Every original added-input coefficient summand has its
actual original partial-substitution evaluation after descent. -/
theorem constantInputAction_β (O : ColoredOperadObj W C) (B : W → C) (P : ColoredProfile W)
    (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection (profileCoinvariants O.toCollection B) P Q ≫
      constantInputAction O B P = constantInputSubstitution O B P Q := by
  let : HasColimitsOfShape (ColoredInputs W) C := hasColoredInputColimits P.outputColor
  exact colimit.ι_desc (constantInputActionCocone O B P) Q

/-- The original O-algebra relation on every retained algebra
input: L_P(T_O A) to L_P(A), using the actual original carrier action. -/
def algebraInputRelation (O : ColoredOperadObj W C) (A : Algebra O) (P : ColoredProfile W) :
    linearCoefficient O.toCollection (profileCoinvariants O.toCollection A.carrier) P ⟶
      linearCoefficient O.toCollection A.carrier P :=
  linearCoefficientCarrierLift O.toCollection A.action P

/-- The actual enveloping coefficient object at each original
profile, obtained by the original operadic-substitution/algebra-action
coequalizer. No coefficient quotient or enveloping result is input. -/
def envelopingCoefficientObj (O : ColoredOperadObj W C) (A : Algebra O) (P : ColoredProfile
  W) : C :=
  coequalizer (constantInputAction O A.carrier P) (algebraInputRelation O A P)

/-- The actual original quotient map imposing exactly the
original O-algebra relations on added algebra inputs. -/
def envelopingCoefficientπ (O : ColoredOperadObj W C) (A : Algebra O) (P : ColoredProfile W) :
    linearCoefficient O.toCollection A.carrier P ⟶ envelopingCoefficientObj O A P :=
  coequalizer.π (constantInputAction O A.carrier P) (algebraInputRelation O A P)

/-- Original operadic substitution and original A-action agree
after the actual enveloping coefficient quotient. -/
theorem envelopingCoefficient_condition (O : ColoredOperadObj W C) (A : Algebra O)
    (P : ColoredProfile W) :
    constantInputAction O A.carrier P ≫ envelopingCoefficientπ O A P =
      algebraInputRelation O A P ≫ envelopingCoefficientπ O A P := coequalizer.condition _ _

/-- Full original coequalizer extensionality on each coefficient
object, retaining all original relation maps and target morphisms. -/
theorem envelopingCoefficient_hom_ext (O : ColoredOperadObj W C) (A : Algebra O)
    (P : ColoredProfile W) {Y : C} {f g : envelopingCoefficientObj O A P ⟶ Y}
    (h : envelopingCoefficientπ O A P ≫ f = envelopingCoefficientπ O A P ≫ g) : f = g :=
  coequalizer.hom_ext h


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource025

/- Exact checked source: AlgebraRelationSection. -/
section EnvelopingSource026


/-!
# The actual operadic unit sections the original algebra-action coefficient relation
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem originalFunctorSection {V : Type*} [Category* V] {D : Type*} [Category* D]
    (F : V ⥤ D) {A B : V} (s : A ⟶ B) (p : B ⟶ A) (h : s ≫ p = 𝟙 A) :
    F.map s ≫ F.map p = 𝟙 (F.obj A) :=
  (F.map_comp s p).symm.trans ((congrArg F.map h).trans (F.map_id A))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original operadic generator at every retained
algebra input induces the actual linear-coefficient section map. -/
def algebraRelationSection (O : ColoredOperadObj W C) (A : Algebra O) (P : ColoredProfile W) :
    linearCoefficient O.toCollection A.carrier P ⟶
      linearCoefficient O.toCollection (profileCoinvariants O.toCollection A.carrier) P :=
  linearCoefficientCarrierLift O.toCollection ((profileUnit O).app A.carrier) P

omit [FiniteTensorPreservesColimitsInEachSlot C] in
/-- The original algebra unit law proves the original
coefficient-action relation has the actual operadic unit as section.
The corresponding substitution-face unit law is a separate source
obligation and is not assumed here. -/
theorem algebraRelationSection_action (O : ColoredOperadObj W C) (A : Algebra O)
    (P : ColoredProfile W) :
    algebraRelationSection O A P ≫ algebraInputRelation O A P =
      𝟙 (linearCoefficient O.toCollection A.carrier P) :=
  originalFunctorSection (linearCoefficientCarrierFunctor O.toCollection P)
    ((profileUnit O).app A.carrier) A.action A.action_unit


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource026

/- Exact checked source: UnitBranchReadback. -/
section EnvelopingSource027


/-!
# Actual unary branch injections for the coefficient substitution unit

The original carrier unit factors through the original weighted unary
branches and their actual profile injections. The established rooted and
outer colimit beta rules give the complete original summand read-back.
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory Limits

variable {W : Type u}

/-- The original unary profile at every added input, with exactly
that input's original color as both its input and output. -/
def unaryBranches (Q : ColoredInputs W) : FrozenBranchTuple Q :=
  fun j => AnalyticIndex.unary (d := (Q.obj j).as) (Q.obj j).as

/-- The genuine original rooted tensor tuple containing these
unary branches and the original unique coefficient index. -/
def unarySlotTuple (P : ColoredProfile W) (Q : ColoredInputs W) :
    ProfileSlotTuple ((inputsToProfile P.outputColor).obj Q) := fun i => match i with
  | none => ⟨Discrete.mk PUnit.unit⟩
  | some j => unaryBranches Q j

/-- The actual original dependent unary-input family is the original
added-input family through its original sigma-unit bijection. -/
def unaryTotalInputsIso (Q : ColoredInputs W) :
    frozenTotalInputs Q (unaryBranches Q) ≅ Q :=
  FiniteFamily.isoOfReindex (Equiv.sigmaPUnit Q.index) (fun _ => rfl)

variable {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The profile-slot category used for unary branch injections in the substitution unit law. -/
local instance {d : W} (Q : AnalyticIndex W d) (i : analyticFactorsIndex Q) :
    Category.{0} (profileSlotIndex Q i) := profileSlotCategory Q i

/-- Retain the original root coefficient and apply each original
carrier's actual unary-unit tensor insertion at its added input. -/
def unaryWeightedInputMap (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientInputFactors (extendedCoefficient O.toCollection P) (addedAlgebraInputs B)).obj Q ⟶
      frozenWeightedBranchFamily O.toCollection B P Q (unaryBranches Q) where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => 𝟙 (O.toCollection.obj (extendProfile P Q))
    | some j => unitInsertion O B (Q.obj j).as

/-- The actual original carrier-unit factors are the actual unary
insertions followed by every original unary-profile injection. -/
theorem unaryWeightedInputMap_factor (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    unaryWeightedInputMap O B P Q ≫ Outer.branchInjection O.toCollection B P Q (unaryBranches Q) =
      (coefficientInputFactorsMap (𝟙 (extendedCoefficient O.toCollection P))
        (addedAlgebraInputMap ((profileUnit O).app B))).app Q := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq (𝟙 _ ≫ 𝟙 _) (𝟙 _)
      exact heq_of_eq (Category.id_comp _)
    | some j => rfl

/-- The actual complete tensor carrier-unit map factors through the
original weighted unary family and its original profile injections. -/
theorem unaryCarrierTensorMap_factor (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientCarrierMap O.toCollection ((profileUnit O).app B) P).app Q =
      (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
        (FiniteTensor.tensor (V := C)).map (Outer.branchInjection O.toCollection B P Q
          (unaryBranches Q)) :=
  (congrArg (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap_factor O B P Q)).symm.trans
    ((FiniteTensor.tensor (V := C)).map_comp _ _)

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Actual rooted tensor beta reads back the original carrier-unit
summand by the original weighted unary substitution and total injection. -/
theorem unaryCarrierSubstitution_readback (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (linearCoefficientCarrierMap O.toCollection ((profileUnit O).app B) P).app Q ≫
        constantInputSubstitution O B P Q =
      (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
        frozenWeightedBranchEvaluation O B P Q (unaryBranches Q) ≫
          linearCoefficientι O.toCollection B P (frozenTotalInputs Q (unaryBranches Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (unaryWeightedInputMap O B P Q)
  let i := T.map (Outer.branchInjection O.toCollection B P Q (unaryBranches Q))
  let s := constantInputSubstitution O B P Q
  have hβ : i ≫ s = frozenWeightedBranchEvaluation O B P Q (unaryBranches Q) ≫
      linearCoefficientι O.toCollection B P (frozenTotalInputs Q (unaryBranches Q)) :=
    Outer.weightedBranchInjection_β O B P Q (unarySlotTuple P Q)
  exact (congrArg (· ≫ s) (unaryCarrierTensorMap_factor O B P Q)).trans
    ((Category.assoc a i s).trans (congrArg (a ≫ ·) hβ))

/-- Actual outer coefficient-colimit beta reads back every original
carrier-unit/action summand through the genuine original unary tensor. -/
theorem unaryCarrierAction_readback (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B P Q ≫
        (linearCoefficientCarrierLift O.toCollection ((profileUnit O).app B) P ≫
          constantInputAction O B P) =
      (FiniteTensor.tensor (V := C)).map (unaryWeightedInputMap O B P Q) ≫
        frozenWeightedBranchEvaluation O B P Q (unaryBranches Q) ≫
          linearCoefficientι O.toCollection B P (frozenTotalInputs Q (unaryBranches Q)) := by
  let i := linearCoefficientι O.toCollection B P Q
  let j := linearCoefficientι O.toCollection (profileCoinvariants O.toCollection B) P Q
  let k := linearCoefficientCarrierLift O.toCollection ((profileUnit O).app B) P
  let m := (linearCoefficientCarrierMap O.toCollection ((profileUnit O).app B) P).app Q
  let a := constantInputAction O B P
  have h1 : i ≫ k = m ≫ j := linearCoefficientι_carrier O.toCollection ((profileUnit O).app B) P Q
  have h2 : j ≫ a = constantInputSubstitution O B P Q := constantInputAction_β O B P Q
  exact (Category.assoc i k a).symm.trans
    ((congrArg (· ≫ a) h1).trans
      ((Category.assoc m j a).trans
        ((congrArg (m ≫ ·) h2).trans (unaryCarrierSubstitution_readback O B P Q))))


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
end EnvelopingSource027

/- Exact checked source: UnitEmptyTensorCoherence. -/
section EnvelopingSource028


/-!
# Actual tensor coherence of an empty nested block

The singleton-flatten law and its naturality identify the actual empty
nested-block tensor comparison with its original empty-family bijection.
This is the zero-arity component needed when variable prefixes are fused.
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

variable {C : Type w} [Category.{v} C]

local instance emptyIndexEmpty {D : Type*} : IsEmpty (FiniteFamily.empty (C := D)).index :=
  inferInstanceAs (IsEmpty Empty)

local instance mappedIndexEmpty {D E : Type*} [Category* D] [Category* E]
    (F : D ⥤ E) (M : FiniteFamily D) [IsEmpty M.index] :
    IsEmpty ((FiniteFamily.map F).obj M).index :=
  inferInstanceAs (IsEmpty M.index)

local instance flattenedIndexEmpty {D : Type*} [Category* D]
    (N : FiniteFamily (FiniteFamily D)) [IsEmpty N.index] :
    IsEmpty ((FiniteFamily.flatten (C := D)).obj N).index where
  false p := isEmptyElim p.1

/-- The actual unique original finite-family map from an empty
original family to the displayed empty family. -/
def emptyFamilyHom (M : FiniteFamily C) [IsEmpty M.index] : M ⟶ FiniteFamily.empty where
  equiv := Equiv.equivOfIsEmpty M.index (FiniteFamily.empty (C := C)).index
  hom i := isEmptyElim i

variable [FiniteTensor C]

/-- The actual flattening tensor comparison of an empty nested
family is its original empty-family map after tensoring. This is
derived from the finite tensor singleton law, with no unit outcome input. -/
theorem flatten_empty_tensor (N : FiniteFamily (FiniteFamily C)) [IsEmpty N.index] :
    (FiniteTensor.flattenIso (V := C)).hom.app N ≫
        (FiniteTensor.tensor (V := C)).map (emptyFamilyHom ((FiniteFamily.map
          (FiniteTensor.tensor (V := C))).obj N)) =
      (FiniteTensor.tensor (V := C)).map (emptyFamilyHom ((FiniteFamily.flatten (C :=
        C)).obj N)) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let E := (FiniteFamily.empty : FiniteFamily C)
  let S := FiniteFamily.map (FiniteFamily.singleton (C := C))
  let h : N ⟶ S.obj E :=
    { equiv := Equiv.equivOfIsEmpty N.index (S.obj E).index
      hom i := isEmptyElim i }
  let k := F.map h
  let l := (FiniteFamily.map T).map h
  let s := (FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app E
  let f := FiniteFamily.mapSingletonFlattenIso.hom.app E
  let a := (FiniteTensor.flattenIso (V := C)).hom.app N
  let b := (FiniteTensor.flattenIso (V := C)).hom.app (S.obj E)
  have hk : k ≫ f = emptyFamilyHom (F.obj N) := by
    apply FiniteFamily.Hom_ext
    · ext p
      exact isEmptyElim p.1
    · intro p
      exact isEmptyElim p.1
  have hl : l ≫ s = emptyFamilyHom ((FiniteFamily.map T).obj N) := by
    apply FiniteFamily.Hom_ext
    · ext i
      exact isEmptyElim i
    · intro i
      exact isEmptyElim i
  have hn : T.map k ≫ b = a ≫ T.map l := (FiniteTensor.flattenIso (V := C)).hom.naturality h
  have hs : T.map f = b ≫ T.map s := mapSingletonFlattenLaw_app E
  have h1 := congrArg (fun q => a ≫ T.map q) hl.symm
  have h2 := congrArg (a ≫ ·) (T.map_comp l s)
  have h3 := (Category.assoc a (T.map l) (T.map s)).symm
  have h4 := congrArg (· ≫ T.map s) hn.symm
  have h5 := Category.assoc (T.map k) b (T.map s)
  have h6 := congrArg (T.map k ≫ ·) hs.symm
  have h7 := (T.map_comp k f).symm
  have h8 := congrArg T.map hk
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans (h6.trans (h7.trans h8))))))


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
end EnvelopingSource028

/- Exact checked source: UnitPrefixFusionData. -/
section EnvelopingSource029


/-!
# Original empty/singleton profiles for variable-prefix fusion

The triple family retains the exact original two variable blocks and
retained input block. Its original flattening and tensor comparisons
identify the two actual unit-insertion routes.
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

attribute [local instance] emptyIndexEmpty mappedIndexEmpty flattenedIndexEmpty

variable {C : Type w} [Category.{v} C]

/-- The original triple empty/singleton family: the first variable
block is empty, and the second block retains the original inner family. -/
def prefixTriple (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    FiniteFamily (FiniteFamily (FiniteFamily C)) :=
  frozenVariableBlocks I (frozenVariableBlocks J L)

/-- Flatten the original first-level blocks to the combined variable
block, preserving every original retained input and sum bijection. -/
def prefixFlattenBlocksMap (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj (prefixTriple I J L) ⟶
      frozenVariableBlocks (FintypeCat.of (I ⊕ J)) L where
  equiv := (Equiv.sumAssoc I J L.index).symm
  hom i := match i with
    | Sum.inl _ => emptyFamilyHom ((FiniteFamily.flatten (C := C)).obj
      (FiniteFamily.empty : FiniteFamily (FiniteFamily C)))
    | Sum.inr (Sum.inl _) => FiniteFamily.singletonFlattenIso.hom.app (FiniteFamily.empty :
      FiniteFamily C)
    | Sum.inr (Sum.inr j) => FiniteFamily.singletonFlattenIso.hom.app
      ((FiniteFamily.singleton (C := C)).obj (L.obj j))

/-- The exact two original flattening routes have the same retained
input bijection and original input objects, including both empty blocks. -/
theorem prefix_flatten_reindex (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map (prefixFlattenBlocksMap I J L) ≫
        (frozenVariableFlattenIso (FintypeCat.of (I ⊕ J)) L).hom =
      FiniteFamily.flattenAssocIso.hom.app (prefixTriple I J L) ≫
        (FiniteFamily.flatten (C := C)).map
          (frozenVariableFlattenIso I (frozenVariableBlocks J L)).hom ≫
            (frozenVariableFlattenIso J L).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact Empty.elim j.1
    | inr i =>
      cases i with
      | inl i => exact Empty.elim j.2
      | inr i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact Empty.elim j.1
    | inr i =>
      cases i with
      | inl i => exact Empty.elim j.2
      | inr i =>
        change HEq (𝟙 (L.obj i) ≫ 𝟙 _) (𝟙 _ ≫ 𝟙 _ ≫ 𝟙 _)
        exact heq_of_eq ((Category.id_comp _).trans
          ((Category.id_comp _).trans (Category.id_comp _)).symm)

variable [FiniteTensor C]

private theorem eraseComponentUnits {V : Type*} [Category* V] {A B D E : V}
    (a : A ⟶ B) (b : B ⟶ D) (t : D ⟶ E) :
    a ≫ 𝟙 B ≫ b ≫ t ≫ 𝟙 E = (a ≫ b) ≫ t := by
  simp only [Category.id_comp, Category.comp_id, Category.assoc]

private theorem tensorSingletonBlock (K : FiniteFamily C) {Y : C}
    (t : (FiniteTensor.tensor (V := C)).obj K ⟶ Y) :
    (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.singleton (C :=
      FiniteFamily C)).obj K) ≫
        (FiniteTensor.tensor (V := C)).map (𝟙 ((FiniteFamily.singleton (C := C)).obj
          ((FiniteTensor.tensor (V := C)).obj K))) ≫
        (FiniteTensor.singletonIso (V := C)).hom.app ((FiniteTensor.tensor (V := C)).obj K)
          ≫ t ≫ 𝟙 Y =
      (FiniteTensor.tensor (V := C)).map (FiniteFamily.singletonFlattenIso.hom.app K) ≫ t := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.singleton (C :=
    FiniteFamily C)).obj K)
  let s := (FiniteTensor.singletonIso (V := C)).hom.app (T.obj K)
  have h1 := congrArg (fun q => a ≫ q ≫ s ≫ t ≫ 𝟙 Y)
    (T.map_id ((FiniteFamily.singleton (C := C)).obj (T.obj K)))
  have h2 := eraseComponentUnits a s t
  have h3 := congrArg (· ≫ t) (singletonFlattenLaw_app K).symm
  exact h1.trans (h2.trans h3)

/-- Tensor the original inner blocks, retaining the exact first
variable empty blocks and each original retained singleton block. -/
def prefixTensorBlocksMap (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.map (FiniteFamily.map (FiniteTensor.tensor (V := C)))).obj (prefixTriple I J L) ⟶
      frozenVariableBlocks I ((FiniteFamily.map (FiniteTensor.tensor (V :=
        C))).obj (frozenVariableBlocks J L)) where
  equiv := Equiv.refl (I ⊕ (J ⊕ L.index))
  hom i := match i with
    | Sum.inl _ => emptyFamilyHom ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
      (FiniteFamily.empty : FiniteFamily (FiniteFamily C)))
    | Sum.inr j => 𝟙 ((FiniteFamily.singleton (C := C)).obj
      ((FiniteTensor.tensor (V := C)).obj ((frozenVariableBlocks J L).obj j)))

/-- The actual tensor/flatten interchange and original empty/singleton
projection retain precisely the original tensor of every inner block. -/
theorem prefix_tensor_flatten_reindex (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.flattenMapIso (FiniteTensor.tensor (V := C))).hom.app (prefixTriple I J L) ≫
        (FiniteFamily.flatten (C := C)).map (prefixTensorBlocksMap I J L) ≫
        (frozenVariableFlattenIso I
          ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (frozenVariableBlocks J L))).hom =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map
        (frozenVariableFlattenIso I (frozenVariableBlocks J L)).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact Empty.elim j
    | inr i => rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | inl i => exact Empty.elim j
    | inr i =>
      let X := (FiniteTensor.tensor (V := C)).obj ((frozenVariableBlocks J L).obj i)
      change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X)
        ((FiniteTensor.tensor (V := C)).map (𝟙 ((frozenVariableBlocks J L).obj i)))
      exact heq_of_eq (((Category.id_comp _).trans (Category.id_comp _)).trans
        ((FiniteTensor.tensor (V := C)).map_id _).symm)

/-- The exact original associativity bijection identifies two unit
prefixes with the combined variable block and retained input block. -/
def prefixUnitReindexIso (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    frozenVariableUnitFamily I (frozenVariableUnitFamily J L) ≅
      frozenVariableUnitFamily (FintypeCat.of (I ⊕ J)) L :=
  FiniteFamily.isoOfReindex (Equiv.sumAssoc I J L.index).symm (by
    intro i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl)

/-- All original empty/singleton component maps commute with the
actual tensor flattening and the exact combined-prefix bijection. -/
theorem prefix_tensor_components (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app (prefixTriple I J L) ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (prefixTensorBlocksMap I J L) ≫
        (frozenVariableBlockIso I
          ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (frozenVariableBlocks J L))).hom ≫
        frozenVariableUnitFamilyMap I (frozenVariableBlockIso J L).hom ≫
        (prefixUnitReindexIso I J L).hom =
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (prefixFlattenBlocksMap I J L) ≫
        (frozenVariableBlockIso (FintypeCat.of (I ⊕ J)) L).hom := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      change HEq ((FiniteTensor.flattenIso (V := C)).hom.app
        (FiniteFamily.empty : FiniteFamily (FiniteFamily C)) ≫
        (FiniteTensor.tensor (V := C)).map (emptyFamilyHom
          ((FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
            (FiniteFamily.empty : FiniteFamily (FiniteFamily C)))) ≫ 𝟙 _ ≫ 𝟙 _ ≫ 𝟙 _)
        ((FiniteTensor.tensor (V := C)).map (emptyFamilyHom
          ((FiniteFamily.flatten (C := C)).obj
            (FiniteFamily.empty : FiniteFamily (FiniteFamily C)))) ≫ 𝟙 _)
      exact heq_of_eq (by
        simpa only [Category.comp_id] using
          (flatten_empty_tensor (FiniteFamily.empty : FiniteFamily (FiniteFamily C))))
    | inr i =>
      cases i with
      | inl i =>
        change HEq ((FiniteTensor.flattenIso (V := C)).hom.app
          ((FiniteFamily.singleton (C := FiniteFamily C)).obj FiniteFamily.empty) ≫
          (FiniteTensor.tensor (V := C)).map (𝟙 _) ≫
          (FiniteTensor.singletonIso (V := C)).hom.app ((FiniteTensor.tensor (V :=
            C)).obj FiniteFamily.empty) ≫
          𝟙 _ ≫ 𝟙 _)
          ((FiniteTensor.tensor (V := C)).map (FiniteFamily.singletonFlattenIso.hom.app
            FiniteFamily.empty) ≫ 𝟙 _)
        exact heq_of_eq (tensorSingletonBlock (FiniteFamily.empty : FiniteFamily C)
          (𝟙 ((FiniteTensor.tensor (V := C)).obj FiniteFamily.empty)))
      | inr i =>
        let K := (FiniteFamily.singleton (C := C)).obj (L.obj i)
        change HEq ((FiniteTensor.flattenIso (V := C)).hom.app
          ((FiniteFamily.singleton (C := FiniteFamily C)).obj K) ≫
          (FiniteTensor.tensor (V := C)).map (𝟙 _) ≫
          (FiniteTensor.singletonIso (V := C)).hom.app ((FiniteTensor.tensor (V := C)).obj K) ≫
          (FiniteTensor.singletonIso (V := C)).hom.app (L.obj i) ≫ 𝟙 _)
          ((FiniteTensor.tensor (V := C)).map (FiniteFamily.singletonFlattenIso.hom.app K) ≫
            (FiniteTensor.singletonIso (V := C)).hom.app (L.obj i))
        exact heq_of_eq (tensorSingletonBlock K
          ((FiniteTensor.singletonIso (V := C)).hom.app (L.obj i)))


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
end EnvelopingSource029

/- Exact checked source: UnitPrefixFusion. -/
section EnvelopingSource030


/-!
# Actual finite empty/singleton unit-prefix fusion

The original finite-tensor associativity law, original empty/singleton
comparisons and exact original sum bijection identify successive variable
unit insertions with the combined original variable block.
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

private theorem inversePost {V : Type*} [Category* V] {A B X : V}
    (e : A ≅ B) (x : X ⟶ A) (y : X ⟶ B) (h : x ≫ e.hom = y) : x = y ≫ e.inv := by
  apply (cancel_mono e.hom).1
  rw [Category.assoc, e.inv_hom_id, Category.comp_id]
  exact h

private theorem inverseComparison {V : Type*} [Category* V] {A B X : V}
    (e : A ≅ B) (d : X ≅ B) (x : A ⟶ X) (h : x ≫ d.hom = e.hom) : e.inv ≫ x = d.inv := by
  apply (cancel_mono d.hom).1
  rw [Category.assoc, h, e.inv_hom_id, d.inv_hom_id]

private theorem rawFusionFromSquares {V : Type*} [Category* V]
    {A B D E F G H K N R : V}
    (a : A ⟶ B) (b : B ⟶ D) (q : D ⟶ E)
    (r : A ⟶ F) (s : F ⟶ G) (w : G ⟶ H) (e : H ⟶ D)
    (f : H ⟶ K) (d : K ⟶ E) (t : G ⟶ N) (k : N ⟶ K)
    (g : F ⟶ R) (n : R ⟶ N)
    (ha : a ≫ b = r ≫ s ≫ w ≫ e)
    (hq : e ≫ q = f ≫ d) (hw : w ≫ f = t ≫ k) (hr : s ≫ t = g ≫ n) :
    a ≫ b ≫ q = r ≫ g ≫ n ≫ k ≫ d := by
  rw [← Category.assoc a b, ha]
  simp only [Category.assoc]
  rw [hq, ← Category.assoc w f, hw]
  simp only [Category.assoc]
  rw [← Category.assoc s t, hr]
  simp only [Category.assoc]

private theorem foldFromSquares {V : Type*} [Category* V]
    {A B D E F G H : V} (l : A ⟶ B) (c : B ⟶ D) (z : D ⟶ E)
    (a : A ⟶ F) (p : F ⟶ D) (b : F ⟶ G) (q : G ⟶ H) (v : H ⟶ E)
    (r : A ⟶ H) (hc : l ≫ c = a ≫ p) (hp : p ≫ z = b ≫ q ≫ v)
    (ha : a ≫ b ≫ q = r) : l ≫ c ≫ z = r ≫ v := by
  rw [← Category.assoc l c, hc, Category.assoc a p, hp]
  simpa only [Category.assoc] using congrArg (· ≫ v) ha

private theorem precomposeFold {V : Type*} [Category* V]
    {S A B D E F G : V} (u : S ⟶ A) (l : A ⟶ B) (c : B ⟶ D) (z : D ⟶ E)
    (r : A ⟶ F) (n : F ⟶ G) (v : G ⟶ E) (x : S ⟶ B) (y : S ⟶ F)
    (h : l ≫ c ≫ z = r ≫ n ≫ v) (hl : u ≫ l = x) (hr : u ≫ r = y) :
    x ≫ c ≫ z = y ≫ n ≫ v := by
  rw [← hl, ← hr]
  simpa only [Category.assoc] using congrArg (u ≫ ·) h

private theorem mapFive {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H K : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) (e : H ⟶ K) :
    F.map (a ≫ b ≫ c ≫ d ≫ e) = F.map a ≫ F.map b ≫ F.map c ≫ F.map d ≫ F.map e := by
  simp only [Functor.map_comp]

private theorem associateSix {V : Type*} [Category* V] {A B C D E F G : V}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ D) (d : D ⟶ E) (e : E ⟶ F) (v : F ⟶ G) :
    (a ≫ b ≫ c ≫ d ≫ e) ≫ v = (a ≫ b) ≫ c ≫ (d ≫ e ≫ v) := by
  simp only [Category.assoc]

private theorem sourceInsertionNatural {V : Type*} [Category* V]
    {A B D E F G H : V} (a : A ⟶ B) (n : B ⟶ D) (b : D ⟶ E) (u : E ⟶ F)
    (u' : D ⟶ G) (m : G ⟶ F) (j : F ⟶ H) (h : b ≫ u = u' ≫ m) :
    (a ≫ n ≫ b) ≫ u ≫ j = a ≫ n ≫ u' ≫ m ≫ j := by
  simp only [Category.assoc]
  rw [← Category.assoc b u, h]
  simp only [Category.assoc]

private theorem associateInsertedThree {V : Type*} [Category* V]
    {A B C D E F G H : V} (a : A ⟶ B) (n : B ⟶ C) (e : C ⟶ D) (d : D ⟶ E)
    (b : E ⟶ F) (m : F ⟶ G) (j : G ⟶ H) :
    a ≫ n ≫ (e ≫ d ≫ b) ≫ m ≫ j = a ≫ n ≫ e ≫ d ≫ (b ≫ m ≫ j) := by
  simp only [Category.assoc]

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Insert the original units at the second block and then the first
block, or at their exact original disjoint sum. The actual finite
tensor comparisons and the complete original sum bijection agree. -/
theorem tensorUnitPrefix_fusion (I J : FintypeCat.{0}) (L : FiniteFamily C) :
    (frozenVariableTensorUnitIso J L).hom ≫
        (frozenVariableTensorUnitIso I (frozenVariableUnitFamily J L)).hom ≫
        (FiniteTensor.tensor (V := C)).map (prefixUnitReindexIso I J L).hom =
      (frozenVariableTensorUnitIso (FintypeCat.of (I ⊕ J)) L).hom := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let N := frozenVariableBlocks J L
  let M := prefixTriple I J L
  let K := frozenVariableBlocks (FintypeCat.of (I ⊕ J)) L
  let K' := frozenVariableBlocks I ((FiniteFamily.map T).obj N)
  let p := prefixFlattenBlocksMap I J L
  let q := prefixTensorBlocksMap I J L
  let eJ := frozenVariableFlattenIso J L
  let eC := frozenVariableFlattenIso (FintypeCat.of (I ⊕ J)) L
  let eI := frozenVariableFlattenIso I ((FiniteFamily.map T).obj N)
  let r := frozenVariableFlattenIso I N
  let a := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.map F).obj M)
  let bM := (FiniteFamily.mapIso (FiniteTensor.flattenIso (V := C))).hom.app M
  let b := T.map bM
  let d := (FiniteTensor.flattenIso (V := C)).hom.app K'
  let c := (FiniteTensor.flattenIso (V := C)).hom.app K
  let n := (FiniteTensor.flattenIso (V := C)).hom.app N
  let s := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.flatten (C :=
    FiniteFamily C)).obj M)
  let z := T.map (FiniteFamily.flattenAssocIso.hom.app M)
  let w := (FiniteFamily.flattenMapIso T).hom.app M
  let e := (FiniteTensor.flattenIso (V := C)).hom.app ((FiniteFamily.map (FiniteFamily.map
    T)).obj M)
  let f := T.map (F.map q)
  let qT := T.map ((FiniteFamily.map T).map q)
  let rT := T.map ((FiniteFamily.map T).map r.hom)
  let rF := T.map (F.map r.hom)
  let bI := (frozenVariableBlockIso I ((FiniteFamily.map T).obj N)).hom
  let bJ := (frozenVariableBlockIso J L).hom
  let bC := (frozenVariableBlockIso (FintypeCat.of (I ⊕ J)) L).hom
  let um := frozenVariableUnitFamilyMap I bJ
  let j := (prefixUnitReindexIso I J L).hom
  let v := T.map bI ≫ T.map um ≫ T.map j
  have hq0 : w ≫ F.map q = (FiniteFamily.map T).map r.hom ≫ eI.inv :=
    inversePost eI (w ≫ F.map q) ((FiniteFamily.map T).map r.hom)
      ((Category.assoc _ _ _).trans (prefix_tensor_flatten_reindex I J L))
  have hqf : T.map w ≫ f = rT ≫ T.map eI.inv :=
    (T.map_comp _ _).symm.trans ((congrArg T.map hq0).trans (T.map_comp _ _))
  have hqn : e ≫ qT = f ≫ d := (FiniteTensor.flattenIso (V := C)).hom.naturality q |>.symm
  have hrn : s ≫ rT = rF ≫ n := (FiniteTensor.flattenIso (V := C)).hom.naturality r.hom |>.symm
  have ha : a ≫ b = z ≫ s ≫ T.map w ≫ e := FiniteTensor.flattenAssocLaw_app_unfold M
  have hraw : a ≫ b ≫ qT = z ≫ rF ≫ n ≫ T.map eI.inv ≫ d :=
    rawFusionFromSquares a b qT z s (T.map w) e f d rT (T.map eI.inv) rF n ha hqn hqf hrn
  have hp : T.map (F.map p) ≫ c = a ≫ T.map ((FiniteFamily.map T).map p) :=
    (FiniteTensor.flattenIso (V := C)).hom.naturality p
  have hcomp : T.map ((FiniteFamily.map T).map p) ≫ T.map bC = b ≫ qT ≫ v := by
    exact (T.map_comp ((FiniteFamily.map T).map p) bC).symm.trans
      ((congrArg T.map (prefix_tensor_components I J L).symm).trans
        (mapFive T bM ((FiniteFamily.map T).map q) bI um j))
  have hfold : T.map (F.map p) ≫ c ≫ T.map bC =
      (z ≫ rF) ≫ n ≫ (T.map eI.inv ≫ d ≫ v) := by
    have h := foldFromSquares (T.map (F.map p)) c (T.map bC) a
      (T.map ((FiniteFamily.map T).map p)) b qT v (z ≫ rF ≫ n ≫ T.map eI.inv ≫ d) hp hcomp hraw
    exact h.trans (associateSix z rF n (T.map eI.inv) d v)
  let E := FiniteFamily.flattenAssocIso.app M ≪≫ F.mapIso r ≪≫ eJ
  have heC0 : E.inv ≫ F.map p = eC.inv :=
    inverseComparison E eC (F.map p) (prefix_flatten_reindex I J L)
  have heJ0 : E.inv ≫ (FiniteFamily.flattenAssocIso.hom.app M ≫ F.map r.hom) = eJ.inv :=
    inverseComparison E eJ (FiniteFamily.flattenAssocIso.hom.app M ≫
      F.map r.hom) (Category.assoc _ _ _)
