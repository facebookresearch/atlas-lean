namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem expandedSingletonAfterMap {V : Type*} [Category* V] [FiniteTensor V]
    {X Y Z : V} (f : X ⟶ Y) (g : Y ⟶ Z) :
    (FiniteTensor.tensor (V := V)).map ((FiniteFamily.singleton (C := V)).map f) ≫
        (FiniteTensor.singletonIso (V := V)).hom.app Y ≫ g =
      (FiniteTensor.singletonIso (V := V)).hom.app X ≫ f ≫ g := by
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ g) ((FiniteTensor.singletonIso (V :=
      V)).hom.naturality f)).trans (Category.assoc _ _ _))

private theorem expandedMapTwo {V : Type*} [Category* V] {D : Type*} [Category* D] (O : V ⥤ D)
    {X Y Z : V} {A : D} (a : A ⟶ O.obj X) (f : X ⟶ Y) (g : Y ⟶ Z) :
    a ≫ O.map (f ≫ g) = a ≫ O.map f ≫ O.map g := by
  rw [O.map_comp]

private theorem expandedRootAssociate {V : Type*} [Category* V]
    {X A B D Y : V} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ D) (d : D ⟶ Y) :
    (a ≫ b) ≫ c ≫ d = a ≫ b ≫ c ≫ d := Category.assoc _ _ _

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual expanded middle block contracts by original
O.subst and the original middle total-profile map. Each original
innermost coefficient/unit keeps its genuine singleton collapse. -/
def envelopingAssocExpandedContractionMap (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (envelopingAssocExpandedGroupingB
      O.toCollection d Q) ⟶
      (ColoredOperadObj.substitutionFactors O.toCollection).obj
        (envelopingRepresentativeSubstitution d.innerData (envelopingAssocInnerChoices d Q)) where
  equiv := Equiv.optionCongr (envelopingAssocFlatInnerEquiv d Q)
  hom i := match i with
    | none => (FiniteTensor.tensor (V := C)).map (envelopingAssocExpandedMiddleMap O d Q) ≫
        O.subst.app (envelopingRepresentativeAssoc d Q).middleData ≫
        O.toCollection.map (envelopingAssocMiddleTotalHom d Q) ≫
        O.toCollection.map (envelopingRepresentativeOuterHom d.innerData
          (envelopingAssocInnerChoices d Q))
    | some p => (FiniteTensor.singletonIso (V := C)).hom.app
        (envelopingAssocExpandedInnerCoefficient O.toCollection d Q p) ≫
          envelopingAssocExpandedInnerMap O d Q p ≫
        O.toCollection.map ((envelopingAssocFlatInnerFamilyMap d Q).hom p)

/-- The actual original expanded grouping B coefficient maps
and original middle substitution give exactly the full original
flat-inner representative substitution factor map. -/
theorem envelopingAssocExpandedContraction_factorization (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (envelopingAssocExpandedMapB O d Q) ≫
