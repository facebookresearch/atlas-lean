section EnvelopingSource075


/-!
# Original middle coefficient unit maps and full profile transport
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Actual original root algebra units and root/middle
coefficient profile maps commute with the original middle shape map. -/
theorem envelopingAssocExpandedMiddleUnitMap (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocExpandedMiddleUnitIso O.toCollection d Q).hom ≫
        envelopingAssocExpandedMiddleMap O d Q ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map
          (envelopingAssocMiddleProfileMap d Q) =
      envelopingRepresentativeUnitMap O d.middleData (envelopingAssocMiddleChoices d Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | inl p => rfl
    | inr p => cases p <;> rfl
  · intro p
    cases p with
    | inl j =>
      exact heq_of_eq (by
        change 𝟙 _ ≫ O.unit (Q.root.obj j).as ≫ O.toCollection.map (𝟙
          (ColoredSubstitutionData.unitProfile (Q.root.obj
          j).as)) = _
        exact (Category.id_comp _).trans
          ((congrArg (O.unit _ ≫ ·) (O.toCollection.map_id _)).trans (Category.comp_id _)))
    | inr p =>
      cases p with
      | none =>
        have hprofile := envelopingAssocMiddleProfileMap_outer d Q
        have hm := (O.toCollection.map_comp _ _).symm.trans (congrArg O.toCollection.map hprofile)
        exact heq_of_eq ((Category.id_comp _).trans hm)
      | some i =>
        have hi : envelopingRepresentativeOuterHom (d.localData i) (Q.branch i) ≫
            (envelopingRepresentativeOuterHom (d.localData i) (Q.branch i)).symm =
            𝟙 (extendProfile (d.localData i).outerProfile (Q.branch i none)) := by
          apply ColoredProfile.Hom.ext
          rfl
        exact heq_of_eq ((Category.id_comp _).trans
          ((O.toCollection.map_comp _ _).symm.trans ((congrArg O.toCollection.map hi).trans
            (O.toCollection.map_id _))))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource075

/- Exact checked source: EnvelopingAssociativityMiddleUnitSubstitution. -/
section EnvelopingSource076


/-!
# Actual original middle coefficient substitution from expanded unit factors
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem middleUnitFourPostAssoc {V : Type*} [Category* V]
    {X A B D E Y : V} (u : X ⟶ A) (p : A ⟶ B) (s : B ⟶ D) (a : D ⟶ E) (b : E ⟶ Y) :
    ((u ≫ p) ≫ s ≫ a) ≫ b = u ≫ p ≫ s ≫ a ≫ b := by simp only [Category.assoc]

private theorem middleUnitTypedSquare {V : Type*} [Category* V]
    {X A B D E F G Y : V} (u : X ⟶ A) (e : A ⟶ B) (m : B ⟶ D) (f : D ⟶ E)
    (s : E ⟶ F) (t : F ⟶ Y) (p : A ⟶ E) (a : D ⟶ G) (b : G ⟶ Y)
    (h1 : e ≫ m ≫ f = p) (h2 : f ≫ s ≫ t = a ≫ b) :
    u ≫ e ≫ m ≫ a ≫ b = u ≫ p ≫ s ≫ t := by
  rw [← h2]
  rw [← Category.assoc m f, ← Category.assoc e (m ≫ f), h1]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual expanded middle coefficient/unit tensor source
substitutes by the original O middle map and retains the exact
original middle/root algebra-input profile comparison. -/
theorem envelopingAssocExpandedMiddle_substitution (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (frozenVariableTensorUnitIso Q.root.index
        (envelopingRepresentativeCoefficients O.toCollection d.middleData
          (envelopingAssocMiddleChoices d Q))).hom ≫
      (FiniteTensor.tensor (V := C)).map (envelopingAssocExpandedMiddleUnitIso
        O.toCollection d Q).hom ≫
      (FiniteTensor.tensor (V := C)).map (envelopingAssocExpandedMiddleMap O d Q) ≫
      O.subst.app (envelopingRepresentativeAssoc d Q).middleData ≫
        O.toCollection.map (envelopingAssocMiddleTotalHom d
        Q) =
    envelopingAssocMiddleCoefficientSubstitution O d Q := by
  let T := FiniteTensor.tensor (V := C)
  let u := (frozenVariableTensorUnitIso Q.root.index
    (envelopingRepresentativeCoefficients O.toCollection d.middleData
      (envelopingAssocMiddleChoices d Q))).hom
  let e := T.map (envelopingAssocExpandedMiddleUnitIso O.toCollection d Q).hom
  let m := T.map (envelopingAssocExpandedMiddleMap O d Q)
  let f := (ColoredOperadObj.substitutionSource O.toCollection).map
    (envelopingAssocMiddleProfileMap d Q)
  let s := O.subst.app (envelopingAssocMiddleRepresentative d Q)
  let t := O.toCollection.map (envelopingRepresentativeTotalHom d.middleData
    (envelopingAssocMiddleChoices d Q)) ≫
    O.toCollection.map (extendProfileMap (𝟙 d.middleData.totalProfile)
      (envelopingAssocMiddleAlgebraMap d Q))
  let a := O.subst.app (envelopingRepresentativeAssoc d Q).middleData
  let b := O.toCollection.map (envelopingAssocMiddleTotalHom d Q)
  let p := T.map (envelopingRepresentativeUnitMap O d.middleData (envelopingAssocMiddleChoices d Q))
  have h1 : e ≫ m ≫ f = p := (congrArg (e ≫ ·) (T.map_comp _ _).symm).trans
    ((T.map_comp _ _).symm.trans (congrArg T.map (envelopingAssocExpandedMiddleUnitMap O d Q)))
  have h2 : f ≫ s ≫ t = a ≫ b := envelopingAssocMiddleSubstitution_naturality O d Q
  have h := middleUnitTypedSquare u e m f s t p a b h1 h2
  have hread : envelopingAssocMiddleCoefficientSubstitution O d Q =
      ((u ≫ p) ≫ s ≫ O.toCollection.map (envelopingRepresentativeTotalHom d.middleData
        (envelopingAssocMiddleChoices d
        Q))) ≫
      O.toCollection.map (extendProfileMap (𝟙 d.middleData.totalProfile)
        (envelopingAssocMiddleAlgebraMap d Q)) := rfl
  exact h.trans ((middleUnitFourPostAssoc u p s
    (O.toCollection.map (envelopingRepresentativeTotalHom d.middleData
      (envelopingAssocMiddleChoices d Q)))
    (O.toCollection.map (extendProfileMap (𝟙 d.middleData.totalProfile)
      (envelopingAssocMiddleAlgebraMap d
      Q)))).symm.trans hread.symm)


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource076

