section EnvelopingSource163


/-!
# Exact original atomic source and dependent leaf permutation squares
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original coefficient regrouping and every original internal
input identity commute with the complete original atomic leaf correction. -/
theorem atomicLeaves_relabel (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.flatten (C := C)).map
        (inputBlockRelabelMap (envelopingAssocRootFirstCoefficientIso O d Q).hom.equiv
          (fun p => (coefficientInputsRelabelIso O B d Q p).hom)) ≫
      (atomicLeavesIsoB O B d Q).hom = (atomicLeavesIsoA O B d Q).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨⟨i, j⟩, k⟩
    cases i with
    | none => cases j; rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨⟨i, j⟩, k⟩
    cases i with
    | none =>
      cases j
      change HEq (𝟙 _ ≫ (𝟙 _ ≫ ((𝟙 _ ≫ (Discrete.functor B).map (𝟙 _)) ≫ 𝟙 _)))
        (𝟙 _ ≫ (𝟙 _ ≫ 𝟙 _))
      simp only [Functor.map_id, Category.id_comp]
      rfl
    | some i =>
      cases j with
      | none =>
        change HEq (𝟙 _ ≫ (𝟙 _ ≫ ((𝟙 _ ≫ (Discrete.functor B).map (𝟙 _)) ≫ 𝟙 _)))
          (𝟙 _ ≫ (𝟙 _ ≫ 𝟙 _))
        simp only [Functor.map_id, Category.id_comp]
        rfl
      | some j =>
        change HEq (𝟙 _ ≫ (𝟙 _ ≫ (𝟙 _ ≫ 𝟙 _))) (𝟙 _ ≫ (𝟙 _ ≫ 𝟙 _))
        simp only [Category.id_comp]
        rfl

variable [FiniteTensor C]

/-- The atomic weighted comparison is the strict original flatten/map
comparison with identity components at the literal original (i,j) positions. -/
theorem atomicWeightedIso_hom (N : FiniteFamily (FiniteFamily C))
    (L : ((FiniteFamily.flatten (C := C)).obj N).index → FiniteFamily C) :
    (Grouping.atomicWeightedIso N L).hom = 𝟙 _ := by
  let T := FiniteTensor.tensor (V := C)
  let K := (FiniteFamily.flatten (C := C)).obj N
  let A := combinedInputBlocks K.index K.obj L
  have ha : (Grouping.atomicCombinedIso N L).hom = 𝟙 A := rfl
  have ht : (FiniteFamily.map T).map (Grouping.atomicCombinedIso N L).hom =
      𝟙 ((FiniteFamily.map T).obj A) :=
    (congrArg (FiniteFamily.map T).map ha).trans ((FiniteFamily.map T).map_id A)
  exact (congrArg (𝟙 ((FiniteFamily.map T).obj A) ≫ ·) ht).trans (Category.id_comp _)

/-- The original weighted regrouping is exactly the weighted map
of the original coefficient permutation and each supplied input identity. -/
theorem atomicSource_relabel (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (atomicSourceIsoA O B d Q).hom ≫
      weightedInputBlockRelabelMap (envelopingAssocRootFirstCoefficientIso O d Q).hom.equiv
        (envelopingAssocRootFirstCoefficientIso O d Q).hom.hom
        (fun p => (coefficientInputsRelabelIso O B d Q p).hom) =
      (atomicSourceIsoB O B d Q).hom := by
  let T := FiniteTensor.tensor (V := C)
  let f := weightedInputBlockRelabelMap
    (envelopingAssocRootFirstCoefficientIso O d Q).hom.equiv
    (envelopingAssocRootFirstCoefficientIso O d Q).hom.hom
    (fun p => (coefficientInputsRelabelIso O B d Q p).hom)
  have hId (X : C) (L : FiniteFamily C) :
      T.map (coefficientLeafMap (𝟙 X) (𝟙 L)) =
        𝟙 ((coefficientLeafTensorFunctor L).obj X) :=
    (congrArg T.map (coefficientLeafMap_idLeaves (𝟙 X) L)).trans
      ((congrArg T.map ((coefficientLeafFamilyFunctor L).map_id X)).trans (T.map_id _))
  have ha : (atomicSourceIsoA O B d Q).hom = (weightedSourceIsoA O B d Q).hom :=
    (congrArg ((weightedSourceIsoA O B d Q).hom ≫ ·)
      (atomicWeightedIso_hom (envelopingAssocCoefficientBlocks O d Q)
        (coefficientInputsA O B d Q))).trans (Category.comp_id _)
  have hb : (atomicSourceIsoB O B d Q).hom = (weightedSourceIsoB O B d Q).hom :=
    (congrArg ((weightedSourceIsoB O B d Q).hom ≫ ·)
      (atomicWeightedIso_hom (envelopingAssocRootFirstCoefficientBlocks O d Q)
        (coefficientInputsB O B d Q))).trans (Category.comp_id _)
  have h : (weightedSourceIsoA O B d Q).hom ≫ f = (weightedSourceIsoB O B d Q).hom := by
    apply FiniteFamily.Hom_ext
    · ext p
      rcases p with ⟨i, j⟩
      cases i with
      | none => cases j; rfl
      | some i => cases j <;> rfl
    · intro p
      rcases p with ⟨i, j⟩
      cases i with
      | none =>
        cases j
        let X := O.obj (extendProfile d.middleData.outerProfile Q.root)
        let L := (addedAlgebraInputs B).obj Q.root
        let Y := (coefficientLeafTensorFunctor L).obj X
        change HEq (𝟙 Y ≫ T.map (coefficientLeafMap (𝟙 X) (𝟙 L))) (𝟙 Y ≫ 𝟙 Y)
        exact heq_of_eq (congrArg (𝟙 Y ≫ ·) (hId X L))
      | some i =>
        cases j with
        | none =>
          let X := O.obj (extendProfile (d.localData i).outerProfile (Q.branch i none))
          let L := (addedAlgebraInputs B).obj (Q.branch i none)
          let Y := (coefficientLeafTensorFunctor L).obj X
          change HEq (𝟙 Y ≫ T.map (coefficientLeafMap (𝟙 X) (𝟙 L))) (𝟙 Y ≫ 𝟙 Y)
          exact heq_of_eq (congrArg (𝟙 Y ≫ ·) (hId X L))
        | some j =>
