/- Exact checked source: LinearCarrierRepresentative. -/
section EnvelopingSource283


/-!
# Every original colorwise carrier map through the weighted representative substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem carrierRepresentativeSquares {D : Type*} [Category* D]
    {X X' A A' Y Y' : D} (w : X ⟶ X') (i : X ⟶ A) (i' : X' ⟶ A') (f : A ⟶ A')
    (e : A ⟶ Y) (e' : A' ⟶ Y') (c : Y ⟶ Y')
    (hi : w ≫ i' = i ≫ f) (he : f ≫ e' = e ≫ c) :
    w ≫ (i' ≫ e') = (i ≫ e) ≫ c := by
  rw [← Category.assoc w i', hi, Category.assoc i f, he]
  exact (Category.assoc _ _ _).symm

private theorem carrierCoefficientLeafSquare {D : Type*} [Category* D]
    {X Y : D} (a : X ⟶ Y) {L L' M M' : FiniteFamily D}
    (l : L ⟶ L') (b : L ⟶ M) (b' : L' ⟶ M') (c : M ⟶ M')
    (h : l ≫ b' = b ≫ c) :
    coefficientLeafMap (𝟙 X) l ≫ coefficientLeafMap a b' =
      coefficientLeafMap a b ≫ coefficientLeafMap (𝟙 Y) c := by
  simp only [coefficientLeafMap_comp, Category.id_comp, Category.comp_id]
  exact congrArg (coefficientLeafMap a) h

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- Every original root and inner added-input family retains the
actual original colorwise input map at every original leaf position. -/
def envelopingBlockCarrierMap {B D : W → C} (f : B ⟶ D)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingBlockAlgebraLeaves B s Q ⟶ envelopingBlockAlgebraLeaves D s Q :=
  (FiniteFamily.flatten (C := C)).map
    (inputBlockMap (FintypeCat.of (Option s.inner.index))
      (fun i => (addedAlgebraInputMap f).app (Q i)))

/-- The exact original root/inner leaf bijection commutes with every
actual original colorwise carrier arrow, including all empty branches. -/
theorem envelopingAlgebraLeafIso_carrier {B D : W → C} (f : B ⟶ D)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingBlockCarrierMap f s Q ≫ (envelopingAlgebraLeafIso D s Q).hom =
      (envelopingAlgebraLeafIso B s Q).hom ≫
        (addedAlgebraInputMap f).app (envelopingTotalAlgebraInputs s Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      let g := f ((Q none).obj j).as
      change HEq (g ≫ 𝟙 _) (𝟙 _ ≫ g)
      exact heq_of_eq ((Category.comp_id g).trans (Category.id_comp g).symm)
    | some i =>
      let g := f ((Q (some i)).obj j).as
      change HEq (g ≫ 𝟙 _) (𝟙 _ ≫ g)
      exact heq_of_eq ((Category.comp_id g).trans (Category.id_comp g).symm)

variable [FiniteTensor C]

/-- Every actual weighted root/inner representative receives its
original carrier map on the original added inputs in each original slot. -/
def envelopingWeightedCarrierMap (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingWeightedRepresentativeFamily O B s Q ⟶
      envelopingWeightedRepresentativeFamily O D s Q :=
  weightedInputBlockMap (FintypeCat.of (Option s.inner.index))
    (fun i => 𝟙 (O.obj (extendProfile (envelopingSlotProfile s i) (Q i))))
    (fun i => (addedAlgebraInputMap f).app (Q i))

/-- The literal representative substitution is natural in every
original colorwise carrier arrow. Its original coefficient map is
unchanged and every original root/inner leaf uses that actual arrow. -/
theorem envelopingRepresentativeEvaluation_carrier (O : ColoredOperadObj W C)
    {B D : W → C} (f : B ⟶ D) (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (envelopingWeightedCarrierMap O.toCollection f s Q) ≫
      envelopingRepresentativeEvaluation O D s Q =
    envelopingRepresentativeEvaluation O B s Q ≫
      (linearCoefficientCarrierMap O.toCollection f s.totalProfile).app
        (envelopingTotalAlgebraInputs s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let I := FintypeCat.of (Option s.inner.index)
  let K := fun i : I => O.toCollection.obj (extendProfile (envelopingSlotProfile s i) (Q i))
  let A := fun i : I => (addedAlgebraInputs B).obj (Q i)
  let A' := fun i : I => (addedAlgebraInputs D).obj (Q i)
  let w := T.map (envelopingWeightedCarrierMap O.toCollection f s Q)
  let i := (coefficientBlockInterchangeTensorIso I K A).hom
  let i' := (coefficientBlockInterchangeTensorIso I K A').hom
  let l := envelopingBlockCarrierMap f s Q
  let r := T.map (coefficientLeafMap (𝟙 (T.obj (coefficientBlockFamily I K))) l)
  let a := T.map (envelopingCoefficientBlockIso O.toCollection s Q).hom ≫
    envelopingRepresentativeCoefficientSubstitution O s Q
  let b := (envelopingAlgebraLeafIso B s Q).hom
  let b' := (envelopingAlgebraLeafIso D s Q).hom
  let c := (addedAlgebraInputMap f).app (envelopingTotalAlgebraInputs s Q)
  let e := T.map (coefficientLeafMap a b)
  let e' := T.map (coefficientLeafMap a b')
  let t := T.map (coefficientLeafMap (𝟙 (O.toCollection.obj
    (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q)))) c)
  have hi : w ≫ i' = i ≫ r :=
    (coefficientBlockInterchangeTensorIso_naturality I
      (fun j => 𝟙 (K j)) (fun j => (addedAlgebraInputMap f).app (Q j))).trans
      (congrArg (fun k => i ≫ T.map (coefficientLeafMap k l))
        ((congrArg T.map (rfl : coefficientBlockMap I (fun j => 𝟙 (K j)) =
          𝟙 (coefficientBlockFamily I K))).trans
          (T.map_id _)))
  have he : r ≫ e' = e ≫ t := (T.map_comp _ _).symm.trans
    ((congrArg T.map (carrierCoefficientLeafSquare a l b b' c
      (envelopingAlgebraLeafIso_carrier f s Q))).trans
      (T.map_comp _ _))
  exact carrierRepresentativeSquares w i i' r e e' t hi he


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource283

/- Exact checked source: LinearCarrierOperad. -/
section EnvelopingSource284


/-!
# Genuine linear operad functoriality in every original colorwise carrier map
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem carrierSubstitutionCofanFiring {D : Type*} [Category* D]
    {X X' A A' E E' Y Y' : D}
    (i : X ⟶ A) (s : A ⟶ Y) (t : Y ⟶ Y') (f : A ⟶ A') (s' : A' ⟶ Y')
    (e : X ⟶ E) (j : E ⟶ Y) (c : E ⟶ E') (j' : E' ⟶ Y')
    (w : X ⟶ X') (i' : X' ⟶ A') (e' : X' ⟶ E')
    (hs : i ≫ s = e ≫ j) (hj : j ≫ t = c ≫ j')
    (hf : i ≫ f = w ≫ i') (hs' : i' ≫ s' = e' ≫ j') (he : w ≫ e' = e ≫ c) :
    i ≫ (s ≫ t) = i ≫ (f ≫ s') := by
  have hleft : i ≫ (s ≫ t) = e ≫ c ≫ j' := by
    rw [← Category.assoc i s, hs, Category.assoc e j, hj]
  have hright : i ≫ (f ≫ s') = e ≫ c ≫ j' := by
    rw [← Category.assoc i f, hf, Category.assoc w i', hs', ← Category.assoc w e', he]
    exact Category.assoc _ _ _
  exact hleft.trans hright.symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

/-- All original root/inner coefficient cofans commute with the
original colorwise carrier map and its actual source factor map. -/
theorem linearCarrier_representativeCofan (O : ColoredSymmetricCollection W C)
    {B D : W → C} (f : B ⟶ D) (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    Linear.representativeCofanMap O B s Q ≫
      ColoredOperadObj.HomData.factorHom (linearCarrierCollectionMap O f) s =
    envelopingWeightedCarrierMap O f s Q ≫ Linear.representativeCofanMap O D s Q := by
  simp only [Linear.representativeCofanMap_eq]
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (linearCoefficientι_carrier O f s.outerProfile (Q none))
    | some i => exact heq_of_eq (linearCoefficientι_carrier O f (s.inner.obj i) (Q (some i)))

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Every original colorwise carrier map preserves literal original
linear substitution, proved on the original full weighted coefficient
cofan and its exact original source factor map. -/
theorem linearCarrier_substitution (O : ColoredOperadObj W C)
    {B D : W → C} (f : B ⟶ D) (s : ColoredSubstitutionData W) :
    envelopingLinearSubstitution O B s ≫ (linearCarrierCollectionMap O.toCollection f).app
      s.totalProfile =
      ColoredOperadObj.HomData.sourceHom (linearCarrierCollectionMap O.toCollection f) s ≫
        envelopingLinearSubstitution O D s := by
  let T := FiniteTensor.tensor (V := C)
  let b := envelopingLinearSubstitution O B s
  let c := (linearCarrierCollectionMap O.toCollection f).app s.totalProfile
  let g := ColoredOperadObj.HomData.sourceHom (linearCarrierCollectionMap O.toCollection f) s
  let b' := envelopingLinearSubstitution O D s
  apply envelopingLinearSubstitution_hom_ext O.toCollection B s
  intro Q
  let i := T.map (Linear.representativeCofanMap O.toCollection B s Q)
  let i' := T.map (Linear.representativeCofanMap O.toCollection D s Q)
  let e := envelopingRepresentativeEvaluation O B s Q
  let e' := envelopingRepresentativeEvaluation O D s Q
  let j := linearCoefficientι O.toCollection B s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let j' := linearCoefficientι O.toCollection D s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let t := (linearCoefficientCarrierMap O.toCollection f s.totalProfile).app
    (envelopingTotalAlgebraInputs s Q)
  let w := T.map (envelopingWeightedCarrierMap O.toCollection f s Q)
  have hs : i ≫ b = e ≫ j := Linear.representativeCofanMap_β O B s Q
  have hj : j ≫ c = t ≫ j' := linearCoefficientι_carrier O.toCollection f s.totalProfile
    (envelopingTotalAlgebraInputs s Q)
  have hg : i ≫ g = w ≫ i' := (T.map_comp _ _).symm.trans
    ((congrArg T.map (linearCarrier_representativeCofan O.toCollection f s Q)).trans
      (T.map_comp _ _))
  have hs' : i' ≫ b' = e' ≫ j' := Linear.representativeCofanMap_β O D s Q
  have he : w ≫ e' = e ≫ t := envelopingRepresentativeEvaluation_carrier O f s Q
  have h := carrierSubstitutionCofanFiring i b c g b' e j t j' w i' e' hs hj hg hs' he
  have hi : envelopingLinearSubstitutionInjection O.toCollection B s Q = i :=
    (envelopingLinearSubstitutionInjection_readback O.toCollection B s Q).trans
      (congrArg T.map (Linear.representativeCofanMap_eq O.toCollection B s Q).symm)
  exact (congrArg (· ≫ (b ≫ c)) hi).trans
    (h.trans (congrArg (· ≫ (g ≫ b')) hi.symm))

/-- The actual original colorwise carrier arrow produces a full
map of genuine linear operads, with no unit/substitution law premise. -/
def linearCarrierOperadMap (O : ColoredOperadObj W C) {B D : W → C} (f : B ⟶ D) :
    envelopingLinearOperad O B ⟶ envelopingLinearOperad O D where
  toCollectionHom := linearCarrierCollectionMap O.toCollection f
  map_unit := linearCarrier_unit O f
  map_subst := linearCarrier_substitution O f

/-- The operad map retains the actual original coefficient carrier map. -/
theorem linearCarrierOperadMap_app (O : ColoredOperadObj W C) {B D : W → C}
    (f : B ⟶ D) (P : ColoredProfile W) :
    (linearCarrierOperadMap O f).toCollectionHom.app P = linearCoefficientCarrierLift
      O.toCollection f P := rfl

/-- Original carrier identity maps give the full identity operad arrow. -/
theorem linearCarrierOperadMap_id (O : ColoredOperadObj W C) (B : W → C) :
    linearCarrierOperadMap O (𝟙 B) = 𝟙 (envelopingLinearOperad O B) := by
  apply ColoredOperadObj.Hom.ext
  exact linearCarrierCollectionMap_id O.toCollection B

/-- The full operad carrier map preserves original composition. -/
theorem linearCarrierOperadMap_comp (O : ColoredOperadObj W C) {B D E : W → C}
    (f : B ⟶ D) (g : D ⟶ E) :
    linearCarrierOperadMap O (f ≫ g) = linearCarrierOperadMap O f ≫ linearCarrierOperadMap O g := by
  apply ColoredOperadObj.Hom.ext
  exact linearCarrierCollectionMap_comp O.toCollection f g

/-- The constructed literal linear operad is functorial in the
original full colorwise carrier category. -/
def linearCarrierOperadFunctor (O : ColoredOperadObj W C) : (W → C) ⥤ ColoredOperadObj W C where
  obj := envelopingLinearOperad O
  map := linearCarrierOperadMap O
  map_id := linearCarrierOperadMap_id O
  map_comp := linearCarrierOperadMap_comp O

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual O-algebra action is the full algebra-relation operad face. -/
def algebraRelationOperadFace (O : ColoredOperadObj W C) (A : Algebra O) :
    envelopingLinearOperad O (profileCoinvariants O.toCollection A.carrier) ⟶
      envelopingLinearOperad O A.carrier :=
  linearCarrierOperadMap O A.action

/-- The original generator map is the full operadic relation section. -/
def algebraRelationOperadSection (O : ColoredOperadObj W C) (A : Algebra O) :
    envelopingLinearOperad O A.carrier ⟶ envelopingLinearOperad O (profileCoinvariants
      O.toCollection A.carrier) :=
  linearCarrierOperadMap O ((profileUnit O).app A.carrier)

/-- The full relation face retains precisely the original algebra action. -/
theorem algebraRelationOperadFace_app (O : ColoredOperadObj W C) (A : Algebra O) (P :
  ColoredProfile W) :
    (algebraRelationOperadFace O A).toCollectionHom.app P = algebraInputRelation O A P := rfl

/-- The actual original algebra unit proves full operad reflexivity
for the original action face and generator section. -/
theorem algebraRelationOperadSection_action (O : ColoredOperadObj W C) (A : Algebra O) :
    algebraRelationOperadSection O A ≫ algebraRelationOperadFace O A =
      𝟙 (envelopingLinearOperad O A.carrier) := by
  exact (linearCarrierOperadMap_comp O ((profileUnit O).app A.carrier) A.action).symm.trans
    ((congrArg (linearCarrierOperadMap O) (Algebra.action_unit A)).trans
      (linearCarrierOperadMap_id O A.carrier))


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource284

/- Exact checked source: UnitCoefficientLeaves. -/
section EnvelopingSource285


/-!
# The original coefficient unit law with all original algebra leaves

The original coefficient right-unit equation is tensorized with the
original algebra-leaf family and its actual sigma-unit bijection. Every
original coefficient and leaf map remains in the complete tensor equation.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit

open CategoryTheory

private theorem EnvelopingSource285_mapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by
  simp only [Functor.map_comp]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original coefficient/leaf evaluation of the unary
unit coefficients, followed by its actual total-input bijection, is
the complete original coefficient/input identity map. -/
theorem unitCoefficientLeafEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (Weighted.unaryCoefficientUnitInsertion O P Q)
          ((addedAlgebraInputs B).map (unaryTotalInputsIso Q).inv)) ≫
        (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q (unaryBranches Q))).map
          (frozenPartialSubstitution O P Q (unaryBranches Q)) ≫
        (linearCoefficientDiagram O.toCollection B P).map (unaryTotalInputsIso Q).hom =
      𝟙 ((linearCoefficientDiagram O.toCollection B P).obj Q) := by
  let T := FiniteTensor.tensor (V := C)
  let F := addedAlgebraInputs B
  let L := F.obj Q
  let M := frozenAlgebraLeaves B Q (unaryBranches Q)
  let i := Weighted.unaryCoefficientUnitInsertion O P Q
  let a := frozenPartialSubstitution O P Q (unaryBranches Q)
  let c := O.toCollection.map (extendProfileMap (𝟙 P) (unaryTotalInputsIso Q).hom)
  let l := F.map (unaryTotalInputsIso Q).inv
  let r := F.map (unaryTotalInputsIso Q).hom
  let m := coefficientLeafMap i l
  let n := (coefficientLeafFamilyFunctor M).map a
  let t := coefficientLeafMap c r
  have hc : (i ≫ a) ≫ c = 𝟙 (O.toCollection.obj (extendProfile P Q)) :=
    (Category.assoc i a c).trans (unaryPartialSubstitution_unit O P Q)
  have hl : l ≫ r = 𝟙 L := (F.map_comp _ _).symm.trans
    ((congrArg F.map (unaryTotalInputsIso Q).inv_hom_id).trans (F.map_id Q))
  have h1 : m ≫ n = coefficientLeafMap (i ≫ a) l := coefficientLeafMap_post i a l
  have h2 : coefficientLeafMap (i ≫ a) l ≫ t = coefficientLeafMap ((i ≫ a) ≫ c) (l ≫ r) :=
    coefficientLeafMap_comp _ _ _ _
  have h3 : coefficientLeafMap ((i ≫ a) ≫ c) (l ≫ r) =
      coefficientLeafMap (𝟙 (O.toCollection.obj (extendProfile P Q))) (𝟙 L) :=
    congrArg₂ (fun (f : O.toCollection.obj (extendProfile P Q) ⟶ O.toCollection.obj
      (extendProfile P Q))
      (l : L ⟶ L) => coefficientLeafMap f l) hc hl
  have h4 : coefficientLeafMap (𝟙 (O.toCollection.obj (extendProfile P Q))) (𝟙 L) =
      𝟙 ((coefficientLeafFamilyFunctor L).obj (O.toCollection.obj (extendProfile P Q))) :=
    (coefficientLeafMap_idLeaves _ L).trans ((coefficientLeafFamilyFunctor L).map_id _)
  have h : m ≫ n ≫ t = 𝟙 ((coefficientLeafFamilyFunctor L).obj (O.toCollection.obj
    (extendProfile P Q))) :=
    (Category.assoc m n t).symm.trans
      ((congrArg (· ≫ t) h1).trans (h2.trans (h3.trans h4)))
  exact (EnvelopingSource285_mapThree T m n t).symm.trans ((congrArg T.map h).trans (T.map_id _))


end CategoryTheory.Operad.Tensor.Enveloping.Unit

end
end EnvelopingSource285

/- Exact checked source: UnitWeightedSource. -/
section EnvelopingSource286


/-!
# Original empty/singleton source comparison for weighted unit prefixes

The original input family is mapped into the complete branchwise raw
coefficient/leaf factors. The finite tensor's original map-singleton law
identifies the source with the original component singleton prefixes.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Unit.Weighted

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original arbitrary root coefficient and every original
algebra input, at their actual option positions. -/
def prefixInputFamily (X : C) (B : W → C) (Q : ColoredInputs W) : FiniteFamily C :=
  (coefficientLeafFamilyFunctor ((addedAlgebraInputs B).obj Q)).obj X

/-- The complete original branchwise raw coefficient/leaf factors. -/
def rawPrefixBlocks (X : C) (B : W → C) (Q : ColoredInputs W) : FiniteFamily (FiniteFamily C) :=
  (FiniteFamily.map (FiniteFamily.flatten (C := C))).obj
    (partitionedCoefficientLeavesTriple (UnitInsertion.rightNestedFamily X Q.index)
      (prefixLeaves B Q))

/-- Every original input singleton has its actual root or unit
coefficient/leaf raw comparison in its original branch. -/
def rawPrefixBlockMap (X : C) (B : W → C) (Q : ColoredInputs W) :
    (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj (prefixInputFamily X B Q) ⟶
      rawPrefixBlocks X B Q where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => (emptyLeafRawIso ((FiniteFamily.singleton (C := C)).obj X)).inv
    | some j => (unitCoefficientFlattenIso ((FiniteFamily.singleton (C :=
      C)).obj (B (Q.obj j).as))).hom

/-- The original input family maps to the full raw branch factors
through its original map-singleton inverse and original branch maps. -/
def rawPrefixSourceMap (X : C) (B : W → C) (Q : ColoredInputs W) :
    prefixInputFamily X B Q ⟶ (FiniteFamily.flatten (C := C)).obj (rawPrefixBlocks X B Q) :=
  FiniteFamily.mapSingletonFlattenIso.inv.app (prefixInputFamily X B Q) ≫
    (FiniteFamily.flatten (C := C)).map (rawPrefixBlockMap X B Q)

/-- The complete original raw branch source preserves the exact
root singleton map and the original partitioned algebra-leaf bijection. -/
theorem rawPrefixSource_comparison (X : C) (B : W → C) (Q : ColoredInputs W) :
    rawPrefixSourceMap X B Q ≫
        (partitionedCoefficientLeavesSourceIso (UnitInsertion.rightNestedFamily X Q.index)
          (prefixLeaves B Q)).hom =
      FiniteFamily.mapSingletonFlattenIso.inv.app (prefixInputFamily X B Q) ≫
        (FiniteFamily.flatten (C := C)).map (singletonCoefficientLeavesIso X
          ((addedAlgebraInputs B).obj Q)).inv ≫
          (FiniteFamily.flatten (C := C)).map
            (coefficientLeavesNestedMap (UnitInsertion.rightSingletonToFlatten X Q.index)
              (prefixLeafIso X B Q).inv) := by
  apply FiniteFamily.Hom.ext_identityComponents
  · ext i
    cases i <;> rfl
  · have h0 : (FiniteFamily.mapSingletonFlattenIso.inv.app (prefixInputFamily X B
    Q)).HasIdentityComponents :=
      FiniteFamily.Hom.HasIdentityComponents.iso_inv
        (FiniteFamily.mapSingletonFlattenIso.app (prefixInputFamily X B Q))
        (mapSingletonFlatten_identity _)
    have h1 : ∀ i, ((rawPrefixBlockMap X B Q).hom i).HasIdentityComponents := by
      intro i
