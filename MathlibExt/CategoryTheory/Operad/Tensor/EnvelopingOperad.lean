variable {W : Type uc} {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- The complete tensor operation family respects an actual full operad triangle. -/
theorem restrictionOperations_triangle {O P Q : ColoredOperadObj W C}
    (u : O ⟶ P) (v : P ⟶ Q) (w : O ⟶ Q) (h : u ≫ v = w)
    {M N : W → C} (a : Operations Q.toCollection M N) :
