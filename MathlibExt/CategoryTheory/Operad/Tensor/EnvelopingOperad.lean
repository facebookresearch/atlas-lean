/-!
# Actual coefficient, constant and unit sources for the full branching contraction
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The family of nullary coefficient objects of the colored collection. -/
def nullaryCarrier (E : ColoredSymmetricCollection W C) : W → C := fun c =>
  E.obj (ColoredProfile.nullary c)

/-- The original root singleton, each displayed original frozen branch
coefficient family, and every original root-added nullary singleton. -/
def rawGroupsA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option (s.inner.index ⊕ (Q none).index))
  obj i := match i with
    | none => (FiniteFamily.singleton (C := C)).obj (E.obj (extendProfile s.outerProfile (Q none)))
    | some (Sum.inl i) => frozenCoefficientFamily E (s.inner.obj i) (Q (some i))
      (Constants.branches (Q (some i)))
    | some (Sum.inr i) => (FiniteFamily.singleton (C := C)).obj (E.obj
      (ColoredProfile.nullary ((Q none).obj i).as))

/-- Flatten the root singleton, frozen variable branches, and root-nullary singletons to form
the raw factors. -/
def rawFactors (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    FiniteFamily C := (FiniteFamily.flatten (C := C)).obj (rawGroupsA E s Q)

/-- Pair each extended slot coefficient with its added nullary-input leaf family. -/
def weightedBlocks (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    FiniteFamily (FiniteFamily C) :=
  combinedInputBlocks (FintypeCat.of (Option s.inner.index))
    (fun i => E.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
    (fun i => (addedAlgebraInputs (nullaryCarrier E)).obj (Q i))

/-- The exact original coefficient and constant positions in the branch
source, without adding, erasing or identifying any coefficient. -/
def weightedRawIsoA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q
  : EnvelopingInputChoices s)
  :
    (FiniteFamily.flatten (C := C)).obj (weightedBlocks E s Q) ≅ rawFactors E s Q :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with
        | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
        | ⟨none, some j⟩ => ⟨some (Sum.inr j), PUnit.unit⟩
        | ⟨some i, j⟩ => ⟨some (Sum.inl i), j⟩
      invFun := fun p => match p with
        | ⟨none, _⟩ => ⟨none, none⟩
        | ⟨some (Sum.inl i), j⟩ => ⟨some i, j⟩
        | ⟨some (Sum.inr j), _⟩ => ⟨none, some j⟩
      left_inv := fun p =>
        by rcases p with ⟨i, j⟩; cases i with | none => cases j <;> rfl | some i => rfl
      right_inv := fun p => by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j; rfl
        | some i =>
          cases i with
          | inl i => rfl
          | inr i => cases j; rfl }
    (fun p => by
      rcases p with ⟨i, j⟩
      cases i with
      | none => cases j <;> exact Iso.refl _
      | some i => cases j <;> exact Iso.refl _)

/-- Every original coefficient and original total constant is retained by
the exact original coefficient/input grouping bijection. -/
def rawInputIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    rawFactors E s Q ≅ (FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested (envelopingRepresentativeCoefficients E s Q)
        ((addedAlgebraInputs (nullaryCarrier E)).obj (envelopingTotalAlgebraInputs s Q))) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with
        | ⟨none, _⟩ => ⟨none, none⟩
        | ⟨some (Sum.inl i), none⟩ => ⟨none, some i⟩
        | ⟨some (Sum.inl i), some j⟩ => ⟨some (Sum.inr ⟨i, j⟩), PUnit.unit⟩
        | ⟨some (Sum.inr j), _⟩ => ⟨some (Sum.inl j), PUnit.unit⟩
      invFun := fun p => match p with
        | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
        | ⟨none, some i⟩ => ⟨some (Sum.inl i), none⟩
        | ⟨some (Sum.inl j), _⟩ => ⟨some (Sum.inr j), PUnit.unit⟩
        | ⟨some (Sum.inr ⟨i, j⟩), _⟩ => ⟨some (Sum.inl i), some j⟩
      left_inv := fun p => by
        rcases p with ⟨i, j⟩
        cases i with
          | none => cases j; rfl
          | some i => cases i with
          | inl i => cases j <;> rfl
          | inr i => cases j; rfl
      right_inv := fun p => by
        rcases p with ⟨i, j⟩
        cases i with | none => cases j <;> rfl | some i => cases i <;> cases j <;> rfl }
    (fun p => by
      rcases p with ⟨i, j⟩
      cases i with
      | none => exact Iso.refl _
      | some i =>
        cases i with
        | inl i => cases j <;> exact Iso.refl _
        | inr i => exact Iso.refl _)

/-- This displayed raw input permutation is exactly the original coefficient
block interchange and the original coefficient and dependent leaf corrections. -/
theorem rawInputIso_original (E : ColoredSymmetricCollection W C) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (weightedRawIsoA E s Q).hom ≫ (rawInputIso E s Q).hom =
      (coefficientBlockInterchangeFamilyIso (FintypeCat.of (Option s.inner.index))
        (fun i => E.obj (extendProfile (envelopingSlotProfile s i) (Q i)))
        (fun i => (addedAlgebraInputs (nullaryCarrier E)).obj (Q i))).hom ≫
        (FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap
          (envelopingCoefficientBlockIso E s Q).hom (envelopingAlgebraLeafIso
            (nullaryCarrier E) s Q).hom) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with | none => cases j <;> rfl | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with | none => cases j <;> rfl | some i => cases j <;> rfl

variable [FiniteTensor C]

/-- Flatten and permute the weighted representative tensor to the tensor of raw coefficient
factors. -/
def weightedSourceToRawIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (envelopingWeightedRepresentativeFamily E
      (nullaryCarrier E) s Q) ≅
      (FiniteTensor.tensor (V := C)).obj (rawFactors E s Q) :=
  ((FiniteTensor.flattenIso (V := C)).app (weightedBlocks E s Q)).symm ≪≫
    (FiniteTensor.tensor (V := C)).mapIso (weightedRawIsoA E s Q)

/-- The unit positions consisting of root-added inputs and the leaves of the total variable
profile. -/
def unitIndex (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) : FintypeCat.{0} :=
  FintypeCat.of ((Q none).index ⊕ s.totalProfile.inputs)

/-- Assign leaf-color units to variable branches and one unit to each root-added nullary branch. -/
def unitPositionsA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (rawGroupsA E s Q).index → FintypeCat.{0}
  | none => FintypeCat.of (Fin 0)
  | some (Sum.inl i) => (s.inner.obj i).inputs
  | some (Sum.inr _) => FintypeCat.of PUnit

/-- Identify the combined root-input and variable-leaf unit positions with their positions in
the raw blocks. -/
def unitPositionEquivA (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    unitIndex s Q ≃ blockUnitIndex (rawGroupsA E s Q) (unitPositionsA E s Q) where
  toFun p := match p with
    | Sum.inl j => ⟨some (Sum.inr j), PUnit.unit⟩
    | Sum.inr ⟨i, j⟩ => ⟨some (Sum.inl i), j⟩
  invFun p := match p with
    | ⟨none, j⟩ => Fin.elim0 j
    | ⟨some (Sum.inl i), j⟩ => Sum.inr ⟨i, j⟩
    | ⟨some (Sum.inr j), _⟩ => Sum.inl j
  left_inv p := by cases p <;> rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => exact Fin.elim0 j
    | some i =>
      cases i with
      | inl i => rfl
      | inr i => cases j; rfl

/-- Insert branch units into the first associativity grouping, transporting the extended root
profile. -/
def localUnitMapA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s)
    (i : (rawGroupsA E.toCollection s Q).index) :
    frozenVariableUnitFamily (unitPositionsA E.toCollection s Q i) ((rawGroupsA
      E.toCollection s Q).obj i) ⟶
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj i :=
  match i with
  | none => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
        ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (extendProfile
          s.outerProfile (Q none))))).hom ≫
      (FiniteFamily.singleton (C := C)).map (E.toCollection.map
        (envelopingRepresentativeOuterHom s Q ≫
        ColoredSubstitutionData.outerProfileMap (middleCompare s Q)))
  | some (Sum.inl i) => frozenUnitCoefficientMap E (s.inner.obj i) (Q (some i))
    (Constants.branches (Q (some i)))
  | some (Sum.inr j) => Constants.leftFrozenUnitMap E (ColoredProfile.nullary ((Q none).obj j).as)

/-- Assemble all branch unit insertions into the flattened first associativity grouping. -/
def globalUnitMapA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    frozenVariableUnitFamily (unitIndex s Q) (rawFactors E.toCollection s Q) ⟶
      ColoredOperadObj.AssocInsertion.flattenedGroupingA E.toCollection (assocData s Q) :=
  Variable.unitFamilyMap (unitPositionEquivA E.toCollection s Q) (𝟙 (rawFactors
    E.toCollection s Q)) ≫
    blockUnitGlobalMap (rawGroupsA E.toCollection s Q) (unitPositionsA E.toCollection s Q)
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj
        (localUnitMapA E s Q)

/-- Expand the raw coefficient tensor by units to the common source of the associativity
equation. -/
def expandedSource (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      ColoredOperadObj.associativityCommonSource E.toCollection (assocData s Q) :=
  (frozenVariableTensorUnitIso (unitIndex s Q) (rawFactors E.toCollection s Q)).hom ≫
    (FiniteTensor.tensor (V := C)).map (globalUnitMapA E s Q)

/-- Apply the branch unit insertions to the tensors of the raw coefficient blocks. -/
def appliedMapA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsA E.toCollection s Q) ⟶
      (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (ColoredOperadObj.AssocInsertion.groupingA E.toCollection
        (assocData s Q)) :=
  blockUnitAppliedMap (rawGroupsA E.toCollection s Q) (unitPositionsA E.toCollection s Q)
    (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj
      (localUnitMapA E s Q)

theorem expandedSource_groupedA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    expandedSource E s Q ≫ (FiniteTensor.flattenIso (V := C)).hom.app
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)) =
    (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q) ≫
      (FiniteTensor.tensor (V := C)).map
      (appliedMapA E s Q) :=
  (Category.assoc _ _ _).trans
    (Root.semanticUnitBlock_applied (unitIndex s Q) (rawGroupsA E.toCollection s Q)
      (unitPositionsA E.toCollection s Q)
      (ColoredOperadObj.AssocInsertion.groupingA E.toCollection (assocData s Q)).obj
        (localUnitMapA E s Q)
        (unitPositionEquivA E.toCollection s Q))

/-- Evaluate each frozen variable branch while retaining the root and root-added nullary
coefficients. -/
def branchEvaluationFactorMap (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q
  : EnvelopingInputChoices s)
  :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsA E.toCollection s Q) ⟶
      Root.rawFactors E.toCollection s (Q none) where
  equiv := Equiv.refl (Option (s.inner.index ⊕ (Q none).index))
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj
      (extendProfile s.outerProfile (Q none)))
    | some (Sum.inl i) => frozenPartialSubstitution E (s.inner.obj i) (Q (some i))
      (Constants.branches (Q (some i))) ≫
        E.toCollection.map (Constants.totalProfileHom (s.inner.obj i) (Q (some i)))
    | some (Sum.inr i) => (FiniteTensor.singletonIso (V :=
      C)).hom.app (E.toCollection.obj (ColoredProfile.nullary ((Q
      none).obj i).as))

/-- Evaluate the frozen branches and transport the root to the general substitution factors. -/
def collapsedFactorsA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (rawGroupsA E.toCollection s Q) ⟶
      (ColoredOperadObj.substitutionFactors E.toCollection).obj (generalSubstitution s (Q none)) :=
  branchEvaluationFactorMap E s Q ≫ Root.generalFactorMap E.toCollection s (Q none)

/-- Evaluate the constants inside each branch before substituting the resulting variable and
nullary operations. -/
def insideRoute (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).obj (rawFactors E.toCollection s Q) ⟶
      E.toCollection.obj s.totalProfile :=
  (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q) ≫
    (FiniteTensor.tensor (V := C)).map (collapsedFactorsA E s Q) ≫
      E.subst.app (generalSubstitution s (Q none)) ≫
      E.toCollection.map (generalTotalHom s (Q none))


