def operationπ (M : W → C) {d : W} (q : AnalyticIndex W d) :
    (analyticSummand Q.toCollection M).obj q ⟶ (analyticSummand (collection f g) M).obj q :=
  (analyticSummandCollectionMap M (collectionπ f g)).app q

include t hf hg in
