namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem mapThreeInput {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem padRootInput {D : Type*} [Category* D] {A B C : D} (r : A ⟶ B) (f : B ⟶ C) :
    𝟙 A ≫ 𝟙 A ≫ (𝟙 A ≫ r ≫ 𝟙 B) ≫ f = r ≫ f := by simp only [Category.id_comp, Category.comp_id]

private theorem padConstantInput {D : Type*} [Category* D] {A B : D} (z : A ⟶ B) :
    𝟙 A ≫ 𝟙 A ≫ (z ≫ 𝟙 B ≫ 𝟙 B) ≫ 𝟙 B = z := by simp only [Category.id_comp, Category.comp_id]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The actual E-nullary leaf objects are the literal original nullary
coefficient family through identities at every original position. -/
def nullaryInputCoefficientIso (E : ColoredSymmetricCollection W C) (P : ColoredProfile W)
  (Q : ColoredInputs W) :
    (coefficientLeafFamilyFunctor ((addedAlgebraInputs (nullaryCarrier E)).obj Q)).obj
      (E.obj (extendProfile P Q)) ≅
      frozenCoefficientFamily E P Q (Constants.branches Q) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option Q.index))
    (fun i => match i with
      | none => Iso.refl _
      | some _ => Iso.refl _)

variable [FiniteTensor C]

theorem nullaryInputCoefficientIso_hom (E : ColoredOperadObj W C) (P : ColoredProfile W) (Q
  : ColoredInputs W) :
    (nullaryInputCoefficientIso E.toCollection P Q).hom =
      Constants.coefficientMap (𝟙 E) (nullaryCarrier E.toCollection) (fun c => 𝟙 (E.toCollection.obj
        (ColoredProfile.nullary c))) P Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i <;> rfl

/-- Collect the original representative coefficient tensor, evaluate it
by original substitution, and retain every original nullary constant. -/
def inputCoefficientMap (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj (retainedGroups E.toCollection s Q) ⟶
      frozenCoefficientFamily E.toCollection s.totalProfile (envelopingTotalAlgebraInputs s Q)
        (Constants.branches (envelopingTotalAlgebraInputs s Q)) :=
  coefficientLeavesCollapse (envelopingRepresentativeCoefficients E.toCollection s Q)
    (totalLeaves E.toCollection s Q) ≫
    (coefficientLeafFamilyFunctor (totalLeaves E.toCollection s Q)).map
      (envelopingRepresentativeCoefficientSubstitution
      E s Q) ≫
      (nullaryInputCoefficientIso E.toCollection s.totalProfile
        (envelopingTotalAlgebraInputs s Q)).hom

/-- The collapsed original root/variable/constant factors have exactly
the original empty-outer block comparison and original frozen unit map. -/
theorem collapsedFactorsB_factor (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (groupsToEmptyOuterIso
      E.toCollection s Q).hom ≫
      (DisjointNullary.EmptyOuter.pointIso s.totalProfile.inputs (retainedGroups
        E.toCollection s Q)).hom ≫
      frozenVariableUnitFamilyMap s.totalProfile.inputs (inputCoefficientMap E s Q) ≫
        frozenUnitCoefficientMap E s.totalProfile (envelopingTotalAlgebraInputs s Q)
          (Constants.branches (envelopingTotalAlgebraInputs s Q)) = collapsedFactorsB E s Q := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with | none => rfl | some p => cases p <;> rfl
  · intro p
    cases p with
    | none =>
      let R := envelopingRepresentativeCoefficients E.toCollection s Q
      let A := T.obj R
      let Y := E.toCollection.obj (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))
      let r := envelopingRepresentativeCoefficientSubstitution E s Q
      let f := E.toCollection.map (frozenOuterProfileHom s.totalProfile
        (envelopingTotalAlgebraInputs s Q)
        (Constants.branches (envelopingTotalAlgebraInputs s Q)))
      change HEq (T.map (𝟙 R) ≫ 𝟙 A ≫ (𝟙 A ≫ r ≫ 𝟙 Y) ≫ f) (r ≫ f)
      exact heq_of_eq ((congrArg (· ≫ 𝟙 A ≫ (𝟙 A ≫ r ≫ 𝟙 Y) ≫
        f) (T.map_id R)).trans (padRootInput r f))
    | some p =>
      cases p with
      | inl p =>
        let U := T.obj (FiniteFamily.empty : FiniteFamily C)
        let f := E.unit (s.totalProfile.inputColor p)
        change HEq (T.map (𝟙 (FiniteFamily.empty : FiniteFamily C)) ≫ 𝟙 U ≫ 𝟙 U ≫ f) f
        exact heq_of_eq ((congrArg (· ≫ 𝟙 U ≫ 𝟙 U ≫ f) (T.map_id _)).trans
          (by simp only [Category.id_comp]; exact Category.id_comp f))
      | inr p =>
        let X := E.toCollection.obj (ColoredProfile.nullary ((envelopingTotalAlgebraInputs s
          Q).obj p).as)
        let S := (FiniteFamily.singleton (C := C)).obj X
        let z := (FiniteTensor.singletonIso (V := C)).hom.app X
        change HEq (T.map (𝟙 S) ≫ 𝟙 (T.obj S) ≫ (z ≫ 𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) z
        exact heq_of_eq ((congrArg (· ≫ 𝟙 (T.obj S) ≫ (z ≫ 𝟙 X ≫ 𝟙 X) ≫
          𝟙 X) (T.map_id S)).trans (padConstantInput z))

theorem inputCoefficientMap_tensor (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (FiniteTensor.tensor (V := C)).map (inputCoefficientMap E s Q) =
      (FiniteTensor.tensor (V := C)).map (coefficientLeavesCollapse
        (envelopingRepresentativeCoefficients E.toCollection s Q) (totalLeaves
          E.toCollection s Q)) ≫
      (coefficientLeafTensorFunctor (totalLeaves E.toCollection s Q)).map
        (envelopingRepresentativeCoefficientSubstitution E s Q) ≫
        (FiniteTensor.tensor (V := C)).map (nullaryInputCoefficientIso E.toCollection s.totalProfile
          (envelopingTotalAlgebraInputs s Q)).hom :=
  mapThreeInput _ _ _ _


