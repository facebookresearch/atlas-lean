/-!
# Original profiles for contracting root constants before variable substitution
-/

set_option autoImplicit false
noncomputable section
universe u

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Root

open CategoryTheory

variable {W : Type u}

/-- The genuine three-level shape uses each original variable branch in its
original left unit and every original added nullary branch in its empty right unit. -/
def assocData (s : ColoredSubstitutionData W) (Q : ColoredInputs W) : ColoredAssocData W where
  outputColor := s.outputColor
  branches :=
    { index := FintypeCat.of (s.inner.index ⊕ Q.index)
      obj i := match i with
        | Sum.inl i => ColoredSubstitutionData.leftUnit (s.inner.obj i)
        | Sum.inr i => ColoredSubstitutionData.rightUnit (ColoredProfile.nullary (Q.obj i).as) }

/-- Insert the left and right unit profile maps into the middle profiles for root constants. -/
def middleCompare (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    frozenSubstitution s.outerProfile Q (Constants.branches Q) ⟶ (assocData s Q).middleData where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl (s.inner.index ⊕ Q.index)
      hom i := match i with
        | Sum.inl i => ColoredSubstitutionData.leftUnitOuterHom (s.inner.obj i)
        | Sum.inr i => ColoredSubstitutionData.rightUnitOuterHom (ColoredProfile.nullary
          (Q.obj i).as) }

/-- Collapse the inner unit substitutions to the variable and root-nullary branches. -/
def afterInnerCompare (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    (assocData s Q).outerAfterInnerData ⟶ Branch.generalSubstitution s Q where
  outputColor_eq := rfl
  innerHom :=
    { equiv := Equiv.refl (s.inner.index ⊕ Q.index)
      hom i := match i with
        | Sum.inl i => ColoredSubstitutionData.leftUnitTotalHom (s.inner.obj i)
        | Sum.inr i => ColoredSubstitutionData.rightUnitTotalHom (ColoredProfile.nullary
          (Q.obj i).as) }

/-- Remove the empty nullary branches and singleton unit indices to recover the original
substitution datum. -/
def innerCompare (s : ColoredSubstitutionData W) (Q : ColoredInputs W) : (assocData s
  Q).innerData ⟶ s where
  outputColor_eq := rfl
  innerHom :=
    { equiv :=
        { toFun := fun p => match p with | ⟨Sum.inl i, _⟩ => i | ⟨Sum.inr _, j⟩ => Fin.elim0 j
          invFun := fun i => ⟨Sum.inl i, PUnit.unit⟩
          left_inv := fun p => by
            rcases p with ⟨i, j⟩
            cases i with
            | inl i => cases j; rfl
            | inr i => exact Fin.elim0 j
          right_inv := fun _ => rfl }
      hom p := match p with | ⟨Sum.inl _, _⟩ => 𝟙 _ | ⟨Sum.inr _, j⟩ => Fin.elim0 j }

theorem rootProfile_readback (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    frozenOuterProfileHom s.outerProfile Q (Constants.branches Q) ≫
      ColoredSubstitutionData.outerProfileMap (middleCompare s Q) ≫
        ColoredSubstitutionData.outerProfileMap (d := (assocData s Q).outerAfterInnerData)
          (afterInnerCompare s Q) =
      Branch.generalOuterHom s Q := by
  apply ColoredProfile.Hom.ext
  ext i
  cases i <;> rfl

theorem middleTotal_readback (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    ColoredSubstitutionData.totalProfileMap (middleCompare s Q) ≫
      ColoredSubstitutionData.outerProfileMap (innerCompare
      s Q) =
      Constants.substitutionTotalHom s.outerProfile Q := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨i, j⟩
  cases i with | inl i => cases j; rfl | inr i => exact Fin.elim0 j

theorem totalProfile_readback (s : ColoredSubstitutionData W) (Q : ColoredInputs W) :
    (assocData s Q).totalHom ≫ ColoredSubstitutionData.totalProfileMap (afterInnerCompare
      s Q) ≫ Branch.generalTotalHom
      s Q =
      ColoredSubstitutionData.totalProfileMap (innerCompare s Q) := by
  apply ColoredProfile.Hom.ext
  ext p
  rcases p with ⟨⟨i, j⟩, k⟩
  cases i with | inl i => cases j; rfl | inr i => exact Fin.elim0 j


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Root

end
