section EnvelopingSource270


/-!
# Original E-association identifies both full branching constant-contraction routes
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem mapFourBranchRouteB {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G H : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) (d : G ⟶ H) :
    F.map (a ≫ b ≫ c ≫ d) = F.map a ≫ F.map b ≫ F.map c ≫ F.map d := by simp only [Functor.map_comp]

private theorem sourceBranchBFiring {D : Type*} [Category* D] {A B C E F G H J K : D}
    (x : A ⟶ B) (p : B ⟶ C) (f : C ⟶ E) (g : E ⟶ F) (h : F ⟶ G)
    (a : A ⟶ H) (n : H ⟶ J) (l : J ⟶ K) (m : K ⟶ E) (r : J ⟶ G)
    (hd : x ≫ p ≫ f = a ≫ n ≫ l ≫ m) (hl : l ≫ m ≫ g ≫ h = r) :
    x ≫ p ≫ f ≫ g ≫ h = a ≫ n ≫ r := by
  calc
    x ≫ p ≫ f ≫ g ≫ h = (x ≫ p ≫ f) ≫ g ≫ h := by simp only [Category.assoc]
    _ = (a ≫ n ≫ l ≫ m) ≫ g ≫ h := congrArg (· ≫ g ≫ h) hd
    _ = a ≫ n ≫ (l ≫ m ≫ g ≫ h) := by simp only [Category.assoc]
    _ = a ≫ n ≫ r := congrArg (a ≫ n ≫ ·) hl

private theorem branchBRouteFiring {D : Type*} [Category* D] {A B C E F G H J K M : D}
    (x : A ⟶ B) (p : B ⟶ C) (f : C ⟶ E) (g : E ⟶ F) (s : F ⟶ G)
    (t : G ⟶ H) (r : H ⟶ J) (q : G ⟶ K) (k : K ⟶ J) (h : F ⟶ M) (s' : M ⟶ K) (z : A ⟶ M)
    (ht : t ≫ r = q ≫ k) (hs : s ≫ q = h ≫ s') (hz : x ≫ p ≫ f ≫ g ≫ h = z) :
    x ≫ (p ≫ f ≫ g ≫ s ≫ t) ≫ r = z ≫ s' ≫ k := by
  calc
    x ≫ (p ≫ f ≫ g ≫ s ≫ t) ≫ r = x ≫ p ≫ f ≫ g ≫ s ≫ (t ≫ r) := by simp only [Category.assoc]
    _ = x ≫ p ≫ f ≫ g ≫ s ≫ (q ≫ k) := congrArg (x ≫ p ≫ f ≫ g ≫ s ≫ ·) ht
    _ = x ≫ p ≫ f ≫ g ≫ (s ≫ q) ≫ k := by simp only [Category.assoc]
    _ = x ≫ p ≫ f ≫ g ≫ (h ≫ s') ≫ k := congrArg (fun q => x ≫ p ≫ f ≫ g ≫ q ≫ k) hs
    _ = (x ≫ p ≫ f ≫ g ≫ h) ≫ s' ≫ k := by simp only [Category.assoc]
    _ = z ≫ s' ≫ k := congrArg (· ≫ s' ≫ k) hz

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original root-first association source, its original
contraction and original inner profile map are the original normalized coefficient source. -/
theorem collapsedAssociationSourceB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    expandedSource E s Q ≫ (FiniteTensor.tensor (V := C)).map
      (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection (assocData s Q)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (ColoredOperadObj.AssocInsertion.groupingB
        E.toCollection (assocData s
        Q)) ≫
      (FiniteTensor.tensor (V := C)).map
        (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst
        (assocData s Q)) ≫
        (ColoredOperadObj.substitutionSource E.toCollection).map (innerCompare s Q) =
          normalizedCoefficientSource E s Q
          := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData s Q
  let x := expandedSource E s Q
  let p := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection d)
  let f := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst d)
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map (innerCompare s Q)
  let a := T.map (rawSourceIsoB E.toCollection s Q).hom
  let n := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsB E.toCollection s Q)
  let l := T.map (appliedMapB E s Q)
  let m := T.map ((FiniteFamily.map T).map (groupingIsoB E.toCollection s Q).hom)
  let r := T.map (collapsedFactorsB E s Q)
  have hl : l ≫ m ≫ g ≫ h = r := (mapFourBranchRouteB T _ _ _ _).symm.trans (congrArg
    T.map (appliedMapB_collapse E s
    Q))
  exact (sourceBranchBFiring x p f g h a n l m r (expandedSource_groupedB E s Q) hl).trans
    (collapsedSourceB_normalized E s Q)

/-- The literal root-first E-association route is the literal original
representative coefficient substitution followed by original total nullary contraction. -/
theorem associationRouteB_isOutside (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    expandedSource E s Q ≫ ColoredOperadObj.associativityRouteB E.toCollection E.subst
      (assocData s Q) ≫
      E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s Q)
        ≫ generalTotalHom s (Q none))
        = outsideRoute E s Q := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData s Q
  let x := expandedSource E s Q
  let p := T.map (ColoredOperadObj.AssocInsertion.flattenAToFlattenBHom E.toCollection d)
  let f := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingB E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingBToFactorsHom E.toCollection E.subst d)
  let σ := E.subst.app d.innerData
  let t := E.toCollection.map d.totalHom
  let r := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s
    Q) ≫ generalTotalHom s (Q
    none))
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap (innerCompare s Q))
  let k := E.toCollection.map (Constants.substitutionTotalHom s.totalProfile
    (envelopingTotalAlgebraInputs s Q))
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map (innerCompare s Q)
  let σ' := E.subst.app (frozenSubstitution s.totalProfile (envelopingTotalAlgebraInputs s
    Q) (Constants.branches
    (envelopingTotalAlgebraInputs s Q)))
  let z := normalizedCoefficientSource E s Q
  have ht : t ≫ r = q ≫ k := (E.toCollection.map_comp _ _).symm.trans
    ((congrArg E.toCollection.map (totalProfile_readback s Q)).trans (E.toCollection.map_comp _ _))
  have hs : σ ≫ q = h ≫ σ' := (E.subst.naturality (innerCompare s Q)).symm
  exact branchBRouteFiring x p f g σ t r q k h σ' z ht hs (collapsedAssociationSourceB E s Q)

/-- Original E-associativity proves the full coefficient branching
constant-contraction law with every original heterogeneous/nullary profile. -/
theorem insideRoute_eq_outside (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q
  : EnvelopingInputChoices s)
  :
    insideRoute E s Q = outsideRoute E s Q :=
  (associationRouteA_isInside E s Q).symm.trans
    ((congrArg (fun a => expandedSource E s Q ≫ a ≫
      E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s Q)
        ≫ generalTotalHom s (Q none)))
      (E.assoc (assocData s Q))).trans (associationRouteB_isOutside E s Q))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

end
