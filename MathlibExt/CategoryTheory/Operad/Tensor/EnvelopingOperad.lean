section EnvelopingSource328


/-!
# Exact original atomic-source normalization of the constant-input relation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension.AtomicNormalization

open CategoryTheory

private theorem mapThreeAtomic {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem atomicSourceFiring {D : Type*} [Category* D] {A B C E F G H J K : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (i : E ⟶ F) (leaf : F ⟶ G) (j : G ⟶ H)
    (p : A ⟶ J) (q : J ⟶ E) (k : F ⟶ H) (u : J ⟶ K) (v : K ⟶ H) (n : A ⟶ H)
    (hs : a ≫ b ≫ c = p ≫ q) (hl : leaf ≫ j = k) (hr : q ≫ i ≫ k = u ≫ v) (hn : p ≫ u ≫ v = n) :
    a ≫ b ≫ (c ≫ i ≫ leaf) ≫ j = n := by
  calc
    a ≫ b ≫ (c ≫ i ≫ leaf) ≫ j = (a ≫ b ≫ c) ≫ i ≫ (leaf ≫ j) := by simp only [Category.assoc]
    _ = (p ≫ q) ≫ i ≫ k := congrArg₂ (fun x y => x ≫ i ≫ y) hs hl
    _ = p ≫ (q ≫ i ≫ k) := by simp only [Category.assoc]
    _ = p ≫ (u ≫ v) := congrArg (p ≫ ·) hr
    _ = n := hn

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The complete original atomic source embedding and actual original
coefficient/leaf correction are exactly the unchanged original frozen branch normalizer.
Only actual finite tensor laws are required, for an arbitrary original collection. -/
theorem atomicSource_normalized (O : ColoredSymmetricCollection W C) (B : W →
  C) (P : ColoredProfile W) (Q :
  ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (frozenVariableFlattenIso P.inputs
      (frozenWeightedBranchFamily O B P Q R)).inv ≫
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C :=
        C)).map (groupedWeightedSourceIso O B P Q R).hom)
        ≫
      Grouping.flatAtomicNormalization (coefficientGrouping O P Q R) (atomicLeaves O B P Q R) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (frozenVariableFlattenIso P.inputs
          (frozenCoefficientFamily O P Q R)).hom)
        (groupedLeavesIso O B P Q R).hom) = (frozenBranchTensorNormalizationIso O B P Q R).hom := by
  let T := FiniteTensor.tensor (V := C)
  let N := coefficientGrouping O P Q R
  let L := atomicLeaves O B P Q R
  let K := frozenCoefficientFamily O P Q R
  let K' := (FiniteFamily.flatten (C := C)).obj N
  let e := coefficientEmbedding O P Q R
  let a := T.map (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily O B P Q R)).inv
  let b := T.map ((FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso O B P Q R).hom)
  let c := T.map (Grouping.atomicWeightedIso N L).hom
  let i := (coefficientBlockInterchangeTensorIso K'.index K'.obj L).hom
  let l := (Grouping.atomicLeafIso N L).hom
  let m := (groupedLeavesIso O B P Q R).hom
  let leaf := T.map (coefficientLeafMap (𝟙 (T.obj K')) l)
  let j := T.map (coefficientLeafMap (T.map e.inv) m)
  let p := T.map (oldWeightedFrameIso O B P Q R).hom
  let q := T.map (weightedInputBlockRelabelMap e.hom.equiv e.hom.hom (leafIdentity O B P Q R))
  let k := T.map (coefficientLeafMap (T.map e.inv) (l ≫ m))
  let u := (coefficientBlockInterchangeTensorIso K.index K.obj (oldLeafBlocks B Q R)).hom
  let v := T.map (coefficientLeafMap (𝟙 (T.obj K)) (oldLeavesIso B Q R).hom)
  let n := (frozenBranchTensorNormalizationIso O B P Q R).hom
  have hs : a ≫ b ≫ c = p ≫ q := (mapThreeAtomic T _ _ _).symm.trans
    ((congrArg T.map (weightedSource_relabel O B P Q R)).trans (T.map_comp _ _))
  have hFam : coefficientLeafMap (𝟙 (T.obj K')) l ≫ coefficientLeafMap (T.map e.inv) m =
      coefficientLeafMap (T.map e.inv) (l ≫ m) := (coefficientLeafMap_comp _ _ _ _).trans
        (congrArg (fun f => coefficientLeafMap f (l ≫ m)) (Category.id_comp (T.map e.inv)))
  have hl : leaf ≫ j = k := (T.map_comp _ _).symm.trans (congrArg T.map hFam)
  have hr : q ≫ i ≫ k = u ≫ v :=
    (WeightedNormalization.interchangeAfterCoefficientIso e (oldLeafBlocks B Q R) L
      (leafIdentity O B P Q R) (l ≫
      m)).trans
      (congrArg (fun f => u ≫ T.map (coefficientLeafMap (𝟙 (T.obj K)) f))
        (leafRelabel_square O B P Q R))
  exact atomicSourceFiring a b c i leaf j p q k u v n hs hl hr (originalNormalizer_frame O B P Q R)

/-- The direct original grouped leaf correction is exactly the entire
original target leaf map used by the representative substitution comparison. -/
theorem groupedLeavesIso_total (O : ColoredOperadObj W C) (B : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) (R :
  FrozenBranchTuple Q) :
    (groupedLeavesIso O.toCollection B P Q R).hom = groupedTotalLeafMap O B P Q R := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, ⟨j, k⟩⟩
    cases i with | inl i => cases j | inr i => cases i with | none => cases k | some i => rfl
  · intro p
    rcases p with ⟨i, ⟨j, k⟩⟩
    cases i with
    | inl i => cases j
    | inr i =>
      cases i with
      | none => cases k
      | some i =>
        let X := B ((R i).inputColor k)
        change HEq (𝟙 X) (𝟙 X ≫ 𝟙 X)
        exact heq_of_eq (Category.id_comp (𝟙 X)).symm

/-- The exact parent grouped atomic normalizer uses the exact original
full groupedTotalLeafMap and original coefficient flattening; its composite
is the literal unchanged original frozenBranchTensorNormalizationIso.hom. -/
theorem atomicSource_normalized_actualLeaves (O : ColoredOperadObj W C) (B : W →
  C) (P : ColoredProfile W) (Q :
  ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (frozenVariableFlattenIso P.inputs
      (frozenWeightedBranchFamily O.toCollection B P
      Q R)).inv ≫
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.flatten (C :=
        C)).map (groupedWeightedSourceIso O.toCollection B
        P Q R).hom) ≫
      Grouping.flatAtomicNormalization (coefficientGrouping O.toCollection P Q R)
        (atomicLeaves O.toCollection B P Q R)
        ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (frozenVariableFlattenIso P.inputs
          (frozenCoefficientFamily O.toCollection P
          Q R)).hom)
        (groupedTotalLeafMap O B P Q R)) = (frozenBranchTensorNormalizationIso
          O.toCollection B P Q R).hom := by
  let T := FiniteTensor.tensor (V := C)
  let a := T.map (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily
    O.toCollection B P Q R)).inv
  let b := T.map ((FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso
    O.toCollection B P Q R).hom)
  let n := Grouping.flatAtomicNormalization (coefficientGrouping O.toCollection P Q R)
    (atomicLeaves O.toCollection B P
    Q R)
  let c := T.map (frozenVariableFlattenIso P.inputs (frozenCoefficientFamily O.toCollection
    P Q R)).hom
  exact (congrArg (fun f => a ≫ b ≫ n ≫ T.map (coefficientLeafMap c f))
    (groupedLeavesIso_total O B P Q R).symm).trans
    (atomicSource_normalized O.toCollection B P Q R)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension.AtomicNormalization

