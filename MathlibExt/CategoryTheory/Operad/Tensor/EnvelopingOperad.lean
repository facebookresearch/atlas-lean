/- Exact checked source: LinearAlgebra.Representative. -/
section EnvelopingSource213


/-!
# Actual linear-coefficient operations evaluated in an original tensor algebra
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The exact original coefficient, constant-input and variable-input
positions, reordered to the original O-operation profile P⊔Q. -/
def representativeInputEquiv (O : ColoredSymmetricCollection W C) (B M : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteFamily.flatten (C := C)).obj
      (coefficientLeavesNested
        ((coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).obj Q)
        (profileLeafFamily M P))).index ≃
      ((analyticFactors O M).obj (profileInputs (extendProfile P Q))).index where
  toFun p := match p with
    | ⟨none, none⟩ => none
    | ⟨none, some j⟩ => some (Sum.inr j)
    | ⟨some i, _⟩ => some (Sum.inl i)
  invFun p := match p with
    | none => ⟨none, none⟩
    | some (Sum.inl i) => ⟨some i, PUnit.unit⟩
    | some (Sum.inr j) => ⟨none, some j⟩
  left_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some i => cases j; rfl
  right_inv p := by
    cases p with
    | none => rfl
    | some p => cases p <;> rfl

/-- The original constant inputs use the actual colorwise map g;
every variable input and the original O coefficient retain their
original object and original profile position. -/
def representativeFactors (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested
          ((coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).obj Q)
          (profileLeafFamily M P)) ⟶
      (analyticFactors O M).obj (profileInputs (extendProfile P Q)) where
  equiv := representativeInputEquiv O B M P Q
  hom p := match p with
    | ⟨none, none⟩ => 𝟙 (O.obj (extendProfile P Q))
    | ⟨none, some j⟩ => g (Q.obj j).as
    | ⟨some i, _⟩ => 𝟙 (M (P.inputColor i))

/-- Evaluate the actual original weighted O coefficient with
the constant inputs mapped by g and the untouched variable inputs,
using the original tensor-algebra operation of M. -/
def representativeEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).obj
        ((linearCoefficientDiagram O.toCollection B P).obj Q) ⟶ M.carrier P.outputColor :=
  (coefficientLeavesNormalizationIso
    ((coefficientInputFactors (extendedCoefficient O.toCollection P) (addedAlgebraInputs B)).obj Q)
    (profileLeafFamily M.carrier P)).inv ≫
    (FiniteTensor.tensor (V := C)).map (representativeFactors O.toCollection B M.carrier g P Q) ≫
    M.operations.app P.outputColor (profileInputs (extendProfile P Q))

/-- The original complete tensor normalizer followed by this
evaluation is exactly the original coefficient/input map and the
original O-algebra operation, with every input map retained. -/
theorem representativeEvaluation_normalized (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientLeavesNormalizationIso
      ((coefficientInputFactors (extendedCoefficient O.toCollection P) (addedAlgebraInputs
        B)).obj Q)
      (profileLeafFamily M.carrier P)).hom ≫ representativeEvaluation O B M g P Q =
      (FiniteTensor.tensor (V := C)).map (representativeFactors O.toCollection B M.carrier g P Q) ≫
        M.operations.app P.outputColor (profileInputs (extendProfile P Q)) := by
  exact (coefficientLeavesNormalizationIso
    ((coefficientInputFactors (extendedCoefficient O.toCollection P) (addedAlgebraInputs B)).obj Q)
    (profileLeafFamily M.carrier P)).hom_inv_id_assoc _


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra


end
end EnvelopingSource213

/- Exact checked source: ReflexiveOperad.FrozenAlgebraData. -/
section EnvelopingSource214


/-!
# Original coefficient, variable, nullary and unit positions for frozen algebra substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original frozen substitution has the original unary
variable profiles and original nullary profiles at all Q positions. -/
abbrev datum (P : ColoredProfile W) (Q : ColoredInputs W) : ColoredSubstitutionData W :=
  frozenSubstitution P Q (Linear.Constants.branches Q)

/-- The actual original coefficient family at the frozen nullary branches. -/
abbrev coefficients (E : ColoredSymmetricCollection W C) (P : ColoredProfile W) (Q :
  ColoredInputs W) : FiniteFamily C
  :=
  frozenCoefficientFamily E P Q (Linear.Constants.branches Q)

/-- The original coefficient and all original surviving variables before tensor normalization. -/
abbrev raw (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) : FiniteFamily
  C :=
  (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested (coefficients E P Q)
    (profileLeafFamily A P))

/-- The actual original root, variable and nullary coefficient values in their original
outer slots. -/
def values (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) : FiniteFamily
  C where
  index := FintypeCat.of (Option (P.inputs ⊕ Q.index))
  obj i := match i with
    | none => E.obj (extendProfile P Q)
    | some (Sum.inl i) => A (P.inputColor i)
    | some (Sum.inr j) => E.obj (ColoredProfile.nullary (Q.obj j).as)

/-- Each original retained block is its original coefficient or variable singleton. -/
abbrev groups (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    FiniteFamily (FiniteFamily C) :=
  (FiniteFamily.map (FiniteFamily.singleton (C := C))).obj (values E A P Q)

/-- The actual original coefficient/leaf bijection places each original
coefficient and variable at its original outer input position. -/
def rawValuesEquiv (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (raw E A P Q).index ≃ (values E A P Q).index where
  toFun p := match p with
    | ⟨none, none⟩ => none
    | ⟨none, some j⟩ => some (Sum.inr j)
    | ⟨some i, _⟩ => some (Sum.inl i)
  invFun p := match p with
    | none => ⟨none, none⟩
    | some (Sum.inl i) => ⟨some i, PUnit.unit⟩
    | some (Sum.inr j) => ⟨none, some j⟩
  left_inv p := by rcases p with ⟨i, j⟩; cases i with
    | none => cases j <;> rfl
    | some _ => cases j; rfl
  right_inv p := by cases p with
    | none => rfl
    | some p => cases p <;> rfl

/-- The original coefficient/leaf position bijection retains each original object. -/
def rawValuesIso (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    raw E A P Q ≅ values E A P Q :=
  FiniteFamily.isoOfComponents
    (rawValuesEquiv E A P Q)
    (fun p => match p with
      | ⟨none, none⟩ => Iso.refl _
      | ⟨none, some _⟩ => Iso.refl _
      | ⟨some _, _⟩ => Iso.refl _)

/-- The original raw factors regroup into their actual original singleton blocks. -/
def rawGroupsIso (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    raw E A P Q ≅ (FiniteFamily.flatten (C := C)).obj (groups E A P Q) :=
  rawValuesIso E A P Q ≪≫ (FiniteFamily.mapSingletonFlattenIso.app (values E A P Q)).symm

/-- The original unit slots occur at every surviving P variable and nowhere else. -/
def localUnitIndices (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (groups E A P Q).index → FintypeCat.{0}
  | none => FintypeCat.of (Fin 0)
  | some (Sum.inl _) => FintypeCat.of PUnit
  | some (Sum.inr _) => FintypeCat.of (Fin 0)

/-- The actual original P unit positions are precisely the original dependent block-unit slots. -/
def localUnitsEquiv (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    P.inputs ≃ blockUnitIndex (groups E A P Q) (localUnitIndices E A P Q) where
  toFun i := ⟨some (Sum.inl i), PUnit.unit⟩
  invFun p := match p with
    | ⟨none, j⟩ => Fin.elim0 j
    | ⟨some (Sum.inl i), _⟩ => i
    | ⟨some (Sum.inr _), j⟩ => Fin.elim0 j
  left_inv _ := rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => exact Fin.elim0 j
    | some i => cases i with
        | inl i => cases j; rfl
        | inr _ => exact Fin.elim0 j

/-- The actual original total-profile correction gives the original
leaf bijection and all original variable color transports. -/
def totalLeafIso (A : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    profileLeafFamily A (datum P Q).totalProfile ≅ profileLeafFamily A P :=
  profileLeafIso A (Linear.Constants.substitutionTotalHom P Q)

omit [FiniteTensor C] in
/-- The inverse total-leaf map puts each original variable in its original unary fiber. -/
theorem totalLeafIso_inv_equiv (A : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) (i
  : P.inputs) :
    (totalLeafIso A P Q).inv.equiv i = ⟨Sum.inl i, PUnit.unit⟩ := rfl

omit [FiniteTensor C] in
/-- The original variable component of the inverse total-leaf map is its original identity. -/
theorem totalLeafIso_inv_hom (A : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) (i :
  P.inputs) :
    (totalLeafIso A P Q).inv.hom i = 𝟙 (A (P.inputColor i)) := by
  change (𝟙 (A (P.inputColor i))) ≫ 𝟙 (A (P.inputColor i)) = 𝟙 (A (P.inputColor i))
  exact Category.id_comp _

/-- The actual complete source factor permutation inserts each original
P unit, retains the root and all Q coefficients, and retains every original P variable. -/
def inputFactorEquiv (E : ColoredSymmetricCollection W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    P.inputs ⊕ (raw E A P Q).index ≃
      ((FiniteFamily.flatten (C := C)).obj (nestedOperationFactors E A (datum P Q))).index where
  toFun i := match i with
    | Sum.inl i => ⟨some (Sum.inl i), none⟩
    | Sum.inr ⟨none, none⟩ => ⟨none, PUnit.unit⟩
    | Sum.inr ⟨none, some j⟩ => ⟨some (Sum.inr j), none⟩
    | Sum.inr ⟨some i, _⟩ => ⟨some (Sum.inl i), some PUnit.unit⟩
  invFun i := match i with
    | ⟨none, _⟩ => Sum.inr ⟨none, none⟩
    | ⟨some (Sum.inl i), none⟩ => Sum.inl i
    | ⟨some (Sum.inl i), some _⟩ => Sum.inr ⟨some i, PUnit.unit⟩
    | ⟨some (Sum.inr j), none⟩ => Sum.inr ⟨none, some j⟩
    | ⟨some (Sum.inr _), some i⟩ => Fin.elim0 i
  left_inv i := by
    cases i with
    | inl _ => rfl
    | inr i => rcases i with ⟨i, j⟩; cases i with
        | none => cases j <;> rfl
        | some _ => cases j; rfl
  right_inv i := by
    rcases i with ⟨i, j⟩
    cases i with
    | none => cases j; rfl
    | some i => cases i with
        | inl i => cases j with
          | none => rfl
          | some j => cases j; rfl
        | inr _ => cases j with
          | none => rfl
          | some j => exact Fin.elim0 j

/-- The literal original units, outer coefficient map, nullary coefficients
and retained variables into the original algebra substitution source. -/
def inputFactor (E : ColoredOperadObj W C) (A : W → C) (P : ColoredProfile W) (Q :
  ColoredInputs W) :
    frozenVariableUnitFamily P.inputs (raw E.toCollection A P Q) ⟶
      (FiniteFamily.flatten (C := C)).obj (nestedOperationFactors E.toCollection A (datum P
        Q)) where
  equiv := inputFactorEquiv E.toCollection A P Q
  hom i := match i with
    | Sum.inl i => E.unit (P.inputColor i)
    | Sum.inr ⟨none, none⟩ => E.toCollection.map (frozenOuterProfileHom P Q
      (Linear.Constants.branches Q))
    | Sum.inr ⟨none, some _⟩ => 𝟙 _
    | Sum.inr ⟨some _, _⟩ => 𝟙 _


end CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

end
end EnvelopingSource214

/- Exact checked source: ReflexiveOperad.FrozenAlgebraNormalization. -/
section EnvelopingSource215


/-!
# The original frozen algebra input in its original coefficient and variable-leaf frame
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.FrozenAlgebra

open CategoryTheory

private theorem normalizationFold {V : Type*} [Category* V]
    {X A B D H J Y Z : V} (p : X ⟶ A) (i : A ⟶ B) (t : B ⟶ D) (n : D ⟶ Y)
    (r : A ⟶ H) (m : H ⟶ D) (n' : H ⟶ J) (b : J ⟶ Y)
    (n0 : X ⟶ Z) (u : Z ⟶ J) (c : Z ⟶ Y)
    (hi : i ≫ t = r ≫ m) (hn : m ≫ n = n' ≫ b)
    (hp : p ≫ r ≫ n' = n0 ≫ u) (hc : u ≫ b = c) :
    p ≫ i ≫ t ≫ n = n0 ≫ c := by
  have h1 : p ≫ i ≫ t ≫ n = p ≫ r ≫ m ≫ n := by
    simpa only [Category.assoc] using congrArg (fun z => p ≫ z ≫ n) hi
  have h2 : p ≫ r ≫ m ≫ n = p ≫ r ≫ n' ≫ b := congrArg (p ≫ r ≫ ·) hn
  have h3 : p ≫ r ≫ n' ≫ b = n0 ≫ u ≫ b := by
    simpa only [Category.assoc] using congrArg (· ≫ b) hp
  exact h1.trans (h2.trans (h3.trans (congrArg (n0 ≫ ·) hc)))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original unit, coefficient, nullary and variable factor maps
commute through the original substitution coefficient/leaf bijection. -/
theorem inputFactor_coefficients (E : ColoredOperadObj W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    inputFactor E A P Q ≫ (substitutionToLeavesIso E.toCollection A (datum P Q)).hom =
      LinearAlgebra.coefficientPrefixRawMap P.inputs (coefficients E.toCollection P Q)
        (profileLeafFamily A P) ≫
        (FiniteFamily.flatten (C := C)).map
          (coefficientLeavesNestedMap (frozenUnitCoefficientMap E P Q (Linear.Constants.branches Q))
            (totalLeafIso A P Q).inv) := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i with
    | inl _ => rfl
    | inr i => rcases i with ⟨i, j⟩; cases i with
        | none => cases j <;> rfl
        | some _ => rfl
  · intro i
    cases i with
    | inl i =>
        let X := (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C)
        let Y := E.toCollection.obj (ColoredProfile.unary (P.inputColor i) (P.inputColor i))
        let f : X ⟶ Y := E.unit (P.inputColor i)
        change HEq (f ≫ 𝟙 Y ≫ (𝟙 Y ≫ 𝟙 Y)) (𝟙 X ≫ f)
        exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
    | inr i =>
        rcases i with ⟨i, j⟩
        cases i with
        | none => cases j with
          | none =>
              let X := E.toCollection.obj (extendProfile P Q)
              let Y := E.toCollection.obj (datum P Q).outerProfile
              let f : X ⟶ Y := E.toCollection.map (frozenOuterProfileHom P Q
                (Linear.Constants.branches Q))
              change HEq (f ≫ 𝟙 Y ≫ (𝟙 Y ≫ 𝟙 Y)) (𝟙 X ≫ f)
              exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
          | some j =>
              let X := E.toCollection.obj (ColoredProfile.nullary (Q.obj j).as)
              change HEq (𝟙 X ≫ 𝟙 X ≫ (𝟙 X ≫ 𝟙 X)) (𝟙 X ≫ 𝟙 X)
              exact heq_of_eq (by simp only [Category.id_comp])
        | some i =>
            let X := A (P.inputColor i)
            change HEq (𝟙 X ≫ 𝟙 X ≫ (𝟙 X ≫ 𝟙 X)) (𝟙 X ≫ (𝟙 X ≫ 𝟙 X))
            exact heq_of_eq (by simp only [Category.id_comp])

/-- The actual frozen variable units and the complete original source tensor
normalize to the original frozen coefficient tensor map with all original variable leaves. -/
theorem inputNormalization (E : ColoredOperadObj W C) (A : W →
  C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (frozenVariableTensorUnitIso P.inputs (raw E.toCollection A P Q)).hom ≫
      (FiniteTensor.tensor (V := C)).map (inputFactor E A P Q) ≫
        (FiniteTensor.tensor (V := C)).map (substitutionToLeavesIso E.toCollection A (datum
          P Q)).hom ≫
          coefficientLeavesNormalization ((ColoredOperadObj.substitutionFactors
            E.toCollection).obj (datum P Q))
            (profileLeafFamily A (datum P Q).totalProfile) =
    coefficientLeavesNormalization (coefficients E.toCollection P Q) (profileLeafFamily A P) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (frozenSubstitutionCoefficientTensorMap E P Q
          (Linear.Constants.branches Q))
          (totalLeafIso A P Q).inv) := by
  let T := FiniteTensor.tensor (V := C)
  let K := coefficients E.toCollection P Q
  let L := profileLeafFamily A P
  let k := frozenUnitCoefficientMap E P Q (Linear.Constants.branches Q)
  let ell := (totalLeafIso A P Q).inv
  let p := (frozenVariableTensorUnitIso P.inputs (raw E.toCollection A P Q)).hom
  let i := T.map (inputFactor E A P Q)
  let t := T.map (substitutionToLeavesIso E.toCollection A (datum P Q)).hom
  let n := coefficientLeavesNormalization ((ColoredOperadObj.substitutionFactors
    E.toCollection).obj (datum P Q))
    (profileLeafFamily A (datum P Q).totalProfile)
  let r := T.map (LinearAlgebra.coefficientPrefixRawMap P.inputs K L)
  let m := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap k ell))
  let n' := coefficientLeavesNormalization (frozenVariableUnitFamily P.inputs K) L
  let b := T.map (coefficientLeafMap (T.map k) ell)
  let n0 := coefficientLeavesNormalization K L
  let u := (coefficientLeafTensorFunctor L).map (frozenVariableTensorUnitIso P.inputs K).hom
  let c := T.map (coefficientLeafMap (frozenSubstitutionCoefficientTensorMap E P Q
    (Linear.Constants.branches Q)) ell)
  have hi : i ≫ t = r ≫ m := (T.map_comp _ _).symm.trans
    ((congrArg T.map (inputFactor_coefficients E A P Q)).trans (T.map_comp _ _))
