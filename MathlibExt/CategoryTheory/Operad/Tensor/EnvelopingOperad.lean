/-!
# Original grouped coefficient flattening is the original frozen partial substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem groupedCoefficientPreFiring {D : Type*} [Category* D]
    {X A B C E F G Y : D} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ C) (d : C ⟶ E)
    (e : E ⟶ F) (f : F ⟶ Y) (g : B ⟶ G) (h : G ⟶ E) (hcd : c ≫ d = g ≫ h) :
    a ≫ (b ≫ c ≫ (d ≫ e ≫ f)) = (a ≫ b ≫ g) ≫ h ≫ e ≫ f := by
  simp only [Category.assoc]
  rw [← Category.assoc c d, hcd]
  simp only [Category.assoc]

private theorem groupedInverseNormalize {D : Type*} [Category* D]
    {X Y Z : D} (e : X ≅ Y) (f : X ⟶ Z) (g : Y ⟶ Z) (h : e.inv ≫ f = g) :
    f = e.hom ≫ g := by
  apply (cancel_epi e.inv).1
  exact h.trans (e.inv_hom_id_assoc g).symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original grouped coefficient map and actual slot relabelling
retain exactly the original empty/singleton unit block map followed
by the original variable/root/branch coefficient insertion. -/
theorem groupedCoefficientFactor_relabel (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    coefficientBlockMap (coefficientGrouping O.toCollection P Q R).index
      (groupedCoefficientFactor O P Q R) ≫
      (groupedTargetCoefficientIso O P Q R).hom =
    (frozenVariableBlockIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom ≫
      coefficientInsertion O P Q R := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | inl i =>
      exact heq_of_eq ((Category.comp_id _).trans (groupedCoefficientFactor_split O P Q R
      (Sum.inl i)))
    | inr i => cases i with
      | none =>
        exact heq_of_eq ((Category.comp_id _).trans (groupedCoefficientFactor_split O P Q R
        (Sum.inr none)))
      | some j =>
        exact heq_of_eq ((Category.comp_id _).trans (groupedCoefficientFactor_split O P Q R
        (Sum.inr (some
        j))))

/-- The actual original coefficient grouping followed by its full
representative substitution is the literal original frozen partial
substitution after the exact original coefficient flattening map. -/
theorem groupedCoefficient_normalization (O : ColoredOperadObj W C) (P : ColoredProfile W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.flattenIso (V := C)).hom.app (coefficientGrouping O.toCollection P Q R) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientBlockMap (coefficientGrouping O.toCollection P Q R).index
          (groupedCoefficientFactor O P Q R)) ≫
      ((FiniteTensor.tensor (V := C)).map (groupedTargetCoefficientIso O P Q R).hom ≫
        envelopingRepresentativeCoefficientSubstitution O (shape P Q) (choices P Q R) ≫
        O.toCollection.map (totalProfileHom P Q R)) =
    (FiniteTensor.tensor (V := C)).map
      (frozenVariableFlattenIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom ≫
      frozenPartialSubstitution O P Q R := by
  let T := FiniteTensor.tensor (V := C)
  let K := frozenCoefficientFamily O.toCollection P Q R
  let N := coefficientGrouping O.toCollection P Q R
  let a := T.map (frozenVariableFlattenIso P.inputs K).inv
  let b := (FiniteTensor.flattenIso (V := C)).hom.app N
  let c := T.map (coefficientBlockMap N.index (groupedCoefficientFactor O P Q R))
  let d := T.map (groupedTargetCoefficientIso O P Q R).hom
  let e := envelopingRepresentativeCoefficientSubstitution O (shape P Q) (choices P Q R)
  let f := O.toCollection.map (totalProfileHom P Q R)
  let g := T.map (frozenVariableBlockIso P.inputs K).hom
  let h := T.map (coefficientInsertion O P Q R)
  let s := b ≫ c ≫ (d ≫ e ≫ f)
  have hcd : c ≫ d = g ≫ h := (T.map_comp _ _).symm.trans
    ((congrArg T.map (groupedCoefficientFactor_relabel O P Q R)).trans (T.map_comp _ _))
  have hp : (frozenVariableTensorUnitIso P.inputs K).hom = a ≫ b ≫ g := rfl
  have hs : a ≫ s = frozenPartialSubstitution O P Q R :=
    (groupedCoefficientPreFiring a b c d e f g h hcd).trans
      ((congrArg (fun p => p ≫ h ≫ e ≫ f) hp.symm).trans
        (insertedCoefficient_partialSubstitution O P Q R))
  exact groupedInverseNormalize (T.mapIso (frozenVariableFlattenIso P.inputs K)) s
    (frozenPartialSubstitution O P Q R) hs


