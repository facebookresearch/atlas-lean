section EnvelopingSource264


/-!
# Exact original empty-variable and constant blocks in the root-first branch source
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The nullary coefficient leaves indexed by the total added algebra-input family. -/
def totalLeaves (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    FiniteFamily C := (addedAlgebraInputs (nullaryCarrier E)).obj (envelopingTotalAlgebraInputs s Q)

/-- Group the representative coefficients together with singleton blocks for every nullary leaf. -/
def retainedGroups (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    FiniteFamily (FiniteFamily C) := coefficientLeavesNested
      (envelopingRepresentativeCoefficients E s Q) (totalLeaves E
      s Q)

/-- The root has the original representative coefficient family. Every
surviving variable has its actual empty block, and every original constant has its actual
singleton. -/
def rawGroupsB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option (s.totalProfile.inputs ⊕ (envelopingTotalAlgebraInputs s Q).index))
  obj i := match i with
    | none => envelopingRepresentativeCoefficients E s Q
    | some (Sum.inl _) => FiniteFamily.empty
    | some (Sum.inr i) => (FiniteFamily.singleton (C := C)).obj (E.obj (ColoredProfile.nullary
      ((envelopingTotalAlgebraInputs s Q).obj i).as))

/-- Regroup the raw factors into representative root coefficients, empty variable blocks, and
nullary singletons. -/
def rawSourceIsoB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    rawFactors E s Q ≅ (FiniteFamily.flatten (C := C)).obj (rawGroupsB E s Q) :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with
        | ⟨none, _⟩ => ⟨none, none⟩
        | ⟨some (Sum.inl i), none⟩ => ⟨none, some i⟩
        | ⟨some (Sum.inl i), some j⟩ => ⟨some (Sum.inr (Sum.inr ⟨i, j⟩)), PUnit.unit⟩
        | ⟨some (Sum.inr j), _⟩ => ⟨some (Sum.inr (Sum.inl j)), PUnit.unit⟩
      invFun := fun p => match p with
        | ⟨none, none⟩ => ⟨none, PUnit.unit⟩
        | ⟨none, some i⟩ => ⟨some (Sum.inl i), none⟩
        | ⟨some (Sum.inl _), j⟩ => j.elim
        | ⟨some (Sum.inr (Sum.inl j)), _⟩ => ⟨some (Sum.inr j), PUnit.unit⟩
        | ⟨some (Sum.inr (Sum.inr ⟨i, j⟩)), _⟩ => ⟨some (Sum.inl i), some j⟩
      left_inv := fun p => by
        rcases p with ⟨i, j⟩
        cases i with
          | none => cases j; rfl
          | some i => cases i with
          | inl i => cases j <;> rfl
          | inr i => cases j; rfl
      right_inv := fun p => by
        rcases p with ⟨i, j⟩
        cases i with
        | none => cases j <;> rfl
        | some i =>
          cases i with
          | inl i => cases j
          | inr i => cases i <;> cases j <;> rfl }
    (fun p => by
      rcases p with ⟨i, j⟩
      cases i with
      | none => exact Iso.refl _
      | some i =>
        cases i with
        | inl i => cases j <;> exact Iso.refl _
        | inr i => exact Iso.refl _)

/-- Identify the second raw grouping with the retained coefficient and leaf groups plus empty
variable blocks. -/
def groupsToEmptyOuterIso (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    rawGroupsB E s Q ≅ DisjointNullary.EmptyOuter.blocks s.totalProfile.inputs
      (retainedGroups E s Q) :=
  FiniteFamily.isoOfComponents (frozenCoefficientPositionEquiv s.totalProfile
    (envelopingTotalAlgebraInputs s Q)).symm
    (fun i => match i with
      | none => Iso.refl _
      | some (Sum.inl _) => Iso.refl _
      | some (Sum.inr _) => Iso.refl _)

theorem rawSourceToEmptyOuter (E : ColoredSymmetricCollection W C) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (rawSourceIsoB E s Q).hom ≫ (FiniteFamily.flatten (C :=
      C)).map (groupsToEmptyOuterIso E s Q).hom =
      (rawInputIso E s Q).hom ≫ (DisjointNullary.EmptyOuter.eraseIso s.totalProfile.inputs
        (retainedGroups E s Q)).inv
        := by
  let e := DisjointNullary.EmptyOuter.eraseIso s.totalProfile.inputs (retainedGroups E s Q)
  apply (e.eq_comp_inv).2
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
      | none => cases j; rfl
      | some i => cases i with
      | inl i => cases j <;> rfl
      | inr i => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      cases j
      let X := E.obj (extendProfile s.outerProfile (Q none))
      change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some i =>
      cases i with
      | inl i =>
        cases j with
        | none =>
          let X := E.obj (extendProfile (s.inner.obj i) (Q (some i)))
          change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
        | some j =>
          let X := E.obj (ColoredProfile.nullary ((Q (some i)).obj j).as)
          change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
          exact heq_of_eq (by simp only [Category.id_comp])
      | inr i =>
        cases j
        let X := E.obj (ColoredProfile.nullary ((Q none).obj i).as)
        change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

/-- The second grouping after inserting variable unit coefficients beside the middle and nullary
factors. -/
def correctedGroupsB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q
  : EnvelopingInputChoices s)
  :
    FiniteFamily (FiniteFamily C) where
  index := FintypeCat.of (Option (s.totalProfile.inputs ⊕ (envelopingTotalAlgebraInputs s Q).index))
  obj i := match i with
    | none => (ColoredOperadObj.substitutionFactors E).obj (assocData s Q).middleData
    | some (Sum.inl i) => (FiniteFamily.singleton (C := C)).obj (E.obj
      (ColoredSubstitutionData.unitProfile
      (s.totalProfile.inputColor i)))
    | some (Sum.inr i) => (FiniteFamily.singleton (C := C)).obj (E.obj (ColoredProfile.nullary
      ((envelopingTotalAlgebraInputs s Q).obj i).as))

/-- Identify the corrected second grouping with the associativity grouping by the inner-profile
permutation. -/
def groupingIsoB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    correctedGroupsB E s Q ≅ ColoredOperadObj.AssocInsertion.groupingB E (assocData s Q) :=
  FiniteFamily.isoOfComponents (Equiv.optionCongr (innerCompare s Q).innerHom.equiv.symm)
    (fun p => by
    cases p with
    | none => exact Iso.refl _
    | some p => cases p with
      | inl p => rcases p with ⟨i, j⟩; exact Iso.refl _
      | inr p => cases p with
        | inl p => exact Iso.refl _
        | inr p => rcases p with ⟨i, j⟩; exact Iso.refl _)

variable [FiniteTensor C]

/-- Place root-input units at the root, one unit at each variable leaf, and no units at nullary
leaves. -/
def unitPositionsB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (rawGroupsB E s Q).index → FintypeCat.{0}
  | none => (Q none).index
  | some (Sum.inl _) => FintypeCat.of PUnit
  | some (Sum.inr _) => FintypeCat.of (Fin 0)

/-- Identify the combined unit index with the unit positions in the second raw grouping. -/
def unitPositionEquivB (E : ColoredSymmetricCollection W C) (s : ColoredSubstitutionData W)
  (Q : EnvelopingInputChoices
  s) :
    unitIndex s Q ≃ blockUnitIndex (rawGroupsB E s Q) (unitPositionsB E s Q) where
  toFun p := match p with | Sum.inl j => ⟨none, j⟩ | Sum.inr i => ⟨some (Sum.inl i), PUnit.unit⟩
  invFun p := match p with
    | ⟨none, j⟩ => Sum.inl j
    | ⟨some (Sum.inl i), _⟩ => Sum.inr i
    | ⟨some (Sum.inr _), j⟩ => Fin.elim0 j
  left_inv p := by cases p <;> rfl
  right_inv p := by
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i =>
      cases i with
      | inl i => cases j; rfl
      | inr i => exact Fin.elim0 j

/-- Insert root and variable-leaf units into the corrected second grouping while retaining
nullary coefficients. -/
def localUnitMapB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s)
    (i : (rawGroupsB E.toCollection s Q).index) :
    frozenVariableUnitFamily (unitPositionsB E.toCollection s Q i) ((rawGroupsB
      E.toCollection s Q).obj i) ⟶
      (correctedGroupsB E.toCollection s Q).obj i :=
  match i with
  | none => envelopingRepresentativeUnitMap E s Q ≫ (ColoredOperadObj.substitutionFactors
    E.toCollection).map
    (middleCompare s Q)
  | some (Sum.inl i) => DisjointNullary.UnitSource.oneSingletonMap ≫
      (FiniteFamily.singleton (C := C)).map (E.unit (s.totalProfile.inputColor i))
  | some (Sum.inr i) => (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
      ((FiniteFamily.singleton (C := C)).obj (E.toCollection.obj (ColoredProfile.nullary
        ((envelopingTotalAlgebraInputs
        s Q).obj i).as)))).hom

/-- Assemble unit insertions in the second raw grouping into the flattened corrected grouping. -/
def globalUnitMapB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    frozenVariableUnitFamily (unitIndex s Q) ((FiniteFamily.flatten (C :=
      C)).obj (rawGroupsB E.toCollection s Q)) ⟶
      (FiniteFamily.flatten (C := C)).obj (correctedGroupsB E.toCollection s Q) :=
  Variable.unitFamilyMap (unitPositionEquivB E.toCollection s Q)
    (𝟙 ((FiniteFamily.flatten (C := C)).obj (rawGroupsB E.toCollection s Q))) ≫
      blockUnitGlobalMap (rawGroupsB E.toCollection s Q) (unitPositionsB E.toCollection s Q)
        (correctedGroupsB E.toCollection s Q).obj (localUnitMapB E s Q)

/-- Apply the second-grouping unit insertions to the tensors of its raw blocks. -/
def appliedMapB (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
