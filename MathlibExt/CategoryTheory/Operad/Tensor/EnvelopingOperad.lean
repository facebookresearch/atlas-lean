/-!
# Original nullary constant-input coefficient substitution
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Nullary

open CategoryTheory

private theorem originalPartialCoefficientFiring {V : Type*} [Category* V]
    {X A B D Z Y : V} (a : X ⟶ A) (b : A ⟶ B) (c : B ⟶ D) (d : D ⟶ Y)
    (q : B ⟶ Y) (h : A ⟶ Z) (k : Z ⟶ Y) (r : X ⟶ Z)
    (hfaces : c ≫ d = q) (hsub : h ≫ k = b ≫ q) (hsource : a ≫ h = r) :
    (a ≫ b ≫ c) ≫ d = r ≫ k := by
  calc
    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ (c ≫ d) := by simp only [Category.assoc]
    _ = a ≫ b ≫ q := congrArg (fun f => a ≫ b ≫ f) hfaces
    _ = a ≫ h ≫ k := congrArg (a ≫ ·) hsub.symm
    _ = (a ≫ h) ≫ k := (Category.assoc _ _ _).symm
    _ = r ≫ k := congrArg (· ≫ k) hsource

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

local instance coefficientNullaryInputsEmpty (d : W) : IsEmpty (ColoredProfile.nullary d).inputs :=
  inferInstanceAs (IsEmpty (Fin 0))

/-- The actual empty-variable coefficient tensor insertion is
exactly the original coefficient map into the ordinary simultaneous
substitution, after deleting the original empty variable positions. -/
theorem coefficientTensorMap (O : ColoredOperadObj W C) (d : W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenSubstitutionCoefficientTensorMap O (ColoredProfile.nullary d) Q R ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (shapeHom d Q R) =
      (FiniteTensor.tensor (V := C)).map (coefficientHom O.toCollection d Q R) := by
  let T := FiniteTensor.tensor (V := C)
  let K := frozenCoefficientFamily O.toCollection (ColoredProfile.nullary d) Q R
  let a := (frozenVariableTensorUnitIso (ColoredProfile.nullary d).inputs K).hom
  let b := frozenUnitCoefficientMap O (ColoredProfile.nullary d) Q R
  let c := (ColoredOperadObj.substitutionFactors O.toCollection).map (shapeHom d Q R)
  let e := (ZeroVariable.emptyUnitIso (ColoredProfile.nullary d).inputs K).hom
  let g := coefficientHom O.toCollection d Q R
  have hmap : T.map b ≫ T.map c = T.map e ≫ T.map g :=
    (T.map_comp b c).symm.trans
      ((congrArg T.map (coefficientHom_inserted O d Q R)).trans (T.map_comp e g))
  have hu : a ≫ T.map e = 𝟙 (T.obj K) :=
    ZeroVariable.emptyPrefix_unit (ColoredProfile.nullary d).inputs K
  change (a ≫ T.map b) ≫ T.map c = T.map g
  rw [Category.assoc, hmap, ← Category.assoc, hu, Category.id_comp]

/-- The actual original partial substitution with no variable
inputs is the original simultaneous O-substitution under the exact
outer and total empty-profile comparisons. All original inner
profiles, including nullary ones, retain their original coefficients. -/
theorem partialSubstitution (O : ColoredOperadObj W C) (d : W)
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenPartialSubstitution O (ColoredProfile.nullary d) Q R ≫
        O.toCollection.map (nullaryVariableProfileHom d (frozenTotalInputs Q R)) =
      (FiniteTensor.tensor (V := C)).map (coefficientHom O.toCollection d Q R) ≫
        O.subst.app (tupleSubstitutionShape ((inputsToProfile d).obj Q) R) := by
  have hfaces :
      O.toCollection.map (frozenTotalProfileHom (ColoredProfile.nullary d) Q R) ≫
          O.toCollection.map (nullaryVariableProfileHom d (frozenTotalInputs Q R)) =
        O.toCollection.map (ColoredSubstitutionData.totalProfileMap (shapeHom d Q R)) :=
    (O.toCollection.map_comp _ _).symm.trans
      (congrArg O.toCollection.map (shapeHom_total d Q R))
  have hs :
      (ColoredOperadObj.substitutionSource O.toCollection).map (shapeHom d Q R) ≫
          O.subst.app (tupleSubstitutionShape ((inputsToProfile d).obj Q) R) =
        O.subst.app (frozenSubstitution (ColoredProfile.nullary d) Q R) ≫
          O.toCollection.map (ColoredSubstitutionData.totalProfileMap (shapeHom d Q R)) :=
    O.subst.naturality (shapeHom d Q R)
  exact originalPartialCoefficientFiring
    (frozenSubstitutionCoefficientTensorMap O (ColoredProfile.nullary d) Q R)
    (O.subst.app (frozenSubstitution (ColoredProfile.nullary d) Q R))
    (O.toCollection.map (frozenTotalProfileHom (ColoredProfile.nullary d) Q R))
    (O.toCollection.map (nullaryVariableProfileHom d (frozenTotalInputs Q R)))
    (O.toCollection.map (ColoredSubstitutionData.totalProfileMap (shapeHom d Q R)))
    ((ColoredOperadObj.substitutionSource O.toCollection).map (shapeHom d Q R))
    (O.subst.app (tupleSubstitutionShape ((inputsToProfile d).obj Q) R))
    ((FiniteTensor.tensor (V := C)).map (coefficientHom O.toCollection d Q R))
    hfaces hs (coefficientTensorMap O d Q R)


end CategoryTheory.Operad.Tensor.Enveloping.Nullary

