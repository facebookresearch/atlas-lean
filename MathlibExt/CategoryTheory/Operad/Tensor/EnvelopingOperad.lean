    (congrArg (fun f => p ≫ T.map f ≫ n) hblock.symm).trans
      (groupedBlocksCoefficientInputs N A e K.obj M k ℓ)
  have hleaf : leaf ≫ (rightLeavesIso L I).hom = (rightGroupedLeavesIso X L I).hom := rfl
  have hfamily : coefficientLeafMap c leaf ≫ coefficientLeafMap (𝟙 (T.obj K))
    (rightLeavesIso L I).hom =
      coefficientLeafMap c (rightGroupedLeavesIso X L I).hom :=
    (coefficientLeafMap_comp _ _ _ _).trans
      (congrArg₂ (fun coeff leaf => coefficientLeafMap coeff leaf) (Category.comp_id c) hleaf)
  have hl : t ≫ l = u := (T.map_comp _ _).symm.trans (congrArg T.map hfamily)
  have hm : b ≫ r = m := (T.map_comp _ _).symm
  exact (Category.assoc
    (UnitInsertion.rightInsertFromFactor Z I (rightWeightedFactor X L I Y η)) n l).trans
      (rightPrefixFold a b p f n l r s t u m hp hl hm)

/-- The actual singleton coefficient/input interchange remains
the original weighted singleton collapse followed by any complete
original coefficient map. -/
theorem singletonInterchangePost (X : C) (L : FiniteFamily C) {Y : C}
    (f : (FiniteTensor.tensor (V := C)).obj ((FiniteFamily.singleton (C := C)).obj X) ⟶ Y) :
    (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _ => L)).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap f
        (singletonCoefficientInputLeafIso L).hom) =
    (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X) ≫
      (coefficientLeafTensorFunctor L).map ((FiniteTensor.singletonIso (V := C)).inv.app X
        ≫ f) := by
  let T := FiniteTensor.tensor (V := C)
  let U := coefficientLeafTensorFunctor L
  let n := (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _
    => L)).hom
  let p := T.map (coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.singleton (C := C)).obj X)))
    (singletonCoefficientInputLeafIso L).hom)
  let q := U.map f
  let a := (FiniteTensor.singletonIso (V := C)).hom.app (U.obj X)
  let b := U.map ((FiniteTensor.singletonIso (V := C)).inv.app X)
  have hf : coefficientLeafMap (𝟙 (T.obj ((FiniteFamily.singleton (C := C)).obj X)))
      (singletonCoefficientInputLeafIso L).hom ≫ (coefficientLeafFamilyFunctor L).map f =
      coefficientLeafMap f (singletonCoefficientInputLeafIso L).hom :=
    (coefficientLeafMap_post _ _ _).trans
      (congrArg (fun c => coefficientLeafMap c (singletonCoefficientInputLeafIso L).hom)
        (Category.id_comp f))
  have ht : p ≫ q = T.map (coefficientLeafMap f (singletonCoefficientInputLeafIso L).hom) :=
    (T.map_comp _ _).symm.trans (congrArg T.map hf)
  have hs : n ≫ p = a ≫ b := coefficientBlockInterchange_singleton X L
  exact (congrArg (n ≫ ·) ht.symm).trans
    ((Category.assoc n p q).symm.trans
      ((congrArg (· ≫ q) hs).trans
        ((Category.assoc a b q).trans
          (congrArg (a ≫ ·) (U.map_comp _ _).symm))))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
