section EnvelopingSource087


/-!
# Actual original root-first contracted coefficient and unit factors
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original root-first tensor-of-blocks source maps to
the retained original flat-inner coefficients and original algebra
unit factors, with exact original root/middle unit positions. -/
def envelopingAssocRootFirstFinalFactorsMap (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
      (envelopingAssocRootFirstRetainedBlocks O.toCollection d Q) ⟶
      frozenVariableUnitFamily (envelopingAssocInnerRootInputs d Q).index
        (envelopingRepresentativeCoefficients O.toCollection d.innerData
          (envelopingAssocInnerChoices d Q)) where
  equiv :=
    { toFun p := match p with
        | none => Sum.inr none
        | some ⟨Sum.inl i, Sum.inl j⟩ => Sum.inr (some ⟨i, j⟩)
        | some ⟨Sum.inl i, Sum.inr j⟩ => Sum.inl (Sum.inr ⟨i, j⟩)
        | some ⟨Sum.inr j, _⟩ => Sum.inl (Sum.inl j)
      invFun p := match p with
        | Sum.inl (Sum.inl j) => some ⟨Sum.inr j, PUnit.unit⟩
        | Sum.inl (Sum.inr ⟨i, j⟩) => some ⟨Sum.inl i, Sum.inr j⟩
        | Sum.inr none => none
        | Sum.inr (some ⟨i, j⟩) => some ⟨Sum.inl i, Sum.inl j⟩
      left_inv p := by cases p with
        | none => rfl
        | some p => rcases p with ⟨i, j⟩; cases i with
          | inl i => cases j <;> rfl
          | inr i => cases j; rfl
      right_inv p := by cases p with
        | inl p => cases p <;> rfl
        | inr p => cases p <;> rfl }
  hom p := match p with
    | none => envelopingAssocMiddleCoefficientSubstitution O d Q
    | some ⟨Sum.inl i, Sum.inl j⟩ => (FiniteTensor.singletonIso (V := C)).hom.app
        (O.toCollection.obj (extendProfile ((d.localData i).inner.obj j) (Q.branch i (some j))))
    | some ⟨Sum.inl _, Sum.inr _⟩ => 𝟙 _
    | some ⟨Sum.inr _, _⟩ => 𝟙 _

/-- The actual retained root-first coefficient/unit maps,
followed by the original flat-inner unit insertion, give the
actual root-first applied coefficient contraction. -/
theorem envelopingAssocRootFirstFinalFactorsMap_factorization (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocRootFirstFinalFactorsMap O d Q ≫
        envelopingRepresentativeUnitMap O d.innerData (envelopingAssocInnerChoices d Q) =
      envelopingAssocRootFirstAppliedContraction O d Q := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | none => rfl
    | some p => rcases p with ⟨i, j⟩; cases i with
      | inl i => cases j <;> rfl
      | inr i => rfl
  · intro p
    cases p with
    | none => exact HEq.rfl
    | some p =>
      rcases p with ⟨i, j⟩
      cases i with
      | inl i => cases j with
        | inl j =>
          have hm := O.toCollection.map_id (extendProfile ((d.localData i).inner.obj j)
            (Q.branch i (some j)))
          let s := (FiniteTensor.singletonIso (V := C)).hom.app
            (O.toCollection.obj (extendProfile ((d.localData i).inner.obj j) (Q.branch i (some j))))
          exact heq_of_eq ((Category.comp_id s).trans
            ((Category.comp_id s).symm.trans (congrArg (s ≫ ·) hm).symm))
        | inr j =>
          have hm := O.toCollection.map_id (ColoredSubstitutionData.unitProfile ((Q.branch i
            none).obj j).as)
          exact heq_of_eq ((Category.id_comp _).trans
            ((Category.comp_id _).symm.trans (congrArg (_ ≫ ·) hm).symm))
      | inr rootIndex =>
        have hm := O.toCollection.map_id (ColoredSubstitutionData.unitProfile (Q.root.obj
          rootIndex).as)
        exact heq_of_eq ((Category.id_comp _).trans
          ((Category.comp_id _).symm.trans (congrArg (_ ≫ ·) hm).symm))


end CategoryTheory.Operad.Tensor.Enveloping

end
