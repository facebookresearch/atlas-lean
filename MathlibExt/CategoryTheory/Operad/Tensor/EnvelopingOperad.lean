/- Exact checked source: ReflexiveOperad.LinearAlgebraRestrictionNullary. -/
section EnvelopingSource359


/-!
# Genuine restriction preserves the original nullary coefficient evaluation and whole
algebra composition
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraRelation

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original nullary factor inverse retains the full original
operad-map coefficient component and the original singleton input position. -/
theorem restrictionNil_factors {O E : ColoredOperadObj W C} (u : O ⟶ E) (A : W → C) (d : W) :
    (nullaryFactorsIso O.toCollection A d).inv ≫
      (analyticFactorsCollectionMap A u.toCollectionHom).app (AnalyticIndex.nullary (d := d)) =
    (FiniteFamily.singleton (C := C)).map (u.toCollectionHom.app (ColoredProfile.nullary d)) ≫
      (nullaryFactorsIso E.toCollection A d).inv := by
  apply FiniteFamily.Hom_ext
  · apply Equiv.ext
    intro i
    cases i
    rfl
  · intro i
    cases i
    let X := O.toCollection.obj (ColoredProfile.nullary d)
    let Y := E.toCollection.obj (ColoredProfile.nullary d)
    let f := u.toCollectionHom.app (ColoredProfile.nullary d)
    change HEq ((𝟙 X ≫ 𝟙 X) ≫ f) (f ≫ (𝟙 Y ≫ 𝟙 Y))
    have hl : (𝟙 X ≫ 𝟙 X) ≫ f = f := (congrArg (· ≫
      f) (Category.id_comp (𝟙 X))).trans (Category.id_comp f)
    have hr : f ≫ (𝟙 Y ≫ 𝟙 Y) = f := (congrArg (f ≫
      ·) (Category.id_comp (𝟙 Y))).trans (Category.comp_id f)
    exact heq_of_eq (hl.trans hr.symm)

/-- The original inverse nullary summand comparison keeps the actual
whole coefficient map through both original tensor singleton inverses. -/
theorem restrictionNil_summand {O E : ColoredOperadObj W C} (u : O ⟶ E) (A : W → C) (d : W) :
    (nullarySummandIso O.toCollection A d).inv ≫
      (analyticSummandCollectionMap A u.toCollectionHom).app (AnalyticIndex.nullary (d := d)) =
    u.toCollectionHom.app (ColoredProfile.nullary d) ≫ (nullarySummandIso E.toCollection A
      d).inv := by
  let T := FiniteTensor.tensor (V := C)
  let sO := (FiniteTensor.singletonIso (V := C)).inv.app (O.toCollection.obj
    (ColoredProfile.nullary d))
  let sE := (FiniteTensor.singletonIso (V := C)).inv.app (E.toCollection.obj
    (ColoredProfile.nullary d))
  let nO := T.map (nullaryFactorsIso O.toCollection A d).inv
  let nE := T.map (nullaryFactorsIso E.toCollection A d).inv
  let m := (analyticSummandCollectionMap A u.toCollectionHom).app (AnalyticIndex.nullary (d := d))
  let f := u.toCollectionHom.app (ColoredProfile.nullary d)
  let k := T.map ((FiniteFamily.singleton (C := C)).map f)
  have h : nO ≫ m = k ≫ nE := (T.map_comp _ _).symm.trans
    ((congrArg T.map (restrictionNil_factors u A d)).trans (T.map_comp _ _))
  have hs : sO ≫ k = f ≫ sE := ((FiniteTensor.singletonIso (V := C)).inv.naturality f).symm
  exact (Category.assoc sO nO m).trans ((congrArg (sO ≫ ·) h).trans
    ((Category.assoc sO k nE).symm.trans ((congrArg (· ≫ nE) hs).trans (Category.assoc f sE nE))))

/-- The genuine restricted algebra's original nullary evaluation is
exactly the original full coefficient map followed by the original M nullary evaluation. -/
theorem restriction_nullaryEvaluation {O E : ColoredOperadObj W C} (u : O ⟶ E) (M :
  Algebra E) (d : W) :
    FrozenAlgebra.nullaryEvaluation (Algebra.restrict u M) d =
      u.toCollectionHom.app (ColoredProfile.nullary d) ≫ FrozenAlgebra.nullaryEvaluation M d := by
  let n := (nullarySummandIso O.toCollection M.carrier d).inv
  let m := (analyticSummandCollectionMap M.carrier u.toCollectionHom).app
    (AnalyticIndex.nullary (d := d))
  let o := M.operations.app d AnalyticIndex.nullary
  let f := u.toCollectionHom.app (ColoredProfile.nullary d)
  let n' := (nullarySummandIso E.toCollection M.carrier d).inv
  exact (Category.assoc n m o).symm.trans
    ((congrArg (· ≫ o) (restrictionNil_summand u M.carrier d)).trans (Category.assoc f n' o))

/-- Nested genuine original restrictions equal restriction along the
actual full operad composite, retaining exact carriers and every operation. -/
theorem restriction_comp {O P E : ColoredOperadObj W C} (u : O ⟶ P) (v : P ⟶ E) (M : Algebra E) :
    Algebra.restrict u (Algebra.restrict v M) = Algebra.restrict (u ≫ v) M := by
  have h : (Algebra.restrict u (Algebra.restrict v M)).operations = (Algebra.restrict (u ≫
    v) M).operations := by
    apply Operations.ext
    funext d Q
    let f := (analyticSummandCollectionMap (d := d) M.carrier u.toCollectionHom).app Q
    let g := (analyticSummandCollectionMap (d := d) M.carrier v.toCollectionHom).app Q
    let fg := (analyticSummandCollectionMap (d := d) M.carrier (u ≫ v).toCollectionHom).app Q
    let o := M.operations.app d Q
    have hc : fg = f ≫ g := congrArg (fun t => t.app Q) (analyticSummandCollectionMap_comp
      M.carrier u.toCollectionHom
      v.toCollectionHom)
    exact (Category.assoc f g o).symm.trans (congrArg (· ≫ o) hc.symm)
  exact Algebra.ext_carrier_operations rfl (heq_of_eq h)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebraRelation

end
end EnvelopingSource359

/- Exact checked source: EnvelopingCanonicalOriginalAlgebra. -/
section EnvelopingSource360


/-!
# The canonical enveloping algebra restricts to the actual original O-algebra A
-/

set_option autoImplicit false
noncomputable section
universe uc u v us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem canonicalConstantsFiring {D : Type*} [Category* D]
    {X A B : D} (i : X ⟶ A) (q : A ⟶ B) (d : A ⟶ X) (e : B ⟶ X)
    (hd : d = q ≫ e) (hi : (i ≫ q) ≫ e = 𝟙 X) : i ≫ d = 𝟙 X := by
  rw [hd, ← Category.assoc i q, hi]

variable {W : Type uc} {C : Type u} [Category.{v} C]
variable [MonoidalCategory C] [SymmetricCategory C] [MonoidalClosed C]
variable [Small.{us} W] [HasColimitsOfSize.{us, us} C]

/-- Use the finite tensor constructed from the original symmetric monoidal structure. -/
local instance : FiniteTensor C := FiniteTensor.ofSymmetric C
local instance : FiniteTensorPreservesColimitsInEachSlot.{v, u, us} C :=
  FiniteTensor.ofSymmetric_preservesColimitsInEachSlot C
local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The original constants in the canonical actual Env algebra,
restricted through its genuine coefficient quotient, are the original A identity. -/
theorem canonicalEnvelopingAlgebra_linearConstants (O : ColoredOperadObj W C) (A : Algebra O) :
    linearAlgebraConstants O A.carrier (Algebra.restrict (envelopingOperadProjection O A)
      (canonicalEnvelopingAlgebra O
      A)) =
      𝟙 A.carrier := by
  funext d
  let M := canonicalEnvelopingAlgebra O A
  let i := linearConstantGenerator O A.carrier d
  let q := (envelopingOperadProjection O A).toCollectionHom.app (ColoredProfile.nullary d)
  let δ := FrozenAlgebra.nullaryEvaluation (Algebra.restrict (envelopingOperadProjection O A) M) d
  let e := (envelopingOperadNullaryIso O A d).hom
  have hd : δ = q ≫ e :=
    (LinearAlgebraRelation.restriction_nullaryEvaluation (envelopingOperadProjection O A) M d).trans
      (congrArg (q ≫ ·) (canonicalEnvelopingAlgebra_nullaryEvaluation O A d))
  exact canonicalConstantsFiring i q δ e hd (envelopingConstantGenerator_evaluation O A d)

/-- The O-action recovered from the genuine canonical Env algebra
is precisely the original actual A action, by the original nullary
coefficient coequalizer and constant-generator identity. -/
theorem canonicalEnvelopingAlgebra_originalAction (O : ColoredOperadObj W C) (A : Algebra O) :
    (linearAlgebraUnderlying O A.carrier
      (Algebra.restrict (envelopingOperadProjection O A) (canonicalEnvelopingAlgebra O
        A))).action = A.action := by
  let M := Algebra.restrict (envelopingOperadProjection O A) (canonicalEnvelopingAlgebra O A)
  let MO := linearAlgebraUnderlying O A.carrier M
  let g := linearAlgebraConstants O A.carrier M
  have hg : g = 𝟙 A.carrier := canonicalEnvelopingAlgebra_linearConstants O A
  have hleft : (fun d => (nullaryLinearCoefficientIso O.toCollection A.carrier d).inv ≫
      FrozenAlgebra.nullaryEvaluation M d) = A.action := by
    funext d
    let e := nullaryLinearCoefficientIso O.toCollection A.carrier d
    let q := (envelopingOperadProjection O A).toCollectionHom.app (ColoredProfile.nullary d)
    let δ := FrozenAlgebra.nullaryEvaluation M d
    have hδ : δ = e.hom ≫ A.action d :=
      (LinearAlgebraRelation.restriction_nullaryEvaluation (envelopingOperadProjection O A)
        (canonicalEnvelopingAlgebra O A) d).trans
        ((congrArg (q ≫ ·) (canonicalEnvelopingAlgebra_nullaryEvaluation O A d)).trans
          (envelopingOperadNullaryIso_projection O A d))
    exact (congrArg (e.inv ≫ ·) hδ).trans (e.inv_hom_id_assoc (A.action d))
  have hright : (fun d => (nullaryLinearCoefficientIso O.toCollection A.carrier d).inv ≫
      FrozenAlgebra.nullaryEvaluation M d) = profileMap O.toCollection g ≫ MO.action :=
    linearAlgebra_nullary_action_family O A.carrier M
  have hmap : profileMap O.toCollection g = 𝟙 (profileCoinvariants O.toCollection A.carrier) :=
    (congrArg (profileMap O.toCollection) hg).trans (profileMap_id O.toCollection A.carrier)
  exact (hleft.symm.trans
    (hright.trans ((congrArg (· ≫ MO.action) hmap).trans (Category.id_comp MO.action)))).symm

/-- The actual O-restriction of the constructed canonical enveloping
algebra is the original genuine algebra A with its entire operation family. -/
theorem canonicalEnvelopingAlgebra_original (O : ColoredOperadObj W C) (A : Algebra O) :
    Algebra.restrict (originalOperadToEnveloping O A) (canonicalEnvelopingAlgebra O A) = A := by
  let M := Algebra.restrict (envelopingOperadProjection O A) (canonicalEnvelopingAlgebra O A)
  let MO := linearAlgebraUnderlying O A.carrier M
  have haction : MO.action = A.action := canonicalEnvelopingAlgebra_originalAction O A
  have hops : MO.operations = A.operations := by
    apply Operations.ext
    funext d P
    exact (MO.action_operation d P).symm.trans
      ((congrArg (profileι O.toCollection A.carrier P ≫
        ·) (congrFun haction d)).trans (A.action_operation d P))
  have hA : MO = A := Algebra.ext_carrier_operations rfl (heq_of_eq hops)
  exact (LinearAlgebraRelation.restriction_comp (originalOperationToLinearOperadMap O A.carrier)
    (envelopingOperadProjection O A) (canonicalEnvelopingAlgebra O A)).symm.trans hA


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource360

/- Exact checked source: WeightedNormalization.EnvelopingFunctorFaces. -/
section EnvelopingSource361


/-!
# Original full operadic relation faces under actual tensor algebra maps
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem inverseCarrierSquare {D : Type*} [Category* D] {A B X Y : D}
    (e : A ≅ X) (e' : B ≅ Y) (k : A ⟶ B) (l : X ⟶ Y)
    (h : k ≫ e'.hom = e.hom ≫ l) : e.inv ≫ k = l ≫ e'.inv := by
  apply (cancel_mono e'.hom).1
  rw [Category.assoc, h, ← Category.assoc e.inv e.hom, e.inv_hom_id, Category.id_comp]
  rw [Category.assoc, e'.inv_hom_id, Category.comp_id]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- The actual original nullary linear comparison inverse retains the
original free-input map and original coefficient carrier map at every color. -/
theorem nullaryLinearCoefficientIso_inv_carrier (O : ColoredSymmetricCollection W C) {A B : W → C}
    (f : A ⟶ B) (d : W) :
    (nullaryLinearCoefficientIso O A d).inv ≫ linearCoefficientCarrierLift O f
      (ColoredProfile.nullary d) =
      profileMap O f d ≫ (nullaryLinearCoefficientIso O B d).inv :=
  inverseCarrierSquare _ _ _ _ (nullaryLinearCoefficientIso_carrier O f d)

variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- Every original full O-operation inclusion is unchanged under the
actual full linear operad carrier map, at every original profile. -/
theorem originalOperationToLinearOperadMap_carrier (O : ColoredOperadObj W C) {A B : W →
  C} (f : A ⟶ B) :
    originalOperationToLinearOperadMap O A ≫ linearCarrierOperadMap O f =
      originalOperationToLinearOperadMap O B := by
  apply ColoredOperadObj.Hom.ext
  apply NatTrans.ext
  funext P
  exact originalOperationToLinear_carrier O.toCollection f P

/-- The original operadic constant-input face is natural in every actual
colorwise carrier arrow, through the literal original free-input carrier map.
The proof uses the full target/precomposition laws of the constructed
constants extension and the actual original nullary linear comparison. -/
theorem constantRelationOperadFace_carrier_naturality (O : ColoredOperadObj W C) {A B : W
  → C} (f : A ⟶ B) :
    constantRelationOperadFace O A ≫ linearCarrierOperadMap O f =
      linearCarrierOperadMap O (profileMap O.toCollection f) ≫ constantRelationOperadFace O B := by
  let TA := profileCoinvariants O.toCollection A
  let TB := profileCoinvariants O.toCollection B
  let uA := originalOperationToLinearOperadMap O A
  let uB := originalOperationToLinearOperadMap O B
  let l := linearCarrierOperadMap O f
  let t := profileMap O.toCollection f
  let bA : ∀ d, TA d ⟶ (envelopingLinearOperad O A).toCollection.obj (ColoredProfile.nullary d) :=
    fun d => (nullaryLinearCoefficientIso O.toCollection A d).inv
  let bB : ∀ d, TB d ⟶ (envelopingLinearOperad O B).toCollection.obj (ColoredProfile.nullary d) :=
    fun d => (nullaryLinearCoefficientIso O.toCollection B d).inv
  have hu : uA ≫ l = uB := originalOperationToLinearOperadMap_carrier O f
  have hb : (fun d => bA d ≫ l.toCollectionHom.app (ColoredProfile.nullary d)) = (fun d =>
    t d ≫ bB d) := by
    funext d
    exact nullaryLinearCoefficientIso_inv_carrier O.toCollection f d
  calc
    constantRelationOperadFace O A ≫ l = constantInputOperadMap O A ≫ l :=
      congrArg (· ≫ l) (constantRelationOperadFace_eq O A)
    _ = Linear.Constants.operadMap (uA ≫ l) TA (fun d => bA d ≫
      l.toCollectionHom.app (ColoredProfile.nullary d)) :=
      Linear.Constants.operadMap_post uA TA bA l
    _ = Linear.Constants.operadMap uB TA (fun d => t d ≫ bB d) :=
      congrArg₂ (fun (u : O ⟶ envelopingLinearOperad O B)
        (b : ∀ d, TA d ⟶ (envelopingLinearOperad O B).toCollection.obj
          (ColoredProfile.nullary d)) =>
          Linear.Constants.operadMap u TA b) hu hb
    _ = linearCarrierOperadMap O t ≫ constantInputOperadMap O B :=
      (Linear.Constants.operadMap_pre uB t bB).symm
    _ = linearCarrierOperadMap O t ≫ constantRelationOperadFace O B :=
      congrArg (linearCarrierOperadMap O t ≫ ·) (constantRelationOperadFace_eq O B).symm

/-- An actual morphism of genuine tensor O-algebras retains the full
original operadic constant-input relation square, with its literal f.hom. -/
theorem constantRelationOperadFace_algebra_naturality (O : ColoredOperadObj W C) {A B :
  Algebra O} (f : A ⟶ B) :
    constantRelationOperadFace O A.carrier ≫ linearCarrierOperadMap O f.hom =
      linearCarrierOperadMap O (profileMap O.toCollection f.hom) ≫
        constantRelationOperadFace O B.carrier :=
  constantRelationOperadFace_carrier_naturality O f.hom


end CategoryTheory.Operad.Tensor.Enveloping

end
end EnvelopingSource361

/- Exact checked source: WeightedNormalization.EnvelopingFunctorMaps. -/
section EnvelopingSource362


/-!
# Actual descended enveloping operad maps and all original quotient readbacks
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem balanceTransport {D : Type*} [Category* D] {X₀ X Y₀ Y E : D}
    (s : X₀ ⟶ X) (t : X₀ ⟶ X) (f : X ⟶ Y) (f₀ : X₀ ⟶ Y₀)
    (s' : Y₀ ⟶ Y) (t' : Y₀ ⟶ Y) (p : Y ⟶ E)
    (hs : s ≫ f = f₀ ≫ s') (ht : t ≫ f = f₀ ≫ t') (hp : s' ≫ p = t' ≫ p) :
    s ≫ (f ≫ p) = t ≫ (f ≫ p) := by
  calc
    s ≫ (f ≫ p) = (s ≫ f) ≫ p := (Category.assoc s f p).symm
    _ = (f₀ ≫ s') ≫ p := congrArg (· ≫ p) hs
    _ = f₀ ≫ (t' ≫ p) := (Category.assoc f₀ s' p).trans (congrArg (f₀ ≫ ·) hp)
    _ = (t ≫ f) ≫ p := (Category.assoc f₀ t' p).symm.trans (congrArg (· ≫ p) ht.symm)
    _ = t ≫ (f ≫ p) := Category.assoc t f p

private theorem cofanMapFiring {D : Type*} [Category* D] {X X' A A' E E' : D}
    (i : X ⟶ A) (p : A ⟶ E) (h : E ⟶ E') (c : A ⟶ A') (j : X' ⟶ A') (b : X ⟶ X') (q : A' ⟶ E')
    (hp : p ≫ h = c ≫ q) (hi : i ≫ c = b ≫ j) : i ≫ p ≫ h = b ≫ j ≫ q := by
  exact (congrArg (i ≫ ·) hp).trans ((Category.assoc i c q).symm.trans
    ((congrArg (· ≫ q) hi).trans (Category.assoc b j q)))

private theorem originalMapFiring {D : Type*} [Category* D] {A B C E F : D}
    (i : A ⟶ B) (p : B ⟶ C) (f : C ⟶ E) (l : B ⟶ F) (q : F ⟶ E) (i' : A ⟶ F)
    (hp : p ≫ f = l ≫ q) (hi : i ≫ l = i') : (i ≫ p) ≫ f = i' ≫ q :=
  (Category.assoc i p f).trans ((congrArg (i ≫ ·) hp).trans
    ((Category.assoc i l q).symm.trans (congrArg (· ≫ q) hi)))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- An actual tensor O-algebra map balances the original two full
relation faces after the original target enveloping projection. -/
theorem envelopingOperadMap_balance (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B) :
    constantRelationOperadFace O A.carrier ≫ (linearCarrierOperadMap O f.hom ≫
      envelopingOperadProjection O B) =
      algebraRelationOperadFace O A ≫ (linearCarrierOperadMap O f.hom ≫
        envelopingOperadProjection O B) :=
  balanceTransport _ _ _ _ _ _ _ (constantRelationOperadFace_algebra_naturality O f)
    (algebraRelationOperadFace_naturality O f) (envelopingOperadProjection_condition O B)

/-- The actual enveloping operad arrow is the genuine quotient descent
of the original L(f.hom) followed by the original target projection. -/
def envelopingOperadMap (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B) :
    envelopingOperad O A ⟶ envelopingOperad O B :=
  envelopingOperadDesc O A (linearCarrierOperadMap O f.hom ≫ envelopingOperadProjection O B)
    (envelopingOperadMap_balance O f)

/-- The full descended arrow has precisely its original full projection square. -/
theorem envelopingOperadMap_projection (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B) :
    envelopingOperadProjection O A ≫ envelopingOperadMap O f =
      linearCarrierOperadMap O f.hom ≫ envelopingOperadProjection O B :=
  envelopingOperadProjection_desc O A (linearCarrierOperadMap O f.hom ≫
    envelopingOperadProjection O B)
    (envelopingOperadMap_balance O f)

/-- The full quotient square retains the literal original coefficient
projection and carrier-lift map at every heterogeneous/nullary profile. -/
theorem envelopingOperadMap_projection_app (O : ColoredOperadObj W C) {A B : Algebra O} (f :
  A ⟶ B) (P : ColoredProfile
  W) :
    envelopingCoefficientπ O A P ≫ (envelopingOperadMap O f).toCollectionHom.app P =
      linearCoefficientCarrierLift O.toCollection f.hom P ≫ envelopingCoefficientπ O B P :=
  congrArg (fun h => h.toCollectionHom.app P) (envelopingOperadMap_projection O f)

/-- The original whole coefficient-projection natural transformation
and original whole carrier natural transformation remain in the square. -/
theorem envelopingOperadMap_projection_collection (O : ColoredOperadObj W C) {A B : Algebra
  O} (f : A ⟶ B) :
    Variable.envelopingCoefficientProjection O A ≫ (envelopingOperadMap O f).toCollectionHom =
      linearCarrierCollectionMap O.toCollection f.hom ≫
        Variable.envelopingCoefficientProjection O B :=
  congrArg ColoredOperadObj.Hom.toCollectionHom (envelopingOperadMap_projection O f)

/-- Every original representative cofan keeps its actual carrier map
and original quotient leg under the descended full enveloping arrow. -/
theorem envelopingOperadMap_cofan (O : ColoredOperadObj W C) {A B : Algebra O} (f : A ⟶ B)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection A.carrier P Q ≫ envelopingCoefficientπ O A P ≫
      (envelopingOperadMap O
      f).toCollectionHom.app P =
      (linearCoefficientCarrierMap O.toCollection f.hom P).app Q ≫
        linearCoefficientι O.toCollection B.carrier P Q ≫
        envelopingCoefficientπ O B P :=
  cofanMapFiring _ _ _ _ _ _ _ (envelopingOperadMap_projection_app O f P)
    (linearCoefficientι_carrier O.toCollection
    f.hom P Q)

