# Original coefficient maps under the genuine two-leaf tensor comparison
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem joinNaturalityFiring {D : Type*} [Category* D]
    {A A' B B' Y Y' : D}
    (n : A ⟶ B) (n' : A' ⟶ B') (f : B ⟶ B') (r : A ⟶ A')
    (p : B ⟶ Y) (p' : B' ⟶ Y') (s : A ⟶ Y) (s' : A' ⟶ Y') (g : Y ⟶ Y')
    (hn : n ≫ f = r ≫ n') (hs : n ≫ p = s) (hs' : n' ≫ p' = s')
    (hraw : r ≫ s' = s ≫ g) : n ≫ (f ≫ p') = n ≫ (p ≫ g) := by
  rw [← Category.assoc n f, hn, Category.assoc r n', hs', hraw]
  rw [← Category.assoc n p, hs]

private theorem joinOuterFiring {D : Type*} [Category* D]
    {A B C E F G Y : D} (n : A ⟶ B) (u : B ⟶ C) (v : C ⟶ E) (p : E ⟶ Y)
    (r : A ⟶ F) (n' : F ⟶ C) (s : F ⟶ G) (m : G ⟶ Y) (f : B ⟶ E)
    (hf : f = u ≫ v) (hn : n ≫ u = r ≫ n') (hs : n' ≫ v ≫ p = s ≫ m) :
    n ≫ f ≫ p = (r ≫ s) ≫ m := by
  rw [hf]
  simp only [Category.assoc]
  rw [← Category.assoc n u, hn, Category.assoc r n', hs]

variable {C : Type w} [Category.{v} C]

/-- Every original coefficient map commutes with the original scalar
two-leaf regrouping, retaining both complete original leaf families. -/
theorem leafJoinScalarRaw_naturality {X Y : C} (f : X ⟶ Y) (B L : FiniteFamily C) :
    (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap ((coefficientLeafFamilyFunctor B).map f) (𝟙 L)) ≫
      (leafJoinScalarRawIso Y B L).hom =
    (leafJoinScalarRawIso X B L).hom ≫
      (coefficientLeafFamilyFunctor (leafJoin B L)).map f := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some _ => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
        change HEq (f ≫ 𝟙 Y) (𝟙 X ≫ f)
        exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)
      | some j =>
        let Z := B.obj j
        change HEq (𝟙 Z ≫ 𝟙 Z) (𝟙 Z ≫ 𝟙 Z)
        rfl
    | some i =>
      cases j
      let Z := L.obj i
      change HEq (𝟙 Z ≫ 𝟙 Z) (𝟙 Z ≫ 𝟙 Z)
      rfl

variable [FiniteTensor C]

/-- Every original coefficient arrow acts identically under the
genuine successive/combined original leaf tensor comparison. -/
theorem leafJoinTensor_naturality {X Y : C} (f : X ⟶ Y) (B L : FiniteFamily C) :
    (coefficientLeafTensorFunctor L).map ((coefficientLeafTensorFunctor B).map f) ≫
      (leafJoinTensorIso Y B L).hom =
    (leafJoinTensorIso X B L).hom ≫
      (coefficientLeafTensorFunctor (leafJoin B L)).map f := by
  let T := FiniteTensor.tensor (V := C)
  let K := (coefficientLeafFamilyFunctor B).obj X
  let K' := (coefficientLeafFamilyFunctor B).obj Y
  let k := (coefficientLeafFamilyFunctor B).map f
  let n := (coefficientLeavesNormalizationIso K L).hom
  let n' := (coefficientLeavesNormalizationIso K' L).hom
  let u := (coefficientLeafTensorFunctor L).map ((coefficientLeafTensorFunctor B).map f)
  let r := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap k (𝟙 L)))
  let p := (leafJoinTensorIso X B L).hom
  let p' := (leafJoinTensorIso Y B L).hom
  let s := T.map (leafJoinScalarRawIso X B L).hom
  let s' := T.map (leafJoinScalarRawIso Y B L).hom
  let g := (coefficientLeafTensorFunctor (leafJoin B L)).map f
  have hid : T.map (coefficientLeafMap (T.map k) (𝟙 L)) = u :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map k) L)
  have hn : n ≫ u = r ≫ n' :=
    (congrArg (n ≫ ·) hid).symm.trans
      ((congrArg (· ≫ T.map (coefficientLeafMap (T.map k) (𝟙 L)))
        (coefficientLeavesNormalizationIso_hom K L)).trans
          ((coefficientLeavesNormalization_naturality k (𝟙 L)).symm.trans
            (congrArg (r ≫ ·) (coefficientLeavesNormalizationIso_hom K' L).symm)))
  have hs : n ≫ p = s := (coefficientLeavesNormalizationIso K L).hom_inv_id_assoc s
  have hs' : n' ≫ p' = s' := (coefficientLeavesNormalizationIso K' L).hom_inv_id_assoc s'
  have hraw : r ≫ s' = s ≫ g :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (leafJoinScalarRaw_naturality f B L)).trans (T.map_comp _ _))
  apply (cancel_epi n).1
  exact joinNaturalityFiring n n' u r p p' s s' g hn hs hs' hraw

/-- Every original raw coefficient/leaf map normalizes before or
after adding the second complete original leaf family, using the
actual finite input map and genuine two-leaf coherence. -/
theorem leafJoinOuter_normalization (D K B L : FiniteFamily C)
    (a : D ⟶ (FiniteFamily.flatten (C := C)).obj (coefficientLeavesNested K B)) :
    coefficientLeavesNormalization D L ≫
      (coefficientLeafTensorFunctor L).map
        ((FiniteTensor.tensor (V := C)).map a ≫ coefficientLeavesNormalization K B) ≫
      (leafJoinTensorIso ((FiniteTensor.tensor (V := C)).obj K) B L).hom =
    (FiniteTensor.tensor (V := C)).map
      ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap a (𝟙 L)) ≫
        (leafJoinRawIso K B L).hom) ≫
      coefficientLeavesNormalization K (leafJoin B L) := by
  let T := FiniteTensor.tensor (V := C)
  let U := coefficientLeafTensorFunctor L
  let n := coefficientLeavesNormalization D L
  let u := U.map (T.map a)
  let v := U.map (coefficientLeavesNormalization K B)
  let p := (leafJoinTensorIso (T.obj K) B L).hom
  let r := T.map ((FiniteFamily.flatten (C := C)).map (coefficientLeavesNestedMap a (𝟙 L)))
  let n' := coefficientLeavesNormalization ((FiniteFamily.flatten (C :=
    C)).obj (coefficientLeavesNested K B)) L
  let s := T.map (leafJoinRawIso K B L).hom
  let m := coefficientLeavesNormalization K (leafJoin B L)
  let f := U.map (T.map a ≫ coefficientLeavesNormalization K B)
  have hf : f = u ≫ v := U.map_comp _ _
  have hid : T.map (coefficientLeafMap (T.map a) (𝟙 L)) = u :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map a) L)
  have hn : n ≫ u = r ≫ n' :=
    (congrArg (n ≫ ·) hid).symm.trans (coefficientLeavesNormalization_naturality a (𝟙 L)).symm
  have hs : n' ≫ v ≫ p = s ≫ m := leafJoin_normalization K B L
  exact (joinOuterFiring n u v p r n' s m f hf hn hs).trans
    (congrArg (· ≫ m) (T.map_comp _ _).symm)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

