/-!
# Genuine coefficient normalization with two full original leaf families
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem joinMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem joinNormalizeFiring {D : Type*} [Category* D]
    {X A B E F G H J K Z Y : D}
    (p : X ⟶ A) (n : A ⟶ B) (u : B ⟶ E) (v : E ⟶ F) (d : F ⟶ Y) (f : B ⟶ F)
    (a : X ⟶ G) (e : G ⟶ H) (j : H ⟶ J) (nJ : J ⟶ E)
    (c : J ⟶ K) (nS : K ⟶ F) (z : K ⟶ Y) (t : H ⟶ Z) (b : Z ⟶ Y)
    (hf : f = u ≫ v) (ha : p ≫ n ≫ u = a ≫ e ≫ j ≫ nJ)
    (hn : nJ ≫ v = c ≫ nS) (hd : nS ≫ d = z) (hb : j ≫ c ≫ z = t ≫ b) :
    p ≫ n ≫ f ≫ d = a ≫ e ≫ t ≫ b := by
  rw [hf]
  have hp : (p ≫ n ≫ u) ≫ v ≫ d = (a ≫ e ≫ j ≫ nJ) ≫ v ≫ d :=
