theorem mapSingleton_tensor_prefix (K : FiniteFamily C) :
    (FiniteTensor.tensor (V := C)).map (FiniteFamily.mapSingletonFlattenIso.inv.app K) ≫
        (FiniteTensor.flattenIso (V := C)).hom.app
          ((FiniteFamily.map (FiniteFamily.singleton (C := C))).obj K) =
      (FiniteTensor.tensor (V := C)).map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V
        := C))).inv.app K) := by
