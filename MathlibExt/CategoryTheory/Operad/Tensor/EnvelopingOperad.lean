    (a ≫ b ≫ c) ≫ d = a ≫ b ≫ c ≫ d := by
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original two-unit tensor source and original unit
maps contract to the original unary operation, with its actual
sigma-unit total input bijection retained. -/
theorem retainedRootUnitTensor_substitution (O : ColoredOperadObj W C) (c : W) :
    retainedRootUnitTensorSource (C := C) ≫ (FiniteTensor.tensor (V :=
      C)).map (retainedRootUnitFamilyMap O c) ≫
        O.subst.app (retainedRootAlgebraDatum c) ≫ O.toCollection.map
          (retainedRootAlgebraTotalHom c) =
      O.unit c := by
  have h := congrArg (fun f => f ≫ (O.subst.app (retainedRootAlgebraDatum c) ≫
    O.toCollection.map (retainedRootAlgebraTotalHom c))) (retainedRootUnitTensorSource_factors O c)
  exact (Category.assoc _ _ _).symm.trans (h.trans (retainedRootUnitSource_substitution O c))

