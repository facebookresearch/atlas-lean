/- Exact checked source: OuterWeightedMaps. -/
section EnvelopingSource017


/-!
# Outer and branch maps on the actual weighted tensor normalization

The root coefficient uses the original extended-profile map. Branches use
the full operation factor and tensor functors, so their original output
transports and input color maps remain present.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Outer

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual weighted family map under the original outer bijection
and every original full branch-profile arrow. -/
def weightedBranchMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    frozenWeightedBranchFamily O B P Q R ⟶ frozenWeightedBranchFamily O B P Q' S where
  equiv := Equiv.optionCongr g.equiv
  hom i := match i with
    | none => O.map (extendProfileMap (𝟙 P) g)
    | some j => (operationSummandFunctor O B).map (h j)

/-- Expand the root map through the actual singleton functor and
every branch through the actual full-profile operation factor functor. -/
def weightedNestedMap (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    frozenWeightedNestedFamily O B P Q R ⟶ frozenWeightedNestedFamily O B P Q' S where
  equiv := Equiv.optionCongr g.equiv
  hom i := match i with
    | none => (FiniteFamily.singleton (C := C)).map (O.map (extendProfileMap (𝟙 P) g))
    | some j => (operationFactorsFunctor O B).map (h j)

/-- Every total algebra leaf uses its original color-preserving map
under the actual dependent-sum outer/branch input bijection. -/
def algebraLeavesMap (B : W → C) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    frozenAlgebraLeaves B Q R ⟶ frozenAlgebraLeaves B Q' S :=
  (addedAlgebraInputs B).map (totalInputsMap g h)

/-- The actual singleton root unitor commutes with the original
root coefficient map and every original weighted branch tensor map. -/
theorem weightedRootIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (frozenWeightedRootIso O B P Q R).hom ≫
        (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (weightedNestedMap O B P g h) =
      weightedBranchMap O B P g h ≫ (frozenWeightedRootIso O B P Q' S).hom := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i <;> rfl
  · intro i
    cases i with
    | none =>
      change HEq ((FiniteTensor.singletonIso (V := C)).inv.app (O.obj (extendProfile P Q)) ≫
        (FiniteTensor.tensor (V := C)).map
          ((FiniteFamily.singleton (C := C)).map (O.map (extendProfileMap (𝟙 P) g))))
        (O.map (extendProfileMap (𝟙 P) g) ≫
          (FiniteTensor.singletonIso (V := C)).inv.app (O.obj (extendProfile P Q')))
      exact heq_of_eq ((FiniteTensor.singletonIso (V := C)).inv.naturality
        (O.map (extendProfileMap (𝟙 P) g))).symm
    | some j =>
      change HEq (𝟙 _ ≫ (operationSummandFunctor O B).map (h j))
        ((operationSummandFunctor O B).map (h j) ≫ 𝟙 _)
      exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)

omit [FiniteTensor C] in
/-- The exact original coefficient/algebra-leaf bijection is natural
under every outer and branch map, retaining root coefficients, branch
coefficients, and all dependent-sum input-color transports. -/
theorem branchLeafIso_naturality (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) {Q Q' : ColoredInputs W} (g : Q ⟶ Q')
    {R : FrozenBranchTuple Q} {S : FrozenBranchTuple Q'} (h : BranchArrows g R S) :
    (FiniteFamily.flatten (C := C)).map (weightedNestedMap O B P g h) ≫
        (frozenBranchLeafIso O B P Q' S).hom =
      (frozenBranchLeafIso O B P Q R).hom ≫ (FiniteFamily.flatten (C := C)).map
        (coefficientLeavesNestedMap (coefficientMap O P g h) (algebraLeavesMap B g h)) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => rfl
    | some i => cases j <;> rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none =>
      change HEq (O.map (extendProfileMap (𝟙 P) g) ≫ 𝟙 _)
        (𝟙 _ ≫ O.map (extendProfileMap (𝟙 P) g))
      exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
    | some i =>
      cases j with
      | none =>
        change HEq (O.map (h i) ≫ 𝟙 _) (𝟙 _ ≫ O.map (h i))
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)
      | some j =>
        change HEq (eqToHom (congrArg B ((h i).inputColor_eq j)) ≫ 𝟙 _)
          (𝟙 _ ≫ eqToHom (congrArg B ((h i).inputColor_eq j)))
        exact heq_of_eq ((Category.comp_id _).trans (Category.id_comp _).symm)


end CategoryTheory.Operad.Tensor.Enveloping.Outer

end
