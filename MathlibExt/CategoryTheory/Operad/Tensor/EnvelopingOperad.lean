  let a := T.map (FiniteFamily.mapSingletonFlattenIso.inv.app K)
  let b := (FiniteTensor.flattenIso (V := C)).hom.app
    ((FiniteFamily.map (FiniteFamily.singleton (C := C))).obj K)
  let h := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app K)
