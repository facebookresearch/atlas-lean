section EnvelopingSource157


/-!
# Actual singleton tensor coefficient/input interchange
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem singletonInterchangeProjectionFiring {V : Type*} [Category* V]
    {X A B D E R Y : V} (a : X ⟶ A) (b : A ⟶ B) (n : B ⟶ D)
    (p : D ⟶ E) (q : E ⟶ Y) (r : B ⟶ R) (n' : R ⟶ E) (s : R ⟶ Y)
    (g : A ⟶ Y) (h1 : r ≫ n' = n ≫ p) (h2 : n' ≫ q = s) (h3 : b ≫ r ≫ s = g) :
    (a ≫ b ≫ n) ≫ p ≫ q = a ≫ g := by
  simp only [Category.assoc]
  rw [← Category.assoc n p q, ← h1, Category.assoc r n' q, h2, h3]

private theorem singletonInterchangeMapThree {V D : Type*} [Category* V] [Category* D]
    (T : V ⥤ D) {A B C E : V} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) :
    T.map a ≫ T.map b ≫ T.map c = T.map (a ≫ b ≫ c) := by
  rw [← T.map_comp b c, ← T.map_comp a (b ≫ c)]

private theorem singletonInterchangeInversePrefix {V : Type*} [Category* V]
    {X A Y : V} (e : X ≅ A) (z : X ⟶ Y) (q : A ⟶ Y)
    (h : z = e.hom ≫ q) : e.inv ≫ z = q := by
  rw [h, ← Category.assoc, e.inv_hom_id, Category.id_comp]

private theorem singletonInterchangeCancelPost {V : Type*} [Category* V]
    {X A Y : V} (a : X ⟶ A) (b : X ⟶ Y) (e : A ≅ Y)
    (h : a ≫ e.hom = b) : a = b ≫ e.inv := by
  have h' := congrArg (· ≫ e.inv) h
  simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id] using h'

variable {C : Type u} [Category.{v} C] [FiniteTensor C]

/-- Original singleton block interchange, followed by the
actual leaf correction and coefficient singleton collapse,
is the original weighted singleton tensor collapse. -/
theorem coefficientBlockInterchange_singleton_projection (X : C) (L : FiniteFamily C) :
    (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _ => L)).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          (𝟙 ((FiniteTensor.tensor (V := C)).obj ((FiniteFamily.singleton (C := C)).obj X)))
          (singletonCoefficientInputLeafIso L).hom) ≫
        (coefficientLeafTensorFunctor L).map ((FiniteTensor.singletonIso (V := C)).hom.app X) =
      (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let K := (FiniteFamily.singleton (C := C)).obj X
  let M := totalBlockInputs (FintypeCat.of PUnit) (fun _ => L)
  let l := (singletonCoefficientInputLeafIso L).hom
  let j := (coefficientBlockInterchangeFamilyIso (FintypeCat.of PUnit) (fun _ => X) (fun _
    => L)).hom
  let r := F.map (coefficientLeavesNestedMap (𝟙 K) l)
  let s := F.map (singletonCoefficientLeavesIso X L).hom ≫
    FiniteFamily.mapSingletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj X)
  let a := (FiniteTensor.flattenIso (V := C)).inv.app
    (combinedInputBlocks (FintypeCat.of PUnit) (fun _ => X) (fun _ => L))
  let b := T.map j
  let n := coefficientLeavesNormalization K M
  let p := T.map (coefficientLeafMap (𝟙 (T.obj K)) l)
  let q := (coefficientLeafTensorFunctor L).map ((FiniteTensor.singletonIso (V := C)).hom.app X)
  let n' := coefficientLeavesNormalization K L
  let g := T.map (FiniteFamily.singletonFlattenIso.hom.app ((coefficientLeafFamilyFunctor L).obj X))
  have hid : T.map (𝟙 K) = 𝟙 (T.obj K) := T.map_id K
  have h1 : T.map r ≫ n' = n ≫ p :=
    (congrArg (fun coeff => T.map r ≫ n' = n ≫ T.map (coefficientLeafMap coeff l)) hid).mp
      (coefficientLeavesNormalization_naturality (𝟙 K) l)
  have h2 : n' ≫ q = T.map s := coefficientLeavesNormalization_singleton X L
  have h3 : b ≫ T.map r ≫ T.map s = g :=
    (singletonInterchangeMapThree T j r s).trans
      (congrArg T.map (singletonCoefficientInputRawMap X L))
  have h := singletonInterchangeProjectionFiring a b n p q (T.map r) n' (T.map s) g h1 h2 h3
  let e := (FiniteTensor.flattenIso (V := C)).app
    ((FiniteFamily.singleton (C := FiniteFamily C)).obj ((coefficientLeafFamilyFunctor L).obj X))
  have hflat : a ≫ g =
      (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X) :=
    singletonInterchangeInversePrefix e g
      ((FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X))
      (singletonFlattenLaw_app ((coefficientLeafFamilyFunctor L).obj X))
  have hread : (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit)
      (fun _ => X) (fun _ => L)).hom = a ≫ b ≫ n := by
    change a ≫ b ≫ (coefficientLeavesNormalizationIso K M).hom = a ≫ b ≫ n
    rw [coefficientLeavesNormalizationIso_hom]
  exact (congrArg (fun z => z ≫ p ≫ q) hread).trans (h.trans hflat)

/-- Original singleton coefficient/input interchange is exactly
the original weighted singleton unitor followed by the original
coefficient singleton inverse, with all original leaf positions corrected. -/
theorem coefficientBlockInterchange_singleton (X : C) (L : FiniteFamily C) :
    (coefficientBlockInterchangeTensorIso (FintypeCat.of PUnit) (fun _ => X) (fun _ => L)).hom ≫
        (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          (𝟙 ((FiniteTensor.tensor (V := C)).obj ((FiniteFamily.singleton (C := C)).obj X)))
          (singletonCoefficientInputLeafIso L).hom) =
      (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X) ≫
        (coefficientLeafTensorFunctor L).map ((FiniteTensor.singletonIso (V := C)).inv.app X) := by
  exact singletonInterchangeCancelPost _ _
    ((coefficientLeafTensorFunctor L).mapIso ((FiniteTensor.singletonIso (V := C)).app X))
    ((Category.assoc _ _ _).trans (coefficientBlockInterchange_singleton_projection X L))


end CategoryTheory.Operad.Tensor.Enveloping

end
