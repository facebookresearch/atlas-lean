/- Exact checked source: LinearAlgebra.MixedEvaluation. -/
section EnvelopingSource234


/-!
# Evaluation of original coefficients with every constant and variable leaf
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

private theorem mixedMapThree {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C Y : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ Y) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem mixedAppendMap {D : Type*} [Category* D]
    {X A B E Y : D} (n : X ⟶ A) (a : A ⟶ B) (b : B ⟶ E) (o : E ⟶ Y)
    (f : A ⟶ E) (h : f = a ≫ b) : n ≫ f ≫ o = (n ≫ a) ≫ b ≫ o := by
  rw [h]
  simp only [Category.assoc]

private theorem mixedAppendThree {D : Type*} [Category* D]
    {X A B E F Y : D} (n : X ⟶ A) (a : A ⟶ B) (b : B ⟶ E) (c : E ⟶ F)
    (o : F ⟶ Y) (f : A ⟶ F) (h : f = a ≫ b ≫ c) :
    n ≫ f ≫ o = n ≫ a ≫ b ≫ c ≫ o := by
  rw [h]
  simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The original O operation receives the exact original coefficient,
the original constant leaves through g and every original variable leaf. -/
def representativeJoinedFactors (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (coefficientLeafFamilyFunctor (leafJoin ((addedAlgebraInputs B).obj Q)
      (profileLeafFamily M P))).obj
      (O.obj (extendProfile P Q)) ⟶ (analyticFactors O M).obj (profileInputs
        (extendProfile P Q)) where
  equiv :=
    { toFun p := match p with
        | none => none
        | some (Sum.inl j) => some (Sum.inr j)
        | some (Sum.inr i) => some (Sum.inl i)
      invFun p := match p with
        | none => none
        | some (Sum.inl i) => some (Sum.inr i)
        | some (Sum.inr j) => some (Sum.inl j)
      left_inv p := by cases p with
        | none => rfl
        | some p => cases p <;> rfl
      right_inv p := by cases p with
        | none => rfl
        | some p => cases p <;> rfl }
  hom p := match p with
    | none => 𝟙 (O.obj (extendProfile P Q))
    | some (Sum.inl j) => g (Q.obj j).as
    | some (Sum.inr i) => 𝟙 (M (P.inputColor i))

/-- The original raw coefficient/constant/variable input map is the
original joined scalar map after its exact original leaf bijection. -/
theorem representativeFactors_join (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) (P : ColoredProfile W) (Q : ColoredInputs W) :
    (leafJoinScalarRawIso (O.obj (extendProfile P Q)) ((addedAlgebraInputs B).obj Q)
      (profileLeafFamily M P)).hom ≫ representativeJoinedFactors O B M g P Q =
    representativeFactors O B M g P Q := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j <;> rfl
    | some _ => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none => exact heq_of_eq (Category.id_comp _)
      | some j => exact heq_of_eq (Category.id_comp (g (Q.obj j).as))
    | some i => cases j; exact heq_of_eq (Category.id_comp _)

/-- The original map of all original constant and variable leaves
into the original extended total O-profile, retaining its actual
full dependent profile bijection and color transports. -/
def evaluationTotalLeafMap (B M : W → C) (g : B ⟶ M) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    evaluationLeafFamily B M s Q ⟶
      profileLeafFamily M (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q)) :=
  evaluationLeafMap B M g s Q ≫ (profileLeafIso M (envelopingRepresentativeTotalHom s Q)).hom

/-- The actual original total-profile representative uses the exact
joined original leaves, original variable/constant profile map and
original coefficient/leaf target factor comparison. -/
theorem representativeJoinedFactors_total (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    coefficientLeafMap (𝟙 (O.obj (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))))
        (evaluationLeafJoinIso B M s Q).hom ≫
    coefficientLeafMap (𝟙 (O.obj (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))))
        (evaluationTotalLeafMap B M g s Q) ≫
    (profileOperationFactorsIso O M (extendProfile s.totalProfile
      (envelopingTotalAlgebraInputs s Q))).hom =
    representativeJoinedFactors O B M g s.totalProfile (envelopingTotalAlgebraInputs s Q) := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p with
    | none => rfl
    | some p => cases p with
      | inl p => cases p <;> rfl
      | inr p => rfl
  · intro p
    cases p with
    | none =>
      let X := O.obj (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))
      change HEq (𝟙 X ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])
    | some p => cases p with
      | inl p => cases p with
        | inl j =>
          let X := B ((Q none).obj j).as
          let Y := M ((Q none).obj j).as
          let f : X ⟶ Y := g ((Q none).obj j).as
          change HEq (𝟙 X ≫ (f ≫ 𝟙 Y) ≫ 𝟙 Y) f
          exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
        | inr p =>
          rcases p with ⟨i, j⟩
          let X := B ((Q (some i)).obj j).as
          let Y := M ((Q (some i)).obj j).as
          let f : X ⟶ Y := g ((Q (some i)).obj j).as
          change HEq (𝟙 X ≫ (f ≫ 𝟙 Y) ≫ 𝟙 Y) f
          exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
      | inr p =>
        let X := M (s.totalProfile.inputColor p)
        change HEq (𝟙 X ≫ (𝟙 X ≫ 𝟙 X) ≫ 𝟙 X) (𝟙 X)
        exact heq_of_eq (by simp only [Category.id_comp])

variable [FiniteTensor C]

/-- Every original linear representative operation is the actual
original O operation after genuine constant/variable leaf collection. -/
theorem representativeEvaluation_join (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (P : ColoredProfile W) (Q : ColoredInputs W) :
    representativeEvaluation O B M g P Q =
      (leafJoinTensorIso (O.toCollection.obj (extendProfile P Q)) ((addedAlgebraInputs B).obj Q)
        (profileLeafFamily M.carrier P)).hom ≫
      (FiniteTensor.tensor (V := C)).map (representativeJoinedFactors O.toCollection B
        M.carrier g P Q) ≫
      M.operations.app P.outputColor (profileInputs (extendProfile P Q)) := by
  let T := FiniteTensor.tensor (V := C)
  let n := (coefficientLeavesNormalizationIso
    ((coefficientInputFactors (extendedCoefficient O.toCollection P) (addedAlgebraInputs B)).obj Q)
    (profileLeafFamily M.carrier P)).inv
  let a := T.map (leafJoinScalarRawIso (O.toCollection.obj (extendProfile P Q))
    ((addedAlgebraInputs B).obj Q) (profileLeafFamily M.carrier P)).hom
  let b := T.map (representativeJoinedFactors O.toCollection B M.carrier g P Q)
  let f := T.map (representativeFactors O.toCollection B M.carrier g P Q)
  let o := M.operations.app P.outputColor (profileInputs (extendProfile P Q))
  have hf : f = a ≫ b :=
    (congrArg T.map (representativeFactors_join O.toCollection B M.carrier g P Q).symm).trans
      (T.map_comp _ _)
  exact mixedAppendMap n a b o f hf

/-- The original total linear representative operation retains the
actual original coefficient, joined leaf comparison, total-profile
leaf map and original O-algebra operation. -/
theorem representativeEvaluation_total (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) :
    representativeEvaluation O B M g s.totalProfile (envelopingTotalAlgebraInputs s Q) =
      (leafJoinTensorIso (O.toCollection.obj (extendProfile s.totalProfile
        (envelopingTotalAlgebraInputs s Q)))
        ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q))
        (profileLeafFamily M.carrier s.totalProfile)).hom ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (O.toCollection.obj (extendProfile s.totalProfile
          (envelopingTotalAlgebraInputs s Q))))
          (evaluationLeafJoinIso B M.carrier s Q).hom) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (O.toCollection.obj (extendProfile s.totalProfile
          (envelopingTotalAlgebraInputs s Q))))
          (evaluationTotalLeafMap B M.carrier g s Q)) ≫
      (profileCoefficientLeafTensorIso O.toCollection M.carrier
        (extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q))).hom ≫
      M.operations.app s.outputColor (profileInputs (extendProfile s.totalProfile
        (envelopingTotalAlgebraInputs s Q)))
        := by
  let T := FiniteTensor.tensor (V := C)
  let P := extendProfile s.totalProfile (envelopingTotalAlgebraInputs s Q)
  let a := coefficientLeafMap (𝟙 (O.toCollection.obj P)) (evaluationLeafJoinIso B M.carrier s Q).hom
  let b := coefficientLeafMap (𝟙 (O.toCollection.obj P)) (evaluationTotalLeafMap B M.carrier g s Q)
  let c := (profileOperationFactorsIso O.toCollection M.carrier P).hom
  let j := (leafJoinTensorIso (O.toCollection.obj P)
    ((addedAlgebraInputs B).obj (envelopingTotalAlgebraInputs s Q)) (profileLeafFamily
      M.carrier s.totalProfile)).hom
  let o := M.operations.app s.outputColor (profileInputs P)
  have hf : T.map (representativeJoinedFactors O.toCollection B M.carrier g s.totalProfile
      (envelopingTotalAlgebraInputs s Q)) = T.map a ≫ T.map b ≫ T.map c :=
    (congrArg T.map (representativeJoinedFactors_total O.toCollection B M.carrier g s Q).symm).trans
      (mixedMapThree T a b c)
  exact (representativeEvaluation_join O B M g s.totalProfile (envelopingTotalAlgebraInputs
    s Q)).trans
    (mixedAppendThree j (T.map a) (T.map b) (T.map c) o
      (T.map (representativeJoinedFactors O.toCollection B M.carrier g s.totalProfile
        (envelopingTotalAlgebraInputs s Q))) hf)


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
