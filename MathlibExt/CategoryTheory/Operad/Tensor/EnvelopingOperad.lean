private theorem EnvelopingSource353_mapThree {V U : Type*} [Category* V] [Category* U]
    (T : V ⥤ U) {X Y Z D : V} (a : X ⟶ Y) (b : Y ⟶ Z) (c : Z ⟶ D) :
    T.map (a ≫ b ≫ c) = T.map a ≫ T.map b ≫ T.map c := by rw [T.map_comp, T.map_comp]

private theorem zeroPrefixFold {V : Type*} [Category* V] {X A B D : V}
    (p : X ⟶ A) (f : A ⟶ B) (g : B ⟶ D) (e : A ⟶ X) (k : X ⟶ D)
    (hp : p ≫ e = 𝟙 X) (hf : f ≫ g = e ≫ k) : (p ≫ f) ≫ g = k := by
  rw [Category.assoc, hf, ← Category.assoc p e, hp, Category.id_comp]

private theorem rootFactorFold {V : Type*} [Category* V] {U A B D K Y : V}
    (a : U ⟶ A) (i : A ⟶ B) (u : B ⟶ D) (e : D ≅ K) (eta : U ⟶ K) (out : K ⟶ Y) (r : D ⟶ Y)
    (ha : (a ≫ i) ≫ u = eta ≫ e.inv) (hr : r = e.hom ≫ out) :
    (a ≫ i) ≫ u ≫ r = eta ≫ out := by
  rw [← Category.assoc (a ≫ i) u, ha, hr]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

private theorem insertionFold {V : Type*} [Category* V] {X A B D Y E Z : V}
    (p : X ⟶ A) (a : A ⟶ B) (b : B ⟶ D) (c : D ⟶ Y)
    (r : A ⟶ E) (f : E ⟶ Y) (eta : X ⟶ Z) (q : Z ⟶ E)
    (hm : a ≫ b ≫ c = r ≫ f) (hp : p ≫ r = eta ≫ q) :
    (p ≫ a) ≫ b ≫ c = eta ≫ q ≫ f := by
  have h1 : (p ≫ a) ≫ b ≫ c = p ≫ a ≫ b ≫ c := Category.assoc p a (b ≫ c)
  have h2 : p ≫ a ≫ b ≫ c = p ≫ r ≫ f := congrArg (p ≫ ·) hm
  have h3 : p ≫ r ≫ f = eta ≫ q ≫ f := (Category.assoc p r f).symm.trans
    ((congrArg (· ≫ f) hp).trans (Category.assoc eta q f))
  exact h1.trans (h2.trans h3)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original retained coefficient family maps to the original
