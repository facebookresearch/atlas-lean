section EnvelopingSource191


/-!
# Original shape maps retain actual tensor-colimit injections
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable {s t : ColoredSubstitutionData W}

/-- The original input choices follow exactly the inverse of the
actual original root/branch slot bijection. -/
def envelopingShapeChoiceFunctor (f : s ⟶ t) : EnvelopingInputChoices s ⥤
  EnvelopingInputChoices t :=
  Pi.comap (fun _ : Option s.inner.index => ColoredInputs W) (envelopingShapeSlotEquiv f).symm

/-- The original input family at each source slot is retained
through the exact inverse-bijection equality transport. -/
def envelopingShapeCanonicalChoiceArrow (f : s ⟶ t) (Q : EnvelopingInputChoices s) :
    EnvelopingShapeChoiceArrows f Q ((envelopingShapeChoiceFunctor f).obj Q) :=
  fun i => eqToHom (congrArg Q ((envelopingShapeSlotEquiv f).symm_apply_apply i).symm)

/-- Every original linear input tensor maps at its original slot
by the actual profile/input joint map. -/
def envelopingShapeLinearFamilyMap (O : ColoredSymmetricCollection W C) (A : W → C) (f : s ⟶ t)
    {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option s.inner.index))).obj
      (fun i => (envelopingLinearSlotDiagram O A s i).obj (Q i)) ⟶
    (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option t.inner.index))).obj
      (fun i => (envelopingLinearSlotDiagram O A t i).obj (Q' i)) where
  equiv := envelopingShapeSlotEquiv f
  hom i := (linearCoefficientDiagram O A (envelopingSlotProfile s i)).map (g i) ≫
    (linearCoefficientProfileMap O A (envelopingShapeSlotProfileMap f i)).app
      (Q' (envelopingShapeSlotEquiv f i))

omit [HasColimitsOfSize.{us, us} C] [Small.{us} W] in
/-- The actual original coefficient/input representative map is
the source finite-index map after its exact identity comparison. -/
theorem envelopingShapeLinearWeightedFamilyIso_naturality (O : ColoredSymmetricCollection W
  C) (A : W → C)
    (f : s ⟶ t) {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingShapeLinearFamilyMap O A f g ≫ (envelopingLinearWeightedFamilyIso O A t Q').hom =
      (envelopingLinearWeightedFamilyIso O A s Q).hom ≫
        envelopingShapeWeightedRepresentativeMap O A f g := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      change HEq (((linearCoefficientDiagram O A s.outerProfile).map (g none) ≫
        (linearCoefficientProfileMap O A (ColoredSubstitutionData.outerProfileMap f)).app
          (Q' none)) ≫ 𝟙 _)
        (𝟙 _ ≫ (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          (O.map (extendProfileMap (ColoredSubstitutionData.outerProfileMap f) (g none)))
          ((addedAlgebraInputs A).map (g none))))
      exact heq_of_eq ((Category.comp_id _).trans
        ((linearCoefficientTensor_joint O A (ColoredSubstitutionData.outerProfileMap f) (g
          none)).trans
          (Category.id_comp _).symm))
    | some i =>
      change HEq (((linearCoefficientDiagram O A (s.inner.obj i)).map (g (some i)) ≫
        (linearCoefficientProfileMap O A (f.innerHom.hom i)).app (Q' (some (f.innerHom.equiv
          i)))) ≫ 𝟙 _)
        (𝟙 _ ≫ (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
          (O.map (extendProfileMap (f.innerHom.hom i) (g (some i))))
          ((addedAlgebraInputs A).map (g (some i)))))
      exact heq_of_eq ((Category.comp_id _).trans
        ((linearCoefficientTensor_joint O A (f.innerHom.hom i) (g (some i))).trans
          (Category.id_comp _).symm))

/-- The actual source colimit factors inject at their original slots. -/
def envelopingLinearCofanFamilyMap (O : ColoredSymmetricCollection W C) (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option s.inner.index))).obj
      (fun i => (envelopingLinearSlotDiagram O A s i).obj (Q i)) ⟶
    (ColoredOperadObj.substitutionFactors (linearCoefficientCollection O A)).obj s where
  equiv := Equiv.refl (Option s.inner.index)
  hom i := match i with
    | none => linearCoefficientι O A s.outerProfile (Q none)
    | some i => linearCoefficientι O A (s.inner.obj i) (Q (some i))

/-- The genuine linear substitution source injection is the
tensor of the actual original linear coefficient injections. -/
theorem envelopingLinearSubstitutionInjection_readback (O : ColoredSymmetricCollection W C)
  (A : W → C)
    (s : ColoredSubstitutionData W) (Q : EnvelopingInputChoices s) :
    envelopingLinearSubstitutionInjection O A s Q =
      (FiniteTensor.tensor (V := C)).map (envelopingLinearCofanFamilyMap O A s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let e : (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option s.inner.index))).obj
      (fun i => (envelopingLinearSlotCocone O A s i).pt) ≅
      (ColoredOperadObj.substitutionFactors (linearCoefficientCollection O A)).obj s :=
    FiniteFamily.isoOfComponents (Equiv.refl (Option s.inner.index))
      (fun i => match i with | none => Iso.refl _ | some _ => Iso.refl _)
  have h : (FiniteFamily.fixedIndexFunctor (C := C) (FintypeCat.of (Option s.inner.index))).map
        (fun i => (envelopingLinearSlotCocone O A s i).ι.app (Q i)) ≫
        e.hom =
      envelopingLinearCofanFamilyMap O A s Q := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none => exact heq_of_eq (Category.comp_id _)
      | some i => exact heq_of_eq (Category.comp_id _)
  exact (T.map_comp _ _).symm.trans (congrArg T.map h)

/-- The actual tensor-colimit cofan respects every full shape/profile
map, retaining all original coefficient-slot and algebra-input bijections. -/
theorem envelopingShapeCofanFamily_naturality (O : ColoredSymmetricCollection W C) (A : W → C)
    (f : s ⟶ t) {Q : EnvelopingInputChoices s} {Q' : EnvelopingInputChoices t}
    (g : EnvelopingShapeChoiceArrows f Q Q') :
    envelopingShapeLinearFamilyMap O A f g ≫ envelopingLinearCofanFamilyMap O A t Q' =
      envelopingLinearCofanFamilyMap O A s Q ≫
        (ColoredOperadObj.substitutionFactors (linearCoefficientCollection O A)).map f := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      exact heq_of_eq (by
        change ((linearCoefficientDiagram O A s.outerProfile).map (g none) ≫
          (linearCoefficientProfileMap O A (ColoredSubstitutionData.outerProfileMap f)).app
            (Q' none)) ≫
          linearCoefficientι O A t.outerProfile (Q' none) = _
        exact (congrArg (· ≫ linearCoefficientι O A t.outerProfile (Q' none))
          (linearCoefficientTensor_joint O A (ColoredSubstitutionData.outerProfileMap f) (g
            none))).trans
            (linearCoefficientι_joint O A (ColoredSubstitutionData.outerProfileMap f) (g none)))
    | some i =>
      exact heq_of_eq (by
        change ((linearCoefficientDiagram O A (s.inner.obj i)).map (g (some i)) ≫
          (linearCoefficientProfileMap O A (f.innerHom.hom i)).app (Q' (some
            (f.innerHom.equiv i)))) ≫
          linearCoefficientι O A (t.inner.obj (f.innerHom.equiv i)) (Q' (some
            (f.innerHom.equiv i))) = _
        exact (congrArg (· ≫ linearCoefficientι O A (t.inner.obj (f.innerHom.equiv i))
          (Q' (some (f.innerHom.equiv i)))) (linearCoefficientTensor_joint O A
            (f.innerHom.hom i) (g (some i)))).trans
            (linearCoefficientι_joint O A (f.innerHom.hom i) (g (some i))))


