        (congrArg (fun c => coefficientLeafMap (T.map c) m) hk).trans
          (middleNormalizedFactors_hom O B d Q).symm
      have hn := interchangeAfterCoefficientMap I k.hom L m
      have hs := weightedMiddleSource_hom O B d Q
      exact heq_of_eq ((congrArg (fun s => T.map s ≫ n ≫ p) hs).trans
        (hn.trans (congrArg (fun f => n₀ ≫ T.map f) hf)))
    | some p =>
      let T := FiniteTensor.tensor (V := C)
      let X := O.obj (extendProfile ((d.localData p.1).inner.obj p.2)
        (Q.branch p.1 (some p.2)))
      let L := (addedAlgebraInputs B).obj (Q.branch p.1 (some p.2))
