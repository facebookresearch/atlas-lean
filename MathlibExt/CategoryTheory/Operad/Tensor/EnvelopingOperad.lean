      (retainedRootUnitFamilyIso (C := C)).hom = retainedRootPrefixNormalizer (C := C) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.comp_id _)
    | some i => exact heq_of_eq (Category.comp_id _)

/-- The actual source two-unit tensor prefix is the genuine
finite tensor-unit insertion, through its exact original option-position bijection. -/
theorem retainedRootUnitTensorSource_normalized :
    retainedRootUnitTensorSource (C := C) =
      (FiniteTensor.singletonIso (V := C)).inv.app ((FiniteTensor.tensor (V :=
        C)).obj FiniteFamily.empty) ≫
        (frozenVariableTensorUnitIso (FintypeCat.of PUnit)
          ((FiniteFamily.singleton (C := C)).obj ((FiniteTensor.tensor (V :=
            C)).obj FiniteFamily.empty))).hom ≫
        (FiniteTensor.tensor (V := C)).map
          (Unit.rightUnitPositionIso ((FiniteTensor.tensor (V :=
            C)).obj FiniteFamily.empty) (FintypeCat.of PUnit)).hom
