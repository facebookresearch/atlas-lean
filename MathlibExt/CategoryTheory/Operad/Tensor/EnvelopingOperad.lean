/- Exact checked source: LinearAlgebra.OriginalOperations. -/
section EnvelopingSource221


/-!
# Original O-operations recovered from linear constant-input operations
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory Limits

private theorem joinTwoNormalizations {V : Type*} [Category* V]
    {X A B D Y : V} (n : X ⟶ A) (a : A ⟶ B) (b : B ⟶ Y)
    (r : X ⟶ D) (m : D ⟶ B) (s : D ⟶ Y)
    (h1 : n ≫ a = r ≫ m) (h2 : m ≫ b = s) : n ≫ (a ≫ b) = r ≫ s := by
  rw [← Category.assoc n a, h1, Category.assoc r m, h2]

private theorem appendOriginalProfile {V : Type*} [Category* V]
    {X A B D Y : V} (n : X ⟶ A) (a : A ⟶ B) (b : B ⟶ D) (p : D ⟶ Y)
    (r : X ⟶ B) (h : n ≫ a = r) : n ≫ (a ≫ b) ≫ p = r ≫ b ≫ p := by
  simp only [Category.assoc]
  rw [← Category.assoc n a, h]

private theorem originalOperationEvaluationFiring {V : Type*} [Category* V]
    {X A B C D E Y : V} (n : X ⟶ A) (h : A ⟶ B) (a : A ⟶ C) (b : C ⟶ B)
    (p : B ⟶ D) (o : D ⟶ Y) (r : X ⟶ C) (f : X ⟶ E) (l : E ⟶ D) (k : E ⟶ Y)
    (hh : h = a ≫ b) (hn : n ≫ a = r) (hr : r ≫ b ≫ p = f ≫ l) (ho : l ≫ o = k) :
    n ≫ h ≫ p ≫ o = f ≫ k := by
  calc
    n ≫ h ≫ p ≫ o = n ≫ a ≫ b ≫ p ≫ o := by rw [hh]; simp only [Category.assoc]
    _ = (n ≫ a) ≫ b ≫ p ≫ o := by simp only [Category.assoc]
    _ = r ≫ b ≫ p ≫ o := congrArg (fun q => q ≫ b ≫ p ≫ o) hn
    _ = (r ≫ b ≫ p) ≫ o := by simp only [Category.assoc]
    _ = (f ≫ l) ≫ o := congrArg (· ≫ o) hr
    _ = f ≫ k := (Category.assoc _ _ _).trans (congrArg (f ≫ ·) ho)

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original no-constant raw input map, retaining the
actual empty constant family and every variable input. -/
def emptyRepresentativeRawMap (O : ColoredSymmetricCollection W C) (B M : W → C)
    (P : ColoredProfile W) :
    (FiniteFamily.flatten (C := C)).obj
        (coefficientLeavesNested
          ((coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).obj
            emptyColoredInputs)
          (profileLeafFamily M P)) ⟶
      (coefficientLeafFamilyFunctor (profileLeafFamily M P)).obj (O.obj (extendProfile P
        emptyColoredInputs)) :=
  (FiniteFamily.flatten (C := C)).map
      (coefficientLeavesNestedMap (emptyLinearFactorsIso O B P).hom (𝟙 (profileLeafFamily M P))) ≫
    (emptyConstantRawIso (O.obj (extendProfile P emptyColoredInputs)) (profileLeafFamily M P)).hom

omit [FiniteTensor C] in
/-- The actual empty-input tensor coordinates coincide with the
original full-profile map into P, keeping every variable input. -/
theorem emptyRepresentativeRawMap_profile (O : ColoredSymmetricCollection W C) (B M : W → C)
    (g : B ⟶ M) (P : ColoredProfile W) :
    emptyRepresentativeRawMap O B M P ≫
        (coefficientLeafFamilyFunctor (profileLeafFamily M P)).map (O.map
          (emptyExtensionProfileHom P)) ≫
        (profileOperationFactorsIso O M P).hom =
      representativeFactors O B M g P emptyColoredInputs ≫
        (operationFactorsFunctor O M).map (emptyExtensionProfileHom P) := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none => rfl
      | some j => cases j
    | some i => cases j; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j with
      | none =>
        let f := O.map (emptyExtensionProfileHom P)
        change HEq ((𝟙 _ ≫ 𝟙 _) ≫ f ≫ 𝟙 _) (𝟙 _ ≫ f)
        exact heq_of_eq (by simp only [Category.id_comp, Category.comp_id])
      | some j => cases j
    | some i =>
      cases j
      let X := M (P.inputColor i)
      change HEq ((𝟙 X ≫ 𝟙 X) ≫ 𝟙 X ≫ 𝟙 X) (𝟙 X ≫ 𝟙 X)
      exact heq_of_eq (by simp only [Category.id_comp])

/-- Normalization of the actual empty added-input summand is
the original raw coefficient/variable map followed by its original
empty-leaf unitor, with no normalization outcome premise. -/
theorem emptyRepresentativeNormalization (O : ColoredSymmetricCollection W C) (B M : W → C)
    (P : ColoredProfile W) :
    (coefficientLeavesNormalizationIso
      ((coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).obj
        emptyColoredInputs)
      (profileLeafFamily M P)).hom ≫
        (coefficientLeafTensorFunctor (profileLeafFamily M P)).map
          ((FiniteTensor.tensor (V := C)).map (emptyLinearFactorsIso O B P).hom ≫
            (emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs))).hom) =
      (FiniteTensor.tensor (V := C)).map (emptyRepresentativeRawMap O B M P) := by
  let T := FiniteTensor.tensor (V := C)
  let F := FiniteFamily.flatten (C := C)
  let L := profileLeafFamily M P
  let K := (coefficientInputFactors (extendedCoefficient O P) (addedAlgebraInputs B)).obj
    emptyColoredInputs
  let X := O.obj (extendProfile P emptyColoredInputs)
  let K' := (coefficientLeafFamilyFunctor (FiniteFamily.empty : FiniteFamily C)).obj X
  let k := (emptyLinearFactorsIso O B P).hom
  let n := (coefficientLeavesNormalizationIso K L).hom
  let a := (coefficientLeafTensorFunctor L).map (T.map k)
  let b := (coefficientLeafTensorFunctor L).map (emptyLeafTensorIso X).hom
  let r := T.map (F.map (coefficientLeavesNestedMap k (𝟙 L)))
  let m := (coefficientLeavesNormalizationIso K' L).hom
  let s := T.map (emptyConstantRawIso X L).hom
  have hid : T.map (coefficientLeafMap (T.map k) (𝟙 L)) = a :=
    congrArg T.map (coefficientLeafMap_idLeaves (T.map k) L)
  have h1 : n ≫ a = r ≫ m :=
    (congrArg (· ≫ a) (coefficientLeavesNormalizationIso_hom K L)).trans
      (((congrArg (coefficientLeavesNormalization K L ≫ ·) hid).symm.trans
        (coefficientLeavesNormalization_naturality k (𝟙 L)).symm).trans
        (congrArg (r ≫ ·) (coefficientLeavesNormalizationIso_hom K' L)).symm)
  have h2 : m ≫ b = s := emptyConstantNormalization X L
  have h := joinTwoNormalizations n a b r m s h1 h2
  have hu : (coefficientLeafTensorFunctor L).map (T.map k ≫ (emptyLeafTensorIso X).hom) = a ≫ b :=
    (coefficientLeafTensorFunctor L).map_comp _ _
  exact (congrArg (n ≫ ·) hu).trans (h.trans (T.map_comp _ _).symm)

/-- The empty added-input evaluation is precisely the original
O-algebra operation after the original empty-summand coefficient
comparison, retaining its complete variable input tensor. -/
theorem emptyRepresentativeEvaluation (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (P : ColoredProfile W) :
    (coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)).map
      (emptyLinearSummandIso O.toCollection B P).hom ≫
        (profileCoefficientLeafTensorIso O.toCollection M.carrier P).hom ≫
        M.operations.app P.outputColor (profileInputs P) =
      representativeEvaluation O B M g P emptyColoredInputs := by
  let T := FiniteTensor.tensor (V := C)
  let U := coefficientLeafTensorFunctor (profileLeafFamily M.carrier P)
  let K := (coefficientInputFactors (extendedCoefficient O.toCollection P)
    (addedAlgebraInputs B)).obj
    emptyColoredInputs
  let e := coefficientLeavesNormalizationIso K (profileLeafFamily M.carrier P)
  let a := T.map (emptyLinearFactorsIso O.toCollection B P).hom ≫
    (emptyLeafTensorIso (O.toCollection.obj (extendProfile P emptyColoredInputs))).hom
  let b := U.map (O.toCollection.map (emptyExtensionProfileHom P))
  let p := (profileCoefficientLeafTensorIso O.toCollection M.carrier P).hom
  let r := T.map (emptyRepresentativeRawMap O.toCollection B M.carrier P)
  let op := M.operations.app P.outputColor (profileInputs P)
  let factor := T.map (representativeFactors O.toCollection B M.carrier g P emptyColoredInputs)
  let relabel := (operationSummandFunctor O.toCollection M.carrier).map (emptyExtensionProfileHom P)
  have hsum : (emptyLinearSummandIso O.toCollection B P).hom =
      a ≫ O.toCollection.map (emptyExtensionProfileHom P) := (Category.assoc _ _ _).symm
  have hs : U.map (emptyLinearSummandIso O.toCollection B P).hom = U.map a ≫ b :=
    (congrArg U.map hsum).trans (U.map_comp _ _)
  have hn : e.hom ≫ U.map a = r := emptyRepresentativeNormalization O.toCollection B M.carrier P
  let r₀ := emptyRepresentativeRawMap O.toCollection B M.carrier P
  let b₀ := (coefficientLeafFamilyFunctor (profileLeafFamily M.carrier P)).map
    (O.toCollection.map (emptyExtensionProfileHom P))
  let p₀ := (profileOperationFactorsIso O.toCollection M.carrier P).hom
  have hmap : r ≫ b ≫ p = T.map (r₀ ≫ b₀ ≫ p₀) :=
    (congrArg (T.map r₀ ≫ ·) (T.map_comp b₀ p₀).symm).trans (T.map_comp r₀ (b₀ ≫ p₀)).symm
  have hr : r ≫ b ≫ p = factor ≫ relabel :=
    hmap.trans ((congrArg T.map (emptyRepresentativeRawMap_profile O.toCollection B
      M.carrier g P)).trans
      (T.map_comp _ _))
  have hop : relabel ≫ op = M.operations.app P.outputColor (profileInputs (extendProfile P
    emptyColoredInputs)) :=
    (M.operations.profile_equivariance (emptyExtensionProfileHom P)).trans (Category.comp_id _)
  apply (cancel_epi e.hom).1
  have h0 : e.hom ≫ (U.map (emptyLinearSummandIso O.toCollection B P).hom ≫ p ≫ op) =
      factor ≫ M.operations.app P.outputColor (profileInputs (extendProfile P
        emptyColoredInputs)) :=
    originalOperationEvaluationFiring e.hom (U.map (emptyLinearSummandIso O.toCollection B P).hom)
      (U.map a) b p op r factor relabel
      (M.operations.app P.outputColor (profileInputs (extendProfile P emptyColoredInputs)))
        hs hn hr hop
  exact h0.trans (representativeEvaluation_normalized O B M g P emptyColoredInputs).symm


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

end
end EnvelopingSource221

/- Exact checked source: LinearAlgebra.OriginalRecovery. -/
section EnvelopingSource222


/-!
# The original operation inclusion recovers every original O operation
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory Limits

private theorem originalRecoveryFiring {V : Type*} [Category* V]
    {X S A B C Y : V} (e : X ⟶ S) (a : S ⟶ A) (op : A ⟶ Y)
    (u : X ⟶ B) (i : B ⟶ C) (e' : C ⟶ A) (ev : B ⟶ Y) (old : S ⟶ Y)
    (hinc : e ≫ a = (u ≫ i) ≫ e') (hb : (i ≫ e') ≫ op = ev) (hu : u ≫ ev = e ≫ old) :
    e ≫ (a ≫ op) = e ≫ old :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ op) hinc).trans
      ((show ((u ≫ i) ≫ e') ≫ op = u ≫ ((i ≫ e') ≫ op) by simp only [Category.assoc]).trans
        ((congrArg (u ≫ ·) hb).trans hu)))

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original coefficient collection map commutes with its
exact original analytic coefficient/input factor comparison. -/
theorem coefficientCollectionSquare {O O' : ColoredSymmetricCollection W C}
    (alpha : O ⟶ O') (M : W → C) {d : W} (P : AnalyticIndex W d) :
    (profileCoefficientLeafTensorIso O M P.toColoredProfile).hom ≫
        (analyticSummandCollectionMap M alpha).app P =
      (coefficientLeafTensorFunctor (profileLeafFamily M P.toColoredProfile)).map (alpha.app
        P.toColoredProfile) ≫
        (profileCoefficientLeafTensorIso O' M P.toColoredProfile).hom := by
  let T := FiniteTensor.tensor (V := C)
  have h : (profileOperationFactorsIso O M P.toColoredProfile).hom ≫
      (analyticFactorsCollectionMap M alpha).app P =
    (coefficientLeafFamilyFunctor (profileLeafFamily M P.toColoredProfile)).map (alpha.app
      P.toColoredProfile) ≫
      (profileOperationFactorsIso O' M P.toColoredProfile).hom := by
    apply FiniteFamily.Hom_ext
    · rfl
    · intro i
      cases i with
      | none => exact heq_of_eq ((Category.id_comp _).trans (Category.comp_id _).symm)
      | some i => rfl
  exact (T.map_comp _ _).symm.trans ((congrArg T.map h).trans (T.map_comp _ _))

variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

/-- Every original O operation is recovered through the original
operation inclusion and the constructed constant-input operation,
with the exact original coefficient and variable tensor maps. -/
theorem originalOperation_recovery (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (d : W) (P : AnalyticIndex W d) :
    (analyticSummandCollectionMap M.carrier (originalOperationToLinearMap O.toCollection B)).app P ≫
        (linearOperations O B M g).app d P = M.operations.app d P := by
  let U := coefficientLeafTensorFunctor (profileLeafFamily M.carrier P.toColoredProfile)
  let e := profileCoefficientLeafTensorIso O.toCollection M.carrier P.toColoredProfile
  let E := operationProfileIso O.toCollection B M.carrier P
  let k := emptyLinearSummandIso O.toCollection B P.toColoredProfile
  let i := linearCoefficientι O.toCollection B P.toColoredProfile emptyColoredInputs
  let a := (analyticSummandCollectionMap M.carrier (originalOperationToLinearMap
    O.toCollection B)).app P
  let op := (linearOperations O B M g).app d P
  let ev := representativeEvaluation O B M g P.toColoredProfile emptyColoredInputs
  let old := M.operations.app d P
  have he : U.map k.hom ≫ (e.hom ≫ old) = ev := emptyRepresentativeEvaluation O B M g
    P.toColoredProfile
  have hk : U.map k.inv ≫ U.map k.hom = 𝟙 _ :=
    (U.map_comp _ _).symm.trans ((congrArg U.map k.inv_hom_id).trans (U.map_id _))
  have hke : U.map k.inv ≫ ev = e.hom ≫ old :=
    (congrArg (U.map k.inv ≫ ·) he.symm).trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (e.hom ≫
        old)) hk).trans (Category.id_comp _)))
  have hi : (U.map i ≫ E.hom) ≫ op = ev := operationApp_beta O B M g d P emptyColoredInputs
  have hinc : e.hom ≫ a = (U.map k.inv ≫ U.map i) ≫ E.hom :=
    (coefficientCollectionSquare (originalOperationToLinearMap O.toCollection B) M.carrier P).trans
      (congrArg (· ≫ E.hom) (U.map_comp k.inv i))
  apply (cancel_epi e.hom).1
  exact originalRecoveryFiring e.hom a op (U.map k.inv) (U.map i) E.hom ev old hinc hi hke


