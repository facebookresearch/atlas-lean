/-!
# Actual slot evaluations and the original weighted constants substitution law
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

open CategoryTheory

private theorem mapThreeSlotEvaluation {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem insideWeightedFiring {V : Type*} [Category* V] {W A B C D E F G H J K L M N P Q : V}
    (w : W ⟶ D) (u : W ⟶ A) (e : A ⟶ B) (a : B ⟶ C) (b : C ⟶ D)
    (flat : D ⟶ E) (eval : E ⟶ F) (r : F ⟶ H) (h : H ⟶ K) (first : K ⟶ P) (σ : P ⟶ Q)
    (flat' : C ⟶ L) (m : L ⟶ E) (s : L ⟶ M) (q : M ⟶ G) (outF : G ⟶ H)
    (hGen : G ⟶ J) (outT : J ⟶ K) (firstGen : J ⟶ N) (target : N ⟶ P) (direct : A
      ⟶ N) (literal : W ⟶ P)
    (hw : w = u ≫ e ≫ a ≫ b) (hflat : b ≫ flat = flat' ≫ m)
    (heval : m ≫ eval ≫ r = s ≫ q ≫ outF) (hout : outF ≫ h = hGen ≫ outT)
    (hfirst : outT ≫ first = firstGen ≫ target)
    (hdirect : e ≫ a ≫ flat' ≫ s ≫ q ≫ hGen ≫ firstGen = direct) (hliteral : u
      ≫ direct ≫ target = literal) :
    w ≫ ((flat ≫ eval) ≫ (r ≫ h ≫ first ≫ σ)) = literal ≫ σ := by
  calc
    w ≫ ((flat ≫ eval) ≫ (r ≫ h ≫ first ≫ σ)) = u ≫ e ≫ a ≫ b ≫ flat
      ≫ eval ≫ r ≫ h ≫ first ≫ σ := by
      rw [hw]
      simp only [Category.assoc]
    _ = u ≫ e ≫ a ≫ (b ≫ flat) ≫ eval ≫ r ≫ h ≫ first ≫ σ := by simp only [Category.assoc]
    _ = u ≫ e ≫ a ≫ (flat' ≫ m) ≫ eval ≫ r ≫ h ≫ first ≫ σ :=
      congrArg (fun b => u ≫ e ≫ a ≫ b ≫ eval ≫ r ≫ h ≫ first ≫
      σ) hflat
    _ = u ≫ e ≫ a ≫ flat' ≫ (m ≫ eval ≫ r) ≫ h ≫ first ≫ σ := by simp only [Category.assoc]
    _ = u ≫ e ≫ a ≫ flat' ≫ (s ≫ q ≫ outF) ≫ h ≫ first ≫ σ :=
      congrArg (fun b => u ≫ e ≫ a ≫ flat' ≫ b ≫ h ≫ first ≫ σ)
      heval
    _ = u ≫ e ≫ a ≫ flat' ≫ s ≫ q ≫ (outF ≫ h) ≫ first ≫ σ := by simp only [Category.assoc]
    _ = u ≫ e ≫ a ≫ flat' ≫ s ≫ q ≫ (hGen ≫ outT) ≫ first ≫ σ :=
      congrArg (u ≫ e ≫ a ≫ flat' ≫ s ≫ q ≫ · ≫ first ≫ σ)
      hout
    _ = u ≫ e ≫ a ≫ flat' ≫ s ≫ q ≫ hGen ≫ (outT ≫ first) ≫ σ := by simp only [Category.assoc]
    _ = u ≫ e ≫ a ≫ flat' ≫ s ≫ q ≫ hGen ≫ (firstGen ≫ target) ≫ σ :=
      congrArg (u ≫ e ≫ a ≫ flat' ≫ s ≫ q ≫ hGen ≫ · ≫
      σ) hfirst
    _ = u ≫ (e ≫ a ≫ flat' ≫ s ≫ q ≫ hGen ≫ firstGen) ≫ target ≫ σ := by simp only [Category.assoc]
    _ = u ≫ direct ≫ target ≫ σ := congrArg (u ≫ · ≫ target ≫ σ) hdirect
    _ = (u ≫ direct ≫ target) ≫ σ := by simp only [Category.assoc]
    _ = literal ≫ σ := congrArg (· ≫ σ) hliteral

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Genuine tensor regrouping identifies the complete original inside route
with the tensor of literal constants representatives at every original substitution slot. -/
theorem weightedInsideRoute_original (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    (weightedSourceToRawIso E.toCollection s Q).hom ≫ insideRoute E s Q =
      (FiniteTensor.tensor (V := C)).map (Slots.literalSlotFamily E s Q) ≫ E.subst.app s := by
  let T := FiniteTensor.tensor (V := C)
  let I := s.inner.index
  let L := Slots.rootFamily E.toCollection s Q
  let M := Slots.branchFamily E.toCollection s Q
  let X := E.toCollection.obj s.outerProfile
  let Y := fun i => E.toCollection.obj (s.inner.obj i)
  let f := Slots.rootEvaluation E s Q
  let g := Slots.branchEvaluation E s Q
  let w := (weightedSourceToRawIso E.toCollection s Q).hom
  let u := T.map ((FiniteFamily.map T).map (Slots.weightedIso E.toCollection s Q).hom)
  let e := (FiniteTensor.flattenIso (V := C)).inv.app (Slots.groups E.toCollection s Q)
  let a := T.map (RootTensor.sourceToSplitIso I L M).hom
  let b := T.map ((FiniteFamily.flatten (C := C)).map (Slots.splitIso E.toCollection s Q).hom)
  let flat := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q)
  let eval := T.map (branchEvaluationFactorMap E s Q)
  let r := T.map (Root.rawSourceIsoB E.toCollection s (Q none)).hom
  let h := (FiniteTensor.flattenIso (V := C)).hom.app (Root.rawGroupsB E.toCollection s (Q none))
  let first := T.map (Root.firstFactorMap E s (Q none))
  let σ := E.subst.app s
  let flat' := (FiniteTensor.flattenIso (V := C)).hom.app (RootTensor.splitGroups I L M)
  let m := T.map ((FiniteFamily.map T).map (Slots.splitIso E.toCollection s Q).hom)
  let s' := T.map (RootTensor.splitEvaluation I L M Y g)
  let q := T.map (RootTensor.regroupOutputIso I L Y).hom
  let outF := T.map ((FiniteFamily.flatten (C := C)).map (Slots.outputGroupsIso
    E.toCollection s Q).hom)
  let hGen := (FiniteTensor.flattenIso (V := C)).hom.app (RootTensor.rootOutputGroups I L Y)
  let outT := T.map ((FiniteFamily.map T).map (Slots.outputGroupsIso E.toCollection s Q).hom)
  let firstGen := T.map (RootTensor.rootOutputEvaluation I L X Y f)
  let target := T.map (Slots.targetIso E.toCollection s).hom
  let direct := T.map (RootTensor.directEvaluation I L M X Y f g)
  let literal := T.map (Slots.literalSlotFamily E s Q)
  have hw : w = u ≫ e ≫ a ≫ b := Slots.sourceToRaw_tensor E.toCollection s Q
  have hflat : b ≫ flat = flat' ≫ m := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (Slots.splitIso E.toCollection
    s Q).hom
  have heval : m ≫ eval ≫ r = s' ≫ q ≫ outF := (mapThreeSlotEvaluation T _ _ _).symm.trans
    ((congrArg T.map (Slots.splitEvaluation_relabel E s Q)).trans (mapThreeSlotEvaluation T _ _ _))
  have hout : outF ≫ h = hGen ≫ outT := (FiniteTensor.flattenIso (V :=
    C)).hom.naturality (Slots.outputGroupsIso
    E.toCollection s Q).hom
  have hfirst : outT ≫ first = firstGen ≫ target := (T.map_comp _ _).symm.trans
    ((congrArg T.map (Slots.outputFactor_readback E s Q).symm).trans (T.map_comp _ _))
  have hdirect : e ≫ a ≫ flat' ≫ s' ≫ q ≫ hGen ≫ firstGen = direct :=
    RootTensor.rootSplitTensor I L M X Y f g
  have hliteral : u ≫ direct ≫ target = literal := (mapThreeSlotEvaluation T _ _ _).symm.trans
    (congrArg T.map (Slots.directFactor_readback E s Q))
  exact (congrArg (w ≫ ·) (insideRoute_rootContract E s Q)).trans
    (insideWeightedFiring w u e a b flat eval r h first σ flat' m s' q outF hGen outT
      firstGen target direct literal
      hw hflat heval hout hfirst hdirect hliteral)

/-- The target's original operad laws prove the literal full weighted
representative substitution law for its actual constants evaluator. -/
theorem representative_constant_substitution (E : ColoredOperadObj W C) (s :
  ColoredSubstitutionData W) (Q :
  EnvelopingInputChoices s) :
    envelopingRepresentativeEvaluation E (nullaryCarrier E.toCollection) s Q ≫
      Constants.representative (𝟙 E) (nullaryCarrier E.toCollection)
        (fun c => 𝟙 (E.toCollection.obj (ColoredProfile.nullary c))) s.totalProfile
          (envelopingTotalAlgebraInputs s Q) =
    (FiniteTensor.tensor (V := C)).map (Slots.literalSlotFamily E s Q) ≫ E.subst.app s :=
  (weightedOutsideRoute_original E s Q).symm.trans
    ((congrArg ((weightedSourceToRawIso E.toCollection s Q).hom ≫
      ·) (insideRoute_eq_outside E s Q).symm).trans
      (weightedInsideRoute_original E s Q))


end CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Branch

