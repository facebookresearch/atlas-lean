  apply (cancel_epi eQ.hom).1
  have hn : eQ.hom ≫ operationπ f g A.carrier q =
      (coefficientLeafTensorFunctor ((analyticInputFamily A.carrier).obj q)).map
        (coefficientπ f g q.toColoredProfile) ≫ eE.hom :=
    (coefficientAnalyticIso_naturality (collectionπ f g) A.carrier q).symm
  change eQ.hom ≫ (operationπ f g A.carrier q ≫ (eE.inv ≫ δ)) = eQ.hom ≫ A.operations.app d q
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ (eE.inv ≫ δ)) hn).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (_ ≫ ·) (eE.hom_inv_id_assoc δ)).trans
          (coefficientTensorDesc_beta f g t hf hg _ _ _ _))))

/-- All original analytic-profile equivariance descends by the original coefficient projection. -/
theorem operationApp_equivariance (A : Tensor.Algebra Q) (balance : Balanced f g A) (d : W)
    {q r : AnalyticIndex W d} (k : q ⟶ r) :
    (analyticSummand (collection f g) A.carrier).map k ≫ operationApp f g t hf hg A balance d r =
      operationApp f g t hf hg A balance d q := by
  have := operationπ_epi f g t hf hg A.carrier q
  apply (cancel_epi (operationπ f g A.carrier q)).1
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ operationApp f g t hf hg A balance d r)
      ((analyticSummandCollectionMap A.carrier (collectionπ f g)).naturality k).symm).trans
      ((Category.assoc _ _ _).trans
        ((congrArg ((analyticSummand Q.toCollection A.carrier).map k ≫ ·)
          (operationApp_beta f g t hf hg A balance d r)).trans
          ((A.operations.equivariance d k).trans (operationApp_beta f g t hf hg A balance d
            q).symm))))

/-- The full genuine equivariant tensor operation family of the quotient. -/
def descendedOperations (A : Tensor.Algebra Q) (balance : Balanced f g A) :
    Operations (collection f g) A.carrier A.carrier where
  app := operationApp f g t hf hg A balance
  equivariance := operationApp_equivariance f g t hf hg A balance

/-- Restriction along the actual full quotient projection recovers every original Q-operation. -/
theorem descendedOperations_restrict (A : Tensor.Algebra Q) (balance : Balanced f g A) :
    Restriction.operations (projection f g t hf hg) (descendedOperations f g t hf hg A balance) =
      A.operations := by
  apply Operations.ext
  funext d q
  exact operationApp_beta f g t hf hg A balance d q


