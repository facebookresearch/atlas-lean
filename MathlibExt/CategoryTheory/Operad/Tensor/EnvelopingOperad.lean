/- Exact checked source: EnvelopingRepresentativeCoefficientAssociativity. -/
section EnvelopingSource119


/-!
# Actual original representative coefficient associativity

Both routes use the original operad substitutions, original input
profiles, every original tensor-unit insertion and the exact
variable/algebra-input dependent-sum corrections.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

private theorem originalRouteBFiveAssoc {V : Type*} [Category* V]
    {X A B D E Y : V} (p : X ⟶ A) (q : A ⟶ B) (s : B ⟶ D) (t : D ⟶ E) (u : E ⟶ Y) :
    (p ≫ (q ≫ (s ≫ t))) ≫ u = (p ≫ q) ≫ s ≫ (t ≫ u) := by simp only [Category.assoc]

private theorem originalRouteBPostcompose {V : Type*} [Category* V]
    {X A B D E F Y : V} (p : X ⟶ A) (a : A ⟶ B) (n : B ⟶ D) (c : D ⟶ E)
    (s : E ⟶ F) (t : F ⟶ Y) (r : X ⟶ E)
    (h : p ≫ a ≫ n ≫ c = r) : p ≫ a ≫ n ≫ c ≫ s ≫ t = r ≫ s ≫ t := by
  have h1 := congrArg (· ≫ (s ≫ t)) h
  simpa only [Category.assoc] using h1

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original second O-association route on its actual
nested coefficient/unit source is exactly the original root-first
representative route, including the original total input corrections. -/
theorem envelopingAssocNestedRouteB_isRepresentative (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocNestedCommonSource O d Q ≫
        ColoredOperadObj.associativityRouteB O.toCollection O.subst
          (envelopingRepresentativeAssoc d Q) ≫
        O.toCollection.map (envelopingAssocTotalHom d Q) =
      envelopingAssocRepresentativeRouteB O d Q := by
  let T := FiniteTensor.tensor (V := C)
  let p := envelopingAssocExpandedInput O.toCollection d Q
  let a := T.map (envelopingAssocExpandedGroupingIso O.toCollection d Q).hom
  let n := (FiniteTensor.flattenIso (V := C)).hom.app (envelopingAssocExpandedGroupingB
    O.toCollection d Q)
  let c := T.map (envelopingAssocExpandedContractionMap O d Q)
  let s := O.subst.app (envelopingRepresentativeSubstitution d.innerData
    (envelopingAssocInnerChoices d Q))
  let t := O.toCollection.map (envelopingRepresentativeTotalHom d.innerData
    (envelopingAssocInnerChoices d Q)) ≫
    O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q))
  let r := envelopingAssocRootFirstContraction O d Q ≫
    envelopingRepresentativeCoefficientTensorMap O d.innerData (envelopingAssocInnerChoices d Q)
  have h := originalRouteBPostcompose p a n c s t r (envelopingAssocExpandedRootFirstSource O d Q)
  have hcoeff : envelopingRepresentativeCoefficientSubstitution O d.innerData
    (envelopingAssocInnerChoices d Q) =
      envelopingRepresentativeCoefficientTensorMap O d.innerData (envelopingAssocInnerChoices d Q) ≫
      (s ≫ O.toCollection.map (envelopingRepresentativeTotalHom d.innerData
        (envelopingAssocInnerChoices d Q))) := rfl
  have hread : envelopingAssocRepresentativeRouteB O d Q = r ≫ s ≫ t := by
    have h1 := congrArg (fun f => (envelopingAssocRootFirstContraction O d Q ≫ f) ≫
      O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d
        Q))) hcoeff
    exact (Category.assoc (envelopingAssocRootFirstContraction O d Q)
      (envelopingRepresentativeCoefficientSubstitution O d.innerData
        (envelopingAssocInnerChoices d Q))
      (O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap
        d Q)))).symm.trans
      (h1.trans (originalRouteBFiveAssoc (envelopingAssocRootFirstContraction O d Q)
      (envelopingRepresentativeCoefficientTensorMap O d.innerData
        (envelopingAssocInnerChoices d Q)) s
      (O.toCollection.map (envelopingRepresentativeTotalHom d.innerData
        (envelopingAssocInnerChoices d Q)))
      (O.toCollection.map (extendProfileMap d.totalHom (envelopingAssocFlatAlgebraInputsMap d Q)))))
  exact (envelopingAssocExpandedRouteB_factorization O d Q).symm.trans (h.trans hread.symm)

/-- The complete actual original representative coefficient
substitution satisfies associativity on every original finite
three-level profile, with all original empty profiles and unit maps. -/
theorem envelopingRepresentativeCoefficient_assoc (O : ColoredOperadObj W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    envelopingAssocRepresentativeRouteA O d Q = envelopingAssocRepresentativeRouteB O d Q :=
  (envelopingAssocNestedRouteA_isRepresentative O d Q).symm.trans
    ((envelopingAssocNestedOriginalLaw O d Q).trans
      (envelopingAssocNestedRouteB_isRepresentative O d Q))


end CategoryTheory.Operad.Tensor.Enveloping

end
