        | inl p => cases p <;> exact ⟨rfl, rfl⟩
        | inr p => cases p <;> exact ⟨rfl, rfl⟩
      have he : (emptyAndRetainedFlattenIso (envelopingAssocInnerRootInputs d Q).index
        (envelopingAssocRootFirstCoefficientBlocks O d Q)).hom.HasIdentityComponents := by
        apply finiteFamilyIso_identityComponents
        intro p
        rcases p with ⟨i, j⟩
        cases i with
        | inl i => exact j.elim
        | inr i => exact ⟨rfl, rfl⟩
      exact (FiniteFamily.Hom.HasIdentityComponents.flatten
        (finiteFamilyIso_inv_identityComponents _ hr)).comp he
    exact (finiteFamilyIso_inv_identityComponents _ h1).comp (h2.comp h3)
  · apply finiteFamilyIso_identityComponents
    intro p
    rcases p with ⟨i, j⟩
    cases i with
