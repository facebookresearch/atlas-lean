/-!
# The genuine linear-algebra nullary action is the original O free-profile action on actual
constants
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory Limits

private theorem inverseCofanFold {V : Type*} [Category* V] {L T X A : V}
    (e : L ≅ T) (n : X ≅ A) (i : X ⟶ L) (p : A ⟶ T)
    (hi : i ≫ e.hom = n.hom ≫ p) : p ≫ e.inv = n.inv ≫ i := by
  apply (cancel_mono e.hom).1
  have h1 : (p ≫ e.inv) ≫ e.hom = p := (Category.assoc p e.inv e.hom).trans
    ((congrArg (p ≫ ·) e.inv_hom_id).trans (Category.comp_id p))
  have h2 : (n.inv ≫ i) ≫ e.hom = p := (Category.assoc n.inv i e.hom).trans
    ((congrArg (n.inv ≫ ·) hi).trans ((Category.assoc n.inv n.hom p).symm.trans
      ((congrArg (· ≫ p) n.inv_hom_id).trans (Category.id_comp p))))
  exact h1.trans h2.symm

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

local instance (d : W) : HasColimitsOfShape (AnalyticIndex W d) C :=
  hasProfileColimitsOfSmallColors C d

namespace LinearAlgebraNullary

omit [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C] in
/-- Every original free-profile cofan enters the original linear nullary
coefficient through exactly the inverse original diagram comparison and original coefficient
cofan. -/
theorem nullaryLinearInverse_cofan (O : ColoredSymmetricCollection W C) (B : W →
  C) (d : W) (Q : ColoredInputs W) :
    profileι O B ((inputsToProfile d).obj Q) ≫ (nullaryLinearCoefficientIso O B d).inv =
      (nullaryLinearDiagramIso O B d).inv.app Q ≫ linearCoefficientι O B
        (ColoredProfile.nullary d) Q :=
  inverseCofanFold (nullaryLinearCoefficientIso O B d) ((nullaryLinearDiagramIso O B d).app Q)
    (linearCoefficientι O B (ColoredProfile.nullary d) Q) (profileι O B ((inputsToProfile d).obj Q))
    (nullaryLinearCoefficientIso_ι O B d Q)

/-- The genuine original linear algebra's nullary operation on each
original coefficient cofan is precisely its original O/constant representative evaluation. -/
theorem coefficientInjection_nullary (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) (d : W) (Q : ColoredInputs W) :
    linearCoefficientι O.toCollection B (ColoredProfile.nullary d) Q ≫
      FrozenAlgebra.nullaryEvaluation M d =
      (nilLeafUnitor M.carrier d ((linearCoefficientDiagram O.toCollection B
        (ColoredProfile.nullary d)).obj Q)).inv ≫
        LinearAlgebra.representativeEvaluation O B (linearAlgebraUnderlying O B M)
          (linearAlgebraConstants O B M)
          (ColoredProfile.nullary d) Q := by
  let L := envelopingLinearOperad O B
  let MO := linearAlgebraUnderlying O B M
  let g := linearAlgebraConstants O B M
  let U := coefficientLeafTensorFunctor (profileLeafFamily M.carrier (ColoredProfile.nullary d))
  let X := (linearCoefficientDiagram O.toCollection B (ColoredProfile.nullary d)).obj Q
  let i := linearCoefficientι O.toCollection B (ColoredProfile.nullary d) Q
  let a := (nilLeafUnitor M.carrier d X).inv
  let b := U.map i
  let u := (nilLeafUnitor M.carrier d (L.toCollection.obj (ColoredProfile.nullary d))).inv
  let p := (profileCoefficientLeafTensorIso L.toCollection M.carrier (ColoredProfile.nullary d)).hom
  let n := (nullarySummandIso L.toCollection M.carrier d).inv
  let j := LinearAlgebra.operationInjection O.toCollection B M.carrier
    (AnalyticIndex.nullary (d := d)) Q
  let o := M.operations.app d AnalyticIndex.nullary
  let ev := LinearAlgebra.representativeEvaluation O B MO g (ColoredProfile.nullary d) Q
  have ha : a ≫ b = i ≫ u := nilLeafUnitor_inv_naturality M.carrier d i
  have hu : u ≫ p = n := nilLeafUnitor_profile L.toCollection M.carrier d
  have hj : j = b ≫ p := FrozenAlgebra.operationInjection_readback O.toCollection B
    M.carrier (AnalyticIndex.nullary (d
    := d)) Q
  have hsource : a ≫ j = i ≫ n := (congrArg (a ≫ ·) hj).trans
    ((Category.assoc a b p).symm.trans ((congrArg (· ≫ p) ha).trans
      ((Category.assoc i u p).trans (congrArg (i ≫ ·) hu))))
  have he : j ≫ o = ev :=
    (congrArg (fun ops : Operations L.toCollection M.carrier M.carrier =>
      ops.app d AnalyticIndex.nullary |> (j ≫ ·))
      (linearAlgebra_operations O B M)).trans (LinearAlgebra.linearOperations_beta O B MO g
        d AnalyticIndex.nullary Q)
  exact (Category.assoc i n o).symm.trans ((congrArg (· ≫ o) hsource.symm).trans
    ((Category.assoc a j o).trans (congrArg (a ≫ ·) he)))

end LinearAlgebraNullary

/-- The original free-profile nullary comparison followed by a genuine
linear algebra's original nullary operation is exactly its original O-algebra
action on the actual original computed constants. No action equation is an input. -/
theorem linearAlgebra_nullary_action (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) (d : W) :
    (nullaryLinearCoefficientIso O.toCollection B d).inv ≫ FrozenAlgebra.nullaryEvaluation M d =
      profileMap O.toCollection (linearAlgebraConstants O B M) d ≫
        (linearAlgebraUnderlying O B M).action d := by
  let MO := linearAlgebraUnderlying O B M
  let g := linearAlgebraConstants O B M
  let e := (nullaryLinearCoefficientIso O.toCollection B d).inv
  let delta := FrozenAlgebra.nullaryEvaluation M d
  apply colimit.hom_ext
  intro P
  let Q := ConstantActionExtension.branchInputs P
  let i := profileι O.toCollection B P
  let a := (nullaryLinearDiagramIso O.toCollection B d).inv.app Q
  let j := linearCoefficientι O.toCollection B (ColoredProfile.nullary d) Q
  let u := (LinearAlgebraNullary.nilLeafUnitor M.carrier d ((linearCoefficientDiagram
    O.toCollection B
    (ColoredProfile.nullary d)).obj Q)).inv
  let ev := LinearAlgebra.representativeEvaluation O B MO g (ColoredProfile.nullary d) Q
  let c := (analyticSummandCarrierMap O.toCollection g).app P
  let o := MO.operations.app d P
  have h1 : i ≫ e = a ≫ j := LinearAlgebraNullary.nullaryLinearInverse_cofan O.toCollection B d Q
  have h2 : j ≫ delta = u ≫ ev := LinearAlgebraNullary.coefficientInjection_nullary O B M d Q
  have h3 : a ≫ u ≫ ev = c ≫ o := LinearAlgebraNullary.representative_nullary O B MO g d Q
  have hl : i ≫ e ≫ delta = c ≫ o := (Category.assoc i e delta).symm.trans
    ((congrArg (· ≫ delta) h1).trans ((Category.assoc a j delta).trans ((congrArg (a ≫
      ·) h2).trans h3)))
  let p := profileMap O.toCollection g d
  let act := MO.action d
  let i' := profileι O.toCollection MO.carrier P
  have hr : i ≫ p ≫ act = c ≫ o := (Category.assoc i p act).symm.trans
    ((congrArg (· ≫ act) (profileι_map O.toCollection g P)).trans
      ((Category.assoc c i' act).trans (congrArg (c ≫ ·) (MO.action_operation d P))))
  exact hl.trans hr.symm

/-- The complete original colorwise nullary-action map retains the
whole original profileMap and genuine original O action. -/
theorem linearAlgebra_nullary_action_family (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra (envelopingLinearOperad O B)) :
    (fun d => (nullaryLinearCoefficientIso O.toCollection B d).inv ≫
      FrozenAlgebra.nullaryEvaluation M d) =
      profileMap O.toCollection (linearAlgebraConstants O B M) ≫
        (linearAlgebraUnderlying O B M).action := by
  funext d
  exact linearAlgebra_nullary_action O B M d


end CategoryTheory.Operad.Tensor.Enveloping

end
