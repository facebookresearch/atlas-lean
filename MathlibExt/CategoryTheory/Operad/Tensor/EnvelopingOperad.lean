/- Exact checked source: ConstantActionExtensionNormalization. -/
section EnvelopingSource329


/-!
# The full original weighted constant-input face is its literal rooted evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

open CategoryTheory

private theorem normalizedSourcePost {D : Type*} [Category* D]
    {X A B C E Y : D} (p : X ⟶ A) (r : A ⟶ B) (n : B ⟶ C) (q : C ⟶ E)
    (f : E ⟶ Y) (k : C ⟶ Y) (a : X ⟶ E) (hk : k = q ≫ f) (ha : p ≫ r ≫ n ≫ q = a) :
    p ≫ r ≫ n ≫ k = a ≫ f := by
  rw [hk]
  simpa only [Category.assoc] using congrArg (· ≫ f) ha

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The actual original weighted constant-input operad extension
evaluates precisely the original rooted O substitution, with every
original coefficient, variable unit, B leaf and total profile map retained. -/
theorem weightedRepresentative_normalization (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (frozenVariableTensorUnitIso P.inputs (frozenWeightedBranchFamily O.toCollection B P Q R)).hom ≫
      (FiniteTensor.tensor (V := C)).map (weightedInsertion O B P Q R) ≫
      envelopingRepresentativeEvaluation O B (shape P Q) (choices P Q R) ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (O.toCollection.map (totalProfileHom P Q R))
          ((addedAlgebraInputs B).map (totalInputsIso P Q R).hom)) =
    frozenWeightedBranchEvaluation O B P Q R := by
  let T := FiniteTensor.tensor (V := C)
  let p := T.map (frozenVariableFlattenIso P.inputs (frozenWeightedBranchFamily
    O.toCollection B P Q R)).inv
  let r := T.map ((FiniteFamily.flatten (C := C)).map (groupedWeightedSourceIso
    O.toCollection B P Q R).hom)
  let n := Grouping.flatAtomicNormalization (coefficientGrouping O.toCollection P Q R)
    (atomicLeaves O.toCollection B P
    Q R)
  let a := T.map (frozenVariableFlattenIso P.inputs (frozenCoefficientFamily O.toCollection
    P Q R)).hom
  let ell := groupedTotalLeafMap O B P Q R
  let q := T.map (coefficientLeafMap a ell)
  let c := frozenPartialSubstitution O P Q R
  let f := (coefficientLeafTensorFunctor (frozenAlgebraLeaves B Q R)).map c
  let k := T.map (coefficientLeafMap (a ≫ c) ell)
  let b := (frozenBranchTensorNormalizationIso O.toCollection B P Q R).hom
  have hk : k = q ≫ f := (congrArg T.map (coefficientLeafMap_post a c ell).symm).trans
    (T.map_comp _ _)
  have ha : p ≫ r ≫ n ≫ q = b := AtomicNormalization.atomicSource_normalized_actualLeaves O B P Q R
  exact (weightedRepresentative_groupedNormalization O B P Q R).trans
    (normalizedSourcePost p r n q f k b hk ha)


end CategoryTheory.Operad.Tensor.Enveloping.ConstantActionExtension

end
