/- Exact checked source: WeightedNormalization.UnitInsertionNaturality. -/
section EnvelopingSource186


/-!
# Naturality of the exact original right and left insertion prefixes
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

private theorem prefixThreeSquares {D : Type*} [Category* D]
    {X X' A A' B B' E E' : D}
    (l : X ⟶ X') (a : X ⟶ A) (a' : X' ⟶ A') (f : A ⟶ A')
    (b : A ⟶ B) (b' : A' ⟶ B') (g : B ⟶ B') (c : B ⟶ E) (c' : B' ⟶ E') (h : E ⟶ E')
    (ha : l ≫ a' = a ≫ f) (hb : f ≫ b' = b ≫ g) (hc : g ≫ c' = c ≫ h) :
    l ≫ (a' ≫ b' ≫ c') = (a ≫ b ≫ c) ≫ h := by
  rw [← Category.assoc l a', ha, Category.assoc a f, ← Category.assoc f b', hb,
    Category.assoc b g, hc]
  simp only [Category.assoc]

private theorem insertFromPrefixSquare {D : Type*} [Category* D] {X Y A B E F : D}
    (f : X ⟶ Y) (p : X ⟶ A) (q : Y ⟶ B) (n : A ⟶ B)
    (a : A ⟶ E) (b : B ⟶ F) (g : E ⟶ F)
    (hp : f ≫ q = p ≫ n) (ha : n ≫ b = a ≫ g) :
    f ≫ (q ≫ b) = (p ≫ a) ≫ g := by
  rw [← Category.assoc f q, hp, Category.assoc p n, ha, ← Category.assoc p a]

variable {C : Type w} [Category.{v} C]

/-- Map the singleton root of a right unit prefix while fixing its empty branch families. -/
def rightRootMap {X Y : C} (f : X ⟶ Y) (I : FintypeCat.{0}) :
    UnitInsertion.rightNestedFamily X I ⟶ UnitInsertion.rightNestedFamily Y I where
  equiv := Equiv.refl (Option I)
  hom i := match i with
    | none => (FiniteFamily.singleton (C := C)).map f
    | some _ => 𝟙 FiniteFamily.empty

/-- Map the singleton branch of a left unit prefix while fixing its empty root family. -/
def leftRootMap {X Y : C} (f : X ⟶ Y) :
    UnitInsertion.leftNestedFamily X ⟶ UnitInsertion.leftNestedFamily Y where
  equiv := Equiv.refl (Option PUnit)
  hom i := match i with
    | none => 𝟙 FiniteFamily.empty
    | some _ => (FiniteFamily.singleton (C := C)).map f

theorem rightRootMap_embedding {X Y : C} (f : X ⟶ Y) (I : FintypeCat.{0}) :
    (FiniteFamily.singleton (C := C)).map f ≫ UnitInsertion.rightSingletonToFlatten Y I =
      UnitInsertion.rightSingletonToFlatten X I ≫ (FiniteFamily.flatten (C :=
        C)).map (rightRootMap f I) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i
    exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)

theorem leftRootMap_embedding {X Y : C} (f : X ⟶ Y) :
    (FiniteFamily.singleton (C := C)).map f ≫ UnitInsertion.leftSingletonToFlatten Y =
      UnitInsertion.leftSingletonToFlatten X ≫ (FiniteFamily.flatten (C :=
        C)).map (leftRootMap f) := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i
    exact heq_of_eq ((Category.comp_id f).trans (Category.id_comp f).symm)

variable [FiniteTensor C]

/-- The original right prefix is natural in the complete original
coefficient object map and keeps every original tensor-unit position. -/
theorem rightPrefix_naturality {X Y : C} (f : X ⟶ Y) (I : FintypeCat.{0}) :
    f ≫ UnitInsertion.rightInsertPrefix Y I =
      UnitInsertion.rightInsertPrefix X I ≫ (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rightRootMap f I)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.singletonIso (V := C)).inv.app X
  let a' := (FiniteTensor.singletonIso (V := C)).inv.app Y
  let h := T.map ((FiniteFamily.singleton (C := C)).map f)
  let b := T.map (UnitInsertion.rightSingletonToFlatten X I)
  let b' := T.map (UnitInsertion.rightSingletonToFlatten Y I)
  let g := T.map ((FiniteFamily.flatten (C := C)).map (rightRootMap f I))
  let c := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.rightNestedFamily X I)
  let c' := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.rightNestedFamily Y I)
  let k := T.map ((FiniteFamily.map T).map (rightRootMap f I))
  have ha : f ≫ a' = a ≫ h := (FiniteTensor.singletonIso (V := C)).inv.naturality f
  have hb : h ≫ b' = b ≫ g := (T.map_comp _ _).symm.trans
    ((congrArg T.map (rightRootMap_embedding f I)).trans (T.map_comp _ _))
  have hc : g ≫ c' = c ≫ k := (FiniteTensor.flattenIso (V := C)).hom.naturality (rightRootMap f I)
  exact prefixThreeSquares f a a' h b b' g c c' k ha hb hc

/-- The original left prefix is natural in the complete original
coefficient object map and keeps its actual empty/singleton blocks. -/
theorem leftPrefix_naturality {X Y : C} (f : X ⟶ Y) :
    f ≫ UnitInsertion.leftInsertPrefix Y =
      UnitInsertion.leftInsertPrefix X ≫ (FiniteTensor.tensor (V := C)).map
        ((FiniteFamily.map (FiniteTensor.tensor (V := C))).map (leftRootMap f)) := by
  let T := FiniteTensor.tensor (V := C)
  let a := (FiniteTensor.singletonIso (V := C)).inv.app X
  let a' := (FiniteTensor.singletonIso (V := C)).inv.app Y
  let h := T.map ((FiniteFamily.singleton (C := C)).map f)
  let b := T.map (UnitInsertion.leftSingletonToFlatten X)
  let b' := T.map (UnitInsertion.leftSingletonToFlatten Y)
  let g := T.map ((FiniteFamily.flatten (C := C)).map (leftRootMap f))
  let c := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.leftNestedFamily X)
  let c' := (FiniteTensor.flattenIso (V := C)).hom.app (UnitInsertion.leftNestedFamily Y)
  let k := T.map ((FiniteFamily.map T).map (leftRootMap f))
  have ha : f ≫ a' = a ≫ h := (FiniteTensor.singletonIso (V := C)).inv.naturality f
  have hb : h ≫ b' = b ≫ g := (T.map_comp _ _).symm.trans
    ((congrArg T.map (leftRootMap_embedding f)).trans (T.map_comp _ _))
  have hc : g ≫ c' = c ≫ k := (FiniteTensor.flattenIso (V := C)).hom.naturality (leftRootMap f)
  exact prefixThreeSquares f a a' h b b' g c c' k ha hb hc

theorem rightInsertion_naturality {X Y : C} (f : X ⟶ Y) (I : FintypeCat.{0})
    {A B : FiniteFamily C} (a : UnitInsertion.rightTensorFamily X I ⟶ A)
    (b : UnitInsertion.rightTensorFamily Y I ⟶ B) (g : A ⟶ B)
    (ha : (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (rightRootMap f I) ≫ b = a ≫ g) :
    f ≫ UnitInsertion.rightInsertFromFactor Y I b =
      UnitInsertion.rightInsertFromFactor X I a ≫ (FiniteTensor.tensor (V := C)).map g := by
  let T := FiniteTensor.tensor (V := C)
  have hb : T.map ((FiniteFamily.map T).map (rightRootMap f I)) ≫ T.map b = T.map a ≫ T.map g :=
    (T.map_comp _ _).symm.trans ((congrArg T.map ha).trans (T.map_comp _ _))
  exact insertFromPrefixSquare f (UnitInsertion.rightInsertPrefix X I)
    (UnitInsertion.rightInsertPrefix Y I)
    (T.map ((FiniteFamily.map T).map (rightRootMap f I))) (T.map a) (T.map b) (T.map g)
    (rightPrefix_naturality f I) hb

theorem leftInsertion_naturality {X Y : C} (f : X ⟶ Y)
    {A B : FiniteFamily C} (a : UnitInsertion.leftTensorFamily X ⟶ A)
    (b : UnitInsertion.leftTensorFamily Y ⟶ B) (g : A ⟶ B)
    (ha : (FiniteFamily.map (FiniteTensor.tensor (V := C))).map (leftRootMap f) ≫ b = a ≫ g) :
    f ≫ UnitInsertion.leftInsertFromFactor Y b =
      UnitInsertion.leftInsertFromFactor X a ≫ (FiniteTensor.tensor (V := C)).map g := by
  let T := FiniteTensor.tensor (V := C)
  have hb : T.map ((FiniteFamily.map T).map (leftRootMap f)) ≫ T.map b = T.map a ≫ T.map g :=
    (T.map_comp _ _).symm.trans ((congrArg T.map ha).trans (T.map_comp _ _))
  exact insertFromPrefixSquare f (UnitInsertion.leftInsertPrefix X)
    (UnitInsertion.leftInsertPrefix Y)
    (T.map ((FiniteFamily.map T).map (leftRootMap f))) (T.map a) (T.map b) (T.map g)
    (leftPrefix_naturality f) hb


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
end EnvelopingSource186

/- Exact checked source: WeightedNormalization.EmptyUnitSummands. -/
section EnvelopingSource187


/-!
# Original empty summand inverses used by the actual linear unit
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

omit [FiniteTensor C] in
/-- The exact inverse no-added-input factor comparison retains the
original coefficient identity and actual inverse empty leaf map. -/
theorem emptyLinearFactorsIso_inv (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) :
    (emptyLinearFactorsIso O B P).inv =
      coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
        (emptyAddedAlgebraInputsIso B).inv := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => exact heq_of_eq (Category.id_comp _)
    | some i => cases i

/-- The original no-added-input tensor inverse has exactly its
original coefficient-profile inverse, original empty-leaf inverse, and
actual inverse mapped-empty input-family comparison. -/
theorem emptyLinearSummandIso_inv (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) :
    (emptyLinearSummandIso O B P).inv =
      O.map (emptyExtensionProfileIso P).inv ≫
        (emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs))).inv ≫
        (FiniteTensor.tensor (V := C)).map
          (coefficientLeafMap (𝟙 (O.obj (extendProfile P emptyColoredInputs)))
            (emptyAddedAlgebraInputsIso B).inv) := by
  let T := FiniteTensor.tensor (V := C)
  let a := O.map (emptyExtensionProfileIso P).inv
  let b := (emptyLeafTensorIso (O.obj (extendProfile P emptyColoredInputs))).inv
  have h : (emptyLinearSummandIso O B P).inv =
      (a ≫ b) ≫ T.map (emptyLinearFactorsIso O B P).inv := rfl
  exact h.trans ((Category.assoc a b _).trans
    (congrArg (fun f => a ≫ b ≫ T.map f) (emptyLinearFactorsIso_inv O B P)))

/-- The original O-unit coefficient, its original empty-profile
inverse, and actual empty-leaf inverse give precisely the original
empty-added-input unit summand used by the linear unit. -/
theorem unitEmptySummand_tensor (O : ColoredOperadObj W C) (B : W → C) (c : W) :
    (O.unit c ≫ O.toCollection.map (emptyExtensionProfileIso
      (ColoredSubstitutionData.unitProfile c)).inv) ≫
      (emptyLeafTensorIso (O.toCollection.obj
        (extendProfile (ColoredSubstitutionData.unitProfile c) emptyColoredInputs))).inv ≫
      (FiniteTensor.tensor (V := C)).map
        (coefficientLeafMap (𝟙 (O.toCollection.obj
          (extendProfile (ColoredSubstitutionData.unitProfile c) emptyColoredInputs)))
            (emptyAddedAlgebraInputsIso
            B).inv) =
    O.unit c ≫ (emptyLinearSummandIso O.toCollection B
      (ColoredSubstitutionData.unitProfile c)).inv := by
  let a := O.unit c
  let b := O.toCollection.map (emptyExtensionProfileIso (ColoredSubstitutionData.unitProfile c)).inv
  let d := (emptyLeafTensorIso (O.toCollection.obj
    (extendProfile (ColoredSubstitutionData.unitProfile c) emptyColoredInputs))).inv
  let e := (FiniteTensor.tensor (V := C)).map (coefficientLeafMap (𝟙 (O.toCollection.obj
    (extendProfile (ColoredSubstitutionData.unitProfile c) emptyColoredInputs)))
      (emptyAddedAlgebraInputsIso B).inv)
  exact (Category.assoc a b (d ≫ e)).trans
    (congrArg (a ≫ ·) (emptyLinearSummandIso_inv O.toCollection B
      (ColoredSubstitutionData.unitProfile c)).symm)


end CategoryTheory.Operad.Tensor.Enveloping.Linear

end
