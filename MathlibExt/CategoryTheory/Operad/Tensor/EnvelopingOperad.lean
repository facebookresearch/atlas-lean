namespace CategoryTheory.Operad.Tensor.Enveloping

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Tensor every original root-first coefficient block, including
the singleton block at every original innermost input. -/
def envelopingAssocRootFirstCoefficientBlockTensors (O : ColoredSymmetricCollection W C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    Option d.middleData.totalProfile.inputs → C :=
  fun i => (FiniteTensor.tensor (V := C)).obj
    ((envelopingAssocRootFirstCoefficientBlocks O d Q).obj i)

/-- Retain each original innermost algebra-input family while
inserting its original coefficient singleton tensor comparison. -/
def envelopingAssocInnerWeightedIso (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (p : d.middleData.totalProfile.inputs) :
    (linearCoefficientDiagram O B ((d.localData p.1).inner.obj p.2)).obj
        (Q.branch p.1 (some p.2)) ≅
      (coefficientLeafTensorFunctor ((envelopingAssocRootFirstLeafBlocks B d Q).obj (some p))).obj
        (envelopingAssocRootFirstCoefficientBlockTensors O d Q (some p)) :=
  (coefficientLeafTensorFunctor ((addedAlgebraInputs B).obj (Q.branch p.1 (some p.2)))).mapIso
    ((FiniteTensor.singletonIso (V := C)).app
      (O.obj (extendProfile ((d.localData p.1).inner.obj p.2)
        (Q.branch p.1 (some p.2))))).symm

/-- Normalize the actual middle weighted block and every
original innermost singleton, preserving all original input strands. -/
def envelopingAssocWeightedRootFirstBlockTensorIso (O : ColoredSymmetricCollection W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (FiniteFamily.map (FiniteTensor.tensor (V := C))).obj
        (envelopingAssocWeightedRootFirstBlocks O B d Q) ≅
      weightedInputBlockFamily (FintypeCat.of (Option d.middleData.totalProfile.inputs))
        (envelopingAssocRootFirstCoefficientBlockTensors O d Q)
        (fun i => (envelopingAssocRootFirstLeafBlocks B d Q).obj i) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.middleData.totalProfile.inputs))
    (fun i => match i with
      | none => envelopingAssocMiddleWeightedNormalizationIso O B d Q
      | some p => ((FiniteTensor.singletonIso (V := C)).app
          ((linearCoefficientDiagram O B ((d.localData p.1).inner.obj p.2)).obj
            (Q.branch p.1 (some p.2)))) ≪≫ envelopingAssocInnerWeightedIso O B d Q p)

/-- The normalized root-first coefficient contractions are the
original middle substitution and the original innermost singleton unitors. -/
def envelopingAssocWeightedRootFirstNormalizedContractionMap (O : ColoredOperadObj W C)
    (B : W → C) (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    weightedInputBlockFamily (FintypeCat.of (Option d.middleData.totalProfile.inputs))
        (envelopingAssocRootFirstCoefficientBlockTensors O.toCollection d Q)
        (fun i => (envelopingAssocRootFirstLeafBlocks B d Q).obj i) ⟶
      envelopingWeightedRepresentativeFamily O.toCollection B d.innerData
        (envelopingAssocInnerChoices d Q) where
  equiv := Equiv.refl (Option d.middleData.totalProfile.inputs)
  hom i := match i with
    | none => (coefficientLeafTensorFunctor
        ((addedAlgebraInputs B).obj (envelopingAssocInnerRootInputs d Q))).map
          (envelopingAssocMiddleCoefficientSubstitution O d Q)
    | some p => (coefficientLeafTensorFunctor
        ((addedAlgebraInputs B).obj (Q.branch p.1 (some p.2)))).map
          ((FiniteTensor.singletonIso (V := C)).hom.app
            (O.toCollection.obj (extendProfile ((d.localData p.1).inner.obj p.2)
              (Q.branch p.1 (some p.2)))))

/-- The actual root-first normalization followed by its original
coefficient contractions is the original weighted contraction map. -/
theorem envelopingAssocWeightedRootFirstBlockTensorIso_contraction
    (O : ColoredOperadObj W C) (B : W → C) (d : ColoredAssocData W)
    (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedRootFirstBlockTensorIso O.toCollection B d Q).hom ≫
        envelopingAssocWeightedRootFirstNormalizedContractionMap O B d Q =
      envelopingAssocWeightedContractionMapB O B d Q := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none =>
      exact heq_of_eq (envelopingAssocMiddleWeightedNormalization_evaluation O B d Q)
    | some p =>
      let X := O.toCollection.obj
        (extendProfile ((d.localData p.1).inner.obj p.2) (Q.branch p.1 (some p.2)))
      let L := (addedAlgebraInputs B).obj (Q.branch p.1 (some p.2))
      let e := (FiniteTensor.singletonIso (V := C)).app X
      let F := coefficientLeafTensorFunctor L
      have h : F.map e.inv ≫ F.map e.hom = 𝟙 _ :=
        (F.map_comp _ _).symm.trans
          ((congrArg F.map e.inv_hom_id).trans (F.map_id _))
      have hpre := congrArg ((FiniteTensor.singletonIso (V := C)).hom.app
        ((linearCoefficientDiagram O.toCollection B ((d.localData p.1).inner.obj p.2)).obj
          (Q.branch p.1 (some p.2))) ≫ ·) h
      exact heq_of_eq ((Category.assoc _ _ _).trans
        (hpre.trans (Category.comp_id _)))


end CategoryTheory.Operad.Tensor.Enveloping

end
