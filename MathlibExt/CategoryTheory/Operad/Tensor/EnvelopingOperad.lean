section EnvelopingSource223


/-!
# The actual original algebra unit for constant-input linear operations
-/

set_option autoImplicit false
noncomputable section
universe u v w us

namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]
variable [Limits.HasColimitsOfSize.{us, us} C] [Small.{us} W]
variable [FiniteTensorPreservesColimitsInEachSlot.{v, w, us} C]

/-- The original O-unit coefficient maps to precisely the
constructed linear operad unit, retaining the original input
singleton tensor comparison. -/
theorem linearUnitFactors (O : ColoredOperadObj W C) (B M : W → C) (d : W) :
    unitFactors O M d ≫
        (analyticFactorsCollectionMap M (originalOperationToLinearMap O.toCollection B)).app
          (AnalyticIndex.unary d) =
      unitFactors (envelopingLinearOperad O B) M d := by
  apply FiniteFamily.Hom_ext
  · ext p
    cases p <;> rfl
  · intro p
    cases p with
    | none => rfl
    | some p =>
      cases p
      let s := (FiniteTensor.singletonIso (V := C)).hom.app (M d)
      change HEq (s ≫ 𝟙 _) s
      exact heq_of_eq (Category.comp_id s)

/-- The original unit input map is unchanged under the actual
original O-operation inclusion into L(B). -/
theorem linearUnitInsertion (O : ColoredOperadObj W C) (B M : W → C) (d : W) :
    unitInsertion O M d ≫
        (analyticSummandCollectionMap M (originalOperationToLinearMap O.toCollection B)).app
          (AnalyticIndex.unary d) =
      unitInsertion (envelopingLinearOperad O B) M d :=
  (UnitInsertion.leftInsertFromFactor_comp (M d) (unitFactors O M d)
    ((analyticFactorsCollectionMap M (originalOperationToLinearMap O.toCollection B)).app
      (AnalyticIndex.unary
      d))).trans
    (congrArg (UnitInsertion.leftInsertFromFactor (M d)) (linearUnitFactors O B M d))

/-- The complete actual constant-input tensor operation family
satisfies its algebra unit law, derived from M's original O-unit
law and the original coefficient inclusion. -/
theorem linearOperations_unit (O : ColoredOperadObj W C) (B : W → C)
    (M : Algebra O) (g : B ⟶ M.carrier) (d : W) :
    unitInsertion (envelopingLinearOperad O B) M.carrier d ≫
        (linearOperations O B M g).app d (AnalyticIndex.unary d) = 𝟙 (M.carrier d) := by
  let i := unitInsertion O M.carrier d
  let c := (analyticSummandCollectionMap (d := d) M.carrier (originalOperationToLinearMap
    O.toCollection B)).app
    (AnalyticIndex.unary (d := d) d)
  let op := (linearOperations O B M g).app d (AnalyticIndex.unary d)
  let old := M.operations.app d (AnalyticIndex.unary d)
  have hi : i ≫ c = unitInsertion (envelopingLinearOperad O B) M.carrier d :=
    linearUnitInsertion O B M.carrier d
  have hc : c ≫ op = old := originalOperation_recovery O B M g d (AnalyticIndex.unary d)
  exact (congrArg (· ≫ op) hi).symm.trans
    ((Category.assoc _ _ _).trans ((congrArg (i ≫ ·) hc).trans (M.unit d)))


end CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

