coequalizer/algebra-carrier isomorphism and its original inverse. -/
def envelopingOperadNullaryCarrierIso (O : ColoredOperadObj W C) (A : Algebra O) :
    (fun d => (envelopingOperad O A).toCollection.obj (ColoredProfile.nullary d)) ≅ A.carrier where
  hom d := (envelopingOperadNullaryIso O A d).hom
  inv d := (envelopingOperadNullaryIso O A d).inv
  hom_inv_id := by funext d; exact (envelopingOperadNullaryIso O A d).hom_inv_id
  inv_hom_id := by funext d; exact (envelopingOperadNullaryIso O A d).inv_hom_id

