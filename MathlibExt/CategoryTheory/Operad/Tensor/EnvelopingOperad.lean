/-!
# Original right unit-prefix coefficient and weighted input families
-/

set_option autoImplicit false
noncomputable section
universe v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

open CategoryTheory

variable {C : Type w} [Category.{v} C]

/-- The original retained root coefficient and one supplied coefficient
at every original inserted unit position. -/
def rightCoefficientFamily (X : C) (I : FintypeCat.{0}) (Y : I → C) : FiniteFamily C where
  index := FintypeCat.of (Option I)
  obj i := match i with | none => X | some i => Y i

/-- All original heterogeneous leaves remain at the retained root;
the original unit positions have their actual empty leaf family. -/
def rightLeaves (L : FiniteFamily C) (I : FintypeCat.{0}) : Option I → FiniteFamily C
  | none => L
  | some _ => FiniteFamily.empty

/-- The exact original leaf family at the sole retained coefficient
in the original right empty/singleton block family. -/
def rightAtomicInputs (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) :
    ((FiniteFamily.flatten (C := C)).obj (UnitInsertion.rightNestedFamily X I)).index →
      FiniteFamily C
  | ⟨none, _⟩ => L
  | ⟨some _, i⟩ => i.elim

/-- The original singleton coefficient embeds at the original root
of the original empty/singleton right insertion blocks. -/
def rightCoefficientEmbeddingIso (X : C) (I : FintypeCat.{0}) :
    (FiniteFamily.singleton (C := C)).obj X ≅
      (FiniteFamily.flatten (C := C)).obj (UnitInsertion.rightNestedFamily X I) :=
  FiniteFamily.isoOfComponents (UnitInsertion.rightSingletonToFlatten X I).equiv
    (fun _ => Iso.refl X)

theorem rightCoefficientEmbeddingIso_hom (X : C) (I : FintypeCat.{0}) :
    (rightCoefficientEmbeddingIso X I).hom = UnitInsertion.rightSingletonToFlatten X I := rfl

/-- The exact original root-only total leaf bijection retains all
original root leaf positions and objects. -/
def rightLeavesIso (L : FiniteFamily C) (I : FintypeCat.{0}) :
    totalBlockInputs (FintypeCat.of (Option I)) (rightLeaves L I) ≅ L :=
  FiniteFamily.isoOfComponents
    { toFun := fun p => match p with | ⟨none, i⟩ => i | ⟨some _, i⟩ => i.elim
      invFun := fun i => ⟨none, i⟩
      left_inv := fun p => by rcases p with ⟨i, j⟩; cases i with
        | none => rfl
        | some i => cases j
      right_inv := fun _ => rfl }
    (fun p => by rcases p with ⟨i, j⟩; cases i with
      | none => exact Iso.refl _
      | some i => cases j)

/-- The original grouped root inputs use the original singleton
leaf bijection; every original empty coefficient block uses its exact empty map. -/
def rightBlockLeavesIso (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) (i : Option I) :
    groupedCoefficientInputs (UnitInsertion.rightNestedFamily X I) (rightAtomicInputs X L I) i ≅
      rightLeaves L I i := by
  cases i with
  | none => exact singletonCoefficientInputLeafIso L
  | some i => exact emptyLeavesIso (fun j => rightAtomicInputs X L I ⟨some i, j⟩)

/-- The original grouped right-prefix leaves retain the original
root block and every original internal leaf correction. -/
def rightInputBlocksIso (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) :
    inputBlockFamily (FintypeCat.of (Option I))
        (groupedCoefficientInputs (UnitInsertion.rightNestedFamily X I) (rightAtomicInputs X L I)) ≅
      inputBlockFamily (FintypeCat.of (Option I)) (rightLeaves L I) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option I)) (rightBlockLeavesIso X L I)

/-- Flatten the grouped leaves of the right unit prefix to recover the original leaf family. -/
def rightGroupedLeavesIso (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) :
    groupedCoefficientInputLeaves (UnitInsertion.rightNestedFamily X I) (rightAtomicInputs X
      L I) ≅ L :=
  (FiniteFamily.flatten (C := C)).mapIso (rightInputBlocksIso X L I) ≪≫ rightLeavesIso L I

/-- Identify the atomic leaves of the right unit prefix with the original leaf family. -/
def rightAtomicLeavesIso (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) :
    totalBlockInputs ((FiniteFamily.flatten (C := C)).obj (UnitInsertion.rightNestedFamily X
      I)).index
        (rightAtomicInputs X L I) ≅ L :=
  Grouping.atomicLeafIso (UnitInsertion.rightNestedFamily X I) (rightAtomicInputs X L I) ≪≫
    rightGroupedLeavesIso X L I

variable [FiniteTensor C]

/-- The literal original right insertion blocks of the weighted root
are the genuine grouped coefficient/input weighted blocks, with exact
map-empty correction in every original empty coefficient block. -/
def rightWeightedBlocksIso (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) :
    UnitInsertion.rightNestedFamily ((coefficientLeafTensorFunctor L).obj X) I ≅
      groupedCoefficientInputWeightedBlocks (UnitInsertion.rightNestedFamily X I)
        (rightAtomicInputs X L I) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option I)) (fun i => by
    cases i with
    | none => exact Iso.refl _
    | some i => exact emptyWeightedIso (fun j => rightAtomicInputs X L I ⟨some i, j⟩))

/-- The original root singleton collapse and supplied unit coefficients
on the actual original right insertion tensor family. -/
def rightCoefficientFactor (X : C) (I : FintypeCat.{0}) (Y : I → C)
    (η : ∀ i, (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y i) :
    UnitInsertion.rightTensorFamily X I ⟶ rightCoefficientFamily X I Y where
  equiv := Equiv.refl (Option I)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app X
    | some i => η i

/-- The actual weighted right-prefix factor map retains the original
root singleton and inserts each supplied coefficient through its actual
original empty-leaf unitor inverse. -/
def rightWeightedFactor (X : C) (L : FiniteFamily C) (I : FintypeCat.{0}) (Y : I → C)
    (η : ∀ i, (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y i) :
    UnitInsertion.rightTensorFamily ((coefficientLeafTensorFunctor L).obj X) I ⟶
      weightedInputBlockFamily (FintypeCat.of (Option I)) (rightCoefficientFamily X I Y).obj
        (rightLeaves L I) where
  equiv := Equiv.refl (Option I)
  hom i := match i with
    | none => (FiniteTensor.singletonIso (V := C)).hom.app ((coefficientLeafTensorFunctor L).obj X)
    | some i => η i ≫ (emptyLeafTensorIso (Y i)).inv

/-- The actual tensor of each original empty/singleton coefficient
block maps by the literal original right coefficient factor map. -/
theorem rightCoefficientBlockMap (X : C) (I : FintypeCat.{0}) (Y : I → C)
    (η : ∀ i, (FiniteTensor.tensor (V := C)).obj (FiniteFamily.empty : FiniteFamily C) ⟶ Y i) :
    coefficientBlockMap (FintypeCat.of (Option I)) (rightCoefficientFactor X I Y η).hom =
      rightCoefficientFactor X I Y η := rfl


end CategoryTheory.Operad.Tensor.Enveloping.Linear.UnitGeometry

end
