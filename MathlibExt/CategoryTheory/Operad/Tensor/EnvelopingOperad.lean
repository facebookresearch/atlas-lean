theorem coefficientCocone_π (t : Q ⟶ P) (hf : t ≫ f = 𝟙 Q) (hg : t ≫ g = 𝟙 Q)
    (s : ColoredProfile W) :
    (coefficientCocone f g t hf hg s).ι.app WalkingReflexivePair.zero =
      coefficientπ f g s := rfl


