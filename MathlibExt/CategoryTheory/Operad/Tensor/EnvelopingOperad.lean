    | Sum.inl j => ⟨none, Sum.inl j⟩
    | Sum.inr ⟨i, Sum.inl j⟩ => ⟨none, Sum.inr ⟨i, j⟩⟩
    | Sum.inr ⟨i, Sum.inr ⟨j, k⟩⟩ => ⟨some ⟨i, j⟩, k⟩
