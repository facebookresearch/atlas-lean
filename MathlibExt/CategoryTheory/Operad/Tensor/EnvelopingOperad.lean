      nullaryVariableProfileHom d Q ≫ (analyticToProfileFunctor W d).map ((inputsToProfile
        d).map g) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro i
  cases i with
  | inl i => exact Fin.elim0 i
  | inr i => rfl

