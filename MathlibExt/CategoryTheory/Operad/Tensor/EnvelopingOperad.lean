    | some (Sum.inr _) => retainedRootUnitTensorSource (C := C)

/-- Flattening the actual retained source removes only the
original empty root-unit blocks and retains all original coefficient positions. -/
def envelopingAssocRetainedFlattenEquiv (O : ColoredSymmetricCollection W C) (d :
