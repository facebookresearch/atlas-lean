-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.WeightedNormalization

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- The branch-first grouped inputs use the original singleton-root
leaf correction and each original branch's total-input comparison. -/
def blockInputsIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (i : (envelopingAssocCoefficientBlocks O d Q).index) :
    groupedCoefficientInputs (envelopingAssocCoefficientBlocks O d Q)
        (coefficientInputsA O B d Q) i ≅
      (envelopingAssocLeafBlocks B d Q).obj i := by
  cases i with
  | none => exact singletonCoefficientInputLeafIso ((addedAlgebraInputs B).obj Q.root)
  | some i => exact envelopingAlgebraLeafIso B (d.localData i) (Q.branch i)

/-- The root-first grouped inputs use the original middle leaf
comparison and the exact innermost singleton-input corrections. -/
def blockInputsIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d)
    (i : (envelopingAssocRootFirstCoefficientBlocks O d Q).index) :
    groupedCoefficientInputs (envelopingAssocRootFirstCoefficientBlocks O d Q)
        (coefficientInputsB O B d Q) i ≅
      (envelopingAssocRootFirstLeafBlocks B d Q).obj i := by
  cases i with
  | none => exact envelopingAssocMiddleLeafIso B d Q
  | some p =>
    exact singletonCoefficientInputLeafIso
      ((addedAlgebraInputs B).obj (Q.branch p.1 (some p.2)))

/-- The original branch-first input blocks retain their exact
original block permutation and every original internal leaf comparison. -/
def inputBlocksIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    inputBlockFamily (envelopingAssocCoefficientBlocks O d Q).index
        (groupedCoefficientInputs (envelopingAssocCoefficientBlocks O d Q)
          (coefficientInputsA O B d Q)) ≅ envelopingAssocLeafBlocks B d Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.branches.index))
    (blockInputsIsoA O B d Q)

/-- The complete original root-first input block family comparison. -/
def inputBlocksIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    inputBlockFamily (envelopingAssocRootFirstCoefficientBlocks O d Q).index
        (groupedCoefficientInputs (envelopingAssocRootFirstCoefficientBlocks O d Q)
          (coefficientInputsB O B d Q)) ≅ envelopingAssocRootFirstLeafBlocks B d Q :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.middleData.totalProfile.inputs))
    (blockInputsIsoB O B d Q)

/-- The original branch-first grouped leaves map to the original
displayed total algebra-input family by both original comparisons. -/
def leavesIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    groupedCoefficientInputLeaves (envelopingAssocCoefficientBlocks O d Q)
        (coefficientInputsA O B d Q) ≅
      (addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q) :=
  (FiniteFamily.flatten (C := C)).mapIso (inputBlocksIsoA O B d Q) ≪≫
    envelopingAssocAlgebraLeafIso B d Q

/-- The original root-first grouped leaves use their original
dependent-sum comparison to the same displayed total algebra inputs. -/
def leavesIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    groupedCoefficientInputLeaves (envelopingAssocRootFirstCoefficientBlocks O d Q)
        (coefficientInputsB O B d Q) ≅
      (addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q) :=
  (FiniteFamily.flatten (C := C)).mapIso (inputBlocksIsoB O B d Q) ≪≫
    envelopingAssocRootFirstLeafIso B d Q

/-- The full original atomic branch-first leaf correction. -/
def atomicLeavesIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    totalBlockInputs (envelopingAssocCoefficients O d Q).index
        (coefficientInputsA O B d Q) ≅
      (addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q) :=
  Grouping.atomicLeafIso (envelopingAssocCoefficientBlocks O d Q)
      (coefficientInputsA O B d Q) ≪≫ leavesIsoA O B d Q

/-- The full original atomic root-first leaf correction. -/
def atomicLeavesIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    totalBlockInputs
        ((FiniteFamily.flatten (C := C)).obj
          (envelopingAssocRootFirstCoefficientBlocks O d Q)).index
        (coefficientInputsB O B d Q) ≅
      (addedAlgebraInputs B).obj (envelopingAssocTotalAlgebraInputs d Q) :=
  Grouping.atomicLeafIso (envelopingAssocRootFirstCoefficientBlocks O d Q)
      (coefficientInputsB O B d Q) ≪≫ leavesIsoB O B d Q

variable [FiniteTensor C]

/-- The original evaluated coefficient tensor at each branch-first
block is unchanged while its exact original leaf map is applied. -/
def evaluatedBlocksIsoA (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    partitionedCoefficientLeavesEvaluated (envelopingAssocCoefficientBlocks O d Q)
        (groupedCoefficientInputs (envelopingAssocCoefficientBlocks O d Q)
          (coefficientInputsA O B d Q)) ≅
      combinedInputBlocks (FintypeCat.of (Option d.branches.index))
        (envelopingAssocCoefficientBlockTensors O d Q)
        (fun i => (envelopingAssocLeafBlocks B d Q).obj i) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.branches.index))
    (fun i => coefficientLeafIso (Iso.refl _) (blockInputsIsoA O B d Q i))

/-- The original evaluated root-first coefficient tensor is unchanged
at every block, including each original innermost singleton block. -/
def evaluatedBlocksIsoB (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    partitionedCoefficientLeavesEvaluated (envelopingAssocRootFirstCoefficientBlocks O d Q)
        (groupedCoefficientInputs (envelopingAssocRootFirstCoefficientBlocks O d Q)
          (coefficientInputsB O B d Q)) ≅
      combinedInputBlocks (FintypeCat.of (Option d.middleData.totalProfile.inputs))
        (envelopingAssocRootFirstCoefficientBlockTensors O d Q)
        (fun i => (envelopingAssocRootFirstLeafBlocks B d Q).obj i) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option d.middleData.totalProfile.inputs))
    (fun i => coefficientLeafIso (Iso.refl _) (blockInputsIsoB O B d Q i))

/-- The exact original branch-first common-factor map is its actual
complete coefficient tensor map and original total algebra-leaf map. -/
theorem commonFactorsIsoA_hom (O : ColoredSymmetricCollection W C) (B : W → C)
    (d : ColoredAssocData W) (Q : EnvelopingAssocChoices d) :
    (envelopingAssocWeightedCommonFactorsIso O B d Q).hom =
      coefficientLeafMap (envelopingAssocFullCoefficientTensorIso O d Q).hom
        (envelopingAssocAlgebraLeafIso B d Q).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro p
    cases p with
    | none => rfl
    | some p => rcases p with ⟨i, j⟩; cases i <;> rfl


