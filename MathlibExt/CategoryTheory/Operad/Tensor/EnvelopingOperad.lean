/-!
# Original variable-profile maps and actual partial substitution

Every original input permutation and output-color equality acts on the
substitution datum. The variable units use their original unary profiles
and the original input-color equalities; every added algebra branch remains
its supplied original profile.
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Variable

open CategoryTheory

private theorem composeTwoSquares {V : Type*} [Category* V]
    {A A' B B' D D' : V} (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B')
    (f : B ⟶ B') (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) :
    l ≫ (p' ≫ q') = (p ≫ q) ≫ g := by
  rw [← Category.assoc l p', hp, Category.assoc p f, hq, Category.assoc]

private theorem EnvelopingSource174_composeThreeSquares {V : Type*} [Category* V]
    {A A' B B' D D' E E' : V}
    (l : A ⟶ A') (p : A ⟶ B) (p' : A' ⟶ B') (f : B ⟶ B')
    (q : B ⟶ D) (q' : B' ⟶ D') (g : D ⟶ D')
    (r : D ⟶ E) (r' : D' ⟶ E') (h : E ⟶ E')
    (hp : l ≫ p' = p ≫ f) (hq : f ≫ q' = q ≫ g) (hr : g ≫ r' = r ≫ h) :
    l ≫ (p' ≫ q' ≫ r') = (p ≫ q ≫ r) ≫ h := by
  rw [← Category.assoc l p', hp, Category.assoc p f, ← Category.assoc f q', hq,
    Category.assoc q g, hr]
  simp only [Category.assoc]

variable {W : Type u}

/-- The actual original unary-profile arrow supplied by a color
equality, retaining the unary input and its output-color transport. -/
def unaryColorHom {c d : W} (h : c = d) :
    ColoredProfile.unary c c ⟶ ColoredProfile.unary d d where
  inputEquiv := Equiv.refl PUnit
  inputColor_eq _ := h
  outputColor_eq := h

/-- The original variable-profile bijection acts on every variable
unary profile and retains every original added-input branch profile. -/
def innerProfilesMap {P P' : ColoredProfile W} (f : P ⟶ P')
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenInnerProfiles P Q R ⟶ frozenInnerProfiles P' Q R where
  equiv := Equiv.sumCongr f.inputEquiv (Equiv.refl Q.index)
  hom i := match i with
    | Sum.inl i => unaryColorHom (f.inputColor_eq i)
    | Sum.inr j => 𝟙 ((R j).toColoredProfile)

/-- The actual complete substitution morphism retains the original
variable-profile output equality and every original input permutation. -/
def substitutionMap {P P' : ColoredProfile W} (f : P ⟶ P')
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenSubstitution P Q R ⟶ frozenSubstitution P' Q R where
  outputColor_eq := f.outputColor_eq
  innerHom := innerProfilesMap f Q R

/-- The exact original outer-profile comparison is natural under
every original variable-profile map. -/
theorem outerProfileHom_naturality {P P' : ColoredProfile W} (f : P ⟶ P')
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenOuterProfileHom P Q R ≫ ColoredSubstitutionData.outerProfileMap (substitutionMap f Q R) =
      extendProfileMap f (𝟙 Q) ≫ frozenOuterProfileHom P' Q R := by
  apply ColoredProfile.Hom.ext
  rfl

/-- The total-profile comparison preserves the original variable
bijection and all original algebra leaves and colors. -/
theorem totalProfileHom_naturality {P P' : ColoredProfile W} (f : P ⟶ P')
    (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    ColoredSubstitutionData.totalProfileMap (substitutionMap f Q R) ≫ frozenTotalProfileHom P' Q R =
      frozenTotalProfileHom P Q R ≫ extendProfileMap f (𝟙 (frozenTotalInputs Q R)) := by
  apply ColoredProfile.Hom.ext
  apply Equiv.ext
  intro p
  rcases p with ⟨i, j⟩
  cases i <;> rfl

variable {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- The original unary operadic units commute with their actual
input/output color transports, derived from the original color equality. -/
theorem unaryUnit_naturality (O : ColoredOperadObj W C) {c d : W} (h : c = d) :
    O.unit c ≫ O.toCollection.map (unaryColorHom h) = O.unit d := by
  cases h
  have hi : unaryColorHom (rfl : c = c) = 𝟙 (ColoredSubstitutionData.unitProfile c) := by
    apply ColoredProfile.Hom.ext
    rfl
  have hm := (congrArg O.toCollection.map hi).trans
    (O.toCollection.map_id (ColoredSubstitutionData.unitProfile c))
  exact (congrArg (O.unit c ≫ ·) hm).trans (Category.comp_id _)

/-- The original variable-profile map acts on the actual root
coefficient and retains every original branch operation coefficient. -/
def coefficientMap (O : ColoredSymmetricCollection W C) {P P' : ColoredProfile W}
    (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenCoefficientFamily O P Q R ⟶ frozenCoefficientFamily O P' Q R where
  equiv := Equiv.refl (Option Q.index)
  hom i := match i with
    | none => O.map (extendProfileMap f (𝟙 Q))
    | some j => 𝟙 (O.obj ((R j).toColoredProfile))

/-- Every original variable unit and coefficient commutes with the
original variable-profile permutation and all its color equalities. -/
theorem unitCoefficientMap_naturality (O : ColoredOperadObj W C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    frozenUnitCoefficientMap O P Q R ≫
        (ColoredOperadObj.substitutionFactors O.toCollection).map (substitutionMap f Q R) =
      unitFamilyMap f.inputEquiv (coefficientMap O.toCollection f Q R) ≫
        frozenUnitCoefficientMap O P' Q R := by
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with
    | inl i => rfl
    | inr i => cases i <;> rfl
  · intro i
    cases i with
    | inl i =>
      change HEq (O.unit (P.inputColor i) ≫ O.toCollection.map (unaryColorHom (f.inputColor_eq i)))
        (𝟙 _ ≫ O.unit (P'.inputColor (f.inputEquiv i)))
      exact heq_of_eq ((unaryUnit_naturality O (f.inputColor_eq i)).trans (Category.id_comp _).symm)
    | inr i =>
      cases i with
      | none =>
        change HEq (O.toCollection.map (frozenOuterProfileHom P Q R) ≫
          O.toCollection.map (ColoredSubstitutionData.outerProfileMap (substitutionMap f Q R)))
          (O.toCollection.map (extendProfileMap f (𝟙 Q)) ≫
            O.toCollection.map (frozenOuterProfileHom P' Q R))
        exact heq_of_eq ((O.toCollection.map_comp _ _).symm.trans
          ((congrArg O.toCollection.map (outerProfileHom_naturality f Q R)).trans
            (O.toCollection.map_comp _ _)))
      | some j =>
        change HEq (𝟙 _ ≫ O.toCollection.map (𝟙 ((R j).toColoredProfile))) (𝟙 _ ≫ 𝟙 _)
        exact heq_of_eq (congrArg (𝟙 _ ≫ ·) (O.toCollection.map_id ((R j).toColoredProfile)))

/-- The actual variable unit insertion commutes with every original
variable bijection and every original root coefficient map. -/
theorem substitutionCoefficientTensorMap_naturality (O : ColoredOperadObj W C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection f Q R) ≫
        frozenSubstitutionCoefficientTensorMap O P' Q R =
      frozenSubstitutionCoefficientTensorMap O P Q R ≫
        (ColoredOperadObj.substitutionSource O.toCollection).map (substitutionMap f Q R) := by
  let T := FiniteTensor.tensor (V := C)
  let l := coefficientMap O.toCollection f Q R
  let k := unitFamilyMap f.inputEquiv l
  let m := (ColoredOperadObj.substitutionFactors O.toCollection).map (substitutionMap f Q R)
  have hs : T.map k ≫ T.map (frozenUnitCoefficientMap O P' Q R) =
      T.map (frozenUnitCoefficientMap O P Q R) ≫ T.map m :=
    (T.map_comp _ _).symm.trans
      ((congrArg T.map (unitCoefficientMap_naturality O f Q R).symm).trans (T.map_comp _ _))
  exact composeTwoSquares (T.map l)
    (frozenVariableTensorUnitIso P.inputs (frozenCoefficientFamily O.toCollection P Q R)).hom
    (frozenVariableTensorUnitIso P'.inputs (frozenCoefficientFamily O.toCollection P' Q R)).hom
    (T.map k) (T.map (frozenUnitCoefficientMap O P Q R)) (T.map (frozenUnitCoefficientMap O P' Q R))
    (T.map m) (tensorUnitIso_naturality f.inputEquiv l) hs

/-- The actual original partial substitution is natural in every
variable-profile map, retaining its input bijection, output equality,
original unary units, and every original branch profile. -/
theorem partialSubstitution_naturality (O : ColoredOperadObj W C)
    {P P' : ColoredProfile W} (f : P ⟶ P') (Q : ColoredInputs W) (R : FrozenBranchTuple Q) :
    (FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection f Q R) ≫
        frozenPartialSubstitution O P' Q R =
      frozenPartialSubstitution O P Q R ≫
        O.toCollection.map (extendProfileMap f (𝟙 (frozenTotalInputs Q R))) := by
  let m := substitutionMap f Q R
  have ht : O.toCollection.map (ColoredSubstitutionData.totalProfileMap m) ≫
        O.toCollection.map (frozenTotalProfileHom P' Q R) =
      O.toCollection.map (frozenTotalProfileHom P Q R) ≫
        O.toCollection.map (extendProfileMap f (𝟙 (frozenTotalInputs Q R))) :=
    (O.toCollection.map_comp _ _).symm.trans
      ((congrArg O.toCollection.map (totalProfileHom_naturality f Q R)).trans
        (O.toCollection.map_comp _ _))
  exact EnvelopingSource174_composeThreeSquares
    ((FiniteTensor.tensor (V := C)).map (coefficientMap O.toCollection f Q R))
    (frozenSubstitutionCoefficientTensorMap O P Q R) (frozenSubstitutionCoefficientTensorMap
      O P' Q R)
    ((ColoredOperadObj.substitutionSource O.toCollection).map m)
    (O.subst.app (frozenSubstitution P Q R)) (O.subst.app (frozenSubstitution P' Q R))
    (O.toCollection.map (ColoredSubstitutionData.totalProfileMap m))
    (O.toCollection.map (frozenTotalProfileHom P Q R)) (O.toCollection.map
      (frozenTotalProfileHom P' Q R))
    (O.toCollection.map (extendProfileMap f (𝟙 (frozenTotalInputs Q R))))
    (substitutionCoefficientTensorMap_naturality O f Q R) (O.subst.naturality m) ht


end CategoryTheory.Operad.Tensor.Enveloping.Variable

end
