set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear.Constants.Root

open CategoryTheory

private theorem collapseRootScalar {D : Type*} [Category* D] {A B C E F : D}
    (p : A ⟶ B) (e : B ⟶ A) (q : A ⟶ C) (c : C ⟶ E) (h : E ⟶ F)
    (s : A ⟶ E) (k : A ⟶ F)
    (hp : p ≫ e = 𝟙 A) (hq : q ≫ c = s) (hh : s ≫ h = k) :
    (p ≫ (e ≫ q)) ≫ c ≫ h = k := by
  calc
    (p ≫ (e ≫ q)) ≫ c ≫ h = (p ≫ e) ≫ (q ≫ c) ≫ h := by simp only [Category.assoc]
    _ = k := by rw [hp, hq, Category.id_comp, hh]

private theorem singletonUnitLaw {D : Type*} [Category* D] {A B C E : D}
    (e : A ≅ B) (n : A ⟶ C) (q : B ⟶ C) (r : C ⟶ E) (t : E ⟶ B)
    (hn : q = e.inv ≫ n) (hu : q ≫ r ≫ t = 𝟙 B) : n ≫ r ≫ t = e.hom := by
  apply (cancel_epi e.inv).1
  exact (Category.assoc e.inv n (r ≫ t)).symm.trans
    ((congrArg (· ≫ r ≫ t) hn.symm).trans (hu.trans e.inv_hom_id.symm))

private theorem singletonSourceLaw {D : Type*} [Category* D] {A B C E : D}
    (e : A ≅ B) (f : A ⟶ C) (c : C ⟶ B) (k : B ⟶ E) (hf : f ≫ c = e.hom) :
    e.inv ≫ f ≫ c ≫ k = k := by
  calc
    e.inv ≫ f ≫ c ≫ k = e.inv ≫ (f ≫ c) ≫ k := by simp only [Category.assoc]
    _ = e.inv ≫ e.hom ≫ k := congrArg (e.inv ≫ · ≫ k) hf
    _ = k := by rw [← Category.assoc, e.inv_hom_id, Category.id_comp]

private theorem mapThreeRootA {D E : Type*} [Category* D] [Category* E] (F : D ⥤ E)
    {A B C G : D} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ G) :
    F.map (a ≫ b ≫ c) = F.map a ≫ F.map b ≫ F.map c := by simp only [Functor.map_comp]

private theorem rootASourceFiring {D : Type*} [Category* D] {A B C E F G H : D}
    (x : A ⟶ B) (f : B ⟶ C) (g : C ⟶ E) (h : E ⟶ H)
    (p : A ⟶ F) (a : F ⟶ G) (l : G ⟶ C) (m : G ⟶ H) (n : A ⟶ H)
    (hp : x ≫ f = p ≫ a ≫ l) (hl : l ≫ g ≫ h = m) (hn : p ≫ a ≫ m = n) :
    x ≫ f ≫ g ≫ h = n := by
  calc
    x ≫ f ≫ g ≫ h = (x ≫ f) ≫ g ≫ h := by simp only [Category.assoc]
    _ = (p ≫ a ≫ l) ≫ g ≫ h := congrArg (· ≫ g ≫ h) hp
    _ = p ≫ a ≫ (l ≫ g ≫ h) := by simp only [Category.assoc]
    _ = n := (congrArg (p ≫ a ≫ ·) hl).trans hn

private theorem rootARouteFiring {D : Type*} [Category* D] {A B C E F G H J : D}
    (x : A ⟶ B) (f : B ⟶ C) (g : C ⟶ E) (s : E ⟶ F) (q : F ⟶ G) (k : G ⟶ H)
    (h : E ⟶ J) (s' : J ⟶ G) (n : A ⟶ J)
    (hs : s ≫ q = h ≫ s') (hn : x ≫ f ≫ g ≫ h = n) :
    (x ≫ (f ≫ g ≫ s)) ≫ (q ≫ k) = n ≫ s' ≫ k := by
  calc
    (x ≫ (f ≫ g ≫ s)) ≫ (q ≫ k) = x ≫ f ≫ g ≫ (s ≫ q) ≫ k := by simp only [Category.assoc]
    _ = x ≫ f ≫ g ≫ (h ≫ s') ≫ k := congrArg (fun z => x ≫ f ≫ g ≫ z ≫ k) hs
    _ = (x ≫ f ≫ g ≫ h) ≫ s' ≫ k := by simp only [Category.assoc]
    _ = n ≫ s' ≫ k := congrArg (· ≫ s' ≫ k) hn

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Every original variable left unit and original nullary right unit
collapses under its genuine E-law, with the literal original root profile correction. -/
theorem appliedMapA_collapse (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    appliedMapA E s Q ≫ ColoredOperadObj.AssocInsertion.groupingAToFactorsHom
      E.toCollection E.subst (assocData s Q) ≫
      (ColoredOperadObj.substitutionFactors E.toCollection).map (afterInnerCompare s Q) =
        collapsedFactorsA E s Q := by
  let T := FiniteTensor.tensor (V := C)
  apply FiniteFamily.Hom_ext
  · ext i
    cases i with | none => rfl | some i => cases i <;> rfl
  · intro i
    cases i with
    | none =>
      let X := E.toCollection.obj (extendProfile s.outerProfile Q)
      let p := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0)) ((FiniteFamily.singleton
        (C := C)).obj X)).hom
      let e := T.map (ZeroVariable.emptyUnitIso (FintypeCat.of (Fin 0))
        ((FiniteFamily.singleton (C := C)).obj X)).hom
      let f := frozenOuterProfileHom s.outerProfile Q (Constants.branches Q) ≫
        ColoredSubstitutionData.outerProfileMap
        (middleCompare s Q)
      let q := T.map ((FiniteFamily.singleton (C := C)).map (E.toCollection.map f))
      let c := (FiniteTensor.singletonIso (V := C)).hom.app (E.toCollection.obj (assocData s
        Q).middleData.outerProfile)
      let h := E.toCollection.map (ColoredSubstitutionData.outerProfileMap (d :=
        (assocData s Q).outerAfterInnerData)
        (afterInnerCompare s Q))
      let v := (FiniteTensor.singletonIso (V := C)).hom.app X
      let k := E.toCollection.map (Branch.generalOuterHom s Q)
      have hp : p ≫ e = 𝟙 _ := ZeroVariable.emptyPrefix_unit (FintypeCat.of (Fin 0))
        ((FiniteFamily.singleton (C :=
        C)).obj X)
      have hq : q ≫ c = v ≫ E.toCollection.map f := (FiniteTensor.singletonIso (V :=
        C)).hom.naturality
        (E.toCollection.map f)
      have hf : E.toCollection.map f ≫ h = k := (E.toCollection.map_comp _ _).symm.trans
        (congrArg E.toCollection.map ((Category.assoc _ _ _).trans (rootProfile_readback s Q)))
      have hm : T.map (localUnitMapA E s Q none) = e ≫ q := T.map_comp _ _
      change HEq ((p ≫ T.map (localUnitMapA E s Q none)) ≫ c ≫ h) (v ≫ k)
      have hh : (v ≫ E.toCollection.map f) ≫ h = v ≫ k :=
        (Category.assoc v (E.toCollection.map f) h).trans (congrArg (v ≫ ·) hf)
      exact heq_of_eq ((congrArg (fun n => (p ≫ n) ≫ c ≫ h) hm).trans
        (collapseRootScalar p e q c h (v ≫ E.toCollection.map f) (v ≫ k) hp hq hh))
    | some i =>
      cases i with
      | inl i =>
        let P := s.inner.obj i
        let X := E.toCollection.obj P
        let e := (FiniteTensor.singletonIso (V := C)).app X
        let n := (frozenVariableTensorUnitIso (FintypeCat.of PUnit) ((FiniteFamily.singleton
          (C := C)).obj X)).hom ≫
          T.map (Constants.leftFrozenUnitMap E P)
        let q := ColoredOperadObj.leftUnitInsert E.toCollection E.unit P
        let r := E.subst.app (ColoredSubstitutionData.leftUnit P)
        let t := E.toCollection.map (ColoredSubstitutionData.leftUnitTotalHom P)
        change HEq (n ≫ r ≫ t) (e.hom ≫ 𝟙 X)
        exact heq_of_eq ((singletonUnitLaw e n q r t (Constants.leftUnitInsert_normalized E
          P) (E.left_unit P)).trans
          (Category.comp_id e.hom).symm)
      | inr i =>
        let P := ColoredProfile.nullary (Q.obj i).as
        let X := E.toCollection.obj P
        let e := (FiniteTensor.singletonIso (V := C)).app X
        let n := (frozenVariableTensorUnitIso (FintypeCat.of (Fin 0))
          ((FiniteFamily.singleton (C := C)).obj X)).hom ≫
          T.map ((Unit.rightUnitPositionIso X (FintypeCat.of (Fin 0))).hom ≫
            Unit.rightCoefficientBareMap E P)
        let q := ColoredOperadObj.rightUnitInsert E.toCollection E.unit P
        let r := E.subst.app (ColoredSubstitutionData.rightUnit P)
        let t := E.toCollection.map (ColoredSubstitutionData.rightUnitTotalHom P)
        change HEq (n ≫ r ≫ t) (e.hom ≫ 𝟙 X)
        exact heq_of_eq ((singletonUnitLaw e n q r t (Unit.rightUnitInsertion_normalized E
          P) (E.right_unit P)).trans
          (Category.comp_id e.hom).symm)

/-- The original singleton coefficient blocks collapse to their actual
full coefficient tensor and original generalized substitution source. -/
theorem collapsedSourceA (E : ColoredOperadObj W C) (s : ColoredSubstitutionData W) (Q :
  ColoredInputs W) :
    (FiniteTensor.tensor (V := C)).map (FiniteFamily.mapSingletonFlattenIso.inv.app
      (rawFactors E.toCollection s Q)) ≫
      (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q) ≫
        (FiniteTensor.tensor (V := C)).map (collapsedFactorsA E s Q) =
      (FiniteTensor.tensor (V := C)).map (generalFactorMap E.toCollection s Q) := by
  let T := FiniteTensor.tensor (V := C)
  let K := rawFactors E.toCollection s Q
  let e := T.mapIso (FiniteFamily.mapSingletonFlattenIso.app K)
  let f := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q)
  let c := T.map ((FiniteFamily.mapIso (FiniteTensor.singletonIso (V := C))).hom.app K)
  let k := T.map (generalFactorMap E.toCollection s Q)
  have hf : f ≫ c = e.hom := (mapSingletonFlattenLaw_app K).symm
  have hm : T.map (collapsedFactorsA E s Q) = c ≫ k := T.map_comp _ _
  exact (congrArg (e.inv ≫ f ≫ ·) hm).trans (singletonSourceLaw e f c k hf)

/-- The literal inside-first E-association route is the literal generalized
substitution of the original root constants and original variable operations. -/
theorem associationRouteA_isGeneral (E : ColoredOperadObj W C) (s : ColoredSubstitutionData
  W) (Q : ColoredInputs W) :
    expandedSource E s Q ≫ ColoredOperadObj.associativityRouteA E.toCollection E.subst
      (assocData s Q) ≫
      E.toCollection.map (ColoredSubstitutionData.totalProfileMap (afterInnerCompare s Q)
        ≫ Branch.generalTotalHom s Q)
        =
        generalRoute E s Q := by
  let T := FiniteTensor.tensor (V := C)
  let d := assocData s Q
  let a := afterInnerCompare s Q
  let x := expandedSource E s Q
  let f := (FiniteTensor.flattenIso (V := C)).hom.app
    (ColoredOperadObj.AssocInsertion.groupingA E.toCollection d)
  let g := T.map (ColoredOperadObj.AssocInsertion.groupingAToFactorsHom E.toCollection E.subst d)
  let σ := E.subst.app d.outerAfterInnerData
  let q := E.toCollection.map (ColoredSubstitutionData.totalProfileMap a)
  let k := E.toCollection.map (Branch.generalTotalHom s Q)
  let h := (ColoredOperadObj.substitutionSource E.toCollection).map a
  let σ' := E.subst.app (Branch.generalSubstitution s Q)
  let n := T.map (generalFactorMap E.toCollection s Q)
  let p := T.map (FiniteFamily.mapSingletonFlattenIso.inv.app (rawFactors E.toCollection s Q))
  let r := (FiniteTensor.flattenIso (V := C)).hom.app (rawGroupsA E.toCollection s Q)
  let l := T.map (appliedMapA E s Q)
  let m := T.map (collapsedFactorsA E s Q)
  have hl : l ≫ g ≫ h = m :=
    (mapThreeRootA T _ _ _).symm.trans (congrArg T.map (appliedMapA_collapse E s Q))
  have hn : x ≫ f ≫ g ≫ h = n :=
    rootASourceFiring x f g h p r l m n (expandedSource_grouped E s Q) hl (collapsedSourceA E s Q)
  have hs : σ ≫ q = h ≫ σ' := (E.subst.naturality a).symm
  have ht : E.toCollection.map (ColoredSubstitutionData.totalProfileMap a ≫
    Branch.generalTotalHom s Q) = q ≫ k :=
    E.toCollection.map_comp _ _
  exact (Category.assoc x (ColoredOperadObj.associativityRouteA E.toCollection E.subst d)
    (E.toCollection.map (ColoredSubstitutionData.totalProfileMap a ≫
      Branch.generalTotalHom s Q))).symm.trans
      ((congrArg (fun q => (x ≫ ColoredOperadObj.associativityRouteA E.toCollection
        E.subst d) ≫ q) ht).trans
        (rootARouteFiring x f g σ q k h σ' n hs hn))


