/- Exact checked source: WeightedNormalization.LeftUnitEvaluationNormalization. -/
section EnvelopingSource200


/-!
# Normalize the exact original weighted left-unit evaluation
-/

set_option autoImplicit false
noncomputable section
universe u v w

namespace CategoryTheory.Operad.Tensor.Enveloping.Linear

open CategoryTheory

private theorem normalizeLeftEval {D : Type*} [Category* D] {A B C E F G : D}
    (w : A ⟶ B) (i : B ⟶ C) (e : C ⟶ E) (p : E ⟶ F)
    (i₀ : A ⟶ G) (n : G ⟶ C) (h : G ⟶ F)
    (hi : w ≫ i = i₀ ≫ n) (hh : n ≫ e ≫ p = h) :
    (w ≫ (i ≫ e)) ≫ p = i₀ ≫ h := by
  calc
    (w ≫ (i ≫ e)) ≫ p = (w ≫ i) ≫ e ≫ p := by simp only [Category.assoc]
    _ = (i₀ ≫ n) ≫ e ≫ p := congrArg (fun f => f ≫ e ≫ p) hi
    _ = i₀ ≫ h := by simpa only [Category.assoc] using congrArg (i₀ ≫ ·) hh

private theorem reassociateLeftCoefficient {D : Type*} [Category* D] {A B C E F : D}
    (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ E) (d : E ⟶ F) :
    (a ≫ (b ≫ c)) ≫ d = (a ≫ b) ≫ c ≫ d := by simp only [Category.assoc]

variable {W : Type u} {C : Type w} [Category.{v} C] [FiniteTensor C]

/-- Identify the sparse left unit coefficients with the coefficients indexed by substitution
slots. -/
def leftUnitSlotCoefficientIso (O : ColoredSymmetricCollection W C) (P : ColoredProfile W)
  (Q : ColoredInputs W) :
    sparseUnitScalarFamily
        (O.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
          emptyColoredInputs))
        (O.obj (extendProfile P Q)) ≅
      coefficientBlockFamily (FintypeCat.of (Option PUnit))
        (fun i => O.obj (extendProfile (envelopingSlotProfile
          (ColoredSubstitutionData.leftUnit P) i)
          (leftUnitChoices P Q i))) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option PUnit)) (fun i =>
    by cases i <;> exact Iso.refl _)

/-- Identify the empty root block and original branch leaves with the left unit algebra-input
blocks. -/
def leftUnitLeafBlocksIso (B : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    inputBlockFamily (FintypeCat.of (Option PUnit)) (UnitGeometry.leftLeaves
      ((addedAlgebraInputs B).obj Q)) ≅
      inputBlockFamily (FintypeCat.of (Option PUnit)) (fun i =>
        (addedAlgebraInputs B).obj (leftUnitChoices P Q i)) :=
  FiniteFamily.isoOfComponents (Equiv.refl (Option PUnit)) (fun i => match i with
    | none => (emptyAddedAlgebraInputsIso B).symm
    | some _ => Iso.refl _)

omit [FiniteTensor C] in
theorem leftUnitSlotCoefficientIso_named (O : ColoredSymmetricCollection W C) (P :
  ColoredProfile W) (Q : ColoredInputs
  W) :
    (leftUnitSlotCoefficientIso O P Q).hom ≫
      (envelopingCoefficientBlockIso O (ColoredSubstitutionData.leftUnit P) (leftUnitChoices
        P Q)).hom =
    (leftUnitCoefficientFamilyIso O P Q).hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i <;> exact heq_of_eq (Category.id_comp _)

theorem leftUnitWeightedFamilyIso_map (O : ColoredSymmetricCollection W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    (leftUnitWeightedFamilyIso O B P Q).hom =
      weightedInputBlockMap (FintypeCat.of (Option PUnit))
        (K := (sparseUnitScalarFamily
          (O.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
            emptyColoredInputs))
          (O.obj (extendProfile P Q))).obj)
        (K' := fun i => O.obj (extendProfile (envelopingSlotProfile
          (ColoredSubstitutionData.leftUnit P) i)
          (leftUnitChoices P Q i)))
        (L := UnitGeometry.leftLeaves ((addedAlgebraInputs B).obj Q))
        (L' := fun i => (addedAlgebraInputs B).obj (leftUnitChoices P Q i))
        (leftUnitSlotCoefficientIso O P Q).hom.hom (leftUnitLeafBlocksIso B P Q).hom.hom := by
  apply FiniteFamily.Hom_ext
  · rfl
  · intro i
    cases i with
    | none => rfl
    | some i =>
      cases i
      let T := FiniteTensor.tensor (V := C)
      let X := O.obj (extendProfile P Q)
      let L := (addedAlgebraInputs B).obj Q
      have h : T.map (coefficientLeafMap (𝟙 X) (𝟙 L)) =
        𝟙 ((coefficientLeafTensorFunctor L).obj X) :=
        (congrArg T.map (coefficientLeafMap_idLeaves (𝟙 X) L)).trans
          ((congrArg T.map ((coefficientLeafFamilyFunctor L).map_id X)).trans (T.map_id _))
      exact heq_of_eq h.symm

omit [FiniteTensor C] in
theorem leftUnitInputLeaf_map (B : W → C) (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteFamily.flatten (C := C)).map (leftUnitLeafBlocksIso B P Q).hom ≫
        (envelopingAlgebraLeafIso B (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P
          Q)).hom) ≫
      (addedAlgebraInputs B).map (leftUnitInputsIso P Q).hom =
    (UnitGeometry.leftLeavesIso ((addedAlgebraInputs B).obj Q)).hom := by
  apply FiniteFamily.Hom_ext
  · ext p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j
    | some i => cases i; rfl
  · intro p
    rcases p with ⟨i, j⟩
    cases i with
    | none => cases j
    | some i =>
      cases i
      let Y := (Discrete.functor B).obj (Q.obj j)
      change HEq ((𝟙 Y ≫ 𝟙 Y) ≫ (Discrete.functor B).map (𝟙 (Q.obj j))) (𝟙 Y)
      exact heq_of_eq ((congrArg ((𝟙 Y ≫ 𝟙 Y) ≫ ·) ((Discrete.functor B).map_id (Q.obj j))).trans
        ((Category.comp_id (𝟙 Y ≫ 𝟙 Y)).trans (Category.id_comp (𝟙 Y))))

/-- The original weighted left coefficient evaluation with both
original total-profile maps is precisely the original coefficient
operation followed by the exact original total root leaf bijection. -/
theorem leftUnitEvaluation_normalized (O : ColoredOperadObj W C) (B : W → C)
    (P : ColoredProfile W) (Q : ColoredInputs W) :
    ((FiniteTensor.tensor (V := C)).map (leftUnitWeightedFamilyIso O.toCollection B P Q).hom ≫
        envelopingRepresentativeEvaluation O B (ColoredSubstitutionData.leftUnit P)
          (leftUnitChoices P Q)) ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        (O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
          (leftUnitInputsIso P Q).hom))
        ((addedAlgebraInputs B).map (leftUnitInputsIso P Q).hom)) =
    (coefficientBlockInterchangeTensorIso (FintypeCat.of (Option PUnit))
        (sparseUnitScalarFamily
          (O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile
            P.outputColor) emptyColoredInputs))
          (O.toCollection.obj (extendProfile P Q))).obj
        (UnitGeometry.leftLeaves ((addedAlgebraInputs B).obj Q))).hom ≫
      (FiniteTensor.tensor (V := C)).map (coefficientLeafMap
        ((FiniteTensor.tensor (V := C)).map (leftUnitCoefficientFamilyIso O.toCollection P Q).hom ≫
          envelopingRepresentativeCoefficientSubstitution O
            (ColoredSubstitutionData.leftUnit P) (leftUnitChoices P Q) ≫
          O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
            (leftUnitInputsIso P
            Q).hom))
        (UnitGeometry.leftLeavesIso ((addedAlgebraInputs B).obj Q)).hom) := by
  let T := FiniteTensor.tensor (V := C)
  let s := ColoredSubstitutionData.leftUnit P
  let q := leftUnitChoices P Q
  let I := FintypeCat.of (Option PUnit)
  let L := (addedAlgebraInputs B).obj Q
  let K := sparseUnitScalarFamily
    (O.toCollection.obj (extendProfile (ColoredSubstitutionData.unitProfile P.outputColor)
      emptyColoredInputs))
    (O.toCollection.obj (extendProfile P Q))
  let K' := coefficientBlockFamily I (fun i => O.toCollection.obj (extendProfile
    (envelopingSlotProfile s i) (q i)))
  let M := UnitGeometry.leftLeaves L
  let M' := fun i => (addedAlgebraInputs B).obj (q i)
  let c := (leftUnitSlotCoefficientIso O.toCollection P Q).hom
  let ℓ := (leftUnitLeafBlocksIso B P Q).hom
  let w := T.map (leftUnitWeightedFamilyIso O.toCollection B P Q).hom
  let i := (coefficientBlockInterchangeTensorIso I K'.obj M').hom
  let i₀ := (coefficientBlockInterchangeTensorIso I K.obj M).hom
  let leaf := (FiniteFamily.flatten (C := C)).map ℓ
  let n := T.map (coefficientLeafMap (T.map c) leaf)
  let a := (envelopingCoefficientBlockIso O.toCollection s q).hom
  let b := envelopingRepresentativeCoefficientSubstitution O s q
  let l := (envelopingAlgebraLeafIso B s q).hom
  let e := T.map (coefficientLeafMap (T.map a ≫ b) l)
  let h := O.toCollection.map (extendProfileMap (ColoredSubstitutionData.leftUnitTotalHom P)
    (leftUnitInputsIso P
    Q).hom)
  let g := (addedAlgebraInputs B).map (leftUnitInputsIso P Q).hom
  let p := T.map (coefficientLeafMap h g)
  let coef := T.map (leftUnitCoefficientFamilyIso O.toCollection P Q).hom ≫ b ≫ h
  let fin := T.map (coefficientLeafMap coef (UnitGeometry.leftLeavesIso L).hom)
  have hc : coefficientBlockMap I c.hom = c := rfl
  have hℓ : inputBlockMap I ℓ.hom = ℓ := rfl
  have hn : w ≫ i = i₀ ≫ n :=
    (congrArg (· ≫ i) (congrArg T.map (leftUnitWeightedFamilyIso_map O.toCollection B P Q))).trans
      ((coefficientBlockInterchangeTensorIso_naturality I c.hom ℓ.hom).trans
        (congrArg₂ (fun c l => i₀ ≫ T.map (coefficientLeafMap (T.map c)
          ((FiniteFamily.flatten (C := C)).map l))) hc
          hℓ))
  have hi : T.map c ≫ T.map a = T.map (leftUnitCoefficientFamilyIso O.toCollection P Q).hom :=
    (T.map_comp _ _).symm.trans (congrArg T.map (leftUnitSlotCoefficientIso_named
      O.toCollection P Q))
  have hcoef : (T.map c ≫ (T.map a ≫ b)) ≫ h = coef :=
    (reassociateLeftCoefficient (T.map c) (T.map a) b h).trans (congrArg (fun c => c ≫ b ≫ h) hi)
  have hleaf : (leaf ≫ l) ≫ g = (UnitGeometry.leftLeavesIso L).hom := leftUnitInputLeaf_map B P Q
  have hfamily : coefficientLeafMap (T.map c) leaf ≫
      coefficientLeafMap (T.map a ≫ b) l ≫ coefficientLeafMap h g =
      coefficientLeafMap coef (UnitGeometry.leftLeavesIso L).hom :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ coefficientLeafMap h g) (coefficientLeafMap_comp _ _ _ _)).trans
        ((coefficientLeafMap_comp _ _ _ _).trans
          (congrArg₂ (fun c l => coefficientLeafMap c l) hcoef hleaf)))
  have hf : n ≫ e ≫ p = fin :=
    (congrArg (n ≫ ·) (T.map_comp _ _).symm).trans
      ((T.map_comp _ _).symm.trans (congrArg T.map hfamily))
  exact normalizeLeftEval w i e p i₀ n fin hn hf


end CategoryTheory.Operad.Tensor.Enveloping.Linear

