namespace CategoryTheory.Operad.Tensor.Enveloping.LinearAlgebra

open CategoryTheory

variable {W : Type u} {C : Type w} [Category.{v} C]

/-- All original root/inner constant leaves followed by every
original surviving variable leaf, with their original objects. -/
def evaluationLeafFamily (B M : W → C) (s : ColoredSubstitutionData W)
    (Q : EnvelopingInputChoices s) : FiniteFamily C where
  index := FintypeCat.of ((envelopingTotalAlgebraInputs s Q).index ⊕ s.totalProfile.inputs)
  obj p := match p with
    | Sum.inl p => B ((envelopingTotalAlgebraInputs s Q).obj p).as
    | Sum.inr p => M (s.totalProfile.inputColor p)

