set_option backward.isDefEq.respectTransparency false

/-!
# Actual tensor-generated coefficient categories and affine monodromy

The category is the full subcategory of actual finite-dimensional
representations generated by the displayed representation, the unit,
tensor products, duals, finite sums, subobjects and quotients. Its fibre
functor is the actual faithful monoidal forgetful functor. After any
coefficient algebra S it is followed by the actual monoidal scalar
extension S tensor_k -, whose unit/tensor comparisons are Mathlib's.

Tensor automorphisms are Aut of this actual lax monoidal functor.
Evaluation at the actual scalar-extended generator gives an actual matrix.
The affine model is Spec of its genuine vanishing ideal together with the
explicit determinant-inverse relation. In particular its closure is taken
inside GL_r.

References: Deligne--Milne, Tannakian Categories, Theorem 2.11,
Proposition 2.20 and Corollary 2.9.
-/

namespace MathlibExt.CategoryTheory.TensorGeneratedMonodromy

open _root_.CategoryTheory _root_.CategoryTheory.Limits _root_.CategoryTheory.MonoidalCategory
open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme
open scoped TensorProduct

universe u v

variable (k : Type u) [Field k] (Γ : Type v) [Group Γ] (r : ℕ)
  (ρ : Γ →* Matrix.GeneralLinearGroup (Fin r) k)

/-- The displayed matrices acting on the actual standard coefficient module. -/
def matrixRepresentation : Representation k Γ (Fin r → k) :=
  (Units.coeHom ((Fin r → k) →ₗ[k] (Fin r → k))).comp
    (Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp ρ)

/-- The actual generating finite-dimensional representation. -/
abbrev generatorRepresentation : FDRep k Γ := FDRep.of (matrixRepresentation k Γ r ρ)

/-- Closure by the actual operations defining the tensor-generated category. -/
inductive Generated : FDRep k Γ → Prop
  | unit : Generated (𝟙_ (FDRep k Γ))
  | generator : Generated (generatorRepresentation k Γ r ρ)
  | iso {V W : FDRep k Γ} : Generated V → (V ≅ W) → Generated W
  | tensor {V W : FDRep k Γ} : Generated V → Generated W → Generated (V ⊗ W)
  | dual {V : FDRep k Γ} : Generated V → Generated (FDRep.of (Representation.dual V.ρ))
  | sum {V W : FDRep k Γ} : Generated V → Generated W → Generated (V ⊞ W)
  | subobject {V W : FDRep k Γ} (f : V ⟶ W) [Mono f] : Generated W → Generated V
  | quotient {V W : FDRep k Γ} (f : V ⟶ W) [Epi f] : Generated V → Generated W

abbrev generatedProperty : ObjectProperty (FDRep k Γ) := Generated k Γ r ρ

instance generatedMonoidal : (generatedProperty k Γ r ρ).IsMonoidal where
  prop_unit := Generated.unit
  prop_tensor _ _ hV hW := Generated.tensor hV hW

/-- The actual tensor/subquotient-generated full subcategory. -/
abbrev GeneratedCategory := (generatedProperty k Γ r ρ).FullSubcategory

/-- Its genuine generating object. -/
def generator : GeneratedCategory k Γ r ρ :=
  ⟨generatorRepresentation k Γ r ρ, Generated.generator⟩

instance fdForgetMonoidal : (forget₂ (FDRep k Γ) (FGModuleCat k)).Monoidal :=
  inferInstanceAs ((Action.forget (FGModuleCat k) Γ).Monoidal)

instance fgForgetMonoidal : (forget₂ (FGModuleCat k) (ModuleCat k)).Monoidal :=
  inferInstanceAs ((ModuleCat.isFG k).ι.Monoidal)

/-- The actual forgetful functor to coefficient modules. -/
abbrev fibre : GeneratedCategory k Γ r ρ ⥤ ModuleCat.{u} k :=
  (generatedProperty k Γ r ρ).ι ⋙
    forget₂ (FDRep k Γ) (FGModuleCat k) ⋙ forget₂ (FGModuleCat k) (ModuleCat k)

instance fibreFaithful : (fibre k Γ r ρ).Faithful := inferInstance

instance fibreMonoidal : (fibre k Γ r ρ).Monoidal := by
  dsimp [fibre]
  infer_instance

variable (S : Type u) [CommRing S] [Algebra k S]

/-- The actual fibre after canonical coefficient extension. -/
abbrev scalarFibre : GeneratedCategory k Γ r ρ ⥤ ModuleCat.{u} S :=
  fibre k Γ r ρ ⋙ ModuleCat.extendScalars (algebraMap k S)

instance scalarFibreMonoidal : (scalarFibre k Γ r ρ S).Monoidal := inferInstance

/-- The actual strong monoidal fibre functor, regarded as lax monoidal. -/
def tensorFibre : LaxMonoidalFunctor (GeneratedCategory k Γ r ρ) (ModuleCat.{u} S) where
  toFunctor := scalarFibre k Γ r ρ S

/-- Actual tensor automorphisms, including their naturality and tensor/unit laws. -/
abbrev TensorAutomorphisms := Aut (tensorFibre k Γ r ρ S)

/-- The genuine base-changed standard basis of the generating coefficient module. -/
def scalarGeneratorBasis : Module.Basis (Fin r) S
    ((scalarFibre k Γ r ρ S).obj (generator k Γ r ρ)) := by
  let : Algebra k S := (algebraMap k S).toAlgebra
  exact (Pi.basisFun k (Fin r)).baseChange S

/-- The actual component of a tensor automorphism on the generator. -/
def generatorComponent (η : TensorAutomorphisms k Γ r ρ S) :
    (scalarFibre k Γ r ρ S).obj (generator k Γ r ρ) ≅
      (scalarFibre k Γ r ρ S).obj (generator k Γ r ρ) where
  hom := η.asIso.hom.hom.app (generator k Γ r ρ)
  inv := η.asIso.inv.hom.app (generator k Γ r ρ)
  hom_inv_id := by
    simpa only [tensorFibre, LaxMonoidalFunctor.comp_hom, LaxMonoidalFunctor.id_hom,
      NatTrans.comp_app, NatTrans.id_app] using congrArg
      (fun f : tensorFibre k Γ r ρ S ⟶ tensorFibre k Γ r ρ S ↦
        f.hom.app (generator k Γ r ρ)) η.asIso.hom_inv_id
  inv_hom_id := by
    simpa only [tensorFibre, LaxMonoidalFunctor.comp_hom, LaxMonoidalFunctor.id_hom,
      NatTrans.comp_app, NatTrans.id_app] using congrArg
      (fun f : tensorFibre k Γ r ρ S ⟶ tensorFibre k Γ r ρ S ↦
        f.hom.app (generator k Γ r ρ)) η.asIso.inv_hom_id

/-- Evaluation in the actual scalar-extended basis, as an invertible matrix. -/
def generatorMatrix (η : TensorAutomorphisms k Γ r ρ S) :
    Matrix.GeneralLinearGroup (Fin r) S :=
  (Matrix.GeneralLinearGroup.toLin' (scalarGeneratorBasis k Γ r ρ S)).symm
    (LinearMap.GeneralLinearGroup.ofLinearEquiv
      (generatorComponent k Γ r ρ S η).toLinearEquiv)

end TensorGeneratedMonodromy

namespace TensorGeneratedMonodromy

open _root_.CategoryTheory
open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme

universe u v

variable (k : Type u) [Field k] (Γ : Type v) [Group Γ] (r : ℕ)
  (ρ : Γ →* Matrix.GeneralLinearGroup (Fin r) k)

/-- Matrix coordinates plus a genuine determinant-inverse coordinate. -/
abbrev GLVariables := (Fin r × Fin r) ⊕ Unit

/-- The actual coordinates of an invertible matrix. -/
def glCoordinates {S : Type u} [CommRing S] (g : Matrix.GeneralLinearGroup (Fin r) S) :
    GLVariables r → S :=
  Sum.elim (fun ij ↦ g.val ij.1 ij.2) (fun _ ↦ (g⁻¹).val.det)

/-- The universal matrix in its genuine polynomial coordinate ring. -/
def universalMatrix : Matrix (Fin r) (Fin r) (MvPolynomial (GLVariables r) k) :=
  fun i j ↦ MvPolynomial.X (Sum.inl (i, j))

/-- The explicit relation u det(X)-1 ensuring the scheme lies inside GL_r. -/
def determinantInverseRelation : MvPolynomial (GLVariables r) k :=
  (universalMatrix k r).det * MvPolynomial.X (Sum.inr ()) - 1

/-- The actual ideal of polynomial functions vanishing on the displayed image. -/
def vanishingIdeal : Ideal (MvPolynomial (GLVariables r) k) :=
  ⨅ γ : Γ, RingHom.ker (MvPolynomial.eval (glCoordinates r (ρ γ)))

/-- Retain the determinant-inverse relation explicitly in the affine model. -/
def definingIdeal : Ideal (MvPolynomial (GLVariables r) k) :=
  Ideal.span {determinantInverseRelation k r} + vanishingIdeal k Γ r ρ

/-- The genuine affine coordinate ring of the closure inside GL_r. -/
abbrev MonodromyCoordinateRing := MvPolynomial (GLVariables r) k ⧸ definingIdeal k Γ r ρ

/-- The actual affine scheme, never a freely selected monodromy-group carrier. -/
abbrev MonodromyScheme : Scheme.{u} := Spec (.of (MonodromyCoordinateRing k Γ r ρ))

/-- The actual coefficient-algebra point condition of this closed affine model. -/
def IsMonodromyPoint (S : Type u) [CommRing S] [Algebra k S]
    (g : Matrix.GeneralLinearGroup (Fin r) S) : Prop :=
  ∀ p ∈ definingIdeal k Γ r ρ,
    MvPolynomial.eval₂ (algebraMap k S) (glCoordinates r g) p = 0

end TensorGeneratedMonodromy

end MathlibExt.CategoryTheory
