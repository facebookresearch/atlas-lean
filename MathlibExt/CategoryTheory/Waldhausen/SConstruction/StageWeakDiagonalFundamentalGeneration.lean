module

public import
  MathlibExt.CategoryTheory.Waldhausen.SConstruction.StageWeakDiagonalEdgeNormalization
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Object-edge generation of the weak-diagonal fundamental group

Every morphism in the simplicial fundamental groupoid is normalized to the
zero vertex using the coherent E0 connectors.  E3 identifies a normalized
edge with a canonical object edge; `FundamentalGroupoid.hom_rec` then shows
that every based endomorphism lies in the subgroup generated by object edges.

This argument is entirely combinatorial.  It defines no K-zero valuation or
encode map, proves no commutativity or K-zero relation, and makes no geometric
realization, loop-space, approximation, additivity, spectrum, or Q/S claim.
-/

@[expose] public section

noncomputable section

open CategoryTheory Limits Opposite Simplicial
open scoped Simplicial

universe v u

namespace CategoryTheory.Waldhausen.SConstruction

variable (C : Type u) [Category.{v} C] [HasZeroObject C]
  [WaldhausenCategoryWithoutGluing C]

/-- Based endomorphism group of the combinatorial fundamental groupoid at
the canonical zero vertex. -/
noncomputable abbrev stageWeakDiagonalFundamentalGroup :=
  CategoryTheory.End
    (SSet.FundamentalGroupoid.mk (stageWeakDiagonalZeroVertex C))

/-- Canonical based generator associated to an object of the Waldhausen
category. -/
noncomputable def stageWeakDiagonalObjectGenerator (A : C) :
    stageWeakDiagonalFundamentalGroup C :=
  End.of (SSet.FundamentalGroupoid.homMk (stageWeakDiagonalObjectEdge C A))

/-- Subgroup generated by all canonical object edges.  Subgroup closure
includes their inverses and finite products. -/
noncomputable def stageWeakDiagonalObjectGeneratorSubgroup :
    Subgroup (stageWeakDiagonalFundamentalGroup C) :=
  Subgroup.closure (Set.range (stageWeakDiagonalObjectGenerator C))

/-- Each object generator belongs to the subgroup it generates. -/
theorem stageWeakDiagonalObjectGenerator_mem (A : C) :
    stageWeakDiagonalObjectGenerator C A ∈
      stageWeakDiagonalObjectGeneratorSubgroup C :=
  Subgroup.subset_closure (Set.mem_range_self A)

/-- Canonical connector morphism from the based zero object to an arbitrary
object of the combinatorial fundamental groupoid. -/
noncomputable def stageWeakDiagonalConnectorHom
    (p : SSet.FundamentalGroupoid (stageWeakDiagonal C)) :
    SSet.FundamentalGroupoid.mk (stageWeakDiagonalZeroVertex C) ⟶ p :=
  SSet.FundamentalGroupoid.rec
    (fun x => SSet.FundamentalGroupoid.homMk
      (stageWeakDiagonalZeroToVertexEdge C x)) p

set_option backward.isDefEq.respectTransparency false in
/-- Connector computation on a represented fundamental-groupoid object. -/
@[simp]
theorem stageWeakDiagonalConnectorHom_mk
    (x : (stageWeakDiagonal C).obj (op ⦋0⦌)) :
    stageWeakDiagonalConnectorHom C (SSet.FundamentalGroupoid.mk x) =
      SSet.FundamentalGroupoid.homMk
        (stageWeakDiagonalZeroToVertexEdge C x) :=
  rfl

/-- Conjugate a fundamental-groupoid morphism to an endomorphism at the zero
vertex using the coherent connectors. -/
noncomputable def stageWeakDiagonalNormalizedHom
    {p q : SSet.FundamentalGroupoid (stageWeakDiagonal C)} (f : p ⟶ q) :
    stageWeakDiagonalFundamentalGroup C :=
  End.of ((stageWeakDiagonalConnectorHom C p ≫ f) ≫
    inv (stageWeakDiagonalConnectorHom C q))

/-- The actual zero-connector edge represents the identity fundamental-groupoid morphism. -/
@[simp]
theorem stageWeakDiagonalConnectorEdge_homMk_zero :
    SSet.FundamentalGroupoid.homMk
        (stageWeakDiagonalZeroToVertexEdge C (stageWeakDiagonalZeroVertex C)) =
      𝟙 _ := by
  have hEdge :
      stageWeakDiagonalZeroToVertexEdge C (stageWeakDiagonalZeroVertex C) =
        stageWeakDiagonalZeroToObjEdge C
          (⟨stageZero C⟩ : StageWeakCategory C 0) := by
    apply SSet.Edge.ext
    exact stageWeakDiagonalZeroToVertexEdge_edge C _
  change SSet.FundamentalGroupoid.homMk
      (stageWeakDiagonalZeroToVertexEdge C
        (stageWeakDiagonalZeroVertex C)) = 𝟙 _
  rw [hEdge]
  exact stageWeakDiagonalZeroToObjEdge_zero_homMk C

/-- At the zero vertex, the canonical connector is the identity. -/
theorem stageWeakDiagonalConnectorHom_zero :
    stageWeakDiagonalConnectorHom C
        (SSet.FundamentalGroupoid.mk (stageWeakDiagonalZeroVertex C)) =
      𝟙 _ := by
  rw [stageWeakDiagonalConnectorHom_mk]
  exact stageWeakDiagonalConnectorEdge_homMk_zero C

/-- Normalization does nothing to an endomorphism already based at the zero
vertex. -/
@[simp]
theorem stageWeakDiagonalNormalizedHom_end
    (f : stageWeakDiagonalFundamentalGroup C) :
    stageWeakDiagonalNormalizedHom C f.asHom = f := by
  apply End.ext
  change (stageWeakDiagonalConnectorHom C
      (SSet.FundamentalGroupoid.mk (stageWeakDiagonalZeroVertex C)) ≫ f.asHom) ≫
        inv (stageWeakDiagonalConnectorHom C
          (SSet.FundamentalGroupoid.mk (stageWeakDiagonalZeroVertex C))) = f.asHom
  rw [stageWeakDiagonalConnectorHom_zero]
  simp only [Category.id_comp, IsIso.inv_id, Category.comp_id]

/-- Normalization commutes with groupoid inversion. -/
theorem stageWeakDiagonalNormalizedHom_inv
    {p q : SSet.FundamentalGroupoid (stageWeakDiagonal C)} (f : p ⟶ q) :
    stageWeakDiagonalNormalizedHom C (inv f) =
      (stageWeakDiagonalNormalizedHom C f)⁻¹ := by
  apply End.ext
  change
    (stageWeakDiagonalConnectorHom C q ≫ inv f) ≫
        inv (stageWeakDiagonalConnectorHom C p) =
      Groupoid.inv
        ((stageWeakDiagonalConnectorHom C p ≫ f) ≫
          inv (stageWeakDiagonalConnectorHom C q))
  rw [Groupoid.inv_eq_inv, IsIso.inv_comp, IsIso.inv_comp,
    IsIso.inv_inv]
  simp only [Category.assoc]

/-- Normalization sends categorical composition to multiplication in the
reversed order forced by `CategoryTheory.End.mul_asHom`. -/
theorem stageWeakDiagonalNormalizedHom_comp
    {p q r : SSet.FundamentalGroupoid (stageWeakDiagonal C)}
    (f : p ⟶ q) (g : q ⟶ r) :
    stageWeakDiagonalNormalizedHom C (f ≫ g) =
      stageWeakDiagonalNormalizedHom C g *
        stageWeakDiagonalNormalizedHom C f := by
  apply End.ext
  simp [stageWeakDiagonalNormalizedHom, CategoryTheory.End.mul_asHom,
    Category.assoc]

/-- E3 identifies the normalization of an edge with the canonical object
generator from the `(0, 1)` evaluation of its recovered left Stage-one
object. -/
theorem stageWeakDiagonalNormalizedHom_homMk
    {x y : (stageWeakDiagonal C).obj (op ⦋0⦌)}
    (e : (stageWeakDiagonal C).Edge x y) :
    stageWeakDiagonalNormalizedHom C
        (SSet.FundamentalGroupoid.homMk e) =
      stageWeakDiagonalObjectGenerator C
        ((stageOneEval C).obj (ComposableArrows.left e.edge).obj) := by
  apply End.ext
  simpa only [stageWeakDiagonalNormalizedHom,
    stageWeakDiagonalConnectorHom_mk,
    stageWeakDiagonalObjectGenerator] using
      stageWeakDiagonalEdge_normalization C e

/-- Every connector-normalized morphism, at arbitrary endpoints, belongs to
the subgroup generated by object edges. -/
theorem stageWeakDiagonalNormalizedHom_mem
    {p q : SSet.FundamentalGroupoid (stageWeakDiagonal C)} (f : p ⟶ q) :
    stageWeakDiagonalNormalizedHom C f ∈
      stageWeakDiagonalObjectGeneratorSubgroup C := by
  induction f using SSet.FundamentalGroupoid.hom_rec with
  | homMk e =>
      rw [stageWeakDiagonalNormalizedHom_homMk]
      exact stageWeakDiagonalObjectGenerator_mem C _
  | inv f hf =>
      rw [stageWeakDiagonalNormalizedHom_inv]
      exact (stageWeakDiagonalObjectGeneratorSubgroup C).inv_mem hf
  | comp f g hf hg =>
      rw [stageWeakDiagonalNormalizedHom_comp]
      exact (stageWeakDiagonalObjectGeneratorSubgroup C).mul_mem hg hf

/-- Every based endomorphism belongs to the subgroup generated by object
edges. -/
theorem stageWeakDiagonalFundamentalGroup_mem_objectGenerators
    (f : stageWeakDiagonalFundamentalGroup C) :
    f ∈ stageWeakDiagonalObjectGeneratorSubgroup C := by
  rw [← stageWeakDiagonalNormalizedHom_end C f]
  exact stageWeakDiagonalNormalizedHom_mem C f.asHom

/-- Canonical object edges generate the entire based combinatorial
fundamental group. -/
theorem stageWeakDiagonalObjectGeneratorSubgroup_eq_top :
    stageWeakDiagonalObjectGeneratorSubgroup C = ⊤ :=
  (Subgroup.eq_top_iff'
    (stageWeakDiagonalObjectGeneratorSubgroup C)).2
    (stageWeakDiagonalFundamentalGroup_mem_objectGenerators C)

end CategoryTheory.Waldhausen.SConstruction

end
