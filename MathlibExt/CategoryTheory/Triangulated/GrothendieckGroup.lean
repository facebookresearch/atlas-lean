module

public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.CategoryTheory.Triangulated.Triangulated
public import Mathlib.Tactic.Abel

/-!
# The actual triangulated Grothendieck group and class map

This is the object presentation of triangulated K0: the actual free
abelian group on objects modulo isomorphisms and actual distinguished
triangles. Its ordinary class, triangle and universal-map operations
are shared dependencies for numerical stability statements.

Source: Weibel, *The K-book*, Exercise II.9.15; the completed public Tau
presentation cited above. This module asserts no existence of stability
conditions or any numerical lattice of an arbitrary variety.
-/

@[expose] public noncomputable section

namespace MathlibExt.CategoryTheory.TriangulatedGrothendieck

open _root_.CategoryTheory _root_.CategoryTheory.Limits
open _root_.CategoryTheory.Pretriangulated
open scoped ZeroObject

universe u v

variable (C : Type u) [Category.{v} C] [Preadditive C] [HasZeroObject C]
  [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- Actual isomorphism and distinguished-triangle relation generators. -/
def relationGenerators : Set (FreeAbelianGroup C) :=
  {r | (∃ X Y : C, Nonempty (X ≅ Y) ∧
      r = FreeAbelianGroup.of X - FreeAbelianGroup.of Y) ∨
    ∃ T : Triangle C, T ∈ distTriang C ∧ r =
      FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃}

/-- The actual subgroup generated by those concrete relations. -/
def relations : AddSubgroup (FreeAbelianGroup C) := AddSubgroup.closure (relationGenerators C)

/-- Triangulated K0 as an actual quotient, without an essential-smallness oracle. -/
abbrev K0 := FreeAbelianGroup C ⧸ relations C

/-- The canonical class of an actual object. -/
def classOf (X : C) : K0 C := (QuotientAddGroup.mk' (relations C)) (FreeAbelianGroup.of X)

variable {C}

/-- Isomorphic objects have the same actual class. -/
theorem classOf_iso {X Y : C} (e : X ≅ Y) : classOf C X = classOf C Y := by
  have hg : FreeAbelianGroup.of X - FreeAbelianGroup.of Y ∈ relations C :=
    AddSubgroup.subset_closure (Or.inl ⟨X, Y, ⟨e⟩, rfl⟩)
  exact (QuotientAddGroup.mk'_eq_mk' (relations C)).mpr
    ⟨-(FreeAbelianGroup.of X - FreeAbelianGroup.of Y),
      (relations C).neg_mem hg, by abel⟩

/-- Actual distinguished triangles impose their defining K0 relation. -/
theorem classOf_triangle {T : Triangle C} (hT : T ∈ distTriang C) :
    classOf C T.obj₂ = classOf C T.obj₁ + classOf C T.obj₃ := by
  have hg : FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ -
      FreeAbelianGroup.of T.obj₃ ∈ relations C :=
    AddSubgroup.subset_closure (Or.inr ⟨T, hT, rfl⟩)
  dsimp only [classOf]
  rw [← map_add]
  exact (QuotientAddGroup.mk'_eq_mk' (relations C)).mpr
    ⟨-(FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ -
        FreeAbelianGroup.of T.obj₃), (relations C).neg_mem hg, by abel⟩

@[simp]
theorem classOf_zero : classOf C (0 : C) = 0 := by
  have h : classOf C (0 : C) = classOf C (0 : C) + classOf C (0 : C) :=
    classOf_triangle (contractible_distinguished (0 : C))
  simpa using h

/-- The cohomological shift has its genuine negative K0 class. -/
theorem classOf_shift_one (X : C) : classOf C (X⟦(1 : ℤ)⟧) = -classOf C X :=
  eq_neg_of_add_eq_zero_right
    ((classOf_triangle (contractible_distinguished₂ X)).symm.trans classOf_zero)

/-- Actual object invariants which are additive on the distinguished triangles. -/
structure AdditiveInvariant (G : Type*) [AddCommGroup G] where
  value : C → G
  isomorphic : ∀ {X Y : C}, Nonempty (X ≅ Y) → value X = value Y
  triangle : ∀ T : Triangle C, T ∈ distTriang C → value T.obj₂ = value T.obj₁ + value T.obj₃

/-- The source-proved presentation construction descends an actual invariant. -/
def AdditiveInvariant.desc {G : Type*} [AddCommGroup G] (a : AdditiveInvariant (C := C) G) :
    K0 C →+ G :=
  QuotientAddGroup.lift (relations C) (FreeAbelianGroup.lift a.value) (by
    apply (AddSubgroup.closure_le _).mpr
    intro r hr
    change (FreeAbelianGroup.lift a.value) r = 0
    rcases hr with ⟨X, Y, hXY, rfl⟩ | ⟨T, hT, rfl⟩
    · simp [a.isomorphic hXY]
    · simp only [map_sub, FreeAbelianGroup.lift_apply_of]
      rw [a.triangle T hT]
      abel)

@[simp]
theorem AdditiveInvariant.desc_classOf {G : Type*} [AddCommGroup G]
    (a : AdditiveInvariant (C := C) G) (X : C) : a.desc (classOf C X) = a.value X := by
  simp [AdditiveInvariant.desc, classOf]

end MathlibExt.CategoryTheory.TriangulatedGrothendieck
