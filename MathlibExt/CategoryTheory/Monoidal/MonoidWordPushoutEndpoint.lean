/-- The original full-word comparison normalizes the complete reduction through its exact original count. -/
theorem inverseNewWord_reduction (A : Mon C) {K L : C} (k : K ⟶ A.X) (n : ℕ) :
    eqToHom (wordObj_allNew A K L n).symm ≫ wordReductionToNew A k (Word.allNew n) =
      eqToHom (congrArg (newWordObj A L) (Word.kept_allNew n)).symm := by
  apply (cancel_mono (eqToHom (congrArg (newWordObj A L) (Word.kept_allNew n)))).mp
  rw [Category.assoc, wordReductionToNew_allNew, eqToHom_trans, eqToHom_refl,
    eqToHom_trans, eqToHom_refl]

