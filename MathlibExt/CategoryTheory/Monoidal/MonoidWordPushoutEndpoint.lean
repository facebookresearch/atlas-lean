  exact hh

/-- The actual original left proper-face relations are retained by the entire original word multiplication. -/
theorem rawStageMul_leftRelations (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) :
    (stageRelationLeft A L k N ▷ stageWords A L M) ≫ rawStageMul A k f N M =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ rawStageMul A k f N M := by
  apply sigma_tensor_hom_ext (fun c : CellFace N => wordObj A K L c.word)
    (fun j : Fin (M + 1) => newWordObj A L j.val)
  intro c j
  change (Sigma.ι (fun c : CellFace N => wordObj A K L c.word) c ⊗ₘ
      stageWordι A L M j.val (Nat.le_of_lt_succ j.isLt)) ≫
      ((stageRelationLeft A L k N ▷ stageWords A L M) ≫ rawStageMul A k f N M) =
    (Sigma.ι (fun c : CellFace N => wordObj A K L c.word) c ⊗ₘ
      stageWordι A L M j.val (Nat.le_of_lt_succ j.isLt)) ≫
      ((stageRelationRight A f N ▷ stageWords A L M) ≫ rawStageMul A k f N M)
  rw [rawStageMul_leftReduction, rawStageMul_leftFace]
  exact wordStage_relation_rightNew A k f (N + M) c.word j.val
    (Nat.add_le_add c.bound (Nat.le_of_lt_succ j.isLt)) c.proper

/-- The actual original right proper-face relations are retained by the entire original word multiplication. -/
theorem rawStageMul_rightRelations (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) :
    (stageWords A L N ◁ stageRelationLeft A L k M) ≫ rawStageMul A k f N M =
      (stageWords A L N ◁ stageRelationRight A f M) ≫ rawStageMul A k f N M := by
  apply sigma_tensor_hom_ext (fun i : Fin (N + 1) => newWordObj A L i.val)
    (fun c : CellFace M => wordObj A K L c.word)
  intro i c
  change (stageWordι A L N i.val (Nat.le_of_lt_succ i.isLt) ⊗ₘ
      Sigma.ι (fun c : CellFace M => wordObj A K L c.word) c) ≫
      ((stageWords A L N ◁ stageRelationLeft A L k M) ≫ rawStageMul A k f N M) =
    (stageWordι A L N i.val (Nat.le_of_lt_succ i.isLt) ⊗ₘ
      Sigma.ι (fun c : CellFace M => wordObj A K L c.word) c) ≫
      ((stageWords A L N ◁ stageRelationRight A f M) ≫ rawStageMul A k f N M)
  rw [rawStageMul_rightReduction, rawStageMul_rightFace]
  exact wordStage_relation_leftNew A k f (N + M) i.val c.word
    (Nat.add_le_add (Nat.le_of_lt_succ i.isLt) c.bound) c.proper

/-- The actual original stage multiplication is constructed by both actual original stage universal properties. -/
def stageMul (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) :
    stage A k f N ⊗ stage A k f M ⟶ stage A k f (N + M) :=
  stageTensorDesc A k f N M (rawStageMul A k f N M)
    (rawStageMul_leftRelations A k f N M) (rawStageMul_rightRelations A k f N M)

/-- Every actual original word pair retains its exact concatenation component of stage multiplication. -/
@[reassoc (attr := simp)] theorem stageMul_wordLeg (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (N M n m : ℕ) (hn : n ≤ N) (hm : m ≤ M) :
    (stageWordLeg A k f N n hn ⊗ₘ stageWordLeg A k f M m hm) ≫ stageMul A k f N M =
      wordConcat A L n m ≫ stageWordLeg A k f (N + M) (n + m) (Nat.add_le_add hn hm) := by
  dsimp only [stageWordLeg, stageMul]
  rw [← tensorHom_comp_tensorHom, Category.assoc, stageTensorDesc_projection, rawStageMul_wordι]
  rfl

/-- The actual original stage multiplications retain every original transition in both variables. -/
theorem stageMul_naturality (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    {N M N' M' : ℕ} (hN : N ≤ N') (hM : M ≤ M') :
    (stageMap A k f hN ⊗ₘ stageMap A k f hM) ≫ stageMul A k f N' M' =
      stageMul A k f N M ≫ stageMap A k f (Nat.add_le_add hN hM) := by
  apply stage_tensor_hom_ext A k f N M
  intro n m hn hm
  rw [← Category.assoc, tensorHom_comp_tensorHom, stageWordLeg_map, stageWordLeg_map, stageMul_wordLeg,
    stageMul_wordLeg_assoc, stageWordLeg_map]

