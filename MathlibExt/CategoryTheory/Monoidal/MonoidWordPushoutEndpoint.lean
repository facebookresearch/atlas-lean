/-- Insert the original old units before and after one original new letter. -/
def wordLetter (A : Mon C) (L : C) : L ⟶ newWordObj A L 1 :=
  (λ_ L).inv ≫ (A.mon.one ▷ L) ≫ (ρ_ (A.X ⊗ L)).inv ≫ ((A.X ⊗ L) ◁ A.mon.one)

/-- The actual original new-letter map enters its original first word stage and countable endpoint. -/
def endpointLetter (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) : L ⟶ stageEndpoint A k f :=
  wordLetter A L ≫ endpointWordLeg A k f 1

