/-- The original right input count transport retains the entire original summed word-stage map. -/
theorem wordSum_rightTransport (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (R n : ℕ)
    {m m' : ℕ} (e : m = m') (h : n + m ≤ R) {X : C} (u : X ⟶ newWordObj A L n) :
    (u ⊗ₘ eqToHom (congrArg (newWordObj A L) e)) ≫ wordConcat A L n m' ≫
        stageWordLeg A k f R (n + m') (congrArg (n + ·) e ▸ h) =
      (u ⊗ₘ 𝟙 (newWordObj A L m)) ≫ wordConcat A L n m ≫ stageWordLeg A k f R (n + m) h := by
  cases e
  rw [eqToHom_refl]

