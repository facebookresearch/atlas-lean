/-- The original left input count transport retains the entire original summed word-stage map. -/
theorem wordSum_leftTransport (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (R m : ℕ)
    {n n' : ℕ} (e : n = n') (h : n + m ≤ R) {X : C} (u : X ⟶ newWordObj A L m) :
    (eqToHom (congrArg (newWordObj A L) e) ⊗ₘ u) ≫ wordConcat A L n' m ≫
        stageWordLeg A k f R (n' + m) (congrArg (· + m) e ▸ h) =
      (𝟙 (newWordObj A L n) ⊗ₘ u) ≫ wordConcat A L n m ≫ stageWordLeg A k f R (n + m) h := by
  cases e
  rw [eqToHom_refl]

