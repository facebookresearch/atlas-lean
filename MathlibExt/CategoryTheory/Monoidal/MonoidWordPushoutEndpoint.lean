/-- Every original pair of word-family inclusions retains its entire original tensor component. -/
@[reassoc (attr := simp)] theorem wordPairsDesc_ι (A : Mon C) (L : C) (N M : ℕ) {X : C}
    (u : ∀ (i : Fin (N + 1)) (j : Fin (M + 1)), newWordObj A L i.val ⊗ newWordObj A L j.val ⟶ X)
    (i : Fin (N + 1)) (j : Fin (M + 1)) :
    (Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
      Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ≫ wordPairsDesc A L N M u = u i j := by
  have h := (stageWordsTensorIsColimit A L N M).fac (wordPairsCocone A L N M u) (⟨i⟩, ⟨j⟩)
  dsimp only [Cocone.tensor₂, Functor.mapCocone₂] at h
  simp only [curriedTensor_map_app, curriedTensor_obj_map, Functor.const_obj_obj,
    ← tensorHom_def] at h
  change (Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
    Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ≫ wordPairsDesc A L N M u = u i j at h
  exact h

/-- Concatenate every actual original finite pair of full words into its actual summed word stage. -/
def rawStageMul (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) :
    stageWords A L N ⊗ stageWords A L M ⟶ stage A k f (N + M) :=
  wordPairsDesc A L N M (fun i j => wordConcat A L i.val j.val ≫
    stageWordLeg A k f (N + M) (i.val + j.val)
      (Nat.add_le_add (Nat.le_of_lt_succ i.isLt) (Nat.le_of_lt_succ j.isLt)))

/-- The actual original finite-word multiplication retains the entire original concatenation component. -/
@[reassoc (attr := simp)] theorem rawStageMul_wordι (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (N M n m : ℕ) (hn : n ≤ N) (hm : m ≤ M) :
    (stageWordι A L N n hn ⊗ₘ stageWordι A L M m hm) ≫ rawStageMul A k f N M =
      wordConcat A L n m ≫ stageWordLeg A k f (N + M) (n + m) (Nat.add_le_add hn hm) :=
  wordPairsDesc_ι A L N M _ ⟨n, Nat.lt_succ_of_le hn⟩ ⟨m, Nat.lt_succ_of_le hm⟩

