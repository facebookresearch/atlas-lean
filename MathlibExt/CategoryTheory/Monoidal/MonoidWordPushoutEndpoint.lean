/-- The original old units cancel on both sides of one original target value. -/
@[reassoc] theorem wordLetter_mul (A : Mon C) :
    wordLetter A A.X ≫ (A.mon.mul ▷ A.X) ≫ A.mon.mul = 𝟙 A.X := by
  dsimp only [wordLetter]
  simp only [Category.assoc]
  rw [whisker_exchange_assoc, ← rightUnitor_inv_naturality_assoc, MonObj.one_mul_assoc,
    Iso.inv_hom_id_assoc, A.mon.mul_one, Iso.inv_hom_id]

