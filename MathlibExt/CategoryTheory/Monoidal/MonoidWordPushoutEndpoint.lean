/-- The actual original old unit is retained by every original compatible endpoint evaluation. -/
@[reassoc (attr := simp)] theorem endpointOne_evaluation (A M : Mon C) (b : A ⟶ M) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (g : L ⟶ M.X) (h : k ≫ b.hom = f ≫ g) :
    endpointOne A k f ≫ endpointEvaluation A M b k f g h = M.mon.one := by
  dsimp only [endpointOne]
  rw [endpointWordLeg_zero, Category.assoc, rootMap_endpointEvaluation]
  exact IsMonHom.one_hom b.hom

