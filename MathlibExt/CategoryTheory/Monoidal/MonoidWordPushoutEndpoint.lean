  have hh := congrArg (fun t => (t ▷ L) ▷ A.X) M.act_one
  simp only [comp_whiskerRight] at hh
  have hm : (M.X ◁ ((A.mon.one ▷ L) ▷ A.X)) ≫ snocTensor A M.X A.X L ≫
      (M.act ▷ L) ▷ A.X = snocTensor A M.X (𝟙_ C) L ≫ ((ρ_ M.X).hom ▷ L) ▷ A.X := by
    rw [snocTensor_naturalityRight_assoc, hh]
  rw [rawWordLetter_factor]
  simp only [whiskerLeft_comp, Category.assoc]
  rw [hm]
  dsimp only [snocTensor]
  monoidal

