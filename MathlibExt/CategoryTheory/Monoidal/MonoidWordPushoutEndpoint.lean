/-- The constructed original endpoint unit and multiplication satisfy the complete original right-unit law. -/
theorem endpointMul_one (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) :
    (stageEndpoint A k f ◁ endpointOne A k f) ≫ endpointMul A k f = (ρ_ (stageEndpoint A k f)).hom := by
  apply endpoint_unitRight_hom_ext A k f
  intro n
  calc
    (endpointWordLeg A k f n ▷ 𝟙_ C) ≫ (stageEndpoint A k f ◁ endpointOne A k f) ≫ endpointMul A k f =
        (endpointWordLeg A k f n ⊗ₘ endpointOne A k f) ≫ endpointMul A k f := by
      rw [← Category.assoc, tensorHom_def]
    _ = (𝟙 (newWordObj A L n) ⊗ₘ A.mon.one) ≫
        (endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f 0) ≫ endpointMul A k f := by
      rw [endpointOne, ← Category.assoc, tensorHom_comp_tensorHom, Category.id_comp]
    _ = (newWordObj A L n ◁ A.mon.one) ≫ wordConcat A L n 0 ≫ endpointWordLeg A k f n := by
      rw [endpointMul_word, id_tensorHom]
      simp only [Nat.add_zero]
    _ = (ρ_ (newWordObj A L n)).hom ≫ endpointWordLeg A k f n := by
      rw [← Category.assoc, wordConcat_rightUnit]
    _ = (endpointWordLeg A k f n ▷ 𝟙_ C) ≫ (ρ_ (stageEndpoint A k f)).hom :=
      (rightUnitor_naturality (endpointWordLeg A k f n)).symm

