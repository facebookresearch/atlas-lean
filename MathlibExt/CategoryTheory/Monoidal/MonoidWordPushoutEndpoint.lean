set_option backward.isDefEq.respectTransparency false in
/-- The underlying original monoid pushout is the colimit of the entire actual original word-stage diagram. -/
def pushoutStagesIsColimit (A : Mon C) {K L : C} (f : K ⟶ L) (a : tensorWordMon K ⟶ A) :
    IsColimit (pushoutStagesCocone A f a) :=
  (originalStagesIsColimit A (attachingValue A a) f).ofIsoColimit
    (Cocone.ext (endpointPushoutCarrierIso A f a) (fun _ => rfl))

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The source of the entire actual countable filtration is precisely the full original old monoid carrier map. -/
@[simp] theorem pushoutStages_source (A : Mon C) {K L : C} (f : K ⟶ L) (a : tensorWordMon K ⟶ A) :
    (pushoutStagesCocone A f a).ι.app 0 = (oldι A f a).hom := by
  change (originalStagesCocone A (attachingValue A a) f).ι.app 0 ≫ endpointToPushout A f a =
    (oldι A f a).hom
  rw [originalStages_rootMap]
  exact congrArg Mon.Hom.hom (endpointOldMap_toPushout A f a)

/-- Each literal original subset is collapsed by its original attaching value
and adjacent old multiplications into its own actual earlier stage. -/
def originalVertexValue (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    {n : ℕ} (S : FiniteCube.Index n) : literalVertex A K L S ⟶ originalStage A k f S.card :=
  vertexCollapse A k S ≫ stageWordLeg A k f S.card S.card (Nat.le_refl _) ≫
    (stageComparison A k f S.card).inv

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
omit [SymmetricCategory C] [MonoidalClosed C] in
/-- Every original punctured cube face contracts into its actual original `P_|S|`
before the actual original transition into the predecessor stage, including `P_0 = A.X`. -/
@[reassoc] theorem originalAttachingFace (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (n : ℕ) (S : FiniteCube.Punctured (n + 1)) :
    FiniteCube.boundaryι (wordCube A f (n + 1)) S ≫ originalAttachingMap A k f n =
      originalVertexValue A k f S.1 ≫ (originalStageDiagram A k f).map
        (homOfLE (Nat.le_of_lt_succ (FiniteCube.card_lt S))) := by
  change FiniteCube.boundaryι (wordCube A f (n + 1)) S ≫
      (attachingMap A k f n ≫ (stageComparison A k f n).inv) =
    (vertexCollapse A k S.1 ≫ stageWordLeg A k f S.1.card S.1.card (Nat.le_refl _) ≫
      (stageComparison A k f S.1.card).inv) ≫
      ((stageComparison A k f S.1.card).hom ≫
        stageMap A k f (Nat.le_of_lt_succ (FiniteCube.card_lt S)) ≫ (stageComparison A k f n).inv)
  rw [attachingFace_assoc, vertexValue_ownStage]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

/-- The actual original punctured cube has its compatible original attaching cocone to the literal predecessor. -/
def originalAttachingCocone (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (n : ℕ) :
    Cocone (FiniteCube.punctured (wordCube A f (n + 1))) :=
  (attachingCocone A k f n).extend (stageComparison A k f n).inv

omit [SymmetricCategory C] [MonoidalClosed C] in
set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Contracting all original old letters lands in the literal old monoid carrier,
using exactly the original old-letter contraction. -/
@[simp] theorem originalVertexValue_empty (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (n : ℕ) :
    originalVertexValue A k f (∅ : FiniteCube.Index n) = vertexCollapse A k (∅ : FiniteCube.Index n) := by
  dsimp only [originalVertexValue]
  simp only [Finset.card_empty]
  change vertexCollapse A k (∅ : FiniteCube.Index n) ≫
    stageWordLeg A k f 0 0 (Nat.le_refl _) ≫ (stageZeroIso A k f).hom = _
  rw [← stageZeroIso_inv, Iso.inv_hom_id, Category.comp_id]

/-- Multiply every pair of original word stages into its actual summed stage,
retaining the literal old carrier in degree zero. -/
def originalStageMul (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (n m : ℕ) :
    originalStage A k f n ⊗ originalStage A k f m ⟶ originalStage A k f (n + m) :=
  ((stageComparison A k f n).hom ⊗ₘ (stageComparison A k f m).hom) ≫
    stageMul A k f n m ≫ (stageComparison A k f (n + m)).inv

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Every original stage-pair multiplication is retained by the actual original countable endpoint. -/
@[reassoc] theorem originalStageMul_endpoint (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (n m : ℕ) :
    originalStageMul A k f n m ≫ (originalStagesCocone A k f).ι.app (n + m) =
      ((originalStagesCocone A k f).ι.app n ⊗ₘ (originalStagesCocone A k f).ι.app m) ≫
        endpointMul A k f := by
  change (((stageComparison A k f n).hom ⊗ₘ (stageComparison A k f m).hom) ≫
      stageMul A k f n m ≫ (stageComparison A k f (n + m)).inv) ≫
      ((stageComparison A k f (n + m)).hom ≫ stageι A k f (n + m)) =
    (((stageComparison A k f n).hom ≫ stageι A k f n) ⊗ₘ
      ((stageComparison A k f m).hom ≫ stageι A k f m)) ≫ endpointMul A k f
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  rw [← tensorHom_comp_tensorHom_assoc, endpointMul_stage]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The complete original multiplication is natural in both original stage transitions, including degree zero. -/
@[reassoc] theorem originalStageMul_naturality (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) {n n' m m' : ℕ} (hn : n ≤ n') (hm : m ≤ m') :
    ((originalStageDiagram A k f).map (homOfLE hn) ⊗ₘ
      (originalStageDiagram A k f).map (homOfLE hm)) ≫ originalStageMul A k f n' m' =
    originalStageMul A k f n m ≫
      (originalStageDiagram A k f).map (homOfLE (Nat.add_le_add hn hm)) := by
  change (((stageComparison A k f n).hom ≫ stageMap A k f hn ≫ (stageComparison A k f n').inv) ⊗ₘ
      ((stageComparison A k f m).hom ≫ stageMap A k f hm ≫ (stageComparison A k f m').inv)) ≫
      (((stageComparison A k f n').hom ⊗ₘ (stageComparison A k f m').hom) ≫
        stageMul A k f n' m' ≫ (stageComparison A k f (n' + m')).inv) =
    (((stageComparison A k f n).hom ⊗ₘ (stageComparison A k f m).hom) ≫
      stageMul A k f n m ≫ (stageComparison A k f (n + m)).inv) ≫
      ((stageComparison A k f (n + m)).hom ≫ stageMap A k f (Nat.add_le_add hn hm) ≫
        (stageComparison A k f (n' + m')).inv)
  simp only [← tensorHom_comp_tensorHom, Category.assoc, Iso.inv_hom_id_assoc]
  rw [tensorHom_comp_tensorHom_assoc (stageComparison A k f n').inv (stageComparison A k f m').inv
    (stageComparison A k f n').hom (stageComparison A k f m').hom]
  simp only [Iso.inv_hom_id, tensorHom_id, id_whiskerRight, Category.id_comp]
  simpa only [Category.assoc] using congrArg
    (fun t => ((stageComparison A k f n).hom ⊗ₘ (stageComparison A k f m).hom) ≫ t ≫
      (stageComparison A k f (n' + m')).inv) (stageMul_naturality A k f hn hm)

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The actual degree-zero stage multiplication is exactly the original old monoid multiplication. -/
@[simp] theorem originalStageMul_zero (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) :
    originalStageMul A k f 0 0 = A.mon.mul := by
  change ((stageZeroIso A k f).inv ⊗ₘ (stageZeroIso A k f).inv) ≫ stageMul A k f 0 0 ≫
      (stageZeroIso A k f).hom = A.mon.mul
  rw [stageZeroIso_inv, stageMul_wordLeg_assoc]
  rw [wordConcat_zero_right, ← stageZeroIso_inv]
  change A.mon.mul ≫ (stageZeroIso A k f).inv ≫ (stageZeroIso A k f).hom = A.mon.mul
  rw [Iso.inv_hom_id, Category.comp_id]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Every original stage-pair multiplication is retained by the actual original monoid pushout multiplication. -/
@[reassoc] theorem originalStageMul_pushout (A : Mon C) {K L : C}
    (f : K ⟶ L) (a : tensorWordMon K ⟶ A) (n m : ℕ) :
    originalStageMul A (attachingValue A a) f n m ≫ (pushoutStagesCocone A f a).ι.app (n + m) =
      ((pushoutStagesCocone A f a).ι.app n ⊗ₘ (pushoutStagesCocone A f a).ι.app m) ≫
        (freeAttachment A f a).mon.mul := by
  change originalStageMul A (attachingValue A a) f n m ≫
      ((originalStagesCocone A (attachingValue A a) f).ι.app (n + m) ≫ endpointToPushout A f a) =
    (((originalStagesCocone A (attachingValue A a) f).ι.app n ≫ endpointToPushout A f a) ⊗ₘ
      ((originalStagesCocone A (attachingValue A a) f).ι.app m ≫ endpointToPushout A f a)) ≫
        (freeAttachment A f a).mon.mul
  calc
    _ = (originalStageMul A (attachingValue A a) f n m ≫
        (originalStagesCocone A (attachingValue A a) f).ι.app (n + m)) ≫ endpointToPushout A f a :=
      (Category.assoc _ _ _).symm
    _ = (((originalStagesCocone A (attachingValue A a) f).ι.app n ⊗ₘ
        (originalStagesCocone A (attachingValue A a) f).ι.app m) ≫ endpointMul A (attachingValue A a) f) ≫
          endpointToPushout A f a :=
      congrArg (fun t => t ≫ endpointToPushout A f a) (originalStageMul_endpoint A (attachingValue A a) f n m)
    _ = _ := by
      simpa only [Category.assoc, endpointToPushoutMap_hom] using endpointMul_map A (attachingValue A a) f
        (freeAttachment A f a) (endpointToPushoutMap A f a)
        ((originalStagesCocone A (attachingValue A a) f).ι.app n)
        ((originalStagesCocone A (attachingValue A a) f).ι.app m)

section PushoutProductIdentification

local instance : HasColimitsOfSize.{0, 0} C := hasColimitsOfSizeOfUnivLE.{w, w} C

/-- Every original alternating word boundary is the iterated pushout product of
the original arrow with all its original old coefficients. Both comparison maps
are constructed, including the degree-zero and degree-one conventions. -/
def wordAttachingPushoutProductIso (A : Mon C) {K L : C} (f : K ⟶ L) (n : ℕ) :
    Arrow.mk (FiniteCube.boundaryToTop (wordCube A f n)) ≅
      (tensorRight (FiniteCube.coefficientObj (fun _ : Fin (n + 1) => A.X))).mapArrow.obj
        (FiniteCube.iteratedPushoutProduct (fun _ : Fin n => f)) :=
  FiniteCube.alternatingPushoutProductIso (fun _ : Fin (n + 1) => A.X) (fun _ : Fin n => f)

/-- The original positive-degree word-cell arrows, identified with the original
iterated pushout products and all original old coefficient factors. -/
def wordCellClass (A : Mon C) {K L : C} (f : K ⟶ L) : MorphismProperty C := fun _ _ g =>
  ∃ n : ℕ, Nonempty (Arrow.mk g ≅
    (tensorRight (FiniteCube.coefficientObj (fun _ : Fin ((n + 1) + 1) => A.X))).mapArrow.obj
      (FiniteCube.iteratedPushoutProduct (fun _ : Fin (n + 1) => f)))

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The entire original countable diagram, root, and original pushout carrier
form an actual transfinite composition of shape `ℕ`. -/
def originalWordTransfiniteComposition (A : Mon C) {K L : C}
    (f : K ⟶ L) (a : tensorWordMon K ⟶ A) : TransfiniteCompositionOfShape ℕ (oldι A f a).hom where
  F := originalStageDiagram A (attachingValue A a) f
  isoBot := Iso.refl A.X
  incl := (pushoutStagesCocone A f a).ι
  isColimit := pushoutStagesIsColimit A f a
  fac := (Category.id_comp _).trans (pushoutStages_source A f a)

/-- Every original successor is a genuine cobase change of its original word-cell arrow. -/
theorem originalWordSuccessor_mem (A : Mon C) {K L : C}
    (f : K ⟶ L) (a : tensorWordMon K ⟶ A) (n : ℕ) :
    (wordCellClass A f).pushouts
      ((originalStageDiagram A (attachingValue A a) f).map (homOfLE (Nat.le_succ n))) :=
  MorphismProperty.pushouts_mk _ (originalSuccessorIsPushout A (attachingValue A a) f n)
    ⟨n, ⟨wordAttachingPushoutProductIso A f (n + 1)⟩⟩

/-- The complete original countable word history is an actual relative word-cell complex. -/
def originalWordCellComplex (A : Mon C) {K L : C} (f : K ⟶ L) (a : tensorWordMon K ⟶ A) :
    (wordCellClass A f).pushouts.TransfiniteCompositionOfShape ℕ (oldι A f a).hom where
  __ := originalWordTransfiniteComposition A f a
  map_mem n _ := originalWordSuccessor_mem A f a n

/-- The actual original old carrier map belongs to the supplied canonical
cellular closure of its actual original tensor-word cell arrows. -/
theorem originalWordPushout_mem_cellularClosure (A : Mon C) {K L : C}
    (f : K ⟶ L) (a : tensorWordMon K ⟶ A) :
    SmallObject.CellularNormalization.cellularClosure.{0, 0} (wordCellClass A f) (oldι A f a).hom := by
  let d := (originalWordCellComplex A f a).ofLE
    (MorphismProperty.pushouts_monotone (MorphismProperty.le_coproducts (wordCellClass A f)))
  exact MorphismProperty.transfiniteCompositionsOfShape_le_transfiniteCompositions
    ((wordCellClass A f).coproducts.{0}).pushouts ℕ (oldι A f a).hom d.mem

/-- The complete actual tensor-word cell filtration of an original associative
free-algebra attachment. Its data refer to the literal constructed word cubes,
their actual punctured colimits, the literal original stage-zero carrier, and
the original monoid pushout carrier. All identities and universal properties
are outputs of the construction. -/
structure ActualTensorWordCellFiltration (A : Mon C) {K L : C} (f : K ⟶ L)
    (a : tensorWordMon K ⟶ A) where
  /-- Every original subset vertex retains all its original alternating tensor factors. -/
  vertices : ∀ n (S : FiniteCube.Index n), (wordCube A f n).obj S = literalVertex A K L S
  /-- Every original inclusion retains precisely its original letter arrows and coefficient identities. -/
  faces : ∀ n {S T : FiniteCube.Index n} (h : S ⟶ T), (wordCube A f n).map h =
    FiniteCube.alternatingMap (fun _ : Fin (n + 1) => 𝟙 A.X)
      (FiniteCube.familyMap (fun _ : Fin n => f) (leOfHom h))
  /-- The degree-zero cube has exactly the original old carrier as its only vertex. -/
  zeroVertex : ∀ S : FiniteCube.Index 0, (wordCube A f 0).obj S = A.X
  /-- Every entire original punctured cube has its constructed colimit witness. -/
  boundaryColimits : ∀ n, IsColimit (colimit.cocone (FiniteCube.punctured (wordCube A f n)))
  /-- The original stage diagram starts at the literal original monoid carrier. -/
  stageZero : (originalStageDiagram A (attachingValue A a) f).obj 0 = A.X
  /-- Every successor is the pushout of the entire actual original punctured cube attachment. -/
  successors : ∀ n, IsPushout (originalAttachingMap A (attachingValue A a) f n)
    (FiniteCube.boundaryToTop (wordCube A f (n + 1)))
    ((originalStageDiagram A (attachingValue A a) f).map (homOfLE (Nat.le_succ n)))
    (originalTopStageLeg A (attachingValue A a) f n)
  /-- Every original proper face is collapsed into its own actual original earlier stage. -/
  attachingFaces : ∀ n (S : FiniteCube.Punctured (n + 1)),
    FiniteCube.boundaryι (wordCube A f (n + 1)) S ≫ originalAttachingMap A (attachingValue A a) f n =
      originalVertexValue A (attachingValue A a) f S.1 ≫
        (originalStageDiagram A (attachingValue A a) f).map
          (homOfLE (Nat.le_of_lt_succ (FiniteCube.card_lt S)))
  /-- The entire actual countable stage diagram has the original monoid pushout as its colimit. -/
  pushoutCarrierIsColimit : IsColimit (pushoutStagesCocone A f a)
  /-- Its original source leg is precisely the original old monoid pushout map. -/
  source : (pushoutStagesCocone A f a).ι.app 0 = (oldι A f a).hom
  /-- The constructed endpoint unit is the original old unit followed by its degree-zero leg. -/
  endpointUnit : (endpointMonoid A (attachingValue A a) f).mon.one =
    A.mon.one ≫ rootMap A (attachingValue A a) f
  /-- Multiplication retains concatenation of every pair of entire original words. -/
  endpointWords : ∀ n m,
    (endpointWordLeg A (attachingValue A a) f n ⊗ₘ endpointWordLeg A (attachingValue A a) f m) ≫
      (endpointMonoid A (attachingValue A a) f).mon.mul =
        wordConcat A L n m ≫ endpointWordLeg A (attachingValue A a) f (n + m)
  /-- The entire original left-unit diagram holds for the constructed endpoint. -/
  endpointLeftUnit : ((endpointMonoid A (attachingValue A a) f).mon.one ▷
      (endpointMonoid A (attachingValue A a) f).X) ≫ (endpointMonoid A (attachingValue A a) f).mon.mul =
    (λ_ (endpointMonoid A (attachingValue A a) f).X).hom
  /-- The entire original right-unit diagram holds for the constructed endpoint. -/
  endpointRightUnit : ((endpointMonoid A (attachingValue A a) f).X ◁
      (endpointMonoid A (attachingValue A a) f).mon.one) ≫ (endpointMonoid A (attachingValue A a) f).mon.mul =
    (ρ_ (endpointMonoid A (attachingValue A a) f).X).hom
  /-- The entire original associativity diagram holds for the constructed endpoint. -/
  endpointAssociativity : ((endpointMonoid A (attachingValue A a) f).mon.mul ▷
      (endpointMonoid A (attachingValue A a) f).X) ≫ (endpointMonoid A (attachingValue A a) f).mon.mul =
    (α_ (endpointMonoid A (attachingValue A a) f).X (endpointMonoid A (attachingValue A a) f).X
      (endpointMonoid A (attachingValue A a) f).X).hom ≫
        ((endpointMonoid A (attachingValue A a) f).X ◁ (endpointMonoid A (attachingValue A a) f).mon.mul) ≫
          (endpointMonoid A (attachingValue A a) f).mon.mul
  /-- The constructed endpoint has the full original monoid pushout universal property. -/
  endpointPushout : IsPushout a (tensorWordFunctor.map f)
    (endpointOldMap A (attachingValue A a) f) (endpointNewMap A (attachingValue A a) f)
  /-- Both actual original monoid comparison maps identify the endpoint with the original pushout. -/
  comparison : endpointMonoid A (attachingValue A a) f ≅ freeAttachment A f a
  /-- The comparison retains the entire original old monoid leg. -/
  comparisonOld : endpointOldMap A (attachingValue A a) f ≫ comparison.hom = oldι A f a
  /-- The comparison retains the entire original free new-algebra leg. -/
  comparisonNew : endpointNewMap A (attachingValue A a) f ≫ comparison.hom = newι A f a
  /-- All original stage-pair products retain the multiplication of the original monoid pushout. -/
  multiplication : ∀ n m, originalStageMul A (attachingValue A a) f n m ≫
      (pushoutStagesCocone A f a).ι.app (n + m) =
    ((pushoutStagesCocone A f a).ι.app n ⊗ₘ (pushoutStagesCocone A f a).ι.app m) ≫
      (freeAttachment A f a).mon.mul
  /-- Every original attaching arrow is the original iterated pushout product
  tensored with all its original old coefficients, including degrees zero and one. -/
  attachingArrowIso : ∀ n, Arrow.mk (FiniteCube.boundaryToTop (wordCube A f n)) ≅
    (tensorRight (FiniteCube.coefficientObj (fun _ : Fin (n + 1) => A.X))).mapArrow.obj
      (FiniteCube.iteratedPushoutProduct (fun _ : Fin n => f))
  /-- The native relative-cell history retains the full original diagram and endpoint map. -/
  cellularHistory : (wordCellClass A f).pushouts.TransfiniteCompositionOfShape ℕ (oldι A f a).hom
  /-- Its native diagram is the entire original countable word diagram. -/
  cellularHistoryDiagram : cellularHistory.F = originalStageDiagram A (attachingValue A a) f
  /-- The actual original map belongs to the canonical cellular closure of its original word cells. -/
  cellularClosure : SmallObject.CellularNormalization.cellularClosure.{0, 0}
    (wordCellClass A f) (oldι A f a).hom

/-- Construct the complete actual tensor-word cell filtration from the entire
original associative free-algebra attachment diagram. -/
def actualTensorWordCellFiltration (A : Mon C) {K L : C} (f : K ⟶ L) (a : tensorWordMon K ⟶ A) :
    ActualTensorWordCellFiltration A f a where
  vertices := wordCube_obj A f
  faces := wordCube_map A f
  zeroVertex := fun _ => rfl
  boundaryColimits := fun n => FiniteCube.boundaryIsColimit (wordCube A f n)
  stageZero := rfl
  successors := originalSuccessorIsPushout A (attachingValue A a) f
  attachingFaces := originalAttachingFace A (attachingValue A a) f
  pushoutCarrierIsColimit := pushoutStagesIsColimit A f a
  source := pushoutStages_source A f a
  endpointUnit := rfl
  endpointWords := endpointMul_word A (attachingValue A a) f
  endpointLeftUnit := endpointOne_mul A (attachingValue A a) f
  endpointRightUnit := endpointMul_one A (attachingValue A a) f
  endpointAssociativity := endpointMul_assoc A (attachingValue A a) f
  endpointPushout := endpointOriginalIsPushout A f a
  comparison := endpointPushoutIso A f a
  comparisonOld := endpointOldMap_toPushout A f a
  comparisonNew := endpointNewMap_toPushout A f a
  multiplication := originalStageMul_pushout A f a
  attachingArrowIso := wordAttachingPushoutProductIso A f
  cellularHistory := originalWordCellComplex A f a
  cellularHistoryDiagram := rfl
  cellularClosure := originalWordPushout_mem_cellularClosure A f a

/-- Every original associative free-algebra pushout has the complete actual
countable tensor-word cell filtration, with its literal cubes, original attaching
maps, entire endpoint colimit, constructed monoid laws, full original pushout
universal property, and original pushout-product comparisons. -/
theorem associativeFreeAlgebraPushout_hasActualTensorWordCellFiltration
    (A : Mon C) {K L : C} (f : K ⟶ L) (a : tensorWordMon K ⟶ A) :
    Nonempty (ActualTensorWordCellFiltration A f a) :=
  ⟨actualTensorWordCellFiltration A f a⟩

end PushoutProductIdentification

section OriginalAssociativeFreeCarrier

open CategoryTheory.Operad.Tensor.Associative

/-- The actual original associative free-carrier map is retained through the
supplied canonical full monoid comparison to tensor words. -/
def associativeWordAttachment (A : Mon C) {K : C} (a : correctedAssociativeWordMon K ⟶ A) :
    tensorWordMon K ⟶ A := (correctedAssociativeWordMonIso K).inv ≫ a

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The original old-letter value is exactly the original associative free generator followed by its attaching map. -/
theorem associativeWordAttachment_value (A : Mon C) {K : C} (a : correctedAssociativeWordMon K ⟶ A) :
    attachingValue A (associativeWordAttachment A a) = correctedAssociativeWordGenerator K ≫ a.hom := by
  change tensorWordGenerator K ≫ ((correctedAssociativeWordMonIso K).inv.hom ≫ a.hom) =
    (tensorWordGenerator K ≫ (chosenAssociativeTensorWordsIso K).inv) ≫ a.hom
  rw [correctedAssociativeWordMonIso_inv_carrier, Category.assoc]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The actual original associative adjunction unit, including its original
unary operadic unit insertion, gives the exact original word attaching value. -/
theorem associativeWordAttachment_unit (A : Mon C) {K : C} (a : correctedAssociativeWordMon K ⟶ A) :
    attachingValue A (associativeWordAttachment A a) = correctedAssociativeWordAdjunction.unit.app K ≫ a.hom := by
  have hg : correctedAssociativeWordGenerator K = correctedAssociativeWordAdjunction.unit.app K :=
    (correctedAssociativeWordGenerator_eq_operadicUnit K).trans (correctedAssociativeWordAdjunction_unit K).symm
  exact (associativeWordAttachment_value A a).trans (congrArg (fun t => t ≫ a.hom) hg)

/-- The original old monoid map of the original associative free-algebra attachment. -/
def originalAssociativeOldMap (A : Mon C) {K L : C} (f : K ⟶ L) (a : correctedAssociativeWordMon K ⟶ A) :
    A ⟶ freeAttachment A f (associativeWordAttachment A a) := oldι A f (associativeWordAttachment A a)

/-- The entire original associative free new-algebra map is retained through its actual canonical monoid comparison. -/
def originalAssociativeNewMap (A : Mon C) {K L : C} (f : K ⟶ L) (a : correctedAssociativeWordMon K ⟶ A) :
    correctedAssociativeWordMon L ⟶ freeAttachment A f (associativeWordAttachment A a) :=
  (correctedAssociativeWordMonIso L).hom ≫ newι A f (associativeWordAttachment A a)

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The entire original associative free-algebra diagram, with its original
free map and original attaching map, has the full constructed monoid pushout universal property. -/
theorem originalAssociativeFreeIsPushout (A : Mon C) {K L : C}
    (f : K ⟶ L) (a : correctedAssociativeWordMon K ⟶ A) :
    IsPushout a (correctedAssociativeWordFunctor.map f)
      (originalAssociativeOldMap A f a) (originalAssociativeNewMap A f a) := by
  apply (originalIsPushout A f (associativeWordAttachment A a)).of_iso'
    (correctedAssociativeWordMonIso K) (Iso.refl A) (correctedAssociativeWordMonIso L) (Iso.refl _)
  · simp only [associativeWordAttachment, Iso.refl_hom, Iso.hom_inv_id_assoc, Category.comp_id]
  · exact (correctedAssociativeWordFunctorIso.hom.naturality f).symm
  · simp only [originalAssociativeOldMap, Iso.refl_hom, Category.id_comp, Category.comp_id]
  · simp only [originalAssociativeNewMap, Iso.refl_hom, Category.comp_id]

/-- The supplied actual associative free carrier and original unit/map
conventions have the complete actual tensor-word filtration and full original
monoid pushout diagram through the supplied canonical source comparison. -/
theorem originalAssociativeFree_hasActualTensorWordCellFiltration (A : Mon C) {K L : C}
    (f : K ⟶ L) (a : correctedAssociativeWordMon K ⟶ A) :
    Nonempty (ActualTensorWordCellFiltration A f (associativeWordAttachment A a)) ∧
      IsPushout a (correctedAssociativeWordFunctor.map f)
        (originalAssociativeOldMap A f a) (originalAssociativeNewMap A f a) :=
  ⟨associativeFreeAlgebraPushout_hasActualTensorWordCellFiltration A f (associativeWordAttachment A a),
    originalAssociativeFreeIsPushout A f a⟩

end OriginalAssociativeFreeCarrier

end CategoryTheory.MonoidalCategory.MonoidWordPushout
