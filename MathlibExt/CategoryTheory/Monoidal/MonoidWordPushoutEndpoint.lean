/-- The constructed original endpoint unit and multiplication satisfy the complete original left-unit law. -/
theorem endpointOne_mul (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) :
    (endpointOne A k f ▷ stageEndpoint A k f) ≫ endpointMul A k f = (λ_ (stageEndpoint A k f)).hom := by
  apply endpoint_unitLeft_hom_ext A k f
  intro n
  calc
    (𝟙_ C ◁ endpointWordLeg A k f n) ≫ (endpointOne A k f ▷ stageEndpoint A k f) ≫ endpointMul A k f =
        (endpointOne A k f ⊗ₘ endpointWordLeg A k f n) ≫ endpointMul A k f := by
      rw [← Category.assoc, tensorHom_def']
    _ = (A.mon.one ⊗ₘ 𝟙 (newWordObj A L n)) ≫
        (endpointWordLeg A k f 0 ⊗ₘ endpointWordLeg A k f n) ≫ endpointMul A k f := by
      rw [endpointOne, ← Category.assoc, tensorHom_comp_tensorHom, Category.id_comp]
    _ = (A.mon.one ▷ newWordObj A L n) ≫ wordConcat A L 0 n ≫ endpointWordLeg A k f (0 + n) := by
      rw [endpointMul_word, tensorHom_id]
    _ = (λ_ (newWordObj A L n)).hom ≫ endpointWordLeg A k f n := by
      rw [← endpointWordLeg_transport A k f (Nat.zero_add n)]
      simpa only [newWordUnit, Category.assoc] using
        congrArg (fun t => t ≫ endpointWordLeg A k f n) (wordConcat_leftUnit A L n)
    _ = (𝟙_ C ◁ endpointWordLeg A k f n) ≫ (λ_ (stageEndpoint A k f)).hom :=
      (leftUnitor_naturality (endpointWordLeg A k f n)).symm

