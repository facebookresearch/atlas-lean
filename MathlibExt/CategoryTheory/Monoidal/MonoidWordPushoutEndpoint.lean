/-- Every entire original new word is generated by its preceding word,
the original letter with its two original unit insertions, and its final old coefficient. -/
theorem wordLetter_generation (A : Mon C) (L : C) (n : ℕ) :
    (((newWordObj A L n ◁ wordLetter A L) ≫ wordConcat A L n 1) ▷ A.X) ≫
        (wordModule A L L (Word.allNew (n + 1))).act = 𝟙 (newWordObj A L (n + 1)) := by
  change (((newWordObj A L n ◁ rawWordLetter A L) ≫ wordConcat A L n 1) ▷ A.X) ≫
    RightModule.freeAct A (newWordObj A L n ⊗ L) = 𝟙 ((newWordObj A L n ⊗ L) ⊗ A.X)
  rw [wordConcat_succ, wordConcat_zero_right]
  change (((newWordObj A L n ◁ rawWordLetter A L) ≫ snocTensor A (newWordObj A L n) A.X L ≫
    ((wordModule A L L (Word.allNew n)).act ▷ L) ▷ A.X) ▷ A.X) ≫
      RightModule.freeAct A (newWordObj A L n ⊗ L) = 𝟙 ((newWordObj A L n ⊗ L) ⊗ A.X)
  rw [rawWordLetter_concat]
  exact freeAct_generator A (newWordObj A L n ⊗ L)

