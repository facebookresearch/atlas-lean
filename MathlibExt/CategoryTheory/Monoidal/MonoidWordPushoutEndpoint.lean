    (ho : endpointOldMap A (attachingValue A a) f ≫ p = c.inl)
    (hn : endpointNewMap A (attachingValue A a) f ≫ p = c.inr) : p = endpointOriginalDesc A f a c :=
  endpointMonoid_hom_ext A (attachingValue A a) f
    (ho.trans (endpointOldMap_originalDesc A f a c).symm)
    (hn.trans (endpointNewMap_originalDesc A f a c).symm)

