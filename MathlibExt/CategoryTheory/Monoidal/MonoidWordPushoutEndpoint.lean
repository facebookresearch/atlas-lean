/-- The original full-word comparison normalizes its complete original full-face map through the exact count. -/
theorem inverseNewWord_face (A : Mon C) {K L : C} (f : K ⟶ L) (n : ℕ) :
    eqToHom (wordObj_allNew A K L n).symm ≫ wordToNewHom A f (Word.allNew n) =
      eqToHom (congrArg (newWordObj A L) (Word.length_allNew n)).symm := by
  apply (cancel_mono (eqToHom (congrArg (newWordObj A L) (Word.length_allNew n)))).mp
  rw [Category.assoc, wordToNewHom_allNew, eqToHom_trans, eqToHom_refl,
    eqToHom_trans, eqToHom_refl]

