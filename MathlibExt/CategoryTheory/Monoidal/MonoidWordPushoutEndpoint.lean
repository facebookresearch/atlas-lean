/-- The original old carrier and original new-letter maps jointly determine every actual endpoint monoid map. -/
theorem endpointMonoid_hom_ext_onGenerators (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    {M : Mon C} {p q : endpointMonoid A k f ⟶ M}
    (ho : rootMap A k f ≫ p.hom = rootMap A k f ≫ q.hom)
    (hn : endpointLetter A k f ≫ p.hom = endpointLetter A k f ≫ q.hom) : p = q := by
  apply Mon.Hom.ext
  apply endpoint_hom_ext A k f
  intro n
  induction n with
  | zero => exact ho
  | succ n ih =>
