/-- The entire original old and free new-algebra maps jointly determine every actual endpoint monoid map. -/
theorem endpointMonoid_hom_ext (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    {M : Mon C} {p q : endpointMonoid A k f ⟶ M}
    (ho : endpointOldMap A k f ≫ p = endpointOldMap A k f ≫ q)
    (hn : endpointNewMap A k f ≫ p = endpointNewMap A k f ≫ q) : p = q := by
  apply endpointMonoid_hom_ext_onGenerators A k f
  · exact congrArg Mon.Hom.hom ho
  · have h := congrArg (fun t => tensorWordGenerator L ≫ t) (congrArg Mon.Hom.hom hn)
    change tensorWordGenerator L ≫ ((endpointNewMap A k f).hom ≫ p.hom) =
      tensorWordGenerator L ≫ ((endpointNewMap A k f).hom ≫ q.hom) at h
    have h' : (tensorWordGenerator L ≫ (endpointNewMap A k f).hom) ≫ p.hom =
        (tensorWordGenerator L ≫ (endpointNewMap A k f).hom) ≫ q.hom :=
      (Category.assoc _ _ _).trans (h.trans (Category.assoc _ _ _).symm)
    exact (congrArg (fun t => t ≫ p.hom) (endpointNewMap_generator A k f)).symm.trans
      (h'.trans (congrArg (fun t => t ≫ q.hom) (endpointNewMap_generator A k f)))

