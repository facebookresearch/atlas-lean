/-- Multiplying a complete new word by an original proper word retains its entire original stage relation. -/
theorem wordStage_relation_leftNew (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (R : ℕ)
    (i : ℕ) (q : Word) (h : i + q.length ≤ R) (hp : q.kept < q.length) :
    (𝟙 (newWordObj A L i) ⊗ₘ wordReductionToNew A k q) ≫ wordConcat A L i q.kept ≫
        stageWordLeg A k f R (i + q.kept) ((Nat.add_le_add_left q.kept_le_length i).trans h) =
      (𝟙 (newWordObj A L i) ⊗ₘ wordToNewHom A f q) ≫ wordConcat A L i q.length ≫
        stageWordLeg A k f R (i + q.length) h := by
  have hsum : (Word.allNew i).length + q.length ≤ R := by simpa only [Word.length_allNew] using h
  have hproper : ((Word.allNew i).append q).kept < ((Word.allNew i).append q).length := by
    rw [Word.kept_append, Word.length_append, Word.kept_allNew, Word.length_allNew]
    exact Nat.add_lt_add_left hp i
  have hh := congrArg (fun t => (eqToHom (wordObj_allNew A K L i).symm ⊗ₘ 𝟙 (wordObj A K L q)) ≫ t)
    (pairWord_stage_relation A k f R (Word.allNew i) q hsum hproper)
  simp only [tensorHom_comp_tensorHom_assoc, Category.id_comp,
    inverseNewWord_reduction, inverseNewWord_face] at hh
  rw [wordSum_leftTransport A k f R q.kept (Word.kept_allNew i).symm
      ((Nat.add_le_add_left q.kept_le_length i).trans h) (wordReductionToNew A k q),
