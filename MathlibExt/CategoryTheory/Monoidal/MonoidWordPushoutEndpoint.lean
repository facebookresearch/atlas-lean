/-- An entire original full new word has precisely its original identity full-face map. -/
theorem wordToNew_allNew (A : Mon C) {K L : C} (f : K ⟶ L) (n : ℕ) :
    wordToNew A f (Word.allNew n) =
      eqToHom (congrArg (wordModule A K L) (congrArg Word.allNew (Word.length_allNew n).symm)) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change RightModule.snocMap (wordToNew A f (Word.allNew n)) (𝟙 L) = _
    rw [ih, RightModule.snocMap_eqToHom]
    rfl

