/-- Every original concatenated proper word retains its entire original stage relation in both input words. -/
theorem pairWord_stage_relation (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (R : ℕ)
    (p q : Word) (h : p.length + q.length ≤ R) (hp : (p.append q).kept < (p.append q).length) :
    (wordReductionToNew A k p ⊗ₘ wordReductionToNew A k q) ≫ wordConcat A L p.kept q.kept ≫
        stageWordLeg A k f R (p.kept + q.kept) ((Nat.add_le_add p.kept_le_length q.kept_le_length).trans h) =
      (wordToNewHom A f p ⊗ₘ wordToNewHom A f q) ≫ wordConcat A L p.length q.length ≫
        stageWordLeg A k f R (p.length + q.length) h := by
  let c : CellFace R := ⟨p.append q, (Word.length_append p q).symm ▸ h, hp⟩
  let hk : p.kept + q.kept ≤ R := (Nat.add_le_add p.kept_le_length q.kept_le_length).trans h
  have hl := congrArg (fun t => t ≫ stageWordLeg A k f R (p.kept + q.kept) hk)
    (concatMixed_reductionToNew A k p q)
  have hr := congrArg (fun t => t ≫ stageWordLeg A k f R (p.length + q.length) h)
    (concatMixed_wordToNewHom A f p q)
  have htk := stageWordLeg_transport A k f R (Word.kept_append p q) ((Word.kept_append p q).symm ▸ hk)
  change eqToHom (congrArg (newWordObj A L) (Word.kept_append p q)) ≫
    stageWordLeg A k f R (p.kept + q.kept) hk =
      stageWordLeg A k f R (p.append q).kept ((Word.kept_append p q).symm ▸ hk) at htk
  have htl := stageWordLeg_transport A k f R (Word.length_append p q) c.bound
  change eqToHom (congrArg (newWordObj A L) (Word.length_append p q)) ≫
    stageWordLeg A k f R (p.length + q.length) h = stageWordLeg A k f R (p.append q).length c.bound at htl
  simp only [Category.assoc] at hl hr
  rw [htk] at hl
  rw [htl] at hr
  have hc := congrArg (fun t => concatMixed A K L p q ≫ t) (stage_cell A k f R c)
  simpa only [Category.assoc] using hl.symm.trans (hc.trans hr)

