/-- The complete original full-face map of a new word is its exact original carrier comparison. -/
theorem wordToNewHom_allNew (A : Mon C) {K L : C} (f : K ⟶ L) (n : ℕ) :
    wordToNewHom A f (Word.allNew n) ≫
        eqToHom (congrArg (newWordObj A L) (Word.length_allNew n)) = eqToHom (wordObj_allNew A K L n) := by
  simp only [wordToNewHom, wordToNew_allNew, RightModule.eqToHom_hom, eqToHom_trans]

/-- Every original tensor-family component retains the original concatenation after both original input maps. -/
@[reassoc] theorem rawStageMul_component (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    (N M n m : ℕ) (hn : n ≤ N) (hm : m ≤ M) {X Y : C}
    (u : X ⟶ newWordObj A L n) (v : Y ⟶ newWordObj A L m) :
    ((u ≫ stageWordι A L N n hn) ⊗ₘ (v ≫ stageWordι A L M m hm)) ≫ rawStageMul A k f N M =
      (u ⊗ₘ v) ≫ wordConcat A L n m ≫ stageWordLeg A k f (N + M) (n + m) (Nat.add_le_add hn hm) := by
  rw [← tensorHom_comp_tensorHom, Category.assoc, rawStageMul_wordι]

/-- The original left relation on a full-word pair evaluates by the original old-letter contraction. -/
@[reassoc] theorem rawStageMul_leftReduction (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    (N M : ℕ) (c : CellFace N) (j : ℕ) (hj : j ≤ M) :
    (Sigma.ι (fun c : CellFace N => wordObj A K L c.word) c ⊗ₘ stageWordι A L M j hj) ≫
        (stageRelationLeft A L k N ▷ stageWords A L M) ≫ rawStageMul A k f N M =
      (wordReductionToNew A k c.word ⊗ₘ 𝟙 (newWordObj A L j)) ≫ wordConcat A L c.word.kept j ≫
        stageWordLeg A k f (N + M) (c.word.kept + j)
          (Nat.add_le_add (c.word.kept_le_length.trans c.bound) hj) := by
  rw [← tensorHom_id (stageRelationLeft A L k N), ← Category.assoc,
    tensorHom_comp_tensorHom, Category.comp_id]
  rw [stageRelationLeft, Sigma.ι_comp_desc]
  simpa only [Category.id_comp] using
    rawStageMul_component A k f N M c.word.kept j (c.word.kept_le_length.trans c.bound) hj
      (wordReductionToNew A k c.word) (𝟙 (newWordObj A L j))

/-- The original left full-face relation evaluates by the original actual generator arrow. -/
@[reassoc] theorem rawStageMul_leftFace (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    (N M : ℕ) (c : CellFace N) (j : ℕ) (hj : j ≤ M) :
    (Sigma.ι (fun c : CellFace N => wordObj A K L c.word) c ⊗ₘ stageWordι A L M j hj) ≫
        (stageRelationRight A f N ▷ stageWords A L M) ≫ rawStageMul A k f N M =
      (wordToNewHom A f c.word ⊗ₘ 𝟙 (newWordObj A L j)) ≫ wordConcat A L c.word.length j ≫
        stageWordLeg A k f (N + M) (c.word.length + j) (Nat.add_le_add c.bound hj) := by
  rw [← tensorHom_id (stageRelationRight A f N), ← Category.assoc,
    tensorHom_comp_tensorHom, Category.comp_id]
  rw [stageRelationRight, Sigma.ι_comp_desc]
  simpa only [Category.id_comp] using
    rawStageMul_component A k f N M c.word.length j c.bound hj (wordToNewHom A f c.word) (𝟙 (newWordObj A L j))

/-- The original right old-letter relation evaluates by the original complete contraction. -/
@[reassoc] theorem rawStageMul_rightReduction (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    (N M : ℕ) (i : ℕ) (hi : i ≤ N) (c : CellFace M) :
    (stageWordι A L N i hi ⊗ₘ Sigma.ι (fun c : CellFace M => wordObj A K L c.word) c) ≫
        (stageWords A L N ◁ stageRelationLeft A L k M) ≫ rawStageMul A k f N M =
      (𝟙 (newWordObj A L i) ⊗ₘ wordReductionToNew A k c.word) ≫ wordConcat A L i c.word.kept ≫
        stageWordLeg A k f (N + M) (i + c.word.kept)
          (Nat.add_le_add hi (c.word.kept_le_length.trans c.bound)) := by
  rw [← id_tensorHom (stageWords A L N), ← Category.assoc,
    tensorHom_comp_tensorHom, Category.comp_id]
  rw [stageRelationLeft, Sigma.ι_comp_desc]
  simpa only [Category.id_comp] using
    rawStageMul_component A k f N M i c.word.kept hi (c.word.kept_le_length.trans c.bound)
      (𝟙 (newWordObj A L i)) (wordReductionToNew A k c.word)

/-- The original right full-face relation evaluates by the original actual generator arrow. -/
@[reassoc] theorem rawStageMul_rightFace (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L)
    (N M : ℕ) (i : ℕ) (hi : i ≤ N) (c : CellFace M) :
    (stageWordι A L N i hi ⊗ₘ Sigma.ι (fun c : CellFace M => wordObj A K L c.word) c) ≫
        (stageWords A L N ◁ stageRelationRight A f M) ≫ rawStageMul A k f N M =
      (𝟙 (newWordObj A L i) ⊗ₘ wordToNewHom A f c.word) ≫ wordConcat A L i c.word.length ≫
        stageWordLeg A k f (N + M) (i + c.word.length) (Nat.add_le_add hi c.bound) := by
  rw [← id_tensorHom (stageWords A L N), ← Category.assoc,
    tensorHom_comp_tensorHom, Category.comp_id]
  rw [stageRelationRight, Sigma.ι_comp_desc]
  simpa only [Category.id_comp] using
    rawStageMul_component A k f N M i c.word.length hi c.bound (𝟙 (newWordObj A L i)) (wordToNewHom A f c.word)

/-- The endpoint unit is the original old monoid unit followed by its original degree-zero leg. -/
def endpointOne (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) : 𝟙_ C ⟶ stageEndpoint A k f :=
  A.mon.one ≫ endpointWordLeg A k f 0

