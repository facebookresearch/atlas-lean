/-- The constructed original endpoint multiplication satisfies its entire original associativity diagram. -/
theorem endpointMul_assoc (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) :
    (endpointMul A k f ▷ stageEndpoint A k f) ≫ endpointMul A k f =
      (α_ (stageEndpoint A k f) (stageEndpoint A k f) (stageEndpoint A k f)).hom ≫
        (stageEndpoint A k f ◁ endpointMul A k f) ≫ endpointMul A k f := by
  apply endpoint_triple_hom_ext A k f
  intro n m p
  have hl : ((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ⊗ₘ endpointWordLeg A k f p) ≫
      ((endpointMul A k f ▷ stageEndpoint A k f) ≫ endpointMul A k f) =
      (wordConcat A L n m ▷ newWordObj A L p) ≫ wordConcat A L (n + m) p ≫
        endpointWordLeg A k f ((n + m) + p) := by
    calc
      ((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ⊗ₘ endpointWordLeg A k f p) ≫
          ((endpointMul A k f ▷ stageEndpoint A k f) ≫ endpointMul A k f) =
          (((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ≫ endpointMul A k f) ⊗ₘ
            endpointWordLeg A k f p) ≫ endpointMul A k f := by
        rw [← tensorHom_id (endpointMul A k f), ← Category.assoc,
          tensorHom_comp_tensorHom, Category.comp_id]
      _ = ((wordConcat A L n m ≫ endpointWordLeg A k f (n + m)) ⊗ₘ
          endpointWordLeg A k f p) ≫ endpointMul A k f := by rw [endpointMul_word]
      _ = (wordConcat A L n m ⊗ₘ 𝟙 (newWordObj A L p)) ≫
          (endpointWordLeg A k f (n + m) ⊗ₘ endpointWordLeg A k f p) ≫ endpointMul A k f := by
        rw [← Category.assoc, tensorHom_comp_tensorHom, Category.id_comp]
      _ = (wordConcat A L n m ▷ newWordObj A L p) ≫ wordConcat A L (n + m) p ≫
          endpointWordLeg A k f ((n + m) + p) := by rw [endpointMul_word, tensorHom_id]
  have hr : ((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ⊗ₘ endpointWordLeg A k f p) ≫
      ((α_ (stageEndpoint A k f) (stageEndpoint A k f) (stageEndpoint A k f)).hom ≫
        (stageEndpoint A k f ◁ endpointMul A k f) ≫ endpointMul A k f) =
      (α_ (newWordObj A L n) (newWordObj A L m) (newWordObj A L p)).hom ≫
        (newWordObj A L n ◁ wordConcat A L m p) ≫ wordConcat A L n (m + p) ≫
          endpointWordLeg A k f (n + (m + p)) := by
    calc
      ((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ⊗ₘ endpointWordLeg A k f p) ≫
          ((α_ (stageEndpoint A k f) (stageEndpoint A k f) (stageEndpoint A k f)).hom ≫
            (stageEndpoint A k f ◁ endpointMul A k f) ≫ endpointMul A k f) =
          (α_ (newWordObj A L n) (newWordObj A L m) (newWordObj A L p)).hom ≫
            (endpointWordLeg A k f n ⊗ₘ (endpointWordLeg A k f m ⊗ₘ endpointWordLeg A k f p)) ≫
