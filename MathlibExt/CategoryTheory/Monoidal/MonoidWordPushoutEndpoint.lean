private def rawWordLetter (A : Mon C) (L : C) : L ⟶ (A.X ⊗ L) ⊗ A.X :=
  (λ_ L).inv ≫ (A.mon.one ▷ L) ≫ (ρ_ (A.X ⊗ L)).inv ≫ ((A.X ⊗ L) ◁ A.mon.one)

