/-- Inserting original old units is natural in the original old monoid and original new-letter maps. -/
@[reassoc] theorem wordLetter_naturality (A B : Mon C) (a : A ⟶ B) {L M : C} (h : L ⟶ M) :
    wordLetter A L ≫ ((a.hom ⊗ₘ h) ⊗ₘ a.hom) = h ≫ wordLetter B M := by
  dsimp only [wordLetter]
  rw [tensorHom_def (a.hom ⊗ₘ h) a.hom]
  simp only [Category.assoc]
  rw [whisker_exchange_assoc, ← whiskerLeft_comp, IsMonHom.one_hom]
  rw [← rightUnitor_inv_naturality_assoc]
  rw [← tensorHom_id A.mon.one L, tensorHom_comp_tensorHom_assoc, Category.id_comp, IsMonHom.one_hom]
  rw [tensorHom_def'_assoc, ← leftUnitor_inv_naturality_assoc]

