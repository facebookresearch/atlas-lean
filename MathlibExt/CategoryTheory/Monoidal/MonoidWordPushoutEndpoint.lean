/-- The complete reduction of an original full new word is its exact original carrier comparison. -/
theorem wordReductionToNew_allNew (A : Mon C) {K L : C} (k : K ⟶ A.X) (n : ℕ) :
    wordReductionToNew A (L := L) k (Word.allNew n) ≫
        eqToHom (congrArg (newWordObj A L) (Word.kept_allNew n)) = eqToHom (wordObj_allNew A K L n) := by
  simp only [wordReductionToNew, wordReduction_allNew, RightModule.eqToHom_hom,
    eqToHom_trans]

