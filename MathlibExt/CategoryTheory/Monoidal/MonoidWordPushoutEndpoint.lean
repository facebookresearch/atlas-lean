  have hf : (endpointWordLeg A k f n ⊗ₘ endpointLetter A k f) ≫ endpointMul A k f =
      (newWordObj A L n ◁ wordLetter A L) ≫ wordConcat A L n 1 ≫ endpointWordLeg A k f (n + 1) := by
    calc
      _ = (𝟙 (newWordObj A L n) ⊗ₘ wordLetter A L) ≫
          (endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f 1) ≫ endpointMul A k f := by
        rw [← Category.assoc, tensorHom_comp_tensorHom, Category.id_comp]
        rfl
      _ = _ := by rw [endpointMul_word, id_tensorHom]
  have h0 : (endpointWordLeg A k f (n + 1) ⊗ₘ rootMap A k f) ≫ endpointMul A k f =
      (wordModule A L L (Word.allNew (n + 1))).act ≫ endpointWordLeg A k f (n + 1) :=
    (endpointMul_word A k f (n + 1) 0).trans
      (congrArg (fun t => t ≫ endpointWordLeg A k f (n + 1)) (wordConcat_zero_right A L (n + 1)))
  rw [hf]
  calc
    _ = (((newWordObj A L n ◁ wordLetter A L) ≫ wordConcat A L n 1) ⊗ₘ 𝟙 A.X) ≫
        (endpointWordLeg A k f (n + 1) ⊗ₘ rootMap A k f) ≫ endpointMul A k f := by
      have ht := tensorHom_comp_tensorHom ((newWordObj A L n ◁ wordLetter A L) ≫ wordConcat A L n 1)
        (𝟙 A.X) (endpointWordLeg A k f (n + 1)) (rootMap A k f)
      simpa only [Category.assoc, Category.id_comp] using
        (congrArg (fun t => t ≫ endpointMul A k f) ht).symm
    _ = (((newWordObj A L n ◁ wordLetter A L) ≫ wordConcat A L n 1) ▷ A.X) ≫
        (wordModule A L L (Word.allNew (n + 1))).act ≫ endpointWordLeg A k f (n + 1) := by
      rw [h0, tensorHom_id]
    _ = ((((newWordObj A L n ◁ wordLetter A L) ≫ wordConcat A L n 1) ▷ A.X) ≫
        (wordModule A L L (Word.allNew (n + 1))).act) ≫ endpointWordLeg A k f (n + 1) :=
