/-- The original tensor product of any two supplied coproducts is jointly generated by all original injection pairs. -/
theorem sigma_tensor_hom_ext {I : Type ui} {J : Type uj} (F : I → C) (G : J → C)
    [HasCoproduct F] [HasCoproduct G] {X : C} {g h : (∐ F) ⊗ (∐ G) ⟶ X}
    (H : ∀ i j, (Sigma.ι F i ⊗ₘ Sigma.ι G j) ≫ g = (Sigma.ι F i ⊗ₘ Sigma.ι G j) ≫ h) : g = h := by
  apply ((colimit.isColimit (Discrete.functor F)).tensor₂ (colimit.isColimit (Discrete.functor G))).hom_ext
  rintro ⟨⟨i⟩, ⟨j⟩⟩
  dsimp only [Cocone.tensor₂, Functor.mapCocone₂]
  simp only [curriedTensor_map_app, curriedTensor_obj_map, Functor.const_obj_obj, Category.assoc]
  change (Sigma.ι F i ▷ G j) ≫ ((∐ F) ◁ Sigma.ι G j) ≫ g =
    (Sigma.ι F i ▷ G j) ≫ ((∐ F) ◁ Sigma.ι G j) ≫ h
  rw [← tensorHom_def_assoc, ← tensorHom_def_assoc]
  exact H i j

/-- The entire original finite-word tensor family has its constructed joint colimit witness. -/
def stageWordsTensorIsColimit (A : Mon C) (L : C) (N M : ℕ) :
    IsColimit ((colimit.cocone (Discrete.functor (fun i : Fin (N + 1) => newWordObj A L i.val))).tensor₂
      (colimit.cocone (Discrete.functor (fun j : Fin (M + 1) => newWordObj A L j.val)))) :=
  (colimit.isColimit (Discrete.functor (fun i : Fin (N + 1) => newWordObj A L i.val))).tensor₂
    (colimit.isColimit (Discrete.functor (fun j : Fin (M + 1) => newWordObj A L j.val)))

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Every original finite pair of full-word inclusions jointly determines a tensor-family map. -/
theorem stageWords_tensor_hom_ext (A : Mon C) (L : C) (N M : ℕ) {X : C}
    {g h : stageWords A L N ⊗ stageWords A L M ⟶ X}
    (H : ∀ (i : Fin (N + 1)) (j : Fin (M + 1)),
      (Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
        Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ≫ g =
      (Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
        Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ≫ h) : g = h := by
  exact sigma_tensor_hom_ext _ _ H

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The actual original word-stage tensors are jointly generated by their entire original word pairs. -/
theorem stage_tensor_hom_ext (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C}
    {g h : stage A k f N ⊗ stage A k f M ⟶ X}
    (H : ∀ (i j : ℕ) (hi : i ≤ N) (hj : j ≤ M),
      (stageWordLeg A k f N i hi ⊗ₘ stageWordLeg A k f M j hj) ≫ g =
        (stageWordLeg A k f N i hi ⊗ₘ stageWordLeg A k f M j hj) ≫ h) : g = h := by
  let qN : stageWords A L N ⟶ stage A k f N :=
    coequalizer.π (stageRelationLeft A L k N) (stageRelationRight A f N)
  let qM : stageWords A L M ⟶ stage A k f M :=
    coequalizer.π (stageRelationLeft A L k M) (stageRelationRight A f M)
  have : Epi (qN ▷ stageWords A L M) := by
    change Epi ((tensorRight (stageWords A L M)).map qN)
    infer_instance
  have : Epi (stage A k f N ◁ qM) := by
    change Epi ((tensorLeft (stage A k f N)).map qM)
    infer_instance
  have : Epi (qN ⊗ₘ qM) := by
    rw [tensorHom_def]
    infer_instance
  apply (cancel_epi (qN ⊗ₘ qM)).mp
  apply stageWords_tensor_hom_ext A L N M
  intro i j
  have hh := H i.val j.val (Nat.le_of_lt_succ i.isLt) (Nat.le_of_lt_succ j.isLt)
  simpa only [stageWordLeg, stageWordι, Category.assoc, tensorHom_comp_tensorHom_assoc] using hh

/-- The entire original countable stage tensor diagram has its constructed joint endpoint colimit witness. -/
def endpointTensorIsColimit (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) :
    IsColimit ((colimit.cocone (stageDiagram A k f)).tensor₂ (colimit.cocone (stageDiagram A k f))) :=
  (colimit.isColimit (stageDiagram A k f)).tensor₂ (colimit.isColimit (stageDiagram A k f))

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The actual countable endpoint tensor is jointly generated by every original full-word pair. -/
theorem endpoint_tensor_hom_ext (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) {X : C}
    {g h : stageEndpoint A k f ⊗ stageEndpoint A k f ⟶ X}
    (H : ∀ n m, (endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ≫ g =
      (endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ≫ h) : g = h := by
  apply (endpointTensorIsColimit A k f).hom_ext
  rintro ⟨N, M⟩
  dsimp only [Cocone.tensor₂, Functor.mapCocone₂]
  simp only [curriedTensor_map_app, curriedTensor_obj_map, Functor.const_obj_obj, Category.assoc]
  change (stageι A k f N ▷ stage A k f M) ≫ (stageEndpoint A k f ◁ stageι A k f M) ≫ g =
    (stageι A k f N ▷ stage A k f M) ≫ (stageEndpoint A k f ◁ stageι A k f M) ≫ h
  rw [← tensorHom_def_assoc, ← tensorHom_def_assoc]
  apply stage_tensor_hom_ext A k f N M
  intro i j hi hj
  rw [← Category.assoc, tensorHom_comp_tensorHom, endpointWordLeg_atStage, endpointWordLeg_atStage,
    ← Category.assoc, tensorHom_comp_tensorHom, endpointWordLeg_atStage, endpointWordLeg_atStage]
  exact H i j

omit [HasColimitsOfSize.{w, w} C] in
/-- Separate original tensor preservation retains both original epimorphisms in a tensor pair. -/
private theorem tensor_epi {X X' Y Y' : C} (f : X ⟶ X') (g : Y ⟶ Y') [Epi f] [Epi g] :
    Epi (f ⊗ₘ g) := by
  have : Epi (f ▷ Y) := by
    change Epi ((tensorRight Y).map f)
    infer_instance
  have : Epi (X' ◁ g) := by
    change Epi ((tensorLeft X').map g)
    infer_instance
  rw [tensorHom_def]
  infer_instance

/-- The entire original finite triple word family has its constructed joint colimit witness. -/
def stageWordsTripleIsColimit (A : Mon C) (L : C) (N M P : ℕ) :
    IsColimit (((colimit.cocone (Discrete.functor (fun i : Fin (N + 1) => newWordObj A L i.val))).tensor₂
      (colimit.cocone (Discrete.functor (fun j : Fin (M + 1) => newWordObj A L j.val)))).tensor₂
      (colimit.cocone (Discrete.functor (fun l : Fin (P + 1) => newWordObj A L l.val)))) :=
  (stageWordsTensorIsColimit A L N M).tensor₂
    (colimit.isColimit (Discrete.functor (fun l : Fin (P + 1) => newWordObj A L l.val)))

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Every original finite triple of full-word inclusions jointly determines a triple tensor-family map. -/
theorem stageWords_triple_hom_ext (A : Mon C) (L : C) (N M P : ℕ) {X : C}
    {g h : (stageWords A L N ⊗ stageWords A L M) ⊗ stageWords A L P ⟶ X}
    (H : ∀ (i : Fin (N + 1)) (j : Fin (M + 1)) (l : Fin (P + 1)),
      ((Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
        Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ⊗ₘ
          Sigma.ι (fun l : Fin (P + 1) => newWordObj A L l.val) l) ≫ g =
      ((Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
        Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ⊗ₘ
          Sigma.ι (fun l : Fin (P + 1) => newWordObj A L l.val) l) ≫ h) : g = h := by
  apply (stageWordsTripleIsColimit A L N M P).hom_ext
  rintro ⟨⟨⟨i⟩, ⟨j⟩⟩, ⟨l⟩⟩
  dsimp only [Cocone.tensor₂, Functor.mapCocone₂]
  simp only [curriedTensor_map_app, curriedTensor_obj_map, Functor.const_obj_obj,
    ← tensorHom_def]
  change ((Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
      Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ⊗ₘ
        Sigma.ι (fun l : Fin (P + 1) => newWordObj A L l.val) l) ≫ g =
    ((Sigma.ι (fun i : Fin (N + 1) => newWordObj A L i.val) i ⊗ₘ
      Sigma.ι (fun j : Fin (M + 1) => newWordObj A L j.val) j) ⊗ₘ
        Sigma.ι (fun l : Fin (P + 1) => newWordObj A L l.val) l) ≫ h
  exact H i j l

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The original three stage tensors are jointly generated by every original full-word triple. -/
theorem stage_triple_hom_ext (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M P : ℕ) {X : C}
    {g h : (stage A k f N ⊗ stage A k f M) ⊗ stage A k f P ⟶ X}
    (H : ∀ (i j l : ℕ) (hi : i ≤ N) (hj : j ≤ M) (hl : l ≤ P),
      ((stageWordLeg A k f N i hi ⊗ₘ stageWordLeg A k f M j hj) ⊗ₘ stageWordLeg A k f P l hl) ≫ g =
        ((stageWordLeg A k f N i hi ⊗ₘ stageWordLeg A k f M j hj) ⊗ₘ stageWordLeg A k f P l hl) ≫ h) : g = h := by
  let qN : stageWords A L N ⟶ stage A k f N :=
    coequalizer.π (stageRelationLeft A L k N) (stageRelationRight A f N)
  let qM : stageWords A L M ⟶ stage A k f M :=
    coequalizer.π (stageRelationLeft A L k M) (stageRelationRight A f M)
  let qP : stageWords A L P ⟶ stage A k f P :=
    coequalizer.π (stageRelationLeft A L k P) (stageRelationRight A f P)
  have : Epi (qN ⊗ₘ qM) := tensor_epi qN qM
  have : Epi ((qN ⊗ₘ qM) ⊗ₘ qP) := tensor_epi _ qP
  apply (cancel_epi ((qN ⊗ₘ qM) ⊗ₘ qP)).mp
  apply stageWords_triple_hom_ext A L N M P
  intro i j l
  have hh := H i.val j.val l.val (Nat.le_of_lt_succ i.isLt) (Nat.le_of_lt_succ j.isLt) (Nat.le_of_lt_succ l.isLt)
  simpa only [stageWordLeg, stageWordι, Category.assoc, tensorHom_comp_tensorHom_assoc,
    tensorHom_comp_tensorHom] using hh

/-- The actual original countable triple stage diagram has its constructed joint endpoint colimit witness. -/
def endpointTripleIsColimit (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) :
    IsColimit (((colimit.cocone (stageDiagram A k f)).tensor₂ (colimit.cocone (stageDiagram A k f))).tensor₂
      (colimit.cocone (stageDiagram A k f))) :=
  (endpointTensorIsColimit A k f).tensor₂ (colimit.isColimit (stageDiagram A k f))

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The actual countable endpoint triple tensor is jointly generated by every original full-word triple. -/
theorem endpoint_triple_hom_ext (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) {X : C}
    {g h : (stageEndpoint A k f ⊗ stageEndpoint A k f) ⊗ stageEndpoint A k f ⟶ X}
    (H : ∀ n m p, ((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ⊗ₘ endpointWordLeg A k f p) ≫ g =
      ((endpointWordLeg A k f n ⊗ₘ endpointWordLeg A k f m) ⊗ₘ endpointWordLeg A k f p) ≫ h) : g = h := by
  apply (endpointTripleIsColimit A k f).hom_ext
  rintro ⟨⟨N, M⟩, P⟩
  dsimp only [Cocone.tensor₂, Functor.mapCocone₂]
  simp only [curriedTensor_map_app, curriedTensor_obj_map, Functor.const_obj_obj,
    ← tensorHom_def]
  change ((stageι A k f N ⊗ₘ stageι A k f M) ⊗ₘ stageι A k f P) ≫ g =
    ((stageι A k f N ⊗ₘ stageι A k f M) ⊗ₘ stageι A k f P) ≫ h
  apply stage_triple_hom_ext A k f N M P
  intro i j l hi hj hl
  simp only [← Category.assoc, tensorHom_comp_tensorHom]
  rw [endpointWordLeg_atStage, endpointWordLeg_atStage, endpointWordLeg_atStage]
  exact H i j l

/-- Descend an actual original tensor-family map through its first original stage coequalizer. -/
def stageTensorFirst (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C}
    (u : stageWords A L N ⊗ stageWords A L M ⟶ X)
    (hl : (stageRelationLeft A L k N ▷ stageWords A L M) ≫ u =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ u) : stage A k f N ⊗ stageWords A L M ⟶ X :=
  (PreservesCoequalizer.iso (tensorRight (stageWords A L M)) (stageRelationLeft A L k N)
    (stageRelationRight A f N)).inv ≫ coequalizer.desc u hl

/-- The first tensor descender retains the actual original first-stage projection. -/
@[reassoc (attr := simp)] theorem stageTensorFirst_projection (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C} (u : stageWords A L N ⊗ stageWords A L M ⟶ X)
    (hl : (stageRelationLeft A L k N ▷ stageWords A L M) ≫ u =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ u) :
    (coequalizer.π (stageRelationLeft A L k N) (stageRelationRight A f N) ▷ stageWords A L M) ≫
        stageTensorFirst A k f N M u hl = u :=
  map_π_preserves_coequalizer_inv_desc (tensorRight (stageWords A L M)) _ _ u hl

/-- Both actual original relation families are retained after the first original tensor descent. -/
theorem stageTensorFirst_relations (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C}
    (u : stageWords A L N ⊗ stageWords A L M ⟶ X)
    (hl : (stageRelationLeft A L k N ▷ stageWords A L M) ≫ u =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ u)
    (hr : (stageWords A L N ◁ stageRelationLeft A L k M) ≫ u =
      (stageWords A L N ◁ stageRelationRight A f M) ≫ u) :
    (stage A k f N ◁ stageRelationLeft A L k M) ≫ stageTensorFirst A k f N M u hl =
      (stage A k f N ◁ stageRelationRight A f M) ≫ stageTensorFirst A k f N M u hl := by
  let q : stageWords A L N ⟶ stage A k f N :=
    coequalizer.π (stageRelationLeft A L k N) (stageRelationRight A f N)
  have : Epi (q ▷ stageFaces A K L M) := by
    change Epi ((tensorRight (stageFaces A K L M)).map q)
    infer_instance
  apply (cancel_epi (q ▷ stageFaces A K L M)).mp
  rw [← whisker_exchange_assoc, ← whisker_exchange_assoc,
    stageTensorFirst_projection]
  exact hr

/-- Descend an actual original tensor-family map through both original word-stage coequalizers. -/
def stageTensorDesc (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C}
    (u : stageWords A L N ⊗ stageWords A L M ⟶ X)
    (hl : (stageRelationLeft A L k N ▷ stageWords A L M) ≫ u =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ u)
    (hr : (stageWords A L N ◁ stageRelationLeft A L k M) ≫ u =
      (stageWords A L N ◁ stageRelationRight A f M) ≫ u) : stage A k f N ⊗ stage A k f M ⟶ X :=
  (PreservesCoequalizer.iso (tensorLeft (stage A k f N)) (stageRelationLeft A L k M)
    (stageRelationRight A f M)).inv ≫
      coequalizer.desc (stageTensorFirst A k f N M u hl) (stageTensorFirst_relations A k f N M u hl hr)

/-- The second tensor descender retains the actual original second-stage projection. -/
@[reassoc (attr := simp)] theorem stageTensorDesc_secondProjection (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C} (u : stageWords A L N ⊗ stageWords A L M ⟶ X)
    (hl : (stageRelationLeft A L k N ▷ stageWords A L M) ≫ u =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ u)
    (hr : (stageWords A L N ◁ stageRelationLeft A L k M) ≫ u =
      (stageWords A L N ◁ stageRelationRight A f M) ≫ u) :
    (stage A k f N ◁ coequalizer.π (stageRelationLeft A L k M) (stageRelationRight A f M)) ≫
        stageTensorDesc A k f N M u hl hr = stageTensorFirst A k f N M u hl :=
  map_π_preserves_coequalizer_inv_desc (tensorLeft (stage A k f N)) _ _
    (stageTensorFirst A k f N M u hl) (stageTensorFirst_relations A k f N M u hl hr)

/-- The actual entire original stage projections retain the complete original tensor-family descender. -/
@[reassoc (attr := simp)] theorem stageTensorDesc_projection (A : Mon C) {K L : C}
    (k : K ⟶ A.X) (f : K ⟶ L) (N M : ℕ) {X : C} (u : stageWords A L N ⊗ stageWords A L M ⟶ X)
    (hl : (stageRelationLeft A L k N ▷ stageWords A L M) ≫ u =
      (stageRelationRight A f N ▷ stageWords A L M) ≫ u)
    (hr : (stageWords A L N ◁ stageRelationLeft A L k M) ≫ u =
      (stageWords A L N ◁ stageRelationRight A f M) ≫ u) :
    (coequalizer.π (stageRelationLeft A L k N) (stageRelationRight A f N) ⊗ₘ
      coequalizer.π (stageRelationLeft A L k M) (stageRelationRight A f M)) ≫
        stageTensorDesc A k f N M u hl hr = u := by
  rw [tensorHom_def, Category.assoc]
  rw [stageTensorDesc_secondProjection, stageTensorFirst_projection]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Every actual original finite word-pair family gives its original discrete tensor cocone. -/
def wordPairsCocone (A : Mon C) (L : C) (N M : ℕ) {X : C}
    (u : ∀ (i : Fin (N + 1)) (j : Fin (M + 1)), newWordObj A L i.val ⊗ newWordObj A L j.val ⟶ X) :
    Cocone (externalProduct (Discrete.functor (fun i : Fin (N + 1) => newWordObj A L i.val))
      (Discrete.functor (fun j : Fin (M + 1) => newWordObj A L j.val))) where
  pt := X
  ι :=
    { app ij := u ij.1.as ij.2.as
      naturality ij kl h := by
        have hi : ij.1 = kl.1 := Discrete.ext (Discrete.eq_of_hom h.1)
        have hj : ij.2 = kl.2 := Discrete.ext (Discrete.eq_of_hom h.2)
        have he : ij = kl := Prod.ext hi hj
        subst kl
        have hh : h = 𝟙 ij := Prod.ext (Subsingleton.elim h.1 (𝟙 ij.1)) (Subsingleton.elim h.2 (𝟙 ij.2))
        rw [hh, Functor.map_id, Functor.const_obj_map]
        change (𝟙 (newWordObj A L ij.1.as.val ⊗ newWordObj A L ij.2.as.val)) ≫ u ij.1.as ij.2.as =
          u ij.1.as ij.2.as ≫ 𝟙 X
        rw [Category.id_comp, Category.comp_id] }

/-- The original finite word-pair cocone descends through the actual original tensor-family colimit. -/
def wordPairsDesc (A : Mon C) (L : C) (N M : ℕ) {X : C}
    (u : ∀ (i : Fin (N + 1)) (j : Fin (M + 1)), newWordObj A L i.val ⊗ newWordObj A L j.val ⟶ X) :
    stageWords A L N ⊗ stageWords A L M ⟶ X :=
  (stageWordsTensorIsColimit A L N M).desc (wordPairsCocone A L N M u)

