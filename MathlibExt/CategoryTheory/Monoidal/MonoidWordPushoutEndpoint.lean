/-- The original one-letter evaluation multiplies its original old, new and old target values. -/
theorem targetWord_one (A M : Mon C) (b : A ⟶ M) {K L : C} (x : K ⟶ M.X) (g : L ⟶ M.X) :
    targetWord A M b x g 1 = ((b.hom ⊗ₘ g) ⊗ₘ b.hom) ≫ (M.mon.mul ▷ M.X) ≫ M.mon.mul := by
  dsimp only [targetWord, Word.allNew, evaluateWord, RightModule.lift_hom, RightModule.ofMonHom,
    RightModule.restrict]
  rw [eqToHom_refl, Category.id_comp]
  rw [comp_whiskerRight, Category.assoc, ← whisker_exchange_assoc, ← tensorHom_def_assoc]

