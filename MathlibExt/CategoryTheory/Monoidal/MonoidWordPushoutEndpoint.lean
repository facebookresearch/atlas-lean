          (newWordObj A L n ◁ wordConcat A L m p) ≫ wordConcat A L n (m + p) ≫
            endpointWordLeg A k f (n + (m + p)) := by rw [endpointMul_word, id_tensorHom]
  rw [hl, hr, ← endpointWordLeg_transport A k f (Nat.add_assoc n m p)]
  simpa only [Category.assoc] using
    congrArg (fun t => t ≫ endpointWordLeg A k f (n + (m + p))) (wordConcat_assoc A L n m p)

/-- The actual original word-stage endpoint has its constructed unit,
multiplication and all monoid laws. -/
def endpointMonoid (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) : Mon C where
  X := stageEndpoint A k f
  mon :=
    { one := endpointOne A k f
      mul := endpointMul A k f
      one_mul := endpointOne_mul A k f
      mul_one := endpointMul_one A k f
      mul_assoc := endpointMul_assoc A k f }

/-- The actual original old monoid maps to the constructed endpoint as a complete monoid morphism. -/
def endpointOldMap (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) : A ⟶ endpointMonoid A k f := by
  refine Mon.Hom.mk' (rootMap A k f) ?_ ?_
  · change A.mon.one ≫ rootMap A k f = endpointOne A k f
    rfl
  · change A.mon.mul ≫ rootMap A k f = (rootMap A k f ⊗ₘ rootMap A k f) ≫ endpointMul A k f
    have h := endpointMul_word A k f 0 0
    rw [endpointWordLeg_zero, wordConcat_zero_right] at h
    exact h.symm

