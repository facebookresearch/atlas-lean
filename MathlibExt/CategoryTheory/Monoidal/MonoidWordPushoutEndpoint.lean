    (k : K ⟶ A.X) (f : K ⟶ L) (g : L ⟶ M.X) (h : k ≫ b.hom = f ≫ g) :
    endpointLetter A k f ≫ endpointEvaluation A M b k f g h = g := by
  dsimp only [endpointLetter]
  rw [Category.assoc, endpointWordLeg_evaluation, wordLetter_evaluate]

