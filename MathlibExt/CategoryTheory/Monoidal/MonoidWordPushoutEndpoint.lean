        rw [← Category.assoc, ← Category.assoc, associator_naturality, Category.assoc, Category.assoc]
      _ = (α_ (newWordObj A L n) (newWordObj A L m) (newWordObj A L p)).hom ≫
          (endpointWordLeg A k f n ⊗ₘ ((endpointWordLeg A k f m ⊗ₘ endpointWordLeg A k f p) ≫
            endpointMul A k f)) ≫ endpointMul A k f := by
        rw [← id_tensorHom (stageEndpoint A k f) (endpointMul A k f)]
        simp only [tensorHom_comp_tensorHom_assoc, Category.comp_id]
      _ = (α_ (newWordObj A L n) (newWordObj A L m) (newWordObj A L p)).hom ≫
          (endpointWordLeg A k f n ⊗ₘ (wordConcat A L m p ≫ endpointWordLeg A k f (m + p))) ≫
            endpointMul A k f := by rw [endpointMul_word]
      _ = (α_ (newWordObj A L n) (newWordObj A L m) (newWordObj A L p)).hom ≫
