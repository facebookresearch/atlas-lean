/-- Multiplying an original proper word by a complete new word retains its entire original stage relation. -/
theorem wordStage_relation_rightNew (A : Mon C) {K L : C} (k : K ⟶ A.X) (f : K ⟶ L) (R : ℕ)
    (p : Word) (j : ℕ) (h : p.length + j ≤ R) (hp : p.kept < p.length) :
    (wordReductionToNew A k p ⊗ₘ 𝟙 (newWordObj A L j)) ≫ wordConcat A L p.kept j ≫
        stageWordLeg A k f R (p.kept + j) ((Nat.add_le_add_right p.kept_le_length j).trans h) =
      (wordToNewHom A f p ⊗ₘ 𝟙 (newWordObj A L j)) ≫ wordConcat A L p.length j ≫
        stageWordLeg A k f R (p.length + j) h := by
  have hsum : p.length + (Word.allNew j).length ≤ R := by simpa only [Word.length_allNew] using h
  have hproper : (p.append (Word.allNew j)).kept < (p.append (Word.allNew j)).length := by
    rw [Word.kept_append, Word.length_append, Word.kept_allNew, Word.length_allNew]
    exact Nat.add_lt_add_right hp j
  have hh := congrArg (fun t => (𝟙 (wordObj A K L p) ⊗ₘ eqToHom (wordObj_allNew A K L j).symm) ≫ t)
    (pairWord_stage_relation A k f R p (Word.allNew j) hsum hproper)
  simp only [tensorHom_comp_tensorHom_assoc, Category.id_comp,
    inverseNewWord_reduction, inverseNewWord_face] at hh
  rw [wordSum_rightTransport A k f R p.kept (Word.kept_allNew j).symm
      ((Nat.add_le_add_right p.kept_le_length j).trans h) (wordReductionToNew A k p),
    wordSum_rightTransport A k f R p.length (Word.length_allNew j).symm h (wordToNewHom A f p)] at hh
  exact hh

