/-- The original letter injection evaluates to the exact original new target map. -/
@[reassoc] theorem wordLetter_evaluate (A M : Mon C) (b : A ⟶ M) {K L : C}
    (x : K ⟶ M.X) (g : L ⟶ M.X) : wordLetter A L ≫ targetWord A M b x g 1 = g := by
  rw [targetWord_one, ← Category.assoc, wordLetter_naturality, Category.assoc, wordLetter_mul, Category.comp_id]

