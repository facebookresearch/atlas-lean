/-!
# Intrinsic zero-grade localized core classes

The source subgroup is generated by actual fractions whose numerator and
denominator have the SAME original Grothendieck class. The definition does
not use the canonical whole-core comparison or its inverse. The existing
canonical positive fraction map restricts to the existing zero component,
and its value on each generator is the literal translated core map.

Surjectivity is derived from the entire graded core homology cofan and
the actual localization fraction presentation; it is not an input.
-/

noncomputable section

open CategoryTheory Limits Algebra ZeroObject
open scoped Simplicial

universe u

public section

namespace CategoryTheory.SInverseS

variable {C : Type u} [Category.{u} C] [Preadditive C]
  [HasZeroObject C] [HasBinaryBiproducts C]

private abbrev positiveWholeIso (A : AddCommGrpCat.{u}) (q : ℕ) :=
  secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫
    swapHomologyIso (C := C) A q

/-- The underlying original localized whole-core homology group. -/
abbrev localizedWholeCoreHomologyGroup (A : AddCommGrpCat.{u}) (q : ℕ) :=
  (forget₂ (ModuleCat.{u} (Localization (coreTranslationDenominators C)))
    AddCommGrpCat.{u}).obj (localizedCoreTranslationHomologyModuleCat C A q)

/-- One actual fraction with numerator in the denominator's original K0 grade. -/
def zeroCoreFraction (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    localizedWholeCoreHomologyGroup (C := C) A q :=
  LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
      (M := coreTranslationHomologyModule C A q)
    (((coreTranslationHomologyModuleAddCommGrpIso C A q).inv
      (SSet.homologyMap (C := AddCommGrpCat.{u})
        (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q x)) :
            coreTranslationHomologyModuleCat C A q)
    (coreTranslationDenominator C t)

private theorem zeroCoreFraction_eq_mk_aux
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    (zeroCoreFraction (C := C) A q t x :
      LocalizedModule (coreTranslationDenominators C) (coreTranslationHomologyModule C A q)) =
      LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
          (M := coreTranslationHomologyModule C A q)
        (((coreTranslationHomologyModuleAddCommGrpIso C A q).inv
          (SSet.homologyMap (C := AddCommGrpCat.{u})
            (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q x)) :
                coreTranslationHomologyModuleCat C A q)
        (coreTranslationDenominator C t) := rfl

/-- The fraction is the original numerator transported by the canonical core
coefficient Iso and divided by the SAME chosen skeleton denominator. -/
theorem zeroCoreFraction_eq_mk
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    (zeroCoreFraction (C := C) A q t x :
      LocalizedModule (coreTranslationDenominators C) (coreTranslationHomologyModule C A q)) =
      LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
          (M := coreTranslationHomologyModule C A q)
        (((coreTranslationHomologyModuleAddCommGrpIso C A q).inv
          (SSet.homologyMap (C := AddCommGrpCat.{u})
            (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q x)) :
                coreTranslationHomologyModuleCat C A q)
        (coreTranslationDenominator C t) :=
  zeroCoreFraction_eq_mk_aux (C := C) A q t x

/-- The original correctly graded fraction generators, independent of the comparison. -/
def zeroCoreFractionGenerators (A : AddCommGrpCat.{u}) (q : ℕ) :
    Set (localizedWholeCoreHomologyGroup (C := C) A q) :=
  {z | ∃ (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q),
    z = zeroCoreFraction (C := C) A q t x}

/-- The intrinsic zero additive summand generated by the original fraction grades.
It is an integer subgroup, not a submodule under all nonzero graded scalars. -/
def zeroLocalizedCoreSubgroup (A : AddCommGrpCat.{u}) (q : ℕ) :
    AddSubgroup (localizedWholeCoreHomologyGroup (C := C) A q) :=
  AddSubgroup.closure (zeroCoreFractionGenerators (C := C) A q)

/-- Every actual correctly graded fraction belongs to the intrinsic subgroup. -/
theorem zeroCoreFraction_mem (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    zeroCoreFraction (C := C) A q t x ∈ zeroLocalizedCoreSubgroup (C := C) A q :=
  AddSubgroup.subset_closure ⟨t, x, rfl⟩

/-- In EVERY degree the existing positive whole-core Iso sends the original
fraction generator through the literal map into the existing zero component. -/
theorem zeroCoreFraction_ambient_characteristic
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    (secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫ swapHomologyIso (C := C) A q).hom
        (zeroCoreFraction (C := C) A q t x) =
      SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (zeroComponentProperty (C := C)).ι) A q
        (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C := C)
            t)) A q x) := by
  let ε := coreTranslationHomologyModuleAddCommGrpIso C A q
  let i := SSet.homologyMap (C := AddCommGrpCat.{u})
    (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q
  let j := SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (coreInclusion (C := C))) A q
  let tau := SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (translateSecondFunctor t.out)) A q
  have hFraction :=
    (secondTranslationBKLocalizedCoreHomologyIso_swap_characteristic (C := C) A q).2.2.2
      t (ε.inv (i x))
  rw [pairTranslationHomologyIso_inv, pairSecondTranslationHomologyMap] at hFraction
  have hε : ε.hom (ε.inv (i x)) = i x := Iso.inv_hom_id_apply ε (i x)
  have hValue : (positiveWholeIso (C := C) A q).hom
      (zeroCoreFraction (C := C) A q t x) = tau (j (i x)) :=
    hFraction.trans (congrArg (fun z => tau (j z)) hε)
  have hSquare := ConcreteCategory.congr_hom
    (positiveZeroFractionHomologyMap_comp_inclusion (C := C) A q t) x
  exact hValue.trans hSquare.symm

private abbrev zeroInclusion (A : AddCommGrpCat.{u}) (q : ℕ) :=
  SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (zeroComponentProperty (C := C)).ι) A q

/-- The intrinsic subgroup's canonical image lies in the ACTUAL zero-component
inclusion; the membership is derived from the original fraction values. -/
theorem zeroLocalizedCoreSubgroup_image_in_zero
    (A : AddCommGrpCat.{u}) (q : ℕ) :
    zeroLocalizedCoreSubgroup (C := C) A q ≤
      (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (zeroComponentProperty (C := C)).ι) A
          q).hom.range.comap
        (secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫ swapHomologyIso (C := C) A
            q).hom.hom := by
  let target : AddSubgroup (localizedWholeCoreHomologyGroup (C := C) A q) :=
    (zeroInclusion (C := C) A q).hom.range.comap (positiveWholeIso (C := C) A q).hom.hom
  unfold zeroLocalizedCoreSubgroup
  change AddSubgroup.closure (zeroCoreFractionGenerators (C := C) A q) ≤ target
  apply (AddSubgroup.closure_le target).2
  intro z hz
  obtain ⟨t, x, rfl⟩ := hz
  exact ⟨SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C := C)
      t)) A q x,
    (zeroCoreFraction_ambient_characteristic (C := C) A q t x).symm⟩

private abbrev zeroRetraction (A : AddCommGrpCat.{u}) (q : ℕ) :=
  (zeroComponentHomologyMapSplitMono C A q).retraction

/-- The actual restriction of the canonical positive whole-core map to its
intrinsically graded source, with codomain the original categorical zero component. -/
def zeroLocalizedCoreComparison (A : AddCommGrpCat.{u}) (q : ℕ) :
    AddCommGrpCat.of (zeroLocalizedCoreSubgroup (C := C) A q) ⟶
      (nerve (ZeroComponent (C := C))).homology (C := AddCommGrpCat.{u}) A q :=
  AddCommGrpCat.ofHom ((zeroRetraction (C := C) A q).hom.comp
    ((positiveWholeIso (C := C) A q).hom.hom.comp
      (zeroLocalizedCoreSubgroup (C := C) A q).subtype))

private theorem zeroLocalizedCoreComparison_ambient_apply
    (A : AddCommGrpCat.{u}) (q : ℕ) (z : zeroLocalizedCoreSubgroup (C := C) A q) :
    zeroInclusion (C := C) A q (zeroLocalizedCoreComparison (C := C) A q z) =
      (positiveWholeIso (C := C) A q).hom z.val := by
  obtain ⟨y, hy⟩ := zeroLocalizedCoreSubgroup_image_in_zero (C := C) A q z.property
  have hR : zeroRetraction (C := C) A q (zeroInclusion (C := C) A q y) = y :=
    ConcreteCategory.congr_hom (zeroComponentHomologyMapSplitMono C A q).id y
  change zeroInclusion (C := C) A q
    (zeroRetraction (C := C) A q ((positiveWholeIso (C := C) A q).hom z.val)) =
      (positiveWholeIso (C := C) A q).hom z.val
  exact (congrArg (fun w => zeroInclusion (C := C) A q
    (zeroRetraction (C := C) A q w)) hy).symm.trans
      ((congrArg (zeroInclusion (C := C) A q) hR).trans hy)

/-- The entire restricted comparison square retains the canonical whole-core map. -/
theorem zeroLocalizedCoreComparison_comp_inclusion
    (A : AddCommGrpCat.{u}) (q : ℕ) :
    zeroLocalizedCoreComparison (C := C) A q ≫ SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap
        (zeroComponentProperty (C := C)).ι) A q =
      AddCommGrpCat.ofHom (zeroLocalizedCoreSubgroup (C := C) A q).subtype ≫
        (secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫ swapHomologyIso (C := C) A
            q).hom := by
  apply ConcreteCategory.hom_ext
  intro z
  exact zeroLocalizedCoreComparison_ambient_apply (C := C) A q z

/-- The restriction is injective because the original whole-core comparison is
an actual Iso; no homology-isomorphism premise is supplied. -/
theorem zeroLocalizedCoreComparison_injective
    (A : AddCommGrpCat.{u}) (q : ℕ) :
    Function.Injective (zeroLocalizedCoreComparison (C := C) A q) := by
  intro x y h
  apply Subtype.ext
  apply (AddCommGrpCat.mono_iff_injective (positiveWholeIso (C := C) A q).hom).mp
    (inferInstance : Mono (positiveWholeIso (C := C) A q).hom)
  exact (zeroLocalizedCoreComparison_ambient_apply (C := C) A q x).symm.trans
    ((congrArg (zeroInclusion (C := C) A q) h).trans
      (zeroLocalizedCoreComparison_ambient_apply (C := C) A q y))


private def coreK0Functor : Core C ⥤ Discrete (GrothendieckAddGroup (Skeleton C)) where
  obj X := Discrete.mk (coreK0Class X)
  map f := Discrete.eqToHom'
    (congrArg GrothendieckAddGroup.of (congr_toSkeleton_of_iso f.iso))
  map_id _ := Subsingleton.elim _ _
  map_comp _ _ := Subsingleton.elim _ _

private def coreComponentGrade (c : ConnectedComponents (Core C)) :
    GrothendieckAddGroup (Skeleton C) :=
  ConnectedComponents.liftFunctor (Core C) (coreK0Functor (C := C)) c

private theorem coreComponentGrade_mk (X : Core C) :
    coreComponentGrade (C := C) (ConnectedComponents.mk X) = coreK0Class X := rfl

private def coreComponentToGrade (c : ConnectedComponents (Core C)) :
    c.Component ⥤ CoreGrade (C := C) (coreComponentGrade (C := C) c) :=
  ObjectProperty.lift (coreGradeProperty (C := C) (coreComponentGrade (C := C) c)) c.ι
    (fun X => by
      have h := congrArg (coreComponentGrade (C := C)) X.property
      exact (coreComponentGrade_mk X.obj).symm.trans h)

private theorem coreComponentToGrade_comp_ι (c : ConnectedComponents (Core C)) :
    coreComponentToGrade (C := C) c ⋙
        (coreGradeProperty (C := C) (coreComponentGrade (C := C) c)).ι = c.ι := by
  unfold coreComponentToGrade
  rfl

private def coreComponentNerveCofan :
    Cofan (fun c : ConnectedComponents (Core C) => nerve c.Component) :=
  Cofan.mk (nerve (Core C)) (fun c => nerveMap c.ι)

private def coreComponentNerveCofanIsColimit :
    IsColimit (coreComponentNerveCofan (C := C)) := by
  let f := fun c : ConnectedComponents (Core C) => nerve c.Component
  let e : (∐ f) ≅ nerve (Core C) :=
    NerveDecomposition.nerveSigmaIso (C := fun c : ConnectedComponents (Core C) => c.Component) ≪≫
      decomposedNerveIso (Core C)
  apply (coproductIsCoproduct f).ofIsoColimit
  refine Cocone.ext e ?_
  rintro ⟨c⟩
  change Sigma.ι f c ≫ e.hom = nerveMap c.ι
  dsimp only [e]
  rw [Iso.trans_hom, ← Category.assoc, NerveDecomposition.nerveSigmaIso_ι,
    decomposedNerveIso_hom, nerveMap_comp]
  exact congrArg nerveMap (inclusion_comp_decomposedTo c)

private def coreComponentHomologyCofan (A : AddCommGrpCat.{u}) (q : ℕ) :
    Cofan (fun c : ConnectedComponents (Core C) => (nerve c.Component).homology (C :=
        AddCommGrpCat.{u}) A q) :=
  Cofan.mk ((nerve (Core C)).homology (C := AddCommGrpCat.{u}) A q)
    (fun c => SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap c.ι) A q)

private def coreComponentHomologyCofanIsColimit (A : AddCommGrpCat.{u}) (q : ℕ) :
    IsColimit (coreComponentHomologyCofan (C := C) A q) :=
  isColimitCofanMkObjOfIsColimit (SSet.homologyFunctor (C := AddCommGrpCat.{u}) A q)
    (fun c : ConnectedComponents (Core C) => nerve c.Component)
    (fun c => nerveMap c.ι) (coreComponentNerveCofanIsColimit (C := C))

private def pairGradeHomologyCofan (A : AddCommGrpCat.{u}) (q : ℕ) :
    Cofan (fun g : GrothendieckAddGroup (Skeleton C) =>
      (nerve (ComponentTranslation.Component (C := C) g)).homology (C := AddCommGrpCat.{u}) A q) :=
  Cofan.mk ((nerve (Pair C)).homology (C := AddCommGrpCat.{u}) A q)
    (fun g => SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap
        (ComponentTranslation.componentProperty g).ι) A q)

private def pairGradeNerveCofanIsColimit :
    IsColimit (Cofan.mk (nerve (Pair C))
      (fun g : GrothendieckAddGroup (Skeleton C) =>
        nerveMap (ComponentTranslation.componentProperty (C := C) g).ι)) := by
  exact (ComponentTranslation.originalClassNerveCofan_eq_mk (C := C)) ▸
    (ComponentTranslation.originalClassNerveCofanIsColimit (C := C))

private def pairGradeHomologyCofanIsColimit (A : AddCommGrpCat.{u}) (q : ℕ) :
    IsColimit (pairGradeHomologyCofan (C := C) A q) :=
  isColimitCofanMkObjOfIsColimit (SSet.homologyFunctor (C := AddCommGrpCat.{u}) A q)
    (fun g : GrothendieckAddGroup (Skeleton C) => nerve (ComponentTranslation.Component g))
    (fun g => nerveMap (ComponentTranslation.componentProperty g).ι)
    (pairGradeNerveCofanIsColimit (C := C))

private abbrev pairGradeHomologyFamily (A : AddCommGrpCat.{u}) (q : ℕ) :=
  fun g : GrothendieckAddGroup (Skeleton C) =>
    (nerve (ComponentTranslation.Component (C := C) g)).homology (C := AddCommGrpCat.{u}) A q

private def pairGradeHomologyIso (A : AddCommGrpCat.{u}) (q : ℕ) :
    (nerve (Pair C)).homology (C := AddCommGrpCat.{u}) A q ≅ ∐ pairGradeHomologyFamily (C := C) A q
        :=
  (pairGradeHomologyCofanIsColimit (C := C) A q).coconePointUniqueUpToIso
    (coproductIsCoproduct (pairGradeHomologyFamily (C := C) A q))

private theorem pairGradeHomologyIso_ι (A : AddCommGrpCat.{u}) (q : ℕ)
    (g : GrothendieckAddGroup (Skeleton C)) :
    SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (ComponentTranslation.componentProperty (C
        := C) g).ι) A q ≫
        (pairGradeHomologyIso (C := C) A q).hom =
      Sigma.ι (pairGradeHomologyFamily (C := C) A q) g :=
  IsColimit.comp_coconePointUniqueUpToIso_hom
    (pairGradeHomologyCofanIsColimit (C := C) A q)
    (coproductIsCoproduct (pairGradeHomologyFamily (C := C) A q)) ⟨g⟩

private def pairZeroProjection (A : AddCommGrpCat.{u}) (q : ℕ) :
    (nerve (Pair C)).homology (C := AddCommGrpCat.{u}) A q ⟶ (nerve (ZeroComponent (C :=
        C))).homology (C := AddCommGrpCat.{u}) A q := by
  classical
  exact (pairGradeHomologyIso (C := C) A q).hom ≫
    Sigma.π (pairGradeHomologyFamily (C := C) A q) 0

private theorem zeroInclusion_comp_pairZeroProjection (A : AddCommGrpCat.{u}) (q : ℕ) :
    zeroInclusion (C := C) A q ≫ pairZeroProjection (C := C) A q = 𝟙 _ := by
  classical
  unfold pairZeroProjection
  rw [← Category.assoc, pairGradeHomologyIso_ι]
  exact Sigma.ι_π_eq_id (pairGradeHomologyFamily (C := C) A q) 0

private theorem pairGradeInclusion_comp_pairZeroProjection
    (A : AddCommGrpCat.{u}) (q : ℕ) (g : GrothendieckAddGroup (Skeleton C)) (hg : g ≠ 0) :
    SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (ComponentTranslation.componentProperty (C
        := C) g).ι) A q ≫
        pairZeroProjection (C := C) A q = 0 := by
  classical
  unfold pairZeroProjection
  rw [← Category.assoc, pairGradeHomologyIso_ι]
  exact Sigma.ι_π_of_ne (pairGradeHomologyFamily (C := C) A q) hg

private theorem all_mem_of_colimit_cofan
    {I : Type u} {F : I → AddCommGrpCat.{u}} {V : AddCommGrpCat.{u}}
    (ι : ∀ i, F i ⟶ V) (hι : IsColimit (Cofan.mk V ι))
    (S : AddSubgroup V) (hS : ∀ i x, ι i x ∈ S) (x : V) : x ∈ S := by
  let Q : AddCommGrpCat.{u} := AddCommGrpCat.of (V ⧸ S)
  let f : V ⟶ Q := AddCommGrpCat.ofHom (QuotientAddGroup.mk' S)
  have hf : f = 0 := by
    apply hι.hom_ext
    rintro ⟨i⟩
    apply ConcreteCategory.hom_ext
    intro y
    exact (QuotientAddGroup.eq_zero_iff (ι i y)).mpr (hS i y)
  exact (QuotientAddGroup.eq_zero_iff x).mp (ConcreteCategory.congr_hom hf x)


private def fractionAt (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C) :
    (nerve (Core C)).homology (C := AddCommGrpCat.{u}) A q →+
      localizedWholeCoreHomologyGroup (C := C) A q :=
  (LocalizedModule.divBy (R := coreTranslationRing C) (S := coreTranslationDenominators C)
      (M := coreTranslationHomologyModule C A q) (coreTranslationDenominator C
          t)).toAddMonoidHom.comp
    ((LocalizedModule.mkLinearMap (coreTranslationDenominators C)
      (coreTranslationHomologyModule C A q)).toAddMonoidHom.comp
        (coreTranslationHomologyModuleAddCommGrpIso C A q).inv.hom)

private theorem fractionAt_apply (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (Core C)).homology (C := AddCommGrpCat.{u}) A q) :
    (fractionAt (C := C) A q t x :
      LocalizedModule (coreTranslationDenominators C) (coreTranslationHomologyModule C A q)) =
      LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
          (M := coreTranslationHomologyModule C A q) (((coreTranslationHomologyModuleAddCommGrpIso
              C A q).inv x) :
          coreTranslationHomologyModuleCat C A q)
        (coreTranslationDenominator C t) := by
  change LocalizedModule.divBy (R := coreTranslationRing C) (S := coreTranslationDenominators C)
      (M := coreTranslationHomologyModule C A q) (coreTranslationDenominator C t)
      (LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
        (M := coreTranslationHomologyModule C A q)
        (((coreTranslationHomologyModuleAddCommGrpIso C A q).inv x) :
          coreTranslationHomologyModuleCat C A q) 1) =
    LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
      (M := coreTranslationHomologyModule C A q)
      (((coreTranslationHomologyModuleAddCommGrpIso C A q).inv x) :
        coreTranslationHomologyModuleCat C A q) (coreTranslationDenominator C t)
  rw [LocalizedModule.divBy_apply, LocalizedModule.liftOn_mk]
  simp only [one_mul]

private theorem gradedFraction_ambient
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (g : GrothendieckAddGroup (Skeleton C)) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) g)).homology (C := AddCommGrpCat.{u}) A q) :
    (positiveWholeIso (C := C) A q).hom
        (fractionAt (C := C) A q t
          (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (coreGradeProperty (C := C) g).ι) A
              q x)) =
      SSet.homologyMap (C := AddCommGrpCat.{u})
        (nerveMap (ComponentTranslation.componentProperty
          (g - GrothendieckAddGroup.of t)).ι) A q
        (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveGradeFractionFunctor (C :=
            C) g t)) A q x) := by
  let F : CoreGrade (C := C) g ⥤
      ComponentTranslation.Component (C := C) (g - GrothendieckAddGroup.of t) :=
    positiveGradeFractionFunctor (C := C) g t
  let Z : ComponentTranslation.Component (C := C) (g - GrothendieckAddGroup.of t) ⥤ Pair C :=
    (ComponentTranslation.componentProperty (C := C) (g - GrothendieckAddGroup.of t)).ι
  let I : CoreGrade (C := C) g ⥤ Core C := (coreGradeProperty (C := C) g).ι
  let K : Core C ⥤ Pair C := coreInclusion (C := C)
  let T : Pair C ⥤ Pair C := translateSecondFunctor t.out
  let Xg : SSet.{u} := nerve (CoreGrade (C := C) g)
  let Xz : SSet.{u} := nerve (ComponentTranslation.Component (C := C)
    (g - GrothendieckAddGroup.of t))
  let Xc : SSet.{u} := nerve (Core C)
  let Xp : SSet.{u} := nerve (Pair C)
  let nf : Xg ⟶ Xz := nerveMap F
  let nz : Xz ⟶ Xp := nerveMap Z
  let ni : Xg ⟶ Xc := nerveMap I
  let nk : Xc ⟶ Xp := nerveMap K
  let nt : Xp ⟶ Xp := nerveMap T
  let H : SSet.{u} ⥤ AddCommGrpCat.{u} :=
    SSet.homologyFunctor (C := AddCommGrpCat.{u}) A q
  let ε := coreTranslationHomologyModuleAddCommGrpIso C A q
  let i : H.obj Xg ⟶ H.obj Xc := H.map ni
  let j : H.obj Xc ⟶ H.obj Xp := H.map nk
  let tau : H.obj Xp ⟶ H.obj Xp := H.map nt
  have hFraction :=
    (secondTranslationBKLocalizedCoreHomologyIso_swap_characteristic (C := C) A q).2.2.2
      t (ε.inv (i x))
  rw [pairTranslationHomologyIso_inv, pairSecondTranslationHomologyMap] at hFraction
  have hε : ε.hom (ε.inv (i x)) = i x := Iso.inv_hom_id_apply ε (i x)
  have hValue : (positiveWholeIso (C := C) A q).hom
      (fractionAt (C := C) A q t (i x)) = tau (j (i x)) :=
    (congrArg (positiveWholeIso (C := C) A q).hom
      (fractionAt_apply (C := C) A q t (i x))).trans
        (hFraction.trans (congrArg (fun value => tau (j value)) hε))
  have hFunctor : F ⋙ Z = I ⋙ K ⋙ T :=
    positiveGradeFractionFunctor_comp_ι (C := C) g t
  have hNerve : nf ≫ nz = ni ≫ nk ≫ nt := by
    ext Δ chain
    change ((F ⋙ Z).mapComposableArrows Δ.unop.len).obj chain =
      ((I ⋙ K ⋙ T).mapComposableArrows Δ.unop.len).obj chain
    exact congrArg
      (fun W : CoreGrade (C := C) g ⥤ Pair C =>
        (W.mapComposableArrows Δ.unop.len).obj chain) hFunctor
  have hSquare : H.map nf ≫ H.map nz = i ≫ j ≫ tau := by
    calc
      H.map nf ≫ H.map nz = H.map (nf ≫ nz) := (H.map_comp nf nz).symm
      _ = H.map (ni ≫ nk ≫ nt) :=
        congrArg (fun arrow : Xg ⟶ Xp => H.map arrow) hNerve
      _ = i ≫ j ≫ tau := by
        rw [H.map_comp, H.map_comp]
  exact hValue.trans (ConcreteCategory.congr_hom hSquare x).symm


private abbrev zeroImage (A : AddCommGrpCat.{u}) (q : ℕ) :
    AddSubgroup ((nerve (Pair C)).homology (C := AddCommGrpCat.{u}) A q) :=
  (zeroLocalizedCoreSubgroup (C := C) A q).map (positiveWholeIso (C := C) A q).hom.hom

private def projectedFraction (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C) :
    (nerve (Core C)).homology (C := AddCommGrpCat.{u}) A q →+ (nerve (Pair C)).homology (C :=
        AddCommGrpCat.{u}) A q :=
  (zeroInclusion (C := C) A q).hom.comp
    ((pairZeroProjection (C := C) A q).hom.comp
      ((positiveWholeIso (C := C) A q).hom.hom.comp (fractionAt (C := C) A q t)))

private theorem projectedFraction_grade_mem
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (g : GrothendieckAddGroup (Skeleton C)) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) g)).homology (C := AddCommGrpCat.{u}) A q) :
    projectedFraction (C := C) A q t
        (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (coreGradeProperty (C := C) g).ι) A q
            x) ∈
      zeroImage (C := C) A q := by
  classical
  by_cases hg : g = GrothendieckAddGroup.of t
  · subst g
    let z := zeroCoreFraction (C := C) A q t x
    let y := SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C
        := C) t)) A q x
    have hz : fractionAt (C := C) A q t
        (SSet.homologyMap (C := AddCommGrpCat.{u})
          (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q x) = z :=
      fractionAt_apply (C := C) A q t _
    have hImage : (positiveWholeIso (C := C) A q).hom z =
        zeroInclusion (C := C) A q y :=
      zeroCoreFraction_ambient_characteristic (C := C) A q t x
    have hProjection : zeroInclusion (C := C) A q
        (pairZeroProjection (C := C) A q ((positiveWholeIso (C := C) A q).hom z)) =
          (positiveWholeIso (C := C) A q).hom z :=
      (congrArg (fun w => zeroInclusion (C := C) A q
        (pairZeroProjection (C := C) A q w)) hImage).trans
          ((congrArg (zeroInclusion (C := C) A q)
            (ConcreteCategory.congr_hom
              (zeroInclusion_comp_pairZeroProjection (C := C) A q) y)).trans hImage.symm)
    refine ⟨z, zeroCoreFraction_mem (C := C) A q t x, ?_⟩
    exact ((congrArg (fun w => zeroInclusion (C := C) A q
      (pairZeroProjection (C := C) A q ((positiveWholeIso (C := C) A q).hom w))) hz).trans
        hProjection).symm
  · let delta := g - GrothendieckAddGroup.of t
    let y := SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveGradeFractionFunctor (C
        := C) g t)) A q x
    have hDelta : delta ≠ 0 := sub_ne_zero.mpr hg
    have hKill := ConcreteCategory.congr_hom
      (pairGradeInclusion_comp_pairZeroProjection (C := C) A q delta hDelta) y
    have hImage := gradedFraction_ambient (C := C) A q g t x
    have hZero : projectedFraction (C := C) A q t
        (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (coreGradeProperty (C := C) g).ι) A q
            x) = 0 :=
      (congrArg (fun w => zeroInclusion (C := C) A q
        (pairZeroProjection (C := C) A q w)) hImage).trans
          ((congrArg (zeroInclusion (C := C) A q) hKill).trans
            (map_zero (zeroInclusion (C := C) A q).hom))
    exact hZero.symm ▸ (zeroImage (C := C) A q).zero_mem

private theorem projectedFraction_core_mem
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (Core C)).homology (C := AddCommGrpCat.{u}) A q) :
    projectedFraction (C := C) A q t x ∈ zeroImage (C := C) A q := by
  let S := (zeroImage (C := C) A q).comap (projectedFraction (C := C) A q t)
  apply all_mem_of_colimit_cofan
    (fun c : ConnectedComponents (Core C) =>
      SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap c.ι) A q)
    (coreComponentHomologyCofanIsColimit (C := C) A q) S _ x
  intro c y
  let g := coreComponentGrade (C := C) c
  let U : c.Component ⥤ CoreGrade (C := C) g := coreComponentToGrade (C := C) c
  let I : CoreGrade (C := C) g ⥤ Core C := (coreGradeProperty (C := C) g).ι
  let Xu : SSet.{u} := nerve c.Component
  let Xg : SSet.{u} := nerve (CoreGrade (C := C) g)
  let Xc : SSet.{u} := nerve (Core C)
  let nu : Xu ⟶ Xg := nerveMap U
  let ni : Xg ⟶ Xc := nerveMap I
  let nc : Xu ⟶ Xc := nerveMap c.ι
  let H : SSet.{u} ⥤ AddCommGrpCat.{u} :=
    SSet.homologyFunctor (C := AddCommGrpCat.{u}) A q
  let v := H.map nu y
  have hFunctor : U ⋙ I = c.ι := coreComponentToGrade_comp_ι (C := C) c
  have hNerve : nu ≫ ni = nc := by
    ext Δ chain
    change ((U ⋙ I).mapComposableArrows Δ.unop.len).obj chain =
      (c.ι.mapComposableArrows Δ.unop.len).obj chain
    exact congrArg
      (fun W : c.Component ⥤ Core C =>
        (W.mapComposableArrows Δ.unop.len).obj chain) hFunctor
  have hMap : H.map nu ≫ H.map ni = H.map nc :=
    (H.map_comp nu ni).symm.trans
      (congrArg (fun arrow : Xu ⟶ Xc => H.map arrow) hNerve)
  have hSquare :
      SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap c.ι) A q y =
        SSet.homologyMap (C := AddCommGrpCat.{u})
          (nerveMap (coreGradeProperty (C := C) g).ι) A q v :=
    (ConcreteCategory.congr_hom hMap y).symm
  change projectedFraction (C := C) A q t
    (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap c.ι) A q y) ∈ zeroImage (C := C) A q
  rw [hSquare]
  exact projectedFraction_grade_mem (C := C) A q g t v


private theorem projectedWhole_mem
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (z : localizedWholeCoreHomologyGroup (C := C) A q) :
    zeroInclusion (C := C) A q
        (pairZeroProjection (C := C) A q ((positiveWholeIso (C := C) A q).hom z)) ∈
      zeroImage (C := C) A q := by
  induction z using LocalizedModule.induction_on with
  | h x d =>
    obtain ⟨m, hm⟩ := MonoidHom.mem_mrange.mp d.property
    let t : Skeleton C := m.toAdd
    have hd : d = coreTranslationDenominator C t := by
      apply Subtype.ext
      exact hm.symm
    subst d
    let ε := coreTranslationHomologyModuleAddCommGrpIso C A q
    let y := ε.hom x
    have h := projectedFraction_core_mem (C := C) A q t y
    have hFraction : fractionAt (C := C) A q t y =
        LocalizedModule.mk (R := coreTranslationRing C) (S := coreTranslationDenominators C)
            (M := coreTranslationHomologyModule C A q) (x : coreTranslationHomologyModuleCat C A q)
            (coreTranslationDenominator C t) :=
      (fractionAt_apply (C := C) A q t y).trans
        (congrArg (fun w => LocalizedModule.mk (R := coreTranslationRing C) (S :=
            coreTranslationDenominators C)
            (M := coreTranslationHomologyModule C A q) (w : coreTranslationHomologyModuleCat C A q)
            (coreTranslationDenominator C t))
          (Iso.hom_inv_id_apply ε x))
    exact (congrArg (fun w => zeroInclusion (C := C) A q
      (pairZeroProjection (C := C) A q ((positiveWholeIso (C := C) A q).hom w)))
        hFraction) ▸ h

/-- The entire zero target is reached by intrinsic correctly graded fractions.
The proof projects the actual graded core cofan and actual fraction presentation,
not an assumed graded or equivariant inverse. -/
theorem zeroLocalizedCoreComparison_surjective
    (A : AddCommGrpCat.{u}) (q : ℕ) :
    Function.Surjective (zeroLocalizedCoreComparison (C := C) A q) := by
  intro y
  let E := positiveWholeIso (C := C) A q
  let z := E.inv (zeroInclusion (C := C) A q y)
  have hMem := projectedWhole_mem (C := C) A q z
  have hProjection : zeroInclusion (C := C) A q
      (pairZeroProjection (C := C) A q (E.hom z)) = zeroInclusion (C := C) A q y :=
    (congrArg (fun w => zeroInclusion (C := C) A q
      (pairZeroProjection (C := C) A q w))
        (Iso.inv_hom_id_apply E (zeroInclusion (C := C) A q y))).trans
          (congrArg (zeroInclusion (C := C) A q)
            (ConcreteCategory.congr_hom
              (zeroInclusion_comp_pairZeroProjection (C := C) A q) y))
  have hRange : zeroInclusion (C := C) A q y ∈ zeroImage (C := C) A q :=
    hProjection ▸ hMem
  obtain ⟨x, hx, he⟩ := hRange
  refine ⟨⟨x, hx⟩, ?_⟩
  apply (AddCommGrpCat.mono_iff_injective (zeroInclusion (C := C) A q)).mp
    (inferInstance : Mono (zeroInclusion (C := C) A q))
  exact (zeroLocalizedCoreComparison_ambient_apply (C := C) A q ⟨x, hx⟩).trans he

private theorem zeroLocalizedCoreComparison_isIso
    (A : AddCommGrpCat.{u}) (q : ℕ) :
    IsIso (zeroLocalizedCoreComparison (C := C) A q) := by
  let : Mono (zeroLocalizedCoreComparison (C := C) A q) :=
    (AddCommGrpCat.mono_iff_injective _).mpr
      (zeroLocalizedCoreComparison_injective (C := C) A q)
  let : Epi (zeroLocalizedCoreComparison (C := C) A q) :=
    (AddCommGrpCat.epi_iff_surjective _).mpr
      (zeroLocalizedCoreComparison_surjective (C := C) A q)
  exact isIso_of_mono_of_epi _

/-- The canonical localized whole-core Iso restricts to the INTRINSIC zero-K0
summand in EVERY homological degree. No homology Iso or grading witness is input. -/
def zeroLocalizedCoreHomologyIso (A : AddCommGrpCat.{u}) (q : ℕ) :
    AddCommGrpCat.of (zeroLocalizedCoreSubgroup (C := C) A q) ≅
      (nerve (ZeroComponent (C := C))).homology (C := AddCommGrpCat.{u}) A q :=
  @asIso _ _ _ _ (zeroLocalizedCoreComparison (C := C) A q)
    (zeroLocalizedCoreComparison_isIso (C := C) A q)

/-- The forward map is the SAME computed restriction of the original positive comparison. -/
theorem zeroLocalizedCoreHomologyIso_hom (A : AddCommGrpCat.{u}) (q : ℕ) :
    (zeroLocalizedCoreHomologyIso (C := C) A q).hom =
      zeroLocalizedCoreComparison (C := C) A q := by
  unfold zeroLocalizedCoreHomologyIso
  rfl

/-- The whole original inclusion square calibrates the restricted homology Iso. -/
theorem zeroLocalizedCoreHomologyIso_comp_inclusion
    (A : AddCommGrpCat.{u}) (q : ℕ) :
    (zeroLocalizedCoreHomologyIso (C := C) A q).hom ≫
        SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (zeroComponentProperty (C := C)).ι) A
            q =
      AddCommGrpCat.ofHom (zeroLocalizedCoreSubgroup (C := C) A q).subtype ≫
        (secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫
          swapHomologyIso (C := C) A q).hom := by
  rw [zeroLocalizedCoreHomologyIso_hom]
  exact zeroLocalizedCoreComparison_comp_inclusion (C := C) A q

/-- Each correctly graded skeleton fraction retains the literal translated
core map, including its original second-coordinate zero unitor. -/
theorem zeroLocalizedCoreHomologyIso_hom_fraction
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    (zeroLocalizedCoreHomologyIso (C := C) A q).hom
        ⟨zeroCoreFraction (C := C) A q t x, zeroCoreFraction_mem (C := C) A q t x⟩ =
      SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C := C)
          t)) A q x := by
  rw [zeroLocalizedCoreHomologyIso_hom]
  apply (AddCommGrpCat.mono_iff_injective (zeroInclusion (C := C) A q)).mp
    (inferInstance : Mono (zeroInclusion (C := C) A q))
  exact (zeroLocalizedCoreComparison_ambient_apply (C := C) A q
    ⟨zeroCoreFraction (C := C) A q t x, zeroCoreFraction_mem (C := C) A q t x⟩).trans
      (zeroCoreFraction_ambient_characteristic (C := C) A q t x)

/-- The inverse is forced by the original whole-core inverse and actual zero inclusion. -/
theorem zeroLocalizedCoreHomologyIso_inv_val
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (y : (nerve (ZeroComponent (C := C))).homology (C := AddCommGrpCat.{u}) A q) :
    ((zeroLocalizedCoreHomologyIso (C := C) A q).inv y).val =
      (secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫
        swapHomologyIso (C := C) A q).inv
        (SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (zeroComponentProperty (C := C)).ι) A
            q y) := by
  let e := zeroLocalizedCoreHomologyIso (C := C) A q
  let E := positiveWholeIso (C := C) A q
  have he : zeroLocalizedCoreComparison (C := C) A q (e.inv y) = y := by
    have h := Iso.inv_hom_id_apply e y
    rw [zeroLocalizedCoreHomologyIso_hom] at h
    exact h
  have hE : E.hom (e.inv y).val = zeroInclusion (C := C) A q y :=
    (zeroLocalizedCoreComparison_ambient_apply (C := C) A q (e.inv y)).symm.trans
      (congrArg (zeroInclusion (C := C) A q) he)
  exact (Iso.hom_inv_id_apply E (e.inv y).val).symm.trans (congrArg E.inv hE)


/-- The intrinsic zero subgroup is an actual additive summand of the original
localized group. Its retraction uses the SAME canonical comparison and zero projection. -/
def zeroLocalizedCoreSubgroupSplitMono (A : AddCommGrpCat.{u}) (q : ℕ) :
    SplitMono (AddCommGrpCat.ofHom (zeroLocalizedCoreSubgroup (C := C) A q).subtype) where
  retraction := (positiveWholeIso (C := C) A q).hom ≫
    pairZeroProjection (C := C) A q ≫ (zeroLocalizedCoreHomologyIso (C := C) A q).inv
  id := by
    apply ConcreteCategory.hom_ext
    intro x
    let e := zeroLocalizedCoreHomologyIso (C := C) A q
    let E := positiveWholeIso (C := C) A q
    let J := zeroInclusion (C := C) A q
    let P := pairZeroProjection (C := C) A q
    change e.inv (P (E.hom x.val)) = x
    have hE : E.hom x.val = J (e.hom x) :=
      (zeroLocalizedCoreComparison_ambient_apply (C := C) A q x).symm
    have hP : P (E.hom x.val) = e.hom x :=
      (congrArg P hE).trans
        (ConcreteCategory.congr_hom
          (zeroInclusion_comp_pairZeroProjection (C := C) A q) (e.hom x))
    exact (congrArg e.inv hP).trans (Iso.hom_inv_id_apply e x)

/-- The actual fixed-denominator additive map from the ENTIRE numerator grade
into the intrinsic zero subgroup. The target is not defined through the comparison. -/
def zeroCoreFractionMap (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C) :
    (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u}) A q ⟶
      AddCommGrpCat.of (zeroLocalizedCoreSubgroup (C := C) A q) := by
  let i := SSet.homologyMap (C := AddCommGrpCat.{u})
    (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q
  let f := (fractionAt (C := C) A q t).comp i.hom
  exact AddCommGrpCat.ofHom
    (f.codRestrict (zeroLocalizedCoreSubgroup (C := C) A q) (fun x => by
      have hValue : f x = zeroCoreFraction (C := C) A q t x :=
        (fractionAt_apply (C := C) A q t (i x)).trans
          (zeroCoreFraction_eq_mk (C := C) A q t x).symm
      exact hValue.symm ▸ zeroCoreFraction_mem (C := C) A q t x))

private theorem zeroCoreFractionMap_apply_aux
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    (zeroCoreFractionMap (C := C) A q t x).val = zeroCoreFraction (C := C) A q t x := by
  unfold zeroCoreFractionMap
  change fractionAt (C := C) A q t
    (SSet.homologyMap (C := AddCommGrpCat.{u})
      (nerveMap (coreGradeProperty (C := C) (GrothendieckAddGroup.of t)).ι) A q x) = _
  exact (fractionAt_apply (C := C) A q t _).trans
    (zeroCoreFraction_eq_mk (C := C) A q t x).symm

/-- The additive map has the SAME original fraction value in every degree. -/
theorem zeroCoreFractionMap_apply
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C)
    (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C := AddCommGrpCat.{u})
        A q) :
    (zeroCoreFractionMap (C := C) A q t x).val = zeroCoreFraction (C := C) A q t x :=
  zeroCoreFractionMap_apply_aux (C := C) A q t x

/-- The entire additive numerator map followed by the restricted Iso is the
literal translated-core map into the original zero component, including t ⊞ 0. -/
theorem zeroCoreFractionMap_comp_homologyIso
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C) :
    zeroCoreFractionMap (C := C) A q t ≫
        (zeroLocalizedCoreHomologyIso (C := C) A q).hom =
      SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C := C)
          t)) A q := by
  apply ConcreteCategory.hom_ext
  intro x
  have hx : zeroCoreFractionMap (C := C) A q t x =
      ⟨zeroCoreFraction (C := C) A q t x, zeroCoreFraction_mem (C := C) A q t x⟩ :=
    Subtype.ext (zeroCoreFractionMap_apply_aux (C := C) A q t x)
  exact (congrArg
    (fun z : zeroLocalizedCoreSubgroup (C := C) A q =>
      (zeroLocalizedCoreHomologyIso (C := C) A q).hom z) hx).trans
        (zeroLocalizedCoreHomologyIso_hom_fraction (C := C) A q t x)

/-- The whole fixed-denominator map calibrates the SAME original positive
localized comparison and zero inclusion; no coordinate or inverse is supplied. -/
theorem zeroCoreFractionMap_comp_canonical
    (A : AddCommGrpCat.{u}) (q : ℕ) (t : Skeleton C) :
    (zeroCoreFractionMap (C := C) A q t ≫
        AddCommGrpCat.ofHom (zeroLocalizedCoreSubgroup (C := C) A q).subtype) ≫
          (secondTranslationBKLocalizedCoreHomologyIso (C := C) A q ≪≫
            swapHomologyIso (C := C) A q).hom =
      SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C := C)
          t)) A q ≫
        SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (zeroComponentProperty (C := C)).ι) A
            q := by
  let m := zeroCoreFractionMap (C := C) A q t
  let s := AddCommGrpCat.ofHom (zeroLocalizedCoreSubgroup (C := C) A q).subtype
  let E := positiveWholeIso (C := C) A q
  let e := zeroLocalizedCoreHomologyIso (C := C) A q
  let j := zeroInclusion (C := C) A q
  let v := SSet.homologyMap (C := AddCommGrpCat.{u}) (nerveMap (positiveZeroFractionFunctor (C :=
      C) t)) A q
  have hSquare : e.hom ≫ j = s ≫ E.hom :=
    zeroLocalizedCoreHomologyIso_comp_inclusion (C := C) A q
  have hFraction : m ≫ e.hom = v :=
    zeroCoreFractionMap_comp_homologyIso (C := C) A q t
  change (m ≫ s) ≫ E.hom = v ≫ j
  calc
    (m ≫ s) ≫ E.hom = m ≫ (s ≫ E.hom) := Category.assoc m s E.hom
    _ = m ≫ (e.hom ≫ j) := congrArg (fun k => m ≫ k) hSquare.symm
    _ = (m ≫ e.hom) ≫ j := (Category.assoc m e.hom j).symm
    _ = v ≫ j := congrArg (fun k => k ≫ j) hFraction

private theorem zeroLocalizedCoreSubgroup_le_aux
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (S : AddSubgroup (localizedWholeCoreHomologyGroup (C := C) A q))
    (h : ∀ (t : Skeleton C)
      (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C :=
          AddCommGrpCat.{u}) A q),
      zeroCoreFraction (C := C) A q t x ∈ S) :
    zeroLocalizedCoreSubgroup (C := C) A q ≤ S := by
  change AddSubgroup.closure (zeroCoreFractionGenerators (C := C) A q) ≤ S
  apply (AddSubgroup.closure_le S).2
  intro z hz
  obtain ⟨t, x, rfl⟩ := hz
  exact h t x

/-- The intrinsic subgroup is the LEAST additive subgroup containing every
original correctly graded fraction in EVERY homological degree. -/
theorem zeroLocalizedCoreSubgroup_le_iff
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (S : AddSubgroup (localizedWholeCoreHomologyGroup (C := C) A q)) :
    zeroLocalizedCoreSubgroup (C := C) A q ≤ S ↔
      ∀ (t : Skeleton C)
        (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C :=
            AddCommGrpCat.{u}) A q),
        zeroCoreFraction (C := C) A q t x ∈ S := by
  constructor
  · intro h t x
    exact h (zeroCoreFraction_mem (C := C) A q t x)
  · exact zeroLocalizedCoreSubgroup_le_aux (C := C) A q S

/-- Generator leastness expressed through the SAME computed additive numerator
maps. In particular it applies to an actual finite-stage image subgroup. -/
theorem zeroLocalizedCoreSubgroup_le_iff_fractionMap
    (A : AddCommGrpCat.{u}) (q : ℕ)
    (S : AddSubgroup (localizedWholeCoreHomologyGroup (C := C) A q)) :
    zeroLocalizedCoreSubgroup (C := C) A q ≤ S ↔
      ∀ (t : Skeleton C)
        (x : (nerve (CoreGrade (C := C) (GrothendieckAddGroup.of t))).homology (C :=
            AddCommGrpCat.{u}) A q),
        (zeroCoreFractionMap (C := C) A q t x).val ∈ S := by
  constructor
  · intro h t x
    exact (zeroCoreFractionMap_apply (C := C) A q t x).symm ▸
      h (zeroCoreFraction_mem (C := C) A q t x)
  · intro h
    apply (zeroLocalizedCoreSubgroup_le_iff (C := C) A q S).mpr
    intro t x
    exact (zeroCoreFractionMap_apply (C := C) A q t x) ▸ h t x

end CategoryTheory.SInverseS

end
