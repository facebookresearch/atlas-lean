module

public import MathlibExt.InformationTheory.ConditionalEntropy

/-!
# Actual-law functional representations

Conditioning is on actual coordinate-generated sigma-algebras. A functional
representation preserves the actual XY law, has zero KL information between
X and S, and recovers Y by an actual measurable function almost everywhere.
No finite or discrete restriction is imposed on the auxiliary space.
-/

@[expose] public section

namespace InformationTheory

open MeasureTheory
open scoped ENNReal

/-- The sigma-algebra generated by the auxiliary coordinate of a triple law. -/
def auxiliaryConditioning {X Y S : Type*}
    [mX : MeasurableSpace X] [mY : MeasurableSpace Y] [mS : MeasurableSpace S] :
    {m : MeasurableSpace ((X × Y) × S) //
      m ≤ @Prod.instMeasurableSpace (X × Y) S (@Prod.instMeasurableSpace X Y mX mY) mS} :=
  ⟨MeasurableSpace.comap Prod.snd mS, measurable_snd.comap_le⟩

/-- The sigma-algebra generated jointly by input and auxiliary coordinates. -/
def inputAuxiliaryConditioning {X Y S : Type*}
    [mX : MeasurableSpace X] [mY : MeasurableSpace Y] [mS : MeasurableSpace S] :
    {m : MeasurableSpace ((X × Y) × S) //
      m ≤ @Prod.instMeasurableSpace (X × Y) S (@Prod.instMeasurableSpace X Y mX mY) mS} :=
  ⟨MeasurableSpace.comap (fun z => (z.1.1, z.2)) (@Prod.instMeasurableSpace X S mX mS),
    (measurable_fst.fst.prodMk measurable_snd).comap_le⟩

/-- Actual Shannon conditional entropy H(Y|S), preserving infinite values. -/
noncomputable def generalConditionalEntropy {X Y S : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace S]
    (ν : ProbabilityMeasure ((X × Y) × S)) : ℝ≥0∞ :=
  conditionalShannonEntropy ν auxiliaryConditioning (fun z => z.1.2) measurable_fst.snd

/-- Actual Shannon conditional entropy H(Y|X,S), preserving infinite values. -/
noncomputable def generalRecoveryEntropy {X Y S : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace S]
    (ν : ProbabilityMeasure ((X × Y) × S)) : ℝ≥0∞ :=
  conditionalShannonEntropy ν inputAuxiliaryConditioning (fun z => z.1.2) measurable_fst.snd

/-- A measurable functional representation preserving the given joint law. -/
def IsGeneralRepresentation {X Y S : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace S]
    (μ : ProbabilityMeasure (X × Y)) (ν : ProbabilityMeasure ((X × Y) × S)) : Prop :=
  ν.map Prod.fst = μ ∧
    measureMutualInformation (ν.map (fun z => (z.1.1, z.2))) = 0 ∧
    generalRecoveryEntropy ν = 0 ∧
    ∃ g : X × S → Y, Measurable g ∧
      ∀ᵐ z ∂ν.toMeasure, g (z.1.1, z.2) = z.1.2

/-- A representation has the exact specified input/output marginal. -/
theorem IsGeneralRepresentation.marginal_eq {X Y S : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace S]
    {μ : ProbabilityMeasure (X × Y)} {ν : ProbabilityMeasure ((X × Y) × S)}
    (h : IsGeneralRepresentation μ ν) : ν.map Prod.fst = μ := h.1

/-- A representation includes an actual measurable almost-everywhere recovery map. -/
theorem IsGeneralRepresentation.exists_recovery {X Y S : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace S]
    {μ : ProbabilityMeasure (X × Y)} {ν : ProbabilityMeasure ((X × Y) × S)}
    (h : IsGeneralRepresentation μ ν) :
    ∃ g : X × S → Y, Measurable g ∧ ∀ᵐ z ∂ν.toMeasure, g (z.1.1, z.2) = z.1.2 := h.2.2.2

end InformationTheory
