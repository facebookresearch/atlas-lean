module

public import
  MathlibExt.RepresentationTheory.Homological.GroupCohomology.CyclicEvenResolutionQuotientFormula

/-!
# The explicit degree-two cyclic cohomology isomorphism

Let k be a commutative ring, G a finite abelian group generated by g, and A a k-linear
G-representation in universe u. Put N_G=Σ_{h∈G}ρ(h). The degree-two cyclic comparison identifies
H²(G,A) with ker(ρ(g)-id)/im(N_G), and sends the class of a two-cocycle z to the quotient class
of Σ_{h∈G}z(h,g).

The comparison of the periodic and bar projective resolutions sends the degree-zero basis to [],
the degree-one basis to [g], and the degree-two basis to Σ_h[h|g]. Its extension in higher
degrees gives a homotopy equivalence of resolutions. Applying the contravariant coefficient Hom
functor identifies its cohomology map with the explicit cyclic comparison.

For any g in a finite abelian G, equality of two quotient classes represented by g-fixed vectors
x,y is equivalent to x-y lying in the image of N_G.
-/

@[expose] public section

open CategoryTheory Finsupp MonoidalCategory
open scoped MonoidAlgebra

noncomputable section
set_option autoImplicit false

namespace groupCohomology

universe u
variable {k G : Type u} [CommRing k] [CommGroup G] [Fintype G]

noncomputable abbrev cyclicComplex (g : G) :=
  (Rep.FiniteCyclicGroup.chainComplexFunctor k g).obj
    (Rep.leftRegular k G)

def cyclicBasis (g : G) (n : ℕ) : (cyclicComplex (k := k) g).X n :=
  MonoidAlgebra.single 1 1

def cyclicBarBasis (n : ℕ) (x : Fin n → G) :
    (Rep.barComplex k G).X n :=
  Finsupp.single x (MonoidAlgebra.single 1 1)

def cyclicToBarZeroRaw :
    Rep.leftRegular k G ⟶ (Rep.barComplex k G).X 0 :=
  Rep.leftRegularHom _ (cyclicBarBasis (k := k) (G := G) 0 Fin.elim0)

def cyclicToBarZero (g : G) :
    (cyclicComplex (k := k) g).X 0 ⟶ (Rep.barComplex k G).X 0 :=
  cyclicToBarZeroRaw (k := k) (G := G)

def cyclicToBarOneRaw (g : G) :
    Rep.leftRegular k G ⟶ (Rep.barComplex k G).X 1 :=
  Rep.leftRegularHom _ (cyclicBarBasis (k := k) (G := G) 1 (fun _ => g))

def cyclicToBarOne (g : G) :
    (cyclicComplex (k := k) g).X 1 ⟶ (Rep.barComplex k G).X 1 :=
  cyclicToBarOneRaw (k := k) g

def cyclicBarPairTuple (h g : G) : Fin 2 → G
  | 0 => h
  | 1 => g

omit [CommGroup G] [Fintype G] in
lemma cyclicBarPairTuple_tail (h g : G) :
    (fun i => cyclicBarPairTuple h g i.succ) = (fun _ : Fin 1 => g) := by
  funext i
  fin_cases i
  rfl

omit [Fintype G] in
lemma cyclicBarPairTuple_contract_zero (h g : G) :
    Fin.contractNth 0 (fun x₁ x₂ : G => x₁ * x₂) (cyclicBarPairTuple h g) =
      (fun _ : Fin 1 => h * g) := by
  funext i
  fin_cases i
  rfl

omit [Fintype G] in
lemma cyclicBarPairTuple_contract_one (h g : G) :
    Fin.contractNth 1 (fun x₁ x₂ : G => x₁ * x₂) (cyclicBarPairTuple h g) =
      (fun _ : Fin 1 => h) := by
  funext i
  fin_cases i
  rfl

def cyclicToBarTwoRaw (g : G) :
    Rep.leftRegular k G ⟶ (Rep.barComplex k G).X 2 :=
  Rep.leftRegularHom _ (∑ h : G, cyclicBarBasis (k := k) 2 (cyclicBarPairTuple h g))

def cyclicToBarTwo (g : G) :
    (cyclicComplex (k := k) g).X 2 ⟶ (Rep.barComplex k G).X 2 :=
  cyclicToBarTwoRaw (k := k) g

set_option backward.isDefEq.respectTransparency false in
theorem cyclicToBarOne_comm (g : G) :
    cyclicToBarOne (k := k) g ≫ (Rep.barComplex k G).d 1 0 =
      ((Rep.FiniteCyclicGroup.chainComplexFunctor k g).obj
        (Rep.leftRegular k G)).d 1 0 ≫ cyclicToBarZero (k := k) g := by
  have hone :
      (cyclicToBarOne (k := k) g).hom (cyclicBasis (k := k) g 1) =
        cyclicBarBasis (k := k) 1 (fun _ => g) := by
    change (cyclicToBarOneRaw (k := k) g).hom
      (MonoidAlgebra.single 1 1) = _
    simp [cyclicToBarOneRaw]
  have hsource :
      ((cyclicComplex (k := k) g).d 1 0).hom
          (cyclicBasis (k := k) g 1) =
        MonoidAlgebra.single g 1 - MonoidAlgebra.single 1 1 := by
    change (Rep.applyAsHom (Rep.leftRegular k G) g - 𝟙 _).hom
        (MonoidAlgebra.single 1 1) = _
    simp [Rep.sub_hom, Rep.applyAsHom, Representation.ofMulAction_single]
  have hzero :
      (cyclicToBarZero (k := k) g).hom
          (((cyclicComplex (k := k) g).d 1 0).hom
            (cyclicBasis (k := k) g 1)) =
        Finsupp.single Fin.elim0 (MonoidAlgebra.single g 1) -
          Finsupp.single Fin.elim0 (MonoidAlgebra.single 1 1) := by
    rw [hsource]
    change (cyclicToBarZeroRaw (k := k) (G := G)).hom
      (MonoidAlgebra.single g 1 - MonoidAlgebra.single 1 1) = _
    simp only [map_sub]
    simp [cyclicToBarZeroRaw, cyclicBarBasis]
  apply (Rep.leftRegularHomEquiv _).injective
  dsimp [Rep.leftRegularHomEquiv, Rep.homEquiv,
    Representation.leftRegularMapEquiv]
  simp only [MonoidAlgebra.coeffLinearEquiv_symm_apply]
  change ((Rep.barComplex k G).d 1 0).hom
      ((cyclicToBarOne (k := k) g).hom (cyclicBasis (k := k) g 1)) =
    (cyclicToBarZero (k := k) g).hom
      (((cyclicComplex (k := k) g).d 1 0).hom
        (cyclicBasis (k := k) g 1))
  rw [hone, hzero]
  change (Rep.barComplex.d k G 0).hom
    (cyclicBarBasis (k := k) 1 (fun _ => g)) = _
  simp only [cyclicBarBasis]
  rw [Rep.barComplex.d_single]
  have h₀ : (fun _ : Fin 0 => g) = Fin.elim0 := Subsingleton.elim _ _
  have h₁ : Fin.contractNth 0 (fun x₁ x₂ : G => x₁ * x₂)
      (fun _ : Fin 1 => g) = Fin.elim0 := Subsingleton.elim _ _
  rw [h₀, Fin.sum_univ_one, h₁]
  simp [sub_eq_add_neg]

set_option backward.isDefEq.respectTransparency false in
theorem cyclicToBarTwo_comm (g : G) :
    cyclicToBarTwo (k := k) g ≫ (Rep.barComplex k G).d 2 1 =
      ((cyclicComplex (k := k) g).d 2 1) ≫ cyclicToBarOne (k := k) g := by
  have htwo :
      (cyclicToBarTwo (k := k) g).hom (cyclicBasis (k := k) g 2) =
        ∑ h : G, cyclicBarBasis (k := k) 2 (cyclicBarPairTuple h g) := by
    change (cyclicToBarTwoRaw (k := k) g).hom
      (MonoidAlgebra.single 1 1) = _
    simp [cyclicToBarTwoRaw]
  have hsource :
      ((cyclicComplex (k := k) g).d 2 1).hom
          (cyclicBasis (k := k) g 2) =
        ∑ h : G, MonoidAlgebra.single h 1 := by
    change (Rep.leftRegular k G).norm.asHom.hom (MonoidAlgebra.single 1 1) = _
    simp [Rep.norm, Representation.norm,
      Representation.ofMulAction_single]
  have hone :
      (cyclicToBarOne (k := k) g).hom
          (((cyclicComplex (k := k) g).d 2 1).hom
            (cyclicBasis (k := k) g 2)) =
        ∑ h : G,
          Finsupp.single (fun _ : Fin 1 => g) (MonoidAlgebra.single h 1) := by
    rw [hsource, map_sum]
    apply Finset.sum_congr rfl
    intro h _
    change (cyclicToBarOneRaw (k := k) g).hom
      (MonoidAlgebra.single h 1) = _
    simp [cyclicToBarOneRaw, cyclicBarBasis, Representation.ofMulAction_single]
  apply (Rep.leftRegularHomEquiv _).injective
  dsimp [Rep.leftRegularHomEquiv, Rep.homEquiv,
    Representation.leftRegularMapEquiv]
  simp only [MonoidAlgebra.coeffLinearEquiv_symm_apply]
  change ((Rep.barComplex k G).d 2 1).hom
      ((cyclicToBarTwo (k := k) g).hom (cyclicBasis (k := k) g 2)) =
    (cyclicToBarOne (k := k) g).hom
      (((cyclicComplex (k := k) g).d 2 1).hom
        (cyclicBasis (k := k) g 2))
  rw [htwo, hone, map_sum]
  change (∑ h : G, (Rep.barComplex.d k G 1).hom
    (cyclicBarBasis (k := k) 2 (cyclicBarPairTuple h g))) = _
  simp only [cyclicBarBasis]
  simp_rw [Rep.barComplex.d_single (k := k) (G := G) 1]
  simp_rw [Fin.sum_univ_succ]
  simp_rw [cyclicBarPairTuple_tail]
  simp_rw [cyclicBarPairTuple_contract_zero]
  simp only [Fin.succ_zero_eq_one]
  simp_rw [cyclicBarPairTuple_contract_one]
  simp only [Fin.isValue, Nat.reduceAdd, Fin.coe_ofNat_eq_mod,
    Nat.zero_mod, zero_add, pow_one, MonoidAlgebra.single_neg,
    Finsupp.single_neg, Nat.mod_succ, even_two, Even.neg_pow,
    one_pow, Finset.univ_eq_empty, Fin.val_succ, Fin.val_eq_zero,
    Finset.sum_empty, add_zero]
  have hreindex :
      ((∑ h : G, Finsupp.single (fun _ : Fin 1 => h * g)
        (MonoidAlgebra.single (1 : G) (1 : k))) :
          (Rep.barComplex k G).X 1) =
      ((∑ h : G, Finsupp.single (fun _ : Fin 1 => h)
        (MonoidAlgebra.single (1 : G) (1 : k))) :
          (Rep.barComplex k G).X 1) := by
    simpa using Fintype.sum_bijective (· * g)
      (Group.mulRight_bijective g)
      (fun h => Finsupp.single (fun _ : Fin 1 => h * g)
        (MonoidAlgebra.single (1 : G) (1 : k)))
      (fun h => Finsupp.single (fun _ : Fin 1 => h)
        (MonoidAlgebra.single (1 : G) (1 : k)))
      (fun _ => rfl)
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib,
    Finset.sum_neg_distrib]
  let A₀ : (Rep.barComplex k G).X 1 :=
    ∑ h : G, Finsupp.single (fun _ : Fin 1 => g)
    (MonoidAlgebra.single h (1 : k))
  let B₀ : (Rep.barComplex k G).X 1 :=
    ∑ h : G, Finsupp.single (fun _ : Fin 1 => h * g)
    (MonoidAlgebra.single (1 : G) (1 : k))
  let C₀ : (Rep.barComplex k G).X 1 :=
    ∑ h : G, Finsupp.single (fun _ : Fin 1 => h)
    (MonoidAlgebra.single (1 : G) (1 : k))
  change A₀ + (-B₀ + C₀) = A₀
  have hBC : B₀ = C₀ := by simpa [B₀, C₀] using hreindex
  rw [hBC]
  abel

noncomputable def cyclicToBarAux (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    ∀ n : ℕ,
      Σ' f : (cyclicComplex (k := k) g).X (n + 1) ⟶
          (Rep.barComplex k G).X (n + 1),
        Σ' f' : (cyclicComplex (k := k) g).X (n + 2) ⟶
            (Rep.barComplex k G).X (n + 2),
          f' ≫ (Rep.barComplex k G).d (n + 2) (n + 1) =
            (cyclicComplex (k := k) g).d (n + 2) (n + 1) ≫ f
  | 0 => ⟨cyclicToBarOne (k := k) g,
      cyclicToBarTwo (k := k) g, cyclicToBarTwo_comm g⟩
  | n + 1 =>
      let prev := cyclicToBarAux g hg n
      let next := ProjectiveResolution.liftFSucc
        (Rep.FiniteCyclicGroup.resolution k g hg)
        (Rep.barResolution k G) (n + 1) prev.1 prev.2.1 prev.2.2
      ⟨prev.2.1, next.1, next.2⟩

noncomputable def cyclicToBarChainMap (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (Rep.FiniteCyclicGroup.resolution k g hg).complex ⟶
      (Rep.barResolution k G).complex where
  f
    | 0 => cyclicToBarZero (k := k) g
    | n + 1 => (cyclicToBarAux (k := k) g hg n).1
  comm' i j hij := by
    rcases hij with ⟨rfl⟩
    cases j with
    | zero => exact cyclicToBarOne_comm g
    | succ n => exact (cyclicToBarAux (k := k) g hg n).2.2

@[simp]
theorem cyclicToBarChainMap_f_zero (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicToBarChainMap (k := k) g hg).f 0 = cyclicToBarZero (k := k) g := rfl

@[simp]
theorem cyclicToBarChainMap_f_one (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicToBarChainMap (k := k) g hg).f 1 = cyclicToBarOne (k := k) g := rfl

@[simp]
theorem cyclicToBarChainMap_f_two (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicToBarChainMap (k := k) g hg).f 2 = cyclicToBarTwo (k := k) g := rfl

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
omit [Fintype G] in
theorem cyclicBarIsoStandard_f_zero_basis :
    ((Rep.barComplex.isoStandardComplex k G).hom.f 0).hom
        (cyclicBarBasis (k := k) (G := G) 0 Fin.elim0) =
      MonoidAlgebra.single (fun _ : Fin 1 => (1 : G)) 1 := by
  change (Rep.diagonalSuccIsoFree k G 0).inv.hom
      (Finsupp.single Fin.elim0 (MonoidAlgebra.single 1 1)) = _
  simp only [Rep.diagonalSuccIsoFree,
    Rep.diagonalSuccIsoTensorTrivial, Iso.trans_inv, Rep.hom_comp,
    Representation.IntertwiningMap.comp_apply]
  have step₁ :
      (Rep.Hom.hom
        (Rep.leftRegularTensorTrivialIsoFree k G (Fin 0 → G)).inv)
          (Finsupp.single Fin.elim0 (MonoidAlgebra.single (1 : G) (1 : k))) =
        (show ↑(Rep.leftRegular k G ⊗
            Rep.trivial k G k[Fin 0 → G]) from
          MonoidAlgebra.single (1 : G) (1 : k) ⊗ₜ[k]
            MonoidAlgebra.single Fin.elim0 (1 : k)) :=
    Representation.leftRegularTensorTrivialIsoFree_symm_apply_single_single
      Fin.elim0 (1 : G) (1 : k)
  rw [step₁]
  simp only [Rep.mkIso_inv, Representation.linearizeOfMulActionIso,
    Representation.Equiv.mk_symm, LinearEquiv.refl_symm,
    ConcreteCategory.hom_ofHom, Action.tensorObj_V, Action.trivial_V,
    Functor.mapIso_inv, Rep.tensor_V, Rep.tensor_ρ, Iso.symm_inv,
    Functor.Monoidal.μIso_hom, Rep.μ_hom,
    MonoidalCategory.tensorIso_inv, Representation.linearizeTrivialIso,
    Rep.hom_tensorHom, Representation.IntertwiningMap.tensor_apply,
    Representation.Equiv.coe_toIntertwiningMap,
    Representation.Equiv.mk_apply, LinearEquiv.refl_apply]
  have key₁ := Representation.linearizeMap_single (k := k)
    (Action.diagonalSuccIsoTensorTrivial G 0).inv
      ((1 : G), Fin.elim0) ((1 : k) * 1)
  have key₂ := Representation.LinearizeMonoidal.μ_apply_single_single (k := k)
    (X := Action.leftRegular G) (Y := Action.trivial G (Fin 0 → G))
      (1 : G) Fin.elim0 1 1
  exact ((congrArg (fun z => (Representation.linearizeMap
    (Action.diagonalSuccIsoTensorTrivial G 0).inv) z) key₂).trans key₁).trans (by
      congr 1
      simp)

set_option backward.isDefEq.respectTransparency false in
omit [Fintype G] in
theorem cyclicBarResolution_π_f_zero_basis :
    ((Rep.barResolution k G).π.f 0).hom
        (cyclicBarBasis (k := k) (G := G) 0 Fin.elim0) = (1 : k) := by
  change (Rep.standardComplex.ε k G).hom
    (((Rep.barComplex.isoStandardComplex k G).hom.f 0).hom
      (cyclicBarBasis (k := k) (G := G) 0 Fin.elim0)) = 1
  rw [cyclicBarIsoStandard_f_zero_basis]
  simp [Rep.standardComplex.ε]

set_option backward.isDefEq.respectTransparency false in
theorem cyclicToBarChainMap_f_zero_comp_π
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicToBarChainMap (k := k) g hg).f 0 ≫
        (Rep.barResolution k G).π.f 0 =
      (Rep.FiniteCyclicGroup.resolution k g hg).π.f 0 := by
  have hzero :
      (cyclicToBarZero (k := k) g).hom
          (cyclicBasis (k := k) g 0) =
        cyclicBarBasis (k := k) 0 Fin.elim0 := by
    change (cyclicToBarZeroRaw (k := k) (G := G)).hom
      (MonoidAlgebra.single 1 1) = _
    simp [cyclicToBarZeroRaw]
  have hzero' :
      (((cyclicToBarChainMap (k := k) g hg).f 0).hom
        (cyclicBasis (k := k) g 0)) =
          cyclicBarBasis (k := k) 0 Fin.elim0 := by
    change (cyclicToBarZero (k := k) g).hom
      (cyclicBasis (k := k) g 0) = _
    exact hzero
  have hcoeff :
      ((MonoidAlgebra.coeffLinearEquiv k)
        (MonoidAlgebra.single (1 : G) (1 : k))).sum
          (fun _ r => r) = 1 := by
    rw [MonoidAlgebra.coeffLinearEquiv_apply,
      MonoidAlgebra.coeff_single]
    simp
  apply (Rep.leftRegularHomEquiv _).injective
  dsimp [Rep.leftRegularHomEquiv, Rep.homEquiv,
    Representation.leftRegularMapEquiv]
  simp only [MonoidAlgebra.coeffLinearEquiv_symm_apply]
  change ((Rep.barResolution k G).π.f 0).hom
      (((cyclicToBarChainMap (k := k) g hg).f 0).hom
        (cyclicBasis (k := k) g 0)) =
    ((Rep.FiniteCyclicGroup.resolution k g hg).π.f 0).hom
      (cyclicBasis (k := k) g 0)
  rw [hzero', cyclicBarResolution_π_f_zero_basis]
  simp only [ChainComplex.single₀_obj_zero,
    Rep.FiniteCyclicGroup.resolution_π,
    Rep.FiniteCyclicGroup.resolution.π_f, ↓reduceDIte,
    HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Rep.hom_comp,
    ConcreteCategory.hom_ofHom, Representation.trivial_apply,
    Representation.IntertwiningMap.comp_apply,
    Representation.IntertwiningMap.coe_mk, LinearMap.coe_comp,
    LinearEquiv.coe_coe, Function.comp_apply,
    MonoidAlgebra.coeffLinearEquiv_apply, Finsupp.lift_apply,
    smul_eq_mul, mul_one]
  exact hcoeff.symm

set_option backward.isDefEq.respectTransparency false in
theorem cyclicToBarChainMap_comp_π
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    cyclicToBarChainMap (k := k) g hg ≫ (Rep.barResolution k G).π =
      (Rep.FiniteCyclicGroup.resolution k g hg).π := by
  apply HomologicalComplex.Hom.ext
  funext n
  cases n with
  | zero => exact cyclicToBarChainMap_f_zero_comp_π g hg
  | succ n => simp

noncomputable def cyclicToBarChainMapHomotopy
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Homotopy (cyclicToBarChainMap (k := k) g hg)
      (ProjectiveResolution.lift (𝟙 (Rep.trivial k G k))
        (Rep.FiniteCyclicGroup.resolution k g hg)
        (Rep.barResolution k G)) :=
  ProjectiveResolution.liftHomotopy (𝟙 (Rep.trivial k G k))
    (cyclicToBarChainMap (k := k) g hg)
    (ProjectiveResolution.lift (𝟙 (Rep.trivial k G k))
      (Rep.FiniteCyclicGroup.resolution k g hg)
      (Rep.barResolution k G))
    (by
      have hid :
          (ChainComplex.single₀ (Rep k G)).map
              (𝟙 (Rep.trivial k G k)) =
            𝟙 ((ChainComplex.single₀ (Rep k G)).obj
              (Rep.trivial k G k)) :=
        (ChainComplex.single₀ (Rep k G)).map_id _
      rw [hid, Category.comp_id]
      exact cyclicToBarChainMap_comp_π (k := k) g hg)
    (by simp)

noncomputable def linearYonedaObjMap
    (A : Rep k G) {P Q : ChainComplex (Rep k G) ℕ}
    (f : P ⟶ Q) :
    Q.linearYonedaObj k A ⟶ P.linearYonedaObj k A :=
  (HomologicalComplex.unopFunctor (ModuleCat k) (ComplexShape.down ℕ)).map
    (Quiver.Hom.op
      ((((linearYoneda k (Rep k G)).obj A).rightOp.mapHomologicalComplex
        (ComplexShape.down ℕ)).map f))

set_option backward.isDefEq.respectTransparency false in
omit [Fintype G] in
theorem linearYonedaObjMap_f_apply
    (A : Rep k G) {P Q : ChainComplex (Rep k G) ℕ}
    (f : P ⟶ Q) (n : ℕ) (z : Q.X n ⟶ A) :
    (linearYonedaObjMap A f).f n z = f.f n ≫ z := by
  rfl

noncomputable def cyclicToBarChainHomotopyEquiv
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    HomotopyEquiv
      (Rep.FiniteCyclicGroup.resolution k g hg).complex
      (Rep.barResolution k G).complex :=
  (ProjectiveResolution.homotopyEquiv
    (Rep.FiniteCyclicGroup.resolution k g hg)
    (Rep.barResolution k G)).copy
      (cyclicToBarChainMapHomotopy (k := k) g hg).symm

noncomputable def cyclicHomotopyEquivUnop
    {K L : ChainComplex (ModuleCat k)ᵒᵖ ℕ}
    (e : HomotopyEquiv K L) : HomotopyEquiv L.unop K.unop where
  hom := (HomologicalComplex.unopFunctor (ModuleCat k)
    (ComplexShape.down ℕ)).map e.hom.op
  inv := (HomologicalComplex.unopFunctor (ModuleCat k)
    (ComplexShape.down ℕ)).map e.inv.op
  homotopyHomInvId := by
    simpa [HomologicalComplex.unopFunctor] using
      Homotopy.unop e.homotopyInvHomId
  homotopyInvHomId := by
    simpa [HomologicalComplex.unopFunctor] using
      Homotopy.unop e.homotopyHomInvId

noncomputable def cyclicBarLinearYonedaHomotopyEquiv
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    HomotopyEquiv
      (((Rep.barResolution k G).complex).linearYonedaObj k A)
      (((Rep.FiniteCyclicGroup.resolution k g hg).complex).linearYonedaObj k A) :=
  cyclicHomotopyEquivUnop <|
    ((linearYoneda k (Rep k G)).obj A).rightOp.mapHomotopyEquiv
      (cyclicToBarChainHomotopyEquiv (k := k) g hg)

@[simp]
theorem cyclicBarLinearYonedaHomotopyEquiv_hom
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicBarLinearYonedaHomotopyEquiv A g hg).hom =
      linearYonedaObjMap A (cyclicToBarChainMap (k := k) g hg) := rfl

noncomputable def cyclicBarCochainComparison
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    inhomogeneousCochains A ⟶
      Rep.FiniteCyclicGroup.moduleCatCochainComplex A g :=
  (inhomogeneousCochainsIso A).hom ≫
    linearYonedaObjMap A (cyclicToBarChainMap (k := k) g hg) ≫
      (Rep.FiniteCyclicGroup.homResolutionIso A g hg).hom

set_option backward.isDefEq.respectTransparency false in
theorem cyclicBarCochainComparison_f_two
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cochainsIso₂ A).inv ≫ (cyclicBarCochainComparison A g hg).f 2 =
      cyclicSumTwo A g := by
  ext z
  simp only [cyclicBarCochainComparison, HomologicalComplex.comp_f,
    ModuleCat.hom_comp, LinearMap.comp_apply]
  change (Rep.leftRegularHomEquiv A)
      (((cyclicToBarChainMap (k := k) g hg).f 2) ≫
        ((Rep.freeLiftLEquiv k G (Fin 2 → G) A).symm
          ((cochainsIso₂ A).inv z))) = _
  rw [cyclicToBarChainMap_f_two]
  change ((cyclicToBarTwoRaw (k := k) g ≫
    ((Rep.freeLiftLEquiv k G (Fin 2 → G) A).symm
      ((cochainsIso₂ A).inv z))) |>
        Rep.leftRegularHomEquiv A) = _
  simp [cyclicToBarTwoRaw, cyclicBarBasis, cyclicBarPairTuple, cochainsIso₂,
    Rep.homEquiv, Rep.freeLiftLEquiv]
  rfl

set_option backward.isDefEq.respectTransparency false in
theorem cyclicBarCochainComparison_f_one
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cochainsIso₁ A).inv ≫ (cyclicBarCochainComparison A g hg).f 1 =
      cyclicEvalOne A g := by
  ext z
  simp only [cyclicBarCochainComparison, HomologicalComplex.comp_f,
    ModuleCat.hom_comp, LinearMap.comp_apply]
  change (Rep.leftRegularHomEquiv A)
      (((cyclicToBarChainMap (k := k) g hg).f 1) ≫
        ((Rep.freeLiftLEquiv k G (Fin 1 → G) A).symm
          ((cochainsIso₁ A).inv z))) = _
  rw [cyclicToBarChainMap_f_one]
  change ((cyclicToBarOneRaw (k := k) g ≫
    ((Rep.freeLiftLEquiv k G (Fin 1 → G) A).symm
      ((cochainsIso₁ A).inv z))) |>
        Rep.leftRegularHomEquiv A) = _
  simp [cyclicToBarOneRaw, cyclicBarBasis, cochainsIso₁,
    Rep.homEquiv, Rep.freeLiftLEquiv]
  rfl

noncomputable def cyclicBarCochainComparisonHomotopyEquiv
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    HomotopyEquiv (inhomogeneousCochains A)
      (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g) :=
  (HomotopyEquiv.ofIso (inhomogeneousCochainsIso A)).trans <|
    (cyclicBarLinearYonedaHomotopyEquiv A g hg).trans <|
      HomotopyEquiv.ofIso
        (Rep.FiniteCyclicGroup.homResolutionIso A g hg)

@[simp]
theorem cyclicBarCochainComparisonHomotopyEquiv_hom
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicBarCochainComparisonHomotopyEquiv A g hg).hom =
      cyclicBarCochainComparison A g hg := rfl

noncomputable def cyclicBarCochainComparisonH2Iso
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    H2 A ≅
      (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).homology 2 :=
  (cyclicBarCochainComparisonHomotopyEquiv A g hg).toHomologyIso 2

@[simp]
theorem cyclicBarCochainComparisonH2Iso_hom
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicBarCochainComparisonH2Iso A g hg).hom =
      HomologicalComplex.homologyMap
        (cyclicBarCochainComparison A g hg) 2 := rfl

noncomputable def cyclicEvenPeriodicH2Iso
    (A : Rep k G) (g : G) :
    (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).homology 2 ≅
      (Rep.FiniteCyclicGroup.normHomCompSub A g).homology :=
  HomologicalComplex.alternatingConstHomologyIsoEven
    (ModuleCat.of k A.V)
    (by ext; simp [Rep.sub_hom])
    (by ext; simp [Rep.sub_hom])
    (by simp) (by simp) (by simp) (by simp)

noncomputable def cyclicExplicitH2Iso
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    H2 A ≅ (Rep.FiniteCyclicGroup.normHomCompSub A g).homology :=
  cyclicBarCochainComparisonH2Iso A g hg ≪≫
    cyclicEvenPeriodicH2Iso A g

set_option backward.isDefEq.respectTransparency false in
theorem cyclicEvenComparisonMap_comp_moduleCatHomologyIso
    (A : Rep k G) (g : G) :
    cyclicEvenComparisonMap A g ≫
        (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom =
      cyclicEvenComparisonQuotientMap A g := by
  unfold cyclicEvenComparisonMap cyclicEvenComparisonQuotientMap
  simp only [Category.assoc]
  rw [cancel_epi]
  let γ := ShortComplex.leftHomologyMapData
    (cyclicEvenComparisonHom A g)
    (shortComplexH2 A).moduleCatLeftHomologyData
    (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData
  change
    (shortComplexH2 A).moduleCatLeftHomologyData.homologyIso.inv ≫
        ShortComplex.homologyMap (cyclicEvenComparisonHom A g) ≫
          (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.homologyIso.hom =
      ShortComplex.leftHomologyMap' (cyclicEvenComparisonHom A g)
        (shortComplexH2 A).moduleCatLeftHomologyData
        (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData
  rw [γ.homologyMap_comm]
  simpa only [Iso.inv_hom_id_assoc] using γ.leftHomologyMap'_eq.symm

set_option backward.isDefEq.respectTransparency false in
theorem cyclicExplicitH2Iso_hom_H2π
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) (z : cocycles₂ A) :
    (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom
        ((cyclicExplicitH2Iso A g hg).hom (H2π A z)) =
      (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.π
        (cyclicTwoCocycleInvariant A g z) := by
  unfold cyclicExplicitH2Iso cyclicBarCochainComparisonH2Iso
    cyclicEvenPeriodicH2Iso H2π
  simp only [Iso.trans_hom, HomotopyEquiv.toHomologyIso,
    cyclicBarCochainComparisonHomotopyEquiv_hom,
    ModuleCat.hom_comp, LinearMap.comp_apply]
  let e : (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).sc 2 ≅
      Rep.FiniteCyclicGroup.normHomCompSub A g :=
    HomologicalComplex.alternatingConstScIsoEven
    (ModuleCat.of k A.V)
    (by ext; simp [Rep.sub_hom])
    (by ext; simp [Rep.sub_hom])
    (by simp) (by simp) (by simp) (by simp)
  let y := (isoCocycles₂ A).inv z
  let u := HomologicalComplex.cyclesMap
    (cyclicBarCochainComparison A g hg) 2 y
  let v := ShortComplex.cyclesMap e.hom u
  have h₁ := ConcreteCategory.congr_hom
    (HomologicalComplex.homologyπ_naturality
      (cyclicBarCochainComparison A g hg) 2) y
  have h₂ := ConcreteCategory.congr_hom
    (ShortComplex.homologyπ_naturality e.hom) u
  have h₃ := ShortComplex.π_moduleCatCyclesIso_hom_apply
    (Rep.FiniteCyclicGroup.normHomCompSub A g) v
  change (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom
      ((ShortComplex.homologyMap e.hom)
        (HomologicalComplex.homologyMap
          (cyclicBarCochainComparison A g hg) 2
          ((inhomogeneousCochains A).homologyπ 2 y))) = _
  have hw :
      (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatCyclesIso.hom v =
        cyclicTwoCocycleInvariant A g z := by
    apply Subtype.ext
    change ((Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.i).hom
        ((Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatCyclesIso.hom v) =
      (cyclicTwoCocycleInvariant A g z : A)
    have hm := (ConcreteCategory.congr_hom
      (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatCyclesIso_hom_i) v
    have he := (ConcreteCategory.congr_hom
      (ShortComplex.cyclesMap_i e.hom)) u
    have hc := (ConcreteCategory.congr_hom
      (HomologicalComplex.cyclesMap_i
        (cyclicBarCochainComparison A g hg) 2)) y
    have hy := (ConcreteCategory.congr_hom
      (isoCocycles₂_inv_comp_iCocycles A)) z
    have hcomp := (ConcreteCategory.congr_hom
      (cyclicBarCochainComparison_f_two A g hg)) z
    calc
      _ = ((Rep.FiniteCyclicGroup.normHomCompSub A g).iCycles).hom v := by
        simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using hm
      _ = e.hom.τ₂.hom
          (((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).iCycles 2).hom u) := by
        change (ConcreteCategory.hom
            (ShortComplex.cyclesMap e.hom ≫
              (Rep.FiniteCyclicGroup.normHomCompSub A g).iCycles)) u =
          (ConcreteCategory.hom
            (((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).sc 2).iCycles ≫
              e.hom.τ₂)) u
        exact he
      _ = ((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).iCycles 2).hom u := by
        rfl
      _ = ((cyclicBarCochainComparison A g hg).f 2).hom
          ((inhomogeneousCochains A).iCycles 2 y) := by
        change (ConcreteCategory.hom
            (HomologicalComplex.cyclesMap
                (cyclicBarCochainComparison A g hg) 2 ≫
              (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).iCycles 2)) y =
          (ConcreteCategory.hom
            ((inhomogeneousCochains A).iCycles 2 ≫
              (cyclicBarCochainComparison A g hg).f 2)) y
        exact hc
      _ = ((cyclicBarCochainComparison A g hg).f 2).hom
          ((cochainsIso₂ A).inv z) := congrArg _ hy
      _ = (cyclicSumTwo A g).hom z := by
        change (ConcreteCategory.hom
            ((cochainsIso₂ A).inv ≫
              (cyclicBarCochainComparison A g hg).f 2)) z =
          (ConcreteCategory.hom (cyclicSumTwo A g)) z
        exact hcomp
      _ = _ := rfl
  calc
    _ = (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom
        ((ShortComplex.homologyMap e.hom)
          ((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).homologyπ 2 u)) := by
      exact congrArg
        (fun q => (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom
          ((ShortComplex.homologyMap e.hom) q)) h₁
    _ = (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom
        ((Rep.FiniteCyclicGroup.normHomCompSub A g).homologyπ v) := by
      exact congrArg
        (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom h₂
    _ = (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.π
        ((Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatCyclesIso.hom v) := h₃
    _ = _ := congrArg
      (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.π hw

set_option backward.isDefEq.respectTransparency false in
theorem cyclicExplicitH2Iso_hom_eq_cyclicEvenComparisonMap
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicExplicitH2Iso A g hg).hom = cyclicEvenComparisonMap A g := by
  rw [← cancel_mono
    (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom]
  rw [cyclicEvenComparisonMap_comp_moduleCatHomologyIso]
  rw [← cancel_epi (H2π A)]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro z
  change (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatHomologyIso.hom
      ((cyclicExplicitH2Iso A g hg).hom (H2π A z)) =
    cyclicEvenComparisonQuotientMap A g (H2π A z)
  exact (cyclicExplicitH2Iso_hom_H2π A g hg z).trans
    (cyclicEvenComparisonQuotientMap_H2π A g z).symm

/-- Let k be a commutative ring, G a finite abelian group, and A a k-linear G-representation, in the
given universe u. If g generates G, meaning every h∈G belongs to the subgroup of powers of g,
the comparison H²(G,A)→H(N_G:A→A,ρ(g)-id:A→A) is bijective. Through the canonical quotient
identification, it sends [z] to [Σ_{h∈G}z(h,g)] in ker(ρ(g)-id)/im(N_G). -/
theorem cyclicEvenComparisonMap_bijective
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Function.Bijective (cyclicEvenComparisonMap A g) := by
  rw [← cyclicExplicitH2Iso_hom_eq_cyclicEvenComparisonMap A g hg]
  exact (ConcreteCategory.isIso_iff_bijective _).mp inferInstance

/-- Let k be a commutative ring, G a finite abelian group, and A a k-linear G-representation, in the
given universe u. For any g∈G, let x,y∈ker(ρ(g)-id) and π be projection to ker(ρ(g)-id)/im(N_G),
where N_G=Σ_{h∈G}ρ(h). Then π(x)=π(y) if and only if x-y∈im(N_G), with the difference taken in
the coefficient module A. -/
theorem cyclicEvenQuotient_π_eq_iff_norm
    (A : Rep k G) (g : G)
    (x y : LinearMap.ker
      (Rep.applyAsHom A g - 𝟙 A).hom.toLinearMap) :
    (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.π x =
        (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.π y ↔
      (x : A) - (y : A) ∈ LinearMap.range A.norm.asHom.hom.toLinearMap := by
  change (Submodule.Quotient.mk x : _) = Submodule.Quotient.mk y ↔ _
  rw [Submodule.Quotient.eq]
  simp [ShortComplex.moduleCatToCycles, LinearMap.range_codRestrict]

end groupCohomology
