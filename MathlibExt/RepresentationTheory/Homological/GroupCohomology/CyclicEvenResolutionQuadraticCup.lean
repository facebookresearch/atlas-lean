module

public import MathlibExt.RepresentationTheory.Homological.GroupCohomology.CyclicEvenResolutionIso

/-!
# The degree-two invariant of a quadratic cyclic cup

Let k be a commutative ring, G a finite abelian group generated by an element g of order two,
and A,B k-linear representations in universe u. The group consists of 1 and g. For one-cocycles
x:G→A and y:G→B, the cup cocycle is z(h,t)=x(h)⊗h•y(t).

Its cyclic degree-two invariant Σ_{h∈G}z(h,g) equals x(g)⊗g•y(g). The summand at 1 is zero
because a one-cocycle vanishes at the group identity. The formula retains the coefficient action
on y(g) and imposes no characteristic condition on k.
-/

@[expose] public section

noncomputable section

set_option autoImplicit false

open CategoryTheory MonoidalCategory
open scoped BigOperators

namespace groupCohomology

universe u

variable {k G : Type u} [CommRing k] [CommGroup G] [Fintype G]

/-- Let G be a finite abelian group in universe u with decidable equality, and g∈G. If every element
lies in the subgroup of powers of g and order(g)=2, then the finite set of all group elements is
{1,g}. -/
theorem univ_eq_pair_of_generator_order_two
    [DecidableEq G]
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (horder : orderOf g = 2) :
    (Finset.univ : Finset G) = ({1, g} : Finset G) := by
  ext h
  simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, true_iff]
  have hh := (mem_zpowers_iff_mem_range_orderOf (x := g) (y := h)).mp (hg h)
  rw [horder] at hh
  rcases Finset.mem_image.mp hh with ⟨n, hn, rfl⟩
  simp only [Finset.mem_range] at hn
  interval_cases n <;> simp

/-- Let k be a commutative ring, G a finite abelian group generated by g with order(g)=2, and A,B
k-linear representations in universe u. For one-cocycles x∈Z¹(G,A), y∈Z¹(G,B), the invariant of
their cup cocycle is Σ_{h∈G}x(h)⊗h•y(g)=x(g)⊗g•y(g), as an element of A⊗_k B. -/
theorem cyclicTwoCocycleInvariant_cup_of_order_two
    (A B : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (horder : orderOf g = 2)
    (x : cocycles₁ A) (y : cocycles₁ B) :
    (cyclicTwoCocycleInvariant (A ⊗ B : Rep k G) g
      (cupCocycleOneOne A B x y) : (A ⊗ B : Rep k G)) =
      x g ⊗ₜ[k] B.ρ g (y g) := by
  let _ := Classical.decEq G
  rw [cyclicTwoCocycleInvariant_cup]
  rw [univ_eq_pair_of_generator_order_two g hg horder]
  simp [cocycles₁_map_one]

end groupCohomology
