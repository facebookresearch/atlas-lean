module

public import MathlibExt.RepresentationTheory.Homological.GroupCohomology.CyclicEvenResolutionIso
public import MathlibExt.RepresentationTheory.Homological.GroupCohomology.FiniteCyclicH3Invariant
public import MathlibExt.RepresentationTheory.Homological.GroupCohomology.LowDegreeThreeFunctoriality

/-!
# The explicit cyclic H3 comparison is an isomorphism

For a finite cyclic group generated by `g`, the explicit periodic-to-bar
chain map is seeded through degree three by

* `1 |-> []`,
* `1 |-> [g]`,
* `1 |-> sum_h [h | g]`, and
* `1 |-> sum_h [g | h | g]`.

The remaining components are lifted recursively by projectivity.  Mapping
the resulting homotopy equivalence through contravariant linear Yoneda shows
that its degree-three cochain component is the explicit cyclic sum
`z |-> sum_h z(g,h,g)`.  The induced odd-periodic H3 comparison is therefore
an isomorphism.

No Kummer-symbol generation, norm-residue, or Bloch--Kato claim is made.
-/

@[expose] public section

open CategoryTheory Finsupp MonoidalCategory
open scoped MonoidAlgebra

noncomputable section
set_option autoImplicit false

namespace groupCohomology

universe u
variable {k G : Type u} [CommRing k] [CommGroup G] [Fintype G]

def cyclicBarTripleTuple (g h : G) : Fin 3 → G
  | 0 => g
  | 1 => h
  | 2 => g

omit [CommGroup G] [Fintype G] in
lemma cyclicBarTripleTuple_tail (g h : G) :
    (fun i => cyclicBarTripleTuple g h i.succ) = cyclicBarPairTuple h g := by
  funext i
  fin_cases i <;> rfl

omit [Fintype G] in
lemma cyclicBarTripleTuple_contract_zero (g h : G) :
    Fin.contractNth 0 (fun x₁ x₂ : G => x₁ * x₂)
        (cyclicBarTripleTuple g h) =
      cyclicBarPairTuple (g * h) g := by
  funext i
  fin_cases i <;> rfl

omit [Fintype G] in
lemma cyclicBarTripleTuple_contract_one (g h : G) :
    Fin.contractNth 1 (fun x₁ x₂ : G => x₁ * x₂)
        (cyclicBarTripleTuple g h) =
      cyclicBarPairTuple g (h * g) := by
  funext i
  fin_cases i <;> rfl

omit [Fintype G] in
lemma cyclicBarTripleTuple_contract_two (g h : G) :
    Fin.contractNth 2 (fun x₁ x₂ : G => x₁ * x₂)
        (cyclicBarTripleTuple g h) =
      cyclicBarPairTuple g h := by
  funext i
  fin_cases i <;> rfl

def cyclicToBarThreeRaw (g : G) :
    Rep.leftRegular k G ⟶ (Rep.barComplex k G).X 3 :=
  Rep.leftRegularHom _
    (∑ h : G, cyclicBarBasis (k := k) 3 (cyclicBarTripleTuple g h))

def cyclicToBarThree (g : G) :
    (cyclicComplex (k := k) g).X 3 ⟶ (Rep.barComplex k G).X 3 :=
  cyclicToBarThreeRaw (k := k) g

set_option backward.isDefEq.respectTransparency false in
theorem cyclicToBarThree_comm (g : G) :
    cyclicToBarThree (k := k) g ≫ (Rep.barComplex k G).d 3 2 =
      (cyclicComplex (k := k) g).d 3 2 ≫ cyclicToBarTwo (k := k) g := by
  have hthree :
      (cyclicToBarThree (k := k) g).hom (cyclicBasis (k := k) g 3) =
        ∑ h : G, cyclicBarBasis (k := k) 3 (cyclicBarTripleTuple g h) := by
    change (cyclicToBarThreeRaw (k := k) g).hom
      (MonoidAlgebra.single 1 1) = _
    simp [cyclicToBarThreeRaw]
  have hsource :
      ((cyclicComplex (k := k) g).d 3 2).hom
          (cyclicBasis (k := k) g 3) =
        MonoidAlgebra.single g 1 - MonoidAlgebra.single 1 1 := by
    change (Rep.applyAsHom (Rep.leftRegular k G) g - 𝟙 _).hom
        (MonoidAlgebra.single 1 1) = _
    simp [Rep.sub_hom, Rep.applyAsHom, Representation.ofMulAction_single]
  have htwo :
      (cyclicToBarTwo (k := k) g).hom
          (((cyclicComplex (k := k) g).d 3 2).hom
            (cyclicBasis (k := k) g 3)) =
        (∑ h : G, Finsupp.single (cyclicBarPairTuple h g)
          (MonoidAlgebra.single g (1 : k))) -
        ∑ h : G, Finsupp.single (cyclicBarPairTuple h g)
          (MonoidAlgebra.single 1 (1 : k)) := by
    rw [hsource]
    change (cyclicToBarTwoRaw (k := k) g).hom
      (MonoidAlgebra.single g 1 - MonoidAlgebra.single 1 1) = _
    simp only [map_sub]
    simp [cyclicToBarTwoRaw, cyclicBarBasis,
      Representation.ofMulAction_single]
  apply (Rep.leftRegularHomEquiv _).injective
  dsimp [Rep.leftRegularHomEquiv, Rep.homEquiv,
    Representation.leftRegularMapEquiv]
  simp only [MonoidAlgebra.coeffLinearEquiv_symm_apply]
  change ((Rep.barComplex k G).d 3 2).hom
      ((cyclicToBarThree (k := k) g).hom (cyclicBasis (k := k) g 3)) =
    (cyclicToBarTwo (k := k) g).hom
      (((cyclicComplex (k := k) g).d 3 2).hom
        (cyclicBasis (k := k) g 3))
  rw [hthree, htwo, map_sum]
  change (∑ h : G, (Rep.barComplex.d k G 2).hom
    (cyclicBarBasis (k := k) 3 (cyclicBarTripleTuple g h))) = _
  simp only [cyclicBarBasis]
  simp_rw [Rep.barComplex.d_single (k := k) (G := G) 2]
  simp_rw [Fin.sum_univ_succ]
  simp_rw [cyclicBarTripleTuple_tail]
  simp_rw [cyclicBarTripleTuple_contract_zero]
  simp only [Fin.succ_zero_eq_one]
  simp_rw [cyclicBarTripleTuple_contract_one]
  simp only [Fin.succ_one_eq_two]
  simp_rw [cyclicBarTripleTuple_contract_two]
  simp only [Fin.isValue, Nat.reduceAdd, Fin.coe_ofNat_eq_mod,
    Nat.zero_mod, zero_add, pow_one, MonoidAlgebra.single_neg,
    Finsupp.single_neg,
    Finset.univ_eq_empty, Fin.val_succ, Fin.val_eq_zero,
    Finset.sum_empty, add_zero, Nat.mod_succ]
  simp only [cyclicBarTripleTuple]
  norm_num
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib,
    Finset.sum_neg_distrib]
  have hleft :
      (∑ h : G, cyclicBarBasis (k := k) 2
        (cyclicBarPairTuple (g * h) g)) =
        ∑ h : G, cyclicBarBasis (k := k) 2
          (cyclicBarPairTuple h g) := by
    simpa using Fintype.sum_bijective (g * ·)
      (Group.mulLeft_bijective g)
      (fun h => cyclicBarBasis (k := k) 2
        (cyclicBarPairTuple (g * h) g))
      (fun h => cyclicBarBasis (k := k) 2 (cyclicBarPairTuple h g))
      (fun _ => rfl)
  have hright :
      (∑ h : G, cyclicBarBasis (k := k) 2
        (cyclicBarPairTuple g (h * g))) =
        ∑ h : G, cyclicBarBasis (k := k) 2
          (cyclicBarPairTuple g h) := by
    simpa using Fintype.sum_bijective (· * g)
      (Group.mulRight_bijective g)
      (fun h => cyclicBarBasis (k := k) 2
        (cyclicBarPairTuple g (h * g)))
      (fun h => cyclicBarBasis (k := k) 2 (cyclicBarPairTuple g h))
      (fun _ => rfl)
  simp only [cyclicBarBasis] at hleft hright
  rw [Finset.sum_add_distrib, hleft, hright]
  rw [Finset.sum_neg_distrib]
  abel

/-- Recursive extension of the degree-three seed to a full chain map. -/
noncomputable def cyclicOddToBarAux (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    ∀ n : ℕ,
      Σ' f : (cyclicComplex (k := k) g).X (n + 2) ⟶
          (Rep.barComplex k G).X (n + 2),
        Σ' f' : (cyclicComplex (k := k) g).X (n + 3) ⟶
            (Rep.barComplex k G).X (n + 3),
          f' ≫ (Rep.barComplex k G).d (n + 3) (n + 2) =
            (cyclicComplex (k := k) g).d (n + 3) (n + 2) ≫ f
  | 0 => ⟨cyclicToBarTwo (k := k) g,
      cyclicToBarThree (k := k) g, cyclicToBarThree_comm g⟩
  | n + 1 =>
      let prev := cyclicOddToBarAux g hg n
      let next := ProjectiveResolution.liftFSucc
        (Rep.FiniteCyclicGroup.resolution k g hg)
        (Rep.barResolution k G) (n + 2) prev.1 prev.2.1 prev.2.2
      ⟨prev.2.1, next.1, next.2⟩

/-- The full augmented periodic-to-bar chain map whose degree-three
component realizes the explicit cyclic H3 sum. -/
noncomputable def cyclicOddToBarChainMap (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (Rep.FiniteCyclicGroup.resolution k g hg).complex ⟶
      (Rep.barResolution k G).complex where
  f
    | 0 => cyclicToBarZero (k := k) g
    | n + 1 =>
        match n with
        | 0 => cyclicToBarOne (k := k) g
        | m + 1 => (cyclicOddToBarAux (k := k) g hg m).1
  comm' i j hij := by
    rcases hij with ⟨rfl⟩
    cases j with
    | zero => exact cyclicToBarOne_comm g
    | succ n =>
        cases n with
        | zero => exact cyclicToBarTwo_comm g
        | succ m => exact (cyclicOddToBarAux (k := k) g hg m).2.2

@[simp]
theorem cyclicOddToBarChainMap_f_zero (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddToBarChainMap (k := k) g hg).f 0 =
      cyclicToBarZero (k := k) g := rfl

@[simp]
theorem cyclicOddToBarChainMap_f_one (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddToBarChainMap (k := k) g hg).f 1 =
      cyclicToBarOne (k := k) g := rfl

@[simp]
theorem cyclicOddToBarChainMap_f_two (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddToBarChainMap (k := k) g hg).f 2 =
      cyclicToBarTwo (k := k) g := rfl

@[simp]
theorem cyclicOddToBarChainMap_f_three (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddToBarChainMap (k := k) g hg).f 3 =
      cyclicToBarThree (k := k) g := rfl

set_option backward.isDefEq.respectTransparency false in
theorem cyclicOddToBarChainMap_f_zero_comp_π
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddToBarChainMap (k := k) g hg).f 0 ≫
        (Rep.barResolution k G).π.f 0 =
      (Rep.FiniteCyclicGroup.resolution k g hg).π.f 0 := by
  change cyclicToBarZero (k := k) g ≫
      (Rep.barResolution k G).π.f 0 =
    (Rep.FiniteCyclicGroup.resolution k g hg).π.f 0
  exact cyclicToBarChainMap_f_zero_comp_π (k := k) g hg

set_option backward.isDefEq.respectTransparency false in
theorem cyclicOddToBarChainMap_comp_π
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    cyclicOddToBarChainMap (k := k) g hg ≫ (Rep.barResolution k G).π =
      (Rep.FiniteCyclicGroup.resolution k g hg).π := by
  apply HomologicalComplex.Hom.ext
  funext n
  cases n with
  | zero => exact cyclicOddToBarChainMap_f_zero_comp_π g hg
  | succ n => simp

/-- Homotopy from the explicit odd comparison to Mathlib's canonical
projective-resolution lift. -/
noncomputable def cyclicOddToBarChainMapHomotopy
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Homotopy (cyclicOddToBarChainMap (k := k) g hg)
      (ProjectiveResolution.lift (𝟙 (Rep.trivial k G k))
        (Rep.FiniteCyclicGroup.resolution k g hg)
        (Rep.barResolution k G)) :=
  ProjectiveResolution.liftHomotopy (𝟙 (Rep.trivial k G k))
    (cyclicOddToBarChainMap (k := k) g hg)
    (ProjectiveResolution.lift (𝟙 (Rep.trivial k G k))
      (Rep.FiniteCyclicGroup.resolution k g hg)
      (Rep.barResolution k G))
    (by
      have hid :
          (ChainComplex.single₀ (Rep k G)).map
              (𝟙 (Rep.trivial k G k)) =
            𝟙 ((ChainComplex.single₀ (Rep k G)).obj
              (Rep.trivial k G k)) :=
        (ChainComplex.single₀ (Rep k G)).map_id _
      rw [hid, Category.comp_id]
      exact cyclicOddToBarChainMap_comp_π (k := k) g hg)
    (by simp)

/-- The periodic and bar resolutions, with the explicit odd chain map as
the forward homotopy equivalence. -/
noncomputable def cyclicOddToBarChainHomotopyEquiv
    (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    HomotopyEquiv
      (Rep.FiniteCyclicGroup.resolution k g hg).complex
      (Rep.barResolution k G).complex :=
  (ProjectiveResolution.homotopyEquiv
    (Rep.FiniteCyclicGroup.resolution k g hg)
    (Rep.barResolution k G)).copy
      (cyclicOddToBarChainMapHomotopy (k := k) g hg).symm

/-- Linear-Yoneda image of the explicit odd periodic-to-bar homotopy
equivalence. -/
noncomputable def cyclicOddBarLinearYonedaHomotopyEquiv
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    HomotopyEquiv
      (((Rep.barResolution k G).complex).linearYonedaObj k A)
      (((Rep.FiniteCyclicGroup.resolution k g hg).complex).linearYonedaObj k A) :=
  cyclicHomotopyEquivUnop <|
    ((linearYoneda k (Rep k G)).obj A).rightOp.mapHomotopyEquiv
      (cyclicOddToBarChainHomotopyEquiv (k := k) g hg)

@[simp]
theorem cyclicOddBarLinearYonedaHomotopyEquiv_hom
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddBarLinearYonedaHomotopyEquiv A g hg).hom =
      linearYonedaObjMap A (cyclicOddToBarChainMap (k := k) g hg) := rfl

/-- The explicit inhomogeneous-to-periodic cochain comparison whose
degree-three component is the cyclic sum. -/
noncomputable def cyclicOddBarCochainComparison
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    inhomogeneousCochains A ⟶
      Rep.FiniteCyclicGroup.moduleCatCochainComplex A g :=
  (inhomogeneousCochainsIso A).hom ≫
    linearYonedaObjMap A (cyclicOddToBarChainMap (k := k) g hg) ≫
      (Rep.FiniteCyclicGroup.homResolutionIso A g hg).hom

set_option backward.isDefEq.respectTransparency false in
theorem cyclicOddBarCochainComparison_f_three
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cochainsIso₃ A).inv ≫ (cyclicOddBarCochainComparison A g hg).f 3 =
      cyclicSumThree A g := by
  ext z
  simp only [cyclicOddBarCochainComparison, HomologicalComplex.comp_f,
    ModuleCat.hom_comp, LinearMap.comp_apply]
  change (Rep.leftRegularHomEquiv A)
      (((cyclicOddToBarChainMap (k := k) g hg).f 3) ≫
        ((Rep.freeLiftLEquiv k G (Fin 3 → G) A).symm
          ((cochainsIso₃ A).inv z))) = _
  rw [cyclicOddToBarChainMap_f_three]
  change ((cyclicToBarThreeRaw (k := k) g ≫
    ((Rep.freeLiftLEquiv k G (Fin 3 → G) A).symm
      ((cochainsIso₃ A).inv z))) |>
        Rep.leftRegularHomEquiv A) = _
  simp [cyclicToBarThreeRaw, cyclicBarBasis, cyclicBarTripleTuple,
    cochainsIso₃, Rep.homEquiv, Rep.freeLiftLEquiv]
  rfl

/-- Homotopy equivalence between inhomogeneous cochains and the periodic
cyclic cochain complex, with the explicit odd comparison as forward map. -/
noncomputable def cyclicOddBarCochainComparisonHomotopyEquiv
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    HomotopyEquiv (inhomogeneousCochains A)
      (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g) :=
  (HomotopyEquiv.ofIso (inhomogeneousCochainsIso A)).trans <|
    (cyclicOddBarLinearYonedaHomotopyEquiv A g hg).trans <|
      HomotopyEquiv.ofIso
        (Rep.FiniteCyclicGroup.homResolutionIso A g hg)

@[simp]
theorem cyclicOddBarCochainComparisonHomotopyEquiv_hom
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddBarCochainComparisonHomotopyEquiv A g hg).hom =
      cyclicOddBarCochainComparison A g hg := rfl

/-- Degree-three homology isomorphism induced by the explicit odd cochain
comparison. -/
noncomputable def cyclicOddBarCochainComparisonH3Iso
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    H3 A ≅
      (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).homology 3 :=
  (cyclicOddBarCochainComparisonHomotopyEquiv A g hg).toHomologyIso 3

@[simp]
theorem cyclicOddBarCochainComparisonH3Iso_hom
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicOddBarCochainComparisonH3Iso A g hg).hom =
      HomologicalComplex.homologyMap
        (cyclicOddBarCochainComparison A g hg) 3 := rfl

/-- Odd degree-three periodic homology is the concrete short-complex
homology `Ker(N) / Im(rho(g)-1)`. -/
noncomputable def cyclicOddPeriodicH3Iso
    (A : Rep k G) (g : G) :
    (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).homology 3 ≅
      (Rep.FiniteCyclicGroup.subCompNormHom A g).homology :=
  HomologicalComplex.alternatingConstHomologyIsoOdd
    (ModuleCat.of k A.V)
    (by ext; simp [Rep.sub_hom])
    (by ext; simp [Rep.sub_hom])
    (by simp) (by simp) (by simp) (show Odd 3 from ⟨1, rfl⟩)

/-- The explicit cyclic odd H3 isomorphism. -/
noncomputable def cyclicExplicitH3Iso
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    H3 A ≅ (Rep.FiniteCyclicGroup.subCompNormHom A g).homology :=
  cyclicOddBarCochainComparisonH3Iso A g hg ≪≫
    cyclicOddPeriodicH3Iso A g

/-- Map on H3 induced by the explicit low-degree odd short-complex
comparison, with abstract short-complex homology as target. -/
noncomputable def cyclicOddComparisonMap (A : Rep k G) (g : G) :
    H3 A ⟶ (Rep.FiniteCyclicGroup.subCompNormHom A g).homology :=
  (H3Iso A).hom ≫
    (shortComplexH3 A).moduleCatHomologyIso.inv ≫
      ShortComplex.homologyMap (cyclicOddComparisonHom A g)

set_option backward.isDefEq.respectTransparency false in
theorem cyclicOddComparisonMap_comp_moduleCatHomologyIso
    (A : Rep k G) (g : G) :
    cyclicOddComparisonMap A g ≫
        (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom =
      cyclicOddComparisonQuotientMap A g := by
  unfold cyclicOddComparisonMap cyclicOddComparisonQuotientMap
  simp only [Category.assoc]
  rw [cancel_epi]
  let γ := ShortComplex.leftHomologyMapData
    (cyclicOddComparisonHom A g)
    (shortComplexH3 A).moduleCatLeftHomologyData
    (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData
  change
    (shortComplexH3 A).moduleCatLeftHomologyData.homologyIso.inv ≫
        ShortComplex.homologyMap (cyclicOddComparisonHom A g) ≫
          (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData.homologyIso.hom =
      ShortComplex.leftHomologyMap' (cyclicOddComparisonHom A g)
        (shortComplexH3 A).moduleCatLeftHomologyData
        (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData
  rw [γ.homologyMap_comm]
  simpa only [Iso.inv_hom_id_assoc] using γ.leftHomologyMap'_eq.symm

set_option backward.isDefEq.respectTransparency false in
theorem cyclicExplicitH3Iso_hom_H3π
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) (z : cocycles₃ A) :
    (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
        ((cyclicExplicitH3Iso A g hg).hom (H3π A z)) =
      (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData.π
        (cyclicThreeCocycleInvariant A g z) := by
  unfold cyclicExplicitH3Iso cyclicOddBarCochainComparisonH3Iso
    cyclicOddPeriodicH3Iso H3π
  simp only [Iso.trans_hom, HomotopyEquiv.toHomologyIso,
    cyclicOddBarCochainComparisonHomotopyEquiv_hom,
    ModuleCat.hom_comp, LinearMap.comp_apply]
  let e : (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).sc 3 ≅
      Rep.FiniteCyclicGroup.subCompNormHom A g :=
    HomologicalComplex.alternatingConstScIsoOdd
      (ModuleCat.of k A.V)
      (by ext; simp [Rep.sub_hom])
      (by ext; simp [Rep.sub_hom])
      (by simp) (by simp) (by simp) (show Odd 3 from ⟨1, rfl⟩)
  let y := (isoCocycles₃ A).inv z
  let u := HomologicalComplex.cyclesMap
    (cyclicOddBarCochainComparison A g hg) 3 y
  let v := ShortComplex.cyclesMap e.hom u
  have h₁ := ConcreteCategory.congr_hom
    (HomologicalComplex.homologyπ_naturality
      (cyclicOddBarCochainComparison A g hg) 3) y
  have h₂ := ConcreteCategory.congr_hom
    (ShortComplex.homologyπ_naturality e.hom) u
  have h₃ := ShortComplex.π_moduleCatCyclesIso_hom_apply
    (Rep.FiniteCyclicGroup.subCompNormHom A g) v
  change (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
      ((ShortComplex.homologyMap e.hom)
        (HomologicalComplex.homologyMap
          (cyclicOddBarCochainComparison A g hg) 3
          ((inhomogeneousCochains A).homologyπ 3 y))) = _
  have hyMap :
      (isoCocycles₃ A).inv ≫ (inhomogeneousCochains A).iCycles 3 =
        (shortComplexH3 A).moduleCatLeftHomologyData.i ≫
          (cochainsIso₃ A).inv := by
    rw [← cancel_epi (isoCocycles₃ A).hom]
    simp only [Iso.hom_inv_id_assoc]
    rw [← Category.assoc, isoCocycles₃_hom_comp_i,
      Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hw :
      (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatCyclesIso.hom v =
        cyclicThreeCocycleInvariant A g z := by
    apply Subtype.ext
    change ((Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData.i).hom
        ((Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatCyclesIso.hom v) =
      (cyclicThreeCocycleInvariant A g z : A)
    have hm := ConcreteCategory.congr_hom
      (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatCyclesIso_hom_i v
    have he := ConcreteCategory.congr_hom
      (ShortComplex.cyclesMap_i e.hom) u
    have hc := ConcreteCategory.congr_hom
      (HomologicalComplex.cyclesMap_i
        (cyclicOddBarCochainComparison A g hg) 3) y
    have hy := ConcreteCategory.congr_hom hyMap z
    have hcomp := ConcreteCategory.congr_hom
      (cyclicOddBarCochainComparison_f_three A g hg) z
    calc
      _ = ((Rep.FiniteCyclicGroup.subCompNormHom A g).iCycles).hom v := by
        simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using hm
      _ = e.hom.τ₂.hom
          (((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).iCycles 3).hom u) := by
        change (ConcreteCategory.hom
            (ShortComplex.cyclesMap e.hom ≫
              (Rep.FiniteCyclicGroup.subCompNormHom A g).iCycles)) u =
          (ConcreteCategory.hom
            (((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).sc 3).iCycles ≫
              e.hom.τ₂)) u
        exact he
      _ = ((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).iCycles 3).hom u := by
        rfl
      _ = ((cyclicOddBarCochainComparison A g hg).f 3).hom
          ((inhomogeneousCochains A).iCycles 3 y) := by
        change (ConcreteCategory.hom
            (HomologicalComplex.cyclesMap
                (cyclicOddBarCochainComparison A g hg) 3 ≫
              (Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).iCycles 3)) y =
          (ConcreteCategory.hom
            ((inhomogeneousCochains A).iCycles 3 ≫
              (cyclicOddBarCochainComparison A g hg).f 3)) y
        exact hc
      _ = ((cyclicOddBarCochainComparison A g hg).f 3).hom
          ((cochainsIso₃ A).inv z) := congrArg _ hy
      _ = (cyclicSumThree A g).hom z := by
        change (ConcreteCategory.hom
            ((cochainsIso₃ A).inv ≫
              (cyclicOddBarCochainComparison A g hg).f 3)) z =
          (ConcreteCategory.hom (cyclicSumThree A g)) z
        exact hcomp
      _ = _ := rfl
  calc
    _ = (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
        ((ShortComplex.homologyMap e.hom)
          ((Rep.FiniteCyclicGroup.moduleCatCochainComplex A g).homologyπ 3 u)) := by
      exact congrArg
        (fun q => (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
          ((ShortComplex.homologyMap e.hom) q)) h₁
    _ = (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
        ((Rep.FiniteCyclicGroup.subCompNormHom A g).homologyπ v) := by
      exact congrArg
        (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom h₂
    _ = (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData.π
        ((Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatCyclesIso.hom v) := h₃
    _ = _ := congrArg
      (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatLeftHomologyData.π hw

set_option backward.isDefEq.respectTransparency false in
theorem cyclicExplicitH3Iso_hom_eq_cyclicOddComparisonMap
    (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (cyclicExplicitH3Iso A g hg).hom = cyclicOddComparisonMap A g := by
  rw [← cancel_mono
    (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom]
  rw [cyclicOddComparisonMap_comp_moduleCatHomologyIso]
  rw [← cancel_epi (H3π A)]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro z
  change (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
      ((cyclicExplicitH3Iso A g hg).hom (H3π A z)) =
    cyclicOddComparisonQuotientMap A g (H3π A z)
  exact (cyclicExplicitH3Iso_hom_H3π A g hg z).trans
    (cyclicOddComparisonQuotientMap_H3π A g z).symm

/-- For a finite cyclic group generated by `g`, the explicit cyclic odd H3
comparison is bijective. -/
theorem cyclicOddComparisonMap_bijective
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Function.Bijective (cyclicOddComparisonMap A g) := by
  rw [← cyclicExplicitH3Iso_hom_eq_cyclicOddComparisonMap A g hg]
  exact (ConcreteCategory.isIso_iff_bijective _).mp inferInstance

/-- The concrete quotient-valued cyclic H3 comparison is the explicit full
resolution isomorphism followed by the canonical homology quotient
identification. -/
theorem cyclicH3ToOddHomology_eq_cyclicExplicitH3Iso
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    cyclicH3ToOddHomology A g =
      (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom.hom.comp
        (cyclicExplicitH3Iso A g hg).hom.hom := by
  rw [cyclicH3ToOddHomology_eq_cyclicOddComparisonQuotientMap]
  apply LinearMap.ext
  intro x
  change cyclicOddComparisonQuotientMap A g x =
    (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
      ((cyclicExplicitH3Iso A g hg).hom x)
  rw [cyclicExplicitH3Iso_hom_eq_cyclicOddComparisonMap]
  exact (ConcreteCategory.congr_hom
    (cyclicOddComparisonMap_comp_moduleCatHomologyIso A g) x).symm

/-- The concrete cyclic H3 comparison with `Ker(N)/Im(rho(g)-1)` is
bijective. -/
theorem cyclicH3ToOddHomology_bijective
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Function.Bijective (cyclicH3ToOddHomology A g) := by
  rw [cyclicH3ToOddHomology_eq_cyclicExplicitH3Iso A g hg]
  let e := (cyclicExplicitH3Iso A g hg).toLinearEquiv.trans
    (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.toLinearEquiv
  change Function.Bijective e
  exact e.bijective

/-- Linear equivalence from ordinary H3 to the explicit odd quotient
`Ker(N)/Im(rho(g)-1)`. -/
noncomputable def cyclicExplicitH3QuotientLinearEquiv
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    H3 A ≃ₗ[k] cyclicOddQuotient A g :=
  (cyclicExplicitH3Iso A g hg).toLinearEquiv.trans
    (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.toLinearEquiv

@[simp]
theorem cyclicExplicitH3QuotientLinearEquiv_apply
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (x : H3 A) :
    cyclicExplicitH3QuotientLinearEquiv A g hg x =
      cyclicH3ToOddHomology A g x := by
  change (Rep.FiniteCyclicGroup.subCompNormHom A g).moduleCatHomologyIso.hom
      ((cyclicExplicitH3Iso A g hg).hom x) = cyclicH3ToOddHomology A g x
  exact congrArg (fun f : H3 A →ₗ[k] cyclicOddQuotient A g => f x)
    (cyclicH3ToOddHomology_eq_cyclicExplicitH3Iso A g hg).symm

/-- The full-resolution cyclic H3 isomorphism sends a right-associated
triple cup to its explicit odd quotient representative. -/
theorem cyclicExplicitH3Iso_nestedCupOneOne
    (A B C : Rep k G) (g : G)
    (hg : ∀ a, a ∈ Subgroup.zpowers g)
    (x : cocycles₁ A) (y : cocycles₁ B) (z : cocycles₁ C) :
    (Rep.FiniteCyclicGroup.subCompNormHom
        (A ⊗ (B ⊗ C)) g).moduleCatHomologyIso.hom
      ((cyclicExplicitH3Iso (A ⊗ (B ⊗ C)) g hg).hom
        (H3π (A ⊗ (B ⊗ C))
          (cupCocycleOneTwo A (B ⊗ C) x
            (cupCocycleOneOne B C y z)))) =
      cyclicOddHomologyπ (A ⊗ (B ⊗ C)) g
        (cyclicNestedCupOneOneInvariant A B C g x y z) :=
  cyclicExplicitH3Iso_hom_H3π (A ⊗ (B ⊗ C)) g hg _

end groupCohomology
