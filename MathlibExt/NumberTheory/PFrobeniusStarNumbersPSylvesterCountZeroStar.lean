/-!
# `0`-Sylvester number of three consecutive star numbers

The representation count `starRepCount` of a natural number by three consecutive star numbers,
the `p`-Sylvester count `pSylvesterStarCount`, and the `0`-Sylvester number of three consecutive
star numbers: for `n ≥ 6` the number of natural numbers not representable by `S_n`, `S_{n+1}`,
`S_{n+2}` is `n * (15 * n ^ 2 + 8 * n + 7)`.

Statements from Takao Komatsu, Tapas Chatterjee, and Palak Narula,
"On p-Frobenius Numbers for the Numerical Semigroups Generated by
Three Consecutive Star Numbers", *INTEGERS* 25 (2025), Article A106
(<https://math.colgate.edu/~integers/z106/z106.pdf>), Theorem 2.
-/

open scoped BigOperators

@[expose] public section

namespace MathlibExt.NumberTheory.PFrobeniusStarNumbersWanted

export MetaMathlibExt.StarNumber (star)

private theorem star_pos (n : ℕ) : 0 < star n := by
  change 0 < 6 * n * (n - 1) + 1
  omega

private theorem star_succ_eq (n : ℕ) (hn : 6 ≤ n) :
    star (n + 1) = star n + 12 * n := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  change 6 * (m + 1 + 1) * (m + 1) + 1 = 6 * (m + 1) * m + 1 + 12 * (m + 1)
  ring

private theorem star_succ_succ_eq (n : ℕ) (hn : 6 ≤ n) :
    star (n + 2) = star n + (24 * n + 12) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  change 6 * (m + 1 + 2) * (m + 1 + 1) + 1
    = 6 * (m + 1) * m + 1 + (24 * (m + 1) + 12)
  ring

private theorem rel_M1 (n : ℕ) (hn : 6 ≤ n) :
    (2 * n + 1) * star (n + 1) = n * star (n + 2) + (n + 1) * star n := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  change (2 * (m + 1) + 1) * (6 * (m + 1 + 1) * (m + 1) + 1) =
    (m + 1) * (6 * (m + 1 + 2) * (m + 1 + 1) + 1) +
      (m + 1 + 1) * (6 * (m + 1) * m + 1)
  ring

private theorem rel_M2 (n : ℕ) (hn : 6 ≤ n) :
    (2 * n - 10) * star (n + 1) + (2 * n + 1) * star (n + 2) =
      (4 * n + 3) * star n := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 6 := ⟨n - 6, by omega⟩
  have h10 : 2 * (m + 6) - 10 = 2 * m + 2 := by omega
  rw [h10]
  change (2 * m + 2) * (6 * (m + 6 + 1) * (m + 6) + 1) +
      (2 * (m + 6) + 1) * (6 * (m + 6 + 2) * (m + 6 + 1) + 1) =
    (4 * (m + 6) + 3) * (6 * (m + 6) * (m + 5) + 1)
  ring

private theorem rel_M3 (n : ℕ) (hn : 6 ≤ n) :
    11 * star (n + 1) + (3 * n + 2) * star n = (3 * n + 1) * star (n + 2) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  change 11 * (6 * (m + 1 + 1) * (m + 1) + 1) +
      (3 * (m + 1) + 2) * (6 * (m + 1) * m + 1) =
    (3 * (m + 1) + 1) * (6 * (m + 1 + 2) * (m + 1 + 1) + 1)
  ring

private theorem odd_star (n : ℕ) : Odd (star n) := by
  change Odd (6 * n * (n - 1) + 1)
  have h6 : Even (6 : ℕ) := ⟨3, rfl⟩
  exact ((h6.mul_right n).mul_right (n - 1)).add_odd odd_one

private theorem dvd_two_eq_one (d m : ℕ) (hd2 : d ∣ 2) (hdvd : d ∣ m)
    (hpos : 0 < m) (hodd : Odd m) : d = 1 := by
  have hd_le : d ≤ 2 := Nat.le_of_dvd (by norm_num) hd2
  have hd_ne : d ≠ 0 := by
    intro h0
    rw [h0, zero_dvd_iff] at hdvd
    omega
  rcases (by omega : d = 1 ∨ d = 2) with rfl | rfl
  · rfl
  · exact absurd (even_iff_two_dvd.mpr hdvd) (Nat.not_even_iff_odd.mpr hodd)

private theorem coprime_a1_a2 (n : ℕ) (hn : 6 ≤ n) :
    Nat.Coprime (star n) (star (n + 1)) := by
  have h2 : ∀ d : ℕ, d ∣ star n → d ∣ star (n + 1) → d = 1 := by
    intro d hd1 hd2
    have hsub : d ∣ star (n + 1) - star n := Nat.dvd_sub hd2 hd1
    have hdiff : star (n + 1) - star n = 12 * n := by
      have h := star_succ_eq n hn
      omega
    rw [hdiff] at hsub
    have h12 : d ∣ 12 * n * (n - 1) := dvd_mul_of_dvd_left hsub (n - 1)
    have key : 2 * star n - 12 * n * (n - 1) = 2 := by
      have ha : star n = 6 * n * (n - 1) + 1 := rfl
      have he : 12 * n * (n - 1) = 2 * (6 * n * (n - 1)) := by ring
      rw [ha, he]
      omega
    have hdvd2 : d ∣ 2 * star n - 12 * n * (n - 1) :=
      Nat.dvd_sub (dvd_mul_of_dvd_right hd1 2) h12
    rw [key] at hdvd2
    exact dvd_two_eq_one d (star n) hdvd2 hd1 (star_pos n) (odd_star n)
  exact h2 _ (Nat.gcd_dvd_left _ _) (Nat.gcd_dvd_right _ _)

private theorem coprime_a2_a3 (n : ℕ) (hn : 6 ≤ n) :
    Nat.Coprime (star (n + 1)) (star (n + 2)) := by
  have h2 : ∀ d : ℕ, d ∣ star (n + 1) → d ∣ star (n + 2) → d = 1 := by
    intro d hd1 hd2
    have hsub : d ∣ star (n + 2) - star (n + 1) := Nat.dvd_sub hd2 hd1
    have hdiff : star (n + 2) - star (n + 1) = 12 * n + 12 := by
      have h1 := star_succ_eq n hn
      have h2 := star_succ_succ_eq n hn
      omega
    rw [hdiff] at hsub
    have h12 : d ∣ n * (12 * n + 12) := dvd_mul_of_dvd_right hsub n
    have key : 2 * star (n + 1) - n * (12 * n + 12) = 2 := by
      have ha : star (n + 1) = 6 * (n + 1) * n + 1 := rfl
      have he : n * (12 * n + 12) = 2 * (6 * (n + 1) * n) := by ring
      rw [ha, he]
      omega
    have hdvd2 : d ∣ 2 * star (n + 1) - n * (12 * n + 12) :=
      Nat.dvd_sub (dvd_mul_of_dvd_right hd1 2) h12
    rw [key] at hdvd2
    exact dvd_two_eq_one d (star (n + 1)) hdvd2 hd1 (star_pos (n + 1))
      (odd_star (n + 1))
  exact h2 _ (Nat.gcd_dvd_left _ _) (Nat.gcd_dvd_right _ _)

private def R (n : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.range (2 * n + 1) ×ˢ Finset.range (2 * n + 1)) ∪
    (Finset.range (2 * n - 10) ×ˢ Finset.Ico (2 * n + 1) (3 * n + 1))

private theorem mem_R (n : ℕ) (p : ℕ × ℕ) :
    p ∈ R n ↔ (p.2 < 2 * n + 1 ∧ p.1 < 2 * n + 1) ∨
      (2 * n + 1 ≤ p.2 ∧ p.2 < 3 * n + 1 ∧ p.1 < 2 * n - 10) := by
  unfold R
  simp only [Finset.mem_union, Finset.mem_product, Finset.mem_range, Finset.mem_Ico]
  tauto

private theorem card_R (n : ℕ) (hn : 6 ≤ n) : (R n).card = star n := by
  unfold R
  have hdisj : Disjoint (Finset.range (2 * n + 1) ×ˢ Finset.range (2 * n + 1))
      (Finset.range (2 * n - 10) ×ˢ Finset.Ico (2 * n + 1) (3 * n + 1)) := by
    rw [Finset.disjoint_left]
    intro p hp1 hp2
    simp only [Finset.mem_product, Finset.mem_range, Finset.mem_Ico] at hp1 hp2
    omega
  have h1 : (Finset.range (2 * n + 1) ×ˢ Finset.range (2 * n + 1)).card
      = (2 * n + 1) * (2 * n + 1) := by
    rw [Finset.card_product, Finset.card_range]
  have h2 : (Finset.range (2 * n - 10) ×ˢ Finset.Ico (2 * n + 1) (3 * n + 1)).card
      = (2 * n - 10) * ((3 * n + 1) - (2 * n + 1)) := by
    rw [Finset.card_product, Finset.card_range, Nat.card_Ico]
  have hu := Finset.card_union_add_card_inter
    (Finset.range (2 * n + 1) ×ˢ Finset.range (2 * n + 1))
    (Finset.range (2 * n - 10) ×ˢ Finset.Ico (2 * n + 1) (3 * n + 1))
  rw [Finset.disjoint_iff_inter_eq_empty.mp hdisj, Finset.card_empty] at hu
  rw [h1, h2] at hu
  have hval : (2 * n + 1) * (2 * n + 1) + (2 * n - 10) * ((3 * n + 1) - (2 * n + 1))
      = star n := by
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 6 := ⟨n - 6, by omega⟩
    have h10 : 2 * (m + 6) - 10 = 2 * m + 2 := by omega
    have hzz : (3 * (m + 6) + 1) - (2 * (m + 6) + 1) = m + 6 := by omega
    rw [h10, hzz]
    change (2 * (m + 6) + 1) * (2 * (m + 6) + 1) + (2 * m + 2) * (m + 6)
      = 6 * (m + 6) * (m + 5) + 1
    ring
  omega

private theorem star_succ_succ_ge (n : ℕ) : 2 * n + 1 ≤ star (n + 2) := by
  change 2 * n + 1 ≤ 6 * (n + 2) * (n + 1) + 1
  have h1 : n + 1 ≤ (n + 2) * (n + 1) := Nat.le_mul_of_pos_left (n + 1) (by omega)
  have h2 : 6 * (n + 1) ≤ 6 * ((n + 2) * (n + 1)) := Nat.mul_le_mul_left 6 h1
  have h3 : 6 * ((n + 2) * (n + 1)) = 6 * (n + 2) * (n + 1) := by ring
  omega

private theorem t_inj_on_R (n : ℕ) (hn : 6 ≤ n) :
    Set.InjOn (fun p : ℕ × ℕ => p.1 * star (n + 1) + p.2 * star (n + 2)) ↑(R n) := by
  have hstor : ∀ p : ℕ × ℕ, p ∈ R n → p.1 < 2 * n + 1 := by
    intro p hp
    rw [mem_R] at hp
    rcases hp with ⟨_, h⟩ | ⟨_, _, h⟩ <;> omega
  have hcase : ∀ p q : ℕ × ℕ, p ∈ R n → q ∈ R n →
      p.1 * star (n + 1) + p.2 * star (n + 2) =
        q.1 * star (n + 1) + q.2 * star (n + 2) → p.1 ≤ q.1 → p = q := by
    intro p q hp hq heq hle
    have hle2 := Nat.mul_le_mul_right (star (n + 1)) hle
    have h3 : q.1 * star (n + 1) - p.1 * star (n + 1) =
        p.2 * star (n + 2) - q.2 * star (n + 2) := by omega
    rw [← Nat.sub_mul, ← Nat.sub_mul] at h3
    have hdvd : star (n + 2) ∣ (q.1 - p.1) * star (n + 1) :=
      ⟨p.2 - q.2, by rw [h3]; ring⟩
    have hdvd2 : star (n + 2) ∣ q.1 - p.1 :=
      (coprime_a2_a3 n hn).symm.dvd_of_dvd_mul_right hdvd
    have hlt : q.1 - p.1 < star (n + 2) := by
      have h1 : q.1 - p.1 < 2 * n + 1 := by
        have hq1 := hstor q hq
        omega
      have h2 := star_succ_succ_ge n
      omega
    have hzero : q.1 - p.1 = 0 := Nat.eq_zero_of_dvd_of_lt hdvd2 hlt
    have hpq1 : p.1 = q.1 := by omega
    rw [hpq1] at heq
    have heq2 : p.2 * star (n + 2) = q.2 * star (n + 2) := by omega
    have hpq2 : p.2 = q.2 :=
      mul_right_cancel₀ (ne_of_gt (star_pos (n + 2))) heq2
    exact Prod.ext hpq1 hpq2
  intro p hp q hq heq
  rw [Finset.mem_coe] at hp hq
  dsimp only at heq
  rcases le_total p.1 q.1 with hle | hle
  · exact hcase p q hp hq heq hle
  · exact (hcase q p hq hp heq.symm hle).symm

private theorem reduce_to_region (n : ℕ) (hn : 6 ≤ n) (y z : ℕ) :
    ∃ y' z' : ℕ, ((z' < 2 * n + 1 ∧ y' < 2 * n + 1) ∨
      (2 * n + 1 ≤ z' ∧ z' < 3 * n + 1 ∧ y' < 2 * n - 10)) ∧
      y' * star (n + 1) + z' * star (n + 2) ≤ y * star (n + 1) + z * star (n + 2) ∧
      (y' * star (n + 1) + z' * star (n + 2)) % star n =
        (y * star (n + 1) + z * star (n + 2)) % star n := by
  have key : ∀ v y z : ℕ, y * star (n + 1) + z * star (n + 2) = v →
      ∃ y' z' : ℕ, ((z' < 2 * n + 1 ∧ y' < 2 * n + 1) ∨
        (2 * n + 1 ≤ z' ∧ z' < 3 * n + 1 ∧ y' < 2 * n - 10)) ∧
        y' * star (n + 1) + z' * star (n + 2) ≤ y * star (n + 1) + z * star (n + 2) ∧
        (y' * star (n + 1) + z' * star (n + 2)) % star n =
          (y * star (n + 1) + z * star (n + 2)) % star n := by
    intro v
    induction v using Nat.strong_induction_on with
    | _ v IH =>
    intro y z hv
    by_cases hy0 : 2 * n + 1 ≤ y
    · obtain ⟨k, rfl⟩ : ∃ k, y = (2 * n + 1) + k := ⟨y - (2 * n + 1), by omega⟩
      have m1 := rel_M1 n hn
      have heq : k * star (n + 1) + (z + n) * star (n + 2) + (n + 1) * star n =
          ((2 * n + 1) + k) * star (n + 1) + z * star (n + 2) := by
        linear_combination -m1
      have hpos : 0 < (n + 1) * star n := mul_pos (by omega) (star_pos n)
      have hlt : k * star (n + 1) + (z + n) * star (n + 2) < v := by omega
      have hmod : (k * star (n + 1) + (z + n) * star (n + 2)) % star n =
          (((2 * n + 1) + k) * star (n + 1) + z * star (n + 2)) % star n := by
        have h2 : ((2 * n + 1) + k) * star (n + 1) + z * star (n + 2) =
            (k * star (n + 1) + (z + n) * star (n + 2)) + (n + 1) * star n := by
          omega
        rw [h2, Nat.add_mul_mod_self_right]
      obtain ⟨y', z', hreg, hle, hmod2⟩ := IH _ hlt k (z + n) rfl
      refine ⟨y', z', hreg, hle.trans ?_, hmod2.trans hmod⟩
      omega
    · push Not at hy0
      by_cases hz0 : 2 * n + 1 ≤ z
      · by_cases hy1 : 2 * n - 10 ≤ y
        · obtain ⟨k, rfl⟩ : ∃ k, y = (2 * n - 10) + k := ⟨y - (2 * n - 10), by omega⟩
          obtain ⟨j, rfl⟩ : ∃ j, z = (2 * n + 1) + j := ⟨z - (2 * n + 1), by omega⟩
          have m2 := rel_M2 n hn
          have heq : k * star (n + 1) + j * star (n + 2) + (4 * n + 3) * star n =
              ((2 * n - 10) + k) * star (n + 1) + ((2 * n + 1) + j) * star (n + 2) := by
            linear_combination -m2
          have hpos : 0 < (4 * n + 3) * star n := mul_pos (by omega) (star_pos n)
          have hlt : k * star (n + 1) + j * star (n + 2) < v := by omega
          have hmod : (k * star (n + 1) + j * star (n + 2)) % star n =
              (((2 * n - 10) + k) * star (n + 1) +
                ((2 * n + 1) + j) * star (n + 2)) % star n := by
            have h2 : ((2 * n - 10) + k) * star (n + 1) + ((2 * n + 1) + j) * star (n + 2) =
                (k * star (n + 1) + j * star (n + 2)) + (4 * n + 3) * star n := by
              omega
            rw [h2, Nat.add_mul_mod_self_right]
          obtain ⟨y', z', hreg, hle, hmod2⟩ := IH _ hlt k j rfl
          refine ⟨y', z', hreg, hle.trans ?_, hmod2.trans hmod⟩
          omega
        · push Not at hy1
          by_cases hz1 : z < 3 * n + 1
          · exact ⟨y, z, Or.inr ⟨hz0, hz1, hy1⟩, le_rfl, rfl⟩
          · push Not at hz1
            obtain ⟨j, rfl⟩ : ∃ j, z = (3 * n + 1) + j := ⟨z - (3 * n + 1), by omega⟩
            have m3 := rel_M3 n hn
            have heq : (y + 11) * star (n + 1) + j * star (n + 2) + (3 * n + 2) * star n =
                y * star (n + 1) + ((3 * n + 1) + j) * star (n + 2) := by
              linear_combination m3
            have hpos : 0 < (3 * n + 2) * star n := mul_pos (by omega) (star_pos n)
            have hlt : (y + 11) * star (n + 1) + j * star (n + 2) < v := by omega
            have hmod : ((y + 11) * star (n + 1) + j * star (n + 2)) % star n =
                (y * star (n + 1) + ((3 * n + 1) + j) * star (n + 2)) % star n := by
              have h2 : y * star (n + 1) + ((3 * n + 1) + j) * star (n + 2) =
                  ((y + 11) * star (n + 1) + j * star (n + 2)) + (3 * n + 2) * star n := by
                omega
              rw [h2, Nat.add_mul_mod_self_right]
            obtain ⟨y', z', hreg, hle, hmod2⟩ := IH _ hlt (y + 11) j rfl
            refine ⟨y', z', hreg, hle.trans ?_, hmod2.trans hmod⟩
            omega
      · push Not at hz0
        exact ⟨y, z, Or.inl ⟨hz0, hy0⟩, le_rfl, rfl⟩
  exact key _ y z rfl

private def W (n : ℕ) : Finset ℕ :=
  (R n).image (fun p : ℕ × ℕ => p.1 * star (n + 1) + p.2 * star (n + 2))

private theorem W_card (n : ℕ) (hn : 6 ≤ n) : (W n).card = star n := by
  unfold W
  rw [Finset.card_image_of_injOn (t_inj_on_R n hn), card_R n hn]

private theorem mem_W (n : ℕ) (w : ℕ) :
    w ∈ W n ↔ ∃ y z : ℕ, ((z < 2 * n + 1 ∧ y < 2 * n + 1) ∨
      (2 * n + 1 ≤ z ∧ z < 3 * n + 1 ∧ y < 2 * n - 10)) ∧
      y * star (n + 1) + z * star (n + 2) = w := by
  unfold W
  simp only [Finset.mem_image, mem_R]
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p.1, p.2, hp, rfl⟩
  · rintro ⟨y, z, hreg, rfl⟩
    exact ⟨(y, z), hreg, rfl⟩

private theorem every_class_hit (n : ℕ) (hn : 6 ≤ n) (r : ℕ) (hr : r < star n) :
    ∃ w : ℕ, w ∈ W n ∧ w % star n = r := by
  have ha1 : 1 < star n := by
    change 1 < 6 * n * (n - 1) + 1
    have h4 : 0 < 6 * n * (n - 1) :=
      mul_pos (mul_pos (by norm_num) (by omega)) (by omega)
    omega
  obtain ⟨binv, _, hb1⟩ := Nat.exists_mul_mod_eq_one_of_coprime
    (coprime_a1_a2 n hn).symm ha1
  have hmod : ((r * binv) * star (n + 1)) % star n = r := by
    have h3 : r * (star (n + 1) * binv) % star n = r % star n := by
      rw [Nat.mul_mod, hb1]
      simp
    have hrw : (r * binv) * star (n + 1) = r * (star (n + 1) * binv) := by ring
    rw [hrw, h3, Nat.mod_eq_of_lt hr]
  obtain ⟨y', z', hreg, _, hmod2⟩ := reduce_to_region n hn (r * binv) 0
  refine ⟨y' * star (n + 1) + z' * star (n + 2), ?_, ?_⟩
  · rw [mem_W]
    exact ⟨y', z', hreg, rfl⟩
  · have ht0 : (r * binv) * star (n + 1) + 0 * star (n + 2) =
        (r * binv) * star (n + 1) := by omega
    rw [ht0] at hmod2
    exact hmod2.trans hmod

private theorem fiber_unique (n : ℕ) (hn : 6 ≤ n) (r : ℕ) (hr : r < star n)
    (w₁ w₂ : ℕ) (h1 : w₁ ∈ W n) (hr1 : w₁ % star n = r)
    (h2 : w₂ ∈ W n) (hr2 : w₂ % star n = r) : w₁ = w₂ := by
  have hge : ∀ b ∈ Finset.range (star n),
      1 ≤ (Finset.filter (fun a => a % star n = b) (W n)).card := by
    intro b hb
    rw [Finset.mem_range] at hb
    obtain ⟨w, hwW, hwb⟩ := every_class_hit n hn b hb
    have hmem : w ∈ Finset.filter (fun a => a % star n = b) (W n) := by
      rw [Finset.mem_filter]
      exact ⟨hwW, hwb⟩
    have hpos := Finset.card_pos.mpr ⟨w, hmem⟩
    omega
  have hunion : (Finset.range (star n)).biUnion
      (fun b => Finset.filter (fun a => a % star n = b) (W n)) = W n := by
    ext w
    simp only [Finset.mem_biUnion, Finset.mem_filter, Finset.mem_range]
    constructor
    · rintro ⟨b, _, hw, -⟩
      exact hw
    · intro hw
      exact ⟨w % star n, Nat.mod_lt w (star_pos n), hw, rfl⟩
  have hdisj : Set.PairwiseDisjoint ↑(Finset.range (star n))
      (fun b => Finset.filter (fun a => a % star n = b) (W n)) := by
    intro b1 _ b2 _ hne
    change Disjoint (Finset.filter (fun a => a % star n = b1) (W n))
      (Finset.filter (fun a => a % star n = b2) (W n))
    rw [Finset.disjoint_left]
    intro w hw1 hw2
    rw [Finset.mem_filter] at hw1 hw2
    exact hne (hw1.2.symm.trans hw2.2)
  have hsum : (W n).card =
      ∑ b ∈ Finset.range (star n),
        (Finset.filter (fun a => a % star n = b) (W n)).card := by
    have hcb := Finset.card_biUnion hdisj
    rw [hunion] at hcb
    exact hcb
  have hall1 : ∀ b ∈ Finset.range (star n),
      (Finset.filter (fun a => a % star n = b) (W n)).card = 1 := by
    intro b hb
    by_contra hne
    have h2 : 2 ≤ (Finset.filter (fun a => a % star n = b) (W n)).card := by
      have h1 := hge b hb
      omega
    have hsplit := Finset.add_sum_erase (Finset.range (star n))
      (fun b => (Finset.filter (fun a => a % star n = b) (W n)).card) hb
    have hle : ((Finset.range (star n)).erase b).card ≤
        ∑ c ∈ (Finset.range (star n)).erase b,
          (Finset.filter (fun a => a % star n = c) (W n)).card := by
      have hcc := Finset.card_eq_sum_ones ((Finset.range (star n)).erase b)
      rw [hcc]
      apply Finset.sum_le_sum
      intro c hc
      exact hge c (Finset.mem_of_mem_erase hc)
    have hcard_erase : ((Finset.range (star n)).erase b).card = star n - 1 := by
      rw [Finset.card_erase_of_mem hb, Finset.card_range]
    rw [← hsum, W_card n hn] at hsplit
    omega
  have hb : r ∈ Finset.range (star n) := Finset.mem_range.mpr hr
  have hcard1 := hall1 r hb
  have hm1 : w₁ ∈ Finset.filter (fun a => a % star n = r) (W n) :=
    Finset.mem_filter.mpr ⟨h1, hr1⟩
  have hm2 : w₂ ∈ Finset.filter (fun a => a % star n = r) (W n) :=
    Finset.mem_filter.mpr ⟨h2, hr2⟩
  rw [Finset.card_eq_one] at hcard1
  obtain ⟨w, hw⟩ := hcard1
  rw [hw, Finset.mem_singleton] at hm1 hm2
  exact hm1.trans hm2.symm

private noncomputable def wS (n : ℕ) (hn : 6 ≤ n) (r : ℕ) : ℕ :=
  if h : r < star n then Classical.choose (every_class_hit n hn r h) else 0

private theorem wS_mem (n : ℕ) (hn : 6 ≤ n) (r : ℕ) (hr : r < star n) :
    wS n hn r ∈ W n ∧ (wS n hn r) % star n = r := by
  unfold wS
  rw [dite_eq_left hr]
  exact Classical.choose_spec (every_class_hit n hn r hr)

private theorem wS_unique (n : ℕ) (hn : 6 ≤ n) (r : ℕ) (hr : r < star n) (w : ℕ)
    (hw : w ∈ W n) (hwr : w % star n = r) : w = wS n hn r :=
  fiber_unique n hn r hr w (wS n hn r) hw hwr (wS_mem n hn r hr).1
    (wS_mem n hn r hr).2

private noncomputable def cS (n : ℕ) (hn : 6 ≤ n) (r : ℕ) : ℕ :=
  (wS n hn r - r) / star n

private theorem wS_eq (n : ℕ) (hn : 6 ≤ n) (r : ℕ) (hr : r < star n) :
    wS n hn r = r + star n * cS n hn r := by
  have hspec := wS_mem n hn r hr
  have hmod := Nat.div_add_mod (wS n hn r) (star n)
  rw [hspec.2] at hmod
  have hle : r ≤ wS n hn r := by
    have h := Nat.mod_le (wS n hn r) (star n)
    omega
  have hsub : wS n hn r - r = star n * (wS n hn r / star n) := by omega
  have hcancel : star n * (wS n hn r / star n) / star n = wS n hn r / star n :=
    Nat.mul_div_cancel_left _ (star_pos n)
  unfold cS
  rw [hsub, hcancel]
  omega

private theorem triple_finite (n N : ℕ) :
    Finite {xyz : ℕ × ℕ × ℕ //
      xyz.1 * star n + xyz.2.1 * star (n + 1) + xyz.2.2 * star (n + 2) = N} := by
  have hsub : {xyz : ℕ × ℕ × ℕ | xyz.1 * star n + xyz.2.1 * star (n + 1) +
      xyz.2.2 * star (n + 2) = N} ⊆
      ↑(Finset.range (N + 1) ×ˢ (Finset.range (N + 1) ×ˢ Finset.range (N + 1))) := by
    intro xyz hxyz
    simp only [Set.mem_ofPred_eq] at hxyz
    simp only [Finset.mem_coe, Finset.mem_product, Finset.mem_range]
    have ha1 := star_pos n
    have ha2 := star_pos (n + 1)
    have ha3 := star_pos (n + 2)
    have e1 : xyz.1 * star n ≤ N := by omega
    have e2 : xyz.2.1 * star (n + 1) ≤ N := by omega
    have e3 : xyz.2.2 * star (n + 2) ≤ N := by omega
    have b1 : xyz.1 ≤ xyz.1 * star n := Nat.le_mul_of_pos_right xyz.1 ha1
    have b2 : xyz.2.1 ≤ xyz.2.1 * star (n + 1) := Nat.le_mul_of_pos_right xyz.2.1 ha2
    have b3 : xyz.2.2 ≤ xyz.2.2 * star (n + 2) := Nat.le_mul_of_pos_right xyz.2.2 ha3
    omega
  have hfin := (Finset.finite_toSet _).subset hsub
  exact hfin.to_subtype

private theorem wS_le_of_rep (n : ℕ) (hn : 6 ≤ n) (N x y z : ℕ)
    (h : x * star n + y * star (n + 1) + z * star (n + 2) = N) :
    wS n hn (N % star n) ≤ N := by
  obtain ⟨y', z', hreg, hle, hmod2⟩ := reduce_to_region n hn y z
  have hW : y' * star (n + 1) + z' * star (n + 2) ∈ W n := by
    rw [mem_W]
    exact ⟨y', z', hreg, rfl⟩
  have h1 : (y * star (n + 1) + z * star (n + 2)) % star n = N % star n := by
    have h2 : (x * star n + (y * star (n + 1) + z * star (n + 2))) % star n =
        (y * star (n + 1) + z * star (n + 2)) % star n := by
      rw [add_comm (x * star n)]
      exact Nat.add_mul_mod_self_right _ _ _
    have h' : x * star n + (y * star (n + 1) + z * star (n + 2)) = N := by
      rw [← add_assoc]
      exact h
    rw [h'] at h2
    exact h2.symm
  have hWN : (y' * star (n + 1) + z' * star (n + 2)) % star n = N % star n :=
    hmod2.trans h1
  have hWNeq := wS_unique n hn (N % star n) (Nat.mod_lt N (star_pos n))
    _ hW hWN
  have htN : y * star (n + 1) + z * star (n + 2) ≤ N := by omega
  omega

private theorem rep_of_le_wS (n : ℕ) (hn : 6 ≤ n) (N : ℕ)
    (hle : wS n hn (N % star n) ≤ N) :
    ∃ x y z : ℕ, x * star n + y * star (n + 1) + z * star (n + 2) = N := by
  have hr : N % star n < star n := Nat.mod_lt N (star_pos n)
  have hmem := (wS_mem n hn (N % star n) hr).1
  rw [mem_W] at hmem
  obtain ⟨y, z, _, hwy⟩ := hmem
  have hme : wS n hn (N % star n) ≡ N [MOD star n] :=
    (wS_mem n hn (N % star n) hr).2
  have hdvd : star n ∣ N - wS n hn (N % star n) :=
    (Nat.modEq_iff_dvd' hle).mp hme
  obtain ⟨q, hq⟩ := hdvd
  have hrw : q * star n = star n * q := mul_comm _ _
  exact ⟨q, y, z, by omega⟩

private theorem gap_iff (n : ℕ) (hn : 6 ≤ n) (N : ℕ) :
    starRepCount n N ≤ 0 ↔ wS n hn (N % star n) > N := by
  constructor
  · intro hle
    by_contra hcon
    push Not at hcon
    obtain ⟨x, y, z, hrep⟩ := rep_of_le_wS n hn N hcon
    unfold starRepCount at hle
    have hcard0 := Nat.eq_zero_of_le_zero hle
    rw [Nat.card_eq_zero] at hcard0
    rcases hcard0 with hempty | hinf
    · exact (not_isEmpty_iff.mpr ⟨⟨(x, y, z), hrep⟩⟩) hempty
    · exact (not_infinite_iff_finite.mpr (triple_finite n N)) hinf
  · intro hgt
    by_contra hcon
    push Not at hcon
    unfold starRepCount at hcon
    have hne0 : ¬ Nat.card {xyz : ℕ × ℕ × ℕ //
        xyz.1 * star n + xyz.2.1 * star (n + 1) + xyz.2.2 * star (n + 2) = N} = 0 := by
      omega
    rw [Nat.card_eq_zero] at hne0
    have hnonempty : Nonempty {xyz : ℕ × ℕ × ℕ //
        xyz.1 * star n + xyz.2.1 * star (n + 1) + xyz.2.2 * star (n + 2) = N} :=
      not_isEmpty_iff.mp (fun h => hne0 (Or.inl h))
    obtain ⟨xyz, hrep⟩ := hnonempty
    have hle := wS_le_of_rep n hn N xyz.1 xyz.2.1 xyz.2.2 hrep
    omega

private noncomputable def F (n : ℕ) (hn : 6 ≤ n) : Finset ℕ :=
  (Finset.range (star n)).biUnion
    (fun r => (Finset.range (cS n hn r)).image (fun t => r + star n * t))

private theorem F_card (n : ℕ) (hn : 6 ≤ n) :
    (F n hn).card = ∑ r ∈ Finset.range (star n), cS n hn r := by
  have hdisj : Set.PairwiseDisjoint ↑(Finset.range (star n))
      (fun r => (Finset.range (cS n hn r)).image (fun t => r + star n * t)) := by
    intro r1 hr1 r2 hr2 hne
    change Disjoint ((Finset.range (cS n hn r1)).image (fun t => r1 + star n * t))
      ((Finset.range (cS n hn r2)).image (fun t => r2 + star n * t))
    rw [Finset.disjoint_left]
    intro N hN1 hN2
    rw [Finset.mem_image] at hN1 hN2
    obtain ⟨t1, _, ht1⟩ := hN1
    obtain ⟨t2, _, ht2⟩ := hN2
    have hr1' : r1 < star n :=
      Finset.mem_range.mp (Finset.mem_coe.mp hr1)
    have hr2' : r2 < star n :=
      Finset.mem_range.mp (Finset.mem_coe.mp hr2)
    have e1 : N % star n = r1 := by
      rw [← ht1, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hr1']
    have e2 : N % star n = r2 := by
      rw [← ht2, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hr2']
    exact hne (e1.symm.trans e2)
  unfold F
  rw [Finset.card_biUnion hdisj]
  apply Finset.sum_congr rfl
  intro r _
  have hinj : Function.Injective (fun t => r + star n * t) := by
    intro t1 t2 h
    dsimp only at h
    have h2 : star n * t1 = star n * t2 := Nat.add_left_cancel h
    exact mul_left_cancel₀ (ne_of_gt (star_pos n)) h2
  rw [Finset.card_image_of_injective _ hinj, Finset.card_range]

private theorem gap_card (n : ℕ) (hn : 6 ≤ n) :
    Nat.card {N : ℕ // starRepCount n N ≤ 0} = (F n hn).card := by
  have hiff : ∀ N : ℕ, starRepCount n N ≤ 0 ↔ N ∈ F n hn := by
    intro N
    rw [gap_iff n hn N]
    unfold F
    simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_range]
    constructor
    · intro hgt
      have hr : N % star n < star n := Nat.mod_lt N (star_pos n)
      refine ⟨N % star n, hr, N / star n, ?_, ?_⟩
      · by_contra hcon
        push Not at hcon
        have hmul := Nat.mul_le_mul_left (star n) hcon
        have hw := wS_eq n hn (N % star n) hr
        have hNd : N % star n + star n * (N / star n) = N := by
          have hdm := Nat.div_add_mod N (star n)
          omega
        omega
      · have hdm := Nat.div_add_mod N (star n)
        omega
    · rintro ⟨r, hr, t, ht, hNt⟩
      have hNr : N % star n = r := by
        rw [← hNt, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hr]
      rw [hNr]
      have hw := wS_eq n hn r hr
      have hmul : star n * t < star n * cS n hn r :=
        Nat.mul_lt_mul_of_pos_left ht (star_pos n)
      omega
  have hequiv : {N : ℕ // starRepCount n N ≤ 0} ≃ ↥(F n hn) :=
    Equiv.subtypeEquiv (Equiv.refl ℕ) (fun N => hiff N)
  rw [Nat.card_congr hequiv, Nat.card_eq_fintype_card, Fintype.card_coe]

private theorem sum_W_reindex (n : ℕ) (hn : 6 ≤ n) :
    ∑ r ∈ Finset.range (star n), wS n hn r = ∑ w ∈ W n, w := by
  apply Finset.sum_bij (fun r _ => wS n hn r)
  · intro r hr
    exact (wS_mem n hn r (Finset.mem_range.mp hr)).1
  · intro r1 hr1 r2 hr2 heq
    have h1 := (wS_mem n hn r1 (Finset.mem_range.mp hr1)).2
    have h2 := (wS_mem n hn r2 (Finset.mem_range.mp hr2)).2
    rw [heq] at h1
    omega
  · intro w hw
    have hr : w % star n < star n := Nat.mod_lt w (star_pos n)
    refine ⟨w % star n, Finset.mem_range.mpr hr, ?_⟩
    exact (wS_unique n hn (w % star n) hr w hw rfl).symm
  · intro r _
    rfl

private theorem sum_W_image (n : ℕ) (hn : 6 ≤ n) :
    ∑ w ∈ W n, w
      = ∑ p ∈ R n, (p.1 * star (n + 1) + p.2 * star (n + 2)) := by
  unfold W
  rw [Finset.sum_image (t_inj_on_R n hn)]

private theorem genus_sum (n : ℕ) (hn : 6 ≤ n) :
    star n * (∑ r ∈ Finset.range (star n), cS n hn r) +
      (∑ r ∈ Finset.range (star n), r) =
      ∑ r ∈ Finset.range (star n), wS n hn r := by
  have h : ∀ r ∈ Finset.range (star n),
      wS n hn r = r + star n * cS n hn r := by
    intro r hr
    exact wS_eq n hn r (Finset.mem_range.mp hr)
  calc star n * (∑ r ∈ Finset.range (star n), cS n hn r) +
        (∑ r ∈ Finset.range (star n), r)
      = (∑ r ∈ Finset.range (star n), r) +
        star n * (∑ r ∈ Finset.range (star n), cS n hn r) := by ring
    _ = ∑ r ∈ Finset.range (star n), (r + star n * cS n hn r) := by
        rw [Finset.sum_add_distrib, Finset.mul_sum]
    _ = ∑ r ∈ Finset.range (star n), wS n hn r :=
        Finset.sum_congr rfl (fun r hr => (h r hr).symm)

private theorem sum_R_eq (n : ℕ) (hn : 6 ≤ n) :
    2 * (∑ p ∈ R n, (p.1 * star (n + 1) + p.2 * star (n + 2))) =
      star (n + 1) * ((2*n+1) * ((2*n+1) * ((2*n+1) - 1)) +
        n * ((2*n-10) * ((2*n-10) - 1))) +
      star (n + 2) * ((2*n+1) * ((2*n+1) * ((2*n+1) - 1)) +
        (2*n-10) * (2*n*(2*n+1) + n*(n-1))) := by
  have hdn : (3*n+1)-(2*n+1) = n := by omega
  have hdisj : Disjoint (Finset.range (2 * n + 1) ×ˢ Finset.range (2 * n + 1))
      (Finset.range (2 * n - 10) ×ˢ Finset.Ico (2 * n + 1) (3 * n + 1)) := by
    rw [Finset.disjoint_left]
    intro p hp1 hp2
    simp only [Finset.mem_product, Finset.mem_range, Finset.mem_Ico] at hp1 hp2
    omega
  have u : (∑ p ∈ R n, (p.1 * star (n + 1) + p.2 * star (n + 2))) =
      (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1),
        (p.1 * star (n + 1) + p.2 * star (n + 2))) +
      (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1),
        (p.1 * star (n + 1) + p.2 * star (n + 2))) := by
    unfold R
    exact Finset.sum_union hdisj
  have p1 : (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1),
        (p.1 * star (n + 1) + p.2 * star (n + 2))) =
      star (n + 1) * (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1), p.1) +
      star (n + 2) * (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1), p.2) := by
    rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.sum_mul]
    ring
  have p2 : (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1),
        (p.1 * star (n + 1) + p.2 * star (n + 2))) =
      star (n + 1) * (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1), p.1) +
      star (n + 2) * (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1), p.2) := by
    rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.sum_mul]
    ring
  have q1y : (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1), p.1) =
      (2*n+1) * (∑ y ∈ Finset.range (2*n+1), y) := by
    simp only [Finset.sum_product, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
      Nat.cast_id]
    exact (Finset.mul_sum _ _ _).symm
  have q1z : (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1), p.2) =
      (2*n+1) * (∑ z ∈ Finset.range (2*n+1), z) := by
    simp only [Finset.sum_product, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
      Nat.cast_id]
  have q2y : (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1), p.1) =
      n * (∑ y ∈ Finset.range (2*n-10), y) := by
    simp only [Finset.sum_product, Finset.sum_const, Nat.card_Ico, nsmul_eq_mul,
      Nat.cast_id, hdn]
    exact (Finset.mul_sum _ _ _).symm
  have q2z : (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1), p.2) =
      (2*n-10) * (∑ z ∈ Finset.Ico (2*n+1) (3*n+1), z) := by
    simp only [Finset.sum_product, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
      Nat.cast_id]
  have rT : (∑ y ∈ Finset.range (2*n+1), y) * 2 = (2*n+1) * ((2*n+1) - 1) :=
    Finset.sum_range_id_mul_two _
  have r1 : (∑ y ∈ Finset.range (2*n-10), y) * 2 = (2*n-10) * ((2*n-10) - 1) :=
    Finset.sum_range_id_mul_two _
  have rd : (∑ j ∈ Finset.range n, j) * 2 = n * (n - 1) :=
    Finset.sum_range_id_mul_two _
  have hic : (∑ z ∈ Finset.Ico (2*n+1) (3*n+1), z) =
      n * (2*n+1) + (∑ j ∈ Finset.range n, j) := by
    rw [Finset.sum_Ico_eq_sum_range, hdn, Finset.sum_add_distrib]
    simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul, Nat.cast_id]
  have hS1y2 : 2 * (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1), p.1) =
      (2*n+1) * ((2*n+1) * ((2*n+1) - 1)) := by
    linear_combination 2 * q1y + (2*n+1) * rT
  have hS1z2 : 2 * (∑ p ∈ Finset.range (2*n+1) ×ˢ Finset.range (2*n+1), p.2) =
      (2*n+1) * ((2*n+1) * ((2*n+1) - 1)) := by
    linear_combination 2 * q1z + (2*n+1) * rT
  have hS2y2 : 2 * (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1), p.1) =
      n * ((2*n-10) * ((2*n-10) - 1)) := by
    linear_combination 2 * q2y + n * r1
  have hS2z2 : 2 * (∑ p ∈ Finset.range (2*n-10) ×ˢ Finset.Ico (2*n+1) (3*n+1), p.2) =
      (2*n-10) * (2*n*(2*n+1) + n*(n-1)) := by
    linear_combination 2 * q2z + (2*(2*n-10)) * hic + (2*n-10) * rd
  linear_combination 2 * u + 2 * p1 + 2 * p2 + star (n+1) * hS1y2 +
    star (n+2) * hS1z2 + star (n+1) * hS2y2 + star (n+2) * hS2z2

private theorem final_identity (n : ℕ) (hn : 6 ≤ n) :
    2 * (star n * (n * (15 * n^2 + 8*n + 7))) + star n * (star n - 1) =
      star (n + 1) * ((2*n+1) * ((2*n+1) * ((2*n+1) - 1)) +
        n * ((2*n-10) * ((2*n-10) - 1))) +
      star (n + 2) * ((2*n+1) * ((2*n+1) * ((2*n+1) - 1)) +
        (2*n-10) * (2*n*(2*n+1) + n*(n-1))) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 6 := ⟨n - 6, by omega⟩
  have e1 : (2*(m+6)+1)-1 = 2*(m+6) := by omega
  have e2 : (2*(m+6)-10)-1 = 2*m+1 := by omega
  have e3 : (m+6)-1 = m+5 := by omega
  have e4 : 2*(m+6)-10 = 2*m+2 := by omega
  have s0 : star (m+6) = 6*(m+6)*(m+5)+1 := rfl
  have s1 : star (m+6+1) = 6*(m+6+1)*(m+6)+1 := rfl
  have s2 : star (m+6+2) = 6*(m+6+2)*(m+6+1)+1 := rfl
  rw [e2, e4, e1, e3, s0, s1, s2]
  have e5 : (6*(m+6)*(m+5)+1)-1 = 6*(m+6)*(m+5) := by omega
  rw [e5]
  ring

/-- **$0$-Sylvester number of three consecutive star numbers.** Write $S_m$ for the $m$-th star
number $6m(m-1)+1$. For every natural number $n \ge 6$, the number of natural numbers that
cannot be written as $x S_n + y S_{n+1} + z S_{n+2}$ with $x, y, z$ natural numbers is
$n(15n^2 + 8n + 7)$.

Source: "On p-Frobenius Numbers for the Numerical Semigroups
Generated by Three Consecutive Star Numbers", Theorem 2. -/
theorem pSylvesterCount_zero_star
    (n : ℕ) (hn : 6 ≤ n) :
    pSylvesterStarCount 0 n =
      n * (15 * n ^ 2 + 8 * n + 7) := by
  unfold pSylvesterStarCount
  rw [gap_card n hn, F_card n hn]
  have hgen := genus_sum n hn
  have hre := sum_W_reindex n hn
  have him := sum_W_image n hn
  have hR := sum_R_eq n hn
  have hrange := Finset.sum_range_id_mul_two (star n)
  have hfin := final_identity n hn
  have h2 : 2 * (star n * (∑ r ∈ Finset.range (star n), cS n hn r)) =
      2 * (star n * (n * (15 * n^2 + 8*n + 7))) := by
    omega
  have h3 : star n * (∑ r ∈ Finset.range (star n), cS n hn r) =
      star n * (n * (15 * n^2 + 8*n + 7)) := by
    omega
  exact Nat.eq_of_mul_eq_mul_left (star_pos n) h3

end MathlibExt.NumberTheory.PFrobeniusStarNumbersWanted
