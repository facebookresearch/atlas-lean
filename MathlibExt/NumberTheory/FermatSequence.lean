module

public import Mathlib.Data.Complex.Basic
public import Mathlib.NumberTheory.Divisors

namespace MetaMathlibExt

@[expose] public section

/-- **Fermat sequence.** Given a sequence $b : \mathbb{N} \to \mathbb{C}$, the Fermat sequence
generated by $b$ is the sequence $a : \mathbb{N} \to \mathbb{C}$ given by
$a_n = \sum_{m \mid n} m \, b_m$ for $n \ge 1$, the sum running over the positive divisors $m$
of $n$, and $a_0 = 0$.

The source defines the sequence only for positive indices; the value $a_0 = 0$ comes from
summing over the empty set of divisors of $0$.

Source: B.-S. Du, S.-S. Huang, and M.-C. Li, *Newton, Fermat, and Exactly Realizable
Sequences*, Journal of Integer Sequences 8 (2005), lines 181–190,
<https://cs.uwaterloo.ca/journals/JIS/VOL8/Huang/huang11.tex>.
Source SHA-256: `e280997f941eb46d98b411cb2d2ff593d284837371b6565cd4efdb1cdaabffdb`.
Concept `jis_term_a7b36e26421828cebf9c3d39`; semantic ID `jis_sem_2f7e63717e4d696b6c09cf8f`.
-/
public def fermatSequence (b : ℕ → ℂ) : ℕ → ℂ :=
  fun n => ∑ m ∈ Nat.divisors n, (m : ℂ) * b m

end

end MetaMathlibExt
