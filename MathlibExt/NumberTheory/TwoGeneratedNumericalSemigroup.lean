module

public import Mathlib.Algebra.Group.Submonoid.Membership

/-!
# Symmetry of two-generated numerical semigroups

Reflection about half the Frobenius number exchanges the gaps and the semigroup elements
between zero and the Frobenius number.
-/

namespace MetaMathlibExt

-- If adding one copy of a generator crosses from a gap into the semigroup, the resulting
-- element must be a multiple of the other generator.
private theorem TwoGeneratedNumericalSemigroup.dvd_of_gap_add_mem {a b n : ℕ}
    (hn : n ∉ AddSubmonoid.closure ({a, b} : Set ℕ))
    (hadd : n + a ∈ AddSubmonoid.closure ({a, b} : Set ℕ)) : b ∣ n + a := by
  obtain ⟨i, j, hij⟩ := (AddSubmonoid.mem_closure_pair a b _).mp hadd
  cases i with
  | zero => exact ⟨j, by simpa [smul_eq_mul, Nat.mul_comm] using hij.symm⟩
  | succ i =>
    apply False.elim (hn ?_)
    refine (AddSubmonoid.mem_closure_pair a b _).mpr ⟨i, j, ?_⟩
    rw [succ_nsmul] at hij
    omega

open TwoGeneratedNumericalSemigroup in
/-- **Two-generated numerical semigroups are symmetric.** Let $a$, $b$ and $F$ be natural numbers
and let $S = \langle a, b \rangle$ be the additive submonoid of $\mathbb{N}$ generated by $a$ and
$b$. If $F \notin S$ and every natural number $n > F$ lies in $S$ (so $F$ is the Frobenius number
of $S$), then $x \in S \iff F - x \notin S$ for every natural number $x \le F$.

The hypotheses on $F$ force $\gcd(a, b) = 1$ and $a, b \ge 2$, so these are exactly the
numerical semigroups of embedding dimension $2$ other than $\mathbb{N}$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 3, part 1 (`integers-2024-G2-prop-3`). -/
public theorem numericalSemigroup_two_generated_symmetric {a b F : ℕ}
    (hF : F ∉ AddSubmonoid.closure ({a, b} : Set ℕ))
    (hF_max : ∀ n, F < n → n ∈ AddSubmonoid.closure ({a, b} : Set ℕ)) :
    ∀ x ≤ F, x ∈ AddSubmonoid.closure ({a, b} : Set ℕ) ↔
      F - x ∉ AddSubmonoid.closure ({a, b} : Set ℕ) := by
  have ha : 0 < a := by
    apply Nat.pos_of_ne_zero
    rintro rfl
    have mem_iff (n : ℕ) : n ∈ AddSubmonoid.closure ({0, b} : Set ℕ) ↔ b ∣ n := by
      rw [AddSubmonoid.closure_insert_zero, AddSubmonoid.mem_closure_singleton]
      exact exists_congr fun k => by simp [smul_eq_mul, Nat.mul_comm, eq_comm]
    have hdvd (n : ℕ) (hn : F < n) : b ∣ n := (mem_iff n).mp (hF_max n hn)
    apply hF <| (mem_iff F).mpr ?_
    exact (Nat.dvd_add_iff_left (hdvd (F + 1) (by omega))).mpr (hdvd _ (by omega))
  have hb : b ∣ F + a := dvd_of_gap_add_mem hF (hF_max _ (by omega))
  let rec reflect (y : ℕ) (hy : y ∉ AddSubmonoid.closure ({a, b} : Set ℕ)) :
      F - y ∈ AddSubmonoid.closure ({a, b} : Set ℕ) := by
    by_cases hnext : y + a ∈ AddSubmonoid.closure ({a, b} : Set ℕ)
    · -- Both F + a and y + a are multiples of b, so their difference belongs.
      obtain ⟨k, hk⟩ : b ∣ F - y := by
        simpa only [Nat.add_sub_add_right] using Nat.dvd_sub hb (dvd_of_gap_add_mem hy hnext)
      exact (AddSubmonoid.mem_closure_pair a b _).mpr
        ⟨0, k, by simpa [smul_eq_mul, Nat.mul_comm] using hk.symm⟩
    · -- Move up to the next gap, then add a back to its reflection.
      have hle : y + a ≤ F := le_of_not_gt fun h => hnext (hF_max _ h)
      rw [show F - y = (F - (y + a)) + a by omega]
      exact add_mem (reflect (y + a) hnext) (AddSubmonoid.subset_closure (by simp))
  termination_by F - y
  decreasing_by omega
  intro x hx
  refine ⟨fun hmem hother => hF (Nat.add_sub_of_le hx ▸ add_mem hmem hother), ?_⟩
  intro hgap
  simpa only [Nat.sub_sub_self hx] using reflect (F - x) hgap

end MetaMathlibExt
