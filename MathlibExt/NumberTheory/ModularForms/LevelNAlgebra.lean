module

public import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
public import Mathlib.NumberTheory.ModularForms.Discriminant
public import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Basic

@[expose] public section

noncomputable section

open Complex UpperHalfPlane

namespace WLight

/-- The period pair attached to a point of the upper half-plane, with
periods `τ` and `1`. -/
def periodPairOfTau (τ : ℍ) : PeriodPair where
  ω₁ := (τ : ℂ)
  ω₂ := 1
  indep := LinearIndependent.pair_iff.mpr fun s t hst ↦ by
    have him : s * (τ : ℂ).im = 0 := by
      have h := congrArg Complex.im hst
      simpa [Complex.add_im, Complex.smul_im, smul_eq_mul] using h
    have hs : s = 0 :=
      (mul_eq_zero.mp him).resolve_right (UpperHalfPlane.coe_im τ ▸ τ.im_ne_zero)
    subst hs
    simpa using hst

@[simp] theorem periodPairOfTau_ω₁ (τ : ℍ) : (periodPairOfTau τ).ω₁ = (τ : ℂ) := rfl

@[simp] theorem periodPairOfTau_ω₂ (τ : ℍ) : (periodPairOfTau τ).ω₂ = 1 := rfl

/-- The level-one modular `j`-function `E₄³ / Δ`. -/
def jFunction : ℍ → ℂ := fun τ => ModularForm.E₄ τ ^ 3 / ModularForm.discriminant τ

theorem jFunction_apply (τ : ℍ) :
    jFunction τ = ModularForm.E₄ τ ^ 3 / ModularForm.discriminant τ := rfl

/-- The normalized Weierstrass `℘`-value at the torsion point determined
by `v : Fin 2 → ZMod N`. -/
def weierstrassTorsion (N : ℕ) [NeZero N] (v : Fin 2 → ZMod N) : ℍ → ℂ :=
  fun τ => ((2 * (Real.pi : ℂ) * Complex.I) ^ 2)⁻¹ *
    PeriodPair.weierstrassP (periodPairOfTau τ)
      ((((v 0).val : ℂ) * (τ : ℂ) + ((v 1).val : ℂ)) / (N : ℂ))

theorem weierstrassTorsion_apply (N : ℕ) [NeZero N] (v : Fin 2 → ZMod N) (τ : ℍ) :
    weierstrassTorsion N v τ = ((2 * (Real.pi : ℂ) * Complex.I) ^ 2)⁻¹ *
      PeriodPair.weierstrassP (periodPairOfTau τ)
        ((((v 0).val : ℂ) * (τ : ℂ) + ((v 1).val : ℂ)) / (N : ℂ)) := rfl

/-- The Fricke function attached to a nonzero torsion label: the
normalized `℘`-value scaled by `-E₄E₆ / (2592Δ)`. -/
def frickeFunction (N : ℕ) [NeZero N] (v : Fin 2 → ZMod N) : ℍ → ℂ :=
  fun τ => -(ModularForm.E₄ τ * ModularForm.E₆ τ / ModularForm.discriminant τ) / 2592 *
    weierstrassTorsion N v τ

theorem frickeFunction_apply (N : ℕ) [NeZero N] (v : Fin 2 → ZMod N) (τ : ℍ) :
    frickeFunction N v τ =
      -(ModularForm.E₄ τ * ModularForm.E₆ τ / ModularForm.discriminant τ) / 2592 *
        weierstrassTorsion N v τ := rfl

/-- The nonzero torsion labels `v : Fin 2 → ZMod N`, whose Fricke functions
generate `levelNAlgebra N`. -/
def nonzeroTorsionLabels (N : ℕ) : Set (Fin 2 → ZMod N) := {v | v ≠ 0}

@[simp] theorem mem_nonzeroTorsionLabels {N : ℕ} {v : Fin 2 → ZMod N} :
    v ∈ nonzeroTorsionLabels N ↔ v ≠ 0 := Iff.rfl

/-- The algebra of level-`N` modular functions generated by the
`j`-function and all Fricke functions at nonzero torsion labels. -/
def levelNAlgebra (N : ℕ) [NeZero N] : Subalgebra ℂ (ℍ → ℂ) :=
  Algebra.adjoin ℂ
    (insert jFunction {g : ℍ → ℂ | ∃ v ∈ nonzeroTorsionLabels N, g = frickeFunction N v})

theorem jFunction_mem_levelNAlgebra (N : ℕ) [NeZero N] :
    jFunction ∈ levelNAlgebra N :=
  Algebra.subset_adjoin (Or.inl rfl)

theorem frickeFunction_mem_levelNAlgebra (N : ℕ) [NeZero N]
    {v : Fin 2 → ZMod N} (hv : v ≠ 0) :
    frickeFunction N v ∈ levelNAlgebra N :=
  Algebra.subset_adjoin (Or.inr ⟨v, hv, rfl⟩)

end WLight

end
