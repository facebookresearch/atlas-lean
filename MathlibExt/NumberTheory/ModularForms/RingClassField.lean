module

public import MathlibExt.Analysis.SpecialFunctions.Elliptic.ComplexMultiplication
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# The ring class field of an imaginary quadratic order

For a period pair `L`, `PeriodPair.jInvariant L` is the $j$-invariant
$1728\, g_2^3 / (g_2^3 - 27\, g_3^2)$ of its lattice. For a subfield $K \subseteq \mathbb{C}$
and a subring $\mathcal{O} \subseteq \mathbb{C}$, `ringClassField K 𝒪` is the subfield of
$\mathbb{C}$ generated over $K$ by the $j$-invariants of the lattices contained in $K$ that are
proper ideals of $\mathcal{O}$; when $K$ is an imaginary quadratic field and $\mathcal{O}$ an
order in $K$ this is the ring class field of $\mathcal{O}$ in the sense of Sutherland.

The source is Andrew V. Sutherland, *18.783 Elliptic Curves*, lecture notes, MIT
OpenCourseWare, Fall 2025, Lecture 15, Definition 15.2, and Lecture 21, Definition 21.3.
-/

@[expose] public section

set_option autoImplicit false

namespace PeriodPair

/-- The $j$-invariant of the lattice of a period pair `L`,

$$j(L) = 1728\, \frac{g_2(L)^3}{g_2(L)^3 - 27\, g_3(L)^2},$$

with `g₂ L = 60 G₄(L)` and `g₃ L = 140 G₆(L)` the Eisenstein invariants of the lattice. The
denominator is the discriminant of the lattice; the definition does not use that it is
nonzero.

Source: Andrew V. Sutherland, *18.783 Elliptic Curves*, lecture notes, MIT OpenCourseWare,
Fall 2025, Lecture 15, Definition 15.2. -/
noncomputable def jInvariant (L : PeriodPair) : ℂ :=
  1728 * L.g₂ ^ 3 / (L.g₂ ^ 3 - 27 * L.g₃ ^ 2)

end PeriodPair

/-- The ring class field of `𝒪` over `K`: the subfield of `ℂ` generated over the subfield `K` by
the $j$-invariants `PeriodPair.jInvariant L` of the period pairs `L` whose lattice is contained in
`K` and is a proper ideal of `𝒪` (`L.IsProperIdeal 𝒪`: its endomorphism ring
$\{\lambda \in \mathbb{C} : \lambda L \subseteq L\}$ is `𝒪`). The definition is made for every
subfield `K` and subring `𝒪`; it is the ring class field of `𝒪` when `K` is an imaginary
quadratic field and `𝒪` an order in `K`.

Source: Andrew V. Sutherland, *18.783 Elliptic Curves*, lecture notes, MIT OpenCourseWare,
Fall 2025, Lecture 21, Definition 21.3 (there, the extension of `K` generated by the
$j$-invariant of an elliptic curve with complex multiplication by `𝒪`; this definition adjoins
all of these $j$-invariants), with Lecture 20, §20.3 (these curves are the tori `ℂ / 𝔟` for the
proper `𝒪`-ideals `𝔟`). -/
noncomputable def ringClassField (K : Subfield ℂ) (𝒪 : Subring ℂ) : IntermediateField K ℂ :=
  IntermediateField.adjoin K
    {x | ∃ L : PeriodPair, L.IsProperIdeal 𝒪 ∧ (L.lattice : Set ℂ) ⊆ K ∧ x = L.jInvariant}

/-- The $j$-invariant of a proper ideal of `𝒪` contained in `K` lies in `ringClassField K 𝒪`.

Source: Andrew V. Sutherland, *18.783 Elliptic Curves*, lecture notes, MIT OpenCourseWare,
Fall 2025, Lecture 21, Definition 21.3. -/
theorem jInvariant_mem_ringClassField {K : Subfield ℂ} {𝒪 : Subring ℂ} {L : PeriodPair}
    (hL : L.IsProperIdeal 𝒪) (hLK : (L.lattice : Set ℂ) ⊆ K) :
    L.jInvariant ∈ ringClassField K 𝒪 :=
  IntermediateField.subset_adjoin K _ ⟨L, hL, hLK, rfl⟩
