/-!
# The Hecke algebra of cusp forms on `Γ₀(N)`

The Hecke operators `T_ℓ` (for primes `ℓ ∤ N`) and `U_q` (for primes `q ∣ N`)
act on cusp forms of weight `k` on `Γ₀(N)` through their `q`-expansion
coefficients. This file proves that these operators commute, defines the
`ℤ`-subalgebra `CuspForm.heckeAlgebra N k S` of `ℂ`-linear endomorphisms
generated by the operators at primes outside `S`, and shows that it is a
commutative ring that preserves the integral lattice of cusp forms in weight
`k ≥ 1`.

## Main declarations

* `ModularForm.coeffHeckeT_comm`, `ModularForm.coeffHeckeT_coeffHeckeU_comm`,
  `ModularForm.coeffHeckeU_comm`: the coefficient operators commute.
* `CuspForm.heckeTLin_comm`, `CuspForm.heckeTLin_heckeULin_comm`,
  `CuspForm.heckeULin_comm`: the Hecke operators on cusp forms commute.
* `CuspForm.heckeAlgebra`: the Hecke algebra away from `S`.
* `CuspForm.mem_intLattice_of_mem_heckeAlgebra`: the Hecke algebra preserves
  the integral lattice in weight `k ≥ 1`.
-/

@[expose] public section

noncomputable section

open UpperHalfPlane
open scoped MatrixGroups ModularForm

namespace ModularForm

private theorem prime_dvd_mul_iff {ℓ q : ℕ} (hℓ : ℓ.Prime) (hℓq : ¬ ℓ ∣ q) (n : ℕ) :
    ℓ ∣ n * q ↔ ℓ ∣ n :=
  ⟨fun h => (hℓ.dvd_mul.mp h).resolve_right hℓq, fun h => h.mul_right q⟩

private theorem not_prime_dvd_prime {ℓ q : ℕ} (hℓ : ℓ.Prime) (hq : q.Prime) (hne : ℓ ≠ q) :
    ¬ ℓ ∣ q :=
  fun h => hne ((Nat.prime_dvd_prime_iff_eq hℓ hq).mp h)

/-- The coefficient operators `U_p` and `U_q` commute. -/
theorem coeffHeckeU_comm (p q : ℕ) (a : ℕ → ℂ) :
    coeffHeckeU p (coeffHeckeU q a) = coeffHeckeU q (coeffHeckeU p a) := by
  funext n
  simp only [coeffHeckeU_apply, mul_right_comm]

/-- The coefficient operators `T_ℓ` and `U_q` commute when the prime `ℓ` does not divide `q`. -/
theorem coeffHeckeT_coeffHeckeU_comm (k : ℤ) {ℓ q : ℕ} (hℓ : ℓ.Prime) (hℓq : ¬ ℓ ∣ q)
    (a : ℕ → ℂ) :
    coeffHeckeT k ℓ (coeffHeckeU q a) = coeffHeckeU q (coeffHeckeT k ℓ a) := by
  funext n
  simp only [coeffHeckeT_apply, coeffHeckeU_apply, prime_dvd_mul_iff hℓ hℓq,
    mul_right_comm n ℓ q]
  split_ifs with h
  · rw [Nat.mul_div_right_comm h]
  · rfl

private theorem coeffHeckeT_coeffHeckeT_apply (k : ℤ) {ℓ ℓ' : ℕ} (hℓ : ℓ.Prime)
    (hℓ' : ℓ'.Prime) (hne : ℓ ≠ ℓ') (a : ℕ → ℂ) (n : ℕ) :
    coeffHeckeT k ℓ (coeffHeckeT k ℓ' a) n =
      a (n * ℓ * ℓ') + (if ℓ' ∣ n then (ℓ' : ℂ) ^ (k - 1) * a (n / ℓ' * ℓ) else 0) +
        (if ℓ ∣ n then (ℓ : ℂ) ^ (k - 1) * a (n / ℓ * ℓ') else 0) +
        (if ℓ ∣ n ∧ ℓ' ∣ n then (ℓ : ℂ) ^ (k - 1) * (ℓ' : ℂ) ^ (k - 1) * a (n / ℓ / ℓ')
          else 0) := by
  have key := prime_dvd_mul_iff hℓ' (not_prime_dvd_prime hℓ' hℓ hne.symm)
  simp only [coeffHeckeT_apply, key]
  by_cases h1 : ℓ ∣ n <;> by_cases h3 : ℓ' ∣ n
  · have h2 : ℓ' ∣ n / ℓ := by
      rw [← Nat.div_mul_cancel h1] at h3
      exact (key _).mp h3
    simp only [ite_eq_left h1, ite_eq_left h3, ite_eq_left h2, ite_eq_left (And.intro h1 h3),
      Nat.mul_div_right_comm h3]
    ring
  · have h2 : ¬ ℓ' ∣ n / ℓ := fun h2 =>
      h3 ((Nat.div_mul_cancel h1) ▸ (key _).mpr h2)
    simp only [ite_eq_left h1, ite_eq_right h3, ite_eq_right h2,
      ite_eq_right (fun h : ℓ ∣ n ∧ ℓ' ∣ n => h3 h.2)]
    ring
  · simp only [ite_eq_right h1, ite_eq_left h3, ite_eq_right (fun h : ℓ ∣ n ∧ ℓ' ∣ n => h1 h.1),
      Nat.mul_div_right_comm h3]
    ring
  · simp only [ite_eq_right h1, ite_eq_right h3, ite_eq_right (fun h : ℓ ∣ n ∧ ℓ' ∣ n => h1 h.1)]
    ring

/-- The coefficient operators `T_ℓ` and `T_ℓ'` commute for primes `ℓ` and `ℓ'`. -/
theorem coeffHeckeT_comm (k : ℤ) {ℓ ℓ' : ℕ} (hℓ : ℓ.Prime) (hℓ' : ℓ'.Prime) (a : ℕ → ℂ) :
    coeffHeckeT k ℓ (coeffHeckeT k ℓ' a) = coeffHeckeT k ℓ' (coeffHeckeT k ℓ a) := by
  rcases eq_or_ne ℓ ℓ' with rfl | hne
  · rfl
  funext n
  rw [coeffHeckeT_coeffHeckeT_apply k hℓ hℓ' hne, coeffHeckeT_coeffHeckeT_apply k hℓ' hℓ hne.symm,
    mul_right_comm n ℓ ℓ', Nat.div_div_eq_div_mul, Nat.div_div_eq_div_mul, mul_comm ℓ ℓ']
  simp only [and_comm (a := ℓ ∣ n)]
  split_ifs <;> ring

private theorem exists_natCast_eq_zpow_sub_one {k : ℤ} (hk : 1 ≤ k) :
    ∃ j : ℕ, k - 1 = (j : ℤ) :=
  ⟨(k - 1).toNat, (Int.toNat_of_nonneg (by omega)).symm⟩

/-- In weight `k ≥ 1`, the coefficient operator `T_p` preserves integral sequences. -/
theorem coeffHeckeT_int (k : ℤ) (hk : 1 ≤ k) (p : ℕ) {a : ℕ → ℂ}
    (ha : ∀ n, ∃ m : ℤ, a n = m) (n : ℕ) : ∃ m : ℤ, coeffHeckeT k p a n = m := by
  obtain ⟨j, hj⟩ := exists_natCast_eq_zpow_sub_one hk
  obtain ⟨m₁, hm₁⟩ := ha (n * p)
  obtain ⟨m₂, hm₂⟩ := ha (n / p)
  rw [coeffHeckeT_apply, hj, zpow_natCast, hm₁, hm₂]
  split_ifs
  · exact ⟨m₁ + (p : ℤ) ^ j * m₂, by push_cast; ring⟩
  · exact ⟨m₁, by simp⟩

/-- The coefficient operator `U_p` preserves integral sequences. -/
theorem coeffHeckeU_int (p : ℕ) {a : ℕ → ℂ} (ha : ∀ n, ∃ m : ℤ, a n = m) (n : ℕ) :
    ∃ m : ℤ, coeffHeckeU p a n = m :=
  ha (n * p)

end ModularForm

namespace CuspForm

open ModularForm ModularFormClass

variable {N : ℕ}

private theorem qCoeff_heckeTLin (k : ℤ) {p : ℕ} (hp : p.Prime) (hpN : ¬ p ∣ N)
    (f : CuspForm (CongruenceSubgroup.Gamma0 N) k) :
    qCoeff ⇑(heckeTLin k hp hpN f) = coeffHeckeT k p (qCoeff ⇑f) := by
  funext n
  rw [coe_heckeTLin_apply]
  exact qCoeff_heckeT f (CongruenceSubgroup.one_mem_strictPeriods_Gamma0 N) hp.ne_zero n

private theorem qCoeff_heckeULin (k : ℤ) {p : ℕ} [NeZero N] (hpN : p ∣ N)
    (f : CuspForm (CongruenceSubgroup.Gamma0 N) k) :
    qCoeff ⇑(heckeULin k hpN f) = coeffHeckeU p (qCoeff ⇑f) := by
  have hp : p ≠ 0 := by
    rintro rfl
    exact NeZero.ne N (Nat.eq_zero_of_zero_dvd hpN)
  funext n
  rw [coe_heckeULin_apply]
  exact qCoeff_heckeU f (CongruenceSubgroup.one_mem_strictPeriods_Gamma0 N) hp n

private theorem ext_qCoeff {k : ℤ} {f g : CuspForm (CongruenceSubgroup.Gamma0 N) k}
    (h : qCoeff ⇑f = qCoeff ⇑g) : f = g := by
  have hΓ := CongruenceSubgroup.one_mem_strictPeriods_Gamma0 N
  have : Fact (IsCusp OnePoint.infty
      ((CongruenceSubgroup.Gamma0 N : Subgroup SL(2, ℤ)) : Subgroup (GL (Fin 2) ℝ))) :=
    ⟨Subgroup.isCusp_of_mem_strictPeriods one_pos hΓ⟩
  have hc : ∀ n, (qExpansion 1 ⇑f).coeff n = (qExpansion 1 ⇑g).coeff n := congrFun h
  refine DFunLike.ext f g fun τ => ?_
  have hf := ModularForm.hasSum_qExpansion one_pos hΓ (f := f) τ
  simp only [hc] at hf
  exact hf.unique (ModularForm.hasSum_qExpansion one_pos hΓ (f := g) τ)

/-- For primes `ℓ` and `ℓ'` that do not divide `N`, the Hecke operators `T_ℓ` and `T_ℓ'` on
cusp forms on `Γ₀(N)` commute. -/
theorem heckeTLin_comm (k : ℤ) {ℓ ℓ' : ℕ} (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓ' : ℓ'.Prime)
    (hℓ'N : ¬ ℓ' ∣ N) : Commute (heckeTLin k hℓ hℓN) (heckeTLin k hℓ' hℓ'N) :=
  LinearMap.ext fun f => ext_qCoeff <| by
    simp only [mul_apply_eq_comp, qCoeff_heckeTLin, coeffHeckeT_comm k hℓ hℓ']

/-- For `N ≠ 0`, a prime `ℓ` that does not divide `N` and any divisor `q` of `N`, prime or not,
the Hecke operators `T_ℓ` and `U_q` on cusp forms on `Γ₀(N)` commute. -/
theorem heckeTLin_heckeULin_comm (k : ℤ) [NeZero N] {ℓ q : ℕ} (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N)
    (hqN : q ∣ N) : Commute (heckeTLin k hℓ hℓN) (heckeULin k hqN) :=
  LinearMap.ext fun f => ext_qCoeff <| by
    simp only [mul_apply_eq_comp, qCoeff_heckeTLin, qCoeff_heckeULin,
      coeffHeckeT_coeffHeckeU_comm k hℓ fun h => hℓN (h.trans hqN)]

/-- For `N ≠ 0` and any divisors `q` and `q'` of `N`, prime or not, the Hecke operators `U_q`
and `U_q'` on cusp forms on `Γ₀(N)` commute. -/
theorem heckeULin_comm (k : ℤ) [NeZero N] {q q' : ℕ} (hqN : q ∣ N) (hq'N : q' ∣ N) :
    Commute (heckeULin k hqN) (heckeULin k hq'N) :=
  LinearMap.ext fun f => ext_qCoeff <| by
    simp only [mul_apply_eq_comp, qCoeff_heckeULin, coeffHeckeU_comm]

section HeckeAlgebra

variable (N : ℕ) [NeZero N] (k : ℤ) (S : Set ℕ)

/-- The Hecke operators `T_ℓ` for primes `ℓ ∤ N` and `U_q` for primes `q ∣ N`,
with `ℓ, q ∉ S`, acting on cusp forms of weight `k` on `Γ₀(N)`. -/
def heckeGenerators : Set (Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) :=
  {T | ∃ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N), ℓ ∉ S ∧ T = heckeTLin k hℓ hℓN} ∪
    {U | ∃ (q : ℕ) (hqN : q ∣ N), q.Prime ∧ q ∉ S ∧ U = heckeULin k hqN}

/-- The Hecke algebra away from `S`, for `N ≠ 0`: the `ℤ`-subalgebra of `ℂ`-linear
endomorphisms of cusp forms of weight `k` on `Γ₀(N)` generated by the Hecke
operators `T_ℓ` at the good primes `ℓ ∉ S`, those not dividing `N`, and `U_q` at
the bad primes `q ∉ S`, those dividing `N`. -/
def heckeAlgebra : Subalgebra ℤ (Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) :=
  Algebra.adjoin ℤ (heckeGenerators N k S)

variable {N k S}

theorem heckeTLin_mem_heckeGenerators {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S) :
    heckeTLin k hℓ hℓN ∈ heckeGenerators N k S :=
  Or.inl ⟨ℓ, hℓ, hℓN, hℓS, rfl⟩

theorem heckeULin_mem_heckeGenerators {q : ℕ} (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S) :
    heckeULin k hqN ∈ heckeGenerators N k S :=
  Or.inr ⟨q, hqN, hq, hqS, rfl⟩

theorem heckeTLin_mem_heckeAlgebra {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S) :
    heckeTLin k hℓ hℓN ∈ heckeAlgebra N k S :=
  Algebra.subset_adjoin (heckeTLin_mem_heckeGenerators hℓ hℓN hℓS)

theorem heckeULin_mem_heckeAlgebra {q : ℕ} (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S) :
    heckeULin k hqN ∈ heckeAlgebra N k S :=
  Algebra.subset_adjoin (heckeULin_mem_heckeGenerators hq hqN hqS)

theorem heckeGenerators_mono {S S' : Set ℕ} (h : S ⊆ S') :
    heckeGenerators N k S' ⊆ heckeGenerators N k S := by
  rintro T (⟨ℓ, hℓ, hℓN, hℓS, rfl⟩ | ⟨q, hqN, hq, hqS, rfl⟩)
  · exact heckeTLin_mem_heckeGenerators hℓ hℓN fun hS => hℓS (h hS)
  · exact heckeULin_mem_heckeGenerators hq hqN fun hS => hqS (h hS)

theorem heckeAlgebra_mono {S S' : Set ℕ} (h : S ⊆ S') :
    heckeAlgebra N k S' ≤ heckeAlgebra N k S :=
  Algebra.adjoin_mono (heckeGenerators_mono h)

theorem commute_of_mem_heckeGenerators
    {T T' : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)}
    (hT : T ∈ heckeGenerators N k S) (hT' : T' ∈ heckeGenerators N k S) : Commute T T' := by
  rcases hT with ⟨ℓ, hℓ, hℓN, -, rfl⟩ | ⟨q, hqN, -, -, rfl⟩ <;>
    rcases hT' with ⟨ℓ', hℓ', hℓ'N, -, rfl⟩ | ⟨q', hq'N, -, -, rfl⟩
  · exact heckeTLin_comm k hℓ hℓN hℓ' hℓ'N
  · exact heckeTLin_heckeULin_comm k hℓ hℓN hq'N
  · exact (heckeTLin_heckeULin_comm k hℓ' hℓ'N hqN).symm
  · exact heckeULin_comm k hqN hq'N

variable (N k S)

instance heckeAlgebra.instIsMulCommutative : IsMulCommutative (heckeAlgebra N k S) :=
  Algebra.isMulCommutative_adjoin ℤ fun _ hT _ hT' _ => commute_of_mem_heckeGenerators hT hT'

open scoped IsMulCommutative in
instance heckeAlgebra.instCommRing : CommRing (heckeAlgebra N k S) := inferInstance

instance heckeAlgebra.instIsAddTorsionFree : IsAddTorsionFree (heckeAlgebra N k S) where
  eq_of_nsmul_eq_nsmul_of_addCommute n hn a b _ hab := by
    apply Subtype.ext
    have h : (n : ℂ) • (a : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) =
        (n : ℂ) • (b : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) := by
      simp only [Nat.cast_smul_eq_nsmul]
      exact congrArg Subtype.val hab
    exact smul_right_injective _ (Nat.cast_ne_zero.mpr hn) h

variable {N k S}

/-- For a prime `ℓ ∉ S` that does not divide `N`, the Hecke operator `T_ℓ` as an element of
the Hecke algebra away from `S`. -/
def heckeAlgebra.T {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S) :
    heckeAlgebra N k S :=
  ⟨heckeTLin k hℓ hℓN, heckeTLin_mem_heckeAlgebra hℓ hℓN hℓS⟩

/-- For a prime `q ∉ S` that divides `N`, the Hecke operator `U_q` as an element of the Hecke
algebra away from `S`. -/
def heckeAlgebra.U {q : ℕ} (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S) : heckeAlgebra N k S :=
  ⟨heckeULin k hqN, heckeULin_mem_heckeAlgebra hq hqN hqS⟩

@[simp] theorem heckeAlgebra.coe_T {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S) :
    ((heckeAlgebra.T hℓ hℓN hℓS : heckeAlgebra N k S) :
      Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) = heckeTLin k hℓ hℓN := rfl

@[simp] theorem heckeAlgebra.coe_U {q : ℕ} (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S) :
    ((heckeAlgebra.U hq hqN hqS : heckeAlgebra N k S) :
      Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) = heckeULin k hqN := rfl

end HeckeAlgebra

section IntegralLattice

private theorem mem_intLattice_iff_qCoeff {k : ℤ} (f : CuspForm (CongruenceSubgroup.Gamma0 N) k) :
    f ∈ intLattice N k ↔ ∀ n : ℕ, ∃ m : ℤ, qCoeff ⇑f n = (m : ℂ) :=
  mem_intLattice_iff f

/-- In weight `k ≥ 1` and for `p ≠ 0`, if `f` lies in the integral lattice and the Hecke sum
`heckeT k p ⇑f` is the underlying function of a cusp form `g` on `Γ₀(N)`, then `g` lies in the
integral lattice. For a prime `p ∤ N`, the bundled operator `heckeTLin` gives such a `g`. -/
theorem mem_intLattice_of_coe_eq_heckeT {k : ℤ} (hk : 1 ≤ k) {p : ℕ} (hp : p ≠ 0)
    {f g : CuspForm (CongruenceSubgroup.Gamma0 N) k} (hg : ⇑g = heckeT k p ⇑f)
    (hf : f ∈ intLattice N k) : g ∈ intLattice N k := by
  rw [mem_intLattice_iff_qCoeff] at hf ⊢
  intro n
  obtain ⟨m, hm⟩ := coeffHeckeT_int k hk p hf n
  exact ⟨m, by
    rw [hg, qCoeff_heckeT f (CongruenceSubgroup.one_mem_strictPeriods_Gamma0 N) hp n, hm]⟩

/-- For `p ≠ 0`, if `f` lies in the integral lattice and the Hecke sum `heckeU k p ⇑f` is the
underlying function of a cusp form `g` on `Γ₀(N)`, then `g` lies in the integral lattice. For
`p ∣ N` with `N ≠ 0`, the bundled operator `heckeULin` gives such a `g`. -/
theorem mem_intLattice_of_coe_eq_heckeU {k : ℤ} {p : ℕ} (hp : p ≠ 0)
    {f g : CuspForm (CongruenceSubgroup.Gamma0 N) k} (hg : ⇑g = heckeU k p ⇑f)
    (hf : f ∈ intLattice N k) : g ∈ intLattice N k := by
  rw [mem_intLattice_iff_qCoeff] at hf ⊢
  intro n
  obtain ⟨m, hm⟩ := coeffHeckeU_int p hf n
  exact ⟨m, by
    rw [hg, qCoeff_heckeU f (CongruenceSubgroup.one_mem_strictPeriods_Gamma0 N) hp n, hm]⟩

/-- In weight `k ≥ 1`, every element of the Hecke algebra preserves the
integral lattice of cusp forms. -/
theorem mem_intLattice_of_mem_heckeAlgebra [NeZero N] {k : ℤ} (hk : 1 ≤ k) {S : Set ℕ}
    {t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)}
    (ht : t ∈ heckeAlgebra N k S) {f : CuspForm (CongruenceSubgroup.Gamma0 N) k}
    (hf : f ∈ intLattice N k) : t f ∈ intLattice N k := by
  revert f
  refine Algebra.adjoin_induction
    (p := fun t _ => ∀ {f}, f ∈ intLattice N k → t f ∈ intLattice N k) ?_ ?_ ?_ ?_ ht
  · rintro x (⟨ℓ, hℓ, hℓN, -, rfl⟩ | ⟨q, hqN, hq, -, rfl⟩) f hf
    · exact mem_intLattice_of_coe_eq_heckeT hk hℓ.ne_zero (coe_heckeTLin_apply k hℓ hℓN f) hf
    · exact mem_intLattice_of_coe_eq_heckeU hq.ne_zero (coe_heckeULin_apply k hqN f) hf
  · intro r f hf
    rw [Algebra.algebraMap_eq_smul_one, LinearMap.smul_apply, one_apply_eq_self]
    exact (intLattice N k).smul_mem r hf
  · intro x y _ _ hx hy f hf
    rw [LinearMap.add_apply]
    exact add_mem (hx hf) (hy hf)
  · intro x y _ _ hx hy f hf
    rw [mul_apply_eq_comp]
    exact hx (hy hf)

end IntegralLattice

