/-!
# Structure of the level-`N` algebra of modular functions

For `N ≠ 0`, `WLight.levelNAlgebra N` is the `ℂ`-algebra of functions on the upper half-plane
generated by the `j`-function and the Fricke functions `f_v` at the nonzero torsion labels
`v : Fin 2 → ZMod N`. This file proves:

* `WLight.frickeFunction_labelVecMul_eq_iff`: `γ ∈ SL(2, ℤ)` fixes every Fricke function at a
  nonzero label (acting on labels by `v ↦ v γ`) iff `γ` or `-γ` lies in `Γ(N)`;
* `WLight.exists_polynomial_jFunction_of_invariant_ratio`: if `a, b ∈ levelNAlgebra N`, `b ≠ 0`
  and `a / b` is `SL(2, ℤ)`-invariant, then `a / b = p(j) / q(j)` for polynomials `p, q`, `q ≠ 0`;
* `WLight.exists_monic_relation_frickeFunction`: each `f_v`, `v ≠ 0`, is integral over `ℂ[j]`;
* `WLight.polynomial_eq_zero_of_eval_jFunction_eq_zero`: `j` is transcendental over `ℂ`;
* `WLight.mdifferentiable_of_mem_levelNAlgebra` and
  `WLight.eq_zero_or_eq_zero_of_mul_eq_zero_of_mem_levelNAlgebra`: the algebra consists of
  holomorphic functions and has no zero divisors;
* `WLight.levelN_structure_package`: all of the above in one statement.
-/

@[expose] public section

noncomputable section

open Complex UpperHalfPlane

open scoped MatrixGroups Manifold ModularForm

namespace WLight

/-- The right action of `SL(2, ℤ)` on torsion labels: `v ↦ v γ`, with `γ` reduced mod `N`. -/
def labelVecMul (N : ℕ) (v : Fin 2 → ZMod N) (γ : SL(2, ℤ)) : Fin 2 → ZMod N :=
  Matrix.vecMul v ((γ : Matrix (Fin 2) (Fin 2) ℤ).map ((↑) : ℤ → ZMod N))

theorem labelVecMul_apply (N : ℕ) (v : Fin 2 → ZMod N) (γ : SL(2, ℤ)) (i : Fin 2) :
    labelVecMul N v γ i = v 0 * (γ 0 i : ℤ) + v 1 * (γ 1 i : ℤ) := by
  simp [labelVecMul, Matrix.vecMul, dotProduct, Fin.sum_univ_two, Matrix.map_apply]

@[simp] theorem labelVecMul_one (N : ℕ) (v : Fin 2 → ZMod N) : labelVecMul N v 1 = v := by
  simp [labelVecMul]

theorem labelVecMul_mul (N : ℕ) (v : Fin 2 → ZMod N) (γ δ : SL(2, ℤ)) :
    labelVecMul N v (γ * δ) = labelVecMul N (labelVecMul N v γ) δ := by
  have hmap : ((γ * δ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ).map ((↑) : ℤ → ZMod N) =
      (γ : Matrix (Fin 2) (Fin 2) ℤ).map ((↑) : ℤ → ZMod N) *
        (δ : Matrix (Fin 2) (Fin 2) ℤ).map ((↑) : ℤ → ZMod N) := by
    rw [Matrix.SpecialLinearGroup.coe_mul]
    exact Matrix.map_mul (f := Int.castRingHom (ZMod N))
  simp only [labelVecMul, hmap, Matrix.vecMul_vecMul]

@[simp] theorem labelVecMul_zero (N : ℕ) (γ : SL(2, ℤ)) : labelVecMul N 0 γ = 0 := by
  funext i; simp [labelVecMul_apply]

theorem labelVecMul_ne_zero {N : ℕ} {v : Fin 2 → ZMod N} (hv : v ≠ 0) (γ : SL(2, ℤ)) :
    labelVecMul N v γ ≠ 0 := by
  intro h
  apply hv
  have := congrArg (fun w ↦ labelVecMul N w γ⁻¹) h
  simpa [← labelVecMul_mul] using this

section Aux

variable {N : ℕ} [NeZero N]

private theorem periodPairOfTau_periods :
    ∀ τ : ℍ, (periodPairOfTau τ).ω₁ = (τ : ℂ) ∧ (periodPairOfTau τ).ω₂ = 1 :=
  fun _ ↦ ⟨rfl, rfl⟩

private theorem frickeFunction_smul' (v : Fin 2 → ZMod N) (γ : SL(2, ℤ)) (τ : ℍ) :
    frickeFunction N v (γ • τ) = frickeFunction N (labelVecMul N v γ) τ :=
  ModularForm.frickeFunction_smul N periodPairOfTau periodPairOfTau_periods
    (weierstrassTorsion N) (fun _ _ ↦ rfl) (frickeFunction N) (fun _ _ ↦ rfl) v γ τ

private theorem frickeFunction_smul_of_mem_Gamma' (v : Fin 2 → ZMod N) {γ : SL(2, ℤ)}
    (hγ : γ ∈ CongruenceSubgroup.Gamma N) (τ : ℍ) :
    frickeFunction N v (γ • τ) = frickeFunction N v τ :=
  ModularForm.frickeFunction_smul_of_mem_Gamma N periodPairOfTau periodPairOfTau_periods
    (weierstrassTorsion N) (fun _ _ ↦ rfl) (frickeFunction N) (fun _ _ ↦ rfl) v hγ τ

private theorem mdifferentiable_frickeFunction' {v : Fin 2 → ZMod N} (hv : v ≠ 0) :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) (frickeFunction N v) :=
  ModularForm.mdifferentiable_frickeFunction N periodPairOfTau periodPairOfTau_periods
    (weierstrassTorsion N) (fun _ _ ↦ rfl) (frickeFunction N) (fun _ _ ↦ rfl) hv

private theorem eq_or_eq_neg_of_frickeFunction_eq' {v w : Fin 2 → ZMod N} (hv : v ≠ 0)
    (hw : w ≠ 0) (h : frickeFunction N v = frickeFunction N w) : w = v ∨ w = -v :=
  ModularForm.eq_or_eq_neg_of_frickeFunction_eq N periodPairOfTau periodPairOfTau_periods
    (weierstrassTorsion N) (fun _ _ ↦ rfl) (frickeFunction N) (fun _ _ ↦ rfl) hv hw h

private theorem jFunction_poleBounded :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) jFunction ∧
      ∃ m : ℕ, IsBoundedAtImInfty (jFunction * ModularForm.discriminant ^ m) :=
  (ModularForm.frickeFunction_orbit_package 1 periodPairOfTau periodPairOfTau_periods
    (weierstrassTorsion 1) (fun _ _ ↦ rfl) (frickeFunction 1) (fun _ _ ↦ rfl) jFunction
    (fun _ ↦ rfl)).1

private theorem frickeFunction_poleBounded {v : Fin 2 → ZMod N} (hv : v ≠ 0) :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) (frickeFunction N v) ∧
      ∃ m : ℕ, IsBoundedAtImInfty (frickeFunction N v * ModularForm.discriminant ^ m) :=
  (ModularForm.frickeFunction_orbit_package N periodPairOfTau periodPairOfTau_periods
    (weierstrassTorsion N) (fun _ _ ↦ rfl) (frickeFunction N) (fun _ _ ↦ rfl) jFunction
    (fun _ ↦ rfl)).2.1 v hv

private theorem frickeFunction_relation :
    ∃ P : ℕ → Polynomial ℂ, ∀ v : Fin 2 → ZMod N, v ≠ 0 → ∀ τ : ℍ,
      frickeFunction N v τ ^ (N ^ 2 - 1) + ∑ k ∈ Finset.range (N ^ 2 - 1),
        (P k).eval (jFunction τ) * frickeFunction N v τ ^ k = 0 := by
  obtain ⟨P, -, hP⟩ := (ModularForm.frickeFunction_orbit_package N periodPairOfTau
    periodPairOfTau_periods (weierstrassTorsion N) (fun _ _ ↦ rfl) (frickeFunction N)
    (fun _ _ ↦ rfl) jFunction (fun _ ↦ rfl)).2.2
  exact ⟨P, hP⟩

private theorem jFunction_surjective : Function.Surjective jFunction :=
  ModularForm.levelOne_hauptmodul_package.2.2.1

private theorem mdifferentiable_jFunction : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) jFunction :=
  jFunction_poleBounded.1

/-! ### `Γ(N)` and `±Γ(N)` from the label action -/

private theorem mem_Gamma_or_neg_mem_of_labelVecMul (γ : SL(2, ℤ))
    (h : ∀ a : Fin 2 → ZMod N, a ≠ 0 → labelVecMul N a γ = a ∨ labelVecMul N a γ = -a) :
    γ ∈ CongruenceSubgroup.Gamma N ∨ -γ ∈ CongruenceSubgroup.Gamma N := by
  rcases Nat.lt_or_ge 1 N with hN | hN
  · have : Fact (1 < N) := ⟨hN⟩
    have h10 : (1 : ZMod N) ≠ 0 := one_ne_zero
    have r1 := h ![1, 0] (fun e ↦ h10 (by simpa using congrFun e 0))
    have r2 := h ![0, 1] (fun e ↦ h10 (by simpa using congrFun e 1))
    have r3 := h ![1, 1] (fun e ↦ h10 (by simpa using congrFun e 0))
    simp only [funext_iff, Fin.forall_fin_two, labelVecMul_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, one_mul, zero_mul, add_zero, zero_add,
      Pi.neg_apply, neg_zero] at r1 r2 r3
    have e01 : ((γ 0 1 : ℤ) : ZMod N) = 0 := by rcases r1 with ⟨_, e⟩ | ⟨_, e⟩ <;> exact e
    have e10 : ((γ 1 0 : ℤ) : ZMod N) = 0 := by rcases r2 with ⟨e, _⟩ | ⟨e, _⟩ <;> exact e
    have e0011 : ((γ 0 0 : ℤ) : ZMod N) = ((γ 1 1 : ℤ) : ZMod N) := by
      rcases r3 with ⟨c1, c2⟩ | ⟨c1, c2⟩ <;>
        (rw [e10, add_zero] at c1; rw [e01, zero_add] at c2; rw [c1, c2])
    rw [CongruenceSubgroup.Gamma_mem, CongruenceSubgroup.Gamma_mem]
    simp only [Matrix.SpecialLinearGroup.coe_neg, Matrix.neg_apply, Int.cast_neg, neg_eq_zero]
    rcases r1 with ⟨a1, _⟩ | ⟨a1, _⟩
    · left; exact ⟨a1, e01, e10, by rw [← e0011]; exact a1⟩
    · right; exact ⟨by rw [a1, neg_neg], e01, e10, by rw [← e0011, a1, neg_neg]⟩
  · have : N = 1 := by have := NeZero.ne N; omega
    subst this
    left
    simp [CongruenceSubgroup.Gamma_one_top]

/-! ### Pole-bounded holomorphic functions -/

private def PoleBounded (f : ℍ → ℂ) : Prop :=
  MDifferentiable 𝓘(ℂ) 𝓘(ℂ) f ∧ ∃ m : ℕ, IsBoundedAtImInfty (f * ModularForm.discriminant ^ m)

private theorem isBoundedAtImInfty_discPow (n : ℕ) :
    IsBoundedAtImInfty (ModularForm.discriminant ^ n : ℍ → ℂ) := by
  rw [← CuspForm.coe_discriminant]
  induction n with
  | zero => exact pow_zero (⇑CuspForm.discriminant : ℍ → ℂ) ▸ Filter.const_boundedAtFilter _ (1 : ℂ)
  | succ k ih =>
    rw [pow_succ]
    exact ih.mul (CuspFormClass.zero_at_infty CuspForm.discriminant).boundedAtFilter

private theorem isBoundedAtImInfty_mul_discPow_mono {f : ℍ → ℂ} {m m' : ℕ} (hm : m ≤ m')
    (h : IsBoundedAtImInfty (f * ModularForm.discriminant ^ m)) :
    IsBoundedAtImInfty (f * ModularForm.discriminant ^ m') := by
  have hshape : (f * ModularForm.discriminant ^ m' : ℍ → ℂ) =
      (f * ModularForm.discriminant ^ m) * ModularForm.discriminant ^ (m' - m) := by
    funext τ
    simp only [Pi.mul_apply, Pi.pow_apply]
    rw [mul_assoc, ← pow_add, Nat.add_sub_cancel' hm]
  rw [hshape]
  exact h.mul (isBoundedAtImInfty_discPow (m' - m))

private theorem poleBounded_of_mem_adjoin {S : Set (ℍ → ℂ)} (hS : ∀ f ∈ S, PoleBounded f)
    {a : ℍ → ℂ} (ha : a ∈ Algebra.adjoin ℂ S) : PoleBounded a := by
  induction ha using Algebra.adjoin_induction with
  | mem f hf => exact hS f hf
  | algebraMap r =>
    refine ⟨mdifferentiable_const, 0, ?_⟩
    have hshape : ((algebraMap ℂ (ℍ → ℂ) r) * ModularForm.discriminant ^ 0 : ℍ → ℂ) =
        fun _ ↦ r := by
      funext τ
      simp
    rw [hshape]
    exact Filter.const_boundedAtFilter _ r
  | add f g _ _ hf hg =>
    obtain ⟨hf1, m1, hf2⟩ := hf
    obtain ⟨hg1, m2, hg2⟩ := hg
    refine ⟨hf1.add hg1, max m1 m2, ?_⟩
    rw [add_mul]
    exact (isBoundedAtImInfty_mul_discPow_mono (le_max_left _ _) hf2).add
      (isBoundedAtImInfty_mul_discPow_mono (le_max_right _ _) hg2)
  | mul f g _ _ hf hg =>
    obtain ⟨hf1, m1, hf2⟩ := hf
    obtain ⟨hg1, m2, hg2⟩ := hg
    refine ⟨hf1.mul hg1, m1 + m2, ?_⟩
    have hshape : ((f * g) * ModularForm.discriminant ^ (m1 + m2) : ℍ → ℂ) =
        (f * ModularForm.discriminant ^ m1) * (g * ModularForm.discriminant ^ m2) := by
      funext τ
      simp only [Pi.mul_apply, Pi.pow_apply, pow_add]
      ring
    rw [hshape]
    exact hf2.mul hg2

/-! ### The generators -/

private def levelGen (N : ℕ) [NeZero N] : Set (ℍ → ℂ) :=
  insert jFunction {g : ℍ → ℂ | ∃ v ∈ nonzeroTorsionLabels N, g = frickeFunction N v}

private theorem levelNAlgebra_eq : levelNAlgebra N = Algebra.adjoin ℂ (levelGen N) := rfl

private theorem levelGen_poleBounded : ∀ f ∈ levelGen N, PoleBounded f := by
  rintro f (rfl | ⟨v, hv, rfl⟩)
  · exact jFunction_poleBounded
  · exact frickeFunction_poleBounded hv

private theorem eq_polynomial_jFunction_of_invariant {a : ℍ → ℂ} (ha : a ∈ levelNAlgebra N)
    (hinv : ∀ γ : SL(2, ℤ), a ∣[(0 : ℤ)] γ = a) :
    ∃ P : Polynomial ℂ, a = fun τ ↦ Polynomial.eval (jFunction τ) P := by
  obtain ⟨hhol, m, hbd⟩ := poleBounded_of_mem_adjoin levelGen_poleBounded ha
  obtain ⟨P, -, hP⟩ := ModularForm.levelOne_hauptmodul_package.1 m a hhol hinv hbd
  exact ⟨P, hP⟩

/-! ### Holomorphic functions on `ℍ` -/

private theorem holo_eq_zero_or_eq_zero_of_mul_eq_zero {f g : ℍ → ℂ}
    (hf : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) f) (hg : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) g) (h : f * g = 0) :
    f = 0 ∨ g = 0 := by
  rw [UpperHalfPlane.mdifferentiable_iff] at hf hg
  have hU : IsOpen {z : ℂ | 0 < z.im} := isOpen_upperHalfPlaneSet
  have key := AnalyticOnNhd.eq_zero_or_eq_zero_of_mul_eq_zero (hf.analyticOnNhd hU)
    (hg.analyticOnNhd hU) (fun z hz ↦ by
      have := congrFun h (ofComplex z)
      simpa using this) (convex_halfSpace_im_gt 0).isPreconnected
  rcases key with k | k
  · left; funext τ; simpa [ofComplex_apply] using k (τ : ℂ) τ.im_pos
  · right; funext τ; simpa [ofComplex_apply] using k (τ : ℂ) τ.im_pos

private theorem mdifferentiable_of_mem_levelNAlgebra' {F : ℍ → ℂ} (hF : F ∈ levelNAlgebra N) :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) F :=
  (poleBounded_of_mem_adjoin levelGen_poleBounded hF).1

/-! ### The `SL(2, ℤ)`-action on functions and on the level ring -/

private local instance slFnAction : MulSemiringAction SL(2, ℤ) (ℍ → ℂ) where
  smul γ f := fun τ ↦ f (γ⁻¹ • τ)
  one_smul f := by funext τ; change f ((1 : SL(2, ℤ))⁻¹ • τ) = f τ; rw [inv_one, one_smul]
  mul_smul γ δ f := by
    funext τ
    change f ((γ * δ)⁻¹ • τ) = f (δ⁻¹ • (γ⁻¹ • τ))
    rw [mul_inv_rev, mul_smul]
  smul_zero _ := rfl
  smul_add _ _ _ := rfl
  smul_one _ := rfl
  smul_mul _ _ _ := rfl

private theorem sl_smul_apply (γ : SL(2, ℤ)) (f : ℍ → ℂ) (τ : ℍ) :
    (γ • f) τ = f (γ⁻¹ • τ) := rfl

private theorem sl_smul_def (γ : SL(2, ℤ)) (f : ℍ → ℂ) : γ • f = fun τ ↦ f (γ⁻¹ • τ) := rfl

private local instance slFn_smulCommClass : SMulCommClass SL(2, ℤ) ℂ (ℍ → ℂ) where
  smul_comm _ _ _ := rfl

private theorem jFunction_smul_eq (γ : SL(2, ℤ)) (τ : ℍ) : jFunction (γ • τ) = jFunction τ := by
  have hγ : (Matrix.SpecialLinearGroup.mapGL ℝ γ : GL (Fin 2) ℝ) ∈ 𝒮ℒ := ⟨γ, rfl⟩
  have h4 := SlashInvariantForm.slash_action_eqn'' ModularForm.E₄ hγ τ
  have hΔ := SlashInvariantForm.slash_action_eqn'' CuspForm.discriminant hγ τ
  rw [CuspForm.coe_discriminant] at hΔ
  rw [show (Matrix.SpecialLinearGroup.mapGL ℝ γ) • τ = γ • τ from rfl] at h4 hΔ
  have hd := UpperHalfPlane.denom_ne_zero (Matrix.SpecialLinearGroup.mapGL ℝ γ) τ
  have hΔ0 : ModularForm.discriminant τ ≠ 0 := ModularForm.discriminant_ne_zero τ
  rw [jFunction_apply, jFunction_apply, h4, hΔ]
  field_simp

private theorem smul_jFunction (γ : SL(2, ℤ)) : γ • jFunction = jFunction := by
  funext τ; rw [sl_smul_apply, jFunction_smul_eq]

private theorem smul_frickeFunction (γ : SL(2, ℤ)) (v : Fin 2 → ZMod N) :
    γ • frickeFunction N v = frickeFunction N (labelVecMul N v γ⁻¹) := by
  funext τ; rw [sl_smul_apply, frickeFunction_smul']

private theorem smul_mem_levelGen (γ : SL(2, ℤ)) {f : ℍ → ℂ} (hf : f ∈ levelGen N) :
    γ • f ∈ levelGen N := by
  rcases hf with rfl | ⟨v, hv, rfl⟩
  · rw [smul_jFunction]; exact Set.mem_insert _ _
  · rw [smul_frickeFunction]
    exact Set.mem_insert_of_mem _ ⟨_, labelVecMul_ne_zero hv γ⁻¹, rfl⟩

private theorem smul_mem_levelNAlgebra (γ : SL(2, ℤ)) {f : ℍ → ℂ}
    (hf : f ∈ levelNAlgebra N) : γ • f ∈ levelNAlgebra N := by
  rw [levelNAlgebra_eq] at hf ⊢
  induction hf using Algebra.adjoin_induction with
  | mem x hx => exact Algebra.subset_adjoin (smul_mem_levelGen γ hx)
  | algebraMap c =>
    rw [Algebra.algebraMap_eq_smul_one, smul_comm, smul_one]
    exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) _
  | add x y _ _ hx hy => rw [smul_add]; exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => rw [smul_mul']; exact Subalgebra.mul_mem _ hx hy

private local instance levelRingAction (N : ℕ) [NeZero N] :
    MulSemiringAction SL(2, ℤ) ↥(levelNAlgebra N) where
  smul γ f := ⟨γ • f.1, smul_mem_levelNAlgebra γ f.2⟩
  one_smul f := Subtype.ext (one_smul _ f.1)
  mul_smul γ δ f := Subtype.ext (mul_smul γ δ f.1)
  smul_zero γ := Subtype.ext (smul_zero γ)
  smul_add γ f g := Subtype.ext (smul_add γ f.1 g.1)
  smul_one γ := Subtype.ext (smul_one γ)
  smul_mul γ f g := Subtype.ext (smul_mul' γ f.1 g.1)

private theorem levelRing_coe_smul (γ : SL(2, ℤ)) (f : ↥(levelNAlgebra N)) :
    ((γ • f : ↥(levelNAlgebra N)) : ℍ → ℂ) = γ • (f : ℍ → ℂ) := rfl

private local instance levelRing_smulCommClass (N : ℕ) [NeZero N] :
    SMulCommClass SL(2, ℤ) ℂ ↥(levelNAlgebra N) where
  smul_comm _ _ _ := rfl

private local instance levelRing_isDomain (N : ℕ) [NeZero N] : IsDomain ↥(levelNAlgebra N) := by
  have : NoZeroDivisors ↥(levelNAlgebra N) := ⟨fun {f g} h ↦ by
    rcases holo_eq_zero_or_eq_zero_of_mul_eq_zero (mdifferentiable_of_mem_levelNAlgebra' f.2)
      (mdifferentiable_of_mem_levelNAlgebra' g.2) (congrArg Subtype.val h) with e | e
    · exact Or.inl (Subtype.ext e)
    · exact Or.inr (Subtype.ext e)⟩
  have : Nontrivial ↥(levelNAlgebra N) :=
    ⟨⟨0, 1, fun h ↦ zero_ne_one (congrFun (congrArg Subtype.val h) UpperHalfPlane.I)⟩⟩
  exact NoZeroDivisors.to_isDomain _

/-! ### The finite quotient acting on the level ring and its fraction field -/

private def levelFixer (N : ℕ) [NeZero N] : Subgroup SL(2, ℤ) :=
  (MulSemiringAction.toAlgAut SL(2, ℤ) ℂ ↥(levelNAlgebra N)).ker

private local instance levelFixer_normal (N : ℕ) [NeZero N] : (levelFixer N).Normal :=
  MonoidHom.normal_ker _

private theorem Gamma_le_levelFixer : CongruenceSubgroup.Gamma N ≤ levelFixer N := by
  intro γ hγ
  rw [levelFixer, MonoidHom.mem_ker]
  ext ⟨f, hf⟩ : 2
  change γ • f = f
  rw [levelNAlgebra_eq] at hf
  induction hf using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with rfl | ⟨v, -, rfl⟩
    · exact smul_jFunction γ
    · funext τ
      rw [sl_smul_apply]
      exact frickeFunction_smul_of_mem_Gamma' v (inv_mem hγ) τ
  | algebraMap c => rfl
  | add x y _ _ hx hy => rw [smul_add, hx, hy]
  | mul x y _ _ hx hy => rw [smul_mul', hx, hy]

private local instance levelFixer_finiteIndex (N : ℕ) [NeZero N] : (levelFixer N).FiniteIndex :=
  Subgroup.finiteIndex_of_le Gamma_le_levelFixer

private abbrev LevelGrp (N : ℕ) [NeZero N] : Type := SL(2, ℤ) ⧸ levelFixer N

private local instance levelGrp_fintype (N : ℕ) [NeZero N] : Fintype (LevelGrp N) :=
  Fintype.ofFinite _

private local instance levelGrpRingAction (N : ℕ) [NeZero N] :
    MulSemiringAction (LevelGrp N) ↥(levelNAlgebra N) :=
  MulSemiringAction.compHom _
    (QuotientGroup.kerLift (MulSemiringAction.toAlgAut SL(2, ℤ) ℂ ↥(levelNAlgebra N)))

private theorem levelGrp_mk_smul (γ : SL(2, ℤ)) (f : ↥(levelNAlgebra N)) :
    (QuotientGroup.mk γ : LevelGrp N) • f = γ • f := rfl

private abbrev levelField (N : ℕ) [NeZero N] : Type := FractionRing ↥(levelNAlgebra N)

private local instance levelGrpFieldAction (N : ℕ) [NeZero N] :
    MulSemiringAction (LevelGrp N) (levelField N) :=
  IsFractionRing.mulSemiringAction (LevelGrp N) ↥(levelNAlgebra N) (levelField N)

private local instance levelGrp_smulDistribClass (N : ℕ) [NeZero N] :
    SMulDistribClass (LevelGrp N) ↥(levelNAlgebra N) (levelField N) :=
  IsFractionRing.smulDistribClass (LevelGrp N) ↥(levelNAlgebra N) (levelField N)

private theorem levelGrp_smul_algebraMap (g : LevelGrp N) (a : ↥(levelNAlgebra N)) :
    g • algebraMap ↥(levelNAlgebra N) (levelField N) a =
      algebraMap ↥(levelNAlgebra N) (levelField N) (g • a) :=
  (algebraMap.coe_smul' g a (levelField N)).symm

/-! ### Invariant fractions over a finite group -/

private theorem smul_prod_smul_eq {A : Type*} [CommRing A] {G : Type*} [Group G] [Fintype G]
    [MulSemiringAction G A] (v : A) (g₀ : G) : g₀ • (∏ g : G, g • v) = ∏ g : G, g • v := by
  rw [show g₀ • (∏ g : G, g • v) = MulSemiringAction.toRingHom G A g₀ (∏ g : G, g • v) from rfl,
    map_prod]
  simp only [MulSemiringAction.toRingHom_apply, smul_smul]
  exact Fintype.prod_equiv (Equiv.mulLeft g₀) _ _ fun g ↦ rfl

private theorem exists_fixed_div_of_fixed {A : Type*} [CommRing A] {G : Type*} [Group G]
    [Finite G] [MulSemiringAction G A] [IsDomain A] {K : Type*} [Field K] [Algebra A K]
    [IsFractionRing A K] [MulSemiringAction G K]
    (hcompat : ∀ (g : G) (a : A), g • algebraMap A K a = algebraMap A K (g • a))
    (x : K) (hx : ∀ g : G, g • x = x) :
    ∃ a b : A, (∀ g : G, g • a = a) ∧ (∀ g : G, g • b = b) ∧ algebraMap A K b ≠ 0 ∧
      x * algebraMap A K b = algebraMap A K a := by
  classical
  have : Fintype G := Fintype.ofFinite G
  obtain ⟨u, v, hv, rfl⟩ := IsFractionRing.div_surjective (A := A) x
  have hv0 : v ≠ 0 := nonZeroDivisors.ne_zero hv
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  set b : A := ∏ g : G, g • v with hb
  set a : A := u * ∏ g ∈ (Finset.univ : Finset G).erase 1, g • v with ha
  have hbfix : ∀ g : G, g • b = b := fun g ↦ smul_prod_smul_eq v g
  have hb0 : algebraMap A K b ≠ 0 := by
    rw [map_ne_zero_iff _ hinj, hb]
    exact Finset.prod_ne_zero_iff.mpr fun g _ ↦ (smul_ne_zero_iff_ne g).mpr hv0
  have hxb : algebraMap A K u / algebraMap A K v * algebraMap A K b = algebraMap A K a := by
    have hv0' : algebraMap A K v ≠ 0 := (map_ne_zero_iff _ hinj).mpr hv0
    rw [hb, ← Finset.mul_prod_erase _ _ (Finset.mem_univ (1 : G)), one_smul, ha, map_mul,
      map_mul]
    field_simp
  refine ⟨a, b, fun g ↦ ?_, hbfix, hb0, hxb⟩
  apply hinj
  rw [← hcompat, ← hxb, smul_mul', hx, hcompat, hbfix]

/-! ### Invariant ratios are rational functions of `j` -/

private def jA (N : ℕ) [NeZero N] : ↥(levelNAlgebra N) :=
  ⟨jFunction, jFunction_mem_levelNAlgebra N⟩

private theorem coe_aeval_jA (P : Polynomial ℂ) :
    ((Polynomial.aeval (jA N) P : ↥(levelNAlgebra N)) : ℍ → ℂ) =
      fun τ ↦ Polynomial.eval (jFunction τ) P := by
  rw [Polynomial.aeval_subalgebra_coe]
  funext τ
  change (Polynomial.aeval jFunction P : ℍ → ℂ) τ = _
  rw [show (Polynomial.aeval jFunction P : ℍ → ℂ) τ =
      Pi.evalAlgHom ℂ (fun _ : ℍ ↦ ℂ) τ (Polynomial.aeval jFunction P) from rfl,
    ← Polynomial.aeval_algHom_apply, ← Polynomial.coe_aeval_eq_eval]
  rfl

private theorem levelRing_fixed_eq_aeval_jA (a : ↥(levelNAlgebra N))
    (ha : ∀ γ : SL(2, ℤ), γ • a = a) : ∃ P : Polynomial ℂ, a = Polynomial.aeval (jA N) P := by
  have hinv : ∀ γ : SL(2, ℤ), (a : ℍ → ℂ) ∣[(0 : ℤ)] γ = a := by
    intro γ
    funext τ
    rw [ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one]
    have := congrFun (congrArg Subtype.val (ha γ⁻¹)) τ
    rw [levelRing_coe_smul, sl_smul_apply, inv_inv] at this
    exact this
  obtain ⟨P, hP⟩ := eq_polynomial_jFunction_of_invariant a.2 hinv
  exact ⟨P, Subtype.ext (by rw [coe_aeval_jA]; exact hP)⟩

private theorem exists_polynomial_of_invariant_ratio {a b : ℍ → ℂ}
    (haA : a ∈ levelNAlgebra N) (hbA : b ∈ levelNAlgebra N) (hb0 : b ≠ 0)
    (hinv : ∀ γ : SL(2, ℤ), a * (b ∘ (γ • ·)) = (a ∘ (γ • ·)) * b) :
    ∃ p q : Polynomial ℂ, q ≠ 0 ∧
      a * (fun τ ↦ q.eval (jFunction τ)) = b * (fun τ ↦ p.eval (jFunction τ)) := by
  set aR : ↥(levelNAlgebra N) := ⟨a, haA⟩
  set bR : ↥(levelNAlgebra N) := ⟨b, hbA⟩
  have hinj := IsFractionRing.injective ↥(levelNAlgebra N) (levelField N)
  have hbR0 : bR ≠ 0 := fun h ↦ hb0 (congrArg Subtype.val h)
  have hinvR : ∀ γ : SL(2, ℤ), aR * (γ • bR) = (γ • aR) * bR := fun γ ↦ by
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, levelRing_coe_smul, sl_smul_def]
    exact hinv γ⁻¹
  set x : levelField N := (algebraMap _ (levelField N) aR) / (algebraMap _ (levelField N) bR)
  have hbRK : algebraMap _ (levelField N) bR ≠ 0 := fun h ↦ hbR0
    ((map_eq_zero_iff _ hinj).mp h)
  have hxfix : ∀ g : LevelGrp N, g • x = x := fun g ↦ by
    have hgb : algebraMap _ (levelField N) (g • bR) ≠ 0 := fun h ↦ hbR0 (by
      have h0 : g • bR = 0 := (map_eq_zero_iff _ hinj).mp h
      have := congrArg (g⁻¹ • ·) h0
      simpa only [inv_smul_smul, smul_zero] using this)
    have hgx : g • x = algebraMap _ (levelField N) (g • aR)
        / algebraMap _ (levelField N) (g • bR) := by
      rw [← levelGrp_smul_algebraMap, ← levelGrp_smul_algebraMap]
      exact map_div₀ (MulSemiringAction.toRingHom (LevelGrp N) (levelField N) g) _ _
    have hgeq : aR * (g • bR) = (g • aR) * bR := by
      induction g using QuotientGroup.induction_on with
      | H γ => rw [levelGrp_mk_smul, levelGrp_mk_smul]; exact hinvR γ
    rw [hgx, div_eq_div_iff hgb hbRK, ← map_mul, ← map_mul]
    exact congrArg _ hgeq.symm
  obtain ⟨a', b', ha'f, hb'f, hb'0, hx⟩ :=
    exists_fixed_div_of_fixed (G := LevelGrp N) (A := ↥(levelNAlgebra N)) (K := levelField N)
      levelGrp_smul_algebraMap x hxfix
  have ha'fS : ∀ γ : SL(2, ℤ), γ • a' = a' :=
    fun γ ↦ (levelGrp_mk_smul γ a').symm.trans (ha'f (QuotientGroup.mk γ))
  have hb'fS : ∀ γ : SL(2, ℤ), γ • b' = b' :=
    fun γ ↦ (levelGrp_mk_smul γ b').symm.trans (hb'f (QuotientGroup.mk γ))
  obtain ⟨p, hp⟩ := levelRing_fixed_eq_aeval_jA a' ha'fS
  obtain ⟨q, hq⟩ := levelRing_fixed_eq_aeval_jA b' hb'fS
  refine ⟨p, q, ?_, ?_⟩
  · intro hq0; apply hb'0
    rw [hq, hq0, map_zero, map_zero]
  · have hab' : aR * b' = bR * a' := by
      have hdm := hx
      rw [show x = algebraMap _ (levelField N) aR / algebraMap _ (levelField N) bR from rfl,
        div_mul_eq_mul_div, div_eq_iff hbRK, ← map_mul, ← map_mul] at hdm
      exact (hinj hdm).trans (mul_comm a' bR)
    have hfun := congrArg (Subtype.val : ↥(levelNAlgebra N) → ℍ → ℂ) hab'
    rw [Subalgebra.coe_mul, Subalgebra.coe_mul, hp, hq, coe_aeval_jA, coe_aeval_jA] at hfun
    exact hfun

end Aux

/-! ### Main results -/

variable (N : ℕ) [NeZero N]

/-- An element `γ ∈ SL(2, ℤ)` fixes every Fricke function at a nonzero label, acting on labels
by `v ↦ v γ`, iff `γ` or `-γ` lies in the principal congruence subgroup `Γ(N)`. -/
theorem frickeFunction_labelVecMul_eq_iff (γ : SL(2, ℤ)) :
    (∀ v : Fin 2 → ZMod N, v ≠ 0 → frickeFunction N (labelVecMul N v γ) = frickeFunction N v) ↔
      γ ∈ CongruenceSubgroup.Gamma N ∨ -γ ∈ CongruenceSubgroup.Gamma N := by
  constructor
  · intro h
    refine mem_Gamma_or_neg_mem_of_labelVecMul γ fun v hv ↦ ?_
    exact eq_or_eq_neg_of_frickeFunction_eq' hv (labelVecMul_ne_zero hv γ) (h v hv).symm
  · intro hγ v _
    funext τ
    rw [← frickeFunction_smul']
    rcases hγ with h | h
    · exact frickeFunction_smul_of_mem_Gamma' v h τ
    · rw [← ModularGroup.SL_neg_smul]
      exact frickeFunction_smul_of_mem_Gamma' v h τ

variable {N} in
/-- If `a, b` lie in the level-`N` algebra, `b ≠ 0`, and the ratio `a / b` is
`SL(2, ℤ)`-invariant (written without division as `a · (b ∘ γ) = (a ∘ γ) · b`), then
`a / b = p(j) / q(j)` for polynomials `p, q` with `q ≠ 0`. -/
theorem exists_polynomial_jFunction_of_invariant_ratio {a b : ℍ → ℂ}
    (ha : a ∈ levelNAlgebra N) (hb : b ∈ levelNAlgebra N) (hb0 : b ≠ 0)
    (hinv : ∀ γ : SL(2, ℤ), a * (b ∘ (γ • ·)) = (a ∘ (γ • ·)) * b) :
    ∃ p q : Polynomial ℂ, q ≠ 0 ∧
      a * (fun τ ↦ q.eval (jFunction τ)) = b * (fun τ ↦ p.eval (jFunction τ)) :=
  exists_polynomial_of_invariant_ratio ha hb hb0 hinv

variable {N} in
/-- Each Fricke function at a nonzero label satisfies a monic polynomial relation whose
coefficients are polynomials in `j`. -/
theorem exists_monic_relation_frickeFunction {v : Fin 2 → ZMod N} (hv : v ≠ 0) :
    ∃ d : ℕ, ∃ c : ℕ → Polynomial ℂ, ∀ τ : ℍ,
      frickeFunction N v τ ^ d +
        ∑ k ∈ Finset.range d, (c k).eval (jFunction τ) * frickeFunction N v τ ^ k = 0 := by
  obtain ⟨P, hP⟩ := frickeFunction_relation (N := N)
  exact ⟨_, P, hP v hv⟩

/-- The `j`-function is transcendental over `ℂ`: a polynomial vanishing on all values of `j`
is zero. -/
theorem polynomial_eq_zero_of_eval_jFunction_eq_zero {P : Polynomial ℂ}
    (hP : ∀ τ : ℍ, P.eval (jFunction τ) = 0) : P = 0 := by
  refine Polynomial.eq_zero_of_infinite_isRoot P ?_
  rw [show {x : ℂ | P.IsRoot x} = Set.univ from Set.eq_univ_of_forall fun c ↦ by
    obtain ⟨τ, hτ⟩ := jFunction_surjective c
    exact hτ ▸ hP τ]
  exact Set.infinite_univ

variable {N} in
/-- Every element of the level-`N` algebra is holomorphic on the upper half-plane. -/
theorem mdifferentiable_of_mem_levelNAlgebra {F : ℍ → ℂ} (hF : F ∈ levelNAlgebra N) :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) F :=
  mdifferentiable_of_mem_levelNAlgebra' hF

variable {N} in
/-- The level-`N` algebra has no zero divisors. -/
theorem eq_zero_or_eq_zero_of_mul_eq_zero_of_mem_levelNAlgebra {a b : ℍ → ℂ}
    (ha : a ∈ levelNAlgebra N) (hb : b ∈ levelNAlgebra N) (hab : a * b = 0) :
    a = 0 ∨ b = 0 :=
  holo_eq_zero_or_eq_zero_of_mul_eq_zero (mdifferentiable_of_mem_levelNAlgebra ha)
    (mdifferentiable_of_mem_levelNAlgebra hb) hab

/-- Structure of the level-`N` algebra generated by `j` and the Fricke functions: the
stabilizer of the Fricke functions at nonzero labels under the label action is `±Γ(N)`;
`SL(2, ℤ)`-invariant ratios are rational functions of `j`; each Fricke function at a nonzero
label is integral over `ℂ[j]`; `j` is transcendental; and the algebra consists of holomorphic
functions and has no zero divisors. -/
theorem levelN_structure_package :
    ({γ : SL(2, ℤ) | ∀ v : Fin 2 → ZMod N, v ≠ 0 →
        frickeFunction N (labelVecMul N v γ) = frickeFunction N v} =
      {γ : SL(2, ℤ) | γ ∈ CongruenceSubgroup.Gamma N ∨ -γ ∈ CongruenceSubgroup.Gamma N}) ∧
    (∀ a b : ℍ → ℂ, a ∈ levelNAlgebra N → b ∈ levelNAlgebra N → b ≠ 0 →
      (∀ γ : SL(2, ℤ), a * (b ∘ (γ • ·)) = (a ∘ (γ • ·)) * b) →
      ∃ p q : Polynomial ℂ, q ≠ 0 ∧
        a * (fun τ ↦ q.eval (jFunction τ)) = b * (fun τ ↦ p.eval (jFunction τ))) ∧
    (∀ v : Fin 2 → ZMod N, v ≠ 0 → ∃ d : ℕ, ∃ c : ℕ → Polynomial ℂ, ∀ τ : ℍ,
      frickeFunction N v τ ^ d +
        ∑ k ∈ Finset.range d, (c k).eval (jFunction τ) * frickeFunction N v τ ^ k = 0) ∧
    (∀ P : Polynomial ℂ, (∀ τ : ℍ, P.eval (jFunction τ) = 0) → P = 0) ∧
    (∀ F ∈ levelNAlgebra N, MDifferentiable 𝓘(ℂ) 𝓘(ℂ) F) ∧
    (∀ a b : ℍ → ℂ, a ∈ levelNAlgebra N → b ∈ levelNAlgebra N → a * b = 0 →
      a = 0 ∨ b = 0) :=
  ⟨Set.ext fun γ ↦ frickeFunction_labelVecMul_eq_iff N γ,
    fun _ _ ha hb hb0 hinv ↦ exists_polynomial_jFunction_of_invariant_ratio ha hb hb0 hinv,
    fun _ hv ↦ exists_monic_relation_frickeFunction hv,
    fun _ hP ↦ polynomial_eq_zero_of_eval_jFunction_eq_zero hP,
    fun _ hF ↦ mdifferentiable_of_mem_levelNAlgebra hF,
    fun _ _ ha hb hab ↦ eq_zero_or_eq_zero_of_mul_eq_zero_of_mem_levelNAlgebra ha hb hab⟩

end WLight

end
