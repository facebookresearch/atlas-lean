import MathlibExt.NumberTheory.NumericalSemigroupsKthPowers

/-!
# Linear embedding dimension for semigroups of squares

For `n ≥ 1`, the embedding dimension of the additive submonoid generated by the squares
with bases at least `n` is bounded by a constant times `n`. Private lemmas give a quadratic
conductor bound.

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Theorem 1 (`integers-2025-A11-thm-1`).
-/

namespace MetaMathlibExt

private abbrev squareTail (n : ℕ) : AddSubmonoid ℕ :=
  AddSubmonoid.closure ((fun i => i ^ 2) '' Set.Ici n)

private lemma square_mem {n i : ℕ} (hi : n ≤ i) : i ^ 2 ∈ squareTail n :=
  AddSubmonoid.subset_closure ⟨i, hi, rfl⟩

private lemma paired_squares_mem (n a : ℕ) (ha : a ≤ n) :
    8 * n ^ 2 + 2 * a ^ 2 ∈ squareTail n := by
  have hsub : 2 * n - a + a = 2 * n := Nat.sub_add_cancel (by omega)
  have hid : (2 * n + a) ^ 2 + (2 * n - a) ^ 2 = 8 * n ^ 2 + 2 * a ^ 2 := by
    nlinarith
  rw [← hid]
  exact add_mem (square_mem (by omega)) (square_mem (by omega))

private lemma even_mem (n m : ℕ) (hn : 1 ≤ n) (hm : 16 * n ^ 2 ≤ m) :
    2 * m ∈ squareTail n := by
  have hn₂ : 0 < n ^ 2 := by positivity
  have hr : m % n ^ 2 < n ^ 2 := Nat.mod_lt _ hn₂
  have heq := Nat.mod_add_div m (n ^ 2)
  have hq : 16 ≤ m / n ^ 2 := (Nat.le_div_iff_mul_le hn₂).mpr (by omega)
  obtain ⟨a, b, c, d, habcd⟩ := Nat.sum_four_squares (m % n ^ 2)
  have ha : a ≤ n := by nlinarith
  have hb : b ≤ n := by nlinarith
  have hc : c ≤ n := by nlinarith
  have hd : d ≤ n := by nlinarith
  have hs := add_mem (add_mem (add_mem (paired_squares_mem n a ha)
    (paired_squares_mem n b hb)) (paired_squares_mem n c hc)) (paired_squares_mem n d hd)
  have hs' : 32 * n ^ 2 + 2 * (m % n ^ 2) ∈ squareTail n := by
    convert hs using 1
    nlinarith
  have hmul : (2 * (m / n ^ 2 - 16)) * n ^ 2 ∈ squareTail n := by
    simpa using
      (squareTail n).nsmul_mem (square_mem (n := n) le_rfl) (2 * (m / n ^ 2 - 16))
  have hq' : m / n ^ 2 - 16 + 16 = m / n ^ 2 := Nat.sub_add_cancel hq
  have hid : (32 * n ^ 2 + 2 * (m % n ^ 2)) +
      (2 * (m / n ^ 2 - 16)) * n ^ 2 = 2 * m := by
    nlinarith [congrArg (fun q => q * n ^ 2) hq']
  rw [← hid]
  exact add_mem hs' hmul

private lemma large_mem (n s : ℕ) (hn : 1 ≤ n) (hs : 42 * n ^ 2 ≤ s) :
    s ∈ squareTail n := by
  by_cases he : s % 2 = 0
  · have h : s = 2 * (s / 2) := by omega
    rw [h]
    exact even_mem n (s / 2) hn (by nlinarith)
  · let q := 2 * n + 1
    have hq : q ^ 2 ≤ 9 * n ^ 2 := by dsimp [q]; nlinarith
    have hqs : q ^ 2 ≤ s := by omega
    have hsub : s - q ^ 2 + q ^ 2 = s := Nat.sub_add_cancel hqs
    have hqmod : q % 2 = 1 := by dsimp [q]; omega
    have hqodd : q ^ 2 % 2 = 1 := by simp [Nat.pow_mod, hqmod]
    have heven : (s - q ^ 2) % 2 = 0 := by omega
    have h : s - q ^ 2 = 2 * ((s - q ^ 2) / 2) := by omega
    have hm : 16 * n ^ 2 ≤ (s - q ^ 2) / 2 := by nlinarith
    rw [← hsub, h]
    exact add_mem (even_mem n _ hn hm) (square_mem (by dsimp [q]; omega))

private lemma square_base_lt (n j : ℕ) (hn : 1 ≤ n)
    (hmin : ∀ a ∈ squareTail n, ∀ b ∈ squareTail n,
      a + b = j ^ 2 → a = 0 ∨ b = 0) : j < 7 * n := by
  by_contra! hlarge
  have hn₂ : 0 < n ^ 2 := by positivity
  have hsq : 49 * n ^ 2 ≤ j ^ 2 := by
    calc
      _ = (7 * n) ^ 2 := by ring
      _ ≤ j ^ 2 := Nat.pow_le_pow_left hlarge 2
  have hrem : 42 * n ^ 2 ≤ j ^ 2 - n ^ 2 := by omega
  have hdecomp := hmin (n ^ 2) (square_mem le_rfl)
    (j ^ 2 - n ^ 2) (large_mem n _ hn hrem) (by omega)
  omega

private lemma square_le_of_mem {n s : ℕ} (hs : s ∈ squareTail n) (hs₀ : s ≠ 0) :
    n ^ 2 ≤ s := by
  induction hs using AddSubmonoid.closure_induction_left with
  | zero => exact (hs₀ rfl).elim
  | add_left a ha b _ _ =>
    obtain ⟨i, hi, rfl⟩ := ha
    exact (Nat.pow_le_pow_left hi 2).trans (Nat.le_add_right _ _)

@[expose] public section

/-- **Semigroups of squares have embedding dimension $O(n)$.** For $n \ge 1$ let $S_n$ be the
additive submonoid of $\mathbb{N}$ generated by $n^2, (n+1)^2, (n+2)^2, \ldots$, and let $e(S_n)$
be its embedding dimension, the number of nonzero elements of $S_n$ that are not the sum of two
nonzero elements of $S_n$. There is a natural number $C$ with $e(S_n) \le C n$ for all $n \ge 1$.

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Theorem 1 (`integers-2025-A11-thm-1`). -/
public theorem embeddingDimension_squares_isBigO :
    ∃ C : ℕ, ∀ n : ℕ, 1 ≤ n →
      {s | s ∈ AddSubmonoid.closure ((fun i => i ^ 2) '' Set.Ici n) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure ((fun i => i ^ 2) '' Set.Ici n),
          ∀ b ∈ AddSubmonoid.closure ((fun i => i ^ 2) '' Set.Ici n),
            a + b = s → a = 0 ∨ b = 0}.ncard ≤ C * n
    := by
  have hmono : StrictMono (fun i : ℕ => i ^ 2) :=
    fun _ _ h => Nat.pow_lt_pow_left h (by decide)
  let β (m : ℕ) : Set ℕ := {s | s ∈ squareTail m ∧ s ≠ 0 ∧
    ∀ a ∈ squareTail m, ∀ b ∈ squareTail m, a + b = s → a = 0 ∨ b = 0}
  have hr (k : ℕ) (hk : 1 ≤ k) :
      (1 / 7 : ℝ) * k ≤ (sInf {m : ℕ | 1 ≤ m ∧ k ^ 2 ∈ β m} : ℕ) := by
    have hself : k ^ 2 ∈ β k := by
      refine ⟨square_mem le_rfl, by positivity, ?_⟩
      intro a ha b hb hab
      by_contra! h
      have ha' := square_le_of_mem ha h.1
      have hb' := square_le_of_mem hb h.2
      have hk₂ : 0 < k ^ 2 := by positivity
      omega
    have hne : {m : ℕ | 1 ≤ m ∧ k ^ 2 ∈ β m}.Nonempty := ⟨k, hk, hself⟩
    obtain ⟨hm, _, _, hmin⟩ := Nat.sInf_mem hne
    have hlt := square_base_lt _ k hm hmin
    have hcast : (k : ℝ) < 7 * (sInf {m : ℕ | 1 ≤ m ∧ k ^ 2 ∈ β m} : ℕ) := by
      exact_mod_cast hlt
    linarith
  refine ⟨7, fun n hn => ?_⟩
  have hbound := embeddingDimension_le_of_firstAppearance_ge
    (fun i => i ^ 2) hmono (1 / 7) (by norm_num) hr n hn
  have hfloor : ⌊(n : ℝ) / (1 / 7)⌋ = (7 * n : ℕ) := by
    have heq : (n : ℝ) / (1 / 7) = ((7 * n : ℕ) : ℝ) := by push_cast; ring
    rw [heq, Int.floor_natCast]
  rw [hfloor] at hbound
  exact_mod_cast (hbound.trans (by omega : (7 * n : ℕ) - (n : ℤ) + 1 ≤ (7 * n : ℕ)))

end

end MetaMathlibExt
