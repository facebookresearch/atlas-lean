module

public import Mathlib.Algebra.QuadraticAlgebra.Basic
public import Mathlib.NumberTheory.Real.GoldenRatio
import MathlibExt.NumberTheory.QuadraticForms.GoldenRatioIntegerRingUnits

/-!
# Coordinates for the real golden order

`goldenEquiv` identifies `QuadraticAlgebra ℤ 1 1` with the real
subalgebra generated by `(1 + √5) / 2`. Quadratic conjugation evaluates
at the other root, not at the real star operation.

The natural-exponent unit corollary transports the existing public real
unit classification; it does not prove a second classification.
Its four cases match `exists_phi_pow_of_isUnit`, lines 623–677 of
`P2M/Sol/S_fermatLastTheoremFive.lean` in anthropics/fermats-last-theorem,
commit `6e837e75355538c7f80bab5b956861e86c4eacc2`.
-/

public section

namespace QuadraticAlgebra

private noncomputable def goldenEval :
    QuadraticAlgebra ℤ 1 1 →ₐ[ℤ] ℝ :=
  lift ⟨Real.goldenRatio, by
    simpa only [one_smul, sq, add_comm] using Real.goldenRatio_sq⟩

private theorem goldenEval_injective : Function.Injective goldenEval := by
  rw [goldenEval, lift_injective_iff, LinearIndependent.pair_iff]
  intro a b h
  have hb : b = 0 := by
    by_contra hb
    have hi := (Real.goldenRatio_irrational.intCast_mul hb).intCast_add a
    exact hi.ne_zero (by simpa using h)
  subst b
  simp only [zero_smul, add_zero, zsmul_eq_mul, mul_one, Int.cast_eq_zero] at h
  exact ⟨h, rfl⟩

/-- The coordinate-preserving equivalence with the real golden order.
Its forward map sends `(a,b)` to `a + b * Real.goldenRatio`. -/
noncomputable def goldenEquiv :
    QuadraticAlgebra ℤ 1 1 ≃ₐ[ℤ]
      Algebra.adjoin ℤ ({Real.goldenRatio} : Set ℝ) :=
  (AlgEquiv.ofInjective goldenEval goldenEval_injective).trans
    (Subalgebra.equivOfEq _ _ (range_lift _))

/-- Evaluation of the coordinates under `goldenEquiv`. -/
@[simp]
theorem coe_goldenEquiv (z : QuadraticAlgebra ℤ 1 1) :
    (goldenEquiv z : ℝ) = z.re + z.im * Real.goldenRatio := by
  change goldenEval z = _
  simp [goldenEval, lift_apply_apply]

/-- Quadratic conjugation uses the other embedding into the reals. -/
theorem coe_goldenEquiv_star (z : QuadraticAlgebra ℤ 1 1) :
    (goldenEquiv (star z) : ℝ) =
      z.re + z.im * (1 - Real.goldenRatio) := by
  simp only [coe_goldenEquiv, re_star, im_star, one_mul,
    Int.cast_add, Int.cast_neg]
  ring

/-- The integral norm is the product of the two real embeddings. -/
theorem norm_eq_goldenEquiv_mul (z : QuadraticAlgebra ℤ 1 1) :
    ((norm z : ℤ) : ℝ) = (goldenEquiv z : ℝ) *
      (z.re + z.im * (1 - Real.goldenRatio)) := by
  have h := congrArg (fun w : QuadraticAlgebra ℤ 1 1 =>
    (goldenEquiv w : ℝ)) (algebraMap_norm_eq_mul_star z)
  simpa [mul_add, sub_eq_add_neg, add_assoc] using h

/-- Every unit is a signed natural power of the generator or its inverse.
This is a transport of `MetaMathlibExt.golden_ratio_integer_ring_units`. -/
theorem exists_omega_pow_of_isUnit (z : QuadraticAlgebra ℤ 1 1)
    (hz : IsUnit z) :
    ∃ n : ℕ, z = omega ^ n ∨ z = -(omega ^ n) ∨
      z * omega ^ n = 1 ∨ z * omega ^ n = -1 := by
  obtain ⟨u, hu⟩ := hz.map goldenEquiv
  have hmem : (goldenEquiv z : ℝ) ∈
      Set.range (fun u : (Algebra.adjoin ℤ
        ({Real.goldenRatio} : Set ℝ))ˣ => ((u : _) : ℝ)) :=
    ⟨u, congrArg (fun w : Algebra.adjoin ℤ
      ({Real.goldenRatio} : Set ℝ) => (w : ℝ)) hu⟩
  rw [MetaMathlibExt.golden_ratio_integer_ring_units] at hmem
  change ∃ n : ℤ, goldenEval z = Real.goldenRatio ^ n ∨
    goldenEval z = -(Real.goldenRatio ^ n) at hmem
  obtain ⟨n, hn⟩ := hmem
  have he : goldenEval omega = Real.goldenRatio := by simp [goldenEval]
  obtain ⟨m, rfl | rfl⟩ := n.eq_nat_or_neg
  · rcases hn with hn | hn
    · exact ⟨m, Or.inl (goldenEval_injective (by simpa [he] using hn))⟩
    · exact ⟨m, Or.inr (Or.inl
        (goldenEval_injective (by simpa [he] using hn)))⟩
  · have hne := pow_ne_zero m Real.goldenRatio_ne_zero
    rcases hn with hn | hn
    · refine ⟨m, Or.inr (Or.inr (Or.inl (goldenEval_injective ?_)))⟩
      simp [map_mul, he, hn, hne]
    · refine ⟨m, Or.inr (Or.inr (Or.inr (goldenEval_injective ?_)))⟩
      simp [map_mul, he, hn, hne]

end QuadraticAlgebra
