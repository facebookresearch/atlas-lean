/-!
# The one-Sylvester count for three consecutive star numbers

Representation counts and the number of natural numbers with at most one representation
by three consecutive star numbers.

Source: Takao Komatsu, Tapas Chatterjee, and Palak Narula,
"On p-Frobenius Numbers for the Numerical Semigroups Generated by
Three Consecutive Star Numbers", *INTEGERS* 25 (2025), Article A106, Theorem 2
(<https://math.colgate.edu/~integers/z106/z106.pdf>).
-/

set_option autoImplicit false

@[expose] public section

namespace MathlibExt.NumberTheory.PFrobeniusStarNumbersWanted

export MetaMathlibExt.StarNumber (star)

private theorem star_pos (n : ℕ) : 0 < star n := by
  unfold star
  omega

private theorem rep_finite (n N : ℕ) :
    Finite {xyz : ℕ × ℕ × ℕ //
      xyz.1 * star n + xyz.2.1 * star (n + 1) +
        xyz.2.2 * star (n + 2) = N} := by
  let f : {xyz : ℕ × ℕ × ℕ //
      xyz.1 * star n + xyz.2.1 * star (n + 1) +
        xyz.2.2 * star (n + 2) = N} → Fin (N + 1) × Fin (N + 1) × Fin (N + 1) :=
    fun xyz =>
      ⟨⟨xyz.val.1, by
        have := Nat.le_mul_of_pos_right xyz.val.1 (star_pos n)
        have := xyz.property
        omega⟩,
       ⟨xyz.val.2.1, by
        have := Nat.le_mul_of_pos_right xyz.val.2.1 (star_pos (n + 1))
        have := xyz.property
        omega⟩,
       ⟨xyz.val.2.2, by
        have := Nat.le_mul_of_pos_right xyz.val.2.2 (star_pos (n + 2))
        have := xyz.property
        omega⟩⟩
  apply Finite.of_injective f
  intro u v h
  apply Subtype.ext
  exact congrArg (fun p : Fin (N + 1) × Fin (N + 1) × Fin (N + 1) =>
    (p.1.val, p.2.1.val, p.2.2.val)) h

private theorem rep_le_one_iff (n N : ℕ) :
    starRepCount n N ≤ 1 ↔
      ∀ u v : ℕ × ℕ × ℕ,
        u.1 * star n + u.2.1 * star (n + 1) + u.2.2 * star (n + 2) = N →
        v.1 * star n + v.2.1 * star (n + 1) + v.2.2 * star (n + 2) = N → u = v := by
  let := rep_finite n N
  rw [starRepCount, Finite.card_le_one_iff_subsingleton]
  constructor
  · intro h u v hu hv
    exact congrArg Subtype.val (h.elim ⟨u, hu⟩ ⟨v, hv⟩)
  · intro h
    exact ⟨fun u v => Subtype.ext (h u.val v.val u.property v.property)⟩

private theorem star_succ_eq (n : ℕ) (hn : 1 ≤ n) :
    star (n + 1) = star n + 12 * n := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  change 6 * (k + 2) * (k + 1) + 1 = 6 * (k + 1) * k + 1 + 12 * (k + 1)
  ring

private theorem star_coprime_succ (n : ℕ) (hn : 1 ≤ n) :
    (star n).Coprime (star (n + 1)) := by
  let g := Nat.gcd (star n) (star (n + 1))
  have h0 : g ∣ star n := Nat.gcd_dvd_left _ _
  have h1 : g ∣ star (n + 1) := Nat.gcd_dvd_right _ _
  have h12 : g ∣ 12 * n := by
    rw [star_succ_eq n hn] at h1
    exact (Nat.dvd_add_right h0).mp h1
  have htwo : g ∣ 2 := by
    have h : 2 * star n = 12 * n * (n - 1) + 2 := by unfold star; ring
    have hd : g ∣ 12 * n * (n - 1) + 2 := h ▸ h0.mul_left 2
    exact (Nat.dvd_add_right (h12.mul_right (n - 1))).mp hd
  have hbase : g ∣ 6 * n * (n - 1) := by
    convert htwo.mul_right (3 * n * (n - 1)) using 1; ring
  exact Nat.eq_one_of_dvd_one ((Nat.dvd_add_right hbase).mp h0)

private theorem star_relation_left (n : ℕ) (hn : 6 ≤ n) :
    (2 * n + 1) * star (n + 1) = (n + 1) * star n + n * star (n + 2) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
  change (2 * (k + 6) + 1) * (6 * (k + 7) * (k + 6) + 1) =
    (k + 7) * (6 * (k + 6) * (k + 5) + 1) +
      (k + 6) * (6 * (k + 8) * (k + 7) + 1)
  ring

private theorem star_relation_middle (n : ℕ) (hn : 6 ≤ n) :
    (2 * n - 10) * star (n + 1) + (2 * n + 1) * star (n + 2) =
      (4 * n + 3) * star n := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
  rw [show 2 * (k + 6) - 10 = 2 * k + 2 by omega]
  change (2 * k + 2) * (6 * (k + 7) * (k + 6) + 1) +
    (2 * (k + 6) + 1) * (6 * (k + 8) * (k + 7) + 1) =
      (4 * (k + 6) + 3) * (6 * (k + 6) * (k + 5) + 1)
  ring

private theorem star_relation_right (n : ℕ) (hn : 6 ≤ n) :
    (3 * n + 1) * star (n + 2) = 11 * star (n + 1) + (3 * n + 2) * star n := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
  change (3 * (k + 6) + 1) * (6 * (k + 8) * (k + 7) + 1) =
    11 * (6 * (k + 7) * (k + 6) + 1) +
      (3 * (k + 6) + 2) * (6 * (k + 6) * (k + 5) + 1)
  ring

private theorem difference_zero (n dy dz : ℤ) (hn : 6 ≤ n)
    (hy0 : -(2 * n) ≤ dy) (hy1 : dy ≤ 2 * n)
    (he : n * dy + (2 * n + 1) * dz = 0) : dy = 0 ∧ dz = 0 := by
  have hd : n ∣ dz := by
    refine ⟨-(dy + 2 * dz), ?_⟩
    nlinarith [he]
  obtain ⟨k, hk⟩ := hd
  have hey : dy + (2 * n + 1) * k = 0 := by
    have h : n * (dy + (2 * n + 1) * k) = 0 := by nlinarith [he]
    exact (mul_eq_zero.mp h).resolve_left (by omega)
  have hk0 : k = 0 := by
    by_contra hk0
    have hkpos : 1 ≤ k ∨ k ≤ -1 := by omega
    rcases hkpos with hkpos | hkneg
    · nlinarith [mul_nonneg (show 0 ≤ 2 * n + 1 by omega) (show 0 ≤ k - 1 by omega)]
    · nlinarith [mul_nonneg (show 0 ≤ 2 * n + 1 by omega) (show 0 ≤ -1 - k by omega)]
  constructor <;> simp_all

private theorem difference_one (n dy dz : ℤ) (hn : 6 ≤ n)
    (hy1 : dy ≤ 2 * n) (hz1 : dz ≤ 3 * n)
    (he : n * dy + (2 * n + 1) * dz = 6 * n * (n - 1) + 1) :
    dy = 2 * n - 10 ∧ dz = 2 * n + 1 := by
  have hd : n ∣ dz - 1 := by
    refine ⟨6 * n - 6 - dy - 2 * dz, ?_⟩
    nlinarith [he]
  obtain ⟨k, hk⟩ := hd
  have hey : dy = 6 * n - 8 - (2 * n + 1) * k := by
    have h : n * (dy - (6 * n - 8 - (2 * n + 1) * k)) = 0 := by
      nlinarith [he]
    have h0 := (mul_eq_zero.mp h).resolve_left (show n ≠ 0 by omega)
    omega
  have hklo : 2 ≤ k := by
    by_contra! hklo
    nlinarith [mul_nonneg (show 0 ≤ 2 * n + 1 by omega) (show 0 ≤ 1 - k by omega)]
  have hkhi : k ≤ 2 := by
    by_contra! hkhi
    nlinarith [mul_nonneg (show 0 ≤ n by omega) (show 0 ≤ k - 3 by omega)]
  have hk2 : k = 2 := by omega
  subst k
  constructor <;> nlinarith

private theorem difference_classification (n dy dz : ℤ) (hn : 6 ≤ n)
    (hy0 : -(2 * n) ≤ dy) (hy1 : dy ≤ 2 * n)
    (hz0 : -(3 * n) ≤ dz) (hz1 : dz ≤ 3 * n)
    (hd : 6 * n * (n - 1) + 1 ∣ n * dy + (2 * n + 1) * dz) :
    (dy = 0 ∧ dz = 0) ∨
      (dy = 2 * n - 10 ∧ dz = 2 * n + 1) ∨
      (dy = -(2 * n - 10) ∧ dz = -(2 * n + 1)) := by
  obtain ⟨t, ht⟩ := hd
  let a := 6 * n * (n - 1) + 1
  have ha : 0 < a := by dsimp [a]; nlinarith
  have hupper : n * dy + (2 * n + 1) * dz ≤ 8 * n ^ 2 + 3 * n := by
    nlinarith [mul_nonneg (show 0 ≤ n by omega) (show 0 ≤ 2 * n - dy by omega),
      mul_nonneg (show 0 ≤ 2 * n + 1 by omega) (show 0 ≤ 3 * n - dz by omega)]
  have hlower : -(8 * n ^ 2 + 3 * n) ≤ n * dy + (2 * n + 1) * dz := by
    nlinarith [mul_nonneg (show 0 ≤ n by omega) (show 0 ≤ dy + 2 * n by omega),
      mul_nonneg (show 0 ≤ 2 * n + 1 by omega) (show 0 ≤ dz + 3 * n by omega)]
  have habound : 8 * n ^ 2 + 3 * n < 2 * a := by
    dsimp [a]
    nlinarith [mul_nonneg (show 0 ≤ n by omega) (show 0 ≤ n - 6 by omega)]
  change n * dy + (2 * n + 1) * dz = a * t at ht
  have htlo : -1 ≤ t := by
    by_contra! htlo
    nlinarith [mul_nonneg (le_of_lt ha) (show 0 ≤ -2 - t by omega)]
  have hthi : t ≤ 1 := by
    by_contra! hthi
    nlinarith [mul_nonneg (le_of_lt ha) (show 0 ≤ t - 2 by omega)]
  have hcases : t = 0 ∨ t = 1 ∨ t = -1 := by omega
  rcases hcases with rfl | rfl | rfl
  · left
    apply difference_zero n dy dz hn hy0 hy1
    simpa using ht
  · right; left
    apply difference_one n dy dz hn hy1 hz1
    simpa [a] using ht
  · right; right
    have h := difference_one n (-dy) (-dz) hn (by omega) (by omega) (by
      dsimp [a] at ht
      nlinarith [ht])
    omega

private abbrev Canonical (n : ℕ) :=
  (Fin (2 * n + 1) × Fin (n + 1)) ⊕
    (Fin (2 * n - 10) × Fin n) ⊕ (Fin 11 × Fin n) ⊕ (Fin (2 * n - 10) × Fin n)

private def canonicalPair (n : ℕ) : Canonical n → ℕ × ℕ
  | Sum.inl p => (p.1.val, n + p.2.val)
  | Sum.inr (Sum.inl p) => (p.1.val, 2 * n + 1 + p.2.val)
  | Sum.inr (Sum.inr (Sum.inl p)) => (p.1.val, p.2.val)
  | Sum.inr (Sum.inr (Sum.inr p)) => (11 + p.1.val, p.2.val)

private theorem canonicalPair_bounds (n : ℕ) (hn : 6 ≤ n) (p : Canonical n) :
    (canonicalPair n p).1 < 2 * n + 1 ∧
      (canonicalPair n p).2 < 3 * n + 1 ∧
      ((canonicalPair n p).1 < 2 * n - 10 ∨ (canonicalPair n p).2 < 2 * n + 1) := by
  rcases p with p | p | p | p
  all_goals
    have hy := p.1.isLt
    have hz := p.2.isLt
    simp only [canonicalPair]
    omega

private theorem canonicalPair_injective (n : ℕ) :
    Function.Injective (canonicalPair n) := by
  intro p q hpq
  rcases p with p | p | p | p <;> rcases q with q | q | q | q
  all_goals
    have hpy := p.1.isLt
    have hpz := p.2.isLt
    have hqy := q.1.isLt
    have hqz := q.2.isLt
    have h1 := congrArg Prod.fst hpq
    have h2 := congrArg Prod.snd hpq
    simp only [canonicalPair] at h1 h2
    try omega
  all_goals
    simp only [Sum.inl.injEq, Sum.inr.injEq, Prod.ext_iff, Fin.ext_iff]
    constructor <;> omega

private def canonicalResidue (n : ℕ) (p : Canonical n) : ℕ :=
  (n * (canonicalPair n p).1 + (2 * n + 1) * (canonicalPair n p).2) % star n

private theorem canonicalResidue_injective (n : ℕ) (hn : 6 ≤ n) :
    Function.Injective (canonicalResidue n) := by
  intro p q heq
  have hp := canonicalPair_bounds n hn p
  have hq := canonicalPair_bounds n hn q
  let y := (canonicalPair n p).1
  let z := (canonicalPair n p).2
  let y' := (canonicalPair n q).1
  let z' := (canonicalPair n q).2
  have hd : (star n : ℤ) ∣
      ((n * y' + (2 * n + 1) * z' : ℕ) : ℤ) -
        ((n * y + (2 * n + 1) * z : ℕ) : ℤ) := Nat.modEq_iff_dvd.mp heq
  have hs : (star n : ℤ) = 6 * (n : ℤ) * (n - 1) + 1 := by
    simp only [star, Nat.cast_add, Nat.cast_mul, Nat.cast_one, Nat.cast_ofNat,
      Nat.cast_sub (show 1 ≤ n by omega)]
  have hd' : 6 * (n : ℤ) * (n - 1) + 1 ∣
      (n : ℤ) * ((y' : ℤ) - y) + (2 * n + 1) * ((z' : ℤ) - z) := by
    simpa only [hs, Nat.cast_add, Nat.cast_mul, Nat.cast_one, Nat.cast_ofNat,
      mul_sub, sub_add_sub_comm] using hd
  have hcases := difference_classification (n : ℤ) ((y' : ℤ) - y) ((z' : ℤ) - z)
    (by exact_mod_cast hn) (by dsimp [y, y']; omega) (by dsimp [y, y']; omega)
    (by dsimp [z, z']; omega) (by dsimp [z, z']; omega) hd'
  apply canonicalPair_injective n
  rcases hcases with he | he | he
  · apply Prod.ext <;> dsimp [y, y', z, z'] at he <;> omega
  · dsimp [y, y', z, z'] at he
    omega
  · dsimp [y, y', z, z'] at he
    omega

private theorem canonical_card (n : ℕ) (hn : 6 ≤ n) :
    Nat.card (Canonical n) = star n := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
  simp only [Canonical, Nat.card_sum, Nat.card_prod, Nat.card_fin]
  rw [show 2 * (k + 6) - 10 = 2 * k + 2 by omega]
  change (2 * (k + 6) + 1) * (k + 7) +
    ((2 * k + 2) * (k + 6) + (11 * (k + 6) + (2 * k + 2) * (k + 6))) =
      6 * (k + 6) * (k + 5) + 1
  ring

private def pairWeight (n : ℕ) (p : ℕ × ℕ) : ℕ :=
  p.1 * star (n + 1) + p.2 * star (n + 2)

private theorem pairWeight_mod (n : ℕ) (hn : 6 ≤ n) (y z : ℕ) :
    pairWeight n (y, z) ≡ 12 * (n * y + (2 * n + 1) * z) [MOD star n] := by
  have hb := star_succ_eq n (by omega)
  have hc := star_succ_eq (n + 1) (by omega)
  have heq : pairWeight n (y, z) =
      12 * (n * y + (2 * n + 1) * z) + (y + z) * star n := by
    simp only [pairWeight, hb, hc]
    ring
  rw [heq]
  simp [Nat.ModEq]

private theorem star_coprime_twelve (n : ℕ) (hn : 6 ≤ n) : (star n).Coprime 12 := by
  have h := star_coprime_succ n (by omega)
  rw [star_succ_eq n (by omega), Nat.coprime_self_add_right] at h
  exact h.of_dvd_right (dvd_mul_right 12 n)

private def weightResidue (n : ℕ) (p : Canonical n) : Fin (star n) :=
  ⟨pairWeight n (canonicalPair n p) % star n, Nat.mod_lt _ (star_pos n)⟩

private theorem weightResidue_injective (n : ℕ) (hn : 6 ≤ n) :
    Function.Injective (weightResidue n) := by
  intro p q hpq
  have hw : pairWeight n (canonicalPair n p) ≡ pairWeight n (canonicalPair n q)
      [MOD star n] := congrArg Fin.val hpq
  have hp := pairWeight_mod n hn (canonicalPair n p).1 (canonicalPair n p).2
  have hq := pairWeight_mod n hn (canonicalPair n q).1 (canonicalPair n q).2
  have h := Nat.ModEq.cancel_left_of_coprime (star_coprime_twelve n hn)
    (hp.symm.trans (hw.trans hq))
  exact canonicalResidue_injective n hn h

private theorem weightResidue_bijective (n : ℕ) (hn : 6 ≤ n) :
    Function.Bijective (weightResidue n) := by
  have hi := weightResidue_injective n hn
  let e : Canonical n ≃ Fin (star n) :=
    (Finite.equivFin (Canonical n)).trans (finCongr (canonical_card n hn))
  exact ⟨hi, hi.surjective_of_finite e⟩

private def secondGap (n y z : ℕ) : ℕ :=
  if n ≤ z then n + 1 else if y < 11 then 4 * n + 3 else 3 * n + 2

private theorem secondGap_le (n y z : ℕ) : secondGap n y z ≤ 4 * n + 3 := by
  unfold secondGap
  split_ifs <;> omega

private theorem reduce_left (n y z : ℕ) (hn : 6 ≤ n) (hy : 2 * n + 1 ≤ y) :
    pairWeight n (y - (2 * n + 1), z + n) + (n + 1) * star n =
      pairWeight n (y, z) := by
  have h := congrArg (fun t => t * star (n + 1)) (Nat.sub_add_cancel hy)
  have hs := star_relation_left n hn
  simp only [pairWeight]
  nlinarith [h, hs]

private theorem reduce_right (n y z : ℕ) (hn : 6 ≤ n) (hz : 3 * n + 1 ≤ z) :
    pairWeight n (y + 11, z - (3 * n + 1)) + (3 * n + 2) * star n =
      pairWeight n (y, z) := by
  have h := congrArg (fun t => t * star (n + 2)) (Nat.sub_add_cancel hz)
  have hs := star_relation_right n hn
  simp only [pairWeight]
  nlinarith [h, hs]

private theorem reduce_middle (n y z : ℕ) (hn : 6 ≤ n)
    (hy : 2 * n - 10 ≤ y) (hz : 2 * n + 1 ≤ z) :
    pairWeight n (y - (2 * n - 10), z - (2 * n + 1)) + (4 * n + 3) * star n =
      pairWeight n (y, z) := by
  have h0 := congrArg (fun t => t * star (n + 1)) (Nat.sub_add_cancel hy)
  have h1 := congrArg (fun t => t * star (n + 2)) (Nat.sub_add_cancel hz)
  have hs := star_relation_middle n hn
  simp only [pairWeight]
  nlinarith [h0, h1, hs]

private theorem exists_canonical (n y z : ℕ) (hn : 6 ≤ n) (hy : y < 2 * n + 1)
    (hz : z < 3 * n + 1) (hcorner : y < 2 * n - 10 ∨ z < 2 * n + 1) :
    ∃ p : Canonical n, canonicalPair n p = (y, z) := by
  by_cases hz0 : 2 * n + 1 ≤ z
  · refine ⟨Sum.inr (Sum.inl (⟨y, by omega⟩, ⟨z - (2 * n + 1), by omega⟩)), ?_⟩
    simp only [canonicalPair]
    apply Prod.ext
    · rfl
    · omega
  by_cases hz1 : n ≤ z
  · refine ⟨Sum.inl (⟨y, hy⟩, ⟨z - n, by omega⟩), ?_⟩
    simp only [canonicalPair]
    apply Prod.ext
    · rfl
    · omega
  by_cases hy0 : y < 11
  · exact ⟨Sum.inr (Sum.inr (Sum.inl (⟨y, hy0⟩, ⟨z, by omega⟩))), rfl⟩
  · refine ⟨Sum.inr (Sum.inr (Sum.inr (⟨y - 11, by omega⟩, ⟨z, by omega⟩))), ?_⟩
    simp only [canonicalPair]
    apply Prod.ext
    · omega
    · rfl

private theorem canonical_minimum (n : ℕ) (hn : 6 ≤ n) (p : Canonical n)
    (y z : ℕ) (hm : pairWeight n (y, z) ≡ pairWeight n (canonicalPair n p) [MOD star n]) :
    pairWeight n (canonicalPair n p) ≤ pairWeight n (y, z) ∧
      ((y, z) ≠ canonicalPair n p →
        pairWeight n (canonicalPair n p) +
          secondGap n (canonicalPair n p).1 (canonicalPair n p).2 * star n ≤
            pairWeight n (y, z)) := by
  have main : ∀ w y z : ℕ, pairWeight n (y, z) = w →
      pairWeight n (y, z) ≡ pairWeight n (canonicalPair n p) [MOD star n] →
      pairWeight n (canonicalPair n p) ≤ w ∧
        ((y, z) ≠ canonicalPair n p → pairWeight n (canonicalPair n p) +
          secondGap n (canonicalPair n p).1 (canonicalPair n p).2 * star n ≤ w) := by
    intro w
    induction w using Nat.strong_induction_on with
    | ind w ih =>
      intro y z hw hm
      have advance (yr zr d : ℕ) (he : pairWeight n (yr, zr) + d * star n = w)
          (hd : 0 < d)
          (hgap : (yr, zr) = canonicalPair n p →
            secondGap n (canonicalPair n p).1 (canonicalPair n p).2 ≤ d) :
          pairWeight n (canonicalPair n p) ≤ w ∧
            ((y, z) ≠ canonicalPair n p → pairWeight n (canonicalPair n p) +
              secondGap n (canonicalPair n p).1 (canonicalPair n p).2 * star n ≤ w) := by
        have hlt : pairWeight n (yr, zr) < w := by
          have hpos := Nat.mul_pos hd (star_pos n)
          omega
        have hmr : pairWeight n (yr, zr) ≡ pairWeight n (canonicalPair n p)
            [MOD star n] := by
          have hstep : pairWeight n (yr, zr) ≡ w [MOD star n] := by
            rw [← he]
            simp [Nat.ModEq, Nat.add_mod]
          exact hstep.trans (hw ▸ hm)
        have hr := ih _ hlt yr zr rfl hmr
        constructor
        · omega
        · intro _
          by_cases hp : (yr, zr) = canonicalPair n p
          · have hmul := Nat.mul_le_mul_right (star n) (hgap hp)
            rw [hp] at he
            omega
          · have h := hr.2 hp
            omega
      by_cases hy : 2 * n + 1 ≤ y
      · apply advance (y - (2 * n + 1)) (z + n) (n + 1)
          ((reduce_left n y z hn hy).trans hw) (by omega)
        intro hp
        have hpz : (canonicalPair n p).2 = z + n := (congrArg Prod.snd hp).symm
        simp [secondGap, hpz]
      by_cases hz : 3 * n + 1 ≤ z
      · apply advance (y + 11) (z - (3 * n + 1)) (3 * n + 2)
          ((reduce_right n y z hn hz).trans hw) (by omega)
        intro hp
        have hpy : (canonicalPair n p).1 = y + 11 := (congrArg Prod.fst hp).symm
        simp only [secondGap, hpy]
        split_ifs <;> omega
      by_cases hcorner : 2 * n - 10 ≤ y ∧ 2 * n + 1 ≤ z
      · apply advance (y - (2 * n - 10)) (z - (2 * n + 1)) (4 * n + 3)
          ((reduce_middle n y z hn hcorner.1 hcorner.2).trans hw) (by omega)
        intro _
        exact secondGap_le _ _ _
      obtain ⟨q, hq⟩ := exists_canonical n y z hn (by omega) (by omega) (by omega)
      have hpq : q = p := weightResidue_injective n hn (Fin.ext (by
        change pairWeight n (canonicalPair n q) % star n =
          pairWeight n (canonicalPair n p) % star n
        rw [hq]
        exact hm))
      subst q
      rw [← hq] at hw ⊢
      exact ⟨hw.le, fun h => (h rfl).elim⟩
  exact main _ y z rfl hm

private theorem exists_second_pair (n : ℕ) (hn : 6 ≤ n) (y z : ℕ) :
    ∃ q : ℕ × ℕ, q ≠ (y, z) ∧
      pairWeight n q = pairWeight n (y, z) + secondGap n y z * star n := by
  by_cases hz : n ≤ z
  · refine ⟨(y + (2 * n + 1), z - n), ?_, ?_⟩
    · intro h
      have := congrArg Prod.fst h
      omega
    · have he := reduce_left n (y + (2 * n + 1)) (z - n) hn (by omega)
      have h0 : y + (2 * n + 1) - (2 * n + 1) = y := by omega
      have h1 : z - n + n = z := Nat.sub_add_cancel hz
      simpa [h0, h1, secondGap, hz] using he.symm
  by_cases hy : y < 11
  · refine ⟨(y + (2 * n - 10), z + (2 * n + 1)), ?_, ?_⟩
    · intro h
      have := congrArg Prod.snd h
      omega
    · have he := reduce_middle n (y + (2 * n - 10)) (z + (2 * n + 1)) hn
        (by omega) (by omega)
      simpa [secondGap, hz, hy] using he.symm
  · refine ⟨(y - 11, z + (3 * n + 1)), ?_, ?_⟩
    · intro h
      have := congrArg Prod.snd h
      omega
    · have he := reduce_right n (y - 11) (z + (3 * n + 1)) hn (by omega)
      have h0 : y - 11 + 11 = y := by omega
      simpa [h0, secondGap, hz, hy] using he.symm

private def secondWeight (n : ℕ) (p : Canonical n) : ℕ :=
  pairWeight n (canonicalPair n p) +
    secondGap n (canonicalPair n p).1 (canonicalPair n p).2 * star n

private theorem rep_le_one_iff_secondWeight (n N : ℕ) (hn : 6 ≤ n) (p : Canonical n)
    (hm : N ≡ pairWeight n (canonicalPair n p) [MOD star n]) :
    starRepCount n N ≤ 1 ↔ N < secondWeight n p := by
  rw [rep_le_one_iff]
  constructor
  · intro h
    by_contra! hlarge
    have hle0 : pairWeight n (canonicalPair n p) ≤ N := by
      have hle := Nat.le_add_right (pairWeight n (canonicalPair n p))
        (secondGap n (canonicalPair n p).1 (canonicalPair n p).2 * star n)
      exact hle.trans hlarge
    obtain ⟨x, hx⟩ := (Nat.modEq_iff_exists_eq_add hle0).mp hm.symm
    obtain ⟨q, hqne, hq⟩ := exists_second_pair n hn
      (canonicalPair n p).1 (canonicalPair n p).2
    have hmq : pairWeight n q ≡ N [MOD star n] := by
      rw [hq]
      exact (by simp [Nat.ModEq] :
        pairWeight n (canonicalPair n p) +
          secondGap n (canonicalPair n p).1 (canonicalPair n p).2 * star n ≡
            pairWeight n (canonicalPair n p) [MOD star n]).trans hm.symm
    obtain ⟨x', hx'⟩ :=
      (Nat.modEq_iff_exists_eq_add (by simpa [hq, secondWeight] using hlarge)).mp hmq
    have hu : x * star n + (canonicalPair n p).1 * star (n + 1) +
        (canonicalPair n p).2 * star (n + 2) = N := by
      rw [Nat.mul_comm (star n) x] at hx
      dsimp [pairWeight] at hx
      omega
    have hv : x' * star n + q.1 * star (n + 1) + q.2 * star (n + 2) = N := by
      rw [Nat.mul_comm (star n) x'] at hx'
      dsimp [pairWeight] at hx'
      omega
    have he := h (x, (canonicalPair n p).1, (canonicalPair n p).2) (x', q.1, q.2) hu hv
    have hpair := congrArg (fun u : ℕ × ℕ × ℕ => u.2) he
    exact hqne hpair.symm
  · intro hN u v hu hv
    have canonical (t : ℕ × ℕ × ℕ)
        (ht : t.1 * star n + t.2.1 * star (n + 1) + t.2.2 * star (n + 2) = N) :
        t.2 = canonicalPair n p := by
      have hweight : pairWeight n t.2 ≤ N := by dsimp [pairWeight]; omega
      have hmt : pairWeight n t.2 ≡ pairWeight n (canonicalPair n p) [MOD star n] := by
        have h0 : pairWeight n t.2 ≡ N [MOD star n] := by
          have he : N = pairWeight n t.2 + t.1 * star n := by dsimp [pairWeight]; omega
          rw [he]
          simp [Nat.ModEq]
        exact h0.trans hm
      by_contra hne
      have h := (canonical_minimum n hn p t.2.1 t.2.2 hmt).2 hne
      change secondWeight n p ≤ pairWeight n t.2 at h
      omega
    have hu0 := canonical u hu
    have hv0 := canonical v hv
    apply Prod.ext
    · have hxy : u.1 * star n = v.1 * star n := by
        have he : u.2 = v.2 := hu0.trans hv0.symm
        have h1 := congrArg Prod.fst he
        have h2 := congrArg Prod.snd he
        rw [h1, h2] at hu
        omega
      exact Nat.eq_of_mul_eq_mul_right (star_pos n) hxy
    · exact hu0.trans hv0.symm

private theorem exceptional_card_eq_sum (n : ℕ) (hn : 6 ≤ n) :
    pSylvesterStarCount 1 n = ∑ p : Canonical n, secondWeight n p / star n := by
  let f : (Σ p : Canonical n, Fin (secondWeight n p / star n)) →
      {N : ℕ // starRepCount n N ≤ 1} := fun q =>
    ⟨(weightResidue n q.1).val + star n * q.2.val, by
      have hp : (weightResidue n q.1).val = secondWeight n q.1 % star n := by
        simp [weightResidue, secondWeight, Nat.add_mod]
      have hmod : (weightResidue n q.1).val + star n * q.2.val ≡
          pairWeight n (canonicalPair n q.1) [MOD star n] := by
        simp [Nat.ModEq, weightResidue, Nat.add_mod]
      apply (rep_le_one_iff_secondWeight n _ hn q.1 hmod).mpr
      have hq := Nat.mul_lt_mul_of_pos_left q.2.isLt (star_pos n)
      have he := Nat.mod_add_div (secondWeight n q.1) (star n)
      omega⟩
  have hi : Function.Injective f := by
    intro p q h
    have he : (weightResidue n p.1).val + star n * p.2.val =
        (weightResidue n q.1).val + star n * q.2.val := congrArg Subtype.val h
    have hr : weightResidue n p.1 = weightResidue n q.1 := by
      apply Fin.ext
      have hmod := congrArg (fun N => N % star n) he
      simpa only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (weightResidue n p.1).isLt,
        Nat.mod_eq_of_lt (weightResidue n q.1).isLt] using hmod
    have hpq := weightResidue_injective n hn hr
    cases p with
    | mk p i =>
      cases q with
      | mk q j =>
        dsimp at hpq he
        subst q
        have hij : i.val = j.val := by
          exact Nat.eq_of_mul_eq_mul_left (star_pos n) (Nat.add_left_cancel he)
        have hij' : i = j := Fin.ext hij
        subst j
        rfl
  have hs : Function.Surjective f := by
    intro N
    obtain ⟨p, hp⟩ := (weightResidue_bijective n hn).2
      ⟨N.val % star n, Nat.mod_lt _ (star_pos n)⟩
    have hpval : (weightResidue n p).val = N.val % star n := congrArg Fin.val hp
    have hm : N.val ≡ pairWeight n (canonicalPair n p) [MOD star n] := hpval.symm
    have hN := (rep_le_one_iff_secondWeight n N.val hn p hm).mp N.property
    have hmod : secondWeight n p % star n = N.val % star n := by
      rw [secondWeight]
      simpa [weightResidue, Nat.add_mod] using hpval
    have hdiv : N.val / star n < secondWeight n p / star n := by
      have h0 := Nat.mod_add_div N.val (star n)
      have h1 := Nat.mod_add_div (secondWeight n p) (star n)
      rw [hmod] at h1
      have hmul : star n * (N.val / star n) < star n * (secondWeight n p / star n) := by
        omega
      exact Nat.lt_of_mul_lt_mul_left hmul
    refine ⟨⟨p, ⟨N.val / star n, hdiv⟩⟩, ?_⟩
    apply Subtype.ext
    change (weightResidue n p).val + star n * (N.val / star n) = N.val
    rw [hpval]
    exact Nat.mod_add_div _ _
  rw [pSylvesterStarCount, ← Nat.card_congr (Equiv.ofBijective f ⟨hi, hs⟩),
    Nat.card_eq_fintype_card, Fintype.card_sigma]
  simp only [Fintype.card_fin]

private def secondPair (n : ℕ) : Canonical n → ℕ × ℕ
  | Sum.inl p => (2 * n + 1 + p.1.val, p.2.val)
  | Sum.inr (Sum.inl p) => (2 * n + 1 + p.1.val, n + 1 + p.2.val)
  | Sum.inr (Sum.inr (Sum.inl p)) => (2 * n - 10 + p.1.val, 2 * n + 1 + p.2.val)
  | Sum.inr (Sum.inr (Sum.inr p)) => (p.1.val, 3 * n + 1 + p.2.val)

private theorem secondPair_weight (n : ℕ) (hn : 6 ≤ n) (p : Canonical n) :
    pairWeight n (secondPair n p) = secondWeight n p := by
  rcases p with p | p | p | p
  · have he := reduce_left n (2 * n + 1 + p.1.val) p.2.val hn (by omega)
    have h0 : 2 * n + 1 + p.1.val - (2 * n + 1) = p.1.val := by omega
    simpa [secondPair, secondWeight, canonicalPair, secondGap, h0, Nat.add_comm] using he.symm
  · have he := reduce_left n (2 * n + 1 + p.1.val) (n + 1 + p.2.val) hn (by omega)
    have h0 : 2 * n + 1 + p.1.val - (2 * n + 1) = p.1.val := by omega
    have h1 : n + 1 + p.2.val + n = 2 * n + 1 + p.2.val := by omega
    simpa [secondPair, secondWeight, canonicalPair, secondGap, h0, h1,
      show n ≤ 2 * n + 1 + p.2.val by omega] using he.symm
  · have hy := p.1.isLt
    have hz := p.2.isLt
    have he := reduce_middle n (2 * n - 10 + p.1.val) (2 * n + 1 + p.2.val) hn
      (by omega) (by omega)
    have h0 : 2 * n - 10 + p.1.val - (2 * n - 10) = p.1.val := by omega
    have h1 : 2 * n + 1 + p.2.val - (2 * n + 1) = p.2.val := by omega
    simpa [secondPair, secondWeight, canonicalPair, secondGap, h0, h1, show ¬n ≤ p.2.val by omega,
      show p.1.val < 11 from hy] using he.symm
  · have hz := p.2.isLt
    have he := reduce_right n p.1.val (3 * n + 1 + p.2.val) hn (by omega)
    have h0 : 3 * n + 1 + p.2.val - (3 * n + 1) = p.2.val := by omega
    simpa [secondPair, secondWeight, canonicalPair, secondGap, h0, show ¬n ≤ p.2.val by omega,
      show ¬11 + p.1.val < 11 by omega, Nat.add_comm] using he.symm

private theorem fin_sum_twice (m : ℕ) :
    2 * (∑ i : Fin m, i.val) = m * (m - 1) := by
  rw [show (∑ i : Fin m, i.val) = ∑ i ∈ Finset.range m, i from
    Fin.sum_univ_eq_sum_range (fun i : ℕ => i) m]
  simpa [Nat.mul_comm] using Finset.sum_range_id_mul_two m

private theorem rectangle_sum_twice (b c m k y0 z0 : ℕ) :
    2 * (∑ i : Fin m, ∑ j : Fin k, ((y0 + i.val) * b + (z0 + j.val) * c)) =
      b * k * (2 * m * y0 + m * (m - 1)) +
        c * m * (2 * k * z0 + k * (k - 1)) := by
  simp only [add_mul, Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_id]
  calc
    _ = b * k * (2 * m * y0 + 2 * (∑ i : Fin m, i.val)) +
        c * m * (2 * k * z0 + 2 * (∑ j : Fin k, j.val)) := by ring
    _ = _ := by rw [fin_sum_twice, fin_sum_twice]

private theorem secondWeight_sum_twice (n : ℕ) (hn : 6 ≤ n) :
    2 * (∑ p : Canonical n, secondWeight n p) =
      star n * (2 * (25 * n ^ 3 + 23 * n ^ 2 + 14 * n + 1) + (star n - 1)) := by
  have hsum : (∑ p : Canonical n, secondWeight n p) =
      ∑ p : Canonical n, pairWeight n (secondPair n p) := by
    apply Finset.sum_congr rfl
    intro p _
    exact (secondPair_weight n hn p).symm
  rw [hsum]
  simp only [Fintype.sum_sum_type, Fintype.sum_prod_type, secondPair, pairWeight]
  have hA := rectangle_sum_twice (star (n + 1)) (star (n + 2)) (2 * n + 1) (n + 1)
    (2 * n + 1) 0
  have hB := rectangle_sum_twice (star (n + 1)) (star (n + 2)) (2 * n - 10) n
    (2 * n + 1) (n + 1)
  have hC := rectangle_sum_twice (star (n + 1)) (star (n + 2)) 11 n
    (2 * n - 10) (2 * n + 1)
  have hD := rectangle_sum_twice (star (n + 1)) (star (n + 2)) (2 * n - 10) n
    0 (3 * n + 1)
  simp only [Nat.zero_add] at hA hD
  rw [Nat.mul_add, Nat.mul_add, Nat.mul_add, hA, hB, hC, hD]
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 6 := ⟨n - 6, by omega⟩
  rw [show 2 * (k + 6) - 10 = 2 * k + 2 by omega]
  simp [star]
  ring

private theorem residue_sum_twice (n : ℕ) (hn : 6 ≤ n) :
    2 * (∑ p : Canonical n, secondWeight n p % star n) = star n * (star n - 1) := by
  have hsum : (∑ p : Canonical n, secondWeight n p % star n) =
      ∑ r : Fin (star n), r.val := by
    apply Fintype.sum_bijective (weightResidue n) (weightResidue_bijective n hn)
    intro p
    simp [secondWeight, weightResidue, Nat.add_mod]
  rw [hsum]
  exact fin_sum_twice (star n)

/-- **$1$-Sylvester number of three consecutive star numbers.** Write $S_m$ for the $m$-th star
number $6m(m-1)+1$. For every natural number $n \ge 6$, the number of natural numbers $N$ for
which at most one triple $(x, y, z)$ of natural numbers satisfies
$x S_n + y S_{n+1} + z S_{n+2} = N$ is $25n^3 + 23n^2 + 14n + 1$.

Source: "On p-Frobenius Numbers for the Numerical Semigroups
Generated by Three Consecutive Star Numbers", Theorem 2. -/
theorem pSylvesterCount_one_star
    (n : ℕ) (hn : 6 ≤ n) :
    pSylvesterStarCount 1 n =
      25 * n ^ 3 + 23 * n ^ 2 + 14 * n + 1 := by
  rw [exceptional_card_eq_sum n hn]
  have hsum : (∑ p : Canonical n, secondWeight n p / star n) * star n +
      (∑ p : Canonical n, secondWeight n p % star n) =
        ∑ p : Canonical n, secondWeight n p := by
    calc
      _ = ∑ p : Canonical n,
          (secondWeight n p / star n * star n + secondWeight n p % star n) := by
        rw [Finset.sum_add_distrib, ← Finset.sum_mul]
      _ = _ := by
        apply Finset.sum_congr rfl
        intro p _
        simpa [Nat.mul_comm, Nat.add_comm] using Nat.mod_add_div (secondWeight n p) (star n)
  have hweights := secondWeight_sum_twice n hn
  have hresidues := residue_sum_twice n hn
  have hscaled :
      (2 * (∑ p : Canonical n, secondWeight n p / star n)) * star n =
        (2 * (25 * n ^ 3 + 23 * n ^ 2 + 14 * n + 1)) * star n := by
    nlinarith [hsum, hweights, hresidues]
  have h := Nat.eq_of_mul_eq_mul_right (star_pos n) hscaled
  omega

end MathlibExt.NumberTheory.PFrobeniusStarNumbersWanted
