module

import Mathlib.Tactic.FieldSimp
public import MathlibExt.NumberTheory.IntPythagoreanTriples

/-!
# Products of Pythagorean triples through a cathetus

This module proves `pythagorean_cathetus_product`: the triple generated by `d₁ * d₂` through
the cathetus `a * b` satisfies the four Amato product equations in the triples generated by
`d₁` and `d₂` through `a` and `b`, and `d₁ * d₂` lies in Amato's cathetus parameter set
`C (a * b)`.

Source: Roberto Amato, *Groups and Monoid in the Set of Pythagorean Triples*, INTEGERS 24 (2024),
Article A5, Theorem 2 (quoting [1], [3]) (`integers-2024-A5-thm-2`).
-/

namespace MetaMathlibExt

/-- **Products of Pythagorean triples through a cathetus.** Let $a$ and $b$ be positive natural
numbers, and let $d_1 \in C(a)$ and $d_2 \in C(b)$, where $C(x)$ is Amato's cathetus parameter
set. Define the rational numbers $a_1 = a^2/(2 d_1) - d_1/2$, $a_2 = a^2/(2 d_1) + d_1/2$,
$b_1 = b^2/(2 d_2) - d_2/2$, $b_2 = b^2/(2 d_2) + d_2/2$,
$y = (ab)^2/(2 d_1 d_2) - d_1 d_2/2$ and $z = (ab)^2/(2 d_1 d_2) + d_1 d_2/2$, so that
$(a, a_1, a_2)$, $(b, b_1, b_2)$ and $(ab, y, z)$ are the triples generated by $d_1$, $d_2$ and
$d_1 d_2$ through $x^2/(2d) \mp d/2$. Then $y = a_1 b_2 + a_2 b_1$,
$z = a_1 b_2 + a_2 b_1 + d_1 d_2$, $y = a_1 b_1 + a_2 b_2 - d_1 d_2$, $z = a_1 b_1 + a_2 b_2$,
and $d_1 d_2 \in C(ab)$.

The source takes any triple $(ab, y, z)$ with $z - y = d_3 \in C(ab)$ and concludes
$d_3 = d_1 d_2$, which is false as printed: for $(3, 4, 5)$ taken twice ($d_1 = d_2 = 1$) and
$(9, 12, 15)$ ($d_3 = 3 \in C(9)$), $d_3 \ne d_1 d_2$ and $a_1 b_2 + a_2 b_1 = 40 \ne 12$.
Following the closing clause "with $d_3 = d_1 \cdot d_2$", the triple for $ab$ is the one
generated by $d_3 = d_1 d_2$.

Source: Roberto Amato, *Groups and Monoid in the Set of Pythagorean Triples*, INTEGERS 24 (2024),
Article A5, Theorem 2 (quoting [1], [3]) (`integers-2024-A5-thm-2`). -/
public theorem pythagorean_cathetus_product (a b d₁ d₂ : ℕ) (ha : 0 < a) (hb : 0 < b)
    (hd₁ : d₁ ∈ amatoCathetusParams a) (hd₂ : d₂ ∈ amatoCathetusParams b) :
    let a₁ : ℚ := (a : ℚ) ^ 2 / (2 * d₁) - d₁ / 2
    let a₂ : ℚ := (a : ℚ) ^ 2 / (2 * d₁) + d₁ / 2
    let b₁ : ℚ := (b : ℚ) ^ 2 / (2 * d₂) - d₂ / 2
    let b₂ : ℚ := (b : ℚ) ^ 2 / (2 * d₂) + d₂ / 2
    let y : ℚ := ((a : ℚ) * b) ^ 2 / (2 * (d₁ * d₂)) - d₁ * d₂ / 2
    let z : ℚ := ((a : ℚ) * b) ^ 2 / (2 * (d₁ * d₂)) + d₁ * d₂ / 2
    y = a₁ * b₂ + a₂ * b₁ ∧ z = a₁ * b₂ + a₂ * b₁ + d₁ * d₂ ∧
      y = a₁ * b₁ + a₂ * b₂ - d₁ * d₂ ∧ z = a₁ * b₁ + a₂ * b₂ ∧
      d₁ * d₂ ∈ amatoCathetusParams (a * b)
    := by
  obtain ⟨hd₁le, hd₁dvd, hd₁even⟩ := hd₁
  obtain ⟨hd₂le, hd₂dvd, hd₂even⟩ := hd₂
  have ha' : a ≠ 0 := ne_of_gt ha
  have hb' : b ≠ 0 := ne_of_gt hb
  have ha2 : a ^ 2 ≠ 0 := pow_ne_zero 2 ha'
  have hb2 : b ^ 2 ≠ 0 := pow_ne_zero 2 hb'
  have hd₁ne : d₁ ≠ 0 := by
    rintro rfl
    exact ha2 (zero_dvd_iff.mp hd₁dvd)
  have hd₂ne : d₂ ≠ 0 := by
    rintro rfl
    exact hb2 (zero_dvd_iff.mp hd₂dvd)
  have c1 : (d₁ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hd₁ne
  have c2 : (d₂ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hd₂ne
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · field_simp
    ring
  · field_simp
    ring
  · field_simp
    ring
  · field_simp
    ring
  · refine ⟨Nat.mul_le_mul hd₁le hd₂le, ?_, ?_⟩
    · rw [mul_pow]
      exact Nat.mul_dvd_mul hd₁dvd hd₂dvd
    · intro hev
      rw [Nat.even_mul] at hev
      have hmul : padicValNat 2 (a * b) = padicValNat 2 a + padicValNat 2 b := by
        simp only [Nat.padicValNat_def]
        exact Nat.multiplicity_mul ha' hb'
      obtain hev | hev := hev
      · obtain ⟨s, l, hs1, hsn, hldvd, rfl⟩ := hd₁even hev
        refine ⟨s, l * d₂, hs1, by omega, ?_, by ring⟩
        rw [mul_pow]
        exact Nat.mul_dvd_mul hldvd hd₂dvd
      · obtain ⟨s, l, hs1, hsn, hldvd, rfl⟩ := hd₂even hev
        refine ⟨s, d₁ * l, hs1, by omega, ?_, by ring⟩
        rw [mul_pow]
        exact Nat.mul_dvd_mul hd₁dvd hldvd

end MetaMathlibExt
