namespace FrobeniusDensity

open NumberField Ideal

section DegOneCount

variable (K : Type*) [Field K] [NumberField K]

open scoped Classical in
/-- **Degree-one prime count.** For a number field `K` and a natural number `ℓ`, `degOneCount K ℓ`
is the number of prime ideals of `𝓞 K` lying over `ℓ` whose residue ring has exactly `ℓ` elements,
that is, the primes of residue degree one over `ℓ`; it is `0` when `ℓ` is not prime. -/
@[expose] public noncomputable def degOneCount (ℓ : ℕ) : ℕ :=
  if ℓ.Prime then
    {𝔮 ∈ (ratPrimeIdeal ℓ).primesOver (𝓞 K) | Nat.card ((𝓞 K) ⧸ 𝔮) = ℓ}.ncard
  else 0

end DegOneCount

section AnalyticInput

variable (L : Type*) [Field L] [NumberField L] [IsGalois ℚ L]

/-- **Degree-one asymptotic over the fixed fields of a Galois extension.** For every subgroup `H`
of `Gal(L/ℚ)` and every finite set `S₀` of natural numbers, with `K = L^H` the fixed field of `H`,
the series `∑ ℓ ∉ S₀, degOneCount K ℓ * ℓ ^ (-s)` converges for every `s > 1`, and its sum plus
`log (s - 1)` is bounded as `s → 1⁺`. -/
@[expose] public def DegOneAsymptotic : Prop :=
  ∀ (H : Subgroup (L ≃ₐ[ℚ] L)) (S₀ : Finset ℕ),
    (∀ s : ℝ, 1 < s → Summable (fun ℓ : ℕ => (if ℓ ∈ S₀ then 0 else
        (degOneCount (FixedPoints.intermediateField H : IntermediateField ℚ L) ℓ : ℝ))
      * (ℓ : ℝ) ^ (-s))) ∧
    (fun s : ℝ => (∑' ℓ : ℕ, (if ℓ ∈ S₀ then 0 else
        (degOneCount (FixedPoints.intermediateField H : IntermediateField ℚ L) ℓ : ℝ))
      * (ℓ : ℝ) ^ (-s)) + Real.log (s - 1)) =O[𝓝[>] 1] (fun _ => (1 : ℝ))

end AnalyticInput

end FrobeniusDensity


namespace FrobeniusDensity

open NumberField Ideal IsDedekindDomain UniqueFactorizationMonoid

section DegOneCount

variable (K : Type*) [Field K] [NumberField K]

omit [NumberField K] in
/-- **Degree-one count at a non-prime.** `degOneCount K ℓ = 0` when `ℓ` is not prime. -/
public theorem degOneCount_of_not_prime {ℓ : ℕ} (hℓ : ¬ ℓ.Prime) : degOneCount K ℓ = 0 := by
  rw [degOneCount, ite_eq_right hℓ]

omit [NumberField K] in
/-- **Degree-one count at a prime.** For a prime `ℓ`, `degOneCount K ℓ` is the number of prime
ideals of `𝓞 K` lying over `ℓ` whose residue ring has `ℓ` elements. -/
public theorem degOneCount_of_prime {ℓ : ℕ} (hℓ : ℓ.Prime) :
    degOneCount K ℓ
      = {𝔮 ∈ (ratPrimeIdeal ℓ).primesOver (𝓞 K) | Nat.card ((𝓞 K) ⧸ 𝔮) = ℓ}.ncard := by
  rw [degOneCount, ite_eq_left hℓ]

end DegOneCount

end FrobeniusDensity


