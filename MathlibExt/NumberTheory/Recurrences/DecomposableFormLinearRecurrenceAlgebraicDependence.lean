module

public import Mathlib.Algebra.LinearRecurrence
public import Mathlib.Basic.Complex.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.Defs
import Mathlib.Algebra.Algebra.Pi
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
import MathlibExt.NumberTheory.Recurrences.HomogeneousFormLinearRecurrence

/-! # Algebraic dependence of linear recurrence sequences

For an order-`k` complex linear recurrence with characteristic polynomial `χ`, any `k`
sequences satisfying the recurrence at every integer index, together with `n ↦ (-χ(0)) ^ n`,
are algebraically dependent over `ℂ`. The recurrence need not be minimal for any sequence.
Unlike the source, the statement also allows zero constant coefficient (the power sequence
is idempotent) and order zero (the power sequence squares to one).

## References

* Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by Linear
  Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, pp. 1–19,
  Corollary 4 and Theorem 1 (equation (22)).
* `MathlibExt.NumberTheory.Recurrences.HomogeneousFormLinearRecurrence`,
  `MetaMathlibExt.exists_homogeneous_form_eval_eq_pow_of_linearRecurrence`.
-/

namespace MetaMathlibExt

/-- **Algebraic dependence of recurrence sequences and a power sequence.** Let $k$ be a natural
number, let $\gamma_0, \dots, \gamma_{k-1} \in \mathbb{C}$ and let
$\chi(x) = x^k - \sum_{i<k} \gamma_i x^i$. Let
$G^{(1)}, \dots, G^{(k)} \colon \mathbb{Z} \to \mathbb{C}$ be sequences such that
$G^{(j)}_{n+k} = \sum_{i<k} \gamma_i G^{(j)}_{n+i}$ for every $j$ and every $n \in \mathbb{Z}$.
Then the family of the $k + 1$ sequences $G^{(1)}, \dots, G^{(k)}$ and $n \mapsto (-\chi(0))^n$
(integer powers, with $0^n = 0$ for $n < 0$) is not algebraically independent over $\mathbb{C}$
in the $\mathbb{C}$-algebra of all sequences $\mathbb{Z} \to \mathbb{C}$.

For $k \ge 1$ we have $\chi(0) = -\gamma_0$, so the last sequence is $n \mapsto \gamma_0^n$.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Corollary 4
(`jis-2024-24.3.5-cor-4`). -/
public theorem not_algebraicIndependent_linearRecurrence_solutions_pow
    (E : LinearRecurrence ℂ) (G : Fin E.order → ℤ → ℂ)
    (hG : ∀ j (n : ℤ), G j (n + E.order) = ∑ i, E.coeffs i * G j (n + (i : ℕ))) :
    ¬ AlgebraicIndependent ℂ fun o : Option (Fin E.order) =>
      o.elim (fun n : ℤ => (-E.charPoly.coeff 0) ^ n) G := by
  let a (n : ℤ) : ℂ := (-E.charPoly.coeff 0) ^ n
  let S := Algebra.adjoin ℂ (Set.range G)
  intro h
  obtain ⟨hGind, ha⟩ := AlgebraicIndependent.option_iff.mp h
  apply ha
  change IsAlgebraic S a
  by_cases hc : E.charPoly.coeff 0 = 0
  · have ha₂ : a ^ 2 = a := by
      funext n
      simp only [Pi.pow_apply, a, hc, neg_zero, pow_two, ← mul_zpow, zero_mul]
    refine ⟨Polynomial.X ^ 2 - Polynomial.X, ?_, by simp [ha₂]⟩
    exact (Polynomial.monic_X_pow_sub (n := 2) (by simp)).ne_zero
  by_cases hk : E.order = 0
  · have : IsEmpty (Fin E.order) := Fin.isEmpty_iff.mpr hk
    have hcoeff : E.charPoly.coeff 0 = 1 := by
      simp [LinearRecurrence.charPoly, hk]
    have ha₂ : a ^ 2 = 1 := by
      funext n
      simp [a, hcoeff, pow_two, ← mul_zpow]
    exact IsAlgebraic.of_pow (n := 2) (by decide) (ha₂.symm ▸ isAlgebraic_one)
  obtain ⟨F, _, hF⟩ :=
    exists_homogeneous_form_eval_eq_pow_of_linearRecurrence E G hG hGind.linearIndependent
  have ha₂ : a ^ 2 = MvPolynomial.aeval G (F ^ 2) := by
    funext n
    have hpoint := MvPolynomial.comp_aeval_apply G (Pi.evalAlgHom ℂ (fun _ : ℤ ↦ ℂ) n) F
    change (MvPolynomial.aeval G F) n = MvPolynomial.eval (fun j ↦ G j n) F at hpoint
    simp only [map_pow, Pi.pow_apply, hpoint, hF]
    change ((-E.charPoly.coeff 0) ^ n) ^ 2 = (((-1) ^ E.order * E.charPoly.coeff 0) ^ n) ^ 2
    simp only [pow_two, ← mul_zpow, neg_mul_neg]
    rw [mul_mul_mul_comm, ← mul_pow]
    simp
  let c : S := ⟨MvPolynomial.aeval G (F ^ 2), by
    change MvPolynomial.aeval G (F ^ 2) ∈ Algebra.adjoin ℂ (Set.range G)
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨F ^ 2, rfl⟩⟩
  refine IsAlgebraic.of_pow (n := 2) (by decide) ?_
  rw [ha₂]
  exact isAlgebraic_algebraMap c

end MetaMathlibExt
