module

public import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.QuadraticAlgebra.Basic
import Mathlib.Tactic.Ring.Basic

/-!
# Quadratic form identity for binary recurrences

The quadratic form determined by two solutions of a binary recurrence evaluates at index
`n` to `(-B) ^ n` times the square of their initial determinant.
-/

namespace MetaMathlibExt

open scoped QuadraticAlgebra

/-- **Quadratic form identity for binary recurrences.** Let $R$ be a commutative ring, let
$A, B \in R$, and let $(G_n)_{n \ge 0}$ and $(H_n)_{n \ge 0}$ be sequences in $R$ with
$G_{n+2} = A G_{n+1} + B G_n$ and $H_{n+2} = A H_{n+1} + B H_n$ for all $n \ge 0$. Put
$C_G = G_1^2 - A G_0 G_1 - B G_0^2$, $C_H = H_1^2 - A H_0 H_1 - B H_0^2$,
$E_{10} = G_1 H_1 - A G_1 H_0 - B G_0 H_0$, $E_{01} = G_1 H_1 - A G_0 H_1 - B G_0 H_0$ and
$\Delta = G_0 H_1 - G_1 H_0$. Then for every $n \ge 0$,
$$C_H G_n^2 - (E_{10} + E_{01}) G_n H_n + C_G H_n^2 = (-B)^n \Delta^2.$$

The source assumes $\Delta \neq 0$; the identity holds without it, since it is polynomial in the
initial values. The notation follows Section 6.1 of arXiv:2308.13817v1.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 9
(`jis-2024-24.3.5-thm-9`). -/
public theorem binary_recurrence_quadratic_form_eq_neg_pow_mul_sq {R : Type*} [CommRing R]
    (A B : R) (G H : ℕ → R) (hG : ∀ n, G (n + 2) = A * G (n + 1) + B * G n)
    (hH : ∀ n, H (n + 2) = A * H (n + 1) + B * H n) (n : ℕ) :
    (H 1 ^ 2 - A * H 0 * H 1 - B * H 0 ^ 2) * G n ^ 2 -
        ((G 1 * H 1 - A * G 1 * H 0 - B * G 0 * H 0) +
          (G 1 * H 1 - A * G 0 * H 1 - B * G 0 * H 0)) * G n * H n +
        (G 1 ^ 2 - A * G 0 * G 1 - B * G 0 ^ 2) * H n ^ 2 =
      (-B) ^ n * (G 0 * H 1 - G 1 * H 0) ^ 2 := by
  let w : QuadraticAlgebra R B A := ω
  -- The coefficients of w ^ k express the kth term in terms of the two initial values.
  have term (k : ℕ) (U : ℕ → R) (hU : ∀ j, U (j + 2) = A * U (j + 1) + B * U j) :
      U k = (w ^ k).re * U 0 + (w ^ k).im * U 1 := by
    induction k generalizing U with
    | zero => simp
    | succ k ih =>
      have h := ih (fun j => U (j + 1)) (fun j => hU (j + 1))
      change U (k + 1) = (w ^ k).re * U 1 + (w ^ k).im * U 2 at h
      rw [h, hU 0, pow_succ]
      simp [w]
      ring
  have hnorm : (w ^ n).norm = (-B) ^ n := by
    rw [map_pow]
    simp [w, QuadraticAlgebra.norm_def]
  rw [term n G hG, term n H hH, ← hnorm, QuadraticAlgebra.norm_def]
  ring

end MetaMathlibExt
