/-!
# Integer decomposable forms on integer recurrence sequences

For `k` integer solutions of an order-`k` integer linear recurrence whose matrix of
initial values has nonzero determinant, the resultant of the characteristic polynomial
with the adjugate linear system is an integer polynomial in `k` variables. Over `ℂ` it
factors as a product of `k` linear forms, and it evaluates on the sequences to the `k`th
power of the initial determinant times the powers of the signed constant term of the
characteristic polynomial.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 6
(`jis-2024-24.3.5-thm-6`).
-/

namespace MetaMathlibExt

namespace exists_int_decomposable_form_eval_eq_det_pow_mul_pow

private def recC (E : LinearRecurrence ℤ) : LinearRecurrence ℂ :=
  ⟨E.order, fun i => (E.coeffs i : ℂ)⟩

private noncomputable def charPolyC (E : LinearRecurrence ℤ) : Polynomial ℂ :=
  E.charPoly.map (Int.castRingHom ℂ)

private noncomputable def linForm (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ)
    (t : Fin E.order) : MvPolynomial (Fin E.order) ℤ :=
  ∑ j, MvPolynomial.C ((Matrix.of fun j i : Fin E.order => G j i).adjugate t j) *
    MvPolynomial.X j

private noncomputable def polyP (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) :
    Polynomial (MvPolynomial (Fin E.order) ℤ) :=
  ∑ t, Polynomial.C (linForm E G t) * Polynomial.X ^ (t : ℕ)

private noncomputable def formF (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) :
    MvPolynomial (Fin E.order) ℤ :=
  Polynomial.resultant (E.charPoly.map MvPolynomial.C) (polyP E G) E.order E.order

private def phiAt (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) (n : ℕ) :
    MvPolynomial (Fin E.order) ℤ →+* ℤ :=
  MvPolynomial.eval₂Hom (RingHom.id ℤ) (fun j => G j n)

private theorem charPoly_natDegree (E : LinearRecurrence ℤ) :
    E.charPoly.natDegree = E.order :=
  Polynomial.natDegree_eq_of_degree_eq_some E.charPoly_degree_eq_order

private theorem charPolyC_monic (E : LinearRecurrence ℤ) : (charPolyC E).Monic :=
  Polynomial.Monic.map (Int.castRingHom ℂ) E.charPoly_monic

private theorem charPolyC_natDegree (E : LinearRecurrence ℤ) :
    (charPolyC E).natDegree = E.order := by
  have h : (E.charPoly.map (Int.castRingHom ℂ)).natDegree = E.charPoly.natDegree :=
    Polynomial.natDegree_map_eq_of_injective Int.cast_injective _
  rw [charPoly_natDegree E] at h
  exact h

private theorem charPolyC_splits (E : LinearRecurrence ℤ) : (charPolyC E).Splits :=
  IsAlgClosed.splits _

private theorem charPolyC_card_roots (E : LinearRecurrence ℤ) :
    (charPolyC E).roots.card = E.order := by
  rw [← (charPolyC_splits E).natDegree_eq_card_roots, charPolyC_natDegree E]

private theorem exists_root_enum (E : LinearRecurrence ℤ) :
    ∃ r : Fin E.order → ℂ, (charPolyC E).roots = ↑(List.ofFn r) := by
  classical
  set l := (charPolyC E).roots.toList with hl
  have hlen : l.length = E.order := by
    rw [hl, Multiset.length_toList, charPolyC_card_roots E]
  have hof : List.ofFn (fun i : Fin E.order => List.get l (Fin.cast hlen.symm i)) = l := by
    rw [← List.ofFn_congr hlen (List.get l), List.ofFn_get]
  refine ⟨fun i => List.get l (Fin.cast hlen.symm i), ?_⟩
  rw [hof, hl]
  exact (Multiset.coe_toList _).symm

private theorem factor_charPolyC (E : LinearRecurrence ℤ) (r : Fin E.order → ℂ)
    (hr : (charPolyC E).roots = ↑(List.ofFn r)) :
    charPolyC E = ∏ i, (Polynomial.X - Polynomial.C (r i)) := by
  have h := (charPolyC_splits E).eq_prod_roots_of_monic (charPolyC_monic E)
  rw [hr, Multiset.map_coe, Multiset.prod_coe, List.map_ofFn, List.prod_ofFn] at h
  simpa [Function.comp_apply] using h

private theorem mem_roots_of_enum (E : LinearRecurrence ℤ) (r : Fin E.order → ℂ)
    (hr : (charPolyC E).roots = ↑(List.ofFn r)) (i : Fin E.order) :
    (charPolyC E).IsRoot (r i) := by
  apply Polynomial.isRoot_of_mem_roots
  rw [hr, Multiset.mem_coe, List.mem_ofFn']
  exact ⟨i, rfl⟩

private theorem prod_roots_eq_prod_enum (E : LinearRecurrence ℤ) (r : Fin E.order → ℂ)
    (hr : (charPolyC E).roots = ↑(List.ofFn r)) :
    (charPolyC E).roots.prod = ∏ i, r i := by
  rw [hr, Multiset.prod_coe, List.prod_ofFn]

private theorem prod_enum_eq (E : LinearRecurrence ℤ) (r : Fin E.order → ℂ)
    (hr : (charPolyC E).roots = ↑(List.ofFn r)) :
    ∏ i, r i = (-1) ^ E.order * (charPolyC E).coeff 0 := by
  have h0 := (charPolyC_splits E).coeff_zero_eq_prod_roots_of_monic (charPolyC_monic E)
  rw [charPolyC_natDegree E, prod_roots_eq_prod_enum E r hr] at h0
  calc ∏ i, r i = 1 * ∏ i, r i := (one_mul _).symm
    _ = ((-1 : ℂ) * (-1)) ^ E.order * ∏ i, r i := by simp
    _ = (-1 : ℂ) ^ E.order * ((-1) ^ E.order * ∏ i, r i) := by
      rw [mul_pow, mul_assoc]
    _ = (-1 : ℂ) ^ E.order * (charPolyC E).coeff 0 := by rw [← h0]

private theorem resultant_eq_prod_eval_of_factor {R : Type*} [CommRing R] [Nontrivial R]
    {k : ℕ} (χ Q : Polynomial R) (r : Fin k → R) (m n : ℕ)
    (hfac : χ = ∏ i, (Polynomial.X - Polynomial.C (r i)))
    (hm : (∏ i, (Polynomial.X - Polynomial.C (r i)) : Polynomial R).natDegree = m)
    (hn : Q.natDegree ≤ n) :
    Polynomial.resultant χ Q m n = ∏ i, Polynomial.eval (r i) Q := by
  have hlead : ∀ i ∈ Finset.univ,
      (Polynomial.X - Polynomial.C (r i) : Polynomial R).leadingCoeff = 1 :=
    fun i _ => Polynomial.monic_X_sub_C _
  have hf' : ∏ i ∈ Finset.univ,
      (Polynomial.X - Polynomial.C (r i) : Polynomial R).leadingCoeff ≠ 0 := by
    rw [Finset.prod_eq_one hlead]
    exact one_ne_zero
  rw [hfac, ← hm, Polynomial.resultant_prod_left _ _ _ _ hf' hn]
  refine Finset.prod_congr rfl fun i _ => ?_
  simp only [Polynomial.natDegree_X_sub_C]
  exact Polynomial.resultant_X_sub_C_left _ _ _ hn

private theorem recC_charPoly (E : LinearRecurrence ℤ) : (recC E).charPoly = charPolyC E := by
  unfold recC charPolyC LinearRecurrence.charPoly
  simp [Polynomial.map_sub, Polynomial.map_sum, Polynomial.map_monomial]

private theorem recC_isSolution_cast (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ)
    (hG : ∀ j, E.IsSolution (G j)) (j : Fin E.order) :
    (recC E).IsSolution (fun m => ((G j m : ℤ) : ℂ)) := by
  intro m
  change ((G j (m + E.order) : ℤ) : ℂ)
    = ∑ i, ((E.coeffs i : ℤ) : ℂ) * ((G j (m + (i : ℕ)) : ℤ) : ℂ)
  rw [hG j m]
  push_cast
  rfl

private theorem eval_eq_det_mul_pow (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ)
    (hG : ∀ j, E.IsSolution (G j)) (n : ℕ) (s : ℂ) (hs : (charPolyC E).IsRoot s) :
    Polynomial.eval s (((polyP E G).map (phiAt E G n)).map (Int.castRingHom ℂ)) =
      ((Matrix.of fun j i : Fin E.order => G j i).det : ℂ) * s ^ n := by
  set A : Matrix (Fin E.order) (Fin E.order) ℤ :=
    Matrix.of fun j i : Fin E.order => G j i with hA
  set d : Fin E.order → ℂ :=
    fun j => ∑ t, ((A.adjugate t j : ℤ) : ℂ) * s ^ (t : ℕ) with hd
  set u : ℕ → ℂ := fun m => ∑ j, ((G j m : ℤ) : ℂ) * d j with hu
  set w : ℕ → ℂ := fun m => ((A.det : ℤ) : ℂ) * s ^ m with hw
  have hAj : ∀ j a, A j a = G j (a : ℕ) := by
    intro j a
    rw [hA]
    exact Matrix.of_apply _ _ _
  have hentry : ∀ t a : Fin E.order,
      (∑ j, ((A.adjugate t j : ℤ) : ℂ) * ((G j (a : ℕ) : ℤ) : ℂ))
        = (if t = a then ((A.det : ℤ) : ℂ) else 0) := by
    intro t a
    have h1 : (∑ j, A.adjugate t j * A j a)
        = A.det * (if t = a then (1 : ℤ) else 0) := by
      have h := congrArg (fun M : Matrix (Fin E.order) (Fin E.order) ℤ => M t a)
        (Matrix.adjugate_mul A)
      rw [Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul, Matrix.one_apply] at h
      exact h
    have hcast : ((∑ j, A.adjugate t j * A j a : ℤ) : ℂ)
        = ∑ j, ((A.adjugate t j : ℤ) : ℂ) * ((A j a : ℤ) : ℂ) := by
      push_cast
      rfl
    simp only [← hAj]
    rw [← hcast, h1]
    by_cases hta : t = a <;> simp [hta]
  have hs' : ((recC E).charPoly).IsRoot s := by
    rw [recC_charPoly E]
    exact hs
  have hgeom : (recC E).IsSolution (fun n => s ^ n) :=
    ((recC E).geom_sol_iff_root_charPoly s).mpr hs'
  have hu_sol : (recC E).IsSolution u := by
    intro m
    change (∑ j, ((G j (m + E.order) : ℤ) : ℂ) * d j)
      = ∑ i, ((E.coeffs i : ℤ) : ℂ) * (∑ j, ((G j (m + (i : ℕ)) : ℤ) : ℂ) * d j)
    have hGj : ∀ j, ((G j (m + E.order) : ℤ) : ℂ)
        = ∑ i, ((E.coeffs i : ℤ) : ℂ) * ((G j (m + (i : ℕ)) : ℤ) : ℂ) :=
      fun j => recC_isSolution_cast E G hG j m
    simp only [hGj, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  have hw_sol : (recC E).IsSolution w := by
    intro m
    change ((A.det : ℤ) : ℂ) * s ^ (m + E.order)
      = ∑ i, ((E.coeffs i : ℤ) : ℂ) * (((A.det : ℤ) : ℂ) * s ^ (m + (i : ℕ)))
    have h : s ^ (m + E.order) = ∑ i, ((E.coeffs i : ℤ) : ℂ) * s ^ (m + (i : ℕ)) :=
      hgeom m
    rw [h, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  have hinit : ∀ a : Fin E.order, u a = w a := by
    intro a
    change (∑ j, ((G j (a : ℕ) : ℤ) : ℂ) * d j) = ((A.det : ℤ) : ℂ) * s ^ (a : ℕ)
    have hd' : ∀ j, d j = ∑ t, ((A.adjugate t j : ℤ) : ℂ) * s ^ (t : ℕ) :=
      fun j => rfl
    have hinner : ∀ t : Fin E.order,
        (∑ j, ((G j (a : ℕ) : ℤ) : ℂ) * (((A.adjugate t j : ℤ) : ℂ) * s ^ (t : ℕ)))
          = ((if t = a then ((A.det : ℤ) : ℂ) else 0)) * s ^ (t : ℕ) := by
      intro t
      have hsum : (∑ j, ((G j (a : ℕ) : ℤ) : ℂ) * (((A.adjugate t j : ℤ) : ℂ) * s ^ (t : ℕ)))
          = (∑ j, ((A.adjugate t j : ℤ) : ℂ) * ((G j (a : ℕ) : ℤ) : ℂ)) * s ^ (t : ℕ) := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        ring
      rw [hsum, hentry t a]
    have hite : ∀ t : Fin E.order,
        ((if t = a then ((A.det : ℤ) : ℂ) else 0)) * s ^ (t : ℕ)
          = (if t = a then ((A.det : ℤ) : ℂ) * s ^ (t : ℕ) else 0) := by
      intro t
      by_cases hta : t = a <;> simp [hta]
    simp only [hd', Finset.mul_sum]
    rw [Finset.sum_comm]
    simp only [hinner, hite, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  have heq : ∀ m, u m = w m := by
    have hu' : u = (recC E).mkSol (fun a => u a) :=
      (recC E).eq_mk_of_is_sol_of_eq_init' hu_sol (fun a => rfl)
    have hw' : w = (recC E).mkSol (fun a => u a) :=
      (recC E).eq_mk_of_is_sol_of_eq_init' hw_sol (fun a => (hinit a).symm)
    intro m
    rw [hu', hw']
  have hphi : ∀ t : Fin E.order, phiAt E G n (linForm E G t)
      = ∑ j, A.adjugate t j * G j n := by
    intro t
    have hlin : linForm E G t
        = ∑ j, MvPolynomial.C (A.adjugate t j) * MvPolynomial.X j := rfl
    rw [hlin, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul]
    have hC : phiAt E G n (MvPolynomial.C (A.adjugate t j)) = A.adjugate t j := by
      change (MvPolynomial.eval₂Hom (RingHom.id ℤ) (fun j => G j n))
        (MvPolynomial.C (A.adjugate t j)) = _
      rw [MvPolynomial.eval₂Hom_C, RingHom.id_apply]
    have hX : phiAt E G n (MvPolynomial.X j) = G j n := by
      change MvPolynomial.eval (fun j => G j n) (MvPolynomial.X j) = _
      exact MvPolynomial.eval_X j
    rw [hC, hX]
  have hQ : ((polyP E G).map (phiAt E G n)).map (Int.castRingHom ℂ)
      = ∑ t, Polynomial.C (((phiAt E G n) (linForm E G t) : ℤ) : ℂ)
        * Polynomial.X ^ (t : ℕ) := by
    have hP : polyP E G
        = ∑ t, Polynomial.C (linForm E G t) * Polynomial.X ^ (t : ℕ) := rfl
    rw [hP, Polynomial.map_sum, Polynomial.map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_C,
      Polynomial.map_pow, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_X]
    rfl
  have heval : Polynomial.eval s (((polyP E G).map (phiAt E G n)).map (Int.castRingHom ℂ))
      = ∑ t, (((phiAt E G n) (linForm E G t) : ℤ) : ℂ) * s ^ (t : ℕ) := by
    rw [hQ]
    change (Polynomial.evalRingHom s) _ = _
    rw [map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    change Polynomial.eval s _ = _
    rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  have hconn : (∑ t, (((phiAt E G n) (linForm E G t) : ℤ) : ℂ) * s ^ (t : ℕ)) = u n := by
    have hcast : ∀ t, (((phiAt E G n) (linForm E G t) : ℤ) : ℂ)
        = ∑ j, ((A.adjugate t j : ℤ) : ℂ) * ((G j n : ℤ) : ℂ) := by
      intro t
      rw [hphi t]
      push_cast
      rfl
    change (∑ t, (((phiAt E G n) (linForm E G t) : ℤ) : ℂ) * s ^ (t : ℕ))
      = ∑ j, ((G j n : ℤ) : ℂ) * d j
    simp only [hcast, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hd'' : d j = ∑ t, ((A.adjugate t j : ℤ) : ℂ) * s ^ (t : ℕ) := rfl
    rw [hd'', Finset.mul_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    ring
  rw [heval, hconn]
  exact heq n

private theorem polyP_natDegree_le (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) :
    (polyP E G).natDegree ≤ E.order := by
  have hP : polyP E G
      = ∑ t, Polynomial.C (linForm E G t) * Polynomial.X ^ (t : ℕ) := rfl
  rw [hP]
  apply Polynomial.natDegree_sum_le_of_forall_le _ _ _
  intro t _
  calc (Polynomial.C (linForm E G t) * Polynomial.X ^ (t : ℕ) :
        Polynomial (MvPolynomial (Fin E.order) ℤ)).natDegree
      ≤ (Polynomial.C (linForm E G t)).natDegree
        + (Polynomial.X ^ (t : ℕ) : Polynomial (MvPolynomial (Fin E.order) ℤ)).natDegree :=
        Polynomial.natDegree_mul_le
    _ ≤ 0 + (t : ℕ) := by
        have hC : (Polynomial.C (linForm E G t)).natDegree ≤ 0 := by
          simp [Polynomial.natDegree_C]
        have hX : (Polynomial.X ^ (t : ℕ) :
            Polynomial (MvPolynomial (Fin E.order) ℤ)).natDegree ≤ (t : ℕ) := by
          calc _ ≤ (t : ℕ)
              * (Polynomial.X : Polynomial (MvPolynomial (Fin E.order) ℤ)).natDegree :=
                Polynomial.natDegree_pow_le
            _ = (t : ℕ) := by rw [Polynomial.natDegree_X, mul_one]
        omega
    _ = (t : ℕ) := zero_add _
    _ ≤ E.order := Nat.le_of_lt t.2

private theorem map_formF_eq_prod (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) :
    ∃ L : Fin E.order → MvPolynomial (Fin E.order) ℂ, (∀ i, (L i).IsHomogeneous 1) ∧
      MvPolynomial.map (Int.castRingHom ℂ) (formF E G) = ∏ i, L i := by
  classical
  obtain ⟨r, hr⟩ := exists_root_enum E
  have hfacC : charPolyC E = ∏ i, (Polynomial.X - Polynomial.C (r i)) :=
    factor_charPolyC E r hr
  have hfacY : (charPolyC E).map MvPolynomial.C
      = ∏ i, (Polynomial.X - Polynomial.C (MvPolynomial.C (r i)) :
        Polynomial (MvPolynomial (Fin E.order) ℂ)) := by
    rw [hfacC, Polynomial.map_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  have hdegY : (∏ i, (Polynomial.X - Polynomial.C (MvPolynomial.C (r i)) :
      Polynomial (MvPolynomial (Fin E.order) ℂ))).natDegree = E.order := by
    simpa only [Finset.card_univ, Fintype.card_fin] using
      (Polynomial.natDegree_finsetProd_X_sub_C_eq_card (Finset.univ : Finset (Fin E.order))
        (fun i => MvPolynomial.C (r i)))
  have hPle : (((polyP E G).map (MvPolynomial.map (Int.castRingHom ℂ))).natDegree)
      ≤ E.order :=
    Polynomial.natDegree_map_le.trans (polyP_natDegree_le E G)
  have hfactor := resultant_eq_prod_eval_of_factor
    ((charPolyC E).map MvPolynomial.C)
    ((polyP E G).map (MvPolynomial.map (Int.castRingHom ℂ)))
    (fun i => MvPolynomial.C (r i)) E.order E.order
    hfacY hdegY hPle
  have hmap : MvPolynomial.map (Int.castRingHom ℂ) (formF E G)
      = Polynomial.resultant ((charPolyC E).map MvPolynomial.C)
        ((polyP E G).map (MvPolynomial.map (Int.castRingHom ℂ))) E.order E.order := by
    have hF : formF E G
        = Polynomial.resultant (E.charPoly.map MvPolynomial.C) (polyP E G) E.order E.order :=
      rfl
    rw [hF, ← Polynomial.resultant_map_map]
    congr 1
    unfold charPolyC
    rw [Polynomial.map_map]
    have hcomp : ((MvPolynomial.map (Int.castRingHom ℂ)).comp MvPolynomial.C :
        ℤ →+* MvPolynomial (Fin E.order) ℂ)
        = MvPolynomial.C.comp (Int.castRingHom ℂ) := by
      ext a
      simp
    rw [hcomp, ← Polynomial.map_map]
  have hMhom : ∀ t : Fin E.order,
      ((MvPolynomial.map (Int.castRingHom ℂ)) (linForm E G t)).IsHomogeneous 1 := by
    intro t
    refine MvPolynomial.IsHomogeneous.map ?_ _
    have hlin : linForm E G t
        = ∑ j, MvPolynomial.C
          ((Matrix.of fun j i : Fin E.order => G j i).adjugate t j) * MvPolynomial.X j := rfl
    rw [hlin]
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ => ?_
    exact MvPolynomial.isHomogeneous_C_mul_X _ _
  have hPmap : (polyP E G).map (MvPolynomial.map (Int.castRingHom ℂ))
      = ∑ t, Polynomial.C ((MvPolynomial.map (Int.castRingHom ℂ)) (linForm E G t))
        * Polynomial.X ^ (t : ℕ) := by
    have hP : polyP E G
        = ∑ t, Polynomial.C (linForm E G t) * Polynomial.X ^ (t : ℕ) := rfl
    rw [hP, Polynomial.map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
  refine ⟨fun i => Polynomial.eval (MvPolynomial.C (r i))
    ((polyP E G).map (MvPolynomial.map (Int.castRingHom ℂ))), ?_, ?_⟩
  · intro i
    rw [hPmap]
    change ((Polynomial.evalRingHom (MvPolynomial.C (r i))) _).IsHomogeneous 1
    rw [map_sum]
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun t _ => ?_
    change (Polynomial.eval (MvPolynomial.C (r i)) _).IsHomogeneous 1
    rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    have h0 := (MvPolynomial.isHomogeneous_C (Fin E.order) (r i)).pow (t : ℕ)
    have h1 := (hMhom t).mul h0
    simpa using h1
  · rw [hmap, hfactor]

private theorem eval_formF_eq (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ)
    (hG : ∀ j, E.IsSolution (G j)) (n : ℕ) :
    MvPolynomial.eval (fun j => G j n) (formF E G) =
      (Matrix.of fun j i : Fin E.order => G j i).det ^ E.order *
        ((-1) ^ E.order * E.charPoly.coeff 0) ^ n := by
  classical
  obtain ⟨r, hr⟩ := exists_root_enum E
  have hfacC : charPolyC E = ∏ i, (Polynomial.X - Polynomial.C (r i)) :=
    factor_charPolyC E r hr
  have hmem : ∀ i, (charPolyC E).IsRoot (r i) := fun i => mem_roots_of_enum E r hr i
  have hprod : ∏ i, r i = (-1) ^ E.order * (charPolyC E).coeff 0 :=
    prod_enum_eq E r hr
  have hdeg : (∏ i, (Polynomial.X - Polynomial.C (r i) : Polynomial ℂ)).natDegree
      = E.order := by
    simpa only [Finset.card_univ, Fintype.card_fin] using
      (Polynomial.natDegree_finsetProd_X_sub_C_eq_card (Finset.univ : Finset (Fin E.order)) r)
  have hroot_eval : ∀ i, Polynomial.eval (r i)
      (((polyP E G).map (phiAt E G n)).map (Int.castRingHom ℂ))
      = ((Matrix.of fun j i : Fin E.order => G j i).det : ℂ) * (r i) ^ n :=
    fun i => eval_eq_det_mul_pow E G hG n (r i) (hmem i)
  have hQle : ((((polyP E G).map (phiAt E G n))).map (Int.castRingHom ℂ)).natDegree
      ≤ E.order :=
    Polynomial.natDegree_map_le.trans
      (Polynomial.natDegree_map_le.trans (polyP_natDegree_le E G))
  have hfactor := resultant_eq_prod_eval_of_factor
    (charPolyC E) ((((polyP E G).map (phiAt E G n))).map (Int.castRingHom ℂ))
    r E.order E.order hfacC hdeg hQle
  have hconn : ((MvPolynomial.eval (fun j => G j n) (formF E G) : ℤ) : ℂ)
      = Polynomial.resultant (charPolyC E)
        ((((polyP E G).map (phiAt E G n))).map (Int.castRingHom ℂ)) E.order E.order := by
    have heq : MvPolynomial.eval (fun j => G j n) (formF E G)
        = (phiAt E G n) (formF E G) := rfl
    have h1 : (phiAt E G n) (formF E G)
        = Polynomial.resultant E.charPoly ((polyP E G).map (phiAt E G n)) E.order E.order := by
      have hF : formF E G
          = Polynomial.resultant (E.charPoly.map MvPolynomial.C) (polyP E G) E.order E.order :=
        rfl
      rw [hF, ← Polynomial.resultant_map_map]
      congr 1
      rw [Polynomial.map_map]
      have hcomp : (phiAt E G n).comp MvPolynomial.C = RingHom.id ℤ := by
        ext a
        change (phiAt E G n) (MvPolynomial.C a) = (RingHom.id ℤ) a
        change (MvPolynomial.eval₂Hom (RingHom.id ℤ) (fun j => G j n))
          (MvPolynomial.C a) = _
        rw [MvPolynomial.eval₂Hom_C]
      rw [hcomp, Polynomial.map_id]
    rw [heq, h1]
    change ((Int.castRingHom ℂ)
        (Polynomial.resultant E.charPoly ((polyP E G).map (phiAt E G n)) E.order E.order))
      = Polynomial.resultant (E.charPoly.map (Int.castRingHom ℂ))
        ((((polyP E G).map (phiAt E G n))).map (Int.castRingHom ℂ)) E.order E.order
    rw [← Polynomial.resultant_map_map]
  have hcoeff : (charPolyC E).coeff 0 = ((E.charPoly.coeff 0 : ℤ) : ℂ) :=
    Polynomial.coeff_map _ _
  refine Int.cast_injective (α := ℂ) ?_
  rw [hconn, hfactor]
  simp only [hroot_eval, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin, Finset.prod_pow, hprod, hcoeff]
  push_cast
  rfl

end exists_int_decomposable_form_eval_eq_det_pow_mul_pow

open exists_int_decomposable_form_eval_eq_det_pow_mul_pow

/-- **Integer decomposable forms on integer recurrence sequences.** Let
$\gamma_0, \dots, \gamma_{k-1} \in \mathbb{Z}$, let $\chi(x) = x^k - \sum_{i<k} \gamma_i x^i$,
suppose $\chi(0) \neq 0$, and let $G^{(1)}, \dots, G^{(k)} \colon \mathbb{N} \to \mathbb{Z}$ each
satisfy $G_{n+k} = \sum_{i<k} \gamma_i G_{n+i}$ for every $n \ge 0$. Suppose that the
determinant $\Delta$ of the $k \times k$ matrix of initial values $(G^{(j)}_i)$, with rows
$1 \le j \le k$ and columns $0 \le i < k$, is nonzero. Then there is a polynomial $\tilde F$ in
$k$ variables with integer coefficients that factors over $\mathbb{C}$ as a product of $k$
linear forms and satisfies $\tilde F(G^{(1)}_n, \dots, G^{(k)}_n) = \Delta^k ((-1)^k \chi(0))^n$
for every $n \ge 0$.

For $k \ge 1$ we have $\chi(0) = -\gamma_0$, so the hypothesis says $\gamma_0 \neq 0$ and the
right side is $\Delta^k ((-1)^{k+1} \gamma_0)^n$. The theorem in the source says "homogeneous
form"; decomposability is the paper's description of $\tilde F$ in the introduction and follows
from Theorem 2, since $\tilde F$ is $\Delta^k$ times the form given there. The source's standing
assumption $k \ge 2$ is omitted (for $k \le 1$ the claim holds with $\tilde F$ constant or
linear); definitions are read from arXiv:2308.13817v1.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 6
(`jis-2024-24.3.5-thm-6`). -/
public theorem exists_int_decomposable_form_eval_eq_det_pow_mul_pow
    (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) (hG : ∀ j, E.IsSolution (G j))
    (hγ : E.charPoly.coeff 0 ≠ 0)
    (hΔ : (Matrix.of fun j i : Fin E.order => G j i).det ≠ 0) :
    ∃ F : MvPolynomial (Fin E.order) ℤ,
      (∃ L : Fin E.order → MvPolynomial (Fin E.order) ℂ, (∀ i, (L i).IsHomogeneous 1) ∧
        MvPolynomial.map (Int.castRingHom ℂ) F = ∏ i, L i) ∧
      ∀ n : ℕ, MvPolynomial.eval (fun j => G j n) F =
        (Matrix.of fun j i : Fin E.order => G j i).det ^ E.order *
          ((-1) ^ E.order * E.charPoly.coeff 0) ^ n
    := by
  have _hγ := hγ
  have _hΔ := hΔ
  exact ⟨formF E G, map_formF_eq_prod E G, fun n => eval_formF_eq E G hG n⟩

end MetaMathlibExt
