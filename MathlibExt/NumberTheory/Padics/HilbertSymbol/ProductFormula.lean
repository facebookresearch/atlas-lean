module

public import MathlibExt.NumberTheory.Padics.HilbertSymbol.Bilinear
public import MathlibExt.NumberTheory.Padics.HilbertSymbol.Real
public import Mathlib.NumberTheory.LegendreSymbol.QuadraticReciprocity

/-!
# Hilbert's product formula over $\mathbb{Q}$

For nonzero rational numbers $a$ and $b$, the Hilbert symbols $(a, b)_v$ over all places $v$ of
$\mathbb{Q}$ (the primes $p$ and the real place $\infty$) satisfy $(a, b)_p = 1$ for all but
finitely many primes $p$, and

$$(a, b)_\infty \prod_p (a, b)_p = 1.$$

Here $(a, b)_p$ is `padicHilbertSymbol` and $(a, b)_\infty$ is `realHilbertSymbol`, applied to
the images of $a$ and $b$ in $\mathbb{Q}_p$ and in $\mathbb{R}$.

The proof follows the classical argument. Both sides are multiplicative in $a$ and in $b$
(`padicHilbertSymbol.mul_left`, `padicHilbertSymbol.mul_right`, and the sign rule
`realHilbertSymbol.eq_neg_one_iff_both_neg`), and they do not change when $a$ is replaced by
$a^{-1}$. Since $\mathbb{Q}^\times$ is generated by $-1$ and the primes, it suffices to treat
$a, b \in \{-1\} \cup \{\text{primes}\}$. In each case the local symbols are computed with
`padicHilbertSymbol.eq_formula_of_ne_two` and `padicHilbertSymbol.eq_formula_two`; they are
trivial away from $2$, $\infty$ and the primes involved, and the remaining product is $1$ by
the quadratic reciprocity law `legendreSym.quadratic_reciprocity` and its supplements
`legendreSym.at_neg_one` and `legendreSym.at_two`.
-/

set_option autoImplicit false

@[expose] public section

namespace HilbertSymbol

/-! ### Facts valid over every field -/

section Field

variable {F : Type*} [Field F]

private theorem pf_one_left (b : Fˣ) : hilbertSymbol F 1 b = 1 := by
  rw [hilbertSymbol.eq_one_iff]
  exact ⟨1, 0, by simp⟩

private theorem pf_inv_left (a b : Fˣ) : hilbertSymbol F a⁻¹ b = hilbertSymbol F a b := by
  have h : a⁻¹ = a * a⁻¹ ^ 2 := by rw [pow_two, ← mul_assoc, mul_inv_cancel, one_mul]
  conv_lhs => rw [h]
  exact hilbertSymbol.mul_sq_left a b a⁻¹

end Field

/-! ### The real symbol -/

private theorem pf_real_eq_ite (x y : ℝˣ) :
    realHilbertSymbol x y = if (x : ℝ) < 0 ∧ (y : ℝ) < 0 then -1 else 1 := by
  split_ifs with h
  · exact realHilbertSymbol.eq_neg_one_iff_both_neg.2 h
  · exact (realHilbertSymbol.eq_one_or_neg_one x y).resolve_right
      fun h' => h (realHilbertSymbol.eq_neg_one_iff_both_neg.1 h')

private theorem pf_real_mul_left (x x' y : ℝˣ) :
    realHilbertSymbol (x * x') y = realHilbertSymbol x y * realHilbertSymbol x' y := by
  rw [pf_real_eq_ite, pf_real_eq_ite, pf_real_eq_ite, Units.val_mul]
  rcases lt_or_gt_of_ne x.ne_zero with hx | hx <;>
    rcases lt_or_gt_of_ne x'.ne_zero with hx' | hx' <;>
    rcases lt_or_gt_of_ne y.ne_zero with hy | hy <;>
    simp [mul_neg_iff, hx, hx', hy, hx.not_gt, hx'.not_gt, hy.not_gt]

/-! ### Local symbols of integers -/

section Local

variable {p : ℕ} [hp : Fact p.Prime]

private theorem pf_coe_map (a : ℚˣ) :
    ((Units.map (Rat.castHom ℚ_[p]).toMonoidHom a : ℚ_[p]ˣ) : ℚ_[p]) = ((a : ℚ) : ℚ_[p]) :=
  rfl

/-- A rational number equal to an integer prime to $p$ is a unit of $\mathbb{Z}_p$. -/
private theorem pf_decomp_int (a : ℚˣ) (n : ℤ) (ha : (a : ℚ) = n) (hpn : ¬(p : ℤ) ∣ n) :
    ∃ u : ℤ_[p]ˣ, ((Units.map (Rat.castHom ℚ_[p]).toMonoidHom a : ℚ_[p]ˣ) : ℚ_[p]) =
      (p : ℚ_[p]) ^ (0 : ℤ) * ((u : ℤ_[p]) : ℚ_[p]) ∧ (u : ℤ_[p]) = n := by
  have hu : IsUnit (n : ℤ_[p]) := by
    rw [PadicInt.isUnit_iff]
    refine le_antisymm (PadicInt.norm_le_one _) (not_lt.1 fun h => hpn ?_)
    exact (PadicInt.norm_int_lt_one_iff_dvd n).1 h
  refine ⟨hu.unit, ?_, hu.unit_spec⟩
  rw [pf_coe_map, IsUnit.unit_spec, zpow_zero, one_mul, ha, Rat.cast_intCast,
    PadicInt.coe_intCast]

private theorem pf_decomp_self (a : ℚˣ) (ha : (a : ℚ) = p) :
    ((Units.map (Rat.castHom ℚ_[p]).toMonoidHom a : ℚ_[p]ˣ) : ℚ_[p]) =
      (p : ℚ_[p]) ^ (1 : ℤ) * (((1 : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) := by
  rw [pf_coe_map, ha, zpow_one, Units.val_one, PadicInt.coe_one, mul_one, Rat.cast_natCast]

private theorem pf_legendreSym_val (n : ℤ) :
    legendreSym p ((n : ZMod p).val : ℤ) = legendreSym p n := by
  rw [legendreSym, legendreSym, Int.cast_natCast, ZMod.natCast_zmod_val]

/-- At an odd prime, the symbol of two integers prime to $p$ is $1$. -/
private theorem pf_units_of_ne_two (hp2 : p ≠ 2) (a b : ℚˣ) (m n : ℤ) (ha : (a : ℚ) = m)
    (hb : (b : ℚ) = n) (hm : ¬(p : ℤ) ∣ m) (hn : ¬(p : ℤ) ∣ n) :
    padicHilbertSymbol p (Units.map (Rat.castHom ℚ_[p]).toMonoidHom a)
      (Units.map (Rat.castHom ℚ_[p]).toMonoidHom b) = 1 := by
  obtain ⟨u, hu, -⟩ := pf_decomp_int a m ha hm
  obtain ⟨v, hv, -⟩ := pf_decomp_int b n hb hn
  rw [padicHilbertSymbol.eq_formula_of_ne_two hp2 _ _ _ _ u v hu hv]
  simp

/-- At an odd prime, $(m, p)_p$ is the Legendre symbol of $m$. -/
private theorem pf_unit_self_of_ne_two (hp2 : p ≠ 2) (a b : ℚˣ) (m : ℤ) (ha : (a : ℚ) = m)
    (hm : ¬(p : ℤ) ∣ m) (hb : (b : ℚ) = p) :
    padicHilbertSymbol p (Units.map (Rat.castHom ℚ_[p]).toMonoidHom a)
      (Units.map (Rat.castHom ℚ_[p]).toMonoidHom b) = legendreSym p m := by
  obtain ⟨u, hu, hu'⟩ := pf_decomp_int a m ha hm
  rw [padicHilbertSymbol.eq_formula_of_ne_two hp2 _ _ _ _ u 1 hu (pf_decomp_self b hb), hu',
    map_intCast, pf_legendreSym_val]
  simp

/-- At an odd prime, $(p, p)_p = (-1)^{(p-1)/2}$. -/
private theorem pf_self_self_of_ne_two (hp2 : p ≠ 2) (a b : ℚˣ) (ha : (a : ℚ) = p)
    (hb : (b : ℚ) = p) :
    padicHilbertSymbol p (Units.map (Rat.castHom ℚ_[p]).toMonoidHom a)
      (Units.map (Rat.castHom ℚ_[p]).toMonoidHom b) = (-1) ^ ((p - 1) / 2) := by
  rw [padicHilbertSymbol.eq_formula_of_ne_two hp2 _ _ _ _ 1 1 (pf_decomp_self a ha)
    (pf_decomp_self b hb)]
  have h1 : legendreSym p ((PadicInt.toZMod ((1 : ℤ_[p]ˣ) : ℤ_[p])).val : ℤ) = 1 := by
    rw [Units.val_one, map_one, ← Int.cast_one, pf_legendreSym_val, legendreSym.at_one]
  rw [h1]
  simp only [one_pow, mul_one, one_mul, Int.natAbs_natCast]

end Local

section Two

private theorem pf_two_decomp_int (a : ℚˣ) (n : ℤ) (ha : (a : ℚ) = n) (hn : ¬(2 : ℤ) ∣ n) :
    ∃ u : ℤ_[2]ˣ, ((Units.map (Rat.castHom ℚ_[2]).toMonoidHom a : ℚ_[2]ˣ) : ℚ_[2]) =
      (2 : ℚ_[2]) ^ (0 : ℤ) * ((u : ℤ_[2]) : ℚ_[2]) ∧ (u : ℤ_[2]) = n := by
  obtain ⟨u, hu, hu'⟩ := pf_decomp_int (p := 2) a n ha (by exact_mod_cast hn)
  exact ⟨u, by exact_mod_cast hu, hu'⟩

private theorem pf_two_decomp_self (a : ℚˣ) (ha : (a : ℚ) = 2) :
    ((Units.map (Rat.castHom ℚ_[2]).toMonoidHom a : ℚ_[2]ˣ) : ℚ_[2]) =
      (2 : ℚ_[2]) ^ (1 : ℤ) * (((1 : ℤ_[2]ˣ) : ℤ_[2]) : ℚ_[2]) := by
  have h := pf_decomp_self (p := 2) a (by exact_mod_cast ha)
  exact_mod_cast h

/-- At $2$, the symbol of two odd integers is $(-1)^{\varepsilon(m)\varepsilon(n)}$. -/
private theorem pf_units_two (a b : ℚˣ) (m n : ℤ) (ha : (a : ℚ) = m) (hb : (b : ℚ) = n)
    (hm : ¬(2 : ℤ) ∣ m) (hn : ¬(2 : ℤ) ∣ n) :
    padicHilbertSymbol 2 (Units.map (Rat.castHom ℚ_[2]).toMonoidHom a)
      (Units.map (Rat.castHom ℚ_[2]).toMonoidHom b) =
      (-1) ^ ((((m : ZMod (2 ^ 3)).val - 1) / 2) * (((n : ZMod (2 ^ 3)).val - 1) / 2)) := by
  obtain ⟨u, hu, hu'⟩ := pf_two_decomp_int a m ha hm
  obtain ⟨v, hv, hv'⟩ := pf_two_decomp_int b n hb hn
  rw [padicHilbertSymbol.eq_formula_two _ _ _ _ u v hu hv, hu', hv', map_intCast, map_intCast]
  simp

/-- At $2$, $(m, 2)_2 = (-1)^{\omega(m)}$ for $m$ odd. -/
private theorem pf_unit_two_two (a b : ℚˣ) (m : ℤ) (ha : (a : ℚ) = m) (hm : ¬(2 : ℤ) ∣ m)
    (hb : (b : ℚ) = 2) :
    padicHilbertSymbol 2 (Units.map (Rat.castHom ℚ_[2]).toMonoidHom a)
      (Units.map (Rat.castHom ℚ_[2]).toMonoidHom b) =
      (-1) ^ (((m : ZMod (2 ^ 3)).val ^ 2 - 1) / 8) := by
  obtain ⟨u, hu, hu'⟩ := pf_two_decomp_int a m ha hm
  rw [padicHilbertSymbol.eq_formula_two _ _ _ _ u 1 hu (pf_two_decomp_self b hb), hu',
    map_intCast, Units.val_one, map_one]
  have h1 : (1 : ZMod (2 ^ 3)).val = 1 := rfl
  simp [h1]

/-- $(2, 2)_2 = 1$. -/
private theorem pf_two_two (a b : ℚˣ) (ha : (a : ℚ) = 2) (hb : (b : ℚ) = 2) :
    padicHilbertSymbol 2 (Units.map (Rat.castHom ℚ_[2]).toMonoidHom a)
      (Units.map (Rat.castHom ℚ_[2]).toMonoidHom b) = 1 := by
  rw [padicHilbertSymbol.eq_formula_two _ _ _ _ 1 1 (pf_two_decomp_self a ha)
    (pf_two_decomp_self b hb), Units.val_one, map_one]
  have h1 : (1 : ZMod (2 ^ 3)).val = 1 := rfl
  simp [h1]

end Two

/-! ### The global symbols -/

/-- The symbol $(a, b)_p$ of nonzero rationals at the prime $p$. -/
private noncomputable def symAt (p : Nat.Primes) (a b : ℚˣ) : ℤ :=
  haveI : Fact (p : ℕ).Prime := ⟨p.prop⟩
  padicHilbertSymbol p (Units.map (Rat.castHom ℚ_[p]).toMonoidHom a)
    (Units.map (Rat.castHom ℚ_[p]).toMonoidHom b)

/-- The symbol $(a, b)_\infty$ of nonzero rationals at the real place. -/
private noncomputable def symInf (a b : ℚˣ) : ℤ :=
  realHilbertSymbol (Units.map (Rat.castHom ℝ).toMonoidHom a)
    (Units.map (Rat.castHom ℝ).toMonoidHom b)

/-- The two assertions of the product formula for the pair $(a, b)$. -/
private def PF (a b : ℚˣ) : Prop :=
  Function.HasFiniteMulSupport (fun p => symAt p a b) ∧ symInf a b * ∏ᶠ p, symAt p a b = 1

private theorem symAt_mul_left (p : Nat.Primes) (a a' b : ℚˣ) :
    symAt p (a * a') b = symAt p a b * symAt p a' b := by
  have : Fact (p : ℕ).Prime := ⟨p.prop⟩
  simp only [symAt, map_mul]
  exact padicHilbertSymbol.mul_left _ _ _

private theorem symAt_inv_left (p : Nat.Primes) (a b : ℚˣ) :
    symAt p a⁻¹ b = symAt p a b := by
  have : Fact (p : ℕ).Prime := ⟨p.prop⟩
  simp only [symAt, map_inv, padicHilbertSymbol]
  exact pf_inv_left _ _

private theorem symAt_one_left (p : Nat.Primes) (b : ℚˣ) : symAt p 1 b = 1 := by
  have : Fact (p : ℕ).Prime := ⟨p.prop⟩
  simp only [symAt, map_one, padicHilbertSymbol]
  exact pf_one_left _

private theorem symAt_comm (p : Nat.Primes) (a b : ℚˣ) : symAt p a b = symAt p b a := by
  have : Fact (p : ℕ).Prime := ⟨p.prop⟩
  simp only [symAt, padicHilbertSymbol]
  exact hilbertSymbol.comm _ _

private theorem symInf_mul_left (a a' b : ℚˣ) :
    symInf (a * a') b = symInf a b * symInf a' b := by
  simp only [symInf, map_mul]
  exact pf_real_mul_left _ _ _

private theorem symInf_inv_left (a b : ℚˣ) : symInf a⁻¹ b = symInf a b := by
  simp only [symInf, map_inv, realHilbertSymbol]
  exact pf_inv_left _ _

private theorem symInf_one_left (b : ℚˣ) : symInf 1 b = 1 := by
  simp only [symInf, map_one, realHilbertSymbol]
  exact pf_one_left _

private theorem symInf_comm (a b : ℚˣ) : symInf a b = symInf b a := by
  simp only [symInf, realHilbertSymbol]
  exact hilbertSymbol.comm _ _

private theorem symInf_int (a b : ℚˣ) (m n : ℤ) (ha : (a : ℚ) = m) (hb : (b : ℚ) = n) :
    symInf a b = if m < 0 ∧ n < 0 then -1 else 1 := by
  rw [symInf, pf_real_eq_ite]
  have ha' : ((Units.map (Rat.castHom ℝ).toMonoidHom a : ℝˣ) : ℝ) = m := by
    change ((a : ℚ) : ℝ) = m
    rw [ha, Rat.cast_intCast]
  have hb' : ((Units.map (Rat.castHom ℝ).toMonoidHom b : ℝˣ) : ℝ) = n := by
    change ((b : ℚ) : ℝ) = n
    rw [hb, Rat.cast_intCast]
  simp only [ha', hb', Int.cast_lt_zero]

/-! ### Closure properties of the product formula -/

private theorem PF.mul_left {a a' b : ℚˣ} (h : PF a b) (h' : PF a' b) : PF (a * a') b := by
  have hf : (fun p => symAt p (a * a') b) = fun p => symAt p a b * symAt p a' b :=
    funext fun p => symAt_mul_left p a a' b
  refine ⟨?_, ?_⟩
  · rw [hf]
    exact (Set.Finite.union h.1 h'.1).subset (Function.mulSupport_mul _ _)
  · rw [hf, finprod_mul_distrib h.1 h'.1, symInf_mul_left, mul_mul_mul_comm, h.2, h'.2, one_mul]

private theorem PF.inv_left {a b : ℚˣ} (h : PF a b) : PF a⁻¹ b := by
  have hf : (fun p => symAt p a⁻¹ b) = fun p => symAt p a b :=
    funext fun p => symAt_inv_left p a b
  refine ⟨?_, ?_⟩
  · rw [hf]
    exact h.1
  · rw [hf, symInf_inv_left]
    exact h.2

private theorem PF.one_left (b : ℚˣ) : PF 1 b := by
  have hf : (fun p => symAt p 1 b) = fun _ => 1 := funext fun p => symAt_one_left p b
  refine ⟨?_, ?_⟩
  · rw [hf]
    simp [Function.HasFiniteMulSupport]
  · rw [hf, finprod_one, symInf_one_left, one_mul]

private theorem PF.symm {a b : ℚˣ} (h : PF a b) : PF b a := by
  have hf : (fun p => symAt p b a) = fun p => symAt p a b := funext fun p => symAt_comm p b a
  refine ⟨?_, ?_⟩
  · rw [hf]
    exact h.1
  · rw [hf, symInf_comm]
    exact h.2

/-- The product formula holds as soon as the local symbols are trivial outside a finite set of
primes over which the product, times the real symbol, is $1$. -/
private theorem PF.of_finset {a b : ℚˣ} (T : Finset Nat.Primes)
    (hout : ∀ p ∉ T, symAt p a b = 1) (hprod : symInf a b * ∏ p ∈ T, symAt p a b = 1) :
    PF a b := by
  have hsub : Function.mulSupport (fun p => symAt p a b) ⊆ T :=
    Function.mulSupport_subset_iff'.2 hout
  refine ⟨T.finite_toSet.subset hsub, ?_⟩
  rw [finprod_eq_prod_of_mulSupport_subset _ hsub]
  exact hprod

/-! ### Generation of $\mathbb{Q}^\times$ by $-1$ and the primes -/

private theorem units_rat_induction {S : ℚˣ → Prop} (h1 : S 1) (hneg : S (-1))
    (hprime : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime), S (Units.mk0 (ℓ : ℚ) (by exact_mod_cast hℓ.ne_zero)))
    (hmul : ∀ x y, S x → S y → S (x * y)) (hinv : ∀ x, S x → S x⁻¹) (x : ℚˣ) : S x := by
  have hnat : ∀ (n : ℕ) (hn : (n : ℚ) ≠ 0), S (Units.mk0 (n : ℚ) hn) := by
    intro n
    induction n using Nat.recOnMul with
    | zero => intro hn; exact absurd Nat.cast_zero hn
    | one =>
      intro hn
      have : Units.mk0 ((1 : ℕ) : ℚ) hn = 1 := Units.ext (by simp)
      rw [this]
      exact h1
    | prime ℓ hℓ => intro hn; exact hprime ℓ hℓ
    | mul m n hm hn =>
      intro hmn
      have hm0 : (m : ℚ) ≠ 0 := fun h => hmn (by rw [Nat.cast_mul, h, zero_mul])
      have hn0 : (n : ℚ) ≠ 0 := fun h => hmn (by rw [Nat.cast_mul, h, mul_zero])
      have : Units.mk0 ((m * n : ℕ) : ℚ) hmn = Units.mk0 (m : ℚ) hm0 * Units.mk0 (n : ℚ) hn0 :=
        Units.ext (by simp)
      rw [this]
      exact hmul _ _ (hm hm0) (hn hn0)
  have hnum : ((x : ℚ).num.natAbs : ℚ) ≠ 0 := by
    have : (x : ℚ).num ≠ 0 := Rat.num_ne_zero.2 x.ne_zero
    exact_mod_cast Int.natAbs_ne_zero.2 this
  have hden : (((x : ℚ).den : ℕ) : ℚ) ≠ 0 := by exact_mod_cast (x : ℚ).den_nz
  have hS := hmul _ _ (hnat _ hnum) (hinv _ (hnat _ hden))
  rcases Int.natAbs_eq (x : ℚ).num with h | h
  · have hx : x =
        Units.mk0 ((x : ℚ).num.natAbs : ℚ) hnum * (Units.mk0 ((x : ℚ).den : ℚ) hden)⁻¹ := by
      refine Units.ext ?_
      simp only [Units.val_mul, Units.val_mk0, Units.val_inv_eq_inv_val]
      conv_lhs => rw [← Rat.num_div_den (x : ℚ), h]
      rw [div_eq_mul_inv, Int.cast_natCast]
    rw [hx]
    exact hS
  · have hx : x = -1 * (Units.mk0 ((x : ℚ).num.natAbs : ℚ) hnum *
        (Units.mk0 ((x : ℚ).den : ℚ) hden)⁻¹) := by
      refine Units.ext ?_
      simp only [Units.val_mul, Units.val_neg, Units.val_one, Units.val_mk0,
        Units.val_inv_eq_inv_val]
      conv_lhs => rw [← Rat.num_div_den (x : ℚ), h]
      rw [div_eq_mul_inv, Int.cast_neg, Int.cast_natCast]
      ring
    rw [hx]
    exact hmul _ _ hneg hS

/-! ### Sign computations -/

private theorem pf_neg_one_pow_mul_eq_one {m n : ℕ} (h : m % 2 = n % 2) :
    (-1 : ℤ) ^ m * (-1) ^ n = 1 := by
  rw [neg_one_pow_eq_pow_mod_two m, neg_one_pow_eq_pow_mod_two n, h, ← pow_add]
  exact Even.neg_one_pow ⟨_, rfl⟩

private theorem pf_zmod8_val (ℓ : ℕ) : (((ℓ : ℤ) : ZMod (2 ^ 3))).val = ℓ % 8 := by
  rw [Int.cast_natCast, ZMod.val_natCast]
  norm_num

private theorem pf_zmod8_neg_one : (((-1 : ℤ) : ZMod (2 ^ 3))).val = 7 := rfl

/-- The first supplement: $(-1, \ell)_2 (-1, \ell)_\ell = 1$ for $\ell$ an odd prime. -/
private theorem pf_sign_neg_one (ℓ : ℕ) (hℓ : ℓ % 2 = 1) :
    (-1 : ℤ) ^ ((7 - 1) / 2 * ((ℓ % 8 - 1) / 2)) * ZMod.χ₄ ℓ = 1 := by
  rw [ZMod.χ₄_nat_eq_if_mod_four, ite_eq_right (by omega)]
  have h4 : ℓ % 4 = ℓ % 8 % 4 := by omega
  rw [h4]
  rcases (by omega : ℓ % 8 = 1 ∨ ℓ % 8 = 3 ∨ ℓ % 8 = 5 ∨ ℓ % 8 = 7) with h | h | h | h <;>
    rw [h] <;> norm_num

/-- The second supplement: $(2, \ell)_2 (2, \ell)_\ell = 1$ for $\ell$ an odd prime. -/
private theorem pf_sign_two (ℓ : ℕ) (hℓ : ℓ % 2 = 1) :
    (-1 : ℤ) ^ (((ℓ % 8) ^ 2 - 1) / 8) * ZMod.χ₈ ℓ = 1 := by
  rw [ZMod.χ₈_nat_eq_if_mod_eight, ite_eq_right (by omega)]
  rcases (by omega : ℓ % 8 = 1 ∨ ℓ % 8 = 3 ∨ ℓ % 8 = 5 ∨ ℓ % 8 = 7) with h | h | h | h <;>
    rw [h] <;> norm_num

/-- $(\ell, \ell)_2 (\ell, \ell)_\ell = 1$ for $\ell$ an odd prime. -/
private theorem pf_sign_self (ℓ : ℕ) (hℓ : ℓ % 2 = 1) :
    (-1 : ℤ) ^ ((ℓ % 8 - 1) / 2 * ((ℓ % 8 - 1) / 2)) * (-1) ^ ((ℓ - 1) / 2) = 1 := by
  apply pf_neg_one_pow_mul_eq_one
  rcases (by omega : ℓ % 8 = 1 ∨ ℓ % 8 = 3 ∨ ℓ % 8 = 5 ∨ ℓ % 8 = 7) with h | h | h | h <;>
    rw [h] <;> omega

/-- The reciprocity sign: $(-1)^{\varepsilon(\ell)\varepsilon(q)}$ against
$(-1)^{\lfloor \ell/2 \rfloor \lfloor q/2 \rfloor}$. -/
private theorem pf_sign_qr (ℓ q : ℕ) (hℓ : ℓ % 2 = 1) (hq : q % 2 = 1) :
    (-1 : ℤ) ^ ((ℓ % 8 - 1) / 2 * ((q % 8 - 1) / 2)) * (-1) ^ (ℓ / 2 * (q / 2)) = 1 := by
  apply pf_neg_one_pow_mul_eq_one
  have e1 : ℓ / 2 % 2 = (ℓ % 8 - 1) / 2 % 2 := by omega
  have e2 : q / 2 % 2 = (q % 8 - 1) / 2 % 2 := by omega
  rw [Nat.mul_mod, Nat.mul_mod (ℓ / 2), e1, e2]

/-! ### The product formula for $-1$ and the primes -/

private theorem pf_not_dvd_neg_one {p : ℕ} (hp : p.Prime) : ¬(p : ℤ) ∣ -1 := by
  rw [dvd_neg, ← Nat.cast_one, Int.natCast_dvd_natCast, Nat.dvd_one]
  exact hp.ne_one

private theorem pf_not_dvd_prime {p ℓ : ℕ} (hp : p.Prime) (hℓ : ℓ.Prime) (h : p ≠ ℓ) :
    ¬(p : ℤ) ∣ (ℓ : ℤ) := by
  rw [Int.natCast_dvd_natCast, Nat.prime_dvd_prime_iff_eq hp hℓ]
  exact h

/-- The prime $2$, as an element of `Nat.Primes`. -/
private def two : Nat.Primes := ⟨2, Nat.prime_two⟩

/-- A prime number, as an element of `Nat.Primes`. -/
private def prm (ℓ : ℕ) (hℓ : ℓ.Prime) : Nat.Primes := ⟨ℓ, hℓ⟩

private theorem pf_ne_two {p : Nat.Primes} (h : p ≠ two) : (p : ℕ) ≠ 2 :=
  fun h' => h (Subtype.ext h')

private theorem pf_coe_mk0 (ℓ : ℕ) (h0 : (ℓ : ℚ) ≠ 0) :
    ((Units.mk0 (ℓ : ℚ) h0 : ℚˣ) : ℚ) = ((ℓ : ℤ) : ℚ) := by
  simp

private theorem pf_coe_neg_one : ((-1 : ℚˣ) : ℚ) = ((-1 : ℤ) : ℚ) := by
  simp

private theorem pf_pair_neg_one_neg_one : PF (-1) (-1) := by
  refine PF.of_finset {two} (fun p hp => ?_) ?_
  · have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two (pf_ne_two (Finset.notMem_singleton.1 hp)) _ _ _ _ pf_coe_neg_one
      pf_coe_neg_one (pf_not_dvd_neg_one p.prop) (pf_not_dvd_neg_one p.prop)
  · have e2 : symAt two (-1) (-1) = (-1) ^ ((7 - 1) / 2 * ((7 - 1) / 2)) := by
      have h := pf_units_two _ _ _ _ pf_coe_neg_one pf_coe_neg_one (by decide) (by decide)
      rw [pf_zmod8_neg_one] at h
      exact h
    rw [Finset.prod_singleton, e2, symInf_int _ _ _ _ pf_coe_neg_one pf_coe_neg_one,
      ite_eq_left (by decide)]
    norm_num

private theorem pf_pair_neg_one_two (h0 : ((2 : ℕ) : ℚ) ≠ 0) :
    PF (-1) (Units.mk0 ((2 : ℕ) : ℚ) h0) := by
  have hb := pf_coe_mk0 2 h0
  refine PF.of_finset {two} (fun p hp => ?_) ?_
  · have hp2 := pf_ne_two (Finset.notMem_singleton.1 hp)
    have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two hp2 _ _ _ _ pf_coe_neg_one hb (pf_not_dvd_neg_one p.prop)
      (pf_not_dvd_prime p.prop Nat.prime_two hp2)
  · have e2 : symAt two (-1) (Units.mk0 ((2 : ℕ) : ℚ) h0) = (-1) ^ ((7 ^ 2 - 1) / 8) := by
      have h := pf_unit_two_two (-1) (Units.mk0 ((2 : ℕ) : ℚ) h0) _ pf_coe_neg_one (by decide)
        (by simp)
      rw [pf_zmod8_neg_one] at h
      exact h
    rw [Finset.prod_singleton, e2, symInf_int _ _ _ _ pf_coe_neg_one hb, ite_eq_right (by omega)]
    norm_num

private theorem pf_pair_two_two (h0 : ((2 : ℕ) : ℚ) ≠ 0) :
    PF (Units.mk0 ((2 : ℕ) : ℚ) h0) (Units.mk0 ((2 : ℕ) : ℚ) h0) := by
  have hb := pf_coe_mk0 2 h0
  refine PF.of_finset {two} (fun p hp => ?_) ?_
  · have hp2 := pf_ne_two (Finset.notMem_singleton.1 hp)
    have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two hp2 _ _ _ _ hb hb (pf_not_dvd_prime p.prop Nat.prime_two hp2)
      (pf_not_dvd_prime p.prop Nat.prime_two hp2)
  · have e2 : symAt two (Units.mk0 ((2 : ℕ) : ℚ) h0) (Units.mk0 ((2 : ℕ) : ℚ) h0) = 1 :=
      pf_two_two _ _ (by simp) (by simp)
    rw [Finset.prod_singleton, e2, symInf_int _ _ _ _ hb hb, ite_eq_right (by omega)]
    norm_num

private theorem pf_pair_neg_one_odd (ℓ : ℕ) (hℓ : ℓ.Prime) (h2 : ℓ ≠ 2) (h0 : (ℓ : ℚ) ≠ 0) :
    PF (-1) (Units.mk0 (ℓ : ℚ) h0) := by
  have hb := pf_coe_mk0 ℓ h0
  have hodd : ℓ % 2 = 1 := hℓ.eq_two_or_odd.resolve_left h2
  have hL : two ≠ prm ℓ hℓ := fun h => h2 (congrArg Subtype.val h).symm
  refine PF.of_finset {two, prm ℓ hℓ} (fun p hp => ?_) ?_
  · have hp2 : (p : ℕ) ≠ 2 := fun h => hp (by
      rw [show p = two from Subtype.ext h]; exact Finset.mem_insert_self _ _)
    have hpL : (p : ℕ) ≠ ℓ := fun h => hp (by
      rw [show p = prm ℓ hℓ from Subtype.ext h]
      exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
    have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two hp2 _ _ _ _ pf_coe_neg_one hb
      (pf_not_dvd_neg_one p.prop) (pf_not_dvd_prime p.prop hℓ hpL)
  · have e2 : symAt two (-1) (Units.mk0 (ℓ : ℚ) h0) =
        (-1) ^ ((7 - 1) / 2 * ((ℓ % 8 - 1) / 2)) := by
      have h := pf_units_two _ _ _ _ pf_coe_neg_one hb (by decide) (by omega)
      rw [pf_zmod8_neg_one, pf_zmod8_val] at h
      exact h
    have eL : symAt (prm ℓ hℓ) (-1) (Units.mk0 (ℓ : ℚ) h0) = ZMod.χ₄ ℓ := by
      have : Fact ℓ.Prime := ⟨hℓ⟩
      have h := pf_unit_self_of_ne_two (p := ℓ) h2 (-1) (Units.mk0 (ℓ : ℚ) h0) (-1)
        pf_coe_neg_one (pf_not_dvd_neg_one hℓ) (by simp)
      rw [legendreSym.at_neg_one h2] at h
      exact h
    rw [Finset.prod_pair hL, e2, eL, symInf_int _ _ _ _ pf_coe_neg_one hb, ite_eq_right (by omega),
      one_mul]
    exact pf_sign_neg_one ℓ hodd

private theorem pf_pair_two_odd (q : ℕ) (hq : q.Prime) (h2 : q ≠ 2) (h0 : ((2 : ℕ) : ℚ) ≠ 0)
    (h0' : (q : ℚ) ≠ 0) : PF (Units.mk0 ((2 : ℕ) : ℚ) h0) (Units.mk0 (q : ℚ) h0') := by
  have ha := pf_coe_mk0 2 h0
  have hb := pf_coe_mk0 q h0'
  have hodd : q % 2 = 1 := hq.eq_two_or_odd.resolve_left h2
  have hQ : two ≠ prm q hq := fun h => h2 (congrArg Subtype.val h).symm
  refine PF.of_finset {two, prm q hq} (fun p hp => ?_) ?_
  · have hp2 : (p : ℕ) ≠ 2 := fun h => hp (by
      rw [show p = two from Subtype.ext h]; exact Finset.mem_insert_self _ _)
    have hpQ : (p : ℕ) ≠ q := fun h => hp (by
      rw [show p = prm q hq from Subtype.ext h]
      exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
    have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two hp2 _ _ _ _ ha hb (pf_not_dvd_prime p.prop Nat.prime_two hp2)
      (pf_not_dvd_prime p.prop hq hpQ)
  · have e2 : symAt two (Units.mk0 ((2 : ℕ) : ℚ) h0) (Units.mk0 (q : ℚ) h0') =
        (-1) ^ (((q % 8) ^ 2 - 1) / 8) := by
      rw [symAt_comm]
      have h := pf_unit_two_two (Units.mk0 (q : ℚ) h0') (Units.mk0 ((2 : ℕ) : ℚ) h0) _ hb
        (by omega) (by simp)
      rw [pf_zmod8_val] at h
      exact h
    have eQ : symAt (prm q hq) (Units.mk0 ((2 : ℕ) : ℚ) h0) (Units.mk0 (q : ℚ) h0') =
        ZMod.χ₈ q := by
      have : Fact q.Prime := ⟨hq⟩
      have ha2 : ((Units.mk0 ((2 : ℕ) : ℚ) h0 : ℚˣ) : ℚ) = ((2 : ℤ) : ℚ) := by simp
      have hd : ¬(q : ℤ) ∣ 2 := by
        have := pf_not_dvd_prime hq Nat.prime_two h2
        exact_mod_cast this
      have h := pf_unit_self_of_ne_two (p := q) h2 (Units.mk0 ((2 : ℕ) : ℚ) h0)
        (Units.mk0 (q : ℚ) h0') 2 ha2 hd (by simp)
      rw [legendreSym.at_two h2] at h
      exact h
    rw [Finset.prod_pair hQ, e2, eQ, symInf_int _ _ _ _ ha hb, ite_eq_right (by omega), one_mul]
    exact pf_sign_two q hodd

private theorem pf_pair_odd_self (ℓ : ℕ) (hℓ : ℓ.Prime) (h2 : ℓ ≠ 2) (h0 h0' : (ℓ : ℚ) ≠ 0) :
    PF (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (ℓ : ℚ) h0') := by
  have ha := pf_coe_mk0 ℓ h0
  have hb := pf_coe_mk0 ℓ h0'
  have hodd : ℓ % 2 = 1 := hℓ.eq_two_or_odd.resolve_left h2
  have hL : two ≠ prm ℓ hℓ := fun h => h2 (congrArg Subtype.val h).symm
  refine PF.of_finset {two, prm ℓ hℓ} (fun p hp => ?_) ?_
  · have hp2 : (p : ℕ) ≠ 2 := fun h => hp (by
      rw [show p = two from Subtype.ext h]; exact Finset.mem_insert_self _ _)
    have hpL : (p : ℕ) ≠ ℓ := fun h => hp (by
      rw [show p = prm ℓ hℓ from Subtype.ext h]
      exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
    have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two hp2 _ _ _ _ ha hb (pf_not_dvd_prime p.prop hℓ hpL)
      (pf_not_dvd_prime p.prop hℓ hpL)
  · have e2 : symAt two (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (ℓ : ℚ) h0') =
        (-1) ^ ((ℓ % 8 - 1) / 2 * ((ℓ % 8 - 1) / 2)) := by
      have h := pf_units_two _ _ _ _ ha hb (by omega) (by omega)
      rw [pf_zmod8_val] at h
      exact h
    have eL : symAt (prm ℓ hℓ) (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (ℓ : ℚ) h0') =
        (-1) ^ ((ℓ - 1) / 2) := by
      have : Fact ℓ.Prime := ⟨hℓ⟩
      exact pf_self_self_of_ne_two (p := ℓ) h2 _ _ (by simp) (by simp)
    rw [Finset.prod_pair hL, e2, eL, symInf_int _ _ _ _ ha hb, ite_eq_right (by omega), one_mul]
    exact pf_sign_self ℓ hodd

private theorem pf_pair_odd_odd (ℓ q : ℕ) (hℓ : ℓ.Prime) (hq : q.Prime) (hℓ2 : ℓ ≠ 2)
    (hq2 : q ≠ 2) (hne : ℓ ≠ q) (h0 : (ℓ : ℚ) ≠ 0) (h0' : (q : ℚ) ≠ 0) :
    PF (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (q : ℚ) h0') := by
  have ha := pf_coe_mk0 ℓ h0
  have hb := pf_coe_mk0 q h0'
  have hℓo : ℓ % 2 = 1 := hℓ.eq_two_or_odd.resolve_left hℓ2
  have hqo : q % 2 = 1 := hq.eq_two_or_odd.resolve_left hq2
  have hLQ : prm ℓ hℓ ≠ prm q hq := fun h => hne (congrArg Subtype.val h)
  have h2LQ : two ∉ ({prm ℓ hℓ, prm q hq} : Finset Nat.Primes) := by
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
    exact ⟨fun h => hℓ2 (congrArg Subtype.val h).symm, fun h => hq2 (congrArg Subtype.val h).symm⟩
  refine PF.of_finset {two, prm ℓ hℓ, prm q hq} (fun p hp => ?_) ?_
  · have hp2 : (p : ℕ) ≠ 2 := fun h => hp (by
      rw [show p = two from Subtype.ext h]; exact Finset.mem_insert_self _ _)
    have hpL : (p : ℕ) ≠ ℓ := fun h => hp (by
      rw [show p = prm ℓ hℓ from Subtype.ext h]
      exact Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
    have hpQ : (p : ℕ) ≠ q := fun h => hp (by
      rw [show p = prm q hq from Subtype.ext h]
      exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))
    have : Fact (p : ℕ).Prime := ⟨p.prop⟩
    exact pf_units_of_ne_two hp2 _ _ _ _ ha hb (pf_not_dvd_prime p.prop hℓ hpL)
      (pf_not_dvd_prime p.prop hq hpQ)
  · have e2 : symAt two (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (q : ℚ) h0') =
        (-1) ^ ((ℓ % 8 - 1) / 2 * ((q % 8 - 1) / 2)) := by
      have h := pf_units_two _ _ _ _ ha hb (by omega) (by omega)
      rw [pf_zmod8_val, pf_zmod8_val] at h
      exact h
    have : Fact ℓ.Prime := ⟨hℓ⟩
    have : Fact q.Prime := ⟨hq⟩
    have eL : symAt (prm ℓ hℓ) (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (q : ℚ) h0') =
        legendreSym ℓ q := by
      rw [symAt_comm]
      exact pf_unit_self_of_ne_two (p := ℓ) hℓ2 _ _ (q : ℤ) hb
        (pf_not_dvd_prime hℓ hq hne) (by simp)
    have eQ : symAt (prm q hq) (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (q : ℚ) h0') =
        legendreSym q ℓ := by
      exact pf_unit_self_of_ne_two (p := q) hq2 _ _ (ℓ : ℤ) ha
        (pf_not_dvd_prime hq hℓ (Ne.symm hne)) (by simp)
    rw [Finset.prod_insert h2LQ, Finset.prod_pair hLQ, e2, eL, eQ, symInf_int _ _ _ _ ha hb,
      ite_eq_right (by omega), one_mul, mul_comm (legendreSym ℓ (q : ℤ)),
      legendreSym.quadratic_reciprocity hℓ2 hq2 hne]
    exact pf_sign_qr ℓ q hℓo hqo

private theorem pf_pair_neg_one_prime (ℓ : ℕ) (hℓ : ℓ.Prime) (h0 : (ℓ : ℚ) ≠ 0) :
    PF (-1) (Units.mk0 (ℓ : ℚ) h0) := by
  rcases hℓ.eq_two_or_odd with rfl | hodd
  · exact pf_pair_neg_one_two h0
  · exact pf_pair_neg_one_odd ℓ hℓ (by omega) h0

private theorem pf_pair_prime_prime (ℓ q : ℕ) (hℓ : ℓ.Prime) (hq : q.Prime) (h0 : (ℓ : ℚ) ≠ 0)
    (h0' : (q : ℚ) ≠ 0) : PF (Units.mk0 (ℓ : ℚ) h0) (Units.mk0 (q : ℚ) h0') := by
  rcases hℓ.eq_two_or_odd with rfl | hℓo <;> rcases hq.eq_two_or_odd with rfl | hqo
  · exact pf_pair_two_two h0
  · exact pf_pair_two_odd q hq (by omega) h0 h0'
  · exact (pf_pair_two_odd ℓ hℓ (by omega) h0' h0).symm
  · by_cases hne : ℓ = q
    · subst hne
      exact pf_pair_odd_self ℓ hℓ (by omega) h0 h0'
    · exact pf_pair_odd_odd ℓ q hℓ hq (by omega) (by omega) hne h0 h0'

/-- The product formula for a fixed first argument follows from the case of $-1$ and the
primes in the second argument. -/
private theorem pf_of_gen_right (g : ℚˣ) (hneg : PF g (-1))
    (hprime : ∀ ℓ : ℕ, ℓ.Prime → ∀ h0 : (ℓ : ℚ) ≠ 0, PF g (Units.mk0 (ℓ : ℚ) h0))
    (b : ℚˣ) : PF g b :=
  units_rat_induction (S := fun b => PF g b) (PF.one_left g).symm hneg
    (fun ℓ hℓ => hprime ℓ hℓ _) (fun _ _ hx hy => (PF.mul_left hx.symm hy.symm).symm)
    (fun _ hx => (PF.inv_left hx.symm).symm) b

private theorem pf_all (a b : ℚˣ) : PF a b :=
  units_rat_induction (S := fun a => ∀ b, PF a b) PF.one_left
    (pf_of_gen_right _ pf_pair_neg_one_neg_one fun ℓ hℓ h0 => pf_pair_neg_one_prime ℓ hℓ h0)
    (fun ℓ hℓ => pf_of_gen_right _ (pf_pair_neg_one_prime ℓ hℓ _).symm
      fun q hq h0' => pf_pair_prime_prime ℓ q hℓ hq _ h0')
    (fun _ _ hx hy b => PF.mul_left (hx b) (hy b)) (fun _ hx b => PF.inv_left (hx b)) a b

end HilbertSymbol

open HilbertSymbol

/-- **Hilbert's product formula over $\mathbb{Q}$.** Let $a$ and $b$ be nonzero rational
numbers. For a prime $p$, write $(a, b)_p$ for the $p$-adic Hilbert symbol of the images of $a$
and $b$ in $\mathbb{Q}_p$, and write $(a, b)_\infty$ for the real Hilbert symbol of their images
in $\mathbb{R}$. Then $(a, b)_p = 1$ for all but finitely many primes $p$, and

$$(a, b)_\infty \prod_p (a, b)_p = 1,$$

where the product runs over all primes $p$ and has only finitely many factors different
from $1$.

The symbols are defined through solvability of $a x^2 + b y^2 = 1$; by
`hilbertSymbol.eq_one_iff_exists_ternary_eq_zero` this agrees with the definition through
nontrivial zeros of $z^2 - a x^2 - b y^2$ used in the sources.

Source: J.-P. Serre, *A Course in Arithmetic*, Graduate Texts in Mathematics 7, Springer, 1973,
Chapter III, Theorem 3, as stated by J. S. Milne, *Class Field Theory*, version 4.03, 2020,
Chapter III, Aside 4.2, p. 111: "It is defined also for $\mathbb{R}$, and Serre proves (Hilbert
product formula) $\prod_{p \le \infty} (a, b)_p = 1$". The theorem number is as cited by
E. Amerik and M. Verbitsky, *Construction of automorphisms of hyperkähler manifolds*,
Compositio Math. 153 (2017), §3. -/
theorem Rat.hilbertSymbol_product_formula (a b : ℚˣ) :
    {p : Nat.Primes |
        haveI : Fact (p : ℕ).Prime := ⟨p.prop⟩
        padicHilbertSymbol p (Units.map (Rat.castHom ℚ_[p]).toMonoidHom a)
          (Units.map (Rat.castHom ℚ_[p]).toMonoidHom b) ≠ 1}.Finite ∧
      realHilbertSymbol (Units.map (Rat.castHom ℝ).toMonoidHom a)
          (Units.map (Rat.castHom ℝ).toMonoidHom b) *
        ∏ᶠ p : Nat.Primes,
          (haveI : Fact (p : ℕ).Prime := ⟨p.prop⟩
          padicHilbertSymbol p (Units.map (Rat.castHom ℚ_[p]).toMonoidHom a)
            (Units.map (Rat.castHom ℚ_[p]).toMonoidHom b)) = 1 :=
  pf_all a b
