/-!
# The Hilbert symbol and norms from a quadratic extension

Let $F$ be a field in which $2 \neq 0$, and let $(a, b)$ be the Hilbert symbol of $F$: for nonzero
$a, b \in F$, it is $1$ if $a x^2 + b y^2 = 1$ has a solution in $F$, and $-1$ otherwise.
Equivalently, $(a, b) = 1$ exactly when $z^2 - a x^2 - b y^2 = 0$ for some
$(z, x, y) \neq (0, 0, 0)$ (`hilbertSymbol.eq_one_iff_exists_ternary_eq_zero`), which is how
J.-P. Serre defines it (*A Course in Arithmetic*, Chapter III, §1.1, p. 19). This file proves the
results of Serre's §1.1:

* the Hilbert symbol depends only on the square classes of $a$ and $b$ (p. 19);
* **the norm criterion** (Proposition 1, p. 19): $(a, b) = 1$ if and only if $a$ is the norm of a
  nonzero element of $F(\sqrt b)$. Here $F(\sqrt b)$ is the subfield $F(\beta)$ generated by an
  element $\beta$ with $\beta^2 = b$ of any field extension of $F$, and the norm is `Algebra.norm`.
  Explicitly, $(a, b) = 1$ if and only if $a = z^2 - b y^2$ for some $y, z \in F$; if $b$ is a
  square, $(a, b) = 1$ for every $a$;
* **the first properties** (Proposition 2, pp. 19–20): $(a, b) = (b, a)$ and $(a, c^2) = 1$;
  $(a, -a) = 1$ and $(a, 1 - a) = 1$ for $a \neq 1$; if $(a, b) = 1$ then $(a a', b) = (a', b)$;
  and $(a, b) = (a, -a b) = (a, (1 - a) b)$ for $a \neq 1$.

Serre states these for $F = \mathbb{R}$ or $F = \mathbb{Q}_p$; his proofs use only $2 \neq 0$, and
the results are stated here for every field with $2 \neq 0$, which includes both. The proofs follow
Serre's. For the norm criterion, when $b$ is not a square, $1$ and $\beta$ form a basis of
$F(\beta)$ over $F$, in which the norm of $z + y \beta$ is the determinant $z^2 - b y^2$ of
multiplication by it; a zero $(z, x, y)$ of $z^2 - a x^2 - b y^2$ then has $x \neq 0$, and $a$ is
the norm of $z / x + (y / x) \beta$. Property iii) holds as the values $z^2 - b y^2 \neq 0$ form a
group.
-/

set_option autoImplicit false

@[expose] public section

open IntermediateField

namespace hilbertSymbol

variable {F : Type*} [Field F]

/-- Two Hilbert symbols agree when they are `1` together. -/
private theorem eq_of_eq_one_iff {a b a' b' : Fˣ}
    (h : hilbertSymbol F a b = 1 ↔ hilbertSymbol F a' b' = 1) :
    hilbertSymbol F a b = hilbertSymbol F a' b' := by
  rcases eq_one_or_neg_one a b with h1 | h1 <;> rcases eq_one_or_neg_one a' b' with h2 | h2
  · rw [h1, h2]
  · exact absurd (h.1 h1) (by rw [h2]; decide)
  · exact absurd (h.2 h2) (by rw [h1]; decide)
  · rw [h1, h2]

/-- **The Hilbert symbol depends only on the square class of its second argument.** For a field
$F$ and nonzero $a, b, c \in F$, the Hilbert symbol satisfies $(a, b c^2) = (a, b)$ (J.-P. Serre,
*A Course in Arithmetic*, Chapter III, §1.1, p. 19: "(a, b) does not change when a and b are
multiplied by squares"; for the first argument this is `hilbertSymbol.mul_sq_left`). -/
theorem mul_sq_right (a b c : Fˣ) : hilbertSymbol F a (b * c ^ 2) = hilbertSymbol F a b := by
  rw [comm, mul_sq_left, comm]

/-- **The Hilbert symbol is $1$ when the second argument is a square.** For a field $F$ and
nonzero $a, b \in F$ with $b$ a square in $F$, the Hilbert symbol $(a, b)$ equals $1$ (J.-P. Serre,
*A Course in Arithmetic*, Chapter III, §1.1, proof of Proposition 1, p. 19). -/
theorem eq_one_of_isSquare_right {a b : Fˣ} (hb : IsSquare (b : F)) : hilbertSymbol F a b = 1 := by
  obtain ⟨c, hc⟩ := hb
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact b.ne_zero (by rw [hc]; ring)
  rw [eq_one_iff]
  refine ⟨0, c⁻¹, ?_⟩
  rw [hc]
  field_simp
  ring

/-- **The norm form criterion for the Hilbert symbol.** Let $F$ be a field in which $2 \neq 0$ and
let $a, b \in F$ be nonzero. Then the Hilbert symbol $(a, b)$ equals $1$ if and only if
$a = z^2 - b y^2$ for some $y, z \in F$. When $b$ is not a square, $z^2 - b y^2$ is the norm of
$z + y \sqrt b$ from $F(\sqrt b)$ (J.-P. Serre, *A Course in Arithmetic*, Chapter III, §1.1,
Proposition 1 and its proof, p. 19; Serre takes $F = \mathbb{R}$ or $\mathbb{Q}_p$). -/
theorem eq_one_iff_exists_eq_sq_sub_mul_sq (h2 : (2 : F) ≠ 0) (a b : Fˣ) :
    hilbertSymbol F a b = 1 ↔ ∃ z y : F, (a : F) = z ^ 2 - b * y ^ 2 := by
  rw [eq_one_iff_exists_ternary_eq_zero h2]
  constructor
  · rintro ⟨z, x, y, hne, h⟩
    by_cases hb : IsSquare (b : F)
    · obtain ⟨c, hc⟩ := hb
      have hc0 : c ≠ 0 := by
        rintro rfl
        exact b.ne_zero (by rw [hc]; ring)
      refine ⟨((a : F) + 1) / 2, ((a : F) - 1) / (2 * c), ?_⟩
      rw [hc]
      field_simp
      ring
    · have hx : x ≠ 0 := by
        rintro rfl
        have hy : y ≠ 0 := by
          rintro rfl
          have hz : z = 0 := by
            have : z ^ 2 = 0 := by linear_combination h
            exact pow_eq_zero_iff (two_ne_zero) |>.1 this
          exact hne ⟨hz, rfl, rfl⟩
        refine hb ⟨z / y, ?_⟩
        field_simp
        linear_combination -h
      refine ⟨z / x, y / x, ?_⟩
      field_simp
      linear_combination -h
  · rintro ⟨z, y, h⟩
    exact ⟨z, 1, y, fun h' => one_ne_zero h'.2.1, by rw [h]; ring⟩

section Norm

variable {L : Type*} [Field L] [Algebra F L]

/-- The norm from `F⟮β⟯` when `β ^ 2 = b` and `b` is not a square: in the basis `1, β`, the norm of
`z + y β` is `z ^ 2 - b y ^ 2`. -/
private theorem exists_basis_norm_eq {b : F} (hb : ¬IsSquare b) {β : L}
    (hβ : β ^ 2 = algebraMap F L b) :
    ∃ B : Module.Basis (Fin 2) F F⟮β⟯, B 0 = 1 ∧ B 1 = AdjoinSimple.gen F β ∧
      ∀ ξ : F⟮β⟯, Algebra.norm F ξ = B.repr ξ 0 ^ 2 - b * B.repr ξ 1 ^ 2 := by
  set γ : F⟮β⟯ := AdjoinSimple.gen F β with hγdef
  have hγ : γ ^ 2 = algebraMap F F⟮β⟯ b := by
    apply (algebraMap F⟮β⟯ L).injective
    rw [map_pow, AdjoinSimple.algebraMap_gen, ← IsScalarTower.algebraMap_apply, hβ]
  -- `1, γ` are linearly independent, as `γ ∉ F`.
  have hli : LinearIndependent F ![(1 : F⟮β⟯), γ] := by
    rw [LinearIndependent.pair_iff]
    intro s t hst
    have ht : t = 0 := by
      by_contra ht
      apply hb
      refine ⟨-s / t, (algebraMap F F⟮β⟯).injective ?_⟩
      have h1 : t • γ = -(s • (1 : F⟮β⟯)) :=
        eq_neg_iff_add_eq_zero.2 (by rw [add_comm]; exact hst)
      have hγ' : γ = algebraMap F F⟮β⟯ (-s / t) := by
        calc γ = t⁻¹ • (t • γ) := by rw [smul_smul, inv_mul_cancel₀ ht, one_smul]
          _ = algebraMap F F⟮β⟯ (-s / t) := by
            rw [h1, Algebra.algebraMap_eq_smul_one, smul_neg, smul_smul, neg_div, neg_smul,
              div_eq_inv_mul]
      rw [← hγ, hγ', ← map_pow, sq]
    subst ht
    refine ⟨?_, rfl⟩
    simpa using hst
  -- `F⟮β⟯` has degree `2`, as `X ^ 2 - b` is the minimal polynomial of `β`.
  have hirr : Irreducible (Polynomial.X ^ 2 - Polynomial.C b) :=
    irreducible_X_pow_sub_C_of_prime Nat.prime_two fun c hc => hb ⟨c, by rw [← hc, sq]⟩
  have hmonic : (Polynomial.X ^ 2 - Polynomial.C b).Monic :=
    Polynomial.monic_X_pow_sub_C b two_ne_zero
  have haeval : Polynomial.aeval β (Polynomial.X ^ 2 - Polynomial.C b) = 0 := by
    simp [hβ]
  have hint : IsIntegral F β := ⟨_, hmonic, by simpa [Polynomial.eval₂_eq_eval_map] using haeval⟩
  have hfin : Module.finrank F F⟮β⟯ = 2 := by
    rw [adjoin.finrank hint, ← minpoly.eq_of_irreducible_of_monic hirr haeval hmonic,
      Polynomial.natDegree_X_pow_sub_C]
  let B : Module.Basis (Fin 2) F F⟮β⟯ :=
    basisOfLinearIndependentOfCardEqFinrank hli (by rw [hfin, Fintype.card_fin])
  have hB : ⇑B = ![1, γ] := coe_basisOfLinearIndependentOfCardEqFinrank _ _
  have hB0 : B 0 = 1 := by rw [hB]; rfl
  have hB1 : B 1 = γ := by rw [hB]; rfl
  refine ⟨B, hB0, hB1, fun ξ => ?_⟩
  have hξ : ξ = B.repr ξ 0 • (1 : F⟮β⟯) + B.repr ξ 1 • γ := by
    conv_lhs => rw [← B.sum_repr ξ]
    rw [Fin.sum_univ_two, hB0, hB1]
  have hmul : ξ * γ = (B.repr ξ 1 * b) • B 0 + B.repr ξ 0 • B 1 := by
    rw [hB0, hB1]
    conv_lhs => rw [hξ]
    rw [add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, ← sq, hγ,
      Algebra.algebraMap_eq_smul_one, smul_smul, add_comm]
  have hrepr : ∀ c₀ c₁ : F, B.repr (c₀ • B 0 + c₁ • B 1) 0 = c₀ ∧
      B.repr (c₀ • B 0 + c₁ • B 1) 1 = c₁ := by
    intro c₀ c₁
    simp [Module.Basis.repr_self]
  rw [Algebra.norm_eq_matrix_det B, Matrix.det_fin_two]
  simp only [Algebra.leftMulMatrix_eq_repr_mul, hB0, mul_one]
  rw [hB1, hmul, (hrepr _ _).1, (hrepr _ _).2]
  ring

/-- **The norm criterion for the Hilbert symbol.** Let $F$ be a field in which $2 \neq 0$, let
$a, b \in F$ be nonzero, and let $\beta$ be an element with $\beta^2 = b$ of a field extension $L$
of $F$, so that $F(\beta) \subseteq L$ is the field $F(\sqrt b)$. Then the Hilbert symbol $(a, b)$
equals $1$ if and only if $a$ is the norm $N_{F(\beta)/F}(\xi)$ of a nonzero element $\xi$ of
$F(\beta)$. If $b$ is a square in $F$, then $F(\beta) = F$, every $a$ is such a norm, and
$(a, b) = 1$ for every $a$ (J.-P. Serre, *A Course in Arithmetic*, Chapter III, §1.1,
Proposition 1, p. 19; Serre takes $F = \mathbb{R}$ or $\mathbb{Q}_p$). -/
theorem eq_one_iff_exists_norm_eq (h2 : (2 : F) ≠ 0) (a b : Fˣ) {β : L}
    (hβ : β ^ 2 = algebraMap F L b) :
    hilbertSymbol F a b = 1 ↔ ∃ ξ : (F⟮β⟯)ˣ, Algebra.norm F (ξ : F⟮β⟯) = a := by
  by_cases hb : IsSquare (b : F)
  · refine ⟨fun _ => ?_, fun _ => eq_one_of_isSquare_right hb⟩
    obtain ⟨c, hc⟩ := hb
    -- `β = ± c` lies in `F`, so `F⟮β⟯ = F`.
    have hβF : β ∈ (⊥ : IntermediateField F L) := by
      have hfac : (β + algebraMap F L c) * (β - algebraMap F L c) = 0 := by
        rw [← sq_sub_sq, hβ, hc, map_mul, sq, sub_self]
      rcases mul_eq_zero.1 hfac with h | h
      · rw [eq_neg_of_add_eq_zero_left h, ← map_neg]
        exact IntermediateField.algebraMap_mem _ (-c)
      · rw [sub_eq_zero.1 h]
        exact IntermediateField.algebraMap_mem _ c
    have hfin : Module.finrank F F⟮β⟯ = 1 :=
      IntermediateField.finrank_eq_one_iff.2 (adjoin_simple_eq_bot_iff.2 hβF)
    refine ⟨Units.mk0 (algebraMap F F⟮β⟯ a) ((map_ne_zero _).2 a.ne_zero), ?_⟩
    rw [Units.val_mk0, Algebra.norm_algebraMap, hfin, pow_one]
  · obtain ⟨B, hB0, hB1, hnorm⟩ := exists_basis_norm_eq hb hβ
    rw [eq_one_iff_exists_eq_sq_sub_mul_sq h2]
    constructor
    · rintro ⟨z, y, h⟩
      have hrepr : B.repr (z • B 0 + y • B 1) 0 = z ∧ B.repr (z • B 0 + y • B 1) 1 = y := by
        simp [Module.Basis.repr_self]
      have hN : Algebra.norm F (z • B 0 + y • B 1) = a := by
        rw [hnorm, hrepr.1, hrepr.2, h]
      have hne : z • B 0 + y • B 1 ≠ 0 := by
        intro h0
        have : Module.Finite F F⟮β⟯ := Module.Finite.of_basis B
        rw [h0, Algebra.norm_zero] at hN
        exact a.ne_zero hN.symm
      exact ⟨Units.mk0 _ hne, by rw [Units.val_mk0, hN]⟩
    · rintro ⟨ξ, hξ⟩
      exact ⟨B.repr ξ 0, B.repr ξ 1, by rw [← hξ, hnorm]⟩

end Norm

/-- **The Hilbert symbol of a square.** For a field $F$ and nonzero $a, c \in F$, the Hilbert
symbol satisfies $(a, c^2) = 1$ (J.-P. Serre, *A Course in Arithmetic*, Chapter III, §1.1,
Proposition 2 i), p. 19). -/
theorem sq_right (a c : Fˣ) : hilbertSymbol F a (c ^ 2) = 1 :=
  eq_one_of_isSquare_right ⟨c, by rw [Units.val_pow_eq_pow_val, sq]⟩

/-- **The Hilbert symbol of $a$ and $-a$.** For a field $F$ in which $2 \neq 0$ and nonzero
$a \in F$, the Hilbert symbol satisfies $(a, -a) = 1$ (J.-P. Serre, *A Course in Arithmetic*,
Chapter III, §1.1, Proposition 2 ii), p. 19). -/
theorem self_neg (h2 : (2 : F) ≠ 0) (a : Fˣ) : hilbertSymbol F a (-a) = 1 := by
  rw [eq_one_iff_exists_ternary_eq_zero h2]
  exact ⟨0, 1, 1, fun h => one_ne_zero h.2.1, by rw [Units.val_neg]; ring⟩

/-- **The Hilbert symbol of $a$ and $1 - a$.** For a field $F$ and $a \in F$ with $a \neq 0$ and
$a \neq 1$, the Hilbert symbol satisfies $(a, 1 - a) = 1$ (J.-P. Serre, *A Course in Arithmetic*,
Chapter III, §1.1, Proposition 2 ii), p. 19). -/
theorem self_one_sub (a : Fˣ) (ha : 1 - (a : F) ≠ 0) :
    hilbertSymbol F a (Units.mk0 (1 - (a : F)) ha) = 1 := by
  rw [eq_one_iff]
  exact ⟨1, 1, by rw [Units.val_mk0]; ring⟩

/-- Values of the norm form `z ^ 2 - b y ^ 2` are closed under multiplication. -/
private theorem normForm_mul {b u v : F} (hu : ∃ z y : F, u = z ^ 2 - b * y ^ 2)
    (hv : ∃ z y : F, v = z ^ 2 - b * y ^ 2) : ∃ z y : F, u * v = z ^ 2 - b * y ^ 2 := by
  obtain ⟨z, y, rfl⟩ := hu
  obtain ⟨z', y', rfl⟩ := hv
  exact ⟨z * z' + b * y * y', z * y' + y * z', by ring⟩

/-- Nonzero values of the norm form `z ^ 2 - b y ^ 2` are closed under inverses. -/
private theorem normForm_inv {b u : F} (hu0 : u ≠ 0) (hu : ∃ z y : F, u = z ^ 2 - b * y ^ 2) :
    ∃ z y : F, u⁻¹ = z ^ 2 - b * y ^ 2 := by
  obtain ⟨z, y, rfl⟩ := hu
  refine ⟨z / (z ^ 2 - b * y ^ 2), y / (z ^ 2 - b * y ^ 2), ?_⟩
  field_simp

/-- **Multiplying by an element of trivial symbol.** For a field $F$ in which $2 \neq 0$ and
nonzero $a, a', b \in F$, if the Hilbert symbol $(a, b)$ equals $1$, then $(a a', b) = (a', b)$
(J.-P. Serre, *A Course in Arithmetic*, Chapter III, §1.1, Proposition 2 iii) and its proof,
pp. 19–20). -/
theorem mul_left_of_eq_one (h2 : (2 : F) ≠ 0) {a b : Fˣ} (h : hilbertSymbol F a b = 1)
    (a' : Fˣ) : hilbertSymbol F (a * a') b = hilbertSymbol F a' b := by
  refine eq_of_eq_one_iff ?_
  rw [eq_one_iff_exists_eq_sq_sub_mul_sq h2] at h
  rw [eq_one_iff_exists_eq_sq_sub_mul_sq h2, eq_one_iff_exists_eq_sq_sub_mul_sq h2,
    Units.val_mul]
  refine ⟨fun h' => ?_, fun h' => normForm_mul h h'⟩
  have := normForm_mul (normForm_inv a.ne_zero h) h'
  rwa [← mul_assoc, inv_mul_cancel₀ a.ne_zero, one_mul] at this

/-- **The Hilbert symbol is unchanged by $b \mapsto -a b$.** For a field $F$ in which $2 \neq 0$
and nonzero $a, b \in F$, the Hilbert symbol satisfies $(a, b) = (a, -a b)$ (J.-P. Serre,
*A Course in Arithmetic*, Chapter III, §1.1, Proposition 2 iv), p. 19). -/
theorem eq_neg_mul_right (h2 : (2 : F) ≠ 0) (a b : Fˣ) :
    hilbertSymbol F a b = hilbertSymbol F a (-(a * b)) := by
  rw [comm a (-(a * b)), ← neg_mul,
    mul_left_of_eq_one h2 (by rw [comm]; exact self_neg h2 a), comm]

/-- **The Hilbert symbol is unchanged by $b \mapsto (1 - a) b$.** For a field $F$ in which
$2 \neq 0$ and $a, b \in F$ with $a, b \neq 0$ and $a \neq 1$, the Hilbert symbol satisfies
$(a, b) = (a, (1 - a) b)$ (J.-P. Serre, *A Course in Arithmetic*, Chapter III, §1.1,
Proposition 2 iv), p. 19). -/
theorem eq_one_sub_mul_right (h2 : (2 : F) ≠ 0) (a b : Fˣ) (ha : 1 - (a : F) ≠ 0) :
    hilbertSymbol F a b = hilbertSymbol F a (Units.mk0 (1 - (a : F)) ha * b) := by
  rw [comm a (Units.mk0 _ ha * b),
    mul_left_of_eq_one h2 (by rw [comm]; exact self_one_sub a ha), comm]

/-- **First properties of the Hilbert symbol.** Let $F$ be a field in which $2 \neq 0$ and let
$a, a', b, c \in F$ be nonzero. Then the Hilbert symbol satisfies:

1. $(a, b) = (b, a)$ and $(a, c^2) = 1$;
2. $(a, -a) = 1$, and $(a, 1 - a) = 1$ if $a \neq 1$;
3. if $(a, b) = 1$, then $(a a', b) = (a', b)$;
4. $(a, b) = (a, -a b)$, and $(a, b) = (a, (1 - a) b)$ if $a \neq 1$.

(J.-P. Serre, *A Course in Arithmetic*, Chapter III, §1.1, Proposition 2, p. 19, with its proof
on pp. 19–20; Serre takes $F = \mathbb{R}$ or $\mathbb{Q}_p$.) -/
theorem first_properties (h2 : (2 : F) ≠ 0) (a a' b c : Fˣ) :
    (hilbertSymbol F a b = hilbertSymbol F b a ∧ hilbertSymbol F a (c ^ 2) = 1) ∧
      (hilbertSymbol F a (-a) = 1 ∧
        ∀ ha : 1 - (a : F) ≠ 0, hilbertSymbol F a (Units.mk0 (1 - (a : F)) ha) = 1) ∧
      (hilbertSymbol F a b = 1 → hilbertSymbol F (a * a') b = hilbertSymbol F a' b) ∧
      (hilbertSymbol F a b = hilbertSymbol F a (-(a * b)) ∧
        ∀ ha : 1 - (a : F) ≠ 0,
          hilbertSymbol F a b = hilbertSymbol F a (Units.mk0 (1 - (a : F)) ha * b)) :=
  ⟨⟨comm a b, sq_right a c⟩, ⟨self_neg h2 a, self_one_sub a⟩,
    fun h => mul_left_of_eq_one h2 h a', ⟨eq_neg_mul_right h2 a b, eq_one_sub_mul_right h2 a b⟩⟩

end hilbertSymbol
