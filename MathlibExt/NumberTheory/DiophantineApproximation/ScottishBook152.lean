/-!
# Lattice points in translated unit discs

Steinhaus's disc frequencies exist by equidistribution on the closed subgroup generated by
the translation. Distinct translates of the boundary circles meet in only countably many
points modulo the lattice.
-/

@[expose] public section

open Filter Set MeasureTheory
open scoped Topology

namespace MathlibExt.NumberTheory.DiophantineApproximation.ScottishBook152Wanted

/-- **Lattice points in a translated unit disc.** For $w = (w_1, w_2) \in \mathbb{R}^2$ and a
natural number $n$, the disc lattice count is the number of integer points
$(p_1, p_2) \in \mathbb{Z}^2$ in the closed disc of radius $1$ centred at $n w$, that is, with
$(p_1 - n w_1)^2 + (p_2 - n w_2)^2 \le 1$. -/
noncomputable def DiscLatticeCount (w : ℝ × ℝ) (n : ℕ) : ℕ :=
  Set.ncard {p : ℤ × ℤ | ((p.1 : ℝ) - (n : ℝ) * w.1) ^ 2 +
    ((p.2 : ℝ) - (n : ℝ) * w.2) ^ 2 ≤ 1}

private abbrev Torus := UnitAddCircle × UnitAddCircle

private def lattice : ℤ × ℤ →+ ℂ where
  toFun p := ⟨p.1, p.2⟩
  map_zero' := Complex.ext (by simp) (by simp)
  map_add' p q := Complex.ext (by simp) (by simp)

private def project : ℂ →+ Torus where
  toFun z := (z.re, z.im)
  map_zero' := by ext <;> simp
  map_add' x y := by ext <;> simp

private lemma project_open : IsOpenMap project :=
  (QuotientAddGroup.isOpenMap_coe.prodMap QuotientAddGroup.isOpenMap_coe).comp
    Complex.equivRealProdCLM.toHomeomorph.isOpenMap

private lemma project_surj : Function.Surjective project := by
  rintro ⟨a, b⟩
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective a
  obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective b
  exact ⟨⟨x, y⟩, rfl⟩

private lemma project_eq_zero {z : ℂ} :
    project z = 0 ↔ ∃ p, lattice p = z := by
  change ((z.re : UnitAddCircle), (z.im : UnitAddCircle)) = (0, 0) ↔ _
  rw [Prod.mk.injEq, AddCircle.coe_eq_zero_iff, AddCircle.coe_eq_zero_iff]
  simp only [zsmul_eq_mul, mul_one]
  constructor
  · rintro ⟨⟨a, ha⟩, b, hb⟩
    exact ⟨(a, b), Complex.ext ha hb⟩
  · rintro ⟨p, rfl⟩
    exact ⟨⟨p.1, rfl⟩, p.2, rfl⟩

private def points (z : ℂ) : Set (ℤ × ℤ) := {p | dist (lattice p) z ≤ 1}

private lemma points_add (z : ℂ) (p : ℤ × ℤ) :
    points (z + lattice p) = (· + p) '' points z := by
  ext q
  constructor
  · intro h
    refine ⟨q - p, ?_, sub_add_cancel ..⟩
    simpa [points, dist_eq_norm, sub_add_eq_sub_sub, sub_right_comm, map_sub] using h
  · rintro ⟨r, hr, rfl⟩
    simpa [points, dist_add_right] using hr

private def level (m : ℕ) : Set Torus := project '' {z | (points z).ncard = m}

private lemma project_mem_level (z : ℂ) (m : ℕ) :
    project z ∈ level m ↔ (points z).ncard = m := by
  constructor
  · rintro ⟨y, hy, he⟩
    obtain ⟨p, hp⟩ := project_eq_zero.mp (show project (z - y) = 0 by simp [he])
    rw [show z = y + lattice p by rw [hp]; abel, points_add,
      ncard_image_of_injective _ (add_left_injective p)]
    exact hy
  · exact fun h => ⟨z, h, rfl⟩

private lemma finite_near (z : ℂ) (r : ℝ) :
    (lattice ⁻¹' Metric.closedBall z r).Finite := by
  have h : Topology.IsClosedEmbedding lattice :=
    Complex.equivRealProdCLM.symm.toHomeomorph.isClosedEmbedding.comp
      (Int.isClosedEmbedding_coe_real.prodMap Int.isClosedEmbedding_coe_real)
  exact (h.isCompact_preimage (isCompact_closedBall z r)).finite_of_discrete

private lemma points_locally_constant (z : ℂ) (hz : ∀ p, dist (lattice p) z ≠ 1) :
    ∀ᶠ y in 𝓝 z, points y = points z := by
  let s := lattice ⁻¹' Metric.closedBall z 2
  have hlocal (p : ℤ × ℤ) : ∀ᶠ y in 𝓝 z, p ∈ points y ↔ p ∈ points z := by
    rcases (hz p).lt_or_gt with h | h
    · filter_upwards [(continuous_const.dist continuous_id).continuousAt.eventually_lt
        (g := fun _ => (1 : ℝ)) continuousAt_const h] with y hy
      exact iff_of_true hy.le h.le
    · filter_upwards [continuousAt_const.eventually_lt
        (continuous_const.dist continuous_id).continuousAt h] with y hy
      exact iff_of_false (not_le.mpr hy) (not_le.mpr h)
  filter_upwards [(finite_near z 2).eventually_all.mpr (fun p _ => hlocal p),
    Metric.ball_mem_nhds z zero_lt_one] with y hy hyd
  ext p
  by_cases hp : p ∈ s
  · exact hy p hp
  · have hfar : 2 < dist (lattice p) z := lt_of_not_ge hp
    change dist (lattice p) y ≤ 1 ↔ dist (lattice p) z ≤ 1
    have := dist_triangle (lattice p) y z
    change dist y z < 1 at hyd
    constructor <;> intro h <;> linarith

private lemma circle_of_frontier {z : ℂ} {m : ℕ} (hz : project z ∈ frontier (level m)) :
    ∃ p, dist (lattice p) z = 1 := by
  by_contra! h
  have hb := project_open.preimage_frontier_subset_frontier_preimage hz
  have he : project ⁻¹' level m = {y | (points y).ncard = m} :=
    Set.ext fun y => project_mem_level y m
  rw [he, frontier_eq_closure_inter_closure] at hb
  have hc := points_locally_constant z h
  by_cases hm : (points z).ncard = m
  · exact (mem_closure_iff_frequently.mp hb.2) <|
      hc.mono fun y hy => fun hn => hn (show (points y).ncard = m by rw [hy, hm])
  · exact (mem_closure_iff_frequently.mp hb.1) <|
      hc.mono fun y hy => fun heq => hm (hy ▸ heq)

private lemma countable_two_circles (a b : ℂ) (hab : a ≠ b) :
    {z | dist z a = 1 ∧ dist z b = 1}.Countable := by
  let s := {z | dist z a = 1 ∧ dist z b = 1}
  by_cases hs : s.Subsingleton
  · exact hs.finite.countable
  obtain ⟨x, hx, y, hy, hxy⟩ := not_subsingleton_iff.mp hs
  refine ((countable_singleton y).insert x).mono fun z hz => ?_
  exact EuclideanGeometry.eq_of_dist_eq_of_dist_eq_of_finrank_eq_two Complex.finrank_real_complex
    hab hxy hx.1 hy.1 hz.1 hx.2 hy.2 hz.2

/-- A return to the frontier lifts to the intersection of two distinct circles in the plane. -/
private lemma countable_return (v : ℂ) (hv : project v ≠ 0) (m : ℕ) :
    (frontier (level m) ∩ (project v + ·) ⁻¹' frontier (level m)).Countable := by
  let circles (p q : ℤ × ℤ) := {z | dist z (lattice p) = 1 ∧ dist z (lattice q - v) = 1}
  have hc (p q : ℤ × ℤ) : (circles p q).Countable := by
    apply countable_two_circles
    intro h
    apply hv
    exact project_eq_zero.mpr ⟨q - p, by rw [map_sub, h]; abel⟩
  refine (countable_iUnion fun p => countable_iUnion fun q => (hc p q).image project).mono ?_
  rintro x ⟨hx, hx'⟩
  obtain ⟨z, rfl⟩ := project_surj x
  obtain ⟨p, hp⟩ := circle_of_frontier hx
  obtain ⟨q, hq⟩ := circle_of_frontier (z := v + z) (m := m) (by simpa using hx')
  refine mem_iUnion.mpr ⟨p, mem_iUnion.mpr ⟨q, z, ⟨(dist_comm ..).trans hp, ?_⟩, rfl⟩⟩
  simpa [dist_eq_norm, norm_sub_rev, sub_sub_eq_add_sub, add_comm] using hq

private lemma nonzero_multiple {w : ℂ} (hw : Irrational w.re) {n : ℕ} (hn : n ≠ 0) :
    project (n • w) ≠ 0 := by
  intro h
  obtain ⟨p, hp⟩ := project_eq_zero.mp h
  apply (hw.natCast_mul hn).ne_int p.1
  simpa [lattice, nsmul_eq_mul] using congrArg Complex.re hp.symm

/-! ### Equidistribution on the orbit closure -/

/-- For a continuous observable the convergence set is closed, so a.e. convergence suffices. -/
private lemma empirical_converges {G : Type*} [NormedAddCommGroup G]
    [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    {a : G} {μ : Measure G} [IsProbabilityMeasure μ] [μ.IsOpenPosMeasure]
    (hT : Ergodic (a + ·) μ) :
    Tendsto (fun n => (empiricalMeasure (a + ·) 0 n).toProbabilityMeasure)
      atTop (𝓝 μ.toProbabilityMeasure) := by
  apply ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mpr
  intro g
  have hae := MathlibExt.Dynamics.Ergodic.BirkhoffWanted.birkhoff_pointwise_ergodic hT
    (g.integrable μ)
  have hc := isClosed_setOfPred_tendsto_birkhoffAverage ℝ (isometry_add_left a).lipschitzWith
    (CompactSpace.uniformContinuous_of_continuous g.continuous)
    (l := fun _ => ∫ x, g x ∂μ) continuous_const
  have hall := hc.dense_iff.mp (μ.dense_of_ae hae)
  have h0 := Set.eq_univ_iff_forall.mp hall 0
  simpa only [Measure.coe_toProbabilityMeasure, integral_empiricalMeasure_eq_birkhoffaverage,
    birkhoffAverage_apply_congr_ring (R := NNReal) (S := ℝ)] using
    (tendsto_add_atTop_iff_nat 1).mpr h0

open scoped Classical in
private lemma empirical_mass {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableSingletonClass G] (a : G) (s : Set G) (n : ℕ) :
    (empiricalMeasure (a + ·) 0 n).real s =
      ((Finset.range (n + 1)).filter (fun k => k • a ∈ s)).card / ((n + 1 : ℕ) : ℝ) := by
  classical
  simp [Measure.real, empiricalMeasure, birkhoffAverage, birkhoffSum, Measure.dirac_apply,
    Set.indicator, Finset.sum_boole, ENNReal.smul_def, div_eq_inv_mul, ENNReal.toReal_add]

open scoped Classical in
private lemma frequency_on_torus (w : ℂ) (hw : Irrational w.re) (m : ℕ) :
    ∃ r : ℝ, Tendsto (fun n : ℕ =>
      (((Finset.range n).filter fun k => project (k • w) ∈ level m).card : ℝ) / n)
      atTop (𝓝 r) := by
  let H := (AddSubgroup.zmultiples (project w)).topologicalClosure
  let a : H := ⟨project w, AddSubgroup.le_topologicalClosure _ (AddSubgroup.mem_zmultiples _)⟩
  let : CompactSpace H := isCompact_iff_compactSpace.mp
    (AddSubgroup.isClosed_topologicalClosure _).isCompact
  let μ : Measure H := Measure.addHaarMeasure ⊤
  let : IsProbabilityMeasure μ := ⟨Measure.addHaarMeasure_self⟩
  have hd : DenseRange (fun k : ℤ => k • a) := by
    intro x
    rw [closure_subtype, ← range_comp]
    simpa only [Function.comp_def, AddSubgroup.coe_zsmul, ← AddSubgroup.coe_zmultiples]
      using (show (x : Torus) ∈ closure (AddSubgroup.zmultiples (project w) : Set Torus) from
        x.property)
  have hT := ergodic_add_left_of_denseRange_zsmul hd μ
  have hne (k : ℕ) (hk : k ≠ 0) : k • a ≠ 0 := by
    intro h
    exact nonzero_multiple hw hk (by rw [map_nsmul]; exact congrArg Subtype.val h)
  have hrec := hT.toMeasurePreserving.conservative
  -- Recurrence of a singleton would force a nonzero period.
  have : NullSingletonClass μ := by
    constructor
    intro x
    by_contra h
    obtain ⟨y, rfl, k, hk, hy⟩ := hrec.exists_mem_iterate_mem
      (measurableSet_singleton x).nullMeasurableSet h
    exact hne k hk (by simpa using hy)
  let s : Set H := Subtype.val ⁻¹' level m
  -- Positive frontier measure would force a positive-measure return to the frontier.
  have hb : μ (frontier s) = 0 := by
    by_contra h
    obtain ⟨k, hk, hpos⟩ := hrec.exists_gt_measure_inter_ne_zero
      isClosed_frontier.measurableSet.nullMeasurableSet h 0
    apply hpos
    apply Set.Countable.measure_zero
    refine ((countable_return (k • w) (nonzero_multiple hw hk.ne') m).preimage
      (Subtype.val_injective (p := (· ∈ H)))).mono ?_
    intro x hx
    have hf := (continuous_subtype_val (p := (· ∈ H))).frontier_preimage_subset (level m)
    refine ⟨hf hx.1, ?_⟩
    change project (k • w) + (x : Torus) ∈ frontier (level m)
    rw [map_nsmul]
    exact hf (show k • a + x ∈ frontier s by simpa only [mem_preimage, add_left_iterate_apply]
      using hx.2)
  have ht := ProbabilityMeasure.tendsto_measure_of_null_frontier_of_tendsto'
    (empirical_converges hT) (E := s) (by simpa using hb)
  refine ⟨μ.real s, (tendsto_add_atTop_iff_nat 1).mp ?_⟩
  have hmass : Tendsto (fun n => (empiricalMeasure (a + ·) 0 n).real s) atTop (𝓝 (μ.real s)) :=
    (ENNReal.tendsto_toReal (measure_ne_top μ s)).comp ht
  simpa only [empirical_mass, s, mem_preimage, AddSubgroup.coe_nsmul, map_nsmul, a] using hmass

/--
**Steinhaus's disc frequencies exist.** Let $w = (w_1, w_2) \in \mathbb{R}^2$ be such that
$w_1$, $w_2$ and $w_1 / w_2$ are all irrational, and for each natural number $n$ let $c(n)$ be the
disc lattice count of $w$ and $n$, the number of integer lattice points in the closed disc of
radius $1$ centred at $n w$. Then for each $m$ equal to $2$, $3$ or $4$, the proportion of the
integers $n$ with $0 \le n < N$ and $c(n) = m$ converges to a real number as $N \to \infty$.

A closed disc of radius $1$ always covers at least two and at most five lattice points. The
frequency values themselves are not pinned down here: they are the measures of the corresponding
regions for the limiting distribution of $n w$ modulo the lattice, and in particular depend on
$w$.

Source: H. Steinhaus, Problem 152 of the Scottish Book; J. Mycielski's
commentary in Mauldin (ed.), The Scottish Book, 2nd ed. (2015) explains the
solution using facts from Diophantine approximation, as reported in the 2026
survey "90+ years of the Scottish Book" (arXiv:2603.27867).
-/
theorem steinhausDiscFrequenciesExist :
    ∀ w : ℝ × ℝ, Irrational w.1 → Irrational w.2 → Irrational (w.1 / w.2) →
      ∀ m : ℕ, m = 2 ∨ m = 3 ∨ m = 4 →
        ∃ freq : ℝ, Filter.Tendsto
          (fun N : ℕ => ((Finset.filter (fun n => DiscLatticeCount w n = m)
            (Finset.range N)).card : ℝ) / (N : ℝ))
          Filter.atTop (nhds freq) := by
  classical
  intro w hw _ _ m _
  let v : ℂ := ⟨w.1, w.2⟩
  obtain ⟨r, hr⟩ := frequency_on_torus v hw m
  have he (n : ℕ) : points (n • v) = {p : ℤ × ℤ |
      ((p.1 : ℝ) - (n : ℝ) * w.1) ^ 2 + ((p.2 : ℝ) - (n : ℝ) * w.2) ^ 2 ≤ 1} := by
    ext p
    change dist (lattice p) (n • v) ≤ 1 ↔ _
    rw [Complex.dist_eq_re_im, Real.sqrt_le_iff]
    simp [lattice, v, nsmul_eq_mul]
  refine ⟨r, hr.congr fun N => ?_⟩
  congr 2
  apply congrArg Finset.card
  apply Finset.filter_congr
  intro n _
  rw [project_mem_level, he, DiscLatticeCount]

end MathlibExt.NumberTheory.DiophantineApproximation.ScottishBook152Wanted
