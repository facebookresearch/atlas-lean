/-!
# Units of orders in imaginary quadratic fields

Let `K` be an imaginary quadratic field, encoded as `Module.finrank ℚ K = 2` together with
Mathlib's class `NumberField.IsTotallyComplex K` (no real places), let `𝒪_K = integralClosure ℤ K`
be its ring of integers and let `O` be an order of `K` (`NumberField.IsOrder K O`). We prove
(K. Conrad, *Dirichlet's unit theorem*, Example 2.2, p. 2):

* `NumberField.IsOrder.natCard_units_integralClosure`: `𝒪_Kˣ` is finite of order `2`, `4` or `6`;
* `NumberField.IsOrder.natCard_units_of_ne`: if `O ≠ 𝒪_K`, then `Oˣ = {±1}` has order `2`;
* `NumberField.IsOrder.index_units_range`: the unit index `[𝒪_Kˣ : Oˣ]` is `1`, `2` or `3`; it
  is `1` when `O = 𝒪_K` and `#𝒪_Kˣ / 2` otherwise.

The unit index `[𝒪_Kˣ : Oˣ]` is the denominator in K. Conrad, *The conductor ideal of an order*,
Theorem 5.3 (p. 16); Examples 5.4 (p. 16) and 5.5 (p. 17) use the values `4/2` for
`ℤ[pi] ⊆ ℤ[i]` and `6/2` for `ℤ[√−3] ⊆ ℤ[ζ₃]`.

The proof: by Dirichlet's unit theorem (Mathlib's `NumberField.Units.exist_unique_eq_mul_prod`)
with unit rank `0`, every unit of `𝒪_K` is a root of unity. A finite subgroup of `Kˣ` is cyclic,
generated by a primitive `n`-th root of unity `ζ`, whose minimal polynomial over `ℚ` is the
cyclotomic polynomial of degree `φ(n) ≤ [K : ℚ] = 2`; so `n ∈ {1, 2, 3, 4, 6}`, and `n` is even
as `-1` is a unit. If an order contains a primitive `4`-th or `3`-rd root of unity `ζ`, then
`K = ℚ(ζ)` and `ℤ[ζ] = 𝒪_K` (Mathlib's
`IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton_of_prime_pow`), so the order is
`𝒪_K`.
-/

open NumberField Polynomial

namespace NumberField.IsOrder

/-- A positive integer `n` with `φ(n) ≤ 2` is `1`, `2`, `3`, `4` or `6`. -/
private theorem eq_of_totient_le_two {n : ℕ} (hn : 0 < n) (h : n.totient ≤ 2) :
    n = 1 ∨ n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 6 := by
  have hpos : 0 < n.totient := Nat.totient_pos.mpr hn
  have hdvd : ∀ m, m ∣ n → m.totient ≤ 2 := fun m hm =>
    (Nat.le_of_dvd hpos (Nat.totient_dvd_of_dvd hm)).trans h
  have hp : ∀ p, p.Prime → p ∣ n → p = 2 ∨ p = 3 := by
    intro p hp hpn
    have h1 := hdvd p hpn
    rw [Nat.totient_prime hp] at h1
    have h2 := hp.two_le
    have h3 : p ≤ 3 := by omega
    interval_cases p <;> simp
  have h8 : ¬ 8 ∣ n := fun h8 => by
    have := hdvd 8 h8
    have h8' : Nat.totient 8 = 4 := by decide
    omega
  have h9 : ¬ 9 ∣ n := fun h9 => by
    have := hdvd 9 h9
    have h9' : Nat.totient 9 = 6 := by decide
    omega
  obtain ⟨a, m, hm, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hn.ne'
  have hm0 : m ≠ 0 := by rintro rfl; simp at hm
  obtain ⟨b, m', hm', rfl⟩ := Nat.exists_eq_pow_mul_and_not_dvd hm0 3 (by norm_num)
  have hm'1 : m' = 1 := by
    rw [Nat.eq_one_iff_not_exists_prime_dvd]
    intro p hpp hpm'
    rcases hp p hpp (Dvd.dvd.mul_left (Dvd.dvd.mul_left hpm' _) _) with rfl | rfl
    · exact (Nat.not_even_iff_odd.mpr hm) (even_iff_two_dvd.mpr (Dvd.dvd.mul_left hpm' _))
    · exact hm' hpm'
  subst hm'1
  have ha : a ≤ 2 := by
    by_contra ha
    exact h8 (Dvd.dvd.mul_right (pow_dvd_pow 2 (by omega : 3 ≤ a)) _)
  have hb : b ≤ 1 := by
    by_contra hb
    exact h9 (Dvd.dvd.mul_left (Dvd.dvd.mul_right (pow_dvd_pow 3 (by omega : 2 ≤ b)) _) _)
  have h12 : Nat.totient 12 = 4 := by decide
  interval_cases a <;> interval_cases b <;> simp_all

variable {K : Type*} [Field K] [NumberField K] {O : Subalgebra ℤ K}

/-- A finite group embedded in `Kˣ`, `[K : ℚ] = 2`, is cyclic of order `1, 2, 3, 4` or `6`,
generated by a primitive root of unity. -/
private theorem exists_isPrimitiveRoot_natCard {G : Type*} [Group G] [Finite G] (f : G →* K)
    (hf : Function.Injective f) (hK : Module.finrank ℚ K = 2) :
    ∃ g : G, IsPrimitiveRoot (f g) (Nat.card G) ∧
      (Nat.card G = 1 ∨ Nat.card G = 2 ∨ Nat.card G = 3 ∨ Nat.card G = 4 ∨
        Nat.card G = 6) := by
  have : IsCyclic G := isCyclic_of_injective_ringHom f hf
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  have hord : orderOf (f g) = Nat.card G := by
    rw [orderOf_injective f hf g, orderOf_eq_card_of_forall_mem_zpowers hg]
  have hprim : IsPrimitiveRoot (f g) (Nat.card G) := hord ▸ IsPrimitiveRoot.orderOf (f g)
  have hpos : 0 < Nat.card G := Nat.card_pos
  refine ⟨g, hprim, eq_of_totient_le_two hpos ?_⟩
  have h1 := minpoly.natDegree_le (A := ℚ) (f g)
  rwa [← Polynomial.cyclotomic_eq_minpoly_rat hprim hpos, Polynomial.natDegree_cyclotomic,
    hK] at h1

/-- A finite group embedded in a field of characteristic zero, containing `-1`, has even
order. -/
private theorem two_dvd_natCard {G : Type*} [Group G] [Finite G] (f : G →* K)
    (hf : Function.Injective f) {g : G} (hg : f g = -1) : 2 ∣ Nat.card G := by
  have h : orderOf g = 2 := by
    rw [← orderOf_injective f hf g, hg, orderOf_neg_one, ringChar.eq_zero]
    norm_num
  exact h ▸ orderOf_dvd_natCard g

/-- The units of a subring `S` of `K`, as a multiplicative map into `K`. -/
private def unitsToField (S : Subalgebra ℤ K) : Sˣ →* K :=
  (S.val : S →* K).comp (Units.coeHom S)

omit [NumberField K] in
private theorem unitsToField_injective (S : Subalgebra ℤ K) :
    Function.Injective (unitsToField S) :=
  Subtype.val_injective.comp Units.val_injective

/-- If the units of a subring `S` of `K`, `[K : ℚ] = 2`, are finite, then there are `2`, `4` or
`6` of them, and they are generated by a primitive root of unity. -/
private theorem exists_isPrimitiveRoot_natCard_units (S : Subalgebra ℤ K) [Finite Sˣ]
    (hK : Module.finrank ℚ K = 2) :
    ∃ g : Sˣ, IsPrimitiveRoot ((g : S) : K) (Nat.card Sˣ) ∧
      (Nat.card Sˣ = 2 ∨ Nat.card Sˣ = 4 ∨ Nat.card Sˣ = 6) := by
  obtain ⟨g, hg, hc⟩ := exists_isPrimitiveRoot_natCard _ (unitsToField_injective S) hK
  have h2 : 2 ∣ Nat.card Sˣ :=
    two_dvd_natCard _ (unitsToField_injective S) (g := -1) (by simp [unitsToField])
  refine ⟨g, hg, ?_⟩
  rcases hc with h | h | h | h | h <;> omega

/-- The unit rank of an imaginary quadratic field is zero. -/
private theorem rank_eq_zero (hK : Module.finrank ℚ K = 2) [IsTotallyComplex K] :
    Units.rank K = 0 := by
  have h1 := InfinitePlace.card_add_two_mul_card_eq_rank K
  have h0 : InfinitePlace.nrRealPlaces K = 0 := nrRealPlaces_eq_zero_iff.mpr ‹_›
  rw [Units.rank, InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces]
  omega

/-- The unit group of the ring of integers of an imaginary quadratic field is finite. -/
private theorem finite_units (hK : Module.finrank ℚ K = 2) [IsTotallyComplex K] :
    Finite (integralClosure ℤ K)ˣ := by
  have hr := rank_eq_zero hK
  have hsurj : Function.Surjective ((↑) : Units.torsion K → (𝓞 K)ˣ) := by
    intro x
    obtain ⟨⟨ζ, e⟩, hx, -⟩ := Units.exist_unique_eq_mul_prod K x
    refine ⟨ζ, ?_⟩
    have : IsEmpty (Fin (Units.rank K)) := by rw [hr]; infer_instance
    rw [hx, Finset.univ_eq_empty, Finset.prod_empty, mul_one]
  exact Finite.of_surjective _ hsurj

/-- If an order `O` of `K`, `[K : ℚ] = 2`, contains a primitive `p ^ k`-th root of unity with
`φ(p ^ k) = 2`, then `O` contains the ring of integers. -/
private theorem integralClosure_le_of_isPrimitiveRoot (hK : Module.finrank ℚ K = 2) {p k : ℕ}
    [hp : Fact p.Prime] {ζ : K} (hζ : IsPrimitiveRoot ζ (p ^ k)) (htot : (p ^ k).totient = 2)
    (hζO : ζ ∈ O) : integralClosure ℤ K ≤ O := by
  have : NeZero (p ^ k) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
  have hpos : 0 < p ^ k := Nat.pos_of_ne_zero (NeZero.ne _)
  have hadj : IntermediateField.adjoin ℚ {ζ} = ⊤ := by
    apply IntermediateField.eq_of_le_of_finrank_eq le_top
    rw [IntermediateField.adjoin.finrank (.of_finite ℚ ζ), IntermediateField.finrank_top',
      ← Polynomial.cyclotomic_eq_minpoly_rat hζ hpos, natDegree_cyclotomic, htot, hK]
  have hcycl : IsCyclotomicExtension {p ^ k} ℚ K := by
    rw [IsCyclotomicExtension.iff_singleton]
    refine ⟨⟨ζ, hζ⟩, fun x => ?_⟩
    have hx : x ∈ Algebra.adjoin ℚ {ζ} := by
      rw [← IntermediateField.adjoin_toSubalgebra, hadj]
      trivial
    exact Algebra.adjoin_mono (Set.singleton_subset_iff.mpr hζ.pow_eq_one) hx
  have := IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton_of_prime_pow hζ
  intro x hx
  obtain ⟨y, rfl⟩ := IsIntegralClosure.isIntegral_iff (A := Algebra.adjoin ℤ {ζ}).mp hx
  exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr hζO) y.2

/-- **Units of the ring of integers of an imaginary quadratic field.** Let $K$ be an imaginary
quadratic field: $[K : \mathbb{Q}] = 2$ and $K$ has no real places (`NumberField.IsTotallyComplex`).
Then the unit group $\mathcal{O}_K^\times$ of its ring of integers (`integralClosure ℤ K`) is
finite of order $2$, $4$ or $6$.

K. Conrad, *Dirichlet's unit theorem*, Example 2.2 (p. 2): the unit group of an order is finite if
and only if $K$ is $\mathbb{Q}$ or imaginary quadratic, and "the unit group of each order in an
imaginary quadratic field is $\{\pm 1\}$ except for the maximal orders $\mathbb{Z}[i]$ and
$\mathbb{Z}[\zeta_3]$, whose units groups have size 4 and 6". The Lean statement does not say
which fields have $4$ or $6$ units. -/
theorem natCard_units_integralClosure (hK : Module.finrank ℚ K = 2) [IsTotallyComplex K] :
    Nat.card (integralClosure ℤ K)ˣ = 2 ∨ Nat.card (integralClosure ℤ K)ˣ = 4 ∨
      Nat.card (integralClosure ℤ K)ˣ = 6 := by
  have := finite_units hK
  exact (exists_isPrimitiveRoot_natCard_units _ hK).choose_spec.2

/-- The units of an order inject into the units of the ring of integers. -/
private theorem units_map_injective (hO : NumberField.IsOrder K O) :
    Function.Injective
      (Units.map (Subalgebra.inclusion hO.le_integralClosure : O →* integralClosure ℤ K)) :=
  Units.map_injective (Subalgebra.inclusion_injective hO.le_integralClosure)

/-- **Units of a non-maximal order of an imaginary quadratic field.** Let $K$ be an imaginary
quadratic field ($[K : \mathbb{Q}] = 2$, `NumberField.IsTotallyComplex K`) and $O$ an order of
$K$ (`NumberField.IsOrder`) with $O \neq \mathcal{O}_K$. Then $O^\times = \{\pm 1\}$ has order
$2$.

K. Conrad, *Dirichlet's unit theorem*, Example 2.2 (p. 2), quoted at
`NumberField.IsOrder.natCard_units_integralClosure`. -/
theorem natCard_units_of_ne (hO : NumberField.IsOrder K O) (hK : Module.finrank ℚ K = 2)
    [IsTotallyComplex K] (hne : O ≠ integralClosure ℤ K) : Nat.card Oˣ = 2 := by
  have := finite_units hK
  have : Finite Oˣ := Finite.of_injective _ (units_map_injective hO)
  obtain ⟨g, hg, h | h | h⟩ := exists_isPrimitiveRoot_natCard_units O hK
  · exact h
  · rw [h, show (4 : ℕ) = 2 ^ 2 by norm_num] at hg
    exact absurd (le_antisymm hO.le_integralClosure
      (integralClosure_le_of_isPrimitiveRoot hK hg (by decide) (g : O).2)) hne
  · rw [h] at hg
    have h3 : IsPrimitiveRoot (((g : O) : K) ^ 2) (3 ^ 1) := hg.pow (by norm_num) (by norm_num)
    exact absurd (le_antisymm hO.le_integralClosure
      (integralClosure_le_of_isPrimitiveRoot hK h3 (by decide) (pow_mem (g : O).2 2))) hne

/-- **The unit index of an order of an imaginary quadratic field.** Let $K$ be an imaginary
quadratic field ($[K : \mathbb{Q}] = 2$, `NumberField.IsTotallyComplex K`), $O$ an order of $K$
(`NumberField.IsOrder`), $\iota : O \hookrightarrow \mathcal{O}_K$ the inclusion, and $U$ the
image of $O^\times$ in $\mathcal{O}_K^\times$ under $\iota$. Then the index
$[\mathcal{O}_K^\times : O^\times] = [\mathcal{O}_K^\times : U]$ is $1$, $2$ or $3$; it is
$1$ if $O = \mathcal{O}_K$, and if $O \neq \mathcal{O}_K$ then
$2\,[\mathcal{O}_K^\times : O^\times] = \#\mathcal{O}_K^\times$.

This index is the denominator in K. Conrad, *The conductor ideal of an order*, Theorem 5.3
(p. 16), $h(O) = h(\mathcal{O}_K)\,[(\mathcal{O}_K/\mathfrak{c})^\times :
(O/\mathfrak{c})^\times] / [\mathcal{O}_K^\times : O^\times]$; its Examples 5.4 (p. 16) and 5.5
(p. 17) use the values $4/2$ for $\mathbb{Z}[pi] \subseteq \mathbb{Z}[i]$ and $6/2$ for
$\mathbb{Z}[\sqrt{-3}] \subseteq \mathbb{Z}[\zeta_3]$. The values follow from Conrad,
*Dirichlet's unit theorem*, Example 2.2 (p. 2). -/
theorem index_units_range (hO : NumberField.IsOrder K O) (hK : Module.finrank ℚ K = 2)
    [IsTotallyComplex K] :
    let U := (Units.map
      (Subalgebra.inclusion hO.le_integralClosure : O →* integralClosure ℤ K)).range
    (U.index = 1 ∨ U.index = 2 ∨ U.index = 3) ∧ (O = integralClosure ℤ K → U.index = 1) ∧
      (O ≠ integralClosure ℤ K → U.index * 2 = Nat.card (integralClosure ℤ K)ˣ) := by
  intro U
  have := finite_units hK
  have hcard : Nat.card U = Nat.card Oˣ :=
    (Nat.card_congr (MonoidHom.ofInjective (units_map_injective hO)).toEquiv).symm
  have hmul := U.card_mul_index
  rw [hcard] at hmul
  have hG := natCard_units_integralClosure hK
  have heq : O = integralClosure ℤ K → U.index = 1 := by
    intro h
    have hc : Nat.card Oˣ = Nat.card (integralClosure ℤ K)ˣ := by subst h; rfl
    rw [hc] at hmul
    have hpos : 0 < Nat.card (integralClosure ℤ K)ˣ := Nat.card_pos
    exact (Nat.mul_eq_left hpos.ne').mp hmul
  have hne : O ≠ integralClosure ℤ K → U.index * 2 = Nat.card (integralClosure ℤ K)ˣ := by
    intro h
    rw [← hmul, natCard_units_of_ne hO hK h, mul_comm]
  refine ⟨?_, heq, hne⟩
  by_cases h : O = integralClosure ℤ K
  · exact Or.inl (heq h)
  · have := hne h
    omega

end NumberField.IsOrder

end
