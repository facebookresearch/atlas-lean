module

public import MathlibExt.NumberTheory.NumberField.OrderConductorCorrespondence
public import MathlibExt.NumberTheory.NumberField.OrderInvertibleIdeals
public import Mathlib.RingTheory.ClassGroup.Basic
public import Mathlib.RingTheory.FractionalIdeal.Extended
public import Mathlib.NumberTheory.NumberField.Basic

/-!
# The class group of an order and its map to the class group of the maximal order

Let `O` be an order of a number field `K` (`NumberField.IsOrder K O`) and `𝒪_K` the ring of
integers `integralClosure ℤ K`. Extension of fractional ideals, `𝔟 ↦ 𝔟𝒪_K`
(`NumberField.IsOrder.extendFractionalIdeal`), is a ring homomorphism; it sends invertible
fractional ideals to invertible ones and principal ones to principal ones, so it induces a group
homomorphism of class groups `Cl(O) → Cl(𝒪_K)`, `[𝔟] ↦ [𝔟𝒪_K]`
(`NumberField.IsOrder.classGroupMap`).

Source: K. Conrad, *The conductor ideal of an order*, §5, p. 14 (the map `Cl(O) → Cl(𝒪_K)`
given by `[𝔟] ↦ [𝔟𝒪_K]`).
-/

@[expose] public section

open scoped nonZeroDivisors

variable {K : Type*} [Field K] [NumberField K] {O : Subalgebra ℤ K}

/-- The ring of integers `integralClosure ℤ K`, as a subalgebra, has fraction field `K`. -/
instance NumberField.instIsFractionRingIntegralClosure :
    IsFractionRing (integralClosure ℤ K) K :=
  inferInstanceAs (IsFractionRing (NumberField.RingOfIntegers K) K)

/-- The ring of integers `integralClosure ℤ K`, as a subalgebra, is a Dedekind domain. -/
instance NumberField.instIsDedekindDomainIntegralClosure :
    IsDedekindDomain (integralClosure ℤ K) :=
  inferInstanceAs (IsDedekindDomain (NumberField.RingOfIntegers K))

namespace NumberField.IsOrder

/-- The inclusion of an order into the ring of integers maps nonzero elements to nonzero
elements. -/
theorem le_comap_nonZeroDivisors (hO : NumberField.IsOrder K O) :
    O⁰ ≤ (integralClosure ℤ K)⁰.comap
      (Subalgebra.inclusion hO.le_integralClosure : O →+* integralClosure ℤ K) := by
  intro x hx
  rw [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero]
  intro h
  apply nonZeroDivisors.ne_zero hx
  exact Subtype.ext (congrArg (fun y : integralClosure ℤ K => (y : K)) h)

variable [IsFractionRing O K]

/-- **Extension of fractional ideals from an order to the ring of integers.** For an order `O`
of `K`, the fractional ideal `𝔟𝒪_K` of `𝒪_K` generated by a fractional ideal `𝔟` of `O`. (The
instance `IsFractionRing O K` is `NumberField.IsOrder.isFractionRing`.) -/
noncomputable def extendFractionalIdeal (hO : NumberField.IsOrder K O) :
    FractionalIdeal O⁰ K →+* FractionalIdeal (integralClosure ℤ K)⁰ K :=
  FractionalIdeal.extendedHom' K hO.le_comap_nonZeroDivisors

theorem localizationMap_eq (hO : NumberField.IsOrder K O) (x : K) :
    IsLocalization.map (S := K) K
      (Subalgebra.inclusion hO.le_integralClosure : O →+* integralClosure ℤ K)
      hO.le_comap_nonZeroDivisors x = x := by
  have h : (IsLocalization.map (S := K) K
      (Subalgebra.inclusion hO.le_integralClosure : O →+* integralClosure ℤ K)
      hO.le_comap_nonZeroDivisors : K →+* K) = RingHom.id K := by
    apply IsLocalization.ringHom_ext O⁰
    ext o
    simp only [RingHom.coe_comp, Function.comp_apply, IsLocalization.map_eq, RingHom.id_apply]
    rfl
  rw [h, RingHom.id_apply]

/-- The extension of the principal fractional ideal `xO` is `x𝒪_K`. -/
theorem extendFractionalIdeal_spanSingleton (hO : NumberField.IsOrder K O) (x : K) :
    hO.extendFractionalIdeal (FractionalIdeal.spanSingleton O⁰ x) =
      FractionalIdeal.spanSingleton (integralClosure ℤ K)⁰ x := by
  change FractionalIdeal.extended K _ _ = _
  rw [FractionalIdeal.extended_spanSingleton, hO.localizationMap_eq]

/-- The extension of an integral ideal `𝔟` of `O` is the ideal `𝔟𝒪_K`. -/
theorem extendFractionalIdeal_coeIdeal (hO : NumberField.IsOrder K O) (b : Ideal O) :
    hO.extendFractionalIdeal (b : FractionalIdeal O⁰ K) =
      ((b.map (Subalgebra.inclusion hO.le_integralClosure) : Ideal (integralClosure ℤ K)) :
        FractionalIdeal (integralClosure ℤ K)⁰ K) := by
  change FractionalIdeal.extended K _ _ = _
  rw [FractionalIdeal.extended_coeIdeal_eq_map]
  rfl

/-- Extension of fractional ideals maps principal fractional ideals of `O` to principal fractional
ideals of `𝒪_K`. -/
theorem range_toPrincipalIdeal_le (hO : NumberField.IsOrder K O) :
    (toPrincipalIdeal O K).range ≤ (toPrincipalIdeal (integralClosure ℤ K) K).range.comap
      (Units.map hO.extendFractionalIdeal.toMonoidHom) := by
  rintro _ ⟨x, rfl⟩
  refine ⟨x, ?_⟩
  ext1
  rw [coe_toPrincipalIdeal, Units.coe_map, coe_toPrincipalIdeal]
  exact (hO.extendFractionalIdeal_spanSingleton (x : K)).symm

/-- **The map of class groups.** For an order `O` of `K`, the group homomorphism
`Cl(O) → Cl(𝒪_K)`, `[𝔟] ↦ [𝔟𝒪_K]`, induced by extension of fractional ideals.

Source: K. Conrad, *The conductor ideal of an order*, §5, p. 14. -/
noncomputable def classGroupMap (hO : NumberField.IsOrder K O) :
    ClassGroup O →* ClassGroup (integralClosure ℤ K) :=
  (ClassGroup.equiv K).symm.toMonoidHom.comp
    ((QuotientGroup.map _ _ (Units.map hO.extendFractionalIdeal.toMonoidHom)
      hO.range_toPrincipalIdeal_le).comp (ClassGroup.equiv K).toMonoidHom)

/-- The map of class groups sends the class of an invertible fractional ideal `𝔟` of `O` to the
class of `𝔟𝒪_K`. -/
theorem classGroupMap_mk (hO : NumberField.IsOrder K O) (I : (FractionalIdeal O⁰ K)ˣ) :
    classGroupMap hO (ClassGroup.mk K I) =
      ClassGroup.mk K (Units.map hO.extendFractionalIdeal.toMonoidHom I) := by
  apply (ClassGroup.equiv K).injective
  simp only [classGroupMap, MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, Function.comp_apply,
    MulEquiv.apply_symm_apply]
  rw [ClassGroup.equiv_mk, ClassGroup.equiv_mk]
  simp only [FractionalIdeal.canonicalEquiv_self, RingEquiv.coe_mulEquiv_refl,
    QuotientGroup.mk'_apply, QuotientGroup.map_mk]
  rfl

end NumberField.IsOrder
