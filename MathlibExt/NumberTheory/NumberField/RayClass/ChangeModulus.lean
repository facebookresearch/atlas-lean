import MathlibExt.NumberTheory.NumberField.RayClass.CongruenceEquivalence

/-!
# Change of modulus (ATLAS NumberTheoryI item N422 / Lemma 22.5)

Fixed-modulus equivalence criterion: for moduli with `m2 ∣ m1`, a congruence
subgroup at `m1` admits an equivalent congruence subgroup at the fixed modulus
`m2` if and only if it already contains the part of the `m2`-ray group that is
coprime to `m1`, i.e. `coprimeFractionalIdeals m1 ⊓ rayGroupAmbient m2 ≤ C1`.

The definition `changeModulus` is the canonical witness: the pullback of `C1`
to the `m2`-coprime ideals joined with the `m2`-ray group, which is equivalent
to `C1` whenever the criterion holds.
-/

noncomputable section

open scoped nonZeroDivisors

namespace NumberField.Modulus

variable {K : Type*} [Field K] [NumberField K]

/-- **Ray group among all fractional ideals.** For a modulus $\mathfrak m$ of a number field
$K$, the ambient ray group of $\mathfrak m$ is the image of the ray group of $\mathfrak m$ under
the inclusion of the group of nonzero fractional ideals of $K$ coprime to the finite part of
$\mathfrak m$ into the group of all nonzero fractional ideals of $K$. -/
def rayGroupAmbient (m : Modulus K) : Subgroup ((FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
  (rayGroup m).map (coprimeFractionalIdeals m).subtype

/-- **The ray group consists of coprime ideals.** For every modulus $\mathfrak m$ of a number
field $K$, the ray group of $\mathfrak m$, viewed as a subgroup of the group of nonzero
fractional ideals of $K$, is contained in the group of nonzero fractional ideals coprime to the
finite part of $\mathfrak m$. -/
theorem rayGroupAmbient_le_coprime (m : Modulus K) :
    rayGroupAmbient m ≤ coprimeFractionalIdeals m := by
  intro x hx
  obtain ⟨y, _, rfl⟩ := Subgroup.mem_map.mp hx
  exact y.property

/-- **A congruence subgroup contains the ray group.** Let $C$ be a congruence subgroup for a
modulus $\mathfrak m$ of a number field $K$. Viewed as subgroups of the group of nonzero
fractional ideals of $K$, the ray group of $\mathfrak m$ is contained in $C$. -/
theorem CongruenceSubgroup.rayGroupAmbient_le_toAmbientSubgroup
    {m : Modulus K} (C : CongruenceSubgroup m) :
    rayGroupAmbient m ≤ C.toAmbientSubgroup :=
  Subgroup.map_mono C.rayGroup_le

/-- **Coprimality passes to divisors of a modulus.** Let $\mathfrak m_1$ and $\mathfrak m_2$ be
moduli of a number field $K$ with $\mathfrak m_2 \mid \mathfrak m_1$. Then every nonzero
fractional ideal of $K$ coprime to the finite part of $\mathfrak m_1$ is coprime to the finite
part of $\mathfrak m_2$. -/
theorem coprimeFractionalIdeals_le_of_dvd {m1 m2 : Modulus K}
    (h : m2 ∣ m1) :
    coprimeFractionalIdeals m1 ≤ coprimeFractionalIdeals m2 := by
  intro x hx
  rw [mem_coprimeFractionalIdeals_iff] at hx ⊢
  have hparts := (dvd_unfold m2 m1).mp h
  simp only [finiteSupported] at hx ⊢
  intro v hv
  exact hx v (hparts.1.trans hv)

/-- **Change of modulus of a congruence subgroup.** Let $C_1$ be a congruence subgroup for a
modulus $\mathfrak m_1$ of a number field $K$, viewed as a subgroup of the group of nonzero
fractional ideals of $K$, and let $\mathfrak m_2$ be any modulus of $K$. Write
$I^{\mathfrak m_2}$ for the group of nonzero fractional ideals of $K$ coprime to the finite part
of $\mathfrak m_2$ and $P_{\mathfrak m_2} \subseteq I^{\mathfrak m_2}$ for the ray group of
$\mathfrak m_2$. The change of modulus of $C_1$ to $\mathfrak m_2$ is the congruence subgroup for
$\mathfrak m_2$ generated, inside $I^{\mathfrak m_2}$, by $C_1 \cap I^{\mathfrak m_2}$ and
$P_{\mathfrak m_2}$. -/
def changeModulus {m1 : Modulus K} (C1 : CongruenceSubgroup m1)
    (m2 : Modulus K) : CongruenceSubgroup m2 where
  toSubgroup :=
    C1.toAmbientSubgroup.comap (coprimeFractionalIdeals m2).subtype ⊔
      rayGroup m2
  rayGroup_le := le_sup_right

/-- **Ambient subgroup of a change of modulus.** Let $\mathfrak m_1$ and $\mathfrak m_2$ be
moduli of a number field $K$ and let $C_1$ be a congruence subgroup for $\mathfrak m_1$. Write
$I^{\mathfrak m_2}$ for the group of nonzero fractional ideals of $K$ coprime to the finite part
of $\mathfrak m_2$ and $P_{\mathfrak m_2}$ for the ray group of $\mathfrak m_2$. Viewing all of
these as subgroups of the group of nonzero fractional ideals of $K$, the change of modulus of
$C_1$ to $\mathfrak m_2$ is the subgroup generated by $C_1 \cap I^{\mathfrak m_2}$ and
$P_{\mathfrak m_2}$. -/
theorem changeModulus_toAmbientSubgroup {m1 m2 : Modulus K}
    (C1 : CongruenceSubgroup m1) :
    (changeModulus C1 m2).toAmbientSubgroup =
      (C1.toAmbientSubgroup ⊓ coprimeFractionalIdeals m2) ⊔
        rayGroupAmbient m2 := by
  unfold changeModulus CongruenceSubgroup.toAmbientSubgroup
    rayGroupAmbient
  rw [Subgroup.map_sup, Subgroup.map_comap_eq,
    Subgroup.range_subtype, inf_comm (coprimeFractionalIdeals m2) _]

/-- **Ambient subgroup of a change of modulus to a divisor.** Let $\mathfrak m_1$ and
$\mathfrak m_2$ be moduli of a number field $K$ with $\mathfrak m_2 \mid \mathfrak m_1$, and let
$C_1$ be a congruence subgroup for $\mathfrak m_1$. Viewed as subgroups of the group of nonzero
fractional ideals of $K$, the change of modulus of $C_1$ to $\mathfrak m_2$ equals the subgroup
generated by $C_1$ and the ray group $P_{\mathfrak m_2}$ of $\mathfrak m_2$. -/
theorem changeModulus_toAmbientSubgroup_of_dvd {m1 m2 : Modulus K}
    (C1 : CongruenceSubgroup m1) (hdiv : m2 ∣ m1) :
    (changeModulus C1 m2).toAmbientSubgroup =
      C1.toAmbientSubgroup ⊔ rayGroupAmbient m2 := by
  rw [changeModulus_toAmbientSubgroup]
  have hle : C1.toAmbientSubgroup ≤ coprimeFractionalIdeals m2 :=
    le_trans C1.toAmbientSubgroup_le
      (coprimeFractionalIdeals_le_of_dvd hdiv)
  rw [inf_eq_left.mpr hle]

/-- **The change of modulus is equivalent to the original pair.** Let $\mathfrak m_1$ and
$\mathfrak m_2$ be moduli of a number field $K$ with $\mathfrak m_2 \mid \mathfrak m_1$, and let
$C_1$ be a congruence subgroup for $\mathfrak m_1$. Write $I^{\mathfrak m_1}$ for the group of
nonzero fractional ideals of $K$ coprime to the finite part of $\mathfrak m_1$ and
$P_{\mathfrak m_2}$ for the ray group of $\mathfrak m_2$, and view all of these as subgroups of
the group of nonzero fractional ideals of $K$. If
$I^{\mathfrak m_1} \cap P_{\mathfrak m_2} \subseteq C_1$, then the pair $(\mathfrak m_1, C_1)$ is
equivalent to the pair $(\mathfrak m_2, C_2)$, where $C_2$ is the change of modulus of $C_1$ to
$\mathfrak m_2$. -/
theorem changeModulus_isEquivalent {m1 m2 : Modulus K}
    (C1 : CongruenceSubgroup m1) (hdiv : m2 ∣ m1)
    (hcond : coprimeFractionalIdeals m1 ⊓ rayGroupAmbient m2 ≤
      C1.toAmbientSubgroup) :
    CongruenceSubgroupPair.IsEquivalent
      { modulus := m1, subgroup := C1 }
      { modulus := m2, subgroup := changeModulus C1 m2 } := by
  have hC1 : C1.toAmbientSubgroup ≤ coprimeFractionalIdeals m1 :=
    C1.toAmbientSubgroup_le
  have hC1' : C1.toAmbientSubgroup ≤ coprimeFractionalIdeals m2 :=
    le_trans hC1 (coprimeFractionalIdeals_le_of_dvd hdiv)
  have hcond' : rayGroupAmbient m2 ⊓ coprimeFractionalIdeals m1 ≤
      C1.toAmbientSubgroup := by
    rw [inf_comm]
    exact hcond
  change coprimeFractionalIdeals m1 ⊓
      (changeModulus C1 m2).toAmbientSubgroup =
    coprimeFractionalIdeals m2 ⊓ C1.toAmbientSubgroup
  rw [changeModulus_toAmbientSubgroup_of_dvd C1 hdiv,
    inf_comm (coprimeFractionalIdeals m1) _,
    sup_inf_assoc_of_le _ hC1, sup_eq_left.mpr hcond',
    inf_eq_right.mpr hC1']

/-- **Criterion for an equivalent congruence subgroup at a divisor of the modulus.** Let
$\mathfrak m_1$ and $\mathfrak m_2$ be moduli of a number field $K$ with
$\mathfrak m_2 \mid \mathfrak m_1$, and let $C_1$ be a congruence subgroup for $\mathfrak m_1$.
Write $I^{\mathfrak m_1}$ for the group of nonzero fractional ideals of $K$ coprime to the finite
part of $\mathfrak m_1$ and $P_{\mathfrak m_2}$ for the ray group of $\mathfrak m_2$, and view all
of these as subgroups of the group of nonzero fractional ideals of $K$. Then there is a
congruence subgroup $C_2$ for $\mathfrak m_2$ such that the pair $(\mathfrak m_1, C_1)$ is
equivalent to the pair $(\mathfrak m_2, C_2)$ if and only if
$I^{\mathfrak m_1} \cap P_{\mathfrak m_2} \subseteq C_1$.

Source: ATLAS NumberTheoryI item N422, Lemma 22.5. -/
theorem exists_equivalent_iff_changeModulus {m1 : Modulus K}
    (C1 : CongruenceSubgroup m1) {m2 : Modulus K} (hdiv : m2 ∣ m1) :
    (∃ C2 : CongruenceSubgroup m2,
      CongruenceSubgroupPair.IsEquivalent
        { modulus := m1, subgroup := C1 }
        { modulus := m2, subgroup := C2 }) ↔
      coprimeFractionalIdeals m1 ⊓ rayGroupAmbient m2 ≤
        C1.toAmbientSubgroup := by
  constructor
  · rintro ⟨C2, hC2⟩
    have hC1' : C1.toAmbientSubgroup ≤ coprimeFractionalIdeals m2 :=
      le_trans C1.toAmbientSubgroup_le
        (coprimeFractionalIdeals_le_of_dvd hdiv)
    have heq :=
      (CongruenceSubgroupPair.isEquivalent_iff _ _).mp hC2
    calc coprimeFractionalIdeals m1 ⊓ rayGroupAmbient m2
        ≤ coprimeFractionalIdeals m1 ⊓ C2.toAmbientSubgroup :=
          inf_le_inf_left _
            C2.rayGroupAmbient_le_toAmbientSubgroup
      _ = C1.toAmbientSubgroup := by
          rw [heq, inf_eq_right.mpr hC1']
  · intro hcond
    exact ⟨changeModulus C1 m2,
      changeModulus_isEquivalent C1 hdiv hcond⟩

end NumberField.Modulus
