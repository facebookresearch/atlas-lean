module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal
public import Mathlib.NumberTheory.RamificationInertia.Galois
public import Mathlib.RingTheory.DedekindDomain.Factorization
public import Mathlib.RingTheory.Ideal.Quotient.Basic

@[expose] public section

open scoped NumberField

namespace IsCyclotomicExtension.Rat

/-!
# Inertness in prime-conductor cyclotomic fields

This file ports the book statement from `v1/Atlas/AlgebraNotes/targets.yaml`
("If `p ≠ ℓ`, then `R / (p)` is a field if and only if
`ord_{𝔽_ℓˣ} p = ℓ - 1`", where `R = ℤ[ζ_ℓ]`), for which the v1 archive
contains no formalization.

## Main result

* `isField_quotient_span_natCast_iff_orderOf_eq`: for `ℓ` and `p` prime with
  `p ≠ ℓ` and `K = ℚ(ζ_ℓ)`, the quotient `𝓞 K / (p)` is a field if and only
  if the multiplicative order of `p` modulo `ℓ` is `ℓ - 1`, i.e. if and only
  if `p` is inert in `ℚ(ζ_ℓ)`.

The proof is the fundamental identity `g * e * f = ℓ - 1` for the Galois
extension `ℚ(ζ_ℓ) / ℚ`, where `g` is the number of primes above `p`,
`e = 1` (as `p ≠ ℓ`, the extension is unramified at `p`) and
`f = ord_{𝔽_ℓˣ} p` is the inertia degree, together with the factorization
`(p) = ∏ P` of the lift of `p` into the primes above it.
-/

/-- A rational prime `p ≠ ℓ` is inert in `ℚ(ζ_ℓ)` if and only if its
multiplicative order modulo `ℓ` is `ℓ - 1`. -/
theorem isField_quotient_span_natCast_iff_orderOf_eq
    {ℓ p : ℕ} [Fact ℓ.Prime] [Fact p.Prime] (hne : p ≠ ℓ)
    (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {ℓ} ℚ K] :
    IsField (𝓞 K ⧸ Ideal.span {(p : 𝓞 K)}) ↔ orderOf (p : ZMod ℓ) = ℓ - 1 := by
  classical
  have hℓ : Nat.Prime ℓ := Fact.out
  have hp : Nat.Prime p := Fact.out
  have hNeZero : NeZero ℓ := ⟨hℓ.ne_zero⟩
  -- The prime ideal of `ℤ` generated by `p`, and its lift to `𝓞 K`.
  set pZ : Ideal ℤ := Ideal.span {(p : ℤ)} with hpZdef
  have hpZmax : pZ.IsMaximal := Int.ideal_span_isMaximal_of_prime p
  have hpZne : pZ ≠ ⊥ := by
    rw [hpZdef, ne_eq, Ideal.span_singleton_eq_bot]
    exact_mod_cast hp.ne_zero
  have hpdvd : ¬ p ∣ ℓ := fun h => hne ((Nat.prime_dvd_prime_iff_eq hp hℓ).mp h)
  have hGal : IsGalois ℚ K := IsCyclotomicExtension.isGalois {ℓ} ℚ K
  have hGalGroup : IsGaloisGroup Gal(K / ℚ) ℤ (𝓞 K) :=
    IsGaloisGroup.of_isFractionRing Gal(K / ℚ) ℤ (𝓞 K) ℚ K
  -- The ramification index at `p` is `1`, since `p ≠ ℓ`.
  have he : pZ.ramificationIdxIn (𝓞 K) = 1 :=
    IsCyclotomicExtension.Rat.ramificationIdxIn_eq_of_not_dvd p K hpdvd
  -- The inertia degree at `p` is the order of `p` modulo `ℓ`.
  have hf : pZ.inertiaDegIn (𝓞 K) = orderOf (p : ZMod ℓ) :=
    IsCyclotomicExtension.Rat.inertiaDegIn_eq_of_not_dvd p K hpdvd
  -- The fundamental identity `g * (e * f) = [ℚ(ζ_ℓ) : ℚ] = ℓ - 1`.
  have hfund : (pZ.primesOver (𝓞 K)).ncard *
      (pZ.ramificationIdxIn (𝓞 K) * pZ.inertiaDegIn (𝓞 K)) = ℓ - 1 := by
    have h := Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn pZ (𝓞 K)
      Gal(K / ℚ)
    rwa [IsGalois.card_aut_eq_finrank, IsCyclotomicExtension.Rat.finrank ℓ K,
      Nat.totient_prime hℓ] at h
  -- The finite set of primes of `𝓞 K` above `p`.
  set S : Finset (Ideal (𝓞 K)) := IsDedekindDomain.primesOverFinset pZ (𝓞 K) with hSdef
  have hScoe : (S : Set (Ideal (𝓞 K))) = pZ.primesOver (𝓞 K) := by
    rw [hSdef]
    exact IsDedekindDomain.coe_primesOverFinset (B := 𝓞 K) hpZne
  have hncard : (pZ.primesOver (𝓞 K)).ncard = S.card := by
    rw [← hScoe, Set.ncard_coe_finset]
  -- Every prime above `p` is unramified.
  have hram : ∀ P ∈ S, P.ramificationIdx ℤ = 1 := by
    intro P hP
    have hP' : P ∈ pZ.primesOver (𝓞 K) := by
      rw [← hScoe]
      exact Finset.mem_coe.mpr hP
    have hPprime := hP'.1
    have hPlie := hP'.2
    rw [← Ideal.ramificationIdxIn_eq_ramificationIdx pZ P Gal(K / ℚ)]
    exact he
  -- The lift of `(p)` to `𝓞 K` is the product of the primes above it.
  have hFinset : (pZ.primesOver (𝓞 K)).toFinset = S := by
    ext P
    rw [Set.mem_toFinset, ← hScoe]
    exact Finset.mem_coe
  have hmap : Ideal.map (algebraMap ℤ (𝓞 K)) pZ = ∏ P ∈ S, P := by
    rw [Ideal.map_algebraMap_eq_finsetProd_pow (p := pZ) (S := ℤ) (R := 𝓞 K)
      (by simpa using hpZne), hFinset]
    exact Finset.prod_congr rfl fun P hP => by rw [hram P hP, pow_one]
  -- The lift of `(p)` is the principal ideal `(p)` in `𝓞 K`.
  have hI : Ideal.span {(p : 𝓞 K)} = Ideal.map (algebraMap ℤ (𝓞 K)) pZ := by
    rw [hpZdef, Ideal.map_span]
    simp
  have hSprod : Ideal.span {(p : 𝓞 K)} = ∏ P ∈ S, P := by rw [hI, hmap]
  have hIne : Ideal.span {(p : 𝓞 K)} ≠ ⊥ := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact_mod_cast hp.ne_zero
  -- A prime above `p` is maximal, as it lies over the maximal ideal `pZ`.
  have hPmax : ∀ P ∈ S, P.IsMaximal := by
    intro P hP
    have hP' : P ∈ pZ.primesOver (𝓞 K) := by
      rw [← hScoe]
      exact Finset.mem_coe.mpr hP
    have hPprime := hP'.1
    have hPlie := hP'.2
    exact Ideal.IsMaximal.of_liesOver_isMaximal P pZ
  constructor
  · intro hfield
    have hmax : (Ideal.span {(p : 𝓞 K)}).IsMaximal :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mpr hfield
    have hprime : (Ideal.span {(p : 𝓞 K)}).IsPrime := hmax.isPrime
    -- A prime ideal dividing the product `∏ P` contains one of the factors.
    obtain ⟨P₀, hP₀S, hP₀le⟩ :=
      (Ideal.IsPrime.prod_le hprime).mp (by rw [← hSprod])
    -- The factor `P₀` also divides `(p)`, so `(p) = P₀`.
    have hIP₀ : Ideal.span {(p : 𝓞 K)} = P₀ := by
      apply le_antisymm _ hP₀le
      have hdvd : P₀ ∣ Ideal.span {(p : 𝓞 K)} := by
        rw [hSprod]
        exact Finset.dvd_prod_of_mem (fun P => P) hP₀S
      exact Ideal.dvd_iff_le.mp hdvd
    -- Every prime above `p` equals `P₀`, so there is exactly one of them.
    have hSeq : S = {P₀} := by
      ext Q
      constructor
      · intro hQ
        have hQP₀ : P₀ ≤ Q := by
          rw [← hIP₀]
          have hdvd : Q ∣ Ideal.span {(p : 𝓞 K)} := by
            rw [hSprod]
            exact Finset.dvd_prod_of_mem (fun P => P) hQ
          exact Ideal.dvd_iff_le.mp hdvd
        have hQprime : Q.IsPrime := by
          have hQ' : Q ∈ pZ.primesOver (𝓞 K) := by
            rw [← hScoe]
            exact Finset.mem_coe.mpr hQ
          exact hQ'.1
        exact Finset.mem_singleton.mpr
          ((hPmax P₀ hP₀S).eq_of_le hQprime.ne_top hQP₀).symm
      · intro hQ
        rw [Finset.mem_singleton] at hQ
        rwa [hQ]
    -- The fundamental identity then gives `f = ℓ - 1`.
    have hcard : S.card = 1 := by rw [hSeq, Finset.card_singleton]
    rw [hncard, hcard, he, hf] at hfund
    simpa using hfund
  · intro hord
    rw [← hf] at hord
    -- The fundamental identity gives `g = 1`, as `ℓ - 1 > 0`.
    have hℓpos : 0 < ℓ - 1 := Nat.sub_pos_of_lt hℓ.one_lt
    have hg : S.card = 1 := by
      rw [← hncard] at *
      rw [he, hord] at hfund
      have hmul : (pZ.primesOver (𝓞 K)).ncard * (ℓ - 1) = 1 * (ℓ - 1) := by
        simpa using hfund
      exact Nat.eq_of_mul_eq_mul_right hℓpos hmul
    obtain ⟨P₀, hS⟩ := Finset.card_eq_one.mp hg
    -- Hence `(p) = P₀` is prime, so it is maximal.
    have hP₀S : P₀ ∈ S := by rw [hS]; exact Finset.mem_singleton_self P₀
    have hIeq : Ideal.span {(p : 𝓞 K)} = P₀ := by
      rw [hSprod, hS, Finset.prod_singleton]
    have hP₀prime : P₀.IsPrime := by
      have hP₀' : P₀ ∈ pZ.primesOver (𝓞 K) := by
        rw [← hScoe]
        exact Finset.mem_coe.mpr hP₀S
      exact hP₀'.1
    have hmax : (Ideal.span {(p : 𝓞 K)}).IsMaximal := by
      rw [hIeq]
      have hP₀' : P₀ ∈ pZ.primesOver (𝓞 K) := by
        rw [← hScoe]
        exact Finset.mem_coe.mpr hP₀S
      have hP₀prime' := hP₀prime
      have hP₀lie := hP₀'.2
      exact Ideal.IsMaximal.of_liesOver_isMaximal P₀ pZ
    exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp hmax

end IsCyclotomicExtension.Rat
