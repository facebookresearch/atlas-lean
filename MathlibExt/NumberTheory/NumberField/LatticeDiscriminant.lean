module

public import Mathlib.RingTheory.Discriminant
public import Mathlib.RingTheory.FractionalIdeal.Operations

/-!
# Discriminants of lattices

This file defines the discriminant submodule generated by tuples contained in a lattice.

The rigidity statement `latticeDiscriminant_eq_imp_eq` formalizes Lemma 12.10 of
Andrew V. Sutherland's MIT 18.785 Number Theory I (Fall 2021) lecture notes (Lecture 12):
https://ocw.mit.edu/courses/18-785-number-theory-i-fall-2021/
-/

@[expose] public section

open scoped Matrix

universe u

variable (A K : Type*) {L : Type u} [CommRing A] [Field K] [Field L]
  [Algebra A K] [Algebra K L] [Algebra A L]

/-- **Discriminants of tuples from a submodule.** Let $A$ be a commutative ring and $L/K$ a finite
extension of fields, with $A$-algebra structures on $K$ and $L$ forming a scalar tower
$A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, this is the set of all
discriminants $\operatorname{disc}_{L/K}(b_1, \dots, b_n) = \det(\operatorname{Tr}_{L/K}(b_i b_j))$
in $K$ of $n$-tuples $(b_1, \dots, b_n)$ of elements of $M$. -/
def latticeDiscriminantSet [FiniteDimensional K L] [_hAKL : IsScalarTower A K L]
    (M : Submodule A L) : Set K :=
  {d | ∃ b : Fin (Module.finrank K L) → L, (∀ i, b i ∈ M) ∧ d = Algebra.discr K b}

variable [FiniteDimensional K L]

/-- **Discriminant of a lattice.** Let $A$ be a commutative ring and $L/K$ a finite extension of
fields, with $A$-algebra structures on $K$ and $L$ forming a scalar tower $A \to K \to L$, and let
$n = [L : K]$. The discriminant $D(M)$ of an $A$-submodule $M$ of $L$ is the $A$-submodule of $K$
generated by the discriminants
$\operatorname{disc}_{L/K}(b_1, \dots, b_n) = \det(\operatorname{Tr}_{L/K}(b_i b_j))$ of all
$n$-tuples $(b_1, \dots, b_n)$ of elements of $M$. -/
def latticeDiscriminant [_hAKL : IsScalarTower A K L]
    (M : Submodule A L) : Submodule A K :=
  Submodule.span A (latticeDiscriminantSet A K M)

theorem discr_mem_latticeDiscriminant [_hAKL : IsScalarTower A K L]
    {M : Submodule A L}
    {b : Fin (Module.finrank K L) → L} (hb : ∀ i, b i ∈ M) :
    Algebra.discr K b ∈ latticeDiscriminant A K M :=
  Submodule.subset_span ⟨b, hb, rfl⟩

theorem latticeDiscriminant_mono [_hAKL : IsScalarTower A K L]
    {M N : Submodule A L} (h : M ≤ N) :
    latticeDiscriminant A K M ≤ latticeDiscriminant A K N := by
  apply Submodule.span_mono
  rintro d ⟨b, hb, rfl⟩
  exact ⟨b, fun i ↦ h (hb i), rfl⟩

/-- **The discriminant of a lattice inside a basis lattice.** Let $A$ be a commutative ring and
$L/K$ a finite extension of fields, with $A$-algebra structures on $K$ and $L$ forming a scalar
tower $A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let $D(M)$ be its
discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all $n$-tuples of
elements of $M$. If $b_1, \dots, b_n$ is a $K$-basis of $L$ and $M$ is contained in the $A$-span of
$b_1, \dots, b_n$, then $D(M) \subseteq A \cdot \operatorname{disc}_{L/K}(b_1, \dots, b_n)$. -/
theorem latticeDiscriminant_le_span_singleton [_hAKL : IsScalarTower A K L]
    (bK : Module.Basis (Fin (Module.finrank K L)) K L)
    (M : Submodule A L)
    (hM : M ≤ Submodule.span A (Set.range (bK : Fin _ → L))) :
    latticeDiscriminant A K M ≤
      Submodule.span A {Algebra.discr K (bK : Fin _ → L)} := by
  apply Submodule.span_le.mpr
  rintro d ⟨x, hx, rfl⟩
  classical
  have hentries : ∀ i j, bK.toMatrix x i j ∈ (algebraMap A K).range := by
    intro i j
    simp only [Module.Basis.toMatrix_apply]
    have hxj := hM (hx j)
    rw [Submodule.mem_span_range_iff_exists_fun] at hxj
    obtain ⟨c, hc⟩ := hxj
    rw [show x j = ∑ k, algebraMap A K (c k) • bK k from by
      rw [← hc]
      congr 1
      ext k
      rw [Algebra.smul_def, Algebra.smul_def,
        IsScalarTower.algebraMap_apply A K L],
      Module.Basis.repr_sum_self]
    exact ⟨c i, rfl⟩
  let PA : Matrix _ _ A := Matrix.of (fun i j => (hentries i j).choose)
  have hPA : bK.toMatrix x = PA.map (algebraMap A K) := by
    ext i j
    simp only [Matrix.map_apply]
    exact (hentries i j).choose_spec.symm
  have hcob : Algebra.discr K x =
      (bK.toMatrix x).det ^ 2 * Algebra.discr K (bK : Fin _ → L) := by
    conv_lhs => rw [show x = (⇑bK) ᵥ* ((bK.toMatrix x).map (algebraMap K L))
      from (bK.toMatrix_map_vecMul x).symm]
    exact Algebra.discr_of_matrix_vecMul (⇑bK) (bK.toMatrix x)
  rw [hcob, hPA, show (PA.map (algebraMap A K)).det = algebraMap A K PA.det from
      (RingHom.map_det (algebraMap A K) PA).symm,
    show (algebraMap A K PA.det) ^ 2 = algebraMap A K (PA.det ^ 2) from
      (map_pow _ _ _).symm,
    ← Algebra.smul_def]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))

/-- **The discriminant of a lattice inside a basis lattice is fractional.** Let $A$ be a commutative
ring and $L/K$ a finite extension of fields, with $A$-algebra structures on $K$ and $L$ forming a
scalar tower $A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let $D(M)$ be
its discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all $n$-tuples
of elements of $M$. Assume $K$ is the fraction field of $A$. If $M$ is contained in the $A$-span of
a $K$-basis $b_1, \dots, b_n$ of $L$, then $D(M)$ is a fractional ideal: there is a non-zero-divisor
$a \in A$ such that $a x$ lies in the image of $A$ in $K$ for every $x \in D(M)$. -/
theorem latticeDiscriminant_isFractional [IsFractionRing A K]
    [_hAKL : IsScalarTower A K L]
    (M : Submodule A L)
    (bN : Module.Basis (Fin (Module.finrank K L)) K L)
    (hMN : M ≤ Submodule.span A (Set.range (bN : Fin _ → L))) :
    IsFractional (nonZeroDivisors A) (latticeDiscriminant A K M) := by
  have hle : latticeDiscriminant A K M ≤
      ((FractionalIdeal.spanSingleton (nonZeroDivisors A)
        (Algebra.discr K (bN : Fin _ → L))) : Submodule A K) := by
    rw [FractionalIdeal.coe_spanSingleton]
    exact latticeDiscriminant_le_span_singleton (A := A) (K := K) bN M hMN
  exact FractionalIdeal.isFractional_of_le hle

/-- **The discriminant of a lattice containing a basis is nonzero.** Let $A$ be a commutative ring
and $L/K$ a finite extension of fields, with $A$-algebra structures on $K$ and $L$ forming a scalar
tower $A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let $D(M)$ be its
discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all $n$-tuples of
elements of $M$. Assume $L/K$ is separable. If $M$ contains a $K$-basis $b_1, \dots, b_n$ of $L$,
then $D(M) \neq 0$. -/
theorem latticeDiscriminant_ne_bot_of_basis [_hAKL : IsScalarTower A K L]
    [Algebra.IsSeparable K L]
    (M : Submodule A L)
    (bK : Module.Basis (Fin (Module.finrank K L)) K L)
    (hKM : Set.range (bK : Fin _ → L) ⊆ M) :
    latticeDiscriminant A K M ≠ ⊥ := by
  have hmem : Algebra.discr K (bK : Fin _ → L) ∈
      latticeDiscriminant A K M :=
    discr_mem_latticeDiscriminant (A := A) (K := K)
      (fun i => hKM (Set.mem_range_self i))
  intro hbot
  rw [hbot] at hmem
  simp only [Submodule.mem_bot] at hmem
  exact Algebra.discr_not_zero_of_basis K bK hmem

/-- **The discriminant of a sandwiched lattice is a nonzero fractional ideal.** Let $A$ be a
commutative ring and $L/K$ a finite extension of fields, with $A$-algebra structures on $K$ and $L$
forming a scalar tower $A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let
$D(M)$ be its discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all
$n$-tuples of elements of $M$. Assume $K$ is the fraction field of $A$ and $L/K$ is separable. If
$M$ contains a $K$-basis $b_1, \dots, b_n$ of $L$ and is contained in the $A$-span of a $K$-basis
$c_1, \dots, c_n$ of $L$, then $D(M)$ is a fractional ideal (there is a non-zero-divisor $a \in A$
such that $a x$ lies in the image of $A$ in $K$ for every $x \in D(M)$) and $D(M) \neq 0$. -/
theorem latticeDiscriminant_isFractional_and_ne_bot [IsFractionRing A K]
    [_hAKL : IsScalarTower A K L] [Algebra.IsSeparable K L]
    (M : Submodule A L)
    (bK : Module.Basis (Fin (Module.finrank K L)) K L)
    (hKM : Set.range (bK : Fin _ → L) ⊆ M)
    (bN : Module.Basis (Fin (Module.finrank K L)) K L)
    (hMN : M ≤ Submodule.span A (Set.range (bN : Fin _ → L))) :
    IsFractional (nonZeroDivisors A) (latticeDiscriminant A K M) ∧
      latticeDiscriminant A K M ≠ ⊥ :=
  ⟨latticeDiscriminant_isFractional A K M bN hMN,
    latticeDiscriminant_ne_bot_of_basis A K M bK hKM⟩

/-- **The discriminant of a lattice spanned by a basis.** Let $A$ be a commutative ring and $L/K$ a
finite extension of fields, with $A$-algebra structures on $K$ and $L$ forming a scalar tower
$A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let $D(M)$ be its
discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all $n$-tuples of
elements of $M$. If $b_1, \dots, b_n$ is a $K$-basis of $L$, every $b_i$ lies in $M$ and $M$ is
contained in the $A$-span of $b_1, \dots, b_n$, then
$D(M) = A \cdot \operatorname{disc}_{L/K}(b_1, \dots, b_n)$. -/
theorem latticeDiscriminant_eq_span_singleton [_hAKL : IsScalarTower A K L]
    (bK : Module.Basis (Fin (Module.finrank K L)) K L)
    (M : Submodule A L)
    (hM_le : M ≤ Submodule.span A (Set.range (bK : Fin _ → L)))
    (hM_ge : Set.range (bK : Fin _ → L) ⊆ M) :
    latticeDiscriminant A K M =
      Submodule.span A {Algebra.discr K (bK : Fin _ → L)} := by
  apply le_antisymm
  · exact latticeDiscriminant_le_span_singleton (A := A) (K := K) bK M hM_le
  · apply Submodule.span_le.mpr
    intro d hd
    rw [Set.mem_singleton_iff.mp hd]
    exact discr_mem_latticeDiscriminant (A := A) (K := K)
      fun i => hM_ge (Set.mem_range_self i)

/-- **Equal discriminants force equal lattices.** Let $A$ be a commutative ring and $L/K$ a finite
extension of fields, with $A$-algebra structures on $K$ and $L$ forming a scalar tower
$A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let $D(M)$ be its
discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all $n$-tuples of
elements of $M$. Assume $L/K$ is separable and the map $A \to K$ is injective. Let $M' \subseteq M$
be $A$-submodules of $L$. Suppose that $b_1, \dots, b_n$ is a $K$-basis of $L$ with every $b_i$ in
$M$ and $M$ contained in the $A$-span of $b_1, \dots, b_n$, and that $b'_1, \dots, b'_n$ is a
$K$-basis of $L$ with every $b'_i$ in $M'$ and $M'$ contained in the $A$-span of
$b'_1, \dots, b'_n$. If $D(M') = D(M)$, then $M' = M$.

Source: Sutherland, MIT 18.785 Number Theory I (Fall 2021), Lecture 12, Lemma 12.10. -/
theorem latticeDiscriminant_eq_imp_eq [_hAKL : IsScalarTower A K L]
    [Algebra.IsSeparable K L]
    (hAK : Function.Injective (algebraMap A K))
    (M M' : Submodule A L) (hle : M' ≤ M)
    (bK : Module.Basis (Fin (Module.finrank K L)) K L)
    (hM_le : M ≤ Submodule.span A (Set.range (bK : Fin _ → L)))
    (hM_ge : Set.range (bK : Fin _ → L) ⊆ M)
    (bK' : Module.Basis (Fin (Module.finrank K L)) K L)
    (hM'_le : M' ≤ Submodule.span A (Set.range (bK' : Fin _ → L)))
    (hM'_ge : Set.range (bK' : Fin _ → L) ⊆ M')
    (hD : latticeDiscriminant A K M' = latticeDiscriminant A K M) :
    M' = M := by
  classical
  have hbK'_in_span : ∀ i, bK' i ∈ Submodule.span A (Set.range (bK : Fin _ → L)) :=
    fun i => hM_le (hle (hM'_ge (Set.mem_range_self i)))
  have hentries : ∀ i j, bK.toMatrix (bK' : Fin _ → L) i j ∈
      (algebraMap A K).range := by
    intro i j
    simp only [Module.Basis.toMatrix_apply]
    have hxj := hbK'_in_span j
    rw [Submodule.mem_span_range_iff_exists_fun] at hxj
    obtain ⟨c, hc⟩ := hxj
    rw [show bK' j = ∑ k, algebraMap A K (c k) • bK k from by
      rw [← hc]
      congr 1
      ext k
      rw [Algebra.smul_def, Algebra.smul_def,
        IsScalarTower.algebraMap_apply A K L],
      Module.Basis.repr_sum_self]
    exact ⟨c i, rfl⟩
  set PA : Matrix _ _ A := Matrix.of (fun i j => (hentries i j).choose)
  have hPA : bK.toMatrix (bK' : Fin _ → L) = PA.map (algebraMap A K) := by
    ext i j
    simp only [Matrix.map_apply]
    exact (hentries i j).choose_spec.symm
  have hdiscr : Algebra.discr K (bK' : Fin _ → L) =
      (algebraMap A K PA.det) ^ 2 * Algebra.discr K (bK : Fin _ → L) := by
    conv_lhs => rw [show (bK' : Fin _ → L) = (bK : Fin _ → L) ᵥ*
        ((bK.toMatrix (bK' : Fin _ → L)).map (algebraMap K L))
      from (bK.toMatrix_map_vecMul (bK' : Fin _ → L)).symm]
    rw [hPA]
    rw [Algebra.discr_of_matrix_vecMul (bK : Fin _ → L) (PA.map (algebraMap A K))]
    congr 1
    congr 1
    exact (RingHom.map_det (algebraMap A K) PA).symm
  have hD_eq : latticeDiscriminant A K M =
      Submodule.span A {Algebra.discr K (bK : Fin _ → L)} :=
    latticeDiscriminant_eq_span_singleton (A := A) (K := K) bK M hM_le hM_ge
  have hD'_eq : latticeDiscriminant A K M' =
      Submodule.span A {Algebra.discr K (bK' : Fin _ → L)} :=
    latticeDiscriminant_eq_span_singleton (A := A) (K := K) bK' M' hM'_le hM'_ge
  have hbK_in : Algebra.discr K (bK : Fin _ → L) ∈
      Submodule.span A {Algebra.discr K (bK' : Fin _ → L)} := by
    rw [← hD'_eq, hD, hD_eq]
    exact Submodule.subset_span (Set.mem_singleton _)
  rw [Submodule.mem_span_singleton] at hbK_in
  obtain ⟨c, hc⟩ := hbK_in
  have hdiscr_ne : Algebra.discr K (bK : Fin _ → L) ≠ 0 :=
    Algebra.discr_not_zero_of_basis K bK
  have hunit_K : algebraMap A K c * (algebraMap A K PA.det) ^ 2 = 1 := by
    have h1 : Algebra.discr K (bK : Fin _ → L) = algebraMap A K c *
        ((algebraMap A K PA.det) ^ 2 * Algebra.discr K (bK : Fin _ → L)) := by
      rw [← hdiscr, ← hc, Algebra.smul_def]
    have h2 : algebraMap A K c * (algebraMap A K PA.det) ^ 2 *
        Algebra.discr K (bK : Fin _ → L) =
        1 * Algebra.discr K (bK : Fin _ → L) := by
      rw [mul_assoc, ← h1, one_mul]
    exact mul_right_cancel₀ hdiscr_ne h2
  have hunit_A : c * PA.det ^ 2 = 1 := by
    apply hAK
    rw [map_mul, map_pow, map_one]
    exact hunit_K
  have hdetPA_unit : IsUnit PA.det := by
    rw [isUnit_iff_exists_inv]
    refine ⟨c * PA.det, ?_⟩
    have : PA.det * (c * PA.det) = c * PA.det ^ 2 := by ring
    rw [this, hunit_A]
  have hbK_recover : ∀ i, bK i ∈ Submodule.span A (Set.range (bK' : Fin _ → L)) := by
    have hbK'_eq : (bK' : Fin _ → L) =
        (bK : Fin _ → L) ᵥ* (PA.map (algebraMap A L)) := by
      ext i
      have := bK.toMatrix_map_vecMul (bK' : Fin _ → L)
      rw [hPA] at this
      rw [show (PA.map (algebraMap A K)).map (algebraMap K L) =
          PA.map (algebraMap A L) from by
        ext i j
        simp only [Matrix.map_apply, ← IsScalarTower.algebraMap_apply A K L]] at this
      exact congr_fun this.symm i
    have hbK_eq : (bK : Fin _ → L) =
        (bK' : Fin _ → L) ᵥ* (PA⁻¹.map (algebraMap A L)) := by
      rw [hbK'_eq, Matrix.vecMul_vecMul]
      have : PA.map (algebraMap A L) * PA⁻¹.map (algebraMap A L) = 1 := by
        rw [show PA.map (algebraMap A L) = (algebraMap A L).mapMatrix PA from rfl,
          show PA⁻¹.map (algebraMap A L) = (algebraMap A L).mapMatrix PA⁻¹ from rfl,
          ← map_mul, Matrix.mul_nonsing_inv PA hdetPA_unit, map_one]
      rw [this, Matrix.vecMul_one]
    intro i
    rw [hbK_eq]
    change (bK' ⬝ᵥ fun j => (algebraMap A L) (PA⁻¹ j i)) ∈ _
    rw [dotProduct]
    apply Submodule.sum_mem
    intro j _
    rw [mul_comm (bK' j) _, ← Algebra.smul_def]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  have hM_le_M' : M ≤ M' := by
    intro x hx
    have hx_span := hM_le hx
    rw [Submodule.mem_span_range_iff_exists_fun] at hx_span
    obtain ⟨c_x, hcx⟩ := hx_span
    rw [← hcx]
    apply Submodule.sum_mem
    intro j _
    apply Submodule.smul_mem
    have := hbK_recover j
    rw [Submodule.mem_span_range_iff_exists_fun] at this
    obtain ⟨c_bK, hcbK⟩ := this
    rw [← hcbK]
    apply Submodule.sum_mem
    intro k _
    exact Submodule.smul_mem _ _ (hM'_ge (Set.mem_range_self k))
  exact le_antisymm hle hM_le_M'

/-- **Equal discriminants force equal lattices (fraction field version).** Let $A$ be a commutative
ring and $L/K$ a finite extension of fields, with $A$-algebra structures on $K$ and $L$ forming a
scalar tower $A \to K \to L$, and let $n = [L : K]$. For an $A$-submodule $M$ of $L$, let $D(M)$ be
its discriminant, the $A$-submodule of $K$ generated by the discriminants over $K$ of all $n$-tuples
of elements of $M$. Assume $K$ is the fraction field of $A$ and $L/K$ is separable. Let
$M' \subseteq M$ be $A$-submodules of $L$. Suppose that $b_1, \dots, b_n$ is a $K$-basis of $L$ with
every $b_i$ in $M$ and $M$ contained in the $A$-span of $b_1, \dots, b_n$, and that
$b'_1, \dots, b'_n$ is a $K$-basis of $L$ with every $b'_i$ in $M'$ and $M'$ contained in the
$A$-span of $b'_1, \dots, b'_n$. If $D(M') = D(M)$, then $M' = M$. -/
theorem latticeDiscriminant_eq_imp_eq_of_isFractionRing [IsFractionRing A K]
    [_hAKL : IsScalarTower A K L] [Algebra.IsSeparable K L]
    (M M' : Submodule A L) (hle : M' ≤ M)
    (bK : Module.Basis (Fin (Module.finrank K L)) K L)
    (hM_le : M ≤ Submodule.span A (Set.range (bK : Fin _ → L)))
    (hM_ge : Set.range (bK : Fin _ → L) ⊆ M)
    (bK' : Module.Basis (Fin (Module.finrank K L)) K L)
    (hM'_le : M' ≤ Submodule.span A (Set.range (bK' : Fin _ → L)))
    (hM'_ge : Set.range (bK' : Fin _ → L) ⊆ M')
    (hD : latticeDiscriminant A K M' = latticeDiscriminant A K M) :
    M' = M :=
  latticeDiscriminant_eq_imp_eq (A := A) (K := K)
    (IsFractionRing.injective A K) M M' hle bK hM_le hM_ge bK' hM'_le hM'_ge hD
