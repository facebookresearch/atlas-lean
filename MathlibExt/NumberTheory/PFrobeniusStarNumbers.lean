module

public import Mathlib.Algebra.Group.Nat.Even
import Mathlib.Tactic.Ring

/-!
# Three consecutive star numbers are relatively prime

Lemma 2 of Takao Komatsu, Tapas Chatterjee, and Palak Narula,
"On p-Frobenius Numbers for the Numerical Semigroups Generated by
Three Consecutive Star Numbers", *INTEGERS* 25 (2025), Article A106
(<https://math.colgate.edu/~integers/z106/z106.pdf>).

A common divisor of `S_n`, `S_{n+1}`, `S_{n+2}` divides
`S_{n+2} - 2 S_{n+1} + S_n = 12`, and `S_n ≡ 1 (mod 12)`.

The definitions live in `MetaMathlibExt.StarNumber` so that `star`
does not shadow `Star.star` in the `MetaMathlibExt` namespace.
-/

@[expose] public section

namespace MetaMathlibExt.StarNumber

/-- The `n`th star number `6 * n * (n - 1) + 1`. -/
def star (n : ℕ) : ℕ :=
  6 * n * (n - 1) + 1

/-- Komatsu, Chatterjee, and Narula's Lemma 2: any three
consecutive star numbers are relatively prime. The hypothesis
`1 ≤ n` is not needed.

Source: Takao Komatsu, Tapas Chatterjee, and Palak Narula,
"On p-Frobenius Numbers for the Numerical Semigroups Generated by
Three Consecutive Star Numbers", *INTEGERS* 25 (2025), Article A106
(<https://math.colgate.edu/~integers/z106/z106.pdf>), Lemma 2.
Proves `Wanted` entry `gcd_star_succ_succ`. -/
theorem gcd_star_succ_succ
    (n : ℕ) (hn : 1 ≤ n) :
    Nat.gcd (Nat.gcd (star n) (star (n + 1))) (star (n + 2)) = 1 := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  obtain ⟨m, hm⟩ := Nat.even_mul_succ_self k
  set g :=
    Nat.gcd (Nat.gcd (star (k + 1)) (star (k + 1 + 1))) (star (k + 1 + 2))
  have h0 : g ∣ star (k + 1) :=
    (Nat.gcd_dvd_left _ _).trans (Nat.gcd_dvd_left _ _)
  have h1 : g ∣ star (k + 1 + 1) :=
    (Nat.gcd_dvd_left _ _).trans (Nat.gcd_dvd_right _ _)
  have h2 : g ∣ star (k + 1 + 2) := Nat.gcd_dvd_right _ _
  have e1 :
      star (k + 1 + 2) + star (k + 1) = 2 * star (k + 1 + 1) + 12 := by
    change 6 * (k + 3) * (k + 2) + 1 + (6 * (k + 1) * k + 1) =
      2 * (6 * (k + 2) * (k + 1) + 1) + 12
    ring
  have e2 : star (k + 1) = 12 * m + 1 := by
    change 6 * (k + 1) * k + 1 = 12 * m + 1
    rw [Nat.mul_assoc, Nat.mul_comm (k + 1) k, hm]
    ring
  have h12 : g ∣ 12 := by
    have : g ∣ 2 * star (k + 1 + 1) + 12 := e1 ▸ Nat.dvd_add h2 h0
    exact (Nat.dvd_add_right (h1.mul_left 2)).1 this
  rw [e2] at h0
  exact Nat.eq_one_of_dvd_one ((Nat.dvd_add_right (h12.mul_right m)).1 h0)

end MetaMathlibExt.StarNumber
