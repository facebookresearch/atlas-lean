/-!
# Embedding dimensions and conductors of tail semigroups

For a strictly increasing sequence `x` and `k, n ≥ 1`, the term `x k` is a minimal generator of
the tail semigroup `⟨x n, x (n + 1), …⟩` exactly when `r_k ≤ n ≤ k`, where the first appearance
`r_k` is the least `m ≥ 1` such that `x k` is a minimal generator of the `m`-th tail; so the
embedding dimension of the `n`-th tail counts the indices `j ≥ 1` with `r_j ≤ n ≤ j`. A linear
lower bound on first appearances bounds the number of minimal generators of each tail.
For tails of the sequence of `k`-th powers, the Dutch–Rickett recursion bounds the conductor
in terms of the conductor at half the starting index rounded up. The Dutch–Rickett inequality
for a union of generating sets bounds the conductor of `⟨A ∪ B⟩` in terms of the conductors of
`⟨C ∪ B⟩` and `⟨B ∪ {t}⟩`, where `C` divides the elements of `A` by their common divisor `t`.
-/

namespace MetaMathlibExt

namespace embeddingDimension_le_of_firstAppearance_ge

private lemma exists_generator_add {A : Set ℕ} {s : ℕ} (hs : s ∈ AddSubmonoid.closure A)
    (hs₀ : s ≠ 0) : ∃ a ∈ A, ∃ b ∈ AddSubmonoid.closure A, a + b = s := by
  induction hs using AddSubmonoid.closure_induction_left with
  | zero => exact (hs₀ rfl).elim
  | add_left a ha b hb _ => exact ⟨a, ha, b, hb, rfl⟩

end embeddingDimension_le_of_firstAppearance_ge

open embeddingDimension_le_of_firstAppearance_ge

/-- **Minimal generators of the tail semigroups of an increasing sequence.** Let
$x_0 < x_1 < x_2 < \cdots$ be a strictly increasing sequence of natural numbers. For $m \ge 1$
let $S_m$ be the additive submonoid of $\mathbb{N}$ generated by $x_m, x_{m+1}, \ldots$, and let
$\beta(S_m)$ be its set of minimal generators, the nonzero elements of $S_m$ that are not the sum
of two nonzero elements of $S_m$. For $k \ge 1$ let $r_k$ be the least $m \ge 1$ with
$x_k \in \beta(S_m)$. Then for all integers $k, n \ge 1$, $x_k \in \beta(S_n)$ if and only if
$r_k \le n \le k$; and the embedding dimension $e(S_n) = |\beta(S_n)|$ equals the number of
integers $j \ge 1$ with $r_j \le n \le j$.

The paper's standing assumption $\gcd(x_n, x_{n+1}, \ldots) = 1$ is not needed and is dropped.

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Lemma 1 (`integers-2025-A11-lem-1`). -/
public theorem mem_minimalGenerators_iff_firstAppearance_le (x : ℕ → ℕ) (hx : StrictMono x)
    (k n : ℕ) (hk : 1 ≤ k) (hn : 1 ≤ n) :
    (x k ∈ {s | s ∈ AddSubmonoid.closure (x '' Set.Ici n) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici n), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici n),
          a + b = s → a = 0 ∨ b = 0} ↔
      sInf {m : ℕ | 1 ≤ m ∧ x k ∈ {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m),
          a + b = s → a = 0 ∨ b = 0}} ≤ n ∧ n ≤ k) ∧
    {s | s ∈ AddSubmonoid.closure (x '' Set.Ici n) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici n), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici n),
          a + b = s → a = 0 ∨ b = 0}.ncard =
      {j : ℕ | 1 ≤ j ∧ sInf {m : ℕ | 1 ≤ m ∧ x j ∈ {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧
          s ≠ 0 ∧ ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m),
            ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m), a + b = s → a = 0 ∨ b = 0}} ≤ n ∧
        n ≤ j}.ncard := by
  let β (m : ℕ) : Set ℕ := {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧ s ≠ 0 ∧
    ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m),
      a + b = s → a = 0 ∨ b = 0}
  change (x k ∈ β n ↔ sInf {m : ℕ | 1 ≤ m ∧ x k ∈ β m} ≤ n ∧ n ≤ k) ∧
    (β n).ncard = {j : ℕ | 1 ≤ j ∧ sInf {m : ℕ | 1 ≤ m ∧ x j ∈ β m} ≤ n ∧ n ≤ j}.ncard
  have hpos {j : ℕ} (hj : 1 ≤ j) : 0 < x j := (Nat.zero_le (x 0)).trans_lt (hx hj)
  -- Every nonzero element of `S_m` is at least `x_m`.
  have le_of_mem {m s : ℕ} (hs : s ∈ AddSubmonoid.closure (x '' Set.Ici m)) (hs₀ : s ≠ 0) :
      x m ≤ s := by
    obtain ⟨_, ⟨j, hj, rfl⟩, b, -, rfl⟩ := exists_generator_add hs hs₀
    exact (hx.monotone hj).trans (Nat.le_add_right _ _)
  -- So `x_j` is the least nonzero element of `S_j`, hence a minimal generator of `S_j`.
  have mem_self {j : ℕ} (hj : 1 ≤ j) : x j ∈ β j := by
    refine ⟨AddSubmonoid.subset_closure ⟨j, le_refl j, rfl⟩, (hpos hj).ne', ?_⟩
    intro a ha b hb hab
    by_contra! h
    have := le_of_mem ha h.1
    have := le_of_mem hb h.2
    have := hpos hj
    omega
  have key {j : ℕ} (hj : 1 ≤ j) :
      x j ∈ β n ↔ sInf {m : ℕ | 1 ≤ m ∧ x j ∈ β m} ≤ n ∧ n ≤ j := by
    constructor
    · -- `x_j` lies in `S_n`, so `x_n ≤ x_j`.
      intro h
      exact ⟨Nat.sInf_le ⟨hn, h⟩, hx.le_iff_le.mp (le_of_mem h.1 h.2.1)⟩
    · -- `x_j` is minimal in `S_{r_j}`, which contains `S_n`.
      rintro ⟨hr, hnj⟩
      have hne : {m : ℕ | 1 ≤ m ∧ x j ∈ β m}.Nonempty := ⟨j, hj, mem_self hj⟩
      obtain ⟨-, -, -, hmin⟩ := Nat.sInf_mem hne
      have hsub := AddSubmonoid.closure_mono (Set.image_mono (f := x) (Set.Ici_subset_Ici.mpr hr))
      exact ⟨AddSubmonoid.subset_closure ⟨j, hnj, rfl⟩, (hpos hj).ne',
        fun a ha b hb hab => hmin a (hsub ha) b (hsub hb) hab⟩
  refine ⟨key hk, ?_⟩
  -- Every minimal generator of `S_n` is one of its generators `x_j` with `j ≥ n`.
  have hβ : β n = x '' {j : ℕ | 1 ≤ j ∧ sInf {m : ℕ | 1 ≤ m ∧ x j ∈ β m} ≤ n ∧ n ≤ j} := by
    ext s
    constructor
    · intro hs
      obtain ⟨_, ⟨j, hj, rfl⟩, b, hb, hsum⟩ := exists_generator_add hs.1 hs.2.1
      have hj₁ : 1 ≤ j := hn.trans hj
      obtain rfl := (hs.2.2 _ (AddSubmonoid.subset_closure ⟨j, hj, rfl⟩) b hb hsum).resolve_left
        (hpos hj₁).ne'
      rw [add_zero] at hsum
      subst hsum
      exact ⟨j, ⟨hj₁, (key hj₁).mp hs⟩, rfl⟩
    · rintro ⟨j, ⟨hj₁, hj⟩, rfl⟩
      exact (key hj₁).mpr hj
  rw [hβ, Set.ncard_image_of_injective _ hx.injective]

/-- **Embedding dimension bound from linear growth of first appearances.** Let
$x_0 < x_1 < x_2 < \cdots$ be a strictly increasing sequence of natural numbers. For $m \ge 1$
let $S_m$ be the additive submonoid of $\mathbb{N}$ generated by $x_m, x_{m+1}, \ldots$; call a
nonzero element of $S_m$ that is not the sum of two nonzero elements of $S_m$ a minimal generator
of $S_m$, and let the embedding dimension $e(S_m)$ be the number of minimal generators of $S_m$.
For $k \ge 1$ let $r_k$ be the least $m \ge 1$ such that $x_k$ is a minimal generator of $S_m$.
If $\alpha > 0$ is a real number with $r_k \ge \alpha k$ for all $k \ge 1$, then
$e(S_n) \le \lfloor n / \alpha \rfloor - n + 1$ for all $n \ge 1$.

The paper's standing assumption $\gcd(x_n, x_{n+1}, \ldots) = 1$ is not needed and is dropped.

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Proposition 1 (`integers-2025-A11-prop-1`). -/
public theorem embeddingDimension_le_of_firstAppearance_ge (x : ℕ → ℕ) (hx : StrictMono x)
    (α : ℝ) (hα : 0 < α)
    (hr : ∀ k : ℕ, 1 ≤ k → α * k ≤ ((sInf {m : ℕ | 1 ≤ m ∧
      x k ∈ {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m),
          a + b = s → a = 0 ∨ b = 0}} : ℕ) : ℝ))
    (n : ℕ) (hn : 1 ≤ n) :
    ({s | s ∈ AddSubmonoid.closure (x '' Set.Ici n) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici n), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici n),
          a + b = s → a = 0 ∨ b = 0}.ncard : ℤ) ≤ ⌊(n : ℝ) / α⌋ - n + 1 := by
  let β (m : ℕ) : Set ℕ := {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧ s ≠ 0 ∧
    ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m),
      a + b = s → a = 0 ∨ b = 0}
  change ((β n).ncard : ℤ) ≤ _
  have index_le {k : ℕ} (hk : n ≤ k) (hs : x k ∈ β n) : k ≤ ⌊(n : ℝ) / α⌋₊ := by
    have hfirst : sInf {m : ℕ | 1 ≤ m ∧ x k ∈ β m} ≤ n := csInf_le' ⟨hn, hs⟩
    apply Nat.le_floor
    apply (le_div_iff₀ hα).mpr
    rw [mul_comm]
    exact (hr k (hn.trans hk)).trans (Nat.cast_le.mpr hfirst)
  -- The first term of the tail is its smallest positive element, hence a minimal generator.
  have hpos : 0 < x n := (Nat.zero_le (x 0)).trans_lt (hx hn)
  have hmin : x n ∈ β n := by
    refine ⟨AddSubmonoid.subset_closure ⟨n, le_refl n, rfl⟩, hpos.ne', ?_⟩
    intro a ha b _ hab
    by_cases ha₀ : a = 0
    · exact Or.inl ha₀
    obtain ⟨_, ⟨k, hk, rfl⟩, c, _, hc⟩ := exists_generator_add ha ha₀
    have hnk : x n ≤ x k := hx.monotone hk
    exact Or.inr (by omega)
  have hsub : β n ⊆ x '' Set.Icc n ⌊(n : ℝ) / α⌋₊ := by
    intro s hs
    obtain ⟨_, ⟨k, hk, rfl⟩, b, hb, hsum⟩ := exists_generator_add hs.1 hs.2.1
    have hdecomp := hs.2.2 _ (AddSubmonoid.subset_closure ⟨k, hk, rfl⟩) b hb hsum
    have hpos_k := hpos.trans_le (hx.monotone hk)
    obtain rfl := hdecomp.resolve_left hpos_k.ne'
    rw [add_zero] at hsum
    exact ⟨k, ⟨hk, index_le hk (hsum ▸ hs)⟩, hsum⟩
  have hcard := Set.ncard_le_ncard hsub ((Set.finite_Icc ..).image x)
  rw [Set.ncard_image_of_injective _ hx.injective, Set.ncard_Icc_nat] at hcard
  have hn_floor := index_le le_rfl hmin
  rw [← Int.natCast_floor_eq_floor (div_nonneg (Nat.cast_nonneg n) hα.le)]
  omega

namespace conductor_powers_le

private abbrev powerTail (n k : ℕ) :=
  AddSubmonoid.closure ((fun i : ℕ => i ^ k) '' Set.Ici n)

private lemma pow_mem {n i k : ℕ} (hi : n ≤ i) : i ^ k ∈ powerTail n k :=
  AddSubmonoid.subset_closure ⟨i, hi, rfl⟩

-- Two consecutive bases give coprime powers, so the infimum defining the conductor is attained.
private lemma thresholds_nonempty (m k : ℕ) :
    {c : ℕ | ∀ j ≥ c, j ∈ powerTail m k}.Nonempty := by
  have hcop : (m ^ k).Coprime ((m + 1) ^ k) :=
    Nat.Coprime.pow k k (Nat.coprime_self_add_right.mpr (Nat.coprime_one_right m))
  refine ⟨(m ^ k).pred * ((m + 1) ^ k).pred, fun j hj ↦ ?_⟩
  obtain ⟨a, b, rfl⟩ := Nat.exists_add_mul_eq_of_gcd_dvd_of_mul_pred_le (m ^ k) ((m + 1) ^ k) j
    (by simp [hcop.gcd_eq_one]) hj
  exact add_mem ((powerTail m k).nsmul_mem (pow_mem le_rfl) a)
    ((powerTail m k).nsmul_mem (pow_mem (Nat.le_succ m)) b)

-- Doubling every base sends the tail starting at ⌈n/2⌉ into the tail starting at n.
private lemma double_mem {n k x : ℕ} (hx : x ∈ powerTail ((n + 1) / 2) k) :
    2 ^ k * x ∈ powerTail n k := by
  induction hx using AddSubmonoid.closure_induction with
  | mem _ h =>
    obtain ⟨i, hi, rfl⟩ := h
    change (n + 1) / 2 ≤ i at hi
    rw [← Nat.mul_pow]
    exact pow_mem (by omega)
  | zero => simp
  | add _ _ _ _ ha hb => simpa only [Nat.mul_add] using add_mem ha hb

end conductor_powers_le

open conductor_powers_le

/-- **Dutch–Rickett conductor recursion for semigroups of $k$-th powers.** Fix an integer
$k \ge 1$. For $m \ge 1$ let $S_m$ be the additive submonoid of $\mathbb{N}$ generated by
$m^k, (m+1)^k, (m+2)^k, \ldots$, and let $\tau(S_m)$ be its conductor, the least natural number
$c$ such that every $j \ge c$ lies in $S_m$. Then for every integer $n \ge 1$,
$$\tau(S_n) \le 2^k \, \tau(S_{\lceil n/2 \rceil}) + (2^k - 1)(2n)^k.$$

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Proposition 2, inequality (3), quoting K. Dutch
and C. Rickett (`integers-2025-A11-prop-2`). -/
public theorem conductor_powers_le (n k : ℕ) (hn : 1 ≤ n) (hk : 1 ≤ k) :
    sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure ((fun i => i ^ k) '' Set.Ici n)} ≤
      2 ^ k * sInf {m : ℕ | ∀ j ≥ m,
        j ∈ AddSubmonoid.closure ((fun i => i ^ k) '' Set.Ici ((n + 1) / 2))} +
        (2 ^ k - 1) * (2 * n) ^ k := by
  let c := sInf {m : ℕ | ∀ j ≥ m, j ∈ powerTail ((n + 1) / 2) k}
  have hc : ∀ j ≥ c, j ∈ powerTail ((n + 1) / 2) k := Nat.sInf_mem (thresholds_nonempty _ _)
  change sInf {m : ℕ | ∀ j ≥ m, j ∈ powerTail n k} ≤ 2 ^ k * c + (2 ^ k - 1) * (2 * n) ^ k
  apply Nat.sInf_le
  intro j hj
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (show 2 ^ k * c ≤ j by omega)
  -- The odd base 2n - 1 lies in the tail. Its power and 2^k represent every such remainder d.
  let q := 2 * (n - 1) + 1
  have hcop : Nat.Coprime 2 q :=
    (Nat.coprime_mul_left_add_right 2 1 (n - 1)).mpr (Nat.coprime_one_right 2)
  have hq : q ^ k < (2 * n) ^ k := Nat.pow_lt_pow_left (by dsimp [q]; omega) (by omega)
  have hd : (2 ^ k).pred * (q ^ k).pred ≤ d := by
    calc
      _ ≤ (2 ^ k - 1) * (2 * n) ^ k := Nat.mul_le_mul_left _ ((Nat.pred_le _).trans hq.le)
      _ ≤ d := by omega
  obtain ⟨a, b, hab⟩ := Nat.exists_add_mul_eq_of_gcd_dvd_of_mul_pred_le (2 ^ k) (q ^ k) d
    (by simp [(hcop.pow k k).gcd_eq_one]) hd
  -- Lift c + a from the half-index tail and add the b copies of the odd power.
  rw [← hab, ← Nat.add_assoc, Nat.mul_comm a, ← Nat.mul_add]
  exact add_mem (double_mem (hc (c + a) (Nat.le_add_right c a)))
    ((powerTail n k).nsmul_mem (pow_mem (show n ≤ q by dsimp [q]; omega)) b)

namespace conductor_union_le

private lemma setGcd_eq_one {X : Set ℕ}
    (hgcd : ∀ g : ℕ, (∀ a ∈ X, g ∣ a) → g = 1) : Nat.setGcd X = 1 :=
  hgcd _ fun _ ha => Nat.setGcd_dvd_of_mem ha

private lemma threshold {X : Set ℕ}
    (hgcd : ∀ g : ℕ, (∀ a ∈ X, g ∣ a) → g = 1) :
    ∀ j ≥ sInf {m : ℕ | ∀ k ≥ m, k ∈ AddSubmonoid.closure X},
      j ∈ AddSubmonoid.closure X := by
  obtain ⟨n, hn⟩ := Nat.exists_mem_closure_of_ge X
  have hne : {m : ℕ | ∀ k ≥ m, k ∈ AddSubmonoid.closure X}.Nonempty :=
    ⟨n, fun j hj => hn j hj (by rw [setGcd_eq_one hgcd]; exact one_dvd j)⟩
  intro j hj
  exact Nat.sInf_mem hne j hj

private lemma gcd_div_union {A B : Set ℕ} (t : ℕ)
    (hgcd : ∀ g : ℕ, (∀ a ∈ A ∪ B, g ∣ a) → g = 1)
    (ht : ∀ a ∈ A, t ∣ a) :
    ∀ g : ℕ, (∀ a ∈ (fun a => a / t) '' A ∪ B, g ∣ a) → g = 1 := by
  intro g hg
  apply hgcd g
  intro a ha
  rcases ha with haA | haB
  · have h1 := hg (a / t) (Or.inl ⟨a, haA, rfl⟩)
    have h2 : a / t ∣ a := ⟨t, (Nat.div_mul_cancel (ht a haA)).symm⟩
    exact h1.trans h2
  · exact hg a (Or.inr haB)

private lemma gcd_insert {A B : Set ℕ} (t : ℕ)
    (hgcd : ∀ g : ℕ, (∀ a ∈ A ∪ B, g ∣ a) → g = 1)
    (ht : ∀ a ∈ A, t ∣ a) :
    ∀ g : ℕ, (∀ a ∈ B ∪ {t}, g ∣ a) → g = 1 := by
  intro g hg
  apply hgcd g
  intro a ha
  rcases ha with haA | haB
  · exact (hg t (Or.inr rfl)).trans (ht a haA)
  · exact hg a (Or.inl haB)

private lemma mul_mem {A B : Set ℕ} {t : ℕ} (ht : ∀ a ∈ A, t ∣ a)
    {u : ℕ} (hu : u ∈ AddSubmonoid.closure ((fun a => a / t) '' A ∪ B)) :
    t * u ∈ AddSubmonoid.closure (A ∪ B) := by
  induction hu using AddSubmonoid.closure_induction with
  | mem x hx =>
    rcases hx with ⟨a, haA, rfl⟩ | hxB
    · rw [Nat.mul_div_cancel' (ht a haA)]
      exact AddSubmonoid.subset_closure (Or.inl haA)
    · simpa [nsmul_eq_mul] using
        (AddSubmonoid.closure (A ∪ B)).nsmul_mem
          (AddSubmonoid.subset_closure (Or.inr hxB)) t
  | zero => simp
  | add _ _ _ _ hx hy => rw [Nat.mul_add]; exact add_mem hx hy

private lemma exists_add_mul {B : Set ℕ} {t y : ℕ}
    (hy : y ∈ AddSubmonoid.closure (B ∪ {t})) :
    ∃ b ∈ AddSubmonoid.closure B, ∃ k : ℕ, y = b + k * t := by
  induction hy using AddSubmonoid.closure_induction with
  | mem x hx =>
    rcases hx with hxB | hxT
    · exact ⟨x, AddSubmonoid.subset_closure hxB, 0, by simp⟩
    · rw [Set.mem_singleton_iff] at hxT
      subst hxT
      exact ⟨0, zero_mem _, 1, by simp⟩
  | zero => exact ⟨0, zero_mem _, 0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨b₁, hb₁, k₁, h₁⟩ := hx
    obtain ⟨b₂, hb₂, k₂, h₂⟩ := hy
    exact ⟨b₁ + b₂, add_mem hb₁ hb₂, k₁ + k₂, by rw [h₁, h₂, Nat.add_mul]; ring⟩

end conductor_union_le

open conductor_union_le

set_option linter.unusedVariables false in
/-- **Dutch–Rickett conductor inequality for a union of generating sets.** For a set $X$ of
natural numbers, let $\tau(X)$ be the conductor of the additive submonoid $\langle X \rangle$ of
$\mathbb{N}$ generated by $X$, the least natural number $c$ such that every $j \ge c$ lies in
$\langle X \rangle$. Let $A$ and $B$ be nonempty sets of natural numbers such that $1$ is the only
natural number dividing every element of $A \cup B$, let $t$ be a natural number dividing every
element of $A$, and let $C = \{a / t : a \in A\}$ (with $a / 0 = 0$). Then
$$\tau(A \cup B) \le t \, \tau(C \cup B) + \tau(B \cup \{t\}).$$

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Lemma 3, quoting K. Dutch and C. Rickett
(`integers-2025-A11-lem-3`). -/
public theorem conductor_union_le (A B : Set ℕ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hgcd : ∀ g : ℕ, (∀ a ∈ A ∪ B, g ∣ a) → g = 1) (t : ℕ) (ht : ∀ a ∈ A, t ∣ a) :
    sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure (A ∪ B)} ≤
      t * sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure ((fun a => a / t) '' A ∪ B)} +
        sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure (B ∪ {t})} := by
  let c₁ := sInf {m : ℕ | ∀ j ≥ m,
    j ∈ AddSubmonoid.closure ((fun a => a / t) '' A ∪ B)}
  let c₂ := sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure (B ∪ {t})}
  have h₁ := threshold (gcd_div_union t hgcd ht)
  have h₂ := threshold (gcd_insert t hgcd ht)
  change sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure (A ∪ B)} ≤ t * c₁ + c₂
  refine Nat.sInf_le ?_
  intro j hj
  obtain ⟨b, hb, k, hk⟩ := exists_add_mul (h₂ (j - t * c₁) (by omega))
  have hck : c₁ + k ∈ AddSubmonoid.closure ((fun a => a / t) '' A ∪ B) :=
    h₁ _ (Nat.le_add_right _ _)
  have hscale := mul_mem ht hck
  have hj_eq : j = t * (c₁ + k) + b := by
    rw [Nat.mul_add, Nat.mul_comm k t] at *
    omega
  rw [hj_eq]
  exact add_mem hscale (AddSubmonoid.closure_mono Set.subset_union_right hb)

end MetaMathlibExt
