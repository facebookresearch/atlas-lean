/-!
# Embedding dimensions and conductors of numerical semigroups

A linear lower bound on first appearances bounds the number of minimal generators of each tail.
The Dutch–Rickett inequality bounds the conductor of a union of generating sets.
-/

namespace MetaMathlibExt

namespace embeddingDimension_le_of_firstAppearance_ge

private lemma exists_generator_add {A : Set ℕ} {s : ℕ} (hs : s ∈ AddSubmonoid.closure A)
    (hs₀ : s ≠ 0) : ∃ a ∈ A, ∃ b ∈ AddSubmonoid.closure A, a + b = s := by
  induction hs using AddSubmonoid.closure_induction_left with
  | zero => exact (hs₀ rfl).elim
  | add_left a ha b hb _ => exact ⟨a, ha, b, hb, rfl⟩

end embeddingDimension_le_of_firstAppearance_ge

open embeddingDimension_le_of_firstAppearance_ge

/-- **Embedding dimension bound from linear growth of first appearances.** Let
$x_0 < x_1 < x_2 < \cdots$ be a strictly increasing sequence of natural numbers. For $m \ge 1$
let $S_m$ be the additive submonoid of $\mathbb{N}$ generated by $x_m, x_{m+1}, \ldots$; call a
nonzero element of $S_m$ that is not the sum of two nonzero elements of $S_m$ a minimal generator
of $S_m$, and let the embedding dimension $e(S_m)$ be the number of minimal generators of $S_m$.
For $k \ge 1$ let $r_k$ be the least $m \ge 1$ such that $x_k$ is a minimal generator of $S_m$.
If $\alpha > 0$ is a real number with $r_k \ge \alpha k$ for all $k \ge 1$, then
$e(S_n) \le \lfloor n / \alpha \rfloor - n + 1$ for all $n \ge 1$.

The paper's standing assumption $\gcd(x_n, x_{n+1}, \ldots) = 1$ is not needed and is dropped.

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Proposition 1 (`integers-2025-A11-prop-1`). -/
public theorem embeddingDimension_le_of_firstAppearance_ge (x : ℕ → ℕ) (hx : StrictMono x)
    (α : ℝ) (hα : 0 < α)
    (hr : ∀ k : ℕ, 1 ≤ k → α * k ≤ ((sInf {m : ℕ | 1 ≤ m ∧
      x k ∈ {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m),
          a + b = s → a = 0 ∨ b = 0}} : ℕ) : ℝ))
    (n : ℕ) (hn : 1 ≤ n) :
    ({s | s ∈ AddSubmonoid.closure (x '' Set.Ici n) ∧ s ≠ 0 ∧
        ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici n), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici n),
          a + b = s → a = 0 ∨ b = 0}.ncard : ℤ) ≤ ⌊(n : ℝ) / α⌋ - n + 1 := by
  let β (m : ℕ) : Set ℕ := {s | s ∈ AddSubmonoid.closure (x '' Set.Ici m) ∧ s ≠ 0 ∧
    ∀ a ∈ AddSubmonoid.closure (x '' Set.Ici m), ∀ b ∈ AddSubmonoid.closure (x '' Set.Ici m),
      a + b = s → a = 0 ∨ b = 0}
  change ((β n).ncard : ℤ) ≤ _
  have index_le {k : ℕ} (hk : n ≤ k) (hs : x k ∈ β n) : k ≤ ⌊(n : ℝ) / α⌋₊ := by
    have hfirst : sInf {m : ℕ | 1 ≤ m ∧ x k ∈ β m} ≤ n := csInf_le' ⟨hn, hs⟩
    apply Nat.le_floor
    apply (le_div_iff₀ hα).mpr
    rw [mul_comm]
    exact (hr k (hn.trans hk)).trans (Nat.cast_le.mpr hfirst)
  -- The first term of the tail is its smallest positive element, hence a minimal generator.
  have hpos : 0 < x n := (Nat.zero_le (x 0)).trans_lt (hx hn)
  have hmin : x n ∈ β n := by
    refine ⟨AddSubmonoid.subset_closure ⟨n, le_refl n, rfl⟩, hpos.ne', ?_⟩
    intro a ha b _ hab
    by_cases ha₀ : a = 0
    · exact Or.inl ha₀
    obtain ⟨_, ⟨k, hk, rfl⟩, c, _, hc⟩ := exists_generator_add ha ha₀
    have hnk : x n ≤ x k := hx.monotone hk
    exact Or.inr (by omega)
  have hsub : β n ⊆ x '' Set.Icc n ⌊(n : ℝ) / α⌋₊ := by
    intro s hs
    obtain ⟨_, ⟨k, hk, rfl⟩, b, hb, hsum⟩ := exists_generator_add hs.1 hs.2.1
    have hdecomp := hs.2.2 _ (AddSubmonoid.subset_closure ⟨k, hk, rfl⟩) b hb hsum
    have hpos_k := hpos.trans_le (hx.monotone hk)
    obtain rfl := hdecomp.resolve_left hpos_k.ne'
    rw [add_zero] at hsum
    exact ⟨k, ⟨hk, index_le hk (hsum ▸ hs)⟩, hsum⟩
  have hcard := Set.ncard_le_ncard hsub ((Set.finite_Icc ..).image x)
  rw [Set.ncard_image_of_injective _ hx.injective, Set.ncard_Icc_nat] at hcard
  have hn_floor := index_le le_rfl hmin
  rw [← Int.natCast_floor_eq_floor (div_nonneg (Nat.cast_nonneg n) hα.le)]
  omega

open AddSubmonoid in
set_option linter.unusedVariables false in
/-- **Dutch–Rickett conductor inequality for a union of generating sets.** For a set $X$ of
natural numbers, let $\tau(X)$ be the conductor of the additive submonoid $\langle X \rangle$ of
$\mathbb{N}$ generated by $X$, the least natural number $c$ such that every $j \ge c$ lies in
$\langle X \rangle$. Let $A$ and $B$ be nonempty sets of natural numbers such that $1$ is the only
natural number dividing every element of $A \cup B$, let $t$ be a natural number dividing every
element of $A$, and let $C = \{a / t : a \in A\}$ (with $a / 0 = 0$). Then
$$\tau(A \cup B) \le t \, \tau(C \cup B) + \tau(B \cup \{t\}).$$

Source: Fabián Arias, Jerson Borja and Jaider Terán, *A Note on Numerical Semigroups Generated
by k-th Powers*, INTEGERS 25 (2025), Article A11, Lemma 3, quoting K. Dutch and C. Rickett
(`integers-2025-A11-lem-3`). -/
public theorem conductor_union_le (A B : Set ℕ) (hA : A.Nonempty) (hB : B.Nonempty)
    (hgcd : ∀ g : ℕ, (∀ a ∈ A ∪ B, g ∣ a) → g = 1) (t : ℕ) (ht : ∀ a ∈ A, t ∣ a) :
    sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure (A ∪ B)} ≤
      t * sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure ((fun a => a / t) '' A ∪ B)} +
        sInf {m : ℕ | ∀ j ≥ m, j ∈ AddSubmonoid.closure (B ∪ {t})} := by
  let C := (fun a => a / t) '' A
  let τ (s : Set ℕ) := sInf {m : ℕ | ∀ j ≥ m, j ∈ closure s}
  have mem_of_ge (s : Set ℕ) (hs : ∀ a ∈ A ∪ B, Nat.setGcd s ∣ a) :
      ∀ j ≥ τ s, j ∈ closure s := by
    obtain ⟨m, hm⟩ := Nat.exists_mem_closure_of_ge s
    exact Nat.sInf_mem (s := {m : ℕ | ∀ j ≥ m, j ∈ closure s})
      ⟨m, fun j hj ↦ hm j hj (hgcd _ hs ▸ one_dvd j)⟩
  have hC := mem_of_ge (C ∪ B) (by
    rintro a (ha | hb)
    · have h : a / t ∈ C ∪ B := Or.inl ⟨a, ha, rfl⟩
      exact (Nat.setGcd_dvd_of_mem h).trans (Nat.div_dvd_of_dvd (ht a ha))
    · exact Nat.setGcd_dvd_of_mem (Or.inr hb))
  have hBt := mem_of_ge (B ∪ {t}) (by
    rintro a (ha | hb)
    · have h : t ∈ B ∪ {t} := Or.inr rfl
      exact (Nat.setGcd_dvd_of_mem h).trans (ht a ha)
    · exact Nat.setGcd_dvd_of_mem (Or.inl hb))
  -- Scaling recovers each generator from A and takes each generator from B to a multiple.
  have hscale : closure (C ∪ B) ≤ (closure (A ∪ B)).comap (AddMonoidHom.mulLeft t) := by
    apply closure_le.mpr
    rintro _ (⟨a, ha, rfl⟩ | hb)
    · change t * (a / t) ∈ closure (A ∪ B)
      rw [Nat.mul_div_cancel' (ht a ha)]
      exact subset_closure (Or.inl ha)
    · exact nsmul_mem (subset_closure (Or.inr hb) : _ ∈ closure (A ∪ B)) t
  change τ (A ∪ B) ≤ t * τ (C ∪ B) + τ (B ∪ {t})
  apply Nat.sInf_le
  intro j hj
  obtain ⟨r, rfl⟩ := exists_add_of_le hj
  -- Split the unscaled remainder into a sum from B and k copies of t.
  have hr := hBt (τ (B ∪ {t}) + r) (Nat.le_add_right ..)
  rw [closure_union, mem_sup] at hr
  obtain ⟨b, hb, _, hkt, heq⟩ := hr
  obtain ⟨k, rfl⟩ := mem_closure_singleton.mp hkt
  have hsum : t * τ (C ∪ B) + τ (B ∪ {t}) + r = t * (τ (C ∪ B) + k) + b := by
    rw [add_assoc, ← heq, Nat.nsmul_eq_mul, Nat.mul_add]
    ac_rfl
  rw [hsum]
  exact add_mem (hscale (hC _ (Nat.le_add_right ..))) (closure_mono Set.subset_union_right hb)

end MetaMathlibExt
