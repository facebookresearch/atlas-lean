/-!
# Strong Markov property for discrete-time Markov chains

For the Markov chain with initial distribution `μ` and transition kernel
`κ` on a standard Borel space `S`, conditioning on the σ-algebra `ℱ_T`
generated by a stopping time `T` only depends on the value of the chain
at time `T`: the conditional expectation of a time-indexed bounded
measurable functional composed with the stopping-time shift equals the
expectation of the functional under the chain restarted from the
current state.

## Source

The Lecture 31 target in `v1/Atlas/TheoryOfProbability/targets.yaml` allows
an a.s.-finite stopping time. The archived `StrongMarkovChain.lean` instead
used an everywhere-finite natural-valued time and depended on the admitted
shifted-trajectory lemma. The full target is `strong_markov_chain_ae_finite`;
`strong_markov_chain` preserves that archived finite interface as a specialization.
The ordinary Markov property is proved in `MathlibExt.Probability.MarkovPropertyChain`.
Mathlib's stopped-value and conditional-expectation APIs are reused throughout.

## Main results

* `MathlibExt.Probability.StrongMarkovChain.stoppedPathShift`: the path
  shifted by a stopping time.
* `MathlibExt.Probability.StrongMarkovChain.ae_eq_of_ae_eq_restrict_fibers`:
  a.e. equality on each fiber of an `ℕ`-valued function implies a.e.
  equality on the whole space.
* `MathlibExt.Probability.StrongMarkovChain.strong_markov_chain_ae_finite`:
  the strong Markov property with a.s.-finite `WithTop ℕ` stopping times.
* `MathlibExt.Probability.StrongMarkovChain.strong_markov_chain`:
  the original everywhere-finite specialization.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Kernel Finset
open MathlibExt.Probability.MarkovChainPath
open MathlibExt.Probability.MarkovPropertyChain

namespace MathlibExt.Probability.StrongMarkovChain

/-- **Path shifted by a random time.** For a type $S$ and a function
$T : (\mathbb{N} \to S) \to \mathbb{N}$ (typically a stopping time), the shift by $T$ sends a path
$\omega : \mathbb{N} \to S$ to the path $k \mapsto \omega(T(\omega) + k)$. -/
def stoppedPathShift {S : Type*} (T : (ℕ → S) → ℕ) : (ℕ → S) → (ℕ → S) :=
  fun ω k => ω (T ω + k)

/-- **The shift by a random time agrees with the fixed shift on its level set.** Let $S$ be a
type, let $T : (\mathbb{N} \to S) \to \mathbb{N}$ and $n \in \mathbb{N}$, and let
$\omega : \mathbb{N} \to S$ be a path with $T(\omega) = n$. Then the path $\omega$ shifted by $T$,
namely $k \mapsto \omega(T(\omega) + k)$, equals the path $\omega$ shifted by $n$, namely
$k \mapsto \omega(n + k)$. -/
theorem stoppedPathShift_eq_shiftPath_on_eq {S : Type*}
    (T : (ℕ → S) → ℕ) (n : ℕ) (ω : ℕ → S) (h : T ω = n) :
    stoppedPathShift T ω = shiftPath n ω := by
  ext k
  simp [stoppedPathShift, shiftPath, h]

/-- **A.e. equality from a.e. equality on the fibers of a natural-valued function.** Let $\mu$
be a measure on a measurable space $\Omega$, let $T : \Omega \to \mathbb{N}$ be a function whose
fibers $\{T = n\}$, $n \in \mathbb{N}$, are all measurable, and let $f, g : \Omega \to \mathbb{R}$.
If for every $n \in \mathbb{N}$ we have $f = g$ almost everywhere with respect to the restriction
of $\mu$ to $\{T = n\}$, then $f = g$ $\mu$-almost everywhere. -/
lemma ae_eq_of_ae_eq_restrict_fibers {Ω : Type*} {m0 : MeasurableSpace Ω}
    (T : Ω → ℕ) (μ : @Measure Ω m0)
    (f g : Ω → ℝ)
    (hT_meas : ∀ n, MeasurableSet {ω : Ω | T ω = n})
    (h : ∀ n, f =ᵐ[μ.restrict {ω | T ω = n}] g) :
    f =ᵐ[μ] g := by
  have hfiber : ∀ n, ∀ᵐ ω ∂μ, T ω = n → f ω = g ω := by
    intro n
    have hn := h n
    rw [Filter.EventuallyEq, ae_restrict_iff' (hT_meas n)] at hn
    exact hn
  suffices ∀ᵐ ω ∂μ, ∀ n, T ω = n → f ω = g ω by
    filter_upwards [this] with ω hω
    exact hω (T ω) rfl
  rw [ae_all_iff]
  exact hfiber


private lemma measurable_stopped_family {Ω : Type*} [MeasurableSpace Ω]
    (τ : Ω → WithTop ℕ) (hτ : Measurable τ) (u : ℕ → Ω → ℝ)
    (hu : ∀ n, Measurable (u n)) : Measurable (stoppedValue u τ) := by
  have hu_joint : Measurable (fun p : ℕ × Ω => u p.1 p.2) :=
    measurable_from_prod_countable_right hu
  exact hu_joint.comp ((WithTop.measurable_untopA.comp hτ).prodMk measurable_id)

/-- **A.e. equality from a.e. equality on the finite fibers.** Let $\mu$ be a measure on a
measurable space $\Omega$, let $\tau : \Omega \to \mathbb{N} \cup \{\infty\}$ satisfy
$\tau \ne \infty$ $\mu$-almost everywhere and have every fiber $\{\tau = n\}$, $n \in \mathbb{N}$,
measurable, and let $f, g : \Omega \to \mathbb{R}$. If for every $n \in \mathbb{N}$ we have
$f = g$ almost everywhere with respect to the restriction of $\mu$ to $\{\tau = n\}$, then
$f = g$ $\mu$-almost everywhere. -/
lemma ae_eq_of_ae_eq_restrict_finite_fibers {Ω : Type*} [MeasurableSpace Ω]
    (τ : Ω → WithTop ℕ) (μ : Measure Ω) (f g : Ω → ℝ)
    (hfinite : ∀ᵐ ω ∂μ, τ ω ≠ ⊤)
    (hmeas : ∀ n : ℕ, MeasurableSet {ω | τ ω = (n : WithTop ℕ)})
    (h : ∀ n : ℕ, f =ᵐ[μ.restrict {ω | τ ω = (n : WithTop ℕ)}] g) : f =ᵐ[μ] g := by
  have hall : ∀ᵐ ω ∂μ, ∀ n : ℕ, τ ω = (n : WithTop ℕ) → f ω = g ω := by
    rw [ae_all_iff]
    intro n
    have hn := h n
    rw [Filter.EventuallyEq, ae_restrict_iff' (hmeas n)] at hn
    exact hn
  filter_upwards [hfinite, hall] with ω hfin hω
  obtain ⟨n, hn⟩ := WithTop.ne_top_iff_exists.mp hfin
  exact hω n hn.symm

private lemma condExp_stopped_family {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (ℱ : Filtration ℕ ‹MeasurableSpace Ω›)
    (τ : Ω → WithTop ℕ) (hτ : IsStoppingTime ℱ τ)
    (hfinite : ∀ᵐ ω ∂μ, τ ω ≠ ⊤)
    (u v : ℕ → Ω → ℝ) (hu : ∀ n, Measurable (u n))
    (hbdd : ∃ C : ℝ, ∀ n ω, |u n ω| ≤ C)
    (hfixed : ∀ n, μ[u n | ℱ n] =ᵐ[μ] v n) :
    μ[stoppedValue u τ | hτ.measurableSpace] =ᵐ[μ] stoppedValue v τ := by
  obtain ⟨C, hC⟩ := hbdd
  have hτ_meas : Measurable τ :=
    hτ.measurable.mono hτ.measurableSpace_le le_rfl
  have hf_int : Integrable (stoppedValue u τ) μ :=
    Integrable.of_bound (measurable_stopped_family τ hτ_meas u hu).aestronglyMeasurable C
      (ae_of_all μ (fun ω => by simpa only [Real.norm_eq_abs, stoppedValue] using hC (τ ω).untopA ω))
  apply ae_eq_of_ae_eq_restrict_finite_fibers τ μ _ _ hfinite
    (fun n => ℱ.le n _ (hτ.measurableSet_eq_of_countable n))
  intro n
  let s : Set Ω := {ω | τ ω = (n : WithTop ℕ)}
  have hs_ℱ : MeasurableSet[ℱ n] s := hτ.measurableSet_eq_of_countable n
  have hs : MeasurableSet s := ℱ.le n _ hs_ℱ
  have hn_int : Integrable (u n) μ :=
    Integrable.of_bound (hu n).aestronglyMeasurable C
      (ae_of_all μ (fun ω => by simpa only [Real.norm_eq_abs] using hC n ω))
  have hagree : stoppedValue u τ =ᵐ[μ.restrict s] u n := by
    rw [Filter.EventuallyEq, ae_restrict_iff' hs]
    filter_upwards with ω hω
    change τ ω = (n : WithTop ℕ) at hω
    simp only [stoppedValue, hω]
    rw [← ENat.some_eq_natCast, WithTop.untopA_eq_untop (by simp), WithTop.untop_coe]
  have hlocal : μ[stoppedValue u τ | ℱ n] =ᵐ[μ.restrict s] μ[u n | ℱ n] :=
    (condExp_restrict_ae_eq_restrict (ℱ.le n) hs_ℱ hf_int).symm.trans
      ((condExp_congr_ae hagree).trans
        (condExp_restrict_ae_eq_restrict (ℱ.le n) hs_ℱ hn_int))
  have hlast : v n =ᵐ[μ.restrict s] stoppedValue v τ := by
    rw [Filter.EventuallyEq, ae_restrict_iff' hs]
    filter_upwards with ω hω
    change τ ω = (n : WithTop ℕ) at hω
    simp only [stoppedValue, hω]
    rw [← ENat.some_eq_natCast, WithTop.untopA_eq_untop (by simp), WithTop.untop_coe]
  have hfixed_s : μ[u n | ℱ n] =ᵐ[μ.restrict s] v n :=
    ae_restrict_of_ae (hfixed n)
  exact (condExp_stopping_time_ae_eq_restrict_eq_of_countable hτ n).trans
    (hlocal.trans (hfixed_s.trans hlast))


/-- **Strong Markov property for a.s.-finite stopping times.** Let $S$ be a nonempty standard
Borel space, $\mu$ a finite measure on $S$, $\kappa$ a Markov kernel on $S$, and $P_\mu$ the law
on the path space $S^{\mathbb{N}}$ of the Markov chain with initial distribution $\mu$ and
transition kernel $\kappa$. For $x \in S$ write $E_x$ for the expectation under the chain started
from $x$, and for a path $\omega$ and $n \in \mathbb{N}$ write $\theta_n \omega$ for the shifted
path $k \mapsto \omega(n + k)$. Let $T : S^{\mathbb{N}} \to \mathbb{N} \cup \{\infty\}$ be a
stopping time for the path filtration, with $\sigma$-algebra $\mathcal{F}_T$, such that
$T \ne \infty$ $P_\mu$-almost surely, and let $Y_n : S^{\mathbb{N}} \to \mathbb{R}$, for
$n \in \mathbb{N}$, be measurable functions with $|Y_n(\omega)| \le C$ for a single constant $C$
and all $n$ and $\omega$. Then the conditional expectation under $P_\mu$ given $\mathcal{F}_T$ of
$\omega \mapsto Y_{T(\omega)}(\theta_{T(\omega)} \omega)$ equals
$\omega \mapsto E_{\omega(T(\omega))}[Y_{T(\omega)}]$ $P_\mu$-almost surely.

On the null event $\{T = \infty\}$ both sides are evaluated at the same unspecified finite time,
which does not affect the almost-sure equality.

Source: Theory of Probability, Lecture 31 (strong Markov property). -/
theorem strong_markov_chain_ae_finite
    (S : Type*) [MeasurableSpace S] [StandardBorelSpace S] [Nonempty S]
    (μ : Measure S) [IsFiniteMeasure μ]
    (κ : Kernel S S) [IsMarkovKernel κ]
    (T : (ℕ → S) → WithTop ℕ)
    (hT : @IsStoppingTime (ℕ → S) ℕ MeasurableSpace.pi _ (pathFiltration S) T)
    (hT_finite : ∀ᵐ ω ∂MarkovChainPathMeasure S μ κ, T ω ≠ ⊤)
    (Y : ℕ → (ℕ → S) → ℝ)
    (hY_meas : ∀ n, @Measurable _ _ MeasurableSpace.pi _ (Y n))
    (hY_bdd : ∃ C : ℝ, ∀ n ω, |Y n ω| ≤ C) :
    let P_μ := MarkovChainPathMeasure S μ κ
    P_μ[stoppedValue (fun n ω => Y n (shiftPath n ω)) T | hT.measurableSpace]
      =ᵐ[P_μ] stoppedValue (fun n ω => markovExpectation S κ (Y n) (ω n)) T := by
  intro P_μ
  letI : IsFiniteMeasure P_μ := MarkovChainPathMeasure.isFiniteMeasure S μ κ
  apply condExp_stopped_family P_μ (pathFiltration S) T hT hT_finite
    (fun n ω => Y n (shiftPath n ω))
    (fun n ω => markovExpectation S κ (Y n) (ω n))
  · intro n
    exact (hY_meas n).comp (measurable_shiftPath n)
  · obtain ⟨C, hC⟩ := hY_bdd
    exact ⟨C, fun n ω => hC n (shiftPath n ω)⟩
  · intro n
    exact markov_property_full S μ κ (Y n) (hY_meas n)
      (by obtain ⟨C, hC⟩ := hY_bdd; exact ⟨C, fun ω => hC n ω⟩) n

/-- **Strong Markov property for everywhere-finite stopping times.** Let $S$ be a nonempty
standard Borel space, $\mu$ a finite measure on $S$, $\kappa$ a Markov kernel on $S$, and $P_\mu$
the law on the path space $S^{\mathbb{N}}$ of the Markov chain with initial distribution $\mu$ and
transition kernel $\kappa$; for $x \in S$ write $E_x$ for the expectation under the chain started
from $x$. Let $T : S^{\mathbb{N}} \to \mathbb{N}$ be a stopping time for the path filtration, with
$\sigma$-algebra $\mathcal{F}_T$, and let $Y_n : S^{\mathbb{N}} \to \mathbb{R}$, for
$n \in \mathbb{N}$, be measurable functions with $|Y_n(\omega)| \le C$ for a single constant $C$
and all $n$ and $\omega$. Write $\theta_T \omega$ for the path $\omega$ shifted by $T$, namely
$k \mapsto \omega(T(\omega) + k)$. Then the conditional expectation under $P_\mu$ given
$\mathcal{F}_T$ of $\omega \mapsto Y_{T(\omega)}(\theta_T \omega)$ equals
$\omega \mapsto E_{\omega(T(\omega))}[Y_{T(\omega)}]$ $P_\mu$-almost surely.

This is the special case of the strong Markov property for a.s.-finite stopping times in which
the time is finite everywhere. -/
theorem strong_markov_chain
    (S : Type*) [MeasurableSpace S] [StandardBorelSpace S] [Nonempty S]
    (μ : Measure S) [IsFiniteMeasure μ]
    (κ : Kernel S S) [IsMarkovKernel κ]
    (T : (ℕ → S) → ℕ)
    (hT : @IsStoppingTime (ℕ → S) ℕ
      MeasurableSpace.pi _ (pathFiltration S) (fun ω => (T ω : WithTop ℕ)))
    (Y : ℕ → (ℕ → S) → ℝ)
    (hY_meas : ∀ n, @Measurable _ _ MeasurableSpace.pi _ (Y n))
    (hY_bdd : ∃ C : ℝ, ∀ n ω, |Y n ω| ≤ C) :
    let P_μ := MarkovChainPathMeasure S μ κ
    P_μ[fun ω => Y (T ω) (stoppedPathShift T ω) | hT.measurableSpace]
    =ᵐ[P_μ]
      fun ω => markovExpectation S κ (Y (T ω)) (ω (T ω)) := by
  intro P_μ
  have h := strong_markov_chain_ae_finite S μ κ (fun ω => (T ω : WithTop ℕ)) hT
    (Filter.Eventually.of_forall (fun ω => by simp)) Y hY_meas hY_bdd
  have hsource :
      stoppedValue (fun n ω => Y n (shiftPath n ω)) (fun ω => (T ω : WithTop ℕ)) =
        fun ω => Y (T ω) (stoppedPathShift T ω) := by
    rfl
  have htarget :
      stoppedValue (fun n ω => markovExpectation S κ (Y n) (ω n))
          (fun ω => (T ω : WithTop ℕ)) =
        fun ω => markovExpectation S κ (Y (T ω)) (ω (T ω)) := by
    rfl
  rw [hsource, htarget] at h
  exact h

end MathlibExt.Probability.StrongMarkovChain
