/-!
# Sharp regression discontinuity: identification at the cutoff

This module proves identification of the treatment effect at the cutoff in a
sharp regression-discontinuity design, following Hahn, Todd and Van der Klaauw
(2001), Section 2, Assumptions (A1)-(A2) and equation (4).

The running variable is `X`, the cutoff is `c`, and treatment is received
exactly when `c ≤ X`. Potential outcomes are `Y₀` (untreated) and `Y₁`
(treated). The observed outcome uses `observed` from `CausalIdentification`.

Encoding: conditional means are designated versions `m₀` and `m₁` of Mathlib's
conditional expectation given the σ-algebra generated by `X`. Assumption (A1)
is continuity of `m₀` at `c` and assumption (A2) is continuity of `m₁ - m₀`
at `c`; jointly these are equivalent to continuity of both `m₀` and `m₁` at
`c` as encoded. The one-sided limits are taken of an arbitrary version `m`
of the observed regression. The law of `X` is assumed to charge every
interval `(c - δ, c)` and `(c, c + δ)`; this two-sided support hypothesis
makes the limits functionals of the observed law. The event `X = c` may have
probability zero, so we never condition on it.

What is not covered: the fuzzy design and its local instrumental-variable
contract, estimation by local polynomial regression and bandwidth choice,
inference, and manipulation tests.

## References

* J. Hahn, P. Todd, W. Van der Klaauw, Identification and Estimation of
  Treatment Effects with a Regression-Discontinuity Design, Econometrica 69(1)
  (2001), 201-209, Section 2.
-/

@[expose] public section

namespace MathlibExt.Probability.Causality

open MeasureTheory Filter
open scoped Topology

/-- Indicator respects almost-everywhere equality. -/
private theorem indicator_ae_congr_of_ae_eq
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (s : Set Ω) {f g : Ω → ℝ} (h : f =ᵐ[μ] g) :
    s.indicator f =ᵐ[μ] s.indicator g := by
  filter_upwards [h] with ω hω
  by_cases hs : ω ∈ s
  · simp [hs, hω]
  · simp [hs]

/-- Functions with different limits differ on the filter. -/
private theorem mem_ne_of_tendsto_ne
    {m m₀ : ℝ → ℝ} {l : Filter ℝ} {b c : ℝ}
    (hb : Tendsto m l (𝓝 b)) (h₀ : Tendsto m₀ l (𝓝 (m₀ c)))
    (hne : b ≠ m₀ c) : {x | m x ≠ m₀ x} ∈ l := by
  have hSub : Tendsto (fun x => m x - m₀ x) l (𝓝 (b - m₀ c)) :=
    hb.sub h₀
  have hNe0 : b - m₀ c ≠ 0 := sub_ne_zero.mpr hne
  have hEv0 : ∀ᶠ x in l, (m x - m₀ x) ≠ 0 := hSub.eventually_ne hNe0
  filter_upwards [hEv0] with x hx
  exact sub_ne_zero.mp hx

/-- A preimage of a disagreement set lies in the null event. -/
private theorem preimage_subset_null_of_disagree
    {Ω : Type*} {X : Ω → ℝ} {m m₀ : ℝ → ℝ}
    {s : Set ℝ} {P : Ω → Prop}
    (hP : ∀ ω, X ω ∈ s → P ω)
    (hNe : ∀ x ∈ s, m x ≠ m₀ x) :
    X ⁻¹' s ⊆ {ω | ¬(P ω → m (X ω) = m₀ (X ω))} := by
  intro ω hω hImp
  exact hNe (X ω) hω (hImp (hP ω hω))

/-- In a sharp design the observed regression is the treated version right of
the cutoff (and at it) and the untreated version left of it. -/
theorem sharpRD_condExp_observed_ae_eq
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {X : Ω → ℝ} (hX : Measurable X) (c : ℝ)
    {Y₀ Y₁ : Ω → ℝ} (hY₀ : Integrable Y₀ μ) (hY₁ : Integrable Y₁ μ)
    {m₀ m₁ : ℝ → ℝ}
    (hm₀ : μ[Y₀ | MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ)]
      =ᵐ[μ] fun ω => m₀ (X ω))
    (hm₁ : μ[Y₁ | MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ)]
      =ᵐ[μ] fun ω => m₁ (X ω)) :
    μ[observed {ω | c ≤ X ω} Y₀ Y₁ |
      MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ)]
      =ᵐ[μ] fun ω => if c ≤ X ω then m₁ (X ω) else m₀ (X ω) := by
  have hIci : MeasurableSet (Set.Ici c) := measurableSet_Ici
  have hsMeas : MeasurableSet {ω | c ≤ X ω} := hX hIci
  have hsComap : MeasurableSet[MeasurableSpace.comap X
      (inferInstance : MeasurableSpace ℝ)] {ω | c ≤ X ω} :=
    ⟨Set.Ici c, hIci, rfl⟩
  have hInt1 : Integrable ({ω | c ≤ X ω}.indicator Y₁) μ :=
    hY₁.indicator hsMeas
  have hInt0 : Integrable ({ω | c ≤ X ω}ᶜ.indicator Y₀) μ :=
    hY₀.indicator hsMeas.compl
  have hObs : observed {ω | c ≤ X ω} Y₀ Y₁
      = ({ω | c ≤ X ω}.indicator Y₁ + {ω | c ≤ X ω}ᶜ.indicator Y₀) := rfl
  rw [hObs]
  have hAdd := MeasureTheory.condExp_add hInt1 hInt0
    (MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ))
  have hInd1 := MeasureTheory.condExp_indicator hY₁ hsComap
  have hInd0 :=
    MeasureTheory.condExp_indicator hY₀ hsComap.compl
  have hVer1 := indicator_ae_congr_of_ae_eq {ω | c ≤ X ω} hm₁
  have hVer0 := indicator_ae_congr_of_ae_eq {ω | c ≤ X ω}ᶜ hm₀
  have hComb1 := hInd1.trans hVer1
  have hComb0 := hInd0.trans hVer0
  have hPoint : ∀ ω, ((({ω | c ≤ X ω}.indicator fun ω => m₁ (X ω))
      + {ω | c ≤ X ω}ᶜ.indicator fun ω => m₀ (X ω)) ω)
      = (if c ≤ X ω then m₁ (X ω) else m₀ (X ω)) := fun ω => by
    by_cases h : c ≤ X ω
    · simp [h]
    · simp [h]
  have hFinal : ((({ω | c ≤ X ω}.indicator fun ω => m₁ (X ω))
      + {ω | c ≤ X ω}ᶜ.indicator fun ω => m₀ (X ω)))
      =ᵐ[μ] fun ω => if c ≤ X ω then m₁ (X ω) else m₀ (X ω) :=
    Filter.Eventually.of_forall hPoint
  exact (hAdd.trans (hComb1.add hComb0)).trans hFinal

/-- The observed jump of any version of the observed regression that has
one-sided limits is the difference of the designated versions at the cutoff. -/
theorem sharpRD_jump_eq_sub_of_tendsto
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {X : Ω → ℝ} (hX : Measurable X) (c : ℝ)
    {Y₀ Y₁ : Ω → ℝ} (hY₀ : Integrable Y₀ μ) (hY₁ : Integrable Y₁ μ)
    {m₀ m₁ : ℝ → ℝ}
    (hm₀ : μ[Y₀ | MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ)]
      =ᵐ[μ] fun ω => m₀ (X ω))
    (hm₁ : μ[Y₁ | MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ)]
      =ᵐ[μ] fun ω => m₁ (X ω))
    (hcont₀ : ContinuousAt m₀ c) (hcont₁ : ContinuousAt m₁ c)
    (hleft : ∀ δ > 0, μ (X ⁻¹' Set.Ioo (c - δ) c) ≠ 0)
    (hright : ∀ δ > 0, μ (X ⁻¹' Set.Ioo c (c + δ)) ≠ 0)
    (m : ℝ → ℝ)
    (hm : μ[observed {ω | c ≤ X ω} Y₀ Y₁ |
      MeasurableSpace.comap X (inferInstance : MeasurableSpace ℝ)]
      =ᵐ[μ] fun ω => m (X ω))
    (a b : ℝ) (ha : Tendsto m (𝓝[<] c) (𝓝 a))
    (hb : Tendsto m (𝓝[>] c) (𝓝 b)) :
    b - a = m₁ c - m₀ c := by
  have h1 := sharpRD_condExp_observed_ae_eq hX c hY₀ hY₁ hm₀ hm₁
  have hEq : (fun ω => m (X ω)) =ᵐ[μ]
      (fun ω => if c ≤ X ω then m₁ (X ω) else m₀ (X ω)) :=
    hm.symm.trans h1
  have hRight : (∀ᵐ ω ∂μ, c ≤ X ω → m (X ω) = m₁ (X ω)) := by
    filter_upwards [hEq] with (ω : Ω)
      (hω : m (X ω) = (if c ≤ X ω then m₁ (X ω) else m₀ (X ω)))
    intro hc
    simpa [hc] using hω
  have hLeft : (∀ᵐ ω ∂μ, X ω < c → m (X ω) = m₀ (X ω)) := by
    filter_upwards [hEq] with (ω : Ω)
      (hω : m (X ω) = (if c ≤ X ω then m₁ (X ω) else m₀ (X ω)))
    intro hc
    have hnc : ¬c ≤ X ω := by linarith
    simpa [hnc] using hω
  have hNullR : μ {ω | ¬(c ≤ X ω → m (X ω) = m₁ (X ω))} = 0 :=
    MeasureTheory.ae_iff.mp hRight
  have hNullL : μ {ω | ¬(X ω < c → m (X ω) = m₀ (X ω))} = 0 :=
    MeasureTheory.ae_iff.mp hLeft
  have hbEq : b = m₁ c := by
    by_contra hbNe
    have h1Tend : Filter.Tendsto m₁ (𝓝[>] c) (𝓝 (m₁ c)) :=
      tendsto_nhdsWithin_of_tendsto_nhds hcont₁.tendsto
    have hMem := mem_ne_of_tendsto_ne hb h1Tend hbNe
    obtain ⟨u, huMem, huSub⟩ :=
      mem_nhdsGT_iff_exists_Ioo_subset.mp hMem
    have hcu : c < u := huMem
    have hSubSet : X ⁻¹' Set.Ioo c u ⊆
        {ω | ¬(c ≤ X ω → m (X ω) = m₁ (X ω))} :=
      preimage_subset_null_of_disagree
        (fun (ω : Ω) (hω : X ω ∈ Set.Ioo c u) =>
          le_of_lt (Set.mem_Ioo.mp hω).1)
        huSub
    have hZero : μ (X ⁻¹' Set.Ioo c u) = 0 :=
      MeasureTheory.measure_mono_null hSubSet hNullR
    have hPos : 0 < u - c := by linarith
    have hEqU : c + (u - c) = u := by ring
    have hNeSup : μ (X ⁻¹' Set.Ioo c (c + (u - c))) ≠ 0 :=
      hright (u - c) hPos
    rw [hEqU] at hNeSup
    exact hNeSup hZero
  have haEq : a = m₀ c := by
    by_contra haNe
    have h0Tend : Filter.Tendsto m₀ (𝓝[<] c) (𝓝 (m₀ c)) :=
      tendsto_nhdsWithin_of_tendsto_nhds hcont₀.tendsto
    have hMem := mem_ne_of_tendsto_ne ha h0Tend haNe
    obtain ⟨u, huMem, huSub⟩ :=
      mem_nhdsLT_iff_exists_Ioo_subset.mp hMem
    have huc : u < c := huMem
    have hSubSet : X ⁻¹' Set.Ioo u c ⊆
        {ω | ¬(X ω < c → m (X ω) = m₀ (X ω))} :=
      preimage_subset_null_of_disagree
        (fun (ω : Ω) (hω : X ω ∈ Set.Ioo u c) => (Set.mem_Ioo.mp hω).2)
        huSub
    have hZero : μ (X ⁻¹' Set.Ioo u c) = 0 :=
      MeasureTheory.measure_mono_null hSubSet hNullL
    have hPos : 0 < c - u := by linarith
    have hEqU : c - (c - u) = u := by ring
    have hNeSup : μ (X ⁻¹' Set.Ioo (c - (c - u)) c) ≠ 0 :=
      hleft (c - u) hPos
    rw [hEqU] at hNeSup
    exact hNeSup hZero
  rw [hbEq, haEq]

end MathlibExt.Probability.Causality
