/-!
# Wald's second equation

If `X₁, X₂, …` are identically distributed real random variables with
`E[X₁] = 0` and `E[X₁²] < ∞`, and `T` is a stopping time (for a filtration
with respect to which each `Xₖ` is independent of the filtration at time
`k`, and `Xₖ` is measurable with respect to the filtration at time `k + 1`)
with `E[T] < ∞`, then
`E[S_T²] = E[X₁²] · E[T]`, where `S_T = ∑_{i < T} Xᵢ`.

## Source

This formalizes the target "Theorem (Wald's second equation)"
(Lecture 23, Stopping times section) of
`v1/Atlas/TheoryOfProbability/targets.yaml`: "Let `Xᵢ` be i.i.d. with
`EXᵢ = 0` and `EXᵢ² = σ² < ∞`. If `N` is a stopping time with `EN < ∞`
then `ES_N² = σ² EN`."

Its v1 formalization is `v1/Atlas/TheoryOfProbability/code/WaldSecondEquation.lean`
(`wald_second_equation`). That formalization is not complete: the final
step is left unproved, and the cross-term lemma it relies on assumes, as
extra hypotheses, the absolute summability of the cross terms
(`hsumm`) and a measurability condition (`haesm`) that are never
discharged. The cross-term absolute-summability and measurability hypotheses are
extra assumptions that v1 never discharges from the stated hypotheses.
The proof here is therefore new: it avoids the cross-term series
entirely.

The hypotheses are slightly weaker than the book's: v1 also assumed
`iIndepFun X μ`, but that hypothesis is not needed. The proof uses only
identical distribution (to move expectations between coordinates),
independence of each `Xₖ` from the filtration at time `k` (to factor
`E[Dₖ²]` and `E[Dⱼ Dₖ]`), and the adaptation hypothesis (to place the
earlier increments in `ℱₖ`).

## Main results

* `MeasureTheory.wald_second_equation`: `E[(∑_{i < T} Xᵢ)²] = E[X₀²] · E[T]`.

## Proof outline

Write `Dₖ = Xₖ · 1_{T > k}` for the increments of the stopped walk, so
that `S_{T ∧ n} = ∑_{k < n} Dₖ`. Independence of `Xₖ` from `ℱₖ` gives
`E[Dₖ²] = E[X₀²] · P(T > k)`, and measurability of the earlier increments
with respect to `ℱₖ` gives `E[Dⱼ Dₖ] = 0` for `j ≠ k` (the later factor
has mean zero and is independent of the `ℱₖ`-measurable part). Hence, for
every `n`,
`E[S_{T ∧ n}²] = E[X₀²] · E[T ∧ n]`, and similarly
`E[(S_{T ∧ N} - S_{T ∧ n})²] = E[X₀²] · (E[T ∧ N] - E[T ∧ n])`.
Fatou's lemma applied to `(S_{T ∧ N} - S_{T ∧ n})²` as `N → ∞` gives
`E[(S_T - S_{T ∧ n})²] ≤ E[X₀²] · (E[T] - E[T ∧ n]) → 0`, so the tail is
small in `L²`. The cross term `E[S_{T ∧ n} (S_T - S_{T ∧ n})]` vanishes:
it equals the finite orthogonality term `E[S_{T ∧ n} (S_{T ∧ N} - S_{T ∧ n})] = 0`
plus a tail term controlled by Cauchy–Schwarz. Finally
`E[S_T²] = E[S_{T ∧ n}²] + E[(S_T - S_{T ∧ n})²]`, and letting `n → ∞`
gives the result.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Finset ENNReal Topology

namespace MeasureTheory

/-- If `T : Ω → ℕ`, viewed as a `WithTop ℕ`-valued process, is a stopping time with
respect to a filtration `f`, then `T` is measurable (with respect to the ambient
`σ`-algebra). -/
private theorem waldSecond_measurable_T {Ω : Type*} {m : MeasurableSpace Ω}
    {f : Filtration ℕ m} {T : Ω → ℕ}
    (hT : IsStoppingTime f (fun ω => (T ω : WithTop ℕ))) :
    Measurable T := by
  apply measurable_to_nat
  intro ω
  exact (f.le (T ω)) _ (by convert hT.measurableSet_eq (T ω) using 1; ext x; simp)

/-- If a `σ`-algebra generated by `g : Ω → ℝ` is independent of a `σ`-algebra `m'`,
and `A` is `m'`-measurable, then `g` is independent of the indicator `1_A` (as
real-valued random variables). -/
private theorem waldSecond_indepFun_indicator_of_indep {Ω : Type*} {m : MeasurableSpace Ω}
    {μ : Measure Ω} {g : Ω → ℝ} {m' : MeasurableSpace Ω}
    (hindep : Indep (MeasurableSpace.comap g inferInstance) m' μ)
    {A : Set Ω} (hA : @MeasurableSet Ω m' A) :
    IndepFun g (Set.indicator A (fun _ => (1 : ℝ))) μ := by
  rw [IndepFun_iff_Indep]
  apply indep_of_indep_of_le_right hindep
  intro s hs
  obtain ⟨t, _, rfl⟩ := hs
  by_cases h1 : (1 : ℝ) ∈ t <;> by_cases h0 : (0 : ℝ) ∈ t
  · convert @MeasurableSet.univ Ω m'
    ext ω; simp [Set.indicator]; split_ifs <;> simp [*]
  · convert hA
    ext ω; simp [Set.indicator]; constructor
    · intro h; split_ifs at h with hmem <;> [exact hmem; exact absurd h h0]
    · intro hmem; simp [hmem, h1]
  · convert hA.compl
    ext ω; simp [Set.indicator]; constructor
    · intro h; split_ifs at h with hmem <;> [exact absurd h h1; exact hmem]
    · intro hmem; simp [show ¬(ω ∈ A) from hmem, h0]
  · convert @MeasurableSet.empty Ω m'
    ext ω; simp [Set.indicator]; split_ifs <;> simp [*]

/-- Cauchy–Schwarz for squares of integrals: if `f` and `g` are square-integrable,
then `(∫ f * g)² ≤ (∫ f²) * (∫ g²)`. Proved by the quadratic discriminant
argument, so no `eLpNorm` conversions are needed. -/
private theorem waldSecond_cauchy_schwarz_sq {Ω : Type*} {m : MeasurableSpace Ω}
    {μ : Measure Ω} {f g : Ω → ℝ} (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    (∫ ω, f ω * g ω ∂μ) ^ 2 ≤ (∫ ω, f ω ^ 2 ∂μ) * (∫ ω, g ω ^ 2 ∂μ) := by
  have hf2 : Integrable (fun ω => f ω ^ 2) μ :=
    (memLp_two_iff_integrable_sq hf.aestronglyMeasurable).mp hf
  have hg2 : Integrable (fun ω => g ω ^ 2) μ :=
    (memLp_two_iff_integrable_sq hg.aestronglyMeasurable).mp hg
  have hfg : Integrable (fun ω => f ω * g ω) μ := hf.integrable_mul hg
  set A := ∫ ω, f ω ^ 2 ∂μ with hA
  set B := ∫ ω, f ω * g ω ∂μ with hB
  set C := ∫ ω, g ω ^ 2 ∂μ with hC
  have hCnn : 0 ≤ C := integral_nonneg (fun ω => sq_nonneg _)
  have hexp : ∀ t : ℝ, 0 ≤ A + 2 * t * B + t ^ 2 * C := by
    intro t
    have hmem : MemLp (f + fun ω => t * g ω) 2 μ := hf.add (hg.const_smul t)
    have hsq : Integrable (fun ω => (f ω + t * g ω) ^ 2) μ :=
      (memLp_two_iff_integrable_sq hmem.aestronglyMeasurable).mp hmem
    have hnonneg : 0 ≤ ∫ ω, (f ω + t * g ω) ^ 2 ∂μ :=
      integral_nonneg (fun ω => sq_nonneg _)
    have heq : (fun ω => (f ω + t * g ω) ^ 2) =
        fun ω => f ω ^ 2 + (2 * t) * (f ω * g ω) + t ^ 2 * g ω ^ 2 := by
      funext ω; ring
    rw [heq] at hnonneg
    have eInt : ∫ ω, f ω ^ 2 + (2 * t) * (f ω * g ω) + t ^ 2 * g ω ^ 2 ∂μ =
        ∫ ω, f ω ^ 2 ∂μ + (2 * t) * ∫ ω, f ω * g ω ∂μ +
          t ^ 2 * ∫ ω, g ω ^ 2 ∂μ := by
      have e1 := integral_add (hf2.add (hfg.const_mul (2 * t))) (hg2.const_mul (t ^ 2))
      have e2 := integral_add hf2 (hfg.const_mul (2 * t))
      have e3 := integral_const_mul (μ := μ) (2 * t) (fun ω => f ω * g ω)
      have e4 := integral_const_mul (μ := μ) (t ^ 2) (fun ω => g ω ^ 2)
      exact e1.trans (congrArg (· + ∫ ω, t ^ 2 * g ω ^ 2 ∂μ) e2) |>.trans
        (congrArg (fun x => (∫ ω, f ω ^ 2 ∂μ + x) + ∫ ω, t ^ 2 * g ω ^ 2 ∂μ) e3) |>.trans
        (congrArg (fun x => (∫ ω, f ω ^ 2 ∂μ + (2 * t) * ∫ ω, f ω * g ω ∂μ) + x) e4)
    rw [eInt] at hnonneg
    exact hnonneg
  by_cases hC0 : C = 0
  · have hB0 : B = 0 := by
      by_contra hBne
      have ht := hexp (-(A + 1) / (2 * B))
      rw [hC0] at ht
      have hval : A + 2 * (-(A + 1) / (2 * B)) * B + (-(A + 1) / (2 * B)) ^ 2 * (0 : ℝ)
          = -1 := by
        field_simp
        ring
      rw [hval] at ht
      exact absurd ht (by norm_num)
    rw [hB0, hC0]
    simp
  · have hCpos : 0 < C := lt_of_le_of_ne hCnn (Ne.symm hC0)
    have ht := hexp (-B / C)
    have hval : A + 2 * (-B / C) * B + (-B / C) ^ 2 * C = A - B ^ 2 / C := by
      field_simp
      ring
    rw [hval] at ht
    have hle : B ^ 2 / C ≤ A := by linarith
    exact (div_le_iff₀ hCpos).mp hle

/-- The increment of the stopped walk: `Dₖ = Xₖ` while `k < T`, and `0` afterwards. -/
private noncomputable def waldStep {Ω : Type*} {X : ℕ → Ω → ℝ} {T : Ω → ℕ}
    (k : ℕ) (ω : Ω) : ℝ :=
  if k < T ω then X k ω else 0

/-- The partial sum `∑_{i < n} Xᵢ`. -/
private noncomputable def waldPartialSum {Ω : Type*} {X : ℕ → Ω → ℝ}
    (n : ℕ) (ω : Ω) : ℝ :=
  ∑ i ∈ Finset.range n, X i ω

/-- The stopped partial sum `S_{T ∧ n}`. -/
private noncomputable def waldStoppedSum {Ω : Type*} {X : ℕ → Ω → ℝ} {T : Ω → ℕ}
    (n : ℕ) (ω : Ω) : ℝ :=
  waldPartialSum (X := X) (min n (T ω)) ω

/-- The fully stopped sum `S_T`. -/
private noncomputable def waldStoppedLimit {Ω : Type*} {X : ℕ → Ω → ℝ} {T : Ω → ℕ}
    (ω : Ω) : ℝ :=
  waldPartialSum (X := X) (T ω) ω

/-- The stopped sum is the sum of the stopped increments:
`S_{T ∧ n} = ∑_{k < n} Dₖ`, pointwise. -/
private theorem waldSecond_stoppedSum_eq_sum_step {Ω : Type*}
    {X : ℕ → Ω → ℝ} {T : Ω → ℕ} (n : ℕ) (ω : Ω) :
    waldStoppedSum (X := X) (T := T) n ω =
      ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k ω := by
  induction n with
  | zero => simp [waldStoppedSum, waldPartialSum]
  | succ n ih =>
    rw [Finset.sum_range_succ, ← ih]
    by_cases h : n < T ω
    · have hmin1 : min (n + 1) (T ω) = n + 1 := by omega
      have hmin2 : min n (T ω) = n := by omega
      simp only [waldStoppedSum, hmin1, hmin2, waldPartialSum, Finset.sum_range_succ,
        waldStep, ite_eq_left h]
    · have hle : T ω ≤ n := Nat.le_of_not_gt h
      have hmin1 : min (n + 1) (T ω) = T ω := by omega
      have hmin2 : min n (T ω) = T ω := by omega
      simp only [waldStoppedSum, hmin1, hmin2, waldPartialSum, waldStep, ite_eq_right h,
        add_zero]

/-- Layer-cake for `min n T`, pointwise:
`min n T = ∑_{k < n} 1_{T > k}` (as real numbers). -/
private theorem waldSecond_min_eq_sum_indicator {Ω : Type*} {T : Ω → ℕ}
    (n : ℕ) (ω : Ω) :
    ((min n (T ω) : ℕ) : ℝ) =
      ∑ k ∈ Finset.range n, (if k < T ω then (1 : ℝ) else 0) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ, ← ih]
    by_cases h : n < T ω
    · have hmin1 : min (n + 1) (T ω) = n + 1 := by omega
      have hmin2 : min n (T ω) = n := by omega
      rw [hmin1, hmin2]
      simp only [ite_eq_left h]
      push_cast
      ring
    · have hle : T ω ≤ n := Nat.le_of_not_gt h
      have hmin1 : min (n + 1) (T ω) = T ω := by omega
      have hmin2 : min n (T ω) = T ω := by omega
      rw [hmin1, hmin2]
      simp only [ite_eq_right h, add_zero]

/-- **Wald's second equation.** Let $(\Omega, \mathbb{P})$ be a probability space with a filtration
$(\mathcal{F}_k)_{k \ge 0}$, and let $X_0, X_1, \dots$ be identically distributed real random
variables with $\mathbb{E}|X_0| < \infty$, $\mathbb{E}[X_0] = 0$ and $\mathbb{E}[X_0^2] < \infty$.
Let $T$ be an $\mathbb{N}$-valued stopping time for $(\mathcal{F}_k)$ with $\mathbb{E}[T] < \infty$.
Suppose each $X_k$ is independent of $\mathcal{F}_k$ and is $\mathcal{F}_{k+1}$-measurable. Then
$\mathbb{E}\big[\big(\sum_{i < T} X_i\big)^2\big] = \mathbb{E}[X_0^2] \cdot \mathbb{E}[T]$. -/
public theorem wald_second_equation
    {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
    {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_int : Integrable (X 0) μ)
    (hmean : ∫ ω, X 0 ω ∂μ = 0)
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ)
    {ℱ : Filtration ℕ m} {T : Ω → ℕ}
    (hT : IsStoppingTime ℱ (fun ω => (T ω : WithTop ℕ)))
    (hXf : ∀ k, Indep (MeasurableSpace.comap (X k) inferInstance) (ℱ k) μ)
    (hadapt : ∀ k, @Measurable Ω ℝ (ℱ (k + 1)) inferInstance (X k))
    (hT_int : Integrable (fun ω => (T ω : ℝ)) μ) :
    ∫ ω, (∑ i ∈ Finset.range (T ω), X i ω) ^ 2 ∂μ =
      (∫ ω, (X 0 ω) ^ 2 ∂μ) * (∫ ω, (T ω : ℝ) ∂μ) := by
  -- Basic measurability and integrability facts.
  have hT_meas : Measurable T := waldSecond_measurable_T hT
  have hmeas_gt : ∀ k, MeasurableSet {ω : Ω | k < T ω} :=
    fun k => hT_meas measurableSet_Ioi
  have hmeas_gt_filt : ∀ k, MeasurableSet[ℱ k] {ω : Ω | k < T ω} := by
    intro k
    convert hT.measurableSet_gt (k : ℕ) using 2
    ext ω
    simp
  have hmeas_X : ∀ k, Measurable (X k) :=
    fun k => (hadapt k).mono (ℱ.le (k + 1)) le_rfl
  have haesm_X : ∀ k, AEStronglyMeasurable (X k) μ :=
    fun k => (hmeas_X k).aestronglyMeasurable
  have hint_X : ∀ k, Integrable (X k) μ :=
    fun k => (hX_iid k 0).integrable_iff.mpr hX_int
  have hmean_X : ∀ k, ∫ ω, X k ω ∂μ = 0 := by
    intro k
    rw [(hX_iid k 0).integral_eq]
    exact hmean
  have hint_sq_X : ∀ k, Integrable (fun ω => (X k ω) ^ 2) μ := by
    intro k
    have hcomp : IdentDistrib (fun ω => (X k ω) ^ 2) (fun ω => (X 0 ω) ^ 2) μ μ :=
      (hX_iid k 0).comp (measurable_id.pow_const 2)
    exact hcomp.integrable_iff.mpr hX_sq_int
  have hmean_sq_X : ∀ k, ∫ ω, (X k ω) ^ 2 ∂μ = ∫ ω, (X 0 ω) ^ 2 ∂μ := by
    intro k
    have hcomp : IdentDistrib (fun ω => (X k ω) ^ 2) (fun ω => (X 0 ω) ^ 2) μ μ :=
      (hX_iid k 0).comp (measurable_id.pow_const 2)
    exact hcomp.integral_eq
  -- The stopped increments and their basic properties.
  have hstep_eq_indicator : ∀ k, waldStep (X := X) (T := T) k =
      Set.indicator {ω : Ω | k < T ω} (X k) := by
    intro k
    funext ω
    by_cases h : k < T ω <;> simp [waldStep, Set.indicator, h]
  have hmeas_step : ∀ k, Measurable (waldStep (X := X) (T := T) k) := by
    intro k
    rw [hstep_eq_indicator k]
    exact (hmeas_X k).indicator (hmeas_gt k)
  have haesm_step : ∀ k, AEStronglyMeasurable (waldStep (X := X) (T := T) k) μ := by
    intro k
    rw [hstep_eq_indicator k]
    exact (haesm_X k).indicator (hmeas_gt k)
  have hmeas_step_filt : ∀ {j k : ℕ}, j + 1 ≤ k →
      @Measurable Ω ℝ (ℱ k) inferInstance (waldStep (X := X) (T := T) j) := by
    intro j k hjk
    rw [hstep_eq_indicator j]
    apply Measurable.indicator _ (ℱ.mono (by omega : j ≤ k) _ (hmeas_gt_filt j))
    exact (hadapt j).mono (ℱ.mono hjk) le_rfl
  have hmeas_stoppedSum : ∀ n, Measurable (waldStoppedSum (X := X) (T := T) n) := by
    intro n
    have hfun : waldStoppedSum (X := X) (T := T) n =
        fun ω => ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k ω := by
      funext ω
      exact waldSecond_stoppedSum_eq_sum_step (X := X) (T := T) n ω
    rw [hfun]
    exact Finset.measurable_sum _ (fun k _ => hmeas_step k)
  have hmeas_stoppedLimit : Measurable (waldStoppedLimit (X := X) (T := T)) := by
    apply measurable_of_tendsto_metrizable (fun n => hmeas_stoppedSum n)
    rw [tendsto_pi_nhds]
    intro ω
    apply Filter.Tendsto.congr' _ tendsto_const_nhds
    filter_upwards [eventually_ge_atTop (T ω)] with N hN
    have hmin : min N (T ω) = T ω := by omega
    simp only [waldStoppedLimit, waldStoppedSum, hmin]
  -- `E[Dₖ²] = E[X₀²] · P(T > k)`.
  have hint_sq_step : ∀ k, Integrable (fun ω => (waldStep (X := X) (T := T) k ω) ^ 2) μ := by
    intro k
    have hsq : (fun ω => (waldStep (X := X) (T := T) k ω) ^ 2) =
        Set.indicator {ω : Ω | k < T ω} (fun ω => (X k ω) ^ 2) := by
      funext ω
      by_cases h : k < T ω <;> simp [waldStep, Set.indicator, h]
    rw [hsq]
    exact (hint_sq_X k).indicator (hmeas_gt k)
  have hmemLp_step : ∀ k, MemLp (waldStep (X := X) (T := T) k) 2 μ :=
    fun k => (memLp_two_iff_integrable_sq (haesm_step k)).mpr (hint_sq_step k)
  have hint_sq_D : ∀ k, ∫ ω, (waldStep (X := X) (T := T) k ω) ^ 2 ∂μ =
      (∫ ω, (X 0 ω) ^ 2 ∂μ) * (μ {ω : Ω | k < T ω}).toReal := by
    intro k
    have hsq : (fun ω => (waldStep (X := X) (T := T) k ω) ^ 2) =
        fun ω => (Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)) ω) *
          (X k ω) ^ 2 := by
      funext ω
      by_cases h : k < T ω <;> simp [waldStep, Set.indicator, h]
    rw [hsq]
    have hindep_sq : Indep (MeasurableSpace.comap (fun ω => (X k ω) ^ 2) inferInstance)
        (ℱ k) μ := by
      apply indep_of_indep_of_le_left (hXf k)
      intro s hs
      obtain ⟨t, ht, hts⟩ := hs
      exact ⟨(fun x : ℝ => x ^ 2) ⁻¹' t, (measurable_id.pow_const 2) ht, hts⟩
    have hindep : IndepFun (Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)))
        (fun ω => (X k ω) ^ 2) μ :=
      (waldSecond_indepFun_indicator_of_indep hindep_sq (hmeas_gt_filt k)).symm
    have haesm_ind : AEStronglyMeasurable
        (Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ))) μ :=
      aestronglyMeasurable_const.indicator (hmeas_gt k)
    have haesm_sq : AEStronglyMeasurable (fun ω => (X k ω) ^ 2) μ :=
      (hint_sq_X k).aestronglyMeasurable
    rw [hindep.integral_fun_mul_eq_mul_integral haesm_ind haesm_sq,
      integral_indicator_const (1 : ℝ) (hmeas_gt k), smul_eq_mul, mul_one,
      hmean_sq_X k]
    simp only [Measure.real]
    rw [mul_comm]
  -- `E[Dⱼ Dₖ] = 0` for `j < k`.
  have hcross : ∀ {j k : ℕ}, j < k →
      ∫ ω, waldStep (X := X) (T := T) j ω * waldStep (X := X) (T := T) k ω ∂μ = 0 := by
    intro j k hjk
    have hprod : (fun ω => waldStep (X := X) (T := T) j ω *
        waldStep (X := X) (T := T) k ω) =
        fun ω => (waldStep (X := X) (T := T) j ω *
          Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)) ω) * X k ω := by
      funext ω
      by_cases h : k < T ω <;> simp [waldStep, Set.indicator, h]
    rw [hprod]
    have hmeas_g : @Measurable Ω ℝ (ℱ k) inferInstance
        (fun ω => waldStep (X := X) (T := T) j ω *
          Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)) ω) := by
      apply Measurable.mul (hmeas_step_filt (by omega : j + 1 ≤ k))
      exact (measurable_const.indicator (hmeas_gt_filt k))
    have hindep : IndepFun (fun ω => waldStep (X := X) (T := T) j ω *
          Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)) ω) (X k) μ := by
      rw [IndepFun_iff_Indep]
      have hcomap : MeasurableSpace.comap (fun ω => waldStep (X := X) (T := T) j ω *
          Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)) ω) inferInstance ≤ ℱ k :=
        measurable_iff_comap_le.mp hmeas_g
      exact (indep_of_indep_of_le_right (hXf k) hcomap).symm
    have haesm_g : AEStronglyMeasurable (fun ω => waldStep (X := X) (T := T) j ω *
        Set.indicator {ω : Ω | k < T ω} (fun _ => (1 : ℝ)) ω) μ :=
      (hmeas_g.mono (ℱ.le k) le_rfl).aestronglyMeasurable
    rw [hindep.integral_fun_mul_eq_mul_integral haesm_g (haesm_X k),
