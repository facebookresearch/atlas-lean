        intro k hk
        have hjk : j < k := by
          have hj' : j < n := Finset.mem_range.mp hj
          have hk' : n ≤ k := (Finset.mem_Ico.mp hk).1
          omega
        exact hcross hjk
      exact h1
    -- The tail cross term is controlled by Cauchy–Schwarz.
    have htail_cross_tendsto : Tendsto (fun N => ∫ ω,
        waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) N ω) ∂μ) atTop (𝓝 0) := by
      have hbound : ∀ N, |∫ ω, waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) N ω) ∂μ| ≤
          Real.sqrt ((∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) *
            (∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) N ω) ^ 2 ∂μ)) := by
        intro N
        have hmem_n : MemLp (waldStoppedSum (X := X) (T := T) n) 2 μ := by
          have hfun : waldStoppedSum (X := X) (T := T) n =
              ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          rw [hfun]
          exact (hsum (Finset.range n)).1
        have hmem_N : MemLp (waldStoppedSum (X := X) (T := T) N) 2 μ := by
          have hfun : waldStoppedSum (X := X) (T := T) N =
              ∑ k ∈ Finset.range N, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          rw [hfun]
          exact (hsum (Finset.range N)).1
        have hmem_diff : MemLp (fun ω => waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) N ω) 2 μ := hmemLp_limit.sub hmem_N
        have hCS := waldSecond_cauchy_schwarz_sq (μ := μ) hmem_n hmem_diff
        have hsq : Real.sqrt ((∫ ω, waldStoppedSum (X := X) (T := T) n ω *
            (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) N ω) ∂μ) ^ 2) ≤
              Real.sqrt ((∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) *
                (∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
                  waldStoppedSum (X := X) (T := T) N ω) ^ 2 ∂μ)) :=
          Real.sqrt_le_sqrt hCS
        rwa [Real.sqrt_sq_eq_abs] at hsq
      have hsqrt_tendsto : Tendsto (fun N => Real.sqrt
          ((∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) *
            (∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) N ω) ^ 2 ∂μ))) atTop (𝓝 0) := by
        have hmul : Tendsto (fun N => (∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) *
            (∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) N ω) ^ 2 ∂μ)) atTop (𝓝 0) := by
          have h0 : (0 : ℝ) = (∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) * 0 := by
            simp
          rw [h0]
          exact tendsto_const_nhds.mul htendsto_tail
        have h := (Real.continuous_sqrt.tendsto 0).comp hmul
        rw [Real.sqrt_zero] at h
        exact h
      have hneg : Tendsto (fun N => -Real.sqrt
          ((∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) *
            (∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) N ω) ^ 2 ∂μ))) atTop (𝓝 0) := by
        simpa using hsqrt_tendsto.neg
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le hneg hsqrt_tendsto
        (fun N => neg_le_of_abs_le (hbound N)) (fun N => le_of_abs_le (hbound N))
    -- The total cross term is the sum of the finite and tail terms.
    have hEq : (fun _ : ℕ => ∫ ω, waldStoppedSum (X := X) (T := T) n ω *
        (waldStoppedLimit (X := X) (T := T) ω -
          waldStoppedSum (X := X) (T := T) n ω) ∂μ) =ᶠ[atTop]
        (fun N => ∫ ω, waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) N ω) ∂μ) := by
      filter_upwards [eventually_ge_atTop n] with N hN
      have hint1 : Integrable (fun ω => waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedSum (X := X) (T := T) N ω -
            waldStoppedSum (X := X) (T := T) n ω)) μ := by
        have hmem_n : MemLp (waldStoppedSum (X := X) (T := T) n) 2 μ := by
          have hfun : waldStoppedSum (X := X) (T := T) n =
              ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          rw [hfun]
          exact (hsum (Finset.range n)).1
        have hmem_diff : MemLp (fun ω => waldStoppedSum (X := X) (T := T) N ω -
            waldStoppedSum (X := X) (T := T) n ω) 2 μ := by
          have hfunN : waldStoppedSum (X := X) (T := T) N =
              ∑ k ∈ Finset.range N, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          have hfun_n : waldStoppedSum (X := X) (T := T) n =
              ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          have h1 : MemLp (waldStoppedSum (X := X) (T := T) N) 2 μ := by
            rw [hfunN]; exact (hsum (Finset.range N)).1
          have h2 : MemLp (waldStoppedSum (X := X) (T := T) n) 2 μ := by
            rw [hfun_n]; exact (hsum (Finset.range n)).1
          exact h1.sub h2
        exact hmem_n.integrable_mul hmem_diff
      have hint2 : Integrable (fun ω => waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) N ω)) μ := by
        have hmem_n : MemLp (waldStoppedSum (X := X) (T := T) n) 2 μ := by
          have hfun : waldStoppedSum (X := X) (T := T) n =
              ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          rw [hfun]
          exact (hsum (Finset.range n)).1
        have hmem_N : MemLp (waldStoppedSum (X := X) (T := T) N) 2 μ := by
          have hfun : waldStoppedSum (X := X) (T := T) N =
              ∑ k ∈ Finset.range N, waldStep (X := X) (T := T) k := by
            funext ω
            rw [waldSecond_stoppedSum_eq_sum_step]
            simp [Finset.sum_apply]
          rw [hfun]
          exact (hsum (Finset.range N)).1
        have hmem_diff : MemLp (fun ω => waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) N ω) 2 μ := hmemLp_limit.sub hmem_N
        exact hmem_n.integrable_mul hmem_diff
      have hsplit : (fun ω => waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω)) =
          fun ω => waldStoppedSum (X := X) (T := T) n ω *
            (waldStoppedSum (X := X) (T := T) N ω -
              waldStoppedSum (X := X) (T := T) n ω) +
            waldStoppedSum (X := X) (T := T) n ω *
              (waldStoppedLimit (X := X) (T := T) ω -
                waldStoppedSum (X := X) (T := T) N ω) := by
        funext ω; ring
      rw [hsplit]
      exact (integral_add hint1 hint2).trans (by rw [hfinite_cross hN]; simp)
    have hconst : Tendsto (fun _ : ℕ => ∫ ω, waldStoppedSum (X := X) (T := T) n ω *
        (waldStoppedLimit (X := X) (T := T) ω -
          waldStoppedSum (X := X) (T := T) n ω) ∂μ) atTop (𝓝 0) :=
      Filter.Tendsto.congr' hEq.symm htail_cross_tendsto
    exact tendsto_const_nhds_iff.mp hconst
  -- Assemble: `E[S_T²] = E[S_{T ∧ n}²] + E[(S_T - S_{T ∧ n})²]` for every `n`,
  -- then let `n → ∞`.
  have hdecomp : ∀ n, ∫ ω, (waldStoppedLimit (X := X) (T := T) ω) ^ 2 ∂μ =
      ∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ +
        ∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
          waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ := by
    intro n
    have hmem_n : MemLp (waldStoppedSum (X := X) (T := T) n) 2 μ := by
      have hfun : waldStoppedSum (X := X) (T := T) n =
          ∑ k ∈ Finset.range n, waldStep (X := X) (T := T) k := by
        funext ω
        rw [waldSecond_stoppedSum_eq_sum_step]
        simp [Finset.sum_apply]
      rw [hfun]
      exact (hsum (Finset.range n)).1
    have hmem_diff : MemLp (fun ω => waldStoppedLimit (X := X) (T := T) ω -
        waldStoppedSum (X := X) (T := T) n ω) 2 μ := hmemLp_limit.sub hmem_n
    have hsq_n : Integrable (fun ω => (waldStoppedSum (X := X) (T := T) n ω) ^ 2) μ :=
      (memLp_two_iff_integrable_sq hmem_n.aestronglyMeasurable).mp hmem_n
    have hsq_diff : Integrable (fun ω => (waldStoppedLimit (X := X) (T := T) ω -
        waldStoppedSum (X := X) (T := T) n ω) ^ 2) μ := (htail_bound n).1
    have hprod : Integrable (fun ω => waldStoppedSum (X := X) (T := T) n ω *
        (waldStoppedLimit (X := X) (T := T) ω -
          waldStoppedSum (X := X) (T := T) n ω)) μ :=
      hmem_n.integrable_mul hmem_diff
    have hexp : (fun ω => (waldStoppedLimit (X := X) (T := T) ω) ^ 2) =
        fun ω => (waldStoppedSum (X := X) (T := T) n ω) ^ 2 +
          2 * (waldStoppedSum (X := X) (T := T) n ω *
            (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) n ω)) +
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω) ^ 2 := by
      funext ω; ring
    have eInt : ∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 +
        2 * (waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω)) +
        (waldStoppedLimit (X := X) (T := T) ω -
          waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ =
        ∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ +
          2 * ∫ ω, waldStoppedSum (X := X) (T := T) n ω *
            (waldStoppedLimit (X := X) (T := T) ω -
              waldStoppedSum (X := X) (T := T) n ω) ∂μ +
          ∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ := by
      have e1 := integral_add (hsq_n.add (hprod.const_mul 2)) hsq_diff
      have e2 := integral_add hsq_n (hprod.const_mul 2)
      have e3 := integral_const_mul (μ := μ) (2 : ℝ)
        (fun ω => waldStoppedSum (X := X) (T := T) n ω *
          (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω))
      exact e1.trans (congrArg (· + ∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
          waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) e2) |>.trans
        (congrArg (fun x => (∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ + x) +
          ∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) e3)
    rw [hexp, eInt, hcross_zero n]
    ring
  have htotal : Tendsto (fun n : ℕ => ∫ ω, (waldStoppedLimit (X := X) (T := T) ω) ^ 2 ∂μ)
      atTop (𝓝 ((∫ ω, (X 0 ω) ^ 2 ∂μ) * (∫ ω, (T ω : ℝ) ∂μ))) := by
    have hsum_tendsto : Tendsto (fun n => ∫ ω,
        (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ +
          ∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) atTop
        (𝓝 ((∫ ω, (X 0 ω) ^ 2 ∂μ) * (∫ ω, (T ω : ℝ) ∂μ) + 0)) := by
      apply Tendsto.add _ htendsto_tail
      have hEq : (fun n => ∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ) =
          fun n => (∫ ω, (X 0 ω) ^ 2 ∂μ) * ∫ ω, ((min n (T ω) : ℕ) : ℝ) ∂μ :=
        funext hsq_stopped
      rw [hEq]
      have hmul : Tendsto (fun n => (∫ ω, (X 0 ω) ^ 2 ∂μ) *
          ∫ ω, ((min n (T ω) : ℕ) : ℝ) ∂μ) atTop
          (𝓝 ((∫ ω, (X 0 ω) ^ 2 ∂μ) * (∫ ω, (T ω : ℝ) ∂μ))) :=
        tendsto_const_nhds.mul htendsto_min
      exact hmul
    have hEq : (fun _ : ℕ => ∫ ω, (waldStoppedLimit (X := X) (T := T) ω) ^ 2 ∂μ) =
        fun n => ∫ ω, (waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ +
          ∫ ω, (waldStoppedLimit (X := X) (T := T) ω -
            waldStoppedSum (X := X) (T := T) n ω) ^ 2 ∂μ := funext (fun n => hdecomp n)
    rw [hEq]
    simpa using hsum_tendsto
  have hfinal : ∫ ω, (waldStoppedLimit (X := X) (T := T) ω) ^ 2 ∂μ =
      (∫ ω, (X 0 ω) ^ 2 ∂μ) * (∫ ω, (T ω : ℝ) ∂μ) :=
    tendsto_const_nhds_iff.mp htotal
  have hGoal : (fun ω => (∑ i ∈ Finset.range (T ω), X i ω) ^ 2) =
      fun ω => (waldStoppedLimit (X := X) (T := T) ω) ^ 2 := by
    funext ω
    rfl
  rw [hGoal]
  exact hfinal

end MeasureTheory
