section Matrix

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- **The conditional covariance is the inverse of a precision block**: for positive definite `S`
on `ι ⊕ κ`, `S₁₁ - S₁₂ S₂₂⁻¹ S₂₁ = ((S⁻¹)₁₁)⁻¹`. -/
theorem inv_toBlocks₁₁_inv {S : Matrix (ι ⊕ κ) (ι ⊕ κ) ℝ} (hS : S.PosDef) :
    (S⁻¹.toBlocks₁₁)⁻¹ = S.toBlocks₁₁ - S.toBlocks₁₂ * S.toBlocks₂₂⁻¹ * S.toBlocks₂₁ := by
  let := hS.isUnit.invertible
  have hD : S.toBlocks₂₂.PosDef := hS.submatrix Sum.inr_injective
  let := hD.isUnit.invertible
  let : Invertible
      (fromBlocks S.toBlocks₁₁ S.toBlocks₁₂ S.toBlocks₂₁ S.toBlocks₂₂) :=
    Invertible.copy ‹Invertible S› _ (fromBlocks_toBlocks S)
  let := invertibleOfFromBlocks₂₂Invertible
    S.toBlocks₁₁ S.toBlocks₁₂ S.toBlocks₂₁ S.toBlocks₂₂
  have h := invOf_fromBlocks₂₂_eq
    S.toBlocks₁₁ S.toBlocks₁₂ S.toBlocks₂₁ S.toBlocks₂₂
  simp only [invOf_eq_nonsing_inv, fromBlocks_toBlocks] at h
  have hblock := congrArg Matrix.toBlocks₁₁ h
  simp only [toBlocks_fromBlocks₁₁] at hblock
  rw [hblock]
  simpa only [invOf_eq_nonsing_inv] using
    inv_inv_of_invertible (S.toBlocks₁₁ - S.toBlocks₁₂ * ⅟S.toBlocks₂₂ * S.toBlocks₂₁)

/-- The partial correlation of coordinates `0` and `1` given the `κ`-block, computed from the
conditional covariance `C = S₁₁ - S₁₂ S₂₂⁻¹ S₂₁`: `C₀₁ / √(C₀₀ C₁₁)`. -/
noncomputable def partialCorrelation (S : Matrix (Fin 2 ⊕ κ) (Fin 2 ⊕ κ) ℝ) : ℝ :=
  let C := S.toBlocks₁₁ - S.toBlocks₁₂ * S.toBlocks₂₂⁻¹ * S.toBlocks₂₁
  C 0 1 / √(C 0 0 * C 1 1)

/-- The partial correlation from the precision matrix: `ρ₁₂·rest = -Ω₀₁ / √(Ω₀₀ Ω₁₁)`. -/
theorem partialCorrelation_eq {S : Matrix (Fin 2 ⊕ κ) (Fin 2 ⊕ κ) ℝ} (hS : S.PosDef) :
    partialCorrelation S =
      -S⁻¹ (.inl 0) (.inl 1) / √(S⁻¹ (.inl 0) (.inl 0) * S⁻¹ (.inl 1) (.inl 1)) := by
  let A := S⁻¹.toBlocks₁₁
  have hA : A.PosDef := hS.inv.submatrix Sum.inl_injective
  have hd : 0 < A.det := hA.det_pos
  unfold partialCorrelation
  rw [← inv_toBlocks₁₁_inv hS]
  change A⁻¹ 0 1 / √(A⁻¹ 0 0 * A⁻¹ 1 1) = -A 0 1 / √(A 0 0 * A 1 1)
  have he : A⁻¹ = A.det⁻¹ • !![A 1 1, -A 0 1; -A 1 0, A 0 0] := by
    rw [inv_def, Ring.inverse_eq_inv, adjugate_fin_two]
  rw [he]
  simp only [Matrix.smul_apply, smul_eq_mul, of_apply, cons_val_zero, cons_val_one]
  have hden : √((A.det⁻¹ * A 1 1) * (A.det⁻¹ * A 0 0)) =
      A.det⁻¹ * √(A 0 0 * A 1 1) := by
    rw [show (A.det⁻¹ * A 1 1) * (A.det⁻¹ * A 0 0) =
      A.det⁻¹ ^ 2 * (A 0 0 * A 1 1) by ring,
      sqrt_mul (sq_nonneg _), sqrt_sq (inv_pos.mpr hd).le]
  rw [hden]
  field_simp

end Matrix

section CondIndep

variable {κ : Type*}

/-- The `κ`-block (the conditioning coordinates) of a vector on `Fin 2 ⊕ κ`. -/
noncomputable def rest (v : EuclideanSpace ℝ (Fin 2 ⊕ κ)) : EuclideanSpace ℝ κ :=
  toLp 2 fun j => v (.inr j)

/-- The `κ`-block is a measurable function of the vector. -/
theorem measurable_rest [Finite κ] : Measurable (rest (κ := κ)) := by
  classical
  have := Fintype.ofFinite κ
  apply Continuous.measurable
  exact (PiLp.continuous_toLp 2 _).comp
    (continuous_pi fun j => (PiLp.continuous_apply 2 _ (Sum.inr j)))

variable [Fintype κ] [DecidableEq κ]
  {Ω : Type*} {mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P]

private theorem gaussian_coords_indep_iff (μ : EuclideanSpace ℝ (Fin 2))
    {C : Matrix (Fin 2) (Fin 2) ℝ} (hC : C.PosSemidef) :
    IndepFun (fun z : EuclideanSpace ℝ (Fin 2) => z 0) (fun z => z 1)
      (multivariateGaussian μ C) ↔ C 0 1 = 0 := by
  let L : EuclideanSpace ℝ (Fin 2) →L[ℝ] ℝ × ℝ :=
    (EuclideanSpace.proj (𝕜 := ℝ) 0).prod (EuclideanSpace.proj (𝕜 := ℝ) 1)
  have hg : HasGaussianLaw (fun z : EuclideanSpace ℝ (Fin 2) => (z 0, z 1))
      (multivariateGaussian μ C) := IsGaussian.hasGaussianLaw_id.map_fun L
  have hcov : cov[fun z : EuclideanSpace ℝ (Fin 2) => z 0, fun z => z 1;
      multivariateGaussian μ C] = C 0 1 := by
    have h := covariance_inner_of_map_eq (μ := μ) measurable_id hC Measure.map_id
      (EuclideanSpace.basisFun (Fin 2) ℝ 0) (EuclideanSpace.basisFun (Fin 2) ℝ 1)
    simp only [EuclideanSpace.basisFun_inner] at h
    simpa [EuclideanSpace.basisFun_apply,
      PiLp.ofLp_single, dotProduct, mulVec, Fin.sum_univ_two] using h
  constructor
  · intro h
    rw [← hcov]
    exact h.covariance_eq_zero hg.fst.memLp_two hg.snd.memLp_two
  · intro h
    exact hg.indepFun_of_covariance_eq_zero (hcov.trans h)

private theorem condIndep_coords_iff {Ω κ : Type*} [MeasurableSpace Ω]
    [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {X : Ω → EuclideanSpace ℝ (Fin 2)} {Y : Ω → EuclideanSpace ℝ κ}
    (hX : Measurable X) (hY : Measurable Y) :
    ((fun ω => X ω 0) ⟂ᵢ[Y, hY; P] (fun ω => X ω 1)) ↔
      ∀ᵐ y ∂P.map Y, IndepFun (fun z : EuclideanSpace ℝ (Fin 2) => z 0)
        (fun z => z 1) (condDistrib X Y P y) := by
  let f : EuclideanSpace ℝ (Fin 2) → ℝ := fun z => z 0
  let g : EuclideanSpace ℝ (Fin 2) → ℝ := fun z => z 1
  have hf : Measurable f := (PiLp.continuous_apply 2 _ 0).measurable
  have hg : Measurable g := (PiLp.continuous_apply 2 _ 1).measurable
  have hpair := condDistrib_comp (μ := P) hY.aemeasurable hX.aemeasurable (hf.prodMk hg)
  have hfst := condDistrib_comp (μ := P) hY.aemeasurable hX.aemeasurable hf
  have hsnd := condDistrib_comp (μ := P) hY.aemeasurable hX.aemeasurable hg
  change ((f ∘ X) ⟂ᵢ[Y, hY; P] (g ∘ X)) ↔ _
  rw [condIndepFun_iff_map_prod_eq_prod_condDistrib_prod_condDistrib
    (hf.comp hX) (hg.comp hX) hY, ← Measure.compProd_eq_comp_prod,
    ← condDistrib_ae_eq_iff_measure_eq_compProd hY.aemeasurable
      ((hf.comp hX).prodMk (hg.comp hX)).aemeasurable]
  apply Filter.eventually_congr
  filter_upwards [hpair, hfst, hsnd] with y hp hf' hg'
  change condDistrib ((fun z => (f z, g z)) ∘ X) Y P y =
    (condDistrib (f ∘ X) Y P ×ₖ condDistrib (g ∘ X) Y P) y ↔ _
  rw [hp, Kernel.prod_apply, hf', hg', Kernel.map_apply _ (hf.prodMk hg),
    Kernel.map_apply _ hf, Kernel.map_apply _ hg]
  exact (indepFun_iff_map_prod_eq_prod_map_map hf.aemeasurable hg.aemeasurable).symm

/-- **Pairwise Markov property of Gaussian vectors**: if `V = (X₀, X₁, Y) ~ N(μ, S)` with `S`
positive definite, then `X₀` and `X₁` are conditionally independent given `Y` iff
`(S⁻¹)₀₁ = 0`. (The standard Borel sample space is the setting of Mathlib's conditional
independence.) -/
theorem condIndepFun_iff_inv_apply_eq_zero {V : Ω → EuclideanSpace ℝ (Fin 2 ⊕ κ)}
    (hV : Measurable V) {μ : EuclideanSpace ℝ (Fin 2 ⊕ κ)} {S : Matrix (Fin 2 ⊕ κ) (Fin 2 ⊕ κ) ℝ}
    (hS : S.PosDef) (hlaw : P.map V = multivariateGaussian μ S) :
    ((fun ω => V ω (.inl 0)) ⟂ᵢ[fun ω => rest (V ω), measurable_rest.comp hV; P]
      (fun ω => V ω (.inl 1))) ↔ S⁻¹ (.inl 0) (.inl 1) = 0 := by
  let X : Ω → EuclideanSpace ℝ (Fin 2) :=
    fun ω => toEuclideanLin (blockRow (1 : Matrix (Fin 2) (Fin 2) ℝ) 0) (V ω)
  let Y : Ω → EuclideanSpace ℝ κ := fun ω => rest (V ω)
  have hX : Measurable X := (continuous_toEuclideanLin _).measurable.comp hV
  have hY : Measurable Y := measurable_rest.comp hV
  have hXcoord : ∀ ω i, X ω i = V ω (.inl i) := by
    intro ω i
    fin_cases i <;>
      simp [X, blockRow, toEuclideanLin, toLpLin, mulVec, dotProduct,
        Fintype.sum_sum_type, Matrix.one_apply]
  have hYeq : Y = fun ω =>
      toEuclideanLin (blockRow (0 : Matrix κ (Fin 2) ℝ) 1) (V ω) := by
    funext ω
    apply WithLp.ofLp_injective
    ext j
    simp [Y, rest, blockRow, toEuclideanLin, toLpLin, mulVec, dotProduct,
      Fintype.sum_sum_type, Matrix.one_apply]
  let C := S.toBlocks₁₁ - S.toBlocks₁₂ * S.toBlocks₂₂⁻¹ * S.toBlocks₂₁
  have hC : C.PosDef := by
    rw [show C = (S⁻¹.toBlocks₁₁)⁻¹ from (inv_toBlocks₁₁_inv hS).symm]
    exact (hS.inv.submatrix Sum.inl_injective).inv
  have hD : S.toBlocks₂₂.PosDef := hS.submatrix Sum.inr_injective
  have hcd := condDistrib_multivariateGaussian hV hS.posSemidef hlaw
    (isUnit_iff_ne_zero.mpr hD.det_pos.ne')
  rw [← hYeq] at hcd
  have hcriterion := condIndep_coords_iff (P := P) hX hY
  simp only [hXcoord] at hcriterion
  change ((fun ω => V ω (.inl 0)) ⟂ᵢ[Y, hY; P] (fun ω => V ω (.inl 1))) ↔ _ at hcriterion
  rw [hcriterion]
  have hconst : (∀ᵐ y ∂P.map Y, IndepFun
      (fun z : EuclideanSpace ℝ (Fin 2) => z 0) (fun z => z 1)
      (condDistrib X Y P y)) ↔ C 0 1 = 0 := by
    have hiff : (∀ᵐ y ∂P.map Y, IndepFun
        (fun z : EuclideanSpace ℝ (Fin 2) => z 0) (fun z => z 1)
        (condDistrib X Y P y)) ↔ ∀ᵐ _y ∂P.map Y, C 0 1 = 0 := by
      apply Filter.eventually_congr
      filter_upwards [hcd] with y hy
      rw [hy]
      exact gaussian_coords_indep_iff _ hC.posSemidef
    have : IsProbabilityMeasure (P.map Y) :=
      (Measure.isProbabilityMeasure_map_iff hY.aemeasurable).2 inferInstance
    simpa using hiff
  rw [hconst]
  rw [show C = (S⁻¹.toBlocks₁₁)⁻¹ from (inv_toBlocks₁₁_inv hS).symm]
  let A := S⁻¹.toBlocks₁₁
  have hA : A.PosDef := hS.inv.submatrix Sum.inl_injective
  change A⁻¹ 0 1 = 0 ↔ A 0 1 = 0
  rw [inv_def, Ring.inverse_eq_inv, adjugate_fin_two]
  simp [Matrix.smul_apply, hA.det_pos.ne']

end CondIndep

section Dempster

variable {ι : Type*} [Fintype ι]

/-- The sample second-moment matrix `m⁻¹ ∑ₛ xₛ xₛᵀ` of `m` observations in `ℝ^ι`. -/
noncomputable def sampleCov {m : ℕ} (x : Fin m → ι → ℝ) : Matrix ι ι ℝ :=
  (m : ℝ)⁻¹ • ∑ s, vecMulVec (x s) (x s)

/-- The quadratic forms of a sample add up to `m · tr (S K)`. -/
theorem sum_dotProduct_mulVec_eq {m : ℕ} (hm : 0 < m) (x : Fin m → ι → ℝ) (K : Matrix ι ι ℝ) :
    ∑ s, x s ⬝ᵥ K *ᵥ x s = m * (sampleCov x * K).trace := by
  classical
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hm)
  rw [sampleCov, smul_mul, trace_smul, Matrix.sum_mul, trace_sum, smul_eq_mul,
    ← mul_assoc, mul_inv_cancel₀ hm', one_mul]
  apply Finset.sum_congr rfl
  intro s _
  rw [vecMulVec_mul, trace_vecMulVec, dotProduct_mulVec]
  exact dotProduct_comm _ _

variable [DecidableEq ι]

/-- The Gaussian log-likelihood objective `log det K - tr (S K)` of a precision matrix `K`. -/
noncomputable def gaussLogLik (S K : Matrix ι ι ℝ) : ℝ := log K.det - (S * K).trace

/-- A matrix vanishes off the edges of `G`: `K i j = 0` for distinct non-adjacent `i, j`. -/
def IsSupportedOn (G : SimpleGraph ι) (K : Matrix ι ι ℝ) : Prop :=
  ∀ i j, i ≠ j → ¬ G.Adj i j → K i j = 0

private theorem trace_eq_of_supported {ι : Type*} [Fintype ι] [DecidableEq ι]
    {G : SimpleGraph ι} {S K₀ K : Matrix ι ι ℝ}
    (hmatch : ∀ i j, (i = j ∨ G.Adj i j) → K₀⁻¹ i j = S i j)
    (hsupp : IsSupportedOn G K) : (S * K).trace = (K₀⁻¹ * K).trace := by
  classical
  simp only [trace, diag_apply, mul_apply]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  by_cases hij : i = j ∨ G.Adj i j
  · rw [hmatch i j hij]
  · have hzero : K j i = 0 :=
      hsupp j i (fun h => hij (Or.inl h.symm)) (fun h => hij (Or.inr h.symm))
    rw [hzero, mul_zero, mul_zero]

/-- **Dempster's covariance-selection MLE** (sufficiency): a positive definite `K̂` supported on
`G` whose inverse agrees with `S` on the diagonal and the edges maximizes `log det K - tr (S K)`
over positive definite `K` supported on `G`. -/
theorem gaussLogLik_le_of_inv_eq_on_graph {G : SimpleGraph ι} {S K₀ : Matrix ι ι ℝ}
    (hK₀ : K₀.PosDef) (hsupp₀ : IsSupportedOn G K₀)
    (hmatch : ∀ i j, (i = j ∨ G.Adj i j) → K₀⁻¹ i j = S i j)
    {K : Matrix ι ι ℝ} (hK : K.PosDef) (hsupp : IsSupportedOn G K) :
    gaussLogLik S K ≤ gaussLogLik S K₀ := by
  let := hK₀.isUnit.invertible
  have ht := trace_eq_of_supported hmatch hsupp
  have ht₀ := trace_eq_of_supported hmatch hsupp₀
  rw [nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hK₀.det_pos.ne'), trace_one] at ht₀
  have h := hK.log_det_mul_le_trace hK₀.inv
  rw [det_nonsing_inv, Ring.inverse_eq_inv, log_mul hK.det_pos.ne' (inv_ne_zero hK₀.det_pos.ne'),
    log_inv, ← trace_mul_comm, ← ht] at h
  unfold gaussLogLik
  rw [ht₀]
  linarith

open scoped MatrixOrder in
private theorem mul_eq_one_of_log_det_eq_trace {ι : Type*} [Fintype ι] [DecidableEq ι]
    {A B : Matrix ι ι ℝ} (hA : A.PosDef) (hB : B.PosDef)
    (heq : log (A.det * B.det) = (A * B).trace - Fintype.card ι) : B * A = 1 := by
  classical
  let R := CFC.sqrt B
  have hR : R.PosSemidef := nonneg_iff_posSemidef.1 (CFC.sqrt_nonneg B)
  have hRR : R * R = B := CFC.sqrt_mul_sqrt_self B (nonneg_iff_posSemidef.2 hB.posSemidef)
  have hdetR : R.det * R.det = B.det := by rw [← det_mul, hRR]
  have hRdet : R.det ≠ 0 := fun h => by
    have := hB.det_pos
    rw [← hdetR, h, zero_mul] at this
    exact lt_irrefl _ this
  have hu : IsUnit R.det := isUnit_iff_ne_zero.2 hRdet
  have hinj : Function.Injective R.mulVec := fun u v huv => by
    have h := congrArg (R⁻¹ *ᵥ ·) huv
    simpa [mulVec_mulVec, nonsing_inv_mul R hu] using h
  have hM : (Rᴴ * A * R).PosDef := hA.conjTranspose_mul_mul_same hinj
  rw [hR.1] at hM
  have hdet : (R * A * R).det = A.det * B.det := by
    rw [det_mul, det_mul, ← hdetR]
    ring
  have htr : (R * A * R).trace = (A * B).trace := by
    rw [trace_mul_cycle, ← hRR, ← Matrix.mul_assoc, trace_mul_comm, Matrix.mul_assoc]
  rw [← hdet, ← htr, hM.1.det_eq_prod_eigenvalues, hM.1.trace_eq_sum_eigenvalues] at heq
  simp only [RCLike.ofReal_real_eq_id, id] at heq
  rw [log_prod fun i _ => (hM.eigenvalues_pos i).ne'] at heq
  have hsum : ∑ i, log (hM.1.eigenvalues i) = ∑ i, (hM.1.eigenvalues i - 1) := by
    simpa only [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
      mul_one] using heq
  have heigen : ∀ i, hM.1.eigenvalues i = 1 := by
    intro i
    have hi := (Finset.sum_eq_sum_iff_of_le
      (fun j _ => log_le_sub_one_of_pos (hM.eigenvalues_pos j))).1 hsum i (Finset.mem_univ i)
    by_contra h
    exact (log_lt_sub_one_of_pos (hM.eigenvalues_pos i) h).ne hi
  have hidentity : R * A * R = 1 := by
    rw [hM.1.spectral_theorem]
    have hd : diagonal (RCLike.ofReal ∘ hM.1.eigenvalues) = (1 : Matrix ι ι ℝ) := by
      simp [heigen, ← diagonal_one]
    rw [hd, map_one]
  have h := congrArg (fun M => R * M * R⁻¹) hidentity
  simp only [Matrix.mul_assoc, mul_nonsing_inv R hu, Matrix.mul_one] at h
  simpa only [← Matrix.mul_assoc, hRR] using h

/-- **Uniqueness of Dempster's MLE**: under the hypotheses of
`gaussLogLik_le_of_inv_eq_on_graph`, a positive definite `K` supported on `G` with the same
objective value is `K̂`. -/
theorem eq_of_gaussLogLik_eq {G : SimpleGraph ι} {S K₀ : Matrix ι ι ℝ}
    (hK₀ : K₀.PosDef) (hsupp₀ : IsSupportedOn G K₀)
    (hmatch : ∀ i j, (i = j ∨ G.Adj i j) → K₀⁻¹ i j = S i j)
    {K : Matrix ι ι ℝ} (hK : K.PosDef) (hsupp : IsSupportedOn G K)
    (heq : gaussLogLik S K = gaussLogLik S K₀) : K = K₀ := by
  have ht := trace_eq_of_supported hmatch hsupp
  have ht₀ := trace_eq_of_supported hmatch hsupp₀
  rw [nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hK₀.det_pos.ne'), trace_one] at ht₀
  have hlog : log (K.det * K₀⁻¹.det) = (K * K₀⁻¹).trace - Fintype.card ι := by
    rw [det_nonsing_inv, Ring.inverse_eq_inv,
      log_mul hK.det_pos.ne' (inv_ne_zero hK₀.det_pos.ne'), log_inv, ← trace_mul_comm, ← ht]
    unfold gaussLogLik at heq
    rw [ht₀] at heq
    linarith
  have hmul := mul_eq_one_of_log_det_eq_trace hK hK₀.inv hlog
  have h := congrArg (K₀ * ·) hmul
  simpa only [← Matrix.mul_assoc,
    mul_nonsing_inv K₀ (isUnit_iff_ne_zero.mpr hK₀.det_pos.ne'),
    Matrix.one_mul, Matrix.mul_one] using h

end Dempster

end MathlibExt.Probability.Statistics.GaussianGraphicalModel
