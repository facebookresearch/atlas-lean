module

public import Mathlib.Probability.BrownianMotion.Basic
public import Mathlib.MeasureTheory.Integral.IntervalIntegral.Basic
public import MathlibExt.Probability.ItoIntegralProperties

/-!
# Backward stochastic differential equations: the solution notion

A **backward stochastic differential equation** (BSDE) on `[0, T]` driven by a real Brownian
motion `B` with generator `g` and terminal value `ξ` asks for a pair `(Y, Z)` of
non-anticipating processes with
`Y_t = ξ + ∫_t^T g(s, Y_s, Z_s) ds - ∫_t^T Z_s dB_s` for `t ∈ [0, T]`
(S. Peng, *Backward stochastic differential equation, nonlinear expectation and their
applications*, Proc. ICM 2010, Vol. I, §1.2, equation (1.7); E. Pardoux and S. Peng, *Adapted
solution of a backward stochastic differential equation*, Systems Control Lett. 14 (1990)).
Unlike an SDE, the terminal value is prescribed, and the martingale part `Z` is an unknown.

This file fixes the one-dimensional solution notion `IsBSDESolution`, in the space
`M²(0, T)` of progressive processes with `E ∫_0^T |·|² dt < ∞`, with the repository's `L²` Itô
integral `ProbabilityTheory.itoIntegral`, and the augmented Brownian filtration
`IsAugmentedBrownianFiltration`. It proves that a generator vanishing at `z = 0` has the constant
solutions `(Y, Z) = (c, 0)`: this is the constant-preserving property `E^g[c] = c` of Peng's
g-expectation (ICM 2010, §1.6). The existence, uniqueness and comparison theorems are recorded in
`WantedExt.Probability.Process.BSDEWanted`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace MathlibExt.Probability.BSDE

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- **Augmented Brownian filtration.** `F t` is generated by `B_s`, `s ≤ t`, together with the
`P`-null measurable sets. This is the filtration of the BSDE theory (S. Peng, Proc. ICM 2010,
Vol. I, §1.1, where the null sets are left implicit); the solution of a BSDE is adapted to it
because of the Brownian martingale representation theorem. -/
def IsAugmentedBrownianFiltration (P : Measure Ω) (F : Filtration ℝ≥0 mΩ)
    (B : ℝ≥0 → Ω → ℝ) : Prop :=
  ∀ t, F t = (⨆ s ≤ t, MeasurableSpace.comap (B s) inferInstance) ⊔
    MeasurableSpace.generateFrom {N | MeasurableSet N ∧ P N = 0}

/-- **Solution of a one-dimensional BSDE on `[0, T]`** (S. Peng, Proc. ICM 2010, Vol. I, §1.2,
equation (1.7) and Theorem 1.1, with `m = d = 1`). The pair `(Y, Z)` solves the BSDE with
generator `g` and terminal value `ξ` if `Y` and `Z` are `F`-progressive with
`E ∫_0^T Y_t² dt < ∞` and `E ∫_0^T Z_t² dt < ∞` (the space `M²(0, T)`), and for every `t ≤ T`,
almost surely, `Y_t = ξ + ∫_t^T g(s, Y_s, Z_s) ds - (∫_0^T Z dB - ∫_0^t Z dB)`, where `∫ Z dB`
is the repository's `L²` Itô integral `ProbabilityTheory.itoIntegral`. -/
def IsBSDESolution (P : Measure Ω) (F : Filtration ℝ≥0 mΩ) (B : ℝ≥0 → Ω → ℝ) (T : ℝ≥0)
    (g : ℝ≥0 → Ω → ℝ → ℝ → ℝ) (ξ : Ω → ℝ) (Y Z : ℝ≥0 → Ω → ℝ) : Prop :=
  IsProgressive F Y ∧ IsProgressive F Z ∧
    ∫⁻ ω, (∫⁻ u in Set.Ioc (0 : ℝ) T, ‖Y u.toNNReal ω‖ₑ ^ 2) ∂P ≠ ∞ ∧
    ∫⁻ ω, (∫⁻ u in Set.Ioc (0 : ℝ) T, ‖Z u.toNNReal ω‖ₑ ^ 2) ∂P ≠ ∞ ∧
    ∀ t ≤ T, ∀ᵐ ω ∂P, Y t ω = ξ ω +
      (∫ u in (t : ℝ)..T, g u.toNNReal ω (Y u.toNNReal ω) (Z u.toNNReal ω)) -
        (itoIntegral P F B Z T ω - itoIntegral P F B Z t ω)

/-- The Itô integral of the zero integrand vanishes almost surely. -/
private theorem itoIntegral_zero_ae {P : Measure Ω} {F : Filtration ℝ≥0 mΩ} {B : ℝ≥0 → Ω → ℝ}
    (hB : IsBrownianReal B P) (hBF : Adapted F B)
    (hInd : ∀ s t, s ≤ t → Indep (MeasurableSpace.comap (fun ω ↦ B t ω - B s ω) inferInstance)
      (F s) P) (t : ℝ≥0) :
    itoIntegral P F B 0 t =ᵐ[P] 0 := by
  have h := itoIntegral_smul hB hBF hInd (isProgressive_const F (0 : ℝ)) 0 t (by simp)
  have h0 : ((0 : ℝ) • fun (_ : ℝ≥0) (_ : Ω) ↦ (0 : ℝ)) = 0 := by ext; simp
  rw [h0] at h
  filter_upwards [h] with ω hω
  simpa using hω

/-- **Constant solutions and constant preservation of g-expectations.** If the generator
vanishes at `z = 0` along the constant `c` (`g(t, ω, c, 0) = 0`), then `(Y, Z) = (c, 0)` solves
the BSDE with terminal value `c`. With uniqueness of solutions, this is the property
`E^g[c] = c` of Peng's g-expectation, defined for generators with `g(·, y, 0) ≡ 0`
(S. Peng, Proc. ICM 2010, Vol. I, §1.6, equation (1.19) and the sentence after it). -/
theorem isBSDESolution_const {P : Measure Ω} [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    {B : ℝ≥0 → Ω → ℝ} (hB : IsBrownianReal B P) (hBF : Adapted F B)
    (hInd : ∀ s t, s ≤ t → Indep (MeasurableSpace.comap (fun ω ↦ B t ω - B s ω) inferInstance)
      (F s) P) (T : ℝ≥0) {g : ℝ≥0 → Ω → ℝ → ℝ → ℝ} (c : ℝ) (hg : ∀ t ω, g t ω c 0 = 0) :
    IsBSDESolution P F B T g (fun _ ↦ c) (fun _ _ ↦ c) (fun _ _ ↦ 0) := by
  refine ⟨isProgressive_const F c, isProgressive_const F 0, ?_, by simp, ?_⟩
  · simp only [lintegral_const, measure_univ, mul_one]
    exact ENNReal.mul_ne_top (by simp) (by simp [Real.volume_Ioc])
  · intro t _
    have h0 : (fun (_ : ℝ≥0) (_ : Ω) ↦ (0 : ℝ)) = 0 := rfl
    filter_upwards [itoIntegral_zero_ae hB hBF hInd T, itoIntegral_zero_ae hB hBF hInd t]
      with ω hT ht
    rw [h0, hT, ht]
    simp [hg]

end MathlibExt.Probability.BSDE
