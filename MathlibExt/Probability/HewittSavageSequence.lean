import Mathlib.Probability.Independence.InfinitePi

/-!
# Hewitt–Savage zero–one law for i.i.d. sequences

The textbook form of the Hewitt–Savage zero–one law: if `X : ℕ → Ω → S` is an
i.i.d. sequence and `E ⊆ Ω` is an exchangeable event with respect to `X` (the
pullback of a measurable set of sequences invariant under every finitely
supported permutation of `ℕ`), then `μ E = 0` or `μ E = 1`.

## Source

This ports `v1/Atlas/TheoryOfProbability/code/HewittSavage.lean`
(`IsExchangeableEvent`, `IsExchangeableEventWrt`,
`IsExchangeableEventWrt.measurableSet`, `hewittSavage_zeroOne`), the
"Hewitt-Savage 0-1 law" target of `v1/Atlas/TheoryOfProbability/targets.yaml`.
In v1 the main theorem is left unproved; here it is proved.

## Scope

In:

* `IsExchangeableEvent`, `IsExchangeableEventWrt`: the definitions, ported
  verbatim from v1 (in the `MathlibExt.Probability.HewittSavageSequence`
  namespace; v1 states them at the root).
* `IsExchangeableEventWrt.measurableSet`: an exchangeable event with respect
  to a measurable sequence is measurable, as in v1.
* `hewittSavage_zeroOne`: the Hewitt–Savage 0-1 law for i.i.d. sequences.

Out:

* The product-space form of the law,
  `MathlibExt.Probability.HewittSavageWanted.hewitt_savage_zero_one_general`,
  already in MathlibExt; this file deduces the sequence form from it via the
  joint law `μ.map (fun ω n => X n ω) = Measure.infinitePi (fun _ => μ.map (X 0))`.
* No claim about exchangeable events for sequences that are not i.i.d.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace MathlibExt.Probability.HewittSavageSequence

/-- A set `A ⊆ (ℕ → S)` is an **exchangeable** (or permutable) event if it is
measurable and invariant under every finite permutation of the index set `ℕ`,
i.e. `{x : x ∘ σ ∈ A} = A` for every permutation `σ` that moves only finitely
many indices. -/
def IsExchangeableEvent {S : Type*} [MeasurableSpace S] (A : Set (ℕ → S)) : Prop :=
  MeasurableSet A ∧
  ∀ σ : Equiv.Perm ℕ, Set.Finite {i | σ i ≠ i} →
    (fun x => x ∘ σ) ⁻¹' A = A

/-- An event `E ⊆ Ω` is **exchangeable with respect to the sequence**
`X : ℕ → Ω → S` if there is some exchangeable event `A ⊆ (ℕ → S)` such that
`E` is the pullback of `A` under `ω ↦ (n ↦ X n ω)`. Equivalently, `E` belongs
to the σ-field of exchangeable events generated by `X`. -/
def IsExchangeableEventWrt {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    (X : ℕ → Ω → S) (E : Set Ω) : Prop :=
  ∃ A : Set (ℕ → S), IsExchangeableEvent A ∧
    E = (fun ω n => X n ω) ⁻¹' A

/-- An exchangeable event with respect to a measurable sequence `X` is itself
measurable in `Ω`. -/
theorem IsExchangeableEventWrt.measurableSet
    {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    {X : ℕ → Ω → S} {E : Set Ω}
    (hX : ∀ n, Measurable (X n))
    (hE : IsExchangeableEventWrt X E) :
    MeasurableSet E := by
  obtain ⟨A, ⟨hA_meas, _⟩, rfl⟩ := hE
  exact (measurable_pi_iff.mpr hX) hA_meas

/-- **Hewitt–Savage 0–1 law.** If `X_1, X_2, …` is an i.i.d. sequence
(independent and identically distributed) and `E` is an exchangeable event
(i.e. `E ∈ ℰ`, the σ-field of permutable events) with respect to `X`, then
`μ E ∈ {0, 1}`. -/
theorem hewittSavage_zeroOne
    {Ω S : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    {μ : Measure Ω} [IsProbabilityMeasure μ]
    {X : ℕ → Ω → S}
    (hX : ∀ n, Measurable (X n))
    (h_ident : ∀ i, IdentDistrib (X i) (X 0) μ μ)
    (h_indep : iIndepFun (m := fun _ => inferInstance) X μ)
    {E : Set Ω}
    (hE : IsExchangeableEventWrt X E) :
    μ E = 0 ∨ μ E = 1 := by
  obtain ⟨A, ⟨hA_meas, hA_sym⟩, rfl⟩ := hE
  have hΦ : Measurable (fun ω n => X n ω) := measurable_pi_iff.mpr hX
  have hmaps : (fun i : ℕ => μ.map (X i)) = fun _ : ℕ => μ.map (X 0) :=
    funext fun i => (h_ident i).map_eq
  have hmap : μ.map (fun ω n => X n ω) =
      Measure.infinitePi (fun _ : ℕ => μ.map (X 0)) := by
    rw [h_indep.map_fun_eq_infinitePi_map hX, hmaps]
  have hμE : μ ((fun ω n => X n ω) ⁻¹' A) =
      Measure.infinitePi (fun _ : ℕ => μ.map (X 0)) A := by
    rw [← hmap]
    exact (Measure.map_apply hΦ hA_meas).symm
  rw [hμE]
  exact MathlibExt.Probability.HewittSavageWanted.hewitt_savage_zero_one_general
    (μ.map (X 0)) A hA_meas hA_sym

end MathlibExt.Probability.HewittSavageSequence
