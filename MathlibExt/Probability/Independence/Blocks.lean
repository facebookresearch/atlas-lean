module

public import Mathlib.Probability.Independence.Basic

/-!
# Events determined by disjoint blocks of independent events

Let `(E x)_{x : J}` be a family of mutually independent measurable events, and split the index
type into blocks with a map `b : J → ι`. An event `D i` that is measurable with respect to the
σ-algebra generated by the events of block `i`, such as a union of intersections of them, is
determined by that block alone. Events determined by different blocks are then mutually
independent.

Mathlib states the case of two disjoint blocks
(`ProbabilityTheory.iIndepSet.indep_generateFrom_of_disjoint`); this file deduces the case of an
arbitrary family of blocks from it.

## Main results

* `ProbabilityTheory.iIndepSet.iIndepSet_of_measurableSet_generateFrom`: events determined by the
  blocks of an independent family of events are mutually independent.
-/

@[expose] public section

open MeasureTheory MeasurableSpace

namespace ProbabilityTheory

variable {Ω J ι : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}

/-- **Events determined by disjoint blocks of independent events are independent.** Let
$(E_x)_{x \in J}$ be a family of mutually independent measurable events of a probability space
$(\Omega, \mu)$, and let $b : J \to \iota$ split the indices into blocks. If, for each
$i \in \iota$, the event $D_i$ is measurable with respect to the σ-algebra generated by the events
$E_x$ with $b(x) = i$, then the events $(D_i)_{i \in \iota}$ are mutually independent. -/
theorem iIndepSet.iIndepSet_of_measurableSet_generateFrom {E : J → Set Ω}
    (hE : ∀ x, MeasurableSet (E x)) (h : iIndepSet E μ) (b : J → ι) {D : ι → Set Ω}
    (hD : ∀ i, MeasurableSet[generateFrom (E '' (b ⁻¹' {i}))] (D i)) :
    iIndepSet D μ := by
  classical
  have := h.isProbabilityMeasure
  have hle (S : Set J) : generateFrom (E '' S) ≤ mΩ :=
    generateFrom_le (by rintro _ ⟨x, -, rfl⟩; exact hE x)
  rw [iIndepSet_iff_meas_biInter fun i => hle _ _ (hD i)]
  intro s
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    have hind := h.indep_generateFrom_of_disjoint hE (b ⁻¹' {a}) (b ⁻¹' s)
      (Set.disjoint_left.2 fun x hxa hxs => ha (by simp_all))
    rw [Finset.set_biInter_insert, Finset.prod_insert ha, ← ih]
    refine (Indep_iff _ _ _).1 hind _ _ (hD a) (Finset.measurableSet_biInter s fun i hi => ?_)
    exact generateFrom_mono (Set.image_mono fun x hx => by simp_all) _ (hD i)

end ProbabilityTheory
