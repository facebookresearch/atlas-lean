module

public import MathlibExt.Probability.DoobLpInequality
public import MathlibExt.Probability.WaldSecondEquation
public import Mathlib.MeasureTheory.Function.LpOrder

/-!
# Integrability of stopped partial sums and of their running maximum

For identically distributed mean-zero real increments with finite second moment
and an integrable natural-valued stopping time, both the stopped square and the
maximum of squared partial sums up to that time are integrable.

The proof uses the public `MeasureTheory.Martingale.doob_sq_maximal_ineq` and
`MeasureTheory.wald_second_equation` APIs. Mathlib's `memLp_stoppedProcess` supplies
the L² premise from finite sums of the increments. Doob and Wald give a uniform
finite-horizon bound; pointwise stabilization and Fatou give the full maximum.
The stopped square is bounded by that maximum.

## Source

This proves the statement `integrable_maximal_stopped_partial_sum_sq` from
`v1/Atlas/TheoryOfProbability/code/StoppedSumSqUI.lean`, left unproved in v1.
The predictable filtration definition is unchanged from v1 `WaldSecondEquation.lean`.
The general-filtration API retains the canonical Wald independence orientation
and derives ambient measurability from successor adaptedness.

## Main results

* `integrable_stopped_partialSum_sq`: integrability of the stopped squared sum.
* `integrable_maximal_stopped_partial_sum_sq`: integrability of the running maximum
  of squared sums, including both endpoints.
* `predictableFiltration`: the filtration generated by earlier increments, with
  zero and successor characterizations.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Finset ENNReal NNReal Topology Set

namespace MathlibExt.Probability.StoppedSumMaximal

noncomputable section

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- Running maximum of `|f k ω|` over `0 ≤ k ≤ n`. -/
private noncomputable def maxAbs (f : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one (fun k => |f k ω|)

private theorem measurable_of_isStoppingTime {ℱ : Filtration ℕ m0} {T : Ω → ℕ}
    (hT : IsStoppingTime ℱ (fun ω => (T ω : WithTop ℕ))) : Measurable T := by
  apply measurable_to_nat
  intro ω
  have hset : T ⁻¹' {T ω} = {ω' | (T ω' : WithTop ℕ) = (T ω : WithTop ℕ)} := by
    ext ω'
    simp [Nat.cast_inj]
  rw [hset]
  exact (ℱ.le (T ω)) _ (hT.measurableSet_eq (T ω))

private def partialSum (X : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  ∑ i ∈ Finset.range n, X i ω

/-- The partial sums of a mean-zero sequence with `Xₖ` independent of `ℱₖ` form a
martingale. -/
private theorem martingale_partialSum {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hX_int : Integrable (X 0) μ)
    (hmean : ∫ ω, X 0 ω ∂μ = 0)
    {ℱ : Filtration ℕ m0}
    (hIndep : ∀ k, Indep (ℱ k) (MeasurableSpace.comap (X k) inferInstance) μ)
    (hadapt : ∀ k, Measurable[ℱ (k + 1)] (X k)) :
    Martingale (fun n ω => ∑ i ∈ Finset.range n, X i ω) ℱ μ := by
  have hXi_int : ∀ i, Integrable (X i) μ := fun i => (hX_iid i 0).integrable_iff.mpr hX_int
  have hmean_i : ∀ i, ∫ ω, X i ω ∂μ = 0 := fun i => by
    rw [(hX_iid i 0).integral_eq]; exact hmean
  have hadp : StronglyAdapted ℱ (fun n ω => ∑ i ∈ Finset.range n, X i ω) := by
    intro n
    exact ((Finset.measurable_sum (s := Finset.range n) (f := fun i ω => X i ω)
      (fun i hi => (hadapt i).mono (ℱ.mono (Nat.succ_le_of_lt (Finset.mem_range.mp hi)))
        le_rfl)).stronglyMeasurable)
  apply martingale_of_setIntegral_eq_succ hadp
    (fun n => integrable_finsetSum _ (fun i _ => hXi_int i))
  intro n s hs
  have hXs : ∫ ω in s, X n ω ∂μ = 0 := by
    have hmeas_s : Measurable[ℱ n] (Set.indicator s (fun _ => (1 : ℝ))) :=
      measurable_const.indicator hs
    have hindep : IndepFun (X n) (Set.indicator s (fun _ => (1 : ℝ))) μ := by
      rw [IndepFun_iff_Indep]
      exact indep_of_indep_of_le_right (hIndep n).symm hmeas_s.comap_le
    have h1 : ∫ ω, X n ω * Set.indicator s (fun _ => (1 : ℝ)) ω ∂μ =
        (∫ ω, X n ω ∂μ) * (∫ ω, Set.indicator s (fun _ => (1 : ℝ)) ω ∂μ) :=
      hindep.integral_mul_eq_mul_integral (hX_meas n).aestronglyMeasurable
        ((hmeas_s.mono (ℱ.le n) le_rfl)).aestronglyMeasurable
    have h2 : ∫ ω in s, X n ω ∂μ = ∫ ω, X n ω * Set.indicator s (fun _ => (1 : ℝ)) ω ∂μ := by
      rw [← integral_indicator ((ℱ.le n) s hs)]
      apply integral_congr_ae
      filter_upwards with ω
      by_cases hω : ω ∈ s <;> simp [Set.indicator, hω]
    rw [h2, h1, hmean_i n, zero_mul]
  have hsum : (fun ω => ∑ i ∈ Finset.range (n + 1), X i ω) =
      fun ω => (∑ i ∈ Finset.range n, X i ω) + X n ω :=
    funext fun ω => Finset.sum_range_succ _ _
  have hsplit : ∫ ω in s, ((∑ i ∈ Finset.range n, X i ω) + X n ω) ∂μ =
      ∫ ω in s, ∑ i ∈ Finset.range n, X i ω ∂μ + ∫ ω in s, X n ω ∂μ := by
    apply integral_add
    · exact (integrable_finsetSum _ (fun i _ => hXi_int i)).integrableOn
    · exact (hXi_int n).integrableOn
  rw [hsum, hsplit, hXs, add_zero]


private theorem memLp_partialSum {Ω : Type*} {m0 : MeasurableSpace Ω}
    {μ : Measure Ω} {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ) (n : ℕ) :
    MemLp (partialSum X n) 2 μ := by
  have hXi : ∀ i, MemLp (X i) 2 μ := fun i =>
    (memLp_two_iff_integrable_sq (hX_meas i).aestronglyMeasurable).mpr
      (((hX_iid i 0).comp (measurable_id.pow_const 2)).integrable_iff.mpr hX_sq_int)
  change MemLp (fun ω => ∑ i ∈ Finset.range n, X i ω) 2 μ
  exact memLp_finsetSum (Finset.range n) (fun i _ => hXi i)

omit [IsProbabilityMeasure μ] in
private theorem memLp_maxAbs {f : ℕ → Ω → ℝ} (hf : ∀ k, MemLp (f k) 2 μ) (n : ℕ) :
    MemLp (maxAbs f n) 2 μ := by
  induction n with
  | zero =>
    change MemLp (fun ω => |f 0 ω|) 2 μ
    exact (hf 0).abs
  | succ n ih =>
    have hEq : maxAbs f (n + 1) = |f (n + 1)| ⊔ maxAbs f n := by
      funext ω
      simp [maxAbs, Finset.range_add_one, Finset.sup'_insert, Pi.sup_apply]
    rw [hEq]
    exact ((hf (n + 1)).abs).sup ih

private theorem maxAbs_sq_eq {f : ℕ → Ω → ℝ} (n : ℕ) (ω : Ω) :
    (maxAbs f n ω) ^ 2 = (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one
      (fun k => (f k ω) ^ 2) := by
  unfold maxAbs
  apply le_antisymm
  · obtain ⟨j, hj, hmax⟩ := Finset.exists_mem_eq_sup' Finset.nonempty_range_add_one
      (fun k => |f k ω|)
    rw [hmax, sq_abs]
    exact Finset.le_sup' (fun k => (f k ω) ^ 2) hj
  · apply Finset.sup'_le
    intro k hk
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _)
      (Finset.le_sup' (fun k => |f k ω|) hk) 2

private theorem stopped_partialSum_eq {X : ℕ → Ω → ℝ} {τ : Ω → ℕ} (n : ℕ) (ω : Ω) :
    stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ)) n ω =
      partialSum X (min n (τ ω)) ω := by
  by_cases h : n ≤ τ ω
  · rw [stoppedProcess_eq_of_le (u := partialSum X)
      (τ := fun ω => (τ ω : WithTop ℕ)) (ω := ω) (WithTop.coe_le_coe.mpr h), min_eq_left h]
  · rw [stoppedProcess_eq_of_ge (u := partialSum X)
      (τ := fun ω => (τ ω : WithTop ℕ)) (ω := ω)
      (WithTop.coe_le_coe.mpr (not_le.mp h).le),
      min_eq_right (not_le.mp h).le]
    rfl

private theorem martingale_stoppedProcess {f : ℕ → Ω → ℝ} {ℱ : Filtration ℕ m0}
    (hmart : Martingale f ℱ μ) {τ : Ω → WithTop ℕ} (hτ : IsStoppingTime ℱ τ) :
    Martingale (stoppedProcess f τ) ℱ μ := by
  rw [martingale_iff]
  refine ⟨?_, hmart.submartingale.stoppedProcess hτ⟩
  have hneg := hmart.supermartingale.neg.stoppedProcess hτ
  have heq : stoppedProcess (-f) τ = -stoppedProcess f τ := by
    funext n ω
    simp [stoppedProcess, Pi.neg_apply]
  rw [heq] at hneg
  simpa only [neg_neg] using hneg.neg

omit [IsProbabilityMeasure μ] in
private theorem integrable_min_natCast {ℱ : Filtration ℕ m0} {τ : Ω → ℕ}
    (hT : IsStoppingTime ℱ (fun ω => (τ ω : WithTop ℕ)))
    (hτ_int : Integrable (fun ω => (τ ω : ℝ)) μ) (n : ℕ) :
    Integrable (fun ω => ((min n (τ ω) : ℕ) : ℝ)) μ := by
  have hmeas : Measurable (fun ω => ((min n (τ ω) : ℕ) : ℝ)) :=
    Nat.cast_continuous.measurable.comp (measurable_const.min (measurable_of_isStoppingTime hT))
  exact hτ_int.mono' hmeas.aestronglyMeasurable (Eventually.of_forall fun ω => by
    rw [Real.norm_of_nonneg (Nat.cast_nonneg (min n (τ ω)))]
    exact Nat.cast_le.mpr (min_le_right _ _))

private theorem integral_maxAbs_stopped_partialSum_sq_le {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_meas : ∀ i, Measurable (X i)) (hX_int : Integrable (X 0) μ)
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ) (hmean : ∫ ω, X 0 ω ∂μ = 0)
    {ℱ : Filtration ℕ m0}
    (hIndep : ∀ k, Indep (ℱ k) (MeasurableSpace.comap (X k) inferInstance) μ)
    (hadapt : ∀ k, Measurable[ℱ (k + 1)] (X k))
    {τ : Ω → ℕ} (hT : IsStoppingTime ℱ (fun ω => (τ ω : WithTop ℕ)))
    (hτ_int : Integrable (fun ω => (τ ω : ℝ)) μ) (n : ℕ) :
    ∫ ω, (maxAbs (stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ))) n ω) ^ 2 ∂μ ≤
      4 * ((∫ ω, (X 0 ω) ^ 2 ∂μ) * (∫ ω, (τ ω : ℝ) ∂μ)) := by
  let g := stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ))
  have hS := martingale_partialSum hX_iid hX_meas hX_int hmean hIndep hadapt
  have hg : Martingale g ℱ μ := martingale_stoppedProcess hS hT
  have hL2 : ∀ k, MemLp (g k) 2 μ := fun k =>
    memLp_stoppedProcess hT (memLp_partialSum hX_iid hX_meas hX_sq_int) k
  have hminStop : IsStoppingTime ℱ (fun ω => ((min n (τ ω) : ℕ) : WithTop ℕ)) := by
    have heq : (fun ω => ((min n (τ ω) : ℕ) : WithTop ℕ)) =
        fun ω => min (τ ω : WithTop ℕ) (n : WithTop ℕ) := by
      funext ω
      by_cases h : n ≤ τ ω
      · rw [min_eq_left h]
        exact (min_eq_right (WithTop.coe_le_coe.mpr h)).symm
      · rw [min_eq_right (not_le.mp h).le]
        exact (min_eq_left (WithTop.coe_le_coe.mpr (not_le.mp h).le)).symm
    rw [heq]
    exact hT.min_const n
  have hwald := wald_second_equation hX_iid hX_int hmean hX_sq_int
    (T := fun ω => min n (τ ω)) hminStop (fun k => (hIndep k).symm) hadapt
    (integrable_min_natCast hT hτ_int n)
  have hgn : (fun ω => (g n ω) ^ 2) =
      fun ω => (∑ i ∈ Finset.range (min n (τ ω)), X i ω) ^ 2 := by
    funext ω
    change (stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ)) n ω) ^ 2 = _
    rw [stopped_partialSum_eq]
    rfl
  have hE : ∫ ω, ((min n (τ ω) : ℕ) : ℝ) ∂μ ≤ ∫ ω, (τ ω : ℝ) ∂μ :=
    integral_mono_ae (integrable_min_natCast hT hτ_int n) hτ_int
      (Eventually.of_forall fun ω => Nat.cast_le.mpr (min_le_right _ _))
  calc ∫ ω, (maxAbs g n ω) ^ 2 ∂μ ≤ 4 * ∫ ω, (g n ω) ^ 2 ∂μ :=
      hg.doob_sq_maximal_ineq hL2 n
    _ = 4 * ((∫ ω, (X 0 ω) ^ 2 ∂μ) * ∫ ω, ((min n (τ ω) : ℕ) : ℝ) ∂μ) := by
      rw [hgn, hwald]
    _ ≤ 4 * ((∫ ω, (X 0 ω) ^ 2 ∂μ) * ∫ ω, (τ ω : ℝ) ∂μ) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hE (integral_nonneg fun ω => sq_nonneg _)) (by norm_num)

private theorem maxAbs_stopped_eq {X : ℕ → Ω → ℝ} {τ : Ω → ℕ}
    (ω : Ω) {n : ℕ} (hn : τ ω ≤ n) :
    maxAbs (stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ))) n ω =
      maxAbs (partialSum X) (τ ω) ω := by
  unfold maxAbs
  apply le_antisymm
  · apply Finset.sup'_le
    intro k hk
    rw [stopped_partialSum_eq]
    exact Finset.le_sup' (fun j => |partialSum X j ω|)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le (min_le_right _ _)))
  · apply Finset.sup'_le
    intro k hk
    have hkτ : k ≤ τ ω := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    rw [← stoppedProcess_eq_of_le (u := partialSum X)
      (τ := fun ω => (τ ω : WithTop ℕ)) (ω := ω) (WithTop.coe_le_coe.mpr hkτ)]
    exact Finset.le_sup' (fun j =>
      |stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ)) j ω|)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le (hkτ.trans hn)))

private theorem tendsto_maxAbs_stopped {X : ℕ → Ω → ℝ} {τ : Ω → ℕ} (ω : Ω) :
    Tendsto (fun n => maxAbs (stoppedProcess (partialSum X)
      (fun ω => (τ ω : WithTop ℕ))) n ω) atTop
      (𝓝 (maxAbs (partialSum X) (τ ω) ω)) := by
  have heq : (fun n => maxAbs (stoppedProcess (partialSum X)
      (fun ω => (τ ω : WithTop ℕ))) n ω) =ᶠ[atTop]
      (fun _ : ℕ => maxAbs (partialSum X) (τ ω) ω) := by
    filter_upwards [eventually_ge_atTop (τ ω)] with n hn
    exact maxAbs_stopped_eq ω hn
  exact Filter.Tendsto.congr' heq.symm
    (tendsto_const_nhds : Tendsto (fun _ : ℕ => maxAbs (partialSum X) (τ ω) ω)
      atTop (𝓝 (maxAbs (partialSum X) (τ ω) ω)))

omit [IsProbabilityMeasure μ] in
private theorem integrable_of_uniform_integral_bound {F : ℕ → Ω → ℝ} {G : Ω → ℝ}
    (hF : ∀ n, Integrable (F n) μ) (hFnn : ∀ n ω, 0 ≤ F n ω) (hGnn : ∀ ω, 0 ≤ G ω)
    (hlim : ∀ ω, Tendsto (fun n => F n ω) atTop (𝓝 (G ω))) {B : ℝ}
    (hbound : ∀ n, ∫ ω, F n ω ∂μ ≤ B) : Integrable G μ := by
  have hGmeas : AEStronglyMeasurable G μ :=
    aestronglyMeasurable_of_tendsto_ae atTop (fun n => (hF n).aestronglyMeasurable)
      (Eventually.of_forall hlim)
  have hfatou := lintegral_liminf_le' (μ := μ) (u := atTop)
    (f := fun n ω => ENNReal.ofReal (F n ω))
    (fun n => ENNReal.measurable_ofReal.comp_aemeasurable (hF n).aestronglyMeasurable.aemeasurable)
  have hliminf : liminf (fun n => ∫⁻ ω, ENNReal.ofReal (F n ω) ∂μ) atTop ≤
      ENNReal.ofReal B := by
    apply liminf_le_of_le (by isBoundedDefault)
    intro b hb
    obtain ⟨n, hn⟩ := hb.exists
    rw [← ofReal_integral_eq_lintegral_ofReal (hF n) (Eventually.of_forall (hFnn n))] at hn
    exact hn.trans (ENNReal.ofReal_le_ofReal (hbound n))
  have hfinite : (∫⁻ ω, ENNReal.ofReal (G ω) ∂μ) < ⊤ := by
    apply lt_of_le_of_lt (le_trans ?_ hliminf) ENNReal.ofReal_lt_top
    calc ∫⁻ ω, ENNReal.ofReal (G ω) ∂μ
        = ∫⁻ ω, liminf (fun n => ENNReal.ofReal (F n ω)) atTop ∂μ := by
          apply lintegral_congr
          intro ω
          exact ((ENNReal.continuous_ofReal.tendsto (G ω)).comp (hlim ω)).liminf_eq.symm
      _ ≤ _ := hfatou
  exact ⟨hGmeas, (hasFiniteIntegral_iff_ofReal (Eventually.of_forall hGnn)).mpr hfinite⟩

private theorem integrable_sup_stopped_partialSum_sq_of_integrable_tau {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_meas : ∀ i, Measurable (X i)) (hX_int : Integrable (X 0) μ)
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ) (hmean : ∫ ω, X 0 ω ∂μ = 0)
    {ℱ : Filtration ℕ m0}
    (hIndep : ∀ k, Indep (ℱ k) (MeasurableSpace.comap (X k) inferInstance) μ)
    (hadapt : ∀ k, Measurable[ℱ (k + 1)] (X k))
    {τ : Ω → ℕ} (hT : IsStoppingTime ℱ (fun ω => (τ ω : WithTop ℕ)))
    (hτ_int : Integrable (fun ω => (τ ω : ℝ)) μ) :
    Integrable (fun ω => (Finset.range (τ ω + 1)).sup'
      ⟨0, Finset.mem_range.mpr (Nat.lt_succ_of_le (Nat.zero_le _))⟩
      (fun k => (partialSum X k ω) ^ 2)) μ := by
  have hG2 : ∀ k, MemLp
      (stoppedProcess (partialSum X) (fun ω => (τ ω : WithTop ℕ)) k) 2 μ := fun k =>
    memLp_stoppedProcess hT (memLp_partialSum hX_iid hX_meas hX_sq_int) k
  have hU : Integrable (fun ω => (maxAbs (partialSum X) (τ ω) ω) ^ 2) μ :=
    integrable_of_uniform_integral_bound
      (F := fun n ω => (maxAbs (stoppedProcess (partialSum X)
        (fun ω => (τ ω : WithTop ℕ))) n ω) ^ 2)
      (fun n => (memLp_maxAbs hG2 n).integrable_sq)
      (fun n ω => sq_nonneg _) (fun ω => sq_nonneg _)
      (fun ω => (tendsto_maxAbs_stopped (X := X) (τ := τ) ω).pow 2)
      (fun n => integral_maxAbs_stopped_partialSum_sq_le hX_iid hX_meas hX_int
        hX_sq_int hmean hIndep hadapt hT hτ_int n)
  exact hU.congr (Eventually.of_forall fun ω => maxAbs_sq_eq (τ ω) ω)

private theorem integrable_stopped_partialSum_sq_of_integrable_tau {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_meas : ∀ i, Measurable (X i)) (hX_int : Integrable (X 0) μ)
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ) (hmean : ∫ ω, X 0 ω ∂μ = 0)
    {ℱ : Filtration ℕ m0}
    (hIndep : ∀ k, Indep (ℱ k) (MeasurableSpace.comap (X k) inferInstance) μ)
    (hadapt : ∀ k, Measurable[ℱ (k + 1)] (X k))
    {τ : Ω → ℕ} (hT : IsStoppingTime ℱ (fun ω => (τ ω : WithTop ℕ)))
    (hτ_int : Integrable (fun ω => (τ ω : ℝ)) μ) :
    Integrable (fun ω => (∑ i ∈ Finset.range (τ ω), X i ω) ^ 2) μ := by
  have hS := martingale_partialSum hX_iid hX_meas hX_int hmean hIndep hadapt
  have hmeas : Measurable (fun ω => partialSum X (τ ω) ω) := by
    have hstop := (measurable_stoppedValue
      hS.stronglyAdapted.isStronglyProgressive_of_discrete hT).mono hT.measurableSpace_le le_rfl
    have heq : stoppedValue (partialSum X) (fun ω => (τ ω : WithTop ℕ)) =
        fun ω => partialSum X (τ ω) ω := by
      funext ω
      rfl
    change Measurable (stoppedValue (partialSum X)
      (fun ω => (τ ω : WithTop ℕ))) at hstop
    rw [heq] at hstop
    exact hstop
  have hmax := integrable_sup_stopped_partialSum_sq_of_integrable_tau hX_iid hX_meas
    hX_int hX_sq_int hmean hIndep hadapt hT hτ_int
  apply hmax.mono' (hmeas.pow_const 2).aestronglyMeasurable
  apply Eventually.of_forall
  intro ω
  rw [Real.norm_of_nonneg (sq_nonneg _)]
  exact Finset.le_sup' (fun k => (partialSum X k ω) ^ 2)
    (Finset.mem_range.mpr (Nat.lt_succ_self (τ ω)))


/-- The "predictable" filtration associated to a sequence `X : ℕ → Ω → ℝ`:
`ℱ_k = σ(X_0, …, X_{k-1})`. Ported verbatim from v1 `WaldSecondEquation.lean`. -/
noncomputable def predictableFiltration
    {Ω : Type*} (m : MeasurableSpace Ω) (X : ℕ → Ω → ℝ)
    (hX_meas : ∀ i, Measurable (X i)) : Filtration ℕ m where
  seq k := ⨆ (j : ℕ) (_ : j < k), MeasurableSpace.comap (X j) inferInstance
  mono' _i _j hij := iSup₂_le fun l hl => le_iSup₂ (f := fun (l' : ℕ) (_ : l' < _j) =>
    MeasurableSpace.comap (X l') inferInstance) l (Nat.lt_of_lt_of_le hl hij)
  le' _k := iSup₂_le fun j _ => (hX_meas j).comap_le

/-- The predictable filtration contains no observations at time zero. -/
@[simp] theorem predictableFiltration_zero {X : ℕ → Ω → ℝ}
    (hX_meas : ∀ i, Measurable (X i)) :
    predictableFiltration m0 X hX_meas 0 = ⊥ := by
  simp [predictableFiltration]

/-- A successor step adds exactly the next observation to the predictable filtration. -/
theorem predictableFiltration_succ {X : ℕ → Ω → ℝ}
    (hX_meas : ∀ i, Measurable (X i)) (k : ℕ) :
    predictableFiltration m0 X hX_meas (k + 1) =
      predictableFiltration m0 X hX_meas k ⊔ MeasurableSpace.comap (X k) inferInstance :=
  Nat.iSup_lt_succ (fun j => MeasurableSpace.comap (X j) inferInstance) k

private theorem measurable_predictableFiltration_succ {X : ℕ → Ω → ℝ}
    (hX_meas : ∀ i, Measurable (X i)) (k : ℕ) :
    Measurable[predictableFiltration m0 X hX_meas (k + 1)] (X k) := by
  rw [measurable_iff_comap_le]
  exact le_iSup₂ (f := fun (j : ℕ) (_ : j < k + 1) =>
    MeasurableSpace.comap (X j) inferInstance) k (Nat.lt_succ_self k)

private theorem indep_predictableFiltration {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}
    {X : ℕ → Ω → ℝ}
    (hX_meas : ∀ i, Measurable (X i))
    (hX_ind : iIndepFun (β := fun _ => ℝ) X μ) (k : ℕ) :
    Indep (predictableFiltration m0 X hX_meas k)
      (MeasurableSpace.comap (X k) inferInstance) μ := by
  have h1 := indep_iSup_of_disjoint (m := fun j => MeasurableSpace.comap (X j) inferInstance)
    (fun j => (hX_meas j).comap_le) (hX_ind.iIndep) (S := {j | j < k}) (T := {k})
    (by simp)
  have h2 : (⨆ i ∈ ({k} : Set ℕ), MeasurableSpace.comap (X i) inferInstance) =
      MeasurableSpace.comap (X k) inferInstance := by simp
  have h3 : (⨆ i ∈ ({j | j < k} : Set ℕ), MeasurableSpace.comap (X i) inferInstance) =
      predictableFiltration m0 X hX_meas k := rfl
  rw [h2, h3] at h1
  exact h1

/-- **Square-integrability of a stopped partial sum**, general-filtration form. -/
theorem integrable_stopped_partialSum_sq {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_int : Integrable (X 0) μ)
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ)
    (hmean : ∫ ω, X 0 ω ∂μ = 0)
    {ℱ : Filtration ℕ m0}
    (hIndep : ∀ k, Indep (MeasurableSpace.comap (X k) inferInstance) (ℱ k) μ)
    (hadapt : ∀ k, Measurable[ℱ (k + 1)] (X k))
    {τ : Ω → ℕ} (hT : IsStoppingTime ℱ (fun ω => (τ ω : WithTop ℕ)))
    (hτ_int : Integrable (fun ω => (τ ω : ℝ)) μ) :
    Integrable (fun ω => (∑ i ∈ Finset.range (τ ω), X i ω) ^ 2) μ := by
  have hX_meas : ∀ k, Measurable (X k) :=
    fun k => (hadapt k).mono (ℱ.le (k + 1)) le_rfl
  exact integrable_stopped_partialSum_sq_of_integrable_tau hX_iid hX_meas hX_int hX_sq_int
    hmean (fun k => (hIndep k).symm) hadapt hT hτ_int

/-- **Square-integrability of the maximal stopped partial sum**, in v1's form:
`max_{0 ≤ k ≤ T} Sₖ²` is integrable. This is v1's
`integrable_maximal_stopped_partial_sum_sq`, whose proof in v1 was left unproved. -/
theorem integrable_maximal_stopped_partial_sum_sq {X : ℕ → Ω → ℝ}
    (hX_iid : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (β := fun _ => ℝ) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hX_int : Integrable (X 0) μ)
    (hmean : ∫ ω, X 0 ω ∂μ = 0)
    (hX_sq_int : Integrable (fun ω => (X 0 ω) ^ 2) μ)
    {T : Ω → ℕ}
    (hT : IsStoppingTime (predictableFiltration m0 X hX_meas) (fun ω => (T ω : WithTop ℕ)))
    (hT_int : Integrable (fun ω => (T ω : ℝ)) μ) :
    Integrable (fun ω => (Finset.range (T ω + 1)).sup'
      ⟨0, Finset.mem_range.mpr (Nat.lt_succ_of_le (Nat.zero_le _))⟩
      (fun k => (∑ i ∈ Finset.range k, X i ω) ^ 2)) μ :=
  integrable_sup_stopped_partialSum_sq_of_integrable_tau hX_iid hX_meas hX_int hX_sq_int hmean
    (fun k => indep_predictableFiltration hX_meas hX_ind k)
    (fun k => measurable_predictableFiltration_succ hX_meas k) hT hT_int

end

end MathlibExt.Probability.StoppedSumMaximal
