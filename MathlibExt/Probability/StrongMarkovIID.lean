module

public import Mathlib.Probability.IdentDistrib
public import Mathlib.Probability.Independence.Basic
public import Mathlib.Probability.Process.Stopping

/-!
# Strong Markov property for i.i.d. sequences: the post-stopping-time sequence is i.i.d.

For an i.i.d. sequence `X : ℕ → Ω → S` and a finite `ℕ`-valued stopping time `T`
whose filtration is contained in the natural filtration of `X`, the post-stopping-time sequence `(X_{T+k+1})_{k ≥ 0}` is again an i.i.d. sequence
with the same distribution as `X 0`.

## Source

This formalizes the first two conjuncts of `strong_markov_iid` in
`v1/Atlas/TheoryOfProbability/code/StrongMarkovIID.lean`, which is the v1
formalization of the target "Theorem (Strong Markov property for i.i.d.
sequences)" (Lecture 23, Stopping time theorems) of
`v1/Atlas/TheoryOfProbability/targets.yaml`.

## Scope

In:

* `ProbabilityTheory.postStoppingTimeSeq`: the post-stopping-time sequence.
* `ProbabilityTheory.strong_markov_iid_identDistrib`: each `X_{T+k+1}` has the
  same distribution as `X 0`.
* `ProbabilityTheory.strong_markov_iid_iIndepFun`: the post-stopping-time
  sequence is itself an independent family.
* `ProbabilityTheory.strong_markov_iid_postStoppingTimeSeq`: the two facts
  combined — the post-stopping-time sequence is i.i.d.

Out: the third conjunct of v1's `strong_markov_iid`, independence of the
post-stopping-time sequence from the stopped σ-algebra `ℱ_T`
(`strong_markov_iid_indep_past` in v1), which is not claimed here.

## Relation to Mathlib

Mathlib has no strong Markov property for i.i.d. sequences (searched for
`strong_markov`, `StrongMarkov`, and `postStopping` in Mathlib and MathlibExt:
no hits). The proof uses Mathlib's `indep_iSup_of_disjoint`, the
`iIndepFun` API, and the measure theory of countable disjoint unions.

## Main results

* `ProbabilityTheory.strong_markov_iid_identDistrib`
* `ProbabilityTheory.strong_markov_iid_iIndepFun`
* `ProbabilityTheory.strong_markov_iid_postStoppingTimeSeq`
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace ProbabilityTheory

variable {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
variable {S : Type*} [MeasurableSpace S]

/-- **Post-stopping-time sequence.** Given maps $X_0, X_1, X_2, \dots$ from a set $\Omega$ to a set
$S$ and a map $T : \Omega \to \mathbb{N}$, the post-stopping-time sequence is the sequence
$(Y_k)_{k \in \mathbb{N}}$ of maps from $\Omega$ to $S$ given by
$Y_k(\omega) = X_{T(\omega)+k+1}(\omega)$. When $T$ is a stopping time, this is the sequence of
observations immediately after time $T$. -/
def postStoppingTimeSeq (X : ℕ → Ω → S) (T : Ω → ℕ) : ℕ → Ω → S :=
  fun k ω => X (T ω + k + 1) ω

/-- **Shifted terms of an identically distributed sequence.** Let $\mu$ be a measure on a
measurable space $\Omega$ and let $X_0, X_1, X_2, \dots$ be maps from $\Omega$ to a measurable
space $S$ such that $X_i$ and $X_j$ are identically distributed under $\mu$ for all $i, j$. Then
for all $n, k \in \mathbb{N}$ the map $X_{n+k+1}$ has the same distribution under $\mu$ as
$X_0$. -/
lemma identDistrib_tail {X : ℕ → Ω → S}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (n k : ℕ) :
    IdentDistrib (X (n + k + 1)) (X 0) μ μ :=
  hX_id (n + k + 1) 0

/-- **A stopping-time event is independent of a later observation.** Let $\mu$ be a probability
measure on a measurable space $\Omega$, let $(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a filtration
on $\Omega$, and let $X_0, X_1, X_2, \dots$ be measurable maps from $\Omega$ to a measurable space
$S$ that are mutually independent under $\mu$. Suppose that for every $n$ the σ-algebra
$\mathcal{F}_n$ is contained in the σ-algebra generated by $X_0, \dots, X_n$, and let
$T : \Omega \to \mathbb{N}$ be a stopping time for $(\mathcal{F}_n)$. Then for all
$n, k \in \mathbb{N}$ and every measurable set $A \subseteq S$,
$\mu(\{T = n\} \cap X_{n+k+1}^{-1}(A)) = \mu(\{T = n\})\,\mu(X_{n+k+1}^{-1}(A))$. -/
lemma indep_stopping_time_tail
    (X : ℕ → Ω → S) (f : Filtration ℕ m) (T : Ω → ℕ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    [IsProbabilityMeasure μ]
    (n k : ℕ) (A : Set S) (hA : MeasurableSet A) :
    μ ({ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A) =
      μ {ω | T ω = n} * μ ((X (n + k + 1)) ⁻¹' A) := by
  set m' : ℕ → MeasurableSpace Ω := fun i => MeasurableSpace.comap (X i) ‹MeasurableSpace S›
  have hle : ∀ i, m' i ≤ m := fun i => MeasurableSpace.comap_le_iff_le_map.mpr (hX_meas i)
  have hST : Disjoint (Set.Iic n) ({n + k + 1} : Set ℕ) := by
    simp only [Set.disjoint_left, Set.mem_Iic, Set.mem_singleton_iff]
    intro x hx hxT; omega
  have hindep : Indep (⨆ i ∈ Set.Iic n, m' i) (⨆ i ∈ ({n + k + 1} : Set ℕ), m' i) μ :=
    indep_iSup_of_disjoint hle hX_ind hST
  have hTn_meas : @MeasurableSet Ω (⨆ i ∈ Set.Iic n, m' i) {ω | T ω = n} := by
    have h1 : @MeasurableSet Ω (f n) {ω : Ω | T ω = n} := by
      have : {ω : Ω | T ω = n} = {ω : Ω | (T ω : ℕ∞) = ↑n} := by ext ω; simp [Nat.cast_inj]
      rw [this]; exact hT.measurableSet_eq n
    have h3 : (⨆ i ∈ Finset.range (n + 1), m' i) ≤ (⨆ i ∈ Set.Iic n, m' i) := by
      apply biSup_mono
      intro i hi
      simp only [Finset.mem_range] at hi
      simp only [Set.mem_Iic]; omega
    exact h3 _ (hfX n _ h1)
  have hA_meas : @MeasurableSet Ω (⨆ i ∈ ({n + k + 1} : Set ℕ), m' i) (X (n + k + 1) ⁻¹' A) := by
    have hle' : m' (n + k + 1) ≤ ⨆ i ∈ ({n + k + 1} : Set ℕ), m' i :=
      le_biSup (f := m') (Set.mem_singleton _)
    have hcomap : @MeasurableSet Ω (m' (n + k + 1)) (X (n + k + 1) ⁻¹' A) := by
      rw [MeasurableSpace.measurableSet_comap]
      exact ⟨A, hA, rfl⟩
    exact hle' _ hcomap
  exact (hindep.indepSet_of_measurableSet hTn_meas hA_meas).measure_inter_eq_mul

/-- **Level sets of a stopping time are measurable.** Let $(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a
filtration on a measurable space $\Omega$ and let $T : \Omega \to \mathbb{N}$ be a stopping time
for $(\mathcal{F}_n)$. Then for every $n \in \mathbb{N}$ the set $\{\omega : T(\omega) = n\}$ is
measurable in the σ-algebra of $\Omega$. -/
lemma measurableSet_stoppingTime_eq {f : Filtration ℕ m} {T : Ω → ℕ}
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞))) (n : ℕ) :
    MeasurableSet {ω | T ω = n} := by
  have h := hT.measurableSet_eq n
  have : {ω : Ω | T ω = n} = {ω : Ω | (T ω : ℕ∞) = ↑n} := by ext ω; simp [Nat.cast_inj]
  rw [this]; exact (f.le n) _ h

/-- **The post-stopping-time sequence is a.e. measurable.** Let $\mu$ be a measure on a measurable
space $\Omega$, let $(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a filtration on $\Omega$, let
$X_0, X_1, X_2, \dots$ be maps from $\Omega$ to a measurable space $S$ that are each
$\mu$-almost-everywhere measurable, and let $T : \Omega \to \mathbb{N}$ be a stopping time for
$(\mathcal{F}_n)$. Then for every $k \in \mathbb{N}$ the map
$\omega \mapsto X_{T(\omega)+k+1}(\omega)$ is $\mu$-almost-everywhere measurable. -/
lemma aemeasurable_postStoppingTimeSeq
    {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_aem : ∀ i, AEMeasurable (X i) μ)
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (k : ℕ) :
    AEMeasurable (postStoppingTimeSeq X T k) μ := by
  show AEMeasurable (fun ω => X (T ω + k + 1) ω) μ
  set X' : ℕ → Ω → S := fun i => (hX_aem i).mk (X i)
  have hX'_meas : ∀ i, Measurable (X' i) := fun i => (hX_aem i).measurable_mk
  have hT_meas : Measurable T := by
    apply measurable_to_countable; intro ω
    show MeasurableSet (T ⁻¹' {T ω})
    have : T ⁻¹' {T ω} = {ω' : Ω | T ω' = T ω} := by ext ω'; simp
    rw [this]; exact measurableSet_stoppingTime_eq hT (T ω)
  have h_meas : Measurable (fun ω => X' (T ω + k + 1) ω) := by
    intro s hs
    have decomp : (fun ω => X' (T ω + k + 1) ω) ⁻¹' s =
        ⋃ n, {ω | T ω = n} ∩ (X' (n + k + 1)) ⁻¹' s := by
      ext ω; simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_ofPred_eq]
      exact ⟨fun h => ⟨T ω, rfl, h⟩, fun ⟨n, hn, h⟩ => hn ▸ h⟩
    rw [decomp]
    exact MeasurableSet.iUnion fun n =>
      (hT_meas (MeasurableSet.singleton n)).inter (hX'_meas (n + k + 1) hs)
  refine ⟨fun ω => X' (T ω + k + 1) ω, h_meas, ?_⟩
  have hall : ∀ᵐ ω ∂μ, ∀ i : ℕ, X i ω = X' i ω := ae_all_iff.mpr fun i => (hX_aem i).ae_eq_mk
  filter_upwards [hall] with ω hω
  exact hω (T ω + k + 1)

/-- **Strong Markov property for i.i.d. sequences: the law after a stopping time.** Let $\mu$ be a
probability measure on a measurable space $\Omega$, let $(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a
filtration on $\Omega$, and let $X_0, X_1, X_2, \dots$ be measurable maps from $\Omega$ to a
measurable space $S$ that are mutually independent and identically distributed under $\mu$.
Suppose that for every $n$ the σ-algebra $\mathcal{F}_n$ is contained in the σ-algebra generated
by $X_0, \dots, X_n$, and let $T : \Omega \to \mathbb{N}$ be a stopping time for
$(\mathcal{F}_n)$. Then for every $k \in \mathbb{N}$ the map
$\omega \mapsto X_{T(\omega)+k+1}(\omega)$ has the same distribution under $\mu$ as $X_0$. -/
theorem strong_markov_iid_identDistrib
    {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    [IsProbabilityMeasure μ]
    (k : ℕ) :
    IdentDistrib (postStoppingTimeSeq X T k) (X 0) μ μ := by
  have haem := aemeasurable_postStoppingTimeSeq
    (fun i => (hX_id i 0).aemeasurable_fst) hT k
  refine ⟨haem, (hX_id 0 0).aemeasurable_fst, ?_⟩
  apply Measure.ext
  intro A hA
  rw [Measure.map_apply_of_aemeasurable haem hA,
      Measure.map_apply_of_aemeasurable (hX_id 0 0).aemeasurable_fst hA]
  show μ ((fun ω => X (T ω + k + 1) ω) ⁻¹' A) = μ ((X 0) ⁻¹' A)
  have decomp : (fun ω => X (T ω + k + 1) ω) ⁻¹' A =
      ⋃ n, {ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A := by
    ext ω; simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_ofPred_eq]
    exact ⟨fun h => ⟨T ω, rfl, h⟩, fun ⟨n, hn, h⟩ => hn ▸ h⟩
  rw [decomp]
  have hdisj : Pairwise (Function.onFun Disjoint
      (fun n => {ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A)) := by
    intro i j hij
    simp only [Function.onFun, Set.disjoint_left, Set.mem_inter_iff, Set.mem_ofPred_eq]
    intro ω ⟨hi, _⟩ ⟨hj, _⟩; exact hij (hi.symm.trans hj)
  have hnull : ∀ n, NullMeasurableSet
      ({ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A) μ := by
    intro n
    exact ((measurableSet_stoppingTime_eq hT n).nullMeasurableSet).inter
      ((hX_meas (n + k + 1) hA).nullMeasurableSet)
  rw [measure_iUnion₀ (fun i j hij => (hdisj hij).aedisjoint) hnull]
  have key : ∀ n, μ ({ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A) =
      μ {ω | T ω = n} * μ ((X 0) ⁻¹' A) := by
    intro n
    have h1 := indep_stopping_time_tail X f T hX_ind hX_meas hT hfX n k A hA
    have h2 := (identDistrib_tail hX_id n k).measure_preimage_eq hA
    rw [h1, h2]
  simp_rw [key, ENNReal.tsum_mul_right]
  have hsum : ∑' n, μ {ω | T ω = n} = 1 := by
    rw [← measure_iUnion (fun i j hij => by
      simp only [Function.onFun, Set.disjoint_left, Set.mem_ofPred_eq]
      intro ω hi hj; exact hij (hi.symm.trans hj))
      (fun n => measurableSet_stoppingTime_eq hT n)]
    have : ⋃ n, {ω : Ω | T ω = n} = Set.univ := by ext ω; simp [Set.mem_iUnion]
    rw [this]; exact measure_univ
  rw [hsum, one_mul]

/-- **A stopping-time event is independent of finitely many later observations.** Let $\mu$ be a
probability measure on a measurable space $\Omega$, let $(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a
filtration on $\Omega$, and let $X_0, X_1, X_2, \dots$ be measurable maps from $\Omega$ to a
measurable space $S$ that are mutually independent under $\mu$. Suppose that for every $n$ the
σ-algebra $\mathcal{F}_n$ is contained in the σ-algebra generated by $X_0, \dots, X_n$, and let
$T : \Omega \to \mathbb{N}$ be a stopping time for $(\mathcal{F}_n)$. Then for every
$n \in \mathbb{N}$, every finite set $F \subseteq \mathbb{N}$ and all sets $A_k \subseteq S$
($k \in \mathbb{N}$) such that $A_k$ is measurable for every $k \in F$,
$\mu(\{T = n\} \cap \bigcap_{k \in F} X_{n+k+1}^{-1}(A_k)) =
\mu(\{T = n\}) \prod_{k \in F} \mu(X_{n+k+1}^{-1}(A_k))$. -/
lemma indep_stopping_time_tail_finset
    (X : ℕ → Ω → S) (f : Filtration ℕ m) (T : Ω → ℕ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    [IsProbabilityMeasure μ]
    (n : ℕ) (SF : Finset ℕ) (sets : ℕ → Set S) (hsets : ∀ k ∈ SF, MeasurableSet (sets k)) :
    μ ({ω | T ω = n} ∩ ⋂ k ∈ SF, (X (n + k + 1)) ⁻¹' sets k) =
      μ {ω | T ω = n} * ∏ k ∈ SF, μ ((X (n + k + 1)) ⁻¹' sets k) := by
  set m' : ℕ → MeasurableSpace Ω := fun i => MeasurableSpace.comap (X i) ‹MeasurableSpace S›
  have hle : ∀ i, m' i ≤ m := fun i => MeasurableSpace.comap_le_iff_le_map.mpr (hX_meas i)
  set g : ℕ → ℕ := fun k => n + k + 1
  have hST : Disjoint (Set.Iic n) (↑(SF.image g) : Set ℕ) := by
    simp only [Set.disjoint_left, Set.mem_Iic, Finset.coe_image, Set.mem_image, g]
    intro x hx ⟨k, _, hk⟩; omega
  have hindep : Indep (⨆ i ∈ Set.Iic n, m' i) (⨆ i ∈ (↑(SF.image g) : Set ℕ), m' i) μ :=
    indep_iSup_of_disjoint hle hX_ind hST
  have hTn_meas : @MeasurableSet Ω (⨆ i ∈ Set.Iic n, m' i) {ω | T ω = n} := by
    have h1 : @MeasurableSet Ω (f n) {ω : Ω | T ω = n} := by
      have : {ω : Ω | T ω = n} = {ω : Ω | (T ω : ℕ∞) = ↑n} := by ext ω; simp [Nat.cast_inj]
      rw [this]; exact hT.measurableSet_eq n
    have h3 : (⨆ i ∈ Finset.range (n + 1), m' i) ≤ (⨆ i ∈ Set.Iic n, m' i) := by
      apply biSup_mono; intro i hi
      simp only [Finset.mem_range] at hi; simp only [Set.mem_Iic]; omega
    exact h3 _ (hfX n _ h1)
  have hB_meas : @MeasurableSet Ω (⨆ i ∈ (↑(SF.image g) : Set ℕ), m' i)
      (⋂ k ∈ SF, (X (n + k + 1)) ⁻¹' sets k) := by
    apply MeasurableSet.biInter (Finset.countable_toSet SF)
    intro k hk
    have hmem : g k ∈ SF.image g := Finset.mem_image_of_mem g hk
    have hle' : m' (g k) ≤ ⨆ i ∈ (↑(SF.image g) : Set ℕ), m' i :=
      le_biSup (f := m') (Finset.mem_coe.mpr hmem)
    apply hle'; rw [MeasurableSpace.measurableSet_comap]
    exact ⟨sets k, hsets k hk, rfl⟩
  rw [(hindep.indepSet_of_measurableSet hTn_meas hB_meas).measure_inter_eq_mul]
  congr 1
  have htail : iIndepFun (m := fun _ => ‹MeasurableSpace S›) (fun k => X (n + k + 1)) μ := by
    have hinj : Function.Injective g := by intro a b h; simp only [g] at h; omega
    exact hX_ind.precomp hinj
  exact htail.measure_inter_preimage_eq_mul SF (fun k hk => hsets k hk)

/-- **Preimage measures of a post-stopping-time variable.** Let $\mu$ be a probability measure on
a measurable space $\Omega$, let $(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a filtration on $\Omega$,
and let $X_0, X_1, X_2, \dots$ be measurable maps from $\Omega$ to a measurable space $S$ that are
mutually independent and identically distributed under $\mu$. Suppose that for every $n$ the
σ-algebra $\mathcal{F}_n$ is contained in the σ-algebra generated by $X_0, \dots, X_n$, and let
$T : \Omega \to \mathbb{N}$ be a stopping time for $(\mathcal{F}_n)$. Then for every
$k \in \mathbb{N}$ and every measurable set $A \subseteq S$,
$\mu(\{\omega : X_{T(\omega)+k+1}(\omega) \in A\}) = \mu(X_0^{-1}(A))$. -/
lemma postStoppingTimeSeq_preimage_eq
    {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    [IsProbabilityMeasure μ]
    (k : ℕ) (A : Set S) (hA : MeasurableSet A) :
    μ ((postStoppingTimeSeq X T k) ⁻¹' A) = μ ((X 0) ⁻¹' A) := by
  have decomp : (postStoppingTimeSeq X T k) ⁻¹' A =
      ⋃ n, {ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A := by
    ext ω
    simp only [postStoppingTimeSeq, Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff,
      Set.mem_ofPred_eq]
    exact ⟨fun h => ⟨T ω, rfl, h⟩, fun ⟨n, hn, h⟩ => hn ▸ h⟩
  rw [decomp]
  rw [measure_iUnion₀ (fun i j hij => (Disjoint.aedisjoint (by
    simp only [Set.disjoint_left, Set.mem_inter_iff, Set.mem_ofPred_eq]
    intro ω ⟨hi, _⟩ ⟨hj, _⟩; exact hij (hi.symm.trans hj))))
    (fun n => ((measurableSet_stoppingTime_eq hT n).nullMeasurableSet).inter
      ((hX_meas (n + k + 1) hA).nullMeasurableSet))]
  have key : ∀ n, μ ({ω | T ω = n} ∩ (X (n + k + 1)) ⁻¹' A) =
      μ {ω | T ω = n} * μ ((X 0) ⁻¹' A) := by
    intro n
    rw [indep_stopping_time_tail X f T hX_ind hX_meas hT hfX n k A hA]
    congr 1; exact (hX_id (n + k + 1) 0).measure_preimage_eq hA
  simp_rw [key, ENNReal.tsum_mul_right]
  have hsum : ∑' n, μ {ω | T ω = n} = 1 := by
    rw [← measure_iUnion (fun i j hij => by
      simp only [Function.onFun, Set.disjoint_left, Set.mem_ofPred_eq]
      intro ω hi hj; exact hij (hi.symm.trans hj))
      (fun n => measurableSet_stoppingTime_eq hT n)]
    have : ⋃ n, {ω : Ω | T ω = n} = Set.univ := by ext ω; simp [Set.mem_iUnion]
    rw [this]; exact measure_univ
  rw [hsum, one_mul]

/-- **Strong Markov property for i.i.d. sequences: independence after a stopping time.** Let $\mu$
be a probability measure on a measurable space $\Omega$, let $(\mathcal{F}_n)_{n \in \mathbb{N}}$
be a filtration on $\Omega$, and let $X_0, X_1, X_2, \dots$ be measurable maps from $\Omega$ to a
measurable space $S$ that are mutually independent and identically distributed under $\mu$.
Suppose that for every $n$ the σ-algebra $\mathcal{F}_n$ is contained in the σ-algebra generated
by $X_0, \dots, X_n$, and let $T : \Omega \to \mathbb{N}$ be a stopping time for
$(\mathcal{F}_n)$. Then the maps $Y_k(\omega) = X_{T(\omega)+k+1}(\omega)$, $k \in \mathbb{N}$,
are mutually independent under $\mu$. -/
theorem strong_markov_iid_iIndepFun
    {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    [IsProbabilityMeasure μ] :
    iIndepFun (m := fun _ => ‹MeasurableSpace S›) (postStoppingTimeSeq X T) μ := by
  rw [iIndepFun_iff_measure_inter_preimage_eq_mul]
  intro SF sets hsets
  have decomp : ⋂ k ∈ SF, (postStoppingTimeSeq X T k) ⁻¹' sets k =
      ⋃ n, {ω | T ω = n} ∩ ⋂ k ∈ SF, (X (n + k + 1)) ⁻¹' sets k := by
    ext ω
    simp only [postStoppingTimeSeq, Set.mem_iInter, Set.mem_preimage, Set.mem_iUnion,
      Set.mem_inter_iff, Set.mem_ofPred_eq]
    constructor
    · intro h; exact ⟨T ω, rfl, fun k hk => h k hk⟩
    · rintro ⟨n, hn, h⟩ k hk; rw [hn]; exact h k hk
  rw [decomp]
  have hdisj : Pairwise (Function.onFun Disjoint
      (fun n => {ω | T ω = n} ∩ ⋂ k ∈ SF, (X (n + k + 1)) ⁻¹' sets k)) := by
    intro i j hij
    simp only [Function.onFun, Set.disjoint_left, Set.mem_inter_iff, Set.mem_ofPred_eq]
    intro ω ⟨hi, _⟩ ⟨hj, _⟩; exact hij (hi.symm.trans hj)
  have hnull : ∀ n, NullMeasurableSet
      ({ω | T ω = n} ∩ ⋂ k ∈ SF, (X (n + k + 1)) ⁻¹' sets k) μ := by
    intro n
    apply NullMeasurableSet.inter
    · exact (measurableSet_stoppingTime_eq hT n).nullMeasurableSet
    · exact (MeasurableSet.biInter (Finset.countable_toSet SF)
        (fun k hk => hX_meas (n + k + 1) (hsets k hk))).nullMeasurableSet
  rw [measure_iUnion₀ (fun i j hij => (hdisj hij).aedisjoint) hnull]
  have key : ∀ n, μ ({ω | T ω = n} ∩ ⋂ k ∈ SF, (X (n + k + 1)) ⁻¹' sets k) =
      μ {ω | T ω = n} * ∏ k ∈ SF, μ ((X 0) ⁻¹' sets k) := by
    intro n
    rw [indep_stopping_time_tail_finset X f T hX_ind hX_meas hT hfX n SF sets hsets]
    congr 1
    apply Finset.prod_congr rfl
    intro k hk
    exact (hX_id (n + k + 1) 0).measure_preimage_eq (hsets k hk)
  simp_rw [key, ENNReal.tsum_mul_right]
  have hsum : ∑' n, μ {ω | T ω = n} = 1 := by
    rw [← measure_iUnion (fun i j hij => by
      simp only [Function.onFun, Set.disjoint_left, Set.mem_ofPred_eq]
      intro ω hi hj; exact hij (hi.symm.trans hj))
      (fun n => measurableSet_stoppingTime_eq hT n)]
    have : ⋃ n, {ω : Ω | T ω = n} = Set.univ := by ext ω; simp [Set.mem_iUnion]
    rw [this]; exact measure_univ
  rw [hsum, one_mul]
  apply Finset.prod_congr rfl
  intro k hk
  exact (postStoppingTimeSeq_preimage_eq hX_id hX_ind hX_meas hT hfX k (sets k) (hsets k hk)).symm

/-- **Strong Markov property for i.i.d. sequences: the post-stopping-time sequence is i.i.d.**
Let $\mu$ be a probability measure on a measurable space $\Omega$, let
$(\mathcal{F}_n)_{n \in \mathbb{N}}$ be a filtration on $\Omega$, and let
$X_0, X_1, X_2, \dots$ be measurable maps from $\Omega$ to a measurable space $S$ that are
mutually independent and identically distributed under $\mu$. Suppose that for every $n$ the
σ-algebra $\mathcal{F}_n$ is contained in the σ-algebra generated by $X_0, \dots, X_n$, and let
$T : \Omega \to \mathbb{N}$ be a stopping time for $(\mathcal{F}_n)$. Then the
post-stopping-time sequence $Y_k(\omega) = X_{T(\omega)+k+1}(\omega)$, $k \in \mathbb{N}$, is
again i.i.d. with the law of $X_0$: each $Y_k$ has the same distribution under $\mu$ as $X_0$,
and $(Y_k)_{k \in \mathbb{N}}$ is mutually independent under $\mu$. -/
theorem strong_markov_iid_postStoppingTimeSeq
    {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    [IsProbabilityMeasure μ] :
    (∀ k, IdentDistrib (postStoppingTimeSeq X T k) (X 0) μ μ) ∧
    iIndepFun (m := fun _ => ‹MeasurableSpace S›) (postStoppingTimeSeq X T) μ :=
  ⟨fun k => strong_markov_iid_identDistrib hX_id hX_ind hX_meas hT hfX k,
   strong_markov_iid_iIndepFun hX_id hX_ind hX_meas hT hfX⟩

end ProbabilityTheory
