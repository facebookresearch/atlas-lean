module

public import Mathlib.MeasureTheory.MeasurableSpace.Constructions
public import Mathlib.Topology.Defs.Basic

/-!
# Spin and bond configuration spaces

For an index type `E` (the sites or edges of a graph), `ConfigSpace E = E → Bool` is the space
of `{0, 1}`-valued configurations, with the product topology and the product σ-algebra. It is a
compact Hausdorff space (Tychonoff), and for countable `E` it is metrizable, second countable and
standard Borel; all of these are found by instance search from the Pi-type instances in Mathlib.

## Main definitions

* `StatMech.ConfigSpace E`: the configuration space `E → Bool`.
* `StatMech.ConfigSpace.eval e`: the coordinate projection `ω ↦ ω e`.

## Main results

* `StatMech.ConfigSpace.measurableSpace_eq_iSup_comap`: the σ-algebra is generated by the
  coordinate projections.
-/

@[expose] public section

open MeasureTheory TopologicalSpace

namespace StatMech

/-- The configuration space `E → Bool` of a statistical-mechanics model with sites (or bonds)
indexed by `E`, carrying the product topology and the product σ-algebra. -/
abbrev ConfigSpace (E : Type*) : Type _ := E → Bool

namespace ConfigSpace

variable {E : Type*}

/-- The coordinate projection `ω ↦ ω e` of a configuration at the site `e`. -/
def eval (e : E) (ω : ConfigSpace E) : Bool := ω e

@[simp] lemma eval_apply (e : E) (ω : ConfigSpace E) : eval e ω = ω e := rfl

/-- The product σ-algebra on `ConfigSpace E` is generated by the coordinate projections; this
holds by definition of `MeasurableSpace.pi`. -/
theorem measurableSpace_eq_iSup_comap :
    (inferInstance : MeasurableSpace (ConfigSpace E))
      = ⨆ e, MeasurableSpace.comap (eval e) inferInstance := rfl

end ConfigSpace

end StatMech
