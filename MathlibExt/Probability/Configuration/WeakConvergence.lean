module

public import MathlibExt.Probability.Configuration.ConfigSpace

/-!
# Weak convergence of probability measures on configuration space

A sequence of probability measures on `ConfigSpace E` converges weakly to `ν` if it converges in
the topology of `MeasureTheory.ProbabilityMeasure`, i.e. if the integrals of all bounded continuous
functions converge. `WeakConvergesTo` is a name for this convergence used throughout the
infinite-volume constructions; the characterization by integrals is Mathlib's
`MeasureTheory.ProbabilityMeasure.tendsto_iff_forall_integral_tendsto`.

## Main definitions

* `StatMech.WeakConvergesTo μ ν`: the sequence `μ` converges weakly to `ν`.

## Main results

* `StatMech.WeakConvergesTo.tendsto_integral`: integrals of bounded continuous functions converge.
* `StatMech.weakConvergesTo_of_forall_tendsto_integral`: the converse.
-/

@[expose] public section

open MeasureTheory Filter Topology BoundedContinuousFunction
open scoped ENNReal NNReal

namespace StatMech

variable {E : Type*} [Countable E]

/-- Weak convergence of a sequence of probability measures on `ConfigSpace E`: convergence in the
topology of `ProbabilityMeasure (ConfigSpace E)`, whose open sets are generated by the integrals of
bounded continuous functions. -/
def WeakConvergesTo (μ : ℕ → ProbabilityMeasure (ConfigSpace E))
    (ν : ProbabilityMeasure (ConfigSpace E)) : Prop :=
  Tendsto μ atTop (𝓝 ν)

/-- Under weak convergence, the integral of every bounded continuous function converges. -/
theorem WeakConvergesTo.tendsto_integral
    {μ : ℕ → ProbabilityMeasure (ConfigSpace E)} {ν : ProbabilityMeasure (ConfigSpace E)}
    (h : WeakConvergesTo μ ν) (f : (ConfigSpace E) →ᵇ ℝ) :
    Tendsto (fun n => ∫ x, f x ∂(μ n : Measure (ConfigSpace E))) atTop
      (𝓝 (∫ x, f x ∂(ν : Measure (ConfigSpace E)))) :=
  ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.1 h f

/-- If the integral of every bounded continuous function converges, the measures converge
weakly. -/
theorem weakConvergesTo_of_forall_tendsto_integral
    {μ : ℕ → ProbabilityMeasure (ConfigSpace E)} {ν : ProbabilityMeasure (ConfigSpace E)}
    (h : ∀ f : (ConfigSpace E) →ᵇ ℝ,
        Tendsto (fun n => ∫ x, f x ∂(μ n : Measure (ConfigSpace E))) atTop
          (𝓝 (∫ x, f x ∂(ν : Measure (ConfigSpace E))))) :
    WeakConvergesTo μ ν :=
  ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.2 h

end StatMech
