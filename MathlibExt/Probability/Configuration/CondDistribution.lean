module

public import MathlibExt.Probability.Configuration.ConfigSpace
public import Mathlib.Probability.Kernel.Condexp

/-!
# Conditional distributions given the outside of a region

For a finite measure `μ` on `ConfigSpace E` (`E` countable, so the space is standard Borel) and a
region `Λ ⊆ E`, Mathlib's `condExpKernel` gives a regular conditional distribution of the
configuration given the coordinates outside `Λ`. These kernels are the objects of the
Dobrushin–Lanford–Ruelle (DLR) description of Gibbs measures.

## Main definitions

* `StatMech.outsideSigma Λ`: the σ-algebra generated by the coordinates outside `Λ`.
* `StatMech.gibbsConditional μ Λ`: the regular conditional distribution of `μ` given
  `outsideSigma Λ`.

## Main results

* `StatMech.gibbsConditional_comp_trim`, `StatMech.gibbsConditional_compProd_trim`:
  disintegration of `μ`.
* `StatMech.gibbsConditional_ae_eq_condExp`: the kernel computes conditional probabilities.

For conditional distributions of a random variable given another, see
`ProbabilityTheory.condDistrib` and `MathlibExt/Probability/RegularConditionalDistribution.lean`.

## References

* H.-O. Georgii, *Gibbs Measures and Phase Transitions*, de Gruyter, 1988, Chapter 2.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory MeasurableSpace

namespace StatMech

section ConfigSpace

variable {E : Type*} [Countable E]

/-- The σ-algebra on `ConfigSpace E` generated by the coordinates outside `Λ`: the information
about a configuration that is visible from outside the region `Λ`. -/
@[reducible] noncomputable def outsideSigma (Λ : Set E) : MeasurableSpace (ConfigSpace E) :=
  ⨆ e ∈ Λᶜ, MeasurableSpace.comap (ConfigSpace.eval e) inferInstance

omit [Countable E] in
/-- The outside σ-algebra is a sub-σ-algebra of the product σ-algebra. -/
theorem outsideSigma_le (Λ : Set E) :
    outsideSigma Λ ≤ (inferInstance : MeasurableSpace (ConfigSpace E)) :=
  iSup₂_le fun e _ => (measurable_pi_apply e).comap_le

/-- The conditional distribution of a finite measure `μ` on `ConfigSpace E` given the
configuration outside `Λ`: a regular version of `μ(· | outsideSigma Λ)`, namely Mathlib's
`condExpKernel μ (outsideSigma Λ)`. For a Gibbs measure this is the Gibbs specification in `Λ`
(DLR condition). -/
noncomputable def gibbsConditional (μ : Measure (ConfigSpace E)) [IsFiniteMeasure μ]
    (Λ : Set E) : @Kernel (ConfigSpace E) (ConfigSpace E) (outsideSigma Λ) _ :=
  condExpKernel μ (outsideSigma Λ)

/-- `gibbsConditional μ Λ` is a Markov kernel. -/
instance isMarkovKernel_gibbsConditional
    (μ : Measure (ConfigSpace E)) [IsFiniteMeasure μ] (Λ : Set E) :
    @IsMarkovKernel (ConfigSpace E) (ConfigSpace E) (outsideSigma Λ) _ (gibbsConditional μ Λ) := by
  unfold gibbsConditional
  infer_instance

/-- Disintegration: averaging the conditional distribution over `μ` gives back `μ`. -/
theorem gibbsConditional_comp_trim
    (μ : Measure (ConfigSpace E)) [IsFiniteMeasure μ] (Λ : Set E) :
    gibbsConditional μ Λ ∘ₘ μ.trim (outsideSigma_le Λ) = μ := by
  unfold gibbsConditional
  exact condExpKernel_comp_trim (μ := μ) (outsideSigma_le Λ)

/-- Disintegration in product form: `μ.trim ⊗ₘ gibbsConditional μ Λ` is the law of `(ω, ω)`. -/
theorem gibbsConditional_compProd_trim
    (μ : Measure (ConfigSpace E)) [IsFiniteMeasure μ] (Λ : Set E) :
    (μ.trim (outsideSigma_le Λ)) ⊗ₘ (gibbsConditional μ Λ)
      = @Measure.map (ConfigSpace E) (ConfigSpace E × ConfigSpace E) _
          ((outsideSigma Λ).prod inferInstance) (fun ω ↦ (id ω, id ω)) μ := by
  unfold gibbsConditional
  exact compProd_trim_condExpKernel (μ := μ) (outsideSigma_le Λ)

/-- `gibbsConditional μ Λ` is a version of the conditional probability `μ⟦s | outsideSigma Λ⟧`. -/
theorem gibbsConditional_ae_eq_condExp
    (μ : Measure (ConfigSpace E)) [IsFiniteMeasure μ] (Λ : Set E)
    {s : Set (ConfigSpace E)} (hs : MeasurableSet s) :
    (fun ω ↦ ((gibbsConditional μ Λ) ω).real s) =ᵐ[μ] μ⟦s | outsideSigma Λ⟧ := by
  unfold gibbsConditional
  exact condExpKernel_ae_eq_condExp (μ := μ) (outsideSigma_le Λ) hs

end ConfigSpace

end StatMech
