/-!
# A natural-germ zero-one law for continuous processes with independent increments

For a continuous process `B` with independent increments, a probability law,
a deterministic a.e. initial value, and adaptedness to a filtration, every
natural-germ event has probability `0` or `1`. The natural germ is
`⋂_{t > 0} σ(B_u : u ≤ t)`. The proof uses independence, path continuity,
dominated convergence and a pi-lambda argument.

Source: Durrett, *Probability: Theory and Examples*, Lecture 36, and the
archived formulation in `v1/Atlas/TheoryOfProbability/code/Blumenthal01.lean`.
The theorem here is a general independent-increment-process form of the
classical Brownian natural-filtration zero-one law. Brownian motion is a
mathematical special case; its actual Gaussian increment law and Wiener
measure construction are outside the formalization in this file.

## Corrections to the archived specification and scope

The archived structure named `IsBrownianMotion` required only that each
increment's pushforward measure equal some measure. Choosing that same
pushforward satisfies this field for every process. The corrected
`IsContinuousIndependentIncrementProcess` retains all five meaningful fields
and drops this tautology, without imposing a Gaussian or stationary law.

The archived arbitrary-filtration zero-one statement is false under its
encoded weak specification. The importing tests construct a fair Boolean
probability space with the constant zero process and constant top filtration.
The coin event has probability `1/2` and belongs to the coin-augmented germ.
The natural germ of the same process is trivial. The theorem below keeps the
natural-filtration scope and the complete original proof of that valid result.
-/

/-- The *germ σ-algebra at `0`* of a filtration `𝓕` indexed by `NNReal`,
defined as the intersection `⨅_{t > 0} 𝓕_t`. For Brownian motion this is the
`𝓕_0^+` σ-algebra of events observable "immediately after" time `0`. Ported
verbatim from `v1/Atlas/TheoryOfProbability/code/Blumenthal01.lean`. -/
@[reducible]
def germSigmaAlgebraZero {Ω : Type*} {m : MeasurableSpace Ω} (𝓕 : Filtration NNReal m) :
    MeasurableSpace Ω :=
  ⨅ t > (0 : NNReal), 𝓕 t

/-- A continuous process `B : NNReal → Ω → E` with independent increments,
started at `x` and adapted to `𝓕`. The measure is a probability measure,
`B 0 = x` a.e., each increment after `s` is independent of `𝓕 s`, and a.e.
paths are continuous. These are the five meaningful fields of the archived
v1 specification; its tautological pushforward-law field is omitted.
No Gaussian-law or stationary-increment condition is encoded. -/
structure IsContinuousIndependentIncrementProcess
    {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*}
    [MeasurableSpace E] [AddCommGroup E] [TopologicalSpace E]
    (B : NNReal → Ω → E) (𝓕 : Filtration NNReal m) (μ : Measure Ω) (x : E) : Prop where
  isProbabilityMeasure : IsProbabilityMeasure μ
  start : ∀ᵐ ω ∂μ, B 0 ω = x
  adapted : Adapted 𝓕 (fun t => B t)
  indep_incr : ∀ s t : NNReal, s < t →
    Indep (𝓕 s) (MeasurableSpace.comap (fun ω => B t ω - B s ω) inferInstance) μ
  continuous_path : ∀ᵐ ω ∂μ, Continuous (fun t : NNReal => B t ω)

/-- Each coordinate of the adapted continuous process is measurable. -/
theorem IsContinuousIndependentIncrementProcess.measurable
    {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*}
    [MeasurableSpace E] [AddCommGroup E] [TopologicalSpace E]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) (t : NNReal) :
    Measurable (B t) :=
  (hBM.adapted t).mono (𝓕.le t) le_rfl

/-- The σ-algebra generated by the past `𝓕 (τ 0)` together with the consecutive
increments of `B` along `τ`, indexed by `Option (Fin k)` (`none` for the past). -/
@[instance_reducible]
private def incrSigma {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E]
    [AddCommGroup E] {k : ℕ} (𝓕 : Filtration NNReal m) (B : NNReal → Ω → E)
    (τ : Fin (k + 1) → NNReal) : Option (Fin k) → MeasurableSpace Ω
  | none => 𝓕 (τ 0)
  | some j => MeasurableSpace.comap (fun ω => B (τ j.succ) ω - B (τ j.castSucc) ω) inferInstance

/-- Telescoping: the sum of the consecutive increments up to `p` is the
total increment from `0` to `p.succ`. -/
private theorem sum_Iic_increments {Ω : Type*} {E : Type*} [AddCommGroup E] {k : ℕ}
    {B : NNReal → Ω → E} {τ : Fin (k + 1) → NNReal} {p : Fin k} {ω : Ω} :
    ∑ j ∈ Finset.Iic p, (B (τ j.succ) ω - B (τ j.castSucc) ω)
      = B (τ p.succ) ω - B (τ 0) ω := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · exact Fin.elim0 p
  · obtain ⟨k', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk)
    induction p using Fin.induction with
    | zero =>
      have hIic : Finset.Iic (0 : Fin (k' + 1)) = {0} := by
        ext j
        simp only [Finset.mem_Iic, Finset.mem_singleton, Fin.le_def, Fin.val_zero, Fin.ext_iff]
        omega
      rw [hIic, Finset.sum_singleton]
      simp
    | succ i ih =>
      have hIic : Finset.Iic (i.succ : Fin (k' + 1)) =
          insert i.succ (Finset.Iic (i.castSucc : Fin (k' + 1))) := by
        ext j
        simp only [Finset.mem_Iic, Finset.mem_insert, Fin.le_def, Fin.val_succ,
          Fin.val_castSucc, Fin.ext_iff]
        omega
      have hnot : i.succ ∉ Finset.Iic (i.castSucc : Fin (k' + 1)) := by
        simp only [Finset.mem_Iic, Fin.le_def, Fin.val_succ, Fin.val_castSucc]
        omega
      rw [hIic, Finset.sum_insert hnot, ih]
      have hcast : (i.succ : Fin (k' + 1)).castSucc = (i.castSucc : Fin (k' + 1)).succ :=
        Fin.castSucc_succ i
      rw [hcast]
      abel

/-- The past and the consecutive increments along a strictly increasing
partition are jointly independent. The proof peels off the maximal increment:
everything else is measurable with respect to its left endpoint's filtration,
which is independent of that increment by `IsContinuousIndependentIncrementProcess.indep_incr`. -/
private theorem iIndep_incrSigma {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*}
    [MeasurableSpace E] [AddCommGroup E] [TopologicalSpace E] [BorelSpace E]
    [SecondCountableTopology E] [ContinuousSub E] {k : ℕ} {𝓕 : Filtration NNReal m}
    {B : NNReal → Ω → E} {μ : Measure Ω} {x : E} {τ : Fin (k + 1) → NNReal}
    (hτ : StrictMono τ) (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) :
    iIndep (incrSigma 𝓕 B τ) μ := by
  have _ := hBM.isProbabilityMeasure
  rw [iIndep_iff]
  intro s
  apply Finset.strongInduction (p := fun s => ∀ {f : Option (Fin k) → Set Ω},
    (∀ i ∈ s, MeasurableSet[incrSigma 𝓕 B τ i] (f i)) →
    μ (⋂ i ∈ s, f i) = ∏ i ∈ s, μ (f i))
  intro s IH f hf
  rcases s.eq_empty_or_nonempty with rfl | hs
  · simp
  · by_cases hex : ∃ kk : Fin k, (some kk : Option (Fin k)) ∈ s
    · obtain ⟨kk₀, hkk₀⟩ := hex
      set T : Finset (Fin k) :=
        Finset.univ.filter (fun j => (some j : Option (Fin k)) ∈ s) with hT
      have hTne : T.Nonempty :=
        ⟨kk₀, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hkk₀⟩⟩
      set kk := T.max' hTne with hkk
      have hkk_mem : (some kk : Option (Fin k)) ∈ s :=
        (Finset.mem_filter.mp (Finset.max'_mem T hTne)).2
      have hsplit : s = insert (some kk) (s.erase (some kk)) :=
        (Finset.insert_erase hkk_mem).symm
      have hIH := IH (s.erase (some kk)) (Finset.erase_ssubset hkk_mem)
        (fun i hi => hf i (Finset.mem_of_mem_erase hi))
      rw [hsplit, Finset.set_biInter_insert, Finset.prod_insert (Finset.notMem_erase _ _),
        ← hIH]
      apply IndepSet.measure_inter_eq_mul
      -- independence of the past+previous increments from the `kk`-th increment
      have hsup : (⨆ i ∈ s.erase (some kk), incrSigma 𝓕 B τ i) ≤ 𝓕 (τ kk.castSucc) := by
        apply iSup₂_le
        intro i hi
        have hmem : i ∈ s := Finset.mem_of_mem_erase hi
        cases i with
        | none =>
          show 𝓕 (τ 0) ≤ 𝓕 (τ kk.castSucc)
          exact 𝓕.mono (hτ.monotone (Fin.zero_le _))
        | some j =>
          have hjT : j ∈ T := by
            rw [hT]
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hmem⟩
          have hj : j ≤ kk := Finset.le_max' T _ hjT
          have hjne : j ≠ kk := by
            intro h
            exact (Finset.mem_erase.mp hi).1 (by rw [h])
          have hjlt : j < kk := lt_of_le_of_ne hj hjne
          have hle2 : j.succ ≤ kk.castSucc := by
            rw [Fin.le_def, Fin.val_succ, Fin.val_castSucc]
            omega
          have hmeas : Measurable[𝓕 (τ j.succ)]
              (fun ω => B (τ j.succ) ω - B (τ j.castSucc) ω) := by
            apply Measurable.sub (hBM.adapted _)
            exact (hBM.adapted _).mono
              (𝓕.mono (hτ.monotone (Fin.castSucc_le_succ j))) le_rfl
          show MeasurableSpace.comap (fun ω => B (τ j.succ) ω - B (τ j.castSucc) ω)
              inferInstance ≤ 𝓕 (τ kk.castSucc)
          exact le_trans (measurable_iff_comap_le.mp hmeas)
            (𝓕.mono (hτ.monotone hle2))
      have hindep : Indep (𝓕 (τ kk.castSucc)) (incrSigma 𝓕 B τ (some kk)) μ := by
        show Indep (𝓕 (τ kk.castSucc))
          (MeasurableSpace.comap (fun ω => B (τ kk.succ) ω - B (τ kk.castSucc) ω)
            inferInstance) μ
        exact hBM.indep_incr _ _ (hτ (Fin.castSucc_lt_succ (i := kk)))
      have hIndep : Indep (⨆ i ∈ s.erase (some kk), incrSigma 𝓕 B τ i)
          (incrSigma 𝓕 B τ (some kk)) μ :=
        indep_of_indep_of_le_left hindep hsup
      exact hIndep.symm.indepSet_of_measurableSet (hf _ hkk_mem)
        (Finset.measurableSet_biInter _ (fun i hi => by
          have hle : incrSigma 𝓕 B τ i
              ≤ ⨆ i ∈ s.erase (some kk), incrSigma 𝓕 B τ i :=
            le_iSup_of_le i (le_iSup_of_le hi le_rfl)
          exact hle _ (hf i (Finset.mem_of_mem_erase hi))))
    · have hsub : s ⊆ {none} := by
        intro a ha
        rw [Finset.mem_singleton]
        cases a with
        | none => rfl
        | some x => exact absurd ⟨x, ha⟩ hex
      rcases Finset.subset_singleton_iff.mp hsub with rfl | rfl
      · simp
      · simp

/-- The natural filtration of a process: `𝓕^nat_t = σ(B_u : u ≤ t)`. Unlike
Mathlib's `Filtration.natural`, this is built from measurability rather than
strong measurability, which is all that is available from adaptedness. -/
def naturalFiltration {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E]
    (B : NNReal → Ω → E) (hB : ∀ t, Measurable (B t)) : Filtration NNReal m where
  seq t := ⨆ (u : NNReal) (_ : u ≤ t), MeasurableSpace.comap (B u) inferInstance
  mono' := by
    intro a b hab
    show (⨆ (u : NNReal) (_ : u ≤ a), MeasurableSpace.comap (B u) inferInstance) ≤ _
    apply iSup₂_le
    intro u hu
    exact le_iSup_of_le u (le_iSup_of_le (le_trans hu hab) le_rfl)
  le' t := by
    show (⨆ (u : NNReal) (_ : u ≤ t), MeasurableSpace.comap (B u) inferInstance) ≤ _
    apply iSup₂_le
    intro u hu
    exact measurable_iff_comap_le.mp (hB u)

/-- The germ σ-algebra of the natural filtration of `B`. -/
@[instance_reducible]
def naturalGerm {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E]
    (B : NNReal → Ω → E) (hB : ∀ t, Measurable (B t)) : MeasurableSpace Ω :=
  germSigmaAlgebraZero (naturalFiltration B hB)

/-- Each `B u` is measurable with respect to the natural filtration at any
later time `t`. -/
theorem measurable_naturalFiltration {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*}
    [MeasurableSpace E] {B : NNReal → Ω → E} (hB : ∀ t, Measurable (B t)) {t u : NNReal}
    (hu : u ≤ t) : Measurable[naturalFiltration B hB t] (B u) := by
  rw [measurable_iff_comap_le]
  exact le_iSup_of_le u (le_iSup_of_le hu le_rfl)

/-- The natural filtration is contained in any filtration to which `B` is
adapted. -/
theorem naturalFiltration_le {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*}
    [MeasurableSpace E] [AddCommGroup E] [TopologicalSpace E]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x)
    (hB : ∀ t, Measurable (B t)) (t : NNReal) :
    naturalFiltration B hB t ≤ 𝓕 t := by
  apply iSup₂_le
  intro u hu
  exact le_trans (measurable_iff_comap_le.mp (hBM.adapted u)) (𝓕.mono hu)

/-- The germ σ-algebra is contained in every positive-time component of the
filtration. -/
theorem germ_le_of_pos {Ω : Type*} {m : MeasurableSpace Ω} (𝓕 : Filtration NNReal m)
    {t : NNReal} (ht : 0 < t) : germSigmaAlgebraZero 𝓕 ≤ 𝓕 t :=
  iInf₂_le t ht

/-- An increment `B t - B s` is measurable with respect to `𝓕 t`. -/
private theorem measurable_increment {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*}
    [MeasurableSpace E] [AddCommGroup E] [TopologicalSpace E] [BorelSpace E]
    [SecondCountableTopology E] [ContinuousSub E]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) {s t : NNReal} (h : s ≤ t) :
    Measurable[𝓕 t] (fun ω => B t ω - B s ω) :=
  (hBM.adapted t).sub ((hBM.adapted s).mono (𝓕.mono h) le_rfl)


/-- The tuple `(B (u i))_{i : ι}` as a function of `ω`. -/
private def tupleMap {Ω : Type*} {E : Type*} {ι : Type*} (B : NNReal → Ω → E)
    (u : ι → NNReal) : Ω → (ι → E) := fun ω i => B (u i) ω

/-- The shifted tuple `((B (u i) - B t₀) + x)_{i : ι}` as a function of `ω`. -/
private def shiftedTuple {Ω : Type*} {E : Type*} [AddCommGroup E] {ι : Type*}
    (B : NNReal → Ω → E) (u : ι → NNReal) (t₀ : NNReal) (x : E) : Ω → (ι → E) :=
  fun ω i => (B (u i) ω - B t₀ ω) + x

/-- The cumulative-sum map: from the consecutive increments along a partition
to the tuple of total increments from `t₀`. -/
private def cumulMap {E : Type*} [AddCommGroup E] {ι : Type*} {F : Finset NNReal}
    (p : ι → Fin F.card) (x : E) : (Fin F.card → E) → (ι → E) :=
  fun δ i => (∑ j ∈ Finset.Iic (p i), δ j) + x

/-- The consecutive-increment tuple along `τ` as a function of `ω`. -/
private def incrTuple {Ω : Type*} {E : Type*} [AddCommGroup E] {F : Finset NNReal}
    (B : NNReal → Ω → E) (τ : Fin (F.card + 1) → NNReal) : Ω → (Fin F.card → E) :=
  fun ω j => B (τ j.succ) ω - B (τ j.castSucc) ω

/-- The times `1, 1/2, 1/3, …` used to approach `0`. -/
private noncomputable def approxTime (n : ℕ) : NNReal := ((n : ℝ≥0) + 1)⁻¹

private theorem approxTime_pos (n : ℕ) : 0 < approxTime n := by
  show 0 < ((n : ℝ≥0) + 1)⁻¹
  positivity

private theorem approxTime_tendsto : Tendsto approxTime atTop (𝓝 (0 : ℝ≥0)) := by
  show Tendsto (fun n : ℕ => ((n : ℝ≥0) + 1)⁻¹) atTop (𝓝 (0 : ℝ≥0))
  have h1 : Tendsto (fun n : ℕ => (n : ℝ≥0) + 1) atTop (atTop : Filter ℝ≥0) := by
    rw [tendsto_atTop]
    intro b
    obtain ⟨N, hN⟩ := exists_nat_ge b
    exact eventually_atTop.2 ⟨N, fun n hn =>
      le_trans hN (le_trans (Nat.cast_le.mpr hn) (le_add_of_nonneg_right zero_le_one))⟩
  exact tendsto_inv_atTop_zero.comp h1

/-- The partition of `F ∪ {t₀}` sorted increasingly: `t₀` first, then the
elements of `F` in increasing order. -/
private noncomputable def partitionMap (F : Finset NNReal) (t₀ : NNReal) :
    Fin (F.card + 1) → NNReal :=
  fun j => if h : (j : ℕ) = 0 then t₀
    else F.orderEmbOfFin rfl ⟨(j : ℕ) - 1, by have hj := j.2; omega⟩

private theorem partitionMap_zero (F : Finset NNReal) (t₀ : NNReal) :
    partitionMap F t₀ 0 = t₀ := by
  simp [partitionMap]

private theorem partitionMap_eq_of_ne {F : Finset NNReal} {t₀ : NNReal}
    {j : Fin (F.card + 1)} (hj : (j : ℕ) ≠ 0) :
    partitionMap F t₀ j = F.orderEmbOfFin rfl ⟨(j : ℕ) - 1, by have hjj := j.2; omega⟩ := by
  unfold partitionMap
  exact dite_eq_right hj

private theorem partitionMap_succ (F : Finset NNReal) (t₀ : NNReal) (j : Fin F.card) :
    partitionMap F t₀ j.succ = F.orderEmbOfFin rfl j := by
  calc partitionMap F t₀ j.succ
      = F.orderEmbOfFin rfl ⟨(j.succ : ℕ) - 1, by
          have hjj := j.succ.2
          have h0 : (j.succ : ℕ) ≠ 0 := by simp
          omega⟩ :=
        partitionMap_eq_of_ne (by simp)
    _ = F.orderEmbOfFin rfl j := by congr 1

private theorem strictMono_partitionMap {F : Finset NNReal} {t₀ : NNReal}
    (ht : ∀ x ∈ F, t₀ < x) : StrictMono (partitionMap F t₀) := by
  intro a b hab
  have habv : (a : ℕ) < (b : ℕ) := hab
  by_cases ha : (a : ℕ) = 0
  · rw [show a = 0 from Fin.ext ha, partitionMap_zero]
    have hb : (b : ℕ) ≠ 0 := by omega
    rw [partitionMap_eq_of_ne hb]
    have hmem : F.orderEmbOfFin rfl ⟨(b : ℕ) - 1, by have hjj := b.2; omega⟩ ∈ F :=
      Finset.orderEmbOfFin_mem F rfl ⟨(b : ℕ) - 1, by have hjj := b.2; omega⟩
    exact ht _ hmem
  · have hb : (b : ℕ) ≠ 0 := by omega
    rw [partitionMap_eq_of_ne ha, partitionMap_eq_of_ne hb]
    apply (Finset.orderEmbOfFin F rfl).strictMono
    rw [Fin.mk_lt_mk]
    omega

/-- **Key estimate.** For a germ event `A` and a tuple of *positive* times,
`∫ 1_A * f(B_u) = (∫ 1_A) * ∫ f(B_u)` for every bounded continuous `f`.
The proof approximates `B (u i)` by `(B (u i) - B (t_n)) + x` with `t_n → 0`:
the approximand depends only on increments after `t_n`, hence is independent
of `A`, and converges a.e. by path continuity and `B 0 = x`. -/
private theorem integral_indicator_mul_continuous
    {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E] [AddCommGroup E]
    [TopologicalSpace E] [BorelSpace E] [SecondCountableTopology E] [ContinuousAdd E]
    [ContinuousSub E] {ι : Type*} [Fintype ι]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) (hB : ∀ t, Measurable (B t))
    {A : Set Ω} (hA : MeasurableSet[naturalGerm B hB] A)
    {u : ι → NNReal} (hu : ∀ i, 0 < u i)
    {f : (ι → E) → ℝ} (hf_cont : Continuous f) (hf_bdd : ∃ C, ∀ y, |f y| ≤ C) :
    ∫ ω, (A.indicator 1 ω) * f (tupleMap B u ω) ∂μ
      = (∫ ω, A.indicator 1 ω ∂μ) * (∫ ω, f (tupleMap B u ω) ∂μ) := by
  obtain ⟨Cf, hCf⟩ := hf_bdd
  have _ := hBM.isProbabilityMeasure
  rcases isEmpty_or_nonempty ι with hem | hne
  · have hconst : ∀ ω, f (tupleMap B u ω) = f (fun _ => (0 : E)) := by
      intro ω
      congr 1
      funext i
      exact IsEmpty.elim inferInstance i
    simp only [hconst]
    rw [integral_mul_const]
    have hInt : (∫ _ : Ω, f (fun _ => (0 : E)) ∂μ) = f (fun _ => (0 : E)) := by
      rw [integral_const]
      show (μ univ).toReal • f (fun _ => (0 : E)) = f (fun _ => (0 : E))
      rw [measure_univ, ENNReal.toReal_one, one_smul]
    rw [hInt]
  · have _ := hne
    set F : Finset NNReal := Finset.image u Finset.univ with hF
    have hFne : F.Nonempty := Finset.univ_nonempty.image u
    set δ : NNReal := F.min' hFne with hδ
    have hδpos : 0 < δ := by
      rw [Finset.lt_min'_iff]
      intro y hy
      rw [Finset.mem_image] at hy
      obtain ⟨i, _, rfl⟩ := hy
      exact hu i
    have hpos : ∀ i : ι, ∃ p : Fin F.card, F.orderEmbOfFin rfl p = u i := by
      intro i
      have hmem : u i ∈ (↑F : Set NNReal) := by
        rw [Finset.mem_coe, hF]
        exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
      rw [← Finset.range_orderEmbOfFin F rfl] at hmem
      exact Set.mem_range.mp hmem
    choose p hp using hpos
    -- the independence identity at time `approxTime n`, for `approxTime n < δ`
    have key : ∀ n : ℕ, approxTime n < δ →
        ∫ ω, (A.indicator 1 ω) * (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ
          = (∫ ω, A.indicator 1 ω ∂μ)
            * (∫ ω, (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ) := by
      intro n hn
      -- shifted tuple = cumulative sums of consecutive increments
      have hcomp : shiftedTuple B u (approxTime n) x
          = cumulMap p x ∘ incrTuple B (partitionMap F (approxTime n)) := by
        funext ω i
        show (B (u i) ω - B (approxTime n) ω) + x
            = (∑ j ∈ Finset.Iic (p i), incrTuple B (partitionMap F (approxTime n)) ω j) + x
        rw [show incrTuple B (partitionMap F (approxTime n)) ω
            = fun j => B (partitionMap F (approxTime n) j.succ) ω
                - B (partitionMap F (approxTime n) j.castSucc) ω from rfl,
          sum_Iic_increments, partitionMap_succ, partitionMap_zero, hp i]
      -- the cumulative-sum map is continuous, hence measurable
      have hΨcont : Continuous (cumulMap p x) := by
        apply continuous_pi
        intro i
        exact (continuous_finsetSum _ (fun j _ => continuous_apply j)).add continuous_const
      -- comap bound: the shifted tuple depends only on the increments
      have hcomap : MeasurableSpace.comap (shiftedTuple B u (approxTime n) x)
            (borel (ι → E))
          ≤ ⨆ o ∈ ({none}ᶜ : Set (Option (Fin F.card))),
            incrSigma 𝓕 B (partitionMap F (approxTime n)) o := by
        calc MeasurableSpace.comap (shiftedTuple B u (approxTime n) x) (borel (ι → E))
            = MeasurableSpace.comap (incrTuple B (partitionMap F (approxTime n)))
                (MeasurableSpace.comap (cumulMap p x) (borel (ι → E))) := by
              rw [hcomp, ← MeasurableSpace.comap_comp]
          _ ≤ MeasurableSpace.comap (incrTuple B (partitionMap F (approxTime n)))
                (borel (Fin F.card → E)) := by
              apply MeasurableSpace.comap_mono
              rw [← measurable_iff_comap_le, ← BorelSpace.measurable_eq,
                ← BorelSpace.measurable_eq]
              exact hΨcont.measurable
          _ = ⨆ j : Fin F.card, MeasurableSpace.comap
                (fun ω => B (partitionMap F (approxTime n) j.succ) ω
                  - B (partitionMap F (approxTime n) j.castSucc) ω) inferInstance := by
              rw [← BorelSpace.measurable_eq, MeasurableSpace.pi,
                MeasurableSpace.comap_iSup]
              apply iSup_congr
              intro j
              rw [MeasurableSpace.comap_comp]
              rfl
          _ ≤ ⨆ o ∈ ({none}ᶜ : Set (Option (Fin F.card))),
                incrSigma 𝓕 B (partitionMap F (approxTime n)) o := by
              apply iSup_le
              intro j
              exact le_iSup_of_le (some j) (le_iSup_of_le (by simp) le_rfl)
      -- independence of the natural filtration at `approxTime n` from the increments
      have hτmono : StrictMono (partitionMap F (approxTime n)) :=
        strictMono_partitionMap (fun y hy => lt_of_lt_of_le hn (Finset.min'_le F y hy))
      have hPart : iIndep (incrSigma 𝓕 B (partitionMap F (approxTime n))) μ :=
        iIndep_incrSigma hτmono hBM
      have hle : ∀ o : Option (Fin F.card),
          incrSigma 𝓕 B (partitionMap F (approxTime n)) o ≤ m := by
        intro o
        cases o with
        | none => exact 𝓕.le _
        | some j =>
          exact measurable_iff_comap_le.mp
            ((measurable_increment hBM (hτmono.monotone (Fin.castSucc_le_succ j))).mono
              (𝓕.le _) le_rfl)
      have hSup : Indep (𝓕 (approxTime n))
          (⨆ o ∈ ({none}ᶜ : Set (Option (Fin F.card))),
            incrSigma 𝓕 B (partitionMap F (approxTime n)) o) μ := by
        have h := indep_iSup_of_disjoint hle hPart (S := ({none} : Set (Option (Fin F.card))))
          (T := ({none}ᶜ : Set (Option (Fin F.card)))) disjoint_compl_right
        have hsup1 : 𝓕 (partitionMap F (approxTime n) 0)
            ≤ ⨆ o ∈ ({none} : Set (Option (Fin F.card))),
              incrSigma 𝓕 B (partitionMap F (approxTime n)) o :=
          le_iSup_of_le none (le_iSup_of_le (Set.mem_singleton none) le_rfl)
        have h' := indep_of_indep_of_le_left h hsup1
        rwa [partitionMap_zero] at h'
      have hInd : Indep (naturalFiltration B hB (approxTime n))
          (MeasurableSpace.comap (shiftedTuple B u (approxTime n) x) (borel (ι → E))) μ :=
        indep_of_indep_of_le hSup (naturalFiltration_le hBM hB _) hcomap
      -- upgrade to independence of the two functions, then integrate
      have hA' : MeasurableSet[naturalFiltration B hB (approxTime n)] A :=
        (germ_le_of_pos (naturalFiltration B hB) (approxTime_pos n)) _ hA
      have hIndepFun : (A.indicator (1 : Ω → ℝ)) ⟂ᵢ[μ]
          (f ∘ shiftedTuple B u (approxTime n) x) := by
        show Indep (MeasurableSpace.comap (A.indicator (1 : Ω → ℝ)) inferInstance)
          (MeasurableSpace.comap (f ∘ shiftedTuple B u (approxTime n) x) inferInstance) μ
        apply indep_of_indep_of_le hInd
        · rw [← measurable_iff_comap_le]
          exact Measurable.indicator measurable_const hA'
        · rw [← MeasurableSpace.comap_comp]
          apply MeasurableSpace.comap_mono
          rw [← measurable_iff_comap_le, ← BorelSpace.measurable_eq]
          exact hf_cont.measurable
      have hA_amb : MeasurableSet A :=
        ((naturalFiltration B hB).le 1) _ ((germ_le_of_pos (naturalFiltration B hB) one_pos) _ hA)
      have hX : AEStronglyMeasurable (A.indicator (1 : Ω → ℝ)) μ :=
        (Measurable.indicator measurable_const hA_amb).aestronglyMeasurable
      have hY : AEStronglyMeasurable (f ∘ shiftedTuple B u (approxTime n) x) μ :=
        (hf_cont.measurable.comp (Measurable.of_eval (fun i =>
          ((hBM.measurable (u i)).sub (hBM.measurable (approxTime n))).add
            measurable_const))).aestronglyMeasurable
      exact hIndepFun.integral_mul_eq_mul_integral hX hY
    -- dominated convergence: the approximands converge a.e. to `f (tupleMap B u)`
    have hev : ∀ᶠ n in atTop, approxTime n < δ :=
      approxTime_tendsto.eventually (Iio_mem_nhds hδpos)
    have heq : (fun n => ∫ ω, (A.indicator 1 ω)
          * (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ) =ᶠ[atTop]
        (fun n => (∫ ω, A.indicator 1 ω ∂μ)
          * (∫ ω, (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ)) :=
      hev.mono (fun n hn => key n hn)
    have htuple_of : ∀ ω : Ω, Continuous (fun t => B t ω) → B 0 ω = x →
        Tendsto (fun n => shiftedTuple B u (approxTime n) x ω) atTop (𝓝 (tupleMap B u ω)) := by
      intro ω hcont h0
      have hBt : Tendsto (fun n => B (approxTime n) ω) atTop (𝓝 x) := by
        have h1 : Tendsto (fun n => B (approxTime n) ω) atTop (𝓝 (B 0 ω)) :=
          (hcont.tendsto 0).comp approxTime_tendsto
        rwa [h0] at h1
      rw [tendsto_pi_nhds]
      intro i
      show Tendsto (fun n => (B (u i) ω - B (approxTime n) ω) + x) atTop (𝓝 (B (u i) ω))
      have h3 := ((tendsto_const_nhds (x := B (u i) ω)).sub hBt).add
        (tendsto_const_nhds (x := x))
      rwa [sub_add_cancel] at h3
    have hDCT1 : Tendsto (fun n => ∫ ω, (A.indicator 1 ω)
          * (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ) atTop
        (𝓝 (∫ ω, (A.indicator 1 ω) * f (tupleMap B u ω) ∂μ)) := by
      apply tendsto_integral_of_dominated_convergence (fun _ => Cf)
      · intro n
        exact ((Measurable.indicator measurable_const
          (((naturalFiltration B hB).le 1) _ ((germ_le_of_pos (naturalFiltration B hB) one_pos) _ hA))).mul
          (hf_cont.measurable.comp (Measurable.of_eval (fun i =>
            ((hBM.measurable (u i)).sub (hBM.measurable (approxTime n))).add
              measurable_const)))).aestronglyMeasurable
      · exact integrable_const Cf
      · intro n
        filter_upwards with ω
        have h1 : ‖((A.indicator (1 : Ω → ℝ)) ω)‖ ≤ 1 := by
          by_cases hω : ω ∈ A <;> simp [hω, Set.indicator_of_mem, Set.indicator_of_notMem]
        have h2 : ‖(f ∘ shiftedTuple B u (approxTime n) x) ω‖ ≤ Cf := by
          show |f (shiftedTuple B u (approxTime n) x ω)| ≤ Cf
          exact hCf _
        calc ‖(A.indicator 1 ω) * (f ∘ shiftedTuple B u (approxTime n) x) ω‖
            = ‖(A.indicator 1 ω)‖ * ‖(f ∘ shiftedTuple B u (approxTime n) x) ω‖ :=
              norm_mul _ _
          _ ≤ 1 * Cf := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
          _ = Cf := one_mul _
      · filter_upwards [Filter.Eventually.and hBM.continuous_path hBM.start] with ω hω
        obtain ⟨hcont, h0⟩ := hω
        have htuple := htuple_of ω hcont h0
        exact tendsto_const_nhds.mul ((hf_cont.tendsto _).comp htuple)
    have hDCT2 : Tendsto (fun n => ∫ ω, (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ) atTop
        (𝓝 (∫ ω, f (tupleMap B u ω) ∂μ)) := by
      apply tendsto_integral_of_dominated_convergence (fun _ => Cf)
      · intro n
        exact (hf_cont.measurable.comp (Measurable.of_eval (fun i =>
          ((hBM.measurable (u i)).sub (hBM.measurable (approxTime n))).add
            measurable_const))).aestronglyMeasurable
      · exact integrable_const Cf
      · intro n
        filter_upwards with ω
        show |f (shiftedTuple B u (approxTime n) x ω)| ≤ Cf
        exact hCf _
      · filter_upwards [Filter.Eventually.and hBM.continuous_path hBM.start] with ω hω
        obtain ⟨hcont, h0⟩ := hω
        have htuple := htuple_of ω hcont h0
        exact (hf_cont.tendsto _).comp htuple
    have hR : Tendsto (fun n => (∫ ω, A.indicator 1 ω ∂μ)
          * (∫ ω, (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ)) atTop
        (𝓝 ((∫ ω, A.indicator 1 ω ∂μ) * (∫ ω, f (tupleMap B u ω) ∂μ))) :=
      tendsto_const_nhds.mul hDCT2
    have hL' : Tendsto (fun n => (∫ ω, A.indicator 1 ω ∂μ)
          * (∫ ω, (f ∘ shiftedTuple B u (approxTime n) x) ω ∂μ)) atTop
        (𝓝 (∫ ω, (A.indicator 1 ω) * f (tupleMap B u ω) ∂μ)) :=
      hDCT1.congr' heq
    exact tendsto_nhds_unique hL' hR


/-- The continuous approximants of the indicator of an open cylinder:
`∏ i, min 1 (n * infDist (·) (O i)ᶜ)`, with the value `1` when `O i` is
the whole space (so that `infDist` is not used on the empty complement). -/
private noncomputable def openApprox {E : Type*} [PseudoMetricSpace E] {ι : Type*} [Fintype ι]
    (O : ι → Set E) (n : ℕ) (y : ι → E) : ℝ :=
  ∏ i, (if (O i)ᶜ = ∅ then 1 else min 1 ((n : ℝ) * Metric.infDist (y i) ((O i)ᶜ)))

private theorem continuous_openApprox {E : Type*} [PseudoMetricSpace E] {ι : Type*}
    [Fintype ι] (O : ι → Set E) (n : ℕ) : Continuous (openApprox O n) := by
  apply continuous_finsetProd
  intro i _
  by_cases hi : (O i)ᶜ = ∅
  · simp only [hi, ite_true]
    exact continuous_const
  · simp only [hi, ite_false]
    exact continuous_const.min
      (continuous_const.mul ((Metric.continuous_infDist_pt _).comp (continuous_apply i)))

private theorem openApprox_le_one {E : Type*} [PseudoMetricSpace E] {ι : Type*}
    [Fintype ι] (O : ι → Set E) (n : ℕ) (y : ι → E) : |openApprox O n y| ≤ 1 := by
  have hfactor_nonneg : ∀ i, 0 ≤
      (if (O i)ᶜ = ∅ then (1 : ℝ) else min 1 ((n : ℝ) * Metric.infDist (y i) ((O i)ᶜ))) := by
    intro i
    by_cases hi : (O i)ᶜ = ∅
    · simp only [hi, ite_true]; exact zero_le_one
    · simp only [hi, ite_false]
      exact le_min zero_le_one (mul_nonneg (Nat.cast_nonneg n) Metric.infDist_nonneg)
  have hfactor_le : ∀ i,
      (if (O i)ᶜ = ∅ then (1 : ℝ) else min 1 ((n : ℝ) * Metric.infDist (y i) ((O i)ᶜ))) ≤ 1 := by
    intro i
    by_cases hi : (O i)ᶜ = ∅
    · simp [hi]
    · simp only [hi, ite_false]; exact min_le_left _ _
  have hnn : 0 ≤ openApprox O n y := Finset.prod_nonneg (fun i _ => hfactor_nonneg i)
  have hle : openApprox O n y ≤ 1 :=
    Finset.prod_le_one₀ (fun i _ => hfactor_nonneg i) (fun i _ => hfactor_le i)
  rw [abs_of_nonneg hnn]
  exact hle

/-- `(A.indicator 1) * (C.indicator 1) = (A ∩ C).indicator 1`, pointwise. -/
private theorem indicator_one_mul {Ω : Type*} (A C : Set Ω) (ω : Ω) :
    ((A.indicator (1 : Ω → ℝ)) ω) * ((C.indicator (1 : Ω → ℝ)) ω)
      = ((A ∩ C).indicator (1 : Ω → ℝ)) ω := by
  by_cases hA : ω ∈ A <;> by_cases hC : ω ∈ C <;> simp [hA, hC]

/-- For a germ event `A` and an open cylinder `C` over positive times,
`μ (A ∩ C) = μ A * μ C`. The proof approximates the cylinder indicator by
the continuous functions `openApprox O n` and applies the key estimate. -/
private theorem measure_inter_open_cylinder
    {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E] [AddCommGroup E]
    [PseudoMetricSpace E] [BorelSpace E] [SecondCountableTopology E] [ContinuousAdd E]
    [ContinuousSub E] {ι : Type*} [Fintype ι]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) (hB : ∀ t, Measurable (B t))
    {A : Set Ω} (hA : MeasurableSet[naturalGerm B hB] A)
    {u : ι → NNReal} (hu : ∀ i, 0 < u i)
    {O : ι → Set E} (hO : ∀ i, IsOpen (O i)) :
    μ (A ∩ {ω | ∀ i, B (u i) ω ∈ O i}) = μ A * μ {ω | ∀ i, B (u i) ω ∈ O i} := by
  have _ := hBM.isProbabilityMeasure
  set C : Set Ω := {ω | ∀ i, B (u i) ω ∈ O i} with hCdef
  have hA_amb : MeasurableSet A :=
    ((naturalFiltration B hB).le 1) _ ((germ_le_of_pos (naturalFiltration B hB) one_pos) _ hA)
  have hC_meas : MeasurableSet C := by
    have hCeq : C = ⋂ i, (B (u i))⁻¹' (O i) := by
      ext ω
      simp only [hCdef, Set.mem_ofPred_eq, Set.mem_iInter, Set.mem_preimage]
    rw [hCeq]
    exact MeasurableSet.iInter (fun i => (hBM.measurable (u i)) (hO i).measurableSet)
  rcases isEmpty_or_nonempty ι with hem | hne
  · have hC : C = Set.univ := by
      rw [hCdef]
      ext ω
      exact iff_of_true (fun i => IsEmpty.elim inferInstance i) (Set.mem_univ ω)
    rw [hC, Set.inter_univ, measure_univ, mul_one]
  · -- the approximants converge pointwise to the cylinder indicator
    have hconv : ∀ ω : Ω, Tendsto (fun n => openApprox O n (tupleMap B u ω)) atTop
        (𝓝 ((C.indicator (1 : Ω → ℝ)) ω)) := by
      intro ω
      by_cases hω : ∀ i, B (u i) ω ∈ O i
      · have hωC : ω ∈ C := hω
        rw [Set.indicator_of_mem hωC]
        show Tendsto (fun n => openApprox O n (tupleMap B u ω)) atTop (𝓝 (1 : ℝ))
        have hfactor : ∀ i, Tendsto (fun (n : ℕ) =>
            (if (O i)ᶜ = ∅ then (1 : ℝ)
              else min 1 ((n : ℝ) * Metric.infDist (B (u i) ω) ((O i)ᶜ)))) atTop
            (𝓝 1) := by
          intro i
          by_cases hi : (O i)ᶜ = ∅
          · simp only [hi, ite_true]
            exact tendsto_const_nhds
          · have hd : 0 < Metric.infDist (B (u i) ω) ((O i)ᶜ) := by
              apply ((hO i).isClosed_compl.notMem_iff_infDist_pos
                (Set.nonempty_iff_ne_empty.mpr hi)).mp
              simp [hω i]
            have hlim : Tendsto (fun n : ℕ => (n : ℝ) * Metric.infDist (B (u i) ω) ((O i)ᶜ))
                atTop atTop :=
              tendsto_natCast_atTop_atTop.atTop_mul_const hd
            have hev : ∀ᶠ (n : ℕ) in atTop,
                (1 : ℝ) < (n : ℝ) * Metric.infDist (B (u i) ω) ((O i)ᶜ) :=
              hlim.eventually (eventually_gt_atTop 1)
            have heq : (fun _ : ℕ => (1 : ℝ)) =ᶠ[atTop] (fun n =>
                if (O i)ᶜ = ∅ then (1 : ℝ)
                  else min 1 ((n : ℝ) * Metric.infDist (B (u i) ω) ((O i)ᶜ))) := by
              filter_upwards [hev] with n hn
              simp only [hi, ite_false]
              exact (min_eq_left (le_of_lt hn)).symm
            exact tendsto_const_nhds.congr' heq
        have hprod : Tendsto (fun n => openApprox O n (tupleMap B u ω)) atTop (𝓝 1) := by
          show Tendsto (fun (n : ℕ) => ∏ i, (if (O i)ᶜ = ∅ then (1 : ℝ)
              else min 1 ((n : ℝ) * Metric.infDist (B (u i) ω) ((O i)ᶜ)))) atTop (𝓝 1)
          have h := tendsto_finsetProd Finset.univ (fun i _ => hfactor i)
          rwa [Finset.prod_const_one] at h
        exact hprod
      · obtain ⟨i₀, hi₀⟩ := not_forall.mp hω
        have hωC : ω ∉ C := hω
        rw [Set.indicator_of_notMem hωC]
        have hfac0 : ∀ n, (if (O i₀)ᶜ = ∅ then (1 : ℝ)
            else min 1 ((n : ℝ) * Metric.infDist (B (u i₀) ω) ((O i₀)ᶜ))) = 0 := by
          intro n
          have hne : (O i₀)ᶜ ≠ ∅ :=
            Set.nonempty_iff_ne_empty.mp ⟨B (u i₀) ω, hi₀⟩
          simp only [hne, ite_false]
          rw [Metric.infDist_zero_of_mem hi₀, mul_zero]
          exact min_eq_right zero_le_one
        have h0seq : ∀ n, openApprox O n (tupleMap B u ω) = 0 := by
          intro n
          show (∏ i, (if (O i)ᶜ = ∅ then (1 : ℝ)
              else min 1 ((n : ℝ) * Metric.infDist (B (u i) ω) ((O i)ᶜ)))) = 0
          exact Finset.prod_eq_zero (Finset.mem_univ i₀) (hfac0 n)
        have heq0 : (fun _ : ℕ => (0 : ℝ)) =ᶠ[atTop]
            (fun n => openApprox O n (tupleMap B u ω)) :=
          Filter.Eventually.of_forall (fun n => (h0seq n).symm)
        exact tendsto_const_nhds.congr' heq0
    -- apply the key estimate per approximand, then dominated convergence
    have hper : ∀ n, ∫ ω, ((A.indicator (1 : Ω → ℝ)) ω)
          * (openApprox O n (tupleMap B u ω)) ∂μ
        = (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω) ∂μ)
          * (∫ ω, openApprox O n (tupleMap B u ω) ∂μ) :=
      fun n => integral_indicator_mul_continuous hBM hB hA hu (continuous_openApprox O n)
        ⟨1, fun y => openApprox_le_one O n y⟩
    have hDCT1 : Tendsto (fun n => ∫ ω, ((A.indicator (1 : Ω → ℝ)) ω)
          * (openApprox O n (tupleMap B u ω)) ∂μ) atTop
        (𝓝 (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω) * ((C.indicator (1 : Ω → ℝ)) ω) ∂μ)) := by
      apply tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ))
      · intro n
        exact ((Measurable.indicator measurable_const hA_amb).mul
          ((continuous_openApprox O n).measurable.comp
            (Measurable.of_eval fun i => hBM.measurable (u i)))).aestronglyMeasurable
      · exact integrable_const 1
      · intro n
        filter_upwards with ω
        have h1 : ‖((A.indicator (1 : Ω → ℝ)) ω)‖ ≤ 1 := by
          by_cases hω : ω ∈ A <;> simp [hω, Set.indicator_of_mem, Set.indicator_of_notMem]
        have h2 : ‖openApprox O n (tupleMap B u ω)‖ ≤ 1 := by
          rw [Real.norm_eq_abs]
          exact openApprox_le_one O n _
        calc ‖((A.indicator (1 : Ω → ℝ)) ω) * openApprox O n (tupleMap B u ω)‖
            = ‖((A.indicator (1 : Ω → ℝ)) ω)‖ * ‖openApprox O n (tupleMap B u ω)‖ :=
              norm_mul _ _
          _ ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
          _ = 1 := mul_one _
      · filter_upwards with ω
        exact tendsto_const_nhds.mul (hconv ω)
    have hDCT2 : Tendsto (fun n => ∫ ω, openApprox O n (tupleMap B u ω) ∂μ) atTop
        (𝓝 (∫ ω, ((C.indicator (1 : Ω → ℝ)) ω) ∂μ)) := by
      apply tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ))
      · intro n
        exact (((continuous_openApprox O n).measurable.comp
          (Measurable.of_eval fun i => hBM.measurable (u i)))).aestronglyMeasurable
      · exact integrable_const 1
      · intro n
        filter_upwards with ω
        rw [Real.norm_eq_abs]
        exact openApprox_le_one O n _
      · filter_upwards with ω
        exact hconv ω
    have heq : (fun n => ∫ ω, ((A.indicator (1 : Ω → ℝ)) ω)
          * (openApprox O n (tupleMap B u ω)) ∂μ) =ᶠ[atTop]
        (fun n => (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω) ∂μ)
          * (∫ ω, openApprox O n (tupleMap B u ω) ∂μ)) :=
      Filter.Eventually.of_forall hper
    have hR := (tendsto_const_nhds
      (x := ∫ ω, ((A.indicator (1 : Ω → ℝ)) ω) ∂μ)).mul hDCT2
    have hL' := hDCT1.congr' heq
    have hIntegral : (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω)
          * ((C.indicator (1 : Ω → ℝ)) ω) ∂μ)
        = (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω) ∂μ)
          * (∫ ω, ((C.indicator (1 : Ω → ℝ)) ω) ∂μ) :=
      tendsto_nhds_unique hL' hR
    -- convert the integral identity to a measure identity
    have hEq : (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω)
          * ((C.indicator (1 : Ω → ℝ)) ω) ∂μ) = (μ (A ∩ C)).toReal := by
      have h2 : (fun ω => ((A.indicator (1 : Ω → ℝ)) ω)
            * ((C.indicator (1 : Ω → ℝ)) ω))
          = (A ∩ C).indicator (1 : Ω → ℝ) :=
        funext (indicator_one_mul A C)
      rw [h2]
      rw [show (A ∩ C).indicator (1 : Ω → ℝ)
          = (A ∩ C).indicator (fun _ => (1 : ℝ)) from rfl]
      rw [integral_indicator_const (1 : ℝ) (hA_amb.inter hC_meas), smul_eq_mul, mul_one]
      rfl
    have hEqA : (∫ ω, ((A.indicator (1 : Ω → ℝ)) ω) ∂μ) = (μ A).toReal := by
      rw [show (A.indicator (1 : Ω → ℝ)) = A.indicator (fun _ => (1 : ℝ)) from rfl]
      rw [integral_indicator_const (1 : ℝ) hA_amb, smul_eq_mul, mul_one]
      rfl
    have hEqC : (∫ ω, ((C.indicator (1 : Ω → ℝ)) ω) ∂μ) = (μ C).toReal := by
      rw [show (C.indicator (1 : Ω → ℝ)) = C.indicator (fun _ => (1 : ℝ)) from rfl]
      rw [integral_indicator_const (1 : ℝ) hC_meas, smul_eq_mul, mul_one]
      rfl
    have hfin : (μ (A ∩ C)).toReal = ((μ A) * (μ C)).toReal := by
      rw [← hEq, hIntegral, hEqA, hEqC, ENNReal.toReal_mul]
    exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top μ _)
      (ENNReal.mul_ne_top (measure_ne_top μ _) (measure_ne_top μ _))).mp hfin

/-- The π-system of finite intersections of open cylinders with times `≤ s`,
used for the π–λ argument below. -/
private def cylinderPiSystem {Ω : Type*} {E : Type*} [TopologicalSpace E]
    (B : NNReal → Ω → E) (s : NNReal) :
    Set (Set Ω) :=
  {C | ∃ (ι : Type) (_ : Fintype ι) (u : ι → NNReal) (O : ι → Set E),
    (∀ i, u i ≤ s) ∧ (∀ i, IsOpen (O i)) ∧ C = {ω | ∀ i, B (u i) ω ∈ O i}}

/-- Complement step for the π–λ argument. -/
private theorem measure_inter_compl_eq {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] {A t : Set Ω} (ht : MeasurableSet t)
    (h : μ (A ∩ t) = μ A * μ t) : μ (A ∩ tᶜ) = μ A * μ tᶜ := by
  apply (ENNReal.toReal_eq_toReal_iff' (measure_ne_top μ _)
    (ENNReal.mul_ne_top (measure_ne_top μ _) (measure_ne_top μ _))).mp
  rw [ENNReal.toReal_mul]
  have h1 : (μ (A ∩ tᶜ)).toReal = (μ A).toReal - (μ (A ∩ t)).toReal := by
    have hadd := measure_inter_add_sdiff (μ := μ) A ht
    rw [Set.sdiff_eq] at hadd
    have h2 : (μ (A ∩ t)).toReal + (μ (A ∩ tᶜ)).toReal = (μ A).toReal := by
      rw [← ENNReal.toReal_add (measure_ne_top μ _) (measure_ne_top μ _), hadd]
    exact eq_sub_of_add_eq' h2
  have h2 : (μ tᶜ).toReal = 1 - (μ t).toReal := by
    rw [measure_compl ht (measure_ne_top μ _),
      ENNReal.toReal_sub_of_le (measure_mono (Set.subset_univ t)) (measure_ne_top μ _),
      measure_univ, ENNReal.toReal_one]
  rw [h1, h, ENNReal.toReal_mul, h2, mul_sub, mul_one]

/-- Disjoint-union step for the π–λ argument. -/
private theorem measure_inter_iUnion_eq {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] {A : Set Ω} (hA : MeasurableSet A) {f : ℕ → Set Ω}
    (hf : Pairwise fun i j => Disjoint (f i) (f j)) (hfm : ∀ i, MeasurableSet (f i))
    (h : ∀ i, μ (A ∩ f i) = μ A * μ (f i)) :
    μ (A ∩ ⋃ i, f i) = μ A * μ (⋃ i, f i) := by
  rw [Set.inter_iUnion]
  have hdisj : Pairwise fun i j => Disjoint (A ∩ f i) (A ∩ f j) := by
    intro i j hij
    exact Set.disjoint_left.mpr fun a ha hb =>
      Set.disjoint_left.mp (hf hij) ha.2 hb.2
  rw [measure_iUnion hdisj (fun i => hA.inter (hfm i))]
  rw [measure_iUnion hf hfm, ← ENNReal.tsum_mul_left]
  exact tsum_congr h

/-- For a germ event `A` and `s : NNReal`, the measure identity holds for
every set in the natural filtration at `s`. Proved by π–λ over finite
intersections of open cylinders with times `≤ s`. -/
private theorem measure_inter_of_naturalFiltration
    {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E] [AddCommGroup E]
    [PseudoMetricSpace E] [BorelSpace E] [SecondCountableTopology E] [ContinuousAdd E]
    [ContinuousSub E]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) (hB : ∀ t, Measurable (B t))
    {A : Set Ω} (hA : MeasurableSet[naturalGerm B hB] A) (s : NNReal)
    {C : Set Ω} (hC : MeasurableSet[naturalFiltration B hB s] C) :
    μ (A ∩ C) = μ A * μ C := by
  have _ := hBM.isProbabilityMeasure
  -- the π-system generates the natural filtration at `s`
  have h_eq : naturalFiltration B hB s = MeasurableSpace.generateFrom (cylinderPiSystem B s) := by
    apply le_antisymm
    · show (⨆ (u : NNReal) (_ : u ≤ s), MeasurableSpace.comap (B u) inferInstance) ≤ _
      apply iSup₂_le
      intro u hu
      show MeasurableSpace.comap (B u) inferInstance ≤
        MeasurableSpace.generateFrom (cylinderPiSystem B s)
      rw [show (inferInstance : MeasurableSpace E)
          = MeasurableSpace.generateFrom {O | IsOpen O} from
          BorelSpace.measurable_eq.trans rfl, MeasurableSpace.comap_generateFrom]
      apply MeasurableSpace.generateFrom_le
      intro t ht
      obtain ⟨O, hO, rfl⟩ := ht
      apply MeasurableSpace.measurableSet_generateFrom
      refine ⟨PUnit, inferInstance, fun _ => u, fun _ => O, fun _ => hu, fun _ => hO, ?_⟩
      ext ω
      constructor
      · intro h i
        cases i
        exact h
      · intro h
        exact h PUnit.unit
    · apply MeasurableSpace.generateFrom_le
      intro C hC
      obtain ⟨ι, _, u, O, hu_s, hO, rfl⟩ := hC
      have hCeq : {ω | ∀ i, B (u i) ω ∈ O i} = ⋂ i, (B (u i))⁻¹' (O i) := by
        ext ω
        simp only [Set.mem_ofPred_eq, Set.mem_iInter, Set.mem_preimage]
      rw [hCeq]
      exact MeasurableSet.iInter
        (fun i => (measurable_naturalFiltration hB (hu_s i)) (hO i).measurableSet)
  -- the π-system is closed under finite intersections
  have h_inter : IsPiSystem (cylinderPiSystem B s) := by
    rintro C₁ ⟨ι₁, _, u₁, O₁, hu₁, hO₁, rfl⟩ C₂ ⟨ι₂, _, u₂, O₂, hu₂, hO₂, rfl⟩ _
    refine ⟨ι₁ ⊕ ι₂, inferInstance, Sum.elim u₁ u₂, Sum.elim O₁ O₂, ?_, ?_, ?_⟩
    · intro i
      cases i
      · exact hu₁ _
      · exact hu₂ _
    · intro i
      cases i
      · exact hO₁ _
      · exact hO₂ _
    · ext ω
      simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, Sum.forall, Sum.elim_inl, Sum.elim_inr]
  -- the basic case: cylinders (splitting off the zero-time coordinates)
  have h_basic : ∀ t ∈ cylinderPiSystem B s, μ (A ∩ t) = μ A * μ t := by
    intro t ht
    obtain ⟨ι, _, u, O, hu_s, hO, rfl⟩ := ht
    -- split the index type into positive and zero times
    -- positive part: an open cylinder with positive times
    have hCpos : μ (A ∩ {ω | ∀ i : {i // 0 < u i}, B (u i) ω ∈ O i})
        = μ A * μ {ω | ∀ i : {i // 0 < u i}, B (u i) ω ∈ O i} := by
      rcases isEmpty_or_nonempty {i // 0 < u i} with hem | hne
      · have hC : {ω | ∀ i : {i // 0 < u i}, B (u i) ω ∈ O i} = Set.univ := by
          ext ω
          exact iff_of_true (fun i => IsEmpty.elim inferInstance i) (Set.mem_univ ω)
        rw [hC, Set.inter_univ, measure_univ, mul_one]
      · exact measure_inter_open_cylinder hBM hB hA (fun i => i.2) (fun i => hO i)
    -- zero part: `B 0` is a.e. constant, so the zero cylinder is a.e. trivial
    have hC₀def : {ω | ∀ i : {i // u i = 0}, B (u i) ω ∈ O i}
        = {ω | B 0 ω ∈ ⋂ i : {i // u i = 0}, O i} := by
      ext ω
      constructor
      · intro h
        apply Set.mem_iInter.mpr
        intro i
        have h2 := h i
        rwa [i.2] at h2
      · intro h i
        rw [i.2]
        exact Set.mem_iInter.mp h i
    have hsplit : {ω | ∀ i, B (u i) ω ∈ O i}
        = {ω | ∀ i : {i // 0 < u i}, B (u i) ω ∈ O i}
          ∩ {ω | ∀ i : {i // u i = 0}, B (u i) ω ∈ O i} := by
      ext ω
      constructor
      · intro h
        exact ⟨fun i => h i, fun i => h i⟩
      · intro h i
        rcases eq_or_lt_of_le (show (0 : NNReal) ≤ u i from zero_le) with h0 | hpos
        · exact h.2 ⟨i, h0.symm⟩
        · exact h.1 ⟨i, hpos⟩
    by_cases hX : x ∈ ⋂ i : {i // u i = 0}, O i
    · -- the zero cylinder is a.e. the whole space
      have hC₀eq : {ω | ∀ i : {i // u i = 0}, B (u i) ω ∈ O i} =ᵐ[μ] Set.univ := by
        filter_upwards [hBM.start] with ω hω
        exact eq_iff_iff.mpr ⟨fun _ => Set.mem_univ ω, fun _ i => by
          rw [i.2, hω]
          exact Set.mem_iInter.mp hX i⟩
      have h1 : A ∩ ({ω | ∀ i, B (u i) ω ∈ O i})
          =ᵐ[μ] A ∩ {ω | ∀ i : {i // 0 < u i}, B (u i) ω ∈ O i} := by
        filter_upwards [hC₀eq] with ω hω
        rw [hsplit]
        show (ω ∈ A ∧ ((∀ i : {i // 0 < u i}, B (u i) ω ∈ O i) ∧
            (∀ i : {i // u i = 0}, B (u i) ω ∈ O i))) =
          (ω ∈ A ∧ (∀ i : {i // 0 < u i}, B (u i) ω ∈ O i))
        rw [hω]
        simp only [Set.mem_univ, and_true]
      have h2 : {ω | ∀ i, B (u i) ω ∈ O i}
          =ᵐ[μ] {ω | ∀ i : {i // 0 < u i}, B (u i) ω ∈ O i} := by
        filter_upwards [hC₀eq] with ω hω
        apply eq_iff_iff.mpr
        constructor
        · intro h i
          exact h i
        · intro h i
          rcases eq_or_lt_of_le (show (0 : NNReal) ≤ u i from zero_le) with h0 | hpos
          · have hU : ω ∈ Set.univ := Set.mem_univ ω
            rw [← hω] at hU
            exact hU ⟨i, h0.symm⟩
          · exact h ⟨i, hpos⟩
      rw [measure_congr h1, hCpos, measure_congr h2]
    · -- the zero cylinder is a.e. empty, hence null
      have hC₀eq : {ω | ∀ i : {i // u i = 0}, B (u i) ω ∈ O i} =ᵐ[μ] ∅ := by
        filter_upwards [hBM.start] with ω hω
        exact eq_iff_iff.mpr ⟨fun h =>
          absurd (Set.mem_iInter.mpr (fun i => by
            have h2 := h i
            rwa [i.2, hω] at h2)) hX, fun h => (Set.notMem_empty ω h).elim⟩
      have hC₀null : μ {ω | ∀ i : {i // u i = 0}, B (u i) ω ∈ O i} = 0 := by
        rw [measure_congr hC₀eq, measure_empty]
      have hnull1 : μ (A ∩ {ω | ∀ i, B (u i) ω ∈ O i}) = 0 := by
        apply measure_mono_null _ hC₀null
        rw [hsplit]
        exact Set.inter_subset_right.trans Set.inter_subset_right
      have hnull2 : μ {ω | ∀ i, B (u i) ω ∈ O i} = 0 := by
        apply measure_mono_null _ hC₀null
        rw [hsplit]
        exact Set.inter_subset_right
      rw [hnull1, hnull2, mul_zero]
  -- π–λ induction
  have hA_amb : MeasurableSet A :=
    ((naturalFiltration B hB).le 1) _ ((germ_le_of_pos (naturalFiltration B hB) one_pos) _ hA)
  have hP : ∀ t, MeasurableSet[naturalFiltration B hB s] t → μ (A ∩ t) = μ A * μ t := by
    refine MeasurableSpace.induction_on_inter
      (C := fun S _ => μ (A ∩ S) = μ A * μ S) h_eq h_inter ?_ ?_ ?_ ?_
    · simp
    · intro t ht
      exact h_basic t ht
    · intro t htm ih
      exact measure_inter_compl_eq (((naturalFiltration B hB).le s) _ htm) ih
    · intro f hfd hfm ih
      exact measure_inter_iUnion_eq hA_amb hfd
        (fun i => ((naturalFiltration B hB).le s) _ (hfm i)) ih
  exact hP C hC

/-- Every event in the natural germ of a continuous process with independent
increments and a deterministic a.e. initial value has probability `0` or `1`.
This general form includes the classical Brownian natural-filtration law. -/
theorem zero_one_naturalGerm
    {Ω : Type*} {m : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E] [AddCommGroup E]
    [PseudoMetricSpace E] [BorelSpace E] [SecondCountableTopology E] [ContinuousAdd E]
    [ContinuousSub E]
    {B : NNReal → Ω → E} {𝓕 : Filtration NNReal m} {μ : Measure Ω} {x : E}
    (hBM : IsContinuousIndependentIncrementProcess B 𝓕 μ x) (hB : ∀ t, Measurable (B t))
    {A : Set Ω} (hA : MeasurableSet[naturalGerm B hB] A) :
    μ A = 0 ∨ μ A = 1 := by
  have _ := hBM.isProbabilityMeasure
  have h1 : MeasurableSet[naturalFiltration B hB 1] A :=
    (germ_le_of_pos (naturalFiltration B hB) one_pos) _ hA
  have hA_amb : MeasurableSet A := ((naturalFiltration B hB).le 1) _ h1
  have h2 : μ (A ∩ A) = μ A * μ A :=
    measure_inter_of_naturalFiltration hBM hB hA 1 h1
  have hIndep : IndepSet A A μ :=
    (indepSet_iff_measure_inter_eq_mul hA_amb hA_amb μ).mpr h2
  exact measure_eq_zero_or_one_of_indepSet_self hIndep
end MathlibExt.Probability.BlumenthalZeroOne
