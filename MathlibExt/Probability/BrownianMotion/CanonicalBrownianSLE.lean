module

public import MathlibExt.Probability.BrownianMotion.BrownianDyadicModulus
public import MathlibExt.Analysis.Complex.Loewner.LoewnerHolomorphicDependence

/-!
# The Loewner chain driven by canonical Brownian motion

Driving the maximal Loewner equation with `W_t = √κ B̃_t` gives, for almost every `ω`, the
domains `D_t`, the hulls `K_t = ℍ \ D_t` and the maps `g_t : D_t → ℍ`. This satisfies the
definition `IsChordalSLE` (Loewner chain driven by `√κ` times a standard Brownian motion), so
chordal SLE`_κ` exists in that sense for every `κ ≥ 0`. Almost surely the hulls are compact hulls
and increase, and each `g_t` is conformal and a homeomorphism `D_t ≃ ℍ`.

All the Loewner statements are the deterministic results of `LoewnerMaximal` for a continuous
driving function, applied pathwise; the only probabilistic input is continuity of Brownian
paths. Nothing SLE-specific is proved: not that the hulls are generated by a curve
(Rohde–Schramm), nor scale invariance, nor the domain Markov property.

## Main definitions

* `StatMech.SLE.canonicalBrownianLoewnerDomain`, `canonicalBrownianLoewnerMaps`,
  `canonicalBrownianLoewnerHull`: `D_t`, `g_t` and `K_t` for the driving function `√κ B̃(ω)`.

## Main results

* `StatMech.SLE.canonicalBrownian_isChordalSLE`: `IsChordalSLE` holds for `κ ≥ 0`.

## References

* G. F. Lawler, *Conformally Invariant Processes in the Plane*, Amer. Math. Soc., 2005.
-/

@[expose] public section

open MeasureTheory
open UpperHalfPlane (upperHalfPlaneSet)

namespace StatMech.SLE

/-- The unswallowed domains `D_t` of the Loewner equation driven by `√κ B̃(ω)`. -/
noncomputable def canonicalBrownianLoewnerDomain (kappa : Real) :
    (Real → Real) → Real → Set Complex :=
  fun omega => loewnerUnswallowedDomain
    (sleDriving kappa brownianContinuousModification omega)

/-- The Loewner maps `g_t` driven by `√κ B̃(ω)`. -/
noncomputable def canonicalBrownianLoewnerMaps (kappa : Real) :
    (Real → Real) → Real → Complex → Complex :=
  fun omega => loewnerMaximalMaps
    (sleDriving kappa brownianContinuousModification omega)

/-- The hulls `K_t` (swallowed sets) of the Loewner equation driven by `√κ B̃(ω)`. -/
noncomputable def canonicalBrownianLoewnerHull (kappa : Real) :
    (Real → Real) → Real → Set Complex :=
  fun omega => loewnerSwallowedSet
    (sleDriving kappa brownianContinuousModification omega)

/-- Chordal SLE`_κ` in the sense of `IsChordalSLE` exists for every `κ ≥ 0`: the Loewner chain
driven by `√κ B̃` with the canonical Brownian motion `B̃`. -/
theorem canonicalBrownian_isChordalSLE (kappa : Real) (hkappa : 0 ≤ kappa) :
    IsChordalSLE kappa brownianContinuousModification brownianProductLaw
      (canonicalBrownianLoewnerDomain kappa)
      (canonicalBrownianLoewnerMaps kappa) := by
  refine {
    kappa_nonneg := hkappa
    isBrownian := brownianContinuousModification_isStandardBrownianMotion
    loewner := ?_ }
  filter_upwards [
    brownianContinuousModification_isStandardBrownianMotion.continuous_paths]
      with omega homega
  exact loewnerMaximalMaps_satisfiesMaximalLoewnerEquation
    (continuous_const.mul homega)

/-- Almost surely every `K_t`, `t ≥ 0`, is a compact hull. -/
theorem canonicalBrownianLoewnerHull_isCompactHull (kappa : Real) :
    ∀ᵐ omega ∂brownianProductLaw,
      ∀ t, 0 ≤ t ->
        IsCompactHull (canonicalBrownianLoewnerHull kappa omega t) := by
  filter_upwards [
    brownianContinuousModification_isStandardBrownianMotion.continuous_paths]
      with omega homega
  intro t ht
  exact loewnerSwallowedSet_isCompactHull
    (continuous_const.mul homega) ht

/-- The hulls increase in `t ≥ 0`. -/
theorem canonicalBrownianLoewnerHull_monotoneOn
    (kappa : Real) (omega : Real → Real) :
    MonotoneOn (canonicalBrownianLoewnerHull kappa omega) (Set.Ici 0) :=
  loewnerSwallowedSet_monotoneOn
    (sleDriving kappa brownianContinuousModification omega)

/-- `D_t = ℍ \ K_t`. -/
theorem canonicalBrownianLoewnerDomain_eq_complement
    (kappa : Real) (omega : Real → Real) (t : Real) :
    canonicalBrownianLoewnerDomain kappa omega t =
      upperHalfPlaneSet \ canonicalBrownianLoewnerHull kappa omega t := by
  exact (upperHalfPlane_diff_loewnerSwallowedSet
    (sleDriving kappa brownianContinuousModification omega) t).symm

/-- Almost surely each `g_t` is conformal on `D_t`. -/
theorem canonicalBrownianLoewnerMaps_conformalOn (kappa : Real) :
    ∀ᵐ omega ∂brownianProductLaw,
      ∀ t, 0 ≤ t → ∀ z,
        z ∈ canonicalBrownianLoewnerDomain kappa omega t ->
          ConformalAt (canonicalBrownianLoewnerMaps kappa omega t) z := by
  filter_upwards [
    brownianContinuousModification_isStandardBrownianMotion.continuous_paths]
      with omega homega
  intro t ht z hz
  exact loewnerMaximalMaps_conformalAt (continuous_const.mul homega) ht hz

/-- Almost surely each `g_t` is a homeomorphism `D_t ≃ ℍ`. -/
theorem canonicalBrownianLoewnerMaps_homeomorph (kappa : Real) :
    ∀ᵐ omega ∂brownianProductLaw, ∀ t, 0 ≤ t ->
      Nonempty (canonicalBrownianLoewnerDomain kappa omega t ≃ₜ
        upperHalfPlaneSet) := by
  filter_upwards [
    brownianContinuousModification_isStandardBrownianMotion.continuous_paths]
      with omega homega
  intro t ht
  exact ⟨loewnerMaximalMapsHomeomorph
    (continuous_const.mul homega) ht⟩

end StatMech.SLE
