/-!
# Extending algebra maps from an adjunction with a transcendental generator

Let `L` and `L'` be field extensions of `K`. Let `G ⊆ L` contain `1` and be
closed under multiplication, and let `θ : L → L'` be multiplicative on `G` and
preserve the finite `K`-linear relations among elements of `G`: whenever
`∑ cᵢ gᵢ = 0` for finitely many `gᵢ ∈ G` and `cᵢ ∈ K`, also `∑ cᵢ θ gᵢ = 0`.
If the field generated by `G` over `K` is algebraic over the field generated by
one element of `G` whose image under `θ` is transcendental over `K`, then some
`K`-algebra map from the field generated by `G` to `L'` agrees with `θ` on `G`.
It need not agree with `θ` off `G`: for `G` the powers of `X` in the rational
function field `K(X)` and `θ` squaring, it is the substitution `X ↦ X ^ 2`,
which sends `1 + X` to `1 + X ^ 2`, not `(1 + X) ^ 2`, when `2 ≠ 0` in `K`.
-/

@[expose] public section

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Polynomial

noncomputable section

namespace AdjoinExt


variable {K : Type*} [Field K]

-- A `Fin n`-indexed linear combination, as in `Algebra.exists_algHom_adjoin_of_linearRelations`,
-- written as a `Finsupp.sum`.
private theorem sum_single_sum_smul {R ι M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    {n : ℕ} (idx : Fin n → ι) (c : Fin n → R) (f : ι → M) :
    ((∑ l, Finsupp.single (idx l) (c l)).sum fun x r => r • f x) = ∑ l, c l • f (idx l) := by
  rw [← Finsupp.sum_finsetSum_index (h := fun x r => r • f x) (fun _ => zero_smul R _)
    fun _ _ _ => add_smul _ _ _]
  exact Finset.sum_congr rfl fun l _ => Finsupp.sum_single_index (zero_smul R _)

section Main

variable (K)

private theorem mainThm {L L' : Type*} [Field L] [Algebra K L] [Field L'] [Algebra K L']
    (G : Set L) (h1 : (1 : L) ∈ G) (hmul : ∀ x ∈ G, ∀ y ∈ G, x * y ∈ G)
    (θ : L → L') (hθ : ∀ x ∈ G, ∀ y ∈ G, θ (x * y) = θ x * θ y)
    (hlin : ∀ c : L →₀ K, (↑c.support : Set L) ⊆ G →
      (c.sum fun x r => r • x) = 0 → (c.sum fun x r => r • θ x) = 0)
    (F : IntermediateField K L) (hF : F = IntermediateField.adjoin K G)
    (x₀ : F) (hx₀G : (x₀ : L) ∈ G) (hx₀ : Transcendental K (θ x₀))
    (halg : Algebra.IsAlgebraic (IntermediateField.adjoin K ({x₀} : Set F)) F) :
    ∃ Θ : F →ₐ[K] L', ∀ x : F, (x : L) ∈ G → Θ x = θ x := by
  classical
  subst hF
  -- `θ 1` is idempotent, and nonzero because `θ x₀ = θ x₀ * θ 1` is transcendental.
  have hθ1 : θ 1 = 1 := by
    have h2 : θ 1 * θ 1 = θ 1 := by rw [← hθ 1 h1 1 h1, mul_one]
    have h3 : θ 1 * (θ 1 - 1) = 0 := by rw [mul_sub, mul_one, h2, sub_self]
    rcases mul_eq_zero.mp h3 with h | h
    · exfalso
      apply hx₀
      have : θ x₀ = 0 := by rw [← mul_one (x₀ : L), hθ _ hx₀G _ h1, h, mul_zero]
      rw [this]
      exact isAlgebraic_zero
    · exact sub_eq_zero.mp h
  -- `Algebra.exists_algHom_adjoin_of_linearRelations` with the generators `Subtype.val : G → L`.
  obtain ⟨χ, hχ⟩ := Algebra.exists_algHom_adjoin_of_linearRelations (K := K) L'
    (Subtype.val : G → L) (θ ∘ Subtype.val) ⟨⟨1, h1⟩, rfl, hθ1⟩
    (fun x y => ⟨⟨(x : L) * y, hmul x x.2 y y.2⟩, rfl, hθ x x.2 y y.2⟩) fun n idx c h => by
      have hsupp : (↑(∑ l, Finsupp.single (idx l : L) (c l)).support : Set L) ⊆ G := by
        intro x hx
        obtain ⟨l, -, hl⟩ :=
          Finset.mem_biUnion.mp (Finsupp.support_finsetSum (Finset.mem_coe.mp hx))
        rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hl)]
        exact (idx l).2
      have hc := hlin _ hsupp ((sum_single_sum_smul (fun l => (idx l : L)) c fun x => x).trans h)
      exact (sum_single_sum_smul (fun l => (idx l : L)) c θ).symm.trans hc
  -- Transport `χ` to `A = Algebra.adjoin K G`, using `Set.range Subtype.val = G`.
  set A : Subalgebra K L := Algebra.adjoin K G with hAdef
  set ΘA : A →ₐ[K] L' := χ.comp
    (Subalgebra.equivOfEq _ _ (congrArg (Algebra.adjoin K) (Subtype.range_coe (s := G)))).symm
  have hgen : ∀ (x : L) (hx : x ∈ G), ΘA ⟨x, Algebra.subset_adjoin hx⟩ = θ x :=
    fun x hx => hχ ⟨x, hx⟩
  set x₀A : A := ⟨(x₀ : L), Algebra.subset_adjoin hx₀G⟩ with hx₀A
  have hΘx₀ : ΘA x₀A = θ x₀ := hgen _ hx₀G
  -- `ΘA` is injective because `θ x₀` is transcendental and `K(G)` is algebraic over `K(x₀)`.
  have hinj : Function.Injective ΘA := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have haF : (a : L) ∈ IntermediateField.adjoin K G :=
      IntermediateField.algebra_adjoin_le_adjoin K G a.2
    set y : IntermediateField.adjoin K G := ⟨a, haF⟩ with hydef
    have hy0 : y ≠ 0 := by
      intro e
      have h' := congrArg Subtype.val e
      exact hne (Subtype.ext h')
    set E : IntermediateField K (IntermediateField.adjoin K G) :=
      IntermediateField.adjoin K ({x₀} : Set (IntermediateField.adjoin K G)) with hEdef
    set R₀ : Subalgebra K (IntermediateField.adjoin K G) :=
      Algebra.adjoin K ({x₀} : Set (IntermediateField.adjoin K G)) with hR₀def
    -- `y` is algebraic over `K[x₀]`, whose fraction field is `E = K(x₀)`.
    open scoped IntermediateField.algebraAdjoinAdjoin in
    have key : ∃ q' : Polynomial R₀, q'.coeff 0 ≠ 0 ∧ Polynomial.aeval y q' = 0 :=
      IsAlgebraic.exists_coeff_ne_zero_and_aeval_eq_zero
        ((IsFractionRing.isAlgebraic_iff R₀ E _).mpr (halg.isAlgebraic y))
        (mem_nonZeroDivisors_of_ne_zero hy0)
    obtain ⟨q', hq'0, hq'y⟩ := key
    have hcoef : ∀ i, ∃ r : Polynomial K, ((q'.coeff i : R₀) : IntermediateField.adjoin K G) =
        Polynomial.aeval x₀ r := fun i => by
      have hm : ((q'.coeff i : R₀) : IntermediateField.adjoin K G) ∈
          Algebra.adjoin K ({x₀} : Set (IntermediateField.adjoin K G)) := (q'.coeff i).2
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hm
      obtain ⟨r, hr⟩ := hm
      exact ⟨r, hr.symm⟩
    choose r hr using hcoef
    set d : ℕ := q'.natDegree + 1 with hd
    set zA : A := ∑ i ∈ Finset.range d, Polynomial.aeval x₀A (r i) * a ^ i with hzA
    have hzA0 : zA = 0 := by
      apply Subtype.ext
      have h2 : (IntermediateField.adjoin K G).val (Polynomial.aeval y q') = 0 := by
        rw [hq'y, map_zero]
      rw [Polynomial.aeval_eq_sum_range, ← hd] at h2
      change A.val zA = ((0 : A) : L)
      rw [ZeroMemClass.coe_zero, ← h2, hzA, map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, map_pow, ← Polynomial.aeval_algHom_apply, Algebra.smul_def, map_mul, map_pow]
      congr 1
      rw [hx₀A]
      change Polynomial.aeval (x₀ : L) (r i) =
        (IntermediateField.adjoin K G).val ((q'.coeff i : R₀) : IntermediateField.adjoin K G)
      rw [hr i, ← Polynomial.aeval_algHom_apply]
      rfl
    have h3 := congrArg ΘA hzA0
    rw [map_zero, hzA, map_sum] at h3
    simp only [map_mul, map_pow, ha] at h3
    rw [Finset.sum_eq_single 0 (fun i _ hi => by rw [zero_pow hi, mul_zero])
      (fun h => absurd (Finset.mem_range.mpr (Nat.succ_pos _)) h), pow_zero, mul_one,
      ← Polynomial.aeval_algHom_apply, hΘx₀] at h3
    have hr0 : r 0 = 0 := by
      by_contra hr0
      exact hx₀ ⟨r 0, hr0, h3⟩
    apply hq'0
    apply Subtype.ext
    rw [hr 0, hr0, map_zero]
    rfl
  -- Extend `ΘA` to the fraction field `K(G)` of `A`.
  open scoped IntermediateField.algebraAdjoinAdjoin in
  refine ⟨IsFractionRing.liftAlgHom (A := A) (K := IntermediateField.adjoin K G) hinj,
    fun x hx => ?_⟩
  open scoped IntermediateField.algebraAdjoinAdjoin in
  have e : x = algebraMap A (IntermediateField.adjoin K G) ⟨x, Algebra.subset_adjoin hx⟩ :=
    Subtype.ext rfl
  open scoped IntermediateField.algebraAdjoinAdjoin in
  rw [e, IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
  exact hgen _ hx

end Main

end AdjoinExt

/-- **Extending a multiplicative assignment on generators to an algebra map.** Let `L` and
`L'` be field extensions of `K`. Let `G ⊆ L` contain `1` and be closed under multiplication,
and let `θ : L → L'` be multiplicative on `G` and preserve the finite `K`-linear relations
among elements of `G`: whenever `∑ cᵢ gᵢ = 0` for finitely many `gᵢ ∈ G` and `cᵢ ∈ K`, also
`∑ cᵢ θ gᵢ = 0`. If the field generated by `G` over `K` is algebraic over the field generated
by one element of `G` whose image under `θ` is transcendental over `K`, then some `K`-algebra
map from the field generated by `G` to `L'` agrees with `θ` on `G`. It need not agree with
`θ` off `G`: for `G` the powers of `X` in the rational function field `K(X)` and `θ`
squaring, the map is the substitution `X ↦ X ^ 2`, which sends `1 + X` to `1 + X ^ 2`, not
`(1 + X) ^ 2`, when `2 ≠ 0` in `K`. -/
public theorem
    IntermediateField.exists_algHom_adjoin_apply_eq_of_isAlgebraic_of_transcendental
    (K : Type*) {L L' : Type*} [Field K] [Field L] [Algebra K L] [Field L'] [Algebra K L']
    (G : Set L) (h1 : (1 : L) ∈ G) (hmul : ∀ x ∈ G, ∀ y ∈ G, x * y ∈ G)
    (θ : L → L') (hθ : ∀ x ∈ G, ∀ y ∈ G, θ (x * y) = θ x * θ y)
    (hlin : ∀ c : L →₀ K, (↑c.support : Set L) ⊆ G →
      (c.sum fun x r => r • x) = 0 → (c.sum fun x r => r • θ x) = 0)
    (F : IntermediateField K L) (hF : F = IntermediateField.adjoin K G)
    (x₀ : F) (hx₀G : (x₀ : L) ∈ G) (hx₀ : Transcendental K (θ x₀))
    (halg : Algebra.IsAlgebraic (IntermediateField.adjoin K ({x₀} : Set F)) F) :
    ∃ Θ : F →ₐ[K] L', ∀ x : F, (x : L) ∈ G → Θ x = θ x :=
  AdjoinExt.mainThm K G h1 hmul θ hθ hlin F hF x₀ hx₀G hx₀ halg
