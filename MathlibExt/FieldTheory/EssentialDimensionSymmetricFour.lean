module

public import MathlibExt.FieldTheory.EssentialDimensionSymmetricLowerBound

/-!
# Essential dimension of the symmetric group on four letters

The general quartic has essential dimension two. Translating its roots removes the cubic
term. Scaling then makes the linear and quadratic coefficients equal, giving a descent
whose coefficient field has transcendence degree at most two.
-/

namespace MathlibExt.FieldTheory.EssentialDimensionSymmetricWanted

open MathlibExt.FieldTheory.EssentialDimensionSymmetric IntermediateField Polynomial

private abbrev K := rootsField 4
private noncomputable abbrev B := generalBaseField 4

-- After translation by the mean, these are the three coefficients below degree four.
private def quad {R : Type*} [CommRing R] (m b : R) := b - 6 * m ^ 2
private def lin {R : Type*} [CommRing R] (m b c : R) := -c + 2 * m * b - 8 * m ^ 3
private def constTerm {R : Type*} [CommRing R] (m b c d : R) :=
  d - m * c + m ^ 2 * b - 3 * m ^ 4

private noncomputable abbrev a := coeffElem 4
private noncomputable def mean : B := a 0 / 4
private noncomputable def u : B := quad mean (a 1)
private noncomputable def v : B := lin mean (a 1) (a 2)
private noncomputable def w : B := constTerm mean (a 1) (a 2) (a 3)

-- Specializing the elementary symmetric coefficients to (0, 1, 1, 0) gives u = 1, v = -1.
private lemma nonzero_coeffs : u ≠ 0 ∧ v ≠ 0 := by
  let M : MvPolynomial (Fin 4) ℂ := MvPolynomial.X 0 * MvPolynomial.C (1 / 4)
  let P := quad M (MvPolynomial.X 1) * lin M (MvPolynomial.X 1) (MvPolynomial.X 2)
  have hP : P ≠ 0 := by
    intro h
    have := congrArg (MvPolynomial.eval (![0, 1, 1, 0] : Fin 4 → ℂ)) h
    norm_num [P, M, quad, lin] at this
  have hind : AlgebraicIndependent ℂ a :=
    (algebraicIndependent_coeff 4).of_comp (generalBaseField 4).val
  have h := (map_ne_zero_iff (MvPolynomial.aeval a) hind).mpr hP
  have huv : u * v ≠ 0 := by
    have h4 : algebraMap ℂ B (4 : ℂ) = 4 := map_ofNat _ _
    simpa [P, M, u, v, mean, quad, lin, div_eq_mul_inv, h4] using h
  exact mul_ne_zero_iff.mp huv

private noncomputable def scale : B := u / v
private lemma scale_ne_zero : (scale : K) ≠ 0 := by
  exact_mod_cast div_ne_zero nonzero_coeffs.1 nonzero_coeffs.2

private noncomputable def normalized (i : Fin 4) : K := scale * (root 4 i - (mean : K))
private noncomputable def paramA : B := u * scale ^ 2
private noncomputable def paramB : B := w * scale ^ 4

private noncomputable def quartic {R : Type*} [CommRing R] (A D : R) : R[X] :=
  X ^ 4 + C A * X ^ 2 + C A * X + C D

private lemma original_eval (x : K) :
    ∏ i, (x - root 4 i) =
      x ^ 4 - (a 0 : K) * x ^ 3 + (a 1 : K) * x ^ 2 - (a 2 : K) * x + (a 3 : K) := by
  have h := congrArg (Polynomial.eval x) (map_generalPolynomial 4)
  rw [eval_prod] at h
  norm_num [generalPolynomial, coeffNat, Finset.sum_range_succ] at h
  convert h.symm using 1
  ring

private lemma normalized_factors :
    quartic (paramA : K) (paramB : K) = ∏ i, (X - C (normalized i)) := by
  have hs : (scale : K) ≠ 0 := scale_ne_zero
  have hvs : (v : K) * (scale : K) = (u : K) := by
    exact_mod_cast mul_div_cancel₀ u nonzero_coeffs.2
  let : Infinite K := Infinite.of_injective _ (algebraMap ℂ K).injective
  apply Polynomial.funext
  intro z
  simp only [quartic, eval_add, eval_mul, eval_pow, eval_X, eval_C, eval_prod, eval_sub]
  have hterm (i : Fin 4) : z - normalized i =
      (scale : K) * (z / scale + mean - root 4 i) := by
    dsimp only [normalized]
    field_simp
    ring
  simp_rw [hterm]
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    original_eval]
  have hmean : (a 0 : K) = 4 * (mean : K) := by
    have h : a 0 = 4 * mean := (mul_div_cancel₀ _ (by norm_num : (4 : B) ≠ 0)).symm
    have heq := congrArg B.val h
    simp only [map_mul, map_ofNat] at heq
    simpa only [IntermediateField.coe_val] using heq
  rw [hmean]
  have htrans (x : K) :
      x ^ 4 - 4 * (mean : K) * x ^ 3 + (a 1 : K) * x ^ 2 - (a 2 : K) * x + (a 3 : K) =
        (x - mean) ^ 4 + (u : K) * (x - mean) ^ 2 + (v : K) * (x - mean) + (w : K) := by
    change _ = _ + B.val (quad mean (a 1)) * _ + B.val (lin mean (a 1) (a 2)) * _ +
      B.val (constTerm mean (a 1) (a 2) (a 3))
    simp only [quad, lin, constTerm, map_sub, map_add, map_neg, map_mul, map_pow, map_ofNat]
    simp only [IntermediateField.coe_val]
    ring
  rw [htrans, add_sub_cancel_right]
  change z ^ 4 + B.val (u * scale ^ 2) * z ^ 2 + B.val (u * scale ^ 2) * z +
    B.val (w * scale ^ 4) = _
  simp only [map_mul, map_pow]
  simp only [IntermediateField.coe_val]
  field_simp [hs]
  linear_combination - (scale : K) ^ 2 * z * hvs

-- The field generated by two parameters is the fraction field of the corresponding
-- algebra, which is a quotient of a polynomial algebra on two variables.
private lemma trdeg_two_parameters (f : Fin 2 → K) :
    Algebra.trdeg ℂ (adjoin ℂ (Set.range f)) ≤ 2 := by
  open scoped algebraAdjoinAdjoin in
    rw [← trdeg_add_eq ℂ (Algebra.adjoin ℂ (Set.range f)),
      trdeg_eq_zero (R := Algebra.adjoin ℂ (Set.range f)), add_zero,
      Algebra.adjoin_range_eq_range_aeval]
    let φ := MvPolynomial.aeval (R := ℂ) f
    simpa [MvPolynomial.trdeg_of_isDomain] using
      trdeg_le_of_surjective φ.rangeRestrict φ.rangeRestrict_surjective

private lemma normalized_injective : Function.Injective normalized := by
  intro i j hij
  exact root_injective 4 (sub_left_inj.mp (mul_left_cancel₀ scale_ne_zero hij))

private lemma normalized_roots {L : IntermediateField ℂ K} {p : L[X]}
    (hp : p.map (algebraMap L K) = ∏ i, (X - C (normalized i))) :
    {x : K | aeval x p = 0} = Set.range normalized := by
  classical
  ext x
  simp [aeval_def, eval₂_eq_eval_map, hp, eval_prod, Finset.prod_eq_zero_iff, sub_eq_zero,
    eq_comm (a := x)]

private lemma four_upper : edSn 4 ≤ 2 := by
  let f : Fin 2 → K := ![(paramA : K), (paramB : K)]
  let J := adjoin ℂ (Set.range f)
  let E := adjoin J (Set.range normalized)
  let E₀ := E.restrictScalars ℂ
  let F := E₀ ⊓ B
  have hJE : J ≤ E₀ := fun x hx ↦ E.algebraMap_mem ⟨x, hx⟩
  have hJB : J ≤ B := by
    apply adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact paramA.property
    · exact paramB.property
  have hJF : J ≤ F := le_inf hJE hJB
  let gen (i : Fin 2) : J := ⟨f i, subset_adjoin ℂ _ (Set.mem_range_self i)⟩
  let p := quartic (gen 0) (gen 1)
  have hmap : p.map (algebraMap J K) = ∏ i, (X - C (normalized i)) := by
    simp only [p, quartic, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_pow,
      Polynomial.map_X, Polynomial.map_C]
    exact normalized_factors
  have hp : p ≠ 0 := by
    intro h
    rw [h, Polynomial.map_zero] at hmap
    exact (Finset.prod_ne_zero_iff.mpr (fun i _ ↦ X_sub_C_ne_zero (normalized i))) hmap.symm
  have hroots := normalized_roots hmap
  have hsup : E₀ ⊔ B = ⊤ := by
    apply top_unique
    rw [← adjoin_roots_eq_top]
    apply adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    have hy : normalized i ∈ E₀ := subset_adjoin J _ (Set.mem_range_self i)
    have hrecover : root 4 i = normalized i / scale + mean := by
      simp [normalized, mul_div_cancel_left₀ _ scale_ne_zero]
    rw [hrecover]
    have hE : E₀ ≤ E₀ ⊔ B := le_sup_left
    have hB : B ≤ E₀ ⊔ B := le_sup_right
    exact add_mem (div_mem (hE hy) (hB scale.property)) (hB mean.property)
  let q := p.map (inclusion hJF).toRingHom
  have hq : q.map (algebraMap F K) = ∏ i, (X - C (normalized i)) := by
    rw [← hmap, Polynomial.map_map]
    rfl
  -- Intersecting with the original base enforces the intersection condition. The roots
  -- still generate E₀ over this larger parameter field because J ≤ F ≤ E₀.
  have hD : IsDescent 4 F E₀ := by
    refine ⟨inf_le_right, inf_le_left, rfl, hsup, q,
      (Polynomial.map_ne_zero_iff (inclusion hJF).injective).mpr hp, ?_, ?_, ?_⟩
    · rw [hq]
      exact Splits.prod (fun i _ ↦ Splits.X_sub_C _)
    · rw [hq]
      exact separable_prod_X_sub_C_iff.mpr normalized_injective
    · rw [normalized_roots hq, restrictScalars_adjoin_eq_sup]
      have hE : E₀ = J ⊔ adjoin ℂ (Set.range normalized) :=
        restrictScalars_adjoin_eq_sup ℂ J _
      apply le_antisymm
      · exact sup_le inf_le_left (hE ▸ le_sup_right)
      · rw [hE]
        exact sup_le_sup_right hJF _
  apply Nat.sInf_le
  refine ⟨F, E₀, hD, ?_⟩
  have : Algebra.IsAlgebraic J E := isAlgebraic_adjoin (fun x hx ↦ by
    rw [← hroots] at hx
    exact (show IsAlgebraic J x from ⟨p, hp, hx⟩).isIntegral)
  have hdeg : Algebra.trdeg ℂ E ≤ 2 := by
    rw [← trdeg_add_eq ℂ J, trdeg_eq_zero (R := J), add_zero]
    exact trdeg_two_parameters f
  have hF := trdeg_le_of_injective (inclusion (show F ≤ E₀ from inf_le_left))
    (inclusion _).injective
  simpa [transDegNat] using Cardinal.toNat_le_toNat (hF.trans hdeg) (by simp)

/-- **Essential dimension of the symmetric group on four letters.** Write
$\operatorname{ed}(S_n)$ for the essential dimension of the symmetric group $S_n$ over
$\mathbb{C}$ in the general-polynomial sense: the least transcendence degree over $\mathbb{C}$
of a subfield $F_0$ of the coefficient field $\mathbb{C}(a_1, \dots, a_n)$ of the general
polynomial of degree $n$ over which that polynomial descends up to Tschirnhaus transformation.
Then $\operatorname{ed}(S_4) = 2$.

Source: Buhler--Reichstein (1997), exact value `ed_ℂ(S₄) = 2`. -/
public theorem edSn_four_wanted : edSn 4 = 2 :=
  le_antisymm four_upper (buhlerReichsteinDuncanLowerBound_wanted 4)

end MathlibExt.FieldTheory.EssentialDimensionSymmetricWanted
