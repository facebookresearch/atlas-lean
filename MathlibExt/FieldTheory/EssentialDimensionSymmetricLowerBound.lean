module

public import MathlibExt.FieldTheory.EssentialDimensionSymmetric
import Mathlib.Algebra.Order.Group.PiLex
import Mathlib.Algebra.Order.Module.Equiv
import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.RingTheory.HahnSeries.Summable

/-!
# Lower bound for the essential dimension of symmetric groups

We prove the Buhler–Reichstein lower bound `n / 2 ≤ edSn n` over the complex numbers.

The subgroup generated by disjoint transpositions acts faithfully on the splitting field of
every descent. In coordinates given by sums and differences of paired roots, the transpositions
act by signs. Embedding the rational function field in a Hahn series field makes these signs
characters of its exponent lattice. Their restrictions to the value group of a descent still
distinguish all the transpositions and their products. Hence the value group has rank at least
`n / 2`, while lifts of a basis are algebraically independent over the complex numbers.
-/

namespace MathlibExt.FieldTheory.EssentialDimensionSymmetricWanted

section Descent

open MathlibExt.FieldTheory.EssentialDimensionSymmetric IntermediateField

private noncomputable def permRoots {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    rootsField n ≃ₐ[ℂ] rootsField n :=
  IsFractionRing.algEquivOfAlgEquiv (MvPolynomial.renameEquiv ℂ σ)

private lemma permRoots_root {n : ℕ} (σ : Equiv.Perm (Fin n)) (i : Fin n) :
    permRoots σ (root n i) = root n (σ i) := by
  simp [root, permRoots]

private noncomputable def fixedFieldOf {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    IntermediateField ℂ (rootsField n) :=
  ((permRoots σ).toRingHom.eqLocusField (RingHom.id _)).toIntermediateField
    (fun c ↦ (permRoots σ).commutes c)

private lemma fixes_coeffField {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    ∀ x ∈ generalBaseField n, permRoots σ x = x := by
  change generalBaseField n ≤ fixedFieldOf σ
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨i, rfl⟩
  change permRoots σ (coeff n i) = coeff n i
  simp [coeff, permRoots, MvPolynomial.rename_esymm]

private lemma trdeg_descent_eq {n : ℕ} {F E : IntermediateField ℂ (rootsField n)}
    (h : IsDescent n F E) :
    Algebra.trdeg ℂ E = Algebra.trdeg ℂ F := by
  obtain ⟨_, _, _, _, p, hp, _, _, rfl⟩ := h
  let A := IntermediateField.adjoin F {x : rootsField n | Polynomial.aeval x p = 0}
  have : Algebra.IsAlgebraic F A := IntermediateField.isAlgebraic_adjoin
    (fun _ hx ↦ (show IsAlgebraic F _ from ⟨p, hp, hx⟩).isIntegral)
  change Algebra.trdeg ℂ A = _
  rw [← trdeg_add_eq ℂ F, trdeg_eq_zero (R := F), add_zero]

private lemma stable_descent {n : ℕ} {F E : IntermediateField ℂ (rootsField n)}
    (h : IsDescent n F E) (σ : Equiv.Perm (Fin n)) :
    ∀ x ∈ E, permRoots σ x ∈ E := by
  obtain ⟨hF, _, _, _, p, _, _, _, rfl⟩ := h
  let φ : rootsField n →ₐ[F] rootsField n :=
    { (permRoots σ).toRingHom with commutes' := fun x ↦ fixes_coeffField σ x (hF x.2) }
  let A := IntermediateField.adjoin F {x : rootsField n | Polynomial.aeval x p = 0}
  change A ≤ IntermediateField.comap φ A
  apply IntermediateField.adjoin_le_iff.mpr
  intro x hx
  apply IntermediateField.subset_adjoin
  change Polynomial.aeval (φ x) p = 0
  rw [Polynomial.aeval_algHom_apply, show Polynomial.aeval x p = 0 from hx, map_zero]

private lemma faithful_descent {n : ℕ} {F E : IntermediateField ℂ (rootsField n)}
    (h : IsDescent n F E) {σ : Equiv.Perm (Fin n)}
    (hs : ∀ x ∈ E, permRoots σ x = x) : σ = 1 := by
  let L := fixedFieldOf σ
  have hle : E ⊔ generalBaseField n ≤ L := sup_le hs (fixes_coeffField σ)
  rw [h.2.2.2.1] at hle
  apply Equiv.ext
  intro i
  apply root_injective n
  exact (permRoots_root σ i).symm.trans (hle (Set.mem_univ (root n i)))

private lemma lowerBound_of_descent {n : ℕ}
    (h : ∀ F E : IntermediateField ℂ (rootsField n),
      IsDescent n F E → (n / 2 : ℕ) ≤ Algebra.trdeg ℂ E) :
    n / 2 ≤ edSn n := by
  apply le_csInf
  · exact ⟨n, generalBaseField n, ⊤, isDescent_generalBaseField n,
      (transDegNat_generalBaseField n).le⟩
  · rintro d ⟨F, E, hD, hd⟩
    have hle := h F E hD
    rw [trdeg_descent_eq hD] at hle
    have hfin := trdeg_le_of_injective F.val Subtype.val_injective
    rw [trdeg_rootsField] at hfin
    have hNat := Cardinal.toNat_le_toNat hle (hfin.trans_lt (by simp))
    exact le_trans (by simpa [transDegNat] using hNat) hd

end Descent

section ValueGroup

open HahnSeries

variable {Γ : Type} [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]

private lemma order_prod {ι : Type*} (s : Finset ι) (f : ι → HahnSeries Γ ℂ)
    (h : ∀ i ∈ s, f i ≠ 0) : (∏ i ∈ s, f i).order = ∑ i ∈ s, (f i).order := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    simp only [Finset.prod_insert hi, Finset.sum_insert hi]
    rw [order_mul (h i (by simp)) (Finset.prod_ne_zero_iff.mpr (by grind)), ih (by grind)]

-- Distinct monomials in these series have distinct lowest exponents. Only the monomial
-- of least order contributes to the coefficient at that exponent.
private lemma independent_of_order {ι : Type*} [Finite ι] (v : ι → HahnSeries Γ ℂ)
    (hv : ∀ i, v i ≠ 0) (hind : LinearIndependent ℤ (fun i ↦ (v i).order)) :
    AlgebraicIndependent ℂ v := by
  classical
  let := Fintype.ofFinite ι
  apply algebraicIndependent_iff.mpr
  intro p he
  by_contra hp
  let term := fun (d : ι →₀ ℕ) ↦ algebraMap ℂ (HahnSeries Γ ℂ) (p.coeff d) * ∏ i, v i ^ d i
  have hc0 (d) (hd : d ∈ p.support) :
      algebraMap ℂ (HahnSeries Γ ℂ) (p.coeff d) ≠ 0 := by
    simpa using (MvPolynomial.mem_support_iff.mp hd)
  have hn (d) (hd : d ∈ p.support) : term d ≠ 0 :=
    mul_ne_zero (hc0 d hd)
      (Finset.prod_ne_zero_iff.mpr (fun i _ ↦ pow_ne_zero _ (hv i)))
  have ho (d) (hd : d ∈ p.support) : (term d).order = ∑ i, (d i : ℤ) • (v i).order := by
    rw [show term d = _ from rfl,
      order_mul (hc0 d hd)
        (Finset.prod_ne_zero_iff.mpr (fun i _ ↦ pow_ne_zero _ (hv i))),
      order_prod _ _ (fun i _ ↦ pow_ne_zero _ (hv i))]
    simp [HahnSeries.algebraMap_apply, order_single (MvPolynomial.mem_support_iff.mp hd)]
  obtain ⟨d, hd, hmin⟩ := p.support.exists_min_image (fun d ↦ (term d).order)
    (by simpa using hp)
  have hz : ∑ j ∈ p.support, term j = 0 := by
    simpa only [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq'] using he
  have hc := congrArg (fun x : HahnSeries Γ ℂ ↦ x.coeff (term d).order) hz
  simp only [coeff_sum, coeff_zero] at hc
  rw [Finset.sum_eq_single d _ (by simp [hd])] at hc
  · exact hn d hd (coeff_order_eq_zero.mp hc)
  · intro j hj hjd
    apply coeff_eq_zero_of_lt_order
    refine lt_of_le_of_ne (hmin j hj) ?_
    rw [ho _ hd, ho _ hj]
    intro heq
    apply hjd
    ext i
    exact_mod_cast ((Fintype.linearIndependent_iffₛ.mp hind) _ _ heq i).symm

private noncomputable def orders {K : Type} [Field K] (φ : K →+* HahnSeries Γ ℂ) :
    AddSubgroup Γ where
  carrier := {g | ∃ x : K, x ≠ 0 ∧ (φ x).order = g}
  zero_mem' := ⟨1, one_ne_zero, by simp⟩
  add_mem' := by
    rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
    exact ⟨x * y, mul_ne_zero hx hy, by simp [hx, hy]⟩
  neg_mem' := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨x⁻¹, inv_ne_zero hx, eq_neg_of_add_eq_zero_left ?_⟩
    rw [← order_mul (show φ x⁻¹ ≠ 0 by simp [hx]) (show φ x ≠ 0 by simp [hx]),
      ← map_mul, inv_mul_cancel₀ hx, map_one, order_one]

-- Lift an integral basis of the value group to an algebraically independent family.
private lemma rank_orders_le {K : Type} [Field K] [Algebra ℂ K]
    (φ : K →ₐ[ℂ] HahnSeries Γ ℂ) {d : ℕ}
    (b : Module.Basis (Fin d) ℤ (orders φ.toRingHom)) : (d : Cardinal) ≤ Algebra.trdeg ℂ K := by
  choose f hf hval using fun i ↦ (b i).2
  change ∀ i, (φ (f i)).order = (b i : Γ) at hval
  have he : AlgebraicIndependent ℂ (φ ∘ f) := by
    apply independent_of_order _ (fun i ↦ by simp [hf i])
    simp only [Function.comp_apply, hval]
    exact b.linearIndependent.map' (orders φ.toRingHom).toIntSubmodule.subtype
      (LinearMap.ker_eq_bot_of_injective Subtype.val_injective)
  simpa using (he.of_comp φ).cardinalMk_le_trdeg

end ValueGroup

section Characters

open HahnSeries Finset

variable {Γ : Type} [AddCommGroup Γ]

private def signScalar (χ : Γ →+ Additive ℤˣ) (g : Γ) : ℂ :=
  ((χ g).toMul.val : ℤ)

private lemma signScalar_zero (χ : Γ →+ Additive ℤˣ) : signScalar χ 0 = 1 := by
  simp [signScalar]

private lemma signScalar_add (χ : Γ →+ Additive ℤˣ) (a b : Γ) :
    signScalar χ (a + b) = signScalar χ a * signScalar χ b := by
  simp [signScalar]

private lemma signScalar_ne (χ : Γ →+ Additive ℤˣ) (g : Γ) : signScalar χ g ≠ 0 := by
  unfold signScalar
  exact_mod_cast (χ g).toMul.ne_zero

variable [LinearOrder Γ]

private noncomputable def twistSeries (χ : Γ →+ Additive ℤˣ) (x : HahnSeries Γ ℂ) :
    HahnSeries Γ ℂ where
  coeff g := signScalar χ g * x.coeff g
  isPWO_support' := x.isPWO_support.mono (by intro g; simp [Function.mem_support, signScalar_ne])

private lemma twist_support (χ : Γ →+ Additive ℤˣ) (x : HahnSeries Γ ℂ) :
    (twistSeries χ x).support = x.support := by
  ext g
  simp [mem_support, twistSeries, signScalar_ne]

private lemma twist_single (χ : Γ →+ Additive ℤˣ) (g : Γ) (c : ℂ) :
    twistSeries χ (single g c) = single g (signScalar χ g * c) := by
  classical
  ext j
  by_cases h : j = g
  · subst j; simp [twistSeries]
  · simp [twistSeries, coeff_single_of_ne h]

variable [IsOrderedAddMonoid Γ]

private noncomputable def twistHom (χ : Γ →+ Additive ℤˣ) :
    HahnSeries Γ ℂ →ₐ[ℂ] HahnSeries Γ ℂ where
  toFun := twistSeries χ
  map_zero' := by ext; simp [twistSeries]
  map_one' := by rw [← single_zero_one, twist_single, signScalar_zero, one_mul]
  map_add' x y := by ext; simp [twistSeries, mul_add]
  map_mul' x y := by
    ext a
    change signScalar χ a * (x * y).coeff a = _
    simp only [coeff_mul, Finset.mul_sum]
    apply Finset.sum_congr
    · ext u; simp only [Finset.mem_antidiagonal, twist_support]
    · intro u hu
      rw [← (Finset.mem_antidiagonal.mp hu).2.2, signScalar_add]
      change _ = (_ * _) * (_ * _)
      ring
  commutes' c := by
    simp [HahnSeries.algebraMap_apply, C_apply, twist_single, signScalar_zero]

end Characters

section Coordinates

open HahnSeries MvPolynomial
open MathlibExt.FieldTheory.EssentialDimensionSymmetric

private abbrev Coordinates (n : ℕ) := (Fin (n / 2) × ℤˣ) ⊕ Fin (n % 2)
private abbrev Lattice (n : ℕ) := Lex (Fin n → ℤ)

private noncomputable def coordinateEquiv (n : ℕ) : Coordinates n ≃ Fin n :=
  Fintype.equivOfCardEq (by simp [Coordinates, Fintype.card_units_int]; omega)

private noncomputable def coordinateBasis (n : ℕ) :
    Module.Basis (Coordinates n) ℤ (Lattice n) :=
  ((Pi.basisFun ℤ (Fin n)).map (toLexLinearEquiv ℤ _)).reindex (coordinateEquiv n).symm

private noncomputable def mon (n : ℕ) (i : Coordinates n) : HahnSeries (Lattice n) ℂ :=
  single (coordinateBasis n i) 1

private lemma mon_independent (n : ℕ) : AlgebraicIndependent ℂ (mon n) := by
  apply independent_of_order
  · intro i; exact single_ne_zero one_ne_zero
  · simpa [mon, order_single one_ne_zero] using (coordinateBasis n).linearIndependent

-- In each pair the new variables are a centre and a difference. The original roots
-- are their sum and their difference, and the change of coordinates is invertible.
private noncomputable def mixed {n : ℕ} (i : Coordinates n) : MvPolynomial (Coordinates n) ℂ :=
  match i with
  | .inl (j, s) => X (.inl (j, 1)) + MvPolynomial.C ((s.val : ℤ) : ℂ) * X (.inl (j, -1))
  | .inr j => X (.inr j)

private lemma mixed_injective (n : ℕ) :
    Function.Injective (aeval (R := ℂ) (mixed (n := n))) := by
  let undo (i : Coordinates n) : MvPolynomial (Coordinates n) ℂ :=
    match i with
    | .inl (j, s) => MvPolynomial.C (1 / 2 : ℂ) * mixed (.inl (j, s))
    | .inr j => X (.inr j)
  have half : MvPolynomial.C (2 : ℂ)⁻¹ + MvPolynomial.C (2 : ℂ)⁻¹ =
      (1 : MvPolynomial (Coordinates n) ℂ) := by
    rw [← map_add]; norm_num
  have hid : (aeval (R := ℂ) undo).comp (aeval mixed) = AlgHom.id ℂ _ := by
    apply algHom_ext
    rintro (⟨j, s⟩ | j)
    · rcases Int.units_eq_one_or s with rfl | rfl
      · simp [mixed, undo]
        linear_combination X (.inl (j, 1) : Coordinates n) * half
      · simp [mixed, undo]
        linear_combination X (.inl (j, -1) : Coordinates n) * half
    · simp [mixed, undo]
  exact Function.LeftInverse.injective (g := aeval (R := ℂ) undo) (fun x ↦ DFunLike.congr_fun hid x)

private noncomputable def coordsHom (n : ℕ) :
    MvPolynomial (Fin n) ℂ →ₐ[ℂ] HahnSeries (Lattice n) ℂ :=
  ((aeval (mon n)).comp (aeval mixed)).comp (renameEquiv ℂ (coordinateEquiv n).symm).toAlgHom

private noncomputable def embedRoots (n : ℕ) :
    rootsField n →ₐ[ℂ] HahnSeries (Lattice n) ℂ :=
  IsFractionRing.liftAlgHom (g := coordsHom n) (by
    intro p q hpq
    apply (renameEquiv ℂ (coordinateEquiv n).symm).injective
    apply mixed_injective n
    exact (mon_independent n) hpq)

private lemma embed_root (n : ℕ) (i : Coordinates n) :
    embedRoots n (root n (coordinateEquiv n i)) = aeval (mon n) (mixed i) := by
  simp [embedRoots, coordsHom, root, AlgHom.comp_apply]

private noncomputable def signPerm {n : ℕ} (u : Fin (n / 2) → ℤˣ) :
    Equiv.Perm (Fin n) := by
  let e : Equiv.Perm (Coordinates n) :=
    Equiv.sumCongr (Equiv.prodCongrRight (fun i ↦ Equiv.mulLeft (u i))) (Equiv.refl _)
  exact ((coordinateEquiv n).symm.trans e).trans (coordinateEquiv n)

private noncomputable def character {n : ℕ} (u : Fin (n / 2) → ℤˣ) :
    Lattice n →ₗ[ℤ] Additive ℤˣ :=
  (coordinateBasis n).constr ℤ (fun i ↦ match i with
    | .inl (j, s) => if s = -1 then Additive.ofMul (u j) else 0
    | .inr _ => 0)

private lemma character_single {n : ℕ} (u : Fin (n / 2) → ℤˣ) (i : Coordinates n) :
    (twistHom (character u).toAddMonoidHom) (mon n i) =
      single (coordinateBasis n i)
        (signScalar (character u).toAddMonoidHom (coordinateBasis n i)) :=
  (twist_single _ _ _).trans (by rw [mul_one])

private lemma embed_perm_root {n : ℕ} (u : Fin (n / 2) → ℤˣ) (i : Fin n) :
    twistHom (character u).toAddMonoidHom (embedRoots n (root n i)) =
      embedRoots n (permRoots (signPerm u) (root n i)) := by
  obtain ⟨i, rfl⟩ := (coordinateEquiv n).surjective i
  rw [permRoots_root, embed_root]
  rcases i with ⟨j, s⟩ | j
  · simp only [signPerm, Equiv.trans_apply, Equiv.symm_apply_apply, Equiv.sumCongr_apply,
      Equiv.prodCongrRight_apply, Sum.map_inl, embed_root]
    rcases Int.units_eq_one_or (u j) with hu | hu <;>
      rcases Int.units_eq_one_or s with rfl | rfl <;>
      simp [mixed, hu] <;> simp only [character_single] <;>
      simp [signScalar, character, hu, mon]
  · simp only [signPerm, Equiv.trans_apply, Equiv.symm_apply_apply, Equiv.sumCongr_apply,
      Sum.map_inr, Equiv.refl_apply, embed_root, mixed, aeval_X, character_single]
    simp [character, signScalar, mon]

end Coordinates

open MathlibExt.FieldTheory.EssentialDimensionSymmetric IntermediateField HahnSeries

private lemma embed_perm {n : ℕ} (u : Fin (n / 2) → ℤˣ) (x : rootsField n) :
    twistHom (character u).toAddMonoidHom (embedRoots n x) =
      embedRoots n (permRoots (signPerm u) x) := by
  let f := (twistHom (character u).toAddMonoidHom).comp (embedRoots n)
  let g := (embedRoots n).comp (permRoots (signPerm u)).toAlgHom
  let L := (f.toRingHom.eqLocusField g.toRingHom).toIntermediateField
    (fun c ↦ (f.commutes c).trans (g.commutes c).symm)
  have hL : IntermediateField.adjoin ℂ (Set.range (root n)) ≤ L :=
    IntermediateField.adjoin_le_iff.mpr (by rintro _ ⟨i, rfl⟩; exact embed_perm_root u i)
  rw [adjoin_roots_eq_top] at hL
  exact hL (Set.mem_univ x)

-- If a sign change moves x in E, the lowest exponent of σ(x) - x lies in the value
-- group of E. At this exponent the character must change the coefficient of x.
private lemma trivial_of_character {n : ℕ} {F E : IntermediateField ℂ (rootsField n)}
    (h : IsDescent n F E) (u : Fin (n / 2) → ℤˣ)
    (hu : ∀ a ∈ orders ((embedRoots n).comp E.val).toRingHom, character u a = 0) : u = 1 := by
  have hfix : signPerm u = 1 := by
    apply faithful_descent h
    intro x hx
    by_contra hne
    let σ := permRoots (signPerm u)
    let y := σ x - x
    have hy : y ∈ E := E.sub_mem (stable_descent h _ _ hx) hx
    have hy0 : y ≠ 0 := sub_ne_zero.mpr hne
    let a := (embedRoots n y).order
    have ha : a ∈ orders ((embedRoots n).comp E.val).toRingHom :=
      ⟨⟨y, hy⟩, fun h0 ↦ hy0 (congrArg Subtype.val h0), rfl⟩
    have hunit : signScalar (character u).toAddMonoidHom a = 1 := by
      simp [signScalar, hu a ha]
    have hcoeff := congrArg (fun z : HahnSeries (Lattice n) ℂ ↦ z.coeff a) (embed_perm u x)
    change signScalar (character u).toAddMonoidHom a * _ = _ at hcoeff
    have hzero : (embedRoots n y).coeff a = 0 := by
      simp only [y, map_sub, coeff_sub]
      rw [hunit, one_mul] at hcoeff
      exact sub_eq_zero.mpr hcoeff.symm
    exact hy0 ((map_eq_zero _).mp (coeff_order_eq_zero.mp hzero))
  funext j
  have hh := DFunLike.congr_fun hfix (coordinateEquiv n (.inl (j, 1)))
  simpa [signPerm] using hh

private lemma character_mul {n : ℕ} (u v : Fin (n / 2) → ℤˣ) :
    character (u * v) = character u + character v := by
  apply (coordinateBasis n).ext
  rintro (⟨j, s⟩ | j)
  · by_cases hs : s = -1 <;> simp [character, hs]
  · simp [character]

private lemma descent_rank_bound {n : ℕ} {F E : IntermediateField ℂ (rootsField n)}
    (h : IsDescent n F E) : (n / 2 : ℕ) ≤ Algebra.trdeg ℂ E := by
  let φ := (embedRoots n).comp E.val
  let L := (orders φ.toRingHom).toIntSubmodule
  obtain ⟨d, b⟩ := L.basisOfPid (coordinateBasis n)
  -- A character on this lattice is determined by its signs on the basis.
  let signature : (Fin (n / 2) → ℤˣ) →* (Fin d → ℤˣ) :=
    { toFun u i := (character u (b i : Lattice n)).toMul
      map_mul' u v := by ext i; simp [character_mul]
      map_one' := by
        have he : character (1 : Fin (n / 2) → ℤˣ) = 0 := by
          have := character_mul (1 : Fin (n / 2) → ℤˣ) 1
          simpa using this
        funext i
        simp [he] }
  have hinj : Function.Injective signature := by
    apply (injective_iff_map_eq_one signature).mpr
    intro u hu
    apply trivial_of_character h
    have hχ : (character u).comp L.subtype = 0 := by
      apply b.ext
      intro i
      exact congrArg Additive.ofMul (congrFun hu i)
    intro a ha
    exact DFunLike.congr_fun hχ (⟨a, ha⟩ : L)
  have hc := Fintype.card_le_of_injective signature hinj
  simp only [Fintype.card_fun, Fintype.card_units_int, Fintype.card_fin] at hc
  have hd : n / 2 ≤ d := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hc
  exact (Nat.cast_le.mpr hd).trans (rank_orders_le φ b)

/-- **Lower bound for the essential dimension of symmetric groups.** Write
$\operatorname{ed}(S_n)$ for the essential dimension of the symmetric group $S_n$ over
$\mathbb{C}$ in the general-polynomial sense: the least transcendence degree over $\mathbb{C}$
of a subfield $F_0$ of the coefficient field $\mathbb{C}(a_1, \dots, a_n)$ of the general
polynomial of degree $n$ over which that polynomial descends up to Tschirnhaus transformation.
Then $\lfloor n/2 \rfloor \le \operatorname{ed}(S_n)$ for every natural number $n$.

Source: Buhler--Reichstein (1997) and Duncan, the lower bound
`⌊n/2⌋ ≤ ed_ℂ(Sₙ)`. -/
public theorem buhlerReichsteinDuncanLowerBound_wanted :
    ∀ n : ℕ, n / 2 ≤ edSn n := by
  intro n
  exact lowerBound_of_descent (fun _ _ h ↦ descent_rank_bound h)

end MathlibExt.FieldTheory.EssentialDimensionSymmetricWanted
