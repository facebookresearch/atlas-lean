/-!
# Semisimplicial homotopies and alternating-face chain homotopies

For semisimplicial maps f, g : X → Y, a homotopy consists of maps h_i : X_n → Y_(n+1) with
endpoint equations h₀ δ₀ = g_n and h_n δ_(n+1) = f_n, together with the face equations
relating consecutive h_i. Compatibility with faces also suffices to construct a semisimplicial
map, since order-preserving injections are generated by the face injections.

In a preadditive category the homotopy induces a chain homotopy on alternating-face complexes
with component s_n = −∑ i : Fin (n + 1), (−1)^i h_i. With composition written left to right,
its equation is f_n = d_X ≫ s_(n−1) + s_n ≫ d_Y + g_n, with the first term absent in degree
zero. Consequently f and g induce equal maps on every degree in which both homology objects
exist.

See Weibel, *An Introduction to Homological Algebra*, Chapter 8.
-/

@[expose] public section

noncomputable section

open CategoryTheory Opposite
open scoped Simplicial BigOperators

universe v u

namespace SemiSimplexCategory

/-- Let P be a property of morphisms in SemiSimplexCategory. Suppose P holds for every identity
and, for each f : x ⟶ y and i : Fin (y.len + 2), P f implies P (f ≫ δ i). Then P holds for
every order-preserving injection f : x ⟶ y in the semisimplex category. -/
theorem hom_induction (P : MorphismProperty SemiSimplexCategory)
    (hid : ∀ x, P (𝟙 x))
    (hδ : ∀ {x y : SemiSimplexCategory} (f : x ⟶ y) (i : Fin (y.len + 2)),
      P f → P (f ≫ δ i)) {x y : SemiSimplexCategory} (f : x ⟶ y) : P f := by
  obtain ⟨x⟩ := x
  obtain ⟨y⟩ := y
  let Q : MorphismProperty SimplexCategory := fun a b g =>
    ∀ (g' : ⦋a.len⦌ₛ ⟶ ⦋b.len⦌ₛ), toSimplexCategory.map g' = g → P g'
  have hQ : Q (toSimplexCategory.map f) := by
    apply SimplexCategory.mono_induction (motive := Q)
    · rintro ⟨a⟩
      dsimp only [Q]
      intro g hg
      change toSimplexCategory.map g = 𝟙 ⦋a⦌ at hg
      have he : g = 𝟙 ⦋a⦌ₛ := by
        apply toSimplexCategory.map_injective
        exact hg.trans (toSimplexCategory.map_id ⦋a⦌ₛ).symm
      rw [he]
      exact hid _
    · rintro ⟨a⟩ ⟨b⟩ (g : ⦋a⦌ ⟶ ⦋b⦌) i ih
      dsimp only [Q] at ih ⊢
      intro g' hg
      change toSimplexCategory.map g' = g ≫ SimplexCategory.δ i at hg
      have hgMono : Mono (toSimplexCategory.map g') := inferInstance
      let : Mono (g ≫ SimplexCategory.δ i) := hg ▸ hgMono
      have hg' : Mono g := CategoryTheory.mono_of_mono g (SimplexCategory.δ i)
      let q : ⦋a⦌ₛ ⟶ ⦋b⦌ₛ :=
        @homOfMono ⦋a⦌ₛ ⦋b⦌ₛ g hg'
      have hq : toSimplexCategory.map q = g :=
        @toSimplexCategory_map_homOfMono ⦋a⦌ₛ ⦋b⦌ₛ g hg'
      have he : g' = q ≫ δ i := by
        apply toSimplexCategory.map_injective
        simpa only [Functor.map_comp, toSimplexCategory_map_δ, hq,
          toSimplexCategory_obj] using hg
      rw [he]
      exact hδ q i (ih q hq)
  exact hQ f rfl


end SemiSimplexCategory

namespace CategoryTheory.SemiSimplicialObject

variable {C : Type u} [Category.{v} C]

@[reassoc (attr := simp)]
theorem δ_naturality {X Y : SemiSimplicialObject C} (f : X ⟶ Y)
    {n : ℕ} (i : Fin (n + 2)) :
    X.δ i ≫ f.app (op ⦋n⦌ₛ) = f.app (op ⦋n + 1⦌ₛ) ≫ Y.δ i :=
  f.naturality (SemiSimplexCategory.δ i).op

/-- Let X and Y be semisimplicial objects in a category C and let a_n : X_n ⟶ Y_n be maps for all
n : ℕ. If X.δ i ≫ a_n = a_(n+1) ≫ Y.δ i for every n and i : Fin (n + 2), these maps define a
natural transformation X ⟶ Y with degree-n component a_n. -/
def homMk {X Y : SemiSimplicialObject C}
    (app : ∀ n, X _⦋n⦌ₛ ⟶ Y _⦋n⦌ₛ)
    (hδ : ∀ n (i : Fin (n + 2)), X.δ i ≫ app n = app (n + 1) ≫ Y.δ i) : X ⟶ Y where
  app a := app a.unop.len
  naturality {a b} f := by
    let P : MorphismProperty SemiSimplexCategory := fun a b g =>
      X.map g.op ≫ app a.len = app b.len ≫ Y.map g.op
    have hP : P f.unop := by
      apply SemiSimplexCategory.hom_induction (P := P)
      · intro a
        dsimp only [P]
        simp only [op_id, Functor.map_id, Category.id_comp, Category.comp_id]
      · intro a b g i ih
        dsimp only [P] at ih ⊢
        calc
          _ = (X.δ i ≫ X.map g.op) ≫ app a.len := by
            simp only [op_comp, Functor.map_comp, δ_def]
          _ = X.δ i ≫ (X.map g.op ≫ app a.len) := Category.assoc _ _ _
          _ = X.δ i ≫ (app b.len ≫ Y.map g.op) :=
            congrArg (fun q => X.δ i ≫ q) ih
          _ = (X.δ i ≫ app b.len) ≫ Y.map g.op := (Category.assoc _ _ _).symm
          _ = (app (b.len + 1) ≫ Y.δ i) ≫ Y.map g.op :=
            congrArg (fun q => q ≫ Y.map g.op) (hδ b.len i)
          _ = _ := by
            simp only [op_comp, Functor.map_comp, δ_def, Category.assoc]
    exact hP

@[simp]
theorem homMk_app {X Y : SemiSimplicialObject C}
    (app : ∀ n, X _⦋n⦌ₛ ⟶ Y _⦋n⦌ₛ)
    (hδ : ∀ n (i : Fin (n + 2)), X.δ i ≫ app n = app (n + 1) ≫ Y.δ i) (n : ℕ) :
    (homMk app hδ).app (op ⦋n⦌ₛ) = app n := rfl

/-- For semisimplicial morphisms f, g : X ⟶ Y in a category C, a homotopy consists of maps h_i^(n)
: X_n ⟶ Y_(n+1), indexed by i : Fin (n + 1). Its endpoints are h₀^(n) ≫ Y.δ 0 = g_n and
h_(Fin.last n)^(n) ≫ Y.δ (Fin.last (n + 1)) = f_n.

For i : Fin (n + 2) and j : Fin (n + 1), the face conditions are h_(j.succ)^(n+1) ≫ Y.δ
i.castSucc = X.δ i ≫ h_j^(n) when i ≤ j.castSucc, and h_(j.castSucc)^(n+1) ≫ Y.δ i.succ = X.δ
i ≫ h_j^(n) when j.castSucc < i. The remaining adjacent relation is h_(j.succ)^(n+1) ≫ Y.δ
j.castSucc.succ = h_(j.castSucc)^(n+1) ≫ Y.δ j.castSucc.succ. -/
@[ext]
structure Homotopy {X Y : SemiSimplicialObject C} (f g : X ⟶ Y) where
  /-- For a homotopy between semisimplicial maps f, g : X ⟶ Y in a category C, h i is a morphism X_n
⟶ Y_(n+1) for every n : ℕ and i : Fin (n + 1). These maps form the homotopy's degree-raising
family; its endpoint and face equations are the other fields of the structure. -/
  h {n : ℕ} (i : Fin (n + 1)) : X _⦋n⦌ₛ ⟶ Y _⦋n + 1⦌ₛ
  h_zero_comp_δ_zero (n : ℕ) : h 0 ≫ Y.δ 0 = g.app (op ⦋n⦌ₛ)
  h_last_comp_δ_last (n : ℕ) : h (Fin.last n) ≫ Y.δ (Fin.last (n + 1)) = f.app (op ⦋n⦌ₛ)
  h_succ_comp_δ_castSucc_of_lt {n : ℕ} (i : Fin (n + 2)) (j : Fin (n + 1))
      (hij : i ≤ j.castSucc) : h j.succ ≫ Y.δ i.castSucc = X.δ i ≫ h j
  h_succ_comp_δ_castSucc_succ {n : ℕ} (j : Fin (n + 1)) :
    h j.succ ≫ Y.δ j.castSucc.succ = h j.castSucc ≫ Y.δ j.castSucc.succ
  h_castSucc_comp_δ_succ_of_lt {n : ℕ} (i : Fin (n + 2)) (j : Fin (n + 1))
      (hji : j.castSucc < i) : h j.castSucc ≫ Y.δ i.succ = X.δ i ≫ h j

namespace Homotopy

attribute [reassoc (attr := simp)]
  h_zero_comp_δ_zero h_last_comp_δ_last h_succ_comp_δ_castSucc_of_lt
  h_castSucc_comp_δ_succ_of_lt
attribute [reassoc] h_succ_comp_δ_castSucc_succ

variable {X Y : SemiSimplicialObject C} {f g : X ⟶ Y}

/-- Let H be a semisimplicial homotopy from f to g, for f, g : X ⟶ Y in a category C, and let p :
Y ⟶ Y' be semisimplicial. The maps H.h i ≫ p_(n+1) define a homotopy from f ≫ p to g ≫ p.
Their endpoint and face equations follow by composing those of H with the components of p. -/
def postcomp (H : Homotopy f g) {Y' : SemiSimplicialObject C} (p : Y ⟶ Y') :
    Homotopy (f ≫ p) (g ≫ p) where
  h i := H.h i ≫ p.app _
  h_zero_comp_δ_zero n := by
    simpa [-h_zero_comp_δ_zero] using H.h_zero_comp_δ_zero n =≫ p.app _
  h_last_comp_δ_last n := by
    simpa [-h_last_comp_δ_last] using H.h_last_comp_δ_last n =≫ p.app _
  h_succ_comp_δ_castSucc_of_lt i j hij := by
    simpa using H.h_succ_comp_δ_castSucc_of_lt i j hij =≫ p.app _
  h_succ_comp_δ_castSucc_succ j := by
    simpa [Category.assoc] using H.h_succ_comp_δ_castSucc_succ j =≫ p.app _
  h_castSucc_comp_δ_succ_of_lt i j hji := by
    simpa using H.h_castSucc_comp_δ_succ_of_lt i j hji =≫ p.app _

end Homotopy


end CategoryTheory.SemiSimplicialObject

namespace CategoryTheory.SemiSimplicialObject.Homotopy

variable {C : Type u} [Category.{v} C] [Preadditive C]
  {X Y : SemiSimplicialObject C} {f g : X ⟶ Y} (H : Homotopy f g)

namespace ToChainHomotopy

/-- For a semisimplicial homotopy H between f, g : X ⟶ Y in a preadditive category C, define hom H
p q : X_p ⟶ Y_q to be zero unless p + 1 = q. In that adjacent case it is −∑ k : Fin (p + 1),
(−1 : ℤ)^k • H.h k, followed by the object-equality transport from Y_(p+1) to Y_q. -/
def hom (p q : ℕ) : X _⦋p⦌ₛ ⟶ Y _⦋q⦌ₛ :=
  if hpq : p + 1 = q then
    -∑ k : Fin (p + 1), (-1 : ℤ) ^ k.val • H.h k ≫ eqToHom (by simp [hpq])
  else 0

@[simp]
theorem hom_eq (p : ℕ) :
    hom H p (p + 1) = -∑ k : Fin (p + 1), (-1 : ℤ) ^ k.val • H.h k := by
  simp [hom]

@[simp]
theorem hom_eq_zero (p q : ℕ) (hpq : p + 1 ≠ q) : hom H p q = 0 :=
  dite_eq_right hpq

private theorem comm_zero :
    f.app (op ⦋0⦌ₛ) = hom H 0 1 ≫
      AlgebraicTopology.SemiSimplicialAlternatingFaceMapComplex.objD Y 0 +
        g.app (op ⦋0⦌ₛ) := by
  simp [← H.h_last_comp_δ_last 0,
    AlgebraicTopology.SemiSimplicialAlternatingFaceMapComplex.objD]

private theorem comm_succ (n : ℕ) :
    f.app (op ⦋n + 1⦌ₛ) =
      AlgebraicTopology.SemiSimplicialAlternatingFaceMapComplex.objD X n ≫
          hom H n (n + 1) +
        hom H (n + 1) (n + 2) ≫
          AlgebraicTopology.SemiSimplicialAlternatingFaceMapComplex.objD Y (n + 1) +
        g.app (op ⦋n + 1⦌ₛ) := by
  rw [← H.h_zero_comp_δ_zero, ← H.h_last_comp_δ_last]
  simp only [AlgebraicTopology.SemiSimplicialAlternatingFaceMapComplex.objD, hom_eq,
    Preadditive.comp_neg, Preadditive.neg_comp, Preadditive.comp_sum,
    Preadditive.sum_comp, Preadditive.comp_zsmul, Preadditive.zsmul_comp,
    smul_neg, Finset.sum_neg_distrib, ← Finset.sum_zsmul, smul_smul, ← pow_add]
  let α (x : Fin (n + 1) × Fin (n + 2)) := (-1 : ℤ) ^ (x.1.val + x.2.val) • X.δ x.2 ≫ H.h x.1
  let β (x : Fin (n + 3) × Fin (n + 2)) := (-1 : ℤ) ^ (x.1.val + x.2.val) • H.h x.2 ≫ Y.δ x.1
  rw [← Finset.sum_product .univ .univ α, ← Finset.sum_product .univ .univ β,
    Finset.univ_product_univ, Finset.univ_product_univ]
  let S : Finset (Fin (n + 1) × Fin (n + 2)) := {x | x.1.castSucc < x.2}
  let γ₁ (x : Fin (n + 1) × Fin (n + 2)) := (x.2.castSucc, x.1.succ)
  let γ₂ (x : Fin (n + 1) × Fin (n + 2)) := (x.2.succ, x.1.castSucc)
  let γ₃ (i : Fin (n + 1)) := (i.castSucc.succ, i.succ)
  let γ₄ (i : Fin (n + 1)) := (i.castSucc.succ, i.castSucc)
  have hγ₁ : Function.Injective γ₁ := fun _ _ => by aesop
  have hγ₂ : Function.Injective γ₂ := fun _ _ => by aesop
  have hγ₃ : Function.Injective γ₃ := fun _ _ => by aesop
  have hγ₄ : Function.Injective γ₄ := fun _ _ => by aesop
  have eq₁ : H.h 0 ≫ Y.δ 0 = β ⟨0, 0⟩ := by simp [β]
  have eq₂ : H.h (Fin.last _) ≫ Y.δ (Fin.last _) = -β ⟨Fin.last _, Fin.last _⟩ := by
    dsimp [β]
    simp only [pow_add, even_two, Even.neg_pow, one_pow, mul_one,
      pow_one, mul_neg, neg_smul, neg_neg]
    rw [← pow_add, (Even.add_self n).neg_one_pow, one_smul]
  have eq₃ : ∑ x ∈ Sᶜ, α x = -∑ y ∈ Finset.image γ₁ Sᶜ, β y := by
    rw [← Finset.sum_neg_distrib, Finset.sum_image hγ₁.injOn]
    refine Finset.sum_congr rfl (fun x hx => ?_)
    dsimp [α, β, γ₁]
    simp only [← H.h_succ_comp_δ_castSucc_of_lt x.2 x.1 (by simpa [S] using hx),
      pow_add, pow_one, mul_neg, mul_one, neg_smul, neg_neg]
    rw [mul_comm]
  have eq₄ : ∑ x ∈ S, α x = -∑ y ∈ Finset.image γ₂ S, β y := by
    rw [← Finset.sum_neg_distrib, Finset.sum_image hγ₂.injOn]
    refine Finset.sum_congr rfl (fun x hx => ?_)
    dsimp [α, β, γ₂]
    simp only [← H.h_castSucc_comp_δ_succ_of_lt x.2 x.1 (by simpa [S] using hx),
      pow_add, pow_one, mul_neg, mul_one, neg_mul, neg_smul, neg_neg]
    rw [mul_comm]
  have eq₅ : ∑ x, β (γ₄ x) = -∑ x, β (γ₃ x) := by
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl
      (fun x _ => by simp [h_succ_comp_δ_castSucc_succ, β, γ₃, γ₄])
  have h₁ : Disjoint (Finset.image γ₁ Sᶜ) (Finset.image γ₂ S) := by
    rw [Finset.disjoint_iff_ne]
    grind [Finset.mem_compl]
  have h₂ : Disjoint (Finset.image γ₃ .univ) (Finset.image γ₄ .univ) := by
    rw [Finset.disjoint_iff_ne]
    grind
  have h₃ : Disjoint (Finset.disjUnion _ _ h₂) {(0, 0), (Fin.last _, Fin.last _)} := by
    rw [Finset.disjoint_iff_ne]
    simp only [Finset.mem_insert, forall_eq_or_imp, Prod.forall]
    rintro ⟨a, _⟩ ⟨b, _⟩
    simp
    grind
  have h₄ : Disjoint (Finset.disjUnion _ _ h₁) (Finset.disjUnion _ _ h₃) := by
    rw [Finset.disjoint_iff_ne]
    simp only [Finset.compl_filter, not_lt, Finset.disjUnion_eq_union, Finset.mem_union,
      Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and, Prod.exists, ne_eq,
      Finset.mem_insert, Finset.mem_singleton, Prod.forall, Prod.mk.injEq, not_and,
      S, γ₁, γ₂, γ₃, γ₄]
    rintro ⟨a, _⟩ ⟨b, _⟩ (⟨⟨j, _⟩, ⟨l, _⟩, h₁, h₂, h₃⟩ |
        ⟨⟨j, _⟩, ⟨l, _⟩, h₁, h₂, h₃⟩) _ _
      ((⟨⟨i, _⟩, h₄, h₅⟩ | ⟨⟨i, _⟩, h₄, h₅⟩) | (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)) <;>
        simp [Fin.ext_iff] at h₁ h₂ h₃ ⊢ <;> grind
  have Hc : (Finset.disjUnion _ _ h₁)ᶜ = Finset.disjUnion _ _ h₃ :=
    Finset.compl_eq_of_disjoint_of_card_add_eq h₄ (by
      rw [Finset.card_disjUnion, Finset.card_disjUnion, Finset.card_disjUnion,
        Finset.card_image_of_injective _ hγ₁, Finset.card_image_of_injective _ hγ₂,
        Finset.card_image_of_injective _ hγ₃, Finset.card_image_of_injective _ hγ₄]
      simp
      lia)
  rw [eq₁, eq₂, ← S.sum_add_sum_compl, eq₃, eq₄,
    neg_add_rev, neg_neg, neg_neg, ← Finset.sum_disjUnion h₁,
    ← (Finset.disjUnion _ _ h₁).sum_add_sum_compl, neg_add,
    ← add_assoc, add_neg_cancel, zero_add, Hc,
    Finset.sum_disjUnion, Finset.sum_disjUnion,
    Finset.sum_image hγ₃.injOn, Finset.sum_image hγ₄.injOn,
    Finset.sum_insert (by simp), Finset.sum_singleton,
    neg_add_rev, neg_add_rev, neg_add_rev, eq₅]
  simp

end ToChainHomotopy

/-- For a semisimplicial homotopy H between f, g : X ⟶ Y in a preadditive category C, the family
s_n = −∑ k : Fin (n + 1), (−1)^k • H.h k defines a chain homotopy between the alternating-face
chain maps of f and g. In degree n + 1 it satisfies f_(n+1) = d_X(n+1,n) ≫ s_n + s_(n+1) ≫
d_Y(n+2,n+1) + g_(n+1); in degree zero it satisfies f₀ = s₀ ≫ d_Y(1,0) + g₀. -/
def toChainHomotopy (H : Homotopy f g) :
    _root_.Homotopy
      ((AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex C).map f)
      ((AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex C).map g) where
  hom := ToChainHomotopy.hom H
  zero i j hij := ToChainHomotopy.hom_eq_zero H i j hij
  comm n := by
    cases n with
    | zero =>
        rw [prevD_eq (j' := 1) (w := by simp), dNext_eq_zero _ _ (by simp), zero_add]
        simpa only [AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex_map_f,
          AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex_obj_d] using
            ToChainHomotopy.comm_zero H
    | succ n =>
        rw [dNext_eq (i' := n) (w := by simp), prevD_eq (j' := n + 2) (w := by simp)]
        simpa only [AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex_map_f,
          AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex_obj_d] using
            ToChainHomotopy.comm_succ H n

/-- Let H be a semisimplicial homotopy between f, g : X ⟶ Y in a preadditive category C. For every
p : ℕ, H.toChainHomotopy.hom p (p + 1) equals −∑ k : Fin (p + 1), (−1 : ℤ)^k • H.h k as a
morphism X_p ⟶ Y_(p+1). -/
@[simp]
theorem toChainHomotopy_hom (p : ℕ) :
    H.toChainHomotopy.hom p (p + 1) =
      -∑ k : Fin (p + 1), (-1 : ℤ) ^ k.val • H.h k :=
  ToChainHomotopy.hom_eq H p

@[simp]
theorem toChainHomotopy_hom_eq_zero (p q : ℕ) (hpq : p + 1 ≠ q) :
    H.toChainHomotopy.hom p q = 0 := ToChainHomotopy.hom_eq_zero H p q hpq

include H in
/-- Let f, g : X ⟶ Y be semisimplicial maps in a preadditive category C and let H be a
semisimplicial homotopy between them. For n : ℕ, assume that the alternating-face complexes of
X and Y each have homology in degree n. Then their induced maps H_n(map f) and H_n(map g),
from the homology of X to that of Y, are equal. -/
theorem homologyMap_eq (n : ℕ)
    [((AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex C).obj X).HasHomology n]
    [((AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex C).obj Y).HasHomology n] :
    HomologicalComplex.homologyMap
        ((AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex C).map f) n =
      HomologicalComplex.homologyMap
        ((AlgebraicTopology.semiSimplicialAlternatingFaceMapComplex C).map g) n :=
  _root_.Homotopy.homologyMap_eq (toChainHomotopy H) n

end CategoryTheory.SemiSimplicialObject.Homotopy
