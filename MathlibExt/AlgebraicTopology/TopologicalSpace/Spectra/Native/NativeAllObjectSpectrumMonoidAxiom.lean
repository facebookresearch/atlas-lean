  StableModelConstruction.symmetricModelCategory (B := B)

/-- The genuine original acyclic caller quotient has a trivial zero leg
after smashing with the actual original QY. The right endpoint Y is unrestricted. -/
private theorem symmetric_callerQuotient_originalQ_trivialZero
    {A X Z : Actual.SymmetricCarrier.{u, v}} (i : A ⟶ X)
    (hi : trivialCofibrations Actual.SymmetricCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (Y : Actual.SymmetricCarrier.{u, v}) :
    trivialCofibrations Actual.SymmetricCarrier.{u, v}
      (q0 ▷ StableModelConstruction.symmetricCofibrantReplacement.obj Y) := by
  let QY := StableModelConstruction.symmetricCofibrantReplacement.obj Y
  let _ : IsCofibrant QY := StableModelConstruction.symmetricQ_isCofibrant Y
  have hq := (symmetric_callerQuotient_acyclic i hi qX q0 sq).1
  let pp := NativeStableMonoidal.SymmetricSmash.stablePushoutProductAxiom (B := B)
  exact pp.whiskerRight_mem_trivialCofibrations q0 QY hq

/-- The exact source zero-smash isomorphism and actual Q quotient leg give
every original Omega test of the same quotient-smash collapse. -/
private theorem symmetric_callerQuotient_originalQ_omegaNull
    {A X Z : Actual.SymmetricCarrier.{u, v}} (i : A ⟶ X)
    (hi : trivialCofibrations Actual.SymmetricCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (Y : Actual.SymmetricCarrier.{u, v}) :
    NativeK.omegaTests Actual.symmetricFamily
      (Diagrams.toZero (Z ⊗ StableModelConstruction.symmetricCofibrantReplacement.obj Y)) := by
  let QY := StableModelConstruction.symmetricCofibrantReplacement.obj Y
  let W := NativeK.omegaTests Actual.symmetricFamily.{u, v}
  have hq := (symmetric_callerQuotient_originalQ_trivialZero i hi qX q0 sq Y).2
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1] at hq
  let z0 := (symmetricZeroRightSmashIso QY).inv ≫ q0 ▷ QY
  have hz0 : W z0 := W.comp_mem _ _ (W.of_isIso (symmetricZeroRightSmashIso QY).inv) hq
  have hCollapse : z0 ≫ Diagrams.toZero (Z ⊗ QY) = 𝟙 Diagrams.zeroDiagram :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  exact W.of_precomp z0 _ hz0 (hCollapse.symm ▸ W.id_mem Diagrams.zeroDiagram)

end Symmetric

section Orthogonal

attribute [local instance] Orthogonal.CanonicalSourceSmash.monoidalCategory
  Orthogonal.CanonicalSourceSmash.symmetricCategory Orthogonal.CanonicalSourceSmashClosed.monoidalClosed

private local instance orthogonalOriginalStableModel : ModelCategory Actual.OrthogonalCarrier.{u, v} :=
  StableModelConstruction.orthogonalModelCategory (B := B)

/-- Any actual stable-cofibrant right object receives the same caller
quotient zero leg as a stable trivial cofibration under the literal original smash. -/
private theorem orthogonal_callerQuotient_cofibrantRight_trivialZero
    {A X Z : Actual.OrthogonalCarrier.{u, v}} (i : A ⟶ X)
    (hi : trivialCofibrations Actual.OrthogonalCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (QY : Actual.OrthogonalCarrier.{u, v}) [IsCofibrant QY] :
    trivialCofibrations Actual.OrthogonalCarrier.{u, v} (q0 ▷ QY) := by
  have hq := (orthogonal_callerQuotient_acyclic i hi qX q0 sq).1
  let pp := NativeStableMonoidal.OrthogonalSmash.stablePushoutProductAxiom (B := B)
  exact pp.whiskerRight_mem_trivialCofibrations q0 QY hq

/-- The actual caller quotient smashed with any stable-cofibrant right
object is Omega-null through its exact zero-smash map and literal terminal collapse. -/
private theorem orthogonal_callerQuotient_cofibrantRight_omegaNull
    {A X Z : Actual.OrthogonalCarrier.{u, v}} (i : A ⟶ X)
    (hi : trivialCofibrations Actual.OrthogonalCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (QY : Actual.OrthogonalCarrier.{u, v}) [IsCofibrant QY] :
    NativeK.omegaTests Actual.orthogonalFamily (Diagrams.toZero (Z ⊗ QY)) := by
  let W := NativeK.omegaTests Actual.orthogonalFamily.{u, v}
  have hq := (orthogonal_callerQuotient_cofibrantRight_trivialZero i hi qX q0 sq QY).2
  rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1] at hq
  let z0 := (orthogonalZeroRightSmashIso QY).inv ≫ q0 ▷ QY
  have hz0 : W z0 := W.comp_mem _ _ (W.of_isIso (orthogonalZeroRightSmashIso QY).inv) hq
  have hCollapse : z0 ≫ Diagrams.toZero (Z ⊗ QY) = 𝟙 Diagrams.zeroDiagram :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  exact W.of_precomp z0 _ hz0 (hCollapse.symm ▸ W.id_mem Diagrams.zeroDiagram)

/-- The same literal orthogonal caller quotient and its actual original
QY give a stable trivial zero-smash leg, for every original right spectrum Y. -/
private theorem orthogonal_callerQuotient_originalQ_trivialZero
    {A X Z : Actual.OrthogonalCarrier.{u, v}} (i : A ⟶ X)
    (hi : trivialCofibrations Actual.OrthogonalCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (Y : Actual.OrthogonalCarrier.{u, v}) :
    trivialCofibrations Actual.OrthogonalCarrier.{u, v}
