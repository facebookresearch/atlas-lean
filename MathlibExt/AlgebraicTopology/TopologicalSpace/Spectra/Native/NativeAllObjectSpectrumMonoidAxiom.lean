    (hf : NativeK.omegaTests Actual.symmetricFamily (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f))
    (E : C.{u, v}) (hE : NativeK.IsOmega Actual.symmetricFamily E) :
    Function.Bijective (fun g : H.obj
      (Free.object a (TensorPower.tensorPowObj PointedCGWH.sphereOne n) ⊗ Y) ⟶ H.obj E =>
        H.map (Free.object a (TensorPower.tensorPowObj PointedCGWH.sphereOne n) ◁ f) ≫ g) :=
  (originalFreeSphereSmash_omegaTests_iff_unitCoefficient a n f).mpr hf E hE

