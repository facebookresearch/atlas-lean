/-- The complete literal natural reduction has original group isomorphisms
at every source chart whenever the original Gamma source maps do. -/
private theorem reductionSource_integerIsIso (S : I → C) (γ : ∀ i, S i ⟶ 𝟙_ C)
    (P : J → C ⥤ GrpCat.{uG}) (F : K → C)
