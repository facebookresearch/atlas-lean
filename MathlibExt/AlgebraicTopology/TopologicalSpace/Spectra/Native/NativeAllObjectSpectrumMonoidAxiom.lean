namespace HomotopicalAlgebra.GammaActionModelBoundary

variable {C : Type u} [Category.{v} C] [ModelCategory C]

section Action

variable [MonoidalCategory C]

/-- The complete original action family retains every original physical source formula together. -/
private def SourceFamily (S : ℕ → C) (D : ∀ n : ℕ, GammaFirstNatSource.Action (S n)) : Prop :=
  ∀ n : ℕ, GammaFirstNatSource.SourceFormula (D n)

/-- The whole original physical first-join family supplies every original source equation before projection. -/
private theorem of_joins (S : ℕ → C) (D : ∀ n : ℕ, GammaFirstNatSource.FirstJoin (S n)) :
    SourceFamily S (fun n => (D n).action) := fun n => (D n).first

/-- Proved equality of the entire action families transports the same whole original physical source equation. -/
private theorem transport_source (S : ℕ → C) (D E : ∀ n : ℕ, GammaFirstNatSource.Action (S n))
    (h : D = E) (hD : SourceFamily S D) : SourceFamily S E := by
  subst E
  exact hD

section Closed

variable [BraidedCategory C] [MonoidalClosed C]

/-- The actual fixed-left Quillen adjunction and original whole tensor functor supply source cofibrancy. -/
private theorem cofibrant_obj (hPP : MonoidalPushoutProductAxiom C) (S : C) [IsCofibrant S]
    (D : GammaFirstNatSource.Action S) (X : C) [IsCofibrant X] :
    IsCofibrant (D.functor.obj X) := by
  rw [D.source]
  let _ : (ihom.adjunction S).IsQuillenAdjunction := hPP.ihomAdjunction_isQuillenAdjunction S
  exact Adjunction.IsQuillenAdjunction.preservesCofibrantObjects
    (adj := ihom.adjunction S) inferInstance

end Closed

end Action

/-- The exact original null word and receiver functor define the full source-null action property. -/
private def NullFormula (z : ∀ X Y : C, X ⟶ Y) (F : C ⥤ C) : Prop :=
  ∀ (X Y : C) (_hX : IsCofibrant X) (g : X ⟶ Y),
    (_root_.HomotopicalAlgebra.toHomotopyCategory C).map g = (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (z X
      Y) →
      (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (F.map g) =
        (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (z (F.obj X) (F.obj Y))

/-- Whole original functor equality transports every original source-null map and both physical endpoints together. -/
private theorem transport_null (z : ∀ X Y : C, X ⟶ Y) (F G : C ⥤ C) (h : F = G)
    (hG : NullFormula z G) : NullFormula z F := by
  subst F
  exact hG






end HomotopicalAlgebra.GammaActionModelBoundary

