  SmallObject.πObj I realizedGeneratorCardinal (Diagrams.zeroTo X)

private theorem initialCellObject_whole :
    (fun X : C.{u, v} => initialCellObject X) = originalInitialCellObjectFamily := rfl

/-- The complete inclusion family is the original small-object first factor family. -/
theorem initialCellInclusion_whole :
    (fun X : C.{u, v} => initialCellInclusion X) =
      (fun X : C.{u, v} => SmallObject.ιObj I realizedGeneratorCardinal (Diagrams.zeroTo X)) :=
  rfl

/-- The complete projection family is the original small-object second factor family. -/
theorem initialCellProjection_whole :
    (fun X : C.{u, v} => initialCellProjection X) =
      (fun X : C.{u, v} => SmallObject.πObj I realizedGeneratorCardinal (Diagrams.zeroTo X)) :=
  rfl

/-- The original inclusion and projection compose to the unchanged initial arrow. -/
theorem initialCell_factor (X : C.{u, v}) :
    initialCellInclusion X ≫ initialCellProjection X = Diagrams.zeroTo X :=
  SmallObject.ιObj_πObj I realizedGeneratorCardinal (Diagrams.zeroTo X)

/-- The whole literal original RelativeCellComplex: every native label, successor
cofan and pushout, bottom isomorphism and limit cocone comes from the real I-factor. -/
def initialCellComplex (X : C.{u, v}) :
    RelativeCellComplex.{v}
      (fun (_ : realizedGeneratorCardinal.{v}.ord.ToType) => I.{u, v}.homFamily)
      (initialCellInclusion X) :=
  SmallObject.relativeCellComplexιObj I realizedGeneratorCardinal (Diagrams.zeroTo X)

/-- The complete cell-history family is the original small-object cell-history family. -/
theorem initialCellComplex_whole :
    (fun X : C.{u, v} => initialCellComplex X) =
      (fun X : C.{u, v} =>
        SmallObject.relativeCellComplexιObj I realizedGeneratorCardinal (Diagrams.zeroTo X)) :=
  rfl

/-- Original level cofibrancy lifts against the genuine original I right factor;
the lifting construction produces the whole source Arrow retract. -/
def initialArrowRetract (X : C.{u, v}) [IsCofibrant X] :
    RetractArrow (Diagrams.zeroTo X) (initialCellInclusion X) := by
  have hLeft : I.{u, v}.rlp.llp (Diagrams.zeroTo X) := by
    have hCof : cofibrations C.{u, v} (Diagrams.zeroTo X) :=
      (HomotopicalAlgebra.cofibration_iff _).mp
        ((isCofibrant_iff_of_isInitial (Diagrams.zeroTo X) Diagrams.zeroDiagramIsInitial).mp
          inferInstance)
    rwa [Native.cofibrations_eq] at hCof
  let _ : HasLiftingProperty (Diagrams.zeroTo X) (initialCellProjection X) :=
    hLeft _ (SmallObject.rlp_πObj I realizedGeneratorCardinal (Diagrams.zeroTo X))
  exact RetractArrow.ofLeftLiftingProperty (initialCell_factor X)

/-- The original Arrow retract keeps both initial identities and the whole projection. -/
theorem initialArrowRetract_maps (X : C.{u, v}) [IsCofibrant X] :
    (initialArrowRetract X).i.left = 𝟙 Diagrams.zeroDiagram ∧
      (initialArrowRetract X).r.left = 𝟙 Diagrams.zeroDiagram ∧
      (initialArrowRetract X).r.right = initialCellProjection X :=
  ⟨rfl, rfl, rfl⟩

/-- The actual caller spectrum is a retract of the unchanged realized-cardinal I-cell object. -/
private def initialSourceRetract (X : C.{u, v}) [IsCofibrant X] : Retract X (initialCellObject X) :=
  { i := (initialArrowRetract X).i.right
    r := (initialArrowRetract X).r.right
    retract := by simp }

private theorem initialSourceRetract_maps_and_split (X : C.{u, v}) [IsCofibrant X] :
    (initialSourceRetract X).i = (initialArrowRetract X).i.right ∧
      (initialSourceRetract X).r = initialCellProjection X ∧
      (initialSourceRetract X).i ≫ initialCellProjection X = 𝟙 X :=
  ⟨rfl, rfl, (initialSourceRetract X).retract⟩













