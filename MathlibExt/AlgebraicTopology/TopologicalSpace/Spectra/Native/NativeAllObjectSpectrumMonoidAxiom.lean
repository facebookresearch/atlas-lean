private theorem originalGammaReduction_integerIsIso (n : ℕ) (q : ℤ) (Y : C.{u, v}) :
    IsIso ((P q).map ((NativeGammaExactActions.actions n).reduction.app Y)) :=
  originalNativeGamma_isIso_given_source_geometry q
    (NativeGammaExactActions.actions n).functor (NativeGammaExactActions.actions n).reduction
    (originalIntegerFreeSphere q) (originalIntegerFreeGenerator q)
    (fun Y β => originalIntegerFree_representative q Y β)
    (fun Y α hα => originalIntegerFree_kernelRepresentative q
      ((NativeGammaExactActions.actions n).reduction.app Y) α hα)
    (fun t => OriginalGammaNativeReduction.freeSourceReduction_integerIsIso (B := B) n
      (integerTailLevel q + t) (integerTailPositiveIndex q + t + 1) q)
    (fun t Y f => NativeGammaSourceFullClient.freeSphere_first (B := B) n
      (integerTailLevel q + t) (integerTailPositiveIndex q + t + 1) Y f)
    (fun t Y g h => NativeGammaSourceFullClient.freeSphere_null (B := B) n
      (integerTailLevel q + t) (integerTailPositiveIndex q + t + 1) Y g h) Y

/-- The full original Gamma integer comparison keeps its actual reduction as
each forward map and retains every original target and arrow naturally. -/
private def originalGammaIntegerNatIso (n : ℕ) (q : ℤ) :
    (NativeGammaExactActions.actions n).functor ⋙ P q ≅ P q := by
  let e (Y : C.{u, v}) : (P q).obj ((NativeGammaExactActions.actions n).functor.obj Y) ≅
      (P q).obj Y := by
    let _ : IsIso ((P q).map ((NativeGammaExactActions.actions n).reduction.app Y)) :=
      originalGammaReduction_integerIsIso n q Y
    exact asIso ((P q).map ((NativeGammaExactActions.actions n).reduction.app Y))
  refine NatIso.ofComponents e ?_
  intro X Y f
  change (P q).map ((NativeGammaExactActions.actions n).functor.map f) ≫
      (P q).map ((NativeGammaExactActions.actions n).reduction.app Y) =
    (P q).map ((NativeGammaExactActions.actions n).reduction.app X) ≫ (P q).map f
  rw [← Functor.map_comp, ← Functor.map_comp]
  exact (P q).congr_map ((NativeGammaExactActions.actions n).reduction.naturality f)

