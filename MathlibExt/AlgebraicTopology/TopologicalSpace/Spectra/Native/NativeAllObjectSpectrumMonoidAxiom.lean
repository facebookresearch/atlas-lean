/-- The entire original native free sphere is the same source free object. -/
private def originalFreeSphere (n : ℕ) : C.{u, v} :=
  Free.object (PointedCGWH.symmetricOperatorObj.{u, v} (card n)) (Coefficient n)

/-- The same original balanced sphere-smash functor retains the native free source. -/
private def originalFreeSphereSmashFunctor (n : ℕ) : C.{u, v} ⥤ C.{u, v} :=
  NativeOmegaPreparation.NativeSymmetricFunction.smashFunctor (originalFreeSphere n)

private theorem originalFreeAt_object (r : CategoryTheory.Operad.SmallFinBijGroupoid)
    (M : PointedCGWH.{u, v}) :
    (PointedCGWH.SymmetricSpectrum.freeAt r).obj M =
      Free.object (PointedCGWH.symmetricOperatorObj r) M := rfl

private theorem isIso_of_mapFunctorEq {A : Type uA} [Category.{vA} A]
    {D : Type uD} [Category.{vD} D] {E : Type uE} [Category.{vE} E]
    (P : D ⥤ E) {F G : A ⥤ D} (e : F = G) {X Y : A} (f : X ⟶ Y)
    (h : IsIso (P.map (G.map f))) : IsIso (P.map (F.map f)) := by
  cases e
  exact h

/-- The whole original orbit calculation applies to the identical original
balanced smash, before any caller input or degree is projected. -/
private theorem originalFreeSphereSmashFunctor_eq (n : ℕ) :
    originalFreeSphereSmashFunctor.{u, v} n =
      PointedCGWH.SymmetricSpectrum.freeSmash (card n) (Coefficient n) := by
  change NativeOmegaPreparation.NativeSymmetricFunction.smashFunctor
      (Free.object (PointedCGWH.symmetricOperatorObj (card n)) (Coefficient n)) =
    NativeOmegaPreparation.NativeSymmetricFunction.smashFunctor
      ((PointedCGWH.SymmetricSpectrum.freeAt (card n)).obj (Coefficient n))
  exact congrArg NativeOmegaPreparation.NativeSymmetricFunction.smashFunctor
    (originalFreeAt_object (card n) (Coefficient n)).symm

