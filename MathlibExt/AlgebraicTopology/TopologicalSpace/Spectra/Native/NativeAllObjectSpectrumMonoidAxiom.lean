/-- Every representation sphere and arbitrary input Arrow retains the
actual original level-Ho precomposition function at every original Omega target. -/
private theorem representationSphere_forward_allTargets (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y)
    (hf : NativeK.omegaTests (B := B) Actual.orthogonalFamily f)
    (E : C.{u, v}) (hE : NativeK.IsOmega Actual.orthogonalFamily E) :
    Function.Bijective (fun g : H.obj
      ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).obj Y) ⟶
        H.obj E => H.map
      ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f) ≫ g) :=
  (originalRepresentationSphere_omegaTests_iff (B := B) n f).mpr hf E hE

/-- Reflection returns each same original Omega target's untouched source
precomposition function from the actual original representation-sphere Arrow. -/
private theorem representationSphere_reflect_allTargets (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y)
    (hf : NativeK.omegaTests (B := B) Actual.orthogonalFamily
      ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f))
    (E : C.{u, v}) (hE : NativeK.IsOmega Actual.orthogonalFamily E) :
    Function.Bijective (fun g : H.obj Y ⟶ H.obj E => H.map f ≫ g) :=
  (originalRepresentationSphere_omegaTests_iff (B := B) n f).mp hf E hE

/-- The full scalar power and actual representation sphere retain both
original integer and all-target Omega tests at the same arbitrary Arrow. -/
