/-- The complete original free-unit coefficient tests follow from the
same free sphere coefficient tests at every actual Omega target and arbitrary endpoints. -/
private theorem freeUnit_allTargets_of_freeSphere
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (n : ℕ)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hf : NativeK.omegaTests Actual.symmetricFamily
      (Free.object a (TensorPower.tensorPowObj PointedCGWH.sphereOne n) ◁ f))
    (E : C.{u, v}) (hE : NativeK.IsOmega Actual.symmetricFamily E) :
    Function.Bijective (fun g : H.obj (Free.object a (𝟙_ PointedCGWH.{u, v}) ⊗ Y) ⟶ H.obj E =>
      H.map (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) ≫ g) :=
  (originalFreeSphereSmash_omegaTests_iff_unitCoefficient a n f).mp hf E hE

/-- All original free-sphere coefficient tests follow back from the same
free unit coefficient tests, retaining all native target precomposition functions. -/
private theorem freeSphere_allTargets_of_freeUnit
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (n : ℕ)
