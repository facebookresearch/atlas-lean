/-- Every literal original ofIndex chart, including both zero degrees,
retains the same full signed-map equivalence without a positive restriction. -/
private theorem allOriginalFreeSphereIntegerMaps_ofIndex (r n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map
      (Free.object (OrthogonalOperatorIndex.ofIndex r)
        (PointedCGWH.orthogonalSphere.{u, v} n) ◁ f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map
        (Free.object (OrthogonalOperatorIndex.ofIndex r) (𝟙_ PointedCGWH.{u, v}) ◁ f)) :=
  originalFreeSphereSmash_integerPi_iff_unitCoefficient_ofIndex r n f
















