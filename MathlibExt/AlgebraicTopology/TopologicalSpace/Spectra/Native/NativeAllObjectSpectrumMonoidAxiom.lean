/-- Cofibrancy in the literal original stable model uses the same original
I-cell source and whole retract. Genuine generator endpoints imply its smash test. -/
private theorem originalStableCofibrantSmash_omegaTests_of_generatorEndpoints
    {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {A X : C.{u, v}} (i : A ⟶ X), NativeK.levelI i →
      NativeK.omegaTests Actual.symmetricFamily (A ◁ f) ∧
        NativeK.omegaTests Actual.symmetricFamily (X ◁ f))
    (X : C.{u, v}) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    IsCofibrant X → NativeK.omegaTests Actual.symmetricFamily (X ◁ f) := by
  let stableModel : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  let _ : ModelCategory C.{u, v} := stableModel
  change IsCofibrant X → NativeK.omegaTests Actual.symmetricFamily (X ◁ f)
  intro hX
  let _ : IsCofibrant X := hX
  have hCofStable : stableModel.categoryWithCofibrations.cofibrations (Diagrams.zeroTo X) :=
    (HomotopicalAlgebra.cofibration_iff _).mp
      ((isCofibrant_iff_of_isInitial (Diagrams.zeroTo X) Diagrams.zeroDiagramIsInitial).mp hX)
  let nativeModel : ModelCategory C.{u, v} := HomotopicalAlgebra.EnrichedProjective.Native.modelCategory
    (B := B) (A := PointedCGWH.SymmetricOperatorIndex.{u, v})
  have hCofLevel : nativeModel.categoryWithCofibrations.cofibrations (Diagrams.zeroTo X) := by
    rw [← StableModelConstruction.symmetric_cofibrations_eq_level]
    exact hCofStable
  let _ : ModelCategory C.{u, v} := nativeModel
  let _ : Cofibration (Diagrams.zeroTo X) := (HomotopicalAlgebra.cofibration_iff _).mpr hCofLevel
  let _ : IsCofibrant X :=
    (isCofibrant_iff_of_isInitial (Diagrams.zeroTo X) Diagrams.zeroDiagramIsInitial).mpr inferInstance
  exact originalCofibrantSmash_omegaTests_of_generatorEndpoints f hEndpoints X

/-- The same literal stable model weak class receives the original smash
map of every actual stable-cofibrant left spectrum and arbitrary right endpoints. -/
private theorem originalStableCofibrantSmash_weak_of_generatorEndpoints
    {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {A X : C.{u, v}} (i : A ⟶ X), NativeK.levelI i →
      NativeK.omegaTests Actual.symmetricFamily (A ◁ f) ∧
        NativeK.omegaTests Actual.symmetricFamily (X ◁ f))
    (X : C.{u, v}) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    IsCofibrant X → weakEquivalences C.{u, v} (X ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  change IsCofibrant X → weakEquivalences C.{u, v} (X ◁ f)
  intro hX
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1]
  exact originalStableCofibrantSmash_omegaTests_of_generatorEndpoints f hEndpoints X hX




