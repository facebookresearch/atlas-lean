section Symmetric

private local instance symmetricOriginalStableModel : ModelCategory Actual.SymmetricCarrier.{u, v} :=
  StableModelConstruction.symmetricModelCategory (B := B)

/-- Every caller quotient of an original stable acyclic symmetric cofibration is
cofibrant and acyclic through its actual zero-source pushout map. -/
private theorem symmetric_callerQuotient_acyclic
    {A X Z : Actual.SymmetricCarrier.{u, v}}
    (i : A ⟶ X) (hi : trivialCofibrations Actual.SymmetricCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) :
    trivialCofibrations Actual.SymmetricCarrier.{u, v} q0 ∧
      IsCofibrant Z ∧
        weakEquivalences Actual.SymmetricCarrier.{u, v} (Diagrams.toZero Z) := by
  have hq : trivialCofibrations Actual.SymmetricCarrier.{u, v} q0 :=
    (trivialCofibrations Actual.SymmetricCarrier.{u, v}).of_isPushout sq.flip hi
  have hCof : IsCofibrant Z := by
    let _ : Cofibration q0 := (HomotopicalAlgebra.cofibration_iff q0).mpr hq.1
    exact (isCofibrant_iff_of_isInitial q0 Diagrams.zeroDiagramIsInitial).mpr inferInstance
  have hCollapse : q0 ≫ Diagrams.toZero Z = 𝟙 Diagrams.zeroDiagram :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  have hComposite : weakEquivalences Actual.SymmetricCarrier.{u, v}
      (q0 ≫ Diagrams.toZero Z) := by
    rw [hCollapse]
    exact (weakEquivalences Actual.SymmetricCarrier.{u, v}).id_mem _
  exact ⟨hq, hCof,
    (weakEquivalences Actual.SymmetricCarrier.{u, v}).of_precomp _ _ hq.2 hComposite⟩

/-- The source's literal quotient is the original acyclic cofibration pushed out
along the unchanged collapse of its source. -/
private theorem symmetric_originalQuotient_acyclic
    {A X : Actual.SymmetricCarrier.{u, v}}
    (i : A ⟶ X) (hi : trivialCofibrations Actual.SymmetricCarrier.{u, v} i) :
    trivialCofibrations Actual.SymmetricCarrier.{u, v}
        (pushout.inr i (Diagrams.toZero A)) ∧
      IsCofibrant (pushout i (Diagrams.toZero A)) ∧
        weakEquivalences Actual.SymmetricCarrier.{u, v}
          (Diagrams.toZero (pushout i (Diagrams.toZero A))) :=
  symmetric_callerQuotient_acyclic i hi
    (pushout.inl i (Diagrams.toZero A)) (pushout.inr i (Diagrams.toZero A))
    (IsPushout.of_hasPushout i (Diagrams.toZero A))

end Symmetric

