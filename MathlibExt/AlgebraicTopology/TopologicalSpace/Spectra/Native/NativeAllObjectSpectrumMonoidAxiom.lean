private def cofanOfInitialComplement
    {C : Type uC} [Category.{vC} C] {α : Type uA} {β : Type uB}
    (X : α → C) (t : Cofan X) (e : β ↪ α)
    (ht : IsColimit (Cofan.mk t.pt (fun b : β => t.inj (e b))))
    (hMissing : ∀ a : α, a ∉ Set.range e → IsInitial (X a)) : IsColimit t := by
  let restrict (s : Cofan X) : Cofan (fun b : β => X (e b)) :=
    Cofan.mk s.pt (fun b => s.inj (e b))
  refine Cofan.IsColimit.mk t (fun s => ht.desc (restrict s)) ?_ ?_
  · intro s a
    by_cases ha : a ∈ Set.range e
    · obtain ⟨b, rfl⟩ := ha
      exact ht.fac (restrict s) ⟨b⟩
    · exact (hMissing a ha).hom_ext _ _
  · intro s m hm
    apply Cofan.IsColimit.hom_ext ht
    intro b
    exact (hm (e b)).trans (ht.fac (restrict s) ⟨b⟩).symm

private def cofanOfInitialObjects
    {C : Type uC} [Category.{vC} C] {α : Type uA}
    (X : α → C) (t : Cofan X) (ht : IsInitial t.pt)
    (hX : ∀ a : α, IsInitial (X a)) : IsColimit t :=
  Cofan.IsColimit.mk t (fun s => ht.to s.pt)
    (fun _ a => (hX a).hom_ext _ _) (fun _ _ _ => ht.hom_ext _ _)

private theorem activeLegCast {C : Type uC} [Category.{vC} C]
    (X W : ℕ → C) (n a : ℕ) (l : ∀ c, a ≤ c → (X c ⟶ W (c + n)))
    {c d : ℕ} (h : c = d) (hc : a ≤ c) (hd : a ≤ d) :
    l c hc ≫ eqToHom (congrArg W (congrArg (fun c => c + n) h)) =
      eqToHom (congrArg X h) ≫ l d hd := by
  cases h
  simp only [eqToHom_refl, Category.id_comp, Category.comp_id]

private theorem sourceCastOfHEq {C : Type uC} [Category.{vC} C]
    {A A' B : C} (e : A = A') (f : A ⟶ B) (g : A' ⟶ B) (h : HEq f g) :
    f = eqToHom e ≫ g := by
  cases e
  rw [eqToHom_refl, Category.id_comp]
  exact eq_of_heq h

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf
  PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers

/-- The entire original stable-label cofan uses the actual native summand
inclusions into the unchanged balanced free-smash restriction. -/
private def originalOrbitCofan (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    Cofan (fun label : StableOrbitIndex n => nativeSummand n M Y label) :=
  Cofan.mk (originalFreeSmashRestriction n M Y)
    (fun label => originalNativeSummandInclusion n M Y label)

private def orbitLevelIso (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    (nativeSummand n M Y (orbitIntoStable c n i)).level (c + n) ≅
      M ⊗ Y.X.functor.obj (card c) := by
  have hc : firstAppearance n (orbitIntoStable c n i) ≤ c :=
    firstAppearance_le n _ c ⟨i, rfl⟩
  exact eqToIso (nativeSummand_level n M Y (orbitIntoStable c n i) (c + n)) ≪≫
    eqToIso (nativeSummandLevel_above n M Y (orbitIntoStable c n i) (c + n) (by omega)) ≪≫
    eqToIso (congrArg (fun d => M ⊗ Y.X.functor.obj (card d))
      (show (c + n) - n = c by omega))

private theorem originalOrbitInclusion_at_sum (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    PointedCGWH.SequentialSpectrum.levelMap
        (originalNativeSummandInclusion n M Y (orbitIntoStable c n i)) (c + n) =
      (orbitLevelIso c n M Y i).hom ≫ finiteNativeLeg c n M Y i := by
  let label := orbitIntoStable c n i
  have hc : firstAppearance n label ≤ c := firstAppearance_le n label c ⟨i, rfl⟩
  have hi : activeOrbit n label c hc = i := activeOrbit_unique n label c hc i rfl
  have hRaw := nativeSummandInclusion_levelMap_above n M Y (nativeFiniteOrbitStructure n M Y)
    label (c + n) (by omega)
  have h := sourceCastOfHEq (nativeSummand_level n M Y label (c + n))
    (PointedCGWH.SequentialSpectrum.levelMap (originalNativeSummandInclusion n M Y label) (c + n))
    (eqToHom (nativeSummandLevel_above n M Y label (c + n) (by omega)) ≫
      activeNativeLeg n M Y label ((c + n) - n) (by omega) ≫
        eqToHom (congrArg (originalFreeSmashRestriction n M Y).level
          (show (c + n) - n + n = c + n by omega))) (heq_of_eq hRaw)
  have hDegree : (c + n) - n = c := by omega
  have hCast := activeLegCast (scalarRestriction M Y).level
    (originalFreeSmashRestriction n M Y).level n (firstAppearance n label)
    (activeNativeLegFamily n M Y label) hDegree (by omega) hc
  change activeNativeLeg n M Y label ((c + n) - n) _ ≫
      eqToHom (congrArg (originalFreeSmashRestriction n M Y).level
        (show (c + n) - n + n = c + n by omega)) =
    eqToHom (congrArg (fun d => M ⊗ Y.X.functor.obj (card d)) hDegree) ≫
      activeNativeLeg n M Y label c hc at hCast
  rw [hCast] at h
  dsimp only [orbitLevelIso]
  simp only [Iso.trans_hom, eqToIso.hom]
  simpa only [activeNativeLeg, hi, Category.assoc] using h

private def finiteNativeCofanIsColimit (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    IsColimit (Cofan.mk ((originalFreeSmashRestriction n M Y).level (c + n))
      (fun i : OrbitIndex c n => finiteNativeLeg c n M Y i)) := by
  let X := fun _ : OrbitIndex c n => M ⊗ Y.X.functor.obj (card c)
  exact IsColimit.ofIsoColimit (coproductIsCoproduct X)
    (Cocone.ext (freeSmashFiniteOrbitIso c n M Y).symm (by intro i; rfl))

/-- At each genuine source level, the full infinite cofan reduces to the
actual finite orbit cofan; every unavailable summand is genuinely initial. -/
private def originalOrbitLevelCofanIsColimit (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (r : ℕ) :
    IsColimit (Cofan.mk ((originalFreeSmashRestriction n M Y).level r)
      (fun label : StableOrbitIndex n =>
        PointedCGWH.SequentialSpectrum.levelMap
          (originalNativeSummandInclusion n M Y label) r)) := by
  by_cases hr : n ≤ r
  · let c := r - n
    have hDegree : c + n = r := Nat.sub_add_cancel hr
    suffices h : IsColimit (Cofan.mk ((originalFreeSmashRestriction n M Y).level (c + n))
        (fun label : StableOrbitIndex n => PointedCGWH.SequentialSpectrum.levelMap
          (originalNativeSummandInclusion n M Y label) (c + n))) by
      exact Eq.mp (congrArg (fun k => IsColimit (Cofan.mk
        ((originalFreeSmashRestriction n M Y).level k)
        (fun label : StableOrbitIndex n => PointedCGWH.SequentialSpectrum.levelMap
          (originalNativeSummandInclusion n M Y label) k))) hDegree) h
    let X := fun label : StableOrbitIndex n => (nativeSummand n M Y label).level (c + n)
    let t : Cofan X := Cofan.mk ((originalFreeSmashRestriction n M Y).level (c + n))
      (fun label => PointedCGWH.SequentialSpectrum.levelMap
        (originalNativeSummandInclusion n M Y label) (c + n))
    let e : OrbitIndex c n ↪ StableOrbitIndex n :=
      ⟨orbitIntoStable c n, orbitIntoStable_injective c n⟩
    have hFinite : IsColimit (Cofan.mk t.pt (fun i : OrbitIndex c n => t.inj (e i))) := by
      let α : Discrete.functor (fun i : OrbitIndex c n => X (e i)) ≅
          Discrete.functor (fun _ : OrbitIndex c n => M ⊗ Y.X.functor.obj (card c)) :=
        Discrete.natIso (fun i => orbitLevelIso c n M Y i.as)
      let d := Cofan.mk ((originalFreeSmashRestriction n M Y).level (c + n))
        (fun i : OrbitIndex c n => finiteNativeLeg c n M Y i)
      have hd := (IsColimit.precomposeHomEquiv α d).symm
        (finiteNativeCofanIsColimit c n M Y)
      exact IsColimit.ofIsoColimit hd (Cocone.ext (Iso.refl _) (by
        intro i
        change (orbitLevelIso c n M Y i.as).hom ≫ finiteNativeLeg c n M Y i.as ≫ 𝟙 _ =
          PointedCGWH.SequentialSpectrum.levelMap
            (originalNativeSummandInclusion n M Y (orbitIntoStable c n i.as)) (c + n)
        rw [Category.comp_id]
        exact (originalOrbitInclusion_at_sum c n M Y i.as).symm))
    have hMissing (label : StableOrbitIndex n) (hl : label ∉ Set.range e) :
        IsInitial (X label) := by
      have hFirst : c < firstAppearance n label := by
        by_contra h
        obtain ⟨i, hi⟩ := (appears_iff n label c).mpr (Nat.le_of_not_gt h)
        exact hl ⟨i, hi⟩
      change IsInitial (nativeSummandLevel n M Y label (c + n))
      rw [nativeSummandLevel_below n M Y label (c + n) (by omega)]
      exact initialIsInitial
    exact cofanOfInitialComplement X t e hFinite hMissing
  · have hLow : r < n := Nat.lt_of_not_ge hr
    let X := fun label : StableOrbitIndex n => (nativeSummand n M Y label).level r
    let t : Cofan X := Cofan.mk ((originalFreeSmashRestriction n M Y).level r)
      (fun label => PointedCGWH.SequentialSpectrum.levelMap
        (originalNativeSummandInclusion n M Y label) r)
    have ht : IsInitial t.pt :=
      PointedCGWH.SymmetricSpectrum.freeSmashCardBelowIsInitial hLow M Y
    have hX (label : StableOrbitIndex n) : IsInitial (X label) := by
      change IsInitial (nativeSummandLevel n M Y label r)
      rw [nativeSummandLevel_below n M Y label r (by omega)]
      exact initialIsInitial
    exact cofanOfInitialObjects X t ht hX

/-- The whole original free-smash restriction is the actual coproduct of all
original coherent orbit summands, with its full enriched actions retained. -/
private def originalOrbitCofanIsColimit (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : IsColimit (originalOrbitCofan n M Y) := by
  apply CategoryTheory.EnrichedFunctorCat.evaluationJointlyReflectsColimits
  rintro ⟨r⟩
  exact (isColimitMapCoconeCofanMkEquiv
    (PointedCGWH.SequentialSpectrum.evaluation r)
    (fun label : StableOrbitIndex n => nativeSummand n M Y label)
    (fun label => originalNativeSummandInclusion n M Y label)).symm
      (originalOrbitLevelCofanIsColimit n M Y r)





end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.WholeOrbitCofan
end

