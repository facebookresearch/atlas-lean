/-- Every original signed group map is retained in both directions of
the actual free sphere-to-unit coefficient comparison on arbitrary original inputs. -/
private theorem freeSphere_integerPi_iff_freeUnit
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (n : ℕ)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
      (Free.object a (TensorPower.tensorPowObj PointedCGWH.sphereOne n) ◁ f))) ↔
      ∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
