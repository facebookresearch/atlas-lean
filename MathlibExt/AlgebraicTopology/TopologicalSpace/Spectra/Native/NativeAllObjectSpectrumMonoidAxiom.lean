private abbrev Coefficient (n : ℕ) := PointedCGWH.sphereSequence.{u, v}.functor.obj
  (CategoryTheory.Operad.SmallFinBijGroupoid.card n)

/-- Every actual native orbit summand retains the full original integer
comparison and original sphere-scalar cancellation on the untouched input. -/
private def summandIntegerNatIso (n : ℕ) (q : ℤ) (label : StableOrbitIndex n) :
    originalNativeSummandFunctor.{u, v} n (Coefficient n) label ⋙ integerStablePiFunctor q ≅
      Actual.SymmetricIntegerHomotopy.integerPiFunctor q :=
  originalNativeSphereIntegerNatIso q n label ≪≫
    Functor.associator underlyingSequential (EnrichedFunctorCat.tensorLeft (Coefficient n))
      (integerStablePiFunctor (q + (n : ℤ))) ≪≫
    Functor.isoWhiskerLeft underlyingSequential (originalSphereScalarIntegerCancellationNatIso n q)

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

/-- The real finite-cofan comparison preserves the same original integer
map at every actual finite stage, without any endpoint cofibrancy assumption. -/
private theorem finiteStage_integer_isIso (n : ℕ) (q : ℤ)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z)
    (hq : IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map f)) (c : ℕ) :
    IsIso ((integerStablePiFunctor q).map ((coefficientMap n (Coefficient n) f).app c)) := by
  let U := integerStablePiCommFunctor.{u, v} q
  let m := fun label : Labels n c =>
    (originalNativeSummandFunctor n (Coefficient n) label.val).map f
  have hLabel (label : Labels n c) : IsIso ((integerStablePiFunctor q).map (m label)) :=
    (NatIso.isIso_map_iff (summandIntegerNatIso n q label.val) f).mpr hq
  have hComm (label : Labels n c) : IsIso (U.map (m label)) := by
    let _ : IsIso ((forget₂ CommGrpCat GrpCat).map (U.map (m label))) := hLabel label
    exact isIso_of_reflects_iso (U.map (m label)) (forget₂ CommGrpCat GrpCat)
  let _ : ∀ label : Labels n c, IsIso (U.map (m label)) := hComm
  let eY := finiteIntegerCoproductIso q (Family n (Coefficient n) Y c)
  let eZ := finiteIntegerCoproductIso q (Family n (Coefficient n) Z c)
  let eM := Limits.Sigma.mapIso (fun label : Labels n c => asIso (U.map (m label)))
  let e := eY ≪≫ eM ≪≫ eZ.symm
  have hM : eM.hom = Limits.Sigma.map (fun label : Labels n c => U.map (m label)) := rfl
  have hNat := finiteIntegerCoproductIso_hom_naturality q m
  have hHom : e.hom = U.map ((coefficientMap n (Coefficient n) f).app c) := by
    apply (cancel_mono eZ.hom).mp
    change (eY.hom ≫ eM.hom ≫ eZ.inv) ≫ eZ.hom =
      U.map ((coefficientMap n (Coefficient n) f).app c) ≫ eZ.hom
    rw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id, hM]
    exact hNat.symm
  let eG := (forget₂ CommGrpCat GrpCat).mapIso e
  have hG : eG.hom = (integerStablePiFunctor q).map
      ((coefficientMap n (Coefficient n) f).app c) := by
    change (forget₂ CommGrpCat GrpCat).map e.hom = _
    rw [hHom]
    rfl
  rw [← hG]
  exact eG.isIso_hom

/-- Both original changing-positive-degree group colimits give the same
caller comparison for the real growing finite orbit diagram. -/
private theorem originalRestriction_integer_isIso (n : ℕ) (q : ℤ)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z)
    (hq : IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map f)) :
    IsIso ((integerStablePiFunctor q).map
      ((originalFreeSmashRestrictionFunctor n (Coefficient n)).map f)) := by
  let P := integerStablePiFunctor.{u, v} q
  let FY := diagram n (Coefficient n) Y
  let FZ := diagram n (Coefficient n) Z
  let cY := cocone n (Coefficient n) Y
  let cZ := cocone n (Coefficient n) Z
  let hY := PointedCGWH.Spectra.OriginalSequentialClosedIntegerPi.comparisonIsColimit q
    cY (coconeIsColimit n (Coefficient n) Y)
    (fun _ _ h r => diagram_map_level_closed n (Coefficient n) Y h r)
  let hZ := PointedCGWH.Spectra.OriginalSequentialClosedIntegerPi.comparisonIsColimit q
    cZ (coconeIsColimit n (Coefficient n) Z)
    (fun _ _ h r => diagram_map_level_closed n (Coefficient n) Z h r)
  let α : FY ⋙ P ⟶ FZ ⋙ P := Functor.whiskerRight (coefficientMap n (Coefficient n) f) P
  let _ : ∀ c : ℕ, IsIso (α.app c) := fun c => finiteStage_integer_isIso n q f hq c
  let eNat : FY ⋙ P ≅ FZ ⋙ P := NatIso.ofComponents (fun c => asIso (α.app c))
    (fun h => α.naturality h)
  let e := IsColimit.coconePointsIsoOfNatIso hY hZ eNat
  let p := (originalFreeSmashRestrictionFunctor n (Coefficient n)).map f
  have hHom : P.map p = e.hom := by
    apply hY.hom_ext
    intro c
    have hLeg : P.map (stageLeg n (Coefficient n) Y c) ≫ P.map p =
        P.map ((coefficientMap n (Coefficient n) f).app c) ≫ P.map (stageLeg n (Coefficient n) Z c) :=
      (P.map_comp _ _).symm.trans
        ((P.congr_map (coefficientMap_leg n (Coefficient n) f c)).trans (P.map_comp _ _))
    have hIso := IsColimit.comp_coconePointsIsoOfNatIso_hom hY hZ eNat c
    exact hLeg.trans hIso.symm
  rw [hHom]
  exact e.isIso_hom

/-- Every integer homotopy map of the actual original native free-sphere
balanced smash is preserved on arbitrary original arrow endpoints. -/
private theorem originalFreeSphereSmash_integerPi_preserves (n : ℕ)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z)
    (hPi : ∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map f)) :
    ∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
      ((PointedCGWH.SymmetricSpectrum.freeSmash
        (CategoryTheory.Operad.SmallFinBijGroupoid.card n) (Coefficient n)).map f)) :=
  fun q => originalRestriction_integer_isIso n q f (hPi q)






end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.GrowingOrbitIntegerPi
