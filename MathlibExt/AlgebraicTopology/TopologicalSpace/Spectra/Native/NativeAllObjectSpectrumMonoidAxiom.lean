attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.EnrichedMapping.hasSmallLimits
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers

/-- The unchanged original coefficient-first balanced generator at an arbitrary card level. -/
private abbrev originalCoefficientFirstGenerator {n q : ℕ} (h : n ≤ q) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :=
  PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
    (Aut (card (q - n))) (Aut (card q)) (M ⊗ Y.X.functor.obj (card (q - n)))
    (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card (q - n)))
    (blockAutHom (card (q - n)) (card n) (card q)
      (cardBlockSumIso (Nat.sub_add_cancel h))) g

/-- The same original balanced generator before the original coefficient order Iso. -/
private abbrev originalCoefficientLastGenerator {n q : ℕ} (h : n ≤ q) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :=
  PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
    (Aut (card (q - n))) (Aut (card q)) (Y.X.functor.obj (card (q - n)) ⊗ M)
    (blockCoefficientAction Y.X (card (q - n)) M)
    (blockAutHom (card (q - n)) (card n) (card q)
      (cardBlockSumIso (Nat.sub_add_cancel h))) g

private theorem factor_precompose {C : Type uC} [Category.{vC} C]
    {A B D E : C} (l : A ⟶ B) (a : B ⟶ D) (d : D ⟶ E)
    (b : B ⟶ E) (h : a ≫ d = b) : l ≫ a ≫ d = l ≫ b :=
  congrArg (fun k => l ≫ k) h

private theorem factor_postcompose {C : Type uC} [Category.{vC} C]
    {A B D E : C} (l : A ⟶ B) (a : B ⟶ D) (k : A ⟶ E) (b : E ⟶ D)
    {F : C} (d : D ⟶ F) (h : l ≫ a = k ≫ b) :
    l ≫ a ≫ d = k ≫ b ≫ d :=
  ((Category.assoc l a d).symm).trans
    ((congrArg (fun f => f ≫ d) h).trans (Category.assoc k b d))

/-- Precomposition retains the exact original orbit inverse and original Day factor. -/
private theorem originalCardFactor_leg {n q : ℕ} (h : n ≤ q) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    originalCoefficientFirstGenerator h M Y g ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashCardOrbitIso h M Y).inv ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card q)).hom =
      originalCoefficientFirstGenerator h M Y g ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y).inv ≫
        (NativeCardLeg.originalNativeDayIso Y.X h M).inv :=
  factor_precompose (originalCoefficientFirstGenerator h M Y g) _ _ _
    (NativeCardLeg.freeSmashCardOrbitIso_inv_day_factor h M Y)

/-- The closed original coefficient inverse retains its actual inverse braid. -/
private theorem originalCardCoefficient_leg {n q : ℕ} (h : n ≤ q) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    originalCoefficientFirstGenerator h M Y g ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y).inv ≫
        (NativeCardLeg.originalNativeDayIso Y.X h M).inv =
      (β_ (Y.X.functor.obj (card (q - n))) M).inv ≫
        originalCoefficientLastGenerator h M Y g ≫ (NativeCardLeg.originalNativeDayIso Y.X h M).inv :=
  factor_postcompose (originalCoefficientFirstGenerator h M Y g) _ _
    (originalCoefficientLastGenerator h M Y g) _
    (NativeCardLeg.coefficientOrderIso_inv_generator h M Y g)

/-- The closed original Day inverse keeps the original normalized block decomposition. -/
private theorem originalCardGenerator_leg {n q : ℕ} (h : n ≤ q) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    (β_ (Y.X.functor.obj (card (q - n))) M).inv ≫
        originalCoefficientLastGenerator h M Y g ≫ (NativeCardLeg.originalNativeDayIso Y.X h M).inv =
      (β_ (Y.X.functor.obj (card (q - n))) M).inv ≫
        representedTensorGenerator Y.X (card n) (card q) M (originalCardBlock h g) :=
  congrArg (fun f => (β_ (Y.X.functor.obj (card (q - n))) M).inv ≫ f)
    (NativeCardLeg.originalNativeDayIso_inv_generator Y.X h M g)

/-- All three closed source factors compose at the same original card level and automorphism. -/
private theorem originalCardInverse_day_generator {n q : ℕ} (h : n ≤ q) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    originalCoefficientFirstGenerator h M Y g ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashCardOrbitIso h M Y).inv ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card q)).hom =
      (β_ (Y.X.functor.obj (card (q - n))) M).inv ≫
        representedTensorGenerator Y.X (card n) (card q) M (originalCardBlock h g) :=
  (originalCardFactor_leg h M Y g).trans
    ((originalCardCoefficient_leg h M Y g).trans (originalCardGenerator_leg h M Y g))

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
