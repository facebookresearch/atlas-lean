    rintro ⟨n, a⟩
    change GrpCat.FilteredColimits.G.mk F ⟨n, a⟩ = 1
    have ha : a = (1 : F.obj n) := (hF n).elim _ _
    exact (congrArg (fun t : F.obj n => GrpCat.FilteredColimits.G.mk F ⟨n, t⟩) ha).trans
      (GrpCat.FilteredColimits.colimit_one_eq F n).symm
  exact ⟨fun x y => (hOne x).trans (hOne y).symm⟩

