open scoped CGWH.limits







set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory MonoidalCategory Limits
open CategoryTheory.Operad.SmallFinBijGroupoid
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open PointedCGWH.Spectra.OriginalSequentialTailIntegerPi
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK.Actual.SymmetricIntegerHomotopy

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The original sphere coefficient, with the original input still inside the original scalar. -/
private abbrev originalSphereScalar (n : ℕ) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    PointedCGWH.SequentialSpectrum.{u, v} :=
  (EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj (card n))).obj
    (underlyingSequential.obj Y)

/-- The entire original input functor is restricted and then acted on by the original sphere scalar. -/
private abbrev originalSphereScalarFunctor (n : ℕ) :
    PointedCGWH.SymmetricSpectrum.{u, v} ⥤ PointedCGWH.SequentialSpectrum.{u, v} :=
  underlyingSequential ⋙
    EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj (card n))

/-- Every scalar level contains the untouched original symmetric input level. -/
private theorem originalSphereScalar_level (n r : ℕ) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (originalSphereScalar n Y).level r =
      PointedCGWH.sphereSequence.functor.obj (card n) ⊗ Y.X.functor.obj (card r) := rfl

/-- The full original scalar tail has the shifted original integer group for every integer and cutoff. -/
private def originalSphereScalarTailIntegerIso (q : ℤ) (n a : ℕ)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj
        (truncatedShift n a
          ((EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj (card n))).obj
            (underlyingSequential.obj Y))) ≅
      (integerStablePiFunctor (q + (n : ℤ))).obj
        ((EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj (card n))).obj
          (underlyingSequential.obj Y)) :=
  comparisonIso q n a (originalSphereScalar n Y)

/-- The scalar integer comparison is natural in every whole original input arrow. -/
private def originalSphereScalarTailIntegerNatIso (q : ℤ) (n a : ℕ) :
    originalSphereScalarFunctor.{u, v} n ⋙ truncatedShiftFunctor n a ⋙ integerStablePiFunctor q ≅
      originalSphereScalarFunctor n ⋙ integerStablePiFunctor (q + (n : ℤ)) :=
  Functor.isoWhiskerLeft (originalSphereScalarFunctor n) (comparisonNatIso q n a)

/-- Every original source stage, including all stages before the cutoff, retains its actual transition. -/
private theorem originalSphereScalarTailIntegerIso_hom_leg_all (q : ℤ) (n a : ℕ)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg q (truncatedShift n a (originalSphereScalar n Y)) r ≫
        (originalSphereScalarTailIntegerIso q n a Y).hom =
      ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a (originalSphereScalar n Y))).map
        (homOfLE (Nat.le_add_left r (sourceOffset q n a))) ≫
      (stageIso q n a (originalSphereScalar n Y) r).hom ≫
        integerStablePiLeg (q + (n : ℤ)) (originalSphereScalar n Y) (targetOffset q a + r) :=
  comparisonIso_hom_leg_all q n a (originalSphereScalar n Y) r

/-- Every original target stage retains its actual transition to the whole inverse scalar tail arrow. -/
private theorem originalSphereScalarTailIntegerIso_inv_leg_all (q : ℤ) (n a : ℕ)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg (q + (n : ℤ)) (originalSphereScalar n Y) r ≫
        (originalSphereScalarTailIntegerIso q n a Y).inv =
      ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj (originalSphereScalar n Y)).map
        (homOfLE (Nat.le_add_left r (targetOffset q a))) ≫
      (stageIso q n a (originalSphereScalar n Y) r).inv ≫
        integerStablePiLeg q (truncatedShift n a (originalSphereScalar n Y)) (sourceOffset q n a + r) :=
  comparisonIso_inv_leg_all q n a (originalSphereScalar n Y) r

/-- The forward square uses the original scalar of the complete original input arrow. -/
private theorem originalSphereScalarTailIntegerIso_hom_naturality (q : ℤ) (n a : ℕ)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    (integerStablePiFunctor q).map
        (truncatedShiftMap n a ((originalSphereScalarFunctor n).map f)) ≫
        (originalSphereScalarTailIntegerIso q n a Z).hom =
      (originalSphereScalarTailIntegerIso q n a Y).hom ≫
        (integerStablePiFunctor (q + (n : ℤ))).map ((originalSphereScalarFunctor n).map f) :=
  comparisonIso_hom_naturality q n a ((originalSphereScalarFunctor n).map f)

/-- The inverse square preserves the same complete original scalar input map. -/
private theorem originalSphereScalarTailIntegerIso_inv_naturality (q : ℤ) (n a : ℕ)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    (integerStablePiFunctor (q + (n : ℤ))).map ((originalSphereScalarFunctor n).map f) ≫
        (originalSphereScalarTailIntegerIso q n a Z).inv =
      (originalSphereScalarTailIntegerIso q n a Y).inv ≫
        (integerStablePiFunctor q).map
          (truncatedShiftMap n a ((originalSphereScalarFunctor n).map f)) :=
  comparisonIso_inv_naturality q n a ((originalSphereScalarFunctor n).map f)

/-- The whole original tail inclusion keeps the original scalar and the untouched input. -/
private def originalSphereScalarTailInclusion (n a : ℕ) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    truncatedShift n a (originalSphereScalar n Y) ⟶ truncatedShift n 0 (originalSphereScalar n Y) :=
  tailInclusion n a (originalSphereScalar n Y)

/-- The full scalar tail inclusion is natural in every original input spectrum. -/
private def originalSphereScalarTailInclusionNatTrans (n a : ℕ) :
    originalSphereScalarFunctor.{u, v} n ⋙ truncatedShiftFunctor n a ⟶
      originalSphereScalarFunctor n ⋙ truncatedShiftFunctor n 0 :=
  Functor.whiskerLeft (originalSphereScalarFunctor n) (tailInclusionNatTrans n a)

/-- Zero shift and zero cutoff give the same original scalar spectrum. -/
private theorem originalSphereScalarTail_zero (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    truncatedShift 0 0 (originalSphereScalar 0 Y) = originalSphereScalar 0 Y :=
  truncatedShift_zero_zero (originalSphereScalar 0 Y)

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

end

section

attribute [local instance] _root_.NAMS.genericSmallHasColimit _root_.NAMS.genericSmallHasCoproduct

attribute [local instance] _root_.NAMS.SymmetricUnit.originalUnitExtensions

attribute [local instance] _root_.NAMS.smallHasColimit _root_.NAMS.smallHasCoproduct

open scoped CGWH.limits




set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory Limits
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open PointedCGWH.Spectra.OriginalSequentialTailIntegerPi
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open GrpCat.FilteredColimits.OriginalNatTailGeometry
open CategoryTheory.NatTail (tailFunctor)

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The actual integer diagonal inclusion is invertible on the original cofinal tail. -/
private theorem tailInclusionIntegerTail_isIso (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    IsIso (Functor.whiskerLeft (tailFunctor (sourceOffset q n a))
      ((integerDiagonalDiagramFunctor q).map (tailInclusion n a X))) := by
  let t := Functor.whiskerLeft (tailFunctor (sourceOffset q n a))
    ((integerDiagonalDiagramFunctor q).map (tailInclusion n a X))
  let _ : ∀ r : ℕ, IsIso (t.app r) := fun r => by
    change IsIso ((PointedCGWH.piNPositiveFunctor
      (integerTailPositiveIndex q + (sourceOffset q n a + r))).map
      (PointedCGWH.SequentialSpectrum.levelMap (tailInclusion n a X)
        (integerTailLevel q + (sourceOffset q n a + r))))
    let _ := tailInclusion_levelMap_isIso n a X
      (integerTailLevel q + (sourceOffset q n a + r)) (sourceLevel_above q n a r)
    infer_instance
  exact NatIso.isIso_of_isIso_app t

/-- The whole original retained diagonal inclusion, with every original finite-index square. -/
private def tailInclusionIntegerTailIso (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    tailFunctor (sourceOffset q n a) ⋙
        (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X) ≅
      tailFunctor (sourceOffset q n a) ⋙
        (integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X) := by
  let t := Functor.whiskerLeft (tailFunctor (sourceOffset q n a))
    ((integerDiagonalDiagramFunctor q).map (tailInclusion n a X))
  let _ : IsIso t := tailInclusionIntegerTail_isIso q n a X
  exact asIso t

/-- The retained inverse level arrow is inverse to the actual original inclusion at that level. -/
private def tailInclusionRetainedLevelIso (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (truncatedShift n a X).level (sourceLevel q n a r) ≅
      (truncatedShift n 0 X).level (sourceLevel q n a r) := by
  let f := PointedCGWH.SequentialSpectrum.levelMap (tailInclusion n a X) (sourceLevel q n a r)
  let _ : IsIso f := tailInclusion_levelMap_isIso n a X _ (sourceLevel_above q n a r)
  exact asIso f

/-- Each whole forward diagonal component is the original positive group map of the actual inclusion. -/
private theorem tailInclusionIntegerTailIso_hom_app (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (tailInclusionIntegerTailIso q n a X).hom.app r =
      (PointedCGWH.piNPositiveFunctor (sourcePositiveIndex q n a r)).map
        (tailInclusionRetainedLevelIso q n a X r).hom := rfl

/-- Each inverse diagonal component is the original positive group map of the actual inverse level. -/
private theorem tailInclusionIntegerTailIso_inv_app (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (tailInclusionIntegerTailIso q n a X).inv.app r =
      (PointedCGWH.piNPositiveFunctor (sourcePositiveIndex q n a r)).map
        (tailInclusionRetainedLevelIso q n a X r).inv := by
  let P := PointedCGWH.piNPositiveFunctor (sourcePositiveIndex q n a r)
  let e := tailInclusionRetainedLevelIso q n a X r
  apply (cancel_mono (P.map e.hom)).mp
  have h₁ := congr_app (tailInclusionIntegerTailIso q n a X).inv_hom_id r
  have h₂ := (P.map_comp e.inv e.hom).symm.trans
    ((P.congr_map e.inv_hom_id).trans (P.map_id _))
  exact h₁.trans h₂.symm

private def tailGroupIso (D E : ℕ ⥤ GrpCat.{v}) (c : ℕ)
    (e : tailFunctor c ⋙ D ≅ tailFunctor c ⋙ E) :
    GrpCat.FilteredColimits.colimit D ≅ GrpCat.FilteredColimits.colimit E :=
  (tailComparisonIso D c).symm ≪≫ GrpCat.FilteredColimits.colimitFunctor.mapIso e ≪≫
    tailComparisonIso E c

private theorem tailGroupIso_inv_leg_all (D E : ℕ ⥤ GrpCat.{v}) (c : ℕ)
    (e : tailFunctor c ⋙ D ≅ tailFunctor c ⋙ E) (r : ℕ) :
    (GrpCat.FilteredColimits.colimitCocone E).ι.app r ≫ (tailGroupIso D E c e).inv =
      E.map (homOfLE (Nat.le_add_left r c)) ≫ e.inv.app r ≫
        (GrpCat.FilteredColimits.colimitCocone D).ι.app (c + r) := by
  let s := tailComparisonIso D c
  let t := tailComparisonIso E c
  let l := (GrpCat.FilteredColimits.colimitCocone E).ι.app r
  let m := GrpCat.FilteredColimits.colimitMap e.inv
  let f := E.map (homOfLE (Nat.le_add_left r c))
  let b := (GrpCat.FilteredColimits.colimitCocone (tailFunctor c ⋙ E)).ι.app r
  let d := (GrpCat.FilteredColimits.colimitCocone (tailFunctor c ⋙ D)).ι.app r
  have h₀ : l ≫ (tailGroupIso D E c e).inv = l ≫ (t.inv ≫ m ≫ s.hom) := rfl
  have h₁ := (Category.assoc l t.inv (m ≫ s.hom)).symm
  have h₂ := congrArg (fun g => g ≫ m ≫ s.hom) (tailComparisonIso_inv_ι_all E c r)
  have h₃ := Category.assoc f b (m ≫ s.hom)
  have h₄ := congrArg (fun g => f ≫ g) (Category.assoc b m s.hom).symm
  have h₅ := congrArg (fun g => f ≫ g ≫ s.hom) (GrpCat.FilteredColimits.colimitMap_ι e.inv r)
  have h₆ := congrArg (fun g => f ≫ g) (Category.assoc (e.inv.app r) d s.hom)
  have h₇ := congrArg (fun g => f ≫ e.inv.app r ≫ g) (tailComparisonIso_hom_ι D c r)
  exact h₀.trans (h₁.trans (h₂.trans (h₃.trans (h₄.trans (h₅.trans (h₆.trans h₇))))))

/-- Both integer arrows retain the actual original inclusion and the same cofinal group quotients. -/
private def tailInclusionIntegerIso (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (truncatedShift n a X) ≅
      (integerStablePiFunctor q).obj (truncatedShift n 0 X) := by
  let D := (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)
  let E := (integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X)
  exact tailGroupIso D E (sourceOffset q n a) (tailInclusionIntegerTailIso q n a X)

/-- The whole forward integer arrow is the literal original tail inclusion map. -/
private theorem tailInclusionIntegerIso_hom (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (tailInclusionIntegerIso q n a X).hom =
      (integerStablePiFunctor q).map (tailInclusion n a X) := by
  let D := (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)
  let E := (integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X)
  let f := (integerDiagonalDiagramFunctor q).map (tailInclusion n a X)
  let s := tailComparisonIso D (sourceOffset q n a)
  let t := tailComparisonIso E (sourceOffset q n a)
  change (s.inv ≫ GrpCat.FilteredColimits.colimitMap
    (Functor.whiskerLeft (tailFunctor (sourceOffset q n a)) f)) ≫ t.hom =
      GrpCat.FilteredColimits.colimitMap f
  have h₁ := Category.assoc s.inv
    (GrpCat.FilteredColimits.colimitMap
      (Functor.whiskerLeft (tailFunctor (sourceOffset q n a)) f)) t.hom
  have h₂ := congrArg (fun g => s.inv ≫ g) (tailComparisonIso_naturality (sourceOffset q n a) f)
  have h₃ := (Category.assoc s.inv s.hom (GrpCat.FilteredColimits.colimitMap f)).symm
  have h₄ := congrArg (fun g => g ≫ GrpCat.FilteredColimits.colimitMap f) s.inv_hom_id
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans (Category.id_comp _))))

/-- The inverse integer arrow keeps both original cofinal inverses and every original diagonal inverse. -/
private theorem tailInclusionIntegerIso_inv (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (tailInclusionIntegerIso q n a X).inv =
      (tailComparisonIso ((integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X))
        (sourceOffset q n a)).inv ≫
      GrpCat.FilteredColimits.colimitMap (tailInclusionIntegerTailIso q n a X).inv ≫
        (tailComparisonIso ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a X))
          (sourceOffset q n a)).hom := rfl

/-- Every original source stage keeps the actual positive group map of the complete original inclusion. -/
private theorem tailInclusionIntegerIso_hom_leg_all (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg q (truncatedShift n a X) r ≫ (tailInclusionIntegerIso q n a X).hom =
      (PointedCGWH.piNPositiveFunctor (integerTailPositiveIndex q + r)).map
        (PointedCGWH.SequentialSpectrum.levelMap (tailInclusion n a X) (integerTailLevel q + r)) ≫
          integerStablePiLeg q (truncatedShift n 0 X) r :=
  (congrArg (fun g => integerStablePiLeg q (truncatedShift n a X) r ≫ g)
    (tailInclusionIntegerIso_hom q n a X)).trans
      (integerStablePiLeg_naturality q (tailInclusion n a X) r)

/-- Every target stage retains the actual transition, inverse diagonal inclusion and original source leg. -/
private theorem tailInclusionIntegerIso_inv_leg_all (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg q (truncatedShift n 0 X) r ≫ (tailInclusionIntegerIso q n a X).inv =
      ((integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X)).map
        (homOfLE (Nat.le_add_left r (sourceOffset q n a))) ≫
      (tailInclusionIntegerTailIso q n a X).inv.app r ≫
        integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r) :=
  tailGroupIso_inv_leg_all
    ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a X))
    ((integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X))
    (sourceOffset q n a) (tailInclusionIntegerTailIso q n a X) r

/-- Every original tail inclusion passes every original integer pi test. -/
private theorem tailInclusionInteger_isIso (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    IsIso ((integerStablePiFunctor q).map (tailInclusion n a X)) :=
  (tailInclusionIntegerIso_hom q n a X) ▸ (tailInclusionIntegerIso q n a X).isIso_hom

/-- The whole original inclusion comparison is natural in the original scalar input. -/
private def originalSphereScalarTailInclusionIntegerNatIso (q : ℤ) (n a : ℕ) :
    originalSphereScalarFunctor.{u, v} n ⋙ truncatedShiftFunctor n a ⋙ integerStablePiFunctor q ≅
      originalSphereScalarFunctor n ⋙ truncatedShiftFunctor n 0 ⋙ integerStablePiFunctor q :=
  NatIso.ofComponents (fun Y => tailInclusionIntegerIso q n a (originalSphereScalar n Y))
    (fun f => by
      rw [tailInclusionIntegerIso_hom, tailInclusionIntegerIso_hom]
      change (integerStablePiFunctor q).map
          (truncatedShiftMap n a ((originalSphereScalarFunctor n).map f)) ≫
          (integerStablePiFunctor q).map (tailInclusion n a (originalSphereScalar n _)) =
        (integerStablePiFunctor q).map (tailInclusion n a (originalSphereScalar n _)) ≫
          (integerStablePiFunctor q).map
            (truncatedShiftMap n 0 ((originalSphereScalarFunctor n).map f))
      rw [← Functor.map_comp, ← Functor.map_comp]
      exact (integerStablePiFunctor q).congr_map
        (tailInclusion_naturality n a ((originalSphereScalarFunctor n).map f)))

/-- Every scalar inclusion component is the original integer functor on that actual inclusion. -/
private theorem originalSphereScalarTailInclusionIntegerNatIso_hom_app (q : ℤ) (n a : ℕ)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (originalSphereScalarTailInclusionIntegerNatIso q n a).hom.app Y =
      (integerStablePiFunctor q).map (originalSphereScalarTailInclusion n a Y) :=
  tailInclusionIntegerIso_hom q n a (originalSphereScalar n Y)


end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

end

section

attribute [local instance] _root_.NAMS.genericSmallHasColimit _root_.NAMS.genericSmallHasCoproduct

attribute [local instance] _root_.NAMS.SymmetricUnit.originalUnitExtensions

attribute [local instance] _root_.NAMS.smallHasColimit _root_.NAMS.smallHasCoproduct

open scoped CGWH.limits




set_option autoImplicit false
noncomputable section
universe u v uC vC

open CategoryTheory Limits
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open PointedCGWH.Spectra.OriginalSequentialTailIntegerPi
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open GrpCat.FilteredColimits.OriginalNatTailGeometry

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

private theorem cutoffSourceOffset (q : ℤ) (n a r : ℕ) :
    sourceOffset q n a + r = sourceOffset q n 0 + (a + r) := by
  dsimp only [sourceOffset]
  omega

private theorem cutoffTargetOffset (q : ℤ) (a r : ℕ) :
    targetOffset q 0 + (a + r) = targetOffset q a + r := by
  dsimp only [targetOffset]
  omega

private theorem cutoffSourceLevel (q : ℤ) (n a r : ℕ) :
    sourceLevel q n a r = sourceLevel q n 0 (a + r) :=
  congrArg (fun s => integerTailLevel q + s) (cutoffSourceOffset q n a r)

private theorem cutoffTargetLevel (q : ℤ) (n a r : ℕ) :
    targetLevel q n 0 (a + r) = targetLevel q n a r :=
  congrArg (fun s => integerTailLevel (q + (n : ℤ)) + s) (cutoffTargetOffset q a r)

private theorem groupCastIso_comp {k l m : ℕ} (h : k = l) (h' : l = m)
    {A B C : PointedCGWH.{u, v}} (e : A ≅ B) (e' : B ≅ C) :
    (groupCastIso k l h e).hom ≫ (groupCastIso l m h' e').hom =
      (groupCastIso k m (h.trans h') (e ≪≫ e')).hom := by
  cases h
  cases h'
  simp only [groupCastIso, Iso.trans_hom, Functor.mapIso_hom, eqToIso_refl,
    Iso.app_hom, Iso.refl_hom, NatTrans.id_app, Category.comp_id]
  exact ((PointedCGWH.piNPositiveFunctor k).map_comp e.hom e'.hom).symm

private theorem groupCastIso_eqToHom {k l : ℕ} (h : k = l)
    {A B : PointedCGWH.{u, v}} (h' : A = B) :
    (groupCastIso k l h (eqToIso h')).hom =
      eqToHom (congrArg₂ (fun j Z => (PointedCGWH.piNPositiveFunctor j).obj Z) h h') := by
  cases h
  cases h'
  simp only [groupCastIso, Iso.trans_hom, Functor.mapIso_hom, eqToIso_refl,
    Iso.app_hom, Iso.refl_hom, NatTrans.id_app, Category.comp_id, eqToHom_refl]
  exact (PointedCGWH.piNPositiveFunctor k).map_id A

private theorem diagonal_eqToHom (q : ℤ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    {i j : ℕ} (h : i = j) :
    eqToHom (congrArg ((integerDiagonalDiagramFunctor q).obj X).obj h) =
      (groupCastIso (integerTailPositiveIndex q + i) (integerTailPositiveIndex q + j)
        (congrArg (fun s => integerTailPositiveIndex q + s) h)
        (eqToIso (congrArg X.level (congrArg (fun s => integerTailLevel q + s) h)))).hom := by
  cases h
  exact (groupCastIso_eqToHom rfl rfl).symm

/-- The original inclusion and both actual degree casts compose to the existing retained level Iso. -/
private theorem cutoffLevelIsoSquare (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    tailInclusionRetainedLevelIso q n a X r ≪≫
      eqToIso (congrArg (truncatedShift n 0 X).level (cutoffSourceLevel q n a r)) ≪≫
      stageLevelIso q n 0 X (a + r) ≪≫
      eqToIso (congrArg X.level (cutoffTargetLevel q n a r)) =
      stageLevelIso q n a X r := by
  apply Iso.ext
  have hi : (tailInclusionRetainedLevelIso q n a X r).hom =
      PointedCGWH.SequentialSpectrum.levelMap (tailInclusion n a X) (sourceLevel q n a r) := rfl
  simp only [Iso.trans_hom]
  rw [hi, tailInclusion_levelMap,
    tailInclusionLevel_above n a X _ (sourceLevel_above q n a r)]
  simp only [stageLevelIso, levelIso, Iso.trans_hom, eqToIso.hom, eqToHom_trans]
  exact eqToHom_trans _ _

/-- The actual cutoff inclusion and original zero-cutoff comparison give the same complete group stage. -/
private theorem cutoffStageSquare (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((integerDiagonalDiagramFunctor q).map (tailInclusion n a X)).app (sourceOffset q n a + r) ≫
      eqToHom (congrArg ((integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X)).obj
        (cutoffSourceOffset q n a r)) ≫
      (stageIso q n 0 X (a + r)).hom ≫
      eqToHom (congrArg ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X).obj
        (cutoffTargetOffset q a r)) =
      (stageIso q n a X r).hom := by
  let I := tailInclusionRetainedLevelIso q n a X r
  let S := eqToIso (congrArg (truncatedShift n 0 X).level (cutoffSourceLevel q n a r))
  let Z := stageLevelIso q n 0 X (a + r)
  let T := eqToIso (congrArg X.level (cutoffTargetLevel q n a r))
  let k := sourcePositiveIndex q n a r
  let k' := sourcePositiveIndex q n 0 (a + r)
  let l' := targetPositiveIndex q n 0 (a + r)
  let l := targetPositiveIndex q n a r
  let hk : k = k' := congrArg (fun t => integerTailPositiveIndex q + t) (cutoffSourceOffset q n a r)
  let hl : l' = l := congrArg (fun t => integerTailPositiveIndex (q + (n : ℤ)) + t)
    (cutoffTargetOffset q a r)
  let hz : k' = l' := commonPositiveIndex q n 0 (a + r)
  let A := groupCastIso k k rfl I
  let B := groupCastIso k k' hk S
  let C := groupCastIso k' l' hz Z
  let D := groupCastIso l' l hl T
  have hi : ((integerDiagonalDiagramFunctor q).map (tailInclusion n a X)).app
      (sourceOffset q n a + r) = A.hom := (Category.comp_id _).symm
  have hs : eqToHom (congrArg ((integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X)).obj
      (cutoffSourceOffset q n a r)) = B.hom :=
    diagonal_eqToHom q (truncatedShift n 0 X) (cutoffSourceOffset q n a r)
  have ht : eqToHom (congrArg ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X).obj
      (cutoffTargetOffset q a r)) = D.hom :=
    diagonal_eqToHom (q + (n : ℤ)) X (cutoffTargetOffset q a r)
  have h₁ := congrArg₂ (fun f g => f ≫ g ≫ (stageIso q n 0 X (a + r)).hom ≫
    eqToHom (congrArg ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X).obj
      (cutoffTargetOffset q a r))) hi hs
  have h₂ := congrArg (fun f => A.hom ≫ B.hom ≫ C.hom ≫ f) ht
  have h₃ := (Category.assoc A.hom B.hom (C.hom ≫ D.hom)).symm
  have h₄ := (Category.assoc (A.hom ≫ B.hom) C.hom D.hom).symm
  have h₅ := congrArg (fun f => (f ≫ C.hom) ≫ D.hom) (groupCastIso_comp rfl hk I S)
  have h₆ := congrArg (fun f => f ≫ D.hom) (groupCastIso_comp (rfl.trans hk) hz (I ≪≫ S) Z)
  have h₇ := groupCastIso_comp ((rfl.trans hk).trans hz) hl ((I ≪≫ S) ≪≫ Z) T
  have h₈ := congrArg (fun e => (groupCastIso k l (((rfl.trans hk).trans hz).trans hl) e).hom)
    (cutoffLevelIsoSquare q n a X r)
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans (h₅.trans (h₆.trans (h₇.trans h₈))))))

private theorem transportedLegTriangle {C : Type uC} [Category.{vC} C]
    {A B B' T T' L M N : C}
    (la : A ⟶ L) (lb : B ⟶ M) (lc : B' ⟶ M) (ta : T' ⟶ N) (tb : T ⟶ N)
    (m : A ⟶ B) (cs : B ⟶ B') (ct : T ⟶ T') (f : L ⟶ M) (e : M ⟶ N)
    (g : L ⟶ N) (z : B' ⟶ T) (s : A ⟶ T')
    (hn : la ≫ f = m ≫ lb) (hs : cs ≫ lc = lb) (ht : ct ≫ ta = tb)
    (he : lc ≫ e = z ≫ tb) (hz : m ≫ cs ≫ z ≫ ct = s) (hg : la ≫ g = s ≫ ta) :
    la ≫ (f ≫ e) = la ≫ g := by
  have h₁ := (Category.assoc la f e).symm
  have h₂ := congrArg (fun a => a ≫ e) hn
  have h₃ := Category.assoc m lb e
  have h₄ := congrArg (fun a => m ≫ a ≫ e) hs.symm
  have h₅ := congrArg (fun a => m ≫ a) (Category.assoc cs lc e)
  have h₆ := congrArg (fun a => m ≫ cs ≫ a) he
  have h₇ := congrArg (fun a => m ≫ cs ≫ z ≫ a) ht.symm
  have h₈ := congrArg (fun a => m ≫ cs ≫ a) (Category.assoc z ct ta).symm
  have h₉ := congrArg (fun a => m ≫ a) (Category.assoc cs (z ≫ ct) ta).symm
  have h₁₀ := (Category.assoc m (cs ≫ z ≫ ct) ta).symm
  have h₁₁ := congrArg (fun a => a ≫ ta) hz
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans (h₅.trans (h₆.trans
    (h₇.trans (h₈.trans (h₉.trans (h₁₀.trans (h₁₁.trans hg.symm))))))))))

private theorem colimitLeg_transport (D : ℕ ⥤ GrpCat.{v}) {i j : ℕ} (h : i = j) :
    eqToHom (congrArg D.obj h) ≫ (GrpCat.FilteredColimits.colimitCocone D).ι.app j =
      (GrpCat.FilteredColimits.colimitCocone D).ι.app i := by
  cases h
  exact Category.id_comp _

/-- The whole actual inclusion respects the existing original integer shift comparison maps. -/
private theorem comparisonInclusionSquare (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).map (tailInclusion n a X) ≫ (comparisonIso q n 0 X).hom =
      (comparisonIso q n a X).hom := by
  let D := (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)
  let E := (integerDiagonalDiagramFunctor q).obj (truncatedShift n 0 X)
  let G := (integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X
  apply (tailCoconeIsColimit D (sourceOffset q n a)).hom_ext
  intro r
  let la := integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r)
  let lb := integerStablePiLeg q (truncatedShift n 0 X) (sourceOffset q n a + r)
  let lc := integerStablePiLeg q (truncatedShift n 0 X) (sourceOffset q n 0 + (a + r))
  let ta := integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r)
  let tb := integerStablePiLeg (q + (n : ℤ)) X (targetOffset q 0 + (a + r))
  let m := ((integerDiagonalDiagramFunctor q).map (tailInclusion n a X)).app (sourceOffset q n a + r)
  let cs := eqToHom (congrArg E.obj (cutoffSourceOffset q n a r))
  let ct := eqToHom (congrArg G.obj (cutoffTargetOffset q a r))
  let z := (stageIso q n 0 X (a + r)).hom
  let f := (integerStablePiFunctor q).map (tailInclusion n a X)
  let e := (comparisonIso q n 0 X).hom
  have hs : cs ≫ lc = lb := colimitLeg_transport E (cutoffSourceOffset q n a r)
  have ht : ct ≫ ta = tb := colimitLeg_transport G (cutoffTargetOffset q a r)
  exact transportedLegTriangle la lb lc ta tb m cs ct f e (comparisonIso q n a X).hom
    z (stageIso q n a X r).hom
    (integerStablePiLeg_naturality q (tailInclusion n a X) (sourceOffset q n a + r))
    hs ht (comparisonIso_hom_leg q n 0 X (a + r))
    (cutoffStageSquare q n a X r) (comparisonIso_hom_leg q n a X r)

private theorem factorThroughComparison {C : Type uC} [Category.{vC} C] {A B D : C}
    (e : A ≅ D) (e' : B ≅ D) (f : A ⟶ B) (h : f ≫ e'.hom = e.hom) :
    f = e.hom ≫ e'.inv := by
  apply (cancel_mono e'.hom).mp
  have h₁ := Category.assoc e.hom e'.inv e'.hom
  have h₂ := congrArg (fun g => e.hom ≫ g) e'.inv_hom_id
  exact h.trans (h₁.trans (h₂.trans (Category.comp_id _))).symm

/-- The whole actual inclusion hom is exactly the existing original pair of integer comparison arrows. -/
private theorem tailInclusionIntegerIso_hom_comparison (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (tailInclusionIntegerIso q n a X).hom =
      (comparisonIso q n a X).hom ≫ (comparisonIso q n 0 X).inv :=
  (tailInclusionIntegerIso_hom q n a X).trans
    (factorThroughComparison (comparisonIso q n a X) (comparisonIso q n 0 X)
      ((integerStablePiFunctor q).map (tailInclusion n a X)) (comparisonInclusionSquare q n a X))

/-- Both whole actual inclusion arrows are the existing original comparison Iso and zero-tail inverse. -/
private theorem tailInclusionIntegerIso_eq_comparison (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    tailInclusionIntegerIso q n a X = comparisonIso q n a X ≪≫ (comparisonIso q n 0 X).symm :=
  Iso.ext (tailInclusionIntegerIso_hom_comparison q n a X)

/-- The actual inverse inclusion uses the same original zero-tail hom and original shifted-tail inverse. -/
private theorem tailInclusionIntegerIso_inv_comparison (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (tailInclusionIntegerIso q n a X).inv =
      (comparisonIso q n 0 X).hom ≫ (comparisonIso q n a X).inv :=
  congrArg (fun e => e.inv) (tailInclusionIntegerIso_eq_comparison q n a X)

/-- The entire original sphere-scalar inclusion family equals the existing original comparison family. -/
private theorem originalSphereScalarTailInclusionIntegerNatIso_eq_comparison (q : ℤ) (n a : ℕ) :
    originalSphereScalarTailInclusionIntegerNatIso.{u, v} q n a =
      originalSphereScalarTailIntegerNatIso q n a ≪≫
        (originalSphereScalarTailIntegerNatIso q n 0).symm := by
  apply Iso.ext
  apply NatTrans.ext
  funext Y
  exact tailInclusionIntegerIso_hom_comparison q n a (originalSphereScalar n Y)


end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

