/-- The same represented original time map retains either physical endpoint. -/
private theorem rotation_endpoint (T : C) (J : C ⥤ C) (q : Fin 2 → (𝟙_ C ⟶ T))
    (j : Fin 2 → (𝟭 C ⟶ J))
    (D : BalancedTimeRepresentation.Data T J q (fun i X => (j i).app X))
    (i : Fin 2) (Q Z : C) (H : J.obj Q ⟶ Z) (f : Q ⟶ Z)
    (h : (j i).app Q ≫ H = f) :
    coefficientPoint (q i) Q ≫ (D.comparison.hom.app Q ≫ H) = f := by
  rw [← Category.assoc, D.endpoint i Q, h]

/-- Both original sphere faces give a physical left homotopy after the same balanced first action. -/
private def homotopy (T : C) (J : C ⥤ C) (q : Fin 2 → (𝟙_ C ⟶ T))
    (j : Fin 2 → (𝟭 C ⟶ J)) (π : J ⟶ 𝟭 C)
    (D : BalancedTimeRepresentation.Data T J q (fun i X => (j i).app X))
    (h₀ : j 0 ≫ π = 𝟙 (𝟭 C)) (h₁ : j 1 ≫ π = 𝟙 (𝟭 C))
    (A Q Z Y : C) (hπ : WeakEquivalence (π.app A))
    (g : A ⟶ Q ⊗ Y) (H : J.obj Q ⟶ Z) (f₀ f₁ : Q ⟶ Z)
    (e₀ : (j 0).app Q ≫ H = f₀) (e₁ : (j 1).app Q ≫ H = f₁) :
    (BalancedNatCylinder.cylinder T J q j π D h₀ h₁ A hπ).LeftHomotopy
      (g ≫ f₀ ▷ Y) (g ≫ f₁ ▷ Y) where
  h := BalancedCylinderFirstAction.action T A Q Z Y g (D.comparison.hom.app Q ≫ H)
  h₀ := by
    change coefficientPoint (q 0) A ≫
      BalancedCylinderFirstAction.action T A Q Z Y g (D.comparison.hom.app Q ≫ H) = _
    rw [BalancedCylinderFirstAction.endpoint, rotation_endpoint T J q j D 0 Q Z H f₀ e₀]
  h₁ := by
    change coefficientPoint (q 1) A ≫
      BalancedCylinderFirstAction.action T A Q Z Y g (D.comparison.hom.app Q ≫ H) = _
    rw [BalancedCylinderFirstAction.endpoint, rotation_endpoint T J q j D 1 Q Z H f₁ e₁]

/-- The physical first action equates the same two full original composites in level Ho. -/
private theorem equation (T : C) (J : C ⥤ C) (q : Fin 2 → (𝟙_ C ⟶ T))
    (j : Fin 2 → (𝟭 C ⟶ J)) (π : J ⟶ 𝟭 C)
    (D : BalancedTimeRepresentation.Data T J q (fun i X => (j i).app X))
    (h₀ : j 0 ≫ π = 𝟙 (𝟭 C)) (h₁ : j 1 ≫ π = 𝟙 (𝟭 C))
    (A Q Z Y : C) (hπ : WeakEquivalence (π.app A))
    (g : A ⟶ Q ⊗ Y) (H : J.obj Q ⟶ Z) (f₀ f₁ : Q ⟶ Z)
    (e₀ : (j 0).app Q ≫ H = f₀) (e₁ : (j 1).app Q ≫ H = f₁) :
    (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (g ≫ f₀ ▷ Y) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (g ≫ f₁ ▷ Y) :=
  (homotopy T J q j π D h₀ h₁ A Q Z Y hπ g H f₀ f₁ e₀ e₁).leftHomotopyRel
    |>.factorsThroughLocalization.map_eq (_root_.HomotopicalAlgebra.toHomotopyCategory C)





end HomotopicalAlgebra.BalancedOriginalFirstHomotopy

