private theorem pre_naturality {Z : Type*} [Category Z] [MonoidalCategory Z]
    {L X X' Y Y' : Z} (K : Z) (l : L ⟶ X) (d : X ⟶ Y) (t : K ⊗ Y ⟶ Y')
    (s : K ⊗ X ⟶ X') (d' : X' ⟶ Y') (h : (K ◁ d) ≫ t = s ≫ d') :
    ((K ◁ l) ≫ s) ≫ d' = (K ◁ (l ≫ d)) ≫ t := by
  have h₁ := Category.assoc (K ◁ l) s d'
  have h₂ := congrArg (fun f => (K ◁ l) ≫ f) h.symm
  have h₃ := (Category.assoc (K ◁ l) (K ◁ d) t).symm
  have h₄ := congrArg (fun f => f ≫ t) (whiskerLeft_comp K l d).symm
  exact h₁.trans (h₂.trans (h₃.trans h₄))

private theorem transport_structure {Z : Type*} [Category Z] [MonoidalCategory Z]
    {L L' X X' X'' Y Y' Y'' : Z} (K : Z)
    (l : L ⟶ X) (l' : L' ⟶ X'') (s : K ⊗ X ⟶ X') (k : X' ⟶ X'')
    (d : X ⟶ Y) (d' : X' ⟶ Y') (e : X'' ≅ Y'')
    (t : K ⊗ Y ⟶ Y') (k' : Y' ⟶ Y'') (a : K ⊗ L ⟶ L') (b : L ⟶ Y) (b' : L' ⟶ Y'')
    (hnat : (K ◁ d) ≫ t = s ≫ d') (hcast : k ≫ e.hom = d' ≫ k')
    (hold : l ≫ d = b) (hnew : l' ≫ e.hom = b') (hday : (K ◁ b) ≫ t ≫ k' = a ≫ b') :
    (K ◁ l) ≫ s ≫ k = a ≫ l' := by
  have hn := pre_naturality K l d t s d' hnat
  have h₁ := congrArg (fun f => ((K ◁ l) ≫ s) ≫ f) hcast
  have h₂ := congrArg (fun f => f ≫ k') hn
  have h₃ := congrArg (fun f => (K ◁ f) ≫ t ≫ k') hold
  have h₄ := congrArg (fun f => a ≫ f) hnew.symm
  simp only [Category.assoc] at h₁ h₂
  have h := h₁.trans (h₂.trans (h₃.trans (hday.trans h₄)))
  apply (cancel_mono e.hom).mp
  exact (Category.assoc (K ◁ l) (s ≫ k) e.hom).trans
    ((congrArg (fun f => (K ◁ l) ≫ f) (Category.assoc s k e.hom)).trans
      (h.trans (Category.assoc a l' e.hom).symm))

attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers
  CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  MonoidalClosed.enrichedCategorySelf

/-- Every actual native finite orbit leg commutes with the original successor, scalar word,
and growing orbit representative, with the original index cast retained. -/
private theorem nativeFiniteOrbitStructure (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : OrbitTailHelper.FiniteStructureSquare n M Y := by
  intro c i
  let S := OrbitTailHelper.originalFreeSmashRestriction n M Y
  let R := originalRightTensorRestriction (card n) M Y
  let l := OrbitTailHelper.finiteNativeLeg c n M Y i
  let l' := OrbitTailHelper.finiteNativeLeg (c + 1) n M Y (growOrbit c n i)
  let d := (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n))).hom
  let d' := (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n + 1))).hom
  let d'' := (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card ((c + 1) + n))).hom
  let s := S.structureMap (c + n)
  let t := R.structureMap (c + n)
  let hdeg : c + n + 1 = (c + 1) + n := by omega
  let k := eqToHom (congrArg S.level hdeg)
  let k' := eqToHom (congrArg R.level hdeg)
  let a := (OrbitTailHelper.scalarRestriction M Y).structureMap c
  let b := OrbitTailHelper.coefficientFirstDayLeg n M Y c (OrbitTailHelper.originalOrbitBlockIso c n i)
  let b' := OrbitTailHelper.coefficientFirstDayLeg n M Y (c + 1)
    (OrbitTailHelper.originalOrbitBlockIso (c + 1) n (growOrbit c n i))
  have hnat : (PointedCGWH.sphereOne ◁ d) ≫ t = s ≫ d' :=
    originalDayStructureSquare (card n) M Y (c + n)
  have hcast : k ≫ d'' = d' ≫ k' := originalDayMap_cast n _ _ M Y hdeg
  have hold : l ≫ d = b := OrbitTailHelper.finiteNativeLeg_day c n M Y i
  have hnew : l' ≫ d'' = b' := OrbitTailHelper.finiteNativeLeg_day (c + 1) n M Y (growOrbit c n i)
  have hday : (PointedCGWH.sphereOne ◁ b) ≫ t ≫ k' = a ≫ b' := originalFiniteDayStructure c n M Y i
  change (PointedCGWH.sphereOne ◁ l) ≫ s ≫ k = a ≫ l'
  exact transport_structure PointedCGWH.sphereOne l l' s k d d'
    (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card ((c + 1) + n))) t k' a b b'
    hnat hcast hold hnew hday

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3
