set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory MonoidalCategory Limits
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open CategoryTheory.SequentialSpectrum.EnrichedPresentation
open PointedCGWH.Spectra.OriginalSequentialTailIntegerPi

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The original active-stage legs, with the actual source and target levels fixed. -/
private abbrev ShiftedTailLegFamily (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v}) :=
  ∀ c : ℕ, a ≤ c → (X.level c ⟶ W.level (c + n))

/-- Original successor compatibility of active native legs at the same shifted stages. -/
private def ShiftedTailLegSquare (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v})
    (l : ShiftedTailLegFamily n a X W) : Prop :=
  ∀ (c : ℕ) (hc : a ≤ c),
    (PointedCGWH.sphereOne ◁ l c hc) ≫ W.structureMap (c + n) ≫
      eqToHom (congrArg W.level (show c + n + 1 = (c + 1) + n by omega)) =
    X.structureMap c ≫ l (c + 1) (by omega)

/-- The complete shifted source component retains its original input leg and both level casts. -/
private def shiftedTailLegLevel (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v})
    (l : ShiftedTailLegFamily n a X W) (r : ℕ) : truncatedLevel n a X r ⟶ W.level r := by
  by_cases h : n + a ≤ r
  · exact eqToHom (truncatedLevel_above n a X r h) ≫ l (r - n) (by omega) ≫
      eqToHom (congrArg W.level (show r - n + n = r by omega))
  · exact eqToHom (truncatedLevel_below n a X r (Nat.lt_of_not_ge h)) ≫ initial.to (W.level r)

@[reassoc]
private theorem shiftedLeg_cast (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v})
    (l : ShiftedTailLegFamily n a X W) {c d : ℕ} (h : c = d) (hc : a ≤ c) (hd : a ≤ d) :
    eqToHom (congrArg X.level h) ≫ l d hd =
      l c hc ≫ eqToHom (congrArg W.level (congrArg (fun c => c + n) h)) := by
  cases h
  simp only [eqToHom_refl, Category.id_comp, Category.comp_id]

private theorem shiftedTailLeg_naturality (n a : ℕ)
    (X W : PointedCGWH.SequentialSpectrum.{u, v}) (l : ShiftedTailLegFamily n a X W)
    (hl : ShiftedTailLegSquare n a X W l) (r : ℕ) :
    (PointedCGWH.sphereOne ◁ shiftedTailLegLevel n a X W l r) ≫ W.structureMap r =
      truncatedStructureMap n a X r ≫ shiftedTailLegLevel n a X W l (r + 1) := by
  by_cases h : n + a ≤ r
  · have h' : n + a ≤ r + 1 := by omega
    have hc : a ≤ r - n := by omega
    have hd : a ≤ r + 1 - n := by omega
    have hcn : r - n + n = r := by omega
    have hdg : r - n + 1 = r + 1 - n := by omega
    apply (cancel_epi (eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
      (truncatedLevel_above n a X r h).symm))).mp
    apply (cancel_mono (eqToHom (congrArg W.level
      (show r + 1 = (r - n + 1) + n by omega)))).mp
    simp only [shiftedTailLegLevel, truncatedStructureMap, dite_eq_left h, dite_eq_left h',
      whiskerLeft_comp, whiskerLeft_eqToHom, Category.assoc, eqToHom_trans_assoc,
      eqToHom_trans, eqToHom_refl, Category.id_comp]
    rw [← eqToHom_naturality_assoc (fun c => W.structureMap c) hcn]
    simp only [eqToHom_trans]
    rw [shiftedLeg_cast_assoc n a X W l hdg (by omega) hd]
    simp only [eqToHom_trans, eqToHom_refl, Category.comp_id]
    exact hl (r - n) hc
  · have hInitial : IsInitial (PointedCGWH.sphereOne ⊗ truncatedLevel n a X r) := by
      rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
      exact MonoidalCategory.tensorInitialLeft _
    exact hInitial.hom_ext _ _

/-- The original shifted-stage legs form an actual morphism of left spectra. -/
private def rawShiftedTailLegMap (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v})
    (l : ShiftedTailLegFamily n a X W) (hl : ShiftedTailLegSquare n a X W l) :
    rawTruncatedShift n a X ⟶ fromEnrichedFunctor PointedCGWH.sphereOne W where
  levelMap := shiftedTailLegLevel n a X W l
  naturality := shiftedTailLeg_naturality n a X W l hl

/-- The whole native arrow retains all original Hom weights and the exact original target. -/
private def shiftedTailLegMap (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v})
    (l : ShiftedTailLegFamily n a X W) (hl : ShiftedTailLegSquare n a X W l) :
    truncatedShift n a X ⟶ W :=
  toEnrichedFunctorMap PointedCGWH.sphereOne (rawShiftedTailLegMap n a X W l hl) ≫
    (enrichedCounitIsoApp PointedCGWH.sphereOne W).hom

/-- Every whole enriched component is the original shifted leg with its exact degree casts. -/
private theorem shiftedTailLegMap_levelMap (n a : ℕ) (X W : PointedCGWH.SequentialSpectrum.{u, v})
    (l : ShiftedTailLegFamily n a X W) (hl : ShiftedTailLegSquare n a X W l) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (shiftedTailLegMap n a X W l hl) r =
      shiftedTailLegLevel n a X W l r := by
  let i := CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r
  let f := toEnrichedFunctorMap PointedCGWH.sphereOne (rawShiftedTailLegMap n a X W l hl)
  let g := (enrichedCounitIsoApp PointedCGWH.sphereOne W).hom
  have h := EnrichedFunctorCat.component_comp f g i
  have hf := toEnrichedFunctorMap_component PointedCGWH.sphereOne
    (rawShiftedTailLegMap n a X W l hl) i
  have hg := enrichedCounitIsoApp_hom_component PointedCGWH.sphereOne W r
  have h' := congrArg₂ (fun a b => a ≫ b) hf hg
  exact h.trans (h'.trans (Category.comp_id _))

/-- Every active leg commutes with the actual input arrows at both original levels. -/
private def ShiftedTailInputSquare (n a : ℕ) {X X' W W' : PointedCGWH.SequentialSpectrum.{u, v}}
    (l : ShiftedTailLegFamily n a X W) (l' : ShiftedTailLegFamily n a X' W')
    (f : X ⟶ X') (g : W ⟶ W') : Prop :=
  ∀ (c : ℕ) (hc : a ≤ c), l c hc ≫ PointedCGWH.SequentialSpectrum.levelMap g (c + n) =
    PointedCGWH.SequentialSpectrum.levelMap f c ≫ l' c hc

private theorem shiftedTailLeg_input (n a : ℕ)
    {X X' W W' : PointedCGWH.SequentialSpectrum.{u, v}}
    (l : ShiftedTailLegFamily n a X W) (l' : ShiftedTailLegFamily n a X' W')
    (f : X ⟶ X') (g : W ⟶ W') (hl : ShiftedTailInputSquare n a l l' f g) (r : ℕ) :
    truncatedLevelMap n a f r ≫ shiftedTailLegLevel n a X' W' l' r =
      shiftedTailLegLevel n a X W l r ≫ PointedCGWH.SequentialSpectrum.levelMap g r := by
  by_cases h : n + a ≤ r
  · have hc : a ≤ r - n := by omega
    have hcn : r - n + n = r := by omega
    apply (cancel_epi (eqToHom (truncatedLevel_above n a X r h).symm)).mp
    apply (cancel_mono (eqToHom (congrArg W'.level hcn.symm))).mp
    simp only [truncatedLevelMap, shiftedTailLegLevel, dite_eq_left h,
      Category.assoc, eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl,
      Category.id_comp, Category.comp_id]
    rw [← eqToHom_naturality_assoc (fun c => PointedCGWH.SequentialSpectrum.levelMap g c) hcn]
    simp only [eqToHom_trans, eqToHom_refl, Category.comp_id]
    exact (hl (r - n) hc).symm
  · have hInitial : IsInitial (truncatedLevel n a X r) := by
      rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
      exact initialIsInitial
    exact hInitial.hom_ext _ _

/-- The whole enriched shifted-leg map is natural in both unchanged original input spectra. -/
private theorem shiftedTailLegMap_naturality (n a : ℕ)
    {X X' W W' : PointedCGWH.SequentialSpectrum.{u, v}}
    (l : ShiftedTailLegFamily n a X W) (l' : ShiftedTailLegFamily n a X' W')
    (hl : ShiftedTailLegSquare n a X W l) (hl' : ShiftedTailLegSquare n a X' W' l')
    (f : X ⟶ X') (g : W ⟶ W') (hfg : ShiftedTailInputSquare n a l l' f g) :
    truncatedShiftMap n a f ≫ shiftedTailLegMap n a X' W' l' hl' =
      shiftedTailLegMap n a X W l hl ≫ g := by
  apply PointedCGWH.SequentialSpectrum.hom_ext
  intro r
  let fTail := truncatedShiftMap n a f
  let b := shiftedTailLegMap n a X' W' l' hl'
  let c := shiftedTailLegMap n a X W l hl
  have ha := truncatedShiftMap_levelMap n a f r
  have hb := shiftedTailLegMap_levelMap n a X' W' l' hl' r
  have hc := shiftedTailLegMap_levelMap n a X W l hl r
  have hL := (PointedCGWH.SequentialSpectrum.levelMap_comp fTail b r).trans
    (congrArg₂ (fun x y => x ≫ y) ha hb)
  have hR := (PointedCGWH.SequentialSpectrum.levelMap_comp c g r).trans
    (congrArg (fun x => x ≫ PointedCGWH.SequentialSpectrum.levelMap g r) hc)
  exact hL.trans ((shiftedTailLeg_input n a l l' f g hfg r).trans hR.symm)

/-- The actual active finite inverse legs form the original shifted tail family. -/
private def activeNativeLegFamily (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) :
    ShiftedTailLegFamily n (firstAppearance n γ) (scalarRestriction M Y)
      (originalFreeSmashRestriction n M Y) :=
  fun c hc => activeNativeLeg n M Y γ c hc

/-- Actual finite-cofan compatibility gives every successor square of this original stable label. -/
private theorem activeNativeLegFamily_square (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    ShiftedTailLegSquare n (firstAppearance n γ) (scalarRestriction M Y)
      (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y γ) := by
  intro c hc
  have h := hσ c (activeOrbit n γ c hc)
  have hg := activeOrbit_successor n γ c hc
  exact h.trans (congrArg (fun i => (scalarRestriction M Y).structureMap c ≫
    finiteNativeLeg (c + 1) n M Y i) hg)

/-- This whole enriched inclusion lands in the literal original restriction of the original free smash. -/
private def nativeSummandInclusion (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) : nativeSummand n M Y γ ⟶ originalFreeSmashRestriction n M Y :=
  (nativeSummandIso n M Y hσ γ).hom ≫
    shiftedTailLegMap n (firstAppearance n γ) (scalarRestriction M Y)
      (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y γ)
      (activeNativeLegFamily_square n M Y hσ γ)

/-- Every actual inclusion component has its original finite leg and complete level transport. -/
private theorem nativeSummandInclusion_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (nativeSummandInclusion n M Y hσ γ) r =
      shiftedTailLegLevel n (firstAppearance n γ) (scalarRestriction M Y)
        (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y γ) r := by
  let e := (nativeSummandIso n M Y hσ γ).hom
  let f := shiftedTailLegMap n (firstAppearance n γ) (scalarRestriction M Y)
    (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y γ)
    (activeNativeLegFamily_square n M Y hσ γ)
  have he := nativeSummandIso_hom_levelMap n M Y hσ γ r
  have hf := shiftedTailLegMap_levelMap n (firstAppearance n γ) (scalarRestriction M Y)
    (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y γ)
    (activeNativeLegFamily_square n M Y hσ γ) r
  have h := PointedCGWH.SequentialSpectrum.levelMap_comp e f r
  have h' := congrArg₂ (fun a b => a ≫ b) he hf
  exact h.trans (h'.trans (Category.id_comp _))

/-- Above first appearance this is exactly the original native balanced inverse leg and its casts. -/
private theorem nativeSummandInclusion_levelMap_above (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) (h : n + firstAppearance n γ ≤ r) :
    PointedCGWH.SequentialSpectrum.levelMap (nativeSummandInclusion n M Y hσ γ) r =
      eqToHom (nativeSummandLevel_above n M Y γ r h) ≫
        activeNativeLeg n M Y γ (r - n) (by omega) ≫
        eqToHom (congrArg (originalFreeSmashRestriction n M Y).level
          (show r - n + n = r by omega)) := by
  have hr := nativeSummandInclusion_levelMap n M Y hσ γ r
  simp only [shiftedTailLegLevel, dite_eq_left h] at hr
  exact hr

/-- The whole actual orbit inclusion commutes with every original enriched Hom action. -/
private theorem nativeSummandInclusion_action (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (i j : PointedCGWH.Spectra.Sequential.Index.{u, v}) :
    PointedCGWH.SequentialSpectrum.action (nativeSummand n M Y γ) i j ≫
      EnrichedFunctorCat.component (nativeSummandInclusion n M Y hσ γ) j =
    (EnrichedFunctorCat.component (nativeSummandInclusion n M Y hσ γ) i ⊗ₘ
      𝟙 (i ⟶[PointedCGWH.{u, v}] j)) ≫
      PointedCGWH.SequentialSpectrum.action (originalFreeSmashRestriction n M Y) i j :=
  PointedCGWH.SequentialSpectrum.action_naturality (nativeSummandInclusion n M Y hσ γ) i j

open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK.Actual.SymmetricIntegerHomotopy

/-- The same whole original free smash functor followed by its literal original restriction. -/
private abbrev originalFreeSmashRestrictionFunctor (n : ℕ) (M : PointedCGWH.{u, v}) :
    PointedCGWH.SymmetricSpectrum.{u, v} ⥤ PointedCGWH.SequentialSpectrum.{u, v} :=
  PointedCGWH.SymmetricSpectrum.freeSmash (CategoryTheory.Operad.SmallFinBijGroupoid.card n) M ⋙
    underlyingSequential

/-- The actual stable-label family commutes with the same original native input components. -/
private theorem activeNativeLegFamily_input (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (hf : FiniteInputSquare n M f)
    (γ : StableOrbitIndex n) :
    ShiftedTailInputSquare n (firstAppearance n γ) (activeNativeLegFamily n M Y γ)
      (activeNativeLegFamily n M Z γ)
      ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f))
      ((originalFreeSmashRestrictionFunctor n M).map f) := by
  intro c hc
  have h := hf c (activeOrbit n γ c hc)
  have hs := scalarRestriction_input M f c
  have h' := congrArg (fun g => g ≫ activeNativeLeg n M Z γ c hc) hs.symm
  exact h.trans h'

/-- The whole genuine orbit summand inclusion retains arbitrary whole original input arrows. -/
private theorem nativeSummandInclusion_naturality (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}}
    (hY : FiniteStructureSquare n M Y) (hZ : FiniteStructureSquare n M Z)
    (f : Y ⟶ Z) (hf : FiniteInputSquare n M f) (γ : StableOrbitIndex n) :
    nativeSummandMap n M hY hZ f hf γ ≫ nativeSummandInclusion n M Z hZ γ =
      nativeSummandInclusion n M Y hY γ ≫ (originalFreeSmashRestrictionFunctor n M).map f := by
  let eY := (nativeSummandIso n M Y hY γ).hom
  let eZ := (nativeSummandIso n M Z hZ γ).hom
  let jY := shiftedTailLegMap n (firstAppearance n γ) (scalarRestriction M Y)
    (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y γ)
    (activeNativeLegFamily_square n M Y hY γ)
  let jZ := shiftedTailLegMap n (firstAppearance n γ) (scalarRestriction M Z)
    (originalFreeSmashRestriction n M Z) (activeNativeLegFamily n M Z γ)
    (activeNativeLegFamily_square n M Z hZ γ)
  let m := nativeSummandMap n M hY hZ f hf γ
  let fX := (EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)
  let gW := (originalFreeSmashRestrictionFunctor n M).map f
  have he : m ≫ eZ = eY ≫ truncatedShiftMap n (firstAppearance n γ) fX :=
    nativeSummandIso_naturality n M hY hZ f hf γ
  have hj := shiftedTailLegMap_naturality n (firstAppearance n γ)
    (activeNativeLegFamily n M Y γ) (activeNativeLegFamily n M Z γ)
    (activeNativeLegFamily_square n M Y hY γ) (activeNativeLegFamily_square n M Z hZ γ)
    fX gW (activeNativeLegFamily_input n M f hf γ)
  have h1 := (Category.assoc m eZ jZ).symm
  have h2 := congrArg (fun a => a ≫ jZ) he
  have h3 := Category.assoc eY (truncatedShiftMap n (firstAppearance n γ) fX) jZ
  have h4 := congrArg (fun a => eY ≫ a) hj
  have h5 := (Category.assoc eY jY gW).symm
  exact h1.trans (h2.trans (h3.trans (h4.trans h5)))

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

end

