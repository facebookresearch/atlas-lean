/-- The original scalar unit commutes with the whole postcomposition identity comparison. -/
private theorem postUnit_square (S : V ⥤ (C ⥤ C)) (L : C ⥤ C) (u : V)
    (hS : S.obj u ≅ 𝟭 C) (eL : L ≅ 𝟭 C) :
