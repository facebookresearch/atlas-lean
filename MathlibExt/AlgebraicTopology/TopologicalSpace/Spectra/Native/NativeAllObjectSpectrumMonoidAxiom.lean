attribute [local instance] PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.symmetricCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalClosed
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The entire original right-factor coefficient arrow gives the actual
balanced-smash natural transformation before any left spectrum is selected. -/
private def originalSmashComparison {Y Z : C.{u, v}} (f : Y ⟶ Z) : tensorRight Y ⟶ tensorRight Z :=
  (tensoringRight C.{u, v}).map f

/-- The complete component is the literal original tensor action on the caller arrow. -/
private theorem originalSmashComparison_component {Y Z : C.{u, v}} (f : Y ⟶ Z) (X : C.{u, v}) :
    (originalSmashComparison f).app X = X ◁ f := rfl

private instance originalRightSmashPreservesColimits (Y : C.{u, v}) :
    PreservesColimitsOfSize.{w, w} (tensorRight Y) :=
  (rightSmashAdjunction Y).leftAdjoint_preservesColimits

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- All original free I-generator endpoint comparisons pass through every
actual symmetric relative I-cell history. The right factors remain arbitrary. -/
private theorem originalCellSmash_omegaTests_of_generatorEndpoints
    {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {A X : C.{u, v}} (i : A ⟶ X), NativeK.levelI i →
      NativeK.omegaTests Actual.symmetricFamily (A ◁ f) ∧
        NativeK.omegaTests Actual.symmetricFamily (X ◁ f))
    {J : Type w} [Small.{v} J] [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    {A X : C.{u, v}} {i : A ⟶ X}
    (c : RelativeCellComplex.{v}
      (fun (_ : J) => (NativeK.levelI (I := PointedCGWH.SymmetricOperatorIndex.{u, v})).homFamily) i)
    (hA : NativeK.omegaTests Actual.symmetricFamily (A ◁ f)) :
    NativeK.omegaTests Actual.symmetricFamily (X ◁ f) := by
  let _ := OriginalRelativeCellComparison.originalOmegaCoproducts.{u, v} (B := B)
  let α := originalSmashComparison f
  have hY : ∀ {A X : C.{u, v}} (j : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property j →
        PointedCGWH.EnrichedBasedHomotopyExtension.property ((tensorRight Y).map j) :=
    fun j hj => rightSmash_preserves_basedHEP j hj Y
  have hZ : ∀ {A X : C.{u, v}} (j : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property j →
        PointedCGWH.EnrichedBasedHomotopyExtension.property ((tensorRight Z).map j) :=
    fun j hj => rightSmash_preserves_basedHEP j hj Z
  exact PointedCGWH.Spectra.OriginalRelativeCellComparison.comparison_of_relativeICells
    Actual.symmetricFamily α hY hZ hEndpoints
    (OriginalRelativeCellComparison.comparison_of_pushout α hY hZ) c hA

/-- Both original initial I-cell source splits give the same whole smash
comparison Arrow retract. No replacement of either arbitrary right factor is made. -/
private def originalInitialSmashComparisonRetract (X : C.{u, v}) [IsCofibrant X]
    {Y Z : C.{u, v}} (f : Y ⟶ Z) :
    RetractArrow (X ◁ f) (initialCellObject X ◁ f) :=
  PointedCGWH.Spectra.OriginalRelativeCellComparison.comparisonRetract
    (originalSmashComparison f) (initialSourceRetract X)

/-- Original generator endpoint tests imply the actual all-cofibrant smash
comparison via the realized-cardinal initial I-cell object and its whole source retract. -/
private theorem originalCofibrantSmash_omegaTests_of_generatorEndpoints
    {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {A X : C.{u, v}} (i : A ⟶ X), NativeK.levelI i →
      NativeK.omegaTests Actual.symmetricFamily (A ◁ f) ∧
        NativeK.omegaTests Actual.symmetricFamily (X ◁ f))
    (X : C.{u, v}) [IsCofibrant X] : NativeK.omegaTests Actual.symmetricFamily (X ◁ f) := by
  let α := originalSmashComparison f
  have hZero : NativeK.omegaTests Actual.symmetricFamily (Diagrams.zeroDiagram ◁ f) := by
    let _ : IsIso (α.app Diagrams.zeroDiagram) :=
      isIso_of_isInitial (Diagrams.zeroDiagramIsInitial.isInitialObj (tensorRight Y))
        (Diagrams.zeroDiagramIsInitial.isInitialObj (tensorRight Z)) (α.app Diagrams.zeroDiagram)
    exact (NativeK.omegaTests Actual.symmetricFamily).of_isIso (α.app Diagrams.zeroDiagram)
  have hCells := originalCellSmash_omegaTests_of_generatorEndpoints f hEndpoints
    (initialCellComplex X) hZero
  exact MorphismProperty.of_retract (originalInitialSmashComparisonRetract X f) hCells

/-- Every arbitrary cofibrant based coefficient supplies both genuine I
generator endpoints; the actual cofibrant spectrum then inherits the same smash test. -/
private theorem originalCofibrantSmash_omegaTests_of_freeCoefficients
    {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hFree : ∀ (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
      (M : PointedCGWH.{u, v}) [IsCofibrant M],
      NativeK.omegaTests Actual.symmetricFamily (Free.object a M ◁ f))
    (X : C.{u, v}) [IsCofibrant X] : NativeK.omegaTests Actual.symmetricFamily (X ◁ f) :=
  originalCofibrantSmash_omegaTests_of_generatorEndpoints f
    (OriginalRelativeCellComparison.original_levelI_comparison_endpoints
      (originalSmashComparison f) hFree) X








end PointedCGWH.Spectra.Symmetric.OriginalSmashCellComparison
