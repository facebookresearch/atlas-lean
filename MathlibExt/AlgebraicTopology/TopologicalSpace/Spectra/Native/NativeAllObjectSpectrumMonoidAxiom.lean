namespace PointedCGWH.Spectra.OriginalFreeSmashPhysical

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

attribute [local instance] CanonicalSourceSmash.monoidalCategory
  CanonicalSourceSmash.symmetricCategory CanonicalSourceSmashClosed.monoidalClosed
  MonoidalClosed.enrichedCategorySelf PointedCGWH.EnrichedMapping.hasSmallLimits
  HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- The same original interval sections are equal in the original level Ho for a cofibrant
    source. -/
private theorem originalIntervalSections_ho_eq (D : Carrier.{u, v}) [IsCofibrant D] :
    (_root_.HomotopicalAlgebra.toHomotopyCategory Carrier.{u, v}).map
        (PointedCGWH.EnrichedIntervalCylinder.inclusion 0 D) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory Carrier.{u, v}).map
        (PointedCGWH.EnrichedIntervalCylinder.inclusion 1 D) := by
  let L := _root_.HomotopicalAlgebra.toHomotopyCategory Carrier.{u, v}
  let p := PointedCGWH.EnrichedIntervalCylinder.projection D
  have hp : weakEquivalences Carrier.{u, v} p :=
    (HomotopicalAlgebra.weakEquivalence_iff p).mp
      (PointedCGWH.EnrichedIntervalCylinderModel.projection_weakEquivalence D)
  let _ : IsIso (L.map p) :=
    (HomotopicalAlgebra.weakEquivalence_iff_isIso_toHomotopyCategory_map p).mp hp
  apply (cancel_mono (L.map p)).1
  rw [← L.map_comp, ← L.map_comp,
    PointedCGWH.EnrichedIntervalCylinder.inclusion_projection,
    PointedCGWH.EnrichedIntervalCylinder.inclusion_projection]

/-- The original mixed-source first action gives a genuine level-Ho equality with arbitrary Y. -/
private theorem originalFirstSourceAction_ho_eq
    (r : OrthogonalIndex) (M : PointedCGWH.{u, v}) (Y : Carrier.{u, v})
    {D Z : Carrier.{u, v}} [IsCofibrant D]
    (g : D ⟶ Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y)
    (f₀ f₁ : Free.object (OrthogonalOperatorIndex.ofIndex r) M ⟶ Z)
    (H : PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z)
    (h₀ : PointedCGWH.EnrichedIntervalCylinder.inclusion 0
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₀)
    (h₁ : PointedCGWH.EnrichedIntervalCylinder.inclusion 1
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₁) :
    (_root_.HomotopicalAlgebra.toHomotopyCategory Carrier.{u, v}).map (g ≫ f₀ ▷ Y) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory Carrier.{u, v}).map (g ≫ f₁ ▷ Y) := by
  let L := _root_.HomotopicalAlgebra.toHomotopyCategory Carrier.{u, v}
  let action := originalFirstSourceAction r M Y g H
  have hs := originalFirstSourceAction_two_endpointProperties r M Y g f₀ f₁ H h₀ h₁
  have h₀' := endpoint_equation 0 D (Z ⊗ Y) action (g ≫ f₀ ▷ Y) hs.1
  have h₁' := endpoint_equation 1 D (Z ⊗ Y) action (g ≫ f₁ ▷ Y) hs.2
  have hm₀ := congrArg L.map h₀'
  have hm₁ := congrArg L.map h₁'
  rw [L.map_comp] at hm₀ hm₁
  calc
    L.map (g ≫ f₀ ▷ Y) =
        L.map (PointedCGWH.EnrichedIntervalCylinder.inclusion 0 D) ≫ L.map action :=
      hm₀.symm
    _ = L.map (PointedCGWH.EnrichedIntervalCylinder.inclusion 1 D) ≫ L.map action := by
      rw [originalIntervalSections_ho_eq D]
    _ = L.map (g ≫ f₁ ▷ Y) := hm₁




end PointedCGWH.Spectra.OriginalFreeSmashPhysical

