/-- The same original scalar one-sphere preserves and reflects every
original Omega-target test, through the unrestricted orthogonal criterion. -/
private theorem originalScalarSphere_omegaTests_iff {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    W ((EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne.{u, v}).map f) ↔ W f :=
  (originalOmegaTests_iff_integerPiIsos (B := B) _).trans
    ((originalScalarSphere_integerPi_iff f).trans
      (originalOmegaTests_iff_integerPiIsos (B := B) f).symm)

/-- Every actual sphere power preserves and reflects the full original
Omega tests of an arbitrary native Arrow at the same caller bottom. -/
private theorem originalScalarSpherePower_omegaTests_iff (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    W ((EnrichedFunctorCat.tensorLeft
      (TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n)).map f) ↔ W f :=
  (originalOmegaTests_iff_integerPiIsos (B := B) _).trans
    ((originalScalarSpherePower_integerPi_iff n f).trans
      (originalOmegaTests_iff_integerPiIsos (B := B) f).symm)

/-- Every original representation sphere preserves and reflects all
original Omega tests, with neither spectrum endpoint restricted. -/
private theorem originalRepresentationSphere_omegaTests_iff (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    W ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f) ↔ W f :=
  (originalOmegaTests_iff_integerPiIsos (B := B) _).trans
    ((originalRepresentationSphere_integerPi_iff n f).trans
      (originalOmegaTests_iff_integerPiIsos (B := B) f).symm)

/-- The exact original stable weak class is preserved and reflected by
every actual scalar sphere power on arbitrary original arrow endpoints. -/
private theorem originalStableScalarSpherePower_weak_iff (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory Carrier.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
    weakEquivalences Carrier.{u, v}
      ((EnrichedFunctorCat.tensorLeft (TensorPower.tensorPowObj PointedCGWH.sphereOne n)).map f) ↔
      weakEquivalences Carrier.{u, v} f := by
  let _ : ModelCategory Carrier.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
  change weakEquivalences Carrier.{u, v} _ ↔ weakEquivalences Carrier.{u, v} f
  rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1]
  exact originalScalarSpherePower_omegaTests_iff n f

/-- The same literal original stable model gives reflection and
preservation for each of its actual representation-sphere scalar maps. -/
private theorem originalStableRepresentationSphere_weak_iff (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory Carrier.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
    weakEquivalences Carrier.{u, v}
      ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f) ↔
      weakEquivalences Carrier.{u, v} f := by
  let _ : ModelCategory Carrier.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
  change weakEquivalences Carrier.{u, v} _ ↔ weakEquivalences Carrier.{u, v} f
  rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1]
  exact originalRepresentationSphere_omegaTests_iff n f







