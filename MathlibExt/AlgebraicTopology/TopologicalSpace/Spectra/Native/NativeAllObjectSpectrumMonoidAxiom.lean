/-!
## Original acyclic-cofibration quotients for the native spectrum monoid axiom

The quotient is the actual pushout of the original spectrum arrow along its
original collapse to zero. The original whole-arrow Q counit compares its
chosen Q cofiber with the original I-cone cofiber. The original cone
contraction then compares that cofiber with every caller-selected quotient.
Both maps are level weak by the proved native level left properness, with
no cofibrancy condition on either endpoint of the original arrow.

The original Q-cofiber Omega sequence proves nullity of the same quotient.
The realized-generator cardinal, caller bottom, original cone and Q maps,
and both legs of every selected quotient remain in the statements.
-/

set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory CategoryTheory.Limits CategoryTheory.EnrichedFunctorCat
open HomotopicalAlgebra
open HomotopicalAlgebra.EnrichedProjective.Native
open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK
open scoped CGWH.modelCategory

namespace PointedCGWH.Spectra.CurrentCofiberQuotient

section OriginalQuotient

variable {I L : Type} [EnrichedCategory PointedCGWH.{u, v} I]
  [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

private abbrev D := EnrichedFunctorCat PointedCGWH.{u, v} I

local notation "Q" => Replacement.cofibrantReplacement (B := B) (A := I)
local notation "ε" => OriginalICone.replacementArrowCounit (B := B) (I := I)
local notation "C" => OriginalICone.cone (B := B) (I := I)
local notation "ι" => OriginalICone.inclusion (B := B) (I := I)
local notation "κ" => OriginalICone.contraction (B := B) (I := I)
local notation "c" => OriginalISuspension.cocone (B := B) (I := I)
local notation "hc" => OriginalISuspension.coconeIsColimit (B := B) (I := I)

omit B in
/-- The original arrow's actual quotient, with its unchanged source collapse. -/
def quotient (F : Arrow (D (I := I))) : D (I := I) :=
  pushout F.hom (Diagrams.toZero F.left)

omit B in
/-- The quotient's entire original target leg. -/
def quotientTarget (F : Arrow (D (I := I))) : F.right ⟶ quotient F :=
  pushout.inl F.hom (Diagrams.toZero F.left)

omit B in
/-- The quotient's entire original zero leg. -/
def quotientZero (F : Arrow (D (I := I))) : Diagrams.zeroDiagram ⟶ quotient F :=
  pushout.inr F.hom (Diagrams.toZero F.left)

omit B in
/-- Both quotient legs are the original pushout cocone, on the same input map. -/
private theorem quotient_isPushout (F : Arrow (D (I := I))) :
    IsPushout F.hom (Diagrams.toZero F.left) (quotientTarget F) (quotientZero F) :=
  IsPushout.of_hasPushout F.hom (Diagrams.toZero F.left)

/-- The actual chosen I-cone cofiber functor on the original whole arrow. -/
private def originalCofiber : Arrow (D (I := I)) ⥤ D (I := I) :=
  OrdinaryHoChosenPuppe.cofiberFunctor C ι c hc

/-- The actual original Q counit induces the whole Q-cofiber to I-cofiber map. -/
private def cofiberQCounit (F : Arrow (D (I := I))) :
    (c ((Q).mapArrow.obj F)).pt ⟶ (c F).pt :=
  (originalCofiber (B := B)).map ((ε).app F)

/-- Its cone leg is the original cone map of the original Q source counit. -/
@[reassoc]
private theorem cofiberQCounit_cone (F : Arrow (D (I := I))) :
    (c ((Q).mapArrow.obj F)).inl ≫ cofiberQCounit (B := B) F =
      (C).map (((ε).app F).left) ≫ (c F).inl :=
  OrdinaryHoChosenPuppe.cofiberMap_cone C ι c hc ((ε).app F)

/-- Its target leg is the original Q target counit followed by the original cofiber leg. -/
@[reassoc]
private theorem cofiberQCounit_target (F : Arrow (D (I := I))) :
    (c ((Q).mapArrow.obj F)).inr ≫ cofiberQCounit (B := B) F =
      ((ε).app F).right ≫ (c F).inr :=
  OrdinaryHoChosenPuppe.cofiberMap_target C ι c hc ((ε).app F)

/-- The cone contraction constructs the comparison to the caller's actual quotient. -/
private def cofiberQuotientComparison (F : Arrow (D (I := I)))
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    (c F).pt ⟶ Z :=
  PushoutCocone.IsColimit.desc (hc F) (((κ).app F.left) ≫ q0) qX (by
    rw [← Category.assoc, OriginalICone.inclusion_contraction]
    exact sq.w.symm)

/-- The comparison retains the entire original cone contraction and the caller's zero leg. -/
@[reassoc]
private theorem cofiberQuotientComparison_cone (F : Arrow (D (I := I)))
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    (c F).inl ≫ cofiberQuotientComparison (B := B) F qX q0 sq = (κ).app F.left ≫ q0 :=
  PushoutCocone.IsColimit.inl_desc (hc F) _ _ _

/-- The comparison retains exactly the caller's original target-to-quotient map. -/
@[reassoc]
private theorem cofiberQuotientComparison_target (F : Arrow (D (I := I)))
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    (c F).inr ≫ cofiberQuotientComparison (B := B) F qX q0 sq = qX :=
  PushoutCocone.IsColimit.inr_desc (hc F) _ _ _

/-- Every actual change of quotient cocone keeps the full comparison map. -/
@[reassoc]
private theorem cofiberQuotientComparison_choice (F : Arrow (D (I := I)))
    {Z Z' : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0)
    (qX' : F.right ⟶ Z') (q0' : Diagrams.zeroDiagram ⟶ Z')
    (sq' : IsPushout F.hom (Diagrams.toZero F.left) qX' q0')
    (a : Z ⟶ Z') (hX : qX ≫ a = qX') (h0 : q0 ≫ a = q0') :
    cofiberQuotientComparison (B := B) F qX q0 sq ≫ a =
      cofiberQuotientComparison (B := B) F qX' q0' sq' := by
  apply PushoutCocone.IsColimit.hom_ext (hc F)
  · rw [cofiberQuotientComparison_cone_assoc, h0, cofiberQuotientComparison_cone]
  · rw [cofiberQuotientComparison_target_assoc, hX, cofiberQuotientComparison_target]

/-- Every original cone map is level weak by the two original cone contractions. -/
private theorem coneMap_levelWeak {X Y : D (I := I)} (f : X ⟶ Y) :
    weakEquivalences (D (I := I)) ((C).map f) := by
  have hX := (OriginalICone.contraction_trivialFibration (B := B) X).2
  have hY := (OriginalICone.contraction_trivialFibration (B := B) Y).2
  have hFac : (C).map f ≫ (κ).app Y = (κ).app X :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  exact (weakEquivalences (D (I := I))).of_postcomp _ _ hY (hFac.symm ▸ hX)

/-- The original whole Q counit gives a level-weak cofiber comparison at arbitrary endpoints. -/
private theorem cofiberQCounit_levelWeak
    (hHom : ∀ a b : I, IsCofibrant (a ⟶[PointedCGWH.{u, v}] b))
    (F : Arrow (D (I := I))) :
    weakEquivalences (D (I := I)) (cofiberQCounit (B := B) F) := by
  let _ : IsLeftProper (D (I := I)) :=
    IndexCofibrantProperness.originalNativeLevelLeftProper (B := B) hHom
  let _ : Cofibration ((ι).app ((Q).mapArrow.obj F).left) :=
    (HomotopicalAlgebra.cofibration_iff _).mpr (OriginalICone.inclusion_cofibration _)
  let _ : Cofibration ((ι).app F.left) :=
    (HomotopicalAlgebra.cofibration_iff _).mpr (OriginalICone.inclusion_cofibration _)
  let _ : WeakEquivalence (((ε).app F).left) := (HomotopicalAlgebra.weakEquivalence_iff _).mpr
    (Replacement.cofibrantReplacementCounit_mem_weakEquivalences F.left)
  let _ : WeakEquivalence (((ε).app F).right) := (HomotopicalAlgebra.weakEquivalence_iff _).mpr
    (Replacement.cofibrantReplacementCounit_mem_weakEquivalences F.right)
  let _ : WeakEquivalence ((C).map (((ε).app F).left)) :=
    (HomotopicalAlgebra.weakEquivalence_iff _).mpr (coneMap_levelWeak (((ε).app F).left))
  exact (HomotopicalAlgebra.weakEquivalence_iff _).mp
    (IsLeftProper.weakEquivalence_map_of_isPushouts_of_fst
      (IsPushout.of_isColimit (hc ((Q).mapArrow.obj F))) (IsPushout.of_isColimit (hc F))
      (a := ((ε).app F).left) (b := (C).map (((ε).app F).left))
      («c» := ((ε).app F).right) (d := cofiberQCounit (B := B) F)
      ((ι).naturality (((ε).app F).left)).symm ((ε).app F).w.symm
      (cofiberQCounit_cone F) (cofiberQCounit_target F))

/-- The same original cofibration makes its I-cofiber-to-actual-quotient comparison level weak. -/
private theorem cofiberQuotientComparison_levelWeak
    (hHom : ∀ a b : I, IsCofibrant (a ⟶[PointedCGWH.{u, v}] b))
    (F : Arrow (D (I := I))) (hi : cofibrations (D (I := I)) F.hom)
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    weakEquivalences (D (I := I)) (cofiberQuotientComparison (B := B) F qX q0 sq) := by
  let _ : IsLeftProper (D (I := I)) :=
    IndexCofibrantProperness.originalNativeLevelLeftProper (B := B) hHom
  let _ : Cofibration F.hom := (HomotopicalAlgebra.cofibration_iff _).mpr hi
  let _ : WeakEquivalence ((κ).app F.left) :=
    (HomotopicalAlgebra.weakEquivalence_iff _).mpr (OriginalICone.contraction_trivialFibration F.left).2
  let _ : WeakEquivalence (𝟙 F.left) := (HomotopicalAlgebra.weakEquivalence_iff _).mpr
    ((weakEquivalences (D (I := I))).id_mem F.left)
  let _ : WeakEquivalence (𝟙 F.right) := (HomotopicalAlgebra.weakEquivalence_iff _).mpr
    ((weakEquivalences (D (I := I))).id_mem F.right)
  exact (HomotopicalAlgebra.weakEquivalence_iff _).mp
    (IsLeftProper.weakEquivalence_map_of_isPushouts_of_snd
      (IsPushout.of_isColimit (hc F)) sq.flip
      (a := 𝟙 F.left) (b := (κ).app F.left) («c» := 𝟙 F.right)
      (d := cofiberQuotientComparison (B := B) F qX q0 sq)
      ((OriginalICone.inclusion_contraction F.left).trans (Category.id_comp _).symm)
      ((Category.comp_id F.hom).trans (Category.id_comp F.hom).symm)
      (cofiberQuotientComparison_cone F qX q0 sq)
      ((cofiberQuotientComparison_target F qX q0 sq).trans (Category.id_comp qX).symm))

/-- The complete original Q-cofiber-to-caller-quotient comparison, using both genuine maps. -/
private def qCofiberQuotientComparison (F : Arrow (D (I := I)))
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    (c ((Q).mapArrow.obj F)).pt ⟶ Z :=
  cofiberQCounit (B := B) F ≫ cofiberQuotientComparison (B := B) F qX q0 sq

/-- The complete comparison retains the original Q source counit and both full cone maps. -/
@[reassoc]
private theorem qCofiberQuotientComparison_cone (F : Arrow (D (I := I)))
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    (c ((Q).mapArrow.obj F)).inl ≫ qCofiberQuotientComparison (B := B) F qX q0 sq =
      (C).map (((ε).app F).left) ≫ (κ).app F.left ≫ q0 := by
  rw [qCofiberQuotientComparison, cofiberQCounit_cone_assoc, cofiberQuotientComparison_cone]

/-- The complete comparison retains the actual Q target counit and original quotient target leg. -/
@[reassoc]
private theorem qCofiberQuotientComparison_target (F : Arrow (D (I := I)))
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    (c ((Q).mapArrow.obj F)).inr ≫ qCofiberQuotientComparison (B := B) F qX q0 sq =
      ((ε).app F).right ≫ qX := by
  rw [qCofiberQuotientComparison, cofiberQCounit_target_assoc, cofiberQuotientComparison_target]

/-- The complete comparison is genuinely level weak at the unchanged caller quotient. -/
private theorem qCofiberQuotientComparison_levelWeak
    (hHom : ∀ a b : I, IsCofibrant (a ⟶[PointedCGWH.{u, v}] b))
    (F : Arrow (D (I := I))) (hi : cofibrations (D (I := I)) F.hom)
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    weakEquivalences (D (I := I)) (qCofiberQuotientComparison (B := B) F qX q0 sq) :=
  (weakEquivalences (D (I := I))).comp_mem _ _ (cofiberQCounit_levelWeak hHom F)
    (cofiberQuotientComparison_levelWeak hHom F hi qX q0 sq)

/-- Cofibrancy of the actual quotient comes from its actual zero-source pushout leg. -/
private theorem callerQuotient_isCofibrant (F : Arrow (D (I := I)))
    (hi : cofibrations (D (I := I)) F.hom)
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) : IsCofibrant Z := by
  let _ : Cofibration q0 := (HomotopicalAlgebra.cofibration_iff _).mpr
    ((cofibrations (D (I := I))).of_isPushout sq.flip hi)
  exact (isCofibrant_iff_of_isInitial q0 Diagrams.zeroDiagramIsInitial).mpr inferInstance

/-- The original Q-cofiber Omega sequence proves nullity of the caller's same actual quotient. -/
private theorem callerQuotient_omegaNull
    (hHom : ∀ a b : I, IsCofibrant (a ⟶[PointedCGWH.{u, v}] b))
    (s : NativeStabilizationFamily.{u, v} I L)
    (F : Arrow (D (I := I))) (hi : cofibrations (D (I := I)) F.hom)
    (hw : NativeK.omegaTests s F.hom)
    {Z : D (I := I)} (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    NativeK.omegaTests s (Diagrams.toZero Z) := by
  let d := qCofiberQuotientComparison (B := B) F qX q0 sq
  have hd : NativeK.omegaTests s d := NativeK.levelWeak_le_omegaTests s _
    (qCofiberQuotientComparison_levelWeak hHom F hi qX q0 sq)
  have hCollapse : d ≫ Diagrams.toZero Z =
      (NativeK.CofiberNullity.collapse (B := B)).app F :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  exact (NativeK.omegaTests s).of_precomp d (Diagrams.toZero Z) hd
    (hCollapse.symm ▸ NativeK.CofiberNullity.collapse_omegaTests s F.hom hw)

end OriginalQuotient

section NativeSymmetricQuotient

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- The actual symmetric quotient comparison is level weak, using the proved native Hom supplier. -/
private theorem symmetric_qCofiberQuotientComparison_levelWeak
    (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hi : cofibrations Actual.SymmetricCarrier.{u, v} F.hom)
    {Z : Actual.SymmetricCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    weakEquivalences Actual.SymmetricCarrier.{u, v}
      (qCofiberQuotientComparison (B := B) F qX q0 sq) :=
  qCofiberQuotientComparison_levelWeak
    PointedCGWH.SymmetricOperatorHom.nativeSymmetricOperatorHom_isCofibrant F hi qX q0 sq

/-- An arbitrary original symmetric stable acyclic projective cofibration has its actual
cofibrant Omega-null quotient, without cofibrancy premises on either original endpoint. -/
private theorem symmetric_callerQuotient_cofibrant_omegaNull
    (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hi : cofibrations Actual.SymmetricCarrier.{u, v} F.hom)
    (hw : NativeK.omegaTests Actual.symmetricFamily.{u, v} F.hom)
    {Z : Actual.SymmetricCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    IsCofibrant Z ∧ NativeK.omegaTests Actual.symmetricFamily.{u, v} (Diagrams.toZero Z) :=
  ⟨callerQuotient_isCofibrant F hi qX q0 sq,
    callerQuotient_omegaNull
      PointedCGWH.SymmetricOperatorHom.nativeSymmetricOperatorHom_isCofibrant
      Actual.symmetricFamily F hi hw qX q0 sq⟩

end NativeSymmetricQuotient

section NativeOrthogonalQuotient

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- The actual orthogonal quotient comparison is level weak, using its proved full Thom Hom supplier. -/
private theorem orthogonal_qCofiberQuotientComparison_levelWeak
    (F : Arrow Actual.OrthogonalCarrier.{u, v})
    (hi : cofibrations Actual.OrthogonalCarrier.{u, v} F.hom)
    {Z : Actual.OrthogonalCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    weakEquivalences Actual.OrthogonalCarrier.{u, v}
      (qCofiberQuotientComparison (B := B) F qX q0 sq) :=
  qCofiberQuotientComparison_levelWeak PointedCGWH.Spectra.NativeStable.orthogonalHom_isCofibrant
    F hi qX q0 sq

/-- An arbitrary original orthogonal stable acyclic projective cofibration has its same
cofibrant Omega-null quotient, retaining the complete original quotient cocone. -/
private theorem orthogonal_callerQuotient_cofibrant_omegaNull
    (F : Arrow Actual.OrthogonalCarrier.{u, v})
    (hi : cofibrations Actual.OrthogonalCarrier.{u, v} F.hom)
    (hw : NativeK.omegaTests Actual.orthogonalFamily.{u, v} F.hom)
    {Z : Actual.OrthogonalCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    IsCofibrant Z ∧ NativeK.omegaTests Actual.orthogonalFamily.{u, v} (Diagrams.toZero Z) :=
  ⟨callerQuotient_isCofibrant F hi qX q0 sq,
    callerQuotient_omegaNull PointedCGWH.Spectra.NativeStable.orthogonalHom_isCofibrant
      Actual.orthogonalFamily F hi hw qX q0 sq⟩

/-- In the actual ordinary orthogonal stable model, every original stable trivial
cofibration has its same actual cofibrant stable-null quotient. -/
private theorem orthogonal_callerQuotient_stable
    (F : Arrow Actual.OrthogonalCarrier.{u, v})
    {Z : Actual.OrthogonalCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    let : ModelCategory Actual.OrthogonalCarrier.{u, v} :=
      StableModelConstruction.orthogonalModelCategory (B := B)
    trivialCofibrations Actual.OrthogonalCarrier.{u, v} F.hom →
      IsCofibrant Z ∧ weakEquivalences Actual.OrthogonalCarrier.{u, v} (Diagrams.toZero Z) := by
  let : ModelCategory Actual.OrthogonalCarrier.{u, v} :=
    StableModelConstruction.orthogonalModelCategory (B := B)
  change trivialCofibrations Actual.OrthogonalCarrier.{u, v} F.hom →
    IsCofibrant Z ∧ weakEquivalences Actual.OrthogonalCarrier.{u, v} (Diagrams.toZero Z)
  intro hi
  have hNative :
      (HomotopicalAlgebra.EnrichedProjective.Native.modelCategory
        (B := B) (A := CategoryTheory.Spectra.OrthogonalOperatorIndex.{u, v})).categoryWithCofibrations.cofibrations
        F.hom := by
    rw [← StableModelConstruction.orthogonal_cofibrations_eq_level (B := B)]
    exact hi.1
  have hOriginal : NativeK.omegaTests Actual.orthogonalFamily.{u, v} F.hom := by
    have hWeak := hi.2
    rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1] at hWeak
    exact hWeak
  have hNull := callerQuotient_omegaNull (B := B)
    PointedCGWH.Spectra.NativeStable.orthogonalHom_isCofibrant
    Actual.orthogonalFamily F hNative hOriginal qX q0 sq
  have hCof : IsCofibrant Z := by
    let _ : Cofibration q0 := (HomotopicalAlgebra.cofibration_iff _).mpr
      ((cofibrations Actual.OrthogonalCarrier.{u, v}).of_isPushout sq.flip hi.1)
    exact (isCofibrant_iff_of_isInitial q0 Diagrams.zeroDiagramIsInitial).mpr inferInstance
  refine ⟨hCof, ?_⟩
  rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1]
  exact hNull

end NativeOrthogonalQuotient

