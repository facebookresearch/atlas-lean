private abbrev Carrier := CanonicalSourceSmash.Carrier.{u, v}

attribute [local instance] CanonicalSourceSmash.monoidalCategory
  CanonicalSourceSmash.symmetricCategory CanonicalSourceSmashClosed.monoidalClosed
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf
  MonoidalClosed.enrichedOrdinaryCategorySelf
  PointedCGWH.EnrichedKan.hasObjectCoproduct PointedCGWH.EnrichedKan.hasRelationCoproduct
  PointedCGWH.EnrichedKan.hasBalancingCoequalizer
  SphereSmashStructure.indexCategory SphereSmashStructure.indexMonoidalCategory
  SphereSmashStructure.indexEnrichedOrdinaryCategory SphereSmashStructure.indexSymmetricCategory

/-- The complete original free-coefficient smash functor, with its actual field receiver. -/
private abbrev source (r : OrthogonalIndex) (Y : Carrier.{u, v}) :=
  NativeEvaluatedFields.source r Y

/-- The complete original scalar/Kan functor on the same arbitrary right spectrum. -/
private abbrev target (r : OrthogonalIndex) (Y : Carrier.{u, v}) :=
  NativeEvaluatedTarget.target r Y

/-- The exact original evaluated native left mate. -/
private abbrev comparison (r : OrthogonalIndex) (Y : Carrier.{u, v}) :=
  NativeHEPJoin.comparison r Y

/-- The actual Kan scalar family is fixed before any scalar point is chosen. -/
private def targetScalarFamily (r : OrthogonalIndex) (Y : Carrier.{u, v}) :
    Family (target r Y) :=
  fun T M => PointedCGWH.OriginalLanScalarPointComparison.scalarKanIso
    (RightShift.indexShift r) T M Y

/-- Every original coefficient point retains the actual target-side scalar equation. -/
private theorem targetPoint (r : OrthogonalIndex) (Y : Carrier.{u, v})
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (M : PointedCGWH.{u, v}) :
    (target r Y).map (coefficientPoint p M) ≫ (targetScalarFamily r Y T M).hom =
      pointMap p ((target r Y).obj M) := by
  change (leftKan (RightShift.indexShift r)).map
      (scalarTensorMap (coefficientPoint p M) Y) ≫
        (PointedCGWH.OriginalLanScalarPointComparison.scalarKanIso
          (RightShift.indexShift r) T M Y).hom = _
  exact PointedCGWH.OriginalLanScalarPointComparison.scalarKanIso_point
    (RightShift.indexShift r) p M Y

/-- Both original mate maps transport the full actual scalar family. -/
private def scalarForward (r : OrthogonalIndex) (Y : Carrier.{u, v})
    (T M : PointedCGWH.{u, v}) :
    (source r Y).obj (T ⊗ M) ≅ tensorLeftObject T ((source r Y).obj M) :=
  transport (comparison r Y) (targetScalarFamily r Y) T M

/-- The inverse comparison retains every actual coefficient point and native right factor. -/
private theorem scalarForward_inverse_point (r : OrthogonalIndex) (Y : Carrier.{u, v})
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (M : PointedCGWH.{u, v}) :
    pointMap p ((source r Y).obj M) ≫ (scalarForward r Y T M).inv =
      (source r Y).map (coefficientPoint p M) :=
  transport_inverse_point (comparison r Y) (targetScalarFamily r Y) p M
    (targetPoint r Y p M)

/-- The entire original free scalar comparison with its ordinary raw source objects. -/
private def scalarForwardRaw (r : OrthogonalIndex) (Y : Carrier.{u, v})
    (T M : PointedCGWH.{u, v}) :
    Free.object (OrthogonalOperatorIndex.ofIndex r) (T ⊗ M) ⊗ Y ≅
      tensorLeftObject T (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) :=
  scalarForward r Y T M

/-- The same inverse point equation is read through the exact original raw free objects. -/
private theorem scalarForwardRaw_inverse_point (r : OrthogonalIndex) (Y : Carrier.{u, v})
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (M : PointedCGWH.{u, v}) :
    pointMap p (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≫
        (scalarForwardRaw r Y T M).inv =
      Free.coefficientMap (OrthogonalOperatorIndex.ofIndex r) (coefficientPoint p M) ▷ Y :=
  scalarForward_inverse_point r Y p M

/-- The genuine source time comparison for every original free object and arbitrary Y. -/
private def tensorTimeFreeIso (r : OrthogonalIndex) (Y : Carrier.{u, v})
    (T M : PointedCGWH.{u, v}) :
    tensorLeftObject T (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≅
      tensorLeftObject T (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⊗ Y :=
  (scalarForwardRaw r Y T M).symm ≪≫
    TensorRightIsoConstructor.rightIso
      (Free.scalarFreeIso T M (OrthogonalOperatorIndex.ofIndex r)).symm Y

/-- Every original point commutes with that same actual time comparison. -/
private theorem tensorTimeFreeIso_point (r : OrthogonalIndex) (Y : Carrier.{u, v})
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (M : PointedCGWH.{u, v}) :
    pointMap p (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≫
        (tensorTimeFreeIso r Y T M).hom =
      pointMap p (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ▷ Y := by
  rw [tensorTimeFreeIso, Iso.trans_hom, Iso.symm_hom,
    TensorRightIsoConstructor.rightIso_hom, Iso.symm_hom, ← Category.assoc]
  rw [scalarForwardRaw_inverse_point]
  rw [← comp_whiskerRight, freePoint_scalarFree_inverse]










