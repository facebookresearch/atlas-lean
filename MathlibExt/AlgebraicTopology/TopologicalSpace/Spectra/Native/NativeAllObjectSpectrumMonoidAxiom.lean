universe uC vC

private theorem precomp_bijective_of_targetIso
    {C : Type uC} [Category.{vC} C] {A X E T : C} (i : A ⟶ X) (d : E ≅ T)
    (hT : Function.Bijective (fun g : X ⟶ T => i ≫ g)) :
    Function.Bijective (fun g : X ⟶ E => i ≫ g) := by
  constructor
  · intro g h heq
    apply (cancel_mono d.hom).mp
    apply hT.1
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (fun k => k ≫ d.hom) heq).trans (Category.assoc _ _ _))
  · intro g
    obtain ⟨h, hh⟩ := hT.2 (g ≫ d.hom)
    refine ⟨h ≫ d.inv, ?_⟩
    change i ≫ (h ≫ d.inv) = g
    change i ≫ h = g ≫ d.hom at hh
    rw [← Category.assoc, hh, Category.assoc, Iso.hom_inv_id, Category.comp_id]

section CoefficientSphereTests

attribute [local instance] CGWH.modelCategory.instPointedCGWHIsClosedSymmetricMonoidalModelCategory

private abbrev HP := _root_.HomotopicalAlgebra.toHomotopyCategory PointedCGWH.{u, v}

private instance sphereOneCofibrant : IsCofibrant PointedCGWH.sphereOne.{u, v} :=
  PointedCGWH.modelCategory.sphereOne_isCofibrant

private instance sphereUnitCofibrant : IsCofibrant (𝟙_ PointedCGWH.{u, v}) :=
  PointedCGWH.modelCategory.smashUnit_isCofibrant

private instance pointedFibrant (X : PointedCGWH.{u, v}) : IsFibrant X :=
  PointedCGWH.modelCategory.allObjectsFibrant X

private instance sphereAdjunctionQuillen :
    (ihom.adjunction PointedCGWH.sphereOne.{u, v}).IsQuillenAdjunction :=
  ihomAdjunction_isQuillenAdjunction_of_isCofibrant PointedCGWH.sphereOne

/-- The original coefficient Quillen maps compare actual one-sphere tests with loop-point tests. -/
private def sphereLoopHomEquiv (X : PointedCGWH.{u, v}) :
    (HP.obj PointedCGWH.sphereOne ⟶ HP.obj X) ≃
      (HP.obj (𝟙_ PointedCGWH.{u, v}) ⟶ HP.obj ((ihom PointedCGWH.sphereOne).obj X)) :=
  (Iso.homCongr ((HP.mapIso (ρ_ PointedCGWH.sphereOne)).symm) (Iso.refl _)).trans
    (QuillenOrdinaryHoHom.homEquiv (ihom.adjunction PointedCGWH.sphereOne)
      (𝟙_ PointedCGWH.{u, v}) X)

/-- Both original coefficient adjunct maps retain every actual target map. -/
private theorem sphereLoopHomEquiv_target {X Y : PointedCGWH.{u, v}} (f : X ⟶ Y)
    (g : HP.obj PointedCGWH.sphereOne ⟶ HP.obj X) :
    sphereLoopHomEquiv Y (g ≫ HP.map f) =
      sphereLoopHomEquiv X g ≫ HP.map ((ihom PointedCGWH.sphereOne).map f) := by
  simp only [sphereLoopHomEquiv, Equiv.trans_apply, Iso.homCongr_apply,
    Iso.symm_inv, Iso.refl_hom, Category.comp_id]
  rw [← Category.assoc]
  exact QuillenOrdinaryHoHom.homEquiv_naturality_right
    (ihom.adjunction PointedCGWH.sphereOne) (𝟙_ PointedCGWH.{u, v}) _ f

/-- Weakness of the actual all-component one-sphere loop map gives original sphere Hom bijectivity. -/
private theorem sphereHomPost_bijective_of_loopWeak {X Y : PointedCGWH.{u, v}} (f : X ⟶ Y)
    (hf : weakEquivalences PointedCGWH.{u, v} ((ihom PointedCGWH.sphereOne).map f)) :
    Function.Bijective (fun g : HP.obj PointedCGWH.sphereOne ⟶ HP.obj X => g ≫ HP.map f) := by
  have hIso := (_root_.HomotopicalAlgebra.weakEquivalence_iff_isIso_toHomotopyCategory_map
    ((ihom PointedCGWH.sphereOne).map f)).mp hf
  have hBij := (isIso_iff_yoneda_map_bijective _).mp hIso (HP.obj (𝟙_ PointedCGWH.{u, v}))
  constructor
  · intro g h heq
    change g ≫ HP.map f = h ≫ HP.map f at heq
    apply (sphereLoopHomEquiv X).injective
    apply hBij.1
    change sphereLoopHomEquiv X g ≫ HP.map ((ihom PointedCGWH.sphereOne).map f) =
      sphereLoopHomEquiv X h ≫ HP.map ((ihom PointedCGWH.sphereOne).map f)
    rw [← sphereLoopHomEquiv_target, ← sphereLoopHomEquiv_target, heq]
  · intro g
    obtain ⟨h, hh⟩ := hBij.2 (sphereLoopHomEquiv Y g)
    change h ≫ HP.map ((ihom PointedCGWH.sphereOne).map f) = sphereLoopHomEquiv Y g at hh
    refine ⟨(sphereLoopHomEquiv X).symm h, ?_⟩
    apply (sphereLoopHomEquiv Y).injective
    rw [sphereLoopHomEquiv_target, Equiv.apply_symm_apply, hh]

end CoefficientSphereTests

section OriginalMappingFiber

variable {I : Type} [EnrichedCategory PointedCGWH.{u, v} I]
attribute [local instance] PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

private abbrev D := EnrichedFunctorCat PointedCGWH.{u, v} I

/-- The original source mapping functor carries the unchanged zero to an actual terminal mapping object. -/
private def sourceZeroMappingIsTerminal (E : D (I := I)) :
    IsTerminal (mappingObject (Diagrams.zeroDiagram (A := I)) E) := by
  let S := PointedCGWH.NativeMappingSourceFunctor.source E
  let _ : PreservesLimits S := PointedCGWH.NativeMappingSourcePreservation.source_preservesLimits E
  exact Diagrams.zeroDiagramIsInitial.op.isTerminalObj S (Opposite.op Diagrams.zeroDiagram)

/-- The complete terminal universal maps identify the original zero-source mapping object with the point. -/
private def sourceZeroMappingPointIso (E : D (I := I)) :
    mappingObject (Diagrams.zeroDiagram (A := I)) E ≅
      PointedCGWH.StrictFiberGeometry.pointObject.{u, v} :=
  (sourceZeroMappingIsTerminal E).conePointUniqueUpToIso
    PointedCGWH.StrictFiberGeometry.pointObjectIsTerminal

/-- The caller's quotient retains the entire original mapping pullback at the literal point. -/
private theorem quotientMappingFiberSquare
    {A X Z : D (I := I)} (i : A ⟶ X)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (E : D (I := I)) :
    IsPullback (WeightedEndVariance.pre qX E)
      (WeightedEndVariance.pre q0 E ≫ (sourceZeroMappingPointIso E).hom)
      (WeightedEndVariance.pre i E)
      (PointedCGWH.StrictFiberGeometry.fromPoint (mappingObject A E)) := by
  let e := sourceZeroMappingPointIso E
  have hBottom : IsPullback (WeightedEndVariance.pre (Diagrams.toZero A) E) e.hom
      (𝟙 (mappingObject A E)) (PointedCGWH.StrictFiberGeometry.fromPoint (mappingObject A E)) := by
    apply IsPullback.of_vert_isIso
    refine ⟨?_⟩
    apply (cancel_epi e.inv).mp
    simp only [Category.comp_id, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
    exact PointedCGWH.StrictFiberGeometry.pointObjectIsInitial.hom_ext _ _
  have h := (PointedCGWH.NativeMappingPushout.sourceSquare i (Diagrams.toZero A) qX q0 sq E).paste_vert
    hBottom
  simpa only [Category.comp_id] using h

/-- The original quotient mapping pullback identifies its actual native strict fiber. -/
private def quotientMappingFiberIso
    {A X Z : D (I := I)} (i : A ⟶ X)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (E : D (I := I)) :
    mappingObject Z E ≅ PointedCGWH.StrictFiberGeometry.fiber (WeightedEndVariance.pre i E) :=
  (quotientMappingFiberSquare i qX q0 sq E).isoIsPullback _ _
    (IsPullback.of_isLimit (PointedCGWH.StrictFiberGeometry.fiberConeIsLimit
      (WeightedEndVariance.pre i E)))

/-- The full strict-fiber total projection is exactly the caller's original quotient mapping map. -/
@[reassoc]
private theorem quotientMappingFiberIso_total
    {A X Z : D (I := I)} (i : A ⟶ X)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (E : D (I := I)) :
    (quotientMappingFiberIso i qX q0 sq E).hom ≫
        PointedCGWH.StrictFiberGeometry.fiberToTotal (WeightedEndVariance.pre i E) =
      WeightedEndVariance.pre qX E :=
  (quotientMappingFiberSquare i qX q0 sq E).isoIsPullback_hom_fst _ _
    (IsPullback.of_isLimit (PointedCGWH.StrictFiberGeometry.fiberConeIsLimit
      (WeightedEndVariance.pre i E)))

/-- The full strict-fiber point projection retains the original zero leg and terminal comparison. -/
@[reassoc]
private theorem quotientMappingFiberIso_point
    {A X Z : D (I := I)} (i : A ⟶ X)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (E : D (I := I)) :
    (quotientMappingFiberIso i qX q0 sq E).hom ≫
        PointedCGWH.StrictFiberGeometry.fiberToPoint (WeightedEndVariance.pre i E) =
      WeightedEndVariance.pre q0 E ≫ (sourceZeroMappingPointIso E).hom :=
  (quotientMappingFiberSquare i qX q0 sq E).isoIsPullback_hom_snd _ _
    (IsPullback.of_isLimit (PointedCGWH.StrictFiberGeometry.fiberConeIsLimit
      (WeightedEndVariance.pre i E)))

end OriginalMappingFiber

section CofibrantMappingRestriction

variable {I L : Type} [EnrichedCategory PointedCGWH.{u, v} I]
  [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

private abbrev H := _root_.HomotopicalAlgebra.toHomotopyCategory (D (I := I))

/-- The actual quotient's Omega nullity gives the original mapping restriction's full strict-fiber collapse. -/
private theorem quotientMappingFiber_collapse_weak
    (s : NativeStabilizationFamily.{u, v} I L)
    {A X Z : D (I := I)} (i : A ⟶ X) (hi : cofibrations (D (I := I)) i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (hZ : NativeK.omegaTests s (Diagrams.toZero Z))
    (E : D (I := I)) (hE : NativeK.IsOmega s E) :
    CGWH.weakHomotopyEquivalences
      (CGWH.strictFiberToPoint (WeightedEndVariance.pre i E).right (mappingObject A E).hom) := by
  let _ : IsCofibrant (Diagrams.zeroDiagram (A := I)) :=
    (isCofibrant_iff_of_isInitial (𝟙 Diagrams.zeroDiagram) Diagrams.zeroDiagramIsInitial).mpr inferInstance
  let _ : IsCofibrant Z := callerQuotient_isCofibrant (Arrow.mk i) hi qX q0 sq
  have hFac : q0 ≫ Diagrams.toZero Z = 𝟙 Diagrams.zeroDiagram :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  have hQ0 : NativeK.omegaTests s q0 := (NativeK.omegaTests s).of_postcomp q0 (Diagrams.toZero Z) hZ
    (hFac.symm ▸ (NativeK.omegaTests s).id_mem Diagrams.zeroDiagram)
  have hM : weakEquivalences PointedCGWH.{u, v} (WeightedEndVariance.pre q0 E) :=
    DerivedLocalMapping.mappingPre_weak_of_omegaTests s q0 hQ0 E hE
  let e := quotientMappingFiberIso i qX q0 sq E
  have hMP : weakEquivalences PointedCGWH.{u, v}
      (WeightedEndVariance.pre q0 E ≫ (sourceZeroMappingPointIso E).hom) :=
    (weakEquivalences PointedCGWH.{u, v}).comp_mem _ _ hM
      ((weakEquivalences PointedCGWH.{u, v}).of_isIso _)
  have hFiber : weakEquivalences PointedCGWH.{u, v}
      (PointedCGWH.StrictFiberGeometry.fiberToPoint (WeightedEndVariance.pre i E)) :=
    (weakEquivalences PointedCGWH.{u, v}).of_precomp e.hom _
      ((weakEquivalences PointedCGWH.{u, v}).of_isIso e.hom)
      ((quotientMappingFiberIso_point i qX q0 sq E).symm ▸ hMP)
  let _ : WeakEquivalence (PointedCGWH.StrictFiberGeometry.fiberToPoint
      (WeightedEndVariance.pre i E)) := (HomotopicalAlgebra.weakEquivalence_iff _).mpr hFiber
  have hRight := (PointedCGWH.weakEquivalence_iff
    (PointedCGWH.StrictFiberGeometry.fiberToPoint (WeightedEndVariance.pre i E))).mp inferInstance
  exact (HomotopicalAlgebra.weakEquivalence_iff _).mp hRight

/-- The genuine original Serre restriction and original quotient fiber give the actual loop map weak
on every component, rather than only at its chosen basepoint. -/
private theorem quotientMappingRestriction_sphereOne_weak
    (s : NativeStabilizationFamily.{u, v} I L)
    {A X Z : D (I := I)} (i : A ⟶ X) (hi : cofibrations (D (I := I)) i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (hZ : NativeK.omegaTests s (Diagrams.toZero Z))
    (E : D (I := I)) (hE : NativeK.IsOmega s E) :
    weakEquivalences PointedCGWH.{u, v}
      ((ihom PointedCGWH.sphereOne).map (WeightedEndVariance.pre i E)) := by
  let _ : Fibration (WeightedEndVariance.pre i E) :=
    (HomotopicalAlgebra.fibration_iff _).mpr (NativeK.mapSource_fibration i hi E)
  exact PointedCGWH.FiberGeometry.ihomSphereOne_weak_of_strictFiber_weak_collapse _
    (quotientMappingFiber_collapse_weak s i hi qX q0 sq hZ E hE)

/-- The original scalar mapping adjunction recovers full shifted Hom bijectivity from the original fiber. -/
private theorem quotient_scalarLoopHom_bijective
    (s : NativeStabilizationFamily.{u, v} I L)
    {A X Z : D (I := I)} [IsCofibrant A] [IsCofibrant X]
    (i : A ⟶ X) (hi : cofibrations (D (I := I)) i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (hZ : NativeK.omegaTests s (Diagrams.toZero Z))
    (E : D (I := I)) (hE : NativeK.IsOmega s E) :
    Function.Bijective (fun g : H.obj X ⟶ H.obj ((cotensor PointedCGWH.sphereOne).obj E) =>
      H.map i ≫ g) := by
  let _ : IsCofibrant PointedCGWH.sphereOne.{u, v} := PointedCGWH.modelCategory.sphereOne_isCofibrant
  have hBij := sphereHomPost_bijective_of_loopWeak (WeightedEndVariance.pre i E)
    (quotientMappingRestriction_sphereOne_weak s i hi qX q0 sq hZ E hE)
  let eA := DerivedLocalMapping.scalarMappingHoEquiv PointedCGWH.sphereOne A E
  let eX := DerivedLocalMapping.scalarMappingHoEquiv PointedCGWH.sphereOne X E
  constructor
  · intro g h heq
    apply eX.symm.injective
    apply hBij.1
    apply eA.injective
    rw [DerivedLocalMapping.scalarMappingHoEquiv_source,
      DerivedLocalMapping.scalarMappingHoEquiv_source, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact heq
  · intro g
    obtain ⟨h, hh⟩ := hBij.2 (eA.symm g)
    change h ≫ HP.map (WeightedEndVariance.pre i E) = eA.symm g at hh
    refine ⟨eX h, ?_⟩
    change H.map i ≫ eX h = g
    rw [← DerivedLocalMapping.scalarMappingHoEquiv_source, hh, Equiv.apply_symm_apply]

end CofibrantMappingRestriction

section NativeCofibrantRestrictions

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- Actual symmetric first-function delooping returns the full original unshifted Omega tests. -/
private theorem symmetric_cofibrantCofibration_omegaTests_of_callerQuotientNull
    {A X Z : Actual.SymmetricCarrier.{u, v}} [IsCofibrant A] [IsCofibrant X]
    (i : A ⟶ X) (hi : cofibrations Actual.SymmetricCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (hZ : NativeK.omegaTests Actual.symmetricFamily.{u, v} (Diagrams.toZero Z)) :
    NativeK.omegaTests Actual.symmetricFamily.{u, v} i := by
  intro E hE
  let T := NativeOmegaRecovery.NativeSymmetricDelooping.firstDelooping.obj E
  let HC := _root_.HomotopicalAlgebra.toHomotopyCategory Actual.SymmetricCarrier.{u, v}
  let d : HC.obj E ≅ HC.obj ((cotensor PointedCGWH.sphereOne).obj T) :=
    NativeOmegaRecovery.NativeSymmetricDelooping.deltaHoIso (B := B) E hE
  have hT := NativeOmegaRecovery.NativeSymmetricDelooping.firstDelooping_isOmega E hE
  have hLoop := quotient_scalarLoopHom_bijective Actual.symmetricFamily i hi qX q0 sq hZ T hT
  exact precomp_bijective_of_targetIso (HC.map i) d hLoop

/-- Actual orthogonal right-shift delooping returns every full original unshifted Omega test. -/
private theorem orthogonal_cofibrantCofibration_omegaTests_of_callerQuotientNull
    {A X Z : Actual.OrthogonalCarrier.{u, v}} [IsCofibrant A] [IsCofibrant X]
    (i : A ⟶ X) (hi : cofibrations Actual.OrthogonalCarrier.{u, v} i)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0)
    (hZ : NativeK.omegaTests Actual.orthogonalFamily.{u, v} (Diagrams.toZero Z)) :
    NativeK.omegaTests Actual.orthogonalFamily.{u, v} i := by
  intro E hE
  let T := PointedCGWH.Spectra.Orthogonal.FunctionSpectrum.Delooping.firstDelooping.obj E
  let HC := _root_.HomotopicalAlgebra.toHomotopyCategory Actual.OrthogonalCarrier.{u, v}
  have hDelta : weakEquivalences Actual.OrthogonalCarrier.{u, v}
      (PointedCGWH.Spectra.Orthogonal.FunctionSpectrum.Delooping.delta.app E) :=
    PointedCGWH.Spectra.Orthogonal.FunctionSpectrum.Delooping.delta_weak E hE
  let _ : IsIso (HC.map (PointedCGWH.Spectra.Orthogonal.FunctionSpectrum.Delooping.delta.app E)) :=
    (_root_.HomotopicalAlgebra.weakEquivalence_iff_isIso_toHomotopyCategory_map _).mp hDelta
  let d : HC.obj E ≅ HC.obj ((cotensor PointedCGWH.sphereOne).obj T) :=
    asIso (HC.map (PointedCGWH.Spectra.Orthogonal.FunctionSpectrum.Delooping.delta.app E))
  have hT := PointedCGWH.Spectra.Orthogonal.FunctionSpectrum.Delooping.firstDelooping_isOmega E hE
  have hLoop := quotient_scalarLoopHom_bijective Actual.orthogonalFamily i hi qX q0 sq hZ T hT
  exact precomp_bijective_of_targetIso (HC.map i) d hLoop

end NativeCofibrantRestrictions

section OriginalQArrowFactor

variable {I L : Type} [EnrichedCategory PointedCGWH.{u, v} I]
  [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

local notation "Q" => Replacement.cofibrantReplacement (B := B) (A := I)
local notation "C" => OriginalICone.cone (B := B) (I := I)
local notation "ι" => OriginalICone.inclusion (B := B) (I := I)
local notation "c" => OriginalISuspension.cocone (B := B) (I := I)
local notation "hc" => OriginalISuspension.coconeIsColimit (B := B) (I := I)
local notation "factor" => HomotopicalAlgebra.EnrichedProjective.Native.cofibrantFactorizationData (B := B) (A := I)

/-- Every actual original cofiber map with level-weak input components is level weak. -/
private theorem originalCofiberMap_levelWeak
    (hHom : ∀ a b : I, IsCofibrant (a ⟶[PointedCGWH.{u, v}] b))
    {F G : Arrow (D (I := I))} (q : F ⟶ G)
    (hLeft : weakEquivalences (D (I := I)) q.left)
    (hRight : weakEquivalences (D (I := I)) q.right) :
    weakEquivalences (D (I := I)) ((originalCofiber (B := B)).map q) := by
  let _ : IsLeftProper (D (I := I)) :=
    IndexCofibrantProperness.originalNativeLevelLeftProper (B := B) hHom
  let _ : Cofibration ((ι).app F.left) :=
    (HomotopicalAlgebra.cofibration_iff _).mpr (OriginalICone.inclusion_cofibration _)
  let _ : Cofibration ((ι).app G.left) :=
    (HomotopicalAlgebra.cofibration_iff _).mpr (OriginalICone.inclusion_cofibration _)
  let _ : WeakEquivalence q.left := (HomotopicalAlgebra.weakEquivalence_iff _).mpr hLeft
  let _ : WeakEquivalence q.right := (HomotopicalAlgebra.weakEquivalence_iff _).mpr hRight
  let _ : WeakEquivalence ((C).map q.left) := (HomotopicalAlgebra.weakEquivalence_iff _).mpr (coneMap_levelWeak q.left)
  exact (HomotopicalAlgebra.weakEquivalence_iff _).mp
    (IsLeftProper.weakEquivalence_map_of_isPushouts_of_fst
      (IsPushout.of_isColimit (hc F)) (IsPushout.of_isColimit (hc G))
      (a := q.left) (b := (C).map q.left) («c» := q.right)
      (d := (originalCofiber (B := B)).map q)
      ((ι).naturality q.left).symm q.w.symm
      (OrdinaryHoChosenPuppe.cofiberMap_cone C ι c hc q)
      (OrdinaryHoChosenPuppe.cofiberMap_target C ι c hc q))

/-- The actual original I middle object on the unchanged whole Q arrow. -/
private def qArrowMiddle (F : Arrow (D (I := I))) : D (I := I) := (factor).Z.obj ((Q).mapArrow.obj F)

/-- The original I first factor retains the actual Q source. -/
private def qArrowFirstFactor (F : Arrow (D (I := I))) : ((Q).mapArrow.obj F).left ⟶ qArrowMiddle F :=
  (factor).i.app ((Q).mapArrow.obj F)

/-- The original I second factor retains the actual Q target. -/
private def qArrowSecondFactor (F : Arrow (D (I := I))) : qArrowMiddle F ⟶ ((Q).mapArrow.obj F).right :=
  (factor).p.app ((Q).mapArrow.obj F)

/-- Both factors have exactly the caller's original whole Q map as their composite. -/
private theorem qArrowFirstSecond_fac (F : Arrow (D (I := I))) :
    qArrowFirstFactor (B := B) F ≫ qArrowSecondFactor (B := B) F = ((Q).mapArrow.obj F).hom :=
  (factor).fac_app

/-- The whole original I first-factor arrow. -/
private def qArrowFactorArrow (F : Arrow (D (I := I))) : Arrow (D (I := I)) :=
  Arrow.mk (qArrowFirstFactor (B := B) F)

/-- The comparison to the whole Q arrow retains the identity source and original I projection. -/
private def qArrowFactorToQ (F : Arrow (D (I := I))) : qArrowFactorArrow (B := B) F ⟶ (Q).mapArrow.obj F :=
  Arrow.homMk (𝟙 ((Q).mapArrow.obj F).left) (qArrowSecondFactor (B := B) F) (by
    exact (Category.id_comp ((Q).mapArrow.obj F).hom).trans (qArrowFirstSecond_fac F).symm)

/-- The actual first factor is a native projective cofibration. -/
private theorem qArrowFirstFactor_cofibration (F : Arrow (D (I := I))) :
    cofibrations (D (I := I)) (qArrowFirstFactor (B := B) F) := (factor).hi _

/-- The actual second factor is level weak by its original trivial-fibration membership. -/
private theorem qArrowSecondFactor_levelWeak (F : Arrow (D (I := I))) :
    weakEquivalences (D (I := I)) (qArrowSecondFactor (B := B) F) := ((factor).hp _).2

/-- The I middle object is cofibrant because its original source is the actual Q source. -/
private theorem qArrowMiddle_isCofibrant (F : Arrow (D (I := I))) : IsCofibrant (qArrowMiddle (B := B) F) := by
  let _ : IsCofibrant ((Q).mapArrow.obj F).left := Replacement.isCofibrant_cofibrantReplacement F.left
  let _ : Cofibration (qArrowFirstFactor (B := B) F) :=
    (HomotopicalAlgebra.cofibration_iff _).mpr (qArrowFirstFactor_cofibration F)
  exact isCofibrant_of_cofibration (qArrowFirstFactor (B := B) F)

/-- Original Q-cofiber nullity passes through the actual I-factor cofiber maps to its actual quotient. -/
private theorem qArrowFactorQuotient_omegaNull
    (hHom : ∀ a b : I, IsCofibrant (a ⟶[PointedCGWH.{u, v}] b))
    (s : NativeStabilizationFamily.{u, v} I L) (F : Arrow (D (I := I)))
    (hF : NativeK.omegaTests s
      (Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F))) :
    NativeK.omegaTests s (Diagrams.toZero (quotient (qArrowFactorArrow (B := B) F))) := by
  let J := qArrowFactorArrow (B := B) F
  let a := (originalCofiber (B := B)).map (qArrowFactorToQ (B := B) F)
  have ha : NativeK.omegaTests s a := NativeK.levelWeak_le_omegaTests s _
    (originalCofiberMap_levelWeak hHom (qArrowFactorToQ F)
      ((weakEquivalences (D (I := I))).id_mem _) (qArrowSecondFactor_levelWeak F))
  have hA : NativeK.omegaTests s (Diagrams.toZero ((originalCofiber (B := B)).obj J)) := by
    have hComp := (NativeK.omegaTests s).comp_mem _ _ ha hF
    have hCollapse : a ≫ Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F) =
        Diagrams.toZero ((originalCofiber (B := B)).obj J) :=
      Diagrams.zeroDiagramIsTerminal.hom_ext _ _
    exact hCollapse ▸ hComp
  let b := cofiberQuotientComparison (B := B) J (quotientTarget J) (quotientZero J) (quotient_isPushout J)
  have hb : NativeK.omegaTests s b := NativeK.levelWeak_le_omegaTests s _
    (cofiberQuotientComparison_levelWeak hHom J (qArrowFirstFactor_cofibration F)
      (quotientTarget J) (quotientZero J) (quotient_isPushout J))
  have hCollapse : b ≫ Diagrams.toZero (quotient J) =
      Diagrams.toZero ((originalCofiber (B := B)).obj J) :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  exact (NativeK.omegaTests s).of_precomp b (Diagrams.toZero (quotient J)) hb (hCollapse.symm ▸ hA)

end OriginalQArrowFactor

section NativeArbitraryArrowDetection

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- The full original symmetric Q-cofiber detects the original arrow's Omega weakness,
with no cofibrancy premise on either original endpoint. -/
private theorem symmetric_omegaTests_of_qCofiberNull (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hF : NativeK.omegaTests Actual.symmetricFamily.{u, v}
      (Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F))) :
    NativeK.omegaTests Actual.symmetricFamily.{u, v} F.hom := by
  let J := qArrowFactorArrow (B := B) F
  let _ : IsCofibrant J.left := Replacement.isCofibrant_cofibrantReplacement F.left
  let _ : IsCofibrant J.right := qArrowMiddle_isCofibrant F
  have hJ := symmetric_cofibrantCofibration_omegaTests_of_callerQuotientNull
    J.hom (qArrowFirstFactor_cofibration F) (quotientTarget J) (quotientZero J) (quotient_isPushout J)
    (qArrowFactorQuotient_omegaNull
      PointedCGWH.SymmetricOperatorHom.nativeSymmetricOperatorHom_isCofibrant Actual.symmetricFamily F hF)
  have hP := NativeK.levelWeak_le_omegaTests Actual.symmetricFamily _ (qArrowSecondFactor_levelWeak F)
  have hQ := (NativeK.omegaTests Actual.symmetricFamily).comp_mem _ _ hJ hP
  change NativeK.omegaTests Actual.symmetricFamily
    (qArrowFirstFactor (B := B) F ≫ qArrowSecondFactor (B := B) F) at hQ
  rw [qArrowFirstSecond_fac] at hQ
  exact (NativeK.cofibrantReplacement_map_localTest_iff Actual.symmetricFamily F.hom).mp hQ

/-- The full original orthogonal Q-cofiber detects the original arrow's Omega weakness,
retaining the actual Q/I maps and arbitrary original endpoints. -/
private theorem orthogonal_omegaTests_of_qCofiberNull (F : Arrow Actual.OrthogonalCarrier.{u, v})
    (hF : NativeK.omegaTests Actual.orthogonalFamily.{u, v}
      (Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F))) :
    NativeK.omegaTests Actual.orthogonalFamily.{u, v} F.hom := by
  let J := qArrowFactorArrow (B := B) F
  let _ : IsCofibrant J.left := Replacement.isCofibrant_cofibrantReplacement F.left
  let _ : IsCofibrant J.right := qArrowMiddle_isCofibrant F
  have hJ := orthogonal_cofibrantCofibration_omegaTests_of_callerQuotientNull
    J.hom (qArrowFirstFactor_cofibration F) (quotientTarget J) (quotientZero J) (quotient_isPushout J)
    (qArrowFactorQuotient_omegaNull PointedCGWH.Spectra.NativeStable.orthogonalHom_isCofibrant
      Actual.orthogonalFamily F hF)
  have hP := NativeK.levelWeak_le_omegaTests Actual.orthogonalFamily _ (qArrowSecondFactor_levelWeak F)
  have hQ := (NativeK.omegaTests Actual.orthogonalFamily).comp_mem _ _ hJ hP
  change NativeK.omegaTests Actual.orthogonalFamily
    (qArrowFirstFactor (B := B) F ≫ qArrowSecondFactor (B := B) F) at hQ
  rw [qArrowFirstSecond_fac] at hQ
  exact (NativeK.cofibrantReplacement_map_localTest_iff Actual.orthogonalFamily F.hom).mp hQ

/-- Every original symmetric arrow is Omega weak exactly when its same original Q-cofiber is Omega null. -/
private theorem symmetric_qCofiberNull_iff_omegaTests (F : Arrow Actual.SymmetricCarrier.{u, v}) :
    NativeK.omegaTests Actual.symmetricFamily.{u, v}
        (Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F)) ↔
      NativeK.omegaTests Actual.symmetricFamily.{u, v} F.hom :=
  ⟨symmetric_omegaTests_of_qCofiberNull F,
    fun hF => NativeK.CofiberNullity.collapse_omegaTests Actual.symmetricFamily F.hom hF⟩

/-- Every original orthogonal arrow has the full original Q-cofiber Omega-null detection equivalence. -/
private theorem orthogonal_qCofiberNull_iff_omegaTests (F : Arrow Actual.OrthogonalCarrier.{u, v}) :
    NativeK.omegaTests Actual.orthogonalFamily.{u, v}
        (Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F)) ↔
      NativeK.omegaTests Actual.orthogonalFamily.{u, v} F.hom :=
  ⟨orthogonal_omegaTests_of_qCofiberNull F,
    fun hF => NativeK.CofiberNullity.collapse_omegaTests Actual.orthogonalFamily F.hom hF⟩

end NativeArbitraryArrowDetection


