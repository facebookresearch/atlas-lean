section Tensor
variable {C : Type uC} [Category.{vC} C] [MonoidalCategory C]

/-- The complete original right tensor, with its literal object and map tables. -/
private def rightFunctor (Y : C) : C ⥤ C where
  obj X := X ⊗ Y
  map f := f ▷ Y
  map_id X := id_whiskerRight X Y
  map_comp f g := comp_whiskerRight f g Y

private theorem rightFunctor_whole (Y : C) : rightFunctor Y = tensorRight Y := rfl

/-- The complete literal action of a right-factor arrow on every left object. -/
private def comparison {Y Z : C} (f : Y ⟶ Z) : rightFunctor Y ⟶ rightFunctor Z where
  app X := X ◁ f
  naturality _ _ g := (whisker_exchange g f).symm

private theorem comparison_whole {Y Z : C} (f : Y ⟶ Z) :
    HEq (comparison f) ((tensoringRight C).map f) := HEq.refl _

private theorem rightFunctorPreservesFamily [BraidedCategory C] [MonoidalClosed C] :
    ∀ Y : C, PreservesColimitsOfSize.{w, w} (rightFunctor Y) := by
  intro Y
  let _ : PreservesColimitsOfSize.{w, w} (tensorRight Y) :=
    OriginalTensorBoundary.rightTensorPreservesFamily Y
  exact preservesColimits_of_natIso (eqToIso (rightFunctor_whole Y).symm)

end Tensor

section FreeTensor
variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V]
  {A : Type uA} [EnrichedCategory V A]
  [MonoidalCategory (EnrichedFunctorCat V A)]

private theorem freeTensorArrow_whole (a : A) (Y : EnrichedFunctorCat V A) :
    (fun d : Arrow V => (rightFunctor Y).mapArrow.obj ((Free.functor a).mapArrow.obj d)) =
      (fun d : Arrow V => Arrow.mk (Free.coefficientMap a d.hom ▷ Y)) := rfl

/-- Transport the full boundary-image predicate family before any actual
coefficient Arrow or its endpoint objects are projected. -/
private theorem images_of_literal_free_boundaries
    (T : MorphismProperty (EnrichedFunctorCat V A)) (S : MorphismProperty V)
    (Y : EnrichedFunctorCat V A)
    (h : ∀ (a : A) (d : Arrow V), S d.hom → T (Free.coefficientMap a d.hom ▷ Y)) :
    ∀ (a : A) (d : Arrow V), S d.hom →
      T (((rightFunctor Y).mapArrow.obj ((Free.functor a).mapArrow.obj d)).hom) := by
  intro a
  exact (congrArg (fun F : Arrow V → Arrow (EnrichedFunctorCat V A) =>
    ∀ d : Arrow V, S d.hom → T (F d).hom) (freeTensorArrow_whole a Y)).mpr (h a)

end FreeTensor

section Generators
variable {V : Type uV} [Category.{vV} V] {C : Type uC} [Category.{vC} C]
  {D : Type uD} [Category.{vD} D] {A : Type uA}

/-- A proved whole generator image family implies images of precisely the
original adjoint-family generators; its original Arrow equality is retained. -/
private theorem adjointFamilyGeneratorImages (F : A → V ⥤ C) (S : MorphismProperty V)
    (P : C ⥤ D) (T : MorphismProperty D)
    (h : ∀ (a : A) (d : Arrow V), S d.hom →
      T ((P.mapArrow.obj ((F a).mapArrow.obj d)).hom)) :
    MorphismProperty.adjointFamilyGenerators F S ≤ T.inverseImage P := by
  intro X Y f hf
  obtain ⟨q, hq⟩ := (MorphismProperty.adjointFamilyGenerators_iff F S f).mp hf
  exact (congrArg (fun d : Arrow D => T d.hom)
    (congrArg P.mapArrow.obj hq)).mpr (h q.1 q.2.1 q.2.2)

end Generators








end PointedCGWH.Spectra.Orthogonal.OriginalTensorConstructors

