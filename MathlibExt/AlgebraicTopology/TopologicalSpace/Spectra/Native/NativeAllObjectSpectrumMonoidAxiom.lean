open CategoryTheory MonoidalCategory

namespace CategoryTheory.OriginalFreeEndpointFunctorBoundary

variable {C : Type uC} [Category.{vC} C] {D : Type uD} [Category.{vD} D]

/-- Keep component construction behind its complete original functor and Iso parameters. -/
private def component {F G : C ⥤ D} (e : F ≅ G) (X : C) : F.obj X ≅ G.obj X := e.app X

/-- Whole functor value equalities transport both original natural maps before any input
object or arrow is selected. This is a constructor boundary, with no weak-class premise. -/
private def transport {F G F' G' : C ⥤ D} (hF : F = F') (hG : G = G') (e : F ≅ G) : F' ≅ G' :=
  Eq.mp (congrArg₂ (fun A B : C ⥤ D => A ≅ B) hF hG) e


/-- Read a curried tensor source through its complete functor/object equality parameters.
Keeping the constructor abstract avoids normalizing an actual native free source. -/
private theorem tensorSource_value [MonoidalCategory D] (F : C ⥤ D) (A : C) (X : D)
    (h : F.obj A = X) : (F ⋙ curriedTensor D).obj A = tensorLeft X :=
  congrArg (fun Y : D => tensorLeft Y) h



/-- An original object equality transports the ENTIRE literal left-tensor Arrow, including
both endpoint objects and its original map, without constructing a functor-value equality. -/
private theorem tensorArrowObject_value [MonoidalCategory D] {A B X Y : D}
    (h : A = B) (f : X ⟶ Y) : Arrow.mk (A ◁ f) = Arrow.mk (B ◁ f) :=
  congrArg (fun T : D => Arrow.mk (T ◁ f)) h


/-- The complete Arrow of the original projected curried tensor source has its original
left-tensor endpoint objects and map. No equality of whole functor law records is required. -/
private theorem curriedTensorArrow_value [MonoidalCategory D] (F : C ⥤ D) (A : C)
    {X Y : D} (f : X ⟶ Y) :
    Arrow.mk (((F ⋙ curriedTensor D).obj A).map f) = Arrow.mk (F.obj A ◁ f) := rfl


/-- The generic whole Arrow comparison keeps every original NatIso component and map. -/
private def arrowComparison {F G : C ⥤ D} (e : F ≅ G) {X Y : C} (f : X ⟶ Y) :
    Arrow.mk (F.map f) ≅ Arrow.mk (G.map f) :=
  Arrow.isoMk (e.app X) (e.app Y) (e.hom.naturality f).symm

/-- Complete source/unit Arrow equalities transport the original curried scalar comparison
without unfolding any actual native functor records. -/
private def transportArrow {F U : C ⥤ D} (T : D ⥤ D) (e : F ≅ U ⋙ T)
    {X Y : C} (f : X ⟶ Y) {A B A' B' : D} (g : A ⟶ B) (u : A' ⟶ B')
    (hF : Arrow.mk (F.map f) = Arrow.mk g) (hU : Arrow.mk (U.map f) = Arrow.mk u) :
    Arrow.mk g ≅ Arrow.mk (T.map u) :=
  (eqToIso hF).symm ≪≫ arrowComparison e f ≪≫ T.mapArrow.mapIso (eqToIso hU)


/-- Read back an already constructed whole Arrow Iso using only its two original Arrow
value equalities; no functor-source unification is needed at the actual native call. -/
private def arrowReadback (T : D ⥤ D) (F U : Arrow D) (e : F ≅ T.mapArrow.obj U)
    {A B A' B' : D} (g : A ⟶ B) (u : A' ⟶ B')
    (hF : F = Arrow.mk g) (hU : U = Arrow.mk u) :
    Arrow.mk g ≅ Arrow.mk (T.map u) :=
  (eqToIso hF).symm ≪≫ e ≪≫ T.mapArrow.mapIso (eqToIso hU)


/-- The whole Arrow of a composite functor is its actual mapped Arrow. -/
private theorem compositeArrow_value (U : C ⥤ D) (T : D ⥤ D) {X Y : C} (f : X ⟶ Y) :
    Arrow.mk ((U ⋙ T).map f) = T.mapArrow.obj (Arrow.mk (U.map f)) := rfl

/-- Give the generic curried comparison its exact mapped-unit Arrow target before any
native source or literal object getter is substituted. -/
private def compositeArrowComparison {F U : C ⥤ D} (T : D ⥤ D) (e : F ≅ U ⋙ T)
    {X Y : C} (f : X ⟶ Y) :
    Arrow.mk (F.map f) ≅ T.mapArrow.obj (Arrow.mk (U.map f)) :=
  arrowComparison e f ≪≫ eqToIso (compositeArrow_value U T f)


/-- The complete represented scalar functor commutes with original fixed-left tensoring.
All constructor values stay abstract before any native spectrum dictionary is selected. -/
private def representedLeftTensorIso [MonoidalCategory D] (A : D) (S : D ⥤ D)
    (e : MonoidalCategory.tensorLeft A ≅ S) (X : D) :
    MonoidalCategory.tensorLeft X ⋙ S ≅ MonoidalCategory.tensorLeft (S.obj X) :=
  Functor.isoWhiskerLeft (MonoidalCategory.tensorLeft X) e.symm ≪≫
    (MonoidalCategory.tensorLeftTensor A X).symm ≪≫
      (MonoidalCategory.tensoringLeft D).mapIso (component e X)


/-- Both original object values of a functor-map Iso are retained through their equalities. -/
private def mapIsoValue (F : C ⥤ D) {A B : C} (e : A ≅ B) {A' B' : D}
    (hA : F.obj A = A') (hB : F.obj B = B') : A' ≅ B' :=
  Eq.mp (congrArg₂ (fun X Y : D => X ≅ Y) hA hB) (F.mapIso e)

/-- The original object scalar Iso and whole represented scalar functor give the exact
literal free-unit Arrow comparison, with all geometry abstracted before native instantiation. -/
private def representedScalarArrowIso [MonoidalCategory D] (R A B : D) (S : D ⥤ D)
    (rep : MonoidalCategory.tensorLeft R ≅ S) (free : A ≅ S.obj B)
    {X Y : D} (f : X ⟶ Y) :
    Arrow.mk (A ◁ f) ≅ Arrow.mk (S.map (B ◁ f)) :=
  arrowComparison
    ((MonoidalCategory.tensoringLeft D).mapIso free ≪≫
      (representedLeftTensorIso R S rep B).symm) f


section RepresentedFamily
universe uV vV uI
variable {V : Type uV} [Category.{vV} V] {I : Type uI}

/-- Instantiate the complete original representation/free-object families before any
coefficient or input Arrow is selected. No weak-class or preservation outcome is an input. -/
private def representedScalarArrowFamily [MonoidalCategory D] (R : V → D) (S : V ⥤ D ⥤ D)
    (rep : ∀ K : V, MonoidalCategory.tensorLeft (R K) ≅ S.obj K)
    (A : I → V → D) (B : I → D)
    (free : ∀ (a : I) (K : V), A a K ≅ (S.obj K).obj (B a)) :
    ∀ (a : I) (K : V) {X Y : D} (f : X ⟶ Y),
      Arrow.mk (A a K ◁ f) ≅ Arrow.mk ((S.obj K).map (B a ◁ f)) :=
  fun a K {X Y} f => representedScalarArrowIso (X := X) (Y := Y) (R K) (A a K) (B a) (S.obj K) (rep K) (free a K) f

/-- Transport the entire original scalar representation family by whole bifunctor equality,
before a coefficient projection or actual native Arrow is selected. -/
private def representationFamilyValueTransport [MonoidalCategory D] (R : V → D)
    {S T : V ⥤ D ⥤ D} (h : S = T)
    (rep : ∀ K : V, MonoidalCategory.tensorLeft (R K) ≅ S.obj K) :
    ∀ K : V, MonoidalCategory.tensorLeft (R K) ≅ T.obj K :=
  Eq.mp (congrArg (fun F : V ⥤ D ⥤ D =>
    ∀ K : V, MonoidalCategory.tensorLeft (R K) ≅ F.obj K) h) rep

end RepresentedFamily

section EnrichedFree
universe uV vV uA
variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V] [BraidedCategory V]
  [MonoidalClosed V] {A : Type uA} [EnrichedCategory V A]
  [MonoidalCategory (EnrichedFunctorCat V A)]

/-- The entire tensor source of an actual enriched free functor keeps its literal free
object value. The constructor is proved at abstract index and tensor structures. -/
private theorem enrichedFreeTensorSource_value (a : A) (K : V) :
    (EnrichedFunctorCat.Free.functor a ⋙ curriedTensor (EnrichedFunctorCat V A)).obj K =
      tensorLeft (EnrichedFunctorCat.Free.object a K) := rfl

/-- The entire original enriched scalar/free-object Arrow family is typed directly on
actual enriched scalar functors, before any native index or coefficient is instantiated. -/
private def enrichedScalarArrowFamily (R : V → EnrichedFunctorCat V A)
    (rep : ∀ K : V, MonoidalCategory.tensorLeft (R K) ≅ EnrichedFunctorCat.tensorLeft K)
    (free : ∀ (a : A) (K : V), EnrichedFunctorCat.Free.object a K ≅
      EnrichedFunctorCat.tensorLeftObject K (EnrichedFunctorCat.Free.object a (𝟙_ V))) :
    ∀ (a : A) (K : V) {X Y : EnrichedFunctorCat V A} (f : X ⟶ Y),
      Arrow.mk (EnrichedFunctorCat.Free.object a K ◁ f) ≅
        Arrow.mk ((EnrichedFunctorCat.tensorLeft K).map
          (EnrichedFunctorCat.Free.object a (𝟙_ V) ◁ f)) :=
  representedScalarArrowFamily R EnrichedFunctorCat.tensorBifunctor rep
    (fun a K => EnrichedFunctorCat.Free.object a K)
    (fun a => EnrichedFunctorCat.Free.object a (𝟙_ V)) free


/-- Build the entire original enriched scalar/free Arrow family from the whole
representation before choosing any coefficient or native input Arrow. -/
private def enrichedScalarArrowFamilyFromWhole (F : V ⥤ EnrichedFunctorCat V A)
    (e : F ⋙ curriedTensor (EnrichedFunctorCat V A) ≅ EnrichedFunctorCat.tensorBifunctor)
    (free : ∀ (a : A) (K : V), EnrichedFunctorCat.Free.object a K ≅
      EnrichedFunctorCat.tensorLeftObject K (EnrichedFunctorCat.Free.object a (𝟙_ V))) :
    ∀ (a : A) (K : V) {X Y : EnrichedFunctorCat V A} (f : X ⟶ Y),
      Arrow.mk (EnrichedFunctorCat.Free.object a K ◁ f) ≅
        Arrow.mk ((EnrichedFunctorCat.tensorLeft K).map
          (EnrichedFunctorCat.Free.object a (𝟙_ V) ◁ f)) :=
  enrichedScalarArrowFamily F.obj (fun K => component e K) free

end EnrichedFree




















