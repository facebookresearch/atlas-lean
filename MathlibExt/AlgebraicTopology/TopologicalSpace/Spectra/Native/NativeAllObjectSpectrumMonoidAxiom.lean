open scoped CGWH.limits





set_option autoImplicit false
noncomputable section
universe u v uC vC

open CategoryTheory MonoidalCategory BraidedCategory
open scoped MonoidalClosed

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

private theorem scalarSuccessorPrefixWord
    {C : Type uC} [Category.{vC} C] [MonoidalCategory C] [BraidedCategory C]
    (K M A H : C) (s : K ⟶ H) :
    (s ▷ (M ⊗ A)) ≫ (β_ (M ⊗ A) H).inv ≫ (α_ M A H).hom =
      (α_ K M A).inv ≫ ((β_ M K).inv ▷ A) ≫ (α_ M K A).hom ≫
        (M ◁ ((s ▷ A) ≫ (β_ A H).inv)) := by
  rw [braiding_tensor_left_inv]
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  rw [associator_inv_naturality_left_assoc]
  rw [← comp_whiskerRight_assoc, braiding_inv_naturality_left]
  rw [comp_whiskerRight]
  simp only [Category.assoc]
  rw [associator_naturality_middle_assoc]
  rw [← whiskerLeft_comp]

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  MonoidalClosed.enrichedCategorySelf

/-- The original pointwise scalar retains the full original left successor map. -/
private theorem scalarTensor_structureMap (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SequentialSpectrum.{u, v}) (c : ℕ) :
    PointedCGWH.SequentialSpectrum.structureMap ((EnrichedFunctorCat.tensorLeft M).obj Y) c =
      (α_ PointedCGWH.sphereOne M (Y.level c)).inv ≫
        ((β_ PointedCGWH.sphereOne M).hom ▷ Y.level c) ≫
        (α_ M PointedCGWH.sphereOne (Y.level c)).hom ≫
        (M ◁ Y.structureMap c) := by
  let i := CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne c
  let j := CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne (c + 1)
  let H := i ⟶[PointedCGWH] j
  let A := Y.level c
  let s := (CategoryTheory.SequentialSpectrum.EnrichedIndex.indexHomSuccessorIso
    PointedCGWH.sphereOne c).inv
  let a := PointedCGWH.SequentialSpectrum.action Y i j
  let p := (s ▷ (M ⊗ A)) ≫ (β_ (M ⊗ A) H).inv
  have hAction := EnrichedFunctorCat.tensorLeftObject_map_uncurry M Y i j
  have hPrefix := scalarSuccessorPrefixWord PointedCGWH.sphereOne M A H s
  have hPrefixSymmetric : p ≫ (α_ M A H).hom =
      (α_ PointedCGWH.sphereOne M A).inv ≫
        ((β_ PointedCGWH.sphereOne M).hom ▷ A) ≫
        (α_ M PointedCGWH.sphereOne A).hom ≫
        (M ◁ ((s ▷ A) ≫ (β_ A H).inv)) := by
    rw [SymmetricCategory.braiding_swap_eq_inv_braiding]
    exact hPrefix
  have h := congrArg (fun f => p ≫ f) hAction
  have h' := congrArg (fun f => f ≫ M ◁ a) hPrefixSymmetric
  have hWord := h.trans ((Category.assoc _ _ _).symm.trans h')
  simp only [p, i, j, H, A, s, a, EnrichedFunctorCat.tensorLeft,
    EnrichedFunctorCat.tensorLeftObject, EnrichedFunctor.tensorLeft_obj,
    PointedCGWH.SequentialSpectrum.structureMap, CategoryTheory.Spectra.Sequential.structureMap,
    PointedCGWH.SequentialSpectrum.action, CategoryTheory.Spectra.Sequential.action,
    PointedCGWH.SequentialSpectrum.level, CategoryTheory.Spectra.Sequential.level,
    CategoryTheory.EnrichedCategory.Hom,
    tensorHom_id, whiskerLeft_comp, Category.assoc] at hWord ⊢
  convert hWord using 1
  rfl

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

