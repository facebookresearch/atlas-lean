private abbrev C := Actual.SymmetricCarrier.{u, v}

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The original arbitrary-endpoint symmetric coproduct theorem supplies
the entire original Omega class coproduct closure, in the native permitted size. -/
private theorem originalOmegaCoproducts : MorphismProperty.IsStableUnderCoproducts.{v}
    (NativeK.omegaTests Actual.symmetricFamily.{u, v}) :=
  { isStableUnderCoproductsOfShape := fun J => MorphismProperty.IsStableUnderCoproductsOfShape.mk _ J
      (fun _ _ _ _ f hf => OriginalHEPOmegaClosure.originalCoproductMap_omegaTests f hf) }

/-- The same natural transformation comparison passes the caller's actual
HEP pushout, through the two whole preserved squares and four original naturalities. -/
private theorem comparison_of_pushout {P Q : C.{u, v} ⥤ C.{u, v}} (α : P ⟶ Q)
    [PreservesColimitsOfShape WalkingSpan P] [PreservesColimitsOfShape WalkingSpan Q]
    (hP : ∀ {A X : C.{u, v}} (i : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    (hQ : ∀ {A X : C.{u, v}} (i : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i))
    {A X Z R : C.{u, v}} (i : A ⟶ X) (z : A ⟶ Z) (kX : X ⟶ R) (kZ : Z ⟶ R)
    (sq : IsPushout i z kX kZ) (hi : PointedCGWH.EnrichedBasedHomotopyExtension.property i)
    (hA : NativeK.omegaTests Actual.symmetricFamily (α.app A))
    (hX : NativeK.omegaTests Actual.symmetricFamily (α.app X))
    (hZ : NativeK.omegaTests Actual.symmetricFamily (α.app Z)) :
    NativeK.omegaTests Actual.symmetricFamily (α.app R) :=
  OriginalHEPOmegaClosure.originalHEPPushoutComparison_omegaTests
    (P.map i) (P.map z) (P.map kX) (P.map kZ)
    (Q.map i) (Q.map z) (Q.map kX) (Q.map kZ) (sq.map P) (sq.map Q) (hP i hi) (hQ i hi)
    (α.app A) (α.app X) (α.app Z) (α.app R)
    (α.naturality i).symm (α.naturality z).symm
    (α.naturality kX).symm (α.naturality kZ).symm hA hX hZ

/-- Both genuine original free I-generator coefficients are cofibrant.
Their free-object comparison tests imply the same whole caller generator endpoints. -/
private theorem original_levelI_comparison_endpoints
    {P Q : C.{u, v} ⥤ C.{u, v}} (α : P ⟶ Q)
    (hFree : ∀ (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
      (M : PointedCGWH.{u, v}) [IsCofibrant M],
      NativeK.omegaTests Actual.symmetricFamily (α.app (Free.object a M)))
    {A X : C.{u, v}} (i : A ⟶ X) (hi : NativeK.levelI i) :
    NativeK.omegaTests Actual.symmetricFamily (α.app A) ∧
      NativeK.omegaTests Actual.symmetricFamily (α.app X) := by
  obtain ⟨q, hq⟩ := (MorphismProperty.adjointFamilyGenerators_iff
    (fun a : PointedCGWH.SymmetricOperatorIndex.{u, v} =>
      Free.functor (V := PointedCGWH.{u, v}) a) PointedCGWH.realizedBoundaryInclusions i).mp hi
  have hCoef := NativeK.pointedBoundary_endpoints q.2.1.hom q.2.2
  let _ : IsCofibrant q.2.1.left := hCoef.1
  let _ : IsCofibrant q.2.1.right := hCoef.2
  have hA := congrArg (fun g => g.left) hq
  have hX := congrArg (fun g => g.right) hq
  change A = (Free.functor q.1).obj q.2.1.left at hA
  change X = (Free.functor q.1).obj q.2.1.right at hX
  rw [hA, hX]
  exact ⟨hFree q.1 q.2.1.left, hFree q.1 q.2.1.right⟩

/-- The original symmetric I-cell history passes every Omega comparison
test using only its free coefficient endpoints and the proved genuine weak closures.
The actual natural transformation, all ordinal maps and caller endpoint are retained. -/
private theorem comparison_of_originalICells
    {P Q : C.{u, v} ⥤ C.{u, v}} (α : P ⟶ Q)
    [PreservesColimitsOfSize.{v, v} P] [PreservesColimitsOfSize.{v, v} Q]
    [PreservesColimitsOfShape WalkingSpan P] [PreservesColimitsOfShape WalkingSpan Q]
    {J : Type w} [Small.{v} J] [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P] [PreservesColimitsOfSize.{w, w} Q]
    (hP : ∀ {A X : C.{u, v}} (i : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    (hQ : ∀ {A X : C.{u, v}} (i : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i))
    (hFree : ∀ (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
      (M : PointedCGWH.{u, v}) [IsCofibrant M],
      NativeK.omegaTests Actual.symmetricFamily (α.app (Free.object a M)))
    {X Y : C.{u, v}} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v}
      (fun (_ : J) => (NativeK.levelI (I := PointedCGWH.SymmetricOperatorIndex.{u, v})).homFamily) f)
    (hX : NativeK.omegaTests Actual.symmetricFamily (α.app X)) :
    NativeK.omegaTests Actual.symmetricFamily (α.app Y) := by
  let _ := originalOmegaCoproducts.{u, v} (B := B)
  exact PointedCGWH.Spectra.OriginalRelativeCellComparison.comparison_of_relativeICells
    Actual.symmetricFamily α hP hQ (original_levelI_comparison_endpoints α hFree)
    (comparison_of_pushout α hP hQ) c hX






end PointedCGWH.Spectra.Symmetric.OriginalRelativeCellComparison
end

