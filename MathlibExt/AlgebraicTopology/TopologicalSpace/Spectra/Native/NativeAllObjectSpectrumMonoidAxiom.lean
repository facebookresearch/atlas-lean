/-- The original finite inverse leg uses exactly the normalized original generator at c+n. -/
private theorem finiteNativeLeg_normalized_generator (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    finiteNativeLeg c n M Y i =
      normalizedCoefficientFirstGenerator n (c + n) c (by omega)
        (Nat.add_sub_cancel_right c n) M Y (orbitRepresentative c n i) ≫
      (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
        n (c + n) c (by omega) (Nat.add_sub_cancel_right c n) M Y).inv :=
  finiteNativeLeg_normalized c n M Y i

/-- The normalized original card block at c+n is the same original finite orbit block. -/
private theorem normalizedOriginalCardBlock_at_sum (c n : ℕ) (i : OrbitIndex c n) :
    normalizedOriginalCardBlock n (c + n) c (by omega) (Nat.add_sub_cancel_right c n)
        (orbitRepresentative c n i) =
      CostructuredArrow.mk (originalOrbitBlockIso c n i).hom := rfl

/-- The actual original finite inverse orbit leg is the coefficient-first Day leg at the same block. -/
private theorem finiteNativeLeg_day (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    finiteNativeLeg c n M Y i ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n))).hom =
      coefficientFirstDayLeg n M Y c (originalOrbitBlockIso c n i) := by
  let l := normalizedCoefficientFirstGenerator n (c + n) c (by omega)
    (Nat.add_sub_cancel_right c n) M Y (orbitRepresentative c n i)
  let o :=
    PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
      n (c + n) c (by omega) (Nat.add_sub_cancel_right c n) M Y
  let d := PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n))
  have h₁ := congrArg (fun f => f ≫ d.hom) (finiteNativeLeg_normalized_generator c n M Y i)
  have h₂ := Category.assoc l o.inv d.hom
  have h₃ := normalizedCardInverse_day_generator n (c + n) c (by omega)
    (Nat.add_sub_cancel_right c n) M Y (orbitRepresentative c n i)
  have h₄ := congrArg (fun b => b ≫
    representedTensorGenerator Y.X (card n) (card (c + n)) M
      (CostructuredArrow.mk (originalOrbitBlockIso c n i).hom))
    (SymmetricCategory.braiding_swap_eq_inv_braiding (Y.X.functor.obj (card c)) M).symm
  exact h₁.trans (h₂.trans (h₃.trans h₄))

/-- Every original free-smash input arrow satisfies the actual finite orbit square. -/
private theorem actualFiniteInputSquare (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) : FiniteInputSquare n M f :=
  finiteInputSquare_of_originalDayLegs n M (fun c i => originalOrbitBlockIso c n i)
    (fun Y c i => finiteNativeLeg_day c n M Y i) f

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
