namespace PointedCGWH.Spectra.OriginalRelativeCellComparison

variable {I L : Type} [EnrichedCategory PointedCGWH.{u, v} I]

private abbrev Carrier := EnrichedFunctorCat PointedCGWH.{u, v} I

/-- The complete Arrow comparison of an object isomorphism retains both mapped
isomorphisms and the original naturality square. -/
private def comparisonArrowIso {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    {X Y : Carrier (I := I)} (e : X ≅ Y) : Arrow.mk (α.app X) ≅ Arrow.mk (α.app Y) :=
  Arrow.isoMk (P.mapIso e) (Q.mapIso e) (α.naturality e.hom)

/-- Every whole object retract gives the whole original transformation Arrow
retract, including both source and target splitting equations. -/
private def comparisonRetract {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    {X Y : Carrier (I := I)} (r : Retract X Y) : RetractArrow (α.app X) (α.app Y) where
  i := Arrow.homMk (P.map r.i) (Q.map r.i) (α.naturality r.i)
  r := Arrow.homMk (P.map r.r) (Q.map r.r) (α.naturality r.r)
  retract := by
    apply Arrow.hom_ext
    · change P.map r.i ≫ P.map r.r = 𝟙 (P.obj X)
      rw [← P.map_comp, r.retract, P.map_id]
    · change Q.map r.i ≫ Q.map r.r = 𝟙 (Q.obj X)
      rw [← Q.map_comp, r.retract, Q.map_id]

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The real caller cofan passes every original Omega test when its component
comparisons do. Both whole mapped cofans and the original comparison Arrow are used. -/
private theorem comparison_of_cofan (s : NativeStabilizationFamily.{u, v} I L)
    [(NativeK.omegaTests s).IsStableUnderCoproducts.{v}]
    {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    [PreservesColimitsOfSize.{v, v} P] [PreservesColimitsOfSize.{v, v} Q]
    {J : Type v} (X : J → Carrier (I := I)) (c : Cofan X) (hc : IsColimit c)
    (hα : ∀ j, NativeK.omegaTests s (α.app (X j))) : NativeK.omegaTests s (α.app c.pt) := by
  apply MorphismProperty.colimitsOfShape_le (W := NativeK.omegaTests s) (J := Discrete J)
  exact MorphismProperty.colimitsOfShape.mk' _ _ (P.mapCocone c) (Q.mapCocone c)
    (isColimitOfPreserves P hc) (isColimitOfPreserves Q hc)
    (Functor.whiskerLeft (Discrete.functor X) α) (fun j => hα j.as) (α.app c.pt)
    (fun j => α.naturality (c.ι.app j))

/-- Both actual preserved ordinal cocones retain every original stage and
leg equation. Genuine HEP of both image histories supplies the complete comparison. -/
private theorem comparison_of_HEPOrdinalCocone (s : NativeStabilizationFamily.{u, v} I L)
    {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    {J : Type w} [Small.{v} J] [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P] [PreservesColimitsOfSize.{w, w} Q]
    (F : J ⥤ Carrier (I := I)) [F.IsWellOrderContinuous]
    (hP : ∀ j, ¬IsMax j → PointedCGWH.EnrichedBasedHomotopyExtension.property
      (P.map (F.map (homOfLE (Order.le_succ j)))))
    (hQ : ∀ j, ¬IsMax j → PointedCGWH.EnrichedBasedHomotopyExtension.property
      (Q.map (F.map (homOfLE (Order.le_succ j)))))
    (c : Cocone F) (hc : IsColimit c)
    (hα : ∀ j, NativeK.omegaTests s (α.app (F.obj j))) :
    NativeK.omegaTests s (α.app c.pt) := by
  let _ : PreservesWellOrderContinuousOfShape J P :=
    { preservesColimitsOfShape := fun _ _ => by infer_instance }
  let _ : PreservesWellOrderContinuousOfShape J Q :=
    { preservesColimitsOfShape := fun _ _ => by infer_instance }
  exact StableHEPOrdinalWeakComparison.originalHEPOrdinalSmallComparison_omegaTests s
    (F ⋙ P) (F ⋙ Q) (Functor.whiskerLeft F α) hP hQ hα
    (P.mapCocone c) (Q.mapCocone c) (isColimitOfPreserves P hc) (isColimitOfPreserves Q hc)
    (α.app c.pt) (fun j => α.naturality (c.ι.app j))

/-- The exact original free-I cell history passes the comparison tests from
its generator endpoints to the caller endpoint. Successor cofans, all native cell
labels, the caller bottom isomorphism, every limit cocone and both image histories
remain the original ones. There is no all-cofibrant comparison hypothesis. -/
private theorem comparison_of_relativeICells (s : NativeStabilizationFamily.{u, v} I L)
    [(NativeK.omegaTests s).IsStableUnderCoproducts.{v}]
    {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    [PreservesColimitsOfSize.{v, v} P] [PreservesColimitsOfSize.{v, v} Q]
    {J : Type w} [Small.{v} J] [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P] [PreservesColimitsOfSize.{w, w} Q]
    (hP : ∀ {A X : Carrier (I := I)} (i : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    (hQ : ∀ {A X : Carrier (I := I)} (i : A ⟶ X),
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i))
    (hCells : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      NativeK.omegaTests s (α.app A) ∧ NativeK.omegaTests s (α.app X))
    (hPush : ∀ {A X Z R : Carrier (I := I)} (i : A ⟶ X) (z : A ⟶ Z)
      (kX : X ⟶ R) (kZ : Z ⟶ R), IsPushout i z kX kZ →
      PointedCGWH.EnrichedBasedHomotopyExtension.property i →
      NativeK.omegaTests s (α.app A) → NativeK.omegaTests s (α.app X) →
      NativeK.omegaTests s (α.app Z) → NativeK.omegaTests s (α.app R))
    {X Y : Carrier (I := I)} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v} (fun (_ : J) => (NativeK.levelI (I := I)).homFamily) f)
    (hX : NativeK.omegaTests s (α.app X)) : NativeK.omegaTests s (α.app Y) := by
  let W := NativeK.omegaTests s
  let T : MorphismProperty (Carrier (I := I)) := PointedCGWH.EnrichedBasedHomotopyExtension.property
  let _ : HasColimitsOfSize.{v, v} PointedCGWH.{u, v} :=
    HomotopicalAlgebra.EnrichedProjective.Native.nativeColimits
  let _ : HasLimitsOfSize.{v, v} PointedCGWH.{u, v} := by
    change HasLimitsOfSize.{v, v} (Under CGWH.point.{u, v})
    infer_instance
  let _ : c.F.IsWellOrderContinuous := c.isWellOrderContinuous
  have hBasic : NativeK.levelI (I := I) ≤ T := by
    intro A Z i hi
    exact OriginalContinuousSourceApproximation.originalNativeILeft_le_HEP i
      ((NativeK.levelI (I := I)).le_llp_rlp i hi)
  let tr := c.transfiniteCompositionOfShape' (I := T) (fun cell => hBasic _ cell.i.2)
  have hClosure : (MorphismProperty.coproducts.{v} T).pushouts ≤ T :=
    (MorphismProperty.pushouts_monotone (MorphismProperty.coproducts_le T)).trans
      MorphismProperty.pushouts_le
  let th := tr.ofLE hClosure
  let _ : T.IsStableUnderTransfiniteComposition.{v} := by
    dsimp only [T]
    rw [Orthogonal.OriginalIClosedHomotopyExtension.nativeHEP_eq_llp]
    infer_instance
  let _ : T.IsStableUnderTransfiniteComposition.{w} := by
    dsimp only [T]
    rw [Orthogonal.OriginalIClosedHomotopyExtension.nativeHEP_eq_llp]
    infer_instance
  have hAllMaps : ∀ {i k : J} (g : i ⟶ k), T (c.F.map g) := fun g => th.mem_map g
  have hStages : ∀ k, W (α.app (c.F.obj k)) := by
    intro k
    induction k using SuccOrder.limitRecOn with
    | isMin k hk =>
      obtain rfl := hk.eq_bot
      exact (W.arrow_mk_iso_iff (comparisonArrowIso α c.isoBot)).mpr hX
    | succ k hk ih =>
      let a := c.attachCells k hk
      let sources : a.ι → Carrier (I := I) := fun t => (a.π t).1.left
      let targets : a.ι → Carrier (I := I) := fun t => (a.π t).1.right
      have hSources : W (α.app a.cofan₁.pt) := comparison_of_cofan s α sources
        a.cofan₁ a.isColimit₁ (fun t => (hCells (a.π t).1.hom (a.π t).2).1)
      have hTargets : W (α.app a.cofan₂.pt) := comparison_of_cofan s α targets
        a.cofan₂ a.isColimit₂ (fun t => (hCells (a.π t).1.hom (a.π t).2).2)
      have hm : MorphismProperty.coproducts.{v} T a.m :=
        MorphismProperty.colimitsOfShape_le_coproducts T a.ι a.m
          (MorphismProperty.colimitsOfShape.mk' (W := T) _ _ a.cofan₁ a.cofan₂
            a.isColimit₁ a.isColimit₂ (Discrete.natTrans (fun t => (a.π t.as).1.hom))
            (fun t => hBasic _ (a.π t.as).2) a.m (fun t => a.hm t.as))
      exact hPush a.m a.g₁ a.g₂ (c.F.map (homOfLE (Order.le_succ k))) a.isPushout.flip
        (MorphismProperty.coproducts_le T a.m hm) hSources hTargets ih
    | isSuccLimit k hk ih =>
      let _ : OrderBot (Set.Iio k) := { bot := ⟨⊥, hk.bot_lt⟩, bot_le t := bot_le }
      let _ : SuccOrder (Set.Iio k) := SuccOrder.ofLinearWellFoundedLT (Set.Iio k)
      let F := (Set.principalSegIio k).monotone.functor ⋙ c.F
      let _ : F.IsWellOrderContinuous :=
        inferInstanceAs
          (((Set.principalSegIio k : Set.Iio k ≤i J)).monotone.functor ⋙ c.F).IsWellOrderContinuous
      exact comparison_of_HEPOrdinalCocone s α F
        (fun t _ => hP _ (hAllMaps ((Set.principalSegIio k).monotone.functor.map
          (homOfLE (Order.le_succ t)))))
        (fun t _ => hQ _ (hAllMaps ((Set.principalSegIio k).monotone.functor.map
          (homOfLE (Order.le_succ t)))))
        ((Set.principalSegIio k).cocone c.F) (c.F.isColimitOfIsWellOrderContinuous k hk)
        (fun t => ih t.1 t.2)
  exact comparison_of_HEPOrdinalCocone s α c.F
    (fun k hk => hP _ (th.map_mem k hk)) (fun k hk => hQ _ (th.map_mem k hk))
    (⟨Y, c.incl⟩ : Cocone c.F) c.isColimit hStages

/-- Every original whole object retract keeps its original transformation test. -/
private theorem comparison_of_retract (s : NativeStabilizationFamily.{u, v} I L)
    {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    {X Y : Carrier (I := I)} (r : Retract X Y) (hY : NativeK.omegaTests s (α.app Y)) :
    NativeK.omegaTests s (α.app X) :=
  MorphismProperty.of_retract (comparisonRetract α r) hY








end PointedCGWH.Spectra.OriginalRelativeCellComparison
end

