/-- Every original free source and every arbitrary Y have the actual interval tensor Iso. -/
private def tensorIntervalFreeIso (r : OrthogonalIndex) (Y : Carrier.{u, v})
    (M : PointedCGWH.{u, v}) :
    tensorLeftObject PointedCGWH.IntervalCoefficient.interval
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≅
      tensorLeftObject PointedCGWH.IntervalCoefficient.interval
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⊗ Y :=
