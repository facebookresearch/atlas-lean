/-!
## Smash of the original actual spectrum quotient

The actual closed sphere smash carries the caller's original quotient
pushout to a pushout. Its zero-tensor object is compared with the unchanged
native zero by the original initial universal maps. Both the original
target leg and the complete zero leg remain explicit.

These statements use every original arrow and arbitrary right tensor
factor. No cofibrancy, Omega, or basepoint premise is imposed on that factor
or on either endpoint of the original arrow.
-/

set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory CategoryTheory.Limits CategoryTheory.EnrichedFunctorCat MonoidalCategory
open HomotopicalAlgebra.EnrichedProjective.Native
open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK
open scoped MonoidalClosed CGWH.modelCategory

namespace PointedCGWH.Spectra.CurrentSmashQuotientRequired

open PointedCGWH.Spectra.CurrentCofiberQuotient

section OriginalTensorQuotient

universe uC vC
variable {C : Type uC} [Category.{vC} C] [MonoidalCategory C] [BraidedCategory C]
  [MonoidalClosed C]

private theorem originalTensorRight_preservesColimits (Y : C) : PreservesColimits (tensorRight Y) :=
  ((ihom.adjunction Y).ofNatIsoLeft (BraidedCategory.tensorLeftIsoTensorRight Y)).leftAdjoint_preservesColimits

attribute [local instance] originalTensorRight_preservesColimits

/-- Both original initial universal maps identify the actual right tensor of zero with that same zero. -/
private def zeroTensorRightIso (Z0 : C) (h0 : IsZero Z0) (Y : C) : Z0 ⊗ Y ≅ Z0 :=
  (h0.isInitial.isInitialObj (tensorRight Y) Z0).coconePointUniqueUpToIso h0.isInitial

/-- The original source collapse followed by the zero-tensor comparison is the unchanged target collapse. -/
private theorem zeroTensorRightIso_collapse (Z0 : C) (h0 : IsZero Z0) (Y : C)
    {A : C} (a0 : A ⟶ Z0) (aY0 : A ⊗ Y ⟶ Z0) :
    (a0 ▷ Y) ≫ (zeroTensorRightIso Z0 h0 Y).hom = aY0 :=
  h0.isTerminal.hom_ext _ _

/-- The original caller zero leg retains the full inverse zero-tensor comparison and actual tensor map. -/
private def rightTensorQuotientZero (Z0 : C) (h0 : IsZero Z0) (Y : C) {Z : C} (q0 : Z0 ⟶ Z) :
    Z0 ⟶ Z ⊗ Y := (zeroTensorRightIso Z0 h0 Y).inv ≫ q0 ▷ Y

/-- The zero-tensor forward comparison recovers exactly the original right tensor of the zero leg. -/
@[reassoc]
private theorem zeroTensorRightIso_quotientZero (Z0 : C) (h0 : IsZero Z0) (Y : C)
    {Z : C} (q0 : Z0 ⟶ Z) :
    (zeroTensorRightIso Z0 h0 Y).hom ≫ rightTensorQuotientZero Z0 h0 Y q0 = q0 ▷ Y := by
  rw [rightTensorQuotientZero, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]

/-- The actual right-tensor functor preserves the original quotient cocone and its unchanged zero. -/
private theorem rightTensorQuotient_isPushout (Z0 : C) (h0 : IsZero Z0) (Y : C)
    {A X Z : C} (i : A ⟶ X) (a0 : A ⟶ Z0) (qX : X ⟶ Z) (q0 : Z0 ⟶ Z)
    (sq : IsPushout i a0 qX q0) (aY0 : A ⊗ Y ⟶ Z0) :
    IsPushout (i ▷ Y) aY0 (qX ▷ Y) (rightTensorQuotientZero Z0 h0 Y q0) := by
  have hBottom : IsPushout (q0 ▷ Y) (zeroTensorRightIso Z0 h0 Y).hom
      (𝟙 (Z ⊗ Y)) (rightTensorQuotientZero Z0 h0 Y q0) := by
    apply IsPushout.of_vert_isIso
    refine ⟨?_⟩
    rw [Category.comp_id, zeroTensorRightIso_quotientZero]
  have h := (sq.map (tensorRight Y)).paste_vert hBottom
  change IsPushout (i ▷ Y) ((a0 ▷ Y) ≫ (zeroTensorRightIso Z0 h0 Y).hom)
    ((qX ▷ Y) ≫ 𝟙 (Z ⊗ Y)) (rightTensorQuotientZero Z0 h0 Y q0) at h
  simpa only [Category.comp_id, zeroTensorRightIso_collapse Z0 h0 Y a0 aY0] using h

end OriginalTensorQuotient

section ActualSymmetricSmash

attribute [local instance] PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.symmetricCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalClosed

private instance symmetricNativeZero : HasZeroObject Actual.SymmetricCarrier.{u, v} :=
  Diagrams.nativeHasZeroObject

/-- The actual ordinary symmetric sphere smash of the unchanged zero has both original zero maps. -/
def symmetricZeroRightSmashIso (Y : Actual.SymmetricCarrier.{u, v}) :
    Diagrams.zeroDiagram ⊗ Y ≅ Diagrams.zeroDiagram :=
  zeroTensorRightIso Diagrams.zeroDiagram Diagrams.zeroDiagram_isZero Y

/-- The actual symmetric zero-to-quotient smash leg retains the original chosen zero comparison. -/
private def symmetricSmashQuotientZero (Y : Actual.SymmetricCarrier.{u, v})
    {Z : Actual.SymmetricCarrier.{u, v}} (q0 : Diagrams.zeroDiagram ⟶ Z) :
    Diagrams.zeroDiagram ⟶ Z ⊗ Y :=
  (symmetricZeroRightSmashIso Y).inv ≫ q0 ▷ Y

/-- Actual symmetric smash preserves every original caller quotient square, for arbitrary Y. -/
theorem symmetricSmashQuotient_isPushout
    {A X Z : Actual.SymmetricCarrier.{u, v}} (i : A ⟶ X)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (Y : Actual.SymmetricCarrier.{u, v}) :
    IsPushout (i ▷ Y) (Diagrams.toZero (A ⊗ Y)) (qX ▷ Y) (symmetricSmashQuotientZero Y q0) :=
  rightTensorQuotient_isPushout Diagrams.zeroDiagram Diagrams.zeroDiagram_isZero Y
    i (Diagrams.toZero A) qX q0 sq (Diagrams.toZero (A ⊗ Y))

/-- Both actual symmetric quotient colimit witnesses construct the complete smash-quotient isomorphism. -/
def symmetricRightSmashQuotientIso (F : Arrow Actual.SymmetricCarrier.{u, v})
    (Y : Actual.SymmetricCarrier.{u, v}) :
    quotient (Arrow.mk (F.hom ▷ Y)) ≅ quotient F ⊗ Y :=
  (quotient_isPushout (Arrow.mk (F.hom ▷ Y))).isoIsPushout _ _
    (symmetricSmashQuotient_isPushout F.hom (quotientTarget F) (quotientZero F) (quotient_isPushout F) Y)

/-- The entire actual target leg is the original smash of the original quotient target map. -/
@[reassoc]
theorem symmetricRightSmashQuotientIso_target (F : Arrow Actual.SymmetricCarrier.{u, v})
    (Y : Actual.SymmetricCarrier.{u, v}) :
    quotientTarget (Arrow.mk (F.hom ▷ Y)) ≫ (symmetricRightSmashQuotientIso F Y).hom =
      quotientTarget F ▷ Y :=
  (quotient_isPushout (Arrow.mk (F.hom ▷ Y))).inl_isoIsPushout_hom _ _
    (symmetricSmashQuotient_isPushout F.hom (quotientTarget F) (quotientZero F) (quotient_isPushout F) Y)

/-- The entire actual zero leg keeps the inverse original zero-smash map and original quotient zero map. -/
@[reassoc]
theorem symmetricRightSmashQuotientIso_zero (F : Arrow Actual.SymmetricCarrier.{u, v})
    (Y : Actual.SymmetricCarrier.{u, v}) :
    quotientZero (Arrow.mk (F.hom ▷ Y)) ≫ (symmetricRightSmashQuotientIso F Y).hom =
      (symmetricZeroRightSmashIso Y).inv ≫ quotientZero F ▷ Y :=
  (quotient_isPushout (Arrow.mk (F.hom ▷ Y))).inr_isoIsPushout_hom _ _
    (symmetricSmashQuotient_isPushout F.hom (quotientTarget F) (quotientZero F) (quotient_isPushout F) Y)

/-- The full inverse returns the original target leg of the actual smashed arrow quotient. -/
@[reassoc]
private theorem symmetricRightSmashQuotientIso_inv_target (F : Arrow Actual.SymmetricCarrier.{u, v})
    (Y : Actual.SymmetricCarrier.{u, v}) :
    (quotientTarget F ▷ Y) ≫ (symmetricRightSmashQuotientIso F Y).inv =
      quotientTarget (Arrow.mk (F.hom ▷ Y)) := by
  rw [← symmetricRightSmashQuotientIso_target, Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- The full inverse returns the same original zero leg of the actual smashed arrow quotient. -/
@[reassoc]
private theorem symmetricRightSmashQuotientIso_inv_zero (F : Arrow Actual.SymmetricCarrier.{u, v})
    (Y : Actual.SymmetricCarrier.{u, v}) :
    ((symmetricZeroRightSmashIso Y).inv ≫ quotientZero F ▷ Y) ≫
        (symmetricRightSmashQuotientIso F Y).inv = quotientZero (Arrow.mk (F.hom ▷ Y)) := by
  rw [← symmetricRightSmashQuotientIso_zero, Category.assoc, Iso.hom_inv_id, Category.comp_id]

end ActualSymmetricSmash

section ActualOrthogonalSmash

attribute [local instance] PointedCGWH.Spectra.Orthogonal.CanonicalSourceSmash.monoidalCategory
  PointedCGWH.Spectra.Orthogonal.CanonicalSourceSmash.symmetricCategory
  PointedCGWH.Spectra.Orthogonal.CanonicalSourceSmashClosed.monoidalClosed

private instance orthogonalNativeZero : HasZeroObject Actual.OrthogonalCarrier.{u, v} :=
  Diagrams.nativeHasZeroObject

/-- The original native orthogonal closed sphere smash identifies its unchanged zero tensor by actual maps. -/
private def orthogonalZeroRightSmashIso (Y : Actual.OrthogonalCarrier.{u, v}) :
    Diagrams.zeroDiagram ⊗ Y ≅ Diagrams.zeroDiagram :=
  zeroTensorRightIso Diagrams.zeroDiagram Diagrams.zeroDiagram_isZero Y

/-- The actual orthogonal zero-to-quotient smash leg retains the complete original zero-smash inverse. -/
private def orthogonalSmashQuotientZero (Y : Actual.OrthogonalCarrier.{u, v})
    {Z : Actual.OrthogonalCarrier.{u, v}} (q0 : Diagrams.zeroDiagram ⟶ Z) :
    Diagrams.zeroDiagram ⟶ Z ⊗ Y :=
  (orthogonalZeroRightSmashIso Y).inv ≫ q0 ▷ Y

/-- Actual orthogonal smash preserves the caller's original quotient square at arbitrary Y. -/
private theorem orthogonalSmashQuotient_isPushout
    {A X Z : Actual.OrthogonalCarrier.{u, v}} (i : A ⟶ X)
    (qX : X ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout i (Diagrams.toZero A) qX q0) (Y : Actual.OrthogonalCarrier.{u, v}) :
    IsPushout (i ▷ Y) (Diagrams.toZero (A ⊗ Y)) (qX ▷ Y) (orthogonalSmashQuotientZero Y q0) :=
  rightTensorQuotient_isPushout Diagrams.zeroDiagram Diagrams.zeroDiagram_isZero Y
    i (Diagrams.toZero A) qX q0 sq (Diagrams.toZero (A ⊗ Y))

/-- Both original native colimit witnesses give the complete actual orthogonal smash-quotient isomorphism. -/
private def orthogonalRightSmashQuotientIso (F : Arrow Actual.OrthogonalCarrier.{u, v})
    (Y : Actual.OrthogonalCarrier.{u, v}) :
    quotient (Arrow.mk (F.hom ▷ Y)) ≅ quotient F ⊗ Y :=
  (quotient_isPushout (Arrow.mk (F.hom ▷ Y))).isoIsPushout _ _
    (orthogonalSmashQuotient_isPushout F.hom (quotientTarget F) (quotientZero F) (quotient_isPushout F) Y)


