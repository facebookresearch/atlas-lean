private theorem originalRightTensorMap_level (r : I) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (q : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap
        (underlyingSequential.map (RightTensorSource.nativeRightTensorIso r M Y).hom) q =
      (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso r M Y (card q)).hom := by
  let f := (RightTensorSource.nativeRightTensorIso r M Y).hom
  let e := component f (PointedCGWH.symmetricOperatorObj.{u, v} (card q))
  have h₁ : e = (RightTensorSource.nativeRightTensorLevelIso r M Y (card q)).hom :=
    (OriginalNativeDayComponentGetter.rightTensorLevel_hom_component r M Y (card q)).symm
  have h₂ := congrArg Iso.hom (RightTensorSource.nativeRightTensorLevelIso_original r M Y (card q))
  exact (underlying_map f q).trans (h₁.trans h₂)

private theorem originalDayStructureSquare (r : I) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (q : ℕ) :
    (PointedCGWH.sphereOne ◁ (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso r M Y (card q)).hom) ≫
        (originalRightTensorRestriction r M Y).structureMap q =
      (underlyingSequential.obj ((PointedCGWH.SymmetricSpectrum.freeSmash r M).obj Y)).structureMap q ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso r M Y (card (q + 1))).hom := by
  let f := underlyingSequential.map (RightTensorSource.nativeRightTensorIso r M Y).hom
  let l := PointedCGWH.SequentialSpectrum.levelMap f q
  let l' := PointedCGWH.SequentialSpectrum.levelMap f (q + 1)
  let s := (underlyingSequential.obj ((PointedCGWH.SymmetricSpectrum.freeSmash r M).obj Y)).structureMap q
  let t := (originalRightTensorRestriction r M Y).structureMap q
  have h : (PointedCGWH.sphereOne ◁ l) ≫ t = s ≫ l' :=
    CategoryTheory.Spectra.Sequential.structureMap_naturality f q
  have h₁ := congrArg (fun a => (PointedCGWH.sphereOne ◁ a) ≫ t)
    (originalRightTensorMap_level r M Y q).symm
  have h₂ := congrArg (fun a => s ≫ a) (originalRightTensorMap_level r M Y (q + 1))
  exact h₁.trans (h.trans h₂)

