/-- Both physical endpoints retain the exact original interval inclusions after right smash. -/
private theorem tensorIntervalFreeIso_endpoint (r : OrthogonalIndex) (Y : Carrier.{u, v})
    (M : PointedCGWH.{u, v}) (i : Fin 2) :
    pointMap (PointedCGWH.IntervalCoefficient.endpoint i)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≫
        (tensorIntervalFreeIso r Y M).hom =
      pointMap (PointedCGWH.IntervalCoefficient.endpoint i)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ▷ Y :=
  tensorTimeFreeIso_point r Y (PointedCGWH.IntervalCoefficient.endpoint i) M

/-- Right smash of an original free-source physical homotopy is an actual native interval map. -/
private def rightSmashFreeHomotopy (r : OrthogonalIndex) (M : PointedCGWH.{u, v})
    (Y : Carrier.{u, v}) {Z : Carrier.{u, v}}
    (H : tensorLeftObject PointedCGWH.IntervalCoefficient.interval
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z) :
    tensorLeftObject PointedCGWH.IntervalCoefficient.interval
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ⟶ Z ⊗ Y :=
  (tensorIntervalFreeIso r Y M).hom ≫ H ▷ Y

/-- Every original physical endpoint of the same H is preserved by the original right smash. -/
private theorem rightSmashFreeHomotopy_endpoint (r : OrthogonalIndex) (M : PointedCGWH.{u, v})
    (Y : Carrier.{u, v}) {Z : Carrier.{u, v}}
    (H : tensorLeftObject PointedCGWH.IntervalCoefficient.interval
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z) (i : Fin 2) :
    pointMap (PointedCGWH.IntervalCoefficient.endpoint i)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≫
        rightSmashFreeHomotopy r M Y H =
      (pointMap (PointedCGWH.IntervalCoefficient.endpoint i)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H) ▷ Y := by
  rw [rightSmashFreeHomotopy, ← Category.assoc, tensorIntervalFreeIso_endpoint,
    ← comp_whiskerRight]

/-- Both complete original endpoints of an actual homotopy survive with arbitrary Y and Z. -/
private theorem rightSmashFreeHomotopy_two_endpoints
    (r : OrthogonalIndex) (M : PointedCGWH.{u, v}) (Y : Carrier.{u, v})
    {Z : Carrier.{u, v}}
    (f₀ f₁ : Free.object (OrthogonalOperatorIndex.ofIndex r) M ⟶ Z)
    (H : tensorLeftObject PointedCGWH.IntervalCoefficient.interval
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z)
    (h₀ : pointMap (PointedCGWH.IntervalCoefficient.endpoint 0)
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₀)
    (h₁ : pointMap (PointedCGWH.IntervalCoefficient.endpoint 1)
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₁) :
    pointMap (PointedCGWH.IntervalCoefficient.endpoint 0)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≫
        rightSmashFreeHomotopy r M Y H = f₀ ▷ Y ∧
      pointMap (PointedCGWH.IntervalCoefficient.endpoint 1)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ≫
        rightSmashFreeHomotopy r M Y H = f₁ ▷ Y := by
  exact ⟨(rightSmashFreeHomotopy_endpoint r M Y H 0).trans
      (congrArg (fun f => f ▷ Y) h₀),
    (rightSmashFreeHomotopy_endpoint r M Y H 1).trans
      (congrArg (fun f => f ▷ Y) h₁)⟩







end PointedCGWH.Spectra.OriginalFreeSmashPhysical

