/-!
## Compatible finite orbits of the original symmetric free smash

The actual complement subgroup fixes the final free block pointwise. Its
orbits are ordered embeddings of that block, and explicit successive swaps
choose representatives. Prefixing a new label gives the same representative
by extension, including the empty free block.
-/

set_option autoImplicit false
open scoped BigOperators
noncomputable section
universe u v

open CategoryTheory MonoidalCategory Limits
open CategoryTheory.Operad.SmallFinBijGroupoid

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3

/-- The original finite automorphism comparison with its canonical cardinality exposed. -/
private def cardinalAutEquiv (q : ℕ) : Aut (card q) ≃* Equiv.Perm (Fin q) :=
  finAutEquiv (card q)

/-- This is the same whole original finite automorphism comparison. -/
private theorem cardinalAutEquiv_eq_original (q : ℕ) :
    cardinalAutEquiv q = finAutEquiv (card q) := rfl

private def cardinalAlphabetAutEquiv (q : ℕ) :
    Aut (card q) ≃* Equiv.Perm (ULift.{0, 0} (Fin q)) := alphabetAutEquiv (card q)

private def cardinalBlockSplit (c n : ℕ) :
    ULift.{0, 0} (Fin (c + n)) ≃ ULift.{0, 0} (Fin c) ⊕ ULift.{0, 0} (Fin n) :=
  blockTargetSplit (card c) (card n) (card (c + n)) (cardBlockSumIso rfl)

/-- The actual ordered free block consists of the last `n` finite labels. -/
private def freeBlock (c n : ℕ) : Fin n ↪ Fin (c + n) := Fin.natAddEmb c

/-- Prefixing the new coefficient label keeps all previous finite labels. -/
private def successorAmbient (c n : ℕ) : Fin (c + n) ↪ Fin ((c + 1) + n) where
  toFun x := ⟨x.val + 1, by omega⟩
  inj' := by
    intro x y h
    apply Fin.ext
    have hval := congrArg Fin.val h
    change x.val + 1 = y.val + 1 at hval
    omega

/-- The ordered free block is retained under the actual prefix-one inclusion. -/
private theorem successorAmbient_freeBlock (c n : ℕ) :
    (freeBlock c n).trans (successorAmbient c n) = freeBlock (c + 1) n := by
  apply Function.Embedding.ext
  intro j
  apply Fin.ext
  change (c + j.val) + 1 = (c + 1) + j.val
  omega

/-- Ordered embeddings are the finite labels of the complement orbits. -/
private abbrev OrbitIndex (c n : ℕ) := Fin n ↪ Fin (c + n)

/-- Every original orbit label grows by the same ambient prefix-one inclusion. -/
private def growOrbit (c n : ℕ) (i : OrbitIndex c n) : OrbitIndex (c + 1) n :=
  i.trans (successorAmbient c n)

/-- The same explicit successive-swap representative is chosen in every degree. -/
private def orbitRepresentative (c n : ℕ) (i : OrbitIndex c n) : Aut (card (c + n)) :=
  (cardinalAutEquiv (c + n)).symm
    (Equiv.Perm.alignFiniteEmbeddings (freeBlock c n) i)

/-- Every free-block label has exactly its displayed representative image. -/
private theorem orbitRepresentative_freeBlock (c n : ℕ) (i : OrbitIndex c n) (j : Fin n) :
    (cardinalAutEquiv (c + n) (orbitRepresentative c n i)) (freeBlock c n j) = i j := by
  rw [orbitRepresentative, MulEquiv.apply_symm_apply]
  exact Equiv.Perm.alignFiniteEmbeddings_apply (freeBlock c n) i j

/-- The complete representative construction commutes with every ambient embedding. -/
private theorem orbitRepresentative_embedding (c n d : ℕ) (i : OrbitIndex c n)
    (ι : Fin (c + n) ↪ Fin d) :
    (cardinalAutEquiv (c + n) (orbitRepresentative c n i)).viaEmbedding ι =
      Equiv.Perm.alignFiniteEmbeddings ((freeBlock c n).trans ι) (i.trans ι) := by
  rw [orbitRepresentative, MulEquiv.apply_symm_apply]
  exact Equiv.Perm.alignFiniteEmbeddings_viaEmbedding (freeBlock c n) i ι

/-- Extend the original target permutation by the identity new label. -/
private def growAut (c n : ℕ) (g : Aut (card (c + n))) : Aut (card ((c + 1) + n)) :=
  (cardinalAutEquiv ((c + 1) + n)).symm
    ((cardinalAutEquiv (c + n) g).viaEmbedding (successorAmbient c n))

/-- Old orbit representatives are literally the extended representatives in the next degree. -/
private theorem orbitRepresentative_successor (c n : ℕ) (i : OrbitIndex c n) :
    growAut c n (orbitRepresentative c n i) =
      orbitRepresentative (c + 1) n (growOrbit c n i) := by
  apply (cardinalAutEquiv ((c + 1) + n)).injective
  simp only [growAut, orbitRepresentative, MulEquiv.apply_symm_apply]
  have h := Equiv.Perm.alignFiniteEmbeddings_viaEmbedding (freeBlock c n) i
    (successorAmbient c n)
  rw [successorAmbient_freeBlock] at h
  exact h

/-- An empty free block chooses the identity in every actual target group. -/
private theorem orbitRepresentative_zero (c : ℕ) (i : OrbitIndex c 0) :
    orbitRepresentative c 0 i = 1 := by
  have h := Equiv.Perm.alignFiniteEmbeddings_zero (freeBlock c 0) i
  exact (congrArg (cardinalAutEquiv (c + 0)).symm h).trans
    (cardinalAutEquiv (c + 0)).symm.map_one


private def complementHom (c n : ℕ) : Aut (card c) →* Aut (card (c + n)) :=
  blockAutHom (card c) (card n) (card (c + n)) (cardBlockSumIso rfl)

private theorem blockTargetSplit_final (c n : ℕ) (j : Fin n) :
    (cardinalBlockSplit c n).symm
      (Sum.inr (ULift.up j)) = ULift.up (freeBlock c n j) := by
  rfl

private theorem complementHom_range_iff (c n : ℕ) (g : Aut (card (c + n))) :
    g ∈ (complementHom c n).range ↔
      ∀ j : Fin n, cardinalAutEquiv (c + n) g (freeBlock c n j) = freeBlock c n j := by
  have hRange : g ∈ (complementHom c n).range ↔
      ∀ x : ULift.{0, 0} (Fin n), cardinalAlphabetAutEquiv (c + n) g
        ((cardinalBlockSplit c n).symm (Sum.inr x)) =
          (cardinalBlockSplit c n).symm (Sum.inr x) :=
    blockAutHom_range_iff (card c) (card n) (card (c + n)) (cardBlockSumIso rfl) g
  rw [hRange]
  constructor
  · intro h j
    have hj := h (ULift.up j)
    rw [blockTargetSplit_final] at hj
    exact congrArg ULift.down hj
  · intro h x
    rcases x with ⟨j⟩
    rw [blockTargetSplit_final]
    apply ULift.ext
    exact h j

private theorem complementHom_injective (c n : ℕ) : Function.Injective (complementHom c n) :=
  blockAutHom_injective (card c) (card n) (card (c + n)) (cardBlockSumIso rfl)

private theorem complementHom_fixes (c n : ℕ) (a : Aut (card c)) (j : Fin n) :
    cardinalAutEquiv (c + n) (complementHom c n a) (freeBlock c n j) = freeBlock c n j :=
  (complementHom_range_iff c n _).mp ⟨a, rfl⟩ j

private def orbitImage (c n : ℕ) (g : Aut (card (c + n))) : OrbitIndex c n :=
  (freeBlock c n).trans (cardinalAutEquiv (c + n) g).toEmbedding

private theorem orbitImage_representative (c n : ℕ) (i : OrbitIndex c n) :
    orbitImage c n (orbitRepresentative c n i) = i := by
  apply Function.Embedding.ext
  intro j
  exact orbitRepresentative_freeBlock c n i j

private theorem orbitImage_mul_complement (c n : ℕ) (g : Aut (card (c + n)))
    (a : Aut (card c)) :
    orbitImage c n (g * complementHom c n a) = orbitImage c n g := by
  apply Function.Embedding.ext
  intro j
  change cardinalAutEquiv (c + n) (g * complementHom c n a) (freeBlock c n j) =
    cardinalAutEquiv (c + n) g (freeBlock c n j)
  rw [map_mul, Equiv.Perm.mul_apply, complementHom_fixes]

private theorem orbitImage_eq_iff (c n : ℕ) (g h : Aut (card (c + n))) :
    orbitImage c n g = orbitImage c n h ↔ (h⁻¹ * g) ∈ (complementHom c n).range := by
  rw [complementHom_range_iff]
  constructor
  · intro he j
    have hj := congrArg (fun i : OrbitIndex c n => i j) he
    change cardinalAutEquiv (c + n) g (freeBlock c n j) =
      cardinalAutEquiv (c + n) h (freeBlock c n j) at hj
    rw [map_mul, map_inv, Equiv.Perm.mul_apply, hj]
    exact (cardinalAutEquiv (c + n) h).symm_apply_apply (freeBlock c n j)
  · intro he
    apply Function.Embedding.ext
    intro j
    have hj := he j
    rw [map_mul, map_inv, Equiv.Perm.mul_apply] at hj
    change (cardinalAutEquiv (c + n) h).symm
      (cardinalAutEquiv (c + n) g (freeBlock c n j)) = freeBlock c n j at hj
    have hp := congrArg (cardinalAutEquiv (c + n) h) hj
    rw [Equiv.apply_symm_apply] at hp
    exact hp

@[instance_reducible]
private def complementAction (c n : ℕ) : MulAction (Aut (card c)) (Aut (card (c + n))) :=
  ActionCategory.inverseRightMulAction (Aut (card c)) (Aut (card (c + n))) (complementHom c n)

private theorem orbitImage_smul (c n : ℕ) (g : Aut (card (c + n))) (a : Aut (card c)) :
    letI := complementAction c n
    orbitImage c n (a • g) = orbitImage c n g := by
  change orbitImage c n (g * (complementHom c n a)⁻¹) = orbitImage c n g
  rw [← map_inv]
  exact orbitImage_mul_complement c n g a⁻¹

private theorem complementAction_free (c n : ℕ) (g : Aut (card (c + n))) :
    letI := complementAction c n
    Function.Injective (fun a : Aut (card c) => a • g) := by
  intro a b hab
  change g * (complementHom c n a)⁻¹ = g * (complementHom c n b)⁻¹ at hab
  have hi := mul_left_cancel hab
  apply complementHom_injective c n
  exact inv_injective hi

private theorem orbitTwist_exists (c n : ℕ) (g : Aut (card (c + n))) :
    ∃ a : Aut (card c), complementHom c n a =
      (orbitRepresentative c n (orbitImage c n g))⁻¹ * g := by
  apply (orbitImage_eq_iff c n g (orbitRepresentative c n (orbitImage c n g))).mp
  exact (orbitImage_representative c n (orbitImage c n g)).symm

private def orbitTwist (c n : ℕ) (g : Aut (card (c + n))) : Aut (card c) :=
  Classical.choose (orbitTwist_exists c n g)

private theorem orbitTwist_spec (c n : ℕ) (g : Aut (card (c + n))) :
    complementHom c n (orbitTwist c n g) =
      (orbitRepresentative c n (orbitImage c n g))⁻¹ * g :=
  Classical.choose_spec (orbitTwist_exists c n g)

private theorem orbitTwist_smul (c n : ℕ) (g : Aut (card (c + n))) :
    letI := complementAction c n
    orbitTwist c n g • g = orbitRepresentative c n (orbitImage c n g) := by
  change g * (complementHom c n (orbitTwist c n g))⁻¹ = _
  rw [orbitTwist_spec, mul_inv_rev, inv_inv, ← mul_assoc, mul_inv_cancel, one_mul]

private theorem orbitTwist_representative (c n : ℕ) (i : OrbitIndex c n) :
    orbitTwist c n (orbitRepresentative c n i) = 1 := by
  apply complementHom_injective c n
  rw [orbitTwist_spec, orbitImage_representative, inv_mul_cancel, map_one]

private theorem orbitTwist_comp (c n : ℕ) (g : Aut (card (c + n))) (a : Aut (card c)) :
    letI := complementAction c n
    orbitTwist c n g = orbitTwist c n (a • g) * a := by
  let _ := complementAction c n
  apply complementAction_free c n g
  change orbitTwist c n g • g = (orbitTwist c n (a • g) * a) • g
  rw [mul_smul, orbitTwist_smul, orbitTwist_smul, orbitImage_smul]


section Copower

universe uC vC
variable {C : Type uC} [Category.{vC} C]
  (c n : ℕ) (Z : C) (ρ : Aut (card c) →* End Z)
  [HasCoproduct (fun _ : OrbitIndex c n => Z)]

private local instance orbitAction : MulAction (Aut (card c)) (Aut (card (c + n))) :=
  complementAction c n

/-- The actual coefficient cocone uses the compatible representative of every finite orbit. -/
private def orbitCopowerCocone : Cocone (ActionCategory.coefficientDiagram
    (Aut (card c)) (Aut (card (c + n))) Z ρ) :=
  ActionCategory.CoefficientFamily.cocone (Aut (card c)) (Aut (card (c + n))) Z ρ
    { leg := fun g => (ρ (orbitTwist c n g)).asHom ≫
        Sigma.ι (fun _ : OrbitIndex c n => Z) (orbitImage c n g)
      relation := by
        intro a g
        rw [← Category.assoc, ← End.mul_asHom, ← ρ.map_mul, ← orbitTwist_comp,
          orbitImage_smul] }

/-- All maps of the original action diagram descend uniquely through these orbit coordinates. -/
private def orbitCopowerIsColimit : IsColimit (orbitCopowerCocone c n Z ρ) where
  desc s := Sigma.desc (fun i => s.ι.app
    ((ActionCategory.objEquiv (Aut (card c)) (Aut (card (c + n))))
      (orbitRepresentative c n i)))
  fac s g := by
    let family : OrbitIndex c n → C := fun _ => Z
    let x : Aut (card (c + n)) := g.back
    let r : ActionCategory (Aut (card c)) (Aut (card (c + n))) :=
      (ActionCategory.objEquiv (Aut (card c)) (Aut (card (c + n))))
        (orbitRepresentative c n (orbitImage c n x))
    let a : g ⟶ r := ⟨orbitTwist c n x, orbitTwist_smul c n x⟩
    let leg : Z ⟶ ∐ family := Sigma.ι family (orbitImage c n x)
    let desc : (∐ family) ⟶ s.pt := Sigma.desc
      (fun i => s.ι.app ((ActionCategory.objEquiv (Aut (card c)) (Aut (card (c + n))))
        (orbitRepresentative c n i)))
    have hs : (ρ (orbitTwist c n x)).asHom ≫ s.ι.app r = s.ι.app g := s.w a
    have hd : leg ≫ desc = s.ι.app r := Sigma.ι_comp_desc _ _
    change ((ρ (orbitTwist c n x)).asHom ≫ leg) ≫ desc = s.ι.app g
    exact (Category.assoc _ _ _).trans
      ((congrArg (fun f => (ρ (orbitTwist c n x)).asHom ≫ f) hd).trans hs)
  uniq s m hm := by
    let family : OrbitIndex c n → C := fun _ => Z
    change (∐ family) ⟶ s.pt at m
    let desc : (∐ family) ⟶ s.pt := Sigma.desc
      (fun i => s.ι.app ((ActionCategory.objEquiv (Aut (card c)) (Aut (card (c + n))))
        (orbitRepresentative c n i)))
    change m = desc
    apply Sigma.hom_ext
    intro i
    let r : ActionCategory (Aut (card c)) (Aut (card (c + n))) :=
      (ActionCategory.objEquiv (Aut (card c)) (Aut (card (c + n)))) (orbitRepresentative c n i)
    have hi := hm r
    change ((ρ (orbitTwist c n (orbitRepresentative c n i))).asHom ≫
      Sigma.ι family (orbitImage c n (orbitRepresentative c n i))) ≫ m = s.ι.app r at hi
    rw [orbitTwist_representative, orbitImage_representative, ρ.map_one] at hi
    change (𝟙 Z ≫ Sigma.ι family i) ≫ m = s.ι.app r at hi
    rw [Category.id_comp] at hi
    have hd : Sigma.ι family i ≫ desc = s.ι.app r := Sigma.ι_comp_desc _ _
    exact hi.trans hd.symm

variable [HasColimit (ActionCategory.coefficientDiagram
  (Aut (card c)) (Aut (card (c + n))) Z ρ)]

/-- The chosen original action colimit has exactly the compatible finite orbit coordinates. -/
private def orbitColimitCopowerIso :
    colimit (ActionCategory.coefficientDiagram (Aut (card c)) (Aut (card (c + n))) Z ρ) ≅
      ∐ (fun _ : OrbitIndex c n => Z) :=
  (colimit.isColimit _).coconePointUniqueUpToIso (orbitCopowerIsColimit c n Z ρ)

/-- Every original group label retains its whole coefficient action and compatible orbit leg. -/
private theorem orbitColimitCopowerIso_generator (g : Aut (card (c + n))) :
    colimit.ι (ActionCategory.coefficientDiagram (Aut (card c)) (Aut (card (c + n))) Z ρ)
        (g : ActionCategory (Aut (card c)) (Aut (card (c + n)))) ≫
      (orbitColimitCopowerIso c n Z ρ).hom =
    (ρ (orbitTwist c n g)).asHom ≫
      Sigma.ι (fun _ : OrbitIndex c n => Z) (orbitImage c n g) :=
  (colimit.isColimit _).comp_coconePointUniqueUpToIso_hom
    (orbitCopowerIsColimit c n Z ρ)
    (g : ActionCategory (Aut (card c)) (Aut (card (c + n))))

end Copower

section NativeCopower
variable (c n : ℕ) (Z : PointedCGWH.{u, v}) (ρ : Aut (card c) →* End Z)

/-- The original native balanced quotient is the compatible finite copower of
its actual coefficient. -/
private def nativeOrbitCopowerIso :
    nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
        (complementHom c n) ≅ ∐ (fun _ : OrbitIndex c n => Z) := by
  letI := complementAction c n
  exact (nativeBalancedColimitIso.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n)))
    Z ρ (complementHom c n)).symm ≪≫ orbitColimitCopowerIso c n Z ρ

/-- The whole normalization retains every actual native balanced generator. -/
private theorem nativeOrbitCopowerIso_generator (g : Aut (card (c + n))) :
    nativeBalancedGenerator.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
        (complementHom c n) g ≫ (nativeOrbitCopowerIso c n Z ρ).hom =
    (ρ (orbitTwist c n g)).asHom ≫
      Sigma.ι (fun _ : OrbitIndex c n => Z) (orbitImage c n g) := by
  let _ := complementAction c n
  let e : colimit (ActionCategory.coefficientDiagram
      (Aut (card c)) (Aut (card (c + n))) Z ρ) ≅
      nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
        (complementHom c n) :=
    nativeBalancedColimitIso.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n)))
      Z ρ (complementHom c n)
  let o := orbitColimitCopowerIso c n Z ρ
  let l : Z ⟶ colimit (ActionCategory.coefficientDiagram
      (Aut (card c)) (Aut (card (c + n))) Z ρ) :=
    colimit.ι (ActionCategory.coefficientDiagram (Aut (card c)) (Aut (card (c + n))) Z ρ)
      ((ActionCategory.objEquiv (Aut (card c)) (Aut (card (c + n)))) g)
  have hg : l ≫ e.hom = nativeBalancedGenerator.{u, v, 0, 0}
      (Aut (card c)) (Aut (card (c + n))) Z ρ (complementHom c n) g :=
    nativeBalancedColimitIso_generator.{u, v, 0, 0}
      (Aut (card c)) (Aut (card (c + n))) Z ρ (complementHom c n) g
  have ho : l ≫ o.hom = (ρ (orbitTwist c n g)).asHom ≫
      Sigma.ι (fun _ : OrbitIndex c n => Z) (orbitImage c n g) :=
    orbitColimitCopowerIso_generator c n Z ρ g
  change _ ≫ (e.inv ≫ o.hom) = _
  calc
    _ = (l ≫ e.hom) ≫ (e.inv ≫ o.hom) := congrArg (fun f => f ≫ (e.inv ≫ o.hom)) hg.symm
    _ = l ≫ o.hom := by rw [Category.assoc, e.hom_inv_id_assoc]
    _ = _ := ho

/-- Every inverse orbit leg is the actual native generator at its compatible representative. -/
private theorem nativeOrbitCopowerIso_inv_leg (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ (nativeOrbitCopowerIso c n Z ρ).inv =
      nativeBalancedGenerator.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
        (complementHom c n) (orbitRepresentative c n i) := by
  apply (cancel_mono (nativeOrbitCopowerIso c n Z ρ).hom).1
  rw [Category.assoc, Iso.inv_hom_id, Category.comp_id,
    nativeOrbitCopowerIso_generator, orbitTwist_representative,
    orbitImage_representative, ρ.map_one]
  exact (Category.id_comp _).symm

/-- Whole equivariant coefficient arrows act independently on every original orbit leg. -/
private theorem nativeOrbitCopowerIso_naturality
    (Z' : PointedCGWH.{u, v}) (ρ' : Aut (card c) →* End Z') (f : Z ⟶ Z')
    (hf : ∀ a, (ρ a).asHom ≫ f = f ≫ (ρ' a).asHom) :
    nativeBalancedMap.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
        (complementHom c n) Z' ρ' f hf ≫ (nativeOrbitCopowerIso c n Z' ρ').hom =
      (nativeOrbitCopowerIso c n Z ρ).hom ≫
        Limits.Sigma.map (fun _ : OrbitIndex c n => f) := by
  apply nativeBalanced_hom_ext.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
    (complementHom c n)
  intro g
  let t := nativeBalancedMap.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
    (complementHom c n) Z' ρ' f hf
  let e := nativeOrbitCopowerIso c n Z ρ
  let e' := nativeOrbitCopowerIso c n Z' ρ'
  let q := nativeBalancedGenerator.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z ρ
    (complementHom c n) g
  let q' := nativeBalancedGenerator.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n))) Z' ρ'
    (complementHom c n) g
  let leg := Sigma.ι (fun _ : OrbitIndex c n => Z) (orbitImage c n g)
  let leg' := Sigma.ι (fun _ : OrbitIndex c n => Z') (orbitImage c n g)
  let a := (ρ (orbitTwist c n g)).asHom
  let a' := (ρ' (orbitTwist c n g)).asHom
  let m := Limits.Sigma.map (fun _ : OrbitIndex c n => f)
  have ht : q ≫ t = f ≫ q' := nativeBalancedMap_generator.{u, v, 0, 0}
    (Aut (card c)) (Aut (card (c + n))) Z ρ (complementHom c n) Z' ρ' f hf g
  have he : q ≫ e.hom = a ≫ leg := nativeOrbitCopowerIso_generator c n Z ρ g
  have he' : q' ≫ e'.hom = a' ≫ leg' := nativeOrbitCopowerIso_generator c n Z' ρ' g
  have hm : leg ≫ m = f ≫ leg' := Sigma.ι_map _ _
  have ha : a ≫ f = f ≫ a' := hf (orbitTwist c n g)
  change q ≫ (t ≫ e'.hom) = q ≫ (e.hom ≫ m)
  calc
    _ = (q ≫ t) ≫ e'.hom := (Category.assoc _ _ _).symm
    _ = (f ≫ q') ≫ e'.hom := congrArg (fun z => z ≫ e'.hom) ht
    _ = f ≫ (q' ≫ e'.hom) := Category.assoc _ _ _
    _ = f ≫ (a' ≫ leg') := congrArg (fun z => f ≫ z) he'
    _ = (a ≫ f) ≫ leg' :=
      (Category.assoc _ _ _).symm.trans (congrArg (fun z => z ≫ leg') ha.symm)
    _ = a ≫ (f ≫ leg') := Category.assoc _ _ _
    _ = a ≫ (leg ≫ m) := congrArg (fun z => a ≫ z) hm.symm
    _ = (a ≫ leg) ≫ m := (Category.assoc _ _ _).symm
    _ = (q ≫ e.hom) ≫ m := congrArg (fun z => z ≫ m) he.symm
    _ = _ := Category.assoc _ _ _

end NativeCopower


private theorem compositeIsoInvLeg {C : Type*} [Category C]
    {A B D W : C} (e : A ≅ B) (d : B ≅ D) (i : W ⟶ D) (g : W ⟶ B)
    (h : i ≫ d.inv = g) : i ≫ (e ≪≫ d).inv = g ≫ e.inv :=
  (Category.assoc i d.inv e.inv).symm.trans (congrArg (fun f => f ≫ e.inv) h)

section NativeFreeSmash

private abbrev Coefficient := PointedCGWH.{u, v}

attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers

/-- Normalize the independent complement index before selecting the original native level map. -/
private def normalizedNativeBalancedLevelIso (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : Coefficient.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).obj Y).X.functor.obj (card q) ≅
      nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card q))
        (M ⊗ Y.X.functor.obj (card c))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
        (blockAutHom (card c) (card n) (card q)
          (cardBlockSumIso (hc ▸ Nat.sub_add_cancel h))) := by
  subst c
  exact PointedCGWH.SymmetricSpectrum.freeSmashCardOrbitIso h M Y

/-- The whole original coefficient-first balanced level with its complement cardinal exposed. -/
private def freeSmashBalancedOrbitIso (c n : ℕ) (M : Coefficient.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).obj Y).X.functor.obj (card (c+n)) ≅
      nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card (c+n)))
        (M ⊗ Y.X.functor.obj (card c))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
        (complementHom c n) := by
  exact normalizedNativeBalancedLevelIso n (c + n) c (by omega)
    (Nat.add_sub_cancel_right c n) M Y

/-- Every actual upper free-smash level is the compatible finite orbit copower,
with its original native quotient, coefficient braid and arbitrary target. -/
private def freeSmashFiniteOrbitIso (c n : ℕ) (M : Coefficient.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).obj Y).X.functor.obj (card (c+n)) ≅
      ∐ (fun _ : OrbitIndex c n => M ⊗ Y.X.functor.obj (card c)) :=
  freeSmashBalancedOrbitIso c n M Y ≪≫ nativeOrbitCopowerIso c n
    (M ⊗ Y.X.functor.obj (card c))
    (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))

/-- The inverse of the actual finite orbit comparison retains both original inverse arrows. -/
private theorem freeSmashFiniteOrbitIso_inv_readback (c n : ℕ) (M : Coefficient.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (freeSmashFiniteOrbitIso c n M Y).inv =
      (nativeOrbitCopowerIso c n (M ⊗ Y.X.functor.obj (card c))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))).inv ≫
        (freeSmashBalancedOrbitIso c n M Y).inv := rfl

/-- Every inverse finite orbit leg is the original native balanced generator
at the compatible representative, through the full original level comparison. -/
private theorem freeSmashFiniteOrbitIso_inv_leg (c n : ℕ) (M : Coefficient.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => M ⊗ Y.X.functor.obj (card c)) i ≫
        (freeSmashFiniteOrbitIso c n M Y).inv =
      nativeBalancedGenerator.{u, v, 0, 0} (Aut (card c)) (Aut (card (c+n)))
        (M ⊗ Y.X.functor.obj (card c))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
        (complementHom c n) (orbitRepresentative c n i) ≫
        (freeSmashBalancedOrbitIso c n M Y).inv := by
  rw [freeSmashFiniteOrbitIso_inv_readback, ← Category.assoc,
    nativeOrbitCopowerIso_inv_leg]

end NativeFreeSmash


private def prefixAut (q : ℕ) : Aut (card q) →* Aut (card (1+q)) :=
  Functor.mapAut (card q) (tensorLeft (card 1))

private def prefixSplit (q : ℕ) :
    ULift.{0,0} (Fin (1+q)) ≃ ULift.{0,0} (Fin 1) ⊕ ULift.{0,0} (Fin q) :=
  blockSumEquiv (card 1) (card q)

private theorem prefixCoordinate_right (q : ℕ) (j : Fin q) :
    (prefixSplit q).symm (Sum.inr (ULift.up j)) =
      ULift.up (Fin.natAdd 1 j) := rfl

private theorem prefixCoordinate_left (q : ℕ) (j : Fin 1) :
    (prefixSplit q).symm (Sum.inl (ULift.up j)) =
      ULift.up (Fin.castAdd q j) := rfl

private theorem prefixAut_right (q : ℕ) (g : Aut (card q)) (j : Fin q) :
    cardinalAutEquiv (1+q) (prefixAut q g) (Fin.natAdd 1 j) =
      Fin.natAdd 1 (cardinalAutEquiv q g j) := by
  have h : cardinalAlphabetAutEquiv (1+q) (prefixAut q g)
      ((prefixSplit q).symm (Sum.inr (ULift.up j))) =
    (prefixSplit q).symm (Sum.inr (cardinalAlphabetAutEquiv q g (ULift.up j))) := by
    change (blockSumHom (𝟙 (card 1)) g.asIso.hom).iso.hom
      ((blockSumEquiv (card 1) (card q)).symm (Sum.inr (ULift.up j))) =
      (blockSumEquiv (card 1) (card q)).symm (Sum.inr (g.asIso.hom.iso.hom (ULift.up j)))
    rw [blockSumHom_apply, Equiv.apply_symm_apply, Sum.map_inr]
  have he : cardinalAlphabetAutEquiv q g (ULift.up j) =
      ULift.up (cardinalAutEquiv q g j) := rfl
  have hf : cardinalAlphabetAutEquiv (1+q) (prefixAut q g) (ULift.up (Fin.natAdd 1 j)) =
      ULift.up (Fin.natAdd 1 (cardinalAutEquiv q g j)) := by
    calc
      _ = cardinalAlphabetAutEquiv (1+q) (prefixAut q g)
          ((prefixSplit q).symm (Sum.inr (ULift.up j))) :=
        congrArg (cardinalAlphabetAutEquiv (1+q) (prefixAut q g))
          (prefixCoordinate_right q j).symm
      _ = (prefixSplit q).symm
          (Sum.inr (cardinalAlphabetAutEquiv q g (ULift.up j))) := h
      _ = (prefixSplit q).symm
          (Sum.inr (ULift.up (cardinalAutEquiv q g j))) :=
        congrArg (fun x => (prefixSplit q).symm (Sum.inr x)) he
      _ = _ := prefixCoordinate_right q (cardinalAutEquiv q g j)
  exact congrArg ULift.down hf

private theorem prefixAut_left (q : ℕ) (g : Aut (card q)) (j : Fin 1) :
    cardinalAutEquiv (1+q) (prefixAut q g) (Fin.castAdd q j) = Fin.castAdd q j := by
  have h : cardinalAlphabetAutEquiv (1+q) (prefixAut q g)
      ((prefixSplit q).symm (Sum.inl (ULift.up j))) =
    (prefixSplit q).symm (Sum.inl (ULift.up j)) := by
    change (blockSumHom (𝟙 (card 1)) g.asIso.hom).iso.hom
      ((blockSumEquiv (card 1) (card q)).symm (Sum.inl (ULift.up j))) =
      (blockSumEquiv (card 1) (card q)).symm (Sum.inl (ULift.up j))
    rw [blockSumHom_apply, Equiv.apply_symm_apply, Sum.map_inl]
    rfl
  have hf : cardinalAlphabetAutEquiv (1+q) (prefixAut q g) (ULift.up (Fin.castAdd q j)) =
      ULift.up (Fin.castAdd q j) := by
    calc
      _ = cardinalAlphabetAutEquiv (1+q) (prefixAut q g)
          ((prefixSplit q).symm (Sum.inl (ULift.up j))) :=
        congrArg (cardinalAlphabetAutEquiv (1+q) (prefixAut q g))
          (prefixCoordinate_left q j).symm
      _ = (prefixSplit q).symm (Sum.inl (ULift.up j)) := h
      _ = _ := prefixCoordinate_left q j
  exact congrArg ULift.down hf

private theorem prefixAut_eq_viaEmbedding (q : ℕ) (g : Aut (card q)) :
    cardinalAutEquiv (1+q) (prefixAut q g) =
      (cardinalAutEquiv q g).viaEmbedding (Fin.natAddEmb 1) := by
  apply Equiv.ext
  intro x
  refine Fin.addCases ?_ ?_ x
  · intro j
    have hj : Fin.castAdd q j ∉ Set.range (Fin.natAddEmb 1 : Fin q ↪ Fin (1+q)) := by
      rintro ⟨y, hy⟩
      have he := congrArg Fin.val hy
      have hb := j.isLt
      change 1+y.val = j.val at he
      omega
    rw [Equiv.Perm.viaEmbedding_apply_of_notMem _ _ _ hj]
    exact prefixAut_left q g j
  · intro j
    exact (prefixAut_right q g j).trans
      (Equiv.Perm.viaEmbedding_apply (cardinalAutEquiv q g) (Fin.natAddEmb 1) j).symm


private abbrev StableOrbitIndex (n : ℕ) := Fin n ↪ ℕ

private def orbitIntoStable (c n : ℕ) (i : OrbitIndex c n) : StableOrbitIndex n where
  toFun j := (c + n) - 1 - (i j).val
  inj' := by
    intro a b hab
    apply i.injective
    apply Fin.ext
    have ha := (i a).isLt
    have hb := (i b).isLt
    change (c+n)-1-(i a).val = (c+n)-1-(i b).val at hab
    omega

private theorem orbitIntoStable_injective (c n : ℕ) : Function.Injective (orbitIntoStable c n) := by
  intro i j hij
  apply Function.Embedding.ext
  intro a
  apply Fin.ext
  have ha := (i a).isLt
  have hb := (j a).isLt
  have he := congrArg (fun k : StableOrbitIndex n => k a) hij
  change (c+n)-1-(i a).val = (c+n)-1-(j a).val at he
  omega

private theorem orbitIntoStable_successor (c n : ℕ) (i : OrbitIndex c n) :
    orbitIntoStable (c+1) n (growOrbit c n i) = orbitIntoStable c n i := by
  apply Function.Embedding.ext
  intro j
  have hj := (i j).isLt
  change ((c+1)+n)-1-((i j).val+1) = (c+n)-1-(i j).val
  omega

private def ambientEmbedding (c n k : ℕ) : Fin (c+n) ↪ Fin ((c+k)+n) where
  toFun x := ⟨x.val+k, by omega⟩
  inj' := by
    intro x y h
    apply Fin.ext
    have hv := congrArg Fin.val h
    change x.val+k = y.val+k at hv
    omega

private def growOrbitBy (c n k : ℕ) (i : OrbitIndex c n) : OrbitIndex (c+k) n :=
  i.trans (ambientEmbedding c n k)

private theorem ambientEmbedding_freeBlock (c n k : ℕ) :
    (freeBlock c n).trans (ambientEmbedding c n k) = freeBlock (c+k) n := by
  apply Function.Embedding.ext
  intro j
  apply Fin.ext
  change (c+j.val)+k = (c+k)+j.val
  omega

private theorem orbitIntoStable_growBy (c n k : ℕ) (i : OrbitIndex c n) :
    orbitIntoStable (c+k) n (growOrbitBy c n k i) = orbitIntoStable c n i := by
  apply Function.Embedding.ext
  intro j
  have hj := (i j).isLt
  change ((c+k)+n)-1-((i j).val+k) = (c+n)-1-(i j).val
  omega

private theorem orbitIntoStable_stage_exists (n : ℕ) (i : StableOrbitIndex n) :
    ∃ c : ℕ, ∃ j : OrbitIndex c n, orbitIntoStable c n j = i := by
  let c := (∑ a : Fin n, i a) + 1
  have hi (a : Fin n) : i a < c+n := by
    have h : i a ≤ ∑ b : Fin n, i b :=
      Finset.single_le_sum (fun b _ => Nat.zero_le (i b)) (Finset.mem_univ a)
    dsimp only [c]
    omega
  let j : OrbitIndex c n :=
    { toFun a := ⟨(c+n)-1-i a, by have h:=hi a; omega⟩
      inj' := by
        intro a b h
        apply i.injective
        have ha:=hi a
        have hb:=hi b
        have hv:=congrArg Fin.val h
        change (c+n)-1-i a = (c+n)-1-i b at hv
        omega }
  refine ⟨c, j, ?_⟩
  apply Function.Embedding.ext
  intro a
  have ha:=hi a
  change (c+n)-1-((c+n)-1-i a) = i a
  omega

private theorem stableOrbit_zero_subsingleton : Subsingleton (StableOrbitIndex 0) := by
  refine ⟨fun a b => ?_⟩
  apply Function.Embedding.ext
  intro j
  exact Fin.elim0 j

private instance stableOrbit_countable (n : ℕ) : Countable (StableOrbitIndex n) :=
  Function.Injective.countable
    (show Function.Injective (fun i : StableOrbitIndex n => (fun j : Fin n => i j)) from
      fun _ _ h => Function.Embedding.ext (congrFun h))

private def shiftedStableOrbit (n k : ℕ) : StableOrbitIndex n where
  toFun j := k*n+j.val
  inj' := by
    intro a b h
    apply Fin.ext
    change k*n+a.val = k*n+b.val at h
    omega

private theorem shiftedStableOrbit_injective {n : ℕ} (hn : 0 < n) :
    Function.Injective (shiftedStableOrbit n) := by
  intro k l h
  have he := congrArg (fun i : StableOrbitIndex n => i ⟨0, hn⟩) h
  change k*n+0 = l*n+0 at he
  rw [Nat.add_zero, Nat.add_zero] at he
  exact Nat.eq_of_mul_eq_mul_right hn he

private instance stableOrbit_infinite (n : ℕ) [NeZero n] : Infinite (StableOrbitIndex n) :=
  Infinite.of_injective (shiftedStableOrbit n)
    (shiftedStableOrbit_injective (Nat.pos_of_ne_zero (NeZero.ne n)))



/-- Every later finite stage prefixes the exact number of new ambient labels. -/
private def orbitInclusion (n : ℕ) {c d : ℕ} (h : c ≤ d) : OrbitIndex c n → OrbitIndex d n :=
  fun i =>
    { toFun j := ⟨(i j).val + (d-c), by have hj := (i j).isLt; omega⟩
      inj' := by
        intro a b hab
        apply i.injective
        apply Fin.ext
        have hv := congrArg Fin.val hab
        change (i a).val + (d-c) = (i b).val + (d-c) at hv
        omega }

private theorem orbitIntoStable_inclusion (n : ℕ) {c d : ℕ} (h : c ≤ d) (i : OrbitIndex c n) :
    orbitIntoStable d n (orbitInclusion n h i) = orbitIntoStable c n i := by
  apply Function.Embedding.ext
  intro j
  have hj := (i j).isLt
  change (d+n)-1-((i j).val+(d-c)) = (c+n)-1-(i j).val
  omega

private theorem orbitInclusion_eventually_eq (n : ℕ) {c d : ℕ}
    (i : OrbitIndex c n) (j : OrbitIndex d n)
    (h : orbitIntoStable c n i = orbitIntoStable d n j) :
    orbitInclusion n (Nat.le_add_right c d) i =
      orbitInclusion n (Nat.le_add_left d c) j := by
  apply orbitIntoStable_injective (c+d) n
  exact (orbitIntoStable_inclusion n (Nat.le_add_right c d) i).trans
    (h.trans (orbitIntoStable_inclusion n (Nat.le_add_left d c) j).symm)

/-- The original growing finite orbit indices form their actual Nat diagram. -/
private def orbitIndexDiagram (n : ℕ) : ℕ ⥤ Type where
  obj c := OrbitIndex c n
  map f := TypeCat.ofHom (orbitInclusion n (leOfHom f))
  map_id c := by
    apply ConcreteCategory.hom_ext
    intro i
    apply Function.Embedding.ext
    intro j
    apply Fin.ext
    change (i j).val+(c-c) = (i j).val
    omega
  map_comp {c d e} f g := by
    apply ConcreteCategory.hom_ext
    intro i
    apply Function.Embedding.ext
    intro j
    apply Fin.ext
    have hcd := leOfHom f
    have hde := leOfHom g
    change (i j).val+(e-c) = ((i j).val+(d-c))+(e-d)
    omega

/-- The stable labels retain all actual growing finite orbit legs. -/
private def stableOrbitCocone (n : ℕ) : Cocone (orbitIndexDiagram n) where
  pt := StableOrbitIndex n
  ι :=
    { app c := TypeCat.ofHom (orbitIntoStable c n)
      naturality c d f := by
        apply ConcreteCategory.hom_ext
        intro i
        exact orbitIntoStable_inclusion n (leOfHom f) i }

private def chosenOrbitStage (n : ℕ) (i : StableOrbitIndex n) : ℕ :=
  Classical.choose (orbitIntoStable_stage_exists n i)

private def chosenOrbitLabel (n : ℕ) (i : StableOrbitIndex n) :
    OrbitIndex (chosenOrbitStage n i) n :=
  Classical.choose (Classical.choose_spec (orbitIntoStable_stage_exists n i))

private theorem chosenOrbitLabel_spec (n : ℕ) (i : StableOrbitIndex n) :
    orbitIntoStable (chosenOrbitStage n i) n (chosenOrbitLabel n i) = i :=
  Classical.choose_spec (Classical.choose_spec (orbitIntoStable_stage_exists n i))

private theorem orbitCocone_value_eq (n : ℕ) (s : Cocone (orbitIndexDiagram n))
    {c d : ℕ} (i : OrbitIndex c n) (j : OrbitIndex d n)
    (h : orbitIntoStable c n i = orbitIntoStable d n j) :
    s.ι.app c i = s.ι.app d j := by
  let e := c+d
  let hc : c ≤ e := Nat.le_add_right c d
  let hd : d ≤ e := Nat.le_add_left d c
  have hi : s.ι.app e (orbitInclusion n hc i) = s.ι.app c i :=
    ConcreteCategory.congr_hom (s.w (homOfLE hc)) i
  have hj : s.ι.app e (orbitInclusion n hd j) = s.ι.app d j :=
    ConcreteCategory.congr_hom (s.w (homOfLE hd)) j
  have he : orbitInclusion n hc i = orbitInclusion n hd j :=
    orbitInclusion_eventually_eq n i j h
  exact hi.symm.trans ((congrArg (s.ι.app e) he).trans hj)

/-- The actual growing finite orbit diagram has this exact label union as its colimit. -/
private def stableOrbitCoconeIsColimit (n : ℕ) : IsColimit (stableOrbitCocone n) where
  desc s := TypeCat.ofHom (fun i => s.ι.app (chosenOrbitStage n i) (chosenOrbitLabel n i))
  fac s c := by
    apply ConcreteCategory.hom_ext
    intro i
    change s.ι.app (chosenOrbitStage n (orbitIntoStable c n i))
      (chosenOrbitLabel n (orbitIntoStable c n i)) = s.ι.app c i
    exact orbitCocone_value_eq n s _ _ (chosenOrbitLabel_spec n (orbitIntoStable c n i))
  uniq s m hm := by
    change StableOrbitIndex n ⟶ s.pt at m
    apply ConcreteCategory.hom_ext
    intro i
    have hi := ConcreteCategory.congr_hom (hm (chosenOrbitStage n i)) (chosenOrbitLabel n i)
    change m (orbitIntoStable (chosenOrbitStage n i) n (chosenOrbitLabel n i)) =
      s.ι.app (chosenOrbitStage n i) (chosenOrbitLabel n i) at hi
    rw [chosenOrbitLabel_spec] at hi
    exact hi



/-- The original successor map is the same map in the entire actual orbit diagram. -/
private theorem orbitInclusion_successor (c n : ℕ) (i : OrbitIndex c n) :
    orbitInclusion n (Nat.le_succ c) i = growOrbit c n i := by
  apply Function.Embedding.ext
  intro j
  apply Fin.ext
  change (i j).val + (c + 1 - c) = (i j).val + 1
  omega

section OrbitCopower
universe uD vD
variable {D : Type uD} [Category.{vD} D] [HasColimitsOfSize.{0, 0} D]

private def orbitCopowerInclusion (n : ℕ) {c d : ℕ} (h : c ≤ d) (Z : D) :
    (∐ fun _ : OrbitIndex c n => Z) ⟶ ∐ fun _ : OrbitIndex d n => Z :=
  Sigma.desc (fun i => Sigma.ι (fun _ : OrbitIndex d n => Z) (orbitInclusion n h i))

private theorem orbitCopowerInclusion_leg (n : ℕ) {c d : ℕ} (h : c ≤ d) (Z : D)
    (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ orbitCopowerInclusion n h Z =
      Sigma.ι (fun _ : OrbitIndex d n => Z) (orbitInclusion n h i) :=
  Sigma.ι_comp_desc _ _

private def orbitCopowerDiagram (n : ℕ) (Z : D) : ℕ ⥤ D where
  obj c := ∐ fun _ : OrbitIndex c n => Z
  map f := orbitCopowerInclusion n (leOfHom f) Z
  map_id c := by
    apply Sigma.hom_ext
    intro i
    rw [orbitCopowerInclusion_leg, Category.comp_id]
    exact congrArg (Sigma.ι (fun _ : OrbitIndex c n => Z))
      (ConcreteCategory.congr_hom ((orbitIndexDiagram n).map_id c) i)
  map_comp {c d e} f g := by
    apply Sigma.hom_ext
    intro i
    rw [orbitCopowerInclusion_leg, ← Category.assoc, orbitCopowerInclusion_leg,
      orbitCopowerInclusion_leg]
    exact congrArg (Sigma.ι (fun _ : OrbitIndex e n => Z))
      (ConcreteCategory.congr_hom ((orbitIndexDiagram n).map_comp f g) i)

/-- Literal source domain and target of the entire stable orbit leg. -/
private def stableOrbitCopowerLeg (n c : ℕ) (Z : D) :
    (∐ fun _ : OrbitIndex c n => Z) ⟶ ∐ fun _ : StableOrbitIndex n => Z :=
  Sigma.desc (fun i => Sigma.ι (fun _ : StableOrbitIndex n => Z) (orbitIntoStable c n i))

private theorem stableOrbitCopowerLeg_leg (n c : ℕ) (Z : D) (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ stableOrbitCopowerLeg n c Z =
      Sigma.ι (fun _ : StableOrbitIndex n => Z) (orbitIntoStable c n i) :=
  Sigma.ι_comp_desc _ _

private def stableOrbitCopowerCocone (n : ℕ) (Z : D) : Cocone (orbitCopowerDiagram n Z) where
  pt := ∐ fun _ : StableOrbitIndex n => Z
  ι :=
    { app c := stableOrbitCopowerLeg n c Z
      naturality c d f := by
        change orbitCopowerInclusion n (leOfHom f) Z ≫ stableOrbitCopowerLeg n d Z =
          stableOrbitCopowerLeg n c Z ≫ 𝟙 _
        rw [Category.comp_id]
        apply Sigma.hom_ext
        intro i
        rw [← Category.assoc, orbitCopowerInclusion_leg, stableOrbitCopowerLeg_leg,
          stableOrbitCopowerLeg_leg]
        exact congrArg (Sigma.ι (fun _ : StableOrbitIndex n => Z))
          (orbitIntoStable_inclusion n (leOfHom f) i) }

/-- The original caller cocone leg, with its complete copower source exposed. -/
private def orbitCopowerCoconeLeg (n : ℕ) (Z : D) (s : Cocone (orbitCopowerDiagram n Z)) (c : ℕ) :
    (∐ fun _ : OrbitIndex c n => Z) ⟶ s.pt := s.ι.app c

private theorem orbitCopowerCoconeLeg_naturality (n : ℕ) (Z : D)
    (s : Cocone (orbitCopowerDiagram n Z)) {c d : ℕ} (h : c ≤ d) :
    orbitCopowerInclusion n h Z ≫ orbitCopowerCoconeLeg n Z s d =
      orbitCopowerCoconeLeg n Z s c := s.w (homOfLE h)

private theorem orbitCopowerCoconeLeg_future (n : ℕ) (Z : D)
    (s : Cocone (orbitCopowerDiagram n Z)) {c d : ℕ} (h : c ≤ d) (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex d n => Z) (orbitInclusion n h i) ≫
        orbitCopowerCoconeLeg n Z s d =
      Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ orbitCopowerCoconeLeg n Z s c := by
  let j := Sigma.ι (fun _ : OrbitIndex c n => Z) i
  let j' := Sigma.ι (fun _ : OrbitIndex d n => Z) (orbitInclusion n h i)
  let t := orbitCopowerInclusion n h Z
  let l := orbitCopowerCoconeLeg n Z s c
  let l' := orbitCopowerCoconeLeg n Z s d
  have hj : j ≫ t = j' := orbitCopowerInclusion_leg n h Z i
  have hl : t ≫ l' = l := orbitCopowerCoconeLeg_naturality n Z s h
  change j' ≫ l' = j ≫ l
  exact (congrArg (fun a => a ≫ l') hj.symm).trans
    ((Category.assoc j t l').trans (congrArg (fun a => j ≫ a) hl))

private theorem orbitCopowerCocone_value_eq (n : ℕ) (Z : D)
    (s : Cocone (orbitCopowerDiagram n Z)) {c d : ℕ}
    (i : OrbitIndex c n) (j : OrbitIndex d n)
    (h : orbitIntoStable c n i = orbitIntoStable d n j) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ orbitCopowerCoconeLeg n Z s c =
      Sigma.ι (fun _ : OrbitIndex d n => Z) j ≫ orbitCopowerCoconeLeg n Z s d := by
  have hi := orbitCopowerCoconeLeg_future n Z s (Nat.le_add_right c d) i
  have hj := orbitCopowerCoconeLeg_future n Z s (Nat.le_add_left d c) j
  have he := orbitInclusion_eventually_eq n i j h
  exact hi.symm.trans ((congrArg
    (fun k => Sigma.ι (fun _ : OrbitIndex (c + d) n => Z) k ≫
      orbitCopowerCoconeLeg n Z s (c + d)) he).trans hj)

private def orbitCopowerDesc (n : ℕ) (Z : D) (s : Cocone (orbitCopowerDiagram n Z)) :
    (∐ fun _ : StableOrbitIndex n => Z) ⟶ s.pt :=
  Sigma.desc (fun i =>
    Sigma.ι (fun _ : OrbitIndex (chosenOrbitStage n i) n => Z) (chosenOrbitLabel n i) ≫
      orbitCopowerCoconeLeg n Z s (chosenOrbitStage n i))

private theorem orbitCopowerDesc_leg (n : ℕ) (Z : D) (s : Cocone (orbitCopowerDiagram n Z))
    (i : StableOrbitIndex n) :
    Sigma.ι (fun _ : StableOrbitIndex n => Z) i ≫ orbitCopowerDesc n Z s =
      Sigma.ι (fun _ : OrbitIndex (chosenOrbitStage n i) n => Z) (chosenOrbitLabel n i) ≫
        orbitCopowerCoconeLeg n Z s (chosenOrbitStage n i) :=
  Sigma.ι_comp_desc _ _

private def stableOrbitCopowerCoconeIsColimit (n : ℕ) (Z : D) :
    IsColimit (stableOrbitCopowerCocone n Z) where
  desc s := orbitCopowerDesc n Z s
  fac s c := by
    change stableOrbitCopowerLeg n c Z ≫ orbitCopowerDesc n Z s =
      orbitCopowerCoconeLeg n Z s c
    apply Sigma.hom_ext
    intro i
    rw [← Category.assoc, stableOrbitCopowerLeg_leg, orbitCopowerDesc_leg]
    exact orbitCopowerCocone_value_eq n Z s _ _
      (chosenOrbitLabel_spec n (orbitIntoStable c n i))
  uniq s m hm := by
    change (∐ fun _ : StableOrbitIndex n => Z) ⟶ s.pt at m
    change m = orbitCopowerDesc n Z s
    apply Sigma.hom_ext
    intro i
    let c := chosenOrbitStage n i
    let j := chosenOrbitLabel n i
    have hc : stableOrbitCopowerLeg n c Z ≫ m = orbitCopowerCoconeLeg n Z s c := hm c
    have hi := congrArg (fun f => Sigma.ι (fun _ : OrbitIndex c n => Z) j ≫ f) hc
    rw [← Category.assoc, stableOrbitCopowerLeg_leg] at hi
    rw [chosenOrbitLabel_spec] at hi
    exact hi.trans (orbitCopowerDesc_leg n Z s i).symm

private def orbitCopowerColimitLeg (n c : ℕ) (Z : D) :
    (∐ fun _ : OrbitIndex c n => Z) ⟶ colimit (orbitCopowerDiagram n Z) :=
  colimit.ι (orbitCopowerDiagram n Z) c

private def stableOrbitCopowerIso (n : ℕ) (Z : D) :
    colimit (orbitCopowerDiagram n Z) ≅ ∐ fun _ : StableOrbitIndex n => Z :=
  (colimit.isColimit (orbitCopowerDiagram n Z)).coconePointUniqueUpToIso
    (stableOrbitCopowerCoconeIsColimit n Z)

private theorem stableOrbitCopowerIso_hom_leg (n c : ℕ) (Z : D) (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ orbitCopowerColimitLeg n c Z ≫
        (stableOrbitCopowerIso n Z).hom =
      Sigma.ι (fun _ : StableOrbitIndex n => Z) (orbitIntoStable c n i) := by
  have h : orbitCopowerColimitLeg n c Z ≫ (stableOrbitCopowerIso n Z).hom =
      stableOrbitCopowerLeg n c Z :=
    IsColimit.comp_coconePointUniqueUpToIso_hom (colimit.isColimit (orbitCopowerDiagram n Z))
      (stableOrbitCopowerCoconeIsColimit n Z) c
  rw [h]
  exact stableOrbitCopowerLeg_leg n c Z i

private theorem stableOrbitCopowerIso_inv_leg (n c : ℕ) (Z : D) (i : OrbitIndex c n) :
    Sigma.ι (fun _ : StableOrbitIndex n => Z) (orbitIntoStable c n i) ≫
        (stableOrbitCopowerIso n Z).inv =
      Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ orbitCopowerColimitLeg n c Z := by
  apply (cancel_mono (stableOrbitCopowerIso n Z).hom).1
  rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact ((Category.assoc _ _ _).trans (stableOrbitCopowerIso_hom_leg n c Z i)).symm

private def orbitCopowerCoefficientArrow (n c : ℕ) {Z Z' : D} (f : Z ⟶ Z') :
    (∐ fun _ : OrbitIndex c n => Z) ⟶ ∐ fun _ : OrbitIndex c n => Z' :=
  Limits.Sigma.map (fun _ : OrbitIndex c n => f)

private def orbitCopowerCoefficientMap (n : ℕ) {Z Z' : D} (f : Z ⟶ Z') :
    orbitCopowerDiagram n Z ⟶ orbitCopowerDiagram n Z' where
  app c := orbitCopowerCoefficientArrow n c f
  naturality c d a := by
    change orbitCopowerInclusion n (leOfHom a) Z ≫ orbitCopowerCoefficientArrow n d f =
      orbitCopowerCoefficientArrow n c f ≫ orbitCopowerInclusion n (leOfHom a) Z'
    apply Sigma.hom_ext
    intro i
    change Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ (_ ≫ _) = _
    rw [← Category.assoc, orbitCopowerInclusion_leg]
    change Sigma.ι (fun _ : OrbitIndex d n => Z) _ ≫ Limits.Sigma.map _ =
      Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫
        (Limits.Sigma.map _ ≫ orbitCopowerInclusion n (leOfHom a) Z')
    rw [Sigma.ι_map, ← Category.assoc, Sigma.ι_map, Category.assoc,
      orbitCopowerInclusion_leg]

private theorem stableOrbitCopowerIso_naturality (n : ℕ) {Z Z' : D} (f : Z ⟶ Z') :
    colim.map (orbitCopowerCoefficientMap n f) ≫ (stableOrbitCopowerIso n Z').hom =
      (stableOrbitCopowerIso n Z).hom ≫ Limits.Sigma.map (fun _ : StableOrbitIndex n => f) := by
  let t := orbitCopowerCoefficientMap n f
  have ht (c : ℕ) : orbitCopowerColimitLeg n c Z ≫ colim.map t =
      orbitCopowerCoefficientArrow n c f ≫ orbitCopowerColimitLeg n c Z' :=
    ι_colimMap t c
  apply colimit.hom_ext
  intro c
  apply Sigma.hom_ext
  intro i
  let i₀ := Sigma.ι (fun _ : OrbitIndex c n => Z) i
  let i₁ := Sigma.ι (fun _ : OrbitIndex c n => Z') i
  let j₀ := Sigma.ι (fun _ : StableOrbitIndex n => Z) (orbitIntoStable c n i)
  let j₁ := Sigma.ι (fun _ : StableOrbitIndex n => Z') (orbitIntoStable c n i)
  let l₀ := orbitCopowerColimitLeg n c Z
  let l₁ := orbitCopowerColimitLeg n c Z'
  let e₀ := (stableOrbitCopowerIso n Z).hom
  let e₁ := (stableOrbitCopowerIso n Z').hom
  let u := orbitCopowerCoefficientArrow n c f
  let w := Limits.Sigma.map (fun _ : StableOrbitIndex n => f)
  let m := colim.map t
  have hT : l₀ ≫ m = u ≫ l₁ := ht c
  have hU : i₀ ≫ u = f ≫ i₁ := Sigma.ι_map (fun _ : OrbitIndex c n => f) i
  have hX : i₀ ≫ l₀ ≫ e₀ = j₀ := stableOrbitCopowerIso_hom_leg n c Z i
  have hY : i₁ ≫ l₁ ≫ e₁ = j₁ := stableOrbitCopowerIso_hom_leg n c Z' i
  have hW : j₀ ≫ w = f ≫ j₁ :=
    Sigma.ι_map (fun _ : StableOrbitIndex n => f) (orbitIntoStable c n i)
  change i₀ ≫ (l₀ ≫ (m ≫ e₁)) = i₀ ≫ (l₀ ≫ (e₀ ≫ w))
  calc
    _ = i₀ ≫ ((l₀ ≫ m) ≫ e₁) := by rw [Category.assoc]
    _ = i₀ ≫ ((u ≫ l₁) ≫ e₁) := congrArg (fun k => i₀ ≫ (k ≫ e₁)) hT
    _ = (i₀ ≫ u) ≫ (l₁ ≫ e₁) := by simp only [Category.assoc]
    _ = (f ≫ i₁) ≫ (l₁ ≫ e₁) := congrArg (fun k => k ≫ (l₁ ≫ e₁)) hU
    _ = f ≫ (i₁ ≫ l₁ ≫ e₁) := Category.assoc _ _ _
    _ = f ≫ j₁ := congrArg (fun k => f ≫ k) hY
    _ = j₀ ≫ w := hW.symm
    _ = (i₀ ≫ l₀ ≫ e₀) ≫ w := congrArg (fun k => k ≫ w) hX.symm
    _ = _ := by simp only [Category.assoc]

end OrbitCopower

