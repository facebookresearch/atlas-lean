/-- The entire original orthogonal initial factor object family, before choosing an input. -/
private def originalInitialCellObjectFamily : C.{u, v} → C.{u, v} :=
  fun X => SmallObject.obj I realizedGeneratorCardinal (Diagrams.zeroTo X)

private theorem originalInitialCellObjectFamily_original :
    originalInitialCellObjectFamily.{u, v} (B := B) =
      (fun X : C.{u, v} => SmallObject.obj I realizedGeneratorCardinal (Diagrams.zeroTo X)) :=
  rfl

