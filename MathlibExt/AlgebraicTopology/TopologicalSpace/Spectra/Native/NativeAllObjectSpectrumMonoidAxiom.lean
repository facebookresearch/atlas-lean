  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers
  NativeOmegaPreparation.SymmetricFunction.sequenceEqualizers
  PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  NativeOmegaPreparation.SymmetricFunction.sequenceClosed
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.symmetricCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalClosed

/-- The original sphere coefficient retains its full permutation action. -/
private abbrev freeSphereCoefficient (n : ℕ) : V.{u, v} :=
  PointedCGWH.sphereSequence.{u, v}.functor.obj (Operad.SmallFinBijGroupoid.card n)

/-- The actual native free sphere in the source's generating degree. -/
private abbrev freeSphere (n : ℕ) : Carrier.{u, v} :=
  Free.object (PointedCGWH.symmetricOperatorObj.{u, v} (Operad.SmallFinBijGroupoid.card n))
    (freeSphereCoefficient.{u, v} n)

/-- The actual balanced tensor functor with that original free sphere. -/
private abbrev freeSphereSmash (n : ℕ) : Carrier.{u, v} ⥤ Carrier.{u, v} :=
  MonoidalCategory.tensorLeft (freeSphere.{u, v} n)

/-- The original degree-zero sphere coefficient is the actual pointed tensor unit. -/
private def zeroCoefficientUnitIso : freeSphereCoefficient.{u, v} 0 ≅ (𝟙_ V.{u, v}) := by
  apply eqToIso
  change PointedCGWH.sphereSequence.{u, v}.functor.obj
    (Operad.SmallFinBijGroupoid.card 0) = (𝟙_ PointedCGWH.{u, v})
  rw [PointedCGWH.sphereSequence_obj]
  rfl

/-- The actual free sphere at zero is the original transported sphere-module tensor unit. -/
private def freeSphereZeroIso : freeSphere.{u, v} 0 ≅ (𝟙_ Carrier.{u, v}) :=
  (Free.functor (PointedCGWH.symmetricOperatorObj.{u, v}
    (Operad.SmallFinBijGroupoid.card 0))).mapIso zeroCoefficientUnitIso.{u, v} ≪≫
      PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.freeZeroIsoSphereUnit.{u, v}

/-- The whole zero-degree free-sphere tensor is the identity on all original spectra and maps. -/
private def freeSphereZeroSmashIso : freeSphereSmash.{u, v} 0 ≅ 𝟭 Carrier.{u, v} :=
  (curriedTensor Carrier.{u, v}).mapIso freeSphereZeroIso.{u, v} ≪≫
    leftUnitorNatIso Carrier.{u, v}

/-- Every integer-degree map is retained through the actual zero-degree free-sphere unit. -/
private theorem freeSphereZero_integerPi_iff (q : ℤ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
      ((freeSphereSmash.{u, v} 0).map f)) ↔
        IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map f) :=
  NatIso.isIso_map_iff
    (Functor.isoWhiskerRight freeSphereZeroSmashIso.{u, v}
      (Actual.SymmetricIntegerHomotopy.integerPiFunctor q)) f

/-- Raw integer homotopy-group isomorphisms are preserved at zero with arbitrary endpoints. -/
private theorem freeSphereZero_integerPi_preserves {X Y : Carrier.{u, v}} (f : X ⟶ Y)
    (h : ∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map f)) :
    ∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
      ((freeSphereSmash.{u, v} 0).map f)) :=
  fun q => (freeSphereZero_integerPi_iff q f).mpr (h q)

/-- The actual sphere-sequence coefficient is the same original tensor power. -/
private def freeSphereCoefficientPowerIso (n : ℕ) : freeSphereCoefficient.{u, v} n ≅
    TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n := by
  apply eqToIso
  exact PointedCGWH.sphereSequence_obj (Operad.SmallFinBijGroupoid.card n)

/-- The entire original free sphere retains its actual free-power coefficient map. -/
private def freeSphereOriginalPowerIso (n : ℕ) : freeSphere.{u, v} n ≅
    NativeOmegaRecovery.OriginalCompleteRFreePowerIteration.freePower.{u, v} n :=
  (Free.functor (PointedCGWH.symmetricOperatorObj.{u, v}
    (Operad.SmallFinBijGroupoid.card n))).mapIso (freeSphereCoefficientPowerIso n)

/-- The actual function from the original free sphere is the complete original R iterate. -/
private def freeSphereRIterationIso (n : ℕ) :
    NativeOmegaPreparation.NativeSymmetricFunction.functor (freeSphere.{u, v} n) ≅
      NativeOmegaRecovery.NativeSymmetricR.iterate.{u, v} n :=
  (eqToIso (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.internalHom_eq_originalFunction
    (freeSphere n))).symm ≪≫
    MonoidalClosed.internalHom.mapIso (freeSphereOriginalPowerIso n).symm.op ≪≫
    eqToIso (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.internalHom_eq_originalFunction
      (NativeOmegaRecovery.OriginalCompleteRFreePowerIteration.freePower n)) ≪≫
    (NativeOmegaRecovery.OriginalCompleteRFreePowerIteration.originalRFreePowerIso n).symm

/-- Every original native input map is retained by the full function/R comparison. -/
private theorem freeSphereRIterationIso_naturality (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    (NativeOmegaPreparation.NativeSymmetricFunction.functor (freeSphere n)).map f ≫
        (freeSphereRIterationIso n).hom.app Y =
      (freeSphereRIterationIso n).hom.app X ≫
        (NativeOmegaRecovery.NativeSymmetricR.iterate n).map f :=
  (freeSphereRIterationIso n).hom.naturality f

/-- Both original function/R maps retain every full pointed parameter in every actual degree. -/
private theorem freeSphereRIterationIso_parameter (n : ℕ) (X : Carrier.{u, v})
    (m : Operad.SmallFinBijGroupoid) (W : V.{u, v})
    (p : W ⟶
      ((NativeOmegaPreparation.NativeSymmetricFunction.functor
        (freeSphere n)).obj X).toEnrichedFunctor.obj
          (PointedCGWH.symmetricOperatorObj.{u, v} m)) :
    (p ≫ component ((freeSphereRIterationIso n).hom.app X)
      (PointedCGWH.symmetricOperatorObj.{u, v} m)) ≫
        component ((freeSphereRIterationIso n).inv.app X)
          (PointedCGWH.symmetricOperatorObj.{u, v} m) = p := by
  have h := congrArg (fun f => component f (PointedCGWH.symmetricOperatorObj.{u, v} m))
    ((freeSphereRIterationIso n).hom_inv_id_app X)
  rw [component_comp, component_id] at h
  rw [Category.assoc, h, Category.comp_id]

/-- Every actual original sphere coefficient is cofibrant in the fixed pointed model. -/
private theorem freeSphereCoefficient_isCofibrant (n : ℕ) :
    IsCofibrant (freeSphereCoefficient.{u, v} n) := by
  change IsCofibrant (PointedCGWH.sphereSequence.{u, v}.functor.obj
    (Operad.SmallFinBijGroupoid.card n))
  rw [PointedCGWH.sphereSequence_obj]
  exact PointedCGWH.modelCategory.tensorPowObj_sphereOne_isCofibrant n


end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3
end

end

