private theorem pre_scalarAction {Z : Type*} [Category Z] [MonoidalCategory Z]
    [SymmetricCategory Z] (K A M X Y : Z) (g : K ⟶ A) (s : A ⊗ X ⟶ Y) :
    (g ▷ (M ⊗ X)) ≫ (α_ A M X).inv ≫ ((β_ A M).hom ▷ X) ≫
        (α_ M A X).hom ≫ (M ◁ s) =
      (α_ K M X).inv ≫ ((β_ K M).hom ▷ X) ≫ (α_ M K X).hom ≫
        (M ◁ ((g ▷ X) ≫ s)) := by
  rw [associator_inv_naturality_left_assoc, ← comp_whiskerRight_assoc,
    braiding_naturality_left, comp_whiskerRight_assoc, associator_naturality_middle_assoc,
    ← whiskerLeft_comp]

