/-- Every original finite coprojection is retained by the full forward comparison. -/
@[reassoc]
private theorem finiteIntegerCoproductIso_hom_leg [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (i : α) :
    (integerStablePiCommFunctor q).map (Sigma.ι X i) ≫ (finiteIntegerCoproductIso q X).hom =
