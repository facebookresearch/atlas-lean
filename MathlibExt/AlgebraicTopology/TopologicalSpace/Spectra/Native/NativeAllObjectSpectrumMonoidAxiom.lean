/-!
## Integer homotopy groups of original closed sequential spectrum colimits

For an arbitrary Nat diagram of genuine sequential spectra, levelwise closed
embeddings make the positive homotopy comparison at each original integer
diagonal stage an isomorphism. Its naturality uses every original diagonal
map, including the structure and degree maps. The two original filtered group
colimits are then exchanged by their genuine Fubini isomorphism.

The result preserves the caller's colimit cocone, both entire comparison maps,
the original integer tail, all group quotient legs, and arbitrary maps of the
diagram and caller cocone. No condition on the endpoint spectrum is required.
-/

noncomputable section
universe u v

open CategoryTheory CategoryTheory.Limits Topology

namespace PointedCGWH.Spectra.OriginalSequentialClosedIntegerPi

open PointedCGWH.SequentialSpectrum
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open PointedCGWH.SequentialSpectrum.StableHomotopy.IntegerColimitNormalization
open PointedCGWH.SequentialHomotopyColimit
open GrpCat.FilteredColimits.Fubini GrpCat.FilteredColimits.PointwiseComparison

private theorem pointedNatColimits : HasColimitsOfShape ℕ PointedCGWH.{u, v} := by
  let e : ULift.{v} ℕ ≃o ℕ := ULift.orderIso
  let _ : HasColimitsOfShape (ULift.{v} ℕ) PointedCGWH.{u, v} := inferInstance
  exact hasColimitsOfShape_of_equivalence e.equivalence

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf
  pointedNatColimits

/-- Closedness is imposed on every actual original level map of the full Nat diagram. -/
private def LevelwiseClosed (F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}) : Prop :=
  ∀ ⦃i j : ℕ⦄ (f : i ⟶ j) (m : ℕ),
    IsClosedEmbedding (ConcreteCategory.hom (levelMap (F.map f) m).right)

/-- The original spectrum diagram evaluated at one original level. -/
private def levelDiagram (F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}) (m : ℕ) :
    ℕ ⥤ PointedCGWH.{u, v} := F ⋙ evaluation m

/-- The caller's actual cocone evaluated at the same original level. -/
private def levelCocone {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}} (c : Cocone F) (m : ℕ) :
    Cocone (levelDiagram F m) := (evaluation m).mapCocone c

/-- Every evaluated caller leg is its original spectrum morphism component. -/
private theorem levelCocone_leg {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (m i : ℕ) :
    (levelCocone c m).ι.app i = levelMap (c.ι.app i) m := rfl

/-- Genuine enriched evaluation preserves the caller's colimit universal property. -/
private def levelCoconeIsColimit {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (m : ℕ) : IsColimit (levelCocone c m) :=
  isColimitOfPreserves (evaluation m) hc

/-- Both indices use the original diagram and original integer diagonal functor. -/
private def matrix (q : ℤ) (F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}) :
    ℕ ⥤ ℕ ⥤ GrpCat.{v} := F ⋙ integerDiagonalDiagramFunctor q

/-- Every column is the literal positive homotopy diagram of the original level. -/
private theorem matrix_flip_obj (q : ℤ) (F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}) (n : ℕ) :
    (matrix q F).flip.obj n = levelDiagram F (integerTailLevel q + n) ⋙
      piNPositiveFunctor (integerTailPositiveIndex q + n) := rfl

/-- Every column transition is the full original diagonal transition at each input spectrum. -/
private theorem matrix_flip_map_app (q : ℤ) (F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v})
    {n m : ℕ} (f : n ⟶ m) (i : ℕ) :
    ((matrix q F).flip.map f).app i =
      ((integerDiagonalDiagramFunctor q).obj (F.obj i)).map f := rfl

/-- Every successor column uses the original structure and simultaneous degree/level maps. -/
private theorem matrix_flip_map_succ_app (q : ℤ) (F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v})
    (n i : ℕ) :
    ((matrix q F).flip.map (homOfLE (Nat.le_succ n))).app i =
      (diagonalTransition n (integerTailLevel q) (integerTailPositiveIndex q)).app (F.obj i) :=
  diagonalDiagram_map_succ (F.obj i) (integerTailLevel q) (integerTailPositiveIndex q) n

/-- The full matrix cocone is the original diagonal functor applied to the caller cocone. -/
private def matrixCocone (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}} (c : Cocone F) :
    Cocone (matrix q F) := (integerDiagonalDiagramFunctor q).mapCocone c

/-- Every entire matrix leg is the original diagonal map of the caller's spectrum leg. -/
private theorem matrixCocone_leg (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (i : ℕ) :
    (matrixCocone q c).ι.app i = (integerDiagonalDiagramFunctor q).map (c.ι.app i) := rfl

/-- Compact representatives and relative homotopies give both original column comparisons. -/
private def componentIso (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (n : ℕ) :
    GrpCat.FilteredColimits.colimit ((matrix q F).flip.obj n) ≅
      (matrixCocone q c).pt.obj n :=
  piNPositiveComparisonIso (integerTailPositiveIndex q + n)
    (levelCocone c (integerTailLevel q + n))
    (levelCoconeIsColimit c hc (integerTailLevel q + n))
    (fun _ _ f => hF f (integerTailLevel q + n))

/-- The entire column hom is the original universal-property descent, on all its group legs. -/
private theorem componentIso_hom (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (n : ℕ) :
    (componentIso q c hc hF n).hom = pointwiseDesc (matrix q F) (matrixCocone q c) n := by
  apply (GrpCat.FilteredColimits.colimitCoconeIsColimit ((matrix q F).flip.obj n)).hom_ext
  intro i
  have hIso := piNPositiveComparisonIso_hom (integerTailPositiveIndex q + n)
    (levelCocone c (integerTailLevel q + n))
    (levelCoconeIsColimit c hc (integerTailLevel q + n))
    (fun _ _ f => hF f (integerTailLevel q + n))
  have hCompact := piNPositiveComparison_ι (integerTailPositiveIndex q + n)
    (levelCocone c (integerTailLevel q + n)) i
  have hDesc := pointwiseDesc_fac (matrix q F) (matrixCocone q c) n i
  exact (congrArg (fun f =>
    (GrpCat.FilteredColimits.colimitCocone ((matrix q F).flip.obj n)).ι.app i ≫ f) hIso).trans
      (hCompact.trans hDesc.symm)

/-- Column comparisons are natural in every original structure and loop-degree leg before Fubini. -/
private theorem componentIso_hom_naturality (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) {n m : ℕ} (f : n ⟶ m) :
    GrpCat.FilteredColimits.colimitMap ((matrix q F).flip.map f) ≫
        (componentIso q c hc hF m).hom =
      (componentIso q c hc hF n).hom ≫ (matrixCocone q c).pt.map f := by
  rw [componentIso_hom, componentIso_hom]
  exact (pointwiseComparison (matrix q F) (matrixCocone q c)).naturality f

/-- The whole pointwise isomorphism uses the proved original column isomorphisms. -/
private def pointwiseIso (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    (matrix q F).flip ⋙ GrpCat.FilteredColimits.colimitFunctor ≅ (matrixCocone q c).pt :=
  NatIso.ofComponents (componentIso q c hc hF) (componentIso_hom_naturality q c hc hF)

/-- The whole pointwise hom is the original full comparison transformation. -/
private theorem pointwiseIso_hom (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    (pointwiseIso q c hc hF).hom = pointwiseComparison (matrix q F) (matrixCocone q c) := by
  apply NatTrans.ext
  funext n
  exact componentIso_hom q c hc hF n

/-- Every inverse column is the actual inverse fixed-level compact homotopy comparison. -/
private theorem pointwiseIso_inv_app (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (n : ℕ) :
    (pointwiseIso q c hc hF).inv.app n =
      (piNPositiveComparisonIso (integerTailPositiveIndex q + n)
        (levelCocone c (integerTailLevel q + n))
        (levelCoconeIsColimit c hc (integerTailLevel q + n))
        (fun _ _ f => hF f (integerTailLevel q + n))).inv := rfl

/-- Both original inverse column maps preserve all original diagonal structure legs. -/
private theorem componentIso_inv_naturality (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) {n m : ℕ} (f : n ⟶ m) :
    (matrixCocone q c).pt.map f ≫ (componentIso q c hc hF m).inv =
      (componentIso q c hc hF n).inv ≫
        GrpCat.FilteredColimits.colimitMap ((matrix q F).flip.map f) :=
  (pointwiseIso q c hc hF).inv.naturality f

/-- The actual original outer integer homotopy comparison is its group-colimit descent. -/
private def comparison (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}} (c : Cocone F) :
    GrpCat.FilteredColimits.colimit (F ⋙ integerStablePiFunctor q) ⟶
      (integerStablePiFunctor q).obj c.pt :=
  (GrpCat.FilteredColimits.colimitCoconeIsColimit (F ⋙ integerStablePiFunctor q)).desc
    ((integerStablePiFunctor q).mapCocone c)

/-- Genuine Fubini and the proved whole pointwise comparison give both original integer maps. -/
private def comparisonIso (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    GrpCat.FilteredColimits.colimit (F ⋙ integerStablePiFunctor q) ≅
      (integerStablePiFunctor q).obj c.pt :=
  groupCoconeComparisonIso (matrix q F) (matrixCocone q c) (pointwiseIso q c hc hF)

/-- The complete forward isomorphism is exactly the actual original outer group descent. -/
private theorem comparisonIso_hom (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    (comparisonIso q c hc hF).hom = comparison q c :=
  groupCoconeComparisonIso_hom (matrix q F) (matrixCocone q c)
    (pointwiseIso q c hc hF) (pointwiseIso_hom q c hc hF)

/-- The entire forward map keeps the two original Nat quotients and genuine Fubini hom. -/
private theorem comparisonIso_hom_fubini (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    (comparisonIso q c hc hF).hom = (fubiniIso (matrix q F)).hom ≫
      GrpCat.FilteredColimits.colimitMap (pointwiseIso q c hc hF).hom := rfl

/-- The entire inverse keeps the actual compact group inverses and genuine Fubini inverse. -/
private theorem comparisonIso_inv (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    (comparisonIso q c hc hF).inv =
      GrpCat.FilteredColimits.colimitMap (pointwiseIso q c hc hF).inv ≫
        (fubiniIso (matrix q F)).inv := rfl

/-- Every original outer quotient leg maps to its actual caller integer homotopy leg. -/
private theorem comparisonIso_hom_leg (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (i : ℕ) :
    (GrpCat.FilteredColimits.colimitCocone (F ⋙ integerStablePiFunctor q)).ι.app i ≫
        (comparisonIso q c hc hF).hom = (integerStablePiFunctor q).map (c.ι.app i) := by
  rw [comparisonIso_hom]
  exact (GrpCat.FilteredColimits.colimitCoconeIsColimit
    (F ⋙ integerStablePiFunctor q)).fac ((integerStablePiFunctor q).mapCocone c) i

/-- Every entire caller integer homotopy leg returns its original outer quotient leg. -/
private theorem comparisonIso_inv_leg (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (i : ℕ) :
    (integerStablePiFunctor q).map (c.ι.app i) ≫ (comparisonIso q c hc hF).inv =
      (GrpCat.FilteredColimits.colimitCocone (F ⋙ integerStablePiFunctor q)).ι.app i := by
  apply (cancel_mono (comparisonIso q c hc hF).hom).1
  rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact (comparisonIso_hom_leg q c hc hF i).symm

/-- Every pair of original spectrum and diagonal quotient legs keeps its exact positive level map. -/
private theorem comparisonIso_hom_joint_leg (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (i n : ℕ) :
    jointLeg (matrix q F) i n ≫ (comparisonIso q c hc hF).hom =
      (piNPositiveFunctor (integerTailPositiveIndex q + n)).map
        (levelMap (c.ι.app i) (integerTailLevel q + n)) ≫ integerStablePiLeg q c.pt n := by
  rw [comparisonIso_hom]
  exact groupCoconeComparisonDesc_joint_fac (matrix q F) (matrixCocone q c) i n

/-- The inverse comparison preserves the same complete original pair of quotient legs. -/
private theorem comparisonIso_inv_joint_leg (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (i n : ℕ) :
    ((piNPositiveFunctor (integerTailPositiveIndex q + n)).map
        (levelMap (c.ι.app i) (integerTailLevel q + n)) ≫ integerStablePiLeg q c.pt n) ≫
          (comparisonIso q c hc hF).inv = jointLeg (matrix q F) i n := by
  apply (cancel_mono (comparisonIso q c hc hF).hom).1
  rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact (comparisonIso_hom_joint_leg q c hc hF i n).symm

/-- The actual integer functor maps every original closed sequential colimit cocone to a colimit. -/
private def comparisonIsColimit (q : ℤ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    IsColimit ((integerStablePiFunctor q).mapCocone c) := by
  apply IsColimit.ofIsoColimit
    (GrpCat.FilteredColimits.colimitCoconeIsColimit (F ⋙ integerStablePiFunctor q))
  exact Cocone.ext (comparisonIso q c hc hF) (comparisonIso_hom_leg q c hc hF)

/-- Every map of complete original diagrams and caller cocones preserves the whole forward map. -/
private theorem comparisonIso_hom_naturality (q : ℤ)
    {F G : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}} (c : Cocone F) (d : Cocone G)
    (hc : IsColimit c) (hd : IsColimit d) (hF : LevelwiseClosed F) (hG : LevelwiseClosed G)
    (a : F ⟶ G) (g : c.pt ⟶ d.pt)
    (hg : ∀ i : ℕ, c.ι.app i ≫ g = a.app i ≫ d.ι.app i) :
    GrpCat.FilteredColimits.colimitMap (Functor.whiskerRight a (integerStablePiFunctor q)) ≫
        (comparisonIso q d hd hG).hom =
      (comparisonIso q c hc hF).hom ≫ (integerStablePiFunctor q).map g := by
  let D := integerDiagonalDiagramFunctor.{u, v} q
  have h := groupCoconeComparisonDesc_map_square (matrixCocone q c) (matrixCocone q d)
    (Functor.whiskerRight a D) (D.map g) (fun i =>
      (D.map_comp _ _).symm.trans ((D.congr_map (hg i).symm).trans (D.map_comp _ _)))
  rw [comparisonIso_hom, comparisonIso_hom]
  exact h

/-- Every map of the original diagrams and caller cocones preserves the entire inverse map. -/
private theorem comparisonIso_inv_naturality (q : ℤ)
    {F G : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}} (c : Cocone F) (d : Cocone G)
    (hc : IsColimit c) (hd : IsColimit d) (hF : LevelwiseClosed F) (hG : LevelwiseClosed G)
    (a : F ⟶ G) (g : c.pt ⟶ d.pt)
    (hg : ∀ i : ℕ, c.ι.app i ≫ g = a.app i ≫ d.ι.app i) :
    (integerStablePiFunctor q).map g ≫ (comparisonIso q d hd hG).inv =
      (comparisonIso q c hc hF).inv ≫
        GrpCat.FilteredColimits.colimitMap (Functor.whiskerRight a (integerStablePiFunctor q)) := by
  have h : (comparisonIso q c hc hF).inv ≫
      (GrpCat.FilteredColimits.colimitMap (Functor.whiskerRight a (integerStablePiFunctor q)) ≫
        (comparisonIso q d hd hG).hom) = (integerStablePiFunctor q).map g :=
    (Iso.inv_comp_eq (comparisonIso q c hc hF)).2
      (comparisonIso_hom_naturality q c d hc hd hF hG a g hg)
  exact (Iso.comp_inv_eq (comparisonIso q d hd hG)).2
    (h.symm.trans (Category.assoc _ _ _).symm)

/-- Any original finite diagonal offset compares using its actual integer normalization maps. -/
private def diagonalComparisonIso (m k : ℕ) {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) :
    GrpCat.FilteredColimits.colimit (F ⋙ diagonalColimitFunctor m k) ≅
      (diagonalColimitFunctor m k).obj c.pt :=
  GrpCat.FilteredColimits.colimitFunctor.mapIso
      (Functor.isoWhiskerLeft F (integerColimitNatIso m k)) ≪≫
    comparisonIso (integerDegree m k) c hc hF ≪≫ ((integerColimitNatIso m k).app c.pt).symm

/-- Offset normalization preserves every full original diagonal cocone leg. -/
private theorem diagonalComparisonIso_hom_leg (m k : ℕ)
    {F : ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v}}
    (c : Cocone F) (hc : IsColimit c) (hF : LevelwiseClosed F) (i : ℕ) :
    (GrpCat.FilteredColimits.colimitCocone (F ⋙ diagonalColimitFunctor m k)).ι.app i ≫
        (diagonalComparisonIso m k c hc hF).hom =
      (diagonalColimitFunctor m k).map (c.ι.app i) := by
  let N := integerColimitNatIso.{u, v} m k
  let e := comparisonIso (integerDegree m k) c hc hF
  let l : (diagonalColimitFunctor m k).obj (F.obj i) ⟶
      GrpCat.FilteredColimits.colimit (F ⋙ diagonalColimitFunctor m k) :=
    (GrpCat.FilteredColimits.colimitCocone (F ⋙ diagonalColimitFunctor m k)).ι.app i
  let t : (integerStablePiFunctor (integerDegree m k)).obj (F.obj i) ⟶
      GrpCat.FilteredColimits.colimit (F ⋙ integerStablePiFunctor (integerDegree m k)) :=
    (GrpCat.FilteredColimits.colimitCocone (F ⋙ integerStablePiFunctor (integerDegree m k))).ι.app i
  let a := GrpCat.FilteredColimits.colimitMap (Functor.whiskerLeft F N.hom)
  have hMap : l ≫ a = N.hom.app (F.obj i) ≫ t :=
    GrpCat.FilteredColimits.colimitMap_ι (Functor.whiskerLeft F N.hom) i
  have hOuter : t ≫ e.hom = (integerStablePiFunctor (integerDegree m k)).map (c.ι.app i) :=
    comparisonIso_hom_leg (integerDegree m k) c hc hF i
  have hJoined : l ≫ (a ≫ e.hom) = (diagonalColimitFunctor m k).map (c.ι.app i) ≫
      N.hom.app c.pt :=
    (Category.assoc l a e.hom).symm.trans
      ((congrArg (fun f => f ≫ e.hom) hMap).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (fun f => N.hom.app (F.obj i) ≫ f) hOuter).trans
            (N.hom.naturality (c.ι.app i)).symm)))
  have hFinal := (Iso.comp_inv_eq (N.app c.pt)).2 hJoined
  change l ≫ (a ≫ e.hom ≫ N.inv.app c.pt) = _
  exact (congrArg (fun f => l ≫ f) (Category.assoc a e.hom (N.inv.app c.pt)).symm).trans
    ((Category.assoc l (a ≫ e.hom) (N.inv.app c.pt)).symm.trans hFinal)

end PointedCGWH.Spectra.OriginalSequentialClosedIntegerPi
end

