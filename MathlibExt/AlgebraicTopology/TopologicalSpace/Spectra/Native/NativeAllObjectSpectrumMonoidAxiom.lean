/-- Every actual original operator, sphere degree and arbitrary spectrum
Arrow retains the same original free-sphere/free-unit integer equivalence. -/
private theorem allOriginalFreeSphereIntegerMaps (a : OrthogonalOperatorIndex.{u, v})
    (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map
