open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK.Actual.SymmetricIntegerHomotopy

attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers
  CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  MonoidalClosed.enrichedCategorySelf

private theorem restrictionInput_evaluation {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}}
    (f : Y ⟶ Z) (c : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c =
      (PointedCGWH.SymmetricSpectrum.evaluation (card c)).map f :=
  (underlying_map f c).trans
    ((PointedCGWH.SymmetricSpectrum.hom_app f (card c)).symm.trans
      (PointedCGWH.SymmetricSpectrum.evaluation_map (card c) f).symm)

/-- The original finite stage input component retains the same complete native evaluation. -/
private theorem nativeFreeSmashInputLevel_evaluation (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ) :
    nativeFreeSmashInputLevel n M f c =
      (PointedCGWH.SymmetricSpectrum.evaluation (card (c + n))).map
        ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).map f) :=
  restrictionInput_evaluation ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).map f) (c + n)

/-- The whole original native Day comparison is natural under the same actual free smash input map. -/
private theorem originalDayInput_naturality (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ) :
    nativeFreeSmashInputLevel n M f c ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Z (card (c + n))).hom =
      (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n))).hom ≫
        representedTensorCoefficientMap (PointedCGWH.SymmetricSpectrum.hom f)
          (card n) (card (c + n)) M := by
  have h := (RightTensorSource.nativeRightTensorLevelNatIso (card n) M (card (c + n))).hom.naturality f
  change (PointedCGWH.SymmetricSpectrum.evaluation (card (c + n))).map
      ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).map f) ≫
        (RightTensorSource.nativeRightTensorLevelNatIso (card n) M (card (c + n))).hom.app Z =
    (RightTensorSource.nativeRightTensorLevelNatIso (card n) M (card (c + n))).hom.app Y ≫
      representedTensorCoefficientMap (PointedCGWH.SymmetricSpectrum.hom f)
        (card n) (card (c + n)) M at h
  rw [RightTensorSource.nativeRightTensorLevelNatIso_hom_original,
    RightTensorSource.nativeRightTensorLevelNatIso_hom_original] at h
  exact (congrArg (fun g => g ≫
    (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Z (card (c + n))).hom)
      (nativeFreeSmashInputLevel_evaluation n M f c)).trans h

/-- The exact original coefficient-first Day generator at this unchanged block isomorphism. -/
private def coefficientFirstDayLeg (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) (e : card c ⊗ card n ≅ card (c + n)) :
    M ⊗ Y.X.functor.obj (card c) ⟶
      (Y.X ⊗ PointedCGWH.SymmetricSpectrum.freeDiagram (card n) M).functor.obj (card (c + n)) :=
  (β_ M (Y.X.functor.obj (card c))).hom ≫
    representedTensorGenerator Y.X (card n) (card (c + n)) M (CostructuredArrow.mk e.hom)

/-- The unchanged original Day generator retains every actual input component. -/
private theorem coefficientFirstDayLeg_input (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ)
    (e : card c ⊗ card n ≅ card (c + n)) :
    (M ◁ PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c) ≫
        coefficientFirstDayLeg n M Z c e =
      coefficientFirstDayLeg n M Y c e ≫
        representedTensorCoefficientMap (PointedCGWH.SymmetricSpectrum.hom f)
          (card n) (card (c + n)) M := by
  let g := (PointedCGWH.SymmetricSpectrum.hom f).natTrans.app (card c)
  let tY := representedTensorGenerator Y.X (card n) (card (c + n)) M
    (CostructuredArrow.mk e.hom)
  let tZ := representedTensorGenerator Z.X (card n) (card (c + n)) M
    (CostructuredArrow.mk e.hom)
  have hg : PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c = g :=
    (underlying_map f c).trans (PointedCGWH.SymmetricSpectrum.hom_app f (card c)).symm
  have hb := braiding_naturality_right M g
  have ht := representedTensorGenerator_coefficient (PointedCGWH.SymmetricSpectrum.hom f)
    (card n) (card (c + n)) M (CostructuredArrow.mk e.hom)
  have h1 := congrArg (fun a => (M ◁ a) ≫ coefficientFirstDayLeg n M Z c e) hg
  have h2 := (Category.assoc (M ◁ g) (β_ M (Z.X.functor.obj (card c))).hom tZ).symm
  have h3 := congrArg (fun a => a ≫ tZ) hb
  have h4 := Category.assoc (β_ M (Y.X.functor.obj (card c))).hom (g ▷ M) tZ
  have h5 := congrArg (fun a => (β_ M (Y.X.functor.obj (card c))).hom ≫ a) ht
  have h6 := (Category.assoc (β_ M (Y.X.functor.obj (card c))).hom tY
    (representedTensorCoefficientMap (PointedCGWH.SymmetricSpectrum.hom f)
      (card n) (card (c + n)) M)).symm
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans h6))))

/-- The actual native finite orbit input square follows from the original leg formula at the same block. -/
private theorem finiteInputSquare_of_originalDayLegs (n : ℕ) (M : PointedCGWH.{u, v})
    (e : ∀ (c : ℕ), OrbitIndex c n → (card c ⊗ card n ≅ card (c + n)))
    (he : ∀ (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) (i : OrbitIndex c n),
      finiteNativeLeg c n M Y i ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n))).hom =
      coefficientFirstDayLeg n M Y c (e c i))
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) : FiniteInputSquare n M f := by
  intro c i
  let dY := (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card (c + n))).hom
  let dZ := (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Z (card (c + n))).hom
  let lY := finiteNativeLeg c n M Y i
  let lZ := finiteNativeLeg c n M Z i
  let m := nativeFreeSmashInputLevel n M f c
  let s := M ◁ PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c
  let k := representedTensorCoefficientMap (PointedCGWH.SymmetricSpectrum.hom f)
    (card n) (card (c + n)) M
  apply (cancel_mono dZ).mp
  have h1 := Category.assoc lY m dZ
  have h2 := congrArg (fun a => lY ≫ a) (originalDayInput_naturality n M f c)
  have h3 := (Category.assoc lY dY k).symm
  have h4 := congrArg (fun a => a ≫ k) (he Y c i)
  have h5 := (coefficientFirstDayLeg_input n M f c (e c i)).symm
  have h6 := congrArg (fun a => s ≫ a) (he Z c i).symm
  have h7 := (Category.assoc s lZ dZ).symm
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans (h6.trans h7)))))

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

