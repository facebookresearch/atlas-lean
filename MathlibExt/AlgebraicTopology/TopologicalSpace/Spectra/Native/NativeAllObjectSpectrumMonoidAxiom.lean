/-- The literal original stable model receives the full same-arrow
free sphere/free unit coefficient weak-class equivalence. -/
private theorem literalStableModel_freeSphere_iff_freeUnit
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (n : ℕ)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
