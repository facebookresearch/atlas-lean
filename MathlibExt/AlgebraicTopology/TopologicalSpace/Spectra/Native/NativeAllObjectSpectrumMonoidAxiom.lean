/-- Both full natural transformation maps keep every arbitrary native
right-arrow square for the same original scalar/free balanced-smash comparison. -/
private theorem scalarFree_fullNaturality (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    (K M : PointedCGWH.{u, v}) {Y Z : C.{u, v}} (f : Y ⟶ Z) :
    Free.object a (K ⊗ M) ◁ f ≫ (originalFreeCoefficientScalarSmashIso a K M).hom.app Z =
        (originalFreeCoefficientScalarSmashIso a K M).hom.app Y ≫
          (EnrichedFunctorCat.tensorLeft K).map (Free.object a M ◁ f) ∧
      (EnrichedFunctorCat.tensorLeft K).map (Free.object a M ◁ f) ≫
          (originalFreeCoefficientScalarSmashIso a K M).inv.app Z =
        (originalFreeCoefficientScalarSmashIso a K M).inv.app Y ≫ Free.object a (K ⊗ M) ◁ f :=
  ⟨(originalFreeCoefficientScalarSmashIso a K M).hom.naturality f,
    (originalFreeCoefficientScalarSmashIso a K M).inv.naturality f⟩

/-- Both actual free scalar-smash maps retain the original scalar/free
and native scalar-smash comparison maps before any derived test is taken. -/
private theorem scalarFree_bothLiteralMaps (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    (K M : PointedCGWH.{u, v}) (Y : C.{u, v}) :
    (originalFreeCoefficientScalarSmashIso a K M).hom.app Y =
        (Free.scalarFreeIso K M a).inv ▷ Y ≫
          (NativeStableMonoidal.SymmetricScalarSmash.scalarSmashIso K (Free.object a M) Y).inv ∧
      (originalFreeCoefficientScalarSmashIso a K M).inv.app Y =
        (NativeStableMonoidal.SymmetricScalarSmash.scalarSmashIso K (Free.object a M) Y).hom ≫
          (Free.scalarFreeIso K M a).hom ▷ Y :=
  ⟨originalFreeCoefficientScalarSmashIso_hom_app a K M Y,
    originalFreeCoefficientScalarSmashIso_inv_app a K M Y⟩

