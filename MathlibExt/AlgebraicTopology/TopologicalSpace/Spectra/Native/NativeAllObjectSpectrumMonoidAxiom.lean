private def sequentialPrefixIso (q : ℕ) : card 1 ⊗ card q ≅ card (q + 1) :=
  cardBlockSumIso (Nat.add_comm 1 q)

private theorem orderedGenerator_prefix (q : ℕ) :
    orderedSymmetricOperatorHom.{u, v} q (q + 1) 1 (Nat.add_comm 1 q) =
      operatorGenerator.{u, v} (card 1) (card q) (card (q + 1))
        (sequentialPrefixIso q).hom := by
  rfl

private def circleToCoefficientHom : PointedCGWH.sphereOne.{u, v} ⟶ S.{u, v}.functor.obj (card 1) :=
  (TensorPower.tensorPowObjOneIso PointedCGWH.sphereOne.{u, v}).inv

private theorem circleToCoefficientHom_original :
    HEq circleToCoefficientHom.{u, v} ((λ_ PointedCGWH.sphereOne.{u, v}).inv) := by
  rfl

private theorem valueLeftUncurry {Z : Type*} [Category Z] [MonoidalCategory Z]
    [SymmetricCategory Z] [MonoidalClosed Z] (X B H Y : Z)
    (g : B ⟶ H) (f : H ⟶ (ihom X).obj Y) :
    (β_ X B).inv ≫ (X ◁ g) ≫ MonoidalClosed.uncurry f =
      (β_ B X).hom ≫ MonoidalClosed.uncurry (g ≫ f) := by
  rw [← MonoidalClosed.uncurry_natural_left,
    ← SymmetricCategory.braiding_swap_eq_inv_braiding X B]

private def nativePrefixAction (F : PointedCGWH.SymmetricSpectrum.{u, v}) (q : ℕ) :
    PointedCGWH.sphereOne.{u, v} ⊗
      F.toEnrichedFunctor.obj (PointedCGWH.symmetricOperatorObj.{u, v} (card q)) ⟶
      F.toEnrichedFunctor.obj (PointedCGWH.symmetricOperatorObj.{u, v} (card (q + 1))) :=
  (circleToCoefficientHom.{u, v} ▷ F.X.functor.obj (card q)) ≫
    PointedCGWH.SymmetricSpectrum.leftArrowAction F (card 1) (card q) (card (q + 1))
      (sequentialPrefixIso q).hom

private theorem nativeSequential_sigma_left (F : PointedCGWH.SymmetricSpectrum.{u, v}) (q : ℕ) :
    symmetricToSequentialSourceStructureMap F q = nativePrefixAction F q := by
  let X : V.{u, v} := F.X.functor.obj (card q)
  let Y : V.{u, v} := F.X.functor.obj (card (q + 1))
  let B : V.{u, v} := S.{u, v}.functor.obj (card 1)
  let H : V.{u, v} := PointedCGWH.symmetricOperatorObj.{u, v} (card q) ⟶[V.{u, v}]
    PointedCGWH.symmetricOperatorObj.{u, v} (card (q + 1))
  let g : B ⟶ H := operatorGenerator.{u, v} (card 1) (card q) (card (q + 1))
    (sequentialPrefixIso q).hom
  let f : H ⟶ (ihom X).obj Y :=
    F.toEnrichedFunctor.map (PointedCGWH.symmetricOperatorObj.{u, v} (card q))
      (PointedCGWH.symmetricOperatorObj.{u, v} (card (q + 1)))
  have h := valueLeftUncurry X B H Y g f
  change (circleToCoefficientHom.{u, v} ⊗ₘ 𝟙 X) ≫
      ((β_ X B).inv ≫ (X ◁ g) ≫ MonoidalClosed.uncurry f) =
    (circleToCoefficientHom.{u, v} ▷ X) ≫
      ((β_ B X).hom ≫ MonoidalClosed.uncurry (g ≫ f))
  rw [tensorHom_id]
  exact congrArg (fun k : B ⊗ X ⟶ Y => (circleToCoefficientHom.{u, v} ▷ X) ≫ k) h

private theorem nativeRestriction_sigma_left (F : PointedCGWH.SymmetricSpectrum.{u, v}) (q : ℕ) :
    CategoryTheory.Spectra.Sequential.structureMap
      ((restriction sequentialSymmetricOperatorIndexFunctor.{u, v}).obj F) q =
      nativePrefixAction F q :=
  (symmetricToSequentialSourceStructureMap_eq F q).trans (nativeSequential_sigma_left F q)

private theorem moduleSequential_sigma_left (T : Mod C.{u, v} S.{u, v}) (q : ℕ) :
    symmetricToSequentialSourceStructureMap (toOperatorFunctor T) q =
      (circleToCoefficientHom.{u, v} ▷ T.X.functor.obj (card q)) ≫
        pairAction T (card 1) (card q) ≫ T.X.functor.map (sequentialPrefixIso q).hom := by
  have h := nativeSequential_sigma_left (toOperatorFunctor T) q
  have hf := reconstructedArrowAction_forward T (card 1) (card q) (card (q + 1))
    (sequentialPrefixIso q).hom
  change _ = (circleToCoefficientHom.{u, v} ▷ T.X.functor.obj (card q)) ≫
    reconstructedArrowAction (toOperatorFunctor T) (card 1) (card q) (card (q + 1))
      (sequentialPrefixIso q).hom at h
  exact h.trans (congrArg (fun f => (circleToCoefficientHom.{u, v} ▷
    T.X.functor.obj (card q)) ≫ f) hf)

private theorem rightTensorRestriction_sigma (P : C.{u, v}) (N : Mod C.{u, v} S.{u, v}) (q : ℕ) :
    let T : Mod C.{u, v} S.{u, v} := Mod.FreeRelativeTensor.rightTensorModule A.{u, v} P N
    symmetricToSequentialSourceStructureMap (toOperatorFunctor T) q =
      (circleToCoefficientHom.{u, v} ▷ T.X.functor.obj (card q)) ≫
        pairAction T (card 1) (card q) ≫ T.X.functor.map (sequentialPrefixIso q).hom := by
  exact moduleSequential_sigma_left
    (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} P N) q

private theorem viaEmbedding_equiv {X₁ X₂ X₃ : Type*} (p : Equiv.Perm X₁)
    (i : X₁ ↪ X₂) (e : X₂ ≃ X₃) :
    p.viaEmbedding (i.trans e.toEmbedding) =
      e.symm.trans ((p.viaEmbedding i).trans e) := by
  apply Equiv.ext
  intro z
  obtain ⟨y, rfl⟩ := e.surjective z
  by_cases hy : y ∈ Set.range i
  · obtain ⟨x, rfl⟩ := hy
    change p.viaEmbedding (i.trans e.toEmbedding) ((i.trans e.toEmbedding) x) = _
    rw [Equiv.Perm.viaEmbedding_apply]
    change e (i (p x)) = e (p.viaEmbedding i (e.symm (e (i x))))
    rw [Equiv.symm_apply_apply, Equiv.Perm.viaEmbedding_apply]
  · have hz : e y ∉ Set.range (i.trans e.toEmbedding) := by
      rintro ⟨x, hx⟩
      apply hy
      exact ⟨x, e.injective hx⟩
    rw [Equiv.Perm.viaEmbedding_apply_of_notMem _ _ _ hz]
    change e y = e (p.viaEmbedding i (e.symm (e y)))
    rw [Equiv.symm_apply_apply, Equiv.Perm.viaEmbedding_apply_of_notMem _ _ _ hy]

private theorem cardBlockSumIso_finite {r n m : ℕ} (h : r + n = m) :
    smallFiniteBijection (cardBlockSumIso h).hom = finCongr h := by
  cases h
  change smallFiniteBijection (𝟙 (card (r + n))) = Equiv.refl _
  exact smallFiniteBijection_id _

private theorem aut_finite (q : ℕ) (g : Aut (card q)) :
    smallFiniteBijection g.asIso.hom = cardinalAutEquiv q g := rfl

/-- The native prefix target includes exactly the old labels after the one new label. -/
private def actualPrefixIso (c n : ℕ) : card 1 ⊗ card (c + n) ≅ card ((c + 1) + n) :=
  cardBlockSumIso (by omega)

private theorem successorAmbient_cast (c n : ℕ) :
    successorAmbient c n = (Fin.natAddEmb 1).trans
      (finCongr (show 1 + (c + n) = (c + 1) + n by omega)).toEmbedding := by
  apply Function.Embedding.ext
  intro x
  apply Fin.ext
  change x.val + 1 = 1 + x.val
  omega

/-- Every actual target permutation is extended by the original native prefix tensor map. -/
private theorem growAut_prefix (c n : ℕ) (g : Aut (card (c + n))) :
    (growAut c n g).asIso.hom = (actualPrefixIso c n).inv ≫
      (card 1 ◁ g.asIso.hom) ≫ (actualPrefixIso c n).hom := by
  apply Core.hom_ext
  funext x
  have h := viaEmbedding_equiv (cardinalAutEquiv (c + n) g)
    (Fin.natAddEmb 1) (finCongr (show 1 + (c + n) = (c + 1) + n by omega))
  rw [← successorAmbient_cast] at h
  have hp := prefixAut_eq_viaEmbedding (c + n) g
  rw [← hp] at h
  have hj : smallFiniteBijection ((actualPrefixIso c n).hom) =
      finCongr (show 1 + (c + n) = (c + 1) + n by omega) := cardBlockSumIso_finite _
  have hi : smallFiniteBijection ((actualPrefixIso c n).inv) =
      (finCongr (show 1 + (c + n) = (c + 1) + n by omega)).symm := by
    have hh : (smallFiniteBijection (actualPrefixIso c n).inv).trans
        (smallFiniteBijection (actualPrefixIso c n).hom) = Equiv.refl _ :=
      (smallFiniteBijection_comp _ _).symm.trans
        ((congrArg smallFiniteBijection (actualPrefixIso c n).inv_hom_id).trans
          (smallFiniteBijection_id _))
    have he : smallFiniteBijection (actualPrefixIso c n).inv =
        (smallFiniteBijection (actualPrefixIso c n).hom).symm := by
      apply Equiv.ext
      intro x
      apply (smallFiniteBijection (actualPrefixIso c n).hom).injective
      rw [Equiv.apply_symm_apply]
      exact congrArg (fun e => e x) hh
    exact he.trans (congrArg Equiv.symm hj)
  have hn : smallFiniteBijection (card 1 ◁ g.asIso.hom) =
      cardinalAutEquiv (1 + (c + n)) (prefixAut (c + n) g) := rfl
  have hm : smallFiniteBijection ((actualPrefixIso c n).inv ≫
      (card 1 ◁ g.asIso.hom) ≫ (actualPrefixIso c n).hom) =
      (finCongr (show 1 + (c + n) = (c + 1) + n by omega)).symm.trans
        ((cardinalAutEquiv (1 + (c + n)) (prefixAut (c + n) g)).trans
          (finCongr (show 1 + (c + n) = (c + 1) + n by omega))) := by
    rw [smallFiniteBijection_comp, smallFiniteBijection_comp, hi, hn, hj]
    rfl
  have hg : smallFiniteBijection (growAut c n g).asIso.hom =
      (cardinalAutEquiv (c + n) g).viaEmbedding (successorAmbient c n) := by
    rw [aut_finite]
    change cardinalAutEquiv ((c + 1) + n)
      ((cardinalAutEquiv ((c + 1) + n)).symm _) = _
    exact MulEquiv.apply_symm_apply _ _
  have he := hg.trans (h.trans hm.symm)
  have hx := congrArg (fun f => ULift.up (f x.down)) he
  exact hx

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]

/-- The original coefficient-first action word is the same right tensor action on values. -/
private theorem coefficientFirstAction (A M X Y : C) (s : A ⊗ X ⟶ Y) :
    (A ◁ (β_ M X).hom) ≫ (α_ A X M).inv ≫ (s ▷ M) =
      (α_ A M X).inv ≫ ((β_ M A).inv ▷ X) ≫ (α_ M A X).hom ≫
        (M ◁ s) ≫ (β_ M Y).hom := by
  rw [braiding_naturality_right M s, braiding_tensor_right_hom]
  simp only [Category.assoc, Iso.hom_inv_id_assoc,
    ← comp_whiskerRight_assoc, Iso.inv_hom_id, id_whiskerRight, Category.id_comp,
    Iso.inv_hom_id_assoc]

section Symmetric
variable {D : Type u} [Category.{v} D] [MonoidalCategory D] [SymmetricCategory D]

/-- Actual symmetric values retain the original sphere-one/coefficient braid. -/
private theorem coefficientFirstAction_symmetric (A M X Y : D) (s : A ⊗ X ⟶ Y) :
    (A ◁ (β_ M X).hom) ≫ (α_ A X M).inv ≫ (s ▷ M) =
      (α_ A M X).inv ≫ ((β_ A M).hom ▷ X) ≫ (α_ M A X).hom ≫
        (M ◁ s) ≫ (β_ M Y).hom := by
  rw [SymmetricCategory.braiding_swap_eq_inv_braiding M A]
  exact coefficientFirstAction A M X Y s
end Symmetric


