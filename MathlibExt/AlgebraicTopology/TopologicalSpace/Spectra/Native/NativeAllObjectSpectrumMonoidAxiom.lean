variable {V : Type uV} [Category.{vV} V] {C : Type uC} [Category.{vC} C]
  [MonoidalCategory C]

/-- The actual left unit is a whole endofunctor isomorphism. -/
private def unitTensor : tensorLeft (𝟙_ C) ≅ 𝟭 C :=
  NatIso.ofComponents (fun X => λ_ X) (fun f => leftUnitor_naturality f)

/-- The full source representation at the unit parameter identifies its whole tensor functor. -/
private def freeUnitTensor (F : V ⥤ C) (u : V) (hF : F.obj u ≅ 𝟙_ C) :
    (F ⋙ curriedTensor C).obj u ≅ 𝟭 C :=
  (tensoringLeft C).mapIso hF ≪≫ unitTensor

/-- The complete original postcomposition at its scalar unit has the same left functor. -/
private def postUnit (S : V ⥤ (C ⥤ C)) (L : C ⥤ C) (u : V) (hS : S.obj u ≅ 𝟭 C) :
    (ParametrizedAdjunction.OriginalPostcomposition.left (F := S) (L := L)).obj u ≅ L :=
  Functor.isoWhiskerRight hS L ≪≫ Functor.leftUnitor L

/-- A represented unit parameter reconstructs the whole original postcomposing functor. -/
private def postIsIdentity (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (L : C ⥤ C)
    (e : F ⋙ curriedTensor C ≅
      ParametrizedAdjunction.OriginalPostcomposition.left (F := S) (L := L))
    (u : V) (hF : F.obj u ≅ 𝟙_ C) (hS : S.obj u ≅ 𝟭 C) : L ≅ 𝟭 C :=
  (postUnit S L u hS).symm ≪≫ (e.app u).symm ≪≫ freeUnitTensor F u hF

/-- Every original parameter is represented by the same actual free object and full left mate. -/
private def represented (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (L : C ⥤ C)
    (e : F ⋙ curriedTensor C ≅
      ParametrizedAdjunction.OriginalPostcomposition.left (F := S) (L := L))
    (u : V) (hF : F.obj u ≅ 𝟙_ C) (hS : S.obj u ≅ 𝟭 C) (K : V) :
    tensorLeft (F.obj K) ≅ S.obj K :=
  e.app K ≪≫ Functor.isoWhiskerLeft (S.obj K) (postIsIdentity F S L e u hF hS) ≪≫
    Functor.rightUnitor (S.obj K)







end CategoryTheory.ZeroFreeRepresentation

