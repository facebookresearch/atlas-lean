/-!
## Original free relative tensor and its right tensor module

The complete carrier comparison is the original balancing contraction followed
by its value braid. It is a module isomorphism for the actual right tensor
module action, with both original inverse maps retained.
-/

set_option autoImplicit false
noncomputable section
universe uC vC
open CategoryTheory MonoidalCategory Limits BraidedCategory
open scoped CategoryTheory.MonObj

namespace CategoryTheory.Mod.FreeRelativeTensorCarrier
variable {C : Type uC} [Category.{vC} C] [MonoidalCategory C] [BraidedCategory C]
  (A : CommMon C) (P : C) (N : Mod C A.X)

variable [HasCoequalizers C]
  [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorLeft X)]
  [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorRight X)]

private def tensorModuleRightIso :
    Mod.FreeRelativeTensor.tensorModule A P N ≅ Mod.FreeRelativeTensor.rightTensorModule A P N :=
  (Mod.AmbientTensor.rightToLeftIso A.X P N).symm

private def carrierModuleIso :
    ((Mod.relativeTensor A).obj ((Mod.free A.X).obj P)).obj N ≅
      Mod.FreeRelativeTensor.rightTensorModule A P N :=
  Mod.FreeRelativeTensor.balancedIso A P N ≪≫ tensorModuleRightIso A P N

private theorem carrierModuleIso_hom :
    (carrierModuleIso A P N).hom.hom =
      (carrierIso A P N).hom := rfl

/-- The inverse module map is the same whole original carrier inverse. -/
private theorem carrierModuleIso_inv :
    (carrierModuleIso A P N).inv.hom = (carrierIso A P N).inv := rfl

end CategoryTheory.Mod.FreeRelativeTensorCarrier
end

end

