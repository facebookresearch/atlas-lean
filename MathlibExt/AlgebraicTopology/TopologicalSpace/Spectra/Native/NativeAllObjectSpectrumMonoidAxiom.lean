namespace CategoryTheory.OriginalRotationPacket

variable {C : Type u} [Category.{v} C]

/-- The entire original rotation family, both literal faces and both time endpoints are retained together. -/
private structure Data (J : C ⥤ C) (k : Fin 2 → (𝟭 C ⟶ J)) (Q S : ℕ → C) where
  left : ∀ n : ℕ, Q n ⟶ S n
  right : ∀ n : ℕ, Q n ⟶ S n
  homotopy : ∀ n : ℕ, J.obj (Q n) ⟶ S n
  endpoint0 : ∀ n : ℕ, (k 0).app (Q n) ≫ homotopy n = left n
  endpoint1 : ∀ n : ℕ, (k 1).app (Q n) ≫ homotopy n = right n

/-- The original whole physical rotation family constructs its same complete packet before object projection. -/
private def ofFamily (J : C ⥤ C) (k : Fin 2 → (𝟭 C ⟶ J)) (Q S : ℕ → C)
    (l r : ∀ n : ℕ, Q n ⟶ S n)
    (H : ∀ n : ℕ, {h : J.obj (Q n) ⟶ S n //
      (k 0).app (Q n) ≫ h = l n ∧ (k 1).app (Q n) ≫ h = r n}) : Data J k Q S where
  left := l
  right := r
  homotopy := fun n => (H n).val
  endpoint0 := fun n => (H n).property.1
  endpoint1 := fun n => (H n).property.2

/-- Proved whole source and target object families transport every original physical map and endpoint together. -/
private def transport (J : C ⥤ C) (k : Fin 2 → (𝟭 C ⟶ J))
    (Q Q' S S' : ℕ → C) (hQ : Q = Q') (hS : S = S') (D : Data J k Q S) :
    Data J k Q' S' := Eq.mp (congrArg₂ (fun Q S => Data J k Q S) hQ hS) D




end CategoryTheory.OriginalRotationPacket

