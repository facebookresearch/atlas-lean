/-- The entire original scalar integer comparison retains the genuine
restriction and both native group maps before any input spectrum is selected. -/
private def originalScalarIntegerNatIso (q : ℤ) : integerPiFunctor.{u, v} q ≅
    T.{u, v} ⋙ integerPiFunctor (q + 1) :=
  NativeStableCofiberIntegerMaps.scalarIntegerPiNatIso
    (j := sequentialSymmetricOperatorIndexFunctor.{u, v}) q

omit B in
/-- The same arbitrary-endpoint scalar sphere arrow preserves and reflects
all original signed integer maps, including both integer shift directions. -/
private theorem originalScalar_integerPi_iff {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map (T.map f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map f) := by
  constructor
  · intro h q
    have hScalar : IsIso ((T ⋙ integerPiFunctor (q + 1)).map f) := by
      rw [Functor.comp_map]
      exact h (q + 1)
    exact (NatIso.isIso_map_iff (F₁ := integerPiFunctor q)
      (F₂ := T ⋙ integerPiFunctor (q + 1)) (originalScalarIntegerNatIso q) f).mpr hScalar
  · intro h q
    obtain ⟨p, rfl⟩ : ∃ p : ℤ, p + 1 = q := ⟨q - 1, by omega⟩
    have hShift := (NatIso.isIso_map_iff (F₁ := integerPiFunctor p)
      (F₂ := T ⋙ integerPiFunctor (p + 1)) (originalScalarIntegerNatIso p) f).mp (h p)
    rw [Functor.comp_map] at hShift
    exact hShift

/-- Both full original replacement counits remain raw integer isomorphisms
after the actual scalar sphere, with no cofibrancy restriction on their targets. -/
private theorem originalScalarCounit_integerPi (X : C.{u, v}) :
    ∀ q : ℤ, IsIso ((integerPiFunctor q).map (T.map (ε.app X))) :=
  (originalScalar_integerPi_iff (ε.app X)).mpr
    ((integerPiStarEquivalences_iff _).mp (levelWeak_le_integerPiStarEquivalences _
      (Replacement.cofibrantReplacementCounit_mem_weakEquivalences X)))

/-- The closed original forward detector supplies every actual Omega test
of the same full scalar replacement counit. -/
private theorem originalScalarCounit_omegaTests (X : C.{u, v}) : W (T.map (ε.app X)) :=
  PointedCGWH.Spectra.OriginalSymmetricPiStarOmegaTests.integerIsos_imply_omegaTests _
    (originalScalarCounit_integerPi X)

/-- The full scalar counit naturality square transfers the same scalar map
to its original Q map in both directions, at arbitrary original endpoints. -/
private theorem originalScalarMap_iff_QMap {X Y : C.{u, v}} (f : X ⟶ Y) :
    W (T.map f) ↔ W (T.map (Q.map f)) := by
  have hn : T.map (Q.map f) ≫ T.map (ε.app Y) = T.map (ε.app X) ≫ T.map f :=
    (T.map_comp _ _).symm.trans ((T.congr_map (ε.naturality f)).trans (T.map_comp _ _))
  calc
    W (T.map f) ↔ W (T.map (ε.app X) ≫ T.map f) :=
      (W.precomp_iff _ _ (originalScalarCounit_omegaTests X)).symm
    _ ↔ W (T.map (Q.map f) ≫ T.map (ε.app Y)) := by rw [hn]
    _ ↔ W (T.map (Q.map f)) := W.postcomp_iff _ _ (originalScalarCounit_omegaTests Y)

/-- The genuine full original I-cone/scalar Ho Arrow comparison gives
all-target tests of the scalar Q arrow exactly when the original arrow has them. -/
private theorem originalScalarQMap_omegaTests_iff {X Y : C.{u, v}} (f : X ⟶ Y) :
    W (T.map (Q.map f)) ↔ W f := by
  let S := OriginalISuspension.suspension (B := B) (I := PointedCGWH.SymmetricOperatorIndex.{u, v})
  let e := ScalarSphereSuspension.originalISuspensionQIsoSphereQ
    (B := B) (I := PointedCGWH.SymmetricOperatorIndex.{u, v})
  let a : Arrow.mk (H.map (S.map (Q.map f))) ≅ Arrow.mk (H.map (T.map (Q.map f))) :=
    Arrow.isoMk (e.app X) (e.app Y)
      (ScalarSphereSuspension.originalISuspensionQIsoSphereQ_hom_naturality (B := B) f).symm
  have hTransfer : W (T.map (Q.map f)) ↔ W (S.map (Q.map f)) := by
    constructor
    · intro hf E hE
      let P : MorphismProperty (_root_.HomotopicalAlgebra.HomotopyCategory C.{u, v}) :=
        ((MorphismProperty.isomorphisms (Type (v + 1))).inverseImage (yoneda.obj (H.obj E))).unop
      have hScalar : P (H.map (T.map (Q.map f))) :=
        (isIso_iff_bijective _).mpr (hf E hE)
      have hSusp := (P.arrow_mk_iso_iff a).mpr hScalar
      exact (isIso_iff_bijective _).mp hSusp
    · intro hf E hE
      let P : MorphismProperty (_root_.HomotopicalAlgebra.HomotopyCategory C.{u, v}) :=
        ((MorphismProperty.isomorphisms (Type (v + 1))).inverseImage (yoneda.obj (H.obj E))).unop
      have hSusp : P (H.map (S.map (Q.map f))) :=
        (isIso_iff_bijective _).mpr (hf E hE)
      have hScalar := (P.arrow_mk_iso_iff a).mp hSusp
      exact (isIso_iff_bijective _).mp hScalar
  exact hTransfer.trans (PointedCGWH.Spectra.Symmetric.SuspensionTestDetection.suspensionQ_omegaTests_iff f)

/-- The same actual scalar one-sphere preserves and reflects every original
Omega-target test of every arbitrary-endpoint native symmetric arrow. -/
private theorem originalScalarSphere_omegaTests_iff {X Y : C.{u, v}} (f : X ⟶ Y) :
    W (T.map f) ↔ W f :=
  (originalScalarMap_iff_QMap f).trans (originalScalarQMap_omegaTests_iff f)

/-- Every actual finite sphere power preserves and reflects the full
original Omega tests without any endpoint cofibrancy or semistability hypothesis. -/
private theorem originalScalarSpherePower_omegaTests_iff (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    W ((EnrichedFunctorCat.tensorLeft (TensorPower.tensorPowObj PointedCGWH.sphereOne n)).map f) ↔ W f := by
  induction n generalizing X Y with
  | zero =>
      let e : Arrow.mk ((EnrichedFunctorCat.tensorLeft (𝟙_ PointedCGWH.{u, v})).map f) ≅ Arrow.mk f :=
        Arrow.isoMk (scalarUnitIso X) (scalarUnitIso Y) (scalarUnitIso_naturality f).symm
      exact W.arrow_mk_iso_iff e
  | succ n ih =>
      let M := TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n
      let e : Arrow.mk ((EnrichedFunctorCat.tensorLeft (M ⊗ PointedCGWH.sphereOne)).map f) ≅
          Arrow.mk ((EnrichedFunctorCat.tensorLeft M).map (T.map f)) :=
        Arrow.isoMk (scalarAssociatorIso M PointedCGWH.sphereOne X)
          (scalarAssociatorIso M PointedCGWH.sphereOne Y)
          (scalarAssociatorIso_naturality M PointedCGWH.sphereOne f).symm
      exact (W.arrow_mk_iso_iff e).trans ((ih (T.map f)).trans (originalScalarSphere_omegaTests_iff f))










