attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

private abbrev W := NativeK.omegaTests (B := B) Actual.symmetricFamily.{u, v}

/-- The actual I-cone contraction compares the caller's same HEP quotient
with its original cofiber, retaining every original source and target map. -/
private theorem originalCofiberCallerComparison_omegaTests
    (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hH : PointedCGWH.EnrichedBasedHomotopyExtension.property F.hom)
    {Z : Actual.SymmetricCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    W (cofiberQuotientComparison (B := B) F qX q0 sq) := by
  let c := OriginalISuspension.cocone (B := B) F
  let hc := OriginalISuspension.coconeIsColimit (B := B) F
  let ι := OriginalICone.inclusion (B := B) (I := PointedCGWH.SymmetricOperatorIndex.{u, v})
  let κ := OriginalICone.contraction (B := B) (I := PointedCGWH.SymmetricOperatorIndex.{u, v})
  exact originalHEPPushoutComparison_omegaTests
    F.hom (ι.app F.left) c.inr c.inl
    F.hom (Diagrams.toZero F.left) qX q0
    (IsPushout.of_isColimit hc).flip sq hH hH
    (𝟙 F.left) (𝟙 F.right) (κ.app F.left)
    (cofiberQuotientComparison (B := B) F qX q0 sq)
    (by simp only [Category.id_comp, Category.comp_id])
    (by simpa only [Category.id_comp] using (OriginalICone.inclusion_contraction F.left).symm)
    (by simpa only [Category.id_comp] using (cofiberQuotientComparison_target F qX q0 sq).symm)
    (cofiberQuotientComparison_cone F qX q0 sq).symm
    (W.id_mem F.left) (W.id_mem F.right)
    (NativeK.levelWeak_le_omegaTests Actual.symmetricFamily _
      (OriginalICone.contraction_trivialFibration F.left).2)

/-- The full original Q cofiber has the same genuine HEP caller quotient
comparison through the entire original Q arrow counit and actual I cone. -/
private theorem originalQCoFiberCallerComparison_omegaTests
    (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hH : PointedCGWH.EnrichedBasedHomotopyExtension.property F.hom)
    {Z : Actual.SymmetricCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    W (qCofiberQuotientComparison (B := B) F qX q0 sq) :=
  W.comp_mem _ _
    (NativeK.levelWeak_le_omegaTests Actual.symmetricFamily _
      (cofiberQCounit_levelWeak
        PointedCGWH.SymmetricOperatorHom.nativeSymmetricOperatorHom_isCofibrant F))
    (originalCofiberCallerComparison_omegaTests F hH qX q0 sq)

/-- Nullity of the original caller quotient detects weakness of the same
actual HEP arrow, without any cofibrancy premise on its two endpoints. -/
private theorem originalHEPArrow_omegaTests_of_quotientNull
    (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hH : PointedCGWH.EnrichedBasedHomotopyExtension.property F.hom)
    {Z : Actual.SymmetricCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0)
    (hZ : W (Diagrams.toZero Z)) : W F.hom := by
  let d := qCofiberQuotientComparison (B := B) F qX q0 sq
  have hd : W d := originalQCoFiberCallerComparison_omegaTests F hH qX q0 sq
  have h := W.comp_mem _ _ hd hZ
  have hCollapse : d ≫ Diagrams.toZero Z =
      Diagrams.toZero ((NativeK.CofiberNullity.cofiberQ (B := B)).obj F) :=
    Diagrams.zeroDiagramIsTerminal.hom_ext _ _
  exact symmetric_omegaTests_of_qCofiberNull F (hCollapse ▸ h)

/-- Both directions retain the actual same original quotient, its complete
caller pushout maps and the original HEP arrow. -/
private theorem originalHEPQuotientNull_iff_omegaTests
    (F : Arrow Actual.SymmetricCarrier.{u, v})
    (hH : PointedCGWH.EnrichedBasedHomotopyExtension.property F.hom)
    {Z : Actual.SymmetricCarrier.{u, v}}
    (qX : F.right ⟶ Z) (q0 : Diagrams.zeroDiagram ⟶ Z)
    (sq : IsPushout F.hom (Diagrams.toZero F.left) qX q0) :
    W (Diagrams.toZero Z) ↔ W F.hom := by
  constructor
  · exact originalHEPArrow_omegaTests_of_quotientNull F hH qX q0 sq
  · intro hF
    let d := qCofiberQuotientComparison (B := B) F qX q0 sq
    have hd : W d := originalQCoFiberCallerComparison_omegaTests F hH qX q0 sq
    have hCollapse : d ≫ Diagrams.toZero Z = (NativeK.CofiberNullity.collapse (B := B)).app F :=
      Diagrams.zeroDiagramIsTerminal.hom_ext _ _
    exact W.of_precomp _ _ hd
      (hCollapse.symm ▸ NativeK.CofiberNullity.collapse_omegaTests Actual.symmetricFamily F.hom hF)






