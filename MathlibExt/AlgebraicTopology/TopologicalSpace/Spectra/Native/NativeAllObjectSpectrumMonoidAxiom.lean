variable {V : Type uV} [Category.{vV} V] {C : Type uC} [Category.{vC} C]
  [MonoidalCategory C]

/-- The original right-whiskering by identity is a whole endofunctor isomorphism. -/
private def rightUnit : (Functor.whiskeringRight C C C).obj (𝟭 C) ≅ 𝟭 (C ⥤ C) :=
  NatIso.ofComponents (fun P => Functor.rightUnitor P) (by
    intro P Q f
    ext X
    simp)

/-- The complete original postcomposition is removed by its actual whole identity comparison. -/
private def postIso (S : V ⥤ (C ⥤ C)) (L : C ⥤ C) (eL : L ≅ 𝟭 C) :
    ParametrizedAdjunction.OriginalPostcomposition.left (F := S) (L := L) ≅ S :=
  Functor.isoWhiskerLeft S ((Functor.whiskeringRight C C C).mapIso eL) ≪≫
    Functor.isoWhiskerLeft S rightUnit ≪≫ Functor.rightUnitor S

/-- The entire parameter and arbitrary-input representation is formed before any component. -/
private def whole (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (L : C ⥤ C)
    (e : F ⋙ curriedTensor C ≅
      ParametrizedAdjunction.OriginalPostcomposition.left (F := S) (L := L))
    (eL : L ≅ 𝟭 C) : F ⋙ curriedTensor C ≅ S := e ≪≫ postIso S L eL

/-- The whole representation's component keeps its ordinary tensor-functor endpoints. -/
private def component (F : V ⥤ C) (S : V ⥤ (C ⥤ C))
    (e : F ⋙ curriedTensor C ≅ S) (K : V) : tensorLeft (F.obj K) ≅ S.obj K := e.app K






end CategoryTheory.PostIdentityRepresentation

