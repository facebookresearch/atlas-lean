private def nativeRightTensorLevelIso (r : I) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (q : I) :
    ((PointedCGWH.SymmetricSpectrum.freeSmash r M).obj Y).X.functor.obj q ≅
      (Y.X ⊗ PointedCGWH.SymmetricSpectrum.freeDiagram r M).functor.obj q :=
  (nativeRightTensorLevelNatIso r M q).app Y

/-- The factored comparison has the whole literal original evaluated map as its value. -/
private theorem nativeRightTensorLevelIso_source (r : I) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (q : I) :
    nativeRightTensorLevelIso r M Y q =
      (PointedCGWH.SymmetricSpectrum.evaluation.{u, v} q).mapIso
        (nativeRightTensorIso r M Y) ≪≫
      (NativeOmegaPreparation.SymmetricNativeFree.evaluationIso.{u, v} q).app
        (Mod.FreeRelativeTensor.rightTensorModule A.{u, v}
          (PointedCGWH.SymmetricSpectrum.freeDiagram r M)
          (PointedCGWH.SymmetricSpectrum.toModule.obj Y)) := by
  let P : C.{u, v} := PointedCGWH.SymmetricSpectrum.freeDiagram r M
  let G : PointedCGWH.SymmetricSpectrum.{u, v} ⥤ Mod C.{u, v} S.{u, v} :=
    PointedCGWH.SymmetricSpectrum.toModule ⋙ Mod.FreeRelativeTensorCarrier.rightTensorFunctor A P
  let ev : PointedCGWH.SymmetricSpectrum.{u, v} ⥤ V.{u, v} :=
    PointedCGWH.SymmetricSpectrum.evaluation q
  let τ : E.functor ⋙ ev ≅ Mod.dayEvaluation S q :=
    NativeOmegaPreparation.SymmetricNativeFree.evaluationIso q
  have h : (nativeRightTensorLevelNatIso r M q).app Y =
      ev.mapIso ((nativeRightTensorNatIso r M).app Y) ≪≫ τ.app (G.obj Y) :=
    NativeEvaluationComparison.whisker_app (PointedCGWH.SymmetricSpectrum.freeSmash r M)
      G E.functor ev (Mod.dayEvaluation S q) (nativeRightTensorNatIso r M) τ Y
