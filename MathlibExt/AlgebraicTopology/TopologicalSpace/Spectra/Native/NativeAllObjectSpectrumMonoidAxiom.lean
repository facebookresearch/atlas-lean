private def insertedDayLeg (X P : C.{u, v}) (c r : I) (M : V.{u, v})
    (j : M ⟶ P.functor.obj r) :
    X.functor.obj c ⊗ M ⟶ (X ⊗ P).functor.obj (c ⊗ r) :=
  (X.functor.obj c ◁ j) ≫ (DayFunctor.η X P).app (c, r)

private theorem insertedDayLeg_pairAction (P : C.{u, v}) (N : Mod C.{u, v} S.{u, v})
    (a c r : I) (M : V.{u, v}) (j : M ⟶ P.functor.obj r) :
    (S.{u, v}.functor.obj a ◁ insertedDayLeg N.X P c r M j) ≫
        PointedCGWH.SymmetricModulePresentation.pairAction
          (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} P N) a (c ⊗ r) =
      (α_ (S.{u, v}.functor.obj a) (N.X.functor.obj c) M).inv ≫
        (PointedCGWH.SymmetricModulePresentation.pairAction N a c ▷ M) ≫
        insertedDayLeg N.X P (a ⊗ c) r M j ≫
        (N.X ⊗ P).functor.map (α_ a c r).hom := by
  let SA : V.{u, v} := S.{u, v}.functor.obj a
  let X : V.{u, v} := N.X.functor.obj c
  let Y : V.{u, v} := N.X.functor.obj (a ⊗ c)
  let PR : V.{u, v} := P.functor.obj r
  let s : SA ⊗ X ⟶ Y := PointedCGWH.SymmetricModulePresentation.pairAction N a c
  let f : SA ⊗ (X ⊗ M) ⟶ SA ⊗ (X ⊗ PR) := SA ◁ (X ◁ j)
  let i := (DayFunctor.η N.X P).app (c, r)
  let i' := (DayFunctor.η N.X P).app (a ⊗ c, r)
  let k := (N.X ⊗ P).functor.map (α_ a c r).hom
  let T : Mod C.{u, v} S.{u, v} := Mod.FreeRelativeTensor.rightTensorModule A.{u, v} P N
  let t := PointedCGWH.SymmetricModulePresentation.pairAction T a (c ⊗ r)
  have hp : (SA ◁ i) ≫ t = (α_ SA X PR).inv ≫ (s ▷ PR) ≫ i' ≫ k :=
    RightTensorSource.rightTensor_pair_generator P N a c r
  have hi := insert_rightAction SA X Y M PR s j
  have hl : (SA ◁ insertedDayLeg N.X P c r M j) ≫ t = f ≫ ((SA ◁ i) ≫ t) := by
    dsimp only [insertedDayLeg]
    change (SA ◁ ((X ◁ j) ≫ i)) ≫ t = (SA ◁ (X ◁ j)) ≫ ((SA ◁ i) ≫ t)
    exact (congrArg (fun g => g ≫ t) (whiskerLeft_comp SA (X ◁ j) i)).trans
      (Category.assoc _ _ _)
  have h₁ := congrArg (fun g => f ≫ g) hp
  have h₂ := congrArg (fun g => g ≫ i' ≫ k) hi
  simp only [Category.assoc] at h₂
  have h₃ : f ≫ ((α_ SA X PR).inv ≫ (s ▷ PR) ≫ i' ≫ k) =
      (α_ SA X M).inv ≫ (s ▷ M) ≫ (Y ◁ j) ≫ i' ≫ k := h₂
  exact hl.trans (h₁.trans h₃)

private def insertedBlockDayLeg (X P : C.{u, v}) (r m : I) (M : V.{u, v})
    (j : M ⟶ P.functor.obj r) (d : BlockDecomposition r m) :
    X.functor.obj d.left ⊗ M ⟶ (X ⊗ P).functor.obj m :=
  insertedDayLeg X P d.left r M j ≫ (X ⊗ P).functor.map d.hom

private def sphereGrowBlock (a : I) {r m : I} (d : BlockDecomposition r m) :
    BlockDecomposition r (a ⊗ m) :=
  CostructuredArrow.mk (Y := a ⊗ d.left) ((α_ a d.left r).hom ≫ (a ◁ d.hom))

private theorem insertedBlockDayLeg_pairAction (P : C.{u, v}) (N : Mod C.{u, v} S.{u, v})
    (a r m : I) (M : V.{u, v}) (j : M ⟶ P.functor.obj r) (d : BlockDecomposition r m) :
    (S.{u, v}.functor.obj a ◁ insertedBlockDayLeg N.X P r m M j d) ≫
        PointedCGWH.SymmetricModulePresentation.pairAction
          (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} P N) a m =
      (α_ (S.{u, v}.functor.obj a) (N.X.functor.obj d.left) M).inv ≫
        (PointedCGWH.SymmetricModulePresentation.pairAction N a d.left ▷ M) ≫
        insertedBlockDayLeg N.X P r (a ⊗ m) M j (sphereGrowBlock a d) := by
  let SA : V.{u, v} := S.{u, v}.functor.obj a
  let X : V.{u, v} := N.X.functor.obj d.left
  let Y : V.{u, v} := N.X.functor.obj (a ⊗ d.left)
  let T : Mod C.{u, v} S.{u, v} := Mod.FreeRelativeTensor.rightTensorModule A.{u, v} P N
  let l := insertedDayLeg N.X P d.left r M j
  let l' := insertedDayLeg N.X P (a ⊗ d.left) r M j
  let t := PointedCGWH.SymmetricModulePresentation.pairAction T a m
  let t' := PointedCGWH.SymmetricModulePresentation.pairAction T a (d.left ⊗ r)
  let k := (N.X ⊗ P).functor.map d.hom
  let k' := (N.X ⊗ P).functor.map (a ◁ d.hom)
  let b := (N.X ⊗ P).functor.map (α_ a d.left r).hom
  let v := (α_ SA X M).inv ≫
    (PointedCGWH.SymmetricModulePresentation.pairAction N a d.left ▷ M)
  have hi : (SA ◁ k) ≫ t = t' ≫ k' := by
    have h := PointedCGWH.SymmetricModulePresentation.pairAction_input T a d.hom
    simp only [id_tensorHom] at h
    change (SA ◁ k) ≫ t = t' ≫ k' at h
    exact h
  have hl : (SA ◁ l) ≫ t' = v ≫ l' ≫ b := insertedDayLeg_pairAction P N a d.left r M j
  have h₁ : (SA ◁ insertedBlockDayLeg N.X P r m M j d) ≫ t =
      (SA ◁ l) ≫ ((SA ◁ k) ≫ t) := by
    exact (congrArg (fun f => f ≫ t) (whiskerLeft_comp SA l k)).trans (Category.assoc _ _ _)
  have h₂ := congrArg (fun f => (SA ◁ l) ≫ f) hi
  have h₃ : (SA ◁ l) ≫ (t' ≫ k') = (v ≫ l' ≫ b) ≫ k' :=
    ((Category.assoc _ _ _).symm).trans (congrArg (fun f => f ≫ k') hl)
  have hk : b ≫ k' = (N.X ⊗ P).functor.map ((α_ a d.left r).hom ≫ (a ◁ d.hom)) :=
    ((N.X ⊗ P).functor.map_comp _ _).symm
  have h₄ : (v ≫ l' ≫ b) ≫ k' =
      v ≫ l' ≫ (N.X ⊗ P).functor.map ((α_ a d.left r).hom ≫ (a ◁ d.hom)) := by
    exact (Category.assoc _ _ _).trans
      (congrArg (fun f => v ≫ f) ((Category.assoc _ _ _).trans (congrArg (fun f => l' ≫ f) hk)))
  exact h₁.trans (h₂.trans (h₃.trans h₄))

private theorem representedTensorGenerator_pairAction (N : Mod C.{u, v} S.{u, v})
    (a r m : I) (M : V.{u, v}) (d : BlockDecomposition r m) :
    (S.{u, v}.functor.obj a ◁ representedTensorGenerator N.X r m M d) ≫
        PointedCGWH.SymmetricModulePresentation.pairAction
          (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} ((representedDiagram r).obj M) N) a m =
      (α_ (S.{u, v}.functor.obj a) (N.X.functor.obj d.left) M).inv ≫
        (PointedCGWH.SymmetricModulePresentation.pairAction N a d.left ▷ M) ≫
        representedTensorGenerator N.X r (a ⊗ m) M (sphereGrowBlock a d) :=
  insertedBlockDayLeg_pairAction ((representedDiagram r).obj M) N a r m M
    (representedGenerator r M) d

