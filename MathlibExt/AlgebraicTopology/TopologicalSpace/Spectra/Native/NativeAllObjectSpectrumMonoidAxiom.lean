  [HasCoequalizers C]
  [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorLeft X)]
  [∀ X : C, PreservesColimitsOfSize.{0, 0} (tensorRight X)]

private theorem carrierModuleIso_forget (A : CommMon C) (P : C) (N : Mod C A.X) :
    (Mod.forget A.X).mapIso (carrierModuleIso A P N) = carrierIso A P N := by
  apply Iso.ext
  change (carrierModuleIso A P N).hom.hom = (carrierIso A P N).hom
  exact carrierModuleIso_hom A P N

end CategoryTheory.Mod.FreeRelativeTensorCarrier

namespace CategoryTheory.Mod
variable {I : Type u₁} [Category.{v₁} I] [MonoidalCategory I]
  {V : Type u₂} [Category.{v₂} V] [MonoidalCategory V]
  [MonoidalCategory (DayFunctor I V)] (A : DayFunctor I V) [MonObj A]

private theorem dayEvaluation_mapIso_original (q : I)
    {N N' : Mod (DayFunctor I V) A} (e : N ≅ N') :
    (dayEvaluation A q).mapIso e =
      ((DayFunctor.equiv I V).functor.mapIso ((Mod.forget A).mapIso e)).app q := by
  apply Iso.ext
