private def coefficientFirstGenerator (N : Mod C.{u, v} S.{u, v}) (r m : I) (M : V.{u, v})
    (d : BlockDecomposition r m) :
    M ⊗ N.X.functor.obj d.left ⟶ (N.X ⊗ (representedDiagram r).obj M).functor.obj m :=
  (β_ M (N.X.functor.obj d.left)).hom ≫ representedTensorGenerator N.X r m M d

private def scalarPairAction (N : Mod C.{u, v} S.{u, v}) (a c : I) (M : V.{u, v}) :
    S.{u, v}.functor.obj a ⊗ (M ⊗ N.X.functor.obj c) ⟶ M ⊗ N.X.functor.obj (a ⊗ c) :=
  (α_ (S.{u, v}.functor.obj a) M (N.X.functor.obj c)).inv ≫
    ((β_ (S.{u, v}.functor.obj a) M).hom ▷ N.X.functor.obj c) ≫
    (α_ M (S.{u, v}.functor.obj a) (N.X.functor.obj c)).hom ≫
    (M ◁ PointedCGWH.SymmetricModulePresentation.pairAction N a c)

private theorem coefficientFirstGenerator_pairAction (N : Mod C.{u, v} S.{u, v})
    (a r m : I) (M : V.{u, v}) (d : BlockDecomposition r m) :
    (S.{u, v}.functor.obj a ◁ coefficientFirstGenerator N r m M d) ≫
        PointedCGWH.SymmetricModulePresentation.pairAction
          (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} ((representedDiagram r).obj M) N) a m =
      scalarPairAction N a d.left M ≫
        coefficientFirstGenerator N r (a ⊗ m) M (sphereGrowBlock a d) := by
  let SA : V.{u, v} := S.{u, v}.functor.obj a
  let X : V.{u, v} := N.X.functor.obj d.left
  let Y : V.{u, v} := N.X.functor.obj (a ⊗ d.left)
  let s : SA ⊗ X ⟶ Y := PointedCGWH.SymmetricModulePresentation.pairAction N a d.left
  let b : M ⊗ X ⟶ X ⊗ M := (β_ M X).hom
  let b' : M ⊗ Y ⟶ Y ⊗ M := (β_ M Y).hom
  let q := representedTensorGenerator N.X r m M d
  let q' := representedTensorGenerator N.X r (a ⊗ m) M (sphereGrowBlock a d)
  let t := PointedCGWH.SymmetricModulePresentation.pairAction
    (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} ((representedDiagram r).obj M) N) a m
  let v := (α_ SA X M).inv ≫ (s ▷ M)
  let w := scalarPairAction N a d.left M
  have hp : (SA ◁ q) ≫ t = v ≫ q' := representedTensorGenerator_pairAction N a r m M d
  have hb : (SA ◁ b) ≫ v = w ≫ b' := NativeActionSource.coefficientFirstAction_symmetric SA M X Y s
  have h₁ : (SA ◁ coefficientFirstGenerator N r m M d) ≫ t =
      (SA ◁ b) ≫ ((SA ◁ q) ≫ t) :=
    (congrArg (fun f => f ≫ t) (whiskerLeft_comp SA b q)).trans (Category.assoc _ _ _)
  have h₂ := congrArg (fun f => (SA ◁ b) ≫ f) hp
  have h₃ := (Category.assoc (SA ◁ b) v q').symm
  have h₄ := congrArg (fun f => f ≫ q') hb
  have h₅ := Category.assoc w b' q'
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans h₅)))

private def coefficientScalarAction (N : Mod C.{u, v} S.{u, v}) (a c : I) (M K : V.{u, v})
    (g : K ⟶ S.{u, v}.functor.obj a) : K ⊗ (M ⊗ N.X.functor.obj c) ⟶
      M ⊗ N.X.functor.obj (a ⊗ c) :=
  (α_ K M (N.X.functor.obj c)).inv ≫
    ((β_ K M).hom ▷ N.X.functor.obj c) ≫ (α_ M K (N.X.functor.obj c)).hom ≫
    (M ◁ ((g ▷ N.X.functor.obj c) ≫ PointedCGWH.SymmetricModulePresentation.pairAction N a c))

private theorem scalarPairAction_coefficient (N : Mod C.{u, v} S.{u, v})
    (a c : I) (M K : V.{u, v}) (g : K ⟶ S.{u, v}.functor.obj a) :
    (g ▷ (M ⊗ N.X.functor.obj c)) ≫ scalarPairAction N a c M =
      coefficientScalarAction N a c M K g :=
  pre_scalarAction K (S.{u, v}.functor.obj a) M (N.X.functor.obj c)
    (N.X.functor.obj (a ⊗ c)) g (PointedCGWH.SymmetricModulePresentation.pairAction N a c)

private theorem coefficientFirstGenerator_pre_pairAction (N : Mod C.{u, v} S.{u, v})
    (a r m : I) (M K : V.{u, v}) (g : K ⟶ S.{u, v}.functor.obj a)
    (d : BlockDecomposition r m) :
    (K ◁ coefficientFirstGenerator N r m M d) ≫
        (g ▷ (N.X ⊗ (representedDiagram r).obj M).functor.obj m) ≫
        PointedCGWH.SymmetricModulePresentation.pairAction
          (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} ((representedDiagram r).obj M) N) a m =
      coefficientScalarAction N a d.left M K g ≫
        coefficientFirstGenerator N r (a ⊗ m) M (sphereGrowBlock a d) := by
  let q := coefficientFirstGenerator N r m M d
  let q' := coefficientFirstGenerator N r (a ⊗ m) M (sphereGrowBlock a d)
  let t := PointedCGWH.SymmetricModulePresentation.pairAction
    (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} ((representedDiagram r).obj M) N) a m
  let p := g ▷ (M ⊗ N.X.functor.obj d.left)
  have he := whisker_exchange g q
  have hp := coefficientFirstGenerator_pairAction N a r m M d
  have hs := scalarPairAction_coefficient N a d.left M K g
  have h₁ := (Category.assoc (K ◁ q)
    (g ▷ (N.X ⊗ (representedDiagram r).obj M).functor.obj m) t).symm
  have h₂ := congrArg (fun f => f ≫ t) he
  have h₃ := Category.assoc p (S.{u, v}.functor.obj a ◁ q) t
  have h₄ := congrArg (fun f => p ≫ f) hp
  have h₅ := (Category.assoc p (scalarPairAction N a d.left M) q').symm
  have h₆ := congrArg (fun f => f ≫ q') hs
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans (h₅.trans h₆))))

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeDayAction
