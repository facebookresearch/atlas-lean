attribute [local instance] _root_.NAMS.genericSmallHasColimit _root_.NAMS.genericSmallHasCoproduct

attribute [local instance] _root_.NAMS.SymmetricUnit.originalUnitExtensions

attribute [local instance] _root_.NAMS.smallHasColimit _root_.NAMS.smallHasCoproduct

open scoped CGWH.limits

set_option autoImplicit false
noncomputable section
universe uC vC uA uB

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Limits.CoproductEmbedding

variable {C : Type uC} [Category.{vC} C] {α : Type uA} {β : Type uB}
  (p : α ↪ β) (Y : β → C)

/-- The actual complement labels of the original coproduct embedding. -/
private abbrev Complement := {b : β // b ∉ Set.range p}

variable [HasCoproduct (fun a : α => Y (p a))]

private theorem legCast {a b : α} (h : a = b) :
    eqToHom (congrArg (fun a => Y (p a)) h.symm) ≫
      Sigma.ι (fun a : α => Y (p a)) a = Sigma.ι (fun a : α => Y (p a)) b := by
  cases h
  simp only [eqToHom_refl, Category.id_comp]

variable [HasCoproduct (fun b : Complement p => Y b.val)]
  [HasBinaryCoproduct (∐ fun a : α => Y (p a)) (∐ fun b : Complement p => Y b.val)]

private def splitInjection (b : β) :
    Y b ⟶ (∐ fun a : α => Y (p a)) ⨿ (∐ fun c : Complement p => Y c.val) := by
  classical
  exact if h : b ∈ Set.range p then
    eqToHom (congrArg Y (Classical.choose_spec h).symm) ≫
      Sigma.ι (fun a : α => Y (p a)) (Classical.choose h) ≫ coprod.inl
    else Sigma.ι (fun c : Complement p => Y c.val) ⟨b, h⟩ ≫ coprod.inr

private theorem splitInjection_old (a : α) :
    splitInjection p Y (p a) = Sigma.ι (fun a : α => Y (p a)) a ≫ coprod.inl := by
  classical
  have h : p a ∈ Set.range p := ⟨a, rfl⟩
  have hc : Classical.choose h = a := p.injective (Classical.choose_spec h)
  unfold splitInjection
  rw [dite_eq_left h]
  change eqToHom (congrArg Y (Classical.choose_spec h).symm) ≫
      Sigma.ι (fun a : α => Y (p a)) (Classical.choose h) ≫ coprod.inl = _
  rw [← Category.assoc]
  exact congrArg (fun f => f ≫ coprod.inl) (legCast p Y hc)

private theorem splitInjection_new (b : Complement p) :
    splitInjection p Y b.val = Sigma.ι (fun c : Complement p => Y c.val) b ≫ coprod.inr := by
  classical
  simp only [splitInjection, dite_eq_right b.property]

private def splitCofan : Cofan Y :=
  Cofan.mk ((∐ fun a : α => Y (p a)) ⨿ (∐ fun b : Complement p => Y b.val))
    (splitInjection p Y)

private def splitCofanIsColimit : IsColimit (splitCofan p Y) := by
  let descend (s : Cofan Y) := coprod.desc
    (Sigma.desc (fun a : α => s.inj (p a)))
    (Sigma.desc (fun b : Complement p => s.inj b.val))
  refine Cofan.IsColimit.mk (splitCofan p Y) descend ?_ ?_
  · intro s b
    change splitInjection p Y b ≫ descend s = s.inj b
    by_cases hb : b ∈ Set.range p
    · obtain ⟨a, rfl⟩ := hb
      rw [splitInjection_old]
      simp only [descend, Category.assoc, coprod.inl_desc, Sigma.ι_comp_desc]
    · rw [splitInjection_new p Y ⟨b, hb⟩]
      simp only [descend, Category.assoc, coprod.inr_desc, Sigma.ι_comp_desc]
  · intro s m hm
    apply coprod.hom_ext
    · apply Sigma.hom_ext
      intro a
      have h := hm (p a)
      change splitInjection p Y (p a) ≫ m = s.inj (p a) at h
      rw [splitInjection_old] at h
      have hR : Sigma.ι (fun a : α => Y (p a)) a ≫ (coprod.inl ≫ descend s) = s.inj (p a) := by
        simp only [descend, coprod.inl_desc, Sigma.ι_comp_desc]
      exact (Category.assoc _ _ _).symm.trans (h.trans hR.symm)
    · apply Sigma.hom_ext
      intro b
      have h := hm b.val
      change splitInjection p Y b.val ≫ m = s.inj b.val at h
      rw [splitInjection_new] at h
      have hR : Sigma.ι (fun c : Complement p => Y c.val) b ≫ (coprod.inr ≫ descend s) =
          s.inj b.val := by
        simp only [descend, coprod.inr_desc, Sigma.ι_comp_desc]
      exact (Category.assoc _ _ _).symm.trans (h.trans hR.symm)

variable [HasCoproduct Y]

/-- The original chosen coproduct is the binary coproduct of its embedded
original summands and its actual complement summands. -/
private def splitIso :
    ((∐ fun a : α => Y (p a)) ⨿ (∐ fun b : Complement p => Y b.val)) ≅ ∐ Y :=
  (splitCofanIsColimit p Y).coconePointUniqueUpToIso (coproductIsCoproduct Y)

private theorem splitIso_hom_leg (b : β) :
    splitInjection p Y b ≫ (splitIso p Y).hom = Sigma.ι Y b :=
  IsColimit.comp_coconePointUniqueUpToIso_hom
    (splitCofanIsColimit p Y) (coproductIsCoproduct Y) ⟨b⟩

/-- The full old binary injection is the actual original embedding map
after the complete target comparison, with every original label fixed. -/
private theorem splitIso_hom_old :
    (coprod.inl : (∐ fun a : α => Y (p a)) ⟶ _) ≫ (splitIso p Y).hom =
      Limits.Sigma.map' p (fun a : α => 𝟙 (Y (p a))) := by
  apply Sigma.hom_ext
  intro a
  rw [← Category.assoc, ← splitInjection_old, splitIso_hom_leg,
    Sigma.ι_comp_map', Category.id_comp]

/-- The entire original coproduct embedding has its actual binary
coprojection Arrow isomorphism, including both complete endpoint maps. -/
private def inclusionArrowIso :
    Arrow.mk (coprod.inl : (∐ fun a : α => Y (p a)) ⟶
      (∐ fun a : α => Y (p a)) ⨿ (∐ fun b : Complement p => Y b.val)) ≅
        Arrow.mk (Limits.Sigma.map' p (fun a : α => 𝟙 (Y (p a)))) :=
  Arrow.isoMk (Iso.refl _) (splitIso p Y) (by
    change 𝟙 _ ≫ Limits.Sigma.map' p (fun a : α => 𝟙 (Y (p a))) =
      coprod.inl ≫ (splitIso p Y).hom
    rw [Category.id_comp]
    exact (splitIso_hom_old p Y).symm)





end CategoryTheory.Limits.CoproductEmbedding
end

end

