namespace CategoryTheory.GammaWholePhysicalSource

variable {V : Type uV} {C : Type uC} [Category.{vC} C] [MonoidalCategory C]

/-- The whole original sphere family retains its Gamma, pair and both literal physical rotation endpoints together. -/
private structure PhysicalData (S Q : ℕ → C) (J : C ⥤ C) (k : Fin 2 → (𝟭 C ⟶ J)) where
  gamma : ∀ n : ℕ, S n ⟶ 𝟙_ C
  pair : ∀ n : ℕ, S n ⊗ S n ≅ Q n
  homotopy : ∀ n : ℕ, J.obj (Q n) ⟶ S n
  endpoint0 : ∀ n : ℕ, (k 0).app (Q n) ≫ homotopy n =
    GammaFirstSpanAlgebra.leftFace (pair n) (gamma n)
  endpoint1 : ∀ n : ℕ, (k 1).app (Q n) ≫ homotopy n =
    GammaFirstSpanAlgebra.rightFace (pair n) (gamma n)

/-- Both entire original packets construct the entire physical Gamma family before any source value is projected. -/
private def ofPackets (P : ℕ → V → C) (s : ℕ → V)
    (D : GammaSphereGeometry.Data (inferInstance : MonoidalCategory C) P s)
    (J : C ⥤ C) (k : Fin 2 → (𝟭 C ⟶ J))
    (R : OriginalRotationPacket.Data J k
      (fun n => P (n + n) (s (n + n))) (fun n => P n (s n)))
    (hl : R.left = D.left) (hr : R.right = D.right) :
    PhysicalData (fun n => P n (s n)) (fun n => P (n + n) (s (n + n))) J k where
  gamma := D.gamma
  pair := D.pair
  homotopy := R.homotopy
  endpoint0 := by
    intro n
    simpa only [GammaFirstSpanAlgebra.leftFace] using
      (R.endpoint0 n).trans ((congrFun hl n).trans (D.leftFormula n))
  endpoint1 := by
    intro n
