variable {I : Type} [EnrichedCategory PointedCGWH.{u, v} I]
attribute [local instance] MonoidalClosed.enrichedCategorySelf

/-- The entire original interval object family is its same literal scalar constructor. -/
private theorem object_whole :
    @PointedCGWH.EnrichedIntervalCylinder.object.{u, v} I _ =
      tensorLeftObject PointedCGWH.IntervalCoefficient.interval := rfl

/-- Every original inclusion retains its exact scalar unit and original interval endpoint. -/
private theorem inclusion_point (i : Fin 2) (X : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    PointedCGWH.EnrichedIntervalCylinder.inclusion i X =
      pointMap (PointedCGWH.IntervalCoefficient.endpoint i) X := rfl

/-- The original physical inclusion is the same point as a whole native map family. -/
private theorem inclusion_whole (i : Fin 2) :
    (fun X : EnrichedFunctorCat PointedCGWH.{u, v} I =>
      PointedCGWH.EnrichedIntervalCylinder.inclusion i X) =
        (fun X => pointMap (PointedCGWH.IntervalCoefficient.endpoint i) X) := rfl

/-- The literal original interval endpoint equation, before source-map projection. -/
private def Endpoint (i : Fin 2) (X Z : EnrichedFunctorCat PointedCGWH.{u, v} I)
    (H : PointedCGWH.EnrichedIntervalCylinder.object X ⟶ Z) (f : X ⟶ Z) : Prop :=
  PointedCGWH.EnrichedIntervalCylinder.inclusion i X ≫ H = f

/-- The exact scalar point proves the same literal original endpoint equation. -/
private theorem endpoint_of_point (i : Fin 2) (X Z : EnrichedFunctorCat PointedCGWH.{u, v} I)
    (H : PointedCGWH.EnrichedIntervalCylinder.object X ⟶ Z) (f : X ⟶ Z)
    (h : pointMap (PointedCGWH.IntervalCoefficient.endpoint i) X ≫ H = f) :
    Endpoint i X Z H f := h

/-- The endpoint predicate exposes its unchanged complete original inclusion equation. -/
private theorem endpoint_equation (i : Fin 2) (X Z : EnrichedFunctorCat PointedCGWH.{u, v} I)
    (H : PointedCGWH.EnrichedIntervalCylinder.object X ⟶ Z) (f : X ⟶ Z)
    (h : Endpoint i X Z H f) :
    PointedCGWH.EnrichedIntervalCylinder.inclusion i X ≫ H = f := h







end PointedCGWH.OriginalIntervalFieldBoundary

