  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers
  CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  MonoidalClosed.enrichedCategorySelf

/-- The actual original balanced orbit Iso is this same whole comparison at q=c+n. -/
private theorem freeSmashBalancedOrbitIso_normalized (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    freeSmashBalancedOrbitIso c n M Y =
      PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
        n (c + n) c (by omega) (Nat.add_sub_cancel_right c n) M Y := rfl

/-- The original block cast and actual original automorphism remain the full native block Iso. -/
private def originalOrbitBlockIso (c n : ℕ) (i : OrbitIndex c n) : card c ⊗ card n ≅ card (c + n) :=
  cardBlockSumIso (Eq.refl (c + n)) ≪≫ (orbitRepresentative c n i).asIso

/-- The original normalized block retains exactly the actual prefix-free finite representative. -/
private theorem originalOrbitBlockIso_hom (c n : ℕ) (i : OrbitIndex c n) :
    (originalOrbitBlockIso c n i).hom =
      (cardBlockSumIso (Eq.refl (c + n))).hom ≫ (orbitRepresentative c n i).asIso.hom := rfl

/-- Original native finite inverse legs have the precise independently normalized complement. -/
private theorem finiteNativeLeg_normalized (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    finiteNativeLeg c n M Y i =
      PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
        (Aut (card c)) (Aut (card (c + n))) (M ⊗ Y.X.functor.obj (card c))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
        (complementHom c n) (orbitRepresentative c n i) ≫
        (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
          n (c + n) c (by omega) (Nat.add_sub_cancel_right c n) M Y).inv :=
  (finiteNativeLeg_original c n M Y i).trans
    (congrArg (fun e => PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
      (Aut (card c)) (Aut (card (c + n))) (M ⊗ Y.X.functor.obj (card c))
      (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
      (complementHom c n) (orbitRepresentative c n i) ≫ e.inv)
      (freeSmashBalancedOrbitIso_normalized c n M Y))

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
