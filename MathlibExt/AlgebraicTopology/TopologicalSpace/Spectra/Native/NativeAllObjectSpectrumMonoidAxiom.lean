attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers

private theorem representedTensorGenerator_postcompose
    (N : PointedCGWH.SymmetricSequence.{u, v}) (r m k : Operad.SmallFinBijGroupoid)
    (M : PointedCGWH.{u, v}) (d : BlockDecomposition r m) (h : m ⟶ k) :
    representedTensorGenerator N r m M d ≫ (N ⊗ (representedDiagram r).obj M).functor.map h =
      representedTensorGenerator N r k M (blockPostcompose d h) := by
  let F := (N ⊗ (representedDiagram r).obj M).functor
  let j := N.functor.obj d.left ◁ representedGenerator r M
  let e := (DayFunctor.η N ((representedDiagram r).obj M)).app (d.left, r)
  change (j ≫ e ≫ F.map d.hom) ≫ F.map h = j ≫ e ≫ F.map (d.hom ≫ h)
  rw [F.map_comp]
  simp only [Category.assoc]

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeDayAction
