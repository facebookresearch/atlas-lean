namespace CategoryTheory.GammaSphereGeometry

variable {V : Type uV} {C : Type uC} [Category.{vC} C]

/-- The entire original sphere-pair family expressed in its complete object family. -/
private def PairType (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V) : Type _ :=
  letI := M
  ∀ n : ℕ, P n (S n) ⊗ P n (S n) ≅ P (n + n) (S (n + n))

/-- Both original face families, their original pair and their Gamma map remain in one source packet. -/
private structure Data (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V) where
  gamma : Independent.GammaType M P S
  pair : PairType M P S
  left : ∀ n : ℕ, P (n + n) (S (n + n)) ⟶ P n (S n)
  right : ∀ n : ℕ, P (n + n) (S (n + n)) ⟶ P n (S n)
  leftFormula : letI := M
    ∀ n : ℕ, left n = (pair n).inv ≫ gamma n ▷ P n (S n) ≫ (λ_ (P n (S n))).hom
  rightFormula : letI := M
    ∀ n : ℕ, right n = (pair n).inv ≫ P n (S n) ◁ gamma n ≫ (ρ_ (P n (S n))).hom

section Functor

variable [Category.{vV} V]

/-- The complete original functor family supplies the complete original sphere geometry before any component is
  projected. -/
private def ofOriginal (M : MonoidalCategory C) (F : ℕ → V ⥤ C) (S : ℕ → V)
    (γ : Independent.GammaType M (fun n K => (F n).obj K) S)
    (j : Independent.SpherePairType M F S) (l r : Independent.SphereFaceType F S)
    (hl : Independent.LeftSphereFormula M F S γ j l)
    (hr : Independent.RightSphereFormula M F S γ j r) :
    Data M (fun n K => (F n).obj K) S where
  gamma := γ
  pair := j
  left := l
  right := r
  leftFormula := by
    let : MonoidalCategory C := M
    intro n
    simpa only [tensorHom_id] using hl n
  rightFormula := by
    let : MonoidalCategory C := M
    intro n
    simpa only [id_tensorHom] using hr n

end Functor

/-- A proved whole object-family equality transports the entire original geometry packet together. -/
private def transport (M : MonoidalCategory C) (P Q : ℕ → V → C) (S : ℕ → V)
    (h : P = Q) (D : Data M P S) : Data M Q S :=
  Eq.mp (congrArg (fun P => Data M P S) h) D

section Model

variable [ModelCategory C]

/-- The same two original faces are equated after every first action from a cofibrant native source. -/
private def FirstComparison (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V)
    (D : Data M P S) : Prop :=
  letI := M
  ∀ (n : ℕ) (A Y : C) (_hA : IsCofibrant A) (g : A ⟶ P (n + n) (S (n + n)) ⊗ Y),
    (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (g ≫ D.left n ▷ Y) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (g ≫ D.right n ▷ Y)

/-- The first-source formula retains both original Gamma composites and the full physical source cofibrancy. -/
private def SourceFormula (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V)
    (D : Data M P S) : Prop :=
  letI := M
  ∀ (n : ℕ) (A Y : C) (_hA : IsCofibrant (P n (S n) ⊗ A))
      (f : A ⟶ P n (S n) ⊗ Y),
    (_root_.HomotopicalAlgebra.toHomotopyCategory C).map ((D.gamma n ▷ A ≫ (λ_ A).hom) ≫ f) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (P n (S n) ◁ (f ≫ (D.gamma n ▷ Y ≫ (λ_ Y).hom)))

/-- The original whole sphere geometry and physical first action prove the same Gamma source formula. -/
private theorem sourceFormula (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V)
    (D : Data M P S) (h : FirstComparison M P S D) : SourceFormula M P S D := by
  let : MonoidalCategory C := M
  intro n A Y hA f
  have he := h n (P n (S n) ⊗ A) Y hA
    (GammaFirstSpanAlgebra.span (Iso.refl (P n (S n) ⊗ A)) (D.pair n) f)
  rw [D.leftFormula n, D.rightFormula n] at he
  change (_root_.HomotopicalAlgebra.toHomotopyCategory C).map
      (GammaFirstSpanAlgebra.span (Iso.refl (P n (S n) ⊗ A)) (D.pair n) f ≫
        GammaFirstSpanAlgebra.leftFace (D.pair n) (D.gamma n) ▷ Y) =
    (_root_.HomotopicalAlgebra.toHomotopyCategory C).map
      (GammaFirstSpanAlgebra.span (Iso.refl (P n (S n) ⊗ A)) (D.pair n) f ≫
        GammaFirstSpanAlgebra.rightFace (D.pair n) (D.gamma n) ▷ Y) at he
  rw [GammaFirstSpanAlgebra.span_left, GammaFirstSpanAlgebra.span_right] at he
  simpa only [GammaFirstSpanAlgebra.mixedLeft, GammaFirstSpanAlgebra.reduction,
    Iso.refl_hom, Category.id_comp] using he

/-- The full proved physical source formula is retained as data before native source projection. -/
private structure FirstJoin (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V) where
  geometry : Data M P S
  first : SourceFormula M P S geometry

/-- The original full sphere packet and first action construct the full source join. -/
private def firstJoin (M : MonoidalCategory C) (P : ℕ → V → C) (S : ℕ → V)
    (D : Data M P S) (h : FirstComparison M P S D) : FirstJoin M P S :=
  ⟨D, sourceFormula M P S D h⟩

end Model






end CategoryTheory.GammaSphereGeometry

