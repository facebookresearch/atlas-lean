namespace NAMS

/-- The original extension and both equations pass through all four actual
endpoint maps of a whole Arrow retract. -/
private theorem intervalExtension_of_retract {C : Type uC} [Category.{vC} C]
    (T : C ⥤ C) (e : 𝟭 C ⟶ T) {A X D Z : C} {i : A ⟶ X} {j : D ⟶ Z}
    (r : RetractArrow i j) (hj : IntervalHomotopyExtension.property T e j) :
    IntervalHomotopyExtension.property T e i := by
  intro Y f H h0
  have hD : e.app D ≫ (T.map r.r.left ≫ H) = j ≫ (r.r.right ≫ f) := by
    calc
      _ = r.r.left ≫ (e.app A ≫ H) := by
        simpa only [Category.assoc, Arrow.mk_left, Arrow.mk_right,
          Functor.id_obj, Functor.id_map] using
          congrArg (fun k => k ≫ H) (e.naturality r.r.left).symm
      _ = (r.r.left ≫ i) ≫ f := by rw [h0, Category.assoc]
      _ = _ := by rw [r.r_w, Category.assoc]
  obtain ⟨K, hK0, hKj⟩ := hj Y (r.r.right ≫ f) (T.map r.r.left ≫ H) hD
  refine ⟨T.map r.i.right ≫ K, ?_, ?_⟩
  · calc
      _ = r.i.right ≫ (e.app Z ≫ K) := by
        simpa only [Category.assoc, Arrow.mk_left, Arrow.mk_right,
          Functor.id_obj, Functor.id_map] using
          congrArg (fun k => k ≫ K) (e.naturality r.i.right).symm
      _ = r.i.right ≫ (r.r.right ≫ f) := by rw [hK0]
      _ = f := by
        rw [← Category.assoc, r.retract_right]
        exact Category.id_comp f
  · calc
      _ = T.map (i ≫ r.i.right) ≫ K := by rw [T.map_comp, Category.assoc]
      _ = T.map (r.i.left ≫ j) ≫ K := by rw [r.i_w]
      _ = T.map r.i.left ≫ (T.map j ≫ K) := by rw [T.map_comp, Category.assoc]
      _ = T.map r.i.left ≫ (T.map r.r.left ≫ H) := by rw [hKj]
      _ = T.map (r.i.left ≫ r.r.left) ≫ H := by rw [T.map_comp, Category.assoc]
      _ = H := by
        rw [r.retract_left]
        exact (congrArg (fun k => k ≫ H) (T.map_id A)).trans (Category.id_comp H)


end NAMS

