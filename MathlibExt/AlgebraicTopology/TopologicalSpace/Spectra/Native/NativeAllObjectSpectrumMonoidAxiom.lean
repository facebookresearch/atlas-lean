open _root_.PointedCGWH.Spectra.Orthogonal.CurrentScalarSphere.NAMS.O0115 (T)
/-- The whole original scalar shift comparison keeps the actual native
restriction and both original group maps at every signed degree. -/
private def originalScalarIntegerNatIso (q : ℤ) : integerPiFunctor.{u, v} q ≅
    T.{u, v} ⋙ integerPiFunctor (q + 1) :=
  NativeStableCofiberIntegerMaps.scalarIntegerPiNatIso
    (j := sequentialOrthogonalOperatorIndexFunctor.{u, v}) q

/-- The actual scalar one-sphere preserves and reflects all signed integer
map isomorphisms, with arbitrary original arrow endpoints. -/
private theorem originalScalarSphere_integerPi_iff {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map (T.map f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map f) := by
  constructor
  · intro h q
    have hScalar : IsIso ((T ⋙ integerPiFunctor (q + 1)).map f) := by
      rw [Functor.comp_map]
      exact h (q + 1)
    exact (NatIso.isIso_map_iff (F₁ := integerPiFunctor q)
      (F₂ := T ⋙ integerPiFunctor (q + 1)) (originalScalarIntegerNatIso q) f).mpr hScalar
  · intro h q
    obtain ⟨p, rfl⟩ : ∃ p : ℤ, p + 1 = q := ⟨q - 1, by omega⟩
    have hShift := (NatIso.isIso_map_iff (F₁ := integerPiFunctor p)
      (F₂ := T ⋙ integerPiFunctor (p + 1)) (originalScalarIntegerNatIso p) f).mp (h p)
    rw [Functor.comp_map] at hShift
    exact hShift

/-- Each exact original scalar sphere power preserves and reflects the
complete signed integer map family, using the original scalar unit and
associator Arrow comparisons. -/
private theorem originalScalarSpherePower_integerPi_iff (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map
      ((EnrichedFunctorCat.tensorLeft (TensorPower.tensorPowObj PointedCGWH.sphereOne n)).map f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map f) := by
  let _ : Wpi.RespectsIso := by
    dsimp only [Wpi, Actual.OrthogonalIntegerHomotopy.integerPiStarEquivalences,
      PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry.integerPiStarEquivalences]
    infer_instance
  have h : Wpi ((EnrichedFunctorCat.tensorLeft
      (TensorPower.tensorPowObj PointedCGWH.sphereOne n)).map f) ↔ Wpi f := by
    induction n generalizing X Y with
    | zero =>
        let e : Arrow.mk ((EnrichedFunctorCat.tensorLeft (𝟙_ PointedCGWH.{u, v})).map f) ≅
            Arrow.mk f :=
          Arrow.isoMk (scalarUnitIso X) (scalarUnitIso Y) (scalarUnitIso_naturality f).symm
        exact Wpi.arrow_mk_iso_iff e
    | succ n ih =>
        let M := TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n
        let e : Arrow.mk ((EnrichedFunctorCat.tensorLeft (M ⊗ PointedCGWH.sphereOne)).map f) ≅
            Arrow.mk ((EnrichedFunctorCat.tensorLeft M).map (T.map f)) :=
          Arrow.isoMk (scalarAssociatorIso M PointedCGWH.sphereOne X)
            (scalarAssociatorIso M PointedCGWH.sphereOne Y)
            (scalarAssociatorIso_naturality M PointedCGWH.sphereOne f).symm
        have hOne : Wpi (T.map f) ↔ Wpi f :=
          (integerPiStarEquivalences_iff (T.map f)).trans
            ((originalScalarSphere_integerPi_iff f).trans (integerPiStarEquivalences_iff f).symm)
        exact (Wpi.arrow_mk_iso_iff e).trans ((ih (T.map f)).trans hOne)
  exact (integerPiStarEquivalences_iff _).symm.trans
    (h.trans (integerPiStarEquivalences_iff f))

/-- The original coefficient comparison identifies the full scalar Arrow
for the representation sphere with the same original sphere power Arrow. -/
private def originalRepresentationSphereScalarArrowIso (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    Arrow.mk ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f) ≅
      Arrow.mk ((EnrichedFunctorCat.tensorLeft
        (TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n)).map f) := by
  let e := (EnrichedFunctorCat.tensorBifunctor
    (A := CategoryTheory.Spectra.OrthogonalOperatorIndex.{u, v})).mapIso
      (CategoryTheory.Spectra.originalSpherePowerComparisonIso.{u, v} n).symm
  exact Arrow.isoMk (e.app X) (e.app Y) (e.hom.naturality f).symm

/-- Every actual original representation sphere preserves and reflects the
same full signed integer map family, without a hypothesis on either endpoint. -/
private theorem originalRepresentationSphere_integerPi_iff (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map
      ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map f) := by
  let _ : Wpi.RespectsIso := by
    dsimp only [Wpi, Actual.OrthogonalIntegerHomotopy.integerPiStarEquivalences,
      PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry.integerPiStarEquivalences]
    infer_instance
  exact (integerPiStarEquivalences_iff _).symm.trans
    ((Wpi.arrow_mk_iso_iff (originalRepresentationSphereScalarArrowIso n f)).trans
      ((integerPiStarEquivalences_iff _).trans (originalScalarSpherePower_integerPi_iff n f)))







