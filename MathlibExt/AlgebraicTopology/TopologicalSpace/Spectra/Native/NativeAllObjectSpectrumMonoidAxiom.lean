/-- The sealed entire original scalar/free family gives the same literal
free representation-sphere Arrow and scalar of its original free-unit Arrow.
Both arbitrary spectrum endpoints and their native maps remain unchanged. -/
private def originalFreeRepresentationSphereScalarArrowIso (a : OrthogonalOperatorIndex.{u, v})
    (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    Arrow.mk (Free.object a (PointedCGWH.orthogonalSphere.{u, v} n) ◁ f) ≅
      Arrow.mk ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map
        (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :=
  originalFreeUnitScalarArrowIso a (PointedCGWH.orthogonalSphere n) f

/-- The exact whole original free-sphere comparison retains both original
coefficient maps at every actual operator and arbitrary input Arrow. -/
private theorem originalFreeRepresentationSphereScalarArrowIso_original :
    originalFreeRepresentationSphereScalarArrowIso.{u, v} =
      fun a n {X Y} (f : X ⟶ Y) =>
        originalFreeUnitScalarArrowIso a (PointedCGWH.orthogonalSphere n) f := rfl

/-- Every original free representation sphere and its original free-unit
coefficient give equivalent complete signed integer map tests, for every
actual orthogonal operator and arbitrary original Arrow. -/
private theorem originalFreeSphereSmash_integerPi_iff_unitCoefficient
    (a : OrthogonalOperatorIndex.{u, v}) (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map
      (Free.object a (PointedCGWH.orthogonalSphere.{u, v} n) ◁ f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map
        (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) := by
  let _ : Wpi.RespectsIso := by
    dsimp only [Wpi, Actual.OrthogonalIntegerHomotopy.integerPiStarEquivalences,
      PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry.integerPiStarEquivalences]
    infer_instance
  exact (integerPiStarEquivalences_iff _).symm.trans
    ((Wpi.arrow_mk_iso_iff (originalFreeRepresentationSphereScalarArrowIso a n f)).trans
      ((integerPiStarEquivalences_iff _).trans
        (CurrentScalarSphere.originalRepresentationSphere_integerPi_iff n
          (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f))))

/-- The original ofIndex chart retains the same complete free-sphere and
free-unit integer test family, including both degree-zero cases. -/
private theorem originalFreeSphereSmash_integerPi_iff_unitCoefficient_ofIndex
    (r n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((integerPiFunctor q).map
      (Free.object (OrthogonalOperatorIndex.ofIndex r)
        (PointedCGWH.orthogonalSphere.{u, v} n) ◁ f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map
        (Free.object (OrthogonalOperatorIndex.ofIndex r) (𝟙_ PointedCGWH.{u, v}) ◁ f)) :=
  originalFreeSphereSmash_integerPi_iff_unitCoefficient (OrthogonalOperatorIndex.ofIndex r) n f






