namespace PointedCGWH.OriginalLanScalarPointComparison

variable {I D : Type} [EnrichedCategory PointedCGWH.{u, v} I]
  [EnrichedCategory PointedCGWH.{u, v} D]

attribute [local instance] PointedCGWH.EnrichedMapping.hasSmallLimits
  MonoidalClosed.enrichedCategorySelf MonoidalClosed.enrichedOrdinaryCategorySelf
  PointedCGWH.EnrichedKan.hasObjectCoproduct PointedCGWH.EnrichedKan.hasRelationCoproduct
  PointedCGWH.EnrichedKan.hasBalancingCoequalizer

/-- Every original scalar point commutes with the actual whole Kan tensor map. -/
private theorem leftKan_point (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (X : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    (leftKan j).map (pointMap p X) ≫ leftKanTensorHom j T X =
      pointMap p ((leftKan j).obj X) := by
  rw [pointMap, pointMap, Functor.map_comp, Category.assoc,
    leftKanTensorHom_scalar_naturality, ← Category.assoc]
  rw [leftKan_scalarUnit_inverse]

/-- The exact scalar-slot associator and original Kan tensor comparison. -/
private def scalarKanIso (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    (T M : PointedCGWH.{u, v}) (Y : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    (leftKan j).obj (tensorLeftObject (T ⊗ M) Y) ≅
      tensorLeftObject T ((leftKan j).obj (tensorLeftObject M Y)) :=
  (leftKan j).mapIso (scalarAssociatorIso T M Y) ≪≫
    leftKanTensorIso j T (tensorLeftObject M Y)

/-- Both complete original forward maps remain in the scalar Kan comparison. -/
private theorem scalarKanIso_hom (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    (T M : PointedCGWH.{u, v}) (Y : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    (scalarKanIso j T M Y).hom =
      (leftKan j).map (scalarAssociatorIso T M Y).hom ≫
        leftKanTensorHom j T (tensorLeftObject M Y) := rfl

/-- Both complete original inverse maps remain in reverse order. -/
private theorem scalarKanIso_inv (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    (T M : PointedCGWH.{u, v}) (Y : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    (scalarKanIso j T M Y).inv =
      leftKanTensorInv j T (tensorLeftObject M Y) ≫
        (leftKan j).map (scalarAssociatorIso T M Y).inv := rfl

/-- Every actual coefficient point reaches the same point of the original Kan object. -/
private theorem scalarKanIso_point (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (M : PointedCGWH.{u, v}) (Y : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    (leftKan j).map (scalarTensorMap (coefficientPoint p M) Y) ≫
        (scalarKanIso j T M Y).hom =
      pointMap p ((leftKan j).obj (tensorLeftObject M Y)) := by
  rw [scalarKanIso_hom, ← Category.assoc, ← Functor.map_comp, scalarPoint_associator]
  exact leftKan_point j p (tensorLeftObject M Y)

/-- The inverse comparison carries that same original point back to its coefficient map. -/
private theorem scalarKanIso_inverse_point (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    {T : PointedCGWH.{u, v}} (p : 𝟙_ PointedCGWH.{u, v} ⟶ T)
    (M : PointedCGWH.{u, v}) (Y : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    pointMap p ((leftKan j).obj (tensorLeftObject M Y)) ≫
        (scalarKanIso j T M Y).inv =
      (leftKan j).map (scalarTensorMap (coefficientPoint p M) Y) := by
  rw [← scalarKanIso_point j p M Y]
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- Every original coefficient arrow preserves the whole scalar Kan square. -/
private theorem scalarKanIso_coefficient (j : EnrichedFunctor PointedCGWH.{u, v} I D)
    (T : PointedCGWH.{u, v}) {M M' : PointedCGWH.{u, v}} (f : M ⟶ M')
    (Y : EnrichedFunctorCat PointedCGWH.{u, v} I) :
    (leftKan j).map (scalarTensorMap (T ◁ f) Y) ≫ (scalarKanIso j T M' Y).hom =
      (scalarKanIso j T M Y).hom ≫
        tensorLeftMap T ((leftKan j).map (scalarTensorMap f Y)) := by
  rw [scalarKanIso_hom, scalarKanIso_hom, ← Category.assoc, ← Functor.map_comp,
    scalarAssociatorIso_scalar_right, Functor.map_comp, Category.assoc,
    leftKanTensorHom_naturality]
  exact (Category.assoc _ _ _).symm









end PointedCGWH.OriginalLanScalarPointComparison

