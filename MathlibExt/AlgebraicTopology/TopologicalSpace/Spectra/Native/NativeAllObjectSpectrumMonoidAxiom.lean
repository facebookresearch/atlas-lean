  let _ : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  change weakEquivalences C.{u, v} _ ↔ weakEquivalences C.{u, v} _
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1]
  exact originalFreeSphereSmash_omegaTests_iff_unitCoefficient a n f

/-- At the actual canonical finite index the original sphere sequence
coefficient has the same original free-unit coefficient tests. -/
