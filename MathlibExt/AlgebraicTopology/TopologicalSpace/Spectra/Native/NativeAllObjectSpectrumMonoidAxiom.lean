variable {C : Type uC} [Category.{vC} C] {I : Type uI}

/-- A genuine natural reduction whose endpoint maps have an original
two-of-three property preserves and reflects that property on input arrows. -/
private theorem reduction_map_iff (T : C ⥤ C) (τ : T ⟶ 𝟭 C)
    (W : MorphismProperty C) [W.HasTwoOutOfThreeProperty]
    (hτ : ∀ X, W (τ.app X)) {X Y : C} (f : X ⟶ Y) :
    W (T.map f) ↔ W f := by
  have hNaturality : T.map f ≫ τ.app Y = τ.app X ≫ f := by
    simpa only [Functor.id_map] using τ.naturality f
  constructor
  · intro hf
    apply W.of_precomp (τ.app X) f (hτ X)
    rw [← hNaturality]
    exact W.comp_mem (T.map f) (τ.app Y) hf (hτ Y)
  · intro hf
    apply W.of_postcomp (T.map f) (τ.app Y) (hτ Y)
    rw [hNaturality]
    exact W.comp_mem (τ.app X) f (hτ X) hf

/-- Whole original tensor and action equalities are eliminated before any
functor/source getter or mapped arrow is selected. Genuine naturality and
the internally supplied original reduction endpoint properties give reflection. -/
private theorem tensorMap_mem_iff (M N : MonoidalCategory C) (hMN : M = N)
    (S T : I → C) (hST : S = T)
    (A : letI := M; ∀ i, GammaFirstNatSource.Action (S i))
    (E : letI := N; ∀ i, GammaFirstNatSource.Action (T i)) (hEA : HEq E A)
    (W : MorphismProperty C) [W.HasTwoOutOfThreeProperty]
    (hτ : letI := N; ∀ i X, W ((E i).reduction.app X)) :
    letI := N
    ∀ i {X Y : C} (f : X ⟶ Y), W (S i ◁ f) ↔ W f := by
  cases hST
  cases hMN
  have hAction : E = A := eq_of_heq hEA
  cases hAction
  let _ : MonoidalCategory C := M
  intro i X Y f
  have hSource := (A i).source
  have h := reduction_map_iff (A i).functor (A i).reduction W (hτ i) f
  rw [hSource] at h
  exact h




end CategoryTheory.OriginalGammaWholeActionPropertyMap

