the native permitted-size Omega coproduct closure. -/
private theorem originalOmegaCoproducts : MorphismProperty.IsStableUnderCoproducts.{v}
    (NativeK.omegaTests Actual.orthogonalFamily.{u, v}) :=
  { isStableUnderCoproductsOfShape := fun J =>
      MorphismProperty.IsStableUnderCoproductsOfShape.mk _ J
        (fun _ _ _ _ f hf => OriginalHEPOmegaClosure.originalCoproductMap_omegaTests f hf) }

/-- The same two actual preserved caller pushouts and all original vertical
maps supply the comparison; only their already proved image HEP is used. -/
private theorem comparison_of_pushout {P Q : C.{u, v} ⥤ C.{u, v}} (α : P ⟶ Q)
    [PreservesColimitsOfShape WalkingSpan P] [PreservesColimitsOfShape WalkingSpan Q]
    {K L Z R : C.{u, v}} (i : K ⟶ L) (z : K ⟶ Z) (kL : L ⟶ R) (kZ : Z ⟶ R)
    (sq : IsPushout i z kL kZ)
    (hP : PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    (hQ : PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i))
    (hK : NativeK.omegaTests Actual.orthogonalFamily (α.app K))
    (hL : NativeK.omegaTests Actual.orthogonalFamily (α.app L))
    (hZ : NativeK.omegaTests Actual.orthogonalFamily (α.app Z)) :
    NativeK.omegaTests Actual.orthogonalFamily (α.app R) :=
  OriginalHEPOmegaClosure.originalHEPPushoutComparison_omegaTests
    (P.map i) (P.map z) (P.map kL) (P.map kZ)
    (Q.map i) (Q.map z) (Q.map kL) (Q.map kZ) (sq.map P) (sq.map Q) hP hQ
    (α.app K) (α.app L) (α.app Z) (α.app R)
    (α.naturality i).symm (α.naturality z).symm
    (α.naturality kL).symm (α.naturality kZ).symm hK hL hZ

/-- Original generator endpoint tests pass through the full original
relative I-cell diagram using the genuine cofan, pushout and ordinal APIs. -/
private theorem comparison_of_originalICells
    {P Q : C.{u, v} ⥤ C.{u, v}} (α : P ⟶ Q)
    [PreservesColimitsOfSize.{v, v} P] [PreservesColimitsOfSize.{v, v} Q]
    [PreservesColimitsOfShape WalkingSpan P] [PreservesColimitsOfShape WalkingSpan Q]
    {J : Type w} [Small.{v} J] [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P] [PreservesColimitsOfSize.{w, w} Q]
    (hIP : ∀ {K L : C.{u, v}} (i : K ⟶ L), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    (hIQ : ∀ {K L : C.{u, v}} (i : K ⟶ L), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i))
    (hEndpoints : ∀ {K L : C.{u, v}} (i : K ⟶ L), NativeK.levelI i →
      NativeK.omegaTests Actual.orthogonalFamily (α.app K) ∧
        NativeK.omegaTests Actual.orthogonalFamily (α.app L))
    {X Y : C.{u, v}} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v} (fun (_ : J) => (NativeK.levelI (I := A.{u, v})).homFamily) f)
    (hX : NativeK.omegaTests Actual.orthogonalFamily (α.app X)) :
    NativeK.omegaTests Actual.orthogonalFamily (α.app Y) := by
  let _ := originalOmegaCoproducts.{u, v} (B := B)
  exact OriginalICellImageHistory.comparison_of_relativeICells
    Actual.orthogonalFamily α hIP hIQ hEndpoints (comparison_of_pushout α) c hX










