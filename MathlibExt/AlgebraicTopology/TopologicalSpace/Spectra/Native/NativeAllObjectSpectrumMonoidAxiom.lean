    exact Category.id_comp _)

/-- Every original property respecting whole Arrow isomorphisms transfers
through the same original Gamma/unitor square. -/
private theorem gammaReduction_mem_iff (S : I → C) (γ : ∀ i, S i ⟶ 𝟙_ C)
