namespace CategoryTheory.Mod.FreeRelativeTensorCarrier
variable {J : Type u₁} [Category.{v₁} J] [MonoidalCategory J]
  {W : Type u₂} [Category.{v₂} W] [MonoidalCategory W]
  [MonoidalCategory (DayFunctor J W)] [BraidedCategory (DayFunctor J W)]
  [HasCoequalizers (DayFunctor J W)]
  [∀ X : DayFunctor J W, PreservesColimitsOfSize.{0, 0} (tensorLeft X)]
  [∀ X : DayFunctor J W, PreservesColimitsOfSize.{0, 0} (tensorRight X)]

private theorem carrierModuleIso_dayEvaluation (A : CommMon (DayFunctor J W))
    (P : DayFunctor J W) (N : Mod (DayFunctor J W) A.X) (q : J) :
    (Mod.dayEvaluation A.X q).mapIso (carrierModuleIso A P N) =
      ((DayFunctor.equiv J W).functor.mapIso (carrierIso A P N)).app q := by
  let R : Mod (DayFunctor J W) A.X :=
    ((Mod.relativeTensor A).obj ((Mod.free A.X).obj P)).obj N
  let T : Mod (DayFunctor J W) A.X := Mod.FreeRelativeTensor.rightTensorModule A P N
  let e : R ≅ T := carrierModuleIso A P N
  have h : (Mod.forget A.X).mapIso e = carrierIso A P N := carrierModuleIso_forget A P N
  exact (Mod.dayEvaluation_mapIso_original A.X q e).trans
    (congrArg (fun z : R.X ≅ T.X =>
        ((DayFunctor.equiv J W).functor.mapIso z).app q) h)

end CategoryTheory.Mod.FreeRelativeTensorCarrier

