noncomputable section
universe u v

open CategoryTheory CategoryTheory.Limits CategoryTheory.EnrichedFunctorCat
open scoped CGWH.limits MonoidalClosed

namespace PointedCGWH.Spectra.OriginalCoproductEmbedding

attribute [local instance] MonoidalClosed.enrichedCategorySelf

variable {I : Type} [EnrichedCategory PointedCGWH.{u, v} I]

/-- Every actual embedding of original native coproduct labels is a genuine
based HEP map, by its complete original binary-coprojection Arrow comparison. -/
private theorem sigmaEmbedding_basedHEP {α β : Type} (p : α ↪ β)
    (Y : β → EnrichedFunctorCat PointedCGWH.{u, v} I) :
    PointedCGWH.EnrichedBasedHomotopyExtension.property
      (Limits.Sigma.map' p (fun a : α => 𝟙 (Y (p a)))) := by
  let e := CoproductEmbedding.inclusionArrowIso p Y
  have h : PointedCGWH.EnrichedBasedHomotopyExtension.property
      (coprod.inl : (∐ fun a : α => Y (p a)) ⟶
        (∐ fun a : α => Y (p a)) ⨿
          (∐ fun b : CoproductEmbedding.Complement p => Y b.val)) :=
    PointedCGWH.EnrichedBasedHomotopyExtension.coprod_inl_mem _ _
  exact (PointedCGWH.EnrichedBasedHomotopyExtension.property.arrow_mk_iso_iff e).mp h

/-- Each original native component of the same full embedding map is the
actual closed inclusion, with every original coproduct label retained. -/
private theorem sigmaEmbedding_component_closed {α β : Type} (p : α ↪ β)
    (Y : β → EnrichedFunctorCat PointedCGWH.{u, v} I) (a : I) :
    Topology.IsClosedEmbedding (ConcreteCategory.hom
      (component (Limits.Sigma.map' p (fun i : α => 𝟙 (Y (p i)))) a).right) :=
  PointedCGWH.Spectra.NativeOmegaWeakClosure.nativeHEP_component_closed _
    (sigmaEmbedding_basedHEP p Y) a




end PointedCGWH.Spectra.OriginalCoproductEmbedding
