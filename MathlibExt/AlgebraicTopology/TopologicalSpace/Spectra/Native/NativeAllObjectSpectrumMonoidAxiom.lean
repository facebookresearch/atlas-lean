namespace CategoryTheory.EnrichedFunctorCat.OriginalScalarComparisonTransport

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V]
  {I : Type uI} [EnrichedCategory V I]

attribute [local instance] MonoidalClosed.enrichedCategorySelf

/-- The actual scalar functor map Iso with its ordinary scalar-object type. -/
private def scalarIso (T : V) {X Y : EnrichedFunctorCat V I} (e : X ≅ Y) :
    tensorLeftObject T X ≅ tensorLeftObject T Y :=
  (EnrichedFunctorCat.tensorLeft T).mapIso e

/-- The full original scalar map remains the forward Iso component. -/
private theorem scalarIso_hom (T : V) {X Y : EnrichedFunctorCat V I} (e : X ≅ Y) :
    (scalarIso T e).hom = tensorLeftMap T e.hom := rfl

/-- The same original scalar functor map remains the inverse component. -/
private theorem scalarIso_inv (T : V) {X Y : EnrichedFunctorCat V I} (e : X ≅ Y) :
    (scalarIso T e).inv = tensorLeftMap T e.inv := rfl

/-- The full scalar comparison family before any scalar or coefficient is chosen. -/
private def Family (G : V ⥤ EnrichedFunctorCat V I) : Type _ :=
  ∀ (T M : V), G.obj (T ⊗ M) ≅ tensorLeftObject T (G.obj M)

/-- Carry both maps of the original scalar comparison through the entire natural Iso. -/
private def transport {F G : V ⥤ EnrichedFunctorCat V I} (e : F ≅ G) (σ : Family G)
    (T M : V) : F.obj (T ⊗ M) ≅ tensorLeftObject T (F.obj M) :=
  e.app (T ⊗ M) ≪≫ σ T M ≪≫ (scalarIso T (e.app M)).symm

/-- The entire transported forward map retains both original native comparison factors. -/
private theorem transport_hom {F G : V ⥤ EnrichedFunctorCat V I} (e : F ≅ G)
    (σ : Family G) (T M : V) :
    (transport e σ T M).hom =
      (e.app (T ⊗ M)).hom ≫ (σ T M).hom ≫ tensorLeftMap T (e.app M).inv := rfl

/-- The inverse keeps the same maps in reverse order. -/
private theorem transport_inv {F G : V ⥤ EnrichedFunctorCat V I} (e : F ≅ G)
    (σ : Family G) (T M : V) :
    (transport e σ T M).inv =
      tensorLeftMap T (e.app M).hom ≫ (σ T M).inv ≫ (e.app (T ⊗ M)).inv := by
  unfold transport
  dsimp only [Family] at σ
  rw [Iso.trans_inv, Iso.trans_inv, Iso.symm_inv, scalarIso_hom]
  exact Category.assoc _ _ _

/-- Every original coefficient point survives the exact complete comparison. -/
private theorem transport_point {F G : V ⥤ EnrichedFunctorCat V I} (e : F ≅ G)
    (σ : Family G) {T : V} (p : 𝟙_ V ⟶ T) (M : V)
    (hσ : G.map (coefficientPoint p M) ≫ (σ T M).hom = pointMap p (G.obj M)) :
    F.map (coefficientPoint p M) ≫ (transport e σ T M).hom =
      pointMap p (F.obj M) := by
  dsimp only [Family] at σ
  have hn : F.map (coefficientPoint p M) ≫ (e.app (T ⊗ M)).hom =
      (e.app M).hom ≫ G.map (coefficientPoint p M) := e.hom.naturality (coefficientPoint p M)
  let i : tensorLeftObject T (F.obj M) ≅ tensorLeftObject T (G.obj M) :=
    scalarIso T (e.app M)
  have hCore : F.map (coefficientPoint p M) ≫ (e.app (T ⊗ M)).hom ≫ (σ T M).hom =
      pointMap p (F.obj M) ≫ i.hom := by
    rw [← Category.assoc, hn, Category.assoc, hσ]
    exact (pointMap_naturality p (e.app M).hom).symm
  change F.map (coefficientPoint p M) ≫
    ((e.app (T ⊗ M)).hom ≫ (σ T M).hom ≫ i.inv) = pointMap p (F.obj M)
  calc
    _ = (F.map (coefficientPoint p M) ≫ (e.app (T ⊗ M)).hom ≫ (σ T M).hom) ≫
        i.inv := by simp only [Category.assoc]
    _ = (pointMap p (F.obj M) ≫ i.hom) ≫ i.inv := congrArg (fun k => k ≫ i.inv) hCore
    _ = pointMap p (F.obj M) := by
      rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- Every actual scalar point reaches the original coefficient map through the inverse. -/
private theorem transport_inverse_point {F G : V ⥤ EnrichedFunctorCat V I} (e : F ≅ G)
    (σ : Family G) {T : V} (p : 𝟙_ V ⟶ T) (M : V)
    (hσ : G.map (coefficientPoint p M) ≫ (σ T M).hom = pointMap p (G.obj M)) :
    pointMap p (F.obj M) ≫ (transport e σ T M).inv = F.map (coefficientPoint p M) := by
  rw [← transport_point e σ p M hσ]
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]










end CategoryTheory.EnrichedFunctorCat.OriginalScalarComparisonTransport

