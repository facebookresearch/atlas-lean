namespace CategoryTheory.OriginalZeroTensor

variable {C : Type u} [Category.{v} C]

/-- A left adjoint preserves the full null-map word through an original initial and terminal object. -/
private theorem functor_null (F : C ⥤ C) [F.IsLeftAdjoint] (Z : C)
    (hI : IsInitial Z) (hT : IsTerminal Z)
    (t : ∀ A : C, A ⟶ Z) (s : ∀ X : C, Z ⟶ X) (A X : C) :
    F.map (t A ≫ s X) = t (F.obj A) ≫ s (F.obj X) := by
  let e : F.obj Z ≅ Z := (hI.isInitialObj F).uniqueUpToIso hI
  have ht : F.map (t A) ≫ e.hom = t (F.obj A) := hT.hom_ext _ _
  have hs : e.inv ≫ F.map (s X) = s (F.obj X) := hI.hom_ext _ _
  calc
    F.map (t A ≫ s X) = F.map (t A) ≫ F.map (s X) := F.map_comp _ _
    _ = (F.map (t A) ≫ e.hom) ≫ (e.inv ≫ F.map (s X)) := by
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
    _ = t (F.obj A) ≫ s (F.obj X) := by rw [ht, hs]

section Tensor

variable [MonoidalCategory C] [MonoidalClosed C]

/-- The original closed tensor preserves the same full source-zero-target null word. -/
private theorem tensor_null (Z : C) (hI : IsInitial Z) (hT : IsTerminal Z)
    (t : ∀ A : C, A ⟶ Z) (s : ∀ X : C, Z ⟶ X) (K A X : C) :
    K ◁ (t A ≫ s X) = t (K ⊗ A) ≫ s (K ⊗ X) :=
  functor_null (tensorLeft K) Z hI hT t s A X

end Tensor




end CategoryTheory.OriginalZeroTensor

