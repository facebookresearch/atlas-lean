      P.{u, v} := by
  let _ : HasColimitsOfSize.{v, v} C.{u, v} := by infer_instance
  let _ : HasColimitsOfSize.{w, w} C.{u, v} := hasColimitsOfSizeOfUnivLE C.{u, v}
