namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers
  CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  MonoidalClosed.enrichedCategorySelf

/-- The original coefficient-first generator with an independent, explicitly transported complement. -/
private def normalizedCoefficientFirstGenerator (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :=
  PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
    (Aut (card c)) (Aut (card q)) (M ⊗ Y.X.functor.obj (card c))
    (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
    (blockAutHom (card c) (card n) (card q)
      (cardBlockSumIso (hc ▸ Nat.sub_add_cancel h))) g

/-- The original coefficient-last generator at that same independently normalized complement. -/
private def normalizedCoefficientLastGenerator (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :=
  PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
    (Aut (card c)) (Aut (card q)) (Y.X.functor.obj (card c) ⊗ M)
    (blockCoefficientAction Y.X (card c) M)
    (blockAutHom (card c) (card n) (card q)
      (cardBlockSumIso (hc ▸ Nat.sub_add_cancel h))) g

/-- The original coefficient order Iso has the same independently normalized native quotient objects. -/
private def normalizedCoefficientOrderIso (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    PointedCGWH.nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card q))
      (Y.X.functor.obj (card c) ⊗ M) (blockCoefficientAction Y.X (card c) M)
      (blockAutHom (card c) (card n) (card q) (cardBlockSumIso (hc ▸ Nat.sub_add_cancel h))) ≅
    PointedCGWH.nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card q))
      (M ⊗ Y.X.functor.obj (card c))
      (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
      (blockAutHom (card c) (card n) (card q) (cardBlockSumIso (hc ▸ Nat.sub_add_cancel h))) := by
  subst c
  exact PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y

/-- The original native Day Iso retains its actual Day source and the independent complement. -/
private def normalizedNativeDayIso (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (Y.X ⊗ PointedCGWH.SymmetricSpectrum.freeDiagram (card n) M).functor.obj (card q) ≅
    PointedCGWH.nativeBalancedSmash.{u, v, 0, 0} (Aut (card c)) (Aut (card q))
      (Y.X.functor.obj (card c) ⊗ M) (blockCoefficientAction Y.X (card c) M)
      (blockAutHom (card c) (card n) (card q) (cardBlockSumIso (hc ▸ Nat.sub_add_cancel h))) := by
  subst c
  exact NativeCardLeg.originalNativeDayIso Y.X h M

/-- The original block decomposition keeps its original block cast and original automorphism. -/
private def normalizedOriginalCardBlock (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (g : Aut (card q)) : BlockDecomposition (card n) (card q) :=
  CostructuredArrow.mk (Y := card c)
    ((cardBlockSumIso (hc ▸ Nat.sub_add_cancel h)).hom ≫ g.asIso.hom)

/-- The original quotient inverse factors after transporting the complement, with no source premise. -/
private theorem normalizedCardInverse_day_factor (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
      n q c h hc M Y).inv ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card q)).hom =
      (normalizedCoefficientOrderIso n q c h hc M Y).inv ≫
        (normalizedNativeDayIso n q c h hc M Y).inv := by
  subst c
  exact NativeCardLeg.freeSmashCardOrbitIso_inv_day_factor h M Y

/-- The transported original coefficient inverse keeps its exact original inverse braid. -/
private theorem normalizedCoefficientOrder_inv_generator (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    normalizedCoefficientFirstGenerator n q c h hc M Y g ≫
        (normalizedCoefficientOrderIso n q c h hc M Y).inv =
      (β_ (Y.X.functor.obj (card c)) M).inv ≫
        normalizedCoefficientLastGenerator n q c h hc M Y g := by
  subst c
  exact NativeCardLeg.coefficientOrderIso_inv_generator h M Y g

/-- The transported original Day inverse keeps the same original card decomposition and generator. -/
private theorem normalizedNativeDayIso_inv_generator (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    normalizedCoefficientLastGenerator n q c h hc M Y g ≫
        (normalizedNativeDayIso n q c h hc M Y).inv =
      representedTensorGenerator Y.X (card n) (card q) M (normalizedOriginalCardBlock n q c h hc g) := by
  subst c
  exact NativeCardLeg.originalNativeDayIso_inv_generator Y.X h M g

private theorem compose_closed_factors {C : Type uC} [Category.{vC} C]
    {A B D E F G : C} (l : A ⟶ B) (k : D ⟶ E) (a : B ⟶ F) (d : F ⟶ G)
    (b : B ⟶ E) (e : E ⟶ G) (s : A ⟶ D) (t : D ⟶ G)
    (h₁ : a ≫ d = b ≫ e) (h₂ : l ≫ b = s ≫ k) (h₃ : k ≫ e = t) :
    l ≫ a ≫ d = s ≫ t :=
  (congrArg (fun f => l ≫ f) h₁).trans
    (((Category.assoc l b e).symm).trans
      ((congrArg (fun f => f ≫ e) h₂).trans
        ((Category.assoc s k e).trans (congrArg (fun f => s ≫ f) h₃))))

/-- The three original closed factors compose after the independent complement transport. -/
private theorem normalizedCardInverse_day_generator (n q c : ℕ) (h : n ≤ q) (hc : q - n = c)
    (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card q)) :
    normalizedCoefficientFirstGenerator n q c h hc M Y g ≫
        (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
          n q c h hc M Y).inv ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card q)).hom =
      (β_ (Y.X.functor.obj (card c)) M).inv ≫
        representedTensorGenerator Y.X (card n) (card q) M
          (normalizedOriginalCardBlock n q c h hc g) :=
  compose_closed_factors
    (normalizedCoefficientFirstGenerator n q c h hc M Y g)
    (normalizedCoefficientLastGenerator n q c h hc M Y g)
    (PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.normalizedNativeBalancedLevelIso
      n q c h hc M Y).inv
    (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card q)).hom
    (normalizedCoefficientOrderIso n q c h hc M Y).inv
    (normalizedNativeDayIso n q c h hc M Y).inv
    (β_ (Y.X.functor.obj (card c)) M).inv
    (representedTensorGenerator Y.X (card n) (card q) M (normalizedOriginalCardBlock n q c h hc g))
    (normalizedCardInverse_day_factor n q c h hc M Y)
    (normalizedCoefficientOrder_inv_generator n q c h hc M Y g)
    (normalizedNativeDayIso_inv_generator n q c h hc M Y g)

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

