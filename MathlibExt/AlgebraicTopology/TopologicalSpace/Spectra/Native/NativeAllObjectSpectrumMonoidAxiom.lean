open CategoryTheory
attribute [local instance] Classical.propDecidable

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

/-- A stable label occurs in its actual finite orbit stage. -/
private def Appears (n : ℕ) (i : StableOrbitIndex n) (c : ℕ) : Prop :=
  ∃ j : OrbitIndex c n, orbitIntoStable c n j = i

private theorem appears_exists (n : ℕ) (i : StableOrbitIndex n) : ∃ c, Appears n i c :=
  orbitIntoStable_stage_exists n i

private theorem appears_mono (n : ℕ) (i : StableOrbitIndex n) {c d : ℕ} (h : c ≤ d)
    (hc : Appears n i c) : Appears n i d := by
  obtain ⟨j, hj⟩ := hc
  exact ⟨orbitInclusion n h j, (orbitIntoStable_inclusion n h j).trans hj⟩

/-- The first actual finite stage of this same stable orbit. -/
private def firstAppearance (n : ℕ) (i : StableOrbitIndex n) : ℕ := Nat.find (appears_exists n i)

private theorem firstAppearance_spec (n : ℕ) (i : StableOrbitIndex n) :
    Appears n i (firstAppearance n i) := Nat.find_spec (appears_exists n i)

private theorem firstAppearance_le (n : ℕ) (i : StableOrbitIndex n) (c : ℕ)
    (h : Appears n i c) : firstAppearance n i ≤ c := Nat.find_min' (appears_exists n i) h

private theorem appears_iff (n : ℕ) (i : StableOrbitIndex n) (c : ℕ) :
    Appears n i c ↔ firstAppearance n i ≤ c :=
  ⟨firstAppearance_le n i c,
    fun h => appears_mono n i h (firstAppearance_spec n i)⟩

/-- The genuine finite orbit label at its actual first stage. -/
private def firstOrbit (n : ℕ) (i : StableOrbitIndex n) : OrbitIndex (firstAppearance n i) n :=
  Classical.choose (firstAppearance_spec n i)

private theorem firstOrbit_spec (n : ℕ) (i : StableOrbitIndex n) :
    orbitIntoStable (firstAppearance n i) n (firstOrbit n i) = i :=
  Classical.choose_spec (firstAppearance_spec n i)

/-- Later stages use the actual original orbit-inclusion map. -/
private def activeOrbit (n : ℕ) (i : StableOrbitIndex n) (c : ℕ)
    (h : firstAppearance n i ≤ c) : OrbitIndex c n :=
  orbitInclusion n h (firstOrbit n i)

private theorem activeOrbit_spec (n : ℕ) (i : StableOrbitIndex n) (c : ℕ)
    (h : firstAppearance n i ≤ c) : orbitIntoStable c n (activeOrbit n i c h) = i :=
  (orbitIntoStable_inclusion n h (firstOrbit n i)).trans (firstOrbit_spec n i)

private theorem activeOrbit_unique (n : ℕ) (i : StableOrbitIndex n) (c : ℕ)
    (h : firstAppearance n i ≤ c) (j : OrbitIndex c n) (hj : orbitIntoStable c n j = i) :
    activeOrbit n i c h = j :=
  (orbitIntoStable_injective c n) ((activeOrbit_spec n i c h).trans hj.symm)

private theorem activeOrbit_inclusion (n : ℕ) (i : StableOrbitIndex n) {c d : ℕ}
    (hc : firstAppearance n i ≤ c) (hcd : c ≤ d) :
    orbitInclusion n hcd (activeOrbit n i c hc) = activeOrbit n i d (hc.trans hcd) := by
  apply orbitIntoStable_injective d n
  exact (orbitIntoStable_inclusion n hcd _).trans
    ((activeOrbit_spec n i c hc).trans (activeOrbit_spec n i d (hc.trans hcd)).symm)

private theorem activeOrbit_successor (n : ℕ) (i : StableOrbitIndex n) (c : ℕ)
    (hc : firstAppearance n i ≤ c) :
    growOrbit c n (activeOrbit n i c hc) =
      activeOrbit n i (c + 1) (by omega) := by
  apply orbitIntoStable_injective (c + 1) n
  exact (orbitIntoStable_successor c n _).trans
    ((activeOrbit_spec n i c hc).trans (activeOrbit_spec n i (c + 1) (by omega)).symm)

/-- The actual native automorphism representative grows by the original growAut. -/
private theorem activeRepresentative_successor (n : ℕ) (i : StableOrbitIndex n) (c : ℕ)
    (hc : firstAppearance n i ≤ c) :
    growAut c n (orbitRepresentative c n (activeOrbit n i c hc)) =
      orbitRepresentative (c + 1) n (activeOrbit n i (c + 1) (by omega)) :=
  (orbitRepresentative_successor c n _).trans
    (congrArg (orbitRepresentative (c + 1) n) (activeOrbit_successor n i c hc))

/-- Available stable labels are the actual finite-stage orbit labels. -/
private def availableOrbitEquiv (c n : ℕ) :
    OrbitIndex c n ≃ {i : StableOrbitIndex n // firstAppearance n i ≤ c} where
  toFun j := ⟨orbitIntoStable c n j, firstAppearance_le n _ c ⟨j, rfl⟩⟩
  invFun i := activeOrbit n i.val c i.property
  left_inv j := activeOrbit_unique n _ c _ j rfl
  right_inv i := by
    apply Subtype.ext
    exact activeOrbit_spec n i.val c i.property

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

