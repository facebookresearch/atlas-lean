private theorem rightTensorPreservesFamily {C : Type uC} [Category.{vC} C]
    [MonoidalCategory C] [BraidedCategory C] [MonoidalClosed C] :
    ∀ Y : C, PreservesColimitsOfSize.{w, w} (tensorRight Y) :=
