def initialCellObject (X : C.{u, v}) : C.{u, v} :=
  originalInitialCellObjectFamily X

/-- The literal original small-object first factor, with its original initial source. -/
def initialCellInclusion (X : C.{u, v}) : Diagrams.zeroDiagram ⟶ initialCellObject X :=
  SmallObject.ιObj I realizedGeneratorCardinal (Diagrams.zeroTo X)

/-- The literal original small-object second factor, to the same caller endpoint. -/
