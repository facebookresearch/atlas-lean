namespace CategoryTheory.GammaFirstSpanAlgebra

variable {C : Type u} [Category.{v} C] [MonoidalCategory C]

/-- Both original free-pair comparisons remain in the enlarged first-source span. -/
private def span {M S A Q Y : C} (e : M ≅ S ⊗ A) (j : S ⊗ S ≅ Q)
    (f : A ⟶ S ⊗ Y) : M ⟶ Q ⊗ Y :=
  e.hom ≫ S ◁ f ≫ (α_ S S Y).inv ≫ j.hom ▷ Y

/-- The entire first sphere face reduces the first original sphere factor. -/
private def leftFace {S Q : C} (j : S ⊗ S ≅ Q) (γ : S ⟶ 𝟙_ C) : Q ⟶ S :=
  j.inv ≫ γ ▷ S ≫ (λ_ S).hom

/-- The second sphere face reduces the second original sphere factor. -/
private def rightFace {S Q : C} (j : S ⊗ S ≅ Q) (γ : S ⟶ 𝟙_ C) : Q ⟶ S :=
  j.inv ≫ S ◁ γ ≫ (ρ_ S).hom

/-- The first original source reduction retains its full pair inverse and original unitor. -/
private def mixedLeft {M S A : C} (e : M ≅ S ⊗ A) (γ : S ⟶ 𝟙_ C) : M ⟶ A :=
  e.hom ≫ γ ▷ A ≫ (λ_ A).hom

/-- The same original Gamma reduction on every arbitrary target factor. -/
private def reduction {S Y : C} (γ : S ⟶ 𝟙_ C) : S ⊗ Y ⟶ Y :=
  γ ▷ Y ≫ (λ_ Y).hom

/-- Postcompose the same whole first-source span without changing either pair comparison. -/
private theorem span_postface {M S A Q Y : C} (e : M ≅ S ⊗ A) (j : S ⊗ S ≅ Q)
    (f : A ⟶ S ⊗ Y) (h : Q ⟶ S) :
    span e j f ≫ h ▷ Y =
      e.hom ≫ S ◁ f ≫ (α_ S S Y).inv ≫ (j.hom ≫ h) ▷ Y := by
  rw [span, Category.assoc, Category.assoc, Category.assoc, ← comp_whiskerRight]

/-- The original associator carries the first sphere reduction to the same full unitor. -/
private theorem left_reduction_associator {S Y : C} (γ : S ⟶ 𝟙_ C) :
    (α_ S S Y).inv ≫ ((γ ▷ S) ▷ Y) ≫ ((λ_ S).hom ▷ Y) =
      (γ ▷ (S ⊗ Y)) ≫ (λ_ (S ⊗ Y)).hom := by
  rw [← Category.assoc, ← associator_inv_naturality_left, Category.assoc,
    leftUnitor_whiskerRight]
  simp only [Iso.inv_hom_id_assoc]

/-- The same original associator carries the second reduction to the target Gamma map. -/
private theorem right_reduction_associator {S Y : C} (γ : S ⟶ 𝟙_ C) :
    (α_ S S Y).inv ≫ ((S ◁ γ) ▷ Y) ≫ ((ρ_ S).hom ▷ Y) =
      S ◁ reduction (Y := Y) γ := by
  rw [← Category.assoc, ← associator_inv_naturality_middle, Category.assoc, ← triangle]
  simp only [Iso.inv_hom_id_assoc, reduction, whiskerLeft_comp]

/-- The first actual sphere-face endpoint is the original left free-source advance. -/
private theorem span_left {M S A Q Y : C} (e : M ≅ S ⊗ A) (j : S ⊗ S ≅ Q)
    (γ : S ⟶ 𝟙_ C) (f : A ⟶ S ⊗ Y) :
    span e j f ≫ leftFace j γ ▷ Y = mixedLeft e γ ≫ f := by
  rw [span_postface]
  have hj : j.hom ≫ leftFace j γ = γ ▷ S ≫ (λ_ S).hom := by
    simp only [leftFace, Iso.hom_inv_id_assoc]
  rw [hj, comp_whiskerRight]
  rw [left_reduction_associator, ← Category.assoc (S ◁ f), whisker_exchange,
    Category.assoc, leftUnitor_naturality]
  simp only [mixedLeft, Category.assoc]

/-- The second actual sphere-face endpoint retains the exact original Gamma target composite. -/
private theorem span_right {M S A Q Y : C} (e : M ≅ S ⊗ A) (j : S ⊗ S ≅ Q)
    (γ : S ⟶ 𝟙_ C) (f : A ⟶ S ⊗ Y) :
    span e j f ≫ rightFace j γ ▷ Y = e.hom ≫ S ◁ (f ≫ reduction γ) := by
  rw [span_postface]
  have hj : j.hom ≫ rightFace j γ = S ◁ γ ≫ (ρ_ S).hom := by
    simp only [rightFace, Iso.hom_inv_id_assoc]
  rw [hj, comp_whiskerRight]
  rw [right_reduction_associator, ← whiskerLeft_comp]







end CategoryTheory.GammaFirstSpanAlgebra

