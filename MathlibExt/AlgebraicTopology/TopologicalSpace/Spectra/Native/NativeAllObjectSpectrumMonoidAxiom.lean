/-- Every original finite group coprojection is retained by the full inverse comparison. -/
@[reassoc]
private theorem finiteIntegerCoproductIso_inv_leg [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (i : α) :
    Sigma.ι (fun j => (integerStablePiCommFunctor q).obj (X j)) i ≫
      (finiteIntegerCoproductIso (B := B) q X).inv = (integerStablePiCommFunctor q).map (Sigma.ι X i) :=
  ι_comp_sigmaComparison (integerStablePiCommFunctor q) X i

/-- The finite comparison is natural in every actual family of original spectrum arrows. -/
@[reassoc]
private theorem finiteIntegerCoproductIso_hom_naturality
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α]
    {X Y : α → PointedCGWH.SequentialSpectrum.{u, v}} (f : ∀ i, X i ⟶ Y i) :
    (integerStablePiCommFunctor q).map (Limits.Sigma.map f) ≫ (finiteIntegerCoproductIso q Y).hom =
      (finiteIntegerCoproductIso q X).hom ≫
        Limits.Sigma.map (fun i => (integerStablePiCommFunctor q).map (f i)) := by
  have h : (finiteIntegerCoproductIso q X).inv ≫
      (integerStablePiCommFunctor q).map (Limits.Sigma.map f) =
      Limits.Sigma.map (fun i => (integerStablePiCommFunctor q).map (f i)) ≫
        (finiteIntegerCoproductIso q Y).inv := by
    apply Sigma.hom_ext
    intro i
    rw [finiteIntegerCoproductIso_inv_leg_assoc, Sigma.ι_map_assoc,
      finiteIntegerCoproductIso_inv_leg, ← (integerStablePiCommFunctor q).map_comp,
      ← (integerStablePiCommFunctor q).map_comp]
    exact (integerStablePiCommFunctor q).congr_map (Sigma.ι_map f i)
  apply (cancel_epi (finiteIntegerCoproductIso q X).inv).mp
  rw [← Category.assoc, h]
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]

/-- The full inverse comparison is natural in every actual family of original spectrum arrows. -/
@[reassoc]
private theorem finiteIntegerCoproductIso_inv_naturality
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α]
    {X Y : α → PointedCGWH.SequentialSpectrum.{u, v}} (f : ∀ i, X i ⟶ Y i) :
    Limits.Sigma.map (fun i => (integerStablePiCommFunctor q).map (f i)) ≫
        (finiteIntegerCoproductIso q Y).inv =
      (finiteIntegerCoproductIso q X).inv ≫ (integerStablePiCommFunctor q).map (Limits.Sigma.map f) := by
  apply Sigma.hom_ext
  intro i
  rw [Sigma.ι_map_assoc, finiteIntegerCoproductIso_inv_leg,
    finiteIntegerCoproductIso_inv_leg_assoc, ← (integerStablePiCommFunctor q).map_comp,
    ← (integerStablePiCommFunctor q).map_comp]
  exact (integerStablePiCommFunctor q).congr_map (Sigma.ι_map f i).symm

/-- Finite copowers of one actual source use the same full finite comparison. -/
private abbrev finiteIntegerCopowerIso [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (α : Type w) [Finite α] (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiCommFunctor q).obj (∐ fun _ : α => X) ≅
      ∐ fun _ : α => (integerStablePiCommFunctor q).obj X :=
  finiteIntegerCoproductIso q (fun _ : α => X)

/-- The finite inverse is natural in arbitrary index functions and every original coefficient arrow. -/
@[reassoc]
private theorem finiteIntegerCoproductIso_inv_map'_naturality
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} {β : Type w'} [Finite α] [Finite β]
    {X : α → PointedCGWH.SequentialSpectrum.{u, v}} {Y : β → PointedCGWH.SequentialSpectrum.{u, v}}
    (p : α → β) (f : ∀ i, X i ⟶ Y (p i)) :
    Limits.Sigma.map' p (fun i => (integerStablePiCommFunctor q).map (f i)) ≫
        (finiteIntegerCoproductIso q Y).inv =
      (finiteIntegerCoproductIso q X).inv ≫ (integerStablePiCommFunctor q).map (Limits.Sigma.map' p f) := by
  apply Sigma.hom_ext
  intro i
  rw [Sigma.ι_comp_map'_assoc, finiteIntegerCoproductIso_inv_leg,
    finiteIntegerCoproductIso_inv_leg_assoc, ← (integerStablePiCommFunctor q).map_comp,
    ← (integerStablePiCommFunctor q).map_comp]
  exact (integerStablePiCommFunctor q).congr_map (Sigma.ι_comp_map' p f i).symm

/-- The finite forward map is natural in arbitrary index functions and original coefficient arrows. -/
@[reassoc]
private theorem finiteIntegerCoproductIso_hom_map'_naturality
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} {β : Type w'} [Finite α] [Finite β]
    {X : α → PointedCGWH.SequentialSpectrum.{u, v}} {Y : β → PointedCGWH.SequentialSpectrum.{u, v}}
    (p : α → β) (f : ∀ i, X i ⟶ Y (p i)) :
    (integerStablePiCommFunctor q).map (Limits.Sigma.map' p f) ≫ (finiteIntegerCoproductIso q Y).hom =
      (finiteIntegerCoproductIso q X).hom ≫
        Limits.Sigma.map' p (fun i => (integerStablePiCommFunctor q).map (f i)) := by
  apply (cancel_epi (finiteIntegerCoproductIso q X).inv).mp
  rw [← Category.assoc, ← finiteIntegerCoproductIso_inv_map'_naturality]
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]

/-- Every finite spectrum coproduct has its actual projection onto any chosen summand. -/
private def finiteProjection {α : Type w} [Finite α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (i : α) : ∐ X ⟶ X i := by
  classical
  exact Sigma.desc (fun j => if h : j = i then eqToHom (congrArg X h) else 0)

/-- The projection retains the identity on its own entire actual original summand. -/
@[reassoc (attr := simp)]
private theorem finiteProjection_ι_self {α : Type w} [Finite α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (i : α) :
    Sigma.ι X i ≫ finiteProjection X i = 𝟙 (X i) := by
  classical
  simp [finiteProjection]

/-- Every other entire original summand is sent by the actual zero coefficient map. -/
@[reassoc (attr := simp)]
private theorem finiteProjection_ι_ne {α : Type w} [Finite α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (i j : α) (h : j ≠ i) :
    Sigma.ι X j ≫ finiteProjection X i = 0 := by
  classical
  simp [finiteProjection, h]

/-- The original finite projections are natural in all actual coefficient arrows. -/
@[reassoc]
private theorem finiteProjection_naturality {α : Type w} [Finite α]
    {X Y : α → PointedCGWH.SequentialSpectrum.{u, v}} (f : ∀ i, X i ⟶ Y i) (i : α) :
    Limits.Sigma.map f ≫ finiteProjection Y i = finiteProjection X i ≫ f i := by
  classical
  apply Sigma.hom_ext
  intro j
  by_cases h : j = i
  · subst j
    simp only [Sigma.ι_map_assoc, finiteProjection_ι_self, Category.comp_id,
      finiteProjection_ι_self_assoc]
  · simp only [Sigma.ι_map_assoc, finiteProjection_ι_ne Y i j h, comp_zero,
      finiteProjection_ι_ne_assoc X i j h, zero_comp]

/-- The product-coordinate hom applies every actual original finite projection. -/
private def finiteIntegerProjection (q : ℤ) {α : Type w} [Finite α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (∐ X) →* ∀ i, (integerStablePiFunctor q).obj (X i) :=
  MonoidHom.pi (fun i => ((integerStablePiFunctor q).map (finiteProjection X i)).hom)

/-- The product-coordinate inverse multiplies every actual original finite inclusion image. -/
private def finiteIntegerInclusion (q : ℤ) {α : Type w} [Finite α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) :
    (∀ i, (integerStablePiFunctor q).obj (X i)) →* (integerStablePiFunctor q).obj (∐ X) := by
  classical
  let _ := Fintype.ofFinite α
  exact
    { toFun := fun a => ∏ i, ((integerStablePiFunctor q).map (Sigma.ι X i)).hom (a i)
      map_one' := by simp
      map_mul' := fun a b => by simp only [Pi.mul_apply, map_mul, Finset.prod_mul_distrib] }

open Classical in
/-- Each original finite summand maps to its genuine single product coordinate. -/
private theorem finiteIntegerProjection_leg [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (i : α) (a : (integerStablePiFunctor q).obj (X i)) :
    finiteIntegerProjection q X (((integerStablePiFunctor q).map (Sigma.ι X i)).hom a) =
      Pi.mulSingle i a := by
  classical
  funext j
  change ((integerStablePiFunctor q).map (finiteProjection X j)).hom
    (((integerStablePiFunctor q).map (Sigma.ι X i)).hom a) =
      Pi.mulSingle (M := fun k => (integerStablePiFunctor q).obj (X k)) i a j
  rw [integerPi_map_map]
  by_cases h : i = j
  · subst j
    rw [finiteProjection_ι_self, (integerStablePiFunctor q).map_id]
    exact (Pi.mulSingle_eq_same (M := fun k => (integerStablePiFunctor q).obj (X k)) i a).symm
  · rw [finiteProjection_ι_ne X j i h, integerPi_map_zero]
    exact (Pi.mulSingle_eq_of_ne (M := fun k => (integerStablePiFunctor q).obj (X k)) (Ne.symm h) a).symm

open Classical in
/-- A single coordinate returns by its full original spectrum coprojection. -/
private theorem finiteIntegerInclusion_single (q : ℤ) {α : Type w} [Finite α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (i : α)
    (a : (integerStablePiFunctor q).obj (X i)) :
    finiteIntegerInclusion q X (Pi.mulSingle i a) =
      ((integerStablePiFunctor q).map (Sigma.ι X i)).hom a := by
  classical
  let _ := Fintype.ofFinite α
  change (∏ j, ((integerStablePiFunctor q).map (Sigma.ι X j)).hom
    (Pi.mulSingle (M := fun k => (integerStablePiFunctor q).obj (X k)) i a j)) = _
  rw [Finset.prod_eq_single i]
  · simp only [Pi.mulSingle_eq_same]
  · intro j _ hji
    rw [Pi.mulSingle_eq_of_ne hji]
    exact map_one _
  · intro hi
    exact False.elim (hi (Finset.mem_univ i))

/-- Every actual finite projection splits the product of all original summand images. -/
private theorem finiteIntegerProjection_inclusion
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (a : ∀ i, (integerStablePiFunctor q).obj (X i)) :
    finiteIntegerProjection q X (finiteIntegerInclusion q X a) = a := by
  classical
  let _ := Fintype.ofFinite α
  funext i
  change ((integerStablePiFunctor q).map (finiteProjection X i)).hom
    (∏ j, ((integerStablePiFunctor q).map (Sigma.ι X j)).hom (a j)) = a i
  rw [map_prod, Finset.prod_eq_single i]
  · rw [integerPi_map_map, finiteProjection_ι_self, (integerStablePiFunctor q).map_id]
    rfl
  · intro j _ hji
    rw [integerPi_map_map, finiteProjection_ι_ne X i j hji, integerPi_map_zero]
  · intro hi
    exact False.elim (hi (Finset.mem_univ i))

/-- Genuine finite cofan preservation proves decomposition of every original stable class. -/
private theorem finiteIntegerInclusion_projection
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (x : (integerStablePiFunctor q).obj (∐ X)) :
    finiteIntegerInclusion q X (finiteIntegerProjection q X x) = x := by
  let m : (integerStablePiCommFunctor q).obj (∐ X) ⟶ (integerStablePiCommFunctor q).obj (∐ X) :=
    CommGrpCat.ofHom ((finiteIntegerInclusion q X).comp (finiteIntegerProjection q X))
  have hm : m = 𝟙 _ := by
    apply (isColimitOfHasCoproductOfPreservesColimit (integerStablePiCommFunctor q) X).hom_ext
    intro ⟨i⟩
    apply CommGrpCat.ext
    intro a
    change finiteIntegerInclusion q X
      (finiteIntegerProjection q X (((integerStablePiFunctor q).map (Sigma.ι X i)).hom a)) =
      ((integerStablePiFunctor q).map (Sigma.ι X i)).hom a
    exact (congrArg (finiteIntegerInclusion q X) (finiteIntegerProjection_leg q X i a)).trans
      (finiteIntegerInclusion_single q X i a)
  exact ConcreteCategory.congr_hom hm x

/-- All integer groups of actual finite spectrum coproducts have the proved product comparison. -/
private def finiteIntegerPiMulEquiv [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (∐ X) ≃* ∀ i, (integerStablePiFunctor q).obj (X i) where
  toFun := finiteIntegerProjection q X
  invFun := finiteIntegerInclusion q X
  left_inv := finiteIntegerInclusion_projection q X
  right_inv := finiteIntegerProjection_inclusion q X
  map_mul' := (finiteIntegerProjection q X).map_mul

/-- Every forward product coordinate is the actual original spectrum projection map. -/
private theorem finiteIntegerPiMulEquiv_apply [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (x : (integerStablePiFunctor q).obj (∐ X)) (i : α) :
    finiteIntegerPiMulEquiv (B := B) q X x i =
      ((integerStablePiFunctor q).map (finiteProjection X i)).hom x := rfl

/-- The complete inverse keeps the product of all actual original coprojection images. -/
private theorem finiteIntegerPiMulEquiv_symm_apply [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (a : ∀ i, (integerStablePiFunctor q).obj (X i)) :
    (finiteIntegerPiMulEquiv (B := B) q X).symm a = finiteIntegerInclusion q X a := rfl

open Classical in
/-- The full original integer projection comparison retains every finite coprojection value. -/
private theorem finiteIntegerPiMulEquiv_leg [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (i : α) (a : (integerStablePiFunctor q).obj (X i)) :
    finiteIntegerPiMulEquiv q X (((integerStablePiFunctor q).map (Sigma.ι X i)).hom a) =
      Pi.mulSingle i a := finiteIntegerProjection_leg q X i a

open Classical in
/-- The full original integer product inverse retains every finite single-coordinate value. -/
private theorem finiteIntegerPiMulEquiv_symm_single [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v})
    (i : α) (a : (integerStablePiFunctor q).obj (X i)) :
    (finiteIntegerPiMulEquiv (B := B) q X).symm (Pi.mulSingle i a) =
      ((integerStablePiFunctor q).map (Sigma.ι X i)).hom a := finiteIntegerInclusion_single q X i a

/-- All forward finite product coordinates commute with every actual spectrum coefficient map. -/
private theorem finiteIntegerPiMulEquiv_naturality
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α]
    {X Y : α → PointedCGWH.SequentialSpectrum.{u, v}} (f : ∀ i, X i ⟶ Y i)
    (x : (integerStablePiFunctor q).obj (∐ X)) :
    finiteIntegerPiMulEquiv q Y (((integerStablePiFunctor q).map (Limits.Sigma.map f)).hom x) =
      fun i => ((integerStablePiFunctor q).map (f i)).hom (finiteIntegerPiMulEquiv q X x i) := by
  funext i
  change ((integerStablePiFunctor q).map (finiteProjection Y i)).hom
      (((integerStablePiFunctor q).map (Limits.Sigma.map f)).hom x) =
    ((integerStablePiFunctor q).map (f i)).hom
      (((integerStablePiFunctor q).map (finiteProjection X i)).hom x)
  rw [integerPi_map_map, integerPi_map_map]
  exact congrArg (fun k => ((integerStablePiFunctor q).map k).hom x) (finiteProjection_naturality f i)

/-- The full finite product inverse is natural in every actual coefficient map. -/
private theorem finiteIntegerPiMulEquiv_symm_naturality
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α]
    {X Y : α → PointedCGWH.SequentialSpectrum.{u, v}} (f : ∀ i, X i ⟶ Y i)
    (a : ∀ i, (integerStablePiFunctor q).obj (X i)) :
    ((integerStablePiFunctor q).map (Limits.Sigma.map f)).hom ((finiteIntegerPiMulEquiv q X).symm a) =
      (finiteIntegerPiMulEquiv q Y).symm (fun i => ((integerStablePiFunctor q).map (f i)).hom (a i)) := by
  apply (finiteIntegerPiMulEquiv q Y).injective
  rw [finiteIntegerPiMulEquiv_naturality, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]

/-- The empty finite source cofan has the actual trivial original integer group in every degree. -/
private theorem finiteIntegerPi_empty_trivial [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] [IsEmpty α]
    (X : α → PointedCGWH.SequentialSpectrum.{u, v}) (x : (integerStablePiFunctor q).obj (∐ X)) :
    x = 1 := by
  apply (finiteIntegerPiMulEquiv q X).injective
  funext i
  exact isEmptyElim i

/-- The genuine finite comparison is also an Iso of the unchanged original GrpCat object. -/
private def finiteIntegerGroupIso [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) {α : Type w} [Finite α] (X : α → PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (∐ X) ≅
      GrpCat.of (Shrink.{v} (∀ i, (integerStablePiFunctor q).obj (X i))) := by
  let e : Shrink.{v} (∀ i, (integerStablePiFunctor q).obj (X i)) ≃*
      (∀ i, (integerStablePiFunctor q).obj (X i)) := Shrink.mulEquiv
  exact ((finiteIntegerPiMulEquiv q X).trans e.symm).toGrpIso

end PointedCGWH.Spectra.OriginalSequentialFiniteCopowerIntegerPi
end

