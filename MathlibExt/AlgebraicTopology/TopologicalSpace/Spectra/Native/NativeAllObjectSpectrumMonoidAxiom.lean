open scoped CGWH.limits







/-!
## Original sphere scalar cancellation in every integer degree

The input is an arbitrary original sequential spectrum. Each successor uses the
original scalar associator and the same original integer suspension isomorphism.
The original sphere-sequence coefficient is transported by its original tensor
power comparison, with both complete arrows and naturality retained.
-/

set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory MonoidalCategory Limits
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open PointedCGWH.SequentialSpectrum.StableHomotopy.SuspensionStablePiGeometry
open CategoryTheory.MonoidalCategory.TensorPower

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The original scalar of the actual tensor power, on every unchanged original spectrum. -/
private abbrev spherePowerScalarFunctor (n : ℕ) :
    PointedCGWH.SequentialSpectrum.{u, v} ⥤ PointedCGWH.SequentialSpectrum.{u, v} :=
  EnrichedFunctorCat.tensorLeft (tensorPowObj PointedCGWH.sphereOne.{u, v} n)

/-- The actual original scalar unit is natural on every original sequential spectrum. -/
private def originalSequentialScalarUnitNatIso :
    EnrichedFunctorCat.tensorLeft (𝟙_ PointedCGWH.{u, v}) ≅ 𝟭 PointedCGWH.SequentialSpectrum.{u, v} :=
  NatIso.ofComponents EnrichedFunctorCat.scalarUnitIso
    (fun f => EnrichedFunctorCat.scalarUnitIso_naturality f)

/-- Every whole unit component is the original scalar unit hom. -/
private theorem originalSequentialScalarUnitNatIso_hom_app (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    originalSequentialScalarUnitNatIso.hom.app X = (EnrichedFunctorCat.scalarUnitIso X).hom := rfl

/-- Every whole inverse component is the same original scalar unit inverse. -/
private theorem originalSequentialScalarUnitNatIso_inv_app (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    originalSequentialScalarUnitNatIso.inv.app X = (EnrichedFunctorCat.scalarUnitIso X).inv := rfl

private def scalarAssociatorNatIso (M N : PointedCGWH.{u, v}) :
    EnrichedFunctorCat.tensorLeft (A := PointedCGWH.Spectra.Sequential.Index.{u, v}) (M ⊗ N) ≅
      EnrichedFunctorCat.tensorLeft N ⋙ EnrichedFunctorCat.tensorLeft M :=
  NatIso.ofComponents (EnrichedFunctorCat.scalarAssociatorIso M N)
    (fun f => EnrichedFunctorCat.scalarAssociatorIso_naturality M N f)

/-- The actual successor tensor power uses the original scalar associator on the unchanged input. -/
private def spherePowerScalarStepNatIso (n : ℕ) :
    spherePowerScalarFunctor.{u, v} (n + 1) ≅
      EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne ⋙ spherePowerScalarFunctor n :=
  scalarAssociatorNatIso (tensorPowObj PointedCGWH.sphereOne n) PointedCGWH.sphereOne

/-- The whole successor hom is the actual original scalar associator. -/
private theorem spherePowerScalarStepNatIso_hom_app (n : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (spherePowerScalarStepNatIso n).hom.app X =
      (EnrichedFunctorCat.scalarAssociatorIso
        (tensorPowObj PointedCGWH.sphereOne n) PointedCGWH.sphereOne X).hom := rfl

/-- The whole successor inverse is the same original scalar associator inverse. -/
private theorem spherePowerScalarStepNatIso_inv_app (n : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (spherePowerScalarStepNatIso n).inv.app X =
      (EnrichedFunctorCat.scalarAssociatorIso
        (tensorPowObj PointedCGWH.sphereOne n) PointedCGWH.sphereOne X).inv := rfl

/-- Every integer degree cancels the actual original sphere tensor power, naturally in its input. -/
private def spherePowerIntegerCancellationNatIso : ∀ (n : ℕ) (q : ℤ),
    spherePowerScalarFunctor.{u, v} n ⋙ integerStablePiFunctor (q + (n : ℤ)) ≅
      integerStablePiFunctor q :=
  Nat.rec (motive := fun n => ∀ q : ℤ,
    spherePowerScalarFunctor.{u, v} n ⋙ integerStablePiFunctor (q + (n : ℤ)) ≅
      integerStablePiFunctor q)
  (fun q =>
    Functor.isoWhiskerLeft (spherePowerScalarFunctor 0)
      (eqToIso (congrArg integerStablePiFunctor (show q + (0 : ℤ) = q by omega))) ≪≫
    Functor.isoWhiskerRight originalSequentialScalarUnitNatIso (integerStablePiFunctor q) ≪≫
      Functor.leftUnitor (integerStablePiFunctor q))
  (fun n previous q =>
    Functor.isoWhiskerLeft (spherePowerScalarFunctor (n + 1))
      (eqToIso (congrArg integerStablePiFunctor
        (show q + ((n + 1 : ℕ) : ℤ) = (q + 1) + (n : ℤ) by omega))) ≪≫
    Functor.isoWhiskerRight (spherePowerScalarStepNatIso n)
      (integerStablePiFunctor ((q + 1) + (n : ℤ))) ≪≫
    Functor.associator (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
      (spherePowerScalarFunctor n) (integerStablePiFunctor ((q + 1) + (n : ℤ))) ≪≫
    Functor.isoWhiskerLeft (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
      (previous (q + 1)) ≪≫
        (integerSuspensionPiNatIso q).symm)

/-- The entire zero comparison uses the original scalar unit and original integer cast. -/
private theorem spherePowerIntegerCancellationNatIso_zero (q : ℤ) :
    spherePowerIntegerCancellationNatIso.{u, v} 0 q =
      Functor.isoWhiskerLeft (spherePowerScalarFunctor 0)
        (eqToIso (congrArg integerStablePiFunctor (show q + (0 : ℤ) = q by omega))) ≪≫
      Functor.isoWhiskerRight originalSequentialScalarUnitNatIso (integerStablePiFunctor q) ≪≫
        Functor.leftUnitor (integerStablePiFunctor q) := rfl

/-- The full zero hom retains the original unit arrow in every original input component. -/
private theorem spherePowerIntegerCancellationNatIso_zero_hom (q : ℤ) :
    (spherePowerIntegerCancellationNatIso.{u, v} 0 q).hom =
      (Functor.isoWhiskerLeft (spherePowerScalarFunctor 0)
        (eqToIso (congrArg integerStablePiFunctor (show q + (0 : ℤ) = q by omega)))).hom ≫
      (Functor.isoWhiskerRight originalSequentialScalarUnitNatIso (integerStablePiFunctor q)).hom ≫
        (Functor.leftUnitor (integerStablePiFunctor q)).hom := rfl

/-- The full zero inverse retains the same original inverse unit and degree arrows. -/
private theorem spherePowerIntegerCancellationNatIso_zero_inv (q : ℤ) :
    (spherePowerIntegerCancellationNatIso.{u, v} 0 q).inv =
      (Functor.leftUnitor (integerStablePiFunctor q)).inv ≫
      (Functor.isoWhiskerRight originalSequentialScalarUnitNatIso (integerStablePiFunctor q)).inv ≫
      (Functor.isoWhiskerLeft (spherePowerScalarFunctor 0)
        (eqToIso (congrArg integerStablePiFunctor (show q + (0 : ℤ) = q by omega)))).inv := by
  rw [spherePowerIntegerCancellationNatIso_zero]
  exact Category.assoc _ _ _

/-- The entire successor comparison uses the original associator and original suspension Iso. -/
private theorem spherePowerIntegerCancellationNatIso_succ (n : ℕ) (q : ℤ) :
    spherePowerIntegerCancellationNatIso.{u, v} (n + 1) q =
      Functor.isoWhiskerLeft (spherePowerScalarFunctor (n + 1))
        (eqToIso (congrArg integerStablePiFunctor
          (show q + ((n + 1 : ℕ) : ℤ) = (q + 1) + (n : ℤ) by omega))) ≪≫
      Functor.isoWhiskerRight (spherePowerScalarStepNatIso n)
        (integerStablePiFunctor ((q + 1) + (n : ℤ))) ≪≫
      Functor.associator (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
        (spherePowerScalarFunctor n) (integerStablePiFunctor ((q + 1) + (n : ℤ))) ≪≫
      Functor.isoWhiskerLeft (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
        (spherePowerIntegerCancellationNatIso n (q + 1)) ≪≫
          (integerSuspensionPiNatIso q).symm := rfl

/-- Every complete successor hom retains the same original suspension inverse transformation. -/
private theorem spherePowerIntegerCancellationNatIso_succ_hom (n : ℕ) (q : ℤ) :
    (spherePowerIntegerCancellationNatIso.{u, v} (n + 1) q).hom =
      (Functor.isoWhiskerLeft (spherePowerScalarFunctor (n + 1))
        (eqToIso (congrArg integerStablePiFunctor
          (show q + ((n + 1 : ℕ) : ℤ) = (q + 1) + (n : ℤ) by omega)))).hom ≫
      (Functor.isoWhiskerRight (spherePowerScalarStepNatIso n)
        (integerStablePiFunctor ((q + 1) + (n : ℤ)))).hom ≫
      (Functor.associator (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
        (spherePowerScalarFunctor n) (integerStablePiFunctor ((q + 1) + (n : ℤ)))).hom ≫
      (Functor.isoWhiskerLeft (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
        (spherePowerIntegerCancellationNatIso n (q + 1))).hom ≫
          (integerSuspensionPiNatIso q).inv := rfl

/-- Every complete successor inverse retains the same original suspension hom transformation. -/
private theorem spherePowerIntegerCancellationNatIso_succ_inv (n : ℕ) (q : ℤ) :
    (spherePowerIntegerCancellationNatIso.{u, v} (n + 1) q).inv =
      (integerSuspensionPiNatIso q).hom ≫
      (Functor.isoWhiskerLeft (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
        (spherePowerIntegerCancellationNatIso n (q + 1))).inv ≫
      (Functor.associator (EnrichedFunctorCat.tensorLeft PointedCGWH.sphereOne)
        (spherePowerScalarFunctor n) (integerStablePiFunctor ((q + 1) + (n : ℤ)))).inv ≫
      (Functor.isoWhiskerRight (spherePowerScalarStepNatIso n)
        (integerStablePiFunctor ((q + 1) + (n : ℤ)))).inv ≫
      (Functor.isoWhiskerLeft (spherePowerScalarFunctor (n + 1))
        (eqToIso (congrArg integerStablePiFunctor
          (show q + ((n + 1 : ℕ) : ℤ) = (q + 1) + (n : ℤ) by omega)))).inv := by
  rw [spherePowerIntegerCancellationNatIso_succ]
  simp only [Iso.trans_inv, Iso.symm_inv, Category.assoc]

/-- The sphere-sequence coefficient is transported by its same original coefficient power Iso. -/
private def originalSphereScalarPowerNatIso (n : ℕ) :
    EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.{u, v}.functor.obj
      (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) ≅ spherePowerScalarFunctor n :=
  (EnrichedFunctorCat.tensorBifunctor
    (V := PointedCGWH.{u, v}) (A := PointedCGWH.Spectra.Sequential.Index.{u, v})).mapIso
      (freeSphereCoefficientPowerIso n)

/-- The whole coefficient transport hom is the original scalar map of the coefficient power hom. -/
private theorem originalSphereScalarPowerNatIso_hom_app (n : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (originalSphereScalarPowerNatIso n).hom.app X =
      EnrichedFunctorCat.scalarTensorMap (freeSphereCoefficientPowerIso n).hom X := rfl

/-- The whole coefficient transport inverse keeps the original coefficient power inverse. -/
private theorem originalSphereScalarPowerNatIso_inv_app (n : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (originalSphereScalarPowerNatIso n).inv.app X =
      EnrichedFunctorCat.scalarTensorMap (freeSphereCoefficientPowerIso n).inv X := rfl

/-- The original sphere scalar cancels in every original integer degree on an arbitrary original input. -/
private def originalSphereScalarIntegerCancellationNatIso (n : ℕ) (q : ℤ) :
    EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.{u, v}.functor.obj
        (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) ⋙
      integerStablePiFunctor (q + (n : ℤ)) ≅ integerStablePiFunctor q :=
  Functor.isoWhiskerRight (originalSphereScalarPowerNatIso n)
    (integerStablePiFunctor (q + (n : ℤ))) ≪≫ spherePowerIntegerCancellationNatIso n q

/-- The complete original forward arrow retains coefficient transport and tensor-power cancellation. -/
private theorem originalSphereScalarIntegerCancellationNatIso_hom_app (n : ℕ) (q : ℤ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (originalSphereScalarIntegerCancellationNatIso n q).hom.app X =
      (integerStablePiFunctor (q + (n : ℤ))).map
        (EnrichedFunctorCat.scalarTensorMap (freeSphereCoefficientPowerIso n).hom X) ≫
      (spherePowerIntegerCancellationNatIso n q).hom.app X := rfl

/-- The complete original inverse arrow retains cancellation and the original coefficient inverse. -/
private theorem originalSphereScalarIntegerCancellationNatIso_inv_app (n : ℕ) (q : ℤ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (originalSphereScalarIntegerCancellationNatIso n q).inv.app X =
      (spherePowerIntegerCancellationNatIso n q).inv.app X ≫
      (integerStablePiFunctor (q + (n : ℤ))).map
        (EnrichedFunctorCat.scalarTensorMap (freeSphereCoefficientPowerIso n).inv X) := rfl

/-- Every original sequential input arrow retains the whole forward cancellation square. -/
private theorem originalSphereScalarIntegerCancellationNatIso_hom_naturality (n : ℕ) (q : ℤ)
    {X Y : PointedCGWH.SequentialSpectrum.{u, v}} (f : X ⟶ Y) :
    (integerStablePiFunctor (q + (n : ℤ))).map
        ((EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj
          (CategoryTheory.Operad.SmallFinBijGroupoid.card n))).map f) ≫
      (originalSphereScalarIntegerCancellationNatIso n q).hom.app Y =
    (originalSphereScalarIntegerCancellationNatIso n q).hom.app X ≫
      (integerStablePiFunctor q).map f :=
  (originalSphereScalarIntegerCancellationNatIso n q).hom.naturality f

/-- Every original sequential input arrow retains the same complete inverse cancellation square. -/
private theorem originalSphereScalarIntegerCancellationNatIso_inv_naturality (n : ℕ) (q : ℤ)
    {X Y : PointedCGWH.SequentialSpectrum.{u, v}} (f : X ⟶ Y) :
    (integerStablePiFunctor q).map f ≫
      (originalSphereScalarIntegerCancellationNatIso n q).inv.app Y =
    (originalSphereScalarIntegerCancellationNatIso n q).inv.app X ≫
      (integerStablePiFunctor (q + (n : ℤ))).map
        ((EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj
          (CategoryTheory.Operad.SmallFinBijGroupoid.card n))).map f) :=
  (originalSphereScalarIntegerCancellationNatIso n q).inv.naturality f

/-- Every arbitrary original input has the same original sphere scalar cancellation in every degree. -/
private def originalSphereScalarIntegerCancellationIso (n : ℕ) (q : ℤ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor (q + (n : ℤ))).obj
        ((EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj
          (CategoryTheory.Operad.SmallFinBijGroupoid.card n))).obj X) ≅
      (integerStablePiFunctor q).obj X :=
  (originalSphereScalarIntegerCancellationNatIso n q).app X

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
