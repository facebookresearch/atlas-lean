/-- Conditional pointwise free-unit transfer at EVERY actual original orthogonal operator.
The literal original free/scalar balanced-smash Arrow Iso keeps both arbitrary endpoints;
only the given free-unit arrow's weakness is an input. -/
private theorem originalFreeBoundary_endpointTests (a : OrthogonalOperatorIndex.{u, v})
    {K M : PointedCGWH.{u, v}} (i : K ⟶ M) (hi : PointedCGWH.realizedBoundaryInclusions i)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    W (Free.object a K ◁ f) ∧ W (Free.object a M ◁ f) := by
  have hScalar := PointedCGWH.Spectra.OriginalNativeFiniteScalar.orthogonalBoundaryFamily_omegaTests
    (B := B) i hi (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) hUnit
  exact ⟨(W.arrow_mk_iso_iff (originalFreeUnitScalarArrowIso a K f)).mpr hScalar.1,
    (W.arrow_mk_iso_iff (originalFreeUnitScalarArrowIso a M f)).mpr hScalar.2⟩

/-- Both original orthogonal endpoint tests accompany the SAME actual Free.coefficientMap
and its full literal balanced-smash square, at arbitrary original X and Y. -/
private theorem originalFreeBoundary_endpointSquare (a : OrthogonalOperatorIndex.{u, v})
    {K M : PointedCGWH.{u, v}} (i : K ⟶ M) (hi : PointedCGWH.realizedBoundaryInclusions i)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    (W (Free.object a K ◁ f) ∧ W (Free.object a M ◁ f)) ∧
      (Free.object a K ◁ f) ≫ (Free.coefficientMap a i ▷ Y) =
        (Free.coefficientMap a i ▷ X) ≫ (Free.object a M ◁ f) :=
  ⟨originalFreeBoundary_endpointTests (B := B) a i hi f hUnit,
    original_endpointTensor_square f (Free.coefficientMap a i)⟩

/-- The caller's original orthogonal levelI Arrow is retained by the whole original
adjoint-family Arrow equality. The unit family is explicit and pointwise only at SAME f. -/
private theorem originalLevelI_endpointTests {A D : C.{u, v}} (g : A ⟶ D)
    (hg : NativeK.levelI (I := OrthogonalOperatorIndex.{u, v}) g)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : ∀ a : OrthogonalOperatorIndex.{u, v},
      W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    W (A ◁ f) ∧ W (D ◁ f) := by
  exact CategoryTheory.OriginalFreeGeneratorEndpointBoundary.enrichedFreeGenerator_endpointTests
    W PointedCGWH.realizedBoundaryInclusions f g hg
    (fun a {K M} i hi => originalFreeBoundary_endpointTests (B := B) (K := K) (M := M) a i hi f (hUnit a))

/-- The complete original caller generator map and both untouched endpoints retain the
actual orthogonal balanced-tensor square after whole Arrow transport. -/
private theorem originalLevelI_endpointSquare {A D : C.{u, v}} (g : A ⟶ D)
    (hg : NativeK.levelI (I := OrthogonalOperatorIndex.{u, v}) g)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : ∀ a : OrthogonalOperatorIndex.{u, v},
      W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    (W (A ◁ f) ∧ W (D ◁ f)) ∧ (A ◁ f) ≫ (g ▷ Y) = (g ▷ X) ≫ (D ◁ f) :=
  ⟨originalLevelI_endpointTests (B := B) g hg f hUnit, original_endpointTensor_square f g⟩

/-- The original stable orthogonal model has the SAME pointwise free-unit-to-free-boundary
endpoint transfer in its literal weak class. -/
private theorem originalStableFreeBoundary_endpointTests (a : OrthogonalOperatorIndex.{u, v})
    {K M : PointedCGWH.{u, v}} (i : K ⟶ M) (hi : PointedCGWH.realizedBoundaryInclusions i)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory C.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
    weakEquivalences C.{u, v} (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) →
      weakEquivalences C.{u, v} (Free.object a K ◁ f) ∧
        weakEquivalences C.{u, v} (Free.object a M ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
  change weakEquivalences C.{u, v} _ → weakEquivalences C.{u, v} _ ∧ weakEquivalences C.{u, v} _
  rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1]
  exact originalFreeBoundary_endpointTests (B := B) a i hi f

/-- Every original caller levelI arrow has the literal stable-model endpoint transfer, with
honest pointwise free-unit tests only at this same arbitrary input f and original labels. -/
private theorem originalStableLevelI_endpointTests {A D : C.{u, v}} (g : A ⟶ D)
    (hg : NativeK.levelI (I := OrthogonalOperatorIndex.{u, v}) g)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory C.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
    (∀ a : OrthogonalOperatorIndex.{u, v},
      weakEquivalences C.{u, v} (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) →
      weakEquivalences C.{u, v} (A ◁ f) ∧ weakEquivalences C.{u, v} (D ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
  change (∀ a : OrthogonalOperatorIndex.{u, v}, weakEquivalences C.{u, v} _) →
    weakEquivalences C.{u, v} _ ∧ weakEquivalences C.{u, v} _
  rw [(StableModelConstruction.orthogonal_five_classes (B := B)).1]
  exact originalLevelI_endpointTests (B := B) g hg f








