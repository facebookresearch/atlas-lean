/-- The original represented unit has the same literal unit map at every full native input. -/
private theorem unit_component (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (u : V)
    (hF : F.obj u ≅ 𝟙_ C) (hS : S.obj u ≅ 𝟭 C)
    (D : UnitRepresentationEvidence.Data F S u hF hS) (X : C) :
    (D.comparison.hom.app u).app X ≫ hS.hom.app X = hF.hom ▷ X ≫ (λ_ X).hom := by
  have h := congrArg (fun t => t.app X) D.unit_square
  simpa [ZeroFreeRepresentation.freeUnitTensor, ZeroFreeRepresentation.unitTensor] using h

/-- The same inverse unit map identifies the original physical source point. -/
private theorem unit_inverse_component (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (u : V)
    (hF : F.obj u ≅ 𝟙_ C) (hS : S.obj u ≅ 𝟭 C)
    (D : UnitRepresentationEvidence.Data F S u hF hS) (X : C) :
    (λ_ X).inv ≫ hF.inv ▷ X ≫ (D.comparison.hom.app u).app X = hS.inv.app X := by
  apply (cancel_mono (hS.hom.app X)).1
  simp only [Category.assoc]
  erw [unit_component F S u hF hS D X]
  simp

/-- Every original coefficient point is retained through the full represented scalar comparison. -/
private theorem point (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (u : V)
    (hF : F.obj u ≅ 𝟙_ C) (hS : S.obj u ≅ 𝟭 C)
    (D : UnitRepresentationEvidence.Data F S u hF hS)
    {K : V} (p : u ⟶ K) (X : C) :
    (λ_ X).inv ≫ (hF.inv ≫ F.map p) ▷ X ≫ (D.comparison.hom.app K).app X =
      hS.inv.app X ≫ (S.map p).app X := by
  have hn := congrArg (fun t => t.app X) (D.comparison.hom.naturality p)
  change F.map p ▷ X ≫ (D.comparison.hom.app K).app X =
    (D.comparison.hom.app u).app X ≫ (S.map p).app X at hn
  simp only [comp_whiskerRight, Category.assoc]
  rw [hn]
  simpa only [Category.assoc] using
    congrArg (fun t => t ≫ (S.map p).app X)
      (unit_inverse_component F S u hF hS D X)





end CategoryTheory.UnitRepresentationPoint

