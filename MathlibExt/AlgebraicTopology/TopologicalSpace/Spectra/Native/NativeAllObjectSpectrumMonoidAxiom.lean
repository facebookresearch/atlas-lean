  {L : C ⥤ D} {R : D ⥤ C} (adj : L ⊣ R) [Adjunction.IsQuillenAdjunction adj]

/-- A good source cylinder and its actual full homotopy map pass through the left adjoint. -/
private def mappedHomotopy {X : C} [IsCofibrant X] {Y : C}
    (P : Cylinder X) [P.IsGood] {f g : X ⟶ Y} (h : P.LeftHomotopy f g) :
    (QuillenOrdinaryHoHom.leftCylinder adj P).LeftHomotopy (L.map f) (L.map g) where
  h := L.map h.h
  h₀ := by
    change L.map P.i₀ ≫ L.map h.h = L.map f
    rw [← L.map_comp, h.h₀]
  h₁ := by
    change L.map P.i₁ ≫ L.map h.h = L.map g
    rw [← L.map_comp, h.h₁]

include adj

/-- The left Quillen functor preserves source-cofibrant left homotopies at arbitrary targets. -/
private theorem map_relation {X : C} [IsCofibrant X] {Y : C} {f g : X ⟶ Y}
    (h : LeftHomotopyRel f g) : LeftHomotopyRel (L.map f) (L.map g) := by
  obtain ⟨P, hP, ⟨h⟩⟩ := h.exists_good_cylinder
  let _ : P.IsGood := hP
  exact (mappedHomotopy adj P h).leftHomotopyRel

/-- Equality in the original Ho at a fibrant target passes through the same actual functor. -/
private theorem map_eq {X : C} [IsCofibrant X] {Y : C} [IsFibrant Y] {f g : X ⟶ Y}
    (h : (_root_.HomotopicalAlgebra.toHomotopyCategory C).map f = (_root_.HomotopicalAlgebra.toHomotopyCategory C).map
      g) :
    (_root_.HomotopicalAlgebra.toHomotopyCategory D).map (L.map f) = (_root_.HomotopicalAlgebra.toHomotopyCategory
      D).map (L.map g) := by
  have hr : LeftHomotopyRel f g :=
    (LeftHomotopyRel.iff_map_eq (_root_.HomotopicalAlgebra.toHomotopyCategory C) X Y).mpr h
  exact ((map_relation adj hr).factorsThroughLocalization D).map_eq (_root_.HomotopicalAlgebra.toHomotopyCategory D)

section Zero

variable [HasZeroMorphisms C] [HasZeroMorphisms D] [L.PreservesZeroMorphisms]

/-- A source-cofibrant null map remains null in original Ho, with no target cofibrancy. -/
private theorem map_null {X : C} [IsCofibrant X] {Y : C} [IsFibrant Y] (f : X ⟶ Y)
    (h : (_root_.HomotopicalAlgebra.toHomotopyCategory C).map f = (_root_.HomotopicalAlgebra.toHomotopyCategory C).map
      (0 : X ⟶ Y)) :
    (_root_.HomotopicalAlgebra.toHomotopyCategory D).map (L.map f) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory D).map (0 : L.obj X ⟶ L.obj Y) := by
  simpa only [Functor.map_zero] using map_eq adj h

end Zero






end HomotopicalAlgebra.QuillenLeftHomotopyMap

