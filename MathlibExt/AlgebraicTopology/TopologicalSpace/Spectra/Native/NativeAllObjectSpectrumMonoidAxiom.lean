private theorem insert_rightAction {Z : Type*} [Category Z] [MonoidalCategory Z]
    (A X Y M P : Z) (s : A ⊗ X ⟶ Y) (j : M ⟶ P) :
    (A ◁ (X ◁ j)) ≫ (α_ A X P).inv ≫ (s ▷ P) =
      (α_ A X M).inv ≫ (s ▷ M) ≫ (Y ◁ j) := by
  have h₁ := associator_inv_naturality_right A X j
  have h₂ := whisker_exchange s j
  exact ((Category.assoc _ _ _).symm).trans
    ((congrArg (fun f => f ≫ (s ▷ P)) h₁).trans
      ((Category.assoc _ _ _).trans (congrArg (fun f => (α_ A X M).inv ≫ f) h₂)))

