Neither the source object nor the target object is independently replaced. -/
private theorem endpointTests_of_wholeArrow_eq (W : MorphismProperty C)
    {X Y A B : C} (f : X ⟶ Y) (g : A ⟶ B) (G : Arrow C)
    (h : Arrow.mk g = G) (hG : W (G.left ◁ f) ∧ W (G.right ◁ f)) :
