variable {C : Type uC} [Category.{vC} C] {D : Type uD} [Category.{vD} D] {A : Type uA}
  (T : C ⥤ C) (τ : T ⟶ 𝟭 C) (H : C ⥤ D) (P : C ⥤ GrpCat.{uG})
  (B : A → C) (c : ∀ a, P.obj (B a)) (null : ∀ X Y : C, X ⟶ Y)
  (hRep : ∀ Y : C, ∀ β : P.obj Y, ∃ a : A, ∃ f : B a ⟶ Y, β = (P.map f) (c a))
  (hKernel : ∀ Y : C, ∀ α : P.obj (T.obj Y), (P.map (τ.app Y)) α = 1 →
    ∃ a : A, ∃ f : B a ⟶ T.obj Y,
      α = (P.map f) (c a) ∧ H.map (f ≫ τ.app Y) = H.map (null (B a) Y))
  (hFree : ∀ a : A, IsIso (P.map (τ.app (B a))))
  (hFace : ∀ (a : A) (Y : C) (f : B a ⟶ T.obj Y),
    H.map (τ.app (B a) ≫ f) = H.map (T.map (f ≫ τ.app Y)))
  (hNull : ∀ (a : A) (Y : C) (g : B a ⟶ Y), H.map g = H.map (null (B a) Y) →
    H.map (T.map g) = H.map (null (T.obj (B a)) (T.obj Y)))
  (hReadback : ∀ {X Y : C} (f g : X ⟶ Y), H.map f = H.map g → P.map f = P.map g)
  (hNullGroup : ∀ (X Y : C) (x : P.obj X), (P.map (null X Y)) x = 1)

/-- The proved arbitrary-target Gamma group maps form the whole original
natural isomorphism, retaining the actual Gamma map at every component. -/
private def originalGammaPiNatIso : T ⋙ P ≅ P := by
  let e (Y : C) : P.obj (T.obj Y) ≅ P.obj Y := by
    let _ : IsIso (P.map (τ.app Y)) :=
      originalGamma_isIso T τ H P B c null hRep hKernel hFree hFace hNull hReadback hNullGroup Y
    exact asIso (P.map (τ.app Y))
  refine NatIso.ofComponents e ?_
  intro X Y f
  change P.map (T.map f) ≫ P.map (τ.app Y) = P.map (τ.app X) ≫ P.map f
  rw [← P.map_comp, ← P.map_comp]
  exact P.congr_map (τ.naturality f)

/-- The complete forward component is the literal same original Gamma group map. -/
private theorem originalGammaPiNatIso_hom_component (Y : C) :
    (originalGammaPiNatIso T τ H P B c null hRep hKernel hFree hFace hNull hReadback hNullGroup).hom.app Y =
      P.map (τ.app Y) := rfl

/-- The whole inverse retains every original input arrow square. -/
private theorem originalGammaPiNatIso_inverse_naturality {X Y : C} (f : X ⟶ Y) :
    P.map f ≫
        (originalGammaPiNatIso T τ H P B c null hRep hKernel hFree hFace hNull hReadback hNullGroup).inv.app Y =
      (originalGammaPiNatIso T τ H P B c null hRep hKernel hFree hFace hNull hReadback hNullGroup).inv.app X ≫
        P.map (T.map f) :=
  (originalGammaPiNatIso T τ H P B c null hRep hKernel hFree hFace hNull hReadback hNullGroup).inv.naturality f

include τ H B c null hRep hKernel hFree hFace hNull hReadback hNullGroup

/-- The genuine original Gamma natural isomorphism proves preservation and
reflection of every group isomorphism by the original free-smash functor T. -/
private theorem originalGammaGroupFunctorMap_isIso_iff {X Y : C} (f : X ⟶ Y) :
    IsIso (P.map (T.map f)) ↔ IsIso (P.map f) :=
  NatIso.isIso_map_iff
    (originalGammaPiNatIso T τ H P B c null hRep hKernel hFree hFace hNull hReadback hNullGroup) f

/-- Every original signed group isomorphism is preserved on the same arbitrary
input arrow, through the proved original representative and physical Gamma joins. -/
private theorem originalGammaGroupFunctorMap_isIso {X Y : C} (f : X ⟶ Y) (hf : IsIso (P.map f)) :
    IsIso (P.map (T.map f)) :=
  (originalGammaGroupFunctorMap_isIso_iff T τ H P B c null
    hRep hKernel hFree hFace hNull hReadback hNullGroup f).mpr hf







