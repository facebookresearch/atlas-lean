  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

omit B in
/-- Proved HEP images of the actual original I generators supply the entire
mapped original cell history. P's mapped cofans, pushouts, bottom arrow and
continuous ordinal cocones are retained. No all-HEP preservation premise is used. -/
private def mappedRelativeCellHistory
    (P : Carrier (I := I) ⥤ Carrier (I := I))
    [PreservesColimitsOfSize.{v, v} P]
    [PreservesColimitsOfShape WalkingSpan P]
    {J : Type w} [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P]
    (hI : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    {X Y : Carrier (I := I)} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v} (fun (_ : J) => (NativeK.levelI (I := I)).homFamily) f) :
    (PointedCGWH.EnrichedBasedHomotopyExtension.property :
      MorphismProperty (Carrier (I := I))).TransfiniteCompositionOfShape J (P.map f) := by
  let T : MorphismProperty (Carrier (I := I)) :=
    PointedCGWH.EnrichedBasedHomotopyExtension.property
  let S := T.inverseImage P
  let _ : S.IsStableUnderCoproducts.{v} := @inverseImageCoproducts _ _ _ _ T P
    (inferInstanceAs (T.IsStableUnderCoproducts.{v}))
    (inferInstanceAs (PreservesColimitsOfSize.{v, v} P))
  let _ : S.IsStableUnderCobaseChange := inverseImageCobase T P
  let _ : c.F.IsWellOrderContinuous := c.isWellOrderContinuous
  let _ : PreservesWellOrderContinuousOfShape J P :=
    { preservesColimitsOfShape := fun _ _ => by infer_instance }
  let tr := c.transfiniteCompositionOfShape' (I := S) (fun cell => hI _ cell.i.2)
  have hClosure : (MorphismProperty.coproducts.{v} S).pushouts ≤ S :=
    (MorphismProperty.pushouts_monotone (MorphismProperty.coproducts_le S)).trans
      MorphismProperty.pushouts_le
  exact (tr.ofLE hClosure).map

omit B in
private theorem mappedRelativeCellHistory_functor
    (P : Carrier (I := I) ⥤ Carrier (I := I))
    [PreservesColimitsOfSize.{v, v} P]
    [PreservesColimitsOfShape WalkingSpan P]
    {J : Type w} [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P]
    (hI : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    {X Y : Carrier (I := I)} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v} (fun (_ : J) => (NativeK.levelI (I := I)).homFamily) f) :
    (mappedRelativeCellHistory P hI c).F = c.F ⋙ P := rfl

omit B in
private theorem mappedRelativeCellHistory_inclusion
    (P : Carrier (I := I) ⥤ Carrier (I := I))
    [PreservesColimitsOfSize.{v, v} P]
    [PreservesColimitsOfShape WalkingSpan P]
    {J : Type w} [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P]
    (hI : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    {X Y : Carrier (I := I)} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v} (fun (_ : J) => (NativeK.levelI (I := I)).homFamily) f)
    (j : J) : (mappedRelativeCellHistory P hI c).incl.app j = P.map (c.incl.app j) := by
  change P.map (c.incl.app j) ≫ 𝟙 _ = P.map (c.incl.app j)
  exact Category.comp_id _

/-- The weak comparison uses only proved original-I image HEP, the original
generator endpoint tests, actual preserved pushouts and the earned ordinal theorem. -/
private theorem comparison_of_relativeICells
    (s : NativeStabilizationFamily.{u, v} I L)
    [(NativeK.omegaTests s).IsStableUnderCoproducts.{v}]
    {P Q : Carrier (I := I) ⥤ Carrier (I := I)} (α : P ⟶ Q)
    [PreservesColimitsOfSize.{v, v} P] [PreservesColimitsOfSize.{v, v} Q]
    [PreservesColimitsOfShape WalkingSpan P] [PreservesColimitsOfShape WalkingSpan Q]
    {J : Type w} [Small.{v} J] [LinearOrder J] [OrderBot J] [SuccOrder J] [WellFoundedLT J]
    [PreservesColimitsOfSize.{w, w} P] [PreservesColimitsOfSize.{w, w} Q]
    (hIP : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i))
    (hIQ : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i))
    (hCells : ∀ {A X : Carrier (I := I)} (i : A ⟶ X), NativeK.levelI i →
      NativeK.omegaTests s (α.app A) ∧ NativeK.omegaTests s (α.app X))
    (hPush : ∀ {A X Z R : Carrier (I := I)} (i : A ⟶ X) (z : A ⟶ Z)
      (kX : X ⟶ R) (kZ : Z ⟶ R), IsPushout i z kX kZ →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (P.map i) →
      PointedCGWH.EnrichedBasedHomotopyExtension.property (Q.map i) →
      NativeK.omegaTests s (α.app A) → NativeK.omegaTests s (α.app X) →
      NativeK.omegaTests s (α.app Z) → NativeK.omegaTests s (α.app R))
    {X Y : Carrier (I := I)} {f : X ⟶ Y}
    (c : RelativeCellComplex.{v} (fun (_ : J) => (NativeK.levelI (I := I)).homFamily) f)
    (hX : NativeK.omegaTests s (α.app X)) : NativeK.omegaTests s (α.app Y) := by
  let W := NativeK.omegaTests s
  let T : MorphismProperty (Carrier (I := I)) :=
    PointedCGWH.EnrichedBasedHomotopyExtension.property
  let SP := T.inverseImage P
  let SQ := T.inverseImage Q
  let _ : SP.IsStableUnderCoproducts.{v} := @inverseImageCoproducts _ _ _ _ T P
    (inferInstanceAs (T.IsStableUnderCoproducts.{v}))
    (inferInstanceAs (PreservesColimitsOfSize.{v, v} P))
  let _ : SQ.IsStableUnderCoproducts.{v} := @inverseImageCoproducts _ _ _ _ T Q
    (inferInstanceAs (T.IsStableUnderCoproducts.{v}))
    (inferInstanceAs (PreservesColimitsOfSize.{v, v} Q))
  let _ : c.F.IsWellOrderContinuous := c.isWellOrderContinuous
  let _ : T.IsStableUnderTransfiniteComposition.{w} := by
    dsimp only [T]
    rw [Orthogonal.OriginalIClosedHomotopyExtension.nativeHEP_eq_llp]
    infer_instance
  let ph := mappedRelativeCellHistory P hIP c
  let qh := mappedRelativeCellHistory Q hIQ c
  have hAllP : ∀ {i k : J} (g : i ⟶ k), T (P.map (c.F.map g)) := fun g => ph.mem_map g
  have hAllQ : ∀ {i k : J} (g : i ⟶ k), T (Q.map (c.F.map g)) := fun g => qh.mem_map g
  have hStages : ∀ k, W (α.app (c.F.obj k)) := by
    intro k
    induction k using SuccOrder.limitRecOn with
    | isMin k hk =>
      obtain rfl := hk.eq_bot
      exact (W.arrow_mk_iso_iff
        (OriginalRelativeCellComparison.comparisonArrowIso α c.isoBot)).mpr hX
    | succ k hk ih =>
      let a := c.attachCells k hk
      let sources : a.ι → Carrier (I := I) := fun t => (a.π t).1.left
      let targets : a.ι → Carrier (I := I) := fun t => (a.π t).1.right
      have hSources : W (α.app a.cofan₁.pt) :=
        OriginalRelativeCellComparison.comparison_of_cofan s α sources
          a.cofan₁ a.isColimit₁ (fun t => (hCells (a.π t).1.hom (a.π t).2).1)
      have hTargets : W (α.app a.cofan₂.pt) :=
        OriginalRelativeCellComparison.comparison_of_cofan s α targets
          a.cofan₂ a.isColimit₂ (fun t => (hCells (a.π t).1.hom (a.π t).2).2)
      have hmP : MorphismProperty.coproducts.{v} SP a.m :=
        MorphismProperty.colimitsOfShape_le_coproducts SP a.ι a.m
          (MorphismProperty.colimitsOfShape.mk' (W := SP) _ _ a.cofan₁ a.cofan₂
            a.isColimit₁ a.isColimit₂ (Discrete.natTrans (fun t => (a.π t.as).1.hom))
            (fun t => hIP _ (a.π t.as).2) a.m (fun t => a.hm t.as))
      have hmQ : MorphismProperty.coproducts.{v} SQ a.m :=
        MorphismProperty.colimitsOfShape_le_coproducts SQ a.ι a.m
          (MorphismProperty.colimitsOfShape.mk' (W := SQ) _ _ a.cofan₁ a.cofan₂
            a.isColimit₁ a.isColimit₂ (Discrete.natTrans (fun t => (a.π t.as).1.hom))
            (fun t => hIQ _ (a.π t.as).2) a.m (fun t => a.hm t.as))
      exact hPush a.m a.g₁ a.g₂ (c.F.map (homOfLE (Order.le_succ k))) a.isPushout.flip
        (MorphismProperty.coproducts_le SP a.m hmP)
        (MorphismProperty.coproducts_le SQ a.m hmQ) hSources hTargets ih
    | isSuccLimit k hk ih =>
      let _ : OrderBot (Set.Iio k) := { bot := ⟨⊥, hk.bot_lt⟩, bot_le t := bot_le }
      let _ : SuccOrder (Set.Iio k) := SuccOrder.ofLinearWellFoundedLT (Set.Iio k)
      let F := (Set.principalSegIio k).monotone.functor ⋙ c.F
      let _ : F.IsWellOrderContinuous :=
        inferInstanceAs
          (((Set.principalSegIio k : Set.Iio k ≤i J)).monotone.functor ⋙ c.F).IsWellOrderContinuous
      exact OriginalRelativeCellComparison.comparison_of_HEPOrdinalCocone s α F
        (fun t _ => hAllP ((Set.principalSegIio k).monotone.functor.map
          (homOfLE (Order.le_succ t))))
        (fun t _ => hAllQ ((Set.principalSegIio k).monotone.functor.map
          (homOfLE (Order.le_succ t))))
        ((Set.principalSegIio k).cocone c.F) (c.F.isColimitOfIsWellOrderContinuous k hk)
        (fun t => ih t.1 t.2)
  exact OriginalRelativeCellComparison.comparison_of_HEPOrdinalCocone s α c.F
    (fun k hk => ph.map_mem k hk) (fun k hk => qh.map_mem k hk)
    (⟨Y, c.incl⟩ : Cocone c.F) c.isColimit hStages








