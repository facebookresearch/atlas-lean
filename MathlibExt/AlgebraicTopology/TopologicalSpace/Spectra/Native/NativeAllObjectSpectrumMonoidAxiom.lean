  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers

private theorem coefficientFirstGenerator_block (N : Mod C.{u, v} S.{u, v})
    (r m : I) (M : V.{u, v}) {d e : BlockDecomposition r m} (f : d ⟶ e) :
    (M ◁ N.X.functor.map f.left) ≫ coefficientFirstGenerator N r m M e =
      coefficientFirstGenerator N r m M d := by
  let k := N.X.functor.map f.left
  let b := (β_ M (N.X.functor.obj d.left)).hom
  let b' := (β_ M (N.X.functor.obj e.left)).hom
  let q := representedTensorGenerator N.X r m M d
  let q' := representedTensorGenerator N.X r m M e
  have hb : (M ◁ k) ≫ b' = b ≫ (k ▷ M) := braiding_naturality_right M k
  have hq : (k ▷ M) ≫ q' = q := representedTensorGenerator_block N.X r m M f
  have h₁ := (Category.assoc (M ◁ k) b' q').symm
  have h₂ := congrArg (fun a => a ≫ q') hb
  have h₃ := Category.assoc b (k ▷ M) q'
  have h₄ := congrArg (fun a => b ≫ a) hq
  exact h₁.trans (h₂.trans (h₃.trans h₄))

private theorem coefficientFirstGenerator_postcompose (N : Mod C.{u, v} S.{u, v})
    (r m k : I) (M : V.{u, v}) (d : BlockDecomposition r m) (h : m ⟶ k) :
    coefficientFirstGenerator N r m M d ≫ (N.X ⊗ (representedDiagram r).obj M).functor.map h =
      coefficientFirstGenerator N r k M (blockPostcompose d h) := by
  let b := (β_ M (N.X.functor.obj d.left)).hom
  let q := representedTensorGenerator N.X r m M d
  let k := (N.X ⊗ (representedDiagram r).obj M).functor.map h
  have hq := representedTensorGenerator_postcompose N.X r m _ M d h
  exact (Category.assoc b q k).trans (congrArg (fun a => b ≫ a) hq)

private def originalOrbitBlock (c n : ℕ) (i : OrbitIndex c n) :
    BlockDecomposition (card n) (card (c + n)) :=
  CostructuredArrow.mk (OrbitTailHelper.originalOrbitBlockIso c n i).hom

private def originalOrbitBlockGrowMorphism (c n : ℕ) (i : OrbitIndex c n) :
    blockPostcompose (sphereGrowBlock (card 1) (originalOrbitBlock c n i))
        (NativeActionSource.actualPrefixIso c n).hom ⟶
      originalOrbitBlock (c + 1) n (growOrbit c n i) :=
  CostructuredArrow.homMk (NativeActionSource.sequentialPrefixIso c).hom
    (NativeOrbitIndex.orbitBlock_prefix c n i).symm

private theorem coefficientFirstGenerator_prefix (N : Mod C.{u, v} S.{u, v})
    (c n : ℕ) (M : V.{u, v}) (i : OrbitIndex c n) :
    (PointedCGWH.sphereOne ◁ coefficientFirstGenerator N (card n) (card (c + n)) M
        (originalOrbitBlock c n i)) ≫
      (NativeActionSource.circleToCoefficientHom.{u, v} ▷
        (N.X ⊗ (representedDiagram (card n)).obj M).functor.obj (card (c + n))) ≫
      PointedCGWH.SymmetricModulePresentation.pairAction
        (Mod.FreeRelativeTensor.rightTensorModule A.{u, v} ((representedDiagram (card n)).obj M) N)
        (card 1) (card (c + n)) ≫
      (N.X ⊗ (representedDiagram (card n)).obj M).functor.map
        (NativeActionSource.actualPrefixIso c n).hom =
    coefficientScalarAction N (card 1) (card c) M PointedCGWH.sphereOne
        NativeActionSource.circleToCoefficientHom.{u, v} ≫
      (M ◁ N.X.functor.map (NativeActionSource.sequentialPrefixIso c).hom) ≫
      coefficientFirstGenerator N (card n) (card ((c + 1) + n)) M
        (originalOrbitBlock (c + 1) n (growOrbit c n i)) := by
  let d := originalOrbitBlock c n i
  let dg := sphereGrowBlock (card 1) d
  let dp := blockPostcompose dg (NativeActionSource.actualPrefixIso c n).hom
  let dn := originalOrbitBlock (c + 1) n (growOrbit c n i)
  let s := coefficientScalarAction N (card 1) (card c) M PointedCGWH.sphereOne
    NativeActionSource.circleToCoefficientHom.{u, v}
  let qg := coefficientFirstGenerator N (card n) (card 1 ⊗ card (c + n)) M dg
  let qp := coefficientFirstGenerator N (card n) (card ((c + 1) + n)) M dp
  let qn := coefficientFirstGenerator N (card n) (card ((c + 1) + n)) M dn
  let k := (N.X ⊗ (representedDiagram (card n)).obj M).functor.map
    (NativeActionSource.actualPrefixIso c n).hom
  let b := M ◁ N.X.functor.map (NativeActionSource.sequentialPrefixIso c).hom
  have hp := coefficientFirstGenerator_pre_pairAction N (card 1) (card n) (card (c + n)) M
    PointedCGWH.sphereOne NativeActionSource.circleToCoefficientHom.{u, v} d
  have h₁ := congrArg (fun a => a ≫ k) hp
  have hk : qg ≫ k = qp := coefficientFirstGenerator_postcompose N (card n)
    (card 1 ⊗ card (c + n)) (card ((c + 1) + n)) M dg (NativeActionSource.actualPrefixIso c n).hom
  have hb : b ≫ qn = qp := coefficientFirstGenerator_block N (card n) (card ((c + 1) + n)) M
    (originalOrbitBlockGrowMorphism c n i)
  have h₂ := (Category.assoc s qg k).trans (congrArg (fun a => s ≫ a) hk)
  have h₃ := congrArg (fun a => s ≫ a) hb.symm
  have h := h₁.trans (h₂.trans h₃)
  simpa only [Category.assoc] using h

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeDayAction
