private theorem originalOperatorIndex_induction (P : PointedCGWH.SymmetricOperatorIndex.{u, v} → Prop)
    (h : ∀ n : ℕ, P (PointedCGWH.symmetricOperatorObj (card n)))
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) : P a := by
  rcases a with ⟨⟨⟨n⟩⟩⟩
  exact h n

