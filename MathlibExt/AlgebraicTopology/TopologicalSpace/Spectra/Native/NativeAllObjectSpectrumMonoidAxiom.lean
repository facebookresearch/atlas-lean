/-!
## Entire original free-sphere tensor powers and native function iterates

The actual free-pair comparison and all original tensor/unit maps give genuine
isomorphisms from tensor powers of the original free one-sphere to free spectra
at the corresponding original finite index and sphere tensor power. Both
source and coefficient casts remain explicit. This is a whole native spectrum
isomorphism, prior to its separate source-coaugmentation/transition calculation.
-/

set_option autoImplicit false
noncomputable section
open CategoryTheory MonoidalCategory
open scoped MonoidalClosed

namespace NativeOmegaRecovery.OriginalCompleteRFreePowerIteration
universe u v
open CategoryTheory.EnrichedFunctorCat
private abbrev I := Operad.SmallFinBijGroupoid
private abbrev V := PointedCGWH.{u, v}
private abbrev Carrier := EnrichedFunctorCat V.{u, v} PointedCGWH.SymmetricOperatorIndex.{u, v}
attribute [local instance] Operad.SmallFinBijGroupoid.instMonoidalCategory
  Operad.SmallFinBijGroupoid.instSymmetricCategory
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.symmetricCategory
  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalClosed

open PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash

/-- The original native free one-sphere, as a whole spectrum. -/
private def freeOne : Carrier.{u, v} := free (Operad.SmallFinBijGroupoid.card 1) PointedCGWH.sphereOne

/-- The corresponding actual original free n-sphere object. -/
private def freePower (n : ℕ) : Carrier.{u, v} :=
  free (Operad.SmallFinBijGroupoid.card n) (TensorPower.tensorPowObj PointedCGWH.sphereOne n)

/-- Every actual degree cast is retained by the entire enriched free functor. -/
private def freeDegreeCast (n k : ℕ) (h : n = k) (M : V.{u, v}) :
    free (Operad.SmallFinBijGroupoid.card n) M ≅ free (Operad.SmallFinBijGroupoid.card k) M :=
  eqToIso (congrArg (fun j => free (Operad.SmallFinBijGroupoid.card j) M) h)

/-- The genuine free-zero unit comparison supplies the exact zero tensor power. -/
private def freeZeroPowerIso : (𝟙_ Carrier.{u, v}) ≅ freePower 0 :=
  freeZeroIsoSphereUnit.symm

/-- Every successor uses the original ordered free-pair map and exact output degree cast. -/
private def freePowerStep (n : ℕ) : freePower n ⊗ freeOne ≅ freePower (n + 1) :=
  freePairIso (Operad.SmallFinBijGroupoid.card n) (Operad.SmallFinBijGroupoid.card 1)
    (TensorPower.tensorPowObj PointedCGWH.sphereOne n) PointedCGWH.sphereOne ≪≫
      freeDegreeCast (1 + n) (n + 1) (Nat.add_comm 1 n)
        (TensorPower.tensorPowObj PointedCGWH.sphereOne n ⊗ PointedCGWH.sphereOne)

/-- Whole actual free-one tensor powers retain every native free-pair and degree cast. -/
private def freeTensorPowerIso : ∀ n,
    TensorPower.tensorPowObj freeOne.{u, v} n ≅ freePower n :=
  Nat.rec
    (motive := fun n => TensorPower.tensorPowObj freeOne.{u, v} n ≅ freePower n)
    freeZeroPowerIso
    (fun n previous => tensorIso previous (Iso.refl freeOne) ≪≫ freePowerStep n)

/-- Every entire actual input of the original function functor uses the whole free tensor source. -/
private def functionTensorPowerIso (n : ℕ) :
    Functor.Iteration.iterate (ihom freeOne.{u, v}) n ≅ ihom (freePower n) :=
  WholeFunctionIteration.iterateFunctionIso freeOne n ≪≫
    MonoidalClosed.internalHom.mapIso (freeTensorPowerIso n).symm.op

/-- The actual original R functor is the function from the same complete native free one-sphere. -/
private theorem originalR_eq : NativeSymmetricR.functor.{u, v} = ihom freeOne.{u, v} :=
  (internalHom_eq_originalFunction freeOne).symm

/-- Every original whole R iterate is the actual function functor from free n tensor-spheres. -/
private def originalRFreePowerIso (n : ℕ) :
    NativeSymmetricR.iterate.{u, v} n ≅
      NativeOmegaPreparation.NativeSymmetricFunction.functor (freePower n) :=
  eqToIso (congrArg (fun F => Functor.Iteration.iterate F n) originalR_eq) ≪≫
    functionTensorPowerIso n ≪≫
      eqToIso (internalHom_eq_originalFunction (freePower n))

/-- All complete actual native input maps retain the full forward original R comparison. -/
private theorem originalRFreePowerIso_hom_naturality (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    (NativeSymmetricR.iterate n).map f ≫ (originalRFreePowerIso n).hom.app Y =
      (originalRFreePowerIso n).hom.app X ≫
        (NativeOmegaPreparation.NativeSymmetricFunction.functor (freePower n)).map f :=
  (originalRFreePowerIso n).hom.naturality f

/-- The entire inverse comparison retains those same native source and target maps. -/
private theorem originalRFreePowerIso_inv_naturality (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    (NativeOmegaPreparation.NativeSymmetricFunction.functor (freePower n)).map f ≫
        (originalRFreePowerIso n).inv.app Y =
      (originalRFreePowerIso n).inv.app X ≫ (NativeSymmetricR.iterate n).map f :=
  (originalRFreePowerIso n).inv.naturality f

/-- The whole actual forward function comparison is natural in every native input map. -/
private theorem functionTensorPowerIso_hom_naturality (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    (Functor.Iteration.iterate (ihom freeOne) n).map f ≫
        (functionTensorPowerIso n).hom.app Y =
      (functionTensorPowerIso n).hom.app X ≫ (ihom (freePower n)).map f :=
  (functionTensorPowerIso n).hom.naturality f

/-- The inverse retains the same entire original native input map and free source. -/
private theorem functionTensorPowerIso_inv_naturality (n : ℕ) {X Y : Carrier.{u, v}} (f : X ⟶ Y) :
    (ihom (freePower n)).map f ≫ (functionTensorPowerIso n).inv.app Y =
      (functionTensorPowerIso n).inv.app X ≫
        (Functor.Iteration.iterate (ihom freeOne) n).map f :=
  (functionTensorPowerIso n).inv.naturality f

/-- Every original native input retains both inverse identities of the full R/free-power Iso. -/
private theorem originalRFreePowerIso_inverse (n : ℕ) (X : Carrier.{u, v}) :
    (originalRFreePowerIso n).hom.app X ≫ (originalRFreePowerIso n).inv.app X = 𝟙 _ ∧
      (originalRFreePowerIso n).inv.app X ≫ (originalRFreePowerIso n).hom.app X = 𝟙 _ :=
  ⟨(originalRFreePowerIso n).hom_inv_id_app X, (originalRFreePowerIso n).inv_hom_id_app X⟩

/-- Every entire pointed parameter is recovered by both actual evaluated full-R comparison maps. -/
private theorem originalRFreePowerIso_parameter (n : ℕ) (X : Carrier.{u, v})
    (m : I) (W : V.{u, v})
    (p : W ⟶ ((NativeSymmetricR.iterate n).obj X).toEnrichedFunctor.obj
      (PointedCGWH.symmetricOperatorObj.{u, v} m)) :
    (p ≫ component ((originalRFreePowerIso n).hom.app X)
      (PointedCGWH.symmetricOperatorObj.{u, v} m)) ≫
        component ((originalRFreePowerIso n).inv.app X)
          (PointedCGWH.symmetricOperatorObj.{u, v} m) = p := by
  have h := congrArg (fun z => component z (PointedCGWH.symmetricOperatorObj.{u, v} m))
    ((originalRFreePowerIso n).hom_inv_id_app X)
  rw [component_comp, component_id] at h
  rw [Category.assoc, h, Category.comp_id]

end NativeOmegaRecovery.OriginalCompleteRFreePowerIteration
end

