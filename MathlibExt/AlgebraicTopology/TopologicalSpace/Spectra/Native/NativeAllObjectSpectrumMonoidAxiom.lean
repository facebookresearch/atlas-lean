namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3

private abbrev V := PointedCGWH.{u, v}
private abbrev Carrier := Actual.SymmetricCarrier.{u, v}

attribute [local instance] Operad.SmallFinBijGroupoid.instMonoidalCategory
