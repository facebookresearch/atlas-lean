/-- The actual original free-sphere smash sends each whole original
replacement counit to an Omega test equivalence by the proved all-integer orbit
calculation and the closed original one-way detector. Its target is arbitrary. -/
private theorem originalFreeSphereCounit_omegaTests (n : ℕ) (X : C.{u, v}) :
    W ((originalFreeSphereSmashFunctor n).map (ε.app X)) := by
  apply PointedCGWH.Spectra.OriginalSymmetricPiStarOmegaTests.integerIsos_imply_omegaTests
  have hPi := originalFreeSphereSmash_integerPi_preserves n (ε.app X)
    ((integerPiStarEquivalences_iff _).mp (levelWeak_le_integerPiStarEquivalences _
      (Replacement.cofibrantReplacementCounit_mem_weakEquivalences X)))
  intro q
  exact isIso_of_mapFunctorEq (integerPiFunctor q) (originalFreeSphereSmashFunctor_eq n)
    (ε.app X) (hPi q)

/-- The actual original free-sphere smash preserves every original Omega
test on arbitrary arrow endpoints. The complete Q/counit square and both original
image counits transfer the genuine cofibrant Q-map theorem to the same caller map. -/
private theorem originalFreeSphereSmash_omegaTests (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y)
    (hf : W f) : W ((originalFreeSphereSmashFunctor n).map f) := by
  let F := originalFreeSphereSmashFunctor n
  let _ : IsCofibrant (Coefficient n) :=
    Actual.symmetricFamily.coefficient_cofibrant (card 0, card n)
  have hQf : W (F.map (Q.map f)) :=
    PointedCGWH.Spectra.NativeStableMonoidal.symmetricFreeSmashQMap_omegaTests
      (card n) (Coefficient n) f hf
  have hX : W (F.map (ε.app X)) := originalFreeSphereCounit_omegaTests n X
  have hY : W (F.map (ε.app Y)) := originalFreeSphereCounit_omegaTests n Y
  have hn : F.map (Q.map f) ≫ F.map (ε.app Y) = F.map (ε.app X) ≫ F.map f :=
    (F.map_comp _ _).symm.trans ((F.congr_map (ε.naturality f)).trans (F.map_comp _ _))
  have hComposite := W.comp_mem _ _ hQf hY
  rw [hn] at hComposite
  exact W.of_precomp _ _ hX hComposite

/-- The literal original balanced tensor action receives the same full
arbitrary-endpoint free-sphere test without a cofibrancy assumption on either endpoint. -/
private theorem originalFreeSphereTensor_omegaTests (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y)
    (hf : W f) : W (originalFreeSphere n ◁ f) := by
  have h := originalFreeSphereSmash_omegaTests n f hf
  change W ((tensorLeft (originalFreeSphere n)).map f)
  rw [PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.tensorLeft_eq_originalSmash]
  exact h

/-- The constructed original stable model weak class receives the same
native free-sphere tensor action on every arbitrary original source weak arrow. -/
private theorem originalStableFreeSphereTensor_weak (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    weakEquivalences C.{u, v} f → weakEquivalences C.{u, v} (originalFreeSphere n ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  change weakEquivalences C.{u, v} f → weakEquivalences C.{u, v} (originalFreeSphere n ◁ f)
  intro hf
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1] at hf ⊢
  exact originalFreeSphereTensor_omegaTests n f hf









