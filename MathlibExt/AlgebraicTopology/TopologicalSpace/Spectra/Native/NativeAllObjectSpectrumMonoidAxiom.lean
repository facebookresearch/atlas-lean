namespace PointedCGWH.Spectra.OriginalFreeSmashPhysical

attribute [local instance] CanonicalSourceSmash.monoidalCategory
  CanonicalSourceSmash.symmetricCategory CanonicalSourceSmashClosed.monoidalClosed
  MonoidalClosed.enrichedCategorySelf PointedCGWH.EnrichedMapping.hasSmallLimits

/-- The actual original interval homotopy is right-smashed on the same free source. -/
private def rightSmashOriginalFreeHomotopy (r : OrthogonalIndex) (M : PointedCGWH.{u, v})
    (Y : Carrier.{u, v}) {Z : Carrier.{u, v}}
    (H : PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z) :
    PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y) ⟶ Z ⊗ Y :=
  rightSmashFreeHomotopy r M Y H

/-- The same original mixed-source map is retained before the first physical action. -/
private def originalFirstSourceAction (r : OrthogonalIndex) (M : PointedCGWH.{u, v})
    (Y : Carrier.{u, v}) {D Z : Carrier.{u, v}}
    (g : D ⟶ Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y)
    (H : PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z) :
    PointedCGWH.EnrichedIntervalCylinder.object D ⟶ Z ⊗ Y :=
  tensorLeftMap PointedCGWH.IntervalCoefficient.interval g ≫
    rightSmashOriginalFreeHomotopy r M Y H

/-- Every scalar field of the original first source action retains the same complete g. -/
private theorem originalFirstSourceAction_point
    (r : OrthogonalIndex) (M : PointedCGWH.{u, v}) (Y : Carrier.{u, v})
    {D Z : Carrier.{u, v}}
    (g : D ⟶ Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y)
    (H : PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z) (i : Fin 2) :
    pointMap (PointedCGWH.IntervalCoefficient.endpoint i) D ≫
        originalFirstSourceAction r M Y g H =
      g ≫ (pointMap (PointedCGWH.IntervalCoefficient.endpoint i)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H) ▷ Y := by
  change pointMap (PointedCGWH.IntervalCoefficient.endpoint i) D ≫
      (tensorLeftMap PointedCGWH.IntervalCoefficient.interval g ≫
        rightSmashFreeHomotopy r M Y H) = _
  rw [← Category.assoc, pointMap_naturality, Category.assoc,
    rightSmashFreeHomotopy_endpoint]

/-- The exact complete original endpoint predicate holds for the same first-source action. -/
private theorem originalFirstSourceAction_endpointProperty
    (r : OrthogonalIndex) (M : PointedCGWH.{u, v}) (Y : Carrier.{u, v})
    {D Z : Carrier.{u, v}}
    (g : D ⟶ Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y)
    (H : PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z) (i : Fin 2) :
    Endpoint i D (Z ⊗ Y) (originalFirstSourceAction r M Y g H)
      (g ≫ (pointMap (PointedCGWH.IntervalCoefficient.endpoint i)
        (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H) ▷ Y) :=
  endpoint_of_point i D (Z ⊗ Y) (originalFirstSourceAction r M Y g H) _
    (originalFirstSourceAction_point r M Y g H i)

/-- Both original endpoint maps are retained for every original H, g, source, and right factor. -/
private theorem originalFirstSourceAction_two_endpointProperties
    (r : OrthogonalIndex) (M : PointedCGWH.{u, v}) (Y : Carrier.{u, v})
    {D Z : Carrier.{u, v}}
    (g : D ⟶ Free.object (OrthogonalOperatorIndex.ofIndex r) M ⊗ Y)
    (f₀ f₁ : Free.object (OrthogonalOperatorIndex.ofIndex r) M ⟶ Z)
    (H : PointedCGWH.EnrichedIntervalCylinder.object
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ⟶ Z)
    (h₀ : PointedCGWH.EnrichedIntervalCylinder.inclusion 0
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₀)
    (h₁ : PointedCGWH.EnrichedIntervalCylinder.inclusion 1
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₁) :
    Endpoint 0 D (Z ⊗ Y) (originalFirstSourceAction r M Y g H) (g ≫ f₀ ▷ Y) ∧
      Endpoint 1 D (Z ⊗ Y) (originalFirstSourceAction r M Y g H) (g ≫ f₁ ▷ Y) := by
  have hp₀ : pointMap (PointedCGWH.IntervalCoefficient.endpoint 0)
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₀ := by
    simpa only [inclusion_point] using h₀
  have hp₁ : pointMap (PointedCGWH.IntervalCoefficient.endpoint 1)
      (Free.object (OrthogonalOperatorIndex.ofIndex r) M) ≫ H = f₁ := by
    simpa only [inclusion_point] using h₁
  exact ⟨endpoint_of_point 0 D (Z ⊗ Y) (originalFirstSourceAction r M Y g H) _
      ((originalFirstSourceAction_point r M Y g H 0).trans
        (congrArg (fun f => g ≫ f ▷ Y) hp₀)),
    endpoint_of_point 1 D (Z ⊗ Y) (originalFirstSourceAction r M Y g H) _
      ((originalFirstSourceAction_point r M Y g H 1).trans
        (congrArg (fun f => g ≫ f ▷ Y) hp₁))⟩







end PointedCGWH.Spectra.OriginalFreeSmashPhysical

