section OrdinaryPoint

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]

/-- The actual coefficient point uses the original inverse unitor and original scalar arrow. -/
private def coefficientPoint {T : V} (p : 𝟙_ V ⟶ T) (M : V) : M ⟶ T ⊗ M :=
  (λ_ M).inv ≫ p ▷ M

/-- Every original coefficient arrow retains the same scalar point. -/
private theorem coefficientPoint_naturality {T A B : V} (p : 𝟙_ V ⟶ T) (f : A ⟶ B) :
    coefficientPoint p A ≫ T ◁ f = f ≫ coefficientPoint p B := by
  rw [coefficientPoint, coefficientPoint, Category.assoc, ← whisker_exchange,
    ← Category.assoc, ← leftUnitor_inv_naturality, Category.assoc]

/-- The complete original associator preserves the point through both coefficient factors. -/
private theorem coefficientPoint_associator {T : V} (p : 𝟙_ V ⟶ T) (M N : V) :
    (coefficientPoint p M ▷ N) ≫ (α_ T M N).hom = coefficientPoint p (M ⊗ N) := by
  rw [coefficientPoint, coefficientPoint, comp_whiskerRight, Category.assoc,
    associator_naturality_left, ← Category.assoc, leftUnitor_inv_whiskerRight]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]

/-- The same original point is carried by the inverse associator, with its exact two factors
    retained. -/
private theorem coefficientPoint_inverse_associator {T : V} (p : 𝟙_ V ⟶ T) (M N : V) :
    coefficientPoint p (M ⊗ N) ≫ (α_ T M N).inv = coefficientPoint p M ▷ N := by
  rw [← coefficientPoint_associator p M N]
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]

end OrdinaryPoint

section EnrichedPoint

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V]
  {I : Type uI} [EnrichedCategory V I]

attribute [local instance] MonoidalClosed.enrichedCategorySelf

/-- The actual scalar point on an entire native diagram, with the original scalar unit map. -/
private def pointMap {T : V} (p : 𝟙_ V ⟶ T) (X : EnrichedFunctorCat V I) :
    X ⟶ tensorLeftObject T X :=
  (scalarUnitIso X).inv ≫ scalarTensorMap p X

/-- Every original component retains exactly the same inverse unitor and scalar coefficient. -/
private theorem pointMap_component {T : V} (p : 𝟙_ V ⟶ T) (X : EnrichedFunctorCat V I) (a : I) :
    component (pointMap p X) a = coefficientPoint p (X.toEnrichedFunctor.obj a) := by
  rw [pointMap, component_comp, scalarUnitIso_inv_component, scalarTensorMap_component]
  rfl

/-- The point commutes with every entire original enriched diagram map. -/
private theorem pointMap_naturality {T : V} (p : 𝟙_ V ⟶ T)
    {X Y : EnrichedFunctorCat V I} (f : X ⟶ Y) :
    pointMap p X ≫ tensorLeftMap T f = f ≫ pointMap p Y := by
  apply hom_ext
  intro a
  rw [component_comp, pointMap_component, tensorLeftMap_component,
    component_comp, pointMap_component]
  exact coefficientPoint_naturality p (component f a)

/-- The original scalar associator carries the coefficient point to the point of the whole
    scalar diagram. -/
private theorem scalarPoint_associator {T : V} (p : 𝟙_ V ⟶ T) (M : V)
    (Y : EnrichedFunctorCat V I) :
    scalarTensorMap (coefficientPoint p M) Y ≫ (scalarAssociatorIso T M Y).hom =
      pointMap p (tensorLeftObject M Y) := by
  apply hom_ext
  intro a
  rw [component_comp, scalarTensorMap_component, scalarAssociatorIso_hom_component,
    pointMap_component]
  exact coefficientPoint_associator p M (Y.toEnrichedFunctor.obj a)

/-- The full original scalar/free comparison retains every coefficient point on every original
    free source. -/
private theorem freePoint_scalarFree {T : V} (p : 𝟙_ V ⟶ T) (M : V) (a : I) :
    pointMap p (Free.object a M) ≫ (Free.scalarFreeIso T M a).hom =
      Free.coefficientMap a (coefficientPoint p M) := by
  apply hom_ext
  intro b
  rw [component_comp, pointMap_component, Free.scalarFreeIso_hom_component,
    Free.coefficientMap_component]
  exact coefficientPoint_inverse_associator p M (a ⟶[V] b)

/-- The inverse of the same whole scalar/free map carries the same exact coefficient point back. -/
private theorem freePoint_scalarFree_inverse {T : V} (p : 𝟙_ V ⟶ T) (M : V) (a : I) :
    Free.coefficientMap a (coefficientPoint p M) ≫ (Free.scalarFreeIso T M a).inv =
      pointMap p (Free.object a M) := by
  rw [← freePoint_scalarFree p M a]
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]

end EnrichedPoint










