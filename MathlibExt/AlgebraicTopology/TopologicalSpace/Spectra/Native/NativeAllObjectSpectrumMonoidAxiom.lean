attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

private theorem originalStructure (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : FiniteStructureSquare n M Y :=
  nativeFiniteOrbitStructure n M Y

/-- The actual native source is the original truncated scalar tail, including every original Hom action. -/
private def originalNativeSummandIso (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    nativeSummand n M Y label ≅
      truncatedShift n (firstAppearance n label)
        ((EnrichedFunctorCat.tensorLeft M).obj (underlyingSequential.obj Y)) :=
  nativeSummandIso n M Y (originalStructure n M Y) label

/-- The complete native source functor uses the actual original selected input maps. -/
private def originalNativeSummandFunctor (n : ℕ) (M : PointedCGWH.{u, v}) (label : StableOrbitIndex n) :
    PointedCGWH.SymmetricSpectrum.{u, v} ⥤ PointedCGWH.SequentialSpectrum.{u, v} :=
  nativeSummandFunctor n M label (originalStructure n M) (actualFiniteInputSquare n M)

/-- The whole source comparison is natural in the untouched original input spectrum. -/
private def originalNativeSummandNatIso (n : ℕ) (M : PointedCGWH.{u, v}) (label : StableOrbitIndex n) :
    originalNativeSummandFunctor n M label ≅
      underlyingSequential ⋙ EnrichedFunctorCat.tensorLeft M ⋙
        truncatedShiftFunctor n (firstAppearance n label) :=
  nativeSummandNatIso n M label (originalStructure n M) (actualFiniteInputSquare n M)

/-- Every forward source component is the original identity at its actual native source level. -/
private theorem originalNativeSummandIso_hom_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (originalNativeSummandIso n M Y label).hom r =
      𝟙 (nativeSummandLevel n M Y label r) :=
  nativeSummandIso_hom_levelMap n M Y (originalStructure n M Y) label r

/-- Every inverse source component retains that same original native source level. -/
private theorem originalNativeSummandIso_inv_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (originalNativeSummandIso n M Y label).inv r =
      𝟙 (nativeSummandLevel n M Y label r) :=
  nativeSummandIso_inv_levelMap n M Y (originalStructure n M Y) label r

/-- Every source input component is still its original native leg, input map and pointed projection. -/
private theorem originalNativeSummandFunctor_map_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap ((originalNativeSummandFunctor n M label).map f) r =
      nativeSummandInputLevel n M f label r :=
  nativeSummandFunctor_map_levelMap n M label (originalStructure n M) (actualFiniteInputSquare n M) f r

/-- The whole actual summand inclusion lands in the literal original free-smash restriction. -/
private def originalNativeSummandInclusion (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    nativeSummand n M Y label ⟶ originalFreeSmashRestriction n M Y :=
  nativeSummandInclusion n M Y (originalStructure n M Y) label

/-- Every inclusion component retains the original finite orbit leg and both original level casts. -/
private theorem originalNativeSummandInclusion_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (originalNativeSummandInclusion n M Y label) r =
      shiftedTailLegLevel n (firstAppearance n label) (scalarRestriction M Y)
        (originalFreeSmashRestriction n M Y) (activeNativeLegFamily n M Y label) r :=
  nativeSummandInclusion_levelMap n M Y (originalStructure n M Y) label r

/-- The actual original summand inclusion preserves all original enriched Hom weights. -/
private theorem originalNativeSummandInclusion_action (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n)
    (i j : PointedCGWH.Spectra.Sequential.Index.{u, v}) :
    PointedCGWH.SequentialSpectrum.action (nativeSummand n M Y label) i j ≫
      EnrichedFunctorCat.component (originalNativeSummandInclusion n M Y label) j =
    (EnrichedFunctorCat.component (originalNativeSummandInclusion n M Y label) i ⊗ₘ
      𝟙 (i ⟶[PointedCGWH.{u, v}] j)) ≫
      PointedCGWH.SequentialSpectrum.action (originalFreeSmashRestriction n M Y) i j :=
  nativeSummandInclusion_action n M Y (originalStructure n M Y) label i j

/-- The whole inclusion is natural in every complete original input arrow. -/
private def originalNativeSummandInclusionNatTrans (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) :
    originalNativeSummandFunctor n M label ⟶ originalFreeSmashRestrictionFunctor n M where
  app Y := originalNativeSummandInclusion n M Y label
  naturality {Y Z} f := nativeSummandInclusion_naturality n M
    (originalStructure n M Y) (originalStructure n M Z) f (actualFiniteInputSquare n M f) label

/-- Every integer comparison retains the actual native source and the whole original scalar target. -/
private def originalNativeIntegerIso (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    (integerStablePiFunctor q).obj (nativeSummand n M Y label) ≅
      (integerStablePiFunctor (q + (n : ℤ))).obj
        ((EnrichedFunctorCat.tensorLeft M).obj (underlyingSequential.obj Y)) :=
  nativeIntegerIso q n M Y (originalStructure n M Y) label

/-- The whole original integer comparison is natural in every actual source input map. -/
private def originalNativeIntegerNatIso (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) :
    originalNativeSummandFunctor n M label ⋙ integerStablePiFunctor q ≅
      underlyingSequential ⋙ EnrichedFunctorCat.tensorLeft M ⋙ integerStablePiFunctor (q + (n : ℤ)) :=
  nativeIntegerNatIso q n M label (originalStructure n M) (actualFiniteInputSquare n M)

/-- The original sphere coefficient stays inside the original scalar of the untouched input. -/
private def originalNativeSphereIntegerIso (q : ℤ) (n : ℕ)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    (integerStablePiFunctor q).obj
        (nativeSummand n (PointedCGWH.sphereSequence.functor.obj
          (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) Y label) ≅
      (integerStablePiFunctor (q + (n : ℤ))).obj
        ((EnrichedFunctorCat.tensorLeft (PointedCGWH.sphereSequence.functor.obj
          (CategoryTheory.Operad.SmallFinBijGroupoid.card n))).obj (underlyingSequential.obj Y)) :=
  originalNativeIntegerIso q n (PointedCGWH.sphereSequence.functor.obj
    (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) Y label

/-- Every complete forward arrow retains the original source Iso and original truncated-tail arrow. -/
private theorem originalNativeIntegerIso_hom (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    (originalNativeIntegerIso q n M Y label).hom =
      (integerStablePiFunctor q).map (originalNativeSummandIso n M Y label).hom ≫
        (comparisonIso q n (firstAppearance n label) (scalarRestriction M Y)).hom := rfl

/-- Every complete inverse arrow retains the original truncated-tail inverse and whole source inverse. -/
private theorem originalNativeIntegerIso_inv (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    (originalNativeIntegerIso q n M Y label).inv =
      (comparisonIso q n (firstAppearance n label) (scalarRestriction M Y)).inv ≫
        (integerStablePiFunctor q).map (originalNativeSummandIso n M Y label).inv := rfl

/-- All original source stages, including early stages, retain the same original forward transitions. -/
private theorem originalNativeIntegerIso_hom_leg_all (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) (r : ℕ) :
    integerStablePiLeg q (nativeSummand n M Y label) r ≫ (originalNativeIntegerIso q n M Y label).hom =
    ((integerDiagonalDiagramFunctor q).obj (nativeSummand n M Y label)).map
      (homOfLE (Nat.le_add_left r (sourceOffset q n (firstAppearance n label)))) ≫
      nativeIntegerStageHom q n M Y (originalStructure n M Y) label r ≫
        (stageIso q n (firstAppearance n label) (scalarRestriction M Y) r).hom ≫
          integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
            (targetOffset q (firstAppearance n label) + r) :=
  nativeIntegerIso_hom_leg_all q n M Y (originalStructure n M Y) label r

/-- All original target stages retain the same original inverse transitions and native source legs. -/
private theorem originalNativeIntegerIso_inv_leg_all (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) (r : ℕ) :
    integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y) r ≫
      (originalNativeIntegerIso q n M Y label).inv =
    ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj (scalarRestriction M Y)).map
      (homOfLE (Nat.le_add_left r (targetOffset q (firstAppearance n label)))) ≫
      (stageIso q n (firstAppearance n label) (scalarRestriction M Y) r).inv ≫
        nativeIntegerStageInv q n M Y (originalStructure n M Y) label r ≫
          integerStablePiLeg q (nativeSummand n M Y label) (sourceOffset q n (firstAppearance n label) + r) :=
  nativeIntegerIso_inv_leg_all q n M Y (originalStructure n M Y) label r

/-- The entire original forward integer square uses the actual complete source input arrow. -/
private theorem originalNativeIntegerIso_hom_naturality (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    (integerStablePiFunctor q).map ((originalNativeSummandFunctor n M label).map f) ≫
      (originalNativeIntegerIso q n M Z label).hom =
    (originalNativeIntegerIso q n M Y label).hom ≫
      (integerStablePiFunctor (q + (n : ℤ))).map
        ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) :=
  (originalNativeIntegerNatIso q n M label).hom.naturality f

/-- The entire original inverse integer square retains the same complete original input arrow. -/
private theorem originalNativeIntegerIso_inv_naturality (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    (integerStablePiFunctor (q + (n : ℤ))).map
        ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) ≫
      (originalNativeIntegerIso q n M Z label).inv =
    (originalNativeIntegerIso q n M Y label).inv ≫
      (integerStablePiFunctor q).map ((originalNativeSummandFunctor n M label).map f) :=
  (originalNativeIntegerNatIso q n M label).inv.naturality f

/-- The same original sphere coefficient gives the entire original all-integer source comparison family. -/
private def originalNativeSphereIntegerNatIso (q : ℤ) (n : ℕ) (label : StableOrbitIndex n) :
    originalNativeSummandFunctor.{u, v} n (PointedCGWH.sphereSequence.functor.obj
        (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) label ⋙ integerStablePiFunctor q ≅
      originalSphereScalarFunctor.{u, v} n ⋙ integerStablePiFunctor (q + (n : ℤ)) :=
  originalNativeIntegerNatIso q n (PointedCGWH.sphereSequence.functor.obj
    (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) label

/-- The whole original native sphere source hom retains the actual original scalar cutoff inclusion. -/
private theorem originalNativeSphereIntegerIso_hom_scalar_inclusion (q : ℤ) (n : ℕ)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (label : StableOrbitIndex n) :
    (originalNativeSphereIntegerIso q n Y label).hom =
      (integerStablePiFunctor q).map (originalNativeSummandIso n
        (PointedCGWH.sphereSequence.functor.obj (CategoryTheory.Operad.SmallFinBijGroupoid.card n))
        Y label).hom ≫
      (integerStablePiFunctor q).map
        (originalSphereScalarTailInclusion n (firstAppearance n label) Y) ≫
        (originalSphereScalarTailIntegerIso q n 0 Y).hom := by
  let M : PointedCGWH.{u, v} := PointedCGWH.sphereSequence.functor.obj
    (CategoryTheory.Operad.SmallFinBijGroupoid.card n)
  have h₁ := originalNativeIntegerIso_hom q n M Y label
  have h₂ := congrArg
    (fun f => (integerStablePiFunctor q).map (originalNativeSummandIso n M Y label).hom ≫ f)
    (comparisonInclusionSquare q n (firstAppearance n label) (scalarRestriction M Y)).symm
  exact h₁.trans h₂

/-- The actual source inclusion induces the same original integer input-arrow family in every degree. -/
private def originalNativeIntegerInclusionNatTrans (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) :
    originalNativeSummandFunctor n M label ⋙ integerStablePiFunctor q ⟶
      originalFreeSmashRestrictionFunctor n M ⋙ integerStablePiFunctor q :=
  Functor.whiskerRight (originalNativeSummandInclusionNatTrans n M label) (integerStablePiFunctor q)

/-- Every original integer inclusion component is the actual group map of the whole native inclusion. -/
private theorem originalNativeIntegerInclusionNatTrans_app (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (label : StableOrbitIndex n) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (originalNativeIntegerInclusionNatTrans q n M label).app Y =
      (integerStablePiFunctor q).map (originalNativeSummandInclusion n M Y label) := rfl

