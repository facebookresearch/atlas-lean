/-- The whole earned actual free/scalar functor isomorphism gives the same Arrow comparison
at both arbitrary caller endpoints, retaining both original maps and full input naturality. -/
private def originalFreeUnitScalarArrowIso (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    (K : PointedCGWH.{u, v}) {X Y : C.{u, v}} (f : X ⟶ Y) :
    Arrow.mk (Free.object a K ◁ f) ≅
      Arrow.mk ((EnrichedFunctorCat.tensorLeft K).map
        (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) := by
  let e := originalFreeScalarUnitSmashIso a K
  exact Arrow.isoMk (e.app X) (e.app Y) (e.hom.naturality f).symm

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

private abbrev W := NativeK.omegaTests (B := B) Actual.symmetricFamily.{u, v}

/-- CONDITIONAL POINTWISE transfer: the actual free-unit arrow's original Omega tests give
both actual Free(a,coefficient) boundary endpoint tests. No free-unit preservation theorem,
all-cofibrant preservation, or flatness outcome is asserted here. -/
private theorem originalFreeBoundary_endpointTests (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    {K M : PointedCGWH.{u, v}} (i : K ⟶ M) (hi : PointedCGWH.realizedBoundaryInclusions i)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    W (Free.object a K ◁ f) ∧ W (Free.object a M ◁ f) := by
  have hScalar := PointedCGWH.Spectra.OriginalNativeFiniteScalar.symmetricBoundaryFamily_omegaTests
    (B := B) i hi (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) hUnit
  exact ⟨(W.arrow_mk_iso_iff (originalFreeUnitScalarArrowIso a K f)).mpr hScalar.1,
    (W.arrow_mk_iso_iff (originalFreeUnitScalarArrowIso a M f)).mpr hScalar.2⟩

/-- The SAME actual free coefficient map is retained in its literal balanced-smash square,
alongside both pointwise endpoint tests. -/
private theorem originalFreeBoundary_endpointSquare (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    {K M : PointedCGWH.{u, v}} (i : K ⟶ M) (hi : PointedCGWH.realizedBoundaryInclusions i)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    (W (Free.object a K ◁ f) ∧ W (Free.object a M ◁ f)) ∧
      (Free.object a K ◁ f) ≫ (Free.coefficientMap a i ▷ Y) =
        (Free.coefficientMap a i ▷ X) ≫ (Free.object a M ◁ f) :=
  ⟨originalFreeBoundary_endpointTests (B := B) a i hi f hUnit,
    original_endpointTensor_square f (Free.coefficientMap a i)⟩

/-- Every caller ORIGINAL native levelI arrow receives the actual endpoint tests through
its WHOLE original Arrow equality. The honest unit input is pointwise at this SAME f and
at each actual original operator label; no all-cofibrant outcome is an input. -/
private theorem originalLevelI_endpointTests {A D : C.{u, v}} (g : A ⟶ D)
    (hg : NativeK.levelI (I := PointedCGWH.SymmetricOperatorIndex.{u, v}) g)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : ∀ a : PointedCGWH.SymmetricOperatorIndex.{u, v},
      W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    W (A ◁ f) ∧ W (D ◁ f) := by
  obtain ⟨q, hq⟩ := (MorphismProperty.adjointFamilyGenerators_iff
    (fun a : PointedCGWH.SymmetricOperatorIndex.{u, v} => Free.functor (V := PointedCGWH.{u, v}) a)
    PointedCGWH.realizedBoundaryInclusions g).mp hg
  have hFree := originalFreeBoundary_endpointTests (B := B) q.1 q.2.1.hom q.2.2 f (hUnit q.1)
  exact endpointTests_of_wholeArrow_eq W f g
    (Arrow.mk ((Free.functor q.1).map q.2.1.hom)) hq hFree

/-- The original caller levelI map, both original endpoints and its literal full tensor
square are retained together after the whole generator Arrow transport. -/
private theorem originalLevelI_endpointSquare {A D : C.{u, v}} (g : A ⟶ D)
    (hg : NativeK.levelI (I := PointedCGWH.SymmetricOperatorIndex.{u, v}) g)
    {X Y : C.{u, v}} (f : X ⟶ Y)
    (hUnit : ∀ a : PointedCGWH.SymmetricOperatorIndex.{u, v},
      W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) :
    (W (A ◁ f) ∧ W (D ◁ f)) ∧ (A ◁ f) ≫ (g ▷ Y) = (g ▷ X) ≫ (D ◁ f) :=
  ⟨originalLevelI_endpointTests (B := B) g hg f hUnit, original_endpointTensor_square f g⟩

/-- The same conditional pointwise free-unit premise and original free boundary endpoints
are read in the LITERAL original stable symmetric model's weak class. -/
private theorem originalStableFreeBoundary_endpointTests (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    {K M : PointedCGWH.{u, v}} (i : K ⟶ M) (hi : PointedCGWH.realizedBoundaryInclusions i)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    weakEquivalences C.{u, v} (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) →
      weakEquivalences C.{u, v} (Free.object a K ◁ f) ∧
        weakEquivalences C.{u, v} (Free.object a M ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  change weakEquivalences C.{u, v} _ → weakEquivalences C.{u, v} _ ∧ weakEquivalences C.{u, v} _
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1]
  exact originalFreeBoundary_endpointTests (B := B) a i hi f


/-- The LITERAL original stable model receives every caller native levelI endpoint test
from the explicit pointwise free-unit tests for the same f and all original operator labels. -/
private theorem originalStableLevelI_endpointTests {A D : C.{u, v}} (g : A ⟶ D)
    (hg : NativeK.levelI (I := PointedCGWH.SymmetricOperatorIndex.{u, v}) g)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    (∀ a : PointedCGWH.SymmetricOperatorIndex.{u, v},
      weakEquivalences C.{u, v} (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) →
      weakEquivalences C.{u, v} (A ◁ f) ∧ weakEquivalences C.{u, v} (D ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  change (∀ a : PointedCGWH.SymmetricOperatorIndex.{u, v}, weakEquivalences C.{u, v} _) →
    weakEquivalences C.{u, v} _ ∧ weakEquivalences C.{u, v} _
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1]
  exact originalLevelI_endpointTests (B := B) g hg f









