open scoped CGWH.limits






/-!
## Original sequential tails and integer stable homotopy

The truncated shift has the original level `X (r - n)` above `n + a` and
the selected initial pointed space below it. Its successor maps are the
original successor maps with their degree transports. The full enriched
functor is obtained from the original ordered tensor-power presentation.

The integer comparison uses two cofinal tails of the original changing
degree and level diagonals. It retains both group quotient arrows, every
original level cast, the complete tail inclusion and input naturality.
-/

set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.OriginalSequentialTailIntegerPi

open CategoryTheory.SequentialSpectrum.EnrichedPresentation
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open PointedCGWH.SequentialSpectrum.HomotopyStructureGeometry
open GrpCat.FilteredColimits.OriginalNatTailGeometry
open CategoryTheory.NatTail (tailFunctor)

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The actual original level above the cutoff, and the selected initial level below it. -/
private def truncatedLevel (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    PointedCGWH.{u, v} :=
  if n + a ≤ r then X.level (r - n) else ⊥_ PointedCGWH.{u, v}

/-- Every retained level is the original level with the exact subtraction index. -/
private theorem truncatedLevel_above (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : n + a ≤ r) : truncatedLevel n a X r = X.level (r - n) :=
  ite_eq_left h

/-- Every level below the cutoff is the original selected initial pointed space. -/
private theorem truncatedLevel_below (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : r < n + a) : truncatedLevel n a X r = ⊥_ PointedCGWH.{u, v} :=
  ite_eq_right (Nat.not_le_of_gt h)

/-- The original left successor map, including the exact source and target level casts. -/
private def truncatedStructureMap (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    PointedCGWH.sphereOne ⊗ truncatedLevel n a X r ⟶ truncatedLevel n a X (r + 1) := by
  by_cases h : n + a ≤ r
  · exact eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
      (truncatedLevel_above n a X r h)) ≫ X.structureMap (r - n) ≫
      eqToHom ((congrArg X.level (show r - n + 1 = r + 1 - n by omega)).trans
        (truncatedLevel_above n a X (r + 1) (by omega)).symm)
  · exact eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
      (truncatedLevel_below n a X r (Nat.lt_of_not_ge h))) ≫
      (MonoidalCategory.tensorInitialLeft PointedCGWH.sphereOne).to
        (truncatedLevel n a X (r + 1))

/-- The genuine original left-structure spectrum used by the enriched presentation. -/
private def rawTruncatedShift (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    CategoryTheory.SequentialSpectrum PointedCGWH.{u, v} PointedCGWH.sphereOne where
  level := truncatedLevel n a X
  structureMap := truncatedStructureMap n a X

/-- The native sequential object retains the full original tensor-power Hom actions. -/
private def truncatedShift (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    PointedCGWH.SequentialSpectrum.{u, v} :=
  toEnrichedFunctor PointedCGWH.sphereOne (rawTruncatedShift n a X)

/-- The native enriched object has precisely the requested original level function. -/
private theorem truncatedShift_level (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (truncatedShift n a X).level r = truncatedLevel n a X r := rfl

/-- The full retained native level is the exact original level above the cutoff. -/
private theorem truncatedShift_level_above (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : n + a ≤ r) : (truncatedShift n a X).level r = X.level (r - n) :=
  truncatedLevel_above n a X r h

/-- The full native lower level is the actual selected initial pointed space. -/
private theorem truncatedShift_level_below (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : r < n + a) : (truncatedShift n a X).level r = ⊥_ PointedCGWH.{u, v} :=
  truncatedLevel_below n a X r h

/-- Both actual arrows of the retained level identification are the original equality casts. -/
private def levelIso (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ)
    (h : n + a ≤ r) : (truncatedShift n a X).level r ≅ X.level (r - n) :=
  eqToIso (truncatedShift_level_above n a X r h)

/-- The original presentation recovers exactly the specified left successor map. -/
private theorem truncatedShift_structureMap (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (truncatedShift n a X).structureMap r = truncatedStructureMap n a X r :=
  from_to_structureMap PointedCGWH.sphereOne (rawTruncatedShift n a X) r

/-- Above the cutoff the entire original structure map and all endpoint casts are retained. -/
private theorem truncatedShift_structureMap_above (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : n + a ≤ r) :
    (truncatedShift n a X).structureMap r =
      eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
        (truncatedShift_level_above n a X r h)) ≫ X.structureMap (r - n) ≫
        eqToHom ((congrArg X.level (show r - n + 1 = r + 1 - n by omega)).trans
          (truncatedShift_level_above n a X (r + 1) (by omega)).symm) := by
  rw [truncatedShift_structureMap]
  simp only [truncatedStructureMap, dite_eq_left h]
  rfl

/-- Below the cutoff the actual successor map is the unique tensor-initial source map. -/
private theorem truncatedShift_structureMap_below (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : r < n + a) :
    (truncatedShift n a X).structureMap r =
      eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
        (truncatedShift_level_below n a X r h)) ≫
        (MonoidalCategory.tensorInitialLeft PointedCGWH.sphereOne).to
          ((truncatedShift n a X).level (r + 1)) := by
  rw [truncatedShift_structureMap]
  simp only [truncatedStructureMap, dite_eq_right (Nat.not_le_of_gt h)]
  rfl

/-- Every full Hom-object action is the actual original ordered action of the left spectrum. -/
private theorem truncatedShift_action (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (i j : PointedCGWH.Spectra.Sequential.Index.{u, v}) :
    PointedCGWH.SequentialSpectrum.action (truncatedShift n a X) i j =
      spectrumAction (rawTruncatedShift n a X) i j :=
  toEnrichedFunctor_uncurry_map PointedCGWH.sphereOne (rawTruncatedShift n a X) i j

/-- Original input level maps, with the complete source and target subtraction casts. -/
private def truncatedLevelMap (n a : ℕ) {X Y : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) (r : ℕ) : truncatedLevel n a X r ⟶ truncatedLevel n a Y r := by
  by_cases h : n + a ≤ r
  · exact eqToHom (truncatedLevel_above n a X r h) ≫
      PointedCGWH.SequentialSpectrum.levelMap f (r - n) ≫
      eqToHom (truncatedLevel_above n a Y r h).symm
  · exact eqToHom (truncatedLevel_below n a X r (Nat.lt_of_not_ge h)) ≫
      initial.to (truncatedLevel n a Y r)

/-- Every retained input component is the original component with both endpoint casts. -/
private theorem truncatedLevelMap_above (n a : ℕ) {X Y : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) (r : ℕ) (h : n + a ≤ r) :
    truncatedLevelMap n a f r = eqToHom (truncatedLevel_above n a X r h) ≫
      PointedCGWH.SequentialSpectrum.levelMap f (r - n) ≫
      eqToHom (truncatedLevel_above n a Y r h).symm := by
  simp only [truncatedLevelMap, dite_eq_left h]

/-- Original component naturality supplies a morphism of the original left spectra. -/
private def rawTruncatedShiftMap (n a : ℕ) {X Y : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) : rawTruncatedShift n a X ⟶ rawTruncatedShift n a Y where
  levelMap := truncatedLevelMap n a f
  naturality r := by
    by_cases h : n + a ≤ r
    · have h' : n + a ≤ r + 1 := by omega
      dsimp only [rawTruncatedShift]
      apply (cancel_epi (eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
        (truncatedLevel_above n a X r h).symm))).mp
      apply (cancel_mono (eqToHom (truncatedLevel_above n a Y (r + 1) h'))).mp
      simp only [truncatedLevelMap, truncatedStructureMap, dite_eq_left h, dite_eq_left h',
        whiskerLeft_comp, whiskerLeft_eqToHom, Category.assoc, eqToHom_trans_assoc,
        eqToHom_trans, eqToHom_refl, Category.id_comp, Category.comp_id]
      slice_lhs 1 2 => rw [PointedCGWH.SequentialSpectrum.structureMap_naturality]
      simp only [Category.assoc]
      rw [eqToHom_naturality (fun s => PointedCGWH.SequentialSpectrum.levelMap f s)
        (show r - n + 1 = r + 1 - n by omega)]
    · have hInitial : IsInitial (PointedCGWH.sphereOne ⊗ truncatedLevel n a X r) := by
        rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
        exact MonoidalCategory.tensorInitialLeft _
      exact hInitial.hom_ext _ _

/-- The complete native input arrow retains full enriched naturality. -/
private def truncatedShiftMap (n a : ℕ) {X Y : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) : truncatedShift n a X ⟶ truncatedShift n a Y :=
  toEnrichedFunctorMap PointedCGWH.sphereOne (rawTruncatedShiftMap n a f)

/-- Every complete native input component is the original retained component. -/
private theorem truncatedShiftMap_levelMap (n a : ℕ) {X Y : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (truncatedShiftMap n a f) r =
      truncatedLevelMap n a f r :=
  toEnrichedFunctorMap_component PointedCGWH.sphereOne (rawTruncatedShiftMap n a f)
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r)

/-- The original truncated shift preserves identities and compositions on all full native arrows. -/
private def truncatedShiftFunctor (n a : ℕ) :
    PointedCGWH.SequentialSpectrum.{u, v} ⥤ PointedCGWH.SequentialSpectrum.{u, v} where
  obj := truncatedShift n a
  map := truncatedShiftMap n a
  map_id X := by
    apply PointedCGWH.SequentialSpectrum.hom_ext
    intro r
    rw [truncatedShiftMap_levelMap, PointedCGWH.SequentialSpectrum.levelMap_id]
    by_cases h : n + a ≤ r
    · simp only [truncatedLevelMap, dite_eq_left h, PointedCGWH.SequentialSpectrum.levelMap_id,
        Category.id_comp, eqToHom_trans, eqToHom_refl]
      rfl
    · have hInitial : IsInitial (truncatedLevel n a X r) := by
        rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
        exact initialIsInitial
      exact hInitial.hom_ext _ _
  map_comp {X Y Z} f g := by
    apply PointedCGWH.SequentialSpectrum.hom_ext
    intro r
    rw [truncatedShiftMap_levelMap, PointedCGWH.SequentialSpectrum.levelMap_comp,
      truncatedShiftMap_levelMap, truncatedShiftMap_levelMap]
    change truncatedLevelMap n a (f ≫ g) r = truncatedLevelMap n a f r ≫ truncatedLevelMap n a g r
    by_cases h : n + a ≤ r
    · apply (cancel_epi (eqToHom (truncatedLevel_above n a X r h).symm)).mp
      apply (cancel_mono (eqToHom (truncatedLevel_above n a Z r h))).mp
      simp only [truncatedLevelMap, dite_eq_left h, PointedCGWH.SequentialSpectrum.levelMap_comp,
        Category.assoc, eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl,
        Category.id_comp, Category.comp_id]
    · have hInitial : IsInitial (truncatedLevel n a X r) := by
        rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
        exact initialIsInitial
      exact hInitial.hom_ext _ _

/-- The inclusion is the identity on the whole original retained tail. -/
private def tailInclusionLevel (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    truncatedLevel n a X r ⟶ truncatedLevel n 0 X r := by
  by_cases h : n + a ≤ r
  · exact eqToHom (truncatedLevel_above n a X r h) ≫
      eqToHom (truncatedLevel_above n 0 X r (by omega)).symm
  · exact eqToHom (truncatedLevel_below n a X r (Nat.lt_of_not_ge h)) ≫
      initial.to (truncatedLevel n 0 X r)

/-- Every upper component of the whole inclusion is precisely the original identity cast. -/
private theorem tailInclusionLevel_above (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : n + a ≤ r) :
    tailInclusionLevel n a X r = eqToHom (truncatedLevel_above n a X r h) ≫
      eqToHom (truncatedLevel_above n 0 X r (by omega)).symm := by
  simp only [tailInclusionLevel, dite_eq_left h]

/-- The original successor squares define the actual identity-tail inclusion. -/
private def rawTailInclusion (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    rawTruncatedShift n a X ⟶ rawTruncatedShift n 0 X where
  levelMap := tailInclusionLevel n a X
  naturality r := by
    by_cases h : n + a ≤ r
    · have hn : n + 0 ≤ r := by omega
      have ha' : n + a ≤ r + 1 := by omega
      have hn' : n + 0 ≤ r + 1 := by omega
      dsimp only [rawTruncatedShift]
      apply (cancel_epi (eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
        (truncatedLevel_above n a X r h).symm))).mp
      apply (cancel_mono (eqToHom (truncatedLevel_above n 0 X (r + 1) hn'))).mp
      simp only [tailInclusionLevel, truncatedStructureMap, dite_eq_left h,
        dite_eq_left hn, dite_eq_left ha', whiskerLeft_eqToHom, Category.assoc,
        eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl, Category.id_comp]
    · have hInitial : IsInitial (PointedCGWH.sphereOne ⊗ truncatedLevel n a X r) := by
        rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
        exact MonoidalCategory.tensorInitialLeft _
      exact hInitial.hom_ext _ _

/-- The whole identity-tail inclusion is a genuine full enriched native spectrum morphism. -/
private def tailInclusion (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    truncatedShift n a X ⟶ truncatedShift n 0 X :=
  toEnrichedFunctorMap PointedCGWH.sphereOne (rawTailInclusion n a X)

/-- Every full enriched inclusion component is the original upper identity or lower initial map. -/
private theorem tailInclusion_levelMap (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (tailInclusion n a X) r =
      tailInclusionLevel n a X r :=
  toEnrichedFunctorMap_component PointedCGWH.sphereOne (rawTailInclusion n a X)
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r)

/-- The upper components of the actual whole inclusion are isomorphisms with both identity casts. -/
private theorem tailInclusion_levelMap_isIso (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (r : ℕ) (h : n + a ≤ r) :
    IsIso (PointedCGWH.SequentialSpectrum.levelMap (tailInclusion n a X) r) := by
  rw [tailInclusion_levelMap, tailInclusionLevel_above n a X r h]
  exact ((eqToIso (truncatedLevel_above n a X r h)) ≪≫
    (eqToIso (truncatedLevel_above n 0 X r (by omega))).symm).isIso_hom

/-- Every original input map commutes with the complete identity-tail inclusion. -/
private theorem tailInclusion_naturality (n a : ℕ) {X Y : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) :
    truncatedShiftMap n a f ≫ tailInclusion n a Y =
      tailInclusion n a X ≫ truncatedShiftMap n 0 f := by
  apply PointedCGWH.SequentialSpectrum.hom_ext
  intro r
  rw [PointedCGWH.SequentialSpectrum.levelMap_comp,
    PointedCGWH.SequentialSpectrum.levelMap_comp, truncatedShiftMap_levelMap,
    truncatedShiftMap_levelMap, tailInclusion_levelMap, tailInclusion_levelMap]
  change truncatedLevelMap n a f r ≫ tailInclusionLevel n a Y r =
    tailInclusionLevel n a X r ≫ truncatedLevelMap n 0 f r
  by_cases h : n + a ≤ r
  · have hn : n + 0 ≤ r := by omega
    apply (cancel_epi (eqToHom (truncatedLevel_above n a X r h).symm)).mp
    apply (cancel_mono (eqToHom (truncatedLevel_above n 0 Y r hn))).mp
    simp only [truncatedLevelMap, tailInclusionLevel, dite_eq_left h, dite_eq_left hn,
      Category.assoc, eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl,
      Category.id_comp, Category.comp_id]
  · have hInitial : IsInitial (truncatedLevel n a X r) := by
      rw [truncatedLevel_below n a X r (Nat.lt_of_not_ge h)]
      exact initialIsInitial
    exact hInitial.hom_ext _ _

/-- The entire identity-tail inclusion is natural on the original native spectrum category. -/
private def tailInclusionNatTrans (n a : ℕ) :
    truncatedShiftFunctor.{u, v} n a ⟶ truncatedShiftFunctor n 0 where
  app := tailInclusion n a
  naturality {X Y} f := tailInclusion_naturality (X := X) (Y := Y) n a f

private theorem rawSpectrum_ext
    (X Y : CategoryTheory.SequentialSpectrum PointedCGWH.{u, v} PointedCGWH.sphereOne)
    (hLevel : X.level = Y.level) (hStructure : ∀ r, X.structureMap r ≍ Y.structureMap r) : X = Y := by
  cases X with
  | mk levels sigma =>
    cases Y with
    | mk levels' sigma' =>
      change levels = levels' at hLevel
      cases hLevel
      congr 1
      funext r
      exact eq_of_heq (hStructure r)

/-- At zero shift and zero cutoff the original left spectrum itself is recovered. -/
private theorem rawTruncatedShift_zero_zero (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    rawTruncatedShift 0 0 X = fromEnrichedFunctor PointedCGWH.sphereOne X := by
  apply rawSpectrum_ext
  · funext r
    simp only [rawTruncatedShift, truncatedLevel, Nat.zero_add, Nat.zero_le,
      ite_true, Nat.sub_zero]
    rfl
  · intro r
    simp only [rawTruncatedShift, truncatedStructureMap, Nat.zero_add, Nat.zero_le,
      dite_true, truncatedLevel, Nat.sub_zero]
    rfl

/-- The zero shift with zero cutoff is the actual original full enriched spectrum object. -/
private theorem truncatedShift_zero_zero (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    truncatedShift 0 0 X = X :=
  (congrArg (toEnrichedFunctor PointedCGWH.sphereOne) (rawTruncatedShift_zero_zero X)).trans
    (to_from PointedCGWH.sphereOne X)

private theorem groupStructure_square
    (X Y : PointedCGWH.SequentialSpectrum.{u, v}) (i j k : ℕ)
    (c : X.level i ⟶ Y.level j) (d : X.level (i + 1) ⟶ Y.level (j + 1))
    (h : (PointedCGWH.sphereOne ◁ c) ≫ Y.structureMap j = X.structureMap i ≫ d) :
    (PointedCGWH.piNPositiveFunctor k).map c ≫ (groupStructureNatTrans j k).app Y =
      (groupStructureNatTrans i k).app X ≫ (PointedCGWH.piNPositiveFunctor (k + 1)).map d := by
  have hc : c ≫ Y.adjointStructureMap j =
      X.adjointStructureMap i ≫ PointedCGWH.loop.map d := by
    change c ≫ MonoidalClosed.curry (Y.structureMap j) =
      MonoidalClosed.curry (X.structureMap i) ≫ (ihom PointedCGWH.sphereOne).map d
    rw [← MonoidalClosed.curry_natural_left, ← MonoidalClosed.curry_natural_right, h]
  let P := PointedCGWH.piNPositiveFunctor k
  let t := PointedCGWH.NativeLoopShiftGeometry.nativeLoopGroupShiftNatIso k
  have hm : P.map c ≫ P.map (Y.adjointStructureMap j) =
      P.map (X.adjointStructureMap i) ≫ P.map (PointedCGWH.loop.map d) :=
    (P.map_comp c (Y.adjointStructureMap j)).symm.trans
      ((P.congr_map hc).trans (P.map_comp (X.adjointStructureMap i) (PointedCGWH.loop.map d)))
  have ht := t.hom.naturality d
  change P.map c ≫ (P.map (Y.adjointStructureMap j) ≫ t.hom.app (Y.level (j + 1))) =
    (P.map (X.adjointStructureMap i) ≫ t.hom.app (X.level (i + 1))) ≫
      (PointedCGWH.piNPositiveFunctor (k + 1)).map d
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (fun f => f ≫ t.hom.app (Y.level (j + 1))) hm).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (fun f => P.map (X.adjointStructureMap i) ≫ f) ht).trans
          (Category.assoc _ _ _).symm)))

/-- Both original positive homotopy arrows retain the actual level and degree casts. -/
private def groupCastIso (k l : ℕ) (h : k = l) {A B : PointedCGWH.{u, v}} (e : A ≅ B) :
    (PointedCGWH.piNPositiveFunctor k).obj A ≅ (PointedCGWH.piNPositiveFunctor l).obj B :=
  (PointedCGWH.piNPositiveFunctor k).mapIso e ≪≫
    (eqToIso (congrArg PointedCGWH.piNPositiveFunctor h)).app B

private theorem groupCastIso_naturality (k l : ℕ) (h : k = l)
    {A B C D : PointedCGWH.{u, v}} (e : A ≅ C) (e' : B ≅ D)
    (f : A ⟶ B) (g : C ⟶ D) (hf : f ≫ e'.hom = e.hom ≫ g) :
    (PointedCGWH.piNPositiveFunctor k).map f ≫ (groupCastIso k l h e').hom =
      (groupCastIso k l h e).hom ≫ (PointedCGWH.piNPositiveFunctor l).map g := by
  cases h
  simp only [groupCastIso, Iso.trans_hom, Functor.mapIso_hom, eqToIso_refl,
    Iso.app_hom, Iso.refl_hom, NatTrans.id_app, Category.comp_id]
  rw [← Functor.map_comp, ← Functor.map_comp, hf]

private theorem groupCastIso_structure_square
    (X Y : PointedCGWH.SequentialSpectrum.{u, v}) (i j k l : ℕ) (hk : k = l)
    (e : X.level i ≅ Y.level j) (e' : X.level (i + 1) ≅ Y.level (j + 1))
    (h : (PointedCGWH.sphereOne ◁ e.hom) ≫ Y.structureMap j = X.structureMap i ≫ e'.hom) :
    (groupStructureNatTrans i k).app X ≫
        (groupCastIso (k + 1) (l + 1) (congrArg (fun t => t + 1) hk) e').hom =
      (groupCastIso k l hk e).hom ≫ (groupStructureNatTrans j l).app Y := by
  cases hk
  simp only [groupCastIso, Iso.trans_hom, Functor.mapIso_hom, eqToIso_refl,
    Iso.app_hom, Iso.refl_hom, NatTrans.id_app, Category.comp_id]
  exact (groupStructure_square X Y i j k e.hom e'.hom h).symm

/-- A cofinal source offset reaches the requested original tail in every integer degree. -/
private def sourceOffset (q : ℤ) (n a : ℕ) : ℕ := n + a + integerTailLevel (q + (n : ℤ))

/-- The target offset reaches exactly the same original level and homotopy degree. -/
private def targetOffset (q : ℤ) (a : ℕ) : ℕ := a + integerTailLevel q

/-- The actual source level in the retained integer diagonal tail. -/
private def sourceLevel (q : ℤ) (n a r : ℕ) : ℕ := integerTailLevel q + (sourceOffset q n a + r)

/-- The same actual original level in the target integer diagonal tail. -/
private def targetLevel (q : ℤ) (n a r : ℕ) : ℕ :=
  integerTailLevel (q + (n : ℤ)) + (targetOffset q a + r)

/-- The actual positive homotopy index of the source original diagonal. -/
private def sourcePositiveIndex (q : ℤ) (n a r : ℕ) : ℕ :=
  integerTailPositiveIndex q + (sourceOffset q n a + r)

/-- The actual positive homotopy index of the target original diagonal. -/
private def targetPositiveIndex (q : ℤ) (n a r : ℕ) : ℕ :=
  integerTailPositiveIndex (q + (n : ℤ)) + (targetOffset q a + r)

/-- Every cofinal source stage lies in the actual retained original tail. -/
private theorem sourceLevel_above (q : ℤ) (n a r : ℕ) : n + a ≤ sourceLevel q n a r := by
  dsimp only [sourceLevel, sourceOffset]
  omega

/-- Both cofinal levels are the same original level after the exact shift subtraction. -/
private theorem commonLevel (q : ℤ) (n a r : ℕ) :
    sourceLevel q n a r - n = targetLevel q n a r := by
  dsimp only [sourceLevel, targetLevel, sourceOffset, targetOffset]
  omega

/-- Both positive group indexes coincide without discarding any negative integer degree. -/
private theorem commonPositiveIndex (q : ℤ) (n a r : ℕ) :
    sourcePositiveIndex q n a r = targetPositiveIndex q n a r := by
  have hq := integerTail_degree q 0
  have hn := integerTail_degree (q + (n : ℤ)) 0
  dsimp only [sourcePositiveIndex, targetPositiveIndex, sourceOffset, targetOffset]
  omega

/-- The source group retains exactly degree `q`, including every negative integer. -/
private theorem source_degree (q : ℤ) (n a r : ℕ) :
    ((sourcePositiveIndex q n a r + 1 : ℕ) : ℤ) - (sourceLevel q n a r : ℤ) = q :=
  integerTail_degree q (sourceOffset q n a + r)

/-- The original target group retains exactly degree `q + n`. -/
private theorem target_degree (q : ℤ) (n a r : ℕ) :
    ((targetPositiveIndex q n a r + 1 : ℕ) : ℤ) - (targetLevel q n a r : ℤ) = q + (n : ℤ) :=
  integerTail_degree (q + (n : ℤ)) (targetOffset q a + r)

/-- Both whole level arrows are the original retained level and arithmetic identity casts. -/
private def stageLevelIso (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (truncatedShift n a X).level (sourceLevel q n a r) ≅ X.level (targetLevel q n a r) :=
  levelIso n a X (sourceLevel q n a r) (sourceLevel_above q n a r) ≪≫
    eqToIso (congrArg X.level (commonLevel q n a r))

/-- The entire original source diagonal with its actual cofinal offset. -/
private def sourceTailDiagramFunctor (q : ℤ) (n a : ℕ) :
    PointedCGWH.SequentialSpectrum.{u, v} ⥤ (ℕ ⥤ GrpCat.{v}) :=
  truncatedShiftFunctor n a ⋙ integerDiagonalDiagramFunctor q ⋙ tailDiagramFunctor (sourceOffset q n a)

/-- The entire original target diagonal with its actual cofinal offset. -/
private def targetTailDiagramFunctor (q : ℤ) (n a : ℕ) :
    PointedCGWH.SequentialSpectrum.{u, v} ⥤ (ℕ ⥤ GrpCat.{v}) :=
  integerDiagonalDiagramFunctor (q + (n : ℤ)) ⋙ tailDiagramFunctor (targetOffset q a)

/-- Every retained source tail object is the exact original level group. -/
private theorem sourceTailDiagramFunctor_obj (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((sourceTailDiagramFunctor q n a).obj X).obj r =
      (PointedCGWH.piNPositiveFunctor (sourcePositiveIndex q n a r)).obj
        ((truncatedShift n a X).level (sourceLevel q n a r)) := rfl

/-- Every target tail object is the same exact original shifted integer level group. -/
private theorem targetTailDiagramFunctor_obj (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((targetTailDiagramFunctor q n a).obj X).obj r =
      (PointedCGWH.piNPositiveFunctor (targetPositiveIndex q n a r)).obj
        (X.level (targetLevel q n a r)) := rfl

/-- Both full original group-stage arrows use the actual level and positive-index casts. -/
private def stageIso (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((sourceTailDiagramFunctor q n a).obj X).obj r ≅
      ((targetTailDiagramFunctor q n a).obj X).obj r :=
  groupCastIso (sourcePositiveIndex q n a r) (targetPositiveIndex q n a r)
    (commonPositiveIndex q n a r) (stageLevelIso q n a X r)

/-- The complete forward original stage arrow retains both exact source casts. -/
private theorem stageIso_hom (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (stageIso q n a X r).hom =
      (PointedCGWH.piNPositiveFunctor (sourcePositiveIndex q n a r)).map
        (stageLevelIso q n a X r).hom ≫
        (eqToIso (congrArg PointedCGWH.piNPositiveFunctor (commonPositiveIndex q n a r))).hom.app
          (X.level (targetLevel q n a r)) := rfl

/-- The complete inverse original stage arrow retains both inverse source casts. -/
private theorem stageIso_inv (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (stageIso q n a X r).inv =
      (eqToIso (congrArg PointedCGWH.piNPositiveFunctor (commonPositiveIndex q n a r))).inv.app
        (X.level (targetLevel q n a r)) ≫
      (PointedCGWH.piNPositiveFunctor (sourcePositiveIndex q n a r)).map
        (stageLevelIso q n a X r).inv := rfl

private theorem stageLevelIso_naturality (q : ℤ) (n a : ℕ)
    {X Y : PointedCGWH.SequentialSpectrum.{u, v}} (f : X ⟶ Y) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (truncatedShiftMap n a f) (sourceLevel q n a r) ≫
        (stageLevelIso q n a Y r).hom =
      (stageLevelIso q n a X r).hom ≫
        PointedCGWH.SequentialSpectrum.levelMap f (targetLevel q n a r) := by
  rw [truncatedShiftMap_levelMap]
  change truncatedLevelMap n a f (sourceLevel q n a r) ≫
      (eqToHom (truncatedLevel_above n a Y _ (sourceLevel_above q n a r)) ≫
        eqToHom (congrArg Y.level (commonLevel q n a r))) =
    (eqToHom (truncatedLevel_above n a X _ (sourceLevel_above q n a r)) ≫
      eqToHom (congrArg X.level (commonLevel q n a r))) ≫
        PointedCGWH.SequentialSpectrum.levelMap f (targetLevel q n a r)
  apply (cancel_epi (eqToHom (truncatedLevel_above n a X _ (sourceLevel_above q n a r)).symm)).mp
  simp only [truncatedLevelMap, dite_eq_left (sourceLevel_above q n a r),
    Category.assoc, eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl, Category.id_comp]
  exact eqToHom_naturality (fun s => PointedCGWH.SequentialSpectrum.levelMap f s) (commonLevel q n a r)

private theorem cast_structure_square
    {C : Type u} [Category.{v} C] [MonoidalCategory C] (K : C)
    {A A' B B' D D' : C} (hA : A = B) (hA' : A' = B') (hB : B = D) (hB' : B' = D')
    (s : K ⊗ B ⟶ B') (t : K ⊗ D ⟶ D')
    (h : (K ◁ eqToHom hB) ≫ t = s ≫ eqToHom hB') :
    (K ◁ (eqToHom hA ≫ eqToHom hB)) ≫ t =
      (eqToHom (congrArg (fun Z => K ⊗ Z) hA) ≫ s ≫ eqToHom hA'.symm) ≫
        (eqToHom hA' ≫ eqToHom hB') := by
  cases hA
  cases hA'
  simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
  exact h

private theorem stageLevelIso_structure (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (PointedCGWH.sphereOne ◁ (stageLevelIso q n a X r).hom) ≫
        X.structureMap (targetLevel q n a r) =
      (truncatedShift n a X).structureMap (sourceLevel q n a r) ≫
        (stageLevelIso q n a X (r + 1)).hom := by
  let hA := truncatedLevel_above n a X _ (sourceLevel_above q n a r)
  have hA' : truncatedLevel n a X (sourceLevel q n a r + 1) =
      X.level (sourceLevel q n a r - n + 1) :=
    (truncatedLevel_above n a X _ (by have h := sourceLevel_above q n a r; omega)).trans
      (congrArg X.level (by have h := sourceLevel_above q n a r; omega))
  let hB := congrArg X.level (commonLevel q n a r)
  let hB' := congrArg X.level (congrArg (fun s => s + 1) (commonLevel q n a r))
  have hNext : (stageLevelIso q n a X (r + 1)).hom = eqToHom hA' ≫ eqToHom hB' := by
    simp only [stageLevelIso, levelIso, Iso.trans_hom, eqToIso.hom, eqToHom_trans]
    rfl
  rw [hNext, truncatedShift_structureMap_above n a X _ (sourceLevel_above q n a r)]
  change (PointedCGWH.sphereOne ◁ (eqToHom hA ≫ eqToHom hB)) ≫
      X.structureMap (targetLevel q n a r) =
    (eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z) hA) ≫
      X.structureMap (sourceLevel q n a r - n) ≫ eqToHom hA'.symm) ≫
        (eqToHom hA' ≫ eqToHom hB')
  exact cast_structure_square PointedCGWH.sphereOne hA hA' hB hB'
    (X.structureMap (sourceLevel q n a r - n)) (X.structureMap (targetLevel q n a r))
    ((congrArg (fun g => g ≫ X.structureMap (targetLevel q n a r))
      (whiskerLeft_eqToHom PointedCGWH.sphereOne hB)).trans
        (eqToHom_naturality (fun s => X.structureMap s) (commonLevel q n a r)).symm)

private theorem diagonalTransition_eq_structure (m k r : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (diagonalTransition r m k).app X = (groupStructureNatTrans (m + r) (k + r)).app X := by
  dsimp only [diagonalTransition,
    PointedCGWH.SequentialSpectrum.OrderedLoop.GroupUnitCoherenceGeometry.groupUnitIndexNatIso,
    PointedCGWH.SequentialSpectrum.OrderedLoop.GroupUnitCoherenceGeometry.groupPrefixIndexNatIso,
    PointedCGWH.SequentialSpectrum.OrderedLoop.GroupUnitCoherenceGeometry.levelUnitIndexNatIso]
  simp only [eqToIso_refl, Functor.isoWhiskerLeft_refl, Functor.isoWhiskerRight_refl,
    Iso.trans_refl, Iso.refl_hom]
  exact congrArg (fun f => f.app X) (Category.comp_id (groupStructureNatTrans (m + r) (k + r)))

private theorem sourceTail_map_succ (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((sourceTailDiagramFunctor q n a).obj X).map (homOfLE (Nat.le_succ r)) =
      (groupStructureNatTrans (sourceLevel q n a r) (sourcePositiveIndex q n a r)).app
        (truncatedShift n a X) := by
  change (diagonalDiagram (truncatedShift n a X) (integerTailLevel q)
    (integerTailPositiveIndex q)).map (homOfLE (Nat.le_succ (sourceOffset q n a + r))) = _
  rw [diagonalDiagram_map_succ, diagonalTransition_eq_structure]
  rfl

private theorem targetTail_map_succ (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((targetTailDiagramFunctor q n a).obj X).map (homOfLE (Nat.le_succ r)) =
      (groupStructureNatTrans (targetLevel q n a r) (targetPositiveIndex q n a r)).app X := by
  change (diagonalDiagram X (integerTailLevel (q + (n : ℤ)))
    (integerTailPositiveIndex (q + (n : ℤ)))).map
      (homOfLE (Nat.le_succ (targetOffset q a + r))) = _
  rw [diagonalDiagram_map_succ, diagonalTransition_eq_structure]
  rfl

/-- The source and target original successor maps commute with both complete stage casts. -/
private theorem stageIso_successor_square (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    ((sourceTailDiagramFunctor q n a).obj X).map (homOfLE (Nat.le_succ r)) ≫
        (stageIso q n a X (r + 1)).hom =
      (stageIso q n a X r).hom ≫
        ((targetTailDiagramFunctor q n a).obj X).map (homOfLE (Nat.le_succ r)) := by
  rw [sourceTail_map_succ, targetTail_map_succ]
  exact groupCastIso_structure_square (truncatedShift n a X) X
    (sourceLevel q n a r) (targetLevel q n a r)
    (sourcePositiveIndex q n a r) (targetPositiveIndex q n a r)
    (commonPositiveIndex q n a r) (stageLevelIso q n a X r)
    (stageLevelIso q n a X (r + 1)) (stageLevelIso_structure q n a X r)

/-- Actual original successor naturality constructs the complete cofinal tail diagram map. -/
private def tailDiagramHom (q : ℤ) (n a : ℕ) :
    sourceTailDiagramFunctor.{u, v} q n a ⟶ targetTailDiagramFunctor q n a where
  app X := NatTrans.ofSequence (fun r => (stageIso q n a X r).hom)
    (fun r => stageIso_successor_square q n a X r)
  naturality {X Y} f := by
    apply NatTrans.ext
    funext r
    exact groupCastIso_naturality
      (sourcePositiveIndex q n a r) (targetPositiveIndex q n a r) (commonPositiveIndex q n a r)
      (stageLevelIso q n a X r) (stageLevelIso q n a Y r)
      (PointedCGWH.SequentialSpectrum.levelMap (truncatedShiftMap n a f) (sourceLevel q n a r))
      (PointedCGWH.SequentialSpectrum.levelMap f (targetLevel q n a r))
      (stageLevelIso_naturality q n a f r)

/-- Both full cofinal diagram arrows are assembled from the original level and degree casts. -/
private def tailDiagramIso (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (sourceTailDiagramFunctor q n a).obj X ≅ (targetTailDiagramFunctor q n a).obj X :=
  NatIso.ofComponents (fun r => stageIso q n a X r)
    (fun f => ((tailDiagramHom q n a).app X).naturality f)

/-- Every forward diagram component is the entire actual original stage arrow. -/
private theorem tailDiagramIso_hom_app (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (tailDiagramIso q n a X).hom.app r = (stageIso q n a X r).hom := rfl

/-- Every inverse diagram component is the entire actual original inverse stage arrow. -/
private theorem tailDiagramIso_inv_app (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    (tailDiagramIso q n a X).inv.app r = (stageIso q n a X r).inv := rfl

/-- All finite endpoints retain the complete forward original successor-composite square. -/
private theorem tailDiagramIso_hom_index_naturality (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) {i j : ℕ} (f : i ⟶ j) :
    ((sourceTailDiagramFunctor q n a).obj X).map f ≫ (stageIso q n a X j).hom =
      (stageIso q n a X i).hom ≫ ((targetTailDiagramFunctor q n a).obj X).map f :=
  (tailDiagramIso q n a X).hom.naturality f

/-- All finite endpoints retain the complete inverse original successor-composite square. -/
private theorem tailDiagramIso_inv_index_naturality (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) {i j : ℕ} (f : i ⟶ j) :
    ((targetTailDiagramFunctor q n a).obj X).map f ≫ (stageIso q n a X j).inv =
      (stageIso q n a X i).inv ≫ ((sourceTailDiagramFunctor q n a).obj X).map f :=
  (tailDiagramIso q n a X).inv.naturality f

/-- The whole original cofinal diagram comparison is natural in every original input spectrum. -/
private def tailDiagramNatIso (q : ℤ) (n a : ℕ) :
    sourceTailDiagramFunctor.{u, v} q n a ≅ targetTailDiagramFunctor q n a :=
  NatIso.ofComponents (fun X => tailDiagramIso q n a X)
    (fun f => (tailDiagramHom q n a).naturality f)

/-- The original source cofinal group comparison keeps the whole original quotient. -/
private def sourceTailPiNatIso (q : ℤ) (n a : ℕ) :
    sourceTailDiagramFunctor.{u, v} q n a ⋙ GrpCat.FilteredColimits.colimitFunctor ≅
      truncatedShiftFunctor n a ⋙ integerStablePiFunctor q :=
  NatIso.ofComponents
    (fun X => tailComparisonIso ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a X))
      (sourceOffset q n a))
    (fun f => tailComparisonIso_naturality (sourceOffset q n a)
      ((integerDiagonalDiagramFunctor q).map (truncatedShiftMap n a f)))

/-- The original target cofinal group comparison keeps its whole original quotient. -/
private def targetTailPiNatIso (q : ℤ) (n a : ℕ) :
    targetTailDiagramFunctor.{u, v} q n a ⋙ GrpCat.FilteredColimits.colimitFunctor ≅
      integerStablePiFunctor (q + (n : ℤ)) :=
  NatIso.ofComponents
    (fun X => tailComparisonIso ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X)
      (targetOffset q a))
    (fun f => tailComparisonIso_naturality (targetOffset q a)
      ((integerDiagonalDiagramFunctor (q + (n : ℤ))).map f))

/-- In every integer degree the original truncated shift has the original shifted integer group. -/
private def comparisonNatIso (q : ℤ) (n a : ℕ) :
    truncatedShiftFunctor.{u, v} n a ⋙ integerStablePiFunctor q ≅
      integerStablePiFunctor (q + (n : ℤ)) :=
  (sourceTailPiNatIso q n a).symm ≪≫
    Functor.isoWhiskerRight (tailDiagramNatIso q n a) GrpCat.FilteredColimits.colimitFunctor ≪≫
      targetTailPiNatIso q n a

/-- Both complete comparison arrows act on the actual original integer group quotients. -/
private def comparisonIso (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (truncatedShift n a X) ≅
      (integerStablePiFunctor (q + (n : ℤ))).obj X :=
  (comparisonNatIso q n a).app X

/-- The whole forward arrow is source cofinal inverse, original group casts, target cofinal hom. -/
private theorem comparisonIso_hom (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (comparisonIso q n a X).hom =
      (tailComparisonIso ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a X))
        (sourceOffset q n a)).inv ≫
      GrpCat.FilteredColimits.colimitMap (tailDiagramIso q n a X).hom ≫
      (tailComparisonIso ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X)
        (targetOffset q a)).hom := by
  change (_ ≫ _) ≫ _ = _ ≫ _ ≫ _
  exact Category.assoc _ _ _

/-- The whole inverse arrow is target cofinal inverse, original inverse casts, source cofinal hom. -/
private theorem comparisonIso_inv (q : ℤ) (n a : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (comparisonIso q n a X).inv =
      (tailComparisonIso ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X)
        (targetOffset q a)).inv ≫
      GrpCat.FilteredColimits.colimitMap (tailDiagramIso q n a X).inv ≫
      (tailComparisonIso ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a X))
        (sourceOffset q n a)).hom := rfl

/-- Every retained original source leg goes to its complete original target level leg. -/
private theorem comparisonIso_hom_leg (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r) ≫
        (comparisonIso q n a X).hom =
      (stageIso q n a X r).hom ≫
        integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r) := by
  let D := (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)
  let E := (integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X
  let s := tailComparisonIso D (sourceOffset q n a)
  let t := tailComparisonIso E (targetOffset q a)
  let e := tailDiagramIso q n a X
  have hs := tailComparisonIso_inv_ι D (sourceOffset q n a) r
  have hm := GrpCat.FilteredColimits.colimitMap_ι e.hom r
  have ht := tailComparisonIso_hom_ι E (targetOffset q a) r
  rw [comparisonIso_hom]
  change (GrpCat.FilteredColimits.colimitCocone D).ι.app (sourceOffset q n a + r) ≫
    s.inv ≫ GrpCat.FilteredColimits.colimitMap e.hom ≫ t.hom =
      e.hom.app r ≫ (GrpCat.FilteredColimits.colimitCocone E).ι.app (targetOffset q a + r)
  erw [← Category.assoc, ← Category.assoc, hs, Category.assoc, ← Category.assoc, hm,
    Category.assoc, ht]
  rfl

/-- Every retained original target leg goes to its complete original inverse source level leg. -/
private theorem comparisonIso_inv_leg (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r) ≫
        (comparisonIso q n a X).inv =
      (stageIso q n a X r).inv ≫
        integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r) := by
  let D := (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)
  let E := (integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X
  let s := tailComparisonIso D (sourceOffset q n a)
  let t := tailComparisonIso E (targetOffset q a)
  let e := tailDiagramIso q n a X
  have ht := tailComparisonIso_inv_ι E (targetOffset q a) r
  have hm := GrpCat.FilteredColimits.colimitMap_ι e.inv r
  have hs := tailComparisonIso_hom_ι D (sourceOffset q n a) r
  rw [comparisonIso_inv]
  change (GrpCat.FilteredColimits.colimitCocone E).ι.app (targetOffset q a + r) ≫
    t.inv ≫ GrpCat.FilteredColimits.colimitMap e.inv ≫ s.hom =
      e.inv.app r ≫ (GrpCat.FilteredColimits.colimitCocone D).ι.app (sourceOffset q n a + r)
  erw [← Category.assoc, ← Category.assoc, ht, Category.assoc, ← Category.assoc, hm,
    Category.assoc, hs]
  rfl

/-- Every original leg, including levels before the cofinal cutoff, retains its actual transition. -/
private theorem comparisonIso_hom_leg_all (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg q (truncatedShift n a X) r ≫ (comparisonIso q n a X).hom =
      ((integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)).map
        (homOfLE (Nat.le_add_left r (sourceOffset q n a))) ≫
      (stageIso q n a X r).hom ≫
        integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r) := by
  let D := (integerDiagonalDiagramFunctor q).obj (truncatedShift n a X)
  have h := (GrpCat.FilteredColimits.colimitCocone D).w
    (homOfLE (Nat.le_add_left r (sourceOffset q n a)))
  calc
    _ = D.map (homOfLE (Nat.le_add_left r (sourceOffset q n a))) ≫
        integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r) ≫
          (comparisonIso q n a X).hom := by
      exact (congrArg (fun f => f ≫ (comparisonIso q n a X).hom) h.symm).trans
        (Category.assoc _ _ _)
    _ = _ :=
      congrArg (fun f => D.map (homOfLE (Nat.le_add_left r (sourceOffset q n a))) ≫ f)
        (comparisonIso_hom_leg q n a X r)

/-- Every original target leg retains its actual transition before the inverse cofinal stage. -/
private theorem comparisonIso_inv_leg_all (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ) :
    integerStablePiLeg (q + (n : ℤ)) X r ≫ (comparisonIso q n a X).inv =
      ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X).map
        (homOfLE (Nat.le_add_left r (targetOffset q a))) ≫
      (stageIso q n a X r).inv ≫
        integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r) := by
  let E := (integerDiagonalDiagramFunctor (q + (n : ℤ))).obj X
  have h := (GrpCat.FilteredColimits.colimitCocone E).w
    (homOfLE (Nat.le_add_left r (targetOffset q a)))
  calc
    _ = E.map (homOfLE (Nat.le_add_left r (targetOffset q a))) ≫
        integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r) ≫
          (comparisonIso q n a X).inv := by
      exact (congrArg (fun f => f ≫ (comparisonIso q n a X).inv) h.symm).trans
        (Category.assoc _ _ _)
    _ = _ :=
      congrArg (fun f => E.map (homOfLE (Nat.le_add_left r (targetOffset q a))) ≫ f)
        (comparisonIso_inv_leg q n a X r)

/-- Every original input spectrum map retains the full forward integer comparison square. -/
private theorem comparisonIso_hom_naturality (q : ℤ) (n a : ℕ)
    {X Y : PointedCGWH.SequentialSpectrum.{u, v}} (f : X ⟶ Y) :
    (integerStablePiFunctor q).map (truncatedShiftMap n a f) ≫ (comparisonIso q n a Y).hom =
      (comparisonIso q n a X).hom ≫ (integerStablePiFunctor (q + (n : ℤ))).map f :=
  (comparisonNatIso q n a).hom.naturality f

/-- Every original input spectrum map retains the full inverse integer comparison square. -/
private theorem comparisonIso_inv_naturality (q : ℤ) (n a : ℕ)
    {X Y : PointedCGWH.SequentialSpectrum.{u, v}} (f : X ⟶ Y) :
    (integerStablePiFunctor (q + (n : ℤ))).map f ≫ (comparisonIso q n a Y).inv =
      (comparisonIso q n a X).inv ≫ (integerStablePiFunctor q).map (truncatedShiftMap n a f) :=
  (comparisonNatIso q n a).inv.naturality f

/-- The complete quotient representative is mapped by the entire original comparison hom. -/
private theorem comparisonIso_hom_apply_leg (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ)
    (z : ((sourceTailDiagramFunctor q n a).obj X).obj r) :
    (comparisonIso q n a X).hom.hom
        ((integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r)).hom z) =
      (integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r)).hom
        ((stageIso q n a X r).hom.hom z) :=
  ConcreteCategory.congr_hom (comparisonIso_hom_leg q n a X r) z

/-- The complete quotient representative is mapped by the entire original comparison inverse. -/
private theorem comparisonIso_inv_apply_leg (q : ℤ) (n a : ℕ)
    (X : PointedCGWH.SequentialSpectrum.{u, v}) (r : ℕ)
    (z : ((targetTailDiagramFunctor q n a).obj X).obj r) :
    (comparisonIso q n a X).inv.hom
        ((integerStablePiLeg (q + (n : ℤ)) X (targetOffset q a + r)).hom z) =
      (integerStablePiLeg q (truncatedShift n a X) (sourceOffset q n a + r)).hom
        ((stageIso q n a X r).inv.hom z) :=
  ConcreteCategory.congr_hom (comparisonIso_inv_leg q n a X r) z

/-- At zero cutoff the whole identity-tail inclusion is the original spectrum identity. -/
private theorem tailInclusion_zero (n : ℕ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    tailInclusion n 0 X = 𝟙 (truncatedShift n 0 X) := by
  apply PointedCGWH.SequentialSpectrum.hom_ext
  intro r
  rw [tailInclusion_levelMap, PointedCGWH.SequentialSpectrum.levelMap_id]
  by_cases h : n + 0 ≤ r
  · simp only [tailInclusionLevel, dite_eq_left h, eqToHom_trans, eqToHom_refl]
    rfl
  · have hInitial : IsInitial (truncatedLevel n 0 X r) := by
      rw [truncatedLevel_below n 0 X r (Nat.lt_of_not_ge h)]
      exact initialIsInitial
    exact hInitial.hom_ext _ _

end PointedCGWH.Spectra.OriginalSequentialTailIntegerPi
end

end

section

attribute [local instance] _root_.NAMS.genericSmallHasColimit _root_.NAMS.genericSmallHasCoproduct

attribute [local instance] _root_.NAMS.SymmetricUnit.originalUnitExtensions

attribute [local instance] _root_.NAMS.smallHasColimit _root_.NAMS.smallHasCoproduct

open scoped CGWH.limits









set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory MonoidalCategory BraidedCategory Limits
open CategoryTheory.Operad.SmallFinBijGroupoid
open scoped MonoidalClosed CGWH.limits ZeroObject

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open CategoryTheory.SequentialSpectrum.EnrichedPresentation
open PointedCGWH.Spectra.OriginalSequentialTailIntegerPi
open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK.Actual.SymmetricIntegerHomotopy

attribute [local instance] Classical.propDecidable
  PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  PointedCGWH.EnrichedMapping.hasSmallLimits
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers
  CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  MonoidalClosed.enrichedCategorySelf

/-- The pointed zero object supplies the zero morphisms in the actual finite orbit-tail coproduct. -/
local instance _root_.PointedCGWH.originalOrbitTailZeroMorphisms :
    HasZeroMorphisms PointedCGWH.{u, v} :=
  HasZeroObject.zeroMorphismsOfZeroObject

/-- The actual pointed projection from the finite orbit coproduct. -/
private def orbitProjection (c n : ℕ) (Z : PointedCGWH.{u, v}) (i : OrbitIndex c n) :
    (∐ fun _ : OrbitIndex c n => Z) ⟶ Z :=
  Sigma.desc (fun j => if j = i then 𝟙 Z else 0)

/-- Every original finite coproduct leg has its specified pointed projection. -/
private theorem orbitProjection_leg (c n : ℕ) (Z : PointedCGWH.{u, v}) (i j : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) j ≫ orbitProjection c n Z i =
      if j = i then 𝟙 Z else 0 := by
  exact Sigma.ι_comp_desc _ _

/-- The selected original finite leg is a section of the pointed projection. -/
private theorem orbitProjection_selected (c n : ℕ) (Z : PointedCGWH.{u, v}) (i : OrbitIndex c n) :
    Sigma.ι (fun _ : OrbitIndex c n => Z) i ≫ orbitProjection c n Z i = 𝟙 Z := by
  rw [orbitProjection_leg, ite_eq_left rfl]

/-- This is the literal original restriction of the original balanced free smash. -/
private abbrev originalFreeSmashRestriction (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : PointedCGWH.SequentialSpectrum.{u, v} :=
  underlyingSequential.obj ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).obj Y)

/-- The actual finite orbit inclusion retains the whole original inverse level comparison. -/
private def finiteNativeLeg (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    M ⊗ Y.X.functor.obj (card c) ⟶ (originalFreeSmashRestriction n M Y).level (c + n) :=
  Sigma.ι (fun _ : OrbitIndex c n => M ⊗ Y.X.functor.obj (card c)) i ≫
    (freeSmashFiniteOrbitIso c n M Y).inv

/-- Its entire native leg is the original balanced generator at the original representative. -/
private theorem finiteNativeLeg_original (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    finiteNativeLeg c n M Y i =
      nativeBalancedGenerator.{u, v, 0, 0} (Aut (card c)) (Aut (card (c + n)))
        (M ⊗ Y.X.functor.obj (card c))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card c))
        (complementHom c n) (orbitRepresentative c n i) ≫
        (freeSmashBalancedOrbitIso c n M Y).inv :=
  freeSmashFiniteOrbitIso_inv_leg c n M Y i

/-- The actual selected projection uses the whole original forward finite comparison. -/
private def finiteNativeProjection (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    (originalFreeSmashRestriction n M Y).level (c + n) ⟶ M ⊗ Y.X.functor.obj (card c) :=
  (freeSmashFiniteOrbitIso c n M Y).hom ≫
    orbitProjection c n (M ⊗ Y.X.functor.obj (card c)) i

/-- The actual inclusion and projection split the same native finite summand. -/
private theorem finiteNativeLeg_projection (c n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    finiteNativeLeg c n M Y i ≫ finiteNativeProjection c n M Y i =
      𝟙 (M ⊗ Y.X.functor.obj (card c)) := by
  let e := freeSmashFiniteOrbitIso c n M Y
  let l := Sigma.ι (fun _ : OrbitIndex c n => M ⊗ Y.X.functor.obj (card c)) i
  let p := orbitProjection c n (M ⊗ Y.X.functor.obj (card c)) i
  have h : (l ≫ e.inv) ≫ (e.hom ≫ p) = 𝟙 (M ⊗ Y.X.functor.obj (card c)) := by
    rw [Category.assoc, e.inv_hom_id_assoc]
    exact orbitProjection_selected c n _ i
  exact h

/-- A stable label selects its actual original finite inverse leg after first appearance. -/
private def activeNativeLeg (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (c : ℕ)
    (h : firstAppearance n γ ≤ c) :=
  finiteNativeLeg c n M Y (activeOrbit n γ c h)

/-- The actual next selected projection at this same stable label. -/
private def activeNativeProjection (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (c : ℕ)
    (h : firstAppearance n γ ≤ c) :=
  finiteNativeProjection c n M Y (activeOrbit n γ c h)

/-- The source successor is read from the actual native object between its actual orbit legs. -/
private def selectedNativeStructure (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (c : ℕ)
    (h : firstAppearance n γ ≤ c) :
    PointedCGWH.sphereOne ⊗ (M ⊗ Y.X.functor.obj (card c)) ⟶
      M ⊗ Y.X.functor.obj (card (c + 1)) :=
  (PointedCGWH.sphereOne ◁ activeNativeLeg n M Y γ c h) ≫
    (originalFreeSmashRestriction n M Y).structureMap (c + n) ≫
    eqToHom (congrArg (originalFreeSmashRestriction n M Y).level
      (show c + n + 1 = (c + 1) + n by omega)) ≫
    activeNativeProjection n M Y γ (c + 1) (by omega)

/-- The original free smash input component, with its actual native endpoints fixed. -/
private def nativeFreeSmashInputLevel (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ) :
    (originalFreeSmashRestriction n M Y).level (c + n) ⟶
      (originalFreeSmashRestriction n M Z).level (c + n) :=
  PointedCGWH.SequentialSpectrum.levelMap
    (underlyingSequential.map ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).map f)) (c + n)

/-- The complete input component is literally the original restricted native free smash map. -/
private theorem nativeFreeSmashInputLevel_original (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ) :
    nativeFreeSmashInputLevel n M f c = PointedCGWH.SequentialSpectrum.levelMap
      (underlyingSequential.map ((PointedCGWH.SymmetricSpectrum.freeSmash (card n) M).map f))
      (c + n) := rfl

/-- Input maps are read from the same actual native free smash map and selected orbit legs. -/
private def selectedNativeInput (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z)
    (γ : StableOrbitIndex n) (c : ℕ) (h : firstAppearance n γ ≤ c) :
    M ⊗ Y.X.functor.obj (card c) ⟶ M ⊗ Z.X.functor.obj (card c) :=
  activeNativeLeg n M Y γ c h ≫ nativeFreeSmashInputLevel n M f c ≫
    activeNativeProjection n M Z γ c h

/-- Actual source levels are the original coefficients after first appearance and initial below. -/
private def nativeSummandLevel (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.{u, v} :=
  if n + firstAppearance n γ ≤ r then M ⊗ Y.X.functor.obj (card (r - n))
    else ⊥_ PointedCGWH.{u, v}

private theorem nativeSummandLevel_above (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (r : ℕ)
    (h : n + firstAppearance n γ ≤ r) :
    nativeSummandLevel n M Y γ r = M ⊗ Y.X.functor.obj (card (r - n)) := ite_eq_left h

private theorem nativeSummandLevel_below (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (r : ℕ)
    (h : r < n + firstAppearance n γ) :
    nativeSummandLevel n M Y γ r = ⊥_ PointedCGWH.{u, v} := ite_eq_right (Nat.not_le_of_gt h)

/-- Every source successor comes from the actual native projection composite, with all level casts. -/
private def nativeSummandStructure (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.sphereOne ⊗ nativeSummandLevel n M Y γ r ⟶
      nativeSummandLevel n M Y γ (r + 1) := by
  by_cases h : n + firstAppearance n γ ≤ r
  · exact eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
      (nativeSummandLevel_above n M Y γ r h)) ≫
      selectedNativeStructure n M Y γ (r - n) (by omega) ≫
      eqToHom ((congrArg (fun c => M ⊗ Y.X.functor.obj (card c))
        (show r - n + 1 = r + 1 - n by omega)).trans
        (nativeSummandLevel_above n M Y γ (r + 1) (by omega)).symm)
  · exact eqToHom (congrArg (fun Z => PointedCGWH.sphereOne ⊗ Z)
      (nativeSummandLevel_below n M Y γ r (Nat.lt_of_not_ge h))) ≫
      (MonoidalCategory.tensorInitialLeft PointedCGWH.sphereOne).to
        (nativeSummandLevel n M Y γ (r + 1))

/-- The original left spectrum has successors extracted from the actual native orbit summands. -/
private def rawNativeSummand (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) :
    CategoryTheory.SequentialSpectrum PointedCGWH.{u, v} PointedCGWH.sphereOne where
  level := nativeSummandLevel n M Y γ
  structureMap := nativeSummandStructure n M Y γ

/-- The genuine source keeps the original ordered full Hom actions of these actual successors. -/
private def nativeSummand (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) :
    PointedCGWH.SequentialSpectrum.{u, v} :=
  toEnrichedFunctor PointedCGWH.sphereOne (rawNativeSummand n M Y γ)

private theorem nativeSummand_level (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (r : ℕ) :
    (nativeSummand n M Y γ).level r = nativeSummandLevel n M Y γ r := rfl

private theorem nativeSummand_structureMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) (r : ℕ) :
    (nativeSummand n M Y γ).structureMap r = nativeSummandStructure n M Y γ r :=
  from_to_structureMap PointedCGWH.sphereOne (rawNativeSummand n M Y γ) r

private theorem nativeSummand_action (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n)
    (i j : PointedCGWH.Spectra.Sequential.Index.{u, v}) :
    PointedCGWH.SequentialSpectrum.action (nativeSummand n M Y γ) i j =
      spectrumAction (rawNativeSummand n M Y γ) i j :=
  toEnrichedFunctor_uncurry_map PointedCGWH.sphereOne (rawNativeSummand n M Y γ) i j

