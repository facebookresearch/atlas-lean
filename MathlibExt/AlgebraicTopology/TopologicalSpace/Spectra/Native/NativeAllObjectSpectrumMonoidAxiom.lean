private theorem pointedPositivePi_subsingleton_of_isZero (n : ℕ) (X : PointedCGWH.{u, v}) (hX : IsZero X) :
    Subsingleton ((PointedCGWH.piNPositiveFunctor n).obj X) := by
  let H := _root_.HomotopicalAlgebra.toHomotopyCategory PointedCGWH.{u, v}
  let K := PointedCGWH.SphereHom.sphere.{u, v} (n + 1)
  let _ : (Under.costarAdjForget CGWH.point.{u, v}).IsQuillenAdjunction :=
    Under.costarAdjForget_isQuillenAdjunction CGWH.point
  let _ : IsCofibrant PointedCGWH.SphereHom.freePoint.{u, v} :=
    Adjunction.IsQuillenAdjunction.preservesCofibrantObjects
      (adj := Under.costarAdjForget CGWH.point) CGWH.point_isCofibrant
  let _ : IsCofibrant K :=
    Adjunction.IsQuillenAdjunction.preservesCofibrantObjects
      (adj := PointedCGWH.SphereHom.powerAdjunction (n + 1)) inferInstance
  let _ : Subsingleton (H.obj K ⟶ H.obj X) := ⟨by
    intro f g
    obtain ⟨f, rfl⟩ := map_surjective_of_isLocalization H K X f
    obtain ⟨g, rfl⟩ := map_surjective_of_isLocalization H K X g
    exact H.congr_map (hX.isTerminal.hom_ext f g)⟩
