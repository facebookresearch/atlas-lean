namespace NativeEvaluationComparison

private theorem comparison_trans
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D]
    (F : B ⥤ C) (G : C ⥤ D) (H : B ⥤ D) (τ : F ⋙ G ≅ H)
    {R T : B} {X : C} (d : X ≅ F.obj R) (e : R ≅ T) :
    G.mapIso (d ≪≫ F.mapIso e) ≪≫ τ.app T =
      (G.mapIso d ≪≫ τ.app R) ≪≫ H.mapIso e := by
  apply Iso.ext
  simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.app_hom, G.map_comp, Category.assoc]
  have h := τ.hom.naturality e.hom
  change G.map (F.map e.hom) ≫ τ.hom.app T = τ.hom.app R ≫ H.map e.hom at h
  exact congrArg (fun z => G.map d.hom ≫ z) h

private def comparison
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D]
    (F : B ⥤ C) (G : C ⥤ D) (H : B ⥤ D) (τ : F ⋙ G ≅ H)
    {R T : B} {X : C} (d : X ≅ F.obj R) (e : R ≅ T) :
    G.obj X ≅ H.obj T := G.mapIso (d ≪≫ F.mapIso e) ≪≫ τ.app T

private theorem comparisonEq
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D]
    (F : B ⥤ C) (G : C ⥤ D) (H : B ⥤ D) (τ : F ⋙ G ≅ H)
    {R T : B} {X : C} (d : X ≅ F.obj R) (e : R ≅ T) :
    comparison F G H τ d e =
      (G.mapIso d ≪≫ τ.app R) ≪≫ H.mapIso e :=
  comparison_trans F G H τ d e

private theorem comparisonEq_of_heq_boundaries
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D]
    (F : B ⥤ C) (G : C ⥤ D) (H : B ⥤ D) (τ : F ⋙ G ≅ H)
    {R T : B} {X : C} (d : X ≅ F.obj R) (e : R ≅ T)
    (c : G.obj X ≅ H.obj T) (b : G.obj X ≅ H.obj R)
    (hc : HEq c (comparison F G H τ d e))
    (hb : HEq b (G.mapIso d ≪≫ τ.app R)) :
    c = b ≪≫ H.mapIso e :=
  (eq_of_heq hc).trans ((comparisonEq F G H τ d e).trans
    (congrArg (fun z : G.obj X ≅ H.obj R => z ≪≫ H.mapIso e) (eq_of_heq hb).symm))

private structure Recipe
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D]
    (F : B ⥤ C) (G : C ⥤ D) (H : B ⥤ D) (τ : F ⋙ G ≅ H)
    (R T : B) (X : C) where
  d : X ≅ F.obj R
  e : R ≅ T
  c : G.obj X ≅ H.obj T
  b : G.obj X ≅ H.obj R

private theorem recipeEquation
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D]
    {F : B ⥤ C} {G : C ⥤ D} {H : B ⥤ D} {τ : F ⋙ G ≅ H}
    {R T : B} {X : C} (Q : Recipe F G H τ R T X)
    (hc : HEq Q.c (comparison F G H τ Q.d Q.e))
    (hb : HEq Q.b (G.mapIso Q.d ≪≫ τ.app R)) :
    Q.c = Q.b ≪≫ H.mapIso Q.e :=
  comparisonEq_of_heq_boundaries F G H τ Q.d Q.e Q.c Q.b hc hb

private theorem whisker_app
    {B : Type u₁} [Category.{v₁} B] {C : Type u₂} [Category.{v₂} C]
    {D : Type u₃} [Category.{v₃} D] {E : Type u₄} [Category.{v₄} E]
    (F : D ⥤ C) (G : D ⥤ B) (P : B ⥤ C) (V : C ⥤ E) (H : B ⥤ E)
    (ρ : F ≅ G ⋙ P) (τ : P ⋙ V ≅ H) (X : D) :
    (Functor.isoWhiskerRight ρ V ≪≫ Functor.isoWhiskerLeft G τ).app X =
      V.mapIso (ρ.app X) ≪≫ τ.app (G.obj X) := by
  apply Iso.ext
  rfl

end NativeEvaluationComparison

