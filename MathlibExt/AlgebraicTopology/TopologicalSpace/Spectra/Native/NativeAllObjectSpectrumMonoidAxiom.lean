variable {V : Type uV} [Category.{vV} V]
  {C : Type uC} [Category.{vC} C]

/-- Evaluation retains every object and every parameter map of the entire bifunctor. -/
private def evaluated (F : V ⥤ C ⥤ C) (Y : C) : V ⥤ C where
  obj K := (F.obj K).obj Y
  map i := (F.map i).app Y
  map_id K := congrArg (fun t => t.app Y) (F.map_id K)
  map_comp i j := congrArg (fun t => t.app Y) (F.map_comp i j)

/-- Evaluation of the complete original natural isomorphism. -/
private def evaluatedIso {F S : V ⥤ C ⥤ C} (e : F ≅ S) (Y : C) :
    evaluated F Y ≅ evaluated S Y :=
  NatIso.ofComponents (fun K => (e.app K).app Y)
    (fun i => congrArg (fun t => t.app Y) (e.hom.naturality i))

/-- Transport a named isomorphism through proved whole-functor field equalities. -/
private def transportIso {F S F' S' : V ⥤ C} (e : F ≅ S)
    (hF : F' = F) (hS : S' = S) : F' ≅ S' :=
  eqToIso hF ≪≫ e ≪≫ (eqToIso hS).symm

/-- The Arrow isomorphism retains both source and target parameter arrows. -/
private def mapArrowIso {F S : V ⥤ C} (e : F ≅ S)
    {K L : V} (i : K ⟶ L) : Arrow.mk (F.map i) ≅ Arrow.mk (S.map i) :=
  Arrow.isoMk' (F.map i) (S.map i) (e.app K) (e.app L) (e.hom.naturality i).symm

private theorem map_mem_iff (P : MorphismProperty C) [P.RespectsIso]
    {F S : V ⥤ C} (e : F ≅ S) {K L : V} (i : K ⟶ L) :
    P (F.map i) ↔ P (S.map i) :=
  P.arrow_mk_iso_iff (mapArrowIso e i)







end OrthogonalIGeneratorProbe.EvaluationArrowTransport

