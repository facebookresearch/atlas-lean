    (Free.object (OrthogonalOperatorIndex.ofIndex n) (PointedCGWH.orthogonalSphere n))
    rfl (OriginalGammaOmegaProperty.omegaProperty.{u, v} (B := B)) f
  hScalar.symm.trans (hSource.symm.trans hGamma)
    ) :=
  let hScalar := OriginalNativeScalarDiagonal.native_scalar_diagonal (B := B) n f
  let hGamma := OriginalScalarUnitFamily.gamma_at_exact_predicate (B := B) n f
  let hSource := CategoryTheory.OriginalGammaExactQuiverTransport.source_formula_eq
    ((fun m : ℕ => Free.object (OrthogonalOperatorIndex.ofIndex m) (PointedCGWH.orthogonalSphere m)) n)
    (Free.object (OrthogonalOperatorIndex.ofIndex n) (PointedCGWH.orthogonalSphere n))
    rfl (OriginalGammaOmegaProperty.omegaProperty.{u, v} (B := B)) f
  hScalar.symm.trans (hSource.symm.trans hGamma)


