private def wholeFunctorConstructor {C : Type uC} [Category.{vC} C]
    {D : Type uD} [Category.{vD} D] (F : C ⥤ D) : C ⥤ D where
  obj := F.obj
  map := F.map
  map_id := F.map_id
  map_comp := F.map_comp

private theorem wholeFunctorConstructor_eq {C : Type uC} [Category.{vC} C]
    {D : Type uD} [Category.{vD} D] (F : C ⥤ D) : wholeFunctorConstructor F = F := rfl


private def functorObjectBoundary {C : Type uC} [Category.{vC} C]
    {D : Type uD} [Category.{vD} D] (F : C ⥤ D) (o : C → D) (h : F.obj = o) : C ⥤ D where
  obj := o
  map {X Y} := h ▸ (F.map (X := X) (Y := Y))
  map_id := by cases h; exact F.map_id
  map_comp := by cases h; exact F.map_comp

private theorem functorObjectBoundary_eq {C : Type uC} [Category.{vC} C]
    {D : Type uD} [Category.{vD} D] (F : C ⥤ D) (o : C → D) (h : F.obj = o) :
    functorObjectBoundary F o h = F := by
  cases h
  rfl

private theorem functorObjectBoundary_map_heq {C : Type uC} [Category.{vC} C]
    {D : Type uD} [Category.{vD} D] (F : C ⥤ D) (o : C → D) (h : F.obj = o)
    {X Y : C} (f : X ⟶ Y) :
    HEq ((functorObjectBoundary F o h).map f) (F.map f) := by
  cases h
  exact HEq.refl _

private def retainParametrizedFamily {P : Type uP} [Category.{vP} P]
    {B : Type uB} [Category.{vB} B] {D : Type uD} [Category.{vD} D]
    {F F' : P ⥤ B ⥤ D} {G G' : Pᵒᵖ ⥤ D ⥤ B}
    (a : F ⊣₂ G) (hF : F = F') (hG : G = G')
    (adj : ∀ X, F'.obj X ⊣ G'.obj (.op X)) (hAdj : HEq a.adj adj) : F' ⊣₂ G' :=
  ParametrizedAdjunction.mk' adj (by
    cases hF
    cases hG
    have ha : a.adj = adj := eq_of_heq hAdj
    cases ha
    intro X Y p Z W f
    exact a.homEquiv_naturality_one p f)


/-- The complete retained adjunction initializer is exactly the supplied original family. -/
private theorem retainParametrizedFamily_adj
    {P : Type uP} [Category.{vP} P]
    {B : Type uB} [Category.{vB} B] {D : Type uD} [Category.{vD} D]
    {F F' : P ⥤ B ⥤ D} {G G' : Pᵒᵖ ⥤ D ⥤ B}
    (a : F ⊣₂ G) (hF : F = F') (hG : G = G')
    (adj : ∀ X, F'.obj X ⊣ G'.obj (.op X)) (hAdj : HEq a.adj adj) :
    (retainParametrizedFamily a hF hG adj hAdj).adj = adj := rfl







