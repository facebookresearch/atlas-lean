private theorem nativeUnitProof (n : ℕ) {X Y : Actual.OrthogonalCarrier.{u, v}} (f : X ⟶ Y) :
    type_of% (
  let hScalar := OriginalNativeScalarDiagonal.native_scalar_diagonal (B := B) n f
  let hGamma := OriginalScalarUnitFamily.gamma_at_exact_predicate (B := B) n f
  let hSource := CategoryTheory.OriginalGammaExactQuiverTransport.source_formula_eq
