private theorem representedLeftTensorIso_app {D : Type uD} [Category.{vD} D] [MonoidalCategory D]
    (A : D) (S : D ⥤ D) (e : tensorLeft A ≅ S) (X Y : D) :
    (Functor.isoWhiskerLeft (tensorLeft X) e.symm ≪≫ (tensorLeftTensor A X).symm ≪≫
      (tensoringLeft D).mapIso (e.app X)).app Y =
        CategoryTheory.TensorRepresentedInterchange.interchange A S e X Y := rfl

/-- Every component of the whole left-tensor comparison is the actual
original scalar-smash interchange, including both complete inverse maps. -/
private theorem scalarThroughLeftTensorIso_app (K : PointedCGWH.{u, v}) (X Y : C.{u, v}) :
    (scalarThroughLeftTensorIso K X).app Y = scalarSmashIso K X Y :=
  representedLeftTensorIso_app (zeroFree K) (EnrichedFunctorCat.tensorLeft K) (tensorScalarIso K) X Y

/-- The forward full free-coefficient comparison retains the actual
inverse scalar/free map and the exact inverse native scalar-smash interchange. -/
private theorem originalFreeCoefficientScalarSmashIso_hom_app
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (K M : PointedCGWH.{u, v}) (Y : C.{u, v}) :
    (originalFreeCoefficientScalarSmashIso a K M).hom.app Y =
      (Free.scalarFreeIso K M a).inv ▷ Y ≫ (scalarSmashIso K (Free.object a M) Y).inv := by
  have h := congrArg (fun e => e.inv) (scalarThroughLeftTensorIso_app K (Free.object a M) Y)
  change (Free.scalarFreeIso K M a).inv ▷ Y ≫ (scalarThroughLeftTensorIso K (Free.object a M)).inv.app Y = _
  exact congrArg (fun k => (Free.scalarFreeIso K M a).inv ▷ Y ≫ k) h

/-- The inverse full free-coefficient comparison retains the exact native
scalar-smash map followed by the same original scalar/free map. -/
private theorem originalFreeCoefficientScalarSmashIso_inv_app
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (K M : PointedCGWH.{u, v}) (Y : C.{u, v}) :
    (originalFreeCoefficientScalarSmashIso a K M).inv.app Y =
      (scalarSmashIso K (Free.object a M) Y).hom ≫ (Free.scalarFreeIso K M a).hom ▷ Y := by
  have h := congrArg (fun e => e.hom) (scalarThroughLeftTensorIso_app K (Free.object a M) Y)
  change (scalarThroughLeftTensorIso K (Free.object a M)).hom.app Y ≫ (Free.scalarFreeIso K M a).hom ▷ Y = _
  exact congrArg (fun k => k ≫ (Free.scalarFreeIso K M a).hom ▷ Y) h

/-- The entire free sphere-to-unit coefficient comparison has the actual
inverse free unitor before the same full scalar/free forward comparison. -/
private theorem originalFreeScalarUnitSmashIso_hom_app
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (K : PointedCGWH.{u, v}) (Y : C.{u, v}) :
    (originalFreeScalarUnitSmashIso a K).hom.app Y =
      (Free.functor a).map (ρ_ K).inv ▷ Y ≫
        (originalFreeCoefficientScalarSmashIso a K (𝟙_ PointedCGWH.{u, v})).hom.app Y := rfl

/-- The full inverse unit-coefficient comparison has the original free
unitor after the exact inverse scalar/free comparison. -/
private theorem originalFreeScalarUnitSmashIso_inv_app
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (K : PointedCGWH.{u, v}) (Y : C.{u, v}) :
    (originalFreeScalarUnitSmashIso a K).inv.app Y =
      (originalFreeCoefficientScalarSmashIso a K (𝟙_ PointedCGWH.{u, v})).inv.app Y ≫
        (Free.functor a).map (ρ_ K).hom ▷ Y := rfl







