    ∀ i j k, IsIso ((P j).map ((reduction S γ i).app (F k))) := by
  intro i j k
  let _ : IsIso ((P j).map (γ i ▷ F k)) := hγ i j k
  change IsIso ((P j).map (γ i ▷ F k ≫ (λ_ (F k)).hom))
  rw [Functor.map_comp]
