attribute [local instance] _root_.NAMS.genericSmallHasColimit _root_.NAMS.genericSmallHasCoproduct

attribute [local instance] _root_.NAMS.SymmetricUnit.originalUnitExtensions

attribute [local instance] _root_.NAMS.smallHasColimit _root_.NAMS.smallHasCoproduct

open scoped CGWH.limits

set_option autoImplicit false
noncomputable section
universe u v uA vA uD vD uL

open CategoryTheory CategoryTheory.Limits CategoryTheory.EnrichedFunctorCat
open scoped CGWH.limits MonoidalClosed

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.GrowingOrbitCofan

open OrbitTailHelper WholeOrbitCofan

private theorem sigmaLegNaturality {A : Type uA} [Category.{vA} A]
    {D : Type uD} [Category.{vD} D] {L : Type uL}
    (F : L → A ⥤ D) (T : A ⥤ D) (α : ∀ l, F l ⟶ T)
    {X Y : A} (f : X ⟶ Y) [HasCoproduct (fun l => (F l).obj X)]
    [HasCoproduct (fun l => (F l).obj Y)] :
    Sigma.desc (fun l => (α l).app X) ≫ T.map f =
      Limits.Sigma.map (fun l => (F l).map f) ≫ Sigma.desc (fun l => (α l).app Y) := by
  apply Sigma.hom_ext (f := fun l => (F l).obj X)
  intro l
  calc
    _ = (Sigma.ι (fun l => (F l).obj X) l ≫ Sigma.desc (fun l => (α l).app X)) ≫ T.map f :=
      (Category.assoc _ _ _).symm
    _ = (α l).app X ≫ T.map f := by rw [Sigma.ι_comp_desc]
    _ = (F l).map f ≫ (α l).app Y := (α l).naturality f |>.symm
    _ = (F l).map f ≫ (Sigma.ι (fun l => (F l).obj Y) l ≫ Sigma.desc (fun l => (α l).app Y)) := by
      rw [Sigma.ι_comp_desc]
    _ = ((F l).map f ≫ Sigma.ι (fun l => (F l).obj Y) l) ≫ Sigma.desc (fun l => (α l).app Y) :=
      (Category.assoc _ _ _).symm
    _ = (Sigma.ι (fun l => (F l).obj X) l ≫ Limits.Sigma.map (fun l => (F l).map f)) ≫
        Sigma.desc (fun l => (α l).app Y) := by rw [Sigma.ι_map]
    _ = _ := Category.assoc _ _ _

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The original stable labels present at the actual finite orbit stage. -/
private abbrev Labels (n c : ℕ) := {label : StableOrbitIndex n // firstAppearance n label ≤ c}

private instance labelsFinite (n c : ℕ) : Finite (Labels n c) :=
  Finite.of_equiv (OrbitIndex c n) (availableOrbitEquiv c n)

/-- The actual inclusion keeps each original stable label and its first appearance. -/
private abbrev labelInclusion (n : ℕ) {c d : ℕ} (h : c ≤ d) : Labels n c ↪ Labels n d where
  toFun label := ⟨label.val, label.property.trans h⟩
  inj' _a _b hab := Subtype.ext (congrArg (fun x : Labels n d => x.val) hab)

private abbrev Family (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) : Labels n c →
      PointedCGWH.SequentialSpectrum.{u, v} :=
  fun label => (originalNativeSummandFunctor n M label.val).obj Y

/-- Every original finite stage is the actual coproduct of its available native summands. -/
private abbrev diagram (n : ℕ) (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    ℕ ⥤ PointedCGWH.SequentialSpectrum.{u, v} where
  obj c := ∐ Family n M Y c
  map {c d} h := Limits.Sigma.map' (labelInclusion n (leOfHom h))
    (fun label => 𝟙 (Family n M Y c label))
  map_id c := by
    apply Sigma.hom_ext
    intro label
    rw [Sigma.ι_comp_map', Category.id_comp, Category.comp_id]
    rfl
  map_comp {c d e} h k := by
    apply Sigma.hom_ext
    intro label
    rw [Sigma.ι_comp_map', Category.id_comp, ← Category.assoc, Sigma.ι_comp_map',
      Category.id_comp, Sigma.ι_comp_map', Category.id_comp]
    rfl

/-- The finite-stage leg uses every unchanged whole original native orbit inclusion. -/
private def stageLeg (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) :
    (diagram n M Y).obj c ⟶ (originalFreeSmashRestrictionFunctor n M).obj Y :=
  Sigma.desc (fun label : Labels n c => (originalNativeSummandInclusionNatTrans n M label.val).app Y)

/-- The full actual original free-smash restriction is the caller endpoint of the same diagram. -/
private def cocone (n : ℕ) (M : PointedCGWH.{u, v}) (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    Cocone (diagram n M Y) where
  pt := (originalFreeSmashRestrictionFunctor n M).obj Y
  ι :=
    { app := stageLeg n M Y
      naturality {c d} h := by
        have hStage : (diagram n M Y).map h ≫ stageLeg n M Y d = stageLeg n M Y c := by
          apply Sigma.hom_ext (f := Family n M Y c)
          intro label
          rw [← Category.assoc, Sigma.ι_comp_map', Category.id_comp]
          exact (Sigma.ι_comp_desc
            (fun i : Labels n d => (originalNativeSummandInclusionNatTrans n M i.val).app Y)
            (labelInclusion n (leOfHom h) label)).trans
              (Sigma.ι_comp_desc
                (fun i : Labels n c => (originalNativeSummandInclusionNatTrans n M i.val).app Y) label).symm
        change (diagram n M Y).map h ≫ stageLeg n M Y d =
          stageLeg n M Y c ≫ 𝟙 ((originalFreeSmashRestrictionFunctor n M).obj Y)
        exact hStage.trans (Category.comp_id (stageLeg n M Y c)).symm }

private abbrev appearanceDiagram (n : ℕ) (label : StableOrbitIndex n) : ℕ ⥤ Type where
  obj c := PLift (firstAppearance n label ≤ c)
  map {c d} h := TypeCat.ofHom (fun proof => PLift.up (proof.down.trans (leOfHom h)))
  map_id _ := by ext proof; rfl
  map_comp _ _ := by ext proof; rfl

private abbrev appearanceCocone (n : ℕ) (label : StableOrbitIndex n) :
    Cocone (appearanceDiagram n label) where
  pt := PUnit
  ι := { app := fun _ => TypeCat.ofHom (fun _ => PUnit.unit) }

private def appearanceCoconeIsColimit (n : ℕ) (label : StableOrbitIndex n) :
    IsColimit (appearanceCocone n label) where
  desc s := TypeCat.ofHom (fun _ => s.ι.app (firstAppearance n label) ⟨le_refl _⟩)
  fac s c := by
    ext proof
    let d := max (firstAppearance n label) c
    have hFirst := congrArg (fun k => k (PLift.up (le_refl (firstAppearance n label))))
      (s.w (homOfLE (le_max_left (firstAppearance n label) c)))
    have hStage := congrArg (fun k => k proof)
      (s.w (homOfLE (le_max_right (firstAppearance n label) c)))
    simp only [types_comp_apply] at hFirst hStage
    have hProof : (appearanceDiagram n label).map
        (homOfLE (le_max_left (firstAppearance n label) c)) ⟨le_refl _⟩ =
      (appearanceDiagram n label).map
        (homOfLE (le_max_right (firstAppearance n label) c)) proof :=
      Subsingleton.elim _ _
    exact hFirst.symm.trans ((congrArg (fun p => s.ι.app d p) hProof).trans hStage)
  uniq s m hm := by
    ext point
    cases point
    exact congrArg (fun k => k (PLift.up (le_refl _))) (hm (firstAppearance n label))

private def finiteStageCofanIsColimit (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) :
    IsColimit (Cofan.mk ((diagram n M Y).obj c)
      (fun a : Σ label : StableOrbitIndex n, (appearanceDiagram n label).obj c =>
        Sigma.ι (Family n M Y c) ⟨a.1, a.2.down⟩)) := by
  refine Cofan.IsColimit.mk _
    (fun s => Sigma.desc (fun label : Labels n c => s.inj ⟨label.val, ⟨label.property⟩⟩)) ?_ ?_
  · intro s a
    exact Sigma.ι_comp_desc
      (fun label : Labels n c => s.inj ⟨label.val, PLift.up label.property⟩) ⟨a.1, a.2.down⟩
  · intro s m hm
    apply Sigma.hom_ext (f := Family n M Y c)
    intro label
    exact (hm ⟨label.val, PLift.up label.property⟩).trans
      (Sigma.ι_comp_desc (fun i : Labels n c => s.inj ⟨i.val, PLift.up i.property⟩) label).symm

private def wholeUnitCofanIsColimit (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    IsColimit (Cofan.mk ((originalFreeSmashRestrictionFunctor n M).obj Y)
      (fun a : Σ label : StableOrbitIndex n, (appearanceCocone n label).pt =>
        (originalNativeSummandInclusionNatTrans n M a.1).app Y)) := by
  have h : IsColimit (Cofan.mk ((originalFreeSmashRestrictionFunctor n M).obj Y)
      (fun label : StableOrbitIndex n => (originalNativeSummandInclusionNatTrans n M label).app Y)) := by
    change IsColimit (originalOrbitCofan n M Y)
    exact originalOrbitCofanIsColimit n M Y
  refine Cofan.IsColimit.mk _
    (fun s => h.desc (Cofan.mk s.pt (fun label => s.inj ⟨label, PUnit.unit⟩))) ?_ ?_
  · intro s a
    rcases a with ⟨label, point⟩
    cases point
    exact h.fac _ ⟨label⟩
  · intro s m hm
    let q := Cofan.mk s.pt (fun label : StableOrbitIndex n => s.inj ⟨label, PUnit.unit⟩)
    apply Cofan.IsColimit.hom_ext h
    intro label
    exact (hm ⟨label, PUnit.unit⟩).trans (h.fac q ⟨label⟩).symm

/-- The actual growing finite-cofan diagram has the literal original free-smash
restriction as its colimit, with all source tags, stage maps and inclusions retained. -/
private def coconeIsColimit (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : IsColimit (cocone n M Y) := by
  let allCofan := Cofan.mk ((originalFreeSmashRestrictionFunctor n M).obj Y)
    (fun label : StableOrbitIndex n => (originalNativeSummandInclusionNatTrans n M label).app Y)
  have hAll : IsColimit allCofan := by
    change IsColimit (originalOrbitCofan n M Y)
    exact originalOrbitCofanIsColimit n M Y
  let leg (s : Cocone (diagram n M Y)) (label : StableOrbitIndex n) :=
    Sigma.ι (Family n M Y (firstAppearance n label)) ⟨label, le_refl _⟩ ≫
      s.ι.app (firstAppearance n label)
  refine IsColimit.mk (fun s => hAll.desc (Cofan.mk s.pt (leg s))) ?_ ?_
  · intro s c
    apply Sigma.hom_ext (f := Family n M Y c)
    intro label
    have hIncl : Sigma.ι (Family n M Y c) label ≫ stageLeg n M Y c =
        (originalNativeSummandInclusionNatTrans n M label.val).app Y :=
      Sigma.ι_comp_desc
        (fun i : Labels n c => (originalNativeSummandInclusionNatTrans n M i.val).app Y) label
    change Sigma.ι (Family n M Y c) label ≫ stageLeg n M Y c ≫
      hAll.desc (Cofan.mk s.pt (leg s)) = Sigma.ι (Family n M Y c) label ≫ s.ι.app c
    have hFac : (originalNativeSummandInclusionNatTrans n M label.val).app Y ≫
        hAll.desc (Cofan.mk s.pt (leg s)) = leg s label.val :=
      hAll.fac (Cofan.mk s.pt (leg s)) (Discrete.mk label.val)
    rw [← Category.assoc, hIncl, hFac]
    have hn := congrArg
      (fun k => Sigma.ι (Family n M Y (firstAppearance n label.val))
        ⟨label.val, le_refl _⟩ ≫ k) (s.w (homOfLE label.property))
    rw [← Category.assoc, Sigma.ι_comp_map', Category.id_comp] at hn
    dsimp only [Family, labelInclusion, leg, Functor.const_obj_obj] at hn ⊢
    exact hn.symm
  · intro s m hm
    apply hAll.hom_ext
    intro label
    have hIncl : Sigma.ι (Family n M Y (firstAppearance n label.as)) ⟨label.as, le_refl _⟩ ≫
        (cocone n M Y).ι.app (firstAppearance n label.as) =
      (originalNativeSummandInclusionNatTrans n M label.as).app Y :=
      Sigma.ι_comp_desc
        (fun i : Labels n (firstAppearance n label.as) =>
          (originalNativeSummandInclusionNatTrans n M i.val).app Y) ⟨label.as, le_refl _⟩
    have hn := congrArg
      (fun k => Sigma.ι (Family n M Y (firstAppearance n label.as)) ⟨label.as, le_refl _⟩ ≫ k)
      (hm (firstAppearance n label.as))
    rw [← Category.assoc, hIncl] at hn
    exact hn.trans (hAll.fac (Cofan.mk s.pt (leg s)) label).symm

/-- Every actual finite-stage transition is genuine based HEP for arbitrary
original coefficients and spectra, through its full coproduct embedding. -/
private theorem diagram_map_basedHEP (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) {c d : ℕ} (h : c ⟶ d) :
    PointedCGWH.EnrichedBasedHomotopyExtension.property ((diagram n M Y).map h) :=
  PointedCGWH.Spectra.OriginalCoproductEmbedding.sigmaEmbedding_basedHEP
    (labelInclusion n (leOfHom h)) (Family n M Y d)

/-- Each original level of every transition in the same diagram is the
actual closed inclusion required by the genuine positive-group colimit theorem. -/
private theorem diagram_map_level_closed (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) {c d : ℕ} (h : c ⟶ d) (r : ℕ) :
    Topology.IsClosedEmbedding (ConcreteCategory.hom
      (PointedCGWH.SequentialSpectrum.levelMap ((diagram n M Y).map h) r).right) :=
  PointedCGWH.Spectra.OriginalCoproductEmbedding.sigmaEmbedding_component_closed
    (labelInclusion n (leOfHom h)) (Family n M Y d)
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r)

/-- Every original input map acts on all actual available native summands. -/
private def coefficientMap (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    diagram n M Y ⟶ diagram n M Z where
  app c := Limits.Sigma.map (fun label : Labels n c =>
    (originalNativeSummandFunctor n M label.val).map f)
  naturality {c d} h := by
    apply Sigma.hom_ext
    intro label
    change Sigma.ι (Family n M Y c) label ≫
        (Limits.Sigma.map' (labelInclusion n (leOfHom h))
          (fun i : Labels n c => 𝟙 (Family n M Y c i)) ≫
          Limits.Sigma.map (fun i : Labels n d => (originalNativeSummandFunctor n M i.val).map f)) =
      Sigma.ι (Family n M Y c) label ≫
        (Limits.Sigma.map (fun i : Labels n c => (originalNativeSummandFunctor n M i.val).map f) ≫
          Limits.Sigma.map' (labelInclusion n (leOfHom h))
            (fun i : Labels n c => 𝟙 (Family n M Z c i)))
    rw [← Category.assoc, Sigma.ι_comp_map', Category.id_comp, Sigma.ι_map,
      ← Category.assoc, Sigma.ι_map, Category.assoc, Sigma.ι_comp_map', Category.id_comp]
    rfl

/-- The full actual finite-stage input map retains every original caller
leg into the unchanged original free-smash restriction. -/
private theorem coefficientMap_leg (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ) :
    stageLeg n M Y c ≫ (originalFreeSmashRestrictionFunctor n M).map f =
      (coefficientMap n M f).app c ≫ stageLeg n M Z c := by
  exact sigmaLegNaturality (fun label : Labels n c => originalNativeSummandFunctor n M label.val)
    (originalFreeSmashRestrictionFunctor n M)
    (fun label => originalNativeSummandInclusionNatTrans n M label.val) f







end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.GrowingOrbitCofan
end

