private theorem functor_map_cast {Z : Type*} [Category Z] (F : I ⥤ Z)
    (a b : ℕ) (h : a = b) :
    F.map (eqToHom (congrArg card h)) = eqToHom (congrArg (fun q => F.obj (card q)) h) := by
  cases h
  change F.map (𝟙 (card a)) = 𝟙 (F.obj (card a))
  exact F.map_id _

private theorem moduleRestriction_sigma (T : Mod C.{u, v} S.{u, v}) (q : ℕ) :
    (underlyingSequential.obj (PointedCGWH.SymmetricModulePresentation.toOperatorFunctor T)).structureMap q =
      (NativeActionSource.circleToCoefficientHom.{u, v} ▷ T.X.functor.obj (card q)) ≫
        PointedCGWH.SymmetricModulePresentation.pairAction T (card 1) (card q) ≫
        T.X.functor.map (NativeActionSource.sequentialPrefixIso q).hom :=
  (symmetricToSequentialSourceStructureMap_eq (PointedCGWH.SymmetricModulePresentation.toOperatorFunctor T) q).trans
    (NativeActionSource.moduleSequential_sigma_left T q)

private theorem originalRightTensor_prefix_cast (c n : ℕ) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (originalRightTensorRestriction (card n) M Y).structureMap (c + n) ≫
        eqToHom (congrArg (originalRightTensorRestriction (card n) M Y).level
          (show c + n + 1 = (c + 1) + n by omega)) =
      (NativeActionSource.circleToCoefficientHom.{u, v} ▷
        (originalRightTensorModule (card n) M Y).X.functor.obj (card (c + n))) ≫
      PointedCGWH.SymmetricModulePresentation.pairAction (originalRightTensorModule (card n) M Y)
        (card 1) (card (c + n)) ≫
      (originalRightTensorModule (card n) M Y).X.functor.map
        (NativeActionSource.actualPrefixIso c n).hom := by
  let T := originalRightTensorModule (card n) M Y
  let R := originalRightTensorRestriction (card n) M Y
  let F := T.X.functor
  let q := NativeActionSource.sequentialPrefixIso (c + n)
  let p := NativeActionSource.actualPrefixIso c n
  let hdeg : c + n + 1 = (c + 1) + n := by omega
  let k : card (c + n + 1) ⟶ card ((c + 1) + n) := eqToHom (congrArg card hdeg)
  let j := NativeActionSource.circleToCoefficientHom.{u, v} ▷ T.X.functor.obj (card (c + n))
  let s := PointedCGWH.SymmetricModulePresentation.pairAction T (card 1) (card (c + n))
  have hσ : R.structureMap (c + n) = j ≫ s ≫ F.map q.hom := moduleRestriction_sigma T (c + n)
  have hcast : eqToHom (congrArg R.level hdeg) = F.map k := (functor_map_cast F _ _ hdeg).symm
  have hmap : F.map q.hom ≫ F.map k = F.map p.hom :=
    (F.map_comp q.hom k).symm.trans (congrArg F.map (NativeOrbitIndex.actualPrefixIso_trans c n))
  have h₁ := congrArg (fun f => f ≫ eqToHom (congrArg R.level hdeg)) hσ
  have h₂ := congrArg (fun f => (j ≫ s ≫ F.map q.hom) ≫ f) hcast
  have h₃ : (j ≫ s ≫ F.map q.hom) ≫ F.map k = j ≫ s ≫ F.map p.hom := by
    simp only [Category.assoc]
    exact congrArg (fun f => j ≫ s ≫ f) hmap
  exact h₁.trans (h₂.trans h₃)

private theorem append_left {Z : Type*} [Category Z] [MonoidalCategory Z]
    {P X Y T : Z} (M : Z) (a : P ⟶ M ⊗ X) (s : X ⟶ Y) (k : Y ⟶ T) :
    (a ≫ (M ◁ s)) ≫ (M ◁ k) = a ≫ (M ◁ (s ≫ k)) :=
  (Category.assoc a (M ◁ s) (M ◁ k)).trans
    (congrArg (fun f => a ≫ f) (whiskerLeft_comp M s k).symm)

private theorem append_left_three {Z : Type*} [Category Z] [MonoidalCategory Z]
    {P X Y T W : Z} (M : Z) (a : P ⟶ M ⊗ X) (j : X ⟶ Y) (s : Y ⟶ T) (k : T ⟶ W) :
    (a ≫ (M ◁ (j ≫ s))) ≫ (M ◁ k) = a ≫ (M ◁ (j ≫ s ≫ k)) :=
  (append_left M a (j ≫ s) k).trans
    (congrArg (fun f => a ≫ (M ◁ f)) (Category.assoc j s k))

private theorem coefficientScalarAction_prefix (c : ℕ) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    NativeDayAction.coefficientScalarAction (PointedCGWH.SymmetricSpectrum.toModule.obj Y)
        (card 1) (card c) M PointedCGWH.sphereOne NativeActionSource.circleToCoefficientHom.{u, v} ≫
      (M ◁ Y.X.functor.map (NativeActionSource.sequentialPrefixIso c).hom) =
    (OrbitTailHelper.scalarRestriction M Y).structureMap c := by
  let X := Y.X.functor.obj (card c)
  let j := NativeActionSource.circleToCoefficientHom.{u, v} ▷ X
  let s := PointedCGWH.SymmetricModulePresentation.pairAction (PointedCGWH.SymmetricSpectrum.toModule.obj Y)
    (card 1) (card c)
  let k := Y.X.functor.map (NativeActionSource.sequentialPrefixIso c).hom
  let a := (α_ PointedCGWH.sphereOne M X).inv
  let b := (β_ PointedCGWH.sphereOne M).hom ▷ X
  let d := (α_ M PointedCGWH.sphereOne X).hom
  have hσ := OrbitTailHelper.scalarRestriction_structure M Y c
  have hp := nativePrefixAction_module Y c
  have h₁ := congrArg (fun f => a ≫ b ≫ d ≫ (M ◁ f)) hp
  have h₂ : (a ≫ b ≫ d ≫ (M ◁ (j ≫ s))) ≫ (M ◁ k) =
      a ≫ b ≫ d ≫ (M ◁ (j ≫ s ≫ k)) := by
    have h := append_left_three M (a ≫ b ≫ d) j s k
    simpa only [Category.assoc] using h
  exact h₂.trans (h₁.symm.trans hσ.symm)

private theorem coefficientFirstDayLeg_generator (c n : ℕ) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    OrbitTailHelper.coefficientFirstDayLeg n M Y c (OrbitTailHelper.originalOrbitBlockIso c n i) =
      NativeDayAction.coefficientFirstGenerator (PointedCGWH.SymmetricSpectrum.toModule.obj Y)
        (card n) (card (c + n)) M (NativeDayAction.originalOrbitBlock c n i) := rfl

private theorem originalFiniteDayStructure (c n : ℕ) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (i : OrbitIndex c n) :
    (PointedCGWH.sphereOne ◁
        OrbitTailHelper.coefficientFirstDayLeg n M Y c (OrbitTailHelper.originalOrbitBlockIso c n i)) ≫
      (originalRightTensorRestriction (card n) M Y).structureMap (c + n) ≫
      eqToHom (congrArg (originalRightTensorRestriction (card n) M Y).level
        (show c + n + 1 = (c + 1) + n by omega)) =
    (OrbitTailHelper.scalarRestriction M Y).structureMap c ≫
      OrbitTailHelper.coefficientFirstDayLeg n M Y (c + 1)
        (OrbitTailHelper.originalOrbitBlockIso (c + 1) n (growOrbit c n i)) := by
  let N := PointedCGWH.SymmetricSpectrum.toModule.obj Y
  let T := originalRightTensorModule (card n) M Y
  let R := originalRightTensorRestriction (card n) M Y
  let l := OrbitTailHelper.coefficientFirstDayLeg n M Y c (OrbitTailHelper.originalOrbitBlockIso c n i)
  let l' := OrbitTailHelper.coefficientFirstDayLeg n M Y (c + 1)
    (OrbitTailHelper.originalOrbitBlockIso (c + 1) n (growOrbit c n i))
  let s := R.structureMap (c + n)
  let k := eqToHom (congrArg R.level (show c + n + 1 = (c + 1) + n by omega))
  let j := (NativeActionSource.circleToCoefficientHom.{u, v} ▷ T.X.functor.obj (card (c + n))) ≫
    PointedCGWH.SymmetricModulePresentation.pairAction T (card 1) (card (c + n)) ≫
      T.X.functor.map (NativeActionSource.actualPrefixIso c n).hom
  let a := NativeDayAction.coefficientScalarAction N (card 1) (card c) M PointedCGWH.sphereOne
    NativeActionSource.circleToCoefficientHom.{u, v}
  let b := M ◁ Y.X.functor.map (NativeActionSource.sequentialPrefixIso c).hom
  let v := (OrbitTailHelper.scalarRestriction M Y).structureMap c
  have hcast : s ≫ k = j := originalRightTensor_prefix_cast c n M Y
  have hday : (PointedCGWH.sphereOne ◁ l) ≫ j = a ≫ b ≫ l' :=
    NativeDayAction.coefficientFirstGenerator_prefix N c n M i
  have hscalar : a ≫ b = v := coefficientScalarAction_prefix c M Y
  have h₁ := Category.assoc (PointedCGWH.sphereOne ◁ l) s k
  have h₂ := congrArg (fun f => (PointedCGWH.sphereOne ◁ l) ≫ f) hcast
  have h₃ := (Category.assoc a b l').symm
  have h₄ := congrArg (fun f => f ≫ l') hscalar
  exact h₁.trans (h₂.trans (hday.trans (h₃.trans h₄)))

private theorem originalDayMap_cast (n a b : ℕ) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (h : a = b) :
    eqToHom (congrArg (OrbitTailHelper.originalFreeSmashRestriction n M Y).level h) ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card b)).hom =
      (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card a)).hom ≫
        eqToHom (congrArg (originalRightTensorRestriction (card n) M Y).level h) :=
  (eqToHom_naturality
    (f := (OrbitTailHelper.originalFreeSmashRestriction n M Y).level)
    (g := (originalRightTensorRestriction (card n) M Y).level)
    (fun q => (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card q)).hom)
    h).symm





end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeStructurePullback
