  PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.monoidalClosed

/-- The whole original scalar interchange is natural in the arbitrary
second spectrum through the actual zero-free representation and associator. -/
private def scalarThroughLeftTensorIso (K : PointedCGWH.{u, v}) (X : C.{u, v}) :
    tensorLeft X ⋙ EnrichedFunctorCat.tensorLeft K ≅
      tensorLeft (tensorLeftObject K X) :=
  Functor.isoWhiskerLeft (tensorLeft X) (tensorScalarIso K).symm ≪≫
    (tensorLeftTensor (zeroFree K) X).symm ≪≫
      (tensoringLeft C.{u, v}).mapIso ((tensorScalarIso K).app X)

/-- The complete original scalar/free comparison and whole scalar smash
interchange identify the two literal balanced-smash functors before an input is chosen. -/
private def originalFreeCoefficientScalarSmashIso (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    (K M : PointedCGWH.{u, v}) :
    tensorLeft (Free.object a (K ⊗ M)) ≅
      tensorLeft (Free.object a M) ⋙ EnrichedFunctorCat.tensorLeft K :=
  ((tensoringLeft C.{u, v}).mapIso (Free.scalarFreeIso K M a)).symm ≪≫
    (scalarThroughLeftTensorIso K (Free.object a M)).symm

/-- The same whole comparison at the unit coefficient retains the actual
free coefficient unitor, both maps and the untouched arbitrary right input. -/
private def originalFreeScalarUnitSmashIso (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    (K : PointedCGWH.{u, v}) :
    tensorLeft (Free.object a K) ≅
      tensorLeft (Free.object a (𝟙_ PointedCGWH.{u, v})) ⋙ EnrichedFunctorCat.tensorLeft K :=
  ((tensoringLeft C.{u, v}).mapIso ((Free.functor a).mapIso (ρ_ K))).symm ≪≫
    originalFreeCoefficientScalarSmashIso a K (𝟙_ PointedCGWH.{u, v})

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]

attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

private abbrev W := NativeK.omegaTests (B := B) Actual.symmetricFamily.{u, v}

/-- The original free finite sphere and original free unit coefficient
give exactly the same Omega tests of each arbitrary original input arrow. -/
private theorem originalFreeSphereSmash_omegaTests_iff_unitCoefficient
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (n : ℕ)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    W (Free.object a (TensorPower.tensorPowObj PointedCGWH.sphereOne n) ◁ f) ↔
      W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) := by
  let K := TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n
  let F := Free.object a (𝟙_ PointedCGWH.{u, v})
  let e := originalFreeScalarUnitSmashIso a K
  let h : Arrow.mk (Free.object a K ◁ f) ≅
      Arrow.mk ((EnrichedFunctorCat.tensorLeft K).map (F ◁ f)) :=
    Arrow.isoMk (e.app X) (e.app Y) (e.hom.naturality f).symm
  exact (W.arrow_mk_iso_iff h).trans
    (OriginalScalarSphere.originalScalarSpherePower_omegaTests_iff n (F ◁ f))

omit B in
/-- Every original signed integer map of the same free sphere smash
is an isomorphism exactly when the free unit coefficient maps are isomorphisms. -/
private theorem originalFreeSphereSmash_integerPi_iff_unitCoefficient
    (a : PointedCGWH.SymmetricOperatorIndex.{u, v}) (n : ℕ)
    {X Y : C.{u, v}} (f : X ⟶ Y) :
    (∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
      (Free.object a (TensorPower.tensorPowObj PointedCGWH.sphereOne n) ◁ f))) ↔
      ∀ q : ℤ, IsIso ((Actual.SymmetricIntegerHomotopy.integerPiFunctor q).map
        (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) := by
  let K := TensorPower.tensorPowObj PointedCGWH.sphereOne.{u, v} n
  let F := Free.object a (𝟙_ PointedCGWH.{u, v})
  let P := Actual.SymmetricIntegerHomotopy.integerPiStarEquivalences.{u, v}
  let _ : P.RespectsIso := by
    dsimp only [P, Actual.SymmetricIntegerHomotopy.integerPiStarEquivalences,
      PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry.integerPiStarEquivalences]
    infer_instance
  let e := originalFreeScalarUnitSmashIso a K
  let h : Arrow.mk (Free.object a K ◁ f) ≅
      Arrow.mk ((EnrichedFunctorCat.tensorLeft K).map (F ◁ f)) :=
    Arrow.isoMk (e.app X) (e.app Y) (e.hom.naturality f).symm
  exact (Actual.SymmetricIntegerHomotopy.integerPiStarEquivalences_iff _).symm.trans
    ((P.arrow_mk_iso_iff h).trans
      ((Actual.SymmetricIntegerHomotopy.integerPiStarEquivalences_iff _).trans
        (OriginalScalarSphere.originalScalarSpherePower_integerPi_iff n (F ◁ f))))







