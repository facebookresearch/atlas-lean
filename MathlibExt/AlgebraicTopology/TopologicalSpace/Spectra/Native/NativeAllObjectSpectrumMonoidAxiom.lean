open _root_.PointedCGWH.Spectra.Orthogonal.CurrentScalarIntegerFullClient.NAMS.O0121 (T)
attribute [local instance] PointedCGWH.EnrichedMapping.hasSmallLimits
  MonoidalClosed.enrichedCategorySelf

/-- Keep a whole group functor family and its scalar comparison together
before any object or group map is projected. -/
private structure ShiftComparisonData (D : Type uC) [Category.{vC} D] where
  groups : ℤ → D ⥤ GrpCat.{uG}
  scalar : D ⥤ D
  comparison : ∀ q : ℤ, groups q ≅ scalar ⋙ groups (q + 1)

/-- The actual original entire scalar and integer functor family. -/
private def originalShiftData : ShiftComparisonData.{_, _, v} C.{u, v} where
  groups := integerPiFunctor.{u, v}
  scalar := T.{u, v}
  comparison := originalScalarIntegerNatIso.{u, v}

/-- This typed receiver retains checked equality to the full original
group, scalar and comparison factory; it adds no assumed field. -/
opaque exactShiftWhole :
    {E : ShiftComparisonData.{_, _, v} C.{u, v} // E = originalShiftData.{u, v}} :=
  ⟨originalShiftData.{u, v}, rfl⟩

/-- Every object, source, target, group structure, map and inverse is the
same entire original data family, before any of its fields is selected. -/
private theorem exactShiftWhole_original : exactShiftWhole.{u, v}.val = originalShiftData.{u, v} :=
  exactShiftWhole.{u, v}.property

/-- The original group family read through its checked whole receiver. -/
private def exactIntegerFunctors := exactShiftWhole.{u, v}.val.groups

/-- The original scalar functor read through the same checked whole receiver. -/
private def exactScalarFunctor := exactShiftWhole.{u, v}.val.scalar

/-- The original comparison family read only after the whole factory is retained. -/
private def exactShiftComparisons := exactShiftWhole.{u, v}.val.comparison

/-- The whole integer functor family is exactly the actual original one. -/
private theorem exactIntegerFunctors_original :
    exactIntegerFunctors.{u, v} = integerPiFunctor.{u, v} :=
  congrArg ShiftComparisonData.groups exactShiftWhole_original

/-- The whole scalar functor is exactly the actual original scalar sphere. -/
private theorem exactScalarFunctor_original : exactScalarFunctor.{u, v} = T.{u, v} :=
  congrArg ShiftComparisonData.scalar exactShiftWhole_original

/-- Both original arbitrary spectrum maps remain in the forward signed
scalar suspension comparison square. -/
private theorem signedScalarForward_naturality (q : ℤ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (exactIntegerFunctors q).map f ≫ (exactShiftComparisons q).hom.app Y =
      (exactShiftComparisons q).hom.app X ≫
        (exactIntegerFunctors (q + 1)).map (exactScalarFunctor.map f) :=
  (exactShiftComparisons q).hom.naturality f

/-- Both unchanged original group maps remain in the inverse scalar
suspension comparison square. -/
private theorem signedScalarInverse_naturality (q : ℤ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    (exactIntegerFunctors (q + 1)).map (exactScalarFunctor.map f) ≫
        (exactShiftComparisons q).inv.app Y =
      (exactShiftComparisons q).inv.app X ≫ (exactIntegerFunctors q).map f :=
  (exactShiftComparisons q).inv.naturality f

/-- The same original scalar group comparison retains both actual inverse
equations on every source and target group element. -/
private theorem signedScalar_inverse_equations (q : ℤ) (X : C.{u, v}) :
    (∀ α : (exactIntegerFunctors q).obj X,
      (exactShiftComparisons q).inv.app X
        ((exactShiftComparisons q).hom.app X α) = α) ∧
      ∀ β : (exactIntegerFunctors (q + 1)).obj (exactScalarFunctor.obj X),
        (exactShiftComparisons q).hom.app X
          ((exactShiftComparisons q).inv.app X β) = β :=
  ⟨GrpCat.inv_hom_apply ((exactShiftComparisons q).app X),
    GrpCat.hom_inv_apply ((exactShiftComparisons q).app X)⟩

/-- Every actual finite scalar sphere power and representation sphere
retains the complete original signed-map preservation and reflection test. -/
private theorem allOriginalScalarSphereIntegerMaps (n : ℕ) {X Y : C.{u, v}} (f : X ⟶ Y) :
    ((∀ q : ℤ, IsIso ((integerPiFunctor q).map
      ((EnrichedFunctorCat.tensorLeft (TensorPower.tensorPowObj PointedCGWH.sphereOne n)).map f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map f)) ∧
    ((∀ q : ℤ, IsIso ((integerPiFunctor q).map
      ((EnrichedFunctorCat.tensorLeft (PointedCGWH.orthogonalSphere.{u, v} n)).map f))) ↔
      ∀ q : ℤ, IsIso ((integerPiFunctor q).map f)) :=
  ⟨originalScalarSpherePower_integerPi_iff n f, originalRepresentationSphere_integerPi_iff n f⟩

