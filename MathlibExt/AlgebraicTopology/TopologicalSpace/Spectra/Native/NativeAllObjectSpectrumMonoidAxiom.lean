/-!
## Original Day generators for the right tensor module action

The inverse associator keeps both nested original convolution generators and
its full index associator. An arbitrary original action arrow then acts on
those same generators by the complete right tensor module action word.
-/

set_option autoImplicit false
noncomputable section
universe uI vI uV vV uD vD
open CategoryTheory MonoidalCategory Limits BraidedCategory

namespace CategoryTheory.MonoidalCategory.LawfulDayConvolutionMonoidalCategoryStruct
variable {I : Type uI} [Category.{vI} I] [MonoidalCategory I]
  {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  {D : Type uD} [Category.{vD} D] [MonoidalCategoryStruct D]
  [LawfulDayConvolutionMonoidalCategoryStruct I V D]

private theorem inverseSquare {C : Type*} [Category C]
    {U U' W W' : C} (e : U ≅ U') (d : W ≅ W') (f : U ⟶ W) (g : U' ⟶ W')
    (h : f ≫ d.hom = e.hom ≫ g) : g ≫ d.inv = e.inv ≫ f := by
  apply (cancel_mono d.hom).1
  rw [Category.assoc, d.inv_hom_id, Category.comp_id, Category.assoc,
    h, e.inv_hom_id_assoc]

private theorem dayAssociator_inv_generator (S X P : D) (a c n : I) :
    (((ι I V D).obj S).obj a ◁ (convolutionExtensionUnit I V X P).app (c, n)) ≫
        (convolutionExtensionUnit I V S (X ⊗ P)).app (a, c ⊗ n) ≫
        ((ι I V D).map (α_ S X P).inv).app (a ⊗ (c ⊗ n)) =
      (α_ (((ι I V D).obj S).obj a) (((ι I V D).obj X).obj c)
        (((ι I V D).obj P).obj n)).inv ≫
        ((convolutionExtensionUnit I V S X).app (a, c) ▷ (((ι I V D).obj P).obj n)) ≫
        (convolutionExtensionUnit I V (S ⊗ X) P).app (a ⊗ c, n) ≫
        ((ι I V D).obj ((S ⊗ X) ⊗ P)).map (α_ a c n).hom := by
  let J : D ⥤ I ⥤ V := ι I V D
  let A := (J.obj S).obj a
  let B := (J.obj X).obj c
  let C := (J.obj P).obj n
  let L := J.obj ((S ⊗ X) ⊗ P)
  let R := J.obj (S ⊗ (X ⊗ P))
  let k := α_ a c n
  let eA : (A ⊗ B) ⊗ C ≅ A ⊗ (B ⊗ C) := α_ A B C
  let eD := (J.mapIso (α_ S X P)).app ((a ⊗ c) ⊗ n)
  let eD' := (J.mapIso (α_ S X P)).app (a ⊗ (c ⊗ n))
  let eI := R.mapIso k
  let e := eD ≪≫ eI
  let f : (A ⊗ B) ⊗ C ⟶ L.obj ((a ⊗ c) ⊗ n) :=
    ((convolutionExtensionUnit I V S X).app (a, c) ▷ C) ≫
      (convolutionExtensionUnit I V (S ⊗ X) P).app (a ⊗ c, n)
  let g : A ⊗ (B ⊗ C) ⟶ R.obj (a ⊗ (c ⊗ n)) :=
    (A ◁ (convolutionExtensionUnit I V X P).app (c, n)) ≫
      (convolutionExtensionUnit I V S (X ⊗ P)).app (a, c ⊗ n)
  have h : f ≫ eD.hom = eA.hom ≫ g ≫ eI.inv := by
    simpa only [f, g, J, A, B, C, L, R, k, eD, eA, eI,
      Functor.mapIso_hom, Functor.mapIso_inv, Iso.app_hom,
      externalProductBifunctor_obj_obj, Category.assoc] using
      (associator_hom_unit_unit V S X P a c n)
  have h' : f ≫ e.hom = eA.hom ≫ g := by
    change f ≫ (eD.hom ≫ eI.hom) = _
    have hh := congrArg (fun z => z ≫ eI.hom) h
    simpa only [Category.assoc, eI.inv_hom_id, Category.comp_id] using hh
  have hg : g ≫ e.inv = eA.inv ≫ f := inverseSquare eA e f g h'
  have hn : eI.hom ≫ eD'.inv = eD.inv ≫ L.map k.hom :=
    (J.map (α_ S X P).inv).naturality k.hom
  have he : e.inv ≫ L.map k.hom = eD'.inv := by
    change (eI.inv ≫ eD.inv) ≫ L.map k.hom = _
    rw [Category.assoc, ← hn, eI.inv_hom_id_assoc]
  have hp := congrArg (fun z => z ≫ L.map k.hom) hg
  have hp' : g ≫ eD'.inv = eA.inv ≫ f ≫ L.map k.hom := by
    simpa only [Category.assoc, he] using hp
  simpa only [f, g, J, A, B, C, L, R, k, eD', eA,
    Functor.mapIso_inv, Iso.app_inv, externalProductBifunctor_obj_obj, Category.assoc] using hp'

private theorem dayRightAction_generator (S X P : D) (s : S ⊗ X ⟶ X) (a c n : I) :
    (((ι I V D).obj S).obj a ◁ (convolutionExtensionUnit I V X P).app (c, n)) ≫
        (convolutionExtensionUnit I V S (X ⊗ P)).app (a, c ⊗ n) ≫
        ((ι I V D).map ((α_ S X P).inv ≫ (s ▷ P))).app (a ⊗ (c ⊗ n)) =
      (α_ (((ι I V D).obj S).obj a) (((ι I V D).obj X).obj c)
        (((ι I V D).obj P).obj n)).inv ≫
        (((convolutionExtensionUnit I V S X).app (a, c) ≫
          ((ι I V D).map s).app (a ⊗ c)) ▷ (((ι I V D).obj P).obj n)) ≫
        (convolutionExtensionUnit I V X P).app (a ⊗ c, n) ≫
        ((ι I V D).obj (X ⊗ P)).map (α_ a c n).hom := by
  let J : D ⥤ I ⥤ V := ι I V D
  let A := (J.obj S).obj a
  let B := (J.obj X).obj c
  let C := (J.obj P).obj n
  let t := J.map (s ▷ P)
  let L := J.obj ((S ⊗ X) ⊗ P)
  let R := J.obj (X ⊗ P)
  let k := (α_ a c n).hom
  let i := (convolutionExtensionUnit I V (S ⊗ X) P).app (a ⊗ c, n)
  let i' := (convolutionExtensionUnit I V X P).app (a ⊗ c, n)
  let j := (convolutionExtensionUnit I V S X).app (a, c)
  let q := (J.map s).app (a ⊗ c)
  have ha := dayAssociator_inv_generator (I := I) (V := V) (D := D) S X P a c n
  have hn : L.map k ≫ t.app (a ⊗ (c ⊗ n)) =
      t.app ((a ⊗ c) ⊗ n) ≫ R.map k := t.naturality k
  have ht : i ≫ t.app ((a ⊗ c) ⊗ n) = (q ▷ C) ≫ i' :=
    convolutionExtensionUnit_comp_ι_map_whiskerRight_app I V s P (a ⊗ c) n
  have h₁ := congrArg (fun z => z ≫ t.app (a ⊗ (c ⊗ n))) ha
  have h₂ := congrArg (fun z => (α_ A B C).inv ≫ (j ▷ C) ≫ i ≫ z) hn
  have h₃ := congrArg (fun z => (α_ A B C).inv ≫ (j ▷ C) ≫ z ≫ R.map k) ht
  simp only [Category.assoc] at h₁ h₂ h₃
  have h := h₁.trans (h₂.trans h₃)
  simpa only [J, A, B, C, L, R, t, k, j, q, i, i', Functor.map_comp, NatTrans.comp_app,
    Category.assoc, comp_whiskerRight] using h

end CategoryTheory.MonoidalCategory.LawfulDayConvolutionMonoidalCategoryStruct
