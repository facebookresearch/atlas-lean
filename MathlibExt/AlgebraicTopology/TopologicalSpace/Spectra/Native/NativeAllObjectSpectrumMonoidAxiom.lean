namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeOrbitIndex

private theorem cardinal_cast {a b : ℕ} (h : a = b) :
    smallFiniteBijection (eqToHom (congrArg card h)) = finCongr h := by
  cases h
  rw [eqToHom_refl, smallFiniteBijection_id]
  rfl

private theorem finiteBijectionSum_cast_left (p m n : ℕ) (h : m = n) :
    Operad.SmallFinBijGroupoid.finiteBijectionSum (finCongr h) (Equiv.refl (Fin p)) =
      finCongr (congrArg (fun q => q + p) h) := by
  cases h
  change Operad.SmallFinBijGroupoid.finiteBijectionSum (Equiv.refl (Fin m)) (Equiv.refl (Fin p)) = Equiv.refl _
  ext i
  dsimp only [Operad.SmallFinBijGroupoid.finiteBijectionSum, Equiv.trans_apply]
  simp only [Equiv.sumCongr_refl, Equiv.refl_apply, Equiv.apply_symm_apply]

private theorem prefix_associator (c n : ℕ) :
    (α_ (card 1) (card c) (card n)).hom ≫ (NativeActionSource.actualPrefixIso c n).hom =
      (NativeActionSource.sequentialPrefixIso c).hom ▷ card n := by
  let a : card ((1 + c) + n) ⟶ card (1 + (c + n)) :=
    (α_ (card 1) (card c) (card n)).hom
  let p : card (1 + (c + n)) ⟶ card ((c + 1) + n) :=
    (NativeActionSource.actualPrefixIso c n).hom
  let e : card ((1 + c) + n) ⟶ card ((c + 1) + n) :=
    (NativeActionSource.sequentialPrefixIso c).hom ▷ card n
  have hα : smallFiniteBijection a = finCongr (Nat.add_assoc 1 c n) :=
    smallFiniteBijection_associator (card 1) (card c) (card n)
  have hp : smallFiniteBijection p =
      finCongr (show 1 + (c + n) = (c + 1) + n by omega) :=
    cardinal_cast (show 1 + (c + n) = (c + 1) + n by omega)
  have he := cardinal_cast (Nat.add_comm 1 c)
  have ht := smallFiniteBijection_tensor (NativeActionSource.sequentialPrefixIso c).hom (𝟙 (card n))
  rw [smallFiniteBijection_id] at ht
  change smallFiniteBijection e =
    Operad.SmallFinBijGroupoid.finiteBijectionSum (smallFiniteBijection (NativeActionSource.sequentialPrefixIso c).hom)
      (Equiv.refl (Fin n)) at ht
  have hE : smallFiniteBijection e =
      finCongr (congrArg (fun q => q + n) (Nat.add_comm 1 c)) :=
    ht.trans ((congrArg (fun f => Operad.SmallFinBijGroupoid.finiteBijectionSum f (Equiv.refl (Fin n))) he).trans
      (finiteBijectionSum_cast_left n (1 + c) (c + 1) (Nat.add_comm 1 c)))
  have hF := smallFiniteBijection_comp a p
  rw [hα, hp] at hF
  have hc : (finCongr (Nat.add_assoc 1 c n)).trans
      (finCongr (show 1 + (c + n) = (c + 1) + n by omega)) =
      finCongr (congrArg (fun q => q + n) (Nat.add_comm 1 c)) := by
    ext i
    rfl
  have hf := hF.trans (hc.trans hE.symm)
  apply Core.hom_ext
  funext z
  exact congrArg (fun f => ULift.up (f z.down)) hf

private theorem actualPrefixIso_trans (c n : ℕ) :
    (NativeActionSource.sequentialPrefixIso (c + n)).hom ≫
        eqToHom (congrArg card (show c + n + 1 = (c + 1) + n by omega)) =
      (NativeActionSource.actualPrefixIso c n).hom := by
  change eqToHom (congrArg card (Nat.add_comm 1 (c + n))) ≫
    eqToHom (congrArg card (show c + n + 1 = (c + 1) + n by omega)) = _
  rw [eqToHom_trans]
  rfl

private theorem conjugation {Z : Type*} [Category Z]
    {X Y T : Z} (a : X ⟶ Y) (p : Y ≅ T) (e : X ⟶ T) (g : Y ⟶ Y) (ha : a ≫ p.hom = e) :
    a ≫ g ≫ p.hom = e ≫ p.inv ≫ g ≫ p.hom := by
  rw [← ha]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]

private theorem orbitBlock_prefix (c n : ℕ) (i : OrbitIndex c n) :
    (α_ (card 1) (card c) (card n)).hom ≫
        (card 1 ◁ (OrbitTailHelper.originalOrbitBlockIso c n i).hom) ≫
        (NativeActionSource.actualPrefixIso c n).hom =
      ((NativeActionSource.sequentialPrefixIso c).hom ▷ card n) ≫
        (OrbitTailHelper.originalOrbitBlockIso (c + 1) n (growOrbit c n i)).hom := by
  let p := NativeActionSource.actualPrefixIso c n
  let a := (α_ (card 1) (card c) (card n)).hom
  let e := (NativeActionSource.sequentialPrefixIso c).hom ▷ card n
  let g := (orbitRepresentative c n i).asIso.hom
  have h₀ : a ≫ p.hom = e := prefix_associator c n
  have h₁ : (OrbitTailHelper.originalOrbitBlockIso (c + 1) n (growOrbit c n i)).hom =
      p.inv ≫ (card 1 ◁ g) ≫ p.hom := by
    have h := NativeActionSource.growAut_prefix c n (orbitRepresentative c n i)
    rw [orbitRepresentative_successor] at h
    change (𝟙 (card ((c + 1) + n))) ≫
      (orbitRepresentative (c + 1) n (growOrbit c n i)).asIso.hom = _
    exact (Category.id_comp _).trans h
  have h₂ : (OrbitTailHelper.originalOrbitBlockIso c n i).hom = g := Category.id_comp g
  rw [h₁, h₂]
  exact conjugation a p e (card 1 ◁ g) h₀

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeOrbitIndex

namespace CategoryTheory.Operad.SmallFinBijGroupoid
variable {V : Type u} [Category.{v} V] [MonoidalCategory V]
  [HasColimitsOfSize.{0, 0} V]
  [∀ X : V, PreservesColimitsOfSize.{0, 0} (tensorLeft X)]
  [∀ X : V, PreservesColimitsOfSize.{0, 0} (tensorRight X)]

private theorem representedTensorGenerator_block (A : DayFunctor SmallFinBijGroupoid V)
    (r m : SmallFinBijGroupoid) (M : V) {d e : BlockDecomposition r m} (f : d ⟶ e) :
    (A.functor.map f.left ▷ M) ≫ representedTensorGenerator A r m M e =
      representedTensorGenerator A r m M d := by
  let B := CostructuredArrow.proj (tensorRight r) m ⋙ A.functor ⋙ tensorRight M
  let k := (representedTensorComponentIso A r m M).inv
  have hw : (A.functor.map f.left ▷ M) ≫ colimit.ι B e = colimit.ι B d := colimit.w B f
  have h₁ := congrArg (fun g => (A.functor.map f.left ▷ M) ≫ g)
    (representedTensorComponentIso_inv_generator A r m M e).symm
  have h₂ := (Category.assoc (A.functor.map f.left ▷ M) (colimit.ι B e) k).symm
  have h₃ := congrArg (fun g => g ≫ k) hw
  have h₄ := representedTensorComponentIso_inv_generator A r m M d
  exact h₁.trans (h₂.trans (h₃.trans h₄))

private def blockPostcompose {r m k : SmallFinBijGroupoid} (d : BlockDecomposition r m) (h : m ⟶ k) :
    BlockDecomposition r k := CostructuredArrow.mk (d.hom ≫ h)

end CategoryTheory.Operad.SmallFinBijGroupoid



