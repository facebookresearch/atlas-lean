/-!
## Original sequential integer groups and finite copowers

The original changing-degree diagonal and its chosen group colimit remain
unchanged. Commutativity is proved on actual common late-stage representatives,
where both homotopy classes have dimension at least two.

The scalar cofiber of the actual first coprojection compares weakly to its
actual quotient, the second summand, by genuine based homotopy extension.
Original scalar-cofiber exactness and both retractions give the binary stable
comparison. Finite induction then preserves actual finite cofans in
commutative groups, including the empty cofan. Every original integer object,
coefficient arrow, inclusion and projection is retained. The finite product
comparison uses these original projections and the product of their original
inclusion images; no coproduct in the category of arbitrary groups is used
as a product.
-/

set_option autoImplicit false
noncomputable section
universe u v w w'

open CategoryTheory Limits HomotopicalAlgebra
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open scoped CGWH.modelCategory ZeroObject

namespace PointedCGWH.Spectra.OriginalSequentialFiniteCopowerIntegerPi

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- Every original integer diagonal becomes abelian at a genuine positive late stage. -/
private theorem integerDiagonal_mul_comm (q : ℤ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (n : ℕ) (hn : 1 ≤ n)
    (a b : ((integerDiagonalDiagramFunctor q).obj X).obj n) : a * b = b * a := by
  let d := integerTailPositiveIndex q + n + 1
  let _ : Nontrivial (Fin d) := Fin.nontrivial_iff_two_le.mpr (by dsimp [d]; omega)
  change (a * b : HomotopyGroup.Pi d
    (CGWH.cgwhToTop.obj (X.level (integerTailLevel q + n)).right)
    (PointedCGWH.underlyingBasepoint (X.level (integerTailLevel q + n)))) = b * a
  exact @mul_comm (HomotopyGroup.Pi d
    (CGWH.cgwhToTop.obj (X.level (integerTailLevel q + n)).right)
    (PointedCGWH.underlyingBasepoint (X.level (integerTailLevel q + n)))) inferInstance a b

/-- Both original quotient representatives commute after mapping to a common late stage. -/
private theorem integerPi_mul_comm (q : ℤ) (X : PointedCGWH.SequentialSpectrum.{u, v})
    (a b : (integerStablePiFunctor q).obj X) : a * b = b * a := by
  let D := (integerDiagonalDiagramFunctor q).obj X
  change (a * b : GrpCat.FilteredColimits.G D) = b * a
  refine Quot.inductionOn a ?_
  intro x
  refine Quot.inductionOn b ?_
  intro y
  let n := max x.1 y.1 + 1
  let f : x.1 ⟶ n := homOfLE (le_trans (le_max_left _ _) (Nat.le_succ _))
  let g : y.1 ⟶ n := homOfLE (le_trans (le_max_right _ _) (Nat.le_succ _))
  change GrpCat.FilteredColimits.G.mk D x * GrpCat.FilteredColimits.G.mk D y =
    GrpCat.FilteredColimits.G.mk D y * GrpCat.FilteredColimits.G.mk D x
  rw [GrpCat.FilteredColimits.colimit_mul_mk_eq D x y n f g,
    GrpCat.FilteredColimits.colimit_mul_mk_eq D y x n g f]
  exact congrArg (fun z => GrpCat.FilteredColimits.G.mk D ⟨n, z⟩)
    (integerDiagonal_mul_comm q X n (by dsimp [n]; omega) (D.map f x.2) (D.map g y.2))

/-- The original integer group has its unchanged operations with proved commutativity. -/
private instance integerPiCommGroup (q : ℤ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    CommGroup ((integerStablePiFunctor q).obj X) :=
  { ((integerStablePiFunctor q).obj X).str with mul_comm := integerPi_mul_comm q X }

/-- The commutative structure retains the entire original chosen group structure. -/
private theorem integerPiCommGroup_toGroup (q : ℤ) (X : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerPiCommGroup q X).toGroup = ((integerStablePiFunctor q).obj X).str := rfl

/-- The commutative lift retains the actual original integer objects and every original map. -/
private def integerStablePiCommFunctor (q : ℤ) :
    PointedCGWH.SequentialSpectrum.{u, v} ⥤ CommGrpCat.{v} where
  obj X := CommGrpCat.of ((integerStablePiFunctor q).obj X)
  map f := CommGrpCat.ofHom ((integerStablePiFunctor q).map f).hom
  map_id X := by
    apply CommGrpCat.hom_ext
    exact congrArg GrpCat.Hom.hom ((integerStablePiFunctor q).map_id X)
  map_comp f g := by
    apply CommGrpCat.hom_ext
    exact congrArg GrpCat.Hom.hom ((integerStablePiFunctor q).map_comp f g)

/-- Forgetting commutativity recovers the entire original integer functor definitionally. -/
private theorem integerStablePiCommFunctor_forget (q : ℤ) :
    integerStablePiCommFunctor.{u, v} q ⋙ forget₂ CommGrpCat GrpCat =
      integerStablePiFunctor q := rfl

/-- Finite commutative-group coproducts are transported through the genuine additive equivalence. -/
private instance commGrpHasFiniteCoproducts : HasFiniteCoproducts CommGrpCat.{v} where
  out n := Adjunction.hasColimitsOfShape_of_equivalence (J := Discrete (Fin n))
    commGroupAddCommGroupEquivalence.functor

/-- Two original integer maps compose by the full original functor law. -/
private theorem integerPi_map_map (q : ℤ) {X Y Z : PointedCGWH.SequentialSpectrum.{u, v}}
    (f : X ⟶ Y) (g : Y ⟶ Z) (x : (integerStablePiFunctor q).obj X) :
    ((integerStablePiFunctor q).map g).hom (((integerStablePiFunctor q).map f).hom x) =
      ((integerStablePiFunctor q).map (f ≫ g)).hom x :=
  (ConcreteCategory.congr_hom ((integerStablePiFunctor q).map_comp f g) x).symm

