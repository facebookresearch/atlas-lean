variable {C : Type u} [Category.{v} C] [MonoidalCategory C]

/-- The original tensor endofunctor and the whole Gamma reduction are retained as one natural action. -/
private structure Action (S : C) where
  functor : C ⥤ C
  reduction : functor ⟶ 𝟭 C
  source : functor = tensorLeft S

/-- Construct the original full Gamma action from its original map and natural left unitor. -/
private def action (S : C) (γ : S ⟶ 𝟙_ C) : Action S where
  functor := tensorLeft S
  reduction := (curriedTensor C).map γ ≫ (leftUnitorNatIso C).hom
  source := rfl

/-- The entire original tensor functor is retained before any native map is projected. -/
private theorem action_functor (S : C) (γ : S ⟶ 𝟙_ C) : (action S γ).functor = tensorLeft S := rfl

/-- Every original Gamma component is its unchanged tensor reduction followed by the original left unitor. -/
private theorem action_reduction (S : C) (γ : S ⟶ 𝟙_ C) (X : C) :
    (action S γ).reduction.app X = γ ▷ X ≫ (λ_ X).hom := rfl

section Model

variable [ModelCategory C]

/-- The mapped source equation uses the whole original tensor functor and natural Gamma action. -/
private def SourceFormula {S : C} (D : Action S) : Prop :=
  ∀ (A Y : C) (_hA : IsCofibrant (D.functor.obj A)) (f : A ⟶ D.functor.obj Y),
    (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (D.reduction.app A ≫ f) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (D.functor.map (f ≫ D.reduction.app Y))

/-- The whole original Gamma action and its physical source equation remain together. -/
private structure FirstJoin (S : C) where
  action : Action S
  first : SourceFormula action

/-- The original represented time cylinder and both physical sphere faces prove the full natural Gamma source equation.
-/
private def firstJoin (T : C) (J : C ⥤ C) (q : Fin 2 → (𝟙_ C ⟶ T))
    (k : Fin 2 → (𝟭 C ⟶ J)) (π : J ⟶ 𝟭 C)
    (D : BalancedTimeRepresentation.Data T J q (fun i X => (k i).app X))
    (h₀ : k 0 ≫ π = 𝟙 (𝟭 C)) (h₁ : k 1 ≫ π = 𝟙 (𝟭 C))
    (hπ : ∀ (X : C), IsCofibrant X → WeakEquivalence (π.app X))
    (S Q : C) (γ : S ⟶ 𝟙_ C) (j : S ⊗ S ≅ Q)
    (H : J.obj Q ⟶ S)
    (e₀ : (k 0).app Q ≫ H = GammaFirstSpanAlgebra.leftFace j γ)
    (e₁ : (k 1).app Q ≫ H = GammaFirstSpanAlgebra.rightFace j γ) : FirstJoin S where
  action := action S γ
  first := by
    intro A Y hA f
    change IsCofibrant (S ⊗ A) at hA
    change A ⟶ S ⊗ Y at f
    have h := BalancedOriginalFirstHomotopy.equation T J q k π D h₀ h₁
      (S ⊗ A) Q S Y (hπ (S ⊗ A) hA)
      (GammaFirstSpanAlgebra.span (Iso.refl (S ⊗ A)) j f) H
      (GammaFirstSpanAlgebra.leftFace j γ) (GammaFirstSpanAlgebra.rightFace j γ) e₀ e₁
    rw [GammaFirstSpanAlgebra.span_left, GammaFirstSpanAlgebra.span_right] at h
    change (_root_.HomotopicalAlgebra.toHomotopyCategory C).map ((γ ▷ A ≫ (λ_ A).hom) ≫ f) =
      (_root_.HomotopicalAlgebra.toHomotopyCategory C).map (S ◁ (f ≫ (γ ▷ Y ≫ (λ_ Y).hom)))
    simpa only [GammaFirstSpanAlgebra.mixedLeft, GammaFirstSpanAlgebra.reduction,
      Iso.refl_hom, Category.id_comp] using h

end Model






end CategoryTheory.GammaFirstNatSource

