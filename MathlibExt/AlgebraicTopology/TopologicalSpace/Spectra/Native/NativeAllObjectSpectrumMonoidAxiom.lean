/-- The original zero spectrum map acts as the identity element in every original integer group. -/
@[simp]
private theorem integerPi_map_zero [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    (x : (integerStablePiFunctor q).obj X) :
    ((integerStablePiFunctor q).map (0 : X ⟶ Y)).hom x = 1 := by
  simpa only [zero_comp] using originalScalarCone_integer_composite_null q
    (0 : X ⟶ originalConeFunctor.obj X) (0 : originalConeFunctor.obj X ⟶ Y) x

/-- The first actual retraction of the original binary spectrum coproduct. -/
private abbrev binaryProjectionLeft (X Y : PointedCGWH.SequentialSpectrum.{u, v}) : X ⨿ Y ⟶ X :=
  coprod.desc (𝟙 X) 0

/-- The second actual retraction of the original binary spectrum coproduct. -/
private abbrev binaryProjectionRight (X Y : PointedCGWH.SequentialSpectrum.{u, v}) : X ⨿ Y ⟶ Y :=
  coprod.desc 0 (𝟙 Y)

/-- Collapsing the actual first summand gives the original second summand as quotient. -/
private theorem binaryProjectionRight_isPushout (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    IsPushout (coprod.inl : X ⟶ X ⨿ Y) (0 : X ⟶ (0 : PointedCGWH.SequentialSpectrum.{u, v}))
      (binaryProjectionRight X Y) (0 : (0 : PointedCGWH.SequentialSpectrum.{u, v}) ⟶ Y) := by
  apply IsPushout.mk' (by simp)
  · intro T φ φ' h _
    have h' := congrArg (fun k => (coprod.inr : Y ⟶ X ⨿ Y) ≫ k) h
    simpa only [Category.assoc, binaryProjectionRight, coprod.inr_desc_assoc,
      Category.id_comp] using h'
  · intro T a b h
    refine ⟨(coprod.inr : Y ⟶ X ⨿ Y) ≫ a, ?_, ?_⟩
    · apply coprod.hom_ext
      · simpa only [Category.assoc, binaryProjectionRight, coprod.inl_desc_assoc,
          zero_comp] using h.symm
      · simp only [binaryProjectionRight, coprod.inr_desc_assoc, Category.id_comp]
    · exact (isZero_zero PointedCGWH.SequentialSpectrum.{u, v}).isInitial.hom_ext _ _

/-- The scalar cofiber map to the actual quotient retains its target and cone legs. -/
private def binaryScalarCofiberProjection (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    originalScalarCofiberFunctor.obj (Arrow.mk (coprod.inl : X ⟶ X ⨿ Y)) ⟶ Y :=
  originalScalarCofiberQuotientComparison (coprod.inl : X ⟶ X ⨿ Y)
    (0 : X ⟶ (0 : PointedCGWH.SequentialSpectrum.{u, v})) (isZero_zero _)
    (binaryProjectionRight X Y) 0 (binaryProjectionRight_isPushout X Y)

/-- The exact scalar-cofiber quotient comparison is level weak by genuine coprojection HEP. -/
private theorem binaryScalarCofiberProjection_weakEquivalence
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    WeakEquivalence (binaryScalarCofiberProjection X Y) :=
  originalScalarCofiberQuotientComparison_weakEquivalence
    (coprod.inl : X ⟶ X ⨿ Y) (PointedCGWH.EnrichedBasedHomotopyExtension.coprod_inl_mem X Y)
    (0 : X ⟶ (0 : PointedCGWH.SequentialSpectrum.{u, v})) (isZero_zero _)
    (binaryProjectionRight X Y) 0 (binaryProjectionRight_isPushout X Y)

/-- The actual quotient comparison is an isomorphism on each unchanged original integer group. -/
private theorem binaryScalarCofiberProjection_integer_isIso
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    IsIso ((integerStablePiFunctor q).map (binaryScalarCofiberProjection X Y)) := by
  let _ : WeakEquivalence (binaryScalarCofiberProjection X Y) :=
    binaryScalarCofiberProjection_weakEquivalence X Y
  exact integerStablePiLevelWeak_isIso q _ (mem_weakEquivalences _)

/-- The original second-projection kernel is the image of the actual first inclusion. -/
private theorem binaryIntegerProjection_kernel_image
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    (x : (integerStablePiFunctor q).obj (X ⨿ Y)) :
    ((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom x = 1 ↔
      ∃ a : (integerStablePiFunctor q).obj X,
        ((integerStablePiFunctor q).map (coprod.inl : X ⟶ X ⨿ Y)).hom a = x := by
  let f : Arrow PointedCGWH.SequentialSpectrum.{u, v} := Arrow.mk (coprod.inl : X ⟶ X ⨿ Y)
  let c := OriginalScalarCone.cofiberTarget functor (inclusionNatTrans 0) (inclusionNatTrans 1) f.hom
  let p := binaryScalarCofiberProjection X Y
  let Q := integerStablePiFunctor q
  let _ : IsIso (Q.map p) := binaryScalarCofiberProjection_integer_isIso q X Y
  have h : Q.map c ≫ Q.map p = Q.map (binaryProjectionRight X Y) := by
    rw [← Q.map_comp]
    exact Q.congr_map (originalScalarCofiberQuotientComparison_target f.hom
      (0 : X ⟶ (0 : PointedCGWH.SequentialSpectrum.{u, v})) (isZero_zero _)
      (binaryProjectionRight X Y) 0 (binaryProjectionRight_isPushout X Y))
  rw [← h, originalGroupMap_kernel_post_iso]
  exact originalScalarCofiber_exact_at_target q f x

/-- The comparison hom uses both original spectrum retractions. -/
private def binaryIntegerProjection (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (X ⨿ Y) →*
      ((integerStablePiFunctor q).obj X × (integerStablePiFunctor q).obj Y) :=
  ((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom.prod
    ((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom

/-- The comparison inverse multiplies the two actual original coprojection images. -/
private def binaryIntegerInclusion (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    ((integerStablePiFunctor q).obj X × (integerStablePiFunctor q).obj Y) →*
      (integerStablePiFunctor q).obj (X ⨿ Y) where
  toFun z := ((integerStablePiFunctor q).map (coprod.inl : X ⟶ X ⨿ Y)).hom z.1 *
    ((integerStablePiFunctor q).map (coprod.inr : Y ⟶ X ⨿ Y)).hom z.2
  map_one' := by simp
  map_mul' a b := by
    simp only [Prod.fst_mul, Prod.snd_mul, map_mul]
    exact mul_mul_mul_comm _ _ _ _

/-- Both genuine retractions split the original multiplicative inclusion map. -/
private theorem binaryIntegerProjection_inclusion
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    (z : (integerStablePiFunctor q).obj X × (integerStablePiFunctor q).obj Y) :
    binaryIntegerProjection q X Y (binaryIntegerInclusion q X Y z) = z := by
  apply Prod.ext <;>
    simp [binaryIntegerProjection, binaryIntegerInclusion, integerPi_map_map,
      binaryProjectionLeft, binaryProjectionRight]

/-- Actual scalar-cofiber exactness and both retractions prove the pair map injective. -/
private theorem binaryIntegerProjection_injective
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    Function.Injective (binaryIntegerProjection q X Y) := by
  apply (injective_iff_map_eq_one _).mpr
  intro x hx
  have hR : ((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom x = 1 :=
    congrArg Prod.snd hx
  obtain ⟨a, ha⟩ := (binaryIntegerProjection_kernel_image q X Y x).mp hR
  have hL : ((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom x = 1 :=
    congrArg Prod.fst hx
  rw [← ha, integerPi_map_map, binaryProjectionLeft, coprod.inl_desc,
    (integerStablePiFunctor q).map_id] at hL
  change a = 1 at hL
  rw [← ha, hL]
  exact map_one _

/-- Every original binary integer class is the product of its two genuine summand images. -/
private theorem binaryIntegerInclusion_projection
    [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    (x : (integerStablePiFunctor q).obj (X ⨿ Y)) :
    binaryIntegerInclusion q X Y (binaryIntegerProjection q X Y x) = x := by
  apply binaryIntegerProjection_injective q X Y
  exact binaryIntegerProjection_inclusion q X Y _

/-- The two actual finite stable comparison maps form an isomorphism of the original group. -/
private def binaryIntegerPiIso [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    (integerStablePiFunctor q).obj (X ⨿ Y) ≅
      GrpCat.of ((integerStablePiFunctor q).obj X × (integerStablePiFunctor q).obj Y) where
  hom := GrpCat.ofHom (binaryIntegerProjection q X Y)
  inv := GrpCat.ofHom (binaryIntegerInclusion q X Y)
  hom_inv_id := by
    apply GrpCat.ext
    intro x
    exact binaryIntegerInclusion_projection q X Y x
  inv_hom_id := by
    apply GrpCat.ext
    intro x
    exact binaryIntegerProjection_inclusion q X Y x

/-- Descending to any commutative group uses the two actual original spectrum retractions. -/
private def binaryIntegerDesc (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    {G : CommGrpCat.{v}} (l : (integerStablePiCommFunctor q).obj X ⟶ G)
    (r : (integerStablePiCommFunctor q).obj Y ⟶ G) :
    (integerStablePiCommFunctor q).obj (X ⨿ Y) ⟶ G :=
  CommGrpCat.ofHom ((l.hom.comp ((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom) *
    (r.hom.comp ((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom))

/-- Every actual first coprojection is retained under the full binary descent. -/
@[reassoc]
private theorem binaryIntegerDesc_inl [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    {G : CommGrpCat.{v}} (l : (integerStablePiCommFunctor q).obj X ⟶ G)
    (r : (integerStablePiCommFunctor q).obj Y ⟶ G) :
    (integerStablePiCommFunctor q).map (coprod.inl : X ⟶ X ⨿ Y) ≫ binaryIntegerDesc q X Y l r = l := by
  dsimp only [integerStablePiCommFunctor] at l r ⊢
  apply CommGrpCat.ext
  intro a
  change l.hom (((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom
      (((integerStablePiFunctor q).map (coprod.inl : X ⟶ X ⨿ Y)).hom a)) *
    r.hom (((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom
      (((integerStablePiFunctor q).map (coprod.inl : X ⟶ X ⨿ Y)).hom a)) = l.hom a
  simp [binaryProjectionLeft, binaryProjectionRight, integerPi_map_map]

/-- Every actual second coprojection is retained under the full binary descent. -/
@[reassoc]
private theorem binaryIntegerDesc_inr [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v})
    {G : CommGrpCat.{v}} (l : (integerStablePiCommFunctor q).obj X ⟶ G)
    (r : (integerStablePiCommFunctor q).obj Y ⟶ G) :
    (integerStablePiCommFunctor q).map (coprod.inr : Y ⟶ X ⨿ Y) ≫ binaryIntegerDesc q X Y l r = r := by
  dsimp only [integerStablePiCommFunctor] at l r ⊢
  apply CommGrpCat.ext
  intro a
  change l.hom (((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom
      (((integerStablePiFunctor q).map (coprod.inr : Y ⟶ X ⨿ Y)).hom a)) *
    r.hom (((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom
      (((integerStablePiFunctor q).map (coprod.inr : Y ⟶ X ⨿ Y)).hom a)) = r.hom a
  simp [binaryProjectionLeft, binaryProjectionRight, integerPi_map_map]

/-- The actual original stable summand maps form a coproduct in commutative groups. -/
private def binaryIntegerCofan_isColimit [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
    (q : ℤ) (X Y : PointedCGWH.SequentialSpectrum.{u, v}) :
    IsColimit (BinaryCofan.mk
      ((integerStablePiCommFunctor q).map (coprod.inl : X ⟶ X ⨿ Y))
      ((integerStablePiCommFunctor q).map (coprod.inr : Y ⟶ X ⨿ Y))) := by
  dsimp only [integerStablePiCommFunctor]
  refine BinaryCofan.IsColimit.mk _ (binaryIntegerDesc q X Y)
    (binaryIntegerDesc_inl q X Y) (binaryIntegerDesc_inr q X Y) ?_
  intro G l r m hL hR
  change CommGrpCat.of ((integerStablePiFunctor q).obj (X ⨿ Y)) ⟶ G at m
  apply CommGrpCat.ext
  intro x
  change m.hom x = l.hom (((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom x) *
    r.hom (((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom x)
  calc
    m.hom x = m.hom (binaryIntegerInclusion q X Y (binaryIntegerProjection q X Y x)) :=
      congrArg m.hom (binaryIntegerInclusion_projection q X Y x).symm
    _ = _ := by
      change m.hom (((integerStablePiFunctor q).map (coprod.inl : X ⟶ X ⨿ Y)).hom
          (((integerStablePiFunctor q).map (binaryProjectionLeft X Y)).hom x) *
        ((integerStablePiFunctor q).map (coprod.inr : Y ⟶ X ⨿ Y)).hom
          (((integerStablePiFunctor q).map (binaryProjectionRight X Y)).hom x)) = _
      rw [map_mul]
      exact congrArg₂ (· * ·) (ConcreteCategory.congr_hom hL _) (ConcreteCategory.congr_hom hR _)

/-- The unchanged original integer functor preserves each actual binary cofan after its commutative lift. -/
