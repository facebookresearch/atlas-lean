retract and literal native Omega comparison form one original source packet. -/
theorem actualOriginalInitialPacket {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {K L : C.{u, v}} (i : K ⟶ L), NativeK.levelI i →
      NativeK.omegaTests Actual.orthogonalFamily (K ◁ f) ∧
        NativeK.omegaTests Actual.orthogonalFamily (L ◁ f))
    (X : C.{u, v}) [IsCofibrant X] :
    Nonempty (RelativeCellComplex.{v}
      (fun (_ : realizedGeneratorCardinal.{v}.ord.ToType) => (NativeK.levelI (I := A.{u, v})).homFamily)
      (OriginalInitialCellSource.initialCellInclusion X)) ∧
    Nonempty (RetractArrow (Diagrams.zeroTo X) (OriginalInitialCellSource.initialCellInclusion X)) ∧
    Nonempty (RetractArrow (X ◁ f) (OriginalInitialCellSource.initialCellObject X ◁ f)) ∧
    NativeK.omegaTests Actual.orthogonalFamily (X ◁ f) :=
  ⟨⟨OriginalInitialCellSource.initialCellComplex X⟩,
    ⟨OriginalInitialCellSource.initialArrowRetract X⟩,
    ⟨OriginalSmashCellComparison.originalInitialSmashComparisonRetract X f⟩,
    OriginalSmashCellComparison.originalCofibrantSmash_omegaTests_of_generatorEndpoints f hEndpoints X⟩

/-- The actual current stable model receives the unchanged literal caller map.
The mathematical inputs left explicit are the genuine I endpoint tests. -/
private theorem actualStableComparison {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {K L : C.{u, v}} (i : K ⟶ L), NativeK.levelI i →
      NativeK.omegaTests Actual.orthogonalFamily (K ◁ f) ∧
        NativeK.omegaTests Actual.orthogonalFamily (L ◁ f))
    (X : C.{u, v}) :
    let : ModelCategory C.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
    IsCofibrant X →
      NativeK.omegaTests Actual.orthogonalFamily (X ◁ f) ∧ weakEquivalences C.{u, v} (X ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.orthogonalModelCategory (B := B)
  change IsCofibrant X →
    NativeK.omegaTests Actual.orthogonalFamily (X ◁ f) ∧ weakEquivalences C.{u, v} (X ◁ f)
  intro hX
  exact ⟨OriginalSmashCellComparison.originalStableCofibrantSmash_omegaTests_of_generatorEndpoints
      f hEndpoints X hX,
    OriginalSmashCellComparison.originalStableCofibrantSmash_weak_of_generatorEndpoints f hEndpoints X hX⟩






