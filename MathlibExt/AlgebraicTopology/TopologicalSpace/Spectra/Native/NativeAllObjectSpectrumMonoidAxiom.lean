variable {W : Type u} [Category.{v} W] [MonoidalCategory W]
  [HasColimitsOfSize.{0, 0} W]

private theorem cardComponentInducedIso_generator_original
    (A : DayFunctor Operad.SmallFinBijGroupoid W) {n m : ℕ} (h : n ≤ m)
    (X : W) (d : BlockDecomposition (card n) (card m)) :
    let _ := blockMulAction (card (m - n)) (card n) (card m)
    colimit.ι (CostructuredArrow.proj (tensorRight (card n)) (card m) ⋙
        A.functor ⋙ tensorRight X) d ≫ (cardComponentInducedIso A h).hom.app X =
      (A.functor.map (cardComplementIso h d).inv ⊗ₘ 𝟙 X) ≫
        colimit.ι (ActionCategory.coefficientDiagram
          (Aut (card (m - n))) (card (m - n) ⊗ card n ≅ card m)
          (A.functor.obj (card (m - n)) ⊗ X)
          (blockCoefficientAction A (card (m - n)) X))
          (cardNormalizedBlock h d :
            ActionCategory (Aut (card (m - n))) (card (m - n) ⊗ card n ≅ card m)) := by
  let _ := blockMulAction (card (m - n)) (card n) (card m)
  let D := CostructuredArrow.proj (tensorRight (card n)) (card m) ⋙
    A.functor ⋙ tensorRight X
  change colimit.ι D d ≫ colimit.desc D (cardInducedForwardCocone A h X) =
    (cardInducedForwardCocone A h X).ι.app d
  exact colimit.ι_desc (cardInducedForwardCocone A h X) d

end CategoryTheory.Mod

namespace CategoryTheory.Operad.SmallFinBijGroupoid

private def originalCardBlock {n m : ℕ} (h : n ≤ m) (g : Aut (card m)) :
    BlockDecomposition (card n) (card m) :=
  CostructuredArrow.mk (Y := card (m - n))
    ((cardBlockSumIso (Nat.sub_add_cancel h)).hom ≫ g.asIso.hom)

private theorem cardIso_card_original (k : ℕ) : cardIso (card k) = Iso.refl (card k) := by
  apply Iso.ext
  rfl

private theorem originalCardBlock_complement {n m : ℕ} (h : n ≤ m) (g : Aut (card m)) :
    cardComplementIso h (originalCardBlock h g) = Iso.refl (card (m - n)) := by
  apply Iso.ext
  change (eqToIso (congrArg card (cardComplement_length h (originalCardBlock h g)).symm)).hom ≫
    (cardIso (card (m - n))).hom = 𝟙 (card (m - n))
  rw [cardIso_card_original]
  change eqToHom (show card (m - n) = card (m - n) from rfl) ≫ 𝟙 _ = 𝟙 _
  rw [eqToHom_refl, Category.id_comp]

private theorem originalCardBlock_normalized {n m : ℕ} (h : n ≤ m) (g : Aut (card m)) :
    cardNormalizedBlock h (originalCardBlock h g) =
      cardBlockSumIso (Nat.sub_add_cancel h) ≪≫ g.asIso := by
  apply Iso.ext
  let b := cardBlockSumIso (Nat.sub_add_cancel h)
  have hk : (cardComplementIso h (originalCardBlock h g)).hom = 𝟙 (card (m - n)) :=
    congrArg Iso.hom (originalCardBlock_complement h g)
  have hm : (tensorRight (card n)).map
      (cardComplementIso h (originalCardBlock h g)).hom = 𝟙 (card (m - n) ⊗ card n) :=
    (congrArg (fun f : card (m - n) ⟶ card (m - n) => (tensorRight (card n)).map f) hk).trans
      ((tensorRight (card n)).map_id (card (m - n)))
  change (tensorRight (card n)).map
      (cardComplementIso h (originalCardBlock h g)).hom ≫ (b.hom ≫ g.asIso.hom) =
    b.hom ≫ g.asIso.hom
  exact (congrArg (fun f => f ≫ (b.hom ≫ g.asIso.hom)) hm).trans (Category.id_comp _)

private theorem originalCardBlock_aut {n m : ℕ} (h : n ≤ m) (g : Aut (card m)) :
    blockIsoEquivAut (card (m - n)) (card n) (card m)
      (cardBlockSumIso (Nat.sub_add_cancel h))
      (cardNormalizedBlock h (originalCardBlock h g)) = g := by
  rw [originalCardBlock_normalized]
  exact (blockIsoEquivAut (card (m - n)) (card n) (card m)
    (cardBlockSumIso (Nat.sub_add_cancel h))).apply_symm_apply g

end CategoryTheory.Operad.SmallFinBijGroupoid

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeCardLeg
private abbrev I := Operad.SmallFinBijGroupoid
private abbrev V := PointedCGWH.{u, v}
private abbrev C := PointedCGWH.SymmetricSequence.{u, v}

attribute [local instance] PointedCGWH.originalSymmetricSequenceMonoidal
  PointedCGWH.originalSymmetricSequenceBraided PointedCGWH.originalSymmetricSequenceSymmetric
  PointedCGWH.copowerUnderlyingEnrichedOrdinary PointedCGWH.copowerUnderlyingMonoidal
  PointedCGWH.EnrichedMapping.hasSmallLimits

private def originalNativeDayIso (A : C.{u, v}) {n m : ℕ} (h : n ≤ m) (M : V.{u, v}) :
    (A ⊗ (representedDiagram (card n)).obj M).functor.obj (card m) ≅
      (PointedCGWH.nativeCardInducedFunctor A h).obj M :=
  representedTensorComponentIso A (card n) (card m) M ≪≫
    (Mod.cardComponentInducedIso A h).app M ≪≫ (PointedCGWH.cardInducedNativeIso A h).app M

private theorem originalNativeDayIso_generator (A : C.{u, v}) {n m : ℕ} (h : n ≤ m)
    (M : V.{u, v}) (g : Aut (card m)) :
    representedTensorGenerator A (card n) (card m) M (originalCardBlock h g) ≫
        (originalNativeDayIso A h M).hom =
      PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
        (Aut (card (m - n))) (Aut (card m)) (A.functor.obj (card (m - n)) ⊗ M)
        (blockCoefficientAction A (card (m - n)) M)
        (blockAutHom (card (m - n)) (card n) (card m)
          (cardBlockSumIso (Nat.sub_add_cancel h))) g := by
  let R := card (m - n)
  let N := card n
  let Q := card m
  let b := cardBlockSumIso (Nat.sub_add_cancel h)
  let d := originalCardBlock h g
  let _ := blockMulAction R N Q
  let D := CostructuredArrow.proj (tensorRight N) Q ⋙ A.functor ⋙ tensorRight M
  let J := PointedCGWH.blockCoefficientDiagram R N Q
    (A.functor.obj R ⊗ M) (blockCoefficientAction A R M)
  let leg : A.functor.obj R ⊗ M ⟶ colimit J :=
    colimit.ι J (cardNormalizedBlock h d : ActionCategory (Aut R) (R ⊗ N ≅ Q))
  let e₁ := representedTensorComponentIso A N Q M
  let e₂ : colimit D ≅ colimit J := (Mod.cardComponentInducedIso A h).app M
  let e₃ := (PointedCGWH.cardInducedNativeIso A h).app M
  have hk : (cardComplementIso h d).inv = 𝟙 R :=
    congrArg Iso.inv (originalCardBlock_complement h g)
  have ha : A.functor.map (cardComplementIso h d).inv = 𝟙 (A.functor.obj R) :=
    (congrArg (fun f : R ⟶ R => A.functor.map f) hk).trans (A.functor.map_id R)
  have ht : (A.functor.map (cardComplementIso h d).inv ⊗ₘ 𝟙 M) =
      𝟙 (A.functor.obj R ⊗ M) :=
    (congrArg (fun f : A.functor.obj R ⟶ A.functor.obj R => f ⊗ₘ 𝟙 M) ha).trans
      (id_tensorHom_id (A.functor.obj R) M)
  have hraw := Mod.cardComponentInducedIso_generator_original A h M d
  change colimit.ι D d ≫ e₂.hom =
    (A.functor.map (cardComplementIso h d).inv ⊗ₘ 𝟙 M) ≫ leg at hraw
  have hf : colimit.ι D d ≫ e₂.hom = leg :=
    hraw.trans ((congrArg (fun f => f ≫ leg) ht).trans (Category.id_comp leg))
  have hb := PointedCGWH.blockCoefficientNativeIso_generator R N Q b
    (A.functor.obj R ⊗ M) (blockCoefficientAction A R M) (cardNormalizedBlock h d)
  have hg := originalCardBlock_aut h g
  have hb' : leg ≫ e₃.hom =
      PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0} (Aut R) (Aut Q)
        (A.functor.obj R ⊗ M) (blockCoefficientAction A R M) (blockAutHom R N Q b) g :=
    hb.trans (congrArg (fun k : Aut Q =>
      PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0} (Aut R) (Aut Q)
        (A.functor.obj R ⊗ M) (blockCoefficientAction A R M) (blockAutHom R N Q b) k) hg)
  have hr : representedTensorGenerator A N Q M d ≫ e₁.hom = colimit.ι D d :=
    representedTensorComponentIso_generator A N Q M d
  let gen : A.functor.obj R ⊗ M ⟶
      (A ⊗ (representedDiagram N).obj M).functor.obj Q := representedTensorGenerator A N Q M d
  have h₁ : gen ≫ (originalNativeDayIso A h M).hom =
      (gen ≫ e₁.hom) ≫ e₂.hom ≫ e₃.hom := by
    simp only [originalNativeDayIso, Iso.trans_hom, Iso.app_hom, Category.assoc]
    rfl
  have h₂ : (gen ≫ e₁.hom) ≫ e₂.hom ≫ e₃.hom = colimit.ι D d ≫ e₂.hom ≫ e₃.hom :=
    congrArg (fun f : A.functor.obj R ⊗ M ⟶ colimit D => f ≫ e₂.hom ≫ e₃.hom) hr
  have h₃ : colimit.ι D d ≫ e₂.hom ≫ e₃.hom = leg ≫ e₃.hom :=
    congrArg (fun f : A.functor.obj R ⊗ M ⟶ colimit J => f ≫ e₃.hom) hf
  exact h₁.trans (h₂.trans (h₃.trans hb'))

private theorem generator_inverse {D : Type*} [Category D]
    {X Y Z : D} (e : Y ≅ Z) (f : X ⟶ Y) (g : X ⟶ Z) (h : f ≫ e.hom = g) :
    g ≫ e.inv = f := by
  exact (congrArg (fun k => k ≫ e.inv) h).symm.trans
    ((Category.assoc _ _ _).trans
      ((congrArg (fun k => f ≫ k) e.hom_inv_id).trans (Category.comp_id f)))

private theorem originalNativeDayIso_inv_generator (A : C.{u, v}) {n m : ℕ} (h : n ≤ m)
    (M : V.{u, v}) (g : Aut (card m)) :
    PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
        (Aut (card (m - n))) (Aut (card m)) (A.functor.obj (card (m - n)) ⊗ M)
        (blockCoefficientAction A (card (m - n)) M)
        (blockAutHom (card (m - n)) (card n) (card m)
          (cardBlockSumIso (Nat.sub_add_cancel h))) g ≫
        (originalNativeDayIso A h M).inv =
      representedTensorGenerator A (card n) (card m) M (originalCardBlock h g) :=
  generator_inverse (originalNativeDayIso A h M) _ _ (originalNativeDayIso_generator A h M g)

attribute [local instance] PointedCGWH.sphereSequenceMonObj PointedCGWH.sphereSequenceIsCommMonObj
  NativeOmegaPreparation.SymmetricFunction.sequenceCoequalizers

private theorem coefficientOrderIso_inv_generator {n m : ℕ} (h : n ≤ m) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (g : Aut (card m)) :
    PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
        (Aut (card (m - n))) (Aut (card m)) (M ⊗ Y.X.functor.obj (card (m - n)))
        (PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y (card (m - n)))
        (blockAutHom (card (m - n)) (card n) (card m)
          (cardBlockSumIso (Nat.sub_add_cancel h))) g ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y).inv =
      (β_ (Y.X.functor.obj (card (m - n))) M).inv ≫
        PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0}
          (Aut (card (m - n))) (Aut (card m)) (Y.X.functor.obj (card (m - n)) ⊗ M)
          (blockCoefficientAction Y.X (card (m - n)) M)
          (blockAutHom (card (m - n)) (card n) (card m)
            (cardBlockSumIso (Nat.sub_add_cancel h))) g := by
  let R := card (m - n)
  let Q := card m
  let Z := Y.X.functor.obj R ⊗ M
  let Z' := M ⊗ Y.X.functor.obj R
  let ρ := blockCoefficientAction Y.X R M
  let ρ' := PointedCGWH.SymmetricSpectrum.freeSmashComplementAction M Y R
  let ι := blockAutHom R (card n) Q (cardBlockSumIso (Nat.sub_add_cancel h))
  let e : Z ≅ Z' := β_ (Y.X.functor.obj R) M
  have hi (a : Aut R) : (ρ' a).asHom ≫ e.inv = e.inv ≫ (ρ a).asHom := by
    apply (cancel_mono e.hom).1
    have hb := PointedCGWH.SymmetricSpectrum.freeSmashComplement_braid M Y R a
    change (ρ a).asHom ≫ e.hom = e.hom ≫ (ρ' a).asHom at hb
    have hp := congrArg (fun f => e.inv ≫ f) hb
    simp only [e.inv_hom_id_assoc] at hp
    simp only [Category.assoc, e.inv_hom_id]
    exact hp.symm
  change PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0} (Aut R) (Aut Q) Z' ρ' ι g ≫
    PointedCGWH.nativeBalancedMap.{u, v, 0, 0} (Aut R) (Aut Q) Z' ρ' ι Z ρ e.inv hi =
    e.inv ≫ PointedCGWH.nativeBalancedGenerator.{u, v, 0, 0} (Aut R) (Aut Q) Z ρ ι g
  exact PointedCGWH.nativeBalancedMap_generator.{u, v, 0, 0}
    (Aut R) (Aut Q) Z' ρ' ι Z ρ e.inv hi g

private theorem inverse_strip_three {D : Type*} [Category D]
    {X₀ X₁ X₂ X₃ X₄ : D} (e₀ : X₀ ≅ X₁) (e₁ : X₁ ≅ X₂)
    (e₂ : X₂ ≅ X₃) (e₃ : X₃ ≅ X₄) :
    (((e₀ ≪≫ e₁) ≪≫ e₂) ≪≫ e₃).inv ≫ e₀.hom =
      e₃.inv ≫ (e₁ ≪≫ e₂).inv := by
  simp only [Iso.trans_inv, Category.assoc, e₀.inv_hom_id, Category.comp_id]

private theorem freeSmashCardOrbitIso_source_heq {n m : ℕ} (h : n ≤ m) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    HEq (PointedCGWH.SymmetricSpectrum.freeSmashCardOrbitIso h M Y)
      (((PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card m) ≪≫
        representedTensorComponentIso Y.X (card n) (card m) M) ≪≫
        ((Mod.cardComponentInducedIso Y.X h).app M ≪≫
          (PointedCGWH.cardInducedNativeIso Y.X h).app M)) ≪≫
        PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y) := by
  rfl

private theorem freeSmashCardOrbitIso_source {n m : ℕ} (h : n ≤ m) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    PointedCGWH.SymmetricSpectrum.freeSmashCardOrbitIso h M Y =
      ((PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card m) ≪≫
        representedTensorComponentIso Y.X (card n) (card m) M) ≪≫
        ((Mod.cardComponentInducedIso Y.X h).app M ≪≫
          (PointedCGWH.cardInducedNativeIso Y.X h).app M)) ≪≫
        PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y := by
  exact eq_of_heq (freeSmashCardOrbitIso_source_heq h M Y)

private theorem freeSmashCardOrbitIso_inv_day_factor {n m : ℕ} (h : n ≤ m) (M : V.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (PointedCGWH.SymmetricSpectrum.freeSmashCardOrbitIso h M Y).inv ≫
        (PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card m)).hom =
      (PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y).inv ≫
        (originalNativeDayIso Y.X h M).inv := by
  let D := PointedCGWH.SymmetricSpectrum.freeSmashDayLevelIso (card n) M Y (card m)
  let e₁ := representedTensorComponentIso Y.X (card n) (card m) M
  let e₂ := (Mod.cardComponentInducedIso Y.X h).app M
  let e₃ := (PointedCGWH.cardInducedNativeIso Y.X h).app M
  let B := PointedCGWH.SymmetricSpectrum.freeSmashCardCoefficientOrderIso h M Y
  rw [freeSmashCardOrbitIso_source]
  exact inverse_strip_three D e₁ (e₂ ≪≫ e₃) B


end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.NativeCardLeg
