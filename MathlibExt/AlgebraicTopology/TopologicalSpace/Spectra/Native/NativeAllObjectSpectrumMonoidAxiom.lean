private def gammaReductionArrowIso (S : I → C) (γ : ∀ i, S i ⟶ 𝟙_ C) (i : I) (X : C) :
    Arrow.mk (γ i ▷ X) ≅ Arrow.mk ((CurrentGammaNaturalReduction.reduction S γ i).app X) :=
  Arrow.isoMk (Iso.refl (S i ⊗ X)) (λ_ X) (by
