variable {C : Type uC} [Category.{vC} C] {D : Type uD} [Category.{vD} D]
  (T : MorphismProperty D) (P : C ⥤ D)

/-- The actual two caller cofans remain colimiting after applying P. -/
private theorem inverseImageCoproducts [T.IsStableUnderCoproducts.{w}]
    [PreservesColimitsOfSize.{w, w} P] :
    (T.inverseImage P).IsStableUnderCoproducts.{w} := by
  refine ⟨fun J => ⟨?_⟩⟩
  intro F G c d hc hd f hf a ha
  exact MorphismProperty.colimitsOfShape_le (W := T) (P.map a)
    (MorphismProperty.colimitsOfShape.mk' _ _ (P.mapCocone c) (P.mapCocone d)
      (isColimitOfPreserves P hc) (isColimitOfPreserves P hd)
      (Functor.whiskerRight f P) hf (P.map a) (fun j => by
        change P.map (c.ι.app j) ≫ P.map a = P.map (f.app j) ≫ P.map (d.ι.app j)
        rw [← P.map_comp, ha j, P.map_comp]))

/-- Cobase closure is transported through the same whole preserved caller square. -/
private theorem inverseImageCobase [T.IsStableUnderCobaseChange]
    [PreservesColimitsOfShape WalkingSpan P] :
    (T.inverseImage P).IsStableUnderCobaseChange := by
  constructor
  intro A A' X X' i z i' z' sq hi
  change T (P.map i')
  have hii : T (P.map i) := hi
  exact MorphismProperty.of_isPushout (P := T) (sq.map P) hii

end PreservedShapes

