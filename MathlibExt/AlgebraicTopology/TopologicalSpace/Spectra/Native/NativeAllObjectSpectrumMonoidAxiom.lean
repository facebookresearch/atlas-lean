attribute [local instance] _root_.NAMS.genericSmallHasColimit _root_.NAMS.genericSmallHasCoproduct

attribute [local instance] _root_.NAMS.SymmetricUnit.originalUnitExtensions

attribute [local instance] _root_.NAMS.smallHasColimit _root_.NAMS.smallHasCoproduct

open scoped CGWH.limits




set_option autoImplicit false
noncomputable section
universe u v

open CategoryTheory Limits
open scoped MonoidalClosed CGWH.limits

namespace PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper

open PointedCGWH.Spectra.OriginalSequentialTailIntegerPi
open PointedCGWH.SequentialSpectrum.MappingTelescope.DiagonalHomotopyGeometry
open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry
open HomotopicalAlgebra.EnrichedProjective.Native.OperatorStabilizationK.Actual.SymmetricIntegerHomotopy

attribute [local instance] CategoryTheory.SequentialSpectrum.EnrichedIndex.enrichedCategory
  PointedCGWH.EnrichedMapping.hasSmallLimits MonoidalClosed.enrichedCategorySelf

/-- The original changing-level positive group map on the whole actual forward source comparison. -/
private def nativeIntegerStageHom (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    ((integerDiagonalDiagramFunctor q).obj (nativeSummand n M Y γ)).obj
      (sourceOffset q n (firstAppearance n γ) + r) ⟶
    ((integerDiagonalDiagramFunctor q).obj
      (truncatedShift n (firstAppearance n γ) (scalarRestriction M Y))).obj
      (sourceOffset q n (firstAppearance n γ) + r) :=
  ((integerDiagonalDiagramFunctor q).map (nativeSummandIso n M Y hσ γ).hom).app
    (sourceOffset q n (firstAppearance n γ) + r)

/-- The original changing-level positive group map on the whole actual inverse source comparison. -/
private def nativeIntegerStageInv (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    ((integerDiagonalDiagramFunctor q).obj
      (truncatedShift n (firstAppearance n γ) (scalarRestriction M Y))).obj
      (sourceOffset q n (firstAppearance n γ) + r) ⟶
    ((integerDiagonalDiagramFunctor q).obj (nativeSummand n M Y γ)).obj
      (sourceOffset q n (firstAppearance n γ) + r) :=
  ((integerDiagonalDiagramFunctor q).map (nativeSummandIso n M Y hσ γ).inv).app
    (sourceOffset q n (firstAppearance n γ) + r)

/-- Every stage hom is the original positive group functor applied to the exact original source level leg. -/
private theorem nativeIntegerStageHom_original (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    nativeIntegerStageHom q n M Y hσ γ r =
      (PointedCGWH.piNPositiveFunctor
        (integerTailPositiveIndex q + (sourceOffset q n (firstAppearance n γ) + r))).map
        (PointedCGWH.SequentialSpectrum.levelMap (nativeSummandIso n M Y hσ γ).hom
          (integerTailLevel q + (sourceOffset q n (firstAppearance n γ) + r))) := rfl

/-- Every stage inverse retains the original positive group functor and the whole inverse level leg. -/
private theorem nativeIntegerStageInv_original (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    nativeIntegerStageInv q n M Y hσ γ r =
      (PointedCGWH.piNPositiveFunctor
        (integerTailPositiveIndex q + (sourceOffset q n (firstAppearance n γ) + r))).map
        (PointedCGWH.SequentialSpectrum.levelMap (nativeSummandIso n M Y hσ γ).inv
          (integerTailLevel q + (sourceOffset q n (firstAppearance n γ) + r))) := rfl

/-- Every retained original native source leg reaches its actual original shifted target leg. -/
private theorem nativeIntegerIso_hom_leg (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    integerStablePiLeg q (nativeSummand n M Y γ) (sourceOffset q n (firstAppearance n γ) + r) ≫
      (nativeIntegerIso q n M Y hσ γ).hom =
    nativeIntegerStageHom q n M Y hσ γ r ≫
      (stageIso q n (firstAppearance n γ) (scalarRestriction M Y) r).hom ≫
        integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
          (targetOffset q (firstAppearance n γ) + r) := by
  let e := (nativeSummandIso n M Y hσ γ).hom
  let f := (comparisonIso q n (firstAppearance n γ) (scalarRestriction M Y)).hom
  let l := integerStablePiLeg q (nativeSummand n M Y γ)
    (sourceOffset q n (firstAppearance n γ) + r)
  let s := nativeIntegerStageHom q n M Y hσ γ r
  let t := integerStablePiLeg q (truncatedShift n (firstAppearance n γ) (scalarRestriction M Y))
    (sourceOffset q n (firstAppearance n γ) + r)
  have hn : l ≫ (integerStablePiFunctor q).map e = s ≫ t :=
    integerStablePiLeg_naturality q e (sourceOffset q n (firstAppearance n γ) + r)
  have ht := comparisonIso_hom_leg q n (firstAppearance n γ) (scalarRestriction M Y) r
  have h1 := (Category.assoc l ((integerStablePiFunctor q).map e) f).symm
  have h2 := congrArg (fun a => a ≫ f) hn
  have h3 := Category.assoc s t f
  have h4 := congrArg (fun a => s ≫ a) ht
  exact h1.trans (h2.trans (h3.trans h4))

/-- Every retained original target leg reaches the actual inverse native source leg. -/
private theorem nativeIntegerIso_inv_leg (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
      (targetOffset q (firstAppearance n γ) + r) ≫ (nativeIntegerIso q n M Y hσ γ).inv =
    (stageIso q n (firstAppearance n γ) (scalarRestriction M Y) r).inv ≫
      nativeIntegerStageInv q n M Y hσ γ r ≫
        integerStablePiLeg q (nativeSummand n M Y γ) (sourceOffset q n (firstAppearance n γ) + r) := by
  let e := (nativeSummandIso n M Y hσ γ).inv
  let f := (comparisonIso q n (firstAppearance n γ) (scalarRestriction M Y)).inv
  let l := integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
    (targetOffset q (firstAppearance n γ) + r)
  let s := (stageIso q n (firstAppearance n γ) (scalarRestriction M Y) r).inv
  let t := integerStablePiLeg q (truncatedShift n (firstAppearance n γ) (scalarRestriction M Y))
    (sourceOffset q n (firstAppearance n γ) + r)
  have hf : l ≫ f = s ≫ t :=
    comparisonIso_inv_leg q n (firstAppearance n γ) (scalarRestriction M Y) r
  have hn := integerStablePiLeg_naturality q e (sourceOffset q n (firstAppearance n γ) + r)
  have h1 := (Category.assoc l f ((integerStablePiFunctor q).map e)).symm
  have h2 := congrArg (fun a => a ≫ (integerStablePiFunctor q).map e) hf
  have h3 := Category.assoc s t ((integerStablePiFunctor q).map e)
  have h4 := congrArg (fun a => s ≫ a) hn
  exact h1.trans (h2.trans (h3.trans h4))

/-- All original source stages, including every early stage, retain their actual native transition. -/
private theorem nativeIntegerIso_hom_leg_all (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    integerStablePiLeg q (nativeSummand n M Y γ) r ≫ (nativeIntegerIso q n M Y hσ γ).hom =
    ((integerDiagonalDiagramFunctor q).obj (nativeSummand n M Y γ)).map
      (homOfLE (Nat.le_add_left r (sourceOffset q n (firstAppearance n γ)))) ≫
      nativeIntegerStageHom q n M Y hσ γ r ≫
        (stageIso q n (firstAppearance n γ) (scalarRestriction M Y) r).hom ≫
          integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
            (targetOffset q (firstAppearance n γ) + r) := by
  let D := (integerDiagonalDiagramFunctor q).obj (nativeSummand n M Y γ)
  let e := (nativeIntegerIso q n M Y hσ γ).hom
  let f := D.map (homOfLE (Nat.le_add_left r (sourceOffset q n (firstAppearance n γ))))
  have h := (GrpCat.FilteredColimits.colimitCocone D).w
    (homOfLE (Nat.le_add_left r (sourceOffset q n (firstAppearance n γ))))
  calc
    _ = (f ≫ integerStablePiLeg q (nativeSummand n M Y γ)
        (sourceOffset q n (firstAppearance n γ) + r)) ≫ e :=
      congrArg (fun a => a ≫ e) h.symm
    _ = f ≫ (integerStablePiLeg q (nativeSummand n M Y γ)
        (sourceOffset q n (firstAppearance n γ) + r) ≫ e) := Category.assoc _ _ _
    _ = _ := congrArg (fun a => f ≫ a) (nativeIntegerIso_hom_leg q n M Y hσ γ r)

/-- All original target stages retain their actual inverse transition to the native source. -/
private theorem nativeIntegerIso_inv_leg_all (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y) r ≫
      (nativeIntegerIso q n M Y hσ γ).inv =
    ((integerDiagonalDiagramFunctor (q + (n : ℤ))).obj (scalarRestriction M Y)).map
      (homOfLE (Nat.le_add_left r (targetOffset q (firstAppearance n γ)))) ≫
      (stageIso q n (firstAppearance n γ) (scalarRestriction M Y) r).inv ≫
        nativeIntegerStageInv q n M Y hσ γ r ≫
          integerStablePiLeg q (nativeSummand n M Y γ) (sourceOffset q n (firstAppearance n γ) + r) := by
  let D := (integerDiagonalDiagramFunctor (q + (n : ℤ))).obj (scalarRestriction M Y)
  let e := (nativeIntegerIso q n M Y hσ γ).inv
  let f := D.map (homOfLE (Nat.le_add_left r (targetOffset q (firstAppearance n γ))))
  have h := (GrpCat.FilteredColimits.colimitCocone D).w
    (homOfLE (Nat.le_add_left r (targetOffset q (firstAppearance n γ))))
  calc
    _ = (f ≫ integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
        (targetOffset q (firstAppearance n γ) + r)) ≫ e := congrArg (fun a => a ≫ e) h.symm
    _ = f ≫ (integerStablePiLeg (q + (n : ℤ)) (scalarRestriction M Y)
        (targetOffset q (firstAppearance n γ) + r) ≫ e) := Category.assoc _ _ _
    _ = _ := congrArg (fun a => f ≫ a) (nativeIntegerIso_inv_leg q n M Y hσ γ r)

/-- The complete original forward integer comparison square holds for every native input arrow. -/
private theorem nativeIntegerIso_hom_naturality (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    (integerStablePiFunctor q).map ((nativeSummandFunctor n M γ hσ hf).map f) ≫
      (nativeIntegerIso q n M Z (hσ Z) γ).hom =
    (nativeIntegerIso q n M Y (hσ Y) γ).hom ≫
      (integerStablePiFunctor (q + (n : ℤ))).map
        ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) :=
  (nativeIntegerNatIso q n M γ hσ hf).hom.naturality f

/-- The entire inverse integer comparison square retains every original native input arrow. -/
private theorem nativeIntegerIso_inv_naturality (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) :
    (integerStablePiFunctor (q + (n : ℤ))).map
      ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) ≫
      (nativeIntegerIso q n M Z (hσ Z) γ).inv =
    (nativeIntegerIso q n M Y (hσ Y) γ).inv ≫
      (integerStablePiFunctor q).map ((nativeSummandFunctor n M γ hσ hf).map f) :=
  (nativeIntegerNatIso q n M γ hσ hf).inv.naturality f

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
end

