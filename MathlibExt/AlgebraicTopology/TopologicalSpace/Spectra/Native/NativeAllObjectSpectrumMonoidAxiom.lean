    ZeroFreeRepresentation.postUnit, Iso.trans_hom, NatTrans.comp_app,
    Functor.isoWhiskerLeft_hom, Functor.isoWhiskerRight_hom, Functor.mapIso_hom,
    Functor.whiskeringRight, Functor.whiskerLeft,
    Functor.whiskerRight, Functor.leftUnitor, Functor.rightUnitor, NatIso.ofComponents,
    Functor.id_map, Functor.id_obj, NatTrans.id_app]
  simp only [Category.assoc]
  erw [Category.id_comp, Category.id_comp, Category.id_comp]
  simpa only [Functor.id_map, Functor.id_obj] using
    (eL.hom.naturality (hS.hom.app X)).symm

/-- The complete represented unit is the same original free-unit tensor and scalar unit. -/
private theorem unit_square (F : V ⥤ C) (S : V ⥤ (C ⥤ C)) (L : C ⥤ C)
    (e : F ⋙ curriedTensor C ≅
      ParametrizedAdjunction.OriginalPostcomposition.left (F := S) (L := L))
    (u : V) (hF : F.obj u ≅ 𝟙_ C) (hS : S.obj u ≅ 𝟭 C) :
    ((PostIdentityRepresentation.whole F S L e
      (ZeroFreeRepresentation.postIsIdentity F S L e u hF hS)).app u).hom ≫ hS.hom =
      (ZeroFreeRepresentation.freeUnitTensor F u hF).hom := by
  unfold ParametrizedAdjunction.OriginalPostcomposition.left at *
  dsimp [PostIdentityRepresentation.whole]
  rw [Category.assoc, postUnit_square]
  simp [ZeroFreeRepresentation.postIsIdentity]




