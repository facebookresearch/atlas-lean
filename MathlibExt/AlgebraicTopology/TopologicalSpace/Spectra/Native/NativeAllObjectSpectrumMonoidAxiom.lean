variable {C : Type uC} [Category.{vC} C] {D : Type uD} [Category.{vD} D] {A : Type uA}
  (T : C ⥤ C) (τ : T ⟶ 𝟭 C) (H : C ⥤ D) (P : C ⥤ GrpCat.{uG})
  (B : A → C) (c : ∀ a, P.obj (B a)) (null : ∀ X Y : C, X ⟶ Y)

/-- The original varying-degree representatives and source-free Gamma group
isomorphisms give surjectivity at every arbitrary original target. -/
private theorem originalGamma_surjective
    (hRep : ∀ Y : C, ∀ β : P.obj Y, ∃ a : A, ∃ f : B a ⟶ Y, β = (P.map f) (c a))
    (hFree : ∀ a : A, IsIso (P.map (τ.app (B a)))) (Y : C) :
    Function.Surjective (P.map (τ.app Y)) := by
  intro β
  obtain ⟨a, f, hβ⟩ := hRep Y β
  let _ : IsIso (P.map (τ.app (B a))) := hFree a
  let e := asIso (P.map (τ.app (B a)))
  have hNat : T.map f ≫ τ.app Y = τ.app (B a) ≫ f := by
    simpa only [Functor.id_map] using τ.naturality f
  refine ⟨(P.map (T.map f)) (e.inv (c a)), ?_⟩
  calc
    (P.map (τ.app Y)) ((P.map (T.map f)) (e.inv (c a))) =
        (P.map (T.map f ≫ τ.app Y)) (e.inv (c a)) := by
      simp only [Functor.map_comp, GrpCat.comp_apply]
    _ = (P.map (τ.app (B a) ≫ f)) (e.inv (c a)) :=
      congrArg (fun m : T.obj (B a) ⟶ Y => (P.map m) (e.inv (c a))) hNat
    _ = (P.map f) (e.hom (e.inv (c a))) := by
      simp only [Functor.map_comp, GrpCat.comp_apply]
      rfl
    _ = (P.map f) (c a) := congrArg (P.map f) (GrpCat.hom_inv_apply e (c a))
    _ = β := hβ.symm

/-- An original stage-advanced kernel representative is killed using only
the actual first-face equation, source-free null preservation, and original
Ho-to-group readback. No arbitrary-target Gamma preservation is an input. -/
private theorem originalGamma_kernel_one
    (hKernel : ∀ Y : C, ∀ α : P.obj (T.obj Y), (P.map (τ.app Y)) α = 1 →
      ∃ a : A, ∃ f : B a ⟶ T.obj Y,
        α = (P.map f) (c a) ∧ H.map (f ≫ τ.app Y) = H.map (null (B a) Y))
    (hFree : ∀ a : A, IsIso (P.map (τ.app (B a))))
    (hFace : ∀ (a : A) (Y : C) (f : B a ⟶ T.obj Y),
      H.map (τ.app (B a) ≫ f) = H.map (T.map (f ≫ τ.app Y)))
    (hNull : ∀ (a : A) (Y : C) (g : B a ⟶ Y), H.map g = H.map (null (B a) Y) →
      H.map (T.map g) = H.map (null (T.obj (B a)) (T.obj Y)))
    (hReadback : ∀ {X Y : C} (f g : X ⟶ Y), H.map f = H.map g → P.map f = P.map g)
    (hNullGroup : ∀ (X Y : C) (x : P.obj X), (P.map (null X Y)) x = 1)
    (Y : C) (α : P.obj (T.obj Y)) (hα : (P.map (τ.app Y)) α = 1) : α = 1 := by
  obtain ⟨a, f, hRep, hNullRep⟩ := hKernel Y α hα
  let _ : IsIso (P.map (τ.app (B a))) := hFree a
  let e := asIso (P.map (τ.app (B a)))
  have hH : H.map (τ.app (B a) ≫ f) = H.map (null (T.obj (B a)) (T.obj Y)) :=
    (hFace a Y f).trans (hNull a Y (f ≫ τ.app Y) hNullRep)
  have hP : P.map (τ.app (B a) ≫ f) = P.map (null (T.obj (B a)) (T.obj Y)) :=
    hReadback _ _ hH
  calc
    α = (P.map f) (c a) := hRep
    _ = (P.map f) (e.hom (e.inv (c a))) := by rw [GrpCat.hom_inv_apply]
    _ = (P.map (τ.app (B a) ≫ f)) (e.inv (c a)) := by
      simp only [Functor.map_comp, GrpCat.comp_apply]
      rfl
    _ = (P.map (null (T.obj (B a)) (T.obj Y))) (e.inv (c a)) :=
      congrArg (fun m : P.obj (T.obj (B a)) ⟶ P.obj (T.obj Y) => m (e.inv (c a))) hP
    _ = 1 := hNullGroup _ _ _

/-- The actual source-representative kernel argument gives injectivity of
the original Gamma map at every arbitrary original target. -/
private theorem originalGamma_injective
    (hKernel : ∀ Y : C, ∀ α : P.obj (T.obj Y), (P.map (τ.app Y)) α = 1 →
      ∃ a : A, ∃ f : B a ⟶ T.obj Y,
        α = (P.map f) (c a) ∧ H.map (f ≫ τ.app Y) = H.map (null (B a) Y))
    (hFree : ∀ a : A, IsIso (P.map (τ.app (B a))))
    (hFace : ∀ (a : A) (Y : C) (f : B a ⟶ T.obj Y),
      H.map (τ.app (B a) ≫ f) = H.map (T.map (f ≫ τ.app Y)))
    (hNull : ∀ (a : A) (Y : C) (g : B a ⟶ Y), H.map g = H.map (null (B a) Y) →
      H.map (T.map g) = H.map (null (T.obj (B a)) (T.obj Y)))
    (hReadback : ∀ {X Y : C} (f g : X ⟶ Y), H.map f = H.map g → P.map f = P.map g)
    (hNullGroup : ∀ (X Y : C) (x : P.obj X), (P.map (null X Y)) x = 1)
    (Y : C) : Function.Injective (P.map (τ.app Y)) := by
  apply (injective_iff_map_eq_one (P.map (τ.app Y)).hom).mpr
  exact originalGamma_kernel_one T τ H P B c null hKernel hFree hFace hNull hReadback hNullGroup Y

/-- Bijectivity of a group-category map supplies its actual categorical inverse. -/
private theorem groupMap_isIso_of_bijective {X Y : GrpCat.{uG}} (f : X ⟶ Y)
    (hf : Function.Bijective f) : IsIso f := by
  let _ : IsIso ((forget GrpCat).map f) := (CategoryTheory.isIso_iff_bijective _).mpr hf
  exact isIso_of_reflects_iso f (forget GrpCat)

/-- The complete original representative, first-face, source-null and readback
joins prove that Gamma induces a group isomorphism at every original target.
Every actual source object, distinguished generator, null word and map remains explicit. -/
private theorem originalGamma_isIso
    (hRep : ∀ Y : C, ∀ β : P.obj Y, ∃ a : A, ∃ f : B a ⟶ Y, β = (P.map f) (c a))
    (hKernel : ∀ Y : C, ∀ α : P.obj (T.obj Y), (P.map (τ.app Y)) α = 1 →
      ∃ a : A, ∃ f : B a ⟶ T.obj Y,
        α = (P.map f) (c a) ∧ H.map (f ≫ τ.app Y) = H.map (null (B a) Y))
    (hFree : ∀ a : A, IsIso (P.map (τ.app (B a))))
    (hFace : ∀ (a : A) (Y : C) (f : B a ⟶ T.obj Y),
      H.map (τ.app (B a) ≫ f) = H.map (T.map (f ≫ τ.app Y)))
    (hNull : ∀ (a : A) (Y : C) (g : B a ⟶ Y), H.map g = H.map (null (B a) Y) →
      H.map (T.map g) = H.map (null (T.obj (B a)) (T.obj Y)))
    (hReadback : ∀ {X Y : C} (f g : X ⟶ Y), H.map f = H.map g → P.map f = P.map g)
    (hNullGroup : ∀ (X Y : C) (x : P.obj X), (P.map (null X Y)) x = 1)
    (Y : C) : IsIso (P.map (τ.app Y)) :=
  groupMap_isIso_of_bijective _
    ⟨originalGamma_injective T τ H P B c null hKernel hFree hFace hNull hReadback hNullGroup Y,
      originalGamma_surjective T τ P B c hRep hFree Y⟩







end CategoryTheory.OriginalGammaPiAssembly

