/-- The original scalar uses exactly the original restriction of the unchanged input spectrum. -/
private abbrev scalarRestriction (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : PointedCGWH.SequentialSpectrum.{u, v} :=
  (EnrichedFunctorCat.tensorLeft M).obj (underlyingSequential.obj Y)

private theorem scalarRestriction_level (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) :
    (scalarRestriction M Y).level c = M ⊗ Y.X.functor.obj (card c) := rfl

/-- The actual scalar keeps the original symmetric prefix action inside its original structure word. -/
private theorem scalarRestriction_structure (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (c : ℕ) :
    (scalarRestriction M Y).structureMap c =
      (α_ PointedCGWH.sphereOne M (Y.X.functor.obj (card c))).inv ≫
        ((β_ PointedCGWH.sphereOne M).hom ▷ Y.X.functor.obj (card c)) ≫
        (α_ M PointedCGWH.sphereOne (Y.X.functor.obj (card c))).hom ≫
        (M ◁ NativeActionSource.nativePrefixAction Y c) := by
  exact (scalarTensor_structureMap M (underlyingSequential.obj Y) c).trans
    (congrArg (fun s =>
      (α_ PointedCGWH.sphereOne M (Y.X.functor.obj (card c))).inv ≫
        ((β_ PointedCGWH.sphereOne M).hom ▷ Y.X.functor.obj (card c)) ≫
        (α_ M PointedCGWH.sphereOne (Y.X.functor.obj (card c))).hom ≫ (M ◁ s))
      (NativeActionSource.nativeRestriction_sigma_left Y c))

/-- Whole scalar input arrows retain the actual original restricted input component. -/
private theorem scalarRestriction_input (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (c : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap
      ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) c =
      M ◁ PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c :=
  EnrichedFunctorCat.tensorLeftMap_component M (underlyingSequential.map f)
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne c)

/-- The original finite-cofan successor square, before selecting a stable summand. -/
private def FiniteStructureSquare (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) : Prop :=
  ∀ (c : ℕ) (i : OrbitIndex c n),
    (PointedCGWH.sphereOne ◁ finiteNativeLeg c n M Y i) ≫
      (originalFreeSmashRestriction n M Y).structureMap (c + n) ≫
      eqToHom (congrArg (originalFreeSmashRestriction n M Y).level
        (show c + n + 1 = (c + 1) + n by omega)) =
    (scalarRestriction M Y).structureMap c ≫ finiteNativeLeg (c + 1) n M Y (growOrbit c n i)

/-- Restriction to the actual next finite projection reads off the exact original scalar successor. -/
private theorem selectedNativeStructure_of_square (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (c : ℕ) (h : firstAppearance n γ ≤ c) :
    selectedNativeStructure n M Y γ c h = (scalarRestriction M Y).structureMap c := by
  let i := activeOrbit n γ c h
  let j := activeOrbit n γ (c + 1) (by omega)
  let p := finiteNativeProjection (c + 1) n M Y j
  let s := (scalarRestriction M Y).structureMap c
  have hGrow : growOrbit c n i = j := activeOrbit_successor n γ c h
  have hSplit : finiteNativeLeg (c + 1) n M Y (growOrbit c n i) ≫ p = 𝟙 _ :=
    (congrArg (fun k => finiteNativeLeg (c + 1) n M Y k ≫ p) hGrow).trans
      (finiteNativeLeg_projection (c + 1) n M Y j)
  have hPost := congrArg (fun f => f ≫ p) (hσ c i)
  have hAssoc := Category.assoc s (finiteNativeLeg (c + 1) n M Y (growOrbit c n i)) p
  have hCollapse := congrArg (fun f => s ≫ f) hSplit
  have hEnd := hPost.trans (hAssoc.trans (hCollapse.trans (Category.comp_id s)))
  exact hEnd

/-- The actual source level function has the same original levels as the requested tail target. -/
private theorem nativeSummandLevel_eq_truncated (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (γ : StableOrbitIndex n) :
    nativeSummandLevel n M Y γ = truncatedLevel n (firstAppearance n γ) (scalarRestriction M Y) :=
  rfl

/-- The original finite-cofan square identifies every source successor, including all endpoint casts. -/
private theorem nativeSummandStructure_eq_truncated (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    nativeSummandStructure n M Y γ r =
      truncatedStructureMap n (firstAppearance n γ) (scalarRestriction M Y) r := by
  by_cases h : n + firstAppearance n γ ≤ r
  · simp only [nativeSummandStructure, truncatedStructureMap, dite_eq_left h]
    rw [selectedNativeStructure_of_square n M Y hσ]
    rfl
  · simp only [nativeSummandStructure, truncatedStructureMap, dite_eq_right h]
    rfl

/-- This comparison concerns the actual source extracted from native orbit legs. -/
private theorem rawNativeSummand_eq_truncated (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    rawNativeSummand n M Y γ = rawTruncatedShift n (firstAppearance n γ) (scalarRestriction M Y) := by
  apply PointedCGWH.Spectra.OriginalSequentialTailIntegerPi.rawSpectrum_ext
  · exact nativeSummandLevel_eq_truncated n M Y γ
  · intro r
    exact heq_of_eq (nativeSummandStructure_eq_truncated n M Y hσ γ r)

private theorem identity_structure_square {D : Type uD} [Category.{vD} D] [MonoidalCategory D]
    (K A B : D) (f g : K ⊗ A ⟶ B) (h : f = g) :
    (K ◁ 𝟙 A) ≫ g = f ≫ 𝟙 B := by
  simpa only [whiskerLeft_id, Category.id_comp, Category.comp_id] using h.symm

/-- The two original left spectra are compared by identities at their exact original levels. -/
private def rawNativeSummandIso (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    rawNativeSummand n M Y γ ≅ rawTruncatedShift n (firstAppearance n γ) (scalarRestriction M Y) where
  hom :=
    { levelMap := fun r => 𝟙 (nativeSummandLevel n M Y γ r)
      naturality := fun r => by
        exact identity_structure_square PointedCGWH.sphereOne
          (nativeSummandLevel n M Y γ r) (nativeSummandLevel n M Y γ (r + 1))
          (nativeSummandStructure n M Y γ r)
          (truncatedStructureMap n (firstAppearance n γ) (scalarRestriction M Y) r)
          (nativeSummandStructure_eq_truncated n M Y hσ γ r) }
  inv :=
    { levelMap := fun r => 𝟙 (nativeSummandLevel n M Y γ r)
      naturality := fun r => by
        exact identity_structure_square PointedCGWH.sphereOne
          (nativeSummandLevel n M Y γ r) (nativeSummandLevel n M Y γ (r + 1))
          (truncatedStructureMap n (firstAppearance n γ) (scalarRestriction M Y) r)
          (nativeSummandStructure n M Y γ r)
          (nativeSummandStructure_eq_truncated n M Y hσ γ r).symm }
  hom_inv_id := by
    apply CategoryTheory.SequentialSpectrum.hom_ext
    intro r
    exact Category.id_comp _
  inv_hom_id := by
    apply CategoryTheory.SequentialSpectrum.hom_ext
    intro r
    exact Category.id_comp _

/-- The resulting comparison preserves the full original enriched actions. -/
private def nativeSummandIso (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    nativeSummand n M Y γ ≅
      truncatedShift n (firstAppearance n γ) (scalarRestriction M Y) :=
  (toEnrichedFunctors PointedCGWH.sphereOne).mapIso (rawNativeSummandIso n M Y hσ γ)

private theorem projected_comp {D : Type uD} [Category.{vD} D]
    {A B C E : D} (l : A ⟶ B) (f : B ⟶ C) (s : A ⟶ E) (k : E ⟶ C) (p : C ⟶ E)
    (h : l ≫ f = s ≫ k) (hk : k ≫ p = 𝟙 E) : l ≫ f ≫ p = s := by
  rw [← Category.assoc, h, Category.assoc, hk, Category.comp_id]

/-- The finite orbit input square retains the entire original native free smash input arrow. -/
private def FiniteInputSquare (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) : Prop :=
  ∀ (c : ℕ) (i : OrbitIndex c n),
    finiteNativeLeg c n M Y i ≫ nativeFreeSmashInputLevel n M f c =
    (M ◁ PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c) ≫
      finiteNativeLeg c n M Z i

/-- Projection of the original finite input square is the actual original scalar input map. -/
private theorem selectedNativeInput_of_square (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (hf : FiniteInputSquare n M f)
    (γ : StableOrbitIndex n) (c : ℕ) (h : firstAppearance n γ ≤ c) :
    selectedNativeInput n M f γ c h =
      M ◁ PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c := by
  exact projected_comp (finiteNativeLeg c n M Y (activeOrbit n γ c h))
    (nativeFreeSmashInputLevel n M f c)
    (M ◁ PointedCGWH.SequentialSpectrum.levelMap (underlyingSequential.map f) c)
    (finiteNativeLeg c n M Z (activeOrbit n γ c h))
    (finiteNativeProjection c n M Z (activeOrbit n γ c h))
    (hf c (activeOrbit n γ c h)) (finiteNativeLeg_projection c n M Z (activeOrbit n γ c h))

/-- Every source input component is extracted from its original native selected orbit arrows. -/
private def nativeSummandInputLevel (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z)
    (γ : StableOrbitIndex n) (r : ℕ) :
    nativeSummandLevel n M Y γ r ⟶ nativeSummandLevel n M Z γ r := by
  by_cases h : n + firstAppearance n γ ≤ r
  · exact eqToHom (nativeSummandLevel_above n M Y γ r h) ≫
      selectedNativeInput n M f γ (r - n) (by omega) ≫
      eqToHom (nativeSummandLevel_above n M Z γ r h).symm
  · exact eqToHom (nativeSummandLevel_below n M Y γ r (Nat.lt_of_not_ge h)) ≫
      initial.to (nativeSummandLevel n M Z γ r)

/-- The finite native input square identifies all whole source components with the original target ones. -/
private theorem nativeSummandInputLevel_eq_truncated (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (hf : FiniteInputSquare n M f)
    (γ : StableOrbitIndex n) (r : ℕ) :
    nativeSummandInputLevel n M f γ r =
      truncatedLevelMap n (firstAppearance n γ)
        ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) r := by
  by_cases h : n + firstAppearance n γ ≤ r
  · simp only [nativeSummandInputLevel, truncatedLevelMap, dite_eq_left h]
    rw [selectedNativeInput_of_square n M f hf, scalarRestriction_input]
    rfl
  · simp only [nativeSummandInputLevel, truncatedLevelMap, dite_eq_right h]
    rfl

/-- The source's actual input components form a morphism of original left spectra. -/
private def rawNativeSummandMap (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}}
    (hY : FiniteStructureSquare n M Y) (hZ : FiniteStructureSquare n M Z)
    (f : Y ⟶ Z) (hf : FiniteInputSquare n M f) (γ : StableOrbitIndex n) :
    rawNativeSummand n M Y γ ⟶ rawNativeSummand n M Z γ where
  levelMap := nativeSummandInputLevel n M f γ
  naturality r := by
    change (PointedCGWH.sphereOne ◁ nativeSummandInputLevel n M f γ r) ≫
      nativeSummandStructure n M Z γ r =
      nativeSummandStructure n M Y γ r ≫ nativeSummandInputLevel n M f γ (r + 1)
    rw [nativeSummandInputLevel_eq_truncated n M f hf,
      nativeSummandInputLevel_eq_truncated n M f hf,
      nativeSummandStructure_eq_truncated n M Z hZ,
      nativeSummandStructure_eq_truncated n M Y hY]
    exact (rawTruncatedShiftMap n (firstAppearance n γ)
      ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f))).naturality r

/-- This whole native arrow retains all Hom-object naturality of the actual source components. -/
private def nativeSummandMap (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}}
    (hY : FiniteStructureSquare n M Y) (hZ : FiniteStructureSquare n M Z)
    (f : Y ⟶ Z) (hf : FiniteInputSquare n M f) (γ : StableOrbitIndex n) :
    nativeSummand n M Y γ ⟶ nativeSummand n M Z γ :=
  toEnrichedFunctorMap PointedCGWH.sphereOne (rawNativeSummandMap n M hY hZ f hf γ)

private theorem nativeSummandMap_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}}
    (hY : FiniteStructureSquare n M Y) (hZ : FiniteStructureSquare n M Z)
    (f : Y ⟶ Z) (hf : FiniteInputSquare n M f) (γ : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (nativeSummandMap n M hY hZ f hf γ) r =
      nativeSummandInputLevel n M f γ r :=
  toEnrichedFunctorMap_component PointedCGWH.sphereOne (rawNativeSummandMap n M hY hZ f hf γ)
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r)

/-- Every complete forward source comparison component is the actual identity of its original level. -/
private theorem nativeSummandIso_hom_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (nativeSummandIso n M Y hσ γ).hom r =
      𝟙 (nativeSummandLevel n M Y γ r) := by
  exact toEnrichedFunctorMap_component PointedCGWH.sphereOne (rawNativeSummandIso n M Y hσ γ).hom
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r)

/-- Every inverse source comparison component retains the same original identity level map. -/
private theorem nativeSummandIso_inv_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap (nativeSummandIso n M Y hσ γ).inv r =
      𝟙 (nativeSummandLevel n M Y γ r) := by
  exact toEnrichedFunctorMap_component PointedCGWH.sphereOne (rawNativeSummandIso n M Y hσ γ).inv
    (CategoryTheory.SequentialSpectrum.EnrichedIndex.degree PointedCGWH.sphereOne r)

/-- The whole enriched source comparison is natural in the actual original input arrow. -/
private theorem nativeSummandIso_naturality (n : ℕ) (M : PointedCGWH.{u, v})
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}}
    (hY : FiniteStructureSquare n M Y) (hZ : FiniteStructureSquare n M Z)
    (f : Y ⟶ Z) (hf : FiniteInputSquare n M f) (γ : StableOrbitIndex n) :
    nativeSummandMap n M hY hZ f hf γ ≫ (nativeSummandIso n M Z hZ γ).hom =
      (nativeSummandIso n M Y hY γ).hom ≫
      truncatedShiftMap n (firstAppearance n γ)
        ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) := by
  apply PointedCGWH.SequentialSpectrum.hom_ext
  intro r
  rw [PointedCGWH.SequentialSpectrum.levelMap_comp,
    PointedCGWH.SequentialSpectrum.levelMap_comp, nativeSummandMap_levelMap,
    nativeSummandIso_hom_levelMap, nativeSummandIso_hom_levelMap,
    truncatedShiftMap_levelMap]
  let k : nativeSummandLevel n M Y γ r ⟶ nativeSummandLevel n M Z γ r :=
    nativeSummandInputLevel n M f γ r
  let b : nativeSummandLevel n M Y γ r ⟶ nativeSummandLevel n M Z γ r :=
    truncatedLevelMap n (firstAppearance n γ)
      ((EnrichedFunctorCat.tensorLeft M).map (underlyingSequential.map f)) r
  have h : k = b := nativeSummandInputLevel_eq_truncated n M f hf γ r
  exact (Category.comp_id k).trans (h.trans (Category.id_comp b).symm)

private def functorOfComponentSquares {C : Type uC} [Category.{vC} C]
    {D : Type uD} [Category.{vD} D] (T : C ⥤ D) (O : C → D)
    (m : ∀ {X Y : C}, (X ⟶ Y) → (O X ⟶ O Y)) (e : ∀ X, O X ≅ T.obj X)
    (he : ∀ {X Y : C} (f : X ⟶ Y), m f ≫ (e Y).hom = (e X).hom ≫ T.map f) : C ⥤ D where
  obj := O
  map := m
  map_id X := by
    apply (cancel_mono (e X).hom).mp
    rw [he, T.map_id, Category.comp_id, Category.id_comp]
  map_comp {X Y Z} f g := by
    apply (cancel_mono (e Z).hom).mp
    calc
      _ = (e X).hom ≫ T.map (f ≫ g) := he (f ≫ g)
      _ = (e X).hom ≫ T.map f ≫ T.map g := by rw [T.map_comp]
      _ = (m f ≫ (e Y).hom) ≫ T.map g := by rw [he f, Category.assoc]
      _ = m f ≫ ((e Y).hom ≫ T.map g) := Category.assoc _ _ _
      _ = m f ≫ (m g ≫ (e Z).hom) :=
        congrArg (fun k => m f ≫ k) (he g).symm
      _ = (m f ≫ m g) ≫ (e Z).hom := (Category.assoc _ _ _).symm

/-- The complete source functor retains the original native selected input components. -/
private def nativeSummandFunctor (n : ℕ) (M : PointedCGWH.{u, v}) (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f) :
    PointedCGWH.SymmetricSpectrum.{u, v} ⥤ PointedCGWH.SequentialSpectrum.{u, v} :=
  functorOfComponentSquares
    (underlyingSequential ⋙ EnrichedFunctorCat.tensorLeft M ⋙
      truncatedShiftFunctor n (firstAppearance n γ))
    (fun Y => nativeSummand n M Y γ)
    (fun {Y Z} f => nativeSummandMap n M (hσ Y) (hσ Z) f (hf f) γ)
    (fun Y => nativeSummandIso n M Y (hσ Y) γ)
    (fun {Y Z} f => nativeSummandIso_naturality n M (hσ Y) (hσ Z) f (hf f) γ)

/-- The whole original orbit summand comparison preserves all native actions and input arrows. -/
private def nativeSummandNatIso (n : ℕ) (M : PointedCGWH.{u, v}) (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f) :
    nativeSummandFunctor n M γ hσ hf ≅
      underlyingSequential ⋙ EnrichedFunctorCat.tensorLeft M ⋙
        truncatedShiftFunctor n (firstAppearance n γ) :=
  NatIso.ofComponents (fun Y => nativeSummandIso n M Y (hσ Y) γ)
    (fun {Y Z} f => nativeSummandIso_naturality n M (hσ Y) (hσ Z) f (hf f) γ)

/-- Every actual original source component is still the selected native input composite. -/
private theorem nativeSummandFunctor_map_levelMap (n : ℕ) (M : PointedCGWH.{u, v})
    (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f)
    {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z) (r : ℕ) :
    PointedCGWH.SequentialSpectrum.levelMap ((nativeSummandFunctor n M γ hσ hf).map f) r =
      nativeSummandInputLevel n M f γ r :=
  nativeSummandMap_levelMap n M (hσ Y) (hσ Z) f (hf f) γ r

open PointedCGWH.SequentialSpectrum.MappingTelescope.IntegerStablePiGeometry

/-- Every integer comparison is applied to the actual native summand and its whole source Iso. -/
private def nativeIntegerIso (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    (integerStablePiFunctor q).obj (nativeSummand n M Y γ) ≅
      (integerStablePiFunctor (q + (n : ℤ))).obj (scalarRestriction M Y) :=
  (integerStablePiFunctor q).mapIso (nativeSummandIso n M Y hσ γ) ≪≫
    comparisonIso q n (firstAppearance n γ) (scalarRestriction M Y)

/-- The full forward group arrow retains the original source comparison and both original tail arrows. -/
private theorem nativeIntegerIso_hom (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    (nativeIntegerIso q n M Y hσ γ).hom =
      (integerStablePiFunctor q).map (nativeSummandIso n M Y hσ γ).hom ≫
        (comparisonIso q n (firstAppearance n γ) (scalarRestriction M Y)).hom := rfl

/-- The inverse group arrow retains both original tail arrows and the actual inverse source comparison. -/
private theorem nativeIntegerIso_inv (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) (hσ : FiniteStructureSquare n M Y)
    (γ : StableOrbitIndex n) :
    (nativeIntegerIso q n M Y hσ γ).inv =
      (comparisonIso q n (firstAppearance n γ) (scalarRestriction M Y)).inv ≫
        (integerStablePiFunctor q).map (nativeSummandIso n M Y hσ γ).inv := rfl

/-- All integer group comparisons are natural under the same original native input arrows. -/
private def nativeIntegerNatIso (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v}) (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f) :
    nativeSummandFunctor n M γ hσ hf ⋙ integerStablePiFunctor q ≅
      underlyingSequential ⋙ EnrichedFunctorCat.tensorLeft M ⋙
        integerStablePiFunctor (q + (n : ℤ)) :=
  Functor.isoWhiskerRight (nativeSummandNatIso n M γ hσ hf) (integerStablePiFunctor q) ≪≫
    Functor.isoWhiskerLeft (underlyingSequential ⋙ EnrichedFunctorCat.tensorLeft M)
      (comparisonNatIso q n (firstAppearance n γ))

/-- Every component of the whole integer natural Iso is the complete original group Iso. -/
private theorem nativeIntegerNatIso_app (q : ℤ) (n : ℕ) (M : PointedCGWH.{u, v})
    (γ : StableOrbitIndex n)
    (hσ : ∀ Y : PointedCGWH.SymmetricSpectrum.{u, v}, FiniteStructureSquare n M Y)
    (hf : ∀ {Y Z : PointedCGWH.SymmetricSpectrum.{u, v}} (f : Y ⟶ Z), FiniteInputSquare n M f)
    (Y : PointedCGWH.SymmetricSpectrum.{u, v}) :
    (nativeIntegerNatIso q n M γ hσ hf).app Y = nativeIntegerIso q n M Y (hσ Y) γ := rfl

end PointedCGWH.Spectra.NativeStableMonoidal.SymmetricSmash.MMSS12_3.OrbitTailHelper
