private def literalFreeUnitReflection : Prop :=
  CategoryTheory.OriginalGammaExactQuiverTransport.Statement
    (C := EnrichedFunctorCat PointedCGWH.{u, v} OrthogonalOperatorIndex.{u, v})
    (fun a : OrthogonalOperatorIndex.{u, v} => Free.object a (𝟙_ PointedCGWH.{u, v}))
    (OriginalGammaOmegaProperty.omegaProperty (B := B))

/-- Both the original operator roundtrip and predicate equality are eliminated
on entire source families before the original mapped arrow is selected. -/
private theorem originalLiteralFreeUnitReflection : literalFreeUnitReflection.{u, v} (B := B) :=
  CategoryTheory.OriginalGammaExactQuiverTransport.transport
    (fun a : OrthogonalOperatorIndex.{u, v} =>
      Free.object (OrthogonalOperatorIndex.ofIndex a.asIndex) (𝟙_ PointedCGWH.{u, v}))
    (fun a : OrthogonalOperatorIndex.{u, v} => Free.object a (𝟙_ PointedCGWH.{u, v}))
    (by
      funext a
      exact congrArg (fun b : OrthogonalOperatorIndex.{u, v} => Free.object b (𝟙_ PointedCGWH.{u, v}))
        (OriginalFiniteFreeEndpoints.originalOperator_roundTrip a))
    (OriginalGammaOmegaProperty.omegaProperty.{u, v} (B := B))
    (OriginalGammaOmegaProperty.omegaProperty.{u, v} (B := B)) rfl
    (fun a {_ _} f =>
      (CategoryTheory.OriginalGammaExactQuiverTransport.source_formula_eq
        ((fun b : OrthogonalOperatorIndex.{u, v} =>
          Free.object (OrthogonalOperatorIndex.ofIndex b.asIndex) (𝟙_ PointedCGWH.{u, v})) a)
        (Free.object (OrthogonalOperatorIndex.ofIndex a.asIndex) (𝟙_ PointedCGWH.{u, v}))
        rfl (OriginalGammaOmegaProperty.omegaProperty.{u, v} (B := B)) f).trans
        (OriginalNativeFreeUnitComposition.nativeFreeUnit_iff (B := B) a.asIndex f))

