        (Free.object (PointedCGWH.symmetricOperatorObj (CategoryTheory.Operad.SmallFinBijGroupoid.card n))
          (PointedCGWH.sphereSequence.{u, v}.functor.obj
            (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) ◁ f) ↔
      NativeK.omegaTests Actual.symmetricFamily
        (Free.object (PointedCGWH.symmetricOperatorObj (CategoryTheory.Operad.SmallFinBijGroupoid.card n))
          (𝟙_ PointedCGWH.{u, v}) ◁ f) :=
  originalFreeSphereSmash_omegaTests_iff_unitCoefficient
    (PointedCGWH.symmetricOperatorObj (CategoryTheory.Operad.SmallFinBijGroupoid.card n)) n f









