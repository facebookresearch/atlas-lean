private theorem originalCellSmash_omegaTests_of_generatorEndpoints
    {Y Z : C.{u, v}} (f : Y ⟶ Z)
    (hEndpoints : ∀ {A X : C.{u, v}} (i : A ⟶ X), NativeK.levelI i →
