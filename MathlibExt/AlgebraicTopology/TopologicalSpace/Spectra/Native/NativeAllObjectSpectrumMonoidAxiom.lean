/-- The full original left sphere face is the unchanged identity-frame spectrum map. -/
private theorem originalLeftFace_eq_identitySpectrumMap (n : ℕ) :
    nativeLeftSphereFaces.{u, v} n =
      spectrumMap
        n (n + n) n (OrthogonalMatrixHom.id (n + n)) :=
  NativeGammaFaceBridge.nativeLeftSphereFaces_eq_identitySpectrumMap_of_raw n
    (SourceJoin.raw_left_evaluate (sphereFree n) n n n (𝟙 (sphereFree n)))

/-- The full original right sphere face is its unchanged block-swap spectrum map. -/
private theorem originalRightFace_eq_blockSwapSpectrumMap (n : ℕ) :
    nativeRightSphereFaces.{u, v} n =
      spectrumMap
        n (n + n) n (OrthogonalIndex.blockSwap n n) :=
  NativeGammaFaceBridge.nativeRightSphereFaces_eq_blockSwapSpectrumMap n
    (NativeGammaFaceBridge.nativeRightSphereCoefficient_eq_nu n)

variable [B : OrderBot realizedGeneratorCardinal.{v}.ord.ToType]
attribute [local instance] HomotopicalAlgebra.EnrichedProjective.Native.modelCategory

/-- The actual original rotation homotopy with both literal original sphere-face endpoints. -/
private def originalSphereFaceHomotopy (n : ℕ) :
    {H : PointedCGWH.EnrichedIntervalCylinder.object (sphereFree.{u, v} (n + n)) ⟶
        sphereFree.{u, v} n //
      PointedCGWH.EnrichedIntervalCylinder.inclusion 0 (sphereFree (n + n)) ≫ H =
          nativeLeftSphereFaces n ∧
        PointedCGWH.EnrichedIntervalCylinder.inclusion 1 (sphereFree (n + n)) ≫ H =
          nativeRightSphereFaces n} := by
  let H := nativeRotationHomotopy.{u, v} n
  exact ⟨H.val, H.property.1.trans (originalLeftFace_eq_identitySpectrumMap n).symm,
    H.property.2.trans (originalRightFace_eq_blockSwapSpectrumMap n).symm⟩

/-- The full original homotopy map is exactly the original native rotation value. -/
private theorem originalSphereFaceHomotopy_value (n : ℕ) :
    (originalSphereFaceHomotopy.{u, v} n).val =
      (nativeRotationHomotopy.{u, v} n).val := rfl






