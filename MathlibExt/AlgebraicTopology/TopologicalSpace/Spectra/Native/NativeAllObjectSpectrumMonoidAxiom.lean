/-!
## Entire function-object iteration through the original closed adjunctions

The whole iterated right adjoint is compared with the function object out of
actual tensor powers. Its natural isomorphisms are derived from the genuine
left tensor associator and complete chosen closed adjunctions, retaining the
original unit and counit equations before any native object is evaluated.
-/

set_option autoImplicit false
noncomputable section
open CategoryTheory MonoidalCategory
open scoped MonoidalClosed

namespace NativeOmegaRecovery.WholeFunctionIteration
universe uC vC
variable {C : Type uC} [Category.{vC} C] [MonoidalCategory C] [MonoidalClosed C]

/-- The same original tensor associator transports the whole composed closed adjunction. -/
private def tensorClosedAdjunction (X Y : C) : tensorLeft (X ⊗ Y) ⊣ ihom X ⋙ ihom Y :=
  ((ihom.adjunction Y).comp (ihom.adjunction X)).ofNatIsoLeft (tensorLeftTensor X Y).symm

/-- Complete function-object currying is a natural isomorphism of the actual functors. -/
private def tensorFunctionIso (X Y : C) : ihom (X ⊗ Y) ≅ ihom X ⋙ ihom Y :=
  Adjunction.rightAdjointUniq (ihom.adjunction (X ⊗ Y)) (tensorClosedAdjunction X Y)

/-- The actual original closed units commute with the complete natural currying map. -/
private theorem tensorFunctionIso_unit (X Y : C) :
    (ihom.adjunction (X ⊗ Y)).unit ≫
      Functor.whiskerLeft (tensorLeft (X ⊗ Y)) (tensorFunctionIso X Y).hom =
        (tensorClosedAdjunction X Y).unit :=
  Adjunction.unit_rightAdjointUniq_hom
    (ihom.adjunction (X ⊗ Y)) (tensorClosedAdjunction X Y)

/-- The complete original closed counit is retained by that same natural isomorphism. -/
private theorem tensorFunctionIso_counit (X Y : C) :
    Functor.whiskerRight (tensorFunctionIso X Y).hom (tensorLeft (X ⊗ Y)) ≫
      (tensorClosedAdjunction X Y).counit = (ihom.adjunction (X ⊗ Y)).counit :=
  Adjunction.rightAdjointUniq_hom_counit
    (ihom.adjunction (X ⊗ Y)) (tensorClosedAdjunction X Y)

/-- The whole actual iterate is the function object out of its original tensor power. -/
private def iterateFunctionIso (X : C) : ∀ n,
    Functor.Iteration.iterate (ihom X) n ≅ ihom (TensorPower.tensorPowObj X n) :=
  Nat.rec
    (motive := fun n => Functor.Iteration.iterate (ihom X) n ≅
      ihom (TensorPower.tensorPowObj X n))
    (MonoidalClosed.unitNatIso (C := C))
    (fun n previous =>
      Functor.isoWhiskerRight previous (ihom X) ≪≫
        (tensorFunctionIso (TensorPower.tensorPowObj X n) X).symm)

/-- Every original whole input map is natural for both function-iteration directions. -/
private theorem iterateFunctionIso_hom_naturality (X : C) (n : ℕ) {Y Z : C} (f : Y ⟶ Z) :
    (Functor.Iteration.iterate (ihom X) n).map f ≫ (iterateFunctionIso X n).hom.app Z =
      (iterateFunctionIso X n).hom.app Y ≫ (ihom (TensorPower.tensorPowObj X n)).map f :=
  (iterateFunctionIso X n).hom.naturality f

/-- The same whole input arrows retain the actual inverse naturality equation. -/
private theorem iterateFunctionIso_inv_naturality (X : C) (n : ℕ) {Y Z : C} (f : Y ⟶ Z) :
    (ihom (TensorPower.tensorPowObj X n)).map f ≫ (iterateFunctionIso X n).inv.app Z =
      (iterateFunctionIso X n).inv.app Y ≫ (Functor.Iteration.iterate (ihom X) n).map f :=
  (iterateFunctionIso X n).inv.naturality f

end NativeOmegaRecovery.WholeFunctionIteration
end

