/-!
# The monoid axiom for the original stable spectrum models

Every actual stable trivial cofibration remains weak after smashing with an
arbitrary right spectrum. The literal coproduct, pushout and continuous ordinal
cellular closure is weak, including every stage map and every colimit inclusion.
Whole Arrow retracts preserve this conclusion.

The private support declarations contain the source constructions used to prove
these results for both original models and their actual cofibrant replacements.
-/

section
universe u v
open CategoryTheory Limits

namespace NAMS

/-- The existing native pointed small-colimit proof supplies every size-zero diagram. -/
private theorem smallHasColimit {J : Type} [Category.{0} J]
    (F : J ⥤ PointedCGWH.{u, v}) : HasColimit F :=
  @HasColimitsOfShape.has_colimit J _ PointedCGWH.{u, v} _
    (@HasColimitsOfSize.has_colimits_of_shape PointedCGWH.{u, v} _
      PointedCGWH.EnrichedKan.hasSmallColimits J _) F

/-- The same proof supplies each whole size-zero coproduct and finite orbit copower. -/
private theorem smallHasCoproduct {J : Type}
    (F : J → PointedCGWH.{u, v}) : HasCoproduct F :=
  smallHasColimit (Discrete.functor F)

end NAMS
end

-- Activate these two existing-proof packages only in the receiving fragment:
-- attribute [local instance] NAMS.smallHasColimit NAMS.smallHasCoproduct

section
universe u v
open CategoryTheory CategoryTheory.Limits MonoidalCategory
namespace NAMS.SymmetricUnit
private abbrev I := CategoryTheory.Operad.SmallFinBijGroupoid
private abbrev V := PointedCGWH.{u, v}
private local instance originalUnitExtensions :
    (_root_.CategoryTheory.Functor.fromPUnit.{0} (𝟙_ I)).HasPointwiseLeftKanExtension
      (_root_.CategoryTheory.Functor.fromPUnit.{0} (𝟙_ V.{u, v})) := by
  intro Y
  let J : Type := CostructuredArrow (_root_.CategoryTheory.Functor.fromPUnit.{0} (𝟙_ I)) Y
  let F : J ⥤ V.{u, v} :=
    CostructuredArrow.proj (_root_.CategoryTheory.Functor.fromPUnit.{0} (𝟙_ I)) Y ⋙
      _root_.CategoryTheory.Functor.fromPUnit.{0} (𝟙_ V.{u, v})
  let h : HasColimitsOfShape J V.{u, v} :=
    @HasColimitsOfSize.has_colimits_of_shape V.{u, v} _
      PointedCGWH.EnrichedKan.hasSmallColimits J _
  exact @HasColimitsOfShape.has_colimit J _ V.{u, v} _ h F


end NAMS.SymmetricUnit
end

