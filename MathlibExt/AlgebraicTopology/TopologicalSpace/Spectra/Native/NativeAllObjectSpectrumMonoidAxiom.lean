private abbrev W := NativeK.omegaTests (B := B) Actual.symmetricFamily.{u, v}

/-- The proved original free-sphere calculation and actual scalar sphere cancellation
give every original free-unit test for the same arbitrary input arrow. -/
private theorem originalFreeUnit_omegaTests (a : PointedCGWH.SymmetricOperatorIndex.{u, v})
    {Y Z : C.{u, v}} (f : Y ⟶ Z) (hf : W f) :
    W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f) := by
  apply originalOperatorIndex_induction (fun a => W (Free.object a (𝟙_ PointedCGWH.{u, v}) ◁ f)) _ a
  intro n
  have hSphere : W
      (Free.object (PointedCGWH.symmetricOperatorObj (card n))
        (PointedCGWH.sphereSequence.{u, v}.functor.obj (card n)) ◁ f) :=
    originalFreeSphereTensor_omegaTests n f hf
  exact (OriginalFreeScalarSmashFullClients.originalFnSphere_omegaTests_iff_originalFnUnit n f).mp hSphere

/-- Both endpoints of every literal original I-generator inherit the genuine test;
the free-unit inputs are supplied by the proved unrestricted free-sphere theorem. -/
private theorem originalLevelI_omegaTests {A X : C.{u, v}} (i : A ⟶ X) (hi : NativeK.levelI i)
    {Y Z : C.{u, v}} (f : Y ⟶ Z) (hf : W f) : W (A ◁ f) ∧ W (X ◁ f) :=
  originalLevelI_endpointTests i hi f (fun a => originalFreeUnit_omegaTests a f hf)

/-- The actual original level-cofibrant left spectrum preserves every original Omega
test between arbitrary right endpoints, through its realized-cardinal I-cell source
and the whole original source retract. -/
private theorem originalCofibrantSmash_omegaTests {Y Z : C.{u, v}} (f : Y ⟶ Z) (hf : W f)
    (X : C.{u, v}) [IsCofibrant X] : W (X ◁ f) :=
  originalCofibrantSmash_omegaTests_of_generatorEndpoints f
    (fun i hi => originalLevelI_omegaTests i hi f hf) X

/-- The literal original stable model uses the same original I-cell and retract
construction. No assumption is placed on either right endpoint. -/
private theorem originalStableCofibrantSmash_omegaTests {Y Z : C.{u, v}} (f : Y ⟶ Z) (hf : W f)
    (X : C.{u, v}) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    IsCofibrant X → W (X ◁ f) :=
  originalStableCofibrantSmash_omegaTests_of_generatorEndpoints f
    (fun i hi => originalLevelI_omegaTests i hi f hf) X

/-- MMSS 12.3 for the actual stable symmetric model: tensoring with any actual
cofibrant left spectrum preserves every weak map with arbitrary right endpoints. -/
theorem originalStableCofibrantSmash_weak {Y Z : C.{u, v}} (f : Y ⟶ Z) (X : C.{u, v}) :
    let : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
    weakEquivalences C.{u, v} f → IsCofibrant X → weakEquivalences C.{u, v} (X ◁ f) := by
  let _ : ModelCategory C.{u, v} := StableModelConstruction.symmetricModelCategory (B := B)
  change weakEquivalences C.{u, v} f → IsCofibrant X → weakEquivalences C.{u, v} (X ◁ f)
  intro hf hX
  rw [(StableModelConstruction.symmetric_five_classes (B := B)).1] at hf ⊢
  exact originalStableCofibrantSmash_omegaTests f hf X hX







