module

public import Mathlib.Topology.Convenient.Category
public import Mathlib.AlgebraicTopology.SingularSet
public import MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatWeakHomotopyEquivalence
public import
  MathlibExt.Topology.Homotopy.TopCat.Singular.SingularKanPolymorphic

/-!
# Singular invariance of generated-topology coreflection

If every standard simplex is generated by a family of topological probes,
then applying the singular functor to the generated-topology counit gives an
isomorphism. In particular, that counit is a weak homotopy equivalence.

The argument is generator-independent. Compact-Hausdorff probes and their
compactness enter only in later specializations.
-/

set_option autoImplicit false

noncomputable section

public section

open CategoryTheory Topology

universe t r v

namespace TopCat

variable {ι : Type t} (Q : ι → Type r)
variable [∀ i, TopologicalSpace (Q i)]

private noncomputable def generatedByLiftStandardSimplex
    (hStd : ∀ n : SimplexCategoryᵒᵖ,
      IsGeneratedBy Q
        (Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))))
    (Y : TopCat.{v}) (n : SimplexCategoryᵒᵖ)
    (f : C(Convexity.StdSimplex ℝ (Fin (n.unop.len + 1)), Y)) :
    C(Convexity.StdSimplex ℝ (Fin (n.unop.len + 1)),
      ((TopCat.toGeneratedByTopCat (X := Q) ⋙
        GeneratedByTopCat.toTopCat).obj Y)) := by
  let _ : IsGeneratedBy Q
      (Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))) := hStd n
  change C(Convexity.StdSimplex ℝ (Fin (n.unop.len + 1)),
    WithGeneratedByTopology Q Y)
  exact f.continuous.continuousGeneratedBy.continuousMap.comp
    ⟨(IsGeneratedBy.homeomorph (X := Q)
        (Y := Convexity.StdSimplex ℝ (Fin (n.unop.len + 1)))).symm,
      (IsGeneratedBy.homeomorph (X := Q)
        (Y := Convexity.StdSimplex ℝ (Fin (n.unop.len + 1)))).symm.continuous⟩

private theorem generatedByAdjCounit_singular_app_bijective
    (hStd : ∀ n : SimplexCategoryᵒᵖ,
      IsGeneratedBy Q
        (Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))))
    (Y : TopCat.{v}) (n : SimplexCategoryᵒᵖ) :
    Function.Bijective
      ((TopCat.toSSet.map
        ((GeneratedByTopCat.adjCounit (X := Q)).app Y)).app n) := by
  constructor
  · intro a b hab
    apply (((TopCat.toGeneratedByTopCat (X := Q) ⋙
      GeneratedByTopCat.toTopCat).obj Y).toSSetObjEquiv n).injective
    ext z
    exact congrArg (fun s => Y.toSSetObjEquiv n s z) hab
  · intro b
    let f := Y.toSSetObjEquiv n b
    let f' := generatedByLiftStandardSimplex Q hStd Y n f
    refine ⟨(((TopCat.toGeneratedByTopCat (X := Q) ⋙
      GeneratedByTopCat.toTopCat).obj Y).toSSetObjEquiv n).symm f', ?_⟩
    apply (Y.toSSetObjEquiv n).injective
    ext z
    change generatedByLiftStandardSimplex Q hStd Y n f z = f z
    rfl

/-- If every standard simplex is generated by `Q`, singular sends the
generated-topology counit to an isomorphism. -/
theorem toSSet_map_generatedByAdjCounit_isIso
    (hStd : ∀ n : SimplexCategoryᵒᵖ,
      IsGeneratedBy Q
        (Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))))
    (Y : TopCat.{v}) :
    IsIso (TopCat.toSSet.map
      ((GeneratedByTopCat.adjCounit (X := Q)).app Y)) := by
  rw [NatTrans.isIso_iff_isIso_app]
  intro n
  rw [isIso_iff_bijective]
  exact generatedByAdjCounit_singular_app_bijective Q hStd Y n

/-- If every standard simplex is generated by `Q`, the generated-topology
counit is a weak homotopy equivalence. -/
theorem generatedByAdjCounit_mem_weakHomotopyEquivalences
    (hStd : ∀ n : SimplexCategoryᵒᵖ,
      IsGeneratedBy Q
        (Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))))
    (Y : TopCat.{v}) :
    TopCat.weakHomotopyEquivalences
      ((GeneratedByTopCat.adjCounit (X := Q)).app Y) := by
  rw [TopCat.mem_weakHomotopyEquivalences_iff]
  let _ : SSet.KanComplex
      (TopCat.toSSet.obj
        ((TopCat.toGeneratedByTopCat (X := Q) ⋙
          GeneratedByTopCat.toTopCat).obj Y)) :=
    TopCat.toSSet_obj_kanComplex _
  let _ : SSet.KanComplex (TopCat.toSSet.obj ((𝟭 TopCat).obj Y)) :=
    TopCat.toSSet_obj_kanComplex _
  let _ : IsIso (TopCat.toSSet.map
      ((GeneratedByTopCat.adjCounit (X := Q)).app Y)) :=
    TopCat.toSSet_map_generatedByAdjCounit_isIso Q hStd Y
  exact SSet.KanComplex.W.ofIso
    (asIso (TopCat.toSSet.map
      ((GeneratedByTopCat.adjCounit (X := Q)).app Y)))

end TopCat
