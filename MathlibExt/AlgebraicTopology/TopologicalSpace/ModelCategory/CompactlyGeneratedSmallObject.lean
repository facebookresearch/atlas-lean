module

public import
  MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.CompactlyGeneratedGenerators
public import
  MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatBoundarySmallObject
public import
  MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatHornSmallObject
public import MathlibExt.Topology.Category.CompactlyGenerated.Colimits
public import MathlibExt.CategoryTheory.SmallObject.FullyFaithful

/-!
# Small-object arguments in compactly generated spaces

The realized boundary and horn generators in compactly generated spaces
inherit their small-object arguments and generated left classes from the
corresponding `TopCat` families along the fully faithful inclusion.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u v

open CategoryTheory MorphismProperty

namespace CompactlyGenerated

private theorem realizedBoundaryInclusions_le_inverseImage :
    realizedBoundaryInclusions.{u, v} ≤
      TopCat.realizedBoundaryInclusions.{v}.inverseImage
        compactlyGeneratedToTop.{u, v} := by
  intro X Y f hf
  obtain ⟨n⟩ := hf
  change TopCat.realizedBoundaryInclusions.{v}
    (compactlyGeneratedToTop.{u, v}.map (realizedBoundaryInclusion n))
  rw [compactlyGeneratedToTop_map_realizedBoundaryInclusion]
  exact TopCat.boundary_mem_realizedBoundaryInclusions n

private theorem realizedHornInclusions_le_inverseImage :
    realizedHornInclusions.{u, v} ≤
      TopCat.realizedHornInclusions.{v}.inverseImage
        compactlyGeneratedToTop.{u, v} := by
  intro X Y f hf
  unfold realizedHornInclusions at hf
  rw [MorphismProperty.iSup_iff] at hf
  obtain ⟨n, ⟨i⟩⟩ := hf
  change TopCat.realizedHornInclusions.{v}
    (compactlyGeneratedToTop.{u, v}.map (realizedHornInclusion n i))
  rw [compactlyGeneratedToTop_map_realizedHornInclusion]
  exact TopCat.horn_mem_realizedHornInclusions (n + 1) i

/-- The internal realized boundary generators satisfy the smallness
conditions at `realizedGeneratorCardinal`. -/
noncomputable instance
    instIsCardinalForSmallObjectArgumentRealizedBoundaryInclusions :
    MorphismProperty.IsCardinalForSmallObjectArgument.{v}
      realizedBoundaryInclusions.{u, v} realizedGeneratorCardinal.{v} := by
  let _ : Small.{v} ℕ := small_zero ℕ
  let _ : MorphismProperty.IsSmall.{v}
      realizedBoundaryInclusions.{u, v} := by
    unfold realizedBoundaryInclusions
    infer_instance
  exact MorphismProperty.IsCardinalForSmallObjectArgument.of_fullyFaithful
    compactlyGeneratedToTop.{u, v}
    realizedBoundaryInclusions.{u, v}
    TopCat.realizedBoundaryInclusions.{v}
    realizedGeneratorCardinal.{v}
    realizedBoundaryInclusions_le_inverseImage

/-- The internal realized boundary generators permit the small-object
argument at `realizedGeneratorCardinal`. -/
noncomputable instance :
    MorphismProperty.HasSmallObjectArgument.{v}
      realizedBoundaryInclusions.{u, v} :=
  ⟨realizedGeneratorCardinal.{v}, inferInstance, inferInstance, inferInstance⟩

/-- The internal realized horn generators satisfy the smallness conditions
at `realizedGeneratorCardinal`. -/
noncomputable instance
    instIsCardinalForSmallObjectArgumentRealizedHornInclusions :
    MorphismProperty.IsCardinalForSmallObjectArgument.{v}
      realizedHornInclusions.{u, v} realizedGeneratorCardinal.{v} := by
  let _ : Small.{v} ℕ := small_zero ℕ
  let _ : ∀ n : ℕ, Small.{v} (Fin (n + 2)) := fun _ ↦ small_zero _
  let _ : MorphismProperty.IsSmall.{v}
      realizedHornInclusions.{u, v} := by
    unfold realizedHornInclusions
    infer_instance
  exact MorphismProperty.IsCardinalForSmallObjectArgument.of_fullyFaithful
    compactlyGeneratedToTop.{u, v}
    realizedHornInclusions.{u, v}
    TopCat.realizedHornInclusions.{v}
    realizedGeneratorCardinal.{v}
    realizedHornInclusions_le_inverseImage

/-- The internal realized horn generators permit the small-object argument
at `realizedGeneratorCardinal`. -/
noncomputable instance :
    MorphismProperty.HasSmallObjectArgument.{v}
      realizedHornInclusions.{u, v} :=
  ⟨realizedGeneratorCardinal.{v}, inferInstance, inferInstance, inferInstance⟩

/-- The left class generated by internal realized boundaries is created by
the inclusion into `TopCat`. -/
theorem realizedBoundaryInclusions_rlp_llp :
    realizedBoundaryInclusions.{u, v}.rlp.llp =
      TopCat.realizedBoundaryInclusions.{v}.rlp.llp.inverseImage
        compactlyGeneratedToTop.{u, v} :=
  MorphismProperty.rlp_llp_eq_inverseImage_of_fullyFaithful
    compactlyGeneratedToTop.{u, v}
    realizedBoundaryInclusions.{u, v}
    TopCat.realizedBoundaryInclusions.{v}
    realizedBoundaryInclusions_le_inverseImage
    realizedBoundaryInclusions_rlp

/-- The left class generated by internal realized horns is created by the
inclusion into `TopCat`. -/
theorem realizedHornInclusions_rlp_llp :
    realizedHornInclusions.{u, v}.rlp.llp =
      TopCat.realizedHornInclusions.{v}.rlp.llp.inverseImage
        compactlyGeneratedToTop.{u, v} :=
  MorphismProperty.rlp_llp_eq_inverseImage_of_fullyFaithful
    compactlyGeneratedToTop.{u, v}
    realizedHornInclusions.{u, v}
    TopCat.realizedHornInclusions.{v}
    realizedHornInclusions_le_inverseImage
    realizedHornInclusions_rlp

end CompactlyGenerated
