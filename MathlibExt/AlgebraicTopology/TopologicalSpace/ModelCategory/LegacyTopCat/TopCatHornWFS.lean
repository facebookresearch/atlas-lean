-- Author: @toskua, Avocado
module

public import
  MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatHornSmallObject
public import Mathlib.CategoryTheory.MorphismProperty.WeakFactorizationSystem

/-!
# Weak factorization system generated by realized horns

Let `I=TopCat.realizedHornInclusions.{u}`. The small-object argument gives a weak
factorization system on `TopCat.{u}` with left class `I.rlp.llp` and right class `I.rlp`. Thus
every morphism factors through these classes, and the left and right classes are characterized
by their mutual lifting properties.
-/

@[expose] public section

open CategoryTheory MorphismProperty

universe u

/-- For `I=TopCat.realizedHornInclusions.{u}`, the pair `(I.rlp.llp,I.rlp)` is a weak
factorization system on `TopCat.{u}`. Each map factors as a map having the left lifting
property against all horn-right-lifting maps followed by a horn-right-lifting map; the two
classes are the corresponding orthogonal lifting classes. -/
instance : IsWeakFactorizationSystem
    (TopCat.realizedHornInclusions.{u}).rlp.llp
    (TopCat.realizedHornInclusions.{u}).rlp :=
  IsWeakFactorizationSystem.mk' _ _ (fun _i p hi hp => hi p hp)
