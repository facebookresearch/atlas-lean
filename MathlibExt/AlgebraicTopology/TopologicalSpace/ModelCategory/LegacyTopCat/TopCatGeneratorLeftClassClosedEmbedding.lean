module

public import MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatGeneratorSmallObjectFactorization
public import MathlibExt.AlgebraicTopology.TopologicalSpace.SimplicialRealization.PointSet.TopCatRealizedCellClosedEmbedding
public import MathlibExt.Topology.Category.TopCat.ClosedEmbeddingRetracts

/-!
# Closed embeddings in the generated topological left class

The left lifting class generated by the union of realized boundary and horn inclusions is contained in `TopCat.closedEmbeddings`. The proof uses `generatorUnion_llp_rlp` and closure under coproduct pushouts, transfinite compositions and retracts.
-/

@[expose] public section

universe u

open CategoryTheory

theorem TopCat.generatorUnion_llp_le_closedEmbeddings :
    (TopCat.realizedBoundaryInclusions ⊔ TopCat.realizedHornInclusions :
      CategoryTheory.MorphismProperty TopCat.{u}).rlp.llp ≤
      TopCat.closedEmbeddings.{u} := by
  rw [generatorUnion_llp_rlp]
  exact MorphismProperty.retracts_le_iff.mpr
    (MorphismProperty.transfiniteCompositions_le_iff.mpr
      TopCat.pushouts_coproducts_realizedGenerators_le_closedEmbeddings)
