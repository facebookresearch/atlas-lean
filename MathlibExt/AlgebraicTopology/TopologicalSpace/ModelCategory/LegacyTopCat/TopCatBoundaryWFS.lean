-- Author: @toskua, Avocado
module

public import
 MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatBoundarySmallObject
public import Mathlib.CategoryTheory.MorphismProperty.WeakFactorizationSystem

/-!
# Weak factorization system generated by realized boundaries

Let `I` be the family of realized simplicial boundary inclusions. Its small
object factorization gives a weak factorization system with left class
`I.rlp.llp` and right class `I.rlp`: maps with the left lifting property against
all boundary-right-lifting maps, and the boundary-right-lifting maps themselves.
-/

@[expose] public section

open CategoryTheory MorphismProperty

universe u

/--
The left lifting class of realized-boundary right lifting and the
realized-boundary right lifting class form a weak factorization system.
-/
instance : IsWeakFactorizationSystem
    (TopCat.realizedBoundaryInclusions.{u}).rlp.llp
    (TopCat.realizedBoundaryInclusions.{u}).rlp :=
  IsWeakFactorizationSystem.mk' _ _ (fun _i p hi hp => hi p hp)
