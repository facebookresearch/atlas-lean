-- Author: @toskua, Avocado
module

import MathlibExt.AlgebraicTopology.SimplicialSet.ModelCategory.KanComplexWColimits
public import MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatHornCardinalWeakHomotopyPerDiagram

/-!
# Weak homotopy equivalences generated by realized horns

The left lifting class generated by realized horn inclusions consists of
weak homotopy equivalences in every space universe. The transfinite
closed-relative-T1 composition argument applies along the ordinal of the
realized-generator cardinal.
-/

@[expose] public section

universe u

namespace TopCat

/--
Every map in the left lifting class generated by realized horn inclusions is
a weak homotopy equivalence.
-/
theorem horn_llp_le_weakHomotopyEquivalences :
    realizedHornInclusions.{u}.rlp.llp ≤
      weakHomotopyEquivalences.{u} := by
  let _ : NoMaxOrder realizedGeneratorCardinal.{u}.ord.ToType :=
    Cardinal.noMaxOrder
      (Cardinal.aleph0_le_continuum.trans
        (le_of_lt (Order.lt_succ Cardinal.continuum)))
  exact horn_llp_le_weakHomotopyEquivalences_of_cardinalOrd_perDiagram

end TopCat
