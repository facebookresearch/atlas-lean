module

import MathlibExt.AlgebraicTopology.SimplicialSet.ModelCategory.KanComplexWColimits
public import MathlibExt.AlgebraicTopology.TopologicalSpace.ModelCategory.LegacyTopCat.TopCatHornCardinalWeakHomotopyPerDiagram

/-!
# Realized horn left maps are weak homotopy equivalences

The left class generated by realized horn inclusions consists of weak homotopy
equivalences in every universe. The proof uses the actual small-object
cardinal ordinal, installs its no-maximum-order witness locally, and applies
the per-diagram closed-T1 transfinite theorem.

No sequential endpoint, lifted universe transport, global colimit-preservation
instance, weak-category instance, or model structure is introduced.
-/

@[expose] public section

universe u

namespace TopCat

/-- The left class generated by realized horn inclusions consists of weak
homotopy equivalences. -/
theorem horn_llp_le_weakHomotopyEquivalences :
    realizedHornInclusions.{u}.rlp.llp ≤
      weakHomotopyEquivalences.{u} := by
  let _ : NoMaxOrder realizedGeneratorCardinal.{u}.ord.ToType :=
    Cardinal.noMaxOrder
      (Cardinal.aleph0_le_continuum.trans
        (le_of_lt (Order.lt_succ Cardinal.continuum)))
  exact horn_llp_le_weakHomotopyEquivalences_of_cardinalOrd_perDiagram

end TopCat
