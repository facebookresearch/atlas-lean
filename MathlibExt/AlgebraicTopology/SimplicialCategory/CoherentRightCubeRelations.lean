-- Author: @toskua
import MathlibExt.AlgebraicTopology.SimplicialCategory.CoherentCompositionFace
import MathlibExt.AlgebraicTopology.SimplicialCategory.CoherentPathLastMaximum

/-!
# Actual front-composition relations on the original right cube

The original source-to-last path nerve has its actual union-composition
faces. When the entire front is an identity, a front-prefix path does not
change the last factor. These relations define an actual simplicial
quotient of the original cube; its identification with the realized
fixed-front right Hom is a separate theorem to prove.
-/

noncomputable section
universe u
open CategoryTheory Opposite
open scoped Simplicial

namespace CategoryTheory.CoherentRealization.RightCubeRelations
open PathLastMaximum
variable {n : ℕ}

/-- Add the original zero endpoint to a path with a supplied original front source. -/
def prependZero (i : Fin (n + 1)) (p : LastPath.{u} i) : LastPath.{u} (0 : Fin (n + 1)) where
  I := {ULift.up.{u} (0 : Fin (n + 2))} ∪ p.I
  left := Or.inl rfl
  right := Or.inr p.right
  left_le k _ := Fin.zero_le k.down
  le_right k := by
    rintro (rfl | hk)
    · exact Fin.zero_le _
    · exact p.le_right k hk

/-- The whole original zero-prefix insertion functor on the supplied last-path category. -/
def prependFunctor (i : Fin (n + 1)) : LastPath.{u} i ⥤ LastPath.{u} (0 : Fin (n + 1)) where
  obj := prependZero i
  map f := ⟨homOfLE (Set.union_subset_union le_rfl f.hom.down.down)⟩

/-- The actual source-prefix relation, identifying a whole union chain with its same
original last factor at
  zero source. -/
inductive Relation (n : ℕ) : ∀ {q : SimplexCategoryᵒᵖ},
    (nerve (LastPath.{u} (0 : Fin (n + 1)))).obj q →
      (nerve (LastPath.{u} (0 : Fin (n + 1)))).obj q → Prop
  | composition {q : SimplexCategoryᵒᵖ} (i : Fin (n + 1))
      (p : (nerve (SimplicialThickening.Path (ULift.up.{u} (0 : Fin (n + 2))) (ULift.up.{u}
        i.castSucc))).obj q)
      (r : (nerve (LastPath.{u} i)).obj q) :
      Relation n (p.prod' r ⋙ SimplicialThickening.compFunctor (.mk (ULift.up 0)) (.mk
        (ULift.up i.castSucc))
        (.mk (ULift.up (Fin.last (n + 1))))) (r ⋙ prependFunctor i)

/-- The actual equivalence relation generated by the original whole front-composition
relations in one scalar degree. -/
def setoid (n : ℕ) (q : SimplexCategoryᵒᵖ) : Setoid ((nerve (LastPath.{u} (0 : Fin (n
  + 1)))).obj q) :=
  Relation.EqvGen.setoid (Relation.{u} n)

/-- Original scalar simplex operators retain the same whole front-composition relation. -/
theorem relation_operator {q r : SimplexCategoryᵒᵖ} (θ : q ⟶ r)
    {a b : (nerve (LastPath.{u} (0 : Fin (n + 1)))).obj q} (h : Relation n a b) :
    Relation n ((nerve (LastPath.{u} (0 : Fin (n + 1)))).map θ a)
      ((nerve (LastPath.{u} (0 : Fin (n + 1)))).map θ b) := by
  cases h with
  | composition i p r =>
    exact Relation.composition (n := n) i
      ((nerve (SimplicialThickening.Path (ULift.up.{u} (0 : Fin (n + 2))) (ULift.up.{u}
        i.castSucc))).map θ p)
      ((nerve (LastPath.{u} i)).map θ r)

/-- The actual generated right-cube relation is stable under every original scalar operator. -/
theorem setoid_operator {q r : SimplexCategoryᵒᵖ} (θ : q ⟶ r)
    {a b : (nerve (LastPath.{u} (0 : Fin (n + 1)))).obj q} (h : (setoid.{u} n q).r a b) :
    (setoid.{u} n r).r ((nerve (LastPath.{u} (0 : Fin (n + 1)))).map θ a)
      ((nerve (LastPath.{u} (0 : Fin (n + 1)))).map θ b) := by
  induction h with
  | rel a b h => exact Relation.EqvGen.rel _ _ (relation_operator θ h)
  | refl a => exact Relation.EqvGen.refl _
  | symm a b h ih => exact Relation.EqvGen.symm _ _ ih
  | trans a b c h h' ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'

/-- The actual simplicial right-cube quotient of the original zero-to-last coherent path nerve. -/
def object (n : ℕ) : SSet.{u} where
  obj q := _root_.Quotient (setoid.{u} n q)
  map θ := ↾_root_.Quotient.map ((nerve (LastPath.{u} (0 : Fin (n + 1)))).map θ) (fun _
    _ h => setoid_operator θ h)
  map_id q := by
    ext a
    induction a using _root_.Quotient.inductionOn with
    | _ a =>
      exact congrArg (fun a => _root_.Quotient.mk _ a) (congr($((nerve (LastPath.{u} (0 :
      Fin (n +
      1)))).map_id q) a))
  map_comp θ ψ := by
    ext a
    induction a using _root_.Quotient.inductionOn with
    | _ a =>
      exact congrArg (fun a => _root_.Quotient.mk _ a) (congr($((nerve (LastPath.{u} (0 :
      Fin (n +
      1)))).map_comp θ ψ) a))

/-- The entire original right cube maps to its actual front-composition quotient. -/
def projection (n : ℕ) : nerve (LastPath.{u} (0 : Fin (n + 1))) ⟶ object.{u} n where
  app q := ↾_root_.Quotient.mk _
  naturality q r θ := by ext a; rfl

end CategoryTheory.CoherentRealization.RightCubeRelations
