-- Author: @toskua, Codex
import MathlibExt.AlgebraicTopology.ModelCategory.EnrichedProjectiveMappedTransport

/-!
# Original evaluated classes under the actual carrier comparisons

Complete natural isomorphisms identify the actual original evaluated arrows.
Right lifting against each original free family gives the same right classes;
the constructed model then gives both original generated left classes.
-/

set_option autoImplicit false

noncomputable section

universe w uA uV vV uC vC uD vD uS

open CategoryTheory Limits MorphismProperty Opposite MonoidalCategory

namespace HomotopicalAlgebra.EvaluationTransfer

variable {V : Type uV} [Category.{vV} V] {C : Type uC} [Category.{vC} C]
  {D : Type uD} [Category.{vD} D] {S : Type uS}

/-- Original evaluation comparisons identify the complete pointwise map property. -/
theorem inverseEvaluationProperty_eq (F : C ⥤ D) (RD : S → D ⥤ V) (RC : S → C ⥤ V)
    (hR : ∀ s, F ⋙ RD s ≅ RC s) (P : MorphismProperty V) [P.RespectsIso] :
    (evaluationProperty RD P).inverseImage F = evaluationProperty RC P := by
  ext X Y f
  change evaluationProperty RD P (F.map f) ↔ evaluationProperty RC P f
  rw [evaluationProperty_iff, evaluationProperty_iff]
  constructor
  · intro h s
    let e : Arrow.mk ((F ⋙ RD s).map f) ≅ Arrow.mk ((RC s).map f) :=
      Arrow.isoMk' _ _ ((hR s).app X) ((hR s).app Y) ((hR s).hom.naturality f).symm
    exact (P.arrow_mk_iso_iff e).mp (h s)
  · intro h s
    let e : Arrow.mk ((F ⋙ RD s).map f) ≅ Arrow.mk ((RC s).map f) :=
      Arrow.isoMk' _ _ ((hR s).app X) ((hR s).app Y) ((hR s).hom.naturality f).symm
    exact (P.arrow_mk_iso_iff e).mpr (h s)

end HomotopicalAlgebra.EvaluationTransfer

namespace HomotopicalAlgebra.EnrichedProjective.MappedSources

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V] [ModelCategory V]
  {A : Type uA} [EnrichedCategory V A]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  [Small.{w} A] [LocallySmall.{w} V] [HasColimitsOfSize.{w, w} V]
  {C : Type uC} [Category.{vC} C]
  (d : CofibrantGenerationData V κ)
  (hJ : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y), d.J f → trivialCofibrations V (f ▷ (a ⟶[V] b)))
  (hSourceI : SourceCondition (A := A) (κ := κ) d.I)
  (hSourceJ : SourceCondition (A := A) (κ := κ) d.J)
  (e : C ≌ EnrichedFunctorCat V A) (R : A → C ⥤ V)
  (hR : ∀ a, e.functor ⋙ EnrichedFunctorCat.evaluation a ≅ R a)

include hJ hSourceI hSourceJ hR

/-- The original source weak class is detected by the exact original evaluation functors. -/
theorem sourceWeak_eq :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    weakEquivalences C = EvaluationTransfer.evaluationProperty R (weakEquivalences V) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  change (weakEquivalences (EnrichedFunctorCat V A)).inverseImage e.functor = _
  rw [weakEquivalences_eq d hJ hSourceI hSourceJ]
  exact EvaluationTransfer.inverseEvaluationProperty_eq e.functor _ R hR _

/-- The original source fibration class is detected by the exact original evaluation functors. -/
theorem sourceFibration_eq :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    fibrations C = EvaluationTransfer.evaluationProperty R (fibrations V) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  change (fibrations (EnrichedFunctorCat V A)).inverseImage e.functor = _
  rw [fibrations_eq d hJ hSourceI hSourceJ]
  exact EvaluationTransfer.inverseEvaluationProperty_eq e.functor _ R hR _

/-- The original source trivial-fibration class is detected by the exact original evaluations. -/
theorem sourceTrivialFibration_eq :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    trivialFibrations C = EvaluationTransfer.evaluationProperty R (trivialFibrations V) := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  change fibrations C ⊓ weakEquivalences C = _
  rw [sourceFibration_eq d hJ hSourceI hSourceJ e R hR, sourceWeak_eq d hJ hSourceI hSourceJ e R hR]
  exact (EvaluationTransfer.evaluationProperty_inf R (fibrations V) (weakEquivalences V)).symm

variable (L : A → V ⥤ C) (adj : ∀ a, L a ⊣ R a)

include adj

/-- The original source cofibrations are generated by the actual original free I images. -/
theorem sourceCofibration_generators_eq :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    cofibrations C = (adjointFamilyGenerators L d.I).rlp.llp := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  have h : (adjointFamilyGenerators L d.I).rlp = trivialFibrations C := by
    rw [EvaluationTransfer.evaluatedGenerators_rlp_eq L R adj d.I, d.I_rlp]
    exact (sourceTrivialFibration_eq d hJ hSourceI hSourceJ e R hR).symm
  rw [← trivialFibrations_llp C, h]

/-- The original source trivial cofibrations are generated by the actual original free J images. -/
theorem sourceTrivialCofibration_generators_eq :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    trivialCofibrations C = (adjointFamilyGenerators L d.J).rlp.llp := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  have h : (adjointFamilyGenerators L d.J).rlp = fibrations C := by
    rw [EvaluationTransfer.evaluatedGenerators_rlp_eq L R adj d.J, d.J_rlp]
    exact (sourceFibration_eq d hJ hSourceI hSourceJ e R hR).symm
  rw [← fibrations_llp C, h]

/-- Every actual original free/evaluation adjunction is Quillen for the same constructed source
model. -/
theorem sourceFreeEvaluation_isQuillenAdjunction (a : A) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    (adj a).IsQuillenAdjunction := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  apply Adjunction.IsQuillenAdjunction.mkOfPreservesFibrations
  · intro X Y f hf
    rw [sourceFibration_eq d hJ hSourceI hSourceJ e R hR] at hf
    exact (EvaluationTransfer.evaluationProperty_iff R (fibrations V) f).mp hf a
  · intro X Y f hf
    rw [sourceTrivialFibration_eq d hJ hSourceI hSourceJ e R hR] at hf
    exact (EvaluationTransfer.evaluationProperty_iff R (trivialFibrations V) f).mp hf a

end HomotopicalAlgebra.EnrichedProjective.MappedSources
