/-!
# Enriched projective model structures

For a small enriched category `A` over a braided monoidal closed model category
`V` with the required colimits and local smallness, cofibrant generation at a
regular cardinal transfers to `EnrichedFunctorCat V A`. The construction assumes
that tensoring the base generating (trivial) cofibrations with enriched hom
objects preserves their classes, and that their sources preserve colimits of
the specified well-ordered diagrams. Weak equivalences and fibrations are
objectwise, while cofibrations and trivial cofibrations are generated by the
free enriched `I`- and `J`-families. Both functorial weak-factorization systems
are retained, and each free-at-object/evaluation adjunction is Quillen.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
universe w uA uV vV
open CategoryTheory CategoryTheory.Limits CategoryTheory.MorphismProperty Opposite
open MonoidalCategory

namespace HomotopicalAlgebra.EnrichedProjective
variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V]
  {A : Type uA} [EnrichedCategory V A]

/-- Literal enriched free images of the original base generator family. -/
abbrev generators (P : MorphismProperty V) : MorphismProperty (EnrichedFunctorCat V A) :=
  adjointFamilyGenerators (fun a : A => EnrichedFunctorCat.Free.functor a) P

/-- Evaluation retains the complete coefficient-tensor generator arrows. -/
theorem generators_evaluation_le (P Q : MorphismProperty V) [Q.RespectsIso]
    (hTensor : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y), P f → Q (f ▷ (a ⟶[V] b)))
    (b : A) : generators (A := A) P ≤ Q.inverseImage (EnrichedFunctorCat.evaluation b) := by
  intro X Y f hf
  let L : A → V ⥤ EnrichedFunctorCat V A := fun a => EnrichedFunctorCat.Free.functor a
  let R : A → EnrichedFunctorCat V A ⥤ V := fun a => EnrichedFunctorCat.evaluation a
  obtain ⟨q, hq⟩ := (adjointFamilyGenerators_iff L P f).mp hf
  have hActual : Q ((R b).map ((L q.1).map q.2.1.hom)) := by
    change Q (EnrichedFunctorCat.component ((L q.1).map q.2.1.hom) b)
    rw [EnrichedFunctorCat.Free.coefficientMap_component]
    exact hTensor q.1 b q.2.1.hom q.2.2
  have hArrow := congrArg (fun a => (R b).mapArrow.obj a) hq
  exact (Q.arrow_mk_iso_iff (eqToIso hArrow)).mpr hActual

section EvaluationContinuity
variable {κ : Cardinal.{w}} [HasColimitsOfSize.{w, w} V]

/-- The original base shape supplies all required evaluation continuity diagrams. -/
private theorem evaluationContinuous (a : A) :
    PreservesWellOrderContinuousOfShape κ.ord.ToType
      (EnrichedFunctorCat.evaluation (V := V) a) where
  preservesColimitsOfShape _ _ := inferInstance

end EvaluationContinuity

section ActualCardinal
variable {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  [Small.{w} A] [LocallySmall.{w} V]
  [HasColimitsOfSize.{w, w} V]

/-- Derive all six target eligibility fields from the actual base source diagrams. -/
theorem generators_isCardinalForSmallObjectArgument
    (P Q : MorphismProperty V) [P.IsSmall.{w}] [Q.RespectsIso]
    [Q.IsStableUnderCoproducts.{w}] [Q.IsStableUnderCobaseChange]
    [Q.IsStableUnderTransfiniteComposition.{w}]
    (hTensor : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y), P f → Q (f ▷ (a ⟶[V] b)))
    (hSource : ∀ {X Y : V} (f : X ⟶ Y), P f →
      ∀ (F : κ.ord.ToType ⥤ V) [F.IsWellOrderContinuous],
        (∀ ⦃a b⦄ (φ : a ⟶ b), Q (F.map φ)) →
        PreservesColimit F (coyoneda.obj (op X))) :
    (generators (A := A) P).IsCardinalForSmallObjectArgument κ := by
  let L : A → V ⥤ EnrichedFunctorCat V A := fun a => EnrichedFunctorCat.Free.functor a
  let R : A → EnrichedFunctorCat V A ⥤ V := fun a => EnrichedFunctorCat.evaluation a
  let adj : ∀ a, L a ⊣ R a := fun a => EnrichedFunctorCat.Free.adjunction a
  let _ : HasFiniteColimits (EnrichedFunctorCat V A) :=
    hasFiniteColimits_of_hasColimitsOfSize _
  let _ : ∀ a, PreservesWellOrderContinuousOfShape κ.ord.ToType (R a) :=
    fun a => evaluationContinuous a
  exact adjointFamily_isCardinalForSmallObjectArgument L R adj P Q κ
    (generators_evaluation_le P Q hTensor) hSource

/-- The same explicit cardinal and caller bottom package the derived small-object argument. -/
theorem generators_hasSmallObjectArgument
    (P Q : MorphismProperty V) [P.IsSmall.{w}] [Q.RespectsIso]
    [Q.IsStableUnderCoproducts.{w}] [Q.IsStableUnderCobaseChange]
    [Q.IsStableUnderTransfiniteComposition.{w}]
    (hTensor : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y), P f → Q (f ▷ (a ⟶[V] b)))
    (hSource : ∀ {X Y : V} (f : X ⟶ Y), P f →
      ∀ (F : κ.ord.ToType ⥤ V) [F.IsWellOrderContinuous],
        (∀ ⦃a b⦄ (φ : a ⟶ b), Q (F.map φ)) →
        PreservesColimit F (coyoneda.obj (op X))) :
    (generators (A := A) P).HasSmallObjectArgument.{w} :=
  ⟨⟨κ, inferInstance, inferInstance,
    generators_isCardinalForSmallObjectArgument P Q hTensor hSource⟩⟩

end ActualCardinal

variable [ModelCategory V]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  [Small.{w} A] [LocallySmall.{w} V]
  [HasColimitsOfSize.{w, w} V]

/-- Construct the genuine enriched projective model from actual base cardinal generators.
The hom-tensor generator conditions and actual mapped source-colimit witnesses derive
both target small-object arguments and the full evaluated left acyclicity. -/
@[instance_reducible]
def modelCategory (d : CofibrantGenerationData V κ)
    (hI : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
      d.I f → cofibrations V (f ▷ (a ⟶[V] b)))
    (hJ : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
      d.J f → trivialCofibrations V (f ▷ (a ⟶[V] b)))
    (hSourceI : ∀ {X Y : V} (f : X ⟶ Y), d.I f →
      ∀ (F : κ.ord.ToType ⥤ V) [F.IsWellOrderContinuous],
        (∀ ⦃a b⦄ (φ : a ⟶ b), cofibrations V (F.map φ)) →
        PreservesColimit F (coyoneda.obj (op X)))
    (hSourceJ : ∀ {X Y : V} (f : X ⟶ Y), d.J f →
      ∀ (F : κ.ord.ToType ⥤ V) [F.IsWellOrderContinuous],
        (∀ ⦃a b⦄ (φ : a ⟶ b), trivialCofibrations V (F.map φ)) →
        PreservesColimit F (coyoneda.obj (op X))) :
    ModelCategory (EnrichedFunctorCat V A) := by
  let L : A → V ⥤ EnrichedFunctorCat V A := fun a => EnrichedFunctorCat.Free.functor a
  let R : A → EnrichedFunctorCat V A ⥤ V := fun a => EnrichedFunctorCat.evaluation a
  let adj : ∀ a, L a ⊣ R a := fun a => EnrichedFunctorCat.Free.adjunction a
  let _ : HasFiniteLimits (EnrichedFunctorCat V A) := inferInstance
  let _ : HasFiniteColimits (EnrichedFunctorCat V A) := inferInstance
  let _ : HasIterationOfShape κ.ord.ToType (EnrichedFunctorCat V A) := inferInstance
  let _ : ∀ a, PreservesColimitsOfSize.{w, w} (R a) := fun a => inferInstance
  let _ : ∀ a, PreservesColimitsOfShape κ.ord.ToType (R a) := fun a => inferInstance
  let _ : ∀ a, PreservesWellOrderContinuousOfShape κ.ord.ToType (R a) := fun a =>
    { preservesColimitsOfShape := fun _ _ => inferInstance }
  let _ : d.I.IsSmall.{w} := d.I_smallObject.isSmall
  let _ : d.J.IsSmall.{w} := d.J_smallObject.isSmall
  let _ : (cofibrations V).IsStableUnderCoproducts.{w} :=
    IsStableUnderCoproducts.of_llp_eq (cofibrations V) (trivialFibrations V)
      (trivialFibrations_llp V)
  let _ : (trivialCofibrations V).IsStableUnderCoproducts.{w} :=
    IsStableUnderCoproducts.of_llp_eq (trivialCofibrations V) (fibrations V)
      (fibrations_llp V)
  let _ : (cofibrations V).IsStableUnderTransfiniteComposition.{w} := by
    rw [← trivialFibrations_llp V]
    infer_instance
  let _ : (trivialCofibrations V).IsStableUnderTransfiniteComposition.{w} := by
    rw [← fibrations_llp V]
    infer_instance
  have hEvalI : ∀ b, adjointFamilyGenerators L d.I ≤ (cofibrations V).inverseImage (R b) :=
    generators_evaluation_le d.I (cofibrations V) hI
  have hEvalJ : ∀ b,
      adjointFamilyGenerators L d.J ≤ (trivialCofibrations V).inverseImage (R b) :=
    generators_evaluation_le d.J (trivialCofibrations V) hJ
  let _ : (adjointFamilyGenerators L d.I).IsCardinalForSmallObjectArgument κ :=
    generators_isCardinalForSmallObjectArgument d.I (cofibrations V) hI hSourceI
  let _ : (adjointFamilyGenerators L d.J).IsCardinalForSmallObjectArgument κ :=
    generators_isCardinalForSmallObjectArgument d.J (trivialCofibrations V) hJ hSourceJ
  let _ : (adjointFamilyGenerators L d.I).HasSmallObjectArgument.{w} :=
    ⟨⟨κ, inferInstance, inferInstance, inferInstance⟩⟩
  let _ : (adjointFamilyGenerators L d.J).HasSmallObjectArgument.{w} :=
    ⟨⟨κ, inferInstance, inferInstance, inferInstance⟩⟩
  have hBase : d.I.rlp = d.J.rlp ⊓ weakEquivalences V := by
    rw [d.I_rlp, d.J_rlp]
    rfl
  have hAcyclicity : (adjointFamilyGenerators L d.J).rlp.llp ≤
      EvaluationTransfer.evaluationProperty R (weakEquivalences V) := by
    intro X Y f hf
    apply (EvaluationTransfer.evaluationProperty_iff R (weakEquivalences V) f).2
    intro a
    have hImage := rlp_llp_le_inverseImage_of_cardinal_closure
      (adjointFamilyGenerators L d.J) (trivialCofibrations V) (R a) κ (hEvalJ a)
    exact (hImage f hf).2
  exact EvaluationTransfer.evaluationProjectiveModelCategory.{w}
    L R adj d.I d.J (weakEquivalences V) hBase hAcyclicity

variable (d : CofibrantGenerationData V κ)
  (hI : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.I f → cofibrations V (f ▷ (a ⟶[V] b)))
  (hJ : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.J f → trivialCofibrations V (f ▷ (a ⟶[V] b)))
  (hSourceI : ∀ {X Y : V} (f : X ⟶ Y), d.I f →
    ∀ (F : κ.ord.ToType ⥤ V) [F.IsWellOrderContinuous],
      (∀ ⦃a b⦄ (φ : a ⟶ b), cofibrations V (F.map φ)) →
      PreservesColimit F (coyoneda.obj (op X)))
  (hSourceJ : ∀ {X Y : V} (f : X ⟶ Y), d.J f →
    ∀ (F : κ.ord.ToType ⥤ V) [F.IsWellOrderContinuous],
      (∀ ⦃a b⦄ (φ : a ⟶ b), trivialCofibrations V (F.map φ)) →
      PreservesColimit F (coyoneda.obj (op X)))

include hI hJ hSourceI hSourceJ

/-- The constructed weak class is the original objectwise weak-equivalence property. -/
theorem weakEquivalences_eq :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    weakEquivalences (EnrichedFunctorCat V A) =
      EvaluationTransfer.evaluationProperty
        (fun a : A => EnrichedFunctorCat.evaluation a) (weakEquivalences V) := by
  rfl

/-- Constructed cofibrations are the left class of the literal original free I-family. -/
theorem cofibrations_eq :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    cofibrations (EnrichedFunctorCat V A) = (generators (A := A) d.I).rlp.llp := by
  rfl

/-- The constructed fibrations are exactly the original base fibrations at every object. -/
theorem fibrations_eq :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    fibrations (EnrichedFunctorCat V A) =
      EvaluationTransfer.evaluationProperty
        (fun a : A => EnrichedFunctorCat.evaluation a) (fibrations V) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) :=
    modelCategory d hI hJ hSourceI hSourceJ
  change (generators (A := A) d.J).rlp = _
  rw [EvaluationTransfer.evaluatedGenerators_rlp_eq
    (fun a : A => EnrichedFunctorCat.Free.functor a)
    (fun a : A => EnrichedFunctorCat.evaluation a)
    (fun a => EnrichedFunctorCat.Free.adjunction a) d.J, d.J_rlp]

/-- The constructed trivial fibrations retain the original evaluated intersection. -/
theorem trivialFibrations_eq :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    trivialFibrations (EnrichedFunctorCat V A) =
      EvaluationTransfer.evaluationProperty
        (fun a : A => EnrichedFunctorCat.evaluation a) (trivialFibrations V) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) :=
    modelCategory d hI hJ hSourceI hSourceJ
  change fibrations (EnrichedFunctorCat V A) ⊓ weakEquivalences (EnrichedFunctorCat V A) = _
  rw [fibrations_eq d hI hJ hSourceI hSourceJ, weakEquivalences_eq d hI hJ hSourceI hSourceJ]
  exact (EvaluationTransfer.evaluationProperty_inf _ (fibrations V) (weakEquivalences V)).symm

/-- The constructed trivial cofibrations retain the complete literal free J-left class. -/
theorem trivialCofibrations_eq :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    trivialCofibrations (EnrichedFunctorCat V A) = (generators (A := A) d.J).rlp.llp := by
  let _ : ModelCategory (EnrichedFunctorCat V A) :=
    modelCategory d hI hJ hSourceI hSourceJ
  rw [← fibrations_llp (EnrichedFunctorCat V A)]
  rfl

/-- The constructed model retains both actual functorial weak-factorization systems. -/
theorem functorialFactorizations :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    HasFunctorialFactorization (cofibrations (EnrichedFunctorCat V A))
        (trivialFibrations (EnrichedFunctorCat V A)) ∧
      HasFunctorialFactorization (trivialCofibrations (EnrichedFunctorCat V A))
        (fibrations (EnrichedFunctorCat V A)) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) :=
    modelCategory d hI hJ hSourceI hSourceJ
  let _ : d.I.IsSmall.{w} := d.I_smallObject.isSmall
  let _ : d.J.IsSmall.{w} := d.J_smallObject.isSmall
  let _ : (cofibrations V).IsStableUnderCoproducts.{w} :=
    IsStableUnderCoproducts.of_llp_eq (cofibrations V) (trivialFibrations V)
      (trivialFibrations_llp V)
  let _ : (trivialCofibrations V).IsStableUnderCoproducts.{w} :=
    IsStableUnderCoproducts.of_llp_eq (trivialCofibrations V) (fibrations V)
      (fibrations_llp V)
  let _ : (cofibrations V).IsStableUnderTransfiniteComposition.{w} := by
    rw [← trivialFibrations_llp V]
    infer_instance
  let _ : (trivialCofibrations V).IsStableUnderTransfiniteComposition.{w} := by
    rw [← fibrations_llp V]
    infer_instance
  let _ : (generators (A := A) d.I).IsCardinalForSmallObjectArgument κ :=
    generators_isCardinalForSmallObjectArgument d.I (cofibrations V) hI hSourceI
  let _ : (generators (A := A) d.J).IsCardinalForSmallObjectArgument κ :=
    generators_isCardinalForSmallObjectArgument d.J (trivialCofibrations V) hJ hSourceJ
  constructor
  · rw [cofibrations_eq d hI hJ hSourceI hSourceJ]
    have hRight : trivialFibrations (EnrichedFunctorCat V A) =
        (generators (A := A) d.I).rlp := by
      rw [trivialFibrations_eq d hI hJ hSourceI hSourceJ,
        EvaluationTransfer.evaluatedGenerators_rlp_eq
          (fun a : A => EnrichedFunctorCat.Free.functor a)
          (fun a : A => EnrichedFunctorCat.evaluation a)
          (fun a => EnrichedFunctorCat.Free.adjunction a) d.I, d.I_rlp]
    rw [hRight]
    exact SmallObject.hasFunctorialFactorization (generators (A := A) d.I) κ
  · rw [trivialCofibrations_eq d hI hJ hSourceI hSourceJ]
    change HasFunctorialFactorization (generators (A := A) d.J).rlp.llp
      (generators (A := A) d.J).rlp
    exact SmallObject.hasFunctorialFactorization (generators (A := A) d.J) κ

/-- The actual original free enriched functor and evaluation form a Quillen adjunction. -/
theorem freeAtEvaluation_isQuillenAdjunction (a : A) :
    letI : ModelCategory (EnrichedFunctorCat V A) :=
      modelCategory d hI hJ hSourceI hSourceJ
    (EnrichedFunctorCat.Free.adjunction (V := V) a).IsQuillenAdjunction := by
  let _ : ModelCategory (EnrichedFunctorCat V A) :=
    modelCategory d hI hJ hSourceI hSourceJ
  apply CategoryTheory.Adjunction.IsQuillenAdjunction.mkOfPreservesFibrations
  · intro X Y f hf
    rw [fibrations_eq d hI hJ hSourceI hSourceJ] at hf
    exact (EvaluationTransfer.evaluationProperty_iff _ (fibrations V) f).mp hf a
  · intro X Y f hf
    rw [trivialFibrations_eq d hI hJ hSourceI hSourceJ] at hf
    exact (EvaluationTransfer.evaluationProperty_iff _ (trivialFibrations V) f).mp hf a

end HomotopicalAlgebra.EnrichedProjective
