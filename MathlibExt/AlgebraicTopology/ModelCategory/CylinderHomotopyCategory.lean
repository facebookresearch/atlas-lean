-- Author: @toskua, Avocado
module

public import MathlibExt.AlgebraicTopology.ModelCategory.RelativeHomotopy
public import Mathlib.CategoryTheory.Quotient
public import Mathlib.CategoryTheory.MorphismProperty.Basic

/-!
# The category of homotopy classes for a chosen functorial cylinder

Elementary homotopy means existence of a native left homotopy for the
specified functorial precylinder. Naturality makes this relation stable
under precomposition and postcomposition. Its native quotient category
therefore identifies maps exactly by the equivalence relation generated
by elementary homotopies.

This is Cisinski, Definition 2.4.14 (July 30, 2026 version). The construction
requires only functoriality and applies in any category. For an exact
presheaf cylinder it gives the homotopy classes in that definition.
-/

@[expose] public section

set_option autoImplicit false

open CategoryTheory

universe v u

namespace HomotopicalAlgebra.Precylinder

variable {C : Type u} [Category.{v} C] (P : Precylinder (𝟭 C))

/-- Existence of an elementary homotopy for the specified cylinder. -/
def elementaryHomotopyRel : HomRel C :=
  fun X _ f g ↦ Nonempty ((P.app X).LeftHomotopy f g)

instance elementaryHomotopyRel_isStableUnderPrecomp :
    HomRel.IsStableUnderPrecomp P.elementaryHomotopyRel where
  comp_left := by
    rintro _ _ _ a _ _ ⟨H⟩
    exact ⟨P.precompLeftHomotopy H a⟩

instance elementaryHomotopyRel_isStableUnderPostcomp :
    HomRel.IsStableUnderPostcomp P.elementaryHomotopyRel where
  comp_right := by
    rintro _ _ _ _ _ a ⟨H⟩
    exact ⟨H.postcomp a⟩

/-- The equivalence relation generated by elementary homotopies. -/
def homotopyRel : HomRel C :=
  fun X Y ↦ Relation.EqvGen (@elementaryHomotopyRel C _ P X Y)

instance homotopyRel_congruence : Congruence P.homotopyRel := by
  change Congruence (fun X Y ↦ Relation.EqvGen (@elementaryHomotopyRel C _ P X Y))
  simpa only [HomRel.compClosure_eq_self] using
    CategoryTheory.Quotient.compClosure.congruence P.elementaryHomotopyRel

/-- The native quotient category for the chosen elementary homotopies. -/
abbrev HomotopyQuotient : Type u :=
  CategoryTheory.Quotient P.elementaryHomotopyRel

/-- The canonical functor sending a map to its chosen-cylinder homotopy class. -/
abbrev homotopyQuotientFunctor : C ⥤ P.HomotopyQuotient :=
  CategoryTheory.Quotient.functor P.elementaryHomotopyRel

/-- Homotopy classes of maps, with the original morphism universe. -/
abbrev HomotopyClass (X Y : C) : Type v :=
  P.homotopyQuotientFunctor.obj X ⟶ P.homotopyQuotientFunctor.obj Y

/-- Equality in the quotient is exactly generated homotopy. -/
lemma homotopyQuotientFunctor_map_eq_iff {X Y : C} (f g : X ⟶ Y) :
    P.homotopyQuotientFunctor.map f = P.homotopyQuotientFunctor.map g ↔
      P.homotopyRel f g := by
  change (CategoryTheory.Quotient.functor P.elementaryHomotopyRel).homRel f g ↔ _
  rw [CategoryTheory.Quotient.functor_homRel_eq_compClosure_eqvGen,
    HomRel.compClosure_eq_self]
  rfl

/-- An elementary homotopy gives equality of homotopy classes. -/
lemma homotopyQuotientFunctor_map_eq {X Y : C} {f g : X ⟶ Y}
    (H : (P.app X).LeftHomotopy f g) :
    P.homotopyQuotientFunctor.map f = P.homotopyQuotientFunctor.map g :=
  CategoryTheory.Quotient.sound P.elementaryHomotopyRel ⟨H⟩

/-- A map is a homotopy equivalence when its homotopy class is invertible. -/
def homotopyEquivalences : MorphismProperty C :=
  (MorphismProperty.isomorphisms P.HomotopyQuotient).inverseImage
    P.homotopyQuotientFunctor

lemma homotopyEquivalences_iff {X Y : C} (f : X ⟶ Y) :
    P.homotopyEquivalences f ↔ IsIso (P.homotopyQuotientFunctor.map f) :=
  Iff.rfl

end HomotopicalAlgebra.Precylinder
