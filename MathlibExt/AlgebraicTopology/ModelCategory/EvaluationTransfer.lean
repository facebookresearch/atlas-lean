-- Author: @toskua, Avocado
module

public import MathlibExt.CategoryTheory.MorphismProperty.AdjointFamily
public import MathlibExt.CategoryTheory.MorphismProperty.FunctorCategory
public import MathlibExt.AlgebraicTopology.ModelCategory.GeneratedRecognition
public import Mathlib.CategoryTheory.Discrete.Basic

/-!
# Projective recognition through actual evaluation adjunctions

The literal free generator families and the original evaluations determine
the returned model classes. The two actual small-object arguments and left
acyclicity are explicit inputs. No model dictionary on the target is assumed.
-/

@[expose] public section

set_option autoImplicit false
noncomputable section
universe w s vC vD uC uD

open CategoryTheory Limits MorphismProperty

namespace HomotopicalAlgebra.EvaluationTransfer

variable {C : Type uC} [Category.{vC} C]
  {D : Type uD} [Category.{vD} D] {S : Type s}

/-- Bundle the given evaluations without adding relations between their indices. -/
def evaluationDiagram (R : S → D ⥤ C) : D ⥤ (Discrete S ⥤ C) where
  obj X := Discrete.functor (fun a => (R a).obj X)
  map f := Discrete.natTrans (fun a => (R a.as).map f)
  map_id X := by
    ext a
    exact (R a.as).map_id X
  map_comp f g := by
    ext a
    exact (R a.as).map_comp f g

/-- The given base property holds at each of the original evaluations. -/
def evaluationProperty (R : S → D ⥤ C) (P : MorphismProperty C) :
    MorphismProperty D :=
  (P.functorCategory (Discrete S)).inverseImage (evaluationDiagram R)

/-- Evaluation membership uses the original evaluated arrows at every index. -/
theorem evaluationProperty_iff (R : S → D ⥤ C) (P : MorphismProperty C)
    {X Y : D} (f : X ⟶ Y) :
    evaluationProperty R P f ↔ ∀ a, P ((R a).map f) :=
  ⟨fun h a => h ⟨a⟩, fun h a => h a.as⟩

/-- Evaluation commutes with the actual intersection of the two base properties. -/
theorem evaluationProperty_inf (R : S → D ⥤ C) (P Q : MorphismProperty C) :
    evaluationProperty R (P ⊓ Q) = evaluationProperty R P ⊓ evaluationProperty R Q := by
  ext X Y f
  rw [evaluationProperty_iff, MorphismProperty.inf_iff,
    evaluationProperty_iff, evaluationProperty_iff]
  constructor
  · intro h
    exact ⟨fun a => (h a).1, fun a => (h a).2⟩
  · rintro ⟨hP, hQ⟩ a
    exact ⟨hP a, hQ a⟩

/-- Reuse pointwise and inverse-image closure for the evaluated weak class. -/
theorem evaluationProperty_hasTwoOutOfThree (R : S → D ⥤ C)
    (W : MorphismProperty C) [W.HasTwoOutOfThreeProperty] :
    (evaluationProperty R W).HasTwoOutOfThreeProperty := by
  unfold evaluationProperty
  infer_instance

variable (L : S → C ⥤ D) (R : S → D ⥤ C) (adj : ∀ a, L a ⊣ R a)

include adj in
/-- Right lifting against the literal free family is detected by the given evaluations. -/
theorem evaluatedGenerators_rlp_eq (P : MorphismProperty C) :
    (MorphismProperty.adjointFamilyGenerators L P).rlp = evaluationProperty R P.rlp := by
  ext X Y f
  exact (MorphismProperty.adjointFamilyGenerators_rlp_iff L R adj P f).trans
    (evaluationProperty_iff R P.rlp f).symm

include adj in
/-- The actual base right-class intersection gives the target right-class intersection. -/
theorem evaluatedGenerators_trivialFibrations_eq
    (I J W : MorphismProperty C) (hBase : I.rlp = J.rlp ⊓ W) :
    (MorphismProperty.adjointFamilyGenerators L I).rlp =
      (MorphismProperty.adjointFamilyGenerators L J).rlp ⊓ evaluationProperty R W := by
  rw [evaluatedGenerators_rlp_eq L R adj I, hBase,
    evaluationProperty_inf, evaluatedGenerators_rlp_eq L R adj J]

variable (I J W : MorphismProperty C) [W.HasTwoOutOfThreeProperty]
  [(MorphismProperty.adjointFamilyGenerators L I).HasSmallObjectArgument.{w}]
  [(MorphismProperty.adjointFamilyGenerators L J).HasSmallObjectArgument.{w}]
  (hBase : I.rlp = J.rlp ⊓ W)
  (hAcyclicity : (MorphismProperty.adjointFamilyGenerators L J).rlp.llp ≤
    evaluationProperty R W)

include adj hBase hAcyclicity

/-- Recognition data retain the two literal free families and both generated WFS. -/
def evaluationRecognitionData :
    SmithModelStructureData.{w} (C := D)
      (MorphismProperty.adjointFamilyGenerators L I) (evaluationProperty R W) :=
  SmithModelStructureData.ofGenerators
    (MorphismProperty.adjointFamilyGenerators L I)
    (MorphismProperty.adjointFamilyGenerators L J) (evaluationProperty R W)
    (evaluationProperty_hasTwoOutOfThree R W)
    (evaluatedGenerators_trivialFibrations_eq L R adj I J W hBase) hAcyclicity

variable [HasFiniteLimits D] [HasFiniteColimits D]

/-- The named projective model dictionary generated by the original evaluation family. -/
@[instance_reducible]
def evaluationProjectiveModelCategory : ModelCategory D := by
  letI : CategoryWithCofibrations D :=
    ⟨(MorphismProperty.adjointFamilyGenerators L I).rlp.llp⟩
  letI : CategoryWithFibrations D :=
    ⟨(MorphismProperty.adjointFamilyGenerators L J).rlp⟩
  letI : CategoryWithWeakEquivalences D := ⟨evaluationProperty R W⟩
  exact (evaluationRecognitionData L R adj I J W hBase hAcyclicity).modelCategory
    (evaluationProperty_hasTwoOutOfThree R W) rfl rfl rfl

/-- The returned weak equivalences are exactly the original evaluated weak class. -/
theorem evaluationProjectiveWeakEquivalences_eq :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    weakEquivalences D = evaluationProperty R W := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  rfl

/-- The returned cofibrations are the left class generated by the literal free I-family. -/
theorem evaluationProjectiveCofibrations_eq :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    cofibrations D = (MorphismProperty.adjointFamilyGenerators L I).rlp.llp := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  rfl

/-- The returned fibrations are the base J-right class at each original evaluation. -/
theorem evaluationProjectiveFibrations_eq :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    fibrations D = evaluationProperty R J.rlp := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  change (MorphismProperty.adjointFamilyGenerators L J).rlp = _
  exact evaluatedGenerators_rlp_eq L R adj J

/-- The returned trivial fibrations are the base I-right class at every evaluation. -/
theorem evaluationProjectiveTrivialFibrations_eq :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    trivialFibrations D = evaluationProperty R I.rlp := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  change (MorphismProperty.adjointFamilyGenerators L J).rlp ⊓
    evaluationProperty R W = evaluationProperty R I.rlp
  rw [← evaluatedGenerators_trivialFibrations_eq L R adj I J W hBase]
  exact evaluatedGenerators_rlp_eq L R adj I

/-- The returned trivial cofibrations are the original generated J-left class. -/
theorem evaluationProjectiveTrivialCofibrations_eq :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    trivialCofibrations D = (MorphismProperty.adjointFamilyGenerators L J).rlp.llp := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  change (MorphismProperty.adjointFamilyGenerators L I).rlp.llp ⊓
    evaluationProperty R W = (MorphismProperty.adjointFamilyGenerators L J).rlp.llp
  exact (evaluationRecognitionData L R adj I J W hBase hAcyclicity).trivialCofibrations_eq.symm

/-- The actual free I small-object argument gives the returned cofibrant factorization. -/
theorem evaluationProjectiveCofibrantFactorization :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    HasFunctorialFactorization (cofibrations D) (trivialFibrations D) := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  rw [evaluationProjectiveCofibrations_eq L R adj I J W hBase hAcyclicity,
    evaluationProjectiveTrivialFibrations_eq L R adj I J W hBase hAcyclicity,
    ← evaluatedGenerators_rlp_eq L R adj I]
  infer_instance

/-- The actual free J small-object argument gives the returned fibrant factorization. -/
theorem evaluationProjectiveFibrantFactorization :
    letI : ModelCategory D :=
      evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
    HasFunctorialFactorization (trivialCofibrations D) (fibrations D) := by
  let _ : ModelCategory D :=
    evaluationProjectiveModelCategory L R adj I J W hBase hAcyclicity
  rw [evaluationProjectiveTrivialCofibrations_eq L R adj I J W hBase hAcyclicity,
    evaluationProjectiveFibrations_eq L R adj I J W hBase hAcyclicity,
    ← evaluatedGenerators_rlp_eq L R adj J]
  infer_instance

end HomotopicalAlgebra.EvaluationTransfer
