-- Author: @toskua
module

public import MathlibExt.AlgebraicTopology.ModelCategory.FunctorInjective.OriginalCompactSuccessorAttachments
public import MathlibExt.AlgebraicTopology.ModelCategory.FunctorInjective.OriginalObjectwiseCofibrationClosure

/-!
# Generation of the original objectwise cofibration class

The actual original continuous slice history and compact successor arrows
give generation by the same selected compact diagram family. The whole
original f, source, target and every natural-transformation map are retained.

This is the ordinary specialization of Jacob Lurie's *Higher Topos Theory*,
author PDF dated April 9, 2017, concluding proof of Lemma A.3.3.3 after
Lemmas A.3.3.16 and A.3.3.17, printed pages 881–884 (PDF pages 899–902).
The base coefficient model and actual selected compact family are source
data; no completed generation equality or functor model is an input.
-/

@[expose] public section

set_option autoImplicit false
noncomputable section

universe w uD vD uC vC

namespace HomotopicalAlgebra.FunctorInjective

open CategoryTheory CategoryTheory.Limits CategoryTheory.SmallObject
open CategoryTheory.SmallObject.CompactRootBaseChange

attribute [local instance] constructionIndexWellFounded constructionIndexSuccOrder

variable {D : Type uD} [Category.{vD} D] {C : Type uC} [Category.{vC} C]
  [ModelCategory C] {kappa : Cardinal.{w}} [Fact kappa.IsRegular]
  [OrderBot kappa.ord.ToType] (d : CofibrantGenerationData C kappa)
  (kappaLP : Cardinal.{w}) [Fact kappaLP.IsRegular]
  [IsCardinalLocallyPresentable C kappaLP] (s : Functor.EssentialIndexData.{w} D C)
  (b : BoundedConstruction d kappaLP s.equivalence)

/-- Every actual compact original arrow has both maps to its representative in the same family. -/
theorem originalCompactCofibration_mem_generated {F G : D ⥤ C} (f : F ⟶ G)
    (hf : compactCofibrationArrows D C b.cardinal (Arrow.mk f)) :
    b.family.generators.rlp.llp f := by
  let k := b.family.representative (Arrow.mk f) hf
  let e := b.family.representativeIso (Arrow.mk f) hf
  have hk : b.family.generators.rlp.llp (b.family.arrow k).hom :=
    b.family.generators.le_llp_rlp _ (b.family.arrow_mem k)
  exact (b.family.generators.rlp.llp.arrow_mk_iso_iff e).mpr hk

variable {F G : D ⥤ C} (f : F ⟶ G) (hf : ∀ a : D, cofibrations C (f.app a))

/-- Each real original native successor belongs to the same generated left class. -/
theorem originalGeneratedSuccessor
    (gamma : ConstructionIndex (originalSliceHistoryIndex d kappaLP s b f hf))
    (hgamma : ¬IsMax gamma) :
    b.family.generators.rlp.llp
      ((originalCofibrationTransfiniteSliceFiltration d kappaLP s b f hf).F.map
        (homOfLE (Order.le_succ gamma))) := by
  obtain ⟨F0, G0, u, v, f0, hCompact, hPushout⟩ :=
    originalCompactEverySuccessorAttachment d kappaLP s b f hf gamma hgamma
  exact b.family.generators.rlp.llp.of_isPushout hPushout
    (originalCompactCofibration_mem_generated d kappaLP s b f0 hCompact)

/-- The original f has its actual constructed transfinite witness in the same generated class. -/
def originalGeneratedFiltration :
    b.family.generators.rlp.llp.TransfiniteCompositionOfShape
      (ConstructionIndex (originalSliceHistoryIndex d kappaLP s b f hf)) f where
  toTransfiniteCompositionOfShape :=
    originalCofibrationTransfiniteSliceFiltration d kappaLP s b f hf
  map_mem := originalGeneratedSuccessor d kappaLP s b f hf

include hf in
/-- Every original pointwise cofibration is generated by the actual same compact arrow family. -/
theorem originalObjectwiseCofibration_mem_generated : b.family.generators.rlp.llp f :=
  b.family.generators.rlp.llp.transfiniteCompositionsOfShape_le _ _
    (originalGeneratedFiltration d kappaLP s b f hf).mem

/-- The full original objectwise cofibration property is contained in the same generated class. -/
theorem originalObjectwiseCofibrations_le_generated :
    (cofibrations C).functorCategory D ≤ b.family.generators.rlp.llp := by
  intro F G f hf
  exact originalObjectwiseCofibration_mem_generated d kappaLP s b f hf

/-- The SAME compact family's right-then-left class is exactly original objectwise cofibrations. -/
theorem originalGenerators_rlp_llp_eq_objectwiseCofibrations :
    b.family.generators.rlp.llp = (cofibrations C).functorCategory D :=
  le_antisymm (originalGenerators_rlp_llp_le_objectwiseCofibrations d kappaLP s b)
    (originalObjectwiseCofibrations_le_generated d kappaLP s b)

/-- The SAME family's full original right-lifting squares test every objectwise cofibration. -/
theorem originalGenerators_rlp_eq_objectwiseRlp :
    b.family.generators.rlp = ((cofibrations C).functorCategory D).rlp :=
  b.family.generators.rlp_llp_rlp.symm.trans
    (congrArg MorphismProperty.rlp
      (originalGenerators_rlp_llp_eq_objectwiseCofibrations d kappaLP s b))

/-- The actual SAME small-family weak saturation is exactly the original objectwise class. -/
theorem originalGenerators_weakSaturation_eq_objectwiseCofibrations :
    (MorphismProperty.transfiniteCompositions.{w}
      (MorphismProperty.coproducts.{w} b.family.generators).pushouts).retracts =
        (cofibrations C).functorCategory D := by
  let _ : b.family.generators.HasSmallObjectArgument.{w} := b.hasSmallObjectArgument
  rw [← b.family.generators.llp_rlp_of_hasSmallObjectArgument]
  exact originalGenerators_rlp_llp_eq_objectwiseCofibrations d kappaLP s b

/-- Generation retains the entire original natural transformation and all its components. -/
theorem originalGenerators_generated_iff_objectwise :
    b.family.generators.rlp.llp f ↔ ∀ a : D, cofibrations C (f.app a) := by
  rw [originalGenerators_rlp_llp_eq_objectwiseCofibrations d kappaLP s b]
  rfl

end HomotopicalAlgebra.FunctorInjective
