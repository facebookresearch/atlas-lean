/-!
# Original cellular source conditions for mapped projective models

The actual source Hom comparison transposes through each genuine adjunction.
Evaluations preserve the original colimits and jointly reflect the original
limits. In particular every produced cofibration is the equalizer of its own
two pushout inclusions, with no change to either inclusion or to its endpoints.

The source compactness bounds, generators, ordinal bottoms and constructed
model classes remain the original ones. The constructions implement the
source comparisons in Hovey, Appendix A, Lemma A.2 and Propositions A.4/A.8.
Full compactness follows by strong induction on the original ordinal type:
each actual cell boundary is captured in its original earlier closed prefix,
the derived same-ordinal adjoin encloses that same occurrence, and the genuine
tagged evaluated history captures the arbitrary original free-source map.
-/

set_option autoImplicit false

noncomputable section

universe w uA uV vV uC vC uJ vJ uD vD s t

open CategoryTheory Limits MorphismProperty Opposite MonoidalCategory
open scoped MonoidalClosed


namespace HomotopicalAlgebra.CellularLevelSource

variable {C : Type uC} [Category.{vC} C]

/-- A regular monomorphism equalizes the actual inclusions of any supplied self-pushout. -/
def effectiveForkOfIsPushout {X Y Z : C} (f : X ⟶ Y) [IsRegularMono f]
    (left right : Y ⟶ Z) (sq : IsPushout f f left right) :
    IsLimit (Fork.ofι f sq.w) := by
  let r : RegularMono f := IsRegularMono.getStruct f
  let k := sq.desc r.left r.right r.w
  have hk₀ : left ≫ k = r.left := sq.inl_desc _ _ _
  have hk₁ : right ≫ k = r.right := sq.inr_desc _ _ _
  let g (s : Fork left right) : Fork r.left r.right :=
    Fork.ofι s.ι (by
      rw [← hk₀, ← hk₁, ← Category.assoc, ← Category.assoc]
      exact congrArg (fun z => z ≫ k) s.condition)
  refine Fork.IsLimit.mk _ (fun s => r.isLimit.lift (g s)) ?_ ?_
  · intro s
    exact Fork.IsLimit.lift_ι r.isLimit
  · intro s m hm
    apply Fork.IsLimit.hom_ext r.isLimit
    have hg : r.isLimit.lift (g s) ≫ f = s.ι := Fork.IsLimit.lift_ι r.isLimit
    exact hm.trans hg.symm

variable [ModelCategory C]

/-- Original relative cells generated by cofibrations are original cofibrations. -/
theorem relativeCellMaps_le_cofibrations (P : MorphismProperty C)
    (hP : P ≤ cofibrations C) :
    SmallObject.relativeCellMaps.{w} P ≤ cofibrations C := by
  have hleft : (cofibrations C).rlp.llp = cofibrations C := by
    rw [cofibrations_rlp, trivialFibrations_llp]
  exact P.transfiniteCompositions_pushouts_coproducts_le_llp_rlp.trans
    ((antitone_llp (antitone_rlp hP)).trans (le_of_eq hleft))

variable {V : Type uV} [Category.{vV} V] [ModelCategory V]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]

/-- The exact original source bound controls every original evaluated cofibration chain. -/
theorem preservesCofibrationChain_free (d : CofibrantGenerationData V κ)
    (L : V ⥤ C) (R : C ⥤ V) (adj : L ⊣ R)
    [PreservesColimitsOfSize.{w, w} R]
    (hEval : cofibrations C ≤ (cofibrations V).inverseImage R)
    {W : V} (hW : IsUniformlySmallRelativeTo.{w} d.I W)
    (μ : Cardinal.{w}) [Fact μ.IsRegular] [OrderBot μ.ord.ToType] (hμ : hW.choose < μ)
    (F : μ.ord.ToType ⥤ C) [F.IsWellOrderContinuous]
    (hF : ∀ j, ¬ IsMax j → cofibrations C (F.map (homOfLE (Order.le_succ j)))) :
    PreservesColimit F (coyoneda.obj (op (L.obj W))) := by
  let _ : PreservesWellOrderContinuousOfShape μ.ord.ToType R :=
    { preservesColimitsOfShape := fun _ _ => inferInstance }
  let _ : (F ⋙ R).IsWellOrderContinuous := inferInstance
  let _ : PreservesColimit (F ⋙ R) (coyoneda.obj (op W)) :=
    CellularCofibrationTransport.preservesOriginalCofibrationChain d hW μ hμ
      (F ⋙ R) (fun j hj => hEval _ (hF j hj))
  exact adj.preservesColimit_leftAdjointSource W F

/-- The caller's exact cofibration cocone transposes through the original adjunction. -/
def mappedCofibrationCoconeFree (d : CofibrantGenerationData V κ)
    (L : V ⥤ C) (R : C ⥤ V) (adj : L ⊣ R)
    [PreservesColimitsOfSize.{w, w} R]
    (hEval : cofibrations C ≤ (cofibrations V).inverseImage R)
    {W : V} (hW : IsUniformlySmallRelativeTo.{w} d.I W)
    (μ : Cardinal.{w}) [Fact μ.IsRegular] [OrderBot μ.ord.ToType] (hμ : hW.choose < μ)
    (F : μ.ord.ToType ⥤ C) [F.IsWellOrderContinuous]
    (hF : ∀ j, ¬ IsMax j → cofibrations C (F.map (homOfLE (Order.le_succ j))))
    (c : Cocone F) (hc : IsColimit c) :
    IsColimit ((coyoneda.obj (op (L.obj W))).mapCocone c) := by
  letI : PreservesColimit F (coyoneda.obj (op (L.obj W))) :=
    preservesCofibrationChain_free d L R adj hEval hW μ hμ F hF
  exact isColimitOfPreserves (coyoneda.obj (op (L.obj W))) hc

/-- Uniform source smallness transposes through the actual free/evaluation adjunction
on the same original relative-cell chain, at the same original source bound. -/
theorem uniformlySmall_free (d : CofibrantGenerationData V κ)
    (L : V ⥤ C) (R : C ⥤ V) (adj : L ⊣ R)
    [PreservesColimitsOfSize.{w, w} R]
    (hEval : cofibrations C ≤ (cofibrations V).inverseImage R)
    (P : MorphismProperty C) (hP : P ≤ cofibrations C)
    {W : V} (hW : IsUniformlySmallRelativeTo.{w} d.I W) :
    IsUniformlySmallRelativeTo.{w} P (L.obj W) := by
  obtain ⟨β, hβ⟩ := CellularCofibrationTransport.uniformOriginalCofibrationChains d hW
  refine ⟨β, ?_⟩
  intro μ _ _ hμ F _ hF
  let _ : PreservesWellOrderContinuousOfShape μ.ord.ToType R :=
    { preservesColimitsOfShape := fun _ _ => inferInstance }
  let _ : (F ⋙ R).IsWellOrderContinuous := inferInstance
  let _ : PreservesColimit (F ⋙ R) (coyoneda.obj (op W)) :=
    hβ μ hμ (F ⋙ R) (fun j hj =>
      hEval _ (relativeCellMaps_le_cofibrations P hP _ (hF j hj)))
  exact adj.preservesColimit_leftAdjointSource W F

end HomotopicalAlgebra.CellularLevelSource

namespace HomotopicalAlgebra.EnrichedProjective.MappedSources

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V] [ModelCategory V]
  {A : Type uA} [EnrichedCategory V A]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  [Small.{w} A] [LocallySmall.{w} V] [HasColimitsOfSize.{w, w} V]
  (d : CofibrantGenerationData V κ)
  (hJ : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.J f → trivialCofibrations V (f ▷ (a ⟶[V] b)))
  (hSourceI : SourceCondition (A := A) (κ := κ) d.I)
  (hSourceJ : SourceCondition (A := A) (κ := κ) d.J)
  (hI : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.I f → cofibrations V (f ▷ (a ⟶[V] b)))

/-- The original evaluated self-pushout is an equalizer whenever all components are regular. -/
def effectiveForkOfEvaluations {X Y Z : EnrichedFunctorCat V A} (f : X ⟶ Y)
    (left right : Y ⟶ Z) (sq : IsPushout f f left right)
    (hReg : ∀ a : A, IsRegularMono ((EnrichedFunctorCat.evaluation a).map f)) :
    IsLimit (Fork.ofι f sq.w) := by
  apply EnrichedFunctorCat.evaluationJointlyReflectsLimits
  intro a
  let _ : IsRegularMono ((EnrichedFunctorCat.evaluation a).map f) := hReg a
  exact (isLimitMapConeForkEquiv (EnrichedFunctorCat.evaluation a) sq.w).symm
    (CellularLevelSource.effectiveForkOfIsPushout
      ((EnrichedFunctorCat.evaluation a).map f)
      ((EnrichedFunctorCat.evaluation a).map left)
      ((EnrichedFunctorCat.evaluation a).map right)
      (sq.map (EnrichedFunctorCat.evaluation a)))

include hJ hSourceI hSourceJ hI

/-- The actual produced model's cofibrations are regular monomorphisms at arbitrary endpoints. -/
theorem modelCategory_cofibrations_regularMono (eff : EffectiveCofibrations V) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    cofibrations (EnrichedFunctorCat V A) ≤ regularMono (EnrichedFunctorCat V A) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  intro X Y f hf
  have hEval := modelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI
  have hReg : ∀ a : A, IsRegularMono ((EnrichedFunctorCat.evaluation a).map f) :=
    fun a => eff _
      ((EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a)
  exact isRegularMono_of_regularMono (Fork.IsLimit.regularMono
    (effectiveForkOfEvaluations f (pushout.inl f f) (pushout.inr f f)
      (IsPushout.of_hasPushout f f) hReg))

/-- Every original canonical cofibration equalizes its own two actual pushout inclusions. -/
def modelCategoryOriginalPushoutEqualizer (eff : EffectiveCofibrations V)
    {X Y : EnrichedFunctorCat V A} (f : X ⟶ Y) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    cofibrations (EnrichedFunctorCat V A) f →
      IsLimit (Fork.ofι f (pushout.condition (f := f) (g := f))) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  intro hf
  let _ : IsRegularMono f :=
    modelCategory_cofibrations_regularMono d hJ hSourceI hSourceJ hI eff f hf
  exact CellularLevelSource.effectiveForkOfIsPushout f _ _ (IsPushout.of_hasPushout f f)

/-- Every actual canonical free source keeps its original uniform relative-I bound. -/
theorem modelCategory_free_uniformlySmall (a : A) (W : V)
    (hW : IsUniformlySmallRelativeTo.{w} d.I W) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    IsUniformlySmallRelativeTo.{w} (generators (A := A) d.I)
      ((EnrichedFunctorCat.Free.functor a).obj W) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  have hEval := modelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI
  apply CellularLevelSource.uniformlySmall_free d
    (EnrichedFunctorCat.Free.functor a) (EnrichedFunctorCat.evaluation a)
    (EnrichedFunctorCat.Free.adjunction a)
    (by
      intro X Y f hf
      exact (EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a)
    (generators (A := A) d.I) ?_ hW
  rw [cofibrations_eq d hJ hSourceI hSourceJ]
  exact le_llp_rlp _

/-- Original compact generating domains give uniformly small actual canonical free domains. -/
theorem modelCategory_free_I_domainSmall (hCell : CellularSource d) (a : A) (i : d.I.toSet) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    IsUniformlySmallRelativeTo.{w} (generators (A := A) d.I)
      ((EnrichedFunctorCat.Free.functor a).obj i.1.left) :=
  modelCategory_free_uniformlySmall d hJ hSourceI hSourceJ hI a i.1.left
    (CellularLocalizationSmallness.uniformly_small_of_compact hCell
      (hCell.I_domains_compact i))

/-- The actual canonical free generating codomain retains the original compact source bound. -/
theorem modelCategory_free_I_codomainSmall (hCell : CellularSource d) (a : A) (i : d.I.toSet) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    IsUniformlySmallRelativeTo.{w} (generators (A := A) d.I)
      ((EnrichedFunctorCat.Free.functor a).obj i.1.right) :=
  modelCategory_free_uniformlySmall d hJ hSourceI hSourceJ hI a i.1.right
    (CellularLocalizationSmallness.uniformly_small_of_compact hCell
      (hCell.I_codomains_compact i))

/-- Actual canonical free J domains use the original J-source smallness, without cofibrancy. -/
theorem modelCategory_free_J_domainSmall (hCell : CellularSource d) (a : A) (j : d.J.toSet) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    IsUniformlySmallRelativeTo.{w} (generators (A := A) d.I)
      ((EnrichedFunctorCat.Free.functor a).obj j.1.left) :=
  modelCategory_free_uniformlySmall d hJ hSourceI hSourceJ hI a j.1.left
    (hCell.J_domains_small j)

/-- Actual canonical free J codomains use the original noncofibrant-domain comparison. -/
theorem modelCategory_free_J_codomainSmall (hCell : CellularSource d) (a : A) (j : d.J.toSet) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    IsUniformlySmallRelativeTo.{w} (generators (A := A) d.I)
      ((EnrichedFunctorCat.Free.functor a).obj j.1.right) :=
  modelCategory_free_uniformlySmall d hJ hSourceI hSourceJ hI a j.1.right
    (CellularLocalizationSmallness.J_codomain_uniformly_small hCell j)

variable {C : Type uC} [Category.{vC} C]

/-- Original carrier cofibrations retain the exact underlying evaluation cofibrations. -/
theorem sourceModelCategory_cofibrations_le_evaluationProperty
    (e : C ≌ EnrichedFunctorCat V A) (R : A → C ⥤ V)
    (hR : ∀ a, e.functor ⋙ EnrichedFunctorCat.evaluation a ≅ R a) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    cofibrations C ≤ EvaluationTransfer.evaluationProperty R (cofibrations V) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  rw [← EvaluationTransfer.inverseEvaluationProperty_eq e.functor
    (fun a => EnrichedFunctorCat.evaluation a) R hR (cofibrations V)]
  intro X Y f hf
  exact modelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI
    (e.functor.map f) hf

/-- The same original free source preserves its unchanged original source-cell chains. -/
theorem sourceModelCategory_free_uniformlySmall
    (e : C ≌ EnrichedFunctorCat V A) (R : A → C ⥤ V)
    (hR : ∀ a, e.functor ⋙ EnrichedFunctorCat.evaluation a ≅ R a)
    (L : A → V ⥤ C) (adj : ∀ a, L a ⊣ R a)
    [∀ a, PreservesColimitsOfSize.{w, w} (R a)]
    (a : A) (W : V) (hW : IsUniformlySmallRelativeTo.{w} d.I W) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    IsUniformlySmallRelativeTo.{w} (adjointFamilyGenerators L d.I) ((L a).obj W) := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  have hEval := sourceModelCategory_cofibrations_le_evaluationProperty
    d hJ hSourceI hSourceJ hI e R hR
  apply CellularLevelSource.uniformlySmall_free d (L a) (R a) (adj a)
    (by
      intro X Y f hf
      exact (EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a)
    (adjointFamilyGenerators L d.I) ?_ hW
  rw [sourceCofibration_generators_eq d hJ hSourceI hSourceJ e R hR L adj]
  exact le_llp_rlp _

/-- The original carrier's exact cofibration is the equalizer of its original self-pushout pair. -/
def sourceModelCategoryOriginalPushoutEqualizer (eff : EffectiveCofibrations V)
    (e : C ≌ EnrichedFunctorCat V A) {X Y : C} (f : X ⟶ Y) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    cofibrations C f → IsLimit (Fork.ofι f (pushout.condition (f := f) (g := f))) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  intro hf
  let _ : IsRegularMono (e.functor.map f) :=
    modelCategory_cofibrations_regularMono d hJ hSourceI hSourceJ hI eff
      (e.functor.map f) hf
  exact isLimitOfIsLimitForkMap e.functor _
    (CellularLevelSource.effectiveForkOfIsPushout (e.functor.map f)
      (e.functor.map (pushout.inl f f)) (e.functor.map (pushout.inr f f))
      ((IsPushout.of_hasPushout f f).map e.functor))

/-- Effective monomorphisms are a conclusion for the same actual transported source model. -/
theorem sourceModelCategory_cofibrations_regularMono (eff : EffectiveCofibrations V)
    (e : C ≌ EnrichedFunctorCat V A) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    cofibrations C ≤ regularMono C := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  intro X Y f hf
  exact isRegularMono_of_regularMono (Fork.IsLimit.regularMono
    (sourceModelCategoryOriginalPushoutEqualizer d hJ hSourceI hSourceJ hI eff e f hf))

end HomotopicalAlgebra.EnrichedProjective.MappedSources


/-! ## Original family comparisons and the unchanged small-object cardinal -/

namespace CategoryTheory.Adjunction

variable {V : Type uV} [Category.{vV} V]
  {C : Type uC} [Category.{vC} C] {D : Type uD} [Category.{vD} D]
  {L : V ⥤ C} {R : C ⥤ V} {L' : V ⥤ D} {R' : D ⥤ V}

/-- Transport the original free adjunction through the actual carrier equivalence and evaluation isomorphism. -/
def mappedFreeAdjunction (e : C ≌ D) (adj : L ⊣ R)
    (hR : e.functor ⋙ R' ≅ R) : L ⋙ e.functor ⊣ R' := by
  let r : e.inverse ⋙ R ≅ R' :=
    Functor.isoWhiskerLeft e.inverse hR.symm ≪≫
      (Functor.associator e.inverse e.functor R').symm ≪≫
      Functor.isoWhiskerRight e.counitIso R' ≪≫ Functor.leftUnitor R'
  exact (adj.comp e.toAdjunction).ofNatIsoRight r

/-- The complete comparison between the original free functor and the transported enriched free functor. -/
def sourceFreeComparisonIso (e : C ≌ D) (adj : L ⊣ R) (adj' : L' ⊣ R')
    (hR : e.functor ⋙ R' ≅ R) : L ⋙ e.functor ≅ L' :=
  leftAdjointUniq (mappedFreeAdjunction e adj hR) adj'

end CategoryTheory.Adjunction


namespace HomotopicalAlgebra.EnrichedProjective.MappedSources

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V] [ModelCategory V]
  {A : Type uA} [EnrichedCategory V A] [Small.{w} A]
  [LocallySmall.{w} V] [HasColimitsOfSize.{w, w} V]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  {C : Type uC} [Category.{vC} C]
  (d : CofibrantGenerationData V κ)
  (hJ : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.J f → trivialCofibrations V (f ▷ (a ⟶[V] b)))
  (hSourceI : SourceCondition (A := A) (κ := κ) d.I)
  (hSourceJ : SourceCondition (A := A) (κ := κ) d.J)

/-- Same-cardinal generation on the original carrier, with its actual free I and J families. -/
def sourceGenerationData (e : C ≌ EnrichedFunctorCat V A) (R : A → C ⥤ V)
    (hR : ∀ a, e.functor ⋙ EnrichedFunctorCat.evaluation a ≅ R a)
    (L : A → V ⥤ C) (adj : ∀ a, L a ⊣ R a) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    CofibrantGenerationData C κ := by
  letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  letI : d.I.IsSmall.{w} := d.I_smallObject.isSmall
  letI : d.J.IsSmall.{w} := d.J_smallObject.isSmall
  let L' : A → V ⥤ EnrichedFunctorCat V A := fun a => EnrichedFunctorCat.Free.functor a
  let hL : ∀ a, L a ⋙ e.functor ≅ L' a := fun a =>
    Adjunction.sourceFreeComparisonIso e (adj a) (EnrichedFunctorCat.Free.adjunction a) (hR a)
  let q : ∀ a, L a ≅ L' a ⋙ e.inverse := fun a =>
    (Functor.rightUnitor (L a)).symm ≪≫ Functor.isoWhiskerLeft (L a) e.unitIso ≪≫
      (Functor.associator (L a) e.functor e.inverse).symm ≪≫
        Functor.isoWhiskerRight (hL a) e.inverse
  refine
    { I := adjointFamilyGenerators L d.I
      J := adjointFamilyGenerators L d.J
      I_smallObject := ?_
      J_smallObject := ?_
      I_rlp := ?_
      J_rlp := ?_ }
  · exact adjointFamilyGenerators_isCardinalForSmallObjectArgument_of_equivalence
      e L L' id q d.I κ (generators_isCardinal d.I hSourceI)
  · exact adjointFamilyGenerators_isCardinalForSmallObjectArgument_of_equivalence
      e L L' id q d.J κ (generators_isCardinal d.J hSourceJ)
  · rw [EvaluationTransfer.evaluatedGenerators_rlp_eq L R adj d.I, d.I_rlp]
    exact (sourceTrivialFibration_eq d hJ hSourceI hSourceJ e R hR).symm
  · rw [EvaluationTransfer.evaluatedGenerators_rlp_eq L R adj d.J, d.J_rlp]
    exact (sourceFibration_eq d hJ hSourceI hSourceJ e R hR).symm

end HomotopicalAlgebra.EnrichedProjective.MappedSources


open scoped Ordinal

namespace HomotopicalAlgebra.CellularLevelSource

theorem prefixType_lt {O : Type w} [LinearOrder O] [SuccOrder O] [WellFoundedLT O]
    (j : O) (hj : ¬ IsMax j) : typeLT (Set.Iic j) < typeLT O := by
  let e : Set.Iic j ≃o Set.Iio (Order.succ j) :=
    { toFun x := ⟨x.1, (Order.lt_succ_iff_of_not_isMax hj).2 x.2⟩
      invFun x := ⟨x.1, (Order.lt_succ_iff_of_not_isMax hj).1 x.2⟩
      left_inv _ := rfl
      right_inv _ := rfl
      map_rel_iff' := Iff.rfl }
  rw [e.ordinalType_congr, Ordinal.type_Iio_lt]
  exact Ordinal.typein_lt_type _ _

end HomotopicalAlgebra.CellularLevelSource


noncomputable section OriginalCellularityCapture

open CategoryTheory Limits MorphismProperty Opposite

namespace HomotopicalAlgebra.CellularLevelSource

variable {V : Type uV} [Category.{vV} V] [ModelCategory V]
  {C : Type uC} [Category.{vC} C] [ModelCategory C]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  (dV : CofibrantGenerationData V κ) (hV : CellularSource dV)
  (dC : CofibrantGenerationData C κ) (eff : EffectiveCofibrations C)
  (L : V ⥤ C) (R : C ⥤ V) (adj : L ⊣ R)
  (hEval : cofibrations C ≤ (cofibrations V).inverseImage R)
  {O : Type w} [LinearOrder O] [OrderBot O] [SuccOrder O] [WellFoundedLT O]
  {X Y : C} {f : X ⟶ Y}
  (c : RelativeCellComplex.{w} (fun _ : O => dC.I.homFamily) f)
  {K : Type w} [LinearOrder K] [OrderBot K] [SuccOrder K] [WellFoundedLT K]
  {Z : V} {u : R.obj X ⟶ Z}
  (b : RelativeCellComplex.{w} (fun _ : K => dV.I.homFamily) u)
  (r : Z ⟶ R.obj Y) (s : R.obj Y ⟶ Z) (hs : s ≫ r = 𝟙 (R.obj Y))
  (hr : u ≫ r = R.map f)
  (tag : b.Cells → c.Cells)
  (image : ∀ e : b.Cells, e.i.1.right ⟶ R.obj (tag e).i.1.right)
  (hImage : ∀ e : b.Cells, e.ι ≫ r = image e ≫ R.map (tag e).ι)
  {W : V} {γ : Cardinal.{w}} (hγ : Cardinal.aleph0 ≤ γ)
  (hW : IsCellularCompactAt.{w} dV.I W γ)

include dV hV dC eff L R adj hEval b r s hs hr tag image hImage hγ hW

private theorem capture_from_actual_history
    (enclose : ∀ a : c.Cells, ∃ t : CellularSubcomplex c,
      Cardinal.mk t.complex.Cells ≤ γ ∧
        ∃ k : a.i.1.right ⟶ t.endpoint, k ≫ t.inclusion = a.ι)
    (g : L.obj W ⟶ Y) :
    ∃ t : CellularSubcomplex c, Cardinal.mk t.complex.Cells ≤ γ ∧
      ∃ k : L.obj W ⟶ t.endpoint, k ≫ t.inclusion = g := by
  obtain ⟨v, hv, q, hq⟩ := hW K (R.obj X) Z u b ((adj.homEquiv W Y g) ≫ s)
  choose t ht cell hcell using fun e : v.complex.Cells => enclose (tag (v.originalCell e))
  let U : CellularSubcomplex c := EffectiveCellularSubcomplex.union dC eff t
  let inclusion (e : v.complex.Cells) : (t e).endpoint ⟶ U.endpoint :=
    EffectiveCellularSubcomplex.unionInclusion dC eff t e
  have hinc (e : v.complex.Cells) : inclusion e ≫ U.inclusion = (t e).inclusion :=
    EffectiveCellularSubcomplex.unionInclusion_ambient dC eff t e
  have hU : cofibrations C U.inclusion := EffectiveCellularSubcomplex.union_cofibration dC eff t
  let _ : Mono (R.map U.inclusion) := hV.mono_of_cofibration _ (hEval _ hU)
  let root : R.obj X ⟶ R.obj U.endpoint := R.map U.hom
  have hroot : root ≫ R.map U.inclusion = v.hom ≫ (v.inclusion ≫ r) := by
    dsimp only [root]
    calc
      R.map U.hom ≫ R.map U.inclusion = R.map (U.hom ≫ U.inclusion) :=
        (R.map_comp _ _).symm
      _ = R.map f := R.congr_map U.fac
      _ = u ≫ r := hr.symm
      _ = v.hom ≫ (v.inclusion ≫ r) :=
        (congrArg (fun z => z ≫ r) v.fac.symm).trans (Category.assoc _ _ _)
  let cells (e : v.complex.Cells) : e.i.1.right ⟶ R.obj U.endpoint :=
    eqToHom (congrArg (fun p : dV.I.toSet => p.1.right) (v.originalCell_label e)) ≫
      image (v.originalCell e) ≫ R.map (cell e) ≫ R.map (inclusion e)
  have hcells (e : v.complex.Cells) :
      cells e ≫ R.map U.inclusion = e.ι ≫ (v.inclusion ≫ r) := by
    dsimp only [cells]
    simp only [Category.assoc]
    rw [← R.map_comp, hinc, ← R.map_comp, hcell, ← hImage]
    rw [← Category.assoc, ← v.originalCell_inclusion]
    exact Category.assoc _ _ _
  obtain ⟨m, hm⟩ := v.complex.exists_lift_through_mono
    (v.inclusion ≫ r) (R.map U.inclusion) root hroot cells hcells
  have hbound : Cardinal.mk U.complex.Cells ≤ γ := by
    calc
      Cardinal.mk U.complex.Cells ≤ Cardinal.sum (fun e => Cardinal.mk (t e).complex.Cells) :=
        EffectiveCellularSubcomplex.union_cells_cardinal_le dC eff t
      _ ≤ Cardinal.sum (fun _ : v.complex.Cells => γ) := Cardinal.sum_le_sum _ _ ht
      _ = Cardinal.mk v.complex.Cells * γ := Cardinal.sum_const' _ _
      _ ≤ γ * γ := by simpa only [mul_comm] using mul_le_mul_right hv γ
      _ = γ := Cardinal.mul_eq_self hγ
  refine ⟨U, hbound, (adj.homEquiv W U.endpoint).symm (q ≫ m), ?_⟩
  apply (adj.homEquiv W Y).injective
  rw [adj.homEquiv_naturality_right, Equiv.apply_symm_apply,
    Category.assoc, hm, ← Category.assoc, hq, Category.assoc, hs, Category.comp_id]

end HomotopicalAlgebra.CellularLevelSource

end OriginalCellularityCapture


noncomputable section OriginalCellularityBoundary

open CategoryTheory Limits MorphismProperty
open scoped Ordinal

namespace HomotopicalAlgebra.CellularLevelSource

open EffectiveCellularSubcomplexExtension CellularLocalizationSmallness

variable {V : Type uV} [Category.{vV} V] [ModelCategory V]
  {C : Type uC} [Category.{vC} C] [ModelCategory C]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  (dV : CofibrantGenerationData V κ) (hV : CellularSource dV)
  (dC : CofibrantGenerationData C κ)
  {S : Type s} (L : S → V ⥤ C)
  (hI : dC.I = adjointFamilyGenerators L dV.I)
  {γ : Cardinal.{w}} (hγ : commonCompactBound hV ≤ γ)
  {O : Type w} [LinearOrder O] [OrderBot O] [SuccOrder O] [WellFoundedLT O]
  {X Y : C} {f : X ⟶ Y}
  (c : RelativeCellComplex.{w} (fun _ : O => dC.I.homFamily) f)

include dV hV dC L hI hγ c in
/-- The ordinal induction hypothesis captures each actual original free-cell boundary
inside its actual closed prefix, using the original base generating domain. -/
private theorem boundaries_from_ordinal_induction
    (ih : ∀ (O' : Type w) [LinearOrder O'] [OrderBot O'] [SuccOrder O']
      [WellFoundedLT O'], typeLT O' < typeLT O →
      ∀ (X' Y' : C) (f' : X' ⟶ Y')
        (c' : RelativeCellComplex.{w} (fun _ : O' => dC.I.homFamily) f')
        (a : S) (W : V), IsCellularCompactAt.{w} dV.I W γ →
        ∀ (g : (L a).obj W ⟶ Y'), ∃ t : CellularSubcomplex c',
          Cardinal.mk t.complex.Cells ≤ γ ∧
            ∃ k : (L a).obj W ⟶ t.endpoint, k ≫ t.inclusion = g)
    (e : c.Cells) :
    ∃ t : CellularSubcomplex (prefixComplex dC c e.j),
      Cardinal.mk t.complex.Cells ≤ γ ∧
        ∃ k : e.i.1.left ⟶ t.endpoint,
          k ≫ t.inclusion = boundary dC c e.j e.hj e.k := by
  let p : (adjointFamilyGenerators L dV.I).toSet :=
    ⟨e.i.1, by simpa only [hI] using e.i.2⟩
  let a := ((adjointFamilyGenerators_iff L dV.I p.1.hom).mp p.2).choose
  have hlabel : Arrow.mk e.i.1.hom = Arrow.mk ((L a.1).map a.2.1.hom) :=
    ((adjointFamilyGenerators_iff L dV.I p.1.hom).mp p.2).choose_spec
  have hdomain : e.i.1.left = (L a.1).obj a.2.1.left :=
    congrArg Arrow.left hlabel
  let g : (L a.1).obj a.2.1.left ⟶ c.F.obj e.j :=
    eqToHom hdomain.symm ≫ boundary dC c e.j e.hj e.k
  obtain ⟨t, ht, k, hk⟩ := ih (Set.Iic e.j)
    (CellularLevelSource.prefixType_lt e.j e.hj) X (c.F.obj e.j)
    (c.isoBot.inv ≫ c.F.map (homOfLE (bot_le : (⊥ : O) ≤ e.j)))
    (prefixComplex dC c e.j) a.1 a.2.1.left
    ((domain_compact hV a.2).mono hγ) g
  refine ⟨t, ht, eqToHom hdomain ≫ k, ?_⟩
  rw [Category.assoc, hk]
  dsimp only [g]
  exact (eqToIso hdomain).hom_inv_id_assoc _

end HomotopicalAlgebra.CellularLevelSource

end OriginalCellularityBoundary


noncomputable section OriginalCellularityOrdinal

open CategoryTheory Limits MorphismProperty
open scoped Ordinal
open HomotopicalAlgebra.CellularSubcomplexExtension
open HomotopicalAlgebra.CellularLocalizationSmallness

namespace HomotopicalAlgebra.CellularLevelSource

variable {V : Type uV} [Category.{vV} V] [ModelCategory V]
  [HasColimitsOfSize.{w, w} V]
  {C : Type uC} [Category.{vC} C] [ModelCategory C]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  (dV : CofibrantGenerationData V κ) (hV : CellularSource dV)
  (dC : CofibrantGenerationData C κ) (eff : EffectiveCofibrations C)
  {S : Type t} (L : S → V ⥤ C) (R : S → C ⥤ V)
  (adj : ∀ a, L a ⊣ R a) [∀ a, PreservesColimitsOfSize.{w, w} (R a)]
  (hI : dC.I = adjointFamilyGenerators L dV.I)
  (hEval : ∀ a, cofibrations C ≤ (cofibrations V).inverseImage (R a))
  {γ : Cardinal.{w}} (hγ : commonCompactBound hV ≤ γ)

include dV hV dC eff L R adj hI hEval hγ in
/-- Compactness of the actual free source on every original presented target
cell chain. Original boundary enclosures and evaluated histories are derived,
and the compactness bound, target ordinal and endpoint maps remain unchanged. -/
theorem free_cellularCompactAt
    (a : S) (W : V) (hW : IsCellularCompactAt.{w} dV.I W γ) :
    IsCellularCompactAt.{w} dC.I ((L a).obj W) γ := by
  have hγ0 : Cardinal.aleph0 ≤ γ :=
    (show Cardinal.aleph0 ≤ commonCompactBound hV from le_max_left _ _).trans hγ
  have hIcof : dC.I ≤ cofibrations C := by
    have hi := le_llp_rlp dC.I
    rw [dC.I_rlp, trivialFibrations_llp] at hi
    exact hi
  let P (o : Ordinal.{w}) : Prop :=
    ∀ (O : Type w) [LinearOrder O] [OrderBot O] [SuccOrder O] [WellFoundedLT O],
      typeLT O = o → ∀ (X Y : C) (f : X ⟶ Y)
        (c : RelativeCellComplex.{w} (fun _ : O => dC.I.homFamily) f)
        (b : S) (Z : V), IsCellularCompactAt.{w} dV.I Z γ →
          ∀ g : (L b).obj Z ⟶ Y, ∃ q : CellularSubcomplex c,
            Cardinal.mk q.complex.Cells ≤ γ ∧
              ∃ k : (L b).obj Z ⟶ q.endpoint, k ≫ q.inclusion = g
  have H : ∀ o : Ordinal.{w}, P o := by
    intro o
    apply WellFoundedLT.induction o
    intro o ih O _ _ _ _ ho X Y f c b Z hZ g
    have ih' : ∀ (O' : Type w) [LinearOrder O'] [OrderBot O'] [SuccOrder O']
        [WellFoundedLT O'], typeLT O' < typeLT O →
        ∀ (X' Y' : C) (f' : X' ⟶ Y')
          (c' : RelativeCellComplex.{w} (fun _ : O' => dC.I.homFamily) f')
          (b' : S) (Z' : V), IsCellularCompactAt.{w} dV.I Z' γ →
          ∀ g' : (L b').obj Z' ⟶ Y', ∃ q : CellularSubcomplex c',
            Cardinal.mk q.complex.Cells ≤ γ ∧
              ∃ k : (L b').obj Z' ⟶ q.endpoint, k ≫ q.inclusion = g' := by
      intro O' _ _ _ _ hless X' Y' f' c' b' Z' hZ' g'
      exact ih (typeLT O') (hless.trans_eq ho) O' rfl X' Y' f' c' b' Z' hZ' g'
    have enclose : ∀ e : c.Cells, ∃ q : CellularSubcomplex c,
        Cardinal.mk q.complex.Cells ≤ γ ∧
          ∃ k : e.i.1.right ⟶ q.endpoint, k ≫ q.inclusion = e.ι := by
      intro e
      obtain ⟨s, hs, h, hh⟩ :=
        boundaries_from_ordinal_induction
          dV hV dC L hI hγ c ih' e
      obtain ⟨q, hq, k, hk⟩ := CellularPrefixAdjoin.exists_original_adjoin dC c e s h hh
      exact ⟨q, hq.trans (Cardinal.add_le_of_le hγ0 hs
        (Cardinal.one_le_aleph0.trans hγ0)), k, hk⟩
    let hg : ∀ p : dC.I.toSet, cofibrations V ((R b).map p.1.hom) :=
      fun p => hEval b p.1.hom (hIcof p.1.hom p.2)
    let z := CellularEvaluationHistory.ofOriginalGenerators dV c (R b) hg
    exact capture_from_actual_history
      dV hV dC eff (L b) (R b) (adj b) (hEval b) c z.b z.r z.s z.hs z.hr
      z.tag z.image z.hImage hγ0 hZ enclose g
  intro O _ _ _ _ X Y f c g
  exact H (typeLT O) O rfl X Y f c a W hW g

end HomotopicalAlgebra.CellularLevelSource

end OriginalCellularityOrdinal


noncomputable section OriginalCellularityCellular

open CategoryTheory Limits MorphismProperty
open HomotopicalAlgebra.CellularLocalizationSmallness

namespace HomotopicalAlgebra.CellularLevelSource

variable {V : Type uV} [Category.{vV} V] [ModelCategory V]
  [HasColimitsOfSize.{w, w} V]
  {C : Type uC} [Category.{vC} C] [ModelCategory C]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  (dV : CofibrantGenerationData V κ) (hV : CellularSource dV)
  (dC : CofibrantGenerationData C κ) (eff : EffectiveCofibrations C)
  {S : Type t} (L : S → V ⥤ C) (R : S → C ⥤ V)
  (adj : ∀ a, L a ⊣ R a) [∀ a, PreservesColimitsOfSize.{w, w} (R a)]
  (hI : dC.I = adjointFamilyGenerators L dV.I)
  (hJ : dC.J = adjointFamilyGenerators L dV.J)
  (hEval : ∀ a, cofibrations C ≤ (cofibrations V).inverseImage (R a))

include dV hV dC eff L R adj hI hJ hEval in
theorem cellularSource_adjointFamily : CellularSource dC := by
  let γ := commonCompactBound hV
  have hIcof : dC.I ≤ cofibrations C := by
    have hi := le_llp_rlp dC.I
    rw [dC.I_rlp, trivialFibrations_llp] at hi
    exact hi
  refine
    { I_domains_compact := ?_
      I_codomains_compact := ?_
      J_domains_small := ?_
      effectiveCofibrations := eff }
  · intro p
    let q : (adjointFamilyGenerators L dV.I).toSet := ⟨p.1, by simpa only [hI] using p.2⟩
    let a := ((adjointFamilyGenerators_iff L dV.I q.1.hom).mp q.2).choose
    have hdom : p.1.left = (L a.1).obj a.2.1.left :=
      congrArg Arrow.left (((adjointFamilyGenerators_iff L dV.I q.1.hom).mp q.2).choose_spec)
    have hc : IsCellularCompactAt.{w} dC.I ((L a.1).obj a.2.1.left) γ :=
      free_cellularCompactAt
        dV hV dC eff L R adj hI hEval le_rfl a.1 a.2.1.left (domain_compact hV a.2)
    exact ⟨γ, hdom.symm ▸ hc⟩
  · intro p
    let q : (adjointFamilyGenerators L dV.I).toSet := ⟨p.1, by simpa only [hI] using p.2⟩
    let a := ((adjointFamilyGenerators_iff L dV.I q.1.hom).mp q.2).choose
    have hcod : p.1.right = (L a.1).obj a.2.1.right :=
      congrArg Arrow.right (((adjointFamilyGenerators_iff L dV.I q.1.hom).mp q.2).choose_spec)
    have hc : IsCellularCompactAt.{w} dC.I ((L a.1).obj a.2.1.right) γ :=
      free_cellularCompactAt
        dV hV dC eff L R adj hI hEval le_rfl a.1 a.2.1.right (codomain_compact hV a.2)
    exact ⟨γ, hcod.symm ▸ hc⟩
  · intro p
    let q : (adjointFamilyGenerators L dV.J).toSet := ⟨p.1, by simpa only [hJ] using p.2⟩
    let a := ((adjointFamilyGenerators_iff L dV.J q.1.hom).mp q.2).choose
    have hdom : p.1.left = (L a.1).obj a.2.1.left :=
      congrArg Arrow.left (((adjointFamilyGenerators_iff L dV.J q.1.hom).mp q.2).choose_spec)
    have hs : IsUniformlySmallRelativeTo.{w} dC.I ((L a.1).obj a.2.1.left) :=
      CellularLevelSource.uniformlySmall_free dV (L a.1) (R a.1) (adj a.1)
        (hEval a.1) dC.I hIcof (hV.J_domains_small a.2)
    exact hdom.symm ▸ hs

end HomotopicalAlgebra.CellularLevelSource

end OriginalCellularityCellular


noncomputable section OriginalMappedCellularModels

namespace HomotopicalAlgebra.EnrichedProjective.MappedSources

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V]
  [BraidedCategory V] [MonoidalClosed V] [ModelCategory V]
  {A : Type uA} [EnrichedCategory V A] [Small.{w} A]
  [LocallySmall.{w} V] [HasColimitsOfSize.{w, w} V]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  (d : CofibrantGenerationData V κ)
  (hJ : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.J f → trivialCofibrations V (f ▷ (a ⟶[V] b)))
  (hSourceI : SourceCondition (A := A) (κ := κ) d.I)
  (hSourceJ : SourceCondition (A := A) (κ := κ) d.J)
  (hI : ∀ a b : A, ∀ {X Y : V} (f : X ⟶ Y),
    d.I f → cofibrations V (f ▷ (a ⟶[V] b)))

include hJ hSourceI hSourceJ hI

/-- The original cellular coefficient source produces full cellularity of the
same canonical model and its literal original free I/J families at κ. -/
theorem modelCategory_cellularSource (hCell : CellularSource d) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    CellularSource (generationData d hJ hSourceI hSourceJ) := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  have hEval := modelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI
  exact CellularLevelSource.cellularSource_adjointFamily d hCell
    (generationData d hJ hSourceI hSourceJ)
    (modelCategory_cofibrations_regularMono d hJ hSourceI hSourceJ hI hCell.effectiveCofibrations)
    (fun a : A => EnrichedFunctorCat.Free.functor a)
    (fun a : A => EnrichedFunctorCat.evaluation a) (fun a => EnrichedFunctorCat.Free.adjunction a)
    rfl rfl (fun a {_ _} f hf =>
      (EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a)

/-- Every actual canonical free compact source has its full original-ordinal
compactness comparison at the same original source bound. -/
theorem modelCategory_free_cellularCompactAt (hCell : CellularSource d)
    {γ : Cardinal.{w}} (hγ : CellularLocalizationSmallness.commonCompactBound hCell ≤ γ)
    (a : A) (W : V) (hW : IsCellularCompactAt.{w} d.I W γ) :
    letI : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
    IsCellularCompactAt.{w} (generators (A := A) d.I) ((EnrichedFunctorCat.Free.functor a).obj W) γ := by
  let _ : ModelCategory (EnrichedFunctorCat V A) := modelCategory d hJ hSourceI hSourceJ
  have hEval := modelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI
  exact CellularLevelSource.free_cellularCompactAt d hCell (generationData d hJ hSourceI hSourceJ)
    (modelCategory_cofibrations_regularMono d hJ hSourceI hSourceJ hI hCell.effectiveCofibrations)
    (fun a : A => EnrichedFunctorCat.Free.functor a)
    (fun a : A => EnrichedFunctorCat.evaluation a) (fun a => EnrichedFunctorCat.Free.adjunction a)
    rfl (fun a {_ _} f hf =>
      (EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a) hγ a W hW

variable {C : Type uC} [Category.{vC} C]

/-- Full cellularity is a conclusion for the unchanged original carrier,
original free/evaluation maps and original same-κ generation data. -/
theorem sourceModelCategory_cellularSource (hCell : CellularSource d)
    (e : C ≌ EnrichedFunctorCat V A) (R : A → C ⥤ V)
    (hR : ∀ a, e.functor ⋙ EnrichedFunctorCat.evaluation a ≅ R a)
    (L : A → V ⥤ C) (adj : ∀ a, L a ⊣ R a)
    [∀ a, PreservesColimitsOfSize.{w, w} (R a)] :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    CellularSource (sourceGenerationData d hJ hSourceI hSourceJ e R hR L adj) := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  have hEval := sourceModelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI e R hR
  exact CellularLevelSource.cellularSource_adjointFamily d hCell
    (sourceGenerationData d hJ hSourceI hSourceJ e R hR L adj)
    (sourceModelCategory_cofibrations_regularMono d hJ hSourceI hSourceJ hI hCell.effectiveCofibrations e)
    L R adj rfl rfl (fun a {_ _} f hf =>
      (EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a)

/-- The literal original free source is compact on its unchanged original I-cell
histories, with every original cell occurrence, ordinal and endpoint map retained. -/
theorem sourceModelCategory_free_cellularCompactAt (hCell : CellularSource d)
    (e : C ≌ EnrichedFunctorCat V A) (R : A → C ⥤ V)
    (hR : ∀ a, e.functor ⋙ EnrichedFunctorCat.evaluation a ≅ R a)
    (L : A → V ⥤ C) (adj : ∀ a, L a ⊣ R a)
    [∀ a, PreservesColimitsOfSize.{w, w} (R a)]
    {γ : Cardinal.{w}} (hγ : CellularLocalizationSmallness.commonCompactBound hCell ≤ γ)
    (a : A) (W : V) (hW : IsCellularCompactAt.{w} d.I W γ) :
    letI : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
    IsCellularCompactAt.{w} (adjointFamilyGenerators L d.I) ((L a).obj W) γ := by
  let _ : ModelCategory C := sourceModelCategory d hJ hSourceI hSourceJ e
  have hEval := sourceModelCategory_cofibrations_le_evaluationProperty d hJ hSourceI hSourceJ hI e R hR
  exact CellularLevelSource.free_cellularCompactAt d hCell
    (sourceGenerationData d hJ hSourceI hSourceJ e R hR L adj)
    (sourceModelCategory_cofibrations_regularMono d hJ hSourceI hSourceJ hI hCell.effectiveCofibrations e)
    L R adj rfl (fun a {_ _} f hf =>
      (EvaluationTransfer.evaluationProperty_iff _ _ f).mp (hEval f hf) a) hγ a W hW

end HomotopicalAlgebra.EnrichedProjective.MappedSources

end OriginalMappedCellularModels
