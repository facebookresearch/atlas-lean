import MathlibExt.AlgebraicTopology.ModelCategory.CofibrantlyGenerated
import MathlibExt.AlgebraicTopology.ModelCategory.EvaluationTransfer
import MathlibExt.AlgebraicTopology.ModelCategory.QuillenAdjunction
import MathlibExt.CategoryTheory.SmallObject.DiagramAcyclicity
import MathlibExt.CategoryTheory.MorphismProperty.WeakFactorizationSystem
import Mathlib.CategoryTheory.Limits.EssentiallySmall
import Mathlib.CategoryTheory.Limits.FunctorCategory.Finite
import Mathlib.AlgebraicTopology.ModelCategory.Instances

/-!
# Projective model structures on functor categories

Given cofibrant generation data for a model category C at a regular cardinal, this file
constructs the projective model structure on J ⥤ C when J is small and locally small in the
cardinal’s universe. Weak equivalences, fibrations and trivial fibrations are objectwise,
while cofibrations are generated by the free-diagram images of the base generating
cofibrations. Both functorial factorizations are constructed, and free evaluation is left
Quillen to evaluation.
-/

set_option autoImplicit false
noncomputable section
universe w uJ vJ uC vC

open CategoryTheory CategoryTheory.Limits MorphismProperty

namespace HomotopicalAlgebra.FunctorProjective

variable {J : Type uJ} [Category.{vJ} J] {C : Type uC} [Category.{vC} C]
  [ModelCategory C] {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  [Small.{w} J] [LocallySmall.{w} J]

/-- Construct the ordinary projective functor model from the actual base cardinal generators.
Both lifted SOAs and left acyclicity are derived from the original cells. -/
abbrev modelCategory (d : CofibrantGenerationData C κ) : ModelCategory (J ⥤ C) := by
  let _ : HasCoproducts.{w} C := d.I_smallObject.hasCoproducts
  let _ : ∀ i j : J, HasCoproductsOfShape (i ⟶ j) C :=
    fun i j => hasCoproductsOfShape_of_small C (i ⟶ j)
  let L : J → C ⥤ (J ⥤ C) :=
    fun j => evaluationLeftAdjoint.{vJ, vC, uJ, uC} C j
  let R : J → (J ⥤ C) ⥤ C := fun j => (evaluation J C).obj j
  let adj : ∀ j, L j ⊣ R j := fun j => evaluationAdjunctionRight C j
  let _ : (adjointFamilyGenerators L d.I).IsCardinalForSmallObjectArgument κ :=
    isCardinalForSmallObjectArgument_freeDiagrams (J := J) d.I κ d.I_smallObject
  let _ : (adjointFamilyGenerators L d.J).IsCardinalForSmallObjectArgument κ :=
    isCardinalForSmallObjectArgument_freeDiagrams (J := J) d.J κ d.J_smallObject
  let _ : (adjointFamilyGenerators L d.I).HasSmallObjectArgument.{w} :=
    ⟨⟨κ, inferInstance, inferInstance, inferInstance⟩⟩
  let _ : (adjointFamilyGenerators L d.J).HasSmallObjectArgument.{w} :=
    ⟨⟨κ, inferInstance, inferInstance, inferInstance⟩⟩
  have hBase : d.I.rlp = d.J.rlp ⊓ weakEquivalences C := by
    rw [d.I_rlp, d.J_rlp]
    rfl
  have hJ : d.J ≤ trivialCofibrations C := by
    have h := d.J.le_llp_rlp
    rw [d.J_rlp, fibrations_llp] at h
    exact h
  let _ : (trivialCofibrations C).IsStableUnderCoproducts.{w} :=
    IsStableUnderCoproducts.of_llp_eq (trivialCofibrations C) (fibrations C)
      (fibrations_llp C)
  let _ : (trivialCofibrations C).IsStableUnderTransfiniteCompositionOfShape κ.ord.ToType := by
    rw [← fibrations_llp C]
    infer_instance
  have hAcyclicity : (adjointFamilyGenerators L d.J).rlp.llp ≤
      EvaluationTransfer.evaluationProperty R (weakEquivalences C) := by
    have hActual := freeDiagrams_leftClass_le_functorCategory (J := J)
      d.J (trivialCofibrations C) (weakEquivalences C) κ d.J_smallObject hJ inf_le_right
    intro X Y f hf
    apply (EvaluationTransfer.evaluationProperty_iff R (weakEquivalences C) f).2
    intro j
    exact hActual f hf j
  exact EvaluationTransfer.evaluationProjectiveModelCategory.{w}
    L R adj d.I d.J (weakEquivalences C) hBase hAcyclicity

/-- The constructed model has exactly the objectwise base weak equivalences. -/
theorem weakEquivalences_eq (d : CofibrantGenerationData C κ) :
    letI : ModelCategory (J ⥤ C) := modelCategory (J := J) d
    weakEquivalences (J ⥤ C) = (weakEquivalences C).functorCategory J := by
  let _ : ModelCategory (J ⥤ C) := modelCategory (J := J) d
  ext X Y f
  exact EvaluationTransfer.evaluationProperty_iff
    (fun j : J => (evaluation J C).obj j) (weakEquivalences C) f

/-- The constructed fibrations are exactly the objectwise base fibrations. -/
theorem fibrations_eq (d : CofibrantGenerationData C κ) :
    letI : ModelCategory (J ⥤ C) := modelCategory (J := J) d
    fibrations (J ⥤ C) = (fibrations C).functorCategory J := by
  let _ : ModelCategory (J ⥤ C) := modelCategory (J := J) d
  let _ : HasCoproducts.{w} C := d.I_smallObject.hasCoproducts
  let _ : ∀ i j : J, HasCoproductsOfShape (i ⟶ j) C :=
    fun i j => hasCoproductsOfShape_of_small C (i ⟶ j)
  let L : J → C ⥤ (J ⥤ C) :=
    fun j => evaluationLeftAdjoint.{vJ, vC, uJ, uC} C j
  let R : J → (J ⥤ C) ⥤ C := fun j => (evaluation J C).obj j
  change (adjointFamilyGenerators L d.J).rlp = _
  rw [EvaluationTransfer.evaluatedGenerators_rlp_eq L R
    (fun j => evaluationAdjunctionRight C j) d.J, d.J_rlp]
  ext X Y f
  exact EvaluationTransfer.evaluationProperty_iff R (fibrations C) f

/-- The constructed trivial fibrations are exactly the objectwise base class. -/
theorem trivialFibrations_eq (d : CofibrantGenerationData C κ) :
    letI : ModelCategory (J ⥤ C) := modelCategory (J := J) d
    trivialFibrations (J ⥤ C) = (trivialFibrations C).functorCategory J := by
  let _ : ModelCategory (J ⥤ C) := modelCategory (J := J) d
  change fibrations (J ⥤ C) ⊓ weakEquivalences (J ⥤ C) = _
  rw [fibrations_eq d, weakEquivalences_eq d]
  ext X Y f
  constructor
  · rintro ⟨hf, hw⟩ j
    exact ⟨hf j, hw j⟩
  · intro h
    exact ⟨fun j => (h j).1, fun j => (h j).2⟩

/-- Cofibrations retain the literal free images of the base I-family. -/
theorem cofibrations_eq (d : CofibrantGenerationData C κ) :
    let _ : HasCoproducts.{w} C := d.I_smallObject.hasCoproducts
    let _ : ∀ i j : J, HasCoproductsOfShape (i ⟶ j) C :=
      fun i j => hasCoproductsOfShape_of_small C (i ⟶ j)
    letI : ModelCategory (J ⥤ C) := modelCategory (J := J) d
    cofibrations (J ⥤ C) =
      (adjointFamilyGenerators (fun j : J => evaluationLeftAdjoint C j) d.I).rlp.llp := by
  rfl

/-- The constructed model admits both required functorial factorizations. -/
theorem functorialFactorizations (d : CofibrantGenerationData C κ) :
    letI : ModelCategory (J ⥤ C) := modelCategory (J := J) d
    HasFunctorialFactorization (cofibrations (J ⥤ C)) (trivialFibrations (J ⥤ C)) ∧
      HasFunctorialFactorization (trivialCofibrations (J ⥤ C)) (fibrations (J ⥤ C)) := by
  let _ : HasCoproducts.{w} C := d.I_smallObject.hasCoproducts
  let _ : ∀ i j : J, HasCoproductsOfShape (i ⟶ j) C :=
    fun i j => hasCoproductsOfShape_of_small C (i ⟶ j)
  let L : J → C ⥤ (J ⥤ C) :=
    fun j => evaluationLeftAdjoint.{vJ, vC, uJ, uC} C j
  let R : J → (J ⥤ C) ⥤ C := fun j => (evaluation J C).obj j
  let adj : ∀ j, L j ⊣ R j := fun j => evaluationAdjunctionRight C j
  let _ : (adjointFamilyGenerators L d.I).IsCardinalForSmallObjectArgument κ :=
    isCardinalForSmallObjectArgument_freeDiagrams (J := J) d.I κ d.I_smallObject
  let _ : (adjointFamilyGenerators L d.J).IsCardinalForSmallObjectArgument κ :=
    isCardinalForSmallObjectArgument_freeDiagrams (J := J) d.J κ d.J_smallObject
  let _ : (adjointFamilyGenerators L d.I).HasSmallObjectArgument.{w} :=
    ⟨⟨κ, inferInstance, inferInstance, inferInstance⟩⟩
  let _ : (adjointFamilyGenerators L d.J).HasSmallObjectArgument.{w} :=
    ⟨⟨κ, inferInstance, inferInstance, inferInstance⟩⟩
  let _ : ModelCategory (J ⥤ C) := modelCategory (J := J) d
  constructor
  · rw [cofibrations_eq d]
    have hRight : trivialFibrations (J ⥤ C) = (adjointFamilyGenerators L d.I).rlp := by
      rw [trivialFibrations_eq d, EvaluationTransfer.evaluatedGenerators_rlp_eq L R adj d.I,
        d.I_rlp]
      ext X Y f
      exact (EvaluationTransfer.evaluationProperty_iff R (trivialFibrations C) f).symm
    rw [hRight]
    exact SmallObject.hasFunctorialFactorization (adjointFamilyGenerators L d.I) κ
  · have hLeft : trivialCofibrations (J ⥤ C) = (fibrations (J ⥤ C)).llp :=
      (fibrations_llp (J ⥤ C)).symm
    rw [hLeft]
    change HasFunctorialFactorization (adjointFamilyGenerators L d.J).rlp.llp
      (adjointFamilyGenerators L d.J).rlp
    exact SmallObject.hasFunctorialFactorization (adjointFamilyGenerators L d.J) κ

/-- The actual coproduct free diagram and evaluation form a Quillen adjunction. -/
theorem evaluation_isQuillenAdjunction (d : CofibrantGenerationData C κ) (j : J) :
    let _ : HasCoproducts.{w} C := d.I_smallObject.hasCoproducts
    let _ : ∀ i k : J, HasCoproductsOfShape (i ⟶ k) C :=
      fun i k => hasCoproductsOfShape_of_small C (i ⟶ k)
    letI : ModelCategory (J ⥤ C) := modelCategory (J := J) d
    (evaluationAdjunctionRight C j).IsQuillenAdjunction := by
  let _ : HasCoproducts.{w} C := d.I_smallObject.hasCoproducts
  let _ : ∀ i k : J, HasCoproductsOfShape (i ⟶ k) C :=
    fun i k => hasCoproductsOfShape_of_small C (i ⟶ k)
  let _ : ModelCategory (J ⥤ C) := modelCategory (J := J) d
  apply CategoryTheory.Adjunction.IsQuillenAdjunction.mkOfPreservesFibrations
  · intro X Y f hf
    rw [fibrations_eq d] at hf
    exact hf j
  · intro X Y f hf
    rw [trivialFibrations_eq d] at hf
    exact hf j

end HomotopicalAlgebra.FunctorProjective
