module

public import MathlibExt.AlgebraicTopology.ModelCategory.ModuleTransfer

/-!
# Cofibrations forgotten from the original right-module generators

The actual free right-module maps are right tensors of the original base
generators. A cofibrant scalar and the base pushout-product axiom put them
in the base cofibration class. Forgetting preserves the complete original
cell diagram and its endpoint, so closure and the whole Arrow retract give
the same statement for the full generated class. The caller's cardinal,
ordinal bottom and arbitrary original endpoints are retained.
-/

@[expose] public section

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

universe u v w

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open CategoryTheory.MorphismProperty CategoryTheory.SmallObject HomotopicalAlgebra
open CategoryTheory.MonoidalOpposite
open scoped CategoryTheory.MonObj

namespace HomotopicalAlgebra.ModuleTransfer.RightForgetCofibrations

attribute [local instance] MonoidalLeftAction.monoidalOppositeLeftAction

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C]
  [MonoidalClosed C] [ModelCategory C] [IsClosedSymmetricMonoidalModelCategory C]
  {A : C} [MonObj A] [HasColimitsOfSize.{0, 0} C] [IsCofibrant A]

section OriginalCells

variable (I : MorphismProperty C)

omit [HasColimitsOfSize.{0, 0} C] in
/-- An original free right-I generator forgets to a base cofibration. -/
theorem originalRightFreeI_underlying_cofibration
    (hI : I.rlp = trivialFibrations C) :
    I.strictMap (RightModuleFree.functor A) ≤
      (cofibrations C).inverseImage (Mod.forget (D := C) (mop A)) := by
  intro N N' f hf
  cases hf with
  | @map X Y g hi =>
    change cofibrations C (g ▷ A)
    have hiC := I.le_llp_rlp g hi
    rw [hI, trivialFibrations_llp] at hiC
    let : (ihom.adjunction A).IsQuillenAdjunction :=
      ihomAdjunction_isQuillenAdjunction_of_isCofibrant A
    have hLeft : cofibrations C (A ◁ g) :=
      Adjunction.IsQuillenAdjunction.preservesCofibrations (adj := ihom.adjunction A) g hiC
    let e : CategoryTheory.Arrow.mk (A ◁ g) ≅ CategoryTheory.Arrow.mk (g ▷ A) :=
      CategoryTheory.Arrow.isoMk (β_ A X) (β_ A Y) (BraidedCategory.braiding_naturality_right A g).symm
    exact ((cofibrations C).arrow_mk_iso_iff e).mp hLeft

variable [HasColimitsOfSize.{w, w} C]
  (κ : Cardinal.{w}) [Fact κ.IsRegular] [OrderBot κ.ord.ToType]
  [(I.strictMap (RightModuleFree.functor A)).IsCardinalForSmallObjectArgument κ]

include κ in
omit [HasColimitsOfSize.{0, 0} C] in
/-- The whole original free-I cell and retract class forgets to base cofibrations. -/
theorem originalRightILeft_underlying_cofibration
    (hI : I.rlp = trivialFibrations C) :
    (I.strictMap (RightModuleFree.functor A)).rlp.llp ≤
      (cofibrations C).inverseImage (Mod.forget (D := C) (mop A)) := by
  let U := Mod.forget (D := C) (mop A)
  let : PreservesColimitsOfSize.{w, w} U := RightModuleFree.forgetPreservesColimits.{w} A
  let : PreservesWellOrderContinuousOfShape κ.ord.ToType U :=
    { preservesColimitsOfShape := fun _ _ => by infer_instance }
  let : (cofibrations C).IsStableUnderCoproducts.{w} := by
    rw [← trivialFibrations_llp]
    infer_instance
  let : (cofibrations C).IsStableUnderCobaseChange := by
    rw [← trivialFibrations_llp]
    infer_instance
  let : (cofibrations C).IsStableUnderTransfiniteCompositionOfShape κ.ord.ToType := by
    rw [← trivialFibrations_llp]
    infer_instance
  exact MorphismProperty.rlp_llp_le_inverseImage_of_cardinal_closure
    (I.strictMap (RightModuleFree.functor A)) (cofibrations C) U κ
    (originalRightFreeI_underlying_cofibration I hI)

variable [ModelCategory (RightModuleFree.Carrier A)]

include κ in
omit [HasColimitsOfSize.{0, 0} C] in
/-- Every cofibration in the model generated by the original right-I class forgets to a base cofibration. -/
theorem originalRightCofibration_underlying
    (hI : I.rlp = trivialFibrations C)
    (hCof : cofibrations (RightModuleFree.Carrier A) =
      (I.strictMap (RightModuleFree.functor A)).rlp.llp) :
    cofibrations (RightModuleFree.Carrier A) ≤
      (cofibrations C).inverseImage (Mod.forget (D := C) (mop A)) := by
  rw [hCof]
  exact originalRightILeft_underlying_cofibration I κ hI

include κ in
omit [HasColimitsOfSize.{0, 0} C] in
/-- Created weakness and the earned cofibration image give the full trivial-cofibration image. -/
theorem originalRightTrivialCofibration_underlying
    (hI : I.rlp = trivialFibrations C)
    (hCof : cofibrations (RightModuleFree.Carrier A) =
      (I.strictMap (RightModuleFree.functor A)).rlp.llp)
    (hW : weakEquivalences (RightModuleFree.Carrier A) =
      (weakEquivalences C).inverseImage (Mod.forget (D := C) (mop A))) :
    trivialCofibrations (RightModuleFree.Carrier A) ≤
      (trivialCofibrations C).inverseImage (Mod.forget (D := C) (mop A)) := by
  intro N N' f hf
  exact ⟨originalRightCofibration_underlying I κ hI hCof f hf.1, hW.le f hf.2⟩

include κ in
/-- The forgotten original initial map has genuinely initial source and cofibrant target. -/
theorem originalRightCofibrant_underlying_cofibrant
    (hI : I.rlp = trivialFibrations C)
    (hCof : cofibrations (RightModuleFree.Carrier A) =
      (I.strictMap (RightModuleFree.functor A)).rlp.llp)
    (N : RightModuleFree.Carrier A) [IsCofibrant N] : IsCofibrant N.X := by
  let U := Mod.forget (D := C) (mop A)
  let : PreservesColimitsOfSize.{0, 0} U := RightModuleFree.forgetPreservesColimits.{0} A
  have hi : cofibrations C (U.map (initial.to N)) := by
    apply originalRightILeft_underlying_cofibration I κ hI
    rw [← hCof]
    exact mem_cofibrations (initial.to N)
  let : Cofibration (U.map (initial.to N)) := (cofibration_iff _).mpr hi
  exact (isCofibrant_iff_of_isInitial (U.map (initial.to N))
    (initialIsInitial.isInitialObj U)).mpr inferInstance

end OriginalCells

section Transfers

variable [HasColimitsOfSize.{w, w} C] {I J : MorphismProperty C}
  {sI : UniformRelativeSourceSmallness.{w} (I.strictMap (RightModuleFree.functor A))}
  {sJ : UniformRelativeSourceSmallness.{w} (J.strictMap (RightModuleFree.functor A))}
  (t : RightTransfer.FullModelTransfer (RightModuleFree.functor A)
    (Mod.forget (D := C) (mop A)) I J sI sJ)

omit [HasColimitsOfSize.{0, 0} C] in
/-- The actual transfer and its retained source rank earn the full forgotten cofibration class. -/
theorem cofibrations_underlying_of_transfer (hI : I.rlp = trivialFibrations C) :
    letI : ModelCategory (RightModuleFree.Carrier A) := t.model
    cofibrations (RightModuleFree.Carrier A) ≤
      (cofibrations C).inverseImage (Mod.forget (D := C) (mop A)) := by
  let : ModelCategory (RightModuleFree.Carrier A) := t.model
  let : Fact t.generationCardinal.cardinal.IsRegular := t.generationCardinal.regular
  let : OrderBot t.generationCardinal.cardinal.ord.ToType := t.generationCardinal.orderBot
  let : (I.strictMap (RightModuleFree.functor A)).IsCardinalForSmallObjectArgument
      t.generationCardinal.cardinal := t.generationCardinal.P_smallObject
  have hCof : cofibrations (RightModuleFree.Carrier A) =
      (I.strictMap (RightModuleFree.functor A)).rlp.llp := by
    rw [← t.generation_I, t.generation.I_rlp, trivialFibrations_llp]
  exact originalRightCofibration_underlying I t.generationCardinal.cardinal hI hCof

omit [HasColimitsOfSize.{0, 0} C] in
/-- The actual created weak class and the earned cofibration image retain all trivial cofibrations. -/
theorem trivialCofibrations_underlying_of_transfer (hI : I.rlp = trivialFibrations C) :
    letI : ModelCategory (RightModuleFree.Carrier A) := t.model
    trivialCofibrations (RightModuleFree.Carrier A) ≤
      (trivialCofibrations C).inverseImage (Mod.forget (D := C) (mop A)) := by
  let : ModelCategory (RightModuleFree.Carrier A) := t.model
  intro N N' f hf
  exact ⟨cofibrations_underlying_of_transfer t hI f hf.1, t.weak_eq.le f hf.2⟩

/-- A cofibrant right module in the original transferred model has cofibrant underlying object. -/
theorem cofibrant_underlying_of_transfer (hI : I.rlp = trivialFibrations C)
    (N : RightModuleFree.Carrier A) :
    letI : ModelCategory (RightModuleFree.Carrier A) := t.model
    IsCofibrant N → IsCofibrant N.X := by
  let : ModelCategory (RightModuleFree.Carrier A) := t.model
  intro hN
  let : IsCofibrant N := hN
  let U := Mod.forget (D := C) (mop A)
  let : PreservesColimitsOfSize.{0, 0} U := RightModuleFree.forgetPreservesColimits.{0} A
  have hi : cofibrations C (U.map (initial.to N)) :=
    cofibrations_underlying_of_transfer t hI _ (mem_cofibrations (initial.to N))
  let : Cofibration (U.map (initial.to N)) := (cofibration_iff _).mpr hi
  exact (isCofibrant_iff_of_isInitial (U.map (initial.to N))
    (initialIsInitial.isInitialObj U)).mpr inferInstance

end Transfers
end HomotopicalAlgebra.ModuleTransfer.RightForgetCofibrations
