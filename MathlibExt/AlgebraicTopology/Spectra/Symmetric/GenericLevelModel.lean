import MathlibExt.AlgebraicTopology.Spectra.Symmetric.GenericLevelGeneratorClasses
import MathlibExt.AlgebraicTopology.Spectra.Sequential.GenericLevelModel

/-!
# Actual genuine symmetric T-spectrum projective level models

The original finite-index Hom coefficients and all generating arrows are
retained. CofT derives the tensor-power and finite-copower bounds, including
degree zero via unitors. Source Hom is required only on the original evaluated
free-cell chains at the same supplied cardinal and ordinal bottom.
-/

set_option autoImplicit false

noncomputable section

universe w uV vV

open CategoryTheory Limits MorphismProperty Opposite MonoidalCategory
open scoped MonoidalClosed

namespace HomotopicalAlgebra.GenericSymmetricLevel

local notation "I" => CategoryTheory.Operad.SmallFinBijGroupoid

variable {V : Type uV} [Category.{vV} V] [MonoidalCategory V] [SymmetricCategory V]
  [MonoidalClosed V] [ModelCategory V] [HasColimitsOfSize.{w, w} V] [LocallySmall.{w} V]
  {κ : Cardinal.{w}} [Fact κ.IsRegular] [OrderBot κ.ord.ToType]

local instance smallColimits : HasColimitsOfSize.{0, 0} V :=
  hasColimitsOfSizeShrink.{0, 0, w, w} V

/-- Every original finite index is evaluated on the actual genuine operator carrier. -/
def levelProperty (T : V) (P : MorphismProperty V) : MorphismProperty (GenericSphereOperatorSpectra T) :=
  EvaluationTransfer.evaluationProperty (fun n : I => genericSphereOperatorEvaluation T n) P

/-- The literal original free images, over every original finite index and base arrow. -/
abbrev generators (T : V) (P : MorphismProperty V) : MorphismProperty (GenericSphereOperatorSpectra T) := by
  letI : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.generators (A := I) P

/-- The precise conventional source-Hom premise on actual evaluated original free-cell chains. -/
abbrev SourceCondition (T : V) (P : MorphismProperty V) :=
  letI : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  EnrichedProjective.MappedSources.SourceCondition (A := I) (κ := κ) P

variable [IsClosedSymmetricMonoidalModelCategory V]
  (T : V) [IsCofibrant T] (d : CofibrantGenerationData V κ)
  (hSourceI : SourceCondition (κ := κ) T d.I) (hSourceJ : SourceCondition (κ := κ) T d.J)

omit [LocallySmall.{w} V] in
/-- Every original finite-index Hom coefficient has the derived trivial-cofibration generator bound. -/
theorem generatorsJ_tensor_trivialCofibration (a b : I) {X Y : V} (f : X ⟶ Y) (hf : d.J f) :
    trivialCofibrations V (f ▷ CategoryTheory.Spectra.Symmetric.OperatorCoend.Hom T a b) :=
  CategoryTheory.Spectra.Symmetric.LevelGenerators.homTensor_trivialCofibration T a b f
    (GenericSequentialLevel.baseJ_trivialCofibration d f hf)

/-- The full genuine symmetric T-level model is constructed on the actual original operator carrier. -/
@[instance_reducible]
def canonicalModelCategory : ModelCategory (GenericSphereOperatorSpectra T) := by
  letI : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.modelCategory d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ

/-- The constructed weak class is exactly every original finite-index level weak equivalence. -/
theorem weakEquivalences_eq :
    letI : ModelCategory (GenericSphereOperatorSpectra T) := canonicalModelCategory T d hSourceI hSourceJ
    weakEquivalences (GenericSphereOperatorSpectra T) = levelProperty T (weakEquivalences V) := by
  let _ : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.weakEquivalences_eq d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ

/-- The constructed cofibration class is generated by every literal original free I image. -/
theorem cofibrations_eq :
    letI : ModelCategory (GenericSphereOperatorSpectra T) := canonicalModelCategory T d hSourceI hSourceJ
    cofibrations (GenericSphereOperatorSpectra T) = (generators T d.I).rlp.llp := by
  let _ : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.cofibrations_eq d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ

/-- The constructed fibration class is exactly every original finite-index level fibration. -/
theorem fibrations_eq :
    letI : ModelCategory (GenericSphereOperatorSpectra T) := canonicalModelCategory T d hSourceI hSourceJ
    fibrations (GenericSphereOperatorSpectra T) = levelProperty T (fibrations V) := by
  let _ : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.fibrations_eq d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ

/-- The constructed trivial-fibration class is exactly every original finite-index level trivial fibration. -/
theorem trivialFibrations_eq :
    letI : ModelCategory (GenericSphereOperatorSpectra T) := canonicalModelCategory T d hSourceI hSourceJ
    trivialFibrations (GenericSphereOperatorSpectra T) = levelProperty T (trivialFibrations V) := by
  let _ : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.trivialFibrations_eq d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ

/-- The constructed trivial-cofibration class is generated by every literal original free J image. -/
theorem trivialCofibrations_eq :
    letI : ModelCategory (GenericSphereOperatorSpectra T) := canonicalModelCategory T d hSourceI hSourceJ
    trivialCofibrations (GenericSphereOperatorSpectra T) = (generators T d.J).rlp.llp := by
  let _ : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.trivialCofibrations_eq d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ

/-- Every actual original genuine free/evaluation adjunction is Quillen for this same model. -/
theorem freeAtEvaluation_isQuillenAdjunction (n : I) :
    letI : ModelCategory (GenericSphereOperatorSpectra T) := canonicalModelCategory T d hSourceI hSourceJ
    (genericSphereOperatorFreeEvaluationAdjunction T n).IsQuillenAdjunction := by
  let _ : EnrichedCategory V I := CategoryTheory.Spectra.Symmetric.OperatorCoend.enrichedCategory T
  exact EnrichedProjective.MappedSources.freeAtEvaluation_isQuillenAdjunction d
    (generatorsJ_tensor_trivialCofibration T d) hSourceI hSourceJ n

end HomotopicalAlgebra.GenericSymmetricLevel
