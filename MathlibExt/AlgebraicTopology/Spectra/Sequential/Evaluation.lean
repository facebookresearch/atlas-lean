/-- At or above the generating level, a free spectrum has one surviving
tensor-power summand. -/
noncomputable def freeAtLevelIsoOfLe
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) {m n : ℕ} (h : n ≤ m) (A : C) :
    ((freeAt K n).obj A).level m ≅
      TensorPower.tensorPowObj K (m - n) ⊗ A :=
  freeAtLevelDecompositionIso K n m A ≪≫
    freeAtLevelCoproductIsoOfLe K h A ≪≫
    freeAtLevelSurvivorIso K h A

/-- The at-or-above-level comparison for a free spectrum is natural in its
generating object. -/
theorem freeAtLevelIsoOfLe_hom_naturality
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) {m n : ℕ} (h : n ≤ m) {B D : C} (f : B ⟶ D) :
    ((freeAt K n).map f).levelMap m ≫
        (freeAtLevelIsoOfLe K h D).hom =
      (freeAtLevelIsoOfLe K h B).hom ≫
        (𝟙 (TensorPower.tensorPowObj K (m - n)) ⊗ₘ f) := by
  apply (cancel_epi (freeAtLevelIsoOfLe K h B).inv).1
  simp only [Iso.inv_hom_id_assoc]
  simp only [freeAtLevelIsoOfLe, freeAtLevelDecompositionIso,
    Iso.trans_inv, Iso.trans_hom]
  simp only [Category.assoc]
  rw [freeAtLevelCarrierIso_hom_naturality_assoc]
  simp only [Iso.inv_hom_id_assoc]
  rw [freeAtLevelCoproductIsoOfLe_inv]
  simp only [freeAtLevelScalarIso]
  rw [Sigma.ι_mapIso_inv_assoc]
  rw [tensorObjIso_whiskerLeft_ι_assoc]
  rw [Sigma.ι_mapIso_hom_assoc]
  rw [← freeAtLevelCoproductIsoOfLe_inv]
  simp only [Iso.inv_hom_id_assoc]
  have hActual := freeAtLevelActualSurvivorIso_hom_naturality K h f
  simp only [freeAtLevelActualSurvivorIso, Iso.trans_hom] at hActual
  rw [hActual]
  simp only [Category.assoc]
  rw [Iso.inv_hom_id_assoc, Iso.inv_hom_id_assoc]

