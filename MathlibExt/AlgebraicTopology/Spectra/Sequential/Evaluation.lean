  simp only [tensorIso_hom]
  rw [MonoidalCategory.tensorHom_comp_tensorHom,
    MonoidalCategory.tensorHom_comp_tensorHom]
  simp only [Category.id_comp, Category.comp_id]
  rw [freeAtLevelOrdinarySurvivorIso_hom_naturality]

private noncomputable def freeAtLevelActualSurvivorIso
    (K : C) {m n : ℕ} (h : n ≤ m) (A : C) :
    (Sequence.tensorPowerSequence K).functor.obj
          (Sequence.index (freeAtLevelSurvivorIndex h : ℕ)) ⊗
        ((Sequence.freeAt C n).obj A).functor.obj
          (Sequence.index (m - (freeAtLevelSurvivorIndex h : ℕ))) ≅
      TensorPower.tensorPowObj K (m - n) ⊗ A :=
  freeAtLevelScalarComponentIso K n m A
      (freeAtLevelSurvivorIndex h) ≪≫
    freeAtLevelSurvivorIso K h A

