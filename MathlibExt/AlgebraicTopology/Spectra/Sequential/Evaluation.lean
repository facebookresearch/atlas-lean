@[reassoc]
private theorem ordinaryFreeLevelIso_hom_naturality
    (n : ℕ) {B D : C} (f : B ⟶ D) :
    ((Sequence.freeAt C n).map f).natTrans.app (Sequence.index n) ≫
        (ordinaryFreeLevelIso n D).hom =
      (ordinaryFreeLevelIso n B).hom ≫ f := by
  let _ : Unique (Sequence.index n ⟶ Sequence.index n) :=
    { default := 𝟙 _
      uniq := fun _ => Subsingleton.elim _ _ }
  change (Sigma.desc (fun h : Sequence.index n ⟶ Sequence.index n =>
    f ≫ Sigma.ι (fun _ : Sequence.index n ⟶ Sequence.index n => D) h)) ≫
      (ordinaryFreeLevelIso n D).hom =
    (ordinaryFreeLevelIso n B).hom ≫ f
  apply Sigma.hom_ext
  intro g
  dsimp only [ordinaryFreeLevelIso, id]
  change (Sigma.ι (fun _ : Sequence.index n ⟶ Sequence.index n => B) g ≫
      Sigma.desc (fun h : Sequence.index n ⟶ Sequence.index n =>
        f ≫ Sigma.ι (fun _ : Sequence.index n ⟶ Sequence.index n => D) h) ≫
      (coproductUniqueIso
        (fun _ : Sequence.index n ⟶ Sequence.index n => D)).hom) =
    (Sigma.ι (fun _ : Sequence.index n ⟶ Sequence.index n => B) g ≫
      (coproductUniqueIso
        (fun _ : Sequence.index n ⟶ Sequence.index n => B)).hom ≫ f)
  rw [← Category.assoc, Sigma.ι_comp_desc, Category.assoc,
    ι_coproductUniqueIso_hom, ← Category.assoc,
    ι_coproductUniqueIso_hom]
  simp

/-- An ordinary free sequence has an initial object in every other level. -/
noncomputable def ordinaryFreeLevelIsInitial
    (n r : ℕ) (h : r ≠ n) (A : C) :
    IsInitial (((Sequence.freeAt C n).obj A).functor.obj
      (Sequence.index r)) := by
  letI : IsEmpty (Sequence.index n ⟶ Sequence.index r) :=
    ⟨fun f => h (by
      simpa [Sequence.index] using (congrArg
        (fun x : Multiplicative ℕ => x.toAdd) (Discrete.eq_of_hom f)).symm)⟩
  change IsInitial (∐ fun _ : Sequence.index n ⟶ Sequence.index r => A)
  let F := Discrete.functor
    (fun _ : Sequence.index n ⟶ Sequence.index r => A)
  exact isColimitEquivIsInitialOfIsEmpty C (Sigma.cocone F)
    (coproductIsCoproduct' F)

/-- A free spectrum generated in level `n` is initial in every lower level. -/
noncomputable def freeAtLevelIsoOfLt
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [HasInitial C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) {m n : ℕ} (h : m < n) (A : C) :
    ((freeAt K n).obj A).level m ≅ ⊥_ C := by
  let F : Fin (m + 1) → C := fun p =>
    TensorPower.tensorPowObj K (p : ℕ) ⊗
      ((Sequence.freeAt C n).obj A).functor.obj
        (Sequence.index (m - (p : ℕ)))
  have hF (p : Fin (m + 1)) : IsInitial (F p) := by
    let hFree := ordinaryFreeLevelIsInitial n (m - (p : ℕ)) (by omega) A
    exact hFree.isInitialObj
      (tensorLeft (TensorPower.tensorPowObj K (p : ℕ))) _
  let hCop : IsInitial (∐ F) := Limits.coproductIsInitialOfEach F hF
  exact freeAtLevelDecompositionIso K n m A ≪≫
    hCop.uniqueUpToIso initialIsInitial

/-- The lower-level comparison for a free spectrum is natural in its
generating object. -/
theorem freeAtLevelIsoOfLt_hom_naturality
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [HasInitial C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) {m n : ℕ} (h : m < n) {B D : C} (f : B ⟶ D) :
    ((freeAt K n).map f).levelMap m ≫
        (freeAtLevelIsoOfLt K h D).hom =
      (freeAtLevelIsoOfLt K h B).hom := by
  apply (initialIsInitial.ofIso
    (freeAtLevelIsoOfLt K h B).symm).hom_ext

/-- The surviving finite-sum index at or above the generating level. -/
def freeAtLevelSurvivorIndex {m n : ℕ} (h : n ≤ m) : Fin (m + 1) :=
  ⟨m - n, by omega⟩

/-- The surviving finite index has the literal expected value `m - n`. -/
theorem freeAtLevelSurvivorIndex_val {m n : ℕ} (h : n ≤ m) :
    (freeAtLevelSurvivorIndex h : ℕ) = m - n :=
  rfl

/-- The free-level coproduct identifies with its unique surviving summand. -/
noncomputable def freeAtLevelCoproductIsoOfLe
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) {m n : ℕ} (h : n ≤ m) (A : C) :
    (∐ freeAtLevelSummand K n m A) ≅
      freeAtLevelSummand K n m A (freeAtLevelSurvivorIndex h) := by
  let p₀ := freeAtLevelSurvivorIndex h
  have hF (p : Fin (m + 1)) (hp : p ≠ p₀) :
      IsInitial (freeAtLevelSummand K n m A p) := by
    have hDegree : m - (p : ℕ) ≠ n := by
      intro heq
      apply hp
      apply Fin.ext
      dsimp only [p₀, freeAtLevelSurvivorIndex]
      omega
    let hFree := ordinaryFreeLevelIsInitial n (m - (p : ℕ)) hDegree A
    exact hFree.isInitialObj
      (tensorLeft (TensorPower.tensorPowObj K (p : ℕ))) _
  exact Limits.coproductIsoOfInitialExcept _ p₀ hF

