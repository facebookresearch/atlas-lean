      (tensorRight W)] in
@[reassoc]
private theorem freeAtLevelOrdinarySurvivorIso_hom_naturality
    {m n : ℕ} (h : n ≤ m) {B D : C} (f : B ⟶ D) :
    ((Sequence.freeAt C n).map f).natTrans.app
          (Sequence.index (m - (freeAtLevelSurvivorIndex h : ℕ))) ≫
        (freeAtLevelOrdinarySurvivorIso h D).hom =
      (freeAtLevelOrdinarySurvivorIso h B).hom ≫ f := by
  have hDegree : m - (freeAtLevelSurvivorIndex h : ℕ) = n := by
    dsimp only [freeAtLevelSurvivorIndex]
    exact Nat.sub_sub_self h
  let hIndex := congrArg Sequence.index hDegree
  simp only [freeAtLevelOrdinarySurvivorIso, Iso.trans_hom, eqToIso.hom]
  change ((Sequence.freeAt C n).map f).natTrans.app _ ≫
      eqToHom (congrArg
        ((Sequence.freeAt C n).obj D).functor.obj hIndex) ≫
        (ordinaryFreeLevelIso n D).hom =
    (eqToHom (congrArg
          ((Sequence.freeAt C n).obj B).functor.obj hIndex) ≫
        (ordinaryFreeLevelIso n B).hom) ≫ f
  rw [← eqToHom_map, ← eqToHom_map]
  · rw [← ((Sequence.freeAt C n).map f).natTrans.naturality_assoc]
    slice_lhs 2 3 => rw [ordinaryFreeLevelIso_hom_naturality]
    simp only [Category.assoc]
  · exact hIndex
  · exact hIndex

/-- The surviving summand identifies with the actual suspension tensor power and generator. -/
noncomputable def freeAtLevelSurvivorIso
    (K : C) {m n : ℕ} (h : n ≤ m) (A : C) :
    freeAtLevelSummand K n m A (freeAtLevelSurvivorIndex h) ≅
      TensorPower.tensorPowObj K (m - n) ⊗ A := by
  change (TensorPower.tensorPowObj K
        (freeAtLevelSurvivorIndex h : ℕ) ⊗
      ((Sequence.freeAt C n).obj A).functor.obj
        (Sequence.index
          (m - (freeAtLevelSurvivorIndex h : ℕ)))) ≅
    TensorPower.tensorPowObj K (m - n) ⊗ A
  exact tensorIso
    (eqToIso (congrArg (TensorPower.tensorPowObj K)
      (freeAtLevelSurvivorIndex_val h)))
    (freeAtLevelOrdinarySurvivorIso h A)

