/-- The ordinary free-sequence factor of the surviving summand recovers the generator. -/
noncomputable def freeAtLevelOrdinarySurvivorIso
    {m n : ℕ} (h : n ≤ m) (A : C) :
    ((Sequence.freeAt C n).obj A).functor.obj
        (Sequence.index (m - (freeAtLevelSurvivorIndex h : ℕ))) ≅ A := by
  have hDegree : m - (freeAtLevelSurvivorIndex h : ℕ) = n := by
    dsimp only [freeAtLevelSurvivorIndex]
    exact Nat.sub_sub_self h
  exact eqToIso (congrArg (fun r =>
    ((Sequence.freeAt C n).obj A).functor.obj (Sequence.index r))
    hDegree) ≪≫ ordinaryFreeLevelIso n A

