    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) {m n : ℕ} (h : n ≤ m) (A : C) :
