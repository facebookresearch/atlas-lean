@[reassoc]
private theorem freeAtLevelSurvivorIso_hom_naturality
    (K : C) {m n : ℕ} (h : n ≤ m) {B D : C} (f : B ⟶ D) :
    freeAtLevelSummandMap K n m (freeAtLevelSurvivorIndex h) f ≫
        (freeAtLevelSurvivorIso K h D).hom =
      (freeAtLevelSurvivorIso K h B).hom ≫
        (𝟙 (TensorPower.tensorPowObj K (m - n)) ⊗ₘ f) := by
  dsimp only [freeAtLevelSummandMap, freeAtLevelSurvivorIso,
