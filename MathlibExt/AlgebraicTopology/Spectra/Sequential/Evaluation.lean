@[reassoc]
private theorem freeAtLevelScalarComponentIso_hom_naturality
    (K : C) (n m : ℕ) (p : Fin (m + 1)) {B D : C} (f : B ⟶ D) :
    (𝟙 ((Sequence.tensorPowerSequence K).functor.obj
          (Sequence.index (p : ℕ))) ⊗ₘ
        ((Sequence.freeAt C n).map f).natTrans.app
          (Sequence.index (m - (p : ℕ)))) ≫
        (freeAtLevelScalarComponentIso K n m D p).hom =
      (freeAtLevelScalarComponentIso K n m B p).hom ≫
        freeAtLevelSummandMap K n m p f := by
  dsimp only [freeAtLevelScalarComponentIso, freeAtLevelSummandMap,
    freeAtLevelSummand, id]
  simp only [tensorIso_hom, Iso.refl_hom]
  rw [MonoidalCategory.tensorHom_comp_tensorHom,
    MonoidalCategory.tensorHom_comp_tensorHom]
  simp

/-- The finite scalar-component coproduct identifies with the tensor-power summand coproduct. -/
noncomputable def freeAtLevelScalarIso
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    (K : C) (n m : ℕ) (A : C) :
    (∐ fun p : Fin (m + 1) =>
      (Sequence.tensorPowerSequence K).functor.obj
          (Sequence.index (p : ℕ)) ⊗
        ((Sequence.freeAt C n).obj A).functor.obj
          (Sequence.index (m - (p : ℕ)))) ≅
      ∐ freeAtLevelSummand K n m A :=
  Sigma.mapIso (freeAtLevelScalarComponentIso K n m A)

/-- The complete finite coproduct decomposition of a free spectrum level. -/
noncomputable def freeAtLevelDecompositionIso
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    (K : C) (n m : ℕ) (A : C) :
    ((freeAt K n).obj A).level m ≅
      ∐ freeAtLevelSummand K n m A :=
  freeAtLevelCarrierIso K n m A ≪≫
    Sequence.tensorObjIso (Sequence.tensorPowerSequence K)
      ((Sequence.freeAt C n).obj A) m ≪≫
    freeAtLevelScalarIso K n m A

/-- The ordinary free sequence recovers its generating object in its generating level. -/
noncomputable def ordinaryFreeLevelIso
    (n : ℕ) (A : C) :
    ((Sequence.freeAt C n).obj A).functor.obj (Sequence.index n) ≅ A := by
  change (∐ fun _ : Sequence.index n ⟶ Sequence.index n => A) ≅ A
  letI : Unique (Sequence.index n ⟶ Sequence.index n) :=
    { default := 𝟙 _
      uniq := fun _ => Subsingleton.elim _ _ }
  exact coproductUniqueIso _

