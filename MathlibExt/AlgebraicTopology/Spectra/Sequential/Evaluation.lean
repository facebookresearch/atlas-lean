attribute [local instance] Sequence.tensorPowerSequenceMonObj

/-- The free sequential spectrum generated by an object in level `n`. -/
noncomputable def freeAt (K : C) (n : ℕ) :
    C ⥤ SequentialSpectrum C K :=
  (@Mod.dayFreeAt _ _ _ _ _ _ _
      (Sequence.tensorPowerSequence K)
      (Sequence.tensorPowerSequenceMonObj K)
      _
      (Sequence.index n)) ⋙
    (moduleEquivalence K).inverse

omit [∀ i j : Sequence.Index, HasCoproductsOfShape (i ⟶ j) C] in
/-- The level map recovered by the inverse module equivalence is the
corresponding component of the underlying module morphism. -/
@[simp]
theorem moduleEquivalence_inverse_map_levelMap
    (K : C) {M N : Sequence.TensorPowerModule K} (g : M ⟶ N) (m : ℕ) :
    ((moduleEquivalence K).inverse.map g).levelMap m =
      g.hom.natTrans.app (Sequence.index m) :=
  rfl

/-- The module-presentation comparison intertwines ordinary level evaluation. -/
noncomputable def moduleEvaluationIso (K : C) (n : ℕ) :
    (moduleEquivalence K).functor ⋙
        Mod.dayEvaluation (Sequence.tensorPowerSequence K)
          (Sequence.index n) ≅
      evaluation K n :=
  NatIso.ofComponents (fun X => by
    change X.level n ≅ X.level n
    exact Iso.refl _)
    (fun {X Y} f => by
      change f.levelMap n ≫ 𝟙 _ = 𝟙 _ ≫ f.levelMap n
      simp)

/-- Free generation in level `n` is left adjoint to evaluation in level `n`. -/
noncomputable def freeAtEvaluationAdjunction (K : C) (n : ℕ) :
    freeAt K n ⊣ evaluation K n := by
  let base :=
    (@Mod.dayFreeAtEvaluationAdjunction _ _ _ _ _ _ _
      (Sequence.tensorPowerSequence K)
      (Sequence.tensorPowerSequenceMonObj K)
      _
      (Sequence.index n)).comp
        (moduleEquivalence K).symm.toAdjunction
  exact base.ofNatIsoRight (moduleEvaluationIso K n)

/-- The free sequential spectrum generated in level zero. -/
abbrev suspensionSpectrum (K : C) := freeAt K 0

/-- Evaluation of a sequential spectrum in level zero. -/
abbrev infiniteLoops (K : C) := evaluation K 0

/-- Free generation in level zero is left adjoint to level-zero evaluation. -/
noncomputable def suspensionInfiniteLoopsAdjunction (K : C) :
    suspensionSpectrum K ⊣ infiniteLoops K :=
  freeAtEvaluationAdjunction K 0

/-- The sequential sphere spectrum with suspension coordinate `K`. -/
noncomputable def sphereSpectrum (K : C) : SequentialSpectrum C K :=
  (suspensionSpectrum K).obj (𝟙_ C)

/-- The free-spectrum level carrier is the corresponding Day-tensor component. -/
noncomputable def freeAtLevelCarrierIso
    (K : C) (n m : ℕ) (A : C) :
    ((freeAt K n).obj A).level m ≅
      (Sequence.tensorPowerSequence K ⊗
        (Sequence.freeAt C n).obj A).functor.obj (Sequence.index m) := by
  let M := (@Mod.dayFreeAt _ _ _ _ _ _ _
      (Sequence.tensorPowerSequence K)
      (Sequence.tensorPowerSequenceMonObj K)
      _
      (Sequence.index n)).obj A
  let F := (Sequence.freeAt C n).obj A
  have hCarrier : M.X =
      Sequence.tensorPowerSequence K ⊗ F := by
    change ((Mod.free (Sequence.tensorPowerSequence K)).obj F).X =
      Sequence.tensorPowerSequence K ⊗ F
    exact Mod.free_obj (Sequence.tensorPowerSequence K) F
  change M.X.functor.obj (Sequence.index m) ≅
      (Sequence.tensorPowerSequence K ⊗ F).functor.obj (Sequence.index m)
  let e : M.X ≅ Sequence.tensorPowerSequence K ⊗ F := eqToIso hCarrier
  exact
    { hom := e.hom.natTrans.app (Sequence.index m)
      inv := e.inv.natTrans.app (Sequence.index m)
      hom_inv_id := by
        exact congrArg (fun k ↦ k.natTrans.app (Sequence.index m))
          e.hom_inv_id
      inv_hom_id := by
        exact congrArg (fun k ↦ k.natTrans.app (Sequence.index m))
          e.inv_hom_id }

private theorem freeAtLevelCarrierIso_hom
    (K : C) (n m : ℕ) (A : C) :
    (freeAtLevelCarrierIso K n m A).hom =
      (eqToHom (Mod.free_obj (Sequence.tensorPowerSequence K)
        ((Sequence.freeAt C n).obj A))).natTrans.app (Sequence.index m) := by
  rfl

@[reassoc]
private theorem freeAtLevelCarrierIso_hom_naturality
    (K : C) (n m : ℕ) {B D : C} (f : B ⟶ D) :
    ((freeAt K n).map f).levelMap m ≫
        (freeAtLevelCarrierIso K n m D).hom =
      (freeAtLevelCarrierIso K n m B).hom ≫
        (Sequence.tensorPowerSequence K ◁
          (Sequence.freeAt C n).map f).natTrans.app (Sequence.index m) := by
  have h := CategoryTheory.Mod.free_map (Sequence.tensorPowerSequence K)
    ((Sequence.freeAt C n).map f)
  have h' := congrArg (fun k ↦ k.natTrans.app (Sequence.index m)) h
  rw [freeAtLevelCarrierIso_hom, freeAtLevelCarrierIso_hom]
  change (((moduleEquivalence K).inverse.map
    ((Mod.dayFreeAt (Sequence.tensorPowerSequence K)
      (Sequence.index n)).map f)).levelMap m) ≫ _ = _
  rw [moduleEquivalence_inverse_map_levelMap]
  simpa [freeAt, Mod.dayFreeAt, Sequence.freeAt] using h'.symm

/-- The tensor-power summand in the finite decomposition of a free spectrum level. -/
noncomputable def freeAtLevelSummand
    (K : C) (n m : ℕ) (A : C) (p : Fin (m + 1)) : C :=
  TensorPower.tensorPowObj K (p : ℕ) ⊗
    ((Sequence.freeAt C n).obj A).functor.obj
      (Sequence.index (m - (p : ℕ)))

private def freeAtLevelSummandMap
    (K : C) (n m : ℕ) (p : Fin (m + 1)) {B D : C} (f : B ⟶ D) :
    freeAtLevelSummand K n m B p ⟶
      freeAtLevelSummand K n m D p := by
  dsimp only [freeAtLevelSummand]
  exact 𝟙 (TensorPower.tensorPowObj K (p : ℕ)) ⊗ₘ
    ((Sequence.freeAt C n).map f).natTrans.app
      (Sequence.index (m - (p : ℕ)))

omit [∀ i j : Sequence.Index, HasCoproductsOfShape (i ⟶ j) C] in
@[reassoc]
private theorem tensorObjIso_ι_inv
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    (X Y : Sequence C) (m : ℕ) (p : Fin (m + 1)) :
    Sigma.ι (fun q : Fin (m + 1) =>
        X.functor.obj (Sequence.index (q : ℕ)) ⊗
          Y.functor.obj (Sequence.index (m - (q : ℕ)))) p ≫
        (Sequence.tensorObjIso X Y m).inv =
      (DayFunctor.η X Y).app
          (Sequence.index (p : ℕ),
            Sequence.index (m - (p : ℕ))) ≫
        (X ⊗ Y).functor.map
          (eqToHom
            ((Sequence.tensorObj_index (p : ℕ) (m - (p : ℕ))).trans
              (congrArg Sequence.index
                (Nat.add_sub_of_le (Nat.le_of_lt_succ p.isLt))))) := by
  apply (cancel_mono (Sequence.tensorObjIso X Y m).hom).1
  rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  simpa only [Category.assoc] using
    (Sequence.tensorObjIso_η X Y m p).symm

omit [∀ i j : Sequence.Index, HasCoproductsOfShape (i ⟶ j) C] in
@[reassoc]
private theorem tensorObjIso_whiskerLeft_ι
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    (X Y Z : Sequence C) (q : Y ⟶ Z) (m : ℕ) (p : Fin (m + 1)) :
    Sigma.ι (fun a : Fin (m + 1) =>
        X.functor.obj (Sequence.index (a : ℕ)) ⊗
          Y.functor.obj (Sequence.index (m - (a : ℕ)))) p ≫
        (Sequence.tensorObjIso X Y m).inv ≫
      (X ◁ q).natTrans.app (Sequence.index m) ≫
        (Sequence.tensorObjIso X Z m).hom =
      (𝟙 (X.functor.obj (Sequence.index (p : ℕ))) ⊗ₘ
          q.natTrans.app (Sequence.index (m - (p : ℕ)))) ≫
        Sigma.ι (fun a : Fin (m + 1) =>
          X.functor.obj (Sequence.index (a : ℕ)) ⊗
            Z.functor.obj (Sequence.index (m - (a : ℕ)))) p := by
  rw [tensorObjIso_ι_inv_assoc]
  rw [(X ◁ q).natTrans.naturality_assoc]
  have hWhisker :=
    LawfulDayConvolutionMonoidalCategoryStruct.convolutionExtensionUnit_comp_ι_map_whiskerLeft_app
      C X q (Sequence.index (p : ℕ))
        (Sequence.index (m - (p : ℕ)))
  have hη :
        (DayFunctor.η X Y).app
          (Sequence.index (p : ℕ),
            Sequence.index (m - (p : ℕ))) ≫
        (X ◁ q).natTrans.app
          ((tensor Sequence.Index).obj
            (Sequence.index (p : ℕ),
              Sequence.index (m - (p : ℕ)))) =
      (X.functor.obj (Sequence.index (p : ℕ)) ◁
          q.natTrans.app (Sequence.index (m - (p : ℕ)))) ≫
        (DayFunctor.η X Z).app
          (Sequence.index (p : ℕ),
            Sequence.index (m - (p : ℕ))) := by
    convert hWhisker using 1 <;> rfl
  slice_lhs 1 2 => rw [hη]
  slice_lhs 2 4 => rw [Sequence.tensorObjIso_η]
  simp only [MonoidalCategory.id_tensorHom]

/-- The actual scalar-sequence component identifies with its tensor-power summand. -/
noncomputable def freeAtLevelScalarComponentIso
    (K : C) (n m : ℕ) (A : C) (p : Fin (m + 1)) :
    (Sequence.tensorPowerSequence K).functor.obj
          (Sequence.index (p : ℕ)) ⊗
        ((Sequence.freeAt C n).obj A).functor.obj
          (Sequence.index (m - (p : ℕ))) ≅
      freeAtLevelSummand K n m A p := by
  dsimp only [freeAtLevelSummand]
  exact tensorIso
    (eqToIso (Sequence.tensorPowerSequence_obj K (p : ℕ)))
    (Iso.refl _)

