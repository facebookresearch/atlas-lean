private theorem tensorPow_eqToIso_tensor_hom
    (K B : C) {a b : ℕ} (h : a = b) :
    (eqToIso (congrArg
      (fun r ↦ TensorPower.tensorPowObj K r ⊗ B) h)).hom =
      (eqToIso (congrArg (TensorPower.tensorPowObj K) h)).hom ⊗ₘ 𝟙 B := by
  subst b
  simp

/-- A free spectrum in its generating level is canonically isomorphic to its
generating object. -/
noncomputable def freeAtLevelSelfIso
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) (n : ℕ) (B : C) :
    ((freeAt K n).obj B).level n ≅ B :=
  freeAtLevelIsoOfLe K (le_refl n) B ≪≫
    eqToIso (congrArg
      (fun r ↦ TensorPower.tensorPowObj K r ⊗ B) (Nat.sub_self n)) ≪≫
    tensorIso (eqToIso (TensorPower.tensorPowObj_zero K)) (Iso.refl B) ≪≫
    λ_ B

/-- The self-level comparison for a free spectrum is natural in its
generating object. -/
theorem freeAtLevelSelfIso_hom_naturality
    [∀ r : ℕ, HasCoproductsOfShape (Fin (r + 1)) C]
    [∀ X : C, PreservesColimit (Functor.empty.{0} C) (tensorLeft X)]
    (K : C) (n : ℕ) {B D : C} (f : B ⟶ D) :
    ((freeAt K n).map f).levelMap n ≫
        (freeAtLevelSelfIso K n D).hom =
      (freeAtLevelSelfIso K n B).hom ≫ f := by
  simp only [freeAtLevelSelfIso, Iso.trans_hom, Category.assoc]
  slice_lhs 1 2 => rw [freeAtLevelIsoOfLe_hom_naturality]
  simp only [Category.assoc]
  apply (cancel_epi (freeAtLevelIsoOfLe K (le_refl n) B).hom).2
  simp only [tensorIso_hom]
  rw [tensorPow_eqToIso_tensor_hom K D,
    tensorPow_eqToIso_tensor_hom K B]
  · simp only [Iso.refl_hom]
    slice_lhs 1 2 => rw [MonoidalCategory.tensorHom_comp_tensorHom]
    slice_lhs 1 2 => rw [MonoidalCategory.tensorHom_comp_tensorHom]
    slice_rhs 1 2 => rw [MonoidalCategory.tensorHom_comp_tensorHom]
    simp only [Category.id_comp, Category.comp_id]
    rw [MonoidalCategory.tensorHom_def]
    simp only [tensorHom_id]
    simp only [Category.assoc]
    rw [MonoidalCategory.leftUnitor_naturality]
  · exact Nat.sub_self n
  · exact Nat.sub_self n

