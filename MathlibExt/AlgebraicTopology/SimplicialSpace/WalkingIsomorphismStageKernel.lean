module

public import MathlibExt.AlgebraicTopology.SimplicialSpace.WalkingIsomorphismStages
public import Mathlib.AlgebraicTopology.SimplicialSet.Horn

/-!
# The original horn preimage of an alternating-stage simplex

For Rezk §11.7, equation (11.8), the original alternating map has old-stage
preimage exactly `Λ[k,0]`. Its complement has unique original ordinal
representatives. The attachment, all operator equations and its full kernel
are constructed here for every `k ≥ 2` and every original degree.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section
universe u

open CategoryTheory CategoryTheory.Limits Opposite
open scoped Simplicial

namespace SSet.coherentIso

/-- The original simplex map for the word zero, one, zero, ... . -/
def alternatingMap (k : ℕ) : (Δ[k] : SSet.{u}) ⟶ coherentIso :=
  yonedaEquiv.symm (alternatingSimplex k)

/-- Its native factor through the subcomplex generated by that same simplex. -/
def stageSimplexMap (k : ℕ) : (Δ[k] : SSet.{u}) ⟶ (stage k : SSet.{u}) :=
  Subcomplex.toOfSimplex (alternatingSimplex k)

@[reassoc (attr := simp)]
theorem stageSimplexMap_ι (k : ℕ) :
    stageSimplexMap.{u} k ≫ (stage k).ι = alternatingMap k := rfl

/-- Every original vertex retains the parity of its ordinal coordinate. -/
@[simp]
theorem alternatingMap_app_vertexBool {k n : ℕ} (a : (Δ[k] : SSet.{u}) _⦋n⦌)
    (i : Fin (n + 1)) :
    vertexBool ((alternatingMap.{u} k).app (op ⦋n⦌) a) i =
      ((a i).val % 2 == 1) := rfl

/-- Restriction of the full original map by every simplex operator. -/
theorem alternatingMap_naturality (k : ℕ) {d e : SimplexCategoryᵒᵖ} (f : d ⟶ e)
    (a : (Δ[k] : SSet.{u}).obj d) :
    coherentIso.map f ((alternatingMap k).app d a) =
      (alternatingMap k).app e ((Δ[k] : SSet.{u}).map f a) :=
  (congrArg (fun g : (Δ[k] : SSet.{u}).obj d ⟶ coherentIso.obj e => g a)
    ((alternatingMap.{u} k).naturality f)).symm

/-- The generated-stage factor is a whole original simplicial map. -/
theorem stageSimplexMap_naturality (k : ℕ) {d e : SimplexCategoryᵒᵖ} (f : d ⟶ e)
    (a : (Δ[k] : SSet.{u}).obj d) :
    (stage k : SSet.{u}).map f ((stageSimplexMap k).app d a) =
      (stageSimplexMap k).app e ((Δ[k] : SSet.{u}).map f a) :=
  (congrArg (fun g : (Δ[k] : SSet.{u}).obj d ⟶ (stage k : SSet.{u}).obj e => g a)
    ((stageSimplexMap.{u} k).naturality f)).symm

/-- The whole original last-face map is the preceding alternating simplex map. -/
theorem alternatingMap_last_face (n : ℕ) :
    stdSimplex.δ (Fin.last (n + 1)) ≫ alternatingMap.{u} (n + 1) = alternatingMap n := by
  apply yonedaEquiv.injective
  change coherentIso.map (SimplexCategory.δ (Fin.last (n + 1))).op
    (alternatingSimplex.{u} (n + 1)) = alternatingSimplex n
  exact last_face_alternatingSimplex n

private theorem parity_eq {a b : ℕ} (h : (a % 2 == 1) = (b % 2 == 1)) :
    a % 2 = b % 2 := by
  have ha := Nat.mod_lt a (by omega : 0 < 2)
  have hb := Nat.mod_lt b (by omega : 0 < 2)
  by_cases hA : a % 2 = 1
  · have hB : b % 2 = 1 := by simpa [hA] using h.symm
    omega
  · have hB : b % 2 ≠ 1 := by
      intro hB
      simp [hA, hB] at h
    omega

private theorem outside_range {k n : ℕ} (a : (Δ[k] : SSet.{u}) _⦋n⦌)
    (ha : a ∉ (horn k (0 : Fin (k + 1))).obj (op ⦋n⦌)) :
    ∀ j : Fin (k + 1), j ≠ 0 → j ∈ Set.range (stdSimplex.asOrderHom a) := by
  intro j hj
  by_contra h
  exact ha ((mem_horn_iff_notMem_range a 0).mpr ⟨j, hj, h⟩)

private theorem covered_first {k n : ℕ} (hk : 2 ≤ k)
    (α : Fin (n + 1) →o Fin (k + 1))
    (hα : ∀ j : Fin (k + 1), j ≠ 0 → j ∈ Set.range α) :
    (α 0).val ≤ 1 := by
  let v : Fin (k + 1) := ⟨1, by omega⟩
  have hv : v ≠ 0 := by
    intro h
    have := congrArg Fin.val h
    change 1 = 0 at this
    omega
  obtain ⟨i, hi⟩ := hα v hv
  have hm := α.monotone (Fin.zero_le i)
  change (α 0).val ≤ (α i).val at hm
  rw [hi] at hm
  exact hm

private theorem covered_last {k n : ℕ} (hk : 2 ≤ k)
    (α : Fin (n + 1) →o Fin (k + 1))
    (hα : ∀ j : Fin (k + 1), j ≠ 0 → j ∈ Set.range α) :
    (α (Fin.last n)).val = k := by
  have hv : (Fin.last k : Fin (k + 1)) ≠ 0 := by
    intro h
    have := congrArg Fin.val h
    change k = 0 at this
    omega
  obtain ⟨i, hi⟩ := hα (Fin.last k) hv
  have hm := α.monotone (Fin.le_last i)
  change (α i).val ≤ (α (Fin.last n)).val at hm
  rw [hi] at hm
  have hb := (α (Fin.last n)).isLt
  change k ≤ (α (Fin.last n)).val at hm
  omega

private theorem covered_step {k n : ℕ}
    (α : Fin (n + 1) →o Fin (k + 1))
    (hα : ∀ j : Fin (k + 1), j ≠ 0 → j ∈ Set.range α) (i : Fin n) :
    (α i.succ).val ≤ (α i.castSucc).val + 1 := by
  by_contra h
  have hgap : (α i.castSucc).val + 1 < (α i.succ).val := by omega
  let v : Fin (k + 1) := ⟨(α i.castSucc).val + 1, lt_trans hgap (α i.succ).isLt⟩
  have hv : v ≠ 0 := by
    intro hzero
    have := congrArg Fin.val hzero
    change (α i.castSucc).val + 1 = 0 at this
    omega
  obtain ⟨j, hj⟩ := hα v hv
  by_cases hji : j ≤ i.castSucc
  · have hm := α.monotone hji
    change (α j).val ≤ (α i.castSucc).val at hm
    rw [hj] at hm
    change (α i.castSucc).val + 1 ≤ (α i.castSucc).val at hm
    omega
  · have hij : i.succ ≤ j := by
      have hv' : i.val < j.val := lt_of_not_ge hji
      change i.val + 1 ≤ j.val
      omega
    have hm := α.monotone hij
    change (α i.succ).val ≤ (α j).val at hm
    rw [hj] at hm
    change (α i.succ).val ≤ (α i.castSucc).val + 1 at hm
    omega

private theorem parity_domination {k n : ℕ} (hk : 2 ≤ k)
    (α : Fin (n + 1) →o Fin (k + 1))
    (hα : ∀ j : Fin (k + 1), j ≠ 0 → j ∈ Set.range α)
    (β : Fin (n + 1) →o ℕ)
    (hpar : ∀ i, (α i).val % 2 = β i % 2) :
    ∀ i, (α i).val ≤ β i := by
  intro i
  induction i using Fin.induction with
  | zero =>
      have hfirst := covered_first hk α hα
      have hp := hpar 0
      omega
  | succ i ih =>
      have hs := covered_step α hα i
      have hb := β.monotone (Fin.castSucc_le_succ i)
      have hp := hpar i.castSucc
      have hp' := hpar i.succ
      omega

private def natWord {n k : ℕ} (α : Fin (n + 1) →o Fin (k + 1)) :
    Fin (n + 1) →o ℕ where
  toFun i := (α i).val
  monotone' := α.monotone

/-- Every interior retained face is its original degeneracy of the earlier word. -/
theorem interior_face_alternatingSimplex (m : ℕ) (i : Fin (m + 1)) :
    coherentIso.map (SimplexCategory.δ i.succ.castSucc).op (alternatingSimplex.{u} (m + 2)) =
      coherentIso.map (SimplexCategory.σ i).op (alternatingSimplex m) := by
  apply eq_of_forall_vertexBool_eq
  intro j
  change ((i.succ.castSucc.succAbove j).val % 2 == 1) = ((i.predAbove j).val % 2 == 1)
  by_cases h : j.val ≤ i.val
  · have hl : j ≤ i.castSucc := h
    have hr : j.castSucc < i.succ.castSucc := by
      change j.val < i.val + 1
      omega
    rw [Fin.succAbove_of_castSucc_lt _ _ hr, Fin.predAbove_of_le_castSucc _ _ hl]
    rfl
  · have hl : i.castSucc < j := lt_of_not_ge h
    have hr : i.succ.castSucc ≤ j.castSucc := by
      change i.val + 1 ≤ j.val
      omega
    rw [Fin.succAbove_of_le_castSucc _ _ hr, Fin.predAbove_of_castSucc_lt _ _ hl]
    simp only [Fin.val_succ, Fin.val_pred]
    apply congrArg (fun a : ℕ => a == 1)
    omega

/-- Both original simplex maps in an interior-face restriction agree on their whole source. -/
theorem alternatingMap_interior_face (m : ℕ) (i : Fin (m + 1)) :
    stdSimplex.δ i.succ.castSucc ≫ alternatingMap.{u} (m + 2) =
      stdSimplex.σ i ≫ alternatingMap m := by
  apply yonedaEquiv.injective
  change coherentIso.map (SimplexCategory.δ i.succ.castSucc).op
    (alternatingSimplex.{u} (m + 2)) =
      coherentIso.map (SimplexCategory.σ i).op (alternatingSimplex m)
  exact interior_face_alternatingSimplex m i

private theorem retained_horn_image {k : ℕ} (hk : 2 ≤ k) :
    (horn.{u} k 0).image (alternatingMap k) ≤ stage (k - 1) := by
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 2 := ⟨k - 2, by omega⟩
  rw [horn_eq_iSup, Subcomplex.image_iSup]
  refine iSup_le fun j => ?_
  simp only [stdSimplex.face_singleton_compl, Subcomplex.image_ofSimplex]
  change Subcomplex.ofSimplex
    (coherentIso.map (SimplexCategory.δ j.val).op (alternatingSimplex.{u} (m + 2))) ≤
      stage (m + 2 - 1)
  simp only [show m + 2 - 1 = m + 1 by omega]
  by_cases hj : j.val = Fin.last (m + 2)
  · rw [hj, last_face_alternatingSimplex]
    exact le_rfl
  · have hzero : j.val.val ≠ 0 := by
      intro h
      apply j.property
      exact Fin.ext h
    have hlast : j.val.val ≠ m + 2 := by
      intro h
      apply hj
      exact Fin.ext h
    let i : Fin (m + 1) := ⟨j.val.val - 1, by have hb := j.val.isLt; omega⟩
    have hi : j.val = i.succ.castSucc := by
      apply Fin.ext
      change j.val.val = (j.val.val - 1) + 1
      omega
    rw [hi, interior_face_alternatingSimplex]
    exact (Subcomplex.ofSimplex_map_le (SimplexCategory.σ i) (alternatingSimplex m)).trans
      (stage_le_succ m)

/-- The actual horn attachment into the original previous generated stage. -/
def hornAttachment (k : ℕ) (hk : 2 ≤ k) :
    (horn.{u} k 0 : SSet.{u}) ⟶ (stage (k - 1) : SSet.{u}) :=
  Subcomplex.lift ((horn k 0).ι ≫ alternatingMap k)
    (by simpa only [← Subcomplex.image_eq_range] using retained_horn_image.{u} hk)

@[reassoc (attr := simp)]
theorem hornAttachment_ι (k : ℕ) (hk : 2 ≤ k) :
    hornAttachment.{u} k hk ≫ (stage (k - 1)).ι = (horn k 0).ι ≫ alternatingMap k := rfl

@[simp]
theorem hornAttachment_app_val (k : ℕ) (hk : 2 ≤ k) (d : SimplexCategoryᵒᵖ)
    (a : (horn.{u} k 0).obj d) :
    dsimp% ((hornAttachment k hk).app d a).val = (alternatingMap k).app d a.val := rfl

/-- Both original maps into the new stage agree on the entire horn. -/
@[reassoc (attr := simp)]
theorem hornAttachment_stageSimplexMap (k : ℕ) (hk : 2 ≤ k) :
    (horn.{u} k 0).ι ≫ stageSimplexMap k =
      hornAttachment k hk ≫ stageDiagram.map (homOfLE (Nat.sub_le k 1)) := by
  ext d : 1
  apply ConcreteCategory.hom_ext
  intro a
  exact Subtype.ext rfl

/-- The original horn attachment commutes with every original simplex operator. -/
theorem hornAttachment_naturality (k : ℕ) (hk : 2 ≤ k)
    {d e : SimplexCategoryᵒᵖ} (f : d ⟶ e) (a : (horn.{u} k 0).obj d) :
    (stage (k - 1) : SSet.{u}).map f ((hornAttachment k hk).app d a) =
      (hornAttachment k hk).app e ((horn k 0 : SSet.{u}).map f a) :=
  (congrArg (fun g : (horn.{u} k 0 : SSet.{u}).obj d ⟶
      (stage (k - 1) : SSet.{u}).obj e => g a)
    ((hornAttachment.{u} k hk).naturality f)).symm

private theorem outside_not_old {k n : ℕ} (hk : 2 ≤ k)
    (a : (Δ[k] : SSet.{u}) _⦋n⦌)
    (ha : a ∉ (horn k 0).obj (op ⦋n⦌)) :
    (alternatingMap k).app (op ⦋n⦌) a ∉ (stage (k - 1)).obj (op ⦋n⦌) := by
  intro hold
  obtain ⟨f, hf⟩ := (Subcomplex.mem_ofSimplex_obj_iff (alternatingSimplex (k - 1)) _).mp hold
  have hpar : ∀ i, (a i).val % 2 = (f.toOrderHom i).val % 2 := by
    intro i
    apply parity_eq
    have h := congrArg (fun x => vertexBool x i) hf
    simpa only [map_alternatingSimplex_vertexBool, alternatingMap_app_vertexBool] using h.symm
  have hd := parity_domination hk (stdSimplex.asOrderHom a) (outside_range a ha)
    (natWord f.toOrderHom) hpar (Fin.last n)
  have hl := covered_last hk (stdSimplex.asOrderHom a) (outside_range a ha)
  have hb := (f.toOrderHom (Fin.last n)).isLt
  change (a (Fin.last n)).val ≤ (f.toOrderHom (Fin.last n)).val at hd
  change (a (Fin.last n)).val = k at hl
  change (f.toOrderHom (Fin.last n)).val < (k - 1) + 1 at hb
  omega

/-- The old-stage condition is exactly the original horn condition, in every degree. -/
theorem mem_oldStage_iff_mem_horn {k n : ℕ} (hk : 2 ≤ k)
    (a : (Δ[k] : SSet.{u}) _⦋n⦌) :
    (alternatingMap k).app (op ⦋n⦌) a ∈ (stage (k - 1)).obj (op ⦋n⦌) ↔
      a ∈ (horn k 0).obj (op ⦋n⦌) := by
  constructor
  · intro hold
    by_contra ha
    exact outside_not_old hk a ha hold
  · intro ha
    exact (retained_horn_image hk) _ ⟨a, ha, rfl⟩

/-- Literal equality of the original old-stage preimage with `Λ[k,0]`. -/
theorem preimage_oldStage (k : ℕ) (hk : 2 ≤ k) :
    (stage.{u} (k - 1)).preimage (alternatingMap k) = horn k 0 := by
  ext d a
  change (alternatingMap k).app (op ⦋d.unop.len⦌) a ∈
    (stage (k - 1)).obj (op ⦋d.unop.len⦌) ↔ a ∈ (horn k 0).obj (op ⦋d.unop.len⦌)
  exact mem_oldStage_iff_mem_horn hk a

/-- No two distinct original ordinal representatives survive off the original horn. -/
theorem alternatingMap_injOn_complement {k n : ℕ} (hk : 2 ≤ k) :
    Set.InjOn ((alternatingMap.{u} k).app (op ⦋n⦌)) ((horn k 0).obj (op ⦋n⦌))ᶜ := by
  intro a ha b hb hab
  have hpar : ∀ i, (a i).val % 2 = (b i).val % 2 := by
    intro i
    apply parity_eq
    simpa only [alternatingMap_app_vertexBool] using congrArg (fun x => vertexBool x i) hab
  have hab' := parity_domination hk (stdSimplex.asOrderHom a) (outside_range a ha)
    (natWord (stdSimplex.asOrderHom b)) hpar
  have hba' := parity_domination hk (stdSimplex.asOrderHom b) (outside_range b hb)
    (natWord (stdSimplex.asOrderHom a)) (fun i => (hpar i).symm)
  apply stdSimplex.objEquiv.injective
  apply SimplexCategory.Hom.ext
  apply OrderHom.ext
  funext i
  apply Fin.ext
  exact Nat.le_antisymm (hab' i) (hba' i)

/-- All collisions are equal representatives or actual identifications through the horn
attachment. -/
theorem alternatingMap_eq_iff {k n : ℕ} (hk : 2 ≤ k)
    (a b : (Δ[k] : SSet.{u}) _⦋n⦌) :
    (alternatingMap k).app (op ⦋n⦌) a = (alternatingMap k).app (op ⦋n⦌) b ↔
      a = b ∨ ∃ (ha : a ∈ (horn k 0).obj (op ⦋n⦌))
        (hb : b ∈ (horn k 0).obj (op ⦋n⦌)),
        (hornAttachment k hk).app (op ⦋n⦌) ⟨a, ha⟩ =
          (hornAttachment k hk).app (op ⦋n⦌) ⟨b, hb⟩ := by
  constructor
  · intro hab
    by_cases ha : a ∈ (horn k 0).obj (op ⦋n⦌)
    · by_cases hb : b ∈ (horn k 0).obj (op ⦋n⦌)
      · right
        refine ⟨ha, hb, ?_⟩
        exact Subtype.ext hab
      · have hold := (mem_oldStage_iff_mem_horn hk a).mpr ha
        exact False.elim (hb ((mem_oldStage_iff_mem_horn hk b).mp (hab ▸ hold)))
    · by_cases hb : b ∈ (horn k 0).obj (op ⦋n⦌)
      · have hold := (mem_oldStage_iff_mem_horn hk b).mpr hb
        exact False.elim (ha ((mem_oldStage_iff_mem_horn hk a).mp (hab.symm ▸ hold)))
      · exact Or.inl (alternatingMap_injOn_complement hk ha hb hab)
  · rintro (rfl | ⟨ha, hb, h⟩)
    · rfl
    · exact congrArg Subtype.val h

/-- In degree zero, every original point is already in the retained horn. -/
theorem mem_horn_degree_zero (k : ℕ) (hk : 2 ≤ k) (a : (Δ[k] : SSet.{u}) _⦋0⦌) :
    a ∈ (horn k 0).obj (op ⦋0⦌) := by
  by_contra ha
  let one : Fin (k + 1) := ⟨1, by omega⟩
  let two : Fin (k + 1) := ⟨2, by omega⟩
  have h1 : one ≠ 0 := by intro h; have := congrArg Fin.val h; change 1 = 0 at this; omega
  have h2 : two ≠ 0 := by intro h; have := congrArg Fin.val h; change 2 = 0 at this; omega
  obtain ⟨i, hi⟩ := outside_range a ha one h1
  obtain ⟨j, hj⟩ := outside_range a ha two h2
  have hij : i = j := by
    apply Fin.ext
    have hi' := i.isLt
    have hj' := j.isLt
    change i.val < 1 at hi'
    change j.val < 1 at hj'
    omega
  have h := hi.symm.trans (hij ▸ hj)
  have hv := congrArg Fin.val h
  change 1 = 2 at hv
  omega

/-- The original zero and two vertices give a genuine nonmonicity witness for every `k ≥ 2`. -/
theorem not_mono_alternatingMap (k : ℕ) (hk : 2 ≤ k) : ¬ Mono (alternatingMap.{u} k) := by
  intro hmono
  let two : Fin (k + 1) := ⟨2, by omega⟩
  let a : (Δ[k] : SSet.{u}) _⦋0⦌ :=
    stdSimplex.objEquiv.symm (SimplexCategory.const ⦋0⦌ ⦋k⦌ 0)
  let b : (Δ[k] : SSet.{u}) _⦋0⦌ :=
    stdSimplex.objEquiv.symm (SimplexCategory.const ⦋0⦌ ⦋k⦌ two)
  have hab : (alternatingMap.{u} k).app (op ⦋0⦌) a =
      (alternatingMap.{u} k).app (op ⦋0⦌) b := by
    apply eq_of_forall_vertexBool_eq
    intro i
    have hi : i = 0 := by
      apply Fin.ext
      have hi' := i.isLt
      change i.val < 1 at hi'
      omega
    subst i
    simp only [alternatingMap_app_vertexBool]
    change (0 % 2 == 1) = (2 % 2 == 1)
    rfl
  have hApp := (NatTrans.mono_iff_mono_app (alternatingMap.{u} k)).mp hmono (op ⦋0⦌)
  have hInj := (mono_iff_injective _).mp hApp
  have h := congrArg (fun x : (Δ[k] : SSet.{u}) _⦋0⦌ => (x (0 : Fin 1)).val) (hInj hab)
  change 0 = 2 at h
  omega

end SSet.coherentIso
