-- Author: @toskua, Avocado
module

public import MathlibExt.AlgebraicTopology.SimplicialCategory.TensorCotensor
public import Mathlib.AlgebraicTopology.SimplicialSet.CoherentIso
public import Mathlib.AlgebraicTopology.SimplicialSet.Subcomplex
public import Mathlib.CategoryTheory.Comma.Arrow

/-!
# Raw Rezk localizing maps

This file defines the raw Segal spine inclusions and completeness map for
simplicial spaces, together with their small indexing family. It makes no
model-category, localization, or weak-equivalence claim.

## Source correspondence

In the notation of Charles Rezk, *A model for the homotopy theory of
homotopy theory* (2001), §§4 and 6, `representable n` is `F(n)`, `spine n`
is `G(n)`, and `segalMap n` is the inclusion `G(n) → F(n)`. The object
`walkingIsomorphism` is Rezk's `E`, while `completenessMap` is the map
`F(0) → E` selecting the source vertex `x₀`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u

open CategoryTheory

open scoped Simplicial

namespace SSet.Rezk

/-- The spine of the standard `n`-simplex, generated by its consecutive edges. -/
def spineSubcomplex (n : ℕ) : (Δ[n] : SSet.{u}).Subcomplex :=
  ⨆ i : Fin n,
    SSet.Subcomplex.range
      (SSet.stdSimplex.map (SimplexCategory.mkOfSucc i))

/-- The outer representable standard simplex, made discrete in the inner direction. -/
noncomputable abbrev representable (n : ℕ) :
    SimplicialObject SSet.{u} :=
  SSet.simplicialSpaceDiscrete.obj (Δ[n] : SSet.{u})

/-- The outer spine, made discrete in the inner direction. -/
noncomputable abbrev spine (n : ℕ) :
    SimplicialObject SSet.{u} :=
  SSet.simplicialSpaceDiscrete.obj (spineSubcomplex.{u} n : SSet.{u})

/-- The inclusion from the outer spine into the representable standard simplex. -/
noncomputable def segalMap (n : ℕ) :
    spine.{u} n ⟶ representable.{u} n :=
  SSet.simplicialSpaceDiscrete.map (spineSubcomplex.{u} n).ι

/-- The nerve of the walking isomorphism. -/
noncomputable abbrev walkingIsomorphismNerve : SSet.{u} :=
  SSet.coherentIso.{u}

/-- The walking-isomorphism nerve, made discrete in the inner direction. -/
noncomputable abbrev walkingIsomorphism :
    SimplicialObject SSet.{u} :=
  SSet.simplicialSpaceDiscrete.obj walkingIsomorphismNerve.{u}

/-- The completeness map selecting the source vertex of the walking isomorphism. -/
noncomputable def completenessMap :
    representable.{u} 0 ⟶ walkingIsomorphism.{u} :=
  SSet.simplicialSpaceDiscrete.map
    (SSet.yonedaEquiv.symm SSet.coherentIso.x₀)

/-- Indices for Segal maps in dimensions at least two and the completeness map. -/
abbrev LocalizingIndex := {n : ℕ // 2 ≤ n} ⊕ PUnit.{1}

/-- The small family consisting of the Segal and completeness maps. -/
noncomputable def localizingMap :
    LocalizingIndex → Arrow (SimplicialObject SSet.{u})
  | .inl n => Arrow.mk (segalMap.{u} n.1)
  | .inr _ => Arrow.mk completenessMap.{u}

end SSet.Rezk
