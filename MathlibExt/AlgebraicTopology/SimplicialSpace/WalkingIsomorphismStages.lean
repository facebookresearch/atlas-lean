module

public import MathlibExt.AlgebraicTopology.SimplicialSet.CoherentIso
public import MathlibExt.AlgebraicTopology.SimplicialSpace.LocalizingMaps
public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplex
public import Mathlib.CategoryTheory.Limits.Types.Filtered

/-!
# The original alternating stages of the walking-isomorphism nerve

Rezk's §11 filtration uses the subcomplex generated by ONE alternating word
beginning at the original zero vertex. Its first stage is the actual forward
edge. The original inclusions have union and sequential colimit the full
walking-isomorphism nerve, also after making the inner direction discrete.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section
universe u

open CategoryTheory CategoryTheory.Limits Opposite
open scoped Simplicial

namespace SSet.coherentIso

/-- The original degree-n word x,y,x,..., starting at zero. -/
def alternatingSimplex (n : ℕ) : coherentIso.{u} _⦋n⦌ :=
  Codiscrete.functor (fun i : Fin (n + 1) => ULift.up (i.val % 2 == 1))

/-- Every original object coordinate of the alternating generator. -/
@[simp]
theorem alternatingSimplex_vertexBool (n : ℕ) (i : Fin (n + 1)) :
    vertexBool (alternatingSimplex.{u} n) i = (i.val % 2 == 1) := rfl

/-- Restriction by every original simplex operator retains its original coordinates. -/
@[simp]
theorem map_alternatingSimplex_vertexBool {m n : ℕ} (f : ⦋m⦌ ⟶ ⦋n⦌)
    (i : Fin (m + 1)) :
    vertexBool (coherentIso.map f.op (alternatingSimplex.{u} n)) i =
      ((f.toOrderHom i).val % 2 == 1) := rfl

@[simp]
theorem alternatingSimplex_zero : alternatingSimplex.{u} 0 = x₀ := by
  apply eq_of_forall_vertexBool_eq
  intro i
  fin_cases i
  rfl

@[simp]
theorem alternatingSimplex_one : alternatingSimplex.{u} 1 = hom.edge := by
  apply eq_of_forall_vertexBool_eq
  intro i
  fin_cases i <;> rfl

/-- Rezk's E(n), generated by the single original alternating n-simplex. -/
def stage (n : ℕ) : coherentIso.{u}.Subcomplex :=
  Subcomplex.ofSimplex (alternatingSimplex n)

@[simp]
theorem stage_zero : stage.{u} 0 = Subcomplex.ofSimplex x₀ := by
  simp [stage]

@[simp]
theorem stage_one : stage.{u} 1 = Subcomplex.ofSimplex hom.edge := by
  simp [stage]

/-- The last-face restriction is the original preceding alternating generator. -/
theorem last_face_alternatingSimplex (n : ℕ) :
    coherentIso.map (SimplexCategory.δ (Fin.last (n + 1))).op
      (alternatingSimplex.{u} (n + 1)) = alternatingSimplex n := by
  apply eq_of_forall_vertexBool_eq
  intro i
  simp [SimplexCategory.δ, SimplexCategory.mkHom, Fin.succAbove_last]

/-- The actual consecutive generated-subcomplex inclusion. -/
theorem stage_le_succ (n : ℕ) : stage.{u} n ≤ stage (n + 1) := by
  simpa only [stage, last_face_alternatingSimplex] using
    Subcomplex.ofSimplex_map_le (SimplexCategory.δ (Fin.last (n + 1)))
      (alternatingSimplex.{u} (n + 1))

/-- The original alternating stages form an increasing family. -/
theorem monotone_stage : Monotone stage.{u} :=
  monotone_nat_of_le_succ stage_le_succ

private def bandIndex {m : ℕ} (b : Fin (m + 1) → Bool) (i : Fin (m + 1)) :
    Fin (2 * m + 2) :=
  ⟨2 * i.val + (if b i then 1 else 0), by
    have hi := i.isLt
    split <;> omega⟩

private theorem bandIndex_monotone {m : ℕ} (b : Fin (m + 1) → Bool) :
    Monotone (bandIndex b) := by
  intro i j hij
  change (bandIndex b i).val ≤ (bandIndex b j).val
  by_cases h : i = j
  · subst j
    exact le_rfl
  · have hf : i < j := lt_of_le_of_ne hij h
    have hv : i.val < j.val := hf
    simp only [bandIndex]
    split <;> split <;> omega

private def wordMap {m : ℕ} (x : coherentIso.{u} _⦋m⦌) :
    ⦋m⦌ ⟶ ⦋2 * m + 1⦌ :=
  SimplexCategory.mkHom
    { toFun := bandIndex (vertexBool x)
      monotone' := bandIndex_monotone (vertexBool x) }

private theorem wordMap_restriction {m : ℕ} (x : coherentIso.{u} _⦋m⦌) :
    coherentIso.map (wordMap x).op (alternatingSimplex (2 * m + 1)) = x := by
  apply eq_of_forall_vertexBool_eq
  intro i
  change ((2 * i.val + (if vertexBool x i then 1 else 0)) % 2 == 1) = vertexBool x i
  cases vertexBool x i <;> simp [Nat.add_mod]

/-- Every original word, including repeated labels, occurs in this actual stage. -/
theorem mem_stage_bound {m : ℕ} (x : coherentIso.{u} _⦋m⦌) :
    x ∈ (stage (2 * m + 1)).obj (op ⦋m⦌) :=
  (Subcomplex.mem_ofSimplex_obj_iff _ _).mpr ⟨wordMap x, wordMap_restriction x⟩

/-- An original simplex operator from the original word to its alternating generator. -/
theorem exists_alternating_restriction {m : ℕ} (x : coherentIso.{u} _⦋m⦌) :
    ∃ f : ⦋m⦌ ⟶ ⦋2 * m + 1⦌,
      coherentIso.map f.op (alternatingSimplex (2 * m + 1)) = x :=
  ⟨wordMap x, wordMap_restriction x⟩

/-- The literal union of all original stages is the full nerve. -/
theorem iSup_stage : (⨆ n, stage.{u} n) = ⊤ := by
  apply top_unique
  intro d x _
  have hx : x ∈ (stage (2 * d.unop.len + 1)).obj d := mem_stage_bound x
  exact (le_iSup stage (2 * d.unop.len + 1)) _ hx

/-- The actual Nat-index diagram, with native original subcomplex inclusions. -/
def stageDiagram : ℕ ⥤ SSet.{u} :=
  monotone_stage.functor ⋙ Subcomplex.toSSetFunctor

@[simp]
theorem stageDiagram_obj (n : ℕ) : stageDiagram.{u}.obj n = (stage n : SSet.{u}) := rfl

/-- Every original diagram map is the original inclusion into the same E. -/
@[reassoc (attr := simp)]
theorem stageDiagram_map_ι {n m : ℕ} (f : n ⟶ m) :
    stageDiagram.{u}.map f ≫ (stage m).ι = (stage n).ι := rfl

theorem stageDiagram_map_app_val {n m : ℕ} (f : n ⟶ m)
    (d : SimplexCategoryᵒᵖ) (x : (stage n).obj d) :
    ((stageDiagram.{u}.map f).app d x).val = x.val := rfl

/-- The original inclusion cocone into the original full nerve. -/
def stageCocone : Cocone stageDiagram.{u} where
  pt := coherentIso
  ι := { app n := (stage n).ι }

@[simp]
theorem stageCocone_ι_app (n : ℕ) : stageCocone.{u}.ι.app n = (stage n).ι := rfl

/-- The original inclusion cocone is an actual sequential colimit. -/
def stageIsColimit : IsColimit stageCocone.{u} :=
  evaluationJointlyReflectsColimits _ (fun d => by
    apply Types.FilteredColimit.isColimitOf'
    · intro x
      exact ⟨2 * d.unop.len + 1, ⟨x, mem_stage_bound x⟩, rfl⟩
    · intro n x y h
      change x.val = y.val at h
      refine ⟨n, 𝟙 n, ?_⟩
      exact congrArg (fun z => ((stageDiagram.map (𝟙 n)).app d) z) (Subtype.ext h))

/-- The original zero-vertex map. -/
def zeroMap : (Δ[0] : SSet.{u}) ⟶ coherentIso := yonedaEquiv.symm x₀

/-- The original forward xy edge map. -/
def forwardMap : (Δ[1] : SSet.{u}) ⟶ coherentIso := yonedaEquiv.symm hom.edge

private theorem parity_injective : Function.Injective (fun i : Fin 2 => i.val % 2 == 1) := by
  intro i j h
  fin_cases i <;> fin_cases j <;> simp_all

instance forwardMap_mono : Mono forwardMap.{u} := by
  rw [NatTrans.mono_iff_mono_app]
  intro d
  rw [mono_iff_injective]
  intro a b h
  apply stdSimplex.objEquiv.injective
  apply SimplexCategory.Hom.ext
  apply OrderHom.ext
  funext i
  apply parity_injective
  change coherentIso.map (stdSimplex.objEquiv a).op hom.edge =
    coherentIso.map (stdSimplex.objEquiv b).op hom.edge at h
  rw [← alternatingSimplex_one] at h
  exact congrArg (fun x => vertexBool x i) h

/-- The original forward image is exactly the original first stage. -/
theorem range_forwardMap : Subcomplex.range forwardMap.{u} = stage 1 := by
  simp [Subcomplex.range_eq_ofSimplex, forwardMap, stage]

/-- The actual forward range isomorphism F(1) ≅ E(1). -/
def forwardIso : (Δ[1] : SSet.{u}) ≅ (stage 1 : SSet.{u}) :=
  asIso (Subcomplex.toRange forwardMap) ≪≫ Subcomplex.eqToIso range_forwardMap

/-- Its composite is the original forward map into E, with the original target. -/
@[reassoc (attr := simp)]
theorem forwardIso_hom_ι : forwardIso.{u}.hom ≫ (stage 1).ι = forwardMap := by
  exact Subcomplex.toRange_ι forwardMap

/-- The same stages made discrete in the original inner direction. -/
def innerStageDiagram : ℕ ⥤ SimplicialObject SSet.{u} :=
  stageDiagram ⋙ SSet.simplicialSpaceDiscrete

/-- The same original inclusion cocone made inner-discrete. -/
def innerStageCocone : Cocone innerStageDiagram.{u} :=
  SSet.simplicialSpaceDiscrete.mapCocone stageCocone

/-- All original bidegree objects retain the actual scalar stage points. -/
@[simp]
theorem innerStageDiagram_obj (n : ℕ) (a b : SimplexCategoryᵒᵖ) :
    ((innerStageDiagram.{u}.obj n).obj a).obj b = (stage n).obj a := rfl

/-- Every original outer operator is the actual original stage restriction. -/
theorem innerStageDiagram_outer_map {n : ℕ} {a a' : SimplexCategoryᵒᵖ}
    (f : a ⟶ a') (b : SimplexCategoryᵒᵖ) (x : (stage.{u} n).obj a) :
    (((innerStageDiagram.obj n).map f).app b x).val = coherentIso.map f x.val := rfl

/-- Every original inner operator is an identity on original stage points. -/
theorem innerStageDiagram_inner_map (n : ℕ) (a : SimplexCategoryᵒᵖ)
    {b b' : SimplexCategoryᵒᵖ} (f : b ⟶ b') (x : (stage.{u} n).obj a) :
    (((innerStageDiagram.obj n).obj a).map f x) = x := rfl

/-- Every original Nat-stage map retains its original point in both bidegrees. -/
theorem innerStageDiagram_map_app_val {n m : ℕ} (f : n ⟶ m)
    (a b : SimplexCategoryᵒᵖ) (x : (stage.{u} n).obj a) :
    (((innerStageDiagram.map f).app a).app b x).val = x.val := rfl

/-- Every cocone injection retains the original word in every original bidegree. -/
theorem innerStageCocone_ι_app (n : ℕ) (a b : SimplexCategoryᵒᵖ)
    (x : (stage.{u} n).obj a) :
    ((innerStageCocone.ι.app n).app a).app b x = x.val := rfl

/-- The same original inner-discrete cocone is an actual colimit. -/
def innerStageIsColimit : IsColimit innerStageCocone.{u} :=
  evaluationJointlyReflectsColimits _ (fun a =>
    evaluationJointlyReflectsColimits _ (fun _ =>
      isColimitOfPreserves ((evaluation SimplexCategoryᵒᵖ (Type u)).obj a) stageIsColimit))

end SSet.coherentIso
