-- Author: @toskua, Avocado
module

public import Mathlib.AlgebraicTopology.SimplicialSet.Finite
public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplex

/-!
# Finite subcomplexes generated by simplices

For `Y : SSet`, the subcomplex generated by a single simplex (`ofSimplex x`)
is finite, and a finite indexed supremum of such generated subcomplexes is
finite. These are the smallest public finiteness wrappers needed by the KQ3
compact-support assembly.

API-reuse map (all `reuse`; no `local` invention): `SSet.Finite`,
`SSet.finite_range`, `SSet.finite_iSup_iff`, `SSet.Subcomplex.ofSimplex`, and
`SSet.Subcomplex.range_eq_ofSimplex` from pinned Mathlib. The filtered
finite-subcomplex colimit API imports these public singleton and finite-family
lemmas; its binary `finite_sup` helper remains private. Binary suprema of
arbitrary finite subcomplexes are available via `SSet.finite_iSup_iff` over
`Fin 2`.

Nonclaims: no colimit, topology, product comparison, weak-equivalence, or
model-category content appears here.
-/

@[expose] public section

open Simplicial

namespace SSet.Subcomplex

universe u

variable (Y : SSet.{u})

/-- The subcomplex generated by a single simplex is finite. -/
theorem finite_ofSimplex {n : ℕ} (x : Y _⦋n⦌) :
    SSet.Finite ((ofSimplex x : Y.Subcomplex) : SSet.{u}) := by
  have h : SSet.Finite (Subcomplex.range (SSet.yonedaEquiv.symm x) : Y.Subcomplex) :=
    inferInstance
  simpa [Subcomplex.range_eq_ofSimplex, Equiv.apply_symm_apply] using h

/-- A finite indexed supremum of singly-generated subcomplexes is finite. -/
theorem finite_iSup_ofSimplex {ι : Type*} [Finite ι] (s : ι → Σ n, Y _⦋n⦌) :
    SSet.Finite ((⨆ i, ofSimplex (s i).2 : Y.Subcomplex) : SSet.{u}) := by
  rw [SSet.finite_iSup_iff]
  intro i
  exact finite_ofSimplex Y (s i).2

end SSet.Subcomplex
