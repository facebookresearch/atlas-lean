-- Author: @toskua
import Mathlib.AlgebraicTopology.SimplicialSet.Skeleton

/-!
# Exact dimensional bounds of the original simplicial skeleton

The SAME original skeleton is generated by exactly the original
simplices below its cutoff. It has the genuine dimensional bound
and is the entire original simplicial set whenever that input
has the same bound. The original stage maps remain unchanged.
-/

noncomputable section
universe u
open CategoryTheory Opposite
open scoped Simplicial

namespace SSet.OriginalSkeletonDimension

/-- The whole SAME original skeleton has precisely the required genuine upper dimension bound. -/
theorem hasDimensionLT (K : SSet.{u}) (n : ℕ) : SSet.HasDimensionLT (K.skeleton n) n := by
  change SSet.HasDimensionLT (⨆ (i : Fin n) (x : K.nonDegenerate i), Subcomplex.ofSimplex x.val : K.Subcomplex) n
  rw [SSet.hasDimensionLT_iSup_iff]
  intro i
  rw [SSet.hasDimensionLT_iSup_iff]
  intro x
  let _ : SSet.HasDimensionLT (Subcomplex.ofSimplex x.val) (i.val+1) := by
    have h : Subcomplex.range (SSet.yonedaEquiv.symm x.val) = Subcomplex.ofSimplex x.val := by
      rw [Subcomplex.range_eq_ofSimplex, Equiv.apply_symm_apply]
    rw [← h]
    infer_instance
  exact SSet.hasDimensionLT_of_le _ (i.val+1) n (Nat.succ_le_of_lt i.isLt)

/-- The SAME original bounded input is exactly its original cutoff skeleton. -/
theorem eq_top (K : SSet.{u}) (n : ℕ) [SSet.HasDimensionLT K n] : K.skeleton n = ⊤ := by
  apply (Subcomplex.eq_top_iff_of_hasDimensionLT (K.skeleton n) n).mpr
  intro i hi x _hx
  exact K.mem_skeleton x hi

/-- The actual whole skeleton inclusion is an isomorphism under the genuine original dimension bound. -/
def inclusionIso (K : SSet.{u}) (n : ℕ) [SSet.HasDimensionLT K n] :
    (K.skeleton n : SSet.{u}) ≅ K :=
  Subcomplex.eqToIso (eq_top K n) ≪≫ Subcomplex.topIso K

/-- The forward map is the literal SAME original skeleton inclusion. -/
theorem inclusionIso_hom (K : SSet.{u}) (n : ℕ) [SSet.HasDimensionLT K n] :
    (inclusionIso K n).hom = (K.skeleton n).ι := by
  apply SSet.hom_ext
  intro q
  apply ConcreteCategory.hom_ext
  intro x
  rfl

/-- The genuine original full dimension bound zero makes the SAME original bottom-subcomplex inclusion an isomorphism.
-/
def emptyIso (K : SSet.{u}) [SSet.HasDimensionLT K 0] : (⊥ : K.Subcomplex).toSSet ≅ K :=
  Subcomplex.eqToIso (K.skeleton_zero.symm.trans (eq_top K 0)) ≪≫ Subcomplex.topIso K

end SSet.OriginalSkeletonDimension
