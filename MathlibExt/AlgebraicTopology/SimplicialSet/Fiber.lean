module

public import Mathlib.AlgebraicTopology.SimplicialSet.Subcomplex
public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplex
public import Mathlib.AlgebraicTopology.SimplicialSet.Monoidal
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic

/-!
# Generic strict fibres of simplicial maps

The strict fibre is the preimage of the subcomplex generated by the
specified target vertex. Its pullback, basepoint and functorial maps
use the original simplicial map and every original scalar operator.
This core has no fibration or model-category hypothesis.
-/

@[expose] public section
universe u
open CategoryTheory Simplicial SSet Limits Opposite

namespace SSet.Subcomplex

private instance subsingleton_ofSimplex_obj {X : SSet.{u}} (y : X _⦋0⦌) (n : SimplexCategoryᵒᵖ) :
    Subsingleton ((Subcomplex.ofSimplex y : SSet.{u}).obj n) := by
  constructor
  intro a b
  have ha : (a : X.obj n) ∈ (Subcomplex.ofSimplex y).obj n := a.property
  have hb : (b : X.obj n) ∈ (Subcomplex.ofSimplex y).obj n := b.property
  rw [Subcomplex.mem_ofSimplex_obj_iff] at ha hb
  obtain ⟨f, hf⟩ := ha
  obtain ⟨g, hg⟩ := hb
  have : f = g := Subsingleton.elim _ _
  subst this
  apply Subtype.ext
  exact hf.symm.trans hg

private instance unique_ofSimplex_obj {X : SSet.{u}} (y : X _⦋0⦌) (n : SimplexCategoryᵒᵖ) :
    Unique ((Subcomplex.ofSimplex y : SSet.{u}).obj n) :=
  ⟨⟨X.map (IsTerminal.from SimplexCategory.isTerminalZero n.unop).op y, by
      rw [Subcomplex.mem_ofSimplex_obj_iff]
      exact ⟨IsTerminal.from SimplexCategory.isTerminalZero n.unop, rfl⟩⟩,
    fun a => Subsingleton.elim a _⟩

/-- The subcomplex generated by a vertex is terminal. -/
def isTerminalOfSimplex {X : SSet.{u}} (y : X _⦋0⦌) :
    IsTerminal (Subcomplex.ofSimplex y : SSet.{u}) :=
  IsTerminal.ofUniqueHom
    (fun Y =>
      Subcomplex.lift ((IsTerminal.from stdSimplex.isTerminalObj₀ Y) ≫ SSet.const (X := Δ[0]) y) (by
        have h1 :
            Subcomplex.range
                ((IsTerminal.from stdSimplex.isTerminalObj₀ Y) ≫
                  SSet.const (X := Δ[0]) y) =
              (Subcomplex.range (IsTerminal.from stdSimplex.isTerminalObj₀ Y)).image
                (SSet.const (X := Δ[0]) y) :=
          Subcomplex.range_comp _ _
        have h2 :
            (Subcomplex.range (IsTerminal.from stdSimplex.isTerminalObj₀ Y)).image
                (SSet.const (X := Δ[0]) y) ≤
              (⊤ : (Δ[0] : SSet.{u}).Subcomplex).image
                (SSet.const (X := Δ[0]) y) := by
          apply Subcomplex.image_monotone
          exact le_top
        have h3 : (⊤ : (Δ[0] : SSet.{u}).Subcomplex).image (SSet.const (X := Δ[0]) y)
            = Subcomplex.range (SSet.const (X := Δ[0]) (Y := X) y) := by
          have := Subcomplex.image_top (f := SSet.const (X := Δ[0]) (Y := X) y)
          exact this
        have h4 : Subcomplex.range (SSet.const (X := Δ[0]) (Y := X) y) =
            Subcomplex.ofSimplex y := by
          have h := Subcomplex.range_eq_ofSimplex (X := X) (SSet.const (X := Δ[0]) (Y := X) y)
          simp only [SSet.yonedaEquiv_const] at h
          exact h
        calc Subcomplex.range
              ((IsTerminal.from stdSimplex.isTerminalObj₀ Y) ≫
                SSet.const (X := Δ[0]) y) =
              (Subcomplex.range (IsTerminal.from stdSimplex.isTerminalObj₀ Y)).image
                (SSet.const (X := Δ[0]) y) := h1
          _ ≤ (⊤ : (Δ[0] : SSet.{u}).Subcomplex).image
                (SSet.const (X := Δ[0]) y) := h2
          _ = Subcomplex.range (SSet.const (X := Δ[0]) (Y := X) y) := h3
          _ = Subcomplex.ofSimplex y := h4
        ))
    (fun Y m => by
      apply NatTrans.ext
      funext n
      ext x
      exact @Subsingleton.elim _ (subsingleton_ofSimplex_obj (X := X) y (n := n)) (m.app n x) _)

/-- The square formed by preimage is a pullback with the orientation
expected downstream. -/
theorem preimage_isPullback {X Y : SSet.{u}} (B : Y.Subcomplex) (f : X ⟶ Y) :
    IsPullback (B.preimage f).ι (B.fromPreimage f) f B.ι where
  w := (Subcomplex.fromPreimage_ι B f).symm
  isLimit' := by
    have hRange : ∀ (s : PullbackCone f B.ι), Subcomplex.range s.fst ≤ B.preimage f := by
      intro s n x hx
      simp only [Subcomplex.range, Subfunctor.range_obj, Set.mem_range] at hx
      obtain ⟨t, rfl⟩ := hx
      simp only [Subcomplex.preimage_obj, Set.mem_preimage]
      have hCond : (s.fst ≫ f).app n t = (s.snd ≫ B.ι).app n t := by
        have := congr_arg (fun k : s.pt ⟶ Y => k.app n t) s.condition
        simpa [CategoryTheory.NatTrans.comp_app] using this
      have hL : (s.fst ≫ f).app n t = f.app n (s.fst.app n t) := rfl
      have hR : (s.snd ≫ B.ι).app n t = (s.snd.app n t).val := rfl
      rw [hL] at hCond
      rw [hR] at hCond
      rw [hCond]
      exact (s.snd.app n t).property
    refine ⟨PullbackCone.IsLimit.mk (Subcomplex.fromPreimage_ι B f).symm
      (fun s => Subcomplex.lift s.fst (hRange s))
      (fun s => Subcomplex.lift_ι s.fst (hRange s))
      (fun s => by
        have h : (Subcomplex.lift s.fst (hRange s) ≫ B.fromPreimage f) ≫ B.ι =
            s.snd ≫ B.ι := by
          calc (Subcomplex.lift s.fst (hRange s) ≫ B.fromPreimage f) ≫ B.ι
              = Subcomplex.lift s.fst (hRange s) ≫ (B.fromPreimage f ≫ B.ι) := by
                rw [Category.assoc]
            _ = Subcomplex.lift s.fst (hRange s) ≫ ((B.preimage f).ι ≫ f) := by
                rw [Subcomplex.fromPreimage_ι]
            _ = (Subcomplex.lift s.fst (hRange s) ≫ (B.preimage f).ι) ≫ f := by
                rw [← Category.assoc]
            _ = s.fst ≫ f := by rw [Subcomplex.lift_ι]
            _ = s.snd ≫ B.ι := by rw [s.condition]
        exact (cancel_mono B.ι).mp h)
      (fun s m h1 h2 => by
        have hEq : m ≫ (B.preimage f).ι =
            Subcomplex.lift s.fst (hRange s) ≫ (B.preimage f).ι := by
          rw [h1, Subcomplex.lift_ι]
        exact (cancel_mono (B.preimage f).ι).mp hEq)⟩

/-- The strict fiber of `f : X ⟶ Y` over a vertex `y : Y _⦋0⦌`. -/
def fiber {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) : X.Subcomplex :=
  (Subcomplex.ofSimplex y).preimage f

@[simp]
lemma fiber_obj {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) (n : SimplexCategoryᵒᵖ) :
    (fiber f y).obj n = { x : X.obj n | f.app n x ∈ (Subcomplex.ofSimplex y).obj n } := rfl

lemma mem_fiber_obj_iff {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌)
    {n : SimplexCategoryᵒᵖ} {x : X.obj n} :
    x ∈ (fiber f y).obj n ↔ f.app n x ∈ (Subcomplex.ofSimplex y).obj n :=
  Iff.rfl

/-- Over a constant target, strict-fibre membership is equality to the supplied label. -/
lemma mem_fiber_const_obj_iff {A : Type u} {X : SSet.{u}}
    (f : X ⟶ (Functor.const SimplexCategoryᵒᵖ).obj A) (a : A)
    {n : SimplexCategoryᵒᵖ} {x : X.obj n} :
    x ∈ (fiber f a).obj n ↔ f.app n x = a := by
  rw [mem_fiber_obj_iff, mem_ofSimplex_obj_iff]
  constructor
  · rintro ⟨φ, hφ⟩
    exact hφ.symm
  · intro h
    exact ⟨IsTerminal.from SimplexCategory.isTerminalZero n.unop, h.symm⟩

lemma mem_fiber_obj_zero_iff {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌)
    {x : X _⦋0⦌} :
    x ∈ (fiber f y).obj (op ⦋0⦌) ↔ f.app _ x = y := by
  simp only [mem_fiber_obj_iff, Subcomplex.mem_ofSimplex_obj_iff]
  constructor
  · rintro ⟨φ, hφ⟩
    have : φ = 𝟙 _ := Subsingleton.elim _ _
    subst this
    simp at hφ
    exact hφ.symm
  · intro h
    exact ⟨𝟙 _, by simp [h]⟩

lemma le_fiber_iff {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) (A : X.Subcomplex) :
    A ≤ fiber f y ↔ A.ι ≫ f = SSet.const y := by
  constructor
  · intro h
    ext n a
    have hmem : f.app n a.val ∈ (Subcomplex.ofSimplex y).obj n := by
      have ha : a.val ∈ A.obj n := a.property
      have hfib : a.val ∈ (fiber f y).obj n := h n ha
      rwa [mem_fiber_obj_iff] at hfib
    have hconst : (SSet.const (X := A) y).app n a ∈ (Subcomplex.ofSimplex y).obj n := by
      rw [Subcomplex.mem_ofSimplex_obj_iff]
      exact ⟨n.unop.const _ 0, rfl⟩
    have heq : (⟨f.app n a.val, hmem⟩ : {x : Y.obj n // x ∈ (Subcomplex.ofSimplex y).obj n}) =
        ⟨(SSet.const (X := A) y).app n a, hconst⟩ := by
      have : Subsingleton {x : Y.obj n // x ∈ (Subcomplex.ofSimplex y).obj n} := by
        change Subsingleton ((Subcomplex.ofSimplex y : SSet.{u}).obj n)
        exact subsingleton_ofSimplex_obj (X := Y) y n
      exact Subsingleton.elim _ _
    calc (A.ι ≫ f).app n a = f.app n a.val := rfl
      _ = (SSet.const (X := A) y).app n a := congrArg Subtype.val heq
  · intro h n x hx
    have h_eq : f.app n x = (SSet.const (X := A) y).app n ⟨x, hx⟩ := by
      have h_app : (A.ι ≫ f).app n ⟨x, hx⟩ = (SSet.const (X := A) y).app n ⟨x, hx⟩ := by
        rw [h]
      have h1 : (A.ι ≫ f).app n ⟨x, hx⟩ = f.app n x := rfl
      rw [h1] at h_app
      exact h_app
    have hconst : (SSet.const (X := A) y).app n ⟨x, hx⟩ ∈ (Subcomplex.ofSimplex y).obj n := by
      rw [Subcomplex.mem_ofSimplex_obj_iff]
      exact ⟨n.unop.const _ 0, rfl⟩
    have hmem : f.app n x ∈ (Subcomplex.ofSimplex y).obj n := h_eq ▸ hconst
    rw [mem_fiber_obj_iff]
    exact hmem

lemma range_le_fiber_iff {W X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) (g : W ⟶ X) :
    Subcomplex.range g ≤ fiber f y ↔ g ≫ f = SSet.const y := by
  constructor
  · intro h
    ext n w
    have : Subsingleton {x : Y.obj n // x ∈ (Subcomplex.ofSimplex y).obj n} := by
      change Subsingleton ((Subcomplex.ofSimplex y : SSet.{u}).obj n)
      exact subsingleton_ofSimplex_obj (X := Y) y n
    have hmem : f.app n (g.app n w) ∈ (Subcomplex.ofSimplex y).obj n := by
      have hg : g.app n w ∈ (Subcomplex.range g).obj n := by
        simp only [Subcomplex.range, Subfunctor.range_obj, Set.mem_range]
        exact ⟨w, rfl⟩
      have hfib : g.app n w ∈ (fiber f y).obj n := h n hg
      rwa [mem_fiber_obj_iff] at hfib
    have hconst : (SSet.const (X := W) y).app n w ∈ (Subcomplex.ofSimplex y).obj n := by
      rw [Subcomplex.mem_ofSimplex_obj_iff]
      exact ⟨n.unop.const _ 0, rfl⟩
    have heq : (⟨f.app n (g.app n w), hmem⟩ : {x : Y.obj n // x ∈ (Subcomplex.ofSimplex y).obj n}) =
        ⟨(SSet.const (X := W) y).app n w, hconst⟩ :=
      Subsingleton.elim _ _
    calc (g ≫ f).app n w = f.app n (g.app n w) := rfl
      _ = (SSet.const (X := W) y).app n w := congrArg Subtype.val heq
  · intro h n x hx
    simp only [Subcomplex.range, Subfunctor.range_obj, Set.mem_range] at hx
    obtain ⟨w, rfl⟩ := hx
    rw [mem_fiber_obj_iff]
    have h_eq : f.app n (g.app n w) = (SSet.const (X := W) y).app n w := by
      have : (g ≫ f).app n w = (SSet.const (X := W) y).app n w := by rw [h]
      simpa using this
    have hconst : (SSet.const (X := W) y).app n w ∈ (Subcomplex.ofSimplex y).obj n := by
      rw [Subcomplex.mem_ofSimplex_obj_iff]
      exact ⟨n.unop.const _ 0, rfl⟩
    rw [h_eq]
    exact hconst

@[reassoc (attr := simp)]
theorem fiber_ι_comp {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) :
    (fiber f y).ι ≫ f = SSet.const y := by
  have h : (fiber f y : X.Subcomplex) ≤ fiber f y := le_rfl
  rw [le_fiber_iff] at h
  exact h

/-- The defining pullback square for the fiber with downstream orientation. -/
theorem fiber_isPullback {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) :
    IsPullback (fiber f y).ι
        (IsTerminal.from stdSimplex.isTerminalObj₀ (fiber f y : SSet.{u})) f
        (SSet.const (X := Δ[0]) y) where
  w := by
    calc (fiber f y).ι ≫ f = SSet.const y := fiber_ι_comp f y
      _ = IsTerminal.from stdSimplex.isTerminalObj₀ (fiber f y : SSet.{u}) ≫
          SSet.const (X := Δ[0]) y := by
        simp
  isLimit' := by
    have hRange :
        ∀ (s : PullbackCone f (SSet.const (X := Δ[0]) y)),
          Subcomplex.range s.fst ≤ fiber f y := by
      intro s n x hx
      simp only [Subcomplex.range, Subfunctor.range_obj, Set.mem_range] at hx
      obtain ⟨t, rfl⟩ := hx
      rw [mem_fiber_obj_iff]
      have hCond :
          (s.fst ≫ f).app n t = (s.snd ≫ SSet.const (X := Δ[0]) y).app n t := by
        have := congr_arg (fun k : s.pt ⟶ Y => k.app n t) s.condition
        simpa using this
      have hL : (s.fst ≫ f).app n t = f.app n (s.fst.app n t) := rfl
      rw [hL] at hCond
      have hMem : (SSet.const (X := s.pt) y).app n t ∈ (Subcomplex.ofSimplex y).obj n := by
        rw [Subcomplex.mem_ofSimplex_obj_iff]
        exact ⟨n.unop.const _ 0, rfl⟩
      have hEq :
          (s.snd ≫ SSet.const (X := Δ[0]) y).app n t =
            (SSet.const (X := s.pt) y).app n t := by
        simp
      rw [hEq] at hCond
      rw [hCond]
      exact hMem
    refine ⟨PullbackCone.IsLimit.mk (by simp [fiber_ι_comp])
        (fun s => Subcomplex.lift s.fst (hRange s))
      (fun s => Subcomplex.lift_ι s.fst (hRange s))
      (fun s => IsTerminal.hom_ext stdSimplex.isTerminalObj₀ _ _)
      (fun s m h1 h2 => by
        have hEq : m ≫ (fiber f y).ι = Subcomplex.lift s.fst (hRange s) ≫ (fiber f y).ι := by
          rw [h1, Subcomplex.lift_ι]
        exact (cancel_mono (fiber f y).ι).mp hEq)⟩

/-- The point of the fiber determined by `x` with `f x = y`. -/
def fiber.basePoint {X Y : SSet.{u}} {f : X ⟶ Y} {y : Y _⦋0⦌} (x : X _⦋0⦌)
    (h : f.app _ x = y) : (fiber f y : SSet.{u}).obj (op ⦋0⦌) :=
  ⟨x, (mem_fiber_obj_zero_iff f y).mpr h⟩

@[simp]
lemma fiber.basePoint_val {X Y : SSet.{u}} {f : X ⟶ Y} {y : Y _⦋0⦌} {x : X _⦋0⦌}
    {h : f.app _ x = y} : (fiber.basePoint (f := f) x h).val = x := rfl

/-- Functoriality of fibers. -/
def mapFiber {X Y X' Y' : SSet.{u}} {f : X ⟶ Y} {f' : X' ⟶ Y'}
    (g : X ⟶ X') (h : Y ⟶ Y') (hc : g ≫ f' = f ≫ h)
    {y : Y _⦋0⦌} {y' : Y' _⦋0⦌} (hy : h.app _ y = y') :
    (fiber f y : SSet.{u}) ⟶ (fiber f' y' : SSet.{u}) :=
  Subcomplex.lift ((fiber f y).ι ≫ g) (by
    rw [range_le_fiber_iff]
    calc ((fiber f y).ι ≫ g) ≫ f' = (fiber f y).ι ≫ (g ≫ f') := by rw [Category.assoc]
      _ = (fiber f y).ι ≫ (f ≫ h) := by rw [hc]
      _ = ((fiber f y).ι ≫ f) ≫ h := by rw [← Category.assoc]
      _ = SSet.const y ≫ h := by rw [fiber_ι_comp]
      _ = SSet.const y' := by rw [SSet.const_comp, hy]
    )

@[simp, reassoc]
lemma mapFiber_ι {X Y X' Y' : SSet.{u}} {f : X ⟶ Y} {f' : X' ⟶ Y'}
    (g : X ⟶ X') (h : Y ⟶ Y') (hc : g ≫ f' = f ≫ h)
    {y : Y _⦋0⦌} {y' : Y' _⦋0⦌} (hy : h.app _ y = y') :
    mapFiber g h hc hy ≫ (fiber f' y').ι = (fiber f y).ι ≫ g :=
  Subcomplex.lift_ι _ _

@[simp]
theorem mapFiber_id {X Y : SSet.{u}} (f : X ⟶ Y) (y : Y _⦋0⦌) :
    mapFiber (𝟙 X) (𝟙 Y) (by simp) rfl (y := y) (y' := y) =
      𝟙 (fiber f y : SSet.{u}) := by
  apply (cancel_mono (fiber f y).ι).mp
  calc mapFiber (𝟙 X) (𝟙 Y) (by simp) rfl ≫ (fiber f y).ι
      = (fiber f y).ι ≫ 𝟙 X := mapFiber_ι _ _ _ _
    _ = (fiber f y).ι := by simp
    _ = 𝟙 (fiber f y : SSet.{u}) ≫ (fiber f y).ι := by simp

theorem mapFiber_comp {X Y X' Y' X'' Y'' : SSet.{u}} {f : X ⟶ Y}
    {f' : X' ⟶ Y'} {f'' : X'' ⟶ Y''} (g : X ⟶ X') (g' : X' ⟶ X'')
    (h : Y ⟶ Y') (h' : Y' ⟶ Y'') (hc : g ≫ f' = f ≫ h)
    (hc' : g' ≫ f'' = f' ≫ h') {y : Y _⦋0⦌} {y' : Y' _⦋0⦌}
    {y'' : Y'' _⦋0⦌} (hy : h.app _ y = y') (hy' : h'.app _ y' = y'') :
    mapFiber g h hc hy ≫ mapFiber g' h' hc' hy' =
      mapFiber (g ≫ g') (h ≫ h')
        (by
          calc (g ≫ g') ≫ f'' = g ≫ (g' ≫ f'') := by rw [Category.assoc]
            _ = g ≫ (f' ≫ h') := by rw [hc']
            _ = (g ≫ f') ≫ h' := by rw [← Category.assoc]
            _ = (f ≫ h) ≫ h' := by rw [hc]
            _ = f ≫ (h ≫ h') := by rw [Category.assoc])
        (by simp [hy, hy']) := by
  apply (cancel_mono (fiber f'' y'').ι).mp
  calc (mapFiber g h hc hy ≫ mapFiber g' h' hc' hy') ≫ (fiber f'' y'').ι
      = mapFiber g h hc hy ≫ ((fiber f' y').ι ≫ g') := by
        simp [mapFiber_ι, Category.assoc]
    _ = (mapFiber g h hc hy ≫ (fiber f' y').ι) ≫ g' := by
        rw [← Category.assoc]
    _ = ((fiber f y).ι ≫ g) ≫ g' := by rw [mapFiber_ι]
    _ = (fiber f y).ι ≫ (g ≫ g') := by rw [Category.assoc]
    _ = mapFiber (g ≫ g') (h ≫ h') _ _ ≫ (fiber f'' y'').ι := by
        rw [mapFiber_ι]

lemma mapFiber_app_basePoint {X Y X' Y' : SSet.{u}} {f : X ⟶ Y} {f' : X' ⟶ Y'}
    (g : X ⟶ X') (h : Y ⟶ Y') (hc : g ≫ f' = f ≫ h)
    {y : Y _⦋0⦌} {y' : Y' _⦋0⦌} (hy : h.app _ y = y')
    (x : X _⦋0⦌) (hx : f.app _ x = y) :
    (mapFiber g h hc hy).app _ (fiber.basePoint (f := f) x hx) =
      fiber.basePoint (f := f') (g.app _ x) (by
        have h1 : (g ≫ f').app _ x = (f ≫ h).app _ x := congr_arg (fun k : X ⟶ Y' => k.app _ x) hc
        simp only [NatTrans.comp_app, comp_apply] at h1
        rw [hx, hy] at h1
        exact h1) := by
  apply Subtype.ext
  simp only [mapFiber, fiber.basePoint]
  rfl

end SSet.Subcomplex
