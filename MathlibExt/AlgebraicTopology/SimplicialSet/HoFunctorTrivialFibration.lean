-- Author: @toskua
module

public import Mathlib.AlgebraicTopology.SimplicialSet.CategoryWithFibrations
public import Mathlib.AlgebraicTopology.SimplicialSet.HomotopyCat
public import MathlibExt.AlgebraicTopology.SimplicialSet.BoundaryOneMap
public import MathlibExt.AlgebraicTopology.SimplicialSet.BoundaryTwo

/-!
# Trivial Kan fibrations induce equivalences on homotopy categories

A *trivial Kan fibration* of simplicial sets is a map `p : X ⟶ Y` with the
right lifting property against the generating cofibrations
`SSet.modelCategoryQuillen.I` (equivalently, by
`SSet.rlp_monomorphisms`, against every monomorphism). This module proves
that such a map induces an equivalence of ordinary homotopy categories:
for `hp : SSet.modelCategoryQuillen.I.rlp p`, the functor
`SSet.mapHomotopyCategory p : X.HomotopyCategory ⥤ Y.HomotopyCategory`
(and hence the bundled map `(SSet.hoFunctor.map p).toFunctor`) is an
equivalence.

The proof follows the generating presentation of the homotopy category in
`Mathlib.AlgebraicTopology.SimplicialSet.HomotopyCat`: objects are the
vertices, morphisms are generated by `HomotopyCategory.homMk` of edges
(`SSet.Edge`), and the relations are
`homMk e₀₁ ≫ homMk e₁₂ = homMk e₀₂` whenever `Edge.CompStruct e₀₁ e₁₂ e₀₂`
holds. Concretely:

- lifting against the monomorphism `(⊥ : Y.Subcomplex).ι` gives a strict
  section `s : Y ⟶ X` of `p`;
- lifting against `∂Δ[1] ⟶ Δ[1]` lifts edges with prescribed endpoints,
  producing a homotopy between `𝟙` and `p ≫ s` at vertices;
- lifting against `∂Δ[2] ⟶ Δ[2]` lifts `2`-simplices with prescribed
  boundary, showing that these vertex homotopies are natural isomorphisms
  in the homotopy category.

Essential surjectivity and fullness are therefore witnessed by strict
vertex/edge lifting, and faithfulness by `2`-simplex lifting, all packaged
as an explicit quasi-inverse with strictly commuting triangle on one side.
This supports the Joyal model structure programme: it is the
`hoFunctor`-level input for the inner-anodyne entry point into
`SSet.categoricalEquivalences`.

That a trivial Kan fibration is itself a Joyal categorical
equivalence is not proved in this file. That conclusion needs
coherent cylinder homotopies over `p` and a further assembly
into natural isomorphisms of precomposition functors; the
pointwise `ηEdge`/`natIsoId` data of this file by themselves do
not assemble into an edge of `Fun(X, X)`. No statement here
should be read as claiming
`SSet.modelCategoryQuillen.I.rlp ≤ SSet.categoricalEquivalences`.
-/

@[expose] public section

open CategoryTheory Limits Opposite

open scoped Simplicial

universe u

namespace SSet

variable {X Y : SSet.{u}} {p : X ⟶ Y}

/-- A trivial Kan fibration has the right lifting property against every
boundary inclusion. -/
theorem hasLiftingProperty_boundary_of_rlp_I
    (hp : modelCategoryQuillen.I.rlp p) (n : ℕ) :
    HasLiftingProperty (boundary n).ι p :=
  hp _ (modelCategoryQuillen.boundary_ι_mem_I n)

/-- A trivial Kan fibration, viewed through `SSet.rlp_monomorphisms`, has
the right lifting property against every monomorphism. -/
theorem rlp_monomorphisms_of_rlp_I (hp : modelCategoryQuillen.I.rlp p) :
    (MorphismProperty.monomorphisms SSet.{u}).rlp p := by
  rw [rlp_monomorphisms]
  exact hp

/-- A trivial Kan fibration admits a strict section, obtained by lifting
the identity of the target against the inclusion of the empty
subcomplex. -/
theorem exists_section_of_rlp_I (hp : modelCategoryQuillen.I.rlp p) :
    ∃ s : Y ⟶ X, s ≫ p = 𝟙 Y := by
  have hpMono := rlp_monomorphisms_of_rlp_I hp
  have : HasLiftingProperty (⊥ : Y.Subcomplex).ι p :=
    hpMono _ (MorphismProperty.monomorphisms.infer_property _)
  let sq : CommSq ((Subcomplex.isInitialBot (X := Y)).to X)
      (⊥ : Y.Subcomplex).ι p (𝟙 Y) :=
    ⟨(Subcomplex.isInitialBot (X := Y)).hom_ext _ _⟩
  exact ⟨sq.lift, sq.fac_right⟩

/-- A trivial Kan fibration is surjective on vertices. -/
theorem exists_vertex_lift_of_rlp_I (hp : modelCategoryQuillen.I.rlp p)
    (y : Y _⦋0⦌) : ∃ x : X _⦋0⦌, p.app (op ⦋0⦌) x = y := by
  obtain ⟨s, hs⟩ := exists_section_of_rlp_I hp
  refine ⟨s.app (op ⦋0⦌) y, ?_⟩
  have h := ConcreteCategory.congr_hom (congr_app hs (op ⦋0⦌)) y
  simpa using h

/-- Edges lift along a trivial Kan fibration with prescribed endpoints:
given vertices `x₀, x₁` of `X` over `y₀, y₁`, every edge `e' : y₀ → y₁`
is the image of an edge `x₀ → x₁`. This is lifting against
`∂Δ[1] ⟶ Δ[1]`. -/
theorem exists_edge_lift_of_rlp_I (hp : modelCategoryQuillen.I.rlp p)
    {x₀ x₁ : X _⦋0⦌} {y₀ y₁ : Y _⦋0⦌}
    (h₀ : p.app (op ⦋0⦌) x₀ = y₀) (h₁ : p.app (op ⦋0⦌) x₁ = y₁)
    (e' : Edge y₀ y₁) :
    ∃ e : Edge x₀ x₁, p.app (op ⦋1⦌) e.edge = e'.edge := by
  have : HasLiftingProperty (boundary 1).ι p :=
    hasLiftingProperty_boundary_of_rlp_I hp 1
  have hw : boundaryOneMap x₀ x₁ ≫ p =
      (boundary 1).ι ≫ yonedaEquiv.symm e'.edge := by
    apply boundary.hom_ext (n := 0)
    intro i
    fin_cases i
    · calc boundary.ι (0 : Fin 2) ≫ boundaryOneMap x₀ x₁ ≫ p
          = (boundary.ι (0 : Fin 2) ≫ boundaryOneMap x₀ x₁) ≫ p := by
            rw [Category.assoc]
        _ = const x₁ ≫ p := by rw [boundary_ι_zero_boundaryOneMap]
        _ = const y₁ := by simp [const_comp, h₁]
        _ = yonedaEquiv.symm y₁ := (yonedaEquiv_symm_zero y₁).symm
        _ = yonedaEquiv.symm (Y.δ 0 e'.edge) := by rw [Edge.tgt_eq]
        _ = stdSimplex.δ (0 : Fin 2) ≫ yonedaEquiv.symm e'.edge :=
            (stdSimplex.δ_comp_yonedaEquiv_symm e'.edge 0).symm
        _ = boundary.ι (0 : Fin 2) ≫ (boundary 1).ι ≫ yonedaEquiv.symm e'.edge := by
            simp
    · calc boundary.ι (1 : Fin 2) ≫ boundaryOneMap x₀ x₁ ≫ p
          = (boundary.ι (1 : Fin 2) ≫ boundaryOneMap x₀ x₁) ≫ p := by
            rw [Category.assoc]
        _ = const x₀ ≫ p := by rw [boundary_ι_one_boundaryOneMap]
        _ = const y₀ := by simp [const_comp, h₀]
        _ = yonedaEquiv.symm y₀ := (yonedaEquiv_symm_zero y₀).symm
        _ = yonedaEquiv.symm (Y.δ 1 e'.edge) := by rw [Edge.src_eq]
        _ = stdSimplex.δ (1 : Fin 2) ≫ yonedaEquiv.symm e'.edge :=
            (stdSimplex.δ_comp_yonedaEquiv_symm e'.edge 1).symm
        _ = boundary.ι (1 : Fin 2) ≫ (boundary 1).ι ≫ yonedaEquiv.symm e'.edge := by
            simp
  let sq : CommSq (boundaryOneMap x₀ x₁) (boundary 1).ι p
      (yonedaEquiv.symm e'.edge) := ⟨hw⟩
  have hsrc : X.δ (1 : Fin 2) (yonedaEquiv sq.lift) = x₀ := by
    have h1 : stdSimplex.δ (1 : Fin 2) ≫ sq.lift = const x₀ := by
      calc stdSimplex.δ (1 : Fin 2) ≫ sq.lift
          = boundary.ι (1 : Fin 2) ≫ ((boundary 1).ι ≫ sq.lift) := by
            rw [← Category.assoc, boundary.ι_ι]
        _ = boundary.ι (1 : Fin 2) ≫ boundaryOneMap x₀ x₁ := by
            rw [sq.fac_left]
        _ = const x₀ := boundary_ι_one_boundaryOneMap x₀ x₁
    calc X.δ (1 : Fin 2) (yonedaEquiv sq.lift)
        = yonedaEquiv (stdSimplex.δ (1 : Fin 2) ≫ sq.lift) :=
          (stdSimplex.yonedaEquiv_δ_comp sq.lift 1).symm
      _ = yonedaEquiv (const x₀ : Δ[0] ⟶ X) := by rw [h1]
      _ = x₀ := yonedaEquiv_const x₀
  have htgt : X.δ (0 : Fin 2) (yonedaEquiv sq.lift) = x₁ := by
    have h0 : stdSimplex.δ (0 : Fin 2) ≫ sq.lift = const x₁ := by
      calc stdSimplex.δ (0 : Fin 2) ≫ sq.lift
          = boundary.ι (0 : Fin 2) ≫ ((boundary 1).ι ≫ sq.lift) := by
            rw [← Category.assoc, boundary.ι_ι]
        _ = boundary.ι (0 : Fin 2) ≫ boundaryOneMap x₀ x₁ := by
            rw [sq.fac_left]
        _ = const x₁ := boundary_ι_zero_boundaryOneMap x₀ x₁
    calc X.δ (0 : Fin 2) (yonedaEquiv sq.lift)
        = yonedaEquiv (stdSimplex.δ (0 : Fin 2) ≫ sq.lift) :=
          (stdSimplex.yonedaEquiv_δ_comp sq.lift 0).symm
      _ = yonedaEquiv (const x₁ : Δ[0] ⟶ X) := by rw [h0]
      _ = x₁ := yonedaEquiv_const x₁
  refine ⟨Edge.mk (yonedaEquiv sq.lift) hsrc htgt, ?_⟩
  calc p.app (op ⦋1⦌) (yonedaEquiv sq.lift)
      = yonedaEquiv (yonedaEquiv.symm (p.app (op ⦋1⦌) (yonedaEquiv sq.lift))) :=
        (Equiv.apply_symm_apply _ _).symm
    _ = yonedaEquiv (sq.lift ≫ p) := by
        rw [← yonedaEquiv_symm_comp, Equiv.symm_apply_apply]
    _ = yonedaEquiv (yonedaEquiv.symm e'.edge) := by rw [sq.fac_right]
    _ = e'.edge := Equiv.apply_symm_apply _ _

/-- `2`-simplices lift along a trivial Kan fibration with prescribed
boundary: given three edges of `X` whose images are the faces of a
`2`-simplex `σ` of `Y`, there is a `2`-simplex of `X` over `σ` with
those faces, i.e. a `CompStruct` over the one determined by `σ`. This is
lifting against `∂Δ[2] ⟶ Δ[2]`. -/
theorem exists_compStruct_lift_of_rlp_I (hp : modelCategoryQuillen.I.rlp p)
    {x₀ x₁ x₂ : X _⦋0⦌}
    {e₀₁ : Edge x₀ x₁} {e₁₂ : Edge x₁ x₂} {e₀₂ : Edge x₀ x₂}
    (σ : Y _⦋2⦌)
    (h₂ : p.app (op ⦋1⦌) e₀₁.edge = Y.δ (2 : Fin 3) σ)
    (h₀ : p.app (op ⦋1⦌) e₁₂.edge = Y.δ (0 : Fin 3) σ)
    (h₁ : p.app (op ⦋1⦌) e₀₂.edge = Y.δ (1 : Fin 3) σ) :
    ∃ h : Edge.CompStruct e₀₁ e₁₂ e₀₂, p.app (op ⦋2⦌) h.simplex = σ := by
  have : HasLiftingProperty (boundary 2).ι p :=
    hasLiftingProperty_boundary_of_rlp_I hp 2
  have c₀ : stdSimplex.δ (1 : Fin 2) ≫ yonedaEquiv.symm e₀₁.edge =
      stdSimplex.δ (1 : Fin 2) ≫ yonedaEquiv.symm e₀₂.edge := by simp
  have c₁ : stdSimplex.δ (0 : Fin 2) ≫ yonedaEquiv.symm e₀₁.edge =
      stdSimplex.δ (1 : Fin 2) ≫ yonedaEquiv.symm e₁₂.edge := by simp
  have c₂ : stdSimplex.δ (0 : Fin 2) ≫ yonedaEquiv.symm e₀₂.edge =
      stdSimplex.δ (0 : Fin 2) ≫ yonedaEquiv.symm e₁₂.edge := by simp
  let top : (∂Δ[2] : SSet.{u}) ⟶ X :=
    boundary.twoDesc (yonedaEquiv.symm e₀₁.edge)
      (yonedaEquiv.symm e₀₂.edge) (yonedaEquiv.symm e₁₂.edge) c₀ c₁ c₂
  have hw : top ≫ p = (boundary 2).ι ≫ yonedaEquiv.symm σ := by
    apply boundary.hom_ext_two
    · calc boundary.ι (0 : Fin 3) ≫ top ≫ p
          = yonedaEquiv.symm e₁₂.edge ≫ p := by
            rw [← Category.assoc]; simp [top]
        _ = yonedaEquiv.symm (p.app (op ⦋1⦌) e₁₂.edge) :=
            yonedaEquiv_symm_comp e₁₂.edge p
        _ = yonedaEquiv.symm (Y.δ (0 : Fin 3) σ) := by rw [h₀]
        _ = stdSimplex.δ (0 : Fin 3) ≫ yonedaEquiv.symm σ :=
            (stdSimplex.δ_comp_yonedaEquiv_symm σ 0).symm
        _ = boundary.ι (0 : Fin 3) ≫ (boundary 2).ι ≫ yonedaEquiv.symm σ := by
            simp
    · calc boundary.ι (1 : Fin 3) ≫ top ≫ p
          = yonedaEquiv.symm e₀₂.edge ≫ p := by
            rw [← Category.assoc]; simp [top]
        _ = yonedaEquiv.symm (p.app (op ⦋1⦌) e₀₂.edge) :=
            yonedaEquiv_symm_comp e₀₂.edge p
        _ = yonedaEquiv.symm (Y.δ (1 : Fin 3) σ) := by rw [h₁]
        _ = stdSimplex.δ (1 : Fin 3) ≫ yonedaEquiv.symm σ :=
            (stdSimplex.δ_comp_yonedaEquiv_symm σ 1).symm
        _ = boundary.ι (1 : Fin 3) ≫ (boundary 2).ι ≫ yonedaEquiv.symm σ := by
            simp
    · calc boundary.ι (2 : Fin 3) ≫ top ≫ p
          = yonedaEquiv.symm e₀₁.edge ≫ p := by
            rw [← Category.assoc]; simp [top]
        _ = yonedaEquiv.symm (p.app (op ⦋1⦌) e₀₁.edge) :=
            yonedaEquiv_symm_comp e₀₁.edge p
        _ = yonedaEquiv.symm (Y.δ (2 : Fin 3) σ) := by rw [h₂]
        _ = stdSimplex.δ (2 : Fin 3) ≫ yonedaEquiv.symm σ :=
            (stdSimplex.δ_comp_yonedaEquiv_symm σ 2).symm
        _ = boundary.ι (2 : Fin 3) ≫ (boundary 2).ι ≫ yonedaEquiv.symm σ := by
            simp
  let sq : CommSq top (boundary 2).ι p (yonedaEquiv.symm σ) := ⟨hw⟩
  have hface : ∀ (i : Fin 3) (e : X _⦋1⦌),
      boundary.ι i ≫ top = yonedaEquiv.symm e →
      X.δ i (yonedaEquiv sq.lift) = e := by
    intro i e hi
    calc X.δ i (yonedaEquiv sq.lift)
        = yonedaEquiv (stdSimplex.δ i ≫ sq.lift) :=
          (stdSimplex.yonedaEquiv_δ_comp sq.lift i).symm
      _ = yonedaEquiv (boundary.ι i ≫ ((boundary 2).ι ≫ sq.lift)) := by
          rw [← boundary.ι_ι i, Category.assoc]
      _ = yonedaEquiv (yonedaEquiv.symm e) := by rw [sq.fac_left, hi]
      _ = e := Equiv.apply_symm_apply _ _
  have hd₂ : X.δ (2 : Fin 3) (yonedaEquiv sq.lift) = e₀₁.edge :=
    hface 2 e₀₁.edge (by simp [top])
  have hd₀ : X.δ (0 : Fin 3) (yonedaEquiv sq.lift) = e₁₂.edge :=
    hface 0 e₁₂.edge (by simp [top])
  have hd₁ : X.δ (1 : Fin 3) (yonedaEquiv sq.lift) = e₀₂.edge :=
    hface 1 e₀₂.edge (by simp [top])
  refine ⟨Edge.CompStruct.mk (yonedaEquiv sq.lift) hd₂ hd₀ hd₁, ?_⟩
  calc p.app (op ⦋2⦌) (yonedaEquiv sq.lift)
      = yonedaEquiv (yonedaEquiv.symm (p.app (op ⦋2⦌) (yonedaEquiv sq.lift))) :=
        (Equiv.apply_symm_apply _ _).symm
    _ = yonedaEquiv (sq.lift ≫ p) := by
        rw [← yonedaEquiv_symm_comp, Equiv.symm_apply_apply]
    _ = yonedaEquiv (yonedaEquiv.symm σ) := by rw [sq.fac_right]
    _ = σ := Equiv.apply_symm_apply _ _

/-- The homotopy-category functor preserves identities. -/
theorem mapHomotopyCategory_id (X : SSet.{u}) :
    mapHomotopyCategory (𝟙 X) = 𝟭 X.HomotopyCategory :=
  Truncated.HomotopyCategory.functor_ext (by simp [mapHomotopyCategory])
    (by cat_disch)

/-- The homotopy-category functor preserves composition. -/
theorem mapHomotopyCategory_comp {Z : SSet.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) :
    mapHomotopyCategory (f ≫ g) =
      mapHomotopyCategory f ⋙ mapHomotopyCategory g :=
  Truncated.HomotopyCategory.functor_ext (by simp [mapHomotopyCategory])
    (by cat_disch)

/-- A chosen strict section of a trivial Kan fibration. -/
private noncomputable def tfSection (hp : modelCategoryQuillen.I.rlp p) :
    Y ⟶ X :=
  (exists_section_of_rlp_I hp).choose

private lemma tfSection_comp (hp : modelCategoryQuillen.I.rlp p) :
    tfSection hp ≫ p = 𝟙 Y :=
  (exists_section_of_rlp_I hp).choose_spec

private lemma tfSectionComp_comp (hp : modelCategoryQuillen.I.rlp p) :
    (p ≫ tfSection hp) ≫ p = p := by
  rw [Category.assoc, tfSection_comp, Category.comp_id]

private lemma app_tfSection_app (hp : modelCategoryQuillen.I.rlp p)
    {n : ℕ} (t : X _⦋n⦌) :
    p.app (op ⦋n⦌) ((p ≫ tfSection hp).app (op ⦋n⦌) t) = p.app (op ⦋n⦌) t := by
  have h := ConcreteCategory.congr_hom
    (congr_app (tfSectionComp_comp hp) (op ⦋n⦌)) t
  simpa using h

private lemma exists_ηEdge (hp : modelCategoryQuillen.I.rlp p) (x : X _⦋0⦌) :
    ∃ e : Edge x ((p ≫ tfSection hp).app (op ⦋0⦌) x),
      p.app (op ⦋1⦌) e.edge = (Edge.id (p.app (op ⦋0⦌) x)).edge :=
  exists_edge_lift_of_rlp_I hp rfl (app_tfSection_app hp x) (Edge.id _)

private lemma exists_ξEdge (hp : modelCategoryQuillen.I.rlp p) (x : X _⦋0⦌) :
    ∃ e : Edge ((p ≫ tfSection hp).app (op ⦋0⦌) x) x,
      p.app (op ⦋1⦌) e.edge = (Edge.id (p.app (op ⦋0⦌) x)).edge :=
  exists_edge_lift_of_rlp_I hp (app_tfSection_app hp x) rfl (Edge.id _)

/-- A chosen edge from a vertex to its image under `p ≫ s`, lying over the
degenerate edge at its image in `Y`. -/
private noncomputable def ηEdge (hp : modelCategoryQuillen.I.rlp p)
    (x : X _⦋0⦌) : Edge x ((p ≫ tfSection hp).app (op ⦋0⦌) x) :=
  (exists_ηEdge hp x).choose

private lemma map_ηEdge (hp : modelCategoryQuillen.I.rlp p) (x : X _⦋0⦌) :
    p.app (op ⦋1⦌) (ηEdge hp x).edge = Y.σ 0 (p.app (op ⦋0⦌) x) := by
  simpa [ηEdge, Edge.id_edge] using (exists_ηEdge hp x).choose_spec

/-- A chosen edge back from the image under `p ≫ s` to the vertex, also
lying over the degenerate edge. -/
private noncomputable def ξEdge (hp : modelCategoryQuillen.I.rlp p)
    (x : X _⦋0⦌) : Edge ((p ≫ tfSection hp).app (op ⦋0⦌) x) x :=
  (exists_ξEdge hp x).choose

private lemma map_ξEdge (hp : modelCategoryQuillen.I.rlp p) (x : X _⦋0⦌) :
    p.app (op ⦋1⦌) (ξEdge hp x).edge = Y.σ 0 (p.app (op ⦋0⦌) x) := by
  simpa [ξEdge, Edge.id_edge] using (exists_ξEdge hp x).choose_spec

private lemma map_id_edge_app {x : X _⦋0⦌} :
    p.app (op ⦋1⦌) (Edge.id x).edge = (Edge.id (p.app (op ⦋0⦌) x)).edge := by
  rw [← Edge.map_edge, Edge.map_id]

/-- The chosen vertex edges are natural with respect to every edge: this
is where `2`-simplex lifting against `∂Δ[2] ⟶ Δ[2]` is used, via a
diagonal edge over the degenerate `2`-simplices `σ₀` and `σ₁` of the
image edge. -/
private lemma ηEdge_natural (hp : modelCategoryQuillen.I.rlp p)
    {x₀ x₁ : X _⦋0⦌} (ε : Edge x₀ x₁) :
    HomotopyCategory.homMk ε ≫ HomotopyCategory.homMk (ηEdge hp x₁) =
      HomotopyCategory.homMk (ηEdge hp x₀) ≫
        HomotopyCategory.homMk (ε.map (p ≫ tfSection hp)) := by
  obtain ⟨d, hd⟩ := exists_edge_lift_of_rlp_I hp rfl (app_tfSection_app hp x₁)
    (ε.map p)
  obtain ⟨hA, -⟩ := exists_compStruct_lift_of_rlp_I (e₀₁ := ε)
    (e₁₂ := ηEdge hp x₁) (e₀₂ := d) hp
    (Edge.CompStruct.compId (ε.map p)).simplex
    (by rw [Edge.CompStruct.d₂]; rfl)
    (by rw [map_ηEdge, Edge.CompStruct.d₀, Edge.id_edge])
    (by rw [hd, Edge.CompStruct.d₁])
  obtain ⟨hB, -⟩ := exists_compStruct_lift_of_rlp_I (e₀₁ := ηEdge hp x₀)
    (e₁₂ := ε.map (p ≫ tfSection hp)) (e₀₂ := d) hp
    (Edge.CompStruct.idComp (ε.map p)).simplex
    (by rw [map_ηEdge, Edge.CompStruct.d₂, Edge.id_edge])
    (by rw [show p.app (op ⦋1⦌) (ε.map (p ≫ tfSection hp)).edge =
            (ε.map p).edge from app_tfSection_app hp ε.edge,
        Edge.CompStruct.d₀])
    (by rw [hd, Edge.CompStruct.d₁])
  rw [HomotopyCategory.homMk_comp_homMk hA, HomotopyCategory.homMk_comp_homMk hB]

/-- The isomorphism at a vertex between the vertex and its image under
`p ≫ s`, built from the chosen edges; the compositions are identities by
`2`-simplex lifting over the doubly degenerate `2`-simplex. -/
private noncomputable def pointIso (hp : modelCategoryQuillen.I.rlp p)
    (x : X _⦋0⦌) :
    HomotopyCategory.mk x ≅
      HomotopyCategory.mk ((p ≫ tfSection hp).app (op ⦋0⦌) x) where
  hom := HomotopyCategory.homMk (ηEdge hp x)
  inv := HomotopyCategory.homMk (ξEdge hp x)
  hom_inv_id := by
    obtain ⟨h, -⟩ := exists_compStruct_lift_of_rlp_I (e₀₁ := ηEdge hp x)
      (e₁₂ := ξEdge hp x) (e₀₂ := Edge.id x) hp
      (Edge.CompStruct.idCompId (p.app (op ⦋0⦌) x)).simplex
      (by rw [map_ηEdge, Edge.CompStruct.d₂, Edge.id_edge])
      (by rw [map_ξEdge, Edge.CompStruct.d₀, Edge.id_edge])
      (by rw [map_id_edge_app, Edge.CompStruct.d₁])
    rw [HomotopyCategory.homMk_comp_homMk h, HomotopyCategory.homMk_id]
  inv_hom_id := by
    obtain ⟨h, -⟩ := exists_compStruct_lift_of_rlp_I (e₀₁ := ξEdge hp x)
      (e₁₂ := ηEdge hp x) (e₀₂ := Edge.id _) hp
      (Edge.CompStruct.idCompId (p.app (op ⦋0⦌) x)).simplex
      (by rw [map_ξEdge, Edge.CompStruct.d₂, Edge.id_edge])
      (by rw [map_ηEdge, Edge.CompStruct.d₀, Edge.id_edge])
      (by rw [map_id_edge_app, app_tfSection_app hp x, Edge.CompStruct.d₁])
    rw [HomotopyCategory.homMk_comp_homMk h, HomotopyCategory.homMk_id]

/-- The component isomorphisms of the natural isomorphism from the
identity on `X.HomotopyCategory` to the functor induced by `p ≫ s`. -/
private noncomputable def compIso (hp : modelCategoryQuillen.I.rlp p)
    (a : X.HomotopyCategory) :
    (𝟭 X.HomotopyCategory).obj a ≅
      (mapHomotopyCategory (p ≫ tfSection hp)).obj a :=
  HomotopyCategory.rec (motive := fun a ↦ (𝟭 X.HomotopyCategory).obj a ≅
      (mapHomotopyCategory (p ≫ tfSection hp)).obj a)
    (fun x ↦ pointIso hp x) a

private lemma compIso_mk_hom (hp : modelCategoryQuillen.I.rlp p)
    (x : X _⦋0⦌) :
    (compIso hp (HomotopyCategory.mk x)).hom =
      HomotopyCategory.homMk (ηEdge hp x) := rfl

/-- The natural isomorphism `𝟭 ≅ h(p ≫ s)` on the homotopy category of
`X`. Naturality for arbitrary morphisms reduces to naturality on edges
by `HomotopyCategory.hom_rec`. -/
private noncomputable def natIsoId (hp : modelCategoryQuillen.I.rlp p) :
    𝟭 X.HomotopyCategory ≅ mapHomotopyCategory (p ≫ tfSection hp) :=
  NatIso.ofComponents (compIso hp) (by
    intro a b f
    induction f using HomotopyCategory.hom_rec with
    | homMk ε =>
        rw [compIso_mk_hom, compIso_mk_hom, mapHomotopyCategory_map_homMk]
        exact ηEdge_natural hp ε
    | comp f g hf hg =>
        calc (𝟭 X.HomotopyCategory).map (f ≫ g) ≫ (compIso hp _).hom
            = ((𝟭 X.HomotopyCategory).map f ≫ (𝟭 X.HomotopyCategory).map g) ≫
                (compIso hp _).hom := by rw [Functor.map_comp]
          _ = (𝟭 X.HomotopyCategory).map f ≫
                ((𝟭 X.HomotopyCategory).map g ≫ (compIso hp _).hom) :=
              Category.assoc _ _ _
          _ = (𝟭 X.HomotopyCategory).map f ≫ (compIso hp _).hom ≫
                (mapHomotopyCategory (p ≫ tfSection hp)).map g := by rw [hg]
          _ = ((𝟭 X.HomotopyCategory).map f ≫ (compIso hp _).hom) ≫
                (mapHomotopyCategory (p ≫ tfSection hp)).map g :=
              (Category.assoc _ _ _).symm
          _ = ((compIso hp _).hom ≫
                (mapHomotopyCategory (p ≫ tfSection hp)).map f) ≫
                (mapHomotopyCategory (p ≫ tfSection hp)).map g := by rw [hf]
          _ = (compIso hp _).hom ≫
                (mapHomotopyCategory (p ≫ tfSection hp)).map (f ≫ g) := by
              rw [Functor.map_comp, Category.assoc])

/-- **Main theorem.** A trivial Kan fibration induces an equivalence of
homotopy categories. -/
theorem mapHomotopyCategory_isEquivalence_of_rlp_I
    (hp : modelCategoryQuillen.I.rlp p) :
    (mapHomotopyCategory p).IsEquivalence :=
  Functor.IsEquivalence.mk' (mapHomotopyCategory (tfSection hp))
    ((natIsoId hp) ≪≫ eqToIso (mapHomotopyCategory_comp p (tfSection hp)))
    (eqToIso (by
      rw [← mapHomotopyCategory_comp, tfSection_comp, mapHomotopyCategory_id]))

/-- The functor induced on homotopy categories by a trivial Kan
fibration is essentially surjective: indeed it is strictly surjective on
objects, since `p` is surjective on vertices and objects of the homotopy
category are the vertices. -/
theorem mapHomotopyCategory_essSurj_of_rlp_I
    (hp : modelCategoryQuillen.I.rlp p) :
    (mapHomotopyCategory p).EssSurj := by
  have := mapHomotopyCategory_isEquivalence_of_rlp_I hp
  infer_instance

/-- The functor induced on homotopy categories by a trivial Kan
fibration is full, by edge lifting against `∂Δ[1] ⟶ Δ[1]`. -/
theorem mapHomotopyCategory_full_of_rlp_I
    (hp : modelCategoryQuillen.I.rlp p) :
    (mapHomotopyCategory p).Full := by
  have := mapHomotopyCategory_isEquivalence_of_rlp_I hp
  infer_instance

/-- The functor induced on homotopy categories by a trivial Kan
fibration is faithful, by `2`-simplex lifting against `∂Δ[2] ⟶ Δ[2]`. -/
theorem mapHomotopyCategory_faithful_of_rlp_I
    (hp : modelCategoryQuillen.I.rlp p) :
    (mapHomotopyCategory p).Faithful := by
  have := mapHomotopyCategory_isEquivalence_of_rlp_I hp
  infer_instance

/-- Bundled form of the main theorem: the morphism
`SSet.hoFunctor.map p` in `Cat` is an equivalence. -/
theorem hoFunctor_map_isEquivalence_of_rlp_I
    (hp : modelCategoryQuillen.I.rlp p) :
    (hoFunctor.map p).toFunctor.IsEquivalence := by
  have h := mapHomotopyCategory_isEquivalence_of_rlp_I hp
  have heq : (hoFunctor.map p).toFunctor = mapHomotopyCategory p := rfl
  rwa [heq]

/-- Variant of the main theorem with the hypothesis stated as the right
lifting property against all monomorphisms. -/
theorem mapHomotopyCategory_isEquivalence_of_rlp_monomorphisms
    (hp : (MorphismProperty.monomorphisms SSet.{u}).rlp p) :
    (mapHomotopyCategory p).IsEquivalence := by
  have hpI : modelCategoryQuillen.I.rlp p := by
    rw [← rlp_monomorphisms]
    exact hp
  exact mapHomotopyCategory_isEquivalence_of_rlp_I hpI

end SSet
