-- Author: @toskua, Avocado
module

public import Mathlib.AlgebraicTopology.SimplicialSet.Finite
public import Mathlib.AlgebraicTopology.SimplicialSet.Degenerate
public import Mathlib.AlgebraicTopology.SimplicialSet.Simplices
public import Mathlib.AlgebraicTopology.SimplicialSet.NonDegenerateSimplices
public import Mathlib.AlgebraicTopology.SimplicialSet.Subcomplex

/-!
# Ambient cells contained in a finite subcomplex

Let `A` be a subcomplex of `X : SSet.{u}`. An ambient nondegenerate simplex belongs to `A`
exactly when its generated subcomplex is contained in `A`. Such simplices embed into the
nondegenerate simplices of `A` by retaining their representative and dimension.

If `A` is finite as a simplicial set, its nondegenerate simplices form a finite type. Hence
the ambient nondegenerate cells whose generated subcomplex lies in `A` form a finite type as
well.
-/

@[expose] public section

open CategoryTheory Simplicial

namespace SSet
namespace Subcomplex

universe u

variable {X : SSet.{u}} (A : X.Subcomplex)

/-- For `X : SSet.{u}` and `A : X.Subcomplex`, `AmbientCells A` is the subtype of ambient cells
`s∈X.N` with `s.subcomplex ≤ A`. Here `X.N` consists of nondegenerate simplices together with
their dimensions, and `s.subcomplex` is the subcomplex generated by the representative
simplex. -/
abbrev AmbientCells := { s : X.N // s.subcomplex ≤ A }

/-- Let `A` be a subcomplex of `X`. The map `ambientCellsFun A : AmbientCells A → (A : SSet).N`
retains the
cell's dimension and representative simplex, now equipped with membership in `A`.
Nondegeneracy is reflected by the subcomplex inclusion, so this is a nondegenerate simplex of
`A`. -/
def ambientCellsFun (a : AmbientCells A) : (A : SSet.{u}).N :=
  SSet.N.mk (X := (A : SSet.{u}))
    ⟨a.val.simplex, (Subcomplex.ofSimplex_le_iff _ _).mp a.property⟩
    ((Subcomplex.mem_nonDegenerate_iff A _).mpr a.val.nonDegenerate)

/-- For a subcomplex `A` of a simplicial set `X`, `ambientCellsEmbedding A : AmbientCells A ↪ (A :
SSet).N`
sends a contained nondegenerate ambient cell to the same simplex and dimension in `A`.
Equality in `(A : SSet).N` implies equality of the ambient cells, so this map is injective. -/
def ambientCellsEmbedding : AmbientCells A ↪ (A : SSet.{u}).N where
  toFun := ambientCellsFun A
  inj' a b h := by
    have hS : (ambientCellsFun A a).toS = (ambientCellsFun A b).toS := by
      exact (SSet.N.ext_iff _ _).mp h
    have hmap : S.map A.ι (ambientCellsFun A a).toS =
        S.map A.ι (ambientCellsFun A b).toS := by
      rw [hS]
    have hab : a.val.toS = b.val.toS := by
      have e1 : S.map A.ι (ambientCellsFun A a).toS = a.val.toS := rfl
      have e2 : S.map A.ι (ambientCellsFun A b).toS = b.val.toS := rfl
      rw [e1] at hmap
      rw [e2] at hmap
      exact hmap
    have hN : a.val = b.val := (SSet.N.ext_iff _ _).mpr hab
    exact Subtype.ext hN

variable [SSet.Finite (A : SSet.{u})]

instance : Finite (AmbientCells A) :=
  Finite.of_injective (ambientCellsEmbedding A) (ambientCellsEmbedding A).injective

end Subcomplex
end SSet
