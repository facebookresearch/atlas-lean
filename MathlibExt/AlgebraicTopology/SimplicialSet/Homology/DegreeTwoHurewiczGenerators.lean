module

public import MathlibExt.AlgebraicTopology.SimplicialSet.Homology.DegreeTwoHurewiczMap
public import
  MathlibExt.AlgebraicTopology.SimplicialSet.ModelCategory.MinimalFibration.MinimalOneReduced
public import Mathlib.Algebra.Category.Grp.Adjunctions
public import Mathlib.Algebra.Category.Grp.EpiMono

/-!
# Free generators and surjectivity of the degree two Hurewicz map

When every edge of a Kan complex is the degenerate edge at a chosen vertex,
normalized degree one vanishes.  Consequently every normalized two-chain is a
cycle and the canonical map from normalized two-chains to `H₂` is epic.

Normalized two-chains are generated by nondegenerate two-simplices.  We make
this precise with a map from the free abelian group, lift its elements to words
in pointed two-simplices, and compare the word evaluation with the native
Hurewicz homomorphism.  This proves surjectivity only.  No injectivity,
commutativity of `π₂`, or Hurewicz equivalence is asserted.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits Simplicial
open scoped Simplicial

universe u

namespace SSet

/-- If all edges are the degenerate edge at `x`, normalized integral degree
one is zero. -/
theorem normalizedDegreeOne_isZero_of_edges_degenerate
    {X : SSet.{u}} (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x) :
    CategoryTheory.Limits.IsZero
      ((X.normalizedChainComplex
        (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})).X 1) := by
  rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
  apply X.normalizedChainComplex_hom_ext
  intro s hs
  have hdeg : s ∈ X.degenerate 1 := by
    rw [hedge s]
    simp only [SSet.degenerate_eq_iUnion_range_σ, Set.mem_iUnion,
      Set.mem_range]
    exact ⟨0, x, rfl⟩
  exact (hs hdeg).elim

/-- If every edge is degenerate, every normalized two-chain is a cycle; this
is the resulting canonical map from normalized two-chains to normalized
`H₂`. -/
noncomputable def normalizedTwoToHomology
    {X : SSet.{u}} (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x) :
    (X.normalizedChainComplex
        (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})).X 2 ⟶
      (X.normalizedChainComplex
        (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})).homology 2 := by
  let K := X.normalizedChainComplex
    (AlgebraicTopology.singularIntegralCoefficients : AddCommGrpCat.{u})
  have hz := normalizedDegreeOne_isZero_of_edges_degenerate x hedge
  have hnext : (ComplexShape.down ℕ).next 2 = 1 := by simp
  exact K.liftCycles (𝟙 _) 1 hnext (hz.eq_of_tgt _ _) ≫ K.homologyπ 2

/-- The canonical map from normalized two-chains to `H₂` is epic when
normalized degree one vanishes. -/
noncomputable instance normalizedTwoToHomology_epi
    {X : SSet.{u}} (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x) :
    Epi (normalizedTwoToHomology x hedge) := by
  let K := X.normalizedChainComplex
    (AlgebraicTopology.singularIntegralCoefficients : AddCommGrpCat.{u})
  have hz := normalizedDegreeOne_isZero_of_edges_degenerate x hedge
  have hnext : (ComplexShape.down ℕ).next 2 = 1 := by simp
  let l := K.liftCycles (𝟙 (K.X 2)) 1 hnext (hz.eq_of_tgt _ _)
  have hl : K.iCycles 2 ≫ l = 𝟙 _ := by
    apply (cancel_mono (K.iCycles 2)).mp
    rw [Category.assoc, HomologicalComplex.liftCycles_i,
      Category.id_comp, Category.comp_id]
  let _ : IsSplitEpi l := IsSplitEpi.mk' ⟨K.iCycles 2, hl⟩
  change Epi (l ≫ K.homologyπ 2)
  infer_instance

/-- Exact simplex-generator formula for the all-cycles map to normalized
`H₂`. -/
theorem ιNormalizedChainComplex_comp_normalizedTwoToHomology
    {X : SSet.{u}} (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x)
    (s : X _⦋2⦌) :
    X.ιNormalizedChainComplex
        (R := (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})) s ≫ normalizedTwoToHomology x hedge =
      pointedTwoHomologyClass
        (MinimalFibration.ptTwoOfSimplexOfEdgesDegenerate x hedge s) := by
  let K := X.normalizedChainComplex
    (AlgebraicTopology.singularIntegralCoefficients : AddCommGrpCat.{u})
  let p := MinimalFibration.ptTwoOfSimplexOfEdgesDegenerate x hedge s
  change X.ιNormalizedChainComplex s ≫
      (K.liftCycles (𝟙 _) 1 (by simp)
        ((normalizedDegreeOne_isZero_of_edges_degenerate x hedge).eq_of_tgt _ _) ≫
          K.homologyπ 2) = pointedTwoCycle p ≫ K.homologyπ 2
  rw [← Category.assoc, HomologicalComplex.comp_liftCycles]
  congr 1
  apply (cancel_mono (K.iCycles 2)).mp
  rw [HomologicalComplex.liftCycles_i, pointedTwoCycle_i]
  rw [Category.comp_id]
  change X.ιNormalizedChainComplex s = pointedTwoGenerator p
  simp [pointedTwoGenerator, p,
    MinimalFibration.ptTwoOfSimplexOfEdgesDegenerate]

/-- The free abelian group on nondegenerate two-simplices maps onto normalized
two-chains by sending a basis generator to its normalized simplex generator. -/
noncomputable def normalizedTwoFreeAddMap (X : SSet.{u}) :
    AddCommGrpCat.of (FreeAbelianGroup (X.nonDegenerate 2)) ⟶
      (X.normalizedChainComplex
        (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})).X 2 :=
  AddCommGrpCat.ofHom <| FreeAbelianGroup.lift fun s =>
    X.ιNormalizedChainComplex
      (R := (AlgebraicTopology.singularIntegralCoefficients :
        AddCommGrpCat.{u})) s.val (ULift.up 1)

/-- Formula for a free nondegenerate-simplex generator. -/
@[simp]
theorem normalizedTwoFreeAddMap_of (X : SSet.{u})
    (s : X.nonDegenerate 2) :
    normalizedTwoFreeAddMap X (FreeAbelianGroup.of s) =
      X.ιNormalizedChainComplex
        (R := (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})) s.val (ULift.up 1) := by
  change FreeAbelianGroup.lift _ (FreeAbelianGroup.of s) = _
  exact FreeAbelianGroup.lift_apply_of _ _

/-- Nondegenerate two-simplex generators jointly generate normalized
two-chains. -/
noncomputable instance normalizedTwoFreeAddMap_epi (X : SSet.{u}) :
    Epi (normalizedTwoFreeAddMap X) := by
  constructor
  intro Z f g hfg
  apply X.normalizedChainComplex_hom_ext
  intro s hs
  ext z
  obtain ⟨z⟩ := z
  have hmap : normalizedTwoFreeAddMap X
        (z • FreeAbelianGroup.of ⟨s, hs⟩) =
      X.ιNormalizedChainComplex
        (R := (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})) s (ULift.up z) := by
    rw [map_zsmul, normalizedTwoFreeAddMap_of]
    rw [← map_zsmul]
    congr 1
    apply ULift.ext
    simp
  have h := congrArg
    (fun k => k (z • FreeAbelianGroup.of ⟨s, hs⟩)) hfg
  change f (normalizedTwoFreeAddMap X
      (z • FreeAbelianGroup.of ⟨s, hs⟩)) =
    g (normalizedTwoFreeAddMap X
      (z • FreeAbelianGroup.of ⟨s, hs⟩)) at h
  rw [hmap] at h
  change f (ConcreteCategory.hom
      (X.ιNormalizedChainComplex
        (R := (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})) s) (ULift.up z)) =
    g (ConcreteCategory.hom
      (X.ιNormalizedChainComplex
        (R := (AlgebraicTopology.singularIntegralCoefficients :
          AddCommGrpCat.{u})) s) (ULift.up z))
  exact h

/-- A word in nondegenerate two-simplices, evaluated in normalized
two-chains. -/
noncomputable def normalizedTwoWordMap (X : SSet.{u}) :
    FreeGroup (X.nonDegenerate 2) →*
      Multiplicative
        ((X.normalizedChainComplex
          (AlgebraicTopology.singularIntegralCoefficients :
            AddCommGrpCat.{u})).X 2) :=
  (normalizedTwoFreeAddMap X).hom.toMultiplicative.comp
    Abelianization.of

/-- Every normalized two-chain is represented by a word in nondegenerate
two-simplices. -/
theorem normalizedTwoWordMap_surjective (X : SSet.{u}) :
    Function.Surjective (normalizedTwoWordMap X) :=
  (AddCommGrpCat.epi_iff_surjective (normalizedTwoFreeAddMap X)).mp
      inferInstance |>.comp
    (QuotientGroup.mk'_surjective _)

/-- Evaluation of the word map on a free generator. -/
@[simp]
theorem normalizedTwoWordMap_of (X : SSet.{u})
    (s : X.nonDegenerate 2) :
    normalizedTwoWordMap X (FreeGroup.of s) =
      Multiplicative.ofAdd
        (X.ιNormalizedChainComplex
          (R := (AlgebraicTopology.singularIntegralCoefficients :
            AddCommGrpCat.{u})) s.val (ULift.up 1)) := by
  change normalizedTwoFreeAddMap X (FreeAbelianGroup.of s) = _
  exact normalizedTwoFreeAddMap_of X s

/-- Evaluate a word in nondegenerate two-simplices in the native second
homotopy group using the canonical pointed boundary supplied by the
edge-degeneracy hypothesis. -/
noncomputable def degreeTwoPiWordMap
    {X : SSet.{u}} [KanComplex X] (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x) :
    FreeGroup (X.nonDegenerate 2) →* SSet.KanComplex.π 2 X x :=
  FreeGroup.lift fun s => SSet.KanComplex.π.mk
    (MinimalFibration.ptTwoOfSimplexOfEdgesDegenerate x hedge s.val)

/-- Evaluation of the native word map on a free generator. -/
@[simp]
theorem degreeTwoPiWordMap_of
    {X : SSet.{u}} [KanComplex X] (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x)
    (s : X.nonDegenerate 2) :
    degreeTwoPiWordMap x hedge (FreeGroup.of s) =
      SSet.KanComplex.π.mk
        (MinimalFibration.ptTwoOfSimplexOfEdgesDegenerate x hedge s.val) := by
  simp [degreeTwoPiWordMap]

/-- Word evaluation commutes with the native Hurewicz homomorphism and the
canonical map from normalized two-chains to homology. -/
theorem degreeTwoHurewicz_word_compatibility
    {X : SSet.{u}} [KanComplex X] (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x) :
    (degreeTwoHurewiczElementMulHom x).comp
        (degreeTwoPiWordMap x hedge) =
      (normalizedTwoToHomology x hedge).hom.toMultiplicative.comp
        (normalizedTwoWordMap X) := by
  apply FreeGroup.lift.symm.injective
  funext s
  change ((degreeTwoHurewiczElementMulHom x).comp
      (degreeTwoPiWordMap x hedge)) (FreeGroup.of s) =
    ((normalizedTwoToHomology x hedge).hom.toMultiplicative.comp
      (normalizedTwoWordMap X)) (FreeGroup.of s)
  simp only [MonoidHom.comp_apply, degreeTwoPiWordMap_of,
    degreeTwoHurewiczElementMulHom_mk, normalizedTwoWordMap_of]
  change pointedTwoHomologyClass
      (MinimalFibration.ptTwoOfSimplexOfEdgesDegenerate x hedge s.val)
        (ULift.up 1) =
    normalizedTwoToHomology x hedge
      (ConcreteCategory.hom
        (X.ιNormalizedChainComplex
          (R := (AlgebraicTopology.singularIntegralCoefficients :
            AddCommGrpCat.{u})) s.val) (ULift.up 1))
  rw [← ιNormalizedChainComplex_comp_normalizedTwoToHomology]
  rfl

/-- If every edge is degenerate at the chosen vertex, the native degree-two
Hurewicz homomorphism is surjective. -/
theorem degreeTwoHurewiczElementMulHom_surjective
    {X : SSet.{u}} [KanComplex X] (x : X _⦋0⦌)
    (hedge : ∀ s : X _⦋1⦌, s = X.σ 0 x) :
    Function.Surjective (degreeTwoHurewiczElementMulHom x) := by
  have hT : Function.Surjective (normalizedTwoToHomology x hedge) :=
    (AddCommGrpCat.epi_iff_surjective
      (normalizedTwoToHomology x hedge)).mp inferInstance
  have hcomp : Function.Surjective
      ((normalizedTwoToHomology x hedge).hom.toMultiplicative.comp
        (normalizedTwoWordMap X)) :=
    hT.comp (normalizedTwoWordMap_surjective X)
  intro y
  obtain ⟨w, hw⟩ := hcomp y
  refine ⟨degreeTwoPiWordMap x hedge w, ?_⟩
  have heq := congrArg (fun F => F w)
    (degreeTwoHurewicz_word_compatibility x hedge)
  exact heq.trans hw

end SSet
