module

public import Mathlib.CategoryTheory.Groupoid.FreeGroupoidOfCategory
public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplex
public import Mathlib.CategoryTheory.Limits.Presheaf
public import Mathlib.CategoryTheory.Functor.KanExtension.Dense

/-!
# The full free-groupoid simplex family

The ordinal categories retain their original lifted vertices and order maps.
Applying the native free groupoid of a category and the full nerve gives the
cosimplicial family used by Joyal–Tierney. The k adjunction is its native
extension along the lifted Yoneda embedding.
-/

@[expose] public section

open CategoryTheory Opposite
open scoped Simplicial

universe u

namespace SSet.FreeGroupoidSimplex

/-- The original finite ordinal categories, lifted to the value universe. -/
def ordinal : SimplexCategory ⥤ Cat.{u, u} :=
  SimplexCategory.toPartOrd.{u} ⋙ forget₂ PartOrd Preord ⋙ preordToCat

/-- The full nerves of the groupoids freely generated by the ordinal categories. -/
noncomputable def J : SimplexCategory ⥤ SSet.{u} :=
  ordinal.{u} ⋙ Grpd.free ⋙ Grpd.forgetToCat ⋙ nerveFunctor

/-- Standard simplices are naturally the nerves of the original ordinal categories. -/
def ordinalNerveIso : SSet.stdSimplex.{u} ≅ ordinal.{u} ⋙ nerveFunctor :=
  NatIso.ofComponents (fun n => SSet.stdSimplex.isoNerve n.len) (by
    intro n m f
    ext k x
    rfl)

/-- The original simplex inclusion induced by the native free/forget unit. -/
noncomputable def simplexInclusion : SSet.stdSimplex.{u} ⟶ J.{u} :=
  ordinalNerveIso.{u}.hom ≫
    Functor.whiskerRight
      (Functor.whiskerLeft ordinal.{u} Grpd.freeForgetAdjunction.unit) nerveFunctor

/-- The actual left Kan extension of the full free-groupoid simplex family. -/
noncomputable def kFunctor : SSet.{u} ⥤ SSet.{u} :=
  SSet.stdSimplex.{u}.leftKanExtension J.{u}

/-- The actual right adjoint, with simplices the lifted Hom sets from J[n]. -/
noncomputable def kRightFunctor : SSet.{u} ⥤ SSet.{u} :=
  Presheaf.restrictedULiftYoneda.{0} J.{u}

set_option backward.isDefEq.respectTransparency false in
/-- The native lifted-Yoneda-extension adjunction k_! ⊣ k^!. -/
noncomputable def kAdjunction : kFunctor.{u} ⊣ kRightFunctor.{u} :=
  Presheaf.uliftYonedaAdjunction.{0}
    (SSet.stdSimplex.{u}.leftKanExtension J.{u})
    (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u})

/-- The full natural representable comparison k_!(Δ[n]) ≅ J[n]. -/
noncomputable def kRepresentableIso : SSet.stdSimplex.{u} ⋙ kFunctor.{u} ≅ J.{u} :=
  Presheaf.isExtensionAlongULiftYoneda J.{u}

/-- Groupoid completion as the extension of the original simplex inclusions. -/
noncomputable def kComparison : 𝟭 SSet.{u} ⟶ kFunctor.{u} := by
  letI : (SSet.stdSimplex.{u}).IsDense := by
    change (uliftYoneda.{u} (C := SimplexCategory)).IsDense
    infer_instance
  exact (Functor.IsDense.leftKanExtensionIso SSet.stdSimplex.{u}).inv ≫
    SSet.stdSimplex.{u}.lan.map simplexInclusion.{u}

/-- Every original simplex operator acts through the full representable comparison. -/
@[reassoc]
theorem kRepresentableIso_hom_naturality {n m : SimplexCategory} (f : n ⟶ m) :
    kFunctor.map (SSet.stdSimplex.map f) ≫ kRepresentableIso.hom.app m =
      kRepresentableIso.hom.app n ≫ J.{u}.map f :=
  kRepresentableIso.hom.naturality f

/-- The original adjunction retains its left triangle on every simplicial set. -/
theorem kAdjunction_left_triangle (X : SSet.{u}) :
    kFunctor.map (kAdjunction.unit.app X) ≫ kAdjunction.counit.app (kFunctor.obj X) =
      𝟙 (kFunctor.obj X) :=
  kAdjunction.left_triangle_components X

/-- The original adjunction retains its right triangle on every simplicial set. -/
theorem kAdjunction_right_triangle (X : SSet.{u}) :
    kAdjunction.unit.app (kRightFunctor.obj X) ≫ kRightFunctor.map (kAdjunction.counit.app X) =
      𝟙 (kRightFunctor.obj X) :=
  kAdjunction.right_triangle_components X

/-- The original inclusion at zero is invertible: the zero ordinal is already a groupoid. -/
instance simplexInclusion_zero_isIso : IsIso (simplexInclusion.{u}.app ⦋0⦌) := by
  let : Groupoid (ULift.{u} (Fin 1)) :=
    { (inferInstance : Category (ULift.{u} (Fin 1))) with
      inv := fun {_ _} _ => eqToHom (Subsingleton.elim _ _)
      inv_comp := fun _ => Subsingleton.elim _ _
      comp_inv := fun _ => Subsingleton.elim _ _ }
  have hcat : IsIso (Grpd.freeForgetAdjunction.unit.app (ordinal.{u}.obj ⦋0⦌)) := by
    change IsIso ((reflectorAdjunction Grpd.forgetToCat).unit.app
      (Grpd.forgetToCat.obj (Grpd.of (ULift.{u} (Fin 1)))))
    infer_instance
  have hmap : IsIso (nerveFunctor.{u, u}.map
      (Grpd.freeForgetAdjunction.unit.app (ordinal.{u}.obj ⦋0⦌))) := by
    infer_instance
  have hstd : IsIso (SSet.stdSimplex.isoNerve.{u} 0).hom := by
    infer_instance
  change IsIso ((SSet.stdSimplex.isoNerve 0).hom ≫
    nerveFunctor.{u, u}.map (Grpd.freeForgetAdjunction.unit.app (ordinal.{u}.obj ⦋0⦌)))
  exact IsIso.comp_isIso' hstd hmap

/-- J[0] is the standard zero simplex through the actual original inclusion. -/
noncomputable def zeroIso : (Δ[0] : SSet.{u}) ≅ J.obj ⦋0⦌ :=
  asIso (simplexInclusion.app ⦋0⦌)

/-- The zero-simplex comparison uses the actual original unit map. -/
@[simp]
theorem zeroIso_hom : zeroIso.{u}.hom = simplexInclusion.app ⦋0⦌ := rfl

/-- The actual k functor sends the standard zero simplex to the same standard zero simplex. -/
noncomputable def kZeroIso : kFunctor.obj (Δ[0] : SSet.{u}) ≅ Δ[0] :=
  kRepresentableIso.app ⦋0⦌ ≪≫ zeroIso.symm

/-- The original simplex inclusion and extension unit satisfy the zero comparison equation. -/
@[reassoc]
theorem kZeroIso_inclusion :
    simplexInclusion.app ⦋0⦌ ≫ kRepresentableIso.inv.app ⦋0⦌ ≫ kZeroIso.{u}.hom = 𝟙 _ := by
  simp [kZeroIso, zeroIso]

/-- An original ordinal vertex in the full groupoid nerve. -/
noncomputable def vertex (n : SimplexCategory) (i : Fin (n.len + 1)) :
    (J.{u}.obj n).obj (op ⦋0⦌) :=
  ComposableArrows.mk₀ (FreeGroupoid.mk (ULift.up i))

/-- Every original simplex operator acts on its original groupoid vertex. -/
theorem J_map_vertex {n m : SimplexCategory} (f : n ⟶ m) (i : Fin (n.len + 1)) :
    (J.{u}.map f).app (op ⦋0⦌) (vertex n i) = vertex m (f i) := by
  change (nerveMap (FreeGroupoid.map (ordinal.{u}.map f).toFunctor)).app
      (op ⦋0⦌) (ComposableArrows.mk₀ (FreeGroupoid.mk (ULift.up i))) = _
  exact nerveMap_app_mk₀ _ _

set_option backward.isDefEq.respectTransparency false in
/-- The original adjunction Hom equivalence in full lifted-Yoneda coordinates. -/
theorem kAdjunction_homEquiv_app {P Q : SSet.{u}} (f : kFunctor.obj P ⟶ Q)
    (n : SimplexCategory) (x : P.obj (op n)) :
    ULift.down (((kAdjunction.homEquiv P Q) f).app (op n) x) =
      kRepresentableIso.inv.app n ≫ kFunctor.map (SSet.yonedaEquiv.symm x) ≫ f := by
  let : kFunctor.{u}.IsLeftKanExtension
      (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u}) := by
    change (SSet.stdSimplex.{u}.leftKanExtension J.{u}).IsLeftKanExtension
      (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u})
    infer_instance
  have h := @Presheaf.uliftYonedaAdjunction_homEquiv_app.{0, 0, u, 0, u + 1}
    SimplexCategory _ (SSet.{u}) _ J.{u} _
    kFunctor.{u} (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u}) _ P Q f (op n) x
  exact congrArg ULift.down h

set_option backward.isDefEq.respectTransparency false in
/-- The actual adjunction unit retains the original representable map. -/
theorem kAdjunction_unit_app (P : SSet.{u}) (n : SimplexCategory) (x : P.obj (op n)) :
    ULift.down ((kAdjunction.unit.app P).app (op n) x) =
      kRepresentableIso.inv.app n ≫ kFunctor.map (SSet.yonedaEquiv.symm x) := by
  let : kFunctor.{u}.IsLeftKanExtension
      (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u}) := by
    change (SSet.stdSimplex.{u}.leftKanExtension J.{u}).IsLeftKanExtension
      (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u})
    infer_instance
  have h := @Presheaf.uliftYonedaAdjunction_unit_app_app.{0, 0, u, 0, u + 1}
    SimplexCategory _ (SSet.{u}) _ J.{u} _
    kFunctor.{u} (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u}) _ P (op n) x
  exact congrArg ULift.down h

/-- Completion agrees with the original inclusion on every representable. -/
theorem kComparison_representable (n : SimplexCategory) :
    kComparison.app (SSet.stdSimplex.obj n) ≫ kRepresentableIso.{u}.hom.app n =
      simplexInclusion.app n := by
  let : (SSet.stdSimplex.{u}).IsDense := by
    change (uliftYoneda.{u} (C := SimplexCategory)).IsDense
    infer_instance
  let e := Functor.IsDense.leftKanExtensionIso SSet.stdSimplex.{u}
  have he : e.inv.app (SSet.stdSimplex.obj n) =
      (SSet.stdSimplex.leftKanExtensionUnit SSet.stdSimplex).app n := by
    apply (cancel_mono (e.hom.app (SSet.stdSimplex.obj n))).1
    change (e.app (SSet.stdSimplex.{u}.obj n)).inv ≫
      (e.app (SSet.stdSimplex.{u}.obj n)).hom = _
    rw [(e.app (SSet.stdSimplex.{u}.obj n)).inv_hom_id]
    exact (Functor.IsDense.leftKanExtensionUnit_leftKanExtensionIso_hom_app
      SSet.stdSimplex.{u} n).symm
  have hn := congrArg (fun a => a.app n)
    (SSet.stdSimplex.{u}.lanUnit.naturality simplexInclusion.{u})
  change simplexInclusion.{u}.app n ≫ (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u}).app n =
      (SSet.stdSimplex.{u}.leftKanExtensionUnit SSet.stdSimplex.{u}).app n ≫
        (SSet.stdSimplex.{u}.lan.map simplexInclusion.{u}).app (SSet.stdSimplex.{u}.obj n) at hn
  change e.inv.app (SSet.stdSimplex.obj n) ≫
      (SSet.stdSimplex.{u}.lan.map simplexInclusion.{u}).app (SSet.stdSimplex.{u}.obj n) ≫
      kRepresentableIso.{u}.hom.app n = _
  rw [he]
  calc
    _ = ((SSet.stdSimplex.{u}.leftKanExtensionUnit SSet.stdSimplex.{u}).app n ≫
        (SSet.stdSimplex.{u}.lan.map simplexInclusion.{u}).app (SSet.stdSimplex.{u}.obj n)) ≫
          kRepresentableIso.{u}.hom.app n := (Category.assoc _ _ _).symm
    _ = (simplexInclusion.{u}.app n ≫
        (SSet.stdSimplex.{u}.leftKanExtensionUnit J.{u}).app n) ≫
          kRepresentableIso.{u}.hom.app n :=
        congrArg (fun a => a ≫ kRepresentableIso.{u}.hom.app n) hn.symm
    _ = _ := by
      simp [kRepresentableIso, Presheaf.isExtensionAlongULiftYoneda,
        SSet.stdSimplex, Category.assoc]

/-- Completion of the original zero simplex followed by its chosen comparison is identity. -/
theorem kZeroIso_comparison :
    kComparison.app (Δ[0] : SSet.{u}) ≫ kZeroIso.hom = 𝟙 _ := by
  change kComparison.app (Δ[0] : SSet.{u}) ≫
    (kRepresentableIso.hom.app ⦋0⦌ ≫ zeroIso.inv) = _
  rw [← Category.assoc, kComparison_representable]
  exact zeroIso.hom_inv_id
end SSet.FreeGroupoidSimplex
