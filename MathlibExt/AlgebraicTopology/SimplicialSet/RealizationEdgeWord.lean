module

public import
  MathlibExt.AlgebraicTopology.SimplicialSet.RealizationFundamentalGroupoid

/-!
# Indexed edge words and their realized paths

An indexed realization edge word presents a morphism of the simplicial
fundamental groupoid using actual simplicial edges, identities, formal
inverses, and typed composition. It has both a combinatorial interpretation
as a fundamental-groupoid morphism and a topological interpretation as an
endpoint-fixed path between the corresponding realized objects.

Every fundamental-groupoid morphism has such a presentation, and the direct
realization functor maps the word morphism to the endpoint-fixed path-homotopy
class of its realized path. A conditional theorem reduces functor faithfulness
to reflection of endpoint-fixed homotopies between same-endpoint word paths.

This file proves no approximation theorem and makes no unconditional
fullness, faithfulness, unit, invariance, Kan, or model-category claim.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u

open CategoryTheory
open scoped Simplicial

namespace SSet

/-- Typed words generated by actual simplicial edges, identities, formal
inverses, and composition. -/
inductive RealizationEdgeWord (X : SSet.{u}) :
    SSet.FundamentalGroupoid X → SSet.FundamentalGroupoid X → Type u where
| edge (x y : X _⦋0⦌) (e : SSet.Edge (X := X) x y) :
    RealizationEdgeWord X (SSet.FundamentalGroupoid.mk x)
      (SSet.FundamentalGroupoid.mk y)
| identity (a : SSet.FundamentalGroupoid X) :
    RealizationEdgeWord X a a
| inverse {a b : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) : RealizationEdgeWord X b a
| compose {a b c : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) (w' : RealizationEdgeWord X b c) :
    RealizationEdgeWord X a c

namespace RealizationEdgeWord

variable {X : SSet.{u}}

/-- The fundamental-groupoid morphism represented by an edge word. -/
def toHom {a b : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) : a ⟶ b :=
  @RealizationEdgeWord.rec X (fun a b _ => a ⟶ b)
    (fun _ _ e => SSet.FundamentalGroupoid.homMk e)
    (fun a => 𝟙 a)
    (fun {_ _} _ f => inv f)
    (fun {_ _ _} _ _ f g => f ≫ g) a b w

@[simp]
theorem toHom_edge (x y : X _⦋0⦌) (e : SSet.Edge (X := X) x y) :
    (RealizationEdgeWord.edge x y e).toHom =
      SSet.FundamentalGroupoid.homMk e :=
  rfl

@[simp]
theorem toHom_identity (a : SSet.FundamentalGroupoid X) :
    (RealizationEdgeWord.identity a).toHom = 𝟙 a :=
  rfl

@[simp]
theorem toHom_inverse {a b : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) :
    w.inverse.toHom = inv w.toHom :=
  rfl

@[simp]
theorem toHom_compose {a b c : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) (w' : RealizationEdgeWord X b c) :
    (w.compose w').toHom = w.toHom ≫ w'.toHom :=
  rfl

/-- The endpoint-fixed topological path represented by an edge word. -/
noncomputable def realizedPath {a b : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) :
    _root_.Path ((SSet.realizationFundamentalGroupoidFunctor X).obj a).as
      ((SSet.realizationFundamentalGroupoidFunctor X).obj b).as :=
  @RealizationEdgeWord.rec X
    (fun a b _ => _root_.Path
      ((SSet.realizationFundamentalGroupoidFunctor X).obj a).as
      ((SSet.realizationFundamentalGroupoidFunctor X).obj b).as)
    (fun _ _ e => TopCat.pathEquiv (SSet.realizedEdgePath e))
    (fun a => _root_.Path.refl
      ((SSet.realizationFundamentalGroupoidFunctor X).obj a).as)
    (fun {_ _} _ p => p.symm)
    (fun {_ _ _} _ _ p q => p.trans q) a b w

@[simp]
theorem realizedPath_edge (x y : X _⦋0⦌)
    (e : SSet.Edge (X := X) x y) :
    (RealizationEdgeWord.edge x y e).realizedPath =
      TopCat.pathEquiv (SSet.realizedEdgePath e) :=
  rfl

@[simp]
theorem realizedPath_identity (a : SSet.FundamentalGroupoid X) :
    (RealizationEdgeWord.identity a).realizedPath =
      _root_.Path.refl
        ((SSet.realizationFundamentalGroupoidFunctor X).obj a).as :=
  rfl

@[simp]
theorem realizedPath_inverse {a b : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) :
    w.inverse.realizedPath = w.realizedPath.symm :=
  rfl

@[simp]
theorem realizedPath_compose {a b c : SSet.FundamentalGroupoid X}
    (w : RealizationEdgeWord X a b) (w' : RealizationEdgeWord X b c) :
    (w.compose w').realizedPath =
      w.realizedPath.trans w'.realizedPath :=
  rfl

/-- Every morphism of the simplicial fundamental groupoid is represented by
an indexed edge word with the same source and target. -/
theorem exists_word {a b : SSet.FundamentalGroupoid X} (f : a ⟶ b) :
    ∃ w : RealizationEdgeWord X a b, w.toHom = f := by
  induction f using SSet.FundamentalGroupoid.hom_rec with
  | homMk e => exact ⟨.edge _ _ e, rfl⟩
  | inv f hf =>
      obtain ⟨w, rfl⟩ := hf
      exact ⟨.inverse w, rfl⟩
  | comp f g hf hg =>
      obtain ⟨w, rfl⟩ := hf
      obtain ⟨w', rfl⟩ := hg
      exact ⟨.compose w w', rfl⟩

/-- The direct realization functor maps a word's combinatorial morphism to
the endpoint-fixed path-homotopy class of its realized path. -/
theorem map_toHom_eq_mk_realizedPath
    {a b : SSet.FundamentalGroupoid X} (w : RealizationEdgeWord X a b) :
    (SSet.realizationFundamentalGroupoidFunctor X).map w.toHom =
      Path.Homotopic.Quotient.mk w.realizedPath := by
  induction w with
  | edge x y e =>
      simp
  | identity a =>
      simp [FundamentalGroupoid.id_eq_path_refl]
  | inverse w ih =>
      rw [toHom_inverse, Functor.map_inv, realizedPath_inverse]
      calc
        inv (X.realizationFundamentalGroupoidFunctor.map w.toHom) =
            Groupoid.inv (X.realizationFundamentalGroupoidFunctor.map w.toHom) :=
          (Groupoid.inv_eq_inv _).symm
        _ = Groupoid.inv (Path.Homotopic.Quotient.mk w.realizedPath) :=
          congrArg Groupoid.inv ih
        _ = (Path.Homotopic.Quotient.mk w.realizedPath).symm := rfl
        _ = Path.Homotopic.Quotient.mk w.realizedPath.symm :=
          (Path.Homotopic.Quotient.mk_symm w.realizedPath).symm
  | compose w w' ih ih' =>
      simp [ih, ih', FundamentalGroupoid.comp_eq,
        Path.Homotopic.Quotient.mk_trans]

/-- Conditional faithfulness reduction: it suffices to reflect endpoint-fixed
homotopies between realized paths of words with the same indexed endpoints.
This theorem does not supply or assume an approximation theorem beyond the
explicit hypothesis. -/
theorem faithful_of_edgeWord_homotopy
    (happrox : ∀ {a b : SSet.FundamentalGroupoid X}
      (w w' : RealizationEdgeWord X a b),
      w.realizedPath.Homotopy w'.realizedPath → w.toHom = w'.toHom) :
    (SSet.realizationFundamentalGroupoidFunctor X).Faithful := by
  constructor
  intro a b f g hfg
  obtain ⟨w, rfl⟩ := exists_word (X := X) f
  obtain ⟨w', rfl⟩ := exists_word (X := X) g
  rw [map_toHom_eq_mk_realizedPath,
    map_toHom_eq_mk_realizedPath] at hfg
  obtain ⟨H⟩ := Path.Homotopic.Quotient.exact hfg
  exact happrox w w' H

end RealizationEdgeWord

end SSet

end
