module

public import MathlibExt.AlgebraicTopology.SimplicialSet.FiniteJoyalIntervalEquivalences
public import MathlibExt.AlgebraicTopology.SimplicialSet.FiniteJoyalIntervalCylinder
public import MathlibExt.AlgebraicTopology.SimplicialSet.IhomVertices
public import MathlibExt.AlgebraicTopology.ModelCategory.HomotopyTesting
public import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.PushoutProduct
public import Mathlib.CategoryTheory.IsomorphismClasses

/-!
# Finite-interval homotopy classes and object isomorphism classes

For an arbitrary simplicial set `A` and a quasicategory `C`, the actual
generated homotopy quotient for `joyalInterval.productPrecylinder` is
naturally equivalent to the native object-isomorphism quotient of `h(C^A)`.
The equivalence has an exact representative formula and commutes with
precomposition by every simplicial map.

This is the direct finite-interval dictionary of Cisinski, Construction
3.3.1, Definition 3.3.3, Remark 3.6.5 and the object-class identification in
the proof of Theorem 3.6.8 (July 30, 2026 version). The proof uses both full
inverse triangles, the actual braiding and unit maps, and the equivalence
relation generated by all elementary homotopies. It does not require a
model structure or the later weak-equivalence comparison.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

open CategoryTheory MonoidalCategory MonoidalClosed HomotopicalAlgebra
open scoped Simplicial

universe u

namespace SSet.joyalInterval

variable {A B C X : SSet.{u}}

private lemma endpoint_vertex (t : joyalInterval ⟶ X) (ε : Fin 2) :
    yonedaEquiv (endpoint ε ≫ t) = unitHomEquiv X (unitPoint ε ≫ t) := by
  dsimp only [unitPoint]
  rw [Category.assoc]
  exact yonedaEquiv_eq_unitHomEquiv _ _

private lemma transpose_endpoint (F : joyalInterval ⊗ A ⟶ C) (ε : Fin 2) :
    unitPoint ε ≫ curry ((β_ A joyalInterval).hom ≫ F) =
      curry' ((productPrecylinder.app A).endpoint ε ≫ F) := by
  rw [← curry_natural_left, curry', productPrecylinder_endpoint_unitor]
  apply congrArg curry
  rw [← Category.assoc, BraidedCategory.braiding_naturality_right,
    braiding_tensorUnit_right]
  simp only [Category.assoc]

private lemma untranspose_endpoint (t : joyalInterval ⟶ (ihom A).obj C) (ε : Fin 2) :
    (productPrecylinder.app A).endpoint ε ≫ (β_ A joyalInterval).inv ≫ uncurry t =
      uncurry' (unitPoint ε ≫ t) := by
  apply curry'_injective
  rw [curry'_uncurry']
  simpa only [Category.assoc, Iso.hom_inv_id_assoc, curry_uncurry] using
    (transpose_endpoint ((β_ A joyalInterval).inv ≫ uncurry t) ε).symm

private lemma isIsomorphic_of_leftHomotopy {f g : A ⟶ C}
    (H : (productPrecylinder.app A).LeftHomotopy f g) :
    IsIsomorphic (HomotopyCategory.mk (ihomVertexEquiv A C f) :
      hoFunctor.obj ((ihom A).obj C))
      (HomotopyCategory.mk (ihomVertexEquiv A C g)) := by
  let t := curry ((β_ A joyalInterval).hom ≫ H.h)
  have h₀ : unitPoint 0 ≫ t = curry' f := by
    dsimp only [t]
    rw [transpose_endpoint]
    exact congrArg curry' H.h₀
  have h₁ : unitPoint 1 ≫ t = curry' g := by
    dsimp only [t]
    rw [transpose_endpoint]
    exact congrArg curry' H.h₁
  have hx : ((ihom A).obj C).δ 1 (yonedaEquiv (forward ≫ t)) =
      ihomVertexEquiv A C f := by
    rw [← stdSimplex.yonedaEquiv_δ_comp]
    rw [← Category.assoc, ← endpoint_zero, endpoint_vertex, h₀]
    rfl
  have hy : ((ihom A).obj C).δ 0 (yonedaEquiv (forward ≫ t)) =
      ihomVertexEquiv A C g := by
    rw [← stdSimplex.yonedaEquiv_δ_comp]
    rw [← Category.assoc, ← endpoint_one, endpoint_vertex, h₁]
    rfl
  let e := (Edge.mk' (yonedaEquiv (forward ≫ t))).ofEq hx hy
  have he : e.IsEquivalence :=
    Edge.isEquivalence_of_joyalInterval_extension (t := t)
      (yonedaEquiv.symm_apply_apply _).symm
  let : IsIso e.toHoHom := he
  exact ⟨asIso e.toHoHom⟩

private lemma leftHomotopy_of_isIsomorphic [Quasicategory C] {f g : A ⟶ C}
    (h : IsIsomorphic (HomotopyCategory.mk (ihomVertexEquiv A C f) :
      hoFunctor.obj ((ihom A).obj C))
      (HomotopyCategory.mk (ihomVertexEquiv A C g))) :
    Nonempty ((productPrecylinder.app A).LeftHomotopy f g) := by
  obtain ⟨φ⟩ := h
  obtain ⟨e, he⟩ := Edge.exists_toHoHom_eq φ.hom
  have he' : e.IsEquivalence := by
    change IsIso e.toHoHom
    rw [he]
    infer_instance
  obtain ⟨I⟩ := he'.nonempty_invStruct
  obtain ⟨t, ht, _⟩ := I.exists_joyalInterval_realization
  have h₀ : unitPoint 0 ≫ t = curry' f := by
    apply (unitHomEquiv _).injective
    rw [← endpoint_vertex, endpoint_zero, Category.assoc, ht.1,
      stdSimplex.yonedaEquiv_δ_comp, Equiv.apply_symm_apply]
    exact e.src_eq
  have h₁ : unitPoint 1 ≫ t = curry' g := by
    apply (unitHomEquiv _).injective
    rw [← endpoint_vertex, endpoint_one, Category.assoc, ht.1,
      stdSimplex.yonedaEquiv_δ_comp, Equiv.apply_symm_apply]
    exact e.tgt_eq
  exact ⟨{
    h := (β_ A joyalInterval).inv ≫ uncurry t
    h₀ := by
      change (productPrecylinder.app A).endpoint 0 ≫ _ = f
      rw [untranspose_endpoint, h₀, uncurry'_curry']
    h₁ := by
      change (productPrecylinder.app A).endpoint 1 ≫ _ = g
      rw [untranspose_endpoint, h₁, uncurry'_curry']
  }⟩

private lemma isIsomorphic_of_homotopyRel {f g : A ⟶ C}
    (h : productPrecylinder.homotopyRel f g) :
    IsIsomorphic (HomotopyCategory.mk (ihomVertexEquiv A C f) :
      hoFunctor.obj ((ihom A).obj C))
      (HomotopyCategory.mk (ihomVertexEquiv A C g)) := by
  induction h with
  | rel a b h => exact isIsomorphic_of_leftHomotopy h.some
  | refl a => exact ⟨Iso.refl _⟩
  | symm a b h ih => exact ⟨ih.some.symm⟩
  | trans a b c hab hbc ihab ihbc => exact ⟨ihab.some.trans ihbc.some⟩

/-- Equality in the actual generated finite-interval quotient is exactly
isomorphism of the corresponding objects in the functor homotopy category. -/
theorem homotopyClass_eq_iff_isIsomorphic [Quasicategory C] (f g : A ⟶ C) :
    productPrecylinder.homotopyQuotientFunctor.map f =
        productPrecylinder.homotopyQuotientFunctor.map g ↔
      IsIsomorphic (HomotopyCategory.mk (ihomVertexEquiv A C f) :
        hoFunctor.obj ((ihom A).obj C))
        (HomotopyCategory.mk (ihomVertexEquiv A C g)) := by
  rw [productPrecylinder.homotopyQuotientFunctor_map_eq_iff]
  exact ⟨isIsomorphic_of_homotopyRel,
    fun h ↦ Relation.EqvGen.rel _ _ (leftHomotopy_of_isIsomorphic h)⟩

private noncomputable def representativeClass (f : A ⟶ C) :
    isomorphismClasses.obj (hoFunctor.obj ((ihom A).obj C)) :=
  _root_.Quotient.mk _ (HomotopyCategory.mk (ihomVertexEquiv A C f))

private noncomputable def classMap (A C : SSet.{u}) :
    productPrecylinder.HomotopyClass A C →
      isomorphismClasses.obj (hoFunctor.obj ((ihom A).obj C)) :=
  fun α ↦ representativeClass (productPrecylinder.homotopyQuotientFunctor.preimage α)

private lemma classMap_map (f : A ⟶ C) :
    classMap A C (productPrecylinder.homotopyQuotientFunctor.map f) =
      representativeClass f := by
  apply _root_.Quotient.sound
  apply isIsomorphic_of_homotopyRel
  exact (productPrecylinder.homotopyQuotientFunctor_map_eq_iff _ _).mp
    (productPrecylinder.homotopyQuotientFunctor.map_preimage _)

private lemma classMap_injective (A C : SSet.{u}) [Quasicategory C] :
    Function.Injective (classMap A C) := by
  intro α β h
  obtain ⟨f, rfl⟩ := productPrecylinder.homotopyQuotientFunctor.map_surjective α
  obtain ⟨g, rfl⟩ := productPrecylinder.homotopyQuotientFunctor.map_surjective β
  rw [classMap_map, classMap_map] at h
  exact (homotopyClass_eq_iff_isIsomorphic f g).mpr (_root_.Quotient.exact h)

private lemma classMap_surjective (A C : SSet.{u}) :
    Function.Surjective (classMap A C) := by
  intro α
  induction α using _root_.Quotient.inductionOn with
  | h z =>
    let f := (ihomVertexEquiv A C).symm (HomotopyCategory.objEquiv z)
    refine ⟨productPrecylinder.homotopyQuotientFunctor.map f, ?_⟩
    rw [classMap_map]
    apply congrArg (_root_.Quotient.mk _)
    change HomotopyCategory.mk (ihomVertexEquiv A C f) = z
    rw [Equiv.apply_symm_apply]
    exact HomotopyCategory.objEquiv.left_inv z

/-- The natural bijection from the chosen finite-interval homotopy classes
to the native object-isomorphism classes of `h(C^A)`. -/
noncomputable def homotopyClassEquivIsomorphismClasses (A C : SSet.{u}) [Quasicategory C] :
    productPrecylinder.HomotopyClass A C ≃
      isomorphismClasses.obj (hoFunctor.obj ((ihom A).obj C)) :=
  Equiv.ofBijective
    (fun α ↦ _root_.Quotient.mk (isIsomorphicSetoid (hoFunctor.obj ((ihom A).obj C)))
      (HomotopyCategory.mk (ihomVertexEquiv A C
        (productPrecylinder.homotopyQuotientFunctor.preimage α))))
    ⟨by exact classMap_injective A C, by exact classMap_surjective A C⟩

/-- The bijection sends each original map to exactly its corresponding
object isomorphism class, independently of the chosen quotient preimage. -/
@[simp]
theorem homotopyClassEquivIsomorphismClasses_map [Quasicategory C] (f : A ⟶ C) :
    homotopyClassEquivIsomorphismClasses A C
        (productPrecylinder.homotopyQuotientFunctor.map f) =
      _root_.Quotient.mk (isIsomorphicSetoid (hoFunctor.obj ((ihom A).obj C)))
        (HomotopyCategory.mk (ihomVertexEquiv A C f)) :=
  classMap_map f

/-- Naturality under every precomposition map, on every actual homotopy
class. Neither the map nor its source needs a fibrancy or monicity premise. -/
theorem homotopyClassEquivIsomorphismClasses_naturality [Quasicategory C]
    (a : B ⟶ A) (α : productPrecylinder.HomotopyClass A C) :
    homotopyClassEquivIsomorphismClasses B C
        (productPrecylinder.homotopyClassPrecomp a C α) =
      isomorphismClasses.map (hoFunctor.map ((pre a).app C))
        (homotopyClassEquivIsomorphismClasses A C α) := by
  obtain ⟨f, rfl⟩ := productPrecylinder.homotopyQuotientFunctor.map_surjective α
  rw [productPrecylinder.homotopyClassPrecomp_map,
    homotopyClassEquivIsomorphismClasses_map, homotopyClassEquivIsomorphismClasses_map]
  change _root_.Quotient.mk _ (HomotopyCategory.mk (ihomVertexEquiv B C (a ≫ f))) =
    _root_.Quotient.mk _ ((mapHomotopyCategory ((pre a).app C)).obj
      (HomotopyCategory.mk (ihomVertexEquiv A C f)))
  rw [mapHomotopyCategory_obj_mk, ihomVertexEquiv_pre_app]

end SSet.joyalInterval
