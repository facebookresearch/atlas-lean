-- Author: @toskua, Avocado
module

public import MathlibExt.AlgebraicTopology.SimplicialSet.JoinHorn
public import MathlibExt.AlgebraicTopology.SimplicialSet.PushoutJoinGeneratedLifting
public import MathlibExt.AlgebraicTopology.SimplicialSet.ModelCategory.SmallObject
public import Mathlib.AlgebraicTopology.SimplicialSet.AnodyneExtensions.Inner.Basic

/-!
# Pushout joins with left horns are inner anodyne

This file proves the left-horn/monomorphism specialization of Joyal's
Theorem 3.17(i).  The proof extends the boundary--horn computation of
Lemma 3.11 across the double left orthogonals generated by the boundary and
fixed horn inclusions.
-/

@[expose] public section

set_option autoImplicit false

open CategoryTheory MorphismProperty
open scoped Simplicial

universe u

namespace SSet

/-- The pushout join of a monomorphism with a left horn inclusion is inner
anodyne.  This includes one-dimensional left horns and zero-dimensional
boundary generators. -/
theorem innerAnodyneExtensions_pushoutJoin_leftHorn
    {n : ℕ} (i : Fin (n + 1)) (hi : i < Fin.last n)
    {K₀ K : SSet.{u}} (j : K₀ ⟶ K) [Mono j] :
    innerAnodyneExtensions
      (joinUnderPushoutObjObj j (horn n i).ι).ι := by
  rw [innerAnodyneExtensions_eq_llp_rlp]
  apply pushoutJoin_mem_rlp_llp modelCategoryQuillen.I
    (MorphismProperty.single (horn n i).ι) innerHornInclusions
  · intro A B L M a ha b hb
    obtain ⟨p⟩ := ha
    obtain ⟨⟨⟩⟩ := hb
    obtain _ | q := n
    · exact (Nat.not_lt_zero i.val hi).elim
    · change innerHornInclusions.rlp.llp
        (joinBoundaryHornRightPushoutObjObj p q i).ι
      apply (innerHornInclusions.rlp.llp.arrow_mk_iso_iff
        (joinBoundaryHornRightArrowIso p q i)).mpr
      exact innerHornInclusions.le_llp_rlp _
        (horn_ι_mem_innerHornInclusions (by
          change 0 < p + 1 + i.val
          omega) (by
          change p + 1 + i.val < p + (q + 1) + 1
          omega))
  · rw [modelCategoryQuillen.llp_rlp_I]
    exact monomorphisms.infer_property j
  · exact MorphismProperty.le_llp_rlp _ _
      (MorphismProperty.prop_single (horn n i).ι)

end SSet
