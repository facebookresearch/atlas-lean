-- Author: @toskua
import MathlibExt.AlgebraicTopology.SimplicialSet.Marked.Monomorphisms

/-!
# Original markings generated by specified edges

The selected marking is the union of the original degenerate edges and
the specified original one-simplices. Its marked maps are exactly the
original simplicial maps preserving those selected edges. Inclusion of edge
sets acts by the identity on the entire original simplicial set. These are
native marked-cell carriers; no weak class or marked model is assumed.
-/

universe u
open CategoryTheory Opposite
open scoped Simplicial

namespace SSet.Marked

/-- Mark precisely the original degeneracies and the specified original edges. -/
def withEdges (X : SSet.{u}) (E : Set (X _⦋1⦌)) : Marked.{u} where
  toSSet := X
  marking := (min X).marking ∪ E
  degenerate_mem x := Or.inl ((min X).degenerate_mem x)

/-- Membership retains exactly the two original sources of marked edges. -/
theorem mem_withEdges_iff (X : SSet.{u}) (E : Set (X _⦋1⦌)) (e : X _⦋1⦌) :
    e ∈ (withEdges X E).marking ↔ e ∈ (min X).marking ∨ e ∈ E := Iff.rfl

/-- Preserve the selected original edges to give the same whole marked map. -/
def ofWithEdges {X : SSet.{u}} {E : Set (X _⦋1⦌)} {Y : Marked.{u}} (f : X ⟶ Y.toSSet)
    (h : ∀ e : X _⦋1⦌, e ∈ E → f.app (op ⦋1⦌) e ∈ Y.marking) : withEdges X E ⟶ Y where
  hom := f
  preserve he := by
    rcases he with he | he
    · exact (ofMin f).preserve he
    · exact h _ he

/-- The whole original simplicial map is retained. -/
@[simp]
theorem ofWithEdges_hom {X : SSet.{u}} {E : Set (X _⦋1⦌)} {Y : Marked.{u}}
    (f : X ⟶ Y.toSSet) (h : ∀ e : X _⦋1⦌, e ∈ E → f.app (op ⦋1⦌) e ∈ Y.marking) :
    (ofWithEdges f h).hom = f := rfl

/-- The selected marking has its genuine original marked-Hom universal property. -/
def withEdgesHomEquiv (X : SSet.{u}) (E : Set (X _⦋1⦌)) (Y : Marked.{u}) :
    (withEdges X E ⟶ Y) ≃ {f : X ⟶ Y.toSSet // ∀ e : X _⦋1⦌, e ∈ E → f.app (op ⦋1⦌) e ∈ Y.marking} where
  toFun f := ⟨f.hom, fun _ h => f.preserve (Or.inr h)⟩
  invFun f := ofWithEdges f.val f.property
  left_inv _ := Hom.ext rfl
  right_inv _ := Subtype.ext rfl

/-- Enlarge the supplied marking by the identity on all original simplices. -/
def withEdgesInclusion {X : SSet.{u}} {E F : Set (X _⦋1⦌)} (h : E ⊆ F) :
    withEdges X E ⟶ withEdges X F := ofWithEdges (𝟙 X) (fun _ he => Or.inr (h he))

/-- Selected-edge inclusions retain the original identity map. -/
theorem withEdgesInclusion_hom {X : SSet.{u}} {E F : Set (X _⦋1⦌)} (h : E ⊆ F) :
    (withEdgesInclusion h).hom = 𝟙 X := rfl

/-- Enlarging the original marking is a genuine marked monomorphism. -/
theorem withEdgesInclusion_mono {X : SSet.{u}} {E F : Set (X _⦋1⦌)} (h : E ⊆ F) :
    Mono (withEdgesInclusion h) := by
  let _ : Mono (withEdgesInclusion h).hom := inferInstanceAs (Mono (𝟙 X))
  exact Hom.mono_of_underlying _

/-- Successive selected-edge inclusions retain the same whole original identity map. -/
theorem withEdgesInclusion_comp {X : SSet.{u}} {E F G : Set (X _⦋1⦌)}
    (h : E ⊆ F) (k : F ⊆ G) : withEdgesInclusion h ≫ withEdgesInclusion k =
      withEdgesInclusion (Set.Subset.trans h k) := Hom.ext rfl

end SSet.Marked
