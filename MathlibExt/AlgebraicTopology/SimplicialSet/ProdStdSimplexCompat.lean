public import Mathlib.AlgebraicTopology.SimplicialSet.ProdStdSimplex

/-!
# Membership in generated subcomplexes of products of standard simplices

For simplices `s` and `t` of `Δ[p] ⊗ Δ[q]`, the simplex `s` belongs to the
subcomplex generated by `t` exactly when the range of its associated monotone
map to `Fin (p + 1) × Fin (q + 1)` is contained in the range of the map for `t`.
The dimensions of `s` and `t` may differ. This characterization holds for
all `p`, `q` and simplicial-set universes.
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory Simplicial
open scoped Simplicial

namespace SSet

namespace prodStdSimplex

variable {p q : ℕ}

lemma mem_ofSimplex_obj_iff
    {n m : ℕ} (s : (Δ[p] ⊗ Δ[q] : SSet.{u}) _⦋n⦌) (t : (Δ[p] ⊗ Δ[q] : SSet.{u}) _⦋m⦌) :
    s ∈ (Subcomplex.ofSimplex t).obj _ ↔
      Set.range (objEquiv s) ⊆ Set.range (objEquiv t) := by
  rw [← Subcomplex.ofSimplex_le_iff, ofSimplex_le_ofSimplex_iff]

end prodStdSimplex

end SSet
