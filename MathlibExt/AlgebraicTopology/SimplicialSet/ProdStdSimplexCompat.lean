public import Mathlib.AlgebraicTopology.SimplicialSet.ProdStdSimplex

/-!
# Generated subcomplexes of products of standard simplices

For `p, q : ℕ`, simplices of `Δ[p] ⊗ Δ[q] : SSet.{u}` correspond to monotone maps into `Fin (p
+ 1) × Fin (q + 1)`. A simplex `s` belongs to the subcomplex generated by a simplex `t`
exactly when the range of the map for `s` is contained in the range of the map for `t`. The
dimensions of `s` and `t` may differ.
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory Simplicial
open scoped Simplicial

namespace SSet

namespace prodStdSimplex

variable {p q : ℕ}

/-- Let `p, q, n, m : ℕ`, let `s` be an `n`-simplex of `Δ[p] ⊗ Δ[q] : SSet.{u}`, and let `t` be an
`m`-simplex of the same product. Then `s ∈ (Subcomplex.ofSimplex t).obj _` if and only if
`Set.range (objEquiv s) ⊆ Set.range (objEquiv t)`, where `objEquiv` associates to a simplex
its monotone map into `Fin (p + 1) × Fin (q + 1)`. -/
lemma mem_ofSimplex_obj_iff
    {n m : ℕ} (s : (Δ[p] ⊗ Δ[q] : SSet.{u}) _⦋n⦌) (t : (Δ[p] ⊗ Δ[q] : SSet.{u}) _⦋m⦌) :
    s ∈ (Subcomplex.ofSimplex t).obj _ ↔
      Set.range (objEquiv s) ⊆ Set.range (objEquiv t) := by
  rw [← Subcomplex.ofSimplex_le_iff, ofSimplex_le_ofSimplex_iff]

end prodStdSimplex

end SSet
