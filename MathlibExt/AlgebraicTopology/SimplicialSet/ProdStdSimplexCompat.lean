module

-- BACKPORT: One retained product-membership helper from Mathlib PR #42435,
-- head `e09070f786c9fc0a688e6239d71230b618b045ff`,
-- `Mathlib/AlgebraicTopology/SimplicialSet/ProdStdSimplex.lean`,
-- blob `542f70ab67214aac96e30fd0acb210d0eb3d6a64`.
-- The seven original core declarations are delegated upstream; see `BACKPORTS.md`.

public import Mathlib.AlgebraicTopology.SimplicialSet.ProdStdSimplex

/-!
# Simplex-generated subcomplexes of products of simplices

A simplex of a product of standard simplices belongs to the subcomplex generated by another
simplex exactly when its finite-order-map range is contained in the other range. The single
retained lemma delegates the generated-subcomplex inclusion criterion to pinned Mathlib; the
product coordinates, nerve comparison and maximal-dimensional-simplex results also come from
upstream.

The compatibility scope against Mathlib 4.35.0 (`56a005855ea17e0b0958f73ec801ae140b0a1679`) and
its removal conditions are recorded in `BACKPORTS.md`.
-/

@[expose] public section

universe u

open CategoryTheory MonoidalCategory Simplicial
open scoped Simplicial

namespace SSet

namespace prodStdSimplex

variable {p q : ℕ}

lemma mem_ofSimplex_obj_iff
    {n m : ℕ} (s : (Δ[p] ⊗ Δ[q] : SSet.{u}) _⦋n⦌) (t : (Δ[p] ⊗ Δ[q] : SSet.{u}) _⦋m⦌) :
    s ∈ (Subcomplex.ofSimplex t).obj _ ↔
      Set.range (objEquiv s) ⊆ Set.range (objEquiv t) := by
  rw [← Subcomplex.ofSimplex_le_iff, ofSimplex_le_ofSimplex_iff]

end prodStdSimplex

end SSet
