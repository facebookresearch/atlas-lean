module

public import Mathlib.Topology.MetricSpace.Isometry

/-!
# Quasi-isometries

A map `f : X → Y` between pseudometric spaces is an `(L, C)`-*quasi-isometric embedding* if it
distorts distances by at most a multiplicative factor `L ≥ 1` and an additive error `C ≥ 0`:
`d(x, y) / L - C ≤ d(f x, f y) ≤ L d(x, y) + C`. It is an `(L, C)`-*quasi-isometry* if, moreover,
every point of `Y` is within `C` of the image. Two spaces are *quasi-isometric* if there is a
quasi-isometry between them.

Gromov introduced quasi-isometry as the basic equivalence of large-scale geometry
(*Infinite groups as geometric objects*, Proc. ICM Warszawa 1983, §1.B, where a quasi-isometry is a
"virtually Lipschitz" map `f` with a virtually Lipschitz `g` such that `g ∘ f` and `f ∘ g` are at
bounded distance from the identity; *Asymptotic invariants of infinite groups*, 1993, §0.2.C, where
quasi-isometry is generated by Lipschitz and Hausdorff equivalence). The `(L, C)` form used here is
the now-standard form of the 1993 definition. It agrees with the 1983 one when both spaces are
uniformly discrete (word metrics, for instance), but not in general: the floor map `ℝ → ℤ` is a
`(1, 1)`-quasi-isometry, while every Lipschitz map `ℝ → ℤ` is constant, so it is not virtually
Lipschitz. None of these comparisons is formalised in this file. What is formalised is the part
of Gromov's formulation that is used everywhere: quasi-isometries compose, have quasi-inverses
(`IsQuasiIsometry.exists_quasiInverse`), and quasi-isometry is an equivalence relation.

## Main definitions

* `Metric.IsQuasiIsometricEmbedding f L C`: `f` is an `(L, C)`-quasi-isometric embedding.
* `Metric.IsQuasiIsometry f L C`: `f` is an `(L, C)`-quasi-isometry.
* `Metric.QuasiIsometric X Y`: `X` and `Y` are quasi-isometric.

## Main results

* `Metric.IsQuasiIsometricEmbedding.comp`, `Metric.IsQuasiIsometry.comp`: composition, with
  explicit constants.
* `Metric.IsQuasiIsometry.exists_quasiInverse`: a quasi-isometry has a quasi-inverse.
* `Metric.QuasiIsometric.refl`, `.symm`, `.trans`: quasi-isometry is an equivalence relation.
-/

@[expose] public section

namespace Metric

variable {X Y Z : Type*} [PseudoMetricSpace X] [PseudoMetricSpace Y] [PseudoMetricSpace Z]

/-- **Quasi-isometric embedding.** A map `f : X → Y` is an `(L, C)`-quasi-isometric embedding if
`1 ≤ L`, `0 ≤ C` and `d(x, y) / L - C ≤ d(f x, f y) ≤ L d(x, y) + C` for all `x y : X`
(the distance condition of a quasi-isometry in its now-standard `(L, C)` form; compare Gromov,
*Asymptotic invariants of infinite groups*, 1993, §0.2.C). -/
def IsQuasiIsometricEmbedding (f : X → Y) (L C : ℝ) : Prop :=
  1 ≤ L ∧ 0 ≤ C ∧ ∀ x y : X, dist x y / L - C ≤ dist (f x) (f y) ∧
    dist (f x) (f y) ≤ L * dist x y + C

/-- **Quasi-isometry.** A map `f : X → Y` is an `(L, C)`-quasi-isometry if it is an
`(L, C)`-quasi-isometric embedding whose image is `C`-dense: every `y : Y` is within distance `C`
of some `f x`. This is the now-standard `(L, C)` form of Gromov's quasi-isometry in *Asymptotic
invariants of infinite groups*, 1993, §0.2.C (compositions of Hausdorff and Lipschitz
equivalences). It agrees with the "virtually Lipschitz" definition of Proc. ICM 1983, §1.B, for
uniformly discrete spaces such as word metrics, but not in general (the floor map `ℝ → ℤ`). -/
def IsQuasiIsometry (f : X → Y) (L C : ℝ) : Prop :=
  IsQuasiIsometricEmbedding f L C ∧ ∀ y : Y, ∃ x : X, dist (f x) y ≤ C

/-- **Quasi-isometric spaces.** Two pseudometric spaces are quasi-isometric if there is an
`(L, C)`-quasi-isometry from the first to the second for some constants `L` and `C`. -/
def QuasiIsometric (X Y : Type*) [PseudoMetricSpace X] [PseudoMetricSpace Y] : Prop :=
  ∃ (f : X → Y) (L C : ℝ), IsQuasiIsometry f L C

namespace IsQuasiIsometricEmbedding

variable {f : X → Y} {g : Y → Z} {L C L' C' : ℝ}

/-- **Upper bound of a quasi-isometric embedding.** An `(L, C)`-quasi-isometric embedding
satisfies `d(f x, f y) ≤ L d(x, y) + C`. -/
theorem dist_le (hf : IsQuasiIsometricEmbedding f L C) (x y : X) :
    dist (f x) (f y) ≤ L * dist x y + C :=
  (hf.2.2 x y).2

/-- **Lower bound of a quasi-isometric embedding.** An `(L, C)`-quasi-isometric embedding
satisfies `d(x, y) ≤ L (d(f x, f y) + C)`. -/
theorem dist_le_mul_add (hf : IsQuasiIsometricEmbedding f L C) (x y : X) :
    dist x y ≤ L * (dist (f x) (f y) + C) := by
  have hL : 0 < L := lt_of_lt_of_le one_pos hf.1
  have h := (hf.2.2 x y).1
  rw [div_sub' hL.ne', div_le_iff₀ hL] at h
  nlinarith

/-- **Weakening the constants of a quasi-isometric embedding.** An `(L, C)`-quasi-isometric
embedding is an `(L', C')`-quasi-isometric embedding whenever `L ≤ L'` and `C ≤ C'`. -/
theorem mono (hf : IsQuasiIsometricEmbedding f L C) (hL : L ≤ L') (hC : C ≤ C') :
    IsQuasiIsometricEmbedding f L' C' := by
  have hL0 : 0 < L := lt_of_lt_of_le one_pos hf.1
  refine ⟨hf.1.trans hL, hf.2.1.trans hC, fun x y => ⟨?_, ?_⟩⟩
  · have h1 := (hf.2.2 x y).1
    have h2 : dist x y / L' ≤ dist x y / L :=
      div_le_div_of_nonneg_left dist_nonneg hL0 hL
    linarith
  · have h1 := (hf.2.2 x y).2
    have h2 : L * dist x y ≤ L' * dist x y := mul_le_mul_of_nonneg_right hL dist_nonneg
    linarith

/-- **Isometries are quasi-isometric embeddings.** An isometry is a `(1, 0)`-quasi-isometric
embedding. -/
theorem _root_.Isometry.isQuasiIsometricEmbedding (hf : Isometry f) :
    IsQuasiIsometricEmbedding f 1 0 :=
  ⟨le_rfl, le_rfl, fun x y => by simp [hf.dist_eq]⟩

/-- **Composition of quasi-isometric embeddings.** If `f` is an `(L, C)`- and `g` an
`(L', C')`-quasi-isometric embedding, then `g ∘ f` is an `(L' L, L' C + C')`-quasi-isometric
embedding. -/
theorem comp (hg : IsQuasiIsometricEmbedding g L' C') (hf : IsQuasiIsometricEmbedding f L C) :
    IsQuasiIsometricEmbedding (g ∘ f) (L' * L) (L' * C + C') := by
  obtain ⟨hL, hC, hf'⟩ := hf
  obtain ⟨hL', hC', hg'⟩ := hg
  have hL0 : 0 < L := lt_of_lt_of_le one_pos hL
  have hL0' : 0 < L' := lt_of_lt_of_le one_pos hL'
  refine ⟨one_le_mul_of_one_le_of_one_le hL' hL, by positivity, fun x y => ⟨?_, ?_⟩⟩
  · obtain ⟨h1, -⟩ := hf' x y
    obtain ⟨h2, -⟩ := hg' (f x) (f y)
    have h3 : (dist x y / L - C) / L' ≤ dist (f x) (f y) / L' :=
      div_le_div_of_nonneg_right h1 hL0'.le
    have h4 : (dist x y / L - C) / L' = dist x y / (L' * L) - C / L' := by
      field_simp
    have h5 : C / L' ≤ L' * C := by
      rw [div_le_iff₀ hL0']
      have h6 : C ≤ L' * C := by nlinarith
      nlinarith
    simp only [Function.comp]
    linarith
  · obtain ⟨-, h1⟩ := hf' x y
    obtain ⟨-, h2⟩ := hg' (f x) (f y)
    have h3 : L' * dist (f x) (f y) ≤ L' * (L * dist x y + C) :=
      mul_le_mul_of_nonneg_left h1 hL0'.le
    simp only [Function.comp]
    nlinarith

end IsQuasiIsometricEmbedding

namespace IsQuasiIsometry

variable {f : X → Y} {g : Y → Z} {L C L' C' : ℝ}

/-- **Weakening the constants of a quasi-isometry.** An `(L, C)`-quasi-isometry is an
`(L', C')`-quasi-isometry whenever `L ≤ L'` and `C ≤ C'`. -/
theorem mono (hf : IsQuasiIsometry f L C) (hL : L ≤ L') (hC : C ≤ C') :
    IsQuasiIsometry f L' C' :=
  ⟨hf.1.mono hL hC, fun y => (hf.2 y).imp fun _ hx => hx.trans hC⟩

/-- **The identity is a quasi-isometry.** The identity map is a `(1, 0)`-quasi-isometry. -/
theorem id : IsQuasiIsometry (id : X → X) 1 0 :=
  ⟨isometry_id.isQuasiIsometricEmbedding, fun y => ⟨y, by simp⟩⟩

/-- **Composition of quasi-isometries.** If `f` is an `(L, C)`- and `g` an
`(L', C')`-quasi-isometry, then `g ∘ f` is an `(L' L, L' C + 2 C')`-quasi-isometry. -/
theorem comp (hg : IsQuasiIsometry g L' C') (hf : IsQuasiIsometry f L C) :
    IsQuasiIsometry (g ∘ f) (L' * L) (L' * C + 2 * C') := by
  have hC' : 0 ≤ C' := hg.1.2.1
  refine ⟨(hg.1.comp hf.1).mono le_rfl (by linarith), fun z => ?_⟩
  obtain ⟨y, hy⟩ := hg.2 z
  obtain ⟨x, hx⟩ := hf.2 y
  refine ⟨x, ?_⟩
  have h1 := hg.1.dist_le (f x) y
  have h2 : L' * dist (f x) y ≤ L' * C :=
    mul_le_mul_of_nonneg_left hx (zero_le_one.trans hg.1.1)
  calc dist ((g ∘ f) x) z ≤ dist (g (f x)) (g y) + dist (g y) z := dist_triangle _ _ _
    _ ≤ L' * C + 2 * C' := by linarith

/-- **Quasi-inverse of a quasi-isometry.** An `(L, C)`-quasi-isometry `f : X → Y` has a
quasi-inverse: an `(L, 3 L C)`-quasi-isometry `g : Y → X` with `d(f (g y), y) ≤ C` and
`d(g (f x), x) ≤ 2 L C` for all `x` and `y`. This is the "`f ∘ g` and `g ∘ f` are translations"
half of Gromov's definition (Proc. ICM 1983, §1.B). -/
theorem exists_quasiInverse (hf : IsQuasiIsometry f L C) :
    ∃ g : Y → X, IsQuasiIsometry g L (3 * L * C) ∧ (∀ y, dist (f (g y)) y ≤ C) ∧
      ∀ x, dist (g (f x)) x ≤ 2 * L * C := by
  classical
  obtain ⟨hemb, hdense⟩ := hf
  have hL : 1 ≤ L := hemb.1
  have hC : 0 ≤ C := hemb.2.1
  have hL0 : 0 < L := lt_of_lt_of_le one_pos hL
  choose g hg using hdense
  -- distances between images of `g` compared with distances in `Y`
  have hfg : ∀ y y', |dist (f (g y)) (f (g y')) - dist y y'| ≤ 2 * C := by
    intro y y'
    have h1 := dist_triangle4 (f (g y)) y y' (f (g y'))
    have h2 := dist_triangle4 y (f (g y)) (f (g y')) y'
    have e1 := hg y
    have e2 := hg y'
    rw [dist_comm y' (f (g y'))] at h1
    rw [dist_comm y (f (g y))] at h2
    rw [abs_le]
    constructor <;> linarith
  have hgf : ∀ x, dist (g (f x)) x ≤ 2 * L * C := by
    intro x
    have h1 := hemb.dist_le_mul_add (g (f x)) x
    have h2 := hg (f x)
    nlinarith
  refine ⟨g, ⟨⟨hL, by positivity, fun y y' => ⟨?_, ?_⟩⟩, fun x => ⟨f x, ?_⟩⟩, hg, hgf⟩
  · -- lower bound
    have h1 := hemb.dist_le (g y) (g y')
    have h2 := (abs_le.mp (hfg y y')).1
    have h3 : dist y y' / L - 3 * C / L ≤ dist (g y) (g y') := by
      rw [div_sub_div_same, div_le_iff₀ hL0]
      nlinarith
    have h4 : 3 * C / L ≤ 3 * L * C := by
      rw [div_le_iff₀ hL0]
      have h5 : C ≤ L * C := by nlinarith
      nlinarith
    linarith
  · -- upper bound
    have h1 := hemb.dist_le_mul_add (g y) (g y')
    have h2 := (abs_le.mp (hfg y y')).2
    nlinarith
  · -- density
    have := hgf x
    nlinarith

end IsQuasiIsometry

namespace QuasiIsometric

/-- **Quasi-isometry is reflexive.** Every pseudometric space is quasi-isometric to itself. -/
theorem refl (X : Type*) [PseudoMetricSpace X] : QuasiIsometric X X :=
  ⟨id, 1, 0, IsQuasiIsometry.id⟩

/-- **Quasi-isometry is symmetric.** If `X` is quasi-isometric to `Y`, then `Y` is quasi-isometric
to `X`. -/
theorem symm (h : QuasiIsometric X Y) : QuasiIsometric Y X := by
  obtain ⟨f, L, C, hf⟩ := h
  obtain ⟨g, hg, -, -⟩ := hf.exists_quasiInverse
  exact ⟨g, L, 3 * L * C, hg⟩

/-- **Quasi-isometry is transitive.** If `X` is quasi-isometric to `Y` and `Y` to `Z`, then `X` is
quasi-isometric to `Z`. -/
theorem trans (h₁ : QuasiIsometric X Y) (h₂ : QuasiIsometric Y Z) : QuasiIsometric X Z := by
  obtain ⟨f, L, C, hf⟩ := h₁
  obtain ⟨g, L', C', hg⟩ := h₂
  exact ⟨g ∘ f, L' * L, L' * C + 2 * C', hg.comp hf⟩

end QuasiIsometric

end Metric
