module

public import Mathlib.Topology.Homotopy.TopCat.ToSSet
public import MathlibExt.AlgebraicTopology.SimplicialSet.ModelCategory.SSetDeformationRetract

/-!
# Singularization of a homotopy relative to a literal point

The actual `TopCat.Homotopy.toSSet` of a continuous point-relative homotopy
is stationary on the entire subcomplex generated by its singular point.
Stationarity holds at every simplex and every interval simplex.
-/

public section

noncomputable section

open CategoryTheory MonoidalCategory Opposite
open scoped Simplicial

universe u

namespace TopCat

private theorem singularMap_apply {X Y : TopCat.{u}} (f : X ⟶ Y)
    (n : SimplexCategoryᵒᵖ) (σ : (TopCat.toSSet.obj X).obj n)
    (z : Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))) :
    Y.toSSetObjEquiv n ((TopCat.toSSet.map f).app n σ) z =
      f (X.toSSetObjEquiv n σ z) := rfl

private theorem singularProduct_apply (X Y : TopCat.{u}) (n : SimplexCategoryᵒᵖ)
    (σ : (TopCat.toSSet.obj X ⊗ TopCat.toSSet.obj Y).obj n)
    (z : Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))) :
    (X ⊗ Y).toSSetObjEquiv n
        ((Functor.LaxMonoidal.μ TopCat.toSSet X Y).app n σ) z =
      (X.toSSetObjEquiv n σ.1 z, Y.toSSetObjEquiv n σ.2 z) := by
  apply Prod.ext
  · have h := congrArg (fun k => k.app n σ)
      (Functor.Monoidal.μ_fst (F := TopCat.toSSet) X Y)
    exact congrArg (fun t => X.toSSetObjEquiv n t z) h
  · have h := congrArg (fun k => k.app n σ)
      (Functor.Monoidal.μ_snd (F := TopCat.toSSet) X Y)
    exact congrArg (fun t => Y.toSSetObjEquiv n t z) h

private theorem singularConstantPoint_apply (X : TopCat.{u}) (x₀ : X)
    (n : SimplexCategoryᵒᵖ) (a : (Δ[0] : SSet.{u}).obj n)
    (z : Convexity.StdSimplex ℝ (Fin (n.unop.len + 1))) :
    X.toSSetObjEquiv n
        ((SSet.const (X := (Δ[0] : SSet.{u}))
          (TopCat.toSSetObj₀Equiv.symm x₀)).app n a) z = x₀ := rfl

/-- The singular homotopy of the actual given point-relative continuous homotopy,
stationary on the full simplicial image of its singular point. -/
def singularHomotopyRelAtPoint {X Y : TopCat.{u}} {f g : X ⟶ Y}
    (x₀ : X) (H : ContinuousMap.HomotopyRel f.hom g.hom {x₀}) :
    SSet.HomotopyRel (TopCat.toSSet.map f) (TopCat.toSSet.map g)
      (SSet.Subcomplex.range (SSet.const (X := (Δ[0] : SSet.{u}))
        (TopCat.toSSetObj₀Equiv.symm x₀))) where
  h := (TopCat.Homotopy.toSSet (H.toHomotopy : TopCat.Homotopy f g)).h
  h₀ := (TopCat.Homotopy.toSSet (H.toHomotopy : TopCat.Homotopy f g)).h₀
  h₁ := (TopCat.Homotopy.toSSet (H.toHomotopy : TopCat.Homotopy f g)).h₁
  stationary := by
    intro n σ hσ t
    change σ ∈ Set.range
      ((SSet.const (X := (Δ[0] : SSet.{u}))
        (TopCat.toSSetObj₀Equiv.symm x₀)).app n) at hσ
    obtain ⟨a, rfl⟩ := hσ
    apply (Y.toSSetObjEquiv n).injective
    apply ContinuousMap.ext
    intro z
    let τ : (TopCat.toSSet.obj TopCat.I.{u}).obj n := SSet.stdSimplex.toSSetObjI.app n t
    change Y.toSSetObjEquiv n
        ((TopCat.toSSet.map (TopCat.Homotopy.h (H.toHomotopy : TopCat.Homotopy f g))).app n
          ((Functor.LaxMonoidal.μ TopCat.toSSet X TopCat.I.{u}).app n
            ((SSet.const (X := (Δ[0] : SSet.{u}))
              (TopCat.toSSetObj₀Equiv.symm x₀)).app n a, τ))) z =
      Y.toSSetObjEquiv n
        ((TopCat.toSSet.map f).app n
          ((SSet.const (X := (Δ[0] : SSet.{u}))
            (TopCat.toSSetObj₀Equiv.symm x₀)).app n a)) z
    simp only [singularMap_apply]
    have hμ := singularProduct_apply X TopCat.I.{u} n
      (((SSet.const (X := (Δ[0] : SSet.{u}))
        (TopCat.toSSetObj₀Equiv.symm x₀)).app n a), τ) z
    rw [hμ]
    simp only [singularConstantPoint_apply]
    change H ((TopCat.I.homeomorph.{u}) ((TopCat.I.{u}).toSSetObjEquiv n τ z), x₀) = f x₀
    exact H.eq_fst _ (Set.mem_singleton_iff.mpr rfl)

/-- The entire singular homotopy map is the existing map of the actual given homotopy. -/
theorem singularHomotopyRelAtPoint_h {X Y : TopCat.{u}} {f g : X ⟶ Y}
    (x₀ : X) (H : ContinuousMap.HomotopyRel f.hom g.hom {x₀}) :
    (singularHomotopyRelAtPoint x₀ H).h =
      (TopCat.Homotopy.toSSet (H.toHomotopy : TopCat.Homotopy f g)).h := (rfl)

end TopCat

end
