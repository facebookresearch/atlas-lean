/-!
# Single-linkage clustering and the subdominant ultrametric

Single-linkage clustering at scale `r` partitions a set with a dissimilarity `d` into the classes
of the equivalence relation generated by `d x y ≤ r` (`r`-equivalence). For a metric space these
classes are the connected components of the `r`-neighbourhood graph, that is, for `r ≥ 0`, `π₀` of
the Vietoris–Rips complex `VR(X, r)` (G. Carlsson, *Topology and data*, Bull. AMS 46 (2009), §3.2);
Carlsson calls clustering the statistical counterpart of `π₀` (§1 there). Letting `r` vary gives
the single-linkage dendrogram, encoded by the ultrametric
`u*(x, y) = min { max_i d(xᵢ, xᵢ₊₁) : x = x₀, …, x_k = y }` (G. Carlsson and F. Mémoli,
*Characterization, stability and convergence of hierarchical clustering methods*, JMLR 11 (2010)
1425–1470, Example 1, and Example 7, equation (4)).

The results are stated for an arbitrary real-valued dissimilarity `d : X → X → ℝ`, with only the
hypotheses each proof uses; finiteness of `X` is needed only to show that the infimum defining
`slDist` is attained (`slEquiv_iff_slDist_le`).

* `SLEquiv d r`: `r`-equivalence; `SLEquiv.mono` (the dendrogram is nested),
  `SLEquiv.map` (functoriality under distance non-increasing maps),
  `slEquiv_dist_iff_reachable` (clusters are connected components of the Rips graph).
* `slDist d`: the single-linkage ultrametric, the infimum of the scales at which two points are
  equivalent. It is symmetric, zero on the diagonal, ultrametric (`slDist_le_max`), below `d`
  (`slDist_le`), and the largest function with these properties (`le_slDist`), i.e. the maximal
  subdominant ultrametric; on a finite set `x ∼_r y ↔ slDist d x y ≤ r`
  (`slEquiv_iff_slDist_le`); and it is `1`-Lipschitz in `d` for the sup norm
  (`abs_slDist_sub_le`, Carlsson–Mémoli Lemma 15).
-/

@[expose] public section

open Relation

namespace MathlibExt.Topology.TDA

variable {X : Type*}

/-- **`r`-equivalence (single-linkage clusters at scale `r`).** For a dissimilarity
`d : X → X → ℝ` and a scale `r`, `SLEquiv d r` is the equivalence relation generated by
`d x y ≤ r`: `x` and `y` are `r`-equivalent when they are joined by a finite chain
`x = x₀, x₁, …, x_k = y` whose consecutive points satisfy `d xᵢ xᵢ₊₁ ≤ r` (up to the order of
the arguments of `d`). Its classes are the single-linkage clusters at scale `r` (Carlsson and
Mémoli, JMLR 11 (2010), Example 1; Carlsson, *Topology and data*, Bull. AMS 2009, §3.2). -/
def SLEquiv (d : X → X → ℝ) (r : ℝ) : X → X → Prop :=
  EqvGen fun x y => d x y ≤ r

theorem SLEquiv.equivalence (d : X → X → ℝ) (r : ℝ) : Equivalence (SLEquiv d r) :=
  EqvGen.is_equivalence _

/-- **Single-linkage clusters are nested.** If `r ≤ s`, `r`-equivalent points are
`s`-equivalent, so the clusters at scale `r` refine those at scale `s` and together form a
dendrogram (Carlsson and Mémoli, JMLR 11 (2010), Example 2). -/
theorem SLEquiv.mono {d : X → X → ℝ} {r s : ℝ} (h : r ≤ s) {x y : X} (hxy : SLEquiv d r x y) :
    SLEquiv d s x y :=
  EqvGen.mono (fun _ _ hab => hab.trans h) _ _ hxy

/-- **Chains concatenate.** An `r`-chain from `x` to `y` followed by an `s`-chain from `y` to
`z` is a `max r s`-chain from `x` to `z`; this is the ultrametric inequality for `u*`
(Carlsson and Mémoli, JMLR 11 (2010), Example 1 and Example 7). -/
theorem SLEquiv.trans_max {d : X → X → ℝ} {r s : ℝ} {x y z : X} (h₁ : SLEquiv d r x y)
    (h₂ : SLEquiv d s y z) : SLEquiv d (max r s) x z :=
  EqvGen.trans _ _ _ (h₁.mono (le_max_left _ _)) (h₂.mono (le_max_right _ _))

/-- **Functoriality of single-linkage clustering.** A distance non-increasing map
`f : (X, d) → (Y, e)` (that is, `e (f x) (f y) ≤ d x y`) sends `r`-equivalent points to
`r`-equivalent points, hence maps each cluster of `X` into a cluster of `Y` at every scale.
This is Carlsson's functoriality of clustering (Carlsson, *Topology and data*, Bull. AMS 2009,
Def. 3.2, there for distance-preserving maps) and the property behind condition (II) of the
characterization of single linkage (Carlsson and Mémoli, JMLR 11 (2010), Thm. 18). -/
theorem SLEquiv.map {Y : Type*} {d : X → X → ℝ} {e : Y → Y → ℝ} (f : X → Y)
    (hf : ∀ x y, e (f x) (f y) ≤ d x y) {r : ℝ} {x y : X} (h : SLEquiv d r x y) :
    SLEquiv e r (f x) (f y) := by
  induction h with
  | rel a b hab => exact EqvGen.rel _ _ ((hf a b).trans hab)
  | refl a => exact EqvGen.refl _
  | symm a b _ ih => exact EqvGen.symm _ _ ih
  | trans a b c _ _ ih₁ ih₂ => exact EqvGen.trans _ _ _ ih₁ ih₂

/-- **Perturbing the dissimilarity shifts the scale.** If `d₂ ≤ d₁ + η` pointwise, then
`r`-equivalence for `d₁` implies `(r + η)`-equivalence for `d₂`: the chain argument in the proof
of Carlsson and Mémoli, JMLR 11 (2010), Lemma 15. -/
theorem SLEquiv.of_le_add {d₁ d₂ : X → X → ℝ} {η : ℝ} (h : ∀ x y, d₂ x y ≤ d₁ x y + η) {r : ℝ}
    {x y : X} (hxy : SLEquiv d₁ r x y) : SLEquiv d₂ (r + η) x y :=
  EqvGen.mono (fun a b hab => (h a b).trans (by linarith)) _ _ hxy

/-- **Single-linkage clusters are the connected components of the Rips graph.** In a
(pseudo)metric space, two points are `r`-equivalent exactly when they are joined
by a path in the `r`-neighbourhood graph, which for `r ≥ 0` is the one-skeleton of `VR(M, r)`. So
for `r ≥ 0` the single-linkage clusters at scale `r` are `π₀` of the Vietoris–Rips complex
(Carlsson, *Topology and data*, Bull. AMS 2009, §3.2). For `r < 0` both relations are equality,
while `VR(M, r)` has no vertices. -/
theorem slEquiv_dist_iff_reachable {M : Type*} [PseudoMetricSpace M] {r : ℝ} {x y : M} :
    SLEquiv dist r x y ↔ (ripsGraph r).Reachable x y := by
  constructor
  · intro h
    induction h with
    | rel a b hab =>
      by_cases hab' : a = b
      · subst hab'
        exact SimpleGraph.Reachable.refl _
      · exact SimpleGraph.Adj.reachable ⟨hab', hab⟩
    | refl a => exact SimpleGraph.Reachable.refl _
    | symm a b _ ih => exact ih.symm
    | trans a b c _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  · intro h
    rw [SimpleGraph.reachable_iff_reflTransGen] at h
    induction h with
    | refl => exact EqvGen.refl _
    | tail _ hbc ih => exact EqvGen.trans _ _ _ ih (EqvGen.rel _ _ hbc.2)

/-- **Single-linkage ultrametric.** For a dissimilarity `d`, `slDist d x y` is the infimum of the
scales `r ≥ 0` at which `x` and `y` are `r`-equivalent, i.e. the infimum over chains
`x = x₀, …, x_k = y` of the largest hop. On a finite set the infimum is attained and this is the
ultrametric `u*` of Carlsson and Mémoli (JMLR 11 (2010), Example 7, equation (4)), the
maximal sub-dominant ultrametric, which encodes the single-linkage dendrogram (Lemma 12 and
Cor. 14 there). -/
noncomputable def slDist (d : X → X → ℝ) (x y : X) : ℝ :=
  sInf {r : ℝ | 0 ≤ r ∧ SLEquiv d r x y}

theorem slDist_set_nonempty (d : X → X → ℝ) (x y : X) :
    {r : ℝ | 0 ≤ r ∧ SLEquiv d r x y}.Nonempty :=
  ⟨max (d x y) 0, le_max_right _ _, EqvGen.rel _ _ (le_max_left _ _)⟩

theorem slDist_set_bddBelow (d : X → X → ℝ) (x y : X) :
    BddBelow {r : ℝ | 0 ≤ r ∧ SLEquiv d r x y} :=
  ⟨0, fun _ h => h.1⟩

theorem slDist_nonneg (d : X → X → ℝ) (x y : X) : 0 ≤ slDist d x y :=
  le_csInf (slDist_set_nonempty d x y) fun _ h => h.1

theorem slDist_le_of_slEquiv {d : X → X → ℝ} {r : ℝ} (hr : 0 ≤ r) {x y : X}
    (h : SLEquiv d r x y) : slDist d x y ≤ r :=
  csInf_le (slDist_set_bddBelow d x y) ⟨hr, h⟩

/-- **The single-linkage ultrametric is below the dissimilarity.** `u*(x, y) ≤ d(x, y)`
whenever `d(x, y) ≥ 0` (Carlsson and Mémoli, JMLR 11 (2010), Example 7, the remark after
equation (4)). -/
theorem slDist_le {d : X → X → ℝ} {x y : X} (hd : 0 ≤ d x y) : slDist d x y ≤ d x y :=
  slDist_le_of_slEquiv hd (EqvGen.rel _ _ le_rfl)

theorem slDist_self (d : X → X → ℝ) (x : X) : slDist d x x = 0 :=
  le_antisymm (slDist_le_of_slEquiv le_rfl (EqvGen.refl _)) (slDist_nonneg d x x)

theorem slDist_comm (d : X → X → ℝ) (x y : X) : slDist d x y = slDist d y x := by
  unfold slDist
  congr 1
  ext r
  exact and_congr_right fun _ => ⟨EqvGen.symm _ _, EqvGen.symm _ _⟩

theorem exists_slEquiv_lt_slDist_add (d : X → X → ℝ) (x y : X) {ε : ℝ} (hε : 0 < ε) :
    ∃ r, 0 ≤ r ∧ SLEquiv d r x y ∧ r < slDist d x y + ε := by
  obtain ⟨r, hr, hlt⟩ :=
    exists_lt_of_csInf_lt (slDist_set_nonempty d x y) (lt_add_of_pos_right (slDist d x y) hε)
  exact ⟨r, hr.1, hr.2, hlt⟩

/-- **The single-linkage distance is an ultrametric.** `u*(x, z) ≤ max (u*(x, y)) (u*(y, z))`
(Carlsson and Mémoli, JMLR 11 (2010), §3.4, Example 7: `T*` is a hierarchical clustering
method, so its output is an ultrametric). -/
theorem slDist_le_max (d : X → X → ℝ) (x y z : X) :
    slDist d x z ≤ max (slDist d x y) (slDist d y z) := by
  refine le_of_forall_pos_lt_add fun ε hε => ?_
  obtain ⟨r, hr0, hr, hrlt⟩ := exists_slEquiv_lt_slDist_add d x y hε
  obtain ⟨s, -, hs, hslt⟩ := exists_slEquiv_lt_slDist_add d y z hε
  calc slDist d x z ≤ max r s := slDist_le_of_slEquiv (le_max_of_le_left hr0) (hr.trans_max hs)
    _ < max (slDist d x y) (slDist d y z) + ε := by
      rw [max_lt_iff]
      constructor
      · linarith [le_max_left (slDist d x y) (slDist d y z)]
      · linarith [le_max_right (slDist d x y) (slDist d y z)]

/-- **Single linkage gives the maximal subdominant ultrametric.** If `u` is symmetric, zero on
the diagonal, satisfies the ultrametric inequality and `u ≤ d`, then `u ≤ u*` (Carlsson and
Mémoli, JMLR 11 (2010), Example 7, the remark after equation (4)). Together with `slDist_le` and
`slDist_le_max`, `u*` is the largest ultrametric below `d` when `d ≥ 0`. -/
theorem le_slDist {d u : X → X → ℝ} (hud : ∀ x y, u x y ≤ d x y) (hself : ∀ x, u x x = 0)
    (hsymm : ∀ x y, u x y = u y x) (hmax : ∀ x y z, u x z ≤ max (u x y) (u y z)) (x y : X) :
    u x y ≤ slDist d x y := by
  refine le_csInf (slDist_set_nonempty d x y) ?_
  rintro r ⟨hr, h⟩
  induction h with
  | rel a b hab => exact (hud a b).trans hab
  | refl a => rw [hself]; exact hr
  | symm a b _ ih => rw [hsymm]; exact ih
  | trans a b c _ _ ih₁ ih₂ => exact (hmax a b c).trans (max_le ih₁ ih₂)

/-- **Stability of single linkage in the sup norm.** If two dissimilarities on the same set
satisfy `|d₁ x y - d₂ x y| ≤ η` for all `x, y`, then their single-linkage ultrametrics satisfy
`|u₁ x y - u₂ x y| ≤ η` for all `x, y` (Carlsson and Mémoli, JMLR 11 (2010), Lemma 15, stated
there for two metrics on a finite set; the chain argument needs neither hypothesis). -/
theorem abs_slDist_sub_le {d₁ d₂ : X → X → ℝ} {η : ℝ} (h : ∀ x y, |d₁ x y - d₂ x y| ≤ η)
    (x y : X) : |slDist d₁ x y - slDist d₂ x y| ≤ η := by
  have hη : 0 ≤ η := (abs_nonneg _).trans (h x x)
  have key : ∀ {e₁ e₂ : X → X → ℝ}, (∀ a b, e₂ a b ≤ e₁ a b + η) →
      slDist e₂ x y ≤ slDist e₁ x y + η := by
    intro e₁ e₂ he
    have : slDist e₂ x y - η ≤ slDist e₁ x y := by
      refine le_csInf (slDist_set_nonempty e₁ x y) ?_
      rintro r ⟨hr, hxy⟩
      have := slDist_le_of_slEquiv (add_nonneg hr hη) (hxy.of_le_add he)
      linarith
    linarith
  have h₁ := key (e₁ := d₂) (e₂ := d₁) fun a b => by
    have := h a b
    rw [abs_le] at this
    linarith
  have h₂ := key (e₁ := d₁) (e₂ := d₂) fun a b => by
    have := h a b
    rw [abs_le] at this
    linarith
  rw [abs_le]
  constructor <;> linarith

/-- **The dendrogram is the family of closed balls of `u*`.** On a finite set and for `r ≥ 0`,
`x` and `y` are `r`-equivalent if and only if `u*(x, y) ≤ r` (Carlsson and Mémoli, JMLR 11
(2010), Lemma 12 and Remark 13). Finiteness makes the infimum defining `u*` a minimum. -/
theorem slEquiv_iff_slDist_le [Finite X] {d : X → X → ℝ} {r : ℝ} (hr : 0 ≤ r) {x y : X} :
    SLEquiv d r x y ↔ slDist d x y ≤ r := by
  refine ⟨slDist_le_of_slEquiv hr, fun h => ?_⟩
  obtain ⟨δ, hδ, hgap⟩ : ∃ δ > 0, ∀ p q, d p q ≤ slDist d x y + δ → d p q ≤ slDist d x y := by
    classical
    have : Fintype X := Fintype.ofFinite X
    let F : Finset ℝ :=
      (Finset.univ.image fun p : X × X => d p.1 p.2).filter (slDist d x y < ·)
    have hmemF : ∀ p q, slDist d x y < d p q → d p q ∈ F := fun p q hlt =>
      Finset.mem_filter.2 ⟨Finset.mem_image.2 ⟨(p, q), Finset.mem_univ _, rfl⟩, hlt⟩
    by_cases hF : F.Nonempty
    · have hmin : slDist d x y < F.min' hF := (Finset.mem_filter.1 (F.min'_mem hF)).2
      refine ⟨(F.min' hF - slDist d x y) / 2, by linarith, fun p q hpq => ?_⟩
      by_contra hlt
      have := F.min'_le _ (hmemF p q (not_le.1 hlt))
      linarith
    · refine ⟨1, one_pos, fun p q _ => ?_⟩
      by_contra hlt
      exact hF ⟨d p q, hmemF p q (not_le.1 hlt)⟩
  obtain ⟨s, -, hs, hslt⟩ := exists_slEquiv_lt_slDist_add d x y hδ
  have h₁ : SLEquiv d (slDist d x y + δ) x y := hs.mono hslt.le
  have h₂ : SLEquiv d (slDist d x y) x y := EqvGen.mono (fun p q hpq => hgap p q hpq) _ _ h₁
  exact h₂.mono h

end MathlibExt.Topology.TDA
