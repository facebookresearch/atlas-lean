module

public import Mathlib.Topology.Constructions
public import Mathlib.Order.DirectedInverseSystem

@[expose] public section

/-!
# Direct limits of spaces over a preorder

This module formalizes the concrete direct limit from ATLAS NumberTheoryI,
Proposition 25.5: for a family `X` of spaces indexed by a preorder and
transition maps `f h : X i → X j` for `h : i ≤ j` forming a directed system
(`DirectedSystem`: `f i i le_rfl` is the identity and the transition maps
compose) with every transition map continuous, the direct limit is the
quotient of the disjoint union `Σ i, X i` by the equivalence relation
generated by `⟨i, x⟩ ~ ⟨j, f i j h x⟩`, equipped with the quotient topology.
It also records the universal property: a compatible family of continuous
maps `ψ i : X i → Y` induces a continuous map out of the limit.

The directed-system laws and the continuity of the transition maps are part
of the data of `Space`: without them the quotient need not be a direct
limit. For example, over a singleton preorder the lawless transition map
`Bool.not` would identify the two points of `Bool`, whereas the direct
limit of the identity system is `Bool` itself.

## Main definitions

* `TopologicalSpace.DirectLimit.Space`: the direct limit as a quotient of
  the disjoint union.
* `TopologicalSpace.DirectLimit.of`: the canonical maps `X i → Space`.
* `TopologicalSpace.DirectLimit.lift`: the map out of the limit induced by
  a compatible family.

## Main results

* `TopologicalSpace.DirectLimit.of_comp`: the canonical maps are
  compatible with the transition maps.
* `TopologicalSpace.DirectLimit.lift_continuous`: the induced map out of
  the limit is continuous when every component is.

## References

* ATLAS NumberTheoryI, Proposition 25.5 (restricted products as direct
  limits); see `MathlibExt/Topology/Algebra/RestrictedProduct/DirectLimit.lean`
  for the application.
-/

namespace TopologicalSpace.DirectLimit

section BasicDefs

variable {ι : Type*} [Preorder ι]
  (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
  (f : ∀ i j, i ≤ j → X i → X j)

/-- The generating relation for the direct limit of a directed system:
`⟨i, x⟩` is related to `⟨j, f i j h x⟩` whenever `i ≤ j`. -/
def Rel [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)] :
    (Σ i, X i) → (Σ i, X i) → Prop :=
  fun a b => ∃ (i j : ι) (h : i ≤ j) (x : X i),
    a = ⟨i, x⟩ ∧ b = ⟨j, f i j h x⟩

/-- The equivalence relation on the disjoint union generated by `Rel`. -/
def directLimitSetoid
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)] :
    Setoid (Σ i, X i) :=
  Relation.EqvGen.setoid (Rel X f)

end BasicDefs

/-- The direct limit of a directed system of topological spaces with
continuous transition maps, as a quotient of the disjoint union `Σ i, X i`
by the relation generated by the transition maps, with the quotient
topology. The `DirectedSystem` laws and the continuity hypothesis
`_hf_cont` are part of the data: they are what makes the quotient a direct
limit of topological spaces rather than an arbitrary quotient. -/
abbrev Space {ι : Type*} [Preorder ι]
    (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
    (f : ∀ i j, i ≤ j → X i → X j)
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (_hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h)) : Type _ :=
  @Quotient (Σ i, X i) (directLimitSetoid X f)

section Maps

variable {ι : Type*} [Preorder ι]
  (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
  (f : ∀ i j, i ≤ j → X i → X j)

/-- The canonical map from a factor into the direct limit. -/
def of [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    (i : ι) (x : X i) : Space X f hf_cont :=
  @Quotient.mk' _ (directLimitSetoid X f) ⟨i, x⟩

/-- The canonical maps into the direct limit are continuous. -/
theorem of_continuous
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h)) (i : ι) :
    Continuous (of X f hf_cont i) :=
  continuous_quotient_mk'.comp continuous_sigmaMk

/-- The canonical maps into the direct limit are compatible with the
transition maps. -/
theorem of_comp [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    {i j : ι} (h : i ≤ j) (x : X i) :
    of X f hf_cont j (f i j h x) = of X f hf_cont i x := by
  apply @Quotient.sound' _ (directLimitSetoid X f)
  exact (Relation.EqvGen.rel _ _ ⟨i, j, h, x, rfl, rfl⟩).symm

end Maps

section UniversalProperty

variable {ι : Type*} [Preorder ι]
  (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
  (f : ∀ i j, i ≤ j → X i → X j)

/-- The map out of the direct limit induced by a compatible family of maps. -/
noncomputable def lift
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    {Y : Type*} [TopologicalSpace Y]
    (ψ : ∀ i, X i → Y)
    (hψ_comp : ∀ i j (h : i ≤ j) (x : X i), ψ j (f i j h x) = ψ i x) :
    Space X f hf_cont → Y :=
  @Quotient.lift _ _ (directLimitSetoid X f) (fun σ => ψ σ.1 σ.2) <| by
    intro a b hab
    induction hab with
    | rel a b hr =>
      obtain ⟨i, j, h, x, rfl, rfl⟩ := hr
      exact (hψ_comp i j h x).symm
    | refl _ => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2

/-- The map out of the direct limit induced by a compatible family of
continuous maps is continuous. -/
theorem lift_continuous
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    {Y : Type*} [TopologicalSpace Y]
    (ψ : ∀ i, X i → Y)
    (hψ_cont : ∀ i, Continuous (ψ i))
    (hψ_comp : ∀ i j (h : i ≤ j) (x : X i), ψ j (f i j h x) = ψ i x) :
    Continuous (lift X f hf_cont ψ hψ_comp) := by
  unfold lift
  exact (continuous_sigma fun i => hψ_cont i).quotient_lift _

end UniversalProperty

end TopologicalSpace.DirectLimit
