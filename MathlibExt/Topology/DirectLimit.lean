module

public import Mathlib.Topology.Constructions
public import Mathlib.Order.DirectedInverseSystem

@[expose] public section

/-!
# Direct limits of spaces over a preorder

This module formalizes the concrete direct limit from ATLAS NumberTheoryI,
Proposition 25.5: for a family `X` of spaces indexed by a preorder and
transition maps `f h : X i → X j` for `h : i ≤ j` forming a directed system
(`DirectedSystem`: `f i i le_rfl` is the identity and the transition maps
compose) with every transition map continuous, the direct limit is the
quotient of the disjoint union `Σ i, X i` by the equivalence relation
generated by `⟨i, x⟩ ~ ⟨j, f i j h x⟩`, equipped with the quotient topology.
It also records the universal property: a compatible family of continuous
maps `ψ i : X i → Y` induces a continuous map out of the limit.

The directed-system laws and the continuity of the transition maps are part
of the data of `Space`: without them the quotient need not be a direct
limit. For example, over a singleton preorder the lawless transition map
`Bool.not` would identify the two points of `Bool`, whereas the direct
limit of the identity system is `Bool` itself.

## Main definitions

* `TopologicalSpace.DirectLimit.Space`: the direct limit as a quotient of
  the disjoint union.
* `TopologicalSpace.DirectLimit.of`: the canonical maps `X i → Space`.
* `TopologicalSpace.DirectLimit.lift`: the map out of the limit induced by
  a compatible family.

## Main results

* `TopologicalSpace.DirectLimit.of_comp`: the canonical maps are
  compatible with the transition maps.
* `TopologicalSpace.DirectLimit.lift_continuous`: the induced map out of
  the limit is continuous when every component is.

## References

* ATLAS NumberTheoryI, Proposition 25.5 (restricted products as direct
  limits); see `MathlibExt/Topology/Algebra/RestrictedProduct/DirectLimit.lean`
  for the application.
-/

namespace TopologicalSpace.DirectLimit

section BasicDefs

variable {ι : Type*} [Preorder ι]
  (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
  (f : ∀ i j, i ≤ j → X i → X j)

/-- **Generating relation of a direct limit.** Let $(X_i)_{i \in I}$ be a family of
topological spaces indexed by a preorder $I$, with maps $f_{ij} : X_i \to X_j$ for $i \le j$
forming a directed system ($f_{ii}$ is the identity and $f_{jk} \circ f_{ij} = f_{ik}$ for
$i \le j \le k$). This relation on the disjoint union $\bigsqcup_{i \in I} X_i$ relates
$(i, x)$ to $(j, f_{ij}(x))$ for all $i \le j$ and $x \in X_i$, and relates no other pairs. -/
def Rel [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)] :
    (Σ i, X i) → (Σ i, X i) → Prop :=
  fun a b => ∃ (i j : ι) (h : i ≤ j) (x : X i),
    a = ⟨i, x⟩ ∧ b = ⟨j, f i j h x⟩

/-- **Direct limit equivalence relation.** Let $(X_i)_{i \in I}$ be a family of topological
spaces indexed by a preorder $I$, with maps $f_{ij} : X_i \to X_j$ for $i \le j$ forming a
directed system. This is the smallest equivalence relation on the disjoint union
$\bigsqcup_{i \in I} X_i$ that relates $(i, x)$ to $(j, f_{ij}(x))$ for all $i \le j$ and
$x \in X_i$. -/
def directLimitSetoid
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)] :
    Setoid (Σ i, X i) :=
  Relation.EqvGen.setoid (Rel X f)

end BasicDefs

/-- **Direct limit of topological spaces.** Let $I$ be a preorder, $(X_i)_{i \in I}$ a family
of topological spaces, and $f_{ij} : X_i \to X_j$ for $i \le j$ continuous maps forming a
directed system ($f_{ii}$ is the identity and $f_{jk} \circ f_{ij} = f_{ik}$ for
$i \le j \le k$). The direct limit $\varinjlim X_i$ is the quotient of the disjoint union
$\bigsqcup_{i \in I} X_i$ by the equivalence relation generated by $(i, x) \sim (j, f_{ij}(x))$
for $i \le j$ and $x \in X_i$, with the quotient topology of the disjoint union topology.

The directed-system laws and the continuity of the transition maps are hypotheses of the
construction: the underlying quotient does not use them, but without them it need not be a
direct limit of topological spaces. -/
abbrev Space {ι : Type*} [Preorder ι]
    (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
    (f : ∀ i j, i ≤ j → X i → X j)
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (_hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h)) : Type _ :=
  @Quotient (Σ i, X i) (directLimitSetoid X f)

section Maps

variable {ι : Type*} [Preorder ι]
  (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
  (f : ∀ i j, i ≤ j → X i → X j)

/-- **Canonical map into the direct limit.** Let $(X_i)_{i \in I}$ be a directed system of
topological spaces over a preorder $I$ with continuous transition maps
$f_{ij} : X_i \to X_j$. For $i \in I$, the canonical map $\iota_i : X_i \to \varinjlim X_i$
into the direct limit sends $x$ to the class of $(i, x)$. -/
def of [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    (i : ι) (x : X i) : Space X f hf_cont :=
  @Quotient.mk' _ (directLimitSetoid X f) ⟨i, x⟩

/-- **Canonical maps into the direct limit are continuous.** Let $(X_i)_{i \in I}$ be a
directed system of topological spaces over a preorder $I$ with continuous transition maps
$f_{ij} : X_i \to X_j$. For every $i \in I$, the canonical map
$\iota_i : X_i \to \varinjlim X_i$ into the direct limit is continuous. -/
theorem of_continuous
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h)) (i : ι) :
    Continuous (of X f hf_cont i) :=
  continuous_quotient_mk'.comp continuous_sigmaMk

/-- **Canonical maps commute with the transition maps.** Let $(X_i)_{i \in I}$ be a directed
system of topological spaces over a preorder $I$ with continuous transition maps
$f_{ij} : X_i \to X_j$. The canonical maps $\iota_i : X_i \to \varinjlim X_i$ into the direct
limit satisfy $\iota_j(f_{ij}(x)) = \iota_i(x)$ for all $i \le j$ and $x \in X_i$. -/
theorem of_comp [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    {i j : ι} (h : i ≤ j) (x : X i) :
    of X f hf_cont j (f i j h x) = of X f hf_cont i x := by
  apply @Quotient.sound' _ (directLimitSetoid X f)
  exact (Relation.EqvGen.rel _ _ ⟨i, j, h, x, rfl, rfl⟩).symm

end Maps

section UniversalProperty

variable {ι : Type*} [Preorder ι]
  (X : ι → Type*) [∀ i, TopologicalSpace (X i)]
  (f : ∀ i j, i ≤ j → X i → X j)

/-- **Map out of the direct limit.** Let $(X_i)_{i \in I}$ be a directed system of
topological spaces over a preorder $I$ with continuous transition maps
$f_{ij} : X_i \to X_j$, and let $Y$ be a topological space. A family of maps
$\psi_i : X_i \to Y$ with $\psi_j(f_{ij}(x)) = \psi_i(x)$ for all $i \le j$ and $x \in X_i$
induces the map $\varinjlim X_i \to Y$ from the direct limit that sends the class of $(i, x)$
to $\psi_i(x)$. -/
noncomputable def lift
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    {Y : Type*} [TopologicalSpace Y]
    (ψ : ∀ i, X i → Y)
    (hψ_comp : ∀ i j (h : i ≤ j) (x : X i), ψ j (f i j h x) = ψ i x) :
    Space X f hf_cont → Y :=
  @Quotient.lift _ _ (directLimitSetoid X f) (fun σ => ψ σ.1 σ.2) <| by
    intro a b hab
    induction hab with
    | rel a b hr =>
      obtain ⟨i, j, h, x, rfl, rfl⟩ := hr
      exact (hψ_comp i j h x).symm
    | refl _ => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2

/-- **The induced map out of the direct limit is continuous.** Let $(X_i)_{i \in I}$ be a
directed system of topological spaces over a preorder $I$ with continuous transition maps
$f_{ij} : X_i \to X_j$, and let $Y$ be a topological space. If the maps
$\psi_i : X_i \to Y$ are continuous and satisfy $\psi_j(f_{ij}(x)) = \psi_i(x)$ for all
$i \le j$ and $x \in X_i$, then the induced map $\varinjlim X_i \to Y$ from the direct limit,
sending the class of $(i, x)$ to $\psi_i(x)$, is continuous. -/
theorem lift_continuous
    [DirectedSystem X (fun ⦃i j⦄ (h : i ≤ j) => f i j h)]
    (hf_cont : ∀ i j (h : i ≤ j), Continuous (f i j h))
    {Y : Type*} [TopologicalSpace Y]
    (ψ : ∀ i, X i → Y)
    (hψ_cont : ∀ i, Continuous (ψ i))
    (hψ_comp : ∀ i j (h : i ≤ j) (x : X i), ψ j (f i j h x) = ψ i x) :
    Continuous (lift X f hf_cont ψ hψ_comp) := by
  unfold lift
  exact (continuous_sigma fun i => hψ_cont i).quotient_lift _

end UniversalProperty

end TopologicalSpace.DirectLimit
