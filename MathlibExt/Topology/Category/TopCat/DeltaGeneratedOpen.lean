-- Author: @toskua, Avocado
module

public import Mathlib.Topology.Convenient.OpenClosed
public import Mathlib.Topology.Category.DeltaGenerated
public import Mathlib.Analysis.Normed.Module.Ball.Homeomorph
public import MathlibExt.Topology.Category.TopCat.PreimageSubspacePullback

/-!
# Open subspaces and restriction in delta-generated topology

A delta-generated space has its topology generated by continuous maps from finite-dimensional
real Euclidean spaces. Every open subspace of such a space is again delta-generated; open
subsets of the Euclidean generators are covered by open balls homeomorphic to those
generators.

For f : X → Y, suppose delta-generated coreflection sends f to an isomorphism. For any subset
U ⊆ Y whose subspace and inverse-image subspace are delta-generated, the restricted map f⁻¹(U)
→ U is an isomorphism in TopCat. The subset need not be open when these two
delta-generatedness hypotheses are supplied.
-/

@[expose] public section

open CategoryTheory Limits Set Metric Topology

noncomputable section

universe u

private theorem open_finEuclidean_isGeneratedBy
    (n : ℕ) (U : TopologicalSpace.Opens (Fin n → ℝ)) :
    IsGeneratedBy (fun n : ℕ ↦ Fin n → ℝ) U := by
  classical
  let E := Fin n → ℝ
  have hex : ∀ x : U, ∃ ε > 0, ball (x : E) ε ⊆ U := by
    intro x
    exact Metric.isOpen_iff.mp U.isOpen x x.property
  choose ε hε hball using hex
  have hmem (x : U) (v : E) :
      OpenPartialHomeomorph.univBall (x : E) (ε x) v ∈ U := by
    apply hball x
    have hv : OpenPartialHomeomorph.univBall (x : E) (ε x) v ∈
        (OpenPartialHomeomorph.univBall (x : E) (ε x)).target :=
      (OpenPartialHomeomorph.univBall (x : E) (ε x)).map_source (by
        rw [OpenPartialHomeomorph.univBall_source]
        exact Set.mem_univ v)
    rwa [OpenPartialHomeomorph.univBall_target (x : E) (hε x)] at hv
  let f : (Σ _x : U, E) → U := fun z =>
    ⟨OpenPartialHomeomorph.univBall (z.1 : E) (ε z.1) z.2,
      hmem z.1 z.2⟩
  have hf_cont : Continuous f := by
    apply continuous_sigma
    intro x
    exact (OpenPartialHomeomorph.continuous_univBall
      (x : E) (ε x)).codRestrict (hmem x)
  have hf_open : IsOpenMap f := by
    rw [isOpenMap_sigma]
    intro x
    exact ((OpenPartialHomeomorph.univBall (x : E) (ε x)).isOpenEmbedding
      (OpenPartialHomeomorph.univBall_source
        (x : E) (ε x))).isOpenMap.codRestrict (hmem x)
  have hf_surj : Function.Surjective f := by
    intro x
    refine ⟨⟨x, 0⟩, ?_⟩
    apply Subtype.ext
    exact OpenPartialHomeomorph.univBall_apply_zero (x : E) (ε x)
  let _ : ∀ _x : U,
      IsGeneratedBy (fun n : ℕ ↦ Fin n → ℝ) E :=
    fun _ => inferInstance
  let _ : IsGeneratedBy (fun n : ℕ ↦ Fin n → ℝ) (Σ _x : U, E) :=
    inferInstance
  exact (hf_open.isQuotientMap hf_cont hf_surj).isGeneratedBy

/-- Delta-generatedness of an open subspace.

If Y is delta-generated and U ⊆ Y is open, then the subspace U is delta-generated, with
generator family Fin n → ℝ for n : ℕ. -/
theorem IsOpen.deltaGeneratedSpace
    {Y : Type u} [TopologicalSpace Y] [DeltaGeneratedSpace Y]
    {U : Set Y} (hU : IsOpen U) : DeltaGeneratedSpace U := by
  let _ (n : ℕ) (V : TopologicalSpace.Opens (Fin n → ℝ)) :
      IsGeneratedBy (fun n : ℕ ↦ Fin n → ℝ) V :=
    open_finEuclidean_isGeneratedBy n V
  exact hU.isGeneratedBy

private theorem counit_isIso_of_deltaGenerated (Z : TopCat.{u})
    [DeltaGeneratedSpace Z] :
    IsIso ((GeneratedByTopCat.adjCounit
      (X := fun n : ℕ ↦ Fin n → ℝ)).app Z) := by
  let e : ((TopCat.toGeneratedByTopCat ⋙
      GeneratedByTopCat.toTopCat).obj Z) ≅ Z :=
    TopCat.isoOfHomeo (Topology.IsGeneratedBy.homeomorph
      (X := fun n : ℕ ↦ Fin n → ℝ) (Y := Z))
  have he : (GeneratedByTopCat.adjCounit
      (X := fun n : ℕ ↦ Fin n → ℝ)).app Z = e.hom := by
    apply TopCat.hom_ext
    rfl
  rw [he]
  infer_instance

private theorem TopCat.isIso_of_toDeltaGenerated_map_isIso
    {X Y : TopCat.{u}} (f : X ⟶ Y)
    [DeltaGeneratedSpace X] [DeltaGeneratedSpace Y]
    [IsIso (TopCat.toDeltaGenerated.map f)] : IsIso f := by
  let cX := (GeneratedByTopCat.adjCounit
    (X := fun n : ℕ ↦ Fin n → ℝ)).app X
  let cY := (GeneratedByTopCat.adjCounit
    (X := fun n : ℕ ↦ Fin n → ℝ)).app Y
  let _ : IsIso cX := counit_isIso_of_deltaGenerated X
  let _ : IsIso cY := counit_isIso_of_deltaGenerated Y
  let _ : IsIso (GeneratedByTopCat.toTopCat.map
      (TopCat.toDeltaGenerated.map f)) := Functor.map_isIso _ _
  have hnat : GeneratedByTopCat.toTopCat.map
      (TopCat.toDeltaGenerated.map f) ≫ cY = cX ≫ f :=
    (GeneratedByTopCat.adjCounit
      (X := fun n : ℕ ↦ Fin n → ℝ)).naturality f
  let _ : IsIso (cX ≫ f) := by
    rw [← hnat]
    infer_instance
  exact IsIso.of_isIso_comp_left cX f

/-- Isomorphism of restrictions detected by delta-generated coreflection.

For f : X → Y in TopCat and U ⊆ Y, assume f⁻¹(U) and U are delta-generated and
TopCat.toDeltaGenerated.map f is an isomorphism. Then the canonical restricted map f⁻¹(U) → U
is an isomorphism. These are hypotheses on the restricted spaces, without requiring X or Y
globally delta-generated. -/
theorem TopCat.isIso_subspaceMap_of_toDeltaGenerated_map_isIso
    {X Y : TopCat.{u}} (f : X ⟶ Y) (U : Set Y)
    [DeltaGeneratedSpace (f ⁻¹' U)] [DeltaGeneratedSpace U]
    [IsIso (TopCat.toDeltaGenerated.map f)] :
    IsIso (TopCat.subspaceMap f
      (fun _x hx => hx : Set.MapsTo f (f ⁻¹' U) U)) := by
  let fU := TopCat.subspaceMap f
    (fun _x hx => hx : Set.MapsTo f (f ⁻¹' U) U)
  have hs := (TopCat.isPullback_preimageSubspace f U).map
    TopCat.toDeltaGenerated
  let _ : IsIso (TopCat.toDeltaGenerated.map fU) :=
    hs.isIso_fst_of_isIso
  let _ : DeltaGeneratedSpace (TopCat.of (f ⁻¹' U) : Type u) :=
    inferInstanceAs (DeltaGeneratedSpace (f ⁻¹' U))
  let _ : DeltaGeneratedSpace (TopCat.of U : Type u) :=
    inferInstanceAs (DeltaGeneratedSpace U)
  exact @TopCat.isIso_of_toDeltaGenerated_map_isIso
    (TopCat.of (f ⁻¹' U)) (TopCat.of U) fU
    (inferInstanceAs (DeltaGeneratedSpace (f ⁻¹' U)))
    (inferInstanceAs (DeltaGeneratedSpace U)) inferInstance
