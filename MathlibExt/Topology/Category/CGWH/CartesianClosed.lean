module

public import MathlibExt.Topology.Category.CGWH.CartesianMonoidal
public import MathlibExt.Topology.Category.CGWH.CartesianMonoidalComputations
public import MathlibExt.Topology.Category.CGWH.GeneratedHom
public import Mathlib.Topology.Convenient.HomSpace
public import Mathlib.CategoryTheory.Monoidal.Closed.Enrichment

import MathlibExt.CategoryTheory.Monoidal.PreservesColimits

/-!
# Cartesian closed structure on CGWH spaces

The native mapping object is the compact-Hausdorff-generated topology on
probe-continuous maps, compactly generated once more.  Its weak Hausdorff
property is proved pointwise, by intersecting the closed equalizers obtained
from fixed-point evaluation.

The closed adjunction uses the selected native tensor product.  It is related
to the raw product of carriers only by the canonical carrier equivalence; no
ordinary-product homeomorphism and no compact-open comparison is asserted.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

universe u v

open CategoryTheory CategoryTheory.Limits Topology MonoidalCategory

namespace CGWH

/-- The native internal-Hom object of compactly generated weak Hausdorff
spaces.  Its topology is generated by compact Hausdorff probes. -/
noncomputable def internalHom (A B : CGWH.{u, v}) : CGWH.{u, v} := by
  let P := CompactlyGenerated.compactHausProbes.{u}
  let Raw := ContinuousMapGeneratedBy P A B
  let H := WithGeneratedByTopology P Raw
  let _ : UCompactlyGeneratedSpace.{u} H :=
    (isGeneratedBy_compactHausProbes_iff (Y := H)).1 inferInstance
  have hWeak : UWeakHausdorffSpace.{u} H := by
    rw [uWeakHausdorffSpace_iff_isClosed_equalizer]
    intro K f g
    have hSet : {k | f k = g k} =
        ⋂ a : A, {k |
          (WithGeneratedByTopology.equiv (f k) : Raw) a =
            (WithGeneratedByTopology.equiv (g k) : Raw) a} := by
      ext k
      simp only [Set.mem_ofPred_eq, Set.mem_iInter]
      constructor
      · intro h a
        rw [h]
      · intro h
        apply WithGeneratedByTopology.equiv.injective
        apply ContinuousMapGeneratedBy.ext
        funext a
        exact h a
    rw [hSet]
    apply isClosed_iInter
    intro a
    let pointProbe : CompHaus.{u} := CompHaus.of PUnit.{u + 1}
    let constA : C(pointProbe, A) :=
      ⟨fun _ ↦ a, continuous_const⟩
    let evalAt : C(H, B) :=
      ⟨fun h ↦ ContinuousMapGeneratedBy.precomp (X := P) constA
          (WithGeneratedByTopology.equiv h : Raw) PUnit.unit,
        by fun_prop⟩
    simpa [evalAt, constA, pointProbe] using
      (uWeakHausdorffSpace_iff_isClosed_equalizer.mp inferInstance)
        K (evalAt.comp f) (evalAt.comp g)
  let _ : UWeakHausdorffSpace.{u} H := hWeak
  exact CGWH.of H

/-- The native internal-Hom carrier is weak Hausdorff. -/
theorem internalHom_isWeakHausdorff (A B : CGWH.{u, v}) :
    UWeakHausdorffSpace.{u} (internalHom A B) :=
  inferInstance

/-- Postcomposition makes the native internal Hom functorial in its target. -/
noncomputable def internalHomFunctor (A : CGWH.{u, v}) :
    CGWH.{u, v} ⥤ CGWH.{u, v} where
  obj B := internalHom A B
  map {B B'} f := by
    letI : ∀ K L : CompHaus.{u},
        IsGeneratedBy CompactlyGenerated.compactHausProbes.{u} (K × L) :=
      fun K L ↦ by
        change IsGeneratedBy CompactlyGenerated.compactHausProbes.{u}
          (CompactlyGenerated.compactHausProbes (CompHaus.of (K × L)))
        infer_instance
    let p : ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} B B' :=
      ⟨f, (ConcreteCategory.hom f).continuous.continuousGeneratedBy⟩
    exact ConcreteCategory.ofHom
      (ContinuousMapGeneratedBy.postcomp
        (Y := A) p).prop.continuousMap
  map_id B := by
    apply ConcreteCategory.hom_ext
    intro h
    apply (WithGeneratedByTopology.equiv
      (X := CompactlyGenerated.compactHausProbes.{u})
      (Y := ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B)).injective
    apply ContinuousMapGeneratedBy.ext
    funext a
    rfl
  map_comp {B B' B''} f g := by
    apply ConcreteCategory.hom_ext
    intro h
    apply (WithGeneratedByTopology.equiv
      (X := CompactlyGenerated.compactHausProbes.{u})
      (Y := ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B'')).injective
    apply ContinuousMapGeneratedBy.ext
    funext a
    rfl

end CGWH

namespace CGWH

private theorem tensorEquivProd_whiskerLeft
    (A : CGWH.{u, v}) {Y Y' : CGWH.{u, v}} (f : Y ⟶ Y')
    (z : (A ⊗ Y : CGWH.{u, v})) :
    tensorEquivProd A Y' ((A ◁ f) z) =
      ((tensorEquivProd A Y z).1, f (tensorEquivProd A Y z).2) := by
  apply Prod.ext
  · rw [tensorEquivProd_apply_fst, tensorEquivProd_apply_fst]
    have hz := ConcreteCategory.congr_hom
      (CartesianMonoidalCategory.whiskerLeft_fst A f) z
    change (CartesianMonoidalCategory.fst A Y') ((A ◁ f) z) =
      (CartesianMonoidalCategory.fst A Y) z at hz
    exact hz
  · rw [tensorEquivProd_apply_snd, tensorEquivProd_apply_snd]
    have hz := ConcreteCategory.congr_hom
      (CartesianMonoidalCategory.whiskerLeft_snd A f) z
    change (CartesianMonoidalCategory.snd A Y') ((A ◁ f) z) =
      f ((CartesianMonoidalCategory.snd A Y) z) at hz
    exact hz

private noncomputable def curryHom {A Y B : CGWH.{u, v}}
    (f : A ⊗ Y ⟶ B) : Y ⟶ internalHom A B := by
  let P := CompactlyGenerated.compactHausProbes.{u}
  letI : ∀ K L : CompHaus.{u}, IsGeneratedBy P (K × L) :=
    fun K L ↦ by
      change IsGeneratedBy P (P (CompHaus.of (K × L)))
      infer_instance
  let q : ContinuousMapGeneratedBy P (A × Y) B :=
    ⟨fun p ↦ f ((tensorEquivProd A Y).symm p),
      (ConcreteCategory.hom f).continuous.continuousGeneratedBy.comp
        (tensorEquivProd_symm_continuousGeneratedBy A Y)⟩
  let c : ContinuousMapGeneratedBy P Y (ContinuousMapGeneratedBy P A B) :=
    ContinuousMapGeneratedBy.curryEquiv q
  let c' : ContinuousMapGeneratedBy P Y
      (WithGeneratedByTopology P (ContinuousMapGeneratedBy P A B)) :=
    (WithGeneratedByTopology.equivSymmAsContinuousMapGeneratedBy P
      (ContinuousMapGeneratedBy P A B)).comp c
  let _ : IsGeneratedBy P Y :=
    (isGeneratedBy_compactHausProbes_iff (Y := Y)).2 inferInstance
  exact ConcreteCategory.ofHom
    ⟨c', (IsGeneratedBy.continuous_iff P c').2 c'.prop⟩

private noncomputable def uncurryHom {A Y B : CGWH.{u, v}}
    (g : Y ⟶ internalHom A B) : A ⊗ Y ⟶ B := by
  let P := CompactlyGenerated.compactHausProbes.{u}
  letI : ∀ K L : CompHaus.{u}, IsGeneratedBy P (K × L) :=
    fun K L ↦ by
      change IsGeneratedBy P (P (CompHaus.of (K × L)))
      infer_instance
  let g' : ContinuousMapGeneratedBy P Y
      (WithGeneratedByTopology P (ContinuousMapGeneratedBy P A B)) :=
    ⟨g, (ConcreteCategory.hom g).continuous.continuousGeneratedBy⟩
  let gRaw : ContinuousMapGeneratedBy P Y
      (ContinuousMapGeneratedBy P A B) :=
    (WithGeneratedByTopology.equivAsContinuousMapGeneratedBy P
      (ContinuousMapGeneratedBy P A B)).comp g'
  let q : ContinuousMapGeneratedBy P (A × Y) B :=
    ContinuousMapGeneratedBy.curryEquiv.symm gRaw
  have hTensor : Continuous (tensorEquivProd A Y) :=
    (ConcreteCategory.hom
      (CartesianMonoidalCategory.fst A Y)).continuous.prodMk
        (ConcreteCategory.hom
          (CartesianMonoidalCategory.snd A Y)).continuous
  let t : ContinuousMapGeneratedBy P (A ⊗ Y : CGWH.{u, v}) (A × Y) :=
    ⟨tensorEquivProd A Y, hTensor.continuousGeneratedBy⟩
  let q' : ContinuousMapGeneratedBy P (A ⊗ Y : CGWH.{u, v}) B :=
    q.comp t
  let _ : IsGeneratedBy P (A ⊗ Y : CGWH.{u, v}) :=
    (isGeneratedBy_compactHausProbes_iff
      (Y := (A ⊗ Y : CGWH.{u, v}))).2 inferInstance
  exact ConcreteCategory.ofHom
    ⟨q', (IsGeneratedBy.continuous_iff P q').2 q'.prop⟩

/-- Currying in compactly generated weak Hausdorff spaces identifies
`A ⊗ Y ⟶ B` with `Y ⟶ internalHom A B`, with `Y` as the parameter.
The internal Hom carries the topology generated by compact Hausdorff probes. -/
@[no_expose] noncomputable def internalHomEquiv
    (A Y B : CGWH.{u, v}) :
    (A ⊗ Y ⟶ B) ≃ (Y ⟶ internalHom A B) where
  toFun := curryHom
  invFun := uncurryHom
  left_inv f := by
    apply ConcreteCategory.hom_ext
    intro z
    change f ((tensorEquivProd A Y).symm (tensorEquivProd A Y z)) = f z
    rw [Equiv.symm_apply_apply]
  right_inv g := by
    apply ConcreteCategory.hom_ext
    intro y
    apply (WithGeneratedByTopology.equiv
      (X := CompactlyGenerated.compactHausProbes.{u})
      (Y := ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B)).injective
    apply ContinuousMapGeneratedBy.ext
    funext a
    change (WithGeneratedByTopology.equiv
      (X := CompactlyGenerated.compactHausProbes.{u})
      (Y := ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B)
      (g (tensorEquivProd A Y
        ((tensorEquivProd A Y).symm (a, y))).2) :
          ContinuousMapGeneratedBy
            CompactlyGenerated.compactHausProbes.{u} A B)
        (tensorEquivProd A Y
          ((tensorEquivProd A Y).symm (a, y))).1 =
      (WithGeneratedByTopology.equiv
        (X := CompactlyGenerated.compactHausProbes.{u})
        (Y := ContinuousMapGeneratedBy
          CompactlyGenerated.compactHausProbes.{u} A B) (g y) :
        ContinuousMapGeneratedBy
          CompactlyGenerated.compactHausProbes.{u} A B) a
    rw [Equiv.apply_symm_apply]

end CGWH

@[expose] public section

namespace CGWH

/-- The selected tensor product by `A` is left adjoint to the native
internal-Hom functor out of `A`. -/
noncomputable def internalHomAdjunction (A : CGWH.{u, v}) :
    tensorLeft A ⊣ internalHomFunctor A :=
  Adjunction.mkOfHomEquiv
    { homEquiv := internalHomEquiv A
      homEquiv_naturality_left_symm := by
        intro Y' Y B f g
        apply ConcreteCategory.hom_ext
        intro z
        let P := CompactlyGenerated.compactHausProbes.{u}
        let Raw := ContinuousMapGeneratedBy P A B
        change (WithGeneratedByTopology.equiv
            (X := P) (Y := Raw)
            (g (f (tensorEquivProd A Y' z).2)) : Raw)
              (tensorEquivProd A Y' z).1 =
          (WithGeneratedByTopology.equiv
            (X := P) (Y := Raw)
            (g (tensorEquivProd A Y ((A ◁ f) z)).2) : Raw)
              (tensorEquivProd A Y ((A ◁ f) z)).1
        rw [tensorEquivProd_whiskerLeft]
      homEquiv_naturality_right := by
        intro Y B B' f g
        apply ConcreteCategory.hom_ext
        intro y
        let P := CompactlyGenerated.compactHausProbes.{u}
        let Raw := ContinuousMapGeneratedBy P A B'
        apply (WithGeneratedByTopology.equiv
          (X := P) (Y := Raw)).injective
        apply ContinuousMapGeneratedBy.ext
        funext a
        rfl }

/-- The native cartesian monoidal structure on CGWH is closed. -/
noncomputable instance instMonoidalClosed :
    MonoidalClosed CGWH.{u, v} where
  closed A :=
    { rightAdj := internalHomFunctor A
      adj := internalHomAdjunction A }

/-- Tensoring on the right by any fixed CGWH space preserves all colimits.
This is transported from the closed fixed-left tensor functor using the
cartesian braiding, installed only locally to avoid a global instance diamond. -/
noncomputable instance tensorRightPreservesColimits (A : CGWH.{u, v}) :
    PreservesColimits (tensorRight A) := by
  let _ : BraidedCategory CGWH.{u, v} :=
    .ofCartesianMonoidalCategory
  exact preservesColimits_of_natIso
    (BraidedCategory.tensorLeftIsoTensorRight A)

/-- The internal-Hom object selected by the closed instance is the native
generated mapping object. -/
theorem ihom_obj_eq_internalHom (A B : CGWH.{u, v}) :
    (ihom A).obj B = internalHom A B :=
  rfl

/-- The compact-generation counit from the native internal Hom to the raw
compact-Hausdorff-generated mapping topology.  It is the identity on the
underlying carrier. -/
noncomputable def internalHomToRawGenerated (A B : CGWH.{u, v}) :
    cgwhToTop.obj (internalHom A B) ⟶
      TopCat.of (ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B) :=
  TopCat.ofHom
    ⟨WithGeneratedByTopology.equiv,
      WithGeneratedByTopology.continuous_equiv⟩

/-- Evaluation of the native internal Hom has the expected pointwise value on
the raw compact-Hausdorff-generated mapping carrier. -/
theorem internalHom_ev_apply
    (A B : CGWH.{u, v})
    (z : (A ⊗ internalHom A B : CGWH.{u, v})) :
    (ihom.ev A).app B z =
      (WithGeneratedByTopology.equiv
        (X := CompactlyGenerated.compactHausProbes.{u})
        (Y := ContinuousMapGeneratedBy
          CompactlyGenerated.compactHausProbes.{u} A B)
        (CartesianMonoidalCategory.snd A (internalHom A B) z) :
          ContinuousMapGeneratedBy
            CompactlyGenerated.compactHausProbes.{u} A B)
        (CartesianMonoidalCategory.fst A (internalHom A B) z) := by
  change
    (WithGeneratedByTopology.equiv
      (X := CompactlyGenerated.compactHausProbes.{u})
      (Y := ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B)
      (tensorEquivProd A (internalHom A B) z).2 :
        ContinuousMapGeneratedBy
          CompactlyGenerated.compactHausProbes.{u} A B)
      (tensorEquivProd A (internalHom A B) z).1 = _
  rw [tensorEquivProd_apply_snd, tensorEquivProd_apply_fst]

/-- The raw generated carrier of native currying evaluates to the original
map on the corresponding Cartesian projections. -/
theorem internalHom_curry_apply
    {A Y B : CGWH.{u, v}} (f : A ⊗ Y ⟶ B)
    (z : (A ⊗ Y : CGWH.{u, v})) :
    (WithGeneratedByTopology.equiv
      (X := CompactlyGenerated.compactHausProbes.{u})
      (Y := ContinuousMapGeneratedBy
        CompactlyGenerated.compactHausProbes.{u} A B)
      (MonoidalClosed.curry f
        (CartesianMonoidalCategory.snd A Y z)) :
        ContinuousMapGeneratedBy
          CompactlyGenerated.compactHausProbes.{u} A B)
      (CartesianMonoidalCategory.fst A Y z) =
    f z := by
  change f ((tensorEquivProd A Y).symm
    (CartesianMonoidalCategory.fst A Y z,
      CartesianMonoidalCategory.snd A Y z)) = f z
  rw [← tensorEquivProd_apply_fst, ← tensorEquivProd_apply_snd]
  simp

end CGWH
