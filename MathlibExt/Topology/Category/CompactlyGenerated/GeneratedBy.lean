-- Author: @toskua, Avocado
module

public import Mathlib.Topology.Category.CompactlyGenerated
public import Mathlib.Topology.Convenient.Category

/-!
# Compact generation as a generated topology

This file identifies Mathlib's category of compactly generated spaces with the generic category
generated by compact Hausdorff probes. The existing generic coreflection is then transported to the
existing `CompactlyGenerated` carrier.
-/

@[expose] public section

universe u v

open CategoryTheory Topology

namespace CompactlyGenerated

/-- The family of all compact Hausdorff probes in universe `u`. -/
abbrev compactHausProbes : CompHaus.{u} → Type u := fun K ↦ K

end CompactlyGenerated

namespace TopologicalSpace

/-- The topology generated by compact Hausdorff probes is the compactly generated topology. -/
theorem generatedBy_compactHausProbes_eq_compactlyGenerated
    {Y : Type v} [TopologicalSpace Y] :
    generatedBy CompactlyGenerated.compactHausProbes.{u} (Y := Y) =
      compactlyGenerated.{u} Y := by
  rw [generatedBy_eq_coinduced]
  rfl

end TopologicalSpace

namespace Topology

/-- Being generated by compact Hausdorff probes is equivalent to compact generation. -/
theorem isGeneratedBy_compactHausProbes_iff
    {Y : Type v} [TopologicalSpace Y] :
    IsGeneratedBy CompactlyGenerated.compactHausProbes.{u} Y ↔
      UCompactlyGeneratedSpace.{u} Y := by
  rw [IsGeneratedBy.iff_le_generatedBy,
    TopologicalSpace.generatedBy_compactHausProbes_eq_compactlyGenerated]
  exact ⟨fun h ↦ ⟨h⟩, fun h ↦ h.le_compactlyGenerated⟩

end Topology

end

universe u v

open CategoryTheory Topology

@[expose] public section

namespace CompactlyGenerated

/-- Compactly generated spaces are the spaces generated by all compact Hausdorff probes. -/
def equivalenceGeneratedByTopCat :
    CompactlyGenerated.{u, v} ≌ GeneratedByTopCat.{v} compactHausProbes.{u} :=
  let toGeneratedByTopCat :
      CompactlyGenerated.{u, v} ⥤ GeneratedByTopCat.{v} compactHausProbes.{u} :=
    { obj := fun X ↦
        { obj := X.toTop
          property :=
            (Topology.isGeneratedBy_compactHausProbes_iff (Y := X)).2 inferInstance }
      map := fun f ↦ ObjectProperty.homMk f.hom
      map_id := fun _ ↦ rfl
      map_comp := fun _ _ ↦ rfl }
  let fromGeneratedByTopCat :
      GeneratedByTopCat.{v} compactHausProbes.{u} ⥤ CompactlyGenerated.{u, v} :=
    { obj := fun X ↦
        { toTop := X.obj
          is_compactly_generated :=
            (Topology.isGeneratedBy_compactHausProbes_iff (Y := X)).1 X.property }
      map := fun f ↦ InducedCategory.homMk f.hom
      map_id := fun _ ↦ rfl
      map_comp := fun _ _ ↦ rfl }
  let unitIso : 𝟭 (CompactlyGenerated.{u, v}) ≅
      toGeneratedByTopCat ⋙ fromGeneratedByTopCat :=
    NatIso.ofComponents (fun _ ↦
      fullyFaithfulCompactlyGeneratedToTop.preimageIso (Iso.refl _)) (fun f ↦ by
        apply compactlyGeneratedToTop.map_injective
        rfl)
  let counitIso : fromGeneratedByTopCat ⋙ toGeneratedByTopCat ≅
      𝟭 (GeneratedByTopCat.{v} compactHausProbes.{u}) :=
    NatIso.ofComponents (fun _ ↦
      (GeneratedByTopCat.fullyFaithfulToTopCat compactHausProbes).preimageIso (Iso.refl _))
        (fun f ↦ by
          apply GeneratedByTopCat.toTopCat.map_injective
          rfl)
  { functor := toGeneratedByTopCat
    inverse := fromGeneratedByTopCat
    unitIso := unitIso
    counitIso := counitIso }

end CompactlyGenerated

namespace TopCat

/-- Equip a topological space with its compactly generated topology. -/
def toCompactlyGenerated : TopCat.{v} ⥤ CompactlyGenerated.{u, v} :=
  toGeneratedByTopCat (X := CompactlyGenerated.compactHausProbes.{u}) ⋙
    CompactlyGenerated.equivalenceGeneratedByTopCat.inverse

end TopCat

namespace CompactlyGenerated

/-- The inclusion of compactly generated spaces is left adjoint to compact generation. -/
def adj : compactlyGeneratedToTop.{u, v} ⊣ TopCat.toCompactlyGenerated.{u, v} :=
  let e := equivalenceGeneratedByTopCat.{u, v}
  let eToTop : e.functor ⋙ GeneratedByTopCat.toTopCat ≅ compactlyGeneratedToTop :=
    Iso.refl _
  (e.toAdjunction.comp
    (GeneratedByTopCat.adj (X := compactHausProbes.{u}))).ofNatIsoLeft eToTop

instance : Coreflective compactlyGeneratedToTop.{u, v} where
  R := TopCat.toCompactlyGenerated
  adj := adj

end CompactlyGenerated

end
