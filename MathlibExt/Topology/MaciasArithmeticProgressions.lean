module

public import MathlibExt.Topology.MaciasCoprimeTopology
import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise
import Mathlib.Data.Nat.GCD.BigOperators
import Mathlib.Data.Nat.PrimeFin
import Mathlib.Topology.Bases

/-!
# Arithmetic progressions in the comaximal space

For a basic open set indexed by `n`, choose the progression index to be the product of the
prime divisors of `n` that do not divide the initial term.
-/

namespace MetaMathlibExt

open MathlibExt.Topology.MaciasCoprimeTopologyWanted

/-- **Coprime arithmetic progressions are dense in the comaximal space.** Equip the positive
integers with the comaximal topology, the topology generated by the sets
$\{m : \gcd(n, m) = 1\}$ for positive integers $n$. If $a$ and $b$ are coprime positive integers,
then the arithmetic progression $\{ak + b : k \in \mathbb{N}\} = \{b, a + b, 2a + b, \dots\}$,
with $k$ ranging over the natural numbers including $0$, is dense in this topology.

Source: Jhixon Macías, *A Topological Proof of the Infinitude of Prime Numbers in Certain
Arithmetic Progressions*, INTEGERS 26 (2026), Article A39, Lemma 2. -/
public theorem dense_maciasTopology_arithmeticProgression (a b : ℕ+)
    (hab : Nat.Coprime a b) :
    @Dense ℕ+ maciasTopology {m : ℕ+ | ∃ k : ℕ, (m : ℕ) = a * k + b} := by
  let := maciasTopology
  have hInter : FiniteInter maciasBasis := by
    constructor
    · exact ⟨1, Set.eq_univ_of_forall fun m ↦ Nat.coprime_one_left (m : ℕ)⟩
    · rintro _ ⟨r, rfl⟩ _ ⟨s, rfl⟩
      exact ⟨⟨r * s, Nat.mul_pos r.pos s.pos⟩, Set.ext fun _ ↦ Nat.coprime_mul_iff_left⟩
  apply (TopologicalSpace.isTopologicalBasis_of_subbasis_of_finiteInter rfl hInter).dense_iff.mpr
  rintro _ ⟨n, rfl⟩ _
  let factors := (n : ℕ).primeFactors.filter fun p ↦ p.Coprime b
  let k := factors.prod id
  have hkb : k.Coprime b := Nat.Coprime.prod_left fun _ hp ↦ (Finset.mem_filter.mp hp).2
  refine ⟨⟨a * k + b, Nat.add_pos_right _ b.pos⟩, ?_, k, rfl⟩
  refine Nat.coprime_of_dvd fun p hp hpn ↦ hp.coprime_iff_not_dvd.mp ?_
  by_cases hpb : p.Coprime b
  · have hpk : p ∣ k := Finset.dvd_prod_of_mem id <| Finset.mem_filter.mpr
        ⟨Nat.mem_primeFactors.mpr ⟨hp, hpn, n.ne_zero⟩, hpb⟩
    exact (Nat.coprime_add_iff_right (hpk.mul_left (a : ℕ))).mpr hpb
  · have hdvd := hp.dvd_iff_not_coprime.mpr hpb
    exact (Nat.coprime_add_iff_left hdvd).mpr ((hab.mul_left hkb).symm.of_dvd_left hdvd)

end MetaMathlibExt
