module

public import MathlibExt.Topology.MaciasCoprimeTopology
import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise
import Mathlib.Data.Nat.GCD.BigOperators
import Mathlib.Data.Nat.PrimeFin
import Mathlib.Data.PNat.Basic
import Mathlib.Topology.Bases

/-!
# Density of primes and arithmetic progressions in the comaximal space

A nonempty set of primes is dense exactly when it is infinite. Coprime arithmetic progressions
are also dense. For a basic open set indexed by `n`, choose the progression index to be the
product of the prime divisors of `n` that do not divide the initial term.
-/

namespace MetaMathlibExt

open MathlibExt.Topology.MaciasCoprimeTopologyWanted

/-- **Coprime arithmetic progressions are dense in the comaximal space.** Equip the positive
integers with the comaximal topology, the topology generated by the sets
$\{m : \gcd(n, m) = 1\}$ for positive integers $n$. If $a$ and $b$ are coprime positive integers,
then the arithmetic progression $\{ak + b : k \in \mathbb{N}\} = \{b, a + b, 2a + b, \dots\}$,
with $k$ ranging over the natural numbers including $0$, is dense in this topology.

Source: Jhixon Macías, *A Topological Proof of the Infinitude of Prime Numbers in Certain
Arithmetic Progressions*, INTEGERS 26 (2026), Article A39, Lemma 2. -/
public theorem dense_maciasTopology_arithmeticProgression (a b : ℕ+)
    (hab : Nat.Coprime a b) :
    @Dense ℕ+ maciasTopology {m : ℕ+ | ∃ k : ℕ, (m : ℕ) = a * k + b} := by
  let := maciasTopology
  apply maciasBasis_isTopologicalBasis.dense_iff.mpr
  rintro _ ⟨n, rfl⟩ _
  let factors := (n : ℕ).primeFactors.filter fun p ↦ p.Coprime b
  let k := factors.prod id
  have hkb : k.Coprime b := Nat.Coprime.prod_left fun _ hp ↦ (Finset.mem_filter.mp hp).2
  refine ⟨⟨a * k + b, Nat.add_pos_right _ b.pos⟩, ?_, k, rfl⟩
  refine Nat.coprime_of_dvd fun p hp hpn ↦ hp.coprime_iff_not_dvd.mp ?_
  by_cases hpb : p.Coprime b
  · have hpk : p ∣ k := Finset.dvd_prod_of_mem id <| Finset.mem_filter.mpr
        ⟨Nat.mem_primeFactors.mpr ⟨hp, hpn, n.ne_zero⟩, hpb⟩
    exact (Nat.coprime_add_iff_right (hpk.mul_left (a : ℕ))).mpr hpb
  · have hdvd := hp.dvd_iff_not_coprime.mpr hpb
    exact (Nat.coprime_add_iff_left hdvd).mpr ((hab.mul_left hkb).symm.of_dvd_left hdvd)

-- The source assumes nonemptiness, although the equivalence also holds for the empty set.
set_option linter.unusedVariables false in
/-- **A nonempty set of primes is dense in the comaximal space iff it is infinite.** Equip the
positive integers with the comaximal topology, the topology generated by the sets
$\{m : \gcd(n, m) = 1\}$ for positive integers $n$. A nonempty set $A$ of primes is infinite if
and only if it is dense in this topology.

Source: Jhixon Macías, *A Topological Proof of the Infinitude of Prime Numbers in Certain
Arithmetic Progressions*, INTEGERS 26 (2026), Article A39, Lemma 1 (quoting Macías, INTEGERS 24
(2024), Article A47). -/
public theorem infinite_iff_dense_maciasTopology_of_subset_primes (A : Set ℕ+)
    (hA : A.Nonempty) (hAp : ∀ p ∈ A, Nat.Prime (p : ℕ)) :
    A.Infinite ↔ @Dense ℕ+ maciasTopology A := by
  let := maciasTopology
  rw [maciasBasis_isTopologicalBasis.dense_iff]
  constructor
  · rintro hInf _ ⟨n, rfl⟩ _
    obtain ⟨_, ⟨p, hp, rfl⟩, hpn⟩ :=
      (hInf.image PNat.coe_injective.injOn).exists_notMem_finset (n : ℕ).primeFactors
    have hprime := hAp p hp
    have hdiv : ¬ (p : ℕ) ∣ (n : ℕ) := fun hd ↦ hpn (hprime.mem_primeFactors hd n.ne_zero)
    exact ⟨p, (hprime.coprime_iff_not_dvd.mpr hdiv).symm, hp⟩
  · intro hDense hFin
    let n := hFin.toFinset.prod id
    obtain ⟨p, hcop, hp⟩ := hDense (coprimeSet n) ⟨n, rfl⟩ ⟨1, Nat.coprime_one_right _⟩
    have hdiv : p ∣ n := Finset.dvd_prod_of_mem id (hFin.mem_toFinset.mpr hp)
    exact (hAp p hp).coprime_iff_not_dvd.mp (Nat.Coprime.symm hcop) (PNat.dvd_iff.mp hdiv)

end MetaMathlibExt
