module

public import Mathlib.Analysis.Normed.Lp.lpSpace
public import Mathlib.Analysis.LocallyConvex.WithSeminorms
public import Mathlib.Analysis.Asymptotics.SuperpolynomialDecay
public import Mathlib.Analysis.PSeries
public import Mathlib.Topology.Algebra.UniformFilterBasis

/-!
# Rapidly decreasing sequences and weighted supremum seminorms

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. Each Wₖ : f ↦ ((n+1)^k fₙ)ₙ is
a continuous linear map to ℓ∞(ℕ,E), with pₖ(f) = ‖Wₖf‖∞. Convergence means uniform convergence
after every polynomial weight. All weighted sequences tend to zero, and all sums ∑ₙ
(n+1)^k‖fₙ‖ converge. Coordinate evaluation is continuous and bounded by p₀. With a
compatible real module structure and scalar tower ℝ,𝕜,s(𝕜,E), this topology is locally
convex over ℝ.
-/

@[expose] public noncomputable section

open scoped ENNReal Topology

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- **Rapid decay and bounded polynomial weights.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. For f : ℕ → E,
superpolynomial decay of ‖fₙ‖ with respect to n+1 is equivalent to ((n+1)^k fₙ)ₙ belonging to
ℓ∞(ℕ,E) for every k ∈ ℕ.
-/
theorem Asymptotics.superpolynomialDecay_norm_iff_memℓp_infty (f : ℕ → E) :
    Asymptotics.SuperpolynomialDecay Filter.atTop
      (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ)) (fun n ↦ ‖f n‖) ↔
      ∀ k : ℕ, Memℓp (fun n ↦ (((n + 1 : ℕ) : 𝕜) ^ k) • f n) ∞ := by
  have hk : Filter.Tendsto (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ)) Filter.atTop Filter.atTop :=
    (tendsto_natCast_atTop_atTop (R := ℝ)).comp (Filter.tendsto_add_atTop_nat 1)
  have hnorm (k n : ℕ) : ‖(((n + 1 : ℕ) : 𝕜) ^ k) • f n‖ =
      |((n + 1 : ℕ) : ℝ) ^ k * ‖f n‖| := by
    rw [norm_smul, norm_pow, RCLike.norm_natCast, abs_of_nonneg (by positivity)]
  rw [Asymptotics.superpolynomialDecay_iff_abs_isBoundedUnder _ hk]
  constructor
  · intro h k
    apply memℓp_infty
    simpa only [hnorm] using (h k).bddAbove_range
  · intro h k
    have hb := (h k).bddAbove
    simp only [hnorm] at hb
    exact hb.isBoundedUnder_of_range

/-- **Equivalent weights for superpolynomial decay.**

For a real sequence f : ℕ → ℝ, superpolynomial decay at infinity with respect to the weight n
is equivalent to superpolynomial decay with respect to n+1.
-/
theorem Asymptotics.superpolynomialDecay_natCast_add_one_iff (f : ℕ → ℝ) :
    Asymptotics.SuperpolynomialDecay Filter.atTop (fun n : ℕ ↦ (n : ℝ)) f ↔
    Asymptotics.SuperpolynomialDecay Filter.atTop (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ)) f := by
  constructor
  · intro h k
    have hp := (h.polynomial_mul ((Polynomial.X + Polynomial.C 1) ^ k)) 0
    simpa only [pow_zero, one_mul, Polynomial.eval_pow, Polynomial.eval_add,
      Polynomial.eval_X, Polynomial.eval_C, Nat.cast_add, Nat.cast_one] using hp
  · intro h k
    have hp := (h.polynomial_mul ((Polynomial.X - Polynomial.C 1) ^ k)) 0
    simpa only [pow_zero, one_mul, Polynomial.eval_pow, Polynomial.eval_sub,
      Polynomial.eval_X, Polynomial.eval_C, Nat.cast_add, Nat.cast_one,
      add_sub_cancel_right] using hp

/-- **The submodule of rapidly decreasing sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. These
sequences form a 𝕜-submodule of E^ℕ under coordinatewise addition and scalar multiplication.
-/
def rapidSequenceSubmodule (𝕜 E : Type*) [RCLike 𝕜] [NormedAddCommGroup E]
    [NormedSpace 𝕜 E] : Submodule 𝕜 (ℕ → E) where
  carrier := {f | ∀ k : ℕ, Memℓp (fun n ↦ (((n + 1 : ℕ) : 𝕜) ^ k) • f n) ∞}
  zero_mem' k := by
    simpa only [Pi.zero_apply, smul_zero] using
      (zero_mem_ℓp' (E := fun _ : ℕ ↦ E) (p := ∞))
  add_mem' hf hg k := by
    simpa only [Pi.add_apply, Pi.add_def, smul_add] using (hf k).add (hg k)
  smul_mem' c f hf k := by
    convert (hf k).const_smul c using 1
    ext n
    exact smul_comm _ _ _

/-- **The space of rapidly decreasing sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. This defines the
rapid-sequence space with its weighted supremum topology.
-/
def RapidSequence (𝕜 E : Type*) [RCLike 𝕜] [NormedAddCommGroup E]
    [NormedSpace 𝕜 E] : Type _ := ↥(rapidSequenceSubmodule 𝕜 E)

namespace RapidSequence

instance : FunLike (RapidSequence 𝕜 E) ℕ E where
  coe f := f.1
  coe_injective _ _ h := Subtype.ext h

instance : AddCommGroup (RapidSequence 𝕜 E) :=
  inferInstanceAs (AddCommGroup (rapidSequenceSubmodule 𝕜 E))

instance : Module 𝕜 (RapidSequence 𝕜 E) :=
  inferInstanceAs (Module 𝕜 (rapidSequenceSubmodule 𝕜 E))

/-- **Equality of rapid sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. If f,g ∈
s(𝕜,E) satisfy fₙ = gₙ for every n, then f = g.
-/
@[ext]
theorem ext {f g : RapidSequence 𝕜 E} (h : ∀ n, f n = g n) : f = g :=
  DFunLike.ext f g h

/-- **Coordinates of the zero rapid sequence.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every n
∈ ℕ, the zero sequence in s(𝕜,E) satisfies 0ₙ = 0 in E.
-/
@[simp]
theorem zero_apply (n : ℕ) : (0 : RapidSequence 𝕜 E) n = 0 := rfl

/-- **Coordinates of a sum of rapid sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For f,g ∈
s(𝕜,E) and n ∈ ℕ, one has (f+g)ₙ = fₙ+gₙ.
-/
@[simp]
theorem add_apply (f g : RapidSequence 𝕜 E) (n : ℕ) : (f + g) n = f n + g n := rfl

/-- **Coordinates of a negated rapid sequence.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For f ∈
s(𝕜,E) and n ∈ ℕ, one has (−f)ₙ = −fₙ.
-/
@[simp]
theorem neg_apply (f : RapidSequence 𝕜 E) (n : ℕ) : (-f) n = -f n := rfl

/-- **Coordinates of a difference of rapid sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For f,g ∈
s(𝕜,E) and n ∈ ℕ, one has (f−g)ₙ = fₙ−gₙ.
-/
@[simp]
theorem sub_apply (f g : RapidSequence 𝕜 E) (n : ℕ) : (f - g) n = f n - g n := rfl

/-- **Coordinates of a scalar multiple.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For c ∈ 𝕜, f
∈ s(𝕜,E) and n ∈ ℕ, one has (cf)ₙ = c fₙ.
-/
@[simp]
theorem smul_apply (c : 𝕜) (f : RapidSequence 𝕜 E) (n : ℕ) : (c • f) n = c • f n := rfl

/-- **A rapid sequence from superpolynomial decay.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. A function f : ℕ → E
whose norm decays superpolynomially with respect to n+1 defines an element of s(𝕜,E), since
every weight (n+1)^k‖fₙ‖ is bounded.
-/
def ofFunction (f : ℕ → E) (hf : Asymptotics.SuperpolynomialDecay Filter.atTop
    (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ)) (fun n ↦ ‖f n‖)) : RapidSequence 𝕜 E :=
  ⟨f, (Asymptotics.superpolynomialDecay_norm_iff_memℓp_infty (𝕜 := 𝕜) f).mp hf⟩

/-- **Coordinates of the decay constructor.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. For f : ℕ → E with
superpolynomially decaying norms, let S(f) ∈ s(𝕜,E) be the corresponding rapid sequence. Then
S(f)ₙ = f(n) for every n.
-/
@[simp]
theorem ofFunction_apply (f : ℕ → E) (hf : Asymptotics.SuperpolynomialDecay Filter.atTop
    (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ)) (fun n ↦ ‖f n‖)) (n : ℕ) :
    ofFunction (𝕜 := 𝕜) f hf n = f n := rfl

/-- **Superpolynomial decay of a rapid sequence.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every f
∈ s(𝕜,E), the norms ‖fₙ‖ decay superpolynomially as n → ∞ with respect to the weight n+1.
-/
theorem decay (f : RapidSequence 𝕜 E) : Asymptotics.SuperpolynomialDecay Filter.atTop
    (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ)) (fun n ↦ ‖f n‖) :=
  (Asymptotics.superpolynomialDecay_norm_iff_memℓp_infty (𝕜 := 𝕜) f).mpr f.2

/-- **Rapid decay with the conventional natural-number weight.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every f
∈ s(𝕜,E), the norms ‖fₙ‖ decay superpolynomially with respect to the weight n.
-/
theorem decay_natCast (f : RapidSequence 𝕜 E) : Asymptotics.SuperpolynomialDecay Filter.atTop
    (fun n : ℕ ↦ (n : ℝ)) (fun n ↦ ‖f n‖) :=
  (Asymptotics.superpolynomialDecay_natCast_add_one_iff (fun n ↦ ‖f n‖)).mpr f.decay

/-- **Polynomially weighted rapid sequences tend to zero.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every f
∈ s(𝕜,E) and k ∈ ℕ, one has (n+1)^k fₙ → 0 in E as n → ∞.
-/
theorem tendsto_weighted (f : RapidSequence 𝕜 E) (k : ℕ) :
    Filter.Tendsto (fun n ↦ (((n + 1 : ℕ) : 𝕜) ^ k) • f n) Filter.atTop (𝓝 0) := by
  apply tendsto_zero_iff_norm_tendsto_zero.mpr
  simpa only [norm_smul, norm_pow, RCLike.norm_natCast] using f.decay k

/-- **Rapid decay under powers of n.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every f
∈ s(𝕜,E) and k ∈ ℕ, one has n^k fₙ → 0 in E as n → ∞.
-/
theorem tendsto_natCast_pow_smul (f : RapidSequence 𝕜 E) (k : ℕ) :
    Filter.Tendsto (fun n : ℕ ↦ (n : 𝕜) ^ k • f n) Filter.atTop (𝓝 0) := by
  apply tendsto_zero_iff_norm_tendsto_zero.mpr
  simpa only [norm_smul, norm_pow, RCLike.norm_natCast] using f.decay_natCast k

/-- **Summability of polynomially weighted norms.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every f
∈ s(𝕜,E) and k ∈ ℕ, the nonnegative real series ∑ₙ (n+1)^k‖fₙ‖ is summable.
-/
theorem summable_weight_mul_norm (f : RapidSequence 𝕜 E) (k : ℕ) :
    Summable (fun n : ℕ ↦ ((n + 1 : ℕ) : ℝ) ^ k * ‖f n‖) := by
  have hd := f.decay_natCast.polynomial_mul ((Polynomial.X + Polynomial.C 1) ^ k)
  have ho := (Asymptotics.superpolynomialDecay_iff_isBigO _
    (tendsto_natCast_atTop_atTop (R := ℝ))).mp hd (-2)
  have hs : Summable (fun n : ℕ ↦ (n : ℝ) ^ (-2 : ℤ)) := by
    simpa only [zpow_neg, zpow_ofNat] using (Real.summable_nat_pow_inv (p := 2)).mpr (by decide)
  simpa only [Polynomial.eval_pow, Polynomial.eval_add, Polynomial.eval_X,
    Polynomial.eval_C, Nat.cast_add, Nat.cast_one] using summable_of_isBigO_nat hs ho

/-- **A rapid sequence supported at one coordinate.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For n ∈ ℕ
and x ∈ E, define δₙ(x) by δₙ(x)ₘ = x when m = n and zero otherwise. Every polynomially
weighted norm of this sequence is bounded.
-/
def single (n : ℕ) (x : E) : RapidSequence 𝕜 E :=
  ⟨Pi.single n x, by
    intro k
    convert lp.memℓp (lp.single (E := fun _ : ℕ ↦ E) ∞ n ((((n + 1 : ℕ) : 𝕜) ^ k) • x)) using 1
    ext m
    by_cases hm : m = n
    · subst m
      simp only [lp.single_apply, Pi.single_eq_same]
    · simp only [lp.single_apply, Pi.single_eq_of_ne hm, smul_zero]⟩

/-- **The value at a singleton coordinate.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For δₙ(x)
the sequence equal to x at n and zero elsewhere, one has δₙ(x)ₙ = x.
-/
@[simp]
theorem single_apply_self (n : ℕ) (x : E) : single (𝕜 := 𝕜) n x n = x :=
  Pi.single_eq_same _ _

/-- **Vanishing away from a singleton coordinate.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For δₙ(x)
the sequence equal to x at n and zero elsewhere, one has δₙ(x)ₘ = 0 whenever m ≠ n.
-/
theorem single_apply_ne (n : ℕ) (x : E) {m : ℕ} (hm : m ≠ n) : single (𝕜 := 𝕜) n x m = 0 :=
  Pi.single_eq_of_ne hm _

/-- **The polynomial-weight map into bounded sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Define Wₖf =
((n+1)^k fₙ)ₙ ∈ ℓ∞(ℕ,E). For each k ∈ ℕ, Wₖ : s(𝕜,E) → ℓ∞(ℕ,E) is 𝕜-linear.
-/
def weightedLM (k : ℕ) : RapidSequence 𝕜 E →ₗ[𝕜] lp (fun _ : ℕ ↦ E) ∞ where
  toFun f := ⟨fun n ↦ (((n + 1 : ℕ) : 𝕜) ^ k) • f n, f.2 k⟩
  map_add' f g := by
    ext n
    exact smul_add _ _ _
  map_smul' c f := by
    ext n
    exact smul_comm _ _ _

/-- **Coordinates of the polynomial-weight map.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Define Wₖf =
((n+1)^k fₙ)ₙ ∈ ℓ∞(ℕ,E). For every k,n ∈ ℕ and f ∈ s(𝕜,E), one has (Wₖf)ₙ = (n+1)^k fₙ.
-/
@[simp]
theorem weightedLM_apply (k n : ℕ) (f : RapidSequence 𝕜 E) :
    weightedLM k f n = (((n + 1 : ℕ) : 𝕜) ^ k) • f n := rfl

/-- **The weighted supremum seminorm.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Define Wₖf =
((n+1)^k fₙ)ₙ ∈ ℓ∞(ℕ,E). For each k, the seminorm pₖ on s(𝕜,E) is the pullback of the ℓ∞ norm:
pₖ(f) = ‖Wₖf‖∞.
-/
def seminorm (k : ℕ) : Seminorm 𝕜 (RapidSequence 𝕜 E) :=
  (normSeminorm 𝕜 (lp (fun _ : ℕ ↦ E) ∞)).comp (weightedLM k)

/-- **A weighted seminorm as an ℓ∞ norm.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Define Wₖf =
((n+1)^k fₙ)ₙ ∈ ℓ∞(ℕ,E). For each k ∈ ℕ and f ∈ s(𝕜,E), one has pₖ(f) = ‖Wₖf‖∞.
-/
theorem seminorm_eq_norm (k : ℕ) (f : RapidSequence 𝕜 E) :
    seminorm k f = ‖weightedLM k f‖ := rfl

/-- **The supremum formula for a weighted seminorm.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every k
∈ ℕ and f ∈ s(𝕜,E), pₖ(f) is exactly supₙ (n+1)^k‖fₙ‖.
-/
theorem seminorm_eq_iSup (k : ℕ) (f : RapidSequence 𝕜 E) :
    seminorm k f = ⨆ n : ℕ, ((n + 1 : ℕ) : ℝ) ^ k * ‖f n‖ := by
  rw [seminorm_eq_norm, lp.norm_eq_ciSup]
  simp only [weightedLM_apply, norm_smul, norm_pow, RCLike.norm_natCast]

/-- **A weighted coordinate bound.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every
k,n ∈ ℕ and f ∈ s(𝕜,E), one has (n+1)^k‖fₙ‖ ≤ pₖ(f).
-/
theorem weight_mul_norm_le_seminorm (k n : ℕ) (f : RapidSequence 𝕜 E) :
    ((n + 1 : ℕ) : ℝ) ^ k * ‖f n‖ ≤ seminorm k f := by
  simpa only [seminorm_eq_norm, weightedLM_apply, norm_smul, norm_pow, RCLike.norm_natCast] using
    lp.norm_apply_le_norm ENNReal.top_ne_zero (weightedLM k f) n

/-- **A uniform bound controls the weighted seminorm.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Let k ∈ ℕ, f
∈ s(𝕜,E) and C∈ℝ. If (n+1)^k‖fₙ‖ ≤ C for every n, then pₖ(f) ≤ C. The pointwise bound
already implies C≥0 at n=0.
-/
theorem seminorm_le_of_forall_le (k : ℕ) (f : RapidSequence 𝕜 E) {C : ℝ}
    (hf : ∀ n, ((n + 1 : ℕ) : ℝ) ^ k * ‖f n‖ ≤ C) :
    seminorm k f ≤ C := by
  rw [seminorm_eq_norm]
  apply lp.norm_le_of_forall_le' C
  simpa only [weightedLM_apply, norm_smul, norm_pow, RCLike.norm_natCast] using hf

/-- **Every coordinate is bounded by the zeroth seminorm.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For every f
∈ s(𝕜,E) and n ∈ ℕ, one has ‖fₙ‖ ≤ p₀(f).
-/
theorem norm_apply_le_seminorm_zero (f : RapidSequence 𝕜 E) (n : ℕ) :
    ‖f n‖ ≤ seminorm 0 f := by
  simpa using weight_mul_norm_le_seminorm 0 n f


instance : TopologicalSpace (RapidSequence 𝕜 E) :=
  (seminorm (𝕜 := 𝕜) (E := E)).moduleFilterBasis.topology'

/-- **The topology generated by weighted supremum seminorms.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. The topology
of s(𝕜,E) is generated by its family (pₖ)ₖ∈ℕ; finite intersections of sets pₖ(f−f₀) < ε give
the seminorm neighborhoods of f₀.
-/
theorem withSeminorms : WithSeminorms (seminorm (𝕜 := 𝕜) (E := E)) := ⟨rfl⟩

instance : IsTopologicalAddGroup (RapidSequence 𝕜 E) :=
  (seminorm (𝕜 := 𝕜) (E := E)).addGroupFilterBasis.isTopologicalAddGroup

instance : ContinuousSMul 𝕜 (RapidSequence 𝕜 E) :=
  (seminorm (𝕜 := 𝕜) (E := E)).moduleFilterBasis.continuousSMul

instance : UniformSpace (RapidSequence 𝕜 E) :=
  (seminorm (𝕜 := 𝕜) (E := E)).addGroupFilterBasis.uniformSpace

instance : IsUniformAddGroup (RapidSequence 𝕜 E) :=
  (seminorm (𝕜 := 𝕜) (E := E)).addGroupFilterBasis.isUniformAddGroup

instance : PolynormableSpace 𝕜 (RapidSequence 𝕜 E) := withSeminorms.toPolynormableSpace

/-- **Local convexity of the weighted topology.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. Assume s(𝕜,E) also has a real
module structure compatible with the scalar inclusion ℝ → 𝕜, in the sense of a scalar tower
ℝ,𝕜,s(𝕜,E). Then its weighted topology is locally convex over ℝ.
-/
instance instLocallyConvexSpace [Module ℝ (RapidSequence 𝕜 E)]
    [IsScalarTower ℝ 𝕜 (RapidSequence 𝕜 E)] : LocallyConvexSpace ℝ (RapidSequence 𝕜 E) :=
  (withSeminorms (𝕜 := 𝕜) (E := E)).toLocallyConvexSpace

instance : FirstCountableTopology (RapidSequence 𝕜 E) := withSeminorms.firstCountableTopology

instance : T1Space (RapidSequence 𝕜 E) := by
  apply withSeminorms.T1_of_separating
  intro f hf
  refine ⟨0, ?_⟩
  intro h
  apply hf
  ext n
  apply norm_eq_zero.mp
  exact le_antisymm (h ▸ norm_apply_le_seminorm_zero f n) (norm_nonneg _)

/-- **Continuous polynomial-weight maps.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. Define Wₖf = ((n+1)^k fₙ)ₙ ∈
ℓ∞(ℕ,E). Each Wₖ : s(𝕜,E) → ℓ∞(ℕ,E) is continuous and 𝕜-linear.
-/
def weightedCLM (k : ℕ) : RapidSequence 𝕜 E →L[𝕜] lp (fun _ : ℕ ↦ E) ∞ where
  toLinearMap := weightedLM k
  cont := by
    change Continuous (weightedLM (𝕜 := 𝕜) (E := E) k)
    exact WithSeminorms.continuous_normedSpace_rng (lp (fun _ : ℕ ↦ E) ∞)
      (withSeminorms (𝕜 := 𝕜) (E := E)) (weightedLM (𝕜 := 𝕜) (E := E) k)
      ⟨{k}, 1, by simp [seminorm]⟩

/-- **Coordinates of the continuous weighted map.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. Define Wₖf = ((n+1)^k fₙ)ₙ ∈
ℓ∞(ℕ,E). For each k,n and f ∈ s(𝕜,E), the continuous linear map satisfies (Wₖf)ₙ = (n+1)^k fₙ.
-/
@[simp]
theorem weightedCLM_apply (k n : ℕ) (f : RapidSequence 𝕜 E) :
    weightedCLM k f n = (((n + 1 : ℕ) : 𝕜) ^ k) • f n := rfl


/-- **The weighted seminorm of a singleton.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. For the
singleton sequence δₙ(x), equal to x at n and zero elsewhere, one has pₖ(δₙ(x)) = (n+1)^k‖x‖
for every k,n.
-/
theorem seminorm_single (k n : ℕ) (x : E) :
    seminorm k (single (𝕜 := 𝕜) n x) = ((n + 1 : ℕ) : ℝ) ^ k * ‖x‖ := by
  have h : weightedLM k (single (𝕜 := 𝕜) n x) =
      lp.single ∞ n ((((n + 1 : ℕ) : 𝕜) ^ k) • x) := by
    ext m
    by_cases hm : m = n
    · subst m
      simp only [weightedLM_apply, single_apply_self, lp.single_apply_self]
    · simp only [weightedLM_apply, single_apply_ne _ _ hm, lp.single_apply_ne _ _ _ hm, smul_zero]
  rw [seminorm_eq_norm, h, lp.norm_single (by simp)]
  simp only [norm_smul, norm_pow, RCLike.norm_natCast]

/-- **Continuous evaluation of rapid sequences.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. For each n, the evaluation map
evₙ : s(𝕜,E) → E, evₙ(f) = fₙ, is continuous and 𝕜-linear, with ‖evₙ(f)‖ ≤ p₀(f).
-/
def evalCLM (n : ℕ) : RapidSequence 𝕜 E →L[𝕜] E :=
  (lp.evalCLM 𝕜 (fun _ : ℕ ↦ E) ∞ n).comp (weightedCLM 0)

/-- **Evaluation returns the sequence coordinate.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. For the continuous linear
evaluation evₙ : s(𝕜,E) → E, one has evₙ(f) = fₙ.
-/
@[simp]
theorem evalCLM_apply (n : ℕ) (f : RapidSequence 𝕜 E) : evalCLM n f = f n := by
  change (((n + 1 : ℕ) : 𝕜) ^ 0) • f n = f n
  simp


/-- **Convergence through the weighted bounded-sequence maps.**

Let 𝕜 be a real or complex scalar field and E a normed 𝕜-vector space. Write s(𝕜,E) for the
sequences f : ℕ → E such that pₖ(f) = supₙ (n+1)^k‖fₙ‖ is finite for every k ∈ ℕ. Equip s(𝕜,E)
with the weighted supremum topology generated by the seminorms pₖ. Define Wₖf = ((n+1)^k fₙ)ₙ ∈
ℓ∞(ℕ,E). For a filter l on X, u : X → s(𝕜,E) and f ∈ s(𝕜,E), one has u → f along l if and only
if Wₖ(u(x)) → Wₖ(f) in ℓ∞(ℕ,E) along l for every k.
-/
theorem tendsto_iff_weighted {α : Type*} {u : α → RapidSequence 𝕜 E} {l : Filter α}
    {f : RapidSequence 𝕜 E} : Filter.Tendsto u l (𝓝 f) ↔
    ∀ k, Filter.Tendsto (fun a ↦ weightedCLM k (u a)) l (𝓝 (weightedCLM k f)) := by
  constructor
  · intro h k
    exact (weightedCLM k).continuous.tendsto _ |>.comp h
  · intro h
    rw [(withSeminorms (𝕜 := 𝕜) (E := E)).tendsto_nhds u f]
    intro k ε hε
    have hw := Metric.tendsto_nhds.mp (h k) ε hε
    rw [seminorm_eq_norm]
    change ∀ᶠ a in l, ‖weightedLM k (u a - f)‖ < ε
    simpa only [dist_eq_norm, ← map_sub] using hw

end RapidSequence
