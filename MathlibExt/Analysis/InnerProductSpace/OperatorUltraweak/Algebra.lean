module

public import MathlibExt.Analysis.InnerProductSpace.OperatorUltraweak.Topology
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# The ultraweakly closed algebra generated by operators

For a complex normed inner-product space `H` and `S ⊆ B(H)`, intersect all unital complex
subalgebras that contain `S` and are closed for the square-summable coefficient ultraweak
topology.

This gives the least ultraweakly closed complex subalgebra containing `S`. The construction and
its containment, closedness and leastness properties do not require completeness or separability
of `H`.
-/

@[expose] public section
noncomputable section
namespace OperatorUltraweak

/-- **Least ultraweakly closed algebra of an operator set.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. for `A ⊆ B(H)`, `algebraGenerated A` is the intersection of all unital complex
subalgebras containing `A` and closed in the coefficient ultraweak topology. -/
def algebraGenerated {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (S : Set (H →L[ℂ] H)) : Subalgebra ℂ (H →L[ℂ] H) :=
  sInf {A : Subalgebra ℂ (H →L[ℂ] H) | S ⊆ (A : Set (H →L[ℂ] H)) ∧
    IsClosedSet (A : Set (H →L[ℂ] H))}

/-- **Generators lie in their ultraweak algebra.** Let `H` be a complex normed inner-product
space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2` for its
square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T x_n⟩`. for
`A ⊆ B(H)`, `A ⊆ algebraGenerated A`. -/
theorem subset_algebraGenerated {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (S : Set (H →L[ℂ] H)) : S ⊆ (algebraGenerated S : Set (H →L[ℂ] H)) := by
  intro T hT
  exact Algebra.mem_sInf.mpr fun A hA => hA.1 hT

/-- **Ultraweak closedness of the generated algebra.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. for any operator set `A ⊆ B(H)`, the underlying set of `algebraGenerated A` is
closed in the coefficient ultraweak topology. -/
theorem isClosedSet_algebraGenerated {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (S : Set (H →L[ℂ] H)) : IsClosedSet (algebraGenerated S : Set (H →L[ℂ] H)) := by
  let : TopologicalSpace (H →L[ℂ] H) := topology H
  change IsClosed (algebraGenerated S : Set (H →L[ℂ] H))
  rw [algebraGenerated, Algebra.coe_sInf]
  exact isClosed_iInter fun A => isClosed_iInter fun hA => hA.2

/-- **Leastness of the ultraweakly generated algebra.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. if a unital complex subalgebra `M ⊆ B(H)` is ultraweakly closed and contains `A`,
then `algebraGenerated A ≤ M`. -/
theorem algebraGenerated_le {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (S : Set (H →L[ℂ] H)) (A : Subalgebra ℂ (H →L[ℂ] H))
    (hS : S ⊆ (A : Set (H →L[ℂ] H))) (hA : IsClosedSet (A : Set (H →L[ℂ] H))) :
    algebraGenerated S ≤ A :=
  sInf_le ⟨hS, hA⟩

end OperatorUltraweak
