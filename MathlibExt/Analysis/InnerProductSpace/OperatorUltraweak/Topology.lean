module

public import MathlibExt.Analysis.InnerProductSpace.OperatorUltraweak.Coefficients
public import Mathlib.Topology.Constructions

/-!
# Ultraweak topology from square-summable operator coefficients

For a complex normed inner-product space `H`, define `ω_(x,y)(T)=Σ_n ⟨y_n,T x_n⟩` for `x,y ∈
ℓ²(ℕ,H)` and `T ∈ B(H)`. The operator ultraweak topology is the coarsest topology making every
coefficient `ω_(x,y)` continuous.

A net `T_i` converges to `T` in this topology exactly when `ω_(x,y)(T_i)→ω_(x,y)(T)` for all
square-summable vector pairs. Closure and closedness are taken in this coefficient topology.
Neither completeness, separability nor a nonzero Hilbert space is required.
-/

@[expose] public section
noncomputable section
open scoped Topology
namespace OperatorUltraweak
universe u v
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- **Simultaneous square-summable coefficient evaluation.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. `evaluation T` is the function on all vector pairs given by `evaluation T
(x,y)=ω_(x,y)(T)`. -/
def evaluation (T : H →L[ℂ] H) : (VectorSequence H × VectorSequence H) → ℂ :=
  fun p => coefficient p.1 p.2 T

/-- **Series value of operator coefficient evaluation.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. for bounded `T`, `evaluation T (x,y)=Σ' n : ℕ, ⟨y_n,T x_n⟩`. -/
theorem evaluation_apply (T : H →L[ℂ] H) (x y : VectorSequence H) :
    evaluation T (x, y) = ∑' n : ℕ, inner ℂ (y n) (T (x n)) := coefficient_apply x y T

/-- **Initial ultraweak topology of bounded operators.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. `topology H` is the topology induced by `T ↦ (ω_(x,y)(T))_(x,y)` into the product
of copies of `ℂ`, equivalently the coarsest topology making every `ω_(x,y)` continuous. -/
@[instance_reducible]
def topology (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :
    TopologicalSpace (H →L[ℂ] H) :=
  TopologicalSpace.induced (evaluation (H := H)) inferInstance

/-- **Ultraweak closedness of an operator set.** Let `H` be a complex normed inner-product
space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2` for its
square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T x_n⟩`.
`OperatorUltraweak.IsClosedSet A` means the subset `A ⊆ B(H)` is closed in the topology
generated by all coefficients `ω_(x,y)`. -/
def IsClosedSet (S : Set (H →L[ℂ] H)) : Prop :=
  @IsClosed (H →L[ℂ] H) (topology H) S

/-- **Ultraweak operator convergence along a filter.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. for any filter `l` on an index type, `OperatorUltraweak.Tendsto T_i l T` means
`T_i→T` along `l` in the coefficient topology on `B(H)`. -/
def Tendsto {I : Type*} (T : I → (H →L[ℂ] H)) (l : Filter I) (U : H →L[ℂ] H) : Prop :=
  Filter.Tendsto T l (@nhds (H →L[ℂ] H) (topology H) U)

/-- **Coefficient criterion for ultraweak convergence.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. for any filter `l`, `T_i→T` ultraweakly along `l` exactly when
`ω_(x,y)(T_i)→ω_(x,y)(T)` in `ℂ` along `l` for every `x,y ∈ ℓ²(H)`. -/
theorem tendsto_iff {I : Type v} (T : I → H →L[ℂ] H) (l : Filter I) (U : H →L[ℂ] H) :
    OperatorUltraweak.Tendsto T l U ↔
      ∀ x y : VectorSequence H,
        Filter.Tendsto (fun i => coefficient x y (T i)) l (𝓝 (coefficient x y U)) := by
  rw [OperatorUltraweak.Tendsto, topology, nhds_induced,
    Filter.tendsto_comap_iff, tendsto_pi_nhds]
  constructor
  · intro h x y
    exact h (x, y)
  · intro h p
    exact h p.1 p.2

/-- **Ultraweak continuity of a square-summable coefficient.** Let `H` be a complex normed
inner-product space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2`
for its square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T
x_n⟩`. for fixed `x,y ∈ ℓ²(H)`, the functional `T ↦ ω_(x,y)(T)` is continuous from `B(H)`
with the coefficient ultraweak topology to `ℂ`. -/
theorem continuous_coefficient (x y : VectorSequence H) :
    @Continuous (H →L[ℂ] H) ℂ (topology H) inferInstance (coefficient x y) := by
  letI : TopologicalSpace (H →L[ℂ] H) := topology H
  have he : Continuous (evaluation (H := H)) := continuous_induced_dom
  exact (continuous_apply (x, y)).comp he

/-- **Ultraweak closure of a bounded-operator set.** Let `H` be a complex normed inner-product
space, with no completeness assumption. Write `ℓ²(H)=lp (fun _ : ℕ => H) 2` for its
square-summable vector sequences. For `x,y ∈ ℓ²(H)`, put `ω_(x,y)(T)=Σ_n ⟨y_n,T x_n⟩`.
`OperatorUltraweak.closure A` is the closure of `A ⊆ B(H)` in the topology generated by
all square-summable coefficients. -/
def closure (S : Set (H →L[ℂ] H)) : Set (H →L[ℂ] H) :=
  @_root_.closure (H →L[ℂ] H) (topology H) S

end OperatorUltraweak
