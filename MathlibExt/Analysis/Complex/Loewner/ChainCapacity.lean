module

public import MathlibExt.Analysis.Complex.Loewner.LoewnerCapacity
public import MathlibExt.Analysis.Complex.Loewner.LoewnerExistence

/-!
# Capacity-parametrized Loewner chains and chordal SLE realizations

Packages the conditional capacity computation of `LoewnerCapacity` as structures.
`IsCapacityParametrized c a₁` says that the maps of the Loewner chain `c` have half-plane capacity
`a₁(t)` and `a₁' = 2`; under it `hcap(g_t) = 2t` (`chordalSLE_capacity_parametrized`). A
`CapacityParametrizedChain` adds a monotone family of compact hulls. The `chordalSLE_*` results
apply to any such chain; for a sample path of chordal SLE`_κ` (driving function `√κ B_t`), the
constructors `loewnerChain_of_sle_realization` and
`capacityParametrizedChain_of_sle_realization` build one from a solution of the Loewner equation.

Caveats on fidelity:
* The capacity hypotheses (`normalized`, `rate`) are assumed, not derived from the Loewner
  equation, so `hcap(K_t) = 2t` is proved only conditionally on them.
* The hull family of a `CapacityParametrizedChain` is not required to be the family of hulls
  `K_t` generated by the chain (`g_t : ℍ \ K_t → ℍ`); the monotonicity results are about the given
  family. For the hulls generated by the maximal Loewner flow see `loewnerSwallowedSet` in
  `LoewnerMaximal`.
* Nothing here uses the law of `B`: the SLE results hold pathwise for any continuous driving
  function of the form `√κ B_t(ω)`.

## Main definitions

* `IsCapacityParametrized`, `CapacityParametrizedChain`.
* `loewnerChain_of_sle_realization`, `capacityParametrizedChain_of_sle_realization`.

## Main results

* `chordalSLE_capacity_parametrized`, `chordalSLE_hcap_eq`: `hcap(g_t) = 2t` and `a₁(t) = 2t`,
  under the capacity hypotheses.
* `chordalSLE_realization_capacity_parametrized`: the same for an SLE sample path.

## References

* G. F. Lawler, *Conformally Invariant Processes in the Plane*, Mathematical Surveys and Monographs
  114, Amer. Math. Soc., 2005, Chapters 4 and 6.
-/

@[expose] public section

open Complex Set Filter Topology MeasureTheory
open scoped NNReal

namespace StatMech.SLE

/-- The maps of `c` have half-plane capacity `a₁(t)` for `t ≥ 0`, and `a₁' = 2`. -/
structure IsCapacityParametrized (c : LoewnerChain) (a₁ : ℝ → ℝ) : Prop where
  /-- `g_t(z) = z + a₁(t)/z + o(1/z)` for every `t ≥ 0`. -/
  normalized : ∀ t ∈ Ici (0 : ℝ), HasHalfPlaneCapacity (c.maps t) (a₁ t)
  /-- The capacity grows at rate `2`. -/
  rate : ∀ t ∈ Ici (0 : ℝ), HasDerivWithinAt a₁ 2 (Ici (0 : ℝ)) t

/-- `a₁(0) = 0`, since `g_0 = id`. -/
lemma IsCapacityParametrized.coeff_zero {c : LoewnerChain} {a₁ : ℝ → ℝ}
    (h : IsCapacityParametrized c a₁) : a₁ 0 = 0 := by
  have hid : HasHalfPlaneCapacity (c.maps 0) 0 :=
    hasHalfPlaneCapacity_zero_of_eq_id (fun z => c.maps_zero z)
  exact (h.normalized 0 Set.self_mem_Ici).unique hid

/-- A capacity-parametrized Loewner chain together with a monotone family of compact hulls
(not required to be the hulls generated by the chain). -/
structure CapacityParametrizedChain where
  /-- The Loewner chain `(W, g_t)`. -/
  chain : LoewnerChain
  /-- A family of hulls; no relation to `chain` is required. -/
  hull : ℝ → Set ℂ
  /-- The capacity coefficient `a₁(t)`. -/
  coeff : ℝ → ℝ
  /-- Each `hull t` is a compact `ℍ`-hull. -/
  hull_isHull : ∀ t, IsCompactHull (hull t)
  /-- The hulls increase. -/
  hull_monotone : Monotone hull
  /-- `chain` is capacity parametrized with coefficient `coeff`. -/
  capacity : IsCapacityParametrized chain coeff

/-- `hcap(g_t) = 2t` for a capacity-parametrized chain (conditional on its capacity
hypotheses). -/
theorem chordalSLE_capacity_parametrized (c : CapacityParametrizedChain) :
    ∀ t ∈ Ici (0 : ℝ), HasHalfPlaneCapacity (c.chain.maps t) (2 * t) :=
  loewner_capacity_eq_of_loewnerChain c.chain c.capacity.normalized c.capacity.rate

/-- The hull family of a `CapacityParametrizedChain` is a monotone hull family. -/
theorem loewnerChain_hulls_increasing (c : CapacityParametrizedChain) :
    MonotoneHullFamily c.hull :=
  ⟨c.hull_isHull, c.hull_monotone⟩

/-- The hulls increase. -/
theorem chordalSLE_hull_subset (c : CapacityParametrizedChain) {s t : ℝ}
    (hst : s ≤ t) : c.hull s ⊆ c.hull t :=
  subset_of_monotoneHull (loewnerChain_hulls_increasing c) hst

/-- The complements `ℍ \ K_t` decrease. -/
theorem chordalSLE_complement_antitone (c : CapacityParametrizedChain) :
    Antitone (fun t => UpperHalfPlane.upperHalfPlaneSet \ c.hull t) :=
  complement_antitone_of_monotoneHull (loewnerChain_hulls_increasing c)

/-- The capacity coefficient is `2t`. -/
theorem chordalSLE_hcap_eq (c : CapacityParametrizedChain) :
    ∀ t ∈ Ici (0 : ℝ), c.coeff t = 2 * t :=
  coeff_ode_solution c.capacity.rate c.capacity.coeff_zero

/-- Any half-plane capacity of `g_t` is `2t`. -/
theorem chordalSLE_normalized_map_unique (c : CapacityParametrizedChain)
    {t : ℝ} (ht : t ∈ Ici (0 : ℝ)) {b : ℝ}
    (hb : HasHalfPlaneCapacity (c.chain.maps t) b) : b = 2 * t :=
  hb.unique (chordalSLE_capacity_parametrized c t ht)

/-- `hcap(g_0) = 0`. -/
theorem chordalSLE_hcap_zero (c : CapacityParametrizedChain) :
    HasHalfPlaneCapacity (c.chain.maps 0) 0 := by
  have := chordalSLE_capacity_parametrized c 0 Set.self_mem_Ici
  rwa [mul_zero] at this

/-- The SLE driving function `√κ B_t(ω)` is continuous when `t ↦ B_t(ω)` is. -/
lemma continuous_sleDriving {Ω : Type*} (κ : ℝ) (B : ℝ → Ω → ℝ) (ω : Ω)
    (hcont : Continuous fun t => B t ω) : Continuous (sleDriving κ B ω) := by
  unfold sleDriving
  exact continuous_const.mul hcont

/-- The Loewner chain of an SLE`_κ` sample path `ω`, from a solution `g` of the Loewner equation
driven by `√κ B_t(ω)`. -/
noncomputable def loewnerChain_of_sle_realization {Ω : Type*} (κ : ℝ)
    (B : ℝ → Ω → ℝ) (ω : Ω) (g : ℝ → ℂ → ℂ)
    (hcont : Continuous fun t => B t ω)
    (hloe : SatisfiesLoewnerEquation (sleDriving κ B ω) g) : LoewnerChain where
  driving := sleDriving κ B ω
  driving_continuous := continuous_sleDriving κ B ω hcont
  maps := g
  loewner := hloe

@[simp] lemma loewnerChain_of_sle_realization_maps {Ω : Type*} (κ : ℝ)
    (B : ℝ → Ω → ℝ) (ω : Ω) (g : ℝ → ℂ → ℂ)
    (hcont : Continuous fun t => B t ω)
    (hloe : SatisfiesLoewnerEquation (sleDriving κ B ω) g) :
    (loewnerChain_of_sle_realization κ B ω g hcont hloe).maps = g := rfl

@[simp] lemma loewnerChain_of_sle_realization_driving {Ω : Type*} (κ : ℝ)
    (B : ℝ → Ω → ℝ) (ω : Ω) (g : ℝ → ℂ → ℂ)
    (hcont : Continuous fun t => B t ω)
    (hloe : SatisfiesLoewnerEquation (sleDriving κ B ω) g) :
    (loewnerChain_of_sle_realization κ B ω g hcont hloe).driving = sleDriving κ B ω := rfl

/-- `hcap(g_t) = 2t` for an SLE sample path, **assuming** the capacity expansion and the rate
`a₁' = 2`. -/
theorem chordalSLE_realization_capacity_parametrized {Ω : Type*} (κ : ℝ)
    (B : ℝ → Ω → ℝ) (ω : Ω) (g : ℝ → ℂ → ℂ)
    (hcont : Continuous fun t => B t ω)
    (hloe : SatisfiesLoewnerEquation (sleDriving κ B ω) g) {a₁ : ℝ → ℝ}
    (hnorm : ∀ t ∈ Ici (0 : ℝ), HasHalfPlaneCapacity (g t) (a₁ t))
    (hrate : ∀ t ∈ Ici (0 : ℝ), HasDerivWithinAt a₁ 2 (Ici (0 : ℝ)) t) :
    ∀ t ∈ Ici (0 : ℝ), HasHalfPlaneCapacity (g t) (2 * t) :=
  loewner_capacity_eq_of_loewnerChain
    (loewnerChain_of_sle_realization κ B ω g hcont hloe) hnorm hrate

/-- A `CapacityParametrizedChain` from an SLE sample path, a given monotone hull family and the
capacity hypotheses. -/
noncomputable def capacityParametrizedChain_of_sle_realization {Ω : Type*} (κ : ℝ)
    (B : ℝ → Ω → ℝ) (ω : Ω) (g : ℝ → ℂ → ℂ)
    (hcont : Continuous fun t => B t ω)
    (hloe : SatisfiesLoewnerEquation (sleDriving κ B ω) g) {a₁ : ℝ → ℝ}
    (K : ℝ → Set ℂ) (hKhull : ∀ t, IsCompactHull (K t)) (hKmono : Monotone K)
    (hnorm : ∀ t ∈ Ici (0 : ℝ), HasHalfPlaneCapacity (g t) (a₁ t))
    (hrate : ∀ t ∈ Ici (0 : ℝ), HasDerivWithinAt a₁ 2 (Ici (0 : ℝ)) t) :
    CapacityParametrizedChain where
  chain := loewnerChain_of_sle_realization κ B ω g hcont hloe
  hull := K
  coeff := a₁
  hull_isHull := hKhull
  hull_monotone := hKmono
  capacity := ⟨hnorm, hrate⟩

end StatMech.SLE
