module

public import MathlibExt.Analysis.CStarAlgebra.Ideal.Hereditary
public import MathlibExt.Analysis.CStarAlgebra.Module.Compact
public import MathlibExt.Analysis.CStarAlgebra.Module.Support

/-!
# Analytic strong Morita equivalence

Nonunital complex C-star algebras `A,B` are strongly Morita equivalent here when a full complete
right Hilbert `B`-module `E` admits a star homomorphism `A → End_B(E)` whose values are
module-compact and whose restriction is bijective onto `K_B(E)`. Fullness means that the closed
ideal generated by the coefficient inner products is all of `B`.

A closed star subalgebra `S ⊆ B` is full hereditary when it is hereditary in the C-star order
and every closed two-sided star ideal containing `S` equals `B`.
-/

@[expose] public section

open Set

namespace CStarModule

universe uA uB

/-- **Strong Morita equivalence through Hilbert modules.** For nonunital C-star algebras `A,B`,
this means there exists a full complete right Hilbert `B`-module `E` and a star homomorphism
`α : A → End_B(E)` whose values are compact and whose restriction `A → K_B(E)` is bijective. -/
def StronglyMoritaEquivalent
    (A : Type uA) (B : Type uB)
    [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] : Prop :=
  let _ : PartialOrder Bᵐᵒᵖ := CStarAlgebra.spectralOrder Bᵐᵒᵖ
  let _ : StarOrderedRing Bᵐᵒᵖ := CStarAlgebra.spectralOrderedRing Bᵐᵒᵖ
  ∃ (E : Type (max uA uB)) (hE : NormedAddCommGroup E),
    let _ := hE
    ∃ hES : NormedSpace ℂ E,
    let _ := hES
    ∃ hsmul : SMul Bᵐᵒᵖ E,
    let _ := hsmul
    ∃ hmodule : CStarModule Bᵐᵒᵖ E,
    let _ := hmodule
    ∃ hcomplete : CompleteSpace E,
    let _ := hcomplete
    ∃ α : A →⋆ₙₐ[ℂ] AdjointableOperator.End B E,
      IsFull B E ∧
      ∃ hcompact : ∀ a, α a ∈ AdjointableOperator.compactStarSubalgebra,
        Function.Bijective
          (NonUnitalStarAlgHom.codRestrict α
            AdjointableOperator.compactStarSubalgebra hcompact)

/-- **Full hereditary C-star subalgebra.** For `S : NonUnitalStarSubalgebra ℂ B`, this predicate
requires norm-closedness, heredity, and `I = B` for every closed two-sided star ideal `I`
containing `S`. -/
def IsFullHereditarySubalgebra
    {B : Type uB} [NonUnitalCStarAlgebra B]
    (S : NonUnitalStarSubalgebra ℂ B) : Prop :=
  IsClosed (S : Set B) ∧ S.IsHereditary ∧
    ∀ I : ClosedStarIdeal B, (∀ x ∈ S, x ∈ I) → I = ⊤

end CStarModule
