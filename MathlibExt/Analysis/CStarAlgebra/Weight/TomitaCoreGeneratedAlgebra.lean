module

public import MathlibExt.Analysis.CStarAlgebra.Weight.TomitaCoreLeftRepresentation
public import MathlibExt.Analysis.VonNeumannAlgebra.Generated

/-!
# Von Neumann algebra generated by finite GNS core coefficients

For a faithful extended positive weight on a nonunital complex C-star algebra, the finite star
GNS core `C_φ` acts on `H_φ` by bounded left multiplication `λ_φ`. Let `S=λ_φ(C_φ)`.

The generated von Neumann algebra is the double commutant `(StarAlgebra.adjoin ℂ S)''`. It
contains each coefficient `λ_φ(ξ)` and is contained in a von Neumann algebra `N` exactly when
every such coefficient belongs to `N`. Restricting `λ_φ` to this generated carrier defines a
nonunital complex star homomorphism. No identification with a separately given von Neumann
algebra or weight is asserted.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace CStarAlgebra.ScalarWeight

noncomputable section

universe u

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- **Von Neumann algebra generated by GNS core operators.** Let `A` be a nonunital complex C-star
algebra with its spectral order and `φ : A₊ → [0,∞]` an additive, nonnegative-real homogeneous
weight vanishing at zero. Write `n_φ = {x ∈ A : φ(x* x) < ∞}`. Put `q(x) = (φ(x* x)).toReal`
for `x ∈ n_φ`. Let `H_φ` be the Hilbert completion for the seminorm `√q(x)`, with dense
complex-linear map `Λ : n_φ → H_φ`. Assume faithfulness: `φ(a)=0 → a=0` for every positive `a
: A`. Put `D_φ={x ∈ n_φ : x* ∈ n_φ}` and `C_φ=Λ(D_φ) ⊆ H_φ`, with linear equivalence `e : D_φ
≃ₗ[ℂ] C_φ`, `e(x)=Λ(x)`. let `λ_φ : C_φ → B(H_φ)` be the bounded left representation. Then
`tomitaCoreGeneratedVonNeumannAlgebra φ = generatedBy (λ_φ(C_φ))`, the double commutant of the
unital star algebra these operators generate. -/
def Weight.tomitaCoreGeneratedVonNeumannAlgebra (φ : Weight A)
    (hφ : ∀ a : PositiveElement A, φ.value a = 0 → (a : A) = 0) :
    letI := φ.tomitaCoreNonUnitalRing hφ;
    letI := φ.tomitaCoreStar hφ;
    VonNeumannAlgebra φ.GNS := by
  letI := φ.tomitaCoreNonUnitalRing hφ
  letI := φ.tomitaCoreStar hφ
  exact VonNeumannAlgebra.generatedBy (Set.range (φ.tomitaCoreLeftRepresentation hφ))

/-- **Core coefficient belongs to its generated von Neumann algebra.** Let `A` be a nonunital
complex C-star algebra with its spectral order and `φ : A₊ → [0,∞]` an additive,
nonnegative-real homogeneous weight vanishing at zero. Write `n_φ = {x ∈ A : φ(x* x) < ∞}`.
Put `q(x) = (φ(x* x)).toReal` for `x ∈ n_φ`. Let `H_φ` be the Hilbert completion for the
seminorm `√q(x)`, with dense complex-linear map `Λ : n_φ → H_φ`. Assume faithfulness: `φ(a)=0
→ a=0` for every positive `a : A`. Put `D_φ={x ∈ n_φ : x* ∈ n_φ}` and `C_φ=Λ(D_φ) ⊆ H_φ`, with
linear equivalence `e : D_φ ≃ₗ[ℂ] C_φ`, `e(x)=Λ(x)`. each bounded left operator
`λ_φ(ξ)=tomitaCoreLeftRepresentation φ ξ`, for `ξ ∈ C_φ`, belongs to
`tomitaCoreGeneratedVonNeumannAlgebra φ`. -/
theorem Weight.tomitaCoreLeftRepresentation_mem_generated (φ : Weight A)
    (hφ : ∀ a : PositiveElement A, φ.value a = 0 → (a : A) = 0)
    (ξ : φ.tomitaCore) :
    letI := φ.tomitaCoreNonUnitalRing hφ;
    letI := φ.tomitaCoreStar hφ;
    φ.tomitaCoreLeftRepresentation hφ ξ ∈ φ.tomitaCoreGeneratedVonNeumannAlgebra hφ := by
  let := φ.tomitaCoreNonUnitalRing hφ
  let := φ.tomitaCoreStar hφ
  exact VonNeumannAlgebra.subset_generatedBy _ (Set.mem_range_self ξ)

/-- **Double commutant formula for the generated GNS algebra.** Let `A` be a nonunital complex
C-star algebra with its spectral order and `φ : A₊ → [0,∞]` an additive, nonnegative-real
homogeneous weight vanishing at zero. Write `n_φ = {x ∈ A : φ(x* x) < ∞}`. Put `q(x) = (φ(x*
x)).toReal` for `x ∈ n_φ`. Let `H_φ` be the Hilbert completion for the seminorm `√q(x)`, with
dense complex-linear map `Λ : n_φ → H_φ`. Assume faithfulness: `φ(a)=0 → a=0` for every
positive `a : A`. Put `D_φ={x ∈ n_φ : x* ∈ n_φ}` and `C_φ=Λ(D_φ) ⊆ H_φ`, with linear
equivalence `e : D_φ ≃ₗ[ℂ] C_φ`, `e(x)=Λ(x)`. put `S=λ_φ(C_φ)`, where `λ_φ` is the bounded
left representation. The operator set underlying `tomitaCoreGeneratedVonNeumannAlgebra φ` is
`(StarAlgebra.adjoin ℂ S)''`, with commutants taken in `B(H_φ)`. -/
theorem Weight.coe_tomitaCoreGeneratedVonNeumannAlgebra (φ : Weight A)
    (hφ : ∀ a : PositiveElement A, φ.value a = 0 → (a : A) = 0) :
    letI := φ.tomitaCoreNonUnitalRing hφ;
    letI := φ.tomitaCoreStar hφ;
    (φ.tomitaCoreGeneratedVonNeumannAlgebra hφ : Set (φ.GNS →L[ℂ] φ.GNS)) =
      Set.centralizer (Set.centralizer (StarAlgebra.adjoin ℂ
        (Set.range (φ.tomitaCoreLeftRepresentation hφ)) : Set (φ.GNS →L[ℂ] φ.GNS))) := by
  let := φ.tomitaCoreNonUnitalRing hφ
  let := φ.tomitaCoreStar hφ
  exact VonNeumannAlgebra.coe_generatedBy _

/-- **Containment criterion for the generated GNS algebra.** Let `A` be a nonunital complex C-star
algebra with its spectral order and `φ : A₊ → [0,∞]` an additive, nonnegative-real homogeneous
weight vanishing at zero. Write `n_φ = {x ∈ A : φ(x* x) < ∞}`. Put `q(x) = (φ(x* x)).toReal`
for `x ∈ n_φ`. Let `H_φ` be the Hilbert completion for the seminorm `√q(x)`, with dense
complex-linear map `Λ : n_φ → H_φ`. Assume faithfulness: `φ(a)=0 → a=0` for every positive `a
: A`. Put `D_φ={x ∈ n_φ : x* ∈ n_φ}` and `C_φ=Λ(D_φ) ⊆ H_φ`, with linear equivalence `e : D_φ
≃ₗ[ℂ] C_φ`, `e(x)=Λ(x)`. for any `N : VonNeumannAlgebra H_φ`,
`tomitaCoreGeneratedVonNeumannAlgebra φ ≤ N` exactly when `λ_φ(ξ) ∈ N` for every `ξ ∈ C_φ`,
where `λ_φ` is its bounded left representation. -/
theorem Weight.tomitaCoreGeneratedVonNeumannAlgebra_le_iff (φ : Weight A)
    (hφ : ∀ a : PositiveElement A, φ.value a = 0 → (a : A) = 0)
    (N : VonNeumannAlgebra φ.GNS) :
    letI := φ.tomitaCoreNonUnitalRing hφ;
    letI := φ.tomitaCoreStar hφ;
    φ.tomitaCoreGeneratedVonNeumannAlgebra hφ ≤ N ↔
      ∀ ξ : φ.tomitaCore, φ.tomitaCoreLeftRepresentation hφ ξ ∈ N := by
  let := φ.tomitaCoreNonUnitalRing hφ
  let := φ.tomitaCoreStar hφ
  change VonNeumannAlgebra.generatedBy (Set.range (φ.tomitaCoreLeftRepresentation hφ)) ≤ N ↔ _
  rw [VonNeumannAlgebra.generatedBy_le_iff]
  exact Set.range_subset_iff

/-- **Core representation into its generated von Neumann algebra.** Let `A` be a nonunital complex
C-star algebra with its spectral order and `φ : A₊ → [0,∞]` an additive, nonnegative-real
homogeneous weight vanishing at zero. Write `n_φ = {x ∈ A : φ(x* x) < ∞}`. Put `q(x) = (φ(x*
x)).toReal` for `x ∈ n_φ`. Let `H_φ` be the Hilbert completion for the seminorm `√q(x)`, with
dense complex-linear map `Λ : n_φ → H_φ`. Assume faithfulness: `φ(a)=0 → a=0` for every
positive `a : A`. Put `D_φ={x ∈ n_φ : x* ∈ n_φ}` and `C_φ=Λ(D_φ) ⊆ H_φ`, with linear
equivalence `e : D_φ ≃ₗ[ℂ] C_φ`, `e(x)=Λ(x)`. the bounded left representation `λ_φ : C_φ →
B(H_φ)` restricts to a nonunital complex star homomorphism `C_φ →
tomitaCoreGeneratedVonNeumannAlgebra φ`. -/
def Weight.tomitaCoreToGenerated (φ : Weight A)
    (hφ : ∀ a : PositiveElement A, φ.value a = 0 → (a : A) = 0) :
    letI := φ.tomitaCoreNonUnitalRing hφ;
    letI := φ.tomitaCoreStar hφ;
    φ.tomitaCore →⋆ₙₐ[ℂ] φ.tomitaCoreGeneratedVonNeumannAlgebra hφ := by
  letI := φ.tomitaCoreNonUnitalRing hφ
  letI := φ.tomitaCoreStar hφ
  exact (φ.tomitaCoreLeftRepresentation hφ).codRestrict
    (φ.tomitaCoreGeneratedVonNeumannAlgebra hφ).toStarSubalgebra.toNonUnitalStarSubalgebra
      (φ.tomitaCoreLeftRepresentation_mem_generated hφ)

/-- **Operator value after restricting to the generated algebra.** Let `A` be a nonunital complex
C-star algebra with its spectral order and `φ : A₊ → [0,∞]` an additive, nonnegative-real
homogeneous weight vanishing at zero. Write `n_φ = {x ∈ A : φ(x* x) < ∞}`. Put `q(x) = (φ(x*
x)).toReal` for `x ∈ n_φ`. Let `H_φ` be the Hilbert completion for the seminorm `√q(x)`, with
dense complex-linear map `Λ : n_φ → H_φ`. Assume faithfulness: `φ(a)=0 → a=0` for every
positive `a : A`. Put `D_φ={x ∈ n_φ : x* ∈ n_φ}` and `C_φ=Λ(D_φ) ⊆ H_φ`, with linear
equivalence `e : D_φ ≃ₗ[ℂ] C_φ`, `e(x)=Λ(x)`. for `ξ ∈ C_φ`, the bounded operator underlying
`tomitaCoreToGenerated φ ξ` is `tomitaCoreLeftRepresentation φ ξ=λ_φ(ξ)`. -/
@[simp]
theorem Weight.tomitaCoreToGenerated_apply (φ : Weight A)
    (hφ : ∀ a : PositiveElement A, φ.value a = 0 → (a : A) = 0)
    (ξ : φ.tomitaCore) :
    letI := φ.tomitaCoreNonUnitalRing hφ;
    letI := φ.tomitaCoreStar hφ;
    (φ.tomitaCoreToGenerated hφ ξ : φ.GNS →L[ℂ] φ.GNS) = φ.tomitaCoreLeftRepresentation hφ ξ := by
  let := φ.tomitaCoreNonUnitalRing hφ
  let := φ.tomitaCoreStar hφ
  rfl

end

end CStarAlgebra.ScalarWeight
