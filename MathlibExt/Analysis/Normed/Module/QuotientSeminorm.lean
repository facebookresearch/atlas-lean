module

public import Mathlib.Analysis.LocallyConvex.WithSeminorms
public import Mathlib.Analysis.Normed.Group.Quotient

/-!
# Seminorms on module quotients

Let 𝕜 be a normed field, X a 𝕜-module, p a seminorm, and Y a submodule.
The induced seminorm on X/Y is the infimum of p over each coset.
The quotient projection sends every open p-ball centered at zero onto
the open ball of the quotient seminorm with the same real radius.

If the topology of X is generated by a family p_i indexed by a nonempty
type, the quotient topology is generated by the quotients of the finite
suprema of that family.
-/

@[expose] public section

open Filter Set Topology
open scoped NNReal Topology

noncomputable section

universe u v

namespace Seminorm

/-- **Seminorm induced by the infimum over a quotient coset.** Let `𝕜` be a normed field, `X`
an additive commutative group and `𝕜`-module, `p : Seminorm 𝕜 X`, and `Y : Submodule 𝕜 X`.
The seminorm `p.quotient Y` on `X/Y` satisfies `p.quotient Y ([x])=inf_{y∈Y} p(x+y)`. No
topology or closedness condition on `X` or `Y` is required. -/
noncomputable def quotient
    {𝕜 : Type*} [NormedField 𝕜]
    {X : Type u} [AddCommGroup X] [Module 𝕜 X]
    (p : Seminorm 𝕜 X) (Y : Submodule 𝕜 X) :
    Seminorm 𝕜 (X ⧸ Y) := by
  let _ : SeminormedAddCommGroup X := p.toSeminormedAddCommGroup
  let _ : NormedSpace 𝕜 X :=
    { norm_smul_le := fun a x ↦ le_of_eq (map_smul_eq_mul p a x) }
  exact normSeminorm 𝕜 (X ⧸ Y)

set_option backward.isDefEq.respectTransparency false in
/-- **Value of the quotient seminorm on a projected vector.** Let 𝕜 be a normed field, X a
𝕜-module with additive commutative group, p a seminorm and Y a submodule. For x : X,
p.quotient Y ([x]) = inf {p(x+y) : y ∈ Y}. -/
@[simp]
theorem quotient_mkQ
    {𝕜 : Type*} [NormedField 𝕜]
    {X : Type u} [AddCommGroup X] [Module 𝕜 X]
    (p : Seminorm 𝕜 X) (Y : Submodule 𝕜 X) (x : X) :
    p.quotient Y (Y.mkQ x) =
      sInf (Set.range fun y : Y ↦ p (x + (y : X))) := by
  let _ : SeminormedAddCommGroup X := p.toSeminormedAddCommGroup
  let _ : NormedSpace 𝕜 X :=
    { norm_smul_le := fun a z ↦ le_of_eq (map_smul_eq_mul p a z) }
  change ‖(Y.mkQ x : X ⧸ Y)‖ =
    sInf (Set.range fun y : Y ↦ p (x + (y : X)))
  rw [show Y.mkQ x = QuotientAddGroup.mk' Y.toAddSubgroup x from rfl,
    quotient_norm_mk_eq]
  congr 1
  ext r
  constructor
  · rintro ⟨z, hz, hzr⟩
    refine ⟨⟨z, hz⟩, ?_⟩
    change p (x + z) = r at hzr
    exact hzr
  · rintro ⟨z, hzr⟩
    refine ⟨(z : X), z.property, ?_⟩
    change p (x + (z : X)) = r
    exact hzr

set_option backward.isDefEq.respectTransparency false in
/-- **Quotient projection maps open seminorm balls onto quotient balls.** Let 𝕜 be a normed
field, X a 𝕜-module with additive commutative group, p a seminorm and Y a submodule. For
every real ε, the image of the open p-ball centered at zero with radius ε under X → X/Y is
precisely the open quotient-seminorm ball centered at zero with radius ε. -/
theorem image_ball_quotient
    {𝕜 : Type*} [NormedField 𝕜]
    {X : Type u} [AddCommGroup X] [Module 𝕜 X]
    (p : Seminorm 𝕜 X) (Y : Submodule 𝕜 X) (ε : ℝ) :
    Y.mkQ '' p.ball 0 ε = (p.quotient Y).ball 0 ε := by
  let _ : SeminormedAddCommGroup X := p.toSeminormedAddCommGroup
  let _ : NormedSpace 𝕜 X :=
    { norm_smul_le := fun a z ↦ le_of_eq (map_smul_eq_mul p a z) }
  ext z
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [Seminorm.mem_ball, sub_zero]
    change ‖(Y.mkQ x : X ⧸ Y)‖ < ε
    have hx' : ‖x‖ < ε := by
      change p x < ε
      simpa using hx
    exact (Submodule.Quotient.norm_mk_le Y x).trans_lt hx'
  · intro hz
    rw [Seminorm.mem_ball, sub_zero] at hz
    change ‖z‖ < ε at hz
    obtain ⟨x, hx, hxlt⟩ :=
      Submodule.Quotient.norm_mk_lt z (sub_pos.mpr hz)
    refine ⟨x, ?_, hx⟩
    rw [Seminorm.mem_ball, sub_zero]
    change ‖x‖ < ε
    linarith

end Seminorm

namespace WithSeminorms

/-- **Quotient topology generated by finite suprema of seminorms.** Let `𝕜` be a normed field
and `X` a topological `𝕜`-module with an additive commutative group. Suppose its topology
is generated by seminorms `p_i` indexed by a nonempty type `ι`. For every submodule `Y`,
the quotient topology on `X/Y` is generated by `(sup_{i∈s} p_i).quotient Y` for finite
subsets `s⊆ι`. The quotient seminorm is the infimum over coset representatives. No
closedness of `Y` is assumed. -/
theorem quotient
    {𝕜 : Type*} [NormedField 𝕜]
    {X : Type u} [AddCommGroup X] [Module 𝕜 X]
    [TopologicalSpace X]
    {ι : Type v} [Nonempty ι] {p : ι → Seminorm 𝕜 X}
    (hp : WithSeminorms p) (Y : Submodule 𝕜 X) :
    WithSeminorms (fun s : Finset ι ↦ (s.sup p).quotient Y) := by
  let _ : IsTopologicalAddGroup X := hp.isTopologicalAddGroup
  let q : Finset ι → Seminorm 𝕜 (X ⧸ Y) := fun s ↦
    (s.sup p).quotient Y
  have hmap : Filter.map Y.mkQ (𝓝 (0 : X)) = 𝓝 (0 : X ⧸ Y) := by
    rw [← Y.mkQ.map_zero]
    exact Y.isOpenMap_mkQ.map_nhds_eq Y.continuous_mkQ.continuousAt
  have hsource := hp.hasBasis_zero_ball.map Y.mkQ
  rw [hmap] at hsource
  have hsingle : (𝓝 (0 : X ⧸ Y)).HasBasis
      (fun z : Finset ι × ℝ ↦ 0 < z.2)
      (fun z ↦ (q z.1).ball 0 z.2) := by
    refine hsource.congr (fun _ ↦ Iff.rfl) ?_
    intro z _hz
    simpa [q] using (z.1.sup p).image_ball_quotient Y z.2
  apply SeminormFamily.withSeminorms_of_hasBasis q
  refine hsingle.to_hasBasis ?_ ?_
  · rintro ⟨s, ε⟩ hε
    refine ⟨(q s).ball 0 ε, ?_, Subset.rfl⟩
    rw [SeminormFamily.basisSets_iff]
    exact ⟨{s}, ε, hε, by simp⟩
  · intro U hU
    rw [SeminormFamily.basisSets_iff] at hU
    rcases hU with ⟨t, ε, hε, rfl⟩
    apply hsingle.mem_iff.mp
    rw [Seminorm.ball_finset_sup_eq_iInter q t 0 hε]
    change (⋂ i ∈ t, (q i).ball 0 ε) ∈ 𝓝 (0 : X ⧸ Y)
    rw [Filter.biInter_finset_mem]
    intro s _hs
    exact hsingle.mem_iff.mpr ⟨(s, ε), hε, Subset.rfl⟩

end WithSeminorms

end
