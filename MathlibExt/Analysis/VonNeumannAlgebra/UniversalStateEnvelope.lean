module

public import MathlibExt.Analysis.CStarAlgebra.GNS.UniversalNondegeneracy
public import MathlibExt.Analysis.VonNeumannAlgebra.Generated

/-!
# Von Neumann envelope generated by all normalized-state GNS maps

For a nonunital complex C-star algebra `A`, form the Hilbert direct sum `H_u` of the GNS spaces
of all positive bounded functionals of norm one. Their coordinatewise action is the nonunital
star representation `π_u : A → B(H_u)`.

The enveloping algebra is the von Neumann algebra generated by `π_u(A)`. The source
representation restricts to this carrier, whose inclusion into `B(H_u)` recovers every operator
`π_u(a)`. Its carrier is WOT closed. A zero algebra is allowed.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace CStarAlgebra

universe uA

variable (A : Type uA) [NonUnitalCStarAlgebra A]

/-- **Von Neumann algebra generated by all-state GNS coefficients.** Let `A` be a nonunital
complex C-star algebra. Let `H_u` be the Hilbert direct sum of the GNS spaces of all
positive bounded functionals of norm one, and `π_u : A →⋆ₙₐ[ℂ] B(H_u)` their
coordinatewise GNS representation. `universalStateEnvelopingAlgebra A` is the von Neumann
algebra generated by `π_u(A)`, the double commutant of the unital star algebra generated
by these operators. -/
def universalStateEnvelopingAlgebra : VonNeumannAlgebra (UniversalStateGNSpace A) :=
  VonNeumannAlgebra.generatedBy (Set.range (universalStateGNSRepresentation A))

/-- **Universal-state coefficient belongs to its generated envelope.** Let `A` be a nonunital
complex C-star algebra. Let `H_u` be the Hilbert direct sum of the GNS spaces of all
positive bounded functionals of norm one, and `π_u : A →⋆ₙₐ[ℂ] B(H_u)` their
coordinatewise GNS representation. for every `a∈A`,
`π_u(a)∈universalStateEnvelopingAlgebra A`. -/
theorem universalStateGNSRepresentation_mem_envelope (a : A) :
    universalStateGNSRepresentation A a ∈ universalStateEnvelopingAlgebra A :=
  VonNeumannAlgebra.subset_generatedBy (Set.range (universalStateGNSRepresentation A)) ⟨a, rfl⟩

/-- **Nonunital star map into the all-state enveloping algebra.** Let `A` be a nonunital
complex C-star algebra. Let `H_u` be the Hilbert direct sum of the GNS spaces of all
positive bounded functionals of norm one, and `π_u : A →⋆ₙₐ[ℂ] B(H_u)` their
coordinatewise GNS representation. `toUniversalStateEnvelopingAlgebra A : A →⋆ₙₐ[ℂ]
universalStateEnvelopingAlgebra A` sends `a` to the element represented by `π_u(a)`. -/
def toUniversalStateEnvelopingAlgebra : A →⋆ₙₐ[ℂ] (universalStateEnvelopingAlgebra A) :=
  (universalStateGNSRepresentation A).codRestrict
    (universalStateEnvelopingAlgebra A).toStarSubalgebra.toNonUnitalStarSubalgebra
    (universalStateGNSRepresentation_mem_envelope A)

/-- **Operator inclusion of the all-state von Neumann envelope.** Let `A` be a nonunital
complex C-star algebra. Let `H_u` be the Hilbert direct sum of the GNS spaces of all
positive bounded functionals of norm one, and `π_u : A →⋆ₙₐ[ℂ] B(H_u)` their
coordinatewise GNS representation. `universalStateEnvelopingInclusion A` is the nonunital
complex star homomorphism including the generated algebra into `B(H_u)`. -/
def universalStateEnvelopingInclusion : (universalStateEnvelopingAlgebra A) →⋆ₙₐ[ℂ]
    (UniversalStateGNSpace A →L[ℂ] UniversalStateGNSpace A) :=
  NonUnitalStarSubalgebraClass.subtype
    (universalStateEnvelopingAlgebra A).toStarSubalgebra.toNonUnitalStarSubalgebra

/-- **Envelope inclusion recovers the universal representation.** Let `A` be a nonunital
complex C-star algebra. Let `H_u` be the Hilbert direct sum of the GNS spaces of all
positive bounded functionals of norm one, and `π_u : A →⋆ₙₐ[ℂ] B(H_u)` their
coordinatewise GNS representation. for `a∈A`, including `toUniversalStateEnvelopingAlgebra
A a` into `B(H_u)` gives `π_u(a)`. -/
@[simp]
theorem universalStateEnvelopingInclusion_apply (a : A) :
    universalStateEnvelopingInclusion A (toUniversalStateEnvelopingAlgebra A a) =
      universalStateGNSRepresentation A a := rfl

/-- **WOT closedness of the all-state generated envelope.** Let `A` be a nonunital complex
C-star algebra. Let `H_u` be the Hilbert direct sum of the GNS spaces of all positive
bounded functionals of norm one, and `π_u : A →⋆ₙₐ[ℂ] B(H_u)` their coordinatewise GNS
representation. the operator set `universalStateEnvelopingAlgebra A` is closed in the weak
operator topology of `B(H_u)`. -/
theorem universalStateEnvelopingAlgebra_isClosedWOT :
    IsClosed {T : UniversalStateGNSpace A →WOT[ℂ] UniversalStateGNSpace A |
      T.toCLM ∈ universalStateEnvelopingAlgebra A} :=
  VonNeumannAlgebra.generatedBy_isClosedWOT (Set.range (universalStateGNSRepresentation A))

end CStarAlgebra
