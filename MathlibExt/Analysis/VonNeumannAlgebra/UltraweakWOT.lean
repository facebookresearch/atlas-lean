module

public import MathlibExt.Analysis.VonNeumannAlgebra.Ultraweak
public import Mathlib.Analysis.InnerProductSpace.WeakOperatorTopology

/-!
# Ultraweak algebra elements vary continuously in WOT

For a concrete von Neumann algebra `M ⊆ B(H)` on a complete complex Hilbert space, evaluation by
`ω_(ξ,η)(x)=⟨ξ,xη⟩` is ultraweakly continuous.

Consequently the inclusion from `M` with its ultraweak topology to `B(H)` with the weak operator
topology is continuous. This is the direction from ultraweak to vector-coefficient convergence;
no norm bound on the varying algebra elements is required.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped Topology InnerProductSpace

namespace VonNeumannAlgebra

noncomputable section

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- **Continuous inclusion from ultraweak topology to WOT.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. Equip `M` with the ultraweak topology `σ(M,M_*)`, induced by `x ↦ φ(x)` for `φ ∈
M_*`. the operator inclusion `x ↦ (x : B(H))` is continuous from ultraweak `M` to the weak
operator topology on `B(H)`, generated by the scalar coefficients `⟨ξ,xη⟩`. -/
theorem ultraweak_toWOT_continuous (M : VonNeumannAlgebra H) :
    Continuous (fun x : Ultraweak M =>
      ContinuousLinearMapWOT.ofCLM (ultraweakLinearEquiv M x : H →L[ℂ] H)) := by
  apply ContinuousLinearMapWOT.continuous_iff.mpr
  intro ξ η
  have hvalue (x : Ultraweak M) :
      (normalVectorFunctional M η ξ : StrongDual ℂ M) (ultraweakLinearEquiv M x) =
        ⟪η, (ultraweakLinearEquiv M x : H →L[ℂ] H) ξ⟫_ℂ :=
    vectorFunctional_apply M η ξ (ultraweakLinearEquiv M x)
  simpa only [hvalue, ContinuousLinearMapWOT.ofCLM_apply] using
    ultraweak_eval_continuous M (normalVectorFunctional M η ξ)

end

end VonNeumannAlgebra
