module

public import MathlibExt.Analysis.VonNeumannAlgebra.Generated
public import MathlibExt.Analysis.InnerProductSpace.Group.HaarRegularRepresentation
public import MathlibExt.Analysis.InnerProductSpace.Group.HaarL2.CharacterMultiplierContinuous

/-!
# Weyl operators on scalar Haar square-integrable functions

For a locally compact topological group `G` with Borel structure and regular Haar measure `μ`,
left translations `λ_gξ(s)=ξ(g⁻¹s)` and continuous-character multipliers `U_χξ(s)=χ(s)ξ(s)` are
unitaries on `L²(G,μ)`.

Their generated von Neumann algebra is `W_μ=(StarAlgebra.adjoin ℂ {λ_g,U_χ})''`. Both families
restrict to unitary elements of `W_μ`, retaining these almost-everywhere formulas. The
inverse-character multiplier uses `χ⁻¹(s)=conj χ(s)`. No abelian or Hausdorff group hypothesis,
or equality with the full bounded-operator algebra, is assumed in this construction.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open MeasureTheory
open scoped Topology CStarAlgebra

namespace VonNeumannAlgebra

noncomputable section

universe uG

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
variable (μ : Measure G) [μ.IsHaarMeasure] [μ.Regular]

/-- **Haar translation and character generator set.** Let `G` be a locally compact topological
group with its Borel measurable structure, and `μ` a regular Haar measure. On `L²(G,μ)`,
let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued character
`χ`. `haarWeylGenerators μ=range(λ)∪range(U)` as a subset of `B(L²(G,μ))`. -/
def haarWeylGenerators : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :=
  Set.range (fun g : G =>
    (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g :
      Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) ∪
    Set.range (HaarL2.characterMultiplier (H := ℂ) μ)

/-- **Von Neumann algebra generated by scalar Haar Weyl operators.** Let `G` be a locally
compact topological group with its Borel measurable structure, and `μ` a regular Haar
measure. On `L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous
circle-valued character `χ`. `haarWeylAlgebra μ=W_μ` is the von Neumann algebra generated
by all `λ_g` and `U_χ`. -/
def haarWeylAlgebra : VonNeumannAlgebra (Lp ℂ 2 μ) :=
  generatedBy (haarWeylGenerators μ)

/-- **Double commutant carrier of the Haar Weyl algebra.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. the operator carrier of `W_μ=haarWeylAlgebra μ` is `(StarAlgebra.adjoin ℂ
(range λ ∪ range U))''`. -/
@[simp]
theorem coe_haarWeylAlgebra :
    (haarWeylAlgebra μ : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) =
      Set.centralizer (Set.centralizer
        (StarAlgebra.adjoin ℂ (haarWeylGenerators μ) : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ))) :=
  coe_generatedBy (haarWeylGenerators μ)

/-- **Haar left translation belongs to the Weyl algebra.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. for every `g∈G`, `λ_g∈haarWeylAlgebra μ`. -/
theorem haarLeftRegular_mem_haarWeylAlgebra (g : G) :
    (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g :
      Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) ∈ haarWeylAlgebra μ :=
  subset_generatedBy _ (Or.inl (Set.mem_range_self g))

/-- **Continuous-character multiplier belongs to the Weyl algebra.** Let `G` be a locally
compact topological group with its Borel measurable structure, and `μ` a regular Haar
measure. On `L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous
circle-valued character `χ`. for every `χ∈PontryaginDual G`, `U_χ∈haarWeylAlgebra μ`. -/
theorem characterMultiplier_mem_haarWeylAlgebra (χ : PontryaginDual G) :
    HaarL2.characterMultiplier (H := ℂ) μ χ ∈ haarWeylAlgebra μ :=
  subset_generatedBy _ (Or.inr (Set.mem_range_self χ))

/-- **Inverse character multiplier in the Haar Weyl algebra.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. for every character `χ`, `U_(χ⁻¹)∈haarWeylAlgebra μ`. -/
theorem inverseCharacterMultiplier_mem_haarWeylAlgebra (χ : PontryaginDual G) :
    HaarL2.characterMultiplier (H := ℂ) μ χ⁻¹ ∈ haarWeylAlgebra μ :=
  characterMultiplier_mem_haarWeylAlgebra μ χ⁻¹

/-- **Haar translation as a generated-algebra unitary.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. `haarWeylTranslationUnitary μ g` is the unitary element of `haarWeylAlgebra
μ` represented by `λ_g`. -/
def haarWeylTranslationUnitary (g : G) : unitary (haarWeylAlgebra μ) :=
  ⟨⟨StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g,
      haarLeftRegular_mem_haarWeylAlgebra μ g⟩, by
    constructor
    · apply Subtype.ext
      exact (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g).property.1
    · apply Subtype.ext
      exact (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g).property.2⟩

/-- **Operator value of a Weyl translation unitary.** Let `G` be a locally compact topological
group with its Borel measurable structure, and `μ` a regular Haar measure. On `L²(G,μ)`,
let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued character
`χ`. the bounded operator underlying `haarWeylTranslationUnitary μ g` is `λ_g`. -/
@[simp]
theorem haarWeylTranslationUnitary_coe (g : G) :
    ((haarWeylTranslationUnitary μ g : haarWeylAlgebra μ) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) =
      (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g :
        Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :=
  rfl

/-- **Almost-everywhere action of a Weyl translation.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. for `ξ∈L²(G,μ)`, `(haarWeylTranslationUnitary μ g)ξ(s)=ξ(g⁻¹s)` for
`μ`-almost every `s`. -/
theorem haarWeylTranslationUnitary_ae_eq (g : G) (ξ : Lp ℂ 2 μ) :
    ((haarWeylTranslationUnitary μ g : haarWeylAlgebra μ) :
      Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) ξ =ᵐ[μ] fun s : G => ξ (g⁻¹ * s) :=
  StronglyContinuousUnitaryRepresentation.haarLeftRegular_ae_eq G μ ℂ g ξ

/-- **Character multiplier as a Weyl-algebra unitary.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. `haarWeylCharacterUnitary μ χ` is the unitary element represented by the
multiplier `U_χ`. -/
def haarWeylCharacterUnitary (χ : PontryaginDual G) : unitary (haarWeylAlgebra μ) :=
  ⟨⟨HaarL2.characterMultiplierUnitary (H := ℂ) μ χ,
      characterMultiplier_mem_haarWeylAlgebra μ χ⟩, by
    constructor
    · apply Subtype.ext
      exact (HaarL2.characterMultiplierUnitary (H := ℂ) μ χ).property.1
    · apply Subtype.ext
      exact (HaarL2.characterMultiplierUnitary (H := ℂ) μ χ).property.2⟩

/-- **Operator value of a Weyl character unitary.** Let `G` be a locally compact topological
group with its Borel measurable structure, and `μ` a regular Haar measure. On `L²(G,μ)`,
let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued character
`χ`. the bounded operator underlying `haarWeylCharacterUnitary μ χ` is
`U_χ=HaarL2.characterMultiplier μ χ`. -/
@[simp]
theorem haarWeylCharacterUnitary_coe (χ : PontryaginDual G) :
    ((haarWeylCharacterUnitary μ χ : haarWeylAlgebra μ) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) =
      HaarL2.characterMultiplier (H := ℂ) μ χ :=
  rfl

/-- **Almost-everywhere positive-character multiplier formula.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. for `ξ∈L²(G,μ)`, `(haarWeylCharacterUnitary μ χ)ξ(s)=χ(s)ξ(s)` for
`μ`-almost every `s`, embedding the circle value in `ℂ`. -/
theorem haarWeylCharacterUnitary_ae_eq (χ : PontryaginDual G) (ξ : Lp ℂ 2 μ) :
    ((haarWeylCharacterUnitary μ χ : haarWeylAlgebra μ) :
      Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) ξ =ᵐ[μ]
        fun s : G => ((χ s : Circle) : ℂ) • ξ s :=
  HaarL2.characterMultiplier_ae_eq μ χ ξ

/-- **Almost-everywhere inverse-character multiplier formula.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. `(haarWeylCharacterUnitary μ χ⁻¹)ξ(s)=χ⁻¹(s)ξ(s)` for `μ`-almost every `s`
and `ξ∈L²(G,μ)`. -/
theorem haarWeylInverseCharacterUnitary_ae_eq (χ : PontryaginDual G) (ξ : Lp ℂ 2 μ) :
    ((haarWeylCharacterUnitary μ χ⁻¹ : haarWeylAlgebra μ) :
      Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) ξ =ᵐ[μ]
        fun s : G => ((χ⁻¹ s : Circle) : ℂ) • ξ s :=
  haarWeylCharacterUnitary_ae_eq μ χ⁻¹ ξ

/-- **Containment of the scalar Weyl algebra tested by generators.** Let `G` be a locally
compact topological group with its Borel measurable structure, and `μ` a regular Haar
measure. On `L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous
circle-valued character `χ`. for a von Neumann algebra `N` on `L²(G,μ)`, `haarWeylAlgebra
μ≤N` exactly when all `λ_g` and `U_χ` belong to `N`. -/
theorem haarWeylAlgebra_le_iff (N : VonNeumannAlgebra (Lp ℂ 2 μ)) :
    haarWeylAlgebra μ ≤ N ↔
      (∀ g : G, (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ ℂ g :
        Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) ∈ N) ∧
      ∀ χ : PontryaginDual G, HaarL2.characterMultiplier (H := ℂ) μ χ ∈ N := by
  rw [haarWeylAlgebra, generatedBy_le_iff]
  simp only [haarWeylGenerators, Set.union_subset_iff, Set.range_subset_iff]
  exact Iff.rfl

/-- **Weak-operator closedness of the scalar Haar Weyl algebra.** Let `G` be a locally compact
topological group with its Borel measurable structure, and `μ` a regular Haar measure. On
`L²(G,μ)`, let `λ_g ξ(s)=ξ(g⁻¹s)` and `U_χ ξ(s)=χ(s)ξ(s)` for a continuous circle-valued
character `χ`. the operator carrier of `haarWeylAlgebra μ` is closed in WOT on
`B(L²(G,μ))`. -/
theorem haarWeylAlgebra_isClosedWOT :
    IsClosed {T : Lp ℂ 2 μ →WOT[ℂ] Lp ℂ 2 μ | T.toCLM ∈ haarWeylAlgebra μ} :=
  generatedBy_isClosedWOT (haarWeylGenerators μ)

end

end VonNeumannAlgebra
