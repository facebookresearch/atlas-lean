module

public import MathlibExt.Analysis.VonNeumannAlgebra.Ultraweak
public import MathlibExt.Analysis.VonNeumannAlgebra.PositiveNormalFunctional
public import Mathlib.Analysis.CStarAlgebra.PositiveLinearMap
public import Mathlib.Analysis.Real.Sqrt
public import Mathlib.Topology.Order

/-!
# Ultrastrong-star topology from normal quadratic gauges

For a concrete von Neumann algebra `M`, each positive normal functional gives the quadratic
gauge `q_φ(x)=√(Re φ(x* x+x x*))`. The ultrastrong-star topology is generated by all translated
gauge balls `{x : q_φ(x-a)<r}` with `a∈M` and `r>0`.

The carrier consists of the algebra elements. Convergence along a filter is tested by eventual
membership in every such subbasic ball containing the limit. The same topology results from
indexing these gauges by all monotone members of the normal-functional space `M_*`.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open Filter
open scoped Topology

namespace VonNeumannAlgebra

noncomputable section

universe u v

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- **Quadratic normal-functional gauge of both star squares.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`.
`ultrastrongStarGauge M φ x=q_φ(x)` for `x∈M`. -/
def ultrastrongStarGauge (M : VonNeumannAlgebra H) (φ : PositiveNormalFunctional M)
    (x : M) : ℝ :=
  Real.sqrt (((φ.1 : StrongDual ℂ M) (star x * x + x * star x)).re)

/-- **Zero vector of an ultrastrong-star gauge.** Let `H` be a complete complex Hilbert space
and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for its vector
functionals. Let `M_*` be their norm-closed complex span in the continuous dual `M*`. For
a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`. `q_φ(0)=0` for every
positive normal functional `φ`. -/
theorem ultrastrongStarGauge_zero (M : VonNeumannAlgebra H) (φ : PositiveNormalFunctional M) :
    ultrastrongStarGauge M φ (0 : M) = 0 := by
  simp only [ultrastrongStarGauge, star_zero, mul_zero, add_zero,
    map_zero, Complex.zero_re, Real.sqrt_zero]

/-- **Algebra-element carrier for ultrastrong-star topology.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. `UltraStrongStar M` is a type copy of the elements of `M`, on which translated
normal quadratic gauge balls define the ultrastrong-star topology. -/
def UltraStrongStar (M : VonNeumannAlgebra H) : Type u := M

/-- **Element identification of the ultrastrong-star carrier.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. `ultrastrongStarEquiv M : UltraStrongStar M ≃ M` is the identity on the underlying
algebra elements, with identity inverse. -/
def ultrastrongStarEquiv (M : VonNeumannAlgebra H) : UltraStrongStar M ≃ M :=
  Equiv.refl M

/-- **Translated ultrastrong-star quadratic gauge ball.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`. for `a∈M` and
any `r : ℝ`, `ultrastrongStarBall M φ a r={x : q_φ(x-a)<r}` in the ultrastrong-star
carrier. -/
def ultrastrongStarBall (M : VonNeumannAlgebra H) (φ : PositiveNormalFunctional M)
    (a : M) (r : ℝ) : Set (UltraStrongStar M) :=
  {x | ultrastrongStarGauge M φ (ultrastrongStarEquiv M x - a) < r}

/-- **Positive-radius subbasis of normal gauge balls.** Let `H` be a complete complex Hilbert
space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for its
vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`. the subbasis
contains all sets `{x : q_ψ(x-a)<r}` for every positive normal functional `ψ`, center
`a∈M` and `r>0`. -/
def ultrastrongStarSubbasis (M : VonNeumannAlgebra H) : Set (Set (UltraStrongStar M)) :=
  {s | ∃ φ : PositiveNormalFunctional M, ∃ a : M, ∃ r : ℝ,
    0 < r ∧ s = ultrastrongStarBall M φ a r}

/-- **Topology generated by translated normal quadratic gauges.** Let `H` be a complete
complex Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write
`ω_(ξ,η)(x)=⟨ξ,xη⟩` for its vector functionals. Let `M_*` be their norm-closed complex
span in the continuous dual `M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re
φ(x* x+x x*))`. the topology on `UltraStrongStar M` is generated by all sets `{x :
q_ψ(x-a)<r}` for positive normal `ψ`, `a∈M`, `r>0`. -/
instance ultrastrongStarTopologicalSpace (M : VonNeumannAlgebra H) :
    TopologicalSpace (UltraStrongStar M) :=
  TopologicalSpace.generateFrom (ultrastrongStarSubbasis M)

/-- **Openness of a positive-radius normal gauge ball.** Let `H` be a complete complex Hilbert
space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for its
vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`. for `a∈M` and
`r>0`, `{x : q_φ(x-a)<r}` is open in the ultrastrong-star topology. -/
theorem ultrastrongStarBall_isOpen (M : VonNeumannAlgebra H) (φ : PositiveNormalFunctional M)
    (a : M) {r : ℝ} (hr : 0 < r) : IsOpen (ultrastrongStarBall M φ a r) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨φ, a, r, hr, rfl⟩

/-- **Center belongs to its positive-radius gauge ball.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`. for `a∈M` and
`r>0`, the carrier element corresponding to `a` belongs to `{x : q_φ(x-a)<r}`. -/
theorem mem_ultrastrongStarBall_center (M : VonNeumannAlgebra H)
    (φ : PositiveNormalFunctional M) (a : M) {r : ℝ} (hr : 0 < r) :
    (ultrastrongStarEquiv M).symm a ∈ ultrastrongStarBall M φ a r := by
  change ultrastrongStarGauge M φ (a - a) < r
  simpa only [sub_self, ultrastrongStarGauge_zero] using hr

/-- **Subbasic-ball criterion for ultrastrong-star convergence.** Let `H` be a complete
complex Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write
`ω_(ξ,η)(x)=⟨ξ,xη⟩` for its vector functionals. Let `M_*` be their norm-closed complex
span in the continuous dual `M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re
φ(x* x+x x*))`. along any filter `l`, a family `x_i` converges to `x` exactly when for
every positive normal `ψ`, center `a` and `r>0` with `q_ψ(x-a)<r`, eventually
`q_ψ(x_i-a)<r`. -/
theorem ultrastrongStar_tendsto_iff (M : VonNeumannAlgebra H)
    {I : Type v} {l : Filter I} {f : I → UltraStrongStar M} {x : UltraStrongStar M} :
    Tendsto f l (𝓝 x) ↔
      ∀ (φ : PositiveNormalFunctional M) (a : M) (r : ℝ),
        0 < r → ultrastrongStarGauge M φ (ultrastrongStarEquiv M x - a) < r →
          ∀ᶠ i in l, ultrastrongStarGauge M φ (ultrastrongStarEquiv M (f i) - a) < r := by
  change Tendsto f l (@nhds (UltraStrongStar M)
    (TopologicalSpace.generateFrom (ultrastrongStarSubbasis M)) x) ↔ _
  rw [TopologicalSpace.tendsto_nhds_generateFrom_iff]
  constructor
  · intro h φ a r hr hx
    exact h (ultrastrongStarBall M φ a r) ⟨φ, a, r, hr, rfl⟩ hx
  · intro h s hs hx
    rcases hs with ⟨φ, a, r, hr, rfl⟩
    exact h φ a r hr hx


/-- **Quadratic gauge in the normal-functional-space view.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. For a positive normal functional `φ`, put `q_φ(x)=√(Re φ(x* x+x x*))`. if
`ψ=φ.toNormalFunctionalSpace ∈ M_*`, then `q_φ(x)=√(Re ψ(x* x+x x*))`. -/
theorem ultrastrongStarGauge_eq_normalFunctional (M : VonNeumannAlgebra H)
    (φ : PositiveNormalFunctional M) (x : M) :
    ultrastrongStarGauge M φ x =
      Real.sqrt (((φ.toNormalFunctionalSpace : StrongDual ℂ M)
        (star x * x + x * star x)).re) :=
  rfl

/-- **Subbasis indexed by every monotone normal functional.** Let `H` be a complete complex
Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write `ω_(ξ,η)(x)=⟨ξ,xη⟩` for
its vector functionals. Let `M_*` be their norm-closed complex span in the continuous dual
`M*`. the ultrastrong-star subbasis is exactly the sets `{x : √(Re
ψ((x-a)*(x-a)+(x-a)(x-a)*))<r}` for monotone `ψ∈M_*`, centers `a∈M` and `r>0`. -/
theorem ultrastrongStarSubbasis_eq_normal_monotone (M : VonNeumannAlgebra H) :
    letI : PartialOrder M := CStarAlgebra.spectralOrder M
    letI : PartialOrder ℂ := CStarAlgebra.spectralOrder ℂ
    ultrastrongStarSubbasis M =
      {s | ∃ φ : normalFunctionalSpace M, Monotone (φ : StrongDual ℂ M) ∧
        ∃ a : M, ∃ r : ℝ, 0 < r ∧
          s = {x : UltraStrongStar M |
            Real.sqrt (((φ : StrongDual ℂ M)
              (star (ultrastrongStarEquiv M x - a) * (ultrastrongStarEquiv M x - a) +
                (ultrastrongStarEquiv M x - a) * star (ultrastrongStarEquiv M x - a))).re) < r}} := by
  let : PartialOrder M := CStarAlgebra.spectralOrder M
  let : PartialOrder ℂ := CStarAlgebra.spectralOrder ℂ
  apply Set.ext
  intro s
  constructor
  · rintro ⟨φ, a, r, hr, rfl⟩
    exact ⟨φ.toNormalFunctionalSpace, φ.monotone, a, r, hr, rfl⟩
  · rintro ⟨φ, hφ, a, r, hr, hs⟩
    exact ⟨PositiveNormalFunctional.ofNormalFunctional M φ hφ, a, r, hr, hs⟩

/-- **Normal-monotone functional description of ultrastrong-star topology.** Let `H` be a
complete complex Hilbert space and `M ⊆ B(H)` a concrete von Neumann algebra. Write
`ω_(ξ,η)(x)=⟨ξ,xη⟩` for its vector functionals. Let `M_*` be their norm-closed complex
span in the continuous dual `M*`. the topology is generated by `{x : √(Re
ψ((x-a)*(x-a)+(x-a)(x-a)*))<r}` over all monotone normal functionals `ψ∈M_*`, centers
`a∈M` and `r>0`. -/
theorem ultrastrongStarTopologicalSpace_eq_normal_monotone (M : VonNeumannAlgebra H) :
    letI : PartialOrder M := CStarAlgebra.spectralOrder M
    letI : PartialOrder ℂ := CStarAlgebra.spectralOrder ℂ
    ultrastrongStarTopologicalSpace M =
      TopologicalSpace.generateFrom
        {s | ∃ φ : normalFunctionalSpace M, Monotone (φ : StrongDual ℂ M) ∧
          ∃ a : M, ∃ r : ℝ, 0 < r ∧
            s = {x : UltraStrongStar M |
              Real.sqrt (((φ : StrongDual ℂ M)
                (star (ultrastrongStarEquiv M x - a) * (ultrastrongStarEquiv M x - a) +
                  (ultrastrongStarEquiv M x - a) * star (ultrastrongStarEquiv M x - a))).re) < r}} := by
  let : PartialOrder M := CStarAlgebra.spectralOrder M
  let : PartialOrder ℂ := CStarAlgebra.spectralOrder ℂ
  change TopologicalSpace.generateFrom (ultrastrongStarSubbasis M) = _
  rw [ultrastrongStarSubbasis_eq_normal_monotone]

end

end VonNeumannAlgebra
