        Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν)) ξ :=
    congrArg
      (fun T : Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν) => T ξ)
      (doubleRadonSecondGroupUnitary_coe μ ν α χ)
  have hbase :
      (doubleRadonSpatialNormalHom μ ν α z :
        Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν)) ξ =
      E ((z : Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν) →L[ℂ]
        Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν)) (E.symm ξ)) :=
    by
      calc
        _ = ((HaarL2.radonProductHFirstTensorUnitary (H := H) μ ν).conjStarAlgEquiv
            (z : Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν) →L[ℂ]
              Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν))) ξ :=
          congrArg
            (fun T : Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν) => T ξ)
            (doubleRadonSpatialNormalHom_coe μ ν α z)
        _ = _ := rfl
  exact hmap.trans (hbase.trans
    (congrArg
      (fun v : Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν) => E v)
      (congrArg
        (fun T : Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν) →L[ℂ]
          Completion (Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν) => T (E.symm ξ)) hz)))

/-- **Transported first-coefficient and dual-group generator set.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ : T ≃ₗᵢ[ℂ] Lp H 2
μ` send `ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s) • ξ`. For `P_x
ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated by `Q_x` and
`V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. Write `Γ=PontryaginDual G`, with its
Borel measurable structure, and let `ν` be a regular Haar measure on `Γ`. Let `β` be the
normal character action on `C₁`, and set `C₂=C₁⋊_β Γ` on `D=Completion(T ⊗[ℂ] Lp ℂ 2 ν)`.
Assume also that `G` is Hausdorff. Let `U : D ≃ₗᵢ[ℂ] L_R` be the tensor-to-Radon unitary,
where `L_R=Lp H 2 (radonProd μ ν)` on the Borel topological product `G×Γ`. Write `j₂ : C₁
→ C₂` for the second regular coefficient map. `doubleRadonGenerators μ ν α` is the union
of the operator ranges `x ↦ U j₂(x)U⁻¹`, `x∈C₁`, and `χ ↦ U Λ_χ U⁻¹`, `χ∈Γ`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. The
product-space L² class uses the stated measure `radonProd μ ν`. -/
def doubleRadonGenerators (α : NormalAction G M) :
    Set (Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν)) :=
  Set.range (fun x : crossedProductTensor μ α =>
    (doubleRadonFirstCoefficientNormalHom μ ν α x :
      Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν))) ∪
    Set.range (fun χ : PontryaginDual G => (doubleRadonSecondGroupUnitary μ ν α χ :
      Lp H 2 (Measure.radonProd μ ν) →L[ℂ] Lp H 2 (Measure.radonProd μ ν)))

/-- **Von Neumann algebra generated by double Radon operator images.** Let `G` be a locally
