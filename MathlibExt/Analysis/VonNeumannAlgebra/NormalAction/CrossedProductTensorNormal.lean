module

public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.CrossedProductTensor
public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.CoefficientFaithfulness
public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.CoefficientNormality

/-!
# Normal faithful tensor crossed-product coefficient inclusion

For the regular tensor crossed product `C₁` on `Completion(H ⊗[ℂ] Lp ℂ 2 μ)`, the coefficient
inclusion `x ↦ Q_x` is a normal unital complex star homomorphism `M → C₁`.

It is injective for a regular Haar measure. Its operator value is the transported regular
coefficient `U⁻¹π_α(x)U`, with no separate normality or faithfulness premise on the coefficient
map.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open MeasureTheory
open scoped TensorProduct InnerProductSpace CStarAlgebra

namespace VonNeumannAlgebra.NormalAction

noncomputable section

universe uG uH

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
variable {H : Type uH} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {M : VonNeumannAlgebra H}
variable (μ : Measure G) [μ.IsHaarMeasure] [μ.Regular]

/-- **Normal coefficient map into the tensor crossed product.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ : T ≃ₗᵢ[ℂ] Lp H 2 μ` send
`ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s) • ξ`. For `P_x ξ =ᵐ[μ]
(s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated by `Q_x` and
`V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`.
`crossedProductTensorCoefficientNormalHom μ α : NormalStarAlgHom M C₁` has forward
operator `x ↦ Q_x`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def crossedProductTensorCoefficientNormalHom (α : NormalAction G M) :
    NormalStarAlgHom M (crossedProductTensor μ α) := by
  let S := crossedProductTensor μ α
  let N := spatialTensorProduct M (⊤ : VonNeumannAlgebra (Lp ℂ 2 μ))
  let f := crossedProductTensorCoefficient μ α
  let F : M →L[ℂ] S := ⟨LinearMap.ofClass f, map_continuous f⟩
  let n := regularCoefficientSpatialNormalHom μ α
  have hn (x : M) :
      (n x : UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
        UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ))) = regularCoefficientTensor μ α x :=
    rfl
  refine NormalStarAlgHom.ofVectorFunctionalPullbacks f ?_
  intro ξ η
  let φ : normalFunctionalSpace N :=
    ⟨vectorFunctional N ξ η, vectorFunctional_mem_normalFunctionalSpace N ξ η⟩
  have hmem := n.predualPullback_mem φ
  have hEq : (vectorFunctional S ξ η).comp F =
      (vectorFunctional N ξ η).comp n.toContinuousLinearMap := by
    apply ContinuousLinearMap.ext
    intro x
    calc
      _ = vectorFunctional S ξ η (f x) := rfl
      _ = inner ℂ ξ ((f x : UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
          UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ))) η) :=
        vectorFunctional_apply S ξ η (f x)
      _ = inner ℂ ξ (regularCoefficientTensor μ α x η) :=
        congrArg (fun A : UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
          UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) => inner ℂ ξ (A η))
            (crossedProductTensorCoefficient_apply μ α x)
      _ = inner ℂ ξ ((n x : UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
          UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ))) η) :=
        congrArg (fun A : UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
          UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) => inner ℂ ξ (A η)) (hn x).symm
      _ = vectorFunctional N ξ η (n x) := (vectorFunctional_apply N ξ η (n x)).symm
      _ = ((vectorFunctional N ξ η).comp n.toContinuousLinearMap) x := rfl
  change (vectorFunctional S ξ η).comp F ∈ normalFunctionalSpace M
  rw [hEq]
  exact hmem

/-- **Normal and star coefficient maps agree in the tensor crossed product.** Let `G` be a
locally compact topological group with its Borel structure and regular Haar measure `μ`,
`H` a complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with
norm-continuous inverse predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ :
T ≃ₗᵢ[ℂ] Lp H 2 μ` send `ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s)
• ξ`. For `P_x ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated
by `Q_x` and `V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. for `x∈M`,
`crossedProductTensorCoefficientNormalHom μ α x=crossedProductTensorCoefficient μ α x`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
@[simp]
theorem crossedProductTensorCoefficientNormalHom_apply (α : NormalAction G M) (x : M) :
    crossedProductTensorCoefficientNormalHom μ α x = crossedProductTensorCoefficient μ α x :=
  rfl

/-- **Operator value of the normal tensor coefficient inclusion.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ : T ≃ₗᵢ[ℂ] Lp H 2
μ` send `ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s) • ξ`. For `P_x
ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated by `Q_x` and
`V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. for `x∈M`, the bounded operator
underlying the normal coefficient map is `Q_x=regularCoefficientTensor μ α x`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
@[simp]
theorem crossedProductTensorCoefficientNormalHom_coe (α : NormalAction G M) (x : M) :
    (crossedProductTensorCoefficientNormalHom μ α x :
      UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
        UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ))) = regularCoefficientTensor μ α x :=
  rfl

/-- **Faithfulness of the normal tensor crossed-product inclusion.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ : T ≃ₗᵢ[ℂ] Lp H 2
μ` send `ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s) • ξ`. For `P_x
ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated by `Q_x` and
`V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`.
`crossedProductTensorCoefficientNormalHom μ α : M → C₁` is injective.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
theorem crossedProductTensorCoefficientNormalHom_injective (α : NormalAction G M) :
    Function.Injective (crossedProductTensorCoefficientNormalHom μ α) := by
  intro x y hxy
  apply regularCoefficientTensor_injective μ α
  exact congrArg (fun z : crossedProductTensor μ α =>
    (z : UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)) →L[ℂ]
      UniformSpace.Completion (H ⊗[ℂ] (Lp ℂ 2 μ)))) hxy

end

end VonNeumannAlgebra.NormalAction
