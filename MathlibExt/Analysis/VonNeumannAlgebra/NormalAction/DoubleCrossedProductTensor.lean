module

public import MathlibExt.Topology.Algebra.PontryaginDual.Evaluation
public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.Pullback
public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.CrossedProductTensorNormal
public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.TensorCharacterAction

/-!
# Iterated tensor crossed product and the second dual action

Let `C₁=M⋊_α G` be the tensor regular crossed product with normal character action `β`. Give
`Γ=PontryaginDual G` its Borel structure and a regular Haar measure `ν`. The second regular
construction gives `C₂=C₁⋊_β Γ` on the nested completion
`Completion(Completion(H⊗L²(G,μ))⊗L²(Γ,ν))`.

The second character action pulls back along evaluation `g ↦ (χ ↦ χ(g))` to a normal action of
`G` on `C₂`. It fixes the first-algebra coefficient image and scales the second Haar unitary at
`χ` by `χ(g)`. The construction does not require `G` to be abelian or specify a Fourier
normalization.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open MeasureTheory
open scoped TensorProduct CStarAlgebra

namespace VonNeumannAlgebra.NormalAction

noncomputable section

universe uG uH

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
variable {H : Type uH} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {M : VonNeumannAlgebra H}
variable (μ : Measure G) [μ.IsHaarMeasure] [μ.Regular]
variable [MeasurableSpace (PontryaginDual G)] [BorelSpace (PontryaginDual G)]
variable (ν : Measure (PontryaginDual G)) [ν.IsHaarMeasure] [ν.Regular]

/-- **Second regular tensor crossed product with an explicit dual Haar measure.** Let `G` be a
locally compact topological group with its Borel structure and regular Haar measure `μ`,
`H` a complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with
norm-continuous inverse predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ :
T ≃ₗᵢ[ℂ] Lp H 2 μ` send `ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s)
• ξ`. For `P_x ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated
by `Q_x` and `V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. Write `Γ=PontryaginDual G`,
with its Borel measurable structure, and let `ν` be a regular Haar measure on `Γ`. Let `β`
be the normal character action on `C₁`, and set `C₂=C₁⋊_β Γ` on `D=Completion(T ⊗[ℂ] Lp ℂ
2 ν)`. `doubleCrossedProductTensor μ ν α=C₂` is the von Neumann algebra of the regular
construction for `β` and `ν` on the nested Hilbert tensor `D`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def doubleCrossedProductTensor (α : NormalAction G M) :
    VonNeumannAlgebra
      (UniformSpace.Completion
        (UniformSpace.Completion (H ⊗[ℂ] Lp ℂ 2 μ) ⊗[ℂ] Lp ℂ 2 ν)) :=
  crossedProductTensor ν (tensorCharacterNormalAction μ α)

/-- **Second dual tensor action pulled back by evaluation.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ : T ≃ₗᵢ[ℂ] Lp H 2 μ` send
`ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s) • ξ`. For `P_x ξ =ᵐ[μ]
(s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated by `Q_x` and
`V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. Write `Γ=PontryaginDual G`, with its
Borel measurable structure, and let `ν` be a regular Haar measure on `Γ`. Let `β` be the
normal character action on `C₁`, and set `C₂=C₁⋊_β Γ` on `D=Completion(T ⊗[ℂ] Lp ℂ 2 ν)`.
`doubleDualTensorNormalAction μ ν α : NormalAction G C₂` is the second character action
pulled back along `g ↦ (χ ↦ χ(g))`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def doubleDualTensorNormalAction (α : NormalAction G M) :
    NormalAction G (doubleCrossedProductTensor μ ν α) :=
  comp (tensorCharacterNormalAction ν (tensorCharacterNormalAction μ α))
    (PontryaginDual.evaluation G)

/-- **Second dual action fixes the first crossed-product coefficient image.** Let `G` be a
locally compact topological group with its Borel structure and regular Haar measure `μ`,
`H` a complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with
norm-continuous inverse predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ :
T ≃ₗᵢ[ℂ] Lp H 2 μ` send `ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s)
• ξ`. For `P_x ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated
by `Q_x` and `V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. Write `Γ=PontryaginDual G`,
with its Borel measurable structure, and let `ν` be a regular Haar measure on `Γ`. Let `β`
be the normal character action on `C₁`, and set `C₂=C₁⋊_β Γ` on `D=Completion(T ⊗[ℂ] Lp ℂ
2 ν)`. for `g∈G` and `x∈C₁`, the second dual action fixes `j₂(x)`, where
`j₂=crossedProductTensorCoefficient ν β : C₁ → C₂`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
@[simp]
theorem doubleDualTensorNormalAction_fix_coefficient (α : NormalAction G M) (g : G)
    (x : crossedProductTensor μ α) :
    doubleDualTensorNormalAction μ ν α g
      (crossedProductTensorCoefficient ν (tensorCharacterNormalAction μ α) x) =
        crossedProductTensorCoefficient ν (tensorCharacterNormalAction μ α) x := by
  change tensorCharacterNormalAction ν (tensorCharacterNormalAction μ α)
    (PontryaginDual.evaluation G g)
      (crossedProductTensorCoefficient ν (tensorCharacterNormalAction μ α) x) = _
  exact tensorCharacterNormalAction_fix_coefficient ν (tensorCharacterNormalAction μ α)
    (PontryaginDual.evaluation G g) x

/-- **Second dual action scales the dual Haar implementer.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. Put `T=Completion(H ⊗[ℂ] Lp ℂ 2 μ)` and let `U₀ : T ≃ₗᵢ[ℂ] Lp H 2 μ` send
`ξ⊗f` to the L² class represented μ-almost everywhere by `s ↦ f(s) • ξ`. For `P_x ξ =ᵐ[μ]
(s ↦ α_(s⁻¹)(x)ξ(s))`, put `Q_x=U₀⁻¹P_xU₀`. Let `C₁` be generated by `Q_x` and
`V_g=I_H⊗λ_g`, where `λ_g f =ᵐ[μ] (s ↦ f(g⁻¹s))`. Write `Γ=PontryaginDual G`, with its
Borel measurable structure, and let `ν` be a regular Haar measure on `Γ`. Let `β` be the
normal character action on `C₁`, and set `C₂=C₁⋊_β Γ` on `D=Completion(T ⊗[ℂ] Lp ℂ 2 ν)`.
for `g∈G`, `χ∈Γ`, the second dual action sends `crossedProductTensorGroupUnitary ν β χ` to
`χ(g)` times that unitary.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
@[simp]
theorem doubleDualTensorNormalAction_scale_group (α : NormalAction G M) (g : G)
    (χ : PontryaginDual G) :
    doubleDualTensorNormalAction μ ν α g
      ((crossedProductTensorGroupUnitary ν (tensorCharacterNormalAction μ α) χ).val :
        doubleCrossedProductTensor μ ν α) =
          ((χ g : Circle) : ℂ) •
            ((crossedProductTensorGroupUnitary ν (tensorCharacterNormalAction μ α) χ).val :
              doubleCrossedProductTensor μ ν α) := by
  change tensorCharacterNormalAction ν (tensorCharacterNormalAction μ α)
    (PontryaginDual.evaluation G g)
      ((crossedProductTensorGroupUnitary ν (tensorCharacterNormalAction μ α) χ).val :
        doubleCrossedProductTensor μ ν α) = _
  simpa only [PontryaginDual.evaluation_apply] using
    tensorCharacterNormalAction_scale_group ν (tensorCharacterNormalAction μ α)
      (PontryaginDual.evaluation G g) χ

end

end VonNeumannAlgebra.NormalAction
