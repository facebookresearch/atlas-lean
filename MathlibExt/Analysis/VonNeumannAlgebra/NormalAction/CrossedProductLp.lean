module

public import MathlibExt.Analysis.VonNeumannAlgebra.NormalAction.RegularCoefficientAlgebra
public import MathlibExt.Analysis.VonNeumannAlgebra.Generated
public import Mathlib.Algebra.Star.Subalgebra

/-!
# Regular crossed product on Hilbert-valued Haar L²

For a normal action `α` on `M⊆B(H)` and regular Haar measure `μ`, the regular coefficient is
`π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))` and the left unitary is `λ_g ξ =ᵐ[μ] (s ↦ ξ(g⁻¹s))` on `Lp
H 2 μ`.

Their generated von Neumann algebra is the regular crossed product. The coefficient inclusion
and unitary group map retain these values and satisfy `λ_g π_α(x) λ_g*=π_α(α_g(x))`. The algebra
is WOT closed and is the least von Neumann algebra containing both generator families.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open MeasureTheory
open scoped Topology CStarAlgebra

namespace VonNeumannAlgebra
namespace NormalAction

noncomputable section

universe uG uH

variable {G : Type uG} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [LocallyCompactSpace G] [MeasurableSpace G] [BorelSpace G]
variable {H : Type uH} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {M : VonNeumannAlgebra H}
variable (μ : Measure G) [μ.IsHaarMeasure] [μ.Regular]

/-- **Regular coefficient and Haar unitary generator set.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. `crossedProductGenerators μ α=range(π_α)∪range(λ)` as a subset of `B(L)`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def crossedProductGenerators (α : NormalAction G M) : Set (Lp H 2 μ →L[ℂ] Lp H 2 μ) :=
  Set.range (regularCoefficient μ α) ∪
    Set.range (fun g : G => (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g :
      Lp H 2 μ →L[ℂ] Lp H 2 μ))

/-- **Von Neumann algebra generated by the regular covariant pair.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ
=ᵐ[μ] (s ↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by
`π_α(M)` and `λ(G)`. `crossedProductLp μ α=C` is the von Neumann algebra generated by
`π_α(M)` and `λ(G)` on `L`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def crossedProductLp (α : NormalAction G M) : VonNeumannAlgebra (Lp H 2 μ) :=
  VonNeumannAlgebra.generatedBy (crossedProductGenerators μ α)

/-- **Regular coefficient belongs to the Haar crossed product.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. for `x∈M`, `π_α(x)∈C`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
theorem regularCoefficient_mem_crossedProductLp (α : NormalAction G M) (x : M) :
    regularCoefficient μ α x ∈ crossedProductLp μ α :=
  VonNeumannAlgebra.subset_generatedBy _ (Or.inl (Set.mem_range_self x))

/-- **Haar implementing unitary belongs to the crossed product.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. for `g∈G`, `λ_g∈C`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
theorem haarLeftRegular_mem_crossedProductLp (α : NormalAction G M) (g : G) :
    (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g :
      Lp H 2 μ →L[ℂ] Lp H 2 μ) ∈ crossedProductLp μ α :=
  VonNeumannAlgebra.subset_generatedBy _ (Or.inr (Set.mem_range_self g))

/-- **Coefficient star homomorphism into the regular crossed product.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ
=ᵐ[μ] (s ↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by
`π_α(M)` and `λ(G)`. `crossedProductCoefficient μ α : M →⋆ₐ[ℂ] C` sends `x` to the element
represented by `π_α(x)`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def crossedProductCoefficient (α : NormalAction G M) : M →⋆ₐ[ℂ] crossedProductLp μ α :=
  (regularCoefficientHom μ α).codRestrict (crossedProductLp μ α).toStarSubalgebra
    (regularCoefficient_mem_crossedProductLp μ α)

/-- **Operator value of the crossed-product coefficient inclusion.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ
=ᵐ[μ] (s ↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by
`π_α(M)` and `λ(G)`. for `x∈M`, the operator underlying `crossedProductCoefficient μ α x`
is `π_α(x)=regularCoefficient μ α x`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
@[simp]
theorem crossedProductCoefficient_apply (α : NormalAction G M) (x : M) :
    (crossedProductCoefficient μ α x : Lp H 2 μ →L[ℂ] Lp H 2 μ) = regularCoefficient μ α x :=
  rfl

/-- **Haar group implementer as a crossed-product unitary.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. `crossedProductGroupUnitary μ α g ∈ U(C)` is the element represented by `λ_g`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def crossedProductGroupUnitary (α : NormalAction G M) (g : G) :
    unitary (crossedProductLp μ α) :=
  ⟨⟨StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g,
      haarLeftRegular_mem_crossedProductLp μ α g⟩, by
    constructor
    · apply Subtype.ext
      exact (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g).property.1
    · apply Subtype.ext
      exact (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g).property.2⟩

/-- **Operator value of a crossed-product Haar unitary.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. for `g∈G`, the bounded operator underlying `crossedProductGroupUnitary μ α g`
is `λ_g`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
@[simp]
theorem crossedProductGroupUnitary_coe (α : NormalAction G M) (g : G) :
    ((crossedProductGroupUnitary μ α g : crossedProductLp μ α) :
      Lp H 2 μ →L[ℂ] Lp H 2 μ) =
      (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g :
        Lp H 2 μ →L[ℂ] Lp H 2 μ) :=
  rfl

/-- **Group homomorphism of crossed-product implementers.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. `crossedProductGroupUnitaryHom μ α : G → U(C)` sends `g` to the unitary
represented by `λ_g`, with `λ_(gh)=λ_gλ_h`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
def crossedProductGroupUnitaryHom (α : NormalAction G M) : G →* unitary (crossedProductLp μ α) where
  toFun := crossedProductGroupUnitary μ α
  map_one' := by
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun U : unitary (Lp H 2 μ →L[ℂ] Lp H 2 μ) => U.val)
      (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H).toMonoidHom.map_one
  map_mul' g h := by
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun U : unitary (Lp H 2 μ →L[ℂ] Lp H 2 μ) => U.val)
      ((StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H).toMonoidHom.map_mul g h)

/-- **Covariance inside the Haar crossed-product algebra.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. for `g∈G`, `x∈M`, the coefficient and group maps satisfy `λ_g π_α(x)
λ_g*=π_α(α_g(x))` as elements of `C`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
theorem crossedProduct_covariance (α : NormalAction G M) (g : G) (x : M) :
    (crossedProductGroupUnitary μ α g : crossedProductLp μ α) * crossedProductCoefficient μ α x *
      star (crossedProductGroupUnitary μ α g : crossedProductLp μ α) =
        crossedProductCoefficient μ α (α g x) := by
  apply Subtype.ext
  exact regularCoefficient_covariance μ α g x

/-- **Crossed-product containment tested by its covariant generators.** Let `G` be a locally
compact topological group with its Borel structure and regular Haar measure `μ`, `H` a
complete complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous
inverse predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ
=ᵐ[μ] (s ↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by
`π_α(M)` and `λ(G)`. for a concrete von Neumann algebra `N⊆B(L)`, `C≤N` exactly when
`π_α(x)∈N` for every `x∈M` and `λ_g∈N` for every `g∈G`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
theorem crossedProductLp_le_iff (α : NormalAction G M) (N : VonNeumannAlgebra (Lp H 2 μ)) :
    crossedProductLp μ α ≤ N ↔
      (∀ x : M, regularCoefficient μ α x ∈ N) ∧
        ∀ g : G, (StronglyContinuousUnitaryRepresentation.haarLeftRegular G μ H g :
          Lp H 2 μ →L[ℂ] Lp H 2 μ) ∈ N := by
  rw [crossedProductLp, VonNeumannAlgebra.generatedBy_le_iff]
  simp only [crossedProductGenerators, Set.union_subset_iff, Set.range_subset_iff]
  exact Iff.rfl

/-- **WOT closedness of the regular Haar crossed product.** Let `G` be a locally compact
topological group with its Borel structure and regular Haar measure `μ`, `H` a complete
complex Hilbert space, and `α` a normal action on `M⊆B(H)` with norm-continuous inverse
predual orbits. On `L=Lp H 2 μ`, put `π_α(x)ξ =ᵐ[μ] (s ↦ α_(s⁻¹)(x)ξ(s))`, `λ_g ξ =ᵐ[μ] (s
↦ ξ(g⁻¹s))` and `U_χ ξ =ᵐ[μ] (s ↦ χ(s) • ξ(s))`. Let `C=M⋊_α G` be generated by `π_α(M)`
and `λ(G)`. the operator set `crossedProductLp μ α` is closed in the weak operator
topology on `B(L)`.

Here `=ᵐ[μ]` denotes equality of measurable representatives μ-almost everywhere, not point
evaluation of an L² class. Operator identities are equalities of bounded operators. -/
theorem crossedProductLp_isClosedWOT (α : NormalAction G M) :
    IsClosed {T : Lp H 2 μ →WOT[ℂ] Lp H 2 μ | T.toCLM ∈ crossedProductLp μ α} :=
  VonNeumannAlgebra.generatedBy_isClosedWOT (crossedProductGenerators μ α)

end

end NormalAction
end VonNeumannAlgebra
