module

public import MathlibExt.Analysis.VonNeumannAlgebra.Generated
public import MathlibExt.Analysis.InnerProductSpace.TensorProduct.CompletionAdjoint

/-!
# Spatial tensor products of concrete von Neumann algebras

For concrete von Neumann algebras `M ⊆ B(H)`, `N ⊆ B(K)` on complete complex Hilbert spaces,
their spatial tensor product is the von Neumann algebra generated by the bounded factor
operators `x⊗y` on `L=Completion (H ⊗[ℂ] K)`.

The operator value is `(x⊗y)(ξ⊗η)=xξ⊗yη`, with `‖x⊗y‖≤‖x‖‖y‖`, adjoint `x*⊗y*`, and products
multiplying both factors. The tensor algebra is WOT closed and is contained in a von Neumann
algebra exactly when all these factor operators are. Hilbert spaces may be arbitrary, including
zero spaces.
-/

@[expose] public section

set_option autoImplicit false
set_option relaxedAutoImplicit false

open UniformSpace
open scoped TensorProduct

namespace VonNeumannAlgebra

universe u v

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {K : Type v} [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-- **Von Neumann algebra generated by spatial factor operators.** Let `H,K` be complete
complex Hilbert spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write
`L=Completion (H ⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded
factor operator on `L`. `spatialTensorProduct M N` is the von Neumann algebra on `L`
generated by `{x⊗y : x ∈ M, y ∈ N}`, equivalently the double commutant of their unital
complex star algebra. -/
noncomputable def spatialTensorProduct (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K) :
    VonNeumannAlgebra (Completion (H ⊗[ℂ] K)) :=
  generatedBy (Set.range fun p : M × N =>
    TensorProduct.mapLCompletion (p.1 : H →L[ℂ] H) (p.2 : K →L[ℂ] K))

/-- **Spatial factor operator belongs to the tensor algebra.** Let `H,K` be complete complex
Hilbert spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write
`L=Completion (H ⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded
factor operator on `L`. for `x ∈ M`, `y ∈ N`, the operator
`x⊗y=TensorProduct.mapLCompletion x y` belongs to `spatialTensorProduct M N`. -/
theorem tensorOperator_mem_spatialTensorProduct (M : VonNeumannAlgebra H)
    (N : VonNeumannAlgebra K) (x : M) (y : N) :
    TensorProduct.mapLCompletion (x : H →L[ℂ] H) (y : K →L[ℂ] K) ∈ spatialTensorProduct M N :=
  subset_generatedBy _ (Set.mem_range_self (x, y))

/-- **Spatial factor pair as a tensor-algebra element.** Let `H,K` be complete complex Hilbert
spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H
⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on
`L`. for `x ∈ M`, `y ∈ N`, `spatialTensor M N x y` is the element of `spatialTensorProduct
M N` represented by the bounded operator `x⊗y`. -/
noncomputable def spatialTensor (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    (x : M) (y : N) : spatialTensorProduct M N :=
  ⟨TensorProduct.mapLCompletion (x : H →L[ℂ] H) (y : K →L[ℂ] K),
    tensorOperator_mem_spatialTensorProduct M N x y⟩

/-- **Bounded operator underlying a spatial tensor element.** Let `H,K` be complete complex
Hilbert spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write
`L=Completion (H ⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded
factor operator on `L`. for `x ∈ M`, `y ∈ N`, the operator underlying `spatialTensor M N x
y` is `TensorProduct.mapLCompletion x y=x⊗y`. -/
@[simp]
theorem spatialTensor_coe (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    (x : M) (y : N) :
    (spatialTensor M N x y : Completion (H ⊗[ℂ] K) →L[ℂ] Completion (H ⊗[ℂ] K)) =
      TensorProduct.mapLCompletion (x : H →L[ℂ] H) (y : K →L[ℂ] K) :=
  rfl

/-- **Pure-vector action of a spatial tensor operator.** Let `H,K` be complete complex Hilbert
spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H
⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on
`L`. for `x ∈ M`, `y ∈ N`, `ξ ∈ H` and `η ∈ K`, `(spatialTensor M N x y)(ξ⊗η)=xξ⊗yη` in
`L`. -/
theorem spatialTensor_apply_tmul (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    (x : M) (y : N) (ξ : H) (η : K) :
    (spatialTensor M N x y : Completion (H ⊗[ℂ] K) →L[ℂ] Completion (H ⊗[ℂ] K))
        (ξ ⊗ₜ[ℂ] η : Completion (H ⊗[ℂ] K)) =
      ((x : H →L[ℂ] H) ξ ⊗ₜ[ℂ] (y : K →L[ℂ] K) η : Completion (H ⊗[ℂ] K)) :=
  TensorProduct.mapLCompletion_tmul (x : H →L[ℂ] H) (y : K →L[ℂ] K) ξ η

/-- **Operator-norm bound for a spatial factor pair.** Let `H,K` be complete complex Hilbert
spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H
⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on
`L`. for `x ∈ M`, `y ∈ N`, `‖spatialTensor M N x y‖≤‖x‖*‖y‖`. -/
theorem norm_spatialTensor_le (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    (x : M) (y : N) : ‖spatialTensor M N x y‖ ≤ ‖x‖ * ‖y‖ :=
  TensorProduct.norm_mapLCompletion_le (x : H →L[ℂ] H) (y : K →L[ℂ] K)

/-- **Adjoint of a spatial factor pair.** Let `H,K` be complete complex Hilbert spaces, `M ⊆
B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H ⊗[ℂ] K)` for
their Hilbert tensor product, and `x⊗y` for the bounded factor operator on `L`. for `x ∈
M`, `y ∈ N`, `(spatialTensor M N x y)*=spatialTensor M N x* y*`. -/
@[simp]
theorem star_spatialTensor (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    (x : M) (y : N) :
    star (spatialTensor M N x y) = spatialTensor M N (star x) (star y) := by
  apply Subtype.ext
  exact TensorProduct.star_mapLCompletion (x : H →L[ℂ] H) (y : K →L[ℂ] K)

/-- **Multiplication of spatial factor pairs.** Let `H,K` be complete complex Hilbert spaces,
`M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H ⊗[ℂ] K)`
for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on `L`. for
`x₁,x₂ ∈ M`, `y₁,y₂ ∈ N`, `(x₁x₂)⊗(y₁y₂)=(x₁⊗y₁)(x₂⊗y₂)` as elements of the spatial tensor
algebra. -/
theorem spatialTensor_mul (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    (x₁ x₂ : M) (y₁ y₂ : N) :
    spatialTensor M N (x₁ * x₂) (y₁ * y₂) =
      spatialTensor M N x₁ y₁ * spatialTensor M N x₂ y₂ := by
  apply Subtype.ext
  exact TensorProduct.mapLCompletion_mul
    (x₁ : H →L[ℂ] H) (x₂ : H →L[ℂ] H) (y₁ : K →L[ℂ] K) (y₂ : K →L[ℂ] K)

/-- **Identity element of the spatial tensor algebra.** Let `H,K` be complete complex Hilbert
spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H
⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on
`L`. `spatialTensor M N 1 1=I_L`. -/
@[simp]
theorem spatialTensor_one_one (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K) :
    spatialTensor M N (1 : M) (1 : N) = 1 := by
  apply Subtype.ext
  exact TensorProduct.mapLCompletion_id_id ℂ H K

/-- **Containment tested on spatial factor operators.** Let `H,K` be complete complex Hilbert
spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H
⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on
`L`. for a concrete von Neumann algebra `P ⊆ B(L)`, `spatialTensorProduct M N≤P` exactly
when `x⊗y∈P` for every `x ∈ M`, `y ∈ N`. -/
theorem spatialTensorProduct_le_iff (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K)
    {P : VonNeumannAlgebra (Completion (H ⊗[ℂ] K))} :
    spatialTensorProduct M N ≤ P ↔
      ∀ x : M, ∀ y : N,
        TensorProduct.mapLCompletion (x : H →L[ℂ] H) (y : K →L[ℂ] K) ∈ P := by
  change generatedBy _ ≤ P ↔ _
  rw [generatedBy_le_iff]
  constructor
  · intro h x y
    exact h (Set.mem_range_self (x, y))
  · intro h _ hp
    rcases hp with ⟨⟨x, y⟩, rfl⟩
    exact h x y

/-- **WOT closedness of the spatial tensor algebra.** Let `H,K` be complete complex Hilbert
spaces, `M ⊆ B(H)` and `N ⊆ B(K)` concrete von Neumann algebras. Write `L=Completion (H
⊗[ℂ] K)` for their Hilbert tensor product, and `x⊗y` for the bounded factor operator on
`L`. the operator set `spatialTensorProduct M N` is closed in the weak operator topology
on `B(L)`. -/
theorem spatialTensorProduct_isClosedWOT (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra K) :
    IsClosed {T : Completion (H ⊗[ℂ] K) →WOT[ℂ] Completion (H ⊗[ℂ] K) |
      T.toCLM ∈ spatialTensorProduct M N} :=
  generatedBy_isClosedWOT _

end VonNeumannAlgebra
