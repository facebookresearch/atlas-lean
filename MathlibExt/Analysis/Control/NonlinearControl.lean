/-!
# Nonlinear control systems: Lie brackets, stabilisation and Brockett's condition

Definitions for the nonlinear control system `ẋ = f(x, u)` used by the wanted theorems of
Rashevskii–Chow and Brockett (`WantedExt/Analysis/Control/NonlinearControlWanted.lean`), following
Coron, *Control and Nonlinearity*, AMS 2007, Chapters 3, 10 and 11:

* `iteratedLieBrackets`: the vector fields `f_i` and all their iterated Lie brackets;
* `accessibilitySpace`: their values at a point, spanning Coron's `A(x, 0)` for driftless
  systems (Definitions 3.13–3.16);
* `IsLocallyAsymptoticallyStable`: local asymptotic stability of `0` for `ẋ = X(x)` with `X`
  merely continuous (Definition 10.6);
* `IsLocallyAsymptoticallyStabilizable`: stabilisability by continuous stationary feedback
  (Definition 10.11);
* `BrockettCondition`: the image of every neighbourhood of `(0, 0)` under `f` is a neighbourhood
  of `0` (Theorem 11.1).

It also proves that the nonholonomic integrator satisfies the Lie algebra rank condition everywhere
(Coron, Example 3.20) but violates Brockett's condition (Coron, Example 11.2).
-/

open Set Filter Topology

@[expose] public section

namespace MathlibExt.Analysis.Control

variable {E U : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup U] [NormedSpace ℝ U]

/-- **Iterated Lie brackets of a family of vector fields.** The smallest set of vector fields
on `E` containing every `f i` and closed under the Lie bracket
`[X, Y](x) = DY(x) X(x) - DX(x) Y(x)` (Coron, *Control and Nonlinearity*, Definition 3.10, whose
sign convention agrees with `VectorField.lieBracket`). Its linear span is the Lie algebra
`Lie({f_1, …, f_m})` generated by the fields (Coron, Definition 3.13). -/
inductive iteratedLieBrackets {m : ℕ} (f : Fin m → E → E) : Set (E → E)
  | base (i : Fin m) : iteratedLieBrackets f (f i)
  | bracket {X Y : E → E} :
      iteratedLieBrackets f X → iteratedLieBrackets f Y →
        iteratedLieBrackets f (VectorField.lieBracket ℝ X Y)

/-- **Accessibility space of a driftless system at a point.** For the driftless control-affine
system `ẋ = ∑ u_i f_i(x)`, the span of the values at `x` of the fields `f_i` and of all their
iterated Lie brackets, that is, `{g(x) : g ∈ Lie({f_1, …, f_m})}` (Coron, *Control and
Nonlinearity*, Definition 3.13 and the formula for `A(x_e, u_e)` before Definition 3.16). The
**Lie algebra rank condition** at `x` says that it is all of `E`. -/
def accessibilitySpace {m : ℕ} (f : Fin m → E → E) (x : E) : Submodule ℝ E :=
  Submodule.span ℝ {v | ∃ X ∈ iteratedLieBrackets f, v = X x}

/-- **Local asymptotic stability of an equilibrium of a continuous vector field.** `0` is
locally asymptotically stable for `ẋ = X(x)` if there is `δ > 0` such that for every `ε > 0`
there is `M > 0` with `‖x(t)‖ < ε` for every solution `x` with `‖x(0)‖ < δ` and every time
`t > M` in its interval of definition (Coron, *Control and Nonlinearity*, Definition 10.6, at
`x_e = 0`). Since `X` is only continuous, solutions need not be unique; the condition is imposed
on every solution defined on an interval `[0, τ)`; for finite-dimensional `E` this is equivalent to
imposing it on every maximal solution as Coron does. -/
def IsLocallyAsymptoticallyStable (X : E → E) : Prop :=
  ∃ δ > 0, ∀ ε > 0, ∃ M > 0, ∀ τ : ℝ, ∀ x : ℝ → E,
    (∀ t ∈ Ico 0 τ, HasDerivWithinAt x (X (x t)) (Ico 0 τ) t) → ‖x 0‖ < δ →
      ∀ t ∈ Ico 0 τ, M < t → ‖x t‖ < ε

/-- **Stabilisability by continuous stationary feedback.** The control system `ẋ = f(x, u)` is
locally asymptotically stabilisable by continuous stationary feedback laws if there is a
continuous `u : E → U` with `u 0 = 0` such that `0` is locally asymptotically stable for the
closed-loop system `ẋ = f(x, u(x))` (Coron, *Control and Nonlinearity*, Definition 10.11). -/
def IsLocallyAsymptoticallyStabilizable (f : E × U → E) : Prop :=
  ∃ u : E → U, Continuous u ∧ u 0 = 0 ∧ IsLocallyAsymptoticallyStable fun x => f (x, u x)

/-- **Brockett's condition.** The image under `f` of every neighbourhood of `(0, 0)` is a
neighbourhood of `0` (Coron, *Control and Nonlinearity*, Theorem 11.1; Brockett 1983). -/
def BrockettCondition (f : E × U → E) : Prop :=
  ∀ N ∈ 𝓝 ((0 : E), (0 : U)), f '' N ∈ 𝓝 (0 : E)

/-- **The nonholonomic integrator.** `ẋ₁ = u₁`, `ẋ₂ = u₂`, `ẋ₃ = x₁ u₂ - x₂ u₁`, with state in
`ℝ³` and control in `ℝ²` (Coron, *Control and Nonlinearity*, (3.41) and (11.4); indices start
at `0` here). -/
def nonholonomicIntegrator (p : (Fin 3 → ℝ) × (Fin 2 → ℝ)) : Fin 3 → ℝ :=
  ![p.2 0, p.2 1, p.1 0 * p.2 1 - p.1 1 * p.2 0]

/-- **The nonholonomic integrator violates Brockett's condition** (Coron, *Control and
Nonlinearity*, Example 11.2, after Brockett 1983). No point `(0, 0, η)` with `η ≠ 0` is a value
of the nonholonomic integrator, so even the image of the whole space is not a neighbourhood of
`0`. With Brockett's theorem this shows that the system, although small-time locally
controllable, cannot be locally asymptotically stabilised by continuous stationary feedback. -/
theorem not_brockettCondition_nonholonomicIntegrator :
    ¬ BrockettCondition nonholonomicIntegrator := by
  intro h
  have hN := h univ univ_mem
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.1 hN
  have hmem : (![0, 0, r / 2] : Fin 3 → ℝ) ∈ Metric.ball (0 : Fin 3 → ℝ) r := by
    rw [Metric.mem_ball, dist_zero_right, pi_norm_lt_iff hr]
    intro i
    fin_cases i <;> simp [abs_of_pos hr, hr]
  obtain ⟨p, -, hp⟩ := hball hmem
  have h0 := congrFun hp 0
  have h1 := congrFun hp 1
  have h2 := congrFun hp 2
  simp only [nonholonomicIntegrator, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at h0 h1 h2
  rw [h0, h1] at h2
  simp at h2
  linarith

/-- **Vector fields of the nonholonomic integrator.** `f₁(x) = (1, 0, -x₂)` and
`f₂(x) = (0, 1, x₁)`, so that the nonholonomic integrator is the driftless system
`ẋ = u₁ f₁(x) + u₂ f₂(x)` (Coron, *Control and Nonlinearity*, Example 3.20; indices start at `0`
here). -/
def nonholonomicFields : Fin 2 → (Fin 3 → ℝ) → Fin 3 → ℝ :=
  ![fun x => ![1, 0, -x 1], fun x => ![0, 1, x 0]]

/-- **The nonholonomic integrator as a driftless system.** `f(x, u) = u₁ f₁(x) + u₂ f₂(x)`
(Coron, *Control and Nonlinearity*, (3.41) and Example 3.20). -/
theorem nonholonomicIntegrator_eq_sum (x : Fin 3 → ℝ) (u : Fin 2 → ℝ) :
    nonholonomicIntegrator (x, u) = ∑ i, u i • nonholonomicFields i x := by
  funext j
  fin_cases j
  · simp [nonholonomicIntegrator, nonholonomicFields, Fin.sum_univ_two]
  · simp [nonholonomicIntegrator, nonholonomicFields, Fin.sum_univ_two]
  · simp [nonholonomicIntegrator, nonholonomicFields, Fin.sum_univ_two]
    ring

private theorem hasFDerivAt_affine (c d : Fin 3 → ℝ) (k : Fin 3) (x : Fin 3 → ℝ) :
    HasFDerivAt (fun y : Fin 3 → ℝ => c + y k • d)
      ((ContinuousLinearMap.proj k : (Fin 3 → ℝ) →L[ℝ] ℝ).smulRight d) x :=
  ((ContinuousLinearMap.proj k : (Fin 3 → ℝ) →L[ℝ] ℝ).smulRight d).hasFDerivAt.const_add c

/-- **The bracket of the nonholonomic integrator.** `[f₁, f₂] = (0, 0, 2)` at every point
(Coron, *Control and Nonlinearity*, Example 3.20). -/
theorem lieBracket_nonholonomicFields (x : Fin 3 → ℝ) :
    VectorField.lieBracket ℝ (nonholonomicFields 0) (nonholonomicFields 1) x = ![0, 0, 2] := by
  have h0 : nonholonomicFields 0 = fun y => ![1, 0, 0] + y 1 • ![0, 0, -1] := by
    funext y j; fin_cases j <;> simp [nonholonomicFields]
  have h1 : nonholonomicFields 1 = fun y => ![0, 1, 0] + y 0 • ![0, 0, 1] := by
    funext y j; fin_cases j <;> simp [nonholonomicFields]
  rw [VectorField.lieBracket, h0, h1, (hasFDerivAt_affine ![0, 1, 0] ![0, 0, 1] 0 x).fderiv,
    (hasFDerivAt_affine ![1, 0, 0] ![0, 0, -1] 1 x).fderiv]
  funext j
  fin_cases j
  · simp
  · simp
  · simp; norm_num

/-- **The nonholonomic integrator satisfies the Lie algebra rank condition** at every point
(Coron, *Control and Nonlinearity*, Example 3.20): `f₁(x)`, `f₂(x)` and `[f₁, f₂](x)` span `ℝ³`.
By the Rashevskii–Chow theorem it is therefore globally controllable. -/
theorem accessibilitySpace_nonholonomicFields_eq_top (x : Fin 3 → ℝ) :
    accessibilitySpace nonholonomicFields x = ⊤ := by
  rw [eq_top_iff]
  intro y _
  have hf0 : nonholonomicFields 0 x ∈ accessibilitySpace nonholonomicFields x :=
    Submodule.subset_span ⟨_, iteratedLieBrackets.base 0, rfl⟩
  have hf1 : nonholonomicFields 1 x ∈ accessibilitySpace nonholonomicFields x :=
    Submodule.subset_span ⟨_, iteratedLieBrackets.base 1, rfl⟩
  have hb : (![0, 0, 2] : Fin 3 → ℝ) ∈ accessibilitySpace nonholonomicFields x := by
    rw [← lieBracket_nonholonomicFields x]
    exact Submodule.subset_span ⟨_, iteratedLieBrackets.bracket (iteratedLieBrackets.base 0)
      (iteratedLieBrackets.base 1), rfl⟩
  have hy : y = y 0 • nonholonomicFields 0 x + y 1 • nonholonomicFields 1 x +
      ((y 2 + y 0 * x 1 - y 1 * x 0) / 2) • ![0, 0, 2] := by
    funext j
    fin_cases j <;> simp [nonholonomicFields]
  rw [hy]
  exact Submodule.add_mem _ (Submodule.add_mem _ (Submodule.smul_mem _ _ hf0)
    (Submodule.smul_mem _ _ hf1)) (Submodule.smul_mem _ _ hb)

end MathlibExt.Analysis.Control
