/-!
# Sambale's order bound for finite 2-groups

The counterexample is a direct finite counting variant of the construction behind Olshanskii's
quadratic bounds (*Math. Notes* 23 (1978), 183–185, DOI 10.1007/BF01651428).
We count bilinear maps via their tables. An independent tuple on whose span the map is symmetric
forces the upper-triangular entries of its table in an adapted basis. The remaining entries
bound the number of bad incidences without enumerating the tables.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.TwoGroupAbelianRankOrderBoundKourovka19Problem75Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.75 (B.
Sambale). UnsolvedMath record UM-00701623 (`KOU-19.75`), dataset ulamai/UnsolvedMath v1.8.0.

The rank of an abelian group is its least number of generators, so "rank at most `r`" means
generated by at most `r` elements; the exponent is Mathlib's `Monoid.exponent`.
-/

/-- **Sambale's question on the order of $2$-groups of bounded abelian rank (Kourovka 19.75).**
The statement that for all natural numbers $e$ and $r$, every finite $2$-group $P$ of exponent
$2^e$ in which every abelian subgroup is generated by at most $r$ elements has order
$|P| \le 2^{r(e+1)}$. -/
def twoGroupOrderBoundByAbelianRank : Prop :=
  ∀ (P : Type) [Group P] [Finite P], IsPGroup 2 P → ∀ e r : ℕ, Monoid.exponent P = 2 ^ e →
    (∀ A : Subgroup P, (∀ x ∈ A, ∀ y ∈ A, x * y = y * x) →
      ∃ s : Finset P, s.card ≤ r ∧ Subgroup.closure (s : Set P) = A) →
    Nat.card P ≤ 2 ^ (r * (e + 1))

end MathlibExt.GroupTheory.TwoGroupAbelianRankOrderBoundKourovka19Problem75Wanted

end

open scoped BigOperators
open Module

namespace SambaleCounterexample

private abbrev F := ZMod 2
private abbrev V := Fin 69 → F
private abbrev W := Fin 16 → F
private abbrev Table := Fin 69 × Fin 69 → W
private abbrev Bilin := V →ₗ[F] V →ₗ[F] W
private abbrev Tuple := {u : Fin 13 → V // LinearIndependent F u}
private abbrev Upper := {p : Fin 13 × Fin 13 // p.1 < p.2}

private noncomputable def std := Pi.basisFun F (Fin 69)

private noncomputable def bil (t : Table) : Bilin :=
  std.constr F fun i ↦ std.constr F fun j ↦ t (i, j)

private theorem bil_std (t : Table) (i j : Fin 69) : bil t (std i) (std j) = t (i, j) := by
  simp only [bil, Basis.constr_basis]

private theorem bil_injective : Function.Injective bil := by
  intro s t h
  funext p
  rcases p with ⟨i, j⟩
  calc
    s (i, j) = bil s (std i) (std j) := (bil_std s i j).symm
    _ = bil t (std i) (std j) := by rw [h]
    _ = t (i, j) := bil_std t i j

private def bad (u : Tuple) (t : Table) : Prop :=
  ∀ i j, bil t (u.val i) (u.val j) = bil t (u.val j) (u.val i)

private theorem upper_card : Fintype.card Upper = 78 := by decide +kernel

private theorem w_card : Fintype.card W = 2 ^ 16 := by
  rw [Fintype.card_pi_const, ZMod.card]

private theorem table_card : Fintype.card Table = 2 ^ (16 * 4761) := by
  classical
  rw [Fintype.card_fun, w_card, ← pow_mul, Fintype.card_prod, Fintype.card_fin]

private theorem tuple_card : Nat.card Tuple ≤ 2 ^ 897 := by
  calc
    Nat.card Tuple ≤ Nat.card (Fin 13 → V) :=
      Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
    _ = 2 ^ 897 := by
      rw [Nat.card_fun, Nat.card_fun, Nat.card_eq_fintype_card (α := F), ZMod.card,
        Nat.card_fin, Nat.card_fin, ← pow_mul]

/-- For an independent tuple, the 78 entries above its diagonal are determined by the
reversed entries. Extend the tuple to a basis and restrict a bad table to the other entries. -/
private theorem bad_card (u : Tuple) : Nat.card {t : Table // bad u t} ≤ 2 ^ (16 * 4683) := by
  classical
  let h := u.property.linearIndepOn_id
  let B := Basis.extend h
  let I : Type := h.extend (Set.subset_univ _)
  let instI : Fintype I := Fintype.ofFinite I
  let f (i : Fin 13) : I := ⟨u.val i, Basis.subset_extend h (Set.mem_range_self i)⟩
  have hf : Function.Injective f := fun _ _ he ↦ u.property.injective (congrArg Subtype.val he)
  have hB (i : Fin 13) : B (f i) = u.val i := Basis.extend_apply_self h (f i)
  let del (p : Upper) : I × I := (f p.val.1, f p.val.2)
  have hd : Function.Injective del := by
    intro a b hab
    exact Subtype.ext (Prod.ext (hf (congrArg Prod.fst hab)) (hf (congrArg Prod.snd hab)))
  let Keep := {p : I × I // p ∉ Set.range del}
  let restrict (t : {t : Table // bad u t}) (p : Keep) : W :=
    bil t.val (B p.val.1) (B p.val.2)
  have hR : Function.Injective restrict := by
    intro s t he
    apply Subtype.ext
    apply bil_injective
    apply LinearMap.ext_basis B B
    intro i j
    by_cases hij : (i, j) ∈ Set.range del
    · obtain ⟨⟨⟨k, l⟩, hkl⟩, e⟩ := hij
      have ei : f k = i := congrArg Prod.fst e
      have ej : f l = j := congrArg Prod.snd e
      subst i
      subst j
      have hk : (f l, f k) ∉ Set.range del := by
        rintro ⟨⟨⟨a, b⟩, hab⟩, e'⟩
        have ea : a = l := hf (congrArg Prod.fst e')
        have eb : b = k := hf (congrArg Prod.snd e')
        exact (not_lt_of_ge hkl.le) (ea ▸ eb ▸ hab)
      have hh := congrFun he (⟨(f l, f k), hk⟩ : Keep)
      change bil s.val (B (f l)) (B (f k)) = bil t.val (B (f l)) (B (f k)) at hh
      rw [hB, hB] at hh
      rw [hB, hB, s.property k l, t.property k l]
      exact hh
    · exact congrFun he (⟨(i, j), hij⟩ : Keep)
  have hI : Fintype.card I = 69 := by
    rw [← Module.finrank_eq_card_basis B, Module.finrank_pi, Fintype.card_fin]
  have hdel : Fintype.card (Set.range del) = 78 :=
    (Fintype.card_congr (Equiv.ofInjective del hd).symm).trans upper_card
  have hKeep : Fintype.card Keep = 4683 := by
    change Fintype.card {p : I × I // ¬p ∈ Set.range del} = _
    rw [Fintype.card_subtype_compl, Fintype.card_prod, hI, hdel]
  have hb := Nat.card_le_card_of_injective restrict hR
  rw [Nat.card_fun, Nat.card_eq_fintype_card (α := W), w_card,
    Nat.card_eq_fintype_card (α := Keep), hKeep, ← pow_mul] at hb
  exact hb

private theorem exists_good_table : ∃ t : Table, ∀ u : Tuple, ¬ bad u t := by
  classical
  by_contra! h
  let Inc := Σ u : Tuple, {t : Table // bad u t}
  let instTuple := Fintype.ofFinite Tuple
  have hsurj : Function.Surjective (fun q : Inc ↦ q.2.val) := by
    intro t
    obtain ⟨u, hu⟩ := h t
    exact ⟨⟨u, ⟨t, hu⟩⟩, rfl⟩
  have hlo := Nat.card_le_card_of_surjective _ hsurj
  rw [Nat.card_eq_fintype_card (α := Table), table_card, Nat.card_sigma] at hlo
  have hsum : (∑ u : Tuple, Nat.card {t : Table // bad u t}) ≤ 2 ^ 897 * 2 ^ (16 * 4683) := by
    calc
      _ ≤ ∑ _u : Tuple, 2 ^ (16 * 4683) := Finset.sum_le_sum fun u _ ↦ bad_card u
      _ = Nat.card Tuple * 2 ^ (16 * 4683) := by
        rw [Nat.card_eq_fintype_card, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, Nat.cast_id]
      _ ≤ _ := Nat.mul_le_mul_right _ tuple_card
  rw [← pow_add] at hsum
  have hlt : 2 ^ (897 + 16 * 4683) < 2 ^ (16 * 4761) := by
    apply Nat.pow_lt_pow_right (by decide)
    decide
  exact (not_le_of_gt hlt) (hlo.trans hsum)

/-! ### The group attached to a bilinear map -/

/-- The group with central kernel `W` and bilinear cocycle `b`. -/
private structure CocycleGroup (_b : Bilin) where
  first : V
  second : W

private theorem char_two_add_self {n : ℕ} (x : Fin n → F) : x + x = 0 := by
  rw [← two_nsmul, ← Nat.cast_smul_eq_nsmul F]
  have h : ((2 : ℕ) : F) = 0 := by decide
  rw [h, zero_smul]

private def mul {b : Bilin} (x y : CocycleGroup b) : CocycleGroup b :=
  ⟨x.first + y.first, x.second + y.second + b x.first y.first⟩

private def one (b : Bilin) : CocycleGroup b := ⟨0, 0⟩

private def inv {b : Bilin} (x : CocycleGroup b) : CocycleGroup b :=
  ⟨x.first, x.second + b x.first x.first⟩

private theorem cocycle_ext {b : Bilin} {x y : CocycleGroup b} (h₁ : x.first = y.first)
    (h₂ : x.second = y.second) : x = y := by cases x; cases y; congr

private instance (b : Bilin) : Group (CocycleGroup b) where
  mul := mul
  one := one b
  inv := inv
  mul_assoc x y z := by
    apply cocycle_ext
    · exact add_assoc _ _ _
    · change x.second + y.second + b x.first y.first + z.second + b (x.first + y.first) z.first =
        x.second + (y.second + z.second + b y.first z.first) + b x.first (y.first + z.first)
      simp only [map_add, LinearMap.add_apply]
      abel
  one_mul x := by
    apply cocycle_ext
    · change 0 + x.first = _
      exact zero_add _
    · change 0 + x.second + b 0 x.first = _
      simp
  mul_one x := by
    apply cocycle_ext
    · change x.first + 0 = _
      exact add_zero _
    · change x.second + 0 + b x.first 0 = _
      simp
  inv_mul_cancel x := by
    apply cocycle_ext
    · exact char_two_add_self _
    · change x.second + b x.first x.first + x.second + b x.first x.first = 0
      calc
        _ = (x.second + x.second) + (b x.first x.first + b x.first x.first) := by abel
        _ = 0 := by rw [char_two_add_self, char_two_add_self, add_zero]

private def coordinates (b : Bilin) : CocycleGroup b ≃ V × W where
  toFun x := (x.first, x.second)
  invFun p := ⟨p.1, p.2⟩

private theorem group_finite (b : Bilin) : Finite (CocycleGroup b) :=
  Finite.of_equiv _ (coordinates b).symm

private theorem group_card (b : Bilin) : Nat.card (CocycleGroup b) = 2 ^ 85 := by
  rw [Nat.card_congr (coordinates b), Nat.card_prod, Nat.card_eq_fintype_card (α := W), w_card]
  have hv : Nat.card V = 2 ^ 69 := by
    rw [Nat.card_fun, Nat.card_fin, Nat.card_eq_fintype_card (α := F), ZMod.card]
  rw [hv, ← pow_add]

private theorem square {b : Bilin} (x : CocycleGroup b) : x * x = ⟨0, b x.first x.first⟩ := by
  apply cocycle_ext
  · exact char_two_add_self _
  · change x.second + x.second + b x.first x.first = _
    rw [char_two_add_self, zero_add]

private theorem fourth {b : Bilin} (x : CocycleGroup b) : x ^ 4 = 1 := by
  calc
    x ^ 4 = (x ^ 2) ^ 2 := by
      change x ^ (2 * 2) = (x ^ 2) ^ 2
      exact pow_mul x 2 2
    _ = 1 := by
      have he : x ^ 2 = ⟨0, b x.first x.first⟩ := (pow_two x).trans (square x)
      rw [he, pow_two, square]
      apply cocycle_ext
      · rfl
      · change b 0 0 = 0
        simp

private def project (b : Bilin) : CocycleGroup b →* Multiplicative V where
  toFun x := Multiplicative.ofAdd x.first
  map_one' := rfl
  map_mul' _ _ := rfl

private def projected {b : Bilin} (A : Subgroup (CocycleGroup b)) : Submodule F V :=
  AddSubgroup.toZModSubmodule 2 (A.map (project b)).toAddSubgroup'

private theorem first_mem {b : Bilin} {A : Subgroup (CocycleGroup b)} (a : A) :
    a.val.first ∈ projected A := ⟨a, a.property, rfl⟩

private theorem proj_symm {b : Bilin} {A : Subgroup (CocycleGroup b)}
    (hA : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) (x y : projected A) : b x y = b y x := by
  obtain ⟨a, ha, hab⟩ := Subgroup.mem_map.mp
    (show Multiplicative.ofAdd x.val ∈ A.map (project b) from x.property)
  obtain ⟨c, hc, hcb⟩ := Subgroup.mem_map.mp
    (show Multiplicative.ofAdd y.val ∈ A.map (project b) from y.property)
  have h₁ : a.first = x.val := hab
  have h₂ : c.first = y.val := hcb
  have h := congrArg CocycleGroup.second (hA a ha c hc)
  change a.second + c.second + b a.first c.first = c.second + a.second + b c.first a.first at h
  rw [add_comm c.second a.second, h₁, h₂] at h
  exact add_left_cancel h

private theorem proj_dim (t : Table) (ht : ∀ u : Tuple, ¬ bad u t)
    (A : Subgroup (CocycleGroup (bil t))) (hA : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) :
    Module.finrank F (projected A) ≤ 12 := by
  by_contra! hd
  have hh : 13 ≤ Module.finrank F (projected A) := hd
  let e := Module.finBasis F (projected A)
  let f (i : Fin 13) : Fin (Module.finrank F (projected A)) := Fin.castLE hh i
  have hf : Function.Injective f := by
    intro i j he
    exact Fin.ext (congrArg (fun i : Fin (Module.finrank F (projected A)) ↦ i.val) he)
  have hlin := (e.linearIndependent.comp f hf).map' (projected A).subtype (by simp)
  apply ht ⟨_, hlin⟩
  intro i j
  exact proj_symm hA (e (f i)) (e (f j))

private theorem abelian_card (t : Table) (ht : ∀ u : Tuple, ¬ bad u t)
    (A : Subgroup (CocycleGroup (bil t))) (hA : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) :
    Nat.card A ≤ 2 ^ 28 := by
  let S := projected A
  let e : A → S × W := fun a ↦ (⟨a.val.first, first_mem a⟩, a.val.second)
  have he : Function.Injective e := by
    intro a c h
    apply Subtype.ext
    exact cocycle_ext (congrArg (fun p : S × W ↦ p.1.val) h) (congrArg Prod.snd h)
  have hs : Nat.card S = 2 ^ Module.finrank F S := by
    rw [Nat.card_congr (Module.finBasis F S).equivFun.toEquiv, Nat.card_eq_fintype_card,
      Fintype.card_pi_const, ZMod.card]
  have hb := Nat.card_le_card_of_injective e he
  rw [Nat.card_prod, hs, Nat.card_eq_fintype_card (α := W), w_card, ← pow_add] at hb
  refine hb.trans (Nat.pow_le_pow_right (by decide) ?_)
  have hdim : Module.finrank F S ≤ 12 := proj_dim t ht A hA
  omega

/-- Either a set of at most `r` elements generates the whole group, or one such set
already generates a subgroup of order at least `2^r`. -/
private theorem grow_generators {G : Type} [Group G] [Finite G] (r : ℕ) :
    ∃ s : Finset G, s.card ≤ r ∧
      (Subgroup.closure (s : Set G) = ⊤ ∨ 2 ^ r ≤ Nat.card (Subgroup.closure (s : Set G))) := by
  classical
  induction r with
  | zero => exact ⟨∅, by simp, Or.inr (by simp)⟩
  | succ r ih =>
    obtain ⟨s, hs, ht | hl⟩ := ih
    · exact ⟨s, hs.trans (Nat.le_succ _), Or.inl ht⟩
    let H := Subgroup.closure (s : Set G)
    by_cases hH : H = ⊤
    · exact ⟨s, hs.trans (Nat.le_succ _), Or.inl hH⟩
    have hne : ∃ x : G, x ∉ H := by
      by_contra! h
      exact hH (eq_top_iff.mpr fun x _ ↦ h x)
    obtain ⟨x, hx⟩ := hne
    let K := Subgroup.closure ((insert x s : Finset G) : Set G)
    have hHK : H ≤ K := Subgroup.closure_mono (by simp)
    have hKH : ¬ K ≤ H := fun h ↦ hx (h (Subgroup.subset_closure (by simp)))
    have hc := H.relIndex_mul_card K
    rw [inf_eq_left.mpr hHK] at hc
    have hidx : 2 ≤ H.relIndex K := by
      have hn : H.relIndex K ≠ 1 := fun h ↦ hKH (Subgroup.relIndex_eq_one.mp h)
      have hp : 0 < Nat.card K := Nat.card_pos
      have hzero : H.relIndex K ≠ 0 := by intro h; rw [h, zero_mul] at hc; omega
      omega
    refine ⟨insert x s, (Finset.card_insert_le _ _).trans (Nat.succ_le_succ hs), Or.inr ?_⟩
    change 2 ^ r ≤ Nat.card H at hl
    change 2 ^ (r + 1) ≤ Nat.card K
    rw [pow_succ, mul_comm, ← hc]
    exact Nat.mul_le_mul hidx hl

private theorem generators_of_card_le {G : Type} [Group G] [Finite G] (A : Subgroup G)
    (r : ℕ) (ha : Nat.card A ≤ 2 ^ r) :
    ∃ s : Finset G, s.card ≤ r ∧ Subgroup.closure (s : Set G) = A := by
  classical
  obtain ⟨s, hs, h⟩ := grow_generators (G := A) r
  have ht : Subgroup.closure (s : Set A) = ⊤ :=
    h.elim id (fun hh ↦ Subgroup.eq_top_of_le_card _ (ha.trans hh))
  refine ⟨s.image A.subtype, Finset.card_image_le.trans hs, ?_⟩
  rw [Finset.coe_image, ← MonoidHom.map_closure, ht, Subgroup.map_top, Subgroup.range_subtype]

private theorem counterexample : ∃ (G : Type) (_ : Group G) (_ : Finite G),
    IsPGroup 2 G ∧ Nat.card G = 2 ^ 85 ∧ Monoid.exponent G ∣ 2 ^ 2 ∧
      ∀ A : Subgroup G, (∀ x ∈ A, ∀ y ∈ A, x * y = y * x) →
        ∃ s : Finset G, s.card ≤ 28 ∧ Subgroup.closure (s : Set G) = A := by
  obtain ⟨t, ht⟩ := exists_good_table
  let b := bil t
  let finiteB : Finite (CocycleGroup b) := group_finite b
  refine ⟨CocycleGroup b, inferInstance, inferInstance, IsPGroup.of_card (group_card b),
    group_card b, Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr fourth, ?_⟩
  exact fun A hA ↦ generators_of_card_le A 28 (abelian_card t ht A hA)

end SambaleCounterexample

namespace MathlibExt.GroupTheory.TwoGroupAbelianRankOrderBoundKourovka19Problem75Wanted

/--
**Sambale's order bound for $2$-groups of bounded abelian rank fails (Kourovka 19.75).** There
exist natural numbers $e$ and $r$ and a finite $2$-group $P$ of exponent $2^e$ in which every
abelian subgroup is generated by at most $r$ elements, such that $|P| > 2^{r(e+1)}$.

The Kourovka Archive answers 19.75 "No, it is not true", as follows from Olshanskii's examples of
finite $p$-groups whose abelian subgroups are small compared to the group (pointed out by Mann).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group
Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems,
Problem 19.75 (B. Sambale); resolution: A. Yu. Olshanskii, The number of generators and orders of
abelian subgroups of finite p-groups, Math. Notes 23 (1978), no. 3, 183-185; A. Mann, letter of 23
April 2018, abstract: the least f(n) such that every finite p-group whose abelian subgroups are
generated by at most n elements has at most f(n) generators grows quadratically in n; Kourovka
Archive, Problem 19.75: No, it is not true, as follows from the examples constructed by Olshanskii
(Mann), https://doi.org/10.1007/BF01651428.
-/
public theorem twoGroupOrderBoundByAbelianRank_refuted : ¬ twoGroupOrderBoundByAbelianRank := by
  intro h
  obtain ⟨G, hG, hFinite, hp, hc, hd, hA⟩ := SambaleCounterexample.counterexample
  let groupG : Group G := hG
  let finiteG : Finite G := hFinite
  obtain ⟨e, he, hexp⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hd
  have hbound := h G hp e 28 hexp hA
  rw [hc] at hbound
  have hlt : 28 * (e + 1) < 85 := by omega
  exact (not_le_of_gt (Nat.pow_lt_pow_right (by decide) hlt)) hbound

end MathlibExt.GroupTheory.TwoGroupAbelianRankOrderBoundKourovka19Problem75Wanted
