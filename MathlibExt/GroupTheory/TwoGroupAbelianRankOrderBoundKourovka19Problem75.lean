/-!
# Order bound for 2-groups with abelian subgroups of bounded rank (Kourovka Notebook Problem 19.75)

Kourovka Notebook, Archive of Solved Problems, Problem 19.75 (B. Sambale): let `P` be a finite
`2`-group of exponent `2^e` such that the rank of every abelian subgroup is at most `r`. Is it true
that `|P| ≤ 2^{r(e+1)}`?

We refute this bound by constructing a group of order `2^256` and exponent dividing four whose
abelian subgroups have at most 79 generators.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.75 (B.
Sambale). UnsolvedMath record UM-00701623 (`KOU-19.75`), dataset ulamai/UnsolvedMath v1.8.0.

The rank of an abelian group is its least number of generators, so "rank at most `r`" means
generated by at most `r` elements; the exponent is Mathlib's `Monoid.exponent`.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.TwoGroupAbelianRankOrderBoundKourovka19Problem75Wanted

/-- **Sambale's question on the order of $2$-groups of bounded abelian rank (Kourovka 19.75).**
The statement that for all natural numbers $e$ and $r$, every finite $2$-group $P$ of exponent
$2^e$ in which every abelian subgroup is generated by at most $r$ elements has order
$|P| \le 2^{r(e+1)}$. -/
def twoGroupOrderBoundByAbelianRank : Prop :=
  ∀ (P : Type) [Group P] [Finite P], IsPGroup 2 P → ∀ e r : ℕ, Monoid.exponent P = 2 ^ e →
    (∀ A : Subgroup P, (∀ x ∈ A, ∀ y ∈ A, x * y = y * x) →
      ∃ s : Finset P, s.card ≤ r ∧ Subgroup.closure (s : Set P) = A) →
    Nat.card P ≤ 2 ^ (r * (e + 1))

open Module
open scoped Pointwise

private abbrev F := ZMod 2
private abbrev Vec (n : ℕ) := Fin n → F
private abbrev V := Vec 192
private abbrev Z := Vec 64
private abbrev W := Vec 8
private abbrev U := W × W
private abbrev Forms := V →ₗ[F] V →ₗ[F] Z
private abbrev Blocks := W →ₗ[F] W →ₗ[F] Z

-- The antisymmetric cross block of a form on the two halves of an embedded space.
private def cross (f : U →ₗ[F] V) : Forms →+ Blocks where
  toFun b :=
    let l := f.comp (LinearMap.inl F W W)
    let r := f.comp (LinearMap.inr F W W)
    b.compl₁₂ l r - b.flip.compl₁₂ l r
  map_zero' := by
    ext
    simp
  map_add' b c := by
    apply LinearMap.ext₂
    intro x y
    simp [sub_add_sub_comm]

private theorem cross_apply (f : U →ₗ[F] V) (b : Forms) (x y : W) :
    cross f b x y = b (f (x, 0)) (f (0, y)) - b (f (0, y)) (f (x, 0)) := rfl

private theorem cross_surjective (f : U →ₗ[F] V) (hf : Function.Injective f) :
    Function.Surjective (cross f) := by
  obtain ⟨g, hg⟩ := f.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hf)
  have hgf (u : U) : g (f u) = u := DFunLike.congr_fun hg u
  intro c
  refine ⟨c.compl₁₂ ((LinearMap.fst F W W).comp g) ((LinearMap.snd F W W).comp g), ?_⟩
  apply LinearMap.ext₂
  intro x y
  simp [cross_apply, hgf]

-- Each kernel has index 2^(8·8·64), and there are at most 2^(16·192) embeddings.
private theorem exists_form : ∃ b : Forms, ∀ f : U →ₗ[F] V,
    Function.Injective f → cross f b ≠ 0 := by
  classical
  by_contra! h
  have : Finite (U →ₗ[F] V) := Finite.of_injective _ DFunLike.coe_injective
  let I := {f : U →ₗ[F] V // Function.Injective f}
  let := Fintype.ofFinite I
  let K (i : I) : AddSubgroup Forms := (cross i.1).ker
  have cover : ⋃ i ∈ (Finset.univ : Finset I), (0 : Forms) +ᵥ (K i : Set Forms) = Set.univ := by
    apply Set.iUnion₂_eq_univ_iff.mpr
    intro b
    obtain ⟨f, hf, hb⟩ := h b
    exact ⟨⟨f, hf⟩, Finset.mem_univ _, by simpa [K] using hb⟩
  obtain ⟨i, _, _, hi⟩ := AddSubgroup.exists_index_le_card_of_leftCoset_cover cover
  have hle : Nat.card Blocks ≤ Nat.card (U →ₗ[F] V) := calc
    Nat.card Blocks = (K i).index := by
      dsimp only [K]
      rw [AddSubgroup.index_ker (G := Forms) (G' := Blocks) (cross i.val),
        AddMonoidHom.range_eq_top_of_surjective _ (cross_surjective _ i.2), AddSubgroup.card_top]
    _ ≤ Nat.card I := by simpa [Nat.card_eq_fintype_card] using hi
    _ ≤ _ := Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
  rw [Module.natCard_eq_pow_finrank (K := F),
    Module.natCard_eq_pow_finrank (K := F) (V := U →ₗ[F] V),
    Nat.card_zmod] at hle
  simp only [Blocks, U, W, V, Z, Vec, Module.finrank_linearMap, Module.finrank_prod,
    Module.finrank_pi, Fintype.card_fin] at hle
  rw [Nat.pow_le_pow_iff_right (by decide)] at hle
  omega

-- The central extension with multiplication twisted by the bilinear form.
@[ext] private structure Extension (b : Forms) where
  base : V
  central : Z

private def extensionEquiv (b : Forms) : Extension b ≃ V × Z :=
  ⟨fun x ↦ (x.base, x.central), fun x ↦ ⟨x.1, x.2⟩, fun _ ↦ rfl, fun _ ↦ rfl⟩

private instance extensionFinite {b : Forms} : Finite (Extension b) :=
  Finite.of_equiv _ (extensionEquiv b).symm

private instance extensionMul {b : Forms} : Mul (Extension b) :=
  ⟨fun x y ↦ ⟨x.base + y.base, x.central + y.central + b x.base y.base⟩⟩

private instance extensionOne {b : Forms} : One (Extension b) := ⟨⟨0, 0⟩⟩

private instance extensionInv {b : Forms} : Inv (Extension b) :=
  ⟨fun x ↦ ⟨-x.base, -x.central + b x.base x.base⟩⟩

private instance extensionGroup {b : Forms} : Group (Extension b) :=
  Group.ofLeftAxioms (fun x y z ↦ by
    apply Extension.ext
    · exact add_assoc ..
    · change x.central + y.central + b x.base y.base + z.central + b (x.base + y.base) z.base =
        x.central + (y.central + z.central + b y.base z.base) + b x.base (y.base + z.base)
      simp only [map_add, LinearMap.add_apply]
      abel) (fun x ↦ by
    apply Extension.ext
    · exact zero_add _
    · change 0 + x.central + b 0 x.base = x.central
      simp) (fun x ↦ by
    apply Extension.ext
    · exact neg_add_cancel _
    · change -x.central + b x.base x.base + x.central + b (-x.base) x.base = 0
      simp only [map_neg, LinearMap.neg_apply]
      abel)

private theorem extension_card (b : Forms) : Nat.card (Extension b) = 2 ^ 256 := by
  rw [Nat.card_congr (extensionEquiv b), Nat.card_prod]
  simp [V, Z, Vec]

private theorem extension_pow_four {b : Forms} (x : Extension b) : x ^ 4 = 1 := by
  have sq (y : Extension b) : y * y = ⟨0, b y.base y.base⟩ := by
    apply Extension.ext
    · exact ZModModule.add_self _
    · change y.central + y.central + _ = _
      rw [ZModModule.add_self, zero_add]
  rw [show 4 = 2 * 2 by decide, pow_mul, pow_two, pow_two, sq, sq]
  apply Extension.ext
  · rfl
  · change b 0 0 = 0
    simp

private def projection (b : Forms) : Extension b →* Multiplicative V where
  toFun x := Multiplicative.ofAdd x.base
  map_one' := rfl
  map_mul' _ _ := rfl

private theorem abelian_card_le {b : Forms}
    (hb : ∀ f : U →ₗ[F] V, Function.Injective f → cross f b ≠ 0)
    (A : Subgroup (Extension b)) (hA : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) :
    Nat.card A ≤ 2 ^ 79 := by
  let S := AddSubgroup.toZModSubmodule 2 (A.map (projection b)).toAddSubgroup'
  have memS (v : V) : v ∈ S ↔ ∃ x ∈ A, x.base = v := Iff.rfl
  have symm_on (v w : S) : b v.val w.val = b w.val v.val := by
    obtain ⟨x, hx, ex⟩ := (memS v).mp v.property
    obtain ⟨y, hy, ey⟩ := (memS w).mp w.property
    have he := congrArg Extension.central (hA x hx y hy)
    change x.central + y.central + b x.base y.base = y.central + x.central + b y.base x.base at he
    rw [add_comm y.central x.central, add_right_inj, ex, ey] at he
    exact he
  have hdim : finrank F S < 16 := by
    by_contra! h
    have hle : finrank F U ≤ finrank F S := by
      simpa [U, W, Vec, Module.finrank_prod] using h
    obtain ⟨f, hf⟩ := finrank_le_iff_exists_linearMap.mp hle
    apply hb (S.subtype.comp f) (Subtype.val_injective.comp hf)
    apply LinearMap.ext₂
    intro x y
    exact sub_eq_zero.mpr (symm_on (f (x, 0)) (f (0, y)))
  let encode (x : A) : S × Z := (⟨x.val.base, (memS _).mpr ⟨x, x.property, rfl⟩⟩, x.val.central)
  have hinj : Function.Injective encode := by
    intro x y h
    apply Subtype.ext
    exact Extension.ext (congrArg (fun p : S × Z ↦ p.1.val) h) (congrArg Prod.snd h)
  calc
    Nat.card A ≤ Nat.card (S × Z) := Nat.card_le_card_of_injective _ hinj
    _ = 2 ^ finrank F S * 2 ^ 64 := by
      rw [Nat.card_prod, Module.natCard_eq_pow_finrank (K := F) (V := S), Nat.card_zmod]
      simp [Z, Vec]
    _ ≤ 2 ^ 79 := by
      rw [← pow_add]
      exact Nat.pow_le_pow_right (by decide) (by omega)

-- Each strict step in a chain of finite subgroups at least doubles the order.
private theorem exists_generators {G : Type*} [Group G] [Finite G] (r : ℕ)
    (A : Subgroup G) (hA : Nat.card A ≤ 2 ^ r) :
    ∃ s : Finset G, s.card ≤ r ∧ Subgroup.closure (s : Set G) = A := by
  classical
  induction r generalizing A with
  | zero => exact ⟨∅, by simp, by simp [A.card_le_one_iff_eq_bot.mp (by simpa using hA)]⟩
  | succ r ih =>
    by_cases hbot : A = ⊥
    · exact ⟨∅, by simp, by simp [hbot]⟩
    obtain ⟨B, _, hBA⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.mpr hbot)
    have hi : 2 ≤ B.relIndex A := by
      have hpos : 0 < B.relIndex A := Subgroup.index_pos (H := B.subgroupOf A)
      have hne : B.relIndex A ≠ 1 := fun h ↦ hBA.lt.not_ge (Subgroup.relIndex_eq_one.mp h)
      omega
    have hB : Nat.card B ≤ 2 ^ r := by
      have hmul := B.relIndex_mul_card A
      rw [inf_eq_left.mpr hBA.le] at hmul
      have hle := (Nat.mul_le_mul_right (Nat.card B) hi).trans (hmul.le.trans hA)
      rw [pow_succ] at hle
      omega
    obtain ⟨s, hs, hgen⟩ := ih B hB
    obtain ⟨x, hxA, hxB⟩ := IsConcreteLE.exists_of_lt hBA.lt
    refine ⟨insert x s, (Finset.card_insert_le _ _).trans (by omega), ?_⟩
    rw [Finset.coe_insert, ← Set.singleton_union, Subgroup.closure_union, hgen]
    have hx : x ∈ Subgroup.closure ({x} : Set G) := Subgroup.subset_closure (by simp)
    have hx' : x ∈ Subgroup.closure ({x} : Set G) ⊔ B := Subgroup.mem_sup_left hx
    have hlt : B < Subgroup.closure ({x} : Set G) ⊔ B :=
      lt_of_le_of_ne le_sup_right fun h ↦ hxB (h ▸ hx')
    have hle : Subgroup.closure ({x} : Set G) ⊔ B ≤ A :=
      sup_le ((Subgroup.closure_le _).mpr (by simpa using hxA)) hBA.le
    exact hle.eq_of_not_lt fun h ↦ hBA.2 hlt h

/--
**Sambale's order bound for $2$-groups of bounded abelian rank fails (Kourovka 19.75).** There
exist natural numbers $e$ and $r$ and a finite $2$-group $P$ of exponent $2^e$ in which every
abelian subgroup is generated by at most $r$ elements, such that $|P| > 2^{r(e+1)}$.

The Kourovka Archive answers 19.75 "No, it is not true", as follows from Olshanskii's examples of
finite $p$-groups whose abelian subgroups are small compared to the group (pointed out by Mann).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group
Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems,
Problem 19.75 (B. Sambale); resolution: A. Yu. Olshanskii, The number of generators and orders of
abelian subgroups of finite p-groups, Math. Notes 23 (1978), no. 3, 183-185; A. Mann, letter of 23
April 2018, abstract: the least f(n) such that every finite p-group whose abelian subgroups are
generated by at most n elements has at most f(n) generators grows quadratically in n; Kourovka
Archive, Problem 19.75: No, it is not true, as follows from the examples constructed by Olshanskii
(Mann), https://doi.org/10.1007/BF01651428.
-/
theorem twoGroupOrderBoundByAbelianRank_refuted : ¬ twoGroupOrderBoundByAbelianRank := by
  intro h
  obtain ⟨b, hb⟩ := exists_form
  have hd : Monoid.exponent (Extension b) ∣ 2 ^ 2 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr extension_pow_four
  obtain ⟨e, he, hexp⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hd
  have hbound := h (Extension b) (IsPGroup.of_exponent_dvd_pow hd) e 79 hexp fun A hA ↦
    exists_generators 79 A (abelian_card_le hb A hA)
  rw [extension_card, Nat.pow_le_pow_iff_right (by decide)] at hbound
  omega

end MathlibExt.GroupTheory.TwoGroupAbelianRankOrderBoundKourovka19Problem75Wanted
