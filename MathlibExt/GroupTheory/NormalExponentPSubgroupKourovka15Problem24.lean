module

public import Mathlib.GroupTheory.PGroup

import Mathlib.Data.Nat.Choose.Dvd
import Mathlib.GroupTheory.Nilpotent

/-!
# Normal subgroups of exponent `p` in `p`-groups (Kourovka Notebook Problem 15.24)

Kourovka Notebook, Archive of Solved Problems, Problem 15.24 (Ya. G. Berkovich): if a finite
`p`-group has a subgroup of exponent `p` and order `pⁿ` and `p` is large relative to `n`, must it
have a normal subgroup of exponent `p` and order `pⁿ`?

This file proves the large-prime case `p > n` of Berkovich's question.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 15.24 (Ya. G.
Berkovich). UnsolvedMath record UM-00701112 (`KOU-15.24`), dataset ulamai/UnsolvedMath v1.8.0.

"Sufficiently large relative to `n`" is replaced by the explicit bound `p > n` of the resolution,
which implies the existential reading. Exponent `p` is written `x ^ p = 1` for all elements; for
order `pⁿ` with `n ≥ 1` this is exponent exactly `p`, and `n = 0` is the trivial case.
-/

open Subgroup
open scoped commutatorElement Pointwise

namespace MathlibExt.GroupTheory.NormalExponentPSubgroupKourovka15Problem24Wanted

variable {G : Type*} [Group G]

private theorem commutator_rotate_le {A B C N : Subgroup G} [N.Normal]
    (h₁ : ⁅⁅B, C⁆, A⁆ ≤ N) (h₂ : ⁅⁅C, A⁆, B⁆ ≤ N) : ⁅⁅A, B⁆, C⁆ ≤ N := by
  simp_rw [← QuotientGroup.ker_mk' N, ← Subgroup.map_eq_bot_iff, Subgroup.map_commutator]
    at h₁ h₂ ⊢
  exact Subgroup.commutator_commutator_eq_bot_of_rotate h₁ h₂

private theorem lowerCentral_bracket (i j : ℕ) :
    ⁅(⊤ : Subgroup G).lowerCentralSeries i, (⊤ : Subgroup G).lowerCentralSeries j⁆ ≤
      (⊤ : Subgroup G).lowerCentralSeries (i + j + 1) := by
  induction j generalizing i with
  | zero => simp only [lowerCentralSeries_zero, Nat.add_zero, lowerCentralSeries_succ, le_refl]
  | succ j ih =>
    rw [lowerCentralSeries_succ (H := (⊤ : Subgroup G)) j, commutator_comm]
    apply commutator_rotate_le
    · rw [commutator_comm (⊤ : Subgroup G), ← lowerCentralSeries_succ]
      simpa only [Nat.succ_add, Nat.add_succ] using ih (i + 1)
    · rw [commutator_comm ((⊤ : Subgroup G).lowerCentralSeries i)]
      change _ ≤ ⁅(⊤ : Subgroup G).lowerCentralSeries (i + j + 1), ⊤⁆
      exact commutator_mono_left ((commutator_comm _ _).trans_le (ih i))

/-- The lower central series indexed so that commutators add weights. -/
private def weight (G : Type*) [Group G] (k : ℕ) : Subgroup G :=
  (⊤ : Subgroup G).lowerCentralSeries (k - 1)

private theorem weight_antitone : Antitone (weight G) :=
  fun _ _ h => lowerCentralSeries_antitone ⊤ (Nat.sub_le_sub_right h 1)

private theorem weight_bracket (i j : ℕ) : ⁅weight G i, weight G j⁆ ≤ weight G (i + j) := by
  have (n : ℕ) : (weight G n).Normal := by unfold weight; infer_instance
  cases i with
  | zero => simpa only [Nat.zero_add] using commutator_le_right (weight G 0) (weight G j)
  | succ i =>
    cases j with
    | zero => simpa only [Nat.add_zero] using commutator_le_left (weight G (i + 1)) (weight G 0)
    | succ j => simpa only [weight, Nat.add_succ, Nat.succ_sub_one, Nat.succ_add] using
        (lowerCentral_bracket (G := G) i j)

section Cube

variable {ι : Type*} [DecidableEq ι]

/-- The function with value `a` on the supersets of `S` and value `1` elsewhere. -/
private def face (S : Finset ι) : G →* (Finset ι → G) where
  toFun a T := if S ⊆ T then a else 1
  map_one' := by ext T; simp
  map_mul' a b := by ext T; by_cases h : S ⊆ T <;> simp [h]

/-- The subgroup generated by the faces with the given supports, weighted by their size. -/
private def faces (G : Type*) [Group G] (s : Finset (Finset ι)) : Subgroup (Finset ι → G) :=
  s.sup fun S => (weight G S.card).map (face S)

private theorem face_mem {s : Finset (Finset ι)} {S : Finset ι} (hS : S ∈ s)
    {a : G} (ha : a ∈ weight G S.card) : face S a ∈ faces G s := by
  have hle : (weight G S.card).map (face S) ≤ faces G s := by
    unfold faces
    exact Finset.le_sup (α := Subgroup (Finset ι → G))
      (f := fun U : Finset ι => (weight G U.card).map (face U)) hS
  exact hle (mem_map_of_mem (face S) ha)

private theorem bracket_faces (S T : Finset ι) (a b : G) :
    ⁅face S a, face T b⁆ = face (S ∪ T) ⁅a, b⁆ := by
  ext U
  by_cases hs : S ⊆ U <;> by_cases ht : T ⊆ U <;>
    simp [face, Finset.union_subset_iff, hs, ht, commutatorElement_def]

private theorem face_le_normalizer_faces {s : Finset (Finset ι)}
    (hs : ∀ ⦃U V⦄, U ∈ s → U ⊆ V → V ∈ s) (S : Finset ι) :
    (weight G S.card).map (face S) ≤ normalizer (faces G s) := by
  apply le_normalizer_iff.mpr
  rintro _ ⟨a, ha, rfl⟩
  let e : (Finset ι → G) →* (Finset ι → G) := (MulAut.conj (face S a)).toMonoidHom
  suffices faces G s ≤ (faces G s).comap e from fun _ hf => this hf
  apply Finset.sup_le
  intro T hT
  rintro _ ⟨b, hb, rfl⟩
  have hc : ⁅face S a, face T b⁆ ∈ faces G s := by
    rw [bracket_faces]
    exact face_mem (hs hT Finset.subset_union_right)
      (weight_antitone (Finset.card_union_le S T)
        (weight_bracket _ _ (commutator_mem_commutator ha hb)))
  have hmul := (faces G s).mul_mem hc (face_mem hT hb)
  change face S a * face T b * (face S a)⁻¹ ∈ faces G s
  simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one] using hmul

private theorem eq_one_of_face_absent {s : Finset (Finset ι)} {T : Finset ι}
    (h : ∀ U ∈ s, ¬ U ⊆ T) {f : Finset ι → G} (hf : f ∈ faces G s) : f T = 1 := by
  let e : (Finset ι → G) →* G := Pi.evalMonoidHom (fun _ => G) T
  have hh : faces G s ≤ e.ker := by
    apply Finset.sup_le
    intro U hU
    rintro _ ⟨a, _, rfl⟩
    simp [e, face, h U hU]
  exact hh hf

/-- If a cube is trivial on the proper subsets of `T`, its value at `T` has weight
at least the size of `T`. -/
private theorem value_mem_weight {s : Finset (Finset ι)}
    (hs : ∀ ⦃U V⦄, U ∈ s → U ⊆ V → V ∈ s)
    {f : Finset ι → G} (hf : f ∈ faces G s) (T : Finset ι)
    (hT : ∀ U ⊂ T, f U = 1) : f T ∈ weight G T.card := by
  induction s using Finset.strongInductionOn generalizing f with
  | _ s ih =>
    rcases s.eq_empty_or_nonempty with rfl | hn
    · rw [eq_one_of_face_absent (by simp) hf]
      exact one_mem _
    obtain ⟨S, hS, hmin⟩ := Finset.exists_min_image s Finset.card hn
    by_cases hsize : T.card ≤ S.card
    · let e : (Finset ι → G) →* G := Pi.evalMonoidHom (fun _ => G) T
      suffices faces G s ≤ (weight G T.card).comap e from this hf
      apply Finset.sup_le
      intro U hU
      rintro _ ⟨a, ha, rfl⟩
      change (if U ⊆ T then a else 1) ∈ weight G T.card
      split
      · exact weight_antitone (hsize.trans (hmin U hU)) ha
      · exact one_mem _
    have hs' : ∀ ⦃U V⦄, U ∈ s.erase S → U ⊆ V → V ∈ s.erase S := by
      intro U V hU hUV
      obtain ⟨hne, hm⟩ := Finset.mem_erase.mp hU
      refine Finset.mem_erase.mpr ⟨?_, hs hm hUV⟩
      rintro rfl
      exact (not_lt_of_ge (hmin U hm)) (Finset.card_lt_card (lt_of_le_of_ne hUV hne))
    -- A minimal support can be separated from the others, which it normalizes.
    rw [← Finset.insert_erase hS, faces, Finset.sup_insert] at hf
    have hprod := coe_mul_of_left_le_normalizer_right _ _ (face_le_normalizer_faces (G := G) hs' S)
    change f ∈ ((weight G S.card).map (face S) ⊔
      faces G (s.erase S) : Subgroup (Finset ι → G)) at hf
    rw [← SetLike.mem_coe, hprod] at hf
    obtain ⟨_, ⟨a, _, rfl⟩, g, hg, rfl⟩ := Set.mem_mul.mp hf
    have ha : S ⊆ T → a = 1 := by
      intro hST
      have hne : S ≠ T := by rintro rfl; exact hsize le_rfl
      have hgS : g S = 1 := eq_one_of_face_absent (fun U hU hUS =>
        (not_lt_of_ge (hmin U (Finset.mem_of_mem_erase hU)))
          (Finset.card_lt_card (lt_of_le_of_ne hUS (Finset.ne_of_mem_erase hU)))) hg
      simpa [face, hgS] using hT S (lt_of_le_of_ne hST hne)
    have huv (U : Finset ι) (hU : U ⊆ T) : (face S a * g) U = g U := by
      by_cases hSU : S ⊆ U
      · simp [face, ha (hSU.trans hU)]
      · simp [face, hSU]
    rw [huv T le_rfl]
    exact ih _ (Finset.erase_ssubset hS) hs' hg (fun U hU => (huv U hU.le).symm.trans (hT U hU))

private theorem face_count_mem [Fintype ι] (s : Finset (Finset ι)) (a : G)
    (ha : ∀ U ∈ s, a ∈ weight G U.card) :
    (fun T : Finset ι => a ^ (s.filter (· ⊆ T)).card) ∈ faces G Finset.univ := by
  induction s using Finset.induction_on with
  | empty =>
    have h : (fun T : Finset ι => a ^ ((∅ : Finset (Finset ι)).filter (· ⊆ T)).card) = 1 := by
      funext T
      simp
    rw [h]
    exact one_mem _
  | insert S s hS ih =>
    have hface : face S a ∈ faces G (Finset.univ : Finset (Finset ι)) :=
      face_mem (Finset.mem_univ _) (ha _ (Finset.mem_insert_self _ _))
    have htail := ih (fun U hU => ha U (Finset.mem_insert_of_mem hU))
    convert (faces G (Finset.univ : Finset (Finset ι))).mul_mem hface htail using 1
    funext T
    change a ^ ((insert S s).filter (· ⊆ T)).card =
      (if S ⊆ T then a else 1) * a ^ (s.filter (· ⊆ T)).card
    by_cases hST : S ⊆ T
    · simp [Finset.filter_insert, hST, hS, pow_succ']
    · simp [Finset.filter_insert, hST]

private theorem binomial_face_mem (p k : ℕ) {a : G} (ha : a ∈ weight G k) :
    (fun T : Finset (Fin p) => a ^ T.card.choose k) ∈ faces G Finset.univ := by
  let s := (Finset.univ : Finset (Fin p)).powersetCard k
  have h := face_count_mem s a (fun U hU => (Finset.mem_powersetCard.mp hU).2.symm ▸ ha)
  convert h using 1
  funext T
  have hfilter : s.filter (· ⊆ T) = T.powersetCard k := by
    ext U
    simp [s, and_comm]
  rw [hfilter, Finset.card_powersetCard]

private theorem weight_of_symmetric_faces {p k : ℕ} (hkp : k ≤ p) {f : ℕ → G}
    (hf : (fun T : Finset (Fin p) => f T.card) ∈ faces G Finset.univ)
    (hzero : ∀ j < k, f j = 1) : f k ∈ weight G k := by
  let T := Finset.univ.map (Fin.castLEEmb hkp)
  have hT : T.card = k := by simp [T]
  have hv := value_mem_weight (by intro U V _ _; exact Finset.mem_univ V) hf T
    (fun U hU => hzero U.card (hT ▸ Finset.card_lt_card hU))
  rwa [hT] at hv

private theorem symmetric_faces_at_prime {p : ℕ} (hp : p.Prime)
    (hweight : weight G p = ⊥) (H : Subgroup G)
    (hpow : ∀ a ∈ H, a ^ p = 1) {f : ℕ → G} (hzero : f 0 = 1)
    (hmem : ∀ k, f k ∈ H)
    (hf : (fun T : Finset (Fin p) => f T.card) ∈ faces G Finset.univ) :
    f p = 1 := by
  suffices ∀ (k : ℕ), 1 ≤ k → k ≤ p → ∀ f : ℕ → G,
      (∀ j < k, f j = 1) → (∀ j, f j ∈ H) →
      (fun T : Finset (Fin p) => f T.card) ∈ faces G Finset.univ → f p = 1 by
    exact this 1 (le_refl _) hp.pos f (fun j hj => by rwa [Nat.lt_one_iff.mp hj]) hmem hf
  intro k hk hkp
  revert hk
  refine Nat.decreasingInduction' (n := p)
    (motive := fun r => 1 ≤ r → ∀ f : ℕ → G, (∀ j < r, f j = 1) → (∀ j, f j ∈ H) →
      (fun T : Finset (Fin p) => f T.card) ∈ faces G Finset.univ → f p = 1) ?_ hkp ?_
  · intro j hjp _ ih hj f hzero hmem hf
    -- Remove the same value on every face with `j` indices. At `p`, it occurs
    -- `p.choose j` times, so this leaves the value at `p` unchanged.
    have hw := weight_of_symmetric_faces hjp.le hf hzero
    let g : ℕ → G := fun n => (f j ^ n.choose j)⁻¹ * f n
    have hg : (fun T : Finset (Fin p) => g T.card) ∈ faces G Finset.univ :=
      (faces G Finset.univ).mul_mem ((faces G Finset.univ).inv_mem (binomial_face_mem p j hw)) hf
    have hgp : g p = f p := by
      obtain ⟨m, hm⟩ := hp.dvd_choose_self (by omega) hjp
      simp [g, hm, pow_mul, hpow _ (hmem j)]
    rw [← hgp]
    apply ih (by omega) g _ (fun n => H.mul_mem (H.inv_mem (H.pow_mem (hmem j) _)) (hmem n)) hg
    intro n hn
    rcases lt_or_eq_of_le (Nat.le_of_lt_succ hn) with h | rfl
    · simp [g, Nat.choose_eq_zero_of_lt h, hzero _ h]
    · simp [g]
  · intro _ f hzero _ hf
    simpa [hweight] using weight_of_symmetric_faces (le_refl p) hf hzero

end Cube


private theorem commutator_lt_of_ne_bot [Group.IsNilpotent G] (H : Subgroup G) [H.Normal]
    (hH : H ≠ ⊥) : ⁅H, (⊤ : Subgroup G)⁆ < H := by
  apply lt_of_le_of_ne (commutator_le_left _ _)
  intro heq
  have le_series (i : ℕ) : H ≤ (⊤ : Subgroup G).lowerCentralSeries i := by
    induction i with
    | zero => exact le_top
    | succ i ih =>
      rw [lowerCentralSeries_succ, ← heq]
      exact commutator_mono_left ih
  exact hH (bot_unique (by simpa using le_series (Group.nilpotencyClass G)))

private def relativeSeries (H : Subgroup G) (i : ℕ) : Subgroup G :=
  (fun K : Subgroup G => ⁅K, (⊤ : Subgroup G)⁆)^[i] H

private theorem relativeSeries_succ (H : Subgroup G) (i : ℕ) :
    relativeSeries H (i + 1) = ⁅relativeSeries H i, (⊤ : Subgroup G)⁆ :=
  Function.iterate_succ_apply' _ _ _

private theorem relativeSeries_eq_bot [Finite G] {p : ℕ} [Fact p.Prime] (hG : IsPGroup p G)
    (H : Subgroup G) [H.Normal] {n : ℕ} (hsize : Nat.card H ≤ p ^ n) :
    relativeSeries H n = ⊥ := by
  let : Group.IsNilpotent G := hG.isNilpotent
  have hp : p.Prime := Fact.out
  induction n generalizing H with
  | zero => exact (eq_bot_iff_card H).mpr (by simpa using Nat.le_antisymm hsize Nat.card_pos)
  | succ n ih =>
    rw [relativeSeries, Function.iterate_succ_apply]
    by_cases hH : H = ⊥
    · subst H
      simp only [commutator_bot_left]
      exact ih ⊥ (by simp [one_le_pow₀ hp.one_lt.le])
    apply ih
    obtain ⟨m, hm⟩ := (hG.to_subgroup ⁅H, (⊤ : Subgroup G)⁆).exists_card_eq
    have hlt : Nat.card (⁅H, (⊤ : Subgroup G)⁆ : Subgroup G) < p ^ (n + 1) :=
      (card_lt_of_lt (commutator_lt_of_ne_bot H hH)).trans_le hsize
    rw [hm, pow_lt_pow_iff_right₀ hp.one_lt, Nat.lt_succ_iff] at hlt
    rw [hm, pow_le_pow_iff_right₀ hp.one_lt]
    exact hlt

private theorem commutator_le_of_cyclic_sup (H : Subgroup G) [H.Normal] (x : G)
    (hgen : H ⊔ zpowers x = ⊤) : _root_.commutator G ≤ ⁅H, (⊤ : Subgroup G)⁆ := by
  let L : Subgroup G := ⁅H, (⊤ : Subgroup G)⁆
  let q := QuotientGroup.mk' L
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective L
  have hcentral : H.map q ≤ center (G ⧸ L) := by
    rw [← commutator_top_right_eq_bot_iff_le_center, ← map_top_of_surjective q hq,
      ← map_commutator, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  have hsplit : zpowers (q x) ⊔ H.map q = ⊤ := by
    rw [← MonoidHom.map_zpowers, ← Subgroup.map_sup, sup_comm, hgen, map_top_of_surjective q hq]
  let : (H.map q).Normal := (inferInstance : H.Normal).map q hq
  apply (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := L)).mp
  refine ⟨⟨fun a b => ?_⟩⟩
  obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := mem_sup_of_normal_right.mp (hsplit.symm ▸ mem_top a)
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := mem_sup_of_normal_right.mp (hsplit.symm ▸ mem_top b)
  have hcomm : Commute a₁ b₁ := setLike_mul_comm ha₁ hb₁
  have ha (y : G ⧸ L) : Commute a₂ y := ((mem_center_iff.mp (hcentral ha₂)) y).symm
  have hb (y : G ⧸ L) : Commute y b₂ := (mem_center_iff.mp (hcentral hb₂)) y
  exact (hcomm.mul_right (hb a₁)).mul_left (ha (b₁ * b₂))

private theorem lowerCentral_eq_bot_of_cyclic_sup [Finite G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) (H : Subgroup G) [H.Normal] (x : G) (hgen : H ⊔ zpowers x = ⊤)
    {n : ℕ} (hn : 0 < n) (hsize : Nat.card H ≤ p ^ n) :
    (⊤ : Subgroup G).lowerCentralSeries n = ⊥ := by
  have hle (i : ℕ) : (⊤ : Subgroup G).lowerCentralSeries (i + 1) ≤ relativeSeries H (i + 1) := by
    induction i with
    | zero =>
      rw [top_lowerCentralSeries_one, relativeSeries_succ]
      exact commutator_le_of_cyclic_sup H x hgen
    | succ i ih =>
      rw [lowerCentralSeries_succ, relativeSeries_succ]
      exact commutator_mono_left ih
  obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
  exact bot_unique ((hle i).trans (relativeSeries_eq_bot hG H hsize).le)

private theorem exists_normal_le_card_pow [Finite G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) (K : Subgroup G) [K.Normal] (n : ℕ)
    (hsize : p ^ n ∣ Nat.card K) :
    ∃ N : Subgroup G, N.Normal ∧ N ≤ K ∧ Nat.card N = p ^ n := by
  have hp : p.Prime := Fact.out
  let : Group.IsNilpotent G := hG.isNilpotent
  induction n generalizing G with
  | zero => exact ⟨⊥, inferInstance, bot_le, by simp⟩
  | succ n ih =>
    have hK : K ≠ ⊥ := by
      intro hbot
      simpa [hbot, hp.ne_one] using (dvd_pow_self p (by omega : n + 1 ≠ 0)).trans hsize
    let C := K ⊓ center G
    have hC : C ≠ ⊥ := Group.IsNilpotent.inf_center_ne_bot_of_normal hK
    have hdvd : p ∣ Nat.card C :=
      (hG.to_subgroup C).card_eq_or_dvd.resolve_left (mt (eq_bot_iff_card C).mpr hC)
    obtain ⟨Z, hZcard, hZle⟩ :=
      Sylow.exists_subgroup_card_pow_prime_le (n := 1) hp C (by simpa using hdvd)
    have hZK : Z ≤ K := hZle.trans inf_le_left
    let : Z.Normal := normal_of_le_center (hZle.trans inf_le_right)
    let q := QuotientGroup.mk' Z
    let K' := K.map q
    have hq : Function.Surjective q := QuotientGroup.mk'_surjective Z
    let : K'.Normal := (inferInstance : K.Normal).map q hq
    have card_mul (L : Subgroup G) (hL : Z ≤ L) :
        Nat.card (L.map q) * p = Nat.card L := by
      have h := Subgroup.card_ker_mul_card_range (q.domRestrict L)
      have hrange : (q.domRestrict L).range = L.map q := by
        change (q.comp L.subtype).range = _
        rw [MonoidHom.range_comp, range_subtype]
      rw [hrange] at h
      have hker : (q.domRestrict L).ker = Z.subgroupOf L := by
        ext x
        exact QuotientGroup.eq_one_iff x.1
      rw [hker, Nat.card_congr (subgroupOfEquivOfLe hL).toEquiv, hZcard, pow_one, mul_comm] at h
      exact h
    have hdvd' : p ^ n ∣ Nat.card K' := by
      apply (Nat.mul_dvd_mul_iff_right hp.pos).mp
      change p ^ n * p ∣ Nat.card (K.map q) * p
      rwa [← pow_succ, card_mul K hZK]
    obtain ⟨N, hN, hNK, hNcard⟩ := ih (hG.to_quotient Z) K' hdvd'
    let L := N.comap q
    have hZL : Z ≤ L := by
      intro x hx
      change q x ∈ N
      have hx' : q x = 1 := (QuotientGroup.eq_one_iff x).mpr hx
      rw [hx']
      exact N.one_mem
    refine ⟨L, hN.comap _, ?_, ?_⟩
    · have hker : q.ker ≤ K := by simpa [q] using hZK
      exact (comap_mono hNK).trans (comap_map_eq_self hker).le
    · have hmap : L.map q = N := map_comap_eq_self_of_surjective hq N
      rw [← card_mul L hZL, hmap, hNcard, pow_succ]

/-- Adjoining an element of a small normal subgroup of exponent dividing `p`
preserves the condition `x ^ p = 1`. -/
private theorem mul_pow_eq_one_of_mem_small_normal [Finite G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) (H : Subgroup G) [H.Normal] (hsize : Nat.card H ≤ p ^ (p - 1))
    (hexp : ∀ y ∈ H, y ^ p = 1) {x y : G} (hx : x ^ p = 1) (hy : y ∈ H) :
    (x * y) ^ p = 1 := by
  have hp : p.Prime := Fact.out
  let S := H ⊔ zpowers x
  have hHS : H ≤ S := le_sup_left
  let H' := H.subgroupOf S
  have : H'.Normal := inferInstance
  let a : S := ⟨x, (show zpowers x ≤ S from le_sup_right) (mem_zpowers x)⟩
  let b : S := ⟨y, hHS hy⟩
  have hb : b ∈ H' := hy
  have hgen : H' ⊔ zpowers a = ⊤ := by
    rw [← Subgroup.map_subtype_inj, Subgroup.map_sup, map_subgroupOf_eq_of_le hHS,
      MonoidHom.map_zpowers, Subgroup.map_top, range_subtype]
    rfl
  have hcard : Nat.card H' = Nat.card H :=
    Nat.card_congr (subgroupOfEquivOfLe hHS).toEquiv
  have hw : weight S p = ⊥ :=
    lowerCentral_eq_bot_of_cyclic_sup (hG.to_subgroup S) H' a hgen
      (Nat.sub_pos_of_lt hp.one_lt) (hcard.symm ▸ hsize)
  let q := QuotientGroup.mk' H'
  have hqb : q b = 1 := (QuotientGroup.eq_one_iff b).mpr hb
  let f : ℕ → S := fun k => (a * b) ^ k * (a ^ k)⁻¹
  have hmem (k : ℕ) : f k ∈ H' := by
    apply (QuotientGroup.eq_one_iff (f k)).mp
    change q (f k) = 1
    simp [f, hqb]
  have hfun (c : S) : (fun T : Finset (Fin p) => c ^ T.card) ∈ faces S Finset.univ := by
    simpa only [Nat.choose_one_right] using binomial_face_mem p 1 (a := c) (mem_top c)
  have hf : (fun T : Finset (Fin p) => f T.card) ∈ faces S Finset.univ :=
    (faces S Finset.univ).mul_mem (hfun _) ((faces S Finset.univ).inv_mem (hfun _))
  have hpows (c : S) (hc : c ∈ H') : c ^ p = 1 := Subtype.ext (hexp c hc)
  have heq := symmetric_faces_at_prime hp hw H' hpows (f := f) (by simp [f]) hmem hf
  have hap : a ^ p = 1 := Subtype.ext hx
  have hab : (a * b) ^ p = 1 := by simpa [f, hap] using heq
  exact congrArg Subtype.val hab

/-- Join all the small normal subgroups of the specified order and exponent.
Automorphisms permute these subgroups, and adjoining each one preserves the exponent bound. -/
private theorem exists_characteristic_of_small_normal [Finite G] {p n : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) (hn : n < p) (H : Subgroup G) (hH : H.Normal)
    (hcard : Nat.card H = p ^ n) (hpow : ∀ x ∈ H, x ^ p = 1) :
    ∃ K : Subgroup G, K.Characteristic ∧ H ≤ K ∧ ∀ x ∈ K, x ^ p = 1 := by
  classical
  have hp : p.Prime := Fact.out
  let I := {A : Subgroup G // A.Normal ∧ Nat.card A = p ^ n ∧ ∀ x ∈ A, x ^ p = 1}
  let B (i : I) : Subgroup G := i.val
  let K := ⨆ i, B i
  refine ⟨K, ?_, le_iSup B (⟨H, hH, hcard, hpow⟩ : I), ?_⟩
  · apply characteristic_iff_map_le.mpr
    intro e
    change (⨆ i, B i).map e.toMonoidHom ≤ K
    rw [Subgroup.map_iSup]
    apply iSup_le
    intro i
    have hi : (B i).Normal := i.property.1
    have hnormal : ((B i).map e.toMonoidHom).Normal := hi.map _ e.surjective
    have hcard : Nat.card ((B i).map e.toMonoidHom) = p ^ n :=
      (card_map_of_injective e.injective).trans i.property.2.1
    have hpow : ∀ x ∈ (B i).map e.toMonoidHom, x ^ p = 1 := by
      rintro _ ⟨x, hx, rfl⟩
      rw [← map_pow, i.property.2.2 _ hx, map_one]
    exact le_iSup B (⟨_, hnormal, hcard, hpow⟩ : I)
  · have hfin (s : Finset I) : ∀ x ∈ s.sup B, x ^ p = 1 := by
      induction s using Finset.induction_on with
      | empty => simp
      | insert i s hi ih =>
        rw [Finset.sup_insert, sup_comm]
        have : (B i).Normal := i.property.1
        intro z hz
        obtain ⟨x, hx, y, hy, rfl⟩ := mem_sup_of_normal_right.mp hz
        apply mul_pow_eq_one_of_mem_small_normal hG (B i) _ i.property.2.2 (ih x hx) hy
        rw [i.property.2.1, Nat.pow_le_pow_iff_right hp.one_lt]
        omega
    intro x hx
    obtain ⟨s, hs⟩ := Set.mem_iUnion.mp ((coe_iSup_eq_iUnion_finset_coe_biSup B).le hx)
    exact hfin s x ((Finset.sup_eq_iSup s B).symm ▸ hs)

private theorem exists_normal_pow_subgroup [Finite G] {p n : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) (hn : n < p) (H : Subgroup G)
    (hcard : Nat.card H = p ^ n) (hpow : ∀ x ∈ H, x ^ p = 1) :
    ∃ N : Subgroup G, N.Normal ∧ Nat.card N = p ^ n ∧ ∀ x ∈ N, x ^ p = 1 := by
  induction hm : Nat.card G using Nat.strong_induction_on generalizing G with
  | ind m ih =>
    by_cases ht : H = ⊤
    · subst H
      exact ⟨⊤, inferInstance, hcard, hpow⟩
    obtain ⟨M, hM, hHM⟩ := (eq_top_or_exists_le_coatom H).resolve_left ht
    have : Group.IsNilpotent G := hG.isNilpotent
    have : M.Normal := Group.normalizerCondition_of_isNilpotent.normal_of_coatom M hM
    have hlt : Nat.card M < m := by
      rw [← hm, ← card_top (G := G)]
      exact card_lt_of_lt hM.lt_top
    have hcard' : Nat.card (H.subgroupOf M) = p ^ n :=
      (Nat.card_congr (subgroupOfEquivOfLe hHM).toEquiv).trans hcard
    have hpow' (x : M) (hx : x ∈ H.subgroupOf M) : x ^ p = 1 := Subtype.ext (hpow x hx)
    obtain ⟨A, hA, hAcard, hApow⟩ :=
      ih (Nat.card M) hlt (hG.to_subgroup M) (H.subgroupOf M) hcard' hpow' rfl
    obtain ⟨K, hK, hAK, hKpow⟩ :=
      exists_characteristic_of_small_normal (hG.to_subgroup M) hn A hA hAcard hApow
    let L := K.map M.subtype
    have : L.Normal := inferInstance
    have hdvd : p ^ n ∣ Nat.card L := by
      rw [card_map_of_injective M.subtype_injective, ← hAcard]
      exact card_dvd_of_le hAK
    obtain ⟨N, hN, hNL, hNcard⟩ := exists_normal_le_card_pow hG L n hdvd
    refine ⟨N, hN, hNcard, ?_⟩
    intro x hx
    obtain ⟨y, hy, rfl⟩ := hNL hx
    simpa only [map_pow, map_one] using congrArg M.subtype (hKpow y hy)

@[expose] public section

/-- **Berkovich's question on normal subgroups of exponent p, for p > n.** For every prime $p$
and every natural number $n < p$, if a finite $p$-group $G$ has a subgroup of order $p^n$ all of
whose elements $x$ satisfy $x^p = 1$, then $G$ has a normal subgroup of order $p^n$ all of whose
elements $x$ satisfy $x^p = 1$.

Berkovich asked this for $p$ sufficiently large relative to $n$; the explicit bound $p > n$ is the
one of the resolution. For $n \ge 1$ the condition $x^p = 1$ on a group of order $p^n$ says that it
has exponent exactly $p$. -/
def normalExponentPSubgroupOfLargePrime : Prop :=
  ∀ p n : ℕ, p.Prime → n < p → ∀ (G : Type) [Group G] [Finite G], IsPGroup p G →
    (∃ H : Subgroup G, Nat.card H = p ^ n ∧ ∀ x ∈ H, x ^ p = 1) →
      ∃ N : Subgroup G, N.Normal ∧ Nat.card N = p ^ n ∧ ∀ x ∈ N, x ^ p = 1

/--
**Normal subgroups of exponent p in p-groups when p > n.** For every prime $p$ and every natural
number $n < p$, if a finite $p$-group $G$ has a subgroup $H$ of order $p^n$ with $x^p = 1$ for all
$x \in H$, then $G$ has a normal subgroup $N$ of order $p^n$ with $x^p = 1$ for all $x \in N$.

The Kourovka Archive answers "Yes, it is true if $p > n$" (A. Mann): by induction a subgroup $H$
of exponent $p$ and order $p^n$ may be taken normal in a maximal subgroup $M$; then $H$ lies in
the $(p-1)$-st term $\zeta_{p-1}(M)$ of the upper central series of $M$, and the elements of
order $p$ of $\zeta_{p-1}(M)$ form a normal subgroup of $G$ containing $H$.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 15.24 (Ya. G.
Berkovich); resolution: A. Mann, letter of 1 October 2002, as recorded in the Kourovka Archive,
Problem 15.24, Archive answer: Yes if p > n (H of exponent p and order p^n normal in a maximal
subgroup M lies in ζ_{p-1}(M), whose elements of order p form a normal subgroup of G),
https://arxiv.org/abs/1401.0300v49.
-/
public theorem normalExponentPSubgroupOfLargePrime_holds :
    normalExponentPSubgroupOfLargePrime := by
  intro p n hp hn G _ _ hG h
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨H, hcard, hpow⟩ := h
  exact exists_normal_pow_subgroup hG hn H hcard hpow

end

