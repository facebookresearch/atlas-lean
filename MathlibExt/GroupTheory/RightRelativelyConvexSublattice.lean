module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Order.ConditionallyCompleteLattice.Basic
public import MathlibExt.GroupTheory.RightOrderable
import Mathlib.Order.Prod.Lex.Basic
import Mathlib.Tactic.Ring

/-!
# Right-relatively convex subgroups of the integer Heisenberg group

The subgroups on the two diagonals of the plane `y = 0` are convex in suitable right orders.
Their join omits a square root of one of its elements, giving a negative answer to
Kourovka Notebook Problem 21.147.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.RightRelativelyConvexSublatticeKourovka21Problem147Wanted

open MathlibExt.GroupTheory.ResiduallyTwoPrimesNotRightOrderableKourovka10Problem30Wanted
  (IsRightOrderable)

/-- **Right-invariant linear order.** A linear order $\le$ on a group $G$ is right-invariant (a
right order) when $a \le b$ implies $ac \le bc$ for all $a, b, c \in G$. -/
def IsRightInvariantOrder {G : Type} [Group G] (o : LinearOrder G) : Prop :=
  ∀ a b : G, o.le a b → ∀ c : G, o.le (a * c) (b * c)

/-- **Right-relatively convex subgroup.** A subgroup $H$ of a group $G$ is right-relatively convex
when there is a right-invariant linear order $\le$ on $G$ for which $H$ is convex: whenever
$h_1 \le g \le h_2$ with $h_1, h_2 \in H$ and $g \in G$, also $g \in H$. -/
def IsRightRelativelyConvex {G : Type} [Group G] (H : Subgroup G) : Prop :=
  ∃ o : LinearOrder G, IsRightInvariantOrder o ∧
    ∀ h₁ ∈ H, ∀ h₂ ∈ H, ∀ g : G, o.le h₁ g → o.le g h₂ → g ∈ H

/-- **Sublattice question for right-relatively convex subgroups (Kourovka Problem 21.147,
non-abelian case).** The statement that for every non-abelian right-orderable group $G$ and all
right-relatively convex subgroups $H$ and $K$ of $G$, both the intersection $H \cap K$ and the
join $H \vee K$ (the subgroup generated by $H$ and $K$) are right-relatively convex; that is, the
right-relatively convex subgroups of $G$ form a sublattice of the lattice of subgroups of $G$.

The question is restricted to non-abelian groups, as the proposers meant. -/
def rightRelativelyConvexSublattice : Prop :=
  ∀ (G : Type) [Group G], (∃ a b : G, a * b ≠ b * a) → IsRightOrderable G → ∀ H K : Subgroup G,
    IsRightRelativelyConvex H → IsRightRelativelyConvex K →
      IsRightRelativelyConvex (H ⊓ K) ∧ IsRightRelativelyConvex (H ⊔ K)

/-- Integer Heisenberg coordinates with the cross term `a.x * b.y`. -/
@[ext] private structure Heisenberg where
  x : ℤ
  y : ℤ
  z : ℤ

private def product (a b : Heisenberg) : Heisenberg :=
  ⟨a.x + b.x, a.y + b.y, a.z + b.z + a.x * b.y⟩

private instance heisenbergGroup : Group Heisenberg where
  mul := product
  one := ⟨0, 0, 0⟩
  inv a := ⟨-a.x, -a.y, -a.z + a.x * a.y⟩
  mul_assoc a b c := by
    change product (product a b) c = product a (product b c)
    apply Heisenberg.ext <;> dsimp only [product] <;> ring
  one_mul a := by
    change product ⟨0, 0, 0⟩ a = a
    apply Heisenberg.ext <;> simp [product]
  mul_one a := by
    change product a ⟨0, 0, 0⟩ = a
    apply Heisenberg.ext <;> simp [product]
  inv_mul_cancel a := by
    change product ⟨-a.x, -a.y, -a.z + a.x * a.y⟩ a = ⟨0, 0, 0⟩
    apply Heisenberg.ext <;> dsimp only [product] <;> ring

/-- The line of slope `s` in the abelian plane `y = 0`. -/
private def line (s : ℤ) : Subgroup Heisenberg where
  carrier := {a | a.y = 0 ∧ a.z = s * a.x}
  one_mem' := ⟨rfl, (mul_zero s).symm⟩
  mul_mem' {a b} ha hb := by
    obtain ⟨hay, haz⟩ := ha
    obtain ⟨hby, hbz⟩ := hb
    change a.y + b.y = 0 ∧ a.z + b.z + a.x * b.y = s * (a.x + b.x)
    simp [hay, haz, hby, hbz, mul_add]
  inv_mem' {a} ha := by
    obtain ⟨hay, haz⟩ := ha
    change -a.y = 0 ∧ -a.z + a.x * a.y = s * -a.x
    simp [hay, haz]

/-- Correcting the central coordinate by `x*y` makes its right-translation increment
constant on each plane of fixed `y`. -/
private def height (s : ℤ) (a : Heisenberg) : ℤ :=
  a.z - a.x * a.y - s * a.x

private theorem height_mul (s : ℤ) (a b : Heisenberg) :
    height s (a * b) = height s a + height s b - a.y * b.x := by
  change height s (product a b) = _
  dsimp only [height, product]
  ring

private def coordinates (s : ℤ) (a : Heisenberg) : ℤ ×ₗ ℤ ×ₗ ℤ :=
  toLex (a.y, toLex (height s a, a.x))

private abbrev lineOrder (s : ℤ) : LinearOrder Heisenberg :=
  LinearOrder.lift' (coordinates s) (by
    intro a b h
    have hy : a.y = b.y := congrArg (fun p => (ofLex p).1) h
    have hh : height s a = height s b := congrArg (fun p => (ofLex (ofLex p).2).1) h
    have hx : a.x = b.x := congrArg (fun p => (ofLex (ofLex p).2).2) h
    exact Heisenberg.ext hx hy (by simpa [height, hx, hy] using hh))

private theorem lineOrder_le (s : ℤ) (a b : Heisenberg) :
    (lineOrder s).le a b ↔ a.y < b.y ∨ a.y = b.y ∧
      (height s a < height s b ∨ height s a = height s b ∧ a.x ≤ b.x) := by
  change coordinates s a ≤ coordinates s b ↔ _
  simp only [coordinates, Prod.Lex.toLex_le_toLex]

private theorem lineOrder_invariant (s : ℤ) : IsRightInvariantOrder (lineOrder s) := by
  intro a b hab c
  rw [lineOrder_le] at hab ⊢
  change a.y + c.y < b.y + c.y ∨ a.y + c.y = b.y + c.y ∧
    (height s (a * c) < height s (b * c) ∨
      height s (a * c) = height s (b * c) ∧ a.x + c.x ≤ b.x + c.x)
  simp only [height_mul, add_lt_add_iff_right, add_left_inj, add_le_add_iff_right]
  rcases hab with h | ⟨hy, h⟩
  · exact Or.inl h
  · exact Or.inr ⟨hy, by simpa [hy] using h⟩

private theorem line_convex (s : ℤ) : IsRightRelativelyConvex (line s) := by
  refine ⟨lineOrder s, lineOrder_invariant s, ?_⟩
  intro a ha b hb g hag hgb
  obtain ⟨hay, haz⟩ := ha
  obtain ⟨hby, hbz⟩ := hb
  rw [lineOrder_le] at hag hgb
  simp only [height, hay, haz, hby, hbz, mul_zero, sub_zero, sub_self] at hag hgb
  have hgy : g.y = 0 := by omega
  exact ⟨hgy, by simp [hgy] at hag hgb; omega⟩

/-- Both diagonals lie in the subgroup of the plane where `x` and `z` have the same parity. -/
private def parityPlane : Subgroup Heisenberg where
  carrier := {a | a.y = 0 ∧ a.x % 2 = a.z % 2}
  one_mem' := ⟨rfl, rfl⟩
  mul_mem' {a b} ha hb := by
    obtain ⟨hay, ha⟩ := ha
    obtain ⟨hby, hb⟩ := hb
    change a.y + b.y = 0 ∧ (a.x + b.x) % 2 = (a.z + b.z + a.x * b.y) % 2
    simp only [hay, hby, mul_zero, add_zero, true_and]
    omega
  inv_mem' {a} ha := by
    obtain ⟨hay, ha⟩ := ha
    change -a.y = 0 ∧ (-a.x) % 2 = (-a.z + a.x * a.y) % 2
    simp only [hay, mul_zero, add_zero, neg_zero, true_and]
    omega

private theorem join_not_convex : ¬ IsRightRelativelyConvex (line 1 ⊔ line (-1)) := by
  let J := line 1 ⊔ line (-1)
  let e : Heisenberg := ⟨1, 0, 0⟩
  have hJ : J ≤ parityPlane := by
    apply sup_le
    · rintro a ⟨hy, hz⟩
      exact ⟨hy, by simp [hz]⟩
    · rintro a ⟨hy, hz⟩
      refine ⟨hy, ?_⟩
      simp only [hz, neg_one_mul]
      omega
  have he : e ∉ J := fun h => (by decide : (1 : ℤ) % 2 ≠ 0 % 2) (hJ h).2
  have hsq : e * e ∈ J := by
    have hp : (⟨1, 0, 1⟩ : Heisenberg) ∈ line 1 := ⟨rfl, rfl⟩
    have hm : (⟨1, 0, -1⟩ : Heisenberg) ∈ line (-1) := ⟨rfl, rfl⟩
    change (⟨1, 0, 1⟩ : Heisenberg) * ⟨1, 0, -1⟩ ∈ J
    exact Subgroup.mul_mem_sup hp hm
  rintro ⟨o, hi, hc⟩
  rcases o.le_total 1 e with h | h
  · exact he (hc 1 J.one_mem (e * e) hsq e h (by simpa using hi 1 e h e))
  · exact he (hc (e * e) hsq 1 J.one_mem e (by simpa using hi e 1 h e) h)

/--
**Negative answer to Kourovka Problem 21.147 for non-abelian groups.** It is not the case that for
every non-abelian right-orderable group $G$ and all right-relatively convex subgroups $H$ and $K$ of
$G$, both the intersection $H \cap K$ and the join $H \vee K$ (the subgroup generated by $H$ and
$K$) are right-relatively convex.

In the integer Heisenberg group, which is non-abelian, the cyclic subgroups
$\langle (1, 0, 1) \rangle$ and $\langle (1, 0, -1) \rangle$ are convex for suitable right orders,
but the subgroup $J$ they generate contains $2e$ and not $e = (1, 0, 0)$, and every right order
puts $e$ between $0$ and $2e$, so $J$ is convex for no right order (van Doorn, Judin, Monticone and
Morrison, Theorem 8.1; Monticone's note). The 21st issue of the Kourovka Notebook marks 21.147
solved ("No, not always"; AI solution confirmed by A. V. Zenkov).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in
Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 21.147 (V. M.
Kopytov, N. Ya. Medvedev; A. V. Zenkov); resolution: P. Monticone, Kourovka Notebook Problem 21.147,
solution note (14 May 2026), Kourovka Notebook site; W. van Doorn, E. Judin, P. Monticone and D.
Morrison, On some problems from the Kourovka Notebook, preprint, arXiv:2607.17477 (2026), van
Doorn-Judin-Monticone-Morrison, Theorem 8.1: in the integer Heisenberg group the subgroups ⟨(1, 0,
1)⟩ and ⟨(1, 0, -1)⟩ are right-relatively convex, while their join contains 2e but not e = (1, 0, 0)
and so is not convex for any right order; an AI solution (Aristotle) confirmed by A. V. Zenkov,
Kourovka Notebook (21st issue), Problem 21.147: No, not always, https://arxiv.org/abs/2607.17477.
-/
theorem rightRelativelyConvexSublattice_refuted : ¬ rightRelativelyConvexSublattice := by
  intro h
  have hnc : ∃ a b : Heisenberg, a * b ≠ b * a :=
    ⟨⟨1, 0, 0⟩, ⟨0, 1, 0⟩, fun heq => (by decide : (1 : ℤ) ≠ 0) (congrArg Heisenberg.z heq)⟩
  have ho : IsRightOrderable Heisenberg :=
    ⟨lineOrder 1, fun a b c hab => lineOrder_invariant 1 a b hab c⟩
  exact join_not_convex (h Heisenberg hnc ho _ _ (line_convex 1) (line_convex (-1))).2

end MathlibExt.GroupTheory.RightRelativelyConvexSublatticeKourovka21Problem147Wanted
