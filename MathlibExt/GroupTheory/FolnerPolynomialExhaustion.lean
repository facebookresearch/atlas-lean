/-!
# Følner exhaustions of polynomial size and polynomial growth (Kourovka Notebook Problem 14.27)

Kourovka Notebook, Archive of Solved Problems, Problem 14.27 (A. G. Vaillant): if `Γ = ⟨S⟩` (`S`
finite) has finite subsets `F₁ ⊊ F₂ ⊊ ⋯` with union `Γ`, `|∂Fₖ| / |Fₖ| → 0` and `|Fₖ| ≤ c kᵈ` (`c ≥
0`, `d ≥ 1`), where `∂F = {γ ∉ F | γ s ∈ F for some s ∈ S}`, does `Γ` have polynomial growth?

The lamplighter group refutes the implication from a polynomial-size Følner exhaustion to
polynomial word growth. At stage `k`, the cursor and all but one lit lamp lie within distance
`⌊log₂(k + 1)⌋` of the origin. The extra lamp may lie within distance `k + 1`, so each stage
adds a configuration even while the cursor window stays fixed. The outer boundary has one
cursor position for each allowed configuration.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 14.27 (A. G.
Vaillant). UnsolvedMath record UM-00701012 (`KOU-14.27`), dataset ulamai/UnsolvedMath v1.8.0.

The sequence is indexed from `0` (`F k` is `F_(k+1)`), so the size condition reads `|F k| ≤ c (k +
1)ᵈ`. Polynomial growth is stated for the given generating set `S` (balls of products of at most `n`
elements of `S ∪ S⁻¹`); the growth type does not depend on the finite generating set.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.FolnerPolynomialSequencePolynomialGrowthKourovka14Problem27Wanted

/-- **Ball in the word metric.** For a finite subset $S$ of a group $\Gamma$ and a natural number
$n$, the ball $B_S(n)$ of radius $n$ is the set of products of at most $n$ elements of
$S \cup S^{-1}$, the empty product $1$ included. -/
def wordBall {Γ : Type*} [Group Γ] (S : Finset Γ) (n : ℕ) : Set Γ :=
  {g | ∃ l : List Γ, l.length ≤ n ∧ (∀ x ∈ l, x ∈ S ∨ x⁻¹ ∈ S) ∧ l.prod = g}

/-- **Polynomial growth with respect to a finite subset.** Let $S$ be a finite subset of a group
$\Gamma$, and let $B_S(n)$ be the ball of radius $n$ for $S$, the set of products of at most $n$
elements of $S \cup S^{-1}$. Then $\Gamma$ has polynomial growth with respect to $S$ if there are
natural numbers $C$ and $d$ such that for every natural number $n$ the ball $B_S(n)$ has at most
$C\,(n + 1)^d$ elements. -/
def HasPolynomialGrowth {Γ : Type*} [Group Γ] (S : Finset Γ) : Prop :=
  ∃ C d : ℕ, ∀ n : ℕ, (wordBall S n).encard ≤ ((C * (n + 1) ^ d : ℕ) : ℕ∞)

/-- **Boundary of a finite subset of a group.** For a group $\Gamma$ and finite subsets $S$ and $F$
of $\Gamma$, the boundary of $F$ with respect to $S$ is the set
$\partial F = \{\gamma \in \Gamma \setminus F : \gamma s \in F \text{ for some } s \in S\}$. -/
def boundary {Γ : Type*} [Group Γ] (S F : Finset Γ) : Set Γ :=
  {γ | γ ∉ F ∧ ∃ s ∈ S, γ * s ∈ F}

/--
**Vaillant's question on Følner exhaustions of polynomial size (Kourovka 14.27).** The statement
that for every group $\Gamma$ generated by a finite subset $S$ the following holds: if there are
finite subsets $F_0 \subsetneq F_1 \subsetneq F_2 \subsetneq \cdots$ of $\Gamma$ whose union is
$\Gamma$ such that $|\partial F_k| / |F_k| \to 0$ as $k \to \infty$, where $\partial F_k$ is the
boundary of $F_k$ with respect to $S$, and such that for some real $c \ge 0$ and some natural
number $d \ge 1$ we have $|F_k| \le c\,(k + 1)^d$ for every $k$, then $\Gamma$ has polynomial
growth with respect to $S$.

The Kourovka Notebook indexes the sets from $F_1$, so its size condition $|F_k| \le c\,k^d$ reads
$|F_k| \le c\,(k + 1)^d$ here.
-/
def polynomialFolnerExhaustionImpliesPolynomialGrowth : Prop :=
  ∀ (Γ : Type) [Group Γ] (S : Finset Γ), Subgroup.closure (S : Set Γ) = ⊤ →
    ∀ F : ℕ → Finset Γ, (∀ k, F k ⊂ F (k + 1)) → (∀ γ, ∃ k, γ ∈ F k) →
      Filter.Tendsto (fun k => ((boundary S (F k)).ncard : ℝ) / (F k).card) Filter.atTop
        (nhds 0) →
      (∃ (c : ℝ) (d : ℕ), 0 ≤ c ∧ 1 ≤ d ∧ ∀ k, ((F k).card : ℝ) ≤ c * ((k : ℝ) + 1) ^ d) →
      HasPolynomialGrowth S

open scoped symmDiff
open Finset Filter

-- A state consists of the finite set of lit lamps and the cursor position.
private abbrev Lamp := Finset ℤ × ℤ

private def shift (p : ℤ) (a : Finset ℤ) : Finset ℤ := a.image (p + ·)

private lemma shift_add (p q : ℤ) (a : Finset ℤ) :
    shift p (shift q a) = shift (p + q) a := by
  simp only [shift, image_image, Function.comp_def, add_assoc]

private lemma shift_toggle (p : ℤ) (a b : Finset ℤ) :
    shift p (a ∆ b) = shift p a ∆ shift p b :=
  image_symmDiff a b (add_right_injective p)

private local instance lampGroup : Group Lamp where
  one := (∅, 0)
  mul a b := (a.1 ∆ shift a.2 b.1, a.2 + b.2)
  inv a := (shift (-a.2) a.1, -a.2)
  mul_assoc a b c := by
    apply Prod.ext
    · change (a.1 ∆ shift a.2 b.1) ∆ shift (a.2 + b.2) c.1 =
        a.1 ∆ shift a.2 (b.1 ∆ shift b.2 c.1)
      rw [shift_toggle, shift_add, symmDiff_assoc]
    · exact add_assoc ..
  one_mul a := by
    change (∅ ∆ shift 0 a.1, 0 + a.2) = a
    simp [shift, ← Finset.bot_eq_empty]
  mul_one a := by
    change (a.1 ∆ shift a.2 ∅, a.2 + 0) = a
    rw [shift, image_empty, ← Finset.bot_eq_empty, symmDiff_bot, add_zero]
  inv_mul_cancel a := by
    change (shift (-a.2) a.1 ∆ shift (-a.2) a.1, -a.2 + a.2) = (∅, 0)
    simp

private def walk (p : ℤ) : Lamp := (∅, p)
private def toggle : Lamp := ({0}, 0)
private def generators : Finset Lamp := {walk 1, toggle}

private lemma mul_walk (a : Lamp) (p : ℤ) : a * walk p = (a.1, a.2 + p) := by
  change (a.1 ∆ shift a.2 ∅, a.2 + p) = _
  rw [shift, image_empty, ← Finset.bot_eq_empty, symmDiff_bot]

private lemma mul_toggle (a : Lamp) : a * toggle = (a.1 ∆ {a.2}, a.2) := by
  change (a.1 ∆ shift a.2 {0}, a.2 + 0) = _
  simp [shift]

private lemma switch_fresh {a : Finset ℤ} {p : ℤ} (hp : p ∉ a) :
    a ∆ {p} = insert p a := by
  ext x
  simp only [mem_symmDiff, mem_singleton, mem_insert]
  grind

private lemma generates : Subgroup.closure (generators : Set Lamp) = ⊤ := by
  let H := Subgroup.closure (generators : Set Lamp)
  have hw : walk 1 ∈ H := Subgroup.subset_closure (by simp [generators])
  have ht : toggle ∈ H := Subgroup.subset_closure (by simp [generators])
  have hw' (p : ℤ) : walk p ∈ H := by
    let f : Multiplicative ℤ →* Lamp :=
      { toFun := fun i => walk i.toAdd
        map_one' := rfl
        map_mul' := fun a b => (mul_walk (walk a.toAdd) b.toAdd).symm }
    have h : (f (Multiplicative.ofAdd 1)) ^ p ∈ H := H.zpow_mem hw p
    rw [← map_zpow] at h
    change walk ((Multiplicative.ofAdd (1 : ℤ) ^ p).toAdd) ∈ H at h
    simpa [toAdd_zpow] using h
  have lamps (a : Finset ℤ) : ((a, 0) : Lamp) ∈ H := by
    induction a using Finset.induction_on with
    | empty => exact H.one_mem
    | @insert p a hp ih =>
      have h := H.mul_mem (H.mul_mem (H.mul_mem ih (hw' p)) ht) (hw' (-p))
      simpa [mul_walk, mul_toggle, switch_fresh hp] using h
  apply top_unique
  rintro ⟨a, p⟩ _
  simpa [mul_walk] using H.mul_mem (lamps a) (hw' p)

-- One sweep of the cursor can write any binary pattern on the sites it visits.
private lemma append_step {a s : Lamp} {n : ℕ} (ha : a ∈ wordBall generators n)
    (hs : s ∈ generators) : a * s ∈ wordBall generators (n + 1) := by
  obtain ⟨l, hl, hmem, rfl⟩ := ha
  refine ⟨l ++ [s], by simpa, ?_, by simp⟩
  intro x hx
  rcases List.mem_append.mp hx with hx | hx
  · exact hmem x hx
  · exact Or.inl ((List.mem_singleton.mp hx) ▸ hs)

private lemma sweep (n : ℕ) (a : Finset ℤ) (ha : a ⊆ Ico 0 (n : ℤ)) :
    ((a, (n : ℤ)) : Lamp) ∈ wordBall generators (2 * n) := by
  induction n generalizing a with
  | zero =>
    have : a = ∅ := by simpa using ha
    subst a
    exact ⟨[], by simp, by simp, rfl⟩
  | succ n ih =>
    have hsub : a.erase (n : ℤ) ⊆ Ico 0 (n : ℤ) := by
      intro x hx
      obtain ⟨hne, hx⟩ := mem_erase.mp hx
      have := mem_Ico.mp (ha hx)
      exact mem_Ico.mpr (by omega)
    have h := ih _ hsub
    have ready : ((a, (n : ℤ)) : Lamp) ∈ wordBall generators (2 * n + 1) := by
      by_cases hn : (n : ℤ) ∈ a
      · have h' := append_step h (show toggle ∈ generators by simp [generators])
        simpa [mul_toggle, switch_fresh (notMem_erase _ _), insert_erase hn] using h'
      · rw [erase_eq_of_notMem hn] at h
        obtain ⟨l, hl, hm, hp⟩ := h
        exact ⟨l, by omega, hm, hp⟩
    simpa [mul_walk, Nat.mul_succ] using
      append_step ready (show walk 1 ∈ generators by simp [generators])

private lemma exponential (n : ℕ) :
    ((2 ^ n : ℕ) : ℕ∞) ≤ (wordBall generators (2 * n)).encard := by
  let states : Finset Lamp := (Ico (0 : ℤ) n).powerset ×ˢ {(n : ℤ)}
  have sub : (states : Set Lamp) ⊆ wordBall generators (2 * n) := by
    rintro ⟨a, p⟩ hp
    change (a, p) ∈ (Ico (0 : ℤ) n).powerset ×ˢ {(n : ℤ)} at hp
    obtain ⟨ha, rfl⟩ := (mem_product.mp hp).imp mem_powerset.mp mem_singleton.mp
    exact sweep n a ha
  rw [← show states.card = 2 ^ n by simp [states, Int.card_Ico]]
  simpa only [Set.encard_coe_eq_coe_finsetCard] using Set.encard_le_encard sub

private lemma no_polynomial_growth : ¬ HasPolynomialGrowth generators := by
  rintro ⟨C, d, h⟩
  have bound (n : ℕ) : 2 ^ n ≤ C * (2 * n + 1) ^ d := by
    exact_mod_cast (exponential n).trans (h (2 * n))
  have lim := (tendsto_pow_const_div_const_pow_of_one_lt d (show (1 : ℝ) < 2 by norm_num)).const_mul
    ((C : ℝ) * 3 ^ d)
  have small := (lim.eventually_lt_const (by simp : (C : ℝ) * 3 ^ d * 0 < 1)).and
    (eventually_ge_atTop 1)
  obtain ⟨n, hn, hn1⟩ := small.exists
  have hle : 2 * n + 1 ≤ 3 * n := by omega
  have hb := (bound n).trans (Nat.mul_le_mul_left C (Nat.pow_le_pow_left hle d))
  rw [mul_pow] at hb
  have hb' : (2 : ℝ) ^ n ≤ C * (3 ^ d * (n : ℝ) ^ d) := by exact_mod_cast hb
  change (C : ℝ) * 3 ^ d * ((n : ℝ) ^ d / 2 ^ n) < 1 at hn
  rw [← mul_div_assoc, div_lt_one (by positivity)] at hn
  linarith [mul_assoc (C : ℝ) (3 ^ d) ((n : ℝ) ^ d)]

private def window (n : ℕ) : Finset ℤ := Icc (-(n : ℤ)) n

private lemma zero_mem_window (n : ℕ) : 0 ∈ window n :=
  mem_Icc.mpr ⟨by omega, by omega⟩

private lemma window_card (n : ℕ) : (window n).card = 2 * n + 1 := by
  rw [window, Int.card_Icc]
  omega

private lemma window_mono : Monotone window := by
  intro n m h x hx
  exact mem_Icc.mpr (by have := mem_Icc.mp hx; omega)

private def radius (k : ℕ) := Nat.log 2 (k + 1)

private lemma radius_le (k : ℕ) : radius k ≤ k + 1 := Nat.log_le_self ..

private lemma radius_mono : Monotone radius := fun _ _ h => Nat.log_mono_right (by omega)

-- All lamps in the cursor window are free. One more lit lamp may be anywhere
-- in the larger window. Its new endpoint witnesses strict inclusion at every step.
private def configs (k : ℕ) : Finset (Finset ℤ) :=
  (window (k + 1)).biUnion fun z => (insert z (window (radius k))).powerset

private lemma mem_configs {a : Finset ℤ} {k : ℕ} :
    a ∈ configs k ↔ ∃ z ∈ window (k + 1), a ⊆ insert z (window (radius k)) := by
  simp only [configs, mem_biUnion, mem_powerset]

private def box (k : ℕ) : Finset Lamp := configs k ×ˢ window (radius k)

private lemma mem_box {a : Finset ℤ} {p : ℤ} {k : ℕ} :
    (a, p) ∈ box k ↔ a ∈ configs k ∧ p ∈ window (radius k) := mem_product

private lemma box_strict (k : ℕ) : box k ⊂ box (k + 1) := by
  apply (ssubset_iff_of_subset ?_).mpr
  · let z : ℤ := k + 2
    refine ⟨({z}, 0), mem_box.mpr ⟨mem_configs.mpr ⟨z, ?_, by simp⟩, ?_⟩, ?_⟩
    · simp only [window, mem_Icc, Nat.cast_add_one, z]
      omega
    · simp [window]
    · intro h
      obtain ⟨y, hy, hsub⟩ := mem_configs.mp (mem_box.mp h).1
      have hzy := singleton_subset_iff.mp hsub
      simp only [mem_insert, window, mem_Icc] at hzy hy
      dsimp [z] at hzy
      have := radius_le k
      omega
  · rintro ⟨a, p⟩ hp
    obtain ⟨ha, hp⟩ := mem_box.mp hp
    obtain ⟨z, hz, ha⟩ := mem_configs.mp ha
    have sub := window_mono (radius_mono (Nat.le_succ k))
    exact mem_box.mpr ⟨mem_configs.mpr ⟨z, window_mono (Nat.le_succ _) hz,
      ha.trans (insert_subset_insert z sub)⟩, sub hp⟩

private lemma box_exhausts (g : Lamp) : ∃ k, g ∈ box k := by
  obtain ⟨a, p⟩ := g
  let m := max (a.sup Int.natAbs) p.natAbs
  let k := 2 ^ m
  have hr : m ≤ radius k := Nat.le_log_of_pow_le (by decide) (Nat.le_succ k)
  have inside (x : ℤ) (hx : x.natAbs ≤ m) : x ∈ window (radius k) := by
    apply mem_Icc.mpr
    omega
  refine ⟨k, mem_box.mpr ⟨mem_configs.mpr ⟨0, zero_mem_window _, ?_⟩,
    inside p (le_max_right ..)⟩⟩
  exact fun x hx => mem_insert_of_mem (inside x ((le_sup hx).trans (le_max_left ..)))

private lemma switch_mem {k : ℕ} {p : ℤ} {a : Finset ℤ} (hp : p ∈ window (radius k))
    (ha : a ∈ configs k) : a ∆ {p} ∈ configs k := by
  obtain ⟨z, hz, hsub⟩ := mem_configs.mp ha
  exact mem_configs.mpr ⟨z, hz, symmDiff_subset_union.trans
    (union_subset hsub (singleton_subset_iff.mpr (mem_insert_of_mem hp)))⟩

-- Right multiplication by the toggle preserves each cursor slice. A right step
-- can enter the box from outside only at the position just left of the window.
private lemma boundary_box (k : ℕ) :
    boundary generators (box k) = ↑(configs k ×ˢ {-(radius k : ℤ) - 1}) := by
  ext ⟨a, p⟩
  change (_ ∧ ∃ s ∈ generators, ((a, p) : Lamp) * s ∈ box k) ↔
    (a, p) ∈ configs k ×ˢ {-(radius k : ℤ) - 1}
  simp only [mem_product, mem_singleton]
  constructor
  · rintro ⟨hout, s, hs, hin⟩
    simp only [generators, mem_insert, mem_singleton] at hs
    rcases hs with rfl | rfl
    · rw [mul_walk] at hin
      obtain ⟨ha, hp⟩ := mem_box.mp hin
      have hn : p ∉ window (radius k) := fun h => hout (mem_box.mpr ⟨ha, h⟩)
      simp only [window, mem_Icc] at hp hn
      exact ⟨ha, by omega⟩
    · rw [mul_toggle] at hin
      obtain ⟨ha, hp⟩ := mem_box.mp hin
      have := switch_mem hp ha
      exact (hout (mem_box.mpr ⟨by simpa using this, hp⟩)).elim
  · rintro ⟨ha, rfl⟩
    refine ⟨fun h => ?_, walk 1, by simp [generators], ?_⟩
    · have hp := (mem_box.mp h).2
      simp [window] at hp
    · rw [mul_walk]
      exact mem_box.mpr ⟨ha, by simp [window]⟩

private lemma boundary_ratio (k : ℕ) :
    ((boundary generators (box k)).ncard : ℝ) / (box k).card =
      ((2 * radius k + 1 : ℕ) : ℝ)⁻¹ := by
  have hpos : 0 < (configs k).card := card_pos.mpr
    ⟨∅, mem_configs.mpr ⟨0, zero_mem_window _, empty_subset _⟩⟩
  rw [boundary_box, Set.ncard_coe_finset, box, card_product, card_product, card_singleton,
    mul_one, window_card, Nat.cast_mul]
  field_simp

private lemma box_folner : Tendsto
    (fun k => ((boundary generators (box k)).ncard : ℝ) / (box k).card) atTop (nhds 0) := by
  simp_rw [boundary_ratio]
  apply Filter.Tendsto.inv_tendsto_atTop
  apply tendsto_natCast_atTop_atTop.comp
  refine tendsto_atTop_atTop.mpr fun m => ⟨2 ^ m, fun k hk => ?_⟩
  have : m ≤ radius k := Nat.le_log_of_pow_le (by decide) (by omega)
  omega

private lemma box_size (k : ℕ) : (box k).card ≤ 36 * (k + 1) ^ 4 := by
  have configs_bound : (configs k).card ≤ (window (k + 1)).card * 2 ^ (2 * radius k + 2) := by
    apply card_biUnion_le_card_mul
    intro z hz
    rw [card_powerset]
    apply Nat.pow_le_pow_right (by decide)
    simpa [window_card, Nat.add_assoc] using card_insert_le z (window (radius k))
  have pow_bound : 2 ^ (2 * radius k + 2) ≤ 4 * (k + 1) ^ 2 := by
    rw [pow_add, mul_comm 2 (radius k), pow_mul]
    have h := Nat.pow_log_le_self 2 (Nat.succ_ne_zero k)
    change 2 ^ radius k ≤ k + 1 at h
    nlinarith [Nat.pow_le_pow_left h 2]
  have hrad := radius_le k
  rw [box, card_product, window_card]
  rw [window_card] at configs_bound
  calc
    _ ≤ ((3 * (k + 1)) * (4 * (k + 1) ^ 2)) * (3 * (k + 1)) := by
      apply Nat.mul_le_mul _ (by omega)
      exact configs_bound.trans (Nat.mul_le_mul (by omega) pow_bound)
    _ = _ := by ring

/--
**Følner exhaustions of polynomial size need not give polynomial growth.** There exist a group
$\Gamma$ generated by a finite subset $S$ and finite subsets
$F_0 \subsetneq F_1 \subsetneq F_2 \subsetneq \cdots$ of $\Gamma$ whose union is $\Gamma$ such that
$|\partial F_k| / |F_k| \to 0$ as $k \to \infty$, where $\partial F_k$ is the boundary of $F_k$
with respect to $S$, and such that for some real $c \ge 0$ and some natural number $d \ge 1$ we
have $|F_k| \le c\,(k + 1)^d$ for every $k$, while $\Gamma$ does not have polynomial growth with
respect to $S$. That is, the answer to Kourovka Problem 14.27 is negative.

By Bardakov, every finitely generated group of intermediate growth (such groups exist by
Grigorchuk) has such a sequence of subsets.

Source: E. I. Khukhro and V. D. Mazurov (eds.),
Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026),
Archive of Solved Problems, Problem 14.27 (A. G. Vaillant); resolution: V. G. Bardakov, Algebra and
Logic 40 (2001), no. 1, 12-16, Kourovka Archive, Problem 14.27: every group of intermediate growth
has such a sequence (answer: No, not always).
-/
theorem polynomialFolnerExhaustionImpliesPolynomialGrowth_refuted :
    ¬ polynomialFolnerExhaustionImpliesPolynomialGrowth := by
  intro h
  apply no_polynomial_growth
  apply h Lamp generators generates box box_strict box_exhausts box_folner
  exact ⟨36, 4, by norm_num, by decide, fun k => by exact_mod_cast box_size k⟩

end MathlibExt.GroupTheory.FolnerPolynomialSequencePolynomialGrowthKourovka14Problem27Wanted
