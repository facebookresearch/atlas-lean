module

public import MathlibExt.GroupTheory.SigmaSubnormal
import Mathlib.GroupTheory.IndexNormal
import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
import Mathlib.Tactic.FinCases

/-!
# A counterexample to Skiba's σ-subnormality question

Tyutyanov's transposition subgroup of the symmetric group on five letters refutes
`sigmaSubnormalFromJoinsWithConjugates` from Kourovka Notebook Problem 19.84.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.SigmaSubnormalJoinConjugateKourovka19Problem84Wanted

open MathlibExt.GroupTheory.KourovkaNotebookShared

/-- **Skiba's $\sigma$-subnormality question (Kourovka 19.84).** The statement that for every
partition $\sigma$ of the set of primes, every finite group $G$ and every subgroup $A$ of $G$, if
$A$ is $\sigma$-subnormal in the subgroup $\langle A, A^x \rangle$ generated by $A$ and
$A^x = xAx^{-1}$ for every $x \in G$, then $A$ is $\sigma$-subnormal in $G$. -/
def sigmaSubnormalFromJoinsWithConjugates : Prop :=
  ∀ (I : Type) (σ : I → Set ℕ), IsPrimePartition σ → ∀ (G : Type) [Group G] [Finite G]
    (A : Subgroup G),
    (∀ x : G, IsSigmaSubnormal σ (A.subgroupOf (A ⊔ A.map (MulAut.conj x).toMonoidHom))) →
    IsSigmaSubnormal σ A

open Equiv Subgroup

private abbrev SymFive := Perm (Fin 5)
private abbrev transposition : SymFive := swap 0 1
private abbrev A := zpowers transposition

-- The remaining primes do not divide the order of S₅ and form a third block.
private def block : Fin 3 → Set ℕ
  | 0 => {2, 3}
  | 1 => {5}
  | 2 => {p | p.Prime ∧ p ≠ 2 ∧ p ≠ 3 ∧ p ≠ 5}

private theorem partition : IsPrimePartition block := by
  refine ⟨?_, ?_, ?_⟩
  · intro i
    fin_cases i
    · exact ⟨⟨2, Or.inl rfl⟩, by rintro p (rfl | (rfl : p = 3)) <;> decide⟩
    · exact ⟨⟨5, rfl⟩, by rintro p (rfl : p = 5); decide⟩
    · exact ⟨⟨7, by decide, by decide, by decide, by decide⟩, fun _ hp => hp.1⟩
  · intro i j hij
    rw [Set.disjoint_left]
    fin_cases i <;> fin_cases j <;> simp_all [block]
  · intro p hp
    by_cases h : p = 2 ∨ p = 3
    · exact ⟨0, h⟩
    by_cases h' : p = 5
    · exact ⟨1, h'⟩
    exact ⟨2, hp, fun e => h (.inl e), fun e => h (.inr e), h'⟩

private theorem card_symFive : Nat.card SymFive = 120 := by
  rw [Nat.card_perm, Nat.card_fin]
  decide

private theorem isSwap_transposition : transposition.IsSwap :=
  Perm.swap_isSwap_iff.mpr (by decide)

-- A pair of transpositions fixes a common letter, so its join lies in a copy of S₄.
private theorem join_card_dvd (x : SymFive) :
    Nat.card ↥(A ⊔ A.map (MulAut.conj x).toMonoidHom) ∣ 24 := by
  have spare : ∀ a b : Fin 5, ∃ c : Fin 5, c ≠ 0 ∧ c ≠ 1 ∧ c ≠ a ∧ c ≠ b := by decide
  obtain ⟨c, hc₀, hc₁, hca, hcb⟩ := spare (x 0) (x 1)
  let H := MulAction.stabilizer SymFive c
  have hle : A ⊔ A.map (MulAut.conj x).toMonoidHom ≤ H := by
    apply sup_le
    · exact zpowers_le.mpr (swap_apply_of_ne_of_ne hc₀ hc₁)
    · rw [MonoidHom.map_zpowers, zpowers_le]
      change (x * swap 0 1 * x⁻¹ : Perm (Fin 5)) c = c
      rw [← swap_apply_apply]
      exact swap_apply_of_ne_of_ne hca hcb
  have hcard := H.index_mul_card
  rw [MulAction.index_stabilizer_of_transitive, Nat.card_fin, card_symFive] at hcard
  exact (card_dvd_of_le hle).trans (dvd_of_eq (by omega))

private theorem subnormal_in_join (x : SymFive) :
    IsSigmaSubnormal block (A.subgroupOf (A ⊔ A.map (MulAut.conj x).toMonoidHom)) := by
  let J := A ⊔ A.map (MulAut.conj x).toMonoidHom
  let B := A.subgroupOf J
  refine ⟨1, fun i => if i = 0 then B else ⊤, rfl, rfl, ?_⟩
  intro i hi
  obtain rfl : i = 0 := by omega
  refine ⟨le_top, Or.inr ⟨0, fun p hp hdiv => ?_⟩⟩
  have hcard := (B.subgroupOf ⊤).normalCore.index_dvd_card
  rw [card_top] at hcard
  have hd : p ∣ 2 * 2 * 2 * 3 := hdiv.trans (hcard.trans (join_card_dvd x))
  simp only [hp.dvd_mul, Nat.prime_dvd_prime_iff_eq hp Nat.prime_two,
    Nat.prime_dvd_prime_iff_eq hp Nat.prime_three, or_self] at hd
  exact hd

-- A proper overgroup of the transposition cannot contain A₅, hence has trivial core.
private theorem core_eq_bot {H : Subgroup SymFive} (ht : transposition ∈ H) (hH : H ≠ ⊤) :
    H.normalCore = ⊥ := by
  by_contra h
  have hle : alternatingGroup (Fin 5) ≤ H :=
    (Perm.alternatingGroup_le_of_normal (by simp) (H.normalCore.nontrivial_iff_ne_bot.mpr h)).trans
      H.normalCore_le
  have hmax : IsCoatom (alternatingGroup (Fin 5)) :=
    isCoatom_of_index_prime (by rw [alternatingGroup.index_eq_two]; decide)
  apply hH
  apply hmax.2 _ (lt_of_le_of_ne hle ?_)
  rintro rfl
  simp [Perm.mem_alternatingGroup, isSwap_transposition.sign_eq] at ht

private theorem no_step_to_top {H : Subgroup SymFive} (ht : transposition ∈ H) (hH : H ≠ ⊤) :
    ¬ ((H.subgroupOf ⊤).Normal ∨ IsSigmaPrimary block (H.subgroupOf ⊤).normalCore.index) := by
  have hc := core_eq_bot ht hH
  have hc' : (H.subgroupOf ⊤).normalCore = H.normalCore.subgroupOf ⊤ := by
    ext x
    exact ⟨fun h g => h ⟨g, trivial⟩, fun h g => h g.val⟩
  rintro (hn | ⟨i, hi⟩)
  · have hnormal : H.Normal :=
      (normal_comap_iff_of_surjective (f := (topEquiv (G := SymFive)).toMonoidHom)
        topEquiv.surjective).mp hn
    rw [normalCore_eq_self] at hc
    rw [hc, mem_bot] at ht
    exact (by decide : (0 : Fin 5) ≠ 1) (swap_eq_one_iff.mp ht)
  · rw [hc', hc, bot_subgroupOf, index_bot, card_top, card_symFive] at hi
    have h₂ := hi 2 Nat.prime_two (by decide)
    have h₅ := hi 5 (by decide) (by decide)
    fin_cases i <;> simp_all [block]

/--
**A counterexample to Skiba's $\sigma$-subnormality question.** The statement of Kourovka
Problem 19.84 is false: there are a partition $\sigma$ of the set of primes, a finite group $G$
and a subgroup $A$ of $G$ such that $A$ is $\sigma$-subnormal in the subgroup
$\langle A, A^x \rangle$ generated by $A$ and $A^x = xAx^{-1}$ for every $x \in G$, but $A$ is
not $\sigma$-subnormal in $G$.

Tyutyanov's example is $G = S_5$, a partition with blocks $\{2, 3\}$ and $\{5\}$, and
$A = \langle (1\,2) \rangle$. Wielandt's theorem gives the affirmative answer for the partition
into single primes.

Source: E. I.
Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook, 21st
issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.84 (A. N. Skiba);
resolution: V. N. Tyutyanov, letter of 28 August 2019, Kourovka Archive, Problem 19.84: No, not
always; in G = S₅ with σ = {2, 3} ∪ {5} the subgroup A = ⟨(12)⟩ is σ-subnormal in ⟨A, A^x⟩ for every
x but not σ-subnormal in G, https://arxiv.org/abs/1401.0300v49.
-/
theorem sigmaSubnormalFromJoinsWithConjugates_refuted :
    ¬ sigmaSubnormalFromJoinsWithConjugates := by
  intro h
  obtain ⟨n, K, h₀, hn, hstep⟩ := h _ block partition SymFive A subnormal_in_join
  have hproper (i : ℕ) (hi : i ≤ n) : transposition ∈ K i ∧ K i ≠ ⊤ := by
    induction i with
    | zero =>
      rw [h₀]
      refine ⟨mem_zpowers _, fun htop => ?_⟩
      have hcard := congrArg (fun H : Subgroup SymFive => Nat.card H) htop
      rw [Nat.card_zpowers, isSwap_transposition.orderOf, card_top, card_symFive] at hcard
      contradiction
    | succ i ih =>
      obtain ⟨ht, hH⟩ := ih (by omega)
      obtain ⟨hle, hs⟩ := hstep i (by omega)
      refine ⟨hle ht, fun htop => ?_⟩
      rw [htop] at hs
      exact no_step_to_top ht hH hs
  exact (hproper n le_rfl).2 hn

end MathlibExt.GroupTheory.SigmaSubnormalJoinConjugateKourovka19Problem84Wanted
