/-!
# Transitive automorphism groups of an elementary abelian 2-group (Kourovka Notebook Problem 18.60)

Kourovka Notebook, Problem 18.60 (D. V. Lytkina), marked solved in the 21st issue: let `V` be an
infinite countable elementary abelian additive 2-group. Does `Aut V` contain a subgroup `G` such
that (a) `G` is transitive on the non-zero elements of `V`, and (b) if `H` is the stabilizer in `G`
of a non-zero `v ∈ V`, then `V = ⟨v⟩ ⊕ V_v` with `V_v` `H`-invariant, `H` is isomorphic to the
multiplicative group `P*` of a locally finite field `P` of characteristic `2`, and the action of `H`
on `V_v` is similar to the action of `P*` on `P` by multiplication? Conjecture: such a group `G`
does not exist.

The main result is `noTransitiveFieldLikeAutomorphismGroup_holds`: the conjecture of
Kourovka Problem 18.60 holds, proved by the linear obstruction of Muliarchyk's Theorem 1.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 18.60 (D. V. Lytkina). UnsolvedMath record
UM-00701489 (`KOU-18.60`), dataset ulamai/UnsolvedMath v1.8.0.

The target is the conjecture (non-existence), quantified over every countably infinite `V` with `v +
v = 0`. `Aut V` is represented by subgroups of `Sym(V)` consisting of additive bijections.
Similarity of the actions is an isomorphism `ψ : H ≃ P*` and a bijection `θ : V_v → P` with `θ(h w)
= ψ(h) θ(w)` (any bijection, not necessarily additive: the weaker hypothesis, so the non-existence
claim is the stronger one). Such a `θ` maps the common fixed point `0` of `H` to `0` (as `P` is
infinite), so `H` is transitive on `V_v ∖ {0}`, which is what the resolving preprint uses.
-/

@[expose] public section

open scoped CharTwo

namespace MathlibExt.GroupTheory.ElementaryAbelianTransitiveFieldActionKourovka18Problem60Wanted

variable {V : Type} [AddCommGroup V]

/-- **Locally finite field (Kourovka 18.60).** A field $P$ is locally finite when the subfield
generated by any finite subset of $P$ is finite. -/
def IsLocallyFiniteField (P : Type) [Field P] : Prop :=
  ∀ s : Finset P, Finite (Subfield.closure (s : Set P))

/-- **Kourovka Problem 18.60 (field-like transitive automorphism groups).** The conjecture of
D. V. Lytkina, as a proposition: for every countably infinite elementary abelian $2$-group $V$
(an abelian group with $v + v = 0$ for all $v \in V$) there is no subgroup $G$ of the symmetric
group $\mathrm{Sym}(V)$ consisting of additive bijections such that (a) $G$ is transitive on
$V \setminus \{0\}$, and (b) for every nonzero $v \in V$, writing $H = G_v$ for the stabilizer of
$v$ in $G$, there are a subgroup $V_v$ of $V$ with $V = \langle v \rangle \oplus V_v$ that every
element of $H$ maps into itself, a locally finite field $P$ of characteristic $2$, a group
isomorphism $\psi : H \to P^\times$ onto the multiplicative group of $P$, and a bijection
$\theta : V_v \to P$ such that $\theta(h w) = \psi(h)\,\theta(w)$ for all $h \in H$ and
$w \in V_v$. -/
def noTransitiveFieldLikeAutomorphismGroup : Prop :=
  ∀ (V : Type) [AddCommGroup V], Countable V → Infinite V → (∀ v : V, v + v = 0) →
    ¬ ∃ G : Subgroup (Equiv.Perm V), (∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b) ∧
      (∀ u w : V, u ≠ 0 → w ≠ 0 → ∃ g ∈ G, g u = w) ∧
      ∀ v : V, v ≠ 0 → ∃ (W : AddSubgroup V) (P : Type) (_ : Field P),
        CharP P 2 ∧ IsLocallyFiniteField P ∧ IsCompl (AddSubgroup.zmultiples v) W ∧
        (∀ g ∈ G, g v = v → ∀ w ∈ W, g w ∈ W) ∧
        ∃ (ψ : ↥(G ⊓ MulAction.stabilizer (Equiv.Perm V) v) ≃* Pˣ) (θ : V → P),
          Set.BijOn θ (W : Set V) Set.univ ∧
          ∀ h : ↥(G ⊓ MulAction.stabilizer (Equiv.Perm V) v), ∀ w ∈ W,
            θ ((h : Equiv.Perm V) w) = (ψ h : P) * θ w




private lemma perm_apply_zero_of_additive (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    {g : Equiv.Perm V} (hg : g ∈ G) : g 0 = 0 := by
  have h := hadd g hg 0 0
  rw [add_zero] at h
  have h' : g 0 + 0 = g 0 + g 0 := by rw [add_zero]; exact h
  exact (add_left_cancel_iff.mp h').symm

private lemma mem_zmultiples_eq_zero_or_self (h2 : ∀ v : V, v + v = 0) {v x : V}
    (hx : x ∈ AddSubgroup.zmultiples v) : x = 0 ∨ x = v := by
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
  have hk2 : k / 2 * 2 + k % 2 = k := by omega
  have htwo : (2 : ℤ) • v = 0 := by rw [two_zsmul]; exact h2 v
  rw [← hk, ← hk2, add_zsmul, mul_zsmul, htwo, smul_zero, zero_add]
  rcases Int.emod_two_eq_zero_or_one k with h | h <;> simp [h]

private lemma exists_add_mem_of_isCompl {v : V} {W : AddSubgroup V}
    (hC : IsCompl (AddSubgroup.zmultiples v) W) (x : V) :
    ∃ c ∈ AddSubgroup.zmultiples v, ∃ w ∈ W, c + w = x := by
  have htop : AddSubgroup.zmultiples v ⊔ W = ⊤ := Codisjoint.eq_top hC.codisjoint
  have hx : x ∈ AddSubgroup.zmultiples v ⊔ W := htop.symm ▸ AddSubgroup.mem_top x
  exact AddSubgroup.mem_sup.mp hx

private lemma self_mem_zmultiples {v : V} : v ∈ AddSubgroup.zmultiples v :=
  AddSubgroup.mem_zmultiples_iff.mpr ⟨1, one_zsmul v⟩

private lemma not_mem_of_isCompl {v : V} (hv : v ≠ 0) {W : AddSubgroup V}
    (hC : IsCompl (AddSubgroup.zmultiples v) W) : v ∉ W :=
  fun hvW => hv ((AddSubgroup.disjoint_def.mp hC.disjoint) self_mem_zmultiples hvW)

private lemma add_mem_of_not_mem_compl (h2 : ∀ v : V, v + v = 0) {v : V}
    {W : AddSubgroup V} (hC : IsCompl (AddSubgroup.zmultiples v) W)
    {w : V} (hw : w ∉ W) : v + w ∈ W := by
  obtain ⟨c, hc, u, hu, hcu⟩ := exists_add_mem_of_isCompl hC w
  rcases mem_zmultiples_eq_zero_or_self h2 hc with hc0 | hcv
  · rw [hc0, zero_add] at hcu
    exact absurd (hcu ▸ hu) hw
  · rw [hcv] at hcu
    have hvw : v + w = u := by rw [← hcu, ← add_assoc, h2 v, zero_add]
    rw [hvw]; exact hu

private lemma zmod_two_eq_zero_or_one : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide

private lemma eq_of_ne_of_ne {a b c : ZMod 2} (hab : a ≠ b) (hac : a ≠ c) : b = c := by
  rcases zmod_two_eq_zero_or_one a with rfl | rfl <;>
    rcases zmod_two_eq_zero_or_one b with rfl | rfl <;>
    rcases zmod_two_eq_zero_or_one c with rfl | rfl <;> simp_all

private lemma add_eq_one_of_ne {a b : ZMod 2} (h : a ≠ b) : a + b = 1 := by
  rcases zmod_two_eq_zero_or_one a with rfl | rfl <;>
    rcases zmod_two_eq_zero_or_one b with rfl | rfl <;> simp_all

private lemma eq_one_add_of_add_eq_one {a b : ZMod 2} (h : a + b = 1) : a = 1 + b := by
  have h' : a = 1 - b := eq_sub_iff_add_eq.mpr h
  rw [h', sub_eq_add_neg, CharTwo.neg_eq]




private lemma finite_zmultiples_of_add_self_eq_zero (h2 : ∀ v : V, v + v = 0) (v : V) :
    Finite ↥(AddSubgroup.zmultiples v) := by
  apply Finite.of_surjective (fun b : Bool =>
    if b then (⟨v, self_mem_zmultiples⟩ : ↥(AddSubgroup.zmultiples v))
    else ⟨0, (AddSubgroup.zmultiples v).zero_mem⟩)
  intro x
  rcases mem_zmultiples_eq_zero_or_self h2 x.2 with hx | hx
  · exact ⟨false, Subtype.ext (by simp [hx])⟩
  · exact ⟨true, Subtype.ext (by simp [hx])⟩

private lemma infinite_of_isCompl [Infinite V] (h2 : ∀ v : V, v + v = 0) {v : V}
    {W : AddSubgroup V} (hC : IsCompl (AddSubgroup.zmultiples v) W) :
    Infinite ↥W := by
  by_contra hW
  have hfinW : Finite ↥W := Finite.of_not_infinite hW
  have hfinZ : Finite ↥(AddSubgroup.zmultiples v) := finite_zmultiples_of_add_self_eq_zero h2 v
  have hsurj : Function.Surjective
      (fun p : ↥(AddSubgroup.zmultiples v) × ↥W => (p.1 : V) + (p.2 : V)) := by
    intro x
    obtain ⟨c, hc, w, hw, hcw⟩ := exists_add_mem_of_isCompl hC x
    exact ⟨⟨⟨c, hc⟩, ⟨w, hw⟩⟩, hcw⟩
  have hfinV : Finite V := Finite.of_surjective _ hsurj
  exact not_finite V

private lemma infinite_of_bijOn {P : Type} {W : AddSubgroup V} [Infinite ↥W]
    {θ : V → P} (hbij : Set.BijOn θ (W : Set V) Set.univ) : Infinite P := by
  have hinj : Function.Injective (fun w : ↥W => θ (w : V)) := by
    intro a b hab
    exact Subtype.ext (hbij.injOn a.2 b.2 hab)
  have hsurj : Function.Surjective (fun w : ↥W => θ (w : V)) := by
    intro p
    obtain ⟨w, hw, hwp⟩ := hbij.surjOn (Set.mem_univ p)
    exact ⟨⟨w, hw⟩, hwp⟩
  by_contra hP
  have hfinP : Finite P := Finite.of_not_infinite hP
  have hfinW' : Finite ↥W := Finite.of_injective _ hinj
  exact not_finite ↥W




/-- From the field-like data at `v`, the stabilizer is transitive on the nonzero
elements of the complement. -/
private lemma exists_stabilizer_transitive_of_fieldLike [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    {v : V}
    (hB : ∃ (W : AddSubgroup V) (P : Type) (_ : Field P),
        CharP P 2 ∧ IsLocallyFiniteField P ∧ IsCompl (AddSubgroup.zmultiples v) W ∧
        (∀ g ∈ G, g v = v → ∀ w ∈ W, g w ∈ W) ∧
        ∃ (ψ : ↥(G ⊓ MulAction.stabilizer (Equiv.Perm V) v) ≃* Pˣ) (θ : V → P),
          Set.BijOn θ (W : Set V) Set.univ ∧
          ∀ h : ↥(G ⊓ MulAction.stabilizer (Equiv.Perm V) v), ∀ w ∈ W,
            θ ((h : Equiv.Perm V) w) = (ψ h : P) * θ w) :
    ∃ W : AddSubgroup V, IsCompl (AddSubgroup.zmultiples v) W ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W, g w ∈ W) ∧
      ∀ w₁ w₂ : V, w₁ ∈ W → w₂ ∈ W → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂ := by
  obtain ⟨W, P, _, _, _, hC, hpres, ψ, θ, hbij, hequiv⟩ := hB
  have hWinf : Infinite ↥W := infinite_of_isCompl h2 hC
  have hPinf : Infinite P := infinite_of_bijOn hbij
  -- The perm underlying an element of the stabilizer fixes `v` and `0`.
  have hfix : ∀ h : ↥(G ⊓ MulAction.stabilizer (Equiv.Perm V) v),
      (h : Equiv.Perm V) v = v ∧ (h : Equiv.Perm V) 0 = 0 := by
    intro h
    refine ⟨?_, ?_⟩
    · have hmem : (h : Equiv.Perm V) ∈ MulAction.stabilizer (Equiv.Perm V) v := h.2.2
      have hsmul : (h : Equiv.Perm V) • v = v := MulAction.mem_stabilizer_iff.mp hmem
      rw [Equiv.Perm.smul_def] at hsmul
      exact hsmul
    · exact perm_apply_zero_of_additive G hadd h.2.1
  -- `θ 0 = 0`.
  have hθ0 : θ 0 = 0 := by
    by_contra hne
    have hkey : ∀ u : Pˣ, (u : P) * θ 0 = θ 0 := by
      intro u
      have h := hequiv (ψ.symm u) 0 (W.zero_mem)
      rw [(hfix (ψ.symm u)).2, MulEquiv.apply_symm_apply] at h
      exact h.symm
    obtain ⟨a, ha0, ha1⟩ : ∃ a : P, a ≠ 0 ∧ a ≠ 1 := by
      classical
      obtain ⟨a, ha⟩ := ({0, 1} : Finset P).exists_notMem
      have ha0 : a ≠ 0 := by
        intro h; apply ha; rw [h]; simp
      have ha1 : a ≠ 1 := by
        intro h; apply ha; rw [h]; simp
      exact ⟨a, ha0, ha1⟩
    let u : Pˣ := Units.mk0 a ha0
    have hu : (u : P) = a := rfl
    have hu1 : u ≠ 1 := by
      intro hu1
      apply ha1
      have : (u : P) = (1 : Pˣ) := by rw [hu1]
      rw [hu] at this
      simpa using this
    have hcancel := hkey u
    have : (u : P) = 1 := by
      apply mul_right_cancel₀ hne
      rw [hcancel]; simp
    exact hu1 (Units.ext this)
  refine ⟨W, hC, hpres, ?_⟩
  intro w₁ w₂ hw₁ hw₂ hw₁0 hw₂0
  have hθ1 : θ w₁ ≠ 0 := by
    intro h
    apply hw₁0
    have := hbij.injOn hw₁ (W.zero_mem) (by rw [h, hθ0])
    exact this
  have hθ2 : θ w₂ ≠ 0 := by
    intro h
    apply hw₂0
    have := hbij.injOn hw₂ (W.zero_mem) (by rw [h, hθ0])
    exact this
  let u : Pˣ := Units.mk0 (θ w₂ * (θ w₁)⁻¹) (mul_ne_zero hθ2 (inv_ne_zero hθ1))
  have hu : (u : P) = θ w₂ * (θ w₁)⁻¹ := rfl
  let h : ↥(G ⊓ MulAction.stabilizer (Equiv.Perm V) v) := ψ.symm u
  refine ⟨(h : Equiv.Perm V), h.2.1, (hfix h).1, ?_⟩
  have heq := hequiv h w₁ hw₁
  rw [MulEquiv.apply_symm_apply, hu] at heq
  have hmem : (h : Equiv.Perm V) w₁ ∈ W := hpres _ h.2.1 (hfix h).1 w₁ hw₁
  have hθeq : θ ((h : Equiv.Perm V) w₁) = θ w₂ := by
    rw [heq, mul_assoc, inv_mul_cancel₀ hθ1, mul_one]
  exact hbij.injOn hmem hw₂ hθeq




open Classical in
/-- The graph functional of a second complement: `0` on `W'`, `1` off it. -/
private noncomputable def graphFunctional (W' : AddSubgroup V) (w : V) : ZMod 2 :=
  if w ∈ W' then 0 else 1

private lemma graphFunctional_add (h2 : ∀ v : V, v + v = 0) {v : V}
    {W' : AddSubgroup V} (hC' : IsCompl (AddSubgroup.zmultiples v) W')
    {w₁ w₂ : V} :
    graphFunctional W' (w₁ + w₂) = graphFunctional W' w₁ + graphFunctional W' w₂ := by
  by_cases h₁ : w₁ ∈ W'
  · by_cases h₂ : w₂ ∈ W'
    · have hsum : w₁ + w₂ ∈ W' := W'.add_mem h₁ h₂
      simp [graphFunctional, h₁, h₂, hsum]
    · have hsum : w₁ + w₂ ∉ W' := by
        intro hsum
        apply h₂
        have hid : (w₁ + w₂) + w₁ = w₂ := by
          rw [add_assoc, add_comm w₂ w₁, ← add_assoc, h2 w₁, zero_add]
        rw [← hid]
        exact W'.add_mem hsum h₁
      simp [graphFunctional, h₁, h₂, hsum]
  · by_cases h₂ : w₂ ∈ W'
    · have hsum : w₁ + w₂ ∉ W' := by
        intro hsum
        apply h₁
        have hid : (w₁ + w₂) + w₂ = w₁ := by
          rw [add_assoc, h2 w₂, add_zero]
        rw [← hid]
        exact W'.add_mem hsum h₂
      simp [graphFunctional, h₁, h₂, hsum]
    · have hsum : w₁ + w₂ ∈ W' := by
        have h1' : v + w₁ ∈ W' := add_mem_of_not_mem_compl h2 hC' h₁
        have h2' : v + w₂ ∈ W' := add_mem_of_not_mem_compl h2 hC' h₂
        have hid : (v + w₁) + (v + w₂) = w₁ + w₂ := by
          rw [add_add_add_comm, h2 v, zero_add]
        rw [← hid]
        exact W'.add_mem h1' h2'
      simp [graphFunctional, h₁, h₂, hsum]

private lemma graphFunctional_apply
    (G : Subgroup (Equiv.Perm V))
    {v : V} {W' : AddSubgroup V} (hpres' : ∀ g ∈ G, g v = v → ∀ w ∈ W', g w ∈ W')
    {g : Equiv.Perm V} (hg : g ∈ G) (hgv : g v = v)
    (w : V) : graphFunctional W' (g w) = graphFunctional W' w := by
  have hiff : g w ∈ W' ↔ w ∈ W' := by
    constructor
    · intro hgw
      have hginv : g.symm ∈ G := by rw [← Equiv.Perm.inv_def]; exact inv_mem hg
      have hginv_v : g.symm v = v := by
        have := Equiv.symm_apply_apply g v
        rw [hgv] at this
        exact this
      have hgw' := hpres' g.symm hginv hginv_v (g w) hgw
      rwa [Equiv.symm_apply_apply] at hgw'
    · intro hw
      exact hpres' g hg hgv w hw
  by_cases h : w ∈ W'
  · have hgw := hiff.mpr h
    simp [graphFunctional, h, hgw]
  · have hgw : g w ∉ W' := fun hg => h (hiff.mp hg)
    simp [graphFunctional, h, hgw]

private lemma eq_of_isCompl_of_invariant [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    {v : V} {W₀ : AddSubgroup V}
    (hC₀ : IsCompl (AddSubgroup.zmultiples v) W₀)
    (htrans₀ : ∀ w₁ w₂ : V, w₁ ∈ W₀ → w₂ ∈ W₀ → w₁ ≠ 0 → w₂ ≠ 0 →
      ∃ g ∈ G, g v = v ∧ g w₁ = w₂)
    {W' : AddSubgroup V} (hC' : IsCompl (AddSubgroup.zmultiples v) W')
    (hpres' : ∀ g ∈ G, g v = v → ∀ w ∈ W', g w ∈ W') :
    W' = W₀ := by
  classical
  have hWinf : Infinite ↥W₀ := infinite_of_isCompl h2 hC₀
  obtain ⟨w₁', hw₁'⟩ := ({0} : Finset ↥W₀).exists_notMem
  have hw₁ne' : w₁' ≠ 0 := by simpa using hw₁'
  obtain ⟨w₂', hw₂'⟩ := ({0, w₁'} : Finset ↥W₀).exists_notMem
  have hw₂ne' : w₂' ≠ 0 ∧ w₂' ≠ w₁' := by simpa using hw₂'
  set w₁ : V := (w₁' : V) with hw₁def
  set w₂ : V := (w₂' : V) with hw₂def
  have hw₁mem : w₁ ∈ W₀ := w₁'.2
  have hw₂mem : w₂ ∈ W₀ := w₂'.2
  have hw₁ne : w₁ ≠ 0 := by
    intro h; apply hw₁ne'; exact Subtype.ext h
  have hw₂ne : w₂ ≠ 0 := by
    intro h; apply hw₂ne'.1; exact Subtype.ext h
  have hsum_mem : w₁ + w₂ ∈ W₀ := W₀.add_mem hw₁mem hw₂mem
  have hsum_ne : w₁ + w₂ ≠ 0 := by
    intro h
    have hid : (w₁ + w₂) + w₁ = w₂ := by
      rw [add_assoc, add_comm w₂ w₁, ← add_assoc, h2 w₁, zero_add]
    rw [h, zero_add] at hid
    have hsub : w₂' = w₁' := Subtype.ext hid.symm
    exact hw₂ne'.2 hsub
  have hconst : ∀ w ∈ W₀, w ≠ 0 → graphFunctional W' w = graphFunctional W' w₁ := by
    intro w hw hwne
    obtain ⟨g, hg, hgv, hgw⟩ := htrans₀ w₁ w hw₁mem hw hw₁ne hwne
    rw [← hgw]
    exact graphFunctional_apply G hpres' hg hgv w₁
  have hε : graphFunctional W' w₁ = 0 := by
    have hadd' : graphFunctional W' (w₁ + w₂) =
        graphFunctional W' w₁ + graphFunctional W' w₂ := graphFunctional_add h2 hC'
    rw [hconst _ hsum_mem hsum_ne, hconst _ hw₂mem hw₂ne] at hadd'
    rw [CharTwo.add_self_eq_zero] at hadd'
    exact hadd'
  have hle : W₀ ≤ W' := by
    intro w hw
    by_cases hw0 : w = 0
    · rw [hw0]; exact W'.zero_mem
    · have hℓ := hconst w hw hw0
      rw [hε] at hℓ
      by_contra hw'
      have hval : graphFunctional W' w = 1 := by simp [graphFunctional, hw']
      rw [hval] at hℓ
      exact one_ne_zero hℓ
  apply le_antisymm _ hle
  intro x hx
  obtain ⟨c, hc, u, hu, hcu⟩ := exists_add_mem_of_isCompl hC₀ x
  have hcW' : c ∈ W' := by
    have hid : c = x + u := by
      rw [← hcu, add_assoc, h2 u, add_zero]
    rw [hid]
    exact W'.add_mem hx (hle hu)
  have hc0 : c = 0 := (AddSubgroup.disjoint_def.mp hC'.disjoint) hc hcW'
  rw [hc0, zero_add] at hcu
  rw [← hcu]; exact hu




open Classical in
/-- The coordinate functional attached to a chosen complement. -/
private noncomputable def coordinateFunctional (W : V → AddSubgroup V) (v w : V) : ZMod 2 :=
  if v = 0 then 0 else if w ∈ W v then 0 else 1

private lemma coordinateFunctional_add (h2 : ∀ v : V, v + v = 0) {W : V → AddSubgroup V}
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v))
    {v : V} (hv : v ≠ 0) (w₁ w₂ : V) :
    coordinateFunctional W v (w₁ + w₂) =
      coordinateFunctional W v w₁ + coordinateFunctional W v w₂ := by
  have hC := hW v hv
  by_cases h₁ : w₁ ∈ W v
  · by_cases h₂ : w₂ ∈ W v
    · have hsum : w₁ + w₂ ∈ W v := (W v).add_mem h₁ h₂
      simp [coordinateFunctional, hv, h₁, h₂, hsum]
    · have hsum : w₁ + w₂ ∉ W v := by
        intro hsum
        apply h₂
        have hid : (w₁ + w₂) + w₁ = w₂ := by
          rw [add_assoc, add_comm w₂ w₁, ← add_assoc, h2 w₁, zero_add]
        rw [← hid]
        exact (W v).add_mem hsum h₁
      simp [coordinateFunctional, hv, h₁, h₂, hsum]
  · by_cases h₂ : w₂ ∈ W v
    · have hsum : w₁ + w₂ ∉ W v := by
        intro hsum
        apply h₁
        have hid : (w₁ + w₂) + w₂ = w₁ := by
          rw [add_assoc, h2 w₂, add_zero]
        rw [← hid]
        exact (W v).add_mem hsum h₂
      simp [coordinateFunctional, hv, h₁, h₂, hsum]
    · have hsum : w₁ + w₂ ∈ W v := by
        have h1' : v + w₁ ∈ W v := add_mem_of_not_mem_compl h2 hC h₁
        have h2' : v + w₂ ∈ W v := add_mem_of_not_mem_compl h2 hC h₂
        have hid : (v + w₁) + (v + w₂) = w₁ + w₂ := by
          rw [add_add_add_comm, h2 v, zero_add]
        rw [← hid]
        exact (W v).add_mem h1' h2'
      simp [coordinateFunctional, hv, h₁, h₂, hsum]

private lemma coordinateFunctional_self {W : V → AddSubgroup V}
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v))
    {v : V} (hv : v ≠ 0) : coordinateFunctional W v v = 1 := by
  have hnv : v ∉ W v := not_mem_of_isCompl hv (hW v hv)
  simp [coordinateFunctional, hv, hnv]

private lemma coordinateFunctional_apply [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    (W : V → AddSubgroup V)
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v) ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W v, g w ∈ W v) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W v → w₂ ∈ W v → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂))
    {v : V} (hv : v ≠ 0) {k : Equiv.Perm V} (hk : k ∈ G) (w : V) :
    coordinateFunctional W (k v) (k w) = coordinateFunctional W v w := by
  have hkv : k v ≠ 0 := by
    intro h
    apply hv
    have h0 : k 0 = 0 := perm_apply_zero_of_additive G hadd hk
    exact k.injective (by rw [h, h0])
  let e : V ≃+ V := ⟨k, hadd k hk⟩
  have he : ∀ u : V, (e : V →+ V) u = k u := fun u => rfl
  set W' : AddSubgroup V := AddSubgroup.map (e : V →+ V) (W v) with hW'def
  have hC' : IsCompl (AddSubgroup.zmultiples (k v)) W' := by
    constructor
    · rw [AddSubgroup.disjoint_def]
      intro x hxA hxW
      obtain ⟨u, hu, hu_eq⟩ := AddSubgroup.mem_map.mp hxW
      rw [he] at hu_eq
      rcases mem_zmultiples_eq_zero_or_self h2 hxA with hx | hx
      · exact hx
      · exfalso
        have huv : u = v := k.injective (by rw [hu_eq, hx])
        exact not_mem_of_isCompl hv (hW v hv).1 (huv ▸ hu)
    · have hsup : AddSubgroup.zmultiples (k v) ⊔ W' = ⊤ := by
        rw [eq_top_iff]
        intro x _
        obtain ⟨y, hy⟩ : ∃ y : V, k y = x := ⟨k.symm x, by simp⟩
        obtain ⟨c, hc, u, hu, hcu⟩ := exists_add_mem_of_isCompl (hW v hv).1 y
        have hkc : k c ∈ AddSubgroup.zmultiples (k v) := by
          rcases mem_zmultiples_eq_zero_or_self h2 hc with hc0 | hcv
          · rw [hc0]; simp [perm_apply_zero_of_additive G hadd hk]
          · rw [hcv]; exact self_mem_zmultiples
        have hku : k u ∈ W' := by
          apply AddSubgroup.mem_map.mpr
          exact ⟨u, hu, by rw [he]⟩
        have hsum : k c + k u = x := by
          rw [← hadd k hk, hcu]
          exact hy
        exact AddSubgroup.mem_sup.mpr ⟨k c, hkc, k u, hku, hsum⟩
      exact codisjoint_iff.mpr hsup
  have hpres' : ∀ g ∈ G, g (k v) = k v → ∀ w ∈ W', g w ∈ W' := by
    intro g hg hgv w hw
    obtain ⟨u, hu, hu_eq⟩ := AddSubgroup.mem_map.mp hw
    rw [he] at hu_eq
    let p : Equiv.Perm V := k⁻¹ * g * k
    have hpG : p ∈ G := mul_mem (mul_mem (inv_mem hk) hg) hk
    have hpv : p v = v := by
      simp [p, Equiv.Perm.mul_apply, hgv]
    have hpu : p u ∈ W v := (hW v hv).2.1 p hpG hpv u hu
    apply AddSubgroup.mem_map.mpr
    refine ⟨p u, hpu, ?_⟩
    rw [he]
    have hpu_eq : k (p u) = g (k u) := by simp [p, Equiv.Perm.mul_apply]
    rw [hpu_eq, hu_eq]
  have huniq : W' = W (k v) :=
    eq_of_isCompl_of_invariant h2 G (hW (k v) hkv).1
      (hW (k v) hkv).2.2 hC' hpres'
  have hiff : k w ∈ W (k v) ↔ w ∈ W v := by
    rw [← huniq]
    constructor
    · intro hkw
      obtain ⟨u, hu, hu_eq⟩ := AddSubgroup.mem_map.mp hkw
      rw [he] at hu_eq
      have : u = w := k.injective hu_eq
      exact this ▸ hu
    · intro hw
      apply AddSubgroup.mem_map.mpr
      exact ⟨w, hw, by rw [he]⟩
  by_cases hw : w ∈ W v
  · have hkw : k w ∈ W (k v) := hiff.mpr hw
    simp [coordinateFunctional, hv, hkv, hw, hkw]
  · have hkw : k w ∉ W (k v) := fun h => hw (hiff.mp h)
    simp [coordinateFunctional, hv, hkv, hw, hkw]




private lemma coordinateFunctional_eq_zero_iff {W : V → AddSubgroup V} {v w : V} (hv : v ≠ 0) :
    coordinateFunctional W v w = 0 ↔ w ∈ W v := by
  simp [coordinateFunctional, hv]

private lemma exists_perm_of_eq_coordinateFunctional [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    (htrans : ∀ u w : V, u ≠ 0 → w ≠ 0 → ∃ g ∈ G, g u = w)
    (W : V → AddSubgroup V)
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v) ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W v, g w ∈ W v) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W v → w₂ ∈ W v → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂))
    {v w v' w' : V} (hv : v ≠ 0) (hw : w ≠ 0) (hv' : v' ≠ 0) (hw' : w' ≠ 0)
    (hne : v ≠ w) (hne' : v' ≠ w')
    (hbit : coordinateFunctional W v w = coordinateFunctional W v' w') :
    ∃ k ∈ G, k v = v' ∧ k w = w' := by
  obtain ⟨k₁, hk₁, hk₁v⟩ := htrans v v' hv hv'
  have hw₁0 : k₁ w ≠ 0 := by
    intro h
    apply hw
    have h0 : k₁ 0 = 0 := perm_apply_zero_of_additive G hadd hk₁
    exact k₁.injective (by rw [h, h0])
  have hw₁ne : k₁ w ≠ v' := by
    intro h
    apply hne
    have hwv : w = v := k₁.injective (by rw [h, hk₁v])
    exact hwv.symm
  have hbit₁ : coordinateFunctional W v' (k₁ w) = coordinateFunctional W v' w' := by
    have htr := coordinateFunctional_apply h2 G hadd W hW hv hk₁ w
    rw [hk₁v] at htr
    rw [htr, hbit]
  by_cases hb : coordinateFunctional W v' (k₁ w) = 0
  · have hmem₁ : k₁ w ∈ W v' := (coordinateFunctional_eq_zero_iff hv').mp hb
    have hmem₂ : w' ∈ W v' := (coordinateFunctional_eq_zero_iff hv').mp (by rw [← hbit₁]; exact hb)
    obtain ⟨k₂, hk₂, hk₂v, hk₂w⟩ := (hW v' hv').2.2 (k₁ w) w' hmem₁ hmem₂ hw₁0 hw'
    refine ⟨k₂ * k₁, mul_mem hk₂ hk₁, ?_, ?_⟩
    · simp [Equiv.Perm.mul_apply, hk₁v, hk₂v]
    · simp [Equiv.Perm.mul_apply, hk₂w]
  · have hval : coordinateFunctional W v' (k₁ w) = 1 := by
      rcases zmod_two_eq_zero_or_one (coordinateFunctional W v' (k₁ w)) with h0 | h1
      · exact absurd h0 hb
      · exact h1
    have hnot₁ : k₁ w ∉ W v' := by
      intro hmem
      apply hb
      exact (coordinateFunctional_eq_zero_iff hv').mpr hmem
    have hnot₂ : w' ∉ W v' := by
      intro hmem
      apply hb
      rw [hbit₁]
      exact (coordinateFunctional_eq_zero_iff hv').mpr hmem
    have hmem₁ : v' + k₁ w ∈ W v' :=
      add_mem_of_not_mem_compl h2 (hW v' hv').1 hnot₁
    have hmem₂ : v' + w' ∈ W v' :=
      add_mem_of_not_mem_compl h2 (hW v' hv').1 hnot₂
    have hne₁ : v' + k₁ w ≠ 0 := by
      intro h
      apply hw₁ne
      have hid : v' + (v' + k₁ w) = k₁ w := by
        rw [← add_assoc, h2 v', zero_add]
      rw [h] at hid
      have hvk : v' = k₁ w := by simpa using hid
      exact hvk.symm
    have hne₂ : v' + w' ≠ 0 := by
      intro h
      apply hne'
      have hid : v' + (v' + w') = w' := by
        rw [← add_assoc, h2 v', zero_add]
      rw [h] at hid
      simpa using hid
    obtain ⟨k₂, hk₂, hk₂v, hk₂w⟩ := (hW v' hv').2.2 (v' + k₁ w) (v' + w')
      hmem₁ hmem₂ hne₁ hne₂
    have hk₂w' : k₂ (k₁ w) = w' := by
      have hid₁ : k₁ w = v' + (v' + k₁ w) := by
        rw [← add_assoc, h2 v', zero_add]
      have hid₂ : w' = v' + (v' + w') := by
        rw [← add_assoc, h2 v', zero_add]
      rw [hid₁, hadd k₂ hk₂, hk₂v, hk₂w, ← hid₂]
    refine ⟨k₂ * k₁, mul_mem hk₂ hk₁, ?_, ?_⟩
    · simp [Equiv.Perm.mul_apply, hk₁v, hk₂v]
    · simp [Equiv.Perm.mul_apply, hk₂w']

private lemma eq_coordinateFunctional_of_eq [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    (htrans : ∀ u w : V, u ≠ 0 → w ≠ 0 → ∃ g ∈ G, g u = w)
    (W : V → AddSubgroup V)
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v) ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W v, g w ∈ W v) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W v → w₂ ∈ W v → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂))
    {a b : V} (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ≠ b)
    (href : coordinateFunctional W a b = coordinateFunctional W b a)
    {v w : V} (hv : v ≠ 0) (hw : w ≠ 0) (hvw : v ≠ w) :
    coordinateFunctional W v w = coordinateFunctional W w v := by
  by_contra hne
  by_cases h1 : coordinateFunctional W v w = coordinateFunctional W a b
  · obtain ⟨k, hk, hkv, hkw⟩ := exists_perm_of_eq_coordinateFunctional h2 G hadd htrans W hW
      hv hw ha hb hvw hab h1
    have htr := coordinateFunctional_apply h2 G hadd W hW hw hk v
    rw [hkw, hkv] at htr
    have hEq : coordinateFunctional W v w = coordinateFunctional W w v := by
      rw [h1, href]; exact htr
    exact hne hEq
  · have hwv_eq : coordinateFunctional W w v = coordinateFunctional W a b := by
      by_contra hcon
      exact hne (eq_of_ne_of_ne (Ne.symm h1) (Ne.symm hcon))
    obtain ⟨k, hk, hkw, hkv⟩ := exists_perm_of_eq_coordinateFunctional h2 G hadd htrans W hW
      hw hv ha hb (Ne.symm hvw) hab hwv_eq
    have htr := coordinateFunctional_apply h2 G hadd W hW hv hk w
    rw [hkv, hkw] at htr
    have hEq2 : coordinateFunctional W a b = coordinateFunctional W v w := by rw [href]; exact htr
    exact h1 hEq2.symm

private lemma ne_coordinateFunctional_of_ne [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    (htrans : ∀ u w : V, u ≠ 0 → w ≠ 0 → ∃ g ∈ G, g u = w)
    (W : V → AddSubgroup V)
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v) ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W v, g w ∈ W v) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W v → w₂ ∈ W v → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂))
    {a b : V} (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ≠ b)
    (href : coordinateFunctional W a b ≠ coordinateFunctional W b a)
    {v w : V} (hv : v ≠ 0) (hw : w ≠ 0) (hvw : v ≠ w) :
    coordinateFunctional W v w ≠ coordinateFunctional W w v := by
  intro hEq
  by_cases h1 : coordinateFunctional W v w = coordinateFunctional W a b
  · obtain ⟨k, hk, hkv, hkw⟩ := exists_perm_of_eq_coordinateFunctional h2 G hadd htrans W hW
      hv hw ha hb hvw hab h1
    have htr := coordinateFunctional_apply h2 G hadd W hW hw hk v
    rw [hkw, hkv] at htr
    have htr2 := htr.symm
    rw [← hEq, h1] at htr2
    exact href htr2
  · have hv_eq : coordinateFunctional W v w = coordinateFunctional W b a :=
      eq_of_ne_of_ne (Ne.symm h1) href
    obtain ⟨k, hk, hkv, hkw⟩ := exists_perm_of_eq_coordinateFunctional h2 G hadd htrans W hW
      hv hw hb ha hvw (Ne.symm hab) hv_eq
    have htr := coordinateFunctional_apply h2 G hadd W hW hw hk v
    rw [hkw, hkv] at htr
    have htr2 := htr.symm
    rw [← hEq, hv_eq] at htr2
    exact href htr2.symm




private lemma false_of_fieldLikeData [Infinite V] (h2 : ∀ v : V, v + v = 0)
    (G : Subgroup (Equiv.Perm V))
    (hadd : ∀ g ∈ G, ∀ a b : V, g (a + b) = g a + g b)
    (htrans : ∀ u w : V, u ≠ 0 → w ≠ 0 → ∃ g ∈ G, g u = w)
    (W : V → AddSubgroup V)
    (hW : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v) ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W v, g w ∈ W v) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W v → w₂ ∈ W v → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂)) :
    False := by
  classical
  have hWc : ∀ v : V, v ≠ 0 → IsCompl (AddSubgroup.zmultiples v) (W v) :=
    fun v hv => (hW v hv).1
  obtain ⟨x, hx⟩ := ({0} : Finset V).exists_notMem
  have hx0 : x ≠ 0 := by simpa using hx
  obtain ⟨y, hy⟩ := ({0, x} : Finset V).exists_notMem
  obtain ⟨hy0, hyx⟩ : y ≠ 0 ∧ y ≠ x := by simpa using hy
  have hxy : x ≠ y := Ne.symm hyx
  have hsum0 : x + y ≠ 0 := by
    intro h
    apply hyx
    have hid : x + (x + y) = y := by rw [← add_assoc, h2 x, zero_add]
    rw [h] at hid
    have hxy' : x = y := by simpa using hid
    exact hxy'.symm
  have hxyx : x + y ≠ x := by
    intro h
    apply hy0
    have h2' : x + y = x + 0 := by simp [h]
    exact add_left_cancel h2'
  have hxyy : x + y ≠ y := by
    intro h
    apply hx0
    have h' : y + x = y + 0 := by rw [add_comm]; simp [h]
    exact add_left_cancel h'
  by_cases href : coordinateFunctional W x y = coordinateFunctional W y x
  · -- Symmetric case.
    have hsym : ∀ {v w : V}, v ≠ 0 → w ≠ 0 → v ≠ w →
        coordinateFunctional W v w = coordinateFunctional W w v :=
      eq_coordinateFunctional_of_eq h2 G hadd htrans W hW hx0 hy0 hxy href
    have h1 : coordinateFunctional W (x + y) (x + y) = 1 := coordinateFunctional_self hWc hsum0
    have h2e : coordinateFunctional W (x + y) (x + y) =
        coordinateFunctional W (x + y) x + coordinateFunctional W (x + y) y :=
      coordinateFunctional_add h2 hWc hsum0 x y
    have hfx : coordinateFunctional W (x + y) x = 1 + coordinateFunctional W x y := by
      have hsym1 : coordinateFunctional W (x + y) x = coordinateFunctional W x (x + y) :=
        hsym hsum0 hx0 hxyx
      rw [hsym1, coordinateFunctional_add h2 hWc hx0 x y, coordinateFunctional_self hWc hx0]
    have hfy : coordinateFunctional W (x + y) y = 1 + coordinateFunctional W x y := by
      have hsym1 : coordinateFunctional W (x + y) y = coordinateFunctional W y (x + y) :=
        hsym hsum0 hy0 hxyy
      have hsym2 : coordinateFunctional W y x = coordinateFunctional W x y := hsym hy0 hx0 hyx
      rw [hsym1, coordinateFunctional_add h2 hWc hy0 x y,
        coordinateFunctional_self hWc hy0, hsym2, add_comm]
    rw [hfx, hfy] at h2e
    rw [h1, CharTwo.add_self_eq_zero] at h2e
    exact one_ne_zero h2e
  · -- Antisymmetric case.
    have hasym : ∀ {v w : V}, v ≠ 0 → w ≠ 0 → v ≠ w →
        coordinateFunctional W v w ≠ coordinateFunctional W w v :=
      ne_coordinateFunctional_of_ne h2 G hadd htrans W hW hx0 hy0 hxy href
    obtain ⟨z₁, hz₁⟩ := ({0, x, y, x + y} : Finset V).exists_notMem
    obtain ⟨hz₁0, hz₁x, hz₁y, hz₁xy⟩ : z₁ ≠ 0 ∧ z₁ ≠ x ∧ z₁ ≠ y ∧ z₁ ≠ x + y := by
      simpa using hz₁
    obtain ⟨z₂, hz₂⟩ :=
      ({0, x, y, x + y, z₁, z₁ + x, z₁ + y, z₁ + x + y} : Finset V).exists_notMem
    obtain ⟨hz₂0, hz₂x, hz₂y, hz₂xy, hz₂z₁, hz₂z₁x, hz₂z₁y, hz₂z₁xy⟩ :
        z₂ ≠ 0 ∧ z₂ ≠ x ∧ z₂ ≠ y ∧ z₂ ≠ x + y ∧ z₂ ≠ z₁ ∧ z₂ ≠ z₁ + x ∧
          z₂ ≠ z₁ + y ∧ z₂ ≠ z₁ + x + y := by
      simpa using hz₂
    have key : ∀ t : V, z₁ + z₂ = t → z₂ = z₁ + t := by
      intro t ht
      have hid : z₁ + (z₁ + z₂) = z₂ := by rw [← add_assoc, h2 z₁, zero_add]
      rw [ht] at hid
      exact hid.symm
    obtain ⟨hz₁₂0, hz₁₂x, hz₁₂y, hz₁₂xy⟩ :
        z₁ + z₂ ≠ 0 ∧ z₁ + z₂ ≠ x ∧ z₁ + z₂ ≠ y ∧ z₁ + z₂ ≠ x + y := by
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro h; apply hz₂z₁; simpa using key 0 h
      · intro h; apply hz₂z₁x; simpa using key x h
      · intro h; apply hz₂z₁y; simpa using key y h
      · intro h; apply hz₂z₁xy
        have hk := key (x + y) h
        rw [← add_assoc] at hk
        exact hk
    have hL : ∀ z : V, z ≠ 0 → z ≠ x → z ≠ y → z ≠ x + y →
        coordinateFunctional W (x + y) z + coordinateFunctional W x z +
          coordinateFunctional W y z = 1 := by
      intro z hz0 hzx hzy hzxy
      have hne1 : coordinateFunctional W (x + y) z + coordinateFunctional W z (x + y) = 1 :=
        add_eq_one_of_ne (hasym hsum0 hz0 (Ne.symm hzxy))
      have hne2 : coordinateFunctional W z x + coordinateFunctional W x z = 1 :=
        add_eq_one_of_ne (hasym hz0 hx0 hzx)
      have hne3 : coordinateFunctional W z y + coordinateFunctional W y z = 1 :=
        add_eq_one_of_ne (hasym hz0 hy0 hzy)
      have haddz : coordinateFunctional W z (x + y) =
          coordinateFunctional W z x + coordinateFunctional W z y :=
        coordinateFunctional_add h2 hWc hz0 x y
      have e1 := eq_one_add_of_add_eq_one hne1
      have e2 := eq_one_add_of_add_eq_one hne2
      have e3 := eq_one_add_of_add_eq_one hne3
      calc coordinateFunctional W (x + y) z + coordinateFunctional W x z +
              coordinateFunctional W y z
          = (1 + coordinateFunctional W z (x + y)) + coordinateFunctional W x z +
              coordinateFunctional W y z := by rw [e1]
        _ = (1 + (coordinateFunctional W z x + coordinateFunctional W z y)) +
              coordinateFunctional W x z + coordinateFunctional W y z := by
            rw [haddz]
        _ = (1 + ((1 + coordinateFunctional W x z) + (1 + coordinateFunctional W y z))) +
              coordinateFunctional W x z + coordinateFunctional W y z := by rw [e2, e3]
        _ = 1 := by
            rcases zmod_two_eq_zero_or_one (coordinateFunctional W x z) with ha | ha <;>
              rcases zmod_two_eq_zero_or_one (coordinateFunctional W y z) with hb | hb <;>
                rw [ha, hb] <;> decide
    have hL1 := hL z₁ hz₁0 hz₁x hz₁y hz₁xy
    have hL2 := hL z₂ hz₂0 hz₂x hz₂y hz₂xy
    have hL12 := hL (z₁ + z₂) hz₁₂0 hz₁₂x hz₁₂y hz₁₂xy
    have hLadd : coordinateFunctional W (x + y) (z₁ + z₂) +
          coordinateFunctional W x (z₁ + z₂) + coordinateFunctional W y (z₁ + z₂)
        = (coordinateFunctional W (x + y) z₁ + coordinateFunctional W x z₁ +
          coordinateFunctional W y z₁) +
          (coordinateFunctional W (x + y) z₂ + coordinateFunctional W x z₂ +
          coordinateFunctional W y z₂) := by
      rw [coordinateFunctional_add h2 hWc hsum0, coordinateFunctional_add h2 hWc hx0,
        coordinateFunctional_add h2 hWc hy0]
      abel
    rw [hL1, hL2, hL12, CharTwo.add_self_eq_zero] at hLadd
    exact one_ne_zero hLadd

/--
**No field-like transitive automorphism group of a countably infinite elementary abelian
$2$-group.** The conjecture of Kourovka Problem 18.60 holds: for every countably infinite
elementary abelian $2$-group $V$ (an abelian group with $v + v = 0$ for all $v \in V$) there is no
subgroup $G$ of the symmetric group $\mathrm{Sym}(V)$ consisting of additive bijections such that
(a) $G$ is transitive on $V \setminus \{0\}$, and (b) for every nonzero $v \in V$, writing
$H = G_v$ for the stabilizer of $v$ in $G$, there are a subgroup $V_v$ of $V$ with
$V = \langle v \rangle \oplus V_v$ that every element of $H$ maps into itself, a locally finite
field $P$ of characteristic $2$, a group isomorphism $\psi : H \to P^\times$ onto the
multiplicative group of $P$, and a bijection $\theta : V_v \to P$ such that
$\theta(h w) = \psi(h)\,\theta(w)$ for all $h \in H$ and $w \in V_v$.

Muliarchyk's Theorem 1 excludes a group transitive on the nonzero vectors of an
$\mathbb{F}_2$-space of dimension at least $4$ whose point stabilizer preserves a complement to
$\mathbb{F}_2 v$ and is transitive on its nonzero vectors; a similarity with $P^\times$ acting on
$P$ gives that transitivity (Corollary 2).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory:
The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 18.60 (D. V. Lytkina);
resolution: K. Muliarchyk, Involution centralizers and a linear obstruction: Kourovka Problems 18.59
and 18.60, preprint, 2026, Theorem 1: for an F_2-space V of dimension at least 4, no K ≤ GL(V)
transitive on V ∖ {0} has a point stabilizer preserving a complement W_v to F_2 v and transitive on
W_v ∖ {0}; Corollary 2: the nonexistence conjecture of Problem 18.60 holds; the Kourovka Notebook
(21st issue) marks 18.60 solved,
https://kourovkanotebookorg.wordpress.com/wp-content/uploads/2026/09/kourovka_18_59-18_60_solution.pdf.
-/
theorem noTransitiveFieldLikeAutomorphismGroup_holds : noTransitiveFieldLikeAutomorphismGroup := by
  intro V _ _ _ h2 hG
  obtain ⟨G, hadd, htrans, hB⟩ := hG
  have hWdata : ∀ v : V, v ≠ 0 → ∃ W : AddSubgroup V,
      IsCompl (AddSubgroup.zmultiples v) W ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W, g w ∈ W) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W → w₂ ∈ W → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂) := by
    intro v hv
    exact exists_stabilizer_transitive_of_fieldLike h2 G hadd (hB v hv)
  have hWdata' : ∀ v : V, ∃ W : AddSubgroup V, v ≠ 0 →
      IsCompl (AddSubgroup.zmultiples v) W ∧
      (∀ g ∈ G, g v = v → ∀ w ∈ W, g w ∈ W) ∧
      (∀ w₁ w₂ : V, w₁ ∈ W → w₂ ∈ W → w₁ ≠ 0 → w₂ ≠ 0 →
        ∃ g ∈ G, g v = v ∧ g w₁ = w₂) := by
    intro v
    by_cases hv : v ≠ 0
    · obtain ⟨W, hW⟩ := hWdata v hv
      exact ⟨W, fun _ => hW⟩
    · exact ⟨⊥, fun h => absurd h hv⟩
  choose W hW using hWdata'
  exact false_of_fieldLikeData h2 G hadd htrans W (fun v hv => hW v hv)

end MathlibExt.GroupTheory.ElementaryAbelianTransitiveFieldActionKourovka18Problem60Wanted
