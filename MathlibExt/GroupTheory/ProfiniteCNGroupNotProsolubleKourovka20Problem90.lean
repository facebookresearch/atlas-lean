/-!
# A finitely generated non-prosoluble profinite CN-group (Kourovka Notebook Problem 20.90)

Kourovka Notebook, Problem 20.90 (P. Shumyatsky), marked solved in the 21st issue: a profinite group
in which all centralizers of non-trivial elements are pronilpotent is called a CN-group. Find an
example of a finitely generated infinite profinite CN-group which is not prosoluble.

We prove existence by taking a closed, finitely generated subgroup of the special linear group over
formal power series over the field of four elements.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 20.90 (P. Shumyatsky). UnsolvedMath record
UM-00701748 (`KOU-20.90`), dataset ulamai/UnsolvedMath v1.8.0.

Profinite groups are compact Hausdorff totally disconnected topological groups in `Type`; finitely
generated means topologically: the closure of the subgroup generated by a finite set is everything.
A subgroup is pronilpotent when its image in `G / N` is nilpotent for every open normal `N` (for a
closed subgroup, an inverse limit of finite nilpotent groups), and `G` is prosoluble when every `G /
N` with `N` open normal is soluble. "Find an example" is stated as existence.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.ProfiniteCNGroupNotProsolubleKourovka20Problem90Wanted

/-- **Pronilpotent subgroup.** A subgroup $H$ of a group $G$ carrying a topology is pronilpotent
when, for every open normal subgroup $N$ of $G$, the image of $H$ in the quotient $G/N$ is
nilpotent.

For a closed subgroup of a profinite group this says that $H$ is an inverse limit of finite
nilpotent groups, since the subgroups $H \cap N$ are cofinal among the open normal subgroups of
$H$. -/
def IsPronilpotent {G : Type} [Group G] [TopologicalSpace G] (H : Subgroup G) : Prop :=
  ∀ (N : Subgroup G) [N.Normal], IsOpen (N : Set G) →
    Group.IsNilpotent (H.map (QuotientGroup.mk' N))

/-- **Problem of a finitely generated non-prosoluble profinite CN-group (Kourovka 20.90).** The
statement that there is an infinite profinite group $G$, that is, a compact, Hausdorff, totally
disconnected topological group, such that $G$ is topologically finitely generated (the closure of
the subgroup generated by some finite set is $G$), the centralizer of every non-trivial element of
$G$ is pronilpotent (so $G$ is a CN-group), and $G$ is not prosoluble: for some open normal
subgroup $N$ of $G$, the quotient $G/N$ is not soluble. -/
def existsFGInfiniteProfiniteCNGroupNotProsoluble : Prop :=
  ∃ (G : Type) (_ : Group G) (_ : TopologicalSpace G) (_ : IsTopologicalGroup G)
    (_ : CompactSpace G) (_ : T2Space G) (_ : TotallyDisconnectedSpace G),
    Infinite G ∧ (∃ s : Finset G, (Subgroup.closure (s : Set G)).topologicalClosure = ⊤) ∧
    (∀ g : G, g ≠ 1 → IsPronilpotent (Subgroup.centralizer {g})) ∧
    ¬ ∀ (N : Subgroup G) [N.Normal], IsOpen (N : Set G) → Group.IsSolvable (G ⧸ N)

open Matrix
open scoped MatrixGroups PowerSeries.WithPiTopology

section Centralizers

variable {R : Type*} [CommRing R]

-- These are the coordinates of a matrix modulo the scalar matrices.
private def coordinates (A : SL(2, R)) : Fin 3 → R :=
  ![A 0 0 - A 1 1, A 0 1, A 1 0]

private theorem commute_iff_minors (A B : SL(2, R)) :
    Commute A B ↔ ∀ i j, coordinates A i * coordinates B j =
      coordinates A j * coordinates B i := by
  change A * B = B * A ↔ _
  rw [SpecialLinearGroup.ext_iff]
  simp only [SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
  constructor
  · intro h
    have h₀₀ := h 0 0
    have h₀₁ := h 0 1
    have h₁₀ := h 1 0
    intro i j
    fin_cases i <;> fin_cases j <;> simp [coordinates] <;> grind only
  · intro h
    have h₀₁ := h 0 1
    have h₀₂ := h 0 2
    have h₁₂ := h 1 2
    simp [coordinates] at h₀₁ h₀₂ h₁₂
    intro i j
    fin_cases i <;> fin_cases j <;> grind only

variable [IsDomain R] [CharP R 2]

private theorem exists_ne_zero_coordinate (A : SL(2, R)) (hA : A ≠ 1) :
    ∃ k, coordinates A k ≠ 0 := by
  by_contra! h
  have hd : A 0 0 = A 1 1 := sub_eq_zero.mp (h 0)
  have hb : A 0 1 = 0 := h 1
  have hc : A 1 0 = 0 := h 2
  have hsq : A 0 0 ^ 2 = 1 := by
    have hdet := A.det_coe
    rw [det_fin_two, ← hd, hb, hc, zero_mul, sub_zero, ← pow_two] at hdet
    exact hdet
  have ha : A 0 0 = 1 := by
    rcases sq_eq_one_iff.mp hsq with h | h
    · exact h
    · simpa [CharTwo.neg_eq] using h
  apply hA
  ext i j
  fin_cases i <;> fin_cases j <;> simp [← hd, ha, hb, hc]

private theorem centralizers_commute {A B C : SL(2, R)} (hA : A ≠ 1)
    (hB : Commute A B) (hC : Commute A C) : Commute B C := by
  obtain ⟨k, hk⟩ := exists_ne_zero_coordinate A hA
  rw [commute_iff_minors] at hB hC ⊢
  intro i j
  apply mul_left_cancel₀ hk
  calc
    _ = coordinates B k * (coordinates A i * coordinates C j) := by
      rw [← mul_assoc, hB k i]
      ring
    _ = coordinates B k * (coordinates A j * coordinates C i) := by rw [hC i j]
    _ = _ := by
      symm
      rw [← mul_assoc, hB k j]
      ring

end Centralizers

private theorem pronilpotent_centralizer {R : Type} [CommRing R] [IsDomain R] [CharP R 2]
    (H : Subgroup SL(2, R)) [TopologicalSpace H] (g : H) (hg : g ≠ 1) :
    IsPronilpotent (Subgroup.centralizer {g}) := by
  have : IsMulCommutative (Subgroup.centralizer {g}) := by
    refine ⟨⟨fun x y ↦ Subtype.ext <| Subtype.ext <| centralizers_commute
      (A := (g : SL(2, R))) (fun h ↦ hg (Subtype.ext h)) ?_ ?_⟩⟩
    · exact (Subgroup.mem_centralizer_singleton_iff.mp x.2).symm.map H.subtype
    · exact (Subgroup.mem_centralizer_singleton_iff.mp y.2).symm.map H.subtype
  intro N _ _
  infer_instance

private abbrev K := GaloisField 2 2
private abbrev Series := PowerSeries K

private theorem residue_not_solvable : ¬ Group.IsSolvable SL(2, K) := by
  have hcard : Nat.card K = 4 := GaloisField.card 2 2 (by decide)
  have : Nontrivial Kˣ := Finite.one_lt_card_iff_nontrivial.mp <| by
    rw [Nat.card_units, hcard]
    decide
  obtain ⟨u, hu⟩ := exists_ne (1 : Kˣ)
  have hsq : (u : K) ^ 2 ≠ 1 := fun h ↦
    hu (Units.ext (by simpa [CharTwo.neg_eq] using sq_eq_one_iff.mp h))
  have : Group.IsPerfect SL(2, K) := ⟨SL2.commutator_eq_top u.ne_zero hsq⟩
  have : Nontrivial SL(2, K) := by
    refine ⟨1, SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := 1) zero_ne_one 1, ?_⟩
    intro h
    simpa [SpecialLinearGroup.transvection_coe] using congrArg (fun A : SL(2, K) ↦ A 0 1) h
  exact Group.IsPerfect.not_isSolvable _

-- The diagonal matrix with entries 1 + X and its inverse has pairwise distinct powers.
private noncomputable def diagonalEntries : Fin 2 → Series :=
  let u := PowerSeries.X + 1
  ![u, PowerSeries.invOfUnit u 1]

private noncomputable def diagonalGenerator : SL(2, Series) :=
  ⟨diagonal diagonalEntries, by
    simp [det_diagonal, Fin.prod_univ_two, diagonalEntries]⟩

private theorem diagonal_pow_injective : Function.Injective (diagonalGenerator ^ · : ℕ → _) := by
  intro m n h
  have he : (diagonal diagonalEntries ^ m) 0 0 = (diagonal diagonalEntries ^ n) 0 0 :=
    congrArg (fun A : SL(2, Series) ↦ A 0 0) h
  have hp : (Polynomial.X + 1 : Polynomial K) ^ m = (Polynomial.X + 1) ^ n := by
    apply Polynomial.coe_injective K
    simpa [diagonal_pow, diagonalEntries] using he
  simpa [Polynomial.natDegree_pow] using congrArg Polynomial.natDegree hp

private theorem generated_in_closure {A : Type*} [Group A] [TopologicalSpace A]
    [IsTopologicalGroup A] (s : Set A) (hs : s.Finite) :
    let H := (Subgroup.closure s).topologicalClosure
    ∃ t : Finset H, (Subgroup.closure (t : Set H)).topologicalClosure = ⊤ := by
  classical
  let H := (Subgroup.closure s).topologicalClosure
  have hsub : s ⊆ H := fun _ hx ↦
    (Subgroup.closure s).le_topologicalClosure (Subgroup.subset_closure hx)
  let t := H.subtype ⁻¹' s
  have ht : t.Finite := hs.preimage Subtype.val_injective.injOn
  refine ⟨ht.toFinset, ?_⟩
  rw [Set.Finite.coe_toFinset, eq_top_iff]
  intro x _
  apply closure_subtype.mpr
  change (x : A) ∈ closure ((Subgroup.closure t).map H.subtype : Set A)
  rw [MonoidHom.map_closure]
  have him : H.subtype '' t = s := Set.image_preimage_eq_of_subset <| by
    simpa [Subgroup.coe_subtype] using hsub
  rw [him]
  exact x.2

/--
**A finitely generated non-prosoluble profinite CN-group exists.** There is an infinite profinite
group $G$, that is, a compact, Hausdorff, totally disconnected topological group, such that $G$ is
topologically finitely generated (the closure of the subgroup generated by some finite set is $G$),
the centralizer of every non-trivial element of $G$ is pronilpotent, and $G$ is not prosoluble: for
some open normal subgroup $N$ of $G$, the quotient $G/N$ is not soluble. This answers Kourovka
Problem 20.90.

Kinyon and Urban (Section 3.35) give an infinite two-generated closed subgroup of
$\mathrm{SL}_2(\mathbb{F}_4[[t]])$ that maps onto $\mathrm{SL}_2(\mathbb{F}_4) \cong A_5$ and in
which every non-identity element has abelian, hence pronilpotent, centralizer.

The construction described in the module uses the closed subgroup generated by the constant
matrices and a diagonal matrix with first entry $1+t$.

Source: E. I. Khukhro and V. D. Mazurov
(eds.), Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49
(2026), Problem 20.90 (P. Shumyatsky); resolution: M. Kinyon and J. Urban, Results on problems from
the Kourovka Notebook, preprint (September 2026), Kourovka Notebook site, Section 3.35: a
two-generated closed subgroup G of SL₂(F₄[[t]]) that is infinite, maps onto SL₂(F₄) ≅ A₅ by
reduction modulo t (so it is not prosoluble), and in which the centralizer of every non-identity
element is abelian; an AI solution confirmed by P. Shumyatsky, Kourovka Notebook (21st issue),
Problem 20.90: An example is found,
https://kourovkanotebookorg.wordpress.com/wp-content/uploads/2026/09/kourovka-mathematics.pdf.
-/
theorem existsFGInfiniteProfiniteCNGroupNotProsoluble_holds :
    existsFGInfiniteProfiniteCNGroupNotProsoluble := by
  classical
  let : TopologicalSpace K := ⊥
  have : DiscreteTopology K := ⟨rfl⟩
  have : CharP Series 2 := charP_of_injective_ringHom PowerSeries.C_injective 2
  have : CompactSpace Series := inferInstanceAs (CompactSpace ((Unit →₀ ℕ) → K))
  have : TotallyDisconnectedSpace Series :=
    inferInstanceAs (TotallyDisconnectedSpace ((Unit →₀ ℕ) → K))
  have : CompactSpace (Matrix (Fin 2) (Fin 2) Series) :=
    inferInstanceAs (CompactSpace (Fin 2 → Fin 2 → Series))
  have : CompactSpace SL(2, Series) := SpecialLinearGroup.isClosedEmbedding_val.compactSpace
  have : TotallyDisconnectedSpace (Matrix (Fin 2) (Fin 2) Series) :=
    inferInstanceAs (TotallyDisconnectedSpace (Fin 2 → Fin 2 → Series))
  have : TotallyDisconnectedSpace SL(2, Series) :=
    inferInstanceAs (TotallyDisconnectedSpace {A : Matrix (Fin 2) (Fin 2) Series // A.det = 1})
  have : T2Space SL(2, Series) := SpecialLinearGroup.isClosedEmbedding_val.isEmbedding.t2Space
  let lift : SL(2, K) →* SL(2, Series) := SpecialLinearGroup.map PowerSeries.C
  let s := insert diagonalGenerator (Set.range lift)
  let H := (Subgroup.closure s).topologicalClosure
  have hmem {x} (hx : x ∈ s) : x ∈ H :=
    (Subgroup.closure s).le_topologicalClosure (Subgroup.subset_closure hx)
  have : CompactSpace H := isCompact_iff_compactSpace.mp
    (Subgroup.closure s).isClosed_topologicalClosure.isCompact
  refine ⟨H, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, ?_, generated_in_closure s ((Set.finite_range lift).insert _),
    pronilpotent_centralizer H, ?_⟩
  · let d : H := ⟨diagonalGenerator, hmem (Set.mem_insert _ _)⟩
    exact Infinite.of_injective (d ^ · : ℕ → H) fun _ _ h ↦
      diagonal_pow_injective (congrArg H.subtype h)
  · let red : H →* SL(2, K) := (SpecialLinearGroup.map PowerSeries.constantCoeff).comp H.subtype
    have hcont : Continuous red :=
      (PowerSeries.WithPiTopology.continuous_constantCoeff K).specialLinearGroup_map.comp
        continuous_subtype_val
    have hsurj : Function.Surjective red := by
      intro A
      refine ⟨⟨lift A, hmem (Set.mem_insert_of_mem _ (Set.mem_range_self A))⟩, ?_⟩
      ext i j
      exact PowerSeries.constantCoeff_C (A i j)
    intro hsolv
    have hopen : IsOpen (red.ker : Set H) := (isOpen_discrete {1}).preimage hcont
    have : Group.IsSolvable (H ⧸ red.ker) := hsolv red.ker hopen
    let e := QuotientGroup.quotientKerEquivOfSurjective red hsurj
    exact residue_not_solvable (Group.isSolvable_of_surjective (f := e.toMonoidHom) e.surjective)

end MathlibExt.GroupTheory.ProfiniteCNGroupNotProsolubleKourovka20Problem90Wanted
