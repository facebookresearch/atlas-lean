/-!
# Embedding `SL(2, ℚ)` in a division ring (Kourovka Notebook Problem 11.110)

The main result is `specialLinearRationalEmbedsInDivisionRing_refuted`: the group
`SL(2, ℚ)` does not embed in the multiplicative group of any division ring.

Kourovka Notebook, Archive of Solved Problems, Problem 11.110 (B. Hartley): is it possible to embed
`SL(2, ℚ)` in the multiplicative group of some division ring?

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 11.110 (B.
Hartley). UnsolvedMath record UM-00700802 (`KOU-11.110`), dataset ulamai/UnsolvedMath v1.8.0.

An embedding is an injective homomorphism into the group of units `Dˣ`. Division rings are taken in
`Type`, which loses nothing: the division subring generated by the image of the countable group
`SL(2, ℚ)` is countable.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.SpecialLinearRationalDivisionRingKourovka11Problem110Wanted

/-- The elementary unipotent `[[1,1],[0,1]]`. -/
private def elU : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![1, 1; 0, 1], by norm_num [Matrix.det_fin_two_of]⟩

/-- The elementary unipotent `[[1,0],[1,1]]`. -/
private def elV : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![1, 0; 1, 1], by norm_num [Matrix.det_fin_two_of]⟩

/-- The Weyl element `[[0,-1],[1,0]]`. -/
private def elS : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![0, -1; 1, 0], by norm_num [Matrix.det_fin_two_of]⟩

/-- The diagonal element `[[2,0],[0,1/2]]`. -/
private def elH : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![2, 0; 0, 1 / 2], by norm_num [Matrix.det_fin_two_of]⟩

/-- The element `[[1,1/4],[0,1]]`. -/
private def elR : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![1, 1 / 4; 0, 1], by norm_num [Matrix.det_fin_two_of]⟩

/-- The element `[[1,0],[1/4,1]]`. -/
private def elC : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![1, 0; 1 / 4, 1], by norm_num [Matrix.det_fin_two_of]⟩

/-- The central element `-I`. -/
private def elNeg : Matrix.SpecialLinearGroup (Fin 2) ℚ :=
  ⟨!![-1, 0; 0, -1], by norm_num [Matrix.det_fin_two_of]⟩

private theorem id_S_U : elS * elU * elS⁻¹ = elV⁻¹ := by
  apply Subtype.ext
  change (!![0, -1; 1, 0] * !![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) ℚ) *
      Matrix.adjugate !![0, -1; 1, 0] = Matrix.adjugate !![1, 0; 1, 1]
  rw [Matrix.adjugate_fin_two_of, Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

private theorem id_S_V : elS * elV * elS⁻¹ = elU⁻¹ := by
  apply Subtype.ext
  change (!![0, -1; 1, 0] * !![1, 0; 1, 1] : Matrix (Fin 2) (Fin 2) ℚ) *
      Matrix.adjugate !![0, -1; 1, 0] = Matrix.adjugate !![1, 1; 0, 1]
  rw [Matrix.adjugate_fin_two_of, Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

private theorem id_S_sq : elS ^ 2 = elNeg := by
  apply Subtype.ext
  change (!![0, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℚ) ^ 2 = !![-1, 0; 0, -1]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]

private theorem id_H_U : elH * elU * elH⁻¹ = elU ^ 4 := by
  apply Subtype.ext
  change (!![2, 0; 0, 1 / 2] * !![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) ℚ) *
      Matrix.adjugate !![2, 0; 0, 1 / 2] = !![1, 1; 0, 1] ^ 4
  rw [Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]; norm_num

private theorem id_H_V : elH * elV * elH⁻¹ = elC := by
  apply Subtype.ext
  change (!![2, 0; 0, 1 / 2] * !![1, 0; 1, 1] : Matrix (Fin 2) (Fin 2) ℚ) *
      Matrix.adjugate !![2, 0; 0, 1 / 2] = !![1, 0; 1 / 4, 1]
  rw [Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]; norm_num

private theorem id_Hinv_U : elH⁻¹ * elU * elH = elR := by
  apply Subtype.ext
  change (Matrix.adjugate !![2, 0; 0, 1 / 2] * !![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) ℚ) *
      !![2, 0; 0, 1 / 2] = !![1, 1 / 4; 0, 1]
  rw [Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]; norm_num

private theorem id_R_pow : elR ^ 4 = elU := by
  apply Subtype.ext
  change (!![1, 1 / 4; 0, 1] : Matrix (Fin 2) (Fin 2) ℚ) ^ 4 = !![1, 1; 0, 1]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]; norm_num

private theorem id_C_pow : elC ^ 4 = elV := by
  apply Subtype.ext
  change (!![1, 0; 1 / 4, 1] : Matrix (Fin 2) (Fin 2) ℚ) ^ 4 = !![1, 0; 1, 1]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]; norm_num

private theorem id_S_H : elS * elH * elS⁻¹ = elH⁻¹ := by
  apply Subtype.ext
  change (!![0, -1; 1, 0] * !![2, 0; 0, 1 / 2] : Matrix (Fin 2) (Fin 2) ℚ) *
      Matrix.adjugate !![0, -1; 1, 0] = Matrix.adjugate !![2, 0; 0, 1 / 2]
  rw [Matrix.adjugate_fin_two_of, Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

private theorem id_SU_cube : (elS * elU) ^ 3 = elNeg := by
  apply Subtype.ext
  change ((!![0, -1; 1, 0] * !![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) ℚ)) ^ 3 =
    !![-1, 0; 0, -1]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]

private theorem id_SUinv_cube : (elS * elU⁻¹) ^ 3 = 1 := by
  apply Subtype.ext
  change ((!![0, -1; 1, 0] * Matrix.adjugate !![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) ℚ)) ^ 3 = 1
  rw [Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]

private theorem ne_SU_neg : elS * elU ≠ elNeg := by
  intro h
  have h2 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
    (A : Matrix (Fin 2) (Fin 2) ℚ) 0 1) h
  simp only [Matrix.SpecialLinearGroup.coe_mul] at h2
  simp [elS, elU, elNeg, Matrix.mul_apply, Fin.sum_univ_two] at h2

private theorem ne_SUinv_one : elS * elU⁻¹ ≠ 1 := by
  intro h
  have h2 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
    (A : Matrix (Fin 2) (Fin 2) ℚ) 1 0) h
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv] at h2
  simp [elS, elU, Matrix.mul_apply, Fin.sum_univ_two] at h2

private theorem ne_neg_one : elNeg ≠ 1 := by
  intro h
  have h2 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
    (A : Matrix (Fin 2) (Fin 2) ℚ) 0 0) h
  simp [elNeg] at h2
  norm_num at h2

private theorem ne_U_one : elU ≠ 1 := by
  intro h
  have h2 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
    (A : Matrix (Fin 2) (Fin 2) ℚ) 0 1) h
  simp [elU] at h2

private theorem elU_pow_mat (k : ℕ) :
    ((elU ^ k : Matrix.SpecialLinearGroup (Fin 2) ℚ) : Matrix (Fin 2) (Fin 2) ℚ) =
      !![1, (k : ℚ); 0, 1] := by
  induction k with
  | zero =>
    rw [pow_zero]
    change (1 : Matrix (Fin 2) (Fin 2) ℚ) = !![1, (0 : ℚ); 0, 1]
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  | succ k ih =>
    rw [pow_succ, Matrix.SpecialLinearGroup.coe_mul, ih]
    change !![1, (k : ℚ); 0, 1] * !![1, 1; 0, 1] = !![1, ((k + 1 : ℕ) : ℚ); 0, 1]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, Nat.cast_add, Nat.cast_one]; ring

/-- Quadratic relation for an element whose cube is `-1`. -/
private theorem quad_of_cube_eq_neg_one {D : Type} [DivisionRing D] {g : D}
    (h : g ^ 3 = -1) (hne : g ≠ -1) : g ^ 2 - g + 1 = 0 := by
  have hfactor : (g + 1) * (g ^ 2 - g + 1) = 0 := by
    have e : (g + 1) * (g ^ 2 - g + 1) = g ^ 3 + 1 := by noncomm_ring
    rw [e, h]
    exact neg_add_cancel 1
  rcases mul_eq_zero.mp hfactor with h1 | h1
  · exfalso
    apply hne
    have : g + 1 = 0 := h1
    exact eq_neg_of_add_eq_zero_left this
  · exact h1

/-- Quadratic relation for an element of order `3`. -/
private theorem quad_of_cube_eq_one {D : Type} [DivisionRing D] {g : D}
    (h : g ^ 3 = 1) (hne : g ≠ 1) : g ^ 2 + g + 1 = 0 := by
  have hfactor : (g - 1) * (g ^ 2 + g + 1) = 0 := by
    have e : (g - 1) * (g ^ 2 + g + 1) = g ^ 3 - 1 := by noncomm_ring
    rw [e, h, sub_self]
  rcases mul_eq_zero.mp hfactor with h1 | h1
  · exfalso
    apply hne
    exact eq_of_sub_eq_zero h1
  · exact h1

/-- The image of the central element `-I` is `-1` in the division ring. -/
private theorem neg_val {D : Type} [DivisionRing D]
    (f : Matrix.SpecialLinearGroup (Fin 2) ℚ →* Dˣ) (hf : Function.Injective f) :
    ((f elNeg : Dˣ) : D) = -1 := by
  have hsq : (f elNeg) ^ 2 = 1 := by
    rw [← map_pow, show elNeg ^ 2 = 1 from by
      apply Subtype.ext
      change (!![-1, 0; 0, -1] : Matrix (Fin 2) (Fin 2) ℚ) ^ 2 = 1
      ext i j
      fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]]
    exact map_one f
  have h2 : ((f elNeg : Dˣ) : D) ^ 2 = 1 := by
    have h := congrArg (fun u : Dˣ => (u : D)) hsq
    simpa using h
  have hne : ((f elNeg : Dˣ) : D) ≠ 1 := by
    intro hcon
    have : f elNeg = 1 := Units.ext hcon
    have : elNeg = 1 := hf (by rw [this, map_one])
    exact ne_neg_one this
  have hfactor : (((f elNeg : Dˣ) : D) - 1) * (((f elNeg : Dˣ) : D) + 1) = 0 := by
    have e : (((f elNeg : Dˣ) : D) - 1) * (((f elNeg : Dˣ) : D) + 1)
        = ((f elNeg : Dˣ) : D) ^ 2 - 1 := by noncomm_ring
    rw [e, h2, sub_self]
  rcases mul_eq_zero.mp hfactor with h1 | h1
  · exfalso
    exact hne (eq_of_sub_eq_zero h1)
  · exact eq_neg_of_add_eq_zero_left h1

/-- If `a * b = 1` in a division ring, then `a = b⁻¹`. -/
private theorem eq_inv_of_mul_eq_one {D : Type} [DivisionRing D] {a b : D}
    (hab : a * b = 1) : a = b⁻¹ := by
  have hb : b ≠ 0 := by
    intro hb0
    rw [hb0, mul_zero] at hab
    exact zero_ne_one hab
  calc a = a * (b * b⁻¹) := by rw [mul_inv_cancel₀ hb, mul_one]
    _ = (a * b) * b⁻¹ := by rw [mul_assoc]
    _ = 1 * b⁻¹ := by rw [hab]
    _ = b⁻¹ := one_mul _

/-- The trace identity: `x + x⁻¹ = y + y⁻¹` in the division ring. -/
private theorem trace_eq {D : Type} [DivisionRing D]
    (f : Matrix.SpecialLinearGroup (Fin 2) ℚ →* Dˣ) (hf : Function.Injective f) :
    ((f elU : Dˣ) : D) + ((f elU : Dˣ) : D)⁻¹
      = ((f elV : Dˣ) : D) + ((f elV : Dˣ) : D)⁻¹ := by
  have hWU : f elS * f elU * (f elS)⁻¹ = (f elV)⁻¹ := by
    have h := congrArg f id_S_U
    simpa [map_mul, map_inv] using h
  have hWV : f elS * f elV * (f elS)⁻¹ = (f elU)⁻¹ := by
    have h := congrArg f id_S_V
    simpa [map_mul, map_inv] using h
  have hWS : (f elS) ^ 2 = f elNeg := by
    have h := congrArg f id_S_sq
    simpa [map_pow] using h
  set x : D := ((f elU : Dˣ) : D) with hx
  set y : D := ((f elV : Dˣ) : D) with hy
  set w : D := ((f elS : Dˣ) : D) with hw
  have hx0 : x ≠ 0 := by rw [hx]; exact Units.ne_zero _
  have hy0 : y ≠ 0 := by rw [hy]; exact Units.ne_zero _
  have hw0 : w ≠ 0 := by rw [hw]; exact Units.ne_zero _
  have hw2 : w ^ 2 = -1 := by
    have h := congrArg (fun u : Dˣ => (u : D)) hWS
    rw [neg_val f hf] at h
    rw [hw]
    simpa using h
  have hwx : w * x * w⁻¹ = y⁻¹ := by
    have h := congrArg (fun u : Dˣ => (u : D)) hWU
    rw [hx, hy, hw]
    simpa using h
  have hwy : w * y * w⁻¹ = x⁻¹ := by
    have h := congrArg (fun u : Dˣ => (u : D)) hWV
    rw [hx, hy, hw]
    simpa using h
  have hexp1 : (w * x) ^ 2 = -(y⁻¹ * x) := by
    have hg : (f elS * f elU) ^ 2 = (f elV)⁻¹ * f elNeg * f elU := by
      rw [show (f elS * f elU) ^ 2
          = (f elS * f elU * (f elS)⁻¹) * (f elS) ^ 2 * f elU from by simp only [pow_two]; group]
      rw [hWU, hWS]
    have h := congrArg (fun u : Dˣ => (u : D)) hg
    rw [hx, hy, hw]
    simpa [neg_val f hf] using h
  have hexp2 : (w * x⁻¹) ^ 2 = -(y * x⁻¹) := by
    have hconj : f elS * (f elU)⁻¹ * (f elS)⁻¹ = f elV := by
      have e : f elS * (f elU)⁻¹ * (f elS)⁻¹
          = (f elS * f elU * (f elS)⁻¹)⁻¹ := by group
      rw [e, hWU, inv_inv]
    have hg : (f elS * (f elU)⁻¹) ^ 2 = f elV * f elNeg * (f elU)⁻¹ := by
      rw [show (f elS * (f elU)⁻¹) ^ 2
          = (f elS * (f elU)⁻¹ * (f elS)⁻¹) * (f elS) ^ 2 * (f elU)⁻¹ from by
            simp only [pow_two]; group]
      rw [hconj, hWS]
    have h := congrArg (fun u : Dˣ => (u : D)) hg
    rw [hx, hy, hw]
    simpa [neg_val f hf] using h
  have hcube1 : (w * x) ^ 3 = -1 := by
    have hu : (f elS * f elU) ^ 3 = f elNeg := by
      have h := congrArg f id_SU_cube
      simpa [map_pow] using h
    have h := congrArg (fun u : Dˣ => (u : D)) hu
    rw [hx, hw]
    simpa [neg_val f hf] using h
  have hcube2 : (w * x⁻¹) ^ 3 = 1 := by
    have hu : (f elS * (f elU)⁻¹) ^ 3 = 1 := by
      have h := congrArg f id_SUinv_cube
      simpa [map_pow, map_inv] using h
    have h := congrArg (fun u : Dˣ => (u : D)) hu
    rw [hx, hw]
    simpa using h
  have hne1 : w * x ≠ -1 := by
    intro hcon
    have hcoe : ((f (elS * elU) : Dˣ) : D) = w * x := by
      simp [map_mul, ← hx, ← hw]
    have hun : f (elS * elU) = f elNeg := by
      apply Units.ext_iff.mpr
      rw [hcoe, hcon, neg_val f hf]
    exact ne_SU_neg (hf hun)
  have hne2 : w * x⁻¹ ≠ 1 := by
    intro hcon
    have hcoe : ((f (elS * elU⁻¹) : Dˣ) : D) = w * x⁻¹ := by
      simp [map_mul, map_inv, ← hx, ← hw]
    have hun : f (elS * elU⁻¹) = 1 := by
      apply Units.ext_iff.mpr
      rw [hcoe, hcon]
      simp
    have : elS * elU⁻¹ = 1 := hf (by rw [hun, map_one])
    exact ne_SUinv_one this
  have hq6 := quad_of_cube_eq_neg_one hcube1 hne1
  have hq3 := quad_of_cube_eq_one hcube2 hne2
  have heq1 : w = x⁻¹ - y⁻¹ := by
    have h1 : (y⁻¹ + w) * x = 1 := by
      have h := hq6
      rw [hexp1] at h
      have key : y⁻¹ * x + w * x = 1 := by
        have h0 : (y⁻¹ * x + w * x) - 1 = 0 := by
          rw [show (y⁻¹ * x + w * x) - 1 = -(-(y⁻¹ * x) - w * x + 1) from by abel,
            h, neg_zero]
        exact sub_eq_zero.mp h0
      rw [add_mul]
      exact key
    have h2 : y⁻¹ + w = x⁻¹ := eq_inv_of_mul_eq_one h1
    rw [← h2]
    abel
  have heq2 : w = y - x := by
    have h1 : (y - w) * x⁻¹ = 1 := by
      have h := hq3
      rw [hexp2] at h
      have key : y * x⁻¹ - w * x⁻¹ = 1 := by
        have h0 : (y * x⁻¹ - w * x⁻¹) - 1 = 0 := by
          rw [show (y * x⁻¹ - w * x⁻¹) - 1 = -(-(y * x⁻¹) + w * x⁻¹ + 1) from by abel,
            h, neg_zero]
        exact sub_eq_zero.mp h0
      rw [sub_mul]
      exact key
    have h2 : y - w = (x⁻¹)⁻¹ := eq_inv_of_mul_eq_one h1
    rw [inv_inv] at h2
    rw [← h2]
    abel
  have h : x⁻¹ - y⁻¹ = y - x := heq1.symm.trans heq2
  have h0 : (x + x⁻¹) - (y + y⁻¹) = 0 := by
    rw [show (x + x⁻¹) - (y + y⁻¹) = (x⁻¹ - y⁻¹) - (y - x) from by abel, h, sub_self]
  exact sub_eq_zero.mp h0

/-- An element commutes with its inverse. -/
private theorem commute_inv_self {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0) :
    Commute a (a⁻¹) := by
  change a * a⁻¹ = a⁻¹ * a
  rw [mul_inv_cancel₀ ha, inv_mul_cancel₀ ha]

/-- An element commutes with `a + a⁻¹`. -/
private theorem commute_add_inv {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0) :
    Commute a (a + a⁻¹) := by
  change a * (a + a⁻¹) = (a + a⁻¹) * a
  rw [mul_add, add_mul, mul_inv_cancel₀ ha, inv_mul_cancel₀ ha]

/-- The `Z`-formula: `a + a⁻¹ - 2 = (a - 1)² / a`. -/
private theorem z_form {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0) :
    (a + a⁻¹) - 2 = (a - 1) ^ 2 * a⁻¹ := by
  have e1 : (a - 1) ^ 2 = a ^ 2 - 2 * a + 1 := by noncomm_ring
  have e2 : (a ^ 2 - 2 * a + 1) * a⁻¹ = a + a⁻¹ - 2 := by
    have h1 : a ^ 2 * a⁻¹ = a := by
      rw [pow_two, mul_assoc, mul_inv_cancel₀ ha, mul_one]
    have h2 : (2 * a) * a⁻¹ = 2 := by
      rw [mul_assoc, mul_inv_cancel₀ ha, mul_one]
    calc (a ^ 2 - 2 * a + 1) * a⁻¹
        = a ^ 2 * a⁻¹ - (2 * a) * a⁻¹ + 1 * a⁻¹ := by noncomm_ring
      _ = a - 2 + a⁻¹ := by rw [h1, h2, one_mul]
      _ = a + a⁻¹ - 2 := by abel
  rw [e1, e2]

/-- The ratio identity: the fourth-power ratio is `t² (t + 2)`. -/
private theorem rho_eq {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0) :
    (a ^ 4 - 1) ^ 2 * (a ^ 4)⁻¹
      = ((a - 1) ^ 2 * a⁻¹) * ((a + a⁻¹) ^ 2 * ((a + a⁻¹) + 2)) := by
  set t : D := a + a⁻¹ with ht
  have hca : Commute a t := commute_add_inv ha
  have hca_inv : Commute a (a⁻¹) := commute_inv_self ha
  have hfac : a ^ 3 + a ^ 2 + a + 1 = a * t * (a + 1) := by
    have hat : a * t = a ^ 2 + 1 := by
      rw [ht, mul_add, mul_inv_cancel₀ ha, ← pow_two]
    rw [hat]
    noncomm_ring
  have hfac4 : a ^ 4 - 1 = (a - 1) * (a ^ 3 + a ^ 2 + a + 1) := by noncomm_ring
  have hm1a : Commute (a - 1) a := by
    rw [sub_eq_add_neg]
    exact (Commute.refl a).add_left ((Commute.one_left a).neg_left)
  have hm1t : Commute (a - 1) t := by
    rw [sub_eq_add_neg]
    exact hca.add_left ((Commute.one_left t).neg_left)
  have hm1a1 : Commute (a - 1) (a + 1) := by
    have hA : Commute (a + 1) a := (Commute.refl a).add_left (Commute.one_left a)
    have hB : Commute (a + 1) (1 : D) := Commute.one_right _
    have hC : Commute (a + 1) (a - 1) := by
      rw [sub_eq_add_neg]
      exact hA.add_right hB.neg_right
    exact hC.symm
  have hcS : Commute (a - 1) (a ^ 3 + a ^ 2 + a + 1) := by
    rw [hfac]
    exact (hm1a.mul_right hm1t).mul_right hm1a1
  have hS_inv : Commute (a ^ 3 + a ^ 2 + a + 1) (a⁻¹) := by
    rw [hfac]
    have ht_inv : Commute t (a⁻¹) :=
      hca_inv.add_left (Commute.refl (a⁻¹))
    have h1_inv : Commute (a + 1) (a⁻¹) :=
      hca_inv.add_left (Commute.one_left (a⁻¹))
    exact (hca_inv.mul_left ht_inv).mul_left h1_inv
  have hcSwap : Commute ((a ^ 3 + a ^ 2 + a + 1) ^ 2) (a⁻¹) := hS_inv.pow_left 2
  have hstep : (a ^ 3 + a ^ 2 + a + 1) ^ 2 * (a ^ 3)⁻¹ = t ^ 2 * (t + 2) := by
    have ha1 : Commute a (a + 1) := (Commute.refl a).add_right (Commute.one_right a)
    have ht1 : Commute t (a + 1) := hca.symm.add_right (Commute.one_right t)
    have huv : Commute (a * t) (a + 1) := ha1.mul_left ht1
    have hv2 : (a + 1) ^ 2 = a * (t + 2) := by
      have e : (a + 1) ^ 2 = a ^ 2 + 2 * a + 1 := by noncomm_ring
      have hat : a * t = a ^ 2 + 1 := by
        rw [ht, mul_add, mul_inv_cancel₀ ha, ← pow_two]
      rw [e]
      calc a ^ 2 + 2 * a + 1 = (a ^ 2 + 1) + 2 * a := by abel
        _ = a * t + a * 2 := by rw [hat, two_mul, mul_two]
        _ = a * (t + 2) := (mul_add a t 2).symm
    calc (a ^ 3 + a ^ 2 + a + 1) ^ 2 * (a ^ 3)⁻¹
        = (a * t * (a + 1)) ^ 2 * (a ^ 3)⁻¹ := by rw [hfac]
      _ = ((a * t) ^ 2 * (a + 1) ^ 2) * (a ^ 3)⁻¹ := by
          rw [Commute.mul_pow huv 2]
      _ = (a ^ 2 * t ^ 2 * (a * (t + 2))) * (a ^ 3)⁻¹ := by
          rw [Commute.mul_pow hca 2, hv2]
      _ = (a ^ 3 * (t ^ 2 * (t + 2))) * (a ^ 3)⁻¹ := by
          have e1 : a ^ 2 * t ^ 2 * (a * (t + 2)) = a ^ 3 * (t ^ 2 * (t + 2)) := by
            have hc : Commute (t ^ 2) a := hca.symm.pow_left 2
            calc a ^ 2 * t ^ 2 * (a * (t + 2))
                = a ^ 2 * (t ^ 2 * a) * (t + 2) := by noncomm_ring
              _ = a ^ 2 * (a * t ^ 2) * (t + 2) := by rw [hc.eq]
              _ = a ^ 3 * (t ^ 2 * (t + 2)) := by noncomm_ring
          rw [e1]
      _ = t ^ 2 * (t + 2) := by
          have htwo : Commute (a ^ 3) (2 : D) := Commute.ofNat_right _ 2
          have hc : Commute (a ^ 3) (t ^ 2 * (t + 2)) :=
            (hca.pow_left 3 |>.pow_right 2).mul_right
              ((hca.pow_left 3).add_right htwo)
          calc (a ^ 3 * (t ^ 2 * (t + 2))) * (a ^ 3)⁻¹
              = ((t ^ 2 * (t + 2)) * (a ^ 3)) * (a ^ 3)⁻¹ := by rw [hc.eq]
            _ = (t ^ 2 * (t + 2)) * ((a ^ 3) * (a ^ 3)⁻¹) := by rw [mul_assoc]
            _ = t ^ 2 * (t + 2) := by
                rw [mul_inv_cancel₀ (pow_ne_zero 3 ha), mul_one]
  have h4inv : (a ^ 4)⁻¹ = a⁻¹ * (a ^ 3)⁻¹ := by
    rw [pow_succ, _root_.mul_inv_rev]
  calc (a ^ 4 - 1) ^ 2 * (a ^ 4)⁻¹
      = ((a - 1) * (a ^ 3 + a ^ 2 + a + 1)) ^ 2 * (a⁻¹ * (a ^ 3)⁻¹) := by
        rw [hfac4, h4inv]
    _ = ((a - 1) ^ 2 * (a ^ 3 + a ^ 2 + a + 1) ^ 2) * (a⁻¹ * (a ^ 3)⁻¹) := by
        rw [Commute.mul_pow hcS 2]
    _ = ((a - 1) ^ 2 * a⁻¹) * ((a ^ 3 + a ^ 2 + a + 1) ^ 2 * (a ^ 3)⁻¹) :=
        Commute.mul_mul_mul_comm hcSwap _ _
    _ = ((a - 1) ^ 2 * a⁻¹) * (t ^ 2 * (t + 2)) := by rw [hstep]

/-- Additive regrouping with `1 + 1 = 2`. -/
private theorem add_one_one {D : Type} [DivisionRing D] (x y : D) :
    x + 1 + (1 + y) = x + 2 + y := by
  calc x + 1 + (1 + y) = x + ((1 + 1) + y) := by
        rw [add_assoc, ← add_assoc (1 : D) 1 y]
    _ = x + (2 + y) := by rw [one_add_one_eq_two]
    _ = x + 2 + y := by rw [← add_assoc]

/-- Squaring `a + a⁻¹`. -/
private theorem sq_add_inv {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0) :
    (a + a⁻¹) ^ 2 = a ^ 2 + 2 + (a ^ 2)⁻¹ := by
  rw [pow_two]
  rw [show (a + a⁻¹) * (a + a⁻¹)
      = a * a + a * a⁻¹ + (a⁻¹ * a + a⁻¹ * a⁻¹) from by noncomm_ring]
  rw [mul_inv_cancel₀ ha, inv_mul_cancel₀ ha, ← pow_two a, ← pow_two a⁻¹, inv_pow]
  exact add_one_one (a ^ 2) ((a ^ 2)⁻¹)

/-- The Chebyshev identity `T⁴ - 4T² + 2 = a⁴ + a⁻⁴` for `T = a + a⁻¹`. -/
private theorem cheb4 {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0) :
    (a + a⁻¹) ^ 4 - 4 * (a + a⁻¹) ^ 2 + 2 = a ^ 4 + (a ^ 4)⁻¹ := by
  have ht2 : (a + a⁻¹) ^ 2 = a ^ 2 + 2 + (a ^ 2)⁻¹ := sq_add_inv ha
  have hb0 : (a ^ 2 : D) ≠ 0 := pow_ne_zero 2 ha
  have hbc : (a ^ 2) * (a ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hb0
  have hcb : (a ^ 2)⁻¹ * (a ^ 2) = 1 := inv_mul_cancel₀ hb0
  have e1 : ((a + a⁻¹) ^ 2 - 2) ^ 2
      = (a + a⁻¹) ^ 4 - 4 * (a + a⁻¹) ^ 2 + 4 := by
    have h := congrArg (Polynomial.aeval (a + a⁻¹))
      (show ((Polynomial.X ^ 2 - 2) ^ 2 : Polynomial ℤ)
          = Polynomial.X ^ 4 - 4 * Polynomial.X ^ 2 + 4 from by ring)
    simpa [map_pow, map_sub, map_mul, map_ofNat, Polynomial.aeval_X] using h
  have e2 : ((a + a⁻¹) ^ 2 - 2) ^ 2
      = (a ^ 2) ^ 2 + ((a ^ 2)⁻¹) ^ 2 + 2 := by
    have hsub : (a + a⁻¹) ^ 2 - 2 = a ^ 2 + (a ^ 2)⁻¹ := by
      rw [ht2]
      abel
    rw [hsub]
    have hexp : (a ^ 2 + (a ^ 2)⁻¹) ^ 2
        = (a ^ 2) ^ 2 + ((a ^ 2)⁻¹) ^ 2 + 2 := by
      rw [pow_two]
      rw [show (a ^ 2 + (a ^ 2)⁻¹) * (a ^ 2 + (a ^ 2)⁻¹)
          = a ^ 2 * a ^ 2 + a ^ 2 * (a ^ 2)⁻¹
            + ((a ^ 2)⁻¹ * a ^ 2 + (a ^ 2)⁻¹ * (a ^ 2)⁻¹) from by noncomm_ring]
      rw [hbc, hcb, ← pow_two (a ^ 2), ← pow_two ((a ^ 2)⁻¹)]
      rw [show (a ^ 2) ^ 2 + ((a ^ 2)⁻¹) ^ 2 + 2
          = (a ^ 2) ^ 2 + 2 + ((a ^ 2)⁻¹) ^ 2 from by
        rw [add_assoc, add_comm (((a ^ 2)⁻¹) ^ 2) (2 : D), ← add_assoc]]
      exact add_one_one ((a ^ 2) ^ 2) (((a ^ 2)⁻¹) ^ 2)
    exact hexp
  have hb2 : (a ^ 2) ^ 2 = a ^ 4 := by rw [← pow_mul]
  have hc2 : ((a ^ 2)⁻¹) ^ 2 = (a ^ 4)⁻¹ := by
    rw [inv_pow, ← pow_mul]
  have hfinal : (a + a⁻¹) ^ 4 - 4 * (a + a⁻¹) ^ 2 + 2
      = (a ^ 2) ^ 2 + ((a ^ 2)⁻¹) ^ 2 := by
    have h := congrArg (· - 2) (e1.symm.trans e2)
    rw [show (a + a⁻¹) ^ 4 - 4 * (a + a⁻¹) ^ 2 + 4 - 2
        = (a + a⁻¹) ^ 4 - 4 * (a + a⁻¹) ^ 2 + 2 from by
        rw [add_sub_assoc, show (4 : D) - 2 = 2 from by norm_num],
      show (a ^ 2) ^ 2 + ((a ^ 2)⁻¹) ^ 2 + 2 - 2 = (a ^ 2) ^ 2 + ((a ^ 2)⁻¹) ^ 2 from by
        rw [add_sub_cancel_right]] at h
    exact h
  rw [hfinal, hb2, hc2]

private theorem id_Hinv_V : elH⁻¹ * elV * elH = elV ^ 4 := by
  apply Subtype.ext
  change (Matrix.adjugate !![2, 0; 0, 1 / 2] * !![1, 0; 1, 1] : Matrix (Fin 2) (Fin 2) ℚ) *
      !![2, 0; 0, 1 / 2] = !![1, 0; 1, 1] ^ 4
  rw [Matrix.adjugate_fin_two_of]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]; norm_num

/-- Conjugation distributes over multiplication. -/
private theorem conj_mul {D : Type} [DivisionRing D] {u a b : D} (hu : u ≠ 0) :
    u * (a * b) * u⁻¹ = (u * a * u⁻¹) * (u * b * u⁻¹) := by
  calc u * (a * b) * u⁻¹ = u * a * b * u⁻¹ := by noncomm_ring
    _ = u * a * ((u⁻¹ * u) * b) * u⁻¹ := by rw [inv_mul_cancel₀ hu, one_mul]
    _ = (u * a * u⁻¹) * (u * b * u⁻¹) := by noncomm_ring

/-- Conjugation distributes over addition. -/
private theorem conj_add {D : Type} [DivisionRing D] {u a b : D} :
    u * (a + b) * u⁻¹ = u * a * u⁻¹ + u * b * u⁻¹ := by noncomm_ring

/-- Conjugation distributes over subtraction. -/
private theorem conj_sub {D : Type} [DivisionRing D] {u a b : D} :
    u * (a - b) * u⁻¹ = u * a * u⁻¹ - u * b * u⁻¹ := by noncomm_ring

/-- Conjugation fixes the scalar `2`. -/
private theorem conj_two {D : Type} [DivisionRing D] {u : D} (hu : u ≠ 0) :
    u * (2 : D) * u⁻¹ = 2 := by
  calc u * (2 : D) * u⁻¹ = (2 : D) * (u * u⁻¹) := by
        rw [show u * (2 : D) = (2 : D) * u from by rw [mul_two, two_mul], mul_assoc]
    _ = 2 := by rw [mul_inv_cancel₀ hu, mul_one]

/-- The forward rho identity: conjugating `Z` by `d` multiplies it by `P(t)`. -/
private theorem rho_forward {D : Type} [DivisionRing D] {a d : D} (ha : a ≠ 0) (hd : d ≠ 0)
    (h_a : d * a * d⁻¹ = a ^ 4) (h_ai : d * a⁻¹ * d⁻¹ = (a ^ 4)⁻¹) :
    d * ((a + a⁻¹) - 2) * d⁻¹
      = ((a + a⁻¹) - 2) * ((a + a⁻¹) ^ 2 * ((a + a⁻¹) + 2)) := by
  have e1 : d * ((a + a⁻¹) - 2) * d⁻¹ = (d * (a + a⁻¹) * d⁻¹) - 2 := by
    rw [conj_sub, conj_two hd]
  have e2 : d * (a + a⁻¹) * d⁻¹ = a ^ 4 + (a ^ 4)⁻¹ := by
    rw [conj_add, h_a, h_ai]
  have e3 : (a ^ 4 + (a ^ 4)⁻¹) - 2 = (a ^ 4 - 1) ^ 2 * (a ^ 4)⁻¹ :=
    z_form (pow_ne_zero 4 ha)
  have e4 : (a ^ 4 - 1) ^ 2 * (a ^ 4)⁻¹
      = ((a - 1) ^ 2 * a⁻¹) * ((a + a⁻¹) ^ 2 * ((a + a⁻¹) + 2)) := rho_eq ha
  have e5 : (a - 1) ^ 2 * a⁻¹ = (a + a⁻¹) - 2 := (z_form ha).symm
  rw [e1, e2, e3, e4, e5]

/-- Conjugation by an inverse distributes over addition. -/
private theorem conj_add_inv {D : Type} [DivisionRing D] {u a b : D} :
    u⁻¹ * (a + b) * u = u⁻¹ * a * u + u⁻¹ * b * u := by noncomm_ring

/-- Conjugation by an inverse distributes over subtraction. -/
private theorem conj_sub_inv {D : Type} [DivisionRing D] {u a b : D} :
    u⁻¹ * (a - b) * u = u⁻¹ * a * u - u⁻¹ * b * u := by noncomm_ring

/-- Conjugation by an inverse fixes the scalar `2`. -/
private theorem conj_two_inv {D : Type} [DivisionRing D] {u : D} (hu : u ≠ 0) :
    u⁻¹ * (2 : D) * u = 2 := by
  calc u⁻¹ * (2 : D) * u = (2 : D) * (u⁻¹ * u) := by
        rw [show u⁻¹ * (2 : D) = (2 : D) * u⁻¹ from by rw [mul_two, two_mul], mul_assoc]
    _ = 2 := by rw [inv_mul_cancel₀ hu, mul_one]

/-- Conjugation of the polynomial `P(t) = t² (t + 2)`. -/
private theorem conj_Pp {D : Type} [DivisionRing D] {u t : D} (hu : u ≠ 0) :
    u * (t ^ 2 * (t + 2)) * u⁻¹ = (u * t * u⁻¹) ^ 2 * ((u * t * u⁻¹) + 2) := by
  have h2 : u * t ^ 2 * u⁻¹ = (u * t * u⁻¹) ^ 2 := by
    calc u * t ^ 2 * u⁻¹ = (u * t * u⁻¹) * (u * t * u⁻¹) := by
          rw [pow_two]
          exact conj_mul hu
      _ = (u * t * u⁻¹) ^ 2 := by rw [← pow_two]
  have h3 : u * (t + 2) * u⁻¹ = (u * t * u⁻¹) + 2 := by
    rw [conj_add, conj_two hu]
  rw [conj_mul hu, h2, h3]

private theorem ne_V_one : elV ≠ 1 := by
  intro h
  have h2 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
    (A : Matrix (Fin 2) (Fin 2) ℚ) 1 0) h
  simp [elV] at h2

private theorem ne_R_one : elR ≠ 1 := by
  intro h
  have h2 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
    (A : Matrix (Fin 2) (Fin 2) ℚ) 0 1) h
  simp [elR] at h2

/-- A positive power of the image of `U` is never `1`. -/
private theorem pow_x_ne_one {D : Type} [DivisionRing D]
    (f : Matrix.SpecialLinearGroup (Fin 2) ℚ →* Dˣ) (hf : Function.Injective f)
    {k : ℕ} (hk : 0 < k) : ((f elU : Dˣ) : D) ^ k ≠ 1 := by
  intro hcon
  have hu : f (elU ^ k) = 1 := by
    apply Units.ext_iff.mpr
    rw [Units.val_one]
    have h2 : ((f (elU ^ k) : Dˣ) : D) = ((f elU : Dˣ) : D) ^ k := by simp [map_pow]
    rw [h2]
    exact hcon
  have hG : elU ^ k = 1 := hf (by rw [hu, map_one])
  have hk0 : k = 0 := by
    have h3 := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) ℚ =>
      (A : Matrix (Fin 2) (Fin 2) ℚ) 0 1) hG
    rw [elU_pow_mat, Matrix.SpecialLinearGroup.coe_one] at h3
    simpa using h3
  omega

/-- Conjugation commutes with powers. -/
private theorem conj_pow_aux {G : Type} [Group G] (u g : G) (k : ℕ) :
    u * g ^ k * u⁻¹ = (u * g * u⁻¹) ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
    calc u * g ^ (k + 1) * u⁻¹ = (u * g ^ k * u⁻¹) * (u * g * u⁻¹) := by
          rw [pow_succ]
          group
      _ = (u * g * u⁻¹) ^ k * (u * g * u⁻¹) := by rw [ih]
      _ = (u * g * u⁻¹) ^ (k + 1) := by rw [pow_succ]

/-- The polynomial `P(t) = t² (t + 2)`. -/
private noncomputable def ppPoly : Polynomial ℤ :=
  Polynomial.X * Polynomial.X * (Polynomial.X + Polynomial.C 2)

/-- The Chebyshev polynomial `X⁴ - 4X² + 2`. -/
private noncomputable def chebPoly : Polynomial ℤ :=
  Polynomial.X ^ 4 - Polynomial.C 4 * Polynomial.X ^ 2 + Polynomial.C 2

/-- The degree-15 polynomial whose roots are the conjugates of `T`. -/
private noncomputable def fPoly : Polynomial ℤ := ppPoly * (ppPoly.comp chebPoly) - 1

private theorem ppPoly_monic : ppPoly.Monic := by
  unfold ppPoly
  exact (Polynomial.monic_X.mul Polynomial.monic_X).mul (Polynomial.monic_X_add_C 2)

private theorem ppPoly_natDegree : ppPoly.natDegree = 3 := by
  unfold ppPoly
  rw [Polynomial.natDegree_mul (by exact (Polynomial.monic_X.mul Polynomial.monic_X).ne_zero)
    (by exact (Polynomial.monic_X_add_C 2).ne_zero),
    Polynomial.natDegree_mul Polynomial.monic_X.ne_zero Polynomial.monic_X.ne_zero,
    Polynomial.natDegree_X, Polynomial.natDegree_X_add_C]

private theorem chebPoly_monic : chebPoly.Monic := by
  have h1 : ((Polynomial.X : Polynomial ℤ) ^ 4 - Polynomial.C 4 * Polynomial.X ^ 2).Monic := by
    apply Polynomial.Monic.sub_of_left (Polynomial.monic_X_pow 4)
    have hdeg : (Polynomial.C 4 * Polynomial.X ^ 2 : Polynomial ℤ).degree = 2 := by
      rw [Polynomial.degree_C_mul_X_pow 2 (by norm_num : (4 : ℤ) ≠ 0)]
      norm_num
    rw [hdeg, Polynomial.degree_X_pow 4]
    norm_num
  have h2 : chebPoly.Monic := by
    unfold chebPoly
    apply Polynomial.Monic.add_of_left h1
    have hdeg : ((Polynomial.X : Polynomial ℤ) ^ 4
        - Polynomial.C 4 * Polynomial.X ^ 2).degree = 4 := by
      rw [Polynomial.degree_sub_eq_left_of_degree_lt]
      · exact Polynomial.degree_X_pow 4
      · have hd : (Polynomial.C 4 * Polynomial.X ^ 2 : Polynomial ℤ).degree = 2 := by
          rw [Polynomial.degree_C_mul_X_pow 2 (by norm_num : (4 : ℤ) ≠ 0)]
          norm_num
        rw [hd, Polynomial.degree_X_pow 4]
        norm_num
    rw [hdeg]
    exact lt_of_le_of_lt Polynomial.degree_C_le (by norm_num)
  exact h2

private theorem chebPoly_natDegree : chebPoly.natDegree = 4 := by
  have h1 : ((Polynomial.X : Polynomial ℤ) ^ 4
      - Polynomial.C 4 * Polynomial.X ^ 2).natDegree = 4 := by
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
    · exact Polynomial.natDegree_X_pow 4
    · rw [Polynomial.natDegree_mul (by norm_num : (Polynomial.C 4 : Polynomial ℤ) ≠ 0)
        (Polynomial.monic_X_pow 2).ne_zero, Polynomial.natDegree_C,
        Polynomial.natDegree_X_pow 2, Polynomial.natDegree_X_pow 4]
      norm_num
  unfold chebPoly
  rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt]
  · exact h1
  · rw [Polynomial.natDegree_C, h1]
    norm_num

private theorem fPoly_monic : fPoly.Monic := by
  unfold fPoly
  apply Polynomial.Monic.sub_of_left
  · exact ppPoly_monic.mul
      (ppPoly_monic.comp chebPoly_monic (by rw [chebPoly_natDegree]; norm_num))
  · rw [Polynomial.degree_one]
    have hdeg : (ppPoly * ppPoly.comp chebPoly : Polynomial ℤ).degree
        = (ppPoly * ppPoly.comp chebPoly).natDegree := by
      rw [Polynomial.degree_eq_natDegree]
      exact (ppPoly_monic.mul
        (ppPoly_monic.comp chebPoly_monic (by rw [chebPoly_natDegree]; norm_num))).ne_zero
    rw [hdeg]
    rw [Polynomial.natDegree_mul ppPoly_monic.ne_zero
      (ppPoly_monic.comp chebPoly_monic (by rw [chebPoly_natDegree]; norm_num)).ne_zero,
      ppPoly_natDegree, Polynomial.natDegree_comp, ppPoly_natDegree, chebPoly_natDegree]
    norm_num

private theorem fPoly_natDegree : fPoly.natDegree = 15 := by
  have hprod : (ppPoly * ppPoly.comp chebPoly : Polynomial ℤ).natDegree = 15 := by
    rw [Polynomial.natDegree_mul ppPoly_monic.ne_zero
      (ppPoly_monic.comp chebPoly_monic (by rw [chebPoly_natDegree]; norm_num)).ne_zero,
      Polynomial.natDegree_comp, ppPoly_natDegree, chebPoly_natDegree]
  unfold fPoly
  rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
  · exact hprod
  · rw [Polynomial.natDegree_one, hprod]
    norm_num

/-- The commutative ring structure on the subalgebra generated by one element,
given that its elements commute. -/
@[instance_reducible]
private def commRingAdjoin {D : Type} [DivisionRing D] (T : D)
    (hS : ∀ a b : (Algebra.adjoin ℤ {T} : Subalgebra ℤ D),
      (a : D) * (b : D) = (b : D) * (a : D)) :
    CommRing (Algebra.adjoin ℤ {T}) where
  __ := (Algebra.adjoin ℤ {T}).toRing
  __ : CommSemiring (Algebra.adjoin ℤ {T}) :=
    { (Algebra.adjoin ℤ {T}).toSemiring with
      mul_comm := fun a b => Subtype.ext (hS a b) }

/-- Distinctness of the values `a^p + a⁻ᵖ` for distinct exponents. -/
private theorem pow_add_inv_injective {D : Type} [DivisionRing D] {a : D} (ha : a ≠ 0)
    (hne : ∀ k : ℕ, 0 < k → a ^ k ≠ 1) {p q : ℕ} (hpq : p < q) :
    a ^ p + (a ^ p)⁻¹ ≠ a ^ q + (a ^ q)⁻¹ := by
  intro hcon
  obtain ⟨r, hr, hrpos⟩ : ∃ r, q = p + r ∧ 0 < r := ⟨q - p, by omega, by omega⟩
  rw [hr, pow_add] at hcon
  have hcomm1 : Commute (a ^ p) ((a ^ r)⁻¹) := by
    have h : Commute (a ^ p) ((a⁻¹) ^ r) :=
      (commute_inv_self ha).pow_left p |>.pow_right r
    rwa [inv_pow] at h
  have e1 : (a ^ p + (a ^ p)⁻¹) * a ^ p = (a ^ p) ^ 2 + 1 := by
    rw [add_mul, inv_mul_cancel₀ (pow_ne_zero p ha), ← pow_two]
  have e2 : (a ^ p * a ^ r + (a ^ p * a ^ r)⁻¹) * a ^ p
      = (a ^ p) ^ 2 * a ^ r + (a ^ r)⁻¹ := by
    rw [add_mul]
    congr 1
    · have hc : Commute (a ^ r) (a ^ p) := (Commute.refl a).pow_pow r p
      calc (a ^ p * a ^ r) * a ^ p = (a ^ p) * ((a ^ r) * (a ^ p)) := by noncomm_ring
        _ = (a ^ p) * ((a ^ p) * (a ^ r)) := by rw [hc.eq]
        _ = (a ^ p) ^ 2 * a ^ r := by
            rw [pow_two]
            noncomm_ring
    · rw [_root_.mul_inv_rev, mul_assoc, inv_mul_cancel₀ (pow_ne_zero p ha), mul_one]
  have hmul := congrArg (· * a ^ p) hcon
  rw [e1, e2] at hmul
  have hEq : (a ^ p) ^ 2 + 1 = (a ^ p) ^ 2 * a ^ r + (a ^ r)⁻¹ := hmul
  have hkey : (a ^ p) ^ 2 * (a ^ r - 1) = (a ^ r - 1) * (a ^ r)⁻¹ := by
    have e : (a ^ p) ^ 2 * (a ^ r - 1) = (a ^ p) ^ 2 * a ^ r - (a ^ p) ^ 2 := by
      rw [mul_sub, mul_one]
    have e' : (a ^ r - 1) * (a ^ r)⁻¹ = 1 - (a ^ r)⁻¹ := by
      rw [sub_mul, one_mul, mul_inv_cancel₀ (pow_ne_zero r ha)]
    have hEq2 : (a ^ p) ^ 2 * a ^ r = (a ^ p) ^ 2 + 1 - (a ^ r)⁻¹ := by
      calc (a ^ p) ^ 2 * a ^ r
          = ((a ^ p) ^ 2 * a ^ r + (a ^ r)⁻¹) - (a ^ r)⁻¹ := by rw [add_sub_cancel_right]
        _ = (a ^ p) ^ 2 + 1 - (a ^ r)⁻¹ := by rw [hEq.symm]
    rw [e, e', hEq2]
    abel
  have hne_r1 : a ^ r - 1 ≠ 0 := sub_ne_zero.mpr (hne r hrpos)
  have hcommS : Commute ((a ^ p) ^ 2) (a ^ r - 1) := by
    have h1 : Commute ((a ^ p) ^ 2) (a ^ r) :=
      ((Commute.refl a).pow_left p |>.pow_right r).pow_left 2
    exact h1.sub_right (Commute.one_right _)
  have hcancel : (a ^ p) ^ 2 = (a ^ r)⁻¹ := by
    have e : (a ^ r - 1) * (a ^ p) ^ 2 = (a ^ r - 1) * (a ^ r)⁻¹ := by
      rw [← hcommS.eq]
      exact hkey
    exact mul_left_cancel₀ hne_r1 e
  have hpow : a ^ (2 * p + r) = 1 := by
    have h1 : (a ^ p) ^ 2 * a ^ r = 1 := by
      rw [hcancel, inv_mul_cancel₀ (pow_ne_zero r ha)]
    have h2 : (a ^ p) ^ 2 * a ^ r = a ^ (2 * p + r) := by
      rw [← pow_mul, ← pow_add, show p * 2 + r = 2 * p + r from by ring]
    rw [← h2]
    exact h1
  exact hne (2 * p + r) (by omega) hpow

/-- The sequence `u, u⁴, u¹⁶, …` of powers. -/
private def powSeq {G : Type} [Group G] (u : G) (n : ℕ) : G := u ^ (4 ^ n)

/-- The sequence of conjugates `dⁿ t d⁻ⁿ`. -/
private def conjSeq {D : Type} [DivisionRing D] (d t : D) (n : ℕ) : D :=
  d ^ n * t * (d ^ n)⁻¹

private theorem powSeq_succ {G : Type} [Group G] (u : G) (n : ℕ) :
    powSeq u (n + 1) = (powSeq u n) ^ 4 := by
  change u ^ (4 ^ (n + 1)) = (u ^ (4 ^ n)) ^ 4
  rw [pow_succ, pow_mul]

private theorem powSeq_zero {G : Type} [Group G] (u : G) : powSeq u 0 = u := by
  simp [powSeq]

/-- The root rho identity: conjugating `Z` by `d⁻¹` divides it by `P(t_r)`. -/
private theorem rho_root {D : Type} [DivisionRing D] {a r d : D} (ha : a ≠ 0) (hr : r ≠ 0)
    (hd : d ≠ 0) (hZ : (a + a⁻¹) - 2 ≠ 0)
    (h_r : d⁻¹ * (a + a⁻¹) * d = r + r⁻¹) (h_r4 : r ^ 4 = a) :
    d⁻¹ * ((a + a⁻¹) - 2) * d
      = ((a + a⁻¹) - 2) * ((r + r⁻¹) ^ 2 * ((r + r⁻¹) + 2))⁻¹ := by
  have e1 : d⁻¹ * ((a + a⁻¹) - 2) * d = (r + r⁻¹) - 2 := by
    rw [conj_sub_inv, h_r, conj_two_inv hd]
  have e2 : (r + r⁻¹) - 2 = (r - 1) ^ 2 * r⁻¹ := z_form hr
  have e3 : (a + a⁻¹) - 2
      = ((r - 1) ^ 2 * r⁻¹) * ((r + r⁻¹) ^ 2 * ((r + r⁻¹) + 2)) := by
    have h := rho_eq hr
    rw [h_r4] at h
    exact (z_form ha).trans h
  have hPp_ne : (r + r⁻¹) ^ 2 * ((r + r⁻¹) + 2) ≠ 0 := by
    intro hcon
    have h0 : (a + a⁻¹) - 2 = 0 := by rw [e3, hcon, mul_zero]
    exact hZ h0
  calc d⁻¹ * ((a + a⁻¹) - 2) * d = (r + r⁻¹) - 2 := e1
    _ = (r - 1) ^ 2 * r⁻¹ := e2
    _ = ((a + a⁻¹) - 2) * ((r + r⁻¹) ^ 2 * ((r + r⁻¹) + 2))⁻¹ := by
        rw [e3, mul_assoc, mul_inv_cancel₀ hPp_ne, mul_one]


/-- The main impossibility: no injective homomorphism `SL(2, ℚ) → Dˣ` exists. -/
private theorem no_embedding {D : Type} [DivisionRing D]
    (f : Matrix.SpecialLinearGroup (Fin 2) ℚ →* Dˣ) (hf : Function.Injective f) :
    False := by
  have hWU : f elS * f elU * (f elS)⁻¹ = (f elV)⁻¹ := by
    have h := congrArg f id_S_U
    simpa [map_mul, map_inv] using h
  have hWV : f elS * f elV * (f elS)⁻¹ = (f elU)⁻¹ := by
    have h := congrArg f id_S_V
    simpa [map_mul, map_inv] using h
  have hWS : (f elS) ^ 2 = f elNeg := by
    have h := congrArg f id_S_sq
    simpa [map_pow] using h
  have hHU : f elH * f elU * (f elH)⁻¹ = (f elU) ^ 4 := by
    have h := congrArg f id_H_U
    simpa [map_mul, map_inv, map_pow] using h
  have hHV : f elH * f elV * (f elH)⁻¹ = f elC := by
    have h := congrArg f id_H_V
    simpa [map_mul, map_inv] using h
  have hHinvU : (f elH)⁻¹ * f elU * f elH = f elR := by
    have h := congrArg f id_Hinv_U
    simpa [map_mul, map_inv] using h
  have hHinvV : (f elH)⁻¹ * f elV * f elH = (f elV) ^ 4 := by
    have h := congrArg f id_Hinv_V
    simpa [map_mul, map_inv, map_pow] using h
  have hSH : f elS * f elH * (f elS)⁻¹ = (f elH)⁻¹ := by
    have h := congrArg f id_S_H
    simpa [map_mul, map_inv] using h
  have hRpow : (f elR) ^ 4 = f elU := by
    have h := congrArg f id_R_pow
    simpa [map_pow] using h
  have hCpow : (f elC) ^ 4 = f elV := by
    have h := congrArg f id_C_pow
    simpa [map_pow] using h
  set x : D := ((f elU : Dˣ) : D) with hx
  set y : D := ((f elV : Dˣ) : D) with hy
  set w : D := ((f elS : Dˣ) : D) with hw
  set dd : D := ((f elH : Dˣ) : D) with hd
  set rr : D := ((f elR : Dˣ) : D) with hr
  set cc : D := ((f elC : Dˣ) : D) with hc
  have hx0 : x ≠ 0 := by rw [hx]; exact Units.ne_zero _
  have hy0 : y ≠ 0 := by rw [hy]; exact Units.ne_zero _
  have hw0 : w ≠ 0 := by rw [hw]; exact Units.ne_zero _
  have hd0 : dd ≠ 0 := by rw [hd]; exact Units.ne_zero _
  have hr0 : rr ≠ 0 := by rw [hr]; exact Units.ne_zero _
  have hc0 : cc ≠ 0 := by rw [hc]; exact Units.ne_zero _
  have hconj_x : dd * x * dd⁻¹ = x ^ 4 := by
    have h := congrArg (fun u : Dˣ => (u : D)) hHU
    rw [hx, hd]
    simpa using h
  have hconj_y : dd * y * dd⁻¹ = cc := by
    have h := congrArg (fun u : Dˣ => (u : D)) hHV
    rw [hy, hc, hd]
    simpa using h
  have hconj_xr : dd⁻¹ * x * dd = rr := by
    have h := congrArg (fun u : Dˣ => (u : D)) hHinvU
    rw [hx, hr, hd]
    simpa using h
  have hconj_y4 : dd⁻¹ * y * dd = y ^ 4 := by
    have h := congrArg (fun u : Dˣ => (u : D)) hHinvV
    rw [hy, hd]
    simpa using h
  have hconj_w_dd : w * dd * w⁻¹ = dd⁻¹ := by
    have h := congrArg (fun u : Dˣ => (u : D)) hSH
    rw [hw, hd]
    simpa using h
  have hconj_rr : rr ^ 4 = x := by
    have h := congrArg (fun u : Dˣ => (u : D)) hRpow
    rw [hr, hx]
    simpa using h
  have hconj_cc : cc ^ 4 = y := by
    have h := congrArg (fun u : Dˣ => (u : D)) hCpow
    rw [hc, hy]
    simpa using h
  have hconj_xinv : dd * x⁻¹ * dd⁻¹ = (x ^ 4)⁻¹ := by
    have e : (dd * x * dd⁻¹)⁻¹ = dd * x⁻¹ * dd⁻¹ := by simp [_root_.mul_inv_rev, mul_assoc]
    rw [hconj_x] at e
    exact e.symm
  have hconj_yinv : dd * y⁻¹ * dd⁻¹ = cc⁻¹ := by
    have e : (dd * y * dd⁻¹)⁻¹ = dd * y⁻¹ * dd⁻¹ := by simp [_root_.mul_inv_rev, mul_assoc]
    rw [hconj_y] at e
    exact e.symm
  have hconj_xinv_r : dd⁻¹ * x⁻¹ * dd = rr⁻¹ := by
    have e : (dd⁻¹ * x * dd)⁻¹ = dd⁻¹ * x⁻¹ * dd := by simp [_root_.mul_inv_rev, mul_assoc]
    rw [hconj_xr] at e
    exact e.symm
  have hconj_yinv4 : dd⁻¹ * y⁻¹ * dd = (y ^ 4)⁻¹ := by
    have e : (dd⁻¹ * y * dd)⁻¹ = dd⁻¹ * y⁻¹ * dd := by simp [_root_.mul_inv_rev, mul_assoc]
    rw [hconj_y4] at e
    exact e.symm
  have hwx : w * x * w⁻¹ = y⁻¹ := by
    have h := congrArg (fun u : Dˣ => (u : D)) hWU
    rw [hx, hy, hw]
    simpa using h
  have hwx_inv : w * x⁻¹ * w⁻¹ = y := by
    have e : (w * x * w⁻¹)⁻¹ = w * x⁻¹ * w⁻¹ := by simp [_root_.mul_inv_rev, mul_assoc]
    rw [hwx] at e
    rw [inv_inv] at e
    exact e.symm
  set T : D := x + x⁻¹ with hTdef
  have hTy : T = y + y⁻¹ := by
    rw [hTdef]
    exact trace_eq f hf
  set Z : D := T - 2 with hZdef
  have hxne1 : x ≠ 1 := by
    intro hcon
    have h1 : f elU = 1 := by
      have h2 : ((f elU : Dˣ) : D) = 1 := hcon
      exact Units.ext_iff.mpr (by rw [Units.val_one]; exact h2)
    exact ne_U_one (hf (by rw [h1, map_one]))
  have hyne1 : y ≠ 1 := by
    intro hcon
    have h1 : f elV = 1 := by
      have h2 : ((f elV : Dˣ) : D) = 1 := hcon
      exact Units.ext_iff.mpr (by rw [Units.val_one]; exact h2)
    exact ne_V_one (hf (by rw [h1, map_one]))
  have hrne1 : rr ≠ 1 := by
    intro hcon
    have h1 : f elR = 1 := by
      have h2 : ((f elR : Dˣ) : D) = 1 := hcon
      exact Units.ext_iff.mpr (by rw [Units.val_one]; exact h2)
    exact ne_R_one (hf (by rw [h1, map_one]))
  have hZne : Z ≠ 0 := by
    rw [hZdef, hTdef, z_form hx0]
    exact mul_ne_zero (pow_ne_zero 2 (sub_ne_zero.mpr hxne1)) (inv_ne_zero hx0)
  have hTdd : dd * T * dd⁻¹ = x ^ 4 + (x ^ 4)⁻¹ := by
    rw [hTdef, conj_add, hconj_x, hconj_xinv]
  have hTr : dd⁻¹ * T * dd = rr + rr⁻¹ := by
    rw [hTdef, conj_add_inv, hconj_xr, hconj_xinv_r]
  have hTc : dd * T * dd⁻¹ = cc + cc⁻¹ := by
    rw [hTy, conj_add, hconj_y, hconj_yinv]
  have hTw : w * T * w⁻¹ = T := by
    rw [hTdef, conj_add, hwx, hwx_inv, add_comm y⁻¹ y]
    exact (trace_eq f hf).symm
  have hWdd_inv : w * dd⁻¹ * w⁻¹ = dd := by
    have e : (w * dd * w⁻¹)⁻¹ = w * dd⁻¹ * w⁻¹ := by simp [_root_.mul_inv_rev, mul_assoc]
    rw [hconj_w_dd] at e
    rw [inv_inv] at e
    exact e.symm
  have hZw : w * Z * w⁻¹ = Z := by
    rw [hZdef, conj_sub, hTw, conj_two hw0]
  have hconjP : w * (T ^ 2 * (T + 2)) * w⁻¹ = T ^ 2 * (T + 2) := by
    rw [conj_Pp hw0, hTw]
  have hA : dd * Z * dd⁻¹ = Z * (T ^ 2 * (T + 2)) := by
    have h := rho_forward hx0 hd0 hconj_x hconj_xinv
    exact h
  have hRootA : dd⁻¹ * Z * dd
      = Z * ((rr + rr⁻¹) ^ 2 * ((rr + rr⁻¹) + 2))⁻¹ := by
    have h := rho_root hx0 hr0 hd0 hZne hTr hconj_rr
    exact h
  have hWargA : w * (dd * Z * dd⁻¹) * w⁻¹ = dd⁻¹ * Z * dd := by
    have e : w * (dd * Z * dd⁻¹) * w⁻¹
        = (w * dd * w⁻¹) * (w * Z * w⁻¹) * (w * dd⁻¹ * w⁻¹) := by
      rw [show dd * Z * dd⁻¹ = dd * (Z * dd⁻¹) from mul_assoc dd Z dd⁻¹,
        conj_mul hw0, conj_mul hw0]
      exact (mul_assoc _ _ _).symm
    rw [e, hconj_w_dd, hZw, hWdd_inv]
  have hD1 : dd⁻¹ * Z * dd = Z * (T ^ 2 * (T + 2)) := by
    rw [← hWargA, hA, conj_mul hw0, hZw, hconjP]
  have hPpTr_ne : (rr + rr⁻¹) ^ 2 * ((rr + rr⁻¹) + 2) ≠ 0 := by
    intro hcon
    have hZ0 : Z = 0 := by
      have h := rho_eq hr0
      rw [hconj_rr] at h
      have hZeq : Z = (x - 1) ^ 2 * x⁻¹ := by
        rw [hZdef, hTdef]
        exact z_form hx0
      rw [hZeq, h, hcon, mul_zero]
    exact hZne hZ0
  have hEqStar : (T ^ 2 * (T + 2)) * ((rr + rr⁻¹) ^ 2 * ((rr + rr⁻¹) + 2)) = 1 := by
    have h1 : Z * (T ^ 2 * (T + 2))
        = Z * (((rr + rr⁻¹) ^ 2 * ((rr + rr⁻¹) + 2))⁻¹) := hD1.symm.trans hRootA
    have h2 : T ^ 2 * (T + 2)
        = (((rr + rr⁻¹) ^ 2 * ((rr + rr⁻¹) + 2))⁻¹) := mul_left_cancel₀ hZne h1
    rw [h2, inv_mul_cancel₀ hPpTr_ne]
  have hB_i : dd⁻¹ * Z * dd = Z * (T ^ 2 * (T + 2)) := by
    have hconj_y4' : dd⁻¹ * y * (dd⁻¹)⁻¹ = y ^ 4 := by
      rw [inv_inv]
      exact hconj_y4
    have hconj_yinv4' : dd⁻¹ * y⁻¹ * (dd⁻¹)⁻¹ = (y ^ 4)⁻¹ := by
      rw [inv_inv]
      exact hconj_yinv4
    have h := rho_forward hy0 (inv_ne_zero hd0) hconj_y4' hconj_yinv4'
    rw [inv_inv] at h
    have hZy : Z = (y + y⁻¹) - 2 := by rw [hZdef, hTy]
    have hPTy : T ^ 2 * (T + 2) = (y + y⁻¹) ^ 2 * ((y + y⁻¹) + 2) := by rw [hTy]
    rw [hZy, hPTy]
    exact h
  have hRootB : dd * Z * dd⁻¹
      = Z * ((cc + cc⁻¹) ^ 2 * ((cc + cc⁻¹) + 2))⁻¹ := by
    have hZne_y : (y + y⁻¹) - 2 ≠ 0 := by
      rw [← hTy]
      exact hZne
    have hTc' : (dd⁻¹)⁻¹ * (y + y⁻¹) * (dd⁻¹) = cc + cc⁻¹ := by
      rw [inv_inv, conj_add, hconj_y, hconj_yinv]
    have h := rho_root hy0 hc0 (inv_ne_zero hd0) hZne_y hTc' hconj_cc
    rw [inv_inv] at h
    have hZy : Z = (y + y⁻¹) - 2 := by rw [hZdef, hTy]
    rw [hZy]
    exact h
  have hWargB : w * (dd⁻¹ * Z * dd) * w⁻¹ = dd * Z * dd⁻¹ := by
    have e : w * (dd⁻¹ * Z * dd) * w⁻¹
        = (w * dd⁻¹ * w⁻¹) * (w * Z * w⁻¹) * (w * dd * w⁻¹) := by
      rw [show dd⁻¹ * Z * dd = dd⁻¹ * (Z * dd) from mul_assoc (dd⁻¹) Z dd,
        conj_mul hw0, conj_mul hw0]
      exact (mul_assoc _ _ _).symm
    rw [e, hWdd_inv, hZw, hconj_w_dd]
  have hD2 : dd * Z * dd⁻¹ = Z * (T ^ 2 * (T + 2)) := by
    rw [← hWargB, hB_i, conj_mul hw0, hZw, hconjP]
  have hPc_ne : (cc + cc⁻¹) ^ 2 * ((cc + cc⁻¹) + 2) ≠ 0 := by
    intro hcon
    have hZ0 : Z = 0 := by
      have h := rho_eq hc0
      rw [hconj_cc] at h
      have hZeq : Z = (y - 1) ^ 2 * y⁻¹ := by
        rw [hZdef, hTy]
        exact z_form hy0
      rw [hZeq, h, hcon, mul_zero]
    exact hZne hZ0
  have hEqStarB : (T ^ 2 * (T + 2)) * ((cc + cc⁻¹) ^ 2 * ((cc + cc⁻¹) + 2)) = 1 := by
    have h1 : Z * (T ^ 2 * (T + 2))
        = Z * (((cc + cc⁻¹) ^ 2 * ((cc + cc⁻¹) + 2))⁻¹) := hD2.symm.trans hRootB
    have h2 : T ^ 2 * (T + 2)
        = (((cc + cc⁻¹) ^ 2 * ((cc + cc⁻¹) + 2))⁻¹) := mul_left_cancel₀ hZne h1
    rw [h2, inv_mul_cancel₀ hPc_ne]
  have hTcCheb : cc + cc⁻¹ = T ^ 4 - 4 * T ^ 2 + 2 := by
    have h1 : cc + cc⁻¹ = x ^ 4 + (x ^ 4)⁻¹ := by
      rw [← hTc]
      exact hTdd
    rw [h1]
    exact (cheb4 hx0).symm
  -- The conjugate sequence and its Chebyshev recursion.
  have hTn_step : ∀ n, dd * conjSeq dd T n * dd⁻¹ = conjSeq dd T (n + 1) := by
    intro n
    change dd * (dd ^ n * T * (dd ^ n)⁻¹) * dd⁻¹ = dd ^ (n + 1) * T * (dd ^ (n + 1))⁻¹
    calc dd * (dd ^ n * T * (dd ^ n)⁻¹) * dd⁻¹
        = (dd * dd ^ n) * T * ((dd ^ n)⁻¹ * dd⁻¹) := by noncomm_ring
      _ = dd ^ (n + 1) * T * (dd ^ (n + 1))⁻¹ := by
          rw [← pow_succ', ← _root_.mul_inv_rev, ← pow_succ']
  have hconj_xn : ∀ n, dd * ((powSeq (f elU) n : Dˣ) : D) * dd⁻¹
      = ((powSeq (f elU) (n + 1) : Dˣ) : D) := by
    intro n
    have hu : (f elH) * (powSeq (f elU) n) * (f elH)⁻¹ = powSeq (f elU) (n + 1) := by
      have e1 : (f elH) * (powSeq (f elU) n) * (f elH)⁻¹
          = ((f elH) * (f elU) * (f elH)⁻¹) ^ (4 ^ n) := by
        change (f elH) * ((f elU) ^ (4 ^ n)) * (f elH)⁻¹
          = ((f elH) * (f elU) * (f elH)⁻¹) ^ (4 ^ n)
        exact conj_pow_aux _ _ _
      have e2 : ((f elH) * (f elU) * (f elH)⁻¹) ^ (4 ^ n) = powSeq (f elU) (n + 1) := by
        rw [hHU, powSeq_succ]
        change ((f elU) ^ 4) ^ (4 ^ n) = ((f elU) ^ (4 ^ n)) ^ 4
        rw [← pow_mul, ← pow_mul, mul_comm (4 : ℕ) (4 ^ n)]
      rw [e1]
      exact e2
    have h := congrArg (fun u : Dˣ => (u : D)) hu
    rw [hd]
    simpa using h
  have hconj_xn_inv : ∀ n, dd * (((powSeq (f elU) n : Dˣ) : D))⁻¹ * dd⁻¹
      = (((powSeq (f elU) (n + 1) : Dˣ) : D))⁻¹ := by
    intro n
    have e : (dd * ((powSeq (f elU) n : Dˣ) : D) * dd⁻¹)⁻¹
        = dd * (((powSeq (f elU) n : Dˣ) : D))⁻¹ * dd⁻¹ := by
      simp [_root_.mul_inv_rev, mul_assoc]
    rw [hconj_xn n] at e
    exact e.symm
  have hTn_form : ∀ n, conjSeq dd T n
      = ((powSeq (f elU) n : Dˣ) : D) + (((powSeq (f elU) n : Dˣ) : D))⁻¹ := by
    intro n
    induction n with
    | zero =>
      rw [show conjSeq dd T 0 = T from by simp [conjSeq], hTdef]
      rw [powSeq_zero]
    | succ n ih =>
      rw [← hTn_step, ih, conj_add, hconj_xn n, hconj_xn_inv n]
  have hTn_rec : ∀ n, conjSeq dd T (n + 1)
      = (conjSeq dd T n) ^ 4 - 4 * (conjSeq dd T n) ^ 2 + 2 := by
    intro n
    rw [← hTn_step, hTn_form n, conj_add, hconj_xn n, hconj_xn_inv n]
    have h4 : ((powSeq (f elU) (n + 1) : Dˣ) : D)
        = (((powSeq (f elU) n : Dˣ) : D)) ^ 4 := by
      rw [powSeq_succ]
      exact Units.val_pow_eq_pow_val _ _
    rw [h4]
    exact (cheb4 (Units.ne_zero _)).symm
  have hPpProd : ∀ n, (conjSeq dd T n) ^ 2 * ((conjSeq dd T n) + 2)
      * ((conjSeq dd T (n + 1)) ^ 2 * ((conjSeq dd T (n + 1)) + 2)) = 1 := by
    intro n
    induction n with
    | zero =>
      have e0 : conjSeq dd T 0 = T := by simp [conjSeq]
      have e1 : conjSeq dd T 1 = cc + cc⁻¹ := by
        have hstep := hTn_step 0
        rw [e0] at hstep
        exact hstep.symm.trans hTc
      rw [e0, e1]
      exact hEqStarB
    | succ n ih =>
      have h := congrArg (fun z : D => dd * z * dd⁻¹) ih
      rw [conj_mul hd0, conj_Pp hd0, conj_Pp hd0, hTn_step n, hTn_step (n + 1),
        mul_one, mul_inv_cancel₀ hd0] at h
      exact h
  have hTn_mem : ∀ n, conjSeq dd T n ∈ Algebra.adjoin ℤ {T} := by
    intro n
    induction n with
    | zero =>
      rw [show conjSeq dd T 0 = T from by simp [conjSeq]]
      exact Algebra.subset_adjoin (Set.mem_singleton T)
    | succ n ih =>
      rw [hTn_rec n]
      have h2mem : (2 : D) ∈ Algebra.adjoin ℤ {T} := by
        rw [show (2 : D) = 1 + 1 from by norm_num]
        exact add_mem (one_mem _) (one_mem _)
      have h4mem : (4 : D) ∈ Algebra.adjoin ℤ {T} := by
        rw [show (4 : D) = (2 : D) + (2 : D) from by norm_num]
        exact add_mem h2mem h2mem
      exact add_mem (sub_mem (pow_mem ih 4) (mul_mem h4mem (pow_mem ih 2))) h2mem
  -- Polynomial evaluation and the root count.
  have hPpTn : ∀ n, Polynomial.aeval (conjSeq dd T n) ppPoly
      = (conjSeq dd T n) ^ 2 * ((conjSeq dd T n) + 2) := by
    intro n
    unfold ppPoly
    have hcast : algebraMap ℤ D (2 : ℤ) = (2 : D) := by simp [algebraMap_int_eq]
    simp only [map_mul, map_add, Polynomial.aeval_X, Polynomial.aeval_C, hcast]
    rw [← pow_two]
  have hChebTn : ∀ n, Polynomial.aeval (conjSeq dd T n) chebPoly = conjSeq dd T (n + 1) := by
    intro n
    unfold chebPoly
    have e : Polynomial.aeval (conjSeq dd T n)
        (Polynomial.X ^ 4 - Polynomial.C 4 * Polynomial.X ^ 2
          + Polynomial.C 2 : Polynomial ℤ)
        = (conjSeq dd T n) ^ 4 - 4 * (conjSeq dd T n) ^ 2 + 2 := by
      simp [map_sub, map_add, map_mul, map_pow, Polynomial.aeval_X, map_ofNat]
    rw [e]
    exact (hTn_rec n).symm
  have hF0n : ∀ n, Polynomial.aeval (conjSeq dd T n) fPoly = 0 := by
    intro n
    have hae : Polynomial.aeval (conjSeq dd T n) fPoly
        = ((conjSeq dd T n) ^ 2 * ((conjSeq dd T n) + 2))
          * ((conjSeq dd T (n + 1)) ^ 2 * ((conjSeq dd T (n + 1)) + 2)) - 1 := by
      unfold fPoly
      rw [map_sub, map_mul, map_one, Polynomial.aeval_comp, hPpTn n, hChebTn n, hPpTn (n + 1)]
    rw [hae, sub_eq_zero]
    exact hPpProd n
  set S : Subalgebra ℤ D := Algebra.adjoin ℤ {T} with hSdef
  have hScomm : ∀ a b : S, (a : D) * (b : D) = (b : D) * (a : D) := by
    intro a b
    have ha : (a : D) ∈ (Polynomial.aeval (R := ℤ) T).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval ℤ]
      exact a.property
    have hb : (b : D) ∈ (Polynomial.aeval (R := ℤ) T).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval ℤ]
      exact b.property
    obtain ⟨p, hp⟩ := ha
    obtain ⟨q, hq⟩ := hb
    calc (a : D) * (b : D)
        = Polynomial.aeval T p * Polynomial.aeval T q :=
          congrArg₂ (· * ·) hp.symm hq.symm
      _ = Polynomial.aeval T (p * q) := (map_mul _ _ _).symm
      _ = Polynomial.aeval T (q * p) := congrArg (Polynomial.aeval T) (mul_comm p q)
      _ = Polynomial.aeval T q * Polynomial.aeval T p := map_mul _ _ _
      _ = (b : D) * (a : D) := congrArg₂ (· * ·) hq hp
  let : CommRing S := commRingAdjoin T hScomm
  have : Nontrivial S := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
  have : IsDomain S := inferInstance
  have hTn_root : ∀ n, (fPoly.map (algebraMap ℤ S)).IsRoot
      ⟨conjSeq dd T n, hTn_mem n⟩ := by
    intro n
    change (fPoly.map (algebraMap ℤ S)).eval ⟨conjSeq dd T n, hTn_mem n⟩ = 0
    apply Subtype.ext
    change (((fPoly.map (algebraMap ℤ S)).eval ⟨conjSeq dd T n, hTn_mem n⟩ : S) : D) = 0
    rw [Polynomial.eval_map, ← Polynomial.aeval_def]
    have hcoe : ((Polynomial.aeval (⟨conjSeq dd T n, hTn_mem n⟩ : S) fPoly : S) : D)
        = Polynomial.aeval (conjSeq dd T n) fPoly := by
      have h := AlgHom.congr_fun (Polynomial.aeval_algHom S.val
        (⟨conjSeq dd T n, hTn_mem n⟩ : S)) fPoly
      rw [AlgHom.comp_apply, Subalgebra.val_apply] at h
      exact h.symm
    rw [hcoe]
    exact hF0n n
  have hTn_distinct : ∀ m n : ℕ, m ≠ n → conjSeq dd T m ≠ conjSeq dd T n := by
    intro m n hmn hcon
    have ha : ((f elU : Dˣ) : D) ≠ 0 := Units.ne_zero _
    have hform' : ∀ k, ((powSeq (f elU) k : Dˣ) : D)
        = ((f elU : Dˣ) : D) ^ (4 ^ k) := by
      intro k
      simp only [powSeq, Units.val_pow_eq_pow_val]
    rcases lt_or_gt_of_ne hmn with hlt | hgt
    · have hcon' : ((f elU : Dˣ) : D) ^ (4 ^ m) + (((f elU : Dˣ) : D) ^ (4 ^ m))⁻¹
          = ((f elU : Dˣ) : D) ^ (4 ^ n) + (((f elU : Dˣ) : D) ^ (4 ^ n))⁻¹ := by
        rw [hTn_form m, hTn_form n] at hcon
        rw [hform', hform'] at hcon
        exact hcon
      have hlt' : 4 ^ m < 4 ^ n := Nat.pow_lt_pow_right (by norm_num) hlt
      exact pow_add_inv_injective ha (fun k hk => pow_x_ne_one f hf hk) hlt' hcon'
    · have hcon' : ((f elU : Dˣ) : D) ^ (4 ^ n) + (((f elU : Dˣ) : D) ^ (4 ^ n))⁻¹
          = ((f elU : Dˣ) : D) ^ (4 ^ m) + (((f elU : Dˣ) : D) ^ (4 ^ m))⁻¹ := by
        rw [hTn_form n, hTn_form m] at hcon
        rw [hform', hform'] at hcon
        exact hcon.symm
      have hlt' : 4 ^ n < 4 ^ m := Nat.pow_lt_pow_right (by norm_num) hgt
      exact pow_add_inv_injective ha (fun k hk => pow_x_ne_one f hf hk) hlt' hcon'
  classical
  set FS : Polynomial S := fPoly.map (algebraMap ℤ S) with hFSdef
  have hFSne : FS ≠ 0 := by
    rw [hFSdef]
    exact (fPoly_monic.map (algebraMap ℤ S)).ne_zero
  have hFSdeg : FS.natDegree = 15 := by
    rw [hFSdef, Polynomial.Monic.natDegree_map fPoly_monic (algebraMap ℤ S),
      fPoly_natDegree]
  set roots : Finset S :=
    Finset.image (fun n => (⟨conjSeq dd T n, hTn_mem n⟩ : S)) (Finset.range 16) with hrootsdef
  have hcard : roots.card = 16 := by
    rw [hrootsdef, Finset.card_image_of_injective _ ?_, Finset.card_range]
    intro m n hmn
    by_contra hne
    exact hTn_distinct m n hne (congrArg Subtype.val hmn)
  have hsub : roots ⊆ (FS.roots).toFinset := by
    intro a ha
    rw [hrootsdef, Finset.mem_image] at ha
    obtain ⟨n, -, rfl⟩ := ha
    rw [Multiset.mem_toFinset]
    exact (Polynomial.mem_roots hFSne).mpr (hTn_root n)
  have hcardle : roots.card ≤ FS.roots.card :=
    le_trans (Finset.card_le_card hsub) (Multiset.toFinset_card_le _)
  have hbound := Polynomial.card_roots' FS
  rw [hFSdeg] at hbound
  omega

/-- **Kourovka Problem 11.110 (B. Hartley).** The group $\mathrm{SL}(2, \mathbb{Q})$ embeds in the
multiplicative group of some division ring: there are a division ring $D$ and an injective group
homomorphism $\mathrm{SL}(2, \mathbb{Q}) \to D^\times$. -/
def specialLinearRationalEmbedsInDivisionRing : Prop :=
  ∃ (D : Type) (_ : DivisionRing D) (f : Matrix.SpecialLinearGroup (Fin 2) ℚ →* Dˣ),
    Function.Injective f

/--
**SL(2, ℚ) does not embed in a division ring.** There is no division ring $D$ with an injective
group homomorphism $\mathrm{SL}(2, \mathbb{Q}) \to D^\times$: the group $\mathrm{SL}(2, \mathbb{Q})$
does not embed in the multiplicative group of any division ring.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 11.110 (B.
Hartley); resolution: W. Dicks and B. Hartley, Commun. Algebra 19 (1991), 1919-1943, Kourovka
Archive, Problem 11.110 ("No, it is not").
-/
theorem specialLinearRationalEmbedsInDivisionRing_refuted :
    ¬ specialLinearRationalEmbedsInDivisionRing := by
  rintro ⟨D, hD, f, hf⟩
  exact no_embedding f hf

end MathlibExt.GroupTheory.SpecialLinearRationalDivisionRingKourovka11Problem110Wanted
