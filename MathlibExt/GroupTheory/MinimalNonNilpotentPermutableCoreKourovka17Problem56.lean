module

public import Mathlib.GroupTheory.Nilpotent
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.Tactic.DeriveFintype

/-!
# Subgroups permuting with minimal non-nilpotent subgroups (Kourovka Notebook Problem 17.56)

Kourovka Notebook, Problem 17.56 (V. N. Knyagina, V. S. Monakhov): suppose that a subgroup `H` of a
finite group `G` is such that `HM = MH` for every minimal non-nilpotent subgroup `M` of `G`. Must
`H/H_G` be nilpotent, where `H_G` is the largest normal subgroup of `G` contained in `H`?

We give a counterexample using affine transformations of the plane over the field of five elements.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 17.56 (V. N. Knyagina, V. S. Monakhov).
UnsolvedMath record UM-00701358 (`KOU-17.56`), dataset ulamai/UnsolvedMath v1.8.0.

A minimal non-nilpotent subgroup is a non-nilpotent subgroup all of whose proper subgroups are
nilpotent. `HM` is the pointwise set product, `H_G` is `H.normalCore`, and `H/H_G` is the quotient
of `H` by `H_G` viewed as a normal subgroup of `H`.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.MinimalNonNilpotentPermutableCoreKourovka17Problem56Wanted

open scoped Pointwise

/-- **Minimal non-nilpotent subgroup.** A subgroup $M$ of a group $G$ is minimal non-nilpotent if
$M$ is not nilpotent but every proper subgroup of $M$ is nilpotent. -/
def IsMinimalNonNilpotent {G : Type*} [Group G] (M : Subgroup G) : Prop :=
  ¬ Group.IsNilpotent M ∧ ∀ K : Subgroup G, K < M → Group.IsNilpotent K

/-- **Subgroups permuting with all minimal non-nilpotent subgroups (Kourovka 17.56).** The
statement that if $H$ is a subgroup of a finite group $G$ with $HM = MH$ (as sets of products) for
every minimal non-nilpotent subgroup $M$ of $G$, then the quotient $H/H_G$ is nilpotent, where the
normal core $H_G$ is the largest normal subgroup of $G$ contained in $H$.

The question is due to V. N. Knyagina and V. S. Monakhov. -/
def permutesMinimalNonNilpotentCoreQuotientNilpotent : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (H : Subgroup G),
    (∀ M : Subgroup G, IsMinimalNonNilpotent M → (H : Set G) * M = M * H) →
      Group.IsNilpotent (H ⧸ H.normalCore.subgroupOf H)

-- The linear part is generated by r(x,y) = (2y,x) and s(x,y) = (-x,y).
-- Its normal form is r^i s^b, since s r s = r^5.
private structure LinearPart where
  turn : Fin 8
  flip : Bool
  deriving DecidableEq, Fintype

private def twist (b : Bool) (i : Fin 8) := if b then 5 * i else i

private instance linearGroup : Group LinearPart where
  one := ⟨0, false⟩
  mul a b := ⟨a.turn + twist a.flip b.turn, a.flip ^^ b.flip⟩
  inv a := ⟨-twist a.flip a.turn, a.flip⟩
  one_mul := by decide
  mul_one := by decide
  mul_assoc := by decide
  inv_mul_cancel := by decide

private abbrev Plane := Multiplicative (ZMod 5 × ZMod 5)

private def act (a : LinearPart) (v : Plane) : Plane :=
  let x := if a.flip then -v.toAdd.1 else v.toAdd.1
  let y := v.toAdd.2
  let c : ZMod 5 := 2 ^ (a.turn.val / 2)
  Multiplicative.ofAdd (if a.turn.val % 2 = 0 then (c * x, c * y) else (2 * c * y, c * x))

private theorem act_one : ∀ v : Plane, act 1 v = v := by decide

private theorem act_mul : ∀ (a b : LinearPart) (v : Plane),
    act (a * b) v = act a (act b v) := by decide

private theorem act_add (a : LinearPart) (u v : Plane) : act a (u * v) = act a u * act a v := by
  rcases a with ⟨i, b⟩
  change (act ⟨i, b⟩ (u * v)).toAdd = (act ⟨i, b⟩ u).toAdd + (act ⟨i, b⟩ v).toAdd
  cases b <;> by_cases h : i.val % 2 = 0 <;> simp [act, h, mul_add, add_comm]

private def linearAction : LinearPart →* MulAut Plane where
  toFun a :=
    { toFun := act a
      invFun := act a⁻¹
      left_inv := fun v => by rw [← act_mul, inv_mul_cancel, act_one]
      right_inv := fun v => by rw [← act_mul, mul_inv_cancel, act_one]
      map_mul' := act_add a }
  map_one' := MulEquiv.ext act_one
  map_mul' a b := MulEquiv.ext (act_mul a b)

private abbrev Affine := Plane ⋊[linearAction] LinearPart

private instance affineFinite : Finite Affine := Finite.of_equiv _ SemidirectProduct.equivProd.symm

private abbrev projection : Affine →* LinearPart := SemidirectProduct.rightHom

-- The diagonal subgroup consists of the transformations preserving the two axis directions.
private def diagonalLinear : Subgroup LinearPart where
  carrier := {a | a.turn.val % 2 = 0}
  one_mem' := by decide
  mul_mem' := by decide
  inv_mem' := by decide

private abbrev diagonal : Subgroup Affine := diagonalLinear.comap projection

private abbrev halfTurn : LinearPart := ⟨4, false⟩

private def axisElement (x : ZMod 5) (b : Bool) : Affine := ⟨.ofAdd (x, 0), ⟨0, b⟩⟩

private abbrev onAxis (g : Affine) := g.left.toAdd.2 = 0 ∧ g.right.turn = 0

private theorem axis_form (g : Affine) (h : onAxis g) :
    g = axisElement g.left.toAdd.1 g.right.flip := by
  obtain ⟨⟨x, y⟩, ⟨i, b⟩⟩ := g
  obtain ⟨rfl : y = 0, rfl : i = 0⟩ := h
  rfl

-- This dihedral subgroup translates and reflects the first coordinate alone.
private def axisGroup : Subgroup Affine where
  carrier := {g | onAxis g}
  one_mem' := by decide
  mul_mem' {a b} ha hb := by
    rw [axis_form a ha, axis_form b hb]
    exact (by decide : ∀ x s y t, onAxis (axisElement x s * axisElement y t)) _ _ _ _
  inv_mem' {a} ha := by
    rw [axis_form a ha]
    exact (by decide : ∀ x s, onAxis (axisElement x s)⁻¹) _ _

private theorem diagonal_normalizes : diagonal ≤ Subgroup.normalizer (axisGroup : Set Affine) := by
  apply Subgroup.le_normalizer_iff.mpr
  intro g hg h hh
  rw [axis_form h hh]
  obtain ⟨v, a⟩ := g
  exact (by decide : ∀ (a : LinearPart), a.turn.val % 2 = 0 → ∀ (v : Plane) x b,
    onAxis ((⟨v, a⟩ : Affine) * axisElement x b * (⟨v, a⟩ : Affine)⁻¹)) a hg v _ _

private theorem axis_core : axisGroup.normalCore = ⊥ := by
  apply le_antisymm _ bot_le
  intro g hg
  have ha := axisGroup.normalCore_le hg
  let r : Affine := ⟨1, ⟨1, false⟩⟩
  have hc : onAxis (r * g * r⁻¹) := hg r
  rw [axis_form g ha] at hc ⊢
  exact (by decide : ∀ x b, onAxis (r * axisElement x b * r⁻¹) → axisElement x b = 1) _ _ hc

private theorem commute_of_powers {G : Type*} [Group G] [Group.IsNilpotent G]
    {g t : G} (hg : g ^ 2 = 1) (ht : t ^ 5 = 1) : Commute g t :=
  Group.IsNilpotent.commute_of_orderOf_coprime (Nat.Coprime.of_dvd
    (orderOf_dvd_of_pow_eq_one hg) (orderOf_dvd_of_pow_eq_one ht) (by decide))

private theorem axis_not_nilpotent : ¬ Group.IsNilpotent axisGroup := by
  intro h
  let s : axisGroup := ⟨axisElement 0 true, ⟨rfl, rfl⟩⟩
  let t : axisGroup := ⟨axisElement 1 false, ⟨rfl, rfl⟩⟩
  exact (by decide : s * t ≠ t * s) (commute_of_powers (by decide : s ^ 2 = 1)
    (by decide : t ^ 5 = 1)).eq

private theorem exists_translation (M : Subgroup Affine) (hM : ¬ Group.IsNilpotent M) :
    ∃ t : M, projection t = 1 ∧ t ≠ 1 := by
  by_contra! h
  have hP : IsPGroup 2 LinearPart :=
    fun a => ⟨3, (by decide : ∀ b : LinearPart, b ^ 8 = 1) a⟩
  exact hM (hP.of_injective (projection.comp M.subtype)
    ((injective_iff_map_eq_one _).mpr h)).isNilpotent

-- Outside the diagonal subgroup, the fourth power has linear part -I. It is an involution
-- and commutes with no nonidentity translation, whereas the two would commute in a
-- nilpotent subgroup because translations have exponent five.
private theorem minimal_le_diagonal {M : Subgroup Affine} (hM : IsMinimalNonNilpotent M) :
    M ≤ diagonal := by
  intro x hx
  by_contra ho
  have hp : projection (x ^ 4) = halfTurn := by
    rw [map_pow]
    exact (by decide : ∀ a : LinearPart, ¬ a.turn.val % 2 = 0 → a ^ 4 = halfTurn) _ ho
  let D := M ⊓ diagonal
  have hD : D < M := lt_of_le_of_ne inf_le_left fun he => ho ((he ▸ hx : x ∈ D).2)
  have := hM.2 D hD
  obtain ⟨t, ht, hne⟩ := exists_translation M hM.1
  let z : D := ⟨x ^ 4, M.pow_mem hx _, show projection (x ^ 4) ∈ diagonalLinear from
    hp ▸ (by decide : halfTurn.turn.val % 2 = 0)⟩
  let u : D := ⟨t, t.property, show projection t ∈ diagonalLinear from ht ▸ diagonalLinear.one_mem⟩
  have hz : (z : Affine) = ⟨(z : Affine).left, halfTurn⟩ := SemidirectProduct.ext rfl hp
  have hu : (u : Affine) = ⟨(u : Affine).left, 1⟩ := SemidirectProduct.ext rfl ht
  have hz2 : z ^ 2 = 1 := by
    apply Subtype.ext
    change (z : Affine) ^ 2 = 1
    rw [hz]
    exact (by decide : ∀ v : Plane, (⟨v, halfTurn⟩ : Affine) ^ 2 = 1) _
  have hu5 : u ^ 5 = 1 := by
    apply Subtype.ext
    change (u : Affine) ^ 5 = 1
    rw [hu]
    exact (by decide : ∀ v : Plane, (⟨v, 1⟩ : Affine) ^ 5 = 1) _
  have hc := congrArg (fun a : D => (a : Affine)) (commute_of_powers hz2 hu5).eq
  change (z : Affine) * u = u * z at hc
  rw [hz, hu] at hc
  have hfix := congrArg SemidirectProduct.left hc
  change (z : Affine).left * act halfTurn (u : Affine).left =
    (u : Affine).left * act 1 (z : Affine).left at hfix
  rw [act_one, mul_comm (u : Affine).left] at hfix
  have hv := (by decide : ∀ v : Plane, act halfTurn v = v → v = 1) _ (mul_left_cancel hfix)
  exact hne (Subtype.ext (SemidirectProduct.ext hv ht))

/--
**Permutability with minimal non-nilpotent subgroups does not force a nilpotent core quotient.**
There exist a finite group $G$ and a subgroup $H$ of $G$ with $HM = MH$ (as sets of products) for
every minimal non-nilpotent subgroup $M$ of $G$ such that the quotient $H/H_G$ is not nilpotent,
where the normal core $H_G$ is the largest normal subgroup of $G$ contained in $H$.

This answers Kourovka Problem 17.56 in the negative (Ballester-Bolinches, Esteban-Romero,
Kamornikov and Pérez-Calabuig, 2022).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 17.56 (V. N. Knyagina, V. S. Monakhov);
resolution: A. Ballester-Bolinches, R. Esteban-Romero, S. F. Kamornikov and V. Pérez-Calabuig, J.
Algebra 608 (2022), 382-387, the Kourovka Notebook (21st issue) marks 17.56 solved (No, not always).
-/
public theorem permutesMinimalNonNilpotentCoreQuotientNilpotent_refuted :
    ¬ permutesMinimalNonNilpotentCoreQuotientNilpotent := by
  intro h
  have hn := h Affine axisGroup fun M hM =>
    (Subgroup.set_mul_normalizer_comm M axisGroup ((minimal_le_diagonal hM).trans
      diagonal_normalizes)).symm
  have hc : axisGroup.normalCore.subgroupOf axisGroup = ⊥ := by
    rw [axis_core, Subgroup.bot_subgroupOf]
  exact axis_not_nilpotent (Group.nilpotent_of_mulEquiv
    ((QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot))

end MathlibExt.GroupTheory.MinimalNonNilpotentPermutableCoreKourovka17Problem56Wanted
