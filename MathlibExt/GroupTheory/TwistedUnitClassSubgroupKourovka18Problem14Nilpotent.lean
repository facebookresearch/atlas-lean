/-!
# Twisted conjugacy classes of the identity that are subgroups (Kourovka Notebook Problem 18.14)

Kourovka Notebook, Problem 18.14 (V. G. Bardakov, M. V. Neshchadim, T. R. Nasybullov), marked solved
in the 21st issue: for `φ ∈ Aut G` let `[e]_φ = {g⁻¹ g^φ | g ∈ G}`. Conjecture: if `[e]_φ` is a
subgroup for every `φ ∈ Aut G`, then `G` is nilpotent; if in addition `G` is finitely generated,
then `G` is abelian.

We refute the nilpotency assertion using the full direct product of finite groups indexed by the
odd primes. Nicotera's counterexample uses the restricted direct product.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 18.14 (V. G. Bardakov, M. V. Neshchadim, T.
R. Nasybullov). UnsolvedMath record UM-00701443 (`KOU-18.14`), dataset ulamai/UnsolvedMath v1.8.0.

`g^φ` is the image `φ g`, so `[e]_φ` is the range of `g ↦ g⁻¹ φ(g)`; "is a subgroup" means it is the
carrier of some `Subgroup G`. The conjecture has two assertions, stated as two targets (nilpotency
for all such groups; commutativity for finitely generated ones); the resolving paper refutes each
separately.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.TwistedUnitClassSubgroupKourovka18Problem14Wanted

namespace twistedUnitClassesSubgroupsImpliesNilpotent_refuted

open SemidirectProduct
open Multiplicative (ofAdd toAdd)
open Finset

noncomputable section

private def geom (s : ℤ) (k : ℕ) : ℤ := ∑ i ∈ range k, s ^ i

private theorem geom_spec (s : ℤ) (k : ℕ) : geom s k * (s - 1) = s ^ k - 1 :=
  geom_sum_mul s k

-- Lifting the exponent shows that the geometric sum has the same p-divisibility as its length.
private theorem geom_dvd {p : ℕ} (hp : p.Prime) (ho : Odd p) {s : ℤ}
    (hs : (p : ℤ) ∣ s - 1) (k j : ℕ) : (p : ℤ) ^ j ∣ geom s k ↔ p ^ j ∣ k := by
  by_cases h : s = 1
  · subst s
    simp only [geom, one_pow, sum_const, card_range, nsmul_eq_mul, mul_one]
    exact_mod_cast Iff.rfl
  have hprime := Nat.prime_iff_prime_int.mp hp
  have hfinite : emultiplicity (p : ℤ) (s - 1) ≠ ⊤ :=
    (emultiplicity_lt_top.mpr (Int.finiteMultiplicity_iff.mpr
      ⟨by exact_mod_cast hp.ne_one, sub_ne_zero.mpr h⟩)).ne
  have hnd : ¬ (p : ℤ) ∣ s := by
    intro hsd
    have hone := dvd_sub hsd hs
    rw [sub_sub_cancel] at hone
    exact hprime.not_isUnit (isUnit_of_dvd_one hone)
  have he := Int.emultiplicity_pow_sub_pow hp ho hs hnd k
  rw [one_pow, ← geom_spec, mul_comm (geom s k), emultiplicity_mul hprime] at he
  rw [pow_dvd_iff_le_emultiplicity, pow_dvd_iff_le_emultiplicity,
    (WithTop.add_left_inj hfinite).mp he]

-- The cyclic group generated by 1 + p acts by scalars on two copies of ZMod (p ^ (n + 1)).
section Factor

variable (p n : ℕ) [Fact p.Prime]

private local instance : NeZero (p ^ n) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
private local instance : NeZero (p ^ (n + 1)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩

private abbrev R := ZMod (p ^ (n + 1))
private abbrev V := R p n × R p n
private abbrev A := Multiplicative (V p n)

private theorem scalar_isUnit : IsUnit ((p + 1 : ℕ) : R p n) := by
  apply (ZMod.isUnit_natCast_iff_not_dvd_pow Fact.out n.succ_pos).mpr
  intro hd
  have h := Nat.dvd_sub hd (dvd_refl p)
  exact (Fact.out : p.Prime).not_dvd_one (by simpa only [Nat.add_sub_cancel_left] using h)

private def scalar : (R p n)ˣ := (scalar_isUnit p n).unit

@[simp] private theorem scalar_val : (scalar p n : R p n) = (p : R p n) + 1 := by
  rw [scalar, IsUnit.unit_spec, Nat.cast_add, Nat.cast_one]

private abbrev C := Subgroup.zpowers (scalar p n)
private def gen : C p n := ⟨scalar p n, Subgroup.mem_zpowers _⟩

private theorem scalar_pow_eq_one (ho : Odd p) (k : ℕ) :
    scalar p n ^ k = 1 ↔ p ^ n ∣ k := by
  have hspec := geom_spec ((p : ℤ) + 1) k
  rw [add_sub_cancel_right] at hspec
  rw [← sub_eq_zero] at hspec
  rw [← Units.val_inj, Units.val_pow_eq_pow_val, scalar_val, Units.val_one,
    ← sub_eq_zero]
  have hcast : (((geom ((p : ℤ) + 1) k * (p : ℤ)) : ℤ) : R p n) =
      ((p : R p n) + 1) ^ k - 1 := by
    rw [sub_eq_zero.mp hspec]
    push_cast
    rfl
  rw [← hcast, ZMod.intCast_zmod_eq_zero_iff_dvd, Nat.cast_pow, pow_succ,
    mul_dvd_mul_iff_right (by exact_mod_cast (Fact.out : p.Prime).ne_zero),
    geom_dvd (Fact.out : p.Prime) ho (by simp)]

private theorem gen_pow_eq_one (ho : Odd p) (k : ℕ) :
    gen p n ^ k = 1 ↔ p ^ n ∣ k := by
  simpa [gen, Subtype.ext_iff] using scalar_pow_eq_one p n ho k

private theorem gen_order (ho : Odd p) : orderOf (gen p n) = p ^ n :=
  Nat.dvd_antisymm (orderOf_dvd_of_pow_eq_one ((gen_pow_eq_one p n ho _).2 dvd_rfl))
    ((gen_pow_eq_one p n ho _).1 (pow_orderOf_eq_one _))

private theorem exists_pow_gen (ho : Odd p) (t : C p n) : ∃ k < p ^ n, gen p n ^ k = t := by
  have ht : t ∈ Subgroup.zpowers (gen p n) := by
    obtain ⟨k, hk⟩ := t.property
    exact ⟨k, Subtype.ext hk⟩
  classical
  have hfin : IsOfFinOrder (gen p n) := orderOf_pos_iff.mp (gen_order p n ho ▸
    pow_pos (Fact.out : p.Prime).pos _)
  obtain ⟨k, hk, he⟩ := mem_image.mp (hfin.mem_zpowers_iff_mem_range_orderOf.mp ht)
  exact ⟨k, by simpa only [mem_range, gen_order p n ho] using hk, he⟩

private def coeff (t : C p n) : R p n := (t.val : (R p n)ˣ)

private theorem coeff_mul (s t : C p n) : coeff p n (s * t) = coeff p n s * coeff p n t := rfl
private theorem coeff_one : coeff p n 1 = 1 := rfl

private def action : C p n →* MulAut (A p n) where
  toFun t :=
    { toFun := fun a ↦ ofAdd (coeff p n t • a.toAdd)
      invFun := fun a ↦ ofAdd (coeff p n t⁻¹ • a.toAdd)
      left_inv := fun a ↦ by
        change ofAdd (coeff p n t⁻¹ • (coeff p n t • a.toAdd)) = a
        rw [smul_smul, ← coeff_mul, inv_mul_cancel, coeff_one, one_smul]
        rfl
      right_inv := fun a ↦ by
        change ofAdd (coeff p n t • (coeff p n t⁻¹ • a.toAdd)) = a
        rw [smul_smul, ← coeff_mul, mul_inv_cancel, coeff_one, one_smul]
        rfl
      map_mul' := fun a b ↦ congrArg ofAdd (smul_add (coeff p n t) a.toAdd b.toAdd) }
  map_one' := by
    apply MulEquiv.ext
    intro a
    change ofAdd (coeff p n 1 • a.toAdd) = a
    rw [coeff_one, one_smul]
    rfl
  map_mul' s t := by
    apply MulEquiv.ext
    intro a
    change ofAdd (coeff p n (s * t) • a.toAdd) =
      ofAdd (coeff p n s • (coeff p n t • a.toAdd))
    rw [smul_smul, coeff_mul]

private abbrev G := A p n ⋊[action p n] C p n

private theorem left_mul (g h : G p n) :
    (g * h).left.toAdd = g.left.toAdd + coeff p n g.right • h.left.toAdd := rfl

private theorem coeff_pow (t : C p n) (k : ℕ) :
    coeff p n (t ^ k) = coeff p n t ^ k := by
  induction k with
  | zero => rw [pow_zero, pow_zero, coeff_one]
  | succ k ih => rw [pow_succ t k, pow_succ (coeff p n t) k, coeff_mul, ih]

private theorem left_pow (g : G p n) (k : ℕ) :
    (g ^ k).left.toAdd = (∑ i ∈ range k, coeff p n g.right ^ i) • g.left.toAdd := by
  induction k with
  | zero => simp [pow_zero, one_left, toAdd_one]
  | succ k ih =>
    rw [pow_succ g k, left_mul, ih, sum_range_succ, add_smul]
    congr 2
    change coeff p n (rightHom (g ^ k)) = _
    rw [map_pow, coeff_pow, rightHom_eq_right]

private def residue : R p n →+* ZMod p :=
  ZMod.castHom (dvd_pow_self p n.succ_ne_zero) _

private def reduce (v : V p n) : ZMod p × ZMod p :=
  (residue p n v.1, residue p n v.2)

private theorem coeff_gen : coeff p n (gen p n) = (p : R p n) + 1 :=
  scalar_val p n

private theorem coeff_residue (ho : Odd p) (t : C p n) :
    residue p n (coeff p n t) = 1 := by
  obtain ⟨k, _, rfl⟩ := exists_pow_gen p n ho t
  rw [coeff_pow, coeff_gen, map_pow, map_add, map_one, map_natCast,
    ZMod.natCast_self, zero_add, one_pow]

private theorem reduce_mul (ho : Odd p) (g h : G p n) :
    reduce p n (g * h).left.toAdd = reduce p n g.left.toAdd + reduce p n h.left.toAdd := by
  rw [left_mul]
  ext <;> simp [reduce, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, coeff_residue p n ho]

private theorem reduce_of_pow_eq_one (ho : Odd p) (g : G p n) (hg : g ^ p ^ n = 1) :
    reduce p n g.left.toAdd = 0 := by
  obtain ⟨k, _, hk⟩ := exists_pow_gen p n ho g.right
  let s := ((p : ℤ) + 1) ^ k
  have hs : (p : ℤ) ∣ s - 1 := by
    dsimp [s]
    rw [← geom_spec, add_sub_cancel_right]
    exact dvd_mul_left _ _
  have hcast : (s : R p n) = coeff p n g.right := by
    rw [← hk, coeff_pow, coeff_gen]
    push_cast [s]
    rfl
  obtain ⟨c, hc⟩ := (geom_dvd (Fact.out : p.Prime) ho hs (p ^ n) n).mpr dvd_rfl
  have hnc : ¬ (p : ℤ) ∣ c := by
    intro h
    have hd : (p : ℤ) ^ (n + 1) ∣ geom s (p ^ n) := by
      rw [hc, pow_succ]
      exact mul_dvd_mul_left _ h
    have hp := (geom_dvd (Fact.out : p.Prime) ho hs (p ^ n) (n + 1)).mp hd
    exact (not_le_of_gt (Nat.pow_lt_pow_right (Fact.out : p.Prime).one_lt n.lt_succ_self))
      (Nat.le_of_dvd (pow_pos (Fact.out : p.Prime).pos _) hp)
  have hgeom : (geom s (p ^ n) : R p n) • g.left.toAdd = 0 := by
    simp only [geom, Int.cast_sum, Int.cast_pow, hcast]
    rw [← left_pow, hg, one_left, toAdd_one]
  have hcoord (z : R p n) (hz : (geom s (p ^ n) : R p n) * z = 0) :
      residue p n z = 0 := by
    rw [← ZMod.natCast_zmod_val z, ← Int.cast_natCast, ← Int.cast_mul,
      ZMod.intCast_zmod_eq_zero_iff_dvd, Nat.cast_pow, hc, mul_assoc, pow_succ,
      mul_dvd_mul_iff_left (pow_ne_zero _ (by exact_mod_cast (Fact.out : p.Prime).ne_zero))] at hz
    have hd := ((Nat.prime_iff_prime_int.mp Fact.out).dvd_or_dvd hz).resolve_left hnc
    rw [← ZMod.natCast_zmod_val z, map_natCast, ZMod.natCast_eq_zero_iff]
    exact_mod_cast hd
  exact Prod.ext (hcoord _ (congrArg Prod.fst hgeom)) (hcoord _ (congrArg Prod.snd hgeom))

private theorem commute_coeff {g h : G p n} (hc : Commute g h) :
    (coeff p n g.right - 1) • h.left.toAdd = (coeff p n h.right - 1) • g.left.toAdd := by
  have he := congrArg (fun z : G p n ↦ z.left.toAdd) hc.eq
  rw [left_mul, left_mul] at he
  rw [sub_smul, sub_smul, one_smul, one_smul, sub_eq_sub_iff_add_eq_add]
  simpa only [add_comm (g.left.toAdd), add_comm (h.left.toAdd)] using he

private theorem scalar_eq_one {t : C p n} (ht : coeff p n t - 1 = 0) : t = 1 :=
  Subtype.ext (Units.ext (sub_eq_zero.mp ht))

-- Elements killed by the quotient exponent have zero left coordinates modulo p. This lets us
-- find two images in the abelian factor whose left coordinates form a basis modulo p.
private theorem map_inl_right (ho : Odd p) (φ : G p n ≃* G p n) (a : A p n) :
    (φ (inl a)).right = 1 := by
  have hs : Function.Surjective (fun v : A p n ↦ reduce p n (φ (inl v)).left.toAdd) := by
    intro w
    obtain ⟨w₁, hw₁⟩ := ZMod.castHom_surjective (dvd_pow_self p n.succ_ne_zero) w.1
    obtain ⟨w₂, hw₂⟩ := ZMod.castHom_surjective (dvd_pow_self p n.succ_ne_zero) w.2
    obtain ⟨g, hg⟩ := φ.surjective (inl (ofAdd (w₁, w₂)))
    have hr : (φ (inr g.right)) ^ p ^ n = 1 := by
      obtain ⟨k, _, hk⟩ := exists_pow_gen p n ho g.right
      rw [← hk, ← map_pow, ← map_pow, pow_right_comm,
        (gen_pow_eq_one p n ho _).mpr dvd_rfl]
      simp
    refine ⟨g.left, ?_⟩
    have he := reduce_mul p n ho (φ (inl g.left)) (φ (inr g.right))
    rw [← map_mul, inl_left_mul_inr_right, hg, reduce_of_pow_eq_one p n ho _ hr, add_zero] at he
    exact he.symm.trans (Prod.ext hw₁ hw₂)
  obtain ⟨u, hu⟩ := hs (1, 0)
  obtain ⟨v, hv⟩ := hs (0, 1)
  let u' := φ (inl u)
  let v' := φ (inl v)
  let d := u'.left.toAdd.1 * v'.left.toAdd.2 - u'.left.toAdd.2 * v'.left.toAdd.1
  have hd : residue p n d = 1 := by
    have h₁ : residue p n u'.left.toAdd.1 = 1 := congrArg Prod.fst hu
    have h₂ : residue p n u'.left.toAdd.2 = 0 := congrArg Prod.snd hu
    have h₃ : residue p n v'.left.toAdd.1 = 0 := congrArg Prod.fst hv
    have h₄ : residue p n v'.left.toAdd.2 = 1 := congrArg Prod.snd hv
    simp only [d, map_sub, map_mul, h₁, h₂, h₃, h₄, mul_one, mul_zero, sub_zero]
  have residue_unit (x : R p n) (hx : residue p n x = 1) : IsUnit x := by
    rw [← ZMod.natCast_zmod_val x] at hx ⊢
    refine (ZMod.isUnit_natCast_iff_not_dvd_pow Fact.out n.succ_pos).mpr fun h ↦ ?_
    have : (x.val : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff ..).2 h
    rw [map_natCast, this] at hx
    exact zero_ne_one hx
  have huv : Commute u' v' := ((Commute.all u v).map (inl : A p n →* G p n)).map φ
  have e₁ : (coeff p n u'.right - 1) * v'.left.toAdd.1 =
      (coeff p n v'.right - 1) * u'.left.toAdd.1 :=
    congrArg Prod.fst (commute_coeff p n huv)
  have e₂ : (coeff p n u'.right - 1) * v'.left.toAdd.2 =
      (coeff p n v'.right - 1) * u'.left.toAdd.2 :=
    congrArg Prod.snd (commute_coeff p n huv)
  have he : (coeff p n u'.right - 1) * d = 0 := by
    dsimp only [d]
    linear_combination u'.left.toAdd.1 * e₂ - u'.left.toAdd.2 * e₁
  have hdu : coeff p n u'.right - 1 = 0 :=
    (residue_unit d hd).mul_right_cancel (he.trans (zero_mul _).symm)
  apply scalar_eq_one p n
  have hcom : Commute (φ (inl a)) u' := ((Commute.all a u).map (inl : A p n →* G p n)).map φ
  have he' : (coeff p n (φ (inl a)).right - 1) * u'.left.toAdd.1 = 0 := by
    have h := congrArg Prod.fst (commute_coeff p n hcom)
    change _ * _ = (coeff p n u'.right - 1) * _ at h
    simpa only [hdu, zero_mul] using h
  exact (residue_unit _ (congrArg Prod.fst hu)).mul_right_cancel
    (he'.trans (zero_mul _).symm)

private def onLeft (ho : Odd p) (φ : G p n ≃* G p n) : A p n →* A p n where
  toFun a := (φ (inl a)).left
  map_one' := by simp
  map_mul' a b := by
    rw [map_mul, map_mul, mul_left, map_inl_right p n ho φ a]
    rw [map_one]
    rfl

private theorem map_inl (ho : Odd p) (φ : G p n ≃* G p n) (a : A p n) :
    φ (inl a) = inl (onLeft p n ho φ a) := by
  apply SemidirectProduct.ext
  · rfl
  · exact map_inl_right p n ho φ a

private theorem onLeft_smul (ho : Odd p) (φ : G p n ≃* G p n) (r : R p n) (a : A p n) :
    onLeft p n ho φ (ofAdd (r • a.toAdd)) = ofAdd (r • (onLeft p n ho φ a).toAdd) := by
  rw [← ZMod.natCast_zmod_val r, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul]
  exact map_pow (onLeft p n ho φ) a r.val

-- The restriction to the abelian factor commutes with scalar multiplication. Conjugating that
-- factor therefore determines the same scalar before and after applying the automorphism.
private theorem map_right (ho : Odd p) (φ : G p n ≃* G p n) (g : G p n) :
    (φ g).right = g.right := by
  let w : A p n := ofAdd (1, 0)
  let a := onLeft p n ho φ.symm w
  have hw : onLeft p n ho φ a = w := by
    have h := congrArg (fun z : G p n ↦ z.left) (φ.apply_symm_apply (inl w))
    rwa [map_inl p n ho φ.symm, map_inl p n ho φ, left_inl, left_inl] at h
  have hmul : g * inl a = inl (ofAdd (coeff p n g.right • a.toAdd)) * g := by
    apply SemidirectProduct.ext
    · apply toAdd.injective
      simp only [left_mul, left_inl, right_inl, coeff_one, one_smul, toAdd_ofAdd]
      exact add_comm _ _
    · simp
  have hφ := congrArg (fun z : G p n ↦ (φ z).left.toAdd.1) hmul
  simp only [map_mul, map_inl p n ho φ, onLeft_smul p n ho φ, hw, left_mul, left_inl,
    right_inl, coeff_one, one_smul, toAdd_ofAdd, Prod.fst_add, Prod.smul_fst, smul_eq_mul,
    show w.toAdd.1 = 1 from rfl, mul_one] at hφ
  rw [add_comm] at hφ
  exact Subtype.ext (Units.ext (add_right_cancel hφ))

private theorem residue_eq_zero_iff (z : R p n) :
    residue p n z = 0 ↔ (p : R p n) ^ n * z = 0 := by
  rw [← ZMod.natCast_zmod_val z, map_natCast, ← Nat.cast_pow, ← Nat.cast_mul,
    ZMod.natCast_eq_zero_iff, ZMod.natCast_eq_zero_iff]
  generalize z.val = k
  rw [pow_succ p n, Nat.mul_dvd_mul_iff_left (pow_pos (Fact.out : p.Prime).pos _)]

-- The first p ^ n powers of the generator are distinct. Subtracting one and dividing by p
-- gives the p ^ n distinct geometric sums modulo p ^ n.
private theorem geom_cast_surjective (ho : Odd p) :
    Function.Surjective (fun i : Fin (p ^ n) ↦ (geom ((p : ℤ) + 1) i : ZMod (p ^ n))) := by
  apply (Finite.injective_iff_surjective_of_equiv (ZMod.finEquiv (p ^ n)).toEquiv).mp
  intro i j hij
  have hspec (k : ℕ) : (p : R p n) * (geom ((p : ℤ) + 1) k : R p n) =
      ((p : R p n) + 1) ^ k - 1 := by
    have h := geom_spec ((p : ℤ) + 1) k
    rw [add_sub_cancel_right, mul_comm] at h
    exact_mod_cast congrArg (fun x : ℤ ↦ (x : R p n)) h
  have he : (p : R p n) * (geom ((p : ℤ) + 1) i : R p n) =
      (p : R p n) * (geom ((p : ℤ) + 1) j : R p n) := by
    rw [← sub_eq_zero, ← mul_sub, ← Int.cast_sub, ← Int.cast_natCast, ← Int.cast_mul,
      ZMod.intCast_zmod_eq_zero_iff_dvd, Nat.cast_pow, pow_succ (p : ℤ) n,
      mul_comm _ (p : ℤ), mul_dvd_mul_iff_left (by exact_mod_cast (Fact.out : p.Prime).ne_zero),
      ← Nat.cast_pow, ← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_sub, sub_eq_zero]
    exact hij
  rw [hspec, hspec, sub_left_inj] at he
  apply Fin.ext
  apply pow_injOn_Iio_orderOf (x := gen p n)
  · simp [gen_order p n ho]
  · simp [gen_order p n ho]
  · apply Subtype.ext
    apply Units.ext
    change coeff p n (gen p n ^ i.val) = coeff p n (gen p n ^ j.val)
    simpa only [← coeff_gen, ← coeff_pow] using he

private theorem left_twist_inr (ho : Odd p) (φ : G p n ≃* G p n) (t : C p n) :
    (φ (inr t) * (inr t)⁻¹ : G p n) = inl (φ (inr t)).left := by
  apply SemidirectProduct.ext
  · simp
  · rw [mul_right, inv_right, map_right p n ho φ, right_inr, mul_inv_cancel, right_inl]

private theorem left_pow_gen (ho : Odd p) (φ : G p n ≃* G p n) (k : ℕ) :
    (φ (inr (gen p n ^ k))).left = (φ (inr (gen p n))).left ^ geom ((p : ℤ) + 1) k := by
  apply toAdd.injective
  rw [map_pow, map_pow, left_pow, map_right p n ho φ, right_inr, coeff_gen]
  change _ = geom ((p : ℤ) + 1) k • (φ (inr (gen p n))).left.toAdd
  rw [← Int.cast_smul_eq_zsmul (R p n)]
  push_cast [geom]
  rfl

private theorem left_range (ho : Odd p) (φ : G p n ≃* G p n) :
    Set.range (fun t : C p n ↦ (φ (inr t)).left) =
      (Subgroup.zpowers (φ (inr (gen p n))).left : Set (A p n)) := by
  let d := (φ (inr (gen p n))).left
  have hd : d ^ p ^ n = 1 := by
    have h : (φ (inr (gen p n))) ^ p ^ n = 1 := by
      rw [← map_pow, ← map_pow, (gen_pow_eq_one p n ho _).mpr dvd_rfl, map_one, map_one]
    have hz := reduce_of_pow_eq_one p n ho _ h
    apply toAdd.injective
    change (p ^ n : ℕ) • d.toAdd = 0
    rw [← Nat.cast_smul_eq_nsmul (R p n), Nat.cast_pow]
    exact Prod.ext ((residue_eq_zero_iff p n _).mp (congrArg Prod.fst hz))
      ((residue_eq_zero_iff p n _).mp (congrArg Prod.snd hz))
  ext a
  constructor
  · rintro ⟨t, rfl⟩
    obtain ⟨k, _, rfl⟩ := exists_pow_gen p n ho t
    exact ⟨geom ((p : ℤ) + 1) k, (left_pow_gen p n ho φ k).symm⟩
  · rintro ⟨k, rfl⟩
    obtain ⟨i, hi⟩ := geom_cast_surjective p n ho (k : ZMod (p ^ n))
    refine ⟨gen p n ^ (i : ℕ), (left_pow_gen p n ho φ i).trans ?_⟩
    apply zpow_eq_zpow_iff_modEq.mpr
    exact ((ZMod.intCast_eq_intCast_iff ..).mp hi).of_dvd (by
      exact_mod_cast orderOf_dvd_of_pow_eq_one hd)

-- The range of the left displacement is the product of the ranges from the two factors.
private theorem factor_property (ho : Odd p) : AllTwistedUnitClassesSubgroups (G p n) := by
  intro φ
  let M : A p n →* A p n := onLeft p n ho φ * (MonoidHom.id _)⁻¹
  let H := M.range ⊔ Subgroup.zpowers (φ (inr (gen p n))).left
  have hd (a : A p n) (t : C p n) :
      φ (inl a * inr t) * (inl a * inr t : G p n)⁻¹ =
        inl (M a * (φ (inr t)).left) := by
    rw [map_mul, mul_inv_rev, mul_assoc, ← mul_assoc (φ (inr t)),
      left_twist_inr p n ho φ t, map_inl p n ho φ, ← map_inv, ← map_mul, ← map_mul]
    congr 1
    change _ * (_ * a⁻¹) = (_ * a⁻¹) * _
    ac_rfl
  have hleft : (H.map (inl : A p n →* G p n) : Set (G p n)) =
      Set.range (fun g : G p n ↦ φ g * g⁻¹) := by
    ext g
    constructor
    · rintro ⟨a, ha, rfl⟩
      obtain ⟨_, ⟨c, rfl⟩, d, hd', rfl⟩ := Subgroup.mem_sup.mp ha
      have ht : d ∈ Set.range (fun t : C p n ↦ (φ (inr t)).left) :=
        (left_range p n ho φ).symm ▸ hd'
      obtain ⟨t, rfl⟩ := ht
      exact ⟨inl c * inr t, hd c t⟩
    · rintro ⟨g, rfl⟩
      refine ⟨M g.left * (φ (inr g.right)).left, Subgroup.mem_sup.mpr ?_, ?_⟩
      · refine ⟨_, ⟨g.left, rfl⟩, _, ?_, rfl⟩
        change _ ∈ (↑(Subgroup.zpowers (φ (inr (gen p n))).left) : Set (A p n))
        rw [← left_range p n ho φ]
        exact ⟨g.right, rfl⟩
      · rw [← hd, inl_left_mul_inr_right]
  let K : Subgroup (G p n) := H.map inl
  refine ⟨K, Set.ext fun g ↦ ?_⟩
  change g ∈ K ↔ ∃ x : G p n, x⁻¹ * φ x = g
  rw [← K.inv_mem_iff]
  change g⁻¹ ∈ (K : Set (G p n)) ↔ _
  rw [hleft]
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨x⁻¹, by simpa using congrArg Inv.inv hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨x⁻¹, by simpa using congrArg Inv.inv hx⟩

private theorem factor_exponent (ho : Odd p) (g : G p n) : g ^ p ^ (n + (n + 1)) = 1 := by
  have hr : (g ^ p ^ n).right = 1 := by
    obtain ⟨k, _, hk⟩ := exists_pow_gen p n ho g.right
    change rightHom (g ^ p ^ n) = 1
    rw [map_pow, rightHom_eq_right, ← hk, pow_right_comm,
      (gen_pow_eq_one p n ho _).mpr dvd_rfl, one_pow]
  have hg : g ^ p ^ n = inl (g ^ p ^ n).left := by
    apply SemidirectProduct.ext
    · rfl
    · rw [hr, right_inl]
  rw [pow_add p n (n + 1), pow_mul g, hg, ← map_pow]
  have hz : (g ^ p ^ n).left ^ (p ^ (n + 1)) = 1 := by
    apply toAdd.injective
    change (p ^ (n + 1) : ℕ) • (g ^ p ^ n).left.toAdd = 0
    rw [← Nat.cast_smul_eq_nsmul (R p n), ZMod.natCast_self, zero_smul]
  rw [hz, map_one]

open scoped commutatorElement in
private theorem comm_gen (v : V p n) :
    ⁅(inl (ofAdd v) : G p n), (inr (gen p n) : G p n)⁆ = inl (ofAdd ((-(p : R p n)) • v)) := by
  let i : A p n →* G p n := inl
  let j : C p n →* G p n := inr
  calc
    _ = i (ofAdd v) * (j (gen p n) * i (ofAdd v)⁻¹ * j (gen p n)⁻¹) := by
      simp only [commutatorElement_def, i, j, map_inv, mul_assoc]
    _ = _ := by
      change inl (ofAdd v) * (inr (gen p n) * inl ((ofAdd v : A p n)⁻¹) *
        inr (gen p n)⁻¹) = _
      rw [← inl_aut, ← map_mul]
      apply congrArg i
      apply toAdd.injective
      change v + coeff p n (gen p n) • -v = (-(p : R p n)) • v
      rw [coeff_gen, smul_neg, ← sub_eq_add_neg, add_smul, one_smul,
        add_comm _ v, sub_add_eq_sub_sub, sub_self, zero_sub, neg_smul]

-- Each commutator with the cyclic generator multiplies the left vector by -p.
private theorem factor_series_ne_bot :
    (⊤ : Subgroup (G p n)).lowerCentralSeries n ≠ ⊥ := by
  have hmem (k : ℕ) :
      inl (ofAdd ((-(p : R p n)) ^ k, 0)) ∈
        (⊤ : Subgroup (G p n)).lowerCentralSeries k := by
    induction k with
    | zero => exact Subgroup.mem_top _
    | succ k ih =>
      rw [Subgroup.lowerCentralSeries_succ]
      have hh := Subgroup.commutator_mem_commutator ih (Subgroup.mem_top (inr (gen p n)))
      rw [comm_gen] at hh
      simpa [pow_succ' (-(p : R p n)) k, Prod.smul_fst, Prod.smul_snd, smul_eq_mul] using hh
  intro h
  have hone := Subgroup.mem_bot.mp (h ▸ hmem n)
  have hz : (-(p : R p n)) ^ n = 0 :=
    congrArg (fun g : G p n ↦ g.left.toAdd.1) hone
  rw [neg_pow] at hz
  have he : (p : R p n) ^ n = 0 :=
    (isUnit_neg_one.pow n).mul_left_cancel (hz.trans (mul_zero _).symm)
  rw [← Nat.cast_pow, ZMod.natCast_eq_zero_iff] at he
  exact (not_le_of_gt (Nat.pow_lt_pow_right (Fact.out : p.Prime).one_lt n.lt_succ_self))
    (Nat.le_of_dvd (pow_pos (Fact.out : p.Prime).pos _) he)

end Factor

private theorem infinite_odd_primes : (Set.ofPred fun p : ℕ ↦ p.Prime ∧ 3 ≤ p).Infinite := by
  apply Set.infinite_of_not_bddAbove
  rw [not_bddAbove_iff]
  intro b
  obtain ⟨q, hq, hp⟩ := Nat.exists_infinite_primes (max 3 (b + 1))
  exact ⟨q, ⟨hp, (le_max_left ..).trans hq⟩,
    lt_of_lt_of_le b.lt_succ_self ((le_max_right ..).trans hq)⟩

private def primeAt := Nat.nth (fun p : ℕ ↦ p.Prime ∧ 3 ≤ p)

private theorem primeAt_spec (i : ℕ) : (primeAt i).Prime ∧ 3 ≤ primeAt i :=
  Nat.nth_mem_of_infinite infinite_odd_primes i

private local instance (i : ℕ) : Fact (primeAt i).Prime := ⟨(primeAt_spec i).1⟩

private theorem primeAt_odd (i : ℕ) : Odd (primeAt i) :=
  (primeAt_spec i).1.odd_iff.mpr (primeAt_spec i).2

private abbrev Factor (i : ℕ) := G (primeAt i) i
private abbrev Product := (i : ℕ) → Factor i
private def exponent (i : ℕ) := primeAt i ^ (i + (i + 1))

private theorem factor_isPGroup (i : ℕ) : IsPGroup (primeAt i) (Factor i) :=
  fun g ↦ ⟨i + (i + 1), factor_exponent _ _ (primeAt_odd i) g⟩

-- Each coordinate kernel is the set of powers of its factor's exponent.
private theorem coord_eq_one_iff (i : ℕ) (g : Product) :
    g i = 1 ↔ ∃ x : Product, x ^ exponent i = g := by
  constructor
  · intro h
    classical
    have hz (j : ℕ) (hj : j ≠ i) : (primeAt j).Coprime (exponent i) := by
      have hne : primeAt j ≠ primeAt i :=
        fun he ↦ hj ((Nat.nth_strictMono infinite_odd_primes).injective he)
      exact ((Nat.coprime_primes (primeAt_spec j).1 (primeAt_spec i).1).mpr hne).pow_right _
    refine ⟨fun j ↦ if hj : j = i then 1 else
      ((factor_isPGroup j).powEquiv (hz j hj)).symm (g j), ?_⟩
    funext j
    change (if hj : j = i then (1 : Factor j) else _) ^ exponent i = g j
    by_cases hj : j = i
    · subst j
      rw [dite_eq_left rfl, one_pow, h]
    · rw [dite_eq_right hj, ← (factor_isPGroup j).powEquiv_apply (hz j hj), Equiv.apply_symm_apply]
  · rintro ⟨x, rfl⟩
    exact factor_exponent _ _ (primeAt_odd i) (x i)

private theorem map_coord_one (φ : Product ≃* Product) (i : ℕ) (g : Product) (h : g i = 1) :
    φ g i = 1 := by
  obtain ⟨x, rfl⟩ := (coord_eq_one_iff i g).mp h
  exact (coord_eq_one_iff i _).mpr ⟨φ x, (map_pow φ x (exponent i)).symm⟩

private theorem map_coord (φ : Product ≃* Product) (i : ℕ) (g : Product) :
    φ g i = φ (Pi.mulSingle i (g i)) i := by
  let s : Product := Pi.mulSingle i (g i)
  have h : (g / s) i = 1 := by simp [s, Pi.div_apply]
  have he := map_coord_one φ i (g / s) h
  rw [map_div, Pi.div_apply, div_eq_one] at he
  exact he

private def coordAut (φ : Product ≃* Product) (i : ℕ) : Factor i ≃* Factor i where
  toFun x := φ (Pi.mulSingle i x) i
  invFun x := φ.symm (Pi.mulSingle i x) i
  left_inv x := by
    change φ.symm (Pi.mulSingle i (φ (Pi.mulSingle i x) i)) i = x
    rw [← map_coord φ.symm i (φ (Pi.mulSingle i x)), φ.symm_apply_apply, Pi.mulSingle_eq_same]
  right_inv x := by
    change φ (Pi.mulSingle i (φ.symm (Pi.mulSingle i x) i)) i = x
    rw [← map_coord φ i (φ.symm (Pi.mulSingle i x)), φ.apply_symm_apply, Pi.mulSingle_eq_same]
  map_mul' x y := by rw [Pi.mulSingle_mul, map_mul, Pi.mul_apply]

private theorem product_property : AllTwistedUnitClassesSubgroups Product := by
  classical
  intro φ
  choose H hH using fun i : ℕ ↦ factor_property _ _ (primeAt_odd i) (coordAut φ i)
  refine ⟨Subgroup.pi Set.univ H, Set.ext fun g ↦ ?_⟩
  change (∀ i, i ∈ Set.univ → g i ∈ H i) ↔ ∃ x : Product, x⁻¹ * φ x = g
  have hcoord (x : Product) (i : ℕ) : φ x i = coordAut φ i (x i) := map_coord φ i x
  constructor
  · intro h
    have hx (i : ℕ) : ∃ x : Factor i, x⁻¹ * coordAut φ i x = g i := by
      have hi : g i ∈ (H i : Set (Factor i)) := h i (Set.mem_univ i)
      rw [hH i] at hi
      exact hi
    choose x hx using hx
    exact ⟨x, funext fun i ↦ by simpa only [Pi.mul_apply, Pi.inv_apply, hcoord] using hx i⟩
  · rintro ⟨x, rfl⟩ i _
    change _ ∈ (H i : Set (Factor i))
    rw [hH i]
    exact ⟨x i, by rw [Pi.mul_apply, Pi.inv_apply, hcoord]⟩

private theorem product_not_nilpotent : ¬ Group.IsNilpotent Product := by
  intro h
  obtain ⟨i, hi⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp h
  let f := Pi.evalMonoidHom Factor i
  have hf : Function.Surjective f := fun x ↦ ⟨Pi.mulSingle i x, Pi.mulSingle_eq_same i x⟩
  have he := Subgroup.map_lowerCentralSeries (⊤ : Subgroup Product) f i
  rw [hi, Subgroup.map_bot, Subgroup.map_top_of_surjective f hf] at he
  exact factor_series_ne_bot _ _ he.symm

end

end twistedUnitClassesSubgroupsImpliesNilpotent_refuted

open twistedUnitClassesSubgroupsImpliesNilpotent_refuted in
/--
**Negative answer to the nilpotency assertion of Kourovka Problem 18.14.** There is a group $G$
that is not nilpotent although, for every automorphism $\varphi$ of $G$, the twisted conjugacy
class of the identity $[e]_\varphi = \{g^{-1}\varphi(g) : g \in G\}$ is a subgroup of $G$.

Nicotera's Corollary 3.1 gives such an infinite group, a restricted direct product of the finite
groups of Theorem 1.2 for pairwise distinct primes.

Source:
E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook,
21st issue, arXiv:1401.0300v49 (2026), Problem 18.14 (V. G. Bardakov, M. V. Neshchadim, T. R.
Nasybullov); resolution: C. Nicotera, On finite groups in which the twisted conjugacy classes of the
unit element are subgroups, Arch. Math. 123 (2024), no. 3, 225-232, Theorem 1.2 (for every n and
every odd prime p, a finite p-group of class n in which [G, φ] is a subgroup for every φ ∈ Aut G)
and Corollary 3.1 (an infinite non-nilpotent group with this property); the Kourovka Notebook (21st
issue) marks 18.14 solved, https://doi.org/10.1007/s00013-024-02025-6.
-/
theorem twistedUnitClassesSubgroupsImpliesNilpotent_refuted :
    ¬ twistedUnitClassesSubgroupsImpliesNilpotent := by
  intro h
  exact product_not_nilpotent (h Product product_property)

end MathlibExt.GroupTheory.TwistedUnitClassSubgroupKourovka18Problem14Wanted
