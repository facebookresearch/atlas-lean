/-!
# Abelian images of countable ultraproducts

Every abelian image of a nonprincipal countable ultraproduct of groups is an image of an
ultrapower of a free abelian group over the same ultrafilter.

Following Corson's diagonal argument, the given ultraproduct solves the recurrences
`b n = a n + (n + 1) • b (n + 1)` in its abelian image. These recurrences give compatible
lifts of rational multiples with factorial denominators. This lets us extend evaluation on
the free abelian group across its diagonal embedding in its ultrapower.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.AbelianImagesUltraproductsKourovka20Problem13Wanted

/-- **Ultraproduct kernel.** For an ultrafilter $U$ on $\mathbb{N}$ and a sequence
$(G_i)_{i \in \mathbb{N}}$ of groups, the normal subgroup of $\prod_i G_i$ generated by the
sequences $(g_i)_i$ with $\{i : g_i = 1\} \in U$. These sequences already form a normal subgroup,
so the kernel consists of exactly them. -/
abbrev ultraproductKernel (U : Ultrafilter ℕ) (G : ℕ → Type) [∀ i, Group (G i)] :
    Subgroup (∀ i, G i) :=
  Subgroup.normalClosure {f | ∀ᶠ i in (U : Filter ℕ), f i = 1}

/-- **Ultraproduct of a sequence of groups.** For an ultrafilter $U$ on $\mathbb{N}$ and a sequence
$(G_i)_{i \in \mathbb{N}}$ of groups, the ultraproduct $\left(\prod_i G_i\right)/U$ is the quotient
of the direct product $\prod_i G_i$ by the ultraproduct kernel, the normal subgroup of sequences
$(g_i)_i$ with $\{i : g_i = 1\} \in U$. -/
abbrev Ultraproduct (U : Ultrafilter ℕ) (G : ℕ → Type) [∀ i, Group (G i)] : Type :=
  (∀ i, G i) ⧸ ultraproductKernel U G

/-- **Kourovka Problem 20.13(a) (Bergman).** The proposition that for every abelian group $A$, every
sequence $(G_i)_{i \in \mathbb{N}}$ of (not necessarily abelian) groups and every nonprincipal
ultrafilter $U$ on $\mathbb{N}$ (one containing every cofinite set), if there is a surjective
homomorphism from the ultraproduct $\left(\prod_i G_i\right)/U$ onto $A$, then there are a sequence
$(H_i)_{i \in \mathbb{N}}$ of abelian groups and a nonprincipal ultrafilter $V$ on $\mathbb{N}$
with a surjective homomorphism from $\left(\prod_i H_i\right)/V$ onto $A$. -/
def abelianImageOfUltraproductIsImageOfAbelianUltraproduct : Prop :=
  ∀ (A : Type) [CommGroup A] (G : ℕ → Type) [∀ i, Group (G i)] (U : Ultrafilter ℕ),
    (U : Filter ℕ) ≤ Filter.cofinite →
    (∃ φ : Ultraproduct U G →* A, Function.Surjective φ) →
    ∃ (H : ℕ → Type) (_ : ∀ i, CommGroup (H i)) (V : Ultrafilter ℕ),
      (V : Filter ℕ) ≤ Filter.cofinite ∧ ∃ ψ : Ultraproduct V H →* A, Function.Surjective ψ

open Filter

-- At coordinate i, solve the first i equations backwards from the identity.
private def partialSolution {G : ℕ → Type} [∀ i, Group (G i)] (g : ℕ → ∀ i, G i)
    (i n : ℕ) : ℕ → G i
  | 0 => 1
  | depth + 1 => g n i * partialSolution g i (n + 1) depth ^ (n + 1)

private theorem solveRecurrence {A : Type} [CommGroup A] {G : ℕ → Type} [∀ i, Group (G i)]
    {U : Ultrafilter ℕ} (hU : (U : Filter ℕ) ≤ cofinite)
    (φ : Ultraproduct U G →* A) (hφ : Function.Surjective φ) (a : ℕ → Additive A) :
    ∃ b : ℕ → Additive A, ∀ n, b n = a n + (n + 1) • b (n + 1) := by
  let π := QuotientGroup.mk' (ultraproductKernel U G)
  let f := φ.comp π
  choose g hg using fun n => (hφ.comp (QuotientGroup.mk'_surjective _)) (a n).toMul
  let x (n i : ℕ) := partialSolution g i n (i - n)
  refine ⟨fun n => Additive.ofMul (f (x n)), fun n => ?_⟩
  change f (x n) = (a n).toMul * f (x (n + 1)) ^ (n + 1)
  have hgn : f (g n) = (a n).toMul := hg n
  rw [← hgn, ← map_pow, ← map_mul]
  apply congrArg φ
  apply QuotientGroup.eq.mpr
  apply Subgroup.subset_normalClosure
  have h := (eventually_gt_atTop n).filter_mono (hU.trans_eq Nat.cofinite_eq_atTop)
  filter_upwards [h] with i hi
  change (x n i)⁻¹ * (g n i * x (n + 1) i ^ (n + 1)) = 1
  have e : i - n = i - (n + 1) + 1 := by omega
  simp [x, e, partialSolution]

private theorem factorial_step (n : ℕ) :
    (n + 1) • (((n + 1).factorial : ℚ)⁻¹) = (n.factorial : ℚ)⁻¹ := by
  rw [Nat.factorial_succ, Nat.cast_mul, nsmul_eq_mul, mul_inv_rev, mul_comm]
  rw [mul_assoc, inv_mul_cancel₀ (by positivity), mul_one]

-- The compatible lifts of 1/n! generate the graph of a lift on all of ℚ.
private theorem liftRat {D C : Type*} [AddCommGroup D] [AddCommGroup C] (p : D →+ C)
    (f : ℚ →+ C) (y : ℕ → D) (hy : ∀ n, (n + 1) • y (n + 1) = y n)
    (hp : ∀ n, p (y n) = f (n.factorial : ℚ)⁻¹) :
    ∃ g : ℚ →+ D, p.comp g = f := by
  let v (n : ℕ) : ℚ × D := ((n.factorial : ℚ)⁻¹, y n)
  let S (n : ℕ) := AddSubgroup.zmultiples (v n)
  have step (n : ℕ) : (n + 1) • v (n + 1) = v n := by
    exact Prod.ext (factorial_step n) (hy n)
  have mono : Monotone S := monotone_nat_of_le_succ fun n => by
    apply AddSubgroup.zmultiples_le.mpr
    rw [← step n]
    exact (S (n + 1)).nsmul_mem (AddSubgroup.mem_zmultiples _) _
  let T := ⨆ n, S n
  have mem {w : ℚ × D} : w ∈ T ↔ ∃ (n : ℕ) (z : ℤ), z • v n = w := by
    simp only [T, AddSubgroup.mem_iSup_of_directed mono.directed_le, S,
      AddSubgroup.mem_zmultiples_iff]
  let π := (AddMonoidHom.fst ℚ D).comp T.subtype
  have inj : Function.Injective π := (injective_iff_map_eq_zero π).2 fun w hw => by
    obtain ⟨n, z, hz⟩ := mem.mp w.property
    have h : (z : ℚ) * (n.factorial : ℚ)⁻¹ = 0 :=
      (congrArg Prod.fst hz).trans hw
    have : z = 0 := by simpa [Nat.factorial_ne_zero] using h
    exact Subtype.ext (by simpa [this] using hz.symm)
  have surj : Function.Surjective π := fun q => by
    obtain ⟨k, hk⟩ := Nat.dvd_factorial q.den_pos (le_refl q.den)
    let z : ℤ := q.num * k
    refine ⟨⟨z • v q.den, mem.mpr ⟨_, _, rfl⟩⟩, ?_⟩
    change (z : ℚ) * (q.den.factorial : ℚ)⁻¹ = q
    apply Eq.trans _ q.num_div_den
    rw [hk]
    push_cast [z]
    have hk0 : k ≠ 0 := by
      intro h
      simp [h, Nat.factorial_ne_zero] at hk
    field_simp
  let e := AddEquiv.ofBijective π ⟨inj, surj⟩
  refine ⟨((AddMonoidHom.snd ℚ D).comp T.subtype).comp e.symm.toAddMonoidHom, ?_⟩
  ext q
  obtain ⟨w, rfl⟩ := e.surjective q
  change p (e.symm (e w)).val.2 = f w.val.1
  rw [e.symm_apply_apply]
  obtain ⟨n, z, hz⟩ := mem.mp w.property
  rw [← hz]
  change p (z • y n) = f (z • (n.factorial : ℚ)⁻¹)
  simp only [map_zsmul, hp]

private theorem liftRatQuotient {A D : Type*} [AddCommGroup A] [AddCommGroup D]
    (solve : ∀ a : ℕ → A, ∃ b : ℕ → A, ∀ n, b n = a n + (n + 1) • b (n + 1))
    (j : A →+ D) (f : ℚ →+ D ⧸ j.range) :
    ∃ g : ℚ →+ D, (QuotientAddGroup.mk' j.range).comp g = f := by
  let p := QuotientAddGroup.mk' j.range
  choose x hx using fun n : ℕ => QuotientAddGroup.mk'_surjective j.range (f (n.factorial : ℚ)⁻¹)
  have diff (n : ℕ) : x n - (n + 1) • x (n + 1) ∈ j.range := by
    apply (QuotientAddGroup.eq_zero_iff _).mp
    change p (_ - _) = 0
    rw [map_sub, map_nsmul, show p (x n) = _ from hx n, show p (x (n + 1)) = _ from hx _,
      ← map_nsmul, factorial_step, sub_self]
  choose a ha using diff
  obtain ⟨b, hb⟩ := solve a
  apply liftRat p f (fun n => x n - j (b n))
  · intro n
    rw [hb n, map_add, ha, map_nsmul, smul_sub]
    abel
  · intro n
    rw [map_sub, show p (j (b n)) = 0 from (QuotientAddGroup.eq_zero_iff _).mpr ⟨_, rfl⟩,
      sub_zero]
    exact hx n

-- Lift on each rational basis line and add the lifts over the finite support of a vector.
private theorem liftRatSpace {D C V : Type*} [AddCommGroup D] [AddCommGroup C] [AddCommGroup V]
    [Module ℚ V] (p : D →+ C) (liftLine : ∀ f : ℚ →+ C, ∃ g : ℚ →+ D, p.comp g = f)
    (f : V →+ C) : ∃ g : V →+ D, p.comp g = f := by
  classical
  let basis := Module.Free.chooseBasis ℚ V
  let line (i : _) := (LinearMap.toSpanSingleton ℚ V (basis i)).toAddMonoidHom
  choose h hh using fun i => liftLine (f.comp (line i))
  refine ⟨(Finsupp.liftAddHom h).comp basis.repr.toAddMonoidHom, ?_⟩
  apply AddMonoidHom.ext fun v => ?_
  obtain ⟨c, rfl⟩ := basis.repr.symm.surjective v
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | single i r =>
    change p (Finsupp.liftAddHom h (basis.repr (basis.repr.symm _))) = _
    rw [basis.repr.apply_symm_apply, Finsupp.liftAddHom_apply_single, basis.repr_symm_single]
    exact DFunLike.congr_fun (hh i) r

-- Embed A in a divisible group D. The obstruction to making a D-valued extension
-- land in A factors through B/i(F), and can be lifted on its rational vector space hull.
private theorem extendAcross {A F B : Type} [AddCommGroup A] [AddCommGroup F] [AddCommGroup B]
    (solve : ∀ a : ℕ → A, ∃ b : ℕ → A, ∀ n, b n = a n + (n + 1) • b (n + 1))
    (i : F →+ B) (hi : Function.Injective i) [HasUniqueDiv (B ⧸ i.range)] (f : F →+ A) :
    ∃ g : B →+ A, g.comp i = f := by
  classical
  let D := CharacterModule A → AddCircle (1 : ℚ)
  let j : A →+ D :=
    { toFun := fun a c => c a
      map_zero' := funext fun c => map_zero c
      map_add' := fun a b => funext fun c => map_add c a b }
  have hj : Function.Injective j := (injective_iff_map_eq_zero j).2 fun _ h =>
    CharacterModule.eq_zero_of_character_apply fun c => congrFun h c
  obtain ⟨u, hu⟩ := (Module.Baer.of_divisible D).extension_property_addMonoidHom i hi (j.comp f)
  let p := QuotientAddGroup.mk' j.range
  let q := QuotientAddGroup.mk' i.range
  let obs := QuotientAddGroup.lift i.range (p.comp u) (by
    rintro _ ⟨x, rfl⟩
    change p (u (i x)) = 0
    rw [show u (i x) = j (f x) from DFunLike.congr_fun hu x]
    exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨_, rfl⟩)
  let h := DivisibleHull.coeAddMonoidHom (B ⧸ i.range)
  let : DivisibleBy (D ⧸ j.range) ℤ :=
    (QuotientAddGroup.mk'_surjective j.range).divisibleBy p (fun a n => map_zsmul p n a)
  obtain ⟨v, hv⟩ := (Module.Baer.of_divisible _).extension_property_addMonoidHom h
    DivisibleHull.coe_injective obs
  obtain ⟨w, hw⟩ := liftRatSpace p (liftRatQuotient solve j) v
  let correction := w.comp (h.comp q)
  have lands (b : B) : (u - correction) b ∈ j.range := by
    apply (QuotientAddGroup.eq_zero_iff _).mp
    change p (u b - w (h (q b))) = 0
    rw [map_sub, show p (w (h (q b))) = v (h (q b)) from DFunLike.congr_fun hw _,
      show v (h (q b)) = obs (q b) from DFunLike.congr_fun hv _]
    exact sub_self _
  let g := (AddMonoidHom.ofInjective hj).symm.toAddMonoidHom.comp
    ((u - correction).codRestrict _ lands)
  refine ⟨g, AddMonoidHom.ext fun x => hj ?_⟩
  change j ((AddMonoidHom.ofInjective hj).symm _) = j (f x)
  rw [AddMonoidHom.apply_ofInjective_symm]
  change u (i x) - w (h (q (i x))) = j (f x)
  rw [show q (i x) = 0 from (QuotientAddGroup.eq_zero_iff _).mpr ⟨_, rfl⟩]
  simpa using DFunLike.congr_fun hu x

-- In an ultrapower of a torsion-free group, a sequence whose nonzero multiple is
-- constant almost everywhere is itself constant almost everywhere.
private def diagonal (l : Filter ℕ) (F : Type) [AddCommGroup F] : F →+ Germ l F where
  toFun x := ↑x
  map_zero' := rfl
  map_add' _ _ := rfl

private theorem diagonalQuotient_hasUniqueDiv (l : Filter ℕ) [NeBot l] (F : Type)
    [AddCommGroup F] [HasUniqueDiv F] : HasUniqueDiv (Germ l F ⧸ (diagonal l F).range) where
  nsmul_right_injective {n} hn := by
    let Q := Germ l F ⧸ (diagonal l F).range
    apply (injective_iff_map_eq_zero (DistribSMul.toAddMonoidHom Q n)).2
    intro x hx
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective (diagonal l F).range x
    induction y using Germ.inductionOn with | _ y
    apply (QuotientAddGroup.eq_zero_iff _).mpr
    obtain ⟨a, ha⟩ := (QuotientAddGroup.eq_zero_iff (n • (y : Germ l F))).mp hx
    have he : ∀ᶠ k in l, a = n • y k := Germ.coe_eq.mp ha
    obtain ⟨k, hk⟩ := he.exists
    refine ⟨y k, Germ.coe_eq.mpr ?_⟩
    exact he.mono fun t ht => nsmul_right_injective hn (hk.symm.trans ht)

/--
**Abelian images of ultraproducts are images of abelian ultraproducts.** Let $A$ be an abelian
group, let $(G_i)_{i \in \mathbb{N}}$ be a sequence of (not necessarily abelian) groups, and let $U$
be a nonprincipal ultrafilter on $\mathbb{N}$, that is, one containing every cofinite set. If there
is a surjective homomorphism from the ultraproduct $\left(\prod_i G_i\right)/U$ onto $A$, then there
are a sequence $(H_i)_{i \in \mathbb{N}}$ of abelian groups and a nonprincipal ultrafilter $V$ on
$\mathbb{N}$ with a surjective homomorphism from $\left(\prod_i H_i\right)/V$ onto $A$.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems
in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 20.13 (G. M.
Bergman); resolution: S. M. Corson, On homomorphic images of ultraproducts, preprint,
arXiv:2503.09228 (2025), Theorem 17 with Proposition 10: an abelian group is cotorsion iff it is an
image of (∏ G_i)/(⊕ G_i) for some sequence of groups, iff an image of a product of finite cyclic
groups, iff an image of a product of finite groups, and cotorsion groups are images of nonprincipal
ultraproducts of abelian groups; Questions 1 and 2 (Kourovka 20.13(a), (b)) are answered
affirmatively, https://arxiv.org/abs/2503.09228.
-/
public theorem abelianImageOfUltraproductIsImageOfAbelianUltraproduct_holds :
    abelianImageOfUltraproductIsImageOfAbelianUltraproduct := by
  intro A _ G _ U hU ⟨φ, hφ⟩
  classical
  let F := A →₀ ℤ
  let l : Filter ℕ := U
  let eval : F →+ Additive A := Finsupp.liftAddHom fun a : A => zmultiplesHom _ (Additive.ofMul a)
  have heval (a : A) : eval (Finsupp.single a 1) = Additive.ofMul a := by
    exact (Finsupp.liftAddHom_apply_single (fun x : A => zmultiplesHom _ (Additive.ofMul x)) a
      (1 : ℤ)).trans (one_zsmul _)
  have : HasUniqueDiv (Germ l F ⧸ (diagonal l F).range) := diagonalQuotient_hasUniqueDiv l F
  obtain ⟨g, hg⟩ := extendAcross (solveRecurrence hU φ hφ) (diagonal l F)
    (fun _ _ h => Germ.const_inj.mp h) eval
  let ψ : (ℕ → Multiplicative F) →* A :=
    (g.comp (Germ.coeAddHom l)).toMultiplicativeLeft
  have hψ : ultraproductKernel U (fun _ => Multiplicative F) ≤ ψ.ker := by
    apply Subgroup.normalClosure_le_normal
    intro x hx
    change g (Germ.ofFun (fun n => (x n).toAdd) : Germ l F) = 0
    rw [show (Germ.ofFun (fun n => (x n).toAdd) : Germ l F) = 0 from Germ.coe_eq.mpr hx, map_zero]
  refine ⟨fun _ => Multiplicative F, inferInstance, U, hU, QuotientGroup.lift _ ψ hψ,
    QuotientGroup.lift_surjective_of_surjective _ _ ?_ hψ⟩
  intro a
  refine ⟨fun _ => Multiplicative.ofAdd (Finsupp.single a 1), ?_⟩
  exact (DFunLike.congr_fun hg (Finsupp.single a 1)).trans (heval a)

end MathlibExt.GroupTheory.AbelianImagesUltraproductsKourovka20Problem13Wanted
