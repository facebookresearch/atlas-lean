import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Subgroups of p-th powers in finite p-groups (Kourovka Notebook Problem 21.137)

This file proves that the subgroup of `p`-th powers can fail to be powerful for every prime `p`.

Kourovka Notebook, Problem 21.137 (L. Wilson), marked solved in the 21st issue: if the `p`-th powers
in a finite `p`-group form a subgroup, must that subgroup be powerful? That is, for `p ≠ 2`, if the
`p`-th powers in a `p`-group of exponent `p²` form a subgroup, must that subgroup be abelian? For a
`2`-group of exponent `8`, if the squares form a subgroup, must that subgroup be abelian?

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 21.137 (L. Wilson). UnsolvedMath record
UM-00002646 (`KOU-21.137`), dataset ulamai/UnsolvedMath v1.8.0.

The set of `p`-th powers is the literal set `{x^p}`; a subgroup `P` is powerful when `[P, P] ≤ P^p`
(`p` odd) or `[P, P] ≤ P⁴` (`p = 2`), with `P^m` generated by the `m`-th powers of elements of `P`.
The questions are posed for a prime `p`; both are refuted for every relevant prime, so each target
is stated for some prime and its refutation covers all of them. The exponent-`8` question for `p =
2` is answered by one explicit group of order `128` (the Sylow `2`-subgroup of `S₈`), a finite
check, and is not stated separately.
-/

namespace MathlibExt.GroupTheory.PthPowersSubgroupPowerfulKourovka21Problem137Wanted

/-- **Kourovka 21.137, main question.** The proposition that there is a prime $p$ such that for
every finite $p$-group $G$ and every subgroup $P$ of $G$ whose underlying set is exactly the set
$\{x^p : x \in G\}$ of $p$-th powers in $G$, the subgroup $P$ is powerful: its commutator subgroup
$[P, P]$ is contained in the subgroup $P^m$ generated by the $m$-th powers of the elements of $P$,
where $m = p$ for odd $p$ and $m = 4$ for $p = 2$.

Kourovka Problem 21.137 (L. Wilson) asks this for each prime; it is stated here for some prime, so
that its refutation covers all of them. -/
@[expose] public def pthPowersSubgroupPowerful : Prop :=
  ∃ p : ℕ, p.Prime ∧ ∀ (G : Type) [Group G] [Finite G], IsPGroup p G →
    ∀ P : Subgroup G, (P : Set G) = {g | ∃ x : G, x ^ p = g} →
      ⁅P, P⁆ ≤ Subgroup.closure ((fun x : G => x ^ (if p = 2 then 4 else p)) '' (P : Set G))

private lemma commute_of_powerful {G : Type*} [Group G] {P : Subgroup G} {m : ℕ}
    (hpow : ∀ x ∈ P, x ^ m = 1)
    (h : ⁅P, P⁆ ≤ Subgroup.closure ((fun x : G => x ^ m) '' (P : Set G))) :
    ∀ x ∈ P, ∀ y ∈ P, x * y = y * x := by
  have hbot : Subgroup.closure ((fun x : G => x ^ m) '' (P : Set G)) ≤ ⊥ := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, hx, rfl⟩
    exact Subgroup.mem_bot.mpr (hpow x hx)
  intro x hx y hy
  exact commutatorElement_eq_one_iff_mul_comm.mp
    (Subgroup.mem_bot.mp (hbot (h (Subgroup.commutator_mem_commutator hx hy))))

private abbrev D := DihedralGroup 4
private abbrev C := Multiplicative (ZMod 2)
private abbrev W := D ≀ᵣ C

private def flip : C := Multiplicative.ofAdd 1

private lemma cycle_cases (q : C) : q = 1 ∨ q = flip :=
  (by decide +kernel : ∀ i : C, i = 1 ∨ i = flip) q

private lemma flip_ne_one : flip ≠ 1 := by decide
private lemma flip_inv : flip⁻¹ = flip := by decide
private lemma flip_mul_flip : flip * flip = 1 := by decide

-- Reduction of the rotation index modulo two gives the Klein four quotient of D₈.
private def dihedralQuotient : D →* DihedralGroup 2 where
  toFun
    | .r i => .r (ZMod.castHom (by decide : 2 ∣ 4) (ZMod 2) i)
    | .sr i => .sr (ZMod.castHom (by decide : 2 ∣ 4) (ZMod 2) i)
  map_one' := rfl
  map_mul' x y := by
    cases x <;> cases y <;>
      simp only [DihedralGroup.r_mul_r, DihedralGroup.r_mul_sr, DihedralGroup.sr_mul_r,
        DihedralGroup.sr_mul_sr, map_add, map_sub]

private def wreathPair (a b : D) (q : C) : W :=
  ⟨fun i => if i = 1 then a else b, q⟩

@[local simp] private lemma wreathPair_left_one (a b : D) (q : C) :
    (wreathPair a b q).left 1 = a := by
  simp [wreathPair]

@[local simp] private lemma wreathPair_left_flip (a b : D) (q : C) :
    (wreathPair a b q).left flip = b := by
  simp [wreathPair, flip_ne_one]

@[local simp] private lemma wreathPair_right (a b : D) (q : C) :
    (wreathPair a b q).right = q := rfl

private lemma wreathPair_eta (w : W) :
    wreathPair (w.left 1) (w.left flip) w.right = w := by
  apply RegularWreathProduct.ext
  · funext i
    rcases cycle_cases i with rfl | rfl <;> simp
  · rfl

private lemma wreathPair_mul_one (a b c d : D) (q : C) :
    wreathPair a b 1 * wreathPair c d q = wreathPair (a * c) (b * d) q := by
  apply RegularWreathProduct.ext
  · funext i
    rcases cycle_cases i with rfl | rfl <;> simp [Pi.mul_apply]
  · simp

private lemma wreathPair_sq_flip (a b : D) :
    wreathPair a b flip ^ 2 = wreathPair (a * b) (b * a) 1 := by
  rw [pow_two]
  apply RegularWreathProduct.ext
  · funext i
    rcases cycle_cases i with rfl | rfl
    · simp [Pi.mul_apply, flip_inv]
    · simp [Pi.mul_apply]
  · simp [flip_mul_flip]

-- The squares are the pairs in the base with equal images in the Klein four quotient.
private def squareSubgroup : Subgroup W where
  carrier := {w | w.right = 1 ∧ dihedralQuotient (w.left 1) = dihedralQuotient (w.left flip)}
  one_mem' := ⟨rfl, rfl⟩
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨by simp [ha, hb], ?_⟩
    change dihedralQuotient ((a * b).left 1) = dihedralQuotient ((a * b).left flip)
    simp [Pi.mul_apply, ha, ha', hb']
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    refine ⟨by simp [ha], ?_⟩
    change dihedralQuotient ((a⁻¹).left 1) = dihedralQuotient ((a⁻¹).left flip)
    simp [Pi.inv_apply, ha, ha']

private lemma wreathPair_mem_squareSubgroup (a b : D) (q : C) :
    wreathPair a b q ∈ squareSubgroup ↔ q = 1 ∧ dihedralQuotient a = dihedralQuotient b := by
  change (wreathPair a b q).right = 1 ∧
    dihedralQuotient ((wreathPair a b q).left 1) =
      dihedralQuotient ((wreathPair a b q).left flip) ↔ _
  simp only [wreathPair_right, wreathPair_left_one, wreathPair_left_flip]

-- In the base a square has form (a², b²); squaring a swap gives (ab, ba).
private lemma dihedral_pair_has_square_root :
    ∀ u v : D, dihedralQuotient u = dihedralQuotient v →
      (∃ a b : D, a * a = u ∧ b * b = v) ∨ (∃ a b : D, a * b = u ∧ b * a = v) := by
  decide +kernel

private lemma squareSubgroup_eq : (squareSubgroup : Set W) = {w | ∃ x : W, x ^ 2 = w} := by
  ext w
  constructor
  · intro hw
    obtain ⟨hr, hq⟩ := (wreathPair_mem_squareSubgroup _ _ _).mp (wreathPair_eta w ▸ hw)
    have hw' := wreathPair_eta w
    rw [hr] at hw'
    rcases dihedral_pair_has_square_root _ _ hq with ⟨a, b, ha, hb⟩ | ⟨a, b, ha, hb⟩
    · exact ⟨wreathPair a b 1, by rw [pow_two, wreathPair_mul_one, ha, hb, hw']⟩
    · exact ⟨wreathPair a b flip, by rw [wreathPair_sq_flip, ha, hb, hw']⟩
  · rintro ⟨x, rfl⟩
    change x ^ 2 ∈ squareSubgroup
    rw [← wreathPair_eta x]
    rcases cycle_cases x.right with h | h
    · rw [h, pow_two, wreathPair_mul_one, wreathPair_mem_squareSubgroup]
      have hs (a : DihedralGroup 2) : a * a = 1 := by
        simpa only [IsKleinFour.exponent_two, pow_two] using Monoid.pow_exponent_eq_one a
      simp [hs]
    · rw [h, wreathPair_sq_flip, wreathPair_mem_squareSubgroup]
      let _ := IsKleinFour.isMulCommutative (G := DihedralGroup 2)
      simp [mul_comm']

private lemma squareSubgroup_fourth_power (w : W) (hw : w ∈ squareSubgroup) : w ^ 4 = 1 := by
  have hr : w.right = 1 := hw.1
  have hD (a : D) : a * a * (a * a) = 1 := by
    rw [← pow_two a, ← pow_two (a ^ 2), ← pow_mul]
    have he : Monoid.exponent D = 4 := DihedralGroup.exponent
    simpa only [he] using Monoid.pow_exponent_eq_one a
  change w ^ (2 * 2) = 1
  rw [pow_mul, ← wreathPair_eta w, hr]
  simp only [pow_two, wreathPair_mul_one, hD]
  apply RegularWreathProduct.ext
  · funext i
    simp [wreathPair]
  · rfl

private lemma not_powerful_at_two
    (h : ∀ (G : Type) [Group G] [Finite G], IsPGroup 2 G →
      ∀ P : Subgroup G, (P : Set G) = {g | ∃ x : G, x ^ 2 = g} →
        ⁅P, P⁆ ≤ Subgroup.closure ((fun x : G => x ^ 4) '' (P : Set G))) : False := by
  have hW : IsPGroup 2 W := by
    apply IsPGroup.of_card (n := 7)
    have hC : Nat.card C = 2 := by
      change Nat.card (ZMod 2) = 2
      rw [Nat.card_eq_fintype_card, ZMod.card]
    rw [RegularWreathProduct.card, DihedralGroup.nat_card, hC]
    rfl
  let a : D := .r 1
  let b : D := .sr 0
  have ha : wreathPair a a 1 ∈ squareSubgroup :=
    (wreathPair_mem_squareSubgroup ..).mpr ⟨rfl, rfl⟩
  have hb : wreathPair b b 1 ∈ squareSubgroup :=
    (wreathPair_mem_squareSubgroup ..).mpr ⟨rfl, rfl⟩
  have hcomm := commute_of_powerful squareSubgroup_fourth_power
    (h W hW squareSubgroup squareSubgroup_eq) _ ha _ hb
  apply (by decide : a * b ≠ b * a)
  simpa only [wreathPair_mul_one, wreathPair_left_one] using
    congrArg (fun w : W => w.left 1) hcomm

/--
**Kourovka 21.137 fails for every prime.** For every prime $p$ there is a finite $p$-group $G$
with a subgroup $P$ whose underlying set is exactly the set $\{x^p : x \in G\}$ of $p$-th powers in
$G$, such that $P$ is not powerful: the commutator subgroup $[P, P]$ is not contained in the
subgroup $P^m$ generated by the $m$-th powers of the elements of $P$, where $m = p$ for odd $p$
and $m = 4$ for $p = 2$.

For odd $p$ a counterexample is Muliarchyk's group of order $p^{3p+1}$ and exponent $p^2$, whose
$p$-th powers form a non-abelian subgroup of exponent $p$; for $p = 2$ it is the Sylow
$2$-subgroup of $S_8$, whose squares form $C_2 \times D_8$ (letter of A. Chang). The 21st issue of
the Kourovka Notebook marks Problem 21.137 solved ("No, it need not be").

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved
Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem
21.137 (L. Wilson); resolution: K. Muliarchyk, A counterexample to Kourovka Problem 21.137 for p =
3, preprint (2026), and A non-powerful subgroup of p-th powers for every odd prime, preprint (2026),
Kourovka Notebook site; letter of A. Chang of 1 August 2026, Muliarchyk (every odd prime), abstract
and Section 1: for each odd prime p an affine group V ⋊ B_p (V = F_p[r]/(r^(2p))) of order p^(3p+1)
and exponent p² whose set of p-th powers is a subgroup isomorphic to UT₃(F_p) × C_p^(p-1),
non-abelian of exponent p, hence not powerful; Kourovka Notebook (21st issue), Problem 21.137: No,
it need not be (p = 3: Muliarchyk, order 3^15; p = 2: the Sylow 2-subgroup of S₈ has exponent 8 and
its squares form the non-abelian, non-powerful subgroup C₂ × D₈, letter of A. Chang),
https://kourovkanotebookorg.wordpress.com/wp-content/uploads/2026/09/kourovka_21.137_solution.pdf.
-/
public theorem pthPowersSubgroupPowerful_refuted : ¬ pthPowersSubgroupPowerful := by
  rintro ⟨p, hp, h⟩
  by_cases hp2 : p = 2
  · subst p
    exact not_powerful_at_two (by simpa using h)
  · refine pthPowersSubgroupAbelianExponentPSq_refuted ⟨p, hp, hp2, ?_⟩
    intro G _ _ hG hExp P hP
    have hpow : ∀ x ∈ P, x ^ p = 1 := by
      intro x hx
      change x ∈ (P : Set G) at hx
      rw [hP] at hx
      obtain ⟨y, rfl⟩ := hx
      rw [← pow_mul, ← pow_two, ← hExp, Monoid.pow_exponent_eq_one]
    exact commute_of_powerful hpow (by simpa [hp2] using h G hG P hP)

end MathlibExt.GroupTheory.PthPowersSubgroupPowerfulKourovka21Problem137Wanted
