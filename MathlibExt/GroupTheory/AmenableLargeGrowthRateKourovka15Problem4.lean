/-!
# Amenable groups with nearly maximal growth

Following Arzhantseva, Guba and Guyot, we concatenate reduced blocks of positive height, using a
finite permutation quotient to rule out short returns. In the quotient with the height coordinate
adjoined, the paths are simple. A lamp on each edge records whether the path used that edge.
-/

namespace MathlibExt.GroupTheory.AmenableLargeGrowthRateKourovka15Problem4Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 15.4 (P. de la
Harpe). UnsolvedMath record UM-00701092 (`KOU-15.4`), dataset ulamai/UnsolvedMath v1.8.0.

`ω(Γ, S) = limsup β_S(n)^(1/n)`, where `β_S(n)` counts the products of at most `n` elements of `S ∪
S⁻¹` (14.7), and `S` is an injective family of `k` generators. The source asks, for each `k ≥ 2`,
whether some `ε > 0` works. The target is stated for some `k ≥ 2` with some `ε > 0` (the strongest
true form, existential when refuted, as in WantedExt/Sources/UnsolvedMath.md), so its refutation
asserts that for every `k ≥ 2` and every `ε > 0` some amenable group generated by `k` elements has
growth rate at least `2k - 1 - ε`: stronger than the source's negative answer, which needs one `k`,
and what Arzhantseva, Guba and Guyot prove (for every `m ≥ 2` the growth rate of `F_m/R'` tends to
`2m - 1` as the shortest relator in `R` grows, with amenable, e.g. abelian-by-nilpotent, examples).
Amenability is MathlibExt's Følner-condition `IsAmenable`.
-/

@[expose] public section

/-- **Growth rate of a $k$-element generating family (Kourovka 14.7).** Let $\Gamma$ be a group
and $S = (s_1, \dots, s_k)$ a family of $k$ elements generating $\Gamma$. For $n \in \mathbb{N}$ let
$\beta_S(n)$ be the number of elements of $\Gamma$ that are products of at most $n$ elements of
$S \cup S^{-1}$. The growth rate of $\Gamma$ with respect to $S$ is the real number
$\omega(\Gamma, S) = \limsup_{n \to \infty} \beta_S(n)^{1/n}$. -/
noncomputable def growthRate {Γ : Type*} [Group Γ] {k : ℕ} (S : Group.Generators Γ (Fin k)) : ℝ :=
  Filter.limsup (fun n : ℕ => (Nat.card {g : Γ // S.wordLength g ≤ n} : ℝ) ^ ((1 : ℝ) / n))
    Filter.atTop

/-- **Kourovka Problem 15.4 (large growth rate implies non-amenability).** The proposition, asked
by P. de la Harpe, that there are $k \ge 2$ and a real $\varepsilon > 0$ such that every group
$\Gamma$ generated by a family $S$ of $k$ distinct elements whose growth rate satisfies
$\omega(\Gamma, S) \ge 2k - 1 - \varepsilon$ is non-amenable (amenability being the Følner
condition). -/
def largeGrowthRateImpliesNonamenable : Prop :=
  ∃ k : ℕ, 2 ≤ k ∧ ∃ ε : ℝ, 0 < ε ∧ ∀ (Γ : Type) [Group Γ] (S : Group.Generators Γ (Fin k)),
    Function.Injective S.val → 2 * (k : ℝ) - 1 - ε ≤ growthRate S → ¬ IsAmenable Γ

end

private abbrev Letter (α : Type*) := α × Bool

private def step {α G : Type*} [Group G] (s : α → G) (a : Letter α) : G :=
  cond a.2 (s a.1) (s a.1)⁻¹

private def word {α G : Type*} [Group G] (s : α → G) (w : List (Letter α)) : G :=
  FreeGroup.lift s (FreeGroup.mk w)

private theorem word_nil {α G : Type*} [Group G] (s : α → G) : word s [] = 1 := by
  simp [word, FreeGroup.lift_mk]

private theorem word_cons {α G : Type*} [Group G] (s : α → G) (a : Letter α)
    (w : List (Letter α)) : word s (a :: w) = step s a * word s w := by
  simp [word, step, FreeGroup.lift_mk]

private theorem word_append {α G : Type*} [Group G] (s : α → G) (u v : List (Letter α)) :
    word s (u ++ v) = word s u * word s v := by
  simp [word, ← FreeGroup.mul_mk]

private def padWord {α : Type*} (n : ℕ) (w : List α) (hw : w.length ≤ n) :
    List.Vector (Option α) n :=
  ⟨w.map some ++ List.replicate (n - w.length) none, by simp; omega⟩

private theorem unpad_padWord {α : Type*} (n : ℕ) (w : List α) (hw : w.length ≤ n) :
    (padWord n w hw).1.filterMap id = w := by
  simp [padWord, List.filterMap_map]

private theorem finite_shortWords (α : Type*) [Finite α] (n : ℕ) :
    Finite {w : List α // w.length ≤ n} := by
  refine Finite.of_injective (fun w : {w : List α // w.length ≤ n} => padWord n w.1 w.2) ?_
  intro w v e
  apply Subtype.ext
  simpa only [unpad_padWord] using congrArg (fun x : List.Vector (Option α) n => x.1.filterMap id) e

private abbrev FreeBall (α : Type*) [DecidableEq α] (n : ℕ) :=
  {g : FreeGroup α // g.norm ≤ n}

private theorem finite_freeBall (α : Type*) [Finite α] [DecidableEq α] (n : ℕ) :
    Finite (FreeBall α n) := by
  have := finite_shortWords (Letter α) n
  exact Finite.of_injective (fun g : FreeBall α n =>
    (⟨g.1.toWord, g.2⟩ : {w : List (Letter α) // w.length ≤ n}))
    (fun _ _ h => Subtype.ext (FreeGroup.toWord_injective (congrArg Subtype.val h)))

-- Extend each partially defined left translation of the free ball to a full permutation.
private theorem exists_ballPerm {α : Type*} [Finite α] [DecidableEq α] (n : ℕ) (a : α) :
    ∃ σ : Equiv.Perm (FreeBall α n), ∀ (x : FreeBall α n) (hx : (FreeGroup.of a * x.1).norm ≤ n),
      σ x = ⟨FreeGroup.of a * x.1, hx⟩ := by
  let D := {x : FreeBall α n // (FreeGroup.of a * x.1).norm ≤ n}
  have := finite_freeBall α n
  have : Finite D := inferInstanceAs (Finite {x : FreeBall α n // _})
  let f : D → FreeBall α n := Subtype.val
  let g : D → FreeBall α n := fun x => ⟨FreeGroup.of a * x.1.1, x.2⟩
  have hg : Function.Injective g := by
    intro x y h
    apply Subtype.ext (Subtype.ext _)
    exact mul_left_cancel (congrArg Subtype.val h)
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair f g Subtype.val_injective hg
  exact ⟨σ, fun x hx => hσ ⟨x, hx⟩⟩

private theorem eval_ballPerm {α : Type*} [DecidableEq α] {n : ℕ}
    (s : α → Equiv.Perm (FreeBall α n))
    (hs : ∀ (a : α) (x : FreeBall α n) (hx : (FreeGroup.of a * x.1).norm ≤ n),
      s a x = ⟨FreeGroup.of a * x.1, hx⟩)
    (w : List (Letter α)) (hw : w.length ≤ n) :
    word s w ⟨1, by simp⟩ = ⟨FreeGroup.mk w, FreeGroup.norm_mk_le.trans hw⟩ := by
  induction w with
  | nil => simp [word_nil, FreeGroup.one_eq_mk]
  | cons a w ih =>
    have htail : w.length ≤ n := by simpa using (Nat.le_of_succ_le hw)
    rw [word_cons, Equiv.Perm.mul_apply, ih htail]
    obtain ⟨j, b⟩ := a
    cases b
    · change (s j)⁻¹ ⟨FreeGroup.mk w, _⟩ = _
      apply (s j).injective
      change (s j) ((s j).symm ⟨FreeGroup.mk w, _⟩) = _
      rw [Equiv.apply_symm_apply]
      have he : FreeGroup.of j * FreeGroup.mk ((j, false) :: w) = FreeGroup.mk w := by
        rw [← List.singleton_append, ← FreeGroup.mul_mk, FreeGroup.mk_eq_inv_of]
        simp
      rw [hs j _ (he ▸ FreeGroup.norm_mk_le.trans htail)]
      exact Subtype.ext he.symm
    · change s j ⟨FreeGroup.mk w, _⟩ = _
      have he : FreeGroup.of j * FreeGroup.mk w = FreeGroup.mk ((j, true) :: w) := by
        rw [← List.singleton_append, ← FreeGroup.mul_mk, FreeGroup.mk_eq_of]
      rw [hs j _ (he.symm ▸ FreeGroup.norm_mk_le.trans hw)]
      exact Subtype.ext he

private theorem exists_short_separation (α : Type) [Finite α] (n : ℕ) :
    ∃ (Q : Type) (_ : Group Q) (_ : Finite Q) (s : α → Q),
      ∀ (w : List (Letter α)), w.length ≤ n → w ≠ [] → FreeGroup.IsReduced w → word s w ≠ 1 := by
  classical
  choose s hs using (exists_ballPerm (α := α) n)
  have := finite_freeBall α n
  refine ⟨Equiv.Perm (FreeBall α n), inferInstance, inferInstance, s, ?_⟩
  intro w hw hw₀ hr he
  have h := eval_ballPerm s hs w hw
  rw [he] at h
  have hm : (1 : FreeGroup α) = FreeGroup.mk w := congrArg Subtype.val h
  apply hw₀
  simpa [FreeGroup.toWord_mk, hr.reduce_eq] using (congrArg FreeGroup.toWord hm).symm

private def height {α : Type*} (w : List (Letter α)) : ℤ :=
  (word (fun _ => Multiplicative.ofAdd (1 : ℤ)) w).toAdd

private theorem height_nil {α : Type*} : height ([] : List (Letter α)) = 0 := by
  simp [height, word_nil]

private theorem height_cons {α : Type*} (a : Letter α) (w : List (Letter α)) :
    height (a :: w) = (if a.2 then 1 else -1) + height w := by
  obtain ⟨a, b⟩ := a
  cases b <;> simp [height, word_cons, step]

private theorem height_append {α : Type*} (u v : List (Letter α)) :
    height (u ++ v) = height u + height v := by
  simp [height, word_append]

private theorem height_invRev {α : Type*} (w : List (Letter α)) :
    height (FreeGroup.invRev w) = -height w := by
  simp [height, word, ← FreeGroup.inv_mk]

private theorem reduced_invRev {α : Type*} {w : List (Letter α)}
    (hw : FreeGroup.IsReduced w) : FreeGroup.IsReduced (FreeGroup.invRev w) := by
  apply FreeGroup.IsReduced.of_forall_not_step
  intro v hv
  exact hw.not_step (by simpa only [FreeGroup.invRev_invRev] using hv.invRev)

private theorem height_bounds {α : Type*} (w : List (Letter α)) :
    -(w.length : ℤ) ≤ height w ∧ height w ≤ w.length := by
  induction w with
  | nil => simp [height_nil]
  | cons a w ih =>
    rw [height_cons, List.length_cons]
    split <;> omega

private def Block (α : Type*) (l : ℕ) :=
  {w : List (Letter α) // w.length = l ∧ FreeGroup.IsReduced w ∧
    w.head?.map Prod.snd = some true ∧ w.getLast?.map Prod.snd = some true ∧ 0 < height w}

private theorem finite_block (α : Type*) [Finite α] (l : ℕ) : Finite (Block α l) := by
  have := finite_shortWords (Letter α) l
  exact Finite.of_injective (fun w : Block α l =>
    (⟨w.1, w.2.1.le⟩ : {v : List (Letter α) // v.length ≤ l}))
    (fun _ _ h => Subtype.ext (congrArg (fun v : {v : List (Letter α) // v.length ≤ l} => v.1) h))

private def opposite {α : Type*} (a : Letter α) : Letter α := (a.1, !a.2)

private theorem follows_of_ne_opposite {α : Type*} {a b : Letter α} (h : b ≠ opposite a) :
    a.1 = b.1 → a.2 = b.2 := by
  obtain ⟨i, p⟩ := a
  obtain ⟨j, q⟩ := b
  intro he
  change i = j at he
  subst j
  cases p <;> cases q <;> simp_all [opposite]

private noncomputable def letterChoice {k : ℕ} (a : Letter (Fin k)) :
    Fin (2 * k - 1) ≃ {b : Letter (Fin k) // b ≠ opposite a} := by
  classical
  apply (Fintype.equivFinOfCardEq ?_).symm
  rw [Fintype.card_subtype_compl (· = opposite a), Fintype.card_subtype_eq]
  simp [Nat.mul_comm]

private noncomputable def decode {k : ℕ} :
    Letter (Fin k) → List (Fin (2 * k - 1)) → List (Letter (Fin k))
  | _, [] => []
  | a, i :: is => let b := letterChoice a i; b.1 :: decode b.1 is

private theorem length_decode {k : ℕ} (a : Letter (Fin k)) (is : List (Fin (2 * k - 1))) :
    (decode a is).length = is.length := by
  induction is generalizing a with
  | nil => rfl
  | cons i is ih => simp [decode, ih]

private theorem reduced_decode {k : ℕ} (a : Letter (Fin k)) (is : List (Fin (2 * k - 1))) :
    FreeGroup.IsReduced (a :: decode a is) := by
  induction is generalizing a with
  | nil => exact FreeGroup.IsReduced.singleton
  | cons i is ih =>
    exact FreeGroup.isReduced_cons_cons.mpr ⟨follows_of_ne_opposite (letterChoice a i).2, ih _⟩

private theorem decode_injective {k : ℕ} (a : Letter (Fin k)) : Function.Injective (decode a) := by
  intro is js h
  induction is generalizing a js with
  | nil =>
    have hlen := congrArg List.length h
    simp only [decode, List.length_nil, length_decode] at hlen
    exact List.length_eq_zero_iff.mp hlen.symm |>.symm
  | cons i is ih =>
    cases js with
    | nil => simp [decode] at h
    | cons j js =>
      simp only [decode, List.cons.injEq] at h
      have e : i = j := (letterChoice a).injective (Subtype.ext h.1)
      subst j
      exact congrArg (List.cons i) (ih _ h.2)

private theorem exists_padded_block {α : Type*} [Nontrivial α] (w : List (Letter α))
    (hr : FreeGroup.IsReduced w) (hh : 0 ≤ height w) :
    ∃ a b : α, ∃ v : Block α (w.length + 2), v.1 = (a, true) :: w ++ [(b, true)] := by
  obtain ⟨a, ha⟩ : ∃ a : α, ∀ p ∈ w.head?, a ≠ p.1 := by
    cases h : w.head? with
    | none => exact ⟨Classical.choice inferInstance, by simp⟩
    | some p =>
      obtain ⟨a, ha⟩ := exists_ne p.1
      exact ⟨a, by simpa using ha⟩
  obtain ⟨b, hb⟩ : ∃ b : α, ∀ p ∈ w.getLast?, b ≠ p.1 := by
    cases h : w.getLast? with
    | none => exact ⟨Classical.choice inferInstance, by simp⟩
    | some p =>
      obtain ⟨b, hb⟩ := exists_ne p.1
      exact ⟨b, by simpa using hb⟩
  have hl : FreeGroup.IsReduced ((a, true) :: w) := by
    cases w with
    | nil => exact FreeGroup.IsReduced.singleton
    | cons p w =>
      exact FreeGroup.isReduced_cons_cons.mpr ⟨fun e => (ha p (by simp) e).elim, hr⟩
  have hp : FreeGroup.IsReduced (((a, true) :: w) ++ [(b, true)]) := by
    apply List.isChain_append.mpr
    refine ⟨hl, List.isChain_singleton _, ?_⟩
    cases w with
    | nil => simp
    | cons p w =>
      rw [List.getLast?_cons_cons]
      intro x hx y hy
      simp only [List.head?_cons, Option.mem_some_iff] at hy
      subst y
      exact fun e => (hb x hx e.symm).elim
  refine ⟨a, b, ⟨((a, true) :: w) ++ [(b, true)], by simp, hp, by simp, ?_, ?_⟩, rfl⟩
  · rw [List.getLast?_append_of_ne_nil _ (by simp)]
    rfl
  · rw [height_append, height_cons, height_cons, height_nil]
    simp only [ite_true]
    omega

private theorem card_blocks (k n : ℕ) (hk : 2 ≤ k) :
    (2 * k - 1) ^ n ≤ 2 * Nat.card (Block (Fin k) (n + 2)) := by
  classical
  let a : Fin k := ⟨0, by omega⟩
  let b : Fin k := ⟨1, by omega⟩
  have : Nontrivial (Fin k) := ⟨a, b, by simp [a, b]⟩
  have := finite_block (Fin k) (n + 2)
  let W := List.Vector (Fin (2 * k - 1)) n
  let raw (v : W) := decode (a, true) v.1
  let good (v : W) := if 0 ≤ height (raw v) then raw v else FreeGroup.invRev (raw v)
  have hlen (v : W) : (good v).length = n := by
    simp [good, raw, FreeGroup.invRev_length, length_decode, apply_ite List.length]
  have hr (v : W) : FreeGroup.IsReduced (raw v) :=
    (List.isChain_cons.mp (reduced_decode (a, true) v.1)).2
  have hgood (v : W) : ∃ u : Block (Fin k) (n + 2), (u.1.drop 1).take n = good v := by
    have hr' : FreeGroup.IsReduced (good v) := by
      unfold good
      split
      · exact hr v
      · exact reduced_invRev (hr v)
    have hh : 0 ≤ height (good v) := by
      unfold good
      split
      · assumption
      · rw [height_invRev]; omega
    obtain ⟨a, b, u, hu⟩ := exists_padded_block (good v) hr' hh
    revert u
    rw [hlen v]
    intro u hu
    refine ⟨u, ?_⟩
    rw [hu]
    change ((good v ++ [(b, true)]).take n) = good v
    rw [← hlen v, List.take_left]
  choose encode hencode using hgood
  let f (v : W) : Bool × Block (Fin k) (n + 2) := (decide (0 ≤ height (raw v)), encode v)
  have hf : Function.Injective f := by
    intro v v' e
    have hsign := congrArg Prod.fst e
    have hblock := congrArg (fun x : Bool × Block (Fin k) (n + 2) => (x.2.1.drop 1).take n) e
    change _ = _ at hblock
    rw [show (f v).2 = encode v from rfl, show (f v').2 = encode v' from rfl] at hblock
    rw [hencode, hencode] at hblock
    apply Subtype.ext
    apply decode_injective (a, true)
    change decide (0 ≤ height (raw v)) = decide (0 ≤ height (raw v')) at hsign
    have hequiv : (0 ≤ height (raw v)) ↔ (0 ≤ height (raw v')) := by simpa using hsign
    by_cases hv : 0 ≤ height (raw v)
    · simpa [good, hv, hequiv.mp hv] using hblock
    · exact FreeGroup.invRev_injective (by simpa [good, hv, mt hequiv.mpr hv] using hblock)
  have hcard := Nat.card_le_card_of_injective f hf
  rw [Nat.card_prod, Nat.card_eq_fintype_card (α := Bool)] at hcard
  have hW : Nat.card W = (2 * k - 1) ^ n := by
    rw [Nat.card_congr (Equiv.vectorEquivFin (Fin (2 * k - 1)) n)]
    simp [Nat.card_eq_fintype_card]
  rw [hW] at hcard
  simpa only [Fintype.card_bool] using hcard

private def concatenate {α : Type*} {l : ℕ} (bs : List (Block α l)) : List (Letter α) :=
  (bs.map Subtype.val).flatten

private theorem block_ne_nil {α : Type*} {l : ℕ} (hl : 0 < l) (b : Block α l) : b.1 ≠ [] :=
  fun e => by simpa [e] using hl.trans_eq b.2.1.symm

private theorem length_concatenate {α : Type*} {l : ℕ} (bs : List (Block α l)) :
    (concatenate bs).length = bs.length * l := by
  induction bs with
  | nil => simp only [show concatenate ([] : List (Block α l)) = [] from rfl,
      List.length_nil, Nat.zero_mul]
  | cons b bs ih =>
    change (b.1 ++ concatenate bs).length = (bs.length + 1) * l
    rw [List.length_append, b.2.1, ih, Nat.add_mul, one_mul, Nat.add_comm]

private theorem reduced_concatenate {α : Type*} {l : ℕ} (hl : 0 < l) (bs : List (Block α l)) :
    FreeGroup.IsReduced (concatenate bs) := by
  induction bs with
  | nil => exact FreeGroup.IsReduced.nil
  | cons b bs ih =>
    change FreeGroup.IsReduced (b.1 ++ concatenate bs)
    apply List.isChain_append.mpr
    refine ⟨b.2.2.1, ih, ?_⟩
    intro x hx y hy _
    have hx' : x.2 = true := by
      have h := b.2.2.2.2.1
      rw [Option.mem_def.mp hx] at h
      simpa using h
    have hy' : y.2 = true := by
      cases bs with
      | nil =>
        change y ∈ (none : Option (Letter α)) at hy
        simp at hy
      | cons c cs =>
        change y ∈ (c.1 ++ concatenate cs).head? at hy
        rw [List.head?_append_of_ne_nil _ (block_ne_nil hl c)] at hy
        have h := c.2.2.2.1
        rw [Option.mem_def.mp hy] at h
        simpa using h
    exact hx'.trans hy'.symm

-- A prefix containing room for `t` whole blocks gains at least `t - l` in height.
private theorem height_take_concatenate {α : Type*} {l : ℕ} (hl : 0 < l)
    (bs : List (Block α l)) (i t : ℕ) (ht : t * l ≤ i) (hi : i ≤ (concatenate bs).length) :
    (t : ℤ) - (l : ℤ) ≤ height ((concatenate bs).take i) := by
  induction bs generalizing i t with
  | nil =>
    change i ≤ 0 at hi
    have ht₀ : t = 0 :=
      (Nat.mul_eq_zero.mp (Nat.eq_zero_of_le_zero (ht.trans hi))).resolve_right hl.ne'
    have hi₀ : i = 0 := Nat.eq_zero_of_le_zero hi
    subst i
    simp [ht₀, height_nil]
  | cons b bs ih =>
    change i ≤ (b.1 ++ concatenate bs).length at hi
    change _ ≤ height ((b.1 ++ concatenate bs).take i)
    rw [List.length_append, b.2.1] at hi
    by_cases hil : i < l
    · have ht₀ : t = 0 := by
        by_contra h
        have hm := Nat.mul_le_mul_right l (Nat.one_le_iff_ne_zero.mpr h)
        omega
      rw [List.take_append, show i - b.1.length = 0 by rw [b.2.1]; omega,
        List.take_zero, List.append_nil]
      have hlen : (b.1.take i).length ≤ l := (List.length_take_le ..).trans hil.le
      have hb := (height_bounds (b.1.take i)).1
      omega
    · rw [List.take_append, List.take_of_length_le (b.2.1.trans_le (Nat.le_of_not_gt hil)),
        b.2.1, height_append]
      have hm : (t - 1) * l ≤ i - l := by
        cases t with
        | zero => simp
        | succ t => rw [Nat.succ_mul] at ht; simpa using (show t * l ≤ i - l by omega)
      have h := ih (i - l) (t - 1) hm (by omega)
      have hb := b.2.2.2.2.2
      omega

private def returnBound (l : ℕ) : ℕ := (2 * l + 2) * l

private theorem height_of_long_factor {α : Type*} {l : ℕ} (hl : 0 < l)
    (bs : List (Block α l)) (i n : ℕ) (hn : n ≤ (concatenate bs).length - i)
    (hlarge : returnBound l < n) : 0 < height (((concatenate bs).drop i).take n) := by
  induction bs generalizing i with
  | nil =>
    change n ≤ 0 - i at hn
    omega
  | cons b bs ih =>
    change n ≤ (b.1 ++ concatenate bs).length - i at hn
    change 0 < height (((b.1 ++ concatenate bs).drop i).take n)
    rw [List.length_append, b.2.1] at hn
    rw [List.drop_append, b.2.1]
    by_cases h : l ≤ i
    · rw [List.drop_eq_nil_of_le (b.2.1.trans_le h), List.nil_append]
      exact ih (i - l) (by omega)
    · rw [show i - l = 0 by omega, List.drop_zero, List.take_append]
      have hb : (b.1.drop i).length = l - i := by simp [b.2.1]
      have hlarge' : (2 * l + 1) * l + l < n := by
        simpa only [returnBound, show 2 * l + 2 = (2 * l + 1) + 1 by omega, Nat.add_mul, one_mul]
          using hlarge
      rw [List.take_of_length_le (by omega), hb, height_append]
      have hp := height_take_concatenate hl bs (n - (l - i)) (2 * l + 1) (by omega) (by omega)
      have hb' := (height_bounds (b.1.drop i)).1
      omega

private theorem take_factor {α : Type*} (w : List α) {i j : ℕ} (hij : i ≤ j)
    (hj : j ≤ w.length) : w.take j = w.take i ++ (w.drop i).take (j - i) := by
  nth_rw 1 [← List.take_append_drop i w]
  rw [List.take_append, List.length_take, min_eq_left (hij.trans hj)]
  rw [List.take_of_length_le (by simp; omega)]

private def Simple {α G : Type*} [Group G] (s : α → G) (w : List (Letter α)) : Prop :=
  ∀ i j : ℕ, i < j → j ≤ w.length → word s (w.take i) ≠ word s (w.take j)

private theorem word_height {α Q : Type*} [Group Q] (s : α → Q) (w : List (Letter α)) :
    word (fun a => (s a, Multiplicative.ofAdd (1 : ℤ))) w =
      (word s w, Multiplicative.ofAdd (height w)) := by
  induction w with
  | nil => rw [word_nil, word_nil, height_nil]; rfl
  | cons a w ih =>
    rw [word_cons, ih, word_cons, height_cons]
    obtain ⟨a, b⟩ := a
    cases b <;> rfl

private theorem simple_concatenate {α Q : Type*} [Group Q] {l : ℕ} (hl : 0 < l)
    (s : α → Q)
    (hsep : ∀ w : List (Letter α), w.length ≤ returnBound l → w ≠ [] →
      FreeGroup.IsReduced w → word s w ≠ 1) (bs : List (Block α l)) :
    Simple (fun a => (s a, Multiplicative.ofAdd (1 : ℤ))) (concatenate bs) := by
  intro i j hij hj he
  rw [take_factor _ hij.le hj, word_append] at he
  have hret := mul_left_cancel (he.symm.trans (mul_one _).symm)
  rw [word_height] at hret
  have hq := congrArg Prod.fst hret
  have hz := congrArg (fun x : Q × Multiplicative ℤ => x.2.toAdd) hret
  have hlen : ((concatenate bs).drop i |>.take (j - i)).length = j - i := by
    simp [List.length_take, min_eq_left (by simpa only [List.length_drop] using
      (Nat.sub_le_sub_right hj i))]
  by_cases h : j - i ≤ returnBound l
  · refine hsep _ (hlen.trans_le h) (fun he => ?_) ?_ hq
    · simp only [he, List.length_nil] at hlen
      omega
    · exact ((reduced_concatenate hl bs).drop i).take (j - i)
  · have hp := height_of_long_factor hl bs i (j - i) (Nat.sub_le_sub_right hj i) (lt_of_not_ge h)
    exact (ne_of_gt hp) hz

private abbrev Lamp (α G : Type*) [Group G] :=
  RegularWreathProduct (α → Multiplicative (ZMod 2)) G

private def toggle : Multiplicative (ZMod 2) := Multiplicative.ofAdd 1

private theorem toggle_ne_one : toggle ≠ 1 := by decide

private theorem toggle_inv : toggle⁻¹ = toggle := by decide

private def lampGen {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G] (s : α → G)
    (a : α) : Lamp α G :=
  ⟨fun x i => if x = 1 ∧ i = a then toggle else 1, s a⟩

private theorem word_lamp_right {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G]
    (s : α → G) (w : List (Letter α)) : (word (lampGen s) w).right = word s w := by
  induction w with
  | nil => simp [word_nil]
  | cons a w ih =>
    rw [word_cons, word_cons, RegularWreathProduct.mul_right, ih]
    obtain ⟨a, b⟩ := a
    cases b <;> rfl

private def edgeStart {α G : Type*} [Group G] (s : α → G) (q : G) (a : Letter α) : G :=
  cond a.2 q (q * (s a.1)⁻¹)

private def lampAt {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G]
    (s : α → G) (q : G) (w : List (Letter α)) (x : G) (i : α) : Multiplicative (ZMod 2) :=
  (word (lampGen s) w).left (q⁻¹ * x) i

private theorem lampAt_nil {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G]
    (s : α → G) (q x : G) (i : α) : lampAt s q [] x i = 1 := by
  simp [lampAt, word_nil]

private theorem lampAt_cons {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G]
    (s : α → G) (q x : G) (a : Letter α) (w : List (Letter α)) (i : α) :
    lampAt s q (a :: w) x i = (if x = edgeStart s q a ∧ i = a.1 then toggle else 1) *
      lampAt s (q * step s a) w x i := by
  obtain ⟨a, b⟩ := a
  cases b
  · have hx : s a * (q⁻¹ * x) = 1 ↔ x = q * (s a)⁻¹ := by
      rw [← mul_assoc, mul_eq_one_iff_eq_inv]
      constructor <;> intro h <;> simpa [mul_inv_rev] using (congrArg Inv.inv h).symm
    simp [lampAt, word_cons, step, edgeStart, lampGen, mul_assoc, hx, apply_ite Inv.inv,
      toggle_inv]
  · simp [lampAt, word_cons, step, edgeStart, lampGen, mul_assoc, inv_mul_eq_one, eq_comm]

private theorem edge_incidence {α G : Type*} [Group G] (s : α → G) (q : G) (a : Letter α) :
    (q = edgeStart s q a ∧ q * step s a = edgeStart s q a * s a.1) ∨
      (q = edgeStart s q a * s a.1 ∧ q * step s a = edgeStart s q a) := by
  obtain ⟨a, b⟩ := a
  cases b <;> simp [edgeStart, step]

private theorem edge_incidence_start {α G : Type*} [Group G] (s : α → G) (q : G)
    (a : Letter α) : q = edgeStart s q a ∨ q = edgeStart s q a * s a.1 :=
  (edge_incidence s q a).imp And.left And.left

private def Avoids {α G : Type*} [Group G] (s : α → G) (q : G) (w : List (Letter α))
    (x : G) : Prop := ∀ j : ℕ, j ≤ w.length → q * word s (w.take j) ≠ x

private theorem avoids_head {α G : Type*} [Group G] {s : α → G} {q x : G}
    {a : Letter α} {w : List (Letter α)} (h : Avoids s q (a :: w) x) : q ≠ x := by
  simpa [word_nil] using h 0 (Nat.zero_le _)

private theorem avoids_tail {α G : Type*} [Group G] {s : α → G} {q x : G}
    {a : Letter α} {w : List (Letter α)} (h : Avoids s q (a :: w) x) :
    Avoids s (q * step s a) w x := by
  intro j hj
  simpa only [List.take_succ_cons, word_cons, mul_assoc] using h (j + 1) (by simpa using hj)

private theorem simple_tail {α G : Type*} [Group G] {s : α → G} {a : Letter α}
    {w : List (Letter α)} (h : Simple s (a :: w)) : Simple s w := by
  intro i j hij hj e
  apply h (i + 1) (j + 1) (by omega) (by simpa using hj)
  simp only [List.take_succ_cons, word_cons, e]

private theorem avoids_start {α G : Type*} [Group G] {s : α → G} {a : Letter α}
    {w : List (Letter α)} (h : Simple s (a :: w)) : Avoids s (step s a) w 1 := by
  intro j hj e
  apply h 0 (j + 1) (by omega) (by simpa using hj)
  simpa only [List.take_zero, List.take_succ_cons, word_nil, word_cons] using e.symm

private theorem lampAt_eq_one_of_avoids {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G]
    {s : α → G} {q x y : G} {w : List (Letter α)} {i : α}
    (hend : x = y ∨ x = y * s i) (h : Avoids s q w x) : lampAt s q w y i = 1 := by
  induction w generalizing q with
  | nil => exact lampAt_nil ..
  | cons a w ih =>
    have hh : ¬(y = edgeStart s q a ∧ i = a.1) := by
      rintro ⟨rfl, rfl⟩
      have hhead := avoids_head h
      have htail := avoids_tail h 0 (Nat.zero_le _)
      simp only [List.take_zero, word_nil, mul_one] at htail
      rcases edge_incidence s q a with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩ <;>
        rcases hend with h' | h'
      · exact hhead (h₁.trans h'.symm)
      · exact htail (h₂.trans h'.symm)
      · exact htail (h₂.trans h'.symm)
      · exact hhead (h₁.trans h'.symm)
    rw [lampAt_cons, ite_eq_right hh, ih (avoids_tail h), one_mul]

private theorem edge_letter_injective {α G : Type*} [Group G] {s : α → G}
    (hne : ∀ i, s i ≠ 1) {a b : Letter α} (h : edgeStart s 1 a = edgeStart s 1 b)
    (hi : a.1 = b.1) : a = b := by
  obtain ⟨a, p⟩ := a
  obtain ⟨b, q⟩ := b
  change a = b at hi
  subst b
  cases p <;> cases q <;> simp_all [edgeStart, inv_eq_one]

-- A simple path uses exactly one edge incident at its initial vertex. Its lamp determines the
-- first letter, after which cancellation gives the same comparison on the tails.
private theorem word_lamp_injective {α G : Type*} [Group G] [DecidableEq α] [DecidableEq G]
    {s : α → G} (hne : ∀ i, s i ≠ 1) {w v : List (Letter α)}
    (hw : Simple s w) (hv : Simple s v) (h : word (lampGen s) w = word (lampGen s) v) : w = v := by
  have first {a : Letter α} {u : List (Letter α)} (hs : Simple s (a :: u))
      (x : G) (i : α) (hx : (1 : G) = x ∨ (1 : G) = x * s i) :
      lampAt s 1 (a :: u) x i = (if x = edgeStart s 1 a ∧ i = a.1 then toggle else 1) := by
    simp only [lampAt_cons, one_mul, mul_one, lampAt_eq_one_of_avoids hx (avoids_start hs)]
  induction w generalizing v with
  | nil =>
    cases v with
    | nil => rfl
    | cons b v =>
      have hb := edge_incidence_start s 1 b
      have e : lampAt s 1 [] (edgeStart s 1 b) b.1 = lampAt s 1 (b :: v) (edgeStart s 1 b) b.1 :=
        congrArg (fun t : Lamp α G => t.left (1⁻¹ * edgeStart s 1 b) b.1) h
      rw [lampAt_nil, first hv _ _ hb] at e
      simp only [and_self, ite_true] at e
      exact (toggle_ne_one e.symm).elim
  | cons a w ih =>
    have ha := edge_incidence_start s 1 a
    have ea : lampAt s 1 (a :: w) (edgeStart s 1 a) a.1 = toggle := by
      rw [first hw _ _ ha]
      simp
    have e : lampAt s 1 (a :: w) (edgeStart s 1 a) a.1 = lampAt s 1 v (edgeStart s 1 a) a.1 :=
      congrArg (fun t : Lamp α G => t.left (1⁻¹ * edgeStart s 1 a) a.1) h
    rw [ea] at e
    cases v with
    | nil => exact (toggle_ne_one (e.trans (lampAt_nil ..))).elim
    | cons b v =>
      rw [first hv _ _ ha] at e
      split at e
      · rename_i hh
        have hab := edge_letter_injective hne hh.1 hh.2
        subst b
        rw [word_cons, word_cons] at h
        exact congrArg (List.cons a) (ih (simple_tail hw) (simple_tail hv) (mul_left_cancel h))
      · exact (toggle_ne_one e).elim

-- A finite set in a direct power of a finite group generates a finite group: the generators
-- distinguish only finitely many coordinate patterns, and so do all their products and inverses.
private theorem finite_closure_of_pi {H D I : Type*} [Group H] [Group D] [Finite D]
    (f : H →* (I → D)) (hf : Function.Injective f) (K : Finset H) :
    Finite (Subgroup.closure (K : Set H)) := by
  let signature (i : I) : K → D := fun k => f k.1 i
  let eval : ((K → D) → D) →* (I → D) :=
    ⟨⟨fun x i => x (signature i), rfl⟩, fun _ _ => rfl⟩
  have he : Finite eval.range :=
    Finite.of_surjective eval.rangeRestrict eval.rangeRestrict_surjective
  have hle : Subgroup.closure (K : Set H) ≤ eval.range.comap f := by
    apply (Subgroup.closure_le _).mpr
    intro k hk
    exact ⟨fun x => x ⟨k, hk⟩, rfl⟩
  let g (x : Subgroup.closure (K : Set H)) : eval.range := ⟨f x.1, hle x.2⟩
  exact Finite.of_injective g fun _ _ h => Subtype.ext (hf (congrArg Subtype.val h))

private abbrev HeightGroup := Multiplicative ℤ

private def heightHom (α Q : Type*) [Group Q] : Lamp α (Q × HeightGroup) →* HeightGroup :=
  (MonoidHom.snd Q HeightGroup).comp RegularWreathProduct.rightHom

private def sliceHom (α Q : Type*) [Group Q] : (heightHom α Q).ker →* (HeightGroup → Lamp α Q) where
  toFun g h := ⟨fun x => g.1.left (x, h), g.1.right.1⟩
  map_one' := rfl
  map_mul' g k := by
    have hg : g.1.right.2 = 1 := g.2
    funext h
    apply RegularWreathProduct.ext
    · funext x
      change (g.1.left (x, h) * k.1.left (g.1.right.1⁻¹ * x, g.1.right.2⁻¹ * h)) = _
      rw [hg, inv_one, one_mul]
      rfl
    · rfl

private theorem slice_injective (α Q : Type*) [Group Q] : Function.Injective (sliceHom α Q) := by
  intro g k h
  apply Subtype.ext
  apply RegularWreathProduct.ext
  · funext x
    exact congrArg (fun s : HeightGroup → Lamp α Q => (s x.2).left x.1) h
  · apply Prod.ext
    · exact congrArg (fun s : HeightGroup → Lamp α Q => (s 1).right) h
    · exact (show g.1.right.2 = 1 from g.2).trans (show k.1.right.2 = 1 from k.2).symm

private theorem kernel_locallyFinite {α Q G : Type*} [Finite α] [Group Q] [Finite Q] [Group G]
    (e : G →* Lamp α (Q × HeightGroup)) (he : Function.Injective e)
    (K : Finset ((heightHom α Q).comp e).ker) :
    Finite (Subgroup.closure (K : Set ((heightHom α Q).comp e).ker)) := by
  let f : ((heightHom α Q).comp e).ker →* (HeightGroup → Lamp α Q) :=
    (sliceHom α Q).comp ((e.comp ((heightHom α Q).comp e).ker.subtype).codRestrict
      (heightHom α Q).ker (fun g => g.2))
  exact finite_closure_of_pi f
    (fun _ _ h => Subtype.ext (he (congrArg Subtype.val (slice_injective α Q h)))) K

open scoped Pointwise symmDiff

-- Around the middle of a long interval, left multiplication by `s` shifts the height by `p s`.
-- A single finite subgroup of the kernel absorbs all correction factors on that interval.
open Classical in
private theorem folner_of_locallyFinite_kernel {G : Type*} [Group G] (p : G →* HeightGroup)
    (t : G) (ht : (p t).toAdd = 1)
    (hfin : ∀ K : Finset p.ker, Finite (Subgroup.closure (K : Set p.ker)))
    (K : Finset G) (ε : ℝ) (hε : 0 < ε) :
    ∃ F : Finset G, F.Nonempty ∧
      ∀ s ∈ K, (((s • F) ∆ F).card : ℝ) / (F.card : ℝ) < ε := by
  let z (g : G) := (p g).toAdd
  let B := K.sup (fun s => (z s).natAbs)
  obtain ⟨N, hN⟩ := exists_nat_gt (4 * (B : ℝ) / ε)
  have hN' : 4 * (B : ℝ) < (N : ℝ) * ε := (div_lt_iff₀ hε).mp hN
  let I : Finset ℤ := Finset.Icc 0 ((N : ℤ) + 2 * (B : ℤ))
  let J : Finset ℤ := Finset.Icc (B : ℤ) ((N : ℤ) + (B : ℤ))
  have hJI : J ⊆ I := by
    intro i hi
    simp only [I, J, Finset.mem_Icc] at hi ⊢
    omega
  have hshift (s : G) (hs : s ∈ K) (i : ℤ) (hi : i ∈ J) : i + z s ∈ I := by
    have hb : (z s).natAbs ≤ B := Finset.le_sup (f := fun s => (z s).natAbs) hs
    have h₁ : -(B : ℤ) ≤ z s := by omega
    have h₂ : z s ≤ (B : ℤ) := by omega
    simp only [I, J, Finset.mem_Icc] at hi ⊢
    omega
  have hpow (i : ℤ) : z (t ^ i) = i := by
    change (p (t ^ i)).toAdd = i
    rw [map_zpow]
    change i • (p t).toAdd = i
    simp [ht]
  let c (s : G) (i : ℤ) : p.ker := ⟨(t ^ (i + z s))⁻¹ * s * t ^ i, by
    change (p ((t ^ (i + z s))⁻¹ * s * t ^ i)).toAdd = 0
    simp only [map_mul, map_inv]
    change -z (t ^ (i + z s)) + z s + z (t ^ i) = 0
    rw [hpow, hpow]
    omega⟩
  let E := (K ×ˢ J).image (fun x => c x.1 x.2)
  let L := Subgroup.closure (E : Set p.ker)
  have : Finite L := hfin E
  let : Fintype L := Fintype.ofFinite L
  let emb : ℤ × L ↪ G := ⟨fun x => t ^ x.1 * x.2.1.1, by
    rintro ⟨i, u⟩ ⟨j, v⟩ h
    change t ^ i * u.1.1 = t ^ j * v.1.1 at h
    have e : i = j := by
      have he := congrArg z h
      have hu : z u.1.1 = 0 := congrArg Multiplicative.toAdd u.1.2
      have hv : z v.1.1 = 0 := congrArg Multiplicative.toAdd v.1.2
      change (p (t ^ i * u.1.1)).toAdd = (p (t ^ j * v.1.1)).toAdd at he
      simp only [map_mul] at he
      change z (t ^ i) + z u.1.1 = z (t ^ j) + z v.1.1 at he
      simpa [hpow, hu, hv] using he
    subst j
    exact Prod.ext rfl (Subtype.ext (Subtype.ext (mul_left_cancel h)))⟩
  let F := (I ×ˢ (Finset.univ : Finset L)).map emb
  let C := (J ×ˢ (Finset.univ : Finset L)).map emb
  have hCF : C ⊆ F := by
    intro x hx
    obtain ⟨⟨i, y⟩, hiy, rfl⟩ := Finset.mem_map.mp hx
    exact Finset.mem_map.mpr ⟨(i, y), Finset.mem_product.mpr
      ⟨hJI (Finset.mem_product.mp hiy).1, Finset.mem_univ y⟩, rfl⟩
  have hF : F.Nonempty := by
    refine ⟨emb (0, 1), Finset.mem_map.mpr ⟨(0, 1), Finset.mem_product.mpr ⟨?_, by simp⟩, rfl⟩⟩
    change (0 : ℤ) ∈ Finset.Icc 0 ((N : ℤ) + 2 * (B : ℤ))
    exact Finset.mem_Icc.mpr ⟨le_rfl, by positivity⟩
  have hiCard : I.card = N + 2 * B + 1 := by
    rw [show I = Finset.Icc (0 : ℤ) ((N : ℤ) + 2 * (B : ℤ)) from rfl, Int.card_Icc]
    omega
  have hjCard : J.card = N + 1 := by
    rw [show J = Finset.Icc (B : ℤ) ((N : ℤ) + (B : ℤ)) from rfl, Int.card_Icc]
    omega
  let d := Fintype.card L
  have hd : 0 < d := Fintype.card_pos
  have hFcard : F.card = (N + 2 * B + 1) * d := by simp [F, hiCard, d]
  have hCcard : C.card = (N + 1) * d := by simp [C, hjCard, d]
  refine ⟨F, hF, fun s hs => ?_⟩
  have hsCF : s • C ⊆ (s • F) ∩ F := by
    intro x hx
    refine Finset.mem_inter.mpr ⟨?_, ?_⟩
    · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      exact Finset.mem_image.mpr ⟨y, hCF hy, rfl⟩
    · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨⟨i, u⟩, hiu, rfl⟩ := Finset.mem_map.mp hy
      have hi := (Finset.mem_product.mp hiu).1
      have hc : c s i ∈ L := Subgroup.subset_closure (show c s i ∈ E from
        Finset.mem_image.mpr ⟨(s, i), Finset.mem_product.mpr ⟨hs, hi⟩, rfl⟩)
      refine Finset.mem_map.mpr ⟨(i + z s, ⟨c s i, hc⟩ * u),
        Finset.mem_product.mpr ⟨hshift s hs i hi, Finset.mem_univ _⟩, ?_⟩
      change t ^ (i + z s) * (((t ^ (i + z s))⁻¹ * s * t ^ i) * u.1.1) =
        s * (t ^ i * u.1.1)
      simp [mul_assoc]
  have hinter : C.card ≤ ((s • F) ∩ F).card := by
    simpa only [Finset.card_smul_finset] using Finset.card_le_card hsCF
  have hsub : F.card - C.card = 2 * B * d := by
    rw [hFcard, hCcard, show N + 2 * B + 1 = (N + 1) + 2 * B by omega, Nat.add_mul]
    omega
  have hdiff : ((s • F) ∆ F).card ≤ 4 * B * d := by
    rw [Finset.symmDiff_def]
    refine (Finset.card_union_le _ _).trans ?_
    rw [Finset.card_sdiff, Finset.card_sdiff, Finset.inter_comm F, Finset.card_smul_finset,
      show 4 * B * d = 2 * (2 * B * d) by ring]
    omega
  rw [div_lt_iff₀ (by exact_mod_cast hF.card_pos)]
  have hdiff' : (((s • F) ∆ F).card : ℝ) ≤ 4 * (B : ℝ) * (d : ℝ) := by exact_mod_cast hdiff
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hf' : (N : ℝ) * (d : ℝ) ≤ (F.card : ℝ) := by
    rw [hFcard]
    push_cast
    gcongr
    linarith [show (0 : ℝ) ≤ (B : ℝ) by positivity]
  calc
    _ ≤ 4 * (B : ℝ) * (d : ℝ) := hdiff'
    _ < ((N : ℝ) * ε) * (d : ℝ) := mul_lt_mul_of_pos_right hN' hd'
    _ = ε * ((N : ℝ) * (d : ℝ)) := by ring
    _ ≤ ε * (F.card : ℝ) := mul_le_mul_of_nonneg_left hf' hε.le

private theorem concatenate_injective {α : Type*} {l : ℕ} (hl : 0 < l) :
    Function.Injective (concatenate (α := α) (l := l)) := by
  intro bs cs h
  induction bs generalizing cs with
  | nil =>
    cases cs with
    | nil => rfl
    | cons c cs =>
      have he := congrArg List.length h
      rw [length_concatenate, length_concatenate] at he
      simp at he
      omega
  | cons b bs ih =>
    cases cs with
    | nil =>
      have he := congrArg List.length h
      rw [length_concatenate, length_concatenate] at he
      simp at he
      omega
    | cons c cs =>
      change b.1 ++ concatenate bs = c.1 ++ concatenate cs at h
      have h₁ := congrArg (List.take l) h
      simp only [List.take_append, b.2.1, c.2.1, Nat.sub_self, List.take_zero,
        List.append_nil] at h₁
      have hb : b.1.take l = b.1 := List.take_of_length_le b.2.1.le
      have hc : c.1.take l = c.1 := List.take_of_length_le c.2.1.le
      rw [hb, hc] at h₁
      have e : b = c := Subtype.ext h₁
      subst c
      exact congrArg (List.cons b) (ih (List.append_cancel_left h))

private theorem card_vector {α : Type*} [Finite α] (n : ℕ) :
    Nat.card (List.Vector α n) = Nat.card α ^ n := by
  let : Fintype α := Fintype.ofFinite α
  rw [Nat.card_congr (Equiv.vectorEquivFin α n)]
  simp [Nat.card_eq_fintype_card]

private theorem card_wordBall_upper {G : Type*} [Group G] {k : ℕ}
    (S : Group.Generators G (Fin k)) (n : ℕ) :
    Finite {g : G // S.wordLength g ≤ n} ∧
      Nat.card {g : G // S.wordLength g ≤ n} ≤ (2 * k + 1) ^ n := by
  classical
  choose get hlen hget using fun g : {g : G // S.wordLength g ≤ n} =>
    (S.wordLength_le_iff g.1).mp g.2
  let enc (g : {g : G // S.wordLength g ≤ n}) := padWord n (get g) (hlen g)
  have hinj : Function.Injective enc := by
    intro g h e
    have ee : get g = get h := by
      simpa only [enc, unpad_padWord] using
        congrArg (fun x : List.Vector (Option (Letter (Fin k))) n => x.1.filterMap id) e
    exact Subtype.ext ((hget g).symm.trans (ee ▸ hget h))
  refine ⟨Finite.of_injective enc hinj, ?_⟩
  have hh := Nat.card_le_card_of_injective enc hinj
  rw [card_vector] at hh
  have hc : Nat.card (Option (Letter (Fin k))) = 2 * k + 1 := by
    simp [Nat.card_eq_fintype_card, Nat.mul_comm]
  simpa only [hc] using hh

private theorem rpow_root_pow (r : ℝ) (hr : 0 ≤ r) {n : ℕ} (hn : 0 < n) :
    (r ^ n) ^ ((1 : ℝ) / n) = r := by
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  rw [← Real.rpow_natCast_mul hr, mul_one_div, div_self hn', Real.rpow_one]

private theorem growthRate_ge_of_pow {G : Type*} [Group G] {k l : ℕ} (hl : 0 < l)
    (S : Group.Generators G (Fin k)) (r : ℝ) (hr : 0 ≤ r) (d : ℕ)
    (hd : r ^ l ≤ (d : ℝ))
    (hballs : ∀ m : ℕ, d ^ m ≤ Nat.card {g : G // S.wordLength g ≤ m * l}) :
    r ≤ growthRate S := by
  unfold growthRate
  apply Filter.le_limsup_of_frequently_le
  · apply Filter.frequently_atTop.mpr
    intro n
    let m := n + 1
    have hm : n ≤ m * l := (Nat.le_succ _).trans (Nat.le_mul_of_pos_right m hl)
    have hml : 0 < m * l := Nat.mul_pos (Nat.succ_pos _) hl
    refine ⟨m * l, hm, ?_⟩
    have hle : r ^ (m * l) ≤ (Nat.card {g : G // S.wordLength g ≤ m * l} : ℝ) := calc
      _ = (r ^ l) ^ m := by rw [Nat.mul_comm, pow_mul]
      _ ≤ (d : ℝ) ^ m := pow_le_pow_left₀ (by positivity) hd _
      _ ≤ _ := by exact_mod_cast hballs m
    rw [← rpow_root_pow r hr hml]
    exact Real.rpow_le_rpow (by positivity) hle (by positivity)
  · apply Filter.isBoundedUnder_of
    let c : ℝ := ((2 * k + 1 : ℕ) : ℝ)
    have hc : 1 ≤ c := by
      dsimp [c]
      exact_mod_cast (show 1 ≤ 2 * k + 1 by omega)
    refine ⟨c, fun n => ?_⟩
    by_cases hn : n = 0
    · simpa [hn] using hc
    · have hle : (Nat.card {g : G // S.wordLength g ≤ n} : ℝ) ≤ c ^ n := by
        dsimp [c]
        exact_mod_cast (card_wordBall_upper S n).2
      exact (Real.rpow_le_rpow (by positivity) hle (by positivity)).trans_eq
        (rpow_root_pow c (by positivity) (Nat.pos_of_ne_zero hn))

private theorem exists_large_block (k : ℕ) (hk : 2 ≤ k) (r : ℝ) (hr : 0 < r)
    (hmax : r < 2 * (k : ℝ) - 1) :
    ∃ l : ℕ, 2 ≤ l ∧ r ^ l ≤ (Nat.card (Block (Fin k) l) : ℝ) := by
  let b : ℝ := 2 * (k : ℝ) - 1
  have hratio : 1 < b / r := (lt_div_iff₀ hr).mpr (by simpa [b] using hmax)
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 * r ^ 2) hratio
  have hh : 2 * r ^ 2 * r ^ n < b ^ n := by
    rwa [div_pow, lt_div_iff₀ (pow_pos hr _)] at hn
  have hcard : b ^ n ≤ 2 * (Nat.card (Block (Fin k) (n + 2)) : ℝ) := by
    have hle := card_blocks k n hk
    have hs : 1 ≤ 2 * k := by omega
    have hcast := (Nat.cast_le (α := ℝ)).2 hle
    simpa only [b, Nat.cast_pow, Nat.cast_mul, Nat.cast_sub hs, Nat.cast_one, Nat.cast_ofNat]
      using hcast
  refine ⟨n + 2, by omega, ?_⟩
  rw [pow_add]
  linarith [show 2 * (r ^ n * r ^ 2) < b ^ n by linarith only [hh]]

open Classical in
private theorem exists_amenable_witness (k : ℕ) (hk : 2 ≤ k) (r : ℝ) (hr : 0 < r)
    (hmax : r < 2 * (k : ℝ) - 1) :
    ∃ (Γ : Type) (_ : Group Γ) (S : Group.Generators Γ (Fin k)),
      Function.Injective S.val ∧ r ≤ growthRate S ∧
      ∀ (K : Finset Γ) (ε : ℝ), 0 < ε → ∃ F : Finset Γ, F.Nonempty ∧
        ∀ s ∈ K, (((s • F) ∆ F).card : ℝ) / (F.card : ℝ) < ε := by
  obtain ⟨l, hl, hcard⟩ := exists_large_block k hk r hr hmax
  obtain ⟨Q, _, _, s, hsep⟩ := exists_short_separation (Fin k) (returnBound l)
  let base (i : Fin k) : Q × HeightGroup := (s i, Multiplicative.ofAdd 1)
  have hne (i : Fin k) : base i ≠ 1 := by
    intro h
    have e := congrArg (fun x : Q × HeightGroup => x.2.toAdd) h
    change (1 : ℤ) = 0 at e
    omega
  let T := FreeGroup.lift (lampGen base)
  let S := Group.Generators.ofFreeGroupHom T.rangeRestrict T.rangeRestrict_surjective
  have hS (i : Fin k) : (S.val i).1 = lampGen base i := by simp [S, T]
  have hwS (w : List (Letter (Fin k))) : (S.wordProd w).1 = word (lampGen base) w := by
    simp [Group.Generators.wordProd, S, T, word]
  refine ⟨T.range, inferInstance, S, ?_, ?_, ?_⟩
  · intro i j h
    have e := congrArg (fun x : T.range => x.1.left 1 i) h
    change (S.val i).1.left 1 i = (S.val j).1.left 1 i at e
    rw [hS, hS] at e
    by_contra hne'
    exact toggle_ne_one (by simpa [lampGen, hne'] using e)
  · apply growthRate_ge_of_pow (by omega : 0 < l) S r hr.le _ hcard
    intro m
    have := finite_block (Fin k) l
    have := (card_wordBall_upper S (m * l)).1
    let f (v : List.Vector (Block (Fin k) l) m) : {g : T.range // S.wordLength g ≤ m * l} :=
      ⟨S.wordProd (concatenate v.1), (S.wordLength_wordProd_le _).trans_eq
        ((length_concatenate v.1).trans (congrArg (· * l) v.2))⟩
    have hinj : Function.Injective f := by
      intro v u e
      have he := congrArg (fun x : {g : T.range // S.wordLength g ≤ m * l} => x.1.1) e
      change (S.wordProd (concatenate v.1)).1 = (S.wordProd (concatenate u.1)).1 at he
      rw [hwS, hwS] at he
      have hs₁ := simple_concatenate (by omega : 0 < l) s hsep v.1
      have hs₂ := simple_concatenate (by omega : 0 < l) s hsep u.1
      exact Subtype.ext (concatenate_injective (by omega : 0 < l)
        (word_lamp_injective hne hs₁ hs₂ he))
    have h := Nat.card_le_card_of_injective f hinj
    rwa [card_vector] at h
  · let a : Fin k := ⟨0, by omega⟩
    exact folner_of_locallyFinite_kernel ((heightHom (Fin k) Q).comp T.range.subtype)
      (S.val a) (by change (S.val a).1.right.2.toAdd = 1; rw [hS]; rfl)
      (kernel_locallyFinite T.range.subtype Subtype.val_injective)

/--
**Amenable groups with growth rate close to $2k - 1$ (Kourovka 15.4 refuted).** For a group
$\Gamma$ generated by a family $S$ of $k$ elements and $n \in \mathbb{N}$, let $\beta_S(n)$ be the
number of elements of $\Gamma$ that are products of at most $n$ elements of $S \cup S^{-1}$, and
let $\omega(\Gamma, S) = \limsup_{n \to \infty} \beta_S(n)^{1/n}$ be the growth rate. For every
$k \ge 2$ and every real $\varepsilon > 0$ there are an amenable group $\Gamma$ (amenability being
the Følner condition) and a family $S$ of $k$ distinct elements generating $\Gamma$ such that
$\omega(\Gamma, S) \ge 2k - 1 - \varepsilon$. Equivalently, there are no $k \ge 2$ and
$\varepsilon > 0$ such that every group generated by a family of $k$ distinct elements with growth
rate at least $2k - 1 - \varepsilon$ is non-amenable.

Arzhantseva, Guba and Guyot showed that for every $m \ge 2$, with $F_m$ the free group of rank
$m$, $R$ a normal subgroup of $F_m$ and $R'$ its commutator subgroup, the growth rate of $F_m/R'$
tends to $2m - 1$ as the shortest relation in $R$ gets longer, so $m$-generated amenable groups
(abelian-by-nilpotent ones, for instance) have growth rates arbitrarily close to $2m - 1$; the
Kourovka Archive answers 15.4 "No, it does not".

Source: E. I. Khukhro and V. D. Mazurov (eds.),
Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026),
Archive of Solved Problems, Problem 15.4 (P. de la Harpe); resolution: G. N. Arzhantseva, V. S. Guba
and L. Guyot, Growth rates of amenable groups, J. Group Theory 8 (2005), 389-394,
arXiv:math/0406013, abstract and main result (the growth rate of an m-generated amenable group,
already in the abelian-by-nilpotent and metabelian-by-finite classes, can be arbitrarily close to
2m - 1); Kourovka Archive, Problem 15.4 (answer: No, it does not),
https://arxiv.org/abs/math/0406013.
-/
public theorem largeGrowthRateImpliesNonamenable_refuted :
    ¬ largeGrowthRateImpliesNonamenable := by
  rintro ⟨k, hk, ε, hε, h⟩
  let r : ℝ := max 1 (2 * (k : ℝ) - 1 - ε)
  have hpos : 0 < r := zero_lt_one.trans_le (le_max_left ..)
  have hk' : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have hlt : r < 2 * (k : ℝ) - 1 := max_lt (by linarith) (sub_lt_self _ hε)
  obtain ⟨Γ, _, S, hinj, hg, ham⟩ := exists_amenable_witness k hk r hpos hlt
  exact h Γ S hinj ((le_max_right ..).trans hg) ham

end MathlibExt.GroupTheory.AmenableLargeGrowthRateKourovka15Problem4Wanted
