/-!
# Non-normal maximal subgroups of finite index in branch groups

Kourovka Notebook, Problem 20.101 (A. Thillaisundaram), marked solved in the 21st issue: let `G` be
a finitely generated branch group. Are all finite-index maximal subgroups of `G` necessarily normal?

We construct a branch group on the five-letter tree whose action on the first level is the
alternating group. The inverse image of a point stabilizer is a non-normal maximal subgroup
of finite index.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 20.101 (A. Thillaisundaram). UnsolvedMath
record UM-00701759 (`KOU-20.101`), dataset ulamai/UnsolvedMath v1.8.0.

A branch group acts faithfully and level-transitively on a locally finite rooted tree in which every
vertex has at least two children, with every rigid level stabilizer (the subgroup generated by the
rigid stabilizers of the vertices of a level) of finite index: the definition of
Garciarena-Petschick (Section 2) for subgroups of `Aut(X*)`. The definitions are in the shared
module `MathlibExt.GroupTheory.BranchGroupShared`, which repeats those of the OpenConjectures entry
`BranchGroupsBoundedlyAcyclic` (Kourovka 21.116). The ATLAS project libraries cannot import
OpenConjectures.
-/

namespace MathlibExt.GroupTheory.BranchGroupMaximalSubgroupsNormalKourovka20Problem101Wanted

open MathlibExt.GroupTheory.BranchGroupShared

/-- **Kourovka 20.101: finite-index maximal subgroups of finitely generated branch groups are
normal.** The statement (A. Thillaisundaram) that in every finitely generated branch group every
maximal subgroup of finite index is normal. -/
@[expose] public def branchGroupFiniteIndexMaximalSubgroupsNormal : Prop :=
  ∀ (G : Type) [Group G], Group.FG G → IsBranchGroup G →
    ∀ M : Subgroup G, IsCoatom M → M.FiniteIndex → M.Normal

open scoped commutatorElement

private abbrev Letter := Fin 5
private abbrev Alt := alternatingGroup Letter

private def Word : ℕ → Type
  | 0 => Unit
  | n + 1 => Letter × Word n

private instance finiteWord (n : ℕ) : Finite (Word n) := by
  induction n with
  | zero => exact inferInstanceAs (Finite Unit)
  | succ n ih => exact inferInstanceAs (Finite (Letter × Word n))

private def parent : (n : ℕ) → Word (n + 1) → Word n
  | 0, _ => ()
  | n + 1, (i, w) => (i, parent n w)

private def appendLetter : (n : ℕ) → Word n → Letter → Word (n + 1)
  | 0, _, j => (j, ())
  | n + 1, (i, w), j => (i, appendLetter n w j)

private theorem parent_append (n : ℕ) (w : Word n) (j : Letter) :
    parent n (appendLetter n w j) = w := by
  induction n with
  | zero => rfl
  | succ n ih => exact Prod.ext rfl (ih w.2)

private theorem append_injective (n : ℕ) (w : Word n) : Function.Injective (appendLetter n w) := by
  induction n with
  | zero => exact fun _ _ h => congrArg Prod.fst h
  | succ n ih => exact fun _ _ h => ih w.2 (congrArg Prod.snd h)

private def tree : RootedTree where
  Vertex := Word
  levelFinite := finiteWord
  rootUnique := inferInstanceAs (Unique Unit)
  parent := parent
  twoChildren n w := ⟨_, _, parent_append n w 0, parent_append n w 1,
    (append_injective n w).ne (by decide : (0 : Letter) ≠ 1)⟩

private abbrev Levels := (n : ℕ) → Equiv.Perm (Word n)

-- A permutation of the first letter and one section for each possible first letter.
private def node (p : Alt) (s : Letter → Levels) : Levels
  | 0 => 1
  | n + 1 => Equiv.prodShear p.val (fun i => s i n)

private theorem node_one : node 1 1 = 1 := by
  funext n
  cases n <;> rfl

private theorem node_mul (p q : Alt) (s t : Letter → Levels) :
    node p s * node q t = node (p * q) (fun i => s (q.val i) * t i) := by
  funext n
  cases n <;> exact Equiv.ext fun _ => rfl

private theorem node_inv (p : Alt) (s : Letter → Levels) :
    (node p s)⁻¹ = node p⁻¹ (fun i => (s (p.val.symm i))⁻¹) := by
  funext n
  cases n <;> exact Equiv.ext fun _ => rfl

private def rooted : Alt →* Levels where
  toFun p := node p 1
  map_one' := node_one
  map_mul' p q := (node_mul p q 1 1).symm

private def below : (Letter → Levels) →* Levels where
  toFun := node 1
  map_one' := node_one
  map_mul' s t := (node_mul 1 1 s t).symm

private def insertAt (i : Letter) : Levels →* Levels :=
  below.comp (MonoidHom.mulSingle (fun _ : Letter => Levels) i)

private abbrev Spine := {i : Letter // i ≠ 1}

-- Along the ray i i i ..., put a rooted copy of p in each side branch numbered 1.
private def directed (i : Spine) (p : Alt) : Levels
  | 0 => 1
  | n + 1 => Equiv.prodCongrRight fun j : Letter =>
      if j = i.val then directed i p n else if j = 1 then rooted p n else 1

private def sections (i : Spine) (p : Alt) (j : Letter) : Levels :=
  if j = i.val then directed i p else if j = 1 then rooted p else 1

private theorem directed_eq (i : Spine) (p : Alt) : directed i p = below (sections i p) := by
  funext n
  cases n with
  | zero => rfl
  | succ n =>
    apply Equiv.ext
    rintro ⟨j, w⟩
    change (j, (if j = i.val then directed i p n else if j = 1 then rooted p n else 1) w) =
      (j, sections i p j n w)
    by_cases h : j = i.val <;> by_cases k : j = 1 <;> simp [h, k, sections, Ne.symm i.property]

private def generators : Set Levels :=
  Set.range rooted ∪ Set.range (fun x : Spine × Alt => directed x.1 x.2)

private def branch : Subgroup Levels := Subgroup.closure generators

private theorem rooted_mem (p : Alt) : rooted p ∈ branch :=
  Subgroup.subset_closure (Or.inl ⟨p, rfl⟩)

private theorem directed_mem (i : Spine) (p : Alt) : directed i p ∈ branch :=
  Subgroup.subset_closure (Or.inr ⟨(i, p), rfl⟩)

private theorem branch_fg : Group.FG branch :=
  (Group.fg_iff_subgroup_fg _).mpr <| (Subgroup.fg_iff _).mpr
    ⟨generators, rfl, (Set.finite_range _).union (Set.finite_range _)⟩

private theorem has_sections {g : Levels} (hg : g ∈ branch) :
    ∃ (p : Alt) (s : Letter → branch), g = node p (fun i => s i) := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ⟨p, rfl⟩ | ⟨⟨i, p⟩, rfl⟩
    · exact ⟨p, 1, rfl⟩
    · refine ⟨1, fun j => ⟨sections i p j, ?_⟩, directed_eq i p⟩
      unfold sections
      split_ifs <;> first | apply directed_mem | apply rooted_mem | exact branch.one_mem
  | one => exact ⟨1, 1, node_one.symm⟩
  | mul a b _ _ ha hb =>
    obtain ⟨p, s, rfl⟩ := ha
    obtain ⟨q, t, rfl⟩ := hb
    exact ⟨p * q, fun i => s (q.val i) * t i, node_mul ..⟩
  | inv a _ ha =>
    obtain ⟨p, s, rfl⟩ := ha
    exact ⟨p⁻¹, fun i => (s (p.val.symm i))⁻¹, node_inv ..⟩

private theorem insert_conj (p : Alt) (i : Letter) (g : Levels) :
    rooted p * insertAt i g = insertAt (p.val i) g * rooted p := by
  change node p 1 * node 1 (Pi.mulSingle i g) = node 1 (Pi.mulSingle (p.val i) g) * node p 1
  rw [node_mul, node_mul, one_mul, mul_one]
  congr 1
  funext j
  by_cases hj : j = i <;> simp [hj, p.val.injective.eq_iff]

private theorem transport_insert {g : Levels} {i : Letter} (hg : insertAt i g ∈ branch)
    (j : Letter) : insertAt j g ∈ branch := by
  let := alternatingGroup.isPretransitive_of_three_le_card Letter (by simp)
  obtain ⟨p, hp⟩ := MulAction.exists_smul_eq Alt i j
  change p.val i = j at hp
  subst j
  exact (branch.mul_mem_cancel_right (rooted_mem p)).mp
    (insert_conj p i g ▸ branch.mul_mem (rooted_mem p) hg)

-- The rays 0 and 2 have just one active first-level section in common, at 1.
-- Their commutators there generate the whole rooted alternating group.
private theorem insert_rooted_mem (j : Letter) (p : Alt) : insertAt j (rooted p) ∈ branch := by
  let K := branch.comap ((insertAt 1).comp rooted)
  have hK : commutator Alt ≤ K := by
    apply Subgroup.commutator_le.mpr
    intro a _ b _
    let u : Spine := ⟨0, by decide⟩
    let v : Spine := ⟨2, by decide⟩
    have h : ⁅directed u a, directed v b⁆ ∈ branch :=
      (Subgroup.commutator_le_self branch)
        (Subgroup.commutator_mem_commutator (directed_mem u a) (directed_mem v b))
    rw [directed_eq u a, directed_eq v b, ← map_commutatorElement] at h
    change below (Pi.mulSingle 1 (rooted ⁅a, b⁆)) ∈ branch
    convert h using 2
    funext k
    fin_cases k <;> simp [sections, u, v, commutatorElement_def]
  rw [commutator_alternatingGroup_eq_top (by simp)] at hK
  exact transport_insert (hK (Subgroup.mem_top p) : (insertAt 1) (rooted p) ∈ branch) j

-- Removing the rooted side section leaves the directed element in its own subtree.
private theorem insert_directed_mem (j : Letter) (i : Spine) (p : Alt) :
    insertAt j (directed i p) ∈ branch := by
  have h : directed i p = insertAt i.val (directed i p) * insertAt 1 (rooted p) := by
    conv_lhs => rw [directed_eq]
    change below _ = below _ * below _
    rw [← map_mul]
    congr 1
    funext k
    by_cases hk : k = i.val <;> simp [sections, Pi.mulSingle_apply, hk, i.property]
  apply transport_insert (i := i.val)
  exact (branch.mul_mem_cancel_right (insert_rooted_mem 1 p)).mp (h ▸ directed_mem i p)

private theorem insert_mem (j : Letter) : branch ≤ branch.comap (insertAt j) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ (⟨p, rfl⟩ | ⟨⟨i, p⟩, rfl⟩)
  · exact insert_rooted_mem j p
  · exact insert_directed_mem j i p

private def localize (i : Letter) : branch →* branch :=
  ((insertAt i).comp branch.subtype).codRestrict branch fun g => insert_mem i g.property

private theorem parent_equivariant (n : ℕ) (g : branch) (w : Word (n + 1)) :
    parent n (g.val (n + 1) w) = g.val n (parent n w) := by
  induction n generalizing g with
  | zero => rfl
  | succ n ih =>
    obtain ⟨p, s, hg⟩ := has_sections g.property
    rw [hg]
    exact Prod.ext rfl (ih (s w.1) w.2)

private theorem transitive (n : ℕ) (v w : Word n) : ∃ g : branch, g.val n v = w := by
  induction n with
  | zero => exact ⟨1, rfl⟩
  | succ n ih =>
    obtain ⟨g, hg⟩ := ih v.2 w.2
    let := alternatingGroup.isPretransitive_of_three_le_card Letter (by simp)
    obtain ⟨p, hp⟩ := MulAction.exists_smul_eq Alt v.1 w.1
    refine ⟨(⟨rooted p, rooted_mem p⟩ : branch) * localize v.1 g, ?_⟩
    apply Prod.ext hp
    change (Pi.mulSingle v.1 g.val : Letter → Levels) v.1 n v.2 = w.2
    simpa using hg

private def action : LevelTransitiveFaithfulAction tree branch where
  levelAction n := (Pi.evalMonoidHom _ n).comp branch.subtype
  parent_equivariant g n := parent_equivariant n g
  faithful _ h := Subtype.ext (funext fun n => Equiv.ext (h n))
  level_transitive := transitive

private theorem root_descendant {m : ℕ} (w : Word m) :
    tree.IsDescendant (n := 0) (m := m) () w := by
  induction m with
  | zero => exact .refl (T := tree) (n := 0) ()
  | succ m ih => exact .child (T := tree) (m := m) w (ih (parent m w))

private theorem prepend_descendant {n m : ℕ} {v : Word n} {w : Word m}
    (h : tree.IsDescendant (n := n) (m := m) v w) (i : Letter) :
    tree.IsDescendant (n := n + 1) (m := m + 1) (i, v) (i, w) := by
  exact RootedTree.IsDescendant.rec
    (motive := fun {m} v w _ => tree.IsDescendant (n := n + 1) (m := m + 1) (i, v) (i, w))
    (fun _ => .refl _) (fun _ _ ih => .child _ ih) h

private theorem localize_rigid (n : ℕ) (i : Letter) :
    action.rigidLevelStabilizer n ≤ (action.rigidLevelStabilizer (n + 1)).comap (localize i) := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨v, hv⟩
  apply Subgroup.subset_closure
  refine ⟨(i, v), ?_⟩
  intro m w hw
  cases m with
  | zero => rfl
  | succ m =>
    obtain ⟨j, z⟩ := w
    change (j, (Pi.mulSingle i g.val : Letter → Levels) j m z) = (j, z)
    by_cases h : j = i
    · subst j
      simp only [Pi.mulSingle_eq_same, Prod.mk.injEq, true_and]
      exact hv z (fun hz => hw (prepend_descendant hz i))
    · simp [Pi.mulSingle_eq_of_ne h]

private def constantWord : (n : ℕ) → Word n
  | 0 => ()
  | n + 1 => (0, constantWord n)

-- The kernel at every level is generated by elements supported at vertices of that level.
private theorem ker_le_rigid (n : ℕ) :
    (action.levelAction n).ker ≤ action.rigidLevelStabilizer n := by
  induction n with
  | zero =>
    intro g _
    exact Subgroup.subset_closure ⟨(), fun w h => (h (root_descendant w)).elim⟩
  | succ n ih =>
    intro g hg
    obtain ⟨p, s, hs⟩ := has_sections g.property
    have hfix (i : Letter) (w : Word n) : (p.val i, (s i).val n w) = (i, w) := by
      change node p (fun i => (s i).val) (n + 1) (i, w) = (i, w)
      rw [← hs]
      exact DFunLike.congr_fun (show g.val (n + 1) = 1 from hg) (i, w)
    have hp : p = 1 := Subtype.ext (Equiv.ext fun i => congrArg Prod.fst (hfix i (constantWord n)))
    subst p
    let H := action.rigidLevelStabilizer (n + 1)
    suffices h : g.val ∈ H.map branch.subtype by
      obtain ⟨k, hk, he⟩ := h
      exact (Subtype.ext he : k = g) ▸ hk
    rw [hs]
    apply Subgroup.pi_mem_of_mulSingle_mem (H := (H.map branch.subtype).comap below)
    intro i
    refine ⟨localize i (s i), localize_rigid n i (ih ?_), rfl⟩
    exact Equiv.ext fun w => congrArg Prod.snd (hfix i w)

private theorem branch_action : IsBranchGroup branch := by
  refine ⟨tree, action, fun n => ?_⟩
  let : Finite (tree.Vertex n) := finiteWord n
  exact Subgroup.finiteIndex_of_le (ker_le_rigid n)

private noncomputable def firstLevel : branch →* Alt := by
  let e : tree.Vertex 1 ≃ Letter := Equiv.prodUnique Letter Unit
  let f := e.permCongrHom.toMonoidHom.comp (action.levelAction 1)
  refine f.codRestrict Alt fun g => ?_
  obtain ⟨p, s, hg⟩ := has_sections g.property
  have he : f g = p.val := by
    apply Equiv.ext
    intro i
    change (g.val 1 (i, ())).1 = p.val i
    rw [hg]
    rfl
  exact he ▸ p.property

private theorem firstLevel_surjective : Function.Surjective firstLevel := fun p =>
  ⟨⟨rooted p, rooted_mem p⟩, Subtype.ext (Equiv.ext fun _ => rfl)⟩

private theorem pointStabilizer_not_normal :
    ¬ (MulAction.stabilizer Alt (0 : Letter)).Normal := by
  intro hn
  let := alternatingGroup.isPreprimitive_of_three_le_card Letter (by simp)
  have hm := MulAction.IsPreprimitive.isCoatom_stabilizer_of_isPreprimitive Alt (0 : Letter)
  rcases alternatingGroup.normal_subgroup_eq_bot_or_eq_top (by simp : 5 ≤ Nat.card Letter)
      (N := MulAction.stabilizer Alt (0 : Letter)) with h | h
  · have hi := MulAction.index_stabilizer_of_transitive Alt (0 : Letter)
    rw [h, Subgroup.index_bot, nat_card_alternatingGroup] at hi
    norm_num [Nat.factorial] at hi
  · exact hm.ne_top h

/--
**A finitely generated branch group with a non-normal maximal subgroup of finite index.**
Some finitely generated branch group has a maximal subgroup of finite index that is not normal.
This gives a negative answer to Kourovka Problem 20.101.

Garciarena and Petschick give a different example on the 21-letter tree. Their group has a
non-normal maximal subgroup and satisfies the stronger condition that every maximal subgroup has
finite index (membership in MF).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue (2026), Problem 20.101 (A. Thillaisundaram), https://arxiv.org/abs/1401.0300v49

Source: P. M. Neumann, Illinois J. Math. 30 (1986), 301–316, cited by the Notebook for the
negative answer to Problem 20.101.

Source: M. E. Garciarena and J. M. Petschick, Maximal subgroups in torsion branch groups (2024),
Theorem 4.1 (the example in MF), https://arxiv.org/abs/2410.06783
-/
public theorem branchGroupFiniteIndexMaximalSubgroupsNormal_refuted :
    ¬ branchGroupFiniteIndexMaximalSubgroupsNormal := by
  intro h
  let M := MulAction.stabilizer Alt (0 : Letter)
  let := alternatingGroup.isPreprimitive_of_three_le_card Letter (by simp)
  have hm : IsCoatom M := MulAction.IsPreprimitive.isCoatom_stabilizer_of_isPreprimitive Alt 0
  have hn := h branch branch_fg branch_action (M.comap firstLevel)
    (Subgroup.isCoatom_comap_of_surjective firstLevel_surjective hm) inferInstance
  exact pointStabilizer_not_normal <|
    (Subgroup.normal_comap_iff_of_surjective firstLevel_surjective).mp hn

end MathlibExt.GroupTheory.BranchGroupMaximalSubgroupsNormalKourovka20Problem101Wanted
