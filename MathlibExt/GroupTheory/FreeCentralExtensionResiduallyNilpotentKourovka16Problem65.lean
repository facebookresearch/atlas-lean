/-!
# Residual nilpotence of free central extensions (Kourovka Notebook Problem 16.65)

Kourovka Notebook, Archive of Solved Problems, Problem 16.65 (R. Mikhailov, I. B. S. Passi): does
there exist a finitely presented residually torsion-free nilpotent group with a free presentation `G
= F/R` such that the group `F/[F, R]` is not residually nilpotent?

This file proves the existence of such a presentation using an explicit four-generator group.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 16.65 (R.
Mikhailov, I. B. S. Passi). UnsolvedMath record UM-00701257 (`KOU-16.65`), dataset
ulamai/UnsolvedMath v1.8.0.

A free presentation is a free group `F = FreeGroup α` on any type `α` with a normal subgroup `R`;
`[F, R]` is the commutator subgroup `⁅⊤, R⁆`. Residually (torsion-free) nilpotent means that every
nontrivial element survives in some (torsion-free) nilpotent quotient.
-/

namespace MathlibExt.GroupTheory.FreeCentralExtensionResiduallyNilpotentKourovka16Problem65Wanted

/-- **Residually nilpotent group.** A group $G$ is residually nilpotent if for every element
$g \ne 1$ of $G$ there is a normal subgroup $N$ of $G$ with $g \notin N$ such that the quotient
$G/N$ is nilpotent. -/
@[expose] public def IsResiduallyNilpotent (G : Type) [Group G] : Prop :=
  ∀ g : G, g ≠ 1 → ∃ N : Subgroup G, ∃ _ : N.Normal, g ∉ N ∧ Group.IsNilpotent (G ⧸ N)

/-- **Residually torsion-free nilpotent group.** A group $G$ is residually torsion-free nilpotent
if for every element $g \ne 1$ of $G$ there is a normal subgroup $N$ of $G$ with $g \notin N$ such
that the quotient $G/N$ is nilpotent and torsion-free, that is, every nontrivial element of $G/N$
has infinite order. -/
@[expose] public def IsResiduallyTorsionFreeNilpotent (G : Type) [Group G] : Prop :=
  ∀ g : G, g ≠ 1 → ∃ N : Subgroup G, ∃ _ : N.Normal, g ∉ N ∧ Group.IsNilpotent (G ⧸ N) ∧
    ∀ x : G ⧸ N, x ≠ 1 → ¬ IsOfFinOrder x

/-- **Mikhailov–Passi question on free central extensions (Kourovka 16.65).** The assertion that
there exist a free group $F$ and a normal subgroup $R$ of $F$ such that $F/R$ is finitely
presented and residually torsion-free nilpotent, while $F/[F, R]$ is not residually nilpotent,
where $[F, R]$ is the subgroup of $F$ generated by all commutators $[f, r]$ with $f \in F$ and
$r \in R$. -/
@[expose] public def existsPresentationWithNonResiduallyNilpotentQuotient : Prop :=
  ∃ (α : Type) (R : Subgroup (FreeGroup α)) (_ : R.Normal),
    Group.IsFinitelyPresented (FreeGroup α ⧸ R) ∧
    IsResiduallyTorsionFreeNilpotent (FreeGroup α ⧸ R) ∧
    ¬ IsResiduallyNilpotent (FreeGroup α ⧸ ⁅(⊤ : Subgroup (FreeGroup α)), R⁆)

open Subgroup QuotientGroup Polynomial
open scoped Polynomial commutatorElement

noncomputable section

/-! ## Separating elements of the rank-two free group

For a representation by units of a polynomial ring, the subgroups of elements congruent to
one modulo powers of `X` give nilpotent quotients if every element is one modulo `X`.
A leading coefficient detects powers, so these quotients are torsion-free when the additive
coefficient group is torsion-free. -/

section Filtration

variable {G S : Type} [Group G] [Ring S] (ρ : G →* S[X]ˣ)

private def polyValue (g : G) : S[X] := ρ g
private def polyError (g : G) : S[X] := polyValue ρ g - 1

private theorem rep_mul (x y : G) : polyValue ρ (x * y) = polyValue ρ x * polyValue ρ y :=
  congrArg Units.val (map_mul ρ x y)

private theorem rep_one : polyValue ρ 1 = 1 := congrArg Units.val (map_one ρ)

private theorem rep_cancel (x : G) : polyValue ρ x * polyValue ρ x⁻¹ = 1 := by
  rw [← rep_mul, mul_inv_cancel, rep_one]

private theorem err_mul (x y : G) :
    polyError ρ (x * y) = polyError ρ x * polyValue ρ y + polyError ρ y := by
  simp only [polyError, rep_mul]; noncomm_ring

private theorem err_inv (x : G) : polyError ρ x⁻¹ = -(polyError ρ x * polyValue ρ x⁻¹) := by
  rw [polyError, polyError, sub_mul, rep_cancel, one_mul, neg_sub]

private theorem err_conj (x y : G) :
    polyError ρ (x * y * x⁻¹) = polyValue ρ x * polyError ρ y * polyValue ρ x⁻¹ := by
  simp only [polyError, rep_mul, mul_sub, mul_one, sub_mul, rep_cancel]

private theorem dvd_X_left (n : ℕ) {p : S[X]} (hp : X ^ n ∣ p) (q : S[X]) :
    X ^ n ∣ q * p := by
  obtain ⟨k, rfl⟩ := hp
  exact ⟨q * k, by rw [← mul_assoc, (commute_X_pow q n).eq.symm, mul_assoc]⟩

private def depth (n : ℕ) : Subgroup G where
  carrier := {g | (X : S[X]) ^ n ∣ polyError ρ g}
  one_mem' := by simp [polyError, rep_one]
  mul_mem' := fun {x y} hx hy => by
    change X ^ n ∣ polyError ρ (x * y); rw [err_mul]
    exact dvd_add (dvd_mul_of_dvd_left hx _) hy
  inv_mem' := fun {x} hx => by
    change X ^ n ∣ polyError ρ x⁻¹; rw [err_inv, dvd_neg]
    exact dvd_mul_of_dvd_left hx _

private instance depthNormal (n : ℕ) : (depth ρ n).Normal where
  conj_mem x hx y := by
    change X ^ n ∣ polyError ρ (y * x * y⁻¹)
    rw [err_conj]
    exact dvd_mul_of_dvd_left (dvd_X_left _ hx _) _

private theorem depth_le {i j : ℕ} (h : i ≤ j) : depth ρ j ≤ depth ρ i :=
  fun _ hx => dvd_trans (pow_dvd_pow _ h) hx

private theorem dvd_product {p q : S[X]} {i j : ℕ} (hp : X ^ i ∣ p) (hq : X ^ j ∣ q) :
    X ^ (i + j) ∣ p * q := by
  obtain ⟨v, rfl⟩ := hp
  obtain ⟨w, rfl⟩ := hq
  refine ⟨v * w, ?_⟩
  rw [pow_add, mul_assoc, ← mul_assoc v, (commute_X_pow v j).eq.symm]
  simp only [mul_assoc]

private theorem depth_comm {n : ℕ} {x y : G} (hx : x ∈ depth ρ n) (hy : y ∈ depth ρ 1) :
    ⁅x, y⁆ ∈ depth ρ (n + 1) := by
  change X ^ (n + 1) ∣ polyError ρ ⁅x, y⁆
  have eq : polyError ρ ⁅x, y⁆ =
      (polyError ρ x * polyError ρ y - polyError ρ y * polyError ρ x) *
      polyValue ρ x⁻¹ * polyValue ρ y⁻¹ := by
    simp only [commutatorElement_def, polyError, rep_mul, sub_mul, mul_sub, one_mul, mul_one]
    rw [mul_assoc (polyValue ρ y) (polyValue ρ x) _, rep_cancel, mul_one, rep_cancel]
    noncomm_ring
  rw [eq]
  apply dvd_mul_of_dvd_left
  apply dvd_mul_of_dvd_left
  apply dvd_sub (dvd_product hx hy)
  rw [Nat.add_comm]
  exact dvd_product hy hx

private theorem depth_nil (hall : ∀ g, g ∈ depth ρ 1) (n : ℕ) :
    Group.IsNilpotent (G ⧸ depth ρ n) := by
  have h (k : ℕ) : (⊤ : Subgroup G).lowerCentralSeries k ≤ depth ρ k := by
    induction k with
    | zero => intro g _; change X ^ 0 ∣ polyError ρ g; simp
    | succ k ih =>
      rw [lowerCentralSeries_succ]
      exact commutator_le.mpr fun x hx y _ => depth_comm ρ (ih hx) (hall y)
  apply nilpotent_iff_lowerCentralSeries.mpr
  refine ⟨n, ?_⟩
  have hs := MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective (depth ρ n))
  have hh := (Subgroup.map_eq_bot_iff _).mpr ((h n).trans (QuotientGroup.ker_mk' _).symm.le)
  rwa [map_lowerCentralSeries, Subgroup.map_top, hs] at hh

private theorem coeff_err_mul (hall : ∀ g, g ∈ depth ρ 1) (n : ℕ) (x y : G)
    (hx : x ∈ depth ρ n) :
    (polyError ρ (x * y)).coeff n = (polyError ρ x).coeff n + (polyError ρ y).coeff n := by
  have he : polyError ρ (x * y) =
      polyError ρ x * polyError ρ y + polyError ρ x + polyError ρ y := by
    simp only [polyError, rep_mul]; noncomm_ring
  have hz := X_pow_dvd_iff.mp (dvd_product hx (hall y)) n (Nat.lt_succ_self n)
  simp [he, hz]

private theorem depth_pure [IsAddTorsionFree S] (hall : ∀ g, g ∈ depth ρ 1)
    (m : ℕ) (hm : m ≠ 0) (x : G) (n : ℕ) :
    x ^ m ∈ depth ρ n → x ∈ depth ρ n := by
  induction n with
  | zero => intro _; change X ^ 0 ∣ polyError ρ x; simp
  | succ n ih =>
    intro hm'
    have hx := ih (depth_le ρ (Nat.le_succ n) hm')
    have hpow (k : ℕ) : (polyError ρ (x ^ k)).coeff n = k • (polyError ρ x).coeff n := by
      induction k with
      | zero => simp [polyError, rep_one]
      | succ k ihk =>
        rw [pow_succ, coeff_err_mul ρ hall _ _ _ ((depth ρ n).pow_mem hx k), ihk, succ_nsmul]
    have hz := X_pow_dvd_iff.mp hm' n (Nat.lt_succ_self n)
    rw [hpow] at hz
    apply X_pow_dvd_iff.mpr
    intro d hd
    rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hd) with hlt | rfl
    · exact X_pow_dvd_iff.mp hx d hlt
    · exact (nsmul_eq_zero_iff_right hm).mp hz

private theorem poly_residual [IsAddTorsionFree S] (hinj : Function.Injective ρ)
    (hall : ∀ g, g ∈ depth ρ 1) : IsResiduallyTorsionFreeNilpotent G := by
  intro g hg
  have hn : ∃ n, g ∉ depth ρ n := by
    by_contra! hh
    apply hg
    apply hinj
    apply Units.ext
    change polyValue ρ g = polyValue ρ 1
    rw [rep_one, ← sub_eq_zero]
    apply AddMonoidAlgebra.ext
    apply Finsupp.ext
    intro d
    simpa [polyError] using X_pow_dvd_iff.mp (hh (d + 1)) d (Nat.lt_succ_self d)
  obtain ⟨n, hn⟩ := hn
  refine ⟨depth ρ n, inferInstance, hn, depth_nil ρ hall n, ?_⟩
  intro x hx ht
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (depth ρ n) x
  apply hx
  let p := QuotientGroup.mk' (depth ρ n)
  have hy : p (y ^ orderOf (p y)) = 1 := by rw [map_pow, pow_orderOf_eq_one]
  exact (QuotientGroup.eq_one_iff y).mpr (depth_pure ρ hall _ ht.orderOf_pos.ne' y n
    ((QuotientGroup.eq_one_iff _).mp hy))

end Filtration

-- The two elementary shears have off-diagonal entries in opposite positions. In the
-- ping-pong action on matrix polynomials, a nonzero shear switches the row of the
-- leading coefficient and increases the degree.
private abbrev M₂ := Matrix Bool Bool ℤ
private abbrev P₂ := Polynomial M₂

private theorem single_ne_zero (i j : Bool) {x : ℤ} (hx : x ≠ 0) : Matrix.single i j x ≠ 0 := by
  intro h
  exact hx (by simpa using congrArg (fun m : M₂ => m i j) h)

private def inc (i : Bool) (n : ℤ) : P₂ := monomial 1 (Matrix.single i (!i) n)
private def shear (i : Bool) (n : ℤ) : P₂ := 1 + inc i n

private theorem inc_zero (i : Bool) : inc i 0 = 0 := by
  simp [inc]

private theorem inc_add (i : Bool) (n m : ℤ) : inc i (n + m) = inc i n + inc i m := by
  simp [inc, Matrix.single_add]

private theorem shear_mul (i : Bool) (n m : ℤ) : shear i n * shear i m = shear i (n + m) := by
  have h : inc i n * inc i m = 0 := by simp [inc, monomial_mul_monomial]
  simp [shear, inc_add, add_mul, mul_add, h, add_comm, add_assoc]

private def shearRep (i : Bool) : Multiplicative ℤ →* P₂ˣ where
  toFun n := ⟨shear i n.toAdd, shear i (-n.toAdd), by rw [shear_mul]; simp [shear, inc_zero],
    by rw [shear_mul]; simp [shear, inc_zero]⟩
  map_one' := Units.ext (by change shear i 0 = 1; rw [shear, inc_zero, add_zero])
  map_mul' x y := Units.ext (shear_mul i x.toAdd y.toAdd).symm

private def component (i : Bool) : FreeGroup Unit →* P₂ˣ :=
  (shearRep i).comp FreeGroup.mulEquivIntOfUnique.toMonoidHom

private def zone (i : Bool) : Set P₂ :=
  {p | ∃ n : ℤ, n ≠ 0 ∧ p.leadingCoeff = Matrix.single i false n}

private theorem shear_zone (i j : Bool) (hij : i ≠ j) (n : ℤ) (hn : n ≠ 0)
    {p : P₂} (hp : p ∈ zone j) : shear i n * p ∈ zone i := by
  obtain ⟨m, hm, hp⟩ := hp
  have he : (!i) = j := by cases i <;> cases j <;> simp_all
  have hprod : (inc i n).leadingCoeff * p.leadingCoeff = Matrix.single i false (n * m) := by
    simp [inc, leadingCoeff_monomial, hp, he]
  have hne := single_ne_zero i false (mul_ne_zero hn hm)
  have h' : (inc i n).leadingCoeff * p.leadingCoeff ≠ 0 := hprod ▸ hne
  have hp0 : p ≠ 0 := by intro hh; simp [hh] at h'
  have hd : p.degree < (inc i n * p).degree := by
    rw [degree_mul' h', inc, degree_monomial 1 (single_ne_zero _ _ hn), degree_eq_natDegree hp0]
    norm_cast
    omega
  refine ⟨n * m, mul_ne_zero hn hm, ?_⟩
  rw [shear, add_mul, one_mul, leadingCoeff_add_of_degree_lt hd, leadingCoeff_mul' h', hprod]

private def freeRep : FreeGroup Bool →* P₂ˣ :=
  (Monoid.CoprodI.lift component).comp freeGroupEquivCoprodI.toMonoidHom

private theorem freeRep_injective : Function.Injective freeRep := by
  apply Function.Injective.comp _ freeGroupEquivCoprodI.injective
  apply Monoid.CoprodI.lift_injective_of_ping_pong component _ zone
  · exact fun i => ⟨C (Matrix.single i false 1), 1, one_ne_zero, leadingCoeff_C _⟩
  · intro i j hij
    apply Set.disjoint_left.mpr
    rintro p ⟨m, hm, he⟩ ⟨n, _, hf⟩
    have h := congrArg (fun f : M₂ => f i false) (he.symm.trans hf)
    exact hm (by simpa [hij.symm] using h)
  · rintro i j hij x hx _ ⟨p, hp, rfl⟩
    apply shear_zone _ _ hij _ _ hp
    intro hz
    apply hx
    apply FreeGroup.mulEquivIntOfUnique.injective
    exact Multiplicative.toAdd.injective (hz.trans (by simp))
  · right
    refine ⟨false, ?_⟩
    rw [FreeGroup.freeGroupUnitEquivInt.cardinal_eq, Cardinal.mk_denumerable]
    exact Cardinal.natCast_le_aleph0

private theorem free_residual : IsResiduallyTorsionFreeNilpotent (FreeGroup Bool) := by
  let : IsAddTorsionFree M₂ := inferInstanceAs (IsAddTorsionFree (Bool → Bool → ℤ))
  apply poly_residual freeRep freeRep_injective
  intro x
  induction x using FreeGroup.induction_on with
  | one => exact (depth freeRep 1).one_mem
  | of i =>
    change X ^ 1 ∣ polyError freeRep (FreeGroup.of i)
    rw [pow_one, X_dvd_iff]
    change (shear i _ - 1).coeff 0 = 0
    simp [shear, inc, coeff_monomial]
  | inv_of x hx => exact (depth _ _).inv_mem hx
  | mul x y hx hy => exact (depth _ _).mul_mem hx hy

/-! ## The presentation and its two free projections

The generators are `a, b, t, u`. In the two projections, `a` and `b` each occur in just
one factor, `t` shifts both factors, and `u` shifts the first by six. Thus the six mixed
commutator relations imply that every conjugate of `a` by a power of `t` commutes with
every such conjugate of `b`. -/

private abbrev F := FreeGroup (Fin 4)
private def a : F := FreeGroup.of 0
private def b : F := FreeGroup.of 1
private def t : F := FreeGroup.of 2
private def u : F := FreeGroup.of 3
private def act {G : Type*} [Group G] (g h : G) := g * h * g⁻¹
private def c (n : ℕ) : F := ⁅act (t ^ n) a, b⁆
private def s : F := t ^ 6 / u
private def rel : Set F := {⁅u, t⁆, ⁅u, b⁆, ⁅s, a⁆} ∪ c '' Set.Iio 6
private def R : Subgroup F := normalClosure rel

private instance relatorSubgroupNormal : R.Normal := normalClosure_normal
private abbrev Q := F ⧸ R
private abbrev E := F ⧸ ⁅(⊤ : Subgroup F), R⁆

private theorem finitePresentation : Group.IsFinitelyPresented Q := by
  have hf : rel.Finite := (Set.toFinite {⁅u, t⁆, ⁅u, b⁆, ⁅s, a⁆}).union
    ((Set.finite_Iio 6).image c)
  have : Finite rel := hf
  exact inferInstanceAs (Group.IsFinitelyPresented (PresentedGroup rel))

private theorem map_act {G H : Type*} [Group G] [Group H] (f : G →* H) (g h : G) :
    f (act g h) = act (f g) (f h) := by simp [act]

private theorem act_act {G : Type*} [Group G] (x y z : G) :
    act x (act y z) = act (x * y) z := by simp [act, mul_assoc]

private abbrev q := mk' R

private theorem relOne {r : F} (hr : r ∈ rel) : q r = 1 :=
  (eq_one_iff _).mpr (subset_normalClosure hr : r ∈ R)

private theorem commute_ut : Commute (q u) (q t) := commutatorElement_eq_one_iff_commute.mp
  (by simpa using relOne (r := ⁅u, t⁆) (by simp [rel]))

private theorem commute_ub : Commute (q u) (q b) := commutatorElement_eq_one_iff_commute.mp
  (by simpa using relOne (r := ⁅u, b⁆) (by simp [rel]))

private theorem commute_sa : Commute (q s) (q a) := commutatorElement_eq_one_iff_commute.mp
  (by simpa using relOne (r := ⁅s, a⁆) (by simp [rel]))

private def orbitGen (x : Q) (i : ℤ) : Q := act (q t ^ i) x
private def orbitGp (x : Q) := closure (Set.range (orbitGen x))

private theorem act_comm {G : Type*} [Group G] {x y : G} (h : Commute x y) : act x y = y := by
  rw [act, h.eq, mul_inv_cancel_right]

private theorem orbit_add (x : Q) (i j : ℤ) :
    orbitGen x (i + j) = act (q t ^ i) (orbitGen x j) := by rw [orbitGen, zpow_add, ← act_act]; rfl

private theorem orbit_shift (i k : ℤ) :
    orbitGen (q a) (6 * k + i) = act (q u ^ k) (orbitGen (q a) i) := by
  have us : Commute (q u) (q s) := by
    rw [s, map_div, map_pow, div_eq_mul_inv]
    exact (commute_ut.pow_right 6).mul_right (Commute.refl _).inv_right
  have tu : (q t)^ (6 : ℤ) = q u * q s := by
    rw [us.eq, s, map_div, map_pow, div_mul_cancel, zpow_ofNat]
  have ts : Commute (q t) (q s) := by
    rw [s, map_div, map_pow, div_eq_mul_inv]
    exact (Commute.refl _ |>.pow_right 6).mul_right commute_ut.symm.inv_right
  rw [orbit_add, zpow_mul, tu, us.mul_zpow, ← act_act]
  congr 1
  rw [orbitGen, act_act, (ts.zpow_zpow i k).symm.eq, ← act_act, act_comm (commute_sa.zpow_left k)]

private theorem commute_orbits (i j : ℤ) : Commute (orbitGen (q a) i) (orbitGen (q b) j) := by
  have base (d : ℤ) : Commute (orbitGen (q a) d) (q b) := by
    let r := (d % 6).toNat
    have hr : r < 6 := by dsimp [r]; omega
    have hr' : (r : ℤ) = d % 6 := by dsimp [r]; omega
    have hc : Commute (orbitGen (q a) r) (q b) :=
      commutatorElement_eq_one_iff_commute.mp (by
        simpa [c, map_act, orbitGen] using relOne (r := c r) (Or.inr ⟨r, hr, rfl⟩))
    have eq : d = 6 * (d / 6) + (r : ℤ) := by omega
    conv_lhs => rw [eq, orbit_shift]
    have hh := hc.map (MulAut.conj (q u ^ (d / 6)))
    change Commute (act (q u ^ (d / 6)) (orbitGen (q a) ↑r)) (act (q u ^ (d / 6)) (q b)) at hh
    rwa [act_comm (commute_ub.zpow_left _)] at hh
  have hh := (base (i - j)).map (MulAut.conj (q t ^ j))
  change Commute (act (q t ^ j) (orbitGen (q a) (i - j))) (orbitGen (q b) j) at hh
  rwa [← orbit_add, add_sub_cancel] at hh

private theorem groups_commute {x y : Q} (hx : x ∈ orbitGp (q a)) (hy : y ∈ orbitGp (q b)) :
    Commute x y := by
  have h : orbitGp (q b) ≤ centralizer (orbitGp (q a)) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    apply mem_centralizer_iff.mpr
    intro z hz
    have h' : orbitGp (q a) ≤ centralizer {orbitGen (q b) j} := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨i, rfl⟩
      exact mem_centralizer_singleton_iff.mpr (commute_orbits i j)
    exact (mem_centralizer_singleton_iff.mp (h' hz)).eq
  exact mem_centralizer_iff.mp (h hy) _ hx

private theorem normalize_orbit (x : Q) (g : Q)
    (h : ∀ i, ∃ j, act g (orbitGen x i) = orbitGen x j)
    {v : Q} (hv : v ∈ orbitGp x) : act g v ∈ orbitGp x := by
  have he : orbitGp x ≤ (orbitGp x).comap (MulAut.conj g).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    obtain ⟨j, hj⟩ := h i
    change act g _ ∈ orbitGp x
    rw [hj]
    exact subset_closure ⟨j, rfl⟩
  exact he hv

private def shifts (m n : ℤ) := q t ^ m * q u ^ n

private theorem normA (m n : ℤ) {v : Q} (hv : v ∈ orbitGp (q a)) :
    act (shifts m n) v ∈ orbitGp (q a) := by
  apply normalize_orbit _ _ _ hv
  intro i
  refine ⟨m + (6 * n + i), ?_⟩
  rw [orbit_add, orbit_shift, act_act]
  rfl

private theorem normB (m n : ℤ) {v : Q} (hv : v ∈ orbitGp (q b)) :
    act (shifts m n) v ∈ orbitGp (q b) := by
  apply normalize_orbit _ _ _ hv
  intro i
  refine ⟨m + i, ?_⟩
  rw [shifts, ← act_act, orbit_add]
  congr 1
  rw [orbitGen, act_act, (commute_ut.zpow_zpow n i).eq, ← act_act,
    act_comm (commute_ub.zpow_left n)]

private theorem shift_mul (m n k l : ℤ) : shifts m n * shifts k l = shifts (m + k) (n + l) := by
  simp only [shifts, zpow_add, mul_assoc]
  rw [← mul_assoc (q u ^ n), (commute_ut.zpow_zpow n k).eq, mul_assoc]

-- Move the two families of conjugates to the left and collect the shifts on the right.
private def normalForm (x : Q) := ∃ v ∈ orbitGp (q a), ∃ w ∈ orbitGp (q b), ∃ m n,
  x = v * w * shifts m n

private theorem normalForm_of_word (x : F) : normalForm (q x) := by
  have base (y : Q) : y ∈ orbitGp y :=
    subset_closure ⟨0, by simp [orbitGen, act]⟩
  have singleA (v : Q) (hv : v ∈ orbitGp (q a)) : normalForm v :=
    ⟨v, hv, 1, one_mem _, 0, 0, by simp [shifts]⟩
  have singleB (w : Q) (hw : w ∈ orbitGp (q b)) : normalForm w :=
    ⟨1, one_mem _, w, hw, 0, 0, by simp [shifts]⟩
  have torus (m n : ℤ) : normalForm (shifts m n) := ⟨1, one_mem _, 1, one_mem _, m, n, by simp⟩
  induction x using FreeGroup.induction_on with
  | one => simpa [shifts, t, u] using torus 0 0
  | of i =>
    fin_cases i
    · exact singleA _ (base _)
    · exact singleB _ (base _)
    · simpa [shifts, t, u] using torus 1 0
    · simpa [shifts, t, u] using torus 0 1
  | inv_of i _ =>
    rw [map_inv]
    fin_cases i
    · exact singleA _ ((orbitGp _).inv_mem (base _))
    · exact singleB _ ((orbitGp _).inv_mem (base _))
    · simpa [shifts, t, u] using torus (-1) 0
    · simpa [shifts, t, u] using torus 0 (-1)
  | mul x y hx hy =>
    obtain ⟨v, hv, w, hw, m, n, he⟩ := hx
    obtain ⟨v', hv', w', hw', k, l, he'⟩ := hy
    have hA := normA m n hv'
    have hB := normB m n hw'
    refine ⟨_, (orbitGp _).mul_mem hv hA, _, (orbitGp _).mul_mem hw hB, m + k, n + l, ?_⟩
    rw [map_mul, he, he', ← shift_mul]
    have swap := (groups_commute hA hw).eq
    calc
      _ = v * (w * act (shifts m n) v') * (act (shifts m n) w') *
          (shifts m n * shifts k l) := by unfold act; group
      _ = _ := by rw [← swap]; group

private abbrev F₂ := FreeGroup Bool
private abbrev letter : F₂ := FreeGroup.of false
private abbrev shiftLetter : F₂ := FreeGroup.of true

private def coords (left : Bool) : Fin 4 → F₂ :=
  ![if left then letter else 1, if left then 1 else letter, shiftLetter,
    if left then shiftLetter ^ 6 else 1]

private theorem relator_coordinate (left : Bool) (r : F) (hr : r ∈ rel) :
    FreeGroup.lift (coords left) r = 1 := by
  rcases hr with (rfl | rfl | rfl) | ⟨i, _, rfl⟩ <;> cases left <;>
    simp [c, coords, t, u, s, a, b, act, commutatorElement_def]; group

private def pr (left : Bool) : Q →* F₂ :=
  QuotientGroup.lift R (FreeGroup.lift (coords left))
    (normalClosure_le_normal (relator_coordinate left))

private theorem pr_a (i : Bool) : pr i (q a) = if i then letter else 1 := by
  change FreeGroup.lift _ (FreeGroup.of 0) = _
  rw [FreeGroup.lift_apply_of]; rfl

private theorem pr_b (i : Bool) : pr i (q b) = if i then 1 else letter := by
  change FreeGroup.lift _ (FreeGroup.of 1) = _
  rw [FreeGroup.lift_apply_of]; rfl

private theorem pr_t (i : Bool) : pr i (q t) = shiftLetter := by
  change FreeGroup.lift _ (FreeGroup.of 2) = _
  rw [FreeGroup.lift_apply_of]; rfl

private theorem pr_u (i : Bool) : pr i (q u) = if i then shiftLetter ^ 6 else 1 := by
  change FreeGroup.lift _ (FreeGroup.of 3) = _
  rw [FreeGroup.lift_apply_of]; rfl

private theorem orbit_killed {G : Type*} [Group G] (f : Q →* G) {y : Q} (h : f y = 1) :
    orbitGp y ≤ f.ker := by
  apply (closure_le _).mpr
  rintro _ ⟨j, rfl⟩
  simp [MonoidHom.mem_ker, orbitGen, act, h]

private theorem restore {y v : Q} {i : Bool} (h : pr i y = letter) (hv : v ∈ orbitGp y)
    (he : pr i v = 1) : v = 1 := by
  let back := FreeGroup.lift (fun d : Bool => if d then q t else y)
  have hh : orbitGp y ≤ ((back.comp (pr i)).eqLocus (MonoidHom.id Q)) := by
    apply (closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    change back (pr i (orbitGen y j)) = orbitGen y j
    simp only [orbitGen, map_act, map_zpow, h, pr_t]
    simp [back, letter, shiftLetter]
  have eq : back (pr i v) = v := hh hv
  simpa [he] using eq.symm

private def weight : F₂ →* Multiplicative ℤ :=
  FreeGroup.lift fun i => if i then Multiplicative.ofAdd 1 else 1

private theorem weight_x : weight letter = 1 := by simp [weight, letter]

private theorem weight_y : weight shiftLetter = Multiplicative.ofAdd 1 := by
  simp [weight, shiftLetter]

-- Exponent sums recover the two shift exponents. Each orbit subgroup is then
-- recovered from its own projection and dies under the opposite projection.

private theorem separates (x : Q) (h1 : pr true x = 1) (h2 : pr false x = 1) : x = 1 := by
  obtain ⟨r, rfl⟩ := mk'_surjective R x
  obtain ⟨v, hv, w, hw, m, n, he⟩ := normalForm_of_word r
  have hv2 : pr false v = 1 := orbit_killed (pr false) (pr_a false) hv
  have hw1 : pr true w = 1 := orbit_killed (pr true) (pr_b true) hw
  have hv1 : weight (pr true v) = 1 := orbit_killed (weight.comp (pr true))
    (y := q a) (by change weight (pr true (q a)) = 1; rw [pr_a]; exact weight_x) hv
  have hw2 : weight (pr false w) = 1 := orbit_killed (weight.comp (pr false))
    (y := q b) (by change weight (pr false (q b)) = 1; rw [pr_b]; exact weight_x) hw
  change pr true (q r) = 1 at h1
  change pr false (q r) = 1 at h2
  rw [he] at h1 h2
  simp only [shifts, map_mul, map_zpow, pr_t, pr_u, hw1, hv2, Bool.false_eq_true,
    ite_false, ite_true, mul_one, one_mul, one_zpow] at h1 h2
  have hm := congrArg weight h2
  simp only [map_mul, map_zpow, hw2, one_mul, map_one] at hm
  rw [weight_y] at hm
  change m • (1 : ℤ) = 0 at hm
  simp only [zsmul_eq_mul, mul_one] at hm
  replace hm : m = 0 := by simpa using hm
  subst m
  have hn := congrArg weight h1
  simp only [zpow_zero, one_mul, map_mul, map_zpow, map_pow, hv1, map_one] at hn
  rw [weight_y] at hn
  change n • ((6 : ℕ) • (1 : ℤ)) = 0 at hn
  have hn' : n = 0 := by simpa using hn
  subst n
  simp only [zpow_zero, mul_one] at h1 h2
  rw [he, restore (pr_a true) hv h1, restore (pr_b false) hw h2]
  simp [shifts]

private theorem base_residual (hfree : IsResiduallyTorsionFreeNilpotent F₂) :
    IsResiduallyTorsionFreeNilpotent Q := by
  intro x hx
  have hi : ∃ i, pr i x ≠ 1 := by
    by_contra! he
    exact hx (separates x (he true) (he false))
  obtain ⟨i, hi⟩ := hi
  obtain ⟨N, instN, hxN, hn, ht⟩ := hfree (pr i x) hi
  let f := (mk' N).comp (pr i)
  let e := quotientKerEquivRange f
  refine ⟨f.ker, inferInstance, mt (eq_one_iff _).mp hxN, ?_, ?_⟩
  · exact Group.nilpotent_of_surjective e.symm.toMonoidHom e.symm.surjective
  · intro y hy hfin
    have hy' : (e y : F₂ ⧸ N) ≠ 1 := by
      intro h
      apply hy
      apply e.injective
      exact Subtype.ext (h.trans (congrArg Subtype.val (map_one e)).symm)
    obtain ⟨k, hk, he⟩ := hfin.exists_pow_eq_one
    apply ht _ hy' (isOfFinOrder_iff_pow_eq_one.mpr ⟨k, hk, ?_⟩)
    exact congrArg Subtype.val ((map_pow e y k).symm.trans ((congrArg e he).trans (map_one e)))

/-! ## The obstruction in the lower central series

In any quotient in which the relators are central, the mixed commutators
`c i = [t ^ i a t ^ (-i), b]` form a central sequence of period six. Taking successive
commutators with `t` gives finite differences of this sequence. In a nilpotent quotient,
a sufficiently high difference vanishes. -/

private theorem comm_congr_left {G : Type*} [Group G] {v v' : G} (b : G)
    (h : mk' (center G) v = mk' (center G) v') : ⁅v, b⁆ = ⁅v', b⁆ := by
  have hd : v / v' ∈ center G := eq_iff_div_mem.mp h
  have hcomm := mem_center_iff.mp hd
  conv_lhs => rw [← div_mul_cancel v v', commutatorElement_mul_left_eq_conj_mul,
    (hcomm _).symm, mul_inv_cancel_right, commutatorElement_eq_one_iff_mul_comm.mpr (hcomm b).symm,
    mul_one]

private theorem comm_congr {G : Type*} [Group G] {v v' w w' : G}
    (h : mk' (center G) v = mk' (center G) v') (k : mk' (center G) w = mk' (center G) w') :
    ⁅v, w⁆ = ⁅v', w'⁆ := by
  rw [comm_congr_left _ h]
  apply inv_injective
  simpa only [commutatorElement_inv] using comm_congr_left v' k

private theorem commutator_period_step {G : Type*} [Group G] (f : F →* G)
    (hf : ∀ r ∈ rel, f r ∈ center G) (i : ℕ) :
    f (c (i + 6)) = act (f u) (f (c i)) := by
  let q := (mk' (center G)).comp f
  have kill (r : F) (hr : r ∈ rel) : q r = 1 := (eq_one_iff _).mpr (hf _ hr)
  have ut : Commute (q u) (q t) := commutatorElement_eq_one_iff_commute.mp
    (by simpa using kill ⁅u, t⁆ (by simp [rel]))
  have ub : Commute (q u) (q b) := commutatorElement_eq_one_iff_commute.mp
    (by simpa using kill ⁅u, b⁆ (by simp [rel]))
  have sa : Commute ((q t) ^ 6 / q u) (q a) := commutatorElement_eq_one_iff_commute.mp
    (by simpa [s] using kill ⁅s, a⁆ (by simp [rel]))
  have su : Commute ((q t) ^ 6 / q u) (q u) :=
    by rw [div_eq_mul_inv]; exact (ut.symm.pow_left 6).mul_left (Commute.refl _).inv_left
  have ht6 : act (q t ^ 6) (q a) = act (q u) (q a) := by
    rw [← div_mul_cancel (q t ^ 6) (q u), su.eq, ← act_act]
    congr 1
    rw [act, sa.eq, mul_inv_cancel_right]
  unfold c
  simp only [map_commutatorElement, act, conjugate_commutatorElement]
  apply comm_congr
  · simp only [← map_inv f, ← map_mul f]
    change q (act (t ^ (i + 6)) a) = q (act u (act (t ^ i) a))
    simp only [map_act, map_pow, pow_add, ← act_act, ht6]
    rw [act_act, (ut.pow_right i).eq.symm, ← act_act]
  · simp only [← map_inv f, ← map_mul f]
    change q b = q (act u b)
    simp [act, ub.eq]

private theorem periodic {G : Type*} [Group G] (f : F →* G)
    (hf : ∀ r ∈ rel, f r ∈ center G) :
    (∀ i, f (c i) ∈ center G) ∧ (∀ i, f (c (i + 6)) = f (c i)) := by
  have hc (i : ℕ) : f (c i) ∈ center G := by
    induction i using Nat.strong_induction_on with
    | ind i ih =>
      by_cases hi : i < 6
      · exact hf _ (Or.inr ⟨i, hi, rfl⟩)
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le' (Nat.le_of_not_gt hi)
        rw [commutator_period_step f hf j]
        exact (inferInstance : (center G).Normal).conj_mem _ (ih j (by omega)) _
  refine ⟨hc, fun i => ?_⟩
  rw [commutator_period_step f hf i, act, mem_center_iff.mp (hc i), mul_inv_cancel_right]

private def iteratedDifference {G : Type*} [Group G] (t a : G) : ℕ → ℕ → G
  | 0, i => act (t ^ i) a
  | n + 1, i => iteratedDifference t a n (i + 1) / iteratedDifference t a n i

private theorem act_div {G : Type*} [Group G] (t x y : G) :
    act t (x / y) = act t x / act t y := by simp [act, div_eq_mul_inv, mul_assoc]

private theorem act_iteratedDifference {G : Type*} [Group G] (t a : G) (n i : ℕ) :
    act t (iteratedDifference t a n i) = iteratedDifference t a n (i + 1) := by
  induction n generalizing i with
  | zero => simp [iteratedDifference, act_act, pow_succ']
  | succ n ih => simp only [iteratedDifference, act_div, ih]

private theorem iteratedDifference_mem {G : Type*} [Group G] (t a : G) (n i : ℕ) :
    iteratedDifference t a n i ∈ (⊤ : Subgroup G).lowerCentralSeries n := by
  induction n generalizing i with
  | zero => exact mem_top _
  | succ n ih =>
    rw [lowerCentralSeries_succ, commutator_comm]
    simpa only [iteratedDifference, ← act_iteratedDifference t a n i, act, div_eq_mul_inv,
      commutatorElement_def]
      using commutator_mem_commutator (mem_top t) (ih i)

private theorem bracket_div {G : Type*} [Group G] (x y b : G) (hy : ⁅y, b⁆ ∈ center G)
    (hx : ⁅x, b⁆ ∈ center G) :
    ⁅x / y, b⁆ = ⁅x, b⁆ / ⁅y, b⁆ := by
  have hi := (center G).inv_mem hy
  rw [div_eq_mul_inv, commutatorElement_mul_left_eq_conj_mul, commutatorElement_inv_left,
    ← commutatorElement_inv y b, mem_center_iff.mp hi, inv_mul_cancel_right,
    mem_center_iff.mp hi, mul_inv_cancel_right, div_eq_mul_inv]
  exact (mem_center_iff.mp hx _)

private def delta {A : Type*} [AddCommGroup A] (g : ℕ → A) : ℕ → A := fun i => g (i + 1) - g i
private def contrast {A : Type*} [AddCommGroup A] (g : ℕ → A) : ℕ → A :=
  fun i => g (i + 4) + g (i + 3) - g (i + 1) - g i

-- For a six-periodic sequence, the difference of its contrast is the contrast shifted
-- by two. Iterating recovers the original contrast from every order of difference.

private theorem contrast_vanishes {A : Type*} [AddCommGroup A] (g : ℕ → A)
    (hp : ∀ i, g (i + 6) = g i) (k : ℕ) :
    (∀ i, (delta^[k]) g i = 0) → contrast g 0 = 0 := by
  have prop (d : ℕ → A) (hd : ∀ i, d (i + 6) = d i) (i : ℕ) :
      contrast (delta d) i = contrast d (i + 2) := by
    simp only [contrast, delta, Nat.add_assoc, Nat.reduceAdd, hd]
    abel
  suffices hh : ∀ d : ℕ → A, (∀ i, d (i + 6) = d i) →
      (∀ i, (delta^[k]) d i = 0) → ∀ i, contrast d i = 0 by exact fun h => hh g hp h 0
  induction k with
  | zero =>
    intro d _ h i
    change ∀ i, d i = 0 at h
    simp [contrast, h]
  | succ k ih =>
    intro d hd h i
    have hd' (j : ℕ) : delta d (j + 6) = delta d j := by
      change d ((j + 1) + 6) - d (j + 6) = _
      rw [hd, hd]
      rfl
    have hk := ih (delta d) hd' (by simpa [Function.iterate_succ_apply] using h) (i + 4)
    rw [prop d hd, show i + 4 + 2 = i + 6 by omega] at hk
    simpa only [contrast, Nat.add_right_comm i 6, hd] using hk

private def witness : F := c 4 * c 3 / c 1 / c 0

private theorem witness_killed {G : Type*} [Group G] [Group.IsNilpotent G] (f : F →* G)
    (hf : ∀ r ∈ rel, f r ∈ center G) : f witness = 1 := by
  obtain ⟨hc, hp⟩ := periodic f hf
  let g (n i : ℕ) := ⁅iteratedDifference (f t) (f a) n i, f b⁆
  have hg (n i : ℕ) : g n i ∈ center G := by
    induction n generalizing i with
    | zero => simpa [g, iteratedDifference, c, map_act] using hc i
    | succ n ih =>
      change ⁅_ / _, f b⁆ ∈ _
      rw [bracket_div _ _ _ (ih i) (ih (i + 1))]
      exact (center G).div_mem (ih _) (ih _)
  let : CommGroup (center G) := { (inferInstance : Group (center G)) with
    mul_comm := fun x y => Subtype.ext ((mem_center_iff.mp y.2) x) }
  let z (n i : ℕ) : Additive (center G) := Additive.ofMul ⟨g n i, hg n i⟩
  have hz (n : ℕ) : z n = (delta^[n]) (z 0) := by
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [Function.iterate_succ_apply', ← ih]
      funext i
      apply Additive.toMul.injective
      apply Subtype.ext
      exact bracket_div _ _ _ (hg n i) (hg n (i + 1))
  obtain ⟨k, hk⟩ := nilpotent_iff_lowerCentralSeries.mp ‹Group.IsNilpotent G›
  have van := contrast_vanishes (z 0) (fun i => by
    apply Additive.toMul.injective
    apply Subtype.ext
    simpa [z, g, iteratedDifference, c, map_act] using hp i) k (fun i => by
      rw [← hz]
      apply Additive.toMul.injective
      apply Subtype.ext
      have hv := iteratedDifference_mem (f t) (f a) k i
      rw [hk, mem_bot] at hv
      change ⁅iteratedDifference (f t) (f a) k i, f b⁆ = 1
      simp [hv])
  have eq := congrArg (fun x : Additive (center G) => (x.toMul : G)) van
  simpa [witness, contrast, z, g, iteratedDifference, c, map_act] using eq

/-! ## Detecting the obstruction

Over the field of seven elements, let `a` translate the first coordinate, let `b` add
the first coordinate to the second, and let `t` scale the first coordinate by three.
The mixed commutators translate the second coordinate by the negatives of powers of three.
Their contrast acts nontrivially, and the relators are central in the image. -/

private abbrev Plane := ZMod 7 × ZMod 7

private def moveX (x : ZMod 7) : Equiv.Perm Plane where
  toFun z := (z.1 + x, z.2)
  invFun z := (z.1 - x, z.2)
  left_inv z := by simp
  right_inv z := by simp

private abbrev permA := moveX 1

private def permB : Equiv.Perm Plane where
  toFun z := (z.1, z.2 + z.1)
  invFun z := (z.1, z.2 - z.1)
  left_inv z := by simp
  right_inv z := by simp

private def permT : Equiv.Perm Plane where
  toFun z := (3 * z.1, z.2)
  invFun z := (5 * z.1, z.2)
  left_inv z := by dsimp; rw [← mul_assoc, show (5 * 3 : ZMod 7) = 1 by decide, one_mul]
  right_inv z := by dsimp; rw [← mul_assoc, show (3 * 5 : ZMod 7) = 1 by decide, one_mul]

private def genPerm : Fin 4 → Equiv.Perm Plane := ![permA, permB, permT, 1]
private def permRep := FreeGroup.lift genPerm

private def moveY (x : ZMod 7) : Equiv.Perm Plane where
  toFun z := (z.1, z.2 + x)
  invFun z := (z.1, z.2 - x)
  left_inv z := by simp
  right_inv z := by simp

private theorem scaleX (x : ZMod 7) : act permT (moveX x) = moveX (3 * x) := by
  ext ⟨y, z⟩ : 1
  change (3 * (5 * y + x), z) = (y + 3 * x, z)
  rw [mul_add, ← mul_assoc, show (3 * 5 : ZMod 7) = 1 by decide, one_mul]

private theorem move_bracket (x : ZMod 7) : ⁅moveX x, permB⁆ = moveY (-x) := by
  ext ⟨y, z⟩ : 1
  change (y - x + x, z - y + (y - x)) = (y, z + -x)
  congr 1 <;> abel

private theorem perm_c (i : ℕ) : permRep (c i) = moveY (-(3 ^ i)) := by
  have hh (k : ℕ) : act (permT ^ k) permA = moveX (3 ^ k) := by
    induction k with
    | zero => simp [act, permA]
    | succ k ih => rw [pow_succ', ← act_act, ih, scaleX, pow_succ']
  change permRep ⁅act (t ^ i) a, b⁆ = _
  rw [map_commutatorElement, map_act, map_pow]
  change ⁅act (permT ^ i) permA, permB⁆ = _
  rw [hh, move_bracket]

private theorem permT_pow (i : ℕ) (y z : ZMod 7) :
    (permT ^ i) (y, z) = (3 ^ i * y, z) := by
  induction i with
  | zero => simp
  | succ i ih =>
    rw [pow_succ', Equiv.Perm.mul_apply, ih]
    change (3 * (3 ^ i * y), z) = _
    rw [← mul_assoc, ← pow_succ']

private theorem rels_central (r : F) (hr : r ∈ rel) :
    permRep.rangeRestrict r ∈ center permRep.range := by
  apply mem_center_iff.mpr
  rintro ⟨q, hq⟩
  apply Subtype.ext
  suffices h : permRep.range ≤ centralizer {permRep r} from
    (mem_centralizer_singleton_iff.mp (h hq)).eq
  apply FreeGroup.range_lift_le
  rintro _ ⟨i, rfl⟩
  apply mem_centralizer_singleton_iff.mpr
  have hu : permRep u = 1 := by change genPerm 3 = 1; rfl
  have hs : permRep s = 1 := by
    change permRep (t ^ 6 / u) = _
    rw [map_div, hu, div_one, map_pow]
    change permT ^ 6 = 1
    ext ⟨y, z⟩ : 1
    rw [permT_pow, show (3 ^ 6 : ZMod 7) = 1 by decide, one_mul, Equiv.Perm.one_apply]
  rcases hr with (rfl | rfl | rfl) | ⟨j, _, rfl⟩
  all_goals try simp [hu, hs]
  rw [perm_c]
  fin_cases i
  all_goals apply Equiv.ext; rintro ⟨y, z⟩
  · rfl
  · change (y, (z + _) + y) = (y, (z + y) + _)
    congr 1
    abel
  · rfl
  · rfl

private theorem detected : permRep witness (0, 0) ≠ (0, 0) := by
  simp only [witness, map_mul, map_div, perm_c]
  decide

private theorem kill_comm {G H : Type*} [Group G] [Group H] (f : G →* H)
    (R : Subgroup G) (h : R ≤ (center f.range).comap f.rangeRestrict) :
    ⁅(⊤ : Subgroup G), R⁆ ≤ f.ker := by
  refine commutator_le.mpr fun x _ y hy => ?_
  rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
  exact congrArg Subtype.val (mem_center_iff.mp (h hy) (f.rangeRestrict x))

private theorem witness_notMem_commutator : witness ∉ ⁅(⊤ : Subgroup F), R⁆ := by
  have hr : R ≤ (center permRep.range).comap permRep.rangeRestrict :=
    normalClosure_le_normal rels_central
  intro h
  have he : permRep witness = 1 := kill_comm permRep R hr h
  exact detected (congrArg (fun z : Equiv.Perm Plane => z (0, 0)) he)

private theorem central_extension_fails : ¬ IsResiduallyNilpotent E := by
  let p := mk' ⁅(⊤ : Subgroup F), R⁆
  intro h
  obtain ⟨N, instN, hw, hn⟩ := h (p witness) (mt (eq_one_iff _).mp witness_notMem_commutator)
  let q := (mk' N).comp p
  have hq : Function.Surjective q := (mk'_surjective N).comp (mk'_surjective _)
  have hcentral (r : F) (hr : r ∈ rel) : q r ∈ center (E ⧸ N) := by
    apply mem_center_iff.mpr
    intro g
    obtain ⟨x, rfl⟩ := hq g
    rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement]
    have hk : p ⁅x, r⁆ = 1 := (eq_one_iff _).mpr
      (commutator_mem_commutator (mem_top x) (subset_normalClosure hr : r ∈ R))
    exact congrArg (mk' N) hk |>.trans (map_one _)
  exact hw ((eq_one_iff _).mp (witness_killed q hcentral))

end

/--
**Free central extensions need not be residually nilpotent.** There exist a free group $F$ and a
normal subgroup $R$ of $F$ such that $F/R$ is finitely presented and residually torsion-free
nilpotent, while $F/[F, R]$ is not residually nilpotent; here $[F, R]$ is the subgroup of $F$
generated by all commutators $[f, r]$ with $f \in F$ and $r \in R$.

Source:
E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook,
21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 16.65 (R. Mikhailov, I.
B. S. Passi); resolution: V. V. Bludov, J. Group Theory 12 (2009), no. 4, 579-590, Kourovka Archive,
Problem 16.65 (Yes, there does).
-/
public theorem existsPresentationWithNonResiduallyNilpotentQuotient_holds :
    existsPresentationWithNonResiduallyNilpotentQuotient := by
  exact ⟨Fin 4, R, inferInstance, finitePresentation, base_residual free_residual,
    central_extension_fails⟩

end MathlibExt.GroupTheory.FreeCentralExtensionResiduallyNilpotentKourovka16Problem65Wanted
