/-!
# Linearity of the group of Kourovka Problem 18.86

We construct a faithful three-dimensional representation over the rational function field
`ℚ(X)`. The defining relation says that `b` commutes with `a⁻¹ * b * a`. These elements
generate the base of an HNN extension of `ℤ × ℤ`, with stable letter `a⁻¹` identifying the
two coordinate axes. We represent the base by diagonal matrices and the stable letter by a
matrix polynomial of degree one. A reduced word with `k` stable letters has a nonzero
coefficient in degree `k`.

Kourovka Notebook, Archive of Solved Problems, Problem 18.86 (V. A. Roman'kov): is the group `G =
⟨a, b | [[a, b], b] = 1⟩`, which is isomorphic to the group of all unitriangular automorphisms of
the free group of rank `3`, linear?

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.86 (V. A.
Roman'kov). UnsolvedMath record UM-00701515 (`KOU-18.86`), dataset ulamai/UnsolvedMath v1.8.0.

`[x, y] = x⁻¹ y⁻¹ x y` (the other convention gives an isomorphic group, via `a ↦ a⁻¹`, `b ↦ b⁻¹`);
linear means a faithful homomorphism into `GLₙ(K)` for some field `K` and some `n`.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.UnitriangularOneRelatorLinearKourovka18Problem86Wanted

/-- **The relator of Kourovka Problem 18.86.** This is the element $[[a, b], b]$ of the free group
on two generators $a$ and $b$, where $[x, y] = x^{-1} y^{-1} x y$; explicitly,
$[[a, b], b] = c^{-1} b^{-1} c b$ with $c = a^{-1} b^{-1} a b$. -/
def relator : FreeGroup (Fin 2) :=
  let a := FreeGroup.of (0 : Fin 2)
  let b := FreeGroup.of (1 : Fin 2)
  let c := a⁻¹ * b⁻¹ * a * b
  c⁻¹ * b⁻¹ * c * b

/-- **The one-relator group of Kourovka Problem 18.86.** This is the group
$G = \langle a, b \mid [[a, b], b] = 1 \rangle$ with generators $a, b$ and the single defining
relation $[[a, b], b] = 1$, where $[x, y] = x^{-1} y^{-1} x y$; that is, $G$ is the quotient of the
free group on $a$ and $b$ by the normal subgroup generated by $[[a, b], b]$. -/
abbrev OneRelatorGroup : Type := PresentedGroup ({relator} : Set (FreeGroup (Fin 2)))

/-- **Kourovka Problem 18.86 (statement).** The statement that the group $G$ with generators $a, b$
and the single defining relation $[[a, b], b] = 1$, where $[x, y] = x^{-1} y^{-1} x y$, is linear:
there are a field $K$, a natural number $n$ and an injective group homomorphism
$G \to \mathrm{GL}_n(K)$. -/
def oneRelatorGroupIsLinear : Prop :=
  ∃ (K : Type) (_ : Field K) (n : ℕ) (ρ : OneRelatorGroup →* Matrix.GeneralLinearGroup (Fin n) K),
    Function.Injective ρ

open Multiplicative HNNExtension Polynomial

private abbrev Base := Multiplicative ℤ × Multiplicative ℤ
private abbrev axis₁ := (MonoidHom.snd (Multiplicative ℤ) (Multiplicative ℤ)).ker
private abbrev axis₂ := (MonoidHom.fst (Multiplicative ℤ) (Multiplicative ℤ)).ker

private def swapAxes : axis₁ ≃* axis₂ where
  toFun g := ⟨g.val.swap, g.property⟩
  invFun g := ⟨g.val.swap, g.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

private abbrev Extension := HNNExtension Base axis₁ axis₂ swapAxes
private abbrev e₁ : Base := (ofAdd 1, 1)
private abbrev e₂ : Base := (1, ofAdd 1)

private theorem conjugate_first :
    (t : Extension) * of e₁ * t⁻¹ = of e₂ :=
  (equiv_eq_conj (φ := swapAxes) (⟨e₁, rfl⟩ : axis₁)).symm

private theorem relator_iff {H : Type*} [Group H] (a b : H) :
    (a⁻¹ * b⁻¹ * a * b)⁻¹ * b⁻¹ * (a⁻¹ * b⁻¹ * a * b) * b = 1 ↔
      Commute b (a⁻¹ * b * a) := by
  let c := a⁻¹ * b⁻¹ * a * b
  change c⁻¹ * b⁻¹ * c * b = 1 ↔ _
  have hc : c⁻¹ * b⁻¹ * c * b = 1 ↔ Commute c b := by
    change (c⁻¹ * b⁻¹ * c * b = 1) ↔ c * b = b * c
    rw [show c⁻¹ * b⁻¹ * c * b = (b * c)⁻¹ * (c * b) by group, inv_mul_eq_one]
    exact eq_comm
  rw [hc]
  constructor
  · intro h
    rw [show a⁻¹ * b * a = b * c⁻¹ by dsimp [c]; group]
    exact (Commute.refl b).mul_right h.symm.inv_right
  · intro h
    change Commute (a⁻¹ * b⁻¹ * a * b) b
    rw [show a⁻¹ * b⁻¹ * a = (a⁻¹ * b * a)⁻¹ by group]
    exact h.symm.inv_left.mul_left (Commute.refl b)

private abbrev genA : OneRelatorGroup := PresentedGroup.of (0 : Fin 2)
private abbrev genB : OneRelatorGroup := PresentedGroup.of (1 : Fin 2)

private theorem base_commute : Commute genB (genA⁻¹ * genB * genA) := by
  apply (relator_iff _ _).mp
  let f : FreeGroup (Fin 2) →* OneRelatorGroup := PresentedGroup.mk {relator}
  have h : f relator = 1 :=
    PresentedGroup.one_of_mem (Set.mem_singleton relator)
  dsimp only [relator] at h
  simp only [map_mul, map_inv] at h
  exact h

private def toExtension : OneRelatorGroup →* Extension :=
  PresentedGroup.toGroup (f := ![t⁻¹, of e₁]) (by
    rintro _ ⟨⟩
    simp only [relator, map_mul, map_inv, FreeGroup.lift_apply_of]
    apply (relator_iff _ _).mpr
    change Commute (of e₁ : Extension) ((t⁻¹)⁻¹ * of e₁ * t⁻¹)
    rw [inv_inv, conjugate_first]
    exact (Commute.all e₁ e₂).map of)

private def fromBase : Base →* OneRelatorGroup :=
  (zpowersHom _ genB).noncommCoprod (zpowersHom _ (genA⁻¹ * genB * genA))
    (fun m n ↦ base_commute.zpow_zpow m.toAdd n.toAdd)

private def fromExtension : Extension →* OneRelatorGroup :=
  HNNExtension.lift fromBase genA⁻¹ (by
    rintro ⟨⟨m, n⟩, hn⟩
    change n = 1 at hn
    subst n
    change genA⁻¹ * (genB ^ m.toAdd * (genA⁻¹ * genB * genA) ^ (0 : ℤ)) =
      (genB ^ (0 : ℤ) * (genA⁻¹ * genB * genA) ^ m.toAdd) * genA⁻¹
    rw [zpow_zero, zpow_zero, one_mul, mul_one]
    have h := @conj_zpow _ _ m.toAdd genA⁻¹ genB
    simpa [mul_assoc] using congrArg (· * genA⁻¹) h.symm)

private theorem toExtension_injective : Function.Injective toExtension := by
  have h : fromExtension.comp toExtension = MonoidHom.id _ := by
    apply PresentedGroup.ext
    intro i
    fin_cases i
    · change fromExtension (t : Extension)⁻¹ = genA
      simp [fromExtension]
    · change fromExtension (of e₁) = genB
      rw [fromExtension, lift_of]
      change genB ^ (1 : ℤ) * (genA⁻¹ * genB * genA) ^ (0 : ℤ) = genB
      simp
  exact Function.LeftInverse.injective (fun g ↦ DFunLike.congr_fun h g)

noncomputable section

open Matrix

private abbrev Mat := Matrix (Fin 3) (Fin 3) ℚ
private abbrev Vec := Fin 3 → ℚ

-- The two cyclic factors act on different coordinates, leaving the middle one fixed.
private def baseMatrix (g : Base) : Mat :=
  diagonal ![2 ^ g.2.toAdd, 1, 2 ^ g.1.toAdd]

private def baseHom : Base →* Mat where
  toFun := baseMatrix
  map_one' := by
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num [baseMatrix, diagonal_apply, Matrix.one_apply]
  map_mul' g h := by
    rw [baseMatrix, baseMatrix, baseMatrix, diagonal_mul_diagonal]
    congr 1
    ext i
    fin_cases i <;> simp [zpow_add₀]

private def polyBase : Base →* (Polynomial Mat)ˣ :=
  Units.map (C : Mat →+* Polynomial Mat).toMonoidHom |>.comp baseHom.toHomUnits

-- The stable letter is P (1 + X u vᵀ), where P interchanges the outer coordinates.
-- Its two signs have rank-one linear coefficients.
private def swapMatrix : Mat := !![0, 0, 1; 0, 1, 0; 1, 0, 0]

private def column (u : ℤˣ) : Vec := if u = 1 then ![0, 1, 1] else ![1, 1, 0]
private def row (u : ℤˣ) : Vec := if u = 1 then ![1, -1, 0] else ![0, 1, -1]
private def leading (u : ℤˣ) : Mat := vecMulVec (column u) (row u)

private def letter (u : ℤˣ) : Polynomial Mat :=
  C swapMatrix + monomial 1 (leading u)

private theorem letter_inverse (u : ℤˣ) : letter u * letter (-u) = 1 := by
  have hP : swapMatrix * swapMatrix = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [swapMatrix, Matrix.mul_apply, Matrix.one_apply, Fin.sum_univ_three]
  have hc : swapMatrix * leading (-u) = -(leading u * swapMatrix) := by
    rcases Int.units_eq_one_or u with rfl | rfl <;>
      ext i j <;> fin_cases i <;> fin_cases j <;>
      norm_num [swapMatrix, leading, column, row, Matrix.mul_apply, vecMulVec_apply,
        Fin.sum_univ_three]
  have hz : leading u * leading (-u) = 0 := by
    rcases Int.units_eq_one_or u with rfl | rfl <;>
      ext i j <;> fin_cases i <;> fin_cases j <;>
      norm_num [swapMatrix, leading, column, row, Matrix.mul_apply, vecMulVec_apply,
        Fin.sum_univ_three]
  simp [letter, add_mul, mul_add, ← map_mul, C_mul_monomial, monomial_mul_C,
    monomial_mul_monomial, hP, hc, hz, add_assoc]

private def stableMatrix : (Polynomial Mat)ˣ where
  val := letter 1
  inv := letter (-1)
  val_inv := letter_inverse 1
  inv_val := by simpa using letter_inverse (-1)

private theorem stableMatrix_pow (u : ℤˣ) :
    ((stableMatrix ^ (u : ℤ) : (Polynomial Mat)ˣ) : Polynomial Mat) = letter u := by
  rcases Int.units_eq_one_or u with rfl | rfl <;> simp [stableMatrix]

private def representation : Extension →* (Polynomial Mat)ˣ :=
  HNNExtension.lift polyBase stableMatrix (by
    rintro ⟨⟨m, n⟩, hn⟩
    change n = 1 at hn
    subst n
    apply Units.ext
    change letter 1 * C (baseMatrix (m, 1)) = C (baseMatrix (1, m)) * letter 1
    have hP : swapMatrix * baseMatrix (m, 1) = baseMatrix (1, m) * swapMatrix := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [swapMatrix, baseMatrix, Matrix.mul_diagonal, Matrix.diagonal_mul]
    have hL : leading 1 * baseMatrix (m, 1) = baseMatrix (1, m) * leading 1 := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [leading, row, column, baseMatrix, mul_diagonal, diagonal_mul]
    simp [letter, add_mul, mul_add, ← map_mul, C_mul_monomial, monomial_mul_C, hP, hL])

private abbrev Syllable := ℤˣ × Base

private def allowed (a b : Syllable) : Prop :=
  a.2 ∈ toSubgroup axis₁ axis₂ a.1 → a.1 = b.1

private def topMatrix (a : Syllable) : Mat := leading a.1 * baseMatrix a.2

private def pairing (a : Syllable) (v : Vec) : ℚ := row a.1 ⬝ᵥ (baseMatrix a.2 *ᵥ v)

private theorem topMatrix_apply (a : Syllable) (v : Vec) :
    topMatrix a *ᵥ v = pairing a v • column a.1 := by
  rw [topMatrix, ← mulVec_mulVec, leading, vecMulVec_mulVec]
  ext i
  exact mul_comm _ _

-- For opposite stable letters the pairing vanishes exactly at a pinch. For equal
-- signs only the middle coordinate contributes, so the pairing is always nonzero.
private theorem pairing_ne_zero (a b : Syllable) (h : allowed a b) :
    pairing a (column b.1) ≠ 0 := by
  obtain ⟨u, g⟩ := a
  obtain ⟨v, k⟩ := b
  rcases Int.units_eq_one_or u with rfl | rfl <;>
    rcases Int.units_eq_one_or v with rfl | rfl <;>
    norm_num [pairing, row, column, baseMatrix, mulVec_diagonal, dotProduct,
      Fin.sum_univ_three] <;>
    intro heq
  · have hg : g.2 ≠ 1 := by simpa [allowed, Subgroup.mem_prod] using h
    apply hg
    change g.2.toAdd = 0
    apply (zpow_eq_one_iff_right₀ (by norm_num : (0 : ℚ) ≤ 2) (by norm_num)).mp
    linarith
  · have hg : g.1 ≠ 1 := by simpa [allowed, Subgroup.mem_prod] using h
    apply hg
    change g.1.toAdd = 0
    apply (zpow_eq_one_iff_right₀ (by norm_num : (0 : ℚ) ≤ 2) (by norm_num)).mp
    linarith

private def middle : Vec := ![0, 1, 0]

private theorem pairing_middle (a : Syllable) : pairing a middle ≠ 0 := by
  obtain ⟨u, g⟩ := a
  rcases Int.units_eq_one_or u with rfl | rfl <;>
    norm_num [pairing, middle, row, baseMatrix, mulVec_diagonal, dotProduct, Fin.sum_univ_three]

private theorem top_product (a : Syllable) (l : List Syllable)
    (h : (a :: l).IsChain allowed) :
    ∃ q : ℚ, q ≠ 0 ∧ ((a :: l).map topMatrix).prod *ᵥ middle = q • column a.1 := by
  induction l generalizing a with
  | nil => exact ⟨_, pairing_middle a, by simp [topMatrix_apply]⟩
  | cons b l ih =>
    obtain ⟨q, hq, heq⟩ := ih b (List.isChain_cons.mp h).2
    have hab : allowed a b := (List.isChain_cons.mp h).1 b rfl
    refine ⟨_, mul_ne_zero hq (pairing_ne_zero a b hab), ?_⟩
    rw [List.map_cons, List.prod_cons, ← mulVec_mulVec, heq, mulVec_smul,
      topMatrix_apply, smul_smul]

private def syllablePoly (a : Syllable) : Polynomial Mat := letter a.1 * C (baseMatrix a.2)

private theorem syllable_expansion (a : Syllable) :
    syllablePoly a = C (swapMatrix * baseMatrix a.2) + monomial 1 (topMatrix a) := by
  simp [syllablePoly, letter, add_mul, ← map_mul, monomial_mul_C, topMatrix]

private theorem top_coefficient (l : List Syllable) :
    ((l.map syllablePoly).prod).coeff l.length = (l.map topMatrix).prod := by
  have hd : ∀ p ∈ l.map syllablePoly, natDegree p ≤ 1 := by
    rintro _ hp
    obtain ⟨a, _, rfl⟩ := List.mem_map.mp hp
    rw [syllable_expansion]
    exact natDegree_add_le_of_degree_le (by rw [natDegree_C]; decide)
      (natDegree_monomial_le _)
  simpa [List.map_map, Function.comp_def, syllable_expansion] using
    coeff_list_prod_of_natDegree_le (l.map syllablePoly) 1 hd

private theorem baseMatrix_eq_one {g : Base} (h : baseMatrix g = 1) : g = 1 := by
  have hd (n : ℤ) : (2 : ℚ) ^ n = 1 → n = 0 :=
    (zpow_eq_one_iff_right₀ (by norm_num) (by norm_num)).mp
  apply Prod.ext
  · apply hd
    exact congrArg (fun m : Mat ↦ m 2 2) h
  · apply hd
    exact congrArg (fun m : Mat ↦ m 0 0) h

private theorem word_constant (w : NormalWord.ReducedWord Base axis₁ axis₂)
    (h : representation (w.prod swapAxes) = 1) :
    (w.toList.map syllablePoly).prod = C (baseMatrix w.head⁻¹) := by
  let eval := (Units.coeHom _).comp representation
  have hs (a : Syllable) :
      eval ((t : Extension) ^ (a.1 : ℤ) * HNNExtension.of a.2) = syllablePoly a := by
    simp only [eval, MonoidHom.comp_apply, map_mul, map_zpow, representation, lift_of,
      lift_t, Units.coeHom_apply, stableMatrix_pow]
    rfl
  have hh : eval (w.prod swapAxes) = 1 := by simp [eval, h]
  rw [NormalWord.ReducedWord.prod, map_mul, map_list_prod, List.map_map] at hh
  simp only [Function.comp_def, hs] at hh
  have hbase : eval (HNNExtension.of w.head) = (polyBase w.head : Polynomial Mat) := by
    simp [eval, representation]
  rw [hbase] at hh
  have heq := (polyBase w.head).eq_inv_of_mul_eq_one_left hh
  rwa [← map_inv] at heq

private theorem representation_injective : Function.Injective representation := by
  apply (injective_iff_map_eq_one _).mpr
  intro x hx
  obtain ⟨d⟩ := NormalWord.TransversalPair.nonempty Base axis₁ axis₂
  let w := NormalWord.equiv swapAxes d x
  have hw : w.prod swapAxes = x := (NormalWord.equiv swapAxes d).symm_apply_apply x
  have hc := word_constant w.toReducedWord (hw ▸ hx)
  cases hl : w.toList with
  | nil =>
    rw [hl] at hc
    have hb : baseMatrix w.head⁻¹ = 1 := C_injective (by simpa using hc.symm)
    have hh : w.head = 1 := inv_eq_one.mp (baseMatrix_eq_one hb)
    rw [← hw, NormalWord.ReducedWord.prod, hl, hh]
    simp
  | cons a l =>
    have hchain : (a :: l).IsChain allowed := hl ▸ w.chain
    obtain ⟨q, hq, hact⟩ := top_product a l hchain
    rw [hl] at hc
    have hz := congrArg (fun p : Polynomial Mat ↦ p.coeff (a :: l).length) hc
    change ((List.map syllablePoly (a :: l)).prod).coeff (a :: l).length = _ at hz
    rw [top_coefficient] at hz
    simp only [List.length_cons, coeff_C_succ] at hz
    rw [hz, zero_mulVec] at hact
    have hi := congrFun hact (1 : Fin 3)
    have hm : column a.1 1 = 1 := by rcases Int.units_eq_one_or a.1 with h | h <;> simp [column, h]
    exact (hq (by simpa [hm] using hi.symm)).elim

end

/--
**The one-relator group of Kourovka Problem 18.86 is linear.** Let $G$ be the group with generators
$a, b$ and the single defining relation $[[a, b], b] = 1$, where $[x, y] = x^{-1} y^{-1} x y$. Then
$G$ is linear: there are a field $K$, a natural number $n$ and an injective group homomorphism
$G \to \mathrm{GL}_n(K)$.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory:
The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem
18.86 (V. A. Roman'kov); resolution: V. G. Bardakov and O. V. Bryukhanov, Vestnik Novosibirsk Univ.
Ser. Mat. Mekh. Inf. 7 (2007), no. 3, 45-58 (Russian); V. A. Roman'kov, J. Siberian Federal Univ.
Math. Phys. 6 (2013), no. 4, 516-520, Kourovka Archive, Problem 18.86: Yes, it is linear, since it
embeds in Hol F_2 (adding c = [a, b] gives G = ⟨a, b, c | a^b = ac, c^b = c⟩), and Hol F_2 is linear
by Corollary 3 of Bardakov-Bryukhanov; another proof by Roman'kov,
https://arxiv.org/abs/1401.0300v49.
-/
theorem oneRelatorGroupIsLinear_holds : oneRelatorGroupIsLinear := by
  let embed : Polynomial Mat →+* Matrix (Fin 3) (Fin 3) (RatFunc ℚ) :=
    (algebraMap (Polynomial ℚ) (RatFunc ℚ)).mapMatrix.comp matPolyEquiv.symm.toRingHom
  have hi : Function.Injective embed :=
    (Matrix.map_injective (RatFunc.algebraMap_injective ℚ)).comp matPolyEquiv.symm.injective
  exact ⟨RatFunc ℚ, inferInstance, 3,
    (Units.map embed.toMonoidHom).comp (representation.comp toExtension),
    (Units.map_injective hi).comp (representation_injective.comp toExtension_injective)⟩

end MathlibExt.GroupTheory.UnitriangularOneRelatorLinearKourovka18Problem86Wanted
