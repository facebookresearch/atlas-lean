namespace MathlibExt.GroupTheory.SchurWeylWanted
namespace RepresentationTheory

open scoped TensorProduct

/-- **Permutation action of the symmetric group on tensor powers.** Let $R$ be a commutative
semiring, $M$ an $R$-module and $k$ a natural number. The symmetric group $S_k$ of permutations of
$\{1, \dots, k\}$ acts on the $k$-th tensor power $M^{\otimes k}$ by permuting tensor factors: this
is the monoid homomorphism from $S_k$ to the $R$-linear endomorphisms of $M^{\otimes k}$ that sends
$\sigma$ to the map $v_1 \otimes \cdots \otimes v_k \mapsto
v_{\sigma^{-1}(1)} \otimes \cdots \otimes v_{\sigma^{-1}(k)}$. -/
def symAction (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M] (k : ℕ) :
    Equiv.Perm (Fin k) →* Module.End R (⨂[R]^k M) where
  toFun σ := (PiTensorProduct.reindex R (fun _ : Fin k => M) σ).toLinearMap
  map_one' := by
    ext x
    simp only [LinearEquiv.coe_coe, LinearMap.coe_compMultilinearMap, Function.comp_apply,
      PiTensorProduct.reindex_tprod, Module.End.one_apply]
    rfl
  map_mul' σ τ := by
    ext x
    simp only [Module.End.mul_apply, LinearEquiv.coe_coe, LinearMap.coe_compMultilinearMap,
      Function.comp_apply, PiTensorProduct.reindex_tprod]
    rfl

/-- **Diagonal action of the general linear group on tensor powers.** Let $R$ be a commutative
semiring, $M$ an $R$-module and $k$ a natural number. Write $\mathrm{GL}(M)$ for the group of
invertible $R$-linear endomorphisms of $M$. The diagonal action of $\mathrm{GL}(M)$ on the $k$-th
tensor power $M^{\otimes k}$ is the monoid homomorphism from $\mathrm{GL}(M)$ to the
$R$-linear endomorphisms of $M^{\otimes k}$ that sends $g$ to $g^{\otimes k}$, so that
$g \cdot (v_1 \otimes \cdots \otimes v_k) = g v_1 \otimes \cdots \otimes g v_k$. -/
def glAction (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M] (k : ℕ) :
    (M →ₗ[R] M)ˣ →* Module.End R (⨂[R]^k M) where
  toFun g := PiTensorProduct.map (fun _ : Fin k => (g : M →ₗ[R] M))
  map_one' := by ext x; simp
  map_mul' g h := by ext x; simp

/-! ### Commutation of the two actions and expansion of tensor powers -/

section Commute

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] {k : ℕ}

/-- Permuting the tensor factors intertwines `⊗_i f_i` with `⊗_i f_{σ⁻¹ i}`. -/
private lemma symAction_mul_map (σ : Equiv.Perm (Fin k)) (f : Fin k → Module.End R M) :
    symAction R M k σ * PiTensorProduct.map f =
      PiTensorProduct.map (fun i => f (σ.symm i)) * symAction R M k σ :=
  (PiTensorProduct.map_comp_reindex_eq f σ).symm

/-- Conjugating `⊗_i f_i` by a permutation of the factors permutes the `f_i`. -/
private lemma symAction_mul_map_mul_inv (σ : Equiv.Perm (Fin k)) (f : Fin k → Module.End R M) :
    symAction R M k σ * PiTensorProduct.map f * symAction R M k σ⁻¹ =
      PiTensorProduct.map (fun i => f (σ.symm i)) := by
  rw [symAction_mul_map, mul_assoc, ← map_mul, mul_inv_cancel, map_one, mul_one]

/-- The images of the two actions commute. -/
private lemma symAction_mul_glAction (σ : Equiv.Perm (Fin k)) (g : (M →ₗ[R] M)ˣ) :
    symAction R M k σ * glAction R M k g = glAction R M k g * symAction R M k σ :=
  symAction_mul_map σ (fun _ => (g : M →ₗ[R] M))

/-- The easy inclusion of Schur–Weyl duality. -/
private lemma adjoin_glAction_le_centralizer :
    Algebra.adjoin R (Set.range (glAction R M k)) ≤
      Subalgebra.centralizer R (Set.range (symAction R M k)) := by
  rw [Algebra.adjoin_le_iff]
  rintro _ ⟨g, rfl⟩
  rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
  rintro _ ⟨σ, rfl⟩
  exact symAction_mul_glAction σ g

/-- Multilinear expansion of `(A + s • B)^{⊗k}` as a polynomial in `s`. -/
private lemma map_const_add_smul (A B : Module.End R M) (s : R) :
    PiTensorProduct.map (fun _ : Fin k => A + s • B) =
      ∑ T : Finset (Fin k),
        s ^ T.card • PiTensorProduct.map (T.piecewise (fun _ => B) (fun _ => A)) := by
  have h1 := (PiTensorProduct.mapMultilinear R (fun _ : Fin k => M)
    (fun _ : Fin k => M)).map_add_univ (fun _ => s • B) (fun _ => A)
  simp only [PiTensorProduct.mapMultilinear_apply] at h1
  rw [show (fun _ : Fin k => A + s • B) = (fun _ => s • B) + (fun _ => A) from
    funext fun _ => add_comm _ _, h1]
  refine Finset.sum_congr rfl fun T _ => ?_
  have h2 := (PiTensorProduct.mapMultilinear R (fun _ : Fin k => M)
    (fun _ : Fin k => M)).map_piecewise_smul (fun _ => s) (T.piecewise (fun _ => B) (fun _ => A)) T
  simp only [PiTensorProduct.mapMultilinear_apply, Finset.prod_const, RingHom.id_apply] at h2
  rw [← h2]
  congr 1
  funext i
  by_cases hi : i ∈ T <;> simp [Finset.piecewise, hi]

end Commute

/-! ### Polarisation -/

/-- **Polarisation.** The symmetrisation of a multilinear map in `k` variables is a signed sum of
its values on constant families: `∑_σ μ (f ∘ σ) = ∑_U (-1)^{|U|} μ (∑_{i ∉ U} f i, …)`. -/
private lemma sum_perm_eq_sum_compl {R E F : Type*} [CommSemiring R] [AddCommGroup E]
    [Module R E] [AddCommGroup F] [Module R F] {k : ℕ}
    (μ : MultilinearMap (RingHom.id R) (fun _ : Fin k => E) F) (f : Fin k → E) :
    ∑ σ : Equiv.Perm (Fin k), μ (fun i => f (σ i)) =
      ∑ U : Finset (Fin k), (-1 : ℤ) ^ U.card • μ (fun _ => ∑ i ∈ Uᶜ, f i) := by
  have hR : ∑ U : Finset (Fin k), (-1 : ℤ) ^ U.card • μ (fun _ => ∑ i ∈ Uᶜ, f i) =
      ∑ r : Fin k → Fin k, if Function.Surjective r then μ (fun i => f (r i)) else 0 := by
    simp_rw [μ.map_sum_finset (fun _ j => f j) (fun _ => _ᶜ), Finset.smul_sum]
    rw [Finset.sum_comm' (t' := Finset.univ)
      (s' := fun r => (Finset.univ.image r)ᶜ.powerset)]
    · refine Finset.sum_congr rfl fun r _ => ?_
      rw [← Finset.sum_smul, Finset.sum_powerset_neg_one_pow_card]
      by_cases hr : Function.Surjective r
      · have : (Finset.univ.image r)ᶜ = ∅ := by
          rw [Finset.compl_eq_empty_iff, Finset.image_univ_of_surjective hr]
        simp [this, hr]
      · have : (Finset.univ.image r)ᶜ ≠ ∅ := by
          rw [Ne, Finset.compl_eq_empty_iff]
          intro h
          apply hr
          intro y
          have := h ▸ Finset.mem_univ y
          simpa using this
        simp [this, hr]
    · intro U r
      simp only [Finset.mem_univ, true_and, and_true, Fintype.mem_piFinset, Finset.mem_compl,
        Finset.mem_powerset, Finset.subset_iff, Finset.mem_image, not_exists]
      constructor
      · intro h i hi j hj
        exact h j (hj ▸ hi)
      · intro h j hj
        exact h hj j rfl
  rw [hR, ← Finset.sum_filter]
  symm
  refine Finset.sum_bij (fun r hr => Equiv.ofBijective r
      ⟨Finite.injective_iff_surjective.mpr (Finset.mem_filter.mp hr).2,
        (Finset.mem_filter.mp hr).2⟩)
    (fun _ _ => Finset.mem_univ _) (fun r₁ _ r₂ _ h => ?_) (fun σ _ => ?_) (fun _ _ => rfl)
  · exact congrArg (fun e : Equiv.Perm (Fin k) => (e : Fin k → Fin k)) h
  · exact ⟨σ, Finset.mem_filter.mpr ⟨Finset.mem_univ _, σ.surjective⟩, by ext; simp⟩

/-! ### Interpolation and the closure argument over a field -/

section Field

variable {R : Type*} [Field R] {k : ℕ}

/-- If `k!` is invertible in a field, the numbers `0, 1, …, k` are distinct in it. -/
private lemma natCast_injective_of_invertible [Invertible (k.factorial : R)] :
    Function.Injective (fun i : Fin (k + 1) => ((i : ℕ) : R)) := by
  have hk : (k.factorial : R) ≠ 0 := Invertible.ne_zero _
  have key : ∀ a b : ℕ, a < b → b ≤ k → (a : R) ≠ (b : R) := by
    intro a b hab hbk h
    apply hk
    obtain ⟨c, hc⟩ := Nat.dvd_factorial (Nat.sub_pos_of_lt hab) (le_trans (Nat.sub_le _ _) hbk)
    rw [hc, Nat.cast_mul, Nat.cast_sub hab.le, h, sub_self, zero_mul]
  intro i j hij
  simp only at hij
  rcases lt_trichotomy (i : ℕ) j with h | h | h
  · exact absurd hij (key _ _ h (Nat.lt_succ_iff.mp j.2))
  · exact Fin.ext h
  · exact absurd hij.symm (key _ _ h (Nat.lt_succ_iff.mp i.2))

/-- **Interpolation.** If `∑_T s^{|T|} • c T` lies in a subspace `W` for every scalar `s`, where
`T` ranges over the subsets of a set with `k` elements and `k!` is invertible, then the top
coefficient `c univ` lies in `W`. -/
private lemma top_coeff_mem [Invertible (k.factorial : R)] {E : Type*} [AddCommGroup E]
    [Module R E] (W : Submodule R E) (c : Finset (Fin k) → E)
    (h : ∀ s : R, ∑ T : Finset (Fin k), s ^ T.card • c T ∈ W) :
    c Finset.univ ∈ W := by
  rw [← Subspace.forall_mem_dualAnnihilator_apply_eq_zero_iff]
  intro φ hφ
  rw [Submodule.mem_dualAnnihilator] at hφ
  set p : Polynomial R :=
    ∑ T : Finset (Fin k), Polynomial.C (φ (c T)) * Polynomial.X ^ T.card with hp_def
  have hp : p = 0 := by
    apply Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero p
      (natCast_injective_of_invertible (R := R) (k := k))
    · intro i
      have := hφ _ (h ((i : ℕ) : R))
      simp only [map_sum, map_smul, smul_eq_mul] at this
      simp only [hp_def, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X]
      rw [← this]
      exact Finset.sum_congr rfl fun T _ => mul_comm _ _
    · rw [Fintype.card_fin]
      refine Nat.lt_succ_of_le (Polynomial.natDegree_sum_le_of_forall_le _ _ fun T _ => ?_)
      refine (Polynomial.natDegree_C_mul_X_pow_le _ _).trans ?_
      simpa using T.card_le_univ
  have := congrArg (Polynomial.lcoeff R k) hp
  simp only [hp_def, Polynomial.lcoeff_apply, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow, map_zero] at this
  rw [Finset.sum_eq_single Finset.univ] at this
  · simpa using this
  · intro T _ hT
    have hTk : k ≠ T.card := fun hkT =>
      hT ((Finset.card_eq_iff_eq_univ T).mp (by simpa using hkT.symm))
    simp [hTk]
  · simp

/-- **Closure argument.** Let `P` be a property of endomorphisms of a finite-dimensional vector
space that holds for invertible maps, is preserved by composition, and holds for `B` whenever it
holds for `A + s • B` for every scalar `s`. Then `P` holds for every endomorphism. -/
private lemma forall_of_isUnit_of_mul_of_line {V : Type*} [AddCommGroup V] [Module R V]
    [FiniteDimensional R V] (P : Module.End R V → Prop)
    (h_unit : ∀ g, IsUnit g → P g)
    (h_mul : ∀ X Y, P X → P Y → P (X * Y))
    (h_line : ∀ A B, (∀ s : R, P (A + s • B)) → P B) (X : Module.End R V) : P X := by
  have h_smul : ∀ (s : R) (Z : Module.End R V), s ≠ 0 → P Z → P (s • Z) := by
    intro s Z hs hZ
    have hu : IsUnit (algebraMap R (Module.End R V) s) := (isUnit_iff_ne_zero.mpr hs).map _
    rw [Algebra.algebraMap_eq_smul_one] at hu
    rw [show s • Z = (s • (1 : Module.End R V)) * Z by rw [smul_mul_assoc, one_mul]]
    exact h_mul _ _ (h_unit _ hu) hZ
  -- Nilpotent maps: `1 + s • N` is invertible for every `s`.
  have h_nil : ∀ N : Module.End R V, IsNilpotent N → P N := fun N hN =>
    h_line 1 N fun s => h_unit _ (hN.smul s).isUnit_one_add
  -- If `P A` and `P (B + t • A)` for every `t ≠ 0`, then `P B`.
  have h_trick : ∀ A B : Module.End R V, P A → (∀ t : R, t ≠ 0 → P (B + t • A)) → P B := by
    intro A B hA hB
    refine h_line A B fun s => ?_
    by_cases hs : s = 0
    · simpa [hs] using hA
    · have : A + s • B = s • (B + s⁻¹ • A) := by
        rw [smul_add, smul_smul, mul_inv_cancel₀ hs, one_smul, add_comm]
      rw [this]
      exact h_smul s _ hs (hB _ (inv_ne_zero hs))
  -- Rank-one maps `u ↦ φ u • w`: square-zero ones are nilpotent, the others are products of two
  -- square-zero ones or, in dimension one, invertible.
  have h_sq : ∀ (φ : Module.Dual R V) (w : V), φ w = 0 → P (φ.smulRight w) := by
    intro φ w hw
    refine h_nil _ ⟨2, ?_⟩
    ext u
    simp [pow_two, hw]
  have h_rank_one : ∀ (φ : Module.Dual R V) (w : V), P (φ.smulRight w) := by
    intro φ w
    by_cases hw : φ w = 0
    · exact h_sq φ w hw
    by_cases hker : ∃ w', w' ≠ 0 ∧ φ w' = 0
    · obtain ⟨w', hw'0, hw'⟩ := hker
      obtain ⟨ψ₀, hψ₀⟩ := Module.Projective.exists_dual_ne_zero R hw'0
      set ψ : Module.Dual R V := (ψ₀ w')⁻¹ • ψ₀ - ((ψ₀ w')⁻¹ * ψ₀ w / φ w) • φ with hψ
      have hψw : ψ w = 0 := by
        simp only [hψ, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]
        field_simp
        ring
      have hψw' : ψ w' = 1 := by
        simp [hψ, hw', hψ₀]
      have : φ.smulRight w = ψ.smulRight w * φ.smulRight w' := by
        ext u
        simp [hψw']
      rw [this]
      exact h_mul _ _ (h_sq ψ w hψw) (h_sq φ w' hw')
    · simp only [ne_eq, not_exists, not_and] at hker
      apply h_unit
      rw [LinearMap.isUnit_iff_ker_eq_bot, LinearMap.ker_eq_bot']
      intro u hu
      have hw0 : w ≠ 0 := by
        rintro rfl
        simp at hw
      have hφu : φ u = 0 := by
        rcases smul_eq_zero.mp hu with h | h
        · exact h
        · exact absurd h hw0
      by_contra hu0
      exact hker u hu0 hφu
  -- Induction on the dimension of the kernel, adding a rank-one map that kills a kernel vector.
  have main : ∀ n, ∀ X : Module.End R V, Module.finrank R (LinearMap.ker X) = n → P X := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro X hn
      by_cases hX : LinearMap.ker X = ⊥
      · exact h_unit _ ((LinearMap.isUnit_iff_ker_eq_bot X).mpr hX)
      obtain ⟨v, hvker, hv0⟩ := (Submodule.ne_bot_iff _).mp hX
      obtain ⟨w, hw⟩ : ∃ w, w ∉ LinearMap.range X := by
        by_contra! hc
        exact hX (LinearMap.ker_eq_bot.mpr
          (LinearMap.injective_iff_surjective.mpr fun y => hc y))
      obtain ⟨φ₀, hφ₀⟩ := Module.Projective.exists_dual_ne_zero R hv0
      set φ : Module.Dual R V := (φ₀ v)⁻¹ • φ₀ with hφ
      have hφv : φ v = 1 := by simp [hφ, hφ₀]
      refine h_trick (φ.smulRight w) X (h_rank_one φ w) fun t ht => ?_
      refine ih _ ?_ _ rfl
      rw [← hn]
      have hle : LinearMap.ker (X + t • φ.smulRight w) ≤ LinearMap.ker X ⊓ LinearMap.ker φ := by
        intro u hu
        simp only [LinearMap.mem_ker, LinearMap.add_apply, LinearMap.smul_apply,
          LinearMap.smulRight_apply] at hu
        have hφu : φ u = 0 := by
          by_contra hne
          apply hw
          refine ⟨(-(t * φ u))⁻¹ • u, ?_⟩
          have hXu : X u = (-(t * φ u)) • w := by
            rw [neg_smul, mul_smul]
            exact eq_neg_of_add_eq_zero_left hu
          rw [map_smul, hXu, smul_smul,
            inv_mul_cancel₀ (neg_ne_zero.mpr (mul_ne_zero ht hne)), one_smul]
        refine ⟨?_, hφu⟩
        simpa [hφu] using hu
      have hlt : LinearMap.ker X ⊓ LinearMap.ker φ < LinearMap.ker X := by
        refine lt_of_le_of_ne inf_le_left fun heq => ?_
        have h1 : v ∈ LinearMap.ker X ⊓ LinearMap.ker φ := by rw [heq]; exact hvker
        have h2 := h1.2
        simp [LinearMap.mem_ker, hφv] at h2
      exact lt_of_le_of_lt (Submodule.finrank_mono hle) (Submodule.finrank_lt_finrank_of_lt hlt)
  exact main _ X rfl

end Field

/-! ### The reverse inclusion -/

section Main

variable {R : Type*} [Field R] {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
  {k : ℕ} [Invertible (k.factorial : R)]

/-- Every tensor power `X^{⊗k}` of an endomorphism lies in the subalgebra generated by the
diagonal action of `GL(M)`. -/
private lemma map_const_mem_adjoin (X : Module.End R M) :
    PiTensorProduct.map (fun _ : Fin k => X) ∈ Algebra.adjoin R (Set.range (glAction R M k)) := by
  refine forall_of_isUnit_of_mul_of_line (fun X : Module.End R M =>
    PiTensorProduct.map (fun _ : Fin k => X) ∈ Algebra.adjoin R (Set.range (glAction R M k)))
    ?_ ?_ ?_ X
  · rintro _ ⟨u, rfl⟩
    exact Algebra.subset_adjoin ⟨u, rfl⟩
  · intro X Y hX hY
    have e : PiTensorProduct.map (fun _ : Fin k => X * Y) =
        PiTensorProduct.map (fun _ : Fin k => X) * PiTensorProduct.map (fun _ : Fin k => Y) :=
      PiTensorProduct.map_mul _ _
    simp only [e]
    exact Subalgebra.mul_mem _ hX hY
  · intro A B h
    have := top_coeff_mem (Subalgebra.toSubmodule (Algebra.adjoin R (Set.range (glAction R M k))))
      (fun T : Finset (Fin k) => PiTensorProduct.map (T.piecewise (fun _ => B) (fun _ => A)))
      (fun s => by rw [← map_const_add_smul]; exact h s)
    simpa using this

/-- Every symmetrisation `∑_σ ⊗_i f_{σ i}` lies in the subalgebra generated by the diagonal
action of `GL(M)`. -/
private lemma sum_perm_map_mem_adjoin (f : Fin k → Module.End R M) :
    ∑ σ : Equiv.Perm (Fin k), PiTensorProduct.map (fun i => f (σ i)) ∈
      Algebra.adjoin R (Set.range (glAction R M k)) := by
  have := sum_perm_eq_sum_compl
    (PiTensorProduct.mapMultilinear R (fun _ : Fin k => M) (fun _ : Fin k => M)) f
  simp only [PiTensorProduct.mapMultilinear_apply] at this
  rw [this]
  exact Subalgebra.sum_mem _ fun U _ => zsmul_mem (map_const_mem_adjoin _) _

omit [FiniteDimensional R M] [Invertible (k.factorial : R)] in
/-- Expansion of an endomorphism of `M^{⊗k}` in the matrix units `⊗_l E_{p_l q_l}` built from a
basis of `M`. -/
private lemma eq_sum_smul_map {ι : Type*} [Fintype ι] (b : Module.Basis ι R M)
    (T : Module.End R (⨂[R]^k M)) :
    T = ∑ p : Fin k → ι, ∑ q : Fin k → ι,
      (Basis.piTensorProduct (fun _ : Fin k => b)).repr
          (T (Basis.piTensorProduct (fun _ : Fin k => b) q)) p •
        PiTensorProduct.map (fun l => (b.coord (q l)).smulRight (b (p l))) := by
  classical
  set 𝓑 := Basis.piTensorProduct (fun _ : Fin k => b) with h𝓑
  refine 𝓑.ext fun m => ?_
  have hE : ∀ p q : Fin k → ι,
      PiTensorProduct.map (fun l => (b.coord (q l)).smulRight (b (p l))) (𝓑 m) =
        if q = m then 𝓑 p else 0 := by
    intro p q
    simp only [h𝓑, Basis.piTensorProduct_apply, PiTensorProduct.map_tprod,
      LinearMap.smulRight_apply, Module.Basis.coord_apply, Module.Basis.repr_self]
    split_ifs with h
    · subst h
      simp
    · obtain ⟨l, hl⟩ := Function.ne_iff.mp h
      exact MultilinearMap.map_coord_zero _ l (by simp [Ne.symm hl])
  simp only [LinearMap.sum_apply, LinearMap.smul_apply, hE, smul_ite,
    smul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  exact (𝓑.sum_repr _).symm

/-- Averaging `⊗_i g_i` over conjugation by `S_k` lands in the subalgebra generated by the
diagonal action of `GL(M)`. -/
private lemma sum_conj_map_mem_adjoin (g : Fin k → Module.End R M) :
    ∑ σ : Equiv.Perm (Fin k), symAction R M k σ * PiTensorProduct.map g * symAction R M k σ⁻¹ ∈
      Algebra.adjoin R (Set.range (glAction R M k)) := by
  simp only [symAction_mul_map_mul_inv]
  rw [← Equiv.sum_comp (Equiv.inv (Equiv.Perm (Fin k)))]
  simp only [Equiv.inv_apply, Equiv.Perm.inv_def, Equiv.symm_symm]
  exact sum_perm_map_mem_adjoin _

/-- Averaging a linear combination of maps `⊗_i g_i` over conjugation by `S_k` lands in the
subalgebra generated by the diagonal action of `GL(M)`. -/
private lemma sum_conj_sum_mem_adjoin {α β : Type*} [Fintype α] [Fintype β] (c : α → β → R)
    (f : α → β → Fin k → Module.End R M) :
    ∑ σ : Equiv.Perm (Fin k), symAction R M k σ *
        (∑ p, ∑ q, c p q • PiTensorProduct.map (f p q)) * symAction R M k σ⁻¹ ∈
      Algebra.adjoin R (Set.range (glAction R M k)) := by
  let L : Module.End R (⨂[R]^k M) →ₗ[R] Module.End R (⨂[R]^k M) :=
    ∑ σ : Equiv.Perm (Fin k),
      LinearMap.mulRight R (symAction R M k σ⁻¹) ∘ₗ LinearMap.mulLeft R (symAction R M k σ)
  have hL : ∀ X, L X = ∑ σ : Equiv.Perm (Fin k), symAction R M k σ * X * symAction R M k σ⁻¹ := by
    intro X
    simp only [L, LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply]
  rw [← hL, map_sum]
  refine Subalgebra.sum_mem _ fun p _ => ?_
  rw [map_sum]
  refine Subalgebra.sum_mem _ fun q _ => ?_
  rw [map_smul, hL]
  exact Subalgebra.smul_mem _ (sum_conj_map_mem_adjoin _) _

/-- Averaging any endomorphism of `M^{⊗k}` over conjugation by `S_k` lands in the subalgebra
generated by the diagonal action of `GL(M)`. -/
private lemma sum_conj_mem_adjoin (T : Module.End R (⨂[R]^k M)) :
    ∑ σ : Equiv.Perm (Fin k), symAction R M k σ * T * symAction R M k σ⁻¹ ∈
      Algebra.adjoin R (Set.range (glAction R M k)) := by
  rw [eq_sum_smul_map (Module.finBasis R M) T]
  exact sum_conj_sum_mem_adjoin _ _

end Main

/-- **Schur–Weyl duality: the general linear side.** Let $R$ be a field, $M$ a finite-dimensional
vector space over $R$, and $k$ a natural number such that $k!$ is invertible in $R$. In the
algebra of $R$-linear endomorphisms of the tensor power $M^{\otimes k}$, the subalgebra generated
by the image of the diagonal action $g \mapsto g^{\otimes k}$ of $\mathrm{GL}(M)$ equals the
centralizer of the image of the action of the symmetric group $S_k$ by permuting tensor factors.

Source: H. Weyl, The Classical Groups, 1939; I. Schur, Über die rationalen Darstellungen der
allgemeinen linearen Gruppe, 1927. Via leanprover/lean-eval@38361be, problem
`glAction_range_eq_centralizer_symAction`. -/
theorem glAction_range_eq_centralizer_symAction
    {R : Type*} [Field R]
    {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
    {k : ℕ} [Invertible (k.factorial : R)] :
    Algebra.adjoin R (Set.range (glAction R M k)) =
      Subalgebra.centralizer R (Set.range (symAction R M k)) := by
  refine le_antisymm adjoin_glAction_le_centralizer fun T hT => ?_
  rw [Subalgebra.mem_centralizer_iff] at hT
  have hconj : ∀ σ : Equiv.Perm (Fin k),
      symAction R M k σ * T * symAction R M k σ⁻¹ = T := by
    intro σ
    rw [hT _ ⟨σ, rfl⟩, mul_assoc, ← map_mul, mul_inv_cancel, map_one, mul_one]
  have hsum : ∑ σ : Equiv.Perm (Fin k), symAction R M k σ * T * symAction R M k σ⁻¹ =
      (k.factorial : R) • T := by
    simp only [hconj, Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin]
    rw [Nat.cast_smul_eq_nsmul]
  have hT' : T = ⅟(k.factorial : R) •
      ∑ σ : Equiv.Perm (Fin k), symAction R M k σ * T * symAction R M k σ⁻¹ := by
    rw [hsum, smul_smul, invOf_mul_self, one_smul]
  rw [hT']
  exact Subalgebra.smul_mem _ (sum_conj_mem_adjoin T) _

/-! ### The symmetric group side -/

/-- In nonmodular characteristic, the algebra generated by a finite group representation
on a finite-dimensional vector space equals its double centralizer. -/
private theorem adjoin_range_eq_double_centralizer {R G V ι : Type*} [Field R] [Group G]
    [Finite G] [NeZero (Nat.card G : R)] [AddCommGroup V] [Module R V] [Finite ι]
    (b : Module.Basis ι R V) (ρ : Representation R G V) :
    Algebra.adjoin R (Set.range ρ) = Subalgebra.centralizer R
      (Subalgebra.centralizer R (Set.range ρ) : Set (Module.End R V)) := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  refine le_antisymm (Algebra.adjoin_le_centralizer_centralizer R _) fun T hT => ?_
  rw [Subalgebra.mem_centralizer_iff] at hT
  let E := Module.End R V
  let A := Algebra.adjoin R (Set.range ρ)
  -- Left composition acts on the space of endomorphisms, preserving the generated algebra.
  let τ : Representation R G E := (Algebra.lsmul R R E).toMonoidHom.comp ρ
  let W : Subrepresentation τ :=
    { toSubmodule := A.toSubmodule
      apply_mem_toSubmodule := fun g f hf => A.mul_mem (Algebra.subset_adjoin ⟨g, rfl⟩) hf }
  obtain ⟨p, hp⟩ := MonoidAlgebra.exists_leftInverse_of_injective (k := R) (G := G)
    (V := W.asSubmodule) (W := τ.asModule) W.asSubmodule.subtype W.asSubmodule.ker_subtype
  let Q := W.asSubmodule.subtype.comp p
  let e := τ.asModuleEquiv
  let P : Module.End R E := e.toLinearMap ∘ₗ (Q.restrictScalars R) ∘ₗ e.symm.toLinearMap
  have hP (f : E) : P f ∈ A := (p (e.symm f)).property
  have hP₁ : P 1 = 1 := by
    let x : W.asSubmodule := ⟨e.symm 1, A.one_mem⟩
    have hx : p x.val = x := DFunLike.congr_fun hp x
    change e (Q x.val) = 1
    rw [show Q x.val = x.val from congrArg Subtype.val hx]
    exact e.apply_symm_apply 1
  have hPcomm (g : G) (f : E) : P (ρ g * f) = ρ g * P f := by
    change τ.asModuleEquiv (Q (τ.asModuleEquiv.symm (τ g f))) =
      τ g (τ.asModuleEquiv (Q (τ.asModuleEquiv.symm f)))
    rw [Representation.asModuleEquiv_symm_map_rho, map_smul,
      Representation.asModuleEquiv_map_smul, Representation.asAlgebraHom_of]
  let col (j : ι) : V →ₗ[R] E := LinearMap.smulRightₗ (b.coord j)
  have hcol (g : E) (j : ι) (v : V) : col j (g v) = g * col j v := by
    ext w
    change b.coord j w • g v = g (b.coord j w • v)
    exact (g.map_smul _ _).symm
  have hsum (f : E) : ∑ j, col j (f (b j)) = f := by
    ext w
    change (∑ j, (col j (f (b j)) : V →ₗ[R] V)) w = f w
    rw [LinearMap.sum_apply]
    change (∑ j, (b.repr w) j • f (b j)) = f w
    calc
      _ = f (∑ j, (b.repr w) j • b j) := by simp only [map_sum, map_smul]
      _ = f w := congrArg f (b.sum_repr w)
  -- Evaluating the projection of a single column gives an endomorphism commuting with `ρ`.
  have hcomm (j : ι) (v : V) : P (col j (T v)) = T * P (col j v) := by
    ext w
    let entry : E := LinearMap.applyₗ w ∘ₗ P ∘ₗ col j
    have hentry : entry ∈ Subalgebra.centralizer R (Set.range ρ) := by
      rw [Subalgebra.mem_centralizer_iff]
      rintro _ ⟨g, rfl⟩
      ext u
      change (ρ g) (P (col j u) w) = P (col j (ρ g u)) w
      rw [hcol, hPcomm, mul_apply_eq_comp]
    exact DFunLike.congr_fun (hT entry hentry) v
  have hPT : P T = T * P 1 := by
    calc
      P T = ∑ j, P (col j (T (b j))) := by rw [← map_sum, hsum]
      _ = ∑ j, T * P (col j (b j)) := Finset.sum_congr rfl fun j _ => hcomm j (b j)
      _ = T * P 1 := by
        rw [← Finset.mul_sum, ← map_sum]
        exact congrArg (fun f : E => T * P f) (hsum 1)
  simpa [hPT, hP₁] using hP T

/-- **Schur–Weyl duality: the symmetric group side.** Let $R$ be a field, $M$ a finite-dimensional
vector space over $R$, and $k$ a natural number such that $k!$ is invertible in $R$. In the
algebra of $R$-linear endomorphisms of the tensor power $M^{\otimes k}$, the subalgebra generated
by the image of the action of the symmetric group $S_k$ by permuting tensor factors equals the
centralizer of the image of the diagonal action $g \mapsto g^{\otimes k}$ of $\mathrm{GL}(M)$.

Source: H. Weyl, The Classical Groups, 1939; I. Schur, Über die rationalen Darstellungen der
allgemeinen linearen Gruppe, 1927. Via leanprover/lean-eval@38361be, problem
`symAction_range_eq_centralizer_glAction`. -/
theorem symAction_range_eq_centralizer_glAction
    {R : Type*} [Field R]
    {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
    {k : ℕ} [Invertible (k.factorial : R)] :
    Algebra.adjoin R (Set.range (symAction R M k)) =
      Subalgebra.centralizer R (Set.range (glAction R M k)) := by
  let : NeZero (Nat.card (Equiv.Perm (Fin k)) : R) :=
    ⟨by simpa only [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]
      using (Invertible.ne_zero (k.factorial : R))⟩
  rw [adjoin_range_eq_double_centralizer
    (Basis.piTensorProduct (fun _ : Fin k => Module.finBasis R M)) (symAction R M k),
    ← glAction_range_eq_centralizer_symAction]
  refine le_antisymm (Set.centralizer_subset Algebra.subset_adjoin) fun T hT => ?_
  rw [Subalgebra.mem_centralizer_iff] at hT ⊢
  exact fun f hf => (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hf
    fun g hg => (hT g hg).symm).symm

end RepresentationTheory

end MathlibExt.GroupTheory.SchurWeylWanted
