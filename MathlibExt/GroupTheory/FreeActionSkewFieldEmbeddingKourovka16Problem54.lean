/-!
# Groups acting freely on abelian groups and skew-fields (Kourovka Notebook Problem 16.54)

Kourovka Notebook, Archive of Solved Problems, Problem 16.54 (V. D. Mazurov): we say that a group
`G` acts freely on a group `V` if `vg ≠ v` for any nontrivial `g ∈ G`, `v ∈ V`. Is it true that a
group `G` that can act freely on a non-trivial abelian group is embeddable in the multiplicative
group of some skew-field?

The main result, `freeActionEmbedsInSkewField_refuted`, answers the question in the negative.
The Kourovka Archive's counterexample `2.A₅.2` rests on Amitsur's classification of the finite
subgroups of division rings; the proof here uses instead the group `Q₈ × C₃` of order `24`, for
which both halves of the argument are elementary.

* `Q₈ × C₃` acts freely on the rational quaternions `ℍ[ℚ]`: realise `Q₈` as the units of the
  Lipschitz quaternions (integer coordinates) and `C₃` as the powers of
  `ω = (-1 + i + j + k) / 2`, and let `(a, b)` act by `v ↦ a v b⁻¹`. A fixed vector `v ≠ 0`
  makes `a = v b v⁻¹` conjugate to `b`, so `a` and `b` have the same real part; this is an
  integer for `a` and `1` or `-1/2` for `b`, which forces `b = 1` and then `a = 1`.
* `Q₈ × C₃` embeds in the unit group of no division ring `D`. Take `g = (j, ω²)` and
  `h = (k, ω)`. In `D` the central involution goes to `-1` and `c = (1, ω)` goes to a root
  `C` of `C² + C + 1 = 0`. Hence `X = f g + f h` satisfies
  `X² = f (g²) + f (g h) + f (h g) + f (h²) = -C + f i - f i - C² = 1`, so `X = ±1`, so
  `f g` and `f h` commute, whereas `g h = (i, 1)` and `h g = (-i, 1)` differ.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.FreeActionSkewFieldEmbeddingKourovka16Problem54Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 16.54 (V. D.
Mazurov). UnsolvedMath record UM-00701246 (`KOU-16.54`), dataset ulamai/UnsolvedMath v1.8.0.

Actions are by automorphisms (`DistribMulAction`, written on the left); a skew-field is a division
ring and embeddable means an injective homomorphism into its group of units. Groups, modules and
division rings are in `Type` (a division ring containing a copy of `G` contains one generated by it,
of cardinality at most `max(|G|, ℵ₀)`).
-/

/-- **Kourovka Problem 16.54 (free actions and embeddings in skew-fields).** The statement, a
question of V. D. Mazurov, that every group $G$ with a free action by automorphisms on a
nontrivial abelian group $V$, meaning $g \cdot v \ne v$ for all $g \ne 1$ in $G$ and all $v \ne 0$
in $V$, has an injective homomorphism into the multiplicative group of some division ring. -/
def freeActionEmbedsInSkewField : Prop :=
  ∀ (G : Type) [Group G],
    (∃ (V : Type) (_ : AddCommGroup V) (_ : Nontrivial V) (_ : DistribMulAction G V),
      ∀ g : G, g ≠ 1 → ∀ v : V, v ≠ 0 → g • v ≠ v) →
    ∃ (D : Type) (_ : DivisionRing D) (f : G →* Dˣ), Function.Injective f

open Quaternion

/-! ### The group `Q₈ × C₃` inside `ℍ[ℚ]ˣ × ℍ[ℚ]ˣ` -/

/-- The Lipschitz quaternions: the rational quaternions with integer coordinates. -/
private def lipschitz : Submonoid ℍ[ℚ] where
  carrier := {q | ∃ a b c d : ℤ, q = ⟨a, b, c, d⟩}
  mul_mem' := by
    rintro _ _ ⟨a, b, c, d, rfl⟩ ⟨a', b', c', d', rfl⟩
    refine ⟨a * a' - b * b' - c * c' - d * d', a * b' + b * a' + c * d' - d * c',
      a * c' - b * d' + c * a' + d * b', a * d' + b * c' - c * b' + d * a', ?_⟩
    ext <;> simp <;> ring
  one_mem' := ⟨1, 0, 0, 0, by ext <;> simp⟩

/-- The units of the Lipschitz quaternions, that is the quaternion group `{±1, ±i, ±j, ±k}`. -/
private def lipschitzUnits : Subgroup ℍ[ℚ]ˣ := lipschitz.units

/-- The cube root of unity `ω = (-1 + i + j + k) / 2`, with inverse `ω² = (-1 - i - j - k) / 2`. -/
private def omegaUnit : ℍ[ℚ]ˣ :=
  ⟨⟨-1 / 2, 1 / 2, 1 / 2, 1 / 2⟩, ⟨-1 / 2, -1 / 2, -1 / 2, -1 / 2⟩, by ext <;> norm_num,
    by ext <;> norm_num⟩

private theorem omegaUnit_pow_three : omegaUnit ^ 3 = 1 := by
  ext <;> norm_num [omegaUnit, pow_succ]

/-- The cyclic group of order three generated by `ω`. -/
private def cyclicThree : Subgroup ℍ[ℚ]ˣ := Subgroup.zpowers omegaUnit

/-- The counterexample `Q₈ × C₃`, as a product of two subgroups of `ℍ[ℚ]ˣ`. -/
private abbrev Grp : Type := lipschitzUnits × cyclicThree

private theorem Grp.ext {x y : Grp} (h₁ : ((x.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) = ((y.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]))
    (h₂ : ((x.2 : ℍ[ℚ]ˣ) : ℍ[ℚ]) = ((y.2 : ℍ[ℚ]ˣ) : ℍ[ℚ])) : x = y :=
  Prod.ext (Subtype.ext (Units.ext h₁)) (Subtype.ext (Units.ext h₂))

/-! ### The free action of `Q₈ × C₃` on `ℍ[ℚ]` -/

/-- The action of `Q₈ × C₃` on `ℍ[ℚ]` in which `(a, b)` sends `v` to `a * v * b⁻¹`. -/
@[instance_reducible]
private def act : DistribMulAction Grp ℍ[ℚ] where
  smul g v := ((g.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) * v * (((g.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ])
  one_smul v := by
    change (((1 : lipschitzUnits) : ℍ[ℚ]ˣ) : ℍ[ℚ]) * v *
      ((((1 : cyclicThree) : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) = v
    simp
  mul_smul g h v := by
    change (((g.1 * h.1 : lipschitzUnits) : ℍ[ℚ]ˣ) : ℍ[ℚ]) * v *
        ((((g.2 * h.2 : cyclicThree) : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) =
      ((g.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) *
          (((h.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) * v * (((h.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ])) *
        (((g.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ])
    simp [mul_assoc]
  smul_zero g := by
    change ((g.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) * 0 * (((g.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) = 0
    simp
  smul_add g v w := by
    change ((g.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) * (v + w) * (((g.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) =
      ((g.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) * v * (((g.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) +
        ((g.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]) * w * (((g.2 : ℍ[ℚ]ˣ)⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ])
    simp [mul_add, add_mul]

/-- The real part of a quaternion product does not depend on the order of the factors. -/
private theorem re_mul_comm (x y : ℍ[ℚ]) : (x * y).re = (y * x).re := by
  simp only [Quaternion.re_mul]
  ring

/-- Elements of the quaternion group have integral real part. -/
private theorem exists_re_eq_intCast {a : ℍ[ℚ]ˣ} (ha : a ∈ lipschitzUnits) :
    ∃ n : ℤ, (a : ℍ[ℚ]).re = n := by
  obtain ⟨n, b, c, d, h⟩ := Submonoid.val_mem_of_mem_units _ ha
  exact ⟨n, by rw [h]⟩

private theorem eq_one_or_eq_omegaUnit {b : ℍ[ℚ]ˣ} (hb : b ∈ cyclicThree) :
    b = 1 ∨ b = omegaUnit ∨ b = omegaUnit ^ 2 := by
  obtain ⟨m, rfl⟩ := hb
  dsimp only
  rw [zpow_eq_zpow_emod' m omegaUnit_pow_three]
  have : m % (3 : ℕ) = 0 ∨ m % (3 : ℕ) = 1 ∨ m % (3 : ℕ) = 2 := by omega
  rcases this with h | h | h <;> rw [h] <;> simp

/-- A rational number equal to `-1/2` is not an integer. -/
private theorem intCast_ne_neg_half (n : ℤ) : (n : ℚ) ≠ -1 / 2 := by
  intro h
  have h₂ : ((2 * n : ℤ) : ℚ) = -1 := by push_cast; rw [h]; norm_num
  have : 2 * n = -1 := by exact_mod_cast h₂
  omega

/-- The action of `Q₈ × C₃` on `ℍ[ℚ]` is free. -/
private theorem act_free :
    letI := act
    ∀ g : Grp, g ≠ 1 → ∀ v : ℍ[ℚ], v ≠ 0 → g • v ≠ v := by
  let _ := act
  rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ hg v hv hfix
  change (a : ℍ[ℚ]) * v * ((b⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) = v at hfix
  have hab : (a : ℍ[ℚ]) * v = v * b := by
    calc (a : ℍ[ℚ]) * v = (a : ℍ[ℚ]) * v * ((b⁻¹ : ℍ[ℚ]ˣ) : ℍ[ℚ]) * b := by
          rw [mul_assoc _ _ (b : ℍ[ℚ]), Units.inv_mul, mul_one]
      _ = v * b := by rw [hfix]
  have hre : (a : ℍ[ℚ]).re = (b : ℍ[ℚ]).re := by
    have : (a : ℍ[ℚ]) = v * b * v⁻¹ := by rw [← hab, mul_assoc, mul_inv_cancel₀ hv, mul_one]
    rw [this, mul_assoc, re_mul_comm, mul_assoc, inv_mul_cancel₀ hv, mul_one]
  obtain ⟨n, hn⟩ := exists_re_eq_intCast ha
  rw [hn] at hre
  rcases eq_one_or_eq_omegaUnit hb with rfl | rfl | rfl
  · have ha₁ : a = 1 := by
      have : ((a : ℍ[ℚ]) - 1) * v = 0 := by rw [sub_mul, hab]; simp
      rcases mul_eq_zero.1 this with h | h
      · exact Units.ext (sub_eq_zero.1 h)
      · exact absurd h hv
    subst ha₁
    exact hg rfl
  · exact intCast_ne_neg_half n (by rw [hre]; norm_num [omegaUnit])
  · exact intCast_ne_neg_half n (by rw [hre]; norm_num [omegaUnit, pow_succ])

/-! ### `Q₈ × C₃` does not embed in the unit group of a division ring -/

private def quatI : ℍ[ℚ]ˣ := ⟨⟨0, 1, 0, 0⟩, ⟨0, -1, 0, 0⟩, by ext <;> simp, by ext <;> simp⟩

private def quatJ : ℍ[ℚ]ˣ := ⟨⟨0, 0, 1, 0⟩, ⟨0, 0, -1, 0⟩, by ext <;> simp, by ext <;> simp⟩

private def quatK : ℍ[ℚ]ˣ := ⟨⟨0, 0, 0, 1⟩, ⟨0, 0, 0, -1⟩, by ext <;> simp, by ext <;> simp⟩

private theorem neg_one_mem : (-1 : ℍ[ℚ]ˣ) ∈ lipschitzUnits :=
  ⟨⟨-1, 0, 0, 0, by ext <;> simp⟩, ⟨-1, 0, 0, 0, by ext <;> simp⟩⟩

private theorem quatI_mem : quatI ∈ lipschitzUnits :=
  ⟨⟨0, 1, 0, 0, by ext <;> simp [quatI]⟩, ⟨0, -1, 0, 0, by ext <;> simp [quatI]⟩⟩

private theorem quatJ_mem : quatJ ∈ lipschitzUnits :=
  ⟨⟨0, 0, 1, 0, by ext <;> simp [quatJ]⟩, ⟨0, 0, -1, 0, by ext <;> simp [quatJ]⟩⟩

private theorem quatK_mem : quatK ∈ lipschitzUnits :=
  ⟨⟨0, 0, 0, 1, by ext <;> simp [quatK]⟩, ⟨0, 0, 0, -1, by ext <;> simp [quatK]⟩⟩

/-- The central involution `(-1, 1)`. -/
private def elemZ : Grp := (⟨-1, neg_one_mem⟩, 1)

/-- The central element `(1, ω)` of order three. -/
private def elemC : Grp := (1, ⟨omegaUnit, Subgroup.mem_zpowers omegaUnit⟩)

/-- The element `(i, 1)`. -/
private def elemI : Grp := (⟨quatI, quatI_mem⟩, 1)

/-- The element `(j, ω²)`. -/
private def elemG : Grp :=
  (⟨quatJ, quatJ_mem⟩, ⟨omegaUnit ^ 2, Subgroup.pow_mem _ (Subgroup.mem_zpowers omegaUnit) 2⟩)

/-- The element `(k, ω)`. -/
private def elemH : Grp := (⟨quatK, quatK_mem⟩, ⟨omegaUnit, Subgroup.mem_zpowers omegaUnit⟩)

private theorem elemZ_mul_elemZ : elemZ * elemZ = 1 := Grp.ext (by simp [elemZ]) (by simp [elemZ])

private theorem elemZ_ne_one : elemZ ≠ 1 := by
  intro h
  have := congrArg (fun x : Grp ↦ ((x.1 : ℍ[ℚ]ˣ) : ℍ[ℚ]).re) h
  norm_num [elemZ] at this

private theorem elemC_mul_elemC_mul_elemC : elemC * elemC * elemC = 1 :=
  Grp.ext (by simp [elemC]) (by
    simp only [elemC, Prod.snd_mul, Prod.snd_one, Subgroup.coe_mul, Subgroup.coe_one]
    rw [show omegaUnit * omegaUnit * omegaUnit = omegaUnit ^ 3 by rw [pow_three, mul_assoc],
      omegaUnit_pow_three])

private theorem elemC_ne_one : elemC ≠ 1 := by
  intro h
  have := congrArg (fun x : Grp ↦ ((x.2 : ℍ[ℚ]ˣ) : ℍ[ℚ]).re) h
  norm_num [elemC, omegaUnit] at this

private theorem elemG_mul_elemG : elemG * elemG = elemC * elemZ :=
  Grp.ext (by ext <;> simp [elemG, elemC, elemZ, quatJ])
    (by ext <;> norm_num [elemG, elemC, elemZ, omegaUnit, pow_succ])

private theorem elemG_mul_elemH : elemG * elemH = elemI :=
  Grp.ext (by ext <;> simp [elemG, elemH, elemI, quatI, quatJ, quatK])
    (by ext <;> norm_num [elemG, elemH, elemI, omegaUnit, pow_succ])

private theorem elemH_mul_elemG : elemH * elemG = elemI * elemZ :=
  Grp.ext (by ext <;> simp [elemG, elemH, elemI, elemZ, quatI, quatJ, quatK])
    (by ext <;> norm_num [elemG, elemH, elemI, elemZ, omegaUnit, pow_succ])

private theorem elemH_mul_elemH : elemH * elemH = elemC * elemC * elemZ :=
  Grp.ext (by ext <;> simp [elemH, elemC, elemZ, quatK])
    (by ext <;> norm_num [elemH, elemC, elemZ, omegaUnit, pow_succ])

/-- `Q₈ × C₃` has no injective homomorphism into the unit group of a division ring. -/
private theorem not_injective (D : Type) [DivisionRing D] (f : Grp →* Dˣ) :
    ¬ Function.Injective f := by
  intro hf
  set F : Grp → D := fun x ↦ ((f x : Dˣ) : D) with hF
  have hmul (x y : Grp) : F (x * y) = F x * F y := by simp [hF]
  have hinj (x y : Grp) (h : F x = F y) : x = y := hf (Units.ext h)
  have hone : F 1 = 1 := by simp [hF]
  -- The central involution goes to `-1`.
  have hZ : F elemZ = -1 := by
    have h₁ : (F elemZ - 1) * (F elemZ + 1) = 0 := by
      rw [show (F elemZ - 1) * (F elemZ + 1) = F elemZ * F elemZ - 1 by noncomm_ring,
        ← hmul, elemZ_mul_elemZ, hone, sub_self]
    rcases mul_eq_zero.1 h₁ with h | h
    · exact absurd (hinj _ _ (by rw [hone]; exact sub_eq_zero.1 h)) elemZ_ne_one
    · exact eq_neg_of_add_eq_zero_left h
  -- The element of order three goes to a root of `C² + C + 1`.
  have hC : F elemC * F elemC + F elemC + 1 = 0 := by
    have h₁ : (F elemC - 1) * (F elemC * F elemC + F elemC + 1) = 0 := by
      rw [show (F elemC - 1) * (F elemC * F elemC + F elemC + 1) =
          F elemC * F elemC * F elemC - 1 by noncomm_ring,
        ← hmul, ← hmul, elemC_mul_elemC_mul_elemC, hone, sub_self]
    rcases mul_eq_zero.1 h₁ with h | h
    · exact absurd (hinj _ _ (by rw [hone]; exact sub_eq_zero.1 h)) elemC_ne_one
    · exact h
  -- `X = F elemG + F elemH` squares to `1`, so it is `1` or `-1`.
  set X := F elemG + F elemH with hX
  have hX₂ : X * X = 1 := by
    rw [show X * X = F (elemG * elemG) + F (elemG * elemH) + F (elemH * elemG) +
        F (elemH * elemH) by simp only [hX, hmul]; noncomm_ring,
      elemG_mul_elemG, elemG_mul_elemH, elemH_mul_elemG, elemH_mul_elemH]
    simp only [hmul, hZ]
    calc F elemC * -1 + F elemI + F elemI * -1 + F elemC * F elemC * -1
        = -(F elemC * F elemC + F elemC + 1) + 1 := by noncomm_ring
      _ = 1 := by rw [hC, neg_zero, zero_add]
  have hX₁ : X = 1 ∨ X = -1 := by
    have h₁ : (X - 1) * (X + 1) = 0 := by
      rw [show (X - 1) * (X + 1) = X * X - 1 by noncomm_ring, hX₂, sub_self]
    rcases mul_eq_zero.1 h₁ with h | h
    · exact Or.inl (sub_eq_zero.1 h)
    · exact Or.inr (eq_neg_of_add_eq_zero_left h)
  -- Hence the images of `elemG` and `elemH` commute, but `elemG` and `elemH` do not.
  have hcomm : F elemG * F elemH = F elemH * F elemG := by
    have hG : F elemG = X - F elemH := by rw [hX]; abel
    rcases hX₁ with h | h <;> rw [hG, h] <;> noncomm_ring
  have h := hinj _ _ (by rw [hmul, hmul, hcomm] : F (elemG * elemH) = F (elemH * elemG))
  rw [elemG_mul_elemH, elemH_mul_elemG] at h
  exact elemZ_ne_one (mul_eq_left.1 h.symm)

/--
**Groups acting freely on abelian groups need not embed in skew-fields (Kourovka 16.54).** There
is a group $G$ with an action by automorphisms on a nontrivial abelian group $V$ such that
$g \cdot v \ne v$ for all $g \ne 1$ in $G$ and all $v \ne 0$ in $V$, but with no injective
homomorphism into the multiplicative group of any division ring. This answers Kourovka
Problem 16.54 in the negative.

The Kourovka Archive answers "No, it is not" (Nedrenko): the group $2.A_5.2$ with a quaternion
Sylow $2$-subgroup acts freely on an elementary abelian group of order $7^4$, but by Theorem 7 of
Amitsur's classification of finite subgroups of division rings it does not embed in the
multiplicative group of any skew-field.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved
Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of
Solved Problems, Problem 16.54 (V. D. Mazurov); resolution: D. Nedrenko, letter of 20 January 2014,
as recorded in the Kourovka Archive; S. A. Amitsur, Finite subgroups of division rings, Trans. Amer.
Math. Soc. 80 (1955), 361-386, Kourovka Archive, Problem 16.54 (No: 2.A_5.2 with a quaternion Sylow
2-subgroup acts freely on an elementary abelian group of order 7^4 but does not embed in the
multiplicative group of a skew-field, by Amitsur's Theorem 7).
-/
theorem freeActionEmbedsInSkewField_refuted : ¬ freeActionEmbedsInSkewField := by
  intro h
  obtain ⟨D, _, f, hf⟩ := h Grp ⟨ℍ[ℚ], inferInstance, inferInstance, act, act_free⟩
  exact not_injective D f hf

end MathlibExt.GroupTheory.FreeActionSkewFieldEmbeddingKourovka16Problem54Wanted
