/-!
# Involution centralizers isomorphic to ⟨i⟩ × L₂(P) (Kourovka Notebook Problem 18.59)

We prove the negative answer to Problem 18.59 using the action of conjugation on ordered pairs
of commuting involutions.

Kourovka Notebook, Problem 18.59 (D. V. Lytkina), marked solved in the 21st issue: does there exist
a periodic group `G` such that `G` contains an involution, all involutions in `G` are conjugate, and
the centralizer of every involution `i` is isomorphic to `⟨i⟩ × L₂(P)`, where `P` is some infinite
locally finite field of characteristic `2`?
-/

@[expose] public section

namespace MathlibExt.GroupTheory.InvolutionCentralizerPSLTwoKourovka18Problem59Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 18.59 (D. V. Lytkina). UnsolvedMath record
UM-00701488 (`KOU-18.59`), dataset ulamai/UnsolvedMath v1.8.0.

`L₂(P) = PSL₂(P)` is Mathlib's `Matrix.ProjectiveSpecialLinearGroup (Fin 2) P`, the quotient of
`SL₂(P)` by its centre; a locally finite field is one whose finitely generated subfields are finite;
periodic means every element has finite order. The field `P` is chosen once for all involutions
(they are conjugate, so this loses nothing).
-/

/-- **Locally finite fields (Kourovka 18.59).** A field $P$ is locally finite when, for every
finite subset $s$ of $P$, the subfield of $P$ generated by $s$ is finite. -/
def IsLocallyFiniteField (P : Type) [Field P] : Prop :=
  ∀ s : Finset P, Finite (Subfield.closure (s : Set P))

/-- **Kourovka Problem 18.59 on involution centralizers.** The proposition (Kourovka 18.59, D. V.
Lytkina) that there are a periodic group $G$ which contains an involution and in which all
involutions are conjugate, and an infinite locally finite field $P$ of characteristic $2$, such
that the centralizer of every involution $i$ of $G$ is isomorphic to
$\langle i \rangle \times \mathrm{PSL}_2(P)$. Here $\langle i \rangle$ is the cyclic subgroup
generated by $i$ and $\mathrm{PSL}_2(P) = L_2(P)$ is the quotient of $\mathrm{SL}_2(P)$ by its
centre.

The field $P$ is chosen once for all involutions; since all involutions are conjugate, this is
equivalent to allowing a field for each involution. -/
def periodicGroupWithPSLInvolutionCentralizers : Prop :=
  ∃ (G : Type) (_ : Group G), (∀ g : G, IsOfFinOrder g) ∧ (∃ i : G, orderOf i = 2) ∧
    (∀ i j : G, orderOf i = 2 → orderOf j = 2 → IsConj i j) ∧
    ∃ (P : Type) (_ : Field P), CharP P 2 ∧ Infinite P ∧ IsLocallyFiniteField P ∧
      ∀ i : G, orderOf i = 2 →
        Nonempty (Subgroup.centralizer {i} ≃*
          (Subgroup.zpowers i × Matrix.ProjectiveSpecialLinearGroup (Fin 2) P))

open Matrix Matrix.SpecialLinearGroup
open scoped MatrixGroups

local notation "C(" a ")" => Subgroup.centralizer {a}
local notation "U" => Matrix.SpecialLinearGroup.transvection
  (ι := Fin 2) (i := 0) (j := 1) zero_ne_one

section

variable {P : Type} [Field P] [CharP P 2]

private lemma sq_injective : Function.Injective (fun x : P ↦ x ^ 2) :=
  frobenius_inj P 2

private lemma sl_center : Subgroup.center SL(2, P) = ⊥ := by
  apply le_antisymm _ bot_le
  intro A hA
  obtain ⟨r, hr, h⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hA
  rw [Fintype.card_fin] at hr
  have hr1 : r = 1 := sq_injective (by simpa using hr)
  subst r
  exact Subgroup.mem_bot.mpr (Subtype.ext (by simpa using h.symm))

private def pslEquiv : PSL(2, P) ≃* SL(2, P) :=
  (QuotientGroup.quotientMulEquivOfEq sl_center).trans QuotientGroup.quotientBot

private lemma sq_surjective (hP : IsLocallyFiniteField P) :
    Function.Surjective (fun x : P ↦ x ^ 2) := by
  intro x
  classical
  let K := Subfield.closure (({x} : Finset P) : Set P)
  let : Finite K := hP {x}
  let xK : K := ⟨x, Subfield.subset_closure (by simp)⟩
  obtain ⟨y, hy⟩ := Finite.surjective_of_injective (frobenius_inj K 2) xK
  exact ⟨y, congrArg Subtype.val hy⟩

omit [CharP P 2] in
private lemma coe_U (t : P) : (U t).1 = !![1, t; 0, 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [transvection_coe, Matrix.single]

omit [CharP P 2] in
private lemma U_injective : Function.Injective (U : P → SL(2, P)) := by
  intro x y h
  simpa [coe_U] using congrArg (fun A : SL(2, P) ↦ A.1 0 1) h

private lemma U_sq (t : P) : U t ^ 2 = 1 := by
  rw [pow_two, ← transvection_add, CharTwo.add_self_eq_zero]
  exact Subtype.ext (by simp)

private lemma commuting_U {t : P} (ht : t ≠ 0) {A : SL(2, P)} :
    Commute A (U t) ↔ ∃ s : P, A = U s := by
  constructor
  · induction A using Matrix.SpecialLinearGroup.fin_two_induction with
    | h a b c d hd =>
      intro h
      have hc : c = 0 := by
        have hh := congrArg (fun A : Matrix (Fin 2) (Fin 2) P ↦ A 0 0)
          (congrArg Subtype.val h.eq)
        simpa [coe_mul, coe_U, ht] using hh
      have had : a = d := by
        have hh := congrArg (fun A : Matrix (Fin 2) (Fin 2) P ↦ A 0 1)
          (congrArg Subtype.val h.eq)
        have he : a * t + b = b + t * d := by
          simpa [coe_mul, coe_U, Matrix.mul_fin_two] using hh
        apply mul_right_cancel₀ ht
        apply add_right_cancel (b := b)
        simpa [mul_comm d, add_comm b] using he
      subst c d
      have ha : a = 1 := sq_injective (by simpa [pow_two] using hd)
      subst a
      exact ⟨b, Subtype.ext (coe_U b).symm⟩
  · rintro ⟨s, rfl⟩
    change U s * U t = U t * U s
    rw [← transvection_add, ← transvection_add, add_comm]

omit [CharP P 2] in
private lemma U_conj (hsq : Function.Surjective (fun x : P ↦ x ^ 2)) {t : P} (ht : t ≠ 0) :
    IsConj (U (1 : P)) (U t) := by
  obtain ⟨r, hr⟩ := hsq t
  have hr0 : r ≠ 0 := by rintro rfl; exact ht (by simpa using hr.symm)
  refine isConj_iff.mpr ⟨diag2 r hr0, mul_inv_eq_iff_eq_mul.mpr ?_⟩
  apply Subtype.ext
  simp [coe_mul, diag2_coe', coe_U, ← hr, pow_two, mul_assoc, mul_inv_cancel₀ hr0]

private lemma involution_conj_U (hsq : Function.Surjective (fun x : P ↦ x ^ 2))
    {A : SL(2, P)} (hA : A ^ 2 = 1) (hne : A ≠ 1) : IsConj (U (1 : P)) A := by
  induction A using Matrix.SpecialLinearGroup.fin_two_induction with
  | h a b c d hdet =>
    have hinv := eq_inv_iff_mul_eq_one.mpr (by simpa [pow_two] using hA)
    have had : a = d := by
      have h := congrArg (fun A : SL(2, P) ↦ A.1 0 0) hinv
      simpa [SL2_inv_expl] using h
    subst d
    have hdet' : a * a + b * c = 1 := by simpa [sub_eq_add_neg, CharTwo.neg_eq] using hdet
    by_cases hb : b = 0
    · subst b
      have ha : a = 1 := sq_injective (by simpa [pow_two] using hdet)
      subst a
      have hc : c ≠ 0 := by
        rintro rfl
        exact hne (Subtype.ext (by simp [Matrix.one_fin_two]))
      apply (U_conj hsq hc).trans
      let S : SL(2, P) := .mk !![0, 1; 1, 0] (by simp [det_fin_two_of, CharTwo.neg_eq])
      refine isConj_iff.mpr ⟨S, mul_inv_eq_iff_eq_mul.mpr ?_⟩
      apply Subtype.ext
      simp [S, coe_mul, coe_U]
    · apply (U_conj hsq (inv_ne_zero hb)).trans
      let S : SL(2, P) := .mk !![b, 0; a + 1, b⁻¹] (by simp [det_fin_two_of, hb])
      refine isConj_iff.mpr ⟨S, mul_inv_eq_iff_eq_mul.mpr ?_⟩
      apply Subtype.ext
      have hab : a * b + b * (a + 1) = b := by
        rw [mul_add, mul_one, mul_comm b a, ← add_assoc, CharTwo.add_self_eq_zero, zero_add]
      have hba : c * b + a * (a + 1) = a + 1 := by
        rw [mul_add, mul_one, mul_comm c b, ← add_assoc, add_comm (b * c), hdet', add_comm]
      simp [S, coe_mul, coe_U, hb, hab, hba, add_mul, add_comm, CharTwo.add_cancel_left]

end

private abbrev C₂ := Multiplicative (ZMod 2)

private lemma bit_cases (z : C₂) : z = 1 ∨ z = Multiplicative.ofAdd 1 := by
  change z.toAdd = 0 ∨ z.toAdd = 1
  exact (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) z.toAdd

section

variable {G : Type} [Group G]

private noncomputable def zpowersEquivC₂ {a : G} (ha : orderOf a = 2) :
    Subgroup.zpowers a ≃* C₂ := by
  classical
  let g : Subgroup.zpowers a := ⟨a, Subgroup.mem_zpowers a⟩
  have hg : g ≠ 1 := fun h ↦ (orderOf_eq_prime_iff.mp ha).2 (congrArg Subtype.val h)
  have hgg : g * g = 1 := Subtype.ext (by simpa [pow_two] using (orderOf_eq_prime_iff.mp ha).1)
  have hfinite : IsOfFinOrder a := orderOf_pos_iff.mp (by simp [ha])
  have cases (x : Subgroup.zpowers a) : x = 1 ∨ x = g := by
    have hx := hfinite.mem_zpowers_iff_mem_range_orderOf.mp x.property
    rw [ha, Finset.mem_image] at hx
    obtain ⟨n, hn, hn'⟩ := hx
    have hn'' : n = 0 ∨ n = 1 := by
      have := Finset.mem_range.mp hn
      omega
    rcases hn'' with rfl | rfl
    · exact Or.inl (Subtype.ext (by simpa using hn'.symm))
    · exact Or.inr (Subtype.ext (by simpa [g] using hn'.symm))
  refine
    { toFun := fun x ↦ if x = 1 then 1 else Multiplicative.ofAdd 1
      invFun := fun z ↦ if z = 1 then 1 else g
      left_inv := ?_
      right_inv := ?_
      map_mul' := ?_ }
  · intro x
    rcases cases x with rfl | rfl <;> simp [hg]
  · intro z
    rcases bit_cases z with rfl | rfl <;> simp [hg]
  · intro x y
    have hbit : (Multiplicative.ofAdd (1 : ZMod 2)) * Multiplicative.ofAdd 1 = 1 := by decide
    rcases cases x with rfl | rfl <;> rcases cases y with rfl | rfl <;>
      simp [hg, hgg, hbit]

private def inCentralizer {a b : G} (h : Commute b a) : C(a) :=
  ⟨b, Subgroup.mem_centralizer_singleton_iff.mpr h⟩

private def centralizerConj (a g : G) : C(a) ≃* C(MulAut.conj g a) := by
  let e := MulAut.conj g
  have hmap : C(a).map e.toMonoidHom = C(e a) := by
    ext x
    rw [Subgroup.mem_centralizer_singleton_iff]
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact (Subgroup.mem_centralizer_singleton_iff.mp hb).map e
    · intro h
      exact ⟨e.symm x, Subgroup.mem_centralizer_singleton_iff.mpr
        (by simpa using h.map e.symm), e.apply_symm_apply x⟩
  exact (e.subgroupMap _).trans (MulEquiv.subgroupCongr hmap)

private lemma map_mem_commutator_iff {H : Type} [Group H] (e : G ≃* H) (b : G) :
    e b ∈ commutator H ↔ b ∈ commutator G := by
  rw [← map_commutator_of_surjective (f := e.toMonoidHom) e.surjective, Subgroup.mem_map]
  exact ⟨fun ⟨x, hx, he⟩ ↦ e.injective he ▸ hx, fun h ↦ ⟨b, h, rfl⟩⟩

end

section

variable {P : Type} [Field P] [CharP P 2] [Infinite P]

private lemma sl_commutator : commutator SL(2, P) = ⊤ := by
  classical
  obtain ⟨r, hr⟩ := ({0, 1} : Finset P).exists_notMem
  have hr0 : r ≠ 0 := by
    intro h
    exact hr (by simp [h])
  have hr1 : r ≠ 1 := by
    intro h
    exact hr (by simp [h])
  exact Matrix.SL2.commutator_eq_top hr0 (fun h ↦ hr1 (sq_injective (by simpa using h)))

private lemma mem_commutator_prod (b : C₂ × SL(2, P)) :
    b ∈ commutator (C₂ × SL(2, P)) ↔ b.1 = 1 := by
  simp only [commutator_def] at *
  rw [show (⊤ : Subgroup (C₂ × SL(2, P))) = (⊤ : Subgroup C₂).prod ⊤ by
    ext x
    simp, Subgroup.commutator_prod_prod, ← commutator_def, ← commutator_def,
    commutator_eq_bot, sl_commutator]
  exact ⟨fun h ↦ Subgroup.mem_bot.mp h.1, fun h ↦ ⟨Subgroup.mem_bot.mpr h, trivial⟩⟩

end

-- On an infinite group of exponent two, neither relation between the two labels on an
-- ordered pair is compatible with additivity and with each diagonal label being one.
private lemma label_obstruction {E : Type} [Group E] [Infinite E]
    (hsq : ∀ x : E, x ^ 2 = 1) (f : E → E → ZMod 2)
    (hdiag : ∀ {a}, a ≠ 1 → f a a = 1)
    (hadd : ∀ a x y, f a (x * y) = f a x + f a y)
    (horbit : ∀ {a b c d}, a ≠ 1 → b ≠ 1 → a ≠ b → c ≠ 1 → d ≠ 1 → c ≠ d →
      f a b = f c d → f b a = f d c) : False := by
  classical
  obtain ⟨a, ha⟩ := exists_ne (1 : E)
  obtain ⟨b, hb⟩ := ({1, a} : Finset E).exists_notMem
  have hb1 : b ≠ 1 := fun h ↦ hb (by simp [h])
  have hab : a ≠ b := fun h ↦ hb (by simp [← h])
  have hab1 : a * b ≠ 1 := by
    intro h
    exact hab ((eq_inv_iff_mul_eq_one.mpr h).trans
      (eq_inv_iff_mul_eq_one.mpr (by simpa [pow_two] using hsq b)).symm)
  by_cases hsym : ∃ x y, x ≠ 1 ∧ y ≠ 1 ∧ x ≠ y ∧ f x y = f y x
  · obtain ⟨x, y, hx, hy, hxy, h⟩ := hsym
    have symm : ∀ {u v}, u ≠ 1 → v ≠ 1 → f u v = f v u := by
      intro u v hu hv
      by_contra hn
      have huv : u ≠ v := fun he ↦ hn (by rw [he])
      by_cases hlabel : f x y = f u v
      · exact hn ((hlabel.symm.trans h).trans (horbit hx hy hxy hu hv huv hlabel))
      · have hrev : f x y = f v u := by
          exact (by decide : ∀ p q r : ZMod 2, p ≠ q → q ≠ r → p = r) _ _ _ hlabel hn
        exact hn ((horbit hx hy hxy hv hu huv.symm hrev).symm.trans (h.symm.trans hrev))
    have hzero : f (a * b) (a * b) = 0 := by
      rw [hadd, symm hab1 ha, symm hab1 hb1, hadd, hadd, hdiag ha, hdiag hb1, symm hb1 ha]
      calc
        _ = (1 + 1) + (f a b + f a b) := by abel
        _ = 0 := by simp [CharTwo.add_self_eq_zero]
    exact one_ne_zero ((hdiag hab1).symm.trans hzero)
  · have skew : ∀ {u v}, u ≠ 1 → v ≠ 1 → u ≠ v → f u v + f v u = 1 := by
      intro u v hu hv huv
      exact (by decide : ∀ p q : ZMod 2, p ≠ q → p + q = 1) _ _
        (fun h ↦ hsym ⟨u, v, hu, hv, huv, h⟩)
    let s : Finset E := {1, a, b, a * b}
    let k (x : E) := f (a * b) x + f a x + f b x
    have hk {x : E} (hx : x ∉ s) : k x = 1 := by
      have h1 : x ≠ 1 := fun h ↦ hx (by simp [s, h])
      have hax : a ≠ x := fun h ↦ hx (by simp [s, ← h])
      have hbx : b ≠ x := fun h ↦ hx (by simp [s, ← h])
      have habx : a * b ≠ x := fun h ↦ hx (by simp [s, ← h])
      have reverse {u v} (hu : u ≠ 1) (hv : v ≠ 1) (huv : u ≠ v) :
          f u v = 1 + f v u := CharTwo.eq_add_iff_add_eq.mpr (skew hu hv huv)
      dsimp [k]
      rw [reverse hab1 h1 habx, reverse ha h1 hax, reverse hb1 h1 hbx, hadd x a b]
      calc
        _ = (1 + 1) + 1 + ((f x a + f x a) + (f x b + f x b)) := by abel
        _ = 1 := by simp [CharTwo.add_self_eq_zero]
    obtain ⟨c, hc⟩ := s.exists_notMem
    obtain ⟨d, hd⟩ := (s ∪ s.image (fun x ↦ c⁻¹ * x)).exists_notMem
    have hd' : d ∉ s := fun h ↦ hd (Finset.mem_union_left _ h)
    have hcd : c * d ∉ s := fun h ↦ hd (Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨c * d, h, inv_mul_cancel_left c d⟩))
    have hsplit : k (c * d) = k c + k d := by
      simp only [k, hadd]
      abel
    rw [hk hcd, hk hc, hk hd', CharTwo.add_self_eq_zero] at hsplit
    exact one_ne_zero hsplit

section

variable {G P : Type} [Group G] [Field P] [CharP P 2]

private lemma central_involution_image {a : G} (ha : a ≠ 1)
    (e : C(a) ≃* C₂ × SL(2, P)) :
    e (inCentralizer (Commute.refl a)) = (Multiplicative.ofAdd 1, 1) := by
  let self := inCentralizer (Commute.refl a)
  have hc : e self ∈ Subgroup.center (C₂ × SL(2, P)) := by
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨x, rfl⟩ := e.surjective y
    rw [← map_mul, ← map_mul]
    exact congrArg e (Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp x.property).eq)
  have hsecond : (e self).2 = 1 := by
    rw [Subgroup.center_prod, sl_center] at hc
    exact Subgroup.mem_bot.mp hc.2
  change e self = _
  rcases bit_cases (e self).1 with h | h
  · have he : e self = 1 := Prod.ext h hsecond
    exact (ha (congrArg Subtype.val (e.map_eq_one_iff.mp he))).elim
  · exact Prod.ext h hsecond

private lemma second_ne_one {a : G} (ha : a ≠ 1) (e : C(a) ≃* C₂ × SL(2, P))
    (b : C(a)) (hb : (b : G) ≠ 1) (hab : a ≠ (b : G)) : (e b).2 ≠ 1 := by
  intro h
  rcases bit_cases (e b).1 with hfirst | hfirst
  · exact hb (congrArg Subtype.val (e.map_eq_one_iff.mp (Prod.ext hfirst h)))
  · have he : e b = e (inCentralizer (Commute.refl a)) := by
      rw [central_involution_image ha e]
      exact Prod.ext hfirst h
    exact hab (congrArg Subtype.val (e.injective he)).symm

-- The first coordinate vanishes precisely on the commutator subgroup of the centralizer.
private lemma label_invariant [Infinite P] {a a' : G}
    (e : C(a) ≃* C₂ × SL(2, P)) (e' : C(a') ≃* C₂ × SL(2, P))
    (b : C(a)) (b' : C(a')) (g : G)
    (ha : MulAut.conj g a = a') (hb : MulAut.conj g (b : G) = (b' : G)) :
    (e b).1.toAdd = (e' b').1.toAdd := by
  subst a'
  have hbb : centralizerConj a g b = b' := Subtype.ext hb
  have hmem : (e b).1 = 1 ↔ (e' b').1 = 1 := calc
    _ ↔ e b ∈ commutator (C₂ × SL(2, P)) := (mem_commutator_prod _).symm
    _ ↔ b ∈ commutator C(a) := map_mem_commutator_iff e b
    _ ↔ b' ∈ commutator C(MulAut.conj g a) := by
      rw [← hbb, map_mem_commutator_iff]
    _ ↔ e' b' ∈ commutator (C₂ × SL(2, P)) := (map_mem_commutator_iff e' b').symm
    _ ↔ _ := mem_commutator_prod _
  exact (by decide : ∀ x y : ZMod 2, (x = 0 ↔ y = 0) → x = y) _ _ hmem

-- Conjugate the first member of the pair, then align the second within its centralizer.
private lemma conjugate_pair [Infinite P] (hsq : Function.Surjective (fun x : P ↦ x ^ 2))
    {a a' : G} (ha : a ≠ 1) (ha' : a' ≠ 1) (hc : IsConj a a')
    (e : C(a) ≃* C₂ × SL(2, P)) (e' : C(a') ≃* C₂ × SL(2, P))
    (b : C(a)) (b' : C(a')) (hb : b ^ 2 = 1) (hb' : b' ^ 2 = 1)
    (hb1 : (b : G) ≠ 1) (hb1' : (b' : G) ≠ 1)
    (hab : a ≠ (b : G)) (hab' : a' ≠ (b' : G))
    (hlabel : (e b).1.toAdd = (e' b').1.toAdd) :
    ∃ g : G, MulAut.conj g a = a' ∧ MulAut.conj g (b : G) = (b' : G) := by
  obtain ⟨g, hg⟩ := isConj_iff.mp hc
  change MulAut.conj g a = a' at hg
  subst a'
  let x := centralizerConj a g b
  have hx1 : (x : G) ≠ 1 := fun h ↦ hb1 ((MulAut.conj g).map_eq_one_iff.mp h)
  have hax : MulAut.conj g a ≠ (x : G) := fun h ↦ hab ((MulAut.conj g).injective h)
  have hxsq : x ^ 2 = 1 := by
    change centralizerConj a g b ^ 2 = 1
    rw [← map_pow, hb, map_one]
  have hs {y : C(MulAut.conj g a)} (hy : y ^ 2 = 1) : (e' y).2 ^ 2 = 1 := by
    let proj := (MonoidHom.snd C₂ SL(2, P)).comp e'.toMonoidHom
    change proj y ^ 2 = 1
    rw [← map_pow, hy, map_one]
  have hconj : IsConj (e' x).2 (e' b').2 :=
    (involution_conj_U hsq (hs hxsq)
      (second_ne_one ((MulAut.conj g).map_ne_one_iff.mpr ha) e' x hx1 hax)).symm.trans
    (involution_conj_U hsq (hs hb') (second_ne_one ha' e' b' hb1' hab'))
  have heq : (e' x).1 = (e' b').1 :=
    (label_invariant e e' b x g rfl rfl).symm.trans hlabel
  obtain ⟨s, hs⟩ := isConj_iff.mp hconj
  let k := e'.symm (1, s)
  have hk : k * x * k⁻¹ = b' := by
    apply e'.injective
    simp only [map_mul, map_inv, k, MulEquiv.apply_symm_apply]
    exact Prod.ext (by simpa using heq) hs
  have hka : MulAut.conj (k : G) (MulAut.conj g a) = MulAut.conj g a := by
    rw [MulAut.conj_apply, (Subgroup.mem_centralizer_singleton_iff.mp k.property).eq]
    simp [mul_assoc]
  refine ⟨(k : G) * g, ?_, ?_⟩
  · simpa only [map_mul, MulAut.mul_apply] using hka
  · have hh : MulAut.conj (k : G) (MulAut.conj g (b : G)) = (b' : G) :=
      congrArg Subtype.val hk
    simpa only [map_mul, MulAut.mul_apply] using hh

end

section

variable {G P : Type} [Group G] [Field P] [CharP P 2] [Infinite P]

-- The common centralizer of the original involution and a nonidentity transvection
-- gives a group of exponent two containing a copy of the additive group of the field.
private lemma exists_elementary_abelian {i : G} (e : C(i) ≃* C₂ × SL(2, P)) :
    ∃ E : Subgroup G, Infinite E ∧ ∀ x : E, x ^ 2 = 1 := by
  let lift (t : P) := e.symm (1, U t)
  let j : C(i) := lift 1
  let E := C(i) ⊓ C((j : G))
  have hj : e j = (1, U (1 : P)) := e.apply_symm_apply _
  have hlift (t : P) : e (lift t) = (1, U t) := e.apply_symm_apply _
  have hin (x : C(i)) : (x : G) ∈ E ↔ Commute (e x).2 (U (1 : P)) := by
    change ((x : G) ∈ C(i) ∧ (x : G) ∈ C((j : G))) ↔ _
    rw [Subgroup.mem_centralizer_singleton_iff (g := (j : G))]
    constructor
    · rintro ⟨_, h⟩
      have h' : Commute x j := Subtype.ext h.eq
      have he := (h'.map e).map (MonoidHom.snd C₂ SL(2, P))
      change Commute (e x).2 (e j).2 at he
      rwa [hj] at he
    · intro h
      refine ⟨x.property, ?_⟩
      have he : Commute (e x) (e j) := by
        rw [hj]
        exact Prod.ext (by simp) h.eq
      exact congrArg Subtype.val (he.of_map e.injective).eq
  refine ⟨E, ?_, ?_⟩
  · let phi (t : P) : E :=
      ⟨lift t, (hin (lift t)).mpr (by
        rw [hlift]
        exact (commuting_U one_ne_zero).mpr ⟨t, rfl⟩)⟩
    refine Infinite.of_injective phi (fun a b h ↦ U_injective ?_)
    have he : lift a = lift b := Subtype.ext (congrArg (fun x : E ↦ (x : G)) h)
    have hpair := congrArg e he
    rw [hlift, hlift] at hpair
    exact congrArg Prod.snd hpair
  · intro x
    let y : C(i) := ⟨x, x.property.1⟩
    obtain ⟨t, ht⟩ := (commuting_U one_ne_zero).mp ((hin y).mp x.property)
    have hfirst : (e y).1 ^ 2 = 1 := by
      rw [pow_two]
      change (e y).1.toAdd + (e y).1.toAdd = 0
      exact CharTwo.add_self_eq_zero _
    have hsecond : (e y).2 ^ 2 = 1 := by rw [ht, U_sq]
    have he : (e y) ^ 2 = 1 := Prod.ext hfirst hsecond
    have hy : y ^ 2 = 1 := e.injective (by simpa only [map_pow, map_one] using he)
    exact Subtype.ext (congrArg (fun x : C(i) ↦ (x : G)) hy)

private lemma centralizer_obstruction
    (hP : IsLocallyFiniteField P) {i : G} (hi : orderOf i = 2)
    (hconj : ∀ a b : G, orderOf a = 2 → orderOf b = 2 → IsConj a b)
    (hC : ∀ a : G, orderOf a = 2 →
      Nonempty (C(a) ≃* (Subgroup.zpowers a × PSL(2, P)))) : False := by
  classical
  let e (a : G) (ha : orderOf a = 2) : C(a) ≃* C₂ × SL(2, P) :=
    (hC a ha).some.trans ((zpowersEquivC₂ ha).prodCongr pslEquiv)
  obtain ⟨E, hEinf, hEsq⟩ := exists_elementary_abelian (e i hi)
  let : Infinite E := hEinf
  have hinv (a : E) : a⁻¹ = a :=
    (eq_inv_iff_mul_eq_one.mpr (by simpa [pow_two] using hEsq a)).symm
  have hcomm (a b : E) : Commute (b : G) (a : G) := by
    have h : b * a = a * b := by
      calc
        b * a = (b * a)⁻¹ := (hinv (b * a)).symm
        _ = a * b := by rw [mul_inv_rev, hinv, hinv]
    exact congrArg Subtype.val h
  have horder {a : E} (ha : a ≠ 1) : orderOf (a : G) = 2 :=
    orderOf_eq_prime (congrArg Subtype.val (hEsq a)) (fun h ↦ ha (Subtype.ext h))
  let asCent (a b : E) : C((a : G)) := inCentralizer (hcomm a b)
  have hcent_sq (a b : E) : (asCent a b) ^ 2 = 1 :=
    Subtype.ext (congrArg (fun x : E ↦ (x : G)) (hEsq b))
  let f (a b : E) : ZMod 2 :=
    if ha : a ≠ 1 then (e (a : G) (horder ha) (asCent a b)).1.toAdd else 0
  have f_of_ne {a : E} (ha : a ≠ 1) (b : E) :
      f a b = (e (a : G) (horder ha) (asCent a b)).1.toAdd := dite_eq_left ha
  have hdiag {a : E} (ha : a ≠ 1) : f a a = 1 := by
    rw [f_of_ne ha a]
    change (e (a : G) (horder ha) (inCentralizer (Commute.refl (a : G)))).1.toAdd = 1
    rw [central_involution_image (fun h ↦ ha (Subtype.ext h))]
    rfl
  have hadd (a b c : E) : f a (b * c) = f a b + f a c := by
    by_cases ha : a ≠ 1
    · rw [f_of_ne ha (b * c), f_of_ne ha b, f_of_ne ha c]
      change (e (a : G) (horder ha) (asCent a b * asCent a c)).1.toAdd = _
      rw [map_mul]
      rfl
    · simp [f, not_ne_iff.mp ha]
  refine label_obstruction hEsq f hdiag hadd ?_
  intro a b c d ha hb hab hc hd hcd habcd
  rw [f_of_ne ha b, f_of_ne hc d] at habcd
  obtain ⟨g, hga, hgb⟩ := conjugate_pair (sq_surjective hP)
    (fun h ↦ ha (Subtype.ext h)) (fun h ↦ hc (Subtype.ext h))
    (hconj a c (horder ha) (horder hc)) (e a (horder ha)) (e c (horder hc))
    (asCent a b) (asCent c d) (hcent_sq a b) (hcent_sq c d)
    (fun h ↦ hb (Subtype.ext h)) (fun h ↦ hd (Subtype.ext h))
    (fun h ↦ hab (Subtype.ext h)) (fun h ↦ hcd (Subtype.ext h)) habcd
  rw [f_of_ne hb a, f_of_ne hd c]
  exact label_invariant (e b (horder hb)) (e d (horder hd)) (asCent b a) (asCent d c) g hgb hga

end

/-- **Negative answer to Kourovka Problem 18.59.** There is no periodic group $G$ that contains an
involution, in which all involutions are conjugate, and for which there is an infinite locally
finite field $P$ of characteristic $2$ such that the centralizer of every involution $i$ of $G$ is
isomorphic to $\langle i \rangle \times \mathrm{PSL}_2(P)$. Here $\langle i \rangle$ is the cyclic
subgroup generated by $i$ and $\mathrm{PSL}_2(P)$ is the quotient of $\mathrm{SL}_2(P)$ by its
centre.

Muliarchyk's Theorem 3 proves more: no group, periodic or not, has a single nonempty conjugacy
class of involutions whose centralizers are isomorphic to $C_2 \times \mathrm{PSL}_2(P)$ for an
infinite locally finite field $P$ of characteristic $2$.

Source: E. I. Khukhro and V. D. Mazurov (eds.),
Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026),
Problem 18.59 (D. V. Lytkina); resolution: K. Muliarchyk, Involution centralizers and a linear
obstruction: Kourovka Problems 18.59 and 18.60, preprint, 2026, Theorem 3: no group has a single
nonempty conjugacy class of involutions with involution centralizers isomorphic to C_2 × PSL_2(P), P
an infinite locally finite field of characteristic two (periodicity not needed); the Kourovka
Notebook (21st issue) marks 18.59 solved,
https://kourovkanotebookorg.wordpress.com/wp-content/uploads/2026/09/kourovka_18_59-18_60_solution.pdf.
-/
theorem periodicGroupWithPSLInvolutionCentralizers_refuted :
    ¬ periodicGroupWithPSLInvolutionCentralizers := by
  rintro ⟨G, groupG, _, ⟨i, hi⟩, hconj, P, fieldP, charP, infiniteP, hP, hC⟩
  exact centralizer_obstruction hP hi hconj hC

end MathlibExt.GroupTheory.InvolutionCentralizerPSLTwoKourovka18Problem59Wanted
