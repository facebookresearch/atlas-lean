/-!
# Generators of abelian subgroups of finite p-groups (Kourovka Notebook Problem 20.75)

Kourovka Notebook, Problem 20.75 (L. Pyber), marked solved in the 21st issue: let `G` be a finite
`p`-group and assume that all abelian normal subgroups of `G` can be generated by `k` elements. Is
it true that every abelian subgroup of `G` can be generated by `2k` elements?

We prove `abelianSubgroupGeneratorsLeTwiceNormal_refuted` with a group of order $2^{665}$.
A counting argument gives a bilinear map on a 300-dimensional binary vector space whose
restriction to every 40-dimensional subspace fails to be symmetric. We use this map to form a
central extension of two copies of the space, then adjoin the involution interchanging them.
Each abelian normal subgroup has order at most $2^{143}$, while one coordinate subgroup
is elementary abelian of rank 300.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 20.75 (L. Pyber). UnsolvedMath record
UM-00701733 (`KOU-20.75`), dataset ulamai/UnsolvedMath v1.8.0.

Generated by `k` elements: the closure of a `Finset` of at most `k` elements. The question is stated
for all primes `p` and all `k`; abelian subgroups are written by pairwise commutation.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.AbelianNormalGeneratorsPGroupKourovka20Problem75Wanted

/-- **Pyber's question on generators of abelian subgroups (Kourovka 20.75).** The proposition that
for every prime $p$, every natural number $k$ and every finite $p$-group $G$, if every abelian
normal subgroup of $G$ can be generated by at most $k$ elements, then every abelian subgroup of $G$
can be generated by at most $2k$ elements. -/
def abelianSubgroupGeneratorsLeTwiceNormal : Prop :=
  ∀ (p k : ℕ) (G : Type) [Group G] [Finite G], p.Prime → IsPGroup p G →
    (∀ A : Subgroup G, A.Normal → (∀ x ∈ A, ∀ y ∈ A, x * y = y * x) →
      ∃ s : Finset G, s.card ≤ k ∧ Subgroup.closure (s : Set G) = A) →
    ∀ B : Subgroup G, (∀ x ∈ B, ∀ y ∈ B, x * y = y * x) →
      ∃ s : Finset G, s.card ≤ 2 * k ∧ Subgroup.closure (s : Set G) = B

private abbrev F := ZMod 2
private abbrev V := Fin 300 → F
private abbrev W := Fin 32 → F
private abbrev U := Fin 20 → F
private abbrev Form := V →ₗ[F] V →ₗ[F] W
private abbrev Block := U →ₗ[F] U →ₗ[F] W
private abbrev Frame := (U × U) →ₗ[F] V

-- On a 40-dimensional subspace, the off-diagonal block of the alternating part
-- of a bilinear map can take any value.
private def blockMap (e : Frame) : Form →ₗ[F] Block where
  toFun b := (b - b.flip).compl₁₂ (e.comp (.inl F U U)) (e.comp (.inr F U U))
  map_add' a b := by
    ext x y i
    simp
    abel
  map_smul' r b := by
    ext x y i
    simp [mul_sub]

private theorem blockMap_surjective (e : Frame) (he : Function.Injective e) :
    Function.Surjective (blockMap e) := by
  obtain ⟨l, hl⟩ := e.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr he)
  have h (x) : l (e x) = x := LinearMap.congr_fun hl x
  intro b
  refine ⟨b.compl₁₂ ((LinearMap.fst F U U).comp l) ((LinearMap.snd F U U).comp l), ?_⟩
  ext x y i
  simp [blockMap, h]

private theorem exists_form : ∃ b : Form, ∀ e : Frame, Function.Injective e → blockMap e b ≠ 0 := by
  classical
  by_contra! h
  choose e he hz using h
  -- Encode a form and an arbitrary block by the bad frame and a translated form.
  -- Applying the block map recovers the block, then subtraction recovers the form.
  let lift (f : Frame) (t : Block) := Function.invFun (blockMap f) t
  have hl (b : Form) (t : Block) : blockMap (e b) (lift (e b) t) = t :=
    Function.rightInverse_invFun (blockMap_surjective (e b) (he b)) t
  let encode (p : Form × Block) : Frame × Form := (e p.1, p.1 + lift (e p.1) p.2)
  have hinj : Function.Injective encode := by
    rintro ⟨a, s⟩ ⟨b, t⟩ hab
    obtain ⟨hf, hg⟩ := Prod.mk.inj hab
    change e a = e b at hf
    change a + lift (e a) s = b + lift (e b) t at hg
    have hs := congrArg (blockMap (e a)) hg
    rw [map_add, hz, hl, zero_add, hf, map_add, hz, hl, zero_add] at hs
    subst t
    rw [hf] at hg
    suffices a = b by rw [this]
    calc
      a = a + lift (e b) s - lift (e b) s := (add_sub_cancel_right a _).symm
      _ = b + lift (e b) s - lift (e b) s := congrArg (· - lift (e b) s) hg
      _ = b := add_sub_cancel_right b _
  have : Finite Form := Module.finite_of_finite F
  have : Finite Frame := Module.finite_of_finite F
  have hc := Nat.card_le_card_of_injective encode hinj
  rw [Nat.card_prod, Nat.card_prod, mul_comm (Nat.card Frame)] at hc
  have hle := Nat.le_of_mul_le_mul_left hc (Nat.card_pos (α := Form))
  rw [Module.natCard_eq_pow_finrank (K := F) (V := Block),
    Module.natCard_eq_pow_finrank (K := F) (V := Frame)] at hle
  simp only [Module.finrank_linearMap,
    Module.finrank_prod, Module.finrank_pi, Fintype.card_fin, Nat.card_zmod] at hle
  rw [Nat.pow_le_pow_iff_right (by decide : 1 < 2)] at hle
  omega

private theorem finrank_le_of_symmetric {b : Form}
    (hb : ∀ e : Frame, Function.Injective e → blockMap e b ≠ 0)
    (D : Submodule F V) (hD : ∀ x ∈ D, ∀ y ∈ D, b x y = b y x) :
    Module.finrank F D ≤ 39 := by
  by_contra! h
  have hr : Module.finrank F (U × U) ≤ Module.finrank F D := by
    simp only [Module.finrank_prod, Module.finrank_pi, Fintype.card_fin]
    omega
  obtain ⟨f, hf⟩ := finrank_le_iff_exists_linearMap.mp hr
  apply hb (D.subtype.comp f) (Subtype.val_injective.comp hf)
  apply LinearMap.ext₂
  intro x y
  exact sub_eq_zero.mpr (hD _ (f _).property _ (f _).property)

-- A central extension of V × V by W × W. The two central coordinates record
-- the same bilinear map with the roles of the two copies of V interchanged.
@[ext] private structure Base (b : Form) where
  x : V
  y : V
  z : W
  w : W

private def product {b : Form} (a c : Base b) : Base b :=
  ⟨a.x + c.x, a.y + c.y, a.z + c.z + b a.x c.y, a.w + c.w + b a.y c.x⟩

private def unit (b : Form) : Base b := ⟨0, 0, 0, 0⟩

private def inverse {b : Form} (a : Base b) : Base b :=
  ⟨-a.x, -a.y, -a.z + b a.x a.y, -a.w + b a.y a.x⟩

private instance instBaseGroup (b : Form) : Group (Base b) where
  one := unit b
  mul := product
  inv := inverse
  mul_assoc a c d := by
    change product (product a c) d = product a (product c d)
    apply Base.ext <;> simp [product, map_add] <;> abel
  one_mul a := by
    change product (unit b) a = a
    apply Base.ext <;> simp [unit, product]
  mul_one a := by
    change product a (unit b) = a
    apply Base.ext <;> simp [unit, product]
  inv_mul_cancel a := by
    change product (inverse a) a = unit b
    apply Base.ext <;> simp [unit, product, inverse]

private def baseEquiv (b : Form) : Base b ≃ (V × V) × W × W where
  toFun a := ((a.x, a.y), a.z, a.w)
  invFun p := ⟨p.1.1, p.1.2, p.2.1, p.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

private instance instBaseFinite (b : Form) : Finite (Base b) :=
  (baseEquiv b).finite_iff.mpr inferInstance

private def swap (b : Form) : MulAut (Base b) where
  toFun a := ⟨a.y, a.x, a.w, a.z⟩
  invFun a := ⟨a.y, a.x, a.w, a.z⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

private abbrev C := Multiplicative F

private def action (b : Form) : C →* MulAut (Base b) where
  toFun t := if t.toAdd = 0 then 1 else swap b
  map_one' := rfl
  map_mul' r s := by
    have cases₂ : ∀ x : F, x = 0 ∨ x = 1 := by decide
    change (if r.toAdd + s.toAdd = 0 then _ else _) = _
    rcases cases₂ r.toAdd with hr | hr <;> rcases cases₂ s.toAdd with hs | hs <;>
      simp [hr, hs, show (1 : F) + 1 = 0 by decide]
    rfl

private abbrev G (b : Form) := Base b ⋊[action b] C
private abbrev incl (b : Form) : Base b →* G b := SemidirectProduct.inl

private theorem isPGroup_two (b : Form) : IsPGroup 2 (G b) := by
  apply IsPGroup.of_card (n := 665)
  rw [SemidirectProduct.card, Nat.card_congr (baseEquiv b)]
  change Nat.card ((V × V) × W × W) * Nat.card F = _
  simp only [Nat.card_prod, Nat.card_fun, Nat.card_zmod, Nat.card_fin, ← pow_add]
  rw [pow_succ _ 664]

private def proj (b : Form) : Base b →* Multiplicative (V × V) where
  toFun a := .ofAdd (a.x, a.y)
  map_one' := rfl
  map_mul' _ _ := rfl

private abbrev basePart {b : Form} (A : Subgroup (G b)) := A.comap (incl b)

private def projected {b : Form} (A : Subgroup (G b)) : Submodule F (V × V) :=
  AddSubgroup.toZModSubmodule 2 (AddSubgroup.toSubgroup.symm ((basePart A).map (proj b)))

private def diag : V →ₗ[F] V × V := LinearMap.prod LinearMap.id LinearMap.id

private theorem swap_mem {b : Form} {A : Subgroup (G b)} (hn : A.Normal)
    {a : Base b} (ha : a ∈ basePart A) : swap b a ∈ basePart A := by
  let t : C := .ofAdd 1
  have ht : action b t = swap b := rfl
  change incl b (swap b a) ∈ A
  rw [← ht, SemidirectProduct.inl_aut, map_inv]
  exact hn.conj_mem _ ha _

private theorem mem_projected {b : Form} {A : Subgroup (G b)} {p : V × V} :
    p ∈ projected A ↔ ∃ a ∈ basePart A, a.x = p.1 ∧ a.y = p.2 := by
  change (∃ a ∈ basePart A, (a.x, a.y) = p) ↔ _
  simp [Prod.ext_iff]

-- If the projection S of the base part is invariant under swapping the factors,
-- the sum map (x,y) ↦ x+y takes values on its diagonal D. Its kernel also embeds in D.
private theorem finrank_le_twice_diagonal (S : Submodule F (V × V))
    (hs : ∀ p ∈ S, Prod.swap p ∈ S) :
    Module.finrank F S ≤ 2 * Module.finrank F (S.comap diag) := by
  let D := S.comap diag
  let f : S →ₗ[F] V := (LinearMap.fst F V V + LinearMap.snd F V V).domRestrict S
  have hr : LinearMap.range f ≤ D := by
    rintro _ ⟨p, rfl⟩
    change (p.val.1 + p.val.2, p.val.1 + p.val.2) ∈ S
    have hsum : (p.val.1 + p.val.2, p.val.2 + p.val.1) ∈ S := S.add_mem p.2 (hs _ p.2)
    rwa [add_comm p.val.2 p.val.1] at hsum
  have hk (p : LinearMap.ker f) : p.val.val.1 = p.val.val.2 := by
    funext i
    exact CharTwo.add_eq_zero.mp (congrFun (show p.val.val.1 + p.val.val.2 = 0 from p.2) i)
  let first : LinearMap.ker f →ₗ[F] V := (LinearMap.fst F V V).comp (S.subtype.comp f.ker.subtype)
  have hd (p) : first p ∈ D := by
    change (p.val.val.1, p.val.val.1) ∈ S
    rw [show (p.val.val.1, p.val.val.1) = p.val.val from Prod.ext rfl (hk p)]
    exact p.val.property
  have hi : Function.Injective (first.codRestrict D hd) := by
    intro p q hpq
    have hx : p.val.val.1 = q.val.val.1 := congrArg Subtype.val hpq
    exact Subtype.ext (Subtype.ext (Prod.ext hx ((hk p).symm.trans (hx.trans (hk q)))))
  have := (first.codRestrict D hd).finrank_le_finrank_of_injective hi
  have := Submodule.finrank_mono hr
  have := f.finrank_range_add_finrank_ker
  change Module.finrank F S ≤ 2 * Module.finrank F D
  omega

private theorem finrank_projected_le {b : Form}
    (hb : ∀ e : Frame, Function.Injective e → blockMap e b ≠ 0)
    (A : Subgroup (G b)) (hn : A.Normal) (ha : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) :
    Module.finrank F (projected A) ≤ 78 := by
  have hswap (p) (hp : p ∈ projected A) : Prod.swap p ∈ projected A := by
    obtain ⟨a, ha, hx, hy⟩ := mem_projected.mp hp
    exact mem_projected.mpr ⟨swap b a, swap_mem hn ha, hy, hx⟩
  have hd := finrank_le_of_symmetric hb ((projected A).comap diag) (by
    intro x hx y hy
    obtain ⟨a, hA, hax, hay⟩ := mem_projected.mp (show (x, x) ∈ projected A from hx)
    obtain ⟨c, hC, hcx, hcy⟩ := mem_projected.mp (show (y, y) ∈ projected A from hy)
    have hcomm := ha (incl b a) hA (incl b c) hC
    rw [← map_mul, ← map_mul] at hcomm
    have heq := congrArg Base.z (SemidirectProduct.inl_injective hcomm)
    change a.z + c.z + b a.x c.y = c.z + a.z + b c.x a.y at heq
    rw [add_comm c.z a.z, hax, hay, hcx, hcy] at heq
    exact add_left_cancel heq)
  exact (finrank_le_twice_diagonal _ hswap).trans (Nat.mul_le_mul_left 2 hd)

private theorem card_le_of_normal_abelian {b : Form}
    (hb : ∀ e : Frame, Function.Injective e → blockMap e b ≠ 0)
    (A : Subgroup (G b)) (hn : A.Normal) (ha : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) :
    Nat.card A ≤ 2 ^ 143 := by
  let encode (a : basePart A) : projected A × (W × W) :=
    (⟨(a.val.x, a.val.y), mem_projected.mpr ⟨a, a.2, rfl, rfl⟩⟩, a.val.z, a.val.w)
  have hi : Function.Injective encode := by
    intro a c h
    exact Subtype.ext (Base.ext
      (congrArg (fun p : projected A × (W × W) => p.1.val.1) h)
      (congrArg (fun p : projected A × (W × W) => p.1.val.2) h)
      (congrArg (fun p : projected A × (W × W) => p.2.1) h)
      (congrArg (fun p : projected A × (W × W) => p.2.2) h))
  have hbase := Nat.card_le_card_of_injective encode hi
  rw [Nat.card_prod, Nat.card_prod, Module.natCard_eq_pow_finrank (K := F) (V := projected A)]
    at hbase
  simp only [Nat.card_fun, Nat.card_fin, Nat.card_zmod, ← pow_add] at hbase
  have hd := finrank_projected_le hb A hn ha
  let r : A →* C := SemidirectProduct.rightHom.comp A.subtype
  have hr (a : r.ker) : a.val.val.right = 1 := a.2
  have hl (a : r.ker) : incl b a.val.val.left = a.val.val := SemidirectProduct.ext rfl (hr a).symm
  let left (a : r.ker) : basePart A := ⟨a.val.val.left, (hl a).symm ▸ a.val.property⟩
  have hk : Function.Injective left := by
    intro a c h
    have h' := congrArg (fun t : basePart A => incl b t.val) h
    exact Subtype.ext (Subtype.ext ((hl a).symm.trans (h'.trans (hl c))))
  calc
    Nat.card A = Nat.card r.ker * Nat.card r.range := (Subgroup.card_ker_mul_card_range r).symm
    _ ≤ Nat.card (basePart A) * Nat.card C :=
      Nat.mul_le_mul (Nat.card_le_card_of_injective left hk) r.range.card_le_card_group
    _ ≤ 2 ^ (Module.finrank F (projected A) + (32 + 32)) * 2 := by
      change Nat.card (basePart A) * Nat.card F ≤ _
      rw [Nat.card_zmod]
      exact Nat.mul_le_mul_right 2 hbase
    _ ≤ 2 ^ 143 := by
      rw [← pow_succ]
      exact Nat.pow_le_pow_right (by decide) (by omega)

-- Adjoining an element outside the current subgroup at least doubles its order.
private theorem exists_generators_of_card_le {H : Type*} [Group H] [Finite H] (A : Subgroup H)
    {k : ℕ} (hk : Nat.card A ≤ 2 ^ k) :
    ∃ s : Finset H, s.card ≤ k ∧ Subgroup.closure (s : Set H) = A := by
  classical
  let _ := Fintype.ofFinite H
  let candidates := Finset.univ.filter fun s : Finset H =>
    Subgroup.closure (s : Set H) ≤ A ∧ 2 ^ s.card ≤ Nat.card (Subgroup.closure (s : Set H))
  have hne : ∅ ∈ candidates := by simp [candidates]
  obtain ⟨s, hs, hmax⟩ := candidates.exists_max_image Finset.card ⟨∅, hne⟩
  obtain ⟨hle, hsize⟩ := (Finset.mem_filter.mp hs).2
  refine ⟨s, (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp
    (hsize.trans ((Subgroup.card_le_of_le hle).trans hk)), le_antisymm hle ?_⟩
  by_contra h
  obtain ⟨x, hx, hx'⟩ := Set.not_subset.mp h
  let K := Subgroup.closure (s : Set H)
  let L := Subgroup.closure ((insert x s : Finset H) : Set H)
  have hKL : K ≤ L := Subgroup.closure_mono (by simp [Finset.coe_insert])
  have hxL : x ∈ L := Subgroup.subset_closure (by simp)
  have hn : ¬ L ≤ K := fun hLK => hx' (hLK hxL)
  have hcard := K.relIndex_mul_card (K := L)
  rw [inf_eq_left.mpr hKL] at hcard
  have hi : 2 ≤ K.relIndex L := by
    have hpos := Nat.card_pos (α := L)
    rw [← hcard, Nat.mul_pos_iff_of_pos_right Nat.card_pos] at hpos
    have := mt Subgroup.relIndex_eq_one.mp hn
    omega
  have hxnot : x ∉ s := fun hxs => hx' (Subgroup.subset_closure hxs)
  have hnew : insert x s ∈ candidates := by
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_, ?_⟩
    · apply (Subgroup.closure_le _).mpr
      rw [Finset.coe_insert]
      exact Set.insert_subset hx (Subgroup.subset_closure.trans hle)
    · rw [Finset.card_insert_of_notMem hxnot, pow_succ']
      exact (Nat.mul_le_mul hi hsize).trans_eq hcard
  have := hmax _ hnew
  rw [Finset.card_insert_of_notMem hxnot] at this
  omega

private def axis (b : Form) : Multiplicative V →* Base b where
  toFun v := ⟨v.toAdd, 0, 0, 0⟩
  map_one' := rfl
  map_mul' v w := by
    change Base.mk (v.toAdd + w.toAdd) 0 0 0 = product _ _
    apply Base.ext <;> simp [product]

private abbrev embed (b : Form) := (incl b).comp (axis b)

private theorem le_card_axis_generators {b : Form} (s : Finset (G b))
    (hs : Subgroup.closure (s : Set (G b)) = (embed b).range) : 300 ≤ s.card := by
  classical
  let t := s.image (fun g => g.left.x)
  let S := Submodule.span F (t : Set V)
  have hr : (embed b).range ≤ S.toAddSubgroup.toSubgroup.map (embed b) := by
    rw [← hs, Subgroup.closure_le]
    intro g hg
    obtain ⟨v, rfl⟩ := hs ▸ Subgroup.subset_closure hg
    refine ⟨v, ?_, rfl⟩
    change v.toAdd ∈ S
    exact Submodule.subset_span (Finset.mem_image_of_mem (fun g : G b => g.left.x) hg)
  have htop : S = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨v, hv, heq⟩ := hr (show embed b (.ofAdd x) ∈ (embed b).range from ⟨_, rfl⟩)
    have he : v.toAdd = x := congrArg (fun g : G b => g.left.x) heq
    exact he ▸ (show v.toAdd ∈ S from hv)
  calc
    300 = Module.finrank F S := by rw [htop, finrank_top, Module.finrank_pi, Fintype.card_fin]
    _ ≤ t.card := finrank_span_finset_le_card t
    _ ≤ s.card := Finset.card_image_le

/-- **Kourovka Problem 20.75 has a negative answer.** The statement of Kourovka Problem 20.75 is
false: there are a prime $p$, a natural number $k$, a finite $p$-group $G$ all of whose abelian
normal subgroups can be generated by at most $k$ elements, and an abelian subgroup of $G$ that
cannot be generated by at most $2k$ elements.

Muliarchyk's counterexample (Theorem 1.1) is a finite $2$-group of order $2^{110N+1}$, with
$N = 2124210350$, whose abelian normal subgroups can be generated by $32N + 1$ elements while an
elementary abelian subgroup needs $65N > 2(32N + 1)$ generators; the 21st issue of the Kourovka
Notebook marks 20.75 solved ("No, it is not").

Source: E. I. Khukhro and V. D. Mazurov (eds.),
Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026),
Problem 20.75 (L. Pyber); resolution: K. Muliarchyk, An explicit counterexample to Kourovka Notebook
Problem 20.75, preprint (2026), Kourovka Notebook site, Theorem 1.1: for N = 2124210350 an
explicitly specified finite 2-group of order 2^(110N+1) in which every abelian normal subgroup can
be generated by at most 32N + 1 elements and some elementary abelian subgroup needs 65N generators;
Kourovka Notebook (21st issue), Problem 20.75: No, it is not,
https://kourovkanotebookorg.wordpress.com/wp-content/uploads/2026/09/kourovka_20.75_solution.pdf.
-/
theorem abelianSubgroupGeneratorsLeTwiceNormal_refuted :
    ¬ abelianSubgroupGeneratorsLeTwiceNormal := by
  obtain ⟨b, hb⟩ := exists_form
  have : Finite (G b) := SemidirectProduct.equivProd.finite_iff.mpr inferInstance
  intro h
  obtain ⟨s, hs, heq⟩ := h 2 143 (G b) Nat.prime_two (isPGroup_two b)
    (fun A hn ha => exists_generators_of_card_le A (card_le_of_normal_abelian hb A hn ha))
    (embed b).range (by
      rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
      rw [← map_mul, ← map_mul, mul_comm u v])
  have := le_card_axis_generators s heq
  omega

end MathlibExt.GroupTheory.AbelianNormalGeneratorsPGroupKourovka20Problem75Wanted
