/-!
# A counterexample to Kourovka Problem 19.67

A solvable group acts on the subsets of the eight-point affine space over `ZMod 2` by
translations of the Boolean cube and affine coordinate permutations with cyclic linear part.
Its 2-closure permits every affine coordinate permutation and has `PSL(3, 2)` as a quotient.

## Record from the retired wanted module

`WantedExt/GroupTheory/TwoClosureSolvableCompositionFactorsKourovka19Problem67Wanted.lean`

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.67 (I.
Ponomarenko). UnsolvedMath record UM-00701615 (`KOU-19.67`), dataset ulamai/UnsolvedMath v1.8.0.

`G⁽²⁾` is the set of permutations mapping every pair `(α, β)` into its `G`-orbit (written as the
subgroup it generates, which it already is). A composition factor of `G⁽²⁾` is a simple group onto
which a subnormal subgroup maps; "alternating" means isomorphic to some `alternatingGroup (Fin n)`.
`IsCompositionFactor` is the shared definition in
`MathlibExt/GroupTheory/KourovkaCompositionFactor.lean`.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.TwoClosureSolvableCompositionFactorsKourovka19Problem67Wanted

open MathlibExt.GroupTheory.KourovkaNotebookShared

/-- **The $2$-closure of a permutation group.** For a subgroup $G$ of the symmetric group
$\mathrm{Sym}(\Omega)$, the $2$-closure $G^{(2)}$ of $G$ is the subgroup of $\mathrm{Sym}(\Omega)$
generated by the permutations $\sigma$ that map every pair of points into its $G$-orbit, that is,
such that for all $\alpha, \beta \in \Omega$ there is $g \in G$ with $g(\alpha) = \sigma(\alpha)$
and $g(\beta) = \sigma(\beta)$.

These permutations already form a subgroup: the largest subgroup of $\mathrm{Sym}(\Omega)$
containing $G$ with the same orbits as $G$ on $\Omega \times \Omega$. -/
def twoClosure {Ω : Type*} (G : Subgroup (Equiv.Perm Ω)) : Subgroup (Equiv.Perm Ω) :=
  Subgroup.closure {σ | ∀ a b : Ω, ∃ g ∈ G, g a = σ a ∧ g b = σ b}

/-- **Kourovka Problem 19.67.** The statement that for every finite set $\Omega$ and every
solvable subgroup $G$ of the symmetric group $\mathrm{Sym}(\Omega)$, every composition factor of
the $2$-closure $G^{(2)}$ of $G$ is cyclic or isomorphic to the alternating group $A_n$ for some
natural number $n$. -/
def solvableTwoClosureFactorsCyclicOrAlternating : Prop :=
  ∀ (Ω : Type) [Finite Ω] (G : Subgroup (Equiv.Perm Ω)), Group.IsSolvable G →
    ∀ (S : Type) [Group S], IsCompositionFactor S (twoClosure G) →
      IsCyclic S ∨ ∃ n : ℕ, Nonempty (S ≃* alternatingGroup (Fin n))

open Finset
open scoped symmDiff

private abbrev V := Fin 3 → ZMod 2
private abbrev Cube := Finset V
private abbrev Linear := V ≃ₗ[ZMod 2] V
private abbrev Affine := V ≃ᵃ[ZMod 2] V

/- The companion map of the irreducible polynomial `X³ + X + 1` over `ZMod 2`. -/
private def singer : Linear where
  toFun x := ![x 2, x 0 + x 2, x 1]
  invFun x := ![x 1 - x 0, x 2, x 0]
  left_inv x := by ext i; fin_cases i <;> simp
  right_inv x := by ext i; fin_cases i <;> simp
  map_add' x y := by ext i; fin_cases i <;> simp [add_add_add_comm]
  map_smul' a x := by ext i; fin_cases i <;> simp [mul_add]

private def affine (b : V) (l : Linear) : Affine :=
  AffineEquiv.constVAdd (ZMod 2) V b * l.toAffineEquiv

private theorem affine_apply (b : V) (l : Linear) (x : V) : affine b l x = b + l x := rfl

private theorem affine_linear (q : Affine) (x : V) : q x = q 0 + q.linear x := by
  simpa [add_comm] using q.map_vadd 0 x

private def plane (s : Cube) : Prop := s.card = 4 ∧ ∑ x ∈ s, x = 0

private instance planeDecidable (s : Cube) : Decidable (plane s) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem two_nsmul_v (x : V) : 2 • x = 0 := by
  ext i
  change 2 • x i = 0
  rw [nsmul_eq_mul, show ((2 : ℕ) : ZMod 2) = 0 by decide, zero_mul]

private theorem plane_map (q : Affine) (s : Cube) :
    plane (s.map q.toEquiv.toEmbedding) ↔ plane s := by
  simp only [plane, card_map, sum_map]
  refine and_congr_right fun hs ↦ ?_
  change (∑ x ∈ s, q x) = 0 ↔ _
  have h : (fun x : V ↦ q x) = (fun x ↦ q 0 + q.linear x) := funext (affine_linear q)
  rw [Finset.sum_congr rfl (fun x _ ↦ congrFun h x)]
  simp only [sum_add_distrib, sum_const, hs]
  rw [← map_sum q.linear]
  rw [show (4 : ℕ) = 2 + 2 by decide, add_nsmul, two_nsmul_v, zero_add, zero_add]
  exact map_eq_zero_iff q.linear q.linear.injective

private def vec (n : Fin 8) : V :=
  ![↑(n.val % 2), ↑(n.val / 2 % 2), ↑(n.val / 4)]

private def orbitRepresentative (s : Cube) : Cube :=
  match s.card with
  | 0 => ∅
  | 1 => {vec 0}
  | 2 => {vec 0, vec 1}
  | 3 => {vec 0, vec 1, vec 2}
  | 4 => if plane s then {vec 0, vec 1, vec 2, vec 3} else {vec 0, vec 1, vec 2, vec 4}
  | 5 => {vec 0, vec 1, vec 2}ᶜ
  | 6 => {vec 0, vec 1}ᶜ
  | 7 => {vec 0}ᶜ
  | _ => univ

/- Every subset can be moved to its designated representative by one of 56 affine maps. -/
set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
-- Kernel reduction checks the affine orbits of all 256 subsets.
private theorem map_orbitRepresentative : ∀ s : Cube, ∃ (n : Fin 7) (b : V),
    s.map (affine b (singer ^ n.val)).toEquiv.toEmbedding = orbitRepresentative s := by
  decide +kernel

private def flip (t : Cube) : Equiv.Perm Cube :=
  (symmDiff_right_involutive t).toPerm _

private def liftPerm (t : Cube) (p : Equiv.Perm V) : Equiv.Perm Cube :=
  flip t * p.finsetCongr

private theorem liftPerm_apply (t : Cube) (p : Equiv.Perm V) (s : Cube) :
    liftPerm t p s = t ∆ s.map p.toEmbedding := rfl

private theorem map_symmDiff (p : Equiv.Perm V) (s t : Cube) :
    (s ∆ t).map p.toEmbedding = s.map p.toEmbedding ∆ t.map p.toEmbedding := by
  simp [Finset.symmDiff_def, map_union, Finset.map_sdiff]

private theorem liftPerm_mul (t u : Cube) (p q : Equiv.Perm V) :
    liftPerm t p * liftPerm u q = liftPerm (t ∆ u.map p.toEmbedding) (p * q) := by
  ext s : 1
  simp only [Equiv.Perm.mul_apply, liftPerm_apply, map_symmDiff, Finset.map_map,
    symmDiff_assoc]
  rfl

private theorem liftPerm_one : liftPerm ∅ (1 : Equiv.Perm V) = 1 := by
  ext s : 1
  simp [liftPerm_apply, Equiv.Perm.one_def, ← Finset.bot_eq_empty]

private theorem liftPerm_inj {t u : Cube} {p q : Equiv.Perm V}
    (h : liftPerm t p = liftPerm u q) : t = u ∧ p = q := by
  have ht := Equiv.congr_fun h ∅
  simp only [liftPerm_apply, map_empty] at ht
  change t ∆ (⊥ : Cube) = u ∆ (⊥ : Cube) at ht
  simp only [symmDiff_bot] at ht
  subst u
  refine ⟨rfl, Equiv.ext fun x ↦ ?_⟩
  have hx := Equiv.congr_fun h {x}
  simpa only [liftPerm_apply, (symmDiff_right_injective t).eq_iff, map_singleton,
    singleton_inj, Equiv.toEmbedding_apply] using hx

private def liftAffine (t : Cube) (q : Affine) : Equiv.Perm Cube :=
  liftPerm t q.toEquiv

private theorem liftAffine_mul (t u : Cube) (p q : Affine) :
    liftAffine t p * liftAffine u q = liftAffine (t ∆ u.map p.toEquiv.toEmbedding) (p * q) :=
  liftPerm_mul t u p.toEquiv q.toEquiv

private theorem liftAffine_one : liftAffine ∅ 1 = 1 := liftPerm_one

private theorem liftAffine_inj {t u : Cube} {p q : Affine}
    (h : liftAffine t p = liftAffine u q) : t = u ∧ p = q := by
  obtain ⟨ht, hp⟩ := liftPerm_inj h
  exact ⟨ht, AffineEquiv.ext fun x ↦ Equiv.congr_fun hp x⟩

private def cubeSubgroup (P : Subgroup Affine) : Subgroup (Equiv.Perm Cube) where
  carrier := {σ | ∃ (t : Cube) (q : Affine), q ∈ P ∧ liftAffine t q = σ}
  one_mem' := ⟨∅, 1, P.one_mem, liftAffine_one⟩
  mul_mem' := by
    rintro _ _ ⟨t, p, hp, rfl⟩ ⟨u, q, hq, rfl⟩
    exact ⟨_, p * q, P.mul_mem hp hq, (liftAffine_mul t u p q).symm⟩
  inv_mem' := by
    rintro _ ⟨t, p, hp, rfl⟩
    refine ⟨t.map p.symm.toEquiv.toEmbedding, p⁻¹, P.inv_mem hp, ?_⟩
    apply eq_inv_of_mul_eq_one_left
    rw [liftAffine_mul, inv_mul_cancel]
    have h : p⁻¹.toEquiv.toEmbedding = p.symm.toEquiv.toEmbedding := rfl
    rw [h, symmDiff_self]
    exact liftAffine_one

private noncomputable def chosenAffine {P : Subgroup Affine} (a : cubeSubgroup P) : P :=
  ⟨a.property.choose_spec.choose, a.property.choose_spec.choose_spec.1⟩

private theorem cube_decomp {P : Subgroup Affine} (a : cubeSubgroup P) :
    liftAffine (a.val ∅) (chosenAffine a).val = a.val := by
  have h : liftAffine a.property.choose (chosenAffine a).val = a.val :=
    a.property.choose_spec.choose_spec.2
  have ht := Equiv.congr_fun h ∅
  change liftPerm a.property.choose _ ∅ = a.val ∅ at ht
  simp only [liftPerm_apply, map_empty] at ht
  change _ ∆ (⊥ : Cube) = _ at ht
  simp only [symmDiff_bot] at ht
  exact ht ▸ h

private noncomputable def cubeCoord (P : Subgroup Affine) : cubeSubgroup P →* P where
  toFun := chosenAffine
  map_one' := by
    apply Subtype.ext
    exact (liftAffine_inj ((cube_decomp (1 : cubeSubgroup P)).trans liftAffine_one.symm)).2
  map_mul' a b := by
    apply Subtype.ext
    have h := congrArg₂ (· * ·) (cube_decomp a) (cube_decomp b)
    rw [liftAffine_mul] at h
    exact (liftAffine_inj ((cube_decomp (a * b)).trans h.symm)).2

private theorem cubeCoord_lift (P : Subgroup Affine) (t : Cube) (q : P) :
    cubeCoord P ⟨liftAffine t q.val, t, q.val, q.property, rfl⟩ = q :=
  Subtype.ext (liftAffine_inj
    (cube_decomp (⟨liftAffine t q.val, t, q.val, q.property, rfl⟩ : cubeSubgroup P))).2

private theorem cubeSubgroup_solvable (P : Subgroup Affine) [Group.IsSolvable P] :
    Group.IsSolvable (cubeSubgroup P) := by
  let g := cubeCoord P
  have : Group.IsSolvable g.ker := by
    apply Group.isSolvable_of_comm
    intro a b
    apply Subtype.ext
    apply Subtype.ext
    have ha := cube_decomp a.val
    have hb := cube_decomp b.val
    change liftAffine (a.val.val ∅) (g a.val).val = _ at ha
    change liftAffine (b.val.val ∅) (g b.val).val = _ at hb
    rw [MonoidHom.mem_ker.mp a.property] at ha
    rw [MonoidHom.mem_ker.mp b.property] at hb
    change a.val.val * b.val.val = b.val.val * a.val.val
    rw [← ha, ← hb, liftAffine_mul, liftAffine_mul]
    change liftAffine (_ ∆ Finset.map ((1 : Affine).toEquiv.toEmbedding) _) (1 * 1) =
      liftAffine (_ ∆ Finset.map ((1 : Affine).toEquiv.toEmbedding) _) (1 * 1)
    rw [one_mul]
    have hone (s : Cube) : s.map ((1 : Affine).toEquiv.toEmbedding) = s :=
      Finset.map_refl
    simp only [hone, symmDiff_comm]
  apply Group.isSolvable_of_ker_le_range g.ker.subtype g
  exact fun a ha ↦ ⟨⟨a, ha⟩, rfl⟩

private def smallAffine : Subgroup Affine :=
  (Subgroup.zpowers singer).comap AffineEquiv.linearHom

private theorem smallAffine_solvable : Group.IsSolvable smallAffine := by
  let f : Multiplicative V →* smallAffine := MonoidHom.codRestrict
    (AffineEquiv.constVAddHom (ZMod 2) V) smallAffine (fun _ ↦ (Subgroup.zpowers singer).one_mem)
  let g : smallAffine →* Subgroup.zpowers singer := MonoidHom.codRestrict
    (AffineEquiv.linearHom.comp smallAffine.subtype) _ Subtype.property
  apply Group.isSolvable_of_ker_le_range f g
  intro q hq
  have hlinear : q.val.linear = 1 := congrArg Subtype.val (MonoidHom.mem_ker.mp hq)
  refine ⟨Multiplicative.ofAdd (q.val 0), Subtype.ext (AffineEquiv.ext fun x ↦ ?_)⟩
  change q.val 0 + x = q.val x
  exact ((affine_linear q.val x).trans (congrArg (fun l : Linear ↦ q.val 0 + l x) hlinear)).symm

private theorem liftPerm_diff (t : Cube) (p : Equiv.Perm V) (x y : Cube) :
    liftPerm t p x ∆ liftPerm t p y = (x ∆ y).map p.toEmbedding := by
  rw [liftPerm_apply, liftPerm_apply, symmDiff_symmDiff_symmDiff_comm,
    symmDiff_self, bot_symmDiff, map_symmDiff]

private def pairOrbitalSubgroup {Ω : Type*} (G : Subgroup (Equiv.Perm Ω)) :
    Subgroup (Equiv.Perm Ω) where
  carrier := {σ | ∀ x y, ∃ g ∈ G, g x = σ x ∧ g y = σ y}
  one_mem' x y := ⟨1, G.one_mem, rfl, rfl⟩
  mul_mem' {a b} ha hb x y := by
    obtain ⟨g, hg, hgx, hgy⟩ := hb x y
    obtain ⟨f, hf, hfx, hfy⟩ := ha (b x) (b y)
    exact ⟨f * g, G.mul_mem hf hg, by simpa [Equiv.Perm.mul_apply, hgx] using hfx,
      by simpa [Equiv.Perm.mul_apply, hgy] using hfy⟩
  inv_mem' {a} ha x y := by
    obtain ⟨g, hg, hx, hy⟩ := ha (a⁻¹ x) (a⁻¹ y)
    exact ⟨g⁻¹, G.inv_mem hg, g.symm_apply_eq.mpr (by simpa using hx.symm),
      g.symm_apply_eq.mpr (by simpa using hy.symm)⟩

/- Distances to the empty set and the singletons determine membership in a subset. -/
private theorem recover_coordinates (σ : Equiv.Perm Cube)
    (hσ : ∀ x y, (σ x ∆ σ y).card = (x ∆ y).card) :
    ∃ p : Equiv.Perm V, σ = liftPerm (σ ∅) p := by
  let f := flip (σ ∅) * σ
  have hf0 : f ∅ = ∅ := symmDiff_self _
  have hf (x y : Cube) : (f x ∆ f y).card = (x ∆ y).card := by
    change ((σ ∅ ∆ σ x) ∆ (σ ∅ ∆ σ y)).card = _
    rw [symmDiff_symmDiff_symmDiff_comm, symmDiff_self, bot_symmDiff]
    exact hσ x y
  have card_f (x : Cube) : (f x).card = x.card := by
    have h := hf x ∅
    rw [hf0] at h
    change (f x ∆ ⊥).card = (x ∆ ⊥).card at h
    simpa only [symmDiff_bot] using h
  have hs (i : V) : ∃ j, f {i} = {j} := Finset.card_eq_one.mp (by simp [card_f])
  let p : V → V := fun i ↦ (hs i).choose
  have hp (i : V) : f {i} = {p i} := (hs i).choose_spec
  have hpinj : Function.Injective p := fun i j h ↦ by
    have he := (hp i).trans ((congrArg (fun x : V ↦ ({x} : Cube)) h).trans (hp j).symm)
    exact Finset.singleton_inj.mp (f.injective he)
  let e : Equiv.Perm V := Equiv.ofBijective p (Finite.injective_iff_bijective.mp hpinj)
  have distance_singleton (s : Cube) (x : V) :
      x ∈ s ↔ (s ∆ {x}).card < s.card := by
    by_cases h : x ∈ s
    · have hsub : ({x} : Cube) ⊆ s := Finset.singleton_subset_iff.mpr h
      rw [symmDiff_of_ge (α := Cube) hsub, card_sdiff_of_subset hsub, card_singleton]
      exact iff_of_true h (by have := card_pos.mpr (⟨x, h⟩ : s.Nonempty); omega)
    · have hd : Disjoint s {x} := Finset.disjoint_singleton_right.mpr h
      rw [Finset.symmDiff_eq_union hd, union_comm, singleton_union, card_insert_of_notMem h]
      exact iff_of_false h (by omega)
  have hmap (s : Cube) : f s = s.map e.toEmbedding := by
    ext j
    obtain ⟨i, rfl⟩ := e.surjective j
    rw [Finset.mem_map_equiv, e.symm_apply_apply, distance_singleton s i,
      distance_singleton (f s) (e i), card_f]
    change (f s ∆ {p i}).card < s.card ↔ _
    rw [← hp i, hf]
  refine ⟨e, Equiv.ext fun s ↦ ?_⟩
  rw [liftPerm_apply, ← hmap]
  exact (symmDiff_symmDiff_cancel_left _ _).symm

private theorem add_self_zero (x : V) : x + x = 0 := by
  simpa only [two_nsmul] using two_nsmul_v x

/- A zero-sum four-set determines the fourth point from the other three. -/
private theorem recover_affine (p : Equiv.Perm V)
    (hp : ∀ s : Cube, plane s → plane (s.map p.toEmbedding)) :
    ∃ q : Affine, q.toEquiv = p := by
  let l : V → V := fun x ↦ p x - p 0
  have hl0 : l 0 = 0 := sub_self _
  have hladd : ∀ x y, l (x + y) = l x + l y := by
    intro x y
    rcases eq_or_ne x 0 with rfl | hx
    · rw [zero_add, hl0, zero_add]
    rcases eq_or_ne y 0 with rfl | hy
    · rw [add_zero, hl0, add_zero]
    rcases eq_or_ne x y with rfl | hxy
    · rw [add_self_zero, hl0, add_self_zero]
    have hsum : x + y ≠ 0 := by
      intro h
      apply hxy
      calc
        x = x + (y + y) := by rw [add_self_zero, add_zero]
        _ = y := by rw [← add_assoc, h, zero_add]
    have hxs : x + y ≠ x := fun h ↦ hy (add_left_cancel (h.trans (add_zero x).symm))
    have hys : x + y ≠ y := fun h ↦ hx (add_right_cancel (h.trans (zero_add y).symm))
    let s : Cube := {x, y, x + y, 0}
    have hs : plane s := by
      have htotal : x + (y + (x + y + 0)) = 0 := by
        rw [add_zero, ← add_assoc, add_self_zero]
      exact ⟨by simp [s, card_insert_of_notMem, hxy, hx, hy, hxs.symm, hys.symm, hsum],
        by simpa [s, sum_insert, hxy, hx, hy, hxs.symm, hys.symm, hsum] using htotal⟩
    have h := (hp s hs).2
    simp only [s, Finset.map_insert, Finset.map_singleton, Equiv.toEmbedding_apply] at h
    have hpne {a b : V} (hab : a ≠ b) : p a ≠ p b := fun e ↦ hab (p.injective e)
    have hzero : p x + (p y + (p (x + y) + p 0)) = 0 := by
      simpa [sum_insert, hpne hxy, hpne hx, hpne hy, hpne hxs.symm, hpne hys.symm, hpne hsum]
        using h
    have hneg (z : V) : -z = z := neg_eq_of_add_eq_zero_left (add_self_zero z)
    have hpadd : p (x + y) + p 0 = p x + p y := by
      have h' : p (x + y) + p 0 + (p x + p y) = 0 := by convert hzero using 1; abel
      exact (eq_neg_of_add_eq_zero_left h').trans (hneg _)
    dsimp [l]
    simp only [sub_eq_add_neg, hneg]
    rw [hpadd]
    rw [add_add_add_comm (p x) (p 0) (p y) (p 0), add_self_zero, add_zero]
  have hlsmul (a : ZMod 2) (x : V) : l (a • x) = a • l x := by
    have ha : a = 0 ∨ a = 1 := (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a
    rcases ha with rfl | rfl <;> simp [hl0]
  let L : V →ₗ[ZMod 2] V := ⟨⟨l, hladd⟩, hlsmul⟩
  have hL : Function.Bijective L := by
    change Function.Bijective l
    exact (Equiv.subRight (p 0)).bijective.comp p.bijective
  refine ⟨affine (p 0) (LinearEquiv.ofBijective L hL), Equiv.ext fun x ↦ ?_⟩
  change p 0 + (p x - p 0) = p x
  abel

private def smallCube : Subgroup (Equiv.Perm Cube) := cubeSubgroup smallAffine

private def fullCube : Subgroup (Equiv.Perm Cube) := cubeSubgroup ⊤

private theorem orbitRepresentative_map (q : Affine) (s : Cube) :
    orbitRepresentative (s.map q.toEquiv.toEmbedding) = orbitRepresentative s := by
  simp only [orbitRepresentative, card_map, plane_map]

private theorem orbit_match (q : Affine) (s : Cube) :
    ∃ r : Affine, r ∈ smallAffine ∧ s.map r.toEquiv.toEmbedding = s.map q.toEquiv.toEmbedding := by
  obtain ⟨i, a, ha⟩ := map_orbitRepresentative s
  obtain ⟨j, b, hb⟩ := map_orbitRepresentative (s.map q.toEquiv.toEmbedding)
  let r₁ := affine a (singer ^ i.val)
  let r₂ := affine b (singer ^ j.val)
  have hr₁ : r₁ ∈ smallAffine := Subgroup.npow_mem_zpowers singer i.val
  have hr₂ : r₂ ∈ smallAffine := Subgroup.npow_mem_zpowers singer j.val
  refine ⟨r₂⁻¹ * r₁, smallAffine.mul_mem (smallAffine.inv_mem hr₂) hr₁, ?_⟩
  change s.map (r₁.toEquiv.toEmbedding.trans r₂.symm.toEquiv.toEmbedding) = _
  rw [← map_map, ha, ← orbitRepresentative_map q s, ← hb, map_map]
  have he : (affine b (singer ^ j.val)).toEquiv.toEmbedding.trans
      r₂.symm.toEquiv.toEmbedding = Function.Embedding.refl V :=
    Function.Embedding.ext fun x ↦ r₂.symm_apply_apply x
  rw [he, map_refl]

private theorem pairOrbital_eq_fullCube : pairOrbitalSubgroup smallCube = fullCube := by
  apply le_antisymm
  · intro σ hσ
    change ∀ x y, ∃ g ∈ smallCube, g x = σ x ∧ g y = σ y at hσ
    have hdist (x y : Cube) : (σ x ∆ σ y).card = (x ∆ y).card := by
      obtain ⟨_, ⟨t, q, -, rfl⟩, hx, hy⟩ := hσ x y
      rw [← hx, ← hy]
      change (liftPerm t q.toEquiv x ∆ liftPerm t q.toEquiv y).card = _
      rw [liftPerm_diff, card_map]
    obtain ⟨p, hp⟩ := recover_coordinates σ hdist
    have hplanes (s : Cube) (hs : plane s) : plane (s.map p.toEmbedding) := by
      obtain ⟨_, ⟨t, q, -, rfl⟩, hx, hy⟩ := hσ ∅ s
      have h := congrArg₂ (· ∆ ·) hx hy
      change liftPerm t q.toEquiv ∅ ∆ liftPerm t q.toEquiv s = σ ∅ ∆ σ s at h
      rw [show σ ∅ ∆ σ s = liftPerm (σ ∅) p ∅ ∆ liftPerm (σ ∅) p s from
        congrArg (fun f : Equiv.Perm Cube ↦ f ∅ ∆ f s) hp, liftPerm_diff, liftPerm_diff] at h
      change (⊥ ∆ s).map q.toEquiv.toEmbedding = (⊥ ∆ s).map p.toEmbedding at h
      rw [bot_symmDiff] at h
      rw [← h, plane_map]
      exact hs
    obtain ⟨q, hq⟩ := recover_affine p hplanes
    refine ⟨σ ∅, q, trivial, ?_⟩
    change liftPerm (σ ∅) q.toEquiv = σ
    rw [hq, ← hp]
  · rintro σ ⟨t, q, -, rfl⟩ x y
    obtain ⟨r, hr, h⟩ := orbit_match q (x ∆ y)
    let u := liftAffine t q x ∆ x.map r.toEquiv.toEmbedding
    refine ⟨liftAffine u r, ⟨u, r, hr, rfl⟩, ?_, ?_⟩
    · change (liftAffine t q x ∆ x.map r.toEquiv.toEmbedding) ∆ x.map r.toEquiv.toEmbedding = _
      rw [symmDiff_symmDiff_cancel_right]
    · change (liftAffine t q x ∆ x.map r.toEquiv.toEmbedding) ∆ y.map r.toEquiv.toEmbedding = _
      rw [symmDiff_assoc, ← map_symmDiff, h, ← liftPerm_diff t q.toEquiv]
      exact symmDiff_symmDiff_cancel_left _ _

open Matrix Matrix.SpecialLinearGroup
open scoped MatrixGroups LinearAlgebra.Projectivization commutatorElement Pointwise

private abbrev SL3 := SL(3, ZMod 2)
private abbrev PSL3 := PSL(3, ZMod 2)

private theorem one_of_ne_zero (c : ZMod 2) : c ≠ 0 → c = 1 :=
  (by decide : ∀ c : ZMod 2, c ≠ 0 → c = 1) c

private theorem sl3_induction (P : Subgroup SL3)
    (h : ∀ (i j : Fin 3) (hij : i ≠ j) (a : ZMod 2), transvection hij a ∈ P) : P = ⊤ := by
  refine eq_top_iff.mpr fun g _ ↦ diagonal_transvection_induction' (· ∈ P) g ?_ h
    (fun _ _ ↦ P.mul_mem)
  intro i j hij c hc
  have he : (diag2n hij c hc : SL3) = 1 := by
    apply Subtype.ext
    simp [diag2n_coe, one_of_ne_zero c hc, Matrix.diagonal_one]
  rw [he]
  exact P.one_mem

/- Each elementary transvection is a commutator via a third coordinate. -/
private theorem sl3_perfect : commutator SL3 = ⊤ := by
  apply sl3_induction
  intro i j hij a
  obtain ⟨k, hki, hkj⟩ : ∃ k : Fin 3, k ≠ i ∧ k ≠ j := by
    fin_cases i <;> fin_cases j <;> first | contradiction | decide
  let A : SL3 := transvection hki.symm a
  let B : SL3 := transvection hkj 1
  let C : SL3 := transvection hij a
  have h : A * B = C * (B * A) := by
    apply Subtype.ext
    simp only [A, B, C, Matrix.SpecialLinearGroup.coe_mul, transvection_coe,
      add_mul, mul_add, one_mul, mul_one, single_mul_single_same,
      single_mul_single_of_ne _ _ _ _ hij.symm, single_mul_single_of_ne _ _ _ _ hkj.symm]
    abel
  have hcomm : ⁅A, B⁆ = C := by
    rw [commutatorElement_def, h]
    group
  change C ∈ commutator SL3
  rw [← hcomm]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

private theorem sl3_lineStab_generate :
    (⨆ p : ℙ (ZMod 2) V, lineStab p.submodule) = (⊤ : Subgroup SL3) := by
  apply sl3_induction
  intro i j hij a
  let p : ℙ (ZMod 2) V := Projectivization.mk _ (Pi.single i 1)
    (Pi.single_ne_zero_iff.2 one_ne_zero)
  apply le_iSup (fun p : ℙ (ZMod 2) V ↦ lineStab p.submodule) p
  simpa [p, Projectivization.submodule_mk] using SL2Gen.transvection_mem_lineStab hij a

private theorem psl3_simple : IsSimpleGroup PSL3 := by
  let π : SL3 →* PSL3 := QuotientGroup.mk' _
  have hπ : Function.Surjective π := QuotientGroup.mk'_surjective _
  have hperfect : commutator PSL3 = ⊤ := by
    rw [← map_commutator_of_surjective hπ, sl3_perfect,
      Subgroup.map_top_of_surjective _ hπ]
  let T (p : ℙ (ZMod 2) V) : Subgroup PSL3 := (lineStab p.submodule).map π
  let iw : MulAction.IwasawaStructure PSL3 (ℙ (ZMod 2) V) := {
    T := T
    is_comm := fun p ↦ by
      rw [← Projectivization.mk_rep p]
      change IsMulCommutative ((lineStab (Projectivization.mk (ZMod 2) p.rep
        p.rep_ne_zero).submodule).map π)
      rw [Projectivization.submodule_mk]
      have := lineStab_isMulCommutative_of_span (F := ZMod 2) p.rep
      exact Subgroup.map_isMulCommutative _ π
    is_conj := fun g p ↦ by
      obtain ⟨A, rfl⟩ := QuotientGroup.mk_surjective g
      change (lineStab ((QuotientGroup.mk A : PSL3) • p).submodule).map π = _
      rw [Matrix.ProjectiveSpecialLinearGroup.smul_proj_mk, PSL.smul_submodule,
        lineStab_smul, PSL.iwasawaT_map_conj]
    is_generator := by
      change (⨆ p : ℙ (ZMod 2) V, (lineStab p.submodule).map π) = ⊤
      rw [← Subgroup.map_iSup, sl3_lineStab_generate, Subgroup.map_top_of_surjective _ hπ] }
  exact iw.isSimpleGroup hperfect inferInstance

private noncomputable def sl3EquivLinear : SL3 ≃* Linear := by
  have hunit (u : (ZMod 2)ˣ) : u = 1 := Units.ext (one_of_ne_zero _ u.ne_zero)
  let f : SL3 ≃* Matrix.GeneralLinearGroup (Fin 3) (ZMod 2) :=
    MulEquiv.ofBijective toGL ⟨toGL_injective, fun g ↦ by
      have hd : Matrix.det (g : Matrix (Fin 3) (Fin 3) (ZMod 2)) = 1 :=
        congrArg Units.val (hunit (Matrix.GeneralLinearGroup.det g))
      exact ⟨⟨g, hd⟩, Units.ext rfl⟩⟩
  exact f.trans (Matrix.GeneralLinearGroup.toLin.trans
    (LinearMap.GeneralLinearGroup.generalLinearEquiv _ _))

private theorem sl3_center : Subgroup.center SL3 = ⊥ := by
  refine (Subgroup.eq_bot_iff_forall _).2 fun A hA ↦ ?_
  obtain ⟨r, hr, hA'⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hA
  have hr0 : r ≠ 0 := by
    intro h
    subst r
    simp at hr
  apply Subtype.ext
  simpa [one_of_ne_zero r hr0] using hA'.symm

private theorem psl3_card : Nat.card PSL3 = 168 := by
  let e : PSL3 ≃* SL3 := (QuotientGroup.quotientMulEquivOfEq sl3_center).trans
    QuotientGroup.quotientBot
  calc
    Nat.card PSL3 = Nat.card SL3 := Nat.card_congr e.toEquiv
    _ = 168 := by
      rw [Matrix.card_SL_field (𝔽 := ZMod 2) 3]
      norm_num [Fin.prod_univ_succ]

private theorem psl3_not_cyclic : ¬ IsCyclic PSL3 := by
  intro h
  have := IsCyclic.isMulCommutative (α := PSL3)
  have hprime := Group.is_simple_iff_prime_card.mp psl3_simple
  rw [psl3_card] at hprime
  exact (by norm_num : ¬ Nat.Prime 168) hprime

private theorem psl3_not_alternating (n : ℕ) : ¬ Nonempty (PSL3 ≃* alternatingGroup (Fin n)) := by
  rintro ⟨e⟩
  have h := (Nat.card_congr e.toEquiv).symm.trans psl3_card
  by_cases hn : 2 ≤ n
  · have : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
    have hfact := two_mul_nat_card_alternatingGroup (α := Fin n)
    rw [h, Nat.card_perm, Nat.card_fin] at hfact
    by_cases hn' : n ≤ 5
    · have hle : n.factorial ≤ 120 := Nat.factorial_le hn'
      omega
    · have hle : 720 ≤ n.factorial := Nat.factorial_le (show 6 ≤ n by omega)
      omega
  · have hn' : Nat.card (Fin n) ≤ 2 := by simpa using (show n ≤ 2 by omega)
    rw [alternatingGroup.eq_bot_of_card_le_two hn', Subgroup.card_bot] at h
    omega

private noncomputable def fullCube_to_psl3 : fullCube →* PSL3 :=
  (QuotientGroup.mk' _).comp (sl3EquivLinear.symm.toMonoidHom.comp
    (AffineEquiv.linearHom.comp ((⊤ : Subgroup Affine).subtype.comp (cubeCoord ⊤))))

private theorem fullCube_to_psl3_surjective : Function.Surjective fullCube_to_psl3 := by
  intro g
  obtain ⟨A, rfl⟩ := QuotientGroup.mk_surjective g
  let l := sl3EquivLinear A
  let q : (⊤ : Subgroup Affine) := ⟨l.toAffineEquiv, trivial⟩
  refine ⟨⟨liftAffine ∅ q.val, ∅, q.val, q.property, rfl⟩, ?_⟩
  change QuotientGroup.mk (sl3EquivLinear.symm
    (AffineEquiv.linearHom (cubeCoord ⊤ ⟨liftAffine ∅ q.val, ∅, q.val, q.property, rfl⟩).val)) = _
  rw [cubeCoord_lift]
  exact congrArg QuotientGroup.mk (sl3EquivLinear.symm_apply_apply A)


/--
**Skresanov's counterexample to Kourovka Problem 19.67.** There exist a finite set $\Omega$, a
solvable subgroup $G$ of the symmetric group $\mathrm{Sym}(\Omega)$, and a composition factor $S$
of the $2$-closure $G^{(2)}$ of $G$ such that $S$ is not cyclic and $S$ is not isomorphic to the
alternating group $A_n$ for any $n$. Here $G^{(2)}$ is the subgroup of $\mathrm{Sym}(\Omega)$
generated by the permutations $\sigma$ such that for all $\alpha, \beta \in \Omega$ some $g \in G$
has $g(\alpha) = \sigma(\alpha)$ and $g(\beta) = \sigma(\beta)$, and a composition factor of
$G^{(2)}$ is a simple group onto which some subnormal subgroup of $G^{(2)}$ maps.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.67 (I.
Ponomarenko); resolution: S. V. Skresanov, Counterexamples to two conjectures in the Kourovka
notebook, Algebra Logic 58 (2019), no. 3, 249-253, abstract: counterexamples to Questions 12.78 and
19.67 of the Kourovka Notebook; Kourovka Archive, Problem 19.67: No, it is not true,
https://doi.org/10.1007/s10469-019-09543-1.
-/
theorem solvableTwoClosureFactorsCyclicOrAlternating_refuted :
    ¬ solvableTwoClosureFactorsCyclicOrAlternating := by
  intro h
  have hclosure : twoClosure smallCube = fullCube :=
    (Subgroup.closure_eq (K := pairOrbitalSubgroup smallCube)).trans pairOrbital_eq_fullCube
  have hquotient : IsCompositionFactor PSL3 fullCube :=
    ⟨psl3_simple, ⊤, Subgroup.IsSubnormal.top,
      fullCube_to_psl3.comp (Subgroup.topEquiv : (⊤ : Subgroup fullCube) ≃* fullCube).toMonoidHom,
      fullCube_to_psl3_surjective.comp Subgroup.topEquiv.surjective⟩
  have hfactor : IsCompositionFactor PSL3 (twoClosure smallCube) := hclosure ▸ hquotient
  have hsolvable : Group.IsSolvable smallAffine := smallAffine_solvable
  rcases h Cube smallCube (cubeSubgroup_solvable smallAffine) PSL3 hfactor with hc | ⟨n, e⟩
  · exact psl3_not_cyclic hc
  · exact psl3_not_alternating n e

end MathlibExt.GroupTheory.TwoClosureSolvableCompositionFactorsKourovka19Problem67Wanted
