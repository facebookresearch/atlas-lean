/-!
# Permutation characters and two-generation

Skresanov's counterexample to Strunkov's criterion (Kourovka Problem 12.79) uses a single
3-cycle in the alternating group on four letters. Its Strunkov function is the character of
a two-dimensional representation pulled back from the quotient by the Klein four subgroup.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 12.79 (S. P.
Strunkov). UnsolvedMath record UM-00700897 (`KOU-12.79`), dataset ulamai/UnsolvedMath v1.8.0.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.PermutationCharacterGenerationKourovka12Problem79Wanted

/-- **Complex permutation character on the cosets of a subgroup.** For a subgroup $H$ of a group
$G$, the permutation character $1_H^G : G \to \mathbb{C}$ sends $g \in G$ to the number of left
cosets $xH$ of $H$ with $gxH = xH$, and to $0$ when $g$ fixes infinitely many cosets. For finite
$G$ and the trivial subgroup $H = 1$ this is the regular character $1^G$. -/
noncomputable def permChar {G : Type*} [Group G] (H : Subgroup G) (g : G) : ℂ :=
  (Nat.card {q : G ⧸ H // g • q = q} : ℂ)

/-- **Strunkov's class function.** For elements $a, b$ of a group $G$, Strunkov's function
$\varphi : G \to \mathbb{C}$ is
$$\varphi = 1^G - 1_{\langle a \rangle}^G - 1_{\langle b \rangle}^G - 1_{\langle ab \rangle}^G + 2$$
where $1_H^G$ is the complex permutation character of $G$ on the cosets of a subgroup $H$,
$1^G = 1_1^G$ is the one for the trivial subgroup, $\langle x \rangle$ is the cyclic subgroup
generated by $x$, and $2$ is the constant function with value $2$. -/
noncomputable def strunkovFunction {G : Type*} [Group G] (a b : G) (g : G) : ℂ :=
  permChar ⊥ g - permChar (Subgroup.zpowers a) g - permChar (Subgroup.zpowers b) g -
    permChar (Subgroup.zpowers (a * b)) g + 2

/-- **Characters of a group.** A function $\varphi : G \to \mathbb{C}$ on a group $G$ is a
character of $G$ when there are a finite-dimensional complex vector space $V$ and a
representation $\rho$ of $G$ on $V$ whose character $g \mapsto \operatorname{tr} \rho(g)$ equals
$\varphi$. -/
def IsCharacter {G : Type} [Group G] (φ : G → ℂ) : Prop :=
  ∃ (V : Type) (_ : AddCommGroup V) (_ : Module ℂ V) (_ : FiniteDimensional ℂ V)
    (ρ : Representation ℂ G V), ρ.character = φ

/-- **Strunkov's two-generation criterion (Kourovka 12.79).** The assertion that for every finite
group $G$ and all $a, b \in G$, if Strunkov's class function
$1^G - 1_{\langle a \rangle}^G - 1_{\langle b \rangle}^G - 1_{\langle ab \rangle}^G + 2$ is a
character of $G$, then $a$ and $b$ generate $G$. Here $1_H^G$ is the permutation character of $G$
on the cosets of a subgroup $H$, $1^G = 1_1^G$, $\langle x \rangle$ is the cyclic subgroup
generated by $x$, and $2$ is the constant function with value $2$. -/
def strunkovCharacterImpliesGeneration : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (a b : G), IsCharacter (strunkovFunction a b) →
    Subgroup.closure {a, b} = ⊤

section Counterexample

private abbrev G := alternatingGroup (Fin 4)

private def a : G :=
  ⟨Equiv.swap 0 1 * Equiv.swap 1 2, by simp [Equiv.Perm.mem_alternatingGroup]⟩

private theorem cycle_order : orderOf a = 3 := orderOf_eq_prime (by decide) (by decide)

private abbrev H := MulAction.stabilizer G (3 : Fin 4)

private theorem zpowers_eq_stabilizer : Subgroup.zpowers a = H := by
  ext g
  rw [mem_zpowers_iff_mem_range_orderOf, cycle_order]
  exact (by decide : ∀ x : G, x ∈ (Finset.range 3).image (a ^ ·) ↔ x ∈ H) g

private theorem permChar_stabilizer {L X : Type*} [Group L] [MulAction L X] (x : X)
    (hx : ∀ y : X, ∃ l : L, l • x = y) (g : L) :
    permChar (MulAction.stabilizer L x) g = (Nat.card {y : X // g • y = y} : ℂ) := by
  let e := Equiv.ofBijective (MulAction.ofQuotientStabilizer L x)
    ⟨MulAction.injective_ofQuotientStabilizer L x, fun y => by
      obtain ⟨l, rfl⟩ := hx y
      exact ⟨QuotientGroup.mk l, rfl⟩⟩
  unfold permChar
  congr 1
  apply Nat.card_congr (e.subtypeEquiv _)
  intro q
  rw [← e.injective.eq_iff]
  rw [show e (g • q) = g • e q from MulAction.ofQuotientStabilizer_smul L x g q]

private theorem regular_value (g : G) :
    permChar ⊥ g = if g = 1 then 12 else 0 := by
  rw [← IsCancelSMul.stabilizer_eq_bot (G := G) (1 : G),
    permChar_stabilizer _ (fun y => ⟨y, mul_one y⟩), Nat.card_eq_fintype_card]
  have h : ∀ k : G, Fintype.card {x : G // k • x = x} = if k = 1 then 12 else 0 := by decide
  rw [h]
  split <;> norm_num

private theorem cyclic_value (g : G) :
    permChar (Subgroup.zpowers a) g = if g = 1 then 4 else if g ^ 2 = 1 then 0 else 1 := by
  have transitive : ∀ y : Fin 4, ∃ l : G, l • (3 : Fin 4) = y := by decide
  rw [zpowers_eq_stabilizer, permChar_stabilizer _ transitive, Nat.card_eq_fintype_card]
  have h : ∀ k : G, Fintype.card {x : Fin 4 // k • x = x} =
      if k = 1 then 4 else if k ^ 2 = 1 then 0 else 1 := by decide
  rw [h]
  split_ifs <;> norm_num

private abbrev K := alternatingGroup.kleinFour (Fin 4)
private abbrev C := Multiplicative (Fin 3)
private instance kleinFourNormal : K.Normal := alternatingGroup.normal_kleinFour (by simp)

private theorem card_quotient : Nat.card (G ⧸ K) = 3 := by
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup K
  rw [alternatingGroup.card_of_card_eq_four (by simp),
    alternatingGroup.kleinFour_card_of_card_eq_four (by simp)] at h
  change 12 = Nat.card (G ⧸ K) * 4 at h
  omega

private noncomputable def quotientEquiv : G ⧸ K ≃* C :=
  mulEquivOfPrimeCardEq card_quotient (by rw [Nat.card_eq_fintype_card]; decide)

-- The generator acts by a matrix with characteristic polynomial X² + X + 1.
private def matrices : C →* Matrix (Fin 2) (Fin 2) ℤ where
  toFun x := ![1, !![0, -1; 1, -1], !![-1, 1; -1, 0]] x.toAdd
  map_one' := rfl
  map_mul' := by decide

private noncomputable def cyclicRep : Representation ℂ C (Fin 2 → ℂ) :=
  Matrix.toLinAlgEquiv'.toMonoidHom.comp
    (((Int.castRingHom ℂ).mapMatrix).toMonoidHom.comp matrices)

private theorem cyclic_trace (c : C) : cyclicRep.character c = if c = 1 then 2 else -1 := by
  change LinearMap.trace ℂ _ (Matrix.toLin' _) = _
  rw [Matrix.trace_toLin'_eq]
  change ((matrices c).map (Int.castRingHom ℂ)).trace = _
  rw [← AddMonoidHom.map_trace]
  have h : ∀ i : C, (matrices i).trace = if i = 1 then 2 else -1 := by decide
  rw [h]
  split <;> norm_num

private theorem quotient_eq_one_iff (g : G) :
    quotientEquiv (QuotientGroup.mk' K g) = 1 ↔ g ^ 2 = 1 := by
  rw [map_eq_one_iff _ quotientEquiv.injective]
  constructor
  · intro hg
    have hmem := (QuotientGroup.eq_one_iff g).mp hg
    have h := Monoid.pow_exponent_eq_one (⟨g, hmem⟩ : K)
    rw [alternatingGroup.exponent_kleinFour_of_card_eq_four (by simp)] at h
    exact congrArg Subtype.val h
  · intro hg
    let q := QuotientGroup.mk' K
    have h₂ : q g ^ 2 = 1 := by rw [← map_pow, hg, map_one]
    have h₃ : q g ^ 3 = 1 := card_quotient ▸ pow_card_eq_one'
    simpa only [pow_succ (q g) 2, h₂, one_mul] using h₃

private theorem strunkov_isCharacter : IsCharacter (strunkovFunction a a) := by
  let π := quotientEquiv.toMonoidHom.comp (QuotientGroup.mk' K)
  refine ⟨Fin 2 → ℂ, inferInstance, inferInstance, inferInstance, cyclicRep.comp π, ?_⟩
  funext g
  change cyclicRep.character (quotientEquiv (QuotientGroup.mk' K g)) = _
  have haa : a * a = a⁻¹ := by decide
  simp only [cyclic_trace, quotient_eq_one_iff, strunkovFunction, haa, Subgroup.zpowers_inv,
    cyclic_value, regular_value]
  by_cases hg : g = 1
  · subst g
    norm_num
  · by_cases hs : g ^ 2 = 1 <;> norm_num [hg, hs]

end Counterexample

/-- **Strunkov's two-generation criterion fails (Kourovka 12.79).** It is not true that for every
finite group $G$ and all $a, b \in G$ such that Strunkov's class function
$1^G - 1_{\langle a \rangle}^G - 1_{\langle b \rangle}^G - 1_{\langle ab \rangle}^G + 2$ is a
character of $G$, the elements $a$ and $b$ generate $G$. Here $1_H^G$ is the permutation character
of $G$ on the cosets of a subgroup $H$, $1^G = 1_1^G$, $\langle x \rangle$ is the cyclic subgroup
generated by $x$, and $2$ is the constant function with value $2$.

Counterexample (S. V. Skresanov, 2019): $G = A_4$ and $a = b = (1\,2\,3)$. The function takes the
values $2, 2, -1, -1$ on the classes of $1$, $(1\,2)(3\,4)$, $(1\,2\,3)$, $(1\,3\,2)$, so it is
the sum of the two nontrivial linear characters of $A_4$, while $\langle a, b \rangle$ has
order $3$.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 12.79 (S. P.
Strunkov); resolution: S. V. Skresanov, Algebra Logic 58 (2019), no. 3, 249-253, Kourovka Archive,
Problem 12.79: No, not always; counterexample G = A_4, a = b = (123).
-/
theorem strunkovCharacterImpliesGeneration_refuted :
    ¬ strunkovCharacterImpliesGeneration := by
  intro h
  have hgen := h G a a strunkov_isCharacter
  rw [Set.pair_eq_singleton, ← Subgroup.zpowers_eq_closure] at hgen
  have hcard := Nat.card_zpowers a
  rw [hgen, Subgroup.card_top, alternatingGroup.card_of_card_eq_four (by simp),
    cycle_order] at hcard
  contradiction

end MathlibExt.GroupTheory.PermutationCharacterGenerationKourovka12Problem79Wanted
