/-!
# The Baer–Suzuki theorem for finite and binary finite groups

`baer_suzuki` characterizes membership in the p-core of a finite group. See Richard Foote,
*Burnside’s Theorem and Theorems of Baer–Suzuki and Thompson*, §1.1, Theorem 1.1, applied to
the cyclic subgroup generated by the element.

`baerSuzukiBinaryFinite_holds` puts an element whose conjugates pairwise generate p-subgroups
in a normal p-subgroup when every pair of elements generates a finite subgroup. We prove the
finite case using maximal subgroups and apply it to the factors in a word in the normal closure,
as in the Kourovka Notebook's solution to Problem 11.11(b).
-/

@[expose] public section

namespace MathlibExt.GroupTheory.BaerSuzukiPeriodicBinaryFiniteKourovka11Problem11Wanted

/-- **Baer–Suzuki property for binary finite groups.** The proposition that for every prime $p$,
every group $G$ in which any two elements generate a finite subgroup, and every element $a \in G$
such that any two conjugates of $a$ generate a $p$-subgroup, there is a normal $p$-subgroup of $G$
containing $a$. Here a $p$-subgroup is a subgroup in which every element has order a power of $p$.

This is the statement asked about in Kourovka Problem 11.11(b) (A. V. Borovik). -/
def baerSuzukiBinaryFinite : Prop :=
  ∀ p : ℕ, p.Prime → ∀ (G : Type) [Group G], (∀ x y : G, (Subgroup.closure {x, y} : Set G).Finite) →
    ∀ a : G, (∀ x y : G, IsConj a x → IsConj a y → IsPGroup p (Subgroup.closure {x, y})) →
      ∃ N : Subgroup G, N.Normal ∧ IsPGroup p N ∧ a ∈ N

open Subgroup

section FiniteInduction

variable {G : Type*} [Group G] {p : ℕ}

/-- The subgroup generated by the conjugates of `a` which belong to `H`. -/
private def conjugateClosureIn (a : G) (H : Subgroup G) : Subgroup G :=
  closure {x | IsConj a x ∧ x ∈ H}

private theorem conjugateClosureIn_le (a : G) (H : Subgroup G) : conjugateClosureIn a H ≤ H :=
  (closure_le _).2 fun _ hx ↦ hx.2

private theorem conjugateClosureIn_mono (a : G) {H K : Subgroup G} (h : H ≤ K) :
    conjugateClosureIn a H ≤ conjugateClosureIn a K :=
  closure_mono fun _ hx ↦ ⟨hx.1, h hx.2⟩

private theorem conjugateClosureIn_idem (a : G) (H : Subgroup G) :
    conjugateClosureIn a (conjugateClosureIn a H) = conjugateClosureIn a H := by
  refine le_antisymm (conjugateClosureIn_le ..) ((closure_le _).2 fun x hx ↦ ?_)
  exact subset_closure ⟨hx.1, subset_closure hx⟩

private theorem le_normalizer_conjugateClosureIn (a : G) (H : Subgroup G) :
    normalizer H ≤ normalizer (conjugateClosureIn a H : Set G) := by
  apply le_normalizer_closure_iff.2
  intro g hg x hx
  exact subset_closure ⟨hx.1.trans (isConj_iff.2 ⟨g, rfl⟩), (hg x).mp hx.2⟩

/-- Inside a finite p-group, the relative normalizer of a proper subgroup strictly contains it. -/
private theorem lt_inf_normalizer [Finite G] [Fact p.Prime] {T U : Subgroup G}
    (hU : IsPGroup p U) (h : T < U) : T < U ⊓ normalizer T := by
  have : Group.IsNilpotent U := hU.isNilpotent
  have ht := Group.normalizerCondition_of_isNilpotent (T.subgroupOf U)
    (lt_top_iff_ne_top.mpr fun ht ↦ h.not_ge (subgroupOf_eq_top.mp ht))
  rw [← subgroupOf_normalizer_eq h.le] at ht
  refine lt_of_le_of_ne (le_inf h.le le_normalizer) fun he ↦ ht.not_ge ?_
  intro x hx
  exact he.ge ⟨x.2, hx⟩

/-- If a conjugacy class generates p-subgroups in proper overgroups, two distinct maximal
overgroups of `a` suffice to put it in a normal p-subgroup. -/
private theorem exists_normal_pSubgroup_of_two_coatoms [Finite G] [Fact p.Prime] (a : G)
    (hproper : ∀ H : Subgroup G, H ≠ ⊤ → IsPGroup p (conjugateClosureIn a H))
    (htwo : ∃ M L : Subgroup G, IsCoatom M ∧ IsCoatom L ∧ M ≠ L ∧ a ∈ M ⊓ L) :
    ∃ N : Subgroup G, N.Normal ∧ IsPGroup p N ∧ a ∈ N := by
  classical
  -- Maximize the part of the conjugacy class shared by two maximal subgroups.
  let C : Set (Subgroup G) := {A | a ∈ A ∧ conjugateClosureIn a A = A ∧
    ∃ M L : Subgroup G, IsCoatom M ∧ IsCoatom L ∧ M ≠ L ∧ A ≤ M ⊓ L}
  have hC : C.Nonempty := by
    obtain ⟨M, L, hm, hl, hne, ha⟩ := htwo
    exact ⟨conjugateClosureIn a (M ⊓ L), subset_closure ⟨IsConj.refl _, ha⟩,
      conjugateClosureIn_idem .., M, L, hm, hl, hne, conjugateClosureIn_le ..⟩
  obtain ⟨A, hA⟩ := (Set.toFinite C).exists_maximal hC
  obtain ⟨haA, heA, M₁, M₂, h₁, h₂, hn, hle⟩ := hA.prop
  have hAP : IsPGroup p A := (hproper M₁ h₁.1).to_le <|
    heA ▸ conjugateClosureIn_mono a (hle.trans inf_le_left)
  by_cases hnorm : normalizer (A : Set G) = ⊤
  · exact ⟨A, normalizer_eq_top_iff.mp hnorm, hAP, haA⟩
  obtain ⟨L, hL, hnL⟩ := (eq_top_or_exists_le_coatom (normalizer (A : Set G))).resolve_left hnorm
  have hAL := (le_normalizer (H := A)).trans hnL
  obtain ⟨M, hM, hML, hAM⟩ : ∃ M : Subgroup G, IsCoatom M ∧ M ≠ L ∧ A ≤ M := by
    by_cases h : M₁ = L
    · exact ⟨M₂, h₂, h ▸ hn.symm, hle.trans inf_le_right⟩
    · exact ⟨M₁, h₁, h, hle.trans inf_le_left⟩
  let S := M ⊓ L
  have hAS : A ≤ S := le_inf hAM hAL
  have hS : conjugateClosureIn a S = A := by
    have hleS : A ≤ conjugateClosureIn a S := heA ▸ conjugateClosureIn_mono a hAS
    apply le_antisymm _ hleS
    exact hA.2 ⟨hleS haA, conjugateClosureIn_idem ..,
      M, L, hM, hL, hML, conjugateClosureIn_le ..⟩ hleS
  -- Some conjugate in M lies outside S, since otherwise M would normalize A.
  have hMS : ¬ conjugateClosureIn a M ≤ S := by
    intro h
    have heM : conjugateClosureIn a M = A := by
      apply le_antisymm
      · rw [← hS, ← conjugateClosureIn_idem a M]
        exact conjugateClosureIn_mono a h
      · exact heA ▸ conjugateClosureIn_mono a hAM
    have hleML : M ≤ L :=
      le_normalizer.trans ((le_normalizer_conjugateClosureIn a M).trans (heM ▸ hnL))
    exact hL.1 (hM.2 L (hleML.lt_of_ne hML))
  -- Enlarge A to a maximal p-subgroup T inside S.
  let pSubgroups : Set (Subgroup G) := {T | A ≤ T ∧ T ≤ S ∧ IsPGroup p T}
  obtain ⟨T, hT⟩ := (Set.toFinite pSubgroups).exists_maximal ⟨A, le_rfl, hAS, hAP⟩
  obtain ⟨hAT, hTS, hTP⟩ := hT.prop
  have heT : conjugateClosureIn a T = A :=
    le_antisymm ((conjugateClosureIn_mono a hTS).trans hS.le) (heA ▸ conjugateClosureIn_mono a hAT)
  have hnT : normalizer T ≤ L := (le_normalizer_conjugateClosureIn a T).trans (heT ▸ hnL)
  -- Adjoin the conjugates in M to T. The resulting p-group lies in M and strictly
  -- contains T, so its normalizer of T grows inside M ∩ L.
  let U := T ⊔ conjugateClosureIn a M
  have hTM : T ≤ M := hTS.trans inf_le_left
  have hUM : U ≤ M := sup_le hTM (conjugateClosureIn_le ..)
  have hUP : IsPGroup p U := hTP.to_sup_of_normal_right' (hproper M hM.1)
    (hTM.trans (le_normalizer.trans (le_normalizer_conjugateClosureIn a M)))
  have hTU : T < U := lt_of_le_of_ne le_sup_left fun he ↦
    hMS ((show conjugateClosureIn a M ≤ U from le_sup_right).trans (he.ge.trans hTS))
  have hgrow := lt_inf_normalizer hUP hTU
  exact (hgrow.not_ge (hT.2
    ⟨hAT.trans hgrow.le, inf_le_inf hUM hnT, hUP.to_le inf_le_left⟩ hgrow.le)).elim

private theorem isPGroup_pair_subgroup (H : Subgroup G) (a : G) (x : H) (hx : IsConj a (x : G))
    (ha : ∀ u v : G, IsConj a u → IsConj a v → IsPGroup p (closure {u, v}))
    (u v : H) (hu : IsConj x u) (hv : IsConj x v) : IsPGroup p (closure {u, v}) := by
  apply (ha u v (hx.trans (H.subtype.map_isConj hu))
    (hx.trans (H.subtype.map_isConj hv))).comap_subtype.to_le
  exact (closure_le _).2 (Set.pair_subset
    (subset_closure (Set.mem_insert _ _)) (subset_closure (Set.mem_insert_of_mem _ rfl)))

/-- The finite case, by induction on the group order. -/
private theorem exists_normal_pSubgroup_of_finite [Fact p.Prime] (G : Type*) [Group G] [Finite G]
    (a : G) (ha : ∀ x y : G, IsConj a x → IsConj a y → IsPGroup p (closure {x, y})) :
    ∃ N : Subgroup G, N.Normal ∧ IsPGroup p N ∧ a ∈ N := by
  classical
  induction hn : Nat.card G using Nat.strong_induction_on generalizing G with
  | ind n ih =>
    have hproper (H : Subgroup G) (hH : H ≠ ⊤) : IsPGroup p (conjugateClosureIn a H) := by
      have hlt : Nat.card H < n := by simpa [← hn] using card_lt_of_lt hH.lt_top
      -- By induction, each conjugate in H belongs to every Sylow p-subgroup of H.
      obtain ⟨P⟩ := Sylow.nonempty (p := p) (G := H)
      apply (P.isPGroup.map H.subtype).to_le
      apply (closure_le _).2
      intro x hx
      let x' : H := ⟨x, hx.2⟩
      obtain ⟨N, _, hN, hxN⟩ := ih _ hlt H x' (isPGroup_pair_subgroup H a x' hx.1 ha) rfl
      exact ⟨x', hN.le_sylow_of_normal P hxN, rfl⟩
    by_cases htwo : ∃ M L : Subgroup G, IsCoatom M ∧ IsCoatom L ∧ M ≠ L ∧ a ∈ M ⊓ L
    · exact exists_normal_pSubgroup_of_two_coatoms a hproper htwo
    by_contra hnone
    have hpair (x : G) (hx : IsConj a x) : ∃ M : Subgroup G, IsCoatom M ∧ a ∈ M ∧ x ∈ M := by
      have hp' := ha a x (.refl _) hx
      obtain ht | ⟨M, hM, hle⟩ := eq_top_or_exists_le_coatom (closure ({a, x} : Set G))
      · exact (hnone ⟨⊤, inferInstance, ht ▸ hp', trivial⟩).elim
      exact ⟨M, hM, hle (subset_closure (Set.mem_insert _ _)),
        hle (subset_closure (Set.mem_insert_of_mem _ rfl))⟩
    obtain ⟨M, hM, haM, _⟩ := hpair a (.refl _)
    -- Every conjugate shares a maximal subgroup with a, and this maximal subgroup is unique.
    have hle : conjugateClosureIn a ⊤ ≤ conjugateClosureIn a M := by
      apply (closure_le _).2
      intro x hx
      obtain ⟨L, hL, haL, hxL⟩ := hpair x hx.1
      have he : M = L := by_contra fun h ↦ htwo ⟨M, L, hM, hL, h, haM, haL⟩
      exact subset_closure ⟨hx.1, he ▸ hxL⟩
    exact hnone ⟨conjugateClosureIn a ⊤, normalizer_eq_top_iff.mp <| top_le_iff.mp <|
      le_normalizer.trans (le_normalizer_conjugateClosureIn a ⊤), (hproper M hM.1).to_le hle,
      subset_closure ⟨IsConj.refl _, trivial⟩⟩

end FiniteInduction

variable {G : Type} [Group G] {p : ℕ}

/-- A conjugate of `a` and any element of p-power order generate a p-group. -/
private theorem isPGroup_pair_of_pow_eq_one [Fact p.Prime] {a x b : G}
    (hfin : (closure {x, b} : Set G).Finite)
    (ha : ∀ u v : G, IsConj a u → IsConj a v → IsPGroup p (closure {u, v}))
    (hx : IsConj a x) {n : ℕ} (hb : b ^ p ^ n = 1) : IsPGroup p (closure {x, b}) := by
  let H := closure ({x, b} : Set G)
  let : Finite H := hfin.to_subtype
  let x' : H := ⟨x, subset_closure (Set.mem_insert _ _)⟩
  let b' : H := ⟨b, subset_closure (Set.mem_insert_of_mem _ rfl)⟩
  obtain ⟨N, _, hN, hxN⟩ :=
    exists_normal_pSubgroup_of_finite H x' (isPGroup_pair_subgroup H a x' hx ha)
  have hbP : IsPGroup p (zpowers b') := by
    apply IsPGroup.of_card_dvd_pow (n := n)
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one (Subtype.ext hb : b' ^ p ^ n = 1)
  -- The normal p-subgroup containing x' and the cyclic subgroup of b' generate H.
  have hle : H ≤ (N ⊔ zpowers b').map H.subtype := by
    apply (closure_le _).2
    exact Set.pair_subset ⟨x', (le_sup_left : N ≤ N ⊔ zpowers b') hxN, rfl⟩
      ⟨b', (le_sup_right : zpowers b' ≤ N ⊔ zpowers b') (mem_zpowers _), rfl⟩
  exact ((hN.to_sup_of_normal_left hbP).map H.subtype).to_le hle

/-- **Baer–Suzuki theorem for binary finite groups.** For every prime $p$, every group $G$ in
which any two elements generate a finite subgroup, and every element $a \in G$ such that any two
conjugates of $a$ generate a $p$-subgroup, there is a normal $p$-subgroup of $G$ containing $a$.
Here a $p$-subgroup is a subgroup in which every element has order a power of $p$.

This answers Kourovka Problem 11.11(b) affirmatively (Sozutov, 2000): by the Baer–Suzuki theorem
for finite groups, $\langle a_1, b \rangle$ is a finite $p$-group for every conjugate $a_1$ of $a$
and every element $b$ of $p$-power order, so by induction every product $a_1 \cdots a_n$ of
conjugates of $a$ has $p$-power order, and the normal closure of $a$ is a normal $p$-subgroup.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 11.11 (A. V.
Borovik); resolution: V. D. Mazurov, A. Yu. Olshanskii and A. I. Sozutov, Algebra and Logic 54, no.
2 (2015), 161-166 (a); A. I. Sozutov, Siberian Math. J. 41, no. 3 (2000), 561-562 (b), Kourovka
Archive, Problem 11.11.
-/
theorem baerSuzukiBinaryFinite_holds : baerSuzukiBinaryFinite := by
  intro p hp G _ hfin a ha
  have : Fact p.Prime := ⟨hp⟩
  refine ⟨normalClosure {a}, inferInstance, ?_, subset_normalClosure rfl⟩
  rintro ⟨w, hw⟩
  suffices ∃ n : ℕ, w ^ p ^ n = 1 from this.imp fun _ ↦ Subtype.ext
  -- Prepending a conjugate or its inverse keeps a word inside a p-group.
  have extend (x : G) (hx : x ∈ Group.conjugatesOfSet {a}) (b : G)
      (hb : ∃ n : ℕ, b ^ p ^ n = 1) (z : G) (hz : z ∈ closure ({x, b} : Set G)) :
      ∃ n : ℕ, z ^ p ^ n = 1 := by
    obtain ⟨_, rfl, hax⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨_, hn⟩ := hb
    exact (isPGroup_pair_of_pow_eq_one (hfin x b) ha hax hn ⟨z, hz⟩).imp
      fun _ hk ↦ congrArg Subtype.val hk
  apply closure_induction_left (s := Group.conjugatesOfSet {a})
    (p := fun y _ ↦ ∃ n : ℕ, y ^ p ^ n = 1) ⟨0, by simp⟩ _ _ hw
  · intro x hx b _ hb
    exact extend x hx b hb _ (mul_mem (subset_closure (Set.mem_insert _ _))
      (subset_closure (Set.mem_insert_of_mem _ rfl)))
  · intro x hx b _ hb
    exact extend x hx b hb _ (mul_mem (inv_mem (subset_closure (Set.mem_insert _ _)))
      (subset_closure (Set.mem_insert_of_mem _ rfl)))

end MathlibExt.GroupTheory.BaerSuzukiPeriodicBinaryFiniteKourovka11Problem11Wanted

namespace MathlibExt.GroupTheory.BaerSuzukiWanted.GroupTheory

namespace Defs

-- Keep the established fully qualified name, including both `GroupTheory` components.
set_option linter.dupNamespace false in
/-- **The $p$-core of a group.** For a natural number $p$ and a group $G$, the $p$-core $O_p(G)$
is the supremum, in the lattice of subgroups of $G$, of all normal subgroups $N$ of $G$ that are
$p$-groups, that is, such that every $y \in N$ satisfies $y^{p^k} = 1$ for some $k \ge 0$.

When $p$ is prime, $O_p(G)$ is itself a normal $p$-subgroup of $G$, hence the largest one, and no
finiteness hypothesis is needed: the join of two normal $p$-subgroups is again a normal
$p$-subgroup, so the family is directed and every element of the supremum lies in one of them.
-/
def pCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ IsPGroup p N}

end Defs

open Defs Subgroup
open MathlibExt.GroupTheory.BaerSuzukiPeriodicBinaryFiniteKourovka11Problem11Wanted
  (exists_normal_pSubgroup_of_finite)

-- As for `Defs.pCore`, keep the established fully qualified name.
set_option linter.dupNamespace false in
/-- **Baer–Suzuki theorem.** Let $G$ be a finite group, $p$ a prime and $x \in G$. Then $x$ lies
in the $p$-core $O_p(G)$ of $G$ if and only if, for every $g \in G$, the subgroup of $G$ generated
by $x$ and $g x g^{-1}$ is a $p$-group, that is, every element of it has order a power of $p$.

Source: R. Baer, Engelsche Elemente Noetherscher Gruppen, Math. Ann. 133 (1957), 256-270; M.
Suzuki, Finite groups in which the centralizer of any element of order 2 is 2-closed, Ann. of Math.
(2) 82 (1965), 191-212. Via leanprover/lean-eval@38361be, problem `baer_suzuki`. -/
theorem baer_suzuki {G : Type*} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (x : G) :
    x ∈ pCore p G ↔
      ∀ g : G, IsPGroup p
        (Subgroup.closure ({x, g * x * g⁻¹} : Set G)) := by
  constructor
  · intro hx g
    have hN : (pCore p G).Normal := sSup_normal _ fun _ h ↦ h.1
    have hp : IsPGroup p (pCore p G) := Sylow.sSup_of_normal _ (fun _ h ↦ h.2) fun _ h ↦ h.1
    exact hp.to_le ((closure_le _).2 (Set.pair_subset hx (hN.conj_mem x hx g)))
  · intro h
    have hconj (u v : G) (hu : IsConj x u) (hv : IsConj x v) :
        IsPGroup p (closure ({u, v} : Set G)) := by
      obtain ⟨a, rfl⟩ := isConj_iff.mp hu
      obtain ⟨b, rfl⟩ := isConj_iff.mp hv
      -- Conjugating the pair for `a⁻¹ * b` by `a` gives the desired pair.
      have hpair := (h (a⁻¹ * b)).map (MulAut.conj a).toMonoidHom
      rw [MonoidHom.map_closure, Set.image_pair] at hpair
      change IsPGroup p (closure {MulAut.conj a x,
        MulAut.conj a (MulAut.conj (a⁻¹ * b) x)}) at hpair
      rw [← MulAut.mul_apply, ← map_mul, mul_inv_cancel_left] at hpair
      exact hpair
    obtain ⟨N, hN, hp, hx⟩ := exists_normal_pSubgroup_of_finite G x hconj
    exact mem_sSup_of_mem (S := {K : Subgroup G | K.Normal ∧ IsPGroup p K}) (s := N) ⟨hN, hp⟩ hx

end MathlibExt.GroupTheory.BaerSuzukiWanted.GroupTheory
