/-!
# Failure of the Howson property for Thompson's group

`thompsonFHowson_refuted` exhibits two finitely generated subgroups whose intersection
is infinitely generated. Write `x₂` and `x₃` for the first two conjugates of `x₁` by `x₀`,
and put `a = x₀ * x₁⁻¹` and `w = x₂⁻¹ * x₃`. The subgroups generated by `{x₂, w}` and
`{a * x₂, w}` contain the same conjugates of `w` by powers of `x₂`, since `a` commutes with
both `x₂` and `x₃`. In the action on the rational line these conjugates move arbitrarily
large points, whereas every finite subset of the intersection fixes a common right-hand tail.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.ThompsonGroupHowsonKourovka19Problem40Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.40 (I.
Kapovich). UnsolvedMath record UM-00701588 (`KOU-19.40`), dataset ulamai/UnsolvedMath v1.8.0.

`F` is the presented group `⟨x₀, x₁ | [x₀x₁⁻¹, x₀⁻¹x₁x₀], [x₀x₁⁻¹, x₀⁻²x₁x₀²]⟩`, the standard
two-relator presentation (as in the introductory notes of Cannon, Floyd and Parry), with `[a, b] = a
b a⁻¹ b⁻¹`.
-/

/-- **Relators of Thompson's group $F$.** In the free group on two generators $x_0$ and $x_1$,
this is the set of the two elements $[x_0 x_1^{-1}, x_0^{-1} x_1 x_0]$ and
$[x_0 x_1^{-1}, x_0^{-2} x_1 x_0^2]$, where $[a, b] = a b a^{-1} b^{-1}$. They are the relators
of the standard presentation of Thompson's group $F$. -/
def thompsonRelators : Set (FreeGroup (Fin 2)) :=
  let x₀ := FreeGroup.of (0 : Fin 2)
  let x₁ := FreeGroup.of (1 : Fin 2)
  let a := x₀ * x₁⁻¹
  let b := x₀⁻¹ * x₁ * x₀
  let c := x₀⁻¹ ^ 2 * x₁ * x₀ ^ 2
  {a * b * a⁻¹ * b⁻¹, a * c * a⁻¹ * c⁻¹}

/-- **Thompson's group $F$ by its standard presentation.** Thompson's group $F$ is the group with
generators $x_0, x_1$ and relations $[x_0 x_1^{-1}, x_0^{-1} x_1 x_0] = 1$ and
$[x_0 x_1^{-1}, x_0^{-2} x_1 x_0^2] = 1$, where $[a, b] = a b a^{-1} b^{-1}$; that is, the
quotient of the free group on $x_0, x_1$ by the normal subgroup generated by these two
relators. -/
abbrev ThompsonF := PresentedGroup thompsonRelators

/-- **Howson property for Thompson's group $F$.** The statement that Thompson's group $F$ has the
Howson property: for all finitely generated subgroups $H$ and $K$ of $F$, the intersection
$H \cap K$ is finitely generated.

This is Kourovka Notebook Problem 19.40 (I. Kapovich). -/
def thompsonFHowson : Prop :=
  ∀ H K : Subgroup ThompsonF, H.FG → K.FG → (H ⊓ K).FG

open scoped commutatorElement

private abbrev leftWord {G : Type*} [Group G] (u v : G) := u * v⁻¹

private abbrev tailWord {G : Type*} [Group G] (n : ℕ) (u v : G) := u⁻¹ ^ n * v * u ^ n

private abbrev x₀ : ThompsonF := PresentedGroup.of 0
private abbrev x₁ : ThompsonF := PresentedGroup.of 1

private abbrev a := leftWord x₀ x₁
private abbrev x₂ := tailWord 1 x₀ x₁
private abbrev x₃ := tailWord 2 x₀ x₁

private theorem defining_commutations : Commute a x₂ ∧ Commute a x₃ := by
  let u := FreeGroup.of (0 : Fin 2)
  let v := FreeGroup.of (1 : Fin 2)
  have h (n : ℕ) (hn : n = 1 ∨ n = 2) :
      ⁅leftWord u v, tailWord n u v⁆ ∈ thompsonRelators := by
    rcases hn with rfl | rfl <;> simp [thompsonRelators, commutatorElement_def, u, v,
      leftWord, tailWord]
  have h' (n : ℕ) (hn : n = 1 ∨ n = 2) : Commute a (tailWord n x₀ x₁) := by
    have hr := PresentedGroup.one_of_mem (h n hn)
    rw [map_commutatorElement, commutatorElement_eq_one_iff_commute] at hr
    simpa only [a, leftWord, tailWord, map_mul, map_pow, map_inv, u, v, x₀, x₁,
      PresentedGroup.of] using hr
  exact ⟨h' 1 (Or.inl rfl), h' 2 (Or.inr rfl)⟩

private def liftPair {G : Type*} [Group G] (u v : G)
    (h : ∀ n : ℕ, n = 1 ∨ n = 2 → Commute (leftWord u v) (tailWord n u v)) :
    ThompsonF →* G :=
  PresentedGroup.toGroup (f := fun i => if i = 0 then u else v) (by
    intro r hr
    rcases hr with rfl | hr
    · simpa [leftWord, tailWord, commutatorElement_def] using (h 1 (Or.inl rfl)).commutator_eq
    · obtain rfl := Set.mem_singleton_iff.mp hr
      simpa [leftWord, tailWord, commutatorElement_def] using (h 2 (Or.inr rfl)).commutator_eq)

-- The first generator translates the whole line. The second fixes the negative half-line
-- and interpolates linearly to the same translation on the right.
private abbrev shift : Equiv.Perm ℚ := Equiv.subRight 1

private def bend : Equiv.Perm ℚ where
  toFun x := if x ≤ 0 then x else if x ≤ 2 then x / 2 else x - 1
  invFun x := if x ≤ 0 then x else if x ≤ 1 then 2 * x else x + 1
  left_inv x := by dsimp; split_ifs <;> linarith
  right_inv x := by dsimp; split_ifs <;> linarith

private theorem leftWord_fixed (x : ℚ) (hx : 1 ≤ x) : leftWord shift bend x = x := by
  change (if x ≤ 0 then x else if x ≤ 1 then 2 * x else x + 1) - 1 = x
  split_ifs <;> linarith

private theorem tailWord_one_apply (x : ℚ) :
    tailWord 1 shift bend x = bend (x - 1) + 1 := by
  simp only [tailWord, pow_one]
  rfl

private theorem tailWord_two_apply (x : ℚ) :
    tailWord 2 shift bend x = bend (x - 1 - 1) + 1 + 1 := by
  simp only [tailWord, pow_two]
  rfl

private def action : ThompsonF →* Equiv.Perm ℚ := liftPair shift bend (by
  intro n hn
  apply Equiv.Perm.Disjoint.commute
  intro x
  rcases le_total 1 x with hx | hx
  · exact Or.inl (leftWord_fixed x hx)
  · right
    rcases hn with rfl | rfl
    · rw [tailWord_one_apply]
      change (if _ then _ else _) + 1 = x
      rw [ite_eq_left (by linarith : x - 1 ≤ 0)]
      ring
    · rw [tailWord_two_apply]
      change (if _ then _ else _) + 1 + 1 = x
      rw [ite_eq_left (by linarith : x - 1 - 1 ≤ 0)]
      ring)

private theorem action_a : action a = leftWord shift bend := by
  simp [a, leftWord, x₀, x₁, action, liftPair]

private theorem action_tail (n : ℕ) : action (tailWord n x₀ x₁) = tailWord n shift bend := by
  simp [tailWord, x₀, x₁, action, liftPair]

private theorem x₂_far {x : ℚ} (hx : 3 ≤ x) : action x₂ x = x - 1 := by
  rw [action_tail, tailWord_one_apply]
  change (if x - 1 ≤ 0 then _ else if x - 1 ≤ 2 then _ else _) + 1 = x - 1
  split_ifs <;> linarith

private theorem x₃_far {x : ℚ} (hx : 4 ≤ x) : action x₃ x = x - 1 := by
  rw [action_tail, tailWord_two_apply]
  change (if x - 1 - 1 ≤ 0 then _ else if x - 1 - 1 ≤ 2 then _ else _) + 1 + 1 = x - 1
  split_ifs <;> linarith

-- The element w is supported in a bounded interval, and moves 3.
private abbrev w := x₂⁻¹ * x₃

private theorem w_fixed_iff (x : ℚ) : action w x = x ↔ action x₃ x = action x₂ x := by
  rw [show action w = (action x₂)⁻¹ * action x₃ by simp [w]]
  exact (action x₂).symm_apply_eq

private theorem w_moves_three : action w 3 ≠ 3 := by
  intro h
  have heq := (w_fixed_iff 3).mp h
  rw [x₂_far (le_refl 3), action_tail, tailWord_two_apply] at heq
  norm_num [bend] at heq

-- This character records the translation of x₀ on the far left. It vanishes on x₂ and x₃.
private def character : ThompsonF →* Multiplicative ℚ :=
  liftPair (Multiplicative.ofAdd (-1)) 1 (fun _ _ => Commute.all _ _)

private theorem character_values : character a = Multiplicative.ofAdd (-1) ∧
    character x₂ = 1 ∧ character w = 1 := by
  simp [character, a, x₂, x₃, w, x₀, x₁, leftWord, tailWord, liftPair]

open Filter

-- These are the elements which translate the far right by the value of the character.
private def matchingTranslations : Subgroup ThompsonF where
  carrier := {g | ∀ᶠ x in atTop, action g x = x + (character g).toAdd}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh
    obtain ⟨M, hM⟩ := eventually_atTop.mp hg
    obtain ⟨N, hN⟩ := eventually_atTop.mp hh
    refine eventually_atTop.mpr ⟨max (M - (character h).toAdd) N, fun x hx => ?_⟩
    obtain ⟨h₁, h₂⟩ := max_le_iff.mp hx
    simp only [map_mul, Equiv.Perm.mul_apply, toAdd_mul, hN x h₂,
      hM _ (show M ≤ x + (character h).toAdd by linarith)]
    ring
  inv_mem' := by
    intro g hg
    obtain ⟨M, hM⟩ := eventually_atTop.mp hg
    refine eventually_atTop.mpr ⟨M + (character g).toAdd, fun x hx => ?_⟩
    simp only [map_inv, toAdd_inv]
    apply (action g).symm_apply_eq.mpr
    rw [hM _ (by linarith)]
    ring

private def pair (g h : ThompsonF) := Subgroup.closure ({g, h} : Set ThompsonF)

private theorem pair_fg (g h : ThompsonF) : (pair g h).FG :=
  (Subgroup.fg_iff _).mpr ⟨_, rfl, (Set.finite_singleton h).insert g⟩

private theorem pair_le {g h : ThompsonF} {S : Subgroup ThompsonF} (hg : g ∈ S) (hh : h ∈ S) :
    pair g h ≤ S :=
  (Subgroup.closure_le S).mpr (Set.insert_subset hg (Set.singleton_subset_iff.mpr hh))

private abbrev H := pair x₂ w
private abbrev K := pair (a * x₂) w

private theorem fixes_tail {g : ThompsonF} (hg : g ∈ H ⊓ K) :
    ∀ᶠ x in atTop, action g x = x := by
  have hH : H ≤ character.ker := pair_le character_values.2.1 character_values.2.2
  have hK : K ≤ matchingTranslations := by
    apply pair_le
    · refine eventually_atTop.mpr ⟨3, fun x hx => ?_⟩
      rw [map_mul action, Equiv.Perm.mul_apply, x₂_far hx, action_a,
        leftWord_fixed _ (by linarith), map_mul character, character_values.1,
        character_values.2.1, mul_one, toAdd_ofAdd]
      ring
    · refine eventually_atTop.mpr ⟨4, fun x hx => ?_⟩
      rw [character_values.2.2, toAdd_one, add_zero, w_fixed_iff,
        x₃_far hx, x₂_far (by linarith)]
  have hzero : character g = 1 := hH hg.1
  have hmatch : ∀ᶠ x in atTop, action g x = x + (character g).toAdd := hK hg.2
  simpa [hzero] using hmatch

-- The defining relations make a commute with x₂ and x₃, so powers of x₂ and a * x₂
-- give the same conjugates of w in the presented group.
private theorem conjugate_mem (n : ℕ) : (x₂ ^ n)⁻¹ * w * x₂ ^ n ∈ H ⊓ K := by
  have hgen (s : ThompsonF) : s ∈ pair s w ∧ w ∈ pair s w :=
    ⟨Subgroup.subset_closure (by simp), Subgroup.subset_closure (by simp)⟩
  have hmem (s : ThompsonF) : (s ^ n)⁻¹ * w * s ^ n ∈ pair s w := by
    obtain ⟨hs, hw⟩ := hgen s
    have hn := (pair s w).pow_mem hs n
    exact (pair s w).mul_mem ((pair s w).mul_mem ((pair s w).inv_mem hn) hw) hn
  refine ⟨hmem x₂, ?_⟩
  obtain ⟨hab, had⟩ := defining_commutations
  have haw : Commute a w := hab.inv_right.mul_right had
  have heq : ((a * x₂) ^ n)⁻¹ * w * (a * x₂) ^ n = (x₂ ^ n)⁻¹ * w * x₂ ^ n := by
    rw [hab.mul_pow, mul_inv_rev]
    calc
      _ = (x₂ ^ n)⁻¹ * ((a ^ n)⁻¹ * w * a ^ n) * x₂ ^ n := by simp only [mul_assoc]
      _ = _ := by rw [(haw.pow_left n).inv_mul_cancel]
  rw [← heq]
  exact hmem (a * x₂)

private theorem x₂_orbit (n : ℕ) : action (x₂ ^ n) (3 + n) = 3 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, map_mul, Equiv.Perm.mul_apply, x₂_far (le_add_of_nonneg_right (by positivity))]
    simpa [Nat.cast_succ, ← add_assoc] using ih

private theorem conjugate_moves (n : ℕ) :
    action ((x₂ ^ n)⁻¹ * w * x₂ ^ n) (3 + n) ≠ 3 + n := by
  intro h
  rw [map_mul action, map_mul action, map_inv, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply] at h
  have heq := (action (x₂ ^ n)).symm_apply_eq.mp h
  rw [x₂_orbit] at heq
  exact w_moves_three heq

/--
**Thompson's group $F$ does not have the Howson property.** It is not the case that the
intersection of any two finitely generated subgroups of Thompson's group $F$ is finitely
generated: there are finitely generated subgroups $H$ and $K$ of $F$ such that $H \cap K$ is not
finitely generated.

Resolved false: the Kourovka Archive answers 19.40 "No": $\mathbb{Z} \wr \mathbb{Z}$ fails the
Howson property (Kirkinskiĭ) and embeds in $F$ (Cleary), and the property is inherited by
subgroups.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 19.40 (I.
Kapovich); resolution: A. S. Kirkinskiĭ, Algebra Logic 20 (1981), no. 1, 24-36; S. Cleary, Pacific
J. Math. 228 (2006), no. 1, 53-61; D. Robertson, letter of 24 April 2018, Kourovka Archive,
Problem 19.40: No; ℤ ≀ ℤ does not have the Howson property (Kirkinskiĭ) and embeds in F (Cleary),
and the Howson property passes to subgroups, https://arxiv.org/abs/1401.0300v49.
-/
public theorem thompsonFHowson_refuted : ¬ thompsonFHowson := by
  intro howson
  obtain ⟨s, hs, hfin⟩ := (Subgroup.fg_iff _).mp (howson H K (pair_fg _ _) (pair_fg _ _))
  have hall : ∀ᶠ x in atTop, ∀ g ∈ s, action g x = x := by
    apply (eventually_all_finite hfin).mpr
    intro g hg
    apply fixes_tail
    rw [← hs]
    exact Subgroup.subset_closure hg
  obtain ⟨M, hM⟩ := eventually_atTop.mp hall
  obtain ⟨n, hn⟩ := exists_nat_ge M
  let S := (MulAction.stabilizer (Equiv.Perm ℚ) (3 + (n : ℚ))).comap action
  have hle : H ⊓ K ≤ S := by
    rw [← hs]
    apply (Subgroup.closure_le S).mpr
    exact hM _ (by linarith)
  exact conjugate_moves n (hle (conjugate_mem n))

end MathlibExt.GroupTheory.ThompsonGroupHowsonKourovka19Problem40Wanted
