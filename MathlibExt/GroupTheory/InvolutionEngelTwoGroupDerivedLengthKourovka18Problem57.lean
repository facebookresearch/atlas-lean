/-!
# Engel condition on involutions and derived length (Kourovka Notebook Problem 18.57)

Kourovka Notebook, Archive of Solved Problems, Problem 18.57 (D. V. Lytkina): let `G` be a finite
2-group generated by involutions in which `[x, u, u] = 1` for every `x ∈ G` and every involution `u
∈ G`. Is the derived length of `G` bounded? We prove that it is unbounded.

We use the group of units generated by one plus a letter in the algebra of words over
`ZMod 2` with repeated-letter words set to zero. Square-zero elements in this algebra
annihilate every element when multiplied on both sides. Balanced commutators on disjoint
sets of letters give nonidentity elements at arbitrary depths of the derived series.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.InvolutionEngelTwoGroupDerivedLengthKourovka18Problem57Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.57 (D. V.
Lytkina). UnsolvedMath record UM-00701486 (`KOU-18.57`), dataset ulamai/UnsolvedMath v1.8.0.

`[x, u] = x⁻¹ u⁻¹ x u` and `[x, u, u] = [[x, u], u]` (replacing `x` by `x⁻¹` turns the condition for
the other commutator convention into this one). Bounded derived length means one `d` with `G⁽ᵈ⁾ = 1`
for all such groups.
-/

/-- **Involution-generated 2-groups with the Engel condition on involutions.** A group $G$ has
this property when every element of $G$ has order a power of $2$, $G$ is generated by its
involutions, and $[[x, u], u] = 1$ for every $x \in G$ and every involution $u \in G$, where
$[x, u] = x^{-1} u^{-1} x u$. -/
def IsInvolutionEngelTwoGroup (G : Type) [Group G] : Prop :=
  IsPGroup 2 G ∧ Subgroup.closure {u : G | orderOf u = 2} = ⊤ ∧
    ∀ x u : G, orderOf u = 2 →
      (x⁻¹ * u⁻¹ * x * u)⁻¹ * u⁻¹ * (x⁻¹ * u⁻¹ * x * u) * u = 1

/-- **Kourovka Problem 18.57 on the derived length of involution-generated 2-groups.** The
proposition (Kourovka 18.57, D. V. Lytkina) that there is a natural number $d$ such that
$G^{(d)} = 1$ for every finite group $G$ in which every element has order a power of $2$, which is
generated by its involutions, and in which $[[x, u], u] = 1$ for every $x \in G$ and every
involution $u \in G$; here $[x, u] = x^{-1} u^{-1} x u$ and $G^{(d)}$ is the $d$-th term of the
derived series of $G$. -/
def involutionEngelTwoGroupsBoundedDerivedLength : Prop :=
  ∃ d : ℕ, ∀ (G : Type) [Group G] [Finite G], IsInvolutionEngelTwoGroup G →
    Subgroup.derivedSeries G d = ⊥

open scoped commutatorElement

private abbrev WordAlgebra (n : ℕ) := MonoidAlgebra (ZMod 2) (FreeMonoid (Fin n))

private theorem coeff_mul {n : ℕ} (a b : WordAlgebra n) (w : List (Fin n)) :
    (a * b).coeff (FreeMonoid.ofList w) =
      ∑ k : Fin (w.length + 1),
        a.coeff (FreeMonoid.ofList (w.take k)) * b.coeff (FreeMonoid.ofList (w.drop k)) := by
  classical
  let split : Fin (w.length + 1) ↪ FreeMonoid (Fin n) × FreeMonoid (Fin n) :=
    ⟨fun k ↦ (FreeMonoid.ofList (w.take k), FreeMonoid.ofList (w.drop k)), by
      intro i j h
      have h₁ := congrArg (fun p ↦ (FreeMonoid.toList p.1).length) h
      simpa [List.length_take, Nat.min_eq_left (Nat.le_of_lt_succ i.isLt),
        Nat.min_eq_left (Nat.le_of_lt_succ j.isLt), Fin.ext_iff] using h₁⟩
  rw [MonoidAlgebra.coeff_mul_antidiag a b _ (Finset.univ.map split)]
  · rw [Finset.sum_map]
    rfl
  · intro p
    simp only [Finset.mem_map, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨k, rfl⟩
      change FreeMonoid.ofList (w.take k ++ w.drop k) = FreeMonoid.ofList w
      rw [List.take_append_drop]
    · intro h
      have hw : p.1.toList ++ p.2.toList = w := congrArg FreeMonoid.toList h
      refine ⟨⟨p.1.toList.length, by rw [← hw, List.length_append]; omega⟩, ?_⟩
      apply Prod.ext
      · change FreeMonoid.ofList (w.take p.1.toList.length) = p.1
        rw [← hw, List.take_left]
      · change FreeMonoid.ofList (w.drop p.1.toList.length) = p.2
        rw [← hw, List.drop_left]

private def wordCongruence (n : ℕ) : RingCon (WordAlgebra n) where
  r a b := ∀ w : List (Fin n), w.Nodup →
    a.coeff (FreeMonoid.ofList w) = b.coeff (FreeMonoid.ofList w)
  iseqv := ⟨fun _ _ _ ↦ rfl, fun h w hw ↦ (h w hw).symm,
    fun h h' w hw ↦ (h w hw).trans (h' w hw)⟩
  add' ha hb w hw := by
    simp only [MonoidAlgebra.coeff_add, Finsupp.add_apply, ha w hw, hb w hw]
  mul' ha hb w hw := by
    rw [coeff_mul, coeff_mul]
    exact Finset.sum_congr rfl fun k _ ↦ by
      rw [ha _ ((List.take_sublist _ _).nodup hw), hb _ ((List.drop_sublist _ _).nodup hw)]

private abbrev WordRing (n : ℕ) := (wordCongruence n).Quotient

private noncomputable abbrev wordMap (n : ℕ) : WordAlgebra n →+* WordRing n :=
  (wordCongruence n).mk'

private def coefficient {n : ℕ} (w : List (Fin n)) (hw : w.Nodup) :
    WordRing n →+ ZMod 2 where
  toFun := Quotient.lift (fun a : WordAlgebra n ↦ a.coeff (FreeMonoid.ofList w))
    (fun _ _ h ↦ h w hw)
  map_zero' := rfl
  map_add' a b := by
    induction a, b using Quotient.inductionOn₂
    rfl

private theorem coefficient_map {n : ℕ} (a : WordAlgebra n) (w : List (Fin n)) (hw : w.Nodup) :
    coefficient w hw (wordMap n a) = a.coeff (FreeMonoid.ofList w) := rfl

private instance wordRingFinite (n : ℕ) : Finite (WordRing n) := by
  let : Finite {w : List (Fin n) // w.Nodup} :=
    ((List.finite_length_le (Fin n) n).subset
      (show {w : List (Fin n) | w.Nodup} ⊆ _ from fun w hw ↦ by
        simpa using (show w.Nodup from hw).length_le_card)).to_subtype
  apply Finite.of_injective (fun a (w : {w : List (Fin n) // w.Nodup}) ↦
    coefficient w.1 w.2 a)
  intro a b h
  induction a, b using Quotient.inductionOn₂ with
  | _ a b =>
    apply Quotient.sound
    exact fun w hw ↦ congrFun h ⟨w, hw⟩

private theorem wordMap_eq_zero {n : ℕ} {a : WordAlgebra n} :
    wordMap n a = 0 ↔ ∀ w : List (Fin n), w.Nodup → a.coeff (FreeMonoid.ofList w) = 0 := by
  change (wordMap n a = wordMap n 0) ↔ _
  exact Quotient.eq

private theorem coefficient_one {n : ℕ} (w : List (Fin n)) (hw : w.Nodup) :
    coefficient w hw (1 : WordRing n) = if w = [] then 1 else 0 := by
  classical
  rw [← map_one (wordMap n), coefficient_map, MonoidAlgebra.one_def]
  rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
  have h : (1 : FreeMonoid (Fin n)) = FreeMonoid.ofList w ↔ w = [] :=
    ⟨fun h ↦ (congrArg FreeMonoid.toList h).symm, fun h ↦ by subst w; rfl⟩
  rw [if_congr h rfl rfl]

private instance wordRingNontrivial (n : ℕ) : Nontrivial (WordRing n) := by
  refine ⟨⟨1, 0, fun h ↦ ?_⟩⟩
  have := congrArg (coefficient ([] : List (Fin n)) List.nodup_nil) h
  simp [coefficient_one] at this

private instance wordRingCharP (n : ℕ) : CharP (WordRing n) 2 :=
  CharP.of_ringHom_of_ne_zero ((wordMap n).comp (algebraMap (ZMod 2) (WordAlgebra n))) 2
    (by decide)

private theorem coeff_mul_ne_zero {n : ℕ} {a b : WordAlgebra n} {w : List (Fin n)}
    (h : (a * b).coeff (FreeMonoid.ofList w) ≠ 0) :
    ∃ u v : List (Fin n), u ++ v = w ∧
      a.coeff (FreeMonoid.ofList u) ≠ 0 ∧ b.coeff (FreeMonoid.ofList v) ≠ 0 := by
  rw [coeff_mul] at h
  obtain ⟨k, _, hk⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
  exact ⟨w.take k, w.drop k, List.take_append_drop k w,
    fun h₀ ↦ hk (by rw [h₀, zero_mul]), fun h₀ ↦ hk (by rw [h₀, mul_zero])⟩

private theorem coeff_mul_eq_of_unique {n : ℕ} {a b : WordAlgebra n} {u v : List (Fin n)}
    (h : ∀ x y : List (Fin n), x ++ y = u ++ v →
      a.coeff (FreeMonoid.ofList x) ≠ 0 → b.coeff (FreeMonoid.ofList y) ≠ 0 →
      x.length = u.length) :
    (a * b).coeff (FreeMonoid.ofList (u ++ v)) =
      a.coeff (FreeMonoid.ofList u) * b.coeff (FreeMonoid.ofList v) := by
  rw [coeff_mul]
  let k : Fin ((u ++ v).length + 1) := ⟨u.length, by rw [List.length_append]; omega⟩
  rw [Finset.sum_eq_single k]
  · change a.coeff (FreeMonoid.ofList ((u ++ v).take u.length)) *
        b.coeff (FreeMonoid.ofList ((u ++ v).drop u.length)) = _
    rw [List.take_left, List.drop_left]
  · intro j _ hj
    by_contra hne
    apply hj
    apply Fin.ext
    have hl := h _ _ (List.take_append_drop j.val (u ++ v))
      (fun h₀ ↦ hne (by rw [h₀, zero_mul])) (fun h₀ ↦ hne (by rw [h₀, mul_zero]))
    rwa [List.length_take, Nat.min_eq_left (Nat.le_of_lt_succ j.isLt)] at hl
  · simp

/-- A shortest repetition-free concatenation of two supported words has a unique split
into two supported words. Consequently a square-zero element admits no such concatenation. -/
private theorem nodup_append_of_square_zero {n : ℕ} {a : WordAlgebra n}
    (ha : wordMap n (a * a) = 0) (u v : List (Fin n))
    (hu : a.coeff (FreeMonoid.ofList u) ≠ 0) (hv : a.coeff (FreeMonoid.ofList v) ≠ 0) :
    ¬(u ++ v).Nodup := by
  classical
  intro huv
  let P (k : ℕ) := ∃ x y : List (Fin n), x.length + y.length = k ∧
    a.coeff (FreeMonoid.ofList x) ≠ 0 ∧ a.coeff (FreeMonoid.ofList y) ≠ 0 ∧ (x ++ y).Nodup
  have hP : ∃ k, P k := ⟨u.length + v.length, u, v, rfl, hu, hv, huv⟩
  obtain ⟨x, y, hxy, hx, hy, hnd⟩ := Nat.find_spec hP
  have hcoef := (wordMap_eq_zero.mp ha) (x ++ y) hnd
  rw [coeff_mul_eq_of_unique (a := a) (b := a)] at hcoef
  · exact (mul_ne_zero hx hy) hcoef
  · intro p q hpq hp hq
    obtain ⟨r, hxp, hyq⟩ | ⟨r, hpx, hqy⟩ := List.append_eq_append_iff.mp hpq
    · subst x
      subst q
      simp only [List.length_append] at hxy ⊢
      have hsub : (p ++ y).Sublist (p ++ r ++ y) :=
        List.Sublist.append (List.sublist_append_left p r) (List.Sublist.refl y)
      have hnd' : (p ++ y).Nodup := hsub.nodup hnd
      have hmin := Nat.find_min' hP (show P (p.length + y.length) from
        ⟨p, y, rfl, hp, hy, hnd'⟩)
      omega
    · subst p
      subst y
      simp only [List.length_append] at hxy ⊢
      have hsub : (x ++ q).Sublist (x ++ (r ++ q)) :=
        List.Sublist.append (List.Sublist.refl x) (List.sublist_append_right r q)
      have hnd' : (x ++ q).Nodup := hsub.nodup hnd
      have hmin := Nat.find_min' hP (show P (x.length + q.length) from
        ⟨x, q, rfl, hx, hq, hnd'⟩)
      omega

/-- If two words from the support of one element cannot be concatenated, inserting a
word between them still leaves a repeated letter. -/
private theorem map_mul_mul_eq_zero {n : ℕ} (a b c : WordAlgebra n)
    (h : ∀ u v : List (Fin n), a.coeff (FreeMonoid.ofList u) ≠ 0 →
      c.coeff (FreeMonoid.ofList v) ≠ 0 → ¬(u ++ v).Nodup) :
    wordMap n (a * b * c) = 0 := by
  apply wordMap_eq_zero.mpr
  intro w hw
  by_contra hn
  obtain ⟨uv, z, rfl, huv, hz⟩ := coeff_mul_ne_zero hn
  obtain ⟨x, y, rfl, hx, _⟩ := coeff_mul_ne_zero huv
  exact h x z hx hz <| (List.Sublist.append
    (List.sublist_append_left x y) (List.Sublist.refl z)).nodup hw

private theorem square_zero_sandwich {n : ℕ} (a b : WordRing n) (ha : a * a = 0) :
    a * b * a = 0 := by
  obtain ⟨a, rfl⟩ := (wordCongruence n).mk'_surjective a
  obtain ⟨b, rfl⟩ := (wordCongruence n).mk'_surjective b
  simp only [← map_mul] at ha ⊢
  exact map_mul_mul_eq_zero a b a (nodup_append_of_square_zero ha)

private noncomputable def augmentation (n : ℕ) : WordRing n →+* ZMod 2 where
  __ := coefficient [] List.nodup_nil
  map_one' := by change coefficient [] List.nodup_nil (1 : WordRing n) = 1; simp [coefficient_one]
  map_mul' a b := by
    obtain ⟨a, rfl⟩ := (wordCongruence n).mk'_surjective a
    obtain ⟨b, rfl⟩ := (wordCongruence n).mk'_surjective b
    change coefficient [] List.nodup_nil (wordMap n a * wordMap n b) =
      coefficient [] List.nodup_nil (wordMap n a) * coefficient [] List.nodup_nil (wordMap n b)
    rw [← map_mul, coefficient_map, coefficient_map, coefficient_map, coeff_mul]
    simp only [List.take_nil, List.drop_nil, List.length_nil]
    exact Fin.sum_univ_one _

private theorem coeff_pow_length {n : ℕ} (a : WordAlgebra n) (ha : a.coeff 1 = 0)
    (k : ℕ) (w : List (Fin n)) (hw : (a ^ k).coeff (FreeMonoid.ofList w) ≠ 0) :
    k ≤ w.length := by
  induction k generalizing w with
  | zero => exact Nat.zero_le _
  | succ k ih =>
    rw [pow_succ] at hw
    obtain ⟨u, v, rfl, hu, hv⟩ := coeff_mul_ne_zero hw
    have hlen := ih u hu
    have hpos : 0 < v.length := by
      cases v with
      | nil => exact (hv ha).elim
      | cons => simp
    rw [List.length_append]
    omega

private theorem pow_eq_zero_of_augmentation {n : ℕ} (a : WordRing n) (ha : augmentation n a = 0) :
    a ^ (n + 1) = 0 := by
  obtain ⟨a, rfl⟩ := (wordCongruence n).mk'_surjective a
  rw [← map_pow, wordMap_eq_zero]
  intro w hw
  by_contra h
  have hl := coeff_pow_length a (show a.coeff 1 = 0 from ha) (n + 1) w h
  have hm : w.length ≤ n := by simpa using hw.length_le_card
  omega

private theorem wordUnits_isPGroup (n : ℕ) : IsPGroup 2 (WordRing n)ˣ := by
  rw [isPGroup_iff_pow_pow_eq_one]
  intro u
  have hcoe : augmentation n (u : WordRing n) = 1 := by
    have hne : augmentation n (u : WordRing n) ≠ 0 :=
      isUnit_iff_ne_zero.mp (u.isUnit.map (augmentation n))
    exact (show ∀ c : ZMod 2, c = 0 ∨ c = 1 by decide) _ |>.resolve_left hne
  let a : WordRing n := (u : WordRing n) - 1
  have hu : (u : WordRing n) = 1 + a := by simp [a]
  have ha : augmentation n a = 0 := by simp [a, hcoe]
  refine ⟨n, Units.ext ?_⟩
  change (u : WordRing n) ^ (2 ^ n) = 1
  rw [hu, add_pow_char_pow_of_commute 2 n (Commute.one_left a), one_pow,
    pow_eq_zero_of_le Nat.lt_two_pow_self (pow_eq_zero_of_augmentation a ha), add_zero]

private theorem one_add_sq {n : ℕ} (a : WordRing n) :
    (1 + a) * (1 + a) = 1 + a * a := by
  simpa only [pow_two, one_mul] using add_pow_char_of_commute 2 (Commute.one_left a)

private theorem wordUnits_engel {n : ℕ} (x u : (WordRing n)ˣ) (hu : orderOf u = 2) :
    (x⁻¹ * u⁻¹ * x * u)⁻¹ * u⁻¹ * (x⁻¹ * u⁻¹ * x * u) * u = 1 := by
  have husq : u * u = 1 := by simpa [hu, pow_two] using pow_orderOf_eq_one u
  have huinv : u⁻¹ = u := inv_eq_of_mul_eq_one_left husq
  let a : WordRing n := (u : WordRing n) - 1
  have hval : (u : WordRing n) = 1 + a := by simp [a]
  have ha : a * a = 0 := by
    have hv := congrArg Units.val husq
    change (u : WordRing n) * (u : WordRing n) = 1 at hv
    simpa [hval, one_add_sq] using hv
  let X : WordRing n := x
  let Y : WordRing n := ↑(x⁻¹)
  have hyx : Y * X = 1 := x.inv_val
  have hc : Commute (x⁻¹ * u * x) u := by
    apply Units.val_injective
    change Y * (u : WordRing n) * X * (u : WordRing n) =
      (u : WordRing n) * (Y * (u : WordRing n) * X)
    have h₁ := square_zero_sandwich a X ha
    have h₂ := square_zero_sandwich a Y ha
    have h₂' : a * (Y * (a * X)) = 0 := by
      rw [← mul_assoc Y a X, ← mul_assoc a (Y * a) X, ← mul_assoc a Y a, h₂, zero_mul]
    rw [hval]
    noncomm_ring [hyx, ← mul_assoc a X a, h₁, h₂']
  have hh := hc.mul_left (Commute.refl u)
  have hcomm : Commute (x⁻¹ * u⁻¹ * x * u) u := by simpa [huinv] using hh
  calc
    _ = (x⁻¹ * u⁻¹ * x * u)⁻¹ * (u⁻¹ * (x⁻¹ * u⁻¹ * x * u)) * u := by
      rw [mul_assoc _ u⁻¹]
    _ = 1 := by rw [hcomm.inv_right.symm.eq, ← mul_assoc, inv_mul_cancel, one_mul, inv_mul_cancel]

private def SupportedOn {n : ℕ} (a : WordAlgebra n) (w : List (Fin n)) : Prop :=
  ∀ v : List (Fin n), a.coeff (FreeMonoid.ofList v) ≠ 0 →
    v.length = w.length ∧ ∀ i, i ∈ v ↔ i ∈ w

private theorem supportedOn_mul {n : ℕ} {a b : WordAlgebra n} {u v : List (Fin n)}
    (ha : SupportedOn a u) (hb : SupportedOn b v) : SupportedOn (a * b) (u ++ v) := by
  intro w hw
  obtain ⟨x, y, rfl, hx, hy⟩ := coeff_mul_ne_zero hw
  obtain ⟨hxl, hxm⟩ := ha x hx
  obtain ⟨hyl, hym⟩ := hb y hy
  simp only [List.length_append, hxl, hyl, List.mem_append, hxm, hym, true_and, implies_true]

private theorem supportedOn_mul_add_mul {n : ℕ} {a b : WordAlgebra n} {u v : List (Fin n)}
    (ha : SupportedOn a u) (hb : SupportedOn b v) :
    SupportedOn (a * b + b * a) (u ++ v) := by
  intro w hw
  by_cases hab : (a * b).coeff (FreeMonoid.ofList w) = 0
  · have hba : (b * a).coeff (FreeMonoid.ofList w) ≠ 0 := by simpa [hab] using hw
    obtain ⟨hlen, hmem⟩ := supportedOn_mul hb ha w hba
    exact ⟨by simpa [List.length_append, Nat.add_comm] using hlen,
      fun i ↦ by simpa [List.mem_append, or_comm] using hmem i⟩
  · exact supportedOn_mul ha hb w hab

private theorem supportedOn_sq_zero {n : ℕ} {a : WordAlgebra n} {w : List (Fin n)}
    (ha : SupportedOn a w) (hw : w ≠ []) : wordMap n a * wordMap n a = 0 := by
  obtain ⟨i, hi⟩ := List.exists_mem_of_ne_nil w hw
  rw [← map_mul, wordMap_eq_zero]
  intro v hv
  by_contra hc
  obtain ⟨x, y, rfl, hx, hy⟩ := coeff_mul_ne_zero hc
  exact (List.disjoint_left.mp hv.disjoint) ((ha x hx).2 i |>.mpr hi)
    ((ha y hy).2 i |>.mpr hi)

private theorem coeff_mul_of_supportedOn {n : ℕ} {a b : WordAlgebra n} {u v : List (Fin n)}
    (ha : SupportedOn a u) (hb : SupportedOn b v) (hu : u ≠ []) (hv : v ≠ [])
    (huv : (u ++ v).Nodup) :
    (a * b + b * a).coeff (FreeMonoid.ofList (u ++ v)) =
      a.coeff (FreeMonoid.ofList u) * b.coeff (FreeMonoid.ofList v) := by
  have hba : (b * a).coeff (FreeMonoid.ofList (u ++ v)) = 0 := by
    by_contra hc
    obtain ⟨p, q, hpq, hp, _⟩ := coeff_mul_ne_zero hc
    obtain ⟨hlen, hmem⟩ := hb p hp
    match u, p with
    | [], _ => exact hu rfl
    | _ :: _, [] => exact hv (List.length_eq_zero_iff.mp hlen.symm)
    | i :: us, j :: ps =>
      have hj : j ∈ v := (hmem j).mp (by simp)
      have hij : j = i := (List.cons.inj hpq).1
      exact (List.disjoint_left.mp huv.disjoint) (show i ∈ i :: us by simp) (hij ▸ hj)
  simp only [MonoidAlgebra.coeff_add, Finsupp.add_apply, hba, add_zero]
  exact coeff_mul_eq_of_unique fun x _ _ hx _ ↦ (ha x hx).1

private noncomputable abbrev letterMonomial {n : ℕ} (i : Fin n) : WordAlgebra n :=
  MonoidAlgebra.single (FreeMonoid.ofList [i]) 1

private theorem letterMonomial_supported {n : ℕ} (i : Fin n) :
    SupportedOn (letterMonomial i) [i] := by
  classical
  intro v hv
  have heq : FreeMonoid.ofList [i] = FreeMonoid.ofList v := by
    by_contra h
    apply hv
    rw [MonoidAlgebra.coeff_single, Finsupp.single_apply, ite_eq_right h]
  have hd := congrArg FreeMonoid.toList heq
  change [i] = v at hd
  subst v
  simp

private noncomputable def letterUnit {n : ℕ} (i : Fin n) : (WordRing n)ˣ :=
  let a := wordMap n (letterMonomial i)
  have h : (1 + a) * (1 + a) = 1 := by
    rw [one_add_sq, supportedOn_sq_zero (letterMonomial_supported i) (by simp), add_zero]
  ⟨1 + a, 1 + a, h, h⟩

private theorem letterUnit_order {n : ℕ} (i : Fin n) : orderOf (letterUnit i) = 2 := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine orderOf_eq_prime (by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, pow_two]
    exact (letterUnit i).val_inv) ?_
  intro h
  have hc := congrArg (fun u : (WordRing n)ˣ ↦
    coefficient [i] (List.nodup_singleton i) (u : WordRing n)) h
  change coefficient [i] (List.nodup_singleton i) (1 + wordMap n (letterMonomial i)) =
    coefficient [i] (List.nodup_singleton i) 1 at hc
  simp only [map_add, coefficient_one, coefficient_map, MonoidAlgebra.coeff_single,
    Finsupp.single_eq_same, List.cons_ne_nil, ite_false, zero_add] at hc
  exact one_ne_zero hc

private noncomputable abbrev exampleGroup (n : ℕ) : Subgroup (WordRing n)ˣ :=
  Subgroup.closure (Set.range (letterUnit (n := n)))

private noncomputable def letter {n : ℕ} (i : Fin n) : exampleGroup n :=
  ⟨letterUnit i, Subgroup.subset_closure ⟨i, rfl⟩⟩

private noncomputable abbrev groupVal (n : ℕ) : exampleGroup n →* WordRing n :=
  (Units.coeHom (WordRing n)).comp (exampleGroup n).subtype

private theorem groupVal_injective (n : ℕ) : Function.Injective (groupVal n) :=
  Units.val_injective.comp Subtype.val_injective

private theorem exampleGroup_isInvolutionEngel (n : ℕ) :
    IsInvolutionEngelTwoGroup (exampleGroup n) := by
  refine ⟨(wordUnits_isPGroup n).to_subgroup _, ?_, ?_⟩
  · apply top_unique
    rw [← Subgroup.closure_preimage_eq_top (Set.range (letterUnit (n := n)))]
    apply Subgroup.closure_mono
    rintro g ⟨i, hi⟩
    change orderOf g = 2
    rw [← orderOf_injective (exampleGroup n).subtype Subtype.val_injective g, ← hi]
    exact letterUnit_order i
  · intro x u hu
    apply Subtype.val_injective
    exact wordUnits_engel (x : (WordRing n)ˣ) u
      ((orderOf_injective (exampleGroup n).subtype Subtype.val_injective u).trans hu)

private theorem commutator_groupVal {n : ℕ} (x y : exampleGroup n) (a b : WordRing n)
    (hx : groupVal n x = 1 + a) (hy : groupVal n y = 1 + b)
    (ha : a * a = 0) (hb : b * b = 0) :
    groupVal n ⁅x, y⁆ = 1 + (a * b + b * a) := by
  have hxinv : x⁻¹ = x := by
    apply inv_eq_of_mul_eq_one_left
    apply groupVal_injective n
    rw [map_mul, map_one, hx, one_add_sq, ha, add_zero]
  have hyinv : y⁻¹ = y := by
    apply inv_eq_of_mul_eq_one_left
    apply groupVal_injective n
    rw [map_mul, map_one, hy, one_add_sq, hb, add_zero]
  simp only [commutatorElement_def, hxinv, hyinv, map_mul, hx, hy]
  have hab : a * (b * a) = 0 := by
    rw [← mul_assoc, square_zero_sandwich a b ha]
  have hba : b * (a * b) = 0 := by
    rw [← mul_assoc, square_zero_sandwich b a hb]
  calc
    _ = (1 + b + a * b + b * a + (a + a)) * (1 + b) := by
      congr 1
      noncomm_ring [ha, hab]
    _ = 1 + (a * b + b * a) + (b + b) := by
      rw [CharTwo.add_self_eq_zero a, add_zero]
      noncomm_ring [hb, hba]
    _ = _ := by rw [CharTwo.add_self_eq_zero, add_zero]

private theorem exists_derived_word (n d : ℕ) (w : List (Fin n)) (hw : w.Nodup)
    (hlen : w.length = 2 ^ d) :
    ∃ g ∈ Subgroup.derivedSeries (exampleGroup n) d, ∃ a : WordAlgebra n,
      SupportedOn a w ∧ a.coeff (FreeMonoid.ofList w) = 1 ∧ groupVal n g = 1 + wordMap n a := by
  induction d generalizing w with
  | zero =>
    obtain ⟨i, rfl⟩ := List.length_eq_one_iff.mp (by simpa using hlen)
    exact ⟨letter i, by simp, letterMonomial i, letterMonomial_supported i,
      by simp [MonoidAlgebra.coeff_single], rfl⟩
  | succ d ih =>
    let u := w.take (2 ^ d)
    let v := w.drop (2 ^ d)
    have huv : u ++ v = w := List.take_append_drop _ _
    have hlen' : w.length = 2 ^ d + 2 ^ d := by rw [hlen, pow_succ, Nat.mul_two]
    have hu : u.length = 2 ^ d := by simp [u, hlen']
    have hv : v.length = 2 ^ d := by simp [v, hlen']
    have hnd : (u ++ v).Nodup := huv.symm ▸ hw
    obtain ⟨x, hx, a, ha, hca, hxa⟩ := ih u (List.nodup_append'.mp hnd).1 hu
    obtain ⟨y, hy, b, hb, hcb, hyb⟩ := ih v (List.nodup_append'.mp hnd).2.1 hv
    have hne (l : List (Fin n)) (hl : l.length = 2 ^ d) : l ≠ [] :=
      fun e ↦ (Nat.two_pow_pos d).ne' (by simpa [e] using hl.symm)
    refine ⟨⁅x, y⁆, Subgroup.commutator_mem_commutator hx hy, a * b + b * a, ?_, ?_, ?_⟩
    · rw [← huv]
      exact supportedOn_mul_add_mul ha hb
    · rw [← huv, coeff_mul_of_supportedOn ha hb (hne u hu) (hne v hv) hnd, hca, hcb, one_mul]
    · rw [commutator_groupVal x y _ _ hxa hyb
        (supportedOn_sq_zero ha (hne u hu)) (supportedOn_sq_zero hb (hne v hv)),
        map_add, map_mul, map_mul]

/--
**Negative answer to Kourovka Problem 18.57.** There is no natural number $d$ such that
$G^{(d)} = 1$ for every finite group $G$ in which every element has order a power of $2$, which is
generated by its involutions, and in which $[[x, u], u] = 1$ for every $x \in G$ and every
involution $u \in G$; here $[x, u] = x^{-1} u^{-1} x u$ and $G^{(d)}$ is the $d$-th term of the
derived series of $G$. Thus the derived length of such groups is unbounded.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved
Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of
Solved Problems, Problem 18.57 (D. V. Lytkina); resolution: A. Abdollahi, J. Group Theory 18 (2015),
no. 1, 111-114, Kourovka Archive, Problem 18.57: No, it is not, https://arxiv.org/abs/1401.0300v49.
-/
theorem involutionEngelTwoGroupsBoundedDerivedLength_refuted :
    ¬ involutionEngelTwoGroupsBoundedDerivedLength := by
  rintro ⟨d, hd⟩
  let n := 2 ^ d
  have htriv := hd (exampleGroup n) (exampleGroup_isInvolutionEngel n)
  obtain ⟨g, hg, a, _, ha, hga⟩ :=
    exists_derived_word n d (List.finRange n) (List.nodup_finRange n) List.length_finRange
  have hone : g = 1 := Subgroup.mem_bot.mp (htriv ▸ hg)
  rw [hone, map_one, eq_comm, add_eq_left] at hga
  have h := (wordMap_eq_zero.mp hga) (List.finRange n) (List.nodup_finRange n)
  exact one_ne_zero (ha.symm.trans h)

end MathlibExt.GroupTheory.InvolutionEngelTwoGroupDerivedLengthKourovka18Problem57Wanted
