module

public import Mathlib.GroupTheory.Solvable
public import MathlibExt.GroupTheory.FittingSubgroup
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Inclusion-minimal triple intersections and the Fitting subgroup

`inclusionMinimalIntersectionsInFitting_refuted` answers Kourovka Notebook Problem 20.122(b)
for finite soluble groups. The counterexample uses two copies of the permutation module
of the symmetric group on three letters over the field of two elements. The soluble group of
Kinyon and Urban described in the theorem's docstring has order `36864`; the proof here uses
instead this group of order `384`.

Take `A` to be the preimage of the stabilizer of letter 0. Its subgroups `B` and `C`
fix the bit at 0 in the first and second copies respectively. Conjugating either subgroup
permutes the letter at which its bit is constrained. The intersection at the original pair
is inclusion-minimal and contains the transposition of the other two letters. The image of
the Fitting subgroup in the symmetric group centralizes a three-cycle, excluding this
transposition.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.MinimalIntersectionsFittingKourovka20Problem122Wanted

open MathlibExt.GroupTheory.NilpotentThreeConjugatesFittingKourovka17Problem40Wanted
  (fittingSubgroup)

/-- **Triple intersections with conjugates.** For subgroups $A$, $B$, $C$ of a group $G$, this is
the set of all subgroups of $G$ of the form $A \cap xBx^{-1} \cap yCy^{-1}$ with $x, y \in G$,
that is, the intersections of $A$ with a conjugate of $B$ and a conjugate of $C$. -/
def tripleIntersections {G : Type} [Group G] (A B C : Subgroup G) : Set (Subgroup G) :=
  {D | ∃ x y : G,
    D = A ⊓ B.map (MulAut.conj x).toMonoidHom ⊓ C.map (MulAut.conj y).toMonoidHom}

/-- **Subgroup generated by the inclusion-minimal triple intersections.** For subgroups $A$, $B$,
$C$ of a group $G$, the subgroup $\mathrm{Min}_G(A, B, C)$ is the subgroup of $G$ generated by
those intersections $A \cap xBx^{-1} \cap yCy^{-1}$ ($x, y \in G$) that are minimal by inclusion
among all such intersections, that is, that contain no other intersection of this form. -/
def inclusionMinimalIntersectionJoin {G : Type} [Group G] (A B C : Subgroup G) : Subgroup G :=
  sSup {D | D ∈ tripleIntersections A B C ∧ ∀ E ∈ tripleIntersections A B C, E ≤ D → E = D}

/-- **Inclusion-minimal triple intersections and the Fitting subgroup (Kourovka 20.122(b), (c)).**
The statement that for every finite soluble group $G$ and all nilpotent subgroups $A$, $B$, $C$ of
$G$, the subgroup $\mathrm{Min}_G(A, B, C)$ generated by those intersections
$A \cap xBx^{-1} \cap yCy^{-1}$ ($x, y \in G$) that are minimal by inclusion among all such
intersections is contained in the Fitting subgroup $F(G)$, the join of all nilpotent normal
subgroups of $G$. -/
def inclusionMinimalIntersectionsInFitting : Prop :=
  ∀ (G : Type) [Group G] [Finite G], Group.IsSolvable G → ∀ A B C : Subgroup G,
    Group.IsNilpotent A → Group.IsNilpotent B → Group.IsNilpotent C →
      inclusionMinimalIntersectionJoin A B C ≤ fittingSubgroup G

private abbrev Perm := Equiv.Perm (Fin 3)
private abbrev Bit := Multiplicative (ZMod 2)
private abbrev Base := Fin 3 → Bool → Bit

private def reindex : Perm →* MulAut Base where
  toFun p := MulEquiv.arrowCongr p (MulEquiv.refl _)
  map_one' := rfl
  map_mul' _ _ := rfl

private abbrev G := Base ⋊[reindex] Perm
private abbrev proj : G →* Perm := SemidirectProduct.rightHom

private instance finiteGroup : Finite G :=
  Finite.of_equiv (Base × Perm) SemidirectProduct.equivProd.symm

private theorem isSolvable_group : Group.IsSolvable G := by
  have : Group.IsSolvable Perm := Equiv.Perm.isSolvable (by simp)
  exact Group.isSolvable_of_ker_le_range SemidirectProduct.inl proj
    SemidirectProduct.range_inl_eq_ker_rightHom.ge

-- In each of two copies of the three letters, every letter carries an independent bit.
private abbrev Point := (Fin 3 × Bool) × Bit

private instance pointAction : MulAction G Point where
  smul g z := ((g.right z.1.1, z.1.2), g.left (g.right z.1.1) z.1.2 * z.2)
  one_smul z := by
    change ((z.1.1, z.1.2), 1 * z.2) = z
    rw [one_mul]
  mul_smul g h z := by
    rcases z with ⟨⟨i, c⟩, b⟩
    let j := h.right i
    change ((g.right j, c), (g.left (g.right j) c * h.left (g.right.symm (g.right j)) c) * b) =
      ((g.right j, c), g.left (g.right j) c * (h.left j c * b))
    rw [Equiv.symm_apply_apply, mul_assoc]

private def fiberStab (i : Fin 3) (c : Bool) : Subgroup G :=
  MulAction.stabilizer G ((i, c), (1 : Bit))

private theorem mem_pointStab (g : G) (i : Fin 3) (c : Bool) (b : Bit) :
    g ∈ MulAction.stabilizer G ((i, c), b) ↔ g.right i = i ∧ g.left i c = 1 := by
  change ((g.right i, c), g.left (g.right i) c * b) = ((i, c), b) ↔ _
  simp +contextual

private theorem fiberStab_conj (x : G) (i : Fin 3) (c : Bool) :
    (fiberStab i c).map (MulAut.conj x).toMonoidHom = fiberStab (x.right i) c := by
  rw [fiberStab, ← MulAction.stabilizer_smul_eq_stabilizer_map_conj]
  ext g
  exact (mem_pointStab g _ _ _).trans (mem_pointStab g _ _ _).symm

private abbrev letterStab : Subgroup G :=
  (MulAction.stabilizer Perm (0 : Fin 3)).comap proj

private theorem letterStab_isPGroup : IsPGroup 2 letterStab := by
  have hs : ∀ p : Perm, p 0 = 0 → p ^ 2 = 1 := by decide
  have hb : ∀ b : Bit, b * b = 1 := by decide
  intro g
  refine ⟨2, Subtype.ext ?_⟩
  have hright : (g.val ^ 2).right = 1 :=
    (proj.map_pow _ _).trans (hs _ g.property)
  change g.val ^ (2 * 2) = 1
  rw [pow_mul, sq]
  apply SemidirectProduct.ext
  · funext i c
    simpa only [SemidirectProduct.mul_left, hright, map_one, MulAut.one_apply,
      Pi.mul_apply, SemidirectProduct.one_left, Pi.one_apply] using hb ((g.val ^ 2).left i c)
  · simp [hright]

private theorem fiberStab_nilpotent (c : Bool) : Group.IsNilpotent (fiberStab 0 c) :=
  (letterStab_isPGroup.to_le (fun _ hg => ((mem_pointStab _ _ _ _).mp hg).1)).isNilpotent

private abbrev intersection (i j : Fin 3) : Subgroup G :=
  letterStab ⊓ fiberStab i false ⊓ fiberStab j true

private theorem mem_intersection (g : G) (i j : Fin 3) :
    g ∈ intersection i j ↔ g.right 0 = 0 ∧
      (g.right i = i ∧ g.left i false = 1) ∧ (g.right j = j ∧ g.left j true = 1) := by
  change (_ ∧ g ∈ MulAction.stabilizer G _) ∧ g ∈ MulAction.stabilizer G _ ↔ _
  rw [mem_pointStab, mem_pointStab]
  exact and_assoc

-- A single nonzero bit at letter 0 detects any change in either constrained coordinate.
private def flip (c : Bool) : G :=
  SemidirectProduct.inl fun i d => if i = 0 ∧ d = c then Multiplicative.ofAdd 1 else 1

private theorem intersection_minimal (i j : Fin 3) (h : intersection i j ≤ intersection 0 0) :
    intersection i j = intersection 0 0 := by
  have bit_ne : (Multiplicative.ofAdd (1 : ZMod 2)) ≠ 1 := by decide
  have hi : i = 0 := by
    by_contra hne
    have hg : flip false ∈ intersection i j := by
      rw [mem_intersection]
      simp [flip, hne]
    have := ((mem_intersection _ _ _).mp (h hg)).2.1.2
    simp [flip, bit_ne] at this
  have hj : j = 0 := by
    by_contra hne
    have hg : flip true ∈ intersection i j := by
      rw [mem_intersection]
      simp [flip, hne]
    have := ((mem_intersection _ _ _).mp (h hg)).2.2.2
    simp [flip, bit_ne] at this
  rw [hi, hj]

private theorem intersection_le_join :
    intersection 0 0 ≤ inclusionMinimalIntersectionJoin letterStab
      (fiberStab 0 false) (fiberStab 0 true) := by
  apply le_sSup
  constructor
  · exact ⟨1, 1, by rw [fiberStab_conj, fiberStab_conj]; rfl⟩
  · rintro _ ⟨x, y, rfl⟩
    simpa only [fiberStab_conj] using intersection_minimal (x.right 0) (y.right 0)

private abbrev transposition : Perm := Equiv.swap 1 2
private abbrev cycle : Perm := Equiv.swap 0 1 * transposition

-- Every normal subgroup of S₃ containing a transposition contains all the generators.
private theorem normal_nilpotent_le_centralizer (N : Subgroup Perm) [N.Normal]
    [Group.IsNilpotent N] : N ≤ Subgroup.centralizer {cycle} := by
  intro p hp
  rw [Subgroup.mem_centralizer_singleton_iff]
  by_contra h
  have hswap : ∀ q : Perm, q * cycle ≠ cycle * q →
      ∃ i j : Fin 3, i ≠ j ∧ q = Equiv.swap i j := by decide
  obtain ⟨i, j, hij, rfl⟩ := hswap p h
  have htop : N = ⊤ := by
    apply top_unique
    rintro q -
    induction q using Equiv.Perm.swap_induction_on with
    | one => exact N.one_mem
    | swap_mul q a b hab ih =>
      obtain ⟨g, hg⟩ := isConj_iff.mp (Equiv.Perm.isConj_swap hij hab)
      exact N.mul_mem (hg ▸ Subgroup.Normal.conj_mem _ hp g) ih
  have : Group.IsNilpotent Perm := Group.isNilpotent_top.mp (htop ▸ ‹Group.IsNilpotent N›)
  apply Group.IsNilpotent.center_ne_bot Perm
  rw [Subgroup.eq_bot_iff_forall]
  have hz : ∀ q : Perm, (∀ r : Perm, r * q = q * r) → q = 1 := by decide
  exact fun q hq => hz q (Subgroup.mem_center_iff.mp hq)

private theorem fitting_le : fittingSubgroup G ≤ (Subgroup.centralizer {cycle}).comap proj := by
  refine iSup_le fun N => iSup_le fun hn => iSup_le fun hnil => ?_
  have : (N.map proj).Normal := hn.map proj SemidirectProduct.rightHom_surjective
  have : Group.IsNilpotent (N.map proj) :=
    Group.nilpotent_of_surjective (proj.subgroupMap N) (proj.subgroupMap_surjective N)
  exact Subgroup.map_le_iff_le_comap.mp (normal_nilpotent_le_centralizer _)

/--
**Inclusion-minimal triple intersections need not lie in the Fitting subgroup.** It is not true
that for every finite soluble group $G$ and all nilpotent subgroups $A$, $B$, $C$ of $G$, the
subgroup $\mathrm{Min}_G(A, B, C)$ generated by those intersections
$A \cap xBx^{-1} \cap yCy^{-1}$ ($x, y \in G$) that are minimal by inclusion among all such
intersections is contained in the Fitting subgroup $F(G)$, the join of all nilpotent normal
subgroups of $G$.

Kinyon and Urban (Section 3.38) give a soluble group $G$ of order $36864$ with nilpotent subgroups
$A$ of order $16$ and $B = C$ of order $2048$ such that $\mathrm{Min}_G(A, B, B) = A$ while $F(G)$
does not contain $A$. Since this group is soluble, it answers part (c), and hence part (b), in the
negative.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved
Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem
20.122 (V. I. Zenkov); resolution: M. Kinyon and J. Urban, Results on problems from the Kourovka
Notebook, preprint, version 4, 19 September 2026, Kinyon-Urban, Section 3.38 (Problem
20.122(a)-(c)): G = E ⋊ Q soluble of order 512 · 72 = 36864, A = Z × H of order 16 and B = C the
stabilizer of order 2048 are nilpotent, min_G(A, B, B) = Min_G(A, B, B) = A and F(G) = E does not
contain A; the Kourovka Notebook (21st issue) marks 20.122 solved, "No, it is not always true in all
three cases" (AI solution confirmed by V. I. Zenkov),
https://kourovkanotebookorg.wordpress.com/wp-content/uploads/2026/09/kourovka-mathematics.pdf.
-/
theorem inclusionMinimalIntersectionsInFitting_refuted :
    ¬ inclusionMinimalIntersectionsInFitting := by
  intro h
  have hm : SemidirectProduct.inr transposition ∈ intersection 0 0 := by
    rw [mem_intersection]
    decide
  have hf := h G isSolvable_group letterStab (fiberStab 0 false) (fiberStab 0 true)
    letterStab_isPGroup.isNilpotent (fiberStab_nilpotent _) (fiberStab_nilpotent _)
  have hc := fitting_le (hf (intersection_le_join hm))
  exact (by decide : transposition * cycle ≠ cycle * transposition)
    (Subgroup.mem_centralizer_singleton_iff.mp hc)

end MathlibExt.GroupTheory.MinimalIntersectionsFittingKourovka20Problem122Wanted
