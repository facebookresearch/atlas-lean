/-!
# Zenkov's rank bound in elementary abelian extensions

A semidirect product of order `3^8` refutes the proposed bound on the rank of the
intersection of the centre and the derived subgroup in Kourovka Notebook Problem 21.150.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.CentreDerivedRankExtensionKourovka21Problem150Wanted

/-- **Elementary abelian subgroups.** A subgroup $H$ of a group $G$ is elementary abelian if any
two of its elements commute and there is a prime $p$ with $x^p = 1$ for all $x \in H$. -/
def IsElementaryAbelian {G : Type} [Group G] (H : Subgroup G) : Prop :=
  (∀ x ∈ H, ∀ y ∈ H, x * y = y * x) ∧ ∃ p : ℕ, p.Prime ∧ ∀ x ∈ H, x ^ p = 1

/-- **Zenkov's rank bound in elementary abelian extensions (Kourovka 21.150).** Call a subgroup
elementary abelian if it is abelian and there is a prime $p$ with $x^p = 1$ for all its elements
$x$. This is the proposition that for every finite group $G$, all elementary abelian subgroups $A$
and $B$ of $G$ (possibly for different primes) with $A$ normal, $A \cap B = 1$ and
$\langle A, B \rangle = G$ (so $B$ is a complement to $A$ and $B \cong G/A$), and every $a \in A$
whose centralizer $C_B(a)$ in $B$ is trivial, the following holds for $H = \langle a, B \rangle$,
with centre $Z(H)$ and derived subgroup $H' = [H, H]$: whenever $B$ is generated by a finite set of
$k$ elements, $Z(H) \cap H'$ (with $Z(H)$ viewed as a subgroup of $G$) is generated by a finite set
of at most $k$ elements. That is, the rank of $Z(H) \cap H'$ is at most the rank of $B$.

The question is due to V. I. Zenkov. -/
def centreDerivedRankLeComplementRank : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A B : Subgroup G) (a : G), A.Normal →
    IsElementaryAbelian A → IsElementaryAbelian B → A ⊓ B = ⊥ → A ⊔ B = ⊤ → a ∈ A →
    (∀ b ∈ B, b * a = a * b → b = 1) →
    ∀ s : Finset G, Subgroup.closure (s : Set G) = B →
      ∃ t : Finset G, t.card ≤ s.card ∧ Subgroup.closure (t : Set G) =
        (Subgroup.center (Subgroup.closure {a} ⊔ B : Subgroup G)).map
            (Subgroup.closure {a} ⊔ B : Subgroup G).subtype ⊓
          ⁅Subgroup.closure {a} ⊔ B, Subgroup.closure {a} ⊔ B⁆

open scoped commutatorElement

private abbrev F := ZMod 3
private abbrev V := Fin 6 → F
private abbrev W := F × F

-- Coordinates in the basis 1, x, y, x², xy, y². The action is multiplication by
-- (1 + x)^r (1 + y)^s in the ring with monomials of degree at least three set to zero.
private def act (r s : F) (v : V) : V :=
  ![v 0, v 1 + r * v 0, v 2 + s * v 0,
    v 3 + r * v 1 + (r * (r - 1) / 2) * v 0,
    v 4 + r * v 2 + s * v 1 + r * s * v 0,
    v 5 + s * v 2 + (s * (s - 1) / 2) * v 0]

private lemma act_zero (v : V) : act 0 0 v = v := by
  funext i
  fin_cases i <;> simp [act]

private lemma choose_add (r u : F) :
    (r + u) * (r + u - 1) / 2 = r * (r - 1) / 2 + u * (u - 1) / 2 + r * u := by
  rw [div_eq_iff (show (2 : F) ≠ 0 by decide)]
  simp only [add_mul, div_mul_cancel₀ _ (show (2 : F) ≠ 0 by decide)]
  ring

private lemma act_comp (r s u w : F) (v : V) :
    act r s (act u w v) = act (r + u) (s + w) v := by
  funext i
  fin_cases i <;> simp [act, choose_add] <;> ring

private def actEquiv (r s : F) : V ≃+ V where
  toFun := act r s
  invFun := act (-r) (-s)
  left_inv v := by
    rw [act_comp, neg_add_cancel, neg_add_cancel, act_zero]
  right_inv v := by
    rw [act_comp, add_neg_cancel, add_neg_cancel, act_zero]
  map_add' a b := by
    funext i
    fin_cases i <;> simp [act, Pi.add_apply] <;> ring

private def action : Multiplicative W →* MulAut (Multiplicative V) where
  toFun g := (actEquiv g.toAdd.1 g.toAdd.2).toMultiplicative
  map_one' := by
    apply MulEquiv.ext
    intro v
    exact congrArg Multiplicative.ofAdd (act_zero v.toAdd)
  map_mul' g h := by
    apply MulEquiv.ext
    intro v
    exact congrArg Multiplicative.ofAdd
      (act_comp g.toAdd.1 g.toAdd.2 h.toAdd.1 h.toAdd.2 v.toAdd).symm


private lemma action_apply (w : Multiplicative W) (v : V) :
    action w (Multiplicative.ofAdd v) =
      Multiplicative.ofAdd (act w.toAdd.1 w.toAdd.2 v) := rfl

private abbrev G := Multiplicative V ⋊[action] Multiplicative W
private abbrev inl : Multiplicative V →* G := SemidirectProduct.inl
private abbrev inr : Multiplicative W →* G := SemidirectProduct.inr
private abbrev A : Subgroup G := inl.range
private abbrev B : Subgroup G := inr.range

private def basisVector (i : Fin 6) : V := Pi.single i 1
private def monomial (i : Fin 6) : G := inl (Multiplicative.ofAdd (basisVector i))
private def bX : G := inr (Multiplicative.ofAdd (1, 0))
private def bY : G := inr (Multiplicative.ofAdd (0, 1))

private abbrev H : Subgroup G := Subgroup.closure {monomial 0} ⊔ B
private abbrev D : Subgroup G := (Subgroup.center H).map H.subtype ⊓ ⁅H, H⁆

private lemma elementaryAbelian_range {M : Type} [AddCommGroup M] [Module F M]
    (f : Multiplicative M →* G) : IsElementaryAbelian f.range := by
  refine ⟨?_, 3, by decide, ?_⟩
  · rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    rw [← map_mul, ← map_mul, mul_comm x y]
  · rintro _ ⟨x, rfl⟩
    have hx : x ^ 3 = 1 := by
      change 3 • x.toAdd = 0
      rw [← Nat.cast_smul_eq_nsmul F, ZMod.natCast_self, zero_smul]
    rw [← map_pow, hx, map_one]

private lemma A_normal : A.Normal := by
  change inl.range.Normal
  rw [SemidirectProduct.range_inl_eq_ker_rightHom]
  infer_instance

private lemma A_inf_B : A ⊓ B = ⊥ := by
  apply le_antisymm ?_ bot_le
  rintro _ ⟨hx, ⟨w, rfl⟩⟩
  have hw : w = 1 := by
    simpa [A, SemidirectProduct.range_inl_eq_ker_rightHom, MonoidHom.mem_ker] using hx
  simp [hw]

private lemma A_sup_B : A ⊔ B = ⊤ := by
  apply top_unique
  intro g _
  rw [← SemidirectProduct.inl_left_mul_inr_right g]
  exact Subgroup.mul_mem_sup (S := A) (T := B) ⟨g.left, rfl⟩ ⟨g.right, rfl⟩

private lemma stabilizer_trivial :
    ∀ b ∈ B, b * monomial 0 = monomial 0 * b → b = 1 := by
  rintro _ ⟨w, rfl⟩ hw
  have hv : act w.toAdd.1 w.toAdd.2 (basisVector 0) = basisVector 0 := by
    have h := congrArg SemidirectProduct.left hw
    simp only [monomial, SemidirectProduct.mul_left, SemidirectProduct.left_inl,
      SemidirectProduct.right_inl, SemidirectProduct.left_inr, SemidirectProduct.right_inr,
      one_mul, map_one, mul_one, action_apply] at h
    exact congrArg Multiplicative.toAdd h
  have h₁ : w.toAdd.1 = 0 := by
    simpa [act, basisVector, Pi.single_apply] using congrFun hv 1
  have h₂ : w.toAdd.2 = 0 := by
    simpa [act, basisVector, Pi.single_apply] using congrFun hv 2
  have hw' : w = 1 := Prod.ext h₁ h₂
  simp [hw']

private lemma closure_pair : Subgroup.closure ({bX, bY} : Set G) = B := by
  have hx : bX ∈ Subgroup.closure ({bX, bY} : Set G) := Subgroup.subset_closure (by simp)
  have hy : bY ∈ Subgroup.closure ({bX, bY} : Set G) := Subgroup.subset_closure (by simp)
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact ⟨Multiplicative.ofAdd (1, 0), rfl⟩
    · exact ⟨Multiplicative.ofAdd (0, 1), rfl⟩
  · rintro _ ⟨w, rfl⟩
    have hw : (Multiplicative.ofAdd ((1, 0) : W)) ^ w.toAdd.1.val *
        (Multiplicative.ofAdd ((0, 1) : W)) ^ w.toAdd.2.val = w := by
      change w.toAdd.1.val • ((1, 0) : W) + w.toAdd.2.val • ((0, 1) : W) = w.toAdd
      apply Prod.ext
      · change w.toAdd.1.val • (1 : F) + w.toAdd.2.val • (0 : F) = w.toAdd.1
        simp
      · change w.toAdd.1.val • (0 : F) + w.toAdd.2.val • (1 : F) = w.toAdd.2
        simp
    rw [← hw, map_mul, map_pow, map_pow]
    exact Subgroup.mul_mem _ (Subgroup.pow_mem _ hx _) (Subgroup.pow_mem _ hy _)

private lemma commutator_le_A : ⁅H, H⁆ ≤ A := by
  change ⁅H, H⁆ ≤ inl.range
  rw [SemidirectProduct.range_inl_eq_ker_rightHom]
  refine Subgroup.commutator_le.mpr fun g _ h _ => ?_
  rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
  exact mul_comm _ _

-- Commuting with all of G suffices for an element of H to lie in the centre of H.
private lemma monomial_mem_mapped_center (j : Fin 3) (hj : monomial (Fin.natAdd 3 j) ∈ H) :
    monomial (Fin.natAdd 3 j) ∈ (Subgroup.center H).map H.subtype := by
  refine ⟨⟨_, hj⟩, Subgroup.mem_center_iff.mpr fun g => Subtype.ext ?_, rfl⟩
  have hfixed (w : Multiplicative W) :
      act w.toAdd.1 w.toAdd.2 (basisVector (Fin.natAdd 3 j)) =
        basisVector (Fin.natAdd 3 j) := by
    funext i
    fin_cases j <;> fin_cases i <;> simp [act, basisVector, Fin.natAdd]
  apply SemidirectProduct.ext
  · change g.val.left * (action g.val.right) (Multiplicative.ofAdd (basisVector _)) =
      Multiplicative.ofAdd (basisVector _) * (action 1) g.val.left
    have h : action g.val.right (Multiplicative.ofAdd (basisVector (Fin.natAdd 3 j))) =
        Multiplicative.ofAdd (basisVector (Fin.natAdd 3 j)) :=
      congrArg Multiplicative.ofAdd (hfixed g.val.right)
    rw [h, map_one, MulAut.one_apply, mul_comm]
  · change g.val.right * 1 = 1 * g.val.right
    simp

private lemma commutator_monomial (w : Multiplicative W) (j : Fin 6) :
    ⁅inr w, monomial j⁆ =
      inl (Multiplicative.ofAdd (act w.toAdd.1 w.toAdd.2 (basisVector j) - basisVector j)) := by
  rw [commutatorElement_def, monomial, ← map_inv inr, ← SemidirectProduct.inl_aut,
    action_apply, ← map_inv inl, ← map_mul]
  rw [sub_eq_add_neg]
  rfl

-- Taking a commutator with the two generators multiplies the monomial by x or y.
private lemma monomial_commutators :
    ⁅bX, monomial 0⁆ = monomial 1 ∧ ⁅bY, monomial 0⁆ = monomial 2 ∧
    ⁅bX, monomial 1⁆ = monomial 3 ∧ ⁅bX, monomial 2⁆ = monomial 4 ∧
    ⁅bY, monomial 2⁆ = monomial 5 := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  all_goals
    simp only [bX, bY]
    rw [commutator_monomial, monomial]
    apply congrArg (fun v : V => inl (Multiplicative.ofAdd v))
    funext i
    fin_cases i <;> simp [act, basisVector, Pi.sub_apply]

private lemma quadratic_mem (j : Fin 3) : monomial (Fin.natAdd 3 j) ∈ D := by
  have ha : monomial 0 ∈ H :=
    Subgroup.mem_sup_left (Subgroup.subset_closure (Set.mem_singleton _))
  have hx : bX ∈ H := Subgroup.mem_sup_right (S := Subgroup.closure {monomial 0})
    (show bX ∈ B from ⟨Multiplicative.ofAdd (1, 0), rfl⟩)
  have hy : bY ∈ H := Subgroup.mem_sup_right (S := Subgroup.closure {monomial 0})
    (show bY ∈ B from ⟨Multiplicative.ofAdd (0, 1), rfl⟩)
  obtain ⟨h01, h02, h13, h24, h25⟩ := monomial_commutators
  have hX : monomial 1 ∈ H :=
    h01 ▸ Subgroup.commutator_le_self H (Subgroup.commutator_mem_commutator hx ha)
  have hY : monomial 2 ∈ H :=
    h02 ▸ Subgroup.commutator_le_self H (Subgroup.commutator_mem_commutator hy ha)
  have hd : monomial (Fin.natAdd 3 j) ∈ ⁅H, H⁆ := by
    fin_cases j
    · exact h13 ▸ Subgroup.commutator_mem_commutator hx hX
    · exact h24 ▸ Subgroup.commutator_mem_commutator hx hY
    · exact h25 ▸ Subgroup.commutator_mem_commutator hy hY
  exact ⟨monomial_mem_mapped_center j (Subgroup.commutator_le_self H hd), hd⟩

private lemma quadratic_independent :
    LinearIndependent F (fun j : Fin 3 => basisVector (Fin.natAdd 3 j)) := by
  exact (Pi.linearIndependent_single_one (Fin 6) F).comp _
    (Fin.natAdd_injective 3 3)

private lemma generators_card_ge (t : Finset G) (ht : Subgroup.closure (t : Set G) = D) :
    3 ≤ t.card := by
  classical
  let ts := t.image fun g => g.left.toAdd
  let S := Submodule.span F (ts : Set V)
  have hspan : D ≤ S.toAddSubgroup.toSubgroup.map inl := by
    rw [← ht, Subgroup.closure_le]
    intro g hg
    obtain ⟨v, rfl⟩ : g ∈ A := commutator_le_A (ht ▸ Subgroup.subset_closure hg).2
    refine ⟨v, ?_, rfl⟩
    change v.toAdd ∈ S
    apply Submodule.subset_span
    exact Finset.mem_image_of_mem (fun g : G => g.left.toAdd) hg
  have hmem (j : Fin 3) : basisVector (Fin.natAdd 3 j) ∈ S := by
    obtain ⟨v, hv, heq⟩ := hspan (quadratic_mem j)
    have h := congrArg (fun g : G => g.left.toAdd) heq
    change v.toAdd = basisVector (Fin.natAdd 3 j) at h
    exact h ▸ (show v.toAdd ∈ S from hv)
  have hle := Submodule.finrank_mono (Submodule.span_le.mpr
    (Set.range_subset_iff.mpr hmem))
  rw [finrank_span_eq_card quadratic_independent, Fintype.card_fin] at hle
  calc
    3 ≤ Module.finrank F S := hle
    _ ≤ ts.card := finrank_span_finset_le_card ts
    _ ≤ t.card := Finset.card_image_le

/-- **Zenkov's rank bound fails (Kourovka 21.150).** Call a subgroup elementary abelian if it is
abelian and there is a prime $p$ with $x^p = 1$ for all its elements $x$. There are a finite group
$G$, elementary abelian subgroups $A$ and $B$ of $G$ with $A$ normal, $A \cap B = 1$ and
$\langle A, B \rangle = G$, and an element $a \in A$ whose centralizer $C_B(a)$ in $B$ is trivial,
such that, for $H = \langle a, B \rangle$, with centre $Z(H)$ and derived subgroup $H' = [H, H]$,
some finite generating set of $B$ has fewer elements than every finite generating set of
$Z(H) \cap H'$ (here $Z(H)$ is viewed as a subgroup of $G$).

Counterexample (Monticone; van Doorn, Judin, Monticone and Morrison, Theorem 9.1):
$A = \mathbb{F}_3[x, y]/(x, y)^3$, $B = \langle 1 + x, 1 + y \rangle$ acting by multiplication,
$G = A \rtimes B$ and $a = 1$; then $C_B(a) = 1$, while
$Z(H) \cap H' = \langle x^2, xy, y^2 \rangle$ has rank $3 > 2 = \operatorname{rank} B$. The 21st
issue of the Kourovka Notebook marks 21.150 solved ("No, not always").

Source: E. I. Khukhro and V. D. Mazurov (eds.),
Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026),
Problem 21.150 (V. I. Zenkov); resolution: P. Monticone, letter of 21 March 2026 and solution note,
Kourovka Notebook site; W. van Doorn, E. Judin, P. Monticone and D. Morrison, On some problems from
the Kourovka Notebook, preprint, arXiv:2607.17477 (2026), Kourovka Notebook (21st issue), Problem
21.150: No, not always: A = F₃[x, y]/I³ (I = (x, y)), B = ⟨1 + x, 1 + y⟩ acting by multiplication, G
= A ⋊ B, a = 1; then C_B(a) = 1 and Z(H) ∩ H' = ⟨x², xy, y²⟩ has rank 3 while B has rank 2; van
Doorn-Judin-Monticone-Morrison, Theorem 9.1, https://arxiv.org/abs/2607.17477.
-/
public theorem centreDerivedRankLeComplementRank_refuted :
    ¬ centreDerivedRankLeComplementRank := by
  classical
  let : Finite G := Finite.of_equiv _ SemidirectProduct.equivProd.symm
  intro h
  let s : Finset G := {bX, bY}
  have hs : Subgroup.closure (s : Set G) = B := by
    simpa only [s, Finset.coe_insert, Finset.coe_singleton] using closure_pair
  obtain ⟨t, hts, ht⟩ := h G A B (monomial 0) A_normal (elementaryAbelian_range inl)
    (elementaryAbelian_range inr) A_inf_B A_sup_B ⟨Multiplicative.ofAdd (basisVector 0), rfl⟩
    stabilizer_trivial s hs
  exact (by decide : ¬ 3 ≤ 2) ((generators_card_ge t ht).trans
    (hts.trans (Finset.card_le_two (a := bX) (b := bY))))

end MathlibExt.GroupTheory.CentreDerivedRankExtensionKourovka21Problem150Wanted
