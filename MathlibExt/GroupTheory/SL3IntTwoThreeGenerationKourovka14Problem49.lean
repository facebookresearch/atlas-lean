/-!
# The failure of (2,3)-generation for the integral special linear group in dimension three

`sl3IntGeneratedByOrderTwoAndThree_refuted` answers Kourovka Notebook Problem 14.49.
For a putative generating pair `a, b`, adding the identity to `a` gives a rank-one matrix
`P` of trace two. Pairing the row and column orbits of `P` under `b` gives a matrix of
traces whose determinant must divide the cube of every entry of `P`. The determinant is a
nonunit, so it has a prime factor dividing all those entries. The trace forces that prime
to be two, contradicting generation modulo two.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.SL3IntTwoThreeGenerationKourovka14Problem49Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 14.49 (M.
Conder). UnsolvedMath record UM-00701034 (`KOU-14.49`), dataset ulamai/UnsolvedMath v1.8.0.

Stated in the problem's own reformulation: generation by an element of order `2` and an element of
order `3` (a quotient of `C₂ ∗ C₃` is generated by elements of orders dividing `2` and `3`, and
`SL₃(ℤ)` is not cyclic).
-/

/-- **$(2,3)$-generation of $\mathrm{SL}_3(\mathbb{Z})$ (Kourovka 14.49).** The statement that
there are $a, b \in \mathrm{SL}_3(\mathbb{Z})$ such that $a$ has order $2$, $b$ has order $3$, and
$a$ and $b$ generate $\mathrm{SL}_3(\mathbb{Z})$.

Kourovka Notebook Problem 14.49 (M. Conder) asks whether $\mathrm{SL}_3(\mathbb{Z})$ is a quotient
of the modular group $\mathrm{PSL}_2(\mathbb{Z}) \cong C_2 \ast C_3$; since
$\mathrm{SL}_3(\mathbb{Z})$ is not cyclic, this is equivalent to the statement above. -/
def sl3IntGeneratedByOrderTwoAndThree : Prop :=
  ∃ a b : Matrix.SpecialLinearGroup (Fin 3) ℤ, orderOf a = 2 ∧ orderOf b = 3 ∧
    Subgroup.closure {a, b} = ⊤

open Matrix

private abbrev Mat := Matrix (Fin 3) (Fin 3) ℤ
private abbrev SL := SpecialLinearGroup (Fin 3) ℤ

-- The adjugate of an involution in SL₃ is the involution itself. The three-dimensional
-- cofactor formula then gives the trace and the vanishing of the minors of A + 1.
private theorem involution_minors {a : SL} (ha : orderOf a = 2) :
    let P := (a : Mat) + 1
    P.trace = 2 ∧ ∀ i j k l, P i j * P k l = P i l * P k j := by
  let A : Mat := a
  have hs : a ^ 2 = 1 := ha ▸ pow_orderOf_eq_one a
  have hi : a⁻¹ = a := inv_eq_of_mul_eq_one_left (by simpa [sq] using hs)
  have hadj : A.adjugate = A := congrArg Subtype.val hi
  have hdet : A.det = 1 := a.prop
  have hsing : (A + 1).det = 0 := by
    have hz : (A - 1) * (A + 1) = 0 := by
      have hAA : A * A = 1 := congrArg Subtype.val (show a * a = 1 by simpa [sq] using hs)
      simp [sub_mul, mul_add, hAA]
    have hmul := congrArg (· * (A + 1).adjugate) hz
    rw [mul_assoc, mul_adjugate, Matrix.mul_smul, mul_one, zero_mul, smul_eq_zero] at hmul
    refine hmul.resolve_right fun h => ?_
    have hOne : a = 1 := Subtype.ext (sub_eq_zero.mp h)
    simp [hOne] at ha
  have htr : A.trace = -1 := by
    have hd := congrArg Matrix.trace hadj
    simp [trace_fin_three, adjugate_fin_three] at hd
    simp [det_fin_three] at hsing hdet
    simp only [trace_fin_three]
    linarith only [hd, hsing, hdet]
  change (A + 1).trace = 2 ∧ _
  constructor
  · simp [trace_add, htr]
  · have hcof : (A + 1).adjugate = 0 := by
      ext i j
      have h := congrFun (congrFun hadj i) j
      rw [adjugate_fin_three] at h ⊢
      rw [trace_fin_three] at htr
      fin_cases i <;> fin_cases j <;> simp at h ⊢ <;> linarith
    change ∀ i j k l, (A + 1) i j * (A + 1) k l = (A + 1) i l * (A + 1) k j
    generalize A + 1 = P at hcof ⊢
    rw [adjugate_fin_three, ← Matrix.ext_iff] at hcof
    simp [Fin.forall_fin_succ] at hcof
    intro i j k l
    fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
      first | rfl | exact mul_comm .. | grind

-- Every subring containing a generating pair contains every matrix unit: subtract the
-- identity from an elementary transvection, then multiply to obtain the diagonal units.
private theorem single_mem {a b : SL} (ha : a ^ 2 = 1) (hb : b ^ 3 = 1)
    (hg : Subgroup.closure {a, b} = ⊤) (S : Subring Mat) (hA : (a : Mat) ∈ S)
    (hB : (b : Mat) ∈ S) (i j : Fin 3) : single i j 1 ∈ S := by
  have all_mem (g : SL) : (g : Mat) ∈ S := by
    have hg' : g ∈ Subgroup.closure {a, b} := hg ▸ Subgroup.mem_top _
    induction hg' using Subgroup.closure_induction'' with
    | mem x hx =>
      rcases Set.mem_insert_iff.mp hx with rfl | rfl <;> assumption
    | inv_mem x hx =>
      rcases Set.mem_insert_iff.mp hx with rfl | rfl
      · rwa [show x⁻¹ = x from inv_eq_of_mul_eq_one_left (by simpa [sq] using ha)]
      · rw [show x⁻¹ = x ^ 2 from inv_eq_of_mul_eq_one_left (by rwa [← pow_succ])]
        exact S.pow_mem hB 2
    | one => exact S.one_mem
    | mul x y _ _ hx hy => exact S.mul_mem hx hy
  have off {r s : Fin 3} (h : r ≠ s) : single r s 1 ∈ S := by
    simpa [SpecialLinearGroup.transvection_coe] using
      S.sub_mem (all_mem (SpecialLinearGroup.transvection h 1)) S.one_mem
  by_cases h : i = j
  · subst j
    obtain ⟨k, hk⟩ := exists_ne i
    simpa [single_mul_single_same] using S.mul_mem (off hk.symm) (off hk)
  · exact off h

-- Matrices preserving the lattice generated by the columns of U.
private def preserving (U : Mat) : Subring Mat where
  carrier := {M | ∃ T, M * U = U * T}
  add_mem' := by
    rintro _ _ ⟨T, hT⟩ ⟨V, hV⟩
    exact ⟨T + V, by rw [add_mul, hT, hV, mul_add]⟩
  mul_mem' := by
    rintro _ _ ⟨T, hT⟩ ⟨V, hV⟩
    exact ⟨T * V, by rw [mul_assoc, hV, ← mul_assoc, hT, mul_assoc]⟩
  neg_mem' := by
    rintro _ ⟨T, hT⟩
    exact ⟨-T, by rw [neg_mul, hT, mul_neg]⟩
  zero_mem' := ⟨0, by simp⟩
  one_mem' := ⟨1, by simp⟩

private def orbit (B P : Mat) (j : Fin 3) : Mat :=
  of fun i k => (B ^ k.val * P) i j

private theorem mul_orbit (M B P : Mat) (i j k : Fin 3) :
    (M * orbit B P j) i k = (M * (B ^ k.val * P)) i j := rfl

private theorem sandwich (P M : Mat)
    (hP : ∀ i j k l, P i j * P k l = P i l * P k j) (i j : Fin 3) :
    (P * (M * P)) i j = P i j * (M * P).trace := by
  simp only [trace, diag_apply, Matrix.mul_apply, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  apply Finset.sum_congr rfl
  intro s _
  linear_combination M r s * hP i r s j

private theorem orbit_preserved (B P : Mat) (hB : B ^ 3 = 1)
    (hP : ∀ i j k l, P i j * P k l = P i l * P k j) (j : Fin 3) :
    B ∈ preserving (orbit B P j) ∧ P - 1 ∈ preserving (orbit B P j) := by
  constructor
  · refine ⟨!![0, 0, 1; 1, 0, 0; 0, 1, 0], ?_⟩
    ext i k
    rw [mul_orbit, ← mul_assoc, ← pow_succ']
    fin_cases k <;> simp [Matrix.mul_apply, Fin.sum_univ_three, orbit, hB]
  · apply (preserving _).sub_mem _ (preserving _).one_mem
    let t (k : Fin 3) := (B ^ k.val * P).trace
    refine ⟨of fun i k => if i = 0 then t k else 0, ?_⟩
    ext i k
    rw [mul_orbit, sandwich P _ hP]
    rw [Matrix.mul_apply]
    simp [orbit, t]

-- If all matrix units preserve the column lattice, the lattice contains every column
-- of wI for each entry w of the first column of U.
private theorem orbit_index (U : Mat) (s : Fin 3)
    (h : ∀ i j, single i j 1 ∈ preserving U) :
    ∃ X : Mat, U.det * X.det = (U s 0) ^ 3 := by
  choose T hT using fun i => (h i s : ∃ T, single i s 1 * U = U * T)
  let X : Mat := of fun k i => T i k 0
  have hX : U * X = U s 0 • (1 : Mat) := by
    ext i j
    change (U * T j) i 0 = _
    rw [← hT]
    by_cases h : i = j
    · subst j
      simp [single_mul_apply_same]
    · simp [single_mul_apply_of_ne, h]
  refine ⟨X, ?_⟩
  simpa only [det_mul, det_smul, det_one, mul_one, Fintype.card_fin] using congrArg Matrix.det hX

private def moments (B P : Mat) : Mat :=
  of fun i j => (B ^ (i.val + j.val) * P).trace

-- Pair the row orbit with the column orbit. Each entry is a multiple of the
-- corresponding trace, with the same multiplier w throughout the pairing matrix.
private theorem orbit_pairing (B P : Mat) (s t : Fin 3)
    (hP : ∀ i j k l, P i j * P k l = P i l * P k j) :
    (orbit Bᵀ Pᵀ s)ᵀ * orbit B P t = P s t • moments B P := by
  ext i j
  calc
    _ = ((P * B ^ i.val) * (B ^ j.val * P)) s t := by
      rw [Matrix.mul_apply, Matrix.mul_apply]
      apply Finset.sum_congr rfl
      intro k _
      simp only [transpose_apply, orbit, of_apply, ← transpose_pow, ← transpose_mul]
    _ = _ := by
      rw [mul_assoc, ← mul_assoc (B ^ i.val), ← pow_add, sandwich P _ hP]
      rfl

private theorem det_dvd_entry_cube {a b : SL} (ha : a ^ 2 = 1) (hb : b ^ 3 = 1)
    (hg : Subgroup.closure {a, b} = ⊤) (s t : Fin 3) :
    let P := (a : Mat) + 1
    let B : Mat := b
    (∀ i j k l, P i j * P k l = P i l * P k j) →
      (moments B P).det ∣ P s t ^ 3 := by
  intro P B hP
  let U := orbit B P t
  let V := orbit Bᵀ Pᵀ s
  have hB : B ^ 3 = 1 := congrArg Subtype.val hb
  obtain ⟨hbU, haU⟩ := orbit_preserved B P hB hP t
  obtain ⟨hbV, haV⟩ := orbit_preserved Bᵀ Pᵀ (by rw [← transpose_pow, hB, transpose_one])
    (fun i j k l => (hP j i l k).trans (mul_comm ..)) s
  obtain ⟨X, hX⟩ := orbit_index U s <| single_mem ha hb hg _ (by simpa [P] using haU) hbU
  have hV : ∀ i j, single i j 1 ∈ preserving V := by
    intro i j
    have h := single_mem ha hb hg
      ((preserving V).op.comap (transposeRingEquiv (Fin 3) ℤ).toRingHom)
      (by change (a : Mat)ᵀ ∈ preserving V; simpa [P, V] using haV) hbV j i
    exact (transpose_single j i (1 : ℤ)) ▸ (show (single j i 1 : Mat)ᵀ ∈ preserving V from h)
  obtain ⟨Y, hY⟩ := orbit_index V t hV
  have hpair := congrArg Matrix.det (orbit_pairing B P s t hP)
  simp only [det_mul, det_transpose, det_smul, Fintype.card_fin] at hpair
  change V.det * U.det = P s t ^ 3 * (moments B P).det at hpair
  simp only [U, V, orbit, of_apply, Fin.val_zero, pow_zero, one_mul, transpose_apply] at hX hY
  change U.det * X.det = P s t ^ 3 at hX
  change V.det * Y.det = P s t ^ 3 at hY
  by_cases hw : P s t = 0
  · simp [hw]
  refine ⟨X.det * Y.det, mul_left_cancel₀ (pow_ne_zero 3 hw) ?_⟩
  calc
    _ = (U.det * X.det) * (V.det * Y.det) := by rw [hX, hY]
    _ = (V.det * U.det) * (X.det * Y.det) := by ring
    _ = _ := by rw [hpair, mul_assoc]

private theorem moments_nonunit (B P : Mat) (hB : B ^ 3 = 1) (hP : P.trace = 2) :
    ¬ IsUnit (moments B P).det := by
  let x := (B * P).trace
  let y := (B ^ 2 * P).trace
  have h4 : B ^ 4 = B := by rw [pow_succ, hB, one_mul]
  have hd : (moments B P).det =
      -(2 + x + y) * (4 + x ^ 2 + y ^ 2 - 2 * x - 2 * y - x * y) := by
    simp [det_fin_three, moments, x, y, hB, h4, hP]
    ring
  rw [hd, IsUnit.mul_iff, Int.isUnit_iff, Int.isUnit_iff]
  rintro ⟨h, h'⟩
  have hs : 4 - x - y = 7 ∨ 4 - x - y = 5 := by omega
  have hlarge : 25 ≤ (4 - x - y) ^ 2 := by rcases hs with h | h <;> rw [h] <;> decide
  rcases h' with h' | h' <;> nlinarith [sq_nonneg (x - y)]

-- If every entry of A + 1 were even, A would reduce to the identity modulo two.
-- Every element of the reduced group would then have cube one, including a transvection.
private theorem not_all_even {a b : SL} (hb : b ^ 3 = 1) (hg : Subgroup.closure {a, b} = ⊤) :
    ¬ ∀ i j, (2 : ℤ) ∣ ((a : Mat) + 1) i j := by
  intro he
  let f := SpecialLinearGroup.map (n := Fin 3) (Int.castRingHom (ZMod 2))
  have hfa : f a = 1 := by
    ext i j
    have h := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mpr (he i j)
    change ((a i j : ℤ) : ZMod 2) = (1 : Matrix (Fin 3) (Fin 3) (ZMod 2)) i j
    by_cases hij : i = j
    · subst j
      simp at h ⊢
      simpa only [CharTwo.neg_eq] using eq_neg_of_add_eq_zero_left h
    · simpa [Matrix.one_apply, hij] using h
  let g : SL := SpecialLinearGroup.transvection (i := 0) (j := 1) (by decide) 1
  have hle : Subgroup.closure {a, b} ≤ (Subgroup.zpowers (f b)).comap f := by
    rw [Subgroup.closure_le]
    rintro z (hz | hz)
    · subst z
      change f a ∈ Subgroup.zpowers (f b)
      rw [hfa]
      exact Subgroup.one_mem _
    · obtain rfl : z = b := hz
      exact Subgroup.mem_zpowers _
  obtain ⟨n, hn⟩ := hle (show g ∈ Subgroup.closure {a, b} by rw [hg]; trivial)
  change f b ^ n = f g at hn
  have hc : f g ^ 3 = 1 := by
    calc
      _ = ((f b) ^ n) ^ (3 : ℤ) := by rw [hn]; rfl
      _ = ((f b) ^ (3 : ℤ)) ^ n := by rw [← zpow_mul, mul_comm, zpow_mul]
      _ = 1 := by
        change ((f b) ^ (3 : ℕ)) ^ n = 1
        rw [← map_pow, hb, map_one, one_zpow]
  exact absurd (congrArg (fun m : SpecialLinearGroup (Fin 3) (ZMod 2) => m 0 1) hc)
    (by decide)

/--
**$\mathrm{SL}_3(\mathbb{Z})$ is not $(2,3)$-generated.** There are no $a, b \in
\mathrm{SL}_3(\mathbb{Z})$ such that $a$ has order $2$, $b$ has order $3$, and $a$ and $b$ generate
$\mathrm{SL}_3(\mathbb{Z})$. Equivalently, $\mathrm{SL}_3(\mathbb{Z})$ is not a quotient of the
modular group $\mathrm{PSL}_2(\mathbb{Z}) \cong C_2 \ast C_3$.

This is the negative answer to Kourovka Notebook Problem 14.49 (M. Conder), due to Tamburini and
Zucca, and Nuzhin.

Source: E.
I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook, 21st
issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 14.49 (M. Conder); resolution:
M. C. Tamburini and P. Zucca, Rend. Lincei Mat. Appl. (9) 11 (2000), no. 1, 5-7; Ya. N. Nuzhin,
Math. Notes 70 (2001), no. 1-2, 71-78, Kourovka Archive, Problem 14.49 (answer: No, it is not;
SL_d(ℤ) is such a quotient for d ≥ 28).
-/
public theorem sl3IntGeneratedByOrderTwoAndThree_refuted :
    ¬ sl3IntGeneratedByOrderTwoAndThree := by
  rintro ⟨a, b, ha, hb, hg⟩
  let P := (a : Mat) + 1
  let B : Mat := b
  obtain ⟨htr, hmin⟩ := involution_minors ha
  have ha' : a ^ 2 = 1 := ha ▸ pow_orderOf_eq_one a
  have hb' : b ^ 3 = 1 := by simpa only [hb] using pow_orderOf_eq_one b
  have hnu := moments_nonunit B P (congrArg Subtype.val hb') htr
  obtain ⟨p, hp, hd⟩ := Nat.exists_prime_and_dvd
    (show (moments B P).det.natAbs ≠ 1 from fun h =>
      hnu (Int.isUnit_iff.mpr ((Int.natAbs_eq_natAbs_iff (b := 1)).mp h)))
  have hall (i j : Fin 3) : (p : ℤ) ∣ P i j :=
    (Nat.prime_iff_prime_int.mp hp).dvd_of_dvd_pow
      ((Int.natCast_dvd.mpr hd).trans (det_dvd_entry_cube ha' hb' hg i j hmin))
  have htwo : (p : ℤ) ∣ 2 := by
    rw [← htr, trace_fin_three]
    exact dvd_add (dvd_add (hall 0 0) (hall 1 1)) (hall 2 2)
  have hp2 : p = 2 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp
    (Int.natCast_dvd.mp htwo)
  subst p
  exact not_all_even hb' hg hall

end MathlibExt.GroupTheory.SL3IntTwoThreeGenerationKourovka14Problem49Wanted
