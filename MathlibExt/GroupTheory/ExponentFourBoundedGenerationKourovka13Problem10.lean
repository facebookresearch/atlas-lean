module

public import Mathlib.GroupTheory.Solvable
import Mathlib.Algebra.BigOperators.Pi
import Mathlib.GroupTheory.RegularWreathProduct
import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Exponent 4 is not detected on boundedly generated subgroups (Kourovka Notebook Problem 13.10)

Kourovka Notebook, Archive of Solved Problems, Problem 13.10 (V. V. Bludov): is there a function `f
: ℕ → ℕ` such that, for every soluble group `G` of derived length `k` generated by a set `A`, the
identity `x⁴ = 1` on each subgroup generated by at most `f(k)` elements of `A` implies that `G` has
exponent 4?

We refute the proposed bound inside the wreath product of the dihedral group of order eight by
a binary cube. The generators are the coordinate translations and a function supported at two
opposite vertices, with a different reflection at each. Omitting a coordinate translation keeps
the two reflections on separate faces. Translating between the opposite vertices makes their
product appear in the square of a group element.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 13.10 (V. V.
Bludov). UnsolvedMath record UM-00700928 (`KOU-13.10`), dataset ulamai/UnsolvedMath v1.8.0.

Derived length `k` is read as `G⁽ᵏ⁾ = 1` (at most `k`), which is equivalent: a bound for exact
lengths can be made monotone. `A` generates `G`; the subsets of `A` of size at most `f(k)` are
finite sets; exponent 4 is the identity `x⁴ = 1`.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.ExponentFourBoundedGenerationKourovka13Problem10Wanted

/-- **Exponent 4 detected on boundedly generated subgroups (Kourovka 13.10).** The proposition
that there is a function $f : \mathbb{N} \to \mathbb{N}$ with the following property: for every
$k \in \mathbb{N}$, every group $G$ whose $k$-th derived subgroup $G^{(k)}$ is trivial (a soluble
group of derived length at most $k$), and every generating set $A$ of $G$, if $x^4 = 1$ for every
element $x$ of every subgroup generated by a finite subset of $A$ with at most $f(k)$ elements,
then $x^4 = 1$ for every $x \in G$. This is Kourovka Notebook Problem 13.10 (V. V. Bludov). -/
def exponentFourDetectedOnBoundedSubsets : Prop :=
  ∃ f : ℕ → ℕ, ∀ (k : ℕ) (G : Type) [Group G], derivedSeries G k = ⊥ →
    ∀ A : Set G, Subgroup.closure A = ⊤ →
      (∀ S : Finset G, (S : Set G) ⊆ A → S.card ≤ f k →
        ∀ g ∈ Subgroup.closure (S : Set G), g ^ 4 = 1) →
      ∀ g : G, g ^ 4 = 1

open Subgroup RegularWreathProduct DihedralGroup
open scoped commutatorElement

private abbrev Bit := Multiplicative (ZMod 2)
private abbrev Cube (n : ℕ) := Fin n → Bit
private abbrev Wreath (n : ℕ) := DihedralGroup 4 ≀ᵣ Cube n

private def flip : Bit := Multiplicative.ofAdd 1
private def opposite (n : ℕ) : Cube n := fun _ ↦ flip

variable {n : ℕ}

private lemma cube_square (q : Cube n) : q * q = 1 := by
  funext i
  exact (by decide : ∀ b : Bit, b * b = 1) (q i)

private lemma cube_inv (q : Cube n) : q⁻¹ = q :=
  inv_eq_of_mul_eq_one_left (cube_square q)

-- The derived subgroup lies in the base. Commutators inside the base are central there.
private lemma wreath_derived : Subgroup.derivedSeries (Wreath n) 3 = ⊥ := by
  let base : (Cube n → DihedralGroup 4) →* Wreath n :=
    { toFun := fun a ↦ ⟨a, 1⟩
      map_one' := rfl
      map_mul' := fun a b ↦ by ext <;> simp }
  have h₁ : Subgroup.derivedSeries (Wreath n) 1 ≤ (⊤ : Subgroup _).map base := by
    intro g hg
    have hg' : g.right = 1 := Group.Abelianization.commutator_le_ker rightHom hg
    exact ⟨g.left, trivial, RegularWreathProduct.ext rfl hg'.symm⟩
  have h₂ := commutator_le_map_commutator h₁ h₁
  have hc : _root_.commutator (Cube n → DihedralGroup 4) ≤ center _ := by
    apply commutator_le.mpr
    intro a _ b _
    apply mem_center_iff.mpr
    intro c
    funext x
    exact (by decide : ∀ a b c : DihedralGroup 4, c * ⁅a, b⁆ = ⁅a, b⁆ * c) (a x) (b x) (c x)
  have hbase : Subgroup.derivedSeries (Cube n → DihedralGroup 4) 2 = ⊥ :=
    le_bot_iff.mp ((commutator_mono_right hc).trans (commutator_center_right _).le)
  exact le_bot_iff.mp ((commutator_le_map_commutator h₂ h₂).trans
    (show (Subgroup.derivedSeries (Cube n → DihedralGroup 4) 2).map base ≤ ⊥ by
      rw [hbase, Subgroup.map_bot]))

-- Put two different reflections at opposite vertices and the identity everywhere else.
private def lamp (n : ℕ) : Wreath n :=
  ⟨fun x ↦ if x = 1 then sr 0 else if x = opposite n then sr 1 else 1, 1⟩

private def shift (i : Fin n) : Wreath n := inl (Pi.mulSingle i flip)

private def generators (n : ℕ) : Set (Wreath n) := insert (lamp n) (Set.range shift)

private def reflection (b : Bit) : DihedralGroup 4 := sr (if b = 1 then 0 else 1)

-- A translation fixing coordinate i preserves each of its two faces. On a given face,
-- every lamp value is constrained to the same cyclic subgroup of order two.
private def faceGroup (i : Fin n) : Subgroup (Wreath n) where
  carrier := {g | g.right i = 1 ∧ ∀ x, g.left x ∈ zpowers (reflection (x i))}
  one_mem' := ⟨rfl, fun _ ↦ one_mem _⟩
  mul_mem' := by
    rintro a b ⟨ha, hfa⟩ ⟨hb, hfb⟩
    refine ⟨by simp [ha, hb], fun x ↦ mul_mem (hfa x) ?_⟩
    simpa [ha] using hfb (a.right⁻¹ * x)
  inv_mem' := by
    rintro a ⟨ha, hfa⟩
    refine ⟨by simp [ha], fun x ↦ inv_mem ?_⟩
    simpa [ha] using hfa (a.right * x)

private lemma lamp_mem_face (i : Fin n) : lamp n ∈ faceGroup i := by
  refine ⟨rfl, fun x ↦ ?_⟩
  by_cases h : x = 1
  · subst x
    simp [lamp, reflection]
  by_cases ho : x = opposite n
  · subst x
    have hf : flip ≠ 1 := by decide
    simp [lamp, h, opposite, reflection, hf]
  · simp [lamp, h, ho]

private lemma shift_mem_face {i j : Fin n} (h : i ≠ j) : shift j ∈ faceGroup i :=
  ⟨by simp [shift, h], fun _ ↦ one_mem _⟩

private lemma face_fourth (i : Fin n) {g : Wreath n} (hg : g ∈ faceGroup i) : g ^ 4 = 1 := by
  have hs : (g ^ 2).right = 1 := by simpa [sq] using cube_square g.right
  have hmem := (faceGroup i).pow_mem hg 2
  rw [pow_mul g 2 2, sq]
  apply RegularWreathProduct.ext
  · funext x
    simp only [mul_left, Pi.mul_apply, hs, inv_one, one_mul, one_left, Pi.one_apply]
    obtain ⟨m, hm⟩ := mem_zpowers_iff.mp (hmem.2 x)
    rw [← hm, ← sq, ← zpow_natCast, zpow_comm, zpow_natCast]
    simp [reflection, sq]
  · simp [hs]

private lemma shift_injective : Function.Injective (shift : Fin n → Wreath n) := by
  intro i j h
  by_contra hij
  have := congrArg (fun g : Wreath n ↦ g.right i) h
  exact (by decide : flip ≠ 1) (by simpa [shift, hij] using this)

private lemma missing_shift (S : Finset (Wreath n)) (hS : S.card < n) :
    ∃ i, shift i ∉ S := by
  by_contra! h
  let embed (i : Fin n) : S := ⟨shift i, h i⟩
  have hinj : Function.Injective embed := fun _ _ he ↦ shift_injective (congrArg Subtype.val he)
  exact hS.not_ge (by simpa using Fintype.card_le_of_injective embed hinj)

private lemma fourth_ne_one (hn : 0 < n) :
    (lamp n * inl (opposite n)) ^ 4 ≠ 1 := by
  have ho : opposite n ≠ 1 := fun h ↦ (by decide : flip ≠ 1) (congrFun h ⟨0, hn⟩)
  let g : Wreath n := lamp n * inl (opposite n)
  have hr : g.right = opposite n := by simp [g, lamp]
  have hl (x : Cube n) : g.left x = (lamp n).left x := by simp [g]
  have hsq : (g ^ 2).right = 1 := by simpa [sq] using cube_square g.right
  have hs : (g ^ 2).left 1 = sr 0 * sr 1 := by
    simp [sq, hr, cube_inv, hl, lamp, ho]
  intro h
  change g ^ 4 = 1 at h
  rw [pow_mul g 2 2, sq] at h
  have he := congrArg (fun w : Wreath n ↦ w.left 1) h
  exact (by decide : ((sr 0 * sr 1 : DihedralGroup 4) * (sr 0 * sr 1)) ≠ 1)
    (by simpa only [mul_left, Pi.mul_apply, hsq, inv_one, one_mul, hs, one_left, Pi.one_apply]
          using he)

private lemma opposite_mem :
    (inl (opposite n) : Wreath n) ∈ closure (generators n) := by
  change opposite n ∈ (closure (generators n)).comap inl
  rw [← Finset.univ_prod_mulSingle (opposite n)]
  exact Subgroup.prod_mem _ fun i _ ↦ subset_closure (Set.mem_insert_of_mem _ ⟨i, rfl⟩)

/-- **Exponent 4 is not detected on boundedly generated subgroups.** There is no function
$f : \mathbb{N} \to \mathbb{N}$ with the following property: for every $k \in \mathbb{N}$, every
group $G$ whose $k$-th derived subgroup $G^{(k)}$ is trivial, and every generating set $A$ of $G$,
if $x^4 = 1$ for every element $x$ of every subgroup generated by a finite subset of $A$ with at
most $f(k)$ elements, then $x^4 = 1$ for every $x \in G$. This is the negative answer to Kourovka
Notebook Problem 13.10 (V. V. Bludov), given by G. S. Deryabina and A. N. Krasil'nikov (2003).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group
Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems,
Problem 13.10 (V. V. Bludov); resolution: G. S. Deryabina and A. N. Krasil'nikov, Siberian Math. J.
44 (2003), no. 1, 58-60, Kourovka Archive, Problem 13.10: No, there is not.
-/
theorem exponentFourDetectedOnBoundedSubsets_refuted :
    ¬ exponentFourDetectedOnBoundedSubsets := by
  classical
  rintro ⟨f, hf⟩
  let n := f 3 + 1
  let H := closure (generators n)
  have hder : Subgroup.derivedSeries H 3 = ⊥ := by
    apply map_subtype_inj.mp
    rw [Subgroup.map_bot]
    exact le_bot_iff.mp ((Subgroup.map_derivedSeries_le_derivedSeries H.subtype 3).trans
      wreath_derived.le)
  have hlocal (S : Finset H) (hS : (S : Set H) ⊆ H.subtype ⁻¹' generators n)
      (hc : S.card ≤ f 3) : ∀ g ∈ closure (S : Set H), g ^ 4 = 1 := by
    let T := S.image H.subtype
    have hT : T.card < n := lt_of_le_of_lt Finset.card_image_le (Nat.lt_succ_of_le hc)
    obtain ⟨i, hi⟩ := missing_shift T hT
    have hsub : closure (S : Set H) ≤ (faceGroup i).comap H.subtype := by
      apply (closure_le _).mpr
      intro a ha
      change H.subtype a ∈ faceGroup i
      rcases hS ha with he | ⟨j, hj⟩
      · exact he.symm ▸ lamp_mem_face i
      · have hji : i ≠ j := by
          rintro rfl
          exact hi (Finset.mem_image.mpr ⟨a, ha, hj.symm⟩)
        exact hj ▸ shift_mem_face hji
    intro g hg
    exact Subtype.ext (face_fourth i (hsub hg))
  have hall := hf 3 H hder _ (closure_preimage_eq_top (generators n)) hlocal
  have hl : lamp n ∈ H := subset_closure (Set.mem_insert _ _)
  exact fourth_ne_one (Nat.zero_lt_succ _) (congrArg Subtype.val
    (hall ⟨lamp n * inl (opposite n), H.mul_mem hl opposite_mem⟩))

end MathlibExt.GroupTheory.ExponentFourBoundedGenerationKourovka13Problem10Wanted
