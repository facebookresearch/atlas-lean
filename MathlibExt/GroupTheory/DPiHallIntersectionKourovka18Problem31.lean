namespace MathlibExt.GroupTheory.DPiHallIntersectionKourovka18Problem31Wanted

open MulAction

/-! ### Groups acting on `28` points with an element of order `13` fixing two points -/

section Action

variable {G : Type} [Group G] [Finite G] {Ω : Type} [MulAction G Ω] [Finite Ω]

/-- A divisor of a `{3, 13}`-number that is not divisible by `13` is a power of `3`. -/
private theorem exists_eq_three_pow_of_dvd {n d : ℕ} (hn : IsPiNumber {3, 13} n) (hd : d ∣ n)
    (hd0 : d ≠ 0) (h13 : ¬ 13 ∣ d) : ∃ c, d = 3 ^ c := by
  refine ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd hd0 fun {p} hp hpd => ?_⟩
  rcases hn p hp (hpd.trans hd) with h | h
  · exact h
  · exact absurd (h ▸ hpd) h13

/-- In a group of order `29484` acting on `28` points, in which some element `m` of order `13`
fixes exactly two points, every `{3, 13}`-subgroup fixes a point. -/
private theorem exists_forall_smul_eq_of_isPiSubgroup (hΩ : Nat.card Ω = 28)
    (hG : Nat.card G = 29484) (m : G) (hm : orderOf m = 13) (hfix : (fixedBy Ω m).ncard = 2)
    (K : Subgroup G) (hK : IsPiSubgroup {3, 13} K) : ∃ ω : Ω, ∀ k ∈ K, k • ω = ω := by
  have hKG : Nat.card K ∣ 29484 := hG ▸ Subgroup.card_subgroup_dvd_card K
  have hK0 : Nat.card K ≠ 0 := Nat.card_pos.ne'
  by_cases h13 : 13 ∣ Nat.card K
  · -- `K` contains a conjugate `k` of `m`, which fixes exactly two points.
    have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' 13 h13
    have hxG : orderOf (x : G) = 13 := by rw [Subgroup.orderOf_coe, hx]
    have hP : IsPGroup 13 (Subgroup.zpowers (x : G)) := IsPGroup.of_card (n := 1) (by
      rw [Nat.card_zpowers, hxG, pow_one])
    have hQ : IsPGroup 13 (Subgroup.zpowers m) := IsPGroup.of_card (n := 1) (by
      rw [Nat.card_zpowers, hm, pow_one])
    have hidx : ∀ y : G, orderOf y = 13 → ¬ 13 ∣ (Subgroup.zpowers y).index := by
      intro y hy hdvd
      have h := (Subgroup.zpowers y).card_mul_index
      rw [Nat.card_zpowers, hy, hG] at h
      omega
    obtain ⟨g, hg⟩ := exists_smul_eq G (hQ.toSylow (hidx m hm)) (hP.toSylow (hidx _ hxG))
    have hkx : g * m * g⁻¹ ∈ Subgroup.zpowers (x : G) := by
      have h1 := Subgroup.smul_mem_pointwise_smul m (MulAut.conj g) (Subgroup.zpowers m)
        (Subgroup.mem_zpowers m)
      have h2 := congrArg (fun S : Sylow 13 G => (S : Subgroup G)) hg
      simp only [Sylow.coe_subgroup_smul, IsPGroup.toSylow_coe] at h2
      rw [h2] at h1
      simpa [MulAut.smul_def] using h1
    set k := g * m * g⁻¹ with hk_def
    have hkK : k ∈ K := Subgroup.zpowers_le.mpr x.2 hkx
    have hk13 : orderOf k = 13 := by
      simpa [hm] using orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective m
    have hkfix : (fixedBy Ω k).ncard = 2 := by
      rw [hk_def, ← smul_fixedBy, Set.ncard_smul_set, hfix]
    obtain ⟨γ, hγ⟩ := Set.nonempty_of_ncard_ne_zero (s := fixedBy Ω k) (by omega)
    -- The orbit of `γ` under `K` has a power of `3` as size.
    set O := orbit K γ with hO_def
    have hOK : Nat.card (stabilizer K γ) * O.ncard = Nat.card K := by
      rw [hO_def, ← index_stabilizer]
      exact (stabilizer K γ).card_mul_index
    have h13stab : 13 ∣ Nat.card (stabilizer K γ) := by
      have hmem : (⟨k, hkK⟩ : K) ∈ stabilizer K γ := hγ
      have := orderOf_dvd_natCard (⟨⟨k, hkK⟩, hmem⟩ : stabilizer K γ)
      rwa [Subgroup.orderOf_mk, Subgroup.orderOf_mk, hk13] at this
    have hO13 : ¬ 13 ∣ O.ncard := by
      rintro ⟨b, hb⟩
      obtain ⟨a, ha⟩ := h13stab
      have h169 : 169 ∣ 29484 := by
        refine Dvd.dvd.trans ⟨a * b, ?_⟩ hKG
        rw [← hOK, ha, hb]
        ring
      exact absurd h169 (by norm_num)
    have hO0 : O.ncard ≠ 0 := (Set.ncard_pos (Set.toFinite O)).mpr ⟨γ, mem_orbit_self γ⟩ |>.ne'
    obtain ⟨c, hc⟩ := exists_eq_three_pow_of_dvd hK (Dvd.intro_left _ hOK) hO0 hO13
    have hO28 : O.ncard ≤ 28 := hΩ ▸ Set.ncard_le_card O
    have hc4 : c < 4 := by
      by_contra hc4
      have : 3 ^ 4 ≤ 3 ^ c := Nat.pow_le_pow_right (by norm_num) (by omega)
      omega
    -- If the orbit has fewer than `13` points, then `k` fixes each of them.
    have hsmall : O.ncard < 13 → O ⊆ fixedBy Ω k := by
      intro hlt ω hω
      have hZ : IsPGroup 13 (Subgroup.zpowers k) := IsPGroup.of_card (n := 1) (by
        rw [Nat.card_zpowers, hk13, pow_one])
      obtain ⟨e, he⟩ := hZ.card_orbit ω
      have hsub : orbit (Subgroup.zpowers k) ω ⊆ O := by
        rintro _ ⟨⟨z, hz⟩, rfl⟩
        obtain ⟨⟨y, hy⟩, rfl⟩ := hω
        exact ⟨⟨z * y, K.mul_mem (Subgroup.zpowers_le.mpr hkK hz) hy⟩, mul_smul z y γ⟩
      have hle : (orbit (Subgroup.zpowers k) ω).ncard ≤ O.ncard :=
        Set.ncard_le_ncard hsub (Set.toFinite O)
      rw [← Nat.card_coe_set_eq, he] at hle
      have he0 : e = 0 := by
        by_contra he0
        have : 13 ^ 1 ≤ 13 ^ e := Nat.pow_le_pow_right (by norm_num) (by omega)
        omega
      rw [he0, pow_zero, Nat.card_coe_set_eq, Set.ncard_eq_one] at he
      obtain ⟨a, ha⟩ := he
      have h1 : ω ∈ orbit (Subgroup.zpowers k) ω := mem_orbit_self ω
      have h2 : k • ω ∈ orbit (Subgroup.zpowers k) ω := ⟨⟨k, Subgroup.mem_zpowers k⟩, rfl⟩
      rw [ha] at h1 h2
      exact h2.trans h1.symm
    interval_cases c
    · -- The orbit is `{γ}`, so `K` fixes `γ`.
      refine ⟨γ, fun k' hk' => ?_⟩
      rw [pow_zero, Set.ncard_eq_one] at hc
      obtain ⟨a, ha⟩ := hc
      have h1 : γ ∈ O := mem_orbit_self γ
      have h2 : k' • γ ∈ O := ⟨⟨k', hk'⟩, rfl⟩
      rw [ha] at h1 h2
      exact h2.trans h1.symm
    · exact absurd ((Set.ncard_le_ncard (hsmall (by omega))).trans hkfix.le) (by omega)
    · exact absurd ((Set.ncard_le_ncard (hsmall (by omega))).trans hkfix.le) (by omega)
    · -- The orbit has `27` points, and `K` fixes the remaining point.
      have hcompl := Set.ncard_add_ncard_compl O
      rw [hc, hΩ] at hcompl
      obtain ⟨δ, hδ⟩ := Set.ncard_eq_one.mp (show Oᶜ.ncard = 1 by omega)
      refine ⟨δ, fun k' hk' => ?_⟩
      have hδO : δ ∉ O := by
        have : δ ∈ Oᶜ := hδ ▸ rfl
        exact this
      have hk'δ : k' • δ ∈ Oᶜ := by
        intro hmem
        apply hδO
        have h1 : orbit K (k' • δ) = O := orbit_eq_iff.mpr hmem
        rw [← h1]
        exact ⟨⟨k', hk'⟩⁻¹, show ((⟨k', hk'⟩⁻¹ : K) : G) • k' • δ = δ from inv_smul_smul k' δ⟩
      rw [hδ] at hk'δ
      exact hk'δ
  · -- `K` is a `3`-group, and `28` is not divisible by `3`.
    obtain ⟨c, hc⟩ := exists_eq_three_pow_of_dvd hK dvd_rfl hK0 h13
    have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
    have hmod := (IsPGroup.of_card hc).card_modEq_card_fixedPoints Ω
    rw [hΩ] at hmod
    have hne : Nat.card (fixedPoints K Ω) ≠ 0 := by
      intro h0
      rw [h0] at hmod
      exact absurd hmod (by decide)
    obtain ⟨⟨ω, hω⟩⟩ := (Nat.card_ne_zero.mp hne).1
    exact ⟨ω, fun k hk => hω ⟨k, hk⟩⟩

/-- `1053 = 3 ^ 4 * 13` is a `{3, 13}`-number. -/
private theorem isPiNumber_1053 : IsPiNumber {3, 13} 1053 := by
  intro p hp hdvd
  rw [show (1053 : ℕ) = 3 ^ 4 * 13 by norm_num] at hdvd
  rcases (Nat.Prime.dvd_mul hp).mp hdvd with h3 | h13
  · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp (by norm_num)).mp (hp.dvd_of_dvd_pow h3))
  · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp (by norm_num)).mp h13)

omit [Finite G] [Finite Ω] in
/-- In a transitive action of a group of order `29484` on `28` points, every point stabilizer has
order `1053`. -/
private theorem card_stabilizer_eq (hΩ : Nat.card Ω = 28) (hG : Nat.card G = 29484)
    [IsPretransitive G Ω] (ω : Ω) : Nat.card (stabilizer G ω) = 1053 := by
  have h := (stabilizer G ω).card_mul_index
  rw [index_stabilizer_of_transitive, hΩ, hG] at h
  omega

/-- If moreover the action is transitive, then the group is a `D_π`-group for `π = {3, 13}`:
its maximal `{3, 13}`-subgroups are the point stabilizers. -/
private theorem isDPiGroup_of_isPretransitive (hΩ : Nat.card Ω = 28) (hG : Nat.card G = 29484)
    [IsPretransitive G Ω] (m : G) (hm : orderOf m = 13) (hfix : (fixedBy Ω m).ncard = 2) :
    IsDPiGroup {3, 13} G := by
  have hstab : ∀ H : Subgroup G, IsMaximalPiSubgroup {3, 13} H →
      ∃ ω : Ω, stabilizer G ω = H := by
    intro H hH
    obtain ⟨ω, hω⟩ := exists_forall_smul_eq_of_isPiSubgroup hΩ hG m hm hfix H hH.1
    refine ⟨ω, hH.2 _ ?_ fun h hh => hω h hh⟩
    unfold IsPiSubgroup
    rw [card_stabilizer_eq hΩ hG]
    exact isPiNumber_1053
  intro H K hH hK
  obtain ⟨α, rfl⟩ := hstab H hH
  obtain ⟨β, rfl⟩ := hstab K hK
  obtain ⟨g, rfl⟩ := exists_smul_eq G α β
  exact ⟨g, stabilizer_smul_eq_stabilizer_map_conj g α⟩

/-- If moreover the action is faithful and transitive, then the `{3, 13}`-core is trivial. -/
private theorem piCore_eq_bot_of_isPretransitive (hΩ : Nat.card Ω = 28)
    (hG : Nat.card G = 29484) [IsPretransitive G Ω] [FaithfulSMul G Ω] (m : G)
    (hm : orderOf m = 13) (hfix : (fixedBy Ω m).ncard = 2) : piCore {3, 13} G = ⊥ := by
  refine sSup_eq_bot.mpr fun N ⟨hN, hNpi⟩ => ?_
  obtain ⟨α, hα⟩ := exists_forall_smul_eq_of_isPiSubgroup hΩ hG m hm hfix N hNpi
  refine (Subgroup.eq_bot_iff_forall N).mpr fun n hn => ?_
  refine eq_of_smul_eq_smul (α := Ω) fun ω => ?_
  obtain ⟨g, rfl⟩ := exists_smul_eq G α ω
  have h := hα (g⁻¹ * n * g) (by simpa using hN.conj_mem n hn g⁻¹)
  calc n • g • α = g • (g⁻¹ * n * g) • α := by simp only [mul_smul, smul_inv_smul]
    _ = (1 : G) • g • α := by rw [h, one_smul]

omit [Finite G] in
/-- A Hall `{3, 13}`-subgroup of a group of order `29484 = 28 * 1053` has index dividing `28`. -/
private theorem index_dvd_of_isHallPiSubgroup (hG : Nat.card G = 29484) {H : Subgroup G}
    (hH : IsHallPiSubgroup {3, 13} H) : H.index ∣ 28 := by
  have h3 : Nat.Coprime 3 H.index :=
    (Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr fun h => hH.2 3 (by norm_num) h (by simp)
  have h13 : Nat.Coprime 13 H.index :=
    (Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr fun h => hH.2 13 (by norm_num) h (by simp)
  have hcop : Nat.Coprime H.index (3 ^ 4 * 13) :=
    (Nat.Coprime.mul_left (Nat.Coprime.pow_left 4 h3) h13).symm
  have hdvd := H.index_dvd_card
  rw [hG, show (29484 : ℕ) = 28 * (3 ^ 4 * 13) by norm_num] at hdvd
  exact hcop.dvd_of_dvd_mul_right hdvd

omit [Finite G] in
/-- Any three Hall `{3, 13}`-subgroups, not necessarily distinct, of a group of order
`29484 > 28 ^ 3` meet nontrivially. -/
private theorem inf_inf_ne_bot_of_card_eq (hG : Nat.card G = 29484)
    {H₁ H₂ H₃ : Subgroup G} (h₁ : IsHallPiSubgroup {3, 13} H₁)
    (h₂ : IsHallPiSubgroup {3, 13} H₂) (h₃ : IsHallPiSubgroup {3, 13} H₃) :
    H₁ ⊓ H₂ ⊓ H₃ ≠ ⊥ := by
  intro hbot
  have hle : (H₁ ⊓ H₂ ⊓ H₃).index ≤ 28 * 28 * 28 :=
    (Subgroup.index_inf_le.trans (Nat.mul_le_mul Subgroup.index_inf_le
      (Nat.le_of_dvd (by norm_num) (index_dvd_of_isHallPiSubgroup hG h₃)))).trans
      (Nat.mul_le_mul (Nat.mul_le_mul (Nat.le_of_dvd (by norm_num)
        (index_dvd_of_isHallPiSubgroup hG h₁)) (Nat.le_of_dvd (by norm_num)
        (index_dvd_of_isHallPiSubgroup hG h₂))) le_rfl)
  rw [hbot, Subgroup.index_bot, hG] at hle
  omega

end Action

/-! ### Orders of generated permutation groups -/

section Transversal

variable {Ω : Type} [Finite Ω]

/-- If a set `O` of points, with chosen permutations `R α`, is stable under the generators `X` up
to `K`, that is `x α ∈ O` and `(R (x α))⁻¹ * x * R α ∈ K` for `x ∈ X` and `α ∈ O`, then so it is
under every element of the subgroup that `X` generates. -/
private theorem forall_mem_of_mem_closure {X : Set (Equiv.Perm Ω)} {K : Subgroup (Equiv.Perm Ω)}
    {O : Set Ω} {R : Ω → Equiv.Perm Ω}
    (hX : ∀ x ∈ X, ∀ α ∈ O, x α ∈ O ∧ (R (x α))⁻¹ * x * R α ∈ K) {g : Equiv.Perm Ω}
    (hg : g ∈ Subgroup.closure X) : ∀ α ∈ O, g α ∈ O ∧ (R (g α))⁻¹ * g * R α ∈ K := by
  have hone : ∀ α ∈ O, (1 : Equiv.Perm Ω) α ∈ O ∧ (R ((1 : Equiv.Perm Ω) α))⁻¹ * 1 * R α ∈ K :=
    fun α hα => ⟨hα, by simp⟩
  have hmul : ∀ a b : Equiv.Perm Ω,
      (∀ α ∈ O, a α ∈ O ∧ (R (a α))⁻¹ * a * R α ∈ K) →
      (∀ α ∈ O, b α ∈ O ∧ (R (b α))⁻¹ * b * R α ∈ K) →
      ∀ α ∈ O, (a * b) α ∈ O ∧ (R ((a * b) α))⁻¹ * (a * b) * R α ∈ K := by
    intro a b ha hb α hα
    obtain ⟨hbα, hbK⟩ := hb α hα
    obtain ⟨haα, haK⟩ := ha (b α) hbα
    refine ⟨haα, ?_⟩
    have h : (R ((a * b) α))⁻¹ * (a * b) * R α =
        ((R (a (b α)))⁻¹ * a * R (b α)) * ((R (b α))⁻¹ * b * R α) := by
      simp [mul_assoc]
    rw [h]
    exact K.mul_mem haK hbK
  have hpow : ∀ a : Equiv.Perm Ω, (∀ α ∈ O, a α ∈ O ∧ (R (a α))⁻¹ * a * R α ∈ K) →
      ∀ n : ℕ, ∀ α ∈ O, (a ^ n) α ∈ O ∧ (R ((a ^ n) α))⁻¹ * a ^ n * R α ∈ K := by
    intro a ha n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ]; exact hmul _ _ ih ha
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact hX x hx
  | one => exact hone
  | mul a b _ _ ha hb => exact hmul a b ha hb
  | inv a _ ha =>
    have h1 : a * a ^ (orderOf a - 1) = 1 := by
      rw [← pow_succ', Nat.sub_add_cancel (orderOf_pos a), pow_orderOf_eq_one]
    rw [inv_eq_of_mul_eq_one_right h1]
    exact hpow a ha _

/-- **Orbit–stabilizer for a generated permutation group.** If, with the hypotheses of
`forall_mem_of_mem_closure`, the subgroup `K` of `closure X` fixes `ω`, and `R α ∈ closure X` maps
`ω` to `α` for `α ∈ O`, with `R ω = 1`, then `|closure X| = |O| * |K|`. -/
private theorem card_closure_eq {X : Set (Equiv.Perm Ω)} {K : Subgroup (Equiv.Perm Ω)} {ω : Ω}
    {O : Set Ω} {R : Ω → Equiv.Perm Ω} (hKX : K ≤ Subgroup.closure X)
    (hKω : ∀ k ∈ K, k ω = ω) (hRX : ∀ α ∈ O, R α ∈ Subgroup.closure X)
    (hRω : ∀ α ∈ O, R α ω = α) (hω : ω ∈ O) (hR1 : R ω = 1)
    (hX : ∀ x ∈ X, ∀ α ∈ O, x α ∈ O ∧ (R (x α))⁻¹ * x * R α ∈ K) :
    Nat.card (Subgroup.closure X) = O.ncard * Nat.card K := by
  have key : ∀ g ∈ Subgroup.closure X, g ω ∈ O ∧ (R (g ω))⁻¹ * g ∈ K := by
    intro g hg
    simpa [hR1] using forall_mem_of_mem_closure hX hg ω hω
  let e : Subgroup.closure X ≃ O × K :=
    { toFun := fun g => (⟨g.1 ω, (key g.1 g.2).1⟩, ⟨(R (g.1 ω))⁻¹ * g.1, (key g.1 g.2).2⟩)
      invFun := fun p => ⟨R p.1.1 * p.2.1, Subgroup.mul_mem _ (hRX _ p.1.2) (hKX p.2.2)⟩
      left_inv := fun g => by ext1; simp
      right_inv := fun p => by
        obtain ⟨⟨α, hα⟩, ⟨k, hk⟩⟩ := p
        have h1 : (R α * k) ω = α := by rw [Equiv.Perm.mul_apply, hKω k hk, hRω α hα]
        ext <;> simp [h1] }
  rw [Nat.card_congr e, Nat.card_prod, Nat.card_coe_set_eq]

omit [Finite Ω] in
/-- A point fixed by the generators is fixed by the generated subgroup. -/
private theorem apply_eq_of_mem_closure {X : Set (Equiv.Perm Ω)} {ω : Ω}
    (hX : ∀ x ∈ X, x ω = ω) {g : Equiv.Perm Ω} (hg : g ∈ Subgroup.closure X) : g ω = ω :=
  ((Subgroup.closure_le (stabilizer (Equiv.Perm Ω) ω)).mpr hX) hg

omit [Finite Ω] in
/-- An identity `x * a = b * k` exhibits `b⁻¹ * x * a` as `k`. -/
private theorem inv_mul_mul_mem_of_mul_eq {K : Subgroup (Equiv.Perm Ω)} {x a b k : Equiv.Perm Ω}
    (h : x * a = b * k) (hk : k ∈ K) : b⁻¹ * x * a ∈ K := by
  rwa [mul_assoc, h, inv_mul_cancel_left]

end Transversal

namespace Zenkov

/-! ### Zenkov's group

The field `𝔽₂₇` is `𝔽₃[g]` with `g ^ 3 = g + 1`; the element `g` has multiplicative order `13`.
The element `c₀ + c₁ g + c₂ g ^ 2` of `𝔽₂₇` is the point `c₀ + 3 c₁ + 9 c₂ : Fin 28` of the
projective line `ℙ¹(𝔽₂₇)`, and `∞` is the point `27`. The four generators are given by their
tables of values. -/

/-- Values of the translation `x ↦ x + 1`. -/
private def addOneFun : Fin 28 → Fin 28 :=
  ![1, 2, 0, 4, 5, 3, 7, 8, 6, 10, 11, 9, 13, 14, 12, 16, 17, 15, 19, 20, 18, 22, 23, 21, 25, 26,
    24, 27]

/-- Values of the translation `x ↦ x - 1`. -/
private def subOneFun : Fin 28 → Fin 28 :=
  ![2, 0, 1, 5, 3, 4, 8, 6, 7, 11, 9, 10, 14, 12, 13, 17, 15, 16, 20, 18, 19, 23, 21, 22, 26, 24,
    25, 27]

/-- Values of the multiplication `x ↦ g * x`. -/
private def mulGFun : Fin 28 → Fin 28 :=
  ![0, 3, 6, 9, 12, 15, 18, 21, 24, 4, 7, 1, 13, 16, 10, 22, 25, 19, 8, 2, 5, 17, 11, 14, 26, 20,
    23, 27]

/-- Values of the multiplication `x ↦ g⁻¹ * x`. -/
private def mulGInvFun : Fin 28 → Fin 28 :=
  ![0, 11, 19, 1, 9, 20, 2, 10, 18, 3, 14, 22, 4, 12, 23, 5, 13, 21, 6, 17, 25, 7, 15, 26, 8, 16,
    24, 27]

/-- Values of the Frobenius automorphism `x ↦ x ^ 3`. -/
private def frobFun : Fin 28 → Fin 28 :=
  ![0, 1, 2, 4, 5, 3, 8, 6, 7, 16, 17, 15, 11, 9, 10, 12, 13, 14, 23, 21, 22, 24, 25, 26, 19, 20,
    18, 27]

/-- Values of the inversion `x ↦ -1 / x`, which swaps `0` and `∞`. -/
private def negInvFun : Fin 28 → Fin 28 :=
  ![27, 2, 1, 19, 21, 24, 11, 12, 15, 17, 13, 6, 7, 10, 16, 8, 14, 9, 22, 3, 26, 4, 18, 25, 5, 23,
    20, 0]

/-- The translation `x ↦ x + 1` of `ℙ¹(𝔽₂₇)`. -/
private def addOne : Equiv.Perm (Fin 28) := ⟨addOneFun, subOneFun, by decide, by decide⟩

/-- The multiplication `x ↦ g * x` of `ℙ¹(𝔽₂₇)`, of order `13`. -/
private def mulG : Equiv.Perm (Fin 28) := ⟨mulGFun, mulGInvFun, by decide, by decide⟩

/-- The Frobenius automorphism `x ↦ x ^ 3` of `ℙ¹(𝔽₂₇)`, of order `3`. -/
private def frob : Equiv.Perm (Fin 28) := ⟨frobFun, frobFun ∘ frobFun, by decide, by decide⟩

/-- The inversion `x ↦ -1 / x` of `ℙ¹(𝔽₂₇)`, an involution. -/
private def negInv : Equiv.Perm (Fin 28) := ⟨negInvFun, negInvFun, by decide, by decide⟩

/-- **Zenkov's group `L₂(27) ⋊ ⟨φ⟩` (Kourovka 18.31).** The group of permutations of the projective
line `ℙ¹(𝔽₂₇) = 𝔽₂₇ ∪ {∞}` generated by the translation `x ↦ x + 1`, the multiplication
`x ↦ g * x` by an element `g` of order `13`, the inversion `x ↦ -1 / x` and the field automorphism
`φ : x ↦ x ^ 3` of order `3`. The first three generate `L₂(27) = PSL(2, 27)`, so this is the
extension of `L₂(27)` by a field automorphism of order `3`, and the stabilizer of `∞` is the
extension of a Borel subgroup of `L₂(27)` by `φ`.

Here `𝔽₂₇ = 𝔽₃[g]` with `g ^ 3 = g + 1`, the element `c₀ + c₁ g + c₂ g ^ 2` is the point
`c₀ + 3 c₁ + 9 c₂` of `Fin 28`, and `∞` is the point `27`.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31, which attributes
this example to V. I. Zenkov (Siberian Math. J. 63 (2022), no. 4, 720-722). -/
def group : Subgroup (Equiv.Perm (Fin 28)) := Subgroup.closure {negInv, addOne, mulG, frob}

/-- The subgroup generated by `x ↦ g * x` and `φ`: the stabilizer of `∞` and `0`. -/
private abbrev stabInftyZero : Subgroup (Equiv.Perm (Fin 28)) := Subgroup.closure {mulG, frob}

/-- The subgroup generated by `x ↦ x + 1`, `x ↦ g * x` and `φ`: the stabilizer of `∞`. -/
private abbrev stabInfty : Subgroup (Equiv.Perm (Fin 28)) := Subgroup.closure {addOne, mulG, frob}

/-- The translation `x ↦ x + b` for `b ≠ ∞`, as a word in `x ↦ x + 1` and `x ↦ g * x`. -/
private def transl (b : Fin 28) : Equiv.Perm (Fin 28) :=
  addOne ^ (b.val % 3) * (mulG * addOne * mulG⁻¹) ^ (b.val / 3 % 3) *
    (mulG ^ 2 * addOne * mulG⁻¹ ^ 2) ^ (b.val / 9 % 3)

/-- A permutation mapping `∞` to `a`: the identity for `a = ∞`, and `x ↦ a - 1 / x` otherwise. -/
private def fromInfty (a : Fin 28) : Equiv.Perm (Fin 28) := if a = 27 then 1 else transl a * negInv

/-- The negation `x ↦ -x` on `𝔽₂₇` (fixing `∞`). -/
private def negFun : Fin 28 → Fin 28 :=
  ![0, 2, 1, 6, 8, 7, 3, 5, 4, 18, 20, 19, 24, 26, 25, 21, 23, 22, 9, 11, 10, 15, 17, 16, 12, 14,
    13, 0]

/-- The logarithm to base `g` of `x ^ 2` for `x ∈ 𝔽₂₇ˣ` (and `0` at `0` and `∞`). -/
private def logSq : Fin 28 → ℕ :=
  ![0, 0, 0, 2, 6, 5, 2, 5, 6, 4, 3, 11, 8, 10, 1, 7, 12, 9, 4, 11, 3, 7, 9, 12, 8, 1, 10, 0]

/-- The logarithm to base `g` on the squares `x = g ^ i` of `𝔽₂₇ˣ` (and `0` elsewhere). -/
private def logG : Fin 28 → ℕ :=
  ![0, 0, 0, 1, 3, 9, 0, 0, 0, 2, 0, 12, 4, 5, 0, 10, 6, 0, 0, 0, 8, 0, 11, 0, 0, 7, 0, 0]

/-- The nonzero squares of `𝔽₂₇`, the orbit of `1` under `x ↦ g * x`. -/
private def squares : Finset (Fin 28) := {1, 3, 4, 5, 9, 11, 12, 13, 15, 16, 20, 22, 25}

/-- The points of `𝔽₂₇`, that is, all points but `∞`. -/
private def finitePoints : Finset (Fin 28) := Finset.univ.erase 27

/-- The stabilizer chain, third level: `x ↦ g ^ (logG α) * x` maps `1` to `α ∈ squares`, and these
coset representatives are stable under `x ↦ g * x` and `φ`, up to `⟨φ⟩`. -/
private theorem squares_spec : ∀ α ∈ squares, (mulG ^ logG α) 1 = α ∧
    (mulG α ∈ squares ∧ mulG * mulG ^ logG α = mulG ^ logG (mulG α) * 1) ∧
    (frob α ∈ squares ∧ frob * mulG ^ logG α = mulG ^ logG (frob α) * frob) := by
  decide +kernel

/-- The stabilizer chain, second level: the translations are coset representatives stable under
the generators of the stabilizer of `∞`, up to the stabilizer of `∞` and `0`. -/
private theorem finitePoints_spec : ∀ α ∈ finitePoints, transl α 0 = α ∧
    (addOne α ∈ finitePoints ∧ addOne * transl α = transl (addOne α) * 1) ∧
    (mulG α ∈ finitePoints ∧ mulG * transl α = transl (mulG α) * mulG) ∧
    (frob α ∈ finitePoints ∧ frob * transl α = transl (frob α) * frob) := by
  decide +kernel

/-- The stabilizer chain, first level: the permutations `fromInfty α` are coset representatives
stable under the generators of `group`, up to the stabilizer of `∞`. -/
private theorem fromInfty_spec : ∀ α, fromInfty α 27 = α ∧
    negInv * fromInfty α = fromInfty (negInv α) * (transl (negFun α) * mulG ^ logSq α) ∧
    addOne * fromInfty α = fromInfty (addOne α) * (if α = 27 then addOne else 1) ∧
    mulG * fromInfty α = fromInfty (mulG α) * (if α = 27 then mulG else mulG⁻¹) ∧
    frob * fromInfty α = fromInfty (frob α) * frob := by
  decide +kernel

private theorem frob_pow_three : frob ^ 3 = 1 := by decide

private theorem frob_ne_one : frob ≠ 1 := by decide

private theorem mulG_pow_thirteen : mulG ^ 13 = 1 := by decide

private theorem mulG_ne_one : mulG ≠ 1 := by decide

private theorem mulG_apply_eq_self_iff (x : Fin 28) : mulG x = x ↔ x = 0 ∨ x = 27 := by
  revert x
  decide

private theorem card_stabInftyZero : Nat.card stabInftyZero = 39 := by
  have hf : frob ∈ stabInftyZero := Subgroup.subset_closure (by simp)
  have hm : mulG ∈ stabInftyZero := Subgroup.subset_closure (by simp)
  have h := card_closure_eq (X := {mulG, frob}) (K := Subgroup.closure {frob}) (ω := 1)
    (O := (squares : Set (Fin 28))) (R := fun α => mulG ^ logG α)
    ((Subgroup.closure_le _).mpr (by simpa using hf))
    (fun k hk => apply_eq_of_mem_closure (by rintro x rfl; decide) hk)
    (fun α _ => Subgroup.pow_mem _ hm _)
    (fun α hα => (squares_spec α hα).1) (by decide) (by decide)
    (by
      intro x hx α hα
      obtain ⟨-, h1, h2⟩ := squares_spec α hα
      rcases hx with rfl | rfl
      · exact ⟨h1.1, inv_mul_mul_mem_of_mul_eq h1.2 (one_mem _)⟩
      · exact ⟨h2.1, inv_mul_mul_mem_of_mul_eq h2.2 (Subgroup.subset_closure rfl)⟩)
  rw [h, Set.ncard_coe_finset, show squares.card = 13 by decide, ← Subgroup.zpowers_eq_closure,
    Nat.card_zpowers, orderOf_eq_prime frob_pow_three frob_ne_one]

private theorem transl_mem (b : Fin 28) : transl b ∈ stabInfty := by
  have ht : addOne ∈ stabInfty := Subgroup.subset_closure (by simp)
  have hm : mulG ∈ stabInfty := Subgroup.subset_closure (by simp)
  exact stabInfty.mul_mem (stabInfty.mul_mem (stabInfty.pow_mem ht _)
    (stabInfty.pow_mem (stabInfty.mul_mem (stabInfty.mul_mem hm ht) (stabInfty.inv_mem hm)) _))
    (stabInfty.pow_mem (stabInfty.mul_mem (stabInfty.mul_mem (stabInfty.pow_mem hm _) ht)
      (stabInfty.pow_mem (stabInfty.inv_mem hm) _)) _)

private theorem card_stabInfty : Nat.card stabInfty = 1053 := by
  have hf : frob ∈ stabInftyZero := Subgroup.subset_closure (by simp)
  have hm : mulG ∈ stabInftyZero := Subgroup.subset_closure (by simp)
  have h := card_closure_eq (X := {addOne, mulG, frob}) (K := stabInftyZero) (ω := 0)
    (O := (finitePoints : Set (Fin 28))) (R := transl)
    (Subgroup.closure_mono (Set.subset_insert _ _))
    (fun k hk => apply_eq_of_mem_closure (by rintro x (rfl | rfl) <;> decide) hk)
    (fun α _ => transl_mem α) (fun α hα => (finitePoints_spec α hα).1) (by decide) (by decide)
    (by
      intro x hx α hα
      obtain ⟨-, h1, h2, h3⟩ := finitePoints_spec α hα
      rcases hx with rfl | rfl | rfl
      · exact ⟨h1.1, inv_mul_mul_mem_of_mul_eq h1.2 (one_mem _)⟩
      · exact ⟨h2.1, inv_mul_mul_mem_of_mul_eq h2.2 hm⟩
      · exact ⟨h3.1, inv_mul_mul_mem_of_mul_eq h3.2 hf⟩)
  rw [h, Set.ncard_coe_finset, show finitePoints.card = 27 by decide, card_stabInftyZero]

private theorem fromInfty_mem (a : Fin 28) : fromInfty a ∈ group := by
  unfold fromInfty
  split_ifs
  · exact one_mem _
  · exact group.mul_mem (Subgroup.closure_mono (Set.subset_insert _ _) (transl_mem a))
      (Subgroup.subset_closure (by simp))

/-- **Order of Zenkov's group.** Zenkov's permutation group has order $29484$.

The orbit–stabilizer argument counts $28$ points in the orbit of $\infty$ and $1053$ elements
in its stabilizer, giving $28 \cdot 1053 = 29484$.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31, which attributes
this example to V. I. Zenkov (Siberian Math. J. 63 (2022), no. 4, 720-722). -/
theorem card_group : Nat.card group = 29484 := by
  have ht : addOne ∈ stabInfty := Subgroup.subset_closure (by simp)
  have hm : mulG ∈ stabInfty := Subgroup.subset_closure (by simp)
  have hf : frob ∈ stabInfty := Subgroup.subset_closure (by simp)
  have h := card_closure_eq (X := {negInv, addOne, mulG, frob}) (K := stabInfty) (ω := 27)
    (O := Set.univ) (R := fromInfty) (Subgroup.closure_mono (Set.subset_insert _ _))
    (fun k hk => apply_eq_of_mem_closure (by rintro x (rfl | rfl | rfl) <;> decide) hk)
    (fun α _ => fromInfty_mem α) (fun α _ => (fromInfty_spec α).1) (Set.mem_univ _)
    (by simp [fromInfty])
    (by
      intro x hx α _
      obtain ⟨-, h1, h2, h3, h4⟩ := fromInfty_spec α
      refine ⟨Set.mem_univ _, ?_⟩
      rcases hx with rfl | rfl | rfl | rfl
      · exact inv_mul_mul_mem_of_mul_eq h1 (stabInfty.mul_mem (transl_mem _)
          (stabInfty.pow_mem hm _))
      · exact inv_mul_mul_mem_of_mul_eq h2 (by split_ifs <;> simp [ht])
      · exact inv_mul_mul_mem_of_mul_eq h3 (by split_ifs <;> simp [hm])
      · exact inv_mul_mul_mem_of_mul_eq h4 hf)
  rw [group, h, Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin, card_stabInfty]

/-- Zenkov's group acts transitively on `ℙ¹(𝔽₂₇)`. -/
private theorem isPretransitive : IsPretransitive group (Fin 28) :=
  (isPretransitive_iff_base (27 : Fin 28)).mpr fun α =>
    ⟨⟨fromInfty α, fromInfty_mem α⟩, (fromInfty_spec α).1⟩

private theorem mulG_mem : mulG ∈ group := Subgroup.subset_closure (by simp)

private theorem orderOf_mulG : orderOf (⟨mulG, mulG_mem⟩ : group) = 13 :=
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  orderOf_eq_prime (Subtype.ext mulG_pow_thirteen) fun h => mulG_ne_one (congrArg Subtype.val h)

private theorem ncard_fixedBy_mulG : (fixedBy (Fin 28) (⟨mulG, mulG_mem⟩ : group)).ncard = 2 := by
  have h : fixedBy (Fin 28) (⟨mulG, mulG_mem⟩ : group) = {0, 27} := by
    ext x
    exact mulG_apply_eq_self_iff x
  rw [h, Set.ncard_pair (by decide)]

/-- **Zenkov's group is a `D_π`-group for `π = {3, 13}`.** Every `{3, 13}`-subgroup of
`L₂(27) ⋊ ⟨φ⟩` fixes a point of `ℙ¹(𝔽₂₇)`, so the maximal `{3, 13}`-subgroups are the point
stabilizers, which are conjugate.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31, which attributes
this example to V. I. Zenkov (Siberian Math. J. 63 (2022), no. 4, 720-722). -/
theorem isDPiGroup : IsDPiGroup {3, 13} group :=
  have := isPretransitive
  isDPiGroup_of_isPretransitive (Ω := Fin 28) (by simp) card_group _ orderOf_mulG
    ncard_fixedBy_mulG

/-- **Zenkov's group has trivial `{3, 13}`-core.** A normal `{3, 13}`-subgroup of
`L₂(27) ⋊ ⟨φ⟩` fixes a point of `ℙ¹(𝔽₂₇)`, hence every point, so it is trivial.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31, which attributes
this example to V. I. Zenkov (Siberian Math. J. 63 (2022), no. 4, 720-722). -/
theorem piCore_eq_bot : piCore {3, 13} group = ⊥ :=
  have := isPretransitive
  piCore_eq_bot_of_isPretransitive (Ω := Fin 28) (by simp) card_group _ orderOf_mulG
    ncard_fixedBy_mulG

/-- **Any three Hall $\{3, 13\}$-subgroups of Zenkov's group meet nontrivially.** For any Hall
$\{3, 13\}$-subgroups $H_1$, $H_2$, $H_3$ of $L_2(27) \rtimes \langle \varphi \rangle$, not
necessarily distinct, $H_1 \cap H_2 \cap H_3 \ne 1$.

Each of them has order $1053 = 3^4 \cdot 13$ and index $28$ in this group of order
$29484 = 28 \cdot 1053$, so their intersection has index at most $28^3 = 21952 < 29484$.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31, which attributes
this example to V. I. Zenkov (Siberian Math. J. 63 (2022), no. 4, 720-722). -/
theorem inf_inf_ne_bot_of_isHallPiSubgroup {H₁ H₂ H₃ : Subgroup group}
    (h₁ : IsHallPiSubgroup {3, 13} H₁) (h₂ : IsHallPiSubgroup {3, 13} H₂)
    (h₃ : IsHallPiSubgroup {3, 13} H₃) : H₁ ⊓ H₂ ⊓ H₃ ≠ ⊥ :=
  inf_inf_ne_bot_of_card_eq card_group h₁ h₂ h₃

end Zenkov

/--
**Three Hall π-subgroups need not meet in the π-core.** It is not the case that for every set
$\pi$ of natural numbers every finite $D_\pi$-group $G$ has Hall $\pi$-subgroups $H_1$, $H_2$,
$H_3$ with $H_1 \cap H_2 \cap H_3 = O_\pi(G)$, the $\pi$-core of $G$: the answer to
Kourovka 18.31 is negative.

V. I. Zenkov (2022) gave a counterexample: $G$ an extension of $L_2(27)$ by a field automorphism
of order $3$, with a subgroup $H$ that is an extension of a Borel subgroup of $L_2(27)$ by a field
automorphism of order $3$.

Source: E. I. Khukhro and V. D.
Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue,
arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31 (E. P. Vdovin, D. O. Revin);
