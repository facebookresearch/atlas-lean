module

public import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.TypeTags.Finite
import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Propermutability in intermediate subgroups

A reflection subgroup in the product of the dihedral group of order eight and a cyclic
group of order four witnesses `propermutableNotInIntermediate_holds`.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.PropermutableSubgroupKourovka18Problem91Wanted

open scoped Pointwise

/-- **Permuting subgroups.** Let $H$ and $X$ be subgroups of a group $G$. Then $H$ permutes
with $X$ when $HX = XH$ as subsets of $G$, where $HX = \{hx : h \in H, x \in X\}$ and
$XH = \{xh : x \in X, h \in H\}$. -/
def Permutes {G : Type} [Group G] (H X : Subgroup G) : Prop :=
  (H : Set G) * (X : Set G) = (X : Set G) * (H : Set G)

/-- **Propermutable subgroups.** A subgroup $H$ of a group $G$ is propermutable in $G$ when there
is a subgroup $B$ of $G$ with $G = N_G(H)B$ (every element of $G$ is a product $nb$ with $n$ in
the normalizer $N_G(H)$ of $H$ and $b \in B$) such that $H$ permutes with every subgroup $X$ of
$B$, that is, $HX = XH$. -/
def IsPropermutable {G : Type} [Group G] (H : Subgroup G) : Prop :=
  ∃ B : Subgroup G, (Subgroup.normalizer (H : Set G) : Set G) * (B : Set G) = Set.univ ∧
    ∀ X : Subgroup G, X ≤ B → Permutes H X

/-- **Kourovka Problem 18.91(a) (statement).** The statement of Kourovka Problem 18.91(a)
(A. N. Skiba): there exist a finite group $G$ and subgroups $A \le B \le G$ such that $A$ is
propermutable in $G$ but $A$, regarded as a subgroup of $B$, is not propermutable in $B$. -/
def propermutableNotInIntermediate : Prop :=
  ∃ (G : Type) (_ : Group G) (_ : Finite G) (A B : Subgroup G),
    A ≤ B ∧ IsPropermutable A ∧ ¬ IsPropermutable (A.subgroupOf B)

open DihedralGroup

private abbrev G := DihedralGroup 4 × Multiplicative (ZMod 4)

private abbrev s : G := (sr 0, 1)

-- The subgroup generated by the reflection.
private def reflection : Subgroup G where
  carrier := {x | x = 1 ∨ x = s}
  one_mem' := Or.inl rfl
  inv_mem' := by rintro _ (rfl | rfl) <;> decide
  mul_mem' := by rintro _ _ (rfl | rfl) (rfl | rfl) <;> decide

private def rotations : Subgroup G where
  carrier := {x | ∃ i : ZMod 4, x = (r i, 1)}
  one_mem' := ⟨0, rfl⟩
  inv_mem' := by
    rintro _ ⟨i, rfl⟩
    exact ⟨-i, by simp⟩
  mul_mem' := by
    rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩
    exact ⟨i + j, rfl⟩

private def rotationIndex : DihedralGroup 4 → ZMod 4
  | r i | sr i => i

-- Match the parity of the dihedral index to that of the cyclic coordinate.
private def intermediate : Subgroup G where
  carrier := {x | (rotationIndex x.1).val % 2 = x.2.toAdd.val % 2}
  one_mem' := rfl
  inv_mem' := by
    change ∀ x : G, _ → _
    decide
  mul_mem' := by
    change ∀ x y : G, _ → _ → _
    decide

-- Every element is a product of an element centralizing s and a pure rotation.
private theorem ambient_factorization :
    (Subgroup.normalizer (reflection : Set G) : Set G) * (rotations : Set G) = Set.univ := by
  have hn (u : DihedralGroup 4) (z : Multiplicative (ZMod 4))
      (hu : sr 0 * u = u * sr 0) : (u, z) ∈ Subgroup.normalizer (reflection : Set G) := by
    apply Subgroup.centralizer_le_normalizer
    intro a ha
    rcases ha with rfl | rfl
    · simp
    · exact Prod.ext hu (by simp)
  apply Set.eq_univ_iff_forall.mpr
  rintro ⟨i | i, z⟩
  · exact ⟨(1, z), hn 1 z (by simp), (r i, 1), ⟨i, rfl⟩, by simp⟩
  · exact ⟨(sr 0, z), hn (sr 0) z rfl, (r i, 1), ⟨i, rfl⟩, by simp⟩

private theorem reflection_propermutable : IsPropermutable reflection := by
  refine ⟨rotations, ambient_factorization, fun X hX ↦ ?_⟩
  have hswap (x : G) (hx : x ∈ X) : s * x = x⁻¹ * s ∧ x * s = s * x⁻¹ := by
    obtain ⟨i, rfl⟩ := hX hx
    simp [s]
  apply Set.Subset.antisymm
  · rintro _ ⟨a, ha, x, hx, rfl⟩
    rcases ha with rfl | rfl
    · simpa using Set.mul_mem_mul hx reflection.one_mem
    · exact ⟨x⁻¹, X.inv_mem hx, s, Or.inr rfl, (hswap x hx).1.symm⟩
  · rintro _ ⟨x, hx, a, ha, rfl⟩
    rcases ha with rfl | rfl
    · simpa using Set.mul_mem_mul reflection.one_mem hx
    · exact ⟨s, Or.inr rfl, x⁻¹, X.inv_mem hx, (hswap x hx).2.symm⟩

-- An even dihedral index makes x commute with s. For an odd index the cyclic coordinate
-- has order four, so either displayed equality forces k = 1 by its second coordinate.
private theorem commute_of_reorder (x : G) (hx : x ∈ intermediate) (k : Fin 4)
    (h : x ^ k.val = s * x ∨ x ^ k.val * s = s * x) : Commute x s := by
  change (rotationIndex x.1).val % 2 = x.2.toAdd.val % 2 at hx
  change x * s = s * x
  revert h k hx x
  decide

private theorem intermediate_obstruction :
    ¬ IsPropermutable (reflection.subgroupOf intermediate) := by
  rintro ⟨P, hcover, hperm⟩
  let a : intermediate := ⟨s, rfl⟩
  have ha : a ∈ reflection.subgroupOf intermediate := Or.inr rfl
  let d : intermediate := ⟨(r 1, Multiplicative.ofAdd 1), rfl⟩
  obtain ⟨n, hn, x, hx, hnx⟩ := Set.eq_univ_iff_forall.mp hcover d
  -- The normalizer of an order-two subgroup centralizes its generator.
  have hconj := (Subgroup.mem_normalizer_iff.mp hn a).mp ha
  change (n : G) * s * (n : G)⁻¹ = 1 ∨ (n : G) * s * (n : G)⁻¹ = s at hconj
  have hns : Commute (n : G) s := by
    rcases hconj with h | h
    · have : s = 1 := by simpa using h
      exact absurd this (by decide)
    · exact mul_inv_eq_iff_eq_mul.mp h
  -- Apply permutability to the cyclic subgroup generated by the other factor.
  have hax := Set.mul_mem_mul ha (Subgroup.mem_zpowers x)
  rw [show (_ : Set intermediate) * _ = _ from
    hperm (Subgroup.zpowers x) (Subgroup.zpowers_le.mpr hx)] at hax
  obtain ⟨y, hy, b, hb, heq⟩ := hax
  obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff y x).mp (mem_powers_iff_mem_zpowers.mpr hy)
  have heq' := congrArg Subtype.val heq
  change (x : G) ^ m * (b : G) = s * (x : G) at heq'
  have hexp : ∀ g : G, g ^ 4 = 1 := by decide
  rw [pow_eq_pow_mod m (hexp x)] at heq'
  have hxs : Commute (x : G) s := by
    apply commute_of_reorder x x.property ⟨m % 4, Nat.mod_lt _ (by decide)⟩
    change (b : G) = 1 ∨ (b : G) = s at hb
    rcases hb with hb | hb
    · exact Or.inl (by simpa [hb] using heq')
    · exact Or.inr (by simpa [hb] using heq')
  have hds : Commute (d : G) s := by
    rw [← hnx]
    exact hns.mul_left hxs
  exact (by decide : (d : G) * s ≠ s * (d : G)) hds

/--
**Propermutability is not inherited by intermediate subgroups.** There exist a finite group $G$
and subgroups $A \le B \le G$ such that $A$ is propermutable in $G$ but $A$, regarded as a
subgroup of $B$, is not propermutable in $B$. This is the positive answer to
Kourovka Problem 18.91(a).

The Kourovka Archive answers 18.91(a) "Yes, there is" (A. A. Pypka and D. Yu. Storozhenko, 2017).

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.91 (A. N.
Skiba); resolution: (a) A. A. Pypka and D. Yu. Storozhenko, Dopov. Nac. Akad. Nauk Ukrain. 2017,
no. 7, 18-20 (Ukrainian); (b) Kh. A. Al-Sharo, Finite groups with given systems of weakly
S-propermutable subgroups, J. Group Theory 19 (2016), no. 5, 871-887, Kourovka Archive,
Problem 18.91: a) Yes, there is; b) Yes, it is. Al-Sharo, Corollary 1.3: if X ⊴ G, P ∈ Syl_p(X),
(p - 1, |X|) = 1, and for some 1 < D < P every subgroup of P of order |D| (and, when P is
non-abelian and |D| = 2, every cyclic subgroup of order 4) is S-propermutable in G, then X is
p-nilpotent, https://doi.org/10.1515/jgth-2016-0017.
-/
public theorem propermutableNotInIntermediate_holds : propermutableNotInIntermediate := by
  refine ⟨G, inferInstance, inferInstance, reflection, intermediate, ?_,
    reflection_propermutable, intermediate_obstruction⟩
  rintro _ (rfl | rfl) <;> rfl

end MathlibExt.GroupTheory.PropermutableSubgroupKourovka18Problem91Wanted
