/-!
# Finite-state automorphisms of regular rooted trees

`FiniteStateTree.mem_finiteStateAutomorphisms_iff` identifies the subgroup generated by
automorphisms with finitely many sections with the length-and-prefix predicate
`FiniteStateTree.IsFiniteStateAut`. The two section conventions agree on tree automorphisms.
Open `MathlibExt.GroupTheory.FiniteStateTree` for the common predicates and subgroup.
-/

@[expose] public section

namespace MathlibExt.GroupTheory

namespace FiniteStateFreeProductKourovka16Problem85Wanted

/-- **Automorphisms of the regular rooted tree (Kourovka 16.85).** Let $d$ be a natural number and
let $X^*$ be the set of finite words over the alphabet $X = \{0, \dots, d-1\}$, the vertices of the
$d$-regular rooted tree. A permutation $f$ of $X^*$ is a tree automorphism when, for all words $u$
and $v$, the word $f(u)$ has the same length $|u|$ as $u$ and the first $|u|$ letters of $f(uv)$
form the word $f(u)$, where $uv$ denotes concatenation. -/
def IsTreeAut {d : ℕ} (f : Equiv.Perm (List (Fin d))) : Prop :=
  ∀ u v : List (Fin d), (f u).length = u.length ∧ (f (u ++ v)).take u.length = f u

/-- **Section of a permutation of the tree at a vertex (Kourovka 16.85).** For a natural number
$d$, let $X^*$ be the set of finite words over $X = \{0, \dots, d-1\}$, let $f$ be a permutation of
$X^*$ and let $u \in X^*$, of length $|u|$. The section (state) of $f$ at $u$ is the map
$X^* \to X^*$ sending a word $w$ to the word obtained from $f(uw)$ by deleting its first $|u|$
letters (all of them if it has fewer), where $uw$ denotes concatenation. -/
def treeSection {d : ℕ} (f : Equiv.Perm (List (Fin d))) (u : List (Fin d)) :
    List (Fin d) → List (Fin d) :=
  fun w => (f (u ++ w)).drop u.length

/-- **Finite-state automorphisms of the regular rooted tree (Kourovka 16.85).** For a natural
number $d$, let $X^*$ be the set of finite words over $X = \{0, \dots, d-1\}$. A permutation $f$
of $X^*$ is a finite-state automorphism when it is an automorphism of the $d$-regular rooted tree
and its sections at the vertices $u \in X^*$ form a finite set of maps $X^* \to X^*$. -/
def IsFiniteStateAut {d : ℕ} (f : Equiv.Perm (List (Fin d))) : Prop :=
  IsTreeAut f ∧ (Set.range (treeSection f)).Finite

end FiniteStateFreeProductKourovka16Problem85Wanted

namespace FiniteStateIrreducibleGeneratorsKourovka16Problem86Wanted

/-- **Automorphisms of the regular rooted tree.** For a natural number $d$, the $d$-regular rooted
tree has as vertices the finite words over the alphabet $\{0, \dots, d-1\}$; write $vw$ for the
concatenation of words $v$ and $w$. The root is the empty word and the children of a word $v$ are
the words $vi$ for letters $i$. A permutation $g$ of the words is a tree automorphism when for all
words $v$ and $w$ there is a word $u$ of the same length as $w$ with $g(vw) = g(v)u$.

For a permutation of the words this says that $g$ preserves lengths and the prefix order, so it is
an automorphism of the tree as a graph. -/
def IsTreeAutomorphism {d : ℕ} (g : Equiv.Perm (List (Fin d))) : Prop :=
  ∀ v w : List (Fin d), ∃ u : List (Fin d), u.length = w.length ∧ g (v ++ w) = g v ++ u

/-- **Section of a word permutation at a vertex.** For a natural number $d$, let $g$ be a
permutation of the finite words over the alphabet $\{0, \dots, d-1\}$ and let $v$ be a word. The
section (state) of $g$ at $v$ is the map sending a word $w$ to the word obtained from $g(vw)$ by
deleting its first $|g(v)|$ letters, where $vw$ is the concatenation of $v$ and $w$ and $|g(v)|$ is
the length of $g(v)$. When $g$ is a tree automorphism, the image of $w$ is the word $u$ with
$g(vw) = g(v)u$. -/
def treeSection {d : ℕ} (g : Equiv.Perm (List (Fin d))) (v : List (Fin d)) :
    List (Fin d) → List (Fin d) :=
  fun w => (g (v ++ w)).drop (g v).length

/-- **Finite-state automorphisms of a regular rooted tree.** For a natural number $d$, consider the
$d$-regular rooted tree whose vertices are the finite words over the alphabet $\{0, \dots, d-1\}$.
The group of finite-state automorphisms of this tree is the subgroup of the group of all
permutations of the words generated by the tree automorphisms that have only finitely many
distinct sections.

These automorphisms are closed under products and inverses, so the subgroup consists of exactly
them. -/
def finiteStateAutomorphisms (d : ℕ) : Subgroup (Equiv.Perm (List (Fin d))) :=
  Subgroup.closure {g | IsTreeAutomorphism g ∧ (Set.range (treeSection g)).Finite}

variable {d : ℕ}

/-- **Section decomposition.** The image of an extension is the image of its prefix
followed by the section applied to the suffix.

Source: the section argument in `MathlibExt.GroupTheory.FiniteStateIrreducibleGenerators`. -/
theorem IsTreeAutomorphism.map_append_section {g : Equiv.Perm (List (Fin d))}
    (hg : IsTreeAutomorphism g) (v w) :
    g (v ++ w) = g v ++ treeSection g v w := by
  obtain ⟨u, _, hu⟩ := hg v w
  simp [treeSection, hu]

/-- **Fixed root.** A tree automorphism fixes the empty word.

Source: the section argument in `MathlibExt.GroupTheory.FiniteStateIrreducibleGenerators`. -/
theorem IsTreeAutomorphism.map_nil {g : Equiv.Perm (List (Fin d))} (hg : IsTreeAutomorphism g) :
    g [] = [] := by
  obtain ⟨x, hx⟩ := g.surjective []
  obtain ⟨u, _, hu⟩ := hg [] x
  simpa [hx] using (List.append_eq_nil_iff.mp (by simpa [hx] using hu.symm)).1

/-- **Preservation of levels.** A tree automorphism preserves word length.

Source: the section argument in `MathlibExt.GroupTheory.FiniteStateIrreducibleGenerators`. -/
theorem IsTreeAutomorphism.length_apply {g : Equiv.Perm (List (Fin d))}
    (hg : IsTreeAutomorphism g) (x : List (Fin d)) :
    (g x).length = x.length := by
  obtain ⟨u, hlen, hu⟩ := hg [] x
  simpa [hg.map_nil, ← hlen] using congrArg List.length hu

private theorem tree_inv {g : Equiv.Perm (List (Fin d))} (hg : IsTreeAutomorphism g) :
    IsTreeAutomorphism g.symm := by
  intro v w
  let x := g.symm (v ++ w)
  have hx : g x = v ++ w := g.apply_symm_apply _
  have hl : x.length = v.length + w.length := by rw [← hg.length_apply x, hx, List.length_append]
  let y := x.take v.length
  let z := x.drop v.length
  have hy : y.length = v.length := by simp [y, hl]
  have hyz : y ++ z = x := List.take_append_drop _ _
  have eqn := hg.map_append_section y z
  rw [hyz, hx] at eqn
  have e : v = g y := by
    simpa [List.take_append, hg.length_apply, hy] using congrArg (List.take v.length) eqn
  refine ⟨z, by simp [z, hl], ?_⟩
  change x = g.symm v ++ z
  simpa [e] using hyz.symm

private theorem sec_inj {g : Equiv.Perm (List (Fin d))}
    (hg : IsTreeAutomorphism g) (v : List (Fin d)) :
    Function.Injective (treeSection g v) := by
  intro x y h
  have e : g (v ++ x) = g (v ++ y) := by rw [hg.map_append_section, h, ← hg.map_append_section]
  simpa using g.injective e

private theorem sec_inv_apply {g : Equiv.Perm (List (Fin d))} (hg : IsTreeAutomorphism g) (v w) :
    treeSection g (g.symm v) (treeSection g.symm v w) = w := by
  have h := hg.map_append_section (g.symm v) (treeSection g.symm v w)
  simpa [← (tree_inv hg).map_append_section] using h.symm

/-- **Bijectivity of sections.** Each section of a tree automorphism permutes the words
in the subtree rooted at its vertex.

Source: the section argument in `MathlibExt.GroupTheory.FiniteStateIrreducibleGenerators`. -/
theorem IsTreeAutomorphism.bijective_treeSection {g : Equiv.Perm (List (Fin d))}
    (hg : IsTreeAutomorphism g) (v : List (Fin d)) : Function.Bijective (treeSection g v) :=
  ⟨sec_inj hg v, fun w =>
    ⟨treeSection g.symm (g v) w, by simpa using sec_inv_apply hg (g v) w⟩⟩

private def isFiniteState (g : Equiv.Perm (List (Fin d))) :=
  IsTreeAutomorphism g ∧ (Set.range (treeSection g)).Finite

private theorem finiteState_mul {g h : Equiv.Perm (List (Fin d))}
    (hg : isFiniteState g) (hh : isFiniteState h) :
    isFiniteState (g * h) := by
  constructor
  · intro v w
    obtain ⟨u, hlen, e⟩ := hh.1 v w
    obtain ⟨u', hlen', e'⟩ := hg.1 (h v) u
    exact ⟨u', hlen'.trans hlen, by simp [Equiv.Perm.mul_apply, e, e']⟩
  · apply (hg.2.image2 (· ∘ ·) hh.2).subset
    rintro _ ⟨v, rfl⟩
    refine ⟨_, ⟨h v, rfl⟩, _, ⟨v, rfl⟩, ?_⟩
    funext w
    change _ = (g (h (v ++ w))).drop (g (h v)).length
    rw [hh.1.map_append_section, hg.1.map_append_section]
    simp

private theorem finiteState_inv {g : Equiv.Perm (List (Fin d))} (hg : isFiniteState g) :
    isFiniteState g⁻¹ := by
  classical
  refine ⟨tree_inv hg.1, ?_⟩
  apply (hg.2.image (fun f => Function.invFun f)).subset
  rintro _ ⟨v, rfl⟩
  refine ⟨_, ⟨g.symm v, rfl⟩, ?_⟩
  funext w
  let f := treeSection g (g.symm v)
  let x := treeSection g.symm v w
  change Function.invFun f w = x
  calc
    _ = Function.invFun f (f x) := congrArg (Function.invFun f) (sec_inv_apply hg.1 v w).symm
    _ = x := Function.leftInverse_invFun (sec_inj hg.1 _) _

/-- **Finite sections characterize subgroup membership.** A word permutation belongs to the
finite-state subgroup exactly when it preserves extensions and has finitely many sections.

Source: the section argument in `MathlibExt.GroupTheory.FiniteStateIrreducibleGenerators`. -/
theorem mem_finiteStateAutomorphisms_iff_finite_sections (g : Equiv.Perm (List (Fin d))) :
    g ∈ finiteStateAutomorphisms d ↔ IsTreeAutomorphism g ∧ (Set.range (treeSection g)).Finite := by
  refine ⟨fun h => Subgroup.closure_induction (fun x hx => hx) ?_ (fun _ _ _ _ => finiteState_mul)
    (fun _ _ => finiteState_inv) h, fun hx => Subgroup.subset_closure hx⟩
  constructor
  · exact fun _ w => ⟨w, rfl, rfl⟩
  · apply (Set.finite_singleton id).subset
    rintro _ ⟨v, rfl⟩
    change treeSection 1 v = id
    funext w
    simp [treeSection]

open FiniteStateFreeProductKourovka16Problem85Wanted (IsTreeAut IsFiniteStateAut)

/-- **Equivalent tree automorphism criteria.** Preserving extensions by suffixes of the same
length is equivalent to preserving word lengths and prefixes.

Source: the tree automorphism criteria in Kourovka Problems 16.34, 16.85 and 16.86. -/
theorem isTreeAutomorphism_iff_isTreeAut {g : Equiv.Perm (List (Fin d))} :
    IsTreeAutomorphism g ↔ IsTreeAut g := by
  constructor
  · intro h u v
    refine ⟨h.length_apply u, ?_⟩
    rw [h.map_append_section u v, ← h.length_apply u, List.take_left]
  · intro h u v
    refine ⟨FiniteStateFreeProductKourovka16Problem85Wanted.treeSection g u v, ?_, ?_⟩
    · simp [FiniteStateFreeProductKourovka16Problem85Wanted.treeSection, (h (u ++ v) []).1]
    · rw [← (h u v).2]
      exact (List.take_append_drop ..).symm

/-- **Agreement of sections.** For a tree automorphism the input prefix and its image have
the same length, so dropping either length defines the same section.

Source: the section definitions in Kourovka Problems 16.34, 16.85 and 16.86. -/
theorem treeSection_eq_of_isTreeAut {g : Equiv.Perm (List (Fin d))} (hg : IsTreeAut g) :
    treeSection g = FiniteStateFreeProductKourovka16Problem85Wanted.treeSection g := by
  funext u w
  simp [treeSection, FiniteStateFreeProductKourovka16Problem85Wanted.treeSection, (hg u []).1]

/-- **Membership in the finite-state automorphism group.** A word permutation belongs to the
subgroup if and only if it preserves lengths and prefixes and has finitely many sections.

Source: the section argument in `MathlibExt.GroupTheory.FiniteStateIrreducibleGenerators`. -/
theorem mem_finiteStateAutomorphisms_iff (g : Equiv.Perm (List (Fin d))) :
    g ∈ finiteStateAutomorphisms d ↔ IsFiniteStateAut g := by
  rw [mem_finiteStateAutomorphisms_iff_finite_sections, isTreeAutomorphism_iff_isTreeAut,
    IsFiniteStateAut]
  exact and_congr_right fun ht => by rw [treeSection_eq_of_isTreeAut ht]

end FiniteStateIrreducibleGeneratorsKourovka16Problem86Wanted

