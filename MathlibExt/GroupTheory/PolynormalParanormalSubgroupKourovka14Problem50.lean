/-!
# Polynormal subgroups that are not paranormal

The cyclic wreath product of the alternating group on five letters by a group of order three
contains a polynormal subgroup that fails the paranormal condition. Its three factors in the
base group are a Sylow 3-subgroup, its normalizer, and the whole alternating group.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 14.50 (Z. I.
Borevich; A. S. Kondratiev). UnsolvedMath record UM-00701035 (`KOU-14.50`), dataset
ulamai/UnsolvedMath v1.8.0.

`A^x = x⁻¹ A x` and `A^⟨x⟩ = ⟨A^(xⁿ) | n ∈ ℤ⟩`. Both conditions quantify over all `x` and take `u`
from a subgroup, so they do not depend on the conjugation convention.
-/

@[expose] public section

namespace MathlibExt.GroupTheory.PolynormalParanormalSubgroupKourovka14Problem50Wanted

variable {G : Type*} [Group G]

/-- **Conjugate subgroup.** For a subgroup $A$ of a group $G$ and an element $x \in G$, the
conjugate subgroup is $A^x = x^{-1} A x = \{x^{-1} a x : a \in A\}$. -/
def conjSubgroup (A : Subgroup G) (x : G) : Subgroup G :=
  A.map (MulAut.conj x⁻¹).toMonoidHom

/-- **Paranormal subgroup.** A subgroup $A$ of a group $G$ is paranormal (Z. I. Borevich) when,
for every $x \in G$, the conjugate $A^x = x^{-1} A x$ is contained in the subgroup generated by
the conjugates $A^u$ with $u$ in the subgroup $\langle A, A^x \rangle$ generated by $A$ and
$A^x$. -/
def IsParanormal (A : Subgroup G) : Prop :=
  ∀ x : G, conjSubgroup A x ≤ ⨆ u ∈ A ⊔ conjSubgroup A x, conjSubgroup A u

/-- **Polynormal subgroup.** A subgroup $A$ of a group $G$ is polynormal (Z. I. Borevich) when,
for every $x \in G$, the conjugate $A^x = x^{-1} A x$ is contained in the subgroup generated by
the conjugates $A^u$ with $u \in A^{\langle x \rangle}$, where $A^{\langle x \rangle}$ is the
subgroup generated by the conjugates $A^{x^n}$ with $n \in \mathbb{Z}$. -/
def IsPolynormal (A : Subgroup G) : Prop :=
  ∀ x : G, conjSubgroup A x ≤ ⨆ u ∈ (⨆ n : ℤ, conjSubgroup A (x ^ n)), conjSubgroup A u

/-- Kourovka 14.50 (Z. I. Borevich; A. S. Kondratiev): every polynormal subgroup of a finite group
is paranormal. -/
def polynormalImpliesParanormal : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), IsPolynormal A → IsParanormal A

private theorem mem_conj_iff (A : Subgroup G) (x y : G) :
    y ∈ conjSubgroup A x ↔ x * y * x⁻¹ ∈ A := by
  rw [conjSubgroup, Subgroup.mem_map_equiv]
  simp [MulAut.conj_apply]

private theorem conj_one (A : Subgroup G) : conjSubgroup A 1 = A := by
  ext y
  simp [mem_conj_iff]

private theorem conj_top (x : G) : conjSubgroup ⊤ x = ⊤ := by
  ext y
  simp [mem_conj_iff]

private abbrev conjugateJoin (A B : Subgroup G) : Subgroup G :=
  ⨆ u ∈ B, conjSubgroup A u

private theorem conjugateJoin_mono (A : Subgroup G) {B C : Subgroup G} (h : B ≤ C) :
    conjugateJoin A B ≤ conjugateJoin A C :=
  iSup₂_le fun u hu => le_iSup₂_of_le u (h hu) le_rfl

private theorem conjugateJoin_top [IsSimpleGroup G] {A : Subgroup G} (hA : A ≠ ⊥) :
    conjugateJoin A ⊤ = ⊤ := by
  have h : Subgroup.normalClosure (A : Set G) = ⊤ :=
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal _).resolve_left fun he =>
      hA (le_bot_iff.mp (Subgroup.le_normalClosure.trans_eq he))
  apply top_le_iff.mp
  refine h.ge.trans ?_
  apply (Subgroup.closure_le _).mpr
  intro y hy
  obtain ⟨a, ha, hc⟩ := Group.mem_conjugatesOfSet_iff.mp hy
  obtain ⟨c, rfl⟩ := isConj_iff.mp hc
  apply (le_iSup₂ (f := fun (u : G) (_ : u ∈ (⊤ : Subgroup G)) => conjSubgroup A u) c⁻¹ trivial)
  exact (mem_conj_iff ..).mpr (by simpa [mul_assoc] using ha)

-- Sylow conjugacy inside the subgroup generated by two conjugates supplies a conjugator
-- there for both the Sylow subgroups and their normalizers.
private theorem sylow_conjugator {p : ℕ} [Fact p.Prime] [Finite G]
    (P : Sylow p G) (x : G) :
    ∃ u ∈ (P : Subgroup G) ⊔ conjSubgroup P x, conjSubgroup P u = conjSubgroup P x := by
  let Q := x⁻¹ • P
  let J := (P : Subgroup G) ⊔ Q.toSubgroup
  obtain ⟨v, hv⟩ := MulAction.exists_smul_eq J (P.subtype (N := J) le_sup_left)
    (Q.subtype (N := J) le_sup_right)
  rw [Sylow.smul_subtype] at hv
  have h := congrArg Sylow.toSubgroup (Sylow.subtype_injective hv)
  refine ⟨(v : G)⁻¹, J.inv_mem v.property, ?_⟩
  rw [conjSubgroup, inv_inv]
  exact h

private theorem sylow_paranormal {p : ℕ} [Fact p.Prime] [Finite G] (P : Sylow p G) :
    IsParanormal (P : Subgroup G) ∧ IsParanormal (Subgroup.normalizer (P : Set G)) := by
  have hnorm (x : G) : conjSubgroup (Subgroup.normalizer (P : Set G)) x =
      Subgroup.normalizer (conjSubgroup P x : Set G) := Subgroup.map_equiv_normalizer_eq _ _
  constructor <;> intro x <;> obtain ⟨u, hu, he⟩ := sylow_conjugator P x
  · exact le_iSup₂_of_le u hu he.ge
  · have h := sup_le_sup (Subgroup.le_normalizer (H := P.toSubgroup))
        (Subgroup.map_mono (Subgroup.le_normalizer (H := P.toSubgroup))
          (f := (MulAut.conj x⁻¹).toMonoidHom))
    exact le_iSup₂_of_le u (h hu) (by rw [hnorm, hnorm, he])

private abbrev Cycle := Multiplicative (Fin 3)

private def baseHom : (Cycle → G) →* G ≀ᵣ Cycle where
  toFun f := ⟨f, 1⟩
  map_one' := rfl
  map_mul' f g := by ext <;> simp

private def baseProduct (H : Cycle → Subgroup G) : Subgroup (G ≀ᵣ Cycle) :=
  (Subgroup.pi Set.univ H).map baseHom

private theorem mem_baseProduct (H : Cycle → Subgroup G) (z : G ≀ᵣ Cycle) :
    z ∈ baseProduct H ↔ z.right = 1 ∧ ∀ i, z.left i ∈ H i := by
  constructor
  · rintro ⟨f, hf, rfl⟩
    exact ⟨rfl, fun i => hf i trivial⟩
  · rintro ⟨hr, hf⟩
    exact ⟨z.left, fun i _ => hf i, RegularWreathProduct.ext rfl hr.symm⟩

private theorem single_mem {H : Cycle → Subgroup G} (i : Cycle) {g : G} (hg : g ∈ H i) :
    baseHom (Pi.mulSingle i g) ∈ baseProduct H := by
  refine (mem_baseProduct ..).mpr ⟨rfl, fun j => ?_⟩
  change Pi.mulSingle (M := fun _ => G) i g j ∈ H j
  by_cases h : j = i
  · simpa [h] using hg
  · simp [h]

private theorem baseProduct_le_baseProduct {H K : Cycle → Subgroup G} :
    baseProduct H ≤ baseProduct K ↔ ∀ i, H i ≤ K i := by
  constructor
  · intro h i g hg
    simpa [baseHom] using ((mem_baseProduct ..).mp (h (single_mem i hg))).2 i
  · intro h z hz
    obtain ⟨hr, hf⟩ := (mem_baseProduct ..).mp hz
    exact (mem_baseProduct ..).mpr ⟨hr, fun i => h i (hf i)⟩

private theorem baseProduct_iSup {ι : Sort*} (H : ι → Cycle → Subgroup G) :
    baseProduct (fun i => ⨆ t, H t i) = ⨆ t, baseProduct (H t) := by
  apply le_antisymm _ (iSup_le fun t => baseProduct_le_baseProduct.mpr fun i => le_iSup (H · i) t)
  rw [baseProduct, Subgroup.map_le_iff_le_comap, Subgroup.pi_le_iff]
  intro i
  rw [Subgroup.map_iSup]
  refine iSup_le fun t => ?_
  rw [Subgroup.map_le_iff_le_comap]
  intro g hg
  exact (le_iSup (fun t => baseProduct (H t)) t) (single_mem i hg)

private theorem conj_baseProduct (H : Cycle → Subgroup G) (x : G ≀ᵣ Cycle) :
    conjSubgroup (baseProduct H) x =
      baseProduct (fun i => conjSubgroup (H (x.right * i)) (x.left (x.right * i))) := by
  ext z
  simp only [mem_conj_iff, mem_baseProduct, RegularWreathProduct.mul_right,
    RegularWreathProduct.inv_right, mul_inv_eq_one, mul_eq_left]
  refine and_congr_right fun hr => ?_
  simp only [RegularWreathProduct.mul_left, Pi.mul_apply, RegularWreathProduct.inv_left,
    Pi.inv_apply, RegularWreathProduct.mul_right, hr, mul_one, mul_inv_cancel_left]
  constructor
  · intro h i
    simpa using h (x.right * i)
  · intro h i
    simpa using h (x.right⁻¹ * i)

-- Within the base subgroup conjugation acts independently in each coordinate.
private theorem conjugateJoin_baseProduct (H K : Cycle → Subgroup G) :
    conjugateJoin (baseProduct H) (baseProduct K) =
      baseProduct (fun i => conjugateJoin (H i) (K i)) := by
  unfold conjugateJoin
  rw [iSup_subtype']
  simp_rw [conj_baseProduct]
  rw [← baseProduct_iSup]
  congr 1
  funext i
  apply le_antisymm
  · refine iSup_le fun u => ?_
    obtain ⟨hr, hf⟩ := (mem_baseProduct ..).mp u.property
    simp only [hr, one_mul]
    exact le_iSup₂_of_le _ (hf i) le_rfl
  · refine iSup₂_le fun g hg => ?_
    let u : baseProduct K := ⟨baseHom (Pi.mulSingle i g), single_mem i hg⟩
    apply le_iSup_of_le u
    simp [u, baseHom]

private def factors (P : Subgroup G) (i : Cycle) : Subgroup G :=
  if i = 1 then P else if i = Multiplicative.ofAdd 1 then Subgroup.normalizer P else ⊤

private theorem factors_paranormal {p : ℕ} [Fact p.Prime] [Finite G]
    (P : Sylow p G) (i : Cycle) : IsParanormal (factors P.toSubgroup i) := by
  unfold factors
  split
  · exact (sylow_paranormal P).1
  split
  · exact (sylow_paranormal P).2
  · intro x
    exact le_iSup₂_of_le x (by simp) le_rfl

private theorem factors_ne_bot {P : Subgroup G} (hP : P ≠ ⊥) (i : Cycle) :
    factors P i ≠ ⊥ := by
  have h : P ≤ factors P i := by
    unfold factors
    split
    · exact le_rfl
    split
    · exact Subgroup.le_normalizer
    · exact le_top
  exact fun he => hP (le_bot_iff.mp (h.trans_eq he))

private theorem rotation_reaches :
    ∀ r i : Cycle, r ≠ 1 → ∃ n : Fin 3, r ^ n.val * i = Multiplicative.ofAdd 2 := by
  decide

private theorem polynormal_baseProduct [IsSimpleGroup G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) (hP : (P : Subgroup G) ≠ ⊥) :
    IsPolynormal (baseProduct (factors P.toSubgroup)) := by
  intro x
  let H := factors (P : Subgroup G)
  change conjSubgroup (baseProduct H) x ≤
    conjugateJoin (baseProduct H) (⨆ n : ℤ, conjSubgroup (baseProduct H) (x ^ n))
  simp_rw [conj_baseProduct]
  rw [← baseProduct_iSup, conjugateJoin_baseProduct, baseProduct_le_baseProduct]
  intro i
  -- Base elements preserve coordinates. The powers zero and one give the two conjugates
  -- needed to apply paranormality in each factor.
  by_cases hr : x.right = 1
  · simp only [hr, one_mul]
    apply (factors_paranormal P i (x.left i)).trans
    apply conjugateJoin_mono
    apply sup_le
    · apply le_iSup_of_le (0 : ℤ)
      simp [H, conj_one]
    · apply le_iSup_of_le (1 : ℤ)
      simp [H, hr]
  · -- A nonidentity rotation brings the full factor to each coordinate.
    obtain ⟨n, hn⟩ := rotation_reaches x.right i hr
    have hpos : (x ^ (n.val : ℤ)).right * i = Multiplicative.ofAdd 2 := by
      rw [zpow_natCast]
      change RegularWreathProduct.rightHom (x ^ n.val) * i = _
      rwa [map_pow]
    have htop : H (Multiplicative.ofAdd 2) = ⊤ := rfl
    apply le_trans le_top
    rw [← conjugateJoin_top (factors_ne_bot hP i)]
    apply conjugateJoin_mono
    apply le_iSup_of_le (n.val : ℤ)
    rw [hpos, htop, conj_top]

private theorem not_paranormal_baseProduct (P : Subgroup G) (hP : Subgroup.normalizer P ≠ P) :
    ¬ IsParanormal (baseProduct (factors P)) := by
  let H := factors P
  let r : Cycle := Multiplicative.ofAdd 1
  let x : G ≀ᵣ Cycle := RegularWreathProduct.inl r
  have hconj : conjSubgroup (baseProduct H) x = baseProduct (fun i => H (r * i)) := by
    simp [conj_baseProduct, x, conj_one]
  intro h
  have hi := h x
  change conjSubgroup (baseProduct H) x ≤
    conjugateJoin (baseProduct H) (baseProduct H ⊔ conjSubgroup (baseProduct H) x) at hi
  rw [hconj] at hi
  have hle : baseProduct H ⊔ baseProduct (fun i => H (r * i)) ≤
      baseProduct (fun i => H i ⊔ H (r * i)) :=
    sup_le (baseProduct_le_baseProduct.mpr fun _ => le_sup_left)
      (baseProduct_le_baseProduct.mpr fun _ => le_sup_right)
  have hres := hi.trans (conjugateJoin_mono _ hle)
  rw [conjugateJoin_baseProduct, baseProduct_le_baseProduct] at hres
  -- In the first coordinate the rotation sends the normalizer to the position of P.
  -- Conjugation inside that normalizer fixes P.
  have hfirst := hres 1
  rw [mul_one] at hfirst
  change Subgroup.normalizer P ≤ conjugateJoin P (P ⊔ Subgroup.normalizer P) at hfirst
  rw [sup_eq_right.mpr Subgroup.le_normalizer] at hfirst
  apply hP (le_antisymm (hfirst.trans ?_) Subgroup.le_normalizer)
  refine iSup₂_le fun u hu => ?_
  have hu_inv := (Subgroup.normalizer (P : Set G)).inv_mem hu
  exact (Subgroup.mem_normalizer_iff_map_conj_eq.mp hu_inv).le

/--
**A polynormal subgroup that is not paranormal (Kourovka 14.50 refuted).** There is a finite
group $G$ with a subgroup $A$ that is polynormal but not paranormal. So the conjecture of
Kourovka Problem 14.50 is false.

Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 14.50 (Z. I.
Borevich; A. S. Kondratiev); resolution: V. I. Mysovskikh, Dokl. Math. 60 (1999), 71-72,
Kourovka Archive, Problem 14.50 (answer: Not always).
-/
public theorem polynormalImpliesParanormal_refuted : ¬ polynormalImpliesParanormal := by
  let K := alternatingGroup (Fin 5)
  have : IsSimpleGroup K := alternatingGroup.isSimpleGroup (by simp)
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  let P : Sylow 3 K := Classical.arbitrary _
  have hcard : Nat.card K = 60 := by
    change Nat.card (alternatingGroup (Fin 5)) = 60
    rw [nat_card_alternatingGroup, Nat.card_fin]
    decide
  have hP : Nat.card P = 3 := by
    rw [P.card_eq_multiplicity, hcard, show 60 = 3 * 20 by decide,
      Nat.factorization_mul (by decide) (by decide), Finsupp.add_apply,
      Nat.prime_three.factorization_self, Nat.factorization_eq_zero_of_not_dvd (by decide)]
    decide
  -- A self-normalizing Sylow subgroup would give 20 Sylow subgroups, contrary to
  -- the congruence modulo three.
  have hnorm : Subgroup.normalizer (P : Set K) ≠ P.toSubgroup := by
    intro he
    have hindex := P.toSubgroup.card_mul_index
    rw [hP, hcard] at hindex
    have hcount := card_sylow_modEq_one 3 K
    rw [P.card_eq_index_normalizer, he] at hcount
    change P.toSubgroup.index % 3 = 1 at hcount
    omega
  intro hall
  exact not_paranormal_baseProduct P.toSubgroup hnorm
    (hall (K ≀ᵣ Cycle) _ (polynormal_baseProduct P (P.ne_bot_of_dvd_card (by rw [hcard]; decide))))

end MathlibExt.GroupTheory.PolynormalParanormalSubgroupKourovka14Problem50Wanted
