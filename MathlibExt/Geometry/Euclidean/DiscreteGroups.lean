/-!
# Discrete subgroups of the Euclidean plane

A **plane isometry group** is a subgroup of the group `M₂` of orientation-preserving
or reversing affine isometries of the Euclidean plane `E2 = EuclideanSpace ℝ (Fin 2)`.
Every such group has a **translation lattice**: the set of vectors `v` for which
translation by `v` belongs to the group. The **point group** of the group is the
set of linear parts of its elements.

The source separation criterion `IsDiscrete` uses a uniform translation-length
bound and an operator-norm gap for nontrivial linear parts, as in the v1
representation. It gives `DiscreteTopology` to `translationLatticeSubgroup`,
whose carrier is exactly the original set `translationLattice`.

This file proves the following facts about this setup:

* `point_group_preserves_lattice`: the point group preserves the translation
  lattice, by conjugation of translations.
* `discrete_subgroup_R2_classification`: every discrete additive subgroup of the
  plane is trivial, cyclic (generated by one nonzero vector), or a rank-two
  lattice (generated by two `ℝ`-linearly independent vectors).
* `translation_lattice_classification`: the translation lattice of a group
  satisfying the source separation criterion has one of these three shapes.

Source: `v1/Atlas/AlgebraNotes/code/DiscreteGroups.lean` (targets
`DiscreteGroups.IsDiscrete`, `DiscreteGroups.point_group_preserves_lattice` and
`DiscreteGroups.discrete_subgroup_R2_classification` in
`v1/Atlas/AlgebraNotes/targets.yaml` / `report.json`).
-/

@[expose] public section

namespace DiscreteGroups

/-- **The Euclidean plane for discrete isometry groups.** $E_2$ is the Euclidean plane:
the real vector space $\mathbb{R}^2$ of pairs of real numbers with the standard Euclidean inner
product and norm. -/
abbrev E2 := EuclideanSpace ℝ (Fin 2)

/-- **Isometry group of the Euclidean plane.** $M_2$ is the group, under composition, of affine
isometries of the Euclidean plane onto itself. -/
abbrev M₂ := E2 ≃ᵃⁱ[ℝ] E2

/-- **Linear part of a plane isometry.** The linear part of an affine isometry $f$ of the
Euclidean plane is the linear isometry $A$ of the plane such that $f(x + v) = f(x) + A v$ for
every point $x$ and every vector $v$. -/
noncomputable def linearPart (f : M₂) : E2 ≃ₗᵢ[ℝ] E2 := f.linearIsometryEquiv

/-- **Point group of a group of plane isometries.** The point group of a group $G$ of affine
isometries of the Euclidean plane is the set of linear parts of the elements of $G$. -/
noncomputable def pointGroupSet (G : Subgroup M₂) : Set (E2 ≃ₗᵢ[ℝ] E2) :=
  {A | ∃ f ∈ G, linearPart f = A}

/-- **Translation lattice.** The translation lattice of a subgroup $G$ of the group $M_2$ of
affine isometries of the Euclidean plane $E_2$ is the set of vectors $v \in E_2$ such that the
translation $x \mapsto v + x$ belongs to $G$. -/
noncomputable def translationLattice (G : Subgroup M₂) : Set E2 :=
  {v : E2 | (AffineIsometryEquiv.constVAdd ℝ E2 v : M₂) ∈ G}

/-- **Translation homomorphism.** The group homomorphism from the additive group of the Euclidean
plane $\mathbb{R}^2$ (written multiplicatively) to the group of affine isometries of the plane that
sends a vector $v$ to translation by $v$, the isometry $x \mapsto v + x$. -/
noncomputable def translationHom : Multiplicative E2 →* M₂ where
  toFun v := AffineIsometryEquiv.constVAdd ℝ E2 (Multiplicative.toAdd v)
  map_one' := by
    apply AffineIsometryEquiv.ext
    intro x
    change (0 : E2) + x = x
    exact zero_add x
  map_mul' v w := by
    apply AffineIsometryEquiv.ext
    intro x
    change (Multiplicative.toAdd v + Multiplicative.toAdd w) + x =
      Multiplicative.toAdd v + (Multiplicative.toAdd w + x)
    exact add_assoc _ _ _

/-- **Translation lattice as an additive subgroup.** For a group $G$ of affine isometries of the
Euclidean plane $\mathbb{R}^2$, the additive subgroup of $\mathbb{R}^2$ consisting of the vectors
$v$ such that translation by $v$ belongs to $G$; it is the preimage of $G$ under the translation
homomorphism $v \mapsto (x \mapsto v + x)$. -/
noncomputable def translationLatticeSubgroup (G : Subgroup M₂) : AddSubgroup E2 :=
  Subgroup.toAddSubgroup' (G.comap translationHom)

/-- **Membership in the translation lattice subgroup.** For every group $G$ of affine isometries
of the Euclidean plane and every vector $v$ of the plane, $v$ belongs to the translation lattice
subgroup of $G$ if and only if $v$ belongs to the translation lattice of $G$. -/
@[simp] theorem mem_translationLatticeSubgroup (G : Subgroup M₂) (v : E2) :
    v ∈ translationLatticeSubgroup G ↔ v ∈ translationLattice G := Iff.rfl

/-- **Carrier of the translation lattice subgroup.** For every group $G$ of affine isometries of
the Euclidean plane, the underlying set of the translation lattice subgroup of $G$ is the
translation lattice of $G$. -/
@[simp] theorem coe_translationLatticeSubgroup (G : Subgroup M₂) :
    (translationLatticeSubgroup G : Set E2) = translationLattice G := rfl

/-- **Translations are determined by their vectors.** For vectors $v$ and $w$ of the Euclidean
plane $\mathbb{R}^2$, if translation by $v$ and translation by $w$ are the same affine isometry,
then $v = w$. Equivalently, the translation homomorphism $v \mapsto (x \mapsto v + x)$ from the
additive group of the plane to the group of affine isometries of the plane is injective. -/
theorem translationHom_injective : Function.Injective translationHom := by
  intro v w h
  have h0 := congrArg (fun f : M₂ => f 0) h
  change Multiplicative.toAdd v + 0 = Multiplicative.toAdd w + 0 at h0
  simpa using h0

/-- **Separation criterion for groups of plane isometries.** A group $G$ of affine isometries of
the Euclidean plane satisfies the separation criterion if there is $\varepsilon > 0$ such that
every element $f \ne \mathrm{id}$ of $G$ whose linear part is the identity satisfies
$\|f(0)\| \ge \varepsilon$, and every element $f$ of $G$ whose linear part $A$ is not the
identity satisfies $\|A - I\| \ge \varepsilon$, where $I$ is the identity map and the norm is
the operator norm.

Its linear-part condition measures operator-norm separation from the identity, rather than the
numerical rotation angle. -/
def IsDiscrete (G : Subgroup M₂) : Prop :=
  ∃ ε > 0,
    (∀ f ∈ G, linearPart f = LinearIsometryEquiv.refl ℝ E2 → f ≠ 1 → ε ≤ ‖f 0‖) ∧
    (∀ f ∈ G, linearPart f ≠ LinearIsometryEquiv.refl ℝ E2 →
      ε ≤ ‖(linearPart f).toLinearIsometry.toContinuousLinearMap -
        ContinuousLinearMap.id ℝ E2‖)

/-- **The translation lattice of a discrete isometry group is discrete.** Let $G$ be a group of
affine isometries of the Euclidean plane $\mathbb{R}^2$, and suppose there is $\varepsilon > 0$
such that every non-identity translation in $G$ moves the origin by at least $\varepsilon$, and
every element of $G$ whose linear part $A$ is not the identity satisfies
$\|A - I\| \ge \varepsilon$ in operator norm. Then the translation lattice of $G$, the additive
subgroup of vectors $v$ such that translation by $v$ lies in $G$, is discrete in the subspace
topology of $\mathbb{R}^2$. -/
theorem translationLatticeSubgroup_discreteTopology (G : Subgroup M₂) (hG : IsDiscrete G) :
    DiscreteTopology (translationLatticeSubgroup G) := by
  obtain ⟨ε, hε, htrans, _⟩ := hG
  apply discreteTopology_of_isOpen_singleton_zero
  have hball : Metric.ball (0 : translationLatticeSubgroup G) ε =
      ({0} : Set (translationLatticeSubgroup G)) := by
    ext x
    simp only [Metric.mem_ball, dist_zero_right, Set.mem_singleton_iff]
    constructor
    · intro hx
      apply Subtype.ext
      by_contra hx0
      have hg : AffineIsometryEquiv.constVAdd ℝ E2 (x : E2) ∈ G := x.property
      have hne : AffineIsometryEquiv.constVAdd ℝ E2 (x : E2) ≠ 1 := by
        intro h
        have h0 := congrArg (fun f : M₂ => f 0) h
        apply hx0
        simpa using h0
      have hpure : linearPart (AffineIsometryEquiv.constVAdd ℝ E2 (x : E2)) =
          LinearIsometryEquiv.refl ℝ E2 := by ext v; rfl
      have hbound := htrans _ hg hpure hne
      have hbound' : ε ≤ ‖(x : E2)‖ := by simpa using hbound
      exact (not_lt_of_ge hbound') hx
    · rintro rfl
      simpa using hε
  rw [← hball]
  exact Metric.isOpen_ball

/-- **Conjugating a translation by a plane isometry.** Let $g$ be an affine isometry of the
Euclidean plane with linear part $A$, let $v$ be a vector, and write $\tau_w$ for translation by
a vector $w$. Then $g \circ \tau_v \circ g^{-1} = \tau_{A v}$. -/
lemma conj_translation (g : M₂) (v : E2) :
    g * (AffineIsometryEquiv.constVAdd ℝ E2 v) * g⁻¹ =
    AffineIsometryEquiv.constVAdd ℝ E2 (g.linearIsometryEquiv v) := by
  apply AffineIsometryEquiv.ext
  intro x
  change (g⁻¹).trans ((AffineIsometryEquiv.constVAdd ℝ E2 v).trans g) x = _
  simp only [AffineIsometryEquiv.coe_trans, Function.comp_apply]
  change g (v +ᵥ (g⁻¹ x)) = (g.linearIsometryEquiv v) +ᵥ x
  rw [g.map_vadd]
  simp [AffineIsometryEquiv.apply_symm_apply]

/-- **The point group preserves the translation lattice.** Let $G$ be a group of affine
isometries of the Euclidean plane. If $A$ belongs to the point group of $G$, that is, $A$ is the
linear part of some element of $G$, and $v$ belongs to the translation lattice of $G$, then $A v$
belongs to the translation lattice of $G$. -/
theorem point_group_preserves_lattice (G : Subgroup M₂)
    (A : E2 ≃ₗᵢ[ℝ] E2) (hA : A ∈ pointGroupSet G)
    (v : E2) (hv : v ∈ translationLattice G) :
    A v ∈ translationLattice G := by
  obtain ⟨g, hg, hgA⟩ := hA
  show (AffineIsometryEquiv.constVAdd ℝ E2 (A v) : M₂) ∈ G
  have hAv : g.linearIsometryEquiv v = A v := by
    simp only [← hgA, linearPart]
  rw [← hAv, ← conj_translation g v]
  exact G.mul_mem (G.mul_mem hg hv) (G.inv_mem hg)

-- The `haveI` steps below introduce instances (discreteness, freeness,
-- finiteness of the associated `ℤ`-submodule) that typeclass search must see;
-- the style linter flags them only because the goal is a proposition.
set_option maxHeartbeats 400000 in
set_option linter.style.haveILetI false in
/-- **Classification of discrete additive subgroups of the plane.** Every
discrete additive subgroup `G` of `ℝ²` is trivial, cyclic (generated by a
single nonzero vector), or a rank-two lattice (generated by two
`ℝ`-linearly independent vectors). -/
theorem discrete_subgroup_R2_classification
    (G : AddSubgroup E2) [DiscreteTopology G] :
    G = ⊥ ∨
    (∃ α : E2, α ≠ 0 ∧ G = AddSubgroup.zmultiples α) ∨
    (∃ a b : E2, LinearIndependent ℝ ![a, b] ∧
      G = AddSubgroup.zmultiples a ⊔ AddSubgroup.zmultiples b) := by
  set L := G.toIntSubmodule
  haveI hdt : DiscreteTopology L := ‹DiscreteTopology G›
  haveI hfree : Module.Free ℤ L := instModuleFree_of_discrete_submodule L
  haveI hfin : Module.Finite ℤ L := instModuleFinite_of_discrete_submodule L

  set_option backward.isDefEq.respectTransparency false in
  have hrank : Module.finrank ℤ L ≤ 2 := by
    have hkey : Set.finrank ℝ (L : Set E2) = Set.finrank ℤ (L : Set E2) :=
      Real.finrank_eq_int_finrank_of_discrete (by rwa [Submodule.span_eq])
    have h1 : Set.finrank ℤ (L : Set E2) = Module.finrank ℤ L := by
      unfold Set.finrank; rw [Submodule.span_eq]
    have h2 : Set.finrank ℝ (L : Set E2) ≤ 2 := by
      unfold Set.finrank
      calc Module.finrank ℝ (Submodule.span ℝ (L : Set _))
          ≤ Module.finrank ℝ E2 := Submodule.finrank_le _
        _ = 2 := by simp [Fintype.card_fin]
    linarith

  have h1case : Module.finrank ℤ L = 1 →
      ∃ α : E2, α ≠ 0 ∧ G = AddSubgroup.zmultiples α := by
    intro h1
    have hcard : Fintype.card (Module.Free.ChooseBasisIndex ℤ L) = 1 := by
      rw [← Module.finrank_eq_card_chooseBasisIndex]; exact h1
    obtain ⟨g, hg⟩ := Fintype.card_eq_one_iff.mp hcard
    set b := Module.Free.chooseBasis ℤ L
    set α : E2 := (b g).val
    refine ⟨α, ?_, ?_⟩
    · intro heq; exact b.ne_zero g (Subtype.val_injective heq)
    · ext x; constructor
      · intro hx
        have huniv : (Finset.univ : Finset (Module.Free.ChooseBasisIndex ℤ L)) = {g} := by
          ext i; simp [hg i]
        have heq := b.sum_equivFun ⟨x, hx⟩
        rw [huniv, Finset.sum_singleton] at heq
        rw [AddSubgroup.mem_zmultiples_iff]
        exact ⟨b.equivFun ⟨x, hx⟩ g, by
          have := congr_arg Subtype.val heq
          simp only [Submodule.coe_smul] at this; exact this⟩
      · intro hx
        rw [AddSubgroup.mem_zmultiples_iff] at hx
        obtain ⟨n, rfl⟩ := hx
        exact G.zsmul_mem (b g).2 n

  have h2case : Module.finrank ℤ L = 2 →
      ∃ a b : E2, LinearIndependent ℝ ![a, b] ∧
        G = AddSubgroup.zmultiples a ⊔ AddSubgroup.zmultiples b := by
    intro h2
    have hcard : Fintype.card (Module.Free.ChooseBasisIndex ℤ L) = 2 := by
      rw [← Module.finrank_eq_card_chooseBasisIndex]; exact h2
    set B : Module.Basis (Fin 2) ℤ L :=
      (Module.Free.chooseBasis ℤ L).reindex
        (Fintype.equivOfCardEq (by rw [hcard, Fintype.card_fin]))

    refine ⟨(B 0).val, (B 1).val, ?_, ?_⟩
    ·
      apply linearIndependent_of_top_le_span_of_card_eq_finrank
      ·
        set S := Submodule.span ℝ (Set.range ![(B 0).val, (B 1).val])
        set_option backward.isDefEq.respectTransparency false in
        have hspan_top : Submodule.span ℝ (L : Set E2) = ⊤ := by
          apply Submodule.eq_top_of_finrank_eq
          have hk : Set.finrank ℝ (L : Set E2) = Set.finrank ℤ (L : Set E2) :=
            Real.finrank_eq_int_finrank_of_discrete (by rwa [Submodule.span_eq])
          unfold Set.finrank at hk
          rw [Submodule.span_eq] at hk
          linarith [show Module.finrank ℝ E2 = 2 from by simp [Fintype.card_fin]]
        suffices hsub : (L : Set E2) ⊆ (S : Set E2) by
          rw [← hspan_top]; exact Submodule.span_le.mpr hsub
        intro y hy
        have hcoeffs := B.sum_equivFun ⟨y, hy⟩
        have hval := congr_arg Subtype.val hcoeffs
        simp only [Submodule.coe_sum, Submodule.coe_smul] at hval
        rw [show (Finset.univ : Finset (Fin 2)) = {0, 1} from by decide] at hval
        simp only [Finset.sum_pair (by decide : (0 : Fin 2) ≠ 1)] at hval
        rw [← hval]
        have hv0 : (B 0).val ∈ S := Submodule.subset_span (Set.mem_range.mpr ⟨0, rfl⟩)
        have hv1 : (B 1).val ∈ S := Submodule.subset_span (Set.mem_range.mpr ⟨1, rfl⟩)
        have h0 : B.equivFun ⟨y, hy⟩ 0 • (B 0).val ∈ S := by
          rw [show B.equivFun ⟨y, hy⟩ 0 • (B 0).val =
              (B.equivFun ⟨y, hy⟩ 0 : ℝ) • (B 0).val from
            (Int.cast_smul_eq_zsmul ℝ _ _).symm]
          exact S.smul_mem _ hv0
        have h1 : B.equivFun ⟨y, hy⟩ 1 • (B 1).val ∈ S := by
          rw [show B.equivFun ⟨y, hy⟩ 1 • (B 1).val =
              (B.equivFun ⟨y, hy⟩ 1 : ℝ) • (B 1).val from
            (Int.cast_smul_eq_zsmul ℝ _ _).symm]
          exact S.smul_mem _ hv1
        exact S.add_mem h0 h1
      · simp [Fintype.card_fin]
    ·
      ext x
      simp only [AddSubgroup.mem_sup, AddSubgroup.mem_zmultiples_iff]
      constructor
      · intro hx
        have heq := B.sum_equivFun ⟨x, hx⟩
        rw [show (Finset.univ : Finset (Fin 2)) = {0, 1} from by decide] at heq
        simp only [Finset.sum_pair (by decide : (0 : Fin 2) ≠ 1)] at heq
        have hval := congr_arg Subtype.val heq
        simp only [Submodule.coe_add, Submodule.coe_smul] at hval
        exact ⟨_, ⟨B.equivFun ⟨x, hx⟩ 0, rfl⟩, _, ⟨B.equivFun ⟨x, hx⟩ 1, rfl⟩, hval⟩
      · intro ⟨_, ⟨na, rfl⟩, _, ⟨nb, rfl⟩, hsum⟩
        rw [← hsum]
        exact G.add_mem (G.zsmul_mem (B 0).2 na) (G.zsmul_mem (B 1).2 nb)

  rcases Nat.eq_or_lt_of_le hrank with h2 | h12
  · exact Or.inr (Or.inr (h2case h2))
  · rcases Nat.eq_or_lt_of_le (Nat.lt_succ_iff.mp h12) with h1 | h01
    · exact Or.inr (Or.inl (h1case h1))
    · left
      have h0 : Module.finrank ℤ L = 0 := by omega
      have hsub : Subsingleton L := (Module.finrank_eq_zero_iff_of_free ℤ L).mp h0
      ext x; simp only [AddSubgroup.mem_bot]
      exact ⟨fun hx => congr_arg Subtype.val (@Subsingleton.elim _ hsub ⟨x, hx⟩ 0),
             fun hx => by rw [hx]; exact G.zero_mem⟩

/-- **Classification of translation lattices.** Let $G$ be a group of affine isometries of the
Euclidean plane $\mathbb{R}^2$, and suppose there is $\varepsilon > 0$ such that every
non-identity translation in $G$ moves the origin by at least $\varepsilon$, and every element of
$G$ whose linear part $A$ is not the identity satisfies $\|A - I\| \ge \varepsilon$ in operator
norm. Let $L$ be the translation lattice of $G$, the additive subgroup of vectors $v$ such that
translation by $v$ lies in $G$. Then either $L = \{0\}$, or $L = \mathbb{Z}\alpha$ for some nonzero
vector $\alpha$, or $L = \mathbb{Z}a + \mathbb{Z}b$ for some $\mathbb{R}$-linearly independent
vectors $a$ and $b$. -/
theorem translation_lattice_classification (G : Subgroup M₂) (hG : IsDiscrete G) :
    translationLatticeSubgroup G = ⊥ ∨
    (∃ α : E2, α ≠ 0 ∧ translationLatticeSubgroup G = AddSubgroup.zmultiples α) ∨
    (∃ a b : E2, LinearIndependent ℝ ![a, b] ∧
      translationLatticeSubgroup G = AddSubgroup.zmultiples a ⊔ AddSubgroup.zmultiples b) :=
  @discrete_subgroup_R2_classification (translationLatticeSubgroup G)
    (translationLatticeSubgroup_discreteTopology G hG)

end DiscreteGroups
