/-!
# Apollonian circle packings

An Apollonian circle packing is built from four mutually tangent circles by repeatedly replacing
one circle of a Descartes configuration by the other circle tangent to the remaining three
(Lagarias, Mallows and Wilks, *Beyond the Descartes circle theorem*, Amer. Math. Monthly 109
(2002), arXiv:math/0101066v1, Section 2; H. Oh, *Apollonian circle packings: dynamics and number
theory*, Japan. J. Math. 9 (2014), arXiv:1312.1383v2, Section 1, after Theorem 1.1).

Circles are Mathlib's spheres `EuclideanGeometry.Sphere ℂ` of positive radius. Tangency is a
one-point intersection; it is related to Mathlib's `Sphere.IsExtTangentAt` and
`Sphere.IsIntTangentAt` by the uniqueness theorems below, which strengthen Mathlib's tangency API:
two spheres of positive radii that are externally (or internally, with distinct radii) tangent at
`p` meet only at `p`. The file then defines Descartes configurations, the packing generated by
swaps, its residual set and its circle-counting function.

Circles of curvature zero (lines) are not included, so the definitions describe bounded packings,
which contain no lines.
-/

@[expose] public section

namespace MathlibExt.Geometry.Euclidean.ApollonianCirclePacking

open EuclideanGeometry EuclideanGeometry.Sphere

section Tangency

variable {V P : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MetricSpace P]
  [NormedAddTorsor V P]

/-- **Externally tangent spheres meet at exactly one point.** If two spheres of positive radii
are externally tangent at `p` (Mathlib's `IsExtTangentAt`), then `p` is their only common
point. -/
theorem inter_eq_singleton_of_isExtTangentAt {s₁ s₂ : Sphere P} {p : P}
    (h : s₁.IsExtTangentAt s₂ p)
    (h₁ : 0 < s₁.radius) (h₂ : 0 < s₂.radius) : (s₁ : Set P) ∩ s₂ = {p} := by
  have hd : dist s₁.center s₂.center = s₁.radius + s₂.radius := h.isExtTangent.dist_center
  have hs : 0 < s₁.radius + s₂.radius := by linarith
  have key : ∀ q, q ∈ s₁ → q ∈ s₂ → q = AffineMap.lineMap s₁.center s₂.center
      (s₁.radius / (s₁.radius + s₂.radius)) := by
    intro q hq₁ hq₂
    apply eq_lineMap_of_dist_eq_mul_of_dist_eq_mul
    · rw [mem_sphere'.1 hq₁, hd, div_mul_cancel₀ _ hs.ne']
    · rw [mem_sphere.1 hq₂, hd]
      field_simp
      ring
  ext q
  simp only [Set.mem_inter_iff, Set.mem_singleton_iff, Sphere.mem_coe]
  constructor
  · rintro ⟨hq₁, hq₂⟩
    rw [key q hq₁ hq₂, key p h.mem_left h.mem_right]
  · rintro rfl
    exact ⟨h.mem_left, h.mem_right⟩

/-- **Internally tangent spheres meet at exactly one point.** If a sphere `s₁` of positive radius
is internally tangent at `p` to a sphere `s₂` of larger radius (Mathlib's `IsIntTangentAt`), then
`p` is their only common point. -/
theorem inter_eq_singleton_of_isIntTangentAt {s₁ s₂ : Sphere P} {p : P}
    (h : s₁.IsIntTangentAt s₂ p)
    (h₁ : 0 < s₁.radius) (h₁₂ : s₁.radius < s₂.radius) : (s₁ : Set P) ∩ s₂ = {p} := by
  have hd : dist s₁.center s₂.center = s₂.radius - s₁.radius := h.isIntTangent.dist_center
  have h₂ : 0 < s₂.radius := by linarith
  set t : ℝ := (s₂.radius - s₁.radius) / s₂.radius with ht
  have ht0 : t ≠ 0 := div_ne_zero (by linarith) h₂.ne'
  have key : ∀ q, q ∈ s₁ → q ∈ s₂ → s₁.center = AffineMap.lineMap s₂.center q t := by
    intro q hq₁ hq₂
    apply eq_lineMap_of_dist_eq_mul_of_dist_eq_mul
    · rw [mem_sphere'.1 hq₂, dist_comm, hd, ht, div_mul_cancel₀ _ h₂.ne']
    · rw [mem_sphere'.1 hq₁, mem_sphere'.1 hq₂, ht]
      field_simp
      ring
  have hvsub : ∀ q, q ∈ s₁ → q ∈ s₂ → q -ᵥ s₂.center = t⁻¹ • (s₁.center -ᵥ s₂.center) := by
    intro q hq₁ hq₂
    rw [key q hq₁ hq₂, AffineMap.lineMap_apply, vadd_vsub, smul_smul, inv_mul_cancel₀ ht0,
      one_smul]
  ext q
  simp only [Set.mem_inter_iff, Set.mem_singleton_iff, Sphere.mem_coe]
  constructor
  · rintro ⟨hq₁, hq₂⟩
    exact vsub_left_cancel ((hvsub q hq₁ hq₂).trans (hvsub p h.mem_left h.mem_right).symm)
  · rintro rfl
    exact ⟨h.mem_left, h.mem_right⟩

/-- **The external tangency point of two spheres.** If the centers of two spheres of positive
radii `r₁, r₂` are at distance `r₁ + r₂`, the spheres are externally tangent at the point of the
segment of centers at distance `r₁` from the first center. -/
theorem isExtTangentAt_lineMap {s₁ s₂ : Sphere P}
    (hd : dist s₁.center s₂.center = s₁.radius + s₂.radius) (h₁ : 0 < s₁.radius)
    (h₂ : 0 < s₂.radius) :
    s₁.IsExtTangentAt s₂
      (AffineMap.lineMap s₁.center s₂.center (s₁.radius / (s₁.radius + s₂.radius))) := by
  have hs : 0 < s₁.radius + s₂.radius := by linarith
  have hm₁ : AffineMap.lineMap s₁.center s₂.center (s₁.radius / (s₁.radius + s₂.radius)) ∈ s₁ := by
    rw [mem_sphere, dist_lineMap_left, Real.norm_eq_abs, abs_of_nonneg (by positivity), hd,
      div_mul_cancel₀ _ hs.ne']
  have hm₂ : AffineMap.lineMap s₁.center s₂.center (s₁.radius / (s₁.radius + s₂.radius)) ∈ s₂ := by
    rw [mem_sphere, dist_lineMap_right, Real.norm_eq_abs, hd,
      abs_of_nonneg (by rw [sub_nonneg, div_le_one hs]; linarith)]
    field_simp
    ring
  refine ⟨hm₁, hm₂, ?_⟩
  rw [← dist_add_dist_eq_iff, dist_comm s₁.center, mem_sphere.1 hm₁, mem_sphere.1 hm₂, hd]

/-- **The internal tangency point of two spheres.** If a sphere `s₁` of radius `r₁ > 0` has its
center at distance `r₂ - r₁` from the center of a sphere `s₂` of larger radius `r₂`, then `s₁` is
internally tangent to `s₂` at the point of the ray from the center of `s₂` through that of `s₁`
at distance `r₂` from the center of `s₂`. -/
theorem isIntTangentAt_lineMap {s₁ s₂ : Sphere P}
    (hd : dist s₁.center s₂.center = s₂.radius - s₁.radius) (h₁ : 0 < s₁.radius)
    (h₁₂ : s₁.radius < s₂.radius) :
    s₁.IsIntTangentAt s₂
      (AffineMap.lineMap s₂.center s₁.center (s₂.radius / (s₂.radius - s₁.radius))) := by
  have hs : 0 < s₂.radius - s₁.radius := by linarith
  have h₂ : 0 < s₂.radius := by linarith
  have hd' : dist s₂.center s₁.center = s₂.radius - s₁.radius := by rw [dist_comm, hd]
  have hm₁ : AffineMap.lineMap s₂.center s₁.center (s₂.radius / (s₂.radius - s₁.radius)) ∈ s₁ := by
    rw [mem_sphere, dist_lineMap_right, Real.norm_eq_abs, hd',
      abs_of_nonpos (by rw [sub_nonpos, le_div_iff₀ hs]; linarith)]
    field_simp
    ring
  have hm₂ : AffineMap.lineMap s₂.center s₁.center (s₂.radius / (s₂.radius - s₁.radius)) ∈ s₂ := by
    rw [mem_sphere, dist_lineMap_left, Real.norm_eq_abs, abs_of_nonneg (div_pos h₂ hs).le, hd',
      div_mul_cancel₀ _ hs.ne']
  refine ⟨hm₁, hm₂, ?_⟩
  rw [← dist_add_dist_eq_iff, hd', dist_comm s₁.center, mem_sphere.1 hm₁, dist_comm,
    mem_sphere.1 hm₂]
  ring

end Tangency

open Filter Topology

/-- **Circle in the plane.** A sphere of Mathlib's `EuclideanGeometry.Sphere ℂ` with positive
radius (lines, the circles of curvature zero, are not included). -/
structure PlaneCircle extends EuclideanGeometry.Sphere ℂ where
  radius_pos : 0 < radius

namespace PlaneCircle

/-- **Curvature of a plane circle.** The reciprocal `1 / radius` of its radius (H. Oh,
arXiv:1312.1383v2, Section 1). -/
noncomputable def curvature (C : PlaneCircle) : ℝ :=
  C.radius⁻¹

end PlaneCircle

/-- **Tangency of two circles at a point.** Two circles are tangent at `p` when `p` is their only
common point. -/
def TangentAt (C D : PlaneCircle) (p : ℂ) : Prop :=
  (C.toSphere : Set ℂ) ∩ D.toSphere = {p}

/-- **Tangency is symmetric.** If `C` and `D` are tangent at `p`, so are `D` and `C`. -/
theorem TangentAt.symm {C D : PlaneCircle} {p : ℂ} (h : TangentAt C D p) : TangentAt D C p := by
  rw [TangentAt, Set.inter_comm]
  exact h

/-- **Mathlib's external tangency gives tangency.** Two circles that are externally tangent at `p`
in the sense of `Sphere.IsExtTangentAt` meet only at `p`. -/
theorem tangentAt_of_isExtTangentAt {C D : PlaneCircle} {p : ℂ}
    (h : C.toSphere.IsExtTangentAt D.toSphere p) : TangentAt C D p :=
  inter_eq_singleton_of_isExtTangentAt h C.radius_pos D.radius_pos

/-- **Mathlib's internal tangency gives tangency.** A circle `D` internally tangent at `p` to a
circle `C` of larger radius, in the sense of `Sphere.IsIntTangentAt`, meets `C` only at `p`. -/
theorem tangentAt_of_isIntTangentAt {C D : PlaneCircle} {p : ℂ}
    (h : D.toSphere.IsIntTangentAt C.toSphere p) (hr : D.radius < C.radius) :
    TangentAt C D p := by
  rw [TangentAt, Set.inter_comm]
  exact inter_eq_singleton_of_isIntTangentAt h D.radius_pos hr

/-- **Externally tangent circles touch at one point.** If the centers of two circles are at
distance `r₁ + r₂`, the circles meet exactly at the point of the segment of centers at distance
`r₁` from the first center. -/
theorem tangentAt_of_dist_eq_add (C D : PlaneCircle)
    (h : dist C.center D.center = C.radius + D.radius) :
    TangentAt C D (AffineMap.lineMap C.center D.center (C.radius / (C.radius + D.radius))) :=
  tangentAt_of_isExtTangentAt (isExtTangentAt_lineMap h C.radius_pos D.radius_pos)

/-- **Internally tangent circles touch at one point.** If the second circle has the smaller
radius and the centers are at distance `r₁ - r₂`, the circles meet exactly at the point of the ray
from the first center through the second at distance `r₁` from the first center. -/
theorem tangentAt_of_dist_eq_sub (C D : PlaneCircle) (hr : D.radius < C.radius)
    (h : dist C.center D.center = C.radius - D.radius) :
    TangentAt C D (AffineMap.lineMap C.center D.center (C.radius / (C.radius - D.radius))) :=
  tangentAt_of_isIntTangentAt
    (isIntTangentAt_lineMap (by rw [dist_comm, h]) D.radius_pos hr) hr

/-- **Descartes configuration.** Four distinct circles that are pairwise tangent, such that the
three points at which a circle touches the other three are distinct (no three of the circles share
a tangent line at a common point) (Lagarias, Mallows and Wilks, arXiv:math/0101066v1,
Section 1). -/
def IsDescartesConfiguration (C : Fin 4 → PlaneCircle) : Prop :=
  Function.Injective C ∧ ∃ p : Fin 4 → Fin 4 → ℂ,
    (∀ i j, i ≠ j → TangentAt (C i) (C j) (p i j)) ∧
      ∀ i j k, i ≠ j → i ≠ k → j ≠ k → p i j ≠ p i k

/-- **Configurations reachable by Apollonian swaps.** Starting from `C₀`, replace one circle of a
reachable configuration by another circle that forms a Descartes configuration with the remaining
three, that is, by the other circle tangent to them (Lagarias, Mallows and Wilks,
arXiv:math/0101066v1, Section 2; H. Oh, arXiv:1312.1383v2, Theorem 1.1 and the construction after
it). -/
inductive IsReachable (C₀ : Fin 4 → PlaneCircle) : (Fin 4 → PlaneCircle) → Prop
  | base : IsReachable C₀ C₀
  | swap {C : Fin 4 → PlaneCircle} (i : Fin 4) (D : PlaneCircle) :
      IsReachable C₀ C → D ≠ C i → IsDescartesConfiguration (Function.update C i D) →
        IsReachable C₀ (Function.update C i D)

/-- **Apollonian circle packing.** The circles occurring in some configuration reachable from the
initial Descartes configuration `C₀` (H. Oh, arXiv:1312.1383v2, Section 1). -/
def apollonianPacking (C₀ : Fin 4 → PlaneCircle) : Set PlaneCircle :=
  {D | ∃ C, IsReachable C₀ C ∧ ∃ i, C i = D}

/-- **The initial circles belong to the packing.** Each circle of the initial configuration `C₀`
belongs to the Apollonian packing it generates. -/
theorem mem_apollonianPacking (C₀ : Fin 4 → PlaneCircle) (i : Fin 4) :
    C₀ i ∈ apollonianPacking C₀ :=
  ⟨C₀, IsReachable.base, i, rfl⟩

/-- **Residual set of an Apollonian packing.** The closure of the union of the circles of the
packing (H. Oh, arXiv:1312.1383v2, Section 1, definition of `Res(P)`). -/
noncomputable def residualSet (C₀ : Fin 4 → PlaneCircle) : Set ℂ :=
  closure (⋃ D ∈ apollonianPacking C₀, (D.toSphere : Set ℂ))

/-- **Circle-counting function.** `N_P(T)`, the number of circles of the packing whose curvature
is at most `T` (Kontorovich and Oh, *Apollonian circle packings and closed horospheres on
hyperbolic 3-manifolds*, arXiv:0811.2236v5, Definition 2.1(1)). The bounding circle of a bounded
packing is counted with its unsigned curvature; this changes `N_P(T)` by at most one. -/
noncomputable def circleCount (C₀ : Fin 4 → PlaneCircle) (T : ℝ) : ℕ :=
  {D | D ∈ apollonianPacking C₀ ∧ D.curvature ≤ T}.ncard

end MathlibExt.Geometry.Euclidean.ApollonianCirclePacking
