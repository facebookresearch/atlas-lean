module

public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.LinearAlgebra.Reflection
public import MathlibExt.Geometry.Euclidean.DescartesCircleTheorem

/-!
# Descartes quadruples and the Apollonian group

The curvatures `(a, b, c, d)` of four mutually tangent oriented circles satisfy the Descartes
relation `Q(a, b, c, d) = 0` for the Descartes quadratic form
`Q(v) = 2 (a² + b² + c² + d²) - (a + b + c + d)²` (Descartes' circle theorem, proved in
`MetaMathlibExt.descartes_circle_theorem`). The Apollonian group is generated by the four
*flips* `S₁, …, S₄`, where `Sᵢ` replaces the `i`-th entry `vᵢ` by
`2 · (sum of the other three entries) - vᵢ`, the curvature of the other circle tangent to the
remaining three.

This file proves the algebraic layer of the theory, over an arbitrary commutative ring:

* each flip is the orthogonal reflection of `(R⁴, Q)` in the hyperplane `Q`-orthogonal to the
  standard basis vector `eᵢ` (which has `Q(eᵢ) = 1`); in particular it preserves `Q` and is an
  involution, so the Apollonian group is a reflection group;
* over an integral domain, the two solutions `x` of `Q(…, x, …) = 0` with the other three entries
  fixed are `vᵢ` and its flip, so `vᵢ + vᵢ' = 2 · (sum of the other three)`;
* every quadruple reachable from a Descartes quadruple by flips is a Descartes quadruple, and it is
  integral when the starting quadruple is (Soddy's integrality of Apollonian packings).

Sources: J. C. Lagarias, C. L. Mallows and A. R. Wilks, *Beyond the Descartes circle theorem*,
Amer. Math. Monthly 109 (2002), arXiv:math/0101066v1, Theorem 1.1 and equation (2.1);
A. Kontorovich and H. Oh, *Apollonian circle packings and closed horospheres on hyperbolic
3-manifolds*, J. Amer. Math. Soc. 24 (2011), arXiv:0811.2236v5, equation (1.3) and Section 2.1;
H. Oh, *Apollonian circle packings: dynamics and number theory*, Japan. J. Math. 9 (2014),
arXiv:1312.1383v2, Theorems 4.1 and 4.2.
-/

@[expose] public section

namespace MathlibExt.Geometry.Euclidean.ApollonianDescartesQuadruples

open Finset

variable {R : Type*} [CommRing R]

/-- **Descartes quadratic form.** For a quadruple `v = (v₀, v₁, v₂, v₃)`,
`Q(v) = 2 (v₀² + v₁² + v₂² + v₃²) - (v₀ + v₁ + v₂ + v₃)²`. A quadruple with `Q(v) = 0` is a
*Descartes quadruple*; by Descartes' circle theorem the signed curvatures of four mutually tangent
circles form one (Lagarias, Mallows and Wilks, *Beyond the Descartes circle theorem*,
arXiv:math/0101066v1, Theorem 1.1; Kontorovich and Oh, arXiv:0811.2236v5, Section 2.1). -/
def descartesForm (v : Fin 4 → R) : R :=
  2 * ∑ i, v i ^ 2 - (∑ i, v i) ^ 2

/-- **Descartes relation as a vanishing quadratic form.** A quadruple satisfies the Descartes
relation `(∑ vᵢ)² = 2 ∑ vᵢ²` exactly when the Descartes quadratic form vanishes on it
(Lagarias, Mallows and Wilks, arXiv:math/0101066v1, equation (1.1)). -/
theorem descartesForm_eq_zero_iff (v : Fin 4 → R) :
    descartesForm v = 0 ↔ (∑ i, v i) ^ 2 = 2 * ∑ i, v i ^ 2 := by
  rw [descartesForm, sub_eq_zero, eq_comm]

/-- **Curvatures of tangent circles form a Descartes quadruple.** Under the hypotheses of
Descartes' circle theorem (four circles of positive radii, either pairwise externally tangent or
with one circle internally tangent to the three others, which are pairwise externally tangent),
the signed curvatures `k` satisfy `Q(k) = 0` (Lagarias, Mallows and Wilks,
arXiv:math/0101066v1, Theorem 1.1). -/
theorem descartesForm_eq_zero_of_tangent (c : Fin 4 → EuclideanSpace ℝ (Fin 2)) (r k : Fin 4 → ℝ)
    (hr : ∀ i, 0 < r i)
    (htan : ((∀ i j, i ≠ j → dist (c i) (c j) = r i + r j) ∧ ∀ i, k i = 1 / r i) ∨
      ∃ e : Fin 4, k e = -1 / r e ∧ (∀ j, j ≠ e → k j = 1 / r j) ∧
        (∀ j, j ≠ e → dist (c e) (c j) = r e - r j) ∧
        ∀ i j, i ≠ e → j ≠ e → i ≠ j → dist (c i) (c j) = r i + r j) :
    descartesForm k = 0 :=
  (descartesForm_eq_zero_iff k).2 (MetaMathlibExt.descartes_circle_theorem c r k hr htan)

/-- **Polar form of the Descartes form.** `B(u, w) = 2 ∑ uᵢ wᵢ - (∑ uᵢ)(∑ wᵢ)`, the symmetric
bilinear form with `B(v, v) = Q(v)`. The orthogonal group `O_Q` of Kontorovich and Oh
(arXiv:0811.2236v5, Section 2.1) is the group of linear maps preserving it. -/
def descartesPolar (u w : Fin 4 → R) : R :=
  2 * ∑ i, u i * w i - (∑ i, u i) * ∑ i, w i

/-- **The polar form restricts to the Descartes form on the diagonal.** `B(v, v) = Q(v)`, by
expanding both sides. -/
theorem descartesPolar_self (v : Fin 4 → R) : descartesPolar v v = descartesForm v := by
  simp only [descartesPolar, descartesForm, sq]

/-- **The standard basis vectors have Descartes norm one.** `Q(eᵢ) = 2 - 1 = 1`, so each `eᵢ` is
anisotropic and has an orthogonal reflection `v ↦ v - 2 B(v, eᵢ) eᵢ`, defined over any
commutative ring. -/
theorem descartesForm_single (i : Fin 4) : descartesForm (Pi.single i (1 : R)) = 1 := by
  fin_cases i <;> simp [descartesForm, Fin.sum_univ_four] <;> norm_num

/-- **Apollonian flip.** `flip i v` replaces the entry `vᵢ` by `2 · (sum of the other three
entries) - vᵢ`; it is the action of the generator `Sᵢ` of the Apollonian group on column vectors
(Kontorovich and Oh, arXiv:0811.2236v5, equation (1.3) and the matrices `S₁, …, S₄` of the
introduction; Lagarias, Mallows and Wilks, arXiv:math/0101066v1, equation (2.1)). -/
def apollonianFlip (i : Fin 4) (v : Fin 4 → R) : Fin 4 → R :=
  Function.update v i (2 * (∑ j, v j - v i) - v i)

/-- **The linear form defining the `i`-th Apollonian reflection.** The linear form
`f(v) = 4 vᵢ - 2 ∑ vⱼ`, equal to `2 B(v, eᵢ)`; it takes the value `2` on `eᵢ`, so
`v ↦ v - f(v) eᵢ` is a reflection in the sense of `Module.reflection`. -/
def flipForm (i : Fin 4) : Module.Dual R (Fin 4 → R) :=
  4 • LinearMap.proj i - 2 • ∑ j, LinearMap.proj j

/-- **Value of the reflection form.** `f(v) = 2 B(v, eᵢ)`, by expanding both sides. -/
theorem flipForm_apply (i : Fin 4) (v : Fin 4 → R) :
    flipForm i v = 2 * descartesPolar v (Pi.single i 1) := by
  fin_cases i <;>
    simp [flipForm, descartesPolar, Fin.sum_univ_four] <;> ring

/-- **The reflection form is `2` on the reflected vector.** `f(eᵢ) = 2 Q(eᵢ) = 2`, the
normalisation required by `Module.reflection`. -/
theorem flipForm_single (i : Fin 4) : flipForm i (Pi.single i (1 : R)) = 2 := by
  rw [flipForm_apply, descartesPolar_self, descartesForm_single, mul_one]

/-- **The Apollonian flips are orthogonal reflections.** `Sᵢ` is Mathlib's reflection
`v ↦ v - f(v) eᵢ` with `f = 2 B(·, eᵢ)`, that is, the orthogonal reflection of the quadratic space
`(R⁴, Q)` in the hyperplane `Q`-orthogonal to `eᵢ`. Hence the Apollonian group
`⟨S₁, S₂, S₃, S₄⟩` is generated by reflections (Kontorovich and Oh, arXiv:0811.2236v5,
Section 2.1; H. Oh, arXiv:1312.1383v2, Section 2, where `A` is generated by the inversions in the
four dual circles). -/
theorem apollonianFlip_eq_reflection (i : Fin 4) (v : Fin 4 → R) :
    apollonianFlip i v = Module.reflection (flipForm_single (R := R) i) v := by
  rw [Module.reflection_apply]
  funext j
  fin_cases i <;> fin_cases j <;>
    simp [apollonianFlip, flipForm, Fin.sum_univ_four, Function.update] <;> ring

/-- **Each Apollonian flip is an involution.** `Sᵢ² = 1` (Kontorovich and Oh,
arXiv:0811.2236v5, introduction: the matrices `Sᵢ` are reflections). -/
theorem apollonianFlip_apollonianFlip (i : Fin 4) (v : Fin 4 → R) :
    apollonianFlip i (apollonianFlip i v) = v := by
  rw [apollonianFlip_eq_reflection, apollonianFlip_eq_reflection]
  exact Module.involutive_reflection _ v

/-- **The Apollonian flips fix the orthogonal hyperplane.** If `B(v, eᵢ) = 0` then `Sᵢ v = v`:
`Sᵢ` fixes pointwise the hyperplane `Q`-orthogonal to `eᵢ`. -/
theorem apollonianFlip_of_descartesPolar_eq_zero (i : Fin 4) (v : Fin 4 → R)
    (hv : descartesPolar v (Pi.single i 1) = 0) : apollonianFlip i v = v := by
  rw [apollonianFlip_eq_reflection, Module.reflection_apply, flipForm_apply, hv]
  simp

/-- **The Apollonian flips negate the reflected vector.** `Sᵢ eᵢ = -eᵢ`; together with the
previous statement this identifies `Sᵢ` as the orthogonal reflection of `(R⁴, Q)` along `eᵢ`. -/
theorem apollonianFlip_single (i : Fin 4) :
    apollonianFlip i (Pi.single i (1 : R)) = -Pi.single i 1 := by
  rw [apollonianFlip_eq_reflection, Module.reflection_apply_self]

/-- **The Apollonian flips preserve the Descartes form.** `Q(Sᵢ v) = Q(v)`, so the Apollonian
group lies in the orthogonal group of `Q` (Kontorovich and Oh, arXiv:0811.2236v5, Section 2.1:
`A < O_Q(ℤ)`). -/
theorem descartesForm_apollonianFlip (i : Fin 4) (v : Fin 4 → R) :
    descartesForm (apollonianFlip i v) = descartesForm v := by
  fin_cases i <;>
    simp [descartesForm, apollonianFlip, Fin.sum_univ_four, Function.update] <;> ring

/-- **The two roots of the Descartes relation.** Over an integral domain, if `v` is a Descartes
quadruple and replacing its `i`-th entry by `x` again gives a Descartes quadruple, then `x = vᵢ`
or `x = 2 · (sum of the other three entries) - vᵢ`; equivalently the two curvatures `d, d'` of
the circles tangent to three mutually tangent circles of curvatures `a, b, c` satisfy
`d + d' = 2 (a + b + c)` (Lagarias, Mallows and Wilks, arXiv:math/0101066v1, equation (2.1);
Kontorovich and Oh, arXiv:0811.2236v5, equation (1.3)). -/
theorem eq_or_eq_flip_of_descartesForm_update_eq_zero [IsDomain R] {v : Fin 4 → R} {i : Fin 4}
    {x : R} (hv : descartesForm v = 0) (hx : descartesForm (Function.update v i x) = 0) :
    x = v i ∨ x = 2 * (∑ j, v j - v i) - v i := by
  have key : (x - v i) * (x - (2 * (∑ j, v j - v i) - v i)) = 0 := by
    fin_cases i <;>
      simp [descartesForm, Fin.sum_univ_four, Function.update] at hv hx <;>
      simp [Fin.sum_univ_four, -mul_eq_zero] <;>
      linear_combination hx - hv
  rcases mul_eq_zero.mp key with h | h
  · exact Or.inl (sub_eq_zero.mp h)
  · exact Or.inr (sub_eq_zero.mp h)

/-- **Apollonian orbit of a quadruple.** The quadruples obtained from `v` by finitely many flips;
since every flip is an involution this is the orbit of `v` under the Apollonian group
`⟨S₁, S₂, S₃, S₄⟩` (Kontorovich and Oh, arXiv:0811.2236v5, Section 2.1). -/
def apollonianOrbit (v : Fin 4 → R) : Set (Fin 4 → R) :=
  Set.range fun l : List (Fin 4) => l.foldr apollonianFlip v

/-- **Curvatures of the Apollonian packing of a quadruple.** All entries of all quadruples in the
Apollonian orbit of `v`; when `v` is the curvature quadruple of a Descartes configuration these
are the curvatures of the circles of the packing it generates (H. Oh, arXiv:1312.1383v2,
Section 4; Kontorovich and Oh, arXiv:0811.2236v5, Theorem 2.3). -/
def apollonianCurvatures (v : Fin 4 → R) : Set R :=
  ⋃ w ∈ apollonianOrbit v, Set.range w

/-- **A quadruple belongs to its Apollonian orbit.** (The empty word of flips.) -/
theorem self_mem_apollonianOrbit (v : Fin 4 → R) : v ∈ apollonianOrbit v :=
  ⟨[], rfl⟩

/-- **Apollonian orbits are closed under the flips.** If `w` is in the Apollonian orbit of `v`,
so is `Sᵢ w` for every `i`. -/
theorem apollonianFlip_mem_apollonianOrbit {v w : Fin 4 → R} (i : Fin 4)
    (hw : w ∈ apollonianOrbit v) : apollonianFlip i w ∈ apollonianOrbit v := by
  obtain ⟨l, rfl⟩ := hw
  exact ⟨i :: l, rfl⟩

/-- **Apollonian orbits stay on a level set of the Descartes form.** Every quadruple in the
Apollonian orbit of `v` has the same Descartes form as `v`; in particular the orbit of a Descartes
quadruple consists of Descartes quadruples, which lie on the cone `Q = 0` (Kontorovich and Oh,
arXiv:0811.2236v5, Section 2.1). -/
theorem descartesForm_of_mem_apollonianOrbit {v w : Fin 4 → R} (hw : w ∈ apollonianOrbit v) :
    descartesForm w = descartesForm v := by
  obtain ⟨l, rfl⟩ := hw
  induction l with
  | nil => rfl
  | cons i l ih => simpa [List.foldr_cons, descartesForm_apollonianFlip] using ih

/-- **Integral quadruple.** Every entry of `v` is (the image of) an integer; an Apollonian
packing is integral when all its curvatures are (H. Oh, arXiv:1312.1383v2, Section 4). -/
def IsIntegralQuadruple (v : Fin 4 → R) : Prop :=
  ∀ i, v i ∈ Set.range (Int.cast : ℤ → R)

/-- **Flips preserve integrality.** If `v` is integral then so is `Sᵢ v`, because `Sᵢ` has
integer entries (Kontorovich and Oh, arXiv:0811.2236v5, equation (1.3) and the remark after
it). -/
theorem isIntegralQuadruple_apollonianFlip {v : Fin 4 → R} (hv : IsIntegralQuadruple v)
    (i : Fin 4) :
    IsIntegralQuadruple (apollonianFlip i v) := by
  choose n hn using hv
  intro j
  by_cases hji : j = i
  · subst hji
    refine ⟨2 * (∑ k, n k - n j) - n j, ?_⟩
    simp [apollonianFlip, hn]
  · exact ⟨n j, by simp [apollonianFlip, Function.update_of_ne hji, hn]⟩

/-- **Integrality propagates through Apollonian orbits.** If the four initial curvatures are
integers, so is every quadruple in the Apollonian orbit (Soddy 1937; H. Oh, arXiv:1312.1383v2,
Theorem 4.2; Kontorovich and Oh, arXiv:0811.2236v5, remark after equation (1.3)). -/
theorem IsIntegralQuadruple.of_mem_apollonianOrbit {v w : Fin 4 → R}
    (hv : IsIntegralQuadruple v)
    (hw : w ∈ apollonianOrbit v) : IsIntegralQuadruple w := by
  obtain ⟨l, rfl⟩ := hw
  induction l with
  | nil => exact hv
  | cons i l ih => exact isIntegralQuadruple_apollonianFlip ih i

/-- **Integral Apollonian packings.** If the four initial curvatures are integers then every
curvature of the packing is an integer: `apollonianCurvatures v ⊆ ℤ` (Soddy 1937; H. Oh,
arXiv:1312.1383v2, Theorem 4.2; Lagarias, Mallows and Wilks, arXiv:math/0101066v1, remark after
equation (2.1)). -/
theorem apollonianCurvatures_subset_range_intCast {v : Fin 4 → R} (hv : IsIntegralQuadruple v) :
    apollonianCurvatures v ⊆ Set.range (Int.cast : ℤ → R) := by
  intro x hx
  simp only [apollonianCurvatures, Set.mem_iUnion] at hx
  obtain ⟨w, hw, i, rfl⟩ := hx
  exact hv.of_mem_apollonianOrbit hw i

end MathlibExt.Geometry.Euclidean.ApollonianDescartesQuadruples
