module

import Batteries.Util.ProofWanted
public import Mathlib.Algebra.LinearRecurrence
public import Mathlib.Basic.Complex.Basic
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.Defs
public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-! # Decomposable forms generated by linear recurrences

Statement-only requests from Győry, Pethő and Szalay. A linear recurrence of order `k`
is a Mathlib `LinearRecurrence ℂ`; the source's sequences are indexed by `ℤ`, so a
solution is a map `ℤ → ℂ` satisfying `G (n + k) = ∑ i, E.coeffs i * G (n + i)` for every
`n : ℤ`. The source writes the characteristic polynomial with constant term `-γ₀`, so
`(-1) ^ (k + 1) * γ₀ = (-1) ^ k * E.charPoly.coeff 0`.
-/

namespace MetaMathlibExt

@[expose] public section

/-- If `k` sequences `ℤ → ℂ` satisfy the same order-`k` linear recurrence and are
`ℂ`-linearly independent, then some homogeneous form `F` of degree `k` satisfies
`F(G⁽¹⁾ₙ, …, G⁽ᵏ⁾ₙ) = ((-1)^(k+1) γ₀)ⁿ` for every `n : ℤ`, where `-γ₀` is the constant term
of the characteristic polynomial. The source's hypothesis `γ₀ ≠ 0` is omitted: for
`ℤ`-indexed solutions, linear independence already forces it.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 1
(`jis-2024-24.3.5-thm-1`). -/
public theorem_wanted exists_homogeneous_form_eval_eq_pow_of_linearRecurrence
    (E : LinearRecurrence ℂ) (G : Fin E.order → ℤ → ℂ)
    (hG : ∀ j (n : ℤ), G j (n + E.order) = ∑ i, E.coeffs i * G j (n + (i : ℕ)))
    (hind : LinearIndependent ℂ G) :
    ∃ F : MvPolynomial (Fin E.order) ℂ, F.IsHomogeneous E.order ∧
      ∀ n : ℤ, MvPolynomial.eval (fun j => G j n) F =
        ((-1) ^ E.order * E.charPoly.coeff 0) ^ n

/-- Under the hypotheses of Theorem 1 the form can be taken decomposable: a product of `k`
linear forms over `ℂ`.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 2
(`jis-2024-24.3.5-thm-2`). -/
public theorem_wanted exists_decomposable_form_eval_eq_pow_of_linearRecurrence
    (E : LinearRecurrence ℂ) (G : Fin E.order → ℤ → ℂ)
    (hG : ∀ j (n : ℤ), G j (n + E.order) = ∑ i, E.coeffs i * G j (n + (i : ℕ)))
    (hind : LinearIndependent ℂ G) :
    ∃ L : Fin E.order → MvPolynomial (Fin E.order) ℂ, (∀ i, (L i).IsHomogeneous 1) ∧
      ∀ n : ℤ, MvPolynomial.eval (fun j => G j n) (∏ i, L i) =
        ((-1) ^ E.order * E.charPoly.coeff 0) ^ n

/-- For one sequence `G : ℤ → ℂ` satisfying an order-`k` linear recurrence whose window
vectors `(G_j, …, G_{j+k-1})`, `0 ≤ j < k`, are linearly independent, some product `F` of
`k` linear forms satisfies `F(Gₙ, …, G_{n+k-1}) = ((-1)^(k+1) γ₀)ⁿ` for every `n : ℤ`.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Corollary 3
(`jis-2024-24.3.5-cor-3`). -/
public theorem_wanted exists_decomposable_form_eval_shifts_eq_pow
    (E : LinearRecurrence ℂ) (G : ℤ → ℂ)
    (hG : ∀ n : ℤ, G (n + E.order) = ∑ i, E.coeffs i * G (n + (i : ℕ)))
    (hind : LinearIndependent ℂ fun j : Fin E.order => fun i : Fin E.order =>
      G ((j : ℕ) + (i : ℕ))) :
    ∃ L : Fin E.order → MvPolynomial (Fin E.order) ℂ, (∀ i, (L i).IsHomogeneous 1) ∧
      ∀ n : ℤ, MvPolynomial.eval (fun j : Fin E.order => G (n + (j : ℕ))) (∏ i, L i) =
        ((-1) ^ E.order * E.charPoly.coeff 0) ^ n

/-- Any `k` sequences `ℤ → ℂ` satisfying the same order-`k` linear recurrence, together with
the sequence `n ↦ γ₀ⁿ` (where `-γ₀` is the constant term of the characteristic polynomial),
are algebraically dependent over `ℂ` in the algebra `ℤ → ℂ`.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Corollary 4
(`jis-2024-24.3.5-cor-4`). -/
public theorem_wanted not_algebraicIndependent_linearRecurrence_solutions_pow
    (E : LinearRecurrence ℂ) (G : Fin E.order → ℤ → ℂ)
    (hG : ∀ j (n : ℤ), G j (n + E.order) = ∑ i, E.coeffs i * G j (n + (i : ℕ))) :
    ¬ AlgebraicIndependent ℂ fun o : Option (Fin E.order) =>
      o.elim (fun n : ℤ => (-E.charPoly.coeff 0) ^ n) G


/-- Integer version: let `k` integer sequences `G⁽¹⁾, …, G⁽ᵏ⁾` satisfy the same order-`k`
linear recurrence with integer coefficients and `γ₀ ≠ 0`, where `-γ₀` is the constant term of
the characteristic polynomial, and let `Δ = det (G⁽ʲ⁾ᵢ)_{j, i < k} ≠ 0` be the determinant of
their initial values. Then some form `F̃` with integer coefficients that is decomposable (over
`ℂ` it is a product of `k` linear forms, hence homogeneous of degree `k`) satisfies
`F̃(G⁽¹⁾ₙ, …, G⁽ᵏ⁾ₙ) = Δᵏ δⁿ` for all `n ≥ 0`, where `δ = (-1)^(k+1) γ₀`. The theorem
statement says "homogeneous form"; decomposability is the paper's description of `F̃` in the
introduction and follows from Theorem 2, since `F̃ = Δᵏ F`. The source's standing assumption
`k ≥ 2` is omitted (for `k ≤ 1` the claim holds with `F̃` constant or linear); definitions
read from arXiv:2308.13817v1.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 6 (`jis-2024-24.3.5-thm-6`). -/
public theorem_wanted exists_int_decomposable_form_eval_eq_det_pow_mul_pow
    (E : LinearRecurrence ℤ) (G : Fin E.order → ℕ → ℤ) (hG : ∀ j, E.IsSolution (G j))
    (hγ : E.charPoly.coeff 0 ≠ 0)
    (hΔ : (Matrix.of fun j i : Fin E.order => G j i).det ≠ 0) :
    ∃ F : MvPolynomial (Fin E.order) ℤ,
      (∃ L : Fin E.order → MvPolynomial (Fin E.order) ℂ, (∀ i, (L i).IsHomogeneous 1) ∧
        MvPolynomial.map (Int.castRingHom ℂ) F = ∏ i, L i) ∧
      ∀ n : ℕ, MvPolynomial.eval (fun j => G j n) F =
        (Matrix.of fun j i : Fin E.order => G j i).det ^ E.order *
          ((-1) ^ E.order * E.charPoly.coeff 0) ^ n

/-- Two sequences `G`, `H` with `xₙ₊₂ = A xₙ₊₁ + B xₙ` satisfy
`C_H Gₙ² + C_{GH} Gₙ Hₙ + C_G Hₙ² = (-B)ⁿ Δ²` for all `n ≥ 0`, where
`C_G = G₁² - A G₀ G₁ - B G₀²`, `C_H = H₁² - A H₀ H₁ - B H₀²`, `C_{GH} = -(E₁₀ + E₀₁)` with
`E₁₀ = G₁ H₁ - A G₁ H₀ - B G₀ H₀`, `E₀₁ = G₁ H₁ - A G₀ H₁ - B G₀ H₀`, and
`Δ = G₀ H₁ - G₁ H₀`. Stated over any commutative ring and without the source's `Δ ≠ 0`
(the identity is polynomial in the initial values); definitions read from
arXiv:2308.13817v1, Section 6.1.

Source: Kálmán Győry, Attila Pethő and László Szalay, *Decomposable Forms Generated by
Linear Recurrences*, Journal of Integer Sequences 27 (2024), Article 24.3.5, Theorem 9 (`jis-2024-24.3.5-thm-9`). -/
public theorem_wanted binary_recurrence_quadratic_form_eq_neg_pow_mul_sq {R : Type*} [CommRing R]
    (A B : R) (G H : ℕ → R) (hG : ∀ n, G (n + 2) = A * G (n + 1) + B * G n)
    (hH : ∀ n, H (n + 2) = A * H (n + 1) + B * H n) (n : ℕ) :
    (H 1 ^ 2 - A * H 0 * H 1 - B * H 0 ^ 2) * G n ^ 2 -
        ((G 1 * H 1 - A * G 1 * H 0 - B * G 0 * H 0) +
          (G 1 * H 1 - A * G 0 * H 1 - B * G 0 * H 0)) * G n * H n +
        (G 1 ^ 2 - A * G 0 * G 1 - B * G 0 ^ 2) * H n ^ 2 =
      (-B) ^ n * (G 0 * H 1 - G 1 * H 0) ^ 2

end

end MetaMathlibExt
