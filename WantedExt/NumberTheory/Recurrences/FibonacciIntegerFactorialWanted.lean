/-! # Factorials that are Fibonacci integers

A Fibonacci integer is a positive integer in the subgroup `G_F` of `ℚˣ` generated by
the Fibonacci numbers `F_m`, `m ≥ 1`, i.e. a product of integer powers of Fibonacci
numbers.

The paper's title is cited as printed. The printed product (checked against the journal PDF)
evaluates to `36! / 8`, not `36!` (`8 = F_6`).
-/

/-- The largest factorial which is a Fibonacci integer is `36!`: `n!` lies in the
subgroup of `ℚˣ` generated by the positive Fibonacci numbers `F_m` (`m ≥ 1`) if and only
if `n ≤ 36`.

The group `G_F` is the multiplicative group generated by the Fibonacci numbers; the
statement records both the paper's claim that `36!` is a Fibonacci integer and that no
`n!` with `n ≥ 37` is.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Theorem 1
(`integers-2024-A72-thm-1`). -/
public theorem_wanted factorial_mem_fibonacciIntegers_iff (n : ℕ) :
    (∃ u ∈ Subgroup.closure {u : ℚˣ | ∃ m : ℕ, 0 < m ∧ (u : ℚ) = Nat.fib m},
      (u : ℚ) = n.factorial) ↔ n ≤ 36

/-- Carmichael's congruence for primitive prime divisors of Fibonacci numbers: for
`m > 12`, every primitive prime divisor `p` of `F_m` (a prime dividing `F_m` but no
`F_n` with `0 < n < m`, `IntegerSequence.IsPrimitivePrimeDivisor`) satisfies
`p ≡ ±1 (mod m)`. The existence half of the quoted theorem (such a prime exists) is
already proved as `MetaMathlibExt.exists_isPrimitiveDivisor_fib`.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Theorem 2
(Primitive Divisor Theorem, quoting R. D. Carmichael) (`integers-2024-A72-thm-2`). -/
public theorem_wanted primitive_prime_dvd_fib_modEq_one_or_neg_one {m p : ℕ} (hm : 12 < m)
    (hp : IntegerSequence.IsPrimitivePrimeDivisor (fun n => (Nat.fib n : ℤ)) m p) :
    p ≡ 1 [MOD m] ∨ p + 1 ≡ 0 [MOD m]


/-- The entry point (rank of apparition) `z(k)`: the least `m > 0` with `k ∣ F_m` (`0` if
there is none).

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2. -/
public noncomputable def fibEntryPoint (k : ℕ) : ℕ :=
  sInf {m : ℕ | 0 < m ∧ k ∣ Nat.fib m}

/-- `z(2) = 3`.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2 (`6 = 2 z(2)`). -/
public theorem fibEntryPoint_two : fibEntryPoint 2 = 3 := by
  apply le_antisymm
  · exact Nat.sInf_le ⟨by norm_num, by decide⟩
  · refine le_csInf ⟨3, by norm_num, by decide⟩ ?_
    rintro m ⟨hm, hdvd⟩
    by_contra h
    interval_cases m <;> simp_all [Nat.fib_one, Nat.fib_two]

/-- `z(5) = 5`.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2 (the exceptional index `m = 5`). -/
public theorem fibEntryPoint_five : fibEntryPoint 5 = 5 := by
  apply le_antisymm
  · exact Nat.sInf_le ⟨by norm_num, by decide⟩
  · refine le_csInf ⟨5, by norm_num, by decide⟩ ?_
    rintro m ⟨hm, hdvd⟩
    by_contra h
    interval_cases m <;> revert hdvd <;> decide

/-- `Φ_m = Φ_m(α, β) = ∏_{d ∣ m} F_{m/d}^{μ(d)}` for `m > 1`, the value of the homogenized
`m`-th cyclotomic polynomial at the roots `α, β` of `x² - x - 1`, as a rational number via the
paper's Möbius inversion formula (at `m = 1` this formula gives `1`, not `Φ_1 = √5`; the index
`1` is excluded from `M` below).

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2. -/
public noncomputable def fibCyclotomicValue (m : ℕ) : ℚ :=
  ∏ d ∈ m.divisors, (Nat.fib (m / d) : ℚ) ^ (ArithmeticFunction.moebius d)

/-- `Φ_2 = 1`, one of the exceptional relations (1).

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2, Equation (1). -/
public theorem fibCyclotomicValue_two : fibCyclotomicValue 2 = 1 := by
  have h : Nat.divisors 2 = {1, 2} := by decide
  simp [fibCyclotomicValue, h, ArithmeticFunction.moebius_apply_prime Nat.prime_two]

/-- `Ψ_m = ∏_{p^a ∥ F_m, z(p) = m} p^a`, the primitive part of `F_m`.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2. -/
public noncomputable def fibPrimitivePart (m : ℕ) : ℕ :=
  ∏ p ∈ (Nat.fib m).primeFactors with fibEntryPoint p = m, p ^ (Nat.fib m).factorization p

/-- `Ψ_6 = 1`: `F_6 = 8` has no primitive prime factor (`z(2) = 3`).

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Section 2. -/
public theorem fibPrimitivePart_six : fibPrimitivePart 6 = 1 := by
  have h : (Nat.fib 6).primeFactors = {2} := by
    rw [show Nat.fib 6 = 2 ^ 3 by decide, Nat.primeFactors_prime_pow (by norm_num) Nat.prime_two]
  simp [fibPrimitivePart, h, fibEntryPoint_two]

/-- Lemma 1 (Lemma 1 of [3]): let `I`, `J` be finite multisets of indices in
`M = ℕ \ {1, 2, 6, 12}` (positive integers), with `n_i ≠ m_j` for all `i ∈ I`, `j ∈ J`, such
that `∏_{i ∈ I} Φ_{n_i} ∏_{j ∈ J} Φ_{m_j}^{-1}` is a natural number. Then there is an injection
`f` from the multiset of prime factors `p_1 ⋯ p_k` of `∏_{j ∈ J} Ψ_{m_j}` into the multiset
`{n_i}` with `f(p_l) = p_l^{k_l} z(p_l)`; the injection is encoded as a multiset `e` of pairs
`(p_l, k_l)` whose first coordinates are the prime factors and whose images are a
sub-multiset of `I`.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Lemma 1 (`integers-2024-A72-lem-1`). -/
public theorem_wanted exists_injection_primeFactors_fibPrimitivePart (I J : Multiset ℕ)
    (hI : ∀ n ∈ I, 3 ≤ n ∧ n ≠ 6 ∧ n ≠ 12) (hJ : ∀ m ∈ J, 3 ≤ m ∧ m ≠ 6 ∧ m ≠ 12)
    (hIJ : ∀ n ∈ I, ∀ m ∈ J, n ≠ m)
    (hnat : ∃ N : ℕ, (I.map fibCyclotomicValue).prod / (J.map fibCyclotomicValue).prod = N) :
    ∃ e : Multiset (ℕ × ℕ),
      e.map Prod.fst = ((J.map fibPrimitivePart).prod.primeFactorsList : Multiset ℕ) ∧
        e.map (fun pk => pk.1 ^ pk.2 * fibEntryPoint pk.1) ≤ I

/-- Lemma 2, in the setting of Section 3: let `n ≥ 37` and `n! = ∏_{i ∈ I} Φ_{n_i}
∏_{j ∈ J} Φ_{m_j}^{-1}` with `I`, `J` as in Lemma 1. For a prime `p` with `z(p) > 12`, the number
`N_p` of `j ∈ J` with `ν_p(δ_{m_j}) = 1`, `δ_m = Φ_m / Ψ_m`, satisfies `N_p < 2n/(z(p) p (p-2))`.

Source: Florian Luca, *`F_4 F_5^6 F_7 F_8^4 F_9 F_{10}^2 F_{12}^5 F_{14} F_{15}^{-1}
F_{18} F_{24} F_{30} = 36!`*, INTEGERS 24 (2024), Article A72, Lemma 2 (`integers-2024-A72-lem-2`). -/
public theorem_wanted card_padicValRat_fibDelta_eq_one_lt {n : ℕ} (hn : 37 ≤ n)
    (I J : Multiset ℕ) (hI : ∀ n ∈ I, 3 ≤ n ∧ n ≠ 6 ∧ n ≠ 12)
    (hJ : ∀ m ∈ J, 3 ≤ m ∧ m ≠ 6 ∧ m ≠ 12) (hIJ : ∀ a ∈ I, ∀ b ∈ J, a ≠ b)
    (hfact : (n.factorial : ℚ) =
      (I.map fibCyclotomicValue).prod / (J.map fibCyclotomicValue).prod)
    {p : ℕ} (hp : p.Prime) (hz : 12 < fibEntryPoint p) :
    ((J.filter fun m => padicValRat p (fibCyclotomicValue m / fibPrimitivePart m) = 1).card : ℚ) <
      2 * n / (fibEntryPoint p * p * ((p : ℚ) - 2))

end

end MetaMathlibExt
