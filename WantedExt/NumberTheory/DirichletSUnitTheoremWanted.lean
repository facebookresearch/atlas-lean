module

import Batteries.Util.ProofWanted
public import Mathlib.GroupTheory.Torsion
public import Mathlib.RingTheory.DedekindDomain.SInteger
public import MathlibExt.NumberTheory.NumberField.Place
import Mathlib.NumberTheory.NumberField.ProductFormula

/-!
# Dirichlet's `S`-unit theorem

Let `K` be a number field and `S` a finite set of places of `K` (`NumberField.Place K`) that
contains every infinite place. The `S`-units are Mathlib's `Set.unit K` for the set of height-one
primes of `𝓞 K` whose finite places lie in `S`: the elements of `Kˣ` of valuation one at every
other height-one prime. The roots of unity of `K` are the torsion subgroup `CommGroup.torsion Kˣ`.

The logarithmic map sends an `S`-unit `a` to `(log |a|_v)_{v ∈ S}`, with the normalized absolute
values of the product formula `NumberField.prod_abs_eq_one`: `w a ^ w.mult` at an infinite place
`w` and `v a` at a finite place `v`. A full lattice in the hyperplane `∑_{v ∈ S} x_v = 0` of
`ℝ^S` is written as the `ℤ`-span of `|S| - 1` vectors of the hyperplane that are linearly
independent over `ℝ`; since the hyperplane has dimension `|S| - 1`, they form a basis of it.

## Main statements

* `NumberField.dirichlet_sUnit_theorem`: the `S`-units form a finitely generated group whose
  torsion subgroup is the group of roots of unity of `K` and whose rank is `|S| - 1`; the kernel
  of the logarithmic map is the group of roots of unity, and its image is a full lattice in the
  hyperplane `∑_{v ∈ S} x_v = 0`.

## References

* J. S. Milne, *Algebraic Number Theory*, version 3.08 (2020), Theorem 5.11 and the sentence
  before it, with Proposition 5.8 and Theorem 5.9.
* J. S. Milne, *Class Field Theory*, version 4.03 (2020), Sections VII.3 and VII.6.
-/

@[expose] public section

namespace NumberField

open IsDedekindDomain

variable {K : Type*} [Field K] [NumberField K]

/-- **Dirichlet's $S$-unit theorem.** Let $K$ be a number field and $S$ a finite set of places of
$K$ containing every infinite place. Let $U(S)$ be the group of $S$-units, the elements
$a \in K^\times$ with $\mathrm{ord}_{\mathfrak{p}}(a) = 0$ for every finite place
$\mathfrak{p} \notin S$, and let $\mu(K)$ be the group of roots of unity in $K$, the torsion
subgroup of $K^\times$. Then $U(S)$ is finitely generated, its torsion subgroup is $\mu(K)$, and
its rank is $|S| - 1$. For $a \in U(S)$ let
$\lambda(a) = (\log |a|_v)_{v \in S} \in \mathbb{R}^S$, where $|a|_v$ is the normalized absolute
value: $|a|_v = |a|_w^{m_w}$ at an infinite place $w$, with $|\cdot|_w$ the absolute value induced
by an embedding of $K$ into $\mathbb{C}$ and $m_w = 1$ if $w$ is real and $m_w = 2$ if $w$ is
complex, and $|a|_v = N(\mathfrak{p}_v)^{-\mathrm{ord}_{\mathfrak{p}_v}(a)}$ at a finite place $v$
with prime ideal $\mathfrak{p}_v$ of norm $N(\mathfrak{p}_v)$. Then $\lambda(a) = 0$ if and only
if $a \in \mu(K)$, and the image of $\lambda$ is a full lattice in the hyperplane
$H = \{x \in \mathbb{R}^S : \sum_{v \in S} x_v = 0\}$: it is the subgroup generated by $|S| - 1$
vectors of $H$ that are linearly independent over $\mathbb{R}$, which form a basis of $H$.

Since $S$ contains an infinite place, $|S| \ge 1$, so the natural-number subtraction $|S| - 1$ is
not truncated.

Source: J. S. Milne, *Algebraic Number Theory*, version 3.08 (2020), Theorem 5.11 (the rank) and
the sentence before it (the torsion subgroup), and Proposition 5.8 and Theorem 5.9 (the
logarithmic image for $S$ the set of infinite places); J. S. Milne, *Class Field Theory*, version
4.03 (2020), Section VII.3 (the logarithmic image is a lattice in the hyperplane) and Section VII.6
($U(S) \approx \mathbb{Z}^{|S| - 1} \times U(S)_{\mathrm{tors}}$). -/
theorem_wanted dirichlet_sUnit_theorem (S : Finset (Place K))
    (hS : ∀ w : InfinitePlace K, Place.infinitePlace w ∈ S) :
    let U : Subgroup Kˣ :=
      {v : HeightOneSpectrum (𝓞 K) | Place.finitePlace (FinitePlace.mk v) ∈ S}.unit K
    let absValue : Place K → K → ℝ := Sum.elim (fun w x ↦ w x ^ w.mult) fun v x ↦ v x
    let logMap : U → S → ℝ := fun a v ↦ Real.log (absValue v ((a : Kˣ) : K))
    Group.FG U ∧ (CommGroup.torsion U).map U.subtype = CommGroup.torsion Kˣ ∧
      Module.finrank ℤ (Additive U) = S.card - 1 ∧
      (∀ a : U, logMap a = 0 ↔ (a : Kˣ) ∈ CommGroup.torsion Kˣ) ∧
      ∃ b : Fin (S.card - 1) → S → ℝ, LinearIndependent ℝ b ∧ (∀ i, ∑ v, b i v = 0) ∧
        Set.range logMap = Submodule.span ℤ (Set.range b)

/-- **The infinite places form an admissible set.** For every number field $K$, the set
$S_\infty$ of infinite places of $K$, viewed as places, contains every infinite place, so the
hypothesis of `dirichlet_sUnit_theorem` can be met. -/
example : ∀ w : InfinitePlace K,
    Place.infinitePlace w ∈ Finset.univ.map ⟨Place.infinitePlace, Sum.inl_injective⟩ :=
  fun w ↦ Finset.mem_map_of_mem _ (Finset.mem_univ w)

/-- **No finite place lies in $S_\infty$.** For $S = S_\infty$, the set of infinite places of $K$,
no height-one prime of $\mathcal{O}_K$ has its finite place in $S$, so the $S$-units of
`dirichlet_sUnit_theorem` are Mathlib's $\emptyset$-units. -/
example : {v : HeightOneSpectrum (𝓞 K) | Place.finitePlace (FinitePlace.mk v) ∈
    Finset.univ.map ⟨Place.infinitePlace, Sum.inl_injective⟩} = ∅ := by
  ext v
  simp only [Set.mem_ofPred_eq, Finset.mem_map, Set.mem_empty_iff_false, iff_false, not_exists,
    not_and]
  exact fun w _ h ↦ Sum.inl_ne_inr h

/-- **Roots of unity are $S$-units.** For every number field $K$ and every finite set $S$ of places
of $K$, every root of unity in $K$ is an $S$-unit: the inclusion
$\mu(K) \subseteq U(S)$ behind the torsion clause of `dirichlet_sUnit_theorem`. -/
example (S : Finset (Place K)) :
    CommGroup.torsion Kˣ ≤
      {v : HeightOneSpectrum (𝓞 K) | Place.finitePlace (FinitePlace.mk v) ∈ S}.unit K := by
  intro ζ hζ v _
  obtain ⟨n, hn, hζn⟩ := isOfFinOrder_iff_pow_eq_one.1 ((CommGroup.mem_torsion _).1 hζ)
  have h : (v.valuation K (ζ : K)) ^ n = 1 := by
    rw [← map_pow, ← Units.val_pow_eq_pow_val, hζn, Units.val_one, map_one]
  exact (pow_eq_one_iff_of_nonneg zero_le hn.ne').1 h

/-- **The logarithmic image lies in the hyperplane.** For every number field $K$, every finite set
$S$ of places of $K$ containing every infinite place, and every $S$-unit $a$, the normalized
absolute values of `dirichlet_sUnit_theorem` satisfy $\sum_{v \in S} \log |a|_v = 0$, by the
product formula `NumberField.prod_abs_eq_one`, since $|a|_v = 1$ at every finite place
$v \notin S$. -/
example (S : Finset (Place K)) (hS : ∀ w : InfinitePlace K, Place.infinitePlace w ∈ S)
    (a : {v : HeightOneSpectrum (𝓞 K) | Place.finitePlace (FinitePlace.mk v) ∈ S}.unit K) :
    ∑ v : S, Real.log ((Sum.elim (fun w x ↦ w x ^ w.mult) fun v x ↦ v x : Place K → K → ℝ)
      (v : Place K) ((a : Kˣ) : K)) = 0 := by
  let S' : Finset (InfinitePlace K ⊕ FinitePlace K) := S
  set x : K := ((a : Kˣ) : K)
  have hx : x ≠ 0 := Units.ne_zero _
  let f : InfinitePlace K ⊕ FinitePlace K → ℝ := fun v ↦
    Sum.elim (fun w x ↦ w x ^ w.mult) (fun v x ↦ v x) v x
  have hf : ∀ v, f v ≠ 0 := by
    rintro (w | v)
    · exact pow_ne_zero _ ((map_ne_zero w).2 hx)
    · exact (map_ne_zero v).2 hx
  change ∑ v : S', Real.log (f v) = 0
  rw [Finset.sum_coe_sort S' (fun v ↦ Real.log (f v)), ← Real.log_prod fun v _ ↦ hf v]
  suffices h : ∏ v ∈ S', f v = 1 by rw [h, Real.log_one]
  have hleft : S'.toLeft = Finset.univ := by
    ext w
    simp only [Finset.mem_toLeft, Finset.mem_univ, iff_true]
    exact hS w
  have hfin : ∏ᶠ w : FinitePlace K, w x = ∏ w ∈ S'.toRight, w x := by
    refine finprod_eq_prod_of_mulSupport_subset _ fun w hw ↦ ?_
    by_contra hwS
    refine hw ?_
    have hv : w.maximalIdeal ∉
        {v : HeightOneSpectrum (𝓞 K) | Place.finitePlace (FinitePlace.mk v) ∈ S} := by
      intro h
      have h' : Place.finitePlace (FinitePlace.mk w.maximalIdeal) ∈ S := h
      rw [FinitePlace.mk_maximalIdeal] at h'
      exact hwS (Finset.mem_toRight.2 h')
    change w x = 1
    rw [← FinitePlace.mk_maximalIdeal w, FinitePlace.mk_apply, FinitePlace.norm_embedding',
      a.property _ hv, map_one, NNReal.coe_one]
  have hpf := prod_abs_eq_one hx
  rw [hfin] at hpf
  rw [← Finset.toLeft_disjSum_toRight (u := S'), Finset.prod_disjSum, hleft]
  exact hpf

end NumberField
