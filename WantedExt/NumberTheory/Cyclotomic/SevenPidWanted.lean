module

public import Mathlib.NumberTheory.NumberField.Cyclotomic.PID
import Batteries.Util.ProofWanted

/-! # The ring of integers in the seventh cyclotomic field -/

@[expose] public section

open scoped NumberField

namespace IsCyclotomicExtension.Rat

/-- **The seventh cyclotomic ring of integers is principal.** Let $K$ be a number field that is
an extension of $\mathbb Q$ generated by the seventh roots of unity. Every ideal of $\mathcal O_K$
is principal. The assertion is independent of the chosen presentation of $K$.

Source: the [regular-prime Fermat project](https://github.com/leanprover-community/flt-regular),
`FltRegular/SmallNumbers/Seven/Seven.lean`, and Anthropic's
[formalized statement](https://github.com/anthropics/fermats-last-theorem/blob/6e837e75355538c7f80bab5b956861e86c4eacc2/Theorems/Thm_IsCyclotomicExtension_Rat_seven_pid.lean#L6). -/
public theorem_wanted seven_pid (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {7} ℚ K] : IsPrincipalIdealRing (𝓞 K)

end IsCyclotomicExtension.Rat
