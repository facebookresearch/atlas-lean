/-
# The Frobenius number of the binomial coefficients C(n, i) (Erdős Problem 435)

Erdős Problem 435: let `n ∈ ℕ` with `n ≠ p^k` for every prime `p` and `k ≥ 0`. What is the largest
integer not of the form `∑_{1 ≤ i < n} cᵢ C(n, i)` with integers `cᵢ ≥ 0`?
-/

module

public import Batteries.Util.ProofWanted
public import Mathlib.Data.Nat.Factorization.Defs
public import Mathlib.Order.Interval.Finset.Nat

@[expose] public section

namespace MathlibExt.NumberTheory.BinomialFrobeniusNumberErdosProblem435Wanted

/-!
Source: T. F. Bloom, Erdős Problems, Problem #435, https://www.erdosproblems.com/435 (status PROVED
(LEAN)). UnsolvedMath record UM-30006867 (`EP-435`), dataset ulamai/UnsolvedMath v1.8.0.

`n ≥ 1` (`n = 0` is not a prime power but the question is void for it). The answer is stated as
`IsGreatest` over the integers that are not such combinations; negative integers are never
combinations. Compared with the formal-conjectures statement `ErdosProblems/435.lean` (equivalent;
no code imported).
-/

/-- `m` is a combination `∑_{1 ≤ i < n} cᵢ C(n, i)` with nonnegative integer coefficients. -/
def IsBinomialCombination (n : ℕ) (m : ℤ) : Prop :=
  ∃ c : ℕ → ℕ, m = ∑ i ∈ Finset.Ico 1 n, (c i : ℤ) * (n.choose i : ℤ)

/-- `∑_{p ∣ n} (∑_{1 ≤ d ≤ v_p(n)} C(n, p^d)) (p - 1) - n`. -/
def binomialFrobeniusFormula (n : ℕ) : ℤ :=
  (∑ p ∈ n.primeFactors,
    (∑ d ∈ Finset.Icc 1 (n.factorization p), (n.choose (p ^ d) : ℤ)) * ((p : ℤ) - 1)) - n

/-- Erdős Problem 435: for `n ≥ 1` not a prime power, the largest integer that is not a
nonnegative integer combination of the `C(n, i)`, `1 ≤ i < n`, is
`∑_{p ∣ n} (∑_{1 ≤ d ≤ v_p(n)} C(n, p^d)) (p - 1) - n`. -/
def largestNonBinomialCombination : Prop :=
  ∀ n : ℕ, n ≠ 0 → (∀ p k : ℕ, p.Prime → n ≠ p ^ k) →
    IsGreatest {m : ℤ | ¬ IsBinomialCombination n m} (binomialFrobeniusFormula n)

/--
Resolved true: Hwang and Song proved that for `n = ∏ p^{a_p}` not a prime power the largest integer
not of the form `∑_{1 ≤ i < n} cᵢ C(n, i)` (`cᵢ ≥ 0`) is `∑_p (∑_{1 ≤ d ≤ a_p} C(n, p^d)) (p - 1) -
n`; Peake and Cambie found it independently (erdosproblems.com/435, OEIS A389479). Source: T. F.
Bloom, Erdős Problems, Problem #435, https://www.erdosproblems.com/435 (status PROVED (LEAN));
resolution: W. Hwang and K. Song, The Frobenius problem for numerical semigroups generated by
binomial coefficients, arXiv:2412.17882 (2024), largest non-representable integer ∑_p (∑_{1 ≤ d ≤
a_p} C(n, p^d))(p - 1) - n (erdosproblems.com/435), https://arxiv.org/abs/2412.17882.
-/
public theorem_wanted largestNonBinomialCombination_holds : largestNonBinomialCombination

end MathlibExt.NumberTheory.BinomialFrobeniusNumberErdosProblem435Wanted
