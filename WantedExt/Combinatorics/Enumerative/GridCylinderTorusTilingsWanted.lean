    (hn : Even n) :
    2 * torusShiftSum n m (cellF n m) σ =
      n * ∑ c ∈ m.divisors, Nat.totient c *
        (Fintype.card T ^ (n * m / Nat.lcm 2 c) +
          Fintype.card T ^ ((n - 2) * m / Nat.lcm 2 c) *
            tileFixedCount σ c ^ (2 * m / c))

/-- **Torus fixed-tiling sum for the reflection $f$, $n$ odd.** Let $n$ and $m$ be positive
integers with $n$ odd, let $T$ be a finite set of tiles, let $\sigma$ be a permutation of $T$ with
