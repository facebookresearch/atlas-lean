/-!
# The Sidon ideal (Nowik)

Statements from Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025),
Article A91.

Conventions. As in the paper, `ℕ` contains `0`. A Sidon set is the repository's
`Set.IsSidon` on `Set ℕ`, which is the paper's Definition 10 (sums `n + m` with
`n ≤ m` are distinct). For an infinite `A ⊆ ℕ`, the paper's `A(n)` (the `n`-th
element) is `Nat.nth (· ∈ A) n`, counted from `0`. The paper assumes every ideal
contains the singletons; every ideal used here is generated by a family of sets
that covers each finite set, so `generatedIdeal P` (subsets of finite unions of
sets with property `P`) is the paper's ideal generated by that family.
-/

namespace MetaMathlibExt

@[expose] public section

open Filter

/-- A set `A ⊆ ℕ` is a *weak Sidon set* (well spread) if sums `a + b` with
`a < b` in `A` are distinct: `a + b = c + d` with `a < b`, `c < d` forces
`a = c`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 11. -/
public def IsWeakSidonSet (A : Set ℕ) : Prop :=
  ∀ a ∈ A, ∀ b ∈ A, ∀ c ∈ A, ∀ d ∈ A, a < b → c < d → a + b = c + d → a = c

/-- Every Sidon set is a weak Sidon set.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definitions 10 and 11. -/
public theorem isWeakSidonSet_of_isSidon {A : Set ℕ} (h : A.IsSidon) :
    IsWeakSidonSet A := by
  intro a ha b hb c hc d hd hab hcd habcd
  rcases h a ha b hb c hc d hd habcd with ⟨h1, -⟩ | ⟨h1, h2⟩
  · exact h1
  · omega

/-- The ideal on `ℕ` generated by the sets with property `P`: all subsets of
finite unions of such sets.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 1 (ideals) and Definitions 5, 8 and 13 (ideals generated by a family). -/
public def generatedIdeal (P : Set ℕ → Prop) : Set (Set ℕ) :=
  {A | ∃ (n : ℕ) (S : Fin n → Set ℕ), (∀ j, P (S j)) ∧ A ⊆ ⋃ j, S j}

/-- A set with property `P` lies in the ideal generated by `P`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 1 (ideals). -/
public theorem mem_generatedIdeal {P : Set ℕ → Prop} {A : Set ℕ} (h : P A) :
    A ∈ generatedIdeal P :=
  ⟨1, fun _ => A, fun _ => h, fun _ hx => Set.mem_iUnion.2 ⟨0, hx⟩⟩

/-- The generated ideal is closed under subsets.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 1 (ideals, item 2). -/
public theorem generatedIdeal_of_subset {P : Set ℕ → Prop} {A B : Set ℕ} (hBA : B ⊆ A)
    (hA : A ∈ generatedIdeal P) : B ∈ generatedIdeal P := by
  obtain ⟨n, S, hS, hAS⟩ := hA
  exact ⟨n, S, hS, hBA.trans hAS⟩

/-- The generated ideal is closed under binary unions.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 1 (ideals, item 3). -/
public theorem union_mem_generatedIdeal {P : Set ℕ → Prop} {A B : Set ℕ}
    (hA : A ∈ generatedIdeal P) (hB : B ∈ generatedIdeal P) :
    A ∪ B ∈ generatedIdeal P := by
  obtain ⟨n, S, hS, hAS⟩ := hA
  obtain ⟨m, T, hT, hBT⟩ := hB
  refine ⟨n + m, Fin.append S T, fun j => ?_, ?_⟩
  · refine Fin.addCases (fun i => ?_) (fun i => ?_) j
    · simpa using hS i
    · simpa using hT i
  · rintro x (hx | hx)
    · obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hAS hx)
      exact Set.mem_iUnion.2 ⟨Fin.castAdd m j, by simpa using hj⟩
    · obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hBT hx)
      exact Set.mem_iUnion.2 ⟨Fin.natAdd n j, by simpa using hj⟩

/-- The *Sidon ideal* `Si`: the ideal generated by all Sidon sets.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 13. -/
public abbrev sidonIdeal : Set (Set ℕ) :=
  generatedIdeal Set.IsSidon

/-- An infinite set `A ⊆ ℕ` is *lacunary* if `A(n + 1) - A(n) → ∞` (gap lacunarity;
distinct from the multiplicative-growth `MetaMathlibExt.IsLacunarySet` of
`WantedExt.Combinatorics.AccessibleSetsWanted`).

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 4. -/
public def IsGapLacunarySet (A : Set ℕ) : Prop :=
  A.Infinite ∧
    Tendsto (fun n => Nat.nth (· ∈ A) (n + 1) - Nat.nth (· ∈ A) n) atTop atTop

/-- A lacunary set is infinite.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 4. -/
public theorem IsGapLacunarySet.infinite {A : Set ℕ} (h : IsGapLacunarySet A) : A.Infinite :=
  h.1

/-- An infinite set `A ⊆ ℕ` is *almost thin* if `limsup A(n) / A(n + 1) < 1`.
The ratios lie in `[0, 1]`, so this is stated equivalently as: for some
`α < 1`, eventually `A(n) / A(n + 1) ≤ α`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 7. -/
public def IsAlmostThinSet (A : Set ℕ) : Prop :=
  A.Infinite ∧ ∃ α : ℝ, α < 1 ∧
    ∀ᶠ n in atTop, (Nat.nth (· ∈ A) n : ℝ) / Nat.nth (· ∈ A) (n + 1) ≤ α

/-- An almost thin set is infinite.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 7. -/
public theorem IsAlmostThinSet.infinite {A : Set ℕ} (h : IsAlmostThinSet A) :
    A.Infinite :=
  h.1

/-- The *van der Waerden ideal* `W`: sets with a bound `n > 0` on the length of
the arithmetic progressions (with positive difference) they contain.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 9. -/
public def vanDerWaerdenIdeal : Set (Set ℕ) :=
  {A | ∃ n > 0, ∀ a r : ℕ, 0 < r → ∃ j < n, a + r * j ∉ A}

/-- The empty set lies in the van der Waerden ideal.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 9. -/
public theorem empty_mem_vanDerWaerdenIdeal : (∅ : Set ℕ) ∈ vanDerWaerdenIdeal :=
  ⟨1, one_pos, fun _ _ _ => ⟨0, one_pos, id⟩⟩

/-- The positive difference set `D(Z) = Z - Z = {a - b : a > b, a, b ∈ Z}`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 1 (notation `A - B` and `D(A)`). -/
public def positiveDifferences (Z : Set ℕ) : Set ℕ :=
  {d | ∃ a ∈ Z, ∃ b ∈ Z, b < a ∧ d = a - b}

/-- The ideal `Dfin`: sets `A` for which some `n` has `D(Z) ⊈ A` for every
`n`-element set `Z ⊆ ℕ`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 3. -/
public def dFinIdeal : Set (Set ℕ) :=
  {A | ∃ n : ℕ, ∀ Z : Finset ℕ, Z.card = n → ¬ positiveDifferences (Z : Set ℕ) ⊆ A}

/-- The empty set lies in `Dfin` (witness `n = 2`).

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Definition 3. -/
public theorem empty_mem_dFinIdeal : (∅ : Set ℕ) ∈ dFinIdeal := by
  refine ⟨2, fun Z hZ hsub => ?_⟩
  obtain ⟨a, b, hab, rfl⟩ := Finset.card_eq_two.1 hZ
  rcases Nat.lt_or_gt_of_ne hab with h | h
  · exact hsub ⟨b, by simp, a, by simp, h, rfl⟩
  · exact hsub ⟨a, by simp, b, by simp, h, rfl⟩

/-- `Block(n, C, M, K) = {M l + C 2^k : k = 0, …, n - 1; l = 1, …, K}`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 3 (definition of `Block` before Lemma 2). -/
public def sidonBlock (n C M K : ℕ) : Set ℕ :=
  {x | ∃ k < n, ∃ l, 1 ≤ l ∧ l ≤ K ∧ x = M * l + C * 2 ^ k}

/-- `Block(1, C, M, 1) = {M + C}`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Section 3 (definition of `Block` before Lemma 2). -/
public theorem sidonBlock_one_one (C M : ℕ) : sidonBlock 1 C M 1 = {M + C} := by
  ext x
  change (∃ k < 1, ∃ l, 1 ≤ l ∧ l ≤ 1 ∧ x = M * l + C * 2 ^ k) ↔ x = M + C
  constructor
  · rintro ⟨k, hk, l, hl1, hl2, rfl⟩
    obtain rfl : k = 0 := by omega
    obtain rfl : l = 1 := by omega
    simp
  · rintro rfl
    exact ⟨0, by omega, 1, le_rfl, le_rfl, by simp⟩

/-- Theorem 1: every weak Sidon set can be partitioned into two Sidon sets.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 1 (`integers-2025-A91-thm-1`). -/
public theorem_wanted exists_partition_isSidon_of_isWeakSidonSet {A : Set ℕ}
    (hA : IsWeakSidonSet A) :
    ∃ B C : Set ℕ, B ∪ C = A ∧ Disjoint B C ∧ B.IsSidon ∧ C.IsSidon

/-- Corollary 1: the ideal generated by weak Sidon sets equals the Sidon ideal.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Corollary 1 (`integers-2025-A91-cor-1`). -/
public theorem_wanted generatedIdeal_isWeakSidonSet_eq_sidonIdeal :
    generatedIdeal IsWeakSidonSet = sidonIdeal

/-- Corollary 2: the Sidon ideal is an `F_σ` subset of the Cantor space: under
the identification of `A ⊆ ℕ` with its indicator in `ℕ → Bool` (product
topology), the Sidon ideal is a countable union of closed sets.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Corollary 2 (`integers-2025-A91-cor-2`). -/
public theorem_wanted sidonIdeal_isFSigma :
    ∃ F : ℕ → Set (ℕ → Bool), (∀ k, IsClosed (F k)) ∧
      {f : ℕ → Bool | {n | f n = true} ∈ sidonIdeal} = ⋃ k, F k

/-- Lemma 1: a set `A ⊆ [1, ∞)` with `2 A(n) ≤ A(n + 1)` for all `n` is a
Sidon set. The hypothesis forces `A` to be infinite or empty, so the paper's
standing assumption that `A` is infinite is not added.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Lemma 1 (`integers-2025-A91-lem-1`). -/
public theorem_wanted isSidon_of_two_mul_nth_le {A : Set ℕ} (h0 : 0 ∉ A)
    (h : ∀ n, 2 * Nat.nth (· ∈ A) n ≤ Nat.nth (· ∈ A) (n + 1)) : A.IsSidon

/-- Theorem 2: the Sidon ideal is contained in the lacunary ideal `Lac`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 2 (`integers-2025-A91-thm-2`). -/
public theorem_wanted sidonIdeal_subset_lacunaryIdeal :
    sidonIdeal ⊆ generatedIdeal IsGapLacunarySet

/-- Theorem 3, item 1 (Mian–Chowla, as quoted): some Sidon set `A` satisfies
`|[1, n] ∩ A| > c n^{1/3}` for all `n ≥ 1`, for some `c > 0`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 3 (`integers-2025-A91-thm-3`), item 1, quoting A. M. Mian and S. Chowla,
*On the B₂ sequences of Sidon*, Proc. Nat. Acad. Sci. India Sect. A 14 (1944). -/
public theorem_wanted exists_isSidon_card_gt_cbrt :
    ∃ A : Set ℕ, A.IsSidon ∧ ∃ c : ℝ, 0 < c ∧
      ∀ n : ℕ, 1 ≤ n → c * (n : ℝ) ^ ((1 : ℝ) / 3) < (A ∩ Set.Icc 1 n).ncard

/-- Theorem 3, item 2 (Ajtai–Komlós–Szemerédi, as quoted): some Sidon set `A`
satisfies `|[1, n] ∩ A| > c (n log n)^{1/3}` for all `n ≥ 1`, for some `c > 0`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 3 (`integers-2025-A91-thm-3`), item 2, quoting M. Ajtai, J. Komlós and
E. Szemerédi, *A dense infinite Sidon sequence*, European J. Combin. 2 (1981). -/
public theorem_wanted exists_isSidon_card_gt_cbrt_mul_log :
    ∃ A : Set ℕ, A.IsSidon ∧ ∃ c : ℝ, 0 < c ∧
      ∀ n : ℕ, 1 ≤ n →
        c * ((n : ℝ) * Real.log n) ^ ((1 : ℝ) / 3) < (A ∩ Set.Icc 1 n).ncard

/-- Theorem 3, item 3 (Ruzsa, as quoted): some Sidon set `A` satisfies
`|[1, n] ∩ A| > n^{√2 - 1 - o(1)}`: for every `ε > 0`, eventually
`|[1, n] ∩ A| > n^{√2 - 1 - ε}`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 3 (`integers-2025-A91-thm-3`), item 3, quoting I. Z. Ruzsa, *An infinite
Sidon sequence*, J. Number Theory 68 (1998). -/
public theorem_wanted exists_isSidon_card_gt_rpow_sqrt_two_sub_one :
    ∃ A : Set ℕ, A.IsSidon ∧ ∀ ε : ℝ, 0 < ε →
      ∀ᶠ n : ℕ in atTop, (n : ℝ) ^ (Real.sqrt 2 - 1 - ε) < (A ∩ Set.Icc 1 n).ncard

/-- Proposition 1: some Sidon set is not in the almost thin sets ideal `A`.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Proposition 1 (`integers-2025-A91-prop-1`). -/
public theorem_wanted exists_isSidon_not_mem_almostThinIdeal :
    ∃ A : Set ℕ, A.IsSidon ∧ A ∉ generatedIdeal IsAlmostThinSet

/-- Theorem 4: every set in the almost thin sets ideal `A` is in the Sidon
ideal.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 4 (`integers-2025-A91-thm-4`). -/
public theorem_wanted almostThinIdeal_subset_sidonIdeal :
    generatedIdeal IsAlmostThinSet ⊆ sidonIdeal

/-- Lemma 3: for `n ≥ 1` and `C ≥ 1`, `Block(n, C, C 2^n + 1, (n - 1) (n choose 2) + 1)`
is not covered by `n - 1` Sidon sets.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Lemma 3 (`integers-2025-A91-lem-3`). -/
public theorem_wanted not_sidonBlock_subset_iUnion_isSidon {n C : ℕ} (hn : 0 < n)
    (hC : 0 < C) :
    ¬ ∃ S : Fin (n - 1) → Set ℕ, (∀ j, (S j).IsSidon) ∧
      sidonBlock n C (C * 2 ^ n + 1) ((n - 1) * n.choose 2 + 1) ⊆ ⋃ j, S j

/-- Theorem 5: some set lies in `W ∩ Lac ∩ Dfin` but not in the Sidon ideal.

Source: Andrzej Nowik, *On the Sidon Ideal*, INTEGERS 25 (2025), Article A91,
Theorem 5 (`integers-2025-A91-thm-5`). -/
public theorem_wanted exists_mem_vanDerWaerden_lacunary_dFin_not_mem_sidonIdeal :
    ∃ A : Set ℕ, A ∈ vanDerWaerdenIdeal ∧ A ∈ generatedIdeal IsGapLacunarySet ∧
      A ∈ dFinIdeal ∧ A ∉ sidonIdeal

end

end MetaMathlibExt
