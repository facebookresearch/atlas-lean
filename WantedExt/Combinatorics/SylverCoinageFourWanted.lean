/-
# Sylver Coinage after 4 has been chosen

Statements from Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick,
*On Winning Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024),
Article G2.

In Sylver Coinage two players alternately name positive integers; a named number must not be
a sum of (repetitions of) previously named numbers, and the player who names `1` loses. A
position is the set `M` of numbers named so far; its legal moves `L(M)` are the positive
integers outside the additive submonoid generated by `M`. A P-position is one in which the
player to move loses with best play, an N-position one in which the player to move wins.
-/
module

import Batteries.Util.ProofWanted
public import Mathlib.Algebra.Ring.Parity
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.Data.Nat.ModEq
public import Mathlib.Data.Nat.Prime.Defs

namespace MetaMathlibExt

@[expose] public section

/-- **Legal moves in Sylver Coinage.** For a set $M$ of natural numbers (a position of Sylver
Coinage), the set $L(M)$ of legal moves consists of the natural numbers that are not finite sums
of elements of $M$, repetitions allowed, i.e. the natural numbers outside the additive submonoid
of $\mathbb{N}$ generated by $M$. Since $0$ is the empty sum, every legal move is positive.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (rules of Sylver Coinage, `L(M)`). -/
public def sylverLegalMoves (M : Set ℕ) : Set ℕ :=
  {q | q ∉ AddSubmonoid.closure M}

mutual

/-- **P-positions of Sylver Coinage.** A set $M$ of natural numbers is a P-position of Sylver
Coinage when $1 \notin M$ and, for every legal move $q$ of $M$, the position $M \cup \{q\}$ is
an N-position. P-positions and N-positions are defined together, as a mutual inductive
definition. In particular a position whose only legal move is $1$ is a P-position (the player to
move must name $1$ and loses).

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public inductive IsSylverPPosition : Set ℕ → Prop
  | intro {M : Set ℕ} (one_notMem : 1 ∉ M)
      (forall_move : ∀ q ∈ sylverLegalMoves M, IsSylverNPosition (insert q M)) :
      IsSylverPPosition M

/-- **N-positions of Sylver Coinage.** A position $M$ of Sylver Coinage is an N-position (the
player to move wins) when either $1 \in M$, so that the previous player named $1$ and lost, or
some legal move $q$ of $M$ leads to a P-position $M \cup \{q\}$. N-positions and P-positions are
defined together inductively by these rules.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public inductive IsSylverNPosition : Set ℕ → Prop
  | one_mem {M : Set ℕ} (h : 1 ∈ M) : IsSylverNPosition M
  | move {M : Set ℕ} {q : ℕ} (hq : q ∈ sylverLegalMoves M)
      (h : IsSylverPPosition (insert q M)) : IsSylverNPosition M

end

/-- **Zero is never a legal move.** For every set $M$ of natural numbers, $0$ is not a legal move
of the Sylver Coinage position $M$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (rules of Sylver Coinage, `L(M)`). -/
public theorem zero_notMem_sylverLegalMoves (M : Set ℕ) : 0 ∉ sylverLegalMoves M := by
  simp [sylverLegalMoves]

/-- **The position $\{2, 3\}$ is a P-position.** In Sylver Coinage, the position
$\{2, 3\}$ is a P-position: its only legal move is $1$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public theorem isSylverPPosition_two_three : IsSylverPPosition {2, 3} := by
  refine .intro (by simp) fun q hq => ?_
  have hq1 : q = 1 := by
    by_contra hne
    apply hq
    have h2 : (2 : ℕ) ∈ AddSubmonoid.closure ({2, 3} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    have h3 : (3 : ℕ) ∈ AddSubmonoid.closure ({2, 3} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    rcases Nat.even_or_odd q with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · have := AddSubmonoid.nsmul_mem _ h2 k
      rwa [smul_eq_mul, show k * 2 = k + k by omega] at this
    · obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      have := AddSubmonoid.add_mem _ (AddSubmonoid.nsmul_mem _ h2 j) h3
      rw [smul_eq_mul] at this
      rwa [show 2 * (j + 1) + 1 = j * 2 + 3 by omega]
  subst hq1
  exact .one_mem (Set.mem_insert 1 _)

/-- **Opening with 2 loses.** The position $\{2\}$ of Sylver Coinage is an N-position: the player
to move wins by naming $3$, which leaves the P-position $\{2, 3\}$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public theorem isSylverNPosition_two : IsSylverNPosition {2} := by
  refine .move (q := 3) ?_ ?_
  · simp only [sylverLegalMoves, Set.mem_ofPred_eq, AddSubmonoid.mem_closure_singleton,
      smul_eq_mul, not_exists]
    omega
  · rw [Set.pair_comm]
    exact isSylverPPosition_two_three

/-- **Hutchings' theorem.** For every prime $p > 3$, the position $\{p\}$ of Sylver Coinage is a
P-position: a first player who opens with $p$ wins.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Theorem 1 (`integers-2024-G2-thm-1`). -/
public theorem_wanted isSylverPPosition_prime_opening {p : ℕ} (hp : p.Prime) (h3 : 3 < p) :
    IsSylverPPosition {p}

/-- **Ends of a Sylver Coinage position.** Let $M$ be a position of Sylver Coinage with set of
legal moves $L(M)$. A natural number $x$ is an end of $M$ if $x \in L(M)$ and every
$y \in L(M)$ with $y \ne x$ is still a legal move of the position $M \cup \{x\}$; that is,
naming $x$ eliminates no other legal move.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Definition 2, part 6 (ends and enders). -/
public def IsSylverEnd (M : Set ℕ) (x : ℕ) : Prop :=
  x ∈ sylverLegalMoves M ∧ ∀ y ∈ sylverLegalMoves M, y ≠ x → y ∈ sylverLegalMoves (insert x M)

/-- **The largest legal move is an end.** Let $M$ be a position of Sylver Coinage whose set of
legal moves $L(M)$ has a greatest element $F$. Then $F$ is an end of $M$.

Every other legal move $y$ is smaller than $F$, so a way of writing $y$ as a sum of elements of
$M \cup \{F\}$ cannot use $F$; hence naming $F$ eliminates no legal move other than $F$ itself.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Definition 2, part 6 (ends and enders). -/
public theorem isSylverEnd_of_isGreatest {M : Set ℕ} {F : ℕ}
    (hF : IsGreatest (sylverLegalMoves M) F) : IsSylverEnd M F := by
  refine ⟨hF.1, fun y hy hyF => ?_⟩
  have hlt : y < F := lt_of_le_of_ne (hF.2 hy) hyF
  intro hmem
  rw [Set.insert_eq, AddSubmonoid.closure_union, AddSubmonoid.mem_sup] at hmem
  obtain ⟨u, hu, v, hv, huv⟩ := hmem
  obtain ⟨n, rfl⟩ := AddSubmonoid.mem_closure_singleton.mp hu
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact hy (by rw [← huv]; simpa using hv)
  · have : F ≤ n • F := by
      rw [smul_eq_mul]
      exact Nat.le_mul_of_pos_left F hn
    omega

/-- **In an ender, every smaller move eliminates the largest legal move.** Let $M$ be a set of
natural numbers whose set of legal moves $L(M)$ has a greatest element $F > 1$, and suppose that
$F$ is the only end of $M$ (so $M$ is an ender). Then for every legal move $x$ of $M$ with
$x < F$, the number $F$ is not a legal move of $M \cup \{x\}$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 1 (`integers-2024-G2-prop-1`). -/
public theorem_wanted sylverEnder_eliminates_largest_move {M : Set ℕ} {F : ℕ}
    (hF : IsGreatest (sylverLegalMoves M) F) (hender : ∀ x, IsSylverEnd M x → x = F)
    (hF1 : 1 < F) :
    ∀ x ∈ sylverLegalMoves M, x < F → F ∉ sylverLegalMoves (insert x M)

/-- **Enders with largest legal move above 1 are N-positions.** Let $M$ be a position of Sylver
Coinage whose set of legal moves $L(M)$ has a greatest element $F$ with $F > 1$. If every end of
$M$ equals $F$ (that is, $M$ is an ender), then $M$ is an N-position.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 2 (`integers-2024-G2-prop-2`). -/
public theorem_wanted isSylverNPosition_of_ender {M : Set ℕ} {F : ℕ}
    (hF : IsGreatest (sylverLegalMoves M) F) (hender : ∀ x, IsSylverEnd M x → x = F)
    (hF1 : 1 < F) :
    IsSylverNPosition M

/-- **Two-generated numerical semigroups are symmetric.** Let $a$, $b$ and $F$ be natural numbers
and let $S = \langle a, b \rangle$ be the additive submonoid of $\mathbb{N}$ generated by $a$ and
$b$. If $F \notin S$ and every natural number $n > F$ lies in $S$ (so $F$ is the Frobenius number
of $S$), then $x \in S \iff F - x \notin S$ for every natural number $x \le F$.

The hypotheses on $F$ force $\gcd(a, b) = 1$ and $a, b \ge 2$, so these are exactly the
numerical semigroups of embedding dimension $2$ other than $\mathbb{N}$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 3, part 1 (`integers-2024-G2-prop-3`). -/
public theorem_wanted numericalSemigroup_two_generated_symmetric {a b F : ℕ}
    (hF : F ∉ AddSubmonoid.closure ({a, b} : Set ℕ))
    (hF_max : ∀ n, F < n → n ∈ AddSubmonoid.closure ({a, b} : Set ℕ)) :
    ∀ x ≤ F, x ∈ AddSubmonoid.closure ({a, b} : Set ℕ) ↔
      F - x ∉ AddSubmonoid.closure ({a, b} : Set ℕ)

/-- **Pseudo-symmetric semigroups of multiplicity 4 and embedding dimension 3.** Write
$\langle A \rangle$ for the additive submonoid of $\mathbb{N}$ generated by a set $A$. Let $a$, $b$
and $F$ be natural numbers with $4 < a < b$, $a \notin \langle 4 \rangle$ and
$b \notin \langle 4, a \rangle$ (so $\{4, a, b\}$ is the minimal generating set of
$S = \langle 4, a, b \rangle$), and suppose that $F \notin S$ and that every natural number $n > F$
lies in $S$. Then $S$ is pseudo-symmetric, meaning that $F$ is even and $x \in S \iff
F - x \notin S$ for every natural number $x \le F$ with $x \ne F / 2$, if and only if $a$ is odd
and $b = a + 2$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 3, part 2 (`integers-2024-G2-prop-3`). -/
public theorem_wanted numericalSemigroup_four_pseudoSymmetric_iff {a b F : ℕ} (ha : 4 < a)
    (hab : a < b) (ha_min : a ∉ AddSubmonoid.closure ({4} : Set ℕ))
    (hb_min : b ∉ AddSubmonoid.closure ({4, a} : Set ℕ))
    (hF : F ∉ AddSubmonoid.closure ({4, a, b} : Set ℕ))
    (hF_max : ∀ n, F < n → n ∈ AddSubmonoid.closure ({4, a, b} : Set ℕ)) :
    (Even F ∧ ∀ x ≤ F, x ≠ F / 2 →
        (x ∈ AddSubmonoid.closure ({4, a, b} : Set ℕ) ↔
          F - x ∉ AddSubmonoid.closure ({4, a, b} : Set ℕ))) ↔
      Odd a ∧ b = a + 2

/-- **A canonical position is the minimal generating set of its semigroup.** Let $M$ be a finite
set of natural numbers whose set of legal moves $L(M)$ is finite, and suppose that removing any
element changes the legal moves: $L(M \setminus \{a\}) \ne L(M)$ for every $a \in M$. Let $S$ be
the additive submonoid of $\mathbb{N}$ generated by $M$. Then $M$ is the set of nonzero elements
$s \in S$ such that whenever $s = a + b$ with $a, b \in S$, one of $a$ and $b$ is $0$; that is,
$M$ is the minimal system of generators of $S$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 4, part 1 (`integers-2024-G2-prop-4`). -/
public theorem_wanted sylverPosition_canonical_eq_minimalGenerators (M : Finset ℕ)
    (hcanon : ∀ a ∈ M, sylverLegalMoves ((M.erase a : Finset ℕ) : Set ℕ) ≠
      sylverLegalMoves (M : Set ℕ))
    (hfin : (sylverLegalMoves (M : Set ℕ)).Finite) :
    (M : Set ℕ) = {s | s ∈ AddSubmonoid.closure (M : Set ℕ) ∧ s ≠ 0 ∧
      ∀ a ∈ AddSubmonoid.closure (M : Set ℕ), ∀ b ∈ AddSubmonoid.closure (M : Set ℕ),
        a + b = s → a = 0 ∨ b = 0}

/-- **Even replies to 4 and an odd number at least 5 lose.** Let $x \ge 5$ be an odd natural
number. For every even legal move $b$ of the position $\{4, x\}$, the position $\{4, x, b\}$ is
an N-position.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 5 (`integers-2024-G2-prop-5`). -/
public theorem_wanted isSylverNPosition_four_odd_even {x b : ℕ} (hx : 5 ≤ x) (hxo : Odd x)
    (hb : Even b) (hbL : b ∈ sylverLegalMoves {4, x}) :
    IsSylverNPosition {4, x, b}

/-- **Sicherman's claim on replies to 4 and an odd number.** For every odd natural number
$x \ge 5$ there is exactly one legal move $q$ of the position $\{4, x\}$ such that $\{4, x, q\}$
is a P-position, and every legal move $q$ of $\{4, x\}$ with $\{4, x, q\}$ a P-position
satisfies $q \equiv x - 2 \pmod 4$.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 6 (`integers-2024-G2-prop-6`). -/
public theorem_wanted existsUnique_sylver_response_four_odd {x : ℕ} (hx : 5 ≤ x) (hxo : Odd x) :
    (∃! q, q ∈ sylverLegalMoves {4, x} ∧ IsSylverPPosition {4, x, q}) ∧
      ∀ q ∈ sylverLegalMoves {4, x}, IsSylverPPosition {4, x, q} → q ≡ x - 2 [MOD 4]

/-- **Odd numbers above 3 have a unique odd partner after 4.** For every odd natural number
$q > 3$ there is exactly one odd natural number $x$ such that $\{4, x\}$ is an N-position and
$\{4, x, q\}$ is a P-position.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 7 (`integers-2024-G2-prop-7`). -/
public theorem_wanted existsUnique_sylver_four_odd_partner {q : ℕ} (hq : 3 < q) (hqo : Odd q) :
    ∃! x, Odd x ∧ IsSylverNPosition {4, x} ∧ IsSylverPPosition {4, x, q}

/-- **Unique odd partner after 4.** Let $q > 3$ be an odd natural number. Then $\{4, q\}$ is an
N-position of Sylver Coinage, and there is a unique odd natural number $x_q$ such that
$\{4, x_q\}$ is an N-position and $\{4, q, x_q\}$ is a P-position.

When $q < x_q$, the pair $(q, x_q)$ is a 4-pair.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Corollary 1 (`integers-2024-G2-cor-1`). -/
public theorem_wanted sylver_four_pair_existsUnique {q : ℕ} (hq : 3 < q) (hqo : Odd q) :
    IsSylverNPosition {4, q} ∧
      ∃! x, Odd x ∧ IsSylverNPosition {4, x} ∧ IsSylverPPosition {4, q, x}

/-- **Conway's bounds for 4-pairs.** Let $q$ and $x$ be odd natural numbers with $7 < q < x$ such
that $\{4, x\}$ is an N-position and $\{4, x, q\}$ is a P-position of Sylver Coinage. Then
$2q < x < 3q$.

By the characterization of Proposition 7, such pairs $(q, x)$ are the 4-pairs of the source.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Theorem 4 (`integers-2024-G2-thm-4`). -/
public theorem_wanted sylver_four_pair_bounds {q x : ℕ} (hqo : Odd q) (hxo : Odd x) (hq : 7 < q)
    (hqx : q < x) (hN : IsSylverNPosition {4, x}) (hP : IsSylverPPosition {4, x, q}) :
    2 * q < x ∧ x < 3 * q

/-- **Four-element P-positions containing 4.** Let $x > 1$ be a natural number. If
$x \equiv 1 \pmod 4$, then $\{4, x, x + 2, 6\}$ is a P-position; if $x \equiv 7 \pmod 8$, then
$\{4, x, x + 2, 10\}$ is a P-position; if $x \equiv 5 \pmod 8$, then $\{4, x, x + 6, 10\}$ is
a P-position; and if $x \equiv 1 \pmod 8$, then $\{4, x, x + 6, 14\}$ is a P-position.

In each case $x$ is odd. The analogous claim that $\{4, x, x - 2, 14\}$ is a P-position for
$x \equiv 5 \pmod 8$ is false: for $x = 13$, $\{4, 11, 13, 14\}$ is an N-position, since naming
$5$ wins.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 8 (`integers-2024-G2-prop-8`). -/
public theorem_wanted isSylverPPosition_four_odd_pair_even {x : ℕ} (hx : 1 < x) :
    (x % 4 = 1 → IsSylverPPosition {4, x, x + 2, 6}) ∧
      (x % 8 = 7 → IsSylverPPosition {4, x, x + 2, 10}) ∧
      (x % 8 = 5 → IsSylverPPosition {4, x, x + 6, 10}) ∧
      (x % 8 = 1 → IsSylverPPosition {4, x, x + 6, 14})

end

end MetaMathlibExt
