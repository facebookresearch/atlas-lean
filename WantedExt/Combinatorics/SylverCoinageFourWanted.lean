/-
# Sylver Coinage after 4 has been chosen

Statements from Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick,
*On Winning Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024),
Article G2.

In Sylver Coinage two players alternately name positive integers; a named number must not be
a sum of (repetitions of) previously named numbers, and the player who names `1` loses. A
position is the set `M` of numbers named so far; its legal moves `L(M)` are the positive
integers outside the additive submonoid generated by `M`. A P-position is one in which the
player to move loses with best play, an N-position one in which the player to move wins.
-/
module

import Batteries.Util.ProofWanted
public import Mathlib.Algebra.Ring.Parity
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.Data.Nat.ModEq
public import Mathlib.Data.Nat.Prime.Defs

namespace MetaMathlibExt

@[expose] public section

/-- The legal moves `L(M)` of the Sylver Coinage position `M`: the natural numbers that are
not sums of elements of `M`. Since `0` is the empty sum, every legal move is positive.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (rules of Sylver Coinage, `L(M)`). -/
public def sylverLegalMoves (M : Set ℕ) : Set ℕ :=
  {q | q ∉ AddSubmonoid.closure M}

mutual

/-- `M` is a P-position of Sylver Coinage: `1` has not been named, and every legal move leads
to an N-position. In particular a position whose only legal move is `1` is a P-position (the
player to move must name `1` and loses).

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public inductive IsSylverPPosition : Set ℕ → Prop
  | intro {M : Set ℕ} (one_notMem : 1 ∉ M)
      (forall_move : ∀ q ∈ sylverLegalMoves M, IsSylverNPosition (insert q M)) :
      IsSylverPPosition M

/-- `M` is an N-position of Sylver Coinage: either `1` has already been named (the previous
player lost), or some legal move leads to a P-position.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public inductive IsSylverNPosition : Set ℕ → Prop
  | one_mem {M : Set ℕ} (h : 1 ∈ M) : IsSylverNPosition M
  | move {M : Set ℕ} {q : ℕ} (hq : q ∈ sylverLegalMoves M)
      (h : IsSylverPPosition (insert q M)) : IsSylverNPosition M

end

/-- `0` is never a legal move.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (rules of Sylver Coinage, `L(M)`). -/
public theorem zero_notMem_sylverLegalMoves (M : Set ℕ) : 0 ∉ sylverLegalMoves M := by
  simp [sylverLegalMoves]

/-- `{2, 3}` is a P-position: its only legal move is `1`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public theorem isSylverPPosition_two_three : IsSylverPPosition {2, 3} := by
  refine .intro (by simp) fun q hq => ?_
  have hq1 : q = 1 := by
    by_contra hne
    apply hq
    have h2 : (2 : ℕ) ∈ AddSubmonoid.closure ({2, 3} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    have h3 : (3 : ℕ) ∈ AddSubmonoid.closure ({2, 3} : Set ℕ) :=
      AddSubmonoid.subset_closure (by simp)
    rcases Nat.even_or_odd q with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · have := AddSubmonoid.nsmul_mem _ h2 k
      rwa [smul_eq_mul, show k * 2 = k + k by omega] at this
    · obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      have := AddSubmonoid.add_mem _ (AddSubmonoid.nsmul_mem _ h2 j) h3
      rw [smul_eq_mul] at this
      rwa [show 2 * (j + 1) + 1 = j * 2 + 3 by omega]
  subst hq1
  exact .one_mem (Set.mem_insert 1 _)

/-- `{2}` is an N-position: naming `3` leaves the P-position `{2, 3}`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Section 1 (P- and N-positions). -/
public theorem isSylverNPosition_two : IsSylverNPosition {2} := by
  refine .move (q := 3) ?_ ?_
  · simp only [sylverLegalMoves, Set.mem_ofPred_eq, AddSubmonoid.mem_closure_singleton,
      smul_eq_mul, not_exists]
    omega
  · rw [Set.pair_comm]
    exact isSylverPPosition_two_three

/-- Hutchings' theorem: if the first player opens with a prime `p > 3`, the position `{p}` is
a P-position.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Theorem 1 (`integers-2024-G2-thm-1`). -/
public theorem_wanted isSylverPPosition_prime_opening {p : ℕ} (hp : p.Prime) (h3 : 3 < p) :
    IsSylverPPosition {p}

/-- `x` is an end of the position `M`: a legal move whose choice eliminates no other legal move,
i.e. every other element of `L(M)` stays legal after `x` is named.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Definition 2, part 6 (ends and enders). -/
public def IsSylverEnd (M : Set ℕ) (x : ℕ) : Prop :=
  x ∈ sylverLegalMoves M ∧ ∀ y ∈ sylverLegalMoves M, y ≠ x → y ∈ sylverLegalMoves (insert x M)

/-- The largest legal move `F(M)` of a finite position is always an end: naming it only removes
numbers larger than `F(M)`. A position is an ender when `F(M)` is its only end.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Definition 2, part 6 (ends and enders). -/
public theorem isSylverEnd_of_isGreatest {M : Set ℕ} {F : ℕ}
    (hF : IsGreatest (sylverLegalMoves M) F) : IsSylverEnd M F := by
  refine ⟨hF.1, fun y hy hyF => ?_⟩
  have hlt : y < F := lt_of_le_of_ne (hF.2 hy) hyF
  intro hmem
  rw [Set.insert_eq, AddSubmonoid.closure_union, AddSubmonoid.mem_sup] at hmem
  obtain ⟨u, hu, v, hv, huv⟩ := hmem
  obtain ⟨n, rfl⟩ := AddSubmonoid.mem_closure_singleton.mp hu
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact hy (by rw [← huv]; simpa using hv)
  · have : F ≤ n • F := by
      rw [smul_eq_mul]
      exact Nat.le_mul_of_pos_left F hn
    omega

/-- In an ender `M` (a finite position whose only end is its largest legal move `F(M)`) with
`F(M) > 1`, every legal move below `F(M)` eliminates `F(M)`. `F(M)` is given as the greatest
element `F` of `L(M)`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 1 (`integers-2024-G2-prop-1`). -/
public theorem_wanted sylverEnder_eliminates_largest_move {M : Set ℕ} {F : ℕ}
    (hF : IsGreatest (sylverLegalMoves M) F) (hender : ∀ x, IsSylverEnd M x → x = F)
    (hF1 : 1 < F) :
    ∀ x ∈ sylverLegalMoves M, x < F → F ∉ sylverLegalMoves (insert x M)

/-- An ender `M` with `F(M) > 1` is an N-position. `F(M)` is given as the greatest element `F`
of `L(M)`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 2 (`integers-2024-G2-prop-2`). -/
public theorem_wanted isSylverNPosition_of_ender {M : Set ℕ} {F : ℕ}
    (hF : IsGreatest (sylverLegalMoves M) F) (hender : ∀ x, IsSylverEnd M x → x = F)
    (hF1 : 1 < F) :
    IsSylverNPosition M

/-- Two-generated numerical semigroups are symmetric: if `S = ⟨a, b⟩` has a largest
non-element `F` (its Frobenius number), then `x ∈ S ↔ F - x ∉ S` for every `0 ≤ x ≤ F`.
The hypotheses on `F` force `gcd(a, b) = 1` and `a, b ≥ 2`, so these are exactly the
numerical semigroups of embedding dimension `2` other than `ℕ`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 3, part 1 (`integers-2024-G2-prop-3`). -/
public theorem_wanted numericalSemigroup_two_generated_symmetric {a b F : ℕ}
    (hF : F ∉ AddSubmonoid.closure ({a, b} : Set ℕ))
    (hF_max : ∀ n, F < n → n ∈ AddSubmonoid.closure ({a, b} : Set ℕ)) :
    ∀ x ≤ F, x ∈ AddSubmonoid.closure ({a, b} : Set ℕ) ↔
      F - x ∉ AddSubmonoid.closure ({a, b} : Set ℕ)

/-- Numerical semigroups of multiplicity `4` and embedding dimension `3`: let
`S = ⟨4, a, b⟩` with `4 < a < b`, `a ∉ ⟨4⟩`, `b ∉ ⟨4, a⟩` (so `{4, a, b}` is the minimal
generating set), and let `F` be the largest non-element of `S` (its existence makes `ℕ \ S`
finite). Then `S` is pseudo-symmetric
(`F` even and `x ∈ S ↔ F - x ∉ S` for every `0 ≤ x ≤ F` with `x ≠ F / 2`) if and only if
`S = ⟨4, k, k + 2⟩` with `k` odd, i.e. `a` is odd and `b = a + 2` (then `k = a > 3`).

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 3, part 2 (`integers-2024-G2-prop-3`). -/
public theorem_wanted numericalSemigroup_four_pseudoSymmetric_iff {a b F : ℕ} (ha : 4 < a)
    (hab : a < b) (ha_min : a ∉ AddSubmonoid.closure ({4} : Set ℕ))
    (hb_min : b ∉ AddSubmonoid.closure ({4, a} : Set ℕ))
    (hF : F ∉ AddSubmonoid.closure ({4, a, b} : Set ℕ))
    (hF_max : ∀ n, F < n → n ∈ AddSubmonoid.closure ({4, a, b} : Set ℕ)) :
    (Even F ∧ ∀ x ≤ F, x ≠ F / 2 →
        (x ∈ AddSubmonoid.closure ({4, a, b} : Set ℕ) ↔
          F - x ∉ AddSubmonoid.closure ({4, a, b} : Set ℕ))) ↔
      Odd a ∧ b = a + 2

/-- Proposition 4, part 1: for a finite position `M` in canonical form (no element is
superfluous: removing any `a ∈ M` changes `L(M)`), the minimal system of generators of the
numerical semigroup `S(M) = (ℕ ∪ {0}) \ L(M)` (the additive closure of `M`) is `M`, i.e. `M` is
the set of nonzero elements of `S(M)` that are not a sum of two nonzero elements of `S(M)`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 4, part 1 (`integers-2024-G2-prop-4`). -/
public theorem_wanted sylverPosition_canonical_eq_minimalGenerators (M : Finset ℕ)
    (hcanon : ∀ a ∈ M, sylverLegalMoves ((M.erase a : Finset ℕ) : Set ℕ) ≠
      sylverLegalMoves (M : Set ℕ))
    (hfin : (sylverLegalMoves (M : Set ℕ)).Finite) :
    (M : Set ℕ) = {s | s ∈ AddSubmonoid.closure (M : Set ℕ) ∧ s ≠ 0 ∧
      ∀ a ∈ AddSubmonoid.closure (M : Set ℕ), ∀ b ∈ AddSubmonoid.closure (M : Set ℕ),
        a + b = s → a = 0 ∨ b = 0}

/-- After `{4, x}` with `x ≥ 5` odd, every even legal move `b` leaves an N-position
`{4, x, b}`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 5 (`integers-2024-G2-prop-5`). -/
public theorem_wanted isSylverNPosition_four_odd_even {x b : ℕ} (hx : 5 ≤ x) (hxo : Odd x)
    (hb : Even b) (hbL : b ∈ sylverLegalMoves {4, x}) :
    IsSylverNPosition {4, x, b}

/-- Sicherman's claim: for odd `x ≥ 5` there is exactly one legal move `q` with `{4, x, q}` a
P-position, and every such `q` satisfies `q ≡ x - 2 (mod 4)`.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 6 (`integers-2024-G2-prop-6`). -/
public theorem_wanted existsUnique_sylver_response_four_odd {x : ℕ} (hx : 5 ≤ x) (hxo : Odd x) :
    (∃! q, q ∈ sylverLegalMoves {4, x} ∧ IsSylverPPosition {4, x, q}) ∧
      ∀ q ∈ sylverLegalMoves {4, x}, IsSylverPPosition {4, x, q} → q ≡ x - 2 [MOD 4]

/-- Every odd `q > 3` is the winning reply to exactly one N-position `{4, x}` with `x` odd.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 7 (`integers-2024-G2-prop-7`). -/
public theorem_wanted existsUnique_sylver_four_odd_partner {q : ℕ} (hq : 3 < q) (hqo : Odd q) :
    ∃! x, Odd x ∧ IsSylverNPosition {4, x} ∧ IsSylverPPosition {4, x, q}

/-- For odd `q > 3`, `{4, q}` is an N-position and there is a unique odd `x_q` such that
`{4, x_q}` is an N-position and `{4, q, x_q}` is a P-position (when `q < x_q`, `(q, x_q)` is a
4-pair).

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Corollary 1 (`integers-2024-G2-cor-1`). -/
public theorem_wanted sylver_four_pair_existsUnique {q : ℕ} (hq : 3 < q) (hqo : Odd q) :
    IsSylverNPosition {4, q} ∧
      ∃! x, Odd x ∧ IsSylverNPosition {4, x} ∧ IsSylverPPosition {4, q, x}

/-- 4-pairs with `7 < q < x_q` satisfy Conway's bounds `2q < x_q < 3q`. The 4-pair is given
by the characterization of Proposition 7: `x_q` odd, `{4, x_q}` an N-position and
`{4, x_q, q}` a P-position.

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Theorem 4 (`integers-2024-G2-thm-4`). -/
public theorem_wanted sylver_four_pair_bounds {q x : ℕ} (hqo : Odd q) (hxo : Odd x) (hq : 7 < q)
    (hqx : q < x) (hN : IsSylverNPosition {4, x}) (hP : IsSylverPPosition {4, x, q}) :
    2 * q < x ∧ x < 3 * q

/-- Proposition 8, parts 1 to 4: for `x > 1`,
1. if `x ≡ 1 (mod 4)` then `{4, x, x + 2, 6}` is a P-position;
2. if `x ≡ 7 (mod 8)` then `{4, x, x + 2, 10}` is a P-position;
3. if `x ≡ 5 (mod 8)` then `{4, x, x + 6, 10}` is a P-position;
4. if `x ≡ 1 (mod 8)` then `{4, x, x + 6, 14}` is a P-position.
The paper's hypothesis that `xy` is odd follows from the congruences. Part 5 (`x ≡ 5 (mod 8)`,
`y = x - 2`, `{4, x, y, 14}` a P-position) is omitted: it fails at `x = 13`, where
`{4, 11, 13, 14}` is an N-position (naming `5` wins).

Source: Morgan Boyers, Natalie Burton, Jeff Rushall, James Warner and Tara Zurick, *On Winning
Strategies in Sylver Coinage When 4 Has Been Chosen*, INTEGERS 24 (2024), Article G2,
Proposition 8 (`integers-2024-G2-prop-8`). -/
public theorem_wanted isSylverPPosition_four_odd_pair_even {x : ℕ} (hx : 1 < x) :
    (x % 4 = 1 → IsSylverPPosition {4, x, x + 2, 6}) ∧
      (x % 8 = 7 → IsSylverPPosition {4, x, x + 2, 10}) ∧
      (x % 8 = 5 → IsSylverPPosition {4, x, x + 6, 10}) ∧
      (x % 8 = 1 → IsSylverPPosition {4, x, x + 6, 14})

end

end MetaMathlibExt
