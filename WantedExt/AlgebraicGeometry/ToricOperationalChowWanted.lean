module

public import Batteries.Util.ProofWanted
public import MathlibExt.AlgebraicGeometry.ToricOperationalChow

/-!
# Integral operational Chow and Minkowski comparison

Fulton--Sturmfels, *Intersection Theory on Toric Varieties*,
alg-geom/9403002v1, Theorems 2.1 and 3.2, section 2.
The integral groups, compatible cap family, monomial orbit closures, residue
degree, refined Gysin and displacement sum are fixed. The balanced image,
unique normalized inverse, product and fan-subdivision comparisons are targets.
No toric equivalence or multiplication theorem is an input.
-/

@[expose] public noncomputable section

namespace WantedExt.AlgebraicGeometry.ToricOperationalChowWanted

open _root_.AlgebraicGeometry.IntegerSchemeChow
open _root_.AlgebraicGeometry.IntegralOperationalChow
open _root_.AlgebraicGeometry.IntegralOperationalClasses
open MathlibExt.AlgebraicGeometry.FiniteToricCoordinates
open MathlibExt.AlgebraicGeometry.ToricMinkowskiWeights
open MathlibExt.AlgebraicGeometry.ToricOperationalChow

/-- **The torus-orbit closures of a toric variety.** For a finite fan $F$ in $\mathbb{R}^n$ and a
proper complex scheme $X$ identified with a realization of $F$ by affine charts $U_\tau$
(`Model F`): for every cone $\sigma$ of $F$, an integral proper complex scheme $V(\sigma)$ of
dimension $n - \dim \sigma$ with a closed immersion into $X$, such that for every cone $\tau$ the
ideal of $V(\sigma) \cap U_\tau$ in $\mathbb{C}[\tau^\vee \cap \mathbb{Z}^n]$ is generated by the
characters of $\tau^\vee \cap \mathbb{Z}^n$ not vanishing on $\sigma$ when $\sigma$ is a face of
$\tau$, and is the unit ideal otherwise. -/
def_wanted orbitClosures (n : ℕ) (F : FiniteFan n) (M : Model F) : OrbitClosures F M

theorem_wanted cap_balanced (n : ℕ) (F : FiniteFan n) (_complete : F.IsComplete)
    (M : Model F) (V : OrbitClosures F M) (O : CycleOperations (k := ℂ))
    (D : ∀ sigma : F.Face, DegreeComparison (V.source sigma))
    (N : NormalData F) (k : ℕ) (A : Class O M.source (k : ℤ)) :
    capHom F M V O D k A ∈ weights F N k

def_wanted unique_operational_lift (n : ℕ) (F : FiniteFan n) (_complete : F.IsComplete)
    (M : Model F) (V : OrbitClosures F M) (O : CycleOperations (k := ℂ))
    (D : ∀ sigma : F.Face, DegreeComparison (V.source sigma))
    (N : NormalData F) (k : ℕ) (w : weights F N k) :
    {A : Class O M.source (k : ℤ) // capHom F M V O D k A = w.val ∧
      ∀ B : Class O M.source (k : ℤ), capHom F M V O D k B = w.val → B = A}

theorem_wanted cup_displacement (n : ℕ) (F : FiniteFan n) (_complete : F.IsComplete)
    (M : Model F) (V : OrbitClosures F M) (O : CycleOperations (k := ℂ))
    (D : ∀ sigma : F.Face, DegreeComparison (V.source sigma))
    (k l : ℕ)
    (A : Class O M.source (k : ℤ)) (B : Class O M.source (l : ℤ))
    (v : RealSpace n) (_generic : GenericDisplacement F v) :
    capHom F M V O D (k + l)
      (degreeCast O M.source (by omega) (cupClass O M.source A B)) =
        displacementProduct F k l (capHom F M V O D k A) (capHom F M V O D l B) v

theorem_wanted subdivision_cap (n : ℕ) (F G : FiniteFan n)
    (_complete_F : F.IsComplete) (_complete_G : G.IsComplete)
    (M : Model F) (N : Model G) (V : OrbitClosures F M) (W : OrbitClosures G N)
    (O : CycleOperations (k := ℂ))
    (D : ∀ sigma : F.Face, DegreeComparison (V.source sigma))
    (E : ∀ gamma : G.Face, DegreeComparison (W.source gamma))
    (R : FanSubdivision F G) (S : SubdivisionMorphism F M G R N)
    (k : ℕ) (A : Class O M.source (k : ℤ)) :
    capHom G N W O E k (pullbackClass O N.source S.map A) =
      refinedWeight F G k (capHom F M V O D k A)

end WantedExt.AlgebraicGeometry.ToricOperationalChowWanted
