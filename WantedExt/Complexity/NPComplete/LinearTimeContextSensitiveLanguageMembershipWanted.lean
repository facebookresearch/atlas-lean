/-
# Membership for some fixed linear-time context-sensitive grammar is NP-complete

Source:
M. R. Garey and D. S. Johnson, *Computers and Intractability: A Guide to the
Theory of NP-Completeness*, W. H. Freeman (1979), problem [AL20], comment: NP-complete for some
fixed "linear time" context-sensitive grammar;
R. V. Book, "On the complexity of formal grammars", Acta Informatica 9 (1978), 171-182,
doi:10.1007/BF00289076;
R. V. Book, "Time-bounded grammars and their languages", Journal of Computer and System
Sciences 5 (1971), 397-429, doi:10.1016/S0022-0000(71)80025-9 (time-bounded grammars).
-/
module

public import Batteries.Util.ProofWanted
public import CSLibExt.Computability.CookLevin
public import CSLibExt.Computability.Languages.ContextSensitive.Basic
public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.LinearTimeContextSensitiveLanguageMembership

open Cslib.Language

/-!
# Membership for some fixed linear-time context-sensitive grammar is NP-complete

There is a fixed context-sensitive grammar `G` that is linear time (some constant `k` bounds,
for every word `w` of its language, the length of a shortest derivation of `w` by `k · |w|`)
such that the problem "given a string `w`, is `w` in the language generated by `G`?" is
NP-complete.

The grammar is the repository's `Cslib.Language.CSGrammar` with `IsContextSensitive` (every
production has a nonterminal on its left and does not shrink), derivation steps
`Cslib.Language.Rewrites`, and language `Cslib.Language.language`. Terminals are natural
numbers: any finite terminal alphabet can be renamed into `ℕ`, and a grammar uses only the
finitely many terminals in its productions. A derivation with at most `m` steps is a chain
`[S] = u₀, u₁, …, u_j = w` of sentential forms with `j ≤ m` and each `u_{t+1}` obtained from `u_t`
by one rewriting step, in the `List.IsChain` form of Mathlib's
`List.exists_isChain_cons_of_relationReflTransGen`.

Encoding: the instance, a word `w : List ℕ`, is decoded from a bitstring with the repository's
canonical `MetaMathlibExt.BitstringEncoding`. Undecodable bitstrings are no-instances.

NP-completeness is stated in the same form as the proved results in
`CSLibExt.Computability.Complexity.Karp`: membership in
`MetaMathlibExt.ComplexityTheory.NP`, plus a polynomial-time many-one
reduction from every language in `NP`
(`Cslib.CookLevin.PolyManyOneRed`).
-/

/-- The word `w` has a derivation in `g` with at most `m` rewriting steps: a chain of sentential
forms from the initial nonterminal to `w`, consecutive forms related by `Rewrites g`, with at most
`m` forms after the first. -/
def DerivableWithin {N : Type} (g : CSGrammar ℕ N) (m : ℕ) (w : List ℕ) : Prop :=
  ∃ l : List (List (Symbol ℕ N)), l.length ≤ m ∧
    List.IsChain (Rewrites g) ([Symbol.nonterminal g.initial] :: l) ∧
    ([Symbol.nonterminal g.initial] :: l).getLast (List.cons_ne_nil _ _) =
      w.map Symbol.terminal

/-- The grammar `g` is linear time: for some constant `k`, every word `w` of its language has a
derivation with at most `k · |w|` steps. -/
def IsLinearTime {N : Type} (g : CSGrammar ℕ N) : Prop :=
  ∃ k : ℕ, ∀ w ∈ language g, DerivableWithin g (k * w.length) w

open Classical in
/-- Membership in the language of the fixed grammar `g`, as a decision problem over
bitstrings. -/
noncomputable def membershipDec {N : Type} (g : CSGrammar ℕ N) :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode (α := List ℕ) x with
  | some w => decide (w ∈ language g)
  | none => false

/-- **Membership for some fixed linear-time context-sensitive grammar is NP-complete.** Source:
Garey and Johnson (1979), [AL20], comment; Book (1978). -/
public theorem_wanted linearTimeContextSensitiveLanguageMembership_npComplete :
    ∃ (N : Type) (g : CSGrammar ℕ N), IsContextSensitive g ∧ IsLinearTime g ∧
      membershipDec g ∈ MetaMathlibExt.ComplexityTheory.NP ∧
        ∀ L : MetaMathlibExt.ComplexityTheory.DecisionProblem,
          L ∈ MetaMathlibExt.ComplexityTheory.NP →
            Cslib.CookLevin.PolyManyOneRed L (membershipDec g)

end MetaMathlibExt.Complexity.NPComplete.LinearTimeContextSensitiveLanguageMembership
