/-
# EDOL GRAMMAR NON-EMPTINESS is NP-complete

Source:
M. R. Garey and D. S. Johnson, *Computers and Intractability: A Guide to the
Theory of NP-Completeness*, W. H. Freeman (1979), problem [AL16] ETOL GRAMMAR
NON-EMPTINESS, comment ("NP-complete if `G` contains just one table and exactly one
production for each symbol (`G` is an "EDOL grammar")");
N. D. Jones and S. Skyum, "Complexity of some problems concerning L systems", Proc. 4th
International Colloquium on Automata, Languages and Programming (ICALP 1977), Lecture Notes
in Computer Science 52, Springer (1977), 301-308, doi:10.1007/3-540-08342-1_23;
journal version: Mathematical Systems Theory 13 (1979), 29-43, doi:10.1007/BF01744286.
-/
module

public import Batteries.Data.List.Basic
public import Batteries.Util.ProofWanted
public import CSLibExt.Computability.CookLevin
public import Mathlib.Logic.Relation
public import MathlibExt.Computability.BinaryNatEncoding
public import MathlibExt.Computability.Complexity

@[expose] public section

namespace MetaMathlibExt.Complexity.NPComplete.EDOLGrammarNonEmptiness

/-!
# EDOL GRAMMAR NON-EMPTINESS is NP-complete

An ETOL grammar `G = (N, Σ, {δ₁, ..., δₙ}, S)` has a finite set `N` of nonterminal symbols,
a finite set `Σ` of terminal symbols, an initial symbol `S ∈ N`, and tables `δᵢ`, each a
set of productions taking symbols in `N ∪ Σ` to strings in `(N ∪ Σ)*`. At each step of a
derivation one table is chosen, and every symbol of the current string is replaced according
to some production of that table. The language generated by `G` is the set of strings in
`Σ*` derivable from `S`. `G` is an EDOL grammar when it has just one table and exactly one
production for each symbol. Given an EDOL grammar `G`, is the language generated by `G`
non-empty?

The nonterminals are `0, ..., n - 1` and the terminals are `0, ..., k - 1`; a symbol is a
pair in which `(false, A)` is nonterminal `A` and `(true, a)` is terminal `a`. A table is a
list of productions `(x, w)`, read as the set of its entries; such a production rewrites the
symbol `x` to the string `w`. The definitions below are those of general ETOL grammars; the
EDOL restriction (one table, exactly one production for each symbol) is part of
`WellFormed`.

Encoding: the instance is decoded from a bitstring with the repository's
canonical `MetaMathlibExt.BitstringEncoding`. Undecodable bitstrings, and
bitstrings decoding to malformed instances, are no-instances.

NP-completeness is stated in the same form as the proved results in
`CSLibExt.Computability.Complexity.Karp`: membership in
`MetaMathlibExt.ComplexityTheory.NP`, plus a polynomial-time many-one
reduction from every language in `NP`
(`Cslib.CookLevin.PolyManyOneRed`).
-/

/-- A symbol of `N ∪ Σ`: `(false, A)` is nonterminal `A` and `(true, a)` is terminal `a`. -/
abbrev LSymbol := Bool × ℕ

/-- A table: a list of productions `(x, w)`, each rewriting the symbol `x` to the string
`w`. -/
abbrev Table := List (LSymbol × List LSymbol)

/-- An instance: the number `n` of nonterminals, the number `k` of terminals, the list of
tables `[δ₁, ..., δₘ]`, and the initial nonterminal `S`. -/
abbrev EDOLGrammarNonEmptinessInstance := ℕ × ℕ × List Table × ℕ

/-- A symbol of a grammar with `n` nonterminals and `k` terminals. -/
def IsSymbol (n k : ℕ) (x : LSymbol) : Prop :=
  if x.1 then x.2 < k else x.2 < n

/-- One derivation step with the table `t`: every symbol of `u` is replaced according to some
production of `t`, giving `v`. -/
def TableStep (t : Table) (u v : List LSymbol) : Prop :=
  ∃ ws : List (List LSymbol), List.Forall₂ (fun x w => (x, w) ∈ t) u ws ∧ v = ws.flatten

/-- One derivation step of the grammar: a step with one of its tables. -/
def Step (ts : List Table) (u v : List LSymbol) : Prop :=
  ∃ t ∈ ts, TableStep t u v

/-- Well-formedness of an instance: `S` is a nonterminal, every production takes a symbol to
a string of symbols, and the grammar is an EDOL grammar: it has just one table, and that
table has exactly one production for each symbol. -/
def WellFormed : EDOLGrammarNonEmptinessInstance → Prop
  | (n, k, ts, S) =>
    S < n ∧ (∀ t ∈ ts, ∀ p ∈ t, IsSymbol n k p.1 ∧ ∀ y ∈ p.2, IsSymbol n k y) ∧
      ts.length = 1 ∧ ∀ t ∈ ts, ∀ x, IsSymbol n k x → ∃! w, (x, w) ∈ t

/-- The language generated by the grammar is non-empty: some string of terminals is
derivable from `S` in zero or more steps. -/
def EDOLGrammarNonEmptinessFeasible : EDOLGrammarNonEmptinessInstance → Prop
  | (_, _, ts, S) =>
    ∃ v : List LSymbol, (∀ y ∈ v, y.1 = true) ∧ Relation.ReflTransGen (Step ts) [(false, S)] v

open Classical in
/-- EDOL GRAMMAR NON-EMPTINESS as a decision problem over bitstrings. -/
noncomputable def edolGrammarNonEmptinessDec :
    MetaMathlibExt.ComplexityTheory.DecisionProblem := fun x =>
  match MetaMathlibExt.BitstringEncoding.bitDecode
      (α := EDOLGrammarNonEmptinessInstance) x with
  | some i => decide (WellFormed i ∧ EDOLGrammarNonEmptinessFeasible i)
  | none => false

/-- **EDOL GRAMMAR NON-EMPTINESS is NP-complete.** Source: Garey and Johnson (1979),
[AL16], comment; Jones and Skyum (1977, 1979). -/
public theorem_wanted edolGrammarNonEmptiness_npComplete :
    edolGrammarNonEmptinessDec ∈ MetaMathlibExt.ComplexityTheory.NP ∧
      ∀ L : MetaMathlibExt.ComplexityTheory.DecisionProblem,
        L ∈ MetaMathlibExt.ComplexityTheory.NP →
          Cslib.CookLevin.PolyManyOneRed L edolGrammarNonEmptinessDec

end MetaMathlibExt.Complexity.NPComplete.EDOLGrammarNonEmptiness
