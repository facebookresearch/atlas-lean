/-
# Equal q-gram composition implies transposition/rotation equivalence

Ukkonen conjectured, and Pevzner proved, that two strings with the same
multiset of q-grams are related by a sequence of two transformations on
`(q-1)`-grams `z₁`, `z₂` and arbitrary strings `xᵢ`: transposition
`x₁z₁x₂z₂x₃z₁x₄z₂x₅ ↦ x₁z₁x₄z₂x₃z₁x₂z₂x₅` and rotation
`z₁x₁z₂x₂z₁ ↦ z₂x₂z₁x₁z₂`. Both strings must contain a q-gram (length at least
`q`): strings shorter than `q` all have the empty composition, while the two moves preserve length.
Finer uniqueness characterizations (no interleaved or triple repeats) were not verified and are not
stated here.

Overlap: none for uniqueness (`CSLibExt/Bioinformatics/Assembly/DeBruijn.lean`
proves the k-mer walk is Eulerian and every Eulerian trail spells a string
with the same k-mer multiset; the transposition/rotation equivalence is new).

Sources: P. A. Pevzner, "DNA physical mapping and alternating Eulerian cycles
in colored graphs", Algorithmica 13(1-2):77-105, 1995,
doi:10.1007/BF01188582; conjecture in E. Ukkonen, "Approximate
string-matching with q-grams and maximal matches", Theoretical Computer
Science 92(1):191-211, 1992, doi:10.1016/0304-3975(92)90143-4; statement
after the held secondary restatements.
-/
module

public import Batteries.Util.ProofWanted
public import Mathlib.Data.Finset.Card
public import Mathlib.Data.List.Basic
public import Mathlib.Data.Multiset.Basic

@[expose] public section

namespace WantedExt.Biology.ComputationalBiology.QGramWanted

variable {α : Type*} [DecidableEq α]

/-- Length-`q` substrings (q-grams) of a string, in order. -/
def qGrams (q : ℕ) (T : List α) : List (List α) :=
  (T.tails.map fun t => t.take q).filter fun g => g.length == q

/-- The q-gram multiset (composition). -/
def qGramMultiset (q : ℕ) (T : List α) : Multiset (List α) :=
  ↑(qGrams q T)

/-- Transposition/rotation equivalence, generated by the two moves. -/
inductive Related (q : ℕ) : List α → List α → Prop where
  | refl (s) : Related q s s
  | trans (s t u) : Related q s t → Related q t u → Related q s u
  | transp (x₁ x₂ x₃ x₄ x₅ z₁ z₂ : List α) (h₁ : z₁.length = q - 1)
      (h₂ : z₂.length = q - 1) :
      Related q (x₁ ++ z₁ ++ x₂ ++ z₂ ++ x₃ ++ z₁ ++ x₄ ++ z₂ ++ x₅)
        (x₁ ++ z₁ ++ x₄ ++ z₂ ++ x₃ ++ z₁ ++ x₂ ++ z₂ ++ x₅)
  | rot (x₁ x₂ z₁ z₂ : List α) (h₁ : z₁.length = q - 1)
      (h₂ : z₂.length = q - 1) :
      Related q (z₁ ++ x₁ ++ z₂ ++ x₂ ++ z₁) (z₂ ++ x₂ ++ z₁ ++ x₁ ++ z₂)

/-- **Ukkonen's conjecture, proved by Pevzner**: for a gram length `q ≥ 2` (so the `(q-1)`-grams
`z₁`, `z₂` are nonempty) and two strings `s`, `t` of length at least `q` each (so each contains a
q-gram) with the same q-gram multiset, `s` and `t` are related by a finite sequence of
transpositions and rotations.

Source: Pevzner (1995), settling Ukkonen (1992). -/
public theorem_wanted qgram_composition_related (q : ℕ) (hq : 2 ≤ q) (s t : List α)
    (hs : q ≤ s.length) (ht : q ≤ t.length)
    (hsame : qGramMultiset (α := α) q s = qGramMultiset q t) :
    Related q s t

end WantedExt.Biology.ComputationalBiology.QGramWanted
