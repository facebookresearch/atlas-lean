/-
# Laws and finite bases of varieties of groups, rings and Lie rings

Shared definitions for the Kourovka Notebook varieties entries (Problems 2.39, 2.41 and 2.44): laws
of a group as elements of `FreeGroup ℕ`, identities of a (not necessarily unital) associative ring
as elements of the free non-unital ring `MonoidAlgebra ℤ (FreeSemigroup ℕ)`, identities of a Lie
ring as elements of the free Lie ring `FreeLieAlgebra ℤ ℕ`, membership of a group in the variety
defined by a set of laws, and finite basedness of the variety generated by an algebra: finitely many
of its identities imply all of them in every algebra of the signature in `Type`.
-/

module

public import Mathlib.Algebra.Free
public import Mathlib.Algebra.Lie.Free
public import Mathlib.Algebra.MonoidAlgebra.Defs
public import Mathlib.GroupTheory.FreeGroup.Basic

@[expose] public section

namespace MathlibExt.Algebra.VarietyIdentitiesShared

/-- `w` is a law of the group `G`: `w(g₀, g₁, …) = 1` for every assignment `g : ℕ → G` of the
variables `x₀, x₁, …` of the free group `FreeGroup ℕ`. -/
def IsGroupLaw (G : Type) [Group G] (w : FreeGroup ℕ) : Prop :=
  ∀ g : ℕ → G, FreeGroup.lift g w = 1

/-- `G` lies in the variety of groups defined by the set of laws `L ⊆ FreeGroup ℕ`. -/
def InVariety (L : Set (FreeGroup ℕ)) (G : Type) [Group G] : Prop :=
  ∀ w ∈ L, IsGroupLaw G w

/-- The laws of `G` are finitely based: some finite set of laws of `G` implies every law of `G`,
that is, every group satisfying the finite set satisfies all laws of `G`. -/
def GroupLawsFinitelyBased (G : Type) [Group G] : Prop :=
  ∃ B : Finset (FreeGroup ℕ), (∀ w ∈ B, IsGroupLaw G w) ∧
    ∀ (H : Type) [Group H], (∀ w ∈ B, IsGroupLaw H w) → ∀ w, IsGroupLaw G w → IsGroupLaw H w

/-- Polynomials without constant term in the noncommuting variables `x₀, x₁, …` with integer
coefficients: the free non-unital associative ring on `ℕ`, as the semigroup ring of the free
semigroup. -/
abbrev RingWord := MonoidAlgebra ℤ (FreeSemigroup ℕ)

/-- `f` is an identity of the (not necessarily unital) associative ring `A`: `f(a₀, a₁, …) = 0`
for every assignment `a : ℕ → A`. -/
def IsRingIdentity (A : Type) [NonUnitalRing A] (f : RingWord) : Prop :=
  ∀ a : ℕ → A, MonoidAlgebra.liftMagma ℤ (FreeSemigroup.lift a) f = 0

/-- The identities of the associative ring `A` are finitely based (among associative rings): the
variety generated by `A` is finitely based. -/
def RingIdentitiesFinitelyBased (A : Type) [NonUnitalRing A] : Prop :=
  ∃ B : Finset RingWord, (∀ f ∈ B, IsRingIdentity A f) ∧
    ∀ (C : Type) [NonUnitalRing C], (∀ f ∈ B, IsRingIdentity C f) →
      ∀ f, IsRingIdentity A f → IsRingIdentity C f

/-- `f` is an identity of the Lie ring `L`: `f(a₀, a₁, …) = 0` for every `a : ℕ → L`, where `f`
lies in the free Lie ring `FreeLieAlgebra ℤ ℕ`. -/
def IsLieIdentity (L : Type) [LieRing L] (f : FreeLieAlgebra ℤ ℕ) : Prop :=
  ∀ a : ℕ → L, FreeLieAlgebra.lift ℤ a f = 0

/-- The identities of the Lie ring `L` are finitely based (among Lie rings): the variety generated
by `L` is finitely based. -/
def LieIdentitiesFinitelyBased (L : Type) [LieRing L] : Prop :=
  ∃ B : Finset (FreeLieAlgebra ℤ ℕ), (∀ f ∈ B, IsLieIdentity L f) ∧
    ∀ (M : Type) [LieRing M], (∀ f ∈ B, IsLieIdentity M f) →
      ∀ f, IsLieIdentity L f → IsLieIdentity M f

end MathlibExt.Algebra.VarietyIdentitiesShared
