module

import Batteries.Util.ProofWanted
public import WantedExt.Topology.MaciasCoprimeTopologyWanted

/-!
# Primes in arithmetic progressions in the comaximal space

Statements from Jhixon Macías, *A Topological Proof of the Infinitude of Prime Numbers in Certain
Arithmetic Progressions*, INTEGERS 26 (2026), Article A39.

The paper's comaximal space `CM(ℕ)` is `ℕ+` with the topology generated by the sets
`σ_n = {m : gcd(n, m) = 1}`; this is `maciasTopology` (generated by `coprimeSet n`) from
`WantedExt/Topology/MaciasCoprimeTopologyWanted.lean`, threaded through `Dense` with `@`.
-/

namespace MetaMathlibExt

open MathlibExt.Topology.MaciasCoprimeTopologyWanted

@[expose] public section

/-- A nonempty set `A` of primes is infinite if and only if it is dense in the comaximal space
`CM(ℕ)`.

Source: Jhixon Macías, *A Topological Proof of the Infinitude of Prime Numbers in Certain
Arithmetic Progressions*, INTEGERS 26 (2026), Article A39, Lemma 1 (quoting Macías, INTEGERS 24
(2024), Article A47). -/
public theorem_wanted infinite_iff_dense_maciasTopology_of_subset_primes (A : Set ℕ+)
    (hA : A.Nonempty) (hAp : ∀ p ∈ A, Nat.Prime (p : ℕ)) :
    A.Infinite ↔ @Dense ℕ+ maciasTopology A

/-- For positive integers `a, b` with `gcd(a, b) = 1`, the arithmetic progression
`aℕ₀ + b = {b, a + b, 2a + b, …}` is dense in the comaximal space `CM(ℕ)`.

Source: Jhixon Macías, *A Topological Proof of the Infinitude of Prime Numbers in Certain
Arithmetic Progressions*, INTEGERS 26 (2026), Article A39, Lemma 2. -/
public theorem_wanted dense_maciasTopology_arithmeticProgression (a b : ℕ+)
    (hab : Nat.Coprime a b) :
    @Dense ℕ+ maciasTopology {m : ℕ+ | ∃ k : ℕ, (m : ℕ) = a * k + b}

end

end MetaMathlibExt
