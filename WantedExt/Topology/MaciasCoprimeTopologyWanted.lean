/-
# Macías's topological proof of the infinitude of prime numbers

Statements from Jhixon Macías, "Another Topological Proof of the
Infinitude of Prime Numbers", *INTEGERS* 24 (2024), Article A47
(<https://math.colgate.edu/~integers/y47/y47.pdf>,
DOI 10.5281/zenodo.11221653).

The paper works with the positive integers `ℕ`, here `ℕ+`, and the
topology generated by the basis `β = {Ω_n : n ∈ ℕ}` where
`Ω_n = {m : gcd(n, m) = 1}`; these are `maciasBasis`,
`coprimeSet n`, and `maciasTopology` below. The space is
`X = (ℕ, τ)`, and `X₁` is the subspace on `ℕ ∖ {1}`, here the
subtype `{x : ℕ+ // (x : ℕ) ≠ 1}` with
`maciasTopology₁`. The set of prime numbers is
`{p : ℕ+ | Nat.Prime (p : ℕ)}`, resp. its counterpart in `X₁`.
Non-instance topologies are threaded explicitly through `Dense`
and `closure` via `@`.

The paper's closing Theorem 4 (a nonempty set of primes is dense
in `X` iff it is infinite) is not among the five statements
treated here.
-/
module

public import Batteries.Util.ProofWanted
public import Mathlib.Data.Nat.GCD.Basic
public import Mathlib.Data.Nat.Prime.Defs
public import Mathlib.Data.PNat.Defs
public import Mathlib.Topology.Bases
public import Mathlib.Topology.Constructions

set_option autoImplicit false

@[expose] public section

namespace MathlibExt.Topology.MaciasCoprimeTopologyWanted

/-- The paper's `Ω_n = {m ∈ ℕ : gcd(n, m) = 1}`. -/
def coprimeSet (n : ℕ+) : Set ℕ+ :=
  {m | Nat.Coprime (n : ℕ) (m : ℕ)}

/-- The paper's basis `β = {Ω_n : n ∈ ℕ}`. -/
def maciasBasis : Set (Set ℕ+) :=
  Set.range coprimeSet

/-- The paper's topology `τ` on the positive integers, generated
by `β`. -/
@[instance_reducible] def maciasTopology : TopologicalSpace ℕ+ :=
  TopologicalSpace.generateFrom maciasBasis

/-- The paper's subspace topology `τ₁` on `ℕ ∖ {1}`. -/
@[instance_reducible] def maciasTopology₁ : TopologicalSpace {x : ℕ+ // (x : ℕ) ≠ 1} :=
  TopologicalSpace.induced Subtype.val maciasTopology

/-- The set of prime numbers, as a subset of `X`. -/
def primeSet : Set ℕ+ :=
  {p | Nat.Prime (p : ℕ)}

/-- The set of prime numbers, as a subset of `X₁`. -/
def primeSet₁ : Set {x : ℕ+ // (x : ℕ) ≠ 1} :=
  {x | Nat.Prime ((x : ℕ+) : ℕ)}

/-- **Theorem 1**: the set `β` is a base for a topology on `ℕ`,
namely a topological basis of the topology it generates.

Source: Jhixon Macías, "Another Topological Proof of the
Infinitude of Prime Numbers", Theorem 1. -/
theorem_wanted maciasBasis_isTopologicalBasis :
    @TopologicalSpace.IsTopologicalBasis ℕ+ maciasTopology
      maciasBasis

/-- **Lemma 1**: if `p` is a prime number, then the closure of
`{p}` in `X` is `pℕ`, the set of multiples of `p`.

Source: Jhixon Macías, "Another Topological Proof of the
Infinitude of Prime Numbers", Lemma 1. -/
theorem_wanted closure_singleton_prime_eq_multiples
    (p : ℕ+) (hp : Nat.Prime (p : ℕ)) :
    @closure ℕ+ maciasTopology {p} = {x : ℕ+ | (p : ℕ) ∣ (x : ℕ)}

/-- **Theorem 2**: there are infinitely many prime numbers if and
only if the set of primes is dense in `X`.

Source: Jhixon Macías, "Another Topological Proof of the
Infinitude of Prime Numbers", Theorem 2. -/
theorem_wanted infinite_primes_iff_dense_primeSet :
    Set.Infinite {p : ℕ | Nat.Prime p} ↔
      @Dense ℕ+ maciasTopology primeSet

/-- **Lemma 2**: if the set of primes is dense in `X₁`, then it
is dense in `X`.

Source: Jhixon Macías, "Another Topological Proof of the
Infinitude of Prime Numbers", Lemma 2. -/
theorem_wanted dense_primeSet_of_dense_primeSet₁ :
    @Dense {x : ℕ+ // (x : ℕ) ≠ 1} maciasTopology₁ primeSet₁ →
      @Dense ℕ+ maciasTopology primeSet

/-- **Theorem 3**: the set of prime numbers is dense in `X₁`.

Source: Jhixon Macías, "Another Topological Proof of the
Infinitude of Prime Numbers", Theorem 3. -/
theorem_wanted dense_primeSet₁ :
    @Dense {x : ℕ+ // (x : ℕ) ≠ 1} maciasTopology₁ primeSet₁

end MathlibExt.Topology.MaciasCoprimeTopologyWanted
