/-
# Generation from coprime-index subgroups
-/
module

public import Mathlib.GroupTheory.Index
public import Batteries.Util.ProofWanted

@[expose] public section

namespace MathlibExt.GroupTheory.GenerationFromCoprimeIndexSubgroupsWanted

/-! Source record `KOU-21.87__2596`. -/

/-- `d`-generated subgroup in the sense of [KOU-21.87] Kourovka Notebook
Problem 21.87: a subgroup `H` of `G` equal to the closure of the range of
some `d`-tuple, hence generated by at most `d` elements. -/
def KourovkaDGenerated (G : Type*) [Group G] (H : Subgroup G) (d : ℕ) : Prop :=
  ∃ f : Fin d → G, Subgroup.closure (Set.range f) = H

/-- [KOU-21.87] Kourovka Notebook Problem 21.87: a finite group `G` admits a
family of `d`-generator subgroups whose indices have no common divisor
greater than `1` (for every `n > 1` some member has index not divisible by
`n`); question: is `G` then generated by `d + 1` elements? -/
def conjecture : Prop :=
  ∀ (G : Type*) [Group G] [Finite G] (d : ℕ),
    (∃ S : Set (Subgroup G),
      (∀ H ∈ S, KourovkaDGenerated G H d) ∧
      ∀ n : ℕ, 1 < n → ∃ H ∈ S, ¬ n ∣ H.index) →
    ∃ f : Fin (d + 1) → G, Subgroup.closure (Set.range f) = ⊤

/--
Resolved true: Answered affirmatively: R. Sater (arXiv:2608.12432, 2026) proves that if a finite
group G has a family of subgroups H with d(H) ≤ d whose indices |G:H| have greatest common
divisor 1, then d(G) ≤ d + 1. The Kourovka Notebook (arXiv:1401.0300v49) marks Problem 21.87
solved (AI-assisted solutions by J. DeCaro and R. Sater confirmed by A. Lucchini). Source: R.
Sater, Generation of finite groups from subgroups of coprime index, arXiv:2608.12432 (2026),
https://arxiv.org/abs/2608.12432; E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in
Group Theory: The Kourovka Notebook, 21st issue, arXiv:1401.0300v49 (20 October 2026), Problem
21.87, https://arxiv.org/abs/1401.0300v49. Moved from
`OpenConjectures/GroupTheory/GenerationFromCoprimeIndexSubgroups`.
-/
public theorem_wanted conjecture_holds : conjecture

end MathlibExt.GroupTheory.GenerationFromCoprimeIndexSubgroupsWanted
