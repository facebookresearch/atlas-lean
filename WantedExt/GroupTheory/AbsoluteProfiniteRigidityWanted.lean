module

public import Batteries.Util.ProofWanted
public import Mathlib

@[expose] public section

namespace MathlibExt.GroupTheory.AbsoluteProfiniteRigidityWanted
/-!
# Main Statement from Absolute profinite rigidity and hyperbolic geometry

We formalise the statement of the main result from M. R. Bridson, D. B. McReynolds, A. W. Reid, and
R. Spitler, `Absolute profinite rigidity and hyperbolic geometry`, Annals of Math, 192 (3) 2020.
-/

set_option autoImplicit false

universe u

namespace AbsoluteProfiniteRigidity

open Group Polynomial

noncomputable section

/-- The profinite completion of a group. -/
abbrev profiniteCompletion (G : Type u) [Group G] : Type u :=
  ProfiniteGrp.ProfiniteCompletion.completion (.mk G)

/-- A finitely generated residually finite group `Γ` is said to be *profinitely rigid* if `Γ` is
isomorphic to every finitely generated residually finite group `Λ` with profinite completion
isomorphic to the profinite completion of `Γ`.

Note that any such isomorphism of profinite completions is automatically a homeomorphism. This is a
consequence of the Nikolov-Segal theorem which states that for a finitely generated group `Γ`,
every finite index subgroup of the profinite completion of `Γ` is automatically open. Conversely,
every open subgroup has finite index by compactness, so in this case the open subgroups (which
generate the topology) are exactly the subgroups of finite index. Thus, the topology on the
profinite completion of `Γ` can be characterized algebraically as the topology generated by the
finite index subgroups. In particular, any isomorphism between profinite completions of finitely
generated groups automatically preserves the topology and is thus a homeomorphism. -/
def ProfinitelyRigid (Γ : Type u) [Group Γ] : Prop :=
  FG Γ ∧ ResiduallyFinite Γ ∧ ∀ (Λ : Type u) [Group Λ] [FG Λ] [ResiduallyFinite Λ],
    Nonempty (profiniteCompletion Γ ≃* profiniteCompletion Λ) → Nonempty (Γ ≃* Λ)

/-- The ring of integers of the number field `ℚ(√(-d))`. -/
abbrev RingOfIntegers (d : ℕ) := NumberField.RingOfIntegers (SplittingField (X ^ 2 + C (d : ℚ)))

/-- The Bianchi group `PSL(2, 𝓞)` where `𝓞` is the ring of integers of `ℚ(√(-d))`. -/
abbrev BianchiGroup (d : ℕ) := Matrix.ProjectiveSpecialLinearGroup (Fin 2) (RingOfIntegers d)

/--
Statement of Theorem 7.1:

The group `Γ = PSL(2, Z[ω])` is profinitely rigid.
Source: M. R. Bridson, D. B. McReynolds, A. W. Reid, and R. Spitler, `Absolute profinite rigidity and hyperbolic geometry`, Annals of Math, 192 (3) 2020. Statement taken from https://github.com/ImperialCollegeLondon/AnnalsChallenge (v1.0.0, e32eb14), AnnalsChallenge/AnnalsOfMathematics/2020-192-3-AbsoluteProfiniteRigidity.lean Via leanprover/lean-eval@38361be, problem `annals_absolute_profinite_rigidity`.
-/
public theorem_wanted theorem_7_1 : ProfinitelyRigid (BianchiGroup 3)

end

end AbsoluteProfiniteRigidity

end MathlibExt.GroupTheory.AbsoluteProfiniteRigidityWanted
