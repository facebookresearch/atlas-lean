/-
# Three Hall subgroups meeting in the π-core (Kourovka Notebook Problem 18.31)

Kourovka Notebook, Archive of Solved Problems, Problem 18.31 (E. P. Vdovin, D. O. Revin): let `π` be
a set of primes. Is it true that in any `D_π`-group `G` there are three Hall `π`-subgroups whose
intersection coincides with `O_π(G)`?
-/

module

public import Batteries.Util.ProofWanted
public import Mathlib.Data.Nat.Prime.Defs
public import Mathlib.GroupTheory.Index
public import Mathlib.Order.CompletePartialOrder

@[expose] public section

namespace MathlibExt.GroupTheory.DPiHallIntersectionKourovka18Problem31Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31 (E. P.
Vdovin, D. O. Revin). UnsolvedMath record UM-00701460 (`KOU-18.31`), dataset ulamai/UnsolvedMath
v1.8.0.

A finite group is a `D_π`-group if any two of its maximal `π`-subgroups are conjugate (Kourovka
Archive 3.62). A `π`-subgroup has order whose prime divisors lie in `π`; a Hall `π`-subgroup is a
`π`-subgroup whose index has no prime divisor in `π`. `O_π(G)` is the join of all normal
`π`-subgroups. The claim is stated for every set of primes `π` and every finite `D_π`-group.
-/

/-- `n` is a `π`-number: every prime divisor of `n` lies in `π`. -/
def IsPiNumber (π : Set ℕ) (n : ℕ) : Prop :=
  ∀ p : ℕ, p.Prime → p ∣ n → p ∈ π

/-- `H` is a `π`-subgroup: its order is a `π`-number. -/
def IsPiSubgroup {G : Type} [Group G] (π : Set ℕ) (H : Subgroup G) : Prop :=
  IsPiNumber π (Nat.card H)

/-- `H` is a Hall `π`-subgroup: a `π`-subgroup whose index has no prime divisor in `π`. -/
def IsHallPiSubgroup {G : Type} [Group G] (π : Set ℕ) (H : Subgroup G) : Prop :=
  IsPiSubgroup π H ∧ ∀ p : ℕ, p.Prime → p ∣ H.index → p ∉ π

/-- `H` is a maximal `π`-subgroup: a `π`-subgroup contained in no larger `π`-subgroup. -/
def IsMaximalPiSubgroup {G : Type} [Group G] (π : Set ℕ) (H : Subgroup G) : Prop :=
  IsPiSubgroup π H ∧ ∀ K : Subgroup G, IsPiSubgroup π K → H ≤ K → K = H

/-- `G` is a `D_π`-group (Kourovka Archive 3.62): any two maximal `π`-subgroups are conjugate. -/
def IsDPiGroup (π : Set ℕ) (G : Type) [Group G] : Prop :=
  ∀ H K : Subgroup G, IsMaximalPiSubgroup π H → IsMaximalPiSubgroup π K →
    ∃ g : G, K = H.map (MulAut.conj g).toMonoidHom

/-- `O_π(G)`: the subgroup generated by all normal `π`-subgroups (the largest normal `π`-subgroup of
a finite group). -/
noncomputable def piCore (π : Set ℕ) (G : Type) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ IsPiSubgroup π N}

/-- Kourovka 18.31 (E. P. Vdovin, D. O. Revin): for every set of primes `π`, every finite
`D_π`-group `G` has three Hall `π`-subgroups whose intersection is `O_π(G)`. -/
def threeHallSubgroupsIntersectInCore : Prop :=
  ∀ (π : Set ℕ) (G : Type) [Group G] [Finite G], IsDPiGroup π G →
    ∃ H₁ H₂ H₃ : Subgroup G, IsHallPiSubgroup π H₁ ∧ IsHallPiSubgroup π H₂ ∧
      IsHallPiSubgroup π H₃ ∧ H₁ ⊓ H₂ ⊓ H₃ = piCore π G

/--
Resolved false: the Kourovka Archive answers 18.31 "No, it is not true" (V. I. Zenkov, 2022), for
`G` an extension of `L₂(27)` by a field automorphism of order `3`, in which `H` is an extension of a
Borel subgroup of `L₂(27)` by a field automorphism of order `3`. Source: E. I. Khukhro and V. D.
Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook, 21st issue,
arXiv:1401.0300v49 (2026), Archive of Solved Problems, Problem 18.31 (E. P. Vdovin, D. O. Revin);
resolution: V. I. Zenkov, Siberian Math. J. 63 (2022), no. 4, 720-722, Kourovka Archive, Problem
18.31: No; G an extension of L_2(27) by a field automorphism of order 3, H an extension of a Borel
subgroup of L_2(27) by a field automorphism of order 3, https://arxiv.org/abs/1401.0300v49.
-/
public theorem_wanted threeHallSubgroupsIntersectInCore_refuted :
    ¬ threeHallSubgroupsIntersectInCore

end MathlibExt.GroupTheory.DPiHallIntersectionKourovka18Problem31Wanted
