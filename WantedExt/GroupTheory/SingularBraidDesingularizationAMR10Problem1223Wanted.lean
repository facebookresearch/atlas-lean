/-
# Birman's conjecture on singular braid monoids (Bestvina, Q 12.23)

M. Bestvina, Questions in Geometric Group Theory, Q 12.23: let `SBₙ` be the singular braid monoid
generated by `σᵢ^{±1}` and singular generators `τᵢ`, and `Φ : SBₙ → ℤ[Bₙ]` the homomorphism with
`Φ(σᵢ) = σᵢ` and `Φ(τᵢ) = σᵢ - σᵢ⁻¹`. Conjecture: `Φ` is injective.
-/

module

public import Batteries.Util.ProofWanted
public import Mathlib.Algebra.MonoidAlgebra.Defs
public import Mathlib.Algebra.PresentedMonoid.Basic
public import MathlibExt.GroupTheory.ArtinGroup

@[expose] public section

namespace MathlibExt.GroupTheory.SingularBraidDesingularizationAMR10Problem1223Wanted

/-!
Source: M. Bestvina, Questions in Geometric Group Theory (updated July 2004), Q 12.23 (Birman's
conjecture), https://www.math.utah.edu/~bestvina/eprints/questions-updated.pdf. UnsolvedMath record
UM-01101223 (`AMR-010-1223`), dataset ulamai/UnsolvedMath v1.8.0.

`Bₙ` is the Artin group (MathlibExt `CoxeterMatrix.ArtinGroup`) of the Coxeter matrix of type
`A_{n-1}`: the group on `σ₁, …, σ_{n-1}` (indexed by `Fin (n - 1)`) with Artin's relations, as in
Paris's paper. `SBₙ` is the presented monoid with Birman's relations, transcribed from Paris's
paper. A monoid homomorphism out of `SBₙ` is determined by its values on the generators, so the
target quantifies over the homomorphisms `Φ` with the prescribed values (`Φ(σᵢ⁻¹) = σᵢ⁻¹` included)
instead of constructing `Φ`; one exists, since Birman's relations hold for these values in `ℤ[Bₙ]`.
-/

/-- The Artin braid group `B_n` on `n` strands: the Artin group (MathlibExt
`CoxeterMatrix.ArtinGroup`) of the Coxeter matrix of type `A_{n-1}`, generated by `σ₁, …, σ_{n-1}`
(indexed by `Fin (n - 1)`) with Artin's relations `σᵢ σⱼ = σⱼ σᵢ` for `|i - j| > 1` and
`σᵢ σⱼ σᵢ = σⱼ σᵢ σⱼ` for `|i - j| = 1`. -/
abbrev BraidGroup (n : ℕ) : Type :=
  (CoxeterMatrix.A (n - 1)).ArtinGroup

/-- Generators of the singular braid monoid: `σᵢ`, `σᵢ⁻¹` and the singular generators `τᵢ`. -/
inductive SBGen (m : ℕ) : Type
  | sig (i : Fin m)
  | sigInv (i : Fin m)
  | tau (i : Fin m)

/-- Birman's monoid relations for `SB_n` (with `m = n - 1`): `σᵢ σᵢ⁻¹ = σᵢ⁻¹ σᵢ = 1`,
`σᵢ τᵢ = τᵢ σᵢ`; `σᵢ σⱼ = σⱼ σᵢ`, `σᵢ τⱼ = τⱼ σᵢ`, `τᵢ τⱼ = τⱼ τᵢ` for `|i - j| > 1`;
`σᵢ σⱼ σᵢ = σⱼ σᵢ σⱼ`, `σᵢ σⱼ τᵢ = τⱼ σᵢ σⱼ` for `|i - j| = 1`. -/
def singularBraidRels (m : ℕ) (u v : FreeMonoid (SBGen m)) : Prop :=
  (∃ i : Fin m,
      (u = FreeMonoid.of (.sig i) * FreeMonoid.of (.sigInv i) ∧ v = 1) ∨
      (u = FreeMonoid.of (.sigInv i) * FreeMonoid.of (.sig i) ∧ v = 1) ∨
      (u = FreeMonoid.of (.sig i) * FreeMonoid.of (.tau i) ∧
        v = FreeMonoid.of (.tau i) * FreeMonoid.of (.sig i))) ∨
  (∃ i j : Fin m, ((i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) ∧
      ((u = FreeMonoid.of (.sig i) * FreeMonoid.of (.sig j) ∧
          v = FreeMonoid.of (.sig j) * FreeMonoid.of (.sig i)) ∨
        (u = FreeMonoid.of (.sig i) * FreeMonoid.of (.tau j) ∧
          v = FreeMonoid.of (.tau j) * FreeMonoid.of (.sig i)) ∨
        (u = FreeMonoid.of (.tau i) * FreeMonoid.of (.tau j) ∧
          v = FreeMonoid.of (.tau j) * FreeMonoid.of (.tau i)))) ∨
  (∃ i j : Fin m, ((i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) ∧
      ((u = FreeMonoid.of (.sig i) * FreeMonoid.of (.sig j) * FreeMonoid.of (.sig i) ∧
          v = FreeMonoid.of (.sig j) * FreeMonoid.of (.sig i) * FreeMonoid.of (.sig j)) ∨
        (u = FreeMonoid.of (.sig i) * FreeMonoid.of (.sig j) * FreeMonoid.of (.tau i) ∧
          v = FreeMonoid.of (.tau j) * FreeMonoid.of (.sig i) * FreeMonoid.of (.sig j))))

/-- The singular braid monoid `SB_n`. -/
abbrev SingularBraidMonoid (n : ℕ) : Type :=
  PresentedMonoid (singularBraidRels (n - 1))

/-- Birman's conjecture (Bestvina Q 12.23): the desingularization map `Φ : SB_n → ℤ[B_n]`, the
monoid homomorphism with `Φ(σᵢ^{±1}) = σᵢ^{±1}` and `Φ(τᵢ) = σᵢ - σᵢ⁻¹`, is injective. A monoid
homomorphism is determined by its values on generators, so the statement quantifies over the
homomorphisms with these values. -/
def desingularizationInjective : Prop :=
  ∀ (n : ℕ) (Φ : SingularBraidMonoid n →* MonoidAlgebra ℤ (BraidGroup n)),
    let σ : Fin (n - 1) → MonoidAlgebra ℤ (BraidGroup n) := fun i =>
      MonoidAlgebra.of ℤ (BraidGroup n) (CoxeterMatrix.ArtinGroup.of (CoxeterMatrix.A (n - 1)) i)
    let σInv : Fin (n - 1) → MonoidAlgebra ℤ (BraidGroup n) := fun i =>
      MonoidAlgebra.of ℤ (BraidGroup n) (CoxeterMatrix.ArtinGroup.of (CoxeterMatrix.A (n - 1)) i)⁻¹
    (∀ i, Φ (PresentedMonoid.of _ (.sig i)) = σ i) →
    (∀ i, Φ (PresentedMonoid.of _ (.sigInv i)) = σInv i) →
    (∀ i, Φ (PresentedMonoid.of _ (.tau i)) = σ i - σInv i) →
    Function.Injective Φ

/--
Resolved true: Paris proved Birman's conjecture: for every `n` the desingularization map `SBₙ →
ℤ[Bₙ]`, `σᵢ^{±1} ↦ σᵢ^{±1}`, `τᵢ ↦ σᵢ - σᵢ⁻¹`, is injective (so Vassiliev invariants separate
singular braids). Source: M. Bestvina, Questions in Geometric Group Theory (updated July 2004), Q
12.23 (Birman's conjecture), https://www.math.utah.edu/~bestvina/eprints/questions-updated.pdf;
resolution: L. Paris, The proof of Birman's conjecture on singular braid monoids, Geom. Topol. 8
(2004), 1281-1300, arXiv:math/0306422, Theorem 1.1: "The desingularization map η : SB_n → ℤ[B_n] is
injective", η(σᵢ^{±1}) = σᵢ^{±1}, η(τᵢ) = σᵢ - σᵢ⁻¹, for SB_n with Birman's monoid presentation,
https://arxiv.org/abs/math/0306422.
-/
public theorem_wanted desingularizationInjective_holds : desingularizationInjective

end MathlibExt.GroupTheory.SingularBraidDesingularizationAMR10Problem1223Wanted
