/-
# Branch groups on rooted trees of bounded words

Shared bounded-word definitions for Kourovka Notebook Problems 15.14, 15.15 and 15.17.
-/

module

public import Mathlib.Data.List.Infix
public import Mathlib.GroupTheory.Index

@[expose] public section

/-!
# Shared word-tree branch-group model

This module consolidates the four literal definitions in the WantedExt entries for Kourovka
15.14, 15.15 and 15.17. The semantic origin is
`OpenConjectures/GroupTheory/Kourovka15Problem12/Helper/BranchGroup.lean`, which WantedExt cannot
import under the repository's dependency policy. That helper is a near-copy with a different
form: its carrier is an `abbrev`, its automorphism condition uses membership in `treeAut`, and
its hypotheses have a different order. It is not claimed identical and is not consolidated here.

The model is the geometric definition of L. Bartholdi, R. I. Grigorchuk and Z. Šunić,
*Branch groups*, Handbook of Algebra 3 (2003), arXiv:math/0510294, Definition 1.13 on the trees
of words with all `m i ≥ 2` of Section 1.2. Their open-problems chapter uses it for Problems
15.14(b), 15.14(c), 15.15, 15.17 and 15.18 (Questions 20, 15, 14, 10, 9 and 11).

This word-tree model is distinct from the abstract model in `BranchGroupShared`, associated
with Kourovka 21.116; no equivalence between those models has been proved here.
-/

namespace MathlibExt.GroupTheory.WordTreeBranchGroupShared

/-- The vertices of the spherically homogeneous rooted tree with branching sequence `m`: words whose
`i`-th letter is less than `m i`. The length of a word is its level and its prefixes are its
ancestors. -/
def TreeVertex (m : ℕ → ℕ) : Type :=
  {l : List ℕ // ∀ (i : ℕ) (h : i < l.length), l[i] < m i}

/-- The rigid vertex stabilizer of `v` for an action `ρ` on the tree, as a set: the elements whose
support (the set of vertices they move) lies in the subtree rooted at `v`. -/
def rigidVertexStabilizer {m : ℕ → ℕ} {G : Type*} [Group G] (ρ : G →* Equiv.Perm (TreeVertex m))
    (v : TreeVertex m) : Set G :=
  {g | ∀ w : TreeVertex m, ¬ v.1 <+: w.1 → ρ g w = w}

/-- The `n`-th rigid level stabilizer: the subgroup generated by the rigid vertex stabilizers of all
vertices at level `n`. -/
def rigidLevelStabilizer {m : ℕ → ℕ} {G : Type*} [Group G] (ρ : G →* Equiv.Perm (TreeVertex m))
    (n : ℕ) : Subgroup G :=
  Subgroup.closure (⋃ v ∈ {v : TreeVertex m | v.1.length = n}, rigidVertexStabilizer ρ v)

/-- `G` is a branch group (Kourovka 15.12): it acts faithfully and level-transitively by tree
automorphisms on a spherically homogeneous rooted tree with all branching indices at least `2`, and
every rigid level stabilizer has finite index in `G`. -/
def IsBranchGroup (G : Type*) [Group G] : Prop :=
  ∃ (m : ℕ → ℕ) (_ : ∀ i, 2 ≤ m i) (ρ : G →* Equiv.Perm (TreeVertex m)),
    Function.Injective ρ ∧
    (∀ (g : G) (v w : TreeVertex m), v.1 <+: w.1 ↔ (ρ g v).1 <+: (ρ g w).1) ∧
    (∀ v w : TreeVertex m, v.1.length = w.1.length → ∃ g : G, ρ g v = w) ∧
    ∀ n : ℕ, (rigidLevelStabilizer ρ n).FiniteIndex

-- Focused regression controls for the shared model.

-- A root-support restriction must be vacuous because [] prefixes every word.
example {m : ℕ → ℕ} {G : Type*} [Group G]
    (ρ : G →* Equiv.Perm (TreeVertex m)) :
    rigidVertexStabilizer ρ ⟨[], by simp⟩ = Set.univ := by
  ext g
  constructor
  · intro _
    trivial
  · intro _ w hw
    exact False.elim (hw ⟨w.1, rfl⟩)

-- The level union must include the root's entire stabilizer, and closure must give top.
example {m : ℕ → ℕ} {G : Type*} [Group G]
    (ρ : G →* Equiv.Perm (TreeVertex m)) : rigidLevelStabilizer ρ 0 = ⊤ := by
  unfold rigidLevelStabilizer
  have hU : (⋃ v ∈ {v : TreeVertex m | v.1.length = 0},
      rigidVertexStabilizer ρ v) = Set.univ := by
    ext g
    constructor
    · intro _
      trivial
    · intro _
      refine Set.mem_iUnion.mpr ⟨⟨[], by simp⟩, ?_⟩
      refine Set.mem_iUnion.mpr ⟨rfl, ?_⟩
      intro w hw
      exact False.elim (hw ⟨w.1, rfl⟩)
  rw [hU, Subgroup.closure_univ]

-- Binary letters exclude [2]; siblings are incomparable, and prefix differs from sublist.
example :
    (¬ ∃ v : TreeVertex (fun _ => 2), v.1 = [2]) ∧
    ∃ v w x y : TreeVertex (fun _ => 2),
      v.1 = [0] ∧ w.1 = [1] ∧ x.1 = [0, 1] ∧ y.1 = [1, 0] ∧
      v.1.length = 1 ∧ w.1.length = 1 ∧ v ≠ w ∧
      ¬ v.1 <+: w.1 ∧ ¬ w.1 <+: v.1 ∧ v.1 <+: x.1 ∧ ¬ v.1 <+: y.1 := by
  constructor
  · rintro ⟨v, hv⟩
    have h := v.2 0 (by simp [hv])
    simp [hv] at h
  · let v : TreeVertex (fun _ => 2) := ⟨[0], by
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst i
      simp⟩
    let w : TreeVertex (fun _ => 2) := ⟨[1], by
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst i
      simp⟩
    let x : TreeVertex (fun _ => 2) := ⟨[0, 1], by
      intro i hi
      have hi01 : i = 0 ∨ i = 1 :=
        Nat.le_one_iff_eq_zero_or_eq_one.mp (Nat.le_of_lt_succ hi)
      rcases hi01 with rfl | rfl <;> simp⟩
    let y : TreeVertex (fun _ => 2) := ⟨[1, 0], by
      intro i hi
      have hi01 : i = 0 ∨ i = 1 :=
        Nat.le_one_iff_eq_zero_or_eq_one.mp (Nat.le_of_lt_succ hi)
      rcases hi01 with rfl | rfl <;> simp⟩
    refine ⟨v, w, x, y, rfl, rfl, rfl, rfl, rfl, rfl, ?_, ?_, ?_, ?_, ?_⟩
    · intro h
      have hv := congrArg Subtype.val h
      simp [v, w] at hv
    · decide
    · decide
    · decide
    · decide

-- Branching >= 2 and level-transitivity must exclude a trivial group.
example (G : Type*) [Group G] [Subsingleton G] :
    ¬ IsBranchGroup G := by
  rintro ⟨m, hm, ρ, _, _, ht, _⟩
  let v : TreeVertex m := ⟨[0], by
    intro i hi
    have hi0 : i = 0 := by simpa using hi
    subst i
    simpa using (Nat.zero_lt_of_lt (hm 0))⟩
  let w : TreeVertex m := ⟨[1], by
    intro i hi
    have hi0 : i = 0 := by simpa using hi
    subst i
    exact lt_of_lt_of_le (by decide : 1 < 2) (hm 0)⟩
  obtain ⟨g, hg⟩ := ht v w rfl
  have hg1 : g = 1 := Subsingleton.elim _ _
  have hvw : v = w := by simpa [hg1] using hg
  have hv := congrArg Subtype.val hvw
  simp [v, w] at hv

end MathlibExt.GroupTheory.WordTreeBranchGroupShared
