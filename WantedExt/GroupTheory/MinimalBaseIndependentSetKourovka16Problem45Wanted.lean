/-
# Minimal base size versus independent sets (Kourovka Notebook Problem 16.45)

Kourovka Notebook, Problem 16.45 (P. J. Cameron): is `b(G) = μ'(G)` for every finite group `G`,
where `b(G)` is the largest size of a minimal base over all permutation representations of `G` and
`μ'(G)` is the largest size of an independent set in `G`?
-/

module

public import Batteries.Util.ProofWanted
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Order.Lattice.Nat

@[expose] public section

namespace MathlibExt.GroupTheory.MinimalBaseIndependentSetKourovka16Problem45Wanted

/-!
Source: E. I. Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka
Notebook, 21st issue, arXiv:1401.0300v49 (2026), Problem 16.45 (P. J. Cameron). UnsolvedMath record
UM-00701237 (`KOU-16.45`), dataset ulamai/UnsolvedMath v1.8.0.

Permutation representations are arbitrary actions of `G` on a type `Ω` in `Type`; a base exists only
for a faithful action. A base is a finite set of points, since a minimal base never repeats a point.
Both maxima are `sSup` of sets of naturals that are bounded for finite `G` (by `|G|`), so they are
the actual maxima.
-/

/-- `B` is a base for the action of `G` on `Ω`: its pointwise stabilizer is trivial. -/
def IsBase (G Ω : Type) [Group G] [MulAction G Ω] (B : Finset Ω) : Prop :=
  ∀ g : G, (∀ ω ∈ B, g • ω = ω) → g = 1

open Classical in
/-- `B` is a minimal base: a base from which no point can be removed. -/
def IsMinimalBase (G Ω : Type) [Group G] [MulAction G Ω] (B : Finset Ω) : Prop :=
  IsBase G Ω B ∧ ∀ ω ∈ B, ¬ IsBase G Ω (B.erase ω)

/-- `b(G)`: the largest size of a minimal base of `G` over all permutation representations of
`G` (actions on arbitrary sets `Ω`). -/
noncomputable def maxMinimalBaseSize (G : Type) [Group G] : ℕ :=
  sSup {k | ∃ (Ω : Type) (_ : MulAction G Ω) (B : Finset Ω), IsMinimalBase G Ω B ∧ B.card = k}

open Classical in
/-- `S` is independent: no element of `S` lies in the subgroup generated by the others. -/
def IsIndependent {G : Type} [Group G] (S : Finset G) : Prop :=
  ∀ s ∈ S, s ∉ Subgroup.closure ((S.erase s : Finset G) : Set G)

/-- `μ'(G)`: the largest size of an independent subset of `G`. -/
noncomputable def maxIndependentSize (G : Type) [Group G] : ℕ :=
  sSup {k | ∃ S : Finset G, IsIndependent S ∧ S.card = k}

/-- Kourovka 16.45 (P. J. Cameron): `b(G) = μ'(G)` for every finite group `G`. -/
def maxMinimalBaseSizeEqMaxIndependentSize : Prop :=
  ∀ (G : Type) [Group G] [Finite G], maxMinimalBaseSize G = maxIndependentSize G

/--
Resolved false: Kriebel's affine group `G = F₂₉² ⋊ SL₂(5)` of order 100920 has `b(G) = 3 < 4 =
μ'(G)` (over all permutation representations, faithful or not); the Kourovka Notebook (21st issue)
marks 16.45 solved, "No, not always", with the AI solution confirmed by P. J. Cameron. Source: E. I.
Khukhro and V. D. Mazurov (eds.), Unsolved Problems in Group Theory: The Kourovka Notebook, 21st
issue, arXiv:1401.0300v49 (2026), Problem 16.45 (P. J. Cameron); resolution: A. Kriebel, A
counterexample to Kourovka Notebook Problem 16.45, preprint, Zenodo record 22929486 (2026), main
theorem: G = F_29^2 ⋊ SL_2(5) of order 100920 has b(G) = 3 < 4 = μ'(G); the Kourovka Notebook (21st
issue) marks 16.45 solved (AI solution confirmed by P. J. Cameron),
https://zenodo.org/records/22929486.
-/
public theorem_wanted maxMinimalBaseSizeEqMaxIndependentSize_refuted :
    ¬ maxMinimalBaseSizeEqMaxIndependentSize

end MathlibExt.GroupTheory.MinimalBaseIndependentSetKourovka16Problem45Wanted
