module

public import Batteries.Util.ProofWanted
public import Mathlib

@[expose] public section

namespace MathlibExt.GroupTheory.SchurWeylWanted
namespace RepresentationTheory

open scoped TensorProduct

/-!
Schur–Weyl duality on `V^⊗k`.

Two commuting actions on `V^⊗k`:

* `symAction`: the symmetric group `S_k` acts by permuting tensor factors.
* `glAction`: the general linear group `GL(V)` acts diagonally as `g · (v₁ ⊗ ⋯ ⊗ v_k) =
  (g v₁) ⊗ ⋯ ⊗ (g v_k)`.

Schur–Weyl duality says their images in `End(V^⊗k)` generate mutual centralizers. We state
the two directions as separate `eval_problem`s.
-/

/-- **Permutation action of the symmetric group on tensor powers.** Let $R$ be a commutative
semiring, $M$ an $R$-module and $k$ a natural number. The symmetric group $S_k$ of permutations of
$\{1, \dots, k\}$ acts on the $k$-th tensor power $M^{\otimes k}$ by permuting tensor factors: this
is the monoid homomorphism from $S_k$ to the $R$-linear endomorphisms of $M^{\otimes k}$ that sends
$\sigma$ to the map $v_1 \otimes \cdots \otimes v_k \mapsto
v_{\sigma^{-1}(1)} \otimes \cdots \otimes v_{\sigma^{-1}(k)}$. -/
def symAction (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M] (k : ℕ) :
    Equiv.Perm (Fin k) →* Module.End R (⨂[R]^k M) where
  toFun σ := (PiTensorProduct.reindex R (fun _ : Fin k => M) σ).toLinearMap
  map_one' := by
    ext x
    simp only [LinearEquiv.coe_coe, LinearMap.coe_compMultilinearMap, Function.comp_apply,
      PiTensorProduct.reindex_tprod, Module.End.one_apply]
    rfl
  map_mul' σ τ := by
    ext x
    simp only [Module.End.mul_apply, LinearEquiv.coe_coe, LinearMap.coe_compMultilinearMap,
      Function.comp_apply, PiTensorProduct.reindex_tprod]
    rfl

/-- **Diagonal action of the general linear group on tensor powers.** Let $R$ be a commutative
semiring, $M$ an $R$-module and $k$ a natural number. Write $\mathrm{GL}(M)$ for the group of
invertible $R$-linear endomorphisms of $M$. The diagonal action of $\mathrm{GL}(M)$ on the $k$-th
tensor power $M^{\otimes k}$ is the monoid homomorphism from $\mathrm{GL}(M)$ to the
$R$-linear endomorphisms of $M^{\otimes k}$ that sends $g$ to $g^{\otimes k}$, so that
$g \cdot (v_1 \otimes \cdots \otimes v_k) = g v_1 \otimes \cdots \otimes g v_k$. -/
def glAction (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M] (k : ℕ) :
    (M →ₗ[R] M)ˣ →* Module.End R (⨂[R]^k M) where
  toFun g := PiTensorProduct.map (fun _ : Fin k => (g : M →ₗ[R] M))
  map_one' := by ext x; simp
  map_mul' g h := by ext x; simp

/- One direction of Schur–Weyl duality: the subalgebra generated by the `S_k` action equals
the centralizer of the subalgebra generated by the `GL(V)` action. The hypothesis
`Invertible (k! : R)` over a field is the Maschke condition for `R[S_k]`. -/
/-- **Schur–Weyl duality: the symmetric group side.** Let $R$ be a field, $M$ a finite-dimensional
vector space over $R$, and $k$ a natural number such that $k!$ is invertible in $R$. In the
algebra of $R$-linear endomorphisms of the tensor power $M^{\otimes k}$, the subalgebra generated
by the image of the action of the symmetric group $S_k$ by permuting tensor factors equals the
centralizer of the image of the diagonal action $g \mapsto g^{\otimes k}$ of $\mathrm{GL}(M)$.

Source: H. Weyl, The Classical Groups, 1939; I. Schur, Über die rationalen Darstellungen der allgemeinen linearen Gruppe, 1927. Via leanprover/lean-eval@38361be, problem `symAction_range_eq_centralizer_glAction`. -/
public theorem_wanted symAction_range_eq_centralizer_glAction
    {R : Type*} [Field R]
    {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
    {k : ℕ} [Invertible (k.factorial : R)] :
    Algebra.adjoin R (Set.range (symAction R M k)) =
      Subalgebra.centralizer R (Set.range (glAction R M k))

/- The other direction of Schur–Weyl duality: the subalgebra generated by the `GL(V)` action
equals the centralizer of the subalgebra generated by the `S_k` action. -/
/-- **Schur–Weyl duality: the general linear side.** Let $R$ be a field, $M$ a finite-dimensional
vector space over $R$, and $k$ a natural number such that $k!$ is invertible in $R$. In the
algebra of $R$-linear endomorphisms of the tensor power $M^{\otimes k}$, the subalgebra generated
by the image of the diagonal action $g \mapsto g^{\otimes k}$ of $\mathrm{GL}(M)$ equals the
centralizer of the image of the action of the symmetric group $S_k$ by permuting tensor factors.

Source: H. Weyl, The Classical Groups, 1939; I. Schur, Über die rationalen Darstellungen der allgemeinen linearen Gruppe, 1927. Via leanprover/lean-eval@38361be, problem `glAction_range_eq_centralizer_symAction`. -/
public theorem_wanted glAction_range_eq_centralizer_symAction
    {R : Type*} [Field R]
    {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
    {k : ℕ} [Invertible (k.factorial : R)] :
    Algebra.adjoin R (Set.range (glAction R M k)) =
      Subalgebra.centralizer R (Set.range (symAction R M k))

end RepresentationTheory

end MathlibExt.GroupTheory.SchurWeylWanted
