/- Finite source parabolic covers from actual involutory generator transitions. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationFiniteCover
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.SetTheory.Cardinal.Finite

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Checked right transitions cover the subgroup generated by actual involutions. -/
theorem y322GeneratedSubgroup_cover {G : Type*} [Group G] {n size : ℕ}
    (generator : Fin n → G) (square : ∀ i, generator i * generator i = 1)
    (K : Subgroup G) (representative : Fin size → G) (base : Fin size)
    (hbase : representative base = 1)
    (step : ∀ i : Fin size, ∀ v : Fin n, ∃ h ∈ K, ∃ j : Fin size,
      representative i * generator v = h * representative j)
    (g : G) (hg : g ∈ Subgroup.closure (Set.range generator)) :
    ∃ h ∈ K, ∃ i : Fin size, g = h * representative i := by
  have advance (x : G) (v : Fin n)
      (hx : ∃ h ∈ K, ∃ i : Fin size, x = h * representative i) :
      ∃ h ∈ K, ∃ i : Fin size, x * generator v = h * representative i := by
    obtain ⟨h, hh, i, rfl⟩ := hx
    obtain ⟨k, hk, j, hj⟩ := step i v
    refine ⟨h * k, K.mul_mem hh hk, j, ?_⟩
    rw [mul_assoc, hj, mul_assoc]
  refine Subgroup.closure_induction_right (p := fun x _ =>
    ∃ h ∈ K, ∃ i : Fin size, x = h * representative i) ?_ ?_ ?_ hg
  · exact ⟨1, K.one_mem, base, by simp [hbase]⟩
  · intro x _ y hy hx
    obtain ⟨v, rfl⟩ := hy
    exact advance x v hx
  · intro x _ y hy hx
    obtain ⟨v, rfl⟩ := hy
    rw [inv_eq_of_mul_eq_one_right (square v)]
    exact advance x v hx

/-- A finite smaller subgroup and checked finite right cover bound the generated subgroup order. -/
theorem y322GeneratedSubgroup_finite_card {G : Type*} [Group G] {n size : ℕ}
    (generator : Fin n → G) (square : ∀ i, generator i * generator i = 1)
    (K : Subgroup G) [Finite K] (representative : Fin size → G) (base : Fin size)
    (hbase : representative base = 1)
    (hK : K ≤ Subgroup.closure (Set.range generator))
    (hrep : ∀ i, representative i ∈ Subgroup.closure (Set.range generator))
    (step : ∀ i : Fin size, ∀ v : Fin n, ∃ h ∈ K, ∃ j : Fin size,
      representative i * generator v = h * representative j) :
    Finite (Subgroup.closure (Set.range generator)) ∧
      Nat.card (Subgroup.closure (Set.range generator)) ≤ Nat.card K * size := by
  let P := Subgroup.closure (Set.range generator)
  let f : K × Fin size → P := fun x =>
    ⟨x.1.val * representative x.2, P.mul_mem (hK x.1.property) (hrep x.2)⟩
  have hs : Function.Surjective f := by
    intro g
    obtain ⟨h, hh, i, hi⟩ := y322GeneratedSubgroup_cover generator square K
      representative base hbase step g.val g.property
    refine ⟨(⟨h, hh⟩, i), ?_⟩
    apply Subtype.ext
    exact hi.symm
  refine ⟨Finite.of_surjective f hs, ?_⟩
  simpa only [Nat.card_prod, Nat.card_fin] using Nat.card_le_card_of_surjective f hs

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
