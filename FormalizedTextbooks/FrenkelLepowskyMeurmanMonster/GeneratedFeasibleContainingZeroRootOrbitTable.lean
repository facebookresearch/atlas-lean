/-! Full actual preferred-root transport tree under three genuine source and first-root fixers. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped Matrix BigOperators
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 100000
set_option maxHeartbeats 120000000

/-- Physical array of the original Xi conjugator, evaluated from checked strong letters. -/
def generatedFeasibleContainingZeroXiConjugatorArray : Fin 24 → Fin 24 :=
  golayStrongWordArray [0, 27, 14]

/-- Physical array of the actual inverse original word. -/
def generatedFeasibleContainingZeroXiConjugatorInverseArray : Fin 24 → Fin 24 :=
  golayStrongWordArray [0, 13, 14]

/-- The actual conjugator preserves the entire source and sends the positive first pair to 1−2. -/
theorem generatedFeasibleContainingZeroXiConjugatorArray_flags :
    generatedFeasibleContainingZeroXiConjugatorArray 0 = 1 ∧
    generatedFeasibleContainingZeroXiConjugatorArray 1 = 2 ∧
    ∀ i : Fin 24, (generatedFeasibleContainingZeroXiConjugatorArray i).val < 8 ↔ i.val < 8 := by
  decide +kernel

/-- The displayed inverse array is the actual inverse physical permutation. -/
theorem generatedFeasibleContainingZeroXiConjugatorArray_inverse :
    ∀ i : Fin 24,
      generatedFeasibleContainingZeroXiConjugatorArray
        (generatedFeasibleContainingZeroXiConjugatorInverseArray i) = i := by
  decide +kernel

/-- Twice each complete physical action, including the exact rational Xi block numerator. -/
def generatedFeasibleContainingZeroRootNumerator (k : Fin 3)
    (u : Fin 24 → ℤ) (i : Fin 24) : ℤ :=
  if k = 0 then 2 * u (golayStrongWordArray [18, 23, 19, 11, 13, 6, 5] i)
  else if k = 1 then 2 * u (golayStrongLetterArray 25 i)
  else ∑ j : Fin 24,
    if co1XiNumerator (generatedFeasibleContainingZeroXiConjugatorArray i) j = 0 then 0
    else co1XiNumerator (generatedFeasibleContainingZeroXiConjugatorArray i) j *
      u (generatedFeasibleContainingZeroXiConjugatorInverseArray j)

/-- The inverse original support words agree with their complete physical arrays. -/
theorem generatedFeasibleContainingZeroRootMonomial_inverse :
    ∀ i : Fin 24,
      generatedFeasibleContainingZeroSupportLetterArray 0
        (golayStrongWordArray [18, 23, 19, 11, 13, 6, 5] i) = i ∧
      generatedFeasibleContainingZeroSupportLetterArray 1
        (golayStrongLetterArray 25 i) = i := by
  decide +kernel

/-- Every generator retains the positive physical first root, with its exact orientation. -/
theorem generatedFeasibleContainingZeroRootNumerator_first :
    ∀ k : Fin 3, ∀ i : Fin 24,
      generatedFeasibleContainingZeroRootNumerator k
        (fun j => if j = 0 then 4 else if j = 1 then -4 else 0) i =
      2 * (if i = 0 then 4 else if i = 1 then -4 else 0) := by
  decide +kernel

