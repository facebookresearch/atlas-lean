module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationTenthE7SignedAnchorEnumeration

/-! Original source data for nine prospective actual signed-anchor generators.
The coordinate certificates below do not assert full-axis fixation. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option maxRecDepth 100000
set_option backward.isDefEq.respectTransparency false

/-- The complete seven-point original Golay source words of the two flag generators. -/
def generatedTenthAxisLowerRecoveryPermutationSource : Fin 2 → Fin 7 → Fin 129 :=
  ![![1, 32, 61, 70, 107, 125, 128],
    ![0, 29, 67, 89, 106, 125, 128]]

/-- Each source word is an actual product of certified original Golay automorphisms. -/
def generatedTenthAxisLowerRecoveryPermutation (k : Fin 2) : golayAutomorphismSubgroup :=
  ((List.finRange 7).map fun j =>
    golayStabilizerAutomorphism (generatedTenthAxisLowerRecoveryPermutationSource k j)).prod

/-- All twenty-four original forward coordinates of the two actual source words. -/
def generatedTenthAxisLowerRecoveryPermutationForward : Fin 2 → Fin 24 → Fin 24 :=
  ![![1, 3, 2, 0, 4, 5, 6, 7, 23, 20, 22, 21, 9, 10, 8, 11, 18, 17, 19, 16, 12, 15, 13, 14],
    ![0, 6, 7, 3, 5, 4, 2, 1, 8, 17, 10, 19, 15, 22, 13, 20, 18, 11, 16, 9, 21, 12, 23, 14]]

/-- The full original source words have exactly the specified actual coordinate actions. -/
theorem generatedTenth_axis_lower_recovery_source_forward : ∀ k : Fin 2, ∀ i : Fin 24,
    (generatedTenthAxisLowerRecoveryPermutation k).val i =
      generatedTenthAxisLowerRecoveryPermutationForward k i := by
  decide +kernel

/-- Full preservation of the actual octad, normal pair, and companion code by both words. -/
theorem generatedTenth_axis_lower_recovery_source_flags : ∀ k : Fin 2,
    golayPermute (generatedTenthAxisLowerRecoveryPermutation k).val golayStandardOctad =
      golayStandardOctad ∧
    (∀ i : Fin 24, i = 4 ∨ i = 5 ↔
      (generatedTenthAxisLowerRecoveryPermutation k).val i = 4 ∨
        (generatedTenthAxisLowerRecoveryPermutation k).val i = 5) ∧
    golayPermute (generatedTenthAxisLowerRecoveryPermutation k).val
      (golayEncoder (golayLabelCoefficients 110)) = golayEncoder (golayLabelCoefficients 110) := by
  decide +kernel

/-- The seven actual binary-label basis witnesses of the entire identity-permutation fiber. -/
def generatedTenthAxisLowerRecoverySignBasis : Fin 7 → Fin 4096 :=
  ![4, 11, 97, 290, 547, 1171, 2048]

/-- Every literal binary label gives its genuine original Golay codeword. -/
def generatedTenthAxisLowerRecoveryCode (d : Fin 4096) : golayCode :=
  ⟨golayEncoder (golayLabelCoefficients d), ⟨_, rfl⟩⟩

/-- Every basis code satisfies the entire actual identity-permutation correction condition. -/
theorem generatedTenth_axis_lower_recovery_sign_basis_valid : ∀ k : Fin 7,
    generatedTenthE7StandardTwistedSignCondition 0
      (generatedTenthAxisLowerRecoveryCode (generatedTenthAxisLowerRecoverySignBasis k)) := by
  unfold generatedTenthE7StandardTwistedSignCondition
  decide +kernel

/-- All 128 original code labels generated by the seven binary basis witnesses. -/
def generatedTenthAxisLowerRecoveryBinarySignLabel : Fin 128 → Fin 4096 :=
  ![0, 4, 11, 15, 97, 101, 106, 110, 290, 294, 297, 301, 323, 327, 328, 332, 547, 551, 552, 556,
    578, 582, 585, 589, 769, 773, 778, 782, 864, 868, 875, 879, 1171, 1175, 1176, 1180, 1266,
    1270, 1273, 1277, 1457, 1461, 1466, 1470, 1488, 1492, 1499, 1503, 1712, 1716, 1723, 1727,
    1745, 1749, 1754, 1758, 1938, 1942, 1945, 1949, 2035, 2039, 2040, 2044, 2048, 2052, 2059,
    2063, 2145, 2149, 2154, 2158, 2338, 2342, 2345, 2349, 2371, 2375, 2376, 2380, 2595, 2599,
    2600, 2604, 2626, 2630, 2633, 2637, 2817, 2821, 2826, 2830, 2912, 2916, 2923, 2927, 3219,
    3223, 3224, 3228, 3314, 3318, 3321, 3325, 3505, 3509, 3514, 3518, 3536, 3540, 3547, 3551,
    3760, 3764, 3771, 3775, 3793, 3797, 3802, 3806, 3986, 3990, 3993, 3997, 4083, 4087, 4088,
    4092]

/-- The actual binary sum of the seven original code basis elements. -/
def generatedTenthAxisLowerRecoveryBinarySign (b : Fin 128) : golayCode :=
  ∑ k : Fin 7, (if b.val.testBit k.val then (1 : ZMod 2) else 0) •
    generatedTenthAxisLowerRecoveryCode (generatedTenthAxisLowerRecoverySignBasis k)

/-- Every one of the 128 binary words binds every actual original code coordinate. -/
theorem generatedTenth_axis_lower_recovery_binary_sign_actual : ∀ b : Fin 128,
    generatedTenthAxisLowerRecoveryBinarySign b =
      generatedTenthAxisLowerRecoveryCode (generatedTenthAxisLowerRecoveryBinarySignLabel b) := by
  decide +kernel

/-- All original binary-label witnesses are distinct. -/
theorem generatedTenth_axis_lower_recovery_binary_sign_labels_injective :
    Function.Injective generatedTenthAxisLowerRecoveryBinarySignLabel := by
  decide +kernel

/-- Each of the full 128 original signs lies in the actual identity-permutation fiber. -/
theorem generatedTenth_axis_lower_recovery_binary_sign_valid : ∀ b : Fin 128,
    generatedTenthE7StandardTwistedSignCondition 0
      (generatedTenthAxisLowerRecoveryBinarySign b) := by
  intro b
  rw [generatedTenth_axis_lower_recovery_binary_sign_actual]
  have h : ∀ b : Fin 128, generatedTenthE7StandardTwistedSignCondition 0
      (generatedTenthAxisLowerRecoveryCode (generatedTenthAxisLowerRecoveryBinarySignLabel b)) := by
    unfold generatedTenthE7StandardTwistedSignCondition
    decide +kernel
  exact h b

/-- One actual correcting code for each original permutation source word. -/
def generatedTenthAxisLowerRecoveryPermutationCodeLabel : Fin 2 → Fin 4096 := ![32, 2]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
