/-- Every chronological equation is derived from a literal source or its earlier equations. -/
theorem y322TCContextProgram_checked (i : Fin 28530) :
    y322ContextEquationProgramChecked (y322FiniteEquationSource y322TransportProgram)
      y322TCContextProgram i := by
  let block : Fin 112 := ⟨i.val / 256, by omega⟩
  let offset : Fin 256 := ⟨i.val % 256, Nat.mod_lt _ (by decide)⟩
  have h := y322TCContextReplayBlock block offset
  have he : block.val * 256 + offset.val = i.val := by
    dsimp [block, offset]
    omega
  rw [he] at h
  simpa only [y322TCContextCheckAt, dite_eq_left i.isLt] using h

/-- All literal TC equations hold in the original independently presented C322 group. -/
theorem y322TCContextProgram_valid (i : Fin 28530) :
    (y322TCContextProgram i).1.Valid (y322FiniteAuxiliaryValue y322TransportProgram) := by
  exact y322ContextEquationProgram_valid _ _
    (y322FiniteEquationSource_valid y322TransportProgram) _ y322TCContextProgram_checked i

