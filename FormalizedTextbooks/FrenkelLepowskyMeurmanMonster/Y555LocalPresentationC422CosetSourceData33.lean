    y322RawEquationWordAllowed 9042 (y422CosetSourceRaw33 i).1 ∧
      y322RawEquationWordAllowed 9042 (y422CosetSourceRaw33 i).2 := by
  revert i
  decide +kernel

/-- Exact decoded source equation, preserving every bound-checked signed letter. -/
