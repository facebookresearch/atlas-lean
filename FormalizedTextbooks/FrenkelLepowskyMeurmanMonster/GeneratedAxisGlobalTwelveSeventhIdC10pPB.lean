  show selfOctB 48 s7c10pW (ShortData.ofList s7c10pGT).oct = _
  simp only [s7c10pGT, ofList_oct_append, selfOctB_append]
  linarith [s7c10p_hn_s0, s7c10p_hn_s1, s7c10p_hn_s2]

