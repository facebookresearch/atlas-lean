-- Check every entry of this finite actual transport matrix in the Lean kernel.
/-- Every column of transport 3 is its actual Conway binary action. -/
theorem monsterCo1GeometryVectorPoint3Transport_binary (v : Fin 24 → ZMod 2) :
    co1BinaryAction monsterCo1GeometryVectorPoint3Transport v =
      monsterCo1GeometryVectorPoint3Matrix *ᵥ v := by
  apply monsterCo1GeometryTransport_matrix_of_columns
  intro t
  change leechBinaryAction (omegaOrbitWordIsometry (omegaOrbitWords 3))
    (Pi.single t 1) = _
  rw [← omegaOrbitWord_binary]
  have hc : ∀ t : Fin 24,
      (omegaOrbitWords 3).foldl (fun v k => omegaOrbitBinaryMatrices k *ᵥ v)
        (Pi.single t 1) = monsterCo1GeometryVectorPoint3Matrix *ᵥ Pi.single t 1 := by
    decide +kernel
  exact hc t

