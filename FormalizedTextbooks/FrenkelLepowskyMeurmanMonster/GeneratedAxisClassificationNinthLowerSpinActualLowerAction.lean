module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationNinthLowerSpinActualLowerDirections

/-! The finite actual source subgroup and its honest permutation homomorphism on nine spaces. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The eleven actual transported source elements in the genuine Conway quotient. -/
def generatedNinthLowerSpinActualGenerator (i : Fin 11) : Co1 :=
  QuotientGroup.mk (generatedNinthAffineLowerTransportedIsometry i)

/-- The actual Conway subgroup generated by all eleven genuine complete source classes. -/
def generatedNinthLowerSpinActualGroup : Subgroup Co1 :=
  Subgroup.closure (Set.range generatedNinthLowerSpinActualGenerator)

/-- Actual Co1 elements that permute the entire nine-space family with an explicit permutation. -/
def generatedNinthLowerSpinActualFamilyGroup : Subgroup Co1 where
  carrier := {g | ∃ p : Equiv.Perm (Fin 9), ∀ i : Fin 9,
    generatedNinthLowerSpinActualClassMap g (generatedNinthAffineDirectionClassSpace i) =
      generatedNinthAffineDirectionClassSpace (p i)}
  one_mem' := by
    refine ⟨1, ?_⟩
    intro i
    exact generatedNinth_lower_spin_actual_class_map_one _
  mul_mem' := by
    rintro g h ⟨p, hp⟩ ⟨q, hq⟩
    refine ⟨p * q, ?_⟩
    intro i
    rw [generatedNinth_lower_spin_actual_class_map_mul, hq, hp]
    rfl
  inv_mem' := by
    rintro g ⟨p, hp⟩
    refine ⟨p⁻¹, ?_⟩
    intro i
    have he := congrArg (generatedNinthLowerSpinActualClassMap g⁻¹) (hp (p⁻¹ i))
    rw [← generatedNinth_lower_spin_actual_class_map_mul, inv_mul_cancel,
      generatedNinth_lower_spin_actual_class_map_one] at he
    have hi : p (p⁻¹ i) = i := p.apply_symm_apply i
    rw [hi] at he
    exact he.symm

/-- Every actual source generator permutes all nine entire direction spaces. -/
theorem generatedNinth_lower_spin_actual_generator_family (i : Fin 11) :
    generatedNinthLowerSpinActualGenerator i ∈ generatedNinthLowerSpinActualFamilyGroup :=
  ⟨generatedNinthAffineLowerFiberPermutation i,
    generatedNinth_lower_spin_actual_class_map_generator i⟩

/-- Closure of the actual source words still permutes the full nine-space family. -/
theorem generatedNinth_lower_spin_actual_group_le_family :
    generatedNinthLowerSpinActualGroup ≤ generatedNinthLowerSpinActualFamilyGroup := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, rfl⟩
  exact generatedNinth_lower_spin_actual_generator_family i

/-- Choose the permutation supplied by actual full-family preservation. Distinct spaces make
this choice unique and force the homomorphism laws below. -/
def generatedNinthLowerSpinActualPermutation (g : generatedNinthLowerSpinActualGroup) :
    Equiv.Perm (Fin 9) :=
  Classical.choose (generatedNinth_lower_spin_actual_group_le_family g.property)

/-- The chosen finite permutation is the action on each entire actual direction submodule. -/
theorem generatedNinth_lower_spin_actual_permutation_map
    (g : generatedNinthLowerSpinActualGroup) (i : Fin 9) :
    generatedNinthLowerSpinActualClassMap g.val (generatedNinthAffineDirectionClassSpace i) =
      generatedNinthAffineDirectionClassSpace (generatedNinthLowerSpinActualPermutation g i) :=
  Classical.choose_spec (generatedNinth_lower_spin_actual_group_le_family g.property) i

/-- The actual subgroup has an honest homomorphism to permutations of the nine full spaces. -/
def generatedNinthLowerSpinActualPermutationHom :
    generatedNinthLowerSpinActualGroup →* Equiv.Perm (Fin 9) where
  toFun := generatedNinthLowerSpinActualPermutation
  map_one' := by
    apply Equiv.ext
    intro i
    apply generatedNinth_lower_spin_actual_direction_spaces_injective
    have hm := generatedNinth_lower_spin_actual_permutation_map
      (1 : generatedNinthLowerSpinActualGroup) i
    rw [Subgroup.coe_one] at hm
    exact hm.symm.trans (generatedNinth_lower_spin_actual_class_map_one _)
  map_mul' g h := by
    apply Equiv.ext
    intro i
    apply generatedNinth_lower_spin_actual_direction_spaces_injective
    have hm := generatedNinth_lower_spin_actual_permutation_map (g * h) i
    rw [Subgroup.coe_mul] at hm
    exact hm.symm.trans
      ((generatedNinth_lower_spin_actual_class_map_mul g.val h.val
        (generatedNinthAffineDirectionClassSpace i)).trans
          ((congrArg (generatedNinthLowerSpinActualClassMap g.val)
            (generatedNinth_lower_spin_actual_permutation_map h i)).trans
              (generatedNinth_lower_spin_actual_permutation_map g
                (generatedNinthLowerSpinActualPermutation h i))))

/-- Every full original source class is a genuine member of the subgroup it generates. -/
def generatedNinthLowerSpinActualGroupGenerator (i : Fin 11) :
    generatedNinthLowerSpinActualGroup :=
  ⟨generatedNinthLowerSpinActualGenerator i, Subgroup.subset_closure ⟨i, rfl⟩⟩

/-- All eleven finite permutation images are their original source-bound full-fiber actions. -/
theorem generatedNinth_lower_spin_actual_generator_permutation (i : Fin 11) :
    generatedNinthLowerSpinActualPermutationHom (generatedNinthLowerSpinActualGroupGenerator i) =
      generatedNinthAffineLowerFiberPermutation i := by
  apply Equiv.ext
  intro j
  change generatedNinthLowerSpinActualPermutation
    (generatedNinthLowerSpinActualGroupGenerator i) j =
      generatedNinthAffineLowerFiberPermutation i j
  apply generatedNinth_lower_spin_actual_direction_spaces_injective
  have hm := generatedNinth_lower_spin_actual_permutation_map
    (generatedNinthLowerSpinActualGroupGenerator i) j
  change generatedNinthLowerSpinActualClassMap
    (generatedNinthLowerSpinActualGenerator i) (generatedNinthAffineDirectionClassSpace j) = _
      at hm
  exact hm.symm.trans (generatedNinth_lower_spin_actual_class_map_generator i j)
end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
