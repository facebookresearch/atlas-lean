/- The same five genuine orbit operators generate the full actual Conway group. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationCo1GeometryFiveCodeOrbit
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismGeneration
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LeechConcreteGeneration
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1OrderMonomial

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false

/-- The actual subgroup generated by the five lattice isometries in the orbit certificate. -/
def monsterCo1FiveIsometrySubgroup : Subgroup leechIsomSubgroup :=
  Subgroup.closure (Set.range omegaOrbitIsometry)

/-- Both original physical Golay permutations belong to the actual five-generator subgroup. -/
theorem monsterCo1Five_permutation_generator_mem (k : Fin 2) :
    golayPermutationIsometry (omegaOrbitGolayPermutation k) ∈ monsterCo1FiveIsometrySubgroup := by
  fin_cases k
  · exact Subgroup.subset_closure ⟨3, rfl⟩
  · exact Subgroup.subset_closure ⟨4, rfl⟩

/-- The independently checked M24 generation theorem supplies all actual permutation isometries. -/
theorem monsterCo1Five_permutation_mem (p : golayAutomorphismSubgroup) :
    golayPermutationIsometry p ∈ monsterCo1FiveIsometrySubgroup := by
  have h : golayTwoGeneratorSubgroup ≤
      monsterCo1FiveIsometrySubgroup.comap golayPermutationHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    exact monsterCo1Five_permutation_generator_mem k
  rw [golayTwoGeneratorSubgroup_eq_top] at h
  exact h (Subgroup.mem_top p)

/-- The two actual starting sign codewords belong to the genuine five-generator subgroup. -/
theorem monsterCo1Five_seed_mem (j : Fin 12) :
    golaySignIsometry (monsterCo1GeometrySignCode (monsterCo1FiveCodeSeed j)) ∈
      monsterCo1FiveIsometrySubgroup := by
  have hs : ∀ i : Fin 12, monsterCo1FiveCodeSeed i = 4 ∨ monsterCo1FiveCodeSeed i = 5 := by
    decide +kernel
  rcases hs j with h | h
  · rw [h]
    exact Subgroup.subset_closure ⟨1, rfl⟩
  · rw [h]
    exact Subgroup.subset_closure ⟨2, rfl⟩

/-- Literal permutation conjugation transports actual sign lifts inside the genuine subgroup. -/
theorem monsterCo1Five_sign_permute_mem (c : golayCode)
    (hc : golaySignIsometry c ∈ monsterCo1FiveIsometrySubgroup) (k : Fin 2) :
    golaySignIsometry (golayCodePermutation (omegaOrbitGolayPermutation k) c) ∈
      monsterCo1FiveIsometrySubgroup := by
  have he : golaySignIsometry (golayCodePermutation (omegaOrbitGolayPermutation k) c) =
      (golayPermutationIsometry (omegaOrbitGolayPermutation k) * golaySignIsometry c) *
        (golayPermutationIsometry (omegaOrbitGolayPermutation k))⁻¹ := by
    rw [golayPermutation_sign_commute]
    simp only [mul_assoc, mul_inv_cancel, mul_one]
  rw [he]
  exact monsterCo1FiveIsometrySubgroup.mul_mem
    (monsterCo1FiveIsometrySubgroup.mul_mem (monsterCo1Five_permutation_generator_mem k) hc)
    (monsterCo1FiveIsometrySubgroup.inv_mem (monsterCo1Five_permutation_generator_mem k))

/-- Every literal permutation-transported starting sign has a genuine subgroup word. -/
theorem monsterCo1Five_sign_word_mem (w : List (Fin 2)) (c : golayCode)
    (hc : golaySignIsometry c ∈ monsterCo1FiveIsometrySubgroup) :
    golaySignIsometry (w.foldl
      (fun d k => golayCodePermutation (omegaOrbitGolayPermutation k) d) c) ∈
      monsterCo1FiveIsometrySubgroup := by
  induction w generalizing c with
  | nil => exact hc
  | cons k w ih => exact ih _ (monsterCo1Five_sign_permute_mem c hc k)

/-- All twelve actual spanning orbit sign codewords have genuine five-generator lifts. -/
theorem monsterCo1Five_orbit_sign_mem (j : Fin 12) :
    golaySignIsometry (monsterCo1FiveOrbitCode j) ∈ monsterCo1FiveIsometrySubgroup :=
  monsterCo1Five_sign_word_mem _ _ (monsterCo1Five_seed_mem j)

/-- Actual sign-code membership in the five-generator subgroup is a binary linear condition. -/
def monsterCo1FiveSignPreimage : Submodule (ZMod 2) golayCode where
  carrier := {c | golaySignIsometry c ∈ monsterCo1FiveIsometrySubgroup}
  zero_mem' := by
    change golaySignHom 1 ∈ monsterCo1FiveIsometrySubgroup
    rw [map_one]
    exact monsterCo1FiveIsometrySubgroup.one_mem
  add_mem' := by
    intro a b ha hb
    change golaySignHom (Multiplicative.ofAdd a * Multiplicative.ofAdd b) ∈
      monsterCo1FiveIsometrySubgroup
    rw [map_mul]
    exact monsterCo1FiveIsometrySubgroup.mul_mem ha hb
  smul_mem' a c hc := by
    have hs : ∀ t : ZMod 2, t = 0 ∨ t = 1 := by decide +kernel
    rcases hs a with rfl | rfl
    · rw [zero_smul]
      change golaySignHom 1 ∈ monsterCo1FiveIsometrySubgroup
      rw [map_one]
      exact monsterCo1FiveIsometrySubgroup.one_mem
    · simpa only [one_smul] using hc

/-- Each original encoder-basis sign is supplied by the exact actual orbit-code sum certificate. -/
theorem monsterCo1Five_basis_sign_mem (k : Fin 12) :
    golaySignIsometry (monsterCo1GeometrySignCode k) ∈ monsterCo1FiveIsometrySubgroup := by
  change monsterCo1GeometrySignCode k ∈ monsterCo1FiveSignPreimage
  rw [← monsterCo1FiveCodeExpansion_certificate k]
  apply Submodule.sum_mem
  intro j _
  exact monsterCo1Five_orbit_sign_mem j

/-- Every actual Golay codeword sign is generated by the same five actual isometries. -/
theorem monsterCo1Five_sign_mem (c : golayCode) :
    golaySignIsometry c ∈ monsterCo1FiveIsometrySubgroup := by
  obtain ⟨a, ha⟩ := c.property
  have he : c = ∑ j, a j • monsterCo1GeometrySignCode j := by
    apply Subtype.ext
    simp only [Submodule.coe_sum, Submodule.coe_smul, monsterCo1GeometrySignCode]
    have hx : a = ∑ j, a j • (Pi.single j 1 : Fin 12 → ZMod 2) := by
      ext i
      simp [Pi.single_apply]
    simp only [← map_smul]
    rw [← map_sum, ← hx]
    exact ha.symm
  change c ∈ monsterCo1FiveSignPreimage
  rw [he]
  apply Submodule.sum_mem
  intro j _
  exact Submodule.smul_mem _ _ (monsterCo1Five_basis_sign_mem j)

/-- The constructive actual Co0 generation theorem identifies the five-isometry closure with Co0. -/
theorem monsterCo1FiveIsometrySubgroup_eq_top : monsterCo1FiveIsometrySubgroup = ⊤ := by
  apply top_unique
  rw [← leechConcreteGeneratorSubgroup_eq_top]
  apply (Subgroup.closure_le _).mpr
  rintro e ((⟨c, rfl⟩ | ⟨p, rfl⟩) | rfl)
  · exact monsterCo1Five_sign_mem c
  · exact monsterCo1Five_permutation_mem p
  · exact Subgroup.subset_closure ⟨0, rfl⟩

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
