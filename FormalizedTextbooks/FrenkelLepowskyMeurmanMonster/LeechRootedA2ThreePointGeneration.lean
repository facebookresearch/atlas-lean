module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LeechRootedA2ThreePointWords

/-! The original nine strong generators generate the entire actual three-point stabilizer. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- Actual subgroup generated by the nine source-bound three-point strong generators. -/
def leechRootedA2ThreePointStrongSubgroup : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range fun j =>
    golayStrongAutomorphism (leechRootedA2ThreePointStrongIndex j))

private theorem letter_mem (t : Fin 28)
    (ht : ∃ j : Fin 9, t.val = (leechRootedA2ThreePointStrongIndex j).val ∨
      t.val = (leechRootedA2ThreePointStrongIndex j).val + 14) :
    golayStrongLetter t ∈ leechRootedA2ThreePointStrongSubgroup := by
  obtain ⟨j, hj | hj⟩ := ht
  · have hlt : t.val < 14 := by rw [hj]; exact (leechRootedA2ThreePointStrongIndex j).isLt
    unfold golayStrongLetter
    simp only [hlt, dite_true]
    have he : (⟨t.val, hlt⟩ : Fin 14) = leechRootedA2ThreePointStrongIndex j := Fin.ext hj
    rw [he]
    exact Subgroup.subset_closure ⟨j, rfl⟩
  · have hlt : ¬ t.val < 14 := by omega
    unfold golayStrongLetter
    simp only [hlt, dite_false]
    have he : (⟨t.val - 14, by omega⟩ : Fin 14) =
        leechRootedA2ThreePointStrongIndex j := by
      apply Fin.ext
      change t.val - 14 = (leechRootedA2ThreePointStrongIndex j).val
      omega
    rw [he]
    exact leechRootedA2ThreePointStrongSubgroup.inv_mem (Subgroup.subset_closure ⟨j, rfl⟩)

/-- Each deeper original transversal belongs to the nine-generator subgroup. -/
theorem leechRootedA2ThreePoint_representative_mem (r : Fin 129)
    (hr : 3 ≤ (golayStabilizerRepLevel r).val) :
    golayStabilizerAutomorphism r ∈ leechRootedA2ThreePointStrongSubgroup := by
  have he : golayStrongWord (golayStabilizerStrongWords r) = golayStabilizerAutomorphism r := by
    apply Subtype.ext
    apply Equiv.ext
    intro i
    rw [leechRootedA2StrongWord_apply, golayStabilizerStrongWords_certificate]
    rfl
  rw [← he]
  apply leechRootedA2ThreePointStrongSubgroup.list_prod_mem
  intro g hg
  obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hg
  exact letter_mem t (leechRootedA2ThreePointStrong_word_certificate r hr t ht)

private theorem stabilizer_mem : ∀ n : ℕ, n ≤ 4 →
    ∀ p : golayAutomorphismSubgroup, p ∈ golayPointStabilizer (7 - n) →
      p ∈ leechRootedA2ThreePointStrongSubgroup := by
  intro n
  induction n with
  | zero =>
    intro _ p hp
    have h : p = 1 := golayAutomorphism_eq_one_of_fix_base p (fun j => hp j j.isLt)
    rw [h]
    exact leechRootedA2ThreePointStrongSubgroup.one_mem
  | succ n ih =>
    intro hn p hp
    let k : Fin 7 := ⟨7 - (n + 1), by omega⟩
    let pfix : golayPointStabilizer k.val := ⟨p, hp⟩
    have hi := golayPointStabilizer_image_eligible k pfix
    obtain ⟨r, hr, hri⟩ := golayStabilizerRep_orbit_certificate k _ hi
    let q := golayStabilizerAutomorphism r
    have hq : q ∈ leechRootedA2ThreePointStrongSubgroup :=
      leechRootedA2ThreePoint_representative_mem r (by rw [hr]; dsimp [k]; omega)
    have hnext : q⁻¹ * p ∈ golayPointStabilizer (7 - n) := by
      intro j hj
      have hstep : 7 - n = k.val + 1 := by dsimp [k]; omega
      rw [hstep] at hj
      change q.val.symm (p.val (golayBasePoints j)) = golayBasePoints j
      by_cases hjk : j.val < k.val
      · have hpj := hp j hjk
        have hqj : q.val (golayBasePoints j) = golayBasePoints j :=
          golayStabilizerRep_prefix_certificate r j (by simpa only [hr] using hjk)
        rw [hpj]
        have hh := congrArg q.val.symm hqj
        rw [q.val.symm_apply_apply] at hh
        exact hh.symm
      · have hjeq : j = k := Fin.ext (by omega)
        subst j
        have hqk : q.val (golayBasePoints k) = p.val (golayBasePoints k) := hri
        rw [← hqk, q.val.symm_apply_apply]
    have hrem := ih (by omega) (q⁻¹ * p) hnext
    have hall := leechRootedA2ThreePointStrongSubgroup.mul_mem hq hrem
    simpa only [mul_inv_cancel_left] using hall

/-- The nine source-bound strong generators give the full actual three-point stabilizer. -/
theorem leechRootedA2ThreePointStrongSubgroup_eq :
    leechRootedA2ThreePointStrongSubgroup = golayPointStabilizer 3 := by
  apply le_antisymm
  · rw [leechRootedA2ThreePointStrongSubgroup, Subgroup.closure_le]
    rintro p ⟨j, rfl⟩ k hk
    change (golayStrongAutomorphism (leechRootedA2ThreePointStrongIndex j)).val
      (golayBasePoints k) = golayBasePoints k
    rw [leechRootedA2StrongAutomorphism_apply]
    have hc : golayBasePoints k = Fin.castAdd 21 (⟨k.val, hk⟩ : Fin 3) := by
      let u : Fin 5 := ⟨k.val, by omega⟩
      have hu : Fin.castAdd 2 u = k := Fin.ext rfl
      have h := golayBasePoints_firstFive u
      rw [hu] at h
      exact h.trans (Fin.ext rfl)
    rw [hc]
    exact leechRootedA2ThreePointStrong_fixed j ⟨k.val, hk⟩
  · intro p hp
    exact stabilizer_mem 4 (by decide) p hp

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
