set_option maxRecDepth 10000 in
/-- Each displayed code is an actual weight-eight Golay word. -/
theorem monsterNortonLine01ShortInverseOctad_weight (k : Fin 16) :
    golayMaskWeight (golayEncodedMask (monsterNortonLine01ShortInverseOctadCode k).val) = 8 := by
  revert k
  decide +kernel

set_option maxRecDepth 10000 in
/-- The displayed support is increasing and consists of actual code coordinates. -/
theorem monsterNortonLine01ShortInverseOctad_positions_certificate (k : Fin 16) :
    (∀ j, (golayEncodedMask (monsterNortonLine01ShortInverseOctadCode k).val).testBit
      (monsterNortonLine01ShortInverseOctadPositions k j).val = true) ∧
      StrictMono (monsterNortonLine01ShortInverseOctadPositions k) := by
  revert k
  decide +kernel

/-- The table agrees with the actual sorted octad dictionary, without enumerating all octads. -/
theorem monsterNortonLine01ShortInverseOctad_positions_actual (k : Fin 16) (j : Fin 8) :
    golayOctadCoordinate (monsterNortonOctadIndex (monsterNortonLine01ShortInverseOctadCode k)
      (monsterNortonLine01ShortInverseOctad_weight k)) j =
        monsterNortonLine01ShortInverseOctadPositions k j :=
  monsterNortonOctadIndex_coordinate_of_strictMono _ _ _
    (monsterNortonLine01ShortInverseOctad_positions_certificate k).1
    (monsterNortonLine01ShortInverseOctad_positions_certificate k).2 j

/-- The finite preferred-Q output avoids a noncomputable search over the octad catalogue. -/
def monsterNortonLine01ShortInverseOutputQ (a : Fin 64) (k : Fin 16) : Q :=
  if monsterNortonLine01ShortInverseIsOctad a then
    monsterNortonOctadQSource
      (monsterNortonLine01ShortInverseOctadCode (monsterNortonLine01ShortInverseOctadId a k))
      (monsterNortonLine01ShortInverseOctadPositions (monsterNortonLine01ShortInverseOctadId a k))
      (monsterNortonLine01ShortInverseOctadSigns a k)
  else monsterNortonShortQSource (Sum.inr (Sum.inr
    (monsterNortonLine01ShortInverseOddCode a k, monsterNortonLine01ShortInverseOddCoordinate a k)))

/-- The genuine actual short label associated to the finite preferred-Q output. -/
noncomputable def monsterNortonLine01ShortInverseOutput (a : Fin 64) (k : Fin 16) :
    GriessShortIndex :=
  if monsterNortonLine01ShortInverseIsOctad a then
    Sum.inr (Sum.inl
      (monsterNortonOctadIndex
        (monsterNortonLine01ShortInverseOctadCode (monsterNortonLine01ShortInverseOctadId a k))
        (monsterNortonLine01ShortInverseOctad_weight (monsterNortonLine01ShortInverseOctadId a k)),
          monsterNortonLine01ShortInverseOctadSigns a k))
  else Sum.inr (Sum.inr
    (monsterNortonLine01ShortInverseOddCode a k, monsterNortonLine01ShortInverseOddCoordinate a k))

/-- The finite formula is the full preferred-Q lift of the genuine output label. -/
theorem monsterNortonLine01ShortInverseOutputQ_actual (a : Fin 64) (k : Fin 16) :
    monsterNortonShortQSource (monsterNortonLine01ShortInverseOutput a k) =
      monsterNortonLine01ShortInverseOutputQ a k := by
  unfold monsterNortonLine01ShortInverseOutput monsterNortonLine01ShortInverseOutputQ
  split_ifs
  · exact monsterNortonOctadQSource_actual _ _ _
      (monsterNortonLine01ShortInverseOctad_positions_actual _) _
  · rfl

/-- Eight consecutive source codes form each bounded finite certificate batch. -/
def monsterNortonLine01ShortInverseBatchIndex (b a : Fin 8) : Fin 64 :=
  ⟨8 * b.val + a.val, by omega⟩

