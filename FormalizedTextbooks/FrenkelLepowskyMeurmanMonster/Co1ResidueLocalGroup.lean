module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1UniversalPresentationLineCommutation
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.Subgroup.Center
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-! Actual first-neighborhood groups and their central point quotients, as in
Ivanov II section 2.6. No residue abelianity is assumed in these constructions. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The source group generated by a point and its genuinely collinear neighbors. -/
def co1ResidueLocal (p : MonsterCo1GeometryPoint) : Subgroup Co1UniversalPresentation :=
  Subgroup.closure {g | g = PresentedGroup.of p ∨
    ∃ q, monsterCo1GeometryAdjacent p q ∧ g = PresentedGroup.of q}

/-- The distinguished point belongs to its actual first-neighborhood group. -/
theorem co1ResidueLocal_point_mem (p : MonsterCo1GeometryPoint) :
    (PresentedGroup.of p : Co1UniversalPresentation) ∈ co1ResidueLocal p :=
  Subgroup.subset_closure (Or.inl rfl)

/-- Genuine collinearity puts the neighbor generator in the first-neighborhood group. -/
theorem co1ResidueLocal_neighbor_mem (p q : MonsterCo1GeometryPoint)
    (h : monsterCo1GeometryAdjacent p q) :
    (PresentedGroup.of q : Co1UniversalPresentation) ∈ co1ResidueLocal p :=
  Subgroup.subset_closure (Or.inr ⟨q, h, rfl⟩)

/-- The actual distinguished involution bundled in its neighborhood group. -/
def co1ResidueBase (p : MonsterCo1GeometryPoint) : co1ResidueLocal p :=
  ⟨PresentedGroup.of p, co1ResidueLocal_point_mem p⟩

/-- Original genuine line relations make the base generator commute with all of its
first-neighborhood group, without assuming global commutativity. -/
theorem co1ResidueLocal_le_centralizer (p : MonsterCo1GeometryPoint) :
    co1ResidueLocal p ≤
      Subgroup.centralizer {(PresentedGroup.of p : Co1UniversalPresentation)} := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  rcases hg with rfl | ⟨q, hq, rfl⟩
  · rfl
  · exact (co1UniversalPoint_commute_of_adjacent p q hq).eq.symm

/-- The base generator is central in its actual neighborhood group. -/
theorem co1ResidueBase_mem_center (p : MonsterCo1GeometryPoint) :
    co1ResidueBase p ∈ Subgroup.center (co1ResidueLocal p) := by
  rw [Subgroup.mem_center_iff]
  intro g
  apply Subtype.ext
  exact Subgroup.mem_centralizer_singleton_iff.mp
    (co1ResidueLocal_le_centralizer p g.property)

/-- The cyclic point subgroup by which the actual neighborhood is quotiented. -/
def co1ResidueBaseKernel (p : MonsterCo1GeometryPoint) : Subgroup (co1ResidueLocal p) :=
  Subgroup.zpowers (co1ResidueBase p)

/-- The cyclic point kernel lies in the center of the neighborhood group. -/
theorem co1ResidueBaseKernel_le_center (p : MonsterCo1GeometryPoint) :
    co1ResidueBaseKernel p ≤ Subgroup.center (co1ResidueLocal p) :=
  Subgroup.zpowers_le.mpr (co1ResidueBase_mem_center p)

instance co1ResidueBaseKernel_normal (p : MonsterCo1GeometryPoint) :
    (co1ResidueBaseKernel p).Normal :=
  Subgroup.normal_of_le_center (co1ResidueBaseKernel_le_center p)

/-- The actual residue representation group, before any abelianity theorem. -/
abbrev Co1ResidueLocalQuotient (p : MonsterCo1GeometryPoint) :=
  co1ResidueLocal p ⧸ co1ResidueBaseKernel p

/-- The base point remains an involution inside its neighborhood group. -/
theorem co1ResidueBase_mul_self (p : MonsterCo1GeometryPoint) :
    co1ResidueBase p * co1ResidueBase p = 1 :=
  Subtype.ext (co1UniversalPoint_mul_self p)

/-- A cyclic subgroup generated by an involution has exactly the two possible element values. -/
theorem co1Residue_zpowers_mem_iff {G : Type*} [Group G] (z g : G)
    (hz : z * z = 1) : g ∈ Subgroup.zpowers z ↔ g = 1 ∨ g = z := by
  let K : Subgroup G := {
    carrier := {x | x = 1 ∨ x = z}
    one_mem' := Or.inl rfl
    mul_mem' := by
      rintro a b (rfl | rfl) (rfl | rfl)
      · exact Or.inl (one_mul _)
      · exact Or.inr (one_mul _)
      · exact Or.inr (mul_one _)
      · exact Or.inl hz
    inv_mem' := by
      rintro a (rfl | rfl)
      · exact Or.inl inv_one
      · exact Or.inr (inv_eq_of_mul_eq_one_left hz) }
  constructor
  · intro hg
    exact (Subgroup.zpowers_le.mpr (show z ∈ K from Or.inr rfl)) hg
  · rintro (rfl | rfl)
    · exact Subgroup.one_mem _
    · exact Subgroup.mem_zpowers _

/-- Every actual neighborhood kernel element is identity or the base point involution. -/
theorem co1ResidueBaseKernel_mem_iff (p : MonsterCo1GeometryPoint)
    (g : co1ResidueLocal p) :
    g ∈ co1ResidueBaseKernel p ↔ g = 1 ∨ g = co1ResidueBase p :=
  co1Residue_zpowers_mem_iff _ _ (co1ResidueBase_mul_self p)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
