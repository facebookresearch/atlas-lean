/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeNineteenSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeNineteenSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeNineteenSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeNineteenSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeNineteenSpinPrefixDense_support (i : Fin 16) :
    monsterNortonCodeNineteenSpinPrefixDense (monsterNortonCodeNineteenSpinPrefixLabel i) =
      monsterNortonCodeNineteenSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeNineteenSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeNineteenSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 15, monsterNortonCodeNineteenSpinPrefixLabel i.castSucc <
      monsterNortonCodeNineteenSpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude one. -/
theorem monsterNortonCodeNineteenSpinPrefixCoefficient_sq (i : Fin 16) :
    monsterNortonCodeNineteenSpinPrefixCoefficient i ^ 2 = 4 := by
  revert i
  decide +kernel

