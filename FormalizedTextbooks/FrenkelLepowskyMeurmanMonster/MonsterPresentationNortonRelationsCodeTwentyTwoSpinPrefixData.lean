/-- The complete integer prefix candidate, including every outside zero. -/
def monsterNortonCodeTwentyTwoSpinPrefixDense (k : Fin 16) (n : Fin 4096) : ℤ :=
  let i := monsterNortonCodeTwentyTwoSpinPrefixAddress ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩
  if h : i.val < 64 then monsterNortonCodeTwentyTwoSpinPrefixCoefficient k ⟨i.val, h⟩ else 0

