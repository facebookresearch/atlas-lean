/-! # The Tenth source word in the identification alphabet, with packed data

`srcTenthYWord` writes the original local word `generatedTenthLocal`
(`= generatedAxisGlobalFifthShortLocalWord 2`) in the identification alphabet, stage by stage
(Xi, the stage code sign when nonzero, the monomial letters); `srcTenthYWord_local` is the exact
equality of local elements. The composite packed mask data of the word and the short image list
of `fifthSrcVec` under the word are data only, re-checked by the kernel where they are used. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
namespace GeneratedAxisGlobalIdent
set_option autoImplicit false

/-- Stage `j` of the normalization word of Fifth root two in the identification alphabet. -/
def srcTenthYStage (j : Fin 7) : List IdentLetter :=
  (if generatedAxisGlobalFifthShortNormalizationXi 2 j then [IdentLetter.xi] else []) ++
    ((if generatedAxisGlobalFifthShortNormalizationSigns 2 j = 0 then [] else
      [IdentLetter.sign (generatedAxisGlobalFifthShortNormalizationSigns 2 j) 0]) ++
      (generatedAxisGlobalFifthShortNormalizationWords 2 j).map IdentLetter.mono)

/-- The chronological chain of the first `n` stages (the head stage acts last). -/
def srcTenthYChain : ℕ → List IdentLetter
  | 0 => []
  | n + 1 => srcTenthYStage ⟨n % 7, Nat.mod_lt _ (by decide)⟩ ++ srcTenthYChain n

/-- The Tenth source word. -/
def srcTenthYWord : List IdentLetter := srcTenthYChain 7

/-- Each stage has the local element of the original stage. -/
theorem srcTenthYStage_local (j : Fin 7) :
    identWordLocal (srcTenthYStage j) =
      generatedAxisGlobalFifthShortNormalizationLocal 2 j := by
  unfold srcTenthYStage generatedAxisGlobalFifthShortNormalizationLocal
  rw [identWordLocal_append, identWordLocal_append]
  congr 1
  · cases generatedAxisGlobalFifthShortNormalizationXi 2 j
    · simp [identWordLocal, identWordFiber]
    · simp [identWordLocal, identWordFiber]
      rfl
  · congr 1
    · by_cases h : generatedAxisGlobalFifthShortNormalizationSigns 2 j = 0
      · rw [h, generatedAxisGlobalSignLocal_zero]
        simp [identWordLocal, identWordFiber]
      · simp only [h, ↓reduceIte]
        rw [identWordLocal_singleton]
        exact generatedFifth_sign_fiber_local _ _
    · simp only [identWordLocal, identWordFiber, List.map_map]
      rfl

/-- The chain has the local element of the original chronological chain. -/
theorem srcTenthYChain_local (n : ℕ) :
    identWordLocal (srcTenthYChain n) = generatedAxisGlobalWordChain
      (fun j => generatedAxisGlobalFifthShortNormalizationLocal 2
        ⟨j % 7, Nat.mod_lt _ (by decide)⟩) n := by
  induction n with
  | zero => simp [srcTenthYChain, generatedAxisGlobalWordChain, identWordLocal, identWordFiber]
  | succ n ih => rw [srcTenthYChain, identWordLocal_append, ih, srcTenthYStage_local]; rfl

/-- The Tenth source word is the original local word of the Tenth axis. -/
theorem srcTenthYWord_local : identWordLocal srcTenthYWord = generatedTenthLocal :=
  srcTenthYChain_local 7

