/-- Packed coordinate pairs in lexicographic order, two five-bit fields per pair. -/
def identPairTable : ℕ :=
    0xe1304a120461106e0b02a0a026090220801e0701a06016050120400e0300a02006010020 |||
    (0x89c2689825894248902388c22888218ae1b06a1a066190621805e1705a16056150521404 <<< 288) |||
