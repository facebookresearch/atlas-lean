/-! ## Readers -/

/-- The code label of octad `j`. -/
def identOctCode (j : ℕ) : ℕ := identOctCodeTable / 2 ^ (12 * j) % 4096

/-- The block of packed coordinates containing octad `j`. -/
def identOctCoordBlock (j : ℕ) : ℕ :=
  if j < 256 then identOctCoordTable0 else if j < 512 then identOctCoordTable1
  else identOctCoordTable2

/-- Coordinate `k` of octad `j`, before reduction modulo `24`. -/
def identOctCoord (j k : ℕ) : ℕ :=
  identOctCoordBlock j / 2 ^ (5 * (8 * (j % 256) + k)) % 32

/-- The theta mask of the code label of octad `j`. -/
def identOctTheta (j : ℕ) : ℕ := identOctThetaTable / 2 ^ (12 * j) % 4096

/-- The block of packed odd data containing label `d`. -/
def identOddBlock (d : ℕ) : ℕ :=
  if d < 1024 then
    if d < 512 then (if d < 256 then identOddTable0 else identOddTable1)
    else (if d < 768 then identOddTable2 else identOddTable3)
  else
    if d < 1536 then (if d < 1280 then identOddTable4 else identOddTable5)
    else (if d < 1792 then identOddTable6 else identOddTable7)

/-- The theta mask of label `d < 2048`. -/
def identOddTheta (d : ℕ) : ℕ := identOddBlock d / 2 ^ (40 * (d % 256)) % 4096

/-- The encoded codeword of label `d < 2048`. -/
def identOddCode (d : ℕ) : ℕ := identOddBlock d / 2 ^ (40 * (d % 256) + 12) % 2 ^ 24

/-- The flag `1` exactly when the codeword weight of label `d < 2048` is not divisible by 8. -/
def identOddWeightFlag (d : ℕ) : ℕ := identOddBlock d / 2 ^ (40 * (d % 256) + 36) % 2

/-- The even representative of an octad sign label `e < 64`. -/
def identEvenMask (e : ℕ) : ℕ := identEvenTable / 2 ^ (8 * e) % 128

/-- The Ω bit of an octad sign label `e < 64`. -/
def identOctOmegaBit (e : ℕ) : ℕ := identEvenTable / 2 ^ (8 * e + 7) % 2

/-- The first coordinate of pair `p`, before reduction modulo `24`. -/
def identPairFst (p : ℕ) : ℕ := identPairTable / 2 ^ (10 * p) % 32

/-- The second coordinate of pair `p`, before reduction modulo `24`. -/
def identPairSnd (p : ℕ) : ℕ := identPairTable / 2 ^ (10 * p + 5) % 32

/-! ## Certificates -/

/-- The packed octad code as a label. -/
def identOctCodeFin (j : Fin 759) : Fin 4096 := ⟨identOctCode j.val, Nat.mod_lt _ (by decide)⟩

/-- The packed octad coordinate as a coordinate. -/
def identOctCoordFin (j : Fin 759) (k : Fin 8) : Fin 24 :=
  ⟨identOctCoord j.val k.val % 24, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 100000 in
private theorem octCode_adjacent : ∀ i : Fin 758,
    identOctCodeFin (Fin.castSucc i) < identOctCodeFin i.succ := by
  decide +kernel

set_option maxRecDepth 100000 in
private theorem octCode_weight : ∀ j : Fin 759,
    golayMaskWeight (golayEncodedMask (identOctCode j.val)) = 8 := by
  decide +kernel

private theorem octCode_mem (j : Fin 759) : identOctCodeFin j ∈ golayOctads := by
  simp only [golayOctads, Finset.mem_filter, Finset.mem_univ, true_and]
  exact octCode_weight j

/-- The packed octad code is the actual octad label at every catalogue index. -/
theorem identOctCode_actual (j : Fin 759) : identOctCodeFin j = golayOctadLabel j := by
  have hm : StrictMono identOctCodeFin := Fin.strictMono_iff_lt_succ.mpr octCode_adjacent
  have h := Finset.orderEmbOfFin_unique golayOctads_card octCode_mem hm
  exact congrFun h j

set_option maxRecDepth 100000 in
private theorem octCoord_bit : ∀ j : Fin 759, ∀ k : Fin 8,
    (golayEncodedMask (identOctCode j.val)).testBit (identOctCoord j.val k.val % 24) = true := by
  decide +kernel

private theorem octCoord_mem (j : Fin 759) (k : Fin 8) :
    identOctCoordFin j k ∈ golayMaskSupport (golayEncodedMask (golayOctadLabel j).val) := by
  rw [← identOctCode_actual]
  simp only [golayMaskSupport, Finset.mem_filter, Finset.mem_univ, true_and]
  exact octCoord_bit j k

set_option maxRecDepth 100000 in
private theorem octCoord_adjacent : ∀ j : Fin 759, ∀ k : Fin 7,
    identOctCoordFin j (Fin.castSucc k) < identOctCoordFin j k.succ := by
  decide +kernel

/-- The packed coordinates are the actual increasing coordinates of every octad. -/
theorem identOctCoord_actual (j : Fin 759) (k : Fin 8) :
    identOctCoordFin j k = golayOctadCoordinate j k := by
  have hm : StrictMono (identOctCoordFin j) :=
    Fin.strictMono_iff_lt_succ.mpr (octCoord_adjacent j)
  have h := Finset.orderEmbOfFin_unique (golayOctad_support_card j) (octCoord_mem j) hm
  exact congrFun h k

set_option maxRecDepth 100000 in
/-- The packed octad theta masks are the theta masks of the packed codes. -/
theorem identOctTheta_actual : ∀ j : Fin 759,
    identOctTheta j.val = parkerThetaMask (identOctCode j.val) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The packed odd theta masks are the theta masks of the labels. -/
theorem identOddTheta_actual : ∀ d : Fin 2048, identOddTheta d.val = parkerThetaMask d.val := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The packed odd codewords are the encoded codewords of the labels. -/
theorem identOddCode_actual : ∀ d : Fin 2048, identOddCode d.val = golayEncodedMask d.val := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The packed weight flags are the weight test of the encoded codewords. -/
theorem identOddWeightFlag_actual : ∀ d : Fin 2048,
    (if identOddWeightFlag d.val = 0 then (0 : ZMod 2) else 1) =
      if golayMaskWeight (golayEncodedMask d.val) % 8 = 0 then 0 else 1 := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The packed even representatives are the original even representatives. -/
theorem identEvenMask_actual : ∀ e : Fin 64, identEvenMask e.val = trialityEvenMask e := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The packed Ω bits give the original Ω translation masks. -/
theorem identOctOmegaBit_actual : ∀ e : Fin 64,
    2048 * identOctOmegaBit e.val =
      generatedAxisGlobalOmegaMask (griessOctadOmegaCoefficient e) := by
  decide +kernel

/-- The packed pair as a pair of coordinates. -/
def identPairFin (p : Fin 276) : Fin 24 × Fin 24 :=
  (⟨identPairFst p.val % 24, Nat.mod_lt _ (by decide)⟩,
    ⟨identPairSnd p.val % 24, Nat.mod_lt _ (by decide)⟩)

set_option maxRecDepth 100000 in
/-- The packed pairs are the catalogue coordinate pairs. -/
theorem identPairFin_actual : ∀ p : Fin 276,
    identPairFin p = generatedAxisGlobalPairCoordinates p := by
  decide +kernel

/-! ## Fast preferred masks -/

/-- The negative coordinates of a signed octad label, from the packed coordinates. -/
def identOctNegMask (j : Fin 759) (e : Fin 64) : ℕ :=
  (List.finRange 8).foldr (fun (k : Fin 8) (m : ℕ) =>
    (if (identEvenMask e.val).testBit k.val then 2 ^ (identOctCoordFin j k).val else 0) ||| m) 0

/-- The Ω coefficient of an odd label, from the packed codeword and weight flag. -/
def identOddOmega (d : Fin 2048) (i : Fin 24) : ZMod 2 :=
  (if identOddWeightFlag d.val = 0 then 0 else 1) +
    (if (identOddCode d.val).testBit i.val then 1 else 0)

/-- The preferred mask of a short label, read from the packed tables. -/
def identShortMaskR : GriessShortIndex → ℕ
  | Sum.inl (s, p) => generatedAxisGlobalSourceMaskJoin (if s = 0 then 0 else 2048)
      (Nat.xor (generatedAxisGlobalCocodeColumnMask (identPairFin p).1)
        (generatedAxisGlobalCocodeColumnMask (identPairFin p).2))
  | Sum.inr (Sum.inl (j, e)) => generatedAxisGlobalSourceMaskJoin
      (Nat.xor (identOctCode j.val) (2048 * identOctOmegaBit e.val))
      (Nat.xor (identOctTheta j.val) (generatedAxisGlobalCocodeMask (identOctNegMask j e)))
  | Sum.inr (Sum.inr (d, i)) => generatedAxisGlobalSourceMaskJoin
      (Nat.xor d.val (generatedAxisGlobalOmegaMask (identOddOmega d i)))
      (Nat.xor (identOddTheta d.val) (generatedAxisGlobalCocodeColumnMask i))

/-- The packed-table mask is the original preferred mask of every short label. -/
theorem identShortMaskR_eq (r : GriessShortIndex) :
    identShortMaskR r = generatedAxisGlobalShortMask r := by
  rcases r with ⟨s, p⟩ | (⟨j, e⟩ | ⟨d, i⟩)
  · simp only [identShortMaskR, generatedAxisGlobalShortMask, identPairFin_actual]
  · have hc : identOctCode j.val = (generatedAxisGlobalOctadCodeData j).val := by
      rw [generatedAxisGlobalOctadCodeData_actual, ← identOctCode_actual]
      rfl
    have hn : identOctNegMask j e = generatedAxisGlobalOctadNegativeMask j e := by
      unfold identOctNegMask generatedAxisGlobalOctadNegativeMask
      simp_rw [identOctCoord_actual, generatedAxisGlobalOctadCoordinatesData_actual,
        identEvenMask_actual]
    simp only [identShortMaskR, generatedAxisGlobalShortMask, identOctTheta_actual j, hc, hn,
      identOctOmegaBit_actual]
  · have hc := identOddCode_actual d
    simp only [identShortMaskR, generatedAxisGlobalShortMask, identOddTheta_actual d, identOddOmega,
      griessOddOmegaCoefficient, hc, identOddWeightFlag_actual d]

end GeneratedAxisGlobalIdent
