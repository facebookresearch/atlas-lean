set_option maxRecDepth 100000 in
-- Finite check of the bounds of every row operation.
/-- Every row operation of every stage is valid. -/
theorem seventhBitsetStageOps_valid (s : ℕ) :
    ∀ ops ∈ seventhBitsetStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
  have h : ∀ s < 5, ∀ ops ∈ seventhBitsetStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
    decide +kernel
  by_cases hs : s < 5
  · exact h s hs
  · have : seventhBitsetStageOps s = [] := by
      match s, hs with
      | n + 5, _ => rfl
    simp [this]

/-- The start set consists exactly of the 35 roots. -/
theorem seventhBitsetStart_testBit (b : ℕ) :
    seventhBitsetStart.testBit b = decide (b ∈ seventhBitsetRoots) :=
  tenthForestOfList_testBit _ b

set_option maxRecDepth 100000 in
-- The 35 roots are bounded masks.
/-- Every root is a bounded mask. -/
theorem seventhBitsetRoots_lt : ∀ m ∈ seventhBitsetRoots, m < 16777216 := by decide +kernel

/-- The start set has no positions beyond the `2 ^ 24` masks. -/
theorem seventhBitsetStart_bounded : TenthForestBounded seventhBitsetStart := by
  intro b hb
  rw [seventhBitsetStart_testBit]
  simp only [decide_eq_false_iff_not]
  intro hm
  have := seventhBitsetRoots_lt b hm
  omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
