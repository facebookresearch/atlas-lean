module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisGlobalReductionFifthGenerators

/-! The nineteen checked generators generate the complete actual fifth-axis
stabilizer projection. Thus their binary edges describe the full stabilizer action. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The Conway subgroup generated by the nineteen genuine spatial operators. -/
def generatedAxisGlobalFifthProjectionGenerators : Subgroup Co1 :=
  Subgroup.closure (Set.range (fun k : Fin 19 =>
    QuotientGroup.mk' signsSubgroup (generatedAxisGlobalFifthSpatial k)))

/-- Each of the nineteen original projections belongs to the generated subgroup. -/
theorem generatedAxisGlobalFifthProjection_generator_mem (k : Fin 19) :
    QuotientGroup.mk' signsSubgroup (generatedAxisGlobalFifthSpatial k) ∈
      generatedAxisGlobalFifthProjectionGenerators :=
  Subgroup.subset_closure ⟨k, rfl⟩

/-- The complete actual fifth-axis stabilizer projection is generated
by these nineteen operators. -/
theorem generatedAxisGlobalFifthProjectionGenerators_eq_stabilizer
    :
    generatedAxisGlobalFifthProjectionGenerators = generatedFifthProjectedAxisStabilizer := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    exact generatedAxisGlobalFifthSpatial_stabilizer k
  · have hs : ∀ k : Fin 12, QuotientGroup.mk' signsSubgroup
        (monsterCo1GeometrySignIsometry k) ∈ generatedAxisGlobalFifthProjectionGenerators := by
      intro k
      have hg := generatedAxisGlobalFifthProjection_generator_mem ⟨k.val, by omega⟩
      simpa only [generatedAxisGlobalFifthSpatial, k.isLt, ↓reduceDIte] using hg
    have hm : ∀ k : Fin 6, QuotientGroup.mk' signsSubgroup
        (golayPermutationIsometry (generatedFifthMonomialSpatialPermutation k)) ∈
          generatedAxisGlobalFifthProjectionGenerators := by
      intro k
      have hg := generatedAxisGlobalFifthProjection_generator_mem ⟨12 + k.val, by omega⟩
      have h0 : ¬12 + k.val < 12 := by omega
      have h1 : 12 + k.val < 18 := by omega
      simpa only [generatedAxisGlobalFifthSpatial, h0, h1, ↓reduceDIte,
        Nat.add_sub_cancel_left] using hg
    have hx : QuotientGroup.mk' signsSubgroup co1XiIsometry ∈
        generatedAxisGlobalFifthProjectionGenerators := by
      have h0 : ¬(18 : Fin 19).val < 12 := by decide
      have h1 : ¬(18 : Fin 19).val < 18 := by decide
      simpa only [generatedAxisGlobalFifthSpatial, h0, h1, ↓reduceDIte] using
        generatedAxisGlobalFifthProjection_generator_mem 18
    rw [generatedFifthProjectedAxisStabilizer_eq_system]
    rintro _ ⟨g, hg, rfl⟩
    exact generatedFifthFrameSystemStabilizer_le_of_generators
      (generatedAxisGlobalFifthProjectionGenerators.comap (QuotientGroup.mk' signsSubgroup))
      hs hm hx hg

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
