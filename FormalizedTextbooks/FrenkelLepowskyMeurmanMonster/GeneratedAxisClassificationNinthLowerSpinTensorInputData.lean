/-! Exact full normalized tensor input and rational spatial numerator caches.
Actual source binding is a separate prerequisite. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option maxRecDepth 100000

/-- Decode one signed nine-bit coordinate of a packed sixteen-coordinate word. -/
def generatedNinthLowerSpinTensorDecode (w k : ℕ) : ℤ :=
  let v := (w / 2 ^ (9 * k)) % 512
  if v < 256 then (v : ℤ) else (v : ℤ) - 512

/-- The balanced row address of one full original source spin label. -/
def generatedNinthLowerSpinTensorPackedCoordinate
    (words : Fin 16 → Fin 16 → ℕ) (n : Fin 4096) : ℤ :=
  generatedNinthLowerSpinTensorDecode
    (words ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩)
    (n.val % 16)

