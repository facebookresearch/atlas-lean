/- Actual smaller parabolic subgroups and source positive-word membership. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555TypeAParabolicOrderA5
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationParabolicCover

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The exact six source vertices of the D6 parabolic. -/
def y322D6Generator : Fin 6 → Fin 8 := ![0, 1, 2, 3, 4, 6]

/-- The actual source subgroup generated by the D6 vertices. -/
def y322D6Parabolic : Subgroup Y322Presentation :=
  Subgroup.closure (Set.range (fun i : Fin 6 =>
    (PresentedGroup.of (y322D6Generator i) : Y322Presentation)))

/-- All source vertices of the D6 diagram occur on its exact declared generator list. -/
theorem y322D6Generator_covers (v : Fin 8) (hv : v.val < 5 ∨ v.val = 6) :
    ∃ i : Fin 6, y322D6Generator i = v := by
  fin_cases v <;> norm_num at hv
  all_goals first
    | exact ⟨0, rfl⟩
    | exact ⟨1, rfl⟩
    | exact ⟨2, rfl⟩
    | exact ⟨3, rfl⟩
    | exact ⟨4, rfl⟩
    | exact ⟨5, rfl⟩

/-- Every source vertex of the exact D6 diagram belongs to its actual generated subgroup. -/
theorem y322D6Parabolic_generator_mem (v : Fin 8) (hv : v.val < 5 ∨ v.val = 6) :
    (PresentedGroup.of v : Y322Presentation) ∈ y322D6Parabolic := by
  obtain ⟨i, rfl⟩ := y322D6Generator_covers v hv
  exact Subgroup.subset_closure ⟨i, rfl⟩

/-- The actual A5 parabolic is contained in the actual D6 parabolic. -/
theorem y322A5Parabolic_le_D6 : y322A5Parabolic ≤ y322D6Parabolic := by
  rw [y322A5Parabolic, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  apply y322D6Parabolic_generator_mem
  fin_cases i <;> decide +kernel

/-- The actual D6 parabolic is contained in the original E7 parabolic. -/
theorem y322D6Parabolic_le_E7 : y322D6Parabolic ≤ y322E7Parabolic := by
  rw [y322D6Parabolic, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  apply y322E7Parabolic_generator_mem
  fin_cases i <;> decide +kernel

/-- Positive words with all generator values in a subgroup lie in that actual subgroup. -/
theorem y322PositiveWord_mem (K : Subgroup Y322Presentation) (w : List (Fin 8))
    (h : ∀ v ∈ w, (PresentedGroup.of v : Y322Presentation) ∈ K) :
    y322PositiveWord w ∈ K := by
  induction w with
  | nil => exact K.one_mem
  | cons v w ih =>
    change PresentedGroup.of v * y322PositiveWord w ∈ K
    exact K.mul_mem (h v (by simp)) (ih (fun x hx => h x (by simp [hx])))

/-- Reversing a positive source word evaluates to its inverse by the actual defining squares. -/
theorem y322ParabolicPositiveWord_reverse (w : List (Fin 8)) :
    y322PositiveWord w.reverse = (y322PositiveWord w)⁻¹ := by
  induction w with
  | nil => simp [y322PositiveWord]
  | cons v w ih =>
    rw [List.reverse_cons, y322PositiveWord_append, ih]
    change (y322PositiveWord w)⁻¹ * PresentedGroup.of v =
      (PresentedGroup.of v * y322PositiveWord w)⁻¹
    rw [mul_inv_rev, inv_eq_of_mul_eq_one_right (y322Positive_generator_square v)]

/-- A source coefficient equality identifies an actual right-generator transition. -/
theorem y322PositiveWord_transition (u w c : List (Fin 8)) (v : Fin 8)
    (h : y322PositiveWord (u ++ [v] ++ w.reverse) = y322PositiveWord c) :
    y322PositiveWord u * PresentedGroup.of v = y322PositiveWord c * y322PositiveWord w := by
  have hs : y322PositiveWord [v] = PresentedGroup.of v := by simp [y322PositiveWord]
  rw [y322PositiveWord_append, y322PositiveWord_append, hs,
    y322ParabolicPositiveWord_reverse] at h
  have hh := congrArg (fun x => x * y322PositiveWord w) h
  simpa only [mul_assoc, inv_mul_cancel, mul_one] using hh

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
