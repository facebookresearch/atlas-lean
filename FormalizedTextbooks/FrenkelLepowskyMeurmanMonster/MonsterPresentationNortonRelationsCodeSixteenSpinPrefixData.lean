/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeSixteenSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeSixteenSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeSixteenSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeSixteenSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeSixteenSpinPrefixDense_support (i : Fin 16) :
    monsterNortonCodeSixteenSpinPrefixDense (monsterNortonCodeSixteenSpinPrefixLabel i) =
      monsterNortonCodeSixteenSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeSixteenSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeSixteenSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 15, monsterNortonCodeSixteenSpinPrefixLabel i.castSucc <
      monsterNortonCodeSixteenSpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude four. -/
theorem monsterNortonCodeSixteenSpinPrefixCoefficient_sq (i : Fin 16) :
    monsterNortonCodeSixteenSpinPrefixCoefficient i ^ 2 = 4 := by
  revert i
  decide +kernel

