set_option maxHeartbeats 8000000 in
-- Check a bounded block of exact original monomial coordinate addresses.
private theorem block_00 : ∀ u : Fin 256,
    generatedNinthLowerSpinTensorAddressCondition 0
      ⟨0 * 256 + u.val, by omega⟩ := by
  have hc : ∀ u : Fin 256,
      generatedNinthLowerSpinTensorCachedAddressCondition 0
        ⟨0 * 256 + u.val, by omega⟩ := by
    unfold generatedNinthLowerSpinTensorCachedAddressCondition
    decide +kernel
  intro u
  exact generatedNinth_lower_spin_tensor_address_of_cached _ _ (hc u)

