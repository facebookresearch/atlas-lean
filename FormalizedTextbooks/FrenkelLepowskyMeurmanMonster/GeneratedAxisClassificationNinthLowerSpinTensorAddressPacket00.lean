set_option maxHeartbeats 8000000 in
-- Join all sixteen complete boundary-address blocks without dropping any spin labels.
/-- All 4096 original source spin labels retain both compact boundary signs and addresses. -/
theorem generatedNinth_lower_spin_tensor_address_packet_00 :
    ∀ n : Fin 4096, generatedNinthLowerSpinTensorAddressCondition 0 n := by
  have hall : ∀ b : Fin 16, ∀ u : Fin 256,
      generatedNinthLowerSpinTensorAddressCondition 0
        ⟨b.val * 256 + u.val, by omega⟩ := by
    intro b u
    fin_cases b
    · exact block_00 u
    · exact block_01 u
    · exact block_02 u
    · exact block_03 u
    · exact block_04 u
    · exact block_05 u
    · exact block_06 u
    · exact block_07 u
    · exact block_08 u
    · exact block_09 u
    · exact block_10 u
    · exact block_11 u
    · exact block_12 u
    · exact block_13 u
    · exact block_14 u
    · exact block_15 u
  intro n
  let b : Fin 16 := ⟨n.val / 256, by omega⟩
  let u : Fin 256 := ⟨n.val % 256, Nat.mod_lt _ (by decide)⟩
  have he : (⟨b.val * 256 + u.val, by omega⟩ : Fin 4096) = n := by
    apply Fin.ext
    dsimp [b, u]
    omega
  simpa only [he] using hall b u

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
