/-- One cached normalized pair stage, as an exact full integer tensor. -/
def generatedTwelfthSpinTensorStageInteger
    (i : Fin 12) (s : ℕ) (n : Fin 4096) (j : Fin 24) : ℤ :=
  generatedTwelfthSpinTensorPackedCoordinate (generatedTwelfthSpinTensorStageWords i s j) n

/-- The genuine rational spatial numerator acts first on the full original tensor. -/
def generatedTwelfthSpinTensorSpatialInteger
    (i : Fin 12) (n : Fin 4096) (j : Fin 24) : ℤ :=
  ∑ k : Fin 24, generatedTwelfthSpinTensorSpatialNumerator i j k *
    generatedTwelfthSpinTensorInputInteger n k

