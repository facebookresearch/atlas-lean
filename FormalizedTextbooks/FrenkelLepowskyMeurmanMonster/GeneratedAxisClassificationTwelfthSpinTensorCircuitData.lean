/-- Original label of the post boundary. -/
def generatedTwelfthSpinTensorPostLabel (i : Fin 12) (n : Fin 4096) : Fin 4096 :=
  ⟨(generatedTwelfthSpinTensorPostLabelWords i
    ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩ /
      2 ^ (12 * (n.val % 16))) % 4096, Nat.mod_lt _ (by decide)⟩

/-- Original integral sign of the post boundary. -/
def generatedTwelfthSpinTensorPostSign (i : Fin 12) (n : Fin 4096) : ℤ :=
  if (generatedTwelfthSpinTensorPostSignWords i ⟨n.val / 256, by omega⟩).testBit
    (n.val % 256) then -1 else 1

/-- Integral complete post boundary action. -/
def generatedTwelfthSpinTensorPostInteger (i : Fin 12)
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  generatedTwelfthSpinTensorPostSign i n * v (generatedTwelfthSpinTensorPostLabel i n)

/-- Full two-term original binary-coordinate Fourier numerator. -/
def generatedTwelfthSpinTensorFourierInteger (k : Fin 12)
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  (if n.val.testBit k.val then (-1 : ℤ) else 1) * v n +
    v ⟨(Nat.xor n.val (2 ^ k.val)) % 4096, Nat.mod_lt _ (by decide)⟩

