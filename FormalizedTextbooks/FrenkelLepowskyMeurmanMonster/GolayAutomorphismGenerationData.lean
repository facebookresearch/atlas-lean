set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
-- The1060 original-generator letters are checked on all24 physical coordinates.
theorem golayStrongWords_certificate : ∀ s : Fin 14, ∀ i : Fin 24,
    golayGeneratingWordArray (golayStrongWords s) i = golayStrongForward s i := by
  decide +kernel

set_option maxHeartbeats 2000000 in
-- Verify both inverse laws of the14 strong-generator arrays.
theorem golayStrong_inverse_certificate : ∀ s : Fin 14, ∀ i : Fin 24,
    golayStrongForward s (golayStrongInverse s i) = i ∧
      golayStrongInverse s (golayStrongForward s i) = i := by
  decide +kernel

set_option maxHeartbeats 8000000 in
-- All304 strong-generator letters are checked on all24 physical coordinates.
theorem golayStabilizerStrongWords_certificate : ∀ r : Fin 129, ∀ i : Fin 24,
    golayStrongWordArray (golayStabilizerStrongWords r) i = golayStabilizerRepForward r i := by
  decide +kernel

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
