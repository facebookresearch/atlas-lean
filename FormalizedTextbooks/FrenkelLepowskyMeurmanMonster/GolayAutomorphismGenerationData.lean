/-! Generator words for the complete stabilizer transversal.
Two finite layers avoid expanding every representative into thousands of letters:
14 strong generators are words in the two physical permutations; all129 stabilizer
representatives are words in these14 generators. All physical arrays are kernel-checked. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Four letters are the two physical permutations followed by their inverses. -/
def golayGeneratingLetterArray (t : Fin 4) : Fin 24 → Fin 24 :=
  if h : t.val < 2 then omegaOrbitPermForward ⟨t.val, h⟩
  else omegaOrbitPermInverse ⟨t.val - 2, by omega⟩

/-- A permutation word acts by ordinary composition from right to left. -/
def golayGeneratingWordArray (w : List (Fin 4)) (i : Fin 24) : Fin 24 :=
  w.foldr (fun t i => golayGeneratingLetterArray t i) i

