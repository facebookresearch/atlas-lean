/-- A strong-generator letter and its physical array. -/
def golayStrongLetterArray (t : Fin 28) : Fin 24 → Fin 24 :=
  if h : t.val < 14 then golayStrongForward ⟨t.val, h⟩
  else golayStrongInverse ⟨t.val - 14, by omega⟩

/-- Physical action of a word in strong generators. -/
def golayStrongWordArray (w : List (Fin 28)) (i : Fin 24) : Fin 24 :=
  w.foldr (fun t i => golayStrongLetterArray t i) i

