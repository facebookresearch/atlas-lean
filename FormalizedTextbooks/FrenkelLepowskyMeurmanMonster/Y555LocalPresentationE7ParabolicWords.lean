/- Actual E7 parabolic membership of acyclic local word instructions. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationRawPrograms

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The actual subgroup generated by the first seven source vertices of C322. -/
def y322E7Parabolic : Subgroup Y322Presentation :=
  Subgroup.closure (Set.range (fun v : Fin 7 => (PresentedGroup.of v.castSucc : Y322Presentation)))

/-- Each of the seven declared parabolic generators belongs to the actual parabolic subgroup. -/
theorem y322E7Parabolic_generator_mem (v : Fin 8) (h : v.val < 7) :
    (PresentedGroup.of v : Y322Presentation) ∈ y322E7Parabolic := by
  exact Subgroup.subset_closure ⟨⟨v.val, h⟩, by congr 1⟩

/-- Instructions may use the seven parabolic generators, multiplication, inversion and one. -/
def Y322RawWordInstruction.E7Allowed : Y322RawWordInstruction → Prop
  | .one => True
  | .generator v => v.val < 7
  | .multiply _ _ => True
  | .inverse _ => True
  | .appendGenerator _ _ => False

/-- This finite source-generator restriction is directly decidable. -/
instance y322RawWordInstructionE7AllowedDecidable (instruction : Y322RawWordInstruction) :
    Decidable instruction.E7Allowed := by
  cases instruction <;> unfold Y322RawWordInstruction.E7Allowed <;> infer_instance

/-- Every acyclic word in a prefix using only E7 instructions lies in the actual parabolic. -/
theorem y322WordProgram_E7_prefix_mem {size count : ℕ} (program : Y322WordProgram size)
    (allowed : ∀ i : Fin size, i.val < count → (y322InstructionRaw (program i)).E7Allowed)
    (i : Fin size) (hi : i.val < count) :
    y322LocalProgramValue program i ∈ y322E7Parabolic := by
  induction i using (measure (fun i : Fin size => i.val)).wf.induction with
  | h i ih =>
    have ha := allowed i hi
    rw [y322LocalProgramValue_eq]
    cases hc : program i with
    | one => exact y322E7Parabolic.one_mem
    | generator v =>
      simp only [hc, y322InstructionRaw, Y322RawWordInstruction.E7Allowed] at ha
      exact y322E7Parabolic_generator_mem v ha
    | multiply a b =>
      exact y322E7Parabolic.mul_mem
        (ih (y322ProgramPrior i a) a.isLt (lt_trans a.isLt hi))
        (ih (y322ProgramPrior i b) b.isLt (lt_trans b.isLt hi))
    | inverse a =>
      exact y322E7Parabolic.inv_mem (ih (y322ProgramPrior i a) a.isLt
        (lt_trans a.isLt hi))
    | appendGenerator a v =>
      simp only [hc, y322InstructionRaw, Y322RawWordInstruction.E7Allowed] at ha

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
