module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisRootEightMathieuReductionData

/-! The literal reduced pair generates the actual original Mathieu point subgroup. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000

private theorem permutation_mul_three_apply (a b c : golayAutomorphismSubgroup) (i : Fin 24) :
    (a * b * c).val i = a.val (b.val (c.val i)) := rfl

/-- The reduced original permutations have precisely their complete literal forward arrays. -/
theorem generatedRootEight_mathieu_reduced_forward (j : Fin 2) (i : Fin 24) :
    (generatedRootEightMathieuReducedGenerator j).val i =
      generatedRootEightMathieuReducedForward j i := by
  fin_cases j
  · change (generatedRootEightMathieuReducedGenerator 0).val i =
      generatedRootEightMathieuReducedForward 0 i
    rw [show generatedRootEightMathieuReducedGenerator 0 =
        leechNormSixHS100MathieuOriginalGenerator 0 *
          leechNormSixHS100MathieuOriginalGenerator 4 *
          leechNormSixHS100MathieuOriginalGenerator 1 from ite_eq_left rfl,
      permutation_mul_three_apply,
      leechNormSixHS100Mathieu_original_forward, leechNormSixHS100Mathieu_original_forward,
      leechNormSixHS100Mathieu_original_forward]
    exact (generatedRootEight_mathieu_reduced_forward_certificate i).1
  · change (generatedRootEightMathieuReducedGenerator 1).val i =
      generatedRootEightMathieuReducedForward 1 i
    rw [show generatedRootEightMathieuReducedGenerator 1 =
        leechNormSixHS100MathieuOriginalGenerator 8 from ite_eq_right (by decide),
      leechNormSixHS100Mathieu_original_forward]
    exact (generatedRootEight_mathieu_reduced_forward_certificate i).2

/-- The literal inverse arrays are the inverses of the actual original reduced elements. -/
theorem generatedRootEight_mathieu_reduced_inverse (j : Fin 2) (i : Fin 24) :
    (generatedRootEightMathieuReducedGenerator j).val.symm i =
      generatedRootEightMathieuReducedInverse j i := by
  apply (generatedRootEightMathieuReducedGenerator j).val.injective
  rw [Equiv.apply_symm_apply, generatedRootEight_mathieu_reduced_forward,
    generatedRootEight_mathieu_reduced_inverse_certificate]

private theorem letter_apply (t : Fin 4) (i : Fin 24) :
    (generatedRootEightMathieuReducedLetter t).val i =
      generatedRootEightMathieuReducedLetterArray t i := by
  unfold generatedRootEightMathieuReducedLetter generatedRootEightMathieuReducedLetterArray
  split_ifs
  · exact generatedRootEight_mathieu_reduced_forward _ i
  · exact generatedRootEight_mathieu_reduced_inverse _ i

/-- Each reduced word is the full original permutation with its exact coordinate action. -/
theorem generatedRootEight_mathieu_reduced_word_apply (w : List (Fin 4)) (i : Fin 24) :
    (generatedRootEightMathieuReducedWord w).val i =
      generatedRootEightMathieuReducedWordArray w i := by
  induction w generalizing i with
  | nil => rfl
  | cons t w ih =>
    change (generatedRootEightMathieuReducedLetter t).val
      ((generatedRootEightMathieuReducedWord w).val i) =
        generatedRootEightMathieuReducedLetterArray t
          (generatedRootEightMathieuReducedWordArray w i)
    rw [letter_apply, ih]

/-- Every original strong generator is literally a word in the genuine reduced pair. -/
theorem generatedRootEight_mathieu_reduced_strong_word (j : Fin 10) :
    generatedRootEightMathieuReducedWord (generatedRootEightMathieuReducedStrongWords j) =
      leechNormSixHS100MathieuOriginalGenerator j := by
  apply Subtype.ext
  apply Equiv.ext
  intro i
  rw [generatedRootEight_mathieu_reduced_word_apply, leechNormSixHS100Mathieu_original_forward]
  exact generatedRootEight_mathieu_reduced_strong_certificate j i

/-- The subgroup generated by the two actual original reduced elements. -/
def generatedRootEightMathieuReducedGenerated : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range generatedRootEightMathieuReducedGenerator)

private theorem letter_mem (t : Fin 4) :
    generatedRootEightMathieuReducedLetter t ∈ generatedRootEightMathieuReducedGenerated := by
  unfold generatedRootEightMathieuReducedLetter
  split_ifs
  · exact Subgroup.subset_closure ⟨_, rfl⟩
  · exact generatedRootEightMathieuReducedGenerated.inv_mem (Subgroup.subset_closure ⟨_, rfl⟩)

private theorem strong_mem (j : Fin 10) :
    leechNormSixHS100MathieuOriginalGenerator j ∈ generatedRootEightMathieuReducedGenerated := by
  rw [← generatedRootEight_mathieu_reduced_strong_word]
  apply generatedRootEightMathieuReducedGenerated.list_prod_mem
  intro g hg
  obtain ⟨t, _, rfl⟩ := List.mem_map.mp hg
  exact letter_mem t

private theorem original_mem (j : Fin 10) :
    leechNormSixHS100MathieuOriginalGenerator j ∈ leechNormSixHS100MathieuGenerated :=
  Subgroup.subset_closure ⟨j, rfl⟩

/-- The two literal source elements generate exactly the original ten-generator Mathieu group. -/
theorem generatedRootEight_mathieu_reduced_generated_eq :
    generatedRootEightMathieuReducedGenerated = leechNormSixHS100MathieuGenerated := by
  apply le_antisymm
  · rw [generatedRootEightMathieuReducedGenerated, Subgroup.closure_le]
    rintro g ⟨j, rfl⟩
    fin_cases j
    · exact leechNormSixHS100MathieuGenerated.mul_mem
        (leechNormSixHS100MathieuGenerated.mul_mem (original_mem 0) (original_mem 4)) (original_mem 1)
    · exact original_mem 8
  · rw [leechNormSixHS100MathieuGenerated, Subgroup.closure_le]
    rintro g ⟨j, rfl⟩
    exact strong_mem j

/-- The pair generates the complete actual original ordered-root Mathieu subgroup. -/
theorem generatedRootEight_mathieu_reduced_point_subgroup :
    generatedRootEightMathieuReducedGenerated = golayPointStabilizer 2 := by
  rw [generatedRootEight_mathieu_reduced_generated_eq, leechNormSixHS100MathieuGenerated_eq]

/-- The same two unsigned original Conway permutations generate the genuine point stabilizer. -/
theorem generatedRootEight_mathieu_reduced_in_conway :
    Subgroup.closure (Set.range fun j =>
      golayPermutationIsometry (generatedRootEightMathieuReducedGenerator j)) =
      leechNormSixHS100PairPointStabilizer.map
        (leechNormSixActualPairStabilizer leechNormSixHS100Root leechNormSixHS100Companion).subtype := by
  have hr := MonoidHom.map_closure golayPermutationHom
    (Set.range generatedRootEightMathieuReducedGenerator)
  have hs := MonoidHom.map_closure golayPermutationHom
    (Set.range leechNormSixHS100MathieuOriginalGenerator)
  rw [← Set.range_comp] at hr hs
  change generatedRootEightMathieuReducedGenerated.map golayPermutationHom =
    Subgroup.closure (Set.range fun j =>
      golayPermutationIsometry (generatedRootEightMathieuReducedGenerator j)) at hr
  change leechNormSixHS100MathieuGenerated.map golayPermutationHom =
    Subgroup.closure (Set.range fun j =>
      golayPermutationIsometry (leechNormSixHS100MathieuOriginalGenerator j)) at hs
  rw [← hr, generatedRootEight_mathieu_reduced_generated_eq, hs,
    leechNormSixHS100Mathieu_generated_in_conway]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
