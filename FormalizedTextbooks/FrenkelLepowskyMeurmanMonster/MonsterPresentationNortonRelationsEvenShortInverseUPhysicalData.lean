-- Check all 1472 physical vector images using the actual 24 by 24 integer Leech numerator.
/-- All inverse-U physical vector images have their exact preferred-representative signs. -/
theorem monsterNortonEvenShortInverseUPhysical_certificate
    (k : Fin 23) (e : Fin 64) (i : Fin 24) :
    (monsterNortonUNumerator1.transpose *ᵥ monsterNortonEvenShortInverseUInputIntegral k e) i =
      4 * monsterNortonEvenShortInverseUPhysicalSign k e *
        monsterNortonEvenShortInverseUIntegral k e i := by
  revert k e i
  decide +kernel

