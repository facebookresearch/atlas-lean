/-- Every physical representative sign is exactly plus or minus one. -/
theorem monsterNortonEvenShortInverseUPhysicalSign_cases (k : Fin 23) (e : Fin 64) :
    monsterNortonEvenShortInverseUPhysicalSign k e = 1 ∨
      monsterNortonEvenShortInverseUPhysicalSign k e = -1 := by
  revert k e
  decide +kernel

set_option maxRecDepth 10000 in
