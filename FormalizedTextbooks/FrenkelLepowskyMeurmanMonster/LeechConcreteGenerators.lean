/- The concrete monomial and three-bases generators inside the actual Co₀ group. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1OrderXi
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismSigns
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismPermutations
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayCoordinateProjection
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismTransitivity

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The subgroup generated by actual Golay signs, actual Golay permutations,
and the actual three-bases isometry. Equality with Co₀ is a proof obligation. -/
noncomputable def leechConcreteGeneratorSubgroup : Subgroup leechIsomSubgroup :=
  Subgroup.closure (Set.range golaySignIsometry ∪ Set.range golayPermutationIsometry ∪
    {co1XiIsometry})

theorem golaySignIsometry_mem_concrete (c : golayCode) :
    golaySignIsometry c ∈ leechConcreteGeneratorSubgroup :=
  Subgroup.subset_closure (Or.inl (Or.inl ⟨c, rfl⟩))

theorem golayPermutationIsometry_mem_concrete (p : golayAutomorphismSubgroup) :
    golayPermutationIsometry p ∈ leechConcreteGeneratorSubgroup :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨p, rfl⟩))

theorem co1XiIsometry_mem_concrete : co1XiIsometry ∈ leechConcreteGeneratorSubgroup :=
  Subgroup.subset_closure (Or.inr rfl)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
