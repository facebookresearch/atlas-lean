/-- Read the exact original octad record using three small index levels. -/
def generatedNinthLowerSpinOctadCatalogueWord (j : Fin 759) : ℕ :=
  generatedNinthLowerSpinOctadCatalogueWords ⟨j.val / 256, by omega⟩
    ⟨(j.val / 16) % 16, Nat.mod_lt _ (by decide)⟩
    ⟨j.val % 16, Nat.mod_lt _ (by decide)⟩

/-- The complete original code label, read from the exact balanced catalogue. -/
def generatedNinthLowerSpinOctadCodeBalanced (j : Fin 759) : Fin 4096 :=
  Fin.ofNat 4096 (generatedNinthLowerSpinOctadCatalogueWord j)

/-- Every original physical coordinate is retained in its exact original ordered slot. -/
def generatedNinthLowerSpinOctadCoordinatesBalanced (j : Fin 759) (k : Fin 8) : Fin 24 :=
  Fin.ofNat 24 ((generatedNinthLowerSpinOctadCatalogueWord j / 2 ^ (12 + 5 * k.val)) % 32)

set_option maxHeartbeats 8000000 in
-- Check each original code and all eight ordered physical coordinates in this bounded block.
private theorem packet_0 : ∀ u : Fin 256,
    if h : 0 * 256 + u.val < 759 then
      (generatedNinthLowerSpinOctadCodeBalanced ⟨0 * 256 + u.val, h⟩ =
        generatedAxisGlobalOctadCodeData ⟨0 * 256 + u.val, h⟩) ∧
      (∀ k, generatedNinthLowerSpinOctadCoordinatesBalanced ⟨0 * 256 + u.val, h⟩ k =
        generatedAxisGlobalOctadCoordinatesData ⟨0 * 256 + u.val, h⟩ k) else True := by
  intro u
  fin_cases u <;> decide +kernel

set_option maxHeartbeats 8000000 in
-- Check each original code and all eight ordered physical coordinates in this bounded block.
private theorem packet_1 : ∀ u : Fin 256,
    if h : 1 * 256 + u.val < 759 then
      (generatedNinthLowerSpinOctadCodeBalanced ⟨1 * 256 + u.val, h⟩ =
        generatedAxisGlobalOctadCodeData ⟨1 * 256 + u.val, h⟩) ∧
      (∀ k, generatedNinthLowerSpinOctadCoordinatesBalanced ⟨1 * 256 + u.val, h⟩ k =
        generatedAxisGlobalOctadCoordinatesData ⟨1 * 256 + u.val, h⟩ k) else True := by
  intro u
  fin_cases u <;> decide +kernel

set_option maxHeartbeats 8000000 in
-- Check each original code and all eight ordered physical coordinates in this bounded block.
private theorem packet_2 : ∀ u : Fin 256,
    if h : 2 * 256 + u.val < 759 then
      (generatedNinthLowerSpinOctadCodeBalanced ⟨2 * 256 + u.val, h⟩ =
        generatedAxisGlobalOctadCodeData ⟨2 * 256 + u.val, h⟩) ∧
      (∀ k, generatedNinthLowerSpinOctadCoordinatesBalanced ⟨2 * 256 + u.val, h⟩ k =
        generatedAxisGlobalOctadCoordinatesData ⟨2 * 256 + u.val, h⟩ k) else True := by
  intro u
  fin_cases u <;> decide +kernel

set_option maxHeartbeats 8000000 in
-- Join all three complete blocks without omitting any of the 759 original octads.
private theorem certificate (j : Fin 759) :
    (generatedNinthLowerSpinOctadCodeBalanced j = generatedAxisGlobalOctadCodeData j) ∧
    (∀ k, generatedNinthLowerSpinOctadCoordinatesBalanced j k =
      generatedAxisGlobalOctadCoordinatesData j k) := by
  have hall : ∀ b : Fin 3, ∀ u : Fin 256,
      if h : b.val * 256 + u.val < 759 then
        (generatedNinthLowerSpinOctadCodeBalanced ⟨b.val * 256 + u.val, h⟩ =
          generatedAxisGlobalOctadCodeData ⟨b.val * 256 + u.val, h⟩) ∧
        (∀ k, generatedNinthLowerSpinOctadCoordinatesBalanced ⟨b.val * 256 + u.val, h⟩ k =
          generatedAxisGlobalOctadCoordinatesData ⟨b.val * 256 + u.val, h⟩ k) else True := by
    intro b u
    fin_cases b
    · exact packet_0 u
    · exact packet_1 u
    · exact packet_2 u
  let b : Fin 3 := ⟨j.val / 256, by omega⟩
  let u : Fin 256 := ⟨j.val % 256, Nat.mod_lt _ (by decide)⟩
  have hv : b.val * 256 + u.val = j.val := by
    dsimp [b, u]
    omega
  have hl : b.val * 256 + u.val < 759 := by omega
  have hp := hall b u
  rw [dite_eq_left hl] at hp
  have he : (⟨b.val * 256 + u.val, hl⟩ : Fin 759) = j := Fin.ext hv
  simpa only [he] using hp

