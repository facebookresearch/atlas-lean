/-- Finite original order of the 240 supported short units of each candidate. -/
def monsterNortonPairHalfShortStorage : NortonPairHalfShortIndex → Fin 240
  | Sum.inl (i, t) => ⟨2 * i.val + t.val, by omega⟩
  | Sum.inr (d, e) => ⟨16 + 16 * d.val + e.val, by omega⟩

/-- Pool lookup removes repeated inputs among the twelve genuine sparse candidates. -/
def monsterNortonPairHalfUPoolStorage (k : Fin 12) (i : NortonPairHalfShortIndex) : Fin 1552 :=
  monsterNortonPairHalfUPoolStorageFlat
    ⟨240 * k.val + (monsterNortonPairHalfShortStorage i).val, by omega⟩

