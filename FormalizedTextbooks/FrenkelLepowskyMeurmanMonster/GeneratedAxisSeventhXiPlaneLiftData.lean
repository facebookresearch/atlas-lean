/-- Literal actual Q element at each source-coordinate state. -/
def generatedSeventhXiPlaneQState (r : Fin 14) (j : Fin 24) : Q :=
  ⟨ofAdd (Fin.append
    (golayLabelCoefficients ⟨generatedSeventhXiPlaneQData r j 0 % 4096, Nat.mod_lt _ (by decide)⟩)
    (golayLabelCoefficients ⟨generatedSeventhXiPlaneQData r j 1 % 4096, Nat.mod_lt _ (by decide)⟩)),
    ofAdd (generatedSeventhXiPlaneQData r j 2 : ZMod 2)⟩

