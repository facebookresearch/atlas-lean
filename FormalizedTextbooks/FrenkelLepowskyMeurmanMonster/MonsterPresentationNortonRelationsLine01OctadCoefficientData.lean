private theorem source_lookup_cached (j : Fin 16) (e : Fin 64) :
    monsterNortonLine01OctadSixthSourceLookup j e =
      if monsterNortonLine01OctadSignSupport e then
        monsterNortonLine01ShortSixthSourceCoefficientLookup
          (monsterNortonLine01OctadSourceA j (monsterNortonLine01OctadSignLookup e))
          (monsterNortonLine01OctadSourceK j (monsterNortonLine01OctadSignLookup e)) else 0 := by
  unfold monsterNortonLine01OctadSixthSourceLookup
  split_ifs
  · rw [monsterNortonLine01ShortSixthSourceCoefficientLookup_actual]
  · rfl

set_option maxRecDepth 10000 in
/-- Every octad lookup entry is bound to the unique original actual source coefficient. -/
theorem monsterNortonLine01OctadSixthCoefficientLookup_actual (j : Fin 16) (e : Fin 64) :
    monsterNortonLine01OctadSixthNumerator j e =
      monsterNortonLine01OctadSixthCoefficientLookup j e := by
  rw [monsterNortonLine01OctadSixthSourceLookup_actual, source_lookup_cached]
  revert j e
  decide +kernel

/-- The exact integer numerator of the original sixty-four-term octad Fourier action. -/
def monsterNortonLine01OctadSeventhNumerator (j : Fin 16) (e : Fin 64) : ℤ :=
  (if trialityBitWeight8 (trialityEvenMask e) / 2 % 2 = 0 then 1 else -1) *
    ∑ r : Fin 64, trialityHadamard e r * monsterNortonLine01OctadSixthCoefficientLookup j r

