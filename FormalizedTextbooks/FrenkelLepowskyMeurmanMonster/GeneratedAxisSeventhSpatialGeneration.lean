module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisSeventhFrameOrbitExact

/-! Genuine spatial generators of the seventh matrix subgroup, obtained from exact frame counts. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open Multiplicative
set_option backward.isDefEq.respectTransparency false

/-- Original admissible signs, triangle permutations, and 27 signed frame witnesses. -/
def generatedSeventhSpatialSeeds : Set leechIsomSubgroup :=
  Set.range generatedSeventhSpatialSignHom ∪
    (Set.range (fun p : generatedSeventhTrianglePermutationSubgroup =>
      golayPermutationIsometry p.val) ∪
      Set.range (fun k : Fin 27 => (generatedSeventhFrameOrbitElement k).val))

/-- The subgroup generated by these genuine spatial elements. -/
def generatedSeventhSpatialGenerated : Subgroup leechIsomSubgroup :=
  Subgroup.closure generatedSeventhSpatialSeeds

/-- Every original spatial seed fixes the actual seventh matrix. -/
theorem generatedSeventhSpatialGenerated_le :
    generatedSeventhSpatialGenerated ≤ generatedSeventhSpatialStabilizer := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨v, rfl⟩ | (⟨p, rfl⟩ | ⟨k, rfl⟩))
  · exact generatedSeventhSpatialSignHom_mem v
  · exact generatedSeventh_triangle_permutation_spatial p.val p.property
  · exact (generatedSeventhFrameOrbitElement k).property

/-- Every genuine ten-parameter sign is included in the generated subgroup. -/
theorem generatedSeventhSpatialGenerated_sign
    (v : Multiplicative generatedSeventhSignParameterSpace) :
    generatedSeventhSpatialSignHom v ∈ generatedSeventhSpatialGenerated :=
  Subgroup.subset_closure (Or.inl ⟨v, rfl⟩)

/-- Every genuine triangle-compatible permutation is included in the generated subgroup. -/
theorem generatedSeventhSpatialGenerated_permutation
    (p : generatedSeventhTrianglePermutationSubgroup) :
    golayPermutationIsometry p.val ∈ generatedSeventhSpatialGenerated :=
  Subgroup.subset_closure (Or.inr (Or.inl ⟨p, rfl⟩))

/-- Each original signed frame witness is included in the genuine generated subgroup. -/
theorem generatedSeventhSpatialGenerated_frame (k : Fin 27) :
    (generatedSeventhFrameOrbitElement k).val ∈ generatedSeventhSpatialGenerated :=
  Subgroup.subset_closure (Or.inr (Or.inr ⟨k, rfl⟩))

/-- Genuine distinct sign-permutation choices already lie in the generated frame stabilizer. -/
def generatedSeventhSpatialGeneratedFrameMap
    (a : generatedSeventhSignParameterSpace × generatedSeventhTrianglePermutationSubgroup) :
    MulAction.stabilizer generatedSeventhSpatialGenerated
      (leechReduction (leechCoordinateFrameLattice 0)) := by
  let d := generatedSeventhSpatialSignCode a.1
  let e := golayMonomialPair (d, a.2.val)
  have hd : golaySignIsometry d ∈ generatedSeventhSpatialGenerated :=
    generatedSeventhSpatialGenerated_sign (ofAdd a.1)
  have he : e ∈ generatedSeventhSpatialGenerated :=
    generatedSeventhSpatialGenerated.mul_mem hd (generatedSeventhSpatialGenerated_permutation a.2)
  refine ⟨⟨e, he⟩, ?_⟩
  change leechModTwoAction e (leechReduction (leechCoordinateFrameLattice 0)) = _
  exact generatedFourthFlagMonomial_frame_fixed e ⟨d, a.2.val, rfl⟩

/-- The restricted sign-permutation map retains the actual monomial injectivity. -/
theorem generatedSeventhSpatialGeneratedFrameMap_injective :
    Function.Injective generatedSeventhSpatialGeneratedFrameMap := by
  intro a b h
  have he := congrArg (fun u : MulAction.stabilizer generatedSeventhSpatialGenerated
    (leechReduction (leechCoordinateFrameLattice 0)) => u.val.val) h
  have hab := golayMonomialPair_injective he
  apply Prod.ext
  · apply Subtype.ext
    apply golayEncoder_injective
    exact congrArg Subtype.val (congrArg Prod.fst hab)
  · apply Subtype.ext
    exact congrArg Prod.snd hab

/-- The generated subgroup has at least 5898240 actual coordinate-frame fixers. -/
theorem generatedSeventhSpatialGenerated_frame_stabilizer_card_ge :
    5898240 ≤ Nat.card (MulAction.stabilizer generatedSeventhSpatialGenerated
      (leechReduction (leechCoordinateFrameLattice 0))) := by
  let : Finite leechIsomSubgroup := leechIsomSubgroup_finite
  have h := Nat.card_le_card_of_injective generatedSeventhSpatialGeneratedFrameMap
    generatedSeventhSpatialGeneratedFrameMap_injective
  rw [Nat.card_prod, generatedSeventhSignParameterSpace_card,
    generatedSeventh_triangle_permutation_card] at h
  exact h

/-- The actual signed frame witnesses belong to the generated subgroup's own orbit. -/
def generatedSeventhSpatialGeneratedFrameWitness (k : Fin 27) :
    MulAction.orbit generatedSeventhSpatialGenerated
      (leechReduction (leechCoordinateFrameLattice 0)) :=
  ⟨generatedSeventhFrameOrbitTarget k,
    ⟨⟨(generatedSeventhFrameOrbitElement k).val, generatedSeventhSpatialGenerated_frame k⟩,
      generatedSeventhFrameOrbitElement_action k⟩⟩

/-- The genuinely generated subgroup reaches all 27 distinct witnessed frame classes. -/
theorem generatedSeventhSpatialGenerated_frame_orbit_card_ge :
    27 ≤ Nat.card (MulAction.orbit generatedSeventhSpatialGenerated
      (leechReduction (leechCoordinateFrameLattice 0))) := by
  let : Finite LeechModTwo := Finite.of_injective
    leechHyperbolicCoordinates leechHyperbolicCoordinates.injective
  have h := Nat.card_le_card_of_injective generatedSeventhSpatialGeneratedFrameWitness (by
    intro i j h
    exact generatedSeventhFrameOrbitTarget_injective (congrArg Subtype.val h))
  simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using h

/-- Original signs, triangle permutations and signed witnesses generate the whole matrix group. -/
theorem generatedSeventhSpatialGenerated_eq :
    generatedSeventhSpatialGenerated = generatedSeventhSpatialStabilizer := by
  let : Finite leechIsomSubgroup := leechIsomSubgroup_finite
  apply Subgroup.eq_of_le_of_card_ge generatedSeventhSpatialGenerated_le
  have h := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup
    generatedSeventhSpatialGenerated (leechReduction (leechCoordinateFrameLattice 0)))
  rw [Nat.card_prod] at h
  have hlo := Nat.mul_le_mul generatedSeventhSpatialGenerated_frame_orbit_card_ge
    generatedSeventhSpatialGenerated_frame_stabilizer_card_ge
  rw [← h, generatedSeventhSpatialStabilizer_card]
  exact hlo

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
