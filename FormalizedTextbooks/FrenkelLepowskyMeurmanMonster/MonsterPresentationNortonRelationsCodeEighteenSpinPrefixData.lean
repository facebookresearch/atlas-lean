/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeEighteenSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeEighteenSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeEighteenSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeEighteenSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeEighteenSpinPrefixDense_support (i : Fin 16) :
    monsterNortonCodeEighteenSpinPrefixDense (monsterNortonCodeEighteenSpinPrefixLabel i) =
      monsterNortonCodeEighteenSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeEighteenSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeEighteenSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 15, monsterNortonCodeEighteenSpinPrefixLabel i.castSucc <
      monsterNortonCodeEighteenSpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude one. -/
theorem monsterNortonCodeEighteenSpinPrefixCoefficient_sq (i : Fin 16) :
    monsterNortonCodeEighteenSpinPrefixCoefficient i ^ 2 = 4 := by
  revert i
