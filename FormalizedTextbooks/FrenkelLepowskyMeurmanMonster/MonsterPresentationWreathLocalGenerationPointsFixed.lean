/- A genuine common fixed vector separates the six Norton point subgroup from Q's center. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555ActualWreathGenerationWords

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The genuine zero-label Schrödinger coordinate vector. -/
def monsterNortonPointZeroVector : SpinSpace := Pi.single 0 1

/-- The sum of the zero Schrödinger basis vector and its first actual Norton point image. -/
noncomputable def monsterNortonPointFixedVector : SpinSpace :=
  monsterNortonPointZeroVector + spinOperator (y555NortonPointQ 0) monsterNortonPointZeroVector

private theorem cocode_point_fixes_zero (j : Fin 5) :
    spinOperator (y555NortonPointQ j.succ) monsterNortonPointZeroVector =
      monsterNortonPointZeroVector := by
  have ht : spinTranslation (y555NortonPointQ j.succ) = 0 := by
    fin_cases j <;> decide +kernel
  funext t
  change qSign (spinPhase (y555NortonPointQ j.succ) t) *
    monsterNortonPointZeroVector (t + spinTranslation (y555NortonPointQ j.succ)) =
      monsterNortonPointZeroVector t
  rw [ht, add_zero]
  by_cases he : t = 0
  · subst t
    simp [monsterNortonPointZeroVector, spinPhase, y555NortonPointQ, qSign]
  · simp [monsterNortonPointZeroVector, Pi.single_eq_of_ne he]

/-- The explicit common fixed vector has zero-label coefficient one, hence is nonzero. -/
theorem monsterNortonPointFixedVector_zero : monsterNortonPointFixedVector 0 = 1 := by
  have ht : spinTranslation (y555NortonPointQ 0) ≠ 0 := by decide +kernel
  change monsterNortonPointZeroVector 0 + qSign (spinPhase (y555NortonPointQ 0) 0) *
    monsterNortonPointZeroVector (0 + spinTranslation (y555NortonPointQ 0)) = 1
  simp [monsterNortonPointZeroVector, Pi.single_eq_of_ne ht]

/-- All six actual point operators fix this vector, including their genuine central phases. -/
theorem monsterNortonPointFixedVector_fixed (i : Fin 6) :
    spinOperator (y555NortonPointQ i) monsterNortonPointFixedVector =
      monsterNortonPointFixedVector := by
  refine Fin.cases ?_ (fun j => ?_) i
  · have hs : spinOperator (y555NortonPointQ 0)
        (spinOperator (y555NortonPointQ 0) monsterNortonPointZeroVector) =
        monsterNortonPointZeroVector := by
      rw [← LinearMap.comp_apply, ← spinOperator_mul,
        ← pow_two, y555NortonPointQ_sq, spinOperator_one]
      rfl
    rw [monsterNortonPointFixedVector, map_add, hs]
    exact add_comm _ _
  · have hc : spinOperator (y555NortonPointQ j.succ)
        (spinOperator (y555NortonPointQ 0) monsterNortonPointZeroVector) =
        spinOperator (y555NortonPointQ 0)
          (spinOperator (y555NortonPointQ j.succ) monsterNortonPointZeroVector) := by
      rw [← LinearMap.comp_apply, ← spinOperator_mul,
        y555NortonPointQ_commute j.succ 0, spinOperator_mul, LinearMap.comp_apply]
    rw [monsterNortonPointFixedVector, map_add, cocode_point_fixes_zero, hc,
      cocode_point_fixes_zero]

/-- The entire subgroup generated by the six actual points fixes the same nonzero vector. -/
theorem monsterNortonPoint_closure_fixed (q : Q)
    (hq : q ∈ Subgroup.closure (Set.range y555NortonPointQ)) :
    spinOperator q monsterNortonPointFixedVector = monsterNortonPointFixedVector := by
  induction hq using Subgroup.closure_induction with
  | mem q hq =>
    obtain ⟨i, rfl⟩ := hq
    exact monsterNortonPointFixedVector_fixed i
  | one => rw [spinOperator_one]; rfl
  | mul q r _ _ hq hr =>
    rw [spinOperator_mul, LinearMap.comp_apply, hr, hq]
  | inv q _ hq =>
    have h := congrArg (spinOperator q⁻¹) hq
    rw [← LinearMap.comp_apply, ← spinOperator_mul, inv_mul_cancel, spinOperator_one] at h
    exact h.symm

/-- The actual central involution is absent from the subgroup generated by the six points.
This rules out inferring the local-centralizer bound merely from those six generators. -/
theorem monsterNortonPoint_central_not_mem :
    qCentralInvolution ∉ Subgroup.closure (Set.range y555NortonPointQ) := by
  intro hq
  have hf := monsterNortonPoint_closure_fixed qCentralInvolution hq
  have h := congrFun hf (0 : SpinIndex)
  change qSign (spinPhase qCentralInvolution 0) *
    monsterNortonPointFixedVector (0 + spinTranslation qCentralInvolution) =
      monsterNortonPointFixedVector 0 at h
  have ht : spinTranslation qCentralInvolution = 0 := rfl
  have hp : spinPhase qCentralInvolution 0 = 1 := by simp [spinPhase, qCentralInvolution]
  rw [ht, add_zero, hp, monsterNortonPointFixedVector_zero] at h
  norm_num [qSign] at h

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
