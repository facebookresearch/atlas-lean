module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LeechNormSixHS100PointMover

/-! The original ten strong-generator words generate the actual canonical Mathieu point subgroup. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false
set_option autoImplicit false
set_option maxHeartbeats 4000000

/-- The original strong-generator positions four through thirteen. -/
def leechNormSixHS100MathieuGeneratorIndex (j : Fin 10) : Fin 14 := ⟨j.val + 4, by omega⟩

/-- Literal original two-generator words for all ten actual Mathieu point generators. -/
def leechNormSixHS100MathieuGeneratorWords (j : Fin 10) : List (Fin 4) :=
  golayStrongWords (leechNormSixHS100MathieuGeneratorIndex j)

/-- Complete original physical forward arrays for all ten actual Mathieu point generators. -/
def leechNormSixHS100MathieuGeneratorForward (j : Fin 10) : Fin 24 → Fin 24 :=
  golayStrongForward (leechNormSixHS100MathieuGeneratorIndex j)

/-- Complete original physical inverse arrays for all ten actual Mathieu point generators. -/
def leechNormSixHS100MathieuGeneratorInverse (j : Fin 10) : Fin 24 → Fin 24 :=
  golayStrongInverse (leechNormSixHS100MathieuGeneratorIndex j)

/-- Every literal original generator fixes both ordered physical root coordinates. -/
theorem leechNormSixHS100Mathieu_generator_fixed : ∀ j : Fin 10, ∀ k : Fin 2,
    golayStrongForward (leechNormSixHS100MathieuGeneratorIndex j) (Fin.castAdd 22 k) =
      Fin.castAdd 22 k := by
  decide +kernel

/-- Every deeper original transversal word uses precisely these ten generators and their inverses. -/
theorem leechNormSixHS100Mathieu_generator_word_certificate : ∀ r : Fin 129,
    2 ≤ (golayStabilizerRepLevel r).val →
      ∀ t ∈ golayStabilizerStrongWords r, ∃ j : Fin 10,
        t.val = (leechNormSixHS100MathieuGeneratorIndex j).val ∨
          t.val = (leechNormSixHS100MathieuGeneratorIndex j).val + 14 := by
  decide +kernel

/-- Actual subgroup generated by the ten source-bound two-point strong generators. -/
def leechNormSixHS100MathieuGenerated : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range fun j =>
    golayStrongAutomorphism (leechNormSixHS100MathieuGeneratorIndex j))

private theorem letter_mem (t : Fin 28)
    (ht : ∃ j : Fin 10, t.val = (leechNormSixHS100MathieuGeneratorIndex j).val ∨
      t.val = (leechNormSixHS100MathieuGeneratorIndex j).val + 14) :
    golayStrongLetter t ∈ leechNormSixHS100MathieuGenerated := by
  obtain ⟨j, hj | hj⟩ := ht
  · have hlt : t.val < 14 := by rw [hj]; exact (leechNormSixHS100MathieuGeneratorIndex j).isLt
    unfold golayStrongLetter
    rw [dite_eq_left hlt]
    have he : (⟨t.val, hlt⟩ : Fin 14) = leechNormSixHS100MathieuGeneratorIndex j := Fin.ext hj
    rw [he]
    exact Subgroup.subset_closure ⟨j, rfl⟩
  · have hlt : ¬ t.val < 14 := by omega
    unfold golayStrongLetter
    rw [dite_eq_right hlt]
    have he : (⟨t.val - 14, by omega⟩ : Fin 14) =
        leechNormSixHS100MathieuGeneratorIndex j := by
      apply Fin.ext
      change t.val - 14 = (leechNormSixHS100MathieuGeneratorIndex j).val
      omega
    rw [he]
    exact leechNormSixHS100MathieuGenerated.inv_mem (Subgroup.subset_closure ⟨j, rfl⟩)

/-- Each deeper original transversal belongs to the ten-generator subgroup. -/
theorem leechNormSixHS100Mathieu_representative_mem (r : Fin 129)
    (hr : 2 ≤ (golayStabilizerRepLevel r).val) :
    golayStabilizerAutomorphism r ∈ leechNormSixHS100MathieuGenerated := by
  have he : golayStrongWord (golayStabilizerStrongWords r) = golayStabilizerAutomorphism r := by
    apply Subtype.ext
    apply Equiv.ext
    intro i
    rw [leechRootedA2StrongWord_apply, golayStabilizerStrongWords_certificate]
    rfl
  rw [← he]
  apply leechNormSixHS100MathieuGenerated.list_prod_mem
  intro g hg
  obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hg
  exact letter_mem t (leechNormSixHS100Mathieu_generator_word_certificate r hr t ht)

private theorem stabilizer_mem : ∀ n : ℕ, n ≤ 5 →
    ∀ p : golayAutomorphismSubgroup, p ∈ golayPointStabilizer (7 - n) →
      p ∈ leechNormSixHS100MathieuGenerated := by
  intro n
  induction n with
  | zero =>
    intro _ p hp
    have h : p = 1 := golayAutomorphism_eq_one_of_fix_base p (fun j => hp j j.isLt)
    rw [h]
    exact leechNormSixHS100MathieuGenerated.one_mem
  | succ n ih =>
    intro hn p hp
    let k : Fin 7 := ⟨7 - (n + 1), by omega⟩
    let pfix : golayPointStabilizer k.val := ⟨p, hp⟩
    have hi := golayPointStabilizer_image_eligible k pfix
    obtain ⟨r, hr, hri⟩ := golayStabilizerRep_orbit_certificate k _ hi
    let q := golayStabilizerAutomorphism r
    have hq : q ∈ leechNormSixHS100MathieuGenerated :=
      leechNormSixHS100Mathieu_representative_mem r (by rw [hr]; dsimp [k]; omega)
    have hnext : q⁻¹ * p ∈ golayPointStabilizer (7 - n) := by
      intro j hj
      have hstep : 7 - n = k.val + 1 := by dsimp [k]; omega
      rw [hstep] at hj
      change q.val.symm (p.val (golayBasePoints j)) = golayBasePoints j
      by_cases hjk : j.val < k.val
      · have hpj := hp j hjk
        have hqj : q.val (golayBasePoints j) = golayBasePoints j :=
          golayStabilizerRep_prefix_certificate r j (by simpa only [hr] using hjk)
        rw [hpj]
        have hh := congrArg q.val.symm hqj
        rw [q.val.symm_apply_apply] at hh
        exact hh.symm
      · have hjeq : j = k := Fin.ext (by omega)
        subst j
        have hqk : q.val (golayBasePoints k) = p.val (golayBasePoints k) := hri
        rw [← hqk, q.val.symm_apply_apply]
    have hrem := ih (by omega) (q⁻¹ * p) hnext
    have hall := leechNormSixHS100MathieuGenerated.mul_mem hq hrem
    simpa only [mul_inv_cancel_left] using hall

/-- The ten source-bound strong generators give the full actual two-point stabilizer. -/
theorem leechNormSixHS100MathieuGenerated_eq :
    leechNormSixHS100MathieuGenerated = golayPointStabilizer 2 := by
  apply le_antisymm
  · rw [leechNormSixHS100MathieuGenerated, Subgroup.closure_le]
    rintro p ⟨j, rfl⟩ k hk
    change (golayStrongAutomorphism (leechNormSixHS100MathieuGeneratorIndex j)).val
      (golayBasePoints k) = golayBasePoints k
    rw [leechRootedA2StrongAutomorphism_apply]
    have hc : golayBasePoints k = Fin.castAdd 22 (⟨k.val, hk⟩ : Fin 2) := by
      let u : Fin 5 := ⟨k.val, by omega⟩
      have hu : Fin.castAdd 2 u = k := Fin.ext rfl
      have h := golayBasePoints_firstFive u
      rw [hu] at h
      exact h.trans (Fin.ext rfl)
    rw [hc]
    exact leechNormSixHS100Mathieu_generator_fixed j ⟨k.val, hk⟩
  · intro p hp
    exact stabilizer_mem 5 (by decide) p hp

/-- The ten actual original Mathieu permutations, in their original strong-generator order. -/
def leechNormSixHS100MathieuOriginalGenerator (j : Fin 10) : golayAutomorphismSubgroup :=
  golayStrongAutomorphism (leechNormSixHS100MathieuGeneratorIndex j)

/-- Every actual generator is exactly its displayed literal original two-generator word. -/
theorem leechNormSixHS100Mathieu_original_words (j : Fin 10) :
    leechNormSixHS100MathieuOriginalGenerator j =
      golayGeneratingWord (leechNormSixHS100MathieuGeneratorWords j) := rfl

/-- The public forward arrays describe every original physical generator coordinate. -/
theorem leechNormSixHS100Mathieu_original_forward (j : Fin 10) (i : Fin 24) :
    (leechNormSixHS100MathieuOriginalGenerator j).val i =
      leechNormSixHS100MathieuGeneratorForward j i :=
  leechRootedA2StrongAutomorphism_apply _ i

/-- The public inverse arrays describe every original physical inverse-generator coordinate. -/
theorem leechNormSixHS100Mathieu_original_inverse (j : Fin 10) (i : Fin 24) :
    (leechNormSixHS100MathieuOriginalGenerator j).val.symm i =
      leechNormSixHS100MathieuGeneratorInverse j i :=
  leechRootedA2StrongAutomorphism_inverse_apply _ i

/-- Every original generator belongs to the genuine ordered-root two-coordinate subgroup. -/
theorem leechNormSixHS100Mathieu_original_mem (j : Fin 10) :
    leechNormSixHS100MathieuOriginalGenerator j ∈ golayPointStabilizer 2 := by
  rw [← leechNormSixHS100MathieuGenerated_eq]
  exact Subgroup.subset_closure ⟨j, rfl⟩

/-- Each original generator as an element of the actual Mathieu two-coordinate subgroup. -/
def leechNormSixHS100MathieuGeneratorDomain (j : Fin 10) : golayPointStabilizer 2 :=
  ⟨leechNormSixHS100MathieuOriginalGenerator j, leechNormSixHS100Mathieu_original_mem j⟩

/-- Each original generator as an actual Conway positive-pair point stabilizer. -/
noncomputable def leechNormSixHS100MathieuGenerator (j : Fin 10) : leechNormSixHS100PairPointStabilizer :=
  leechNormSixHS100PairPointHom (leechNormSixHS100MathieuGeneratorDomain j)

/-- The actual original point generators retain their complete original Conway spatial maps. -/
theorem leechNormSixHS100Mathieu_generator_spatial (j : Fin 10) :
    (leechNormSixHS100MathieuGenerator j).val.val =
      golayPermutationIsometry (golayGeneratingWord (leechNormSixHS100MathieuGeneratorWords j)) := rfl

/-- The subgroup generated by the ten actual original Conway point-stabilizing elements. -/
noncomputable def leechNormSixHS100MathieuActualGenerated : Subgroup leechNormSixHS100PairPointStabilizer :=
  Subgroup.closure (Set.range leechNormSixHS100MathieuGenerator)

/-- The original generator words generate the whole actual original positive-pair point subgroup. -/
theorem leechNormSixHS100MathieuActualGenerated_eq_top :
    leechNormSixHS100MathieuActualGenerated = ⊤ := by
  let H := leechNormSixHS100MathieuActualGenerated
  let D := (H.comap leechNormSixHS100PairPointHom).map (golayPointStabilizer 2).subtype
  have hle : leechNormSixHS100MathieuGenerated ≤ D := by
    rw [leechNormSixHS100MathieuGenerated, Subgroup.closure_le]
    rintro g ⟨j, rfl⟩
    apply Subgroup.mem_map.mpr
    refine ⟨leechNormSixHS100MathieuGeneratorDomain j, ?_, rfl⟩
    exact Subgroup.subset_closure ⟨j, rfl⟩
  apply top_unique
  intro g _
  obtain ⟨p, rfl⟩ := leechNormSixHS100PairPointHom_surjective g
  have hp : p.val ∈ leechNormSixHS100MathieuGenerated := by
    rw [leechNormSixHS100MathieuGenerated_eq]
    exact p.property
  obtain ⟨q, hq, hqp⟩ := Subgroup.mem_map.mp (hle hp)
  have he : q = p := Subtype.ext hqp
  subst q
  exact hq

/-- The ten whole original Conway generators generate the actual point subgroup inside the complete flag group. -/
theorem leechNormSixHS100Mathieu_generated_in_flag :
    Subgroup.closure (Set.range fun j => (leechNormSixHS100MathieuGenerator j).val) =
      leechNormSixHS100PairPointStabilizer := by
  have h := MonoidHom.map_closure leechNormSixHS100PairPointStabilizer.subtype
    (Set.range leechNormSixHS100MathieuGenerator)
  rw [← Set.range_comp] at h
  change leechNormSixHS100MathieuActualGenerated.map leechNormSixHS100PairPointStabilizer.subtype = _ at h
  rw [leechNormSixHS100MathieuActualGenerated_eq_top, Subgroup.map_top, Subgroup.range_subtype] at h
  exact h.symm

/-- The original ten permutation words generate the actual canonical Mathieu subgroup in the original Conway group. -/
theorem leechNormSixHS100Mathieu_generated_in_conway :
    Subgroup.closure (Set.range fun j =>
      golayPermutationIsometry (leechNormSixHS100MathieuOriginalGenerator j)) =
      leechNormSixHS100PairPointStabilizer.map
        (leechNormSixActualPairStabilizer leechNormSixHS100Root leechNormSixHS100Companion).subtype := by
  have h := MonoidHom.map_closure
    (leechNormSixActualPairStabilizer leechNormSixHS100Root leechNormSixHS100Companion).subtype
    (Set.range fun j => (leechNormSixHS100MathieuGenerator j).val)
  rw [leechNormSixHS100Mathieu_generated_in_flag, ← Set.range_comp] at h
  exact h.symm

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
