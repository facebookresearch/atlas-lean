/-- Original source label of the post spin boundary operator. -/
def generatedNinthLowerSpinTensorPostLabel (i : Fin 11) (n : Fin 4096) : Fin 4096 :=
  ⟨(generatedNinthLowerSpinTensorPostLabelWords i
    ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩ /
      2 ^ (12 * (n.val % 16))) % 4096, Nat.mod_lt _ (by decide)⟩

/-- Original integral sign of the post spin boundary operator. -/
def generatedNinthLowerSpinTensorPostSign (i : Fin 11) (n : Fin 4096) : ℤ :=
  if (generatedNinthLowerSpinTensorPostSignWords i ⟨n.val / 256, by omega⟩).testBit
    (n.val % 256) then -1 else 1

/-- Two-term computable Fourier numerator in the original twelve-bit source labels. -/
def generatedNinthLowerSpinTensorFourierInteger (k : Fin 12)
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  (if n.val.testBit k.val then (-1 : ℤ) else 1) * v n +
    v ⟨(Nat.xor n.val (2 ^ k.val)) % 4096, Nat.mod_lt _ (by decide)⟩

/-- Paired Fourier factors listed in their actual order of application. -/
def generatedNinthLowerSpinTensorPairWord : Fin 11 → List (Fin 12 × Fin 12) :=
  ![[(0, 1)], [(0, 1)], [(0, 1)], [(0, 1)], [(4, 5), (2, 3), (0, 1)],
    [(2, 3), (0, 1)], [(6, 7), (4, 5), (2, 3), (0, 1)],
    [(6, 7), (4, 5), (2, 3), (0, 1)], [(6, 7), (4, 5), (2, 3), (0, 1)],
    [(8, 9), (6, 7), (4, 5), (2, 3), (0, 1)],
    [(8, 9), (6, 7), (4, 5), (2, 3), (0, 1)]]

/-- Cache-stage zero includes the actual right monomial and second quadratic diagonal. -/
def generatedNinthLowerSpinTensorPreInteger (i : Fin 11)
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  generatedNinthLowerSpinTensorPreSign i n * v (generatedNinthLowerSpinTensorPreLabel i n)

/-- The left monomial, first quadratic diagonal and full Pauli act after all pair stages. -/
def generatedNinthLowerSpinTensorPostInteger (i : Fin 11)
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  generatedNinthLowerSpinTensorPostSign i n * v (generatedNinthLowerSpinTensorPostLabel i n)

