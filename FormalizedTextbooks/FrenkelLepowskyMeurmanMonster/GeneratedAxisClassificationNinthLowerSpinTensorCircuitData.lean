/-! Compact tensor circuit addresses and genuine paired Fourier ordering.
Input, spatial and finite transition source bindings are separate obligations. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option maxRecDepth 100000

/-- Every finite stage retains its own exact balanced packed source-label cache. -/
def generatedNinthLowerSpinTensorStageWords :
    Fin 11 → ℕ → Fin 24 → Fin 16 → Fin 16 → ℕ :=
  ![generatedNinthLowerSpinTensorStageWords00,
    generatedNinthLowerSpinTensorStageWords01,
    generatedNinthLowerSpinTensorStageWords02,
    generatedNinthLowerSpinTensorStageWords03,
    generatedNinthLowerSpinTensorStageWords04,
    generatedNinthLowerSpinTensorStageWords05,
    generatedNinthLowerSpinTensorStageWords06,
    generatedNinthLowerSpinTensorStageWords07,
    generatedNinthLowerSpinTensorStageWords08,
    generatedNinthLowerSpinTensorStageWords09,
    generatedNinthLowerSpinTensorStageWords10]

/-- One cached normalized pair stage, as an exact full integer tensor. -/
def generatedNinthLowerSpinTensorStageInteger
    (i : Fin 11) (s : ℕ) (n : Fin 4096) (j : Fin 24) : ℤ :=
  generatedNinthLowerSpinTensorPackedCoordinate (generatedNinthLowerSpinTensorStageWords i s j) n

/-- The genuine rational spatial numerator acts first on the full original tensor. -/
def generatedNinthLowerSpinTensorSpatialInteger
    (i : Fin 11) (n : Fin 4096) (j : Fin 24) : ℤ :=
  ∑ k : Fin 24, generatedNinthLowerSpinTensorSpatialNumerator i j k *
    generatedNinthLowerSpinTensorInputInteger n k

