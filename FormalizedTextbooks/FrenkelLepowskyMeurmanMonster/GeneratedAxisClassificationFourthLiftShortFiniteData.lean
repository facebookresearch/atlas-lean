public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthLiftShortMatrixPhase
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthLiftShortPairSource
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthLiftShortCoefficients

/-! Candidate target addresses for bounded full-phase short-coordinate certificates.
The addresses make no recognition claim until their certificates are checked. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open Multiplicative
open scoped Matrix
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 100000

/-- Exact full-Q matrix evaluation using the certified sparse central polynomial. -/
def generatedFourthLiftShortMatrixFast (q : Q) : Q :=
  ⟨ofAdd (generatedFourthLiftQBinaryMatrix *ᵥ toAdd q.base),
    ofAdd (toAdd q.coeff + generatedFourthLiftQPhaseFast (toAdd q.base))⟩

/-- Sparse matrix evaluation is the genuine corrected Q action, including its central bit. -/
theorem generatedFourth_lift_short_matrix_fast (q : Q) :
    spinConjugation generatedFourthFlagCorrectedLift.val.1 q =
      generatedFourthLiftShortMatrixFast q := by
  rw [generatedFourth_lift_short_matrix_action, generatedFourth_lift_short_matrix_value,
    generatedFourth_lift_q_phase_fast]
  rfl

/-- Target kind: true is a listed octad, false is an increasing-coordinate pair. -/
def generatedFourthLiftShortTargetKind (w : ℕ) : Bool := w.testBit 12

/-- The complete original target central coefficient. -/
def generatedFourthLiftShortTargetPhase (w : ℕ) : ZMod 2 := golayBooleanCast (w.testBit 13)

/-- The target octad family address. -/
def generatedFourthLiftShortTargetOctad (w : ℕ) : Fin 63 :=
  ⟨((w % 4096) / 64) % 63, Nat.mod_lt _ (by decide)⟩

/-- The target preferred octad sign address. -/
def generatedFourthLiftShortTargetSign (w : ℕ) : Fin 64 := ⟨w % 64, Nat.mod_lt _ (by decide)⟩

/-- The target pair sign address. -/
def generatedFourthLiftShortTargetPairSign (w : ℕ) : Fin 2 := ⟨w % 2, Nat.mod_lt _ (by decide)⟩

/-- The target pair's first physical coordinate. -/
def generatedFourthLiftShortTargetFirst (w : ℕ) : Fin 24 :=
  ⟨((w % 4096) / 2) % 24, Nat.mod_lt _ (by decide)⟩

/-- The target pair's second physical coordinate. -/
def generatedFourthLiftShortTargetSecond (w : ℕ) : Fin 24 :=
  ⟨((w % 4096) / 48) % 24, Nat.mod_lt _ (by decide)⟩

/-- Target addresses are admissible exactly when every pair address is increasing. -/
def generatedFourthLiftShortTargetValid (w : ℕ) : Prop :=
  generatedFourthLiftShortTargetKind w = true ∨
    generatedFourthLiftShortTargetFirst w < generatedFourthLiftShortTargetSecond w

instance (w : ℕ) : Decidable (generatedFourthLiftShortTargetValid w) := inferInstanceAs
  (Decidable (generatedFourthLiftShortTargetKind w = true ∨
    generatedFourthLiftShortTargetFirst w < generatedFourthLiftShortTargetSecond w))

/-- The target intrinsic-Q evaluator; admissibility is required separately. -/
def generatedFourthLiftShortTargetQ (w : ℕ) : Q :=
  if generatedFourthLiftShortTargetKind w then
    generatedFourthLiftShortSourceQ (generatedFourthLiftShortTargetOctad w)
      (generatedFourthLiftShortTargetSign w)
  else generatedFourthLiftShortPairQ (generatedFourthLiftShortTargetPairSign w)
    (generatedFourthLiftShortTargetFirst w) (generatedFourthLiftShortTargetSecond w)

/-- The target actual-coordinate integer numerator. -/
def generatedFourthLiftShortTargetNumerator (w : ℕ) : ℤ :=
  if generatedFourthLiftShortTargetKind w then
    generatedFourthLiftShortOctadNumerator (generatedFourthLiftShortTargetOctad w)
      (generatedFourthLiftShortTargetSign w)
  else generatedFourthLiftShortPairNumerator (generatedFourthLiftShortTargetPairSign w)
    (generatedFourthLiftShortTargetFirst w) (generatedFourthLiftShortTargetSecond w)

/-- Full binary, central-phase and original-coefficient matching at one supported coordinate. -/
def generatedFourthLiftShortFiniteMatch (q : Q) (n : ℤ) (w : ℕ) : Prop :=
  n ≠ 0 → generatedFourthLiftShortTargetValid w ∧
    toAdd (generatedFourthLiftShortMatrixFast q).base =
      toAdd (generatedFourthLiftShortTargetQ w).base ∧
    toAdd (generatedFourthLiftShortMatrixFast q).coeff = generatedFourthLiftShortTargetPhase w ∧
    generatedFourthLiftShortTargetNumerator w =
      (if generatedFourthLiftShortTargetPhase w = 0 then 1 else -1) * n

instance (q : Q) (n : ℤ) (w : ℕ) : Decidable (generatedFourthLiftShortFiniteMatch q n w) :=
  inferInstanceAs (Decidable (n ≠ 0 → generatedFourthLiftShortTargetValid w ∧
    toAdd (generatedFourthLiftShortMatrixFast q).base =
      toAdd (generatedFourthLiftShortTargetQ w).base ∧
    toAdd (generatedFourthLiftShortMatrixFast q).coeff = generatedFourthLiftShortTargetPhase w ∧
    generatedFourthLiftShortTargetNumerator w =
      (if generatedFourthLiftShortTargetPhase w = 0 then 1 else -1) * n))

