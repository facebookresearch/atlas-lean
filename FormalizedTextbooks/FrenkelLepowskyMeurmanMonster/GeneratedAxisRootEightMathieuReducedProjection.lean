module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisRootEightMathieuReducedFibers

/-! The corrected actual compact pair generates the full original Mathieu projected subgroup. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000

/-- A complete corrected compact reduced generator in the actual local group. -/
def generatedRootEightMathieuReducedLocal
    (h0 : generatedRootEightCompactSourceCondition 0)
    (h1 : generatedRootEightCompactSourceCondition 1)
    (h4 : generatedRootEightCompactSourceCondition 4)
    (h8 : generatedRootEightCompactSourceCondition 8) (q : Q) (j : Fin 2) : H :=
  localFiberIntoH (generatedRootEightMathieuReducedCorrectedFiber h0 h1 h4 h8 q j)

/-- Every actual corrected compact generator has its complete genuine Mathieu projection. -/
theorem generatedRootEight_mathieu_reduced_local_projection
    (h0 : generatedRootEightCompactSourceCondition 0)
    (h1 : generatedRootEightCompactSourceCondition 1)
    (h4 : generatedRootEightCompactSourceCondition 4)
    (h8 : generatedRootEightCompactSourceCondition 8) (q : Q) (j : Fin 2) :
    projH (generatedRootEightMathieuReducedLocal h0 h1 h4 h8 q j) =
      QuotientGroup.mk' signsSubgroup
        (golayPermutationIsometry (generatedRootEightMathieuReducedGenerator j)) := by
  change QuotientGroup.mk' signsSubgroup
    (generatedRootEightMathieuReducedCorrectedFiber h0 h1 h4 h8 q j).val.2 = _
  rw [generatedRootEight_mathieu_reduced_corrected_spatial]

/-- The whole projected subgroup generated by the genuine pair is the actual Mathieu point image. -/
theorem generatedRootEight_mathieu_reduced_projected_generated
    (h0 : generatedRootEightCompactSourceCondition 0)
    (h1 : generatedRootEightCompactSourceCondition 1)
    (h4 : generatedRootEightCompactSourceCondition 4)
    (h8 : generatedRootEightCompactSourceCondition 8) (q : Fin 2 → Q) :
    Subgroup.closure (Set.range fun j =>
      projH (generatedRootEightMathieuReducedLocal h0 h1 h4 h8 (q j) j)) =
      (leechNormSixHS100PairPointStabilizer.map
        (leechNormSixActualPairStabilizer leechNormSixHS100Root leechNormSixHS100Companion).subtype).map
          (QuotientGroup.mk' signsSubgroup) := by
  have he : (fun j => projH (generatedRootEightMathieuReducedLocal h0 h1 h4 h8 (q j) j)) =
      (fun j => QuotientGroup.mk' signsSubgroup
        (golayPermutationIsometry (generatedRootEightMathieuReducedGenerator j))) := by
    funext j
    exact generatedRootEight_mathieu_reduced_local_projection h0 h1 h4 h8 (q j) j
  rw [he]
  have hm := MonoidHom.map_closure (QuotientGroup.mk' signsSubgroup)
    (Set.range fun j => golayPermutationIsometry (generatedRootEightMathieuReducedGenerator j))
  rw [← Set.range_comp, generatedRootEight_mathieu_reduced_in_conway] at hm
  exact hm.symm

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
