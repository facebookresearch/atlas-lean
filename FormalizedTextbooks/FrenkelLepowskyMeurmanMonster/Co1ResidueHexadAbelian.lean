module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueHexad
public import Mathlib.Logic.Equiv.Fintype

/-! The actual source contract for a six-element hexad implies that its pair-point images
 generate an abelian subgroup. This is the local ingredient of Ivanov II Proposition 4.2.5. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Three distinct coordinates can be placed first in a permutation of the six-element hexad. -/
theorem co1ResidueHexad_three_coordinates (a b c : Fin 6)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    ∃ v : Equiv.Perm (Fin 6), v 0 = a ∧ v 1 = b ∧ v 2 = c := by
  let f : Fin 3 → Fin 6 := fun i => ⟨i.val, lt_trans i.isLt (by decide +kernel)⟩
  have hf : Function.Injective f := fun i j h => Fin.ext (congrArg (fun k : Fin 6 => k.val) h)
  have ht : Function.Injective (![a, b, c] : Fin 3 → Fin 6) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all
  obtain ⟨v, hv⟩ := Equiv.Perm.exists_extending_pair f ![a, b, c] hf ht
  exact ⟨v, hv 0, hv 1, hv 2⟩

/-- Four distinct coordinates can be placed first in a permutation of the six-element hexad. -/
theorem co1ResidueHexad_four_coordinates (a b c d : Fin 6)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ∃ v : Equiv.Perm (Fin 6), v 0 = a ∧ v 1 = b ∧ v 2 = c ∧ v 3 = d := by
  let f : Fin 4 → Fin 6 := fun i => ⟨i.val, lt_trans i.isLt (by decide +kernel)⟩
  have hf : Function.Injective f := fun i j h => Fin.ext (congrArg (fun k : Fin 6 => k.val) h)
  have ht : Function.Injective (![a, b, c, d] : Fin 4 → Fin 6) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all
  obtain ⟨v, hv⟩ := Equiv.Perm.exists_extending_pair f ![a, b, c, d] hf ht
  exact ⟨v, hv 0, hv 1, hv 2, hv 3⟩

/-- Arbitrary overlapping pair-point images commute under the genuine hexad matching relations. -/
theorem co1ResidueHexad_common_coordinate_commute {G : Type*} [Group G]
    (x : Fin 6 → Fin 6 → G)
    (hsquare : ∀ a b, a ≠ b → x a b * x a b = 1)
    (hline : ∀ v : Fin 6 → Fin 6, Function.Bijective v →
      x (v 0) (v 1) * x (v 2) (v 3) * x (v 4) (v 5) = 1)
    (a b c : Fin 6) (hab : a ≠ b) (hac : a ≠ c) : Commute (x a b) (x a c) := by
  by_cases hbc : b = c
  · rw [hbc]
  obtain ⟨v, h0, h1, h2⟩ := co1ResidueHexad_three_coordinates a b c hab hac hbc
  have h := co1ResidueHexad_overlapping_commute_relabel x hsquare hline v v.bijective
  simpa only [h0, h1, h2] using h

/-- Disjoint pair-point images commute because they are on a perfect-matching line. -/
theorem co1ResidueHexad_disjoint_commute {G : Type*} [Group G]
    (x : Fin 6 → Fin 6 → G)
    (hsquare : ∀ a b, a ≠ b → x a b * x a b = 1)
    (hline : ∀ v : Fin 6 → Fin 6, Function.Bijective v →
      x (v 0) (v 1) * x (v 2) (v 3) * x (v 4) (v 5) = 1)
    (a b c d : Fin 6) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) : Commute (x a b) (x c d) := by
  obtain ⟨v, h0, h1, h2, h3⟩ := co1ResidueHexad_four_coordinates a b c d
    hab hac had hbc hbd hcd
  have hl := hline (v ∘ ![4, 5, 0, 1, 2, 3]) (v.bijective.comp (by decide +kernel))
  have h := co1GeometryCommutator_line_commute (x (v 4) (v 5))
    (x (v 0) (v 1)) (x (v 2) (v 3))
    (hsquare _ _ (v.injective.ne (by decide +kernel)))
    (hsquare _ _ (v.injective.ne (by decide +kernel)))
    (hsquare _ _ (v.injective.ne (by decide +kernel))) hl
  simpa only [h0, h1, h2, h3] using h

/-- All unordered pair-point images of a hexad commute, using only point involutions and
original perfect-matching triple products. -/
theorem co1ResidueHexad_pairwise_commute {G : Type*} [Group G]
    (x : Fin 6 → Fin 6 → G) (hsymm : ∀ a b, x a b = x b a)
    (hsquare : ∀ a b, a ≠ b → x a b * x a b = 1)
    (hline : ∀ v : Fin 6 → Fin 6, Function.Bijective v →
      x (v 0) (v 1) * x (v 2) (v 3) * x (v 4) (v 5) = 1)
    (a b c d : Fin 6) (hab : a ≠ b) (hcd : c ≠ d) : Commute (x a b) (x c d) := by
  by_cases hac : a = c
  · subst c
    exact co1ResidueHexad_common_coordinate_commute x hsquare hline a b d hab hcd
  by_cases had : a = d
  · subst d
    rw [hsymm c a]
    exact co1ResidueHexad_common_coordinate_commute x hsquare hline a b c hab hcd.symm
  by_cases hbc : b = c
  · subst c
    rw [hsymm a b]
    exact co1ResidueHexad_common_coordinate_commute x hsquare hline b a d hab.symm hcd
  by_cases hbd : b = d
  · subst d
    rw [hsymm a b, hsymm c b]
    exact co1ResidueHexad_common_coordinate_commute x hsquare hline b a c hab.symm hcd.symm
  exact co1ResidueHexad_disjoint_commute x hsquare hline a b c d hab hac had hbc hbd hcd

/-- The subgroup generated by all hexad pair-point images is abelian. No finiteness,
classification, or matrix-faithfulness assumption enters this conclusion. -/
theorem co1ResidueHexad_generated_abelian {G : Type*} [Group G]
    (x : Fin 6 → Fin 6 → G) (hsymm : ∀ a b, x a b = x b a)
    (hsquare : ∀ a b, a ≠ b → x a b * x a b = 1)
    (hline : ∀ v : Fin 6 → Fin 6, Function.Bijective v →
      x (v 0) (v 1) * x (v 2) (v 3) * x (v 4) (v 5) = 1) :
    IsMulCommutative (Subgroup.closure {g | ∃ a b, a ≠ b ∧ g = x a b}) := by
  apply Subgroup.isMulCommutative_closure
  rintro _ ⟨a, b, hab, rfl⟩ _ ⟨c, d, hcd, rfl⟩ _
  exact co1ResidueHexad_pairwise_commute x hsymm hsquare hline a b c d hab hcd

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
