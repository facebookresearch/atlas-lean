module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisFifthSourceOctadPairs
public import Mathlib.Algebra.Group.Action.Pointwise.Finset

/-! The five original permutations lie in the genuine source-octad stabilizer. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped Pointwise
set_option backward.isDefEq.respectTransparency false

/-- The full actual permutation stabilizer of source Golay word14. -/
def generatedFifthSourceOctadSubgroup : Subgroup golayAutomorphismSubgroup where
  carrier := {p | golayPermute p.val (golayEncoder (golayLabelCoefficients 14)) =
    golayEncoder (golayLabelCoefficients 14)}
  one_mem' := rfl
  mul_mem' := by
    intro p q hp hq
    change golayPermute p.val
      (golayPermute q.val (golayEncoder (golayLabelCoefficients 14))) = _
    rw [hq, hp]
  inv_mem' := by
    intro p hp
    have h := congrArg (golayPermute p.val⁻¹) hp
    rw [golayPermute_inv] at h
    exact h.symm

/-- The actual source word has precisely the eight physical coordinates four through eleven. -/
theorem generatedFifthSourceOctad_coordinate : ∀ i : Fin 24,
    golayEncoder (golayLabelCoefficients 14) i =
      if 4 ≤ i.val ∧ i.val < 12 then (1 : ZMod 2) else 0 := by
  decide +kernel

/-- Each of the five original permutation generators preserves the actual source octad. -/
theorem generatedFifthSourceOctad_generator_mem (k : Fin 5) :
    generatedFifthSourceOctadPermutation k ∈ generatedFifthSourceOctadSubgroup := by
  fin_cases k
  · exact (generatedFourth_permutation_generator_mem 0).1
  · exact (generatedFourth_permutation_generator_mem 1).1
  · exact (generatedFourth_permutation_generator_mem 2).1
  · exact (generatedFourth_permutation_generator_mem 3).1
  · change golayPermute (omegaOrbitGolayPermutation 0).val
      (golayEncoder (golayLabelCoefficients 14)) = golayEncoder (golayLabelCoefficients 14)
    funext i
    revert i
    decide +kernel

/-- The subgroup generated by the five actual source permutation words. -/
def generatedFifthSourceOctadFiveSubgroup : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range generatedFifthSourceOctadPermutation)

/-- The generated five-word subgroup lies in the full genuine source-octad stabilizer. -/
theorem generatedFifthSourceOctad_five_le :
    generatedFifthSourceOctadFiveSubgroup ≤ generatedFifthSourceOctadSubgroup := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨k, rfl⟩
  exact generatedFifthSourceOctad_generator_mem k

/-- The full original pair stabilizer lies in the generated five-word subgroup. -/
theorem generatedFifthSourceOctad_flag_le :
    generatedFourthPermutationFlagStabilizer ≤ generatedFifthSourceOctadFiveSubgroup := by
  apply generatedFourth_permutation_flag_le_of_generators
  intro k
  apply Subgroup.subset_closure
  refine ⟨⟨k.val, by omega⟩, ?_⟩
  fin_cases k <;> rfl

/-- Every displayed pair transversal is genuinely in the generated five-word subgroup. -/
theorem generatedFifthSourceOctad_rep_mem (r : Fin 28) :
    generatedFifthSourceOctadPairRep r ∈ generatedFifthSourceOctadFiveSubgroup := by
  apply Subgroup.list_prod_mem
  intro p hp
  obtain ⟨k, _, rfl⟩ := List.mem_map.mp hp
  exact Subgroup.subset_closure ⟨k, rfl⟩

/-- Source-octad preservation transports its actual eight physical coordinates. -/
theorem generatedFifthSourceOctad_preserves_coordinates
    (p : golayAutomorphismSubgroup) (hp : p ∈ generatedFifthSourceOctadSubgroup)
    (i : Fin 24) :
    (4 ≤ (p.val i).val ∧ (p.val i).val < 12) ↔ (4 ≤ i.val ∧ i.val < 12) := by
  have h := congrFun hp (p.val i)
  simp only [golayPermute, Equiv.symm_apply_apply, generatedFifthSourceOctad_coordinate] at h
  by_cases hi : 4 ≤ i.val ∧ i.val < 12
  · by_cases hj : 4 ≤ (p.val i).val ∧ (p.val i).val < 12
    · exact iff_of_true hj hi
    · norm_num [hi, hj] at h
  · by_cases hj : 4 ≤ (p.val i).val ∧ (p.val i).val < 12
    · norm_num [hi, hj] at h
    · exact iff_of_false hj hi

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
