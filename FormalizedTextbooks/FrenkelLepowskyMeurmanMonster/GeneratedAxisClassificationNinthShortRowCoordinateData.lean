/-- Decode one exact signed eight-bit integer coordinate from a packed word. -/
def generatedNinthShortRowCoordinateVector (w : ℕ) (i : Fin 24) : ℤ :=
  let b := (w >>> (8 * i.val)) % 256
  if b < 128 then (b : ℤ) else (b : ℤ) - 256

/-- Candidate integer coordinates for an original source row. -/
def generatedNinthShortRowSourceCoordinates (k : Fin 4136) : Fin 24 → ℤ :=
  generatedNinthShortRowCoordinateVector
    (generatedNinthShortRowSourceCoordinateWords[k.val]!)

/-- Candidate integer coordinates for an original target row. -/
def generatedNinthShortRowTargetCoordinates (k : Fin 4136) : Fin 24 → ℤ :=
  generatedNinthShortRowCoordinateVector
    (generatedNinthShortRowTargetCoordinateWords[k.val]!)

