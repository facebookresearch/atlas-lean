/-- The eight factors of the Tenth middle tensor after the whole root-two word. -/
theorem generatedFeasibleAmbientTenth_factor_data (r : Fin 8) :
    (generatedTenthTensorFactorData r 7).1 = (fun a => 262144 * generatedFeasibleAmbientTenthSpin
