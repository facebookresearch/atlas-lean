/-! The eight root-two factors of the Tenth middle tensor at every stage boundary, from the
cached monomial and sign formulas, the cached Gaussian and the finite stage checks. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- Integer scaling commutes with the integer Gaussian. -/
theorem generatedFeasibleAmbientTenth_xi_mul (c : ℤ) (u : Fin 4096 → ℤ) :
    generatedAxisGlobalOddXiSpinInteger (fun a => c * u a) =
      fun a => c * generatedAxisGlobalOddXiSpinInteger u a := by
  funext a
  simp only [generatedAxisGlobalOddXiSpinInteger, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro b _
  ring

/-- The empty monomial word fixes every integer spin vector. -/
theorem generatedFeasibleAmbientTenth_monomial_empty (u : Fin 4096 → ℤ) :
    generatedAxisGlobalOddMonomialSpinInteger [] u = u := by
  funext k
  simp [generatedAxisGlobalOddMonomialSpinInteger, generatedFourthMonomialWordPull,
    generatedAxisGlobalIntSign, generatedAxisGlobalSpinLabel_coeff]

/-- Integer scaling commutes with every root-two spin stage. -/
theorem generatedFeasibleAmbientTenth_stage_spin_mul (j : Fin 7) (c : ℤ) (u : Fin 4096 → ℤ) :
    generatedTwelfthTensorSourceStageSpin 2 j (fun a => c * u a) =
      fun a => c * generatedTwelfthTensorSourceStageSpin 2 j u a := by
  have hm (w : List (Fin 2 × Bool)) :
      generatedAxisGlobalOddMonomialSpinInteger w (fun a => c * u a) =
        fun a => c * generatedAxisGlobalOddMonomialSpinInteger w u a := by
    funext a
    simp only [generatedAxisGlobalOddMonomialSpinInteger]
    ring
  have hs (s : Fin 4096) (v : Fin 4096 → ℤ) :
      generatedTwelfthTensorSignSpinInteger s (fun a => c * v a) =
        fun a => c * generatedTwelfthTensorSignSpinInteger s v a := by
    funext a
    simp only [generatedTwelfthTensorSignSpinInteger]
    ring
  unfold generatedTwelfthTensorSourceStageSpin generatedTwelfthTensorSourceSignedSpin
  rw [hm, hs]
  split_ifs
  · exact generatedFeasibleAmbientTenth_xi_mul c _
  · rfl

/-- Integer scaling commutes with every root-two physical stage. -/
theorem generatedFeasibleAmbientTenth_stage_spatial_mul (j : Fin 7) (c : ℤ) (v : Fin 24 → ℤ) :
    generatedTwelfthTensorSourceStageSpatial 2 j (fun i => c * v i) =
      fun i => c * generatedTwelfthTensorSourceStageSpatial 2 j v i := by
  have hm (w : List (Fin 2 × Bool)) :
      generatedAxisGlobalOddMonomialSpatialInteger w (fun i => c * v i) =
        fun i => c * generatedAxisGlobalOddMonomialSpatialInteger w v i := by
    funext i
    rfl
  have hs (a : Fin 4096) (v' : Fin 24 → ℤ) :
      generatedTwelfthTensorSignSpatialInteger a (fun i => c * v' i) =
        fun i => c * generatedTwelfthTensorSignSpatialInteger a v' i := by
    funext i
    simp only [generatedTwelfthTensorSignSpatialInteger]
    ring
  have hx (v' : Fin 24 → ℤ) :
      generatedAxisGlobalOddXiSpatialInteger (fun i => c * v' i) =
        fun i => c * generatedAxisGlobalOddXiSpatialInteger v' i := by
    funext i
    simp only [generatedAxisGlobalOddXiSpatialInteger, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  unfold generatedTwelfthTensorSourceStageSpatial generatedTwelfthTensorSourceSignedSpatial
  rw [hm, hs]
  split_ifs
  · exact hx _
  · rfl

/-- The root-two spin stage 0 of every factor. -/
theorem generatedFeasibleAmbientTenth_spin_stage00 (r : Fin 8) :
    generatedTwelfthTensorSourceStageSpin 2 0 (generatedFeasibleAmbientTenthSpin 0 r) =
      fun a => 8 * generatedFeasibleAmbientTenthSpin 1 r a := by
  change generatedAxisGlobalOddXiSpinInteger
    (generatedTwelfthTensorSignSpinInteger (generatedFeasibleAmbientTenthSignCode 0)
      (generatedAxisGlobalOddMonomialSpinInteger (generatedFeasibleAmbientTenthMonomialWord 0)
        (generatedFeasibleAmbientTenthSpin 0 r))) = _
  rw [generatedFeasibleAmbientTenth_monomial_cached_actual,
      generatedFeasibleAmbientTenth_sign_cached_actual 0, generatedFeasibleAmbientTenth_sign_fast0]
  have hm : (fun a => generatedFeasibleAmbientTenthMonomialPhaseSign 0 a *
      generatedFeasibleAmbientTenthSpin 0 r (generatedFeasibleAmbientTenthMonomialPull 0 a)) =
      fun a => generatedFeasibleAmbientTenthMonomialPhaseSignF 0 a *
          generatedFeasibleAmbientTenthSpin 0 r (generatedFeasibleAmbientTenthMonomialPullF 0 a)
          := by
    funext a
    rw [(generatedFeasibleAmbientTenth_monomial_fast 0 a).1,
        (generatedFeasibleAmbientTenth_monomial_fast 0 a).2]
  have hs : generatedFeasibleAmbientTenthSignSpinCompactF 0 (fun a =>
      generatedFeasibleAmbientTenthMonomialPhaseSignF 0 a *
      generatedFeasibleAmbientTenthSpin 0 r (generatedFeasibleAmbientTenthMonomialPullF 0 a)) =
      fun a => 2 * generatedFeasibleAmbientTenthSignSpin 0 r a :=
    funext (generatedFeasibleAmbientTenth_sign_spin_check00 r)
  rw [hm, hs, generatedFeasibleAmbientTenth_xi_mul, generatedTwelfth_tensor_xi_integer_cached,
    ← generatedFeasibleAmbientTenth_xi_fast]
  funext a
  have hx : generatedFeasibleAmbientTenthXi (generatedFeasibleAmbientTenthSignSpin 0 r) a =
      4 * generatedFeasibleAmbientTenthSpin 1 r a := by
    fin_cases r
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_00 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_01 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_02 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_03 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_04 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_05 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_06 a
    · exact generatedFeasibleAmbientTenth_xi_spin_check00_07 a
  rw [hx]
  ring

