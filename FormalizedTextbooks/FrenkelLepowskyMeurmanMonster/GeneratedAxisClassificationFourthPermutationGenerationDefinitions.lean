module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthMonomialSpatial
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismGeneration

/-! The genuine code-fourteen and unordered-pair Golay permutation stabilizer. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- Actual permutations preserving code14 and the unordered physical pair eight and eleven. -/
def generatedFourthPermutationFlagStabilizer : Subgroup golayAutomorphismSubgroup where
  carrier := {p | golayPermute p.val (golayEncoder (golayLabelCoefficients 14)) =
      golayEncoder (golayLabelCoefficients 14) ∧
    ∀ i : Fin 24, (p.val i = 8 ∨ p.val i = 11) ↔ (i = 8 ∨ i = 11)}
  one_mem' := ⟨rfl, fun _ => Iff.rfl⟩
  mul_mem' := by
    intro p q hp hq
    constructor
    · change golayPermute p.val
        (golayPermute q.val (golayEncoder (golayLabelCoefficients 14))) = _
      rw [hq.1, hp.1]
    · intro i
      exact (hp.2 (q.val i)).trans (hq.2 i)
  inv_mem' := by
    intro p hp
    constructor
    · have h := congrArg (golayPermute p.val⁻¹) hp.1
      rw [golayPermute_inv] at h
      exact h.symm
    · intro i
      change (p.val.symm i = 8 ∨ p.val.symm i = 11) ↔ (i = 8 ∨ i = 11)
      have h := hp.2 (p.val.symm i)
      simpa only [p.val.apply_symm_apply] using h.symm

/-- Membership states precisely the actual word and unordered-pair preservation conditions. -/
theorem generatedFourthPermutationFlagStabilizer_mem (p : golayAutomorphismSubgroup) :
    p ∈ generatedFourthPermutationFlagStabilizer ↔
      golayPermute p.val (golayEncoder (golayLabelCoefficients 14)) =
        golayEncoder (golayLabelCoefficients 14) ∧
      ∀ i : Fin 24, (p.val i = 8 ∨ p.val i = 11) ↔ (i = 8 ∨ i = 11) := Iff.rfl

/-- Each frozen actual monomial word preserves the genuine word14 and unordered pair. -/
theorem generatedFourth_permutation_generator_mem (k : Fin 4) :
    generatedFourthMonomialPermutation k ∈ generatedFourthPermutationFlagStabilizer := by
  constructor
  · funext i
    exact generatedFourth_monomial_code_certificate k i
  · intro i
    rw [generatedFourth_monomial_images]
    have h : ∀ k : Fin 4, ∀ i : Fin 24,
        (generatedFourthMonomialImages k i = 8 ∨ generatedFourthMonomialImages k i = 11) ↔
          (i = 8 ∨ i = 11) := by decide +kernel
    exact h k i

/-- The subgroup generated by exactly the four frozen genuine permutation words. -/
def generatedFourthPermutationFourSubgroup : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range generatedFourthMonomialPermutation)

/-- The generated subgroup lies in the stated actual stabilizer before counting or generation. -/
theorem generatedFourth_permutation_four_le :
    generatedFourthPermutationFourSubgroup ≤ generatedFourthPermutationFlagStabilizer := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨k, rfl⟩
  exact generatedFourth_permutation_generator_mem k

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
