/-- Decode a packed octad block: 22-bit fields of a 6-bit entry label and a 16-bit value with
offset `32768`. -/
def srcDecodeOctB (v : ℕ) : ℕ → List (ℕ × ℤ)
  | 0 => []
  | n + 1 => ((v &&& 63 : ℕ), (((v >>> 6) &&& 65535 : ℕ) : ℤ) - 32768) :: srcDecodeOctB (v >>> 22) n

/-- The octad image blocks split along a split of the octad labels. -/
theorem srcTwTriOct_append (K : ℤ) (B : List (ℕ × List (ℕ × ℤ))) (a b : List ℕ) :
    twTriOct K B (a ++ b) = twTriOct K B a ++ twTriOct K B b := List.map_append

