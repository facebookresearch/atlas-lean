/-- Actual preferred physical sign masks in the displayed octad coordinates. -/
def generatedFifthEvenRootSignMask (j : Fin 56) : Nat :=
  (List.finRange 8).foldr (fun k m =>
    (if (trialityEvenMask (generatedFifthEvenRootSign j)).testBit k.val then
      2 ^ (generatedFifthEvenRootCoordinates j k).val else 0) ||| m) 0

/-- Preferred integer output vectors in the original physical coordinates. -/
def generatedFifthEvenRootIntegral (j : Fin 56) : Fin 24 → ℤ := fun i =>
  if (golayEncodedMask (generatedFifthEvenRootCode j).val).testBit i.val then
    if (generatedFifthEvenRootSignMask j).testBit i.val then -2 else 2
  else 0

