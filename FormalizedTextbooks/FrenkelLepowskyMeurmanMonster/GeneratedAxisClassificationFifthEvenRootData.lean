/-- Every displayed output code is genuinely an actual Golay octad. -/
theorem generatedFifthEvenRootCode_mem : ∀ j : Fin 56,
    generatedFifthEvenRootCode j ∈ golayOctads := by
  decide +kernel

/-- Every recorded physical pair has increasing original coordinates. -/
theorem generatedFifthEvenRootInput_ordered : ∀ j : Fin 56,
    (match generatedFifthEvenRootInputData j with
    | Sum.inl (_, a, b) => decide (a < b)
    | Sum.inr _ => true) = true := by
  decide +kernel

