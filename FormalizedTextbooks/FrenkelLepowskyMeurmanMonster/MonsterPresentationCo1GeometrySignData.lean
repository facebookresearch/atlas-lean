/- Actual code-basis sign matrices, derived from the displayed integral Leech basis. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LeechOrbitActions
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationCo1GeometryMonomialTwoCore

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped Matrix

/-- The twelve actual encoder-basis Golay codewords. -/
def monsterCo1GeometrySignCode (j : Fin 12) : golayCode :=
  ⟨golayEncoder (Pi.single j 1), ⟨_, rfl⟩⟩

/-- The corresponding genuine integral-lattice sign isometries. -/
def monsterCo1GeometrySignIsometry (j : Fin 12) : leechIsomSubgroup :=
  golaySignIsometry (monsterCo1GeometrySignCode j)

/-- The physical diagonal integer sign matrices. -/
def monsterCo1GeometrySignPhysical (k : Fin 12) : Matrix (Fin 24) (Fin 24) ℤ :=
  fun i j => if i = j then
    if golayEncoder (Pi.single k 1) i = 0 then 1 else -1
  else 0

