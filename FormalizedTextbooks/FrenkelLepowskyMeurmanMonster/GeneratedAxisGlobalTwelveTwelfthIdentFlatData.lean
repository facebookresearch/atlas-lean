/-! # Literal tables of the flat short block of the cheap Twelfth source vector

Data only (checked against the computed short block in the modules
`GeneratedAxisGlobalTwelveTwelfthIdentFlatOct` and `...FlatOdd0/1`): the octad terms and, per
coordinate, the odd
terms of `twelfthSrcVecC`, in source order, packed in `24`-bit fields (`17`-bit label, `7`-bit
numerator offset `64`) and decoded by halving (`twDecodeU`). -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
namespace GeneratedAxisGlobalTwelveTwelfthIdent
open GeneratedAxisGlobalIdent
set_option autoImplicit false
set_option Elab.async false

/-- Boolean comparison of two lists of short terms. -/
def twLBEq : List (ℕ × ℤ) → List (ℕ × ℤ) → Bool
  | [], [] => true
  | a :: l, b :: m => (a.1 == b.1 && a.2 == b.2) && twLBEq l m
  | _, _ => false

/-- A successful comparison is an equality. -/
theorem twLBEq_eq : ∀ l m : List (ℕ × ℤ), twLBEq l m = true → l = m
  | [], [], _ => rfl
  | a :: l, b :: m, h => by
    simp only [twLBEq, Bool.and_eq_true, beq_iff_eq] at h
    rw [Prod.ext h.1.1 h.1.2, twLBEq_eq l m h.2]
  | [], _ :: _, h => by simp [twLBEq] at h
  | _ :: _, [], h => by simp [twLBEq] at h

/-- Decode `n` packed short terms from the first `2 ^ m` fields of width `24` (by halving). -/
def twDecodeU (m t n : ℕ) : List (ℕ × ℤ) :=
  ((twUnpack 24 m t).take n).map (fun f => (f % 131072, (((f >>> 17) % 128 : ℕ) : ℤ) - 64))

set_option maxRecDepth 100000 in
