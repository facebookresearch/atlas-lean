/-- One complete three-slot odd row; all positions and weights are retained. -/
def generatedSeventhXiTensorOddRow (g : Fin 232) : ℕ :=
  (generatedSeventhXiTensorOddRows ⟨g.val / 8, by omega⟩ >>> (24 * (g.val % 8))) % 2 ^ 24

/-- A signed coefficient decoded from its checked three-bit representation. -/
def generatedSeventhXiTensorOddWeight (g : Fin 232) (k : Fin 3) : ℤ :=
  let c := ((generatedSeventhXiTensorOddRow g >>> (8 * k.val)) >>> 5) % 8
  if c = 0 then 0 else if c = 1 then 1 else if c = 2 then -1 else if c = 3 then 3 else -3

/-- The original physical coordinate stored in one checked sparse slot. -/
def generatedSeventhXiTensorOddPosition (g : Fin 232) (k : Fin 3) : ℕ :=
  (generatedSeventhXiTensorOddRow g >>> (8 * k.val)) % 32

/-- The original middle odd coefficient, evaluated from three verified packed slots. -/
def generatedSeventhXiTensorOddCache (d : Fin 2048) (i : Fin 24) : ℤ :=
  if h : generatedSeventhXiOddPackedInverse d < 232 then
    ∑ k : Fin 3, generatedSeventhXiTensorOddWeight ⟨generatedSeventhXiOddPackedInverse d, h⟩ k *
      (if generatedSeventhXiTensorOddPosition ⟨generatedSeventhXiOddPackedInverse d, h⟩ k = i.val
        then 1 else 0)
  else 0

