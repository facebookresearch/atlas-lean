set_option maxRecDepth 100000 in
-- Finite check of the bounds of every row operation.
theorem tenthForestStageOps_valid (s : ℕ) :
    ∀ ops ∈ tenthForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
  have h : ∀ s < 5, ∀ ops ∈ tenthForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
    decide +kernel
  by_cases hs : s < 5
  · exact h s hs
  · have : tenthForestStageOps s = [] := by
      match s, hs with
      | n + 5, _ => rfl
    simp [this]

theorem tenthForestStart_testBit (b : ℕ) :
    tenthForestStart.testBit b = decide (b ∈ tenthForestRoots) :=
  tenthForestOfList_testBit _ b

set_option maxRecDepth 100000 in
-- The 87 roots are bounded masks.
theorem tenthForestRoots_lt : ∀ m ∈ tenthForestRoots, m < 16777216 := by decide +kernel

theorem tenthForestStart_bounded : TenthForestBounded tenthForestStart := by
  intro b hb
  rw [tenthForestStart_testBit]
  simp only [decide_eq_false_iff_not]
  intro hm
  have := tenthForestRoots_lt b hm
  omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
