module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismOrder
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismPermutations

/-! Exact order of the genuine signed Golay permutation subgroup of Co₀.
This counts constructed lattice isometries, without asserting that an arbitrary
lattice isometry stabilizing the coordinate frame is already monomial. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

private theorem golaySign_zero : golaySignIsometry 0 = 1 := golaySignHom.map_one

private theorem golaySign_add (d e : golayCode) :
    golaySignIsometry (d + e) = golaySignIsometry d * golaySignIsometry e :=
  golaySignHom.map_mul (Multiplicative.ofAdd d) (Multiplicative.ofAdd e)

private theorem golaySign_inv (d : golayCode) : (golaySignIsometry d)⁻¹ = golaySignIsometry d := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  rfl

private theorem golayPermutation_zero : golayPermutationIsometry 1 = 1 :=
  golayPermutationHom.map_one

private theorem golayPermutation_mul (p q : golayAutomorphismSubgroup) :
    golayPermutationIsometry (p * q) = golayPermutationIsometry p * golayPermutationIsometry q :=
  golayPermutationHom.map_mul p q

private theorem golayPermutation_inv (p : golayAutomorphismSubgroup) :
    (golayPermutationIsometry p)⁻¹ = golayPermutationIsometry p⁻¹ :=
  (golayPermutationHom.map_inv p).symm

/-- Physical code permutations conjugate codeword signs by their actual action on codewords. -/
theorem golayPermutation_sign_commute (p : golayAutomorphismSubgroup) (d : golayCode) :
    golayPermutationIsometry p * golaySignIsometry d =
      golaySignIsometry (golayCodePermutation p d) * golayPermutationIsometry p := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  rfl

/-- A codeword sign matrix followed by an actual Golay coordinate permutation. -/
noncomputable def golayMonomialPair (a : golayCode × golayAutomorphismSubgroup) :
    leechIsomSubgroup :=
  golaySignIsometry a.1 * golayPermutationIsometry a.2

/-- The genuine signed permutation subgroup generated by these two concrete constructions. -/
noncomputable def golayMonomialSubgroup : Subgroup leechIsomSubgroup where
  carrier := {g | ∃ d p, g = golaySignIsometry d * golayPermutationIsometry p}
  one_mem' := ⟨0, 1, by rw [golaySign_zero, golayPermutation_zero, mul_one]⟩
  mul_mem' := by
    rintro a b ⟨d, p, rfl⟩ ⟨e, q, rfl⟩
    refine ⟨d + golayCodePermutation p e, p * q, ?_⟩
    rw [golaySign_add, golayPermutation_mul]
    calc
      (golaySignIsometry d * golayPermutationIsometry p) *
          (golaySignIsometry e * golayPermutationIsometry q) =
          golaySignIsometry d * (golayPermutationIsometry p * golaySignIsometry e) *
            golayPermutationIsometry q := by simp only [mul_assoc]
      _ = (golaySignIsometry d * golaySignIsometry (golayCodePermutation p e)) *
            (golayPermutationIsometry p * golayPermutationIsometry q) := by
        rw [golayPermutation_sign_commute]
        simp only [mul_assoc]
  inv_mem' := by
    rintro a ⟨d, p, rfl⟩
    refine ⟨golayCodePermutation p⁻¹ d, p⁻¹, ?_⟩
    rw [mul_inv_rev, golaySign_inv, golayPermutation_inv, golayPermutation_sign_commute]

@[simp] theorem golayMonomialPair_apply (a : golayCode × golayAutomorphismSubgroup)
    (x : Fin 24 → ℝ) (i : Fin 24) :
    (golayMonomialPair a).val x i = qSign (a.1.val i) * x (a.2.val.symm i) := rfl

/-- Distinct codeword/permutation pairs give distinct actual real lattice maps. -/
theorem golayMonomialPair_injective : Function.Injective golayMonomialPair := by
  rintro ⟨d, p⟩ ⟨e, q⟩ h
  have hpq : p = q := by
    apply Subtype.ext
    have hinv : p.val.symm = q.val.symm := by
      apply Equiv.ext
      intro i
      by_contra hi
      have hh := congrArg (fun g : leechIsomSubgroup =>
        g.val (Pi.single (p.val.symm i) 1) i) h
      rw [golayMonomialPair_apply, golayMonomialPair_apply] at hh
      have hne : q.val.symm i ≠ p.val.symm i := Ne.symm hi
      simp only [Pi.single_apply, ite_true, hne, ite_false, mul_one, mul_zero] at hh
      have hs := qSign_sq (d.val i)
      rw [hh, zero_mul] at hs
      norm_num at hs
    simpa using congrArg Equiv.symm hinv
  subst q
  have hd : golaySignIsometry d = golaySignIsometry e := mul_right_cancel h
  change golaySignHom (Multiplicative.ofAdd d) = golaySignHom (Multiplicative.ofAdd e) at hd
  have hde := congrArg Multiplicative.toAdd (golaySignHom_injective hd)
  exact Prod.ext hde rfl

/-- The pair parametrization lands in the constructed monomial subgroup. -/
noncomputable def golayMonomialEnumeration (a : golayCode × golayAutomorphismSubgroup) :
    golayMonomialSubgroup := ⟨golayMonomialPair a, a.1, a.2, rfl⟩

/-- Codeword/permutation pairs enumerate the constructed monomial subgroup bijectively. -/
theorem golayMonomialEnumeration_bijective : Function.Bijective golayMonomialEnumeration := by
  constructor
  · intro a b h
    exact golayMonomialPair_injective (congrArg Subtype.val h)
  · rintro ⟨g, d, p, h⟩
    exact ⟨(d, p), Subtype.ext h.symm⟩

/-- Exact order of the concrete monomial lattice isometry subgroup. -/
theorem golayMonomialSubgroup_card : Nat.card golayMonomialSubgroup = 1002795171840 := by
  rw [← Nat.card_congr (Equiv.ofBijective golayMonomialEnumeration
      golayMonomialEnumeration_bijective),
    Nat.card_prod, golayCode_card, golayAutomorphism_card]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
