module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisFourthFlagFramesGeneration
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthPermutationGenerationDefinitions

/-! Physical membership of the actual four-word permutation subgroup. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- Every permutation generated by the four original words belongs to the physical flag closure. -/
theorem generatedFourthFlagFrames_permutation_mem
    (p : golayAutomorphismSubgroup) (hp : p ∈ generatedFourthPermutationFourSubgroup) :
    golayPermutationIsometry p ∈ generatedFourthPhysicalFlagGeneratorSubgroup := by
  have hle : generatedFourthPermutationFourSubgroup ≤
      generatedFourthPhysicalFlagGeneratorSubgroup.comap golayPermutationHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    change golayPermutationIsometry (generatedFourthMonomialPermutation k) ∈
      generatedFourthPhysicalFlagGeneratorSubgroup
    rw [← generatedFourth_monomial_spatial]
    exact generatedFourthFlagGenerator_monomial_mem k
  exact hle hp

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
