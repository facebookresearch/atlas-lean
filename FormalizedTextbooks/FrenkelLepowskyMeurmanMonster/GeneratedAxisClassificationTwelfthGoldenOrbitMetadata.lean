/-- Rank zero denotes the original matrix base, and every Xi letter is the original anchor. -/
theorem generatedTwelfthGoldenOrbit_metadata (i : Fin 24192) :
    (generatedTwelfthGoldenMatrixRank i = 0 → i = 18197) ∧
    (generatedTwelfthGoldenMatrixLetter i = 17 → i = 22875) := by
  have hb : i.val / 512 < 48 := by omega
  interval_cases hd : i.val / 512
  · let n : Fin 512 := ⟨i.val % 512, by omega⟩
    have hl : (⟨0 + n.val, by omega⟩ : Fin 24192) = i := by
      apply Fin.ext
      dsimp only [n]
      omega
    have h := generatedTwelfthGoldenOrbitMetadataBlock000 n
    dsimp only at h
    rwa [hl] at h
  · let n : Fin 512 := ⟨i.val % 512, by omega⟩
    have hl : (⟨512 + n.val, by omega⟩ : Fin 24192) = i := by
      apply Fin.ext
      dsimp only [n]
      omega
    have h := generatedTwelfthGoldenOrbitMetadataBlock001 n
    dsimp only at h
    rwa [hl] at h
  · let n : Fin 512 := ⟨i.val % 512, by omega⟩
    have hl : (⟨1024 + n.val, by omega⟩ : Fin 24192) = i := by
      apply Fin.ext
      dsimp only [n]
      omega
    have h := generatedTwelfthGoldenOrbitMetadataBlock002 n
    dsimp only at h
    rwa [hl] at h
  · let n : Fin 512 := ⟨i.val % 512, by omega⟩
    have hl : (⟨1536 + n.val, by omega⟩ : Fin 24192) = i := by
      apply Fin.ext
