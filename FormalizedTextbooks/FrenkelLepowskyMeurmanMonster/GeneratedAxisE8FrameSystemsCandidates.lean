module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisE8FrameSystemsCandidateData
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisE8FrameSystemsCoordinates

/-! The displayed intrinsic candidates are genuine sixteen-element singular subspaces
and hence actual fifteen-frame systems. Coverage is proved separately. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The displayed four root-coordinate columns are independent. -/
theorem generatedAxisE8FrameSystemCandidateMap_injective (k : Fin 270) :
    Function.Injective (generatedAxisE8FrameSystemCandidateMap k) := by
  intro a b hab
  have hz : generatedAxisE8FrameSystemCandidateMap k (a - b) = 0 := by
    rw [map_sub, hab, sub_self]
  exact sub_eq_zero.mp (generatedAxisE8FrameSystemCandidateMap_zero_certificate k _ hz)

/-- The actual intrinsic subspace generated by a displayed four-column candidate. -/
def generatedAxisE8FrameSystemCandidate (k : Fin 270) :
    Submodule (ZMod 2) (Fin 8 → ZMod 2) := (generatedAxisE8FrameSystemCandidateMap k).range

/-- Each candidate contains sixteen binary vectors, rather than just fifteen chosen labels. -/
theorem generatedAxisE8FrameSystemCandidate_card (k : Fin 270) :
    Nat.card (generatedAxisE8FrameSystemCandidate k) = 16 := by
  have he := Nat.card_congr (Submodule.equivMapOfInjective
    (generatedAxisE8FrameSystemCandidateMap k)
    (generatedAxisE8FrameSystemCandidateMap_injective k) ⊤).toEquiv
  rw [Submodule.map_top] at he
  change Nat.card (generatedAxisE8FrameSystemCandidateMap k).range = 16
  rw [← he, Nat.card_congr (Submodule.topEquiv :
    (⊤ : Submodule (ZMod 2) (Fin 4 → ZMod 2)) ≃ₗ[ZMod 2] (Fin 4 → ZMod 2)).toEquiv]
  rw [Nat.card_eq_fintype_card]
  decide +kernel

/-- Every displayed candidate is totally singular for the intrinsic E8 form. -/
theorem generatedAxisE8FrameSystemCandidate_mem (k : Fin 270) :
    generatedAxisE8FrameSystemCandidate k ∈ generatedAxisE8IntrinsicFrameSystems := by
  refine ⟨generatedAxisE8FrameSystemCandidate_card k, ?_⟩
  rintro a ⟨b, rfl⟩
  exact generatedAxisE8FrameSystemCandidateMap_quadratic_certificate k b

/-- The actual lattice-quotient image of a displayed candidate. -/
def generatedAxisE8ActualFrameSystemCandidate (k : Fin 270) :
    Submodule (ZMod 2) LeechModTwo :=
  (generatedAxisE8FrameSystemCandidate k).map generatedAxisE8FrameRootEmbedding

/-- Every displayed candidate gives a genuine fifteen-frame system in the selected section. -/
theorem generatedAxisE8ActualFrameSystemCandidate_mem (k : Fin 270) :
    generatedAxisE8ActualFrameSystemCandidate k ∈ generatedAxisE8FrameSystems
      (generatedAxisE8CoordinateSection (golayOctadWord generatedFifthFlagOctad)) :=
  generatedAxisE8IntrinsicFrameSystems_map _ (generatedAxisE8FrameSystemCandidate_mem k)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
