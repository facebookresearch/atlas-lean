def generatedRootEightCanonicalTensorPreLabel (n : Fin 4096) : Fin 4096 :=
  ⟨((generatedRootEightCanonicalTensorPreLabelWords
    ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩).shiftRight
      (12 * (n.val % 16))) % 4096, Nat.mod_lt _ (by decide)⟩

/-- The full original sign at the canonical pre boundary. -/
def generatedRootEightCanonicalTensorPreSign (n : Fin 4096) : ℤ :=
  if (generatedRootEightCanonicalTensorPreSignWords
      ⟨n.val / 512, by omega⟩ ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩).testBit
    (n.val % 64) then -1 else 1

/-- The complete canonical pre monomial action. -/
