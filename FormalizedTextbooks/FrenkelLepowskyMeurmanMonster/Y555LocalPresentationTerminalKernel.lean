/- The exact kernel of the genuine terminal-substitution endomorphism of independent Y555. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationTerminalHom

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The three literal differences between terminal generators and their actual longest words. -/
def y555TerminalDifference (i : Fin 3) : BimonsterPresentation :=
  PresentedGroup.of (some (i, 4)) * (y555LocalLongest i)⁻¹

/-- The actual normal subgroup generated by the three explicit terminal differences. -/
def y555TerminalNormal : Subgroup BimonsterPresentation :=
  Subgroup.normalClosure (Set.range y555TerminalDifference)

instance : y555TerminalNormal.Normal := inferInstanceAs
  (Subgroup.normalClosure (Set.range y555TerminalDifference)).Normal

/-- Every terminal difference is killed by the already proved literal source endomorphism. -/
theorem y555TerminalDifference_mem_ker (i : Fin 3) :
    y555TerminalDifference i ∈ y555TerminalHom.ker := by
  change y555TerminalHom (y555TerminalDifference i) = 1
  simp only [y555TerminalDifference, map_mul, map_inv, y555TerminalHom_generator,
    y555TerminalImage, ite_true, y555TerminalHom_longest, mul_inv_cancel]

/-- The explicit terminal-difference normal subgroup lies in the actual endomorphism kernel. -/
theorem y555TerminalNormal_le_ker : y555TerminalNormal ≤ y555TerminalHom.ker := by
  apply Subgroup.normalClosure_le_normal
  rintro g ⟨i, rfl⟩
  exact y555TerminalDifference_mem_ker i

/-- Each literal terminal difference belongs to its actual normal closure. -/
theorem y555TerminalDifference_mem_normal (i : Fin 3) :
    y555TerminalDifference i ∈ y555TerminalNormal :=
  Subgroup.subset_normalClosure (Set.mem_range_self i)

/-- Original terminal generators and their longest words coincide in the explicit quotient. -/
theorem y555TerminalQuotient_generator (i : Fin 3) :
    (QuotientGroup.mk' y555TerminalNormal) (PresentedGroup.of (some (i, 4))) =
      (QuotientGroup.mk' y555TerminalNormal) (y555LocalLongest i) := by
  have h := (QuotientGroup.eq_one_iff (y555TerminalDifference i)).mpr
    (y555TerminalDifference_mem_normal i)
  change (QuotientGroup.mk' y555TerminalNormal) (y555TerminalDifference i) = 1 at h
  simp only [y555TerminalDifference, map_mul, map_inv] at h
  exact mul_inv_eq_one.mp h

/-- The actual quotient map agrees after terminal substitution on every original source element. -/
theorem y555TerminalQuotient_comp :
    (QuotientGroup.mk' y555TerminalNormal).comp y555TerminalHom =
      QuotientGroup.mk' y555TerminalNormal := by
  apply PresentedGroup.ext
  intro v
  simp only [MonoidHom.comp_apply, y555TerminalHom_generator]
  cases v with
  | none => rfl
  | some p =>
    rcases p with ⟨i, k⟩
    by_cases h : k = 4
    · subst k
      simpa only [y555TerminalImage, ite_true] using (y555TerminalQuotient_generator i).symm
    · simp only [y555TerminalImage, h, ite_false]

/-- The actual endomorphism kernel is exactly the normal closure of three literal differences. -/
theorem y555TerminalHom_ker : y555TerminalHom.ker = y555TerminalNormal := by
  apply le_antisymm
  · intro g hg
    have h := congrArg (fun f : BimonsterPresentation →* _ => f g)
      y555TerminalQuotient_comp
    change (QuotientGroup.mk' y555TerminalNormal) (y555TerminalHom g) =
      (QuotientGroup.mk' y555TerminalNormal) g at h
    change y555TerminalHom g = 1 at hg
    rw [hg, map_one] at h
    exact (QuotientGroup.eq_one_iff g).mp h.symm
  · exact y555TerminalNormal_le_ker

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
