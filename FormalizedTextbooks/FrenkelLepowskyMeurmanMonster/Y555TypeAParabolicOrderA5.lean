/- The genuine five-generator type A parabolic in the independent C322 presentation. -/
module
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555TypeAParabolicOrder
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationCoxeterRewrites
public import
  FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationE7ParabolicWords
@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The consecutive source vertices d1,c1,b1,a,b2 of the A5 parabolic. -/
def y322A5Chain : Fin 5 → Fin 8 := ![3, 2, 1, 0, 4]

/-- The actual subgroup generated by the five source vertices of the A5 chain. -/
def y322A5Parabolic : Subgroup Y322Presentation :=
  Subgroup.closure (Set.range (fun i : Fin 5 =>
    (PresentedGroup.of (y322A5Chain i) : Y322Presentation)))

/-- Every one of source vertices 0,1,2,3,4 occurs on the declared A5 chain. -/
theorem y322A5Chain_covers (v : Fin 8) (hv : v.val < 5) :
    ∃ i : Fin 5, y322A5Chain i = v := by
  fin_cases v <;> norm_num at hv
  all_goals first
    | exact ⟨0, rfl⟩
    | exact ⟨1, rfl⟩
    | exact ⟨2, rfl⟩
    | exact ⟨3, rfl⟩
    | exact ⟨4, rfl⟩

/-- Each of source generators 0 through 4 belongs to the actual A5 parabolic. -/
theorem y322A5Parabolic_generator_mem (v : Fin 8) (hv : v.val < 5) :
    (PresentedGroup.of v : Y322Presentation) ∈ y322A5Parabolic := by
  obtain ⟨i, rfl⟩ := y322A5Chain_covers v hv
  exact Subgroup.subset_closure ⟨i, rfl⟩

/-- Extend the five source simple generators to a natural-number sequence by ones. -/
def y322A5Generators (i : ℕ) : Y322Presentation :=
  if h : i < 5 then PresentedGroup.of (y322A5Chain ⟨i, h⟩) else 1

/-- The defining C322 Coxeter relations give exactly the local type A5 relations. -/
theorem y322A5Chain_relations : TypeAChainRelations y322A5Generators 5 where
  square i hi := by
    simp only [y322A5Generators, dite_eq_left hi]
    exact y322Positive_generator_square _
  commute i j hi hj hij := by
    simp only [y322A5Generators, dite_eq_left hi, dite_eq_left hj]
    apply y322Positive_generator_commute
    interval_cases i <;> interval_cases j <;> norm_num at hij ⊢ <;> decide +kernel
  braid i hi := by
    have hi' : i < 5 := by omega
    simp only [y322A5Generators, dite_eq_left hi, dite_eq_left hi']
    apply y322Positive_generator_braid
    rcases (show i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 by omega) with h | h | h | h
    all_goals subst i; decide +kernel +revert

/-- The extended generator sequence defines precisely the actual A5 subgroup. -/
theorem y322A5Parabolic_eq_chain :
    y322A5Parabolic = Subgroup.closure
      (Set.range (fun i : Fin 5 => y322A5Generators i.val)) := by
  unfold y322A5Parabolic
  congr 1
  apply congrArg Set.range
  funext i
  simp only [y322A5Generators, dite_eq_left i.isLt]

/-- The actual A5 source parabolic is finite, independently of any matrix representation. -/
theorem y322A5Parabolic_finite : Finite y322A5Parabolic := by
  rw [y322A5Parabolic_eq_chain]
  exact (typeAChain_finite_card y322A5Chain_relations).1

/-- The actual A5 source parabolic has order at most 6! = 720. -/
theorem y322A5Parabolic_card_le : Nat.card y322A5Parabolic ≤ 720 := by
  rw [y322A5Parabolic_eq_chain]
  exact (typeAChain_finite_card y322A5Chain_relations).2

/-- Every generator in the actual A5 chain belongs to the actual E7 parabolic. -/
theorem y322A5Parabolic_le_E7 : y322A5Parabolic ≤ y322E7Parabolic := by
  rw [y322A5Parabolic, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  apply y322E7Parabolic_generator_mem
  fin_cases i <;> decide +kernel

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
