/-- Interval offsets agree with the exact uniform indexing, including the final interval. -/
theorem y422CosetSourcesChunks_offset (b : Fin 71) :
    (y422CosetSourcesChunks b).offset = 128 * b.val := by
  revert b
  decide +kernel

/-- The final interval retains its actual size rather than padding extra entries. -/
theorem y422CosetSourcesChunks_size (b : Fin 71) :
    (y422CosetSourcesChunks b).size = if b.val < 70 then 128 else 119 := by
  revert b
  decide +kernel

/-- Every actual interval lies inside the exact global finite bound. -/
theorem y422CosetSourcesChunks_end (b : Fin 71) :
    (y422CosetSourcesChunks b).offset + (y422CosetSourcesChunks b).size ≤ 9079 := by
  rw [y422CosetSourcesChunks_offset, y422CosetSourcesChunks_size]
  split_ifs <;> omega

/-- The unique interval containing a given actual finite index. -/
def y422CosetSourcesBlock (i : Fin 9079) : Fin 71 := ⟨i.val / 128, by omega⟩

/-- The exact local index inside that interval, with the final shorter bound checked. -/
def y422CosetSourcesLocal (i : Fin 9079) :
    Fin (y422CosetSourcesChunks (y422CosetSourcesBlock i)).size :=
  ⟨i.val % 128, by
    rw [y422CosetSourcesChunks_size]
    unfold y422CosetSourcesBlock
    dsimp only
    split_ifs <;> omega⟩

/-- Assemble a local interval index into its exact original global index. -/
def y422CosetSourcesGlobal (b : Fin 71) (j : Fin (y422CosetSourcesChunks b).size) : Fin 9079 :=
  ⟨(y422CosetSourcesChunks b).offset + j.val,
    (Nat.add_lt_add_left j.isLt _).trans_le (y422CosetSourcesChunks_end b)⟩

/-- Interval lookup and assembly preserve the original index exactly. -/
theorem y422CosetSourcesGlobal_local (i : Fin 9079) :
    y422CosetSourcesGlobal (y422CosetSourcesBlock i) (y422CosetSourcesLocal i) = i := by
  apply Fin.ext
  change (y422CosetSourcesChunks (y422CosetSourcesBlock i)).offset + i.val % 128 = i.val
  rw [y422CosetSourcesChunks_offset]
  unfold y422CosetSourcesBlock
  dsimp only
  omega

/-- Lookup retains the actual literal entry, with no out-of-range fallback. -/
def y422CosetSourcesData (i : Fin 9079) :=
  (y422CosetSourcesChunks (y422CosetSourcesBlock i)).data (y422CosetSourcesLocal i)

/-- Every assembled equation is independently valid in original C422/S/Q. -/
theorem y422CosetSourcesData_valid (i : Fin 9079) :
    (y422CosetSourcesData i).Valid y422CosetSymbol :=
  (y422CosetSourcesChunks (y422CosetSourcesBlock i)).valid (y422CosetSourcesLocal i)

