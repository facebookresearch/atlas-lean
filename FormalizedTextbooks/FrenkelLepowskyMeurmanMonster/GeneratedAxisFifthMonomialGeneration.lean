module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisFifthMonomialSchreier
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisFifthFrameSystemSigns
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.GroupTheory.OrderOfElement

/-! The six original permutation words generate the full actual monomial system stabilizer. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The subgroup generated by the six original actual system-preserving permutation words. -/
def generatedFifthSixPermutationSubgroup : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range generatedFifthMonomialSpatialPermutation)

/-- Each original signed six-generator letter belongs to its genuine generated subgroup. -/
theorem generatedFifthSixLetter_mem (l : Fin 6 × Bool) :
    generatedFifthSixLetter l ∈ generatedFifthSixPermutationSubgroup := by
  have h : generatedFifthMonomialSpatialPermutation l.1 ∈ generatedFifthSixPermutationSubgroup :=
    Subgroup.subset_closure ⟨l.1, rfl⟩
  unfold generatedFifthSixLetter
  split
  · exact generatedFifthSixPermutationSubgroup.inv_mem h
  · exact h

/-- Every certified Schreier transition belongs to the subgroup of the original six words. -/
theorem generatedFifthSixSchreier_mem (k : Fin 5) (i : Fin 15) :
    (generatedFifthSystemRep (generatedFifthMonomialSystemTransition k i))⁻¹ *
        generatedFifthSelectedOctadPermutation k * generatedFifthSystemRep i ∈
      generatedFifthSixPermutationSubgroup := by
  rw [generatedFifthSixSchreier_word]
  apply Subgroup.list_prod_mem
  intro p hp
  obtain ⟨l, _, rfl⟩ := List.mem_map.mp hp
  exact generatedFifthSixLetter_mem l

/-- The complete original selected-octad group is generated by its five displayed words. -/
theorem generatedFifthSelectedOctad_closure :
    Subgroup.closure (Set.range generatedFifthSelectedOctadPermutation) =
      generatedFifthSelectedOctadSubgroup := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro p ⟨k, rfl⟩
    exact generatedFifthSelectedOctad_generator_mem k
  · apply generatedFifthSelectedOctad_le_of_generators
    intro k
    exact Subgroup.subset_closure ⟨k, rfl⟩

/-- The initial actual system representative is the identity permutation. -/
theorem generatedFifthSystemRep_zero : generatedFifthSystemRep 0 = 1 := by
  simp [generatedFifthSystemRep, generatedFifthMonomialSystemWord]

/-- Every actual selected-octad permutation has a representative times a six-word element. -/
theorem generatedFifthSix_decomposition (g : golayAutomorphismSubgroup)
    (hg : g ∈ generatedFifthSelectedOctadSubgroup) :
    ∃ i : Fin 15, ∃ p : golayAutomorphismSubgroup,
      p ∈ generatedFifthSixPermutationSubgroup ∧ g = generatedFifthSystemRep i * p := by
  have hm : g ∈ Submonoid.closure (Set.range generatedFifthSelectedOctadPermutation) := by
    rw [← Subgroup.closure_toSubmonoid_of_finite, generatedFifthSelectedOctad_closure]
    exact hg
  clear hg
  induction hm using Submonoid.closure_induction_left with
  | one =>
    refine ⟨0, 1, generatedFifthSixPermutationSubgroup.one_mem, ?_⟩
    rw [generatedFifthSystemRep_zero, one_mul]
  | mul_left x hx y hy ih =>
    obtain ⟨k, rfl⟩ := hx
    obtain ⟨i, p, hp, rfl⟩ := ih
    refine ⟨generatedFifthMonomialSystemTransition k i,
      ((generatedFifthSystemRep (generatedFifthMonomialSystemTransition k i))⁻¹ *
        generatedFifthSelectedOctadPermutation k * generatedFifthSystemRep i) * p,
      generatedFifthSixPermutationSubgroup.mul_mem (generatedFifthSixSchreier_mem k i) hp, ?_⟩
    simp [mul_assoc]

/-- Every original six-word permutation fixes the entire actual fifth system. -/
theorem generatedFifthSix_system_fixed (p : golayAutomorphismSubgroup)
    (hp : p ∈ generatedFifthSixPermutationSubgroup) :
    p • generatedFifthFrameSystem = generatedFifthFrameSystem := by
  have h : generatedFifthSixPermutationSubgroup ≤
      MulAction.stabilizer golayAutomorphismSubgroup generatedFifthFrameSystem := by
    apply (Subgroup.closure_le _).mpr
    rintro p ⟨k, rfl⟩
    change generatedFifthFrameSystem.map
      (leechModTwoAction
        (golayPermutationHom (generatedFifthMonomialSpatialPermutation k))).toLinearMap =
        generatedFifthFrameSystem
    simpa only [golayPermutationHom, MonoidHom.coe_mk, OneHom.coe_mk] using
      generatedFifthMonomial_system_preserved k
  exact h hp

/-- Every actual selected-octad permutation fixing the system belongs to the six-word subgroup. -/
theorem generatedFifthSix_contains_stabilizer (p : golayAutomorphismSubgroup)
    (hp : p ∈ generatedFifthSelectedOctadSubgroup)
    (hf : p • generatedFifthFrameSystem = generatedFifthFrameSystem) :
    p ∈ generatedFifthSixPermutationSubgroup := by
  obtain ⟨i, q, hq, he⟩ := generatedFifthSix_decomposition p hp
  have h : p • generatedFifthMonomialSystem 0 = generatedFifthMonomialSystem 0 := by
    simpa only [generatedFifthMonomialSystem_zero] using hf
  have hq0 : q • generatedFifthMonomialSystem 0 = generatedFifthMonomialSystem 0 := by
    simpa only [generatedFifthMonomialSystem_zero] using generatedFifthSix_system_fixed q hq
  rw [he, mul_smul, hq0, generatedFifthSystemRep,
    generatedFifthMonomialSystem_word_action] at h
  have hi : i = 0 := generatedFifthMonomialSystem_injective h
  subst i
  rw [generatedFifthSystemRep_zero, one_mul] at he
  rwa [he]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
