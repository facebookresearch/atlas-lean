module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1GeometryPolarLocalMonomial
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationCo1GeometryFiveGeneration

/-! The four genuine base-fixing operators generate the full actual monomial group.

The Golay-sign generation argument adapts the actual five-generator proof in
`MonsterPresentationCo1GeometryFiveGeneration`, retaining only its four base-fixing operators. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false

/-- The actual subgroup generated by the four base-fixing original lattice operators. -/
def monsterCo1PolarLocalFourIsometrySubgroup : Subgroup leechIsomSubgroup :=
  Subgroup.closure (Set.range fun k : Fin 4 => omegaOrbitIsometry k.succ)

/-- Both original physical Golay permutations belong to the actual four-generator subgroup. -/
theorem monsterCo1PolarLocalFour_permutation_generator_mem (k : Fin 2) :
    golayPermutationIsometry (omegaOrbitGolayPermutation k) ∈
      monsterCo1PolarLocalFourIsometrySubgroup := by
  fin_cases k
  · exact Subgroup.subset_closure ⟨2, rfl⟩
  · exact Subgroup.subset_closure ⟨3, rfl⟩

/-- The independently checked M24 generation theorem supplies all actual permutation isometries. -/
theorem monsterCo1PolarLocalFour_permutation_mem (p : golayAutomorphismSubgroup) :
    golayPermutationIsometry p ∈ monsterCo1PolarLocalFourIsometrySubgroup := by
  have h : golayTwoGeneratorSubgroup ≤
      monsterCo1PolarLocalFourIsometrySubgroup.comap golayPermutationHom := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    exact monsterCo1PolarLocalFour_permutation_generator_mem k
  rw [golayTwoGeneratorSubgroup_eq_top] at h
  exact h (Subgroup.mem_top p)

/-- The two actual starting sign codewords belong to the genuine four-generator subgroup. -/
theorem monsterCo1PolarLocalFour_seed_mem (j : Fin 12) :
    golaySignIsometry (monsterCo1GeometrySignCode (monsterCo1FiveCodeSeed j)) ∈
      monsterCo1PolarLocalFourIsometrySubgroup := by
  have hs : ∀ i : Fin 12, monsterCo1FiveCodeSeed i = 4 ∨ monsterCo1FiveCodeSeed i = 5 := by
    decide +kernel
  rcases hs j with h | h
  · rw [h]
    exact Subgroup.subset_closure ⟨0, rfl⟩
  · rw [h]
    exact Subgroup.subset_closure ⟨1, rfl⟩

/-- Literal permutation conjugation transports actual sign lifts inside the genuine subgroup. -/
theorem monsterCo1PolarLocalFour_sign_permute_mem (c : golayCode)
    (hc : golaySignIsometry c ∈ monsterCo1PolarLocalFourIsometrySubgroup) (k : Fin 2) :
    golaySignIsometry (golayCodePermutation (omegaOrbitGolayPermutation k) c) ∈
      monsterCo1PolarLocalFourIsometrySubgroup := by
  have he : golaySignIsometry (golayCodePermutation (omegaOrbitGolayPermutation k) c) =
      (golayPermutationIsometry (omegaOrbitGolayPermutation k) * golaySignIsometry c) *
        (golayPermutationIsometry (omegaOrbitGolayPermutation k))⁻¹ := by
    rw [golayPermutation_sign_commute]
    simp only [mul_assoc, mul_inv_cancel, mul_one]
  rw [he]
  exact monsterCo1PolarLocalFourIsometrySubgroup.mul_mem
    (monsterCo1PolarLocalFourIsometrySubgroup.mul_mem
      (monsterCo1PolarLocalFour_permutation_generator_mem k) hc)
    (monsterCo1PolarLocalFourIsometrySubgroup.inv_mem
      (monsterCo1PolarLocalFour_permutation_generator_mem k))

/-- Every literal permutation-transported starting sign has a genuine subgroup word. -/
theorem monsterCo1PolarLocalFour_sign_word_mem (w : List (Fin 2)) (c : golayCode)
    (hc : golaySignIsometry c ∈ monsterCo1PolarLocalFourIsometrySubgroup) :
    golaySignIsometry (w.foldl
      (fun d k => golayCodePermutation (omegaOrbitGolayPermutation k) d) c) ∈
      monsterCo1PolarLocalFourIsometrySubgroup := by
  induction w generalizing c with
  | nil => exact hc
  | cons k w ih => exact ih _ (monsterCo1PolarLocalFour_sign_permute_mem c hc k)

/-- All twelve actual spanning orbit sign codewords have genuine four-generator lifts. -/
theorem monsterCo1PolarLocalFour_orbit_sign_mem (j : Fin 12) :
    golaySignIsometry (monsterCo1FiveOrbitCode j) ∈ monsterCo1PolarLocalFourIsometrySubgroup :=
  monsterCo1PolarLocalFour_sign_word_mem _ _ (monsterCo1PolarLocalFour_seed_mem j)

/-- Actual sign-code membership in the four-generator subgroup is a binary linear condition. -/
def monsterCo1PolarLocalFourSignPreimage : Submodule (ZMod 2) golayCode where
  carrier := {c | golaySignIsometry c ∈ monsterCo1PolarLocalFourIsometrySubgroup}
  zero_mem' := by
    change golaySignHom 1 ∈ monsterCo1PolarLocalFourIsometrySubgroup
    rw [map_one]
    exact monsterCo1PolarLocalFourIsometrySubgroup.one_mem
  add_mem' := by
    intro a b ha hb
    change golaySignHom (Multiplicative.ofAdd a * Multiplicative.ofAdd b) ∈
      monsterCo1PolarLocalFourIsometrySubgroup
    rw [map_mul]
    exact monsterCo1PolarLocalFourIsometrySubgroup.mul_mem ha hb
  smul_mem' a c hc := by
    have hs : ∀ t : ZMod 2, t = 0 ∨ t = 1 := by decide +kernel
    rcases hs a with rfl | rfl
    · rw [zero_smul]
      change golaySignHom 1 ∈ monsterCo1PolarLocalFourIsometrySubgroup
      rw [map_one]
      exact monsterCo1PolarLocalFourIsometrySubgroup.one_mem
    · simpa only [one_smul] using hc

/-- Each original encoder-basis sign is supplied by the exact actual orbit-code sum certificate. -/
theorem monsterCo1PolarLocalFour_basis_sign_mem (k : Fin 12) :
    golaySignIsometry (monsterCo1GeometrySignCode k) ∈
      monsterCo1PolarLocalFourIsometrySubgroup := by
  change monsterCo1GeometrySignCode k ∈ monsterCo1PolarLocalFourSignPreimage
  rw [← monsterCo1FiveCodeExpansion_certificate k]
  apply Submodule.sum_mem
  intro j _
  exact monsterCo1PolarLocalFour_orbit_sign_mem j

/-- Every actual Golay codeword sign is generated by the same four base-fixing actual isometries. -/
theorem monsterCo1PolarLocalFour_sign_mem (c : golayCode) :
    golaySignIsometry c ∈ monsterCo1PolarLocalFourIsometrySubgroup := by
  obtain ⟨a, ha⟩ := c.property
  have he : c = ∑ j, a j • monsterCo1GeometrySignCode j := by
    apply Subtype.ext
    simp only [Submodule.coe_sum, Submodule.coe_smul, monsterCo1GeometrySignCode]
    have hx : a = ∑ j, a j • (Pi.single j 1 : Fin 12 → ZMod 2) := by
      ext i
      simp [Pi.single_apply]
    simp only [← map_smul]
    rw [← map_sum, ← hx]
    exact ha.symm
  change c ∈ monsterCo1PolarLocalFourSignPreimage
  rw [he]
  apply Submodule.sum_mem
  intro j _
  exact Submodule.smul_mem _ _ (monsterCo1PolarLocalFour_basis_sign_mem j)

/-- The four base-fixing source operators generate precisely all actual Golay monomials. -/
theorem monsterCo1PolarLocalFourIsometrySubgroup_eq_monomial :
    monsterCo1PolarLocalFourIsometrySubgroup = golayMonomialSubgroup := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    fin_cases k
    · exact ⟨monsterCo1GeometrySignCode 4, 1, by
        rw [show golayPermutationIsometry 1 = 1 from golayPermutationHom.map_one, mul_one]
        rfl⟩
    · exact ⟨monsterCo1GeometrySignCode 5, 1, by
        rw [show golayPermutationIsometry 1 = 1 from golayPermutationHom.map_one, mul_one]
        rfl⟩
    · exact ⟨0, omegaOrbitGolayPermutation 0, by
        rw [show golaySignIsometry 0 = 1 from golaySignHom.map_one, one_mul]
        rfl⟩
    · exact ⟨0, omegaOrbitGolayPermutation 1, by
        rw [show golaySignIsometry 0 = 1 from golaySignHom.map_one, one_mul]
        rfl⟩
  · rintro e ⟨c, p, rfl⟩
    exact monsterCo1PolarLocalFourIsometrySubgroup.mul_mem
      (monsterCo1PolarLocalFour_sign_mem c) (monsterCo1PolarLocalFour_permutation_mem p)

/-- The original four base-fixing generators, regarded in the genuine Conway quotient. -/
def monsterCo1PolarLocalFourSubgroup : Subgroup Co1 :=
  Subgroup.closure (Set.range fun k : Fin 4 => monsterCo1FiveGenerator k.succ)

/-- Their generated Conway image is exactly the genuine full base-point monomial stabilizer. -/
theorem monsterCo1PolarLocalFourSubgroup_eq_monomial :
    monsterCo1PolarLocalFourSubgroup = monsterCo1GeometryMonomialClasses := by
  have he : monsterCo1PolarLocalFourIsometrySubgroup.map (QuotientGroup.mk' signsSubgroup) =
      monsterCo1PolarLocalFourSubgroup := by
    rw [monsterCo1PolarLocalFourIsometrySubgroup, MonoidHom.map_closure, ← Set.range_comp]
    rfl
  rw [← he, monsterCo1PolarLocalFourIsometrySubgroup_eq_monomial]
  ext g
  constructor
  · rintro ⟨e, he, rfl⟩
    exact ⟨⟨e, he⟩, rfl⟩
  · rintro ⟨e, rfl⟩
    exact ⟨e.val, e.property, rfl⟩

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
