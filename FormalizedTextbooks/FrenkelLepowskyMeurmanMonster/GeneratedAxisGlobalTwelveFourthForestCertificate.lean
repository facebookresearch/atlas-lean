/-- Every finite binary mask has a checked root or genuine descending inverse edge. -/
theorem generatedAxisGlobalTwelveFourthForest_complete (b : Fin (2 ^ 24)) :
    ∃ e : ℕ, generatedAxisGlobalTwelveFourthForestStep e b.val := by
  let s : Fin 128 := ⟨b.val / 131072, by have hb := b.isLt; norm_num at hb; omega⟩
  let j : Fin 32 := ⟨(b.val % 131072) / 4096, by
    have hb := Nat.mod_lt b.val (by decide : 0 < 131072); omega⟩
  let i : Fin 4096 := ⟨b.val % 4096, Nat.mod_lt _ (by decide)⟩
  have hb : b.val = 131072 * s.val + 4096 * j.val + i.val := by
    dsimp [s, j, i]
    omega
  rw [hb]
  exact fourthForest_shard_complete s j i

/-- The entire actual Ω orbit is covered by the sixteen genuine Fourth-stabilizer roots. -/
theorem generatedAxisGlobalTwelveFourthBinary_cover :
    ∀ x : generatedAxisGlobalBinaryOrbit, ∃ i : Fin 16, ∃ c : H,
      c ∈ generatedFourthLocalAxisStabilizer ∧
        generatedAxisGlobalBinaryAct c (generatedAxisGlobalTwelveFourthRoot i) = x :=
  generatedAxisGlobalTwelveFourthBinary_cover_of_forest
    generatedAxisGlobalTwelveFourthForest_complete

