/-- Every selected inverse packet is the exact inverse of its complete original source array. -/
theorem generatedTwelfth_section_permutation_inverse : ∀ (k : Fin 5) (i : Fin 24),
    generatedFifthSelectedOctadForward k (generatedTwelfthSectionPermutationBackward k i) = i := by
  decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 20000000 in
-- Check every entry of the five complete actual integral basis change equations.
/-- Complete original permutation pullbacks satisfy the exact genuine lattice change of basis. -/
theorem generatedTwelfth_section_permutation_integral_certificate : ∀ k : Fin 5,
    (fun i j => leechBasisMatrix (generatedTwelfthSectionPermutationBackward k i) j) =
      leechBasisMatrix * generatedTwelfthSectionPermutationIntegral k := by
  decide +kernel

