module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthMonomialSignSpan
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisFourthFlagMonomialSigns
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1OrderMonomial

/-! Actual equal-pair Golay signs are generated by the cube sign and four physical word lifts. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open Multiplicative
set_option backward.isDefEq.respectTransparency false

/-- Codewords whose genuine Leech sign isometry lies in a specified subgroup. -/
def generatedFourthMonomialSignPreimage (K : Subgroup leechIsomSubgroup) :
    Submodule (ZMod 2) golayCode where
  carrier := {c | golaySignIsometry c ∈ K}
  zero_mem' := by change golaySignHom 1 ∈ K; rw [map_one]; exact K.one_mem
  add_mem' := by
    intro a b ha hb
    change golaySignHom (ofAdd a * ofAdd b) ∈ K
    rw [map_mul]
    exact K.mul_mem ha hb
  smul_mem' a c hc := by
    have h : a = 0 ∨ a = 1 := by fin_cases a <;> simp
    rcases h with rfl | rfl
    · rw [zero_smul]
      change golaySignHom 1 ∈ K
      rw [map_one]
      exact K.one_mem
    · simpa only [one_smul] using hc

/-- The physical subgroup generated by four actual flag words and the actual cube sign. -/
def generatedFourthMonomialPhysicalSubgroup : Subgroup leechIsomSubgroup :=
  Subgroup.closure (Set.range (fun k : Fin 4 => (generatedFourthMonomialFiber k).val.2) ∪
    {golaySignIsometry generatedFourthFlagCubeSignCode})

/-- Each actual physical permutation word lies in the stated genuine subgroup. -/
theorem generatedFourth_monomial_physical_mem (k : Fin 4) :
    (generatedFourthMonomialFiber k).val.2 ∈ generatedFourthMonomialPhysicalSubgroup :=
  Subgroup.subset_closure (Or.inl ⟨k, rfl⟩)

/-- The actual sixteen-coordinate Golay sign belongs to the stated genuine subgroup. -/
theorem generatedFourth_monomial_cube_sign_mem :
    golaySignIsometry generatedFourthFlagCubeSignCode ∈ generatedFourthMonomialPhysicalSubgroup :=
  Subgroup.subset_closure (Or.inr rfl)

/-- Each literal codeword-conjugating word is an actual element of the physical subgroup. -/
theorem generatedFourth_monomial_sign_witness_permutation_mem (j : Fin 11) :
    golayPermutationIsometry (generatedFourthMonomialSignWitnessPermutation j) ∈
      generatedFourthMonomialPhysicalSubgroup := by
  change golayPermutationHom (generatedFourthMonomialSignWitnessPermutation j) ∈ _
  rw [generatedFourthMonomialSignWitnessPermutation, map_list_prod]
  simp only [List.map_map]
  apply Subgroup.list_prod_mem
  intro e he
  obtain ⟨k, _, rfl⟩ := List.mem_map.mp he
  change golayPermutationIsometry (generatedFourthMonomialPermutation k) ∈ _
  rw [← generatedFourth_monomial_spatial]
  exact generatedFourth_monomial_physical_mem k

/-- All eleven spanning codewords have genuine sign lifts in the physical subgroup. -/
theorem generatedFourth_monomial_sign_witness_mem (j : Fin 11) :
    golaySignIsometry (generatedFourthMonomialSignCode j) ∈
      generatedFourthMonomialPhysicalSubgroup := by
  have hcode : golayCodePermutation (generatedFourthMonomialSignWitnessPermutation j)
      generatedFourthFlagCubeSignCode = generatedFourthMonomialSignCode j :=
    Subtype.ext (generatedFourth_monomial_sign_witness j)
  have h := golayPermutation_sign_commute (generatedFourthMonomialSignWitnessPermutation j)
    generatedFourthFlagCubeSignCode
  rw [hcode] at h
  have he : golaySignIsometry (generatedFourthMonomialSignCode j) =
      (golayPermutationIsometry (generatedFourthMonomialSignWitnessPermutation j) *
        golaySignIsometry generatedFourthFlagCubeSignCode) *
          (golayPermutationIsometry (generatedFourthMonomialSignWitnessPermutation j))⁻¹ := by
    rw [h]
    simp only [mul_assoc, mul_inv_cancel, mul_one]
  rw [he]
  exact generatedFourthMonomialPhysicalSubgroup.mul_mem
    (generatedFourthMonomialPhysicalSubgroup.mul_mem
      (generatedFourth_monomial_sign_witness_permutation_mem j)
      generatedFourth_monomial_cube_sign_mem)
    (generatedFourthMonomialPhysicalSubgroup.inv_mem
      (generatedFourth_monomial_sign_witness_permutation_mem j))

/-- Every genuine equal-pair codeword sign is generated by the actual cube and four word lifts. -/
theorem generatedFourth_monomial_equal_sign_mem (c : golayCode) (hc : c.val 8 = c.val 11) :
    golaySignIsometry c ∈ generatedFourthMonomialPhysicalSubgroup := by
  obtain ⟨a, ha⟩ := generatedFourth_monomial_equal_sign_span c hc
  have he : c = ∑ j, a j • generatedFourthMonomialSignCode j := by
    apply Subtype.ext
    simpa only [Submodule.coe_sum, Submodule.coe_smul] using ha
  change c ∈ generatedFourthMonomialSignPreimage generatedFourthMonomialPhysicalSubgroup
  rw [he]
  apply Submodule.sum_mem
  intro j _
  apply Submodule.smul_mem
  exact generatedFourth_monomial_sign_witness_mem j

/-- The full actual equal-sign subgroup lies in the genuine generated physical subgroup. -/
theorem generatedFourth_monomial_equal_sign_subgroup_le :
    generatedFourthFlagEqualSignSubgroup ≤ generatedFourthMonomialPhysicalSubgroup := by
  rintro e ⟨c, hc, rfl⟩
  apply generatedFourth_monomial_equal_sign_mem c.toAdd
  have h := congrArg toAdd hc
  change c.toAdd.val 8 + c.toAdd.val 11 = 0 at h
  have he := congrArg (fun a : ZMod 2 => a + c.toAdd.val 11) h
  simpa only [add_assoc, CharTwo.add_self_eq_zero, add_zero, zero_add] using he

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
