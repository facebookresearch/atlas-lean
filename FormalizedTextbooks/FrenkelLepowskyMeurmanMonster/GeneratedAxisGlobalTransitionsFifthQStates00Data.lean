/-- Concrete candidate coordinate lifts at the individual actual source-factor boundaries. -/
def generatedAxisGlobalFifthQState00 (n : Fin 23) (i : Fin 24) : Q :=
  ⟨ofAdd (fun j => golayBooleanCast ((generatedAxisGlobalFifthQState00Binary n i).testBit j.val)),
    ofAdd (generatedAxisGlobalFifthQState00Phase n i)⟩

/-- The actual literal first-root word has precisely twenty-two chronological source factors. -/
theorem generatedAxisGlobalFifthQFactor00_length :
    (generatedAxisGlobalFifthChainQFactors 0 (generatedAxisGlobalFifthActiveStages 0)).length =
      22 := by decide +kernel

/-- An individual factor read directly from the genuine original first-root source list. -/
def generatedAxisGlobalFifthQFactor00 (n : Fin 22) : GeneratedAxisGlobalQFactor :=
  (generatedAxisGlobalFifthChainQFactors 0 (generatedAxisGlobalFifthActiveStages 0))[n.val]'(by
    rw [generatedAxisGlobalFifthQFactor00_length]
    exact n.isLt)

