/-- Every original packet position has its complete actual signed return certificate. -/
theorem generatedSeventhXiShortPacketReturn_all (k : Fin 27624) :
    generatedSeventhXiShortPacketReturn k := by
  let b : Fin 54 := ⟨k.val / 512, by omega⟩
  let r : Fin 512 := ⟨k.val % 512, Nat.mod_lt _ (by decide)⟩
  have h : 512 * b.val + r.val < 27624 := by dsimp only [b, r]; omega
  have hk : (⟨512 * b.val + r.val, h⟩ : Fin 27624) = k := by
    apply Fin.ext
    dsimp only [b, r]
    omega
  exact hk ▸ block_return b r h

