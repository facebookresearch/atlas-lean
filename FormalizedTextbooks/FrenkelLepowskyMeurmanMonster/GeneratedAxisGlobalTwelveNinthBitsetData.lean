/-! Data of the bitset certificate for the Ninth binary forest.

The 14 roots are one point of each orbit, on the singular binary masks, of the group generated
by the six Ninth letters (the three proved whole-axis candidate projections and their
inverses): 8 type-four orbits, Ω first, and 6 short classes and
zero. The 26 doubling steps are words in the letters together with row operations computing
the binary matrix of each word. All data are discovery outputs; the kernel checks every use. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Row-operation validity is decidable. -/
instance ninthForestRowValidDecidable (o : ℕ × ℕ) : Decidable (TenthForestRowValid o) :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- The 8 type-four roots, one per orbit, Ω first. -/
def ninthForestTypeFourRoots : List ℕ := [
    2048, 1, 4, 177, 272, 50, 250, 77024]

/-- The roots of the 6 remaining singular orbits (short classes and zero). -/
def ninthForestOtherRoots : List ℕ := [
    0, 3, 16, 64, 186, 157547]

/-- All 14 roots. -/
def ninthForestRoots : List ℕ :=
  ninthForestTypeFourRoots ++
    ninthForestOtherRoots

/-- The start set of the doubling: the roots. -/
def ninthForestStart : ℕ :=
  tenthForestOfList ninthForestRoots

