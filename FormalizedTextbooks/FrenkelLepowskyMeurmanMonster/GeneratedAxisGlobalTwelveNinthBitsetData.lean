set_option maxRecDepth 100000 in
-- Finite check of the bounds of every row operation.
/-- Every row operation of every stage is a valid coordinate flip. -/
theorem ninthForestStageOps_valid (s : ℕ) :
    ∀ ops ∈ ninthForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
  have h : ∀ s < 5, ∀ ops ∈ ninthForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
    decide +kernel
  by_cases hs : s < 5
  · exact h s hs
  · have : ninthForestStageOps s = [] := by
      match s, hs with
      | n + 5, _ => rfl
    simp [this]

/-- The start set consists exactly of the roots. -/
theorem ninthForestStart_testBit (b : ℕ) :
    ninthForestStart.testBit b = decide (b ∈ ninthForestRoots) :=
  tenthForestOfList_testBit _ b

set_option maxRecDepth 100000 in
-- The roots are bounded masks.
/-- Every root is a 24-bit mask. -/
theorem ninthForestRoots_lt : ∀ m ∈ ninthForestRoots, m < 16777216 := by decide +kernel

/-- The start set has only positions below `2 ^ 24`. -/
theorem ninthForestStart_bounded : TenthForestBounded ninthForestStart := by
  intro b hb
  rw [ninthForestStart_testBit]
  simp only [decide_eq_false_iff_not]
  intro hm
  have := ninthForestRoots_lt b hm
  omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
