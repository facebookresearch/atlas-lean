/-- Compact integer coefficients of the normalized state, in original source spin labels. -/
def generatedSeventhXiPlaneSpinInteger (d : Fin 4096) : ℤ :=
  let b : Fin 64 := ⟨d.val / 64, by omega⟩
  if (generatedSeventhXiPlaneSpinSupportRows b).testBit (d.val % 64) then
    if (generatedSeventhXiPlaneSpinNegativeRows b).testBit (d.val % 64) then -1 else 1
  else 0

