/- Finite normal forms for arbitrary type A chains, without faithfulness assumptions. -/
module
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555TypeAParabolicOrderInsertion
public import Mathlib.SetTheory.Cardinal.Finite
@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Recursive insertion choices for a chain with n simple generators. -/
def TypeANormalIndex : ℕ → Type
  | 0 => PUnit
  | n + 1 => TypeANormalIndex n × Fin (n + 2)

instance typeANormalIndexFintype (n : ℕ) : Fintype (TypeANormalIndex n) := by
  induction n with
  | zero => exact inferInstanceAs (Fintype PUnit)
  | succ n ih =>
    letI := ih
    exact inferInstanceAs (Fintype (TypeANormalIndex n × Fin (n + 2)))

/-- Evaluate a finite sequence of insertion choices as a word in the given group. -/
def typeANormalValue {G : Type*} [Group G] (s : ℕ → G) :
    (n : ℕ) → TypeANormalIndex n → G
  | 0, _ => 1
  | n + 1, a => typeANormalValue s n a.1 *
      typeAInsertion s a.2.val (n + 1 - a.2.val)

variable {G : Type*} [Group G] {s : ℕ → G} {n : ℕ}

/-- One has an insertion normal form in every rank. -/
theorem typeANormalValue_one (s : ℕ → G) (n : ℕ) :
    ∃ a : TypeANormalIndex n, typeANormalValue s n a = 1 := by
  induction n with
  | zero => exact ⟨PUnit.unit, rfl⟩
  | succ n ih =>
    obtain ⟨a, ha⟩ := ih
    refine ⟨(a, ⟨n + 1, by omega⟩), ?_⟩
    simp [typeANormalValue, typeAInsertion, ha]

/-- Right multiplication by a simple generator preserves the finite normal-form family. -/
theorem typeANormalValue_mul_generator (h : TypeAChainRelations s n)
    (a : TypeANormalIndex n) (j : ℕ) (hj : j < n) :
    ∃ b : TypeANormalIndex n, typeANormalValue s n a * s j =
      typeANormalValue s n b := by
  induction n generalizing j with
  | zero => omega
  | succ n ih =>
    obtain ⟨l, hl, c, hc, he⟩ := typeAInsertion_move h a.2.val j (by omega) hj
    rcases hc with rfl | ⟨i, hi, rfl⟩
    · refine ⟨(a.1, ⟨l, by omega⟩), ?_⟩
      change (typeANormalValue s n a.1 * _) * _ = typeANormalValue s n a.1 * _
      rw [mul_assoc, he, one_mul]
    · obtain ⟨b, hb⟩ := ih (h.restrict (by omega)) a.1 i hi
      refine ⟨(b, ⟨l, by omega⟩), ?_⟩
      change (typeANormalValue s n a.1 * _) * _ = typeANormalValue s n b * _
      rw [mul_assoc, he, ← mul_assoc, hb]

/-- Every element of the subgroup generated by a type A chain has a finite insertion normal form. -/
theorem typeANormalValue_covers (h : TypeAChainRelations s n)
    {g : G} (hg : g ∈ Subgroup.closure (Set.range (fun i : Fin n => s i.val))) :
    ∃ a : TypeANormalIndex n, typeANormalValue s n a = g := by
  induction hg using Subgroup.closure_induction_right with
  | one => exact typeANormalValue_one s n
  | mul_right x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hy
    obtain ⟨a, rfl⟩ := ih
    obtain ⟨b, hb⟩ := typeANormalValue_mul_generator h a i.val i.isLt
    exact ⟨b, hb.symm⟩
  | mul_inv_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hy
    have hi : (s i.val)⁻¹ = s i.val :=
      inv_eq_of_mul_eq_one_right (h.square i.val i.isLt)
    rw [hi]
    obtain ⟨a, rfl⟩ := ih
    obtain ⟨b, hb⟩ := typeANormalValue_mul_generator h a i.val i.isLt
    exact ⟨b, hb.symm⟩

/-- The recursive normal-form family has exactly (n+1)! entries. -/
theorem typeANormalIndex_card (n : ℕ) : Nat.card (TypeANormalIndex n) = Nat.factorial (n + 1) := by
  induction n with
  | zero => simp [TypeANormalIndex, Nat.card_eq_fintype_card]
  | succ n ih =>
    change Nat.card (TypeANormalIndex n × Fin (n + 2)) = Nat.factorial (n + 1 + 1)
    rw [Nat.card_prod, ih, Nat.card_fin]
    simpa only [Nat.factorial_succ] using Nat.mul_comm (Nat.factorial (n + 1)) (n + 2)

/-- A type A chain generates a finite subgroup of order at most (n+1)!, even when
its generators satisfy additional relations in the ambient group. -/
theorem typeAChain_finite_card (h : TypeAChainRelations s n) :
    Finite (Subgroup.closure (Set.range (fun i : Fin n => s i.val))) ∧
      Nat.card (Subgroup.closure (Set.range (fun i : Fin n => s i.val))) ≤
        Nat.factorial (n + 1) := by
  classical
  let K := Subgroup.closure (Set.range (fun i : Fin n => s i.val))
  let f : K → TypeANormalIndex n := fun g => Classical.choose (typeANormalValue_covers h g.2)
  have hf : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    have ha := Classical.choose_spec (typeANormalValue_covers h a.2)
    have hb := Classical.choose_spec (typeANormalValue_covers h b.2)
    exact ha.symm.trans ((congrArg (typeANormalValue s n) hab).trans hb)
  have : Finite K := Finite.of_injective f hf
  refine ⟨inferInstance, ?_⟩
  exact (Nat.card_le_card_of_injective f hf).trans_eq (typeANormalIndex_card n)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
