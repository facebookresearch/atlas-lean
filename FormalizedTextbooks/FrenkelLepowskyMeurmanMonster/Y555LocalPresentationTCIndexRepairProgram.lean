/-- The corrected checker uses the original instruction or the exact selected replacement chain. -/
def y322TCIndexCorrectedCheck (i : Fin 174819) : Prop :=
  match y322TCIndexRepairLookup i with
  | none => y322TCIndexCheckAt i.val
  | some r => y322TCIndexRepairChecked (y322TCIndexRepairIndex r) (y322TCIndexRepairRaw r)
      (y322TCIndexRepairRaw_allowed r)

/-- Exact finite replay of the selected corrected instruction is decidable. -/
instance y322TCIndexCorrectedCheckDecidable (i : Fin 174819) :
    Decidable (y322TCIndexCorrectedCheck i) := by
  unfold y322TCIndexCorrectedCheck
  split <;> infer_instance

/-- Each checked corrected instruction follows from sources and earlier valid equations. -/
theorem y322TCIndexCorrectedCheck_valid (i : Fin 174819) (hc : y322TCIndexCorrectedCheck i)
    (hp : ∀ j : Fin 174819, j.val < i.val →
      (y322TCIndexProgram j).1.Valid (y322FiniteAuxiliaryValue y322TransportProgram)) :
    (y322TCIndexProgram i).1.Valid (y322FiniteAuxiliaryValue y322TransportProgram) := by
  cases hl : y322TCIndexRepairLookup i with
  | none =>
    have ho : y322TCIndexCheckAt i.val := by
      simpa only [y322TCIndexCorrectedCheck, hl] using hc
    exact y322TCIndexOriginalChecked_valid i ho hp
  | some r =>
    have hi := y322TCIndexRepairLookup_some i r hl
    have hr : y322TCIndexRepairChecked (y322TCIndexRepairIndex r) (y322TCIndexRepairRaw r)
        (y322TCIndexRepairRaw_allowed r) := by
      simpa only [y322TCIndexCorrectedCheck, hl] using hc
    have hp' : ∀ j : Fin 174819, j.val < (y322TCIndexRepairIndex r).val →
        (y322TCIndexProgram j).1.Valid (y322FiniteAuxiliaryValue y322TransportProgram) := by
      simpa only [hi] using hp
    have hv := y322TCIndexRepair_valid _ _ (y322TCIndexRepairRaw_allowed r) hr hp'
    rw [hi] at hv
    exact hv

/-- The selected corrected instruction passes when every retained original instruction passes. -/
theorem y322TCIndexCorrectedCheck_of_unreplaced (i : Fin 174819)
    (h : y322TCIndexUnreplacedCheckAt i.val) : y322TCIndexCorrectedCheck i := by
  have hu : y322TCIndexRepairLookup i = none → y322TCIndexCheckAt i.val := by
    simpa only [y322TCIndexUnreplacedCheckAt, dite_eq_left i.isLt] using h
  cases hl : y322TCIndexRepairLookup i with
  | none => simpa only [y322TCIndexCorrectedCheck, hl] using hu hl
  | some r =>
    simpa only [y322TCIndexCorrectedCheck, hl] using y322TCIndexRepairRaw_checked r

/-- Global exact corrected replay proves all unchanged equations in the actual original group. -/
theorem y322TCIndexCorrectedProgram_valid
    (h : ∀ i, y322TCIndexCorrectedCheck i) (i : Fin 174819) :
    (y322TCIndexProgram i).1.Valid (y322FiniteAuxiliaryValue y322TransportProgram) := by
  induction i using (measure (fun i : Fin 174819 => i.val)).wf.induction with
  | h i ih =>
    exact y322TCIndexCorrectedCheck_valid i (h i) (fun j hj => ih j hj)

