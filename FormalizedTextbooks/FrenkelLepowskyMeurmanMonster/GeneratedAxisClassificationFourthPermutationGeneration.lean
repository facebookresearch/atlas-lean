module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationFourthPermutationGenerationOrder

/-! The four frozen actual monomial permutations generate the full genuine flag stabilizer. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

private theorem generatedFourth_permutation_prefix_generated : ∀ n : ℕ, n ≤ 7 →
    ∀ p : golayAutomorphismSubgroup,
      p ∈ generatedFourthPermutationPointStabilizer (7 - n) →
        p ∈ generatedFourthPermutationFourSubgroup := by
  intro n
  induction n with
  | zero =>
    intro _ p hp
    have h : p = 1 := golayAutomorphism_eq_one_of_fix_base p (fun j => hp.2 j j.isLt)
    rw [h]
    exact generatedFourthPermutationFourSubgroup.one_mem
  | succ n ih =>
    intro hn p hp
    let k : Fin 7 := ⟨7 - (n + 1), by omega⟩
    let pfix : generatedFourthPermutationPointStabilizer k.val := ⟨p, hp⟩
    have hi := generatedFourth_permutation_image_eligible k pfix
    obtain ⟨r, hr, hri⟩ := generatedFourth_permutation_rep_covers k _ hi
    let q := generatedFourthPermutationRep r
    have hq : q ∈ generatedFourthPermutationFourSubgroup :=
      generatedFourth_permutation_rep_mem r
    have hnext : q⁻¹ * p ∈ generatedFourthPermutationPointStabilizer (7 - n) := by
      refine ⟨generatedFourthPermutationFlagStabilizer.mul_mem
        (generatedFourthPermutationFlagStabilizer.inv_mem
          (generatedFourth_permutation_four_le hq)) hp.1, ?_⟩
      intro j hj
      have hstep : 7 - n = k.val + 1 := by dsimp [k]; omega
      rw [hstep] at hj
      change q.val.symm (p.val (golayBasePoints j)) = golayBasePoints j
      by_cases hjk : j.val < k.val
      · have hpj := hp.2 j hjk
        have hqj : q.val (golayBasePoints j) = golayBasePoints j :=
          generatedFourth_permutation_rep_prefix r j (by simpa only [hr] using hjk)
        rw [hpj]
        have hh := congrArg q.val.symm hqj
        rw [q.val.symm_apply_apply] at hh
        exact hh.symm
      · have hjeq : j = k := Fin.ext (by omega)
        subst j
        have hqk : q.val (golayBasePoints k) = p.val (golayBasePoints k) := hri
        rw [← hqk, q.val.symm_apply_apply]
    have hrem := ih (by omega) (q⁻¹ * p) hnext
    have hall := generatedFourthPermutationFourSubgroup.mul_mem hq hrem
    simpa only [mul_inv_cancel_left] using hall

/-- The original four actual permutation words generate the genuine code14 and pair stabilizer. -/
theorem generatedFourth_permutation_four_eq_flag :
    generatedFourthPermutationFourSubgroup = generatedFourthPermutationFlagStabilizer := by
  apply le_antisymm generatedFourth_permutation_four_le
  intro p hp
  apply generatedFourth_permutation_prefix_generated 7 (by omega) p
  rw [generatedFourth_permutation_stabilizer_zero]
  exact hp

/-- The subgroup generated by the original four actual words has exact order 11520. -/
theorem generatedFourth_permutation_four_card :
    Nat.card generatedFourthPermutationFourSubgroup = 11520 := by
  rw [generatedFourth_permutation_four_eq_flag, generatedFourth_permutation_flag_card]

/-- Membership of the four actual generators suffices for inclusion of the full flag stabilizer. -/
theorem generatedFourth_permutation_flag_le_of_generators
    (P : Subgroup golayAutomorphismSubgroup)
    (hP : ∀ k : Fin 4, generatedFourthMonomialPermutation k ∈ P) :
    generatedFourthPermutationFlagStabilizer ≤ P := by
  rw [← generatedFourth_permutation_four_eq_flag]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨k, rfl⟩
  exact hP k

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
