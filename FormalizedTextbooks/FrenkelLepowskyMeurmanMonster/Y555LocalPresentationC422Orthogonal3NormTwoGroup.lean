/- Independent projective group generated by all norm-two reflections
of the explicit finite form. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationC422Orthogonal3ReflectionBinding

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- All actual norm-two vectors of the independently specified eight-dimensional finite form. -/
abbrev Y422Orthogonal3NormTwoVector :=
  {v : Fin 8 → ZMod 3 // y422Orthogonal3VectorNorm v = 2}

/-- The actual projective reflection belonging to an arbitrary independent norm-two vector. -/
def y422Orthogonal3NormTwoProjectiveReflection (v : Y422Orthogonal3NormTwoVector) :
    Matrix.ProjGenLinGroup (Fin 8) (ZMod 3) :=
  Matrix.ProjGenLinGroup.mk (y422Orthogonal3RootReflection v.val (by rw [v.property]; decide))

/-- The independent group generated by all norm-two reflections
of the explicitly specified form. -/
def y422Orthogonal3NormTwoProjectiveGroup :
    Subgroup (Matrix.ProjGenLinGroup (Fin 8) (ZMod 3)) :=
  Subgroup.closure (Set.range y422Orthogonal3NormTwoProjectiveReflection)

/-- Every independent norm-two projective reflection belongs to the independently defined group. -/
theorem y422Orthogonal3NormTwoProjectiveReflection_mem (v : Y422Orthogonal3NormTwoVector) :
    y422Orthogonal3NormTwoProjectiveReflection v ∈ y422Orthogonal3NormTwoProjectiveGroup :=
  Subgroup.subset_closure ⟨v, rfl⟩

/-- Every actual original source generator is an independent norm-two projective reflection. -/
theorem y422Orthogonal3Generator_mem_normTwoProjectiveGroup (i : Fin 9) :
    Matrix.ProjGenLinGroup.mk (y422Orthogonal3Generator i) ∈
      y422Orthogonal3NormTwoProjectiveGroup := by
  have h := y422Orthogonal3NormTwoProjectiveReflection_mem
    ⟨y422Orthogonal3Root i, y422Orthogonal3Root_norm i⟩
  unfold y422Orthogonal3NormTwoProjectiveReflection at h
  rw [y422Orthogonal3RootReflection_generator] at h
  exact h

/-- The actual original presentation image lies in the independently specified reflection group. -/
theorem y422Orthogonal3ProjectiveImage_le_normTwoProjectiveGroup :
    y422Orthogonal3ProjectiveImage ≤ y422Orthogonal3NormTwoProjectiveGroup := by
  have hs : Subgroup.closure (Set.range (PresentedGroup.of : Fin 9 → Y422Presentation)) ≤
      y422Orthogonal3NormTwoProjectiveGroup.comap y422Orthogonal3ProjectiveHom := by
    apply (Subgroup.closure_le
      (y422Orthogonal3NormTwoProjectiveGroup.comap y422Orthogonal3ProjectiveHom)).mpr
    rintro x ⟨i, rfl⟩
    change y422Orthogonal3ProjectiveHom (PresentedGroup.of i) ∈
      y422Orthogonal3NormTwoProjectiveGroup
    rw [y422Orthogonal3ProjectiveHom_generator]
    exact y422Orthogonal3Generator_mem_normTwoProjectiveGroup i
  rw [PresentedGroup.closure_range_of y422Relations] at hs
  rintro x ⟨y, rfl⟩
  exact hs (Subgroup.mem_top y)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
