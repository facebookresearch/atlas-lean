/-- The exact original source label at the post monomial boundary. -/
def generatedRootEightIncomingTensorPostLabel (n : Fin 4096) : Fin 4096 :=
  ⟨((generatedRootEightIncomingTensorPostLabelWords
    ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩).shiftRight
      (12 * (n.val % 16))) % 4096, Nat.mod_lt _ (by decide)⟩

/-- The original signed coefficient at the post monomial boundary. -/
def generatedRootEightIncomingTensorPostSign (n : Fin 4096) : ℤ :=
  if (generatedRootEightIncomingTensorPostSignWords
      ⟨n.val / 512, by omega⟩ ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩).testBit
    (n.val % 64) then -1 else 1

/-- The entire integer post monomial action, retaining every coordinate. -/
def generatedRootEightIncomingTensorPostInteger
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  generatedRootEightIncomingTensorPostSign n * v (generatedRootEightIncomingTensorPostLabel n)

