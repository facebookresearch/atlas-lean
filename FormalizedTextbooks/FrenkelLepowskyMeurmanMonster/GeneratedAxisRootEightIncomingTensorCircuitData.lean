/-- The exact original source label at the pre monomial boundary. -/
def generatedRootEightIncomingTensorPreLabel (n : Fin 4096) : Fin 4096 :=
  ⟨((generatedRootEightIncomingTensorPreLabelWords
    ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩).shiftRight
      (12 * (n.val % 16))) % 4096, Nat.mod_lt _ (by decide)⟩

/-- The original signed coefficient at the pre monomial boundary. -/
def generatedRootEightIncomingTensorPreSign (n : Fin 4096) : ℤ :=
  if (generatedRootEightIncomingTensorPreSignWords
      ⟨n.val / 512, by omega⟩ ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩).testBit
    (n.val % 64) then -1 else 1

/-- The entire integer pre monomial action, retaining every coordinate. -/
def generatedRootEightIncomingTensorPreInteger
    (v : NortonUIntegerVector) (n : Fin 4096) : ℤ :=
  generatedRootEightIncomingTensorPreSign n * v (generatedRootEightIncomingTensorPreLabel n)

