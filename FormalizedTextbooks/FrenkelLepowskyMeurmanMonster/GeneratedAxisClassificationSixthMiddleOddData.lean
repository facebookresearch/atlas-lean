/-- Every source coordinate pair is strictly increasing. -/
theorem generatedSixth_middle_odd_source_lt (k : Fin 276) :
    (generatedSixthMiddleOddSourceCoordinates k).2.1 <
      (generatedSixthMiddleOddSourceCoordinates k).2.2 := by
  revert k
  decide +kernel

/-- The genuine original source pair address for each listed middle odd image. -/
def generatedSixthMiddleOddInput (k : Fin 276) : GeneratedSixthSourcePair :=
  ((generatedSixthMiddleOddSourceCoordinates k).1,
    griessPairIndex (generatedSixthMiddleOddSourceCoordinates k).2.1
      (generatedSixthMiddleOddSourceCoordinates k).2.2
      (ne_of_lt (generatedSixth_middle_odd_source_lt k)))

/-- The genuine preferred odd label in each original physical image. -/
def generatedSixthMiddleOddOutput (k : Fin 276) : GriessShortIndex :=
  Sum.inr (Sum.inr (generatedSixthMiddleOddTargetCoordinates k))

set_option maxHeartbeats 4000000 in
-- Check 276 ordinary physical vector images against the certified original frame columns.
/-- Every target is the true original lattice image, with its physical sign retained. -/
theorem generatedSixth_middle_odd_physical_certificate (k : Fin 276) (i : Fin 24) :
    generatedSixthFrameVectorData 8 (generatedSixthMiddleOddSourceCoordinates k).2.1 i +
      (if (generatedSixthMiddleOddSourceCoordinates k).1 = 0 then -1 else 1) *
        generatedSixthFrameVectorData 8 (generatedSixthMiddleOddSourceCoordinates k).2.2 i =
      2 * generatedSixthMiddleOddPhysicalSign k *
        griessShortIntegral (generatedSixthMiddleOddOutput k) i := by
  revert k i
  decide +kernel

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
