-- Evaluate the finite source-coordinate dictionary without enumerating short classes.
/-- Every displayed physical pair has distinct coordinates in increasing order. -/
theorem monsterNortonEvenShortInverseUPair_lt (k : Fin 23) (e : Fin 64) :
    monsterNortonEvenShortInverseUPairFirst k e < monsterNortonEvenShortInverseUPairSecond k e := by
  revert k e
  decide +kernel

/-- The exact preferred source short label following inverse U. -/
noncomputable def monsterNortonEvenShortInverseUOutput (k : Fin 23) (e : Fin 64) :
    GriessShortIndex :=
  if monsterNortonEvenShortInverseUKind k e = 0 then
    Sum.inl (monsterNortonEvenShortInverseUPairSign k e,
      griessPairIndex (monsterNortonEvenShortInverseUPairFirst k e)
        (monsterNortonEvenShortInverseUPairSecond k e)
        (ne_of_lt (monsterNortonEvenShortInverseUPair_lt k e)))
  else if monsterNortonEvenShortInverseUKind k e = 1 then
    let a := monsterNortonEvenShortInverseUOctadSlot k e
    Sum.inr (Sum.inl (monsterNortonOctadIndex (monsterNortonEvenShortInverseUOctadCodes a)
      (monsterNortonEvenShortInverseUOctad_weight a), monsterNortonEvenShortInverseUOctadSign k e))
  else
    Sum.inr (Sum.inr (monsterNortonEvenShortInverseUOddCode k e,
      monsterNortonEvenShortInverseUOddPosition k e))

/-- Complete finite physical integer vector for each preferred output. -/
def monsterNortonEvenShortInverseUIntegral (k : Fin 23) (e : Fin 64) : Fin 24 → ℤ :=
  if monsterNortonEvenShortInverseUKind k e = 0 then
    fun i => 4 * (if i = monsterNortonEvenShortInverseUPairFirst k e then 1 else 0) +
      (if monsterNortonEvenShortInverseUPairSign k e = 0 then -4 else 4) *
        (if i = monsterNortonEvenShortInverseUPairSecond k e then 1 else 0)
  else if monsterNortonEvenShortInverseUKind k e = 1 then
    let a := monsterNortonEvenShortInverseUOctadSlot k e
    monsterNortonOctadIntegral (monsterNortonEvenShortInverseUOctadCodes a)
      (monsterNortonEvenShortInverseUOctadPositions a) (monsterNortonEvenShortInverseUOctadSign k e)
  else
    fun i => (if (golayEncodedMask (monsterNortonEvenShortInverseUOddCode k e).val).testBit i.val
      then -1 else 1) * (if i = monsterNortonEvenShortInverseUOddPosition k e then -3 else 1)

/-- Every finite output vector equals the actual original Conway short dictionary entry. -/
theorem monsterNortonEvenShortInverseUIntegral_actual (k : Fin 23) (e : Fin 64) :
    griessShortIntegral (monsterNortonEvenShortInverseUOutput k e) =
      monsterNortonEvenShortInverseUIntegral k e := by
  unfold monsterNortonEvenShortInverseUOutput monsterNortonEvenShortInverseUIntegral
  by_cases h0 : monsterNortonEvenShortInverseUKind k e = 0
  · simp only [ite_eq_left h0]
    rw [griessShortIntegral, griessPairIndex_coordinates]
    simp only [monsterNortonEvenShortInverseUPair_lt, ite_true]
  · simp only [ite_eq_right h0]
    by_cases h1 : monsterNortonEvenShortInverseUKind k e = 1
    · simp only [ite_eq_left h1]
      exact monsterNortonOctadIntegral_eq _ _ _
        (monsterNortonEvenShortInverseUOctad_coordinate _) _
    · simp only [ite_eq_right h1]
      rfl

/-- Original input labels of each Fourier packet. -/
noncomputable def monsterNortonEvenShortInverseUInput (k : Fin 23) (e : Fin 64) :
    GriessShortIndex :=
  Sum.inr (Sum.inl (monsterNortonOctadIndex (monsterNortonEvenShortFirstUOctadCodes k)
    (monsterNortonEvenShortFirstUOctad_weight k), e))

/-- The complete physical integer formula for a Fourier-packet input. -/
def monsterNortonEvenShortInverseUInputIntegral (k : Fin 23) (e : Fin 64) : Fin 24 → ℤ :=
  monsterNortonOctadIntegral (monsterNortonEvenShortFirstUOctadCodes k)
    (monsterNortonEvenShortFirstUOctadPositions k) e

/-- The finite input formula is the actual source dictionary vector. -/
theorem monsterNortonEvenShortInverseUInputIntegral_actual (k : Fin 23) (e : Fin 64) :
    griessShortIntegral (monsterNortonEvenShortInverseUInput k e) =
      monsterNortonEvenShortInverseUInputIntegral k e :=
  monsterNortonOctadIntegral_eq _ _ _ (monsterNortonEvenShortFirstUOctad_coordinate k) e

