set_option maxHeartbeats 4000000 in
-- Evaluate the finite source-coordinate dictionary without enumerating short classes.
/-- Every displayed source code is an actual weight-eight Golay codeword. -/
theorem monsterNortonEvenShortInverseUOctad_weight (a : Fin 94) :
    golayMaskWeight (golayEncodedMask (monsterNortonEvenShortInverseUOctadCodes a).val) = 8 := by
  revert a
  decide +kernel

set_option maxHeartbeats 4000000 in
-- Check the finite physical octad-position tables.
private theorem positions_mem (a : Fin 94) (i : Fin 24) :
    i ∈ golayMaskSupport (golayEncodedMask (monsterNortonEvenShortInverseUOctadCodes a).val) ↔
      i ∈ List.ofFn (monsterNortonEvenShortInverseUOctadPositions a) := by
  revert a i
  decide +kernel

set_option maxHeartbeats 4000000 in
-- Check the finite physical octad-position tables.
private theorem positions_sorted (a : Fin 94) :
    List.SortedLT (List.ofFn (monsterNortonEvenShortInverseUOctadPositions a)) := by
  revert a
  decide +kernel

private theorem positions_sort (a : Fin 94) :
    (golayMaskSupport (golayEncodedMask (monsterNortonEvenShortInverseUOctadCodes a).val)).sort =
      List.ofFn (monsterNortonEvenShortInverseUOctadPositions a) := by
  apply (golayMaskSupport _).sortedLT_sort.eq_of_mem_iff (positions_sorted a)
  intro i
  simp only [Finset.mem_sort]
  exact positions_mem a i

set_option maxHeartbeats 4000000 in
-- Check the finite physical octad-position tables.
private theorem position_index (a : Fin 94) (k : Fin 8) :
    (List.ofFn (monsterNortonEvenShortInverseUOctadPositions a)).idxOf
      (monsterNortonEvenShortInverseUOctadPositions a k) = k.val := by
  revert a k
  decide +kernel

/-- These finite positions are the actual increasing octad coordinates. -/
theorem monsterNortonEvenShortInverseUOctad_coordinate (a : Fin 94) (k : Fin 8) :
    golayOctadCoordinate
      (monsterNortonOctadIndex (monsterNortonEvenShortInverseUOctadCodes a)
        (monsterNortonEvenShortInverseUOctad_weight a)) k =
          monsterNortonEvenShortInverseUOctadPositions a k := by
  apply monsterNortonOctadIndex_coordinate (monsterNortonEvenShortInverseUOctadCodes a)
    (monsterNortonEvenShortInverseUOctad_weight a) (monsterNortonEvenShortInverseUOctadPositions a)
  · intro j
    have h := (positions_mem a (monsterNortonEvenShortInverseUOctadPositions a j)).mpr
      (List.mem_ofFn.mpr ⟨j, rfl⟩)
    exact (Finset.mem_filter.mp h).2
  · intro j
    rw [positions_sort]
    exact position_index a j

