-- Verify both inverse laws of all 129 physical coordinate permutations.
theorem golayStabilizerRep_inverse_certificate : ∀ r : Fin 129, ∀ i : Fin 24,
    golayStabilizerRepForward r (golayStabilizerRepInverse r i) = i ∧
      golayStabilizerRepInverse r (golayStabilizerRepForward r i) = i := by
  decide +kernel

