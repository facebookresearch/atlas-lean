-- Each of the 3096 generator images is checked against the source mask encoder.
theorem golayStabilizerRep_code_certificate : ∀ r : Fin 129, ∀ j : Fin 12, ∀ i : Fin 24,
    (golayGeneratorMasks j).testBit (golayStabilizerRepInverse r i).val =
      (golayEncodedMask (golayStabilizerRepForwardCodes r j).val).testBit i.val ∧
    (golayGeneratorMasks j).testBit (golayStabilizerRepForward r i).val =
      (golayEncodedMask (golayStabilizerRepInverseCodes r j).val).testBit i.val := by
  decide +kernel

