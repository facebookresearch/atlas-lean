module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueRootedGolayTransport
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22StarGeneration

/-! Original auxiliary M22 abelianity and intersection generation for every distinguished pair. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

private theorem range_transport {G : Type*} (g : golayAutomorphismSubgroup)
    {p q : Fin 24} (hp : g.val 0 = p) (hq : g.val 1 = q)
    (phi : Co1ResidueM22Point p q → G) :
    Set.range (fun s => phi (co1ResidueM22RootTransport g hp hq s)) = Set.range phi := by
  ext x
  constructor
  · rintro ⟨s, rfl⟩
    exact ⟨_, rfl⟩
  · rintro ⟨s, rfl⟩
    obtain ⟨t, rfl⟩ := co1ResidueM22RootTransport_surjective g hp hq s
    exact ⟨t, rfl⟩

/-- Every original auxiliary M22 representation at any distinguished pair is abelian. -/
theorem co1ResidueM22_rooted_representation_abelian {G : Type*} [Group G]
    (p q : Fin 24) (hpq : p ≠ q) (phi : Co1ResidueM22Point p q → G)
    (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ s t u, co1ResidueM22Line p q s t u → phi s * phi t * phi u = 1)
    (hgen : Subgroup.closure (Set.range phi) = ⊤) : IsMulCommutative G := by
  obtain ⟨g, hp, hq⟩ := co1ResidueGolay_pair_reach p q hpq
  let psi := fun s => phi (co1ResidueM22RootTransport g hp hq s)
  have hgp : Subgroup.closure (Set.range psi) = ⊤ := by
    rw [show Set.range psi = Set.range phi from range_transport g hp hq phi, hgen]
  exact co1ResidueM22_representation_abelian psi (fun _ => hsquare _) (fun s t u h =>
    hline _ _ _ (co1ResidueM22RootTransport_line g hp hq s t u h)) hgp

/-- Every original auxiliary M22 representation is generated by any coordinate star.
This is the intersection-generation component needed in the source M24 comparison. -/
theorem co1ResidueM22_rooted_star_generates {G : Type*} [Group G]
    (p q r : Fin 24) (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r)
    (phi : Co1ResidueM22Point p q → G) (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ s t u, co1ResidueM22Line p q s t u → phi s * phi t * phi u = 1)
    (hgen : Subgroup.closure (Set.range phi) = ⊤) :
    Subgroup.closure {g | ∃ s : Co1ResidueM22Point p q, r ∈ s.val ∧ g = phi s} = ⊤ := by
  obtain ⟨g, hp, hq, hr⟩ := co1ResidueGolay_triple_reach p q r hpq hpr hqr
  let psi := fun s => phi (co1ResidueM22RootTransport g hp hq s)
  have hgp : Subgroup.closure (Set.range psi) = ⊤ := by
    rw [show Set.range psi = Set.range phi from range_transport g hp hq phi, hgen]
  have hstar := co1ResidueM22_representation_star_generates psi (fun _ => hsquare _)
    (fun s t u h => hline _ _ _ (co1ResidueM22RootTransport_line g hp hq s t u h)) hgp
  have he : {x | ∃ s : Co1ResidueM22Point 0 1, (2 : Fin 24) ∈ s.val ∧ x = psi s} =
      {x | ∃ s : Co1ResidueM22Point p q, r ∈ s.val ∧ x = phi s} := by
    ext x
    constructor
    · rintro ⟨s, hs, rfl⟩
      refine ⟨co1ResidueM22RootTransport g hp hq s, ?_, rfl⟩
      rw [← hr]
      exact (co1ResidueM22RootTransport_mem g hp hq s 2).mpr hs
    · rintro ⟨s, hs, rfl⟩
      obtain ⟨t, rfl⟩ := co1ResidueM22RootTransport_surjective g hp hq s
      refine ⟨t, ?_, rfl⟩
      rw [← hr] at hs
      exact (co1ResidueM22RootTransport_mem g hp hq t 2).mp hs
  rw [he] at hstar
  exact hstar

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
