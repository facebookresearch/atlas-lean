/-- Concrete candidate coordinate lifts at the individual actual source-factor boundaries. -/
def generatedAxisGlobalFifthQState12 (n : Fin 41) (i : Fin 24) : Q :=
  ⟨ofAdd (fun j => golayBooleanCast ((generatedAxisGlobalFifthQState12Binary n i).testBit j.val)),
    ofAdd (generatedAxisGlobalFifthQState12Phase n i)⟩

/-- The actual literal root 12 word has precisely 40 chronological source factors. -/
theorem generatedAxisGlobalFifthQFactor12_length :
    (generatedAxisGlobalFifthChainQFactors 12 (generatedAxisGlobalFifthActiveStages 12)).length =
      40 := by decide +kernel

/-- An individual factor read directly from the genuine original root 12 source list. -/
def generatedAxisGlobalFifthQFactor12 (n : Fin 40) : GeneratedAxisGlobalQFactor :=
  (generatedAxisGlobalFifthChainQFactors 12 (generatedAxisGlobalFifthActiveStages 12))[n.val]'(by
    rw [generatedAxisGlobalFifthQFactor12_length]
    exact n.isLt)

