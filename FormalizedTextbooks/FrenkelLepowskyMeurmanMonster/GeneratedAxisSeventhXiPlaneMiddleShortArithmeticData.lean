/-- Explicit actual integer pair vector before the original seven-factor word. -/
def generatedSeventhXiShortInputIntegral (s : Fin 2) (p : Fin 276) (i : Fin 24) : ℤ :=
  (if i = (generatedSeventhXiShortInputCoordinates p).1 then 4 else 0) +
    (if i = (generatedSeventhXiShortInputCoordinates p).2 then
      if s = 0 then -4 else 4 else 0)

/-- The computable preferred-Q formula on an explicit integer lattice vector. -/
def generatedSeventhXiShortIntegerQ (v : Fin 24 → ℤ) : Q :=
  ⟨Multiplicative.ofAdd (leechHyperbolicInverse *ᵥ
    integerParity (monsterNortonLeechCoordinates v)), 1⟩

/-- Physical negative mask of a normalized octad, using its eight explicit ordered coordinates. -/
def generatedSeventhXiShortNegativeMask (s : Fin 2) (p : Fin 276) : ℕ :=
  (List.finRange 8).foldr (fun k m =>
    (if (trialityEvenMask ⟨generatedSeventhXiShortDescriptor s p 2 % 64,
      Nat.mod_lt _ (by decide)⟩).testBit k.val then
      2 ^ (generatedSeventhXiShortOctadCoordinates s p k).val else 0) ||| m) 0

/-- The normalized explicit integer image described by the finite physical shape data. -/
def generatedSeventhXiShortOutputIntegral (s : Fin 2) (p : Fin 276) (i : Fin 24) : ℤ :=
  let d := generatedSeventhXiShortDescriptor s p
  if d 0 = 0 then
    (if i.val = d 2 then 4 else 0) +
      (if i.val = d 3 then if d 1 = 0 then -4 else 4 else 0)
  else if d 0 = 1 then
    if (golayEncodedMask (d 1)).testBit i.val then
      if (generatedSeventhXiShortNegativeMask s p).testBit i.val then -2 else 2
    else 0
  else (if (golayEncodedMask (d 1)).testBit i.val then -1 else 1) *
    (if i.val = d 2 then -3 else 1)

