/-- Original label of the post boundary. -/
def generatedTwelfthIncomingSpinTensorPostLabel (i : Fin 1) (n : Fin 4096) : Fin 4096 :=
  ⟨(generatedTwelfthIncomingSpinTensorPostLabelWords i
    ⟨n.val / 256, by omega⟩ ⟨n.val / 16 % 16, Nat.mod_lt _ (by decide)⟩ /
      2 ^ (12 * (n.val % 16))) % 4096, Nat.mod_lt _ (by decide)⟩

/-- Original integral sign of the post boundary. -/
def generatedTwelfthIncomingSpinTensorPostSign (i : Fin 1) (n : Fin 4096) : ℤ :=
  if (generatedTwelfthIncomingSpinTensorPostSignWords i ⟨n.val / 256, by omega⟩).testBit
    (n.val % 256) then -1 else 1

/-- Integral complete post boundary action. -/
