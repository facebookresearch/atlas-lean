/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeTwentyOneSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeTwentyOneSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeTwentyOneSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeTwentyOneSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeTwentyOneSpinPrefixDense_support (i : Fin 16) :
    monsterNortonCodeTwentyOneSpinPrefixDense (monsterNortonCodeTwentyOneSpinPrefixLabel i) =
      monsterNortonCodeTwentyOneSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeTwentyOneSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeTwentyOneSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 15, monsterNortonCodeTwentyOneSpinPrefixLabel i.castSucc <
      monsterNortonCodeTwentyOneSpinPrefixLabel i.succ := by decide +kernel
  exact hc

