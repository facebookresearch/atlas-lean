/-- The packed post table of each required genuine fixer. -/
def generatedTenthCCBoundaryPostTable (g : Fin 2) : ℕ :=
  if g = 0 then generatedTenthCCBoundaryPostTable0 else generatedTenthCCBoundaryPostTable1

/-- The packed pre table of each required genuine fixer. -/
def generatedTenthCCBoundaryPreTable (g : Fin 2) : ℕ :=
  if g = 0 then generatedTenthCCBoundaryPreTable0 else generatedTenthCCBoundaryPreTable1

/-- One thirteen-bit post entry. -/
def generatedTenthCCBoundaryPostEntry (g : Fin 2) (n : Fin 4096) : ℕ :=
  (generatedTenthCCBoundaryPostTable g >>> (13 * n.val)) % 8192

/-- One thirteen-bit pre entry. -/
def generatedTenthCCBoundaryPreEntry (g : Fin 2) (n : Fin 4096) : ℕ :=
  (generatedTenthCCBoundaryPreTable g >>> (13 * n.val)) % 8192

/-- The tabulated post label. -/
def generatedTenthCCBoundaryPostLabel (g : Fin 2) (n : Fin 4096) : Fin 4096 :=
  ⟨generatedTenthCCBoundaryPostEntry g n % 4096, Nat.mod_lt _ (by decide)⟩

/-- The tabulated pre label. -/
def generatedTenthCCBoundaryPreLabel (g : Fin 2) (n : Fin 4096) : Fin 4096 :=
  ⟨generatedTenthCCBoundaryPreEntry g n % 4096, Nat.mod_lt _ (by decide)⟩

/-- The tabulated post sign. -/
def generatedTenthCCBoundaryPostSign (g : Fin 2) (n : Fin 4096) : ℤ :=
  if generatedTenthCCBoundaryPostEntry g n / 4096 = 0 then 1 else -1

/-- The tabulated pre sign. -/
def generatedTenthCCBoundaryPreSign (g : Fin 2) (n : Fin 4096) : ℤ :=
  if generatedTenthCCBoundaryPreEntry g n / 4096 = 0 then 1 else -1

/-- A post entry agrees with the genuine inverse-left label and complete post sign. -/
def GeneratedTenthCCBoundaryPostEntryCondition (g : Fin 2) (n : Fin 4096) : Prop :=
  nortonUIntegerLabel ((generatedTenthTwoFixerTensorLeft g).symm
      (golayLabelCoefficients n + spinTranslation (generatedTenthTwoFixerTensorPauli g))) =
    generatedTenthCCBoundaryPostLabel g n ∧
  generatedAxisGlobalIntSign (spinPhase (generatedTenthTwoFixerTensorPauli g)
      (golayLabelCoefficients n)) *
    generatedAxisGlobalIntSign (monsterMonomialQuadratic
      (generatedTenthTwoFixerTensorFirstPhase g) ((generatedTenthTwoFixerTensorLeft g).symm
        (golayLabelCoefficients n + spinTranslation (generatedTenthTwoFixerTensorPauli g)))) =
    generatedTenthCCBoundaryPostSign g n

/-- A pre entry agrees with the genuine inverse-right label and second quadratic sign. -/
def GeneratedTenthCCBoundaryPreEntryCondition (g : Fin 2) (n : Fin 4096) : Prop :=
  nortonUIntegerLabel ((generatedTenthTwoFixerTensorRight g).symm (golayLabelCoefficients n)) =
    generatedTenthCCBoundaryPreLabel g n ∧
  generatedAxisGlobalIntSign (monsterMonomialQuadratic
      (generatedTenthTwoFixerTensorSecondPhase g) (golayLabelCoefficients n)) =
    generatedTenthCCBoundaryPreSign g n

/-- The post word assembled from tabulated labels and signs. -/
def generatedTenthCCBoundaryPostTableWord (g : Fin 2) (j : Fin 24) (a : Fin 256) : ℕ :=
  generatedTenthPackedBoundaryWord fun i =>
    generatedTenthCCBoundaryPostSign g (generatedNinthLowerSpinPackedPrefixIndex a i) *
      generatedTenthTwoFixerTensorState g (generatedTenthTwoFixerTensorPairs g).length
        (generatedTenthCCBoundaryPostLabel g (generatedNinthLowerSpinPackedPrefixIndex a i)) j

/-- The pre word assembled from tabulated labels and signs. -/
def generatedTenthCCBoundaryPreTableWord (g : Fin 2) (k : Fin 24) (a : Fin 256) : ℕ :=
  generatedTenthPackedBoundaryWord fun i =>
    generatedTenthCCBoundaryPreSign g (generatedNinthLowerSpinPackedPrefixIndex a i) *
      generatedTenthTwoFixerTensorInput
        (generatedTenthCCBoundaryPreLabel g (generatedNinthLowerSpinPackedPrefixIndex a i)) k

/-- The finish boundary equations at one prefix, using the tabulated post word. -/
def GeneratedTenthCCBoundaryFinishTableCondition (g : Fin 2) (j : Fin 24) (a : Fin 256) :
    Prop :=
  generatedRootEightPackedSignedWord (generatedTenthCCBoundaryPostTableWord g j a) =
      generatedRootEightPackedSignedWord (generatedTenthPackedBoundaryInputWord j a) ∧
    generatedTenthPackedBoundaryStageWord g ((generatedTenthTwoFixerTensorPairs g).length + 1)
      j a = generatedTenthPackedBoundaryInputWord j a

/-- The start boundary equation at one prefix, using the tabulated pre words. -/
def GeneratedTenthCCBoundaryStartTableCondition (g : Fin 2) (j : Fin 24) (a : Fin 256) :
    Prop :=
  (∑ k : Fin 24, generatedTenthTwoFixerTensorNumerator g j k *
    generatedRootEightPackedSignedWord (generatedTenthCCBoundaryPreTableWord g k a)) =
      (generatedTenthTwoFixerTensorDenominator g : ℤ) *
        generatedRootEightPackedSignedWord (generatedTenthPackedBoundaryStageWord g 0 j a)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
