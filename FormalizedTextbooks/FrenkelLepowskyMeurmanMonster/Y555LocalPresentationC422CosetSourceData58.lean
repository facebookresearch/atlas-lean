-- Exact signed-letter bounds are checked for at most 128 literal source pairs.
/-- Both literal source sides belong to the exact actual finite symbol alphabet. -/
theorem y422CosetSourceRaw58_allowed (i : Fin 128) :
    y322RawEquationWordAllowed 9042 (y422CosetSourceRaw58 i).1 ∧
      y322RawEquationWordAllowed 9042 (y422CosetSourceRaw58 i).2 := by
  revert i
  decide +kernel

/-- Exact decoded source equation, preserving every bound-checked signed letter. -/
def y422CosetSourceEquation58 (i : Fin 128) : Y322WordEquation (Fin 9042) :=
  ⟨y322RawEquationWordDecode 9042 (y422CosetSourceRaw58 i).1
      (y422CosetSourceRaw58_allowed i).1,
    y322RawEquationWordDecode 9042 (y422CosetSourceRaw58 i).2
      (y422CosetSourceRaw58_allowed i).2⟩

