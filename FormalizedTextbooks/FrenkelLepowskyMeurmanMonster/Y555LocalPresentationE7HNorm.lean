/-- The block coordinate of each of the 3956 distinct normalization certificates. -/
def y322E7HNormBlock (index : Fin 3956) : Fin 62 :=
  ⟨index.val / 64, by omega⟩

/-- The within-block coordinate of each distinct finite normalization certificate. -/
def y322E7HNormOffset (index : Fin 3956) : Fin 64 :=
  ⟨index.val % 64, Nat.mod_lt _ (by decide)⟩

/-- Exact input word for each distinct source normalization certificate. -/
def y322E7HNormInput (index : Fin 3956) : List (Fin 8) :=
  y322E7HNormInputBlock (y322E7HNormBlock index) (y322E7HNormOffset index)

/-- Exact output word for each distinct source normalization certificate. -/
def y322E7HNormOutput (index : Fin 3956) : List (Fin 8) :=
  y322E7HNormOutputBlock (y322E7HNormBlock index) (y322E7HNormOffset index)

/-- Exact elementary source moves for each distinct normalization certificate. -/
def y322E7HNormMoves (index : Fin 3956) : List Y322CoxeterMove :=
  y322E7HNormMovesBlock (y322E7HNormBlock index) (y322E7HNormOffset index)

/-- All 3956 distinct literal normalization certificates replay successfully. -/
theorem y322E7HNormReplay (index : Fin 3956) :
    y322CoxeterRun (y322E7HNormMoves index) (y322E7HNormInput index) =
      some (y322E7HNormOutput index) :=
  y322E7HNormBlockReplay (y322E7HNormBlock index) (y322E7HNormOffset index)

/-- Every assembled normalization is an exact identity in the actual source local quotient. -/
theorem y322E7HNormValue (index : Fin 3956) :
    y322PositiveWord (y322E7HNormInput index) = y322PositiveWord (y322E7HNormOutput index) :=
  y322CoxeterRun_valid _ _ _ (y322E7HNormReplay index)

