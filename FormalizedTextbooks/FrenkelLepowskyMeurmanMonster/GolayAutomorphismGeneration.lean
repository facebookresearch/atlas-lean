module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismGenerationData
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GolayAutomorphismOrder
public import Mathlib.Algebra.Group.Subgroup.Finite

/-! The two explicit physical permutations generate the full actual Golay
permutation automorphism group. Generator provenance is established by checked
word arrays, then the seven-point base gives a complete stabilizer reduction. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The subgroup generated by the two explicit physical Golay permutations. -/
def golayTwoGeneratorSubgroup : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range omegaOrbitGolayPermutation)

/-- Original generator letters, including their inverses. -/
def golayGeneratingLetter (t : Fin 4) : golayAutomorphismSubgroup :=
  if h : t.val < 2 then omegaOrbitGolayPermutation ⟨t.val, h⟩
  else (omegaOrbitGolayPermutation ⟨t.val - 2, by omega⟩)⁻¹

/-- Evaluation of an original-generator word in the actual automorphism group. -/
def golayGeneratingWord (w : List (Fin 4)) : golayAutomorphismSubgroup :=
  (w.map golayGeneratingLetter).prod

private theorem golayGeneratingLetter_apply (t : Fin 4) (i : Fin 24) :
    (golayGeneratingLetter t).val i = golayGeneratingLetterArray t i := by
  fin_cases t <;> rfl

private theorem golayGeneratingWord_apply (w : List (Fin 4)) (i : Fin 24) :
    (golayGeneratingWord w).val i = golayGeneratingWordArray w i := by
  induction w generalizing i with
  | nil => rfl
  | cons t w ih =>
    change (golayGeneratingLetter t).val ((golayGeneratingWord w).val i) = _
    rw [golayGeneratingLetter_apply, ih]
    rfl

private theorem golayGeneratingLetter_mem (t : Fin 4) :
    golayGeneratingLetter t ∈ golayTwoGeneratorSubgroup := by
  unfold golayGeneratingLetter
  split_ifs
  · exact Subgroup.subset_closure ⟨_, rfl⟩
  · exact golayTwoGeneratorSubgroup.inv_mem (Subgroup.subset_closure ⟨_, rfl⟩)

private theorem golayGeneratingWord_mem (w : List (Fin 4)) :
    golayGeneratingWord w ∈ golayTwoGeneratorSubgroup := by
  apply golayTwoGeneratorSubgroup.list_prod_mem
  intro x hx
  obtain ⟨t, _, rfl⟩ := List.mem_map.mp hx
  exact golayGeneratingLetter_mem t

/-- The strong generators as genuine original-generator words. -/
def golayStrongAutomorphism (s : Fin 14) : golayAutomorphismSubgroup :=
  golayGeneratingWord (golayStrongWords s)

private theorem golayStrongAutomorphism_apply (s : Fin 14) (i : Fin 24) :
    (golayStrongAutomorphism s).val i = golayStrongForward s i := by
  rw [golayStrongAutomorphism, golayGeneratingWord_apply, golayStrongWords_certificate]

private theorem golayStrongAutomorphism_inverse_apply (s : Fin 14) (i : Fin 24) :
    (golayStrongAutomorphism s).val.symm i = golayStrongInverse s i := by
  apply (golayStrongAutomorphism s).val.injective
  rw [Equiv.apply_symm_apply, golayStrongAutomorphism_apply,
    (golayStrong_inverse_certificate s i).1]

/-- Strong generator letters, including their inverses. -/
def golayStrongLetter (t : Fin 28) : golayAutomorphismSubgroup :=
  if h : t.val < 14 then golayStrongAutomorphism ⟨t.val, h⟩
  else (golayStrongAutomorphism ⟨t.val - 14, by omega⟩)⁻¹

/-- Evaluation of a strong-generator word in the actual automorphism group. -/
def golayStrongWord (w : List (Fin 28)) : golayAutomorphismSubgroup :=
  (w.map golayStrongLetter).prod

private theorem golayStrongLetter_apply (t : Fin 28) (i : Fin 24) :
    (golayStrongLetter t).val i = golayStrongLetterArray t i := by
  unfold golayStrongLetter golayStrongLetterArray
  split_ifs
  · exact golayStrongAutomorphism_apply _ i
  · exact golayStrongAutomorphism_inverse_apply _ i

private theorem golayStrongWord_apply (w : List (Fin 28)) (i : Fin 24) :
    (golayStrongWord w).val i = golayStrongWordArray w i := by
  induction w generalizing i with
  | nil => rfl
  | cons t w ih =>
    change (golayStrongLetter t).val ((golayStrongWord w).val i) = _
    rw [golayStrongLetter_apply, ih]
    rfl

private theorem golayStrongLetter_mem (t : Fin 28) :
    golayStrongLetter t ∈ golayTwoGeneratorSubgroup := by
  unfold golayStrongLetter
  split_ifs
  · exact golayGeneratingWord_mem _
  · exact golayTwoGeneratorSubgroup.inv_mem (golayGeneratingWord_mem _)

private theorem golayStrongWord_mem (w : List (Fin 28)) :
    golayStrongWord w ∈ golayTwoGeneratorSubgroup := by
  apply golayTwoGeneratorSubgroup.list_prod_mem
  intro x hx
  obtain ⟨t, _, rfl⟩ := List.mem_map.mp hx
  exact golayStrongLetter_mem t

/-- Every actual stabilizer representative is generated by the two original permutations. -/
theorem golayStabilizerAutomorphism_mem_twoGenerators (r : Fin 129) :
    golayStabilizerAutomorphism r ∈ golayTwoGeneratorSubgroup := by
  have h : golayStrongWord (golayStabilizerStrongWords r) = golayStabilizerAutomorphism r := by
    apply Subtype.ext
    apply Equiv.ext
    intro i
    rw [golayStrongWord_apply, golayStabilizerStrongWords_certificate]
    rfl
  rw [← h]
  exact golayStrongWord_mem _

private theorem golayStabilizer_mem_twoGenerators : ∀ n : ℕ, n ≤ 7 →
    ∀ p : golayAutomorphismSubgroup, p ∈ golayPointStabilizer (7 - n) →
      p ∈ golayTwoGeneratorSubgroup := by
  intro n
  induction n with
  | zero =>
    intro _ p hp
    have h : p = 1 := golayAutomorphism_eq_one_of_fix_base p (fun j => hp j j.isLt)
    rw [h]
    exact golayTwoGeneratorSubgroup.one_mem
  | succ n ih =>
    intro hn p hp
    let k : Fin 7 := ⟨7 - (n + 1), by omega⟩
    let pfix : golayPointStabilizer k.val := ⟨p, hp⟩
    have hi := golayPointStabilizer_image_eligible k pfix
    obtain ⟨r, hr, hri⟩ := golayStabilizerRep_orbit_certificate k _ hi
    let q := golayStabilizerAutomorphism r
    have hq : q ∈ golayTwoGeneratorSubgroup := golayStabilizerAutomorphism_mem_twoGenerators r
    have hnext : q⁻¹ * p ∈ golayPointStabilizer (7 - n) := by
      intro j hj
      have hstep : 7 - n = k.val + 1 := by dsimp [k]; omega
      rw [hstep] at hj
      change q.val.symm (p.val (golayBasePoints j)) = golayBasePoints j
      by_cases hjk : j.val < k.val
      · have hpj := hp j hjk
        have hqj : q.val (golayBasePoints j) = golayBasePoints j :=
          golayStabilizerRep_prefix_certificate r j (by simpa only [hr] using hjk)
        rw [hpj]
        have hh := congrArg q.val.symm hqj
        rw [q.val.symm_apply_apply] at hh
        exact hh.symm
      · have hjeq : j = k := Fin.ext (by omega)
        subst j
        have hqk : q.val (golayBasePoints k) = p.val (golayBasePoints k) := hri
        rw [← hqk, q.val.symm_apply_apply]
    have hrem := ih (by omega) (q⁻¹ * p) hnext
    have hall := golayTwoGeneratorSubgroup.mul_mem hq hrem
    simpa only [mul_inv_cancel_left] using hall

/-- The two verified physical permutations generate the full actual Golay automorphism group. -/
theorem golayTwoGeneratorSubgroup_eq_top : golayTwoGeneratorSubgroup = ⊤ := by
  ext p
  constructor
  · intro _; trivial
  · intro _
    apply golayStabilizer_mem_twoGenerators 7 (by omega) p
    intro j hj
    omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
