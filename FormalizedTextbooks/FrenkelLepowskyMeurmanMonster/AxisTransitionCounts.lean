    (v : Fin 12 → ℚ)
    (hbalance : monsterAxisTransitionMatrix *ᵥ v = (16584750 : ℚ) • v)
    (hanchor : v 0 = 196560) : v = monsterAxisCountVector :=
  transition_count_unique monsterAxisTransitionMatrix monsterAxisTransitionInverse
    16584750 monsterAxisTransition_left_inverse v monsterAxisCountVector hbalance
    monsterAxisCountVector_balance hanchor

