/-- Literal inverse-coordinate tables for the four verified monomial words. -/
def generatedFourthFlagFramesCountInverse : Fin 4 → Fin 24 → Fin 24 :=
  ![![21, 14, 17, 3, 6, 5, 4, 10, 8, 9, 7, 11, 12, 22, 1, 16, 15, 2, 18, 23, 20, 0, 13, 19],
    ![3, 1, 2, 0, 4, 6, 5, 7, 11, 9, 10, 8, 12, 14, 13, 15, 22, 20, 23, 21, 17, 19, 16, 18],
    ![0, 12, 22, 19, 4, 9, 7, 6, 8, 5, 10, 11, 1, 13, 20, 16, 15, 17, 23, 3, 14, 21, 2, 18],
    ![1, 0, 3, 2, 4, 5, 6, 7, 11, 10, 9, 8, 14, 15, 12, 13, 16, 17, 18, 19, 21, 20, 23, 22]]

/-- Integer numerators of twice each permitted physical generator action. -/
def generatedFourthFlagFramesCountStep (k : Fin 16) (x : Fin 24 → ℤ) : Fin 24 → ℤ :=
  if h : k.val < 4 then fun i => 2 * x (generatedFourthFlagFramesCountInverse ⟨k.val, h⟩ i)
  else if h' : k.val < 15 then
    fun i => 2 * golayIntegerSign (generatedFourthMonomialSignCode ⟨k.val - 4, by omega⟩).val x i
  else golayIntegerSign monsterSourceY82SignCode.val
    (fun i => (co1XiNumerator *ᵥ golayIntegerSign monsterSourceY82SignCode.val x)
      (generatedFourthFlagCorrectionCoordinates i))

