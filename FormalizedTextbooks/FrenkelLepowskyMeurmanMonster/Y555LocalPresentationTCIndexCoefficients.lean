/-- Every actual proposed edge coefficient uses only genuine E7 source or prefix letters. -/
theorem y322TCIndexCoefficient_allowed (i : Fin 3159) (g : Fin 8) :
    y322TCIndexE7WordAllowed (y322TCIndexEdgeAt i g).coefficient := by
  let index := i.val * 8 + g.val
  have hi : index < 25272 := by dsimp [index]; omega
  let block : Fin 99 := ⟨index / 256, by omega⟩
  let offset : Fin 256 := ⟨index % 256, Nat.mod_lt _ (by decide)⟩
  have h := y322TCIndexCoefficientAllowedBlock block offset
  have he : block.val * 256 + offset.val = index := by
    dsimp [block, offset]
    omega
  rw [he] at h
  simp only [y322TCIndexCoefficientAllowedAt, dite_eq_left hi] at h
  have hl : (⟨index / 8, by omega⟩ : Fin 3159) = i := by
    apply Fin.ext
    dsimp [index]
    omega
  have hr : (⟨index % 8, Nat.mod_lt _ (by decide)⟩ : Fin 8) = g := by
    apply Fin.ext
    dsimp [index]
    omega
  simpa only [hl, hr] using h

/-- The exact bound-checked signed coefficient word of a finite table edge. -/
def y322TCIndexCoefficientWord (i : Fin 3159) (g : Fin 8) : List (Fin 48648 × Bool) :=
  y322RawEquationWordDecode 48648 (y322TCIndexEdgeAt i g).coefficient
    (y322TCIndexE7WordAllowed_alphabet _ (y322TCIndexCoefficient_allowed i g))

/-- The coefficient is an actual element of the original E7 parabolic subgroup. -/
theorem y322TCIndexCoefficientWord_mem (i : Fin 3159) (g : Fin 8) :
    y322EquationWordValue (y322FiniteAuxiliaryValue y322TransportProgram)
      (y322TCIndexCoefficientWord i g) ∈ y322E7Parabolic := by
  exact y322TCIndexE7DecodedWord_mem _ (y322TCIndexCoefficient_allowed i g)

