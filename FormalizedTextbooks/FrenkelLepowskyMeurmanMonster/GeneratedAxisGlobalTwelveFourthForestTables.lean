/-- Explicit singularity test: even parity of the paired hyperbolic coordinate bits. -/
def generatedAxisGlobalTwelveFourthSingular (b : ℕ) : Bool :=
  Nat.beq (Nat.mod (Nat.shiftRight generatedAxisGlobalTwelveFourthParityTable
    (Nat.mod (Nat.land b (Nat.shiftRight b 12)) 4096)) 2) 0

set_option maxHeartbeats 20000000 in
-- Check the parity table on all 4096 twelve-bit inputs, split by their high nibble.
/-- The parity table agrees with the direct parity of all twelve-bit inputs. -/
theorem generatedAxisGlobalTwelveFourthParityTable_certificate : ∀ x : Fin 4096,
    generatedAxisGlobalParityTwelve x.val =
      Nat.beq (Nat.mod (Nat.shiftRight generatedAxisGlobalTwelveFourthParityTable x.val) 2) 0 := by
  have h : ∀ a : Fin 16, ∀ c : Fin 256,
      generatedAxisGlobalParityTwelve (256 * a.val + c.val) =
        Nat.beq (Nat.mod (Nat.shiftRight generatedAxisGlobalTwelveFourthParityTable
          (256 * a.val + c.val)) 2) 0 := by
    decide +kernel
  intro x
  have hx : x.val / 256 < 16 := by have := x.isLt; omega
  have he : 256 * (x.val / 256) + x.val % 256 = x.val := by omega
  have hc := h ⟨x.val / 256, hx⟩ ⟨x.val % 256, Nat.mod_lt _ (by decide)⟩
  simp only [he] at hc
  exact hc

/-- The explicit test is exactly the genuine hyperbolic singularity test. -/
theorem generatedAxisGlobalTwelveFourthSingular_eq (b : ℕ) :
    generatedAxisGlobalTwelveFourthSingular b = generatedAxisGlobalMaskSingular b := by
  rw [generatedAxisGlobalMaskSingular_parity, generatedAxisGlobalParityTwelve_mod,
    generatedAxisGlobalTwelveFourthParityTable_certificate
      ⟨(b &&& (b >>> 12)) % 4096, Nat.mod_lt _ (by decide)⟩]
  rfl

