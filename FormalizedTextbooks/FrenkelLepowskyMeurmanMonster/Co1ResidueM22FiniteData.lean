/-- The exact distant graph predicate computed from the actual pair and hexad masks. -/
def co1ResidueM22FiniteDistant (i j : Fin 231) : Bool :=
  let a := co1ResidueM22FinitePointMasks i
  let b := co1ResidueM22FinitePointMasks j
  (a &&& b == 0) && !(List.finRange 77).any (fun h =>
    ((a ||| b) &&& co1ResidueM22FiniteHexadMasks h == (a ||| b)))

