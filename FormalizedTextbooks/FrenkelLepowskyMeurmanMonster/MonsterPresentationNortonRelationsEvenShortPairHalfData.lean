/-- Every physical pair is displayed in the actual increasing coordinate order. -/
theorem monsterNortonPairHalfPair_lt (k : Fin 12) (i : Fin 8) :
    monsterNortonPairHalfPairFirst k i < monsterNortonPairHalfPairSecond k i := by
  revert k i
  decide +kernel

/-- The eight displayed physical pairs are distinct. -/
theorem monsterNortonPairHalfPair_eq_iff (k : Fin 12) (i j : Fin 8) :
    monsterNortonPairHalfPairFirst k i = monsterNortonPairHalfPairFirst k j ∧
      monsterNortonPairHalfPairSecond k i = monsterNortonPairHalfPairSecond k j ↔ i = j := by
  revert k i j
  decide +kernel

/-- Each displayed octad code is a genuine weight-eight Golay codeword. -/
theorem monsterNortonPairHalfOctad_weight (k : Fin 12) (d : Fin 14) :
    golayMaskWeight (golayEncodedMask (monsterNortonPairHalfOctadCode k d).val) = 8 := by
  revert k d
  decide +kernel

/-- The fourteen source octad codes are pairwise distinct. -/
theorem monsterNortonPairHalfOctad_eq_iff (k : Fin 12) (d f : Fin 14) :
    monsterNortonPairHalfOctadCode k d = monsterNortonPairHalfOctadCode k f ↔ d = f := by
  revert k d f
  decide +kernel

set_option maxHeartbeats 32000000 in
-- Check all finite within-block label comparisons.
/-- Every block uses sixteen distinct original even-sign labels. -/
theorem monsterNortonPairHalfOctadSign_eq_iff (k : Fin 12) (d : Fin 14) (e f : Fin 16) :
    monsterNortonPairHalfOctadSign k d e = monsterNortonPairHalfOctadSign k d f ↔ e = f := by
  revert k d e f
  decide +kernel

/-- Every A coefficient has its exact integer square one. -/
theorem monsterNortonPairHalfPairCoefficient_sq (k : Fin 12) (i : Fin 8) :
    monsterNortonPairHalfPairCoefficient k i ^ 2 = 1 := by
  revert k i
  decide +kernel

/-- Every supported octad coefficient has its exact integer square one. -/
theorem monsterNortonPairHalfOctadCoefficient_sq (k : Fin 12) (d : Fin 14) (e : Fin 16) :
    monsterNortonPairHalfOctadCoefficient k d e ^ 2 = 1 := by
  revert k d e
  decide +kernel

/-- Every supported C coefficient has its exact integer square one. -/
theorem monsterNortonPairHalfPairCCoefficient_sq (k : Fin 12) (i : Fin 8) :
    monsterNortonPairHalfPairCCoefficient k i ^ 2 = 1 := by
  revert k i
  decide +kernel

