set_option maxHeartbeats 30000000 in
-- Check the 576 source entries, each a sum of 24 integer products.
/-- The displayed numerator is the exact inverse-permutation and xi source product. -/
theorem monsterNortonU_numerator_source : ∀ i : Fin 24, ∀ j : Fin 24,
    monsterNortonUNumerator1 i j = monsterSourceY82Physical i i *
      ∑ k : Fin 24, co1XiNumerator (omegaOrbitPermForward 0 i) k *
