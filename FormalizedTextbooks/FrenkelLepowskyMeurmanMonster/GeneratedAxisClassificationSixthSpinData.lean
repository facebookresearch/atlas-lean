/-- The integral common magnitude at each stage, before division by Gaussian denominators. -/
def generatedSixthSpinMagnitude : Fin 9 → ℤ := ![1,1,2,2,2,2,8,8,32]

/-- Executable signed-coordinate data, separate from the original-operator certificates. -/
def generatedSixthSpinData (k : Fin 9) (n : Fin 4096) : ℤ :=
  if k = 0 then generatedSixthIntegerSpinInitial n
  else if (generatedSixthSpinStagePositiveMasks k ⟨n.val / 64, by omega⟩).testBit (n.val % 64) then
    generatedSixthSpinMagnitude k
  else if (generatedSixthSpinStageNegativeMasks k ⟨n.val / 64, by omega⟩).testBit (n.val % 64) then
    -generatedSixthSpinMagnitude k
  else 0

/-- The initial cached stage is the actual distinguished integer state. -/
theorem generatedSixth_spin_data_initial :
    ∀ n, generatedSixthSpinData 0 n = generatedSixthIntegerSpinInitial n := by
  intro n
  simp only [generatedSixthSpinData, ite_true]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
