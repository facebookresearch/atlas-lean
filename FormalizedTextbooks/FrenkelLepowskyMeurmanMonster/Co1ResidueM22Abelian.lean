module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22Commutator
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22AbelianCoordinates
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22QuadraticExpansion
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueClassTwoQuadratic

/-! Abelianity of every group generated by the original actual auxiliary M22 hexad geometry. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped commutatorElement
set_option backward.isDefEq.respectTransparency false

/-- The original auxiliary M22 point images commute in every generated square-and-line
representation. The eleven-coordinate reduction and all sixty-six quadratic coefficients
are proved from the actual Golay hexads; no module classification is assumed. -/
theorem co1ResidueM22_representation_pairwise_commute {G : Type*} [Group G]
    (phi : Co1ResidueM22Point 0 1 → G) (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s * phi t * phi u = 1)
    (hgen : Subgroup.closure (Set.range phi) = ⊤) : ∀ s t, Commute (phi s) (phi t) := by
  obtain ⟨hcenter, hfinite, hcard⟩ :=
    co1ResidueM22_representation_commutator_bound phi hsquare hline hgen
  let : Finite (commutator G) := hfinite
  let : Module (ZMod 2) (Additive (Abelianization G)) :=
    co1ResidueClassTwoAbelianModule phi hsquare hgen
  let psi : Co1ResidueM22Point 0 1 → Additive (Abelianization G) :=
    fun s => Additive.ofMul (Abelianization.of (phi s))
  have hl : ∀ s t u, co1ResidueM22Line 0 1 s t u → psi s + psi t + psi u = 0 := by
    intro s t u hstu
    change Additive.ofMul (Abelianization.of (phi s)) +
      Additive.ofMul (Abelianization.of (phi t)) +
      Additive.ofMul (Abelianization.of (phi u)) = 0
    rw [← ofMul_mul, ← ofMul_mul, ← map_mul, ← map_mul, hline s t u hstu, map_one]
    rfl
  let E := co1ResidueM22AbelianCoordinates psi
  let f := E.toAddMonoidHom
  let c : Fin 231 → (Fin 11 → ZMod 2) :=
    fun i => monsterCo1GeometryBinaryMaskDecode (co1ResidueM22LinearCoordinates i)
  have hi (i : Fin 231) : Abelianization.of (phi (co1ResidueM22FinitePoint i)) =
      (f (c i)).toMul := by
    have he := co1ResidueM22AbelianCoordinates_point psi hl i
    exact (congrArg Additive.toMul he).symm
  let Q := co1ResidueClassTwoQuadratic hcard hcenter f
  have hQ : Q = 0 := co1ResidueM22QuadraticMap_zero Q (fun i =>
    co1ResidueClassTwoQuadratic_of_involution hcard hcenter f (c i)
      (phi (co1ResidueM22FinitePoint i)) (hi i) (hsquare _))
  have hsq (v : Fin 11 → ZMod 2) : co1ResidueClassTwoSquareCoefficient f v = 0 :=
    DFunLike.congr_fun hQ v
  have hp (v w : Fin 11 → ZMod 2) : co1ResidueClassTwoPairing f v w = 0 := by
    have he := co1ResidueClassTwoSquareCoefficient_add hcard hcenter f w v
    simpa only [hsq, zero_add] using he.symm
  intro s t
  obtain ⟨i, rfl⟩ := co1ResidueM22FinitePoint_surjective s
  obtain ⟨j, rfl⟩ := co1ResidueM22FinitePoint_surjective t
  have hc : co1ResidueSmallGroupCoefficient
      (co1ResidueClassTwoCommutator (phi (co1ResidueM22FinitePoint i))
        (phi (co1ResidueM22FinitePoint j))) = 0 := by
    have he := hp (c i) (c j)
    unfold co1ResidueClassTwoPairing at he
    rw [co1ResidueClassTwoBinaryCommutator_image hcenter f (c i) (c j)
      (phi (co1ResidueM22FinitePoint i)) (phi (co1ResidueM22FinitePoint j)) (hi i) (hi j)] at he
    exact he
  have he : co1ResidueClassTwoCommutator (phi (co1ResidueM22FinitePoint i))
      (phi (co1ResidueM22FinitePoint j)) = 1 :=
    co1ResidueSmallGroupHom_injective hcard (by
      change co1ResidueSmallGroupCoefficient _ = co1ResidueSmallGroupCoefficient (1 : commutator G)
      rw [co1ResidueSmallGroupCoefficient_one]
      exact hc)
  exact commutatorElement_eq_one_iff_commute.mp (congrArg Subtype.val he)

/-- Every group generated by point involutions satisfying the original auxiliary M22
hexad-line products is abelian. -/
theorem co1ResidueM22_representation_abelian {G : Type*} [Group G]
    (phi : Co1ResidueM22Point 0 1 → G) (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s * phi t * phi u = 1)
    (hgen : Subgroup.closure (Set.range phi) = ⊤) : IsMulCommutative G := by
  have hp := co1ResidueM22_representation_pairwise_commute phi hsquare hline hgen
  have hc : IsMulCommutative (Subgroup.closure (Set.range phi)) := by
    apply Subgroup.isMulCommutative_closure
    rintro _ ⟨s, rfl⟩ _ ⟨t, rfl⟩ _
    exact hp s t
  rw [hgen] at hc
  apply IsMulCommutative.of_comm
  intro x y
  exact congrArg Subtype.val (hc.is_comm.comm (⟨x, Subgroup.mem_top x⟩ : (⊤ : Subgroup G))
    (⟨y, Subgroup.mem_top y⟩ : (⊤ : Subgroup G)))

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
