/-- Decode a full original generator image, retaining its genuine central sign. -/
def generatedNinthLowerSpinPrimitiveQGenerator (l : GeneratedNinthLowerSpinLetter)
    (j : Fin 24) : Q :=
  let n : Fin 30 := ⟨2 * l.1.val + if l.2 then 1 else 0, by split_ifs <;> omega⟩
  ⟨ofAdd (Fin.append (golayLabelCoefficients (generatedNinthLowerSpinPrimitiveQLabels n j).1)
    (golayLabelCoefficients (generatedNinthLowerSpinPrimitiveQLabels n j).2.1)),
    ofAdd (generatedNinthLowerSpinPrimitiveQLabels n j).2.2⟩

/-- Exact ordered generator-image evaluation of a full signed primitive Q action. -/
def generatedNinthLowerSpinPrimitiveQEvaluation (l : GeneratedNinthLowerSpinLetter) (q : Q) :
    Q := monsterNortonCoordinateEvaluation (generatedNinthLowerSpinPrimitiveQGenerator l) q

/-- Exact chronological evaluation of every original signed source Q letter. -/
def generatedNinthLowerSpinSourceQEvaluation (i : Fin 11) (q : Q) : Q :=
  (generatedNinthLowerSpinSourceWord i).foldr generatedNinthLowerSpinPrimitiveQEvaluation q

