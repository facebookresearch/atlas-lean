/-- Actual source addresses select four consecutive genuine catalogue-bound octad families. -/
def generatedSixthXiOctadBlock001Input (a : Fin 256) : GeneratedSixthXiShortAddress :=
  Sum.inr (Sum.inl (⟨1 + a.val / 64, by omega⟩, ⟨a.val % 64, by omega⟩))

set_option maxHeartbeats 96000000 in
-- Check every original binary coordinate, full central phase and signed coefficient numerator.
/-- All candidate outputs agree with the genuine original binary image and full signed value. -/
theorem generatedSixth_xi_octad_block001_certificate (a : Fin 256) :
    let x := generatedSixthXiOctadBlock001Input a
    let y := generatedSixthXiOctadBlock001Output a
    sixthFrameOrbitMaskApply (sixthFrameOrbitColumns 14) (generatedSixthXiShortAddressMask x) =
      generatedSixthXiShortAddressMask y ∧
    nortonUIntegerSign (generatedSixthXiFastMaskPhase (generatedSixthXiShortAddressMask x)) *
      generatedSixthXiShortAddressNumerator x = generatedSixthXiShortAddressNumerator y := by
  revert a
  decide +kernel

/-- The actual corrected Xi fixes all checked original output coordinates, including their signs. -/
theorem generatedSixth_xi_octad_block001_fixed (a : Fin 256) :
    localShortOperator (generatedSixthCorrectedGenerator 4)
        (griessConwayEncode generatedSixthAxis).2.1
        (generatedSixthXiShortAddressIndex (generatedSixthXiOctadBlock001Output a)) =
      (griessConwayEncode generatedSixthAxis).2.1
        (generatedSixthXiShortAddressIndex (generatedSixthXiOctadBlock001Output a)) :=
  generatedSixth_xi_short_address_fixed _ _
    (generatedSixth_xi_octad_block001_certificate a).1
    (generatedSixth_xi_octad_block001_certificate a).2

