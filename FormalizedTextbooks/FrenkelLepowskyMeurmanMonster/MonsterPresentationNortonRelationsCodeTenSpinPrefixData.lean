/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeTenSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeTenSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeTenSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeTenSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeTenSpinPrefixDense_support (i : Fin 64) :
    monsterNortonCodeTenSpinPrefixDense (monsterNortonCodeTenSpinPrefixLabel i) =
      monsterNortonCodeTenSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeTenSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeTenSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 63, monsterNortonCodeTenSpinPrefixLabel i.castSucc <
      monsterNortonCodeTenSpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude one. -/
theorem monsterNortonCodeTenSpinPrefixCoefficient_sq (i : Fin 64) :
    monsterNortonCodeTenSpinPrefixCoefficient i ^ 2 = 1 := by
  revert i
  decide +kernel

