module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LeechRootedA2ThreePointData

/-! Three already bound physical permutations generate the full actual
three-point Mathieu subgroup. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false

private def permutationLinear (p : Equiv.Perm (Fin 24)) :
    (Fin 24 → ZMod 2) →ₗ[ZMod 2] (Fin 24 → ZMod 2) where
  toFun := golayPermute p
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private theorem permutation_mem_of_generator_images (p : Equiv.Perm (Fin 24))
    (hp : ∀ j, golayPermute p (fun i => (golayGeneratorBit j i : ZMod 2)) ∈ golayCode)
    (c : Fin 24 → ZMod 2) (hc : c ∈ golayCode) : golayPermute p c ∈ golayCode := by
  obtain ⟨a, rfl⟩ := hc
  have ha : a = ∑ j, a j • (Pi.single j 1 : Fin 12 → ZMod 2) := by
    ext i
    simp [Pi.single_apply]
  change (permutationLinear p).comp golayEncoder a ∈ golayCode
  rw [ha, map_sum]
  apply golayCode.sum_mem
  intro j _
  rw [map_smul]
  apply golayCode.smul_mem
  have hrow : golayEncoder (Pi.single j 1) = fun i => (golayGeneratorBit j i : ZMod 2) := by
    ext i
    simp [golayEncoder, Pi.single_apply, ite_mul]
  change golayPermute p (golayEncoder (Pi.single j 1)) ∈ golayCode
  rw [hrow]
  exact hp j

/-- The three source physical permutations are genuine automorphisms of the original Golay code. -/
def leechRootedA2ThreePointAutomorphism (j : Fin 3) : golayAutomorphismSubgroup :=
  ⟨leechRootedA2ThreePointPermutation j, by
    intro c
    constructor
    · intro hc
      apply permutation_mem_of_generator_images _ ?_ c hc
      intro k
      rw [(leechRootedA2ThreePoint_code_certificate j k).1]
      exact ⟨_, rfl⟩
    · intro hc
      have h := permutation_mem_of_generator_images
        (leechRootedA2ThreePointPermutation j).symm (fun k => ?_) _ hc
      · change golayPermute (leechRootedA2ThreePointPermutation j)⁻¹
          (golayPermute (leechRootedA2ThreePointPermutation j) c) ∈ golayCode at h
        rw [golayPermute_inv] at h
        exact h
      · rw [(leechRootedA2ThreePoint_code_certificate j k).2]
        exact ⟨_, rfl⟩⟩

/-- The actual subgroup generated by these three source automorphisms. -/
def leechRootedA2ThreePointSubgroup : Subgroup golayAutomorphismSubgroup :=
  Subgroup.closure (Set.range leechRootedA2ThreePointAutomorphism)

/-- Actual signed letters of the three-generator subgroup. -/
def leechRootedA2ThreePointLetter (t : Fin 6) : golayAutomorphismSubgroup :=
  if h : t.val < 3 then leechRootedA2ThreePointAutomorphism ⟨t.val, h⟩
  else (leechRootedA2ThreePointAutomorphism ⟨t.val - 3, by omega⟩)⁻¹

private theorem letter_apply (t : Fin 6) (i : Fin 24) :
    (leechRootedA2ThreePointLetter t).val i = leechRootedA2ThreePointLetterArray t i := by
  unfold leechRootedA2ThreePointLetter leechRootedA2ThreePointLetterArray
  split_ifs <;> rfl

private theorem word_apply (w : List (Fin 6)) (i : Fin 24) :
    ((w.map leechRootedA2ThreePointLetter).prod).val i =
      leechRootedA2ThreePointWordArray w i := by
  induction w generalizing i with
  | nil => rfl
  | cons t w ih =>
    change (leechRootedA2ThreePointLetter t).val
      (((w.map leechRootedA2ThreePointLetter).prod).val i) = _
    rw [letter_apply, ih]
    rfl

/-- The three source generators generate each original three-point strong generator. -/
theorem leechRootedA2ThreePoint_strong_mem (j : Fin 9) :
    golayStrongAutomorphism (leechRootedA2ThreePointStrongIndex j) ∈
      leechRootedA2ThreePointSubgroup := by
  have h : ((leechRootedA2ThreePointStrongWords j).map
      leechRootedA2ThreePointLetter).prod =
      golayStrongAutomorphism (leechRootedA2ThreePointStrongIndex j) := by
    apply Subtype.ext
    apply Equiv.ext
    intro i
    rw [word_apply, leechRootedA2ThreePoint_word_certificate,
      leechRootedA2StrongAutomorphism_apply]
  rw [← h]
  apply leechRootedA2ThreePointSubgroup.list_prod_mem
  intro g hg
  obtain ⟨t, _, rfl⟩ := List.mem_map.mp hg
  unfold leechRootedA2ThreePointLetter
  split_ifs
  · exact Subgroup.subset_closure ⟨_, rfl⟩
  · exact leechRootedA2ThreePointSubgroup.inv_mem (Subgroup.subset_closure ⟨_, rfl⟩)

/-- These three actual source permutations generate the complete genuine three-point stabilizer. -/
theorem leechRootedA2ThreePointSubgroup_eq :
    leechRootedA2ThreePointSubgroup = golayPointStabilizer 3 := by
  apply le_antisymm
  · rw [leechRootedA2ThreePointSubgroup, Subgroup.closure_le]
    rintro p ⟨j, rfl⟩ k hk
    change leechRootedA2ThreePointPermutation j (golayBasePoints k) = golayBasePoints k
    have h : ∀ j : Fin 3, ∀ k : Fin 7, k.val < 3 →
        leechRootedA2ThreePointPermutation j (golayBasePoints k) = golayBasePoints k := by
      decide +kernel
    exact h j k hk
  · rw [← leechRootedA2ThreePointStrongSubgroup_eq,
      leechRootedA2ThreePointStrongSubgroup, Subgroup.closure_le]
    rintro p ⟨j, rfl⟩
    exact leechRootedA2ThreePoint_strong_mem j

/-- Each selected genuine source full fiber projects to its actual permutation isometry. -/
theorem leechRootedA2ThreePoint_fiber_spatial (j : Fin 3) :
    (representativePermutationFiber (leechRootedA2ThreePointRepresentative j)).val.2 =
      golayPermutationIsometry (leechRootedA2ThreePointAutomorphism j) := by
  apply Subtype.ext
  exact representativePermutationLeech_certificate (leechRootedA2ThreePointRepresentative j)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
