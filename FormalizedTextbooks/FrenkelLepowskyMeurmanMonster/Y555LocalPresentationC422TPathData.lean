  /-- The exact first global path index in this interval. -/
  offset : ℕ
  /-- The exact number of paths, retaining the shorter final interval. -/
  size : ℕ
  /-- Literal natural-number parent and generator indices before finite decoding. -/
  raw : Fin size → ℕ × ℕ
  allowed : ∀ j, (offset + j.val = 0 ∨ (raw j).1 < offset + j.val) ∧ (raw j).2 < 9

