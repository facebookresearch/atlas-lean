/-- The interval starts are the exact quotient offsets. -/
theorem y422TPathChunk_offset (b : Fin 71) : (y422TPathChunk b).offset = b.val * 128 := by
  revert b
  decide +kernel

/-- The final interval has exactly seventy-three entries. -/
theorem y422TPathChunk_size (b : Fin 71) :
    (y422TPathChunk b).size = if b.val < 70 then 128 else 73 := by
  revert b
  decide +kernel

/-- The exact interval containing a source-path index. -/
def y422TPathBlock (i : Fin 9033) : Fin 71 := ⟨i.val / 128, by omega⟩

/-- The exact remainder is inside the actual interval, including its shorter final tail. -/
theorem y422TPathLocal_bound (i : Fin 9033) :
    i.val % 128 < (y422TPathChunk (y422TPathBlock i)).size := by
  rw [y422TPathChunk_size]
  unfold y422TPathBlock
  split_ifs <;> dsimp only at * <;> omega

/-- Raw source-path indices assembled without finite-index reduction. -/
def y422TPathRawData (i : Fin 9033) : ℕ × ℕ :=
  (y422TPathChunk (y422TPathBlock i)).raw ⟨i.val % 128, y422TPathLocal_bound i⟩

/-- The assembled data retain the actual strict parent and source-generator bounds. -/
theorem y422TPathRawData_allowed (i : Fin 9033) :
    (i.val = 0 ∨ (y422TPathRawData i).1 < i.val) ∧ (y422TPathRawData i).2 < 9 := by
  have h := (y422TPathChunk (y422TPathBlock i)).allowed
    ⟨i.val % 128, y422TPathLocal_bound i⟩
  have he : (y422TPathChunk (y422TPathBlock i)).offset + i.val % 128 = i.val := by
    rw [y422TPathChunk_offset]
    unfold y422TPathBlock
    dsimp only
    omega
  simpa only [he, y422TPathRawData, Fin.val_mk] using h

/-- Exact source letters are decoded only after their natural-number bound is proved. -/
def y422TPathData (i : Fin 9033) : ℕ × Fin 9 :=
  ((y422TPathRawData i).1, ⟨(y422TPathRawData i).2, (y422TPathRawData_allowed i).2⟩)

/-- Every noninitial path refers to a strictly earlier path. -/
theorem y422TPathData_prior (i : Fin 9033) (hi : i ≠ 0) :
    (y422TPathData i).1 < i.val := by
  rcases (y422TPathRawData_allowed i).1 with h | h
  · exact (hi (Fin.ext h)).elim
  · exact h

/-- The initial raw path is the exact empty-root marker. -/
theorem y422TPathRawData_zero : y422TPathRawData 0 = (0, 0) := by decide +kernel

/-- The initial decoded path retains its exact root marker and source letter. -/
theorem y422TPathData_zero : y422TPathData 0 = (0, 0) := by
  apply Prod.ext
  · change (y422TPathRawData 0).1 = 0
    exact congrArg Prod.fst y422TPathRawData_zero
  · apply Fin.ext
    exact congrArg Prod.snd y422TPathRawData_zero

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
