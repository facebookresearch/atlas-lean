/- Thirteen actual nonterminal generators generate the original independent Y555 group. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationTerminalIdentity
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationNonterminalWords

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Every original defining generator belongs to the subgroup of thirteen nonterminal sources. -/
theorem y555Generator_mem_nonterminal (v : Y555Vertex) :
    (PresentedGroup.of v : BimonsterPresentation) ∈ y555NonterminalSubgroup := by
  cases v with
  | none => exact y555NonterminalSource_mem 0
  | some p =>
    rcases p with ⟨i, k⟩
    by_cases h : k = 4
    · subst k
      rw [y555Terminal_eq_longest]
      exact y555LocalLongest_mem_nonterminal i
    · obtain ⟨j, hj⟩ := y555NonterminalSource_arm i k h
      rw [← hj]
      exact y555NonterminalSource_mem j

/-- The original independent Y555 group is genuinely generated by these thirteen vertices. -/
theorem y555NonterminalSubgroup_eq_top : y555NonterminalSubgroup = ⊤ := by
  apply top_unique
  intro x _
  exact PresentedGroup.generated_by y555Relations y555NonterminalSubgroup
    y555Generator_mem_nonterminal x

/-- Actual homomorphisms from Y555 are determined by the thirteen original nonterminal sources. -/
theorem y555Hom_ext_nonterminal {M : Type*} [Group M]
    (f g : BimonsterPresentation →* M)
    (h : ∀ i, f (PresentedGroup.of (y555NonterminalSource i)) =
      g (PresentedGroup.of (y555NonterminalSource i))) : f = g := by
  have he : y555NonterminalSubgroup ≤ f.eqLocus g := by
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨i, rfl⟩
    exact h i
  rw [y555NonterminalSubgroup_eq_top] at he
  apply MonoidHom.ext
  intro x
  exact he (Subgroup.mem_top x)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
