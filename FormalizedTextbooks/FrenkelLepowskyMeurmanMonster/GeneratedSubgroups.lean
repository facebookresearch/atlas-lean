/-
Verified embeddings in the generated group. These establish nontriviality
without assuming the finiteness, order, or simplicity milestones.
-/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LocalStructure
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.LocalExactness

@[expose] public section

namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The local action takes its values in the subgroup generated by that action. -/
noncomputable def localIntoGenerated : H →* ↥G where
  toFun h := ⟨rhoLocal h, Subgroup.subset_closure (Or.inl ⟨h, rfl⟩)⟩
  map_one' := Subtype.ext rhoLocal.map_one
  map_mul' h k := Subtype.ext (rhoLocal.map_mul h k)

theorem localIntoGenerated_injective : Function.Injective localIntoGenerated := by
  intro h k hk
  apply rhoLocal_injective
  exact congrArg Subtype.val hk

/-- The concrete extraspecial group embeds in the generated group. -/
noncomputable def qIntoGenerated : Q →* ↥G := localIntoGenerated.comp inclQ

theorem qIntoGenerated_injective : Function.Injective qIntoGenerated :=
  localIntoGenerated_injective.comp inclQ_injective

theorem qCentralInvolution_ne_one : qCentralInvolution ≠ 1 := by
  intro h
  have hc := congrArg (fun q : Q => Multiplicative.toAdd q.coeff) h
  exact (by decide : (1 : ZMod 2) ≠ 0) hc

/-- The generated group is nontrivial independently of any endpoint proof. -/
theorem generated_group_nontrivial : Nontrivial ↥G := by
  refine ⟨⟨qIntoGenerated qCentralInvolution, 1, ?_⟩⟩
  intro h
  apply qCentralInvolution_ne_one
  apply qIntoGenerated_injective
  exact h.trans qIntoGenerated.map_one.symm

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
