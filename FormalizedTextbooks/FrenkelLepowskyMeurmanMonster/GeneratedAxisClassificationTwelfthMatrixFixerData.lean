/-- Either orientation retains the entire true original physical generator matrix. -/
def generatedTwelfthMatrixFixerLetterTwice (l : Fin 18 × Bool) :
    Matrix (Fin 8) (Fin 8) ℤ :=
  if l.2 then (generatedTwelfthSectionGeneratorTwice l.1).transpose
  else generatedTwelfthSectionGeneratorTwice l.1

/-- Every actual finite prefix begins with the genuine identity frame. -/
theorem generatedTwelfth_matrix_fixer_state_zero : ∀ g : Fin 3,
    generatedTwelfthMatrixFixerState g 0 = (2 : ℕ) • 1 := by
  decide +kernel

/-- Each full integer frame calculation follows the original letter and all 64 entries. -/
theorem generatedTwelfth_matrix_fixer_state_step : ∀ (g : Fin 3) (k : Fin 13),
    generatedTwelfthMatrixFixerLetterTwice (generatedTwelfthMatrixFixerLetter g k) *
        generatedTwelfthMatrixFixerState g (Fin.castLE (by decide : 13 ≤ 14) k) =
      (2 : ℕ) • generatedTwelfthMatrixFixerState g ⟨k.val + 1, by omega⟩ := by
  decide +kernel

/-- All original section letters have orthogonal full denominator-two frames. -/
theorem generatedTwelfth_matrix_fixer_letter_orthogonal : ∀ g : Fin 18,
    generatedTwelfthSectionGeneratorTwice g * (generatedTwelfthSectionGeneratorTwice g).transpose =
      (4 : ℕ) • 1 := by
  decide +kernel

/-- All three complete physical frames fix the actual entire golden-matrix base. -/
theorem generatedTwelfth_matrix_fixer_state_congruence : ∀ g : Fin 3,
    generatedTwelfthMatrixFixerState g 13 * generatedTwelfthGoldenMatrixState 18197 *
        (generatedTwelfthMatrixFixerState g 13).transpose =
      (4 : ℕ) • generatedTwelfthGoldenMatrixState 18197 := by
  decide +kernel

