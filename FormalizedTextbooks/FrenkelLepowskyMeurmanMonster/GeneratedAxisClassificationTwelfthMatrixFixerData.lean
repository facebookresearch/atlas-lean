/-- Every original prefix word, with all inverses retained. -/
def generatedTwelfthMatrixFixerPrefix (g : Fin 3) : ℕ → List (Fin 18 × Bool)
  | 0 => []
  | k + 1 => if h : k < 13 then
      generatedTwelfthMatrixFixerLetter g ⟨k, h⟩ :: generatedTwelfthMatrixFixerPrefix g k
    else generatedTwelfthMatrixFixerPrefix g k

/-- The complete prefix calculation is exactly the entire original source word. -/
theorem generatedTwelfth_matrix_fixer_prefix_word : ∀ g : Fin 3,
    generatedTwelfthMatrixFixerPrefix g 13 = generatedTwelfthMatrixFixerWord g := by
  decide +kernel

