/- Exact affine-family labels and common plane; tensor identification is proved separately. -/
module
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisFourthQAffineFamilyCard
@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The exact twenty-two distinct affine basepoint labels, with reference label 1333 first. -/
def generatedAxisFourthQAffineParameterBaseLabels : Fin 22 → Fin 4096 :=
  ![1333, 1329, 1331, 1335, 1024, 1028, 1540, 1542, 1794, 1796, 1591,
    1587, 1585, 1589, 1073, 1079, 1075, 1077, 1843, 1841, 1847, 1845]

/-- The exact characters attached to those twenty-two affine spin states. -/
def generatedAxisFourthQAffineParameterCharacterLabels : Fin 22 → Fin 4096 :=
  ![2048, 2048, 2048, 2048, 2050, 2050, 2050, 2050, 2050, 2050, 2048,
    2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048]

/-- The actual binary spin basepoints represented by the declared literal labels. -/
def generatedAxisFourthQAffineParameterBases (j : Fin 22) : SpinIndex :=
  golayLabelCoefficients (generatedAxisFourthQAffineParameterBaseLabels j)

/-- The actual binary spin characters represented by the declared literal labels. -/
def generatedAxisFourthQAffineParameterCharacters (j : Fin 22) : SpinIndex :=
  golayLabelCoefficients (generatedAxisFourthQAffineParameterCharacterLabels j)

/-- The common affine plane generated by binary labels 14 and 2048. -/
def generatedAxisFourthQAffineParameterPlane : Submodule (ZMod 2) SpinIndex :=
  Submodule.span (ZMod 2) ({golayLabelCoefficients 14, golayLabelCoefficients 2048} : Set SpinIndex)

private theorem parameter_plane_first : golayLabelCoefficients 14 (1 : Fin 12) = 1 := by
  decide +kernel
private theorem parameter_plane_first_other :
    golayLabelCoefficients 2048 (1 : Fin 12) = 0 := by decide +kernel
private theorem parameter_plane_last : golayLabelCoefficients 2048 (11 : Fin 12) = 1 := by
  decide +kernel
private theorem parameter_plane_last_other :
    golayLabelCoefficients 14 (11 : Fin 12) = 0 := by decide +kernel

/-- The two coordinate readings recover the coefficients of every vector in the common plane. -/
theorem generatedAxisFourthQAffineParameter_plane_mem_iff (u : SpinIndex) :
    u ∈ generatedAxisFourthQAffineParameterPlane ↔
      u = u 1 • golayLabelCoefficients 14 + u 11 • golayLabelCoefficients 2048 := by
  constructor
  · intro hu
    obtain ⟨α, β, he⟩ := Submodule.mem_span_pair.mp hu
    have hα := congrFun he (1 : Fin 12)
    have hβ := congrFun he (11 : Fin 12)
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, parameter_plane_first,
      parameter_plane_first_other, mul_one, mul_zero, add_zero] at hα
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, parameter_plane_last,
      parameter_plane_last_other, mul_one, mul_zero, zero_add] at hβ
    rw [hα, hβ] at he
    exact he.symm
  · intro hu
    exact Submodule.mem_span_pair.mpr ⟨u 1, u 11, hu.symm⟩

/-- Label 14 belongs to the actual common binary plane. -/
theorem generatedAxisFourthQAffineParameter_plane_first_mem :
    golayLabelCoefficients 14 ∈ generatedAxisFourthQAffineParameterPlane := by
  exact Submodule.mem_span_pair.mpr ⟨1, 0, by simp⟩

/-- Label 2048 belongs to the actual common binary plane. -/
theorem generatedAxisFourthQAffineParameter_plane_last_mem :
    golayLabelCoefficients 2048 ∈ generatedAxisFourthQAffineParameterPlane := by
  exact Submodule.mem_span_pair.mpr ⟨0, 1, by simp⟩

/-- The common binary plane consists of exactly the four displayed vectors. -/
theorem generatedAxisFourthQAffineParameter_plane_mem_four_iff (u : SpinIndex) :
    u ∈ generatedAxisFourthQAffineParameterPlane ↔
      u = 0 ∨ u = golayLabelCoefficients 14 ∨ u = golayLabelCoefficients 2048 ∨
        u = golayLabelCoefficients 14 + golayLabelCoefficients 2048 := by
  constructor
  · intro hu
    obtain ⟨α, β, he⟩ := Submodule.mem_span_pair.mp hu
    have hc (c : ZMod 2) : c = 0 ∨ c = 1 := by
      fin_cases c
      · exact Or.inl rfl
      · exact Or.inr rfl
    rcases hc α with rfl | rfl <;> rcases hc β with rfl | rfl
    all_goals simp only [zero_smul, one_smul, zero_add, add_zero] at he
    all_goals aesop
  · rintro (rfl | rfl | rfl | rfl)
    · exact generatedAxisFourthQAffineParameterPlane.zero_mem
    · exact generatedAxisFourthQAffineParameter_plane_first_mem
    · exact generatedAxisFourthQAffineParameter_plane_last_mem
    · exact generatedAxisFourthQAffineParameterPlane.add_mem
        generatedAxisFourthQAffineParameter_plane_first_mem
        generatedAxisFourthQAffineParameter_plane_last_mem

/-- The binary dot product is linear in a scalar multiple of its right input. -/
theorem generatedAxisFourthQAffineParameter_dot_smul_right
    (m u : SpinIndex) (c : ZMod 2) : spinDot m (c • u) = c * spinDot m u := by
  change (∑ i, m i * (c * u i)) = c * ∑ i, m i * u i
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  ring

/-- Annihilating the common plane is equivalent to the two basis-annihilator equations. -/
theorem generatedAxisFourthQAffineParameter_plane_annihilator_iff (m : SpinIndex) :
    (∀ u ∈ generatedAxisFourthQAffineParameterPlane, spinDot m u = 0) ↔
      spinDot m (golayLabelCoefficients 14) = 0 ∧
        spinDot m (golayLabelCoefficients 2048) = 0 := by
  constructor
  · intro h
    exact ⟨h _ generatedAxisFourthQAffineParameter_plane_first_mem,
      h _ generatedAxisFourthQAffineParameter_plane_last_mem⟩
  · rintro ⟨h14, h2048⟩ u hu
    rw [(generatedAxisFourthQAffineParameter_plane_mem_iff u).mp hu,
      spinDot_add_right, generatedAxisFourthQAffineParameter_dot_smul_right,
      generatedAxisFourthQAffineParameter_dot_smul_right, h14, h2048, mul_zero, mul_zero,
      add_zero]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
