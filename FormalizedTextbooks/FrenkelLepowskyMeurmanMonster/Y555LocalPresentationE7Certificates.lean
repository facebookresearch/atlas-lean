/-- Actual checked square, commutation, and braid moves in one reduction batch. -/
def y322E7SquareMoves (i : Fin 38) : List Y322CoxeterMove :=
  (y322E7SquarePackedMoves i).map y322PackedCoxeterMove

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
-- The finite replay unfolds 64 moves on words of length at most 126.
/-- Every explicit batch replays successfully against the genuine local Coxeter diagram. -/
theorem y322E7Square_replay (i : Fin 38) :
    y322CoxeterRun (y322E7SquareMoves i) (y322E7SquareWord i.castSucc) =
      some (y322E7SquareWord i.succ) := by
  fin_cases i <;> decide +kernel

/-- The first literal certificate word is exactly the square of the corrected source word. -/
theorem y322E7Square_start :
    y322E7SquareWord 0 =
      (List.replicate 9 ([0, 1, 4, 6, 2, 5, 3] : List (Fin 8))).flatten ++
        (List.replicate 9 ([0, 1, 4, 6, 2, 5, 3] : List (Fin 8))).flatten := by
  decide +kernel

/-- The final literal certificate word is empty. -/
theorem y322E7Square_end : y322E7SquareWord (Fin.last 38) = [] := by
  decide +kernel

/-- Evaluation of repeated positive words is the corresponding power. -/
theorem y322PositiveWord_replicate (w : List (Fin 8)) (n : ℕ) :
    y322PositiveWord (List.replicate n w).flatten = y322PositiveWord w ^ n := by
  induction n with
  | zero => simp [y322PositiveWord]
  | succ n ih =>
    simp only [List.replicate_succ, List.flatten_cons, y322PositiveWord_append, ih]
    exact (pow_succ' _ n).symm

/-- The exact corrected F12 word is an involution in the independent local presentation. -/
theorem y322E7Word12_square :
    (PresentedGroup.mk y322Relations y322E7Word12) ^ 2 = 1 := by
  have hchain (i : Fin 39) :
      y322PositiveWord (y322E7SquareWord i) = y322PositiveWord (y322E7SquareWord 0) := by
    induction i using Fin.induction with
    | zero => rfl
    | succ i ih =>
      exact (y322CoxeterRun_valid (y322E7SquareMoves i)
        (y322E7SquareWord i.castSucc) (y322E7SquareWord i.succ)
          (y322E7Square_replay i)).symm.trans ih
  have h := (hchain (Fin.last 38)).symm
  rw [y322E7Square_start, y322E7Square_end, y322PositiveWord_append,
    y322PositiveWord_replicate] at h
  simpa [y322E7Word12, y322PositiveWord, map_pow, map_mul, PresentedGroup.of,
    pow_two, mul_assoc] using h

