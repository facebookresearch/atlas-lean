def generatedRootEightMathieuReducedShortPacket (g : Fin 4) (r : GriessShortIndex) : ℕ :=
  let a := generatedNinthLowerSpinShortAddress r
  (generatedNinthLowerSpinShortWord (generatedRootEightMathieuReducedShortWords g) a /
    2 ^ (18 * (a.val % 16))) % 2 ^ 18

/-- The candidate preferred image in the original three-family catalogue. -/
def generatedRootEightMathieuReducedShortDestination (g : Fin 4) (r : GriessShortIndex) : GriessShortIndex :=
  generatedNinthLowerSpinShortIndex (Fin.ofNat 98280 (generatedRootEightMathieuReducedShortPacket g r % 2 ^ 17))

/-- The candidate complete preferred-Q central phase. -/
def generatedRootEightMathieuReducedShortPhase (g : Fin 4) (r : GriessShortIndex) : ZMod 2 :=
  golayBooleanCast ((generatedRootEightMathieuReducedShortPacket g r).testBit 17)

/-- The four actual full local fibers, with their explicit original Q corrections. -/
