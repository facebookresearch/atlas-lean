/-- Exact complete unit images before finite metadata certification. -/
def generatedRootEightMathieuReducedShortUnitImage (g : Fin 4) (k : Fin 24) : Q :=
  if g.val < 2 then
    generatedRootEightMathieuReducedTensorQImage (Fin.ofNat 2 g.val) (qCoordinateGenerator k)
  else
    let j := Fin.ofNat 2 (g.val - 2)
    generatedRootEightMoverMateCorrection j *
      generatedRootEightCompactBasisImage (if g.val = 2 then 10 else 11) k *
        (generatedRootEightMoverMateCorrection j)⁻¹

/-- Every cached unit is the genuine complete corrected extraspecial image. -/
theorem generatedRootEight_mathieu_reduced_short_units (g : Fin 4) (k : Fin 24) :
    spinConjugation (generatedRootEightMathieuReducedShortFiber g).val.1 (qCoordinateGenerator k) =
      generatedRootEightMathieuReducedShortUnitImage g k := by
  fin_cases g
  · change spinConjugation (generatedRootEightMathieuReducedCertifiedFiber 0).val.1
      (qCoordinateGenerator k) = generatedRootEightMathieuReducedTensorQImage 0 (qCoordinateGenerator k)
    rw [← generatedRootEight_mathieu_reduced_tensor_full_Q,
      generatedRootEight_mathieu_reduced_tensor_conjugation]
  · change spinConjugation (generatedRootEightMathieuReducedCertifiedFiber 1).val.1
      (qCoordinateGenerator k) = generatedRootEightMathieuReducedTensorQImage 1 (qCoordinateGenerator k)
    rw [← generatedRootEight_mathieu_reduced_tensor_full_Q,
      generatedRootEight_mathieu_reduced_tensor_conjugation]
  · change spinConjugation generatedRootEightMoverCorrectedFiber.val.1 (qCoordinateGenerator k) =
      generatedRootEightMoverMateCorrection 0 * generatedRootEightCompactBasisImage 10 k *
        (generatedRootEightMoverMateCorrection 0)⁻¹
    rw [generatedRootEight_mover_corrected_spin, map_mul, MulAut.mul_apply,
      spinConjugation_incl, generatedRootEight_compact_conjugation,
      generatedRootEight_compact_q_basis_10]
  · change spinConjugation generatedRootEightMateCorrectedFiber.val.1 (qCoordinateGenerator k) =
      generatedRootEightMoverMateCorrection 1 * generatedRootEightCompactBasisImage 11 k *
        (generatedRootEightMoverMateCorrection 1)⁻¹
    rw [generatedRootEight_mate_corrected_spin, map_mul, MulAut.mul_apply,
      spinConjugation_incl, generatedRootEight_compact_conjugation,
