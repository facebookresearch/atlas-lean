/- Actual nonterminal source words and their cyclic generated-subgroup inclusions. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationTerminalHom

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The thirteen original vertices obtained by omitting the three terminal vertices. -/
def y555NonterminalSource : Fin 13 → Y555Vertex :=
  ![none, some (0, 0), some (0, 1), some (0, 2), some (0, 3),
    some (1, 0), some (1, 1), some (1, 2), some (1, 3),
    some (2, 0), some (2, 1), some (2, 2), some (2, 3)]

/-- Exact subgroup generated by those thirteen original source generators. -/
def y555NonterminalSubgroup : Subgroup BimonsterPresentation :=
  Subgroup.closure (Set.range fun i =>
    (PresentedGroup.of (y555NonterminalSource i) : BimonsterPresentation))

/-- An indexed original nonterminal generator lies in its actual generated subgroup. -/
theorem y555NonterminalSource_mem (i : Fin 13) :
    (PresentedGroup.of (y555NonterminalSource i) : BimonsterPresentation) ∈
      y555NonterminalSubgroup := Subgroup.subset_closure ⟨i, rfl⟩

/-- Every indexed source remains indexed after the actual cyclic vertex permutation. -/
theorem y555NonterminalSource_cycle (i : Fin 13) :
    ∃ j, y555NonterminalSource j = y555VertexCycle (y555NonterminalSource i) := by
  revert i
  decide +kernel

/-- The genuine cyclic source homomorphism preserves this actual generated subgroup. -/
theorem y555NonterminalSubgroup_cycle :
    Subgroup.map y555CycleHom y555NonterminalSubgroup ≤ y555NonterminalSubgroup := by
  rw [y555NonterminalSubgroup, MonoidHom.map_closure]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨y, ⟨i, rfl⟩, rfl⟩
  rw [y555CycleHom_generator]
  obtain ⟨j, hj⟩ := y555NonterminalSource_cycle i
  rw [← hj]
  exact y555NonterminalSource_mem j

/-- Every letter of the first literal longest-word spelling is one of these thirteen vertices. -/
theorem y555NonterminalSource_F1_letters :
    ∀ i ∈ y555LocalF1Support12, ∃ j, y555NonterminalSource j = y322Vertex i := by
  decide +kernel

/-- The genuine first corrected longest word belongs to the actual nonterminal subgroup. -/
theorem y555LocalF1_mem_nonterminal : y555LocalF1 ∈ y555NonterminalSubgroup := by
  rw [y555LocalF1_word12]
  apply Subgroup.pow_mem
  unfold y555LocalRestrictedWord
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
  obtain ⟨j, hj⟩ := y555NonterminalSource_F1_letters i hi
  rw [← hj]
  exact y555NonterminalSource_mem j

/-- The actual second corrected longest word is a cyclic image inside this subgroup. -/
theorem y555LocalF2_mem_nonterminal : y555LocalF2 ∈ y555NonterminalSubgroup :=
  y555NonterminalSubgroup_cycle ⟨y555LocalF1, y555LocalF1_mem_nonterminal, rfl⟩

/-- The actual third corrected longest word is the next cyclic image inside this subgroup. -/
theorem y555LocalF3_mem_nonterminal : y555LocalF3 ∈ y555NonterminalSubgroup :=
  y555NonterminalSubgroup_cycle ⟨y555LocalF2, y555LocalF2_mem_nonterminal, rfl⟩

/-- Every corrected terminal spelling belongs to the actual nonterminal subgroup. -/
theorem y555LocalLongest_mem_nonterminal (i : Fin 3) :
    y555LocalLongest i ∈ y555NonterminalSubgroup := by
  fin_cases i
  · exact y555LocalF1_mem_nonterminal
  · exact y555LocalF2_mem_nonterminal
  · exact y555LocalF3_mem_nonterminal

/-- Every original nonterminal arm position occurs among the thirteen source vertices. -/
theorem y555NonterminalSource_arm (i : Fin 3) (k : Fin 5) (hk : k ≠ 4) :
    ∃ j, y555NonterminalSource j = some (i, k) := by
  revert i k
  decide +kernel


end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
