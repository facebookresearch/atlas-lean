-- Finite check of the bounds of every row operation.
theorem rootEightForestStageOps_valid (s : ℕ) :
    ∀ ops ∈ rootEightForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
  have h : ∀ s < 5, ∀ ops ∈ rootEightForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
    decide +kernel
  by_cases hs : s < 5
  · exact h s hs
  · have : rootEightForestStageOps s = [] := by
      match s, hs with
      | n + 5, _ => rfl
    simp [this]

theorem rootEightForestStart_testBit (b : ℕ) :
    rootEightForestStart.testBit b = decide (b ∈ rootEightForestRoots) :=
  tenthForestOfList_testBit _ b

