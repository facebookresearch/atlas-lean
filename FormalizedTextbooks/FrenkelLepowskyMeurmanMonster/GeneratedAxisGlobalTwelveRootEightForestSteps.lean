-- The roots are bounded masks.
theorem rootEightForestRoots_lt : ∀ m ∈ rootEightForestRoots, m < 16777216 := by decide +kernel

theorem rootEightForestStart_bounded : TenthForestBounded rootEightForestStart := by
  intro b hb
  rw [rootEightForestStart_testBit]
  simp only [decide_eq_false_iff_not]
  intro hm
  have := rootEightForestRoots_lt b hm
  omega

