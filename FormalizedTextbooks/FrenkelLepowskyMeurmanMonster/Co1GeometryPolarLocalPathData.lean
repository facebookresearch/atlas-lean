/-- Complete final binary vectors of the transported original base endpoints. -/
def monsterCo1PolarLocalEdgeBaseMasks : Fin 9 → ℕ :=
  ![8450048, 8388624, 8450048, 8388640, 8450048, 13430784, 8450048, 13142024, 10534912]

/-- Complete final binary vectors of the transported original tetrad endpoints. -/
def monsterCo1PolarLocalEdgeTipMasks : Fin 9 → ℕ :=
  ![8975423, 8975423, 9175071, 9175071, 8962051, 8962051, 13142024, 13241688, 13241688]

/-- The literal original Conway word of each line transporter. -/
def monsterCo1PolarLocalEdgeWord (e : Fin 9) : Co1 :=
  monsterCo1PolarLocalWord ((monsterCo1PolarLocalEdgeTrace e).map Prod.fst)

set_option maxHeartbeats 12000000 in
-- Nine words, at most 29 letters, with two complete 24-bit source actions per letter.
/-- Every recorded step is the whole genuine binary generator action on both line endpoints. -/
theorem monsterCo1PolarLocalEdgeTrace_certificate : ∀ e : Fin 9,
    monsterCo1PolarLocalTrace 2048
      ((monsterCo1PolarLocalEdgeTrace e).map fun s => (s.1, s.2.1)) ∧
    monsterCo1PolarLocalTrace 4194304
      ((monsterCo1PolarLocalEdgeTrace e).map fun s => (s.1, s.2.2)) := by
  decide +kernel

/-- Each source trace ends at its complete literal endpoint vector. -/
theorem monsterCo1PolarLocalEdgeTrace_final : ∀ e : Fin 9,
    ((monsterCo1PolarLocalEdgeTrace e).map fun s => (s.1, s.2.1)).foldl
      (fun _ s => s.2) 2048 = monsterCo1PolarLocalEdgeBaseMasks e ∧
    ((monsterCo1PolarLocalEdgeTrace e).map fun s => (s.1, s.2.2)).foldl
      (fun _ s => s.2) 4194304 = monsterCo1PolarLocalEdgeTipMasks e := by
  decide +kernel

