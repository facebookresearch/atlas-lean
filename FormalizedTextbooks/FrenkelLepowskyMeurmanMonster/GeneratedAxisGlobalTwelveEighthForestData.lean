set_option maxRecDepth 100000 in
-- Finite check of the bounds of every row operation.
/-- Every row operation of every stage is a valid coordinate flip. -/
theorem eighthForestStageOps_valid (s : ℕ) :
    ∀ ops ∈ eighthForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
  have h : ∀ s < 5, ∀ ops ∈ eighthForestStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
    decide +kernel
  by_cases hs : s < 5
  · exact h s hs
  · have : eighthForestStageOps s = [] := by
      match s, hs with
      | n + 5, _ => rfl
    simp [this]

/-- The start set consists exactly of the roots. -/
theorem eighthForestStart_testBit (b : ℕ) :
    eighthForestStart.testBit b = decide (b ∈ eighthForestRoots) :=
  tenthForestOfList_testBit _ b

set_option maxRecDepth 100000 in
-- The roots are bounded masks.
/-- Every root is a 24-bit mask. -/
theorem eighthForestRoots_lt : ∀ m ∈ eighthForestRoots, m < 16777216 := by decide +kernel

/-- The start set has only positions below `2 ^ 24`. -/
theorem eighthForestStart_bounded : TenthForestBounded eighthForestStart := by
  intro b hb
  rw [eighthForestStart_testBit]
  simp only [decide_eq_false_iff_not]
  intro hm
  have := eighthForestRoots_lt b hm
  omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
