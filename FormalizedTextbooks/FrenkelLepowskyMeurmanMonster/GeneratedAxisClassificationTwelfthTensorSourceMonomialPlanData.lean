/-- The two entire checked original source plans. -/
def generatedTwelfthTensorSourceMonomialPlan : Fin 2 → RepresentativeSpinPlan (Fin 2 × Bool) :=
  ![generatedTwelfthTensorSourceMonomialPlan00, generatedTwelfthTensorSourceMonomialPlan01]

/-- The literal original monomial words, in actual product order. -/
def generatedTwelfthTensorSourceMonomialWord (k : Fin 2) : List (Fin 2 × Bool) :=
  (generatedTwelfthTensorSourceMonomialPlan k).map Prod.fst

/-- The complete final signed coordinate model for each original source stretch. -/
def generatedTwelfthTensorSourceMonomialModel (k : Fin 2) : RepresentativeSpinModel :=
  representativeSpinPlanEnd representativeSpinIdentityModel
    (generatedTwelfthTensorSourceMonomialPlan k)

/-- Each new finite plan is bound to the actual original root-nine source word. -/
theorem generatedTwelfth_tensor_source_monomial_word (k : Fin 2) :
    generatedTwelfthTensorSourceMonomialWord k =
      generatedAxisGlobalFifthShortNormalizationWords 9 (Fin.castLE (by decide) k) := by
  fin_cases k <;> rfl

