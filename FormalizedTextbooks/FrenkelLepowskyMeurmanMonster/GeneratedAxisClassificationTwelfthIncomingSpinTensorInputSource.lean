/-- All full input coordinates retain their actual eight canonical source factors. -/
theorem generatedTwelfth_incoming_tensor_input_sparse : ∀ (n : Fin 4096) (j : Fin 24),
    generatedTwelfthIncomingSpinTensorInputInteger n j =
      16 * ∑ r : Fin 8, generatedTwelfthTensorSourceInitialSparseSpin r n *
        generatedTwelfthTensorSourceSpatial r j := by
  intro n j
  fin_cases j
  · exact column_00 n
  · exact column_01 n
  · exact column_02 n
  · exact column_03 n
  · exact column_04 n
  · exact column_05 n
  · exact column_06 n
  · exact column_07 n
  · exact column_08 n
  · exact column_09 n
  · exact column_10 n
  · exact column_11 n
  · exact column_12 n
  · exact column_13 n
  · exact column_14 n
  · exact column_15 n
  · exact column_16 n
  · exact column_17 n
  · exact column_18 n
  · exact column_19 n
  · exact column_20 n
  · exact column_21 n
  · exact column_22 n
  · exact column_23 n

/-- The complete original integer tensor is the sparse canonical input divided by sixteen. -/
theorem generatedTwelfth_incoming_tensor_input_integer (n : Fin 4096) (j : Fin 24) :
    generatedTwelfthIncomingSpinTensorInputInteger n j =
      16 * generatedAxisGlobalFifthTensorInteger n j := by
  rw [generatedTwelfth_incoming_tensor_input_sparse,
    generatedTwelfth_tensor_source_integer_decomposition]
  congr 1
  apply Finset.sum_congr rfl
  intro r _
  rw [generatedTwelfth_tensor_source_spin_small_actual,
    generatedTwelfth_tensor_source_spin_fast_actual,
    generatedTwelfth_tensor_source_initial_sparse_actual]

/-- Every canonical input entry is exactly sixteen square root two times the actual Fifth tensor. -/
theorem generatedTwelfth_incoming_tensor_input_actual (t : SpinIndex) (j : Fin 24) :
    16 * Real.sqrt 2 * (griessConwayEncode generatedFifthAxis).2.2 t j =
      (generatedTwelfthIncomingSpinTensorInputInteger (nortonUIntegerLabel t) j : ℝ) := by
  rw [generatedTwelfth_incoming_tensor_input_integer, Int.cast_mul, Int.cast_ofNat]
  have h := generatedAxisGlobalFifthTensorInteger_coefficient (nortonUIntegerLabel t) j
  rw [nortonUIntegerLabel_inverse] at h
  rw [← h]
  ring

