/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeTwentySpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeTwentySpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeTwentySpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeTwentySpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeTwentySpinPrefixDense_support (i : Fin 16) :
    monsterNortonCodeTwentySpinPrefixDense (monsterNortonCodeTwentySpinPrefixLabel i) =
      monsterNortonCodeTwentySpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeTwentySpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeTwentySpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 15, monsterNortonCodeTwentySpinPrefixLabel i.castSucc <
      monsterNortonCodeTwentySpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude one. -/
theorem monsterNortonCodeTwentySpinPrefixCoefficient_sq (i : Fin 16) :
    monsterNortonCodeTwentySpinPrefixCoefficient i ^ 2 = 4 := by
