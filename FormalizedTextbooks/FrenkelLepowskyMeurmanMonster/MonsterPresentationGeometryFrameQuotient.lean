/- The genuine source-local central quotient and its natural map to the actual binary module. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationGeometryFrameProjection
public import Mathlib.GroupTheory.Subgroup.Center

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open Multiplicative
set_option backward.isDefEq.respectTransparency false

/-- The original distinguished generator is central in the verified source-local subgroup. -/
theorem monsterGeometryFrameSourceCentral_mem_center :
    monsterGeometryFrameSourceCentral ∈ Subgroup.center monsterGeometryFrameLocalSubgroup := by
  apply Subgroup.mem_center_iff.mpr
  intro x
  apply Subtype.ext
  exact Subgroup.mem_centralizer_singleton_iff.mp
    (monsterGeometryFrame_local_centralizes_base x.property)

/-- The original source-local distinguished generator has exact order two. -/
theorem monsterGeometryFrameSourceCentral_order :
    orderOf monsterGeometryFrameSourceCentral = 2 := by
  apply orderOf_eq_prime
  · apply Subtype.ext
    exact monsterGeometryPresentation_point_square monsterGeometryBasePoint
  · intro h
    apply qCentralInvolution_ne_one
    have he := congrArg monsterGeometryFrameIntoQ h
    simpa only [monsterGeometryFrameIntoQ_central, map_one] using he

/-- The actual central subgroup generated by the original source-local z generator. -/
def monsterGeometryFrameSourceZ : Subgroup monsterGeometryFrameLocalSubgroup :=
  Subgroup.zpowers monsterGeometryFrameSourceCentral

/-- The genuine source-local z subgroup lies in its center. -/
theorem monsterGeometryFrameSourceZ_le_center :
    monsterGeometryFrameSourceZ ≤ Subgroup.center monsterGeometryFrameLocalSubgroup :=
  Subgroup.zpowers_le.mpr monsterGeometryFrameSourceCentral_mem_center

/-- Normality of the original source-local central subgroup follows from proved centrality. -/
instance monsterGeometryFrameSourceZ_normal : monsterGeometryFrameSourceZ.Normal :=
  Subgroup.normal_of_le_center monsterGeometryFrameSourceZ_le_center

/-- The actual source-local z subgroup has two elements. -/
theorem monsterGeometryFrameSourceZ_card : Nat.card monsterGeometryFrameSourceZ = 2 := by
  exact (Nat.card_zpowers _).trans monsterGeometryFrameSourceCentral_order

/-- The natural binary homomorphism on the verified source-local subgroup. -/
def monsterGeometryFrameIntoBinary :
    monsterGeometryFrameLocalSubgroup →* Multiplicative (Fin 24 → ZMod 2) :=
  qQuotHom.comp monsterGeometryFrameIntoQ

/-- The original central subgroup is killed by the literal source-local binary projection. -/
theorem monsterGeometryFrameSourceZ_le_binary_ker :
    monsterGeometryFrameSourceZ ≤ monsterGeometryFrameIntoBinary.ker := by
  apply Subgroup.zpowers_le.mpr
  change qQuotHom (monsterGeometryFrameIntoQ monsterGeometryFrameSourceCentral) = 1
  rw [monsterGeometryFrameIntoQ_central]
  rfl

/-- The original source-local central quotient; its projection is not assumed injective. -/
abbrev MonsterGeometryFrameCentralQuotient :=
  monsterGeometryFrameLocalSubgroup ⧸ monsterGeometryFrameSourceZ

/-- Natural binary projection on the genuine source-local central quotient. -/
def monsterGeometryFrameQuotientIntoBinary :
    MonsterGeometryFrameCentralQuotient →* Multiplicative (Fin 24 → ZMod 2) :=
  QuotientGroup.lift monsterGeometryFrameSourceZ monsterGeometryFrameIntoBinary
    monsterGeometryFrameSourceZ_le_binary_ker

/-- The genuine source-local central quotient maps onto the actual full binary module. -/
theorem monsterGeometryFrameQuotientIntoBinary_surjective :
    Function.Surjective monsterGeometryFrameQuotientIntoBinary := by
  intro v
  obtain ⟨q, hq⟩ := qQuotHom_surjective v
  obtain ⟨x, hx⟩ := monsterGeometryFrameIntoQ_surjective q
  refine ⟨QuotientGroup.mk' monsterGeometryFrameSourceZ x, ?_⟩
  change qQuotHom (monsterGeometryFrameIntoQ x) = v
  rw [hx, hq]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
