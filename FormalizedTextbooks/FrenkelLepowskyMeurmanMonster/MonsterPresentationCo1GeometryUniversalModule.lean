/- The independent source binary universal module uses precisely the genuine Conway lines. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationCo1GeometryLineAction
public import Mathlib.LinearAlgebra.Finsupp.Span
public import Mathlib.LinearAlgebra.Quotient.Basic

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The free binary module on the actual source norm-eight frame-class points. -/
abbrev MonsterCo1GeometryFreeModule := MonsterCo1GeometryPoint →₀ ZMod 2

/-- Exactly the original source line sums, with the genuine two-orbit line predicate. -/
def monsterCo1GeometryLineVectors : Set MonsterCo1GeometryFreeModule :=
  {v | ∃ p q r, monsterCo1GeometryLine p q r ∧
    v = Finsupp.single p 1 + Finsupp.single q 1 + Finsupp.single r 1}

/-- The linear relation submodule generated by all genuine source line sums. -/
def monsterCo1GeometryLineSubmodule : Submodule (ZMod 2) MonsterCo1GeometryFreeModule :=
  Submodule.span (ZMod 2) monsterCo1GeometryLineVectors

/-- The independently presented universal binary representation of the source Conway geometry.
See Ivanov–Shpectorov II §2.1 and §5.3. No dimension bound is included in this definition. -/
abbrev MonsterCo1GeometryUniversalModule :=
  MonsterCo1GeometryFreeModule ⧸ monsterCo1GeometryLineSubmodule

/-- The original point generators in the source universal binary module. -/
def monsterCo1GeometryUniversalPoint (p : MonsterCo1GeometryPoint) :
    MonsterCo1GeometryUniversalModule :=
  monsterCo1GeometryLineSubmodule.mkQ (Finsupp.single p 1)

/-- Every genuine original source line satisfies its defining relation in the universal module. -/
theorem monsterCo1GeometryUniversalPoint_line (p q r : MonsterCo1GeometryPoint)
    (h : monsterCo1GeometryLine p q r) :
    monsterCo1GeometryUniversalPoint p + monsterCo1GeometryUniversalPoint q +
      monsterCo1GeometryUniversalPoint r = 0 := by
  change monsterCo1GeometryLineSubmodule.mkQ (Finsupp.single p 1) +
    monsterCo1GeometryLineSubmodule.mkQ (Finsupp.single q 1) +
    monsterCo1GeometryLineSubmodule.mkQ (Finsupp.single r 1) = 0
  rw [← map_add, ← map_add]
  exact Submodule.Quotient.mk_eq_zero _ |>.mpr
    (Submodule.subset_span ⟨p, q, r, h, rfl⟩)

/-- The original point generators span the entire independently presented universal module. -/
theorem monsterCo1GeometryUniversalPoint_span :
    Submodule.span (ZMod 2) (Set.range monsterCo1GeometryUniversalPoint) = ⊤ := by
  refine Submodule.eq_top_iff'.mpr ?_
  intro x
  obtain ⟨v, rfl⟩ := monsterCo1GeometryLineSubmodule.mkQ_surjective x
  induction v using Finsupp.induction_linear with
  | zero => exact Submodule.zero_mem _
  | add v w hv hw => simpa only [map_add] using Submodule.add_mem _ hv hw
  | single p a =>
      have hp : monsterCo1GeometryUniversalPoint p ∈
          Submodule.span (ZMod 2) (Set.range monsterCo1GeometryUniversalPoint) :=
        Submodule.subset_span ⟨p, rfl⟩
      rw [← Finsupp.smul_single_one, map_smul]
      exact Submodule.smul_mem (Submodule.span (ZMod 2)
          (Set.range monsterCo1GeometryUniversalPoint)) a hp

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
