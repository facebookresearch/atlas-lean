/-! ## Packed octad self sums of dense vectors -/

/-- The packed octad self sum with field width `w` (falls back to the collapsed sum); dense octad
blocks need a field width above `32`. -/
def selfOctPW (w : ℕ) (V : IdentVec) : ℤ :=
  if octPackOk w V then
    ((octLFlat V).map (fun p => p.2 * svalS w (packH w 10 16 (octLFlat V)) p.1)).sum
  else selfOctZ V

/-- The packed octad self sum is the collapsed octad self sum. -/
theorem selfOctPW_eq (w : ℕ) (V : IdentVec) : selfOctPW w V = selfOctZ V := by
  unfold selfOctPW
  split_ifs with h
  · obtain ⟨h1, h2⟩ := octPackOk_spec w V h
    obtain ⟨_, a2⟩ := packH_spec w 10 16 (octLFlat V) h1 (by omega)
    unfold selfOctZ
    congr 1
    apply List.map_congr_left
    intro p hp
    rw [svalS_eq_sval, a2 p.1 (h1 p hp)]
  · rfl

