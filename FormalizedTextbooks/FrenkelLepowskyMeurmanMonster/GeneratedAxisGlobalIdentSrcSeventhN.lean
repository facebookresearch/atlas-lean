/-- The fields of the normalized source tensor at width `80` are below `2^13`. -/
theorem srcSeventhX0N_lt : colsLtB 80 13 (srcSeventhX0N 80) = true := by decide +kernel

/-- Tight bounds of the normalized packed Seventh source tensor at width `80`. -/
theorem srcSeventhX0N_bnd : TBnd 80 (2 ^ 13 - 1) (srcSeventhX0N 80) :=
  tbnd_tight 80 13 _ _ (srcSeventhX0N_bnd0 (by norm_num)) (by norm_num) srcSeventhX0N_lt

