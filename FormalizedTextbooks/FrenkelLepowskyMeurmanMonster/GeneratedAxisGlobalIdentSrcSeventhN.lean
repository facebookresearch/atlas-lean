theorem srcSeventhX0N_rat : tensorRat 80 (srcSeventhX0N 80) srcSeventhD0 =
    tensorRat 80 (srcSeventhX0F 80) srcSeventhD0 := by
  funext k i
  unfold tensorRat
  rw [sval_eq_of_cross (srcSeventhX0N_bnd i.val i.isLt)
    (srcSeventhX0F_bnd (w := 80) (by norm_num) i.val i.isLt) (by norm_num)
    (srcSeventhX0N_cross i.val i.isLt) k.val k.isLt]

