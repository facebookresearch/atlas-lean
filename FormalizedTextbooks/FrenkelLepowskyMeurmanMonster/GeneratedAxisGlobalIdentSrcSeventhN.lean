/-! # The Seventh source tensor in normalized packed form

The packed source tensor `srcSeventhX0F w` carries positive and negative parts that do not
cancel (their fields reach `2^14` while the net numerators stay below `2^13`), and evaluating it
in the kernel is the dominant cost of every identification on the Seventh source.  Here the net
numerators (over `srcSeventhD0`) are given as literal sparse columns, packed by the segmented
packer `packH`, and certified against `srcSeventhX0F 80` by one packed cross-sum check per column
(`srcSeventhX0N_cross`, `sval_eq_of_cross`).  `seventhSrcVecN` is the Seventh source vector with
this tensor block. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
namespace GeneratedAxisGlobalIdent
open GeneratedAxisGlobalTwelveTwelfthIdent
set_option autoImplicit false
set_option Elab.async false

/-- Two signed packed vectors with equal cross sums have equal fields. -/
theorem sval_eq_of_cross {w n B C : ℕ} {x y : SVec} (hx : SBnd w n B x) (hy : SBnd w n C y)
    (hBC : B + C < 2 ^ w) (h : x.1 + y.2 = y.1 + x.2) : ∀ i < n, sval w x i = sval w y i := by
  intro i hi
  have h1 := fld_add w n x.1 y.2 hx.1 hy.2.1 (fun j hj => by
    have := (hx.2.2 j hj).1; have := (hy.2.2 j hj).2; omega)
  have h2 := fld_add w n y.1 x.2 hy.1 hx.2.1 (fun j hj => by
    have := (hy.2.2 j hj).1; have := (hx.2.2 j hj).2; omega)
  have e : fld w (x.1 + y.2) i = fld w (y.1 + x.2) i := by rw [h]
  rw [h1.2 i hi, h2.2 i hi] at e
  simp only [sval]
  omega

/-- Packed columns from sparse columns: bounds. -/
theorem packCols_bnd (w B : ℕ) (cols : List (List (ℕ × ℤ)))
    (hc : cols.all (fun l => l.all (fun p => decide (p.1 < 4096)) && decide (absSum l ≤ B)) = true)
    (hB : B < 2 ^ w) : TBnd w B (cols.map (packH w 10 12)) := by
  intro i _
  have hd : tcol (cols.map (packH w 10 12)) i = packH w 10 12 (cols.getD i []) := by
    unfold tcol
    have h0 : (szero : SVec) = packH w 10 12 [] := rfl
    rw [h0, List.getD_map]
  rw [hd]
  by_cases hi : i < cols.length
  · have hm : cols.getD i [] ∈ cols := by
      rw [List.getD_eq_getElem _ _ hi]
      exact List.getElem_mem hi
    simp only [List.all_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hc
    obtain ⟨h1, h2⟩ := hc _ hm
    exact (packH_spec w 10 12 _ h1 (lt_of_le_of_lt h2 hB)).1.mono h2
  · rw [List.getD_eq_default _ _ (by omega)]
    exact SBnd_zero _ _ _

/-- Decode a packed sparse column: 28-bit fields of a 12-bit spin label and a 16-bit value with
offset `32768`. -/
def srcDecodeTC (v : ℕ) : ℕ → List (ℕ × ℤ)
  | 0 => []
  | n + 1 => ((v &&& 4095 : ℕ), (((v >>> 12) &&& 65535 : ℕ) : ℤ) - 32768) ::
      srcDecodeTC (v >>> 28) n

