/-- The sparse columns have spin labels below `4096` and absolute sums at most `844800`. -/
theorem srcSeventhX0cols_ok : srcSeventhX0cols.all (fun l =>
    l.all (fun p => decide (p.1 < 4096)) && decide (absSum l ≤ 844800)) = true := by
  decide +kernel

/-- Bounds of the normalized packed Seventh source tensor. -/
theorem srcSeventhX0N_bnd0 {w : ℕ} (hw : 20 ≤ w) : TBnd w 844800 (srcSeventhX0N w) :=
  packCols_bnd w 844800 _ srcSeventhX0cols_ok
    (lt_of_lt_of_le (by norm_num) (Nat.pow_le_pow_right (by norm_num) hw))

