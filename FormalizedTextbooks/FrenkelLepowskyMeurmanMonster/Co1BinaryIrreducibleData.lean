open scoped Matrix BigOperators

/-- Binary coordinate vector encoded by a natural-number mask. -/
def co1IrreducibleBitVector (n : ℕ) (i : Fin 24) : ZMod 2 :=
  if n.testBit i.val then 1 else 0

/-- Matrix encoded by its twenty-four binary row masks. -/
def co1IrreducibleBitMatrix (r : Fin 24 → ℕ) : Matrix (Fin 24) (Fin 24) (ZMod 2) :=
  fun i j => co1IrreducibleBitVector (r i) j

/-- The actual finite word used to construct the rank-one operator. -/
def co1IrreducibleWordLetters : Fin 12 → Fin 5 :=
  ![0, 1, 0, 4,
    3, 3, 3, 2,
    3, 4, 4, 2]

