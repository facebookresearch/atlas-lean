-- Check the 456 forward images of inverse columns and their exact bounded row encoding.
/-- All inverse columns and their indexed lists are checked against the genuine forward action. -/
theorem generatedAxisGlobalFifthInverse_certificate : ∀ k : Fin 19,
    (∀ j : Fin 24, generatedAxisGlobalFifthInverseColumns k j < 2 ^ 24 ∧
      generatedAxisGlobalMaskRowsAction (generatedAxisGlobalFifthBinaryRows k)
        (generatedAxisGlobalFifthInverseColumns k j) = 2 ^ j.val) ∧
    generatedAxisGlobalFifthInverseRows k =
      List.ofFn (fun j : Fin 24 => (j.val, generatedAxisGlobalFifthInverseColumns k j)) := by
  decide +kernel

