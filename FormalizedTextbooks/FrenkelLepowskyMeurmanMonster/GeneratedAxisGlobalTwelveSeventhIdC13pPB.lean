  rw [s7c13p_hn_n, selfOctP_eq, ← selfOctPW_eq 48, s7c13p_hn_s]
  show 1 / srcSeventhD0 * ((17874026496 : ℤ) : ℚ) / 8 = 1 / srcSeventhD0 * ((2234253312 : ℤ) : ℚ)
