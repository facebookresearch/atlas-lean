  rw [selfOctPW_eq_B 48 s7c13pW s7c13p_wok48]
  show selfOctB 48 s7c13pW (ShortData.ofList s7c13pGT).oct = _
  simp only [s7c13pGT, ofList_oct_append, selfOctB_append]
  linarith [s7c13p_hn_s0, s7c13p_hn_s1, s7c13p_hn_s2]

/-- The octad part equals the octad self part of the target. -/
