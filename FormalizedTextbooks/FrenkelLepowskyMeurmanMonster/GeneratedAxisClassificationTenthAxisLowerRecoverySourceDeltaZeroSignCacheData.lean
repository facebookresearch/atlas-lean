/-- All4096 signs, including every central/left-Pauli/inverse-coordinate/postquadratic bit. -/
def generatedTenthSourceDeltaZeroSignCache (n : Fin 4096) : ℤ :=
  let row : Fin 4 := ⟨n.val / 1024, by have h := n.isLt; omega⟩
  let column : Fin 4 := ⟨(n.val / 256) % 4, Nat.mod_lt _ (by decide)⟩
  if (generatedTenthSourceDeltaZeroSignCacheBlocks row column).testBit (n.val % 256) then
    -1 else 1

