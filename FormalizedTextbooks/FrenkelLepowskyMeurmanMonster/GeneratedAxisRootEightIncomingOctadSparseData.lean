/-- The actual original octad's sparse signed entries. -/
def generatedRootEightIncomingOctadSparseEntries (o : Fin 759) : List (Fin 64 × ℤ) :=
  generatedRootEightIncomingOctadSparseWords ⟨o.val / 256, by omega⟩
    ⟨o.val / 16 % 16, Nat.mod_lt _ (by decide)⟩
    ⟨o.val % 16, Nat.mod_lt _ (by decide)⟩

/-- The coefficient at a slot, adding every occurrence in the entry list. -/
def generatedRootEightSparseCoefficient : List (Fin 64 × ℤ) → Fin 64 → ℤ
  | [], _ => 0
  | e :: es, f => (if e.1 = f then e.2 else 0) + generatedRootEightSparseCoefficient es f

