/-- The original chronological address of each preferred short coordinate. -/
def generatedNinthLowerShortAddress : GriessShortIndex → ℕ
  | Sum.inl (s, p) => s.val * 276 + p.val
  | Sum.inr (Sum.inl (o, e)) => 552 + o.val * 64 + e.val
  | Sum.inr (Sum.inr (d, i)) => 49128 + d.val * 24 + i.val

/-- Distinct preferred short indices have distinct original chronological addresses. -/
theorem generatedNinth_lower_short_address_injective :
    Function.Injective generatedNinthLowerShortAddress := by
  rintro (⟨s, p⟩ | (⟨o, e⟩ | ⟨d, i⟩)) (⟨s', p'⟩ | (⟨o', e'⟩ | ⟨d', i'⟩)) h
  all_goals simp only [generatedNinthLowerShortAddress] at h
  · apply congrArg Sum.inl
    apply Prod.ext <;> apply Fin.ext <;> dsimp <;> omega
  · exfalso; omega
  · exfalso; omega
  · exfalso; omega
  · apply congrArg (Sum.inr ∘ Sum.inl)
    apply Prod.ext <;> apply Fin.ext <;> dsimp <;> omega
  · exfalso; omega
  · exfalso; omega
  · exfalso; omega
  · apply congrArg (Sum.inr ∘ Sum.inr)
    apply Prod.ext <;> apply Fin.ext <;> dsimp <;> omega

