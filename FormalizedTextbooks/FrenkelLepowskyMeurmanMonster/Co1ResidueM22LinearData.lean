/-- The free 231-bit sum of an original three-point line. -/
def co1ResidueM22LinearLineMask (l : Fin 1155) : Nat :=
  let t := co1ResidueM22LinearLines l
  (2 ^ t.1.val) ^^^ (2 ^ t.2.1.val) ^^^ (2 ^ t.2.2.val)

/-- The active selected basis addresses in a point's proposed binary coordinates. -/
def co1ResidueM22LinearBasisRow (i : Fin 231) : List (Fin 231) :=
  ((List.finRange 11).filter (fun k => (co1ResidueM22LinearCoordinates i).testBit k.val)).map
    co1ResidueM22LinearBasis

/-- The free binary mask of the selected basis combination. -/
def co1ResidueM22LinearBasisMask (i : Fin 231) : Nat :=
  monsterCo1GeometryBinaryMaskSum ((co1ResidueM22LinearBasisRow i).map (fun k => 2 ^ k.val))

