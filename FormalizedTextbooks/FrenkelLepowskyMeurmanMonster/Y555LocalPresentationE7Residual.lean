-- The kernel checks 64 elementary moves on literal words initially of length 572.
/-- Every explicit residual reduction batch replays against the genuine C322 diagram. -/
theorem y322E7Residual_replay (i : Fin 48) :
    y322CoxeterRun (y322E7ResidualMoves i) (y322E7ResidualWord i.castSucc) =
      some (y322E7ResidualWord i.succ) := by
  fin_cases i <;> decide +kernel

/-- This explicit 572-letter residual word is trivial in the independent local quotient. -/
theorem y322E7Residual_valid : y322PositiveWord (y322E7ResidualWord 0) = 1 := by
  have hchain (i : Fin 49) :
      y322PositiveWord (y322E7ResidualWord i) =
        y322PositiveWord (y322E7ResidualWord 0) := by
    induction i using Fin.induction with
    | zero => rfl
    | succ i ih =>
      exact (y322CoxeterRun_valid (y322E7ResidualMoves i)
        (y322E7ResidualWord i.castSucc) (y322E7ResidualWord i.succ)
          (y322E7Residual_replay i)).symm.trans ih
  have hend : y322E7ResidualWord (Fin.last 48) = [] := by decide +kernel
  have h := (hchain (Fin.last 48)).symm
  rw [hend] at h
  exact h

