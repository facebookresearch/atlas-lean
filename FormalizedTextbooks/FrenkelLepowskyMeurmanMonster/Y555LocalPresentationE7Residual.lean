/-- Actual elementary moves in an explicit residual reduction batch. -/
def y322E7ResidualMoves (i : Fin 48) : List Y322CoxeterMove :=
  (y322E7ResidualPackedMoves i).map y322PackedCoxeterMove

set_option maxRecDepth 10000 in
