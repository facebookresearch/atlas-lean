/- A genuine frame-generated subgroup of the independent Monster geometry representation. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationGeometryFrameIncidence

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open Multiplicative

/-- Original geometry generators whose actual extraspecial quotient is a genuine Conway frame. -/
def monsterGeometryFrameSourceGenerators : Set MonsterGeometryPresentation :=
  {x | ∃ p : MonsterCo1GeometryPoint, ∃ q : Q,
    ∃ hq : toAdd (qQuotHom q) = p.val,
      x = PresentedGroup.of (monsterGeometryFrameLiftPoint p q hq)}

/-- The independent source subgroup generated by z and all verified Conway-frame lifts.
This definition does not classify all source points incident with z. -/
def monsterGeometryFrameLocalSubgroup : Subgroup MonsterGeometryPresentation :=
  Subgroup.closure
    ({PresentedGroup.of monsterGeometryBasePoint} ∪ monsterGeometryFrameSourceGenerators)

/-- Genuine line equations force every frame generator to commute with the source z generator. -/
theorem monsterGeometryFrame_source_commute (p : MonsterCo1GeometryPoint) (q : Q)
    (hq : toAdd (qQuotHom q) = p.val) :
    Commute (PresentedGroup.of monsterGeometryBasePoint : MonsterGeometryPresentation)
      (PresentedGroup.of (monsterGeometryFrameLiftPoint p q hq)) := by
  have hl := monsterGeometryLine_cycle _ _ _ (monsterGeometryFrame_phase_line p q hq)
  exact (monsterGeometryPresentation_line_commute _ _ _ hl).symm

/-- Centrality of the source z generator holds on the entire frame-generated source subgroup. -/
theorem monsterGeometryFrame_local_centralizes_base :
    monsterGeometryFrameLocalSubgroup ≤
      Subgroup.centralizer {PresentedGroup.of monsterGeometryBasePoint} := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  rcases hx with hx | ⟨p, q, hq, rfl⟩
  · have he : x = PresentedGroup.of monsterGeometryBasePoint := hx
    rw [he]
  · exact (monsterGeometryFrame_source_commute p q hq).symm.eq

/-- The source base generator belongs to the explicit frame-generated subgroup. -/
theorem monsterGeometryFrame_local_base_mem :
    (PresentedGroup.of monsterGeometryBasePoint : MonsterGeometryPresentation) ∈
      monsterGeometryFrameLocalSubgroup :=
  Subgroup.subset_closure (Or.inl rfl)

/-- Every verified phase lift belongs to the explicit frame-generated source subgroup. -/
theorem monsterGeometryFrame_local_point_mem (p : MonsterCo1GeometryPoint) (q : Q)
    (hq : toAdd (qQuotHom q) = p.val) :
    (PresentedGroup.of (monsterGeometryFrameLiftPoint p q hq) : MonsterGeometryPresentation) ∈
      monsterGeometryFrameLocalSubgroup :=
  Subgroup.subset_closure (Or.inr ⟨p, q, hq, rfl⟩)

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
