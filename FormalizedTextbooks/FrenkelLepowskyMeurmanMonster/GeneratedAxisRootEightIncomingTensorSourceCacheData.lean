/-- Every original signed spin coefficient, including all zeros and the second-half signs. -/
def generatedRootEightIncomingTensorSourceCache (r : Fin 8) (k : Fin 4096) : ℤ :=
  if (generatedRootEightIncomingTensorSourceCachePositive r ⟨k.val / 64, by omega⟩).testBit
      (k.val % 64) then 1
  else if (generatedRootEightIncomingTensorSourceCacheNegative r ⟨k.val / 64, by omega⟩).testBit
      (k.val % 64) then -1 else 0

