/-- Every one of the 9720 transitions is bound literally to its exact chronological claim. -/
theorem y422CosetTargetWords_all (k : Fin 9720) : y422CosetTargetWords k := by
  let b : Fin 76 := ⟨k.val / 128, by omega⟩
  let j : Fin (if b.val < 75 then 128 else 120) := ⟨k.val % 128, by
    dsimp only [b]
    split_ifs <;> omega⟩
  have h := y422CosetTargets_chunk b j
  have he : (⟨128 * b.val + j.val, by
      have hj := j.isLt
      split_ifs at hj <;> omega⟩ : Fin 9720) = k := by
    apply Fin.ext
    dsimp only [b, j]
    omega
  rwa [he] at h

/-- All actual state/source pairs have both exact literal target sides. -/
theorem y422CosetTransitionWords_all (i : Fin 1080) (a : Fin 9) :
    y422CosetTransitionWords i a :=
  (y422CosetTargetWords_pair i a).mp (y422CosetTargetWords_all ⟨9 * i.val + a.val, by omega⟩)

