/-- Exact six-bit linear sign transport, with correctness supplied by physical certificates. -/
def generatedSixthMonomialOctadSourceSign (k : Fin 4) (f : Fin 231) (e : Fin 64) : Fin 64 :=
  Fin.ofNat 64 ((List.finRange 6).foldl (fun n b => n ^^^
    (if e.val.testBit b.val then (generatedSixthMonomialOctadSourceSignImage k f b).val else 0)) 0)

/-- Global physical sign needed to normalize the last source coordinate positive. -/
def generatedSixthMonomialOctadPhysicalSign (k : Fin 4) (f : Fin 231) (e : Fin 64) : ℤ :=
  if (trialityEvenMask e).testBit (generatedSixthMonomialOctadSourceLast k f).val then -1 else 1

/-- The original negative physical coordinate mask, evaluated through the literal eight rows. -/
def generatedSixthMonomialOctadNegativeMask (f : Fin 231) (e : Fin 64) : ℕ :=
  (List.finRange 8).foldr (fun a n =>
    (if (trialityEvenMask e).testBit a.val then
      2 ^ (generatedSixthMonomialOctadCoordinates f a).val else 0) ||| n) 0

/-- The exact negative-coordinate cocode vector for the original preferred octad. -/
def generatedSixthMonomialOctadNegativeInteger (f : Fin 231) (e : Fin 64) (i : Fin 24) : ℤ :=
  if (generatedSixthMonomialOctadNegativeMask f e).testBit i.val then 1 else 0

/-- The exact integer preferred octad vector evaluated through the literal eight coordinates. -/
def generatedSixthMonomialOctadIntegral (f : Fin 231) (e : Fin 64) (i : Fin 24) : ℤ :=
  if (generatedSixthMonomialOctadSupportMask f).testBit i.val then
    if (generatedSixthMonomialOctadNegativeMask f e).testBit i.val then -2 else 2
  else 0

