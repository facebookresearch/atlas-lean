/-- Concrete candidate coordinate lifts at the individual actual source-factor boundaries. -/
def generatedAxisGlobalFifthQState09 (n : Fin 42) (i : Fin 24) : Q :=
  ⟨ofAdd (fun j => golayBooleanCast ((generatedAxisGlobalFifthQState09Binary n i).testBit j.val)),
    ofAdd (generatedAxisGlobalFifthQState09Phase n i)⟩

/-- The actual literal root 9 word has precisely 41 chronological source factors. -/
theorem generatedAxisGlobalFifthQFactor09_length :
    (generatedAxisGlobalFifthChainQFactors 9 (generatedAxisGlobalFifthActiveStages 9)).length =
      41 := by decide +kernel

/-- An individual factor read directly from the genuine original root 9 source list. -/
def generatedAxisGlobalFifthQFactor09 (n : Fin 41) : GeneratedAxisGlobalQFactor :=
  (generatedAxisGlobalFifthChainQFactors 9 (generatedAxisGlobalFifthActiveStages 9))[n.val]'(by
    rw [generatedAxisGlobalFifthQFactor09_length]
    exact n.isLt)

