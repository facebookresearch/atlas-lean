-- Compare all 456 indexed columns with the previously checked operator columns.
/-- Every direct row list is the exact finite column function of the genuine operator. -/
theorem generatedAxisGlobalFifthBinaryRows_certificate : ∀ k : Fin 19,
    generatedAxisGlobalFifthBinaryRows k =
      List.ofFn (fun j : Fin 24 => (j.val, generatedAxisGlobalFifthBinaryColumns k j)) := by
  decide +kernel

/-- Direct row evaluation has the already proved genuine column-matrix action. -/
theorem generatedAxisGlobalFifthBinaryRows_action (k : Fin 19) (b : ℕ) :
    generatedAxisGlobalMaskRowsAction (generatedAxisGlobalFifthBinaryRows k) b =
      generatedAxisGlobalMaskColumnAction (generatedAxisGlobalFifthBinaryColumns k) b := by
  rw [generatedAxisGlobalFifthBinaryRows_certificate, generatedAxisGlobalMaskRowsAction_ofFn]

