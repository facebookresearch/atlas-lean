-- Check all 2,280 generator edges and all 119 descending parent edges.
/-- The complete finite packet has actual generator actions and strictly descending parents. -/
theorem generatedAxisGlobalFifthOrbit120_certificate :
    (∀ k : Fin 19, ∀ i : Fin 120,
      generatedAxisGlobalMaskColumnAction (generatedAxisGlobalFifthBinaryColumns k)
        (generatedAxisGlobalFifthOrbit120Mask i) =
      generatedAxisGlobalFifthOrbit120Mask (generatedAxisGlobalFifthOrbit120Target k i)) ∧
    (∀ i : Fin 120, i ≠ 0 →
      generatedAxisGlobalFifthOrbit120Rank (generatedAxisGlobalFifthOrbit120Parent i) <
        generatedAxisGlobalFifthOrbit120Rank i ∧
      generatedAxisGlobalFifthOrbit120Target (generatedAxisGlobalFifthOrbit120Edge i)
        (generatedAxisGlobalFifthOrbit120Parent i) = i) := by
  decide +kernel

set_option maxHeartbeats 4000000 in
-- Reassemble all masks and check the 14,400 pairs of finite indices.
/-- Decoding retains the exact mask and all 120 masks are distinct. -/
theorem generatedAxisGlobalFifthOrbit120_distinct_certificate :
    (∀ i : Fin 120,
      (∑ j : Fin 24,
        (monsterCo1GeometryBinaryMaskDecode (generatedAxisGlobalFifthOrbit120Mask i) j).val *
          2^j.val) = generatedAxisGlobalFifthOrbit120Mask i) ∧
    Function.Injective generatedAxisGlobalFifthOrbit120Mask := by
  decide +kernel

