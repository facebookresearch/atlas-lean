/-- The six exact intermediate phase plans. -/
def generatedFifthMonomialPermutationSpinPlan : Fin 6 → RepresentativeSpinPlan (Fin 2 × Bool) :=
  ![generatedFifthMonomialPermutationSpinPlan0, generatedFifthMonomialPermutationSpinPlan1,
    generatedFifthMonomialPermutationSpinPlan2, generatedFifthMonomialPermutationSpinPlan3,
    generatedFifthMonomialPermutationSpinPlan4, generatedFifthMonomialPermutationSpinPlan5]

/-- Every plan uses precisely its actual original source word. -/
theorem generatedFifth_monomial_permutation_plan_letters : ∀ k : Fin 6,
    (generatedFifthMonomialPermutationSpinPlan k).map Prod.fst =
      generatedFifthMonomialPermutationWord k := by
  decide +kernel

/-- The final literal signed matrix of each word. -/
def generatedFifthMonomialPermutationSpinModel (k : Fin 6) : RepresentativeSpinModel :=
  representativeSpinPlanEnd representativeSpinIdentityModel
    (generatedFifthMonomialPermutationSpinPlan k)

