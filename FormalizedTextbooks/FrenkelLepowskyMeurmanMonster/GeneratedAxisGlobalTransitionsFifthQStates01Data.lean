/-- Concrete candidate coordinate lifts at the individual actual source-factor boundaries. -/
def generatedAxisGlobalFifthQState01 (n : Fin 27) (i : Fin 24) : Q :=
  ⟨ofAdd (fun j => golayBooleanCast ((generatedAxisGlobalFifthQState01Binary n i).testBit j.val)),
    ofAdd (generatedAxisGlobalFifthQState01Phase n i)⟩

/-- The actual literal root 1 word has precisely 26 chronological source factors. -/
theorem generatedAxisGlobalFifthQFactor01_length :
    (generatedAxisGlobalFifthChainQFactors 1 (generatedAxisGlobalFifthActiveStages 1)).length =
      26 := by decide +kernel

/-- An individual factor read directly from the genuine original root 1 source list. -/
def generatedAxisGlobalFifthQFactor01 (n : Fin 26) : GeneratedAxisGlobalQFactor :=
  (generatedAxisGlobalFifthChainQFactors 1 (generatedAxisGlobalFifthActiveStages 1))[n.val]'(by
    rw [generatedAxisGlobalFifthQFactor01_length]
    exact n.isLt)

