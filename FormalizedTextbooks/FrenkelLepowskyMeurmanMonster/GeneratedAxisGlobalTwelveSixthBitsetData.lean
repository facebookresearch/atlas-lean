set_option maxRecDepth 100000 in
-- Finite check of the bounds of every row operation.
/-- Every row operation of every stage is valid. -/
theorem sixthBitsetStageOps_valid (s : ℕ) :
    ∀ ops ∈ sixthBitsetStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
  have h : ∀ s < 5, ∀ ops ∈ sixthBitsetStageOps s, ∀ o ∈ ops, TenthForestRowValid o := by
    decide +kernel
  by_cases hs : s < 5
  · exact h s hs
  · have : sixthBitsetStageOps s = [] := by
      match s, hs with
      | n + 5, _ => rfl
    simp [this]

/-- The start set consists exactly of the twenty roots. -/
theorem sixthBitsetStart_testBit (b : ℕ) :
    sixthBitsetStart.testBit b = decide (b ∈ sixthBitsetRoots) :=
  tenthForestOfList_testBit _ b

set_option maxRecDepth 100000 in
-- The twenty roots are bounded masks.
/-- Every root is a bounded mask. -/
theorem sixthBitsetRoots_lt : ∀ m ∈ sixthBitsetRoots, m < 16777216 := by decide +kernel

/-- The start set has no positions beyond the `2 ^ 24` masks. -/
theorem sixthBitsetStart_bounded : TenthForestBounded sixthBitsetStart := by
  intro b hb
  rw [sixthBitsetStart_testBit]
  simp only [decide_eq_false_iff_not]
  intro hm
  have := sixthBitsetRoots_lt b hm
  omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
