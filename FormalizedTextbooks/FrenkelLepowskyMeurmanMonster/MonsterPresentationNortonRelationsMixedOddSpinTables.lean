/-- The genuine frozen compact inverse-U numerator with both actual V actions. -/
def monsterNortonMixedOddSpinNumerator (k : Fin 5) : NortonUIntegerVector :=
  nortonUIntegerQ y555NortonVQ
    (monsterNortonUCompactInverseNumerator (nortonUIntegerQ y555NortonVQ
      (monsterNortonSourceZInteger
        (monsterNortonEvenShortFirstUOddCode (monsterNortonMixedOddBasisIndex k)))))

set_option maxHeartbeats 8000000 in
-- Check the actual odd branch of each selected source input.
/-- Each selected basis input genuinely enters the odd first-U branch. -/
theorem monsterNortonMixedOdd_firstU_odd (k : Fin 5) :
    monsterNortonEvenShortFirstUIsOdd (monsterNortonMixedOddBasisIndex k) = true := by
  revert k
  decide +kernel

set_option maxHeartbeats 16000000 in
-- Check distinctness of all original supported labels.
/-- No two supported entries of a numerator share an actual spin coordinate. -/
theorem monsterNortonMixedOddSpinLabel_injective (k : Fin 5) :
    Function.Injective (monsterNortonMixedOddSpinLabel k) := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ k : Fin 5, ∀ i : Fin 127,
      monsterNortonMixedOddSpinLabel k i.castSucc < monsterNortonMixedOddSpinLabel k i.succ := by
    decide +kernel
  exact hc k

/-- Every supported integer coefficient has exact square one. -/
theorem monsterNortonMixedOddSpinCoefficient_sq (k : Fin 5) (i : Fin 128) :
    monsterNortonMixedOddSpinCoefficient k i ^ 2 = 1 := by
  revert k i
  decide +kernel

