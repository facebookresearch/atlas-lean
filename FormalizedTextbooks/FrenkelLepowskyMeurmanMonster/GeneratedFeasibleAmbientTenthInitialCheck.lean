/-- The root-two stage-0 spin numerators are the initial source spin numerators. -/
theorem generatedFeasibleAmbientTenth_initial_spin_check : ∀ (r : Fin 8) (a : Fin 4096),
    generatedFeasibleAmbientTenthSpin 0 r a =
      generatedTwelfthTensorSourceSpinFast r a := by
  intro r
  fin_cases r
  · apply generatedFeasibleAmbientTenth_fin4096_blocks
    intro q
    fin_cases q
    · exact init_0_0
    · exact init_0_1
    · exact init_0_2
    · exact init_0_3
    · exact init_0_4
    · exact init_0_5
    · exact init_0_6
    · exact init_0_7
  · apply generatedFeasibleAmbientTenth_fin4096_blocks
    intro q
    fin_cases q
    · exact init_1_0
    · exact init_1_1
    · exact init_1_2
    · exact init_1_3
    · exact init_1_4
    · exact init_1_5
    · exact init_1_6
    · exact init_1_7
  · apply generatedFeasibleAmbientTenth_fin4096_blocks
    intro q
    fin_cases q
    · exact init_2_0
