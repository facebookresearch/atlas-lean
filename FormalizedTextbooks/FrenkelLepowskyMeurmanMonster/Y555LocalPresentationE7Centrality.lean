/-- Exact finite moves in a parabolic centrality reduction batch. -/
def y322E7CentralMoves (g : Fin 7) (i : Fin 21) : List Y322CoxeterMove :=
  (y322E7CentralPackedMoves g i).map y322PackedCoxeterMove

set_option maxRecDepth 10000 in
set_option maxHeartbeats 4000000 in
-- The kernel replays 3,162 literal Coxeter moves across seven finite reductions.
/-- Every literal parabolic commutator reduction batch is valid. -/
theorem y322E7Central_replay (g : Fin 7) (i : Fin 21) :
    y322CoxeterRun (y322E7CentralMoves g i) (y322E7CentralWord g i.castSucc) =
      some (y322E7CentralWord g i.succ) := by
  fin_cases g <;> fin_cases i <;> decide +kernel

/-- Source positive E7 longest word, with all seven necessary letters. -/
def y322E7Positive12 : List (Fin 8) :=
  (List.replicate 9 ([0, 1, 4, 6, 2, 5, 3] : List (Fin 8))).flatten

/-- The first literal reduction word is the actual parabolic-generator commutator. -/
theorem y322E7Central_start (g : Fin 7) :
    y322E7CentralWord g 0 = [g.castSucc] ++ y322E7Positive12 ++
      [g.castSucc] ++ y322E7Positive12.reverse := by
  fin_cases g <;> decide +kernel

/-- All seven literal commutator reductions end at the empty word. -/
theorem y322E7Central_end (g : Fin 7) :
    y322E7CentralWord g (Fin.last 21) = [] := by
  fin_cases g <;> decide +kernel

/-- Reverse of a positive word evaluates as its inverse because every generator squares to one. -/
theorem y322PositiveWord_reverse (w : List (Fin 8)) :
    y322PositiveWord w.reverse = (y322PositiveWord w)⁻¹ := by
  induction w with
  | nil => simp [y322PositiveWord]
  | cons a t ih =>
    have hi : (PresentedGroup.of a : Y322Presentation)⁻¹ = PresentedGroup.of a :=
      inv_eq_of_mul_eq_one_right (y322Positive_generator_square a)
    simp only [List.reverse_cons, y322PositiveWord_append, ih]
    simp [y322PositiveWord, mul_inv_rev, hi]

/-- The positive seven-letter power evaluates to the actual corrected free-group source word. -/
theorem y322E7Positive12_value :
    y322PositiveWord y322E7Positive12 = PresentedGroup.mk y322Relations y322E7Word12 := by
  rw [y322E7Positive12, y322PositiveWord_replicate]
  simp [y322E7Word12, y322PositiveWord, map_pow, map_mul, PresentedGroup.of, mul_assoc]

/-- The corrected F12 commutes with each of the seven genuine E7 parabolic generators. -/
theorem y322E7Word12_central (g : Fin 7) :
    (PresentedGroup.of g.castSucc : Y322Presentation) *
        PresentedGroup.mk y322Relations y322E7Word12 =
      PresentedGroup.mk y322Relations y322E7Word12 * PresentedGroup.of g.castSucc := by
  have hchain (i : Fin 22) :
      y322PositiveWord (y322E7CentralWord g i) =
        y322PositiveWord (y322E7CentralWord g 0) := by
    induction i using Fin.induction with
    | zero => rfl
    | succ i ih =>
      exact (y322CoxeterRun_valid (y322E7CentralMoves g i)
        (y322E7CentralWord g i.castSucc) (y322E7CentralWord g i.succ)
          (y322E7Central_replay g i)).symm.trans ih
  have h := (hchain (Fin.last 21)).symm
  rw [y322E7Central_start, y322E7Central_end] at h
  rw [y322PositiveWord_append, y322PositiveWord_append, y322PositiveWord_append,
    y322PositiveWord_reverse, y322E7Positive12_value] at h
  have hs : y322PositiveWord [g.castSucc] =
      (PresentedGroup.of g.castSucc : Y322Presentation) := by simp [y322PositiveWord]
  have hn : y322PositiveWord [] = 1 := by rfl
  rw [hs, hn] at h
  have he := congrArg (fun x => x * (PresentedGroup.of g.castSucc : Y322Presentation))
    (eq_of_mul_inv_eq_one h)
  simpa only [mul_assoc, y322Positive_generator_square, mul_one] using he

