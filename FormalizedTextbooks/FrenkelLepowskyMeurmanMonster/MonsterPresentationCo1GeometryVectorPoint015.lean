-- Check every entry of this finite actual transport matrix in the Lean kernel.
/-- Every column of transport 15 is its actual Conway binary action. -/
theorem monsterCo1GeometryVectorPoint15Transport_binary (v : Fin 24 → ZMod 2) :
    co1BinaryAction monsterCo1GeometryVectorPoint15Transport v =
      monsterCo1GeometryVectorPoint15Matrix *ᵥ v := by
  have h0 := monsterCo1GeometryTransportWord_nil_binary
  have h1 : ∀ v, co1BinaryAction (monsterCo1GeometryTransportWord [0]) v =
      monsterCo1GeometryVectorPoint15WordMatrix1 *ᵥ v :=
    monsterCo1GeometryTransportWord_append_binary [] 0
    (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) monsterCo1GeometryVectorPoint15WordMatrix1 h0 (by
    decide +kernel)
  have h2 : ∀ v, co1BinaryAction (monsterCo1GeometryTransportWord [0, 3]) v =
      monsterCo1GeometryVectorPoint15WordMatrix2 *ᵥ v :=
    monsterCo1GeometryTransportWord_append_binary [0] 3
    monsterCo1GeometryVectorPoint15WordMatrix1 monsterCo1GeometryVectorPoint15WordMatrix2 h1
    (by decide +kernel)
  have h3 : ∀ v, co1BinaryAction (monsterCo1GeometryTransportWord [0, 3, 0]) v =
      monsterCo1GeometryVectorPoint15WordMatrix3 *ᵥ v :=
    monsterCo1GeometryTransportWord_append_binary [0, 3] 0
    monsterCo1GeometryVectorPoint15WordMatrix2 monsterCo1GeometryVectorPoint15WordMatrix3 h2
    (by decide +kernel)
  have h4 : ∀ v, co1BinaryAction (monsterCo1GeometryTransportWord [0, 3, 0, 1]) v =
      monsterCo1GeometryVectorPoint15WordMatrix4 *ᵥ v :=
    monsterCo1GeometryTransportWord_append_binary [0, 3, 0] 1
    monsterCo1GeometryVectorPoint15WordMatrix3 monsterCo1GeometryVectorPoint15WordMatrix4 h3
    (by decide +kernel)
  have h5 : ∀ v, co1BinaryAction (monsterCo1GeometryTransportWord [0, 3, 0, 1, 4]) v =
      monsterCo1GeometryVectorPoint15Matrix *ᵥ v :=
    monsterCo1GeometryTransportWord_append_binary [0, 3, 0, 1] 4
    monsterCo1GeometryVectorPoint15WordMatrix4 monsterCo1GeometryVectorPoint15Matrix h4 (by
    decide +kernel)
  change co1BinaryAction (monsterCo1GeometryTransportWord [0, 3, 0, 1, 4]) v = _
  exact h5 v

