set_option maxHeartbeats 16000000 in
-- Finite literal indices are verified as actual source reflection involutions.
/-- Each exact root-index action is an involution on the actual finite root list. -/
theorem y322Orthogonal3E7RootIndex_involution (g : Fin 7) (i : Fin 126) :
    y322Orthogonal3E7RootIndex g (y322Orthogonal3E7RootIndex g i) = i := by
  revert g i
  decide +kernel

set_option maxHeartbeats 16000000 in
-- Every matrix entry uses the previously proved exact original source reflection matrix.
/-- Every original E7 source reflection has its declared exact action on actual root columns. -/
theorem y322Orthogonal3E7RootMatrix_action (g : Fin 7) (i : Fin 126) :
    y322Orthogonal3Reflection g.castSucc * y322Orthogonal3E7RootMatrix i =
      y322Orthogonal3E7RootMatrix (y322Orthogonal3E7RootIndex g i) := by
  revert g i
  decide +kernel

set_option maxHeartbeats 16000000 in
-- The kernel checks uniqueness of the 126 actual seven-dimensional source root columns.
/-- The literal finite source root columns are pairwise distinct. -/
theorem y322Orthogonal3E7RootMatrix_injective :
    Function.Injective y322Orthogonal3E7RootMatrix := by
  decide +kernel

/-- The actual finite set of 126 source E7 root columns in the characteristic-three image. -/
def y322Orthogonal3E7Roots : Finset (Matrix (Fin 7) Unit (ZMod 3)) :=
  Finset.univ.image y322Orthogonal3E7RootMatrix

/-- The explicit actual finite E7 root set has exactly 126 distinct columns. -/
theorem y322Orthogonal3E7Roots_card : y322Orthogonal3E7Roots.card = 126 := by
  rw [y322Orthogonal3E7Roots, Finset.card_image_of_injective _
    y322Orthogonal3E7RootMatrix_injective]
  exact Finset.card_fin _

