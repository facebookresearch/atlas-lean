/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeSevenSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeSevenSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeSevenSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeSevenSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeSevenSpinPrefixDense_support (i : Fin 64) :
    monsterNortonCodeSevenSpinPrefixDense (monsterNortonCodeSevenSpinPrefixLabel i) =
      monsterNortonCodeSevenSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeSevenSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeSevenSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 63, monsterNortonCodeSevenSpinPrefixLabel i.castSucc <
      monsterNortonCodeSevenSpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude one. -/
theorem monsterNortonCodeSevenSpinPrefixCoefficient_sq (i : Fin 64) :
    monsterNortonCodeSevenSpinPrefixCoefficient i ^ 2 = 1 := by
