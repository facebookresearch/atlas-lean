/- The intrinsic Conway base-point two-core is generated by the twelve actual code-basis signs. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationCo1GeometrySignActions
public import Mathlib.GroupTheory.OrderOfElement

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators

/-- The actual Leech subgroup generated by the twelve original code-basis signs. -/
def monsterCo1GeometryBasisSignIsometrySubgroup : Subgroup leechIsomSubgroup :=
  Subgroup.closure (Set.range monsterCo1GeometrySignIsometry)

/-- Actual sign-code membership in the five-generator subgroup is a binary linear condition. -/
def monsterCo1GeometryBasisSignPreimage : Submodule (ZMod 2) golayCode where
  carrier := {c | golaySignIsometry c ∈ monsterCo1GeometryBasisSignIsometrySubgroup}
  zero_mem' := by
    change golaySignHom 1 ∈ monsterCo1GeometryBasisSignIsometrySubgroup
    rw [map_one]
    exact monsterCo1GeometryBasisSignIsometrySubgroup.one_mem
  add_mem' := by
    intro a b ha hb
    change golaySignHom (Multiplicative.ofAdd a * Multiplicative.ofAdd b) ∈
      monsterCo1GeometryBasisSignIsometrySubgroup
    rw [map_mul]
    exact monsterCo1GeometryBasisSignIsometrySubgroup.mul_mem ha hb
  smul_mem' a c hc := by
    have hs : ∀ t : ZMod 2, t = 0 ∨ t = 1 := by decide +kernel
    rcases hs a with rfl | rfl
    · rw [zero_smul]
      change golaySignHom 1 ∈ monsterCo1GeometryBasisSignIsometrySubgroup
      rw [map_one]
      exact monsterCo1GeometryBasisSignIsometrySubgroup.one_mem
    · simpa only [one_smul] using hc

/-- Every displayed source code-basis sign belongs to its actual generated subgroup. -/
theorem monsterCo1Geometry_basis_sign_mem (k : Fin 12) :
    golaySignIsometry (monsterCo1GeometrySignCode k) ∈
      monsterCo1GeometryBasisSignIsometrySubgroup :=
  Subgroup.subset_closure ⟨k, rfl⟩

/-- Every actual Golay codeword sign is generated by the same five actual isometries. -/
theorem monsterCo1Geometry_all_sign_mem (c : golayCode) :
    golaySignIsometry c ∈ monsterCo1GeometryBasisSignIsometrySubgroup := by
  obtain ⟨a, ha⟩ := c.property
  have he : c = ∑ j, a j • monsterCo1GeometrySignCode j := by
    apply Subtype.ext
    simp only [Submodule.coe_sum, Submodule.coe_smul, monsterCo1GeometrySignCode]
    have hx : a = ∑ j, a j • (Pi.single j 1 : Fin 12 → ZMod 2) := by
      ext i
      simp [Pi.single_apply]
    simp only [← map_smul]
    rw [← map_sum, ← hx]
    exact ha.symm
  change c ∈ monsterCo1GeometryBasisSignPreimage
  rw [he]
  apply Submodule.sum_mem
  intro j _
  exact Submodule.smul_mem _ _ (monsterCo1Geometry_basis_sign_mem j)

/-- The twelve genuine Conway sign classes used to check complete source two-core orbits. -/
def monsterCo1GeometryBasisSignClass (k : Fin 12) : Co1 :=
  QuotientGroup.mk (monsterCo1GeometrySignIsometry k)

/-- The actual twelve-generator class closure is the entire intrinsic base-point two-core. -/
theorem monsterCo1GeometryBasisSignClass_closure :
    Subgroup.closure (Set.range monsterCo1GeometryBasisSignClass) =
      monsterCo1GeometryPointTwoCore monsterCo1GeometryBasePoint := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨k, rfl⟩
    exact monsterCo1GeometrySign_mem_baseTwoCore k
  · rw [monsterCo1GeometryBasePoint_twoCore]
    rintro g ⟨c, rfl⟩
    have h := monsterCo1Geometry_all_sign_mem c.toAdd
    have hm : monsterCo1GeometryBasisSignIsometrySubgroup.map
        (QuotientGroup.mk' signsSubgroup) ≤
        Subgroup.closure (Set.range monsterCo1GeometryBasisSignClass) := by
      rw [monsterCo1GeometryBasisSignIsometrySubgroup, MonoidHom.map_closure,
        ← Set.range_comp]
      exact le_rfl
    exact hm ⟨golaySignHom c, h, rfl⟩

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
