/-! # The Root8 source word in the identification alphabet, with packed data

`srcRootEightYWord` writes the original local word `generatedFifthRootEightLocal`
(`= generatedAxisGlobalFifthShortLocalWord 8`) in the identification alphabet, stage by stage
(Xi, the stage code sign when nonzero, the monomial letters); `srcRootEightYWord_local` is the exact
equality of local elements. The composite packed mask data of the word and the short image list
of `fifthSrcVec` under the word are data only, re-checked by the kernel where they are used. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
namespace GeneratedAxisGlobalIdent
set_option autoImplicit false

/-- Stage `j` of the normalization word of Fifth root eight in the identification alphabet. -/
def srcRootEightYStage (j : Fin 7) : List IdentLetter :=
  (if generatedAxisGlobalFifthShortNormalizationXi 8 j then [IdentLetter.xi] else []) ++
    ((if generatedAxisGlobalFifthShortNormalizationSigns 8 j = 0 then [] else
      [IdentLetter.sign (generatedAxisGlobalFifthShortNormalizationSigns 8 j) 0]) ++
      (generatedAxisGlobalFifthShortNormalizationWords 8 j).map IdentLetter.mono)

/-- The chronological chain of the first `n` stages (the head stage acts last). -/
def srcRootEightYChain : ℕ → List IdentLetter
  | 0 => []
  | n + 1 => srcRootEightYStage ⟨n % 7, Nat.mod_lt _ (by decide)⟩ ++ srcRootEightYChain n

/-- The Root8 source word. -/
def srcRootEightYWord : List IdentLetter := srcRootEightYChain 7

/-- Each stage has the local element of the original stage. -/
theorem srcRootEightYStage_local (j : Fin 7) :
    identWordLocal (srcRootEightYStage j) =
      generatedAxisGlobalFifthShortNormalizationLocal 8 j := by
  unfold srcRootEightYStage generatedAxisGlobalFifthShortNormalizationLocal
  rw [identWordLocal_append, identWordLocal_append]
  congr 1
  · cases generatedAxisGlobalFifthShortNormalizationXi 8 j
    · simp [identWordLocal, identWordFiber]
    · simp [identWordLocal, identWordFiber]
      rfl
  · congr 1
    · by_cases h : generatedAxisGlobalFifthShortNormalizationSigns 8 j = 0
      · rw [h, generatedAxisGlobalSignLocal_zero]
        simp [identWordLocal, identWordFiber]
      · simp only [h, ↓reduceIte]
        rw [identWordLocal_singleton]
        exact generatedFifth_sign_fiber_local _ _
    · simp only [identWordLocal, identWordFiber, List.map_map]
      rfl

/-- The chain has the local element of the original chronological chain. -/
theorem srcRootEightYChain_local (n : ℕ) :
    identWordLocal (srcRootEightYChain n) = generatedAxisGlobalWordChain
      (fun j => generatedAxisGlobalFifthShortNormalizationLocal 8
        ⟨j % 7, Nat.mod_lt _ (by decide)⟩) n := by
  induction n with
  | zero => simp [srcRootEightYChain, generatedAxisGlobalWordChain, identWordLocal, identWordFiber]
  | succ n ih => rw [srcRootEightYChain, identWordLocal_append, ih, srcRootEightYStage_local]; rfl

/-- The Root8 source word is the original local word of the Root8 axis. -/
theorem srcRootEightYWord_local : identWordLocal srcRootEightYWord = generatedFifthRootEightLocal :=
  srcRootEightYChain_local 7

/-- Composite packed mask data of the Root8 source word. -/
def srcRootEightYD : QMaskP :=
  ⟨0xac855730c79080003acad1f58001cbb0c79000025eef501bef52a0ac528580d |||
    (0x580f82803080074e3f2255005db1b111228b35120b312d34f32034d38280d29 <<< 256) |||
    (0x5f000261db4f7850 <<< 512),
    0x3000c1e40001000085de00150000f2e480010000f22620f2e62055322c403080 |||
    (0xc00000100000b000000400006a000095000084000000000014c000c0200044 <<< 256),
    0x9013a8⟩

