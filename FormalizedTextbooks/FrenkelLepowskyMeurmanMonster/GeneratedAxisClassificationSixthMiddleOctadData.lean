/-- Every displayed source coordinate pair is strictly increasing. -/
theorem generatedSixth_middle_octad_source_lt (k : Fin 273) :
    (generatedSixthMiddleOctadSourceCoordinates k).2.1 <
      (generatedSixthMiddleOctadSourceCoordinates k).2.2 := by
  revert k
  decide +kernel

/-- The actual preferred source address, using the genuine physical pair enumeration. -/
def generatedSixthMiddleOctadInput (k : Fin 273) : GeneratedSixthSourcePair :=
  ((generatedSixthMiddleOctadSourceCoordinates k).1,
    griessPairIndex (generatedSixthMiddleOctadSourceCoordinates k).2.1
      (generatedSixthMiddleOctadSourceCoordinates k).2.2
      (ne_of_lt (generatedSixth_middle_octad_source_lt k)))

