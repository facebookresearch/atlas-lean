/-- Every actual source target equation is the claimed finite right-generator transition. -/
theorem y322TCIndexTarget_shape (i : Fin 3159) (g : Fin 8) :
    y322EquationsSameReduction (y322TCIndexTransitionEquation i g)
      (y322TCIndexProgram (y322TCIndexEdgeAt i g).equation).1 := by
  let index : Fin 25272 := ⟨i.val * 8 + g.val, by omega⟩
  let block : Fin 99 := ⟨index.val / 256, by omega⟩
  let offset : Fin 256 := ⟨index.val % 256, Nat.mod_lt _ (by decide)⟩
  have h := y322TCIndexTargetBlock block offset
  have he : block.val * 256 + offset.val = index.val := by
    dsimp [block, offset]
    omega
  rw [he] at h
  simp only [y322TCIndexTargetCheckAt, dite_eq_left index.isLt] at h
  have hi : (⟨index.val / 8, by omega⟩ : Fin 3159) = i := by
    apply Fin.ext
    dsimp [index]
    omega
  have hg : (⟨index.val % 8, Nat.mod_lt _ (by decide)⟩ : Fin 8) = g := by
    apply Fin.ext
    dsimp [index]
    omega
  rw [hi, hg] at h
  exact h

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
