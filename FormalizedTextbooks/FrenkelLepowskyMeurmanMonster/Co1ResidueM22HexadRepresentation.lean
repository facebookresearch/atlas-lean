module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22Geometry
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueHexadAbelian

/-! Actual Golay hexads give abelian local subgroups in every representation of the
auxiliary M22 geometry. This does not assume the full M22 representation is abelian. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- Extend actual distinct hexad pair images by identity on the unused diagonal. -/
def co1ResidueM22HexadImage {G : Type*} [Group G] (p q : Fin 24) (o : Fin 759)
    (e : Fin 6 ≃ (co1ResidueM22Hexad p q o)) (phi : Co1ResidueM22Point p q → G)
    (a b : Fin 6) : G :=
  if h : a ≠ b then phi (co1ResidueM22HexadPair p q o e a b h) else 1

/-- Every actual point contained in a hexad is one of its coordinate pair points. -/
theorem co1ResidueM22HexadPair_surjective (p q : Fin 24) (o : Fin 759)
    (e : Fin 6 ≃ (co1ResidueM22Hexad p q o)) (s : Co1ResidueM22Point p q)
    (hs : s.val ⊆ co1ResidueM22Hexad p q o) :
    ∃ a b : Fin 6, ∃ hab : a ≠ b, co1ResidueM22HexadPair p q o e a b hab = s := by
  obtain ⟨u, v, huv, he⟩ := Finset.card_eq_two.mp s.property.1
  have hu : u ∈ co1ResidueM22Hexad p q o := hs (he ▸ (by simp))
  have hv : v ∈ co1ResidueM22Hexad p q o := hs (he ▸ (by simp))
  let a := e.symm ⟨u, hu⟩
  let b := e.symm ⟨v, hv⟩
  have ha : (e a).val = u := congrArg Subtype.val (e.apply_symm_apply ⟨u, hu⟩)
  have hb : (e b).val = v := congrArg Subtype.val (e.apply_symm_apply ⟨v, hv⟩)
  have hab : a ≠ b := by
    intro h
    exact huv (ha.symm.trans ((congrArg (fun i => (e i).val) h).trans hb))
  refine ⟨a, b, hab, Subtype.ext ?_⟩
  change {(e a).val, (e b).val} = s.val
  rw [ha, hb, he]

/-- Actual hexad point images have the full six-element matching representation contract. -/
theorem co1ResidueM22HexadImage_contract {G : Type*} [Group G] (p q : Fin 24) (o : Fin 759)
    (hp : p ∈ golayOctadSupport o) (hq : q ∈ golayOctadSupport o)
    (e : Fin 6 ≃ (co1ResidueM22Hexad p q o)) (phi : Co1ResidueM22Point p q → G)
    (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ a b c, co1ResidueM22Line p q a b c → phi a * phi b * phi c = 1) :
    (∀ a b, co1ResidueM22HexadImage p q o e phi a b =
      co1ResidueM22HexadImage p q o e phi b a) ∧
    (∀ a b, a ≠ b → co1ResidueM22HexadImage p q o e phi a b *
      co1ResidueM22HexadImage p q o e phi a b = 1) ∧
    (∀ v : Fin 6 → Fin 6, Function.Bijective v →
      co1ResidueM22HexadImage p q o e phi (v 0) (v 1) *
      co1ResidueM22HexadImage p q o e phi (v 2) (v 3) *
      co1ResidueM22HexadImage p q o e phi (v 4) (v 5) = 1) := by
  refine ⟨?_, ?_, ?_⟩
  · intro a b
    by_cases hab : a ≠ b
    · simp only [co1ResidueM22HexadImage, dite_eq_left hab, dite_eq_left hab.symm]
      exact congrArg phi (co1ResidueM22HexadPair_swap p q o e a b hab)
    · have he : a = b := not_ne_iff.mp hab
      rw [he]
  · intro a b hab
    simp only [co1ResidueM22HexadImage, dite_eq_left hab]
    exact hsquare _
  · intro v hv
    simp only [co1ResidueM22HexadImage, dite_eq_left (hv.injective.ne (by decide +kernel :
      (0 : Fin 6) ≠ 1)), dite_eq_left (hv.injective.ne (by decide +kernel : (2 : Fin 6) ≠ 3)),
      dite_eq_left (hv.injective.ne (by decide +kernel : (4 : Fin 6) ≠ 5))]
    exact hline _ _ _ (co1ResidueM22HexadPair_line p q o hp hq e v hv)

/-- Any two actual auxiliary M22 point images contained in one containing-octad hexad commute. -/
theorem co1ResidueM22_hexad_commute {G : Type*} [Group G] (p q : Fin 24)
    (hpq : p ≠ q) (o : Fin 759) (hp : p ∈ golayOctadSupport o)
    (hq : q ∈ golayOctadSupport o) (phi : Co1ResidueM22Point p q → G)
    (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ a b c, co1ResidueM22Line p q a b c → phi a * phi b * phi c = 1)
    (s t : Co1ResidueM22Point p q)
    (hs : s.val ⊆ co1ResidueM22Hexad p q o) (ht : t.val ⊆ co1ResidueM22Hexad p q o) :
    Commute (phi s) (phi t) := by
  let e := co1ResidueM22HexadCoordinates p q hpq o hp hq
  obtain ⟨a, b, hab, rfl⟩ := co1ResidueM22HexadPair_surjective p q o e s hs
  obtain ⟨c, d, hcd, rfl⟩ := co1ResidueM22HexadPair_surjective p q o e t ht
  obtain ⟨hsy, hsq, hln⟩ := co1ResidueM22HexadImage_contract p q o hp hq e phi hsquare hline
  have h := co1ResidueHexad_pairwise_commute (co1ResidueM22HexadImage p q o e phi)
    hsy hsq hln a b c d hab hcd
  simpa only [co1ResidueM22HexadImage, dite_eq_left hab, dite_eq_left hcd] using h

/-- The subgroup generated by all actual M22 point images contained in one Golay hexad
is abelian, as required for the nearby-pair step of source II Proposition 4.2.5. -/
theorem co1ResidueM22_hexad_generated_abelian {G : Type*} [Group G] (p q : Fin 24)
    (hpq : p ≠ q) (o : Fin 759) (hp : p ∈ golayOctadSupport o)
    (hq : q ∈ golayOctadSupport o) (phi : Co1ResidueM22Point p q → G)
    (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ a b c, co1ResidueM22Line p q a b c → phi a * phi b * phi c = 1) :
    IsMulCommutative (Subgroup.closure
      {g | ∃ s : Co1ResidueM22Point p q, s.val ⊆ co1ResidueM22Hexad p q o ∧ g = phi s}) := by
  apply Subgroup.isMulCommutative_closure
  rintro _ ⟨s, hs, rfl⟩ _ ⟨t, ht, rfl⟩ _
  exact co1ResidueM22_hexad_commute p q hpq o hp hq phi hsquare hline s t hs ht

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
