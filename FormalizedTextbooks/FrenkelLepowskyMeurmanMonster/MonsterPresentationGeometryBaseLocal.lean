/- Every source point incident with z is the base point or a verified Conway-frame phase. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationGeometryQPoints
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.MonsterPresentationGeometryFrameLocal

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open Multiplicative
set_option backward.isDefEq.respectTransparency false

/-- Actual source incidence at z is precisely membership in its genuine extraspecial subgroup. -/
theorem monsterGeometryBase_incident_iff (r : MonsterGeometryPoint) :
    monsterGeometryQIncident monsterGeometryBasePoint r ↔ ∃ q : Q, qIntoGenerated q = r.val := by
  have h := monsterGeometryQIncident_iff_of_conjugator monsterGeometryBasePoint r 1
    (by simp [monsterGeometryBasePoint])
  simpa only [one_mul, inv_one, mul_one] using h

/-- All actual incident points are exhausted by the base and the genuine frame-phase family. -/
theorem monsterGeometryBase_incident_cases (r : MonsterGeometryPoint)
    (hr : monsterGeometryQIncident monsterGeometryBasePoint r) :
    r = monsterGeometryBasePoint ∨ ∃ p : MonsterCo1GeometryPoint, ∃ q : Q,
      ∃ hq : toAdd (qQuotHom q) = p.val, r = monsterGeometryFrameLiftPoint p q hq := by
  obtain ⟨q, hq⟩ := (monsterGeometryBase_incident_iff r).mp hr
  have hc : IsConj generatedCentralInvolution (qIntoGenerated q) := hq.symm ▸ r.property
  rcases (monsterGeometryQ_point_iff q).mp hc with hz | hp
  · left
    apply Subtype.ext
    exact hq.symm.trans (congrArg qIntoGenerated hz)
  · right
    exact ⟨⟨_, hp⟩, q, rfl, Subtype.ext hq.symm⟩

/-- The original universal-representation subgroup generated by every point in Q(z). -/
def monsterGeometryBaseLocalSubgroup : Subgroup MonsterGeometryPresentation :=
  Subgroup.closure {x | ∃ r : MonsterGeometryPoint,
    monsterGeometryQIncident monsterGeometryBasePoint r ∧ x = PresentedGroup.of r}

/-- The formerly explicit frame-generated subgroup is the full original source local R₁(z). -/
theorem monsterGeometryBaseLocal_eq_frame :
    monsterGeometryBaseLocalSubgroup = monsterGeometryFrameLocalSubgroup := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨r, hr, rfl⟩
    rcases monsterGeometryBase_incident_cases r hr with rfl | ⟨p, q, hq, rfl⟩
    · exact monsterGeometryFrame_local_base_mem
    · exact monsterGeometryFrame_local_point_mem p q hq
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    apply Subgroup.subset_closure
    rcases hx with hx | ⟨p, q, hq, rfl⟩
    · exact ⟨monsterGeometryBasePoint, monsterGeometryQIncident_self _, hx⟩
    · refine ⟨monsterGeometryFrameLiftPoint p q hq, ?_, rfl⟩
      exact (monsterGeometryBase_incident_iff _).mpr ⟨q, rfl⟩

/-- Genuine line relations make the original base generator central in the full local R₁(z). -/
theorem monsterGeometryBaseLocal_centralizes_base :
    monsterGeometryBaseLocalSubgroup ≤
      Subgroup.centralizer {PresentedGroup.of monsterGeometryBasePoint} := by
  rw [monsterGeometryBaseLocal_eq_frame]
  exact monsterGeometryFrame_local_centralizes_base

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
