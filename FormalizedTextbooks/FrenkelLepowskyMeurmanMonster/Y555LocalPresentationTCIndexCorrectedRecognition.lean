/-- A checked original instruction remains checked wherever the selector keeps it in use. -/
theorem y322TCIndexUnreplacedCheckAt_of_original (index : ℕ)
    (h : y322TCIndexCheckAt index) : y322TCIndexUnreplacedCheckAt index := by
  unfold y322TCIndexUnreplacedCheckAt
  split
  · exact fun _ => h
  · trivial

/-- Every retained subblock has its separately checked original instructions. -/
theorem y322TCIndexUnreplacedSubblock145 (block : Fin 8) (i : Fin 128) :
    y322TCIndexUnreplacedCheckAt (148480 + block.val * 128 + i.val) := by
  fin_cases block
  · exact y322TCIndexRepairRetained145_0 i
  · exact y322TCIndexRepairRetained145_1 i
  · exact y322TCIndexRepairRetained145_2 i
  · exact y322TCIndexRepairRetained145_3 i
  · exact y322TCIndexRepairRetained145_4 i
  · exact y322TCIndexRepairRetained145_5 i
  · exact y322TCIndexRepairRetained145_6 i
  · exact y322TCIndexRepairRetained145_7 i

/-- All retained original instructions in block 145 pass the unchanged checker. -/
theorem y322TCIndexUnreplacedBlock145 (i : Fin 1024) :
    y322TCIndexUnreplacedCheckAt (148480 + i.val) := by
  let block : Fin 8 := ⟨i.val / 128, by omega⟩
  let offset : Fin 128 := ⟨i.val % 128, Nat.mod_lt _ (by decide)⟩
  have he : block.val * 128 + offset.val = i.val := by
    dsimp [block, offset]
    omega
  have h := y322TCIndexUnreplacedSubblock145 block offset
  rw [Nat.add_assoc, he] at h
  exact h

/-- Every retained subblock has its separately checked original instructions. -/
theorem y322TCIndexUnreplacedSubblock146 (block : Fin 8) (i : Fin 128) :
    y322TCIndexUnreplacedCheckAt (149504 + block.val * 128 + i.val) := by
  fin_cases block
  · exact y322TCIndexRepairRetained146_0 i
  · exact y322TCIndexRepairRetained146_1 i
  · exact y322TCIndexRepairRetained146_2 i
  · exact y322TCIndexRepairRetained146_3 i
  · exact y322TCIndexRepairRetained146_4 i
  · exact y322TCIndexRepairRetained146_5 i
  · exact y322TCIndexRepairRetained146_6 i
  · exact y322TCIndexRepairRetained146_7 i

/-- All retained original instructions in block 146 pass the unchanged checker. -/
theorem y322TCIndexUnreplacedBlock146 (i : Fin 1024) :
    y322TCIndexUnreplacedCheckAt (149504 + i.val) := by
  let block : Fin 8 := ⟨i.val / 128, by omega⟩
  let offset : Fin 128 := ⟨i.val % 128, Nat.mod_lt _ (by decide)⟩
  have he : block.val * 128 + offset.val = i.val := by
    dsimp [block, offset]
    omega
  have h := y322TCIndexUnreplacedSubblock146 block offset
  rw [Nat.add_assoc, he] at h
  exact h

