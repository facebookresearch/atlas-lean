/-
Finiteness of the actual lattice stabilizer, spin normalizer, and local group, as prerequisites
for the Monster finiteness milestone. This does not yet establish finiteness
of the group generated by the local action and triality.
-/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Definitions
public import Mathlib.Data.Int.Interval
public import Mathlib.GroupTheory.Index
public import Mathlib.Data.Set.Finite.Basic

@[expose] public section

namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster

/-- The integral lattice vectors of bounded squared length form a finite set. -/
theorem leechIntegral_bounded_finite (k : ℕ) :
    Finite {u : leechIntegral // leechSquareSum u.val ≤ k} := by
  classical
  let B := Set.Icc (-(k : ℤ) - 1) ((k : ℤ) + 1)
  let : Finite B := (Set.finite_Icc _ _).to_subtype
  have hb (u : leechIntegral) (hu : leechSquareSum u.val ≤ k) (i : Fin 24) :
      u.val i ∈ B := by
    have hi : u.val i ^ 2 ≤ leechSquareSum u.val :=
      Finset.single_le_sum (fun j _ => sq_nonneg (u.val j)) (Finset.mem_univ i)
    change -(k : ℤ) - 1 ≤ u.val i ∧ u.val i ≤ (k : ℤ) + 1
    constructor <;> nlinarith [sq_nonneg (u.val i), Nat.cast_nonneg (α := ℤ) k]
  let f : {u : leechIntegral // leechSquareSum u.val ≤ k} → (Fin 24 → B) :=
    fun u i => ⟨u.val.val i, hb u.val u.property i⟩
  apply Finite.of_injective f
  intro u v h
  apply Subtype.ext
  apply Subtype.ext
  funext i
  exact congrArg Subtype.val (congrFun h i)

/-- The images of the vectors `8e_i` determine an ambient real lattice isometry. -/
theorem leechIsom_eight_images_injective : Function.Injective
    (fun e : leechIsomSubgroup => fun i : Fin 24 =>
      leechIntegralAction e (leechEightEmbedding (Pi.single i 1))) := by
  intro e f h
  apply Subtype.ext
  apply (Pi.basisFun ℝ (Fin 24)).ext'
  intro i
  have hi := congrFun h i
  have he := congrArg (fun u : leechIntegral => leechCoordinateEmbedding u.val) hi
  rw [leechIntegralAction_embedding, leechIntegralAction_embedding] at he
  have hn : leechCoordinateEmbedding (leechEightEmbedding (Pi.single i 1)).val =
      (8 / Real.sqrt 8 : ℝ) • (Pi.basisFun ℝ (Fin 24) i) := by
    ext j
    by_cases hj : j = i
    · subst j
      simp only [leechCoordinateEmbedding, leechEightEmbedding, Pi.basisFun_apply,
        LinearMap.coe_mk, AddHom.coe_mk, Pi.smul_apply, Pi.single_apply, ite_true,
        smul_eq_mul, mul_one, Int.cast_ofNat]
    · simp [leechCoordinateEmbedding, leechEightEmbedding, Pi.basisFun_apply,
        hj]
  rw [hn, map_smul, map_smul] at he
  have hs : (8 / Real.sqrt 8 : ℝ) ≠ 0 :=
    div_ne_zero (by norm_num) (ne_of_gt (Real.sqrt_pos.mpr (by norm_num)))
  exact (smul_right_injective _ hs) he

/-- The genuine Leech lattice isometry group is finite, without a finiteness
hypothesis or a replacement by a precomputed finite group. -/
theorem leechIsomSubgroup_finite : Finite leechIsomSubgroup := by
  classical
  let S := {u : leechIntegral // leechSquareSum u.val ≤ (64 : ℕ)}
  let : Finite S := leechIntegral_bounded_finite 64
  have hs (e : leechIsomSubgroup) (i : Fin 24) :
      leechSquareSum (leechIntegralAction e (leechEightEmbedding (Pi.single i 1))).val
        ≤ (64 : ℕ) := by
    rw [leechIntegralAction_squareSum]
    simp [leechSquareSum, leechEightEmbedding, Pi.single_apply]
  let images : leechIsomSubgroup → (Fin 24 → S) :=
    fun e i => ⟨leechIntegralAction e (leechEightEmbedding (Pi.single i 1)), hs e i⟩
  apply Finite.of_injective images
  intro e f h
  apply leechIsom_eight_images_injective
  funext i
  exact congrArg Subtype.val (congrFun h i)

/-- The actual central quotient Co₁ is finite as a quotient of Co₀. -/
theorem co1_finite : Finite Co1 := by
  let : Finite leechIsomSubgroup := leechIsomSubgroup_finite
  infer_instance

open Multiplicative
private def spinCoordinateQ (a b : SpinIndex) : Q :=
  ⟨ofAdd (Fin.append a b), 1⟩
private theorem spinCoordinateQ_apply (a b : SpinIndex) (x : SpinSpace) (t : SpinIndex) :
    spinRepresentation (spinCoordinateQ a b) x t = qSign (spinDot b t) * x (t + a) := by
  change qSign (0 + spinDot (fun i => Fin.append a b (Fin.natAdd 12 i)) t) *
    x (t + (fun i => Fin.append a b (Fin.castAdd 12 i))) = _
  simp only [Fin.append_right, Fin.append_left, zero_add]

private theorem spinCoordinateQ_modulate_basis (b t : SpinIndex) :
    spinRepresentation (spinCoordinateQ 0 b) (Pi.single t 1) =
      qSign (spinDot b t) • Pi.single t 1 := by
  funext u
  rw [spinCoordinateQ_apply]
  by_cases hu : u = t
  · subst u; simp
  · simp [hu]

private theorem spinDot_single (i : Fin 12) (t : SpinIndex) :
    spinDot (Pi.single i 1) t = t i := by
  simp [spinDot, Pi.single_apply, ite_mul]

/-- The commuting algebra of the real Schrödinger representation consists of scalars. -/
theorem spinRepresentation_commutant_linear_scalar (e : SpinSpace →ₗ[ℝ] SpinSpace)
    (he : ∀ q x, e (spinRepresentation q x) = spinRepresentation q (e x)) :
    ∃ c : ℝ, ∀ x, e x = c • x := by
  classical
  let c := e (Pi.single (0 : SpinIndex) 1) 0
  have hz (u : SpinIndex) (hu : u ≠ 0) : e (Pi.single (0 : SpinIndex) 1) u = 0 := by
    obtain ⟨i, hi⟩ : ∃ i, u i ≠ 0 := by
      by_contra h
      apply hu
      funext i
      exact not_ne_iff.mp (not_exists.mp h i)
    have hui : u i = 1 := by
      have hb (z : ZMod 2) : z = 0 ∨ z = 1 := by
        fin_cases z
        · exact Or.inl rfl
        · exact Or.inr rfl
      exact (hb (u i)).resolve_left hi
    have hh := congrFun (he (spinCoordinateQ 0 (Pi.single i 1)) (Pi.single 0 1)) u
    rw [spinCoordinateQ_modulate_basis, map_smul] at hh
    rw [spinCoordinateQ_apply] at hh
    simp only [spinDot_zero_right, qSign_zero, one_smul, spinDot_single, hui,
      qSign_one, add_zero] at hh
    change e (Pi.single (0 : SpinIndex) 1) u = -1 * e (Pi.single (0 : SpinIndex) 1) u at hh
    linarith
  have hzero : e (Pi.single (0 : SpinIndex) 1) = c • Pi.single 0 1 := by
    funext u
    by_cases hu : u = 0
    · subst u; simp [c]
    · simp [hu, hz u hu]
  have hshift (t : SpinIndex) :
      spinRepresentation (spinCoordinateQ t 0) (Pi.single (0 : SpinIndex) 1) = Pi.single t 1 := by
    funext u
    rw [spinCoordinateQ_apply]
    simp only [spinDot_zero_left, qSign_zero, one_mul]
    by_cases hu : u = t
    · subst u; simp [ZModModule.add_self]
    · have hs : u + t ≠ 0 := by
        intro h
        apply hu
        have := congrArg (fun z : SpinIndex => z + t) h
        simpa only [add_assoc, ZModModule.add_self, add_zero, zero_add] using this
      simp [hu, hs]
  refine ⟨c, ?_⟩
  have hb (t : SpinIndex) : e (Pi.single t 1) = c • Pi.single t 1 := by
    rw [← hshift t, he, hzero, map_smul, hshift]
  have hl : e = c • LinearMap.id := by
    apply (Pi.basisFun ℝ SpinIndex).ext
    intro t
    rw [Pi.basisFun_apply]
    change e (Pi.single t 1) = c • Pi.single t 1
    exact hb t
  intro x
  exact DFunLike.congr_fun hl x
/-- The commuting linear equivalences of the real Schrödinger representation are scalar. -/
theorem spinRepresentation_commutant_scalar (e : SpinSpace ≃ₗ[ℝ] SpinSpace)
    (he : ∀ q x, e (spinRepresentation q x) = spinRepresentation q (e x)) :
    ∃ c : ℝ, ∀ x, e x = c • x :=
  spinRepresentation_commutant_linear_scalar e.toLinearMap he

/-- Every orthogonal operator commuting with Q is one of the two scalar signs. -/
theorem spinHolomorph_conjugation_kernel_scalar (s : spinConjugation.ker) :
    ∃ c : ℝ, (c = 1 ∨ c = -1) ∧ ∀ x, s.val.val x = c • x := by
  have hc (q : Q) : spinConjugation s.val q = q := by
    have h := s.property
    change spinConjugation s.val = 1 at h
    rw [h]
    rfl
  have he (q : Q) (x : SpinSpace) :
      s.val.val (spinRepresentation q x) = spinRepresentation q (s.val.val x) := by
    have h := spinConjugation_representation s.val q
    rw [hc q] at h
    have hh := congrArg (fun e : SpinSpace ≃ₗ[ℝ] SpinSpace => e (s.val.val x)) h
    simpa only [LinearEquiv.mul_apply, LinearEquiv.coe_inv,
      LinearEquiv.symm_apply_apply] using hh.symm
  obtain ⟨c, hscalar⟩ := spinRepresentation_commutant_scalar s.val.val he
  refine ⟨c, ?_, hscalar⟩
  have horth := s.val.property.2 (Pi.single (0 : SpinIndex) 1) (Pi.single 0 1)
  rw [hscalar] at horth
  have hc2 : c * c = 1 := by
    simpa [spinPairing, Pi.single_apply, mul_ite, ite_mul] using horth
  rcases mul_self_eq_one_iff.mp hc2 with hc | hc
  · exact Or.inl hc
  · exact Or.inr hc

/-- The kernel of conjugation on Q has at most the two scalar signs. -/
theorem spinConjugation_kernel_finite : Finite spinConjugation.ker := by
  classical
  let S := ({(1 : ℝ), -1} : Set ℝ)
  let : Finite S := (Set.toFinite S).to_subtype
  let c (s : spinConjugation.ker) :=
    (spinHolomorph_conjugation_kernel_scalar s).choose
  have hc (s : spinConjugation.ker) :
      (c s = 1 ∨ c s = -1) ∧ ∀ x, s.val.val x = c s • x :=
    (spinHolomorph_conjugation_kernel_scalar s).choose_spec
  let f : spinConjugation.ker → S := fun s => ⟨c s, by simpa [S] using (hc s).1⟩
  apply Finite.of_injective f
  intro s t h
  have hec : c s = c t := congrArg Subtype.val h
  apply Subtype.ext
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  rw [(hc s).2 x, (hc t).2 x, hec]

theorem q_finite_coordinates : Finite Q := by
  apply Finite.of_injective (fun q : Q => (q.base, q.coeff))
  intro q r h
  apply NormalizedCocycleExtension.Extension.ext
  · exact congrArg Prod.fst h
  · exact congrArg Prod.snd h

theorem spinHolomorph_finite : Finite SpinHolomorph := by
  let : Finite Q := q_finite_coordinates
  let : Finite (MulAut Q) :=
    Finite.of_injective (fun a : MulAut Q => (a : Q → Q)) DFunLike.coe_injective
  exact spinConjugation.finite_iff_finite_ker_range.mpr
    ⟨spinConjugation_kernel_finite, inferInstance⟩
/-- The actual normalizer/Co₀ fiber product is finite. -/
theorem localFiberSubgroup_finite : Finite localFiberSubgroup := by
  let : Finite SpinHolomorph := spinHolomorph_finite
  let : Finite leechIsomSubgroup := leechIsomSubgroup_finite
  infer_instance

/-- The local group H, defined by its diagonal central quotient, is finite. -/
theorem h_finite : Finite H := by
  let : Finite localFiberSubgroup := localFiberSubgroup_finite
  unfold H
  infer_instance

/-- The local image in the real Griess general linear group is finite. -/
theorem rhoLocal_range_finite : Finite rhoLocal.range := by
  let : Finite H := h_finite
  exact Finite.of_surjective rhoLocal.rangeRestrict rhoLocal.rangeRestrict_surjective

/-- The bundled Griess form evaluates to its explicit weighted coordinate sum. -/
theorem griessForm_apply (x y : GriessSpace) : griessForm x y = griessFormFun x y := by
  exact LinearMap.mk₂_apply ℝ griessFormFun x y
/-- All diagonal weights in the Griess form are positive. -/
theorem griessBasisWeight_pos (i : Fin 196884) : 0 < griessBasisWeight i := by
  unfold griessBasisWeight
  split <;> norm_num
/-- The Griess form is positive semidefinite. -/
theorem griessForm_self_nonneg (x : GriessSpace) : 0 ≤ griessForm x x := by
  rw [griessForm_apply]
  apply Finset.sum_nonneg
  intro i hi
  have hw := (griessBasisWeight_pos i).le
  nlinarith [sq_nonneg (x i)]
/-- A vector of zero Griess squared length is zero. -/
theorem griessForm_self_eq_zero_iff (x : GriessSpace) : griessForm x x = 0 ↔ x = 0 := by
  constructor
  · intro hx
    funext i
    have hterm : griessBasisWeight i * x i * x i ≤ griessForm x x := by
      rw [griessForm_apply]
      unfold griessFormFun
      exact Finset.single_le_sum (f := fun j => griessBasisWeight j * x j * x j)
        (fun (j : Fin 196884) _ => by
        have hw := (griessBasisWeight_pos j).le
        nlinarith [sq_nonneg (x j)]) (Finset.mem_univ i)
    have hw := griessBasisWeight_pos i
    have hz : griessBasisWeight i * (x i * x i) = 0 := by
      nlinarith [sq_nonneg (x i)]
    have hsq := (mul_eq_zero.mp hz).resolve_left (ne_of_gt hw)
    exact (mul_self_eq_zero.mp hsq)
  · rintro rfl
    rw [griessForm_apply]
    simp [griessFormFun]
/-- Nonzero vectors have strictly positive Griess squared length. -/
theorem griessForm_self_pos (x : GriessSpace) (hx : x ≠ 0) : 0 < griessForm x x := by
  have hp := griessForm_self_nonneg x
  have hn : griessForm x x ≠ 0 := by
    intro h
    exact hx ((griessForm_self_eq_zero_iff x).mp h)
  exact lt_of_le_of_ne hp hn.symm
end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
