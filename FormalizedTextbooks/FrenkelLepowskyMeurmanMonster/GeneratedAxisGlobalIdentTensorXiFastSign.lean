module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisGlobalIdentTensorXiFast

/-! # The packed source sign letter with a literal phase mask

In the packed source sign letter (`tensorSign`) most of the kernel time goes into spreading the
4096-bit table `qBits` into a field mask (`spread w qBits (2 ^ 12)`, a 4096-step loop).  At the
field width `64` used for packed tensors this mask is a literal here (`qMask64`, checked once
against the spread).  `tensorSignF` is `tensorSign` with this mask (`tensorSignF_eq`, an equality
of packed lists), and `tensorPlanS` evaluates tensor plans with the fast Xi letter, the fused
monomial runs and the fast sign letter (`tensorPlanS_eq`, `tensorPlanS_rat`, `tensorPlanS_actual`).
-/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
namespace GeneratedAxisGlobalIdent
open scoped BigOperators
set_option autoImplicit false

set_option linter.style.longLine false in
/-- The field mask of `qBits` at field width `64`. -/
def qMask64 : ℕ :=
     |||
    ( <<< 16000) |||
    ( <<< 32000) |||
    ( <<< 48000) |||
    ( <<< 64000) |||
    ( <<< 80000) |||
    ( <<< 96000) |||
    ( <<< 112000) |||
    ( <<< 128000) |||
    ( <<< 144000) |||
    ( <<< 160000) |||
    ( <<< 176000) |||
    ( <<< 192000) |||
    ( <<< 208000) |||
    ( <<< 224000) |||
    ( <<< 240000) |||
    ( <<< 256000)

set_option maxRecDepth 100000 in
/-- The literal mask is the spread table. -/
theorem qMask64_eq : qMask64 = spread 64 qBits (2 ^ 12) := by
  decide +kernel

/-- The field mask of `qBits` at field width `w` (literal at width `64`). -/
def qMaskF (w : ℕ) : ℕ := if w = 64 then qMask64 else spread w qBits (2 ^ 12)

theorem qMaskF_eq (w : ℕ) : qMaskF w = spread w qBits (2 ^ 12) := by
  unfold qMaskF
  split_ifs with h
  · subst h
    exact qMask64_eq
  · rfl

/-- The `Y` phase mask with the fast `qBits` mask. -/
def signYMaskF (w a : ℕ) (ε : ZMod 2) : ℕ :=
  linMask w 12 (parkerThetaMask a &&& 2047) (signC0 a ε) 12 ^^^ bmask w 12 11 ^^^ qMaskF w

theorem signYMaskF_eq (w a : ℕ) (ε : ZMod 2) : signYMaskF w a ε = signYMask w a ε := by
  simp only [signYMaskF, signYMask, qMaskF_eq]

/-- The packed source sign letter on column `j` with the fast masks. -/
def colSignF (w a : ℕ) (ε : ZMod 2) (j : ℕ) (x : SVec) : SVec :=
  sadd
    (scond (bpar (a % 2048 &&& gcol j) 12)
      (sflip (allMask w (2 ^ 12)) (signYMaskF w a ε)
        (strs w 12 (bitsOf (a % 2048))
          (sflip (allMask w (2 ^ 12)) (qMaskF w) (colHalf w true x)))))
    (scond (bpar (gcol j &&& a) 12)
      (sflip (allMask w (2 ^ 12)) (signZMask w a) (colHalf w false x)))

theorem colSignF_eq (w a : ℕ) (ε : ZMod 2) (j : ℕ) (x : SVec) :
    colSignF w a ε j x = colSign w a ε j x := by
  simp only [colSignF, colSign, signYMaskF_eq, qMaskF_eq]

/-- The fast packed source sign letter. -/
def tensorSignF (w a : ℕ) (ε : ZMod 2) (X : List SVec) : List SVec :=
  (List.range 24).map (fun j => colSignF w a ε j (tcol X j))

/-- The fast packed source sign letter is the packed source sign letter. -/
theorem tensorSignF_eq (w a : ℕ) (ε : ZMod 2) (X : List SVec) :
    tensorSignF w a ε X = tensorSign w a ε X := by
  simp only [tensorSignF, tensorSign, colSignF_eq]

/-! ## Plans with the fast sign letter -/

/-- One plan step with the fast Xi letter, the fused runs and the fast sign letter. -/
def TPlan.actS (w : ℕ) : TPlan → List SVec → List SVec
  | .letter (.sign a ε), X => tensorSignF w a.val ε X
  | p, X => p.actF w X

theorem TPlan.actS_eq (w : ℕ) (p : TPlan) (X : List SVec) : p.actS w X = p.actF w X := by
  cases p with
  | letter l =>
    cases l with
    | sign a ε => exact tensorSignF_eq w a.val ε X
    | xi => rfl
    | mono m => rfl
    | qel g => rfl
  | run ls S => rfl

/-- A plan with the fast Xi letter, the fused runs and the fast sign letter. -/
def tensorPlanS (w : ℕ) : List TPlan → List SVec → List SVec
  | [], X => X
  | p :: ps, X => p.actS w (tensorPlanS w ps X)

/-- The fast plan evaluation is the plan evaluation with the fast Xi letter. -/
theorem tensorPlanS_eq (w : ℕ) : ∀ (ps : List TPlan) (X : List SVec),
    tensorPlanS w ps X = tensorPlanF w ps X
  | [], _ => rfl
  | p :: ps, X => by
    simp only [tensorPlanS, tensorPlanF, TPlan.actS_eq, tensorPlanS_eq w ps X]

/-- A fast plan: bounds and the genuine tensor action of the expanded word. -/
theorem tensorPlanS_actual {w B : ℕ} (ps : List TPlan) (hok : planOk ps = true)
    {X : List SVec} (hX : TBnd w B X) (hB : tensorWordGrowthAll (planWord ps) * B < 2 ^ w)
    (D : ℚ) :
    TBnd w (tensorWordGrowthAll (planWord ps) * B) (tensorPlanS w ps X) ∧
      localTensorRepresentation (identWordFiber (planWord ps))
        (generatedAxisGlobalRationalTensorReal (tensorRat w X D)) =
      generatedAxisGlobalRationalTensorReal
        (tensorRat w (tensorPlanS w ps X) (tensorWordDenAll (planWord ps) * D)) := by
  rw [tensorPlanS_eq]
  exact tensorPlanF_actual ps hok hX hB D

/-- A fast plan has the rational tensor of `tensorWordAll` on the expanded word. -/
theorem tensorPlanS_rat {w B : ℕ} (ps : List TPlan) (hok : planOk ps = true) {X : List SVec}
    (hX : TBnd w B X) (hB : tensorWordGrowthAll (planWord ps) * B < 2 ^ w) (D : ℚ) :
    tensorRat w (tensorPlanS w ps X) (tensorWordDenAll (planWord ps) * D) =
      tensorRat w (tensorWordAll w (planWord ps) X) (tensorWordDenAll (planWord ps) * D) := by
  rw [tensorPlanS_eq]
  exact tensorPlanF_rat ps hok hX hB D

end GeneratedAxisGlobalIdent
end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
