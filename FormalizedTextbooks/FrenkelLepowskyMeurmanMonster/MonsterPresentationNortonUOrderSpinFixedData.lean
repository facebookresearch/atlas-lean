/-- The nine exact cached integer vectors before the final primitive output. -/
def states : Vector (Vector (Vector ℤ 64) 64) 9 :=
  ⟨#[state0, state1, state2, state3, state4, state5, state6, state7, state8], by decide⟩

end MonsterNortonFixedTables

/-- An exact cached integer coordinate at one of the nine primitive input stages. -/
def monsterNortonFixedValue (k : Fin 9) (n : Fin 4096) : ℤ :=
  ((MonsterNortonFixedTables.states.get k).get (Fin.ofNat 64 (n.val / 64))).get
    (Fin.ofNat 64 (n.val % 64))

/-- The ten vectors in the fixed-vector test, with target output exactly 128 times the input. -/
def monsterNortonFixedState (k : Fin 10) : NortonUIntegerVector := fun n =>
  if k = 9 then 128 * monsterNortonFixedValue 0 n
  else monsterNortonFixedValue (Fin.ofNat 9 k.val) n

/-- The candidate is nonzero: its exact zero-label coordinate is 26. -/
theorem monsterNortonFixedState_zero_zero : monsterNortonFixedState 0 0 = 26 := by
  decide +kernel

/-- The target vector is exactly 128 times the initial integer vector. -/
theorem monsterNortonFixedState_final :
    monsterNortonFixedState 9 = (128 : ℤ) • monsterNortonFixedState 0 := by
  funext n
  rfl

/-- The twelve-bit coordinate at a specified fixed-vector certificate block and offset. -/
def monsterNortonFixedChunkIndex (k : Fin 16) (n : Fin 256) : Fin 4096 :=
  ⟨256 * k.val + n.val, by omega⟩

/-- The block containing an actual fixed-vector coordinate. -/
def monsterNortonFixedChunkBlock (n : Fin 4096) : Fin 16 := ⟨n.val / 256, by omega⟩

/-- The offset of an actual fixed-vector coordinate in its block. -/
def monsterNortonFixedChunkOffset (n : Fin 4096) : Fin 256 :=
  ⟨n.val % 256, Nat.mod_lt _ (by decide)⟩

/-- The block and offset recover every actual fixed-vector coordinate exactly. -/
theorem monsterNortonFixedChunkIndex_block_offset (n : Fin 4096) :
    monsterNortonFixedChunkIndex (monsterNortonFixedChunkBlock n)
      (monsterNortonFixedChunkOffset n) = n := by
  apply Fin.ext
  simp only [monsterNortonFixedChunkIndex, monsterNortonFixedChunkBlock,
    monsterNortonFixedChunkOffset]
  omega

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
