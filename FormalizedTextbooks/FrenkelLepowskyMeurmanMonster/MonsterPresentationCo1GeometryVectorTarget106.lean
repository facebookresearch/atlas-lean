theorem monsterCo1GeometryVectorTarget106 :
    monsterCo1GeometryVectorValue 106 ∈ monsterCo1GeometryVectorBasisSpan := by
  have hp : ∀ r ∈ ([monsterCo1GeometryVectorRow1, monsterCo1GeometryVectorRow4,
