module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22Abelian

/-! The original auxiliary M22 group is generated by its pair points containing coordinate two. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

private theorem ofMul_list_prod {K : Type*} [Group K] (row : List K) :
    (row.map Additive.ofMul).sum = Additive.ofMul row.prod := by
  induction row with
  | nil => rfl
  | cons a row ih => rw [List.map_cons, List.sum_cons, ih, List.prod_cons, ofMul_mul]

/-- Every original group point image is the actual ordered product of its certified basis row. -/
theorem co1ResidueM22_representation_point_product {G : Type*} [Group G]
    (phi : Co1ResidueM22Point 0 1 → G) (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s * phi t * phi u = 1)
    (hgen : Subgroup.closure (Set.range phi) = ⊤) (i : Fin 231) :
    phi (co1ResidueM22FinitePoint i) =
      ((co1ResidueM22LinearBasisRow i).map (phi ∘ co1ResidueM22FinitePoint)).prod := by
  let hcomm := co1ResidueM22_representation_abelian phi hsquare hline hgen
  have hker : (Abelianization.of : G →* Abelianization G).ker = ⊥ :=
    (Abelianization.ker_of G).trans ((commutator_eq_bot_iff G).mpr hcomm)
  have hinj := (MonoidHom.ker_eq_bot_iff (Abelianization.of : G →* Abelianization G)).mp hker
  let : Module (ZMod 2) (Additive (Abelianization G)) :=
    co1ResidueClassTwoAbelianModule phi hsquare hgen
  let psi : Co1ResidueM22Point 0 1 → Additive (Abelianization G) :=
    fun s => Additive.ofMul (Abelianization.of (phi s))
  have hl : ∀ s t u, co1ResidueM22Line 0 1 s t u → psi s + psi t + psi u = 0 := by
    intro s t u hstu
    change Additive.ofMul (Abelianization.of (phi s)) +
      Additive.ofMul (Abelianization.of (phi t)) +
      Additive.ofMul (Abelianization.of (phi u)) = 0
    rw [← ofMul_mul, ← ofMul_mul, ← map_mul, ← map_mul, hline s t u hstu, map_one]
    rfl
  have he := co1ResidueM22Linear_point_reduction psi hl i
  have hr := ofMul_list_prod
    (((co1ResidueM22LinearBasisRow i).map (phi ∘ co1ResidueM22FinitePoint)).map
      (Abelianization.of : G →* Abelianization G))
  have hr' : ((co1ResidueM22LinearBasisRow i).map (psi ∘ co1ResidueM22FinitePoint)).sum =
      Additive.ofMul (Abelianization.of
        ((co1ResidueM22LinearBasisRow i).map (phi ∘ co1ResidueM22FinitePoint)).prod) := by
    simpa only [List.map_map, Function.comp_def, psi, map_list_prod] using hr
  apply hinj
  apply Additive.ofMul.injective
  exact he.trans hr'

/-- Every selected basis point lies in the actual twenty-one-point coordinate-two star. -/
theorem co1ResidueM22LinearBasis_in_star (k : Fin 11) :
    (2 : Fin 24) ∈ (co1ResidueM22FinitePoint (co1ResidueM22LinearBasis k)).val := by
  have h : ∀ k : Fin 11,
      (2 : Fin 24) ∈ (co1ResidueM22FinitePoint (co1ResidueM22LinearBasis k)).val := by
    decide +kernel
  exact h k

/-- The actual pair-point star at coordinate two generates every original M22 representation. -/
theorem co1ResidueM22_representation_star_generates {G : Type*} [Group G]
    (phi : Co1ResidueM22Point 0 1 → G) (hsquare : ∀ s, phi s * phi s = 1)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s * phi t * phi u = 1)
    (hgen : Subgroup.closure (Set.range phi) = ⊤) :
    Subgroup.closure {g | ∃ s : Co1ResidueM22Point 0 1,
      (2 : Fin 24) ∈ s.val ∧ g = phi s} = ⊤ := by
  apply top_unique
  rw [← hgen]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨s, rfl⟩
  obtain ⟨i, rfl⟩ := co1ResidueM22FinitePoint_surjective s
  rw [co1ResidueM22_representation_point_product phi hsquare hline hgen i]
  apply list_prod_mem
  intro g hg
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hg
  unfold co1ResidueM22LinearBasisRow at hk
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hk
  exact Subgroup.subset_closure ⟨_, co1ResidueM22LinearBasis_in_star j, rfl⟩

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
