    y322RawEquationWordAllowed 9042 (y422CosetSourceRaw37 i).1 ∧
      y322RawEquationWordAllowed 9042 (y422CosetSourceRaw37 i).2 := by
  revert i
  decide +kernel

/-- Exact decoded source equation, preserving every bound-checked signed letter. -/
def y422CosetSourceEquation37 (i : Fin 128) : Y322WordEquation (Fin 9042) :=
  ⟨y322RawEquationWordDecode 9042 (y422CosetSourceRaw37 i).1
      (y422CosetSourceRaw37_allowed i).1,
    y322RawEquationWordDecode 9042 (y422CosetSourceRaw37 i).2
      (y422CosetSourceRaw37_allowed i).2⟩

