/-- The complete integer prefix candidate on all original source labels. -/
def monsterNortonCodeSeventeenSpinPrefixDense (n : Fin 4096) : ℤ :=
  monsterNortonCodeSeventeenSpinPrefixTable ⟨n.val / 512, by omega⟩
    ⟨n.val / 64 % 8, Nat.mod_lt _ (by decide)⟩
    ⟨n.val / 8 % 8, Nat.mod_lt _ (by decide)⟩ ⟨n.val % 8, Nat.mod_lt _ (by decide)⟩

/-- The complete integer candidate has exactly squared norm sixty-four. -/
theorem monsterNortonCodeSeventeenSpinPrefixDense_norm_integer :
    (∑ n : Fin 4096, monsterNortonCodeSeventeenSpinPrefixDense n ^ 2) = 64 := by
  decide +kernel

/-- All supported candidate entries have the exact listed signs. -/
theorem monsterNortonCodeSeventeenSpinPrefixDense_support (i : Fin 16) :
    monsterNortonCodeSeventeenSpinPrefixDense (monsterNortonCodeSeventeenSpinPrefixLabel i) =
      monsterNortonCodeSeventeenSpinPrefixCoefficient i := by
  revert i
  decide +kernel

/-- The listed original prefix coordinates are distinct. -/
theorem monsterNortonCodeSeventeenSpinPrefixLabel_injective :
    Function.Injective monsterNortonCodeSeventeenSpinPrefixLabel := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  have hc : ∀ i : Fin 15, monsterNortonCodeSeventeenSpinPrefixLabel i.castSucc <
      monsterNortonCodeSeventeenSpinPrefixLabel i.succ := by decide +kernel
  exact hc

/-- Every prefix coefficient has exact squared magnitude one. -/
theorem monsterNortonCodeSeventeenSpinPrefixCoefficient_sq (i : Fin 16) :
    monsterNortonCodeSeventeenSpinPrefixCoefficient i ^ 2 = 4 := by
  revert i
