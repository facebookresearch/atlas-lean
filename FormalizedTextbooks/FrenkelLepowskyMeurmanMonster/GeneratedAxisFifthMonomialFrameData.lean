-- Check 90 actual integer lattice images in every physical coordinate.
/-- Each displayed integer vector is the genuine physical permutation image. -/
theorem generatedFifthMonomial_frame_physical_certificate :
    ∀ k : Fin 6, ∀ j : Fin 15, ∀ i : Fin 24,
      (leechBasisMatrix *ᵥ (generatedFifthMonomialFrameImageInteger k).col j)
        (generatedFifthMonomialSpatialForward k i) =
      generatedFifthFrameNormEightPhysical i j := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
-- Check the binary classes of all 90 genuine integral images.
/-- Each displayed actual integral image has its asserted frame-system class. -/
theorem generatedFifthMonomial_frame_binary_certificate :
    ∀ k : Fin 6, ∀ j : Fin 15,
      leechHyperbolicInverse *ᵥ
          integerParity ((generatedFifthMonomialFrameImageInteger k).col j) =
        generatedFifthFrameIncidentClass (generatedFifthMonomialFrameImageIndex k j) := by
  decide +kernel

/-- The six physical permutations preserve the actual selected octad. -/
theorem generatedFifthMonomial_octad_certificate : ∀ k : Fin 6, ∀ i : Fin 24,
    Nat.testBit 0x0f000f (generatedFifthMonomialSpatialForward k i).val =
      Nat.testBit 0x0f000f i.val := by
  decide +kernel

