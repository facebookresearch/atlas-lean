-- Verify the final sparse row using only prior proved original-source equations.
/-- Target point 191 belongs to the proposed source span by the exact finite source certificate. -/
theorem monsterCo1GeometryVectorTarget191 :
    monsterCo1GeometryVectorValue 191 ∈ monsterCo1GeometryVectorBasisSpan := by
  have hp : ∀ r ∈ ([monsterCo1GeometryVectorRow1, monsterCo1GeometryVectorRow15,
      monsterCo1GeometryVectorRow45, monsterCo1GeometryVectorRow54,
      monsterCo1GeometryVectorRow55, monsterCo1GeometryVectorRow91,
      monsterCo1GeometryVectorRow101, monsterCo1GeometryVectorRow191,
      monsterCo1GeometryVectorRow195, monsterCo1GeometryVectorRow208,
      monsterCo1GeometryVectorRow265] : List (List (Fin 867))),
      monsterCo1GeometryVectorRowEval monsterCo1GeometryVectorValue r = 0 := by
    intro r hr
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact monsterCo1GeometryVectorEquation1
    · exact monsterCo1GeometryVectorEquation15
    · exact monsterCo1GeometryVectorEquation45
    · exact monsterCo1GeometryVectorEquation54
    · exact monsterCo1GeometryVectorEquation55
    · exact monsterCo1GeometryVectorEquation91
    · exact monsterCo1GeometryVectorEquation101
    · exact monsterCo1GeometryVectorEquation191
    · exact monsterCo1GeometryVectorEquation195
    · exact monsterCo1GeometryVectorEquation208
    · exact monsterCo1GeometryVectorEquation265
  have hs : monsterCo1GeometryVectorRowEval monsterCo1GeometryVectorValue [191, 3, 6, 9,
      10, 11] = 0 := by
    apply monsterCo1GeometryVectorRowEval_zero_of_prior _ [monsterCo1GeometryVectorRow1,
      monsterCo1GeometryVectorRow15, monsterCo1GeometryVectorRow45,
      monsterCo1GeometryVectorRow54, monsterCo1GeometryVectorRow55,
      monsterCo1GeometryVectorRow91, monsterCo1GeometryVectorRow101,
      monsterCo1GeometryVectorRow191, monsterCo1GeometryVectorRow195,
      monsterCo1GeometryVectorRow208, monsterCo1GeometryVectorRow265] hp
    decide +kernel
  apply monsterCo1GeometryVectorRowEval_leading_mem _ _ 191 [3, 6, 9, 10, 11] _ hs
  have hb : ∀ j ∈ ([3, 6, 9, 10, 11] : List (Fin 867)), j.val < 24 := by decide +kernel
  exact fun j hj => monsterCo1GeometryVectorBasis_mem j (hb j hj)

