set_option maxHeartbeats 8000000 in
-- Compare all original source lookup values in this closed 256-coordinate interval.
private theorem block_00 : ∀ u : Fin 256,
    if _h : 20480 + u.val < 48576 then
      generatedTwelfthIncomingOctadCache
        ⟨(20480 + u.val) / 64, by omega⟩
        ⟨(20480 + u.val) % 64, Nat.mod_lt _ (by decide)⟩ =
      generatedTwelfthIncomingShortCoefficient (Sum.inr (Sum.inl
        (⟨(20480 + u.val) / 64, by omega⟩,
          ⟨(20480 + u.val) % 64, Nat.mod_lt _ (by decide)⟩))) else True := by
  decide +kernel

