/-- All original coefficients in this bounded packet equal the complete signed cache. -/
theorem generatedTwelfth_incoming_octad_cache_packet_05 (u : Fin 4096) :
    if _h : 5 * 4096 + u.val < 48576 then
      generatedTwelfthIncomingOctadCache
        ⟨(5 * 4096 + u.val) / 64, by omega⟩
        ⟨(5 * 4096 + u.val) % 64, Nat.mod_lt _ (by decide)⟩ =
      generatedTwelfthIncomingShortCoefficient (Sum.inr (Sum.inl
        (⟨(5 * 4096 + u.val) / 64, by omega⟩,
          ⟨(5 * 4096 + u.val) % 64, Nat.mod_lt _ (by decide)⟩))) else True := by
  have hp : ∀ (b : Fin 16) (v : Fin 256),
    if _h : 5 * 4096 + b.val * 256 + v.val < 48576 then
      generatedTwelfthIncomingOctadCache
        ⟨(5 * 4096 + b.val * 256 + v.val) / 64, by omega⟩
        ⟨(5 * 4096 + b.val * 256 + v.val) % 64, Nat.mod_lt _ (by decide)⟩ =
      generatedTwelfthIncomingShortCoefficient (Sum.inr (Sum.inl
        (⟨(5 * 4096 + b.val * 256 + v.val) / 64, by omega⟩,
          ⟨(5 * 4096 + b.val * 256 + v.val) % 64, Nat.mod_lt _ (by decide)⟩))) else True := by
    intro b v
    fin_cases b
    · exact block_00 v
    · exact block_01 v
    · exact block_02 v
    · exact block_03 v
    · exact block_04 v
    · exact block_05 v
    · exact block_06 v
    · exact block_07 v
    · exact block_08 v
    · exact block_09 v
    · exact block_10 v
    · exact block_11 v
    · exact block_12 v
    · exact block_13 v
    · exact block_14 v
    · exact block_15 v
  have hh := hp ⟨u.val / 256, by omega⟩ ⟨u.val % 256, Nat.mod_lt _ (by decide)⟩
  have he : u.val / 256 * 256 + u.val % 256 = u.val := by omega
  simpa only [Nat.add_assoc, he] using hh

