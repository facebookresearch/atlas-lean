module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationTenthLocalUpper

/-! The complete actual Tenth matrix group is generated by its anchor and two root moves.
The final theorem exposes the genuine full-axis lift obligations without assuming them. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- A subgroup containing the two actual root letters reaches every original root class. -/
theorem generatedTenth_axis_lower_recovery_subgroup_reachable
    (S : Subgroup generatedTenthE7StandardMatrixGroup)
    (hletters : ∀ k : Fin 2, generatedTenthE7RootOrbitLetter k ∈ S) (n : Fin 63) :
    ∃ g : generatedTenthE7StandardMatrixGroup, g ∈ S ∧
      leechModTwoAction g.val (generatedTenthE7OrbitNodeClass 0) =
        generatedTenthE7OrbitNodeClass n := by
  generalize he : n.val = r
  induction r using Nat.strong_induction_on generalizing n with
  | h r ih =>
    by_cases hz : n = 0
    · subst n
      refine ⟨1, S.one_mem, ?_⟩
      change leechModTwoAction 1 _ = _
      rw [map_one]
      rfl
    · have hlt : (generatedTenthE7OrbitParent n).val < r := by
        rw [← he]
        exact generatedTenth_e7_orbit_parent_lt n hz
      obtain ⟨g, hgS, hg⟩ := ih _ hlt (generatedTenthE7OrbitParent n) rfl
      refine ⟨generatedTenthE7RootOrbitLetter (generatedTenthE7OrbitLetter n) * g,
        S.mul_mem (hletters _) hgS, ?_⟩
      change leechModTwoAction
        (generatedTenthE7OrbitSpatialLetter (generatedTenthE7OrbitLetter n) * g.val) _ = _
      rw [map_mul]
      change leechModTwoAction (generatedTenthE7OrbitSpatialLetter
        (generatedTenthE7OrbitLetter n))
          (leechModTwoAction g.val (generatedTenthE7OrbitNodeClass 0)) = _
      rw [hg]
      exact generatedTenth_e7_orbit_edge_class n
        (generatedTenth_e7_orbit_edges_actual n hz)

/-- The entire actual anchor and the two genuine root letters generate the whole matrix group. -/
theorem generatedTenth_axis_lower_recovery_subgroup_eq_top
    (S : Subgroup generatedTenthE7StandardMatrixGroup)
    (hanchor : generatedTenthE7ActualAnchorStabilizer ≤ S)
    (hletters : ∀ k : Fin 2, generatedTenthE7RootOrbitLetter k ∈ S) : S = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨n, hn⟩ := generatedTenthE7RootShortLabelEquiv.surjective
    (g • generatedTenthE7RootShortLabelEquiv 0)
  obtain ⟨k, hkS, hk⟩ :=
    generatedTenth_axis_lower_recovery_subgroup_reachable S hletters n
  have hkroot : k • generatedTenthE7RootShortLabelEquiv 0 =
      generatedTenthE7RootShortLabelEquiv n := by
    apply Subtype.ext
    change griessShortPermutation k.val (generatedTenthE7OrbitNodeLabel 0) =
      generatedTenthE7OrbitNodeLabel n
    apply griessShortClass_injective
    rw [griessShortPermutation_class, ← generatedTenth_e7_orbit_node_class_actual,
      hk, generatedTenth_e7_orbit_node_class_actual]
  have hkg : k⁻¹ * g ∈ generatedTenthE7ActualAnchorStabilizer := by
    change (k⁻¹ * g) • generatedTenthE7RootShortLabelEquiv 0 =
      generatedTenthE7RootShortLabelEquiv 0
    rw [mul_smul, ← hn, ← hkroot, inv_smul_smul]
  have hm := S.mul_mem hkS (hanchor hkg)
  simpa only [mul_inv_cancel_left] using hm

/-- The genuine Conway projection of the complete matrix group in standard root coordinates. -/
def generatedTenthAxisLowerRecoverySpatialProjection :
    generatedTenthE7StandardMatrixGroup →* Co1 :=
  (QuotientGroup.mk' signsSubgroup).comp
    (generatedTenthE7OrbitConjugation.comp generatedTenthE7StandardMatrixGroup.subtype)

/-- Genuine full-axis lifts of all actual anchor candidates and both root moves suffice.
This is a reduction theorem; its lift hypotheses must be proved from full coordinates. -/
theorem generatedTenth_axis_lower_recovery_projection_eq_spatial
    (hanchor : ∀ v : generatedTenthE7SignedFlagCandidates,
      generatedTenthAxisLowerRecoverySpatialProjection
        (generatedTenthE7SignedAnchorEnumeration v).val ∈
          generatedTenthProjectedAxisStabilizer)
    (hletters : ∀ k : Fin 2,
      generatedTenthAxisLowerRecoverySpatialProjection (generatedTenthE7RootOrbitLetter k) ∈
        generatedTenthProjectedAxisStabilizer) :
    generatedTenthProjectedAxisStabilizer = generatedTenthCo1SpatialStabilizer := by
  let S := generatedTenthProjectedAxisStabilizer.comap
    generatedTenthAxisLowerRecoverySpatialProjection
  have ha : generatedTenthE7ActualAnchorStabilizer ≤ S := by
    intro g hg
    obtain ⟨v, hv⟩ := generatedTenth_e7_signed_anchor_enumeration_surjective ⟨g, hg⟩
    have he : (generatedTenthE7SignedAnchorEnumeration v).val = g :=
      congrArg Subtype.val hv
    change generatedTenthAxisLowerRecoverySpatialProjection g ∈
      generatedTenthProjectedAxisStabilizer
    rw [← he]
    exact hanchor v
  have hs : S = ⊤ := generatedTenth_axis_lower_recovery_subgroup_eq_top S ha hletters
  apply le_antisymm generatedTenthProjectedAxisStabilizer_le_spatial
  rintro c ⟨g, hg, hc⟩
  obtain ⟨k, hk⟩ := generatedTenthE7OriginalMatrixGroupEquiv.surjective ⟨g, hg⟩
  have hkg : generatedTenthE7OrbitConjugation k.val = g := congrArg Subtype.val hk
  have hkm : k ∈ S := by rw [hs]; trivial
  change generatedTenthAxisLowerRecoverySpatialProjection k ∈
    generatedTenthProjectedAxisStabilizer at hkm
  change QuotientGroup.mk' signsSubgroup (generatedTenthE7OrbitConjugation k.val) ∈
    generatedTenthProjectedAxisStabilizer at hkm
  rwa [hkg, hc] at hkm

/-- Proved genuine lift obligations close the exact entire full-axis stabilizer count. -/
theorem generatedTenth_axis_lower_recovery_local_card
    (hanchor : ∀ v : generatedTenthE7SignedFlagCandidates,
      generatedTenthAxisLowerRecoverySpatialProjection
        (generatedTenthE7SignedAnchorEnumeration v).val ∈
          generatedTenthProjectedAxisStabilizer)
    (hletters : ∀ k : Fin 2,
      generatedTenthAxisLowerRecoverySpatialProjection (generatedTenthE7RootOrbitLetter k) ∈
        generatedTenthProjectedAxisStabilizer) :
    Nat.card generatedTenthLocalAxisStabilizer = 2903040 := by
  rw [generatedTenth_local_stabilizer_card_range,
    generatedTenth_axis_lower_recovery_projection_eq_spatial hanchor hletters,
    generatedTenth_Co1_spatial_stabilizer_card]

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
