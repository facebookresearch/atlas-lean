    · exact generatedSixth_xi_tensor_fix63 a i
  let b : Fin 64 := ⟨n.val / 64, by omega⟩
  let a : Fin 64 := ⟨n.val % 64, by omega⟩
  have he : (⟨b.val * 64 + a.val, by omega⟩ : Fin 4096) = n := by
    apply Fin.ext
    dsimp [b, a]
    omega
  have hh := h b a
  rw [he] at hh
  exact hh hn

