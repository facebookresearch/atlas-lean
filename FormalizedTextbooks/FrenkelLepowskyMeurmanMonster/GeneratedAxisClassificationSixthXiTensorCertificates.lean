/-! All bounded signed checks cover the complete genuine nonzero tensor support. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 10000

set_option maxHeartbeats 4000000 in
-- The sixty-four checked intervals cover all 4096 original spin labels.
/-- Every nonzero original tensor coefficient has its full corrected Xi integer image. -/
theorem generatedSixth_xi_tensor_integer_supported_fixed (n : Fin 4096) (i : Fin 24)
    (hn : generatedSixthTensorFastExecutable n i ≠ 0) :
    generatedSixthXiCachedTensor n i = 16 * generatedSixthTensorFastExecutable n i := by
  have h : ∀ b : Fin 64, ∀ a : Fin 64,
      generatedSixthTensorFastExecutable ⟨b.val * 64 + a.val, by omega⟩ i ≠ 0 →
        generatedSixthXiCachedTensor ⟨b.val * 64 + a.val, by omega⟩ i =
          16 * generatedSixthTensorFastExecutable ⟨b.val * 64 + a.val, by omega⟩ i := by
    intro b a
    fin_cases b
    · exact generatedSixth_xi_tensor_fix00 a i
    · exact generatedSixth_xi_tensor_fix01 a i
    · exact generatedSixth_xi_tensor_fix02 a i
    · exact generatedSixth_xi_tensor_fix03 a i
    · exact generatedSixth_xi_tensor_fix04 a i
    · exact generatedSixth_xi_tensor_fix05 a i
    · exact generatedSixth_xi_tensor_fix06 a i
