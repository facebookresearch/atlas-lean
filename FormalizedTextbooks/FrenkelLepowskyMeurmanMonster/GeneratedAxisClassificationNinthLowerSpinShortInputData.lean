/-! Full preferred-short addresses and normalized integer coefficient cache.
The actual Ninth source coefficient equality remains a separate prerequisite. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option maxRecDepth 100000

/-- Every original preferred-short family, in pair, octad, odd address order. -/
def generatedNinthLowerSpinShortIndex (a : Fin 98280) : GriessShortIndex :=
  if h : a.val < 552 then
    Sum.inl (⟨a.val / 276, by omega⟩, ⟨a.val % 276, Nat.mod_lt _ (by decide)⟩)
  else if h' : a.val < 49128 then
    Sum.inr (Sum.inl (⟨(a.val - 552) / 64, by omega⟩,
      ⟨(a.val - 552) % 64, Nat.mod_lt _ (by decide)⟩))
  else
    Sum.inr (Sum.inr (⟨(a.val - 49128) / 24, by omega⟩,
      ⟨(a.val - 49128) % 24, Nat.mod_lt _ (by decide)⟩))

/-- Exact inverse addresses of all original preferred-short coordinates. -/
def generatedNinthLowerSpinShortAddress : GriessShortIndex → Fin 98280
  | Sum.inl (s, p) => ⟨s.val * 276 + p.val, by omega⟩
  | Sum.inr (Sum.inl (j, e)) => ⟨552 + j.val * 64 + e.val, by omega⟩
  | Sum.inr (Sum.inr (d, j)) => ⟨49128 + d.val * 24 + j.val, by omega⟩

/-- Each complete finite address returns after decoding its original dictionary coordinate. -/
theorem generatedNinth_lower_spin_short_address_index (a : Fin 98280) :
    generatedNinthLowerSpinShortAddress (generatedNinthLowerSpinShortIndex a) = a := by
  by_cases h : a.val < 552
  · simp only [generatedNinthLowerSpinShortIndex, dite_eq_left h,
      generatedNinthLowerSpinShortAddress]
    apply Fin.ext
    dsimp
    omega
  · by_cases h' : a.val < 49128
    · simp only [generatedNinthLowerSpinShortIndex, dite_eq_right h, dite_eq_left h',
        generatedNinthLowerSpinShortAddress]
      apply Fin.ext
      dsimp
      omega
    · simp only [generatedNinthLowerSpinShortIndex, dite_eq_right h, dite_eq_right h',
        generatedNinthLowerSpinShortAddress]
      apply Fin.ext
      dsimp
      omega

/-- Every original preferred coordinate returns after its exact finite address is decoded. -/
theorem generatedNinth_lower_spin_short_index_address (r : GriessShortIndex) :
    generatedNinthLowerSpinShortIndex (generatedNinthLowerSpinShortAddress r) = r := by
  rcases r with ⟨s, p⟩ | (⟨j, e⟩ | ⟨d, j⟩)
  · have h : s.val * 276 + p.val < 552 := by omega
    dsimp only [generatedNinthLowerSpinShortAddress, generatedNinthLowerSpinShortIndex]
    rw [dite_eq_left h]
    apply congrArg Sum.inl
    apply Prod.ext <;> apply Fin.ext <;> dsimp <;> omega
  · have h : ¬552 + j.val * 64 + e.val < 552 := by omega
    have h' : 552 + j.val * 64 + e.val < 49128 := by omega
    dsimp only [generatedNinthLowerSpinShortAddress, generatedNinthLowerSpinShortIndex]
    rw [dite_eq_right h, dite_eq_left h']
    apply congrArg Sum.inr
    apply congrArg Sum.inl
    apply Prod.ext <;> apply Fin.ext <;> dsimp <;> omega
  · have h : ¬49128 + d.val * 24 + j.val < 552 := by omega
    have h' : ¬49128 + d.val * 24 + j.val < 49128 := by omega
    dsimp only [generatedNinthLowerSpinShortAddress, generatedNinthLowerSpinShortIndex]
    rw [dite_eq_right h, dite_eq_right h']
    apply congrArg Sum.inr
    apply congrArg Sum.inr
    apply Prod.ext <;> apply Fin.ext <;> dsimp <;> omega

/-- All 98,280 original preferred coordinates occur exactly once in the address cache. -/
def generatedNinthLowerSpinShortEquiv : Fin 98280 ≃ GriessShortIndex where
  toFun := generatedNinthLowerSpinShortIndex
  invFun := generatedNinthLowerSpinShortAddress
  left_inv := generatedNinth_lower_spin_short_address_index
  right_inv := generatedNinth_lower_spin_short_index_address

/-- Balanced packed preferred-short address lookup, without enumerating the dictionary. -/
def generatedNinthLowerSpinShortWord (words : Fin 24 → Fin 16 → Fin 16 → ℕ)
    (a : Fin 98280) : ℕ :=
  words ⟨a.val / 4096, by omega⟩
    ⟨a.val / 256 % 16, Nat.mod_lt _ (by decide)⟩
    ⟨a.val / 16 % 16, Nat.mod_lt _ (by decide)⟩

