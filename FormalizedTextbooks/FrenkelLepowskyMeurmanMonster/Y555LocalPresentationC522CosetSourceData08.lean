-- Exact signed-letter bounds are checked for at most 128 literal source pairs.
/-- Both literal source sides belong to the exact actual finite symbol alphabet. -/
theorem y522CosetSourceRaw08_allowed (i : Fin 128) :
    y322RawEquationWordAllowed 1806 (y522CosetSourceRaw08 i).1 ∧
      y322RawEquationWordAllowed 1806 (y522CosetSourceRaw08 i).2 := by
  revert i
  decide +kernel

/-- Exact decoded source equation, preserving every bound-checked signed letter. -/
def y522CosetSourceEquation08 (i : Fin 128) : Y322WordEquation (Fin 1806) :=
  ⟨y322RawEquationWordDecode 1806 (y522CosetSourceRaw08 i).1
      (y522CosetSourceRaw08_allowed i).1,
    y322RawEquationWordDecode 1806 (y522CosetSourceRaw08 i).2
      (y522CosetSourceRaw08_allowed i).2⟩

