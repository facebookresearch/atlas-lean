module

import all Init.Data.Nat.Bitwise.Basic

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Co1ResidueM22LinearCertificates
public import Mathlib.LinearAlgebra.StdBasis
public import Mathlib.Algebra.Module.ZMod
public import Mathlib.Algebra.Group.Submonoid.BigOperators

/-! Every binary linear representation of the original auxiliary M22 hexad geometry
is generated by eleven selected original point images. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false

private theorem decode_hxor {n : Nat} (a b : Nat) :
    monsterCo1GeometryBinaryMaskDecode (n := n) (a ^^^ b) =
      monsterCo1GeometryBinaryMaskDecode a + monsterCo1GeometryBinaryMaskDecode b :=
  monsterCo1GeometryBinaryMaskDecode_xor a b

private theorem decode_single {n : Nat} (i : Fin n) :
    monsterCo1GeometryBinaryMaskDecode (n := n) (2 ^ i.val) = Pi.single i (1 : ZMod 2) := by
  ext j
  simp only [monsterCo1GeometryBinaryMaskDecode, Nat.testBit_two_pow]
  by_cases h : i = j
  · subst j
    simp
  · have hv : i.val ≠ j.val := fun hh => h (Fin.ext hh)
    simp [hv, h]

/-- The free binary linear evaluation sending each literal address to its actual point image. -/
def co1ResidueM22LinearEvaluate {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (phi : Co1ResidueM22Point 0 1 → V) : (Fin 231 → ZMod 2) →ₗ[ZMod 2] V :=
  (Pi.basisFun (ZMod 2) (Fin 231)).constr (ZMod 2) (phi ∘ co1ResidueM22FinitePoint)

private theorem evaluate_single {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (phi : Co1ResidueM22Point 0 1 → V) (i : Fin 231) :
    co1ResidueM22LinearEvaluate phi
      (monsterCo1GeometryBinaryMaskDecode (n := 231) (2 ^ i.val)) =
        phi (co1ResidueM22FinitePoint i) := by
  rw [decode_single]
  simpa only [co1ResidueM22LinearEvaluate, Pi.basisFun_apply, Function.comp_apply] using
    (Pi.basisFun (ZMod 2) (Fin 231)).constr_basis (ZMod 2)
      (phi ∘ co1ResidueM22FinitePoint) i

private theorem evaluate_line {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (phi : Co1ResidueM22Point 0 1 → V)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s + phi t + phi u = 0)
    (l : Fin 1155) : co1ResidueM22LinearEvaluate phi
      (monsterCo1GeometryBinaryMaskDecode (n := 231) (co1ResidueM22LinearLineMask l)) = 0 := by
  simp only [co1ResidueM22LinearLineMask, decode_hxor,
    map_add, evaluate_single]
  exact hline _ _ _ (co1ResidueM22LinearLines_genuine l)

/-- Every actual point image is the certified binary sum of the eleven selected point images.
Only original hexad-line relations are used. -/
theorem co1ResidueM22Linear_point_reduction {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (phi : Co1ResidueM22Point 0 1 → V)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s + phi t + phi u = 0)
    (i : Fin 231) : phi (co1ResidueM22FinitePoint i) =
      ((co1ResidueM22LinearBasisRow i).map (phi ∘ co1ResidueM22FinitePoint)).sum := by
  let F := co1ResidueM22LinearEvaluate phi
  have hc := congrArg (fun a : Nat => F (monsterCo1GeometryBinaryMaskDecode (n := 231) a))
    (co1ResidueM22LinearCertificates_correct i)
  have hz : F (monsterCo1GeometryBinaryMaskDecode (n := 231)
      (monsterCo1GeometryBinaryMaskSum
        ((co1ResidueM22LinearCertificates i).map co1ResidueM22LinearLineMask))) = 0 := by
    rw [monsterCo1GeometryBinaryMaskDecode_sum, map_list_sum]
    simp only [List.map_map]
    apply List.sum_eq_zero
    intro x hx
    obtain ⟨l, _, rfl⟩ := List.mem_map.mp hx
    exact evaluate_line phi hline l
  have hb : F (monsterCo1GeometryBinaryMaskDecode (n := 231) (co1ResidueM22LinearBasisMask i)) =
      ((co1ResidueM22LinearBasisRow i).map (phi ∘ co1ResidueM22FinitePoint)).sum := by
    rw [co1ResidueM22LinearBasisMask, monsterCo1GeometryBinaryMaskDecode_sum,
      map_list_sum]
    simp only [List.map_map]
    congr 1
    apply List.map_congr_left
    intro k _
    exact evaluate_single phi k
  rw [hz, decode_hxor, map_add, evaluate_single, hb] at hc
  have h := congrArg (fun v : V => v +
      ((co1ResidueM22LinearBasisRow i).map (phi ∘ co1ResidueM22FinitePoint)).sum) hc
  simpa only [zero_add, add_assoc, ZModModule.add_self, add_zero] using h.symm

/-- All point images lie in the span of the eleven selected original point images. -/
theorem co1ResidueM22Linear_span_le {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (phi : Co1ResidueM22Point 0 1 → V)
    (hline : ∀ s t u, co1ResidueM22Line 0 1 s t u → phi s + phi t + phi u = 0) :
    Submodule.span (ZMod 2) (Set.range phi) ≤ Submodule.span (ZMod 2)
      (Set.range (fun k : Fin 11 =>
        phi (co1ResidueM22FinitePoint (co1ResidueM22LinearBasis k)))) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨s, rfl⟩
  obtain ⟨i, rfl⟩ := co1ResidueM22FinitePoint_surjective s
  rw [co1ResidueM22Linear_point_reduction phi hline i]
  apply list_sum_mem
  intro v hv
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hv
  unfold co1ResidueM22LinearBasisRow at hk
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hk
  exact Submodule.subset_span ⟨j, rfl⟩

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
