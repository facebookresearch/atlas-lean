set_option maxHeartbeats 8000000 in
-- Check each actual outer monomial value independently of the Gaussian finite sum.
/-- Every cached outer input is calculated by its actual monomial definition. -/
theorem monsterNortonMixedOddOuterInput_actual (k : Fin 5) (i : Fin 128) :
    monsterNortonOddInverseSpinOuterInput (monsterNortonMixedOddSpinLabel k i) =
      monsterNortonMixedOddOuterInput k i := by
  revert k i
  decide +kernel

set_option maxHeartbeats 8000000 in
-- Check each actual outer monomial value independently of the Gaussian finite sum.
/-- Every cached outer sign is calculated by its actual monomial definition. -/
theorem monsterNortonMixedOddOuterSign_actual (k : Fin 5) (i : Fin 128) :
    monsterNortonOddInverseSpinOuterSign (monsterNortonMixedOddSpinLabel k i) =
      monsterNortonMixedOddOuterSign k i := by
  revert k i
  decide +kernel

