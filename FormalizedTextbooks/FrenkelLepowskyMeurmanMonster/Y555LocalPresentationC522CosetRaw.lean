/-- Interval offsets agree with the exact uniform indexing, including the final interval. -/
theorem y522CosetRawChunks_offset (b : Fin 81) :
    (y522CosetRawChunks b).offset = 128 * b.val := by
  revert b
  decide +kernel

/-- The final interval retains its actual size rather than padding extra entries. -/
theorem y522CosetRawChunks_size (b : Fin 81) :
    (y522CosetRawChunks b).size = if b.val < 80 then 128 else 56 := by
  revert b
  decide +kernel

/-- Every actual interval lies inside the exact global finite bound. -/
theorem y522CosetRawChunks_end (b : Fin 81) :
    (y522CosetRawChunks b).offset + (y522CosetRawChunks b).size ≤ 10296 := by
  rw [y522CosetRawChunks_offset, y522CosetRawChunks_size]
  split_ifs <;> omega

/-- The unique interval containing a given actual finite index. -/
def y522CosetRawBlock (i : Fin 10296) : Fin 81 := ⟨i.val / 128, by omega⟩

/-- The exact local index inside that interval, with the final shorter bound checked. -/
def y522CosetRawLocal (i : Fin 10296) : Fin (y522CosetRawChunks (y522CosetRawBlock i)).size :=
  ⟨i.val % 128, by
    rw [y522CosetRawChunks_size]
    unfold y522CosetRawBlock
    dsimp only
    split_ifs <;> omega⟩

/-- Assemble a local interval index into its exact original global index. -/
def y522CosetRawGlobal (b : Fin 81) (j : Fin (y522CosetRawChunks b).size) : Fin 10296 :=
  ⟨(y522CosetRawChunks b).offset + j.val,
    (Nat.add_lt_add_left j.isLt _).trans_le (y522CosetRawChunks_end b)⟩

/-- Interval lookup and assembly preserve the original index exactly. -/
theorem y522CosetRawGlobal_local (i : Fin 10296) :
    y522CosetRawGlobal (y522CosetRawBlock i) (y522CosetRawLocal i) = i := by
  apply Fin.ext
  change (y522CosetRawChunks (y522CosetRawBlock i)).offset + i.val % 128 = i.val
  rw [y522CosetRawChunks_offset]
  unfold y522CosetRawBlock
  dsimp only
  omega

/-- Lookup retains the actual literal entry, with no out-of-range fallback. -/
def y522CosetRawData (i : Fin 10296) :=
  (y522CosetRawChunks (y522CosetRawBlock i)).data (y522CosetRawLocal i)

/-- Every assembled entry retains all exact actual finite bounds. -/
theorem y522CosetRawData_allowed (i : Fin 10296) :
    (y522CosetRawData i).Allowed 1806 1863 10 i.val := by
  have h := (y522CosetRawChunks (y522CosetRawBlock i)).allowed (y522CosetRawLocal i)
  change (y522CosetRawData i).Allowed 1806 1863 10
    (y522CosetRawGlobal (y522CosetRawBlock i) (y522CosetRawLocal i)).val at h
  rw [y522CosetRawGlobal_local] at h
  exact h

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
