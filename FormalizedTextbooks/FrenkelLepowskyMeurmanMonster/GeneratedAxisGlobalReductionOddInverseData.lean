/-- Forward column-XOR evaluation equals the genuine matrix action. -/
theorem generatedAxisGlobalOddBinaryColumns_action (k : Fin 14) (b : ℕ) :
    generatedAxisGlobalOddBinaryMatrix k *ᵥ monsterCo1GeometryBinaryMaskDecode b =
      monsterCo1GeometryBinaryMaskDecode
        (generatedAxisGlobalMaskColumnAction (generatedAxisGlobalOddBinaryColumns k) b) := by
  rw [generatedAxisGlobalOddBinaryColumns_certificate,
    ← generatedAxisGlobalMaskColumnAction_decode]

/-- Every indexed forward list retains the exact original column order. -/
theorem generatedAxisGlobalOddBinaryRows_certificate : ∀ k : Fin 14,
    generatedAxisGlobalOddBinaryRows k =
      List.ofFn (fun j : Fin 24 => (j.val, generatedAxisGlobalOddBinaryColumns k j)) := by
  decide +kernel

/-- Indexed forward evaluation has the actual original column-matrix action. -/
theorem generatedAxisGlobalOddBinaryRows_action (k : Fin 14) (b : ℕ) :
    generatedAxisGlobalMaskRowsAction (generatedAxisGlobalOddBinaryRows k) b =
      generatedAxisGlobalMaskColumnAction (generatedAxisGlobalOddBinaryColumns k) b := by
  rw [generatedAxisGlobalOddBinaryRows_certificate, generatedAxisGlobalMaskRowsAction_ofFn]

