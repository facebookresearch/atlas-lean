    (∀ j : Fin 24, generatedAxisGlobalOddInverseColumns k j < 2 ^ 24 ∧
      generatedAxisGlobalMaskRowsAction (generatedAxisGlobalOddBinaryRows k)
        (generatedAxisGlobalOddInverseColumns k j) = 2 ^ j.val) ∧
