/-- Actual preferred physical sign masks in the displayed octad coordinates. -/
def generatedFourthEvenRootSignMask (j : Fin 63) : Nat :=
  (List.finRange 8).foldr (fun k m =>
    (if (trialityEvenMask (generatedFourthEvenRootSign j)).testBit k.val then
      2 ^ (generatedFourthEvenRootCoordinates j k).val else 0) ||| m) 0

/-- Preferred integer output vectors in the original physical coordinates. -/
def generatedFourthEvenRootIntegral (j : Fin 63) : Fin 24 → ℤ := fun i =>
  if (golayEncodedMask (generatedFourthEvenRootCode j).val).testBit i.val then
    if (generatedFourthEvenRootSignMask j).testBit i.val then -2 else 2
  else 0

