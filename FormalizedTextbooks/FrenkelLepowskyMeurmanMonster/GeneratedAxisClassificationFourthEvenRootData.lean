/-- Every displayed output code is genuinely an actual Golay octad. -/
theorem generatedFourthEvenRootCode_mem : ∀ j : Fin 63,
    generatedFourthEvenRootCode j ∈ golayOctads := by
  decide +kernel

/-- Every recorded physical pair has increasing original coordinates. -/
theorem generatedFourthEvenRootInput_ordered : ∀ j : Fin 63,
    (match generatedFourthEvenRootInputData j with
    | Sum.inl (_, a, b) => decide (a < b)
    | Sum.inr _ => true) = true := by
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
-- Verify all 1512 actual integer coordinates of the inverse physical images.
/-- The listed octad roots have the exact original inverse integer images. -/
theorem generatedFourth_even_inverse_integral_certificate : ∀ j : Fin 63, ∀ i : Fin 24,
    (generatedFourthInverseNumerator *ᵥ generatedFourthEvenRootIntegral j) i =
      4 * generatedFourthEvenRootPhysicalSign j *
        generatedFourthInputIntegral (generatedFourthEvenRootInputData j) i := by
  decide +kernel

