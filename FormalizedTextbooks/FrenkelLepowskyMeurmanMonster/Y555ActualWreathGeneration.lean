/- Concrete generation reduction for the actual Norton family in G wreath C2. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555ActualWreathGenerationProducts
public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555WreathGenerators

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- A wreath element with trivial parity is the base element with its two actual entries. -/
theorem y555WreathBase_of_parity_one {M : Type*} [Group M]
    (w : M ≀ᵣ WreathParity) (hw : w.right = 1) :
    y555WreathBase (w.left 1, w.left wreathFlip) = w := by
  apply RegularWreathProduct.ext
  · funext x
    rcases wreathParity_cases x with rfl | rfl
    · simp [y555WreathBase]
    · simp [y555WreathBase, show wreathFlip ≠ 1 by decide]
  · exact hw.symm

/-- A wreath element with odd parity is the base element with its actual entries, then swap. -/
theorem y555WreathBase_swap_of_parity_flip {M : Type*} [Group M]
    (w : M ≀ᵣ WreathParity) (hw : w.right = wreathFlip) :
    y555WreathBase (w.left 1, w.left wreathFlip) * wreathSwap M = w := by
  apply RegularWreathProduct.ext
  · funext x
    rcases wreathParity_cases x with rfl | rfl
    · simp [RegularWreathProduct.mul_left, y555WreathBase, wreathSwap]
    · simp [RegularWreathProduct.mul_left, y555WreathBase, wreathSwap,
        show wreathFlip ≠ 1 by decide]
  · simpa [RegularWreathProduct.mul_right, y555WreathBase, wreathSwap] using hw.symm

/-- Actual local diagonal elements, the actual source triality reflection, and swap generate
all of the actual wreath product. These are explicit word-inclusion prerequisites. -/
theorem y555ActualWreath_eq_top (S : Subgroup (G ≀ᵣ WreathParity))
    (hH : ∀ h : H, y555WreathBase (localIntoGenerated h, localIntoGenerated h) ∈ S)
    (hτ : y555WreathReflection monsterSourceTriality ∈ S)
    (hs : wreathSwap G ∈ S) : S = ⊤ := by
  let K := S.comap y555WreathBase
  have hKH (h : H) : (localIntoGenerated h, localIntoGenerated h) ∈ K := hH h
  have ht : y555WreathBase (monsterSourceTriality, monsterSourceTriality⁻¹) ∈ S := by
    have hm := S.mul_mem hτ hs
    rw [← y555WreathReflection_one, y555WreathReflection_mul,
      inv_one, mul_one, mul_one] at hm
    exact hm
  have hKt : (extraIntoGenerated, extraIntoGenerated⁻¹) ∈ K := by
    change y555WreathBase (extraIntoGenerated, extraIntoGenerated⁻¹) ∈ S
    have hm := S.inv_mem ht
    rw [← map_inv] at hm
    simpa only [monsterSourceTriality, Prod.inv_mk, inv_inv] using hm
  have hK : K = ⊤ := y555ActualProduct_eq_top K hKH hKt
  have hb (p : G × G) : y555WreathBase p ∈ S := by
    change p ∈ K
    rw [hK]
    exact Subgroup.mem_top p
  apply top_unique
  intro w _
  rcases wreathParity_cases w.right with hp | hp
  · rw [← y555WreathBase_of_parity_one w hp]
    exact hb _
  · rw [← y555WreathBase_swap_of_parity_flip w hp]
    exact S.mul_mem (hb _) hs

/-- The subgroup generated by the sixteen already fixed actual Norton candidate words. -/
noncomputable def y555NortonActualGeneratedWreath : Subgroup (G ≀ᵣ WreathParity) :=
  Subgroup.closure (Set.range y555NortonActualCandidate)

/-- The independent central vertex supplies the actual pure swap in this generated subgroup. -/
theorem y555NortonActualGeneratedWreath_swap :
    wreathSwap G ∈ y555NortonActualGeneratedWreath := by
  rw [← y555NortonActualCandidate_center]
  exact Subgroup.subset_closure ⟨none, rfl⟩

/-- Generation for the fixed sixteen Norton words reduces to the concrete actual local
and source triality inclusions; no presentation kernel or omitted relation is asserted. -/
theorem y555NortonActualGeneratedWreath_eq_top
    (hH : ∀ h : H, y555WreathBase (localIntoGenerated h, localIntoGenerated h) ∈
      y555NortonActualGeneratedWreath)
    (hτ : y555WreathReflection monsterSourceTriality ∈ y555NortonActualGeneratedWreath) :
    y555NortonActualGeneratedWreath = ⊤ :=
  y555ActualWreath_eq_top _ hH hτ y555NortonActualGeneratedWreath_swap

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
