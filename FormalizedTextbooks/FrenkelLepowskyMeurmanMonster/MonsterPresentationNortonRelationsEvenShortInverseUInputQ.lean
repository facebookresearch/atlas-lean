/-- The complete coefficient-zero lift represented by the finite binary-mask table. -/
def monsterNortonEvenShortInverseUInputQ (k : Fin 23) (e : Fin 64) : Q :=
  ⟨ofAdd (fun i : Fin 24 =>
    if (monsterNortonEvenShortInverseUInputMask k e).testBit i.val then 1 else 0), 1⟩

set_option maxRecDepth 10000 in
set_option maxHeartbeats 64000000 in
-- Verify all 1472 preferred lifts against every actual hyperbolic coordinate, once.
/-- Every finite mask is the original preferred-Q input, including its complete coefficient. -/
theorem monsterNortonEvenShortInverseUInputQ_actual (k : Fin 23) (e : Fin 64) :
    monsterNortonShortQ (monsterNortonEvenShortInverseUInput k e) =
      monsterNortonEvenShortInverseUInputQ k e := by
  unfold monsterNortonShortQ monsterNortonEvenShortInverseUInputQ
  rw [monsterNortonEvenShortInverseUInputIntegral_actual]
  have hpar : integerParity (monsterNortonLeechCoordinates
      (monsterNortonEvenShortInverseUInputIntegral k e)) =
        (fun i : Fin 24 =>
          if (monsterNortonEvenShortInverseUInputParityMask k e).testBit i.val then 1 else 0) :=
    funext (monsterNortonEvenShortInverseUInputParity_actual k e)
  rw [hpar]
  clear hpar
  apply NormalizedCocycleExtension.Extension.ext
  · funext i
    revert k e i
    decide +kernel
  · rfl

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
