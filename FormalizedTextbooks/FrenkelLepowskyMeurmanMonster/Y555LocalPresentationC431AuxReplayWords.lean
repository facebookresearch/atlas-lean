def y431AuxReplaySymbol (i : Fin 810) : Y431RPresentation :=
  if h : i.val < 10 then y431AuxGenerator ⟨i.val, h⟩
  else if h : i.val < 630 then y431PositiveWord (y431AuxReplayHWord ⟨i.val - 10, by omega⟩)
  else y431AuxPositiveWord (y431AuxReplayTWord ⟨i.val - 630, by omega⟩)

/-- The first ten replay symbols have the exact proved original-source interpretation. -/
theorem y431AuxReplaySymbol_generator (i : Fin 10) :
    y431AuxReplaySymbol ⟨i.val, by omega⟩ = y431AuxGenerator i := by
