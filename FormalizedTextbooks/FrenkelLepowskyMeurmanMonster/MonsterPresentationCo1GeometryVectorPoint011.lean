-- Check all entries of the right inverse before applying actual action injectivity.
/-- The inverse matrix is the inverse of the literal actual Conway transport. -/
theorem monsterCo1GeometryVectorPoint11Transport_inverse_binary (v : Fin 24 → ZMod 2) :
    co1BinaryAction monsterCo1GeometryVectorPoint11Transport⁻¹ v =
      monsterCo1GeometryVectorPoint11InverseMatrix *ᵥ v := by
  exact monsterCo1GeometryTransport_matrix_inv monsterCo1GeometryVectorPoint11Transport _ _
    monsterCo1GeometryVectorPoint11Transport_binary (by decide +kernel) v

