/-- The original inverse signed-pair numerator at its chosen coordinate. -/
def generatedEighthPairWitnessNumerator (s : Fin 2) (a b : Fin 24) : ℤ :=
  4 * (generatedEighthInverseNumerator (generatedEighthPairWitness s a b) a +
    (if s = 0 then -1 else 1) *
      generatedEighthInverseNumerator (generatedEighthPairWitness s a b) b)

/-- Every actual inverse signed pair has an incompatible coordinate square. -/
theorem generatedEighth_pair_witness_certificate (s : Fin 2) (a b : Fin 24) (hab : a < b) :
    generatedEighthPairWitnessNumerator s a b ^ 2 ≠ 0 ∧
      generatedEighthPairWitnessNumerator s a b ^ 2 ≠ 1024 := by
  have h : ∀ s : Fin 2, ∀ a b : Fin 24, a < b →
      generatedEighthPairWitnessNumerator s a b ^ 2 ≠ 0 ∧
        generatedEighthPairWitnessNumerator s a b ^ 2 ≠ 1024 := by
    decide +kernel
  exact h s a b hab

