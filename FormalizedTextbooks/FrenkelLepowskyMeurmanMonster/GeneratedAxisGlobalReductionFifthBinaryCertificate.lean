/-- All binary caches are exact reductions of the checked genuine lattice actions. -/
theorem generatedAxisGlobalFifthPermutationBinary_certificate : ∀ k : Fin 6,
    generatedAxisGlobalFifthPermutationBinary k =
      leechHyperbolicInverse *
        (generatedAxisGlobalFifthMonomialIntegral k).map (Int.castRingHom (ZMod 2)) *
        leechHyperbolicMatrix := by
  decide +kernel

