module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Definitions
public import Mathlib.LinearAlgebra.Span.Basic

/-! The actual shortest vectors generate the integral and physical Leech lattices.
The proof checks the supplied basis columns and decomposes the two longer columns. -/

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- Integer span of the published short-vector representatives. -/
def leechShortIntegralSpan : Submodule ℤ (Fin 24 → ℤ) :=
  Submodule.span ℤ (Set.range griessShortIntegral)

theorem leechShortIntegral_mem_span (r : GriessShortIndex) :
    griessShortIntegral r ∈ leechShortIntegralSpan :=
  Submodule.subset_span ⟨r, rfl⟩

/-- The proved catalogue places every norm-32 integer vector in the short span. -/
theorem leechShortIntegralSpan_of_norm (u : Fin 24 → ℤ)
    (hu : u ∈ leechIntegral) (hn : leechSquareSum u = 32) :
    u ∈ leechShortIntegralSpan := by
  obtain ⟨r, hr | hr⟩ := leechShort_catalog ⟨u, hu⟩ hn
  · change u = griessShortIntegral r at hr
    rw [hr]
    exact leechShortIntegral_mem_span r
  · change u = -griessShortIntegral r at hr
    rw [hr]
    exact leechShortIntegralSpan.neg_mem (leechShortIntegral_mem_span r)

private def shortSpanPairPlus : Fin 24 → ℤ := fun i =>
  if i = 0 ∨ i = 1 then 4 else 0

private def shortSpanPairMinus : Fin 24 → ℤ := fun i =>
  if i = 0 then 4 else if i = 1 then -4 else 0

private def shortSpanOdd : Fin 24 → ℤ := fun i => if i = 0 then -3 else 1

private theorem shortSpanPairPlus_mem : shortSpanPairPlus ∈ leechIntegral := by
  refine ⟨0, 0, ?_⟩
  unfold LeechCongruences
  decide +kernel

private theorem shortSpanPairMinus_mem : shortSpanPairMinus ∈ leechIntegral := by
  refine ⟨0, 0, ?_⟩
  unfold LeechCongruences
  decide +kernel

private theorem shortSpanOdd_mem : shortSpanOdd ∈ leechIntegral := by
  refine ⟨1, 0, ?_⟩
  unfold LeechCongruences
  decide +kernel

private theorem shortSpanPairPlus_norm : leechSquareSum shortSpanPairPlus = 32 := by
  decide +kernel

private theorem shortSpanPairMinus_norm : leechSquareSum shortSpanPairMinus = 32 := by
  decide +kernel

private theorem shortSpanOdd_norm : leechSquareSum shortSpanOdd = 32 := by
  decide +kernel

private theorem shortSpanBasisZero :
    (fun i => leechBasisMatrix i 0) = shortSpanPairPlus + shortSpanPairMinus := by
  decide +kernel

private theorem shortSpanBasisLast :
    (fun i => leechBasisMatrix i 23) = shortSpanOdd + (fun i => leechBasisMatrix i 0) := by
  decide +kernel

private theorem shortSpanBasisNorm : ∀ j : Fin 24, j ≠ 0 → j ≠ 23 →
    leechSquareSum (fun i => leechBasisMatrix i j) = 32 := by
  decide +kernel

/-- Every actual integral basis column is an integer sum of short vectors. -/
theorem leechBasisColumn_mem_shortSpan (j : Fin 24) :
    (fun i => leechBasisMatrix i j) ∈ leechShortIntegralSpan := by
  have hz : (fun i => leechBasisMatrix i 0) ∈ leechShortIntegralSpan := by
    rw [shortSpanBasisZero]
    exact leechShortIntegralSpan.add_mem
      (leechShortIntegralSpan_of_norm _ shortSpanPairPlus_mem shortSpanPairPlus_norm)
      (leechShortIntegralSpan_of_norm _ shortSpanPairMinus_mem shortSpanPairMinus_norm)
  by_cases hj : j = 0
  · simpa only [hj] using hz
  by_cases hj' : j = 23
  · subst j
    rw [shortSpanBasisLast]
    exact leechShortIntegralSpan.add_mem
      (leechShortIntegralSpan_of_norm _ shortSpanOdd_mem shortSpanOdd_norm) hz
  exact leechShortIntegralSpan_of_norm _ (leechBasisMatrix_mem j)
    (shortSpanBasisNorm j hj hj')

/-- The genuine integral lattice is generated by its shortest vectors over ℤ. -/
theorem leechShortIntegralSpan_eq : leechShortIntegralSpan = leechIntegral := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨r, rfl⟩
    exact griessShortIntegral_mem r
  · rw [← leechColumnSpan_eq]
    apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact leechBasisColumn_mem_shortSpan j

/-- The physical Leech lattice is the integer span of the actual physical short vectors. -/
theorem leechLattice_eq_short_span :
    LeechLattice = Submodule.span ℤ (Set.range griessShortVector) := by
  unfold LeechLattice
  rw [← leechShortIntegralSpan_eq]
  change (Submodule.span ℤ (Set.range griessShortIntegral)).map leechCoordinateEmbedding = _
  rw [Submodule.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨r, rfl⟩, rfl⟩
    exact ⟨r, rfl⟩
  · rintro ⟨r, rfl⟩
    exact ⟨griessShortIntegral r, ⟨r, rfl⟩, rfl⟩

theorem griessShortVector_mem_leechLattice (r : GriessShortIndex) :
    griessShortVector r ∈ LeechLattice := by
  rw [leechLattice_eq_short_span]
  exact Submodule.subset_span ⟨r, rfl⟩

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
