/-- Every original nonzero short coordinate is fixed by the genuine corrected Xi action. -/
theorem generatedFifthXiShort_support_fixed (r : GriessShortIndex)
    (hr : (griessConwayEncode generatedFifthAxis).2.1 r ≠ 0) :
    localShortOperator generatedFifthXiCorrectedFiber
      (griessConwayEncode generatedFifthAxis).2.1 r =
        (griessConwayEncode generatedFifthAxis).2.1 r := by
  rcases r with ⟨s, p⟩ | (⟨o, e⟩ | ⟨d, i⟩)
  · obtain ⟨r, h⟩ := generatedFifthXiShortSupportPair_actual s p hr
    have he := generatedFifthXiShort_pair_cached_fixed s r
    rw [h] at he
    exact he
  · have ho : ∃ j : Fin 56, generatedFifthEvenRootOctad j = o := by
      by_contra h
      exact hr (generatedFifth_final_octad_zero o e h)
    obtain ⟨j, rfl⟩ := ho
    exact generatedFifthXiShort_octad_fixed j e
  · exact False.elim (hr (generatedFifth_final_odd_zero d i))

/-- The full actual corrected Xi short action fixes the original fifth short vector. -/
theorem generatedFifth_xi_short_fixed :
    localShortOperator generatedFifthXiCorrectedFiber (griessConwayEncode generatedFifthAxis).2.1 =
      (griessConwayEncode generatedFifthAxis).2.1 := by
  let X := (griessConwayEncode generatedFifthAxis).2.1
  let Y := localShortOperator generatedFifthXiCorrectedFiber X
  have hn : (∑ r : GriessShortIndex, Y r ^ 2) = ∑ r : GriessShortIndex, X r ^ 2 := by
    have h := localShortRepresentation_pairing generatedFifthXiCorrectedFiber X X
    change (∑ r, localShortOperator generatedFifthXiCorrectedFiber X r *
      localShortOperator generatedFifthXiCorrectedFiber X r) = ∑ r, X r * X r at h
    simpa only [Y, pow_two] using h
  exact generatedFourth_real_eq_of_norm_support X Y hn generatedFifthXiShort_support_fixed

/-- The original encoded short block is fixed by the actual quotient action. -/
theorem generatedFifth_xi_encoded_short_fixed :
    (griessConwayEncode (rhoLocal (localFiberIntoH generatedFifthXiCorrectedFiber)
      generatedFifthAxis)).2.1 = (griessConwayEncode generatedFifthAxis).2.1 := by
  rw [generatedFourth_local_short]
  exact generatedFifth_xi_short_fixed

