/-! The complete corrected Xi short action fixes the original fifth axis. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 10000

/-- Select the genuinely certified pair packet for an outgoing physical pair row. -/
def generatedFifthXiShortPairPacketTarget (r : Fin 272) : generatedFifthXiShortCachedLabel :=
  if h : r.val < 64 then generatedFifthXiShortPacket56Target ⟨r.val, h⟩
  else if h' : r.val < 128 then generatedFifthXiShortPacket57Target ⟨r.val - 64, by omega⟩
  else if h'' : r.val < 192 then generatedFifthXiShortPacket58Target ⟨r.val - 128, by omega⟩
  else if h4 : r.val < 256 then generatedFifthXiShortPacket59Target ⟨r.val - 192, by omega⟩
  else generatedFifthXiShortPacket60Target ⟨r.val - 256, by omega⟩

set_option maxRecDepth 100000 in
-- Verify that every literal pair-packet target is the original cached support row.
/-- The pair packets cover all272 actual signed physical support rows. -/
theorem generatedFifthXiShortPairPacket_target : ∀ s : Fin 2, ∀ r : Fin 136,
    generatedFifthXiShortPairPacketTarget ⟨2 * r.val + s.val, by omega⟩ =
      generatedFifthXiShortSupportPairCached s r := by
  decide +kernel

/-- Every pair-packet target coordinate is fixed by the actual corrected Xi. -/
theorem generatedFifthXiShortPairPacket_fixed (r : Fin 272) :
    localShortOperator generatedFifthXiCorrectedFiber
        (griessConwayEncode generatedFifthAxis).2.1
        (generatedFifthXiEvenShortIndex
          (generatedFifthXiShortCachedEven (generatedFifthXiShortPairPacketTarget r))) =
      (griessConwayEncode generatedFifthAxis).2.1
        (generatedFifthXiEvenShortIndex
          (generatedFifthXiShortCachedEven (generatedFifthXiShortPairPacketTarget r))) := by
  unfold generatedFifthXiShortPairPacketTarget
  split
  · exact generatedFifthXiShortPacket56_fixed _
  · split
    · exact generatedFifthXiShortPacket57_fixed _
    · split
      · exact generatedFifthXiShortPacket58_fixed _
      · split
        · exact generatedFifthXiShortPacket59_fixed _
        · exact generatedFifthXiShortPacket60_fixed _

/-- All genuinely supported physical pair rows are fixed, with their full preferred-Q phases. -/
theorem generatedFifthXiShort_pair_cached_fixed (s : Fin 2) (r : Fin 136) :
    localShortOperator generatedFifthXiCorrectedFiber
        (griessConwayEncode generatedFifthAxis).2.1
        (generatedFifthXiEvenShortIndex
          (generatedFifthXiShortCachedEven (generatedFifthXiShortSupportPairCached s r))) =
      (griessConwayEncode generatedFifthAxis).2.1
        (generatedFifthXiEvenShortIndex
          (generatedFifthXiShortCachedEven (generatedFifthXiShortSupportPairCached s r))) := by
  have h := generatedFifthXiShortPairPacket_fixed ⟨2 * r.val + s.val, by omega⟩
  rw [generatedFifthXiShortPairPacket_target] at h
  exact h

