/-- Their physical integer coordinate matrices. -/
def omegaOrbitPhysicalMatrices : Fin 4 → Matrix (Fin 24) (Fin 24) ℤ := fun k i j =>
  if k.val < 2 then
    if i = j then
      if golayEncoder (Pi.single (if k.val = 0 then 4 else 5) 1) i = 0 then 1 else -1
    else 0
  else if omegaOrbitPermInverse ⟨k.val - 2, by omega⟩ i = j then 1 else 0

set_option maxHeartbeats 16000000 in
-- Check four complete 24×24 integral basis identities.
/-- All four actions preserve the actual integral basis, by exact arithmetic. -/
theorem omegaOrbit_integral_certificate : ∀ k : Fin 4,
    omegaOrbitPhysicalMatrices k * leechBasisMatrix =
      leechBasisMatrix * omegaOrbitIntegralMatrices k := by
  decide +kernel

