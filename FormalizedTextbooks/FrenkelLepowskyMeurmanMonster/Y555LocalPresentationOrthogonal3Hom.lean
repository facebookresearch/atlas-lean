/- Actual finite characteristic-three representation of the original C322 presentation.
Its kernel and image order are not assumed. -/
module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.Y555LocalPresentationOrthogonal3Relations

@[expose] public section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
set_option backward.isDefEq.respectTransparency false

/-- The explicit source reflection as an actual invertible matrix. -/
def y322Orthogonal3Generator (i : Fin 8) : Matrix.GeneralLinearGroup (Fin 7) (ZMod 3) where
  val := y322Orthogonal3Reflection i
  inv := y322Orthogonal3Reflection i
  val_inv := y322Orthogonal3Reflection_square i
  inv_val := y322Orthogonal3Reflection_square i

/-- The invertible-matrix generator has exactly its declared actual matrix entries. -/
theorem y322Orthogonal3Generator_matrix (i : Fin 8) :
    (y322Orthogonal3Generator i).val = y322Orthogonal3Reflection i := rfl

/-- Each actual invertible source reflection satisfies its genuine defining square. -/
theorem y322Orthogonal3Generator_square (i : Fin 8) : y322Orthogonal3Generator i ^ 2 = 1 := by
  apply Units.ext
  change y322Orthogonal3Reflection i ^ 2 = 1
  rw [pow_two]
  exact y322Orthogonal3Reflection_square i

/-- Every genuine source Coxeter pair has its required exponent in the actual finite group. -/
theorem y322Orthogonal3Generator_coxeter (i j : Fin 8) (h : i ≠ j) :
    (y322Orthogonal3Generator i * y322Orthogonal3Generator j) ^
      (if y555Adjacent (y322Vertex i) (y322Vertex j) then 3 else 2 : ℕ) = 1 := by
  apply Units.ext
  change (y322Orthogonal3Reflection i * y322Orthogonal3Reflection j) ^
    (if y555Adjacent (y322Vertex i) (y322Vertex j) then 3 else 2 : ℕ) = 1
  exact y322Orthogonal3Reflection_coxeter i j h

/-- The original nine source letters lift to their exact actual finite spider matrix. -/
theorem y322Orthogonal3Spider_matrix :
    (FreeGroup.lift y322Orthogonal3Generator y322Spider).val = y322Orthogonal3Spider := by
  unfold y322Spider
  simp only [map_mul, FreeGroup.lift_apply_of]
  rfl

/-- Every original C322 square, Coxeter pair and spider10 relator holds in the finite image. -/
theorem y322Orthogonal3Relations_valid (r : FreeGroup (Fin 8)) (hr : r ∈ y322Relations) :
    FreeGroup.lift y322Orthogonal3Generator r = 1 := by
  rcases hr with ⟨v, rfl⟩ | ⟨u, v, huv, rfl⟩ | rfl
  · simpa only [map_pow, FreeGroup.lift_apply_of] using y322Orthogonal3Generator_square v
  · simpa only [map_pow, map_mul, FreeGroup.lift_apply_of] using
      y322Orthogonal3Generator_coxeter u v huv
  · rw [map_pow]
    apply Units.ext
    change (FreeGroup.lift y322Orthogonal3Generator y322Spider).val ^ 10 = 1
    rw [y322Orthogonal3Spider_matrix]
    exact y322Orthogonal3Spider_tenth

/-- The actual source presentation homomorphism into explicit invertible matrices over F3. -/
def y322Orthogonal3Hom : Y322Presentation →* Matrix.GeneralLinearGroup (Fin 7) (ZMod 3) :=
  PresentedGroup.toGroup y322Orthogonal3Relations_valid

/-- Every original source generator maps to its precise explicit matrix reflection. -/
@[simp] theorem y322Orthogonal3Hom_generator (i : Fin 8) :
    y322Orthogonal3Hom (PresentedGroup.of i) = y322Orthogonal3Generator i :=
  PresentedGroup.toGroup.of y322Orthogonal3Relations_valid

/-- The quotient map composed with the actual finite hom is the lift of those exact generators. -/
theorem y322Orthogonal3Hom_quotient :
    y322Orthogonal3Hom.comp (PresentedGroup.mk y322Relations) =
      FreeGroup.lift y322Orthogonal3Generator := by
  apply FreeGroup.ext_hom
  intro i
  simp only [MonoidHom.comp_apply, FreeGroup.lift_apply_of]
  change y322Orthogonal3Hom (PresentedGroup.of i) = y322Orthogonal3Generator i
  exact y322Orthogonal3Hom_generator i

/-- The corrected source F12 has actual finite image minus the identity matrix. -/
theorem y322Orthogonal3Hom_longest :
    (y322Orthogonal3Hom (PresentedGroup.mk y322Relations y322E7Word12)).val = -1 := by
  change ((y322Orthogonal3Hom.comp (PresentedGroup.mk y322Relations)) y322E7Word12).val = -1
  rw [y322Orthogonal3Hom_quotient]
  unfold y322E7Word12
  simp only [map_pow, map_mul, FreeGroup.lift_apply_of]
  exact y322Orthogonal3Reflection_longest

/-- The actual finite subgroup generated by the eight original source reflection images. -/
def y322Orthogonal3Image : Subgroup (Matrix.GeneralLinearGroup (Fin 7) (ZMod 3)) :=
  y322Orthogonal3Hom.range

/-- The actual source image is finite. -/
theorem y322Orthogonal3Image_finite : Finite y322Orthogonal3Image := by
  infer_instance

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
