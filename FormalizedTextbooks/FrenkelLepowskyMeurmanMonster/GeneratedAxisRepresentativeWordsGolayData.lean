/-- All stored node array pairs satisfy both finite inverse laws. -/
theorem representativeNodePhysical_inverse_certificate : ∀ n : Fin 15, ∀ i : Fin 24,
    representativeNodePhysicalImages n (representativeNodePhysicalInverse n i) = i ∧
      representativeNodePhysicalInverse n (representativeNodePhysicalImages n i) = i := by
  decide +kernel

/-- All stored target array pairs satisfy both finite inverse laws. -/
theorem representativePermutationPhysical_inverse_certificate : ∀ n : Fin 83, ∀ i : Fin 24,
    representativePermutationPhysicalImages n (representativePermutationPhysicalInverse n i) = i ∧
      representativePermutationPhysicalInverse n
        (representativePermutationPhysicalImages n i) = i := by
  decide +kernel

/-- The source node arrays as genuine finite coordinate permutations. -/
def representativeNodePhysicalPermutation (n : Fin 15) : Equiv.Perm (Fin 24) where
  toFun := representativeNodePhysicalImages n
  invFun := representativeNodePhysicalInverse n
  left_inv i := (representativeNodePhysical_inverse_certificate n i).2
  right_inv i := (representativeNodePhysical_inverse_certificate n i).1

/-- The target source arrays as genuine finite coordinate permutations. -/
def representativePermutationPhysicalPermutation (n : Fin 83) : Equiv.Perm (Fin 24) where
  toFun := representativePermutationPhysicalImages n
  invFun := representativePermutationPhysicalInverse n
  left_inv i := (representativePermutationPhysical_inverse_certificate n i).2
  right_inv i := (representativePermutationPhysical_inverse_certificate n i).1

/-- A signed node letter in the column-action convention is the inverse source permutation. -/
def representativeNodePhysicalLetter (letter : RepresentativeNodeLetter) : Equiv.Perm (Fin 24) :=
  if letter.2 then representativeNodePhysicalPermutation letter.1
    else (representativeNodePhysicalPermutation letter.1)⁻¹

/-- The first two compact node arrays equal the frozen actual source coordinate permutations. -/
theorem representativeNodePhysical_original_certificate : ∀ k : Fin 2,
    representativeNodePhysicalPermutation (Fin.castAdd 13 k) = omegaOrbitPermutation k := by
  decide +kernel

/-- The signed compact defining words give precisely the stored node permutations. -/
theorem representativeNodePhysical_word_certificate : ∀ n : Fin 15, 2 ≤ n.val →
    ((representativeNodeWord n).map representativeNodePhysicalLetter).prod =
      (representativeNodePhysicalPermutation n)⁻¹ := by
  decide +kernel

/-- The compact target words give precisely the recorded target physical permutations. -/
theorem representativePermutationPhysical_word_certificate : ∀ n : Fin 83,
    ((representativePermutationWord n).map representativeNodePhysicalLetter).prod =
      (representativePermutationPhysicalPermutation n)⁻¹ := by
  decide +kernel

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
