/-- A balanced lookup retains precisely the original signed source-word index.
No support block or coordinate is omitted. -/
def generatedRootEightIncomingTensorSourceFastPositive (r : Fin 8) (b : Fin 64) : ℕ :=
  generatedRootEightIncomingTensorSourceFastPositiveData r
    ⟨b.val / 8, by omega⟩ ⟨b.val % 8, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 8000000 in
-- Compare every original 64-bit source word in all eight full columns once.
/-- Every balanced source word equals the complete original literal word. -/
theorem generatedRootEight_incoming_tensor_source_fast_positive : ∀ r b,
    generatedRootEightIncomingTensorSourceFastPositive r b =
      generatedRootEightIncomingTensorSourceCachePositive r b := by
  decide +kernel

