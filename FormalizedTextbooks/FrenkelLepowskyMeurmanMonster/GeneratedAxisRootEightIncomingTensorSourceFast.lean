    generatedRootEightIncomingTensorSourceFastNegative r b =
      generatedRootEightIncomingTensorSourceCacheNegative r b := by
  decide +kernel

/-- Exact complete source input lookup, including zeros and all upper-half phases. -/
def generatedRootEightIncomingTensorSourceFast (r : Fin 8) (n : Fin 4096) : ℤ :=
  if (generatedRootEightIncomingTensorSourceFastPositive r ⟨n.val / 64, by omega⟩).testBit
      (n.val % 64) then 1
  else if (generatedRootEightIncomingTensorSourceFastNegative r ⟨n.val / 64, by omega⟩).testBit
      (n.val % 64) then -1 else 0

/-- The balanced evaluator equals every complete original signed input coordinate. -/
theorem generatedRootEight_incoming_tensor_source_fast_actual (r : Fin 8) (n : Fin 4096) :
    generatedRootEightIncomingTensorSourceFast r n =
      generatedRootEightIncomingTensorSourceCache r n := by
  unfold generatedRootEightIncomingTensorSourceFast generatedRootEightIncomingTensorSourceCache
  rw [generatedRootEight_incoming_tensor_source_fast_positive,
    generatedRootEight_incoming_tensor_source_fast_negative]

