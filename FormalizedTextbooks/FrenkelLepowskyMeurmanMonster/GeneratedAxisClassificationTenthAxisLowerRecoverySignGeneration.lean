module

public import FormalizedTextbooks.FrenkelLepowskyMeurmanMonster.GeneratedAxisClassificationTenthAxisLowerRecoverySmallSourceData

/-! All actual identity-permutation signs are generated by the seven original code witnesses. -/

@[expose] public noncomputable section
namespace FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false

/-- The actual 128 original binary words as members of the entire true correction fiber. -/
def generatedTenthAxisLowerRecoveryBinarySignFiber (b : Fin 128) :
    {c : golayCode // generatedTenthE7StandardTwistedSignCondition 0 c} :=
  ⟨generatedTenthAxisLowerRecoveryBinarySign b,
    generatedTenth_axis_lower_recovery_binary_sign_valid b⟩

/-- Distinct original labels give distinct actual Golay codewords. -/
theorem generatedTenth_axis_lower_recovery_code_injective :
    Function.Injective generatedTenthAxisLowerRecoveryCode := by
  intro d e h
  apply golayLabelCoefficients_injective
  apply golayEncoder_injective
  exact congrArg Subtype.val h

/-- All 128 actual original binary code words are distinct. -/
theorem generatedTenth_axis_lower_recovery_binary_sign_injective :
    Function.Injective generatedTenthAxisLowerRecoveryBinarySign := by
  intro b c h
  rw [generatedTenth_axis_lower_recovery_binary_sign_actual,
    generatedTenth_axis_lower_recovery_binary_sign_actual] at h
  exact generatedTenth_axis_lower_recovery_binary_sign_labels_injective
    (generatedTenth_axis_lower_recovery_code_injective h)

set_option backward.isDefEq.respectTransparency true in
set_option maxHeartbeats 2000000 in
-- The full twisted-sign subtype comparison exceeded the default elaboration budget.
/-- The seven original witnesses span the entire actual identity-permutation correction fiber. -/
theorem generatedTenth_axis_lower_recovery_binary_sign_surjective :
    Function.Surjective generatedTenthAxisLowerRecoveryBinarySignFiber := by
  apply ((Nat.bijective_iff_injective_and_card
    generatedTenthAxisLowerRecoveryBinarySignFiber).mpr ?_).surjective
  refine ⟨?_, ?_⟩
  · intro b c h
    have hv := congrArg
      (fun x : {c : golayCode // generatedTenthE7StandardTwistedSignCondition 0 c} =>
        x.val) h
    change generatedTenthAxisLowerRecoveryBinarySign b =
      generatedTenthAxisLowerRecoveryBinarySign c at hv
    exact generatedTenth_axis_lower_recovery_binary_sign_injective hv
  · have h := generatedTenth_e7_standard_twisted_sign_fiber_card
      (0 : Fin 6 → ZMod 2) (by simp)
    rw [Nat.card_eq_fintype_card, Fintype.card_fin]
    exact h.symm

set_option backward.isDefEq.respectTransparency true in
set_option maxHeartbeats 2000000 in
-- The full twisted-sign subtype comparison exceeded the default elaboration budget.
/-- The seven actual basis signs generate every actual sign satisfying the full condition. -/
theorem generatedTenth_axis_lower_recovery_sign_generation
    (P : Subgroup leechIsomSubgroup)
    (hbasis : ∀ k : Fin 7,
      golaySignIsometry (generatedTenthAxisLowerRecoveryCode
        (generatedTenthAxisLowerRecoverySignBasis k)) ∈ P)
    (c : golayCode) (hc : generatedTenthE7StandardTwistedSignCondition 0 c) :
    golaySignIsometry c ∈ P := by
  obtain ⟨b, hb⟩ := generatedTenth_axis_lower_recovery_binary_sign_surjective ⟨c, hc⟩
  have he := congrArg
    (fun x : {c : golayCode // generatedTenthE7StandardTwistedSignCondition 0 c} =>
      x.val) hb
  change generatedTenthAxisLowerRecoveryBinarySign b = c at he
  rw [← he, generatedTenthAxisLowerRecoveryBinarySign]
  have hsum : ∀ (s : Finset (Fin 7)), golaySignIsometry
      (∑ k ∈ s, (if b.val.testBit k.val then (1 : ZMod 2) else 0) •
        generatedTenthAxisLowerRecoveryCode (generatedTenthAxisLowerRecoverySignBasis k)) ∈ P := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simp only [Finset.sum_empty]
      simpa only [show golaySignIsometry (0 : golayCode) = 1 from
        golaySignHom.map_one] using P.one_mem
    | @insert k s hks ih =>
      rw [Finset.sum_insert hks]
      have hadd (x y : golayCode) :
          golaySignIsometry (x + y) = golaySignIsometry x * golaySignIsometry y :=
        golaySignHom.map_mul (Multiplicative.ofAdd x) (Multiplicative.ofAdd y)
      rw [hadd]
      apply P.mul_mem _ ih
      by_cases hk : b.val.testBit k.val = true
      · simpa only [hk, ite_true, one_smul] using hbasis k
      · have hk' : b.val.testBit k.val = false := by
          cases h : b.val.testBit k.val <;> simp_all
        simp only [hk', Bool.false_eq_true, ite_false, zero_smul]
        simpa only [show golaySignIsometry (0 : golayCode) = 1 from
          golaySignHom.map_one] using P.one_mem
  exact hsum Finset.univ

end FormalizedTextbooks.FrenkelLepowskyMeurmanMonster
