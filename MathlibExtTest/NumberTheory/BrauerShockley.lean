module

import MathlibExt.NumberTheory.BrauerShockley
import Mathlib.RingTheory.Ideal.NatInt

/-! # Examples of the Brauer–Shockley formula -/

namespace MetaMathlibExt.BrauerShockleyTest

private def pair (a b : ℕ) (i : Fin 2) : ℕ := if i = 0 then a else b

-- In the semigroup generated by 2 and 3, the least odd element is 3.
example : IsGreatest {z : ℤ | ∀ s ∈ AddSubmonoid.closure (Set.range (pair 2 3)), (s : ℤ) ≠ z}
    1 := by
  have hmin : IsLeast {s | s ∈ AddSubmonoid.closure (Set.range (pair 2 3)) ∧ s ≡ 1 [MOD 2]}
      3 := by
    refine ⟨⟨AddSubmonoid.subset_closure ⟨1, rfl⟩, by decide⟩, fun s hs ↦ ?_⟩
    have hne : s ≠ 1 := by
      rintro rfl
      obtain ⟨j, hj⟩ := Nat.one_mem_closure_iff.mp hs.1
      simp only [pair] at hj
      split at hj <;> contradiction
    have hodd : s % 2 = 1 := hs.2
    omega
  apply frobenius_eq_max_apery_sub (pair 2 3) (by decide) (by decide) 0 (by decide) 3
  refine ⟨⟨1, by decide, hmin⟩, ?_⟩
  rintro m ⟨x, hx, hm⟩
  have hx' : x = 1 := by
    change x ∈ Finset.Icc 1 1 at hx
    simpa using hx
  subst x
  exact hm.2 hmin.1

-- With generators 3 and 1, the two nonzero residue minima are 1 and 2.
example : IsGreatest {z : ℤ | ∀ s ∈ AddSubmonoid.closure (Set.range (pair 3 1)), (s : ℤ) ≠ z}
    (-1) := by
  let S := AddSubmonoid.closure (Set.range (pair 3 1))
  have hunit : 1 ∈ S := AddSubmonoid.subset_closure ⟨1, rfl⟩
  have hmin (r : ℕ) (hr : r < 3) : IsLeast {s | s ∈ S ∧ s ≡ r [MOD 3]} r := by
    refine ⟨⟨?_, .rfl⟩, fun s hs ↦ ?_⟩
    · simpa using S.nsmul_mem hunit r
    · have hmod : s % 3 = r := Eq.trans hs.2 (Nat.mod_eq_of_lt hr)
      omega
  apply frobenius_eq_max_apery_sub (pair 3 1) (by decide) (by decide) 0 (by decide) 2
  refine ⟨⟨2, by decide, hmin 2 (by decide)⟩, ?_⟩
  rintro m ⟨x, hx, hm⟩
  have hx' : x ≤ 2 := (Finset.mem_Icc.mp hx).2
  exact (hm.2 (hmin x (by omega)).1).trans hx'

end MetaMathlibExt.BrauerShockleyTest
