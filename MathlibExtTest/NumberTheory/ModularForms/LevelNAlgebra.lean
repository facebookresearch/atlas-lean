module

public import MathlibExt.NumberTheory.ModularForms.LevelNAlgebra

@[expose] public section

open WLight UpperHalfPlane

/-- Consumer with the original binders: the level-`N` algebra generated by
the `j`-function and the Fricke functions. -/
public theorem exactSource (N : ℕ) [NeZero N] :
    jFunction ∈ levelNAlgebra N ∧
      ∀ v : Fin 2 → ZMod N, v ≠ 0 → frickeFunction N v ∈ levelNAlgebra N :=
  ⟨jFunction_mem_levelNAlgebra N, fun _ hv => frickeFunction_mem_levelNAlgebra N hv⟩

/-- Boundary case: the zero torsion label is excluded from the generators,
so membership of its Fricke function is not part of the package. -/
example (N : ℕ) [NeZero N] :
    (0 : Fin 2 → ZMod N) = 0 := rfl

/-- The period pair at `τ` has the prescribed periods. -/
example (τ : ℍ) : (periodPairOfTau τ).ω₁ = (τ : ℂ) ∧ (periodPairOfTau τ).ω₂ = 1 :=
  ⟨periodPairOfTau_ω₁ τ, periodPairOfTau_ω₂ τ⟩
