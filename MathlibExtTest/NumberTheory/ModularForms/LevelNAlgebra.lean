module

public import MathlibExt.NumberTheory.ModularForms.LevelNAlgebra

@[expose] public section

open WLight UpperHalfPlane

/-- Consumer with the original binders: the level-`N` algebra generated by
the `j`-function and the Fricke functions. -/
private theorem exactSource (N : ℕ) [NeZero N] :
    jFunction ∈ levelNAlgebra N ∧
      ∀ v : Fin 2 → ZMod N, v ≠ 0 → frickeFunction N v ∈ levelNAlgebra N :=
  ⟨jFunction_mem_levelNAlgebra N, fun _ hv => frickeFunction_mem_levelNAlgebra N hv⟩

/-- The Fricke generators of `levelNAlgebra N` are the Fricke functions at the labels in
`nonzeroTorsionLabels N`, so the two label checks below constrain the generating set. -/
example (N : ℕ) [NeZero N] :
    levelNAlgebra N =
      Algebra.adjoin ℂ (insert jFunction (frickeFunction N '' nonzeroTorsionLabels N)) := by
  rw [levelNAlgebra]
  congr 2
  ext g
  exact exists_congr fun _ => and_congr_right fun _ => eq_comm

/-- Boundary case: the zero torsion label is not a generator label. -/
example (N : ℕ) : (0 : Fin 2 → ZMod N) ∉ nonzeroTorsionLabels N := by
  simp

/-- A concrete nonzero label is a generator label. -/
example : (![1, 0] : Fin 2 → ZMod 2) ∈ nonzeroTorsionLabels 2 := by
  simp

/-- Why the exclusion is checked on the labels: the zero label's Fricke function is `0`
(`PeriodPair.weierstrassP_zero`), which lies in every subalgebra. -/
example (N : ℕ) [NeZero N] : frickeFunction N 0 = 0 := by
  ext τ
  simp [frickeFunction, weierstrassTorsion, PeriodPair.weierstrassP_zero]

/-- The period pair at `τ` has the prescribed periods. -/
example (τ : ℍ) : (periodPairOfTau τ).ω₁ = (τ : ℂ) ∧ (periodPairOfTau τ).ω₂ = 1 :=
  ⟨periodPairOfTau_ω₁ τ, periodPairOfTau_ω₂ τ⟩
