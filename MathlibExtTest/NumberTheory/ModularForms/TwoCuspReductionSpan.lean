module

public import MathlibExt.NumberTheory.ModularForms.TwoCuspReductionSpan

@[expose] public section

open scoped TensorProduct MatrixGroups

/-- Source-shaped consumer: the original binders, in the original form. -/
example (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ)
    (K : Type*) [Field K] [Algebra (ZMod p) K] :
    Submodule.span K {x : K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p |
        ∃ (f : CuspForm (CongruenceSubgroup.GammaH M H) 2)
          (hf : f ∈ CuspForm.twoCuspIntegralSet M H 2 p (⊥ : Subring ℂ)),
          x = (1 : K) ⊗ₜ[ZMod p] CuspForm.intTwoCuspReduce M H p
            ⟨f, CuspForm.twoCuspIntegralSet_subset_twoCuspLattice M H 2 p ⊥ hf⟩} = ⊤ :=
  CuspForm.span_tmul_intTwoCuspReduce_eq_top p M H K

/-- Higher-universe consumer: the scalar field may live in `Type 1`. -/
example (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ)
    (K : Type 1) [Field K] [Algebra (ZMod p) K] :
    Submodule.span K {x : K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p |
        ∃ (f : CuspForm (CongruenceSubgroup.GammaH M H) 2)
          (hf : f ∈ CuspForm.twoCuspIntegralSet M H 2 p (⊥ : Subring ℂ)),
          x = (1 : K) ⊗ₜ[ZMod p] CuspForm.intTwoCuspReduce M H p
            ⟨f, CuspForm.twoCuspIntegralSet_subset_twoCuspLattice M H 2 p ⊥ hf⟩} = ⊤ :=
  CuspForm.span_tmul_intTwoCuspReduce_eq_top p M H K

/-- Boundary: reduction modulo `p` is surjective onto the mod-`p` forms, so
the spanning set is not vacuous for formal reasons. -/
example (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ)
    (x : CuspForm.IntTwoCuspForms M H p) :
    ∃ y : CuspForm.twoCuspLattice M H 2 p (⊥ : Subring ℂ),
      CuspForm.intTwoCuspReduce M H p y = x :=
  CuspForm.intTwoCuspReduce_surjective M H p x

/-- Boundary: the mod-`p` forms have exponent `p`; this is where primality
of the scalar action is used, and it fails formally without the quotient
by the ideal generated by `p`. -/
example (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ)
    (x : CuspForm.IntTwoCuspForms M H p) : p • x = 0 :=
  CuspForm.IntTwoCuspForms.nsmul_eq_zero M H p x

/-- The zero cusp form is two-cusp integral, so the spanning set contains
the zero tensor. -/
example (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ)
    (K : Type*) [Field K] [Algebra (ZMod p) K] :
    (0 : K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p) ∈
      Submodule.span K {x : K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p |
        ∃ (f : CuspForm (CongruenceSubgroup.GammaH M H) 2)
          (hf : f ∈ CuspForm.twoCuspIntegralSet M H 2 p (⊥ : Subring ℂ)),
          x = (1 : K) ⊗ₜ[ZMod p] CuspForm.intTwoCuspReduce M H p
            ⟨f, CuspForm.twoCuspIntegralSet_subset_twoCuspLattice M H 2 p ⊥ hf⟩} := by
  rw [CuspForm.span_tmul_intTwoCuspReduce_eq_top]
  exact Submodule.mem_top
