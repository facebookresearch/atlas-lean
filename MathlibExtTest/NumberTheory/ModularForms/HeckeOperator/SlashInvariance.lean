module

public import MathlibExt.NumberTheory.ModularForms.HeckeOperator.SlashInvariance

@[expose] public section

/-- exactSource consumer: invariance of `T p` under `Γ₀(N)`, original binders. -/
example {N : ℕ} (k : ℤ) {p : ℕ} (hp : p.Prime) (hpN : ¬ p ∣ N) {f : UpperHalfPlane → ℂ}
    (hf : ∀ γ ∈ (CongruenceSubgroup.Gamma0 N : Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)),
      SlashAction.map k γ f = f) (γ : Matrix.GeneralLinearGroup (Fin 2) ℝ)
    (hγ : γ ∈ (CongruenceSubgroup.Gamma0 N : Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ))) :
    SlashAction.map k γ (ModularForm.heckeT k p f) = ModularForm.heckeT k p f :=
  ModularForm.heckeT_slash_eq_self_of_mem_Gamma0 k hp hpN hf γ hγ

/-- exactSource consumer: invariance of `U p` under `Γ₀(N)`, original binders. -/
example {N : ℕ} (k : ℤ) {p : ℕ} (hpN : p ∣ N) {f : UpperHalfPlane → ℂ}
    (hf : ∀ γ ∈ (CongruenceSubgroup.Gamma0 N : Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)),
      SlashAction.map k γ f = f) (γ : Matrix.GeneralLinearGroup (Fin 2) ℝ)
    (hγ : γ ∈ (CongruenceSubgroup.Gamma0 N : Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ))) :
    SlashAction.map k γ (ModularForm.heckeU k p f) = ModularForm.heckeU k p f :=
  ModularForm.heckeU_slash_eq_self_of_mem_Gamma0 k hpN hf γ hγ
