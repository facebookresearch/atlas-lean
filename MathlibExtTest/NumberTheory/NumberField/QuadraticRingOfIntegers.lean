module

public import MathlibExt.NumberTheory.NumberField.QuadraticRingOfIntegers
public import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
public import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots

/-!
# Tests for the ring of integers and the discriminant of a quadratic field
-/

set_option autoImplicit false

@[expose] public section

namespace QuadraticRingOfIntegersTest

/-- The Gaussian field `ℚ(i) = ℚ(ζ₄)` has degree `2`. -/
theorem finrank_cyclotomicField_four : Module.finrank ℚ (CyclotomicField 4 ℚ) = 2 := by
  have h := @IsCyclotomicExtension.finrank 4 _ ℚ (CyclotomicField 4 ℚ) _ _ _ _
    (CyclotomicField.isCyclotomicExtension 4 ℚ)
    (Polynomial.cyclotomic.irreducible_rat (n := 4) (by norm_num))
  rw [show Nat.totient 4 = 2 by decide] at h
  convert h

/-- `ℚ(i)` contains a square root `i` of `-1`, namely a primitive fourth root of unity. -/
theorem exists_sq_eq_neg_one :
    ∃ i : CyclotomicField 4 ℚ, i ^ 2 = ((-1 : ℤ) : CyclotomicField 4 ℚ) := by
  obtain ⟨ζ, h⟩ := (CyclotomicField.isCyclotomicExtension 4 ℚ).exists_isPrimitiveRoot
    (Set.mem_singleton 4) (by norm_num)
  refine ⟨ζ, ?_⟩
  have h1 : ζ ^ 2 ≠ 1 := h.pow_ne_one_of_pos_of_lt (l := 2) two_ne_zero (by norm_num)
  have h4 : (ζ ^ 2 - 1) * (ζ ^ 2 + 1) = 0 := by linear_combination h.pow_eq_one
  rcases mul_eq_zero.mp h4 with h' | h'
  · exact absurd (sub_eq_zero.mp h') h1
  · push_cast
    linear_combination h'

/-- A chosen square root `i` of `-1` in `ℚ(i)`. -/
noncomputable def gaussI : CyclotomicField 4 ℚ := exists_sq_eq_neg_one.choose

/-- `i² = -1`. -/
theorem gaussI_sq : gaussI ^ 2 = ((-1 : ℤ) : CyclotomicField 4 ℚ) :=
  exists_sq_eq_neg_one.choose_spec

/-- `-1` is squarefree. -/
theorem squarefree_neg_one : Squarefree (-1 : ℤ) := isUnit_one.neg.squarefree

/-- The discriminant of `ℚ(i)` is `-4`. -/
example : NumberField.discr (CyclotomicField 4 ℚ) = -4 := by
  obtain ⟨i, hi⟩ := exists_sq_eq_neg_one
  rw [NumberField.discr_eq_of_sq_eq finrank_cyclotomicField_four hi squarefree_neg_one
    (by norm_num)]
  decide

/-- `𝒪_{ℚ(i)} = ℤ[i]`. (The statement is left to be inferred: written out with
`integralClosure ℤ (CyclotomicField 4 ℚ)`, the elaborator picks Mathlib's `ℤ`-algebra structure on
`CyclotomicField`, which is not syntactically the one in the theorem.) -/
example := NumberField.mem_integralClosure_iff_of_sq_eq finrank_cyclotomicField_four gaussI_sq
  squarefree_neg_one (by norm_num)

/-- `ℚ(i)` is generated by a square root of a squarefree integer. -/
example : ∃ (θ : CyclotomicField 4 ℚ) (m : ℤ), θ ^ 2 = m ∧ Squarefree m ∧ m ≠ 1 :=
  NumberField.exists_sq_eq_squarefree finrank_cyclotomicField_four

/-- The discriminant of `ℚ(i)` is fundamental. -/
example : MetaMathlibExt.IsFundamentalDiscriminant (NumberField.discr (CyclotomicField 4 ℚ)) :=
  NumberField.isFundamentalDiscriminant_discr finrank_cyclotomicField_four

/-- The discriminant of `ℚ(i)` is a square in `ℚ(i)`. -/
example : ∃ δ : CyclotomicField 4 ℚ, δ ^ 2 = NumberField.discr (CyclotomicField 4 ℚ) :=
  NumberField.exists_sq_eq_discr finrank_cyclotomicField_four

/-- `-4` is a fundamental discriminant, and `(2i)² = -4`, so `disc ℚ(i) = -4` again. -/
example : NumberField.discr (CyclotomicField 4 ℚ) = -4 := by
  obtain ⟨i, hi⟩ := exists_sq_eq_neg_one
  refine NumberField.discr_eq_of_sq_eq_fundamental finrank_cyclotomicField_four (θ := 2 * i) ?_
    (Or.inr ⟨-1, by norm_num, squarefree_neg_one, by decide⟩) (by norm_num)
  push_cast at hi ⊢
  linear_combination 4 * hi

variable {K : Type*} [Field K] [NumberField K]

/-- `𝒪_K = ℤ + ℤ(D + δ)/2` for a quadratic field `K` of discriminant `D`, with `δ² = D`. -/
example (hK : Module.finrank ℚ K = 2) :
    ∃ δ : K, ∀ x : K, x ∈ integralClosure ℤ K ↔
      ∃ a b : ℤ, x = a + b * ((NumberField.discr K + δ) / 2) := by
  obtain ⟨δ, hδ⟩ := NumberField.exists_sq_eq_discr hK
  exact ⟨δ, NumberField.mem_integralClosure_iff_of_sq_eq_discr hK hδ⟩

#check @NumberField.exists_sq_eq_squarefree
#check @NumberField.mem_integralClosure_iff_of_sq_eq
#check @NumberField.discr_eq_of_sq_eq
#check @NumberField.isFundamentalDiscriminant_discr
#check @NumberField.mem_integralClosure_iff_of_sq_eq_discr
#check @NumberField.exists_sq_eq_discr
#check @NumberField.discr_eq_of_sq_eq_fundamental

end QuadraticRingOfIntegersTest
