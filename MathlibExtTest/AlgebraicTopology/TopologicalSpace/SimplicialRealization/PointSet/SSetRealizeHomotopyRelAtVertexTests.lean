module


import
  MathlibExt.AlgebraicTopology.TopologicalSpace.SimplicialRealization.PointSet.SSetRealizeHomotopyRelAtVertex

/-!
# Realized vertex-relative homotopy tests

These clients pin the map-level stationarity identity, exact continuous
relative-homotopy type, ordinary underlying homotopy, both endpoints, and
the fixed realized target vertex. They cover a general containing subcomplex,
the generated-vertex specialization, and universes zero and one.
-/

@[expose] public section

noncomputable section

set_option autoImplicit false

open CategoryTheory Limits Simplicial MonoidalCategory
open scoped Simplicial

universe u

namespace MathlibExtTest.AlgebraicTopology.ModelCategory
namespace SSetRealizeHomotopyRelAtVertexTests

section Generic

variable {X Y : SSet.{u}} {f g : X ⟶ Y} {S : X.Subcomplex}
  (H : SSet.HomotopyRel f g S)
  (z : X.obj (Opposite.op (SimplexCategory.mk 0)))
  (hz : z ∈ S.obj (Opposite.op (SimplexCategory.mk 0)))

/-- The map-level stationarity square has identity on the interval and the
realized constant vertex map in the source factor. -/
example :
    Limits.prod.map (𝟙 TopCat.I.{u})
        (SSet.toTop.map
          (SSet.const z : (Δ[0] : SSet.{u}) ⟶ X)) ≫
        SSet.realizeHomotopyMap X Y f g H.toHomotopy =
      Limits.prod.snd ≫
        SSet.toTop.map
          ((SSet.const z : (Δ[0] : SSet.{u}) ⟶ X) ≫ f) :=
  SSet.realizeHomotopyMap_stationary_at_vertex H z hz

/-- The realized homotopy is relative to exactly the singleton containing
the realized source vertex. -/
example :
    ContinuousMap.HomotopyRel
      (SSet.toTop.map f).hom (SSet.toTop.map g).hom
      {SSet.realizedVertex z} :=
  SSet.realizeHomotopyRelAtVertex H z hz

/-- Forgetting stationarity returns the exact existing ordinary realized
homotopy. -/
example :
    (SSet.realizeHomotopyRelAtVertex H z hz).toHomotopy =
      SSet.realizeHomotopy X Y f g H.toHomotopy :=
  SSet.realizeHomotopyRelAtVertex_toHomotopy H z hz

/-- Time zero is the realized first endpoint. -/
example (x : SSet.toTop.obj X) :
    SSet.realizeHomotopyRelAtVertex H z hz (0, x) =
      SSet.toTop.map f x :=
  (SSet.realizeHomotopyRelAtVertex H z hz).map_zero_left x

/-- Time one is the realized second endpoint. -/
example (x : SSet.toTop.obj X) :
    SSet.realizeHomotopyRelAtVertex H z hz (1, x) =
      SSet.toTop.map g x :=
  (SSet.realizeHomotopyRelAtVertex H z hz).map_one_left x

/-- Every time fixes the basepoint at the literal realized image vertex. -/
example (t : unitInterval) :
    SSet.realizeHomotopyRelAtVertex H z hz
        (t, SSet.realizedVertex z) =
      SSet.realizedVertex (f.app _ z) :=
  SSet.realizeHomotopyRelAtVertex_apply_basepoint H z hz t

end Generic

section GeneratedVertexSubcomplex

variable {X Y : SSet.{u}} {f g : X ⟶ Y}
  (z : X.obj (Opposite.op (SimplexCategory.mk 0)))
  (H : SSet.HomotopyRel f g (SSet.Subcomplex.ofSimplex z))

/-- A homotopy relative to the subcomplex generated by z specializes
without a second constructor. -/
example :
    ContinuousMap.HomotopyRel
      (SSet.toTop.map f).hom (SSet.toTop.map g).hom
      {SSet.realizedVertex z} :=
  SSet.realizeHomotopyRelAtVertex H z
    (SSet.Subcomplex.mem_ofSimplex_obj z)

end GeneratedVertexSubcomplex

section UniverseZero

/-- Explicit universe-zero client. -/
example {X Y : SSet.{0}} {f g : X ⟶ Y} {S : X.Subcomplex}
    (H : SSet.HomotopyRel f g S)
    (z : X.obj (Opposite.op (SimplexCategory.mk 0)))
    (hz : z ∈ S.obj (Opposite.op (SimplexCategory.mk 0))) :
    ContinuousMap.HomotopyRel
      (SSet.toTop.map f).hom (SSet.toTop.map g).hom
      {SSet.realizedVertex z} :=
  SSet.realizeHomotopyRelAtVertex H z hz

end UniverseZero

section UniverseOne

/-- Explicit universe-one client. -/
example {X Y : SSet.{1}} {f g : X ⟶ Y} {S : X.Subcomplex}
    (H : SSet.HomotopyRel f g S)
    (z : X.obj (Opposite.op (SimplexCategory.mk 0)))
    (hz : z ∈ S.obj (Opposite.op (SimplexCategory.mk 0))) :
    ContinuousMap.HomotopyRel
      (SSet.toTop.map f).hom (SSet.toTop.map g).hom
      {SSet.realizedVertex z} :=
  SSet.realizeHomotopyRelAtVertex H z hz

end UniverseOne

section PrivacyAndNonclaims

#guard_msgs (error, substring := true) in
#check SSet.homotopyPrecomp_h_eq_fst_at_vertex

#guard_msgs (error, substring := true) in
#check CategoryTheory.Waldhausen.SConstruction.
  extensionToSubobjectCofiberNaturalityRealizedHomotopyRel

#guard_msgs (error, substring := true) in
#check SSet.realizeHomotopyRelAtVertex_loopMap

#guard_msgs (error, substring := true) in
#check SSet.realizeHomotopyRelAtVertex_mem_weakHomotopyEquivalences

end PrivacyAndNonclaims

#print axioms SSet.realizeHomotopyMap_stationary_at_vertex
#print axioms SSet.realizeHomotopyRelAtVertex
#print axioms SSet.realizeHomotopyRelAtVertex_toHomotopy
#print axioms SSet.realizeHomotopyRelAtVertex_apply_basepoint

end SSetRealizeHomotopyRelAtVertexTests
end MathlibExtTest.AlgebraicTopology.ModelCategory
