module

public import MathlibExt.Probability.StrongMarkovIID

/-!
# Tests for the strong Markov property for i.i.d. sequences

Generic restatements of the public signatures in
`MathlibExt.Probability.StrongMarkovIID`, plus a concrete instance: for a
constant stopping time `T ≡ c`, the post-stopping-time sequence is the shift
`k ↦ X (c + k + 1)`, which the main theorems say is i.i.d. with the same
distribution as `X 0`. The stopping-time filtration is contained in the natural
filtration of `X`, as required by `hfX`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace MathlibExtTest.Probability.StrongMarkovIID

variable {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
  {S : Type*} [MeasurableSpace S]

/-- The identically-distributed part restates with the exact public signature. -/
example {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›)
    (k : ℕ) :
    IdentDistrib (postStoppingTimeSeq X T k) (X 0) μ μ :=
  strong_markov_iid_identDistrib hX_id hX_ind hX_meas hT hfX k

/-- The independence part restates with the exact public signature. -/
example {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›) :
    iIndepFun (m := fun _ => ‹MeasurableSpace S›) (postStoppingTimeSeq X T) μ :=
  strong_markov_iid_iIndepFun hX_id hX_ind hX_meas hT hfX

/-- The combined statement restates with the exact public signature. -/
example {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›) :
    (∀ k, IdentDistrib (postStoppingTimeSeq X T k) (X 0) μ μ) ∧
    iIndepFun (m := fun _ => ‹MeasurableSpace S›) (postStoppingTimeSeq X T) μ :=
  strong_markov_iid_postStoppingTimeSeq hX_id hX_ind hX_meas hT hfX

section ConstantStoppingTime

/-- The filtration generated by `X` up to each time `n`, in the finset form
used by the `hfX` hypothesis: at time `n` it is the supremum of the
`σ`-algebras generated by `X 0, …, X n`. -/
def filtrationUpTo (X : ℕ → Ω → S) (hX_meas : ∀ i, Measurable (X i)) :
    Filtration ℕ m where
  seq n := ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›
  mono' := by
    intro n n' hnn'
    apply biSup_mono
    intro i hi
    simp only [Finset.mem_range] at hi ⊢
    omega
  le' := by
    intro n
    apply iSup₂_le
    intro i _
    exact measurable_iff_comap_le.mp (hX_meas i)

/-- Concrete instance: stopping at the constant time `c` against the filtration
generated by `X`, the shifted sequence `k ↦ X (c + k + 1)` (the
post-stopping-time sequence at `T ≡ c`, definitionally) is i.i.d. with the same
distribution as `X 0`. -/
theorem strong_markov_iid_const_stopping_time {X : ℕ → Ω → S}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i)) (c : ℕ) :
    (∀ k, IdentDistrib (fun ω => X (c + k + 1) ω) (X 0) μ μ) ∧
    iIndepFun (m := fun _ => ‹MeasurableSpace S›) (fun k ω => X (c + k + 1) ω) μ :=
  strong_markov_iid_postStoppingTimeSeq hX_id hX_ind hX_meas
    (isStoppingTime_const (filtrationUpTo X hX_meas) (↑c))
    (fun _ => le_rfl)

end ConstantStoppingTime

end MathlibExtTest.Probability.StrongMarkovIID
