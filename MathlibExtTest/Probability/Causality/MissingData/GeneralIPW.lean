module

public import MathlibExt.Probability.Causality.MissingData.GeneralIPW
public import MathlibExtTest.Probability.Causality.MissingData.Identification

/-!
# Tests for inverse-response weighting under MAR with a general covariate σ-algebra

The probability space is two independent fair coins, `Ω = Bool × Bool` (from the
`MissingData.Identification` tests).

* Outcome measurable in the covariate information: MAR given `m` holds for every response event
  (`mar_sigma_of_measurable`).
* Trivial σ-algebra: MAR given `⊥` is independence; it holds for the first coin as response and
  any function of the second coin as outcome, which is not `⊥`-measurable, and the weighted mean
  identifies `E[Y]`.
* Covariate σ-algebra `σ(X)`, `X = ω.1`, response `X = true ∨ ω.2 = true`: the response
  probability is `1` or `1/2` depending on `X` and the weighted mean identifies `E[Y]`.
* Boundary, positivity: with full information `m = mΩ`, MAR holds for every response event,
  but `P(R | m) = 1_R` has no positive lower bound and the weighted mean is `P(R) = 1/2` while
  `E[Y] = 1`.
* The MAR hypothesis is the conditional-expectation form of Mathlib's `CondIndep`: on a standard
  Borel space it follows from `CondIndep m σ(R) σ(Y)` by `condIndep_iff`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory MathlibExt.Probability.Causality
open MathlibExt.Probability.Causality.MissingData
open MathlibExtTest.Probability.Causality.MissingData.Identification

namespace MathlibExtTest.Probability.Causality.MissingData.GeneralIPW

/-! ### General API -/

section General

variable {Ω : Type*} {m mΩ : MeasurableSpace Ω} {μ : Measure Ω}

/-- **Non-vacuity of MAR given `m`**: an outcome that is measurable in the covariate information
`m` is conditionally independent of every response event given `m`. -/
theorem mar_sigma_of_measurable [IsFiniteMeasure μ] (hm : m ≤ mΩ) {R : Set Ω}
    (hR : MeasurableSet R) {Y : Ω → ℝ} (hYm : Measurable[m] Y) (S : Set ℝ)
    (hS : MeasurableSet S) :
    (μ⟦R ∩ Y ⁻¹' S | m⟧) =ᵐ[μ] (μ⟦R | m⟧) * (μ⟦Y ⁻¹' S | m⟧) := by
  have hB : MeasurableSet[m] (Y ⁻¹' S) := hYm hS
  have h1 : (R ∩ Y ⁻¹' S).indicator (fun _ => (1 : ℝ)) =
      (Y ⁻¹' S).indicator (R.indicator fun _ => (1 : ℝ)) := by
    rw [Set.indicator_indicator, Set.inter_comm]
  have h2 : (μ⟦Y ⁻¹' S | m⟧) = (Y ⁻¹' S).indicator fun _ => (1 : ℝ) :=
    condExp_of_stronglyMeasurable hm (stronglyMeasurable_const.indicator hB)
      ((integrable_const (1 : ℝ)).indicator (hm _ hB))
  rw [h1, h2]
  refine (condExp_indicator ((integrable_const (1 : ℝ)).indicator hR) hB).trans
    (Filter.Eventually.of_forall fun ω => ?_)
  by_cases hω : ω ∈ Y ⁻¹' S <;> simp [hω]

/-- The weighted outcome is integrable under MAR given `m` and strong positivity. -/
example (hm : m ≤ mΩ) {R : Set Ω} (hR : MeasurableSet R) {Y : Ω → ℝ} (hYi : Integrable Y μ)
    {ε : ℝ} (hε : 0 < ε) (hpos : ∀ᵐ ω ∂μ, ε ≤ (μ⟦R | m⟧) ω) :
    Integrable (R.indicator fun ω => Y ω / (μ⟦R | m⟧) ω) μ :=
  integrable_ipw_of_mar_sigma hm hR hYi hε hpos

/-- The MAR hypothesis is the conditional-expectation form of Mathlib's `CondIndep`: on a
standard Borel space, `R ⊥ Y | m` for the σ-algebras generated by `R` and `Y` gives it. -/
example [StandardBorelSpace Ω] [IsFiniteMeasure μ] (hm : m ≤ mΩ) {R : Set Ω}
    (hR : MeasurableSet R) {Y : Ω → ℝ} (hY : Measurable Y)
    (h : CondIndep m (MeasurableSpace.generateFrom {R}) (MeasurableSpace.comap Y inferInstance)
      hm μ) (S : Set ℝ) (hS : MeasurableSet S) :
    (μ⟦R ∩ Y ⁻¹' S | m⟧) =ᵐ[μ] (μ⟦R | m⟧) * (μ⟦Y ⁻¹' S | m⟧) :=
  (condIndep_iff m _ _ hm (MeasurableSpace.generateFrom_le (by simpa using hR)) hY.comap_le μ).1
    h R (Y ⁻¹' S) (MeasurableSpace.measurableSet_generateFrom rfl) ⟨S, hS, rfl⟩

end General

/-! ### Trivial covariate information: MAR is independence -/

lemma coins_real_resp_inter (g : Bool → ℝ) (S : Set ℝ) :
    coins.real (resp ∩ (fun ω : Bool × Bool => g ω.2) ⁻¹' S) =
      coins.real resp * coins.real ((fun ω : Bool × Bool => g ω.2) ⁻¹' S) := by
  have h1 : resp ∩ (fun ω : Bool × Bool => g ω.2) ⁻¹' S = {true} ×ˢ (g ⁻¹' S) := by
    ext ⟨a, b⟩; simp [resp]
  have h2 : (fun ω : Bool × Bool => g ω.2) ⁻¹' S = Set.univ ×ˢ (g ⁻¹' S) := by
    ext ⟨a, b⟩; simp
  rw [h1, h2, coins_real_prod, coins_real_prod, coins_real_resp, coin_singleton, coin_real_univ,
    one_mul]

/-- **Non-vacuity, trivial σ-algebra**: the first coin as response is MAR given `⊥` for any
outcome of the second coin (not `⊥`-measurable). -/
theorem mar_sigma_bot (g : Bool → ℝ) (S : Set ℝ) (_hS : MeasurableSet S) :
    (coins⟦resp ∩ (fun ω : Bool × Bool => g ω.2) ⁻¹' S | ⊥⟧) =ᵐ[coins]
      (coins⟦resp | ⊥⟧) * (coins⟦(fun ω : Bool × Bool => g ω.2) ⁻¹' S | ⊥⟧) := by
  refine Filter.Eventually.of_forall fun ω => ?_
  simp only [condExp_bot, Pi.mul_apply]
  rw [integral_indicator_const _ (MeasurableSet.of_discrete),
    integral_indicator_const _ measurableSet_resp,
    integral_indicator_const _ (MeasurableSet.of_discrete), coins_real_resp_inter]
  simp

lemma condExp_resp_bot : (coins⟦resp | ⊥⟧) = fun _ => 1 / 2 := by
  rw [condExp_bot, integral_indicator_const _ measurableSet_resp, coins_real_resp, smul_eq_mul,
    mul_one]

/-- IPW identification given `⊥`, outcome `Y = g ω.2`: the response probability is `1/2`. -/
example (g : Bool → ℝ) :
    ∫ ω, resp.indicator (fun ω => g ω.2 / (coins⟦resp | ⊥⟧) ω) ω ∂coins =
      ∫ ω, g ω.2 ∂coins :=
  integral_ipw_eq_integral_of_mar_sigma bot_le measurableSet_resp (measurable_of_finite _)
    Integrable.of_finite (mar_sigma_bot g) (by norm_num : (0 : ℝ) < 1 / 2)
    (Filter.Eventually.of_forall fun _ => by rw [condExp_resp_bot])

/-! ### Covariate σ-algebra with a covariate-dependent response probability -/

/-- Full covariate information `m = mΩ`. -/
abbrev mTop : MeasurableSpace (Bool × Bool) := inferInstance

/-- The covariate information `σ(X)`, `X = ω.1`. -/
abbrev mX : MeasurableSpace (Bool × Bool) := MeasurableSpace.comap Prod.fst inferInstance

lemma mX_le : mX ≤ mTop := measurable_fst.comap_le

/-- IPW identification given `σ(X)` on the MAR witness `resp₂ = {X = true ∨ ω.2 = true}` with
outcome `Y = g X`; the response probability is `P(R | σ(X)) = π(X)`, with `π(true) = 1` and
`π(false) = 1/2`, bounded below by `min (π true) (π false) > 0`. -/
example (g : Bool → ℝ) :
    ∫ ω, resp₂.indicator (fun ω => g ω.1 / (coins⟦resp₂ | mX⟧) ω) ω ∂coins =
      ∫ ω, g ω.1 ∂coins := by
  have hYm : Measurable[mX] fun ω : Bool × Bool => g ω.1 :=
    (measurable_of_finite g).comp (comap_measurable Prod.fst)
  refine integral_ipw_eq_integral_of_mar_sigma mX_le measurableSet_resp₂
    (measurable_of_finite _) Integrable.of_finite
    (mar_sigma_of_measurable mX_le measurableSet_resp₂ hYm)
    (lt_min (propensity_resp₂_pos true) (propensity_resp₂_pos false)) ?_
  filter_upwards [condExp_indicator_comap_ae_eq (μ := coins) measurable_fst
    measurableSet_resp₂] with ω h
  rw [h]
  cases ω.1
  · exact min_le_right _ _
  · exact min_le_left _ _

/-! ### Boundary: positivity cannot be dropped -/

lemma condExp_resp_top : (coins⟦resp | mTop⟧) = resp.indicator fun _ => (1 : ℝ) :=
  condExp_of_stronglyMeasurable le_rfl (stronglyMeasurable_const.indicator measurableSet_resp)
    ((integrable_const (1 : ℝ)).indicator measurableSet_resp)

/-- **Positivity is needed**: with full information, MAR given `mΩ` holds for the outcome
`Y = 1` (any outcome is `mΩ`-measurable), but `P(R | mΩ) = 1_R` vanishes on the nonrespondents,
so no `ε > 0` bounds it below, and the weighted mean is `P(R) = 1/2 ≠ 1 = E[Y]`. -/
example :
    (∀ S, MeasurableSet S → (coins⟦resp ∩ (fun _ => (1 : ℝ)) ⁻¹' S | mTop⟧) =ᵐ[coins]
      (coins⟦resp | mTop⟧) * (coins⟦(fun _ => (1 : ℝ)) ⁻¹' S | mTop⟧)) ∧
    (∀ ε : ℝ, 0 < ε → ¬ ∀ᵐ ω ∂coins, ε ≤ (coins⟦resp | mTop⟧) ω) ∧
    ∫ ω, resp.indicator (fun ω => (1 : ℝ) / (coins⟦resp | mTop⟧) ω) ω ∂coins = 1 / 2 ∧
    ∫ _, (1 : ℝ) ∂coins = 1 := by
  refine ⟨mar_sigma_of_measurable le_rfl measurableSet_resp measurable_const, fun ε hε h => ?_,
    ?_, by simp⟩
  · rw [ae_iff] at h
    have hsub : ({(false, false)} : Set (Bool × Bool)) ⊆
        {ω | ¬ ε ≤ (coins⟦resp | mTop⟧) ω} := by
      rintro ω rfl
      rw [Set.mem_ofPred_eq, condExp_resp_top, Set.indicator_of_notMem (by simp [resp])]
      exact not_le.2 hε
    have h0 := measure_mono_null hsub h
    have h4 := coins_real_singleton (false, false)
    rw [measureReal_def, h0] at h4
    norm_num at h4
  · have heq : (resp.indicator fun ω => (1 : ℝ) / (coins⟦resp | mTop⟧) ω) =
        resp.indicator fun _ => (1 : ℝ) := by
      rw [condExp_resp_top]
      exact Set.indicator_congr fun ω hω => by simp [hω]
    rw [heq, integral_indicator_const _ measurableSet_resp, coins_real_resp, smul_eq_mul,
      mul_one]

end MathlibExtTest.Probability.Causality.MissingData.GeneralIPW
