module

public import MathlibExt.Probability.StrongMarkovIIDIndepPast
public import MathlibExtTest.Probability.StrongMarkovIID

/-!
# Tests for the strong Markov property for i.i.d. sequences: independence from the past

Canonical and expanded-signature clients, a client combining all three
strong Markov facts for the same `postStoppingTimeSeq X T`, and the
existing constant-time property using the shared `StrongMarkovIID` test fixture:
for a constant stopping time `T ≡ c`, the stopped σ-algebra is `ℱ_c` and the
post-stopping-time sequence is the shift `k ↦ X (c + k + 1)`, so the theorem
says the shift is independent of `ℱ_c`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory
open MathlibExtTest.Probability.StrongMarkovIID (filtrationUpTo)

namespace MathlibExtTest.Probability.StrongMarkovIIDIndepPast

variable {Ω : Type*} {m : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
  {S : Type*} [MeasurableSpace S]

/-- The independence-from-the-past statement restates with the exact public signature. -/
example {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›) :
    Indep (hT.measurableSpace)
      (⨆ k, MeasurableSpace.comap (postStoppingTimeSeq X T k) ‹MeasurableSpace S›)
      (μ := μ) :=
  strong_markov_iid_indep_past hX_id hX_ind hX_meas hT hfX

/-- Existing clients using the expanded tail lambda still elaborate unchanged. -/
example {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›) :
    Indep (hT.measurableSpace)
      (⨆ k, MeasurableSpace.comap (fun ω => X (T ω + k + 1) ω) ‹MeasurableSpace S›)
      (μ := μ) :=
  strong_markov_iid_indep_past hX_id hX_ind hX_meas hT hfX

/-- Both modules describe one canonical post-stopping sequence: it has the
original one-coordinate laws, is independent, and is independent of the past. -/
example {X : ℕ → Ω → S} {f : Filtration ℕ m} {T : Ω → ℕ}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i))
    (hT : IsStoppingTime f (fun ω => (T ω : ℕ∞)))
    (hfX : ∀ n, f n ≤ ⨆ i ∈ Finset.range (n + 1), MeasurableSpace.comap (X i) ‹MeasurableSpace S›) :
    (∀ k, IdentDistrib (postStoppingTimeSeq X T k) (X 0) μ μ) ∧
    iIndepFun (m := fun _ => ‹MeasurableSpace S›) (postStoppingTimeSeq X T) μ ∧
    Indep hT.measurableSpace
      (⨆ k, MeasurableSpace.comap (postStoppingTimeSeq X T k) ‹MeasurableSpace S›) μ := by
  obtain ⟨h_id, h_ind⟩ := strong_markov_iid_postStoppingTimeSeq
    hX_id hX_ind hX_meas hT hfX
  exact ⟨h_id, h_ind, strong_markov_iid_indep_past hX_id hX_ind hX_meas hT hfX⟩

section ConstantStoppingTime

/-- Concrete instance: stopping at the constant time `c` against the filtration
generated by `X`, the shifted sequence `k ↦ X (c + k + 1)` is independent of
`ℱ_c`. -/
theorem strong_markov_iid_indep_past_const_stopping_time {X : ℕ → Ω → S}
    (hX_id : ∀ i j, IdentDistrib (X i) (X j) μ μ)
    (hX_ind : iIndepFun (m := fun _ => ‹MeasurableSpace S›) X μ)
    (hX_meas : ∀ i, Measurable (X i)) (c : ℕ) :
    Indep ((filtrationUpTo X hX_meas) c)
      (⨆ k, MeasurableSpace.comap (fun ω => X (c + k + 1) ω) ‹MeasurableSpace S›) μ := by
  have h := strong_markov_iid_indep_past hX_id hX_ind hX_meas
    (isStoppingTime_const (filtrationUpTo X hX_meas) (↑c))
    (fun _ => le_rfl)
  rw [IsStoppingTime.measurableSpace_const] at h
  exact h

end ConstantStoppingTime

#print axioms ProbabilityTheory.strong_markov_iid_indep_past

end MathlibExtTest.Probability.StrongMarkovIIDIndepPast
