module

import MathlibExt.CategoryTheory.CategoryBar.QuillenTheoremA
import Mathlib.CategoryTheory.Category.GaloisConnection

/-!
# Quillen Theorem A public contract

These external tests use only the three public task endpoints.  They pin the
arbitrary simplicial universe of ProductFiber and Theorem A-star, the
`SSet.{max u v}` categorical endpoint, several genuinely different comma
categories, and the hypotheses which must not be weakened.

No carrier, fiber, deformation, bridge, or cancellation implementation detail
is named here.
-/

noncomputable section

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Opposite Simplicial
open scoped MonoidalCategory

namespace MathlibExtTest.CategoryTheory.CategoryBar.QuillenTheoremATests

universe u v

/-! ## The three public endpoints -/

section PublicEndpoints

variable {X Y T : SSet.{u}} (f : X ⟶ Y) (g : X ⟶ T)

variable (h : ∀ (m : ℕ) (y : Y _⦋m⦌),
  TopCat.weakHomotopyEquivalences
    (SSet.toTop.map (SSet.leftFiber.π f y ≫ g)))

/-- The simplex-resolution endpoint is genuinely universe-polymorphic. -/
example : SSet.realizationWeakEquivalences
    (SSet.simplexResolutionMap
      (p := f) (q := (Limits.prod.fst : Y ⨯ T ⟶ Y))
      (Limits.prod.lift f g) (Limits.prod.lift_fst f g)) :=
  SSet.simplexResolutionMap_prod_mem_realizationWeakEquivalences f g h

/-- The A-star endpoint retains the source-first ordered pair. -/
example : TopCat.weakHomotopyEquivalences
    (SSet.toTop.map (Limits.prod.lift f g)) :=
  SSet.theoremAStar f g h

variable {C D : Type u} [Category.{v} C] [Category.{v} D]

/-- The categorical theorem has the literal `SSet.{max u v}` hypothesis and
conclusion. -/
example (F : C ⥤ D)
    (hF : ∀ d : D,
      SSet.realizationWeakEquivalences
        (terminal.from
          (nerve (StructuredArrow d F) : SSet.{max u v}))) :
    SSet.realizationWeakEquivalences
      (nerveMap F : (nerve C : SSet.{max u v}) ⟶ nerve D) :=
  CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow
    F hF

end PublicEndpoints

