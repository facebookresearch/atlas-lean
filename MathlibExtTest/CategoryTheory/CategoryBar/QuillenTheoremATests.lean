/-! ## Comma hypotheses generated by adjunctions -/

section AdjunctionClients

variable {C D : Type u} [Category.{v} C] [Category.{v} D]

/-- A right adjoint satisfies the public left-comma hypothesis because the
adjunction unit selects an initial object in every structured arrow. -/
theorem theoremA_of_adjunction {L : D ⥤ C} (F : C ⥤ D)
    (adj : L ⊣ F) :
    SSet.realizationWeakEquivalences
      (nerveMap F : (nerve C : SSet.{max u v}) ⟶ nerve D) := by
  apply
    CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow
  intro d
  exact
    NerveContractible.nerve_to_terminal_mem_realizationWeakEquivalences_of_isInitial
      (mkInitialOfLeftAdjoint F adj d)

/-- Identity is a non-vacuous same-category client. -/
theorem identity_client :
    SSet.realizationWeakEquivalences
      (nerveMap (𝟭 C) :
        (nerve C : SSet.{max u v}) ⟶ nerve C) :=
  theoremA_of_adjunction (𝟭 C) Adjunction.id

/-- A genuine categorical equivalence is tested through its inverse
adjunction, rather than through an isomorphism shortcut for `nerveMap`. -/
theorem equivalence_client (e : C ≌ D) :
    SSet.realizationWeakEquivalences
      (nerveMap e.functor :
        (nerve C : SSet.{max u v}) ⟶ nerve D) :=
  theoremA_of_adjunction e.functor e.symm.toAdjunction

end AdjunctionClients

/-! ## Concrete finite-preorder clients -/

section FinitePreorders

/-- The unique functor `Fin 2 ⟶ Fin 1` is right adjoint to the functor
selecting the initial object `0 : Fin 2`. -/
private theorem initialToTerminalGC :
    GaloisConnection
      (fun _ : Fin 1 => (0 : Fin 2))
      (fun _ : Fin 2 => (0 : Fin 1)) := by
  intro a b
  simp

private def initialToTerminal : Fin 2 ⥤ Fin 1 :=
  initialToTerminalGC.monotone_u.functor

theorem initial_source_to_terminal_client :
    SSet.realizationWeakEquivalences
      (nerveMap initialToTerminal :
        (nerve (Fin 2) : SSet.{0}) ⟶ nerve (Fin 1)) :=
  theoremA_of_adjunction initialToTerminal (GaloisConnection.adjunction initialToTerminalGC)

/-- The point selecting `1 : Fin 2` is right adjoint to the unique functor
`Fin 2 ⟶ Fin 1`; this exercises a terminal-object point inclusion. -/
private theorem terminalPointGC :
    GaloisConnection
      (fun _ : Fin 2 => (0 : Fin 1))
      (fun _ : Fin 1 => (1 : Fin 2)) := by
  intro a b
  constructor
  · intro _
    exact Fin.le_last _
  · intro _
    exact Fin.zero_le _

private def terminalPoint : Fin 1 ⥤ Fin 2 :=
  terminalPointGC.monotone_u.functor

theorem terminal_point_client :
    SSet.realizationWeakEquivalences
      (nerveMap terminalPoint :
        (nerve (Fin 1) : SSet.{0}) ⟶ nerve (Fin 2)) :=
  theoremA_of_adjunction terminalPoint (GaloisConnection.adjunction terminalPointGC)

end FinitePreorders

/-! ## A non-thin finite-category client -/

section ParallelPair

example : WalkingParallelPairHom.left ≠ WalkingParallelPairHom.right := by
  decide

/-- The endpoint applies without collapsing the two parallel generators. -/
theorem walkingParallelPair_identity_client :
    SSet.realizationWeakEquivalences
      (nerveMap (𝟭 WalkingParallelPair) :
        (nerve WalkingParallelPair : SSet.{0}) ⟶
          nerve WalkingParallelPair) :=
  identity_client

end ParallelPair

/-! ## The non-strict skeleton falsifier -/

private inductive SkeletonObject
  | star

private inductive WalkingIsoObject
  | left
  | right

private instance : Category.{0} SkeletonObject where
  Hom _ _ := PUnit
  id _ := PUnit.unit
  comp _ _ := PUnit.unit

private instance : Category.{0} WalkingIsoObject where
  Hom _ _ := PUnit
  id _ := PUnit.unit
  comp _ _ := PUnit.unit

private def skeletonInclusion : SkeletonObject ⥤ WalkingIsoObject where
  obj _ := .left
  map _ := PUnit.unit

private instance : skeletonInclusion.EssSurj where
  mem_essImage Y := by
    refine ⟨SkeletonObject.star, ⟨?_⟩⟩
    exact
      { hom := PUnit.unit
        inv := PUnit.unit
        hom_inv_id := rfl
        inv_hom_id := rfl }

private def strictObjectFiber (d : WalkingIsoObject) : Type :=
  { c : SkeletonObject // skeletonInclusion.obj c = d }

/-- Essential surjectivity does not make the omitted object's strict object
fiber nonempty. -/
example : IsEmpty (strictObjectFiber .right) := by
  constructor
  rintro ⟨c, hc⟩
  cases c
  cases hc

/-- Its structured-arrow category is nevertheless nonempty. -/
example : Nonempty (StructuredArrow .right skeletonInclusion) :=
  ⟨StructuredArrow.mk (Y := SkeletonObject.star)
    (PUnit.unit : WalkingIsoObject.right ⟶
      skeletonInclusion.obj SkeletonObject.star)⟩

/-! ## Genuine negative elaboration controls -/

section NegativeControls

variable {C D : Type u} [Category.{v} C] [Category.{v} D]
variable (F : C ⥤ D)

/- A right-comma hypothesis has the wrong variance. -/
#guard_msgs (error, substring := true) in
example
    (hWrong : ∀ d : D,
      SSet.realizationWeakEquivalences
        (terminal.from
          (nerve (CostructuredArrow F d) : SSet.{max u v}))) :
    SSet.realizationWeakEquivalences
      (nerveMap F : (nerve C : SSet.{max u v}) ⟶ nerve D) :=
  CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow
    F hWrong

/- The conclusion is unavailable when the all-object hypothesis is omitted. -/
#guard_msgs (error, substring := true) in
example : SSet.realizationWeakEquivalences
    (nerveMap F : (nerve C : SSet.{max u v}) ⟶ nerve D) := by
  exact
    CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow
      F

end NegativeControls

private abbrev EmptyCategory := Discrete PEmpty
private abbrev PointCategory := Discrete PUnit

private def emptyToPoint : EmptyCategory ⥤ PointCategory :=
  Functor.empty PointCategory

/- The empty source cannot synthesize the required nonempty comma
contraction. -/
#guard_msgs (error, substring := true) in
example : SSet.realizationWeakEquivalences
    (nerveMap emptyToPoint :
      (nerve EmptyCategory : SSet.{0}) ⟶ nerve PointCategory) := by
  apply
    CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow
  intro d
  exact
    NerveContractible.nerve_to_terminal_mem_realizationWeakEquivalences_of_hasInitial

/-- A larger source object universe cannot be silently reported in the
smaller `SSet.{0}` universe. -/
private def unequalUniverseFunctor :
    Discrete (ULift.{1} PUnit) ⥤ Discrete PUnit :=
  Discrete.functor (fun _ => Discrete.mk PUnit.unit)

#guard_msgs (error, substring := true) in
example : SSet.realizationWeakEquivalences
    (nerveMap unequalUniverseFunctor :
      (nerve (Discrete (ULift.{1} PUnit)) : SSet.{0}) ⟶
        nerve (Discrete PUnit)) := by
  apply
    CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow
  intro d
  exact
    NerveContractible.nerve_to_terminal_mem_realizationWeakEquivalences_of_hasInitial

/-! ## API and nonclaim guards -/

