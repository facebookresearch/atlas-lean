/- No converse or Theorem-B endpoint is introduced. -/
#guard_msgs (error, substring := true) in
#check CategoryTheory.structuredArrow_of_nerveMap_mem_realizationWeakEquivalences

#guard_msgs (error, substring := true) in
#check CategoryTheory.nerveMap_mem_realizationWeakEquivalences_theoremB

#print axioms SSet.simplexResolutionMap_prod_mem_realizationWeakEquivalences
#print axioms SSet.theoremAStar
#print axioms
  CategoryTheory.nerveMap_mem_realizationWeakEquivalences_of_structuredArrow

end MathlibExtTest.CategoryTheory.CategoryBar.QuillenTheoremATests
