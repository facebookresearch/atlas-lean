module

public import MathlibExt.GroupTheory.HyperbolicGroup
public import MathlibExtTest.Topology.MetricSpace.GromovHyperbolic
public import Mathlib.Algebra.Group.TypeTags.Finite

@[expose] public section

namespace MathlibExtTest.HyperbolicGroup

open Metric

/-- `δ`-hyperbolicity pulls back along distance-preserving maps. -/
theorem isDeltaHyperbolic_of_dist_eq {X Y : Type*} [PseudoMetricSpace X] [PseudoMetricSpace Y]
    (f : X → Y) (hf : ∀ a b, dist (f a) (f b) = dist a b) {δ : ℝ}
    (h : IsDeltaHyperbolic Y δ) : IsDeltaHyperbolic X δ :=
  ⟨h.nonneg, fun w x y z => by
    simpa only [gromovProduct_eq, hf] using h.four_point (f w) (f x) (f y) (f z)⟩

/-- The integers, written multiplicatively, generated by `1`. -/
def intGenerators : Group.Generators (Multiplicative ℤ) (Fin 1) :=
  ⟨fun _ => Multiplicative.ofAdd 1, by
    rw [Subgroup.eq_top_iff']
    intro g
    obtain ⟨n, hn⟩ : ∃ n : ℤ, g = Multiplicative.ofAdd n :=
      ⟨Multiplicative.toAdd g, by simp⟩
    rw [hn]
    have hgen : Multiplicative.ofAdd n = (Multiplicative.ofAdd (1 : ℤ)) ^ n := by
      simpa using (ofAdd_zsmul n (1 : ℤ))
    rw [hgen]
    exact zpow_mem (Subgroup.subset_closure (by simp)) n⟩

@[simp]
theorem intGenerators_val (i : Fin 1) : intGenerators.val i = Multiplicative.ofAdd 1 :=
  rfl

/-- Each letter of a word changes the integer it evaluates to by `±1`. -/
theorem natAbs_toAdd_wordProd_le (l : List (Fin 1 × Bool)) :
    (Multiplicative.toAdd (intGenerators.wordProd l)).natAbs ≤ l.length := by
  induction l with
  | nil => simp
  | cons a l ih =>
    obtain ⟨i, b⟩ := a
    rw [Group.Generators.wordProd_cons, toAdd_mul, List.length_cons]
    cases b <;> simp only [Bool.cond_true, Bool.cond_false, intGenerators_val, toAdd_inv,
      toAdd_ofAdd] <;> omega

/-- A constant word of length `k` evaluates to `k` or `-k`. -/
theorem toAdd_wordProd_replicate (k : ℕ) (b : Bool) :
    Multiplicative.toAdd (intGenerators.wordProd (List.replicate k (0, b))) =
      cond b (k : ℤ) (-k) := by
  induction k with
  | zero => cases b <;> simp
  | succ k ih =>
    rw [List.replicate_succ, Group.Generators.wordProd_cons, toAdd_mul, ih]
    cases b <;> simp only [Bool.cond_true, Bool.cond_false, intGenerators_val, toAdd_inv,
      toAdd_ofAdd] <;> omega

/-- The word length of `n` with respect to the generator `1` is `|n|`. -/
theorem wordLength_ofAdd (n : ℤ) :
    intGenerators.wordLength (Multiplicative.ofAdd n) = n.natAbs := by
  apply le_antisymm
  · rw [Group.Generators.wordLength_le_iff]
    refine ⟨List.replicate n.natAbs (0, decide (0 ≤ n)), by simp, ?_⟩
    apply Multiplicative.toAdd.injective
    rw [toAdd_wordProd_replicate, toAdd_ofAdd]
    rcases le_or_gt 0 n with hn | hn
    · rw [decide_eq_true hn, Bool.cond_true]
      omega
    · rw [decide_eq_false hn.not_ge, Bool.cond_false]
      omega
  · obtain ⟨l, hl, hprod⟩ := intGenerators.exists_isGeodesic (Multiplicative.ofAdd n)
    have hle := natAbs_toAdd_wordProd_le l
    rw [hprod, toAdd_ofAdd] at hle
    rw [← hprod, hl.eq]
    exact hle

/-- The integers are word-hyperbolic: the word metric of the generator `1` is the metric of the
line, which is `0`-hyperbolic. -/
theorem isHyperbolic_multiplicative_int : Group.IsHyperbolic (Multiplicative ℤ) := by
  let := intGenerators.normedGroup
  refine ⟨Fin 1, inferInstance, intGenerators, 0, ?_⟩
  refine isDeltaHyperbolic_of_dist_eq
    (fun g : Multiplicative ℤ => ((Multiplicative.toAdd g : ℤ) : ℝ)) (fun a b => ?_)
    MathlibExtTest.GromovHyperbolic.real_isDeltaHyperbolic_zero
  rw [Real.dist_eq, NormedGroup.dist_eq]
  -- The word-metric norm `Group.Generators.groupNorm` is the word length by definition.
  change _ = ((intGenerators.wordLength (a⁻¹ * b) : ℕ) : ℝ)
  rw [show a⁻¹ * b = Multiplicative.ofAdd (Multiplicative.toAdd b - Multiplicative.toAdd a) by
    simp [sub_eq_neg_add], wordLength_ofAdd, abs_sub_comm, ← Int.cast_natCast,
    Int.natCast_natAbs, Int.cast_abs, Int.cast_sub]

/-- Regression test for the Gromov-product basepoint order: an infinite group is word-hyperbolic.
With the basepoint misread as the third argument, `Group.IsHyperbolic` holds only for finite
groups. -/
example : ¬ ∀ (G : Type) [Group G], Group.IsHyperbolic G → Finite G := fun h =>
  (h _ isHyperbolic_multiplicative_int).false

end MathlibExtTest.HyperbolicGroup
