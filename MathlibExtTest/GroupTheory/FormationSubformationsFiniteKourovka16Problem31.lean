module

import Mathlib.Algebra.Group.PUnit
import MathlibExt.GroupTheory.FormationSubformationsFiniteKourovka16Problem31

/-!
# Tests for formations generated by finite groups

The refutation gives a finite group with infinitely many distinct subformations.
The trivial group generates precisely the class of trivial groups.
-/

open MathlibExt.GroupTheory.FormationSubformationsFiniteKourovka16Problem31Wanted

example : ∃ (G : Type) (_ : Group G) (_ : Finite G),
    {F : FiniteGroupClass | IsFormation F ∧
      ∀ (H : Type) [Group H] [Finite H], F H → formationGeneratedBy G H}.Infinite := by
  by_contra! h
  exact finitelyManySubformations_refuted h

example (H : Type) [Group H] [Finite H] : formationGeneratedBy Unit H ↔ Subsingleton H := by
  let trivial : FiniteGroupClass := fun G _ _ ↦ Subsingleton G
  have ht : IsFormation trivial := by
    constructor
    · intro G K _ _ _ _ f hf hG
      have : Subsingleton G := hG
      exact hf.subsingleton
    · intro G _ _ N M _ _ hN hM
      change Subsingleton (G ⧸ (N ⊓ M))
      rw [QuotientGroup.subgroup_eq_top_of_subsingleton N hN,
        QuotientGroup.subgroup_eq_top_of_subsingleton M hM, inf_idem]
      exact QuotientGroup.subsingleton_quotient_top
  constructor
  · exact fun h ↦ h trivial ht (inferInstanceAs (Subsingleton Unit))
  · intro h F hF hUnit
    exact hF.1 Unit H 1 (fun y ↦ ⟨(), h.elim _ y⟩) hUnit

-- Through the comparison lemma, the formation generated by a finite group is a formation in the
-- sense used for the lattice of formations (Kourovka Problem 13.51).
example (G : Type) [Group G] [Finite G] :
    MathlibExt.GroupTheory.FiniteModularLatticeFormationsKourovka13Problem51Wanted.IsFormation
      (formationGeneratedBy G) := by
  rw [← isFormation_iff_isFormation]
  constructor
  · intro H K _ _ _ _ f hf hH F hF hG
    exact hF.1 H K f hf (hH F hF hG)
  · intro H _ _ N M _ _ hN hM F hF hG
    exact hF.2 H N M (hN F hF hG) (hM F hF hG)
