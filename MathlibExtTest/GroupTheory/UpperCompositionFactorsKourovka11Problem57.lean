module

import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
import MathlibExt.GroupTheory.UpperCompositionFactorsKourovka11Problem57

/-! # Tests for `MathlibExt.GroupTheory.UpperCompositionFactorsKourovka11Problem57` -/

namespace MathlibExtTest.GroupTheory.UpperCompositionFactorsKourovka11Problem57

open Equiv Equiv.Perm MathlibExt.GroupTheory.UpperCompositionFactorsKourovka11Problem57Wanted

private abbrev A5 := alternatingGroup (Fin 5)

private def doubleSwap : A5 :=
  ⟨swap 0 1 * swap 2 3,
    mul_mem_alternatingGroup_of_isSwap
      (swap_isSwap_iff.mpr (by decide)) (swap_isSwap_iff.mpr (by decide))⟩

private def threeCycle : A5 :=
  ⟨swap 0 1 * swap 0 4,
    mul_mem_alternatingGroup_of_isSwap
      (swap_isSwap_iff.mpr (by decide)) (swap_isSwap_iff.mpr (by decide))⟩

private lemma a5_isSimpleGroup : IsSimpleGroup A5 := alternatingGroup.isSimpleGroup (by simp)

private lemma a5_noncomm : ∃ a b : A5, a * b ≠ b * a := by
  refine ⟨doubleSwap, threeCycle, fun h => ?_⟩
  have heq := congrArg (fun g : A5 => g.val (0 : Fin 5)) h
  exact (by decide : (4 : Fin 5) ≠ 0) heq

-- Test section: composition factors. The whole group is a subnormal subgroup of itself, so every
-- group is a composition factor of itself, and a finite group is an upper composition factor of
-- itself through the identity quotient.
private lemma isCompositionFactor_self (T : Type) [Group T] : IsCompositionFactor T T :=
  ⟨⊤, Subgroup.IsSubnormal.top, (Subgroup.topEquiv : (⊤ : Subgroup T) ≃* T).toMonoidHom,
    (Subgroup.topEquiv : (⊤ : Subgroup T) ≃* T).surjective⟩

example (T : Type) [Group T] [Finite T] : IsUpperCompositionFactor T T :=
  ⟨T, inferInstance, inferInstance, MonoidHom.id T, Function.surjective_id,
    isCompositionFactor_self T⟩

-- A homomorphic image of a subnormal subgroup of an abelian group is abelian, so `A₅` is not a
-- composition factor of the cyclic group of order `5`.
example : ¬ IsCompositionFactor A5 (Multiplicative (ZMod 5)) := by
  rintro ⟨H, -, f, hf⟩
  obtain ⟨a, b, hab⟩ := a5_noncomm
  obtain ⟨x, rfl⟩ := hf a
  obtain ⟨y, rfl⟩ := hf b
  exact hab (by rw [← map_mul, ← map_mul, mul_comm x y])

-- Test section: the theorem. For the one-member family `A₅` it gives a group generated by three
-- elements of which `A₅` is an upper composition factor.
example : ∃ (G : Type) (_ : Group G), (∃ s : Fin 3 → G, Subgroup.closure (Set.range s) = ⊤) ∧
    IsUpperCompositionFactor A5 G := by
  obtain ⟨G, _, hgen, h⟩ := nonabelianUpperCompositionFactorsAnySet3_holds Unit (fun _ => A5)
    fun _ => ⟨inferInstance, a5_isSimpleGroup, a5_noncomm⟩
  exact ⟨G, inferInstance, hgen,
    (h A5 a5_isSimpleGroup a5_noncomm).2 ⟨(), ⟨MulEquiv.refl A5⟩⟩⟩

-- For the empty family it gives a group generated by three elements with no non-abelian simple
-- upper composition factor, in particular not `A₅`.
example : ∃ (G : Type) (_ : Group G), (∃ s : Fin 3 → G, Subgroup.closure (Set.range s) = ⊤) ∧
    ¬ IsUpperCompositionFactor A5 G := by
  obtain ⟨G, _, hgen, h⟩ := nonabelianUpperCompositionFactorsAnySet3_holds Empty (fun _ => A5)
    fun i => i.elim
  refine ⟨G, inferInstance, hgen, fun hA => ?_⟩
  obtain ⟨i, -⟩ := (h A5 a5_isSimpleGroup a5_noncomm).1 hA
  exact i.elim

end MathlibExtTest.GroupTheory.UpperCompositionFactorsKourovka11Problem57
