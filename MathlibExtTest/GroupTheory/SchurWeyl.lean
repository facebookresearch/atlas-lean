module

import MathlibExt.GroupTheory.SchurWeyl
import Mathlib.Algebra.Field.Rat
import Mathlib.Algebra.Field.ZMod
import Mathlib.Data.Fintype.Perm
import Mathlib.Tactic.NormNum

/-! # Tests for `MathlibExt.GroupTheory.SchurWeyl` -/

namespace MathlibExtTest.SchurWeyl

open scoped TensorProduct
open MathlibExt.GroupTheory.SchurWeylWanted.RepresentationTheory

-- Test section: the two actions on pure tensors.

-- `symAction σ` moves the factor in position `i` to position `σ i`.
example {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] {k : ℕ}
    (σ : Equiv.Perm (Fin k)) (v : Fin k → M) :
    symAction R M k σ (PiTensorProduct.tprod R v) =
      PiTensorProduct.tprod R (fun i => v (σ.symm i)) :=
  PiTensorProduct.reindex_tprod σ v

-- `glAction g` applies `g` to every factor.
example {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] {k : ℕ}
    (g : (M →ₗ[R] M)ˣ) (v : Fin k → M) :
    glAction R M k g (PiTensorProduct.tprod R v) =
      PiTensorProduct.tprod R (fun i => (g : M →ₗ[R] M) (v i)) :=
  PiTensorProduct.map_tprod _ v

-- Test section: applications of `glAction_range_eq_centralizer_symAction`.

-- Every element of the algebra generated by `GL(M)` commutes with the permutations.
example {R M : Type*} [Field R] [AddCommGroup M] [Module R M] [FiniteDimensional R M] {k : ℕ}
    [Invertible (k.factorial : R)] {x : Module.End R (⨂[R]^k M)}
    (hx : x ∈ Algebra.adjoin R (Set.range (glAction R M k))) (σ : Equiv.Perm (Fin k)) :
    symAction R M k σ * x = x * symAction R M k σ := by
  rw [glAction_range_eq_centralizer_symAction, Subalgebra.mem_centralizer_iff] at hx
  exact hx _ ⟨σ, rfl⟩

-- The symmetriser `∑ σ, σ` commutes with every permutation, so it lies in the algebra generated
-- by the tensor powers `g^{⊗k}` of invertible maps.
example {R M : Type*} [Field R] [AddCommGroup M] [Module R M] [FiniteDimensional R M] {k : ℕ}
    [Invertible (k.factorial : R)] :
    ∑ σ : Equiv.Perm (Fin k), symAction R M k σ ∈
      Algebra.adjoin R (Set.range (glAction R M k)) := by
  rw [glAction_range_eq_centralizer_symAction, Subalgebra.mem_centralizer_iff]
  rintro _ ⟨τ, rfl⟩
  rw [Finset.mul_sum, Finset.sum_mul]
  simp only [← map_mul]
  exact (Fintype.sum_equiv (Equiv.mulLeft τ) _ _ fun _ => rfl).trans
    (Fintype.sum_equiv (Equiv.mulRight τ) _ _ fun _ => rfl).symm

-- Over `ℚ`, the swap of the two factors of `ℚ² ⊗ ℚ²` lies in the algebra generated by the maps
-- `g ⊗ g` with `g` invertible.
example : symAction ℚ (Fin 2 → ℚ) 2 (Equiv.swap 0 1) ∈
    Algebra.adjoin ℚ (Set.range (glAction ℚ (Fin 2 → ℚ) 2)) := by
  have : Invertible ((Nat.factorial 2 : ℕ) : ℚ) := invertibleOfNonzero (by norm_num)
  rw [glAction_range_eq_centralizer_symAction, Subalgebra.mem_centralizer_iff]
  rintro _ ⟨τ, rfl⟩
  rw [← map_mul, ← map_mul]
  congr 1
  revert τ
  decide

-- The theorem also covers finite fields: over `ZMod 3` with `k = 2`, the field has exactly
-- `k + 1` elements, the smallest size that `k!` invertible allows.
example : symAction (ZMod 3) (Fin 2 → ZMod 3) 2 (Equiv.swap 0 1) ∈
    Algebra.adjoin (ZMod 3) (Set.range (glAction (ZMod 3) (Fin 2 → ZMod 3) 2)) := by
  have : Invertible ((Nat.factorial 2 : ℕ) : ZMod 3) :=
    invertibleOfNonzero (by decide)
  rw [glAction_range_eq_centralizer_symAction, Subalgebra.mem_centralizer_iff]
  rintro _ ⟨τ, rfl⟩
  rw [← map_mul, ← map_mul]
  congr 1
  revert τ
  decide

-- For `k = 0` the tensor power is `R` itself and the algebra generated by `GL(M)` is everything.
example {R M : Type*} [Field R] [AddCommGroup M] [Module R M] [FiniteDimensional R M] :
    Algebra.adjoin R (Set.range (glAction R M 0)) = ⊤ := by
  have : Invertible ((Nat.factorial 0 : ℕ) : R) := invertibleOfNonzero (by simp)
  rw [glAction_range_eq_centralizer_symAction, eq_top_iff]
  intro x _
  rw [Subalgebra.mem_centralizer_iff]
  rintro _ ⟨σ, rfl⟩
  rw [Subsingleton.elim σ 1, map_one, one_mul, mul_one]

-- Commuting with all diagonal maps is sufficient for membership in the permutation algebra.
example {R M : Type*} [Field R] [AddCommGroup M] [Module R M] [FiniteDimensional R M] {k : ℕ}
    [Invertible (k.factorial : R)] (T : Module.End R (⨂[R]^k M))
    (hT : ∀ g, glAction R M k g * T = T * glAction R M k g) :
    T ∈ Algebra.adjoin R (Set.range (symAction R M k)) := by
  rw [symAction_range_eq_centralizer_glAction, Subalgebra.mem_centralizer_iff]
  rintro _ ⟨g, rfl⟩
  exact hT g

-- In characteristic three the permutation algebra on the tensor square contains the swap,
-- which commutes with every diagonal action.
example (g : ((Fin 2 → ZMod 3) →ₗ[ZMod 3] (Fin 2 → ZMod 3))ˣ) :
    Commute (glAction (ZMod 3) (Fin 2 → ZMod 3) 2 g)
      (symAction (ZMod 3) (Fin 2 → ZMod 3) 2 (Equiv.swap 0 1)) := by
  have : Invertible ((Nat.factorial 2 : ℕ) : ZMod 3) := invertibleOfNonzero (by decide)
  have h : symAction (ZMod 3) (Fin 2 → ZMod 3) 2 (Equiv.swap 0 1) ∈
      Algebra.adjoin (ZMod 3) (Set.range (symAction (ZMod 3) (Fin 2 → ZMod 3) 2)) :=
    Algebra.subset_adjoin ⟨Equiv.swap 0 1, rfl⟩
  rw [symAction_range_eq_centralizer_glAction, Subalgebra.mem_centralizer_iff] at h
  exact h _ ⟨g, rfl⟩

end MathlibExtTest.SchurWeyl
