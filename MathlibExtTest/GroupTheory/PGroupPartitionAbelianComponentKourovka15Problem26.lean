module

import MathlibExt.GroupTheory.PGroupPartitionAbelianComponentKourovka15Problem26
import Mathlib.Data.ZMod.QuotientGroup
import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-! # Partitions of finite `p`-groups and their abelian components -/

open MathlibExt.GroupTheory.PGroupPartitionAbelianComponentKourovka15Problem26Wanted Subgroup

-- A trivial group has no partition: its only subgroup is not proper.
example {G : Type*} [Group G] [Subsingleton G] (C : Set (Subgroup G)) : ¬ IsGroupPartition C := by
  rintro ⟨hproper, hcover, -⟩
  obtain ⟨H, hH, -⟩ := hcover 1
  exact hproper H hH (eq_top_iff.mpr fun g _ => Subsingleton.elim (1 : G) g ▸ H.one_mem)

-- A subgroup of prime order meets every subgroup trivially or lies in it.
private theorem inf_eq_bot_or_le {p : ℕ} [hp : Fact p.Prime] {G : Type*} [Group G] [Finite G]
    (L M : Subgroup G) (hL : Nat.card L = p) : L ⊓ M = ⊥ ∨ L ≤ M := by
  have hdvd : Nat.card (L ⊓ M : Subgroup G) ∣ p := hL ▸ card_dvd_of_le inf_le_left
  rcases (Nat.dvd_prime hp.out).mp hdvd with h | h
  · exact Or.inl (card_eq_one.mp h)
  · exact Or.inr ((eq_of_le_of_card_ge inf_le_left (by rw [h, hL])).ge.trans inf_le_right)

-- The classical construction: a proper subgroup `K` outside of which every element has order `p`,
-- together with the cyclic subgroups generated by the elements outside `K`.
private theorem isGroupPartition_insert_zpowers {p : ℕ} [hp : Fact p.Prime] {G : Type*}
    [Group G] [Finite G] {K : Subgroup G} (hK : K ≠ ⊤) (hcard : p < Nat.card G)
    (hord : ∀ g ∉ K, g ^ p = 1) :
    IsGroupPartition (insert K ((fun g => zpowers g) '' (K : Set G)ᶜ)) := by
  have hcardz (g : G) (hg : g ∉ K) : Nat.card (zpowers g) = p := by
    rw [Nat.card_zpowers, orderOf_eq_prime (hord g hg) fun h => hg (h ▸ K.one_mem)]
  have hzK (g : G) (hg : g ∉ K) : zpowers g ⊓ K = ⊥ :=
    (inf_eq_bot_or_le _ K (hcardz g hg)).resolve_right fun h => hg (h (mem_zpowers g))
  refine ⟨?_, fun g => ?_, ?_⟩
  · rintro H (rfl | ⟨g, hg, rfl⟩)
    · exact hK
    · intro htop
      have := hcardz g hg
      rw [show zpowers g = ⊤ from htop, card_top] at this
      omega
  · by_cases hg : g ∈ K
    · exact ⟨K, Set.mem_insert _ _, hg⟩
    · exact ⟨zpowers g, Set.mem_insert_of_mem _ ⟨g, hg, rfl⟩, mem_zpowers g⟩
  · rintro H (rfl | ⟨g, hg, rfl⟩) H' (rfl | ⟨g', hg', rfl⟩) hne
    · exact absurd rfl hne
    · rw [inf_comm]
      exact hzK g' hg'
    · exact hzK g hg
    · refine (inf_eq_bot_or_le _ _ (hcardz g hg)).resolve_right fun hle => hne ?_
      exact eq_of_le_of_card_ge hle (by rw [hcardz g hg, hcardz g' hg'])

/-- The rotation subgroup of the dihedral group of order `8`. -/
private abbrev rotations : Subgroup (DihedralGroup 4) := zpowers (DihedralGroup.r 1)

/-- The rotations together with the four reflection subgroups of order `2`. -/
private abbrev dihedralPartition : Set (Subgroup (DihedralGroup 4)) :=
  insert rotations ((fun g => zpowers g) '' (rotations : Set (DihedralGroup 4))ᶜ)

-- The dihedral group of order `8` is a non-abelian `2`-group.
example : (DihedralGroup.r 1 * DihedralGroup.sr 0 : DihedralGroup 4) ≠
    DihedralGroup.sr 0 * DihedralGroup.r 1 := by
  decide

private theorem isPGroup_dihedral : IsPGroup 2 (DihedralGroup 4) :=
  IsPGroup.of_card (n := 3) (by rw [DihedralGroup.nat_card]; norm_num)

private theorem isGroupPartition_dihedralPartition : IsGroupPartition dihedralPartition := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine isGroupPartition_insert_zpowers (p := 2) ?_ (by rw [DihedralGroup.nat_card]; norm_num) ?_
  · intro h
    have := Nat.card_zpowers (DihedralGroup.r 1 : DihedralGroup 4)
    rw [show zpowers (DihedralGroup.r 1 : DihedralGroup 4) = ⊤ from h, card_top,
      DihedralGroup.nat_card, DihedralGroup.orderOf_r_one] at this
    omega
  · intro g hg
    cases g with
    | r i =>
      refine absurd ?_ hg
      have := rotations.pow_mem (mem_zpowers (DihedralGroup.r 1)) i.val
      rwa [DihedralGroup.r_one_pow, ZMod.natCast_zmod_val] at this
    | sr i => rw [sq, DihedralGroup.sr_mul_self]

-- The theorem applies to this partition of a non-abelian `2`-group.
example : ∃ H ∈ dihedralPartition, ∀ x ∈ H, ∀ y ∈ H, x * y = y * x :=
  pGroupPartitionHasAbelianComponent_holds 2 Nat.prime_two (DihedralGroup 4) isPGroup_dihedral _
    isGroupPartition_dihedralPartition

-- A partition of a finite `p`-group never consists of non-abelian components only.
example {p : ℕ} (hp : p.Prime) (G : Type) [Group G] [Finite G] (hG : IsPGroup p G)
    (C : Set (Subgroup G)) (hC : IsGroupPartition C) :
    ¬ ∀ H ∈ C, ∃ x ∈ H, ∃ y ∈ H, x * y ≠ y * x := by
  intro h
  obtain ⟨H, hH, hcomm⟩ := pGroupPartitionHasAbelianComponent_holds p hp G hG C hC
  obtain ⟨x, hx, y, hy, hxy⟩ := h H hH
  exact hxy (hcomm x hx y hy)
