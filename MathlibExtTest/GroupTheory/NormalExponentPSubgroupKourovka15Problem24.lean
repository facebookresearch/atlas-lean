module

import Mathlib.GroupTheory.SpecificGroups.Dihedral
import MathlibExt.GroupTheory.NormalExponentPSubgroupKourovka15Problem24

namespace MathlibExt.GroupTheory.NormalExponentPSubgroupKourovka15Problem24Wanted.Tests

private abbrev DihedralEight := DihedralGroup 4

private theorem isPGroup_dihedralEight : IsPGroup 2 DihedralEight :=
  IsPGroup.of_card (n := 3) (by
    rw [DihedralGroup.nat_card]
    decide)

-- The input subgroup is generated by a reflection, and `n = p - 1`.
example :
    ∃ N : Subgroup DihedralEight, N.Normal ∧ Nat.card N = 2 ∧ ∀ x ∈ N, x ^ 2 = 1 := by
  let g : DihedralEight := DihedralGroup.sr 0
  have hg : orderOf g = 2 := DihedralGroup.orderOf_sr 0
  simpa only [pow_one] using
    normalExponentPSubgroupOfLargePrime_holds 2 1 (by decide) (by decide) DihedralEight
      isPGroup_dihedralEight
      ⟨Subgroup.zpowers g, by rw [Nat.card_zpowers, hg, pow_one],
        fun x hx => orderOf_dvd_iff_pow_eq_one.mp (hg ▸ orderOf_dvd_of_mem_zpowers hx)⟩

-- The statement includes n = 0, where the required subgroup is trivial.
example :
    ∃ N : Subgroup DihedralEight, N.Normal ∧ Nat.card N = 1 ∧ ∀ x ∈ N, x ^ 2 = 1 := by
  simpa only [pow_zero] using
    normalExponentPSubgroupOfLargePrime_holds 2 0 (by decide) (by decide) DihedralEight
      isPGroup_dihedralEight ⟨⊥, by simp⟩

end MathlibExt.GroupTheory.NormalExponentPSubgroupKourovka15Problem24Wanted.Tests
