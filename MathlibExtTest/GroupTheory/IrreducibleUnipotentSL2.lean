module

import MathlibExt.GroupTheory.IrreducibleUnipotentSL2

open Matrix MatrixGroups Subgroup

namespace IrreducibleUnipotentSL2Test

/-- Consumer with the original binders: for a prime `p`, an irreducible subgroup of
`GL(2, ZMod p)` containing a nontrivial square-zero unipotent contains
the image of `SL(2, ZMod p)`. -/
theorem exactSource {p : ℕ} [Fact p.Prime]
    (H : Subgroup (GL (Fin 2) (ZMod p)))
    (hirr : ∀ v : Fin 2 → ZMod p, v ≠ 0 → ∃ g ∈ H, ∀ c : ZMod p,
      ((g : GL (Fin 2) (ZMod p)) : Matrix (Fin 2) (Fin 2) (ZMod p)).mulVec v ≠ c • v)
    (hunip : ∃ u ∈ H, ((u : Matrix (Fin 2) (Fin 2) (ZMod p)) - 1) ^ 2 = 0 ∧ u ≠ 1) :
    (Matrix.SpecialLinearGroup.toGL (n := Fin 2) (R := ZMod p)).range ≤ H :=
  SL2.range_toGL_le_of_irreducible_of_exists_unipotent H hirr hunip

/-- The trivial subgroup contains no nontrivial unipotent, so the unipotent hypothesis does not
hold for every subgroup. -/
theorem bot_has_no_nontrivial_unipotent {p : ℕ} [Fact p.Prime] :
    ¬ ∃ u ∈ (⊥ : Subgroup (GL (Fin 2) (ZMod p))),
      ((u : Matrix (Fin 2) (Fin 2) (ZMod p)) - 1) ^ 2 = 0 ∧ u ≠ 1 := by
  rintro ⟨u, hu, -, hu1⟩
  exact hu1 (Subgroup.mem_bot.mp hu)

/-- In characteristic five, Mathlib's transvection with entry `1` is a nontrivial
square-zero unipotent of `GL(2, ZMod 5)`, so the unipotent hypothesis can hold. -/
theorem top_has_nontrivial_unipotent_example :
    ∃ u ∈ (⊤ : Subgroup (GL (Fin 2) (ZMod 5))),
      ((u : Matrix (Fin 2) (Fin 2) (ZMod 5)) - 1) ^ 2 = 0 ∧ u ≠ 1 := by
  refine ⟨Matrix.SpecialLinearGroup.toGL
    (SpecialLinearGroup.transvection zero_ne_one (1 : ZMod 5)), Subgroup.mem_top _, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> decide
  · intro h
    have h01 := congrArg (fun M : GL (Fin 2) (ZMod 5) =>
      (M : Matrix (Fin 2) (Fin 2) (ZMod 5)) 0 1) h
    simp [SpecialLinearGroup.transvection_coe] at h01
    exact (by decide : (1 : ZMod 5) ≠ 0) h01

/-- The transvection with entry `1` above the diagonal, in `GL(2, ZMod 2)`. -/
abbrev upperTwo : GL (Fin 2) (ZMod 2) :=
  Matrix.SpecialLinearGroup.toGL (SpecialLinearGroup.transvection zero_ne_one 1)

/-- The transvection with entry `1` below the diagonal, in `GL(2, ZMod 2)`. -/
abbrev lowerTwo : GL (Fin 2) (ZMod 2) :=
  Matrix.SpecialLinearGroup.toGL (SpecialLinearGroup.transvection one_ne_zero 1)

/-- `upperTwo` is a nontrivial square-zero unipotent. -/
theorem upperTwo_unipotent :
    ((upperTwo : Matrix (Fin 2) (Fin 2) (ZMod 2)) - 1) ^ 2 = 0 ∧ upperTwo ≠ 1 := by
  decide

/-- The product `upperTwo * lowerTwo` moves every nonzero vector of `(ZMod 2)²` off its line,
so no line is invariant under a subgroup that contains it. -/
theorem upperTwo_mul_lowerTwo_moves_lines : ∀ v : Fin 2 → ZMod 2, v ≠ 0 → ∀ c : ZMod 2,
    ((upperTwo * lowerTwo : GL (Fin 2) (ZMod 2)) : Matrix (Fin 2) (Fin 2) (ZMod 2)).mulVec v ≠
      c • v := by
  decide

/-- At `p = 2` both hypotheses hold for `H = ⊤`, and the theorem applies. -/
theorem range_toGL_le_top_two :
    (Matrix.SpecialLinearGroup.toGL (n := Fin 2) (R := ZMod 2)).range ≤ ⊤ :=
  SL2.range_toGL_le_of_irreducible_of_exists_unipotent ⊤
    (fun v hv => ⟨upperTwo * lowerTwo, Subgroup.mem_top _, upperTwo_mul_lowerTwo_moves_lines v hv⟩)
    ⟨upperTwo, Subgroup.mem_top _, upperTwo_unipotent⟩

/-- The same witnesses lie in the subgroup generated by the two transvections, so that subgroup
contains the image of `SL(2, ZMod 2)`. -/
theorem range_toGL_le_closure_two :
    (Matrix.SpecialLinearGroup.toGL (n := Fin 2) (R := ZMod 2)).range ≤
      Subgroup.closure {upperTwo, lowerTwo} :=
  SL2.range_toGL_le_of_irreducible_of_exists_unipotent _
    (fun v hv => ⟨upperTwo * lowerTwo,
      mul_mem (subset_closure (by simp)) (subset_closure (by simp)),
      upperTwo_mul_lowerTwo_moves_lines v hv⟩)
    ⟨upperTwo, subset_closure (by simp), upperTwo_unipotent⟩

/-- `upperTwo * lowerTwo` has order three. -/
theorem upperTwo_mul_lowerTwo_pow_three : (upperTwo * lowerTwo) ^ 3 = 1 := by
  decide

/-- The cyclic subgroup generated by `upperTwo * lowerTwo` consists of `1`, `upperTwo * lowerTwo`
and its square. -/
theorem eq_of_mem_zpowers_upperTwo_mul_lowerTwo {y : GL (Fin 2) (ZMod 2)}
    (hy : y ∈ Subgroup.zpowers (upperTwo * lowerTwo)) :
    y = 1 ∨ y = upperTwo * lowerTwo ∨ y = (upperTwo * lowerTwo) ^ 2 := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
  have horder : orderOf (upperTwo * lowerTwo) = 3 :=
    orderOf_eq_prime upperTwo_mul_lowerTwo_pow_three (by decide)
  rw [← zpow_mod_orderOf, horder, Nat.cast_ofNat]
  have hk : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by omega
  rcases hk with hk | hk | hk <;> rw [hk]
  · exact Or.inl (_root_.zpow_zero _)
  · exact Or.inr (Or.inl (_root_.zpow_one _))
  · exact Or.inr (Or.inr (zpow_ofNat _ 2))

/-- The unipotent hypothesis cannot be dropped: at `p = 2` the cyclic subgroup generated by
`upperTwo * lowerTwo` leaves no line invariant and contains no nontrivial square-zero unipotent,
and it does not contain the image of `SL(2, ZMod 2)`. -/
theorem zpowers_upperTwo_mul_lowerTwo_counterexample :
    (∀ v : Fin 2 → ZMod 2, v ≠ 0 → ∃ g ∈ Subgroup.zpowers (upperTwo * lowerTwo), ∀ c : ZMod 2,
        ((g : GL (Fin 2) (ZMod 2)) : Matrix (Fin 2) (Fin 2) (ZMod 2)).mulVec v ≠ c • v) ∧
      (¬ ∃ u ∈ Subgroup.zpowers (upperTwo * lowerTwo),
        ((u : Matrix (Fin 2) (Fin 2) (ZMod 2)) - 1) ^ 2 = 0 ∧ u ≠ 1) ∧
      ¬ (Matrix.SpecialLinearGroup.toGL (n := Fin 2) (R := ZMod 2)).range ≤
        Subgroup.zpowers (upperTwo * lowerTwo) := by
  refine ⟨fun v hv => ⟨upperTwo * lowerTwo, Subgroup.mem_zpowers _,
    upperTwo_mul_lowerTwo_moves_lines v hv⟩, ?_, ?_⟩
  · rintro ⟨u, hu, hu2, hu1⟩
    rcases eq_of_mem_zpowers_upperTwo_mul_lowerTwo hu with rfl | rfl | rfl
    · exact hu1 rfl
    · revert hu2
      decide
    · revert hu2
      decide
  · intro h
    have hmem : upperTwo ∈ (Matrix.SpecialLinearGroup.toGL (n := Fin 2) (R := ZMod 2)).range :=
      ⟨_, rfl⟩
    rcases eq_of_mem_zpowers_upperTwo_mul_lowerTwo (h hmem) with h1 | h1 | h1 <;>
      revert h1 <;> decide

end IrreducibleUnipotentSL2Test
