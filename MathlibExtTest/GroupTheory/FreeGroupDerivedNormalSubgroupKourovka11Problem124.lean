module

import MathlibExt.GroupTheory.FreeGroupDerivedNormalSubgroupKourovka11Problem124
import Mathlib.GroupTheory.FreeGroup.Center
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Subgroup

namespace MathlibExt.GroupTheory.FreeGroupDerivedNormalSubgroupKourovka11Problem124Wanted

-- The proposition is available through the new module with the original binders and conclusion.
example : ∀ (α : Type), ¬ IsCyclic (FreeGroup α) → ∀ R : Subgroup (FreeGroup α),
    ¬ IsCyclic R → (⁅R, R⁆).Normal → R.Normal :=
  derivedNormalImpliesNormal_holds

-- The kernel of the exponent of the first generator is proper and contains two
-- noncommuting generators.
example : ∃ R : Subgroup (FreeGroup (Fin 3)), R ≠ ⊤ ∧ R.Normal := by
  let exponent := FreeGroup.lift fun i : Fin 3 ↦ if i = 0 then Multiplicative.ofAdd (1 : ℤ) else 1
  let R := exponent.ker
  have hF : ¬ IsCyclic (FreeGroup (Fin 3)) := by
    rw [FreeGroup.isCyclic_iff_subsingleton]
    exact not_subsingleton (Fin 3)
  have hR : ¬ IsCyclic R := by
    intro hcyclic
    have h₁ : FreeGroup.of (1 : Fin 3) ∈ R := by simp [R, exponent]
    have h₂ : FreeGroup.of (2 : Fin 3) ∈ R := by simp [R, exponent]
    have hne : FreeGroup.of (1 : Fin 3) * FreeGroup.of 2 ≠ FreeGroup.of 2 * FreeGroup.of 1 := by
      decide
    exact hne (setLike_mul_comm h₁ h₂)
  refine ⟨R, ?_, derivedNormalImpliesNormal_holds (Fin 3) hF R hR inferInstance⟩
  intro htop
  have h₀ : FreeGroup.of (0 : Fin 3) ∈ R := by rw [htop]; trivial
  simp [R, exponent] at h₀

-- The cyclic subgroup generated by one basis element has normal derived subgroup,
-- and conjugation by the other generator takes it outside that subgroup.
example : ∃ R : Subgroup (FreeGroup (Fin 2)), IsCyclic R ∧ (⁅R, R⁆).Normal ∧ ¬ R.Normal := by
  let x := FreeGroup.of (0 : Fin 2)
  let y := FreeGroup.of (1 : Fin 2)
  let R := Subgroup.zpowers x
  have hD : ⁅R, R⁆ = ⊥ := Subgroup.commutator_self_eq_bot_iff.mpr inferInstance
  have hN : (⁅R, R⁆).Normal := hD.symm ▸ inferInstance
  refine ⟨R, inferInstance, hN, ?_⟩
  intro h
  have hc := h.conj_mem x (Subgroup.mem_zpowers x) y
  have hy : ((1 : Fin 2), true) ∈ (y * x * y⁻¹).toWord := by decide
  exact (by decide : (1 : Fin 2) ≠ 0) ((FreeGroup.mem_zpowers_of_iff.mp hc) _ hy)

end MathlibExt.GroupTheory.FreeGroupDerivedNormalSubgroupKourovka11Problem124Wanted
