module

import MathlibExt.GroupTheory.PthPowersSubgroupPowerfulKourovka21Problem137AllPrimes

open MathlibExt.GroupTheory.PthPowersSubgroupPowerfulKourovka21Problem137Wanted

-- At two, the power subgroup must be compared with the subgroup generated by fourth powers.
example :
    ¬ ∀ (G : Type) [Group G] [Finite G], IsPGroup 2 G → ∀ P : Subgroup G,
      (P : Set G) = {g | ∃ x : G, x ^ 2 = g} →
        ⁅P, P⁆ ≤ Subgroup.closure ((fun x : G => x ^ 4) '' (P : Set G)) := by
  intro h
  exact pthPowersSubgroupPowerful_refuted ⟨2, Nat.prime_two, by simpa using h⟩

-- At the smallest odd prime the comparison uses cubes.
example :
    ¬ ∀ (G : Type) [Group G] [Finite G], IsPGroup 3 G → ∀ P : Subgroup G,
      (P : Set G) = {g | ∃ x : G, x ^ 3 = g} →
        ⁅P, P⁆ ≤ Subgroup.closure ((fun x : G => x ^ 3) '' (P : Set G)) := by
  intro h
  exact pthPowersSubgroupPowerful_refuted ⟨3, Nat.prime_three, by simpa using h⟩
