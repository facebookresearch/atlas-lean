module

import MathlibExt.GroupTheory.PGroupEqualOrderGeneratorsKourovka11Problem6
import Mathlib.Algebra.Group.PUnit
import Mathlib.Data.ZMod.Defs

/-! # Finite `p`-groups without a generating set of elements of equal order -/

open MathlibExt.GroupTheory.PGroupEqualOrderGeneratorsKourovka11Problem6Wanted

example : ¬ pGroupEqualOrderGenerators := pGroupEqualOrderGenerators_refuted

-- Unfolded: for some odd prime `p` there is a finite `p`-group in which every generating set
-- contains, for each `m`, an element whose order is not `m`.
example : ∃ p : ℕ, p.Prime ∧ Odd p ∧ ∃ (G : Type) (_ : Group G) (_ : Finite G), IsPGroup p G ∧
    ∀ S : Set G, Subgroup.closure S = ⊤ → ∀ m : ℕ, ∃ x ∈ S, orderOf x ≠ m := by
  by_contra! h
  refine pGroupEqualOrderGenerators_refuted fun p hp hodd G _ _ hG => ?_
  obtain ⟨S, hS, m, hm⟩ := h p hp hodd G inferInstance inferInstance hG
  exact ⟨S, hS, m, hm⟩

-- Equivalently, in that group the elements of any one order generate a proper subgroup.
example : ∃ p : ℕ, p.Prime ∧ Odd p ∧ ∃ (G : Type) (_ : Group G) (_ : Finite G), IsPGroup p G ∧
    ∀ m : ℕ, Subgroup.closure {x : G | orderOf x = m} ≠ ⊤ := by
  by_contra! h
  refine pGroupEqualOrderGenerators_refuted fun p hp hodd G _ _ hG => ?_
  obtain ⟨m, hm⟩ := h p hp hodd G inferInstance inferInstance hG
  exact ⟨{x : G | orderOf x = m}, hm, m, fun _ hx => hx⟩

-- The conclusion of the statement is satisfiable: a cyclic `3`-group is generated by one element.
example : ∃ S : Set (Multiplicative (ZMod 9)), Subgroup.closure S = ⊤ ∧
    ∃ m : ℕ, ∀ x ∈ S, orderOf x = m := by
  refine ⟨{Multiplicative.ofAdd 1}, ?_, orderOf (Multiplicative.ofAdd (1 : ZMod 9)), by simp⟩
  rw [Subgroup.eq_top_iff']
  intro x
  have hx : x = Multiplicative.ofAdd 1 ^ (Multiplicative.toAdd x).val := by
    apply Multiplicative.toAdd.injective
    simp
  rw [hx]
  exact Subgroup.pow_mem _ (Subgroup.subset_closure rfl) _

-- In the trivial group the empty set generates, with any common order.
example : ∃ S : Set Unit, Subgroup.closure S = ⊤ ∧ ∃ m : ℕ, ∀ x ∈ S, orderOf x = m :=
  ⟨∅, Subsingleton.elim _ _, 0, by simp⟩
