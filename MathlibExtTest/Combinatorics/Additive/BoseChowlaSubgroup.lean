module

import MathlibExt.Combinatorics.Additive.BoseChowlaSubgroup
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.Tactic.LinearCombination

/-! # Tests for `MathlibExt.Combinatorics.Additive.BoseChowlaSubgroup` -/

namespace MathlibExtTest.BoseChowlaSubgroup

open MetaMathlibExt

/-- Every finite field `K` has a primitive `(|K| - 1)`-th root of unity, a generator of `Kˣ`. -/
private theorem exists_isPrimitiveRoot (K : Type*) [Field K] [Finite K] :
    ∃ θ : K, IsPrimitiveRoot θ (Nat.card K - 1) := by
  obtain ⟨u, hu⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := Kˣ)
  exact ⟨u, by rw [IsPrimitiveRoot.iff_orderOf, orderOf_units, hu, Nat.card_units]⟩

-- Test section: the hypotheses are satisfiable. `GF(9)` has a generator `θ` of its multiplicative
-- group, and `1` lies in the Bose–Chowla set since `θ ^ 1 - θ = 0`.
example : ∃ θ : GaloisField 3 2, IsPrimitiveRoot θ (3 ^ 2 - 1) ∧ (θ ^ 1 - θ) ^ 3 = θ ^ 1 - θ := by
  obtain ⟨θ, hθ⟩ := exists_isPrimitiveRoot (GaloisField 3 2)
  rw [GaloisField.card 3 2 (by norm_num)] at hθ
  exact ⟨θ, hθ, by simp⟩

-- Test section: reduction modulo `(q ^ 2 - 1) / g` is injective on the Bose–Chowla set. This is
-- how the result is used: `B_q` maps injectively to the quotient of `ℤ/(q ^ 2 - 1)` by `H`.
example {K : Type*} [Field K] [Finite K] (q g : ℕ) (hK : Nat.card K = q ^ 2) (hgq : g ∣ q - 1)
    (θ : K) (hθ : IsPrimitiveRoot θ (q ^ 2 - 1)) (a b : ℕ) (ha : a < q ^ 2 - 1)
    (hb : b < q ^ 2 - 1) (hBa : (θ ^ a - θ) ^ q = θ ^ a - θ) (hBb : (θ ^ b - θ) ^ q = θ ^ b - θ)
    (hmod : a ≡ b [MOD (q ^ 2 - 1) / g]) : a = b :=
  boseChowla_sub_mem_subgroup_eq q g hK hgq θ hθ a b ha hb hBa hBb (Nat.ModEq.dvd hmod.symm)

-- Test section: the largest admissible `g = q - 1`. Then `H` is generated by `q + 1`, so two
-- elements of the Bose–Chowla set that are congruent modulo `q + 1` are equal.
example {K : Type*} [Field K] [Finite K] (q : ℕ) (hK : Nat.card K = q ^ 2) (θ : K)
    (hθ : IsPrimitiveRoot θ (q ^ 2 - 1)) (a b : ℕ) (ha : a < q ^ 2 - 1) (hb : b < q ^ 2 - 1)
    (hBa : (θ ^ a - θ) ^ q = θ ^ a - θ) (hBb : (θ ^ b - θ) ^ q = θ ^ b - θ)
    (hab : ((q + 1 : ℕ) : ℤ) ∣ (a : ℤ) - b) : a = b := by
  have hq : 2 ≤ q := by
    have h : 1 < q ^ 2 := hK ▸ Finite.one_lt_card
    by_contra! hq
    interval_cases q <;> simp at h
  have hdiv : (q ^ 2 - 1) / (q - 1) = q + 1 := by
    rw [Nat.div_eq_iff_eq_mul_left (by omega) (by simpa using Nat.sub_dvd_pow_sub_pow q 1 2)]
    zify [(by omega : 1 ≤ q), Nat.one_le_pow 2 q (by omega)]
    ring
  exact boseChowla_sub_mem_subgroup_eq q (q - 1) hK dvd_rfl θ hθ a b ha hb hBa hBb (hdiv ▸ hab)

-- Test section: a concrete consequence in `GF(9)`, where `q = 3`, `g = 2` and `H = {0, 4}`. Since
-- `1` lies in the Bose–Chowla set `B_3`, `5 = 1 + 4` does not, whatever the generator `θ`.
-- (Directly: `θ ^ 4 = -1`, so `θ ^ 5 - θ = -2θ = θ`, which is not in `𝔽_3`.)
example (θ : GaloisField 3 2) (hθ : IsPrimitiveRoot θ (3 ^ 2 - 1)) :
    (θ ^ 5 - θ) ^ 3 ≠ θ ^ 5 - θ := by
  intro h5
  have := boseChowla_sub_mem_subgroup_eq 3 2 (GaloisField.card 3 2 (by norm_num)) (by norm_num)
    θ hθ 5 1 (by norm_num) (by norm_num) h5 (by simp) (by norm_num)
  omega

/-- In `GF(4)`, with `θ` a generator of the multiplicative group, `2` lies in the Bose–Chowla set
`B_2`: since `1 + θ + θ ^ 2 = 0` and the characteristic is `2`, `θ ^ 2 - θ = 1`. -/
private theorem two_mem_boseChowla_gf4 (θ : GaloisField 2 2) (hθ : IsPrimitiveRoot θ (2 ^ 2 - 1)) :
    (θ ^ 2 - θ) ^ 2 = θ ^ 2 - θ := by
  have h3 : 1 + θ + θ ^ 2 = 0 := by
    simpa [Finset.sum_range_succ] using hθ.geom_sum_eq_zero (by norm_num)
  have h1 : θ ^ 2 - θ = 1 := by
    rw [CharTwo.sub_eq_add]
    linear_combination h3 - CharTwo.two_eq_zero (R := GaloisField 2 2)
  rw [h1, one_pow]

-- Test section: the hypothesis `g ∣ q - 1` cannot be dropped. In `GF(4)` both `1` and `2` lie in
-- `B_2`, and for `g = 3`, which does not divide `2 - 1`, the subgroup generated by
-- `(2 ^ 2 - 1) / 3 = 1` is all of `ℤ/3`, so it contains `1 - 2`; yet `1 ≠ 2`.
example (θ : GaloisField 2 2) (hθ : IsPrimitiveRoot θ (2 ^ 2 - 1)) :
    ¬ 3 ∣ 2 - 1 ∧ (θ ^ 1 - θ) ^ 2 = θ ^ 1 - θ ∧ (θ ^ 2 - θ) ^ 2 = θ ^ 2 - θ ∧
      (((2 ^ 2 - 1) / 3 : ℕ) : ℤ) ∣ ((1 : ℕ) : ℤ) - (2 : ℕ) :=
  ⟨by norm_num, by simp, two_mem_boseChowla_gf4 θ hθ, by norm_num⟩

-- Test section: such a generator of `GF(4)ˣ` exists, so the previous example is not vacuous.
example : ∃ θ : GaloisField 2 2, IsPrimitiveRoot θ (2 ^ 2 - 1) := by
  simpa [GaloisField.card 2 2 (by norm_num)] using exists_isPrimitiveRoot (GaloisField 2 2)

end MathlibExtTest.BoseChowlaSubgroup
