module

import MathlibExt.Algebra.CyclicHolomorph
import Mathlib.RingTheory.Ideal.Quotient.Basic

open MetaMathlibExt

-- When the common unit is 1, the ideal is zero and multiplication by −1 suffices.
example : IsConj (⟨Multiplicative.ofAdd (1 : ZMod 5), 1⟩ : cyclicHolomorph 5)
    ⟨Multiplicative.ofAdd (-1 : ZMod 5), 1⟩ := by
  apply (cyclicHolomorph_isConj_iff 5 (by decide) 1 (-1) 1 1).mpr
  exact ⟨rfl, -1, by simp⟩

-- With unit −1 modulo four, the nonzero ideal generated by 1 − (−1) identifies 2 with 0.
example : IsConj (⟨Multiplicative.ofAdd (0 : ZMod 4), -1⟩ : cyclicHolomorph 4)
    ⟨Multiplicative.ofAdd (2 : ZMod 4), -1⟩ := by
  apply (cyclicHolomorph_isConj_iff 4 (by decide) 0 2 (-1) (-1)).mpr
  refine ⟨rfl, 1, Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton'.mpr ⟨1, ?_⟩)⟩
  decide
