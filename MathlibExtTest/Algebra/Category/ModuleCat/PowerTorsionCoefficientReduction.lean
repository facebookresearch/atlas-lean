module

import MathlibExt.Algebra.Category.ModuleCat.Torsion.QuotientHomColimit
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.Algebra.Module.NatInt

/-!
# Power-torsion coordinates under integer coefficient reduction

For the ideal generated by two in the integers, the class three in `ZMod 12` is killed by
the second ideal power but not the first. The class six is already killed by the first
power. Reduction to `ZMod 6` retains the class three and kills the class six.

The power-annihilator diagram, quotient-Hom diagram and their colimits give these same
coordinates along coefficient-map and index-transition paths. The degree-zero derived
comparison retains the nonzero power-torsion element. Neither coefficient module is flat.
-/

open CategoryTheory CategoryTheory.Limits ModuleCat.Torsion

noncomputable section
set_option autoImplicit false

namespace PowerTorsionCoefficientReduction

private abbrev I : Ideal ℤ := Ideal.span {(2 : ℤ)}
private abbrev A : ModuleCat.{0} ℤ := ModuleCat.of ℤ (ZMod 12)
private abbrev B : ModuleCat.{0} ℤ := ModuleCat.of ℤ (ZMod 6)

private def reductionRing : ZMod 12 →+* ZMod 6 := ZMod.castHom (by decide : 6 ∣ 12) _

private def reduction : A ⟶ B :=
  ModuleCat.ofHom reductionRing.toAddMonoidHom.toIntLinearMap

private lemma reduction_three : reduction.hom (3 : ZMod 12) = (3 : ZMod 6) := by
  change reductionRing (3 : ZMod 12) = (3 : ZMod 6)
  exact map_natCast reductionRing 3

private lemma reduction_six : reduction.hom (6 : ZMod 12) = (0 : ZMod 6) := by
  change reductionRing (6 : ZMod 12) = (0 : ZMod 6)
  exact (map_natCast reductionRing 6).trans (by decide)

private lemma power_mem_iff (M : ModuleCat.{0} ℤ) (n : ℕ) (x : M) :
    x ∈ powerAnnihilator I M n ↔ ((2 : ℤ) ^ n) • x = 0 := by
  change x ∈ Submodule.torsionBySet ℤ M ((I ^ n : Ideal ℤ) : Set ℤ) ↔ _
  rw [show I ^ n = Ideal.span {((2 : ℤ) ^ n)} from Ideal.span_singleton_pow _ _]
  rw [Submodule.torsionBySet_ideal_span_singleton_eq, Submodule.mem_torsionBy_iff]
  simp only [int_smul_eq_zsmul]

private def threeA : powerAnnihilator I A 2 :=
  ⟨3, (power_mem_iff A 2 3).mpr (by
    change ((2 : ℤ) ^ 2) • (3 : ZMod 12) = 0
    decide)⟩

private def sixA : powerAnnihilator I A 1 :=
  ⟨6, (power_mem_iff A 1 6).mpr (by
    change ((2 : ℤ) ^ 1) • (6 : ZMod 12) = 0
    decide)⟩

private def threeB : powerAnnihilator I B 2 :=
  ⟨3, (power_mem_iff B 2 3).mpr (by
    change ((2 : ℤ) ^ 2) • (3 : ZMod 6) = 0
    decide)⟩

example : (3 : ZMod 12) ∉ powerAnnihilator I A 1 := by
  rw [power_mem_iff]
  change ¬ ((2 : ℤ) ^ 1) • (3 : ZMod 12) = 0
  decide

example : (3 : ZMod 12) ∈ powerAnnihilator I A 2 := threeA.property

example : (6 : ZMod 12) ∈ powerAnnihilator I A 1 := sixA.property

example : (3 : ZMod 6) ∈ powerAnnihilator I B 2 := threeB.property

example : (3 : ZMod 12) ≠ 0 ∧ (6 : ZMod 12) ≠ 0 ∧ (3 : ZMod 6) ≠ 0 := by
  decide

private def gammaThreeA : (functor I).obj A := (annihilatorInclusion I A 2).hom threeA
private def gammaSixA : (functor I).obj A := (annihilatorInclusion I A 1).hom sixA
private def gammaThreeB : (functor I).obj B := (annihilatorInclusion I B 2).hom threeB

example : gammaThreeA.val = (3 : ZMod 12) := rfl

example : gammaThreeA ≠ 0 := by
  intro h
  have hv := congrArg Subtype.val h
  exact (by decide : (3 : ZMod 12) ≠ 0) hv

example : (((functor I).map reduction).hom gammaThreeA).val = (3 : ZMod 6) :=
  reduction_three

example : ((functor I).map reduction).hom gammaSixA = 0 := by
  apply Subtype.ext
  exact reduction_six

example : ((functor I).map reduction).hom gammaThreeA = gammaThreeB := by
  apply Subtype.ext
  exact reduction_three

example : (((annihilatorDiagramMap I reduction).app 2).hom threeA).val =
    (3 : ZMod 6) := reduction_three

example : (((annihilatorDiagramMap I reduction).app 1).hom sixA).val =
    (0 : ZMod 6) := reduction_six

example : (((annihilatorDiagram I A).map (homOfLE (by decide : 1 ≤ 2))).hom sixA).val =
    (6 : ZMod 12) := rfl

example :
    (annihilatorInclusion I A 2).hom
      (((annihilatorDiagram I A).map (homOfLE (by decide : 1 ≤ 2))).hom sixA) =
        gammaSixA := by
  apply Subtype.ext
  rfl

example :
    (((annihilatorIsColimit I A).desc
      ((Cocone.precompose (annihilatorDiagramMap I reduction)).obj
        (annihilatorCocone I B))).hom gammaThreeA).val = (3 : ZMod 6) := by
  rw [primaryComponentMap_eq_annihilatorDesc]
  exact reduction_three

private def phiThreeA : quotientPowerModule I 2 ⟶ A :=
  ModuleCat.ofHom ((Ideal.quotientHomEquiv (I ^ 2) (ZMod 12)).symm threeA)

private def phiSixA : quotientPowerModule I 1 ⟶ A :=
  ModuleCat.ofHom ((Ideal.quotientHomEquiv (I ^ 1) (ZMod 12)).symm sixA)

private def phiThreeB : quotientPowerModule I 2 ⟶ B :=
  ModuleCat.ofHom ((Ideal.quotientHomEquiv (I ^ 2) (ZMod 6)).symm threeB)

private lemma phiThreeA_one : phiThreeA.hom (Ideal.quotientOne (I ^ 2)) =
    (3 : ZMod 12) := by
  change (1 : ℤ) • (3 : ZMod 12) = 3
  exact one_smul _ _

private lemma phiSixA_one : phiSixA.hom (Ideal.quotientOne (I ^ 1)) =
    (6 : ZMod 12) := by
  change (1 : ℤ) • (6 : ZMod 12) = 6
  exact one_smul _ _

example : phiThreeA.hom (Submodule.Quotient.mk (3 : ℤ)) = (9 : ZMod 12) := by
  change (3 : ℤ) • (3 : ZMod 12) = 9
  decide

example : ((Ideal.quotientHomEquiv (I ^ 2) (ZMod 12)) phiThreeA.hom).val =
    (3 : ZMod 12) := phiThreeA_one

example : phiThreeA ≫ reduction = phiThreeB := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro q
  obtain ⟨r, rfl⟩ := Submodule.mkQ_surjective (I ^ 2 : Submodule ℤ ℤ) q
  change reduction.hom (r • (3 : ZMod 12)) = r • (3 : ZMod 6)
  rw [map_smul, reduction_three]

private def quotientClassThreeA : (colimit (quotientHomDiagram I A) : ModuleCat.{0} ℤ) :=
  (colimit.ι (quotientHomDiagram I A) 2).hom phiThreeA

private def quotientClassSixA : (colimit (quotientHomDiagram I A) : ModuleCat.{0} ℤ) :=
  (colimit.ι (quotientHomDiagram I A) 1).hom phiSixA

private def quotientDetectA : colimit (quotientHomDiagram I A) ⟶ (functor I).obj A :=
  (gammaIsoQuotientHomColimitObj I A).inv

private def quotientDetectB : colimit (quotientHomDiagram I B) ⟶ (functor I).obj B :=
  (gammaIsoQuotientHomColimitObj I B).inv

private lemma quotientDetect_three : (quotientDetectA.hom quotientClassThreeA).val =
    (3 : ZMod 12) := by
  have h := congrArg
    (fun f : (quotientHomDiagram I A).obj 2 ⟶ (functor I).obj A => f.hom phiThreeA)
    (colimit_iota_comp_gammaIso_inv I A 2)
  have hv := congrArg Subtype.val h
  simpa only [ModuleCat.hom_comp, LinearMap.comp_apply, quotientHomCocone_val,
    phiThreeA_one] using! hv

private lemma quotientDetect_six : (quotientDetectA.hom quotientClassSixA).val =
    (6 : ZMod 12) := by
  have h := congrArg
    (fun f : (quotientHomDiagram I A).obj 1 ⟶ (functor I).obj A => f.hom phiSixA)
    (colimit_iota_comp_gammaIso_inv I A 1)
  have hv := congrArg Subtype.val h
  simpa only [ModuleCat.hom_comp, LinearMap.comp_apply, quotientHomCocone_val,
    phiSixA_one] using! hv

example : quotientClassThreeA ≠ 0 := by
  intro h
  have hv := congrArg (fun x => (quotientDetectA.hom x).val) h
  rw [quotientDetect_three, map_zero] at hv
  exact (by decide : (3 : ZMod 12) ≠ 0) hv

example : quotientClassSixA ≠ 0 := by
  intro h
  have hv := congrArg (fun x => (quotientDetectA.hom x).val) h
  rw [quotientDetect_six, map_zero] at hv
  exact (by decide : (6 : ZMod 12) ≠ 0) hv

private def quotientReduction :
    colimit (quotientHomDiagram I A) ⟶ colimit (quotientHomDiagram I B) :=
  colim.map ((quotientHomDiagramFunctor I).map reduction)

example :
    (((functor I).map reduction).hom (quotientDetectA.hom quotientClassThreeA)).val =
      (3 : ZMod 6) := by
  change reduction.hom (quotientDetectA.hom quotientClassThreeA).val = _
  rw [quotientDetect_three]
  exact reduction_three

example :
    (((functor I).map reduction).hom (quotientDetectA.hom quotientClassSixA)).val =
      (0 : ZMod 6) := by
  change reduction.hom (quotientDetectA.hom quotientClassSixA).val = _
  rw [quotientDetect_six]
  exact reduction_six

example :
    (quotientDetectB.hom (quotientReduction.hom quotientClassThreeA)).val =
      (3 : ZMod 6) := by
  have h := congrArg
    (fun f : colimit (quotientHomDiagram I A) ⟶ (functor I).obj B =>
      (f.hom quotientClassThreeA).val)
    ((gammaIsoQuotientHomColimit I).inv.naturality reduction)
  have hv :
      (((functor I).map reduction).hom (quotientDetectA.hom quotientClassThreeA)).val =
        (3 : ZMod 6) := by
    change reduction.hom (quotientDetectA.hom quotientClassThreeA).val = _
    rw [quotientDetect_three]
    exact reduction_three
  exact h.trans hv

example :
    (quotientDetectB.hom (quotientReduction.hom quotientClassSixA)).val =
      (0 : ZMod 6) := by
  have h := congrArg
    (fun f : colimit (quotientHomDiagram I A) ⟶ (functor I).obj B =>
      (f.hom quotientClassSixA).val)
    ((gammaIsoQuotientHomColimit I).inv.naturality reduction)
  have hv :
      (((functor I).map reduction).hom (quotientDetectA.hom quotientClassSixA)).val =
        (0 : ZMod 6) := by
    change reduction.hom (quotientDetectA.hom quotientClassSixA).val = _
    rw [quotientDetect_six]
    exact reduction_six
  exact h.trans hv

private def localClassThreeA : (localCohomologyFunctor I 0).obj A :=
  ((localCohomologyZeroIso I).inv.app A).hom gammaThreeA

example : (((localCohomologyZeroIso I).hom.app A).hom localClassThreeA).val =
    (3 : ZMod 12) := by
  have h := congrArg (fun f : (functor I).obj A ⟶ (functor I).obj A =>
    (f.hom gammaThreeA).val) ((localCohomologyZeroIso I).app A).inv_hom_id
  simpa only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_id,
    LinearMap.id_apply] using! h

example : localClassThreeA ≠ 0 := by
  intro h
  have hv := congrArg
    (fun x => (((localCohomologyZeroIso I).hom.app A).hom x).val) h
  have he : (((localCohomologyZeroIso I).hom.app A).hom localClassThreeA).val =
      (3 : ZMod 12) := by
    have hi := congrArg (fun f : (functor I).obj A ⟶ (functor I).obj A =>
      (f.hom gammaThreeA).val) ((localCohomologyZeroIso I).app A).inv_hom_id
    simpa only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_id,
      LinearMap.id_apply] using! hi
  rw [he, map_zero] at hv
  exact (by decide : (3 : ZMod 12) ≠ 0) hv

example : ¬ Module.Flat ℤ (ZMod 12) := by
  intro h
  letI : Module.Flat ℤ (ZMod 12) := h
  letI : Module.IsTorsionFree ℤ (ZMod 12) := Module.Flat.isTorsionFree
  have hz : (12 : ℤ) • (1 : ZMod 12) = 0 := by decide
  have hc := (smul_eq_zero.mp hz).resolve_left (by decide : (12 : ℤ) ≠ 0)
  exact (by decide : (1 : ZMod 12) ≠ 0) hc

example : ¬ Module.Flat ℤ (ZMod 6) := by
  intro h
  letI : Module.Flat ℤ (ZMod 6) := h
  letI : Module.IsTorsionFree ℤ (ZMod 6) := Module.Flat.isTorsionFree
  have hz : (6 : ℤ) • (1 : ZMod 6) = 0 := by decide
  have hc := (smul_eq_zero.mp hz).resolve_left (by decide : (6 : ℤ) ≠ 0)
  exact (by decide : (1 : ZMod 6) ≠ 0) hc

end PowerTorsionCoefficientReduction
