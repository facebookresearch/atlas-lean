-- Author: @toskua
module

public import MathlibExt.Algebra.Category.ModuleCat.NativeTorExactCoefficientDevissageUniverse
public import MathlibExt.Algebra.Category.ModuleCat.NativeTorProjectiveDimensionUniverse
public import Mathlib.RingTheory.ZMod.LocalRing
public import Mathlib.RingTheory.TensorProduct.Finite
public import Mathlib.RingTheory.Finiteness.Cardinality
public import Mathlib.Algebra.Polynomial.Coeff
public import Mathlib.Algebra.Polynomial.Eval.Defs

/-! Actual nilpotent local coefficients extended to a product and restricted along a nonflat map. -/

@[expose] public section
noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped TensorProduct ModuleCat.UniverseTensor ChangeOfRings ZeroObject

namespace NativeTorRestrictedDevissageTests

local instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

/-- The original local coefficient ring with a nonzero square-zero element. -/
abbrev R4 := ZMod (2 ^ 2)

/-- The actual flat product extension of the original coefficient ring. -/
abbrev Q4 := R4 × R4

/-- The original Tor ring before the nonflat polynomial graph quotient. -/
abbrev S4 := Polynomial Q4

/-- The actual diagonal ring map used for scalar extension. -/
abbrev f4 : R4 →+* Q4 := algebraMap R4 Q4

/-- The actual graph quotient used for scalar restriction. -/
def g4 : S4 →+* Q4 := Polynomial.evalRingHom 0

/-- The actual extended then restricted coefficient functor. -/
abbrev F4 : ModuleCat R4 ⥤ ModuleCat S4 :=
  ModuleCat.extendScalars f4 ⋙ ModuleCat.restrictScalars g4

/-- The original regular S-module for the native boundary clients. -/
abbrev M4 : ModuleCat S4 := ModuleCat.of S4 S4

/-- The actual restricted product extension of the canonical residue coefficient. -/
abbrev residue4 : ModuleCat S4 :=
  F4.obj (ModuleCat.UniverseTensor.nativeResidueCoefficient.{0, 0} R4)

example : (2 : R4) ≠ 0 ∧ (2 : R4) ^ 2 = 0 := by decide

example : IsLocalRing R4 := inferInstance

theorem f4_flat : f4.Flat := by
  rw [RingHom.flat_algebraMap_iff]
  infer_instance

theorem g4_surjective : Function.Surjective g4 := by
  intro q
  exact ⟨Polynomial.C q, by simp [g4]⟩

theorem g4_not_flat : ¬ g4.Flat := by
  intro hflat
  let : Algebra S4 Q4 := g4.toAlgebra
  have : Module.Flat S4 Q4 := (RingHom.flat_algebraMap_iff).mp hflat
  have hreg : IsSMulRegular S4 (Polynomial.X : S4) := Polynomial.isRegular_X.1
  have hzero : IsSMulRegular Q4 (0 : Q4) := by
    have h := hreg.of_flat (S := Q4)
    rw [RingHom.algebraMap_toAlgebra] at h
    simpa [g4] using h
  exact zero_ne_one (hzero (by simp))

example (N N' : ModuleCat R4) (h : N ⟶ N') (q : Q4) (n : N) :
    F4.map h (q ⊗ₜ[R4, f4] n) = q ⊗ₜ[R4, f4] h n :=
  ModuleCat.ExtendScalars.map_tmul f4 h q n

example (N : ModuleCat R4) (s : S4) :
    (F4.obj N).smul s = ((ModuleCat.extendScalars f4).obj N).smul (g4 s) :=
  ModuleCat.smul_restrictScalars g4 s ((ModuleCat.extendScalars f4).obj N)

example (N : ModuleCat R4) (n : F4.obj N) : (Polynomial.X : S4) • n = 0 := by
  have h (x : (ModuleCat.extendScalars f4).obj N) : g4 Polynomial.X • x = 0 := by
    rw [show g4 Polynomial.X = 0 by simp [g4]]
    exact zero_smul Q4 x
  exact h n

/-- The actual submodule generated by the original nilpotent coefficient. -/
def twoSubmodule : Submodule R4 R4 := Submodule.span R4 ({2} : Set R4)

example : twoSubmodule ≠ ⊥ := by
  intro h
  have htwo : (2 : R4) ∈ twoSubmodule := Submodule.mem_span_singleton_self 2
  rw [h, Submodule.mem_bot] at htwo
  exact (by decide : (2 : R4) ≠ 0) htwo

example : twoSubmodule ≠ ⊤ := by
  intro h
  have hone : (1 : R4) ∈ twoSubmodule := by rw [h]; trivial
  have hex : ∃ r : R4, r • (2 : R4) = 1 := Submodule.mem_span_singleton.mp hone
  exact (by decide : ¬ ∃ r : R4, r • (2 : R4) = 1) hex

/-- The literal submodule and quotient short complex of the original coefficient ring. -/
def C4 : ShortComplex (ModuleCat R4) :=
  ModuleCat.shortComplexOfCompEqZero twoSubmodule.subtype twoSubmodule.mkQ (by
    apply LinearMap.ext
    intro x
    exact (Submodule.Quotient.mk_eq_zero (p := twoSubmodule) (x := (x : R4))).mpr
      x.property)

theorem C4_shortExact : C4.ShortExact :=
  ModuleCat.shortComplex_shortExact C4 (LinearMap.exact_subtype_mkQ twoSubmodule)
    twoSubmodule.injective_subtype twoSubmodule.mkQ_surjective

theorem C4_restricted_shortExact : (C4.map F4).ShortExact := by
  have : F4.PreservesHomology :=
    ModuleCat.preservesHomology_extendScalars_restrictScalars_of_flat f4 g4 f4_flat
  have : F4.PreservesMonomorphisms := Functor.preservesMonomorphisms_of_map_exact F4
    (fun C hC => hC.map F4)
  have : F4.PreservesEpimorphisms := Functor.preservesEpimorphisms_of_map_exact F4
    (fun C hC => hC.map F4)
  have : Mono C4.f := C4_shortExact.mono_f
  have : Epi C4.g := C4_shortExact.epi_g
  exact C4_shortExact.map F4

/-- The literal native degree-zero comparison for the original regular coefficient. -/
def regularTorZeroIso (N : ModuleCat S4) :
    (((Tor (ModuleCat S4) 0).obj M4).obj N) ≅ N :=
  ModuleCat.UniverseTensor.nativeTorZeroIso S4 M4 N ≪≫ (TensorProduct.lid S4 N).toModuleIso

theorem residue_native_length_ne_top (q : ℕ) (hq : q < 1) :
    Module.length S4 (((Tor (ModuleCat S4) q).obj M4).obj residue4) ≠ ⊤ := by
  have hq0 : q = 0 := by omega
  subst q
  rw [(regularTorZeroIso residue4).toLinearEquiv.length_eq]
  have : Module.Finite R4 (ModuleCat.UniverseTensor.nativeResidueCoefficient.{0, 0} R4) := by
    change Module.Finite R4 (ULift.{0} (IsLocalRing.ResidueField R4))
    infer_instance
  have : Finite residue4 := by
    let A := (ModuleCat.restrictScalars f4).obj (ModuleCat.of Q4 Q4)
    let X := TensorProduct R4 A
      (ModuleCat.UniverseTensor.nativeResidueCoefficient.{0, 0} R4)
    have : Finite A := by change Finite Q4; infer_instance
    have : Module.Finite R4 A := inferInstance
    have : Module.Finite R4 X := by dsimp [X]; infer_instance
    have hx : Finite X := Module.finite_of_finite R4
    change Finite X
    exact hx
  exact Module.length_ne_top

theorem residue_native_vanishes (q : ℕ) (hq : 1 ≤ q) :
    IsZero (((Tor (ModuleCat S4) q).obj M4).obj residue4) :=
  ModuleCat.UniverseTensor.nativeTor_isZero_of_projectiveDimensionLE_coefficient S4
    M4 residue4 0 q (by omega)

theorem original_R4_finiteLength : IsFiniteLength R4 R4 :=
  isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩

example :
    ModuleCat.UniverseTensor.rawNativeTorEulerSum S4 M4 (F4.obj (ModuleCat.of R4 R4)) 1 =
      ((Module.length R4 R4).toNat : ℤ) *
        ModuleCat.UniverseTensor.rawNativeTorEulerSum S4 M4 residue4 1 :=
  (ModuleCat.UniverseTensor.nativeTorFiniteLength_extendRestrict_devissage.{0, 0, 0, 0}
    R4 S4 Q4 f4 g4 f4_flat M4 R4 original_R4_finiteLength 1
    residue_native_length_ne_top residue_native_vanishes).2.2

example (q : ℕ) (hq : 1 ≤ q) :
    IsZero (((Tor (ModuleCat S4) q).obj M4).obj (F4.obj (ModuleCat.of R4 R4))) :=
  (ModuleCat.UniverseTensor.nativeTorFiniteLength_extendRestrict_devissage.{0, 0, 0, 0}
    R4 S4 Q4 f4 g4 f4_flat M4 R4 original_R4_finiteLength 1
    residue_native_length_ne_top residue_native_vanishes).2.1 q hq

example :
    ModuleCat.UniverseTensor.rawNativeTorEulerSum S4 (F4.obj (ModuleCat.of R4 R4)) M4 1 =
      ((Module.length R4 R4).toNat : ℤ) *
        ModuleCat.UniverseTensor.rawNativeTorEulerSum S4 residue4 M4 1 := by
  have hκ (q : ℕ) (hq : q < 1) :
      Module.length S4 (((Tor (ModuleCat S4) q).obj residue4).obj M4) ≠ ⊤ := by
    rw [ModuleCat.UniverseTensor.nativeTor_length_symm S4 residue4 M4 q]
    exact residue_native_length_ne_top q hq
  have hzκ (q : ℕ) (hq : 1 ≤ q) :
      IsZero (((Tor (ModuleCat S4) q).obj residue4).obj M4) :=
    (residue_native_vanishes q hq).of_iso
      (ModuleCat.UniverseTensor.nativeTorSymmetry S4 residue4 M4 q)
  exact (ModuleCat.UniverseTensor.nativeTorFiniteLength_extendRestrict_devissage_first
    R4 S4 Q4 f4 g4 f4_flat M4 R4 original_R4_finiteLength 1 hκ hzκ).2.2

example : ModuleCat.UniverseTensor.rawNativeTorEulerSum S4 M4
    (F4.obj (ModuleCat.of R4 (0 : ModuleCat R4))) 1 = 0 := by
  have : Subsingleton (0 : ModuleCat R4) :=
    ModuleCat.isZero_iff_subsingleton.mp (isZero_zero (ModuleCat R4))
  have h := ModuleCat.UniverseTensor.nativeTorFiniteLength_extendRestrict_devissage
    R4 S4 Q4 f4 g4 f4_flat M4 (0 : ModuleCat R4) IsFiniteLength.of_subsingleton 1
    residue_native_length_ne_top residue_native_vanishes
  have hz : Module.length R4 (0 : ModuleCat R4) = 0 := Module.length_eq_zero
  simpa only [hz, ENat.toNat_zero, Int.natCast_zero, zero_mul] using h.2.2

example (q : ℕ) : IsZero (((Tor (ModuleCat S4) q).obj (0 : ModuleCat S4)).obj
    (F4.obj (ModuleCat.of R4 R4))) := by
  have hκ (r : ℕ) (hr : r < 0) :
      Module.length S4 (((Tor (ModuleCat S4) r).obj (0 : ModuleCat S4)).obj residue4) ≠ ⊤ :=
    False.elim (Nat.not_lt_zero r hr)
  have hzκ (r : ℕ) (_ : 0 ≤ r) :
      IsZero (((Tor (ModuleCat S4) r).obj (0 : ModuleCat S4)).obj residue4) :=
    ModuleCat.UniverseTensor.nativeTor_isZero_of_projectiveDimensionLT_coefficient
      S4 (0 : ModuleCat S4) residue4 0 r (Nat.zero_le r)
  exact (ModuleCat.UniverseTensor.nativeTorFiniteLength_extendRestrict_devissage
    R4 S4 Q4 f4 g4 f4_flat (0 : ModuleCat S4) R4 original_R4_finiteLength 0 hκ hzκ).2.1
      q (Nat.zero_le q)

end NativeTorRestrictedDevissageTests
