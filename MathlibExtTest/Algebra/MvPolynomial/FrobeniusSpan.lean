module

public import MathlibExt.Algebra.MvPolynomial.FrobeniusSpan

@[expose] public section

private theorem exactSource
    {p : ℕ} [Fact p.Prime] {K : Type*} [Field K] [Algebra (ZMod p) K] {σ : Type*}
    (n : ℕ) (f : MvPolynomial σ (ZMod p)) (hf : Prime f) (g : MvPolynomial σ K)
    (hg : MvPolynomial.aeval (fun i => (MvPolynomial.X i : MvPolynomial σ K) ^ p ^ n) g ∈
      Ideal.span {MvPolynomial.map (algebraMap (ZMod p) K) f}) :
    g ∈ Ideal.span {MvPolynomial.map (algebraMap (ZMod p) K) f} :=
  MvPolynomial.mem_span_map_of_aeval_X_pow_mem_span_map n f hf g hg

/-- Boundary: the substituted-membership hypothesis can fail; a constant `1`
is not in the ideal generated by a variable. -/
example : (1 : MvPolynomial (Fin 1) (ZMod 2)) ∉
    Ideal.span {MvPolynomial.X 0} := by
  intro h
  have h0 := Ideal.mem_span_singleton'.mp h
  obtain ⟨h', hh⟩ := h0
  have := congrArg (MvPolynomial.eval (fun _ => (0 : ZMod 2))) hh
  simp at this
