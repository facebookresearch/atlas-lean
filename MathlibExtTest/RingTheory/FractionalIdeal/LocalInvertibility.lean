module

public import MathlibExt.RingTheory.FractionalIdeal.LocalInvertibility
public import Mathlib.RingTheory.FractionalIdeal.Extended
public import Mathlib.RingTheory.FractionalIdeal.Inverse
public import Mathlib.Algebra.CharP.Algebra
import Mathlib.RingTheory.Int.Basic

open scoped nonZeroDivisors

namespace LocalInvertibilityTest

@[expose] public section

/-!
The field examples use `ℚ`. Integer tests consume the reverse local-global
implication using independent local principal-ideal proofs and check
inverse/localization compatibility at zero and nonzero ideals.
-/

/-- The canonical localization algebra used by the rational
fractional-ideal fixtures. -/
noncomputable abbrev fractionRingRatAlgebra : Algebra ℚ (FractionRing ℚ) :=
  @OreLocalization.instAlgebra ℚ _ ℚ⁰ _ ℚ _ (Algebra.id ℚ)

attribute [local instance] fractionRingRatAlgebra

/-- A concrete nonzero invertible fractional ideal: the principal ideal generated by `6` in the
fraction field of `ℚ`, built and shown invertible without appealing to any global
`GroupWithZero` instance, just the underlying `Submodule.IsPrincipal` witness and
`FractionalIdeal.invertible_of_principal`. -/
noncomputable abbrev sixIdeal : FractionalIdeal ℚ⁰ (FractionRing ℚ) :=
  FractionalIdeal.spanSingleton ℚ⁰ (6 : FractionRing ℚ)

theorem sixIdeal_ne_zero : sixIdeal ≠ 0 :=
  FractionalIdeal.spanSingleton_ne_zero_iff.mpr (by norm_num)

instance : Submodule.IsPrincipal (sixIdeal : Submodule ℚ (FractionRing ℚ)) := by
  show Submodule.IsPrincipal
    (FractionalIdeal.spanSingleton ℚ⁰ (6 : FractionRing ℚ) : Submodule ℚ (FractionRing ℚ))
  exact ⟨6, FractionalIdeal.coe_spanSingleton _ 6⟩

theorem sixIdeal_isUnit : IsUnit sixIdeal :=
  (FractionalIdeal.mul_inv_cancel_iff_isUnit (FractionRing ℚ)).mp
    (FractionalIdeal.invertible_of_principal (FractionRing ℚ) sixIdeal sixIdeal_ne_zero)

/-- The local-global principle (Theorem 3.2): invertibility of `sixIdeal` localizes to every
maximal ideal of `ℚ`. -/
example : ∀ (𝔪 : Ideal ℚ) [𝔪.IsMaximal], IsUnit (sixIdeal.localizeAtPrime 𝔪) :=
  (FractionalIdeal.isUnit_iff_isUnit_localizeAtPrime sixIdeal).mp sixIdeal_isUnit

/-- Same, through the "all primes" form. -/
example : ∀ (𝔭 : Ideal ℚ) [𝔭.IsPrime], IsUnit (FractionalIdeal.localizeAtPrime 𝔭 sixIdeal) :=
  (FractionalIdeal.isUnit_iff_isUnit_localizeAtPrime_all_primes sixIdeal).mp sixIdeal_isUnit

/-- Corollary 3.5: `sixIdeal` is locally principal. -/
example : sixIdeal.IsLocallyPrincipal :=
  (FractionalIdeal.isUnit_iff_isLocallyPrincipal sixIdeal sixIdeal_ne_zero).mp sixIdeal_isUnit

/-- `localizeAtPrime` sends a nonzero fractional ideal to a nonzero one. -/
example (𝔪 : Ideal ℚ) [𝔪.IsPrime] : sixIdeal.localizeAtPrime 𝔪 ≠ 0 :=
  FractionalIdeal.localizeAtPrime_ne_zero 𝔪 sixIdeal_ne_zero

/-- Lemma 3.4, at the same Noetherian local domain `ℚ`: the unit fractional ideal is trivially
both invertible and principal, matching both sides of the iff. -/
example : IsUnit (1 : FractionalIdeal ℚ⁰ ℚ) ↔
    ((1 : FractionalIdeal ℚ⁰ ℚ) : Submodule ℚ ℚ).IsPrincipal :=
  fractionalIdeal_isUnit_iff_isPrincipal ℚ ℚ 1 one_ne_zero

/-- Unit localization works at any prime, without Noetherianity. -/
example {A : Type*} [CommRing A] [IsDomain A]
    (I : FractionalIdeal A⁰ (FractionRing A)) (hI : IsUnit I)
    (𝔭 : Ideal A) [𝔭.IsPrime] : IsUnit (I.localizeAtPrime 𝔭) :=
  FractionalIdeal.isUnit_localizeAtPrime_of_isUnit I hI 𝔭

/-- A nonunit scalar over the non-field domain `ℤ`, as a fractional ideal. -/
noncomputable abbrev sixIdealInt : FractionalIdeal ℤ⁰ (FractionRing ℤ) :=
  FractionalIdeal.spanSingleton ℤ⁰ (6 : FractionRing ℤ)

theorem sixIdealInt_ne_zero : sixIdealInt ≠ 0 :=
  FractionalIdeal.spanSingleton_ne_zero_iff.mpr (by norm_num)

/-- The reverse local-global implication over `ℤ`, supplied with local
principal-ideal proofs rather than a global invertibility proof. -/
example : IsUnit sixIdealInt := by
  apply (FractionalIdeal.isUnit_iff_isUnit_localizeAtPrime sixIdealInt).mpr
  intro 𝔪 h𝔪
  have hloc : sixIdealInt.localizeAtPrime 𝔪 =
      FractionalIdeal.spanSingleton (Localization.AtPrime 𝔪)⁰
        (6 : FractionRing ℤ) := by
    have hmap : IsLocalization.map (FractionRing ℤ)
        (algebraMap ℤ (Localization.AtPrime 𝔪))
        (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
          (FaithfulSMul.algebraMap_injective ℤ _)) =
        RingHom.id (FractionRing ℤ) := by
      apply IsLocalization.ringHom_ext ℤ⁰
      ext z
      simp only [RingHom.comp_apply, IsLocalization.map_eq, RingHom.id_apply]
      exact (IsScalarTower.algebraMap_apply ℤ (Localization.AtPrime 𝔪)
        (FractionRing ℤ) z).symm
    simp [sixIdealInt, FractionalIdeal.localizeAtPrime,
      FractionalIdeal.extended_spanSingleton, hmap]
  have : Submodule.IsPrincipal
      (sixIdealInt.localizeAtPrime 𝔪 :
        Submodule (Localization.AtPrime 𝔪) (FractionRing ℤ)) := by
    rw [hloc]
    exact ⟨6, FractionalIdeal.coe_spanSingleton _ 6⟩
  exact (FractionalIdeal.mul_inv_cancel_iff_isUnit (FractionRing ℤ)).mp
    (FractionalIdeal.invertible_of_principal _ _
      (FractionalIdeal.localizeAtPrime_ne_zero 𝔪 sixIdealInt_ne_zero))

/-- Inverse and localization commute for the nonzero integer ideal. -/
example (𝔭 : Ideal ℤ) [𝔭.IsPrime] :
    (sixIdealInt⁻¹).localizeAtPrime 𝔭 =
      (sixIdealInt.localizeAtPrime 𝔭)⁻¹ :=
  FractionalIdeal.localizeAtPrime_inv 𝔭 sixIdealInt

/-- Inverse and localization also commute at the zero boundary. -/
example (𝔭 : Ideal ℤ) [𝔭.IsPrime] :
    ((0 : FractionalIdeal ℤ⁰ (FractionRing ℤ))⁻¹).localizeAtPrime 𝔭 =
      ((0 : FractionalIdeal ℤ⁰ (FractionRing ℤ)).localizeAtPrime 𝔭)⁻¹ :=
  FractionalIdeal.localizeAtPrime_inv 𝔭 0

end

end LocalInvertibilityTest
