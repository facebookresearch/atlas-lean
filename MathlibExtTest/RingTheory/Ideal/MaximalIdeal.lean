module

public import MathlibExt.RingTheory.Ideal.MaximalIdeal
public import MathlibExt.RingTheory.AdjoinRoot.LocalMaximal
public import Mathlib.Algebra.Field.ZMod

/-!
# Tests for the corrected integrality and monic containment statements

The raw arbitrary-polynomial Corollary 10.10 target is not claimed. Generic
applications retain integrality or monicity, and the finite-field example
uses the corrected monic statement and monic companion classification.
-/

@[expose] public section

open Polynomial

-- Corrected generic API example: an integral extension of a local ring.
example {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [Algebra A B]
    [Algebra.IsIntegral A B] {m : Ideal B} (hm : m.IsMaximal) :
    Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) ≤ m :=
  Ideal.IsMaximal.map_maximalIdeal_le hm

-- Corrected `AdjoinRoot` form under its explicit integrality hypothesis.
example {A : Type*} [CommRing A] [IsLocalRing A] {g : Polynomial A}
    [Algebra.IsIntegral A (AdjoinRoot g)] {m : Ideal (AdjoinRoot g)}
    (hm : m.IsMaximal) :
    Ideal.map (algebraMap A (AdjoinRoot g)) (IsLocalRing.maximalIdeal A) ≤ m :=
  AdjoinRoot.isMaximal_map_maximalIdeal_le hm

-- Corrected monic specialization: monicity supplies the integrality instance.
example {A : Type*} [CommRing A] [IsLocalRing A] {g : Polynomial A} (hg : g.Monic)
    {m : Ideal (AdjoinRoot g)} (hm : m.IsMaximal) :
    Ideal.map (algebraMap A (AdjoinRoot g)) (IsLocalRing.maximalIdeal A) ≤ m :=
  AdjoinRoot.isMaximal_map_maximalIdeal_le_of_monic hg hm

-- Concrete finite-field regression: monic reducible `X * (X - 1)` over `ZMod 5`.
-- The ideal generated by the root is maximal by the companion monic
-- classification, and the corrected lemma contains the extension of the base
-- maximal ideal (which is `⊥` here, since `ZMod 5` is a field).
noncomputable example [Fact (Nat.Prime 5)] :
    Ideal.map (algebraMap (ZMod 5) (AdjoinRoot (X * (X - C 1) : (ZMod 5)[X])))
        (IsLocalRing.maximalIdeal (ZMod 5)) ≤
      Ideal.span {AdjoinRoot.root (X * (X - C 1) : (ZMod 5)[X])} := by
  let g : (ZMod 5)[X] := X * (X - C 1)
  have hg : g.Monic := monic_X.mul (monic_X_sub_C 1)
  have hm : (Ideal.span {AdjoinRoot.root g} : Ideal (AdjoinRoot g)).IsMaximal := by
    let _ : Field ((ZMod 5) ⧸ IsLocalRing.maximalIdeal (ZMod 5)) :=
      Ideal.Quotient.field _
    apply (AdjoinRoot.is_maximal_iff_irreducible_factor_of_monic
      g hg (Ideal.span {AdjoinRoot.root g})).2
    refine ⟨X, ?_, ?_, ?_⟩
    · simpa using (irreducible_X : Irreducible
        (X : ((ZMod 5) ⧸ IsLocalRing.maximalIdeal (ZMod 5))[X]))
    · simp [g]
    · simp [IsLocalRing.maximalIdeal_eq_bot, AdjoinRoot.mk_X]
  exact AdjoinRoot.isMaximal_map_maximalIdeal_le_of_monic hg hm
