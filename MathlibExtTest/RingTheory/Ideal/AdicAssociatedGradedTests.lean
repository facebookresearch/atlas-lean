module

public import MathlibExt.RingTheory.Ideal.AdicAssociatedGraded
import Mathlib.Tactic.NormNum

/-!
# Initial forms for the ideal generated by three

In the associated graded ring of (3) in the integers, the initial forms of
three and nine in degrees one and two are nonzero. The former is killed by
three, and its square is the latter. The symbol formulas for multiplication
and scalar-ring transport are simplification rules over arbitrary
commutative rings and independent ring universes.
-/

@[expose] public section
noncomputable section

open scoped DirectSum

namespace AdicSymbolExamples

private abbrev I3 : Ideal ℤ := Ideal.span {(3 : ℤ)}
private def x3 : (I3 ^ 1 : Ideal ℤ) :=
  ⟨3, by norm_num [I3, Ideal.mem_span_singleton]⟩
private def x9 : (I3 ^ 2 : Ideal ℤ) :=
  ⟨9, by norm_num [I3, Ideal.span_singleton_pow, Ideal.mem_span_singleton]⟩

example : CommRing I3.adicAssociatedGraded := inferInstance

private theorem symbol_nonzero (n : ℕ) (x : (I3 ^ n : Ideal ℤ))
    (hx : (x : ℤ) ∉ I3 ^ (n + 1)) : I3.adicSymbol n x ≠ 0 := by
  intro hz
  have hden : x ∈ (I3 • ⊤ : Submodule ℤ (I3 ^ n : Ideal ℤ)) :=
    (Submodule.Quotient.mk_eq_zero
      (I3 • ⊤ : Submodule ℤ (I3 ^ n : Ideal ℤ))).mp
        ((I3.adicSymbol_apply n x).symm.trans hz)
  have hmem := (Submodule.mem_smul_top_iff (I := I3) (I3 ^ n : Ideal ℤ) x).mp hden
  exact hx (by simpa only [Ideal.smul_eq_mul, pow_succ'] using hmem)

example : I3.adicSymbol 1 x3 ≠ 0 ∧ I3.adicSymbol 2 x9 ≠ 0 := by
  constructor
  · apply symbol_nonzero
    norm_num [x3, I3, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  · apply symbol_nonzero
    norm_num [x9, I3, Ideal.span_singleton_pow, Ideal.mem_span_singleton]

example : (3 : ℤ) • I3.adicSymbol 1 x3 = 0 := by
  calc
    (3 : ℤ) • I3.adicSymbol 1 x3 = I3.adicSymbol 1 ((3 : ℤ) • x3) :=
      ((I3.adicSymbol 1).map_smul (3 : ℤ) x3).symm
    _ = 0 := by
      rw [Ideal.adicSymbol_apply]
      apply (Submodule.Quotient.mk_eq_zero
        (I3 • ⊤ : Submodule ℤ (I3 ^ 1 : Ideal ℤ))).mpr
      apply (Submodule.mem_smul_top_iff (I := I3) (I3 ^ 1 : Ideal ℤ) _).mpr
      have h : (((3 : ℤ) • x3 : I3 ^ 1) : ℤ) ∈ I3 ^ 2 := by
        norm_num [x3, I3, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      simpa only [Ideal.smul_eq_mul, pow_succ'] using h

example :
    DirectSum.of I3.adicGradedPiece 1 (I3.adicSymbol 1 x3) *
        DirectSum.of I3.adicGradedPiece 1 (I3.adicSymbol 1 x3) =
      DirectSum.of I3.adicGradedPiece 2 (I3.adicSymbol 2 x9) := by
  rw [DirectSum.of_mul_of]
  change DirectSum.of I3.adicGradedPiece 2
      (I3.adicGradedMul 1 1 (I3.adicSymbol 1 x3) (I3.adicSymbol 1 x3)) = _
  rw [Ideal.adicGradedMul_symbol]
  rfl

universe u v

example {R : Type u} [CommRing R] (I : Ideal R) (m n : ℕ)
    (x : (I ^ m : Ideal R)) (y : (I ^ n : Ideal R)) :
    I.adicGradedMul m n (I.adicSymbol m x) (I.adicSymbol n y) =
      I.adicSymbol (m + n) ⟨(x : R) * y, by
        rw [pow_add]
        exact Ideal.mul_mem_mul x.2 y.2⟩ := by simp

example {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (e : R ≃+* S) (I : Ideal R) (n : ℕ) (x : (I ^ n : Ideal R)) :
    I.adicGradedPieceMapEquiv e n (I.adicSymbol n x) =
      (I.map (e : R →+* S)).adicSymbol n ⟨e x, by
        rw [← Ideal.map_pow]
        exact Ideal.mem_map_of_mem e x.2⟩ := by simp

example {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (e : R ≃+* S) (I : Ideal R) (n : ℕ) (x : (I ^ n : Ideal R)) :
    I.adicAssociatedGradedMapEquiv e
        (DirectSum.of I.adicGradedPiece n (I.adicSymbol n x)) =
      DirectSum.of (fun n => (I.map (e : R →+* S)).adicGradedPiece n) n
        ((I.map (e : R →+* S)).adicSymbol n ⟨e x, by
          rw [← Ideal.map_pow]
          exact Ideal.mem_map_of_mem e x.2⟩) := by simp

end AdicSymbolExamples
