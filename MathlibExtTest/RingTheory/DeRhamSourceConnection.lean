module

import MathlibExt.RingTheory.DeRhamSource.Connection

/-!
# Extended connections need the quotient setting of Stacks 07HY

An extended connection records that its quotient map `π` is surjective with kernel generated by
good generators, so its descended de Rham differential squares to zero. With a non-surjective `π`,
for example the zero map from `Ω_{ℚ/ℚ} = 0` to `ℚ³`, there is no extended connection: a
coefficient family satisfying only the commuting squares need not square to zero there.
-/

namespace MathlibExtTest.RingTheory.DeRhamSourceConnection

open MathlibExt.DeRhamSource MathlibExt.DeRhamSource.Crystalline
open MathlibExt.DeRhamSource.Stacks.DeRham.DifferentialDescent

/-- The zero map from the Kähler differentials of `ℚ` over itself to `ℚ³`. -/
noncomputable abbrev zeroQuotient : Ω[ℚ⁄ℚ] →ₗ[ℚ] (Fin 3 → ℚ) := 0

theorem zeroQuotient_not_surjective : ¬ Function.Surjective zeroQuotient := by
  intro h
  obtain ⟨x, hx⟩ := h (fun _ => 1)
  have h0 := congrFun hx 0
  simp [zeroQuotient] at h0

/-- With the non-surjective zero quotient there is no extended connection. -/
example (S : SourceDeRham ℚ ℚ) (nabla : Connection ℚ ℚ zeroQuotient ℚ) :
    IsEmpty (ExtendedConnection S zeroQuotient nabla) :=
  ⟨fun E => zeroQuotient_not_surjective E.surjective⟩

/-- The descended differential of an extended connection squares to zero. -/
example {A B Omega M : Type} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup Omega] [Module B Omega] [AddCommGroup M] [Module B M]
    {S : SourceDeRham A B} {π : Ω[B⁄A] →ₗ[B] Omega} {nabla : Connection A B π M}
    (E : ExtendedConnection S π nabla) :
    (E.deRhamDifferential 2).comp (E.deRhamDifferential 1) = 0 :=
  E.deRhamDifferential_comp_self 1

end MathlibExtTest.RingTheory.DeRhamSourceConnection
