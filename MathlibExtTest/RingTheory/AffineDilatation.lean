module

public import MathlibExt.RingTheory.AffineDilatation

@[expose] public section

universe u v

-- Consumer with the original binders.
example {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]
    [Algebra.FiniteType R A] (I : Ideal A) (a : A) (hI : I.FG) :
    Algebra.FiniteType R (AffineDilatation.Ring I a) :=
  AffineDilatation.finiteType_of_fg I a hI

-- Higher-universe consumer.
example {R : Type 1} [CommRing R] {A : Type 2} [CommRing A] [Algebra R A]
    [Algebra.FiniteType R A] (I : Ideal A) (a : A) (hI : I.FG) :
    Algebra.FiniteType R (AffineDilatation.Ring I a) :=
  AffineDilatation.finiteType_of_fg I a hI

-- Boundary: finite generation of the center is a sufficient hypothesis, not
-- a necessary one (for `a = 1` every generator `g / 1` is already in the image
-- of `A`, for any ideal). The zero ideal gives the trivial finite case tested
-- here: the subalgebra generated by `0`.
example {A : Type v} [CommRing A] (a : A) :
    Algebra.FiniteType A (AffineDilatation.Ring (⊥ : Ideal A) a) := by
  apply AffineDilatation.finiteType_of_fg
  exact ⟨∅, by simp⟩
