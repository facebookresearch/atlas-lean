module

public import MathlibExt.RingTheory.FinitePresentationNilpotentThickening
import Mathlib.Data.ZMod.Basic

@[expose] public section

universe u v w

/-- `exactSource` consumer with the original binders. -/
example {P B' : Type u} [CommRing P] [CommRing B'] (p : P →+* B')
    (hp : Function.Surjective p) (hI : IsNilpotent (RingHom.ker p))
    {A : Type v} [CommRing A] [Algebra P A] [Module.Flat P A]
    {A' : Type w} [CommRing A'] [Algebra B' A']
    (q : A →+* A') (hq : Function.Surjective q)
    (hcomm : q.comp (algebraMap P A) = (algebraMap B' A').comp p)
    (hker : RingHom.ker q = (RingHom.ker p).map (algebraMap P A))
    (hfp' : Algebra.FinitePresentation B' A') :
    Algebra.FinitePresentation P A :=
  Algebra.FinitePresentation.of_surjective_of_isNilpotent_ker_of_flat_of_finitePresentation
    p hp hI q hq hcomm hker hfp'

/-- Higher-universe consumer (`Type 1` in place of the original universes). -/
example {P B' : Type 1} [CommRing P] [CommRing B'] (p : P →+* B')
    (hp : Function.Surjective p) (hI : IsNilpotent (RingHom.ker p))
    {A : Type 1} [CommRing A] [Algebra P A] [Module.Flat P A]
    {A' : Type 1} [CommRing A'] [Algebra B' A']
    (q : A →+* A') (hq : Function.Surjective q)
    (hcomm : q.comp (algebraMap P A) = (algebraMap B' A').comp p)
    (hker : RingHom.ker q = (RingHom.ker p).map (algebraMap P A))
    (hfp' : Algebra.FinitePresentation B' A') :
    Algebra.FinitePresentation P A :=
  Algebra.FinitePresentation.of_surjective_of_isNilpotent_ker_of_flat_of_finitePresentation
    p hp hI q hq hcomm hker hfp'

/-- Boundary case: when `B' = P` and both maps are identities, both kernels are `⊥`, every
hypothesis holds, and the theorem returns the assumed finite presentation. -/
example {P A : Type*} [CommRing P] [CommRing A] [Algebra P A] [Module.Flat P A]
    (hfp : Algebra.FinitePresentation P A) : Algebra.FinitePresentation P A :=
  Algebra.FinitePresentation.of_surjective_of_isNilpotent_ker_of_flat_of_finitePresentation
    (RingHom.id P) Function.surjective_id
    (by rw [(RingHom.injective_iff_ker_eq_bot _).mp Function.injective_id]; exact ⟨1, pow_one _⟩)
    (RingHom.id A) Function.surjective_id
    (by rw [RingHom.id_comp, RingHom.comp_id])
    (by rw [(RingHom.injective_iff_ker_eq_bot (RingHom.id A)).mp Function.injective_id,
      (RingHom.injective_iff_ker_eq_bot (RingHom.id P)).mp Function.injective_id, Ideal.map_bot])
    hfp

namespace FinitePresentationNilpotentThickeningTest

/-- Reduction modulo `2`. Its kernel `{0, 2}` squares to zero, so `ZMod 4` is a nilpotent
thickening of `ZMod 2`. -/
private abbrev red : ZMod 4 →+* ZMod 2 := ZMod.castHom (by norm_num) (ZMod 2)

private theorem red_surjective : Function.Surjective red := ZMod.ringHom_surjective red

private theorem isNilpotent_ker_red : IsNilpotent (RingHom.ker red) := by
  refine ⟨2, le_bot_iff.mp ?_⟩
  rw [pow_two, Ideal.mul_le]
  intro x hx y hy
  rw [RingHom.mem_ker] at hx hy
  rw [Ideal.mem_bot]
  revert x y
  decide

/-- The thickening is not trivial: `2` lies in the kernel. -/
example : RingHom.ker red ≠ ⊥ := by
  intro h
  have h2 : (2 : ZMod 4) ∈ RingHom.ker red := by
    rw [RingHom.mem_ker]
    decide
  rw [h, Ideal.mem_bot] at h2
  exact absurd h2 (by decide)

/-- Concrete nilpotent thickening: reducing coefficients modulo `2` maps
`MvPolynomial (Fin 1) (ZMod 4)` onto `MvPolynomial (Fin 1) (ZMod 2)` with kernel generated by
`ker red`, so the theorem lifts finite presentation over `ZMod 2` to finite presentation over
`ZMod 4`. -/
example : Algebra.FinitePresentation (ZMod 4) (MvPolynomial (Fin 1) (ZMod 4)) :=
  Algebra.FinitePresentation.of_surjective_of_isNilpotent_ker_of_flat_of_finitePresentation
    red red_surjective isNilpotent_ker_red
    (MvPolynomial.map red) (MvPolynomial.map_surjective red red_surjective)
    (by
      rw [MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq]
      exact RingHom.ext fun r => MvPolynomial.map_C red r)
    (by rw [MvPolynomial.ker_map, MvPolynomial.algebraMap_eq])
    inferInstance

end FinitePresentationNilpotentThickeningTest
