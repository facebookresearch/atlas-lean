open FractionalIdeal in
/-- The original helper type, with independently polymorphic R and K. -/
theorem exists_not_dvd_spanSingleton_eq {R : Type*} [CommRing R]
    [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
    [IsFractionRing R K] {x : R} (hx : Prime x) (I J : Ideal R)
    (hI : ¬ (Ideal.span <| singleton x) ∣ I)
    (hJ : ¬ (Ideal.span <| singleton x) ∣ J)
    (h : Submodule.IsPrincipal
      ((I / J : FractionalIdeal R⁰ K) : Submodule R K)) :
    ∃ a b : R, ¬ (x ∣ a) ∧ ¬ (x ∣ b) ∧
      spanSingleton R⁰ (algebraMap R K a / algebraMap R K b) = I / J :=
  FractionalIdeal.exists_not_dvd_spanSingleton_eq hx I J hI hJ h

end P2MW.S_flt_regular.FltRegular

open FractionalIdeal

/-- The rational quotient is generated by 3/5, not by 5/3. -/
theorem rational_quotient :
    spanSingleton ℤ⁰ (3 / 5 : ℚ) =
      (Ideal.span {(9 : ℤ)} / Ideal.span {(15 : ℤ)} :
        FractionalIdeal ℤ⁰ ℚ) := by
  rw [coeIdeal_span_singleton, coeIdeal_span_singleton,
    spanSingleton_div_spanSingleton]
  congr 1
  change (3 / 5 : ℚ) = 9 / 15
  norm_num

/-- Applying the API to (9)/(15) at 2 gives two odd entries. -/
theorem rational_avoiding_presentation :
    ∃ a b : ℤ, ¬ 2 ∣ a ∧ ¬ 2 ∣ b ∧
      spanSingleton ℤ⁰ (a / b : ℚ) =
        (Ideal.span {(9 : ℤ)} / Ideal.span {(15 : ℤ)} :
          FractionalIdeal ℤ⁰ ℚ) := by
  apply FractionalIdeal.exists_not_dvd_spanSingleton_eq
    (by norm_num; exact Nat.prime_two)
  · rw [Ideal.dvd_span_singleton, Ideal.mem_span_singleton]
    norm_num
  · rw [Ideal.dvd_span_singleton, Ideal.mem_span_singleton]
    norm_num
  · exact (isPrincipal_iff _).mpr ⟨3 / 5, rational_quotient.symm⟩

/-- The pair 9/15 is allowed despite its common factor 3; 6/10 is not. -/
theorem rational_presentations :
    (¬ (2 : ℤ) ∣ 9 ∧ ¬ (2 : ℤ) ∣ 15 ∧ Int.gcd 9 15 = 3) ∧
      (9 / 15 : ℚ) = 3 / 5 ∧ (6 / 10 : ℚ) = 3 / 5 ∧
      (2 : ℤ) ∣ 6 ∧ (2 : ℤ) ∣ 10 := by
  norm_num

/-- Losing numerator avoidance really can make the conclusion false. -/
theorem numerator_avoidance_necessary :
    ¬ ∃ a b : ℤ, ¬ 2 ∣ a ∧ ¬ 2 ∣ b ∧
      spanSingleton ℤ⁰ (a / b : ℚ) =
        (Ideal.span {(2 : ℤ)} / Ideal.span {(1 : ℤ)} :
          FractionalIdeal ℤ⁰ ℚ) := by
  rintro ⟨a, b, ha, hb, h⟩
  have hb0 : b ≠ 0 := fun e => hb (e ▸ dvd_zero 2)
  have heq : spanSingleton ℤ⁰ (a / b : ℚ) *
      (Ideal.span {(1 : ℤ)} : FractionalIdeal ℤ⁰ ℚ) =
      Ideal.span {(2 : ℤ)} := by
    rw [Ideal.span_singleton_one, coeIdeal_top, FractionalIdeal.div_one] at h
    rw [Ideal.span_singleton_one, coeIdeal_top, mul_one]
    exact h
  have hc : Ideal.span {a} * Ideal.span {(1 : ℤ)} =
      Ideal.span {b} * Ideal.span {(2 : ℤ)} :=
    (mk'_mul_coeIdeal_eq_coeIdeal ℚ
      (mem_nonZeroDivisors_iff_ne_zero.mpr hb0)).mp
      (by simpa only [IsFractionRing.mk'_eq_div, algebraMap_int_eq,
        Int.coe_castRingHom] using heq)
  have hle : Ideal.span {a} ≤ Ideal.span {(2 : ℤ)} := by
    simpa only [Ideal.span_singleton_one, Ideal.mul_top] using
      (hc ▸ Ideal.mul_le_right :
        Ideal.span {a} * Ideal.span {(1 : ℤ)} ≤ Ideal.span {(2 : ℤ)})
  exact ha (Ideal.mem_span_singleton.mp
    (hle (Ideal.mem_span_singleton_self a)))

/-- Losing denominator avoidance also makes the conclusion false. -/
theorem denominator_avoidance_necessary :
    ¬ ∃ a b : ℤ, ¬ 2 ∣ a ∧ ¬ 2 ∣ b ∧
      spanSingleton ℤ⁰ (a / b : ℚ) =
        (Ideal.span {(1 : ℤ)} / Ideal.span {(2 : ℤ)} :
          FractionalIdeal ℤ⁰ ℚ) := by
  rintro ⟨a, b, ha, hb, h⟩
  apply numerator_avoidance_necessary
  refine ⟨b, a, hb, ha, ?_⟩
  have hi := congrArg Inv.inv h
  simpa only [spanSingleton_inv, inv_div] using hi

/-- The cyclotomic Case II call interface. Principality and the two ideal
avoidances are upstream inputs; the prime-element proof is supplied here. -/
theorem cyclotomic_call_interface {K : Type} [Field K] [NumberField K]
    {p : ℕ} [NeZero p] [Fact p.Prime]
    [IsCyclotomicExtension {p} ℚ K] {ζ : K}
    (hζ : IsPrimitiveRoot ζ p) (I J : Ideal (𝓞 K))
    (hI : ¬ Ideal.span {hζ.toInteger - 1} ∣ I)
    (hJ : ¬ Ideal.span {hζ.toInteger - 1} ∣ J)
    (h : Submodule.IsPrincipal
      ((I / J : FractionalIdeal (𝓞 K)⁰ K) : Submodule (𝓞 K) K)) :
    ∃ a b : 𝓞 K, ¬ hζ.toInteger - 1 ∣ a ∧
      ¬ hζ.toInteger - 1 ∣ b ∧
      spanSingleton (𝓞 K)⁰ (a / b : K) = I / J :=
  FractionalIdeal.exists_not_dvd_spanSingleton_eq
    hζ.zeta_sub_one_prime' I J hI hJ h

namespace CaseII

variable {K : Type} [Field K] [NumberField K] {p : ℕ}
  [NeZero p] [Fact p.Prime] [IsCyclotomicExtension {p} ℚ K]
  {ζ : K} (hζ : IsPrimitiveRoot ζ p)
  (A : Polynomial.nthRootsFinset p (1 : 𝓞 K) → Ideal (𝓞 K))
  (A₀ : Ideal (𝓞 K)) (η₀ : Polynomial.nthRootsFinset p (1 : 𝓞 K))
  (hA : ∀ η, Ideal.span {hζ.toInteger - 1} ∣ A η ↔ η = η₀)
  (hA₀ : ¬ Ideal.span {hζ.toInteger - 1} ∣ A₀)
  (hprincipal : ∀ η, Submodule.IsPrincipal
    ((A η / A₀ : FractionalIdeal (𝓞 K)⁰ K) : Submodule (𝓞 K) K))
  (η : Polynomial.nthRootsFinset p (1 : 𝓞 K))

include hA hA₀ hprincipal in
/-- R3858–3864 at the upstream API boundary: `A`, `A₀`, and the three
certificates are supplied by the preceding Case II development. -/
theorem exists_not_dvd_spanSingleton_eq_a_div_a_zero (hη : η ≠ η₀) :
    ∃ a b : 𝓞 K, ¬ hζ.toInteger - 1 ∣ a ∧ ¬ hζ.toInteger - 1 ∣ b ∧
      spanSingleton (𝓞 K)⁰ (a / b : K) = A η / A₀ :=
  FractionalIdeal.exists_not_dvd_spanSingleton_eq hζ.zeta_sub_one_prime'
    _ _ ((hA η).not.mpr hη) hA₀ (hprincipal η)

/-- R3866–3868: the first witness is the numerator. -/
noncomputable def aDivAZeroNum (hη : η ≠ η₀) : 𝓞 K :=
  (exists_not_dvd_spanSingleton_eq_a_div_a_zero
    hζ A A₀ η₀ hA hA₀ hprincipal η hη).choose

/-- R3870–3872: the second witness is the denominator. -/
noncomputable def aDivAZeroDenom (hη : η ≠ η₀) : 𝓞 K :=
  (exists_not_dvd_spanSingleton_eq_a_div_a_zero
    hζ A A₀ η₀ hA hA₀ hprincipal η hη).choose_spec.choose

local notation "α" => aDivAZeroNum hζ A A₀ η₀ hA hA₀ hprincipal η
local notation "β" => aDivAZeroDenom hζ A A₀ η₀ hA hA₀ hprincipal η

/-- R3877–3890: both avoidance facts and the exact numerator/denominator
orientation belong to the same chosen witness pair. -/
theorem a_div_a_zero_specs (hη : η ≠ η₀) :
    ¬ hζ.toInteger - 1 ∣ α hη ∧ ¬ hζ.toInteger - 1 ∣ β hη ∧
      spanSingleton (𝓞 K)⁰ (α hη / β hη : K) = A η / A₀ :=
  (exists_not_dvd_spanSingleton_eq_a_div_a_zero
    hζ A A₀ η₀ hA hA₀ hprincipal η hη).choose_spec.choose_spec

end CaseII

/-!
The non-PID fixture is the canonical ring of integers of Q(sqrt(-5)),
realized using `QuadraticAlgebra ℚ (-5) 0`. It does not assert that an
arbitrary quadratic order is integrally closed. P=(2,1+sqrt(-5)), J=3P,
and the prime element is sqrt(-5), replacing the proposed inert 11.
Both ideals are proved nonprincipal, their quotient is (1/3), and neither
is divisible by the chosen prime. This is independently authored test
mathematics, not an adaptation of a quadratic-order implementation.
-/
namespace NonPIDCanonical

open QuadraticAlgebra

/-- A concrete quadratic field with generator squaring to -5. -/
abbrev K := QuadraticAlgebra ℚ (-5) 0

local instance : Fact (∀ r : ℚ, r ^ 2 ≠ -5 + 0 * r) :=
  ⟨by intro r; nlinarith [sq_nonneg r]⟩

noncomputable instance : NumberField K := NumberField.mk


lemma omega_integral : IsIntegral ℤ (ω : K) := by
  refine ⟨Polynomial.X ^ 2 + Polynomial.C (5 : ℤ),
    Polynomial.monic_X_pow_add_C _ (by decide), ?_⟩
  simp only [Polynomial.eval₂_add, Polynomial.eval₂_pow,
    Polynomial.eval₂_X, map_ofNat]
  ext <;> norm_num [pow_two, QuadraticAlgebra.omega]

lemma norm_formula (z : 𝓞 K) :
    (Algebra.norm ℤ z : ℚ) = (z : K).re ^ 2 + 5 * (z : K).im ^ 2 := by
  calc
    (Algebra.norm ℤ z : ℚ) = Algebra.norm ℚ (z : K) := by
      simpa only [algebraMap_int_eq, Int.coe_castRingHom] using
        (Algebra.norm_localization ℤ ℤ⁰ (Rₘ := ℚ) (Sₘ := K) z).symm
    _ = _ := by
      change (DistribSMul.toLinearMap ℚ K (z : K)).det = _
      rw [QuadraticAlgebra.det_toLinearMap_eq_norm]
      simp [QuadraticAlgebra.norm_def, pow_two]
      ring

/-- The integral square root of -5, used as the prime element. -/
def alpha : 𝓞 K := ⟨ω, omega_integral⟩

lemma norm_alpha : Algebra.norm ℤ alpha = 5 := by
  have h := norm_formula alpha
  norm_num [alpha, QuadraticAlgebra.omega] at h
  exact_mod_cast h

lemma norm_one_add_alpha : Algebra.norm ℤ (1 + alpha) = 6 := by
  have h := norm_formula (1 + alpha)
  change (Algebra.norm ℤ (1 + alpha) : ℚ) =
    (1 + (ω : K)).re ^ 2 + 5 * (1 + (ω : K)).im ^ 2 at h
  norm_num at h
  exact_mod_cast h

lemma integer_norm_two_mod_five (a b c : ℤ)
    (h : a ^ 2 + 5 * b ^ 2 = 2 * c ^ 2) :
    5 ∣ a ∧ 5 ∣ b ∧ 5 ∣ c := by
  have hm : (a : ZMod 5) ^ 2 = 2 * (c : ZMod 5) ^ 2 := by
    have hh := congrArg (Int.castRingHom (ZMod 5)) h
    norm_num at hh
    simpa only [show (5 : ZMod 5) = 0 from rfl, zero_mul, add_zero] using hh
  have test : ∀ a c : ZMod 5, a ^ 2 = 2 * c ^ 2 → a = 0 ∧ c = 0 :=
    by decide
  obtain ⟨ha, hc⟩ := test _ _ hm
  have ha5 : (5 : ℤ) ∣ a := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp ha
  have hc5 : (5 : ℤ) ∣ c := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hc
  refine ⟨ha5, ?_, hc5⟩
  obtain ⟨u, rfl⟩ := ha5
  obtain ⟨v, rfl⟩ := hc5
  have hb5 : (5 : ℤ) ∣ b ^ 2 := ⟨2 * v ^ 2 - u ^ 2, by nlinarith [h]⟩
  exact (show Prime (5 : ℤ) by norm_num; exact Nat.prime_five).dvd_of_dvd_pow
    hb5

lemma rational_norm_ne_two (a b : ℚ) : a ^ 2 + 5 * b ^ 2 ≠ 2 := by
  classical
  intro h
  have h5 : (Ideal.span {(5 : ℤ)}) ≠ ⊤ := by
    rw [ne_eq, Ideal.span_singleton_eq_top]
    norm_num [Int.isUnit_iff]
  obtain ⟨t, ht, i, _, hi⟩ := Ideal.exist_integer_multiples_notMem
    (K := ℚ) h5 Finset.univ ![a, b, 1]
    (j := (2 : Fin 3)) (Finset.mem_univ _) (by norm_num)
  choose g hg using fun j => ht j (Finset.mem_univ _)
  have he : (g 0 : ℚ) ^ 2 + 5 * (g 1 : ℚ) ^ 2 = 2 * (g 2 : ℚ) ^ 2 := by
    have h0 : (g 0 : ℚ) = t * a := by simpa using hg 0
    have h1 : (g 1 : ℚ) = t * b := by simpa using hg 1
    have h2 : (g 2 : ℚ) = t := by simpa using hg 2
    rw [h0, h1, h2]
    linear_combination t ^ 2 * h
  have he' : g 0 ^ 2 + 5 * g 1 ^ 2 = 2 * g 2 ^ 2 := by
    exact_mod_cast he
  obtain ⟨h0, h1, h2⟩ := integer_norm_two_mod_five _ _ _ he'
  have hall : ∀ j : Fin 3, (5 : ℤ) ∣ g j := by
    intro j
    fin_cases j <;> assumption
  apply hi
  rw [← hg i]
  exact FractionalIdeal.mem_coeIdeal_of_mem ℤ⁰
    (Ideal.mem_span_singleton.mpr (hall i))

lemma norm_natAbs_ne_two (z : 𝓞 K) : (Algebra.norm ℤ z).natAbs ≠ 2 := by
  have hn : 0 ≤ (Algebra.norm ℤ z : ℚ) := by
    rw [norm_formula]
    positivity
  have hn' : 0 ≤ Algebra.norm ℤ z := by exact_mod_cast hn
  intro h
  have he : Algebra.norm ℤ z = 2 := by
    simpa only [Int.natCast_natAbs, abs_of_nonneg hn', Nat.cast_ofNat] using
      congrArg (fun n : ℕ => (n : ℤ)) h
  apply rational_norm_ne_two (z : K).re (z : K).im
  rw [← norm_formula, he]
  norm_num

lemma alpha_sq : alpha ^ 2 = -5 := by
  apply NumberField.RingOfIntegers.ext
  change (ω : K) ^ 2 = -5
  ext <;> norm_num [pow_two, QuadraticAlgebra.omega]

/-- The nonprincipal ideal (2, 1 + sqrt(-5)), of norm 2. -/
def P : Ideal (𝓞 K) := Ideal.span {2, 1 + alpha}

lemma P_sq_le_two : P ^ 2 ≤ Ideal.span {(2 : 𝓞 K)} := by
  simp only [P, pow_two, Ideal.span_insert, Ideal.sup_mul, Ideal.mul_sup,
    Ideal.span_singleton_mul_span_singleton, sup_le_iff,
    Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
  refine ⟨⟨dvd_mul_right _ _, dvd_mul_left _ _⟩,
    ⟨dvd_mul_right _ _, ⟨alpha - 2, ?_⟩⟩⟩
  linear_combination alpha_sq

lemma norm_natCast (n : ℕ) : Algebra.norm ℤ (n : 𝓞 K) = (n : ℤ) ^ 2 := by
  rw [Algebra.norm_natCast, NumberField.RingOfIntegers.rank,
    QuadraticAlgebra.finrank_eq_two]

lemma P_ne_top : P ≠ ⊤ := by
  intro h
  have ht : (⊤ : Ideal (𝓞 K)) ≤ Ideal.span {(2 : 𝓞 K)} := by
    simpa only [h, pow_two, Ideal.top_mul] using P_sq_le_two
  have hh := congrArg Ideal.absNorm (top_unique ht)
  rw [Ideal.absNorm_span_singleton, Ideal.absNorm_top] at hh
  have htwo := norm_natCast 2
  norm_num at htwo
  rw [htwo] at hh
  norm_num at hh

lemma absNorm_P : Ideal.absNorm P = 2 := by
  have hd := Ideal.absNorm_span_insert (2 : 𝓞 K) {1 + alpha}
  have htwo := norm_natCast 2
  norm_num at htwo
  rw [Ideal.absNorm_span_singleton, norm_one_add_alpha, htwo] at hd
  norm_num at hd
  change Ideal.absNorm P ∣ 2 at hd
  rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
  · exact False.elim (P_ne_top (Ideal.absNorm_eq_one_iff.mp h))
  · exact h

lemma P_not_principal : ¬ Submodule.IsPrincipal P := by
  rintro ⟨a, ha⟩
  change P = Ideal.span {a} at ha
  apply norm_natAbs_ne_two a
  rw [← Ideal.absNorm_span_singleton, ← ha]
  exact absNorm_P

lemma alpha_prime : Prime alpha := by
  apply Ideal.prime_of_irreducible_absNorm_span
  · apply (Algebra.norm_ne_zero_iff (R := ℤ)).mp
    rw [norm_alpha]
    norm_num
  · rw [Ideal.absNorm_span_singleton, norm_alpha]
    exact (Nat.irreducible_iff_nat_prime _).mpr Nat.prime_five

/-- Scaling P by 3 preserves its nontrivial ideal class. -/
def J : Ideal (𝓞 K) := Ideal.span {3} * P

lemma J_not_principal : ¬ Submodule.IsPrincipal J := by
  rintro ⟨a, ha⟩
  change J = Ideal.span {a} at ha
  have hthree := norm_natCast 3
  norm_num at hthree
  have hnorm : (Algebra.norm ℤ a).natAbs = 18 := by
    rw [← Ideal.absNorm_span_singleton, ← ha, J,
      map_mul, Ideal.absNorm_span_singleton, hthree, absNorm_P]
    norm_num
  have hn : 0 ≤ (Algebra.norm ℤ a : ℚ) := by
    rw [norm_formula]
    positivity
  have hn' : 0 ≤ Algebra.norm ℤ a := by exact_mod_cast hn
  have he : Algebra.norm ℤ a = 18 := by
    simpa only [Int.natCast_natAbs, abs_of_nonneg hn', Nat.cast_ofNat] using
      congrArg (fun n : ℕ => (n : ℤ)) hnorm
  have hf : (a : K).re ^ 2 + 5 * (a : K).im ^ 2 = 18 := by
    rw [← norm_formula, he]
    norm_num
  apply rational_norm_ne_two ((a : K).re / 3) ((a : K).im / 3)
  linear_combination hf / 9

lemma alpha_not_dvd_nat (n : ℕ) (hn : ¬ (5 : ℤ) ∣ (n : ℤ) ^ 2) :
    ¬ alpha ∣ (n : 𝓞 K) := by
  intro h
  have hd := map_dvd (Algebra.norm ℤ) h
  rw [norm_alpha, norm_natCast] at hd
  exact hn hd

lemma P_avoids : ¬ Ideal.span {alpha} ∣ P := by
  intro h
  apply alpha_not_dvd_nat 2 (by norm_num)
  apply Ideal.mem_span_singleton.mp
  apply Ideal.le_of_dvd h
  exact Ideal.subset_span (by simp)

lemma J_avoids : ¬ Ideal.span {alpha} ∣ J := by
  intro h
  apply alpha_not_dvd_nat 6 (by norm_num)
  apply Ideal.mem_span_singleton.mp
  apply Ideal.le_of_dvd h
  have hm : (3 : 𝓞 K) * 2 ∈ J := Ideal.mul_mem_mul
    (Ideal.mem_span_singleton_self 3) (Ideal.subset_span (by simp))
  convert hm using 1
  norm_num

lemma quotient_generator :
    FractionalIdeal.spanSingleton (𝓞 K)⁰ (1 / 3 : K) =
      (P / J : FractionalIdeal (𝓞 K)⁰ K) := by
  have hJ0 : (J : FractionalIdeal (𝓞 K)⁰ K) ≠ 0 :=
    FractionalIdeal.coeIdeal_ne_zero.mpr
      (fun h => J_avoids (h ▸ dvd_zero _))
  apply (eq_div_iff hJ0).mpr
  rw [J, FractionalIdeal.coeIdeal_mul,
    FractionalIdeal.coeIdeal_span_singleton, ← mul_assoc, ← map_mul]
  have hc : (1 / 3 : K) * algebraMap (𝓞 K) K 3 = 1 := by
    rw [map_ofNat, div_mul_cancel₀]
    norm_num
  rw [hc, map_one, one_mul]

theorem nonprincipal_quotient_avoiding :
    ¬ Submodule.IsPrincipal P ∧ ¬ Submodule.IsPrincipal J ∧
      ∃ a b : 𝓞 K, ¬ alpha ∣ a ∧ ¬ alpha ∣ b ∧
        FractionalIdeal.spanSingleton (𝓞 K)⁰ (a / b : K) =
          (P / J : FractionalIdeal (𝓞 K)⁰ K) := by
  refine ⟨P_not_principal, J_not_principal, ?_⟩
  exact FractionalIdeal.exists_not_dvd_spanSingleton_eq
    alpha_prime P J P_avoids J_avoids
    ((FractionalIdeal.isPrincipal_iff _).mpr ⟨1 / 3, quotient_generator.symm⟩)

theorem quotient_principality_necessary :
    ¬ ∃ z : K, FractionalIdeal.spanSingleton (𝓞 K)⁰ z =
      (P / (1 : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K) := by
  rintro ⟨z, hz⟩
  rw [Ideal.one_eq_top, FractionalIdeal.coeIdeal_top,
    FractionalIdeal.div_one] at hz
  have hm : z ∈ (P : FractionalIdeal (𝓞 K)⁰ K) := by
    rw [← hz]
    exact FractionalIdeal.mem_spanSingleton_self _ _
  obtain ⟨a, _, ha⟩ := (FractionalIdeal.mem_coeIdeal (𝓞 K)⁰).mp hm
  apply P_not_principal
  refine ⟨a, ?_⟩
  change P = Ideal.span {a}
  apply FractionalIdeal.coeIdeal_injective (K := K)
  change (P : FractionalIdeal (𝓞 K)⁰ K) = (Ideal.span {a} : Ideal (𝓞 K))
  rw [FractionalIdeal.coeIdeal_span_singleton, ha, hz]

end NonPIDCanonical

/-- Avoidance itself excludes zero ideals and unit prime candidates. -/
theorem avoidance_excludes_zero_and_units {R : Type*} [CommRing R]
    [IsDedekindDomain R] (x : R) (I : Ideal R)
    (h : ¬ Ideal.span {x} ∣ I) : I ≠ ⊥ ∧ ¬ IsUnit x := by
  refine ⟨fun e => h (e ▸ dvd_zero _), ?_⟩
  intro hx
  apply h
