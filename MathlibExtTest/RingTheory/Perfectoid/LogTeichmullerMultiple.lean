module

import MathlibExt.RingTheory.Perfectoid.LogTeichmullerMultiple

/-! Tests for the periods `log [ε]` as `ℤ_p`-multiples of `t`: `log [·]` turns products into sums
and powers into multiples, Fontaine's `ε` generates `ℤ_p(1)`, every `log [ε']` is a `ℤ_p`-multiple
of `t = log [ε]` (a nonzero one for `ε' ≠ 1`), `A_max` is `p`-adically separated in `B_dR^+`, and
`B_max` is generated by `A_max` and `1/t`. -/

open PadicComplexInt

variable (p : ℕ) [Fact p.Prime]

local notation "𝔹⁺" => BDeRhamPlus 𝓞_ℂ_[p] p
local notation "𝔹" => BDeRham 𝓞_ℂ_[p] p

-- `log [ε ε'] = log [ε] + log [ε']`, `log [1] = 0` and `log [ε²] = 2 log [ε]`.
example {ε ε' : PreTilt 𝓞_ℂ_[p] p} (h : ε.untilt = 1) (h' : ε'.untilt = 1)
    (hεε' : (ε * ε').untilt = 1) :
    logTeichmuller p hεε' = logTeichmuller p h + logTeichmuller p h' :=
  logTeichmuller_mul p h h' hεε'

example : logTeichmuller p (map_one _ : (1 : PreTilt 𝓞_ℂ_[p] p).untilt = 1) = 0 :=
  logTeichmuller_one p _

example {ε : PreTilt 𝓞_ℂ_[p] p} (h : ε.untilt = 1) (h2 : (ε ^ 2).untilt = 1) :
    logTeichmuller p h2 = 2 * logTeichmuller p h := by
  rw [logTeichmuller_pow p h 2 h2, Nat.cast_ofNat]

-- For Fontaine's `ε = (1, ζ_p, ζ_{p²}, …)`: `log [ε^p] = p t`, and `(ε^{1/p})♯` is a primitive
-- `p`-th root of unity.
example (h : (epsilon p ^ p).untilt = 1) :
    logTeichmuller p h = (p : 𝔹⁺) * logTeichmuller p (untilt_epsilon p) :=
  logTeichmuller_pow p (untilt_epsilon p) p h

example : IsPrimitiveRoot ((frobeniusEquiv (PreTilt 𝓞_ℂ_[p] p) p).symm (epsilon p)).untilt p :=
  isPrimitiveRoot_untilt_frobeniusEquiv_symm_epsilon p

-- Every `log [ε']` is a `ℤ_p`-multiple of `t = log [ε]`, and a nonzero one for `ε' ≠ 1`.
example {ε' : PreTilt 𝓞_ℂ_[p] p} (h : ε'.untilt = 1) :
    ∃ a : ℤ_[p], logTeichmuller p h =
      algebraMap ℚ_[p] 𝔹⁺ (a : ℚ_[p]) * logTeichmuller p (untilt_epsilon p) :=
  exists_logTeichmuller_eq_mul p (untilt_epsilon p)
    (isPrimitiveRoot_untilt_frobeniusEquiv_symm_epsilon p) h

example {ε' : PreTilt 𝓞_ℂ_[p] p} (h : ε'.untilt = 1) (hne : ε' ≠ 1) :
    ∃ a : ℤ_[p], a ≠ 0 ∧ logTeichmuller p h =
      algebraMap ℚ_[p] 𝔹⁺ (a : ℚ_[p]) * logTeichmuller p (untilt_epsilon p) :=
  exists_logTeichmuller_eq_mul_of_ne_one p (untilt_epsilon p)
    (isPrimitiveRoot_untilt_frobeniusEquiv_symm_epsilon p) h hne

-- `A_max` is `p`-adically separated in `B_dR^+`; its hypothesis holds for `0`.
example (x : 𝔹⁺) (h : ∀ k : ℕ, ∃ y ∈ aMax p, x = (p : 𝔹⁺) ^ k * y) : x = 0 :=
  eq_zero_of_forall_eq_pow_mul_mem_aMax p x h

example : (0 : 𝔹⁺) = 0 :=
  eq_zero_of_forall_eq_pow_mul_mem_aMax p 0 fun _ => ⟨0, (aMax p).zero_mem, (mul_zero _).symm⟩

-- `B_max = B_max^+[1/t]`: inverting `t` already inverts every nonzero period `log [ε']`.
example : bMax p = Algebra.adjoin ℚ_[p] (algebraMap 𝔹⁺ 𝔹 '' aMax p ∪
    {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹}) :=
  bMax_eq_adjoin p

example {ε' : PreTilt 𝓞_ℂ_[p] p} (h : ε'.untilt = 1) (hne : ε' ≠ 1) :
    (algebraMap 𝔹⁺ 𝔹 (logTeichmuller p h))⁻¹ ∈ Algebra.adjoin ℚ_[p]
      (algebraMap 𝔹⁺ 𝔹 '' aMax p ∪
        {(algebraMap 𝔹⁺ 𝔹 (logTeichmuller p (untilt_epsilon p)))⁻¹}) := by
  rw [← bMax_eq_adjoin]
  exact Algebra.subset_adjoin (Or.inr ⟨ε', h, hne, rfl⟩)
