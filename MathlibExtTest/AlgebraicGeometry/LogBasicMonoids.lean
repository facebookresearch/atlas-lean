module

public import MathlibExt.AlgebraicGeometry.LogMapBasicMonoids
public import Mathlib.Tactic.NormNum

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section

open scoped Pointwise

/-- A nonnegative cone in an actual abelian group. -/
def nonnegativeIntegers : Submonoid (Multiplicative ℤ) where
  carrier := {x | 0 ≤ x.toAdd}
  one_mem' := by change (0 : ℤ) ≤ 0; exact le_rfl
  mul_mem' := by
    intro x y hx hy
    change 0 ≤ x.toAdd at hx
    change 0 ≤ y.toAdd at hy
    change 0 ≤ x.toAdd + y.toAdd
    exact add_nonneg hx hy

/-- Fs root closure retains the cone: it never adds a negative direction. -/
example : Multiplicative.ofAdd (-1 : ℤ) ∉ nonnegativeIntegers.powerRootClosure := by
  rintro ⟨n, hn, h⟩
  change 0 ≤ (Multiplicative.ofAdd (-1 : ℤ)^n).toAdd at h
  rw [_root_.toAdd_pow] at h
  change 0 ≤ n • (-1 : ℤ) at h
  rw [nsmul_eq_mul, mul_neg_one] at h
  have hz : (0 : ℤ) < (n : ℤ) := by exact_mod_cast hn
  exact (not_le_of_gt (neg_neg_of_pos hz)) h

/-- The unsaturated positive monoid generated by 2 and 3 acquires 1.
This checks root closure rather than localization-style saturation. -/
example : Multiplicative.ofAdd (1 : ℤ) ∈
    (Submonoid.closure {Multiplicative.ofAdd (2 : ℤ), Multiplicative.ofAdd (3 : ℤ)}).powerRootClosure := by
  refine ⟨2, by decide, ?_⟩
  have he : (Multiplicative.ofAdd (1 : ℤ))^2 = Multiplicative.ofAdd (2 : ℤ) := by
    change (2 : ℕ) • (1 : ℤ) = 2
    norm_num
  rw [he]
  exact Submonoid.subset_closure (by simp)
