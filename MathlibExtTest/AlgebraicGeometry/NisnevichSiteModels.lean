module

import MathlibExt.AlgebraicGeometry.NisnevichSiteModels

/-!
# Nisnevich small-site interoperability

A native covering sieve generated by maps of small étale objects yields
actual residue-field-preserving lifts of every geometric scheme point.
The second check uses the same covering after a native fibre product.
-/

noncomputable section

open CategoryTheory Limits AlgebraicGeometry
open MathlibExt.NisSource.AlgebraicGeometry.Scheme

universe u

example {X : Scheme.{u}} {W : X.Etale} {ι : Type u}
    {Z : ι → X.Etale} (f : ∀ i, Z i ⟶ W)
    (hf : Sieve.ofArrows Z f ∈ X.smallNisnevichTopology W) (w : W.left) :
    ∃ i, ∃ z : (Z i).left,
      (f i).left z = w ∧ IsIso ((f i).left.residueFieldMap z) := by
  exact ((Scheme.ofArrows_mem_smallNisnevichTopology_iff f).mp hf).exists_isIso w

example {S Y : Scheme.{u}} {ι : Type u} {Z : ι → Scheme.{u}}
    (f : ∀ i, Z i ⟶ S) (hf : IsNisnevichCovering f) (g : Y ⟶ S) (y : Y) :
    ∃ i : ι, ∃ z : (Limits.pullback g (f i) : Scheme.{u}),
      pullback.fst g (f i) z = y ∧ IsIso ((pullback.fst g (f i)).residueFieldMap z) := by
  exact (hf.pullback g).exists_isIso y

example (X : Scheme.{u}) :
    X.smallNisnevichTopology ≤ X.smallEtaleTopology :=
  X.smallNisnevichTopology_le_smallEtaleTopology
