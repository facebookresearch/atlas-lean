module

public import MathlibExt.AlgebraicGeometry.HilbertFunctorPoint

@[expose] public section

open MvPolynomial AlgebraicGeometry

universe u

-- Consumer with the original binders.
example (n m : ℕ) (h : ℕ → ℕ) (h₁ : ∀ d, d < m → h d = Nat.choose (n + d) n)
    (h₂ : ∀ e, m ≤ e → ∀ (K : Type) [Field K] (J : Ideal (MvPolynomial (Fin (n + 1)) K)),
      (∃ s : Set (MvPolynomial (Fin (n + 1)) K),
        (∀ p ∈ s, p.IsHomogeneous e) ∧ J = Ideal.span s) →
      Module.finrank K (HilbertFunctor.piece J e) = h e →
      Module.finrank K (HilbertFunctor.piece J (e + 1)) ≤ h (e + 1))
    (A : Type) [CommRing A] (P : HilbertFunctor.Point A n h) :
    P.I = Ideal.span {p | p ∈ P.I ∧ p.IsHomogeneous m} :=
  HilbertFunctor.Point.I_eq_span_of_forall_finrank_piece_succ_le n m h h₁ h₂ A P

-- The same consumer in a higher universe.
example (n m : ℕ) (h : ℕ → ℕ) (h₁ : ∀ d, d < m → h d = Nat.choose (n + d) n)
    (h₂ : ∀ e, m ≤ e → ∀ (K : Type u) [Field K] (J : Ideal (MvPolynomial (Fin (n + 1)) K)),
      (∃ s : Set (MvPolynomial (Fin (n + 1)) K),
        (∀ p ∈ s, p.IsHomogeneous e) ∧ J = Ideal.span s) →
      Module.finrank K (HilbertFunctor.piece J e) = h e →
      Module.finrank K (HilbertFunctor.piece J (e + 1)) ≤ h (e + 1))
    (A : Type u) [CommRing A] (P : HilbertFunctor.Point A n h) :
    P.I = Ideal.span {p | p ∈ P.I ∧ p.IsHomogeneous m} :=
  HilbertFunctor.Point.I_eq_span_of_forall_finrank_piece_succ_le n m h h₁ h₂ A P

-- Boundary: generation in the wrong degree fails. The ideal generated by a
-- degree-one variable is not generated by its degree-zero elements (there
-- are none but `0`), so the degree in the conclusion cannot be lowered
-- without the growth hypothesis.
example : ¬ ((Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ℚ)} :
      Ideal (MvPolynomial (Fin 1) ℚ)) =
    Ideal.span {p | p ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ℚ)} ∧
      p.IsHomogeneous 0}) := by
  intro hcon
  have hbot : Ideal.span {p | p ∈
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ℚ)} ∧
        p.IsHomogeneous 0} = ⊥ := by
    rw [Ideal.span_eq_bot]
    intro p hp
    obtain ⟨hpI, hp0⟩ := hp
    have hcc : MvPolynomial.constantCoeff p = 0 := by
      have hle : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ℚ)} ≤
          RingHom.ker MvPolynomial.constantCoeff := by
        rw [Ideal.span_singleton_le_iff_mem]
        simp
      have := hle hpI
      exact this
    by_cases hpz : p = 0
    · exact hpz
    · have htd : p.totalDegree = 0 := hp0.totalDegree hpz
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at htd
      have hcoeff : p.coeff 0 = 0 := hcc
      rw [htd, hcoeff, map_zero]
  have hX : (MvPolynomial.X 0 : MvPolynomial (Fin 1) ℚ) ∈
      Ideal.span {p | p ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ℚ)} ∧
        p.IsHomogeneous 0} := hcon ▸ Ideal.subset_span rfl
  rw [hbot] at hX
  exact MvPolynomial.X_ne_zero 0 (Ideal.mem_bot.mp hX)
