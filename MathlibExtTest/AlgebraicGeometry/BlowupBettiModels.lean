module

public import MathlibExt.AlgebraicGeometry.BlowupBettiModels

@[expose] public section

/-! # Tests for Gysin maps, effective Cartier ideals and the blowup comparison -/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open MathlibExt.AlgebraicGeometry.ComplexAnalytification
open MathlibExt.AlgebraicGeometry.PerverseSheaves
open MathlibExt.AlgebraicGeometry.BettiRealization
open MathlibExt.AlgebraicGeometry.ProperBettiFunctoriality
open MathlibExt.AlgebraicGeometry.BettiGysin
open MathlibExt.AlgebraicGeometry.CartierIdealModels
open MathlibExt.AlgebraicGeometry.BlowupBettiModels

namespace MathlibExtTest.AlgebraicGeometry.BlowupBettiModels

attribute [local instance] HasDerivedCategory.standard

/-- The unit ideal is effective Cartier, generated by `1` on every affine open. -/
example (X : Scheme.{0}) : IsEffectiveCartier (⊤ : X.IdealSheafData) := by
  intro x
  obtain ⟨U, hU, hxU, -⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
      (show x ∈ (⊤ : X.Opens) from trivial)
  refine ⟨⟨U, hU⟩, hxU, 1, fun a b h => by simpa using h, ?_⟩
  simp

/-- The zero ideal of a nonempty scheme is not effective Cartier: a generator
of the zero ideal is zero, and multiplication by zero is not injective on the
nonzero ring of sections of a nonempty open. -/
example (X : Scheme.{0}) [Nonempty X] : ¬ IsEffectiveCartier (⊥ : X.IdealSheafData) := by
  intro h
  obtain ⟨x⟩ := ‹Nonempty X›
  obtain ⟨U, hxU, a, hinj, hI⟩ := h x
  have ha : a = 0 := by
    have : a ∈ Ideal.span {a} := Ideal.subset_span rfl
    rw [← hI] at this
    simpa using this
  subst ha
  have h10 : (1 : Γ(X, U.1)) ≠ 0 := by
    intro h10
    have := congrArg (X.presheaf.germ U.1 x hxU) h10
    simp at this
  exact h10 (hinj (show (0 : Γ(X, U.1)) * 0 = 0 * 1 by simp)).symm

/-- The unit class in degree zero is the identity of the coefficient unit, up
to the zero shift. -/
example (Z : TopCat.{0}) :
    unitClass Z = (shiftFunctorZero (RationalDerived Z) ℤ).inv.app (rationalUnit Z) :=
  rfl

/-- Poincaré duality from a purity isomorphism is a linear equivalence. -/
example (Z : TopCat.{0}) (D : MathlibExt.AlgebraicGeometry.CompactSupportBetti.DualizingComplex Z)
    (d : ℕ)
    (e : D.obj ≅ (rationalUnit Z)⟦(2 * d : ℤ)⟧) (n : ℤ) (x : Cohomology Z n) :
    purityCohomologyEquiv Z D d e n ((purityCohomologyEquiv Z D d e n).symm x) = x :=
  (purityCohomologyEquiv Z D d e n).apply_symm_apply x

/-- Powers of a degree-two class: `h⁰` is the unit and `hʲ⁺¹` is `h ∪ hʲ`. -/
example (Z : TopCat.{0}) (h : Cohomology Z 2) : powerClass Z h 0 = unitClass Z := rfl

example (Z : TopCat.{0}) (h : Cohomology Z 2) (j : ℕ) :
    powerClass Z h (j + 1) =
      cohomologyCast (m := 2 + 2 * (j : ℤ)) (n := 2 * ((j + 1 : ℕ) : ℤ)) (by omega)
        (cup Z h (powerClass Z h j)) :=
  rfl

/-- The degree cast along `rfl` is the identity. -/
example (Z : TopCat.{0}) (m : ℤ) (x : Cohomology Z m) : cohomologyCast rfl x = x := rfl

/-- In codimension two the comparison has exactly one exceptional summand. -/
example {X Z : ComplexScheme} (n : ℤ) :
    BlowupSummands (X := X) (Z := Z) 2 n =
      (Cohomology (space X) n × ((j : Fin 1) → Cohomology (space Z) (n - 2 * (j.val + 1)))) :=
  rfl

/-- The exceptional square of a blowup commutes. -/
example {X Z : ComplexScheme} {i : Z ⟶ X} (B : BlowupModel i) :
    B.exceptionalMap ≫ B.map = B.exceptionalProjection ≫ i :=
  B.exceptional_square

end MathlibExtTest.AlgebraicGeometry.BlowupBettiModels

end
