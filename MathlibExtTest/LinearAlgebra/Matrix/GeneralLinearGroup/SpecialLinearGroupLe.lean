module

public import MathlibExt.LinearAlgebra.Matrix.GeneralLinearGroup.SpecialLinearGroupLe

open Matrix Matrix.GeneralLinearGroup

#check @specialLinearGroup_le_of_dvd_card
#check @mem_closure_transvections
#check @sub_one_mul_self_eq_zero_of_orderOf_eq

-- `SL₂(F)` lies in the subgroup generated by the elementary transvections.
example (F : Type*) [Field F] (X : SpecialLinearGroup (Fin 2) F) :
    SpecialLinearGroup.toGL X ∈
      Subgroup.closure (Set.range (upperTransvection (F := F)) ∪
        Set.range (lowerTransvection (F := F))) :=
  mem_closure_transvections X (fun x => Subgroup.subset_closure (Or.inl ⟨x, rfl⟩))
    (fun x => Subgroup.subset_closure (Or.inr ⟨x, rfl⟩))

-- `!![1, 1; 0, 1]` has order `ℓ` in `GL₂(𝔽_ℓ)`; it is a transvection.
example (ℓ : ℕ) [Fact ℓ.Prime] :
    upperTransvection (1 : ZMod ℓ) ^ ℓ = 1 := by
  rw [upperTransvection_pow, ZMod.natCast_self, zero_mul]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [coe_upperTransvection]
