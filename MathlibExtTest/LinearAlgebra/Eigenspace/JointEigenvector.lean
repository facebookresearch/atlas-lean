module

public import MathlibExt.LinearAlgebra.Eigenspace.JointEigenvector

#check @Module.End.exists_ne_zero_forall_apply_eq_smul_of_algHom

-- The subalgebra generated by one endomorphism `T` is commutative; a character sending `T` to
-- `μ` gives an eigenvector of `T` with eigenvalue `μ`.
example {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (T : Module.End K V) (χ : Algebra.adjoin K {T} →ₐ[K] K) :
    ∃ v : V, v ≠ 0 ∧ T v = χ ⟨T, Algebra.self_mem_adjoin_singleton K T⟩ • v := by
  have hT : ∀ a ∈ Algebra.adjoin K {T}, Commute a T := fun a ha =>
    (Algebra.commute_of_mem_adjoin_of_forall_mem_commute ha fun d hd => by
      rw [Set.mem_singleton_iff.1 hd]; exact Commute.refl T).symm
  obtain ⟨v, hv, h⟩ := Module.End.exists_ne_zero_forall_apply_eq_smul_of_algHom
    (Algebra.adjoin K {T}) (fun a ha b hb =>
      (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hb fun c hc => by
        rw [Set.mem_singleton_iff.1 hc]; exact hT a ha).eq) χ
  exact ⟨v, hv, h ⟨T, Algebra.self_mem_adjoin_singleton K T⟩⟩
