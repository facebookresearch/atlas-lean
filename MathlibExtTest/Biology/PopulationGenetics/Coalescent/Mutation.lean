module

public import MathlibExt.Biology.PopulationGenetics.Coalescent.Mutation

/-!
# Tests for Poisson mutation marking on a Kingman genealogy

One branch, zero mutation rate, the sample of size `2` (one epoch of two branches), and the
degenerate sample of size `1` (no branches).
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Finset
open scoped NNReal

namespace MathlibExtTest.Biology.PopulationGenetics.Coalescent.Mutation

open MathlibExt.Biology.PopulationGenetics.Coalescent

variable {Ω 𝓧 : Type*} {mΩ : MeasurableSpace Ω} {m𝓧 : MeasurableSpace 𝓧} {μ : Measure Ω}

/-- One branch: the mutation count on a single branch of length `ℓ x` is `Po(r ℓ x)` given `X`. -/
example [IsProbabilityMeasure μ] {X : Ω → 𝓧} {N : Ω → Unit → ℕ} {r : ℝ≥0}
    {ℓ : 𝓧 → Unit → ℝ≥0} {hℓ : Measurable ℓ}
    (h : HasCondDistrib N X (branchMutationKernel r ℓ hℓ) μ) (x : 𝓧) :
    (poissonMeasureKernel.comap (fun x => r * ∑ b, ℓ x b)
      (measurable_const.mul (Finset.measurable_sum _ fun _ _ => hℓ.eval))) x =
        poissonMeasure (r * ℓ x ()) ∧
      HasCondDistrib (fun ω => ∑ b, N ω b) X
        (poissonMeasureKernel.comap (fun x => r * ∑ b, ℓ x b)
          (measurable_const.mul (Finset.measurable_sum _ fun _ _ => hℓ.eval))) μ :=
  ⟨by simp, hasCondDistrib_sum_of_branchMutation h⟩

/-- One branch, conditional moments: the count has conditional mean and variance `r ℓ(X)`. -/
example [IsProbabilityMeasure μ] {X : Ω → 𝓧} {N : Ω → ℕ} {ρ : 𝓧 → ℝ≥0} {hρ : Measurable ρ}
    (hX : Measurable X) (h : HasCondDistrib N X (poissonMeasureKernel.comap ρ hρ) μ)
    (hρ2 : MemLp (fun ω => (ρ (X ω) : ℝ)) 2 μ) :
    μ[fun ω => (N ω : ℝ) | m𝓧.comap X] =ᵐ[μ] (fun ω => (ρ (X ω) : ℝ)) ∧
      Var[fun ω => (N ω : ℝ); μ | m𝓧.comap X] =ᵐ[μ] (fun ω => (ρ (X ω) : ℝ)) :=
  ⟨condExp_natCast_of_hasCondDistrib_poisson hX h (hρ2.integrable one_le_two),
    condVar_natCast_of_hasCondDistrib_poisson hX h hρ2⟩

/-- Sample of size `2`: one epoch with two branches, each of length `T 2`. -/
example : Fintype.card (KingmanBranch 2) = 2 := by decide

/-- Sample of size `2`: the branch lengths sum to `2 T 2`. -/
example (t : Icc 2 2 → ℝ) :
    ∑ b, kingmanBranchLength 2 t b = 2 * (t ⟨2, by simp⟩).toNNReal := by
  rw [sum_kingmanBranchLength]
  have : (univ : Finset (Icc 2 2)) = {⟨2, by simp⟩} := by decide
  simp [this]

/-- Sample of size `2` in the marked model: `E[S] = θ` (`H₁ = 1`) and `Var S = θ + θ²`. -/
example (θ : ℝ≥0) :
    ∫ p, segSites Prod.snd p ∂kingmanMutationMeasure 2 θ = θ ∧
      Var[segSites Prod.snd; kingmanMutationMeasure 2 θ] = θ + (θ : ℝ) ^ 2 := by
  have hA : tajimaA1 2 = 1 ∧ tajimaA2 2 = 1 := by
    constructor <;> simp [tajimaA1, tajimaA2]
  refine ⟨?_, ?_⟩
  · simpa using watterson_unbiased_kingmanMutationMeasure θ le_rfl
  · rw [variance_segSites_kingmanMutationMeasure, hA.1, hA.2]
    ring

/-- Zero mutation rate: Watterson's estimator has mean `0` and `S` has variance `0`. -/
example (n : ℕ) (hn : 2 ≤ n) :
    ∫ p, segSites Prod.snd p / (harmonic (n - 1) : ℝ) ∂kingmanMutationMeasure n 0 = 0 ∧
      Var[segSites Prod.snd; kingmanMutationMeasure n 0] = 0 := by
  refine ⟨by simpa using watterson_unbiased_kingmanMutationMeasure (n := n) 0 hn, ?_⟩
  rw [variance_segSites_kingmanMutationMeasure]
  simp

/-- Zero mutation rate: every branch receives no mutations. -/
example (n : ℕ) (t : Icc 2 n → ℝ) :
    kingmanMutationKernel n 0 t = Measure.pi fun _ => Measure.dirac 0 := by
  simp [kingmanMutationKernel, branchMutationKernel, poissonMeasure_zero]

/-- Sample of size `1`: the genealogy has no branches, so `S = 0` and `Var S = 0`. -/
example (θ : ℝ≥0) : IsEmpty (KingmanBranch 1) ∧
    Var[segSites Prod.snd; kingmanMutationMeasure 1 θ] = 0 := by
  refine ⟨⟨fun b => by simpa using b.1.2⟩, ?_⟩
  rw [variance_segSites_kingmanMutationMeasure]
  simp [tajimaA1, tajimaA2]

/-- The marked model satisfies the conditional-moment hypotheses of the existing Watterson
theorem, with the genealogy σ-algebra generated by the holding times. -/
example (n : ℕ) (θ : ℝ≥0) :
    (kingmanMutationMeasure n θ)[segSites Prod.snd |
        MeasurableSpace.comap (KingmanTimes.ofMutationModel n θ).epochs inferInstance] =ᵐ[
      kingmanMutationMeasure n θ]
      fun p => (θ : ℝ) / 2 * (KingmanTimes.ofMutationModel n θ).totalLength p :=
  (KingmanTimes.ofMutationModel n θ).condExp_segSites_of_mutation
    (by rw [KingmanTimes.epochs_ofMutationModel]; exact measurable_fst)
    (hasCondDistrib_kingmanMutationMeasure n θ)

end MathlibExtTest.Biology.PopulationGenetics.Coalescent.Mutation
