module

public import MathlibExt.MeasureTheory.Measure.CaratheodoryExtension
public import Mathlib.Topology.Algebra.InfiniteSum.ENNReal

@[expose] public section

open MeasureTheory Set MeasurableSpace Classical
open scoped ENNReal

namespace MathlibExtTest.MeasureTheory.Measure.CaratheodoryExtension

/-- The existence half restates with the exact public signature. -/
example {α : Type*} (𝒜 : Set (Set α)) (h𝒜 : IsSetAlgebra 𝒜)
    (μ₀ : AddContent ℝ≥0∞ 𝒜) (hμ₀_sigma : μ₀.IsSigmaSubadditive) :
    ∃ μ : @Measure α (generateFrom 𝒜), ∀ s ∈ 𝒜, μ s = μ₀ s :=
  exists_measure_extension 𝒜 h𝒜 μ₀ hμ₀_sigma

/-- The Carathéodory extension theorem restates with the exact public signature. -/
example {α : Type*} (𝒜 : Set (Set α)) (h𝒜 : IsSetAlgebra 𝒜)
    (μ₀ : AddContent ℝ≥0∞ 𝒜) (hμ₀_sigma : μ₀.IsSigmaSubadditive)
    (B : ℕ → Set α) (hB_mem : ∀ i, B i ∈ 𝒜)
    (hB_cover : ⋃ i, B i = univ) (hB_fin : ∀ i, μ₀ (B i) ≠ ⊤) :
    ∃! μ : @Measure α (generateFrom 𝒜), ∀ s ∈ 𝒜, μ s = μ₀ s :=
  caratheodory_extension_theorem 𝒜 h𝒜 μ₀ hμ₀_sigma B hB_mem hB_cover hB_fin

/-- The full power set is a set algebra. -/
lemma isSetAlgebra_univ {α : Type*} : IsSetAlgebra (univ : Set (Set α)) := by
  refine ⟨trivial, fun {_} _ => trivial, fun {_ _} _ _ => trivial⟩

/-- A set algebra is a set semiring (the `univ` algebra on any type). -/
example {α : Type*} : IsSetSemiring (univ : Set (Set α)) :=
  isSetSemiring_of_isSetAlgebra isSetAlgebra_univ

/-- A set algebra is a `π`-system (the `univ` algebra on any type). -/
example {α : Type*} : IsPiSystem (univ : Set (Set α)) :=
  isSetAlgebra_isPiSystem isSetAlgebra_univ

/-- The Dirac content at `()` on `Unit`: the content assigning `1` to every
set containing `()` and `0` to every other set, viewed as an `AddContent`
on the full power-set algebra. -/
noncomputable def diracContentUnit : AddContent ℝ≥0∞ (univ : Set (Set Unit)) := by
  classical
  exact
    { toFun := fun s => if () ∈ s then 1 else 0
      empty' := by simp
      sUnion' := by
        intro I _h_ss h_dis _h_mem
        show (if () ∈ ⋃₀ (I : Set (Set Unit)) then (1 : ℝ≥0∞) else 0) =
          ∑ u ∈ I, (if () ∈ u then (1 : ℝ≥0∞) else 0)
        by_cases h : () ∈ ⋃₀ (I : Set (Set Unit))
        · obtain ⟨u, huI, hu⟩ := mem_sUnion.mp h
          have huI' : u ∈ I := Finset.mem_coe.mp huI
          simp only [h, ite_true]
          rw [Finset.sum_eq_single u]
          · simp only [hu, ite_true]
          · intro b hb hbne
            have hnb : () ∉ b := by
              intro hmem
              have hdis : Disjoint u b :=
                h_dis huI (Finset.mem_coe.mpr hb) (Ne.symm hbne)
              exact (Set.disjoint_left.mp hdis) hu hmem
            simp only [hnb, ite_false]
          · intro hnot
            exact absurd huI' hnot
        · simp only [h, ite_false]
          symm
          apply Finset.sum_eq_zero
          intro u huI
          have hnu : () ∉ u := fun hmem =>
            h (mem_sUnion.mpr ⟨u, Finset.mem_coe.mpr huI, hmem⟩)
          simp only [hnu, ite_false] }

/-- The Dirac content takes the expected value on every set. -/
lemma diracContentUnit_apply (s : Set Unit) :
    diracContentUnit s = if () ∈ s then (1 : ℝ≥0∞) else 0 :=
  rfl

/-- The Dirac content never takes the value `⊤`. -/
lemma diracContentUnit_ne_top (s : Set Unit) : diracContentUnit s ≠ ⊤ := by
  rw [diracContentUnit_apply]
  split_ifs with h
  · exact ENNReal.one_ne_top
  · exact ENNReal.zero_ne_top

/-- The Dirac content on `Unit` is `σ`-subadditive: its value on a countable
union is at most the sum of its values on the pieces (indeed, both sides are
`1` if `()` lies in the union and `0` otherwise, except that the sum may
count `()` several times). -/
lemma diracContentUnit_sigma_subadditive : diracContentUnit.IsSigmaSubadditive := by
  intro f _ _
  by_cases h : () ∈ ⋃ i, f i
  · obtain ⟨i, hi⟩ := mem_iUnion.mp h
    calc diracContentUnit (⋃ i, f i) = 1 := by simp [diracContentUnit_apply, h]
      _ = diracContentUnit (f i) := by simp [diracContentUnit_apply, hi]
      _ ≤ ∑' j, diracContentUnit (f j) := ENNReal.le_tsum (f := fun j => diracContentUnit (f j)) i
  · simp [diracContentUnit_apply, h]

/-- Uniqueness from the Carathéodory theorem: two measures on the
`σ`-algebra generated by the full power set of `Unit` that both extend the
Dirac content are equal. -/
example (μ₁ μ₂ : @Measure Unit (generateFrom (univ : Set (Set Unit))))
    (h₁ : ∀ s ∈ (univ : Set (Set Unit)), μ₁ s = diracContentUnit s)
    (h₂ : ∀ s ∈ (univ : Set (Set Unit)), μ₂ s = diracContentUnit s) :
    μ₁ = μ₂ := by
  obtain ⟨μ, _, huniq⟩ := caratheodory_extension_theorem
    (univ : Set (Set Unit)) isSetAlgebra_univ
    diracContentUnit diracContentUnit_sigma_subadditive (fun _ => univ)
    (fun _ => trivial) (by simp only [iUnion_const]) (fun _ => diracContentUnit_ne_top _)
  exact (huniq μ₁ h₁).trans (huniq μ₂ h₂).symm

/-- Existence from the Carathéodory theorem: the Dirac content on `Unit`
extends to a measure assigning mass `1` to the whole space. -/
example :
    ∃ μ : @Measure Unit (generateFrom (univ : Set (Set Unit))), μ univ = 1 := by
  obtain ⟨μ, hμ, -⟩ := caratheodory_extension_theorem
    (univ : Set (Set Unit)) isSetAlgebra_univ
    diracContentUnit diracContentUnit_sigma_subadditive (fun _ => univ)
    (fun _ => trivial) (by simp only [iUnion_const]) (fun _ => diracContentUnit_ne_top _)
  exact ⟨μ, by rw [hμ univ trivial, diracContentUnit_apply]; simp only [mem_univ, ite_true]⟩

