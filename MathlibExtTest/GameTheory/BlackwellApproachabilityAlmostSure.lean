module

public import MathlibExt.GameTheory.BlackwellApproachabilityAlmostSure

/-!
# Tests for Blackwell's approachability theorem, almost-sure form

Closed checks of `blackwell_approachability` and `historySigma`: the history σ-algebra at time
`n` contains every event about the rounds `0, …, n` and is generated by the first round at time
`0`; the theorem applies to a non-degenerate game (payoffs `±e₀` on a line, two actions against
one, `C = {0}`) and to the edge case `d = 0`; and when the decision maker has a single action the
factorisation hypothesis holds for every process, which gives a complete instance on a one-point
probability space with every hypothesis discharged.
-/

open MeasureTheory Filter Topology
open MathlibExt.GameTheory.BlackwellApproachability (average)
open MathlibExt.GameTheory.BlackwellApproachabilityWanted

/-! ### The history σ-algebra -/

/-- Every event about a past round is in the history σ-algebra. -/
example {Ω α : Type} (Z : ℕ → Ω → α) {n k : ℕ} (hk : k ≤ n) (s : Set α) :
    MeasurableSet[historySigma Z n] (Z k ⁻¹' s) :=
  le_iSup₂ (f := fun k (_ : k ≤ n) => MeasurableSpace.comap (Z k) ⊤) k hk _ ⟨s, trivial, rfl⟩

/-- At time `0` the history σ-algebra is generated by the first round. -/
example {Ω α : Type} (Z : ℕ → Ω → α) : historySigma Z 0 = MeasurableSpace.comap (Z 0) ⊤ := by
  simp [historySigma]

/-- The history σ-algebras grow with time. -/
example {Ω α : Type} (Z : ℕ → Ω → α) {n m : ℕ} (h : n ≤ m) :
    historySigma Z n ≤ historySigma Z m :=
  iSup₂_mono' fun k hk => ⟨k, hk.trans h, le_rfl⟩

/-! ### Instances of the theorem -/

/-- The unit vector of `ℝ¹`. -/
noncomputable abbrev e₀ : EuclideanSpace ℝ (Fin 1) := EuclideanSpace.single 0 1

/-- A non-degenerate instance: payoffs `±e₀`, two actions for the decision maker against one for
the opponent, and `C = {0}`. Every half-space `{x | ⟪λ, x⟫ ≤ ρ}` containing `0` has `ρ ≥ 0`, and
the uniform mixed action has expected payoff `0`, so the Blackwell strategy drives the average
realised payoff to `0` almost surely. -/
example : ∃ σ : EuclideanSpace ℝ (Fin 1) → Convexity.StdSimplex ℝ (Fin 2),
    ∀ {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (Z : ℕ → Ω → Fin 2 × Unit), (∀ n z, MeasurableSet {ω | Z n ω = z}) →
      (∀ n a b,
        P[{ω | Z (n + 1) ω = (a, b)}.indicator (fun _ => (1 : ℝ)) | historySigma Z n] =ᵐ[P]
          fun ω => (σ (average (fun k => (![1, -1] (Z k ω).1 : ℝ) • e₀) (n + 1))).weights a *
            P[{ω | (Z (n + 1) ω).2 = b}.indicator (fun _ => (1 : ℝ)) | historySigma Z n] ω) →
      ∀ᵐ ω ∂P, Tendsto
        (fun n => Metric.infDist (average (fun k => (![1, -1] (Z k ω).1 : ℝ) • e₀) n) {0})
        atTop (𝓝 0) := by
  refine blackwell_approachability (fun a (_ : Unit) => (![1, -1] a : ℝ) • e₀)
    (Set.singleton_nonempty 0) isClosed_singleton (convex_singleton 0)
    fun lam ρ hρ => ⟨Convexity.StdSimplex.barycenter, fun _ => ?_⟩
  have := hρ 0 rfl
  simp only [inner_zero_right] at this
  simpa [Fin.sum_univ_two, Convexity.StdSimplex.weights_barycenter_apply, ← add_smul] using this

/-- Edge case `d = 0`: the payoff space is a point, so every half-space containing `C = {0}`
contains every payoff, and the theorem applies to every game. -/
example {A B : Type} [Fintype A] [Fintype B] [Nonempty A]
    (v : A → B → EuclideanSpace ℝ (Fin 0)) :
    ∃ σ : EuclideanSpace ℝ (Fin 0) → Convexity.StdSimplex ℝ A,
      ∀ {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (Z : ℕ → Ω → A × B), (∀ n z, MeasurableSet {ω | Z n ω = z}) →
        (∀ n a b,
          P[{ω | Z (n + 1) ω = (a, b)}.indicator (fun _ => (1 : ℝ)) | historySigma Z n] =ᵐ[P]
            fun ω => (σ (average (fun k => v (Z k ω).1 (Z k ω).2) (n + 1))).weights a *
              P[{ω | (Z (n + 1) ω).2 = b}.indicator (fun _ => (1 : ℝ)) | historySigma Z n] ω) →
        ∀ᵐ ω ∂P, Tendsto
          (fun n => Metric.infDist (average (fun k => v (Z k ω).1 (Z k ω).2) n) {0}) atTop
          (𝓝 0) :=
  blackwell_approachability v (Set.singleton_nonempty 0) isClosed_singleton (convex_singleton 0)
    fun _ _ hρ => ⟨Convexity.StdSimplex.barycenter, fun _ => by
      rw [Subsingleton.elim (∑ a, _) 0]
      exact hρ 0 rfl⟩

/-- With a single action for the decision maker, the factorisation hypothesis of
`blackwell_approachability` holds for every process and every strategy: the two indicators are
those of the same event, and the only weight is `1`. -/
private theorem factorisation_of_unique {Ω B E : Type} [MeasurableSpace Ω] (P : Measure Ω)
    (σ : E → Convexity.StdSimplex ℝ Unit) (x : ℕ → Ω → E) (Z : ℕ → Ω → Unit × B) (n : ℕ)
    (b : B) :
    P[{ω | Z (n + 1) ω = ((), b)}.indicator (fun _ => (1 : ℝ)) | historySigma Z n] =ᵐ[P]
      fun ω => (σ (x n ω)).weights () *
        P[{ω | (Z (n + 1) ω).2 = b}.indicator (fun _ => (1 : ℝ)) | historySigma Z n] ω := by
  have hset : {ω | Z (n + 1) ω = ((), b)} = {ω | (Z (n + 1) ω).2 = b} := by
    ext ω
    simp [Prod.ext_iff]
  have hw : ∀ q : Convexity.StdSimplex ℝ Unit, q.weights () = 1 := fun q => by simp
  refine ae_of_all _ fun _ => ?_
  simp only [hset, hw, one_mul]

/-- Payoffs `e₀` and `0` for a decision maker with a single action. -/
noncomputable abbrev vBall : Unit → Bool → EuclideanSpace ℝ (Fin 1) :=
  fun _ b => if b then e₀ else 0

/-- An opponent alternating between its two actions, on a one-point sample space. -/
abbrev zAlt : ℕ → Unit → Unit × Bool := fun k _ => ((), decide (k % 2 = 0))

/-- A complete instance on a one-point probability space: a single action for the decision
maker, payoffs `e₀` and `0` in the closed unit ball `C`, and an opponent alternating between its
two actions. Every hypothesis of `blackwell_approachability` is discharged. -/
example : ∀ᵐ ω ∂(Measure.dirac ()), Tendsto (fun n => Metric.infDist
    (average (fun k => vBall (zAlt k ω).1 (zAlt k ω).2) n) (Metric.closedBall 0 1)) atTop
    (𝓝 0) := by
  obtain ⟨σ, hσ⟩ := blackwell_approachability vBall ⟨0, Metric.mem_closedBall_self zero_le_one⟩
    Metric.isClosed_closedBall (convex_closedBall 0 1) fun lam ρ hρ =>
      ⟨Convexity.StdSimplex.barycenter, fun b => by
        refine (le_of_eq ?_).trans (hρ (vBall () b) ?_)
        · simp
        · cases b <;> simp [vBall]⟩
  exact hσ (Measure.dirac ()) zAlt (fun _ _ => (Set.toFinite _).measurableSet)
    fun n a b => by
      cases a
      exact factorisation_of_unique (Measure.dirac ()) σ
        (fun n ω => average (fun k => vBall (zAlt k ω).1 (zAlt k ω).2) (n + 1)) zAlt n b

#print axioms blackwell_approachability
